        1   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        2   DEFINE INPUT PARAMETER p-mode AS CHARACTER NO-UNDO.
        3   DEFINE INPUT PARAMETER p-dtm-code AS integer NO-UNDO.
        4   DEFINE INPUT PARAMETER p-sum-id AS CHARACTER NO-UNDO.
        5   DEFINE INPUT PARAMETER p-dt-code AS integer NO-UNDO.
        6   DEFINE INPUT PARAMETER p-node-code AS integer NO-UNDO.
        7   DEFINE INPUT PARAMETER p-emitent-host-code AS integer NO-UNDO.
        8   DEFINE INPUT PARAMETER p-type AS character NO-UNDO.
        9   DEFINE INPUT PARAMETER p-d-card AS character NO-UNDO.
       10   DEFINE INPUT PARAMETER p-host-code AS integer NO-UNDO.
       11   DEFINE INPUT PARAMETER p-obj-type AS CHARACTER NO-UNDO.
       12   DEFINE INPUT PARAMETER p-obj-code AS integer NO-UNDO.
       13   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       14   DEFINE TEMP-TABLE temp-dis-card-property NO-UNDO LIKE ub.dis-card-property
       15   field rw-option as character
       16   field prop-label as character
       17   field node-label as character
       18   field data-type as character
       19   field range as integer
       20   INDEX attrc is
       21   UNIQUE PRIMARY
       22   prop-label
       23   node-label
       24   dt-code
       25   host-code
       26   obj-type
       27   obj-code
       28   INDEX attrcl is UNIQUE
       29   dt-code
       30   node-code
       31   host-code
       32   obj-type
       33   obj-code
       34   .
       35   DEFINE INPUT-OUTPUT PARAMETER TABLE FOR temp-dis-card-property.
       36   DEFINE OUTPUT PARAMETER p-setted AS LOGICAL NO-UNDO.
       37   define variable vss-revision    as character no-undo init "$Revision$":U .
       38   define variable vss-author      as character no-undo init "$Author$":U .
       39   define variable vss-date        as character no-undo init "$Date$":U .
       40   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       41   define variable vss-archive     as character no-undo init "$Archive$":U .
       42   define variable vss-description as character no-undo init "Топливо для ДК".
       43   procedure vss-get-info :
       44     define output parameter p-vss-revision    like vss-revision    no-undo .
       45     define output parameter p-vss-author      like vss-author      no-undo .
       46     define output parameter p-vss-date        like vss-date        no-undo .
       47     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       48     define output parameter p-vss-archive     like vss-archive     no-undo .
       49     define output parameter p-vss-description like vss-description no-undo .
       50     assign
       51       p-vss-revision    = vss-revision
       52       p-vss-author      = vss-author
       53       p-vss-date        = vss-date
       54       p-vss-workfile    = vss-workfile
       55       p-vss-archive     = vss-archive
       56       p-vss-description = vss-description
       57     .
       58   end procedure.
       59   procedure vss-get-parameters :
       60     define output parameter p-vss-parameters as character no-undo .
       61   end procedure.
       62   define new global shared variable g#vssrevis-logger as handle    no-undo .
       63   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       64   define variable v-vssrevis-logger                   as handle    no-undo .
       65   procedure vss-logevent :
       66     define input  parameter p-extra-paramters as character no-undo .
       67     define variable v-vssrevis-parameters as character no-undo .
       68     do
       69     on error undo, return error return-value
       70     :
       71       if  valid-handle(v-vssrevis-logger)
       72       and v-vssrevis-logger :get-signature("logevent") <> ""
       73       then do:
       74         run vss-get-parameters in this-procedure
       75           (output v-vssrevis-parameters
       76           ).
       77         run logevent in v-vssrevis-logger
       78           (input vss-workfile
       79           ,input vss-revision
       80           ,input v-vssrevis-parameters
       81           ,input p-extra-paramters
       82           ).
       83       end.
       84     end.
       85   end procedure.
       86   assign
       87     v-vssrevis-logger = g#vssrevis-logger
       88   .
       89   if  valid-handle(v-vssrevis-logger)
       90   and v-vssrevis-logger :get-signature("logevent") <> ""
       91   then do:
       92     assign
       93       v-vssrevis-logevent = true
       94     .
       95     run vss-logevent in this-procedure (input vss-description) .
       96   end.
       97   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       98   define variable v-waitfram-action01         as character   no-undo .
       99   define variable v-waitfram-action02         as character   no-undo .
      100   define variable v-waitfram-action03         as character   no-undo .
      101   define variable mWaitFramTextBeg            as character   no-undo.
      102   define variable mWaitFramTextEnd            as character   no-undo.
      103   define variable mWaitFramView               as logical     no-undo.
      104   define variable mWaitProcEvent              as logical     no-undo init yes.
      105   define variable mWaitFramInterval           as integer     no-undo init 1 .
      106   define variable mWaitFramStop               as logical     no-undo.
      107   define variable mWaitFramStopUser           as logical     no-undo.
      108   define variable mWaitFramStopTimeOut        as logical     no-undo.
      109   define variable mWaitFramStartProc          as datetime-tz no-undo.
      110   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      111   define button B-WaitFramStop auto-end-key
      112        label "Стоп"
      113        size 10 by 1 tooltip "Остоновить процесс".
      114   define button B-viewProcInfo
      115        label "Информация"
      116        size 15 by 1 tooltip "Информация о процесс".
      117   define frame waitfram
      118     v-waitfram-action01 format "x(72)" no-label skip
      119     v-waitfram-action02 format "x(72)" no-label skip
      120     v-waitfram-action03 format "x(72)" no-label skip
      121     B-viewProcInfo
      122     B-WaitFramStop at row 4 col 30
      123     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      124     .
      125   define new global shared variable mBatchMode as logical no-undo init ?.
      126   define variable mFramBachModHandle as handle no-undo.
      127   mFramBachModHandle = frame waitfram:handle.
      128   define variable mFameOldVis as logical no-undo.
      129   define variable mVisCUrentVin as logical no-undo.
      130   if session:batch-mode
      131   then
      132      mBatchMode = yes.
      133   if mBatchMode = ? then do:
      134     mVisCUrentVin = current-window:visible.
      135     mFameOldVis = mFramBachModHandle:visible.
      136     mFramBachModHandle:visible  = yes.
      137     mBatchMode = mFramBachModHandle:visible ne yes.
      138     mFramBachModHandle:visible = mFameOldVis.
      139     current-window:visible = mVisCUrentVin.
      140   end.
      141    if  log-manager:logfile-name ne ?
      142     then DO:
      143         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      144         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      145         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      146     end.
      147   on choose of B-WaitFramStop in frame waitfram
      148   do:
      149     mWaitFramStop = yes.
      150     mWaitFramStopUser = yes.
      151   end.
      152   function waitfram-check-timeout returns logical():
      153      define variable vtime as int64 no-undo.
      154      if mWaitFramStopTimeOut
      155      then
      156         return yes.
      157      vtime = ( now - mWaitFramStartProc ) / 1000 .
      158      if     mWaitFramTimeOut ne ?
      159         and mWaitFramTimeOut ne 0
      160         and mWaitFramTimeOut lt vtime
      161      then do:
      162         mWaitFramStopTimeOut = yes.
      163      end.
      164      return mWaitFramStopTimeOut.
      165   end.
      166   procedure waitfram-hide :
      167     if not session:batch-mode
      168     then do
      169     on error undo, return error return-value
      170     :
      171       pause 0 before-hide .
      172       if not mBatchMode then
      173         hide frame waitfram .
      174     if     not mWaitFramView
      175        and mWaitProcEvent
      176     then
      177       process events .
      178     end.
      179   end procedure.
      180   procedure waitfram-show :
      181     define input  parameter p-message as character no-undo .
      182     define variable v-left-margin as integer   no-undo .
      183     if not session:batch-mode
      184     then do
      185     on error undo, return error return-value
      186     :
      187       if length(p-message) <= 70 then do:
      188         assign
      189           v-left-margin = integer((70 - length(p-message)) / 2)
      190         .
      191         assign
      192           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      193         .
      194         assign
      195           v-waitfram-action01 = " "
      196           v-waitfram-action02 = " "
      197                                    + fill(" ", v-left-margin)
      198                                    + p-message
      199           v-waitfram-action03 = " "
      200         .
      201       end.
      202       else do:
      203         define variable vRindex1 as integer no-undo.
      204         define variable vRindex2 as integer no-undo.
      205         vRindex1 = r-index(p-message," ",70).
      206         if vRindex1 = 0
      207         then
      208            vRindex1 = 70.
      209         if length(p-message)  <= vRindex1 + 70 then do:
      210           assign
      211             v-waitfram-action01 = " "
      212             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      213             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      214           .
      215         end.
      216         else do:
      217           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      218           if vRindex2 <= vRindex1
      219           then
      220              vRindex2 = vRindex1 + 70.
      221           assign
      222             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      223             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      224             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      225           .
      226         end.
      227       end.
      228       B-viewProcInfo:visible   in frame waitfram = no.
      229       B-viewProcInfo:sensitive in frame waitfram = no.
      230       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      231       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      232       if  (   mWaitFramView
      233          or  mWaitProcEvent)
      234          and not mBatchMode
      235       then
      236          display
      237             v-waitfram-action01 skip
      238             v-waitfram-action02 skip
      239             v-waitfram-action03 skip
      240          with frame waitfram .
      241       if     mWaitFramView
      242          then do:
      243             if     mWaitFramInterval ne ?
      244                and not mBatchMode
      245             then
      246                wait-for go of frame waitfram pause mWaitFramInterval.
      247          end.
      248          else
      249             if     mWaitProcEvent
      250                and not mBatchMode
      251             then
      252                process events .
      253     end.
      254   end procedure.
      255      procedure waitfram-show-this:
      256         define input  parameter iInterval as int64 no-undo.
      257         define variable vtime as int64 no-undo.
      258         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      259         mWaitFramInterval = iInterval.
      260         run waitfram-show (substitute("&1&2 &3&4" ,
      261                                       mWaitFramTextBeg ,
      262                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      263                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      264                                       mWaitFramTextEnd
      265                                      )
      266                           ).
      267      end.
      268      procedure WaitFramRunPause:
      269         define input  parameter iInterval as dec no-undo.
      270         define variable vStart  as datetime-tz no-undo.
      271         define variable vend    as datetime-tz no-undo.
      272         define variable vint as int64 no-undo.
      273         define variable vOk as logical no-undo.
      274         vStart = now.
      275         vend   = vStart.
      276         publish "WaitFramPause" (iInterval,output vOk).
      277         vend   =  now.
      278         vint = vend - vStart.
      279         vint = iInterval - vint / 1000.
      280         if     not mWaitFramStop
      281            and (   vint > 0
      282                 or (    not vOk
      283                     and iInterval eq ?
      284                     )
      285                 )
      286         then
      287            run waitfram-show-this (iInterval).
      288         vend   =  now.
      289         vint = vend - vStart.
      290         vint = iInterval - vint / 1000.
      291         if     not mWaitFramStop
      292            and vint > 0
      293         then do:
      294            run gbl/pause.p (vint * 1000).
      295         end.
      296         if iInterval ne ?
      297         then
      298            publish "WaitFramStop".
      299         waitfram-check-timeout().
      300      end.
      301      procedure WaitFramWaitFor:
      302         define input  parameter iInterval as dec no-undo.
      303         assign
      304            mWaitFramStartProc   = now
      305            mWaitFramStopUser    = no
      306            mWaitFramStopTimeOut = no
      307         .
      308         block-wait:
      309         do while not mWaitFramStop:
      310            run WaitFramRunPause (iInterval).
      311            if  waitfram-check-timeout()
      312            then do:
      313               leave block-wait.
      314            end.
      315         end.
      316         run waitfram-hide.
      317      end.
      318   procedure waitfram-join :
      319     define input  parameter p-line-1  as character no-undo .
      320     define input  parameter p-line-2  as character no-undo .
      321     define input  parameter p-line-3  as character no-undo .
      322     define output parameter p-message as character no-undo .
      323     do
      324     on error undo, return error return-value
      325     :
      326       assign
      327         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      328                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      329                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      330       .
      331     end.
      332   end procedure.
      333   function waitfram-join-function returns character
      334     (input p-line-1 as character
      335     ,input p-line-2 as character
      336     ,input p-line-3 as character
      337     ).
      338     define variable v-message as character no-undo .
      339     run waitfram-join in this-procedure
      340       (input  p-line-1
      341       ,input  p-line-2
      342       ,input  p-line-3
      343       ,output v-message
      344       ) .
      345     return v-message .
      346   end function .
      347   define new global shared variable g#language as character no-undo .
      348   if g#language <> '' and g#language <> 'rus':U then do:
      349     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      350   end.
      351   define new global shared variable g#library  as handle no-undo .
      352   define new global shared variable g#library2 as handle no-undo .
      353   procedure proc-alt-shift-f2:
      354     if not ibs.th.gbl.gbl-var:rcode
      355   then
      356     run gbl\inidebug.p .
      357   end.
      358   procedure proc-alt-shift-f3:
      359     run gbl/prvssinf.p
      360       ( input this-procedure
      361       ) .
      362   end.
      363   define variable v-inform-launched as logical no-undo initial false .
      364   procedure proc-alt-shift-f4:
      365     define variable v-action as character no-undo .
      366     if v-inform-launched = false then do:
      367       assign
      368         v-inform-launched = true
      369       .
      370       run gbl/d-inform.w
      371         (  input self
      372         ,  input this-procedure
      373         , output v-action
      374         ) no-error .
      375       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      376       assign
      377         v-inform-launched = false
      378       .
      379     end.
      380   end.
      381   procedure proc-alt-f1:
      382     run gbl/corrhelp.p
      383       (input this-procedure
      384       ) .
      385   end .
      386   on alt-shift-f2 anywhere do:
      387     run proc-alt-shift-f2.
      388   end.
      389   on alt-shift-f3 anywhere do:
      390     run proc-alt-shift-f3 in this-procedure .
      391   end.
      392   on alt-shift-f4 anywhere do:
      393     run proc-alt-shift-f4 in this-procedure.
      394   end.
      395   on alt-f1 anywhere do:
      396     run proc-alt-f1 in this-procedure .
      397   end.
      398   function diff-list returns character (
      399     input parfirst-list  as character,
      400     input parsecond-list as character,
      401     input pardelim       as character).
      402     if pardelim = ""
      403     or pardelim = ?
      404     then do:
      405       assign
      406         pardelim = ","
      407       .
      408     end.
      409     def var ind as integer no-undo .
      410     def var v-elem as character no-undo .
      411     def var v-result-list as character no-undo init "".
      412     def var v-num-parfirst-list as integer no-undo .
      413     assign
      414       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      415     .
      416     do ind = 1 to v-num-parfirst-list
      417     :
      418       assign
      419         v-elem = entry(ind, parfirst-list, pardelim)
      420       .
      421       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      422         assign
      423           v-result-list = v-result-list
      424                         + (if v-result-list > "" then pardelim else "")
      425                         + v-elem
      426         .
      427       end.
      428     end.
      429     return v-result-list .
      430   end function.
      431   function add-list returns character (
      432    input parfirst-list  as character,
      433    input parsecond-list as character,
      434    input pardelim       as character).
      435     if pardelim = ""
      436     or pardelim = ?
      437     then do:
      438       assign
      439         pardelim = ","
      440       .
      441     end.
      442     def var ind as integer no-undo .
      443     def var v-elem as character no-undo .
      444     def var v-result-list as character no-undo init "".
      445     def var v-num-parfirst-list as integer no-undo .
      446     assign
      447       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      448     .
      449     do ind = 1 to v-num-parfirst-list
      450     :
      451       assign
      452         v-elem = entry(ind, parfirst-list, pardelim)
      453       .
      454       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      455         assign
      456           v-result-list = v-result-list
      457                         + (if v-result-list > "" then pardelim else "")
      458                         + v-elem
      459         .
      460       end.
      461     end.
      462     def var v-num-parsecond-list as integer no-undo .
      463     assign
      464       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      465     .
      466     do ind = 1 to v-num-parsecond-list
      467     :
      468       assign
      469         v-elem = entry(ind, parsecond-list, pardelim)
      470       .
      471       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      472         assign
      473           v-result-list = v-result-list
      474                         + (if v-result-list > "" then pardelim else "")
      475                         + v-elem
      476         .
      477       end.
      478     end.
      479     return v-result-list .
      480   end function.
      481   function cross-list returns character (
      482    input parfirst-list  as character,
      483    input parsecond-list as character,
      484    input pardelim       as character).
      485     if pardelim = ""
      486     or pardelim = ?
      487     then do:
      488       assign
      489         pardelim = ","
      490       .
      491     end.
      492     def var ind as integer no-undo .
      493     def var v-elem as character no-undo .
      494     def var v-result-list as character no-undo init "".
      495     def var v-num-parfirst-list as integer no-undo .
      496     assign
      497       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      498     .
      499     do ind = 1 to v-num-parfirst-list
      500     :
      501       assign
      502         v-elem = entry(ind, parfirst-list, pardelim)
      503       .
      504       if lookup(v-elem, v-result-list, pardelim) = 0
      505       and lookup(v-elem, parsecond-list, pardelim) > 0
      506       then do:
      507         assign
      508           v-result-list = v-result-list
      509                         + (if v-result-list > "" then pardelim else "")
      510                         + v-elem
      511         .
      512       end.
      513     end.
      514     return v-result-list .
      515   end function.
      516   function radio-label returns character (
      517    input par-rs-value  as character,
      518    input par-rs-radio-buttons as character)
      519    .
      520    DEFINE variable v-result-label as character no-undo.
      521    assign
      522    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      523                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      524                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      525                             ), par-rs-radio-buttons
      526                           )
      527    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      528    .
      529   return v-result-label.
      530   end function.
      531   function m-radio-label returns character (
      532    input par-rs-value  as character,
      533    input par-rs-radio-buttons as character,
      534    input par-delim as character
      535    )
      536    .
      537    DEFINE variable v-result-label as character no-undo.
      538    assign
      539    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      540                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      541                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      542                             ), par-rs-radio-buttons, par-delim
      543                           )
      544    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      545    .
      546   return v-result-label.
      547   end function.
      548   FUNCTION mixlist returns character
      549   (
      550    input parfirst-list  as character
      551    ,input parsecond-list as character
      552    ,input pardelim       as character
      553    ,input pardelim-result as character ) :
      554     if pardelim = ""
      555     or pardelim = ?
      556     then do:
      557       assign
      558         pardelim = ","
      559       .
      560     end.
      561     def var ind as integer no-undo .
      562     def var v-elem1 as character no-undo .
      563     def var v-elem2 as character no-undo .
      564     def var v-result-list as character no-undo init "".
      565     do ind = 1 to num-entries(parfirst-list, pardelim)
      566     :
      567       assign
      568         v-elem1 = entry(ind, parfirst-list, pardelim)
      569         v-elem2 = entry(ind, parsecond-list, pardelim)
      570       .
      571         assign
      572           v-result-list = v-result-list
      573                         + (if v-result-list > "" then pardelim-result else "")
      574                         + v-elem1 + pardelim-result + v-elem2
      575         .
      576     end.
      577     return v-result-list .
      578   END FUNCTION.
      579   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      580   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      581     define variable v-cntxt-db-num        as integer   no-undo .
      582     define variable v-cntxt-userid        as character no-undo .
      583     define variable v-cntxt-level         as character no-undo .
      584     define variable v-cntxt-host-code-obj as integer   no-undo .
      585     define variable v-cntxt-obj-type      as character no-undo .
      586     define variable v-cntxt-obj-code      as integer   no-undo .
      587     define variable v-cntxt-db-num-obj    as integer   no-undo .
      588     define variable v-cntxt-is-admin      as logical   no-undo .
      589   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      590   define variable is-elved-chr as character no-undo .
      591   define variable par-type as character no-undo .
      592   define buffer buf_prop-head for ub.prop-head.
      593   define buffer buf_prop-ref for ub.prop-ref.
      594   DEFINE BUTTON B-cdpay
      595        IMAGE-UP FILE "btn-down-arrow":U
      596        IMAGE-DOWN FILE "btn-down-arrow":U
      597        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      598        LABEL "Btn 1"
      599        SIZE 3 BY 1.
      600   DEFINE BUTTON B-exit AUTO-GO
      601        LABEL "&Ввод"
      602        SIZE 10 BY 1
      603        BGCOLOR 8 .
      604   DEFINE BUTTON B-gds
      605        IMAGE-UP FILE "btn-down-arrow":U
      606        IMAGE-DOWN FILE "btn-down-arrow":U
      607        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      608        LABEL "Btn 1"
      609        SIZE 3 BY 1.
      610   DEFINE BUTTON B-Help
      611        LABEL "Помо&щь"
      612        SIZE 3 BY 1
      613        BGCOLOR 8 .
      614   DEFINE BUTTON b-quit AUTO-END-KEY
      615        LABEL "&Отмена"
      616        SIZE 10 BY 1
      617        BGCOLOR 8 .
      618   DEFINE VARIABLE f-car-brand AS CHARACTER FORMAT "X(256)":U
      619        LABEL "Марка ТС"
      620        VIEW-AS FILL-IN
      621        SIZE 40 BY 1.07 NO-UNDO.
      622   DEFINE VARIABLE f-car-reg-number AS CHARACTER FORMAT "X(40)":U
      623        LABEL "Гос.рег.знак"
      624        VIEW-AS FILL-IN
      625        SIZE 40 BY 1 NO-UNDO.
      626   DEFINE VARIABLE f-cdpay-code AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
      627        LABEL "Тип касс. пл-жа"
      628        VIEW-AS FILL-IN NATIVE
      629        SIZE 10 BY 1 NO-UNDO.
      630   DEFINE VARIABLE f-cdpay-name AS CHARACTER FORMAT "X(256)":U
      631        VIEW-AS FILL-IN NATIVE
      632        SIZE 62.5 BY 1 NO-UNDO.
      633   DEFINE VARIABLE f-gds-code AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
      634        LABEL "Код товара"
      635        VIEW-AS FILL-IN NATIVE
      636        SIZE 10 BY 1 NO-UNDO.
      637   DEFINE VARIABLE f-gds-name AS CHARACTER FORMAT "X(256)":U
      638        VIEW-AS FILL-IN NATIVE
      639        SIZE 62.5 BY 1 NO-UNDO.
      640   DEFINE VARIABLE f-limit AS DECIMAL FORMAT "->>>,>>>,>>9.99":U INITIAL 0
      641        LABEL "Лимит кредита по данному топливу (сумма)"
      642        VIEW-AS FILL-IN
      643        SIZE 30 BY 1 NO-UNDO.
      644   DEFINE VARIABLE f-limit-l AS DECIMAL FORMAT "->>>,>>>,>>9.99":U INITIAL 0
      645        LABEL "Лимит кредита по данному топливу (кол-во)"
      646        VIEW-AS FILL-IN
      647        SIZE 30 BY 1 NO-UNDO.
      648   DEFINE VARIABLE f-quota AS DECIMAL FORMAT ">>>,>>>,>>9.99":U INITIAL 0
      649        LABEL "Квота на топливо за период времени"
      650        VIEW-AS FILL-IN
      651        SIZE 21 BY 1.07 NO-UNDO.
      652   DEFINE VARIABLE rs-account-type AS INTEGER
      653        VIEW-AS RADIO-SET VERTICAL
      654        RADIO-BUTTONS
      655             "Безлимитный бензиновый", 7,
      656   "Безлимитный денежный", 6,
      657   "Лимитный бензиновый", 5,
      658   "Неопределено", 0
      659        SIZE 34.5 BY 5 NO-UNDO.
      660   DEFINE VARIABLE rs-limit-type AS CHARACTER
      661        VIEW-AS RADIO-SET VERTICAL
      662        RADIO-BUTTONS
      663             "Лимит в валюте продаж", "sum",
      664   "Лимит по кол-ву топлива", "qnty"
      665        SIZE 40.5 BY 2.13 NO-UNDO.
      666   DEFINE VARIABLE RS-quota-period AS CHARACTER
      667        VIEW-AS RADIO-SET VERTICAL
      668        RADIO-BUTTONS
      669             "Месяц", "month",
      670   "День", "day"
      671        SIZE 27 BY 1.77 NO-UNDO.
      672   DEFINE FRAME Dialog-Frame
      673        B-exit AT ROW 1 COL 1
      674        b-quit AT ROW 1 COL 11
      675        B-Help AT ROW 1 COL 95
      676        f-gds-code AT ROW 2.5 COL 19 COLON-ALIGNED
      677        f-gds-name AT ROW 2.5 COL 35 COLON-ALIGNED NO-LABEL
      678        B-gds AT ROW 2.6 COL 32.5
      679        B-cdpay AT ROW 3.67 COL 32.5 WIDGET-ID 2
      680        f-cdpay-code AT ROW 3.77 COL 19 COLON-ALIGNED
      681        f-cdpay-name AT ROW 3.77 COL 35 COLON-ALIGNED NO-LABEL
      682        rs-account-type AT ROW 5.5 COL 63.5 NO-LABEL
      683        f-car-brand AT ROW 5.77 COL 19 COLON-ALIGNED
      684        f-car-reg-number AT ROW 7.33 COL 19 COLON-ALIGNED
      685        rs-limit-type AT ROW 8.5 COL 21 NO-LABEL
      686        f-limit AT ROW 11 COL 46.5 COLON-ALIGNED
      687        f-limit-l AT ROW 12.5 COL 46.5 COLON-ALIGNED
      688        f-quota AT ROW 14 COL 38 COLON-ALIGNED
      689        RS-quota-period AT ROW 14 COL 71 NO-LABEL
      690        SPACE(1.69) SKIP(0.49)
      691       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      692            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      693            TITLE "Топливо по ДК"
      694            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      695   ASSIGN
      696          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      697          FRAME Dialog-Frame:HIDDEN           = TRUE.
      698   ASSIGN
      699          f-cdpay-code:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      700   ASSIGN
      701          f-cdpay-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      702   ASSIGN
      703          f-gds-code:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      704   ASSIGN
      705          f-gds-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      706   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      707   DO:
      708     APPLY "END-ERROR":U TO SELF.
      709   END.
      710   ON CHOOSE OF B-cdpay IN FRAME Dialog-Frame
      711   DO:
      712   DEFINE variable v-rid-list AS CHARACTER NO-UNDO.
      713   DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
      714   IF f-cdpay-code <> 0 THEN DO:
      715      FIND FIRST buf_cash-pay NO-LOCK WHERE
      716                buf_cash-pay.cdpay-code = f-cdpay-code
      717          AND buf_cash-pay.curr-code = 0 NO-ERROR.
      718      IF AVAILABLE buf_cash-pay THEN DO:
      719          ASSIGN
      720              v-rid-list = STRING(RECID(buf_cash-pay)).
      721      END.
      722   END.
      723   run ref/cashpays.w ( INPUT parparentproc
      724                       ,INPUT "b-sel"
      725                       ,input 'все':U
      726                       ,INPUT v-cntxt-host-code-obj
      727                        ,INPUT v-cntxt-obj-type
      728                        ,INPUT v-cntxt-obj-code
      729                        ,OUTPUT v-rid-list) NO-ERROR.
      730   IF NOT ERROR-STATUS:ERROR THEN DO:
      731     FIND FIRST buf_cash-pay NO-LOCK WHERE
      732               recid(buf_cash-pay) = INTEGER(v-rid-list) NO-ERROR.
      733     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      734     ASSIGN
      735     f-cdpay-code = buf_cash-pay.cdpay-code
      736     f-cdpay-name = buf_cash-pay.obj-name
      737     .
      738   END.
      739   DISPLAY
      740   f-cdpay-code
      741   f-cdpay-name
      742   WITH FRAME Dialog-Frame.
      743   END.
      744   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      745   DO:
      746     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      747     IF ERROR-STATUS:error THEN RETURN NO-APPLY.
      748   END.
      749   ON CHOOSE OF B-gds IN FRAME Dialog-Frame
      750   DO:
      751   DEFINE variable v-rid-list AS CHARACTER NO-UNDO.
      752   DEFINE BUFFER buf_goods FOR ub.goods.
      753      run ref/petrlref.p ( INPUT parparentproc
      754                     ,INPUT "b-sel"
      755                     ,OUTPUT v-rid-list ) NO-ERROR.
      756   IF NOT ERROR-STATUS:ERROR THEN DO:
      757     FIND FIRST buf_goods NO-LOCK WHERE
      758               recid(buf_goods) = INTEGER(v-rid-list) NO-ERROR.
      759     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      760     ASSIGN
      761     f-gds-code = buf_goods.gds-code
      762     f-gds-name = buf_goods.gds-name
      763     .
      764   END.
      765   DISPLAY
      766   f-gds-code
      767   f-gds-name
      768   WITH FRAME Dialog-Frame.
      769   END.
      770   ON VALUE-CHANGED OF rs-limit-type IN FRAME Dialog-Frame
      771   DO:
      772     ASSIGN
      773     rs-limit-type.
      774     CASE rs-limit-type:
      775         WHEN "sum" THEN DO:
      776           DISPLAY
      777           f-limit
      778           WITH FRAME Dialog-Frame.
      779           ENABLE
      780           f-limit when p-mode <> 'ПРОСМОТР':U
      781           WITH FRAME Dialog-Frame.
      782           HIDE
      783           f-limit-l
      784           IN FRAME Dialog-Frame.
      785         END.
      786         WHEN "qnty" THEN DO:
      787           DISPLAY
      788           f-limit-l
      789           WITH FRAME Dialog-Frame.
      790           ENABLE
      791           f-limit-l when p-mode <> 'ПРОСМОТР':U
      792           WITH FRAME Dialog-Frame.
      793           HIDE
      794           f-limit
      795           IN FRAME Dialog-Frame.
      796         END.
      797     END CASE.
      798   END.
      799   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      800   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      801   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      802   on help of frame Dialog-Frame
      803   do:
      804     run gbl/app_help.p
      805       (input this-procedure :file-name
      806       ,input ''
      807       ,input ?
      808       ) no-error.
      809     if error-status :error then do:
      810       message
      811         "Ошибка при вызове помощи"
      812         error-status :get-message(1)
      813         view-as alert-box .
      814     end.
      815   end.
      816   run minbtn-set in this-procedure .
      817   on choose of b-help in frame Dialog-Frame
      818   do:
      819     apply "help":u to frame Dialog-Frame .
      820   end.
      821   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      822   procedure minbtn-set :
      823       do
      824           on error undo, return error return-value
      825           :
      826           define variable ii              as integer       no-undo .
      827           define variable fh              as widget-handle no-undo .
      828           define variable hh              as widget-handle no-undo .
      829           define variable v-h             as handle        extent 4 no-undo .
      830           define variable v-name-button   as character     no-undo .
      831           define variable v-help-old-x    as decimal       no-undo .
      832           define variable v-help-old-y    as decimal       no-undo .
      833           define variable v-help-old-size as decimal       no-undo .
      834           define variable v-frame-width   as decimal       no-undo .
      835           define variable jj              as integer       no-undo .
      836           do
      837               on error undo, return error
      838               :
      839               assign
      840                   v-frame-width = frame Dialog-Frame:width - 0.3
      841                   fh            = frame Dialog-Frame:first-child
      842                   hh            = fh:first-child
      843                   ii            = 1
      844                   .
      845               do while valid-handle(hh):
      846                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      847                   do:
      848                       case lc(hh:name) :
      849                           when "b-help" then
      850                               do:
      851                                   hh:load-image-up("cmp/b-help.bmp":u) .
      852                                   hh:load-image-down("cmp/b-help.bmp":u) .
      853                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      854                                   hh:TOOLTIP = "Помощь" .
      855                                   v-help-old-x = hh:column .
      856                                   v-help-old-y = hh:row    .
      857                                   v-help-old-size = hh:width .
      858                                   hh:width-chars = 2.5 .
      859                               end.
      860                           when "b-print" then
      861                               do:
      862                                   hh:load-image("cmp/b-print.bmp":u) .
      863                                   hh:TOOLTIP = "Печать" .
      864                                   v-h[ii] = hh:handle .
      865                                   ii = ii + 1 .
      866                                   hh:width-chars = 3 .
      867                               end.
      868                           when "b-history" or
      869                           when "b-hist" then
      870                               do:
      871                                   hh:load-image("cmp/b-hist.bmp":u) .
      872                                   hh:TOOLTIP = "История" .
      873                                   v-h[ii] = hh:handle .
      874                                   ii = ii + 1 .
      875                                   hh:width-chars = 3 .
      876                               end.
      877                           when "b-sch" then
      878                               do:
      879                                   hh:load-image("cmp/b-sch.bmp":u) .
      880                                   hh:TOOLTIP = "Установка Фильтра" .
      881                                   v-h[ii] = hh:handle .
      882                                   ii = ii + 1 .
      883                                   hh:width-chars = 3 .
      884                               end.
      885                           when "b-hist-user" then
      886                               do:
      887                                   hh:load-image("cmp/b-hist.bmp":u) .
      888                                   hh:TOOLTIP = "История пользователя" .
      889                                   ii = ii + 1 .
      890                               end.
      891                       end case.
      892                   end.
      893                   hh = hh:next-sibling.
      894               end.
      895               b-help:column = v-frame-width - b-help:width-chars.
      896               jj = 0.
      897               repeat ii = 4 to 1 by -1 :
      898                   if valid-handle (v-h[ii] ) then
      899                   do:
      900                       jj  = jj + 1 .
      901                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      902                       v-h[ii]:row    = v-help-old-y .
      903                   end.
      904               end.
      905           end.
      906       end.
      907   end procedure.
      908   MAIN-BLOCK:
      909   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      910      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      911   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      912     run mainmenu_getcntxt in parparentproc
      913       (output v-cntxt-db-num
      914       ,output v-cntxt-userid
      915       ,output v-cntxt-level
      916       ,output v-cntxt-host-code-obj
      917       ,output v-cntxt-obj-type
      918       ,output v-cntxt-obj-code
      919       ,output v-cntxt-db-num-obj
      920       ,output v-cntxt-is-admin
      921       ) .
      922     IF p-mode <> 'ДОБАВЛЕНИЕ':U
      923     AND p-mode <> 'ИЗМЕНЕНИЕ':U
      924     AND p-mode <> 'ПРОСМОТР':U THEN DO:
      925       MESSAGE
      926       substitute("Неверное значение параметра p-mode=&1", p-mode)
      927       VIEW-AS ALERT-BOX ERROR.
      928       UNDO, RETURN ERROR.
      929     END.
      930   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      931     (input  'is-elved'
      932     ,input  ''
      933     ,input  ''
      934     ,input  0
      935     ,input  ''
      936     ,input  ''
      937     ,input  ''
      938     ,input  no
      939     ,output is-elved-chr
      940     ,output par-type
      941     ) no-error .
      942     if error-status:error
      943     or logical(is-elved-chr) = no then do:
      944       message
      945       "В Вашей конфигурации нельзя работать с этим свойством ДК," skip
      946       "так как не включен конфигурационный параметр is-elved"
      947       view-as alert-box .
      948       undo, return error .
      949     end.
      950     find first buf_prop-head no-lock where
      951               buf_prop-head.dtm-code = p-dtm-code.
      952     find first buf_prop-ref no-lock where
      953             buf_prop-ref.dtm-code = p-dtm-code
      954         and buf_prop-ref.dt-code = p-dt-code.
      955     RUN Myenable IN THIS-PROCEDURE.
      956     WAIT-FOR GO OF FRAME Dialog-Frame.
      957   END.
      958   RUN disable_UI.
      959   PROCEDURE disable_UI :
      960     HIDE FRAME Dialog-Frame.
      961   END PROCEDURE.
      962   PROCEDURE enable_UI :
      963     DISPLAY f-gds-code f-gds-name f-cdpay-code f-cdpay-name rs-account-type
      964             f-car-brand f-car-reg-number rs-limit-type f-limit f-limit-l f-quota
      965             RS-quota-period
      966         WITH FRAME Dialog-Frame.
      967     ENABLE B-exit b-quit B-Help B-gds B-cdpay rs-account-type f-car-brand
      968            f-car-reg-number rs-limit-type f-limit f-limit-l f-quota
      969            RS-quota-period
      970         WITH FRAME Dialog-Frame.
      971     VIEW FRAME Dialog-Frame.
      972   END PROCEDURE.
      973   PROCEDURE MyEnable :
      974   DEFINE BUFFER buf_goods FOR ub.goods.
      975   DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
      976   DEFINE BUFFER buf_dis-card-type FOR ub.dis-card-type.
      977   IF p-sum-id <> "":U THEN DO:
      978     FIND FIRST buf_goods NO-LOCK WHERE
      979               buf_goods.gds-code = integer(substring(p-sum-id, LENGTH("petrol-") + 1)) NO-ERROR.
      980     IF AVAILABLE buf_goods THEN DO:
      981        ASSIGN
      982        f-gds-code = buf_goods.gds-code
      983        f-gds-name = buf_goods.gds-name
      984        .
      985     END.
      986   END.
      987   FOR EACH temp-dis-card-property where
      988          temp-dis-card-property.dtm-code = p-dtm-code
      989       and temp-dis-card-property.sum-id = p-sum-id:
      990      CASE temp-dis-card-property.node-code:
      991        WHEN 1 THEN DO:
      992          f-car-reg-number = temp-dis-card-property.property-value-character.
      993        END.
      994        WHEN 2 THEN DO:
      995           f-car-brand = temp-dis-card-property.property-value-character.
      996        END.
      997        WHEN 3 THEN DO:
      998           rs-limit-type = temp-dis-card-property.property-value-character.
      999        END.
     1000        WHEN 4 THEN DO:
     1001           f-limit = temp-dis-card-property.property-value-decimal.
     1002        END.
     1003        WHEN 5 THEN DO:
     1004           f-limit-l = temp-dis-card-property.property-value-decimal.
     1005        END.
     1006        WHEN 6 THEN DO:
     1007           rs-quota-period = temp-dis-card-property.property-value-character.
     1008        END.
     1009        WHEN 7 THEN DO:
     1010          f-quota = temp-dis-card-property.property-value-decimal.
     1011        END.
     1012        WHEN 8 THEN DO:
     1013          IF p-mode = 'ДОБАВЛЕНИЕ':U
     1014          AND p-sum-id = 'petrol-':U     THEN DO:
     1015            temp-dis-card-property.property-value-integer = 6.
     1016          END.
     1017          rs-account-type = temp-dis-card-property.property-value-integer.
     1018        END.
     1019        WHEN 9 THEN DO:
     1020          FIND FIRST buf_cash-pay NO-LOCK WHERE
     1021                      buf_cash-pay.cdpay-code = temp-dis-card-property.property-value-integer
     1022                  and buf_cash-pay.curr-code = 0 NO-ERROR.
     1023           IF AVAILABLE buf_cash-pay THEN DO:
     1024               ASSIGN
     1025               f-cdpay-code = buf_cash-pay.cdpay-code
     1026               f-cdpay-name = buf_cash-pay.obj-name
     1027               .
     1028           END.
     1029       END.
     1030     END CASE.
     1031   END.
     1032   IF p-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
     1033     ASSIGN
     1034     rs-limit-type = "sum".
     1035     FIND FIRST buf_Dis-card-type NO-LOCK WHERE
     1036           buf_dis-card-type.emitent-host-code = p-emitent-host-code
     1037       AND   buf_dis-card-type.TYPE = p-type
     1038     AND buf_dis-card-type.host-code = 0
     1039     AND buf_Dis-card-type.obj-type = '':U
     1040     AND buf_Dis-card-type.obj-code = 0 NO-ERROR.
     1041     IF NOT AVAILABLE buf_dis-card-type THEN DO:
     1042       MESSAGE
     1043       "Не определен тип ДК" SKIP
     1044         "Невозможно задать свойство"
     1045         VIEW-AS ALERT-BOX ERROR.
     1046       UNDO, RETURN ERROR.
     1047     END.
     1048     IF buf_dis-card-type.dflt-debet-card  THEN DO:
     1049       IF buf_dis-card-type.pay-code > 0  THEN DO:
     1050         FIND FIRST buf_cash-pay NO-LOCK WHERE
     1051               buf_cash-pay.cdpay-code = buf_dis-card-type.pay-code
     1052             AND buf_cash-pay.curr-code = 0 NO-ERROR.
     1053         IF AVAILABLE buf_cash-pay THEN DO:
     1054             ASSIGN
     1055             f-cdpay-code = buf_cash-pay.cdpay-code
     1056             f-cdpay-name = buf_cash-pay.obj-name
     1057             .
     1058         END.
     1059       END.
     1060     END.
     1061   END.
     1062   DISPLAY
     1063   f-gds-code
     1064   f-gds-name
     1065   f-cdpay-code
     1066   f-cdpay-name
     1067   f-car-brand
     1068   f-car-reg-number
     1069   rs-limit-type
     1070   f-limit
     1071   f-limit-l
     1072   rs-quota-period
     1073   f-quota
     1074   rs-account-type
     1075   WITH FRAME Dialog-Frame.
     1076   ENABLE
     1077   B-exit WHEN p-mode <> 'ПРОСМОТР':U
     1078   b-quit
     1079   B-Help
     1080   f-car-reg-number WHEN p-mode <> 'ПРОСМОТР':U
     1081   f-car-brand WHEN p-mode <> 'ПРОСМОТР':U
     1082   f-limit WHEN p-mode <> 'ПРОСМОТР':U
     1083   f-limit-l WHEN p-mode <> 'ПРОСМОТР':U
     1084   rs-limit-type WHEN p-mode <> 'ПРОСМОТР':U
     1085   f-quota WHEN p-mode <> 'ПРОСМОТР':U
     1086   rs-account-type WHEN p-mode <> 'ПРОСМОТР':U
     1087   rs-quota-period WHEN p-mode <> 'ПРОСМОТР':U
     1088   b-cdpay WHEN p-mode <> 'ПРОСМОТР':U
     1089   WITH FRAME Dialog-Frame.
     1090   rs-account-type:disable(radio-label(string(0), RS-account-type:radio-buttons)).
     1091   VIEW FRAME Dialog-Frame.
     1092   IF p-mode = 'ПРОСМОТР':U  THEN DO:
     1093     ASSIGN
     1094     b-quit:LABEL = "&Выход"
     1095     b-quit:COLUMN = 1
     1096     .
     1097     HIDE
     1098     b-exit
     1099     IN FRAME Dialog-Frame.
     1100   END.
     1101   APPLY "VALUE-CHANGED" to rs-limit-type.
     1102   END PROCEDURE.
     1103   PROCEDURE proc-save :
     1104   DEFINE BUFFER buf_prop-map FOR ub.prop-map.
     1105   ASSIGN
     1106   FRAME Dialog-Frame
     1107   rs-limit-type
     1108   f-gds-code
     1109   f-car-brand
     1110   f-car-reg-number
     1111   f-limit
     1112   f-limit-l
     1113   rs-quota-period
     1114   f-quota
     1115   rs-account-type
     1116   .
     1117   IF rs-account-type <> 6
     1118   AND p-sum-id = 'petrol-':U     THEN do:
     1119     MESSAGE
     1120     substitute("Если огрaничения вида топлива нет, то можно выбрать только &1"
     1121                ,radio-label ( INPUT STRING(6)
     1122                               ,INPUT rs-account-type:RADIO-BUTTONS IN FRAME Dialog-Frame)
     1123                )
     1124     VIEW-AS ALERT-BOX ERROR.
     1125   UNDO, RETURN ERROR.
     1126   END.
     1127   IF rs-account-type = 6
     1128   AND p-sum-id <> 'petrol-':U     THEN do:
     1129     MESSAGE
     1130     substitute("Если есть ограничения вида топлива, то нельзя выбрать &1"
     1131                ,radio-label ( INPUT STRING(6)
     1132                               ,INPUT rs-account-type:RADIO-BUTTONS IN FRAME Dialog-Frame)
     1133                )
     1134     VIEW-AS ALERT-BOX ERROR.
     1135   UNDO, RETURN ERROR.
     1136   END.
     1137   IF f-limit = ?
     1138   or f-limit-l = ?
     1139   OR f-quota = ?
     1140   THEN DO:
     1141     MESSAGE
     1142     "Не задано значение лимита и/или квоты по топливу"
     1143     view-as ALERT-BOX ERROR.
     1144     UNDO, RETURN ERROR.
     1145   END.
     1146   FOR EACH buf_prop-map NO-LOCK WHERE
     1147           buf_prop-map.dtm-code = p-dtm-code
     1148        and buf_prop-map.node-code > 0:
     1149     FIND FIRST temp-dis-card-property WHERE
     1150               temp-dis-card-property.d-card = p-d-card
     1151         AND   temp-dis-card-property.dt-code = p-dt-code
     1152         AND   temp-dis-card-property.node-code = buf_prop-map.node-code
     1153         AND   temp-dis-card-property.host-code = p-host-code
     1154         AND   temp-dis-card-property.obj-type = p-obj-type
     1155         AND   temp-dis-card-property.obj-code = p-obj-code NO-ERROR.
     1156     IF NOT AVAILABLE temp-dis-card-property THEN DO:
     1157       CREATE temp-dis-card-property.
     1158       ASSIGN
     1159       temp-dis-card-property.d-card = p-d-card
     1160       temp-dis-card-property.dt-code = p-dt-code
     1161       temp-dis-card-property.dtm-code = p-dtm-code
     1162       temp-dis-card-property.sum-id = p-sum-id
     1163       temp-dis-card-property.node-code = buf_prop-map.node-code
     1164       temp-dis-card-property.host-code = p-host-code
     1165       temp-dis-card-property.obj-type = p-obj-type
     1166       temp-dis-card-property.obj-code = p-obj-code
     1167       temp-dis-card-property.prop-label = buf_prop-head.prop-label
     1168       temp-dis-card-property.node-label = buf_prop-map.node-label
     1169       temp-dis-card-property.data-type = buf_prop-map.node-value-type
     1170       .
     1171     END.
     1172   END.
     1173   FOR EACH temp-dis-card-property
     1174      where temp-dis-card-property.d-card = p-d-card
     1175   and temp-dis-card-property.dtm-code = p-dtm-code
     1176   and temp-dis-card-property.dt-code = p-dt-code
     1177      :
     1178      CASE temp-dis-card-property.node-code:
     1179        WHEN 1 THEN DO:
     1180          temp-dis-card-property.property-value-character = f-car-reg-number.
     1181        END.
     1182        WHEN 2 THEN DO:
     1183          temp-dis-card-property.property-value-character = f-car-brand.
     1184        END.
     1185        WHEN 3 THEN DO:
     1186           temp-dis-card-property.property-value-character = rs-limit-type.
     1187        END.
     1188        WHEN 4 THEN DO:
     1189           temp-dis-card-property.property-value-decimal = f-limit .
     1190        END.
     1191        WHEN 5 THEN DO:
     1192           temp-dis-card-property.property-value-decimal = f-limit-l .
     1193        END.
     1194        WHEN 6 THEN DO:
     1195           temp-dis-card-property.property-value-character = rs-quota-period .
     1196        END.
     1197        WHEN 7 THEN DO:
     1198          temp-dis-card-property.property-value-decimal = f-quota .
     1199        END.
     1200        WHEN 8 THEN DO:
     1201          temp-dis-card-property.property-value-integer = rs-account-type .
     1202        END.
     1203        WHEN 9 THEN DO:
     1204            temp-dis-card-property.property-value-integer = f-cdpay-code.
     1205       END.
     1206     END CASE.
     1207   END.
     1208   ASSIGN
     1209   p-setted = YES
     1210   .
     1211   END PROCEDURE.
