     1083        BGCOLOR 8 .
     1084   DEFINE QUERY BR-coeff FOR
     1085         tt-s-coeff SCROLLING.
     1086   DEFINE QUERY BR-tree FOR
     1087         tree-s-coeff SCROLLING.
     1088   DEFINE BROWSE BR-coeff
     1089     QUERY BR-coeff DISPLAY
     1090         get-date(tt-s-coeff.s-date) column-label "Дата" format "X(5)"
     1091         tt-s-coeff.coeff-value column-label "Значение" format ">9.999%"
     1092         get-region(tt-s-coeff.host-code, tt-s-coeff.obj-type, tt-s-coeff.obj-code) column-label "Обл.действия" format "X(12)"
     1093       WITH NO-ROW-MARKERS SEPARATORS SIZE 29 BY 18
     1094            TITLE "Значения для объекта".
     1095   DEFINE BROWSE BR-tree
     1096     QUERY BR-tree SHARE-LOCK NO-WAIT DISPLAY
     1097         get-date(tree-s-coeff.s-date)
     1098         get-region(tree-s-coeff.host-code, tree-s-coeff.obj-type, tree-s-coeff.obj-code) COLUMN-LABEL "Обл.действия" FORMAT "X(12)":U
     1099         tree-s-coeff.coeff-value FORMAT ">9.999%":U
     1100         usrfulnf(tree-s-coeff.creid) FORMAT "X(10)":U
     1101         tree-s-coeff.credate FORMAT "99/99/9999":U
     1102       WITH NO-ROW-MARKERS SEPARATORS SIZE 53.4 BY 18
     1103            TITLE "Все значения".
     1104   DEFINE FRAME Dialog-Frame
     1105        b-quit AT ROW 1 COL 1
     1106        B-exit AT ROW 1 COL 11
     1107        B-add AT ROW 1 COL 31
     1108        B-chg AT ROW 1 COL 41
     1109        B-del AT ROW 1 COL 51
     1110        B-hist AT ROW 1 COL 79
     1111        B-Help AT ROW 1 COL 82
     1112        BR-coeff AT ROW 3 COL 1
     1113        BR-tree AT ROW 3 COL 31
     1114        SPACE(0.59) SKIP(1.03)
     1115       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1116            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1117            TITLE "Сезон. коэфф. для товара"
     1118            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     1119   ASSIGN
     1120          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1121          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1122   ASSIGN
     1123          B-add:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-add:HANDLE.
     1124   ASSIGN
     1125          B-chg:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-add-3:HANDLE.
     1126   ASSIGN
     1127          B-del:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-add-4:HANDLE.
     1128   ASSIGN
     1129          B-hist:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-add-2:HANDLE.
     1130   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1131   DO:
     1132     APPLY "END-ERROR":U TO SELF.
     1133   END.
     1134   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1135   DO:
     1136     if add-option = "":U then do:
     1137       run gbl/pop-up.p (self:handle, no) no-error.
     1138       if error-status:error then return no-apply.
     1139     end.
     1140     if add-option = "":U then return no-apply.
     1141     run proc-b-add in this-procedure (add-option) no-error   .
     1142     if error-status:error then do:
     1143       add-option = "":U.
     1144        return no-apply.
     1145     end.
     1146   END.
     1147   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1148   DO:
     1149   run proc-b-chg in this-procedure no-error.
     1150   if error-status:error then return no-apply.
     1151   END.
     1152   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1153   DO:
     1154     if not available tree-s-coeff then return no-apply.
     1155     run proc-b-del in this-procedure no-error.
     1156     if error-status:error then return no-apply.
     1157   END.
     1158   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1159   DO:
     1160     run proc-save in this-procedure no-error.
     1161     if error-status:error then return no-apply.
     1162   END.
     1163   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
     1164   DO:
     1165   define variable v-rid-list as character no-undo .
     1166   if available loc_s-coeff THEN
     1167   run ref/cgdshist.w (
     1168                     input parparentproc
     1169                   , input v-host-code
     1170                   , input p-obj-type
     1171                   , input p-obj-code
     1172                   , input "":U
     1173                   , "subject":U
     1174                   , input p-gds-code
     1175                   , input ?
     1176                   , input p-obj-type
     1177                   , input p-obj-code
     1178                   , input ?
     1179                   , input "":U
     1180                   , input 's-coeff':U
     1181                   , input v-cntxt-db-num
     1182                   , input-output v-rid-list  ) no-error .
     1183       apply "entry" to br-coeff.
     1184   END.
