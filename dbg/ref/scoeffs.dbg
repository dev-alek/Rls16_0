     1293   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1294   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1295   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1296   on help of frame Dialog-Frame
     1297   do:
     1298     run gbl/app_help.p
     1299       (input this-procedure :file-name
     1300       ,input ''
     1301       ,input ?
     1302       ) no-error.
     1303     if error-status :error then do:
     1304       message
     1305         "Ошибка при вызове помощи"
     1306         error-status :get-message(1)
     1307         view-as alert-box .
     1308     end.
     1309   end.
     1310   run minbtn-set in this-procedure .
     1311   on choose of b-help in frame Dialog-Frame
     1312   do:
     1313     apply "help":u to frame Dialog-Frame .
     1314   end.
     1315   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1316   procedure minbtn-set :
     1317       do
     1318           on error undo, return error return-value
     1319           :
     1320           define variable ii              as integer       no-undo .
     1321           define variable fh              as widget-handle no-undo .
     1322           define variable hh              as widget-handle no-undo .
     1323           define variable v-h             as handle        extent 4 no-undo .
     1324           define variable v-name-button   as character     no-undo .
     1325           define variable v-help-old-x    as decimal       no-undo .
     1326           define variable v-help-old-y    as decimal       no-undo .
     1327           define variable v-help-old-size as decimal       no-undo .
     1328           define variable v-frame-width   as decimal       no-undo .
     1329           define variable jj              as integer       no-undo .
     1330           do
     1331               on error undo, return error
     1332               :
     1333               assign
     1334                   v-frame-width = frame Dialog-Frame:width - 0.3
     1335                   fh            = frame Dialog-Frame:first-child
     1336                   hh            = fh:first-child
     1337                   ii            = 1
     1338                   .
     1339               do while valid-handle(hh):
     1340                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1341                   do:
     1342                       case lc(hh:name) :
     1343                           when "b-help" then
     1344                               do:
     1345                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1346                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1347                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1348                                   hh:TOOLTIP = "Помощь" .
     1349                                   v-help-old-x = hh:column .
     1350                                   v-help-old-y = hh:row    .
     1351                                   v-help-old-size = hh:width .
     1352                                   hh:width-chars = 2.5 .
     1353                               end.
     1354                           when "b-print" then
     1355                               do:
     1356                                   hh:load-image("cmp/b-print.bmp":u) .
     1357                                   hh:TOOLTIP = "Печать" .
     1358                                   v-h[ii] = hh:handle .
     1359                                   ii = ii + 1 .
     1360                                   hh:width-chars = 3 .
     1361                               end.
     1362                           when "b-history" or
     1363                           when "b-hist" then
     1364                               do:
     1365                                   hh:load-image("cmp/b-hist.bmp":u) .
     1366                                   hh:TOOLTIP = "История" .
     1367                                   v-h[ii] = hh:handle .
     1368                                   ii = ii + 1 .
     1369                                   hh:width-chars = 3 .
     1370                               end.
     1371                           when "b-sch" then
     1372                               do:
     1373                                   hh:load-image("cmp/b-sch.bmp":u) .
     1374                                   hh:TOOLTIP = "Установка Фильтра" .
     1375                                   v-h[ii] = hh:handle .
     1376                                   ii = ii + 1 .
     1377                                   hh:width-chars = 3 .
     1378                               end.
     1379                           when "b-hist-user" then
     1380                               do:
     1381                                   hh:load-image("cmp/b-hist.bmp":u) .
     1382                                   hh:TOOLTIP = "История пользователя" .
     1383                                   ii = ii + 1 .
     1384                               end.
     1385                       end case.
     1386                   end.
     1387                   hh = hh:next-sibling.
     1388               end.
     1389               b-help:column = v-frame-width - b-help:width-chars.
     1390               jj = 0.
     1391               repeat ii = 4 to 1 by -1 :
     1392                   if valid-handle (v-h[ii] ) then
     1393                   do:
     1394                       jj  = jj + 1 .
     1395                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1396                       v-h[ii]:row    = v-help-old-y .
     1397                   end.
     1398               end.
     1399           end.
     1400       end.
     1401   end procedure.
     1402   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1403   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1404   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1405   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1406   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1407   define variable v-diasize-current-frame-height as decimal   no-undo .
     1408   define variable v-diasize-change-size          as logical   no-undo .
     1409   define variable v-diasize-resize-button        as handle    no-undo .
     1410   define variable v-diasize-wndmax               as logical   no-undo .
     1411   define variable v-diasize-wndstore             as logical   no-undo .
     1412   define variable v-diasize-proc-name            as character no-undo .
     1413   define variable v-diasize-browse-handle        as handle    no-undo .
     1414   define variable v-diasize-browse-number        as integer   no-undo .
     1415   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1416   define temp-table temp-diasize-handle no-undo
     1417     field handle-value  as handle
     1418     field save-position as decimal
     1419     index xpk is primary unique handle-value
     1420     .
     1421   define temp-table temp-browse-handle no-undo
     1422     field browse-type   as character
     1423     field browse-number as integer
     1424     field browse-handle as handle
     1425     field original-size as decimal
     1426     index xpk is primary unique browse-type browse-number
     1427     index xie browse-type browse-handle
     1428   .
     1429   procedure diasize_change-height :
     1430     define input  parameter p-change-value  as decimal   no-undo .
     1431     define input  parameter p-move-resize   as logical   no-undo .
     1432     define variable v-field-group-handle    as handle    no-undo .
     1433     define variable v-object-handle         as handle    no-undo .
     1434     define variable v-frame-height          as decimal   no-undo .
     1435     define variable v-frame-virtual-height  as decimal   no-undo .
     1436     define variable v-browse-height         as decimal   no-undo .
     1437     define variable v-window-height         as decimal   no-undo .
     1438     define variable v-window-virtual-height as decimal   no-undo .
     1439     define variable v-change-sign           as integer   no-undo .
     1440     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1441     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1442     if p-change-value > 0
     1443     then do:
     1444       if frame Dialog-Frame :height + p-change-value
     1445           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1446       then do:
     1447         assign
     1448           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1449                           - (frame Dialog-Frame :height-chars)
     1450         .
     1451         if p-change-value <= 0
     1452         then do:
     1453           run diasize_position-resize-button in this-procedure .
     1454           return .
     1455         end.
     1456       end.
     1457     end.
     1458     if p-change-value < 0
     1459     then do:
     1460       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1461       then do:
     1462         assign
     1463           p-change-value = v-diasize-orig-frame-height
     1464                          - (frame Dialog-Frame :height-chars)
     1465         .
     1466         if p-change-value >= 0
     1467         then do:
     1468           run diasize_position-resize-button in this-procedure .
     1469           return .
     1470         end.
     1471       end.
     1472     end.
     1473     if p-change-value >= 0
     1474     then do:
     1475       assign
     1476         v-change-sign = 1
     1477       .
     1478     end.
     1479     else do:
     1480       assign
     1481         v-change-sign = -1
     1482       .
     1483     end.
     1484     assign
     1485       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1486     .
     1487     if p-change-value = 0
     1488     then do:
     1489       run diasize_position-resize-button in this-procedure .
     1490       return .
     1491     end.
     1492     move_block:
     1493     do
     1494     on error undo move_block, retry move_block
     1495     :
     1496       if retry
     1497       then do:
     1498         do
     1499         on error undo move_block, leave move_block
     1500         :
     1501           if p-change-value > 0
     1502           then do:
     1503             for each buf_temp-diasize-handle
     1504             on error undo, next
     1505             :
     1506               assign
     1507                 v-object-handle = buf_temp-diasize-handle.handle-value
     1508               .
     1509               if v-object-handle <> v-diasize-resize-button
     1510               then do:
     1511                 assign
     1512                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1513                 .
     1514               end.
     1515             end.
     1516             assign
     1517               v-diasize-browse-handle :height = v-browse-height
     1518             .
     1519             for each buf_temp-browse-handle
     1520               where buf_temp-browse-handle.browse-type = 'height':u
     1521             on error undo, next
     1522             :
     1523               assign
     1524                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1525               .
     1526             end.
     1527             assign
     1528               frame Dialog-Frame :height = v-frame-height
     1529             .
     1530             if frame Dialog-Frame :scrollable = true
     1531             then do:
     1532               assign
     1533                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1534               .
     1535             end.
     1536             run diasize_position-resize-button in this-procedure .
     1537           end.
     1538           else do:
     1539             if frame Dialog-Frame :scrollable = true
     1540             then do:
     1541               assign
     1542                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1543               .
     1544             end.
     1545             assign
     1546               frame Dialog-Frame :height = v-frame-height
     1547             .
     1548             assign
     1549               v-diasize-browse-handle :height = v-browse-height
     1550             .
     1551             for each buf_temp-browse-handle
     1552               where buf_temp-browse-handle.browse-type = 'height':u
     1553             on error undo, next
     1554             :
     1555               assign
     1556                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1557               .
     1558             end.
     1559             for each buf_temp-diasize-handle
     1560             on error undo, next
     1561             :
     1562               assign
     1563                 v-object-handle = buf_temp-diasize-handle.handle-value
     1564               .
     1565               if v-object-handle <> v-diasize-resize-button
     1566               then do:
     1567                 assign
     1568                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1569                 .
     1570               end.
     1571             end.
     1572             run diasize_position-resize-button in this-procedure .
     1573           end.
     1574           assign
     1575             v-diasize-change-size = false
     1576           .
     1577           leave move_block .
     1578         end.
     1579       end.
     1580       assign
     1581         v-diasize-need-full-display = true
     1582       .
     1583       if v-diasize-change-size = false
     1584       then do:
     1585         assign
     1586           v-diasize-change-size = true
     1587         .
     1588       end.
     1589       else do:
     1590         return .
     1591       end.
     1592       assign
     1593         v-frame-height = frame Dialog-Frame :height
     1594         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1595         v-browse-height = v-diasize-browse-handle :height
     1596       .
     1597       for each buf_temp-browse-handle
     1598         where buf_temp-browse-handle.browse-type = 'height':u
     1599       :
     1600         assign
     1601           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1602         .
     1603       end.
     1604       for each buf_temp-diasize-handle
     1605       :
     1606         delete buf_temp-diasize-handle .
     1607       end.
     1608       assign
     1609         v-field-group-handle = frame Dialog-Frame :first-child
     1610       .
     1611       do while valid-handle(v-field-group-handle)
     1612       :
     1613         assign
     1614           v-object-handle = v-field-group-handle :first-child
     1615         .
     1616         do while valid-handle(v-object-handle)
     1617         :
     1618           if  v-object-handle <> v-diasize-browse-handle :handle
     1619           and can-query(v-object-handle, "row")
     1620           and can-query(v-object-handle, "height")
     1621           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1622           then do:
     1623             find first buf_temp-browse-handle
     1624               where buf_temp-browse-handle.browse-type   = 'height':u
     1625                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1626               no-error .
     1627             if available buf_temp-browse-handle
     1628             then do:
     1629             end.
     1630             else do:
     1631               create buf_temp-diasize-handle .
     1632               assign
     1633                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1634                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1635               .
     1636             end.
     1637           end.
     1638           assign
     1639             v-object-handle = v-object-handle :next-sibling
     1640           .
     1641         end.
     1642         assign
     1643           v-field-group-handle = v-field-group-handle :next-sibling
     1644         .
     1645       end.
     1646       do with frame Dialog-Frame
     1647       :
     1648         hide v-diasize-resize-button .
     1649         assign
     1650           v-diasize-resize-button :row    = 1
     1651           v-diasize-resize-button :column = 1
     1652         .
     1653       end.
     1654       if p-change-value > 0
     1655       then do:
     1656         if frame Dialog-Frame :scrollable = true
     1657         then do:
     1658           assign
     1659             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1660             no-error .
     1661           if error-status :error
     1662           or error-status :get-message(1) <> ""
     1663           then do:
     1664             undo move_block, retry move_block .
     1665           end.
     1666         end.
     1667         assign
     1668           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1669           no-error .
     1670         if error-status :error
     1671         or error-status :get-message(1) <> ""
     1672         then do:
     1673           undo move_block, retry move_block .
     1674         end.
     1675         assign
     1676           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1677           no-error .
     1678         if error-status :error
     1679         or error-status :get-message(1) <> ""
     1680         then do:
     1681           undo move_block, retry move_block .
     1682         end.
     1683         for each buf_temp-browse-handle
     1684           where buf_temp-browse-handle.browse-type = 'height':u
     1685         on error undo move_block, retry move_block
     1686         :
     1687           assign
     1688             buf_temp-browse-handle.browse-handle :height
     1689               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1690             no-error .
     1691           if error-status :error
     1692           or error-status :get-message(1) <> ""
     1693           then do:
     1694             undo move_block, retry move_block .
     1695           end.
     1696         end.
     1697         for each buf_temp-diasize-handle
     1698         on error undo move_block, retry move_block
     1699         :
     1700           assign
     1701             v-object-handle = buf_temp-diasize-handle.handle-value
     1702           .
     1703           if v-object-handle <> v-diasize-resize-button
     1704           then do:
     1705             assign
     1706               v-object-handle :row = v-object-handle :row + p-change-value
     1707               no-error .
     1708             if error-status :error
     1709             or error-status :get-message(1) <> ""
     1710             then do:
     1711               undo move_block, retry move_block .
     1712             end.
     1713           end.
     1714         end.
     1715       end.
     1716       else do:
     1717         for each buf_temp-diasize-handle
     1718         on error undo move_block, retry move_block
     1719         :
     1720           assign
     1721             v-object-handle = buf_temp-diasize-handle.handle-value
     1722           .
     1723           if v-object-handle <> v-diasize-resize-button
     1724           then do:
     1725             assign
     1726               v-object-handle :row = v-object-handle :row + p-change-value
     1727               no-error .
     1728             if error-status :error
     1729             or error-status :get-message(1) <> ""
     1730             then do:
     1731               undo move_block, retry move_block .
     1732             end.
     1733           end.
     1734         end.
     1735         assign
     1736           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1737           no-error .
     1738         if error-status :error
     1739         or error-status :get-message(1) <> ""
     1740         then do:
     1741           undo move_block, retry move_block .
     1742         end.
     1743         for each buf_temp-browse-handle
     1744           where buf_temp-browse-handle.browse-type = 'height':u
     1745         on error undo move_block, retry move_block
     1746         :
     1747           assign
     1748             buf_temp-browse-handle.browse-handle :height
     1749               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1750             no-error .
     1751           if error-status :error
     1752           or error-status :get-message(1) <> ""
     1753           then do:
     1754             undo move_block, retry move_block .
     1755           end.
     1756         end.
     1757         assign
     1758           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1759           no-error .
     1760         if error-status :error
     1761         or error-status :get-message(1) <> ""
     1762         then do:
     1763           undo move_block, retry move_block .
     1764         end.
     1765         if frame Dialog-Frame :scrollable = true
     1766         then do:
     1767           assign
     1768             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1769             no-error .
     1770           if error-status :error
     1771           or error-status :get-message(1) <> ""
     1772           then do:
     1773             undo move_block, retry move_block .
     1774           end.
     1775         end.
     1776       end.
     1777       if p-move-resize = true
     1778       then do:
     1779         run diasize_position-resize-button in this-procedure .
     1780       end.
     1781       if v-diasize-wndstore = true
     1782       then do:
     1783         if connected("ub") = true
     1784         then do:
     1785           define variable v-cntxt-db-num        as integer   no-undo .
     1786           define variable v-cntxt-userid        as character no-undo .
     1787           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1788                                             , OUTPUT v-cntxt-userid
     1789                                             ) .
     1790           run gbl/wndsizew.p
     1791             (input  v-cntxt-db-num
     1792             ,input  v-cntxt-userid
     1793             ,input  v-diasize-proc-name
     1794             ,input  'height':u
     1795             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1796             ) .
     1797         end.
     1798       end.
     1799     end.
     1800     assign
     1801       v-diasize-change-size = false
     1802     .
     1803   end procedure.
     1804   procedure diasize_set-height :
     1805     define input  parameter p-new-height  as decimal   no-undo .
     1806     define input  parameter p-move-resize as logical   no-undo .
     1807     do
     1808     on error undo, return error return-value
     1809     :
     1810       run diasize_change-height in this-procedure
     1811         (input  (p-new-height - frame Dialog-Frame :height)
     1812         ,input  p-move-resize
     1813         ) .
     1814     end.
     1815   end procedure.
     1816   procedure diasize_change-width :
     1817     define input  parameter p-change-value as decimal   no-undo .
     1818     define input  parameter p-move-resize  as logical   no-undo .
     1819     define variable v-field-group-handle   as handle    no-undo .
     1820     define variable v-object-handle        as handle    no-undo .
     1821     define variable v-frame-width          as decimal   no-undo .
     1822     define variable v-frame-virtual-width  as decimal   no-undo .
     1823     define variable v-browse-width         as decimal   no-undo .
     1824     define variable v-window-width         as decimal   no-undo .
     1825     define variable v-window-virtual-width as decimal   no-undo .
     1826     define variable v-change-sign          as integer   no-undo .
     1827     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1828     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1829     if p-change-value > 0
     1830     then do:
     1831       if frame Dialog-Frame :width + p-change-value >
     1832           session :width-chars
     1833       then do:
     1834         assign
     1835           p-change-value = session :width-chars - frame Dialog-Frame :width
     1836         .
     1837         if p-change-value <= 0
     1838         then do:
     1839           run diasize_position-resize-button in this-procedure .
     1840           return .
     1841         end.
     1842       end.
     1843     end.
     1844     if p-change-value < 0
     1845     then do:
     1846       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1847       then do:
     1848         assign
     1849           p-change-value = v-diasize-orig-frame-width
     1850                          - frame Dialog-Frame :width
     1851         .
     1852         if p-change-value >= 0
     1853         then do:
     1854           run diasize_position-resize-button in this-procedure .
     1855           return .
     1856         end.
     1857       end.
     1858     end.
     1859     if p-change-value >= 0
     1860     then do:
     1861       assign
     1862         v-change-sign = 1
     1863       .
     1864     end.
     1865     else do:
     1866       assign
     1867         v-change-sign = -1
     1868       .
     1869     end.
     1870     assign
     1871       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1872     .
     1873     if p-change-value = 0
     1874     then do:
     1875       run diasize_position-resize-button in this-procedure .
     1876       return .
     1877     end.
     1878     move_block:
     1879     do
     1880     on error undo move_block, leave move_block
     1881     :
     1882       if retry
     1883       then do:
     1884         do
     1885         on error undo move_block, leave move_block
     1886         :
     1887           if p-change-value > 0
     1888           then do:
     1889             for each buf_temp-diasize-handle
     1890             on error undo, next
     1891             :
     1892               assign
     1893                 v-object-handle = buf_temp-diasize-handle.handle-value
     1894               .
     1895               if v-object-handle <> v-diasize-resize-button
     1896               then do:
     1897                 assign
     1898                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1899                 .
     1900               end.
     1901             end.
     1902             assign
     1903               v-diasize-browse-handle :width = v-browse-width
     1904             .
     1905             for each buf_temp-browse-handle
     1906               where buf_temp-browse-handle.browse-type = 'width':u
     1907             on error undo, next
     1908             :
     1909               assign
     1910                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1911               .
     1912             end.
     1913             assign
     1914               frame Dialog-Frame :width = v-frame-width
     1915             .
     1916             if frame Dialog-Frame :scrollable = true
     1917             then do:
     1918               assign
     1919                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1920               .
     1921             end.
     1922             run diasize_position-resize-button in this-procedure .
     1923           end.
     1924           else do:
     1925             if frame Dialog-Frame :scrollable = true
     1926             then do:
     1927               assign
     1928                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1929               .
     1930             end.
     1931             assign
     1932               frame Dialog-Frame :width = v-frame-width
     1933             .
     1934             for each buf_temp-browse-handle
     1935               where buf_temp-browse-handle.browse-type = 'width':u
     1936             on error undo, next
     1937             :
     1938               assign
     1939                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1940               .
     1941             end.
     1942             assign
     1943               v-diasize-browse-handle :width = v-browse-width
     1944             .
     1945             for each buf_temp-diasize-handle
     1946             on error undo, next
     1947             :
     1948               assign
     1949                 v-object-handle = buf_temp-diasize-handle.handle-value
     1950               .
     1951               if v-object-handle <> v-diasize-resize-button
     1952               then do:
     1953                 assign
     1954                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1955                 .
     1956               end.
     1957             end.
     1958             run diasize_position-resize-button in this-procedure .
     1959           end.
     1960           assign
     1961             v-diasize-change-size = false
     1962           .
     1963           leave move_block .
     1964         end.
     1965       end.
     1966       assign
     1967         v-diasize-need-full-display = true
     1968       .
     1969       if v-diasize-change-size = false
     1970       then do:
     1971         assign
     1972           v-diasize-change-size = true
     1973         .
     1974       end.
     1975       else do:
     1976         return .
     1977       end.
     1978       assign
     1979         v-frame-width = frame Dialog-Frame :width
     1980         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1981         v-browse-width = v-diasize-browse-handle :width
     1982       .
     1983       for each buf_temp-browse-handle
     1984         where buf_temp-browse-handle.browse-type = 'width':u
     1985       :
     1986         assign
     1987           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1988         .
     1989       end.
     1990       for each buf_temp-diasize-handle
     1991       :
     1992         delete buf_temp-diasize-handle .
     1993       end.
     1994       assign
     1995         v-field-group-handle = frame Dialog-Frame :first-child
     1996       .
     1997       do while valid-handle(v-field-group-handle)
     1998       :
     1999         assign
     2000           v-object-handle = v-field-group-handle :first-child
     2001         .
     2002         do while valid-handle(v-object-handle)
     2003         :
     2004           if  v-object-handle <> v-diasize-browse-handle :handle
     2005           and v-object-handle <> v-diasize-resize-button
     2006           and can-query(v-object-handle, "row")
     2007           and can-query(v-object-handle, "height")
     2008           and ( v-object-handle :col + v-object-handle :width
     2009                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2010               )
     2011           then do:
     2012             find first buf_temp-browse-handle
     2013               where buf_temp-browse-handle.browse-type   = 'width':u
     2014                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2015               no-error .
     2016             if available buf_temp-browse-handle
     2017             then do:
     2018             end.
     2019             else do:
     2020               create buf_temp-diasize-handle .
     2021               assign
     2022                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2023                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2024               .
     2025             end.
     2026           end.
     2027           assign
     2028             v-object-handle = v-object-handle :next-sibling
     2029           .
     2030         end.
     2031         assign
     2032           v-field-group-handle = v-field-group-handle :next-sibling
     2033         .
     2034       end.
     2035       do with frame Dialog-Frame
     2036       :
     2037         hide v-diasize-resize-button .
     2038         v-diasize-resize-button :row = 1.
     2039         v-diasize-resize-button :column = 1.
     2040       end.
     2041       if p-change-value > 0
     2042       then do:
     2043         if frame Dialog-Frame :scrollable = true
     2044         then do:
     2045           assign
     2046             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2047             no-error .
     2048           if error-status :error
     2049           or error-status :get-message(1) <> ""
     2050           then do:
     2051             undo move_block, retry move_block.
     2052           end.
     2053         end.
     2054         assign
     2055           frame Dialog-Frame :width = v-frame-width + p-change-value
     2056           no-error .
     2057         if error-status :error
     2058         or error-status :get-message(1) <> ""
     2059         then do:
     2060           undo move_block, retry move_block.
     2061         end.
     2062         assign
     2063           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2064         no-error .
     2065         if error-status :error
     2066         or error-status :get-message(1) <> ""
     2067         then do:
     2068           undo move_block, retry move_block.
     2069         end.
     2070         for each buf_temp-browse-handle
     2071           where buf_temp-browse-handle.browse-type = 'width':u
     2072         on error undo move_block, retry move_block
     2073         :
     2074           assign
     2075             buf_temp-browse-handle.browse-handle :width
     2076               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2077             no-error .
     2078           if error-status :error
     2079           or error-status :get-message(1) <> ""
     2080           then do:
     2081             undo move_block, retry move_block .
     2082           end.
     2083         end.
     2084         for each buf_temp-diasize-handle
     2085         on error undo move_block, retry move_block
     2086         :
     2087           assign
     2088             v-object-handle = buf_temp-diasize-handle.handle-value
     2089           .
     2090           if v-object-handle <> v-diasize-resize-button
     2091           then do:
     2092             assign
     2093               v-object-handle :col = v-object-handle :col + p-change-value
     2094               no-error .
     2095             if error-status :error
     2096             or error-status :get-message(1) <> ""
     2097             then do:
     2098               undo move_block, retry move_block .
     2099             end.
     2100           end.
     2101         end.
     2102       end.
     2103       else do:
     2104         for each buf_temp-diasize-handle
     2105         on error undo move_block, retry move_block
     2106         :
     2107           assign
     2108             v-object-handle = buf_temp-diasize-handle.handle-value
     2109           .
     2110           if v-object-handle <> v-diasize-resize-button
     2111           then do:
     2112             assign
     2113               v-object-handle :col = v-object-handle :col + p-change-value
     2114               no-error .
     2115             if error-status :error
     2116             or error-status :get-message(1) <> ""
     2117             then do:
     2118               undo move_block, retry move_block .
     2119             end.
     2120           end.
     2121         end.
     2122         for each buf_temp-browse-handle
     2123           where buf_temp-browse-handle.browse-type = 'width':u
     2124         on error undo move_block, retry move_block
     2125         :
     2126           assign
     2127             buf_temp-browse-handle.browse-handle :width
     2128               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2129             no-error .
     2130           if error-status :error
     2131           or error-status :get-message(1) <> ""
     2132           then do:
     2133             undo move_block, retry move_block .
     2134           end.
     2135         end.
     2136         assign
     2137           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2138           no-error .
     2139         if error-status :error
     2140         or error-status :get-message(1) <> ""
     2141         then do:
     2142           undo move_block, retry move_block.
     2143         end.
     2144         assign
     2145           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2146         no-error .
     2147         if error-status :error
     2148         or error-status :get-message(1) <> ""
     2149         then do:
     2150           undo move_block, retry move_block.
     2151         end.
     2152         if frame Dialog-Frame :scrollable = true
     2153         then do:
     2154           assign
     2155             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2156           no-error .
     2157           if error-status :error
     2158           or error-status :get-message(1) <> ""
     2159           then do:
     2160             undo move_block, retry move_block.
     2161           end.
     2162         end.
     2163       end.
     2164       if p-move-resize
     2165       then do:
     2166         run diasize_position-resize-button in this-procedure .
     2167       end.
     2168       if v-diasize-wndstore = true
     2169       then do:
     2170         if connected("ub") = true
     2171         then do:
     2172           define variable v-cntxt-db-num        as integer   no-undo .
     2173           define variable v-cntxt-userid        as character no-undo .
     2174           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2175                                             , OUTPUT v-cntxt-userid
     2176                                             ) .
     2177           run gbl/wndsizew.p
     2178             (input  v-cntxt-db-num
     2179             ,input  v-cntxt-userid
     2180             ,input  v-diasize-proc-name
     2181             ,input  'width':u
     2182             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2183             ) .
     2184         end.
     2185       end.
     2186     end.
     2187     assign
     2188       v-diasize-change-size = false
     2189     .
     2190   end procedure.
     2191   procedure diasize_set-width :
     2192     define input  parameter p-new-width  as decimal   no-undo .
     2193     define input  parameter p-move-resize as logical   no-undo .
     2194     do
     2195     on error undo, return error return-value
     2196     :
     2197       run diasize_change-width in this-procedure
     2198         (input  (p-new-width - frame Dialog-Frame :width)
     2199         ,input  p-move-resize
     2200         ) .
     2201     end.
     2202   end procedure.
     2203   procedure diasize_position-resize-button :
     2204     do with frame Dialog-Frame
     2205     :
     2206       hide v-diasize-resize-button .
     2207       assign
     2208         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2209                     - 1
     2210                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2211         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2212                     - 1
     2213                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2214       .
     2215       view v-diasize-resize-button .
     2216     end.
     2217   end procedure.
     2218   on alt-right anywhere
     2219   do:
     2220     run diasize_change-width in this-procedure
     2221       (input 1
     2222       ,input true
     2223       ) .
     2224     return no-apply .
     2225   end.
     2226   on alt-left anywhere
     2227   do:
     2228     run diasize_change-width in this-procedure
     2229       (input -1
     2230       ,input true
     2231       ) .
     2232     return no-apply .
     2233   end.
     2234   on alt-down anywhere
     2235   do:
     2236     run diasize_change-height in this-procedure
     2237       (input 1
     2238       ,input true
     2239       ) .
     2240     return no-apply .
     2241   end.
     2242   on alt-up anywhere
     2243   do:
     2244     run diasize_change-height in this-procedure
     2245       (input -1
     2246       ,input true
     2247       ) .
     2248     return no-apply .
     2249   end.
     2250   on alt-enter of frame Dialog-Frame
     2251   do:
     2252     run diasize_maximize in this-procedure
     2253       (input  ?
     2254       ).
     2255     return no-apply .
     2256   end.
     2257   procedure diasize_end-move :
     2258     do
     2259     on error undo, return error return-value
     2260     :
     2261       define variable v-row-delta as decimal   no-undo .
     2262       define variable v-col-delta as decimal   no-undo .
     2263       define variable v-new-row as decimal   no-undo .
     2264       define variable v-new-col as decimal   no-undo .
     2265       assign
     2266         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2267         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2268       .
     2269       assign
     2270         v-row-delta = v-new-row - frame Dialog-Frame :height
     2271         v-col-delta = v-new-col - frame Dialog-Frame :width
     2272       .
     2273       run diasize_change-height in this-procedure
     2274         (input v-row-delta
     2275         ,input true
     2276         ) .
     2277       run diasize_change-width in this-procedure
     2278         (input v-col-delta
     2279         ,input true
     2280         ) .
     2281     end.
     2282   end procedure.
     2283   procedure diasize_maximize :
     2284     define input  parameter p-action as logical   no-undo .
     2285     do
     2286     on error undo, return error return-value
     2287     :
     2288       if p-action = ?
     2289       then do:
     2290         if v-diasize-need-maximize = true
     2291         then do:
     2292           assign
     2293             p-action = true
     2294           .
     2295         end.
     2296         else do:
     2297           assign
     2298             p-action = false
     2299           .
     2300         end.
     2301       end.
     2302       if p-action = true
     2303       then do:
     2304         run diasize_change-height in this-procedure
     2305           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2306               - frame Dialog-Frame :height-chars
     2307           ,input true
     2308           ) .
     2309         run diasize_change-width in this-procedure
     2310           (input session :width-chars
     2311               - frame Dialog-Frame :width-chars
     2312           ,input true
     2313           ) .
     2314         assign
     2315           v-diasize-need-maximize = false
     2316         .
     2317       end.
     2318       else do:
     2319         run diasize_change-width in this-procedure
     2320           (input v-diasize-orig-frame-width
     2321               - frame Dialog-Frame :width-chars
     2322           ,input true
     2323           ) .
     2324         run diasize_change-height in this-procedure
     2325           (input v-diasize-orig-frame-height
     2326               - frame Dialog-Frame :height-chars
     2327           ,input true
     2328           ) .
     2329         assign
     2330           v-diasize-need-maximize = true
     2331         .
     2332       end.
     2333     end.
     2334   end procedure.
     2335   procedure diasize_restore-orig-size :
     2336     do
     2337     on error undo, return error return-value
     2338     :
     2339       assign
     2340         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2341         v-diasize-current-frame-height = frame Dialog-Frame :height
     2342       .
     2343       run diasize_set-height in this-procedure
     2344         (input  v-diasize-orig-frame-height
     2345         ,input  true
     2346         ) .
     2347       run diasize_set-width in this-procedure
     2348         (input  v-diasize-orig-frame-width
     2349         ,input  true
     2350         ) .
     2351     end.
     2352   end procedure.
     2353   procedure diasize_restore-current-size :
     2354     do
     2355     on error undo, return error return-value
     2356     :
     2357       run diasize_set-height in this-procedure
     2358         (input  v-diasize-current-frame-height
     2359         ,input  true
     2360         ) .
     2361       run diasize_set-width in this-procedure
     2362         (input  v-diasize-current-frame-width
     2363         ,input  true
     2364         ) .
     2365     end.
     2366   end procedure.
     2367   procedure diasize_set-browse-handle :
     2368     define input  parameter p-browse-handle as handle   no-undo .
     2369     define buffer buf_temp-browse-handle for temp-browse-handle .
     2370     do
     2371     on error undo, return error return-value
     2372     :
     2373       assign
     2374         v-diasize-browse-handle = p-browse-handle
     2375       .
     2376       for each buf_temp-browse-handle
     2377       on error undo, return error return-value
     2378       :
     2379         delete buf_temp-browse-handle .
     2380       end.
     2381     end.
     2382   end procedure.
     2383   procedure diasize_add_browse :
     2384     define input  parameter p-browse-type   as character no-undo .
     2385     define input  parameter p-browse-handle as handle    no-undo .
     2386     define buffer buf_temp-browse-handle for temp-browse-handle .
     2387     do
     2388     on error undo, return error return-value
     2389     :
     2390       assign
     2391         v-diasize-browse-number = v-diasize-browse-number + 1
     2392       .
     2393       create buf_temp-browse-handle .
     2394       assign
     2395         buf_temp-browse-handle.browse-type   = p-browse-type
     2396         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2397         buf_temp-browse-handle.browse-handle = p-browse-handle
     2398       .
     2399     end.
     2400   end procedure.
     2401   procedure diasize_init :
     2402     define variable v-default-value    as logical   no-undo .
     2403     define variable v-restore-saved    as logical   no-undo .
     2404     define variable v-resize-value-str as character no-undo .
     2405     do
     2406     on error undo, return error return-value
     2407     :
     2408       do with frame Dialog-Frame
     2409       :
     2410         assign
     2411           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2412           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2413           v-diasize-browse-handle     = browse BR-coeff :handle
     2414         .
     2415         create button v-diasize-resize-button
     2416         assign
     2417           parent        = frame Dialog-Frame :first-child
     2418           label         = "s"
     2419           height-pixels = 16
     2420           width-pixels  = 16
     2421           visible       = true
     2422           sensitive     = true
     2423           movable       = true
     2424           triggers:
     2425             on end-move persistent run diasize_end-move in this-procedure .
     2426           end triggers.
     2427         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2428         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2429         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2430         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2431         assign
     2432           v-diasize-wndmax = false
     2433         .
     2434         if connected("ub") = true
     2435         then do:
     2436           define variable v-cntxt-db-num        as integer   no-undo .
     2437           define variable v-cntxt-userid        as character no-undo .
     2438           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2439                                             , OUTPUT v-cntxt-userid
     2440                                             ) .
     2441           run gbl/wndpar_r.p
     2442             (input  v-cntxt-db-num
     2443             ,input  v-cntxt-userid
     2444             ,input  'wndmax':U
     2445             ,output v-diasize-wndmax
     2446             ,output v-default-value
     2447             ) .
     2448         end.
     2449         assign
     2450           v-diasize-wndstore = false
     2451         .
     2452         if connected("ub") = true
     2453         then do:
     2454           run gbl/wndpar_r.p
     2455             (input  v-cntxt-db-num
     2456             ,input  v-cntxt-userid
     2457             ,input  'wndstore':U
     2458             ,output v-diasize-wndstore
     2459             ,output v-default-value
     2460             ) .
     2461         end.
     2462         assign
     2463           v-diasize-proc-name = entry(1, program-name(2), '.')
     2464         .
     2465         if v-diasize-wndstore = true
     2466         then do:
     2467           assign
     2468             v-restore-saved = false
     2469           .
     2470           if connected("ub") = true
     2471           then do:
     2472             run gbl/wndsizer.p
     2473               (input  v-cntxt-db-num
     2474               ,input  v-cntxt-userid
     2475               ,input  v-diasize-proc-name
     2476               ,input  'height':u
     2477               ,output v-resize-value-str
     2478               ) .
     2479             if v-resize-value-str <> '':U
     2480             then do:
     2481               run diasize_change-height in this-procedure
     2482                 (input  integer(v-resize-value-str)
     2483                 ,input  true
     2484                 ) .
     2485               assign
     2486                 v-restore-saved = true
     2487               .
     2488             end.
     2489           end.
     2490           if connected("ub") = true
     2491           then do:
     2492             run gbl/wndsizer.p
     2493               (input  v-cntxt-db-num
     2494               ,input  v-cntxt-userid
     2495               ,input  v-diasize-proc-name
     2496               ,input  'width':u
     2497               ,output v-resize-value-str
     2498               ) .
     2499             if v-resize-value-str <> '':U
     2500             then do:
     2501               run diasize_change-width in this-procedure
     2502                 (input  integer(v-resize-value-str)
     2503                 ,input  true
     2504                 ) .
     2505               assign
     2506                 v-restore-saved = true
     2507               .
     2508             end.
     2509           end.
     2510           if v-restore-saved <> true
     2511           then do:
     2512             if v-diasize-wndmax = true
     2513             then do:
     2514               run diasize_maximize in this-procedure
     2515                 (input  true
     2516                 ) .
     2517             end.
     2518           end.
     2519         end.
     2520         else do:
     2521           if v-diasize-wndmax = true
     2522           then do:
     2523             run diasize_maximize in this-procedure
     2524               (input  true
     2525               ) .
     2526           end.
     2527         end.
     2528       end.
     2529     end.
     2530   end procedure.
     2531   procedure diasize_need-full-display :
     2532     define output parameter p-need-full-display as logical   no-undo .
     2533     do
     2534     on error undo, return error return-value
     2535     :
     2536       assign
     2537         p-need-full-display = v-diasize-need-full-display
     2538       .
     2539       assign
     2540         v-diasize-need-full-display = false
     2541       .
     2542     end.
     2543   end procedure.
     2544   procedure get-context :
     2545      define output parameter p-db-num as integer          no-undo.
     2546      define output parameter p-user-id as character        no-undo.
     2547      define variable v-login               as character    no-undo.
     2548      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2549      define buffer buf_user-login  for ub.user-login .
     2550      do
     2551      on error undo, return error
     2552      :
     2553            FIND FIRST buf_sys-ctrl no-lock.
     2554            ASSIGN
     2555               v-login = USERID("ub")
     2556               p-db-num = buf_sys-ctrl.db-num
     2557            .
     2558            FIND FIRST buf_user-login
     2559                 WHERE buf_user-login.db-num = p-db-num
     2560                   AND buf_user-login.user-login = v-login
     2561                 no-lock
     2562                 no-error
     2563                 .
     2564            IF AVAILABLE buf_user-login
     2565            THEN DO:
     2566               assign
     2567                  p-user-id = buf_user-login.user-id
     2568               .
     2569            END.
     2570      end.
     2571   end procedure.
     2572       run diasize_init in this-procedure .
     2573   MAIN-BLOCK:
     2574   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2575      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2576   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2577     run mainmenu_getcntxt in parparentproc
     2578       (output v-cntxt-db-num
     2579       ,output v-cntxt-userid
     2580       ,output v-cntxt-level
     2581       ,output v-cntxt-host-code-obj
     2582       ,output v-cntxt-obj-type
     2583       ,output v-cntxt-obj-code
     2584       ,output v-cntxt-db-num-obj
     2585       ,output v-cntxt-is-admin
     2586       ) .
     2587     if par-mode <> 'ИЗМЕНЕНИЕ':U
     2588     and  par-mode <> 'ПРОСМОТР':U
     2589     and  par-mode <> 'ДОБАВЛЕНИЕ':U
     2590     then do:
     2591           message
     2592       vss-workfile vss-revision vss-description skip
     2593        "Неверный параметр вызова par-mode" par-mode
     2594       view-as alert-box ERROR.
     2595       return error.
     2596     end.
     2597     if par-mode <> 'ДОБАВЛЕНИЕ':U then do:
     2598       find first buf_goods no-lock where
     2599                     buf_goods.gds-code = p-gds-code.
     2600     end.
     2601   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2602   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2603     (input  p-obj-type
     2604     ,input  p-obj-code
     2605     ,output v-host-code
     2606     )  .
     2607     if par-mode = 'ИЗМЕНЕНИЕ':U then do:
     2608       find first loc_s-coeff exclusive-lock where
     2609                    loc_s-coeff.gds-code = p-gds-code
     2610              AND loc_s-coeff.s-date = 01/01/1996
     2611              AND loc_s-coeff.host-code = 0
     2612              AND loc_s-coeff.obj-type = "":U
     2613              AND loc_s-coeff.obj-code = 0 no-wait no-error.
     2614       if locked loc_s-coeff then do:
     2615           message
     2616           "Записи сезонных коэффициентов к товару сейчас  заняты" skip
     2617           "редактирование невозможно"
     2618           view-as alert-box warning.
     2619           return.
     2620       end.
     2621       if not available loc_s-coeff then do:
     2622           run ref/scoeff01.p (
     2623                                  input-output v-recid
     2624                                  ,input 'ДОБАВЛЕНИЕ':U
     2625                                  ,input p-gds-code
     2626                                  ,input 0
     2627                                  ,input "":U
     2628                                  ,input 0
     2629                                  ,input 01/01/1996
     2630                                  ,input 0
     2631                                   ).
     2632           if v-recid <> ? then do:
     2633               find first loc_s-coeff where recid(loc_s-coeff) = v-recid exclusive-lock.
     2634           end.
     2635       end.
     2636     end.
     2637   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2638   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2639     (output v-db-num
     2640     )  .
     2641     run fill-tables in this-procedure.
     2642     RUN MyEnable.
     2643     WAIT-FOR GO OF FRAME Dialog-Frame.
     2644   END.
     2645   RUN disable_UI.
     2646   PROCEDURE disable_UI :
     2647     HIDE FRAME Dialog-Frame.
     2648   END PROCEDURE.
     2649   PROCEDURE enable_UI :
     2650     ENABLE b-quit B-exit B-add B-chg B-del B-hist B-Help BR-coeff BR-tree
     2651         WITH FRAME Dialog-Frame.
     2652     VIEW FRAME Dialog-Frame.
     2653   END PROCEDURE.
     2654   PROCEDURE fill-tables :
     2655   DEFINE VARIABLE v-today as date no-undo .
     2656   DEFINE VARIABLE v-time as integer no-undo .
     2657   define variable v-s-date like ub.s-coeff.s-date no-undo .
     2658   define variable v-i as integer no-undo .
     2659   define buffer buf_tt-s-coeff for tt-s-coeff.
     2660   define buffer buf_tt0-s-coeff for tt0-s-coeff.
     2661   run cur-time in this-procedure(output v-today, output v-time).
     2662   for each tt-s-coeff:
     2663     delete tt-s-coeff.
     2664   end.
     2665   for each tree-s-coeff:
     2666     delete tree-s-coeff.
     2667   end.
     2668   for each buf_tt0-s-coeff no-lock where
     2669               buf_tt0-s-coeff.gds-code = p-gds-code
     2670          AND buf_tt0-s-coeff.host-code = v-host-code
     2671          AND buf_tt0-s-coeff.obj-type = p-obj-type
     2672          AND buf_tt0-s-coeff.obj-code = p-obj-code
     2673   by buf_tt0-s-coeff.s-date :
     2674       find first buf_tt-s-coeff where
     2675                   buf_tt-s-coeff.gds-code = p-gds-code
     2676              AND buf_tt-s-coeff.s-date = buf_tt0-s-coeff.s-date no-error.
     2677       if not available buf_tt-s-coeff then do:
     2678           create buf_tt-s-coeff.
     2679       end.
     2680       buffer-copy buf_tt0-s-coeff to buf_tt-s-coeff.
     2681        release buf_tt-s-coeff.
     2682      if v-i = 0 then do:
     2683        assign
     2684        v-s-date = buf_tt0-s-coeff.s-date
     2685        .
     2686      end.
     2687      assign
     2688      v-i = v-i + 1
     2689      .
     2690   end.
     2691   assign
     2692   v-i = 0
     2693   .
     2694   for each buf_tt0-s-coeff no-lock where
     2695               buf_tt0-s-coeff.gds-code = p-gds-code
     2696          AND buf_tt0-s-coeff.host-code = v-host-code
     2697          AND buf_tt0-s-coeff.obj-type = "":U
     2698   AND buf_tt0-s-coeff.obj-code = 0
     2699   AND ( v-s-date = ?  or buf_tt0-s-coeff.s-date < v-s-date)
     2700   by buf_tt0-s-coeff.s-date
     2701   :
     2702       find first buf_tt-s-coeff where
     2703                   buf_tt-s-coeff.gds-code = p-gds-code
     2704              AND buf_tt-s-coeff.s-date = buf_tt0-s-coeff.s-date no-error.
     2705       if not available buf_tt-s-coeff then do:
     2706           create buf_tt-s-coeff.
     2707       end.
     2708       buffer-copy buf_tt0-s-coeff to buf_tt-s-coeff
     2709       .
     2710         release buf_tt-s-coeff.
     2711      if v-i = 0 then do:
     2712        assign
     2713        v-s-date = buf_tt0-s-coeff.s-date
     2714        .
     2715      end.
     2716      assign
     2717      v-i = v-i + 1
     2718      .
     2719   end.
     2720   assign
     2721   v-i = 0
     2722   .
     2723   for each buf_tt0-s-coeff no-lock where
     2724               buf_tt0-s-coeff.gds-code = p-gds-code
     2725          AND buf_tt0-s-coeff.host-code  = 0
     2726   AND (v-s-date = ?  or buf_tt0-s-coeff.s-date < v-s-date)
     2727   by buf_tt0-s-coeff.s-date
     2728          :
     2729       create tt-s-coeff.
     2730       buffer-copy buf_tt0-s-coeff to tt-s-coeff
     2731       .
     2732       release tt-s-coeff.
     2733   end.
     2734   find first buf_tt-s-coeff no-error.
     2735   if not available buf_tt-s-coeff then do:
     2736         create tt-s-coeff.
     2737       assign
     2738       tt-s-coeff.gds-code = p-gds-code
     2739       tt-s-coeff.host-code = 0
     2740       tt-s-coeff.obj-type = "":U
     2741       tt-s-coeff.obj-code = 0
     2742       tt-s-coeff.s-date = 01/01/1996
     2743       tt-s-coeff.coeff-value = 0
     2744       tt-s-coeff.credate = v-today
     2745       tt-s-coeff.creid = v-cntxt-userid
     2746       .
     2747   end.
     2748   for each buf_tt0-s-coeff no-lock:
     2749       create tree-s-coeff.
     2750       buffer-copy buf_tt0-s-coeff to tree-s-coeff
     2751       .
     2752   end.
     2753   END PROCEDURE.
     2754   PROCEDURE Myenable :
     2755   ASSIGN
     2756   b-add :MENU-MOUSE in frame Dialog-Frame= 1.
     2757   if v-db-num <> 0 then do:
     2758       menu-item m_global:sensitive in menu MENU-B-add = no  .
     2759       menu-item m_host:sensitive in menu MENU-B-add = no  .
     2760   end.
     2761   ENABLE
     2762   b-quit
     2763   B-exit
     2764   B-add when par-mode <> 'ПРОСМОТР':U
     2765   b-chg when par-mode <> 'ПРОСМОТР':U
     2766   b-del when par-mode <> 'ПРОСМОТР':U
     2767   B-Help
     2768   b-hist
     2769   BR-coeff
     2770   BR-tree
     2771   WITH FRAME Dialog-Frame.
     2772   VIEW FRAME Dialog-Frame.
     2773   if par-mode = 'ПРОСМОТР':U then do:
     2774     hide
     2775     b-exit
     2776     in frame Dialog-Frame.
     2777     assign
     2778     b-quit:label = "&Выход"
     2779     .
     2780   end.
     2781   assign
     2782   frame Dialog-Frame:title = frame Dialog-Frame:title + chr(32) +
     2783                               (if available buf_goods then string(buf_goods.gds-code)  else "":U)  + chr(32) +
     2784                               (if available buf_goods then string(buf_goods.gds-name, "X(30)") else "":U) + chr(32) +
     2785                               p-obj-type  + string(p-obj-code).
     2786   Run OpenBr in this-procedure.
     2787   Run OpenBrTree in this-procedure.
     2788   APPLY "ENTRY" to br-coeff.
     2789   END PROCEDURE.
     2790   PROCEDURE OpenBr :
     2791   Open QUery br-coeff for each tt-s-coeff
     2792   by tt-s-coeff.gds-code
     2793   by tt-s-coeff.s-date
     2794   .
     2795   APPLY "VALUE-CHANGED" to br-coeff in frame Dialog-Frame.
     2796   END PROCEDURE.
     2797   PROCEDURE OpenBrTree :
     2798       Open Query br-tree
     2799       for each tree-s-coeff No-LOCK where
     2800                    tree-s-coeff.gds-code = p-gds-code
     2801               use-index idate
     2802           .
     2803   APPLY "entry" to br-coeff in frame Dialog-Frame.
     2804   END PROCEDURE.
     2805   PROCEDURE proc-b-add :
     2806   define input parameter p-option as character no-undo.
     2807   define variable v-result as character no-undo.
     2808   CASE p-option:
     2809     when "global":U then do:
     2810           run ref/scoeffi.w (       input parparentproc
     2811                               ,input 'ДОБАВЛЕНИЕ':U
     2812                               ,input p-gds-code
     2813                               ,input  0
     2814                               ,input "":U
     2815                               ,input 0
     2816                               ,input-output TABLE tt-s-coeff
     2817                               ,input-output table tree-s-coeff
     2818                               ,output v-result
     2819                               ) no-error.
     2820       end.
     2821       when "host":U then do:
     2822           run ref/scoeffi.w (       input parparentproc
     2823                               ,input 'ДОБАВЛЕНИЕ':U
     2824                               ,input p-gds-code
     2825                               ,input  v-host-code
     2826                               ,input "":U
     2827                               ,input 0
     2828                               ,input-output TABLE tt-s-coeff
     2829                               ,input-output table tree-s-coeff
     2830                               ,output v-result
     2831                               ) no-error.
     2832       end.
     2833       when "object":U then do:
     2834           run ref/scoeffi.w (       input parparentproc
     2835                               ,input 'ДОБАВЛЕНИЕ':U
     2836                               ,input p-gds-code
     2837                               ,input  v-host-code
     2838                               ,input p-obj-type
     2839                               ,input p-obj-code
     2840                               ,input-output TABLE tt-s-coeff
     2841                               ,input-output table tree-s-coeff
     2842                               ,output v-result
     2843                               ) no-error.
     2844       end.
     2845   END CASE.
     2846   if error-status:error then do:
     2847       return error.
     2848   end.
     2849    find first del-s-coeff where
     2850                 del-s-coeff.gds-code = tree-s-coeff.gds-code
     2851            AND   del-s-coeff.host-code = tree-s-coeff.host-code
     2852            AND   del-s-coeff.obj-type = tree-s-coeff.obj-type
     2853            AND   del-s-coeff.obj-code = tree-s-coeff.obj-code
     2854            AND   del-s-coeff.s-date = tree-s-coeff.s-date
     2855            no-error.
     2856     if available del-s-coeff then do:
     2857       delete del-s-coeff.
     2858     end.
     2859   run OpenBr in this-procedure.
     2860   run OpenBrTree in this-procedure.
     2861   reposition br-coeff  to recid integer(v-result) no-error.
     2862   APPLY "ENTRY" to br-coeff in frame Dialog-Frame.
     2863   END PROCEDURE.
     2864   PROCEDURE proc-b-chg :
     2865   define variable v-coeff-value as character no-undo .
     2866   define buffer loc_clients for ub.clients.
     2867   define buffer buf_tt-s-coeff  for tt-s-coeff.
     2868   if not available tree-s-coeff then return no-apply.
     2869   if (tree-s-coeff.host-code = 0
     2870   OR tree-s-coeff.obj-type = "":U
     2871   OR tree-s-coeff.obj-code = 0)
     2872   AND v-db-num <> 0
     2873   then do:
     2874     message
     2875     "Глобальные записи и записи по фирме можно редактировать только в ГБД"
     2876     view-as alert-box error .
     2877     undo, return error.
     2878   end.
     2879   if tree-s-coeff.obj-type <> "":U
     2880   or tree-s-coeff.obj-code <> 0 then do:
     2881     find first loc_clients no-lock where
     2882                loc_clients.obj-type = tree-s-coeff.obj-type
     2883            AND loc_clients.obj-code = tree-s-coeff.obj-code no-error .
     2884     if available loc_clients and
     2885     loc_clients.db-num <> v-db-num then do:
     2886       message
     2887       "Записи по объектам можно редактировать только в той БД, к которой они принадлежат"
     2888       view-as alert-box  error .
     2889       undo, return error.
     2890     end.
     2891   end.
     2892   assign
     2893   v-coeff-value = string(tree-s-coeff.coeff-value, ">9.999%")
     2894   .
     2895     run gbl/d-prompt.w (
     2896       'title=':u + "Изменение значения сезонного коэффициента" + '\':u
     2897     + 'format=' + ">9.999%":U + '\':u
     2898     + 'type=' + 'D':U + '\':u
     2899     + 'fillin_row=2\':u
     2900     + 'fillin_col=4\':u
     2901     + 'fillin_width=20\':u
     2902     + 'fillin_height=1\':u
     2903     + 'max-chars=70\':u
     2904     + 'readonly=no':u + '\':u
     2905     , input-output v-coeff-value
     2906         ).
     2907   if return-value = 'false':u then return no-apply.
     2908   do
     2909   on error undo, return error
     2910   :
     2911     assign
     2912     tree-s-coeff.coeff-value = decimal(trim(v-coeff-value, "%":U))
     2913     v-recid  = recid(tree-s-coeff)
     2914     .
     2915     find first buf_tt-s-coeff where
     2916                buf_tt-s-coeff.s-date = tree-s-coeff.s-date
     2917            AND buf_tt-s-coeff.gds-code = tree-s-coeff.gds-code
     2918            AND buf_tt-s-coeff.host-code = tree-s-coeff.host-code
     2919            AND buf_tt-s-coeff.obj-type = tree-s-coeff.obj-type
     2920            AND buf_tt-s-coeff.obj-code = tree-s-coeff.obj-code no-error .
     2921     if avail buf_tt-s-coeff then do:
     2922       assign
     2923       buf_tt-s-coeff.coeff-value = tree-s-coeff.coeff-value
     2924       .
     2925     end.
     2926   end.
     2927   run OpenBr in this-procedure.
     2928   run OpenBrTree in this-procedure.
     2929   reposition br-coeff  to recid v-recid no-error.
     2930   APPLY "ENTRY" to br-coeff in frame Dialog-Frame.
     2931   END PROCEDURE.
     2932   PROCEDURE proc-b-del :
     2933   define buffer loc_clients   for ub.clients.
     2934     if tree-s-coeff.host-code = 0
     2935     AND tree-s-coeff.host-code = 0
     2936   AND tree-s-coeff.obj-type = "":U
     2937   AND tree-s-coeff.obj-code = 0
     2938   AND tree-s-coeff.s-date = 01/01/1996 then do:
     2939       message
     2940       "Нельзя удалить корневую запись сезонного коэффициента"
     2941       view-as alert-box error.
     2942       return error.
     2943   end.
     2944   if (tree-s-coeff.host-code = 0
     2945   OR tree-s-coeff.obj-type = "":U
     2946   OR tree-s-coeff.obj-code = 0)
     2947   AND v-db-num <> 0
     2948   then do:
     2949     message
     2950     "Глобальные записи и записи по фирме можно удалять только в ГБД"
     2951     view-as alert-box error .
     2952     undo, return error.
     2953   end.
     2954   if tree-s-coeff.obj-type <> "":U
     2955   or tree-s-coeff.obj-code <> 0 then do:
     2956     find first loc_clients no-lock where
     2957                loc_clients.obj-type = tree-s-coeff.obj-type
     2958            AND loc_clients.obj-code = tree-s-coeff.obj-code no-error .
     2959     if available loc_clients and
     2960     loc_clients.db-num <> v-db-num then do:
     2961       message
     2962       "Записи по объектам можно удалять только в той БД, к которой они принадлежат"
     2963       view-as alert-box  error .
     2964       undo, return error.
     2965     end.
     2966   end.
     2967     find first del-s-coeff where
     2968                 del-s-coeff.gds-code = tree-s-coeff.gds-code
     2969            AND   del-s-coeff.host-code = tree-s-coeff.host-code
     2970            AND   del-s-coeff.obj-type = tree-s-coeff.obj-type
     2971            AND   del-s-coeff.obj-code = tree-s-coeff.obj-code
     2972            AND   del-s-coeff.s-date = tree-s-coeff.s-date
     2973            no-error.
     2974     if not available del-s-coeff then do:
     2975       create del-s-coeff.
     2976       buffer-copy tree-s-coeff to del-s-coeff.
     2977     end.
     2978     delete tree-s-coeff.
     2979       run OpenBrTree in this-procedure no-error.
     2980       if error-status:error then return error.
     2981       APPLY "ENTRY" to br-tree in frame Dialog-Frame.
     2982   END PROCEDURE.
     2983   PROCEDURE proc-save :
     2984   define variable v-deleted as logical no-undo .
     2985   define variable v-updated as logical no-undo .
     2986   define buffer buf_tt0-s-coeff for tt0-s-coeff.
     2987   do
     2988   on error undo, return error
     2989   :
     2990   for each del-s-coeff :
     2991      find first buf_tt0-s-coeff  where
     2992                 buf_tt0-s-coeff.gds-code = del-s-coeff.gds-code
     2993             AND buf_tt0-s-coeff.host-code = del-s-coeff.host-code
     2994             AND buf_tt0-s-coeff.obj-type = del-s-coeff.obj-type
     2995             AND buf_tt0-s-coeff.obj-code = del-s-coeff.obj-code
     2996             AND buf_tt0-s-coeff.s-date = del-s-coeff.s-date
     2997           no-error.
     2998       if available buf_tt0-s-coeff then do:
     2999           delete buf_tt0-s-coeff.
     3000           v-deleted = yes.
     3001       end.
     3002   end.
     3003   ASSIGN
     3004   p-updated = v-deleted OR p-updated.
     3005   for each tree-s-coeff :
     3006      find first buf_tt0-s-coeff no-lock where
     3007                       buf_tt0-s-coeff.gds-code = tree-s-coeff.gds-code
     3008                  AND buf_tt0-s-coeff.host-code = tree-s-coeff.host-code
     3009   AND buf_tt0-s-coeff.obj-type = tree-s-coeff.obj-type
     3010   AND buf_tt0-s-coeff.obj-code = tree-s-coeff.obj-code
     3011   AND buf_tt0-s-coeff.s-date = tree-s-coeff.s-date
     3012   no-error.
     3013   if not available buf_tt0-s-coeff then do:
     3014     create buf_tt0-s-coeff.
     3015     buffer-copy tree-s-coeff except gds-code to buf_tt0-s-coeff
     3016     assign
     3017     buf_tt0-s-coeff.gds-code = p-gds-code
     3018     v-updated = yes
     3019     .
     3020   end.
     3021   else do:
     3022     if buf_tt0-s-coeff.coeff-value <> tree-s-coeff.coeff-value then do:
     3023       assign
     3024       buf_tt0-s-coeff.coeff-value = tree-s-coeff.coeff-value
     3025       v-updated = yes.
     3026    end.
     3027   end.
     3028   end.
     3029   ASSIGN
     3030   p-updated = v-updated OR p-updated.
     3031   if p-updated
     3032   and p-update-instantly then do:
     3033     run ref/s-coeff1.p (
     3034                        input par-mode
     3035                       ,input p-gds-code
     3036                       ,input v-host-code
     3037                       ,input p-obj-type
     3038                       ,input p-obj-code
     3039                       ,INPUT table tt0-s-coeff
     3040                       ) no-error .
     3041     if error-status:error then do:
     3042       message
     3043       substitute("Ошибка при сохранении сезонных коэффициентов товара:&1&2&1&3"
     3044                  , chr(10)
     3045                  , error-status:get-message(1)
     3046                  , return-value )
     3047       view-as alert-box
     3048       error .
     3049       undo, return error .
     3050     end.
     3051   end.
     3052   end.
     3053   END PROCEDURE.
     3054   FUNCTION get-date RETURNS CHARACTER
     3055     ( p-s-date as date ) :
     3056   define variable v-day as integer no-undo.
     3057   define variable v-month as integer no-undo.
     3058       if p-s-date = ? then return chr(63).
     3059     RETURN (string(day(p-s-date)) + chr(47) + string(month(p-s-date), "99":U)).
     3060   END FUNCTION.
     3061   FUNCTION get-mark RETURNS CHARACTER
     3062     ( input par-ismarked as logical, input par-rid as recid, input par-s-coeff-rid as character ) :
     3063     define variable var-mark as character no-undo.
     3064   var-mark = IF par-ismarked and  CAN-DO (string(par-s-coeff-rid), string( par-rid )) THEN ("*") ELSE (" ").
     3065   return var-mark.
     3066   END FUNCTION.
     3067   FUNCTION get-region RETURNS CHARACTER
     3068     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     3069     define variable par-region as character no-undo.
     3070     if parhost-code = 0 and
     3071          parobj-type = "":U and
     3072          parobj-code = 0 then do:
     3073          par-region = "Глобально".
     3074          return par-region.
     3075       end.
     3076       if parobj-type = "" and
     3077          parobj-code = 0 then do:
     3078          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     3079          return par-region.
     3080       end.
     3081       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     3082       return par-region.
     3083   END FUNCTION.
