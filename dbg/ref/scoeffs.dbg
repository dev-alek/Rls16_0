        1   DEFINE BUFFER buf_goods FOR ub.goods.
        2   DEFINE BUFFER buf_s-coeff FOR ub.s-coeff.
        3   DEFINE TEMP-TABLE del-s-coeff NO-UNDO LIKE ub.s-coeff.
        4   DEFINE BUFFER loc_s-coeff FOR ub.s-coeff.
        5   DEFINE TEMP-TABLE tree-s-coeff NO-UNDO LIKE ub.s-coeff.
        6   DEFINE TEMP-TABLE tt-s-coeff NO-UNDO LIKE ub.s-coeff.
        7   DEFINE TEMP-TABLE tt0-s-coeff NO-UNDO LIKE ub.s-coeff.
        8   define input parameter parparentproc as widget-handle no-undo .
        9   define input parameter par-mode as character no-undo.
       10   define input parameter p-gds-code like ub.s-coeff.gds-code no-undo.
       11   define input parameter p-obj-type like ub.s-coeff.obj-type no-undo.
       12   define input parameter p-obj-code like ub.s-coeff.obj-code no-undo.
       13   define input parameter p-update-instantly as logical no-undo .
       14   define output parameter p-updated         as logical no-undo .
       15   define input-output parameter table for tt0-s-coeff.
       16   define variable vss-revision    as character no-undo init "$Revision$":U .
       17   define variable vss-author      as character no-undo init "$Author$":U .
       18   define variable vss-date        as character no-undo init "$Date$":U .
       19   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       20   define variable vss-archive     as character no-undo init "$Archive$":U .
       21   define variable vss-description as character no-undo init "Сезонные коэффициенты для товара".
       22   procedure vss-get-info :
       23     define output parameter p-vss-revision    like vss-revision    no-undo .
       24     define output parameter p-vss-author      like vss-author      no-undo .
       25     define output parameter p-vss-date        like vss-date        no-undo .
       26     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       27     define output parameter p-vss-archive     like vss-archive     no-undo .
       28     define output parameter p-vss-description like vss-description no-undo .
       29     assign
       30       p-vss-revision    = vss-revision
       31       p-vss-author      = vss-author
       32       p-vss-date        = vss-date
       33       p-vss-workfile    = vss-workfile
       34       p-vss-archive     = vss-archive
       35       p-vss-description = vss-description
       36     .
       37   end procedure.
       38   procedure vss-get-parameters :
       39     define output parameter p-vss-parameters as character no-undo .
       40   end procedure.
       41   define new global shared variable g#vssrevis-logger as handle    no-undo .
       42   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       43   define variable v-vssrevis-logger                   as handle    no-undo .
       44   procedure vss-logevent :
       45     define input  parameter p-extra-paramters as character no-undo .
       46     define variable v-vssrevis-parameters as character no-undo .
       47     do
       48     on error undo, return error return-value
       49     :
       50       if  valid-handle(v-vssrevis-logger)
       51       and v-vssrevis-logger :get-signature("logevent") <> ""
       52       then do:
       53         run vss-get-parameters in this-procedure
       54           (output v-vssrevis-parameters
       55           ).
       56         run logevent in v-vssrevis-logger
       57           (input vss-workfile
       58           ,input vss-revision
       59           ,input v-vssrevis-parameters
       60           ,input p-extra-paramters
       61           ).
       62       end.
       63     end.
       64   end procedure.
       65   assign
       66     v-vssrevis-logger = g#vssrevis-logger
       67   .
       68   if  valid-handle(v-vssrevis-logger)
       69   and v-vssrevis-logger :get-signature("logevent") <> ""
       70   then do:
       71     assign
       72       v-vssrevis-logevent = true
       73     .
       74     run vss-logevent in this-procedure (input vss-description) .
       75   end.
       76   define new global shared variable g#language as character no-undo .
       77   if g#language <> '' and g#language <> 'rus':U then do:
       78     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       79   end.
       80   define new global shared variable g#library  as handle no-undo .
       81   define new global shared variable g#library2 as handle no-undo .
       82   procedure proc-alt-shift-f2:
       83     if not ibs.th.gbl.gbl-var:rcode
       84   then
       85     run gbl\inidebug.p .
       86   end.
       87   procedure proc-alt-shift-f3:
       88     run gbl/prvssinf.p
       89       ( input this-procedure
       90       ) .
       91   end.
       92   define variable v-inform-launched as logical no-undo initial false .
       93   procedure proc-alt-shift-f4:
       94     define variable v-action as character no-undo .
       95     if v-inform-launched = false then do:
       96       assign
       97         v-inform-launched = true
       98       .
       99       run gbl/d-inform.w
      100         (  input self
      101         ,  input this-procedure
      102         , output v-action
      103         ) no-error .
      104       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      105       assign
      106         v-inform-launched = false
      107       .
      108     end.
      109   end.
      110   procedure proc-alt-f1:
      111     run gbl/corrhelp.p
      112       (input this-procedure
      113       ) .
      114   end .
      115   on alt-shift-f2 anywhere do:
      116     run proc-alt-shift-f2.
      117   end.
      118   on alt-shift-f3 anywhere do:
      119     run proc-alt-shift-f3 in this-procedure .
      120   end.
      121   on alt-shift-f4 anywhere do:
      122     run proc-alt-shift-f4 in this-procedure.
      123   end.
      124   on alt-f1 anywhere do:
      125     run proc-alt-f1 in this-procedure .
      126   end.
      127   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      128   define variable v-waitfram-action01         as character   no-undo .
      129   define variable v-waitfram-action02         as character   no-undo .
      130   define variable v-waitfram-action03         as character   no-undo .
      131   define variable mWaitFramTextBeg            as character   no-undo.
      132   define variable mWaitFramTextEnd            as character   no-undo.
      133   define variable mWaitFramView               as logical     no-undo.
      134   define variable mWaitProcEvent              as logical     no-undo init yes.
      135   define variable mWaitFramInterval           as integer     no-undo init 1 .
      136   define variable mWaitFramStop               as logical     no-undo.
      137   define variable mWaitFramStopUser           as logical     no-undo.
      138   define variable mWaitFramStopTimeOut        as logical     no-undo.
      139   define variable mWaitFramStartProc          as datetime-tz no-undo.
      140   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      141   define button B-WaitFramStop auto-end-key
      142        label "Стоп"
      143        size 10 by 1 tooltip "Остоновить процесс".
      144   define button B-viewProcInfo
      145        label "Информация"
      146        size 15 by 1 tooltip "Информация о процесс".
      147   define frame waitfram
      148     v-waitfram-action01 format "x(72)" no-label skip
      149     v-waitfram-action02 format "x(72)" no-label skip
      150     v-waitfram-action03 format "x(72)" no-label skip
      151     B-viewProcInfo
      152     B-WaitFramStop at row 4 col 30
      153     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      154     .
      155   define new global shared variable mBatchMode as logical no-undo init ?.
      156   define variable mFramBachModHandle as handle no-undo.
      157   mFramBachModHandle = frame waitfram:handle.
      158   define variable mFameOldVis as logical no-undo.
      159   define variable mVisCUrentVin as logical no-undo.
      160   if session:batch-mode
      161   then
      162      mBatchMode = yes.
      163   if mBatchMode = ? then do:
      164     mVisCUrentVin = current-window:visible.
      165     mFameOldVis = mFramBachModHandle:visible.
      166     mFramBachModHandle:visible  = yes.
      167     mBatchMode = mFramBachModHandle:visible ne yes.
      168     mFramBachModHandle:visible = mFameOldVis.
      169     current-window:visible = mVisCUrentVin.
      170   end.
      171    if  log-manager:logfile-name ne ?
      172     then DO:
      173         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      174         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      175         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      176     end.
      177   on choose of B-WaitFramStop in frame waitfram
      178   do:
      179     mWaitFramStop = yes.
      180     mWaitFramStopUser = yes.
      181   end.
      182   function waitfram-check-timeout returns logical():
      183      define variable vtime as int64 no-undo.
      184      if mWaitFramStopTimeOut
      185      then
      186         return yes.
      187      vtime = ( now - mWaitFramStartProc ) / 1000 .
      188      if     mWaitFramTimeOut ne ?
      189         and mWaitFramTimeOut ne 0
      190         and mWaitFramTimeOut lt vtime
      191      then do:
      192         mWaitFramStopTimeOut = yes.
      193      end.
      194      return mWaitFramStopTimeOut.
      195   end.
      196   procedure waitfram-hide :
      197     if not session:batch-mode
      198     then do
      199     on error undo, return error return-value
      200     :
      201       pause 0 before-hide .
      202       if not mBatchMode then
      203         hide frame waitfram .
      204     if     not mWaitFramView
      205        and mWaitProcEvent
      206     then
      207       process events .
      208     end.
      209   end procedure.
      210   procedure waitfram-show :
      211     define input  parameter p-message as character no-undo .
      212     define variable v-left-margin as integer   no-undo .
      213     if not session:batch-mode
      214     then do
      215     on error undo, return error return-value
      216     :
      217       if length(p-message) <= 70 then do:
      218         assign
      219           v-left-margin = integer((70 - length(p-message)) / 2)
      220         .
      221         assign
      222           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      223         .
      224         assign
      225           v-waitfram-action01 = " "
      226           v-waitfram-action02 = " "
      227                                    + fill(" ", v-left-margin)
      228                                    + p-message
      229           v-waitfram-action03 = " "
      230         .
      231       end.
      232       else do:
      233         define variable vRindex1 as integer no-undo.
      234         define variable vRindex2 as integer no-undo.
      235         vRindex1 = r-index(p-message," ",70).
      236         if vRindex1 = 0
      237         then
      238            vRindex1 = 70.
      239         if length(p-message)  <= vRindex1 + 70 then do:
      240           assign
      241             v-waitfram-action01 = " "
      242             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      243             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      244           .
      245         end.
      246         else do:
      247           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      248           if vRindex2 <= vRindex1
      249           then
      250              vRindex2 = vRindex1 + 70.
      251           assign
      252             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      253             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      254             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      255           .
      256         end.
      257       end.
      258       B-viewProcInfo:visible   in frame waitfram = no.
      259       B-viewProcInfo:sensitive in frame waitfram = no.
      260       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      261       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      262       if  (   mWaitFramView
      263          or  mWaitProcEvent)
      264          and not mBatchMode
      265       then
      266          display
      267             v-waitfram-action01 skip
      268             v-waitfram-action02 skip
      269             v-waitfram-action03 skip
      270          with frame waitfram .
      271       if     mWaitFramView
      272          then do:
      273             if     mWaitFramInterval ne ?
      274                and not mBatchMode
      275             then
      276                wait-for go of frame waitfram pause mWaitFramInterval.
      277          end.
      278          else
      279             if     mWaitProcEvent
      280                and not mBatchMode
      281             then
      282                process events .
      283     end.
      284   end procedure.
      285      procedure waitfram-show-this:
      286         define input  parameter iInterval as int64 no-undo.
      287         define variable vtime as int64 no-undo.
      288         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      289         mWaitFramInterval = iInterval.
      290         run waitfram-show (substitute("&1&2 &3&4" ,
      291                                       mWaitFramTextBeg ,
      292                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      293                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      294                                       mWaitFramTextEnd
      295                                      )
      296                           ).
      297      end.
      298      procedure WaitFramRunPause:
      299         define input  parameter iInterval as dec no-undo.
      300         define variable vStart  as datetime-tz no-undo.
      301         define variable vend    as datetime-tz no-undo.
      302         define variable vint as int64 no-undo.
      303         define variable vOk as logical no-undo.
      304         vStart = now.
      305         vend   = vStart.
      306         publish "WaitFramPause" (iInterval,output vOk).
      307         vend   =  now.
      308         vint = vend - vStart.
      309         vint = iInterval - vint / 1000.
      310         if     not mWaitFramStop
      311            and (   vint > 0
      312                 or (    not vOk
      313                     and iInterval eq ?
      314                     )
      315                 )
      316         then
      317            run waitfram-show-this (iInterval).
      318         vend   =  now.
      319         vint = vend - vStart.
      320         vint = iInterval - vint / 1000.
      321         if     not mWaitFramStop
      322            and vint > 0
      323         then do:
      324            run gbl/pause.p (vint * 1000).
      325         end.
      326         if iInterval ne ?
      327         then
      328            publish "WaitFramStop".
      329         waitfram-check-timeout().
      330      end.
      331      procedure WaitFramWaitFor:
      332         define input  parameter iInterval as dec no-undo.
      333         assign
      334            mWaitFramStartProc   = now
      335            mWaitFramStopUser    = no
      336            mWaitFramStopTimeOut = no
      337         .
      338         block-wait:
      339         do while not mWaitFramStop:
      340            run WaitFramRunPause (iInterval).
      341            if  waitfram-check-timeout()
      342            then do:
      343               leave block-wait.
      344            end.
      345         end.
      346         run waitfram-hide.
      347      end.
      348   procedure waitfram-join :
      349     define input  parameter p-line-1  as character no-undo .
      350     define input  parameter p-line-2  as character no-undo .
      351     define input  parameter p-line-3  as character no-undo .
      352     define output parameter p-message as character no-undo .
      353     do
      354     on error undo, return error return-value
      355     :
      356       assign
      357         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      358                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      359                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      360       .
      361     end.
      362   end procedure.
      363   function waitfram-join-function returns character
      364     (input p-line-1 as character
      365     ,input p-line-2 as character
      366     ,input p-line-3 as character
      367     ).
      368     define variable v-message as character no-undo .
      369     run waitfram-join in this-procedure
      370       (input  p-line-1
      371       ,input  p-line-2
      372       ,input  p-line-3
      373       ,output v-message
      374       ) .
      375     return v-message .
      376   end function .
      377   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      378   procedure factord :
      379     define input  parameter p-fact-date            as date    no-undo .
      380     define input  parameter p-fact-time            as integer no-undo .
      381     define input  parameter p-fact-num             as integer no-undo .
      382     define input  parameter p-shift-date           as date    no-undo .
      383     define input  parameter p-shift-num            as integer no-undo .
      384     define input  parameter p-shift-on             as logical no-undo .
      385     define output parameter p-fact-order           as decimal no-undo .
      386     define output parameter p-shift-end-fact-order as decimal no-undo .
      387     define output parameter p-day-end-fact-order   as decimal no-undo .
      388     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      389     if p-fact-date = ?
      390     then do:
      391       return error "Не указана фактическая дата" .
      392     end.
      393     define variable v-fact-date-num as integer no-undo .
      394     assign
      395       v-fact-date-num = integer(p-fact-date)
      396     .
      397     if p-fact-num = ?
      398     or p-fact-num = 0
      399     then do:
      400       return error "Не задан p-fact-num " + string(p-fact-num) .
      401     end.
      402     if p-fact-num < 0
      403     then do:
      404       return error "Отрицательный fact-num " + string(p-fact-num) .
      405     end.
      406     if p-fact-num >= 100000000
      407     then do:
      408       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      409     end.
      410     if p-shift-on = true
      411     then do:
      412       if p-shift-date = ?
      413       then do:
      414         return error "Не задана дата смены" .
      415       end.
      416       if p-shift-num = ?
      417       or p-shift-num = 0
      418       then do:
      419         return error "Не задан номер смены" .
      420       end.
      421     end.
      422     else do:
      423       assign
      424         p-shift-date = p-fact-date
      425         p-shift-num  = 24
      426       .
      427     end.
      428     define variable v-shift-offset as integer no-undo .
      429     if p-shift-date = p-fact-date
      430     then do:
      431       assign
      432         v-shift-offset = 1
      433       .
      434     end.
      435     if p-shift-date < p-fact-date
      436     then do:
      437       assign
      438         v-shift-offset = 0
      439       .
      440     end.
      441     if p-shift-date > p-fact-date
      442     then do:
      443       message
      444         vss-workfile vss-revision vss-description skip
      445         "Неправильная дата закрытия смены" skip
      446         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      447         view-as alert-box error .
      448       undo, return error
      449         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      450           ,string(p-fact-date, '99/99/9999':U)
      451           ,string(p-shift-date, '99/99/9999':U)
      452           )
      453       .
      454     end.
      455     if p-shift-num < 1
      456     or p-shift-num > 24
      457     then do:
      458       message
      459         vss-workfile vss-revision vss-description skip
      460         "Неправильный номер смены" skip
      461         "p-shift-num" p-shift-num skip
      462         view-as alert-box error .
      463       undo, return error return-value .
      464     end.
      465     assign
      466       p-fact-order           = v-fact-date-num
      467                              + v-shift-offset * 0.5
      468                              + p-shift-num    * 0.02 - 0.01
      469                              + p-fact-num     * 0.0000000001
      470       p-shift-end-fact-order = v-fact-date-num
      471                              + v-shift-offset * 0.5
      472                              + p-shift-num    * 0.02
      473       p-day-end-fact-order   = v-fact-date-num
      474                              + 0.99
      475     .
      476     if p-fact-order           <= v-fact-date-num
      477     or p-shift-end-fact-order <= v-fact-date-num
      478     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      479     or p-shift-end-fact-order >= p-day-end-fact-order
      480     then do:
      481       message
      482         vss-workfile vss-revision vss-description skip
      483         "Внутренняя ошибка при генерации фактического номера" skip
      484         "p-fact-date"            p-fact-date            skip
      485         "p-fact-time"            p-fact-time            skip
      486         "p-fact-num"             p-fact-num             skip
      487         "p-shift-date"           p-shift-date           skip
      488         "p-shift-num"            p-shift-num            skip
      489         "p-shift-on"             p-shift-on             skip
      490         "p-shift-end-fact-order" p-shift-end-fact-order skip
      491         "p-day-end-fact-order"   p-day-end-fact-order   skip
      492         "v-fact-date-num"        v-fact-date-num        skip
      493         view-as alert-box error .
      494       undo, return error return-value .
      495     end.
      496   end procedure.
      497   procedure day-begin-fact-order :
      498     define input  parameter p-fact-date            as date    no-undo .
      499     define output parameter p-day-begin-fact-order as decimal no-undo .
      500     do
      501     on error undo, return error return-value
      502     :
      503       if p-fact-date = ?
      504       then do:
      505         assign
      506           p-day-begin-fact-order = 0
      507         .
      508       end.
      509       else do:
      510         assign
      511           p-day-begin-fact-order = integer(p-fact-date)
      512         .
      513       end.
      514     end.
      515   end procedure.
      516   procedure factord-max-fact-order :
      517     define output parameter p-max-fact-order as decimal   no-undo .
      518     do
      519     on error undo, return error return-value
      520     :
      521       run day-begin-fact-order in this-procedure
      522         (input  date(1, 1, 5000)
      523         ,output p-max-fact-order
      524         ) .
      525     end.
      526   end procedure.
      527   procedure factord-cut-archive :
      528     define input  parameter p-obj-type             as character no-undo .
      529     define input  parameter p-obj-code             as integer   no-undo .
      530     define input  parameter p-fact-date            as date      no-undo .
      531     define output parameter p-shift-on             as logical   no-undo .
      532     define output parameter p-shift-date           as date      no-undo .
      533     define output parameter p-shift-num            as integer   no-undo .
      534     define output parameter p-day-end-fact-order   as decimal   no-undo .
      535     define output parameter p-shift-end-fact-order as decimal   no-undo .
      536     define variable v-fact-order as decimal   no-undo .
      537     define buffer buf_shift-obj for ub.shift-obj .
      538     do
      539     on error undo, return error return-value
      540     :
      541   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      542   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      543     (input  p-obj-type
      544     ,input  p-obj-code
      545     ,input  'shift-on=request'
      546     ,output p-shift-on
      547     ) no-error .
      548       if error-status :error
      549       then do:
      550         message
      551           vss-workfile vss-revision vss-description skip
      552           "Ошибка при определении атрибута объекта" skip
      553           "Объект" p-obj-type p-obj-code skip
      554           error-status :get-message(1) skip
      555           return-value skip
      556           view-as alert-box error .
      557         undo, return error return-value .
      558       end.
      559       if p-shift-on = false
      560       then do:
      561         assign
      562           p-shift-date               = ?
      563           p-shift-num                = 0
      564         .
      565       end.
      566       else do:
      567         find first buf_shift-obj share-lock
      568           where buf_shift-obj.obj-type   = p-obj-type
      569             and buf_shift-obj.obj-code   = p-obj-code
      570             and buf_shift-obj.shift-date > p-fact-date
      571           use-index pi
      572           no-error .
      573         if not available buf_shift-obj
      574         or buf_shift-obj.status_ <> 'зкр':U
      575         then do:
      576           message
      577             vss-workfile vss-revision vss-description skip
      578             "Невозможно вычислить последнюю смену" skip
      579             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      580             "Объект" p-obj-type p-obj-code skip
      581             "Дата" p-fact-date skip
      582             view-as alert-box error .
      583           undo, return error return-value .
      584         end.
      585         find last buf_shift-obj share-lock
      586           where buf_shift-obj.obj-type = p-obj-type
      587             and buf_shift-obj.obj-code = p-obj-code
      588             and buf_shift-obj.shift-date <= p-fact-date
      589           use-index pi
      590           no-error .
      591         if available buf_shift-obj
      592         then do:
      593           if  buf_shift-obj.status_ = 'зкр':U
      594           then do:
      595             assign
      596               p-shift-date = buf_shift-obj.shift-date
      597               p-shift-num  = buf_shift-obj.shift-num
      598             .
      599           end.
      600           else do:
      601             message
      602               vss-workfile vss-revision vss-description skip
      603               "Невозможно вычислить последнюю смену" skip
      604               "Статус смены отличен от статуса" 'зкр':U skip
      605               "Объект" p-obj-type p-obj-code skip
      606               "Дата" p-fact-date skip
      607               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      608               view-as alert-box error .
      609             undo, return error return-value .
      610           end.
      611         end.
      612         else do:
      613           assign
      614             p-shift-date = p-fact-date - 1
      615             p-shift-num  = 1
      616           .
      617         end.
      618       end.
      619       run factord in this-procedure
      620         (input  p-fact-date
      621         ,input  1
      622         ,input  1
      623         ,input  p-shift-date
      624         ,input  p-shift-num
      625         ,input  p-shift-on
      626         ,output v-fact-order
      627         ,output p-shift-end-fact-order
      628         ,output p-day-end-fact-order
      629         ) no-error .
      630       if error-status :error
      631       then do:
      632         message
      633           vss-workfile vss-revision vss-description skip
      634           "Ошибка при вызове процедуры factord"
      635           error-status :get-message(1) skip
      636           return-value skip
      637           view-as alert-box error .
      638         undo, return error return-value .
      639       end.
      640     end.
      641   end procedure.
      642   procedure factord-lock-shift :
      643     define input  parameter p-obj-type  as character no-undo .
      644     define input  parameter p-obj-code  as integer   no-undo .
      645     define input  parameter p-fact-date as date      no-undo .
      646     define parameter buffer buf_shift-obj for ub.shift-obj .
      647     define variable v-shift-on      as logical   no-undo .
      648     define variable v-extra-message as character no-undo .
      649     define variable v-error as character no-undo .
      650     do
      651     on error undo, return error return-value
      652     :
      653   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      654   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      655     (input  p-obj-type
      656     ,input  p-obj-code
      657     ,input  'shift-on=request'
      658     ,output v-shift-on
      659     ) no-error .
      660       if error-status :error
      661       then do:
      662         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      663         undo, return error v-error .
      664       end.
      665       if v-shift-on = true
      666       then do:
      667         find first buf_shift-obj share-lock
      668           where buf_shift-obj.obj-type   = p-obj-type
      669             and buf_shift-obj.obj-code   = p-obj-code
      670             and buf_shift-obj.shift-date > p-fact-date
      671           use-index pi
      672           no-error .
      673         if not available buf_shift-obj
      674         or buf_shift-obj.status_ <> 'зкр':U
      675         then do:
      676           find last buf_shift-obj
      677             where buf_shift-obj.obj-type = p-obj-type
      678               and buf_shift-obj.obj-code = p-obj-code
      679               and buf_shift-obj.status_  = 'зкр':U
      680             use-index stts
      681             no-error .
      682           if available buf_shift-obj
      683           then do:
      684             assign
      685               v-extra-message =
      686                     substitute("Дата начала последеней закрытой смены на объекте &1"
      687                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      688                               )
      689             .
      690           end.
      691           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      692           undo, return error v-error .
      693         end.
      694       end.
      695     end.
      696   end procedure.
      697   procedure factord-end-day :
      698     define input  parameter p-fact-date            as date    no-undo .
      699     define output parameter p-day-end-fact-order   as decimal no-undo .
      700     do
      701     on error undo, return error return-value
      702     :
      703       if p-fact-date = ?
      704       then do:
      705         return error "Не указана фактическая дата" .
      706       end.
      707       assign
      708         p-day-end-fact-order = integer(p-fact-date) + 0.99
      709       .
      710     end.
      711   end procedure.
      712   procedure factord-to-date :
      713     define input  parameter p-fact-order as decimal no-undo .
      714     define output parameter p-fact-date  as date    no-undo .
      715     define variable v-ref-date  as date      no-undo .
      716     define variable v-ref-delta as integer   no-undo .
      717     do
      718     on error undo, return error return-value
      719     :
      720       if p-fact-order = ?
      721       or p-fact-order = 0
      722       then do:
      723         return error "Не указан fact-order" .
      724       end.
      725       assign
      726         v-ref-date  = date(1, 1, 2000)
      727       .
      728       assign
      729         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      730       .
      731       assign
      732         p-fact-date = v-ref-date + v-ref-delta
      733       .
      734     end.
      735   end procedure.
      736   procedure factord-to-fact-num :
      737     define input  parameter p-fact-order as decimal no-undo .
      738     define output parameter p-fact-num   as integer no-undo .
      739     define variable v-fact-order-trunc as decimal no-undo .
      740     do
      741     on error undo, return error return-value
      742     :
      743       if p-fact-order = ?
      744       or p-fact-order = 0
      745       then do:
      746         return error "Не указан fact-order" .
      747       end.
      748       assign
      749        v-fact-order-trunc = truncate(p-fact-order, 2)
      750       .
      751       assign
      752         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      753       .
      754     end.
      755   end procedure.
      756   procedure factord-to-shift-num :
      757     define input  parameter p-fact-order as decimal no-undo .
      758     define output parameter p-shift-num   as integer no-undo .
      759     define variable  p-shift-numd  as decimal   no-undo .
      760     define variable v-fact-order-trunc as decimal no-undo .
      761     do
      762     on error undo, return error return-value
      763     :
      764       if p-fact-order = ?
      765       or p-fact-order = 0
      766       then do:
      767         return error "Не указан fact-order" .
      768       end.
      769       assign
      770        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      771       .
      772       if v-fact-order-trunc < 0.5 then do:
      773         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      774       end.
      775       assign
      776         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      777         .
      778        assign
      779         p-shift-num = truncate (p-shift-numd , 0)
      780       .
      781     end.
      782   end procedure.
      783   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      784   procedure cur-time :
      785      define output parameter p-today as date      no-undo .
      786      define output parameter p-time  as integer   no-undo .
      787     do
      788     on error undo, return error
      789     :
      790       define variable v-date1 as date      no-undo .
      791       define variable v-date2 as date      no-undo .
      792       define variable v-time  as integer   no-undo .
      793       assign
      794         v-date1 = today
      795         v-time  = time
      796         v-date2 = today
      797       .
      798       if v-date1 <> v-date2
      799       then do:
      800         assign
      801           v-date1 = today
      802           v-time  = v-time
      803         .
      804       end.
      805       assign
      806         p-today = v-date1
      807         p-time  = v-time
      808       .
      809     end.
      810   end.
      811   function cur-time-date returns character
      812   :
      813     return string(today, '99/99/9999':U) .
      814   end.
      815   function cur-time-mjd returns decimal
      816   :
      817     define variable v-date as date      no-undo .
      818     define variable v-time as integer   no-undo .
      819     run cur-time in this-procedure
      820       (output v-date
      821       ,output v-time
      822       ) .
      823     return integer(v-date) - 2400002 + (v-time / 86400) .
      824   end.
      825   function cur-time-get-ending-index returns integer
      826   (input p-number as integer
      827   )
      828   :
      829     if p-number < 0
      830     or p-number = ?
      831     then do:
      832       return 1 .
      833     end.
      834     define variable v-rest as integer   no-undo .
      835     assign
      836       p-number = p-number modulo 100
      837     .
      838     if p-number < 20
      839     then do:
      840       assign
      841         v-rest = p-number
      842       .
      843     end.
      844     else do:
      845       assign
      846         v-rest = p-number modulo 10
      847       .
      848     end.
      849     case v-rest :
      850       when 1
      851       then do:
      852         return 2 .
      853       end.
      854       when 2 or
      855       when 3 or
      856       when 4
      857       then do:
      858         return 3 .
      859       end.
      860       otherwise do:
      861         return 1 .
      862       end.
      863     end case .
      864   end.
      865   procedure cur-time-mjd-to-date :
      866      define input  parameter i-mjd-diff as decimal no-undo.
      867      define output parameter o-Date     as date    no-undo.
      868      define output parameter o-Time     as integer no-undo.
      869      define variable v-day-number as integer   no-undo .
      870      if    i-mjd-diff < 0
      871         or i-mjd-diff = ?
      872      then do:
      873         return "?" .
      874      end.
      875      assign
      876         v-day-number = truncate(i-mjd-diff,0).
      877         o-Date = date(v-day-number + 2400002).
      878         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      879     .
      880   end.
      881   function cur-time-mjd-to-string returns character
      882   (input p-mjd-diff as decimal
      883   )
      884   :
      885     define variable v-day-number as integer   no-undo .
      886     define variable v-seconds    as integer   no-undo .
      887     define variable v-hour       as integer   no-undo .
      888     define variable v-min        as integer   no-undo .
      889     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      890     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      891     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      892     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      893     if p-mjd-diff < 0
      894     or p-mjd-diff = ?
      895     then do:
      896       return "?" .
      897     end.
      898     assign
      899       v-day-number = integer(truncate(p-mjd-diff,0))
      900       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      901     .
      902     if v-seconds > 86400
      903     then do:
      904       assign
      905         v-seconds = 86400 - 1
      906       .
      907     end.
      908     if v-seconds < 0
      909     then do:
      910       assign
      911         v-seconds = 0
      912       .
      913     end.
      914     assign
      915       v-hour = truncate(v-seconds / 3600, 0)
      916     .
      917     assign
      918       v-seconds = v-seconds modulo 3600
      919     .
      920     assign
      921       v-min = truncate(v-seconds / 60, 0)
      922     .
      923     assign
      924       v-seconds = v-seconds modulo 60
      925     .
      926     return
      927         (if v-day-number <> 0
      928           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      929           else ""
      930         )
      931       + (if v-day-number <> 0 or v-hour <> 0
      932           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      933           else ""
      934         )
      935       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      936           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      937           else ""
      938         )
      939       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      940       .
      941   end.
      942   function cur-time-string returns character
      943   :
      944     define variable v-date as date      no-undo .
      945     define variable v-time as integer   no-undo .
      946     run cur-time in this-procedure
      947       (output v-date
      948       ,output v-time
      949       ) .
      950     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      951   end.
      952   function cur-time-string-sec returns character
      953   :
      954     define variable v-date as date      no-undo .
      955     define variable v-time as integer   no-undo .
      956     run cur-time in this-procedure
      957       (output v-date
      958       ,output v-time
      959       ) .
      960     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      961   end.
      962   function cur-time-custom  returns character
      963   (input p-prefix as character
      964   ,input p-date-format as character
      965   ,input p-delimiter as character
      966   ,input p-time-format as character
      967   ,input p-suffix as character
      968   )
      969   :
      970     define variable v-date as date      no-undo .
      971     define variable v-time as integer   no-undo .
      972     run cur-time in this-procedure
      973       (output v-date
      974       ,output v-time
      975       ) .
      976     return
      977       p-prefix
      978       + string(v-date, p-date-format)
      979       + p-delimiter
      980       + string(v-time, p-time-format)
      981       + p-suffix
      982       .
      983   end.
      984   function cur-time-print  returns character
      985   :
      986     define variable v-date as date      no-undo .
      987     define variable v-time as integer   no-undo .
      988     run cur-time in this-procedure
      989       (output v-date
      990       ,output v-time
      991       ) .
      992     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      993   end.
      994   function cur-time-datetime returns datetime
      995   :
      996     define variable v-char as character no-undo .
      997     define variable v-datetime as datetime no-undo .
      998     v-char = cur-time-string().
      999     v-datetime = datetime(v-char).
     1000     return  v-datetime.
     1001   end.
     1002   function cur-time-string-msec returns character
     1003   :
     1004     define variable v-date as datetime  no-undo .
     1005     v-date = now.
     1006     return string(v-date) .
     1007   end.
