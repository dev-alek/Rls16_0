     4080   define variable title0 as character no-undo init "Объекты TH".
     4081   case sort-column-name :
     4082     when "" then do:
     4083       assign
     4084         sort-column-phrase = ""
     4085       .
     4086     end.
     4087     otherwise do:
     4088       assign
     4089         sort-column-phrase = "by " + sort-column-name
     4090       .
     4091     end.
     4092   end case.
     4093   filter-point = filter-point0 + v-list-mode .
     4094   case v-list-mode:
     4095     when 'все':U then do:
     4096       ASSIGN
     4097       frame Dialog-Frame:title = substitute("&1", title0)
     4098       filter-label = SUBSTITUTE("&1"
     4099                                 , frame Dialog-Frame:title
     4100                                 )
     4101       .
     4102      end.
     4103      when "db" then do:
     4104       ASSIGN
     4105       frame Dialog-Frame:title = substitute("&1 - БД &2", title0, p-db-num)
     4106       filter-label = SUBSTITUTE("&1"
     4107                                 , frame Dialog-Frame:title
     4108                                 )
     4109       .
     4110      end.
     4111      when 'фирма':U then do:
     4112       ASSIGN
     4113       frame Dialog-Frame:title = substitute("&1 - Фирма &2", title0, p-host-code)
     4114       filter-label = SUBSTITUTE("&1"
     4115                                 , frame Dialog-Frame:title
     4116                                 )
     4117       .
     4118      end.
     4119      when "cli-type" then do:
     4120       ASSIGN
     4121       frame Dialog-Frame:title = substitute("&1 - &2", title0, p-obj-type)
     4122       filter-label = SUBSTITUTE("&1"
     4123                                 , frame Dialog-Frame:title
     4124                                 )
     4125       .
     4126      end.
     4127   end case.
     4128   if f-db-num = ? then do:
     4129     if f-host-code = ? then do:
     4130   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4131   define variable  l-disable-where-33  as logical   no-undo .
