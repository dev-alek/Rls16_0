     1454          MENU-ITEM m_update       LABEL "&Изменение"
     1455          MENU-ITEM m_copy         LABEL "&Копирование"
     1456          RULE
     1457          MENU-ITEM m_price-grp    LABEL "Группа &ценообразования".
     1458   DEFINE MENU MENU-B-cli-attr
     1459          MENU-ITEM m_lookup-cli   LABEL "&Просмотр"
     1460          MENU-ITEM m_update-cli   LABEL "&Изменение"    .
     1461   DEFINE MENU MENU-B-list
