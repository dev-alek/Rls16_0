     4936   PROCEDURE proc-b-add :
     4937   define variable ri as recid no-undo.
     4938   define buffer buf_clients for ub.clients.
     4939   CASE p-obj-type:
     4940     WHEN 'маг':U THEN DO:
     4941     run adm/shopi.w ( input parparentproc
     4942                      ,input v-cntxt-host-code-obj
     4943                      ,input 0
     4944                      ,input 'ДОБАВЛЕНИЕ':U
     4945                      ,input-output ri).
     4946     if ri <> ? then do:
     4947         find buf_clients where
     4948              recid (buf_clients) = ri no-lock.
     4949         ri = recid (buf_clients).
     4950         run enable_UI.
     4951         reposition br-objects to recid ri no-error.
     4952         apply "ENTRY" to br-objects in frame Dialog-Frame .
     4953     end.
     4954     return no-apply.
     4955     END.
     4956     WHEN 'скл':U THEN DO:
     4957         run adm/storei.w ( input parparentproc
     4958                           ,input v-cntxt-host-code-obj
     4959                           ,input 0
     4960                           ,input 'ДОБАВЛЕНИЕ':U
     4961                           ,input-output ri).
     4962         if ri <> ? then do:
     4963             find buf_clients where
     4964                recid (buf_clients) = ri no-lock.
     4965             ri = recid (buf_clients).
     4966             run enable_UI.
     4967             reposition br-objects to recid ri no-error.
     4968             apply "ENTRY" to br-objects.
     4969         end.
     4970         return no-apply.
     4971     END.
     4972   END CASE.
     4973   END PROCEDURE.
     4974   PROCEDURE proc-b-db :
     4975   define variable v-ri as recid no-undo .
     4976   do
     4977     on error undo, return error
     4978     :
     4979     run adm/dbs.w (
     4980                input parparentproc
     4981              , INPUT 'ПРОСМОТР':U
     4982              , output v-ri).
     4983     if v-ri <> ?
     4984     then do:
     4985       find buf_db where recid (buf_db) = v-ri .
     4986       assign
     4987       f-db-num = buf_db.db-num
     4988       f-db-name = buf_db.db-name
     4989       .
     4990       DISPLAY
     4991       f-db-num
     4992       f-db-name
     4993       WITH FRAME Dialog-Frame.
     4994     END.
     4995     ELSE DO:
     4996       ASSIGN
     4997       f-db-num = ?
     4998       f-db-name = ''
     4999       .
     5000       DISPLAY
     5001       f-db-num
     5002       f-db-name
     5003       WITH FRAME Dialog-Frame.
     5004     END.
     5005     RUN Openbr IN THIS-PROCEDURE ( input yes, input no, input '':U).
     5006   end.
     5007   END PROCEDURE.
     5008   PROCEDURE proc-b-del :
     5009   define variable  ri as recid no-undo.
     5010   CASE X_clients.obj-type:
     5011     WHEN 'маг':U THEN DO:
     5012       run ref/clients2.p ( input parparentproc
     5013                           ,input recid(X_clients)
     5014                           ,input ?
     5015                           ,input no
     5016                           ,input yes
     5017                           ,input '':U
     5018                           ,input '':U
     5019                           ,input '':U
     5020                           ) no-error .
     5021     END.
     5022     WHEN 'скл':U THEN DO:
     5023       run ref/clients2.p ( input parparentproc
     5024                           ,input recid(X_clients)
     5025                           ,input ?
     5026                           ,input no
     5027                           ,input yes
     5028                           ,input '':U
     5029                           ,input '':U
     5030                           ,input '':U
     5031                           ) no-error .
     5032     END.
     5033   END CASE.
     5034   if error-status:error then do:
     5035     return no-apply.
     5036   end.
     5037   run Openbr in this-procedure ( input yes, input no, input '':U).
     5038   reposition br-objects to recid ri no-error.
     5039   apply "ENTRY" to br-objects in frame Dialog-Frame .
     5040   apply "value-changed" to br-objects.
     5041   END PROCEDURE.
     5042   PROCEDURE proc-b-host :
     5043   define variable ref-list as char no-undo.
     5044   DEFINE VARIABLE new-host-code AS INTEGE no-undo.
     5045     run adm/sconfs.w (
     5046                    input parParentProc
     5047                   ,input "b-sel":U
     5048                   ,input no
     5049                   ,input v-cntxt-host-code-obj
     5050                   ,output new-host-code
     5051                   ,input-output ref-list ) .
     5052     .
     5053   if new-host-code = ?
     5054   or new-host-code = 0
     5055   then do:
     5056      ASSIGN
     5057      f-host-code = ?
     5058      f-host-name = ''
     5059      .
     5060   END.
     5061   ELSE DO:
     5062     find first buf_sysclients where
     5063               buf_sysclients.obj-type = 'орг':U
     5064           and buf_sysclients.obj-code = new-host-code no-lock.
     5065       ASSIGN
     5066       f-host-code = buf_sysclients.obj-code
     5067       f-host-name = buf_sysclients.obj-name
     5068       .
     5069   END.
     5070   DISPLAY
     5071   f-host-code
     5072   f-host-name
     5073   WITH FRAME Dialog-Frame.
     5074   RUN Openbr IN THIS-PROCEDURE ( input yes, input no, input '':U).
     5075   END PROCEDURE.
     5076   PROCEDURE PROC-B-LIST :
     5077   define input parameter loc-list-option as character no-undo.
     5078   define variable f-name as char init "default.cli" no-undo.
     5079   define variable imp-type like goods.prod-type no-undo.
     5080   define variable imp-code like goods.prod-code no-undo.
     5081   define variable v-ok as logical no-undo .
     5082   define buffer buf_temp-user-obj for temp-user-obj .
     5083   define buffer buf_clients for clients .
     5084   define buffer buf_clob-data for ub.clob-data.
     5085   define buffer buf_clob-bind for ub.clob-bind.
     5086   do
     5087   on error undo, return error return-value
     5088   :
     5089     case loc-list-option:
     5090       when "save":U
     5091       or
     5092       when "save-clob"
     5093       then do:
     5094         case loc-list-option:
     5095           when "save" then do:
     5096             assign
     5097             v-ok = true
     5098             .
     5099             message
     5100             "Сохранить все отмеченные объекты в файле списка" skip
     5101             "Продолжить" skip
     5102             view-as alert-box question buttons OK-Cancel update v-ok .
     5103             if v-ok <> true
     5104             then do:
     5105               assign
     5106               v-list-option = "":U
     5107               .
     5108               return .
     5109             end.
     5110             assign
     5111             f-name = "default.cli"
     5112             v-ok   = true
     5113             .
     5114             system-dialog get-file f-name
     5115             filters "Списки клиентов *.cli" "*.cli"
     5116             ask-overwrite
     5117             save-as
     5118             use-filename
     5119             update v-ok
     5120             default-extension "cli".
     5121             if v-ok <> true
     5122             then do:
     5123               assign
     5124               v-list-option = "":U
     5125               .
     5126               return .
     5127             end.
     5128             output stream sout to value (f-name).
     5129             for each buf_temp-user-obj
     5130             on error undo, return error return-value
     5131             :
     5132               export stream sout
     5133                 buf_temp-user-obj.obj-type
     5134                 buf_temp-user-obj.obj-code
     5135               .
     5136             end.
     5137             output stream sout close.
     5138           end.
     5139           when "save-clob" then do:
     5140             run ref/clobbnds.w ( input parparentproc
     5141                                 ,input this-procedure:handle
     5142                                 ,input 'b-add'
     5143                                 ,input "uniq-key-rec"
     5144                                 ,input 'ИЗМЕНЕНИЕ':U
     5145                                 ,input 'list':U
     5146                                 ,input 'cli-list'
     5147                                 ,input -1
     5148                                 ,input-output v-rid-list) no-error.
     5149           end.
     5150         end case.
     5151       end.
     5152       when "load":U
     5153       or
     5154       when "load-clob"
     5155       then do:
     5156         case loc-list-option:
     5157           when "load" then do:
     5158             assign
     5159             v-ok = yes
     5160             .
     5161             message
     5162             "Отметить все объекты из ранее сохраненного в файле списка" skip
     5163             "Продолжить?" skip
     5164             view-as alert-box question buttons ok-cancel update v-ok .
     5165             if v-ok <> true
     5166             then do:
     5167               assign
     5168               v-list-option = "":U
     5169               .
     5170               return.
     5171             end.
     5172             system-dialog get-file f-name
     5173             filters "Списки клиентов *.cli" "*.cli"
     5174             title "Выберите файл списка?"
     5175             initial-dir "."
     5176             return-to-start-dir
     5177             must-exist
     5178             update v-ok
     5179             default-extension "cli".
     5180             if v-ok <> true
     5181             then do:
     5182               assign
     5183               v-list-option = "":U
     5184               .
     5185               return.
     5186             end.
     5187           end.
     5188           when "load-clob" then do:
     5189             message
     5190             "Отметить все объекты из хранимого списка" skip
     5191             "Продолжить?" skip
     5192             view-as alert-box question buttons ok-cancel update v-ok .
     5193             if v-ok <> true
     5194             then do:
     5195               assign
     5196               v-list-option = "":U
     5197               .
     5198               return.
     5199             end.
     5200             run ref/clobbnds.w ( input parparentproc
     5201                                 ,input this-procedure:handle
     5202                                 ,input 'b-sel'
     5203                                 ,input "uniq-key-rec"
     5204                                 ,input ""
     5205                                 ,input 'list':U
     5206                                 ,input 'cli-list'
     5207                                 ,input -1
     5208                                 ,input-output v-rid-list) no-error.
     5209             if v-rid-list = ''
     5210             then do:
     5211               assign
     5212               v-list-option = "":U
     5213               .
     5214               return.
     5215             end.
     5216             find first buf_clob-bind where
     5217                     recid(buf_clob-bind) = integer(v-rid-list) no-error.
     5218             if not available buf_clob-bind then do:
     5219               message
     5220               "Ошибка при пополучении хранимого файла"
     5221               view-as alert-box error.
     5222               assign
     5223               v-list-option = "":U
     5224               .
     5225               return.
     5226             end.
     5227             else do:
     5228               find first buf_clob-data no-lock where
     5229                         buf_clob-data.db-num = buf_clob-bind.db-num
     5230                     and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     5231               if error-status :error then do:
     5232                 message
     5233                 "Ошибка при пополучении хранимого файла"
     5234                 view-as alert-box error.
     5235                 return error.
     5236               end.
     5237               run gbl/_tmpfile.p ( input ""
     5238                             ,input "tmp"
     5239                             ,output f-name) .
     5240               copy-lob from object buf_clob-data.cdata
     5241               to file f-name.
     5242             end.
     5243           end.
     5244         end case.
     5245         input stream sout from value (f-name).
     5246         repeat
     5247         :
     5248           assign
     5249           imp-type = '':U
     5250           imp-code = 0
     5251           .
     5252           import stream sout imp-type imp-code .
     5253           find first buf_clients no-lock
     5254             where buf_clients.obj-type = imp-type
     5255               and buf_clients.obj-code = imp-code
     5256             no-error .
     5257           if available buf_clients
     5258           and (buf_clients.obj-type = 'маг':U
     5259           or buf_clients.obj-type = 'скл':U)
     5260           then do:
     5261             run userobjs_append in this-procedure
     5262               (input  buf_clients.obj-type
     5263               ,input  buf_clients.obj-code
     5264               ) .
     5265           end.
     5266         end.
     5267         input stream sout close.
     5268         run display-select-num in this-procedure .
     5269         br-objects:refresh() in frame Dialog-Frame .
     5270         apply "entry" to br-objects in frame Dialog-Frame.
     5271       end.
     5272       otherwise do:
     5273       end.
     5274     END CASE.
     5275     loc-list-option = "":U.
     5276   end.
     5277   END PROCEDURE.
     5278   PROCEDURE proc-b-sch :
     5279   define variable v-ri as recid no-undo .
     5280   assign
     5281   v-ri = (if avail X_clients then recid(X_clients) else ?)
     5282   .
     5283   assign
     5284   tbl = 'clients':U
     5285   join-tbl = 'X_clients'
     5286   fld = ""
     5287   lab = ""
     5288   spr = ""
     5289   dim = '0'
     5290   .
     5291   run fltfield-add in this-procedure('obj-type', 'Тип клиента', '',
     5292   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5293   run fltfield-add in this-procedure('obj-code', 'Код клиента', '',
     5294   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5295   run fltfield-add in this-procedure('obj-name', 'Названиеклиента', '',
     5296   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5297   run fltfield-add in this-procedure('db-num', 'БД', 'db',
     5298   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5299   run fltfield-add in this-procedure('host-code', 'Код фирмы', 'db',
     5300   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5301   DO on stop undo, leave:
     5302       run gbl/filter.w ( INPUT parparentproc
     5303                    ,INPUT filter-point + chr(4) + filter-label
     5304                    ,INPUT tbl
     5305                    ,INPUT join-tbl
     5306                    ,INPUT fld
     5307                    ,INput lab
     5308                    ,INPUT spr
     5309                    ,INPUT  dim).
     5310       run OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
     5311       if v-ri <> ? then do:
     5312         reposition br-objects to recid v-ri no-error.
     5313       end.
     5314       APPLY "ENTRY" to br-objects in frame Dialog-Frame .
     5315       APPLY "VALUE-CHANGED" to br-objects.
     5316   end.
     5317   END PROCEDURE.
     5318   PROCEDURE proc-find-code :
     5319   define input parameter p-next as logical no-undo.
     5320   define input parameter p-code AS INTEGER no-undo.
     5321   DEFINE VARIABLE v-code AS CHARACTER NO-UNDO.
     5322   assign
     5323   v-code = string(p-code).
     5324   if rs-cli-type = 'все':U then do:
     5325     run OpenBr in this-procedure
     5326         (input false
     5327         ,input p-next
     5328         ,input substitute(" and X_clients.obj-code = &1 "
     5329           , v-code
     5330           , chr(34)
     5331           , rs-cli-type
     5332           )
     5333         ).
     5334   end.
     5335   else do:
     5336     run OpenBr in this-procedure
     5337         (input false
     5338         ,input p-next
     5339         ,input substitute(" and X_clients.obj-code = &1 and X_clients.obj-type = &2&3&2"
     5340           , v-code
     5341           , chr(34)
     5342           , rs-cli-type
     5343           )
     5344         ).
     5345   end.
     5346   apply "entry":u to sch-code in frame Dialog-Frame .
     5347   END PROCEDURE.
     5348   FUNCTION get-host-name RETURNS CHARACTER
     5349     ( INPUT p-host-code AS INTEGER ) :
     5350   DEFINE BUFFER buf_sysclients FOR ub.clients.
     5351   FIND FIRST buf_sysclients NO-LOCK WHERE
     5352               buf_sysclients.obj-type = 'орг':U
     5353        AND buf_sysclients.obj-code  = p-host-code NO-ERROR.
     5354   IF AVAILABLE buf_sysclients THEN RETURN buf_sysclients.obj-name.
     5355   RETURN "!!!Неизвестная фирма".
     5356   END FUNCTION.
     5357   FUNCTION get-shift-on RETURNS LOGICAL
     5358     ( INPUT p-obj-type AS CHARACTER, INPUT p-obj-code AS INTEGER ) :
     5359   DEFINE VARIABLE l-shift-on AS LOGICAL NO-UNDO.
     5360   l-shift-on = no.
     5361   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5362   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     5363     (input  p-obj-type
     5364     ,input  p-obj-code
     5365     ,input  'shift-on=request'
     5366     ,output l-shift-on
     5367     ) no-error .
     5368   RETURN l-shift-on.
     5369   END FUNCTION.
     5370   FUNCTION mark-string RETURNS CHARACTER
     5371   ( input p-recid as recid, input mark-list as character  ) :
     5372   define variable v-mark-string as character no-undo .
     5373   if v-new-selection-flag then do:
     5374       run get-mark-string in this-procedure
     5375         (input  X_clients.obj-type
     5376         ,input  X_clients.obj-code
     5377         ,output v-mark-string
     5378         ) .
     5379       return v-mark-string .
     5380   END.
     5381   ELSE DO:
     5382     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     5383   END.
     5384   END FUNCTION.
