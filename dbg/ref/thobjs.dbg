      506   :
      507       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_value in g#attr-lib
      508       (input  p-obj-type
      509       ,input  p-obj-code
      510       ,input  p-upper-code
      511       ,input  p-code
      512       ,output p-value-character
      513       ,output p-value-date
      514       ,output p-value-decimal
      515       ,output p-value-integer
      516       ,output p-value-logical
      517       ,output p-type
      518       ,output p-found
      519       ) no-error .
      520     if error-status :error
      521     then do:
      522       undo, return error return-value .
      523     end.
      524   end.
      525   end procedure.
