      376   procedure thbjattr_code :
      377      define input  parameter p-upper-code     as character no-undo .
      378      define input  parameter p-code           as character no-undo .
      379      define output parameter p-label          as character no-undo .
      380      define output parameter p-user-can-edit  as logical   no-undo .
      381      define output parameter p-output-display as logical   no-undo .
      382      define output parameter p-other          as character no-undo .
      383      define output parameter p-prop-list      as character no-undo .
      384      define output parameter p-prop-type-list as character no-undo .
      385      define output parameter p-prop-label-list as character no-undo .
      386      define output parameter p-global          as logical no-undo .
      387      define output parameter p-host           as logical no-undo .
      388      define output parameter p-shop           as logical no-undo .
      389      define output parameter p-store          as logical no-undo .
      390      define output parameter p-db             as logical no-undo .
      391      define variable p-region as logical no-undo.
      392      run thbjattr_code_reg in this-procedure (
      393                                               p-upper-code,
      394                                               p-code,
      395                                               output p-label,
      396                                               output p-user-can-edit,
      397                                               output p-output-display,
      398                                               output p-other,
      399                                               output p-prop-list,
      400                                               output p-prop-type-list,
      401                                               output p-prop-label-list,
      402                                               output p-global,
      403                                               output p-host,
      404                                               output p-shop,
      405                                               output p-store,
      406                                               output p-db,
      407                                               output p-region
