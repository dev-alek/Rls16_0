      410   procedure thbjattr_code_reg :
      411   define input  parameter p-upper-code     as character no-undo .
      412   define input  parameter p-code           as character no-undo .
      413   define output parameter p-label          as character no-undo .
      414   define output parameter p-user-can-edit  as logical   no-undo .
      415   define output parameter p-output-display as logical   no-undo .
      416   define output parameter p-other          as character no-undo .
      417   define output parameter p-prop-list      as character no-undo .
      418   define output parameter p-prop-type-list as character no-undo .
      419   define output parameter p-prop-label-list as character no-undo .
      420   define output parameter p-global          as logical no-undo .
      421   define output parameter p-host           as logical no-undo .
      422   define output parameter p-shop           as logical no-undo .
      423   define output parameter p-store          as logical no-undo .
      424   define output parameter p-db             as logical no-undo .
      425   define output parameter p-region         as logical no-undo .
      426   do
      427   on error undo, return error return-value
      428   :
      429       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      430       (input  p-upper-code
      431       ,input  p-code
      432       ,output p-label
      433       ,output p-user-can-edit
      434       ,output p-output-display
      435       ,output p-other
      436       ,output p-prop-list
      437       ,output p-prop-type-list
      438       ,output p-prop-label-list
      439       ,output p-global
      440       ,output p-host
      441       ,output p-shop
      442       ,output p-store
      443       ,output p-db
      444       ,output p-region
      445       ) no-error .
      446     if error-status :error
      447     then do:
      448       undo, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message (1)).
      449     end.
      450   end.
      451   end procedure.
