     2688     define variable v-change-sign          as integer   no-undo .
     2689     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2690     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2691     if p-change-value > 0
     2692     then do:
     2693       if frame Dialog-Frame :width + p-change-value >
     2694           session :width-chars
     2695       then do:
     2696         assign
     2697           p-change-value = session :width-chars - frame Dialog-Frame :width
     2698         .
     2699         if p-change-value <= 0
     2700         then do:
     2701           run diasize_position-resize-button in this-procedure .
     2702           return .
     2703         end.
     2704       end.
     2705     end.
     2706     if p-change-value < 0
     2707     then do:
     2708       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2709       then do:
     2710         assign
     2711           p-change-value = v-diasize-orig-frame-width
     2712                          - frame Dialog-Frame :width
     2713         .
     2714         if p-change-value >= 0
     2715         then do:
     2716           run diasize_position-resize-button in this-procedure .
     2717           return .
     2718         end.
     2719       end.
     2720     end.
     2721     if p-change-value >= 0
     2722     then do:
     2723       assign
     2724         v-change-sign = 1
     2725       .
     2726     end.
     2727     else do:
     2728       assign
     2729         v-change-sign = -1
     2730       .
     2731     end.
     2732     assign
     2733       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2734     .
     2735     if p-change-value = 0
     2736     then do:
     2737       run diasize_position-resize-button in this-procedure .
     2738       return .
     2739     end.
