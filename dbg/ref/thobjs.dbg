     4147     ,output sort-phrase-33
     4148     ,output where-phrase-rus-33
     4149     ,output sort-phrase-rus-33
     4150     ).
     4151   if p-open-query then do:
     4152       run set-filter-name in this-procedure
     4153         (INPUT filter-name-33
     4154         ) no-error .
     4155     assign
     4156       l-filter-open-33 = false
     4157     .
     4158     if flt-rec-33 <> ?
     4159       or sort-column-phrase > ""
     4160     then do:
     4161       define variable  parameter-2-33 as character no-undo .
     4162       define variable  parameter-3-33 as character no-undo .
     4163       define variable  parameter-4-33 as character no-undo .
     4164       define variable  parameter-5-33 as character no-undo .
     4165       define variable  parameter-6-33 as character no-undo .
     4166       define variable  parameter-7-33 as character no-undo .
     4167         assign
     4168         parameter-3-33 =
     4169                                 "FOR EACH X_clients no-lock"
     4170         parameter-4-33 =
     4171           (
     4172             if ("((rs-cli-type = 'все':U and (X_clients.obj-type = 'маг':U or X_clients.obj-type = 'скл':U) )                     OR X_clients.obj-type = rs-cli-type) " + " " + where-phrase-33) <> ""
     4173             then  substitute(' ((&7&1&7 = &7&4&7 and (X_clients.obj-type = &7&5&7 or X_clients.obj-type = &7&6&7) )                     OR X_clients.obj-type = &7&1&7)'                   , rs-cli-type , f-db-num, f-host-code, 'все':U, 'маг':U, 'скл':U, chr(34))  + " " + where-phrase-33
     4174             else "true"
     4175           )
     4176         parameter-5-33 = (" " + "" + " " + "")
     4177         parameter-6-33 = if sort-phrase-33 = ''
