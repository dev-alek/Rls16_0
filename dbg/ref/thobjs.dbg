      662   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      663   procedure proc-b-attr :
      664   define input parameter p-mode as character no-undo .
      665   define input parameter p-obj-type like ub.clients.obj-type no-undo .
      666   define input parameter p-obj-code like ub.clients.obj-code no-undo .
      667   define variable v-sts as integer no-undo .
      668   define variable vattr-codes as character no-undo .
      669   define variable vattr-labels as character no-undo .
      670   define variable ii as integer no-undo .
      671   define variable v-attr-code like ub.clients-attr.attr-code no-undo .
      672   define variable attr-label as character no-undo .
      673   define variable attr-user-can-edit as logical no-undo .
      674   define variable attr-output-display as logical no-undo .
      675   define variable attr-other as char no-undo .
      676   define variable v-prop-list as character no-undo .
      677   define variable v-prop-type-list as character no-undo .
      678   define variable v-prop-label-list as character no-undo .
      679   define variable v-global as logical no-undo .
      680   define variable v-host as logical no-undo .
      681   define variable v-shop as logical no-undo .
      682   define variable v-store as logical no-undo .
      683   define variable v-db as logical   no-undo .
      684   define variable attr-value as char no-undo .
      685   define variable v-spr as character no-undo .
      686   define variable v-title as character no-undo .
      687   define variable v-ii as integer no-undo .
      688   define variable v-ok as integer no-undo .
      689   define variable v-rid-list as character no-undo .
      690   define variable v-rec as recid no-undo .
      691   define variable conf-par as character no-undo .
      692   define variable par-type as character no-undo .
      693   define variable v-firm-code as integer   no-undo .
      694   define variable v-from-obj-code  as integer no-undo .
      695   define variable v-found as decimal no-undo .
      696   define buffer buf_clients for ub.clients.
      697   define buffer buf_sysconf for ub.sysconf.
      698   define buffer buf_shop for ub.shop.
      699   define buffer buf_store for ub.store.
      700   define buffer buf_db for ub.db.
      701   do
      702   on error undo, return error
      703   :
      704   assign
      705   vattr-codes = "":U
      706   vattr-labels = "":U
      707   .
      708   _II:
      709   DO ii = 1 to num-entries('autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U):
      710     run thbjattr_code (
      711                          input entry(ii, 'autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U)
      712                         ,input   '':U
      713                         ,output  attr-label
      714                         ,output  attr-user-can-edit
      715                         ,output  attr-output-display
      716                         ,output  attr-other
      717                         ,output v-prop-list
      718                         ,output v-prop-type-list
      719                         ,output v-prop-label-list
      720                         ,output v-global
      721                         ,output v-host
      722                         ,output v-shop
      723                         ,output v-store
      724                         ,output v-db
      725                       ) no-error.
      726       .
      727       if NOT error-status:error
      728       and attr-user-can-edit
      729       and index(attr-other, "spr-ext=") > 0
      730       anD (if p-obj-type = 'маг':U
      731            then v-shop
      732            else (if p-obj-type = 'скл':U
      733                  then v-store
      734                  else (if p-obj-type = 'орг':U
      735                        then v-host
      736                        else (if p-obj-type = 'БД':U
      737                             then v-db
      738                             else v-global)
      739                       )
      740                  )
      741            ) then do:
      742         if entry(ii, 'autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U) = 'alias-tpsi':U then do:
      743   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      744     (input  'tpsi'
      745     ,input  0
      746     ,input  ''
      747     ,input  0
      748     ,input  ''
      749     ,input  ''
      750     ,input  ''
      751     ,input  no
      752     ,output conf-par
      753     ,output par-type
      754     ) no-error .
      755           if error-status:error
      756           or (conf-par <> "yes") then next _ii.
      757         end.
      758         assign
      759         vattr-codes = vattr-codes + chr(44) + entry(ii, 'autosale,get-chk,chk-view,cd-sending,cd-inf-send,scale-inf,cd-type-ibm,cd-type-ipc-servispl,cd-type-NCR-GM,cd-type-NCR-AS-R,cd-type-magia-xml,cd-type-omron,cd-type-omron-new,cd-type-IBM-XML,cd-type-IBS-TH,cd-type-IBS-TH-MOB,alias-tpsi,cd-type-r-keeper,cd-type-autotank,cd-type-maria,arh-global,nakl_par,contr-in,rt-trn-doc,overval,inv-obj,rezerv-obj,ord-obj,abc-sale-day,Ass-obj,fin-global,fin-plan,,gds-ref,gds-ref_obj,dc-ref,cli-all,cashpays,wthdoc,wthdoc_obj,attr-wthrep,rum,rum_obj,easyfuel,images,prt-glob,report-glob,report-obj,code-range,bge-export,auto-task,wnd-size,obj-date,fbrattr,petrol,staff,srv-auth-ASU,egais,mercur,gisMT,marking':U)
      760         vattr-labels = vattr-labels + chr(44) + attr-label
      761         .
      762       end.
      763   end.
      764   CASE p-mode:
      765     when 'ПРОСМОТР':U then do:
      766       assign
      767       v-title = "Выберите типы параметров для просмотра".
      768     end.
      769     when 'ИЗМЕНЕНИЕ':U then do:
      770       assign
      771       v-title = "Выберите типы параметров для редактирования".
      772     end.
      773     when  'КОПИРОВАНИЕ':U then do:
      774       assign
      775       v-title = "Выберите типы параметров для копирования".
      776     end.
      777   END CASE.
      778   run gbl/d-list.w (
      779                  INPUT (if p-mode = 'КОПИРОВАНИЕ':U then "b-sel,b-mark":U else "b-sel":U)
      780                 ,INPUT v-title
      781                 ,INPUT vattr-codes
      782                 ,INPUT vattr-labels
      783                 ,INPUT chr(44)
      784                 ,INPUT "":U
      785                 ,output v-attr-code).
      786   IF v-attr-code = "":u THEN do:
      787     RETURN ''.
      788   end.
      789   if p-mode = 'ПРОСМОТР':U
      790   or p-mode = 'ИЗМЕНЕНИЕ':U then do:
      791     run thbjattr_code  in this-procedure (
      792          input   v-attr-code
      793         ,input   '':U
      794         ,output  attr-label
      795         ,output  attr-user-can-edit
      796         ,output  attr-output-display
      797         ,output  attr-other
      798         ,output v-prop-list
      799         ,output v-prop-type-list
      800         ,output v-prop-label-list
      801         ,output v-global
      802         ,output v-host
      803         ,output v-shop
      804         ,output v-store
      805         ,output v-db
      806     ).
      807     do ii = 1 to num-entries(attr-other, chr(47)):
      808       if entry(ii, attr-other, chr(47)) begins "spr-ext=":U then do:
      809         assign
      810         v-spr = entry(2, entry(ii, attr-other, chr(47)), "=").
      811       end.
      812     end.
      813     run value(v-spr) (
      814                      input parparentproc
      815                     ,input p-mode
      816                     ,input p-obj-type
      817                     ,input p-obj-code
      818                     ).
      819   end.
      820   else do:
      821      if p-obj-type = 'маг':U then do:
      822       message
      823       "Выберите магазин для копирования ПАРАМЕТРОВ"
      824       view-as alert-box WARNING.
      825         run adm/shops.w ( input parparentproc
      826                          ,input "b-sel"
      827                          ,input-output v-rid-list
      828                          ,no ).
      829        if v-rid-list = "":U then return.
      830        find first buf_shop no-lock where
      831                 recid(buf_shop) = integer(v-rid-list) .
      832        v-from-obj-code = buf_shop.obj-code.
      833      end.
      834      if p-obj-type = 'орг':U then do:
      835         message
      836         "Выберите ФИРМУ для копирования ПАРАМЕТРОВ"
      837         view-as alert-box WARNING.
      838         run adm/sconfs.w (
      839               input parParentProc
      840             , input "b-sel":U
      841             , input no
      842             , input 0
      843             , output v-firm-code
      844             , input-output v-rid-list
      845         ) no-error.
      846         if v-rid-list = "":U then return.
      847       find first buf_sysconf no-lock
      848                         where recid(buf_sysconf) = integer(entry(1, v-rid-list)).
      849       v-from-obj-code = buf_sysconf.host-code.
      850      end.
      851      if p-obj-type = 'скл':U then do:
      852       message
      853       "Выберите склад для копирования ПАРАМЕТРОВ"
      854       view-as alert-box WARNING.
      855         run adm/stores.w ( input parparentproc
      856                           ,input "b-sel"
      857                           ,input-output v-rid-list
      858                           ,input no ).
      859        if v-rid-list = "":U then return.
      860        find first buf_store no-lock where
      861                 recid(buf_store) = integer(v-rid-list) .
      862        v-from-obj-code = buf_store.obj-code.
      863      end.
      864      if p-obj-type = 'БД':U then do:
      865         message
      866         "Выберите БД для копирования ПАРАМЕТРОВ"
      867         view-as alert-box WARNING.
      868         run adm/dbs.w (
      869               input parParentProc
      870             , input 'ПРОСМОТР':U
      871             , output v-rec
      872         ) no-error.
      873         if v-rec = ? then return.
      874       find first buf_db no-lock
      875                         where recid(buf_db) = v-rec.
      876       v-from-obj-code = buf_db.db-num.
      877      end.
      878      if (p-obj-type = 'маг':U
      879      AND p-obj-code = buf_shop.obj-code )
      880      or (p-obj-type = 'скл':U
      881      AND p-obj-code = buf_store.obj-code )
      882      or (p-obj-type = 'орг':U
      883      AND p-obj-code = buf_sysconf.host-code )
      884      or (p-obj-type = 'БД':U
      885      AND p-obj-code = buf_db.db-num )
      886      or (p-obj-type = '':U
      887      AND p-obj-code = 0 )
      888      then do:
      889        message "Нельзя копировать ПАРАМЕТРЫ самих в себя"
      890        view-as alert-box error .
      891        return error .
      892      end.
      893      run waitfram-show in this-procedure ( input "Ждите..." ).
      894      DO ii = 1 to num-entries(v-attr-code):
      895         for each thbjattr_thbj-attr:
      896           delete thbjattr_thbj-attr.
      897         end.
      898         assign
      899         v-ii = v-ii + 1.
      900         run thbjattr_get-section  in this-procedure (
      901              input  p-obj-type
      902             ,input  v-from-obj-code
      903             ,input  entry(ii, v-attr-code)
      904             ,input '':U
      905             ,input-output table thbjattr_thbj-attr
      906             ,output v-found
      907                                                 ) no-error .
      908         if not error-status:error then do:
      909           run thbjattr_set-section in this-procedure (
      910                                                  input p-obj-type
      911                                                 ,input p-obj-code
      912                                                 ,input entry(ii, v-attr-code)
      913                                                 ,input table thbjattr_thbj-attr ) no-error .
      914           if not error-status:error then
      915           assign
      916           v-ok = v-ok + 1
      917           .
      918         end.
      919      end.
      920      run waitfram-hide in this-procedure .
      921      if v-ii = v-ok then do:
      922         message
      923         substitute("Скопировано &1 параметров с &4&5 на &2&3"
      924                    , v-ok
      925                    , p-obj-type
      926                    , p-obj-code
      927                    , p-obj-type
      928                    , v-from-obj-code
      929                    )
      930         view-as alert-box .
      931      end.
      932      else do:
      933         message
      934         substitute("Из &1 параметров удалось скопировать &2 параметров с &3&4 на &5&6"
      935                    , v-ii
      936                    , v-ok
      937                    , p-obj-type
      938                    , p-obj-code
      939                    , p-obj-type
      940                    , v-from-obj-code
      941                    )
      942         view-as alert-box WARNING.
      943      end.
      944   end.
      945   end.
      946   end procedure.
      947   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      948     define variable v-cntxt-db-num        as integer   no-undo .
      949     define variable v-cntxt-userid        as character no-undo .
      950     define variable v-cntxt-level         as character no-undo .
      951     define variable v-cntxt-host-code-obj as integer   no-undo .
      952     define variable v-cntxt-obj-type      as character no-undo .
      953     define variable v-cntxt-obj-code      as integer   no-undo .
      954     define variable v-cntxt-db-num-obj    as integer   no-undo .
      955     define variable v-cntxt-is-admin      as logical   no-undo .
      956   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      957   define temp-table x_obj-group no-undo like ub.clients  .
      958   define temp-table x_grp-obj-price no-undo like ub.grp-obj-price .
      959   procedure metod-gop-obj :
      960     do
      961     on error undo, return error return-value
      962     :
      963   define input  parameter p-cntxt-db-num as integer   no-undo .
      964   define input  parameter p-gop-id       as integer   no-undo .
      965   define input  parameter p-gop-db-num   as integer   no-undo .
      966   define buffer buf1_clients for ub.clients  .
      967   define buffer buf_db-grp-obj-price   for ub.db-grp-obj-price  .
      968   define buffer buf_host-grp-obj-price for ub.host-grp-obj-price  .
      969   define buffer buf_obj-grp-obj-price  for ub.obj-grp-obj-price  .
      970   for each  x_obj-group : delete x_obj-group. end.
      971   if p-gop-id = 0 or p-gop-id = ?  then do:
      972      if p-cntxt-db-num = 0  then do:
      973           for each buf1_clients no-lock where
      974                   (buf1_clients.obj-type = 'маг':U  or
      975                    buf1_clients.obj-type = 'скл':U  )
      976                   and
      977                   buf1_clients.db-num >= 0  and
      978                   buf1_clients.stts = 0
      979                   :
      980             create x_obj-group .
      981             assign
      982               x_obj-group.obj-code   = buf1_clients.obj-code
      983               x_obj-group.obj-type   = buf1_clients.obj-type
      984               x_obj-group.obj-name   = buf1_clients.obj-name
      985               x_obj-group.db-num     = buf1_clients.db-num
      986             .
      987           end.
      988      end.
      989      else do:
      990           for each buf1_clients no-lock where
      991                   (buf1_clients.obj-type = 'маг':U  or
      992                    buf1_clients.obj-type = 'скл':U  ) and
      993                    buf1_clients.db-num = p-cntxt-db-num  and
      994                    buf1_clients.stts = 0
      995                   :
      996             create x_obj-group .
      997             assign
      998               x_obj-group.obj-code   = buf1_clients.obj-code
      999               x_obj-group.obj-type   = buf1_clients.obj-type
     1000               x_obj-group.obj-name   = buf1_clients.obj-name
     1001               x_obj-group.db-num     = buf1_clients.db-num
     1002             .
     1003           end.
     1004      end.
     1005   end.
     1006   else do:
     1007         for each buf_db-grp-obj-price  where
     1008                 buf_db-grp-obj-price.gop-id     = p-gop-id and
     1009                 buf_db-grp-obj-price.gop-db-num = p-gop-db-num and
     1010                 buf_db-grp-obj-price.stts = 0  no-lock :
     1011           for each buf1_clients no-lock where
     1012                  (buf1_clients.obj-type = 'маг':U  or
     1013                   buf1_clients.obj-type = 'скл':U  ) and
     1014                   buf1_clients.db-num = buf_db-grp-obj-price.dgo-db-num  and
     1015                   buf1_clients.stts = 0
     1016                   :
     1017             create x_obj-group .
     1018             assign
     1019               x_obj-group.obj-code   = buf1_clients.obj-code
     1020               x_obj-group.obj-type   = buf1_clients.obj-type
     1021               x_obj-group.obj-name   = buf1_clients.obj-name
     1022               x_obj-group.db-num     = buf1_clients.db-num
     1023             .
     1024           end.
     1025         end.
     1026       for each buf_host-grp-obj-price where
     1027               buf_host-grp-obj-price.gop-id     = p-gop-id and
     1028               buf_host-grp-obj-price.gop-db-num = p-gop-db-num and
     1029               buf_host-grp-obj-price.stts = 0
     1030               no-lock :
     1031         for each buf1_clients no-lock where
     1032                (buf1_clients.obj-type = 'маг':U  or
     1033                 buf1_clients.obj-type = 'скл':U  ) and
     1034                 buf1_clients.host-code = buf_host-grp-obj-price.host-code and
     1035                 buf1_clients.stts = 0
     1036                 :
     1037             find first x_obj-group no-lock  where
     1038                       x_obj-group.obj-code   = buf1_clients.obj-code and
     1039                       x_obj-group.obj-type   = buf1_clients.obj-type no-error .
     1040             if not available  x_obj-group then   create x_obj-group .
     1041             assign
     1042               x_obj-group.obj-code   = buf1_clients.obj-code
     1043               x_obj-group.obj-type   = buf1_clients.obj-type
     1044               x_obj-group.obj-name   = buf1_clients.obj-name
     1045               x_obj-group.db-num     = buf1_clients.db-num
     1046             .
     1047         end.
     1048       end.
     1049       for each buf_obj-grp-obj-price where
     1050               buf_obj-grp-obj-price.gop-id     = p-gop-id and
     1051               buf_obj-grp-obj-price.gop-db-num = p-gop-db-num and
     1052               buf_obj-grp-obj-price.stts = 0
     1053               no-lock :
     1054         for each buf1_clients no-lock where
     1055                   buf1_clients.obj-type = buf_obj-grp-obj-price.obj-type and
     1056                   buf1_clients.obj-code = buf_obj-grp-obj-price.obj-code and
     1057                   buf1_clients.stts     = 0
     1058                   :
     1059             find first  x_obj-group no-lock  where
     1060                         x_obj-group.obj-code   = buf1_clients.obj-code and
     1061                         x_obj-group.obj-type   = buf1_clients.obj-type no-error .
     1062             if not available  x_obj-group then   create x_obj-group .
     1063             assign
     1064               x_obj-group.obj-code   = buf1_clients.obj-code
     1065               x_obj-group.obj-type   = buf1_clients.obj-type
     1066               x_obj-group.obj-name   = buf1_clients.obj-name
     1067               x_obj-group.db-num     = buf1_clients.db-num
     1068             .
     1069         end.
     1070       end.
     1071   end.
     1072   end.
     1073   end procedure.
     1074   procedure metod-obj-in-gop :
     1075   define input  parameter p-curr-db-num as integer   no-undo .
     1076   define input  parameter p-obj-type as character no-undo .
     1077   define input  parameter p-obj-code as integer   no-undo .
     1078   define buffer buf_grp-obj-price for ub.grp-obj-price  .
     1079     do
     1080     on error undo, return error return-value
     1081     :
     1082       empty temp-table x_grp-obj-price.
     1083       for each buf_grp-obj-price where
     1084                buf_grp-obj-price.stts = 0
     1085                no-lock :
     1086                  run metod-gop-obj (p-curr-db-num , buf_grp-obj-price.gop-id ,buf_grp-obj-price.gop-db-num) .
     1087                  for each x_obj-group where
     1088                           x_obj-group.obj-type = p-obj-type and
     1089                           x_obj-group.obj-code = p-obj-code :
     1090                       create  x_grp-obj-price.
     1091                       buffer-copy buf_grp-obj-price to x_grp-obj-price .
     1092                  end.
     1093       end.
     1094     end.
     1095   end procedure.
     1096   procedure metod-delobj-usr :
     1097   define input  parameter p-pdf-id  as integer   no-undo .
     1098   define input  parameter p-pdf-db  as integer   no-undo .
     1099   define input  parameter p-plt-id  as integer   no-undo .
     1100   define input  parameter p-plt-db-num as integer   no-undo .
     1101   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
     1102     do
     1103     on error undo, return error return-value
     1104     :
     1105   for each buf_price-doc-forming-attr no-lock  where
     1106            buf_price-doc-forming-attr.pdf-id =     p-pdf-id and
     1107            buf_price-doc-forming-attr.pdf-db =     p-pdf-db and
     1108            buf_price-doc-forming-attr.plt-id =     p-plt-id and
     1109            buf_price-doc-forming-attr.plt-db-num = p-plt-db-num and
     1110            buf_price-doc-forming-attr.attr-code begins "obj" :
     1111      for each x_obj-group  where
     1112               x_obj-group.obj-type = substring(buf_price-doc-forming-attr.attr-code,4,3) and
     1113               x_obj-group.obj-code = int(substring(buf_price-doc-forming-attr.attr-code,7,20)) :
     1114        delete x_obj-group.
     1115      end.
     1116   end.
     1117     if not can-find (first x_obj-group) then do:
     1118        return "nullobj" .
     1119     end.
     1120   end.
     1121   end procedure.
     1122   procedure metod-obj-pdf :
     1123   define input  parameter p-cntxt-db-num as integer   no-undo .
     1124   define input  parameter p-pdf-id     like ub.price-doc-forming.pdf-id   no-undo .
     1125   define input  parameter p-pdf-db-num like ub.price-doc-forming.pdf-db   no-undo .
     1126   define input  parameter p-plt-id     like ub.price-doc-forming.plt-id   no-undo .
     1127   define input  parameter p-plt-db-num like ub.price-doc-forming.plt-db-num  no-undo .
     1128   define buffer buf_price-list-type for ub.price-list-type  .
     1129   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     1130     do
     1131     on error undo, return error return-value
     1132     :
     1133    for each  x_obj-group : delete x_obj-group. end.
     1134    find first buf_price-list-type no-lock where
     1135               buf_price-list-type.plt-id = p-plt-id and
     1136               buf_price-list-type.plt-db-num = p-plt-db-num no-error .
     1137   if error-status :error then return error return-value .
     1138    find first buf_price-doc-forming no-lock where
     1139               buf_price-doc-forming.plt-id     = p-plt-id and
     1140               buf_price-doc-forming.plt-db-num = p-plt-db-num and
     1141               buf_price-doc-forming.pdf-id     = p-pdf-id and
     1142               buf_price-doc-forming.pdf-db     = p-pdf-db-num
     1143               no-error .
     1144   if error-status :error then return error return-value .
     1145     run metod-gop-obj in this-procedure (
     1146         p-cntxt-db-num,
     1147         buf_price-list-type.gop-id ,
     1148         buf_price-list-type.gop-db-num
     1149         ) no-error .
     1150     run metod-delobj-usr in this-procedure (
     1151       buf_price-doc-forming.pdf-id ,
     1152       buf_price-doc-forming.pdf-db ,
     1153       buf_price-doc-forming.plt-id ,
     1154       buf_price-doc-forming.plt-db-num
     1155       ) no-error .
     1156     end.
     1157   end procedure.
     1158   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1159   define temp-table x_obj-grp-obj-price no-undo like ub.obj-grp-obj-price .
     1160   procedure metod-gop-obj-all :
     1161   define input  parameter p-curr-db-num as integer   no-undo .
     1162     do
     1163     on error undo, return error return-value
     1164     :
     1165    empty temp-table x_obj-group .
     1166    empty temp-table x_obj-grp-obj-price .
     1167    define buffer buf_grp-obj-price for ub.grp-obj-price  .
     1168    for each buf_grp-obj-price no-lock where
     1169             buf_grp-obj-price.stts = 0 :
     1170         run metod-gop-obj in this-procedure (
     1171             input  p-curr-db-num ,
     1172             input  buf_grp-obj-price.gop-id       ,
     1173             input  buf_grp-obj-price.gop-db-num   ).
     1174             for each x_obj-group :
     1175                create x_obj-grp-obj-price.
     1176                buffer-copy buf_grp-obj-price to x_obj-grp-obj-price
     1177                assign
     1178                   x_obj-grp-obj-price.obj-type = x_obj-group.obj-type
     1179                   x_obj-grp-obj-price.obj-code = x_obj-group.obj-code
     1180                .
     1181             end.
     1182    end.
     1183     end.
     1184   end procedure.
     1185   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1186   FUNCTION price-grp RETURNS CHARACTER
     1187   (buffer buf_clients for ub.clients):
     1188   define variable tt-grp-obj as character no-undo .
     1189   tt-grp-obj =  "" .
     1190     for each x_obj-grp-obj-price  where
     1191              x_obj-grp-obj-price.stts = 0 and
     1192              x_obj-grp-obj-price.obj-type = buf_clients.obj-type and
     1193              x_obj-grp-obj-price.obj-code = buf_clients.obj-code :
     1194              tt-grp-obj = tt-grp-obj + string(x_obj-grp-obj-price.gop-id ) +
     1195              ( if x_obj-grp-obj-price.gop-db-num = 0 then "" else
     1196              "БД"  + string (x_obj-grp-obj-price.gop-db-num)) + "," .
     1197     end.
     1198   return trim(tt-grp-obj, ",") .
     1199   END FUNCTION.
     1200   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1201   define variable c-point  as character no-undo .
     1202   define variable tbl      as character no-undo .
     1203   define variable join-tbl as character no-undo .
     1204   define variable fld      as character no-undo .
     1205   define variable lab      as character no-undo .
     1206   define variable spr      as character no-undo .
     1207   define variable dim      as character no-undo .
     1208   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1209   procedure fltfield-clear :
     1210     define output parameter loc-fld as character no-undo.
     1211     define output parameter loc-lab as character no-undo .
     1212     define output parameter loc-spr as character no-undo .
     1213     define output parameter loc-dim as character no-undo .
     1214     assign
     1215       loc-fld = ""
     1216       loc-lab = ""
     1217       loc-spr = ""
     1218       loc-dim = "0"
     1219     .
     1220   end procedure .
     1221   procedure fltfield-add :
     1222     define input        parameter par-fld as character no-undo.
     1223     define input        parameter par-lab as character no-undo .
     1224     define input        parameter par-spr as character no-undo .
     1225     define input-output parameter loc-fld as character no-undo.
     1226     define input-output parameter loc-lab as character no-undo .
     1227     define input-output parameter loc-spr as character no-undo .
     1228     define input-output parameter loc-dim as character no-undo .
     1229     do
     1230     on error undo, return error
     1231     :
     1232       assign
     1233       loc-fld = if loc-dim = '0'
     1234                 then par-fld
     1235                 else (loc-fld + chr(44) + par-fld)
     1236       loc-lab = if loc-dim = '0'
     1237                 then par-lab
     1238                 else (loc-lab + chr(44) + par-lab)
     1239       loc-spr = if loc-dim = '0'
     1240                 then par-spr
     1241                 else (loc-spr + chr(44) + par-spr)
     1242       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
     1243                 string(integer(if num-entries(loc-dim) > 1
     1244                               then entry(2, loc-dim)
     1245                               else entry(1, loc-dim)
     1246                               ) + 1)
     1247       no-error
     1248       .
     1249     end.
     1250   end procedure.
     1251   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1252   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1253   procedure fltopend_fltopend :
     1254   define input parameter p-parent-handle as handle no-undo .
     1255   define input parameter p-qh as handle no-undo .
     1256   define input parameter p-flt-open-open-query  as character no-undo .
     1257   define input parameter p-where-cond as character no-undo .
     1258   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1259   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1260   define input parameter p-indexed-reposition as character no-undo .
     1261     do
     1262     on error undo, return error
     1263     :
     1264   define variable v-prepare-string as character no-undo .
     1265   define variable glog as logical no-undo .
     1266   assign
     1267   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1268                      p-where-cond + chr(32)  +
     1269                      p-use-indFIRST-query-tail + chr(32) +
     1270                      p-use-ind-sort-clmn-by + chr(32) +
     1271                      p-indexed-reposition
     1272   .
     1273   assign
     1274   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1275   if not glog
     1276   or error-status:error then do:
     1277     message error-status:get-message(1) view-as alert-box .
     1278     undo, return error .
     1279   end.
     1280   assign
     1281   glog = p-qh:query-open no-error .
     1282   if not glog
     1283   or error-status:error then do:
     1284     message error-status:get-message(1) view-as alert-box .
     1285     undo, return error .
     1286   end.
     1287     end.
     1288   end procedure.
     1289   procedure fltopend_fltfindd :
     1290   define input parameter p-parent-handle as handle no-undo .
     1291   define input parameter p-qh as handle no-undo .
     1292   define input parameter p-rowid as rowid no-undo .
     1293   define input parameter p-next as logical no-undo .
     1294   define input parameter p-lock as integer no-undo .
     1295   define input parameter p-bh as handle no-undo .
     1296   define input parameter p-where-cond as character no-undo .
     1297   define input parameter p-use-index-phrase as character no-undo .
     1298   define variable glog as logical no-undo .
     1299   define variable v-qh as handle no-undo .
     1300   define variable v-bh as handle no-undo .
     1301   define variable v-recid as recid no-undo .
     1302   define variable v-prepare-string as character no-undo .
     1303   do
     1304   on error undo, return error
     1305   on stop undo, return error
     1306   :
     1307     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1308     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1309     create query v-qh.
     1310     v-qh:set-buffers(v-bh).
     1311     v-prepare-string = substitute("for each &1 &2 &3"
     1312                                     ,v-bh:name
     1313                                     ,p-where-cond
     1314                                     ,p-use-index-phrase).
     1315     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1316     if not glog then do:
     1317       delete object v-qh.
     1318       delete object v-bh.
     1319       undo, return error .
     1320     end.
     1321     glog = v-qh:query-open no-error .
     1322     if not glog then do:
     1323       delete object v-qh.
     1324       delete object v-bh.
     1325       undo, return error .
     1326     end.
     1327     if p-next then do:
     1328       v-qh:reposition-to-rowid(p-rowid) no-error .
     1329       glog = v-qh:get-next( p-lock) no-error .
     1330       glog = v-qh:get-next( p-lock) no-error .
     1331       if not glog or v-qh:query-off-end = yes then do:
     1332         glog = v-qh:get-first( p-lock) no-error .
     1333       end.
     1334     end.
     1335     else do:
     1336       glog = v-qh:get-first( p-lock) no-error .
     1337     end.
     1338     v-recid = v-bh:recid no-error .
     1339     delete object v-qh.
     1340     delete object v-bh.
     1341     return string(v-recid) .
     1342   end.
     1343   end procedure.
     1344   procedure fltopend_fltfindq :
     1345   define input parameter p-parent-handle as handle no-undo .
     1346   define input parameter p-qh as handle no-undo .
     1347   define input parameter p-next as logical no-undo .
     1348   define input parameter p-lock as integer no-undo .
     1349   define input parameter p-flt-open-open-query  as character no-undo .
     1350   define input parameter p-where-cond as character no-undo .
     1351   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1352   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1353   define input parameter p-indexed-reposition as character no-undo .
     1354   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1355   define variable glog as logical no-undo .
     1356   define variable v-qh as handle no-undo .
     1357   define variable v-bh as handle no-undo extent 18.
     1358   define variable v-rowid as rowid no-undo extent 18.
     1359   define variable v-ii as integer no-undo .
     1360   define variable v-prepare-string as character no-undo .
     1361   do
     1362   on error undo, return error
     1363   on stop undo, return error
     1364   :
     1365     create query v-qh.
     1366     do v-ii = 1 to p-qh:num-buffers:
     1367       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1368       assign
     1369       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1370       no-error.
     1371       v-qh:add-buffer(v-bh[v-ii]).
     1372     end.
     1373     assign
     1374     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1375                       p-where-cond + chr(32)  +
     1376                       p-use-indFIRST-query-tail + chr(32) +
     1377                       p-use-ind-sort-clmn-by + chr(32) +
     1378                       p-indexed-reposition
     1379     .
     1380     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1381     if not glog then do:
     1382       delete object v-qh.
     1383       do v-ii = 1 to p-qh:num-buffers:
     1384         delete object v-bh[v-ii].
     1385       end.
     1386       undo, return error .
     1387     end.
     1388     glog = v-qh:query-open no-error .
     1389     if not glog then do:
     1390       delete object v-qh.
     1391       do v-ii = 1 to p-qh:num-buffers:
     1392         delete object v-bh[v-ii].
     1393       end.
     1394       undo, return error .
     1395     end.
     1396     if p-next then do:
     1397       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1398       glog = v-qh:get-next( p-lock) no-error .
     1399       glog = v-qh:get-next( p-lock) no-error .
     1400       if not glog or v-qh:query-off-end = yes then do:
     1401         glog = v-qh:get-first( p-lock) no-error .
     1402       end.
     1403     end.
     1404     else do:
     1405       glog = v-qh:get-first( p-lock) no-error .
     1406     end.
     1407     do v-ii = 1 to p-qh:num-buffers:
     1408       assign
     1409       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1410       no-error.
     1411     end.
     1412     delete object v-qh.
     1413     do v-ii = 1 to p-qh:num-buffers:
     1414       delete object v-bh[v-ii].
     1415     end.
     1416   end.
     1417   end procedure.
     1418   define variable attr-option as character no-undo .
     1419   define variable add-option as character no-undo .
     1420   define variable cli-attr-option as character no-undo .
     1421   define variable v-is-deploy as logical no-undo .
     1422   define variable v-rid-list as character no-undo .
     1423   define variable v-doc-rec as recid no-undo .
     1424   define variable v-grp as character no-undo .
     1425   define variable v-exist-price-grp as logical   no-undo .
     1426   define variable sort-column-name as character no-undo.
     1427   define variable filter-point     as character NO-UNDO INIT "thobjs".
     1428   define variable filter-label     as character NO-UNDO INIT "Объекты TH".
     1429   define variable filter-point0     as character NO-UNDO INIT "thobjs".
     1430   define variable filter-label0     as character NO-UNDO INIT "Объекты TH".
     1431   define variable v-new-selection-flag as logical no-undo .
     1432   DEFINE VARIABLE v-list-mode AS CHARACTER NO-UNDO.
     1433   define variable v-shop as character no-undo .
     1434   define variable v-stock as character no-undo .
