     1511        LABEL "&Просмотр"
     1512        SIZE 10 BY 1.
     1513   DEFINE BUTTON B-mark
     1514        LABEL "&*"
     1515        SIZE 3 BY 1.
     1516   DEFINE BUTTON B-price
     1517        LABEL "&Цены"
     1518        SIZE 10 BY 1.
     1519   DEFINE BUTTON B-print
     1520        LABEL "Пе&чать"
     1521        SIZE 3 BY 1.
     1522   DEFINE BUTTON b-quit AUTO-GO
     1523        LABEL "&Выход"
     1524        SIZE 10 BY 1
