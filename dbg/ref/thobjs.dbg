     2155   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2156   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2157   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2158   on help of frame Dialog-Frame
     2159   do:
     2160     run gbl/app_help.p
     2161       (input this-procedure :file-name
     2162       ,input ''
     2163       ,input ?
     2164       ) no-error.
     2165     if error-status :error then do:
     2166       message
     2167         "Ошибка при вызове помощи"
     2168         error-status :get-message(1)
     2169         view-as alert-box .
     2170     end.
     2171   end.
     2172   run minbtn-set in this-procedure .
     2173   on choose of b-help in frame Dialog-Frame
     2174   do:
     2175     apply "help":u to frame Dialog-Frame .
     2176   end.
     2177   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2178   procedure minbtn-set :
     2179       do
     2180           on error undo, return error return-value
     2181           :
     2182           define variable ii              as integer       no-undo .
     2183           define variable fh              as widget-handle no-undo .
     2184           define variable hh              as widget-handle no-undo .
     2185           define variable v-h             as handle        extent 4 no-undo .
     2186           define variable v-name-button   as character     no-undo .
     2187           define variable v-help-old-x    as decimal       no-undo .
     2188           define variable v-help-old-y    as decimal       no-undo .
     2189           define variable v-help-old-size as decimal       no-undo .
     2190           define variable v-frame-width   as decimal       no-undo .
     2191           define variable jj              as integer       no-undo .
     2192           do
     2193               on error undo, return error
     2194               :
     2195               assign
     2196                   v-frame-width = frame Dialog-Frame:width - 0.3
     2197                   fh            = frame Dialog-Frame:first-child
     2198                   hh            = fh:first-child
     2199                   ii            = 1
     2200                   .
     2201               do while valid-handle(hh):
     2202                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2203                   do:
     2204                       case lc(hh:name) :
     2205                           when "b-help" then
     2206                               do:
     2207                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2208                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2209                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2210                                   hh:TOOLTIP = "Помощь" .
     2211                                   v-help-old-x = hh:column .
     2212                                   v-help-old-y = hh:row    .
     2213                                   v-help-old-size = hh:width .
     2214                                   hh:width-chars = 2.5 .
     2215                               end.
     2216                           when "b-print" then
     2217                               do:
     2218                                   hh:load-image("cmp/b-print.bmp":u) .
     2219                                   hh:TOOLTIP = "Печать" .
     2220                                   v-h[ii] = hh:handle .
     2221                                   ii = ii + 1 .
     2222                                   hh:width-chars = 3 .
     2223                               end.
     2224                           when "b-history" or
     2225                           when "b-hist" then
     2226                               do:
     2227                                   hh:load-image("cmp/b-hist.bmp":u) .
     2228                                   hh:TOOLTIP = "История" .
     2229                                   v-h[ii] = hh:handle .
     2230                                   ii = ii + 1 .
     2231                                   hh:width-chars = 3 .
     2232                               end.
     2233                           when "b-sch" then
     2234                               do:
     2235                                   hh:load-image("cmp/b-sch.bmp":u) .
     2236                                   hh:TOOLTIP = "Установка Фильтра" .
     2237                                   v-h[ii] = hh:handle .
     2238                                   ii = ii + 1 .
     2239                                   hh:width-chars = 3 .
     2240                               end.
     2241                           when "b-hist-user" then
     2242                               do:
     2243                                   hh:load-image("cmp/b-hist.bmp":u) .
     2244                                   hh:TOOLTIP = "История пользователя" .
     2245                                   ii = ii + 1 .
     2246                               end.
     2247                       end case.
     2248                   end.
     2249                   hh = hh:next-sibling.
     2250               end.
     2251               b-help:column = v-frame-width - b-help:width-chars.
     2252               jj = 0.
     2253               repeat ii = 4 to 1 by -1 :
     2254                   if valid-handle (v-h[ii] ) then
     2255                   do:
     2256                       jj  = jj + 1 .
     2257                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2258                       v-h[ii]:row    = v-help-old-y .
     2259                   end.
     2260               end.
     2261           end.
     2262       end.
     2263   end procedure.
     2264   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2265   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2266   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2267   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2268   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2269   define variable v-diasize-current-frame-height as decimal   no-undo .
     2270   define variable v-diasize-change-size          as logical   no-undo .
     2271   define variable v-diasize-resize-button        as handle    no-undo .
     2272   define variable v-diasize-wndmax               as logical   no-undo .
     2273   define variable v-diasize-wndstore             as logical   no-undo .
     2274   define variable v-diasize-proc-name            as character no-undo .
     2275   define variable v-diasize-browse-handle        as handle    no-undo .
     2276   define variable v-diasize-browse-number        as integer   no-undo .
     2277   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2278   define temp-table temp-diasize-handle no-undo
     2279     field handle-value  as handle
     2280     field save-position as decimal
     2281     index xpk is primary unique handle-value
     2282     .
     2283   define temp-table temp-browse-handle no-undo
     2284     field browse-type   as character
     2285     field browse-number as integer
     2286     field browse-handle as handle
     2287     field original-size as decimal
     2288     index xpk is primary unique browse-type browse-number
     2289     index xie browse-type browse-handle
     2290   .
     2291   procedure diasize_change-height :
     2292     define input  parameter p-change-value  as decimal   no-undo .
     2293     define input  parameter p-move-resize   as logical   no-undo .
     2294     define variable v-field-group-handle    as handle    no-undo .
     2295     define variable v-object-handle         as handle    no-undo .
     2296     define variable v-frame-height          as decimal   no-undo .
     2297     define variable v-frame-virtual-height  as decimal   no-undo .
     2298     define variable v-browse-height         as decimal   no-undo .
     2299     define variable v-window-height         as decimal   no-undo .
     2300     define variable v-window-virtual-height as decimal   no-undo .
     2301     define variable v-change-sign           as integer   no-undo .
     2302     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2303     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2304     if p-change-value > 0
     2305     then do:
     2306       if frame Dialog-Frame :height + p-change-value
     2307           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2308       then do:
     2309         assign
     2310           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2311                           - (frame Dialog-Frame :height-chars)
     2312         .
     2313         if p-change-value <= 0
     2314         then do:
     2315           run diasize_position-resize-button in this-procedure .
     2316           return .
     2317         end.
     2318       end.
     2319     end.
     2320     if p-change-value < 0
     2321     then do:
     2322       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2323       then do:
     2324         assign
     2325           p-change-value = v-diasize-orig-frame-height
     2326                          - (frame Dialog-Frame :height-chars)
     2327         .
     2328         if p-change-value >= 0
     2329         then do:
     2330           run diasize_position-resize-button in this-procedure .
     2331           return .
     2332         end.
     2333       end.
     2334     end.
     2335     if p-change-value >= 0
     2336     then do:
     2337       assign
     2338         v-change-sign = 1
     2339       .
     2340     end.
     2341     else do:
     2342       assign
     2343         v-change-sign = -1
     2344       .
     2345     end.
     2346     assign
     2347       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2348     .
     2349     if p-change-value = 0
     2350     then do:
     2351       run diasize_position-resize-button in this-procedure .
     2352       return .
     2353     end.
     2354     move_block:
     2355     do
     2356     on error undo move_block, retry move_block
     2357     :
     2358       if retry
     2359       then do:
     2360         do
     2361         on error undo move_block, leave move_block
     2362         :
     2363           if p-change-value > 0
     2364           then do:
     2365             for each buf_temp-diasize-handle
     2366             on error undo, next
     2367             :
     2368               assign
     2369                 v-object-handle = buf_temp-diasize-handle.handle-value
     2370               .
     2371               if v-object-handle <> v-diasize-resize-button
     2372               then do:
     2373                 assign
     2374                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2375                 .
     2376               end.
     2377             end.
     2378             assign
     2379               v-diasize-browse-handle :height = v-browse-height
     2380             .
     2381             for each buf_temp-browse-handle
     2382               where buf_temp-browse-handle.browse-type = 'height':u
     2383             on error undo, next
     2384             :
     2385               assign
     2386                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2387               .
     2388             end.
     2389             assign
     2390               frame Dialog-Frame :height = v-frame-height
     2391             .
     2392             if frame Dialog-Frame :scrollable = true
     2393             then do:
     2394               assign
