     1535   DEFINE VARIABLE f-db-name AS CHARACTER FORMAT "X(256)":U
     1536        VIEW-AS FILL-IN
     1537        SIZE 29 BY 1 NO-UNDO.
     1538   DEFINE VARIABLE f-db-num AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
     1539        LABEL "БД"
     1540        VIEW-AS FILL-IN
     1541        SIZE 6 BY 1 NO-UNDO.
     1542   DEFINE VARIABLE f-host-code AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
     1543        LABEL "Фирма"
     1544        VIEW-AS FILL-IN
     1545        SIZE 6 BY 1 NO-UNDO.
     1546   DEFINE VARIABLE f-host-name AS CHARACTER FORMAT "X(256)":U
     1547        VIEW-AS FILL-IN
     1548        SIZE 29 BY 1 NO-UNDO.
     1549   DEFINE VARIABLE mark-num AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
     1550         VIEW-AS TEXT
     1551        SIZE 10 BY 1
     1552        FGCOLOR 4  NO-UNDO.
     1553   DEFINE VARIABLE sch-code AS INTEGER FORMAT ">>>>9":U INITIAL 0
     1554        LABEL "Код"
     1555        VIEW-AS FILL-IN
     1556        SIZE 6 BY 1 NO-UNDO.
     1557   DEFINE VARIABLE rs-cli-type AS CHARACTER
     1558        VIEW-AS RADIO-SET HORIZONTAL
     1559        RADIO-BUTTONS
     1560             "Item 1", "1"
     1561        SIZE 17 BY .8 NO-UNDO.
     1562   DEFINE QUERY br-objects FOR
     1563         X_clients SCROLLING.
     1564   DEFINE BROWSE br-objects
     1565     QUERY br-objects NO-LOCK DISPLAY
     1566         mark-string(recid(X_clients), v-rid-list) Format "X(1)" COLUMN-LABEL '*'
     1567   X_clients.obj-type COLUMN-LABEL "Тип " FORMAT "X(3)"
     1568   X_clients.obj-code COLUMN-LABEL "Код " FORMAT ">>>>>>>>9"
     1569   X_clients.obj-name COLUMN-LABEL "Название " FORMAT "x(80)" width 25
     1570   X_clients.host-code COLUMN-LABEL "Код фирмы " FORMAT ">>>>>>>>9"
     1571   get-host-name(INPUT X_clients.host-code) COLUMN-LABEL 'Фирма' FORMAT "x(80)" width 25
     1572   (if X_clients.stts = 0 then ' ' else '+' ) format "x(1)" column-label 'Удал'
     1573   X_clients.db-num COLUMN-LABEL "БД"
     1574   get-shift-on ( INPUT X_clients.obj-type, INPUT X_clients.obj-code) COLUMN-LABEL "Смены":L format " + / - "
     1575   X_clients.grp-name COLUMN-LABEL "Группа" format "X(255)" width 25
     1576   price-grp ( buffer X_clients ) @ v-grp COLUMN-LABEL "Группа ценообразования" FORMAT "x(80)" width 25
     1577   ENABLE
     1578   X_clients.grp-name
     1579       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 19 FIT-LAST-COLUMN.
     1580   DEFINE FRAME Dialog-Frame
     1581        b-quit AT ROW 1 COL 1
     1582        B-mark AT ROW 1 COL 11 WIDGET-ID 16
     1583        B-sel AT ROW 1 COL 14 WIDGET-ID 20
     1584        B-add AT ROW 1 COL 24 WIDGET-ID 4
     1585        B-lkp AT ROW 1 COL 34 WIDGET-ID 14
     1586        B-chg AT ROW 1 COL 44 WIDGET-ID 6
     1587        B-del AT ROW 1 COL 54 WIDGET-ID 8
     1588        B-attr AT ROW 1 COL 64 WIDGET-ID 26
     1589        B-right AT ROW 1 COL 74 WIDGET-ID 24
     1590        b-sch AT ROW 1 COL 86 WIDGET-ID 40
     1591        B-print AT ROW 1 COL 89 WIDGET-ID 18
     1592        B-hist AT ROW 1 COL 92 WIDGET-ID 12
     1593        B-Help AT ROW 1 COL 95
     1594        B-list AT ROW 2 COL 14 WIDGET-ID 54
     1595        sch-code AT ROW 2 COL 27.5 COLON-ALIGNED WIDGET-ID 36
     1596        B-cli-attr AT ROW 2 COL 54 WIDGET-ID 32
     1597        B-price AT ROW 2 COL 64 WIDGET-ID 30
     1598        B-dis-rule AT ROW 2 COL 74 WIDGET-ID 28
     1599        B-grp AT ROW 2 COL 84 WIDGET-ID 34
     1600        rs-cli-type AT ROW 2.08 COL 36.5 NO-LABEL WIDGET-ID 38
     1601        f-host-code AT ROW 3 COL 7 COLON-ALIGNED WIDGET-ID 46
     1602        B-host AT ROW 3 COL 15.5 WIDGET-ID 48
     1603        f-host-name AT ROW 3 COL 17 COLON-ALIGNED NO-LABEL WIDGET-ID 50
     1604        f-db-num AT ROW 3 COL 51 COLON-ALIGNED WIDGET-ID 42
     1605        B-db AT ROW 3 COL 59.5 WIDGET-ID 44
     1606        f-db-name AT ROW 3 COL 63.5 COLON-ALIGNED NO-LABEL WIDGET-ID 52
     1607        br-objects AT ROW 4 COL 1 WIDGET-ID 100
     1608        mark-num AT ROW 2 COL 1.5 NO-LABEL WIDGET-ID 22
     1609        SPACE(88.20) SKIP(20.22)
     1610       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1611            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1612            TITLE "Объекты"
     1613            CANCEL-BUTTON b-quit.
     1614   ASSIGN
     1615          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1616          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1617   ASSIGN
     1618          B-add:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-add:HANDLE.
     1619   ASSIGN
     1620          B-attr:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-attr:HANDLE.
     1621   ASSIGN
     1622          B-cli-attr:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-cli-attr:HANDLE.
     1623   ASSIGN
     1624          B-list:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-list:HANDLE.
     1625   ASSIGN
     1626          f-db-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1627   ASSIGN
     1628          f-db-num:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1629   ASSIGN
     1630          f-host-code:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1631   ASSIGN
     1632          f-host-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1633   ON GO OF FRAME Dialog-Frame
     1634   DO:
     1635     p-rid-list = v-rid-list.
     1636   END.
     1637   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1638   DO:
     1639     APPLY "END-ERROR":U TO SELF.
     1640   END.
     1641   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1642   DO:
     1643   if add-option = '':U then do:
     1644      run gbl/pop-up.p ( input self:handle, input no) no-error.
     1645   end.
     1646   IF add-option = '' THEN RETURN NO-APPLY.
     1647   RUN proc-b-add IN THIS-PROCEDURE NO-ERROR.
     1648   IF ERROR-STATUS:ERROR THEN DO:
     1649       add-option = ''.
     1650       RETURN no-apply.
     1651   END.
     1652   add-option = ''.
     1653   END.
     1654   ON CHOOSE OF B-attr IN FRAME Dialog-Frame
     1655   DO:
     1656   define variable v-param as character no-undo .
     1657   define variable v-db-num like ub.db.db-num no-undo .
     1658   if not available X_clients then return no-apply.
     1659   if attr-option = '':U then do:
     1660      run gbl/pop-up.p ( input self:handle, input no) no-error.
     1661   end.
     1662   if attr-option = '':U then return no-apply.
     1663   if attr-option = 'ИЗМЕНЕНИЕ':U
     1664   or attr-option = 'КОПИРОВАНИЕ':U
     1665   then do:
     1666     if v-cntxt-db-num <> 0
     1667     then do:
     1668   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1669   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1670     (input  X_clients.obj-type
     1671     ,input  X_clients.obj-code
     1672     ,output v-db-num
     1673     )  .
     1674       if v-db-num <> v-cntxt-db-num then do:
     1675         message
     1676         "Нельзя менять ПАРАМЕТРЫ в чужой УБД"
     1677         view-as alert-box error .
     1678         return no-apply.
     1679       end.
     1680     end.
     1681   end.
     1682   run proc-b-attr in this-procedure (
     1683                                       input attr-option
     1684                                      ,input X_clients.obj-type
     1685                                      ,input X_clients.obj-code) no-error .
     1686   if error-status:error then do:
     1687     assign
     1688     attr-option = "":u.
     1689     return no-apply.
     1690   end.
     1691   attr-option = "":u.
     1692   END.
     1693   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1694   DO:
     1695     define variable ri as recid no-undo.
     1696     if available X_clients then do:
     1697       CASE X_clients.obj-type:
     1698         WHEN 'маг':U THEN DO:
     1699             ri = recid (X_clients).
     1700             run adm/shopi.w ( input parparentproc
     1701                              ,input  X_clients.host-code
     1702                              ,input X_clients.obj-code
     1703                              ,INPUT 'ИЗМЕНЕНИЕ':U
     1704                              ,input-output ri).
     1705             display
     1706             X_clients.obj-name
     1707             X_clients.grp-name
     1708             with browse br-objects.
     1709         END.
     1710         WHEN 'скл':U THEN DO:
     1711         ri = recid (X_clients).
     1712         run adm/storei.w ( input parparentproc
     1713                           ,input v-cntxt-host-code-obj
     1714                           ,input X_clients.obj-code
     1715                           ,input 'ИЗМЕНЕНИЕ':U
     1716                           ,input-output ri).
     1717         display
     1718         X_clients.obj-name
     1719         X_clients.grp-name
     1720         with browse br-objects.
     1721         END.
     1722       END CASE.
     1723     end.
     1724   END.
     1725   ON CHOOSE OF B-cli-attr IN FRAME Dialog-Frame
     1726   DO:
     1727    define variable v-updated as logical no-undo .
     1728    define variable v-is-error as logical no-undo .
     1729    define variable v-db-num as integer no-undo .
     1730    define variable ri as recid no-undo .
     1731     if not available X_clients then do:
     1732       return no-apply.
     1733     end.
     1734     ri = recid(X_clients).
     1735     if cli-attr-option = "":U then do:
     1736       run gbl/pop-up.p ( input self :handle, input no ) no-error.
     1737       if error-status :error then do: return no-apply. end.
     1738     end.
     1739     if cli-attr-option = "":U then do:
     1740         return no-apply.
     1741     end.
     1742     if cli-attr-option = 'ИЗМЕНЕНИЕ':U
     1743     or cli-attr-option = 'КОПИРОВАНИЕ':U then do:
     1744       if v-cntxt-db-num > 0 then do:
     1745   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1746   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1747     (input  X_clients.obj-type
     1748     ,input  X_clients.obj-code
     1749     ,output v-db-num
     1750     )  .
     1751         if v-db-num <> v-cntxt-db-num then do:
     1752           message
     1753           "Нельзя менять АТРИБУТЫ в чужой УБД"
     1754           view-as alert-box error .
     1755           return no-apply.
     1756         end.
     1757       end.
     1758     end.
     1759     run ref/ca-attrr.p (
     1760                       input parparentproc
     1761                      ,input (if lookup("b-add", p-bttns) > 0
     1762                             AND cli-attr-option = 'ИЗМЕНЕНИЕ':U
     1763                             then 'ИЗМЕНЕНИЕ':U
     1764                             else 'ПРОСМОТР':U)
     1765                      ,input X_clients.obj-type
     1766                      ,input X_clients.obj-code
     1767                      ,input yes
     1768                      ,output v-updated
     1769                      ,output v-is-error
     1770                      ) no-error.
     1771     if error-status:error
     1772     or v-is-error then do:
     1773       message
     1774       "Ошибка при вызове списка атрибутов клиента" skip
     1775       error-status:get-message(1) skip
     1776       return-value
     1777       view-as alert-box .
     1778       assign
     1779       cli-attr-option = "":U
     1780       .
     1781       undo, return no-apply.
     1782     end.
     1783     cli-attr-option = "":U.
     1784   END.
     1785   ON CHOOSE OF B-db IN FRAME Dialog-Frame
     1786   DO:
     1787     run proc-b-db IN THIS-PROCEDURE NO-ERROR.
     1788     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1789   END.
     1790   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1791   DO:
     1792     IF NOT AVAILABLE X_clients THEN RETURN NO-APPLY.
     1793     run proc-b-del in this-procedure no-error.
     1794     if error-status:error then return no-apply.
     1795   END.
     1796   ON CHOOSE OF B-dis-rule IN FRAME Dialog-Frame
     1797   DO:
     1798   define variable v-sts as integer no-undo .
     1799   define variable v-loc-rid-list as character no-undo .
     1800   if not available X_clients then return no-apply.
     1801   assign
     1802   v-sts = integer('0':U).
     1803   run ref/dis-ruls.w (
     1804                 input parparentproc
     1805               , input 0
     1806               , input X_clients.obj-type
     1807               , input X_clients.obj-code
     1808               , input "b-add":U
     1809               , input "cli-type"
     1810               , input 0
     1811               , input ?
     1812               , input 0
     1813               , input-output v-sts
     1814               , input-output v-loc-rid-list ) no-error .
     1815   END.
     1816   ON CHOOSE OF B-grp IN FRAME Dialog-Frame
     1817   DO:
     1818   define variable lns-cnt as integer no-undo .
     1819   define variable g-grp as character no-undo .
     1820   define variable v-gds-rec as recid no-undo.
     1821   define variable ri as recid no-undo .
     1822   define variable glog as logical no-undo .
     1823   define buffer buf_clients for ub.clients.
     1824   define buffer buf_cli-grp for ub.cli-grp.
     1825   if not available X_clients then return no-apply.
     1826   ri = recid(X_clients).
     1827   glog = yes.
     1828   message
     1829   "Выберите группу, в которую нужно" skip
     1830   "переместить объект(-ы)."
     1831   view-as alert-box question buttons OK-Cancel update glog.
     1832   if not glog then   do:
     1833     apply "entry" to br-objects in frame Dialog-Frame.
     1834     return no-apply.
     1835   end.
     1836   g-grp = "".
     1837   run ref/cli-grps.w (
     1838                      input parparentproc
     1839                    , input 'терм':U + ",b-sel"
     1840                    , input-output g-grp ) .
     1841   if g-grp = "" then  do:
     1842     apply "ENTRY" to br-objects.
     1843     return no-apply.
     1844   end.
     1845   else do transaction:
     1846       FIND buf_cli-grp where recid( buf_cli-grp ) = integer( g-grp ) .
     1847       if v-rid-list = "" then
     1848       v-rid-list = string( recid( X_clients) ) .
     1849       lns-cnt = 1.
     1850       DO WHILE lns-cnt <= num-entries( v-rid-list ) :
     1851         v-gds-rec = integer( entry( lns-cnt, v-rid-list ) ) .
     1852         if lns-cnt = 1 then ri = v-gds-rec.
     1853          FOR FIRST buf_clients WHERE RECID(buf_clients) = v-gds-rec
     1854         on error  undo , next
     1855         on stop   undo , next
     1856         on endkey undo , next
     1857         :
     1858           buf_clients.grp-code = buf_cli-grp.node-code.
     1859           lns-cnt = lns-cnt + 1.
     1860         end.
     1861       END .
     1862       if lns-cnt < num-entries(v-rid-list) + 1 then do:
     1863         message
     1864         substitute("Удалось сменить группу для &1 объектов", lns-cnt - 1)
     1865         view-as alert-box error.
     1866       end.
     1867       v-rid-list = "".
     1868       mark-num = 0.
     1869       hide mark-num in frame Dialog-Frame.
     1870   end.
     1871   run Openbr in this-procedure ( input yes, input no, input '':U).
     1872   reposition br-objects to recid ri no-error.
     1873   apply "ENTRY" to br-objects.
     1874   apply "value-changed" to br-objects.
     1875   END.
