     3006         assign
     3007           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3008         no-error .
     3009         if error-status :error
     3010         or error-status :get-message(1) <> ""
     3011         then do:
     3012           undo move_block, retry move_block.
     3013         end.
     3014         if frame Dialog-Frame :scrollable = true
     3015         then do:
     3016           assign
     3017             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3018           no-error .
     3019           if error-status :error
     3020           or error-status :get-message(1) <> ""
     3021           then do:
     3022             undo move_block, retry move_block.
     3023           end.
     3024         end.
     3025       end.
     3026       if p-move-resize
     3027       then do:
     3028         run diasize_position-resize-button in this-procedure .
     3029       end.
     3030       if v-diasize-wndstore = true
     3031       then do:
     3032         if connected("ub") = true
     3033         then do:
     3034           define variable v-cntxt-db-num        as integer   no-undo .
     3035           define variable v-cntxt-userid        as character no-undo .
     3036           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3037                                             , OUTPUT v-cntxt-userid
     3038                                             ) .
     3039           run gbl/wndsizew.p
     3040             (input  v-cntxt-db-num
     3041             ,input  v-cntxt-userid
     3042             ,input  v-diasize-proc-name
     3043             ,input  'width':u
     3044             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3045             ) .
     3046         end.
     3047       end.
     3048     end.
     3049     assign
     3050       v-diasize-change-size = false
     3051     .
     3052   end procedure.
     3053   procedure diasize_set-width :
     3054     define input  parameter p-new-width  as decimal   no-undo .
     3055     define input  parameter p-move-resize as logical   no-undo .
     3056     do
     3057     on error undo, return error return-value
     3058     :
     3059       run diasize_change-width in this-procedure
     3060         (input  (p-new-width - frame Dialog-Frame :width)
     3061         ,input  p-move-resize
     3062         ) .
     3063     end.
     3064   end procedure.
     3065   procedure diasize_position-resize-button :
     3066     do with frame Dialog-Frame
     3067     :
     3068       hide v-diasize-resize-button .
     3069       assign
     3070         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3071                     - 1
     3072                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3073         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3074                     - 1
     3075                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3076       .
     3077       view v-diasize-resize-button .
     3078     end.
     3079   end procedure.
     3080   on alt-right anywhere
     3081   do:
     3082     run diasize_change-width in this-procedure
     3083       (input 1
     3084       ,input true
     3085       ) .
     3086     return no-apply .
     3087   end.
     3088   on alt-left anywhere
     3089   do:
     3090     run diasize_change-width in this-procedure
     3091       (input -1
     3092       ,input true
     3093       ) .
     3094     return no-apply .
     3095   end.
     3096   on alt-down anywhere
     3097   do:
     3098     run diasize_change-height in this-procedure
     3099       (input 1
     3100       ,input true
     3101       ) .
     3102     return no-apply .
     3103   end.
     3104   on alt-up anywhere
     3105   do:
     3106     run diasize_change-height in this-procedure
     3107       (input -1
     3108       ,input true
     3109       ) .
     3110     return no-apply .
     3111   end.
     3112   on alt-enter of frame Dialog-Frame
     3113   do:
     3114     run diasize_maximize in this-procedure
     3115       (input  ?
     3116       ).
     3117     return no-apply .
     3118   end.
     3119   procedure diasize_end-move :
     3120     do
     3121     on error undo, return error return-value
     3122     :
     3123       define variable v-row-delta as decimal   no-undo .
     3124       define variable v-col-delta as decimal   no-undo .
     3125       define variable v-new-row as decimal   no-undo .
     3126       define variable v-new-col as decimal   no-undo .
     3127       assign
     3128         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3129         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3130       .
     3131       assign
     3132         v-row-delta = v-new-row - frame Dialog-Frame :height
     3133         v-col-delta = v-new-col - frame Dialog-Frame :width
     3134       .
     3135       run diasize_change-height in this-procedure
     3136         (input v-row-delta
     3137         ,input true
     3138         ) .
     3139       run diasize_change-width in this-procedure
     3140         (input v-col-delta
     3141         ,input true
     3142         ) .
     3143     end.
     3144   end procedure.
     3145   procedure diasize_maximize :
     3146     define input  parameter p-action as logical   no-undo .
     3147     do
     3148     on error undo, return error return-value
     3149     :
     3150       if p-action = ?
     3151       then do:
     3152         if v-diasize-need-maximize = true
     3153         then do:
     3154           assign
     3155             p-action = true
     3156           .
     3157         end.
     3158         else do:
     3159           assign
     3160             p-action = false
     3161           .
     3162         end.
     3163       end.
     3164       if p-action = true
     3165       then do:
     3166         run diasize_change-height in this-procedure
     3167           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3168               - frame Dialog-Frame :height-chars
     3169           ,input true
     3170           ) .
     3171         run diasize_change-width in this-procedure
     3172           (input session :width-chars
     3173               - frame Dialog-Frame :width-chars
     3174           ,input true
     3175           ) .
     3176         assign
     3177           v-diasize-need-maximize = false
     3178         .
     3179       end.
     3180       else do:
     3181         run diasize_change-width in this-procedure
     3182           (input v-diasize-orig-frame-width
     3183               - frame Dialog-Frame :width-chars
     3184           ,input true
     3185           ) .
     3186         run diasize_change-height in this-procedure
     3187           (input v-diasize-orig-frame-height
     3188               - frame Dialog-Frame :height-chars
     3189           ,input true
     3190           ) .
     3191         assign
     3192           v-diasize-need-maximize = true
     3193         .
     3194       end.
     3195     end.
     3196   end procedure.
     3197   procedure diasize_restore-orig-size :
     3198     do
     3199     on error undo, return error return-value
     3200     :
     3201       assign
     3202         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3203         v-diasize-current-frame-height = frame Dialog-Frame :height
     3204       .
     3205       run diasize_set-height in this-procedure
     3206         (input  v-diasize-orig-frame-height
     3207         ,input  true
     3208         ) .
     3209       run diasize_set-width in this-procedure
     3210         (input  v-diasize-orig-frame-width
     3211         ,input  true
     3212         ) .
     3213     end.
     3214   end procedure.
     3215   procedure diasize_restore-current-size :
     3216     do
     3217     on error undo, return error return-value
     3218     :
     3219       run diasize_set-height in this-procedure
     3220         (input  v-diasize-current-frame-height
     3221         ,input  true
     3222         ) .
     3223       run diasize_set-width in this-procedure
     3224         (input  v-diasize-current-frame-width
     3225         ,input  true
     3226         ) .
     3227     end.
     3228   end procedure.
     3229   procedure diasize_set-browse-handle :
     3230     define input  parameter p-browse-handle as handle   no-undo .
     3231     define buffer buf_temp-browse-handle for temp-browse-handle .
     3232     do
     3233     on error undo, return error return-value
     3234     :
     3235       assign
     3236         v-diasize-browse-handle = p-browse-handle
     3237       .
     3238       for each buf_temp-browse-handle
     3239       on error undo, return error return-value
     3240       :
     3241         delete buf_temp-browse-handle .
     3242       end.
     3243     end.
     3244   end procedure.
     3245   procedure diasize_add_browse :
     3246     define input  parameter p-browse-type   as character no-undo .
     3247     define input  parameter p-browse-handle as handle    no-undo .
     3248     define buffer buf_temp-browse-handle for temp-browse-handle .
     3249     do
     3250     on error undo, return error return-value
     3251     :
     3252       assign
     3253         v-diasize-browse-number = v-diasize-browse-number + 1
     3254       .
     3255       create buf_temp-browse-handle .
     3256       assign
     3257         buf_temp-browse-handle.browse-type   = p-browse-type
     3258         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3259         buf_temp-browse-handle.browse-handle = p-browse-handle
     3260       .
     3261     end.
     3262   end procedure.
     3263   procedure diasize_init :
     3264     define variable v-default-value    as logical   no-undo .
     3265     define variable v-restore-saved    as logical   no-undo .
     3266     define variable v-resize-value-str as character no-undo .
     3267     do
     3268     on error undo, return error return-value
     3269     :
     3270       do with frame Dialog-Frame
     3271       :
     3272         assign
     3273           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3274           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3275           v-diasize-browse-handle     = browse br-objects :handle
     3276         .
     3277         create button v-diasize-resize-button
     3278         assign
     3279           parent        = frame Dialog-Frame :first-child
     3280           label         = "s"
     3281           height-pixels = 16
     3282           width-pixels  = 16
     3283           visible       = true
     3284           sensitive     = true
     3285           movable       = true
     3286           triggers:
     3287             on end-move persistent run diasize_end-move in this-procedure .
     3288           end triggers.
     3289         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3290         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3291         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3292         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3293         assign
     3294           v-diasize-wndmax = false
     3295         .
     3296         if connected("ub") = true
     3297         then do:
     3298           define variable v-cntxt-db-num        as integer   no-undo .
     3299           define variable v-cntxt-userid        as character no-undo .
     3300           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3301                                             , OUTPUT v-cntxt-userid
     3302                                             ) .
     3303           run gbl/wndpar_r.p
     3304             (input  v-cntxt-db-num
     3305             ,input  v-cntxt-userid
     3306             ,input  'wndmax':U
     3307             ,output v-diasize-wndmax
     3308             ,output v-default-value
     3309             ) .
     3310         end.
     3311         assign
     3312           v-diasize-wndstore = false
     3313         .
     3314         if connected("ub") = true
     3315         then do:
     3316           run gbl/wndpar_r.p
     3317             (input  v-cntxt-db-num
     3318             ,input  v-cntxt-userid
     3319             ,input  'wndstore':U
     3320             ,output v-diasize-wndstore
     3321             ,output v-default-value
     3322             ) .
     3323         end.
     3324         assign
     3325           v-diasize-proc-name = entry(1, program-name(2), '.')
     3326         .
     3327         if v-diasize-wndstore = true
     3328         then do:
     3329           assign
     3330             v-restore-saved = false
     3331           .
     3332           if connected("ub") = true
     3333           then do:
     3334             run gbl/wndsizer.p
     3335               (input  v-cntxt-db-num
     3336               ,input  v-cntxt-userid
     3337               ,input  v-diasize-proc-name
     3338               ,input  'height':u
     3339               ,output v-resize-value-str
     3340               ) .
     3341             if v-resize-value-str <> '':U
     3342             then do:
     3343               run diasize_change-height in this-procedure
     3344                 (input  integer(v-resize-value-str)
     3345                 ,input  true
     3346                 ) .
     3347               assign
     3348                 v-restore-saved = true
     3349               .
     3350             end.
     3351           end.
     3352           if connected("ub") = true
     3353           then do:
     3354             run gbl/wndsizer.p
     3355               (input  v-cntxt-db-num
     3356               ,input  v-cntxt-userid
     3357               ,input  v-diasize-proc-name
     3358               ,input  'width':u
     3359               ,output v-resize-value-str
     3360               ) .
     3361             if v-resize-value-str <> '':U
     3362             then do:
     3363               run diasize_change-width in this-procedure
     3364                 (input  integer(v-resize-value-str)
     3365                 ,input  true
     3366                 ) .
     3367               assign
     3368                 v-restore-saved = true
     3369               .
     3370             end.
     3371           end.
     3372           if v-restore-saved <> true
     3373           then do:
     3374             if v-diasize-wndmax = true
     3375             then do:
     3376               run diasize_maximize in this-procedure
     3377                 (input  true
     3378                 ) .
     3379             end.
     3380           end.
     3381         end.
     3382         else do:
     3383           if v-diasize-wndmax = true
     3384           then do:
     3385             run diasize_maximize in this-procedure
     3386               (input  true
     3387               ) .
     3388           end.
     3389         end.
     3390       end.
     3391     end.
     3392   end procedure.
     3393   procedure diasize_need-full-display :
     3394     define output parameter p-need-full-display as logical   no-undo .
     3395     do
     3396     on error undo, return error return-value
     3397     :
     3398       assign
     3399         p-need-full-display = v-diasize-need-full-display
     3400       .
     3401       assign
     3402         v-diasize-need-full-display = false
     3403       .
     3404     end.
     3405   end procedure.
     3406   procedure get-context :
     3407      define output parameter p-db-num as integer          no-undo.
     3408      define output parameter p-user-id as character        no-undo.
     3409      define variable v-login               as character    no-undo.
     3410      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3411      define buffer buf_user-login  for ub.user-login .
     3412      do
     3413      on error undo, return error
     3414      :
     3415            FIND FIRST buf_sys-ctrl no-lock.
     3416            ASSIGN
     3417               v-login = USERID("ub")
     3418               p-db-num = buf_sys-ctrl.db-num
     3419            .
     3420            FIND FIRST buf_user-login
     3421                 WHERE buf_user-login.db-num = p-db-num
     3422                   AND buf_user-login.user-login = v-login
     3423                 no-lock
     3424                 no-error
     3425                 .
     3426            IF AVAILABLE buf_user-login
     3427            THEN DO:
     3428               assign
     3429                  p-user-id = buf_user-login.user-id
     3430               .
     3431            END.
     3432      end.
     3433   end procedure.
     3434       run diasize_init in this-procedure .
     3435   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3436   procedure set-filter-name :
     3437   define input parameter p-filter-name as character no-undo .
     3438     do with frame Dialog-Frame:
     3439       if p-filter-name > "" then do:
     3440         assign
     3441           frame Dialog-Frame:title
     3442             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     3443         .
     3444         assign
     3445           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3446         .
     3447       end.
     3448       else do:
     3449         assign
     3450           b-sch :tooltip = ""
     3451         .
     3452       end.
     3453     end.
     3454   end procedure.
     3455   define variable v-total-select-num as integer   no-undo .
     3456   define temp-table temp-user-obj no-undo
     3457     field obj-type as character
     3458     field obj-code as integer
     3459     index xpk is primary unique obj-type obj-code
     3460     .
     3461   PROCEDURE userobjs_append :
     3462     define input  parameter p-obj-type as character no-undo .
     3463     define input  parameter p-obj-code as integer   no-undo .
     3464     define buffer buf_temp-user-obj for temp-user-obj .
     3465     do
     3466     on error undo, return error return-value
     3467     :
     3468       find first buf_temp-user-obj
     3469         where buf_temp-user-obj.obj-type = p-obj-type
     3470           and buf_temp-user-obj.obj-code = p-obj-code
     3471         no-error .
     3472       if not available buf_temp-user-obj
     3473       then do:
     3474         create buf_temp-user-obj .
     3475         assign
     3476           buf_temp-user-obj.obj-type = p-obj-type
     3477           buf_temp-user-obj.obj-code = p-obj-code
     3478         .
     3479         assign
     3480           v-total-select-num = v-total-select-num + 1
     3481         .
     3482       end.
     3483     end.
     3484   END PROCEDURE.
     3485   PROCEDURE userobjs_delete :
     3486     define input  parameter p-obj-type as character no-undo .
     3487     define input  parameter p-obj-code as integer   no-undo .
     3488     define buffer buf_temp-user-obj for temp-user-obj .
     3489     do
     3490     on error undo, return error return-value
     3491     :
     3492       find first buf_temp-user-obj
     3493         where buf_temp-user-obj.obj-type = p-obj-type
     3494           and buf_temp-user-obj.obj-code = p-obj-code
     3495         no-error .
     3496       if available buf_temp-user-obj
     3497       then do:
     3498         delete buf_temp-user-obj .
     3499         assign
     3500           v-total-select-num = v-total-select-num - 1
     3501         .
     3502       end.
     3503     end.
     3504   END PROCEDURE.
     3505   PROCEDURE display-select-num :
     3506     do
     3507     on error undo, return error return-value
     3508     :
     3509       assign
     3510         mark-num = v-total-select-num
     3511       .
     3512       display
     3513         mark-num
     3514         with frame Dialog-Frame.
     3515       if v-total-select-num = 0
     3516       then do:
     3517         hide
     3518           mark-num
     3519           in frame Dialog-Frame.
     3520       end.
     3521       else do:
     3522         display
     3523           mark-num
     3524           with frame Dialog-Frame.
     3525       end.
     3526     end.
     3527   END PROCEDURE.
     3528   PROCEDURE check-selection :
     3529     define variable v-ok as logical   no-undo .
     3530     define buffer buf_temp-user-obj for temp-user-obj .
     3531     do
     3532     on error undo, return error return-value
     3533     :
     3534       do with frame Dialog-Frame
     3535       :
     3536         if can-do (p-bttns, "b-mark")
     3537         then do:
     3538           find first buf_temp-user-obj
     3539             no-error .
     3540           if available buf_temp-user-obj
     3541           then do:
     3542             message
     3543               "Информация о выбранных элементах будет потеряна" Skip
     3544               "Продолжить?" Skip
     3545               view-as alert-box question buttons yes-no update v-ok .
     3546             if v-ok = true
     3547             then do:
     3548               for each buf_temp-user-obj
     3549               on error undo, return error return-value
     3550               :
     3551                 delete buf_temp-user-obj .
     3552               end.
     3553             end.
     3554             else do:
     3555               undo, return error return-value .
     3556             end.
     3557           end.
     3558         end.
     3559       end.
     3560     end.
     3561   END PROCEDURE.
     3562   PROCEDURE choose-mark :
     3563     define variable v-log as logical no-undo .
     3564     define buffer buf_temp-user-obj for temp-user-obj .
     3565     do
     3566     on error undo, return error return-value
     3567     :
     3568       if available X_clients
     3569       then do:
     3570         find first buf_temp-user-obj
     3571           where buf_temp-user-obj.obj-type = X_clients.obj-type
     3572             and buf_temp-user-obj.obj-code = X_clients.obj-code
     3573           no-error .
     3574         if available buf_temp-user-obj
     3575         then do:
     3576           run userobjs_delete in this-procedure
     3577             (input  X_clients.obj-type
     3578             ,input  X_clients.obj-code
     3579             ) .
     3580         end.
     3581         else do:
     3582           run userobjs_append in this-procedure
     3583             (input  X_clients.obj-type
     3584             ,input  X_clients.obj-code
     3585             ) .
     3586         end.
     3587         if last-event :function <> "MOUSE-SELECT-DBLCLICK"
     3588         then do:
     3589         end.
     3590         run display-select-num in this-procedure .
     3591       end.
     3592     end.
     3593   END PROCEDURE.
     3594   PROCEDURE choose-select :
     3595     define buffer buf_temp-user-obj for temp-user-obj .
     3596     do
     3597     on error undo, return error return-value
     3598     :
     3599       do with frame Dialog-Frame
     3600       :
     3601         if available X_clients
     3602         then do:
     3603           if NOT can-do (p-bttns, "b-mark")
     3604           then do:
     3605           end.
     3606           else do:
     3607             find first buf_temp-user-obj
     3608               no-error .
     3609             if not available buf_temp-user-obj
     3610             then do:
     3611               run userobjs_append in this-procedure
     3612                 (input  X_clients.obj-type
     3613                 ,input  X_clients.obj-code
     3614                 ) .
     3615             end.
     3616             run userobjs_clear in p-callback-handle .
     3617             for each buf_temp-user-obj
     3618             on error undo, return error return-value
     3619             :
     3620               run userobjs_append in p-callback-handle
     3621                 (input  buf_temp-user-obj.obj-type
     3622                 ,input  buf_temp-user-obj.obj-code
     3623                 ) .
     3624             end.
     3625           end.
     3626         end.
     3627       end.
     3628     end.
     3629   END PROCEDURE.
     3630   PROCEDURE get-mark-string :
     3631     define input  parameter p-obj-type    as character no-undo .
     3632     define input  parameter p-obj-code    as integer   no-undo .
     3633     define output parameter p-mark-string as character no-undo .
     3634     define buffer buf_temp-user-obj for temp-user-obj .
     3635     do
     3636     on error undo, return error return-value
     3637     :
     3638       find first buf_temp-user-obj
     3639         where buf_temp-user-obj.obj-type = p-obj-type
     3640           and buf_temp-user-obj.obj-code = p-obj-code
     3641         no-error .
     3642       if available buf_temp-user-obj
     3643       then do:
     3644         assign
     3645           p-mark-string = '*':U
     3646         .
     3647       end.
     3648       else do:
     3649         assign
     3650           p-mark-string = '':U
     3651         .
     3652       end.
     3653     end.
     3654   END PROCEDURE.
     3655   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3656   on INS of frame Dialog-Frame anywhere do:
