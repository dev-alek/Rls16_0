     1496        SIZE 3 BY 1
     1497        BGCOLOR 8 .
     1498   DEFINE BUTTON B-hist
     1499        LABEL "Ис&тория"
     1500        SIZE 3 BY 1.
     1501   DEFINE BUTTON B-host
