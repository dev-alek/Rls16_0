     2673         (input  (p-new-height - frame Dialog-Frame :height)
     2674         ,input  p-move-resize
     2675         ) .
     2676     end.
     2677   end procedure.
     2678   procedure diasize_change-width :
     2679     define input  parameter p-change-value as decimal   no-undo .
     2680     define input  parameter p-move-resize  as logical   no-undo .
     2681     define variable v-field-group-handle   as handle    no-undo .
