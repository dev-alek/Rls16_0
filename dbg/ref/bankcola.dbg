        1   DEFINE INPUT PARAMETER parParentProc   AS WIDGET-HANDLE  NO-UNDO .
        2   define input parameter p-host-code     AS INTEGER        no-undo .
        3   define input parameter p-code-bank     as integer        no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Создание и изменение банковского атрибута - счета для инкассации".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   define buffer buf_fin-bank-attr for ub.fin-bank-attr .
      116   DEFINE BUTTON b-exit AUTO-GO
      117        LABEL "&Ввод"
      118        SIZE 10 BY 1
      119        BGCOLOR 8 .
      120   DEFINE BUTTON b-help
      121        LABEL "Помо&щь"
      122        SIZE 10 BY 1
      123        BGCOLOR 8 .
      124   DEFINE BUTTON b-quit AUTO-END-KEY
      125        LABEL "&Отмена"
      126        SIZE 10 BY 1
      127        BGCOLOR 8 .
      128   DEFINE VARIABLE v-qr-code AS CHARACTER FORMAT "X(256)":U
      129        LABEL "QR код"
      130        VIEW-AS COMBO-BOX INNER-LINES 2
      131        LIST-ITEM-PAIRS " ","0",
      132                        "Сбербанк","1"
      133        DROP-DOWN-LIST
      134        SIZE 15.25 BY 1 NO-UNDO.
      135   DEFINE VARIABLE v-bank AS CHARACTER FORMAT "X(256)":U
      136         VIEW-AS TEXT
      137        SIZE 60.5 BY .67 NO-UNDO.
      138   DEFINE VARIABLE v-collect-account AS CHARACTER FORMAT "X(256)":U
      139        LABEL "Дебет"
      140        VIEW-AS FILL-IN
      141        SIZE 46.5 BY 1 NO-UNDO.
      142   DEFINE VARIABLE v-credit-account AS CHARACTER FORMAT "X(256)":U
      143        LABEL "Кредит"
      144        VIEW-AS FILL-IN
      145        SIZE 46.5 BY 1 NO-UNDO.
      146   DEFINE VARIABLE v-firm AS CHARACTER FORMAT "X(256)":U
      147         VIEW-AS TEXT
      148        SIZE 60 BY .67 NO-UNDO.
      149   DEFINE FRAME Dialog-Frame
      150        b-exit AT ROW 1 COL 1
      151        b-quit AT ROW 1 COL 11
      152        b-help AT ROW 1 COL 55
      153        v-collect-account AT ROW 5 COL 9 WIDGET-ID 8
      154        v-credit-account AT ROW 6.5 COL 8 WIDGET-ID 10
      155        v-qr-code AT ROW 7.96 COL 14.25 COLON-ALIGNED WIDGET-ID 14
      156        v-firm AT ROW 2.25 COL 1 COLON-ALIGNED NO-LABEL WIDGET-ID 4
      157        v-bank AT ROW 3.25 COL 3 NO-LABEL WIDGET-ID 6
      158        SPACE(1.62) SKIP(5.82)
      159       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      160            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      161            TITLE "Настройки банка-вносителя для инкассации"
      162            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit WIDGET-ID 100.
      163   ASSIGN
      164          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      165          FRAME Dialog-Frame:HIDDEN           = TRUE.
      166   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      167   DO:
      168       APPLY "END-ERROR":U TO SELF.
      169     END.
      170   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      171   DO:
      172       assign
      173         v-collect-account
      174         v-firm
      175         v-bank
      176         v-credit-account
      177         v-QR-code
      178         .
      179       run save-attr in this-procedure no-error.
      180       IF ERROR-STATUS:ERROR THEN
      181       DO:
      182         MESSAGE RETURN-VALUE SKIP
      183           ERROR-STATUS:GET-MESSAGE(1)
      184           VIEW-AS ALERT-BOX.
      185         UNDO, RETURN NO-APPLY.
      186       END.
      187     END.
      188   ON CHOOSE OF b-help IN FRAME Dialog-Frame
      189   OR HELP OF FRAME Dialog-Frame
      190     DO:
      191       MESSAGE "Help for File: c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ref\bankcola.w" VIEW-AS ALERT-BOX INFORMATION.
      192     END.
      193   ON LEAVE OF v-collect-account IN FRAME Dialog-Frame
      194   DO:
      195       assign v-collect-account .
      196     END.
      197   ON LEAVE OF v-credit-account IN FRAME Dialog-Frame
      198   DO:
      199       assign v-credit-account .
      200     END.
      201   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      202     THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      203   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      204   on help of frame Dialog-Frame
      205   do:
      206     run gbl/app_help.p
      207       (input this-procedure :file-name
      208       ,input ''
      209       ,input ?
      210       ) no-error.
      211     if error-status :error then do:
      212       message
      213         "Ошибка при вызове помощи"
      214         error-status :get-message(1)
      215         view-as alert-box .
      216     end.
      217   end.
      218   run minbtn-set in this-procedure .
      219   on choose of b-help in frame Dialog-Frame
      220   do:
      221     apply "help":u to frame Dialog-Frame .
      222   end.
      223   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      224   procedure minbtn-set :
      225       do
      226           on error undo, return error return-value
      227           :
      228           define variable ii              as integer       no-undo .
      229           define variable fh              as widget-handle no-undo .
      230           define variable hh              as widget-handle no-undo .
      231           define variable v-h             as handle        extent 4 no-undo .
      232           define variable v-name-button   as character     no-undo .
      233           define variable v-help-old-x    as decimal       no-undo .
      234           define variable v-help-old-y    as decimal       no-undo .
      235           define variable v-help-old-size as decimal       no-undo .
      236           define variable v-frame-width   as decimal       no-undo .
      237           define variable jj              as integer       no-undo .
      238           do
      239               on error undo, return error
      240               :
      241               assign
      242                   v-frame-width = frame Dialog-Frame:width - 0.3
      243                   fh            = frame Dialog-Frame:first-child
      244                   hh            = fh:first-child
      245                   ii            = 1
      246                   .
      247               do while valid-handle(hh):
      248                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      249                   do:
      250                       case lc(hh:name) :
      251                           when "b-help" then
      252                               do:
      253                                   hh:load-image-up("cmp/b-help.bmp":u) .
      254                                   hh:load-image-down("cmp/b-help.bmp":u) .
      255                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      256                                   hh:TOOLTIP = "Помощь" .
      257                                   v-help-old-x = hh:column .
      258                                   v-help-old-y = hh:row    .
      259                                   v-help-old-size = hh:width .
      260                                   hh:width-chars = 2.5 .
      261                               end.
      262                           when "b-print" then
      263                               do:
      264                                   hh:load-image("cmp/b-print.bmp":u) .
      265                                   hh:TOOLTIP = "Печать" .
      266                                   v-h[ii] = hh:handle .
      267                                   ii = ii + 1 .
      268                                   hh:width-chars = 3 .
      269                               end.
      270                           when "b-history" or
      271                           when "b-hist" then
      272                               do:
      273                                   hh:load-image("cmp/b-hist.bmp":u) .
      274                                   hh:TOOLTIP = "История" .
      275                                   v-h[ii] = hh:handle .
      276                                   ii = ii + 1 .
      277                                   hh:width-chars = 3 .
      278                               end.
      279                           when "b-sch" then
      280                               do:
      281                                   hh:load-image("cmp/b-sch.bmp":u) .
      282                                   hh:TOOLTIP = "Установка Фильтра" .
      283                                   v-h[ii] = hh:handle .
      284                                   ii = ii + 1 .
      285                                   hh:width-chars = 3 .
      286                               end.
      287                           when "b-hist-user" then
      288                               do:
      289                                   hh:load-image("cmp/b-hist.bmp":u) .
      290                                   hh:TOOLTIP = "История пользователя" .
      291                                   ii = ii + 1 .
      292                               end.
      293                       end case.
      294                   end.
      295                   hh = hh:next-sibling.
      296               end.
      297               b-help:column = v-frame-width - b-help:width-chars.
      298               jj = 0.
      299               repeat ii = 4 to 1 by -1 :
      300                   if valid-handle (v-h[ii] ) then
      301                   do:
      302                       jj  = jj + 1 .
      303                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      304                       v-h[ii]:row    = v-help-old-y .
      305                   end.
      306               end.
      307           end.
      308       end.
      309   end procedure.
      310   MAIN-BLOCK:
      311   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      312     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      313     RUN load-attr IN THIS-PROCEDURE.
      314     RUN enable_UI.
      315     APPLY "ENTRY" TO v-collect-account .
      316     APPLY "ENTRY" TO v-credit-account .
      317     APPLY "ENTRY" TO v-QR-code .
      318     WAIT-FOR GO OF FRAME Dialog-Frame.
      319   END.
      320   RUN disable_UI.
      321   PROCEDURE disable_UI :
      322     HIDE FRAME Dialog-Frame.
      323   END PROCEDURE.
      324   PROCEDURE enable_UI :
      325     DISPLAY v-collect-account v-credit-account v-qr-code v-firm v-bank
      326         WITH FRAME Dialog-Frame.
      327     ENABLE b-exit b-quit b-help v-collect-account v-credit-account v-qr-code
      328            v-firm v-bank
      329         WITH FRAME Dialog-Frame.
      330     VIEW FRAME Dialog-Frame.
      331   END PROCEDURE.
      332   PROCEDURE load-attr :
      333     define buffer buf_fin-bank for ub.fin-bank .
      334     define buffer buf_clients  for ub.clients .
      335     DO
      336       ON ERROR UNDO, RETURN ERROR
      337       :
      338       FIND FIRST buf_clients
      339         WHERE buf_clients.obj-type = 'орг':U
      340         AND buf_clients.obj-code = p-host-code
      341         NO-LOCK
      342         NO-ERROR
      343         .
      344       IF NOT AVAILABLE buf_clients
      345         THEN
      346       DO:
      347         RETURN ERROR SUBSTITUTE("Не найдена фирма №&1", p-host-code).
      348       END.
      349       FIND FIRST buf_fin-bank
      350         WHERE buf_fin-bank.host-code = p-host-code
      351         AND buf_fin-bank.code-bank = p-code-bank
      352         NO-LOCK
      353         NO-ERROR
      354         .
      355       IF NOT AVAILABLE buf_clients
      356         THEN
      357       DO:
      358         RETURN ERROR SUBSTITUTE ( "Не найден банк &1 для фирмы &2 &3"
      359           , p-code-bank
      360           , p-host-code
      361           , buf_clients.obj-name
      362           ) .
      363       END.
      364       ASSIGN
      365         v-firm = SUBSTITUTE("Фирма: &1", buf_clients.obj-name)
      366         v-bank = SUBSTITUTE(" Банк: &1", buf_fin-bank.bank-name)
      367         .
      368       FIND FIRST buf_fin-bank-attr
      369         where buf_fin-bank-attr.host-code  = p-host-code
      370         and buf_fin-bank-attr.code-bank  = p-code-bank
      371         and buf_fin-bank-attr.attr-code  = "collect-debt":U
      372         no-lock
      373         no-error
      374         .
      375       IF AVAILABLE buf_fin-bank-attr
      376         THEN
      377       DO:
      378         assign
      379           v-collect-account = buf_fin-bank-attr.attr-value
      380           .
      381       END.
      382       FIND FIRST buf_fin-bank-attr
      383         where buf_fin-bank-attr.host-code  = p-host-code
      384         and buf_fin-bank-attr.code-bank  = p-code-bank
      385         and buf_fin-bank-attr.attr-code  = "collect-credit":U
      386         no-lock
      387         no-error
      388         .
      389       IF AVAILABLE buf_fin-bank-attr
      390         THEN
      391       DO:
      392         assign
      393           v-credit-account = buf_fin-bank-attr.attr-value
      394           .
      395       END.
      396       FIND FIRST buf_fin-bank-attr
      397         where buf_fin-bank-attr.host-code  = p-host-code
      398         and buf_fin-bank-attr.code-bank  = p-code-bank
      399         and buf_fin-bank-attr.attr-code  = "collect-qrcode":U
      400         no-lock
      401         no-error
      402         .
      403       IF AVAILABLE buf_fin-bank-attr
      404         THEN
      405       DO:
      406         assign
      407           v-QR-code = buf_fin-bank-attr.attr-value
      408           .
      409       END.
      410     END.
      411   END PROCEDURE.
      412   PROCEDURE save-attr :
      413     DO
      414       ON ERROR UNDO, RETURN ERROR
      415       :
      416       if v-collect-account <> "" then
      417       do:
      418         FIND first buf_fin-bank-attr EXCLUSIVE-LOCK where
      419           buf_fin-bank-attr.host-code = p-host-code and
      420           buf_fin-bank-attr.code-bank = p-code-bank and
      421           buf_fin-bank-attr.attr-code = "collect-debt":U
      422           no-error.
      423         if not available (buf_fin-bank-attr) then
      424         DO:
      425           CREATE buf_fin-bank-attr.
      426           assign
      427             buf_fin-bank-attr.host-code = p-host-code
      428             buf_fin-bank-attr.code-bank = p-code-bank
      429             buf_fin-bank-attr.attr-code = "collect-debt":U
      430             .
      431         END.
      432         ASSIGN
      433           buf_fin-bank-attr.attr-value = v-collect-account
      434           .
      435       end.
      436       IF v-credit-account <> ""
      437         THEN
      438       DO:
      439         FIND first buf_fin-bank-attr EXCLUSIVE-LOCK where
      440           buf_fin-bank-attr.host-code = p-host-code and
      441           buf_fin-bank-attr.code-bank = p-code-bank and
      442           buf_fin-bank-attr.attr-code = "collect-credit":U
      443           no-error.
      444         if not available (buf_fin-bank-attr) then
      445         DO:
      446           CREATE buf_fin-bank-attr.
      447           assign
      448             buf_fin-bank-attr.host-code = p-host-code
      449             buf_fin-bank-attr.code-bank = p-code-bank
      450             buf_fin-bank-attr.attr-code = "collect-credit":U
      451             .
      452         END.
      453         ASSIGN
      454           buf_fin-bank-attr.attr-value = v-credit-account
      455           .
      456       end.
      457       IF v-QR-code <> ""
      458         THEN
      459       DO:
      460         FIND first buf_fin-bank-attr EXCLUSIVE-LOCK where
      461           buf_fin-bank-attr.host-code = p-host-code and
      462           buf_fin-bank-attr.code-bank = p-code-bank and
      463           buf_fin-bank-attr.attr-code = "collect-qrcode":U
      464           no-error .
      465         if not available (buf_fin-bank-attr) then
      466         do:
      467           CREATE buf_fin-bank-attr.
      468           assign
      469             buf_fin-bank-attr.host-code = p-host-code
      470             buf_fin-bank-attr.code-bank = p-code-bank
      471             buf_fin-bank-attr.attr-code = "collect-qrcode":U
      472             .
      473         END.
      474         ASSIGN
      475           buf_fin-bank-attr.attr-value = v-QR-code
      476           .
      477       end.
      478     END.
      479   END PROCEDURE.
