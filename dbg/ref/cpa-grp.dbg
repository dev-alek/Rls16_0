        1   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        2   define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
        3   define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
        4   define INPUT parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
        5   define INPUT parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
        6   define INPUT parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
        7   DEFINE INPUT-OUTPUT PARAMETER p-attr-value AS character NO-UNDO.
        8   DEFINE OUTPUT PARAMETER p-ok AS logical NO-UNDO.
        9   define variable vss-revision    as character no-undo init "$Revision$":U .
       10   define variable vss-author      as character no-undo init "$Author$":U .
       11   define variable vss-date        as character no-undo init "$Date$":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       13   define variable vss-archive     as character no-undo init "$Archive$":U .
       14   define variable vss-description as character no-undo init "Задание атрибута группа типа кассовых платежей".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   procedure proc-alt-shift-f2:
       76     if not ibs.th.gbl.gbl-var:rcode
       77   then
       78     run gbl\inidebug.p .
       79   end.
       80   procedure proc-alt-shift-f3:
       81     run gbl/prvssinf.p
       82       ( input this-procedure
       83       ) .
       84   end.
       85   define variable v-inform-launched as logical no-undo initial false .
       86   procedure proc-alt-shift-f4:
       87     define variable v-action as character no-undo .
       88     if v-inform-launched = false then do:
       89       assign
       90         v-inform-launched = true
       91       .
       92       run gbl/d-inform.w
       93         (  input self
       94         ,  input this-procedure
       95         , output v-action
       96         ) no-error .
       97       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       98       assign
       99         v-inform-launched = false
      100       .
      101     end.
      102   end.
      103   procedure proc-alt-f1:
      104     run gbl/corrhelp.p
      105       (input this-procedure
      106       ) .
      107   end .
      108   on alt-shift-f2 anywhere do:
      109     run proc-alt-shift-f2.
      110   end.
      111   on alt-shift-f3 anywhere do:
      112     run proc-alt-shift-f3 in this-procedure .
      113   end.
      114   on alt-shift-f4 anywhere do:
      115     run proc-alt-shift-f4 in this-procedure.
      116   end.
      117   on alt-f1 anywhere do:
      118     run proc-alt-f1 in this-procedure .
      119   end.
      120   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      121   define variable v-waitfram-action01         as character   no-undo .
      122   define variable v-waitfram-action02         as character   no-undo .
      123   define variable v-waitfram-action03         as character   no-undo .
      124   define variable mWaitFramTextBeg            as character   no-undo.
      125   define variable mWaitFramTextEnd            as character   no-undo.
      126   define variable mWaitFramView               as logical     no-undo.
      127   define variable mWaitProcEvent              as logical     no-undo init yes.
      128   define variable mWaitFramInterval           as integer     no-undo init 1 .
      129   define variable mWaitFramStop               as logical     no-undo.
      130   define variable mWaitFramStopUser           as logical     no-undo.
      131   define variable mWaitFramStopTimeOut        as logical     no-undo.
      132   define variable mWaitFramStartProc          as datetime-tz no-undo.
      133   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      134   define button B-WaitFramStop auto-end-key
      135        label "Стоп"
      136        size 10 by 1 tooltip "Остоновить процесс".
      137   define button B-viewProcInfo
      138        label "Информация"
      139        size 15 by 1 tooltip "Информация о процесс".
      140   define frame waitfram
      141     v-waitfram-action01 format "x(72)" no-label skip
      142     v-waitfram-action02 format "x(72)" no-label skip
      143     v-waitfram-action03 format "x(72)" no-label skip
      144     B-viewProcInfo
      145     B-WaitFramStop at row 4 col 30
      146     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      147     .
      148   define new global shared variable mBatchMode as logical no-undo init ?.
      149   define variable mFramBachModHandle as handle no-undo.
      150   mFramBachModHandle = frame waitfram:handle.
      151   define variable mFameOldVis as logical no-undo.
      152   define variable mVisCUrentVin as logical no-undo.
      153   if session:batch-mode
      154   then
      155      mBatchMode = yes.
      156   if mBatchMode = ? then do:
      157     mVisCUrentVin = current-window:visible.
      158     mFameOldVis = mFramBachModHandle:visible.
      159     mFramBachModHandle:visible  = yes.
      160     mBatchMode = mFramBachModHandle:visible ne yes.
      161     mFramBachModHandle:visible = mFameOldVis.
      162     current-window:visible = mVisCUrentVin.
      163   end.
      164    if  log-manager:logfile-name ne ?
      165     then DO:
      166         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      167         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      168         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      169     end.
      170   on choose of B-WaitFramStop in frame waitfram
      171   do:
      172     mWaitFramStop = yes.
      173     mWaitFramStopUser = yes.
      174   end.
      175   function waitfram-check-timeout returns logical():
      176      define variable vtime as int64 no-undo.
      177      if mWaitFramStopTimeOut
      178      then
      179         return yes.
      180      vtime = ( now - mWaitFramStartProc ) / 1000 .
      181      if     mWaitFramTimeOut ne ?
      182         and mWaitFramTimeOut ne 0
      183         and mWaitFramTimeOut lt vtime
      184      then do:
      185         mWaitFramStopTimeOut = yes.
      186      end.
      187      return mWaitFramStopTimeOut.
      188   end.
      189   procedure waitfram-hide :
      190     if not session:batch-mode
      191     then do
      192     on error undo, return error return-value
      193     :
      194       pause 0 before-hide .
      195       if not mBatchMode then
      196         hide frame waitfram .
      197     if     not mWaitFramView
      198        and mWaitProcEvent
      199     then
      200       process events .
      201     end.
      202   end procedure.
      203   procedure waitfram-show :
      204     define input  parameter p-message as character no-undo .
      205     define variable v-left-margin as integer   no-undo .
      206     if not session:batch-mode
      207     then do
      208     on error undo, return error return-value
      209     :
      210       if length(p-message) <= 70 then do:
      211         assign
      212           v-left-margin = integer((70 - length(p-message)) / 2)
      213         .
      214         assign
      215           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      216         .
      217         assign
      218           v-waitfram-action01 = " "
      219           v-waitfram-action02 = " "
      220                                    + fill(" ", v-left-margin)
      221                                    + p-message
      222           v-waitfram-action03 = " "
      223         .
      224       end.
      225       else do:
      226         define variable vRindex1 as integer no-undo.
      227         define variable vRindex2 as integer no-undo.
      228         vRindex1 = r-index(p-message," ",70).
      229         if vRindex1 = 0
      230         then
      231            vRindex1 = 70.
      232         if length(p-message)  <= vRindex1 + 70 then do:
      233           assign
      234             v-waitfram-action01 = " "
      235             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      236             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      237           .
      238         end.
      239         else do:
      240           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      241           if vRindex2 <= vRindex1
      242           then
      243              vRindex2 = vRindex1 + 70.
      244           assign
      245             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      246             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      247             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      248           .
      249         end.
      250       end.
      251       B-viewProcInfo:visible   in frame waitfram = no.
      252       B-viewProcInfo:sensitive in frame waitfram = no.
      253       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      254       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      255       if  (   mWaitFramView
      256          or  mWaitProcEvent)
      257          and not mBatchMode
      258       then
      259          display
      260             v-waitfram-action01 skip
      261             v-waitfram-action02 skip
      262             v-waitfram-action03 skip
      263          with frame waitfram .
      264       if     mWaitFramView
      265          then do:
      266             if     mWaitFramInterval ne ?
      267                and not mBatchMode
      268             then
      269                wait-for go of frame waitfram pause mWaitFramInterval.
      270          end.
      271          else
      272             if     mWaitProcEvent
      273                and not mBatchMode
      274             then
      275                process events .
      276     end.
      277   end procedure.
      278      procedure waitfram-show-this:
      279         define input  parameter iInterval as int64 no-undo.
      280         define variable vtime as int64 no-undo.
      281         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      282         mWaitFramInterval = iInterval.
      283         run waitfram-show (substitute("&1&2 &3&4" ,
      284                                       mWaitFramTextBeg ,
      285                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      286                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      287                                       mWaitFramTextEnd
      288                                      )
      289                           ).
      290      end.
      291      procedure WaitFramRunPause:
      292         define input  parameter iInterval as dec no-undo.
      293         define variable vStart  as datetime-tz no-undo.
      294         define variable vend    as datetime-tz no-undo.
      295         define variable vint as int64 no-undo.
      296         define variable vOk as logical no-undo.
      297         vStart = now.
      298         vend   = vStart.
      299         publish "WaitFramPause" (iInterval,output vOk).
      300         vend   =  now.
      301         vint = vend - vStart.
      302         vint = iInterval - vint / 1000.
      303         if     not mWaitFramStop
      304            and (   vint > 0
      305                 or (    not vOk
      306                     and iInterval eq ?
      307                     )
      308                 )
      309         then
      310            run waitfram-show-this (iInterval).
      311         vend   =  now.
      312         vint = vend - vStart.
      313         vint = iInterval - vint / 1000.
      314         if     not mWaitFramStop
      315            and vint > 0
      316         then do:
      317            run gbl/pause.p (vint * 1000).
      318         end.
      319         if iInterval ne ?
      320         then
      321            publish "WaitFramStop".
      322         waitfram-check-timeout().
      323      end.
      324      procedure WaitFramWaitFor:
      325         define input  parameter iInterval as dec no-undo.
      326         assign
      327            mWaitFramStartProc   = now
      328            mWaitFramStopUser    = no
      329            mWaitFramStopTimeOut = no
      330         .
      331         block-wait:
      332         do while not mWaitFramStop:
      333            run WaitFramRunPause (iInterval).
      334            if  waitfram-check-timeout()
      335            then do:
      336               leave block-wait.
      337            end.
      338         end.
      339         run waitfram-hide.
      340      end.
      341   procedure waitfram-join :
      342     define input  parameter p-line-1  as character no-undo .
      343     define input  parameter p-line-2  as character no-undo .
      344     define input  parameter p-line-3  as character no-undo .
      345     define output parameter p-message as character no-undo .
      346     do
      347     on error undo, return error return-value
      348     :
      349       assign
      350         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      351                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      352                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      353       .
      354     end.
      355   end procedure.
      356   function waitfram-join-function returns character
      357     (input p-line-1 as character
      358     ,input p-line-2 as character
      359     ,input p-line-3 as character
      360     ).
      361     define variable v-message as character no-undo .
      362     run waitfram-join in this-procedure
      363       (input  p-line-1
      364       ,input  p-line-2
      365       ,input  p-line-3
      366       ,output v-message
      367       ) .
      368     return v-message .
      369   end function .
      370   DEFINE VARIABLE v-obj-db-num LIKE ub.db.db-num NO-UNDO.
      371   define variable cpgrpnam as character no-undo .
      372   DEFINE VARIABLE v-dops AS CHARACTER NO-UNDO.
      373   DEFINE VARIABLE v-dopi AS INTEGER NO-UNDO.
      374   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
      375   DEFINE VARIABLE v-ok AS LOGICAL NO-UNDO.
      376   define variable v-param-type as character no-undo .
      377   define variable v-value-character as character no-undo .
      378   define variable v-value-date as date no-undo .
      379   define variable v-value-decimal as decimal no-undo .
      380   define variable v-value-integer as INTEGER no-undo .
      381   define variable v-value-logical AS LOGICAL no-undo .
      382   define variable v-tth as handle no-undo .
      383   DEFINE BUTTON B-exit AUTO-GO
      384        LABEL "&Ввод"
      385        SIZE 10 BY 1
      386        BGCOLOR 8 .
      387   DEFINE BUTTON B-Help
      388        LABEL "Помо&щь"
      389        SIZE 10 BY 1
      390        BGCOLOR 8 .
      391   DEFINE BUTTON b-quit AUTO-END-KEY
      392        LABEL "&Отмена"
      393        SIZE 10 BY 1
      394        BGCOLOR 8 .
      395   DEFINE VARIABLE f-grp-code AS INTEGER FORMAT ">>>9":U INITIAL 0
      396        LABEL "Код группы"
      397        VIEW-AS FILL-IN
      398        SIZE 8 BY 1 NO-UNDO.
      399   DEFINE VARIABLE S-grp-name AS CHARACTER
      400        VIEW-AS SELECTION-LIST SINGLE SCROLLBAR-VERTICAL
      401        SIZE 26 BY 5.25 NO-UNDO.
      402   DEFINE FRAME Dialog-Frame
      403        B-exit AT ROW 1 COL 1
      404        b-quit AT ROW 1 COL 11
      405        B-Help AT ROW 1 COL 54.88
      406        S-grp-name AT ROW 2.5 COL 21 NO-LABEL
      407        f-grp-code AT ROW 8 COL 19 COLON-ALIGNED
      408        SPACE(39.74) SKIP(1.57)
      409       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      410            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      411            TITLE "Группа типа кассового платежа"
      412            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      413   ASSIGN
      414          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      415          FRAME Dialog-Frame:HIDDEN           = TRUE.
      416   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      417   DO:
      418     APPLY "END-ERROR":U TO SELF.
      419   END.
      420   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      421   DO:
      422     ASSIGN
      423     s-grp-name.
      424     f-grp-code = INTEGER(s-grp-name).
      425     RUN proc-save IN THIS-PROCEDURE(s-grp-name:LOOKUP(s-grp-name)) NO-ERROR.
      426     IF ERROR-STATUS:ERROR THEN DO:
      427         RETURN NO-APPLY.
      428     END.
      429   END.
      430   ON VALUE-CHANGED OF S-grp-name IN FRAME Dialog-Frame
      431   DO:
      432     ASSIGN
      433     s-grp-name.
      434     f-grp-code = INTEGER(s-grp-name).
      435     DISPLAY f-grp-code
      436     WITH FRAME Dialog-Frame.
      437   END.
      438   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      439   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      440   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      441   on help of frame Dialog-Frame
      442   do:
      443     run gbl/app_help.p
      444       (input this-procedure :file-name
      445       ,input ''
      446       ,input ?
      447       ) no-error.
      448     if error-status :error then do:
      449       message
      450         "Ошибка при вызове помощи"
      451         error-status :get-message(1)
      452         view-as alert-box .
      453     end.
      454   end.
      455   run minbtn-set in this-procedure .
      456   on choose of b-help in frame Dialog-Frame
      457   do:
      458     apply "help":u to frame Dialog-Frame .
      459   end.
      460   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      461   procedure minbtn-set :
      462       do
      463           on error undo, return error return-value
      464           :
      465           define variable ii              as integer       no-undo .
      466           define variable fh              as widget-handle no-undo .
      467           define variable hh              as widget-handle no-undo .
      468           define variable v-h             as handle        extent 4 no-undo .
      469           define variable v-name-button   as character     no-undo .
      470           define variable v-help-old-x    as decimal       no-undo .
      471           define variable v-help-old-y    as decimal       no-undo .
      472           define variable v-help-old-size as decimal       no-undo .
      473           define variable v-frame-width   as decimal       no-undo .
      474           define variable jj              as integer       no-undo .
      475           do
      476               on error undo, return error
      477               :
      478               assign
      479                   v-frame-width = frame Dialog-Frame:width - 0.3
      480                   fh            = frame Dialog-Frame:first-child
      481                   hh            = fh:first-child
      482                   ii            = 1
      483                   .
      484               do while valid-handle(hh):
      485                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      486                   do:
      487                       case lc(hh:name) :
      488                           when "b-help" then
      489                               do:
      490                                   hh:load-image-up("cmp/b-help.bmp":u) .
      491                                   hh:load-image-down("cmp/b-help.bmp":u) .
      492                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      493                                   hh:TOOLTIP = "Помощь" .
      494                                   v-help-old-x = hh:column .
      495                                   v-help-old-y = hh:row    .
      496                                   v-help-old-size = hh:width .
      497                                   hh:width-chars = 2.5 .
      498                               end.
      499                           when "b-print" then
      500                               do:
      501                                   hh:load-image("cmp/b-print.bmp":u) .
      502                                   hh:TOOLTIP = "Печать" .
      503                                   v-h[ii] = hh:handle .
      504                                   ii = ii + 1 .
      505                                   hh:width-chars = 3 .
      506                               end.
      507                           when "b-history" or
      508                           when "b-hist" then
      509                               do:
      510                                   hh:load-image("cmp/b-hist.bmp":u) .
      511                                   hh:TOOLTIP = "История" .
      512                                   v-h[ii] = hh:handle .
      513                                   ii = ii + 1 .
      514                                   hh:width-chars = 3 .
      515                               end.
      516                           when "b-sch" then
      517                               do:
      518                                   hh:load-image("cmp/b-sch.bmp":u) .
      519                                   hh:TOOLTIP = "Установка Фильтра" .
      520                                   v-h[ii] = hh:handle .
      521                                   ii = ii + 1 .
      522                                   hh:width-chars = 3 .
      523                               end.
      524                           when "b-hist-user" then
      525                               do:
      526                                   hh:load-image("cmp/b-hist.bmp":u) .
      527                                   hh:TOOLTIP = "История пользователя" .
      528                                   ii = ii + 1 .
      529                               end.
      530                       end case.
      531                   end.
      532                   hh = hh:next-sibling.
      533               end.
      534               b-help:column = v-frame-width - b-help:width-chars.
      535               jj = 0.
      536               repeat ii = 4 to 1 by -1 :
      537                   if valid-handle (v-h[ii] ) then
      538                   do:
      539                       jj  = jj + 1 .
      540                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      541                       v-h[ii]:row    = v-help-old-y .
      542                   end.
      543               end.
      544           end.
      545       end.
      546   end procedure.
      547   MAIN-BLOCK:
      548   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      549      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      550     run adm/shattri.p (
      551         input "get":U
      552       ,input  '':U
      553       ,input  0
      554       ,input  'cashpays':U
      555       ,input  'cpgrpnam':U
      556       ,output cpgrpnam
      557       ,output v-value-date
      558       ,output v-value-decimal
      559       ,output v-value-integer
      560       ,output v-value-integer
      561       ,output v-param-type
      562       ,INPUT-OUTPUT table-handle v-tth
      563       ) no-error .
      564     delete object v-tth.
      565     if cpgrpnam = '':U then do:
      566       MESSAGE
      567       "Неверное значение настроечного параметра" SKIP
      568       "(Группа меню АДМИНИСТРАТОР-ГЛОБАЛЬНЫЕ НАСТРОЙКИ-ДРУГИЕ ПАРАМЕТРЫ-Набор опций для работы со справочником типов кассовых платежей"
      569       "Невозможно изменить или добавить атрибут"
      570       VIEW-AS ALERT-BOX ERROR.
      571       UNDO main-block, RETURN ERROR.
      572     end.
      573     DO ii = 1 TO NUM-ENTRIES(cpgrpnam) by 2:
      574         ASSIGN
      575         v-dops = ENTRY(ii, cpgrpnam)
      576         v-dopi = integer(ENTRY(ii + 1, cpgrpnam))
      577         NO-ERROR.
      578         IF ERROR-STATUS:ERROR
      579         or v-dopi = 0
      580         or v-dopi >= 10000
      581         THEN DO:
      582             MESSAGE
      583             "Неверное значение настроечного параметра" SKIP
      584             "(Группа меню АДМИНИСТРАТОР-ГЛОБАЛЬНЫЕ НАСТРОЙКИ-ДРУГИЕ ПАРАМЕТРЫ-Набор опций для работы со справочником типов кассовых платежей"
      585             "четные элементы списка должны быть положительными целыми числами < 10000" SKIP
      586             "Невозможно изменить или добавить атрибут"
      587             VIEW-AS ALERT-BOX ERROR.
      588             UNDO main-block, RETURN ERROR.
      589         END.
      590     END.
      591     RUN Myenable.
      592     WAIT-FOR GO OF FRAME Dialog-Frame.
      593   END.
      594   RUN disable_UI.
      595   PROCEDURE disable_UI :
      596     HIDE FRAME Dialog-Frame.
      597   END PROCEDURE.
      598   PROCEDURE enable_UI :
      599     DISPLAY S-grp-name f-grp-code
      600         WITH FRAME Dialog-Frame.
      601     ENABLE B-exit b-quit B-Help S-grp-name
      602         WITH FRAME Dialog-Frame.
      603     VIEW FRAME Dialog-Frame.
      604   END PROCEDURE.
      605   PROCEDURE MyEnable :
      606   DEFINE VARIABLE v-dops AS CHARACTER NO-UNDO.
      607   DEFINE VARIABLE v-dopi AS INTEGER NO-UNDO.
      608   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
      609   DEFINE VARIABLE v-ok AS LOGICAL NO-UNDO.
      610   s-grp-name:LIST-ITEM-pairs IN FRAME Dialog-Frame = cpgrpnam.
      611   if p-attr-value = '':U THEN DO:
      612       ASSIGN
      613       s-grp-name = ENTRY(2, cpgrpnam)
      614       f-grp-code = INTEGER(ENTRY(2, cpgrpnam))
      615       .
      616   END.
      617   ELSE do:
      618      ASSIGN
      619       v-dops = ENTRY(2, p-attr-value, chr(4))
      620       v-dopi = INTEGER(ENTRY(2, p-attr-value, chr(4)))
      621       NO-ERROR
      622       .
      623       IF ERROR-STATUS:ERROR  THEN DO:
      624          MESSAGE
      625          substitute("Неверное старое значение атрибута &1") SKIP
      626          "Необходимо переустановить атрибут"
      627          VIEW-AS ALERT-BOX WARNING.
      628          ASSIGN
      629           s-grp-name = ENTRY(1, cpgrpnam)
      630           f-grp-code = INTEGER(ENTRY(2, cpgrpnam))
      631           .
      632       END.
      633       DO ii = 1 TO NUM-ENTRIES(cpgrpnam)  by 2:
      634           IF v-dops = ENTRY(ii + 1, cpgrpnam)
      635           AND v-dopi = integer(ENTRY(ii + 1, cpgrpnam)) THEN DO:
      636               v-ok = YES.
      637           END.
      638       END.
      639       IF NOT v-ok  THEN DO:
      640           MESSAGE
      641           substitute("Неверное старое значение атрибута &1", p-attr-value) SKIP
      642           "Оно не соответствует списку разрешенныз названий и  кодов групп типов кассовых платежей" SKIP
      643           "(настроечный параметр cpgrpnam)" skip
      644           "Необходимо переустановить атрибут" SKIP
      645           VIEW-AS ALERT-BOX WARNING.
      646           ASSIGN
      647            s-grp-name = ENTRY(2, cpgrpnam)
      648            f-grp-code = INTEGER(ENTRY(2, cpgrpnam))
      649            .
      650       END.
      651   END.
      652   DISPLAY
      653   s-grp-name
      654   f-grp-code
      655   WITH FRAME Dialog-Frame.
      656   ENABLE
      657   B-exit
      658   b-quit
      659   B-Help
      660   s-grp-name
      661   WITH FRAME Dialog-Frame.
      662   VIEW FRAME Dialog-Frame.
      663   END PROCEDURE.
      664   PROCEDURE proc-save :
      665   DEFINE INPUT parameter p-item AS INTEGER NO-UNDO.
      666   DEFINE VARIABLE v-dop AS character NO-UNDO.
      667   ASSIGN
      668   FRAME Dialog-Frame
      669   s-grp-name
      670   .
      671   IF f-grp-code = 0  THEN DO:
      672       MESSAGE
      673       "Нельзя ввести код, группы равный 0"
      674       VIEW-AS ALERT-BOX.
      675   END.
      676   v-dop  = entry(p-item * 2 - 1, s-grp-name:LIST-ITEM-PAIRS).
      677   IF v-dop = '':U  THEN DO:
      678       MESSAGE
      679       "Нельзя ввести пустое название группы"
      680       VIEW-AS ALERT-BOX.
      681   END.
      682   ASSIGN
      683   p-attr-value = v-dop + chr(4) + STRING(f-grp-code)
      684   p-ok = yes
      685   .
      686   END PROCEDURE.
