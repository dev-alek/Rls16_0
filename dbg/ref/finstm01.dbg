        1   block-level on error undo, throw.
        2   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        3   define input parameter p-mode as character no-undo .
        4   define input parameter p-close-mode as character no-undo .
        5   define input parameter p-host-code           like ub.fin-statement.host-code            no-undo . define input parameter p-sttm-code           like ub.fin-statement.sttm-code            no-undo . define input parameter p-curr-code           like ub.fin-statement.curr-code            no-undo . define input parameter p-doc-date            like ub.fin-statement.doc-date             no-undo . define input parameter p-bank-date           like ub.fin-statement.doc-date             no-undo . define input parameter p-fact-date           like ub.fin-statement.fact-date            no-undo . define input parameter p-fins-doc-type       like ub.fin-statement.fins-doc-type        no-undo . define input parameter p-fins-ext-doc-type   like ub.fin-statement.fins-ext-doc-type    no-undo . define input parameter p-code-bank           like ub.fin-statement.code-bank            no-undo . define input parameter p-bank-name           like ub.fin-statement.bank-name            no-undo . define input parameter p-bank-city           like ub.fin-statement.bank-city            no-undo . define input parameter p-bik                 like ub.fin-statement.bik                  no-undo . define input parameter p-code-schet          like ub.fin-statement.code-schet           no-undo . define input parameter p-r-schet             like ub.fin-statement.r-schet              no-undo . define input parameter p-c-schet             like ub.fin-statement.c-schet              no-undo . define input parameter p-cli-name            like ub.fin-statement.cli-name             no-undo . define input parameter p-prn-doc-code        like ub.fin-statement.prn-doc-code         no-undo . define input parameter p-PS                  like ub.fin-statement.PS                   no-undo . define input parameter p-sum-doc             like ub.fin-statement.sum-doc              no-undo . define input parameter p-start-sum-doc-th    like ub.fin-statement.start-sum-doc-th     no-undo . define input parameter p-start-sum-doc       like ub.fin-statement.start-sum-doc        no-undo . define input parameter p-in-sum-doc          like ub.fin-statement.in-sum-doc           no-undo . define input parameter p-out-sum-doc         like ub.fin-statement.out-sum-doc          no-undo . define input parameter p-end-sum-doc         like ub.fin-statement.end-sum-doc          no-undo . define input parameter p-num-docs            like ub.fin-statement.num-docs             no-undo . define input parameter p-start-date          like ub.fin-statement.start-date           no-undo . define input parameter p-end-date            like ub.fin-statement.end-date             no-undo .
        6   define input parameter p-status_ like ub.fin-statement.status_ no-undo .
        7   define input parameter p-status-date like ub.fin-statement.doc-date no-undo .
        8   define output parameter p-correct as logical no-undo .
        9   define output parameter p-err-mess as character no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       11   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       12   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile: finstm01.p $":U .
       14   define variable vss-archive     as character no-undo init "$Archive: ref/finstm01.p $":U .
       15   define variable vss-description as character no-undo init "Проверка выписки типа standard-sttm".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       77   define variable v-dopi as integer no-undo .
       78   define variable v-reason as character no-undo .
       79   define variable v-author as character no-undo .
       80   define buffer buf_fin-statement for ub.fin-statement.
       81   define buffer buf_sysconf for ub.sysconf.
       82   procedure standard-sttm-gen :
       83   define input parameter p-close-mode as character no-undo .
       84   define output parameter p-correct as logical no-undo .
       85   define variable accum-in-rubl as decimal no-undo .
       86   define variable accum-in-base as decimal no-undo .
       87   define variable accum-in-doc as decimal no-undo .
       88   define variable accum-out-rubl as decimal no-undo .
       89   define variable accum-out-base as decimal no-undo .
       90   define variable accum-out-doc as decimal no-undo .
       91   define buffer buf_fin-statement-line for ub.fin-statement-line.
       92   do
       93   on error undo, return error
       94   :
       95     find first buf_sysconf no-lock where
       96               buf_sysconf.host-code = p-host-code .
       97     if p-status_ = 'факт':U then do:
       98       if p-prn-doc-code = "":U then do:
       99         assign
      100         p-err-mess = "Не заполнен номер выписки"
      101         .
      102         return "prn-doc-code":U.
      103       end.
      104     end.
      105     if v-author = 'cl-bank':U
      106     then do:
      107       if p-bik = "":U then do:
      108         assign
      109         p-err-mess = "Не заполнен БИК БАНКА"
      110         .
      111             message p-err-mess skip
      112                 "Закрывать выписку ? "
      113                 view-as alert-box question
      114                 buttons yes-no
      115                 title "ВНИМАНИЕ !!!"
      116                 update v-ok3 as logical.
      117             if not v-ok3 then do:
      118                return "bik":U.
      119             end.
      120       end.
      121       if p-r-schet = "":U then do:
      122         assign
      123         p-err-mess = "Не заполнен р/с БАНКА"
      124         .
      125         return "r-schet":U.
      126       end.
      127       if p-bank-name = "":U then do:
      128         assign
      129         p-err-mess = "Не заполнен банк"
      130         .
      131         return "bank-name":U.
      132       end.
      133     end.
      134     if p-close-mode = '<закрытие документа>':U
      135     then do:
      136       if (p-fact-date <> ? and p-doc-date > p-fact-date)
      137       or (p-status-date <> ? and p-doc-date > p-status-date and (p-status_ = 'факт':U))
      138         then do:
      139         assign
      140         p-err-mess = "Дата факт не может быть меньше даты составления выписки".
      141         return "fact-date":U.
      142       end.
      143       if (p-fact-date <> ? and p-bank-date > p-fact-date)
      144       or (p-status-date <> ? and p-bank-date > p-status-date and (p-status_ = 'факт':U))
      145         then do:
      146         assign
      147         p-err-mess = "Дата факт не может быть меньше даты прохождения выписки в банке".
      148         return "fact-date":U.
      149       end.
      150       if p-bank-date <> ? and (p-end-date > p-bank-date)
      151       or (p-status-date <> ? and p-end-date > p-status-date and (p-status_ = 'факт':U))
      152       then do:
      153         assign
      154         p-err-mess = "Дата прохождения выписка в банке не может быть меньше даты конца выписки".
      155         return "bank-date":U.
      156       end.
      157       if p-fact-date <> ? and (p-end-date > p-fact-date)
      158       or (p-status-date <> ? and p-end-date > p-status-date and (p-status_ = 'факт':U))
      159       then do:
      160         assign
      161         p-err-mess = "Дата факт не может быть меньше даты конца выписки".
      162         return "fact-date":U.
      163       end.
      164     end.
      165     assign
      166     p-correct = yes
      167     .
      168     for each buf_fin-statement-line no-lock where
      169             buf_fin-statement-line.host-code = p-host-code
      170         AND buf_fin-statement-line.sttm-code = p-sttm-code
      171         AND buf_fin-statement-line.fin-doc-code > 0
      172         :
      173       assign
      174       accum-in-doc  = accum-in-doc    + (if buf_fin-statement-line.fin-ext-doc-type = 'ппп':U
      175                                         then buf_fin-statement-line.sum-doc
      176                                         else 0)
      177       accum-out-doc  = accum-out-doc  + (if buf_fin-statement-line.fin-ext-doc-type = 'рпп':U
      178                                         then buf_fin-statement-line.sum-doc
      179                                         else 0)
      180       .
      181     end.
      182     if accum-in-doc > p-in-sum-doc
      183     then do:
      184       assign
      185       p-err-mess = "Сумма по приходным документам выписки в TH больше суммы приходов в выписке по данным банка".
      186       return "in-sum-doc":U.
      187     end.
      188     if accum-out-doc > p-out-sum-doc
      189     then do:
      190       p-err-mess = "Сумма по расходным документам выписки в TH больше суммы расходов в выписке по данным банка".
      191       return "out-sum-doc":U .
      192     end.
      193     if p-in-sum-doc - p-out-sum-doc <> p-sum-doc then do:
      194       p-err-mess = "Суммы приходных и расходных оборотов не равны общей сумме обротов по данным банка".
      195       return  "":U .
      196     end.
      197     if p-start-sum-doc  + p-in-sum-doc - p-out-sum-doc <> p-end-sum-doc then do:
      198       p-err-mess = "Суммы приходных и расходных оборотов, сложенных с суммой входящего остатка не равны исходящему остатку в выписке по данным банка".
      199       return "":U .
      200     end.
      201   end.
      202   end procedure.
      203   do
      204   on error undo, return error
      205   :
      206     assign
      207     v-author = (if num-entries(p-mode, chr(4)) > 1
      208               then entry(2, p-mode, chr(4))
      209               else '':U)
      210     p-mode = entry(1, p-mode, chr(4))
      211     .
      212     run standard-sttm-gen in this-procedure ( input p-close-mode, output p-correct) no-error .
      213     if error-status:error then do:
      214       return "Ошибка в процедуре проверки валидности выписки".
      215     end.
      216     else do:
      217       if p-correct = no then return return-value.
      218     end.
      219     assign
      220     p-correct = yes
      221     .
      222   end.
