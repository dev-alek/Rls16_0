        1   block-level on error undo, throw.
        2   DEFINE INPUT PARAMETER parnode-code like ub.gds-grp.node-code no-undo.
        3   DEFINE INPUT PARAMETER parupper-code like ub.gds-grp.node-code no-undo.
        4   define input parameter parhost-code like ub.sysconf.host-code no-undo .
        5   define input parameter parobj-type like ub.clients.obj-type no-undo .
        6   define input parameter parobj-code like ub.clients.obj-code no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: dtaxgrps.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: ref/dtaxgrps.p $":U .
       12   define variable vss-description as character no-undo init "Заполнение полей временной таблицы tt-tax для группы товаров".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67     define SHARED temp-table  tt-tax no-undo
       68   field tax-code    like ub.tax.tax-code
       69   FIELD individual  like ub.tax.individual
       70   FIELD tax-name    like ub.tax.tax-name format "X(12)" column-label "Налог"
       71   field rate-code   like ub.tax-rate.rate-code
       72   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
       73   FIELD tax-type    like ub.tax.tax-type
       74   field rate-value  like ub.tax-rate-value.rate-value
       75   FIELD tax-rate-gds-rc  as recid
       76   FIELD to-cashdesk like ub.tax.to-cashdesk
       77   FIELD fact-date like ub.tax-rate-value.fact-date
       78   FIELD fact-order like ub.tax-rate-value.fact-order
       79   FIELD next-order like ub.tax-rate-value.fact-order
       80   FIELD corr-user-name like ub.tax-rate-gds.corr-user-name
       81   FIELD corr-user-db-num   like ub.tax-rate-gds.corr-user-db-num
       82   FIELD corr-date like ub.tax-rate-gds.corr-date
       83   FIELD corr-time like ub.tax-rate-gds.corr-time
       84   index tax-code is unique primary tax-code fact-order descending rate-code.
       85   define new global shared variable g#language as character no-undo .
       86   if g#language <> '' and g#language <> 'rus':U then do:
       87     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       88   end.
       89   define new global shared variable g#library  as handle no-undo .
       90   define new global shared variable g#library2 as handle no-undo .
       91   define   shared variable g#auto as logical no-undo.
       92   define   shared variable g#news as logical no-undo.
       93   define   shared variable g#oxml as logical no-undo.
       94   define   shared variable g#esys as logical no-undo.
       95   define   shared variable g#news-source-db as integer no-undo.
       96   define   shared variable g#esys-source-esys as integer no-undo.
       97   define   shared variable g#db-num as integer   no-undo .
       98   define   shared variable g#userid as character no-undo .
       99   define   shared variable g#passwd as character no-undo .
      100   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      101   procedure factord :
      102     define input  parameter p-fact-date            as date    no-undo .
      103     define input  parameter p-fact-time            as integer no-undo .
      104     define input  parameter p-fact-num             as integer no-undo .
      105     define input  parameter p-shift-date           as date    no-undo .
      106     define input  parameter p-shift-num            as integer no-undo .
      107     define input  parameter p-shift-on             as logical no-undo .
      108     define output parameter p-fact-order           as decimal no-undo .
      109     define output parameter p-shift-end-fact-order as decimal no-undo .
      110     define output parameter p-day-end-fact-order   as decimal no-undo .
      111     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      112     if p-fact-date = ?
      113     then do:
      114       return error "Не указана фактическая дата" .
      115     end.
      116     define variable v-fact-date-num as integer no-undo .
      117     assign
      118       v-fact-date-num = integer(p-fact-date)
      119     .
      120     if p-fact-num = ?
      121     or p-fact-num = 0
      122     then do:
      123       return error "Не задан p-fact-num " + string(p-fact-num) .
      124     end.
      125     if p-fact-num < 0
      126     then do:
      127       return error "Отрицательный fact-num " + string(p-fact-num) .
      128     end.
      129     if p-fact-num >= 100000000
      130     then do:
      131       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      132     end.
      133     if p-shift-on = true
      134     then do:
      135       if p-shift-date = ?
      136       then do:
      137         return error "Не задана дата смены" .
      138       end.
      139       if p-shift-num = ?
      140       or p-shift-num = 0
      141       then do:
      142         return error "Не задан номер смены" .
      143       end.
      144     end.
      145     else do:
      146       assign
      147         p-shift-date = p-fact-date
      148         p-shift-num  = 24
      149       .
      150     end.
      151     define variable v-shift-offset as integer no-undo .
      152     if p-shift-date = p-fact-date
      153     then do:
      154       assign
      155         v-shift-offset = 1
      156       .
      157     end.
      158     if p-shift-date < p-fact-date
      159     then do:
      160       assign
      161         v-shift-offset = 0
      162       .
      163     end.
      164     if p-shift-date > p-fact-date
      165     then do:
      166       message
      167         vss-workfile vss-revision vss-description skip
      168         "Неправильная дата закрытия смены" skip
      169         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      170         view-as alert-box error .
      171       undo, return error
      172         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      173           ,string(p-fact-date, '99/99/9999':U)
      174           ,string(p-shift-date, '99/99/9999':U)
      175           )
      176       .
      177     end.
      178     if p-shift-num < 1
      179     or p-shift-num > 24
      180     then do:
      181       message
      182         vss-workfile vss-revision vss-description skip
      183         "Неправильный номер смены" skip
      184         "p-shift-num" p-shift-num skip
      185         view-as alert-box error .
      186       undo, return error return-value .
      187     end.
      188     assign
      189       p-fact-order           = v-fact-date-num
      190                              + v-shift-offset * 0.5
      191                              + p-shift-num    * 0.02 - 0.01
      192                              + p-fact-num     * 0.0000000001
      193       p-shift-end-fact-order = v-fact-date-num
      194                              + v-shift-offset * 0.5
      195                              + p-shift-num    * 0.02
      196       p-day-end-fact-order   = v-fact-date-num
      197                              + 0.99
      198     .
      199     if p-fact-order           <= v-fact-date-num
      200     or p-shift-end-fact-order <= v-fact-date-num
      201     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      202     or p-shift-end-fact-order >= p-day-end-fact-order
      203     then do:
      204       message
      205         vss-workfile vss-revision vss-description skip
      206         "Внутренняя ошибка при генерации фактического номера" skip
      207         "p-fact-date"            p-fact-date            skip
      208         "p-fact-time"            p-fact-time            skip
      209         "p-fact-num"             p-fact-num             skip
      210         "p-shift-date"           p-shift-date           skip
      211         "p-shift-num"            p-shift-num            skip
      212         "p-shift-on"             p-shift-on             skip
      213         "p-shift-end-fact-order" p-shift-end-fact-order skip
      214         "p-day-end-fact-order"   p-day-end-fact-order   skip
      215         "v-fact-date-num"        v-fact-date-num        skip
      216         view-as alert-box error .
      217       undo, return error return-value .
      218     end.
      219   end procedure.
      220   procedure day-begin-fact-order :
      221     define input  parameter p-fact-date            as date    no-undo .
      222     define output parameter p-day-begin-fact-order as decimal no-undo .
      223     do
      224     on error undo, return error return-value
      225     :
      226       if p-fact-date = ?
      227       then do:
      228         assign
      229           p-day-begin-fact-order = 0
      230         .
      231       end.
      232       else do:
      233         assign
      234           p-day-begin-fact-order = integer(p-fact-date)
      235         .
      236       end.
      237     end.
      238   end procedure.
      239   procedure factord-max-fact-order :
      240     define output parameter p-max-fact-order as decimal   no-undo .
      241     do
      242     on error undo, return error return-value
      243     :
      244       run day-begin-fact-order in this-procedure
      245         (input  date(1, 1, 5000)
      246         ,output p-max-fact-order
      247         ) .
      248     end.
      249   end procedure.
      250   procedure factord-cut-archive :
      251     define input  parameter p-obj-type             as character no-undo .
      252     define input  parameter p-obj-code             as integer   no-undo .
      253     define input  parameter p-fact-date            as date      no-undo .
      254     define output parameter p-shift-on             as logical   no-undo .
      255     define output parameter p-shift-date           as date      no-undo .
      256     define output parameter p-shift-num            as integer   no-undo .
      257     define output parameter p-day-end-fact-order   as decimal   no-undo .
      258     define output parameter p-shift-end-fact-order as decimal   no-undo .
      259     define variable v-fact-order as decimal   no-undo .
      260     define buffer buf_shift-obj for ub.shift-obj .
      261     do
      262     on error undo, return error return-value
      263     :
      264   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      265   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      266     (input  p-obj-type
      267     ,input  p-obj-code
      268     ,input  'shift-on=request'
      269     ,output p-shift-on
      270     ) no-error .
      271       if error-status :error
      272       then do:
      273         message
      274           vss-workfile vss-revision vss-description skip
      275           "Ошибка при определении атрибута объекта" skip
      276           "Объект" p-obj-type p-obj-code skip
      277           error-status :get-message(1) skip
      278           return-value skip
      279           view-as alert-box error .
      280         undo, return error return-value .
      281       end.
      282       if p-shift-on = false
      283       then do:
      284         assign
      285           p-shift-date               = ?
      286           p-shift-num                = 0
      287         .
      288       end.
      289       else do:
      290         find first buf_shift-obj share-lock
      291           where buf_shift-obj.obj-type   = p-obj-type
      292             and buf_shift-obj.obj-code   = p-obj-code
      293             and buf_shift-obj.shift-date > p-fact-date
      294           use-index pi
      295           no-error .
      296         if not available buf_shift-obj
      297         or buf_shift-obj.status_ <> 'зкр':U
      298         then do:
      299           message
      300             vss-workfile vss-revision vss-description skip
      301             "Невозможно вычислить последнюю смену" skip
      302             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      303             "Объект" p-obj-type p-obj-code skip
      304             "Дата" p-fact-date skip
      305             view-as alert-box error .
      306           undo, return error return-value .
      307         end.
      308         find last buf_shift-obj share-lock
      309           where buf_shift-obj.obj-type = p-obj-type
      310             and buf_shift-obj.obj-code = p-obj-code
      311             and buf_shift-obj.shift-date <= p-fact-date
      312           use-index pi
      313           no-error .
      314         if available buf_shift-obj
      315         then do:
      316           if  buf_shift-obj.status_ = 'зкр':U
      317           then do:
      318             assign
      319               p-shift-date = buf_shift-obj.shift-date
      320               p-shift-num  = buf_shift-obj.shift-num
      321             .
      322           end.
      323           else do:
      324             message
      325               vss-workfile vss-revision vss-description skip
      326               "Невозможно вычислить последнюю смену" skip
      327               "Статус смены отличен от статуса" 'зкр':U skip
      328               "Объект" p-obj-type p-obj-code skip
      329               "Дата" p-fact-date skip
      330               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      331               view-as alert-box error .
      332             undo, return error return-value .
      333           end.
      334         end.
      335         else do:
      336           assign
      337             p-shift-date = p-fact-date - 1
      338             p-shift-num  = 1
      339           .
      340         end.
      341       end.
      342       run factord in this-procedure
      343         (input  p-fact-date
      344         ,input  1
      345         ,input  1
      346         ,input  p-shift-date
      347         ,input  p-shift-num
      348         ,input  p-shift-on
      349         ,output v-fact-order
      350         ,output p-shift-end-fact-order
      351         ,output p-day-end-fact-order
      352         ) no-error .
      353       if error-status :error
      354       then do:
      355         message
      356           vss-workfile vss-revision vss-description skip
      357           "Ошибка при вызове процедуры factord"
      358           error-status :get-message(1) skip
      359           return-value skip
      360           view-as alert-box error .
      361         undo, return error return-value .
      362       end.
      363     end.
      364   end procedure.
      365   procedure factord-lock-shift :
      366     define input  parameter p-obj-type  as character no-undo .
      367     define input  parameter p-obj-code  as integer   no-undo .
      368     define input  parameter p-fact-date as date      no-undo .
      369     define parameter buffer buf_shift-obj for ub.shift-obj .
      370     define variable v-shift-on      as logical   no-undo .
      371     define variable v-extra-message as character no-undo .
      372     define variable v-error as character no-undo .
      373     do
      374     on error undo, return error return-value
      375     :
      376   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      377   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      378     (input  p-obj-type
      379     ,input  p-obj-code
      380     ,input  'shift-on=request'
      381     ,output v-shift-on
      382     ) no-error .
      383       if error-status :error
      384       then do:
      385         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      386         undo, return error v-error .
      387       end.
      388       if v-shift-on = true
      389       then do:
      390         find first buf_shift-obj share-lock
      391           where buf_shift-obj.obj-type   = p-obj-type
      392             and buf_shift-obj.obj-code   = p-obj-code
      393             and buf_shift-obj.shift-date > p-fact-date
      394           use-index pi
      395           no-error .
      396         if not available buf_shift-obj
      397         or buf_shift-obj.status_ <> 'зкр':U
      398         then do:
      399           find last buf_shift-obj
      400             where buf_shift-obj.obj-type = p-obj-type
      401               and buf_shift-obj.obj-code = p-obj-code
      402               and buf_shift-obj.status_  = 'зкр':U
      403             use-index stts
      404             no-error .
      405           if available buf_shift-obj
      406           then do:
      407             assign
      408               v-extra-message =
      409                     substitute("Дата начала последеней закрытой смены на объекте &1"
      410                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      411                               )
      412             .
      413           end.
      414           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      415           undo, return error v-error .
      416         end.
      417       end.
      418     end.
      419   end procedure.
      420   procedure factord-end-day :
      421     define input  parameter p-fact-date            as date    no-undo .
      422     define output parameter p-day-end-fact-order   as decimal no-undo .
      423     do
      424     on error undo, return error return-value
      425     :
      426       if p-fact-date = ?
      427       then do:
      428         return error "Не указана фактическая дата" .
      429       end.
      430       assign
      431         p-day-end-fact-order = integer(p-fact-date) + 0.99
      432       .
      433     end.
      434   end procedure.
      435   procedure factord-to-date :
      436     define input  parameter p-fact-order as decimal no-undo .
      437     define output parameter p-fact-date  as date    no-undo .
      438     define variable v-ref-date  as date      no-undo .
      439     define variable v-ref-delta as integer   no-undo .
      440     do
      441     on error undo, return error return-value
      442     :
      443       if p-fact-order = ?
      444       or p-fact-order = 0
      445       then do:
      446         return error "Не указан fact-order" .
      447       end.
      448       assign
      449         v-ref-date  = date(1, 1, 2000)
      450       .
      451       assign
      452         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      453       .
      454       assign
      455         p-fact-date = v-ref-date + v-ref-delta
      456       .
      457     end.
      458   end procedure.
      459   procedure factord-to-fact-num :
      460     define input  parameter p-fact-order as decimal no-undo .
      461     define output parameter p-fact-num   as integer no-undo .
      462     define variable v-fact-order-trunc as decimal no-undo .
      463     do
      464     on error undo, return error return-value
      465     :
      466       if p-fact-order = ?
      467       or p-fact-order = 0
      468       then do:
      469         return error "Не указан fact-order" .
      470       end.
      471       assign
      472        v-fact-order-trunc = truncate(p-fact-order, 2)
      473       .
      474       assign
      475         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      476       .
      477     end.
      478   end procedure.
      479   procedure factord-to-shift-num :
      480     define input  parameter p-fact-order as decimal no-undo .
      481     define output parameter p-shift-num   as integer no-undo .
      482     define variable  p-shift-numd  as decimal   no-undo .
      483     define variable v-fact-order-trunc as decimal no-undo .
      484     do
      485     on error undo, return error return-value
      486     :
      487       if p-fact-order = ?
      488       or p-fact-order = 0
      489       then do:
      490         return error "Не указан fact-order" .
      491       end.
      492       assign
      493        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      494       .
      495       if v-fact-order-trunc < 0.5 then do:
      496         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      497       end.
      498       assign
      499         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      500         .
      501        assign
      502         p-shift-num = truncate (p-shift-numd , 0)
      503       .
      504     end.
      505   end procedure.
      506   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      507   procedure cur-time :
      508      define output parameter p-today as date      no-undo .
      509      define output parameter p-time  as integer   no-undo .
      510     do
      511     on error undo, return error
      512     :
      513       define variable v-date1 as date      no-undo .
      514       define variable v-date2 as date      no-undo .
      515       define variable v-time  as integer   no-undo .
      516       assign
      517         v-date1 = today
      518         v-time  = time
      519         v-date2 = today
      520       .
      521       if v-date1 <> v-date2
      522       then do:
      523         assign
      524           v-date1 = today
      525           v-time  = v-time
      526         .
      527       end.
      528       assign
      529         p-today = v-date1
      530         p-time  = v-time
      531       .
      532     end.
      533   end.
      534   function cur-time-date returns character
      535   :
      536     return string(today, '99/99/9999':U) .
      537   end.
      538   function cur-time-mjd returns decimal
      539   :
      540     define variable v-date as date      no-undo .
      541     define variable v-time as integer   no-undo .
      542     run cur-time in this-procedure
      543       (output v-date
      544       ,output v-time
      545       ) .
      546     return integer(v-date) - 2400002 + (v-time / 86400) .
      547   end.
      548   function cur-time-get-ending-index returns integer
      549   (input p-number as integer
      550   )
      551   :
      552     if p-number < 0
      553     or p-number = ?
      554     then do:
      555       return 1 .
      556     end.
      557     define variable v-rest as integer   no-undo .
      558     assign
      559       p-number = p-number modulo 100
      560     .
      561     if p-number < 20
      562     then do:
      563       assign
      564         v-rest = p-number
      565       .
      566     end.
      567     else do:
      568       assign
      569         v-rest = p-number modulo 10
      570       .
      571     end.
      572     case v-rest :
      573       when 1
      574       then do:
      575         return 2 .
      576       end.
      577       when 2 or
      578       when 3 or
      579       when 4
      580       then do:
      581         return 3 .
      582       end.
      583       otherwise do:
      584         return 1 .
      585       end.
      586     end case .
      587   end.
      588   procedure cur-time-mjd-to-date :
      589      define input  parameter i-mjd-diff as decimal no-undo.
      590      define output parameter o-Date     as date    no-undo.
      591      define output parameter o-Time     as integer no-undo.
      592      define variable v-day-number as integer   no-undo .
      593      if    i-mjd-diff < 0
      594         or i-mjd-diff = ?
      595      then do:
      596         return "?" .
      597      end.
      598      assign
      599         v-day-number = truncate(i-mjd-diff,0).
      600         o-Date = date(v-day-number + 2400002).
      601         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      602     .
      603   end.
      604   function cur-time-mjd-to-string returns character
      605   (input p-mjd-diff as decimal
      606   )
      607   :
      608     define variable v-day-number as integer   no-undo .
      609     define variable v-seconds    as integer   no-undo .
      610     define variable v-hour       as integer   no-undo .
      611     define variable v-min        as integer   no-undo .
      612     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      613     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      614     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      615     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      616     if p-mjd-diff < 0
      617     or p-mjd-diff = ?
      618     then do:
      619       return "?" .
      620     end.
      621     assign
      622       v-day-number = integer(truncate(p-mjd-diff,0))
      623       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      624     .
      625     if v-seconds > 86400
      626     then do:
      627       assign
      628         v-seconds = 86400 - 1
      629       .
      630     end.
      631     if v-seconds < 0
      632     then do:
      633       assign
      634         v-seconds = 0
      635       .
      636     end.
      637     assign
      638       v-hour = truncate(v-seconds / 3600, 0)
      639     .
      640     assign
      641       v-seconds = v-seconds modulo 3600
      642     .
      643     assign
      644       v-min = truncate(v-seconds / 60, 0)
      645     .
      646     assign
      647       v-seconds = v-seconds modulo 60
      648     .
      649     return
      650         (if v-day-number <> 0
      651           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      652           else ""
      653         )
      654       + (if v-day-number <> 0 or v-hour <> 0
      655           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      656           else ""
      657         )
      658       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      659           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      660           else ""
      661         )
      662       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      663       .
      664   end.
      665   function cur-time-string returns character
      666   :
      667     define variable v-date as date      no-undo .
      668     define variable v-time as integer   no-undo .
      669     run cur-time in this-procedure
      670       (output v-date
      671       ,output v-time
      672       ) .
      673     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      674   end.
      675   function cur-time-string-sec returns character
      676   :
      677     define variable v-date as date      no-undo .
      678     define variable v-time as integer   no-undo .
      679     run cur-time in this-procedure
      680       (output v-date
      681       ,output v-time
      682       ) .
      683     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      684   end.
      685   function cur-time-custom  returns character
      686   (input p-prefix as character
      687   ,input p-date-format as character
      688   ,input p-delimiter as character
      689   ,input p-time-format as character
      690   ,input p-suffix as character
      691   )
      692   :
      693     define variable v-date as date      no-undo .
      694     define variable v-time as integer   no-undo .
      695     run cur-time in this-procedure
      696       (output v-date
      697       ,output v-time
      698       ) .
      699     return
      700       p-prefix
      701       + string(v-date, p-date-format)
      702       + p-delimiter
      703       + string(v-time, p-time-format)
      704       + p-suffix
      705       .
      706   end.
      707   function cur-time-print  returns character
      708   :
      709     define variable v-date as date      no-undo .
      710     define variable v-time as integer   no-undo .
      711     run cur-time in this-procedure
      712       (output v-date
      713       ,output v-time
      714       ) .
      715     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      716   end.
      717   function cur-time-datetime returns datetime
      718   :
      719     define variable v-char as character no-undo .
      720     define variable v-datetime as datetime no-undo .
      721     v-char = cur-time-string().
      722     v-datetime = datetime(v-char).
      723     return  v-datetime.
      724   end.
      725   function cur-time-string-msec returns character
      726   :
      727     define variable v-date as datetime  no-undo .
      728     v-date = now.
      729     return string(v-date) .
      730   end.
      731   define variable vss-include-info4 as character format "X(65)" no-undo
      732   initial "@(#)$Workfile$ $Revision$".
      733   define temp-table temp_grplib_grp no-undo
      734       field sel           as character
      735       field nabor         as character
      736       field full-name     as character
      737       field print-code    as character
      738       field sort-name     as character
      739       field node-code     as integer
      740       field upper-code    as integer
      741       field calc-method   as character
      742       field round-method  as character
      743       field increase-pc   as decimal
      744       field min-marg      as character
      745       field max-marg      as character
      746       field cli-type      as character
      747       field cli-code      as integer
      748       field notcorr      as character
      749       field name          as character
      750       field level         as integer
      751       field mark          as character
      752       index pi is primary unique sort-name
      753       index fn full-name
      754       index nc is unique node-code
      755       index sl sel
      756       index uc upper-code
      757   .
      758   define temp-table temp_grplib_found-grp no-undo
      759       field full-name   as character
      760       field sort-name   as character
      761       field node-code   as integer
      762       field level       as integer
      763       field is-terminal as logical
      764       index pi is primary unique sort-name
      765       index fn full-name
      766       index lv level
      767       index it is-terminal
      768   .
      769   define temp-table temp_found-result-nodelist no-undo
      770       field node-code     as recid
      771       field processed     as logical
      772       field sort-name     as character
      773       field full-name     as character
      774       index pi is primary unique node-code
      775       index ps processed
      776   .
      777   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
      778   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
      779   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
      780   procedure grplib-get-parameters :
      781   define input parameter p-store-type     as character        no-undo.
      782   define input parameter p-store-code     as integer          no-undo.
      783   do
      784   on error undo, return error
      785   :
      786       assign
      787           v-grplib-not-fill-extra-info = no
      788       .
      789   end.
      790   end procedure.
      791   procedure grplib-get-sort-name :
      792   do
      793   on error undo, return error
      794   :
      795   define input parameter p-node-code  as integer      no-undo.
      796   define output parameter p-sort-name as character    no-undo.
      797       define variable v-upper-code    as integer           no-undo.
      798       define buffer buf_gds-grp       for ub.gds-grp.
      799       define buffer buf_upper_gds-grp for ub.gds-grp.
      800       find first buf_gds-grp no-lock
      801            where buf_gds-grp.node-code = p-node-code
      802       no-error.
      803       if not available buf_gds-grp
      804       then do:
      805           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      806       end.
      807       assign
      808           p-sort-name  = ""
      809           v-upper-code = 1
      810       .
      811       do while buf_gds-grp.upper-code <> 0
      812       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
      813       :
      814           assign
      815               p-sort-name  = buf_gds-grp.node-name
      816                            + (if p-sort-name <> "" then chr(2) else "")
      817                            + p-sort-name
      818               v-upper-code = buf_gds-grp.upper-code
      819           .
      820           find first buf_gds-grp no-lock
      821                where buf_gds-grp.node-code = v-upper-code
      822           no-error.
      823           if not available buf_gds-grp
      824           then do:
      825               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
      826                                   + string( v-upper-code )
      827                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      828           end.
      829       end.
      830   end.
      831   end procedure.
      832   define variable vss-include-info5 as character format "X(65)" no-undo
      833   initial "@(#)$Workfile$ $Revision$".
      834   procedure grplib-get-full-name :
      835      define input parameter p-node-code  as integer      no-undo.
      836      define output parameter p-full-name as character    no-undo.
      837      do
      838   on error undo, return error
      839   :
      840       define variable v-upper-code    as integer           no-undo.
      841       define buffer buf_gds-grp       for ub.gds-grp.
      842       define buffer buf_upper_gds-grp for ub.gds-grp.
      843       find first buf_gds-grp no-lock
      844            where buf_gds-grp.node-code = p-node-code
      845       no-error.
      846       if not available buf_gds-grp
      847       then do:
      848           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      849       end.
      850       assign
      851           p-full-name  = ""
      852           v-upper-code = 1
      853       .
      854       do while buf_gds-grp.upper-code <> 0
      855       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      856       :
      857           assign
      858               p-full-name  = buf_gds-grp.node-name
      859                            + (if p-full-name <> "" then chr(47) else "")
      860                            + p-full-name
      861               v-upper-code = buf_gds-grp.upper-code
      862           .
      863           find first buf_gds-grp no-lock
      864                where buf_gds-grp.node-code = v-upper-code
      865           no-error.
      866           if not available buf_gds-grp
      867           then do:
      868               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      869                                   + string( v-upper-code )
      870                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      871           end.
      872       end.
      873       assign
      874       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      875       .
      876   end.
      877   end .
      878   procedure grplib-get-node-from-full-name :
      879   define input parameter p-full-name as character no-undo .
      880   define output parameter p-node-code as integer no-undo .
      881   define variable v-ii as integer no-undo .
      882   define variable v-upper-code as integer no-undo .
      883   define variable v-root-code as integer no-undo .
      884   define variable v-entry as character no-undo .
      885   define buffer buf_gds-grp       for ub.gds-grp.
      886   do
      887   on error undo, return error
      888   :
      889     find first buf_gds-grp no-lock
      890         where buf_gds-grp.upper-code = 0
      891     no-error .
      892     if not available buf_gds-grp
      893     then do:
      894         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      895     end.
      896     else do:
      897       assign
      898       v-root-code = buf_gds-grp.node-code
      899       .
      900     end.
      901     v-upper-code = v-root-code.
      902     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      903       assign
      904       v-entry = entry(v-ii, p-full-name, chr(47)).
      905       if v-entry = '' then leave.
      906       find first buf_gds-grp no-lock where
      907                 buf_gds-grp.node-name = v-entry
      908             and buf_gds-grp.upper-code = v-upper-code
      909             no-error.
      910       if not available buf_gds-grp then do:
      911         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      912       end.
      913       else do:
      914         p-node-code = buf_gds-grp.node-code.
      915         v-upper-code = buf_gds-grp.node-code.
      916       end.
      917     end.
      918   end.
      919   end .
      920   procedure grplib-get-root-code :
      921   do
      922   on error undo, return error
      923   :
      924   define output parameter p-root-code as integer      no-undo.
      925       define buffer buf_gds-grp       for ub.gds-grp.
      926       find first buf_gds-grp no-lock
      927           where buf_gds-grp.upper-code = 0
      928       no-error .
      929       if not available buf_gds-grp
      930       then do:
      931           undo, return error .
      932       end.
      933       else do:
      934           assign
      935               p-root-code = buf_gds-grp.node-code
      936           .
      937       end.
      938   end.
      939   end procedure.
      940   procedure grplib-find-grp-by-full-name :
      941   do
      942   on error undo, return error
      943   :
      944   define input parameter p-search-name  as character    no-undo.
      945   define input parameter p-fill-path    as logical      no-undo.
      946   define output parameter p-found       as logical      no-undo.
      947       define variable v-upper-code    as integer          no-undo.
      948       define variable v-counter       as integer           no-undo.
      949       define variable v-level         as integer           no-undo.
      950       define variable v-full-name     as character         no-undo.
      951       define variable v-sort-name     as character         no-undo.
      952       define buffer buf_gds-grp       for ub.gds-grp.
      953       assign
      954           p-search-name = replace( p-search-name, chr(47), chr(2) )
      955       .
      956       run grplib-get-root-code ( output v-upper-code ) no-error .
      957       if error-status :error
      958       then do:
      959           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
      960       end.
      961       assign
      962           v-full-name  = ""
      963           v-level      = num-entries( p-search-name, chr(2) )
      964       .
      965       for each temp_grplib_found-grp
      966       :
      967           delete temp_grplib_found-grp.
      968       end.
      969       start-name-analyze:
      970       do v-counter = 1 to v-level
      971       :
      972           if v-counter < v-level
      973           then do:
      974               find first buf_gds-grp no-lock
      975                    where buf_gds-grp.upper-code = v-upper-code
      976                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
      977               no-error .
      978               if not available buf_gds-grp
      979               then do:
      980                   assign
      981                       v-full-name  = p-search-name
      982                       v-sort-name  = p-search-name
      983                   .
      984                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      985               end.
      986               else do:
      987                   assign
      988                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
      989                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
      990                       v-upper-code = buf_gds-grp.node-code
      991                   .
      992                   if p-fill-path = yes
      993                   then do:
      994                       create temp_grplib_found-grp.
      995                       assign
      996                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
      997                           temp_grplib_found-grp.sort-name = v-sort-name
      998                           temp_grplib_found-grp.node-code = v-upper-code
      999                           temp_grplib_found-grp.level     = v-counter
     1000                       .
     1001                   end.
     1002               end.
     1003           end.
     1004           else do:
     1005               for each buf_gds-grp no-lock
     1006                  where buf_gds-grp.upper-code = v-upper-code
     1007                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     1008               :
     1009                   assign
     1010                       p-found = yes
     1011                   .
     1012                   create temp_grplib_found-grp.
     1013                   assign
     1014                       temp_grplib_found-grp.full-name = v-full-name
     1015                                                           + (if v-full-name = "" then "" else chr(47) )
     1016                                                           + buf_gds-grp.node-name + chr(47)
     1017                       temp_grplib_found-grp.sort-name = v-sort-name
     1018                                                           + ( if v-sort-name = "" then "" else chr(2) )
     1019                                                           + buf_gds-grp.node-name
     1020                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
     1021                       temp_grplib_found-grp.level     = v-level
     1022                   .
     1023               end.
     1024               if p-found = no
     1025               then do:
     1026                   assign
     1027                       v-full-name  = p-search-name
     1028                       v-sort-name  = p-search-name
     1029                   .
     1030                   for each temp_grplib_found-grp
     1031                   :
     1032                       delete temp_grplib_found-grp.
     1033                   end.
     1034                   assign
     1035                       p-found = no
     1036                   .
     1037               end.
     1038           end.
     1039       end.
     1040   end.
     1041   end procedure.
     1042   procedure grplib-find-all-subgroup :
     1043   do
     1044   on error undo, return error
     1045   :
     1046   define input parameter p-start-node-code    as integer      no-undo.
     1047   define input parameter p-terminal-only      as logical      no-undo.
     1048       define variable v-start-full-name   as character     no-undo.
     1049       define variable v-start-sort-name   as character     no-undo.
     1050       define variable v-not-found         as logical       no-undo.
     1051       define variable v-is-terminal       as logical       no-undo.
     1052       define buffer buf_gds-grp           for ub.gds-grp.
     1053       create temp_found-result-nodelist.
     1054       assign
     1055           temp_found-result-nodelist.node-code = p-start-node-code
     1056           temp_found-result-nodelist.processed = no
     1057       .
     1058       run grplib-get-full-name in this-procedure (
     1059             input p-start-node-code
     1060           , output v-start-full-name
     1061       ).
     1062       run grplib-get-full-name in this-procedure (
     1063             input p-start-node-code
     1064           , output v-start-sort-name
     1065       ).
     1066       process-nodes:
     1067       do while yes
     1068       :
     1069           find first temp_found-result-nodelist
     1070                where temp_found-result-nodelist.node-code = p-start-node-code
     1071           .
     1072           assign
     1073               temp_found-result-nodelist.processed = yes
     1074           .
     1075           for each buf_gds-grp no-lock
     1076              where buf_gds-grp.upper-code = p-start-node-code
     1077           on error undo, return error
     1078           :
     1079               run grplib-is-terminal in this-procedure (
     1080                     input buf_gds-grp.node-code
     1081                   , output v-is-terminal
     1082               ).
     1083               if v-is-terminal = yes
     1084               then do:
     1085                   create temp_grplib_found-grp.
     1086                   assign
     1087                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1088                                                           chr(47) + buf_gds-grp.node-name + chr(47)
     1089                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1090                                                           chr(2) + buf_gds-grp.node-name + chr(2)
     1091                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     1092                       temp_grplib_found-grp.is-terminal = yes
     1093                   .
     1094               end.
     1095               else do:
     1096                   create temp_found-result-nodelist.
     1097                   assign
     1098                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
     1099                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     1100                                                              chr(47) + buf_gds-grp.node-name + chr(47)
     1101                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     1102                                                              chr(2) + buf_gds-grp.node-name + chr(2)
     1103                       temp_found-result-nodelist.processed = no
     1104                   .
     1105                   if p-terminal-only = no
     1106                   then do:
     1107                       create temp_grplib_found-grp.
     1108                       assign
     1109                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1110                                                               chr(47) + buf_gds-grp.node-name + chr(47)
     1111                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1112                                                               chr(2) + buf_gds-grp.node-name + chr(2)
     1113                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     1114                           temp_grplib_found-grp.is-terminal = no
     1115                       .
     1116                   end.
     1117               end.
     1118           end.
     1119           find first temp_found-result-nodelist
     1120                where temp_found-result-nodelist.processed = no
     1121           no-error.
     1122           if not available temp_found-result-nodelist
     1123           then do:
     1124               leave process-nodes.
     1125           end.
     1126           else do:
     1127               assign
     1128                   p-start-node-code = temp_found-result-nodelist.node-code
     1129                   v-start-full-name = temp_found-result-nodelist.full-name
     1130                   v-start-sort-name = temp_found-result-nodelist.sort-name
     1131               .
     1132           end.
     1133       end.
     1134   end.
     1135   end procedure.
     1136   procedure grplib-expand-name :
     1137   define input parameter p-start-name as character        no-undo.
     1138   define output parameter p-end-name  as character        no-undo.
     1139       define variable v-is-terminal   as logical      no-undo.
     1140       define variable v-found         as character    no-undo.
     1141       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
     1142   do
     1143   for buf_temp_grplib_found-grp
     1144   on error undo, return error
     1145   :
     1146       run grplib-find-grp-by-full-name in this-procedure (
     1147             input p-start-name
     1148           , input no
     1149           , output v-found
     1150       ) no-error.
     1151       run grplib-get-max-substring in this-procedure (
     1152                   input length( p-start-name )
     1153                 , output p-end-name
     1154       ) no-error .
     1155       if error-status :error
     1156       then do:
     1157           assign
     1158               p-end-name = ""
     1159           .
     1160       end.
     1161       else do:
     1162           find first temp_grplib_found-grp
     1163               where temp_grplib_found-grp.full-name = p-end-name
     1164           no-error.
     1165           if available temp_grplib_found-grp
     1166           then do:
     1167               find first buf_temp_grplib_found-grp
     1168                   where buf_temp_grplib_found-grp.full-name begins p-end-name
     1169                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
     1170               no-error.
     1171               if not available buf_temp_grplib_found-grp
     1172               then do:
     1173                   run grplib-is-terminal in this-procedure (
     1174                       input temp_grplib_found-grp.node-code
     1175                       , output v-is-terminal
     1176                   ).
     1177               end.
     1178           end.
     1179       end.
     1180   end.
     1181   end procedure.
     1182   procedure grplib-get-max-substring :
     1183   do
     1184   on error undo, return error
     1185   :
     1186   define input parameter p-min-substring-length   as integer      no-undo.
     1187   define output parameter p-substring             as character    no-undo.
     1188           define variable v-char-counter  as integer           no-undo.
     1189           define variable v-current-char  as character         no-undo.
     1190           define variable v-names-counter  as integer           no-undo.
     1191           define variable v-base-string   as character         no-undo.
     1192           assign
     1193               v-char-counter  = p-min-substring-length
     1194           .
     1195           find first temp_grplib_found-grp no-error.
     1196           if not available temp_grplib_found-grp
     1197           then do:
     1198               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
     1199           end.
     1200           else do:
     1201               assign
     1202                   v-base-string  = temp_grplib_found-grp.full-name
     1203                   v-char-counter = 0
     1204               .
     1205               counter-block:
     1206               do while yes
     1207               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     1208               :
     1209                   assign
     1210                       v-char-counter  = v-char-counter + 1
     1211                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     1212                       v-names-counter = 0
     1213                   .
     1214                   compare-block:
     1215                   for each temp_grplib_found-grp
     1216                   :
     1217                       assign
     1218                           v-names-counter = v-names-counter + 1
     1219                       .
     1220                       if v-names-counter = 1
     1221                       then do:
     1222                           next compare-block.
     1223                       end.
     1224                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     1225                       then do:
     1226                           leave counter-block.
     1227                       end.
     1228                   end.
     1229                   if v-names-counter = 1
     1230                   then do:
     1231                       assign
     1232                           p-substring = v-base-string
     1233                       .
     1234                       return.
     1235                   end.
     1236               end.
     1237               assign
     1238                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     1239               .
     1240           end.
     1241   end.
     1242   end procedure.
     1243   procedure grplib-is-terminal :
     1244   do
     1245   on error undo, return error "Ошибка процедуры grplib-is-terminal"
     1246   :
     1247   define input parameter p-node-code      as integer      no-undo.
     1248   define output parameter p-is-terminal   as logical      no-undo.
     1249       define buffer buf_gds-grp       for ub.gds-grp.
     1250       find first buf_gds-grp no-lock
     1251           where buf_gds-grp.upper-code = p-node-code
     1252       no-error .
     1253       if not available buf_gds-grp
     1254       then do:
     1255           assign
     1256               p-is-terminal = yes
     1257           .
     1258       end.
     1259       else do:
     1260           assign
     1261               p-is-terminal = no
     1262           .
     1263       end.
     1264   end.
     1265   end procedure.
     1266   procedure grplib-have-goods :
     1267   do
     1268   on error undo, return error
     1269   :
     1270   define input parameter p-node-code      as integer      no-undo.
     1271   define output parameter p-have-goods   as logical      no-undo.
     1272       define buffer buf_goods         for ub.goods.
     1273       find first buf_goods no-lock
     1274            where buf_goods.grp-code = p-node-code
     1275       no-error .
     1276       if available buf_goods
     1277       then do:
     1278           assign
     1279               p-have-goods = yes
     1280           .
     1281       end.
     1282       else do:
     1283           assign
     1284               p-have-goods = no
     1285           .
     1286       end.
     1287   end.
     1288   end procedure.
     1289   procedure grplib-find-by-substring :
     1290   do
     1291   on error undo, return error
     1292   :
     1293   define input parameter p-start-code         as integer      no-undo.
     1294   define input parameter p-full-search-string as character    no-undo.
     1295   define output parameter p-found-code        as integer      no-undo.
     1296   define output parameter p-full-name         as character    no-undo.
     1297       define variable v-start-code     as integer           no-undo.
     1298       define variable v-found          as logical  init no  no-undo.
     1299       define buffer buf_gds-grp       for ub.gds-grp.
     1300       search-grp:
     1301       for each buf_gds-grp no-lock
     1302           where buf_gds-grp.node-code > p-start-code
     1303       :
     1304           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
     1305           then do:
     1306               assign
     1307                   p-found-code = buf_gds-grp.node-code
     1308                   v-found      = yes
     1309               .
     1310               run grplib-get-full-name in this-procedure (
     1311                     input p-found-code
     1312                   , output p-full-name
     1313               ) no-error .
     1314               if error-status :error
     1315               then do:
     1316                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     1317               end.
     1318               leave search-grp.
     1319           end.
     1320       end.
     1321       if v-found = yes
     1322       then do:
     1323       end.
     1324       else do:
     1325           assign
     1326               p-full-name  = ""
     1327               p-found-code = 0
     1328           .
     1329       end.
     1330   end.
     1331   end procedure.
     1332   procedure grplib-analyze-grp-name :
     1333   do
     1334   on error undo, return error
     1335   :
     1336   define input parameter p-grp-name       as character            no-undo.
     1337   define input parameter p-upper-code     as integer              no-undo.
     1338   define output parameter p-error-message as character init ""    no-undo.
     1339       define variable v-char-list     as character    no-undo.
     1340       define variable v-char-counter  as integer      no-undo.
     1341       define variable v-full-name     as character    no-undo.
     1342       if p-grp-name = "" then do:
     1343           assign
     1344               p-error-message = "Название группы не может быть пустым.".
     1345           .
     1346       end.
     1347       else do:
     1348           assign
     1349               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     1350           .
     1351           do v-char-counter = 1 to num-entries( v-char-list )
     1352           :
     1353               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     1354               then do:
     1355                   assign
     1356                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     1357                   .
     1358                   return.
     1359               end.
     1360           end.
     1361           if p-upper-code > 0
     1362           then do:
     1363               run grplib-get-full-name in this-procedure (
     1364                     input p-upper-code
     1365                   , output v-full-name
     1366               ) no-error .
     1367               if error-status :error
     1368               then do:
     1369                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     1370               end.
     1371               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
     1372               then do:
     1373                   assign
     1374                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
     1375                   .
     1376               end.
     1377           end.
     1378       end.
     1379   end.
     1380   end procedure.
     1381   procedure grplib-get-lvl-num :
     1382   define input parameter p-node-code  as integer      no-undo.
     1383   define output parameter p-lvl-num   as integer      no-undo.
     1384       define variable v-full-name    as character    no-undo.
     1385   do
     1386   on error undo, return error
     1387   :
     1388       run grplib-get-full-name in this-procedure (
     1389             input p-node-code
     1390           , output v-full-name
     1391       ).
     1392       assign
     1393           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     1394       .
     1395       if p-lvl-num = -1
     1396       then do:
     1397           assign
     1398               p-lvl-num = 0
     1399           .
     1400       end.
     1401   end.
     1402   end procedure.
     1403   define variable found as logical no-undo.
     1404   DEFINE VARIABLE varnode-code like ub.gds-grp.node-code no-undo .
     1405   DEFINE VARIABLE varrate-code like ub.tax-rate.rate-code no-undo .
     1406   DEFINE VARIABLE vartax-value like ub.tax-rate-value.rate-value no-undo .
     1407   DEFINE VARIABLE vtoday-fact-order as decimal no-undo .
     1408   DEFINE VARIABLE vgds-fact-order as decimal no-undo .
     1409   DEFINE VARIABLE varfact-date like ub.tax-rate-gds.fact-date no-undo .
     1410   DEFINE VARIABLE v-today as date no-undo .
     1411   DEFINE VARIABLE v-time as integer no-undo .
     1412   define variable vattr-codes as character no-undo .
     1413   define variable vattr-labels as character no-undo .
     1414   define variable varrate-code-str as character no-undo .
     1415   define variable v-root-code as integer no-undo .
     1416   define buffer buf_gds-grp for ub.gds-grp.
     1417   define buffer buf_tax for ub.tax.
     1418   define buffer buf_tax-rate-gds-grp for ub.tax-rate-gds-grp.
     1419   define buffer buf_tax-rate for ub.tax-rate.
     1420   main-block:
     1421   do
     1422   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1423   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1424   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1425   :
     1426   if parnode-code <> 0 then do:
     1427     if parhost-code = 0 or
     1428       parobj-type = "":U or
     1429       parobj-code = 0 then do:
     1430         undo main-block, return error substitute("&1 &2 &3&4" +
     1431       "Неверные значения параметров объект и/или фирма при вызове процедуры dtaxgrps.p "
     1432                                       ,vss-workfile
     1433                                       ,vss-revision
     1434                                       ,vss-description
     1435                                       ,chr(10)).
     1436     end.
     1437   end.
     1438   for each tt-tax:
     1439       delete tt-tax.
     1440   end.
     1441   run cur-time in this-procedure(output v-today, output v-time).
     1442   run factord-end-day in this-procedure (input v-today , output vtoday-fact-order).
     1443   if parnode-code <> 0 then do:
     1444     varnode-code = parnode-code.
     1445     find first buf_gds-grp No-LOCK WHERE
     1446                 buf_gds-grp.node-code = parnode-code No-ERROR.
     1447   end.
     1448   else do:
     1449     varnode-code = parupper-code.
     1450     find first buf_gds-grp No-LOCK WHERE
     1451                 buf_gds-grp.node-code = parupper-code No-ERROR.
     1452   end.
     1453   run grplib-get-root-code ( output v-root-code).
     1454     if not avail buf_gds-grp then do:
     1455       undo main-block, return error substitute("&1 &2 &3&4" +
     1456                                     "Нет группы товаров с кодом &5"
     1457                                   ,vss-workfile
     1458                                   ,vss-revision
     1459                                   ,vss-description
     1460                                   ,chr(10)
     1461                                   ,varnode-code).
     1462   end.
     1463   _tax:
     1464     FOR EACH buf_tax No-LOCK WHERE
     1465             buf_tax.individual = no
     1466     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1467     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1468     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1469     :
     1470       if buf_tax.individual = yes then next _tax.
     1471       varrate-code = 0.
     1472       FIND LAST buf_tax-rate-gds-grp No-LOCK WHERE
     1473                 buf_tax-rate-gds-grp.node-code = varnode-code
     1474            AND  buf_tax-rate-gds-grp.tax-code = buf_tax.tax-code
     1475            AND
     1476                 buf_tax-rate-gds-grp.host-code = 0
     1477             AND buf_tax-rate-gds-grp.obj-type = ""
     1478             AND buf_tax-rate-gds-grp.obj-code = 0 NO-ERROR.
     1479       if avail buf_tax-rate-gds-grp then do:
     1480         found = yes.
     1481         assign
     1482           varrate-code = buf_tax-rate-gds-grp.rate-code
     1483         .
     1484       end.
     1485       FIND FIRST buf_tax-rate No-LOCK WHERE
     1486                       buf_tax-rate.tax-code = buf_tax.tax-code AND
     1487                       buf_tax-rate.rate-code = varrate-code No-ERROR.
     1488       if error-status:error or not avail buf_tax-rate then do:
     1489         if varrate-code = 0
     1490         and buf_gds-grp.node-code = v-root-code
     1491         then do:
     1492           assign
     1493           vattr-codes = "":U
     1494           vattr-labels = "":U
     1495           .
     1496           for each buf_tax-rate no-lock where
     1497                   buf_tax-rate.tax-code = buf_tax.tax-code:
     1498   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1499   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
     1500     (input  recid(buf_tax-rate)
     1501     ,input  buf_tax-rate.tax-code
     1502     ,input  buf_tax-rate.rate-code
     1503     ,input  ?
     1504     ,input  0
     1505     ,input  '':U
     1506     ,input  0
     1507     ,output vartax-value
     1508     ) no-error .
     1509             if error-status:error then do:
     1510               message
     1511               return-value view-as alert-box error .
     1512               return error.
     1513             end.
     1514           if vartax-value = ? then NEXT.
     1515           assign
     1516           vattr-labels = vattr-labels +
     1517                         (if vattr-labels = "":U then "" else chr(44)) +
     1518                         string(string(buf_tax-rate.rate-code) + " - " + replace(buf_tax-rate.rate-name, chr(44), "":U), "X(25)") +
     1519                         fill(chr(32), 5) + string(vartax-value, "99.99%":U)
     1520           vattr-codes = vattr-codes +
     1521                         (if vattr-codes = "":U then "" else chr(44)) +
     1522                         string(buf_tax-rate.rate-code)
     1523           .
     1524           run gbl/d-list.w (
     1525                         INPUT "b-sel":U
     1526                         ,INPUT substitute("Выберите ставку налога (&1) для групп (по умолчанию)", buf_tax.tax-name)
     1527                         ,INPUT vattr-codes
     1528                         ,INPUT vattr-labels
     1529                         ,INPUT chr(44)
     1530                         ,INPUT "":U
     1531                         ,output varrate-code-str).
     1532           IF varrate-code-str = "":u THEN do:
     1533             message
     1534             substitute("Вы не выбрали ставку налога (&1) для групп!&2" +
     1535                       "Это может привести к непредсказуемым результатам"
     1536                       , buf_tax.tax-name
     1537                       , chr(10)
     1538                       )
     1539             view-as alert-box error .
     1540             RETURN ERROR.
     1541           end.
     1542           create buf_tax-rate-gds-grp.
     1543           assign
     1544           buf_tax-rate-gds-grp.node-code = buf_gds-grp.node-code
     1545           buf_tax-rate-gds-grp.tax-code =  buf_tax.tax-code
     1546           buf_tax-rate-gds-grp.rate-code = integer(varrate-code-str)
     1547           .
     1548         end.
     1549       end.
     1550       else do:
     1551         undo main-block, return error substitute("&1 &2 &3&4" +
     1552                                       "Не найдена запись ставки налога:&4" +
     1553                                       "код налога: &5, код ставки &6&4" +
     1554                                       "возможно у Вас не настроены ставки налога по умолчанию для групп товаров"
     1555                                       ,vss-workfile
     1556                                       ,vss-revision
     1557                                       ,vss-description
     1558                                       ,chr(10)
     1559                                       ,buf_tax.tax-code
     1560                                       ,varrate-code).
     1561       end.
     1562     end.
     1563     if parhost-code > 0 and
     1564        parobj-type <> "":U and
     1565        parobj-code <> 0 then do:
     1566   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1567   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
     1568     (input  recid(buf_tax-rate)
     1569     ,input  0
     1570     ,input  0
     1571     ,input  ?
     1572     ,input  parhost-code
     1573     ,input  parobj-type
     1574     ,input  parobj-code
     1575     ,output vartax-value
     1576     ) no-error .
     1577       if error-status:error or vartax-value = ? then do:
     1578           undo main-block, return error substitute("&1 &2 &3&4" +
     1579                                         "Ошибка при определении значения ставки налога по умолчанию на товар группы:&4" +
     1580                                         "код налога: &5, ставка налога: &6"
     1581                                         ,vss-workfile
     1582                                         ,vss-revision
     1583                                         ,vss-description
     1584                                         ,chr(10)
     1585                                         ,buf_tax-rate.tax-code
     1586                                         ,buf_tax-rate.rate-code).
     1587       end.
     1588     end.
     1589     FIND FIRST tt-tax NO-LOCK WHERE
     1590                   tt-tax.tax-code = buf_tax.tax-code No-ERROR.
     1591     if not avail tt-tax then do:
     1592         create
     1593         tt-tax.
     1594         assign
     1595           tt-tax.tax-code = buf_tax.tax-code
     1596           tt-tax.tax-name = buf_tax.tax-name
     1597           tt-tax.rate-code = if buf_tax.individual then ? else buf_tax-rate.rate-code
     1598           tt-tax.rate-name = if buf_tax.individual then buf_tax.tax-name else buf_tax-rate.rate-name
     1599           tt-tax.tax-type = buf_tax.tax-type
     1600           tt-tax.rate-value = if buf_tax.individual then ? else vartax-value
     1601           tt-tax.individual = buf_tax.individual
     1602           tt-tax.tax-rate-gds-rc = if (avail buf_gds-grp and avail buf_tax-rate-gds-grp )
     1603                               then recid(buf_tax-rate-gds-grp)
     1604                             else ?
     1605         tt-tax.fact-date = varfact-date
     1606         tt-tax.fact-order = vtoday-fact-order
     1607         .
     1608     end.
     1609     END.
     1610   end.
