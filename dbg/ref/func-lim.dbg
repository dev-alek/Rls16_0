     1023   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
     1024   define input  parameter p-upper-code  like ub.thbj-attr.upper-prop-code  no-undo .
     1025   define input  parameter table-handle p-tth.
     1026   do
     1027   on error undo, return error return-value
     1028   :
     1029       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_set-section in g#attr-lib
     1030       (input  p-obj-type
     1031       ,input  p-obj-code
     1032       ,input  p-upper-code
     1033       ,input  table-handle p-tth
     1034       ) no-error .
     1035     if error-status :error
     1036     then do:
     1037       delete object p-tth.
     1038       undo, return error return-value .
     1039     end.
     1040     delete object p-tth.
     1041   end.
     1042   end procedure.
     1043   procedure thbjattr_delete :
     1044   define input  parameter p-obj-type   like ub.thbj-attr.obj-type   no-undo .
     1045   define input  parameter p-obj-code   like ub.thbj-attr.obj-code   no-undo .
     1046   define input  parameter p-upper-code like ub.thbj-attr.upper-prop-code  no-undo .
     1047   define input  parameter p-code       like ub.thbj-attr.prop-code  no-undo .
     1048   define output parameter p-deleted  as logical no-undo.
     1049   do
     1050   on error undo, return error return-value
     1051   :
     1052       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_delete in g#attr-lib
     1053       (input  p-obj-type
     1054       ,input  p-obj-code
     1055       ,input  p-upper-code
     1056       ,input  p-code
     1057       ,output p-deleted
     1058       ) no-error .
     1059     if error-status :error
     1060     then do:
     1061       undo, return error return-value .
     1062     end.
     1063   end.
     1064   end procedure.
     1065   procedure thbjattr_delete-section :
     1066   define input  parameter p-obj-type   like ub.thbj-attr.obj-type   no-undo .
     1067   define input  parameter p-obj-code   like ub.thbj-attr.obj-code   no-undo .
     1068   define input  parameter p-upper-code like ub.thbj-attr.upper-prop-code  no-undo .
     1069   do
     1070   on error undo, return error return-value
     1071   :
     1072       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_delete-section in g#attr-lib
     1073       (input  p-obj-type
     1074       ,input  p-obj-code
     1075       ,input  p-upper-code
     1076       ) no-error .
