     1083   procedure thbjattr_manual-edit :
     1084   define input  parameter p-ucode          as character no-undo .
     1085   define input  parameter p-code           as character no-undo .
     1086   define output parameter p-section-num    as integer no-undo .
     1087   do
     1088   on error undo, return error return-value
     1089   :
     1090       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_manual-edit in g#attr-lib
     1091       (input  p-ucode
     1092       ,input  p-code
     1093       ,output  p-section-num
     1094       ) no-error .
     1095     if error-status :error
     1096     then do:
     1097       undo, return error return-value .
     1098     end.
     1099   end.
     1100   end procedure.
     1101   define temp-table temp-goods2  no-undo like temp-goods .
     1102   define temp-table  x-analysis  no-undo  like ub.abc-analysis.
     1103   define input   parameter table for    x-analysis.
     1104   define input   parameter table for    temp-goods.
     1105   define output  parameter table for    temp-goods2.
     1106   run waitfram-show ("Отсечение по проценту...").
     1107   find first x-analysis no-error .
     1108   if error-status :error then
     1109     message vss-workfile vss-revision vss-description skip
     1110     error-status :get-message(1) view-as alert-box error .
     1111   define variable LE-proc as decimal   no-undo .
     1112   define variable par-type as character no-undo .
     1113   define variable par-abc-type as character no-undo .
     1114   define variable  v-value-date    as date   no-undo .
     1115   define variable  v-value-decimal as decimal   no-undo .
     1116   define variable  v-value-integer as integer   no-undo .
     1117   define variable  v-value-logical as logical   no-undo .
     1118   define variable v-found as logical   no-undo .
     1119   run thbjattr_value in this-procedure  (
     1120     input   "",
     1121     input   0 ,
     1122     input   'abc-global':U ,
     1123     input   'abc-type'  ,
     1124     output  par-abc-type ,
     1125     output  v-value-date      ,
     1126     output  v-value-decimal   ,
     1127     output  v-value-integer   ,
     1128     output  v-value-logical   ,
     1129     output  par-type            ,
     1130     output  v-found
     1131     ) no-error
     1132     .
     1133     if error-status :error or v-found = false then do:
     1134         message "Нет настроек Ассортиментной политики !!!." view-as alert-box information .
     1135         return error return-value .
     1136     end.
     1137   define variable label-a as character no-undo .
     1138   define variable label-b as character no-undo .
     1139   case par-abc-type :
     1140      when 'ABC':U
     1141         then do:
     1142         label-a  = "D"  .
     1143         label-b  = "E"  .
     1144         end.
     1145      when 'ABCD':U
     1146         then do:
     1147         label-a = "E"  .
     1148         label-b = "F"  .
     1149         end.
     1150      when 'ABCDE':U
     1151         then do:
     1152         label-a = "F"  .
     1153         label-b = "G"  .
     1154         end.
     1155      when 'ABCDEF':U
     1156         then do:
     1157         label-a = "G"  .
     1158         label-b = "H"  .
     1159         end.
     1160   end case.
     1161   assign
     1162     LE-proc = x-analysis.LE-proc
     1163     .
     1164   for each temp-goods  where  temp-goods.crit = 'B' break by temp-goods.crit-pr desc :
     1165       find first temp-goods2 where temp-goods2.gds-code = temp-goods.gds-code no-error .
     1166       if not available temp-goods2 then do:
     1167          create temp-goods2 .
     1168          BUFFER-COPY temp-goods TO temp-goods2 .
     1169       end.
     1170       if temp-goods.crit-pr <= LE-proc   then do:
     1171          temp-goods2.crit = label-b .
     1172       end.
     1173       else temp-goods2.crit = label-a .
     1174   end.
     1175   run waitfram-hide.
