      849   procedure thbjattr_code_reg :
      850   define input  parameter p-upper-code     as character no-undo .
      851   define input  parameter p-code           as character no-undo .
      852   define output parameter p-label          as character no-undo .
      853   define output parameter p-user-can-edit  as logical   no-undo .
      854   define output parameter p-output-display as logical   no-undo .
      855   define output parameter p-other          as character no-undo .
      856   define output parameter p-prop-list      as character no-undo .
      857   define output parameter p-prop-type-list as character no-undo .
      858   define output parameter p-prop-label-list as character no-undo .
      859   define output parameter p-global          as logical no-undo .
      860   define output parameter p-host           as logical no-undo .
      861   define output parameter p-shop           as logical no-undo .
      862   define output parameter p-store          as logical no-undo .
      863   define output parameter p-db             as logical no-undo .
      864   define output parameter p-region         as logical no-undo .
      865   do
      866   on error undo, return error return-value
      867   :
      868       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      869       (input  p-upper-code
      870       ,input  p-code
      871       ,output p-label
      872       ,output p-user-can-edit
      873       ,output p-output-display
      874       ,output p-other
      875       ,output p-prop-list
      876       ,output p-prop-type-list
      877       ,output p-prop-label-list
      878       ,output p-global
      879       ,output p-host
      880       ,output p-shop
      881       ,output p-store
      882       ,output p-db
      883       ,output p-region
      884       ) no-error .
      885     if error-status :error
      886     then do:
      887       undo, return error substitute( "&1. &2&3&4", vss-include-info4, return-value, chr(10), error-status :get-message (1)).
      888     end.
      889   end.
      890   end procedure.
