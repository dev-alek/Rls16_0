      820      define output parameter p-output-display as logical   no-undo .
      821      define output parameter p-other          as character no-undo .
      822      define output parameter p-prop-list      as character no-undo .
      823      define output parameter p-prop-type-list as character no-undo .
      824      define output parameter p-prop-label-list as character no-undo .
      825      define output parameter p-global          as logical no-undo .
      826      define output parameter p-host           as logical no-undo .
      827      define output parameter p-shop           as logical no-undo .
      828      define output parameter p-store          as logical no-undo .
      829      define output parameter p-db             as logical no-undo .
