      526            TITLE "Атрибуты товара - РЕСТОРАН"
      527            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      528   ASSIGN
      529          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      530          FRAME Dialog-Frame:HIDDEN           = TRUE.
      531   ASSIGN
      532          EDITOR-fbr:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      533   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      534   DO:
      535     APPLY "END-ERROR":U TO SELF.
      536   END.
      537   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      538   DO:
      539     run proc-save in this-procedure no-error.
      540     if error-status:error then return no-apply.
      541   END.
      542   ON CHOOSE OF B-fbr-gds-grp IN FRAME Dialog-Frame
      543   DO:
      544   define variable v-recid-list    as character      no-undo.
      545   define buffer buf_fbr-gds-grp for ub.fbr-gds-grp.
      546   find first buf_fbr-gds-grp where
      547             buf_fbr-gds-grp.node-code = tt-fbr-gds-obj.fbr-grp-code
      548        AND  buf_fbr-gds-grp.OBJ-TYPE = tt-fbr-gds-obj.obj-type
      549        and  buf_fbr-gds-grp.obj-code = tt-fbr-gds-obj.obj-code no-error .
      550   if available buf_fbr-gds-grp then do:
      551     assign
      552     v-recid-list = string(recid(buf_fbr-gds-grp))
      553     .
      554   end.
      555       run ref/fbrggrp.w (
      556             input parparentproc
      557           , input p-obj-type
      558           , input p-obj-code
      559           , input "b-sel"
      560           , input-output v-recid-list
      561       ).
      562       if v-recid-list <> ""
      563       then do:
      564           find first buf_fbr-gds-grp no-lock
      565                where recid( buf_fbr-gds-grp )  = integer( entry( 1, v-recid-list ) )
      566           no-error.
      567           if not available buf_fbr-gds-grp
      568           then do:
      569               return no-apply.
      570           end.
      571           assign
      572               f-fbr-grp-name:screen-value = buf_fbr-gds-grp.node-name
      573               tt-fbr-gds-obj.fbr-grp-code = buf_fbr-gds-grp.node-code
      574               f-out-code = buf_fbr-gds-grp.out-code
      575           .
      576           display
      577           f-out-code
      578           with frame Dialog-Frame.
      579       end.
      580   END.
      581   ON CHOOSE OF B-fbr-obj IN FRAME Dialog-Frame
      582   DO:
      583   def buffer buf_clients for ub.clients .
      584     define variable v-user-select as logical   no-undo .
      585     define variable v-host-code   as integer   no-undo .
      586     define variable v-obj-type    as character no-undo .
      587     define variable v-obj-code    as integer   no-undo .
      588   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      589   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      590     (input  p-obj-type
      591     ,input  p-obj-code
      592     ,output v-host-code
      593     )  .
      594   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      595   run userobjs_select-one in this-procedure
      596     (input  parparentproc
      597     ,input  v-cntxt-db-num
      598     ,input  v-cntxt-userid
      599     ,input  v-host-code
      600     ,input  p-obj-type
      601     ,input  p-obj-code
      602     ,output v-user-select
      603     ,output v-obj-type
      604     ,output v-obj-code
      605     )  .
      606     if v-user-select = true
      607     then do:
      608       find first buf_clients no-lock
      609         where buf_clients.obj-type = v-obj-type
      610           and buf_clients.obj-code = v-obj-code
      611         no-error .
      612       if not available buf_clients then do:
      613         return no-apply.
      614       end.
      615       assign
      616         fbr-obj-name:screen-value                = buf_clients.obj-name
      617         tt-fbr-gds-obj.fbr-obj-code:screen-value = string(buf_clients.obj-code)
      618         tt-fbr-gds-obj.fbr-obj-type:screen-value = string(buf_clients.obj-type)
      619       .
      620           run fbr-warning in this-procedure (tt-fbr-gds-obj.fbr-obj-type:screen-value, tt-fbr-gds-obj.fbr-obj-code:screen-value) no-error.
      621     end.
      622   END.
      623   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
      624   DO:
      625   define variable v-rid-list as character no-undo.
      626     if available loc_fbr-gds-obj then
      627     run ref/cfgdsobs.w (
      628                                   input parparentproc
      629                                 , input "":U
      630                                 , input "one":U
      631                                 , input p-obj-type
      632                                 , input p-obj-code
      633                                 , input p-gds-code
      634                                , output v-rid-list ) no-error.
      635   END.
      636   ON LEAVE OF F-out-code IN FRAME Dialog-Frame
      637   DO:
      638        define buffer buf_fbr-gds-grp for ub.fbr-gds-grp.
      639      define buffer buf_clients     for ub.clients.
      640      find first buf_clients no-lock
      641           where buf_clients.obj-type = p-obj-type
      642             and buf_clients.obj-code = p-obj-code
      643      .
      644     find first buf_fbr-gds-grp no-lock where
      645                buf_fbr-gds-grp.obj-type  = p-obj-type
      646            AND buf_fbr-gds-grp.obj-code  = p-obj-code
      647            AND buf_fbr-gds-grp.out-code = input frame Dialog-Frame  f-out-code
      648     no-error.
      649     if available buf_fbr-gds-grp then do:
      650       assign
      651       f-out-code
      652       tt-fbr-gds-obj.fbr-grp-code = buf_fbr-gds-grp.node-code
      653       f-fbr-grp-name = buf_fbr-gds-grp.node-name.
      654     end.
      655     else do:
      656         assign
      657       tt-fbr-gds-obj.fbr-grp-code = 0
      658       f-fbr-grp-name = "":U
      659       f-out-code = ?
      660       .
      661     end.
      662       display
      663       f-out-code
      664       f-fbr-grp-name
      665       with frame Dialog-Frame.
      666   END.
      667   ON LEAVE OF tt-fbr-gds-obj.fbr-obj-code IN FRAME Dialog-Frame
      668   DO:
      669    define buffer buf_shop for ub.shop.
      670     define buffer buf_clients for ub.clients.
      671     find first buf_shop no-lock where
      672                   buf_shop.obj-code = input frame Dialog-Frame tt-fbr-gds-obj.fbr-obj-code no-error.
      673     if available buf_shop then do:
      674       find first buf_clients no-lock where
      675                   buf_clients.obj-type = 'маг':U
      676              AND buf_clients.obj-code = buf_shop.obj-code .
      677       assign
      678       tt-fbr-gds-obj.fbr-obj-code
      679       tt-fbr-gds-obj.fbr-obj-type = 'маг':U
      680       fbr-obj-name = buf_clients.obj-name.
      681       display
      682      tt-fbr-gds-obj.fbr-obj-code
      683       tt-fbr-gds-obj.fbr-obj-type
      684       fbr-obj-name
      685       with frame Dialog-Frame.
      686          run fbr-warning in this-procedure (tt-fbr-gds-obj.fbr-obj-type:screen-value, tt-fbr-gds-obj.fbr-obj-code:screen-value) no-error.
      687     end.
      688     else do:
      689         assign
      690           tt-fbr-gds-obj.fbr-obj-code = 0
      691           tt-fbr-gds-obj.fbr-obj-type = "":U
      692           fbr-obj-name = "":U.
      693           run fbr-warning in this-procedure (tt-fbr-gds-obj.fbr-obj-type:screen-value, tt-fbr-gds-obj.fbr-obj-code:screen-value) no-error.
      694         if int(tt-fbr-gds-obj.fbr-obj-code:screen-value) > 0 then return no-apply.
      695         else tt-fbr-gds-obj.fbr-obj-type:screen-value = ''.
      696     end.
      697   END.
      698   ON LEAVE OF tt-fbr-gds-obj.fbr-obj-type IN FRAME Dialog-Frame
      699   DO:
      700       run fbr-warning in this-procedure (self:screen-value, tt-fbr-gds-obj.fbr-obj-code:screen-value) no-error.
      701   END.
      702   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      703   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      704   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      705   on help of frame Dialog-Frame
      706   do:
      707     run gbl/app_help.p
      708       (input this-procedure :file-name
      709       ,input ''
      710       ,input ?
      711       ) no-error.
      712     if error-status :error then do:
      713       message
      714         "Ошибка при вызове помощи"
      715         error-status :get-message(1)
      716         view-as alert-box .
      717     end.
      718   end.
      719   run minbtn-set in this-procedure .
      720   on choose of b-help in frame Dialog-Frame
      721   do:
      722     apply "help":u to frame Dialog-Frame .
      723   end.
      724   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      725   procedure minbtn-set :
      726       do
      727           on error undo, return error return-value
      728           :
      729           define variable ii              as integer       no-undo .
      730           define variable fh              as widget-handle no-undo .
      731           define variable hh              as widget-handle no-undo .
      732           define variable v-h             as handle        extent 4 no-undo .
      733           define variable v-name-button   as character     no-undo .
      734           define variable v-help-old-x    as decimal       no-undo .
      735           define variable v-help-old-y    as decimal       no-undo .
      736           define variable v-help-old-size as decimal       no-undo .
      737           define variable v-frame-width   as decimal       no-undo .
      738           define variable jj              as integer       no-undo .
      739           do
      740               on error undo, return error
      741               :
      742               assign
      743                   v-frame-width = frame Dialog-Frame:width - 0.3
      744                   fh            = frame Dialog-Frame:first-child
      745                   hh            = fh:first-child
      746                   ii            = 1
      747                   .
      748               do while valid-handle(hh):
      749                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      750                   do:
      751                       case lc(hh:name) :
      752                           when "b-help" then
      753                               do:
      754                                   hh:load-image-up("cmp/b-help.bmp":u) .
      755                                   hh:load-image-down("cmp/b-help.bmp":u) .
      756                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      757                                   hh:TOOLTIP = "Помощь" .
      758                                   v-help-old-x = hh:column .
      759                                   v-help-old-y = hh:row    .
      760                                   v-help-old-size = hh:width .
      761                                   hh:width-chars = 2.5 .
      762                               end.
      763                           when "b-print" then
      764                               do:
      765                                   hh:load-image("cmp/b-print.bmp":u) .
      766                                   hh:TOOLTIP = "Печать" .
      767                                   v-h[ii] = hh:handle .
      768                                   ii = ii + 1 .
      769                                   hh:width-chars = 3 .
      770                               end.
      771                           when "b-history" or
      772                           when "b-hist" then
      773                               do:
      774                                   hh:load-image("cmp/b-hist.bmp":u) .
      775                                   hh:TOOLTIP = "История" .
      776                                   v-h[ii] = hh:handle .
      777                                   ii = ii + 1 .
      778                                   hh:width-chars = 3 .
      779                               end.
      780                           when "b-sch" then
      781                               do:
      782                                   hh:load-image("cmp/b-sch.bmp":u) .
      783                                   hh:TOOLTIP = "Установка Фильтра" .
      784                                   v-h[ii] = hh:handle .
      785                                   ii = ii + 1 .
      786                                   hh:width-chars = 3 .
      787                               end.
      788                           when "b-hist-user" then
      789                               do:
      790                                   hh:load-image("cmp/b-hist.bmp":u) .
      791                                   hh:TOOLTIP = "История пользователя" .
      792                                   ii = ii + 1 .
      793                               end.
      794                       end case.
      795                   end.
      796                   hh = hh:next-sibling.
      797               end.
      798               b-help:column = v-frame-width - b-help:width-chars.
      799               jj = 0.
      800               repeat ii = 4 to 1 by -1 :
      801                   if valid-handle (v-h[ii] ) then
      802                   do:
      803                       jj  = jj + 1 .
      804                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      805                       v-h[ii]:row    = v-help-old-y .
      806                   end.
      807               end.
      808           end.
      809       end.
      810   end procedure.
      811   MAIN-BLOCK:
      812   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      813      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      814     if check-is-petrol() then do:
      815         message "Запрещено для топливных товаров"
      816         view-as alert-box ERROR.
      817         return error.
      818     end.
      819   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      820     run mainmenu_getcntxt in parparentproc
      821       (output v-cntxt-db-num
      822       ,output v-cntxt-userid
      823       ,output v-cntxt-level
      824       ,output v-cntxt-host-code-obj
      825       ,output v-cntxt-obj-type
      826       ,output v-cntxt-obj-code
      827       ,output v-cntxt-db-num-obj
      828       ,output v-cntxt-is-admin
      829       ) .
      830     if par-mode <> 'ИЗМЕНЕНИЕ':U
      831     and par-mode <> 'ДОБАВЛЕНИЕ':U
      832     and par-mode <> 'ПРОСМОТР':U
      833     and par-mode <> 'template':U
      834     then do:
      835       message
      836       vss-workfile vss-revision vss-description skip
      837        "Неверный параметр вызова par-mode"
      838       view-as alert-box ERROR.
      839       return error.
      840     end.
      841     if par-mode <> 'ДОБАВЛЕНИЕ':U then do:
      842       find first buf_goods no-lock where
      843                  buf_goods.gds-code = p-gds-code no-error.
      844           if not available buf_goods
      845           and par-mode <> 'template':U
      846           then do:
      847           message
      848           vss-workfile vss-revision vss-description skip
      849           "Неверный параметр вызова p-gds-code" p-gds-code
      850           view-as alert-box ERROR.
      851           return error.
      852           end.
      853     end.
      854       find first buf_clients no-lock where
      855                       buf_clients.obj-type = p-obj-type
      856                   AND buf_clients.obj-code = p-obj-code.
      857           if not available buf_clients
      858           or (buf_clients.obj-type <> 'маг':U and buf_clients.obj-type <> 'скл':U)
      859           then do:
      860           message
      861           vss-workfile vss-revision vss-description skip
      862           "Неверные параметры вызова p-obj-type и/или p-obj-code" p-obj-type p-obj-code
      863           view-as alert-box ERROR.
      864           return error.
      865       end.
      866   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      867   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      868     (output v-db-num
      869     )  .
      870       if par-mode <> 'ПРОСМОТР':U and
      871       buf_clients.db-num <> v-db-num then do:
      872           message
      873           vss-workfile vss-revision vss-description skip
      874           "Нельзя редактировать атрибуты товара на объекте-РЕСТОРАН для объекта чужой БД"
      875           view-as alert-box error.
      876           return error.
      877       end.
      878       case PAR-MODE:
      879           WHEN 'ИЗМЕНЕНИЕ':U THEN DO:
      880              do transaction:
      881               find first loc_fbr-gds-obj exclusive-lock where
      882                           loc_fbr-gds-obj.gds-code = p-gds-code
      883                       AND loc_fbr-gds-obj.obj-type = p-obj-type
      884                       AND loc_fbr-gds-obj.obj-code = p-obj-code no-wait no-error.
      885               if not available loc_fbr-gds-obj then do:
      886                   if locked loc_fbr-gds-obj then do:
      887                       message
      888                       "Запись атрибутов товара на объекте-РЕСТОРАН занята"
      889                       view-as alerT-box error.
      890                       return error.
      891                   end.
      892                   else do:
      893                   end.
      894               end.
      895               assign
      896               par-recid = recid(loc_fbr-gds-obj)
      897               .
      898             end.
      899           END.
      900           when 'ПРОСМОТР':U then do:
      901           find first loc_fbr-gds-obj no-lock where
      902                   loc_fbr-gds-obj.gds-code = p-gds-code
      903               AND loc_fbr-gds-obj.obj-type = p-obj-type
      904               AND loc_fbr-gds-obj.obj-code = p-obj-code no-error.
      905           end.
      906           when 'template':U
      907           then do:
      908               if p-gds-code <> 0
      909               then do:
      910                   find first loc_fbr-gds-obj no-lock
      911                        where loc_fbr-gds-obj.gds-code = p-gds-code
      912                          and loc_fbr-gds-obj.obj-type = p-obj-type
      913                          and loc_fbr-gds-obj.obj-code = p-obj-code
      914                   no-error.
      915               end.
      916           end.
      917       end CASE.
      918       run fill-tables in this-procedure .
      919       RUN MyEnable.
      920       if par-mode = 'template':U
      921       then do:
      922           hide
      923               b-hist
      924               f-out-code
      925               b-fbr-gds-grp
      926           in FRAME Dialog-Frame.
      927           assign
      928               frame Dialog-Frame:title = "Выбор атрибутов для группы товаров"
      929           .
      930       end.
      931     WAIT-FOR GO OF FRAME Dialog-Frame.
      932   END.
      933   RUN disable_UI.
      934   PROCEDURE disable_UI :
      935     HIDE FRAME Dialog-Frame.
      936   END PROCEDURE.
      937   PROCEDURE enable_UI :
      938     OPEN QUERY Dialog-Frame FOR EACH tt-fbr-gds-obj SHARE-LOCK.
      939     GET FIRST Dialog-Frame.
      940     DISPLAY F-out-code f-fbr-grp-name fbr-obj-name EDITOR-fbr
      941         WITH FRAME Dialog-Frame.
      942     IF AVAILABLE tt-fbr-gds-obj THEN
      943       DISPLAY tt-fbr-gds-obj.fbr-obj-code tt-fbr-gds-obj.fbr-obj-type
      944             tt-fbr-gds-obj.is-cd tt-fbr-gds-obj.is-menu
      945             tt-fbr-gds-obj.is-semi-finished tt-fbr-gds-obj.is-season
      946             tt-fbr-gds-obj.is-modificator tt-fbr-gds-obj.is-null-price
      947         WITH FRAME Dialog-Frame.
      948     ENABLE B-exit b-quit B-hist B-Help B-fbr-gds-grp F-out-code
      949            tt-fbr-gds-obj.fbr-obj-code tt-fbr-gds-obj.fbr-obj-type B-fbr-obj
      950            tt-fbr-gds-obj.is-cd tt-fbr-gds-obj.is-menu
      951            tt-fbr-gds-obj.is-semi-finished tt-fbr-gds-obj.is-season
      952            tt-fbr-gds-obj.is-modificator tt-fbr-gds-obj.is-null-price
      953         WITH FRAME Dialog-Frame.
      954     VIEW FRAME Dialog-Frame.
      955   END PROCEDURE.
      956   PROCEDURE fbr-warning :
      957   define input parameter p-fbr-obj-type-new like ub.fbr-gds-obj.fbr-obj-type no-undo.
      958   define input parameter p-fbr-obj-code-new like ub.fbr-gds-obj.fbr-obj-code no-undo.
      959   if p-fbr-obj-type-new <> v-fbr-obj-type
      960   OR p-fbr-obj-code-new <> v-fbr-obj-code then do:
      961       assign
      962       Editor-fbr = "ВНИМАНИЕ!" + chr(10) +
      963                    "Смена КУХНИ для товара повлечет за собой смену КУХНИ для данного товара в атрибутах <РЕСТОРАН> на ВСЕХ объектах текущей БД," +
      964                    chr(10) +
      965                    "однако не влечет за собой смену КУХНИ для товара в ПЛАН-МЕНЮ!!!"
      966                    .
      967       display
      968       editor-fbr
      969       with frame Dialog-Frame.
      970   end.
      971   else do:
      972       hide
      973       editor-fbr
      974       in frame Dialog-Frame.
      975   end.
      976   END PROCEDURE.
      977   PROCEDURE fill-tables :
      978   define buffer buf0_fbr-gds-grp for ub.fbr-gds-grp.
      979   define buffer bf_fbr-gds-grp for ub.fbr-gds-grp.
      980   define variable v-node-code like ub.fbr-gds-grp.node-code no-undo .
      981   define variable ii as integer no-undo .
      982   for each tt-fbr-gds-obj:
      983     delete tt-fbr-gds-obj.
      984   end.
      985   if par-mode = 'ДОБАВЛЕНИЕ':U
      986   or (par-mode = 'ИЗМЕНЕНИЕ':U and not available loc_fbr-gds-obj ) then do:
      987     if par-mode <> 'ДОБАВЛЕНИЕ':U then do:
      988       if buf_goods.fbr-grp-code <> ? then do:
      989         find first buf0_fbr-gds-grp no-lock where
      990                   buf0_fbr-gds-grp.obj-type = "":U
      991               AND buf0_fbr-gds-grp.obj-code = 0
      992               AND buf0_fbr-gds-grp.node-code = buf_goods.fbr-grp-code no-error .
      993         if available buf0_fbr-gds-grp then do:
      994           for each bf_fbr-gds-grp no-lock where
      995                   bf_fbr-gds-grp.global-code = buf0_fbr-gds-grp.global-code
      996               AND bf_fbr-gds-grp.obj-type = p-obj-type
      997               AND bf_fbr-gds-grp.obj-code = p-obj-code:
      998             assign
      999             v-node-code = bf_fbr-gds-grp.node-code
     1000             ii = ii + 1
     1001             .
     1002           end.
     1003           if ii = 1 then do:
     1004             find first X_fbr-gds-grp no-lock where
     1005                       X_fbr-gds-grp.obj-type = p-obj-type
     1006                   AND X_fbr-gds-grp.obj-code = p-obj-code
     1007                   AND  X_fbr-gds-grp.node-code = v-node-code no-error .
     1008           end.
     1009         end.
     1010       end.
     1011     end.
     1012   end.
     1013   create tt-fbr-gds-obj.
     1014   case par-mode:
     1015     when 'ДОБАВЛЕНИЕ':U then do:
     1016       assign
     1017       tt-FBR-gds-obj.gds-code = p-gds-code
     1018       tt-FBR-gds-obj.obj-type = p-obj-type
     1019       tt-FBR-gds-obj.obj-code = p-obj-code
     1020       tt-fbr-gds-obj.fbr-grp-code = v-node-code
     1021       .
     1022     end.
     1023     otherwise do:
     1024       if available loc_fbr-gds-obj then do:
     1025         buffer-copy loc_fbr-gds-obj to TT-fbr-gds-OBJ.
     1026       end.
     1027       else do:
     1028         assign
     1029         tt-FBR-gds-obj.gds-code = p-gds-code
     1030         tt-FBR-gds-obj.obj-type = p-obj-type
     1031         tt-FBR-gds-obj.obj-code = p-obj-code
     1032         tt-fbr-gds-obj.fbr-grp-code = v-node-code
     1033         .
     1034       end.
     1035       create tt0-fbr-gds-obj.
     1036       buffer-copy tt-fbr-gds-obj to TT0-fbr-gds-OBJ.
     1037     end.
     1038   END CASE.
     1039   if p-template <> "":U then do:
     1040     assign
     1041     tt-fbr-gds-obj.is-cd   = logical(entry(1, p-template))
     1042     tt-fbr-gds-obj.is-menu = logical(entry(2, p-template))
     1043     tt-fbr-gds-obj.is-modificator = logical(entry(3, p-template))
     1044     tt-fbr-gds-obj.is-null-price = logical(entry(4, p-template))
     1045     tt-fbr-gds-obj.is-season     = logical(entry(5, p-template))
     1046     tt-fbr-gds-obj.is-semi-finished  = logical(entry(6, p-template))
     1047     tt-fbr-gds-obj.fbr-obj-type      = entry(7, p-template)
     1048     tt-fbr-gds-obj.fbr-obj-code      = integer(entry(8, p-template))
     1049     tt-fbr-gds-obj.fbr-grp-code      = integer(entry(9, p-template))
     1050     .
     1051   end.
     1052   END PROCEDURE.
     1053   PROCEDURE MyEnable :
     1054   define buffer other_kitchen for ub.fbr-gds-obj.
     1055   define buffer buf_shop for ub.shop.
     1056   run init-temphost in this-procedure .
     1057   find first buf_shop no-lock where
     1058             buf_shop.obj-code = p-obj-code no-error.
     1059   if not avail loc_fbr-gds-obj then do:
     1060     _temp-obj:
     1061     for each temp-obj no-lock where
     1062              temp-obj.db-num = v-db-num,
     1063         first other_kitchen no-lock where
     1064               other_kitchen.gds-code = p-gds-code
     1065           AND other_kitchen.obj-type = temp-obj.obj-type
     1066           AND other_kitchen.obj-code = temp-obj.obj-code
     1067               :
     1068       assign
     1069       tt-fbr-gds-obj.fbr-obj-type = other_kitchen.fbr-obj-type
     1070       tt-fbr-gds-obj.fbr-obj-code = other_kitchen.fbr-obj-code
     1071       .
     1072       find first X_clients no-lock where
     1073                 X_clients.obj-type = tt-fbr-gds-obj.fbr-obj-type
     1074             AND X_clients.obj-code = tt-fbr-gds-obj.fbr-obj-code no-error .
     1075       leave _temp-obj.
     1076     end.
     1077     assign
     1078     frame Dialog-Frame:title = frame Dialog-Frame:title + chr(32)  + title-mode('ДОБАВЛЕНИЕ':U).
     1079   end.
     1080   else do :
     1081     find first X_fbr-gds-grp no-lock where
     1082                X_fbr-gds-grp.obj-type = p-obj-type
     1083            AND X_fbr-gds-grp.obj-code = p-obj-code
     1084            AND  X_fbr-gds-grp.node-code = tt-fbr-gds-obj.fbr-grp-code no-error .
     1085     find first X_clients no-lock where
     1086                X_clients.obj-type = tt-fbr-gds-obj.fbr-obj-type
     1087           AND X_clients.obj-code = tt-fbr-gds-obj.fbr-obj-code no-error .
     1088     assign
     1089     frame Dialog-Frame:title = frame Dialog-Frame:title + chr(32)  + title-mode(par-mode).
     1090   end.
     1091   assign
     1092   v-fbr-obj-type = tt-fbr-gds-obj.fbr-obj-type
     1093   v-fbr-obj-code= tt-fbr-gds-obj.fbr-obj-code
     1094   .
     1095     IF AVAILABLE tt-fbr-gds-obj THEN
     1096       DISPLAY
     1097       (if avail X_clients then X_clients.obj-name else "":U) @ fbr-obj-name
     1098       tt-fbr-gds-obj.fbr-obj-type
     1099       tt-fbr-gds-obj.fbr-obj-code
     1100       tt-fbr-gds-obj.is-cd
     1101       tt-fbr-gds-obj.is-menu
     1102       tt-fbr-gds-obj.is-modificator
     1103       tt-fbr-gds-obj.is-null-price
     1104       tt-fbr-gds-obj.is-season
     1105       tt-fbr-gds-obj.is-semi-finished
     1106       WITH FRAME Dialog-Frame.
     1107      DISPLAY
     1108     (if avail X_fbr-gds-grp then X_fbr-gds-grp.node-name else "":U) @ f-fbr-grp-name
     1109     (if avail X_fbr-gds-grp then X_fbr-gds-grp.out-code else ?) @ f-out-code
     1110     WITH FRAME Dialog-Frame.
     1111     ENABLE
     1112     b-quit
     1113     B-exit
     1114     b-hist when available loc_fbr-gds-obj
     1115     B-Help
     1116     f-out-code when par-mode <> 'ПРОСМОТР':U
     1117     tt-fbr-gds-obj.fbr-obj-code when par-mode <> 'ПРОСМОТР':U
     1118     tt-fbr-gds-obj.is-menu when par-mode <> 'ПРОСМОТР':U
     1119     tt-fbr-gds-obj.is-modificator when par-mode <> 'ПРОСМОТР':U
     1120     tt-fbr-gds-obj.is-null-price when par-mode <> 'ПРОСМОТР':U
     1121     tt-fbr-gds-obj.is-cd when (par-mode <> 'ПРОСМОТР':U
     1122                           and
     1123                         ((not buf_shop.is-kitchen and not buf_shop.is-kitchen-store )
     1124                           or buf_shop.is-catering
     1125                         )
     1126                        )
     1127     tt-fbr-gds-obj.is-season when par-mode <> 'ПРОСМОТР':U
     1128     tt-fbr-gds-obj.is-semi-finished when par-mode <> 'ПРОСМОТР':U
     1129     b-fbr-gds-grp when par-mode <> 'ПРОСМОТР':U
     1130     b-fbr-obj when (par-mode <> 'ПРОСМОТР':U
     1131                           and
     1132                         ((not buf_shop.is-kitchen and not buf_shop.is-kitchen-store )
     1133                           or buf_shop.is-catering
     1134                         )
     1135                        )
     1136     WITH FRAME Dialog-Frame.
     1137     IF PAR-MODE = 'ПРОСМОТР':U THEN DO:
     1138       ASSIGN
     1139       B-QUIT:LABEL = "&Выход"
     1140       .
     1141       hide
     1142       b-exit in frame Dialog-Frame.
     1143     END.
     1144     VIEW FRAME Dialog-Frame.
     1145   END PROCEDURE.
     1146   PROCEDURE proc-save :
     1147   define variable v-ident as logical no-undo .
     1148   define buffer buf_fbr-gds-grp for ub.fbr-gds-grp.
     1149   define buffer buf_inkas for ub.inkas .
     1150   define buffer buf_bar-code for ub.bar-code .
     1151   define buffer buf_chk-gds for ub.chk-gds .
     1152   assign
     1153   tt-fbr-gds-obj.is-cd                frame Dialog-Frame
     1154   tt-fbr-gds-obj.is-menu
     1155   tt-fbr-gds-obj.is-season
     1156   tt-fbr-gds-obj.is-semi-finished
     1157   f-out-code
     1158   tt-fbr-gds-obj.fbr-obj-code
     1159   tt-fbr-gds-obj.fbr-obj-type
     1160   tt-fbr-gds-obj.is-modificator
     1161   tt-fbr-gds-obj.is-null-price
     1162   .
     1163   if f-out-code = ? then do:
     1164     assign
     1165     tt-fbr-gds-obj.fbr-grp-code = 0
     1166     .
     1167   end.
     1168   else do:
     1169     find buf_fbr-gds-grp no-lock where
     1170               buf_fbr-gds-grp.obj-type = p-obj-type
     1171         AND  buf_fbr-gds-grp.obj-code = p-obj-code
     1172         AND buf_fbr-gds-grp.out-code = f-out-code no-error .
     1173     if not avail buf_fbr-gds-grp then do:
     1174       if  AMBIGUOUS buf_fbr-gds-grp then do:
     1175         message
     1176         "Неверный код группы меню" skip
     1177         "Есть более одной группы мен. с кодом на кассе равным"  f-out-code
     1178         view-as alert-box error .
     1179         return error .
     1180       end.
     1181       else do:
     1182         message
     1183         "Неверный код группы меню"
     1184         view-as alert-box error .
     1185         return error .
     1186       end.
     1187     end.
     1188   end.
     1189   for each buf_bar-code no-lock where buf_bar-code.gds-code = buf_goods.gds-code,
     1190   first buf_chk-gds no-lock where (buf_chk-gds.out-code = "" or buf_chk-gds.out-code = ?)
     1191                               and buf_chk-gds.b-code = buf_bar-code.b-code
     1192                               :
     1193     message
     1194       ("Есть неучтенный чек с этим товаром " + string(buf_chk-gds.doc-code) + chr(10) +
     1195        "Невозможно изменить атрибуты РЕСТОРАН на товаре. Сначала удалите неучтенный чек." + chr(10) +
     1196        "После этого установите атрибуты РЕСТОРАН на товаре и заново примите чек с кассы.")
     1197     view-as alert-box error .
     1198     return error .
     1199   end .
     1200   for each buf_inkas no-lock where buf_inkas.obj-type = v-cntxt-obj-type
     1201                                and buf_inkas.obj-code = v-cntxt-obj-code
     1202                                and buf_inkas.status_ <> 'факт':U,
     1203   each buf_bar-code no-lock where buf_bar-code.gds-code = buf_goods.gds-code,
     1204   first buf_chk-gds no-lock where buf_chk-gds.out-code = buf_inkas.inkas-code
     1205                               and buf_chk-gds.b-code = buf_bar-code.b-code
     1206                               :
     1207     message
     1208       ("Есть незакрытая продажа " + string(buf_inkas.inkas-code) +
     1209        " с этим товаром. Чек " + string(buf_chk-gds.doc-code) + chr(10) +
     1210        "Невозможно изменить атрибуты РЕСТОРАН на товаре. Сначала исключите чек из незакрытой продажи и удалите его." + chr(10) +
     1211        "После этого установите атрибуты РЕСТОРАН на товаре и заново примите чек с кассы.")
     1212     view-as alert-box error .
     1213     return error .
     1214   end .
     1215   if available tt-fbr-gds-obj
     1216   then do:
     1217       assign
     1218           p-template = substitute( "&2&1&3&1&4&1&5&1&6&1&7"
     1219                           , chr(44)
     1220                           , tt-fbr-gds-obj.is-cd
     1221                           , tt-fbr-gds-obj.is-menu
     1222                           , tt-fbr-gds-obj.is-modificator
     1223                           , tt-fbr-gds-obj.is-null-price
     1224                           , tt-fbr-gds-obj.is-season
     1225                           , tt-fbr-gds-obj.is-semi-finished
     1226                                   )
     1227       .
     1228       assign
     1229           p-template = p-template
     1230                       + substitute( "&1&2&1&3&1&4"
     1231                           , chr(44)
     1232                           , tt-fbr-gds-obj.fbr-obj-type
     1233                           , tt-fbr-gds-obj.fbr-obj-code
     1234                           , tt-fbr-gds-obj.fbr-grp-code
     1235                       )
     1236       .
     1237       if par-mode <> 'template':U
     1238       then do:
     1239         if p-update-instantly then do:
     1240           run ref/fgdsobj1.p (
     1241                               input-output par-recid
     1242                           , input (if available loc_fbr-gds-obj
     1243                                       then 'ИЗМЕНЕНИЕ':U
     1244                                       else 'ДОБАВЛЕНИЕ':U)
     1245                           , input no
     1246                           , input p-gds-code
     1247                           , input p-obj-type
     1248                           , input p-obj-code
     1249                           , input tt-fbr-gds-obj.fbr-grp-code
     1250                           , input tt-fbr-gds-obj.fbr-obj-type
     1251                           , input tt-fbr-gds-obj.fbr-obj-code
     1252                           , input tt-fbr-gds-obj.is-cd
     1253                           , input tt-fbr-gds-obj.is-menu
     1254                           , input tt-fbr-gds-obj.is-modificator
     1255                           , input tt-fbr-gds-obj.is-null-price
     1256                           , input tt-fbr-gds-obj.is-season
     1257                           , input tt-fbr-gds-obj.is-semi-finished
     1258                           ) no-error.
     1259           if error-status:error then do:
     1260             if return-value <> '' then do:
     1261               define variable v-rv as character no-undo .
     1262               v-rv = return-value .
     1263               entry(1, v-rv, chr(10)) = ''.
     1264               message
     1265               left-trim(v-rv, chr(10))
     1266               view-as alert-box error.
     1267             end.
     1268   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1269   define variable fh as widget-handle no-undo .
     1270   define variable hh as widget-handle no-undo .
     1271   define variable rv as character no-undo .
     1272   assign
     1273   rv = entry(1, return-value , chr(4)).
     1274   if rv <> "":U then do:
     1275     assign
     1276     fh = frame Dialog-Frame:first-child
     1277     hh = fh:first-child
     1278     .
     1279     do while valid-handle(hh):
     1280       if hh:name = rv then do:
     1281         APPLY "ENTRY" to hh.
     1282         undo ,
     1283         return error.
     1284       end.
     1285       hh = hh:next-sibling.
     1286     end.
     1287   end.
     1288              undo, return error.
     1289           end.
     1290         end.
     1291         else do:
     1292           if par-mode = 'ДОБАВЛЕНИЕ':U then do:
     1293             p-updated = yes.
     1294           end.
     1295           else do:
     1296             buffer-compare tt0-fbr-gds-obj
     1297             to
     1298             tt-fbr-gds-obj
     1299             case-sensitive
     1300             save result in v-ident.
     1301             assign
     1302             p-updated = not v-ident.
     1303           end.
     1304         end.
     1305       end.
     1306   end.
     1307   END PROCEDURE.
     1308   function check-is-petrol returns logical
     1309     (  ):
     1310   define variable v-is-petrolium as logical no-undo .
     1311   define variable v-is-pieces as logical no-undo .
     1312   define buffer lc_goods for ub.goods.
     1313   find first lc_goods no-lock where lc_goods.gds-code = p-gds-code.
     1314   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1315     (
     1316        input lc_goods.artic
     1317     ,  input lc_goods.prod-type
     1318     ,  input lc_goods.prod-code
     1319     , output v-is-petrolium
     1320     , output v-is-pieces
     1321     ) .
     1322   return v-is-petrolium.
     1323   end function.
