        5   DEFINE TEMP-TABLE tt0-fbr-gds-obj NO-UNDO LIKE ub.fbr-gds-obj.
        6   define input parameter parparentproc as widget-handle no-undo .
        7   define input parameter par-mode as character no-undo.
        8   define input parameter p-gds-code like ub.fbr-gds-obj.gds-code no-undo.
        9   define input parameter p-obj-type like ub.fbr-gds-obj.obj-type no-undo.
       10   define input parameter p-obj-code like ub.fbr-gds-obj.obj-code no-undo.
       11   define input parameter p-update-instantly as logical no-undo .
       12   define input-output parameter p-template as character    no-undo.
       13   define output parameter p-updated AS LOGICAL no-undo.
       14   define input-output parameter par-recid as recid no-undo.
       15   def var vss-revision    as character no-undo init "$Revision$":U .
       16   def var vss-author      as character no-undo init "$Author$":U .
       17   def var vss-date        as character no-undo init "$Date$":U .
       18   def var vss-workfile    as character no-undo init "$Workfile$":U .
       19   def var vss-archive     as character no-undo init "$Archive$":U .
       20   def var vss-description as character no-undo init "Атрибуты товара на объекте- РЕСТОРАН".
       21   procedure vss-get-info :
       22     define output parameter p-vss-revision    like vss-revision    no-undo .
       23     define output parameter p-vss-author      like vss-author      no-undo .
       24     define output parameter p-vss-date        like vss-date        no-undo .
       25     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       26     define output parameter p-vss-archive     like vss-archive     no-undo .
       27     define output parameter p-vss-description like vss-description no-undo .
       28     assign
       29       p-vss-revision    = vss-revision
       30       p-vss-author      = vss-author
       31       p-vss-date        = vss-date
       32       p-vss-workfile    = vss-workfile
       33       p-vss-archive     = vss-archive
       34       p-vss-description = vss-description
       35     .
       36   end procedure.
       37   procedure vss-get-parameters :
       38     define output parameter p-vss-parameters as character no-undo .
       39   end procedure.
       40   define new global shared variable g#vssrevis-logger as handle    no-undo .
       41   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       42   define variable v-vssrevis-logger                   as handle    no-undo .
       43   procedure vss-logevent :
       44     define input  parameter p-extra-paramters as character no-undo .
       45     define variable v-vssrevis-parameters as character no-undo .
       46     do
       47     on error undo, return error return-value
       48     :
       49       if  valid-handle(v-vssrevis-logger)
       50       and v-vssrevis-logger :get-signature("logevent") <> ""
       51       then do:
       52         run vss-get-parameters in this-procedure
       53           (output v-vssrevis-parameters
       54           ).
       55         run logevent in v-vssrevis-logger
       56           (input vss-workfile
       57           ,input vss-revision
       58           ,input v-vssrevis-parameters
       59           ,input p-extra-paramters
       60           ).
       61       end.
       62     end.
       63   end procedure.
       64   assign
       65     v-vssrevis-logger = g#vssrevis-logger
       66   .
       67   if  valid-handle(v-vssrevis-logger)
       68   and v-vssrevis-logger :get-signature("logevent") <> ""
       69   then do:
       70     assign
       71       v-vssrevis-logevent = true
       72     .
       73     run vss-logevent in this-procedure (input vss-description) .
       74   end.
       75   define new global shared variable g#language as character no-undo .
       76   if g#language <> '' and g#language <> 'rus':U then do:
       77     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       78   end.
       79   define new global shared variable g#library  as handle no-undo .
       80   define new global shared variable g#library2 as handle no-undo .
       81   define new global shared variable g#lib-trn  as handle no-undo .
       82   define new global shared variable g#lib-trn2 as handle no-undo .
       83   define new global shared variable g#lib-trn3 as handle no-undo .
       84   define new global shared variable g#lib-trn4 as handle no-undo .
       85   procedure proc-alt-shift-f2:
       86     if not ibs.th.gbl.gbl-var:rcode
       87   then
       88     run gbl\inidebug.p .
       89   end.
       90   procedure proc-alt-shift-f3:
       91     run gbl/prvssinf.p
       92       ( input this-procedure
       93       ) .
       94   end.
       95   define variable v-inform-launched as logical no-undo initial false .
       96   procedure proc-alt-shift-f4:
       97     define variable v-action as character no-undo .
       98     if v-inform-launched = false then do:
       99       assign
      100         v-inform-launched = true
      101       .
      102       run gbl/d-inform.w
      103         (  input self
      104         ,  input this-procedure
      105         , output v-action
      106         ) no-error .
      107       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      108       assign
      109         v-inform-launched = false
      110       .
      111     end.
      112   end.
      113   procedure proc-alt-f1:
      114     run gbl/corrhelp.p
      115       (input this-procedure
      116       ) .
      117   end .
      118   on alt-shift-f2 anywhere do:
      119     run proc-alt-shift-f2.
      120   end.
      121   on alt-shift-f3 anywhere do:
      122     run proc-alt-shift-f3 in this-procedure .
      123   end.
      124   on alt-shift-f4 anywhere do:
      125     run proc-alt-shift-f4 in this-procedure.
      126   end.
      127   on alt-f1 anywhere do:
      128     run proc-alt-f1 in this-procedure .
      129   end.
      130   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      131   define  temp-table temp-host no-undo
      132     field host-code like ub.store.host-code
      133     index xpk host-code
      134   .
      135   define  temp-table temp-obj no-undo
      136     field obj-type  like ub.clients.obj-type
      137     field obj-code  like ub.clients.obj-code
      138     field host-code like ub.store.host-code
      139     field db-num    like ub.clients.db-num
      140     index xpk  obj-type obj-code
      141     index xie1 host-code
      142     index xie2 db-num host-code
      143   .
      144   procedure init-temphost:
      145     define buffer buf_store   for ub.store .
      146     define buffer buf_shop    for ub.shop .
      147     define buffer buf_clients for ub.clients .
      148     define buffer buf_db for ub.db .
      149     define buffer buf_temp-host for temp-host .
      150     define buffer buf_temp-obj for temp-obj .
      151     do
      152     on error undo, return error return-value
      153     :
      154       for each buf_store
      155       on error undo, return error
      156       :
      157         find first buf_temp-host
      158           where buf_temp-host.host-code = buf_store.host-code
      159           no-error .
      160         if not available buf_temp-host
      161         then do:
      162           create buf_temp-host .
      163           assign
      164             buf_temp-host.host-code = buf_store.host-code
      165           .
      166         end.
      167         find first buf_clients no-lock
      168           where buf_clients.obj-type = 'скл':U
      169             and buf_clients.obj-code = buf_store.obj-code
      170           no-error .
      171         if not available buf_clients
      172         then do:
      173           message
      174             "Ошибка при поиске клиента" skip
      175             "Клиент" 'скл':U buf_store.obj-code skip
      176             view-as alert-box error .
      177           undo, return error .
      178         end.
      179         create buf_temp-obj .
      180         assign
      181           buf_temp-obj.obj-type  = 'скл':U
      182           buf_temp-obj.obj-code  = buf_store.obj-code
      183           buf_temp-obj.host-code = buf_store.host-code
      184           buf_temp-obj.db-num    = buf_clients.db-num
      185         .
      186       end.
      187       for each buf_shop
      188       on error undo, return error
      189       :
      190         find first buf_temp-host
      191           where buf_temp-host.host-code = buf_shop.host-code
      192           no-error .
      193         if not available buf_temp-host
      194         then do:
      195           create buf_temp-host .
      196           assign
      197             buf_temp-host.host-code = buf_shop.host-code
      198           .
      199         end.
      200         find first buf_clients no-lock
      201           where buf_clients.obj-type = 'маг':U
      202             and buf_clients.obj-code = buf_shop.obj-code
      203           no-error .
      204         if not available buf_clients then do:
      205           message
      206             "Ошибка при поиске клиента" skip
      207             "Клиент" 'маг':U buf_shop.obj-code skip
      208             view-as alert-box error .
      209           undo, return error .
      210         end.
      211         create buf_temp-obj .
      212         assign
      213           buf_temp-obj.obj-type  = 'маг':U
      214           buf_temp-obj.obj-code  = buf_shop.obj-code
      215           buf_temp-obj.host-code = buf_shop.host-code
      216           buf_temp-obj.db-num    = buf_clients.db-num
      217         .
      218       end.
      219     end.
      220   end.
      221   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      222   FUNCTION title-mode RETURNS CHARACTER
      223     ( INPUT pmode as character ) :
      224   DEFINE VARIABLE ptitle-mode as character no-undo.
      225   CASE ENTRY(1, pmode) :
      226     when 'ДОБАВЛЕНИЕ':U then ptitle-mode = "ДОБАВЛЕНИЕ".
      227     when 'ИЗМЕНЕНИЕ':U  then ptitle-mode = "ИЗМЕНЕНИЕ".
      228     when 'ПРОСМОТР':U  then ptitle-mode = "ПРОСМОТР".
      229   END CASE.
      230     RETURN ptitle-mode.
      231   END FUNCTION.
      232   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      233     define variable v-cntxt-db-num        as integer   no-undo .
      234     define variable v-cntxt-userid        as character no-undo .
      235     define variable v-cntxt-level         as character no-undo .
      236     define variable v-cntxt-host-code-obj as integer   no-undo .
      237     define variable v-cntxt-obj-type      as character no-undo .
      238     define variable v-cntxt-obj-code      as integer   no-undo .
      239     define variable v-cntxt-db-num-obj    as integer   no-undo .
      240     define variable v-cntxt-is-admin      as logical   no-undo .
      241   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      242   define temp-table userobjs_temp-user-obj no-undo
      243     field obj-type as character
      244     field obj-code as integer
      245     index xpk is primary unique obj-type obj-code
      246     .
      247   procedure userobjs_clear :
      248     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      249     do
      250     on error undo, return error return-value
      251     :
      252       for each buf_userobjs_temp-user-obj
      253       on error undo, return error return-value
      254       :
      255         delete buf_userobjs_temp-user-obj .
      256       end.
      257     end.
      258   end .
      259   procedure userobjs_object-count :
      260     define output parameter p-total-count as integer   no-undo .
      261     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      262     do
      263     on error undo, return error return-value
      264     :
      265       assign
      266         p-total-count = 0
      267       .
      268       for each buf_userobjs_temp-user-obj
      269       on error undo, return error return-value
      270       :
      271         assign
      272           p-total-count = p-total-count + 1
      273         .
      274       end.
      275     end.
      276   end.
      277   procedure userobjs_append :
      278      define input  parameter p-obj-type as character no-undo .
      279      define input  parameter p-obj-code as integer   no-undo .
      280     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      281     do
      282     on error undo, return error return-value
      283     :
      284       find first buf_userobjs_temp-user-obj
      285         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      286           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      287         no-error .
      288       if not available buf_userobjs_temp-user-obj
      289       then do:
      290         create buf_userobjs_temp-user-obj .
      291         assign
      292           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      293           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      294         .
      295       end.
      296     end.
      297   end.
      298   procedure userobjs_object-exist :
      299     define output parameter p-object-exist as logical   no-undo .
      300     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      301     do
      302     on error undo, return error return-value
      303     :
      304       find first buf_userobjs_temp-user-obj
      305         no-error .
      306       if not available buf_userobjs_temp-user-obj
      307       then do:
      308         assign
      309           p-object-exist = false
      310         .
      311       end.
      312       else do:
      313         assign
      314           p-object-exist = true
      315         .
      316       end.
      317     end.
      318   end.
      319   procedure userobjs_transfer :
      320     define input  parameter p-callback-handle as handle no-undo .
      321     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      322     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      323     do
      324     on error undo, return error return-value
      325     :
      326       if valid-handle(p-callback-handle) <> true
      327       then do:
      328         message
      329           vss-workfile vss-revision vss-description skip
      330           "Ошибка задания входных параметров" skip
      331           "Неизвестный указатель на процедуру" skip
      332           view-as alert-box error .
      333         undo, return error return-value .
      334       end.
      335       if p-callback-handle :get-signature("userobjs_append") = ""
      336       then do:
      337         message
      338           vss-workfile vss-revision vss-description skip
      339           "Ошибка задания входных параметров" skip
      340           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      341                     ,p-callback-handle :file-name
      342                     ) skip
      343           view-as alert-box error .
      344         undo, return error return-value .
      345       end.
      346       for each buf_userobjs_temp-user-obj
      347       on error undo, return error return-value
      348       :
      349         run userobjs_append in p-callback-handle
      350           (input  buf_userobjs_temp-user-obj.obj-type
      351           ,input  buf_userobjs_temp-user-obj.obj-code
      352           ) .
      353       end.
      354     end.
      355   end procedure.
      356   procedure userobjs_select-one :
      357      define input  parameter parparentproc     as widget-handle no-undo .
      358      define input  parameter p-db-num          as integer   no-undo .
      359      define input  parameter p-user-id         as character no-undo .
      360      define input  parameter p-host-code-obj   as integer   no-undo .
      361      define input  parameter p-obj-type        as character no-undo .
      362      define input  parameter p-obj-code        as integer   no-undo .
      363      define output parameter p-user-select     as logical   no-undo .
      364      define output parameter p-select-obj-type as character no-undo .
      365      define output parameter p-select-obj-code as character no-undo .
      366     do
      367     on error undo, return error return-value
