     5131   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5132   run fltfield-add in this-procedure('action', 'Действие', 'hist-action',
     5133   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5134   Filter-Block:
     5135   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     5136       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     5137       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     5138     run gbl/filter.w ( INPUT parparentproc
     5139                      , INPUT filter-point + chr(4) + filter-label
     5140                      , INPUT tbl
     5141                      , INPUT join-tbl
     5142                      , INPUT fld
     5143                      , INPUT lab
     5144                      , INPUT spr
     5145                      , INPUT dim ).
     5146     RUN OpenBr in this-procedure ( input yes, input no, input '':U, input v-corr-user-db-num).
     5147   END.
     5148   END PROCEDURE.
     5149   PROCEDURE proc-br-thbj-attr :
     5150   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5151   if b-sel:sensitive in frame Dialog-Frame then dO:
     5152       if b-mark:sensitive then do:
     5153           apply "choose" to b-mark in frame Dialog-Frame.
     5154       end.
     5155       else do:
     5156           apply "choose" to b-sel in frame Dialog-Frame.
     5157       end.
     5158   end.
     5159   else do:
     5160       if b-lookup:sensitive then
     5161       apply "choose" to b-lookup in frame Dialog-Frame.
     5162   end.
     5163   END PROCEDURE.
     5164   PROCEDURE proc-find-corr-date :
     5165   define input parameter p-next as logical no-undo.
     5166   define input parameter p-date like ub.fin-doc.doc-date no-undo.
     5167   define variable v-date-chr as character no-undo.
     5168   if p-date = ? then return .
     5169   display
     5170   0 @ sch-cli-code
     5171   0 @ sch-db-num
     5172   "":U @ sch-corr-user-name
     5173   with frame Dialog-Frame.
     5174   assign
     5175   v-date-chr = string(day(p-date)) + chr(47) +
     5176                    string(month(p-date)) + chr(47) +
     5177                    string(year(p-date)).
     5178          run OpenBr in this-procedure
     5179           (input false
     5180           ,input true
     5181           ,input substitute("and X_c-thbj-attr.corr-date = &1 "
     5182             , v-date-chr)
     5183           ,input v-corr-user-db-num
     5184           ).
     5185         apply "entry":u to sch-corr-date in frame Dialog-Frame.
     5186   END PROCEDURE.
     5187   PROCEDURE proc-find-db-num :
     5188   define input parameter p-next as logical no-undo.
     5189   define input parameter p-db-num like ub.c-thbj-attr.corr-user-db-num no-undo.
     5190   define variable v-db-num as character no-undo.
     5191   assign
     5192   sch-corr-date = ?
     5193   .
     5194   display
     5195   "":U @ sch-corr-user-name
     5196   0 @ sch-cli-code
     5197   sch-corr-date
     5198   with frame Dialog-Frame.
     5199   assign
     5200   v-db-num = string(p-db-num).
     5201   run OpenBr in this-procedure
     5202       (input false
     5203       ,input p-next
     5204       ,input substitute("and X_c-thbj-attr.corr-user-db-num = &1 "
     5205         , v-db-num)
     5206       ,input v-corr-user-db-num
     5207       ).
     5208   apply "entry":u to sch-db-num in frame Dialog-Frame .
     5209   END PROCEDURE.
     5210   PROCEDURE proc-find-obj-code :
     5211   define input parameter p-next as logical no-undo.
     5212   define input parameter p-obj-code like ub.c-thbj-attr.obj-code no-undo.
     5213   define variable v-obj-code as character no-undo.
     5214   display
     5215   "":U @ sch-corr-user-name
     5216   with frame Dialog-Frame.
     5217   display
     5218   "":U @ sch-corr-user-name
     5219   0 @ sch-db-num
     5220   sch-corr-date
     5221   with frame Dialog-Frame.
     5222   assign
     5223   v-obj-code = string(p-obj-code).
     5224   run OpenBr in this-procedure
     5225       (input false
     5226       ,input p-next
     5227       ,input substitute("and X_c-thbj-attr.obj-code = &1 "
     5228         , v-obj-code)
     5229       ,input v-corr-user-db-num
     5230       ).
     5231   apply "entry":u to sch-cli-code in frame Dialog-Frame .
     5232   END PROCEDURE.
     5233   PROCEDURE proc-find-user :
     5234   define input parameter p-next as logical no-undo.
     5235   define input parameter p-user like ub.c-thbj-attr.corr-user-name no-undo.
     5236   assign
     5237   sch-corr-date = ?.
     5238   display
     5239   0 @ sch-db-num
     5240   sch-corr-date
     5241   0 @ sch-cli-code
     5242   with frame Dialog-Frame.
     5243   p-user = chr(34) + p-user + chr(34).
     5244   run OpenBr in this-procedure
     5245       (input false
     5246       ,input p-next
     5247       ,input substitute("and X_c-thbj-attr.corr-user-name = &1 "
     5248         , p-user)
     5249       ,input v-corr-user-db-num
     5250       ).
     5251   apply "entry":u to sch-corr-user-name in frame Dialog-Frame .
     5252   END PROCEDURE.
     5253   PROCEDURE proc-view-changes :
     5254   define variable v-description as character no-undo .
     5255   for each temp-changes:
     5256       delete temp-changes.
     5257   END.
     5258   if not available X_c-thbj-attr then do:
     5259     Open QUery br-changes for each temp-changes.
     5260     return.
     5261   end.
     5262   run ref/cthbjatv.p (
     5263                      input X_c-thbj-attr.obj-type
     5264                     ,input X_c-thbj-attr.obj-code
     5265                     ,input X_c-thbj-attr.upper-prop-code
     5266                     ,input X_c-thbj-attr.prop-code
     5267                     ,input X_c-thbj-attr.corr-user-db-num
     5268                     ,input X_c-thbj-attr.chip-num
     5269                     ,input ''
     5270                     ,input X_c-thbj-attr.action
     5271                     ,input no
     5272                     ,output v-description
     5273                  ) no-error .
     5274   Open QUery br-changes for each temp-changes.
     5275   assign
     5276   br-changes:title in frame Dialog-Frame = v-description
     5277   .
     5278   END PROCEDURE.
     5279   FUNCTION get-action RETURNS CHARACTER
     5280     ( p-action as integer ) :
     5281   define variable dops as character no-undo.
     5282   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     5283   RETURN dops.
     5284   END FUNCTION.
     5285   FUNCTION get-param-name RETURNS CHARACTER
     5286     (p-upper-prop-code as character, p-prop-code as character, output p-section-name as character ) :
     5287   define variable v-tooltip as character no-undo .
     5288   define variable v-label as character no-undo .
     5289   define variable v-tooltip-code as character no-undo .
     5290   run thbjattr_tooltip in this-procedure (
     5291                 input  p-upper-prop-code
     5292               ,input  p-prop-code
     5293               ,output v-tooltip
     5294               ,output v-label
     5295               ,output v-tooltip-code
     5296               ) no-error .
     5297   p-section-name = v-tooltip.
     5298   if not error-status:error then return v-tooltip-code.
     5299   return substitute("&1:&2", p-upper-prop-code, p-prop-code).
     5300   END FUNCTION.
     5301   FUNCTION get-subject RETURNS CHARACTER
     5302     ( p-subject as character ) :
     5303   define variable v-subject as character no-undo .
     5304   return v-subject.
     5305   END FUNCTION.
