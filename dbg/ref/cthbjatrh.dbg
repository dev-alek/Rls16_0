     1090      define output parameter p-db             as logical no-undo .
     1091      define variable p-region as logical no-undo.
     1092      run thbjattr_code_reg in this-procedure (
     1093                                               p-upper-code,
     1094                                               p-code,
     1095                                               output p-label,
     1096                                               output p-user-can-edit,
     1097                                               output p-output-display,
     1098                                               output p-other,
     1099                                               output p-prop-list,
     1100                                               output p-prop-type-list,
     1101                                               output p-prop-label-list,
     1102                                               output p-global,
     1103                                               output p-host,
     1104                                               output p-shop,
     1105                                               output p-store,
     1106                                               output p-db,
     1107                                               output p-region
     1108                                               ).
     1109   end procedure.
