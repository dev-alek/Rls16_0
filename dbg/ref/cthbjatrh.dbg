     3480   def var sort-labelbr-thbj-attr   as character no-undo .
     3481   def var sort-clmnbr-thbj-attr    as handle    no-undo .
     3482   def var cur-clmnbr-thbj-attr     as handle    no-undo .
     3483   def var cur-clmn-locbr-thbj-attr as integer   no-undo .
     3484   def var re-querybr-thbj-attr     as logical   initial no no-undo .
     3485   on start-search, ctrl-o of br-thbj-attr in frame Dialog-Frame do:
     3486      run sort-brbr-thbj-attr
     3487        (input (if available X_c-thbj-attr
     3488                then recid(X_c-thbj-attr)
     3489                else ?
     3490               )
     3491        ).
     3492   end.
     3493   PROCEDURE sort-brbr-thbj-attr :
     3494     define input parameter p-recid as recid no-undo .
     3495     if re-querybr-thbj-attr = no then do:
     3496       assign
     3497          cur-clmnbr-thbj-attr = br-thbj-attr:current-column in frame Dialog-Frame
     3498       .
     3499       if sort-clmnbr-thbj-attr <> ? then sort-clmnbr-thbj-attr:column-fgcolor = 0.
     3500       if cur-clmnbr-thbj-attr = sort-clmnbr-thbj-attr then do:
     3501         assign
     3502            sort-labelbr-thbj-attr = ""
     3503            sort-clmnbr-thbj-attr = ?
     3504         .
     3505        end.
     3506        else do:
     3507          assign
     3508            sort-labelbr-thbj-attr = cur-clmnbr-thbj-attr:label
     3509            sort-clmnbr-thbj-attr  = cur-clmnbr-thbj-attr
     3510            sort-clmnbr-thbj-attr:column-fgcolor = 4
     3511          .
     3512        end.
     3513      end.
     3514     assign
     3515       cur-clmn-locbr-thbj-attr = 1
     3516     .
     3517     def var column-handle as handle no-undo .
     3518     column-handle = br-thbj-attr:first-column.
     3519     do while valid-handle(column-handle) :
     3520       if column-handle = cur-clmnbr-thbj-attr then do:
     3521         leave .
     3522       end.
     3523       column-handle = column-handle:NEXT-COLUMN.
     3524       assign
     3525         cur-clmn-locbr-thbj-attr = cur-clmn-locbr-thbj-attr + 1
     3526       .
     3527     end.
     3528     case sort-labelbr-thbj-attr:
     3529           when X_c-thbj-attr.corr-date:label in browse br-thbj-attr then DO:    assign       sort-column-name = "X_c-thbj-attr.corr-date"     .     run OpenBr in this-procedure ( input yes, input no, input no, input v-corr-user-db-num).   . END.
     3530           when X_c-thbj-attr.corr-user-db-num:label in browse br-thbj-attr then DO:    assign       sort-column-name = "X_c-thbj-attr.corr-user-db-num"     .     run OpenBr in this-procedure ( input yes, input no, input no, input v-corr-user-db-num).   . END.
     3531       otherwise do:
     3532         assign
     3533           sort-column-name = ""
     3534         .
     3535         run OpenBr in this-procedure ( input yes, input no, input no, input v-corr-user-db-num).
     3536           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-thbj-attr') then do:
     3537             run mv-brw-defaultbr-thbj-attr.
     3538           end.
     3539         if sort-labelbr-thbj-attr <> "" then do:
     3540           assign
     3541             cur-clmnbr-thbj-attr:column-fgcolor = 0
     3542           .
     3543         end.
     3544         assign
     3545           cur-clmn-locbr-thbj-attr = ?
     3546         .
     3547       end.
     3548     end case.
     3549       if cur-clmn-locbr-thbj-attr <> ? then do:
     3550         if can-do( this-procedure:internal-entries, 'ch-clmnbr-thbj-attr') then do:
     3551           run ch-clmnbr-thbj-attr in this-procedure (cur-clmn-locbr-thbj-attr).
     3552         end.
     3553       end.
     3554     if p-recid <> ? then do:
     3555       reposition br-thbj-attr to recid p-recid no-error.
     3556       apply "value-changed" to br-thbj-attr in frame Dialog-Frame.
     3557     end.
     3558     apply "entry" to br-thbj-attr in frame Dialog-Frame.
     3559   END PROCEDURE.
     3560   procedure re-open-query-srt-clmnbr-thbj-attr:
     3561   if cur-clmnbr-thbj-attr = ? then do:
     3562      run OpenBr in this-procedure ( input yes, input no, input no, input v-corr-user-db-num).
     3563   end.
     3564   else do:
     3565      assign re-querybr-thbj-attr = yes.
     3566      run sort-brbr-thbj-attr
     3567        (input (if available X_c-thbj-attr
     3568                then recid(X_c-thbj-attr)
     3569                else ?
     3570               )
     3571        ).
     3572      assign re-querybr-thbj-attr = no.
     3573   end.
     3574   end.
     3575   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3576   do:
     3577     BR-changes :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3578   end.
     3579   MAIN-BLOCK:
     3580   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3581      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3582      if p-mode <> 'все':U
     3583     and p-mode <> "one":U
     3584    and p-mode <> "subject":U
     3585    and p-mode <> "section":U
     3586    then dO:
     3587       message
     3588       vss-workfile vss-revision vss-description skip
     3589       "Неверное значение параметров вызова p-mode"
     3590       p-mode
     3591       view-as alert-box ERROR.
     3592       return.
     3593    end.
     3594    v-rid-list = p-rid-list.
     3595    if p-mode = "one":U then do:
     3596     find first X_thbj-attr no-lock where
     3597                   X_thbj-attr.obj-type = p-obj-type
     3598               AND X_thbj-attr.obj-code = p-obj-code
     3599               and X_thbj-attr.upper-prop-code = p-upper-prop-code
     3600               and X_thbj-attr.prop-code = p-prop-code
     3601               no-error.
     3602       if not available X_thbj-attr then do:
     3603           message
     3604           vss-workfile vss-revision vss-description skip
     3605           "Неверное значение параметра вызова p-cli-type/p-cli-code/p-upper-prop-code/p-prop-code"
     3606           p-obj-type p-obj-code p-upper-prop-code p-prop-code
     3607           view-as alert-box ERROR.
     3608           return.
     3609       end.
     3610     end.
     3611    if p-mode = "section":U then do:
     3612     find first X_thbj-attr no-lock where
     3613                   X_thbj-attr.obj-type = p-obj-type
     3614               AND X_thbj-attr.obj-code = p-obj-code
     3615               and X_thbj-attr.upper-prop-code = p-upper-prop-code
     3616               no-error.
     3617       if not available X_thbj-attr then do:
     3618           message
     3619           vss-workfile vss-revision vss-description skip
     3620           "Неверное значение параметра вызова p-cli-type/p-cli-code/p-upper-prop-code"
     3621           p-obj-type p-obj-code p-upper-prop-code
     3622           view-as alert-box ERROR.
     3623           return.
     3624       end.
     3625     end.
     3626    if p-mode = "db-num":U then do:
     3627     find first X_db no-lock where
     3628                   X_db.db-num = p-corr-user-db-num no-error.
     3629       if not available X_db then do:
     3630           message
     3631           vss-workfile vss-revision vss-description skip
     3632           "Неверное значение параметра вызова p-corr-user-db-num" p-corr-user-db-num
     3633           view-as alert-box ERROR.
     3634           return.
     3635       end.
     3636     end.
     3637     if v-rid-list <> "" then do:
     3638         FIND FIRST find_c-thbj-attr No-LOCK where
     3639                    recid(find_c-thbj-attr) = integer(entry(1, v-rid-list)) No-ERROR.
     3640         if not avail find_c-thbj-attr then do:
     3641           message
     3642           vss-workfile vss-revision vss-description skip
     3643           "Неверное значение параметра вызова v-rid-list" v-rid-list
     3644           view-as alert-box error .
     3645           return error.
     3646         end.
     3647         v-doc-rec = integer(entry(1, v-rid-list)).
     3648       end.
     3649   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3650   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     3651     (output v-db-num
     3652     )  .
     3653     assign
     3654     v-find = yes.
     3655     if p-mode <> 'все':U then do:
     3656       assign
     3657       v-param-name = get-param-name(p-upper-prop-code, p-prop-code, output v-section-name)
     3658       .
     3659     end.
     3660     RUN MyEnable.
     3661     RUn OpenBR in this-procedure ( input yes, input no, input '':U, input v-corr-user-db-num).
     3662     HIDE mark-num in frame Dialog-Frame .
     3663     if v-rid-list <> "":U then
     3664     REPOSITION br-thbj-attr to recid integer(entry(1, v-rid-list)) No-ERROR.
     3665   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3666   DEF VAR cur-clmn-numbr-thbj-attr as INT EXTENT 9 no-undo.
     3667   DEF VAR varmvibr-thbj-attr       as INT no-undo.
     3668   DEF VAR varmvjbr-thbj-attr       as INT no-undo.
     3669   DEF VAR varmvkbr-thbj-attr       as INT no-undo.
     3670   DEF VAR varmvlbr-thbj-attr       as INT no-undo.
     3671   DEF VAR move-elementbr-thbj-attr as INT no-undo.
     3672   def var jjbr-thbj-attr           as int no-undo.
     3673   do varmvibr-thbj-attr = 1 to EXTENT(cur-clmn-numbr-thbj-attr):
     3674     ASSIGN cur-clmn-numbr-thbj-attr[varmvibr-thbj-attr] = varmvibr-thbj-attr.
     3675   END.
     3676   RUN start-mv-clmnbr-thbj-attr.
     3677   PROCEDURE start-mv-clmnbr-thbj-attr:
     3678   def var old-session as logical no-undo.
     3679      old-session = SESSION:IMMEDIATE-DISPLAY.
     3680      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3681          IF  p-mode = 'все':U  THEN DO:
     3682      DO jjbr-thbj-attr = NUM-ENTRIES('1,2,3,4,5,6,7,8,9') TO 1 BY -1:
     3683        RUN re-move-clmnbr-thbj-attr ( cur-clmn-numbr-thbj-attr[INTEGER(ENTRY (jjbr-thbj-attr, '1,2,3,4,5,6,7,8,9'))] , 1).
     3684      END.
     3685          END.
     3686          IF  p-mode <> 'все':U  THEN DO:
     3687      DO jjbr-thbj-attr = NUM-ENTRIES('1,2,3,5,6,7,8,4,9') TO 1 BY -1:
     3688        RUN re-move-clmnbr-thbj-attr ( cur-clmn-numbr-thbj-attr[INTEGER(ENTRY (jjbr-thbj-attr, '1,2,3,5,6,7,8,4,9'))] , 1).
     3689      END.
     3690          END.
     3691      SESSION:IMMEDIATE-DISPLAY = old-session.
     3692   END.
     3693   ON ctrl-cursor-right OF BROWSE br-thbj-attr do:
     3694     RUN re-move-clmnbr-thbj-attr ( 1, 9).
     3695   END.
     3696   ON ctrl-cursor-left OF BROWSE br-thbj-attr do:
     3697     RUN re-move-clmnbr-thbj-attr (9, 1).
     3698   END.
     3699   PROCEDURE re-move-clmnbr-thbj-attr:
     3700     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3701     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3702     DO varmvibr-thbj-attr = 1 TO EXTENT(cur-clmn-numbr-thbj-attr):
     3703       if cur-clmn-numbr-thbj-attr[varmvibr-thbj-attr] = source-column THEN cur-clmn-numbr-thbj-attr[varmvibr-thbj-attr] = -1.
     3704     END.
     3705     if br-thbj-attr:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     3706     if source-column > target-column THEN
     3707     DO varmvjbr-thbj-attr = source-column - 1 to target-column BY -1:
     3708       DO varmvibr-thbj-attr = 1 TO EXTENT(cur-clmn-numbr-thbj-attr):
     3709           if cur-clmn-numbr-thbj-attr[varmvibr-thbj-attr] = varmvjbr-thbj-attr THEN DO:
     3710             cur-clmn-numbr-thbj-attr[varmvibr-thbj-attr] = cur-clmn-numbr-thbj-attr[varmvibr-thbj-attr] + 1.
     3711           END.
     3712       END.
     3713     END.
     3714     ELSE
     3715     DO varmvjbr-thbj-attr = source-column + 1 to target-column:
     3716       DO varmvibr-thbj-attr = 1 TO EXTENT(cur-clmn-numbr-thbj-attr):
     3717         if cur-clmn-numbr-thbj-attr[varmvibr-thbj-attr] = varmvjbr-thbj-attr THEN DO:
     3718           cur-clmn-numbr-thbj-attr[varmvibr-thbj-attr] = cur-clmn-numbr-thbj-attr[varmvibr-thbj-attr] - 1.
     3719         END.
     3720       END.
     3721     END.
     3722     DO varmvibr-thbj-attr = 1 TO EXTENT(cur-clmn-numbr-thbj-attr):
     3723       if cur-clmn-numbr-thbj-attr[varmvibr-thbj-attr] = -1 THEN cur-clmn-numbr-thbj-attr[varmvibr-thbj-attr] = target-column.
     3724     END.
     3725   END PROCEDURE.
     3726   PROCEDURE ch-clmnbr-thbj-attr:
     3727     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3728     if cur-clmn-loc <= 1 then do:
     3729       return .
     3730     end.
     3731     DO varmvibr-thbj-attr = 1 TO EXTENT(cur-clmn-numbr-thbj-attr):
     3732       if cur-clmn-numbr-thbj-attr[varmvibr-thbj-attr] = cur-clmn-loc THEN move-elementbr-thbj-attr = varmvibr-thbj-attr.
     3733     END.
     3734     RUN re-move-clmnbr-thbj-attr (cur-clmn-loc, 1).
     3735   END PROCEDURE.
     3736   PROCEDURE mv-brw-defaultbr-thbj-attr:
     3737   def var old-session as logical no-undo.
     3738     old-session = SESSION:IMMEDIATE-DISPLAY.
     3739     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3740     do varmvlbr-thbj-attr = 1 to EXTENT(cur-clmn-numbr-thbj-attr):
     3741       RUN re-move-clmnbr-thbj-attr (cur-clmn-numbr-thbj-attr[varmvlbr-thbj-attr], varmvlbr-thbj-attr).
     3742     END.
     3743     RUN start-mv-clmnbr-thbj-attr.
     3744     SESSION:IMMEDIATE-DISPLAY = old-session.
     3745   END PROCEDURE.
     3746   .
     3747     run diasize_add_browse in this-procedure
     3748       (input  'width':u
     3749       ,input  browse br-changes :handle
     3750       ) .
     3751     run diasize_init in this-procedure .
     3752     WAIT-FOR GO OF FRAME Dialog-Frame.
     3753   END.
     3754   RUN disable_UI.
     3755   PROCEDURE disable_UI :
     3756     HIDE FRAME Dialog-Frame.
     3757   END PROCEDURE.
     3758   PROCEDURE enable_UI :
     3759     DISPLAY v-corr-user-db-num sch-db-num sch-corr-date sch-cli-code
     3760             sch-corr-user-name mark-num
     3761         WITH FRAME Dialog-Frame.
     3762     ENABLE b-quit B-mark b-sel v-corr-user-db-num b-lookup B-print B-sch B-Help
     3763            br-thbj-attr sch-db-num sch-corr-date sch-cli-code sch-corr-user-name
     3764            BR-changes mark-num
     3765         WITH FRAME Dialog-Frame.
     3766     VIEW FRAME Dialog-Frame.
     3767   END PROCEDURE.
     3768   PROCEDURE MyEnable :
     3769   DEFINE VARIABLE v-h AS handle NO-UNDO.
     3770   assign
     3771   br-thbj-attr:num-locked-columns in frame Dialog-Frame = 1
     3772   X_c-thbj-attr.corr-date:read-only in browse br-thbj-attr = yes
     3773   br-changes:title = "":U
     3774   v-corr-user-db-num = v-db-num
     3775   temp-changes.l_name:resizable in browse br-changes = true
     3776   temp-changes.v_old:resizable in browse br-changes = true
     3777   temp-changes.v_new:resizable in browse br-changes = true
     3778   temp-changes.l_name:width in browse br-changes = 30
     3779   temp-changes.v_old:width in browse br-changes = 40
     3780   temp-changes.v_new:width in browse br-changes = 40
     3781   v-h = br-thbj-attr:FIRST-COLUMN IN FRAME Dialog-Frame
     3782   .
     3783   DO while valid-handle(v-h) :
     3784     if v-h:LABEL = "Назв. пар-ра"
     3785     or v-h:label = "Предмет изменений"
     3786       then do:
     3787       v-h:RESIZABLE = YES.
     3788     end.
     3789     v-h = v-h:next-column.
     3790   END.
     3791   DISPLAY
     3792   v-corr-user-db-num
     3793   sch-db-num
     3794   sch-corr-date
     3795   sch-cli-code
     3796   sch-corr-user-name
     3797   mark-num
     3798   WITH FRAME Dialog-Frame.
     3799   ENABLE
     3800   v-corr-user-db-num
     3801   b-quit
     3802   B-mark when lookup("b-mark":U, bttns) > 0
     3803   b-sel when lookup("b-sel":U, bttns) > 0
     3804   B-sch
     3805   B-Print
     3806   B-Help
     3807   br-thbj-attr
     3808   sch-corr-date
     3809   sch-corr-user-name
     3810   sch-cli-code when p-mode = 'все':U
     3811   sch-db-num when p-mode = 'все':U
     3812   BR-changes mark-num
     3813   WITH FRAME Dialog-Frame.
     3814   VIEW FRAME Dialog-Frame.
     3815   HIDE sch-corr-user-name IN FRAME Dialog-Frame.
     3816   END PROCEDURE.
     3817   PROCEDURE OpenBr :
     3818   define input  parameter p-open-query     as logical   no-undo .
     3819   define input  parameter p-find-next      as logical   no-undo .
     3820   define input  parameter p-find-condition as character no-undo .
     3821   define input  parameter p-db-num like ub.c-thbj-attr.corr-user-db-num no-undo .
     3822   define variable l-query-was-opened as logical no-undo .
     3823   define variable title0 as character no-undo.
     3824   title0 = "Список истории настроек объектов TH" + chr(32).
     3825   run waitfram-show in this-procedure ("Ждите...").
     3826   define variable sort-column-phrase as character no-undo .
     3827   case sort-column-name :
     3828     when "" then do:
     3829       assign
     3830         sort-column-phrase = ""
     3831       .
     3832     end.
     3833     otherwise do:
     3834       assign
     3835         sort-column-phrase = "by " + sort-column-name
     3836       .
     3837     end.
     3838   end case.
     3839   define variable l-open-query as logical   no-undo .
     3840   CASE p-db-num:
     3841     when ? then do:
     3842       CASE p-mode :
     3843         WHEN 'все':U        THEN DO:
     3844         assign
     3845         filter-point = filter-point0 + p-mode
     3846         filter-label = filter-label0
     3847         .
     3848   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3849   define variable  l-disable-where-29  as logical   no-undo .
     3850   define variable  l-filter-open-29    as logical   .
