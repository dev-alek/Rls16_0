     5022   PROCEDURE proc-b-print :
     5023   define variable date_string     as      char    no-undo.
     5024   define variable Line                as      char    no-undo.
     5025   define variable for-time as char.
     5026   define variable accum-count as integer.
     5027   define variable v-doc-rec as recid no-undo.
     5028   define variable v-subject-chr as character no-undo .
     5029   define variable v-upd-time as character no-undo .
     5030   define variable v-obj as character no-undo .
     5031   define variable v-action-chr as character no-undo .
     5032   define variable v-dop as character no-undo .
     5033   DEFINE FRAME HistoryList
     5034   v-obj COLUMN-LABEL "Объект TH" FORMAT "X(12)"
     5035   v-action-chr FORMAT "X(10)" COLUMN-LABEL "Действие"
     5036   v-param-name COLUMN-LABEL "Назв. параметра" FORMAT "X(20)"
     5037   X_c-thbj-attr.is-news COLUMn-LABEL "СПН" FORMAT "+/ "
     5038   X_c-thbj-attr.corr-date
     5039   v-upd-time COLUMN-LABEL "Время изм." FORMAT "X(8)"
     5040   X_c-thbj-attr.corr-user-name
     5041   X_c-thbj-attr.corr-user-db-num
     5042   HEADER  date_string AT 5 format "X(35)"
     5043   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     5044   Line format "X(195)" AT 1
     5045   with width 232 down stream-io use-text    .
     5046   Line = fill("-", 195).
     5047   date_string = cur-time-print() .
     5048   assign
     5049   v-doc-rec = recid( X_c-thbj-attr ).
     5050   DO WHILE available X_c-thbj-attr :
     5051         GET prev br-thbj-attr.
     5052   END.
     5053   run prn-lib-open-stream  in this-procedure (
     5054                                                input parparentProc
     5055                                               ,input 43
     5056                                               ,input yes
     5057                                               ,input no
     5058                                               ).
     5059   PUT  STREAM PrnLibStream
     5060   SPACE(25) ( frame Dialog-Frame:title )
     5061   format "x(90)" SKIP(1) .
     5062   FORM HEADER
     5063   Line format "X(180)" AT 1 SKIP
     5064   "Продолжение - на следующей странице" AT 30 SKIP
     5065   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5066   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     5067   FORM with FRAME HistoryList  .
     5068   run waitfram-show in this-procedure ("Ждите...").
     5069     GET next br-thbj-attr.
     5070       DO WHILE available X_c-thbj-attr :
     5071         Display STREAM PrnLibStream
     5072          X_c-thbj-attr.obj-type + string(X_c-thbj-attr.obj-code) @ v-obj
     5073         get-action(X_c-thbj-attr.action) @ v-action-chr
     5074         (if v-find then get-param-name(X_c-thbj-attr.upper-prop-code, X_c-thbj-attr.prop-code, output v-dop) else "":U )
     5075         @ v-param-name
     5076         X_c-thbj-attr.is-news
     5077         X_c-thbj-attr.corr-date
     5078         string(X_c-thbj-attr.corr-time, "HH:MM:SS":U) @ v-upd-time
     5079         X_c-thbj-attr.corr-user-name
     5080         X_c-thbj-attr.corr-user-db-num
     5081         with FRAME HistoryList .
     5082     DOWN STREAM PrnLibStream 1 with FRAME HistoryList  .
     5083     assign
     5084     accum-count = accum-count + 1
     5085     .
     5086     GET next br-thbj-attr.
     5087   END.
     5088   UNDERLINE  STREAM PrnLibStream
     5089   v-obj
     5090   v-action-chr
     5091   v-param-name
     5092   X_c-thbj-attr.is-news
     5093   X_c-thbj-attr.corr-date
     5094   v-upd-time
     5095   X_c-thbj-attr.corr-user-name
     5096   X_c-thbj-attr.corr-user-db-num
     5097   with FRAME HistoryList .
     5098   DISPLAY STREAM PrnLibStream
     5099   "ИТОГО"  @ v-obj
     5100   string(accum-count)  @ v-action-chr
     5101   with frame HistoryList.
     5102   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     5103   HIDE  STREAM PrnLibStream FRAME CheckList.
     5104   output  STREAM PrnLibStream CLOSE.
     5105   run waitfram-hide in this-procedure.
     5106   run prn-lib-prn-file in this-procedure (
     5107                                             input parparentproc
     5108                                             ,input 8
     5109                                             ).
     5110   reposition br-thbj-attr to recid v-doc-rec no-error.
     5111   apply "entry" to br-thbj-attr in frame Dialog-Frame.
     5112   END PROCEDURE.
