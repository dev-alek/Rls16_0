     1362   define buffer X_cli-grp for ub.cli-grp.
     1363   define variable filter-point as character no-undo init "cthbjatr" .
     1364   define variable filter-point0 as character no-undo init "cthbjatr" .
     1365   define variable filter-label as character no-undo init "Список полной истории настроек объектов IBS TH" .
     1366   define variable filter-label0 as character no-undo init "Список полной истории настроек объектов IBS TH" .
     1367   define variable sort-column-name as character no-undo .
     1368   define variable print-option as character no-undo.
     1369   DEFINE VARIABLE v-db-num like ub.db.db-num no-undo .
     1370   define variable v-doc-rec as recid no-undo .
     1371   define variable v-find as logical no-undo.
     1372   define variable v-param-name as character no-undo .
     1373   define variable v-start-date-chr as character no-undo .
     1374   define variable v-end-date-chr as character no-undo .
     1375   define variable v-subject-chr as character no-undo .
     1376   define variable v-rid-list as character no-undo .
     1377   define variable v-dop as character no-undo .
     1378   define variable v-section-name as character no-undo .
     1379   define variable dops as character no-undo format "X(250)".
     1380   define variable dopst as character no-undo format "X(1)".
     1381   define buffer X_curr_sysconf for ub.sysconf.
     1382   define buffer X_clients-sysconf for ub.clients.
     1383   define buffer X_clients-obj for ub.clients.
     1384   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1385   define NEW SHARED temp-table temp-changes no-undo
     1386   field f_name as character
     1387   field l_name as character
     1388   field v_old as character
     1389   field v_new as character
     1390   field t_name as character
     1391   field num_ as integer
     1392   field uniq-key-rec as character
     1393   field action as integer
     1394   field fNotChange as logical
     1395   index pi is unique primary
     1396   num_
     1397   t_name
     1398   f_name
     1399   index
     1400   Chan
     1401   fnotChange
     1402   t_name
     1403   f_name
     1404   index imain uniq-key-rec
     1405   .
     1406   FUNCTION get-all-fields returns character (p-file-name as character ):
     1407   define variable v-dop as character no-undo .
     1408     find first _file no-lock where _file._file-name = p-file-name no-error .
     1409     if not available _file then return "":U.
     1410     for each _field no-lock where
     1411              _field._file-recid = recid(_file) :
     1412       assign
     1413       v-dop = v-dop + _field._field-name + chr(44)
     1414       .
     1415     end.
     1416     return trim(v-dop).
     1417   END FUNCTION.
     1418   PROCEDURE proc-full-temp-changes :
     1419     define input  parameter p-hst-handle as handle    no-undo .
     1420     define input  parameter p-main-table as character no-undo .
     1421     define input  parameter p-field-list as character no-undo .
     1422     define input  parameter p-label-form as character no-undo .
     1423     define variable h-new-buf         as handle    no-undo .
     1424     define variable h-main-buf        as handle    no-undo .
     1425     define variable h-for-comp        as handle    no-undo .
     1426     define variable v-inform          as character no-undo .
     1427     define variable v-ind             as integer   no-undo .
     1428     define variable v-idx-field-qnty  as integer   no-undo .
     1429     define variable v-num-entries     as integer   no-undo .
     1430     define variable fh                as handle    no-undo .
     1431     define variable fh-main           as handle    no-undo .
     1432     define variable fh-old            as handle    no-undo .
     1433     define variable fh-new            as handle    no-undo .
     1434     define variable v-field-name      as character no-undo .
     1435     define variable v-field-lvl       as character no-undo .
     1436     define variable v-field-form      as character no-undo .
     1437     define variable v-search-exp      as character no-undo .
     1438     define variable v-srch-main       as character no-undo .
     1439     define variable v-word-link       as character no-undo .
     1440     define variable v-av-chip-num     as logical   no-undo .
     1441     define variable v-main-pi-fld-lst as character no-undo .
     1442     define variable v-main-fld-lst    as character no-undo .
     1443     define variable v-delim-list      as character no-undo .
     1444     define variable v-label           as character no-undo .
     1445     define variable v-old-value       as character no-undo case-sensitive.
     1446     define variable v-new-value       as character no-undo case-sensitive.
     1447     define variable v-chg-fields as character no-undo.
     1448     for each temp-changes:
     1449       delete temp-changes.
     1450     end.
     1451     if not p-hst-handle:available then do:
     1452       return .
     1453     end.
     1454     create buffer h-new-buf  for table p-hst-handle .
     1455     create buffer h-main-buf for table p-main-table .
     1456     assign
     1457       v-inform = h-main-buf:index-information(1)
     1458       v-ind    = 2
     1459     .
     1460     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1461     on error undo, return error
     1462     :
     1463       assign
     1464         v-inform = h-main-buf:index-information( v-ind )
     1465         v-ind    = v-ind + 1
     1466       .
     1467     end.
     1468     if v-inform = ?
     1469       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1470       or entry( 3, v-inform, ",":U ) <> "1":U
     1471     then do:
     1472       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1473     end.
     1474     assign
     1475       v-idx-field-qnty = num-entries( v-inform ) - 4
     1476     .
     1477     if v-idx-field-qnty < 2 then do:
     1478       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1479     end.
     1480     assign
     1481       v-srch-main   = "where":U
     1482       v-word-link   = "":U
     1483       v-av-chip-num = false
     1484       v-delim-list  = "":U
     1485     .
     1486     do v-ind = 1 to v-idx-field-qnty by 2
     1487     on error undo, return error
     1488     :
     1489       assign
     1490         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1491         fh                = p-hst-handle:buffer-field( v-field-name )
     1492         fh-main           = h-main-buf:buffer-field( v-field-name )
     1493         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1494         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1495       .
     1496       if fh:data-type ="character":U then do:
     1497         assign
     1498           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1499         .
     1500       end.
     1501       else do:
     1502         assign
     1503           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1504         .
     1505       end.
     1506       if v-delim-list = "":U then do:
     1507         assign
     1508           v-delim-list = ",":U
     1509         .
     1510       end.
     1511       if v-word-link = "":U then do:
     1512         assign
     1513           v-word-link = "and":U
     1514         .
     1515       end.
     1516     end.
     1517     assign
     1518       v-delim-list  = "":U
     1519     .
     1520     do v-ind = 1 to h-main-buf:num-fields
     1521     on error undo, return error
     1522     :
     1523       assign
     1524         fh-main      = h-main-buf:buffer-field( v-ind )
     1525         v-field-name = fh-main:name
     1526       .
     1527         assign
     1528           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1529         .
     1530         if v-delim-list = "":U then do:
     1531           assign
     1532             v-delim-list = ",":U
     1533           .
     1534         end.
     1535     end.
     1536     assign
     1537       v-inform = p-hst-handle:index-information(1)
     1538       v-ind    = 2
     1539     .
     1540     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1541     on error undo, return error
     1542     :
     1543       assign
     1544         v-inform = p-hst-handle:index-information( v-ind )
     1545         v-ind    = v-ind + 1
     1546       .
     1547     end.
     1548     if v-inform = ?
     1549       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1550       or entry( 3, v-inform, ",":U ) <> "1":U
     1551     then do:
     1552       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1553     end.
     1554     assign
     1555       v-idx-field-qnty = num-entries( v-inform ) - 4
     1556     .
     1557     if v-idx-field-qnty < 2 then do:
     1558       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1559     end.
     1560     assign
     1561       v-search-exp  = "where":U
     1562       v-word-link   = "":U
     1563       v-av-chip-num = false
     1564     .
     1565     do v-ind = 1 to v-idx-field-qnty by 2
     1566     on error undo, return error
     1567     :
     1568       assign
     1569         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1570         fh           = p-hst-handle:buffer-field( v-field-name )
     1571         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1572       .
     1573       if v-field-name = "chip-num":U then do:
     1574         assign
     1575           v-search-exp  = substitute( "&1 >", v-search-exp )
     1576           v-av-chip-num = true
     1577         .
     1578       end.
     1579       else do:
     1580         assign
     1581           v-search-exp = substitute( "&1 =", v-search-exp )
     1582         .
     1583       end.
     1584       if fh:data-type ="character":U then do:
     1585         assign
     1586           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1587         .
     1588       end.
     1589       else do:
     1590         assign
     1591           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1592         .
     1593       end.
     1594       if v-word-link = "":U then do:
     1595         assign
     1596           v-word-link = "and":U
     1597         .
     1598       end.
     1599     end.
     1600     if v-av-chip-num = false then do:
     1601       message
     1602         vss-workfile vss-revision vss-description skip
     1603         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1604         "Использование данной процедуры невозможно!" skip
     1605         view-as alert-box error .
     1606       return error .
     1607     end.
     1608     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1609     if not h-new-buf:available then do:
     1610       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1611       if not h-main-buf:available then do:
     1612         assign
     1613           h-for-comp = ?
     1614         .
     1615       end.
     1616       else do:
     1617         assign
     1618           h-for-comp = h-main-buf
     1619         .
     1620       end.
     1621     end.
     1622     else do:
     1623       assign
     1624         h-for-comp = h-new-buf
     1625       .
     1626     end.
     1627     assign
     1628       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1629     .
     1630     do v-ind = 1 to v-num-entries
     1631     on error undo, return error return-value
     1632     :
     1633       assign
     1634         v-field-name = entry( v-ind, v-main-fld-lst )
     1635         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1636         v-old-value  = fh-old:buffer-value()
     1637         v-label      = trim( fh-old:label )
     1638       .
     1639       if ( trim( p-field-list ) <> "":U
     1640            and lookup( v-field-name, p-field-list ) > 0
     1641          )
     1642          or trim( p-field-list ) = "":U
     1643       then do:
     1644         if h-for-comp <> ? then do:
     1645           assign
     1646             fh-new      = h-for-comp:buffer-field( v-field-name )
     1647             v-new-value = fh-new:buffer-value()
     1648           .
     1649         end.
     1650         else do:
     1651           assign
     1652             v-new-value = "":U
     1653           .
     1654         end.
     1655         if v-old-value <> v-new-value
     1656         then do:
     1657           create temp-changes.
     1658           assign
     1659             temp-changes.t_name = p-main-table
     1660             temp-changes.f_name = v-field-name
     1661             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1662             temp-changes.v_old  = trim( v-old-value )
     1663             temp-changes.v_new  = trim( v-new-value )
     1664             temp-changes.num_   = 0
     1665             temp-changes.fNotChange = v-old-value eq v-new-value
     1666           .
     1667         end.
     1668       end.
     1669     end.
     1670     assign
     1671       v-num-entries = num-entries( p-label-form, chr(8) )
     1672     .
     1673     do v-ind = 1 to v-num-entries
     1674     on error undo, return error return-value
     1675     :
     1676       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1677         assign
     1678           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1679           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1680           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1681         .
     1682         find first temp-changes
     1683           where temp-changes.f_name = v-field-name
     1684           no-error .
     1685         if available temp-changes then do:
     1686           if trim( v-field-lvl ) <> "":U then do:
     1687             assign
     1688               temp-changes.l_name = v-field-lvl
     1689             .
     1690           end.
     1691           if trim( v-field-form ) <> "":U then do:
     1692             assign
     1693               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1694             .
     1695             if h-for-comp <> ? then do:
     1696               assign
     1697                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1698               .
     1699             end.
     1700           end.
     1701         end.
     1702       end.
     1703       else do:
     1704         message
     1705           vss-workfile vss-revision vss-description skip
     1706           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1707           substitute( "список для поля '&1': '&2'"
     1708                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1709                       ,entry( v-ind, p-label-form, chr(8) )
     1710                     ) skip
     1711           substitute( "полный список: &2", p-label-form ) skip
     1712           view-as alert-box error .
     1713       end.
     1714     end.
     1715     delete object h-new-buf .
     1716     delete object h-main-buf .
     1717   END PROCEDURE.
     1718   FUNCTION get-action RETURNS CHARACTER
     1719     ( p-action as integer )  FORWARD.
     1720   FUNCTION get-param-name RETURNS CHARACTER
     1721     (p-upper-prop-code as character, p-prop-code as character, output p-section-name as character )  FORWARD.
     1722   FUNCTION get-subject RETURNS CHARACTER
     1723     ( p-subject as character )  FORWARD.
     1724   DEFINE BUTTON B-Help
     1725        LABEL "Помо&щь"
     1726        SIZE 3 BY 1
     1727        BGCOLOR 8 .
     1728   DEFINE BUTTON b-lookup
     1729        LABEL "Button 1"
     1730        SIZE 10 BY 1.
     1731   DEFINE BUTTON B-mark
     1732        LABEL "&*"
     1733        SIZE 3 BY 1.
     1734   DEFINE BUTTON B-print
     1735        LABEL "Пе&чать"
     1736        SIZE 3 BY 1.
     1737   DEFINE BUTTON b-quit AUTO-END-KEY
     1738        LABEL "&Выход"
     1739        SIZE 10 BY 1
     1740        BGCOLOR 8 .
     1741   DEFINE BUTTON B-sch
     1742        LABEL "&Фильтр"
     1743        SIZE 3 BY 1.
     1744   DEFINE BUTTON b-sel AUTO-GO
     1745        LABEL "Вы&бор"
     1746        SIZE 10 BY 1
     1747        BGCOLOR 8 .
     1748   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1749         VIEW-AS TEXT
     1750        SIZE 6 BY 1
     1751        FGCOLOR 4  NO-UNDO.
     1752   DEFINE VARIABLE sch-cli-code AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1753        LABEL "коду"
     1754        VIEW-AS FILL-IN
     1755        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1756   DEFINE VARIABLE sch-corr-date AS DATE FORMAT "99/99/9999":U
     1757        LABEL "Дате изменения"
     1758        VIEW-AS FILL-IN
     1759        SIZE 11 BY 1 NO-UNDO.
     1760   DEFINE VARIABLE sch-corr-user-name AS CHARACTER FORMAT "X(9)":U
     1761        LABEL "пользователю"
     1762        VIEW-AS FILL-IN
     1763        SIZE 12 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1764   DEFINE VARIABLE sch-db-num AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1765        LABEL "БД"
     1766        VIEW-AS FILL-IN
     1767        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1768   DEFINE VARIABLE v-corr-user-db-num AS INTEGER FORMAT ">>>>9":U INITIAL 0
     1769        LABEL "по БД"
     1770        VIEW-AS FILL-IN
     1771        SIZE 6 BY 1 NO-UNDO.
     1772   DEFINE QUERY BR-changes FOR
     1773         temp-changes SCROLLING.
     1774   DEFINE QUERY br-thbj-attr FOR
     1775         X_c-thbj-attr SCROLLING.
     1776   DEFINE BROWSE BR-changes
     1777     QUERY BR-changes DISPLAY
     1778         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1779   temp-changes.v_old COLUMn-LABEL "Было" format "X(255)"
     1780   temp-changes.v_new COLUMn-LABEL "Стало" format "X(255)"
     1781       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.25.
     1782   DEFINE BROWSE br-thbj-attr
     1783     QUERY br-thbj-attr NO-LOCK DISPLAY
     1784         mark-string(recid(X_c-thbj-attr), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1785         X_c-thbj-attr.corr-date FORMAT "99/99/9999":U
     1786         string(X_c-thbj-attr.corr-time, "HH:MM:SS":U) COLUMN-LABEL "Время изм." FORMAT "X(8)":U
     1787         usrfulnf(X_c-thbj-attr.corr-user-name) FORMAT "X(18)":U
     1788         get-action(X_c-thbj-attr.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1789         X_c-thbj-attr.corr-user-db-num FORMAT ">>>>9":U
     1790         X_c-thbj-attr.is-news FORMAT "+/":U
     1791         X_c-thbj-attr.obj-type + string(X_c-thbj-attr.obj-code) COLUMN-LABEL "Объект" FORMAT "X(12)":U
     1792         if v-find then get-param-name(X_c-thbj-attr.upper-prop-code, X_c-thbj-attr.prop-code, output v-dop) else "":U COLUMN-LABEL "Назв. пар-ра" FORMAT "X(25)":U
     1793     ENABLE
     1794         X_c-thbj-attr.corr-date
     1795       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.46.
     1796   DEFINE FRAME Dialog-Frame
     1797        b-quit AT ROW 1 COL 1
     1798        B-mark AT ROW 1 COL 11
     1799        b-sel AT ROW 1 COL 21
     1800        v-corr-user-db-num AT ROW 1 COL 37 COLON-ALIGNED
     1801        b-lookup AT ROW 1 COL 60 WIDGET-ID 2
     1802        B-print AT ROW 1 COL 89
     1803        B-sch AT ROW 1 COL 92
     1804        B-Help AT ROW 1 COL 95
     1805        br-thbj-attr AT ROW 2 COL 1
     1806        sch-db-num AT ROW 13.63 COL 60.13 COLON-ALIGNED
     1807        sch-corr-date AT ROW 13.63 COL 85.75 COLON-ALIGNED
     1808        sch-cli-code AT ROW 13.67 COL 48.13 COLON-ALIGNED
     1809        sch-corr-user-name AT ROW 13.71 COL 22.5 COLON-ALIGNED
     1810        BR-changes AT ROW 14.79 COL 1
     1811        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1812        "ПОИСК ПО" VIEW-AS TEXT
     1813             SIZE 8.38 BY 1 AT ROW 13.63 COL 1.38
     1814             FGCOLOR 4
     1815        SPACE(89.48) SKIP(7.44)
     1816       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1817            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1818            TITLE "История по параметрам"
     1819            CANCEL-BUTTON b-quit.
     1820   ASSIGN
     1821          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1822          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1823   ASSIGN
     1824          b-lookup:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1825   ASSIGN
     1826          br-thbj-attr:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1827   ON GO OF FRAME Dialog-Frame
     1828   DO:
     1829     p-rid-list = v-rid-list.
     1830   END.
     1831   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1832   DO:
     1833     APPLY "END-ERROR":U TO SELF.
     1834   END.
     1835   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1836   DO:
     1837   define variable loc#log as logical no-undo .
     1838     if available X_c-thbj-attr then do:
     1839   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1840   define variable v-str-recid17 as character no-undo .
     1841   define variable v-num-entry17 as integer   no-undo .
     1842   assign
     1843     v-str-recid17 = trim( string( recid( X_c-thbj-attr ) , "->>>>>>>>>>>9":U ) )
     1844     v-num-entry17 = lookup( v-str-recid17 , v-rid-list )
     1845   .
     1846   if v-num-entry17 > 0 then do:
     1847     assign
     1848       entry( v-num-entry17, v-rid-list ) = "":U
     1849       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1850     .
     1851   end.
     1852   else do:
     1853     assign
     1854       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid17
     1855     .
     1856   end.
     1857       loc#log = br-thbj-attr:refresh() .
     1858       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1859           loc#log = br-thbj-attr:select-next-row ().
     1860           apply "VALUE-CHANGED" to br-thbj-attr in frame Dialog-Frame.
     1861       end.
     1862       if num-entries( v-rid-list ) = 0
     1863       then
     1864           hide mark-num in frame Dialog-Frame.
     1865       else
     1866           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1867     end.
     1868     apply "entry" to br-thbj-attr in frame Dialog-Frame.
     1869   END.
     1870   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1871   DO:
     1872       run proc-b-print in this-procedure no-error.
     1873     if error-status:error then return no-apply.
     1874   END.
     1875   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1876   DO:
     1877       run proc-b-sch in this-procedure no-error.
     1878     if error-status:error then return no-apply.
     1879   END.
     1880   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1881   DO:
     1882     if ( available X_c-thbj-attr ) then do:
     1883       if ( v-rid-list = "" ) or b-mark:sensitive = no
     1884       then
     1885       v-rid-list = string( recid( X_c-thbj-attr ) ) .
     1886     end.
     1887   END.
     1888   ON MOUSE-SELECT-DBLCLICK OF br-thbj-attr IN FRAME Dialog-Frame
     1889   DO:
     1890        run proc-br-thbj-attr in this-procedure no-error.
     1891     if error-status:error then return no-apply.
     1892   END.
     1893   ON RETURN OF br-thbj-attr IN FRAME Dialog-Frame
     1894   DO:
     1895       run proc-br-thbj-attr in this-procedure no-error.
     1896     if error-status:error then return no-apply.
     1897   END.
     1898   ON VALUE-CHANGED OF br-thbj-attr IN FRAME Dialog-Frame
     1899   DO:
     1900     run proc-view-changes in this-procedure no-error.
     1901   END.
     1902   ON CTRL-J OF sch-cli-code IN FRAME Dialog-Frame
     1903   DO:
     1904     run proc-find-obj-code in this-procedure(yes, input frame Dialog-Frame sch-cli-code) no-error.
     1905     if error-status:error then return no-apply.
     1906   END.
     1907   ON RETURN OF sch-cli-code IN FRAME Dialog-Frame
     1908   DO:
     1909     run proc-find-obj-code in this-procedure(no, input frame Dialog-Frame sch-cli-code) no-error.
     1910     if error-status:error then return no-apply.
     1911   END.
     1912   ON CTRL-J OF sch-corr-date IN FRAME Dialog-Frame
     1913   DO:
     1914      run proc-find-corr-date in this-procedure(yes, input frame Dialog-Frame sch-corr-date) no-error.
     1915     if error-status:error then return no-apply.
     1916   END.
     1917   ON RETURN OF sch-corr-date IN FRAME Dialog-Frame
     1918   DO:
     1919     run proc-find-corr-date in this-procedure(no, input frame Dialog-Frame sch-corr-date) no-error.
     1920     if error-status:error then return no-apply.
     1921   END.
     1922   ON CTRL-J OF sch-corr-user-name IN FRAME Dialog-Frame
     1923   DO:
     1924     run proc-find-user in this-procedure(yes, input frame Dialog-Frame sch-corr-user-name) no-error.
     1925     if error-status:error then return no-apply.
     1926   END.
     1927   ON RETURN OF sch-corr-user-name IN FRAME Dialog-Frame
     1928   DO:
     1929     run proc-find-user in this-procedure(no, input frame Dialog-Frame sch-corr-user-name) no-error.
     1930     if error-status:error then return no-apply.
     1931   END.
     1932   ON CTRL-J OF sch-db-num IN FRAME Dialog-Frame
     1933   DO:
     1934     run proc-find-db-num in this-procedure(yes, input frame Dialog-Frame sch-db-num) no-error.
     1935     if error-status:error then return no-apply.
     1936   END.
     1937   ON RETURN OF sch-db-num IN FRAME Dialog-Frame
     1938   DO:
     1939     run proc-find-db-num in this-procedure(no, input frame Dialog-Frame sch-db-num) no-error.
     1940     if error-status:error then return no-apply.
     1941   END.
     1942   ON RETURN OF v-corr-user-db-num IN FRAME Dialog-Frame
     1943   DO:
     1944     assign
     1945     v-corr-user-db-num
     1946     .
     1947     RUn OpenBR in this-procedure ( input yes
     1948                                   ,input no
     1949                                   ,input '':U
     1950                                   ,input  v-corr-user-db-num).
     1951   END.
     1952   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1953   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1954   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1955   on help of frame Dialog-Frame
     1956   do:
     1957     run gbl/app_help.p
     1958       (input this-procedure :file-name
     1959       ,input ''
     1960       ,input ?
     1961       ) no-error.
     1962     if error-status :error then do:
     1963       message
     1964         "Ошибка при вызове помощи"
     1965         error-status :get-message(1)
     1966         view-as alert-box .
     1967     end.
     1968   end.
     1969   run minbtn-set in this-procedure .
     1970   on choose of b-help in frame Dialog-Frame
     1971   do:
     1972     apply "help":u to frame Dialog-Frame .
     1973   end.
     1974   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1975   procedure minbtn-set :
     1976       do
     1977           on error undo, return error return-value
     1978           :
     1979           define variable ii              as integer       no-undo .
     1980           define variable fh              as widget-handle no-undo .
     1981           define variable hh              as widget-handle no-undo .
     1982           define variable v-h             as handle        extent 4 no-undo .
     1983           define variable v-name-button   as character     no-undo .
     1984           define variable v-help-old-x    as decimal       no-undo .
     1985           define variable v-help-old-y    as decimal       no-undo .
     1986           define variable v-help-old-size as decimal       no-undo .
     1987           define variable v-frame-width   as decimal       no-undo .
     1988           define variable jj              as integer       no-undo .
     1989           do
     1990               on error undo, return error
     1991               :
     1992               assign
     1993                   v-frame-width = frame Dialog-Frame:width - 0.3
     1994                   fh            = frame Dialog-Frame:first-child
     1995                   hh            = fh:first-child
     1996                   ii            = 1
     1997                   .
     1998               do while valid-handle(hh):
     1999                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2000                   do:
     2001                       case lc(hh:name) :
     2002                           when "b-help" then
     2003                               do:
     2004                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2005                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2006                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2007                                   hh:TOOLTIP = "Помощь" .
     2008                                   v-help-old-x = hh:column .
     2009                                   v-help-old-y = hh:row    .
     2010                                   v-help-old-size = hh:width .
     2011                                   hh:width-chars = 2.5 .
     2012                               end.
     2013                           when "b-print" then
     2014                               do:
     2015                                   hh:load-image("cmp/b-print.bmp":u) .
     2016                                   hh:TOOLTIP = "Печать" .
     2017                                   v-h[ii] = hh:handle .
     2018                                   ii = ii + 1 .
     2019                                   hh:width-chars = 3 .
     2020                               end.
     2021                           when "b-history" or
     2022                           when "b-hist" then
     2023                               do:
     2024                                   hh:load-image("cmp/b-hist.bmp":u) .
     2025                                   hh:TOOLTIP = "История" .
     2026                                   v-h[ii] = hh:handle .
     2027                                   ii = ii + 1 .
     2028                                   hh:width-chars = 3 .
     2029                               end.
     2030                           when "b-sch" then
     2031                               do:
     2032                                   hh:load-image("cmp/b-sch.bmp":u) .
     2033                                   hh:TOOLTIP = "Установка Фильтра" .
     2034                                   v-h[ii] = hh:handle .
     2035                                   ii = ii + 1 .
     2036                                   hh:width-chars = 3 .
     2037                               end.
     2038                           when "b-hist-user" then
     2039                               do:
     2040                                   hh:load-image("cmp/b-hist.bmp":u) .
     2041                                   hh:TOOLTIP = "История пользователя" .
     2042                                   ii = ii + 1 .
     2043                               end.
     2044                       end case.
     2045                   end.
     2046                   hh = hh:next-sibling.
     2047               end.
     2048               b-help:column = v-frame-width - b-help:width-chars.
     2049               jj = 0.
     2050               repeat ii = 4 to 1 by -1 :
     2051                   if valid-handle (v-h[ii] ) then
     2052                   do:
     2053                       jj  = jj + 1 .
     2054                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2055                       v-h[ii]:row    = v-help-old-y .
     2056                   end.
     2057               end.
     2058           end.
     2059       end.
     2060   end procedure.
     2061   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2062   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2063   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2064   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2065   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2066   define variable v-diasize-current-frame-height as decimal   no-undo .
     2067   define variable v-diasize-change-size          as logical   no-undo .
     2068   define variable v-diasize-resize-button        as handle    no-undo .
     2069   define variable v-diasize-wndmax               as logical   no-undo .
     2070   define variable v-diasize-wndstore             as logical   no-undo .
     2071   define variable v-diasize-proc-name            as character no-undo .
     2072   define variable v-diasize-browse-handle        as handle    no-undo .
     2073   define variable v-diasize-browse-number        as integer   no-undo .
     2074   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2075   define temp-table temp-diasize-handle no-undo
     2076     field handle-value  as handle
     2077     field save-position as decimal
     2078     index xpk is primary unique handle-value
     2079     .
     2080   define temp-table temp-browse-handle no-undo
     2081     field browse-type   as character
     2082     field browse-number as integer
     2083     field browse-handle as handle
     2084     field original-size as decimal
     2085     index xpk is primary unique browse-type browse-number
     2086     index xie browse-type browse-handle
     2087   .
     2088   procedure diasize_change-height :
     2089     define input  parameter p-change-value  as decimal   no-undo .
     2090     define input  parameter p-move-resize   as logical   no-undo .
     2091     define variable v-field-group-handle    as handle    no-undo .
     2092     define variable v-object-handle         as handle    no-undo .
     2093     define variable v-frame-height          as decimal   no-undo .
     2094     define variable v-frame-virtual-height  as decimal   no-undo .
     2095     define variable v-browse-height         as decimal   no-undo .
     2096     define variable v-window-height         as decimal   no-undo .
     2097     define variable v-window-virtual-height as decimal   no-undo .
     2098     define variable v-change-sign           as integer   no-undo .
     2099     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2100     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2101     if p-change-value > 0
     2102     then do:
     2103       if frame Dialog-Frame :height + p-change-value
     2104           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2105       then do:
     2106         assign
     2107           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2108                           - (frame Dialog-Frame :height-chars)
     2109         .
     2110         if p-change-value <= 0
     2111         then do:
     2112           run diasize_position-resize-button in this-procedure .
     2113           return .
     2114         end.
     2115       end.
     2116     end.
     2117     if p-change-value < 0
     2118     then do:
     2119       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2120       then do:
     2121         assign
     2122           p-change-value = v-diasize-orig-frame-height
     2123                          - (frame Dialog-Frame :height-chars)
     2124         .
     2125         if p-change-value >= 0
     2126         then do:
     2127           run diasize_position-resize-button in this-procedure .
     2128           return .
     2129         end.
     2130       end.
     2131     end.
     2132     if p-change-value >= 0
     2133     then do:
     2134       assign
     2135         v-change-sign = 1
     2136       .
     2137     end.
     2138     else do:
     2139       assign
     2140         v-change-sign = -1
     2141       .
     2142     end.
     2143     assign
     2144       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2145     .
     2146     if p-change-value = 0
     2147     then do:
     2148       run diasize_position-resize-button in this-procedure .
     2149       return .
     2150     end.
     2151     move_block:
     2152     do
     2153     on error undo move_block, retry move_block
     2154     :
     2155       if retry
     2156       then do:
     2157         do
     2158         on error undo move_block, leave move_block
     2159         :
     2160           if p-change-value > 0
     2161           then do:
     2162             for each buf_temp-diasize-handle
     2163             on error undo, next
     2164             :
     2165               assign
     2166                 v-object-handle = buf_temp-diasize-handle.handle-value
     2167               .
     2168               if v-object-handle <> v-diasize-resize-button
     2169               then do:
     2170                 assign
     2171                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2172                 .
     2173               end.
     2174             end.
     2175             assign
     2176               v-diasize-browse-handle :height = v-browse-height
     2177             .
     2178             for each buf_temp-browse-handle
     2179               where buf_temp-browse-handle.browse-type = 'height':u
     2180             on error undo, next
     2181             :
     2182               assign
     2183                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2184               .
     2185             end.
     2186             assign
     2187               frame Dialog-Frame :height = v-frame-height
     2188             .
     2189             if frame Dialog-Frame :scrollable = true
     2190             then do:
     2191               assign
     2192                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2193               .
     2194             end.
     2195             run diasize_position-resize-button in this-procedure .
     2196           end.
     2197           else do:
     2198             if frame Dialog-Frame :scrollable = true
     2199             then do:
     2200               assign
     2201                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2202               .
     2203             end.
     2204             assign
     2205               frame Dialog-Frame :height = v-frame-height
     2206             .
     2207             assign
     2208               v-diasize-browse-handle :height = v-browse-height
     2209             .
     2210             for each buf_temp-browse-handle
     2211               where buf_temp-browse-handle.browse-type = 'height':u
     2212             on error undo, next
     2213             :
     2214               assign
     2215                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2216               .
     2217             end.
     2218             for each buf_temp-diasize-handle
     2219             on error undo, next
     2220             :
     2221               assign
     2222                 v-object-handle = buf_temp-diasize-handle.handle-value
     2223               .
     2224               if v-object-handle <> v-diasize-resize-button
     2225               then do:
     2226                 assign
     2227                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2228                 .
     2229               end.
     2230             end.
     2231             run diasize_position-resize-button in this-procedure .
     2232           end.
     2233           assign
     2234             v-diasize-change-size = false
     2235           .
     2236           leave move_block .
     2237         end.
     2238       end.
     2239       assign
     2240         v-diasize-need-full-display = true
     2241       .
     2242       if v-diasize-change-size = false
     2243       then do:
     2244         assign
     2245           v-diasize-change-size = true
     2246         .
     2247       end.
     2248       else do:
     2249         return .
     2250       end.
     2251       assign
     2252         v-frame-height = frame Dialog-Frame :height
     2253         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2254         v-browse-height = v-diasize-browse-handle :height
     2255       .
     2256       for each buf_temp-browse-handle
     2257         where buf_temp-browse-handle.browse-type = 'height':u
     2258       :
     2259         assign
     2260           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2261         .
     2262       end.
     2263       for each buf_temp-diasize-handle
     2264       :
     2265         delete buf_temp-diasize-handle .
     2266       end.
     2267       assign
     2268         v-field-group-handle = frame Dialog-Frame :first-child
     2269       .
     2270       do while valid-handle(v-field-group-handle)
     2271       :
     2272         assign
     2273           v-object-handle = v-field-group-handle :first-child
     2274         .
     2275         do while valid-handle(v-object-handle)
     2276         :
     2277           if  v-object-handle <> v-diasize-browse-handle :handle
     2278           and can-query(v-object-handle, "row")
     2279           and can-query(v-object-handle, "height")
     2280           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2281           then do:
     2282             find first buf_temp-browse-handle
     2283               where buf_temp-browse-handle.browse-type   = 'height':u
     2284                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2285               no-error .
     2286             if available buf_temp-browse-handle
     2287             then do:
     2288             end.
     2289             else do:
     2290               create buf_temp-diasize-handle .
     2291               assign
     2292                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2293                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2294               .
     2295             end.
     2296           end.
     2297           assign
     2298             v-object-handle = v-object-handle :next-sibling
     2299           .
     2300         end.
     2301         assign
     2302           v-field-group-handle = v-field-group-handle :next-sibling
     2303         .
     2304       end.
     2305       do with frame Dialog-Frame
     2306       :
     2307         hide v-diasize-resize-button .
     2308         assign
     2309           v-diasize-resize-button :row    = 1
     2310           v-diasize-resize-button :column = 1
     2311         .
     2312       end.
     2313       if p-change-value > 0
     2314       then do:
     2315         if frame Dialog-Frame :scrollable = true
     2316         then do:
     2317           assign
     2318             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2319             no-error .
     2320           if error-status :error
     2321           or error-status :get-message(1) <> ""
     2322           then do:
     2323             undo move_block, retry move_block .
     2324           end.
     2325         end.
     2326         assign
     2327           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2328           no-error .
     2329         if error-status :error
     2330         or error-status :get-message(1) <> ""
     2331         then do:
     2332           undo move_block, retry move_block .
     2333         end.
     2334         assign
     2335           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2336           no-error .
     2337         if error-status :error
     2338         or error-status :get-message(1) <> ""
     2339         then do:
     2340           undo move_block, retry move_block .
     2341         end.
     2342         for each buf_temp-browse-handle
     2343           where buf_temp-browse-handle.browse-type = 'height':u
     2344         on error undo move_block, retry move_block
     2345         :
     2346           assign
     2347             buf_temp-browse-handle.browse-handle :height
     2348               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2349             no-error .
     2350           if error-status :error
     2351           or error-status :get-message(1) <> ""
     2352           then do:
     2353             undo move_block, retry move_block .
     2354           end.
     2355         end.
     2356         for each buf_temp-diasize-handle
     2357         on error undo move_block, retry move_block
     2358         :
     2359           assign
     2360             v-object-handle = buf_temp-diasize-handle.handle-value
     2361           .
     2362           if v-object-handle <> v-diasize-resize-button
     2363           then do:
     2364             assign
     2365               v-object-handle :row = v-object-handle :row + p-change-value
     2366               no-error .
     2367             if error-status :error
     2368             or error-status :get-message(1) <> ""
     2369             then do:
     2370               undo move_block, retry move_block .
     2371             end.
     2372           end.
     2373         end.
     2374       end.
     2375       else do:
     2376         for each buf_temp-diasize-handle
     2377         on error undo move_block, retry move_block
     2378         :
     2379           assign
     2380             v-object-handle = buf_temp-diasize-handle.handle-value
     2381           .
     2382           if v-object-handle <> v-diasize-resize-button
     2383           then do:
     2384             assign
     2385               v-object-handle :row = v-object-handle :row + p-change-value
     2386               no-error .
     2387             if error-status :error
     2388             or error-status :get-message(1) <> ""
     2389             then do:
     2390               undo move_block, retry move_block .
     2391             end.
     2392           end.
     2393         end.
     2394         assign
     2395           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2396           no-error .
     2397         if error-status :error
     2398         or error-status :get-message(1) <> ""
     2399         then do:
     2400           undo move_block, retry move_block .
     2401         end.
     2402         for each buf_temp-browse-handle
     2403           where buf_temp-browse-handle.browse-type = 'height':u
     2404         on error undo move_block, retry move_block
     2405         :
     2406           assign
     2407             buf_temp-browse-handle.browse-handle :height
     2408               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2409             no-error .
     2410           if error-status :error
     2411           or error-status :get-message(1) <> ""
     2412           then do:
     2413             undo move_block, retry move_block .
     2414           end.
     2415         end.
     2416         assign
     2417           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2418           no-error .
     2419         if error-status :error
     2420         or error-status :get-message(1) <> ""
     2421         then do:
     2422           undo move_block, retry move_block .
     2423         end.
     2424         if frame Dialog-Frame :scrollable = true
     2425         then do:
     2426           assign
     2427             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2428             no-error .
     2429           if error-status :error
     2430           or error-status :get-message(1) <> ""
     2431           then do:
     2432             undo move_block, retry move_block .
     2433           end.
     2434         end.
     2435       end.
     2436       if p-move-resize = true
     2437       then do:
     2438         run diasize_position-resize-button in this-procedure .
     2439       end.
     2440       if v-diasize-wndstore = true
     2441       then do:
     2442         if connected("ub") = true
     2443         then do:
     2444           define variable v-cntxt-db-num        as integer   no-undo .
     2445           define variable v-cntxt-userid        as character no-undo .
     2446           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2447                                             , OUTPUT v-cntxt-userid
     2448                                             ) .
     2449           run gbl/wndsizew.p
     2450             (input  v-cntxt-db-num
     2451             ,input  v-cntxt-userid
     2452             ,input  v-diasize-proc-name
     2453             ,input  'height':u
     2454             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2455             ) .
     2456         end.
     2457       end.
     2458     end.
     2459     assign
     2460       v-diasize-change-size = false
     2461     .
     2462   end procedure.
     2463   procedure diasize_set-height :
     2464     define input  parameter p-new-height  as decimal   no-undo .
     2465     define input  parameter p-move-resize as logical   no-undo .
     2466     do
     2467     on error undo, return error return-value
     2468     :
     2469       run diasize_change-height in this-procedure
     2470         (input  (p-new-height - frame Dialog-Frame :height)
     2471         ,input  p-move-resize
     2472         ) .
     2473     end.
     2474   end procedure.
     2475   procedure diasize_change-width :
     2476     define input  parameter p-change-value as decimal   no-undo .
     2477     define input  parameter p-move-resize  as logical   no-undo .
     2478     define variable v-field-group-handle   as handle    no-undo .
     2479     define variable v-object-handle        as handle    no-undo .
     2480     define variable v-frame-width          as decimal   no-undo .
     2481     define variable v-frame-virtual-width  as decimal   no-undo .
     2482     define variable v-browse-width         as decimal   no-undo .
     2483     define variable v-window-width         as decimal   no-undo .
     2484     define variable v-window-virtual-width as decimal   no-undo .
     2485     define variable v-change-sign          as integer   no-undo .
     2486     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2487     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2488     if p-change-value > 0
     2489     then do:
     2490       if frame Dialog-Frame :width + p-change-value >
     2491           session :width-chars
     2492       then do:
     2493         assign
     2494           p-change-value = session :width-chars - frame Dialog-Frame :width
     2495         .
     2496         if p-change-value <= 0
     2497         then do:
     2498           run diasize_position-resize-button in this-procedure .
     2499           return .
     2500         end.
     2501       end.
     2502     end.
     2503     if p-change-value < 0
     2504     then do:
     2505       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2506       then do:
     2507         assign
     2508           p-change-value = v-diasize-orig-frame-width
     2509                          - frame Dialog-Frame :width
     2510         .
     2511         if p-change-value >= 0
     2512         then do:
     2513           run diasize_position-resize-button in this-procedure .
     2514           return .
     2515         end.
     2516       end.
     2517     end.
     2518     if p-change-value >= 0
     2519     then do:
     2520       assign
     2521         v-change-sign = 1
     2522       .
     2523     end.
     2524     else do:
     2525       assign
     2526         v-change-sign = -1
     2527       .
     2528     end.
     2529     assign
     2530       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2531     .
     2532     if p-change-value = 0
     2533     then do:
     2534       run diasize_position-resize-button in this-procedure .
     2535       return .
     2536     end.
     2537     move_block:
     2538     do
     2539     on error undo move_block, leave move_block
     2540     :
     2541       if retry
     2542       then do:
     2543         do
     2544         on error undo move_block, leave move_block
     2545         :
     2546           if p-change-value > 0
     2547           then do:
     2548             for each buf_temp-diasize-handle
     2549             on error undo, next
     2550             :
     2551               assign
     2552                 v-object-handle = buf_temp-diasize-handle.handle-value
     2553               .
     2554               if v-object-handle <> v-diasize-resize-button
     2555               then do:
     2556                 assign
     2557                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2558                 .
     2559               end.
     2560             end.
     2561             assign
     2562               v-diasize-browse-handle :width = v-browse-width
     2563             .
     2564             for each buf_temp-browse-handle
     2565               where buf_temp-browse-handle.browse-type = 'width':u
     2566             on error undo, next
     2567             :
     2568               assign
     2569                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2570               .
     2571             end.
     2572             assign
     2573               frame Dialog-Frame :width = v-frame-width
     2574             .
     2575             if frame Dialog-Frame :scrollable = true
     2576             then do:
     2577               assign
     2578                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2579               .
     2580             end.
     2581             run diasize_position-resize-button in this-procedure .
     2582           end.
     2583           else do:
     2584             if frame Dialog-Frame :scrollable = true
     2585             then do:
     2586               assign
     2587                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2588               .
     2589             end.
     2590             assign
     2591               frame Dialog-Frame :width = v-frame-width
     2592             .
     2593             for each buf_temp-browse-handle
     2594               where buf_temp-browse-handle.browse-type = 'width':u
     2595             on error undo, next
     2596             :
     2597               assign
     2598                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2599               .
     2600             end.
     2601             assign
     2602               v-diasize-browse-handle :width = v-browse-width
     2603             .
     2604             for each buf_temp-diasize-handle
     2605             on error undo, next
     2606             :
     2607               assign
     2608                 v-object-handle = buf_temp-diasize-handle.handle-value
     2609               .
     2610               if v-object-handle <> v-diasize-resize-button
     2611               then do:
     2612                 assign
     2613                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2614                 .
     2615               end.
     2616             end.
     2617             run diasize_position-resize-button in this-procedure .
     2618           end.
     2619           assign
     2620             v-diasize-change-size = false
     2621           .
     2622           leave move_block .
     2623         end.
     2624       end.
     2625       assign
     2626         v-diasize-need-full-display = true
     2627       .
     2628       if v-diasize-change-size = false
     2629       then do:
     2630         assign
     2631           v-diasize-change-size = true
     2632         .
     2633       end.
     2634       else do:
     2635         return .
     2636       end.
     2637       assign
     2638         v-frame-width = frame Dialog-Frame :width
     2639         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2640         v-browse-width = v-diasize-browse-handle :width
     2641       .
     2642       for each buf_temp-browse-handle
     2643         where buf_temp-browse-handle.browse-type = 'width':u
     2644       :
     2645         assign
     2646           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2647         .
     2648       end.
     2649       for each buf_temp-diasize-handle
     2650       :
     2651         delete buf_temp-diasize-handle .
     2652       end.
     2653       assign
     2654         v-field-group-handle = frame Dialog-Frame :first-child
     2655       .
     2656       do while valid-handle(v-field-group-handle)
     2657       :
     2658         assign
     2659           v-object-handle = v-field-group-handle :first-child
     2660         .
     2661         do while valid-handle(v-object-handle)
     2662         :
     2663           if  v-object-handle <> v-diasize-browse-handle :handle
     2664           and v-object-handle <> v-diasize-resize-button
     2665           and can-query(v-object-handle, "row")
     2666           and can-query(v-object-handle, "height")
     2667           and ( v-object-handle :col + v-object-handle :width
     2668                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2669               )
     2670           then do:
     2671             find first buf_temp-browse-handle
     2672               where buf_temp-browse-handle.browse-type   = 'width':u
     2673                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2674               no-error .
     2675             if available buf_temp-browse-handle
     2676             then do:
     2677             end.
     2678             else do:
     2679               create buf_temp-diasize-handle .
     2680               assign
     2681                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2682                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2683               .
     2684             end.
     2685           end.
     2686           assign
     2687             v-object-handle = v-object-handle :next-sibling
     2688           .
     2689         end.
     2690         assign
     2691           v-field-group-handle = v-field-group-handle :next-sibling
     2692         .
     2693       end.
     2694       do with frame Dialog-Frame
     2695       :
     2696         hide v-diasize-resize-button .
     2697         v-diasize-resize-button :row = 1.
     2698         v-diasize-resize-button :column = 1.
     2699       end.
     2700       if p-change-value > 0
     2701       then do:
     2702         if frame Dialog-Frame :scrollable = true
     2703         then do:
     2704           assign
     2705             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2706             no-error .
     2707           if error-status :error
     2708           or error-status :get-message(1) <> ""
     2709           then do:
     2710             undo move_block, retry move_block.
     2711           end.
     2712         end.
     2713         assign
     2714           frame Dialog-Frame :width = v-frame-width + p-change-value
     2715           no-error .
     2716         if error-status :error
     2717         or error-status :get-message(1) <> ""
     2718         then do:
     2719           undo move_block, retry move_block.
     2720         end.
     2721         assign
     2722           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2723         no-error .
     2724         if error-status :error
     2725         or error-status :get-message(1) <> ""
     2726         then do:
     2727           undo move_block, retry move_block.
     2728         end.
     2729         for each buf_temp-browse-handle
     2730           where buf_temp-browse-handle.browse-type = 'width':u
     2731         on error undo move_block, retry move_block
     2732         :
     2733           assign
     2734             buf_temp-browse-handle.browse-handle :width
     2735               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2736             no-error .
     2737           if error-status :error
     2738           or error-status :get-message(1) <> ""
     2739           then do:
     2740             undo move_block, retry move_block .
     2741           end.
     2742         end.
     2743         for each buf_temp-diasize-handle
     2744         on error undo move_block, retry move_block
     2745         :
     2746           assign
     2747             v-object-handle = buf_temp-diasize-handle.handle-value
     2748           .
     2749           if v-object-handle <> v-diasize-resize-button
     2750           then do:
     2751             assign
     2752               v-object-handle :col = v-object-handle :col + p-change-value
     2753               no-error .
     2754             if error-status :error
     2755             or error-status :get-message(1) <> ""
     2756             then do:
     2757               undo move_block, retry move_block .
     2758             end.
     2759           end.
     2760         end.
     2761       end.
     2762       else do:
     2763         for each buf_temp-diasize-handle
     2764         on error undo move_block, retry move_block
     2765         :
     2766           assign
     2767             v-object-handle = buf_temp-diasize-handle.handle-value
     2768           .
     2769           if v-object-handle <> v-diasize-resize-button
     2770           then do:
     2771             assign
     2772               v-object-handle :col = v-object-handle :col + p-change-value
     2773               no-error .
     2774             if error-status :error
     2775             or error-status :get-message(1) <> ""
     2776             then do:
     2777               undo move_block, retry move_block .
     2778             end.
     2779           end.
     2780         end.
     2781         for each buf_temp-browse-handle
     2782           where buf_temp-browse-handle.browse-type = 'width':u
     2783         on error undo move_block, retry move_block
     2784         :
     2785           assign
     2786             buf_temp-browse-handle.browse-handle :width
     2787               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2788             no-error .
     2789           if error-status :error
     2790           or error-status :get-message(1) <> ""
     2791           then do:
     2792             undo move_block, retry move_block .
     2793           end.
     2794         end.
     2795         assign
     2796           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2797           no-error .
     2798         if error-status :error
     2799         or error-status :get-message(1) <> ""
     2800         then do:
     2801           undo move_block, retry move_block.
     2802         end.
     2803         assign
     2804           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2805         no-error .
     2806         if error-status :error
     2807         or error-status :get-message(1) <> ""
     2808         then do:
     2809           undo move_block, retry move_block.
     2810         end.
     2811         if frame Dialog-Frame :scrollable = true
     2812         then do:
     2813           assign
     2814             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2815           no-error .
     2816           if error-status :error
     2817           or error-status :get-message(1) <> ""
     2818           then do:
     2819             undo move_block, retry move_block.
     2820           end.
     2821         end.
     2822       end.
     2823       if p-move-resize
     2824       then do:
     2825         run diasize_position-resize-button in this-procedure .
     2826       end.
     2827       if v-diasize-wndstore = true
     2828       then do:
     2829         if connected("ub") = true
     2830         then do:
     2831           define variable v-cntxt-db-num        as integer   no-undo .
     2832           define variable v-cntxt-userid        as character no-undo .
     2833           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2834                                             , OUTPUT v-cntxt-userid
     2835                                             ) .
     2836           run gbl/wndsizew.p
     2837             (input  v-cntxt-db-num
     2838             ,input  v-cntxt-userid
     2839             ,input  v-diasize-proc-name
     2840             ,input  'width':u
     2841             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2842             ) .
     2843         end.
     2844       end.
     2845     end.
     2846     assign
     2847       v-diasize-change-size = false
     2848     .
     2849   end procedure.
     2850   procedure diasize_set-width :
     2851     define input  parameter p-new-width  as decimal   no-undo .
     2852     define input  parameter p-move-resize as logical   no-undo .
     2853     do
     2854     on error undo, return error return-value
     2855     :
     2856       run diasize_change-width in this-procedure
     2857         (input  (p-new-width - frame Dialog-Frame :width)
     2858         ,input  p-move-resize
     2859         ) .
     2860     end.
     2861   end procedure.
     2862   procedure diasize_position-resize-button :
     2863     do with frame Dialog-Frame
     2864     :
     2865       hide v-diasize-resize-button .
     2866       assign
     2867         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2868                     - 1
     2869                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2870         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2871                     - 1
     2872                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2873       .
     2874       view v-diasize-resize-button .
     2875     end.
     2876   end procedure.
     2877   on alt-right anywhere
     2878   do:
     2879     run diasize_change-width in this-procedure
     2880       (input 1
     2881       ,input true
     2882       ) .
     2883     return no-apply .
     2884   end.
     2885   on alt-left anywhere
     2886   do:
     2887     run diasize_change-width in this-procedure
     2888       (input -1
     2889       ,input true
     2890       ) .
     2891     return no-apply .
     2892   end.
     2893   on alt-down anywhere
     2894   do:
     2895     run diasize_change-height in this-procedure
     2896       (input 1
     2897       ,input true
     2898       ) .
     2899     return no-apply .
     2900   end.
     2901   on alt-up anywhere
     2902   do:
     2903     run diasize_change-height in this-procedure
     2904       (input -1
     2905       ,input true
     2906       ) .
     2907     return no-apply .
     2908   end.
     2909   on alt-enter of frame Dialog-Frame
     2910   do:
     2911     run diasize_maximize in this-procedure
     2912       (input  ?
     2913       ).
     2914     return no-apply .
     2915   end.
     2916   procedure diasize_end-move :
     2917     do
     2918     on error undo, return error return-value
     2919     :
     2920       define variable v-row-delta as decimal   no-undo .
     2921       define variable v-col-delta as decimal   no-undo .
     2922       define variable v-new-row as decimal   no-undo .
     2923       define variable v-new-col as decimal   no-undo .
     2924       assign
     2925         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2926         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2927       .
     2928       assign
     2929         v-row-delta = v-new-row - frame Dialog-Frame :height
     2930         v-col-delta = v-new-col - frame Dialog-Frame :width
     2931       .
     2932       run diasize_change-height in this-procedure
     2933         (input v-row-delta
     2934         ,input true
     2935         ) .
     2936       run diasize_change-width in this-procedure
     2937         (input v-col-delta
     2938         ,input true
     2939         ) .
     2940     end.
     2941   end procedure.
     2942   procedure diasize_maximize :
     2943     define input  parameter p-action as logical   no-undo .
     2944     do
     2945     on error undo, return error return-value
     2946     :
     2947       if p-action = ?
     2948       then do:
     2949         if v-diasize-need-maximize = true
     2950         then do:
     2951           assign
     2952             p-action = true
     2953           .
     2954         end.
     2955         else do:
     2956           assign
     2957             p-action = false
     2958           .
     2959         end.
     2960       end.
     2961       if p-action = true
     2962       then do:
     2963         run diasize_change-height in this-procedure
     2964           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2965               - frame Dialog-Frame :height-chars
     2966           ,input true
     2967           ) .
     2968         run diasize_change-width in this-procedure
     2969           (input session :width-chars
     2970               - frame Dialog-Frame :width-chars
     2971           ,input true
     2972           ) .
     2973         assign
     2974           v-diasize-need-maximize = false
     2975         .
     2976       end.
     2977       else do:
     2978         run diasize_change-width in this-procedure
     2979           (input v-diasize-orig-frame-width
     2980               - frame Dialog-Frame :width-chars
     2981           ,input true
     2982           ) .
     2983         run diasize_change-height in this-procedure
     2984           (input v-diasize-orig-frame-height
     2985               - frame Dialog-Frame :height-chars
     2986           ,input true
     2987           ) .
     2988         assign
     2989           v-diasize-need-maximize = true
     2990         .
     2991       end.
     2992     end.
     2993   end procedure.
     2994   procedure diasize_restore-orig-size :
     2995     do
     2996     on error undo, return error return-value
     2997     :
     2998       assign
     2999         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3000         v-diasize-current-frame-height = frame Dialog-Frame :height
     3001       .
     3002       run diasize_set-height in this-procedure
     3003         (input  v-diasize-orig-frame-height
     3004         ,input  true
     3005         ) .
     3006       run diasize_set-width in this-procedure
     3007         (input  v-diasize-orig-frame-width
     3008         ,input  true
     3009         ) .
     3010     end.
     3011   end procedure.
     3012   procedure diasize_restore-current-size :
     3013     do
     3014     on error undo, return error return-value
     3015     :
     3016       run diasize_set-height in this-procedure
     3017         (input  v-diasize-current-frame-height
     3018         ,input  true
     3019         ) .
     3020       run diasize_set-width in this-procedure
     3021         (input  v-diasize-current-frame-width
     3022         ,input  true
     3023         ) .
     3024     end.
     3025   end procedure.
     3026   procedure diasize_set-browse-handle :
     3027     define input  parameter p-browse-handle as handle   no-undo .
     3028     define buffer buf_temp-browse-handle for temp-browse-handle .
     3029     do
     3030     on error undo, return error return-value
     3031     :
     3032       assign
     3033         v-diasize-browse-handle = p-browse-handle
     3034       .
     3035       for each buf_temp-browse-handle
     3036       on error undo, return error return-value
     3037       :
     3038         delete buf_temp-browse-handle .
     3039       end.
     3040     end.
     3041   end procedure.
     3042   procedure diasize_add_browse :
     3043     define input  parameter p-browse-type   as character no-undo .
     3044     define input  parameter p-browse-handle as handle    no-undo .
     3045     define buffer buf_temp-browse-handle for temp-browse-handle .
     3046     do
     3047     on error undo, return error return-value
     3048     :
     3049       assign
     3050         v-diasize-browse-number = v-diasize-browse-number + 1
     3051       .
     3052       create buf_temp-browse-handle .
     3053       assign
     3054         buf_temp-browse-handle.browse-type   = p-browse-type
     3055         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3056         buf_temp-browse-handle.browse-handle = p-browse-handle
     3057       .
     3058     end.
     3059   end procedure.
     3060   procedure diasize_init :
     3061     define variable v-default-value    as logical   no-undo .
     3062     define variable v-restore-saved    as logical   no-undo .
     3063     define variable v-resize-value-str as character no-undo .
     3064     do
     3065     on error undo, return error return-value
     3066     :
     3067       do with frame Dialog-Frame
     3068       :
     3069         assign
     3070           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3071           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3072           v-diasize-browse-handle     = browse br-thbj-attr :handle
     3073         .
     3074         create button v-diasize-resize-button
     3075         assign
     3076           parent        = frame Dialog-Frame :first-child
     3077           label         = "s"
     3078           height-pixels = 16
     3079           width-pixels  = 16
     3080           visible       = true
     3081           sensitive     = true
     3082           movable       = true
     3083           triggers:
     3084             on end-move persistent run diasize_end-move in this-procedure .
     3085           end triggers.
     3086         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3087         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3088         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3089         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3090         assign
     3091           v-diasize-wndmax = false
     3092         .
     3093         if connected("ub") = true
     3094         then do:
     3095           define variable v-cntxt-db-num        as integer   no-undo .
     3096           define variable v-cntxt-userid        as character no-undo .
     3097           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3098                                             , OUTPUT v-cntxt-userid
     3099                                             ) .
     3100           run gbl/wndpar_r.p
     3101             (input  v-cntxt-db-num
     3102             ,input  v-cntxt-userid
     3103             ,input  'wndmax':U
     3104             ,output v-diasize-wndmax
     3105             ,output v-default-value
     3106             ) .
     3107         end.
     3108         assign
     3109           v-diasize-wndstore = false
     3110         .
     3111         if connected("ub") = true
     3112         then do:
     3113           run gbl/wndpar_r.p
     3114             (input  v-cntxt-db-num
     3115             ,input  v-cntxt-userid
     3116             ,input  'wndstore':U
     3117             ,output v-diasize-wndstore
     3118             ,output v-default-value
     3119             ) .
     3120         end.
     3121         assign
     3122           v-diasize-proc-name = entry(1, program-name(2), '.')
     3123         .
     3124         if v-diasize-wndstore = true
     3125         then do:
     3126           assign
     3127             v-restore-saved = false
     3128           .
     3129           if connected("ub") = true
     3130           then do:
     3131             run gbl/wndsizer.p
     3132               (input  v-cntxt-db-num
     3133               ,input  v-cntxt-userid
     3134               ,input  v-diasize-proc-name
     3135               ,input  'height':u
     3136               ,output v-resize-value-str
     3137               ) .
     3138             if v-resize-value-str <> '':U
     3139             then do:
     3140               run diasize_change-height in this-procedure
     3141                 (input  integer(v-resize-value-str)
     3142                 ,input  true
     3143                 ) .
     3144               assign
     3145                 v-restore-saved = true
     3146               .
     3147             end.
     3148           end.
     3149           if connected("ub") = true
     3150           then do:
     3151             run gbl/wndsizer.p
     3152               (input  v-cntxt-db-num
     3153               ,input  v-cntxt-userid
     3154               ,input  v-diasize-proc-name
     3155               ,input  'width':u
     3156               ,output v-resize-value-str
     3157               ) .
     3158             if v-resize-value-str <> '':U
     3159             then do:
     3160               run diasize_change-width in this-procedure
     3161                 (input  integer(v-resize-value-str)
     3162                 ,input  true
     3163                 ) .
     3164               assign
     3165                 v-restore-saved = true
     3166               .
     3167             end.
     3168           end.
     3169           if v-restore-saved <> true
     3170           then do:
     3171             if v-diasize-wndmax = true
     3172             then do:
     3173               run diasize_maximize in this-procedure
     3174                 (input  true
     3175                 ) .
     3176             end.
     3177           end.
     3178         end.
     3179         else do:
     3180           if v-diasize-wndmax = true
     3181           then do:
     3182             run diasize_maximize in this-procedure
     3183               (input  true
     3184               ) .
     3185           end.
     3186         end.
     3187       end.
     3188     end.
     3189   end procedure.
     3190   procedure diasize_need-full-display :
     3191     define output parameter p-need-full-display as logical   no-undo .
     3192     do
     3193     on error undo, return error return-value
     3194     :
     3195       assign
     3196         p-need-full-display = v-diasize-need-full-display
     3197       .
     3198       assign
     3199         v-diasize-need-full-display = false
     3200       .
     3201     end.
     3202   end procedure.
     3203   procedure get-context :
     3204      define output parameter p-db-num as integer          no-undo.
     3205      define output parameter p-user-id as character        no-undo.
     3206      define variable v-login               as character    no-undo.
     3207      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3208      define buffer buf_user-login  for ub.user-login .
     3209      do
     3210      on error undo, return error
     3211      :
     3212            FIND FIRST buf_sys-ctrl no-lock.
     3213            ASSIGN
     3214               v-login = USERID("ub")
     3215               p-db-num = buf_sys-ctrl.db-num
     3216            .
     3217            FIND FIRST buf_user-login
     3218                 WHERE buf_user-login.db-num = p-db-num
     3219                   AND buf_user-login.user-login = v-login
     3220                 no-lock
     3221                 no-error
     3222                 .
     3223            IF AVAILABLE buf_user-login
     3224            THEN DO:
     3225               assign
     3226                  p-user-id = buf_user-login.user-id
     3227               .
     3228            END.
     3229      end.
     3230   end procedure.
