     3856   define variable  sort-phrase-rus-29  as character no-undo .
     3857     run waitfram-show in this-procedure
     3858       (input "ЖДИТЕ ..."
     3859       ).
     3860   run gbl/flt-get.p
     3861     (input filter-point
     3862     ,output flt-rec-29
     3863     ,output filter-name-29
     3864     ,output where-phrase-29
     3865     ,output sort-phrase-29
     3866     ,output where-phrase-rus-29
     3867     ,output sort-phrase-rus-29
     3868     ).
     3869   if p-open-query then do:
     3870       run set-filter-name in this-procedure
     3871         (INPUT filter-name-29
     3872         ) no-error .
     3873     assign
     3874       l-filter-open-29 = false
     3875     .
     3876     if flt-rec-29 <> ?
     3877       or sort-column-phrase > ""
     3878     then do:
     3879       define variable  parameter-2-29 as character no-undo .
     3880       define variable  parameter-3-29 as character no-undo .
     3881       define variable  parameter-4-29 as character no-undo .
     3882       define variable  parameter-5-29 as character no-undo .
     3883       define variable  parameter-6-29 as character no-undo .
     3884       define variable  parameter-7-29 as character no-undo .
     3885         assign
     3886         parameter-3-29 =
     3887                                 "FOR EACH X_c-thbj-attr"
     3888         parameter-4-29 =
     3889           (
     3890             if (" TRUE " + " " + where-phrase-29) <> ""
     3891             then " TRUE " + " " + where-phrase-29
     3892             else "true"
     3893           )
     3894         parameter-5-29 = (" " + "" + " " + "")
     3895         parameter-6-29 = if sort-phrase-29 = ''
     3896                              then
     3897           (
     3898           " " + "  " +
     3899             " " + sort-column-phrase +
     3900           " " + "  "
     3901           )
     3902                              else
     3903           (
     3904           " " + "  " +
     3905             " " + sort-column-phrase +
     3906           " " + sort-phrase-29
     3907           )
     3908         parameter-7-29 =
     3909           " indexed-reposition  "
     3910       .
     3911       do
     3912       on stop undo, leave
     3913       on error undo, leave
