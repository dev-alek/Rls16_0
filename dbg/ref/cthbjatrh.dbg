     3992             then " TRUE " + " " + where-phrase-29
     3993             else "true"
     3994           )
     3995         parameter-5-29 = (" " + "" + " " + "" + " " + p-find-condition)
     3996         parameter-6-29 = if sort-phrase-29 = ''
     3997                              then
     3998           (
