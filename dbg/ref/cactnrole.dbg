      372   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input  parameter parfact-date    like ub.wth-line.fact-date    no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                                                                                       cur_wth-line.wth-code   = parwth-code   and                                        cur_wth-line.fact-date  = parfact-date  and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-cld no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                                                                             start_wth-line.wth-code   = parwth-code         and                                start_wth-line.fact-date  < parfact-date   and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-cld no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income - cur_wth-line.incass              parincome        = cur_wth-line.income                     parincome-cassa  = cur_wth-line.income-cassa               parincome-other  = cur_wth-line.income-other               parincass        = cur_wth-line.incass                     parincass-bank   = cur_wth-line.incass-bank                parincass-other  = cur_wth-line.incass-other.              parincass-cassa  = cur_wth-line.incass-cassa.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income     - start_wth-line.incass               parstock-end     = cur_wth-line.income       - cur_wth-line.incass                 parincome        = cur_wth-line.income       - start_wth-line.income               parincome-cassa  = cur_wth-line.income-cassa - start_wth-line.income-cassa         parincome-other  = cur_wth-line.income-other - start_wth-line.income-other         parincass        = cur_wth-line.incass       - start_wth-line.incass               parincass-bank   = cur_wth-line.incass-bank  - start_wth-line.incass-bank          parincass-other  = cur_wth-line.incass-other - start_wth-line.incass-other.        parincass-cassa  = cur_wth-line.incass-cassa - start_wth-line.incass-cassa.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income - start_wth-line.incass                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
      373   end procedure.
      374   procedure wth-lib_full-inf-calend-date-place:
      375   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input parameter parw-p-code  like ub.wth-line.w-p-code  no-undo.                        define input parameter parfact-date like ub.wth-line.fact-date no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                        cur_wth-line.w-p-code   = parw-p-code and                                                               cur_wth-line.wth-code   = parwth-code   and                                        cur_wth-line.fact-date  = parfact-date  and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-cld-pl no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                start_wth-line.w-p-code = parw-p-code and                                                             start_wth-line.wth-code   = parwth-code         and                                start_wth-line.fact-date  < parfact-date   and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-cld-pl no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income-pl - cur_wth-line.incass-pl              parincome        = cur_wth-line.income-pl                     parincome-cassa  = cur_wth-line.income-cassa-pl               parincome-other  = cur_wth-line.income-other-pl               parincass        = cur_wth-line.incass-pl                     parincass-bank   = cur_wth-line.incass-bank-pl                parincass-other  = cur_wth-line.incass-other-pl.              parincass-cassa  = cur_wth-line.incass-cassa-pl.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income-pl     - start_wth-line.incass-pl               parstock-end     = cur_wth-line.income-pl       - cur_wth-line.incass-pl                 parincome        = cur_wth-line.income-pl       - start_wth-line.income-pl               parincome-cassa  = cur_wth-line.income-cassa-pl - start_wth-line.income-cassa-pl         parincome-other  = cur_wth-line.income-other-pl - start_wth-line.income-other-pl         parincass        = cur_wth-line.incass-pl       - start_wth-line.incass-pl               parincass-bank   = cur_wth-line.incass-bank-pl  - start_wth-line.incass-bank-pl          parincass-other  = cur_wth-line.incass-other-pl - start_wth-line.incass-other-pl.        parincass-cassa  = cur_wth-line.incass-cassa-pl - start_wth-line.incass-cassa-pl.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income-pl - start_wth-line.incass-pl                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
      376   end procedure.
      377   FUNCTION get-curr RETURNS CHARACTER
      378     (buffer loc-wealth for ub.wealth ) :
      379   define buffer buf_currency for ub.currency.
      380   if loc-wealth.curr-code = ? or loc-wealth.is-money = no then
      381   return loc-wealth.unit-base.
      382   FIND FIRST buf_currency no-lock where
      383             buf_currency.curr-code = loc-wealth.curr-code No-ERROR.
      384   if avail buf_currency then
      385     RETURN buf_currency.curr-abbr.
      386   else return "".
      387   END FUNCTION.
      388   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      389   define variable c-point  as character no-undo .
      390   define variable tbl      as character no-undo .
      391   define variable join-tbl as character no-undo .
      392   define variable fld      as character no-undo .
      393   define variable lab      as character no-undo .
      394   define variable spr      as character no-undo .
      395   define variable dim      as character no-undo .
      396   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      397   procedure fltfield-clear :
      398     define output parameter loc-fld as character no-undo.
      399     define output parameter loc-lab as character no-undo .
      400     define output parameter loc-spr as character no-undo .
      401     define output parameter loc-dim as character no-undo .
      402     assign
      403       loc-fld = ""
      404       loc-lab = ""
      405       loc-spr = ""
      406       loc-dim = "0"
      407     .
      408   end procedure .
      409   procedure fltfield-add :
      410     define input        parameter par-fld as character no-undo.
      411     define input        parameter par-lab as character no-undo .
      412     define input        parameter par-spr as character no-undo .
      413     define input-output parameter loc-fld as character no-undo.
      414     define input-output parameter loc-lab as character no-undo .
      415     define input-output parameter loc-spr as character no-undo .
      416     define input-output parameter loc-dim as character no-undo .
      417     do
      418     on error undo, return error
      419     :
      420       assign
      421       loc-fld = if loc-dim = '0'
      422                 then par-fld
      423                 else (loc-fld + chr(44) + par-fld)
      424       loc-lab = if loc-dim = '0'
      425                 then par-lab
      426                 else (loc-lab + chr(44) + par-lab)
      427       loc-spr = if loc-dim = '0'
      428                 then par-spr
      429                 else (loc-spr + chr(44) + par-spr)
      430       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      431                 string(integer(if num-entries(loc-dim) > 1
      432                               then entry(2, loc-dim)
      433                               else entry(1, loc-dim)
      434                               ) + 1)
      435       no-error
      436       .
      437     end.
      438   end procedure.
      439   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      440   define variable v-waitfram-action01         as character   no-undo .
      441   define variable v-waitfram-action02         as character   no-undo .
      442   define variable v-waitfram-action03         as character   no-undo .
      443   define variable mWaitFramTextBeg            as character   no-undo.
      444   define variable mWaitFramTextEnd            as character   no-undo.
      445   define variable mWaitFramView               as logical     no-undo.
      446   define variable mWaitProcEvent              as logical     no-undo init yes.
      447   define variable mWaitFramInterval           as integer     no-undo init 1 .
      448   define variable mWaitFramStop               as logical     no-undo.
      449   define variable mWaitFramStopUser           as logical     no-undo.
      450   define variable mWaitFramStopTimeOut        as logical     no-undo.
      451   define variable mWaitFramStartProc          as datetime-tz no-undo.
      452   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      453   define button B-WaitFramStop auto-end-key
      454        label "Стоп"
      455        size 10 by 1 tooltip "Остоновить процесс".
      456   define button B-viewProcInfo
      457        label "Информация"
      458        size 15 by 1 tooltip "Информация о процесс".
      459   define frame waitfram
      460     v-waitfram-action01 format "x(72)" no-label skip
      461     v-waitfram-action02 format "x(72)" no-label skip
      462     v-waitfram-action03 format "x(72)" no-label skip
      463     B-viewProcInfo
      464     B-WaitFramStop at row 4 col 30
      465     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      466     .
      467   define new global shared variable mBatchMode as logical no-undo init ?.
      468   define variable mFramBachModHandle as handle no-undo.
      469   mFramBachModHandle = frame waitfram:handle.
      470   define variable mFameOldVis as logical no-undo.
      471   define variable mVisCUrentVin as logical no-undo.
      472   if session:batch-mode
      473   then
      474      mBatchMode = yes.
      475   if mBatchMode = ? then do:
      476     mVisCUrentVin = current-window:visible.
      477     mFameOldVis = mFramBachModHandle:visible.
      478     mFramBachModHandle:visible  = yes.
      479     mBatchMode = mFramBachModHandle:visible ne yes.
      480     mFramBachModHandle:visible = mFameOldVis.
      481     current-window:visible = mVisCUrentVin.
      482   end.
      483    if  log-manager:logfile-name ne ?
      484     then DO:
      485         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      486         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      487         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      488     end.
      489   on choose of B-WaitFramStop in frame waitfram
      490   do:
      491     mWaitFramStop = yes.
      492     mWaitFramStopUser = yes.
      493   end.
      494   function waitfram-check-timeout returns logical():
      495      define variable vtime as int64 no-undo.
      496      if mWaitFramStopTimeOut
      497      then
      498         return yes.
      499      vtime = ( now - mWaitFramStartProc ) / 1000 .
      500      if     mWaitFramTimeOut ne ?
      501         and mWaitFramTimeOut ne 0
      502         and mWaitFramTimeOut lt vtime
      503      then do:
      504         mWaitFramStopTimeOut = yes.
      505      end.
      506      return mWaitFramStopTimeOut.
      507   end.
      508   procedure waitfram-hide :
      509     if not session:batch-mode
      510     then do
      511     on error undo, return error return-value
      512     :
      513       pause 0 before-hide .
      514       if not mBatchMode then
      515         hide frame waitfram .
      516     if     not mWaitFramView
      517        and mWaitProcEvent
      518     then
      519       process events .
      520     end.
      521   end procedure.
      522   procedure waitfram-show :
      523     define input  parameter p-message as character no-undo .
      524     define variable v-left-margin as integer   no-undo .
      525     if not session:batch-mode
      526     then do
      527     on error undo, return error return-value
      528     :
      529       if length(p-message) <= 70 then do:
      530         assign
      531           v-left-margin = integer((70 - length(p-message)) / 2)
      532         .
      533         assign
      534           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      535         .
      536         assign
      537           v-waitfram-action01 = " "
      538           v-waitfram-action02 = " "
      539                                    + fill(" ", v-left-margin)
      540                                    + p-message
      541           v-waitfram-action03 = " "
      542         .
      543       end.
      544       else do:
      545         define variable vRindex1 as integer no-undo.
      546         define variable vRindex2 as integer no-undo.
      547         vRindex1 = r-index(p-message," ",70).
      548         if vRindex1 = 0
      549         then
      550            vRindex1 = 70.
      551         if length(p-message)  <= vRindex1 + 70 then do:
      552           assign
      553             v-waitfram-action01 = " "
      554             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      555             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      556           .
      557         end.
      558         else do:
      559           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      560           if vRindex2 <= vRindex1
      561           then
      562              vRindex2 = vRindex1 + 70.
      563           assign
      564             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      565             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      566             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      567           .
      568         end.
      569       end.
      570       B-viewProcInfo:visible   in frame waitfram = no.
      571       B-viewProcInfo:sensitive in frame waitfram = no.
      572       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      573       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      574       if  (   mWaitFramView
      575          or  mWaitProcEvent)
      576          and not mBatchMode
      577       then
      578          display
      579             v-waitfram-action01 skip
      580             v-waitfram-action02 skip
      581             v-waitfram-action03 skip
      582          with frame waitfram .
      583       if     mWaitFramView
      584          then do:
      585             if     mWaitFramInterval ne ?
      586                and not mBatchMode
      587             then
      588                wait-for go of frame waitfram pause mWaitFramInterval.
      589          end.
      590          else
      591             if     mWaitProcEvent
      592                and not mBatchMode
      593             then
      594                process events .
      595     end.
      596   end procedure.
      597      procedure waitfram-show-this:
      598         define input  parameter iInterval as int64 no-undo.
      599         define variable vtime as int64 no-undo.
      600         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      601         mWaitFramInterval = iInterval.
      602         run waitfram-show (substitute("&1&2 &3&4" ,
      603                                       mWaitFramTextBeg ,
      604                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      605                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      606                                       mWaitFramTextEnd
      607                                      )
      608                           ).
      609      end.
      610      procedure WaitFramRunPause:
      611         define input  parameter iInterval as dec no-undo.
      612         define variable vStart  as datetime-tz no-undo.
      613         define variable vend    as datetime-tz no-undo.
      614         define variable vint as int64 no-undo.
      615         define variable vOk as logical no-undo.
      616         vStart = now.
      617         vend   = vStart.
      618         publish "WaitFramPause" (iInterval,output vOk).
      619         vend   =  now.
      620         vint = vend - vStart.
      621         vint = iInterval - vint / 1000.
      622         if     not mWaitFramStop
      623            and (   vint > 0
      624                 or (    not vOk
      625                     and iInterval eq ?
      626                     )
      627                 )
      628         then
      629            run waitfram-show-this (iInterval).
      630         vend   =  now.
      631         vint = vend - vStart.
      632         vint = iInterval - vint / 1000.
      633         if     not mWaitFramStop
      634            and vint > 0
      635         then do:
      636            run gbl/pause.p (vint * 1000).
      637         end.
      638         if iInterval ne ?
      639         then
      640            publish "WaitFramStop".
      641         waitfram-check-timeout().
      642      end.
      643      procedure WaitFramWaitFor:
      644         define input  parameter iInterval as dec no-undo.
      645         assign
      646            mWaitFramStartProc   = now
      647            mWaitFramStopUser    = no
      648            mWaitFramStopTimeOut = no
      649         .
      650         block-wait:
      651         do while not mWaitFramStop:
      652            run WaitFramRunPause (iInterval).
      653            if  waitfram-check-timeout()
      654            then do:
      655               leave block-wait.
      656            end.
      657         end.
      658         run waitfram-hide.
      659      end.
      660   procedure waitfram-join :
      661     define input  parameter p-line-1  as character no-undo .
      662     define input  parameter p-line-2  as character no-undo .
      663     define input  parameter p-line-3  as character no-undo .
      664     define output parameter p-message as character no-undo .
      665     do
      666     on error undo, return error return-value
      667     :
      668       assign
      669         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      670                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      671                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      672       .
      673     end.
      674   end procedure.
      675   function waitfram-join-function returns character
      676     (input p-line-1 as character
      677     ,input p-line-2 as character
      678     ,input p-line-3 as character
      679     ).
      680     define variable v-message as character no-undo .
      681     run waitfram-join in this-procedure
      682       (input  p-line-1
      683       ,input  p-line-2
      684       ,input  p-line-3
      685       ,output v-message
      686       ) .
      687     return v-message .
      688   end function .
      689   procedure proc-alt-shift-f2:
      690     if not ibs.th.gbl.gbl-var:rcode
      691   then
      692     run gbl\inidebug.p .
      693   end.
      694   procedure proc-alt-shift-f3:
      695     run gbl/prvssinf.p
      696       ( input this-procedure
      697       ) .
      698   end.
      699   define variable v-inform-launched as logical no-undo initial false .
      700   procedure proc-alt-shift-f4:
      701     define variable v-action as character no-undo .
      702     if v-inform-launched = false then do:
      703       assign
      704         v-inform-launched = true
      705       .
      706       run gbl/d-inform.w
      707         (  input self
      708         ,  input this-procedure
      709         , output v-action
      710         ) no-error .
      711       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      712       assign
      713         v-inform-launched = false
      714       .
      715     end.
      716   end.
      717   procedure proc-alt-f1:
      718     run gbl/corrhelp.p
      719       (input this-procedure
      720       ) .
      721   end .
      722   on alt-shift-f2 anywhere do:
      723     run proc-alt-shift-f2.
      724   end.
      725   on alt-shift-f3 anywhere do:
      726     run proc-alt-shift-f3 in this-procedure .
      727   end.
      728   on alt-shift-f4 anywhere do:
      729     run proc-alt-shift-f4 in this-procedure.
      730   end.
      731   on alt-f1 anywhere do:
      732     run proc-alt-f1 in this-procedure .
      733   end.
      734   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      735   FUNCTION mark-string RETURNS CHARACTER
      736     ( input p-recid as recid, input mark-list as character  ) :
      737     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      738   END FUNCTION.
      739   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      740   function usrfulnf returns character ( input p-user-id as character):
      741   define variable v-user-name as character no-undo .
      742   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      743   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      744     (input  p-user-id
      745     ,output v-user-name
      746     ) no-error .
      747   if error-status:error
      748   or v-user-name = ""
      749   then do:
      750     return p-user-id.
      751   end.
      752   else do:
      753     return v-user-name.
      754   end.
      755   end function.
      756   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      757   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      758   procedure fltopend_fltopend :
      759   define input parameter p-parent-handle as handle no-undo .
      760   define input parameter p-qh as handle no-undo .
      761   define input parameter p-flt-open-open-query  as character no-undo .
      762   define input parameter p-where-cond as character no-undo .
      763   define input parameter p-use-indFIRST-query-tail as character no-undo .
      764   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      765   define input parameter p-indexed-reposition as character no-undo .
      766     do
      767     on error undo, return error
      768     :
      769   define variable v-prepare-string as character no-undo .
      770   define variable glog as logical no-undo .
      771   assign
      772   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      773                      p-where-cond + chr(32)  +
      774                      p-use-indFIRST-query-tail + chr(32) +
      775                      p-use-ind-sort-clmn-by + chr(32) +
      776                      p-indexed-reposition
      777   .
      778   assign
      779   glog = p-qh:query-prepare(v-prepare-string) no-error .
      780   if not glog
      781   or error-status:error then do:
      782     message error-status:get-message(1) view-as alert-box .
      783     undo, return error .
      784   end.
      785   assign
      786   glog = p-qh:query-open no-error .
      787   if not glog
      788   or error-status:error then do:
      789     message error-status:get-message(1) view-as alert-box .
      790     undo, return error .
      791   end.
      792     end.
      793   end procedure.
      794   procedure fltopend_fltfindd :
      795   define input parameter p-parent-handle as handle no-undo .
      796   define input parameter p-qh as handle no-undo .
      797   define input parameter p-rowid as rowid no-undo .
      798   define input parameter p-next as logical no-undo .
      799   define input parameter p-lock as integer no-undo .
      800   define input parameter p-bh as handle no-undo .
      801   define input parameter p-where-cond as character no-undo .
      802   define input parameter p-use-index-phrase as character no-undo .
      803   define variable glog as logical no-undo .
      804   define variable v-qh as handle no-undo .
      805   define variable v-bh as handle no-undo .
      806   define variable v-recid as recid no-undo .
      807   define variable v-prepare-string as character no-undo .
      808   do
      809   on error undo, return error
      810   on stop undo, return error
      811   :
      812     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      813     create buffer v-bh for table p-bh buffer-name p-bh:name.
      814     create query v-qh.
      815     v-qh:set-buffers(v-bh).
      816     v-prepare-string = substitute("for each &1 &2 &3"
      817                                     ,v-bh:name
      818                                     ,p-where-cond
      819                                     ,p-use-index-phrase).
      820     glog = v-qh:query-prepare(v-prepare-string) no-error.
      821     if not glog then do:
      822       delete object v-qh.
      823       delete object v-bh.
      824       undo, return error .
      825     end.
      826     glog = v-qh:query-open no-error .
      827     if not glog then do:
      828       delete object v-qh.
      829       delete object v-bh.
      830       undo, return error .
      831     end.
      832     if p-next then do:
      833       v-qh:reposition-to-rowid(p-rowid) no-error .
      834       glog = v-qh:get-next( p-lock) no-error .
      835       glog = v-qh:get-next( p-lock) no-error .
      836       if not glog or v-qh:query-off-end = yes then do:
      837         glog = v-qh:get-first( p-lock) no-error .
      838       end.
      839     end.
      840     else do:
      841       glog = v-qh:get-first( p-lock) no-error .
      842     end.
      843     v-recid = v-bh:recid no-error .
      844     delete object v-qh.
      845     delete object v-bh.
      846     return string(v-recid) .
      847   end.
      848   end procedure.
      849   procedure fltopend_fltfindq :
      850   define input parameter p-parent-handle as handle no-undo .
      851   define input parameter p-qh as handle no-undo .
      852   define input parameter p-next as logical no-undo .
      853   define input parameter p-lock as integer no-undo .
      854   define input parameter p-flt-open-open-query  as character no-undo .
      855   define input parameter p-where-cond as character no-undo .
      856   define input parameter p-use-indFIRST-query-tail as character no-undo .
      857   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      858   define input parameter p-indexed-reposition as character no-undo .
      859   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      860   define variable glog as logical no-undo .
      861   define variable v-qh as handle no-undo .
      862   define variable v-bh as handle no-undo extent 18.
      863   define variable v-rowid as rowid no-undo extent 18.
      864   define variable v-ii as integer no-undo .
      865   define variable v-prepare-string as character no-undo .
      866   do
      867   on error undo, return error
      868   on stop undo, return error
      869   :
      870     create query v-qh.
      871     do v-ii = 1 to p-qh:num-buffers:
      872       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      873       assign
      874       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      875       no-error.
      876       v-qh:add-buffer(v-bh[v-ii]).
      877     end.
      878     assign
      879     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      880                       p-where-cond + chr(32)  +
      881                       p-use-indFIRST-query-tail + chr(32) +
      882                       p-use-ind-sort-clmn-by + chr(32) +
      883                       p-indexed-reposition
      884     .
      885     glog = v-qh:query-prepare( v-prepare-string) no-error .
      886     if not glog then do:
      887       delete object v-qh.
      888       do v-ii = 1 to p-qh:num-buffers:
      889         delete object v-bh[v-ii].
      890       end.
      891       undo, return error .
      892     end.
      893     glog = v-qh:query-open no-error .
      894     if not glog then do:
      895       delete object v-qh.
      896       do v-ii = 1 to p-qh:num-buffers:
      897         delete object v-bh[v-ii].
      898       end.
      899       undo, return error .
      900     end.
      901     if p-next then do:
      902       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      903       glog = v-qh:get-next( p-lock) no-error .
      904       glog = v-qh:get-next( p-lock) no-error .
      905       if not glog or v-qh:query-off-end = yes then do:
      906         glog = v-qh:get-first( p-lock) no-error .
      907       end.
      908     end.
      909     else do:
      910       glog = v-qh:get-first( p-lock) no-error .
      911     end.
      912     do v-ii = 1 to p-qh:num-buffers:
      913       assign
      914       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      915       no-error.
      916     end.
      917     delete object v-qh.
      918     do v-ii = 1 to p-qh:num-buffers:
      919       delete object v-bh[v-ii].
      920     end.
      921   end.
      922   end procedure.
      923   define variable log-res          as log       no-undo.
      924   define variable rr               as recid     no-undo.
      925   define variable jj               as integer   no-undo .
      926   define variable str              as char      no-undo.
      927   define variable conf-par         as char      no-undo.
      928   define variable par-type         as char      no-undo.
      929   define variable vartbl-name      as char      no-undo.
      930   define variable varact           as char      no-undo.
      931   DEFINE VARIABLE parstock         like ub.wth-pobj.income-pl no-undo .
      932   define variable filter-point0    as character no-undo init "cactnrole" .
      933   define variable filter-point     as character no-undo init "cactnrole" .
      934   define variable filter-label0    as character no-undo init "Справочник_истории_групп_прав" .
      935   define variable filter-label     as character no-undo init "Справочник_истории_групп_прав" .
      936   define variable v-rid-list       as character no-undo .
      937   define variable sort-column-name as character no-undo .
      938   define variable v-doc-rec        as recid     no-undo .
      939   define buffer X_action-role for ub.c-action-role.
      940   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      941   define NEW SHARED temp-table temp-changes no-undo
      942   field f_name as character
      943   field l_name as character
      944   field v_old as character
      945   field v_new as character
      946   field t_name as character
      947   field num_ as integer
      948   field uniq-key-rec as character
      949   field action as integer
      950   field fNotChange as logical
      951   index pi is unique primary
      952   num_
      953   t_name
      954   f_name
      955   index
      956   Chan
      957   fnotChange
      958   t_name
      959   f_name
      960   index imain uniq-key-rec
      961   .
      962   FUNCTION get-all-fields returns character (p-file-name as character ):
      963   define variable v-dop as character no-undo .
      964     find first _file no-lock where _file._file-name = p-file-name no-error .
      965     if not available _file then return "":U.
      966     for each _field no-lock where
      967              _field._file-recid = recid(_file) :
      968       assign
      969       v-dop = v-dop + _field._field-name + chr(44)
      970       .
      971     end.
      972     return trim(v-dop).
      973   END FUNCTION.
      974   PROCEDURE proc-full-temp-changes :
      975     define input  parameter p-hst-handle as handle    no-undo .
      976     define input  parameter p-main-table as character no-undo .
      977     define input  parameter p-field-list as character no-undo .
      978     define input  parameter p-label-form as character no-undo .
      979     define variable h-new-buf         as handle    no-undo .
      980     define variable h-main-buf        as handle    no-undo .
      981     define variable h-for-comp        as handle    no-undo .
      982     define variable v-inform          as character no-undo .
      983     define variable v-ind             as integer   no-undo .
      984     define variable v-idx-field-qnty  as integer   no-undo .
      985     define variable v-num-entries     as integer   no-undo .
      986     define variable fh                as handle    no-undo .
      987     define variable fh-main           as handle    no-undo .
      988     define variable fh-old            as handle    no-undo .
      989     define variable fh-new            as handle    no-undo .
      990     define variable v-field-name      as character no-undo .
      991     define variable v-field-lvl       as character no-undo .
      992     define variable v-field-form      as character no-undo .
      993     define variable v-search-exp      as character no-undo .
      994     define variable v-srch-main       as character no-undo .
      995     define variable v-word-link       as character no-undo .
      996     define variable v-av-chip-num     as logical   no-undo .
      997     define variable v-main-pi-fld-lst as character no-undo .
      998     define variable v-main-fld-lst    as character no-undo .
      999     define variable v-delim-list      as character no-undo .
     1000     define variable v-label           as character no-undo .
     1001     define variable v-old-value       as character no-undo case-sensitive.
     1002     define variable v-new-value       as character no-undo case-sensitive.
     1003     define variable v-chg-fields as character no-undo.
     1004     for each temp-changes:
     1005       delete temp-changes.
     1006     end.
     1007     if not p-hst-handle:available then do:
     1008       return .
     1009     end.
     1010     create buffer h-new-buf  for table p-hst-handle .
     1011     create buffer h-main-buf for table p-main-table .
     1012     assign
     1013       v-inform = h-main-buf:index-information(1)
     1014       v-ind    = 2
     1015     .
     1016     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1017     on error undo, return error
     1018     :
     1019       assign
     1020         v-inform = h-main-buf:index-information( v-ind )
     1021         v-ind    = v-ind + 1
     1022       .
     1023     end.
     1024     if v-inform = ?
     1025       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1026       or entry( 3, v-inform, ",":U ) <> "1":U
     1027     then do:
     1028       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1029     end.
     1030     assign
     1031       v-idx-field-qnty = num-entries( v-inform ) - 4
     1032     .
     1033     if v-idx-field-qnty < 2 then do:
     1034       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1035     end.
     1036     assign
     1037       v-srch-main   = "where":U
     1038       v-word-link   = "":U
     1039       v-av-chip-num = false
     1040       v-delim-list  = "":U
     1041     .
     1042     do v-ind = 1 to v-idx-field-qnty by 2
     1043     on error undo, return error
     1044     :
     1045       assign
     1046         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1047         fh                = p-hst-handle:buffer-field( v-field-name )
     1048         fh-main           = h-main-buf:buffer-field( v-field-name )
     1049         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1050         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1051       .
     1052       if fh:data-type ="character":U then do:
     1053         assign
     1054           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1055         .
     1056       end.
     1057       else do:
     1058         assign
     1059           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1060         .
     1061       end.
     1062       if v-delim-list = "":U then do:
     1063         assign
     1064           v-delim-list = ",":U
     1065         .
     1066       end.
     1067       if v-word-link = "":U then do:
     1068         assign
     1069           v-word-link = "and":U
     1070         .
     1071       end.
     1072     end.
     1073     assign
     1074       v-delim-list  = "":U
     1075     .
     1076     do v-ind = 1 to h-main-buf:num-fields
     1077     on error undo, return error
     1078     :
     1079       assign
     1080         fh-main      = h-main-buf:buffer-field( v-ind )
     1081         v-field-name = fh-main:name
     1082       .
     1083         assign
     1084           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1085         .
     1086         if v-delim-list = "":U then do:
     1087           assign
     1088             v-delim-list = ",":U
     1089           .
     1090         end.
     1091     end.
     1092     assign
     1093       v-inform = p-hst-handle:index-information(1)
     1094       v-ind    = 2
     1095     .
     1096     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1097     on error undo, return error
     1098     :
     1099       assign
     1100         v-inform = p-hst-handle:index-information( v-ind )
     1101         v-ind    = v-ind + 1
     1102       .
     1103     end.
     1104     if v-inform = ?
     1105       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1106       or entry( 3, v-inform, ",":U ) <> "1":U
     1107     then do:
     1108       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1109     end.
     1110     assign
     1111       v-idx-field-qnty = num-entries( v-inform ) - 4
     1112     .
     1113     if v-idx-field-qnty < 2 then do:
     1114       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1115     end.
     1116     assign
     1117       v-search-exp  = "where":U
     1118       v-word-link   = "":U
     1119       v-av-chip-num = false
     1120     .
     1121     do v-ind = 1 to v-idx-field-qnty by 2
     1122     on error undo, return error
     1123     :
     1124       assign
     1125         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1126         fh           = p-hst-handle:buffer-field( v-field-name )
     1127         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1128       .
     1129       if v-field-name = "chip-num":U then do:
     1130         assign
     1131           v-search-exp  = substitute( "&1 >", v-search-exp )
     1132           v-av-chip-num = true
     1133         .
     1134       end.
     1135       else do:
     1136         assign
     1137           v-search-exp = substitute( "&1 =", v-search-exp )
     1138         .
     1139       end.
     1140       if fh:data-type ="character":U then do:
     1141         assign
     1142           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1143         .
     1144       end.
     1145       else do:
     1146         assign
     1147           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1148         .
     1149       end.
     1150       if v-word-link = "":U then do:
     1151         assign
     1152           v-word-link = "and":U
     1153         .
     1154       end.
     1155     end.
     1156     if v-av-chip-num = false then do:
     1157       message
     1158         vss-workfile vss-revision vss-description skip
     1159         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1160         "Использование данной процедуры невозможно!" skip
     1161         view-as alert-box error .
     1162       return error .
     1163     end.
     1164     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1165     if not h-new-buf:available then do:
     1166       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1167       if not h-main-buf:available then do:
     1168         assign
     1169           h-for-comp = ?
     1170         .
     1171       end.
     1172       else do:
     1173         assign
     1174           h-for-comp = h-main-buf
     1175         .
     1176       end.
     1177     end.
     1178     else do:
     1179       assign
     1180         h-for-comp = h-new-buf
     1181       .
     1182     end.
     1183     assign
     1184       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1185     .
     1186     do v-ind = 1 to v-num-entries
     1187     on error undo, return error return-value
     1188     :
     1189       assign
     1190         v-field-name = entry( v-ind, v-main-fld-lst )
     1191         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1192         v-old-value  = fh-old:buffer-value()
     1193         v-label      = trim( fh-old:label )
     1194       .
     1195       if ( trim( p-field-list ) <> "":U
     1196            and lookup( v-field-name, p-field-list ) > 0
     1197          )
     1198          or trim( p-field-list ) = "":U
     1199       then do:
     1200         if h-for-comp <> ? then do:
     1201           assign
     1202             fh-new      = h-for-comp:buffer-field( v-field-name )
     1203             v-new-value = fh-new:buffer-value()
     1204           .
     1205         end.
     1206         else do:
     1207           assign
     1208             v-new-value = "":U
     1209           .
     1210         end.
     1211         if v-old-value <> v-new-value
     1212         then do:
     1213           create temp-changes.
     1214           assign
     1215             temp-changes.t_name = p-main-table
     1216             temp-changes.f_name = v-field-name
     1217             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1218             temp-changes.v_old  = trim( v-old-value )
     1219             temp-changes.v_new  = trim( v-new-value )
     1220             temp-changes.num_   = 0
     1221             temp-changes.fNotChange = v-old-value eq v-new-value
     1222           .
     1223         end.
     1224       end.
     1225     end.
     1226     assign
     1227       v-num-entries = num-entries( p-label-form, chr(8) )
     1228     .
     1229     do v-ind = 1 to v-num-entries
     1230     on error undo, return error return-value
     1231     :
     1232       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1233         assign
     1234           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1235           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1236           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1237         .
     1238         find first temp-changes
     1239           where temp-changes.f_name = v-field-name
     1240           no-error .
     1241         if available temp-changes then do:
     1242           if trim( v-field-lvl ) <> "":U then do:
     1243             assign
     1244               temp-changes.l_name = v-field-lvl
     1245             .
     1246           end.
     1247           if trim( v-field-form ) <> "":U then do:
     1248             assign
     1249               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1250             .
     1251             if h-for-comp <> ? then do:
     1252               assign
     1253                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1254               .
     1255             end.
     1256           end.
     1257         end.
     1258       end.
     1259       else do:
     1260         message
     1261           vss-workfile vss-revision vss-description skip
     1262           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1263           substitute( "список для поля '&1': '&2'"
     1264                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1265                       ,entry( v-ind, p-label-form, chr(8) )
     1266                     ) skip
     1267           substitute( "полный список: &2", p-label-form ) skip
     1268           view-as alert-box error .
     1269       end.
     1270     end.
     1271     delete object h-new-buf .
     1272     delete object h-main-buf .
     1273   END PROCEDURE.
     1274   FUNCTION get-action RETURNS CHARACTER
     1275       ( p-action as integer )  FORWARD.
     1276   FUNCTION get-subject RETURNS CHARACTER
     1277       ( p-subject as character )  FORWARD.
     1278   DEFINE BUTTON B-Help
     1279        LABEL "Помо&щь"
     1280        SIZE 3 BY 1
     1281        BGCOLOR 8 .
     1282   DEFINE BUTTON B-mark
     1283        LABEL "&*"
     1284        SIZE 3 BY 1.
     1285   DEFINE BUTTON b-quit AUTO-END-KEY
     1286        LABEL "&Выход"
     1287        SIZE 10 BY 1
     1288        BGCOLOR 8 .
     1289   DEFINE BUTTON B-sch
     1290        LABEL "&Фильтр"
     1291        SIZE 3 BY 1.
     1292   DEFINE BUTTON b-sel AUTO-GO
     1293        LABEL "Вы&бор"
     1294        SIZE 10 BY 1.
     1295   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1296        VIEW-AS FILL-IN
     1297        SIZE 9 BY 1
     1298        FGCOLOR 4  NO-UNDO.
     1299   DEFINE QUERY BR-c-action-role FOR
     1300       X_c-action-role SCROLLING.
     1301   DEFINE QUERY BR-changes FOR
     1302       temp-changes SCROLLING.
     1303   DEFINE BROWSE BR-c-action-role
     1304     QUERY BR-c-action-role DISPLAY
     1305         mark-string( recid(X_c-action-role), v-rid-list ) COLUMN-LABEL "*" FORMAT "X(1)":U
     1306       get-subject(X_c-action-role.subject) COLUMN-LABEL "Предмет изменений" FORMAT "X(25)":U
     1307       get-action(X_c-action-role.action) COLUMN-LABEL "Действие" FORMAT "X(20)":U
     1308       usrfulnf(X_c-action-role.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(28)":U
     1309       X_c-action-role.corr-date COLUMN-LABEL "Дата измен" FORMAT "99/99/9999":U
     1310       string(X_c-action-role.corr-time, "HH:MM") COLUMN-LABEL "Время измен":U
     1311       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 12.33.
     1312   DEFINE BROWSE BR-changes
     1313       QUERY BR-changes DISPLAY
     1314       temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(25)"
     1315       temp-changes.v_old COLUMn-LABEL "Было" format "X(40)"
     1316       temp-changes.v_new COLUMn-LABEL "Стало" format "X(40)"
     1317       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6.
     1318   DEFINE FRAME Dialog-Frame
     1319        b-quit AT ROW 1 COL 1
     1320        B-mark AT ROW 1 COL 11
     1321        b-sel AT ROW 1 COL 14
     1322        B-sch AT ROW 1 COL 92
     1323        B-Help AT ROW 1 COL 95
     1324        mark-num AT ROW 1.92 COL 9 COLON-ALIGNED NO-LABEL
     1325        BR-c-action-role AT ROW 3.42 COL 1
     1326        BR-changes AT ROW 16.04 COL 1
     1327        SPACE(0.24) SKIP(0.00)
     1328       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1329            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1330            TITLE "Справочник групп прав"
     1331            CANCEL-BUTTON b-quit.
     1332   ASSIGN
     1333          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1334          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1335   ASSIGN
     1336          BR-c-action-role:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1337   ON GO OF FRAME Dialog-Frame
     1338   DO:
     1339           p-rid-list = v-rid-list.
     1340       END.
     1341   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1342   DO:
     1343           APPLY "END-ERROR":U TO SELF.
     1344       END.
     1345   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1346   DO:
     1347           define variable glog as logical no-undo .
     1348           if not available X_c-action-role then return no-apply.
     1349   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1350   define variable v-str-recid13 as character no-undo .
     1351   define variable v-num-entry13 as integer   no-undo .
     1352   assign
     1353     v-str-recid13 = trim( string( recid( X_c-action-role ) , "->>>>>>>>>>>9":U ) )
     1354     v-num-entry13 = lookup( v-str-recid13 , v-rid-list )
     1355   .
     1356   if v-num-entry13 > 0 then do:
     1357     assign
     1358       entry( v-num-entry13, v-rid-list ) = "":U
     1359       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1360     .
     1361   end.
     1362   else do:
     1363     assign
     1364       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid13
     1365     .
     1366   end.
     1367           glog = br-c-action-role :refresh( )  in frame Dialog-Frame.
     1368           if not can-do ("MOUSE-SELECT-DBLCLICK,Return", last-event:function) then
     1369           do:
     1370               glog = br-c-action-role:select-next-row () in frame Dialog-Frame.
     1371               apply "value-changed" to br-c-action-role in frame Dialog-Frame.
     1372           end.
     1373           if num-entries (v-rid-list) = 0 then
     1374               hide mark-num in frame Dialog-Frame.
     1375           else
     1376               disp num-entries (v-rid-list) @ mark-num
     1377                   with frame Dialog-Frame.
     1378           apply "entry" to br-c-action-role in frame Dialog-Frame.
     1379       END.
     1380   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1381   DO:
     1382           run proc-b-sch in this-procedure no-error.
     1383           if error-status:error then return no-apply.
     1384       END.
     1385   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1386   DO:
     1387           if ( available X_c-action-role ) AND ( v-rid-list = "" ) then
     1388               v-rid-list = string( recid( X_c-action-role ) ) .
     1389       END.
     1390   ON RETURN OF BR-c-action-role IN FRAME Dialog-Frame
     1391   DO:
     1392           apply "DEFAULT-ACTION":U to self.
     1393       END.
     1394   ON VALUE-CHANGED OF BR-c-action-role IN FRAME Dialog-Frame
     1395   DO:
     1396           run proc-view-changes in this-procedure no-error.
     1397       END.
     1398   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1399       THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1400   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1401   on help of frame Dialog-Frame
     1402   do:
     1403     run gbl/app_help.p
     1404       (input this-procedure :file-name
     1405       ,input ''
     1406       ,input ?
     1407       ) no-error.
     1408     if error-status :error then do:
     1409       message
     1410         "Ошибка при вызове помощи"
     1411         error-status :get-message(1)
     1412         view-as alert-box .
     1413     end.
     1414   end.
     1415   run minbtn-set in this-procedure .
     1416   on choose of b-help in frame Dialog-Frame
     1417   do:
     1418     apply "help":u to frame Dialog-Frame .
     1419   end.
     1420   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1421   procedure minbtn-set :
     1422       do
     1423           on error undo, return error return-value
     1424           :
     1425           define variable ii              as integer       no-undo .
     1426           define variable fh              as widget-handle no-undo .
     1427           define variable hh              as widget-handle no-undo .
     1428           define variable v-h             as handle        extent 4 no-undo .
     1429           define variable v-name-button   as character     no-undo .
     1430           define variable v-help-old-x    as decimal       no-undo .
     1431           define variable v-help-old-y    as decimal       no-undo .
     1432           define variable v-help-old-size as decimal       no-undo .
     1433           define variable v-frame-width   as decimal       no-undo .
     1434           define variable jj              as integer       no-undo .
     1435           do
     1436               on error undo, return error
     1437               :
     1438               assign
     1439                   v-frame-width = frame Dialog-Frame:width - 0.3
     1440                   fh            = frame Dialog-Frame:first-child
     1441                   hh            = fh:first-child
     1442                   ii            = 1
     1443                   .
     1444               do while valid-handle(hh):
     1445                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1446                   do:
     1447                       case lc(hh:name) :
     1448                           when "b-help" then
     1449                               do:
     1450                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1451                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1452                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1453                                   hh:TOOLTIP = "Помощь" .
     1454                                   v-help-old-x = hh:column .
     1455                                   v-help-old-y = hh:row    .
     1456                                   v-help-old-size = hh:width .
     1457                                   hh:width-chars = 2.5 .
     1458                               end.
     1459                           when "b-print" then
     1460                               do:
     1461                                   hh:load-image("cmp/b-print.bmp":u) .
     1462                                   hh:TOOLTIP = "Печать" .
     1463                                   v-h[ii] = hh:handle .
     1464                                   ii = ii + 1 .
     1465                                   hh:width-chars = 3 .
     1466                               end.
     1467                           when "b-history" or
     1468                           when "b-hist" then
     1469                               do:
     1470                                   hh:load-image("cmp/b-hist.bmp":u) .
     1471                                   hh:TOOLTIP = "История" .
     1472                                   v-h[ii] = hh:handle .
     1473                                   ii = ii + 1 .
     1474                                   hh:width-chars = 3 .
     1475                               end.
     1476                           when "b-sch" then
     1477                               do:
     1478                                   hh:load-image("cmp/b-sch.bmp":u) .
     1479                                   hh:TOOLTIP = "Установка Фильтра" .
     1480                                   v-h[ii] = hh:handle .
     1481                                   ii = ii + 1 .
     1482                                   hh:width-chars = 3 .
     1483                               end.
     1484                           when "b-hist-user" then
     1485                               do:
     1486                                   hh:load-image("cmp/b-hist.bmp":u) .
     1487                                   hh:TOOLTIP = "История пользователя" .
     1488                                   ii = ii + 1 .
     1489                               end.
     1490                       end case.
     1491                   end.
     1492                   hh = hh:next-sibling.
     1493               end.
     1494               b-help:column = v-frame-width - b-help:width-chars.
     1495               jj = 0.
     1496               repeat ii = 4 to 1 by -1 :
     1497                   if valid-handle (v-h[ii] ) then
     1498                   do:
     1499                       jj  = jj + 1 .
     1500                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1501                       v-h[ii]:row    = v-help-old-y .
     1502                   end.
     1503               end.
     1504           end.
     1505       end.
     1506   end procedure.
     1507   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1508   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1509   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1510   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1511   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1512   define variable v-diasize-current-frame-height as decimal   no-undo .
     1513   define variable v-diasize-change-size          as logical   no-undo .
     1514   define variable v-diasize-resize-button        as handle    no-undo .
     1515   define variable v-diasize-wndmax               as logical   no-undo .
     1516   define variable v-diasize-wndstore             as logical   no-undo .
     1517   define variable v-diasize-proc-name            as character no-undo .
     1518   define variable v-diasize-browse-handle        as handle    no-undo .
     1519   define variable v-diasize-browse-number        as integer   no-undo .
     1520   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1521   define temp-table temp-diasize-handle no-undo
     1522     field handle-value  as handle
     1523     field save-position as decimal
     1524     index xpk is primary unique handle-value
     1525     .
     1526   define temp-table temp-browse-handle no-undo
     1527     field browse-type   as character
     1528     field browse-number as integer
     1529     field browse-handle as handle
     1530     field original-size as decimal
     1531     index xpk is primary unique browse-type browse-number
     1532     index xie browse-type browse-handle
     1533   .
     1534   procedure diasize_change-height :
     1535     define input  parameter p-change-value  as decimal   no-undo .
     1536     define input  parameter p-move-resize   as logical   no-undo .
     1537     define variable v-field-group-handle    as handle    no-undo .
     1538     define variable v-object-handle         as handle    no-undo .
     1539     define variable v-frame-height          as decimal   no-undo .
     1540     define variable v-frame-virtual-height  as decimal   no-undo .
     1541     define variable v-browse-height         as decimal   no-undo .
     1542     define variable v-window-height         as decimal   no-undo .
     1543     define variable v-window-virtual-height as decimal   no-undo .
     1544     define variable v-change-sign           as integer   no-undo .
     1545     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1546     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1547     if p-change-value > 0
     1548     then do:
     1549       if frame Dialog-Frame :height + p-change-value
     1550           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1551       then do:
     1552         assign
     1553           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1554                           - (frame Dialog-Frame :height-chars)
     1555         .
     1556         if p-change-value <= 0
     1557         then do:
     1558           run diasize_position-resize-button in this-procedure .
     1559           return .
     1560         end.
     1561       end.
     1562     end.
     1563     if p-change-value < 0
     1564     then do:
     1565       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1566       then do:
     1567         assign
     1568           p-change-value = v-diasize-orig-frame-height
     1569                          - (frame Dialog-Frame :height-chars)
     1570         .
     1571         if p-change-value >= 0
     1572         then do:
     1573           run diasize_position-resize-button in this-procedure .
     1574           return .
     1575         end.
     1576       end.
     1577     end.
     1578     if p-change-value >= 0
     1579     then do:
     1580       assign
     1581         v-change-sign = 1
     1582       .
     1583     end.
     1584     else do:
     1585       assign
     1586         v-change-sign = -1
     1587       .
     1588     end.
     1589     assign
     1590       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1591     .
     1592     if p-change-value = 0
     1593     then do:
     1594       run diasize_position-resize-button in this-procedure .
     1595       return .
     1596     end.
     1597     move_block:
     1598     do
     1599     on error undo move_block, retry move_block
     1600     :
     1601       if retry
     1602       then do:
     1603         do
     1604         on error undo move_block, leave move_block
     1605         :
     1606           if p-change-value > 0
     1607           then do:
     1608             for each buf_temp-diasize-handle
     1609             on error undo, next
     1610             :
     1611               assign
     1612                 v-object-handle = buf_temp-diasize-handle.handle-value
     1613               .
     1614               if v-object-handle <> v-diasize-resize-button
     1615               then do:
     1616                 assign
     1617                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1618                 .
     1619               end.
     1620             end.
     1621             assign
     1622               v-diasize-browse-handle :height = v-browse-height
     1623             .
     1624             for each buf_temp-browse-handle
     1625               where buf_temp-browse-handle.browse-type = 'height':u
     1626             on error undo, next
     1627             :
     1628               assign
     1629                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1630               .
     1631             end.
     1632             assign
     1633               frame Dialog-Frame :height = v-frame-height
     1634             .
     1635             if frame Dialog-Frame :scrollable = true
     1636             then do:
     1637               assign
     1638                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1639               .
     1640             end.
     1641             run diasize_position-resize-button in this-procedure .
     1642           end.
     1643           else do:
     1644             if frame Dialog-Frame :scrollable = true
     1645             then do:
     1646               assign
     1647                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1648               .
     1649             end.
     1650             assign
     1651               frame Dialog-Frame :height = v-frame-height
     1652             .
     1653             assign
     1654               v-diasize-browse-handle :height = v-browse-height
     1655             .
     1656             for each buf_temp-browse-handle
     1657               where buf_temp-browse-handle.browse-type = 'height':u
     1658             on error undo, next
     1659             :
     1660               assign
     1661                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1662               .
     1663             end.
     1664             for each buf_temp-diasize-handle
     1665             on error undo, next
     1666             :
     1667               assign
     1668                 v-object-handle = buf_temp-diasize-handle.handle-value
     1669               .
     1670               if v-object-handle <> v-diasize-resize-button
     1671               then do:
     1672                 assign
     1673                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1674                 .
     1675               end.
     1676             end.
     1677             run diasize_position-resize-button in this-procedure .
     1678           end.
     1679           assign
     1680             v-diasize-change-size = false
     1681           .
     1682           leave move_block .
     1683         end.
     1684       end.
     1685       assign
     1686         v-diasize-need-full-display = true
     1687       .
     1688       if v-diasize-change-size = false
     1689       then do:
     1690         assign
     1691           v-diasize-change-size = true
     1692         .
     1693       end.
     1694       else do:
     1695         return .
     1696       end.
     1697       assign
     1698         v-frame-height = frame Dialog-Frame :height
     1699         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1700         v-browse-height = v-diasize-browse-handle :height
     1701       .
     1702       for each buf_temp-browse-handle
     1703         where buf_temp-browse-handle.browse-type = 'height':u
     1704       :
     1705         assign
     1706           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1707         .
     1708       end.
     1709       for each buf_temp-diasize-handle
     1710       :
     1711         delete buf_temp-diasize-handle .
     1712       end.
     1713       assign
     1714         v-field-group-handle = frame Dialog-Frame :first-child
     1715       .
     1716       do while valid-handle(v-field-group-handle)
     1717       :
     1718         assign
     1719           v-object-handle = v-field-group-handle :first-child
     1720         .
     1721         do while valid-handle(v-object-handle)
     1722         :
     1723           if  v-object-handle <> v-diasize-browse-handle :handle
     1724           and can-query(v-object-handle, "row")
     1725           and can-query(v-object-handle, "height")
     1726           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1727           then do:
     1728             find first buf_temp-browse-handle
     1729               where buf_temp-browse-handle.browse-type   = 'height':u
     1730                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1731               no-error .
     1732             if available buf_temp-browse-handle
     1733             then do:
     1734             end.
     1735             else do:
     1736               create buf_temp-diasize-handle .
     1737               assign
     1738                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1739                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1740               .
     1741             end.
     1742           end.
     1743           assign
     1744             v-object-handle = v-object-handle :next-sibling
     1745           .
     1746         end.
     1747         assign
     1748           v-field-group-handle = v-field-group-handle :next-sibling
     1749         .
     1750       end.
     1751       do with frame Dialog-Frame
     1752       :
     1753         hide v-diasize-resize-button .
     1754         assign
     1755           v-diasize-resize-button :row    = 1
     1756           v-diasize-resize-button :column = 1
     1757         .
     1758       end.
     1759       if p-change-value > 0
     1760       then do:
     1761         if frame Dialog-Frame :scrollable = true
     1762         then do:
     1763           assign
     1764             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1765             no-error .
     1766           if error-status :error
     1767           or error-status :get-message(1) <> ""
     1768           then do:
     1769             undo move_block, retry move_block .
     1770           end.
     1771         end.
     1772         assign
     1773           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1774           no-error .
     1775         if error-status :error
     1776         or error-status :get-message(1) <> ""
     1777         then do:
     1778           undo move_block, retry move_block .
     1779         end.
     1780         assign
     1781           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1782           no-error .
     1783         if error-status :error
     1784         or error-status :get-message(1) <> ""
     1785         then do:
     1786           undo move_block, retry move_block .
     1787         end.
     1788         for each buf_temp-browse-handle
     1789           where buf_temp-browse-handle.browse-type = 'height':u
     1790         on error undo move_block, retry move_block
     1791         :
     1792           assign
     1793             buf_temp-browse-handle.browse-handle :height
     1794               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1795             no-error .
     1796           if error-status :error
     1797           or error-status :get-message(1) <> ""
     1798           then do:
     1799             undo move_block, retry move_block .
     1800           end.
     1801         end.
     1802         for each buf_temp-diasize-handle
     1803         on error undo move_block, retry move_block
     1804         :
     1805           assign
     1806             v-object-handle = buf_temp-diasize-handle.handle-value
     1807           .
     1808           if v-object-handle <> v-diasize-resize-button
     1809           then do:
     1810             assign
     1811               v-object-handle :row = v-object-handle :row + p-change-value
     1812               no-error .
     1813             if error-status :error
     1814             or error-status :get-message(1) <> ""
     1815             then do:
     1816               undo move_block, retry move_block .
     1817             end.
     1818           end.
     1819         end.
     1820       end.
     1821       else do:
     1822         for each buf_temp-diasize-handle
     1823         on error undo move_block, retry move_block
     1824         :
     1825           assign
     1826             v-object-handle = buf_temp-diasize-handle.handle-value
     1827           .
     1828           if v-object-handle <> v-diasize-resize-button
     1829           then do:
     1830             assign
     1831               v-object-handle :row = v-object-handle :row + p-change-value
     1832               no-error .
     1833             if error-status :error
     1834             or error-status :get-message(1) <> ""
     1835             then do:
     1836               undo move_block, retry move_block .
     1837             end.
     1838           end.
     1839         end.
     1840         assign
     1841           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1842           no-error .
     1843         if error-status :error
     1844         or error-status :get-message(1) <> ""
     1845         then do:
     1846           undo move_block, retry move_block .
     1847         end.
     1848         for each buf_temp-browse-handle
     1849           where buf_temp-browse-handle.browse-type = 'height':u
     1850         on error undo move_block, retry move_block
     1851         :
     1852           assign
     1853             buf_temp-browse-handle.browse-handle :height
     1854               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1855             no-error .
     1856           if error-status :error
     1857           or error-status :get-message(1) <> ""
     1858           then do:
     1859             undo move_block, retry move_block .
     1860           end.
     1861         end.
     1862         assign
     1863           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1864           no-error .
     1865         if error-status :error
     1866         or error-status :get-message(1) <> ""
     1867         then do:
     1868           undo move_block, retry move_block .
     1869         end.
     1870         if frame Dialog-Frame :scrollable = true
     1871         then do:
     1872           assign
     1873             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1874             no-error .
     1875           if error-status :error
     1876           or error-status :get-message(1) <> ""
     1877           then do:
     1878             undo move_block, retry move_block .
     1879           end.
     1880         end.
     1881       end.
     1882       if p-move-resize = true
     1883       then do:
     1884         run diasize_position-resize-button in this-procedure .
     1885       end.
     1886       if v-diasize-wndstore = true
     1887       then do:
     1888         if connected("ub") = true
     1889         then do:
     1890           define variable v-cntxt-db-num        as integer   no-undo .
     1891           define variable v-cntxt-userid        as character no-undo .
     1892           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1893                                             , OUTPUT v-cntxt-userid
     1894                                             ) .
     1895           run gbl/wndsizew.p
     1896             (input  v-cntxt-db-num
     1897             ,input  v-cntxt-userid
     1898             ,input  v-diasize-proc-name
     1899             ,input  'height':u
     1900             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1901             ) .
     1902         end.
     1903       end.
     1904     end.
     1905     assign
     1906       v-diasize-change-size = false
     1907     .
     1908   end procedure.
     1909   procedure diasize_set-height :
     1910     define input  parameter p-new-height  as decimal   no-undo .
     1911     define input  parameter p-move-resize as logical   no-undo .
     1912     do
     1913     on error undo, return error return-value
     1914     :
     1915       run diasize_change-height in this-procedure
     1916         (input  (p-new-height - frame Dialog-Frame :height)
     1917         ,input  p-move-resize
     1918         ) .
     1919     end.
     1920   end procedure.
     1921   procedure diasize_change-width :
     1922     define input  parameter p-change-value as decimal   no-undo .
     1923     define input  parameter p-move-resize  as logical   no-undo .
     1924     define variable v-field-group-handle   as handle    no-undo .
     1925     define variable v-object-handle        as handle    no-undo .
     1926     define variable v-frame-width          as decimal   no-undo .
     1927     define variable v-frame-virtual-width  as decimal   no-undo .
     1928     define variable v-browse-width         as decimal   no-undo .
     1929     define variable v-window-width         as decimal   no-undo .
     1930     define variable v-window-virtual-width as decimal   no-undo .
     1931     define variable v-change-sign          as integer   no-undo .
     1932     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1933     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1934     if p-change-value > 0
     1935     then do:
     1936       if frame Dialog-Frame :width + p-change-value >
     1937           session :width-chars
     1938       then do:
     1939         assign
     1940           p-change-value = session :width-chars - frame Dialog-Frame :width
     1941         .
     1942         if p-change-value <= 0
     1943         then do:
     1944           run diasize_position-resize-button in this-procedure .
     1945           return .
     1946         end.
     1947       end.
     1948     end.
     1949     if p-change-value < 0
     1950     then do:
     1951       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1952       then do:
     1953         assign
     1954           p-change-value = v-diasize-orig-frame-width
     1955                          - frame Dialog-Frame :width
     1956         .
     1957         if p-change-value >= 0
     1958         then do:
     1959           run diasize_position-resize-button in this-procedure .
     1960           return .
     1961         end.
     1962       end.
     1963     end.
     1964     if p-change-value >= 0
     1965     then do:
     1966       assign
     1967         v-change-sign = 1
     1968       .
     1969     end.
     1970     else do:
     1971       assign
     1972         v-change-sign = -1
     1973       .
     1974     end.
     1975     assign
     1976       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1977     .
     1978     if p-change-value = 0
     1979     then do:
     1980       run diasize_position-resize-button in this-procedure .
     1981       return .
     1982     end.
     1983     move_block:
     1984     do
     1985     on error undo move_block, leave move_block
     1986     :
     1987       if retry
     1988       then do:
     1989         do
     1990         on error undo move_block, leave move_block
     1991         :
     1992           if p-change-value > 0
     1993           then do:
     1994             for each buf_temp-diasize-handle
     1995             on error undo, next
     1996             :
     1997               assign
     1998                 v-object-handle = buf_temp-diasize-handle.handle-value
     1999               .
     2000               if v-object-handle <> v-diasize-resize-button
     2001               then do:
     2002                 assign
     2003                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2004                 .
     2005               end.
     2006             end.
     2007             assign
     2008               v-diasize-browse-handle :width = v-browse-width
     2009             .
     2010             for each buf_temp-browse-handle
     2011               where buf_temp-browse-handle.browse-type = 'width':u
     2012             on error undo, next
     2013             :
     2014               assign
     2015                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2016               .
     2017             end.
     2018             assign
     2019               frame Dialog-Frame :width = v-frame-width
     2020             .
     2021             if frame Dialog-Frame :scrollable = true
     2022             then do:
     2023               assign
     2024                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2025               .
     2026             end.
     2027             run diasize_position-resize-button in this-procedure .
     2028           end.
     2029           else do:
     2030             if frame Dialog-Frame :scrollable = true
     2031             then do:
     2032               assign
     2033                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2034               .
     2035             end.
     2036             assign
     2037               frame Dialog-Frame :width = v-frame-width
     2038             .
     2039             for each buf_temp-browse-handle
     2040               where buf_temp-browse-handle.browse-type = 'width':u
     2041             on error undo, next
     2042             :
     2043               assign
     2044                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2045               .
     2046             end.
     2047             assign
     2048               v-diasize-browse-handle :width = v-browse-width
     2049             .
     2050             for each buf_temp-diasize-handle
     2051             on error undo, next
     2052             :
     2053               assign
     2054                 v-object-handle = buf_temp-diasize-handle.handle-value
     2055               .
     2056               if v-object-handle <> v-diasize-resize-button
     2057               then do:
     2058                 assign
     2059                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2060                 .
     2061               end.
     2062             end.
     2063             run diasize_position-resize-button in this-procedure .
     2064           end.
     2065           assign
     2066             v-diasize-change-size = false
     2067           .
     2068           leave move_block .
     2069         end.
     2070       end.
     2071       assign
     2072         v-diasize-need-full-display = true
     2073       .
     2074       if v-diasize-change-size = false
     2075       then do:
     2076         assign
     2077           v-diasize-change-size = true
     2078         .
     2079       end.
     2080       else do:
     2081         return .
     2082       end.
     2083       assign
     2084         v-frame-width = frame Dialog-Frame :width
     2085         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2086         v-browse-width = v-diasize-browse-handle :width
     2087       .
     2088       for each buf_temp-browse-handle
     2089         where buf_temp-browse-handle.browse-type = 'width':u
     2090       :
     2091         assign
     2092           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2093         .
     2094       end.
     2095       for each buf_temp-diasize-handle
     2096       :
     2097         delete buf_temp-diasize-handle .
     2098       end.
     2099       assign
     2100         v-field-group-handle = frame Dialog-Frame :first-child
     2101       .
     2102       do while valid-handle(v-field-group-handle)
     2103       :
     2104         assign
     2105           v-object-handle = v-field-group-handle :first-child
     2106         .
     2107         do while valid-handle(v-object-handle)
     2108         :
     2109           if  v-object-handle <> v-diasize-browse-handle :handle
     2110           and v-object-handle <> v-diasize-resize-button
     2111           and can-query(v-object-handle, "row")
     2112           and can-query(v-object-handle, "height")
     2113           and ( v-object-handle :col + v-object-handle :width
     2114                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2115               )
     2116           then do:
     2117             find first buf_temp-browse-handle
     2118               where buf_temp-browse-handle.browse-type   = 'width':u
     2119                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2120               no-error .
     2121             if available buf_temp-browse-handle
     2122             then do:
     2123             end.
     2124             else do:
     2125               create buf_temp-diasize-handle .
     2126               assign
     2127                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2128                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2129               .
     2130             end.
     2131           end.
     2132           assign
     2133             v-object-handle = v-object-handle :next-sibling
     2134           .
     2135         end.
     2136         assign
     2137           v-field-group-handle = v-field-group-handle :next-sibling
     2138         .
     2139       end.
     2140       do with frame Dialog-Frame
     2141       :
     2142         hide v-diasize-resize-button .
     2143         v-diasize-resize-button :row = 1.
     2144         v-diasize-resize-button :column = 1.
     2145       end.
     2146       if p-change-value > 0
     2147       then do:
     2148         if frame Dialog-Frame :scrollable = true
     2149         then do:
     2150           assign
     2151             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2152             no-error .
     2153           if error-status :error
     2154           or error-status :get-message(1) <> ""
     2155           then do:
     2156             undo move_block, retry move_block.
     2157           end.
     2158         end.
     2159         assign
     2160           frame Dialog-Frame :width = v-frame-width + p-change-value
     2161           no-error .
     2162         if error-status :error
     2163         or error-status :get-message(1) <> ""
     2164         then do:
     2165           undo move_block, retry move_block.
     2166         end.
     2167         assign
     2168           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2169         no-error .
     2170         if error-status :error
     2171         or error-status :get-message(1) <> ""
     2172         then do:
     2173           undo move_block, retry move_block.
     2174         end.
     2175         for each buf_temp-browse-handle
     2176           where buf_temp-browse-handle.browse-type = 'width':u
     2177         on error undo move_block, retry move_block
     2178         :
     2179           assign
     2180             buf_temp-browse-handle.browse-handle :width
     2181               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2182             no-error .
     2183           if error-status :error
     2184           or error-status :get-message(1) <> ""
     2185           then do:
     2186             undo move_block, retry move_block .
     2187           end.
     2188         end.
     2189         for each buf_temp-diasize-handle
     2190         on error undo move_block, retry move_block
     2191         :
     2192           assign
     2193             v-object-handle = buf_temp-diasize-handle.handle-value
     2194           .
     2195           if v-object-handle <> v-diasize-resize-button
     2196           then do:
     2197             assign
     2198               v-object-handle :col = v-object-handle :col + p-change-value
     2199               no-error .
     2200             if error-status :error
     2201             or error-status :get-message(1) <> ""
     2202             then do:
     2203               undo move_block, retry move_block .
     2204             end.
     2205           end.
     2206         end.
     2207       end.
     2208       else do:
     2209         for each buf_temp-diasize-handle
     2210         on error undo move_block, retry move_block
     2211         :
     2212           assign
     2213             v-object-handle = buf_temp-diasize-handle.handle-value
     2214           .
     2215           if v-object-handle <> v-diasize-resize-button
     2216           then do:
     2217             assign
     2218               v-object-handle :col = v-object-handle :col + p-change-value
     2219               no-error .
     2220             if error-status :error
     2221             or error-status :get-message(1) <> ""
     2222             then do:
     2223               undo move_block, retry move_block .
     2224             end.
     2225           end.
     2226         end.
     2227         for each buf_temp-browse-handle
     2228           where buf_temp-browse-handle.browse-type = 'width':u
     2229         on error undo move_block, retry move_block
     2230         :
     2231           assign
     2232             buf_temp-browse-handle.browse-handle :width
     2233               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2234             no-error .
     2235           if error-status :error
     2236           or error-status :get-message(1) <> ""
     2237           then do:
     2238             undo move_block, retry move_block .
     2239           end.
     2240         end.
     2241         assign
     2242           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2243           no-error .
     2244         if error-status :error
     2245         or error-status :get-message(1) <> ""
     2246         then do:
     2247           undo move_block, retry move_block.
     2248         end.
     2249         assign
     2250           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2251         no-error .
     2252         if error-status :error
     2253         or error-status :get-message(1) <> ""
     2254         then do:
     2255           undo move_block, retry move_block.
     2256         end.
     2257         if frame Dialog-Frame :scrollable = true
     2258         then do:
     2259           assign
     2260             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2261           no-error .
     2262           if error-status :error
     2263           or error-status :get-message(1) <> ""
     2264           then do:
     2265             undo move_block, retry move_block.
     2266           end.
     2267         end.
     2268       end.
     2269       if p-move-resize
     2270       then do:
     2271         run diasize_position-resize-button in this-procedure .
     2272       end.
     2273       if v-diasize-wndstore = true
     2274       then do:
     2275         if connected("ub") = true
     2276         then do:
     2277           define variable v-cntxt-db-num        as integer   no-undo .
     2278           define variable v-cntxt-userid        as character no-undo .
     2279           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2280                                             , OUTPUT v-cntxt-userid
     2281                                             ) .
     2282           run gbl/wndsizew.p
     2283             (input  v-cntxt-db-num
     2284             ,input  v-cntxt-userid
     2285             ,input  v-diasize-proc-name
     2286             ,input  'width':u
     2287             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2288             ) .
     2289         end.
     2290       end.
     2291     end.
     2292     assign
     2293       v-diasize-change-size = false
     2294     .
     2295   end procedure.
     2296   procedure diasize_set-width :
     2297     define input  parameter p-new-width  as decimal   no-undo .
     2298     define input  parameter p-move-resize as logical   no-undo .
     2299     do
     2300     on error undo, return error return-value
     2301     :
     2302       run diasize_change-width in this-procedure
     2303         (input  (p-new-width - frame Dialog-Frame :width)
     2304         ,input  p-move-resize
     2305         ) .
     2306     end.
     2307   end procedure.
     2308   procedure diasize_position-resize-button :
     2309     do with frame Dialog-Frame
     2310     :
     2311       hide v-diasize-resize-button .
     2312       assign
     2313         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2314                     - 1
     2315                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2316         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2317                     - 1
     2318                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2319       .
     2320       view v-diasize-resize-button .
     2321     end.
     2322   end procedure.
     2323   on alt-right anywhere
     2324   do:
     2325     run diasize_change-width in this-procedure
     2326       (input 1
     2327       ,input true
     2328       ) .
     2329     return no-apply .
     2330   end.
     2331   on alt-left anywhere
     2332   do:
     2333     run diasize_change-width in this-procedure
     2334       (input -1
     2335       ,input true
     2336       ) .
     2337     return no-apply .
     2338   end.
     2339   on alt-down anywhere
     2340   do:
     2341     run diasize_change-height in this-procedure
     2342       (input 1
     2343       ,input true
     2344       ) .
     2345     return no-apply .
     2346   end.
     2347   on alt-up anywhere
     2348   do:
     2349     run diasize_change-height in this-procedure
     2350       (input -1
     2351       ,input true
     2352       ) .
     2353     return no-apply .
     2354   end.
     2355   on alt-enter of frame Dialog-Frame
     2356   do:
     2357     run diasize_maximize in this-procedure
     2358       (input  ?
     2359       ).
     2360     return no-apply .
     2361   end.
     2362   procedure diasize_end-move :
     2363     do
     2364     on error undo, return error return-value
     2365     :
     2366       define variable v-row-delta as decimal   no-undo .
     2367       define variable v-col-delta as decimal   no-undo .
     2368       define variable v-new-row as decimal   no-undo .
     2369       define variable v-new-col as decimal   no-undo .
     2370       assign
     2371         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2372         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2373       .
     2374       assign
     2375         v-row-delta = v-new-row - frame Dialog-Frame :height
     2376         v-col-delta = v-new-col - frame Dialog-Frame :width
     2377       .
     2378       run diasize_change-height in this-procedure
     2379         (input v-row-delta
     2380         ,input true
     2381         ) .
     2382       run diasize_change-width in this-procedure
     2383         (input v-col-delta
     2384         ,input true
     2385         ) .
     2386     end.
     2387   end procedure.
     2388   procedure diasize_maximize :
     2389     define input  parameter p-action as logical   no-undo .
     2390     do
     2391     on error undo, return error return-value
     2392     :
     2393       if p-action = ?
     2394       then do:
     2395         if v-diasize-need-maximize = true
     2396         then do:
     2397           assign
     2398             p-action = true
     2399           .
     2400         end.
     2401         else do:
     2402           assign
     2403             p-action = false
     2404           .
     2405         end.
     2406       end.
     2407       if p-action = true
     2408       then do:
     2409         run diasize_change-height in this-procedure
     2410           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2411               - frame Dialog-Frame :height-chars
     2412           ,input true
     2413           ) .
     2414         run diasize_change-width in this-procedure
     2415           (input session :width-chars
     2416               - frame Dialog-Frame :width-chars
     2417           ,input true
     2418           ) .
     2419         assign
     2420           v-diasize-need-maximize = false
     2421         .
     2422       end.
     2423       else do:
     2424         run diasize_change-width in this-procedure
     2425           (input v-diasize-orig-frame-width
     2426               - frame Dialog-Frame :width-chars
     2427           ,input true
     2428           ) .
     2429         run diasize_change-height in this-procedure
     2430           (input v-diasize-orig-frame-height
     2431               - frame Dialog-Frame :height-chars
     2432           ,input true
     2433           ) .
     2434         assign
     2435           v-diasize-need-maximize = true
     2436         .
     2437       end.
     2438     end.
     2439   end procedure.
     2440   procedure diasize_restore-orig-size :
     2441     do
     2442     on error undo, return error return-value
     2443     :
     2444       assign
     2445         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2446         v-diasize-current-frame-height = frame Dialog-Frame :height
     2447       .
     2448       run diasize_set-height in this-procedure
     2449         (input  v-diasize-orig-frame-height
     2450         ,input  true
     2451         ) .
     2452       run diasize_set-width in this-procedure
     2453         (input  v-diasize-orig-frame-width
     2454         ,input  true
     2455         ) .
     2456     end.
     2457   end procedure.
     2458   procedure diasize_restore-current-size :
     2459     do
     2460     on error undo, return error return-value
     2461     :
     2462       run diasize_set-height in this-procedure
     2463         (input  v-diasize-current-frame-height
     2464         ,input  true
     2465         ) .
     2466       run diasize_set-width in this-procedure
     2467         (input  v-diasize-current-frame-width
     2468         ,input  true
     2469         ) .
     2470     end.
     2471   end procedure.
     2472   procedure diasize_set-browse-handle :
     2473     define input  parameter p-browse-handle as handle   no-undo .
     2474     define buffer buf_temp-browse-handle for temp-browse-handle .
     2475     do
     2476     on error undo, return error return-value
     2477     :
     2478       assign
     2479         v-diasize-browse-handle = p-browse-handle
     2480       .
     2481       for each buf_temp-browse-handle
     2482       on error undo, return error return-value
     2483       :
     2484         delete buf_temp-browse-handle .
     2485       end.
     2486     end.
     2487   end procedure.
     2488   procedure diasize_add_browse :
     2489     define input  parameter p-browse-type   as character no-undo .
     2490     define input  parameter p-browse-handle as handle    no-undo .
     2491     define buffer buf_temp-browse-handle for temp-browse-handle .
     2492     do
     2493     on error undo, return error return-value
     2494     :
     2495       assign
     2496         v-diasize-browse-number = v-diasize-browse-number + 1
     2497       .
     2498       create buf_temp-browse-handle .
     2499       assign
     2500         buf_temp-browse-handle.browse-type   = p-browse-type
     2501         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2502         buf_temp-browse-handle.browse-handle = p-browse-handle
     2503       .
     2504     end.
     2505   end procedure.
     2506   procedure diasize_init :
     2507     define variable v-default-value    as logical   no-undo .
     2508     define variable v-restore-saved    as logical   no-undo .
     2509     define variable v-resize-value-str as character no-undo .
     2510     do
     2511     on error undo, return error return-value
     2512     :
     2513       do with frame Dialog-Frame
     2514       :
     2515         assign
     2516           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2517           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2518           v-diasize-browse-handle     = browse br-c-action-role :handle
     2519         .
     2520         create button v-diasize-resize-button
     2521         assign
     2522           parent        = frame Dialog-Frame :first-child
     2523           label         = "s"
     2524           height-pixels = 16
     2525           width-pixels  = 16
     2526           visible       = true
     2527           sensitive     = true
     2528           movable       = true
     2529           triggers:
     2530             on end-move persistent run diasize_end-move in this-procedure .
     2531           end triggers.
     2532         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2533         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2534         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2535         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2536         assign
     2537           v-diasize-wndmax = false
     2538         .
     2539         if connected("ub") = true
     2540         then do:
     2541           define variable v-cntxt-db-num        as integer   no-undo .
     2542           define variable v-cntxt-userid        as character no-undo .
     2543           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2544                                             , OUTPUT v-cntxt-userid
     2545                                             ) .
     2546           run gbl/wndpar_r.p
     2547             (input  v-cntxt-db-num
     2548             ,input  v-cntxt-userid
     2549             ,input  'wndmax':U
     2550             ,output v-diasize-wndmax
     2551             ,output v-default-value
     2552             ) .
     2553         end.
     2554         assign
     2555           v-diasize-wndstore = false
     2556         .
     2557         if connected("ub") = true
     2558         then do:
     2559           run gbl/wndpar_r.p
     2560             (input  v-cntxt-db-num
     2561             ,input  v-cntxt-userid
     2562             ,input  'wndstore':U
     2563             ,output v-diasize-wndstore
     2564             ,output v-default-value
     2565             ) .
     2566         end.
     2567         assign
     2568           v-diasize-proc-name = entry(1, program-name(2), '.')
     2569         .
     2570         if v-diasize-wndstore = true
     2571         then do:
     2572           assign
     2573             v-restore-saved = false
     2574           .
     2575           if connected("ub") = true
     2576           then do:
     2577             run gbl/wndsizer.p
     2578               (input  v-cntxt-db-num
     2579               ,input  v-cntxt-userid
     2580               ,input  v-diasize-proc-name
     2581               ,input  'height':u
     2582               ,output v-resize-value-str
     2583               ) .
     2584             if v-resize-value-str <> '':U
     2585             then do:
     2586               run diasize_change-height in this-procedure
     2587                 (input  integer(v-resize-value-str)
     2588                 ,input  true
     2589                 ) .
     2590               assign
     2591                 v-restore-saved = true
     2592               .
     2593             end.
     2594           end.
     2595           if connected("ub") = true
     2596           then do:
     2597             run gbl/wndsizer.p
     2598               (input  v-cntxt-db-num
     2599               ,input  v-cntxt-userid
     2600               ,input  v-diasize-proc-name
     2601               ,input  'width':u
     2602               ,output v-resize-value-str
     2603               ) .
     2604             if v-resize-value-str <> '':U
     2605             then do:
     2606               run diasize_change-width in this-procedure
     2607                 (input  integer(v-resize-value-str)
     2608                 ,input  true
     2609                 ) .
     2610               assign
     2611                 v-restore-saved = true
     2612               .
     2613             end.
     2614           end.
     2615           if v-restore-saved <> true
     2616           then do:
     2617             if v-diasize-wndmax = true
     2618             then do:
     2619               run diasize_maximize in this-procedure
     2620                 (input  true
     2621                 ) .
     2622             end.
     2623           end.
     2624         end.
     2625         else do:
     2626           if v-diasize-wndmax = true
     2627           then do:
     2628             run diasize_maximize in this-procedure
     2629               (input  true
     2630               ) .
     2631           end.
     2632         end.
     2633       end.
     2634     end.
     2635   end procedure.
     2636   procedure diasize_need-full-display :
     2637     define output parameter p-need-full-display as logical   no-undo .
     2638     do
     2639     on error undo, return error return-value
     2640     :
     2641       assign
     2642         p-need-full-display = v-diasize-need-full-display
     2643       .
     2644       assign
     2645         v-diasize-need-full-display = false
     2646       .
     2647     end.
     2648   end procedure.
     2649   procedure get-context :
     2650      define output parameter p-db-num as integer          no-undo.
     2651      define output parameter p-user-id as character        no-undo.
     2652      define variable v-login               as character    no-undo.
     2653      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2654      define buffer buf_user-login  for ub.user-login .
     2655      do
     2656      on error undo, return error
     2657      :
     2658            FIND FIRST buf_sys-ctrl no-lock.
     2659            ASSIGN
     2660               v-login = USERID("ub")
     2661               p-db-num = buf_sys-ctrl.db-num
     2662            .
     2663            FIND FIRST buf_user-login
     2664                 WHERE buf_user-login.db-num = p-db-num
     2665                   AND buf_user-login.user-login = v-login
     2666                 no-lock
     2667                 no-error
     2668                 .
     2669            IF AVAILABLE buf_user-login
     2670            THEN DO:
     2671               assign
     2672                  p-user-id = buf_user-login.user-id
     2673               .
     2674            END.
     2675      end.
     2676   end procedure.
     2677   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2678   on f5 of frame Dialog-Frame anywhere
     2679   do:
     2680     v-doc-rec = recid(X_c-action-role). run openbr in this-procedure. reposition br-c-action-role to recid v-doc-rec no-error.               APPLY 'ENTRY' to br-c-action-role. APPLY 'VALUE-CHANGED' to br-c-action-role.
     2681       apply "VALUE-CHANGED" to BR-c-action-role.
     2682   end.
     2683   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2684   do:
     2685     BR-c-action-role :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2686   end.
     2687   def var sort-labelbr-c-action-role   as character no-undo .
     2688   def var sort-clmnbr-c-action-role    as handle    no-undo .
     2689   def var cur-clmnbr-c-action-role     as handle    no-undo .
     2690   def var cur-clmn-locbr-c-action-role as integer   no-undo .
     2691   def var re-querybr-c-action-role     as logical   initial no no-undo .
     2692   on start-search, ctrl-o of br-c-action-role in frame Dialog-Frame do:
     2693      run sort-brbr-c-action-role
     2694        (input (if available X_c-action-role
     2695                then recid(X_c-action-role)
     2696                else ?
     2697               )
     2698        ).
     2699   end.
     2700   PROCEDURE sort-brbr-c-action-role :
     2701     define input parameter p-recid as recid no-undo .
     2702     if re-querybr-c-action-role = no then do:
     2703       assign
     2704          cur-clmnbr-c-action-role = br-c-action-role:current-column in frame Dialog-Frame
     2705       .
     2706       if sort-clmnbr-c-action-role <> ? then sort-clmnbr-c-action-role:column-fgcolor = 0.
     2707       if cur-clmnbr-c-action-role = sort-clmnbr-c-action-role then do:
     2708         assign
     2709            sort-labelbr-c-action-role = ""
     2710            sort-clmnbr-c-action-role = ?
     2711         .
     2712        end.
     2713        else do:
     2714          assign
     2715            sort-labelbr-c-action-role = cur-clmnbr-c-action-role:label
     2716            sort-clmnbr-c-action-role  = cur-clmnbr-c-action-role
     2717            sort-clmnbr-c-action-role:column-fgcolor = 4
     2718          .
     2719        end.
     2720      end.
     2721     assign
     2722       cur-clmn-locbr-c-action-role = 1
     2723     .
     2724     def var column-handle as handle no-undo .
     2725     column-handle = br-c-action-role:first-column.
     2726     do while valid-handle(column-handle) :
     2727       if column-handle = cur-clmnbr-c-action-role then do:
     2728         leave .
     2729       end.
     2730       column-handle = column-handle:NEXT-COLUMN.
     2731       assign
     2732         cur-clmn-locbr-c-action-role = cur-clmn-locbr-c-action-role + 1
     2733       .
     2734     end.
     2735     case sort-labelbr-c-action-role:
     2736           when X_c-action-role.corr-date:label in browse br-c-action-role then DO:    assign       sort-column-name = "X_c-action-role.corr-date"     .     run OpenBr in this-procedure.   . END.
     2737       otherwise do:
     2738         assign
     2739           sort-column-name = ""
     2740         .
     2741         run OpenBr in this-procedure.
     2742         if sort-labelbr-c-action-role <> "" then do:
     2743           assign
     2744             cur-clmnbr-c-action-role:column-fgcolor = 0
     2745           .
     2746         end.
     2747         assign
     2748           cur-clmn-locbr-c-action-role = ?
     2749         .
     2750       end.
     2751     end case.
     2752     if p-recid <> ? then do:
     2753       reposition br-c-action-role to recid p-recid no-error.
     2754       apply "value-changed" to br-c-action-role in frame Dialog-Frame.
     2755     end.
     2756     apply "entry" to br-c-action-role in frame Dialog-Frame.
     2757   END PROCEDURE.
     2758   procedure re-open-query-srt-clmnbr-c-action-role:
     2759   if cur-clmnbr-c-action-role = ? then do:
     2760      run OpenBr in this-procedure.
     2761   end.
     2762   else do:
     2763      assign re-querybr-c-action-role = yes.
     2764      run sort-brbr-c-action-role
     2765        (input (if available X_c-action-role
     2766                then recid(X_c-action-role)
     2767                else ?
     2768               )
     2769        ).
     2770      assign re-querybr-c-action-role = no.
     2771   end.
     2772   end.
     2773   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2774   procedure set-filter-name :
     2775   define input parameter p-filter-name as character no-undo .
     2776     do with frame Dialog-Frame:
     2777       if p-filter-name > "" then do:
     2778         assign
     2779           frame Dialog-Frame:title
     2780             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2781         .
     2782         assign
     2783           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2784         .
     2785       end.
     2786       else do:
     2787         assign
     2788           b-sch :tooltip = ""
     2789         .
     2790       end.
     2791     end.
     2792   end procedure.
     2793   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2794   on INS of frame Dialog-Frame anywhere do:
     2795     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     2796     return no-apply.
     2797   end.
     2798   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2799   on F2 of frame Dialog-Frame anywhere do:
     2800     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     2801     return no-apply.
     2802   end.
     2803   MAIN-BLOCK:
     2804   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2805       ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2806       CASE parref-mode:
     2807           WHEN 'все':U        THEN
     2808               DO:
     2809               END.
     2810           WHEN "one":U THEN
     2811               DO:
     2812                   find first X_action-role no-lock where
     2813                       X_action-role.db-num = pardb-num
     2814                       AND  X_action-role.action-head-code = parhead-code
     2815                       AND  X_action-role.action-role-code = parrole-code
     2816                       no-error .
     2817                   if not available X_action-role then
     2818                   do:
     2819                       message
     2820                           vss-workfile vss-revision vss-description skip
     2821                           "Неверный значение параметров pardb-num parhead-code parrole-code "
     2822                           view-as alert-box ERROR.
     2823                       return.
     2824                   end.
     2825               END.
     2826           otherwise
     2827           do:
     2828               message vss-workfile vss-revision vss-description skip
     2829                   "Неверный вызов - parref-mode=" parref-mode
     2830                   view-as alert-box ERROR.
     2831               return.
     2832           end.
     2833       end case.
     2834       RUN MyEnable in this-procedure .
     2835       HIDE mark-num in frame Dialog-Frame .
     2836       run OpenBR in this-procedure.
     2837       run diasize_add_browse in this-procedure
     2838           (input  'width':u
     2839           ,input  browse br-changes :handle
     2840           ) .
     2841       run diasize_init in this-procedure .
     2842       WAIT-FOR GO OF FRAME Dialog-Frame.
     2843   END.
     2844   RUN disable_UI.
     2845   PROCEDURE disable_UI :
     2846     HIDE FRAME Dialog-Frame.
     2847   END PROCEDURE.
     2848   PROCEDURE enable_UI :
     2849     DISPLAY mark-num
     2850         WITH FRAME Dialog-Frame.
     2851     ENABLE b-quit B-mark b-sel B-sch B-Help mark-num BR-c-action-role
     2852         WITH FRAME Dialog-Frame.
     2853     VIEW FRAME Dialog-Frame.
     2854   END PROCEDURE.
     2855   PROCEDURE MyEnable :
     2856       br-changes:title in frame Dialog-Frame  = "":U.
     2857       assign
     2858           temp-changes.l_name:resizable in browse br-changes = true
     2859           temp-changes.v_old:resizable in browse br-changes  = true
     2860           temp-changes.v_new:resizable in browse br-changes  = true
     2861           temp-changes.l_name:width in browse br-changes     = 30
     2862           temp-changes.v_old:width in browse br-changes      = 40
     2863           temp-changes.v_new:width in browse br-changes      = 40
     2864           .
     2865       DISPLAY
     2866           mark-num
     2867           br-changes
     2868           WITH FRAME Dialog-Frame.
     2869       ENABLE
     2870           B-quit
     2871           B-mark
     2872           when lookup('b-mark':U, bttns) >0
     2873           B-sel
     2874           when lookup('b-sel':U, bttns) >0
     2875           B-sch
     2876           B-Help
     2877           BR-c-action-role
     2878           br-changes
     2879           mark-num
     2880           WITH FRAME Dialog-Frame.
     2881       VIEW FRAME Dialog-Frame.
     2882   END PROCEDURE.
     2883   PROCEDURE OpenBr :
     2884   define variable l-query-was-opened as logical   no-undo .
     2885       define variable sort-column-phrase as character no-undo .
     2886       case sort-column-name :
     2887           when "" then
     2888               do:
     2889                   assign
     2890                       sort-column-phrase = ""
     2891                       .
     2892               end.
     2893           otherwise
     2894           do:
     2895               assign
     2896                   sort-column-phrase = "by " + sort-column-name
     2897                   .
     2898           end.
     2899       end case.
     2900       CASE parref-mode:
     2901           when 'все':U then
     2902               do:
     2903                   ASSIGN
     2904                       frame Dialog-Frame:TITLE = "Справочник групп прав"
     2905                       filter-point              = filter-point0 + parref-mode
     2906                       filter-label              = substitute("&1", filter-label0)
     2907                       .
     2908   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2909   define variable  l-disable-where-23  as logical   no-undo .
     2910   define variable  l-filter-open-23    as logical   .
     2911   define variable  flt-rec-23       as recid     no-undo .
     2912   define variable  filter-name-23      as character no-undo .
     2913   define variable  where-phrase-23     as character no-undo .
     2914   define variable  sort-phrase-23      as character no-undo .
     2915   define variable  where-phrase-rus-23 as character no-undo .
     2916   define variable  sort-phrase-rus-23  as character no-undo .
     2917     run waitfram-show in this-procedure
     2918       (input "ЖДИТЕ ..."
     2919       ).
     2920   run gbl/flt-get.p
     2921     (input filter-point
     2922     ,output flt-rec-23
     2923     ,output filter-name-23
     2924     ,output where-phrase-23
     2925     ,output sort-phrase-23
     2926     ,output where-phrase-rus-23
     2927     ,output sort-phrase-rus-23
     2928     ).
     2929       run set-filter-name in this-procedure
     2930         (INPUT filter-name-23
     2931         ) no-error .
     2932     assign
     2933       l-filter-open-23 = false
     2934     .
     2935     if flt-rec-23 <> ?
     2936       or sort-column-phrase > ""
     2937     then do:
     2938       define variable  parameter-2-23 as character no-undo .
     2939       define variable  parameter-3-23 as character no-undo .
     2940       define variable  parameter-4-23 as character no-undo .
     2941       define variable  parameter-5-23 as character no-undo .
     2942       define variable  parameter-6-23 as character no-undo .
     2943       define variable  parameter-7-23 as character no-undo .
     2944         assign
     2945         parameter-3-23 =
     2946                                 "FOR EACH X_c-action-role"
     2947         parameter-4-23 =
     2948           (
     2949             if (" TRUE " + " " + where-phrase-23) <> ""
     2950             then " TRUE " + " " + where-phrase-23
     2951             else "true"
     2952           )
     2953         parameter-5-23 = (" " + "" + " " + "")
     2954         parameter-6-23 = if sort-phrase-23 = ''
     2955                              then
     2956           (
     2957           " " + "  " +
