     3145   PROCEDURE proc-b-sch :
     3146       assign
     3147           tbl      = 'c-action-role'
     3148           join-tbl = 'X_c-action-role'
     3149           fld      = ""
     3150           lab      = ""
     3151           spr      = ""
     3152           dim      = '0'
     3153           .
     3154       run fltfield-add in this-procedure('db-num', 'БД', '',
     3155           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3156       run fltfield-add in this-procedure('action-head-code', 'Код заголовка права', '',
     3157           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3158       run fltfield-add in this-procedure('action-role-code', 'Код роли', '',
     3159           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3160       run fltfield-add in this-procedure('action-role-context', 'Контекст роли', '',
     3161           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3162       run fltfield-add in this-procedure('action-role-name', 'Имя роли', '',
     3163           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3164       run fltfield-add in this-procedure('action-role-description', 'Описание роли', '',
     3165           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3166       run fltfield-add in this-procedure('corr-date', 'Дата изменений', '',
     3167           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3168       run fltfield-add in this-procedure('corr-time', 'Время изменений', 'time',
     3169           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3170       run fltfield-add in this-procedure('corr-user-db-num', 'БД изменений', '',
     3171           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3172       run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     3173           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3174       run fltfield-add in this-procedure('is-del', 'Удаленная запись', '',
     3175           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
