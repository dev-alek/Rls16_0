     3188   PROCEDURE proc-view-changes :
     3189       define variable v-description as character no-undo .
     3190       for each temp-changes:
     3191           delete temp-changes.
     3192       END.
     3193       if not available X_c-action-role then
     3194       do:
     3195           Open QUery br-changes for each temp-changes.
     3196           return.
     3197       end.
     3198       run ref/cactnrolev.p (
     3199           input X_c-action-role.db-num
     3200           ,input X_c-action-role.action-head-code
     3201           ,input X_c-action-role.action-role-code
     3202           ,input X_c-action-role.corr-user-db-num
     3203           ,input X_c-action-role.chip-num
     3204           ,input X_c-action-role.subject
     3205           ,input 0
     3206           ,input no
     3207           ,output v-description
     3208           ) no-error .
     3209       Open QUery br-changes for each temp-changes.
     3210       assign
     3211           br-changes:title in frame Dialog-Frame = v-description
     3212           .
     3213   END PROCEDURE.
     3214   FUNCTION get-action RETURNS CHARACTER
     3215       ( p-action as integer ) :
     3216          define variable dops as character no-undo.
     3217       assign
     3218           dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     3219       RETURN dops.
     3220   END FUNCTION.
     3221   FUNCTION get-subject RETURNS CHARACTER
     3222       ( p-subject as character ) :
     3223       define variable dops as character no-undo.
     3224       case p-subject:
     3225           when 'action-role':U then
     3226               do:
     3227                   assign
     3228                       dops = "роль" no-error.
     3229               end.
     3230           when 'action-role-item':U then
     3231               do:
     3232                   assign
     3233                       dops = "право" no-error.
     3234               end.
     3235       end case .
     3236       RETURN dops.
     3237   END FUNCTION.
