     1578           v-diasize-resize-button :column = 1
     1579         .
     1580       end.
     1581       if p-change-value > 0
     1582       then do:
     1583         if frame Dialog-Frame :scrollable = true
     1584         then do:
     1585           assign
     1586             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1587             no-error .
     1588           if error-status :error
     1589           or error-status :get-message(1) <> ""
     1590           then do:
     1591             undo move_block, retry move_block .
     1592           end.
     1593         end.
     1594         assign
     1595           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
