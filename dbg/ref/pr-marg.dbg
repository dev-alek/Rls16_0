     1730   end procedure.
     1731   procedure diasize_set-height :
     1732     define input  parameter p-new-height  as decimal   no-undo .
     1733     define input  parameter p-move-resize as logical   no-undo .
     1734     do
     1735     on error undo, return error return-value
     1736     :
     1737       run diasize_change-height in this-procedure
     1738         (input  (p-new-height - frame Dialog-Frame :height)
     1739         ,input  p-move-resize
     1740         ) .
     1741     end.
     1742   end procedure.
     1743   procedure diasize_change-width :
     1744     define input  parameter p-change-value as decimal   no-undo .
     1745     define input  parameter p-move-resize  as logical   no-undo .
     1746     define variable v-field-group-handle   as handle    no-undo .
     1747     define variable v-object-handle        as handle    no-undo .
