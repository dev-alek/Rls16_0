        1   define input parameter parparentproc    as handle           no-undo.
        2   define input parameter p-node-code          like ub.gds-grp.node-code no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Границы торговой наценки на группы товаров".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   procedure grp-obj-write :
       80   do
       81   on error undo, return error
       82   :
       83   define input parameter p-node-code  like ub.gds-grp-obj.node-code      no-undo.
       84   define input parameter p-host-code  as integer                          no-undo.
       85   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
       86   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
       87   define input parameter p-min-increase like ub.gds-grp-obj.min-increase  no-undo.
       88   define input parameter p-max-increase like ub.gds-grp-obj.max-increase  no-undo.
       89   define input parameter p-increase-pc like ub.gds-grp-obj.increase-pc  no-undo.
       90   define input parameter p-calc-method like ub.gds-grp-obj.calc-method no-undo .
       91   define input parameter p-round-method like ub.gds-grp-obj.round-method no-undo .
       92   define input parameter p-round-coef like ub.gds-grp-obj.round-coef no-undo .
       93   define input parameter p-cli-type   like ub.clients.obj-type            no-undo.
       94   define input parameter p-cli-code   like ub.clients.obj-code            no-undo.
       95   define buffer buf_gds-grp-obj for ub.gds-grp-obj.
       96       find first buf_gds-grp-obj exclusive-lock
       97            where buf_gds-grp-obj.node-code  = p-node-code
       98              and buf_gds-grp-obj.host-code  = p-host-code
       99              and buf_gds-grp-obj.obj-type   = p-obj-type
      100              and buf_gds-grp-obj.obj-code   = p-obj-code
      101       no-error.
      102       if not available buf_gds-grp-obj
      103       then do:
      104           create buf_gds-grp-obj.
      105           assign
      106                   buf_gds-grp-obj.node-code  = p-node-code
      107                   buf_gds-grp-obj.host-code  = p-host-code
      108                   buf_gds-grp-obj.obj-type   = p-obj-type
      109                   buf_gds-grp-obj.obj-code   = p-obj-code
      110           .
      111       end.
      112       assign
      113       buf_gds-grp-obj.min-increase = p-min-increase
      114       buf_gds-grp-obj.max-increase = p-max-increase
      115       buf_gds-grp-obj.increase-pc = p-increase-pc
      116       buf_gds-grp-obj.calc-method = p-calc-method
      117       buf_gds-grp-obj.round-method = p-round-method
      118       buf_gds-grp-obj.round-coef = p-round-coef
      119       buf_gds-grp-obj.cli-type   = p-cli-type
      120       buf_gds-grp-obj.cli-code   = p-cli-code
      121       .
      122   end.
      123   end procedure.
      124   procedure grp-obj-margin-value :
      125   do
      126   on error undo, return error
      127   :
      128   define input parameter p-node-code as integer      no-undo.
      129   define input parameter p-obj-type  as character    no-undo.
      130   define input parameter p-obj-code  as integer      no-undo.
      131   define output parameter p-min-value as decimal      no-undo init ?.
      132   define output parameter p-max-value as decimal      no-undo init ?.
      133   define output parameter p-increase-pc as decimal      no-undo init ?.
      134   define output parameter p-round-method as character no-undo init "":U.
      135   define output parameter p-base as decimal no-undo init ?.
      136   define output parameter p-range-margin     as integer      no-undo.
      137   define output parameter p-exists-margin    as logical      no-undo.
      138   define output parameter p-range-increase     as integer      no-undo.
      139   define output parameter p-exists-increase    as logical      no-undo.
      140   define output parameter p-range-rmethod     as integer no-undo .
      141   define output parameter p-exists-rmethod    as logical no-undo .
      142   define variable v-host-code as integer      no-undo.
      143   DEFINE VARIABLE v-found as logical no-undo .
      144   DEFINE VARIABLE v-exists as logical no-undo .
      145   DEFINE VARIABLE v-range as integer no-undo .
      146   DEFINE VARIABLE jj as integer no-undo .
      147   DEFINE VARIABLE v-margin-found as logical no-undo .
      148   DEFINE VARIABLE v-increase-found as logical no-undo .
      149   DEFINE VARIABLE v-min-value as decimal      no-undo.
      150   DEFINE VARIABLE v-max-value as decimal      no-undo.
      151   DEFINE VARIABLE v-increase-pc as decimal      no-undo.
      152   define variable v-round-method as character no-undo .
      153   define variable v-base as decimal no-undo .
      154   define variable v-print-code as character no-undo .
      155   define buffer buf_gds-grp for ub.gds-grp.
      156   find first buf_gds-grp no-lock where
      157              buf_gds-grp.node-code = p-node-code no-error .
      158   if not avail buf_gds-grp and p-node-code <> 0 then do:
      159     message
      160       vss-workfile vss-revision vss-description
      161       skip "Не удалось найти группу товаров с кодом" p-node-code
      162       view-as alert-box error .
      163     undo, return error .
      164   end.
      165   if p-obj-type <> '' then do:
      166   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      167   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      168     (input  p-obj-type
      169     ,input  p-obj-code
      170     ,output v-host-code
      171     ) no-error .
      172     if error-status :error
      173     then do:
      174         message
      175           vss-workfile vss-revision vss-description
      176           skip "Не удалось найти фирму объекта"
      177           skip p-obj-type p-obj-code
      178           skip return-value
      179           skip trim(error-status :get-message(1))
      180               trim(error-status :get-message(2))
      181               trim(error-status :get-message(3))
      182               trim(error-status :get-message(4))
      183               trim(error-status :get-message(5))
      184         view-as alert-box error.
      185         undo, return error .
      186     end.
      187   end.
      188   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
      189   do while v-found = no and jj < 2:
      190     if v-range <> 3 then do:
      191       find first buf_gds-grp-obj no-lock
      192           where buf_gds-grp-obj.node-code = p-node-code
      193             and buf_gds-grp-obj.host-code = v-host-code
      194             and buf_gds-grp-obj.obj-type  = p-obj-type
      195             and buf_gds-grp-obj.obj-code  = p-obj-code
      196       no-error .
      197     end.
      198     if v-range = 3 or not available buf_gds-grp-obj
      199     then do:
      200        if v-range <> 2 then do:
      201           find first buf_gds-grp-obj no-lock
      202               where buf_gds-grp-obj.node-code = p-node-code
      203                 and buf_gds-grp-obj.host-code = v-host-code
      204                 and buf_gds-grp-obj.obj-type  = ""
      205                 and buf_gds-grp-obj.obj-code  = 0
      206           no-error .
      207         end.
      208         if v-range = 2 or not available buf_gds-grp-obj
      209         then do:
      210             if v-range <> 1 then do:
      211               find first buf_gds-grp-obj no-lock
      212                   where buf_gds-grp-obj.node-code = p-node-code
      213                   and buf_gds-grp-obj.host-code = 0
      214                   and buf_gds-grp-obj.obj-type  = ""
      215                   and buf_gds-grp-obj.obj-code  = 0
      216               no-error .
      217             end.
      218             if v-range = 1 or not available buf_gds-grp-obj
      219             then do:
      220                 assign
      221                     v-exists = no
      222                 .
      223             end.
      224             else do:
      225                 assign
      226                     v-exists = yes
      227                     v-range = 1
      228                 .
      229             end.
      230         end.
      231         else do:
      232             assign
      233                 v-exists = yes
      234                 v-range  = 2
      235             .
      236         end.
      237     end.
      238     else do:
      239         assign
      240             v-exists = yes
      241             v-range  = 3
      242         .
      243     end.
      244     if available buf_gds-grp-obj
      245     then do:
      246       assign
      247       v-min-value    = buf_gds-grp-obj.min-increase
      248       v-max-value    = buf_gds-grp-obj.max-increase
      249       v-increase-pc  = buf_gds-grp-obj.increase-pc
      250       v-round-method = buf_gds-grp-obj.round-method
      251       v-base         = buf_gds-grp-obj.round-coef
      252       .
      253       assign
      254       p-exists-margin = (if v-min-value <> ? and v-max-value <> ? and p-min-value = ?
      255                           then yes
      256                           else p-exists-margin)
      257       p-range-margin = if p-exists-margin and p-min-value = ?
      258                         then v-range
      259                         else p-range-margin
      260       p-min-value   =  if p-exists-margin and  p-min-value = ?
      261                         then v-min-value
      262                         else p-min-value
      263       p-max-value   =  if p-exists-margin and  p-max-value = ?
      264                         then v-max-value
      265                         else p-max-value
      266       p-exists-increase = (if v-increase-pc <> ? and p-increase-pc = ?
      267                           then yes
      268                           else p-exists-increase)
      269       p-range-increase = if p-exists-increase and p-increase-pc = ?
      270                         then v-range
      271                         else p-range-increase
      272       p-increase-pc = (if p-exists-increase and p-increase-pc = ?
      273                         then v-increase-pc
      274                         else p-increase-pc)
      275       p-exists-rmethod = if v-round-method <> "":U and p-round-method = "":U
      276                           then yes
      277                           else p-exists-rmethod
      278       p-range-rmethod = (if p-exists-rmethod and p-round-method = "":U
      279                           then v-range
      280                           else p-range-rmethod)
      281       p-round-method  = (if p-exists-rmethod and p-round-method = "":U
      282                           then v-round-method
      283                           else p-round-method)
      284       p-base          = (if p-exists-rmethod and p-base = ?
      285                           then v-base
      286                           else p-base)
      287       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod) or (v-range <= 1)
      288       jj = jj + 1
      289       .
      290     end.
      291     else do:
      292       assign
      293       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod ) or (v-range <= 1)
      294       jj = jj + 1
      295       .
      296     end.
      297   end.
      298   end.
      299   end procedure.
      300   procedure grp-obj-income-cli-value :
      301   do
      302   on error undo, return error
      303   :
      304   define input parameter p-node-code as integer      no-undo.
      305   define input parameter p-obj-type  as character    no-undo.
      306   define input parameter p-obj-code  as integer      no-undo.
      307   define output parameter p-cli-type as character    no-undo init ?.
      308   define output parameter p-cli-code as integer      no-undo init ?.
      309   define output parameter p-range-income-cli     as integer      no-undo.
      310   define output parameter p-exists-income-cli    as logical      no-undo.
      311   define variable v-host-code as integer      no-undo.
      312   DEFINE VARIABLE v-found as logical no-undo .
      313   DEFINE VARIABLE v-exists as logical no-undo .
      314   DEFINE VARIABLE v-range as integer no-undo .
      315   DEFINE VARIABLE jj as integer no-undo .
      316   DEFINE VARIABLE v-income-cli-found as logical no-undo .
      317   DEFINE VARIABLE v-cli-type-value as char      no-undo.
      318   DEFINE VARIABLE v-cli-code-value as int      no-undo.
      319   define buffer buf_gds-grp for ub.gds-grp.
      320   find first buf_gds-grp no-lock where
      321              buf_gds-grp.node-code = p-node-code no-error .
      322   if not avail buf_gds-grp and p-node-code <> 0 then do:
      323     message
      324       vss-workfile vss-revision vss-description
      325       skip "Не удалось найти группу товаров с кодом" p-node-code
      326       view-as alert-box error .
      327     undo, return error .
      328   end.
      329   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      330   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      331     (input  p-obj-type
      332     ,input  p-obj-code
      333     ,output v-host-code
      334     ) no-error .
      335   if error-status :error
      336   then do:
      337       message
      338         vss-workfile vss-revision vss-description
      339         skip "Не удалось найти фирму объекта"
      340         skip p-obj-type p-obj-code
      341         skip return-value
      342         skip trim(error-status :get-message(1))
      343              trim(error-status :get-message(2))
      344              trim(error-status :get-message(3))
      345              trim(error-status :get-message(4))
      346              trim(error-status :get-message(5))
      347       view-as alert-box error.
      348       undo, return error .
      349   end.
      350   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
      351   do while v-found = no and jj < 2:
      352     if v-range <> 3 then do:
      353       find first buf_gds-grp-obj no-lock
      354           where buf_gds-grp-obj.node-code = p-node-code
      355             and buf_gds-grp-obj.host-code = v-host-code
      356             and buf_gds-grp-obj.obj-type  = p-obj-type
      357             and buf_gds-grp-obj.obj-code  = p-obj-code
      358       no-error .
      359     end.
      360     if v-range = 3 or not available buf_gds-grp-obj
      361     then do:
      362        if v-range <> 2 then do:
      363           find first buf_gds-grp-obj no-lock
      364               where buf_gds-grp-obj.node-code = p-node-code
      365                 and buf_gds-grp-obj.host-code = v-host-code
      366                 and buf_gds-grp-obj.obj-type  = ""
      367                 and buf_gds-grp-obj.obj-code  = 0
      368           no-error .
      369         end.
      370         if v-range = 2 or not available buf_gds-grp-obj
      371         then do:
      372             if v-range <> 1 then do:
      373               find first buf_gds-grp-obj no-lock
      374                   where buf_gds-grp-obj.node-code = p-node-code
      375                   and buf_gds-grp-obj.host-code = 0
      376                   and buf_gds-grp-obj.obj-type  = ""
      377                   and buf_gds-grp-obj.obj-code  = 0
      378               no-error .
      379             end.
      380             if v-range = 1 or not available buf_gds-grp-obj
      381             then do:
      382                 assign
      383                     v-exists = no
      384                 .
      385             end.
      386             else do:
      387                 assign
      388                     v-exists = yes
      389                     v-range = 1
      390                 .
      391             end.
      392         end.
      393         else do:
      394             assign
      395                 v-exists = yes
      396                 v-range  = 2
      397             .
      398         end.
      399     end.
      400     else do:
      401         assign
      402             v-exists = yes
      403             v-range  = 3
      404         .
      405     end.
      406     if available buf_gds-grp-obj
      407     then do:
      408       assign
      409       v-cli-type-value    = buf_gds-grp-obj.cli-type
      410       v-cli-code-value    = buf_gds-grp-obj.cli-code
      411       .
      412       assign
      413       p-exists-income-cli = (if v-cli-type-value <> ? and v-cli-code-value <> ? and p-cli-type = ?
      414                           then yes
      415                           else p-exists-income-cli)
      416       p-range-income-cli = if p-exists-income-cli and p-cli-type = ?
      417                         then v-range
      418                         else p-range-income-cli
      419       p-cli-type   =  if p-exists-income-cli and  p-cli-type = ?
      420                         then v-cli-type-value
      421                         else p-cli-type
      422       p-cli-code   =  if p-exists-income-cli and  p-cli-code = ?
      423                         then v-cli-code-value
      424                         else p-cli-code
      425       v-found =  (p-exists-income-cli ) or (v-range <= 1)
      426       jj = jj + 1
      427       .
      428     end.
      429     else do:
      430       assign
      431       v-found =  (p-exists-income-cli  ) or (v-range <= 1)
      432       jj = jj + 1
      433       .
      434     end.
      435   end.
      436   end.
      437   end procedure.
      438   define variable vss-include-info3 as character format "X(65)" no-undo
      439   initial "@(#)$Workfile$ $Revision$".
      440   procedure grplib-get-full-name :
      441      define input parameter p-node-code  as integer      no-undo.
      442      define output parameter p-full-name as character    no-undo.
      443      do
      444   on error undo, return error
      445   :
      446       define variable v-upper-code    as integer           no-undo.
      447       define buffer buf_gds-grp       for ub.gds-grp.
      448       define buffer buf_upper_gds-grp for ub.gds-grp.
      449       find first buf_gds-grp no-lock
      450            where buf_gds-grp.node-code = p-node-code
      451       no-error.
      452       if not available buf_gds-grp
      453       then do:
      454           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      455       end.
      456       assign
      457           p-full-name  = ""
      458           v-upper-code = 1
      459       .
      460       do while buf_gds-grp.upper-code <> 0
      461       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      462       :
      463           assign
      464               p-full-name  = buf_gds-grp.node-name
      465                            + (if p-full-name <> "" then chr(47) else "")
      466                            + p-full-name
      467               v-upper-code = buf_gds-grp.upper-code
      468           .
      469           find first buf_gds-grp no-lock
      470                where buf_gds-grp.node-code = v-upper-code
      471           no-error.
      472           if not available buf_gds-grp
      473           then do:
      474               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      475                                   + string( v-upper-code )
      476                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      477           end.
      478       end.
      479       assign
      480       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      481       .
      482   end.
      483   end .
      484   procedure grplib-get-node-from-full-name :
      485   define input parameter p-full-name as character no-undo .
      486   define output parameter p-node-code as integer no-undo .
      487   define variable v-ii as integer no-undo .
      488   define variable v-upper-code as integer no-undo .
      489   define variable v-root-code as integer no-undo .
      490   define variable v-entry as character no-undo .
      491   define buffer buf_gds-grp       for ub.gds-grp.
      492   do
      493   on error undo, return error
      494   :
      495     find first buf_gds-grp no-lock
      496         where buf_gds-grp.upper-code = 0
      497     no-error .
      498     if not available buf_gds-grp
      499     then do:
      500         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      501     end.
      502     else do:
      503       assign
      504       v-root-code = buf_gds-grp.node-code
      505       .
      506     end.
      507     v-upper-code = v-root-code.
      508     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      509       assign
      510       v-entry = entry(v-ii, p-full-name, chr(47)).
      511       if v-entry = '' then leave.
      512       find first buf_gds-grp no-lock where
      513                 buf_gds-grp.node-name = v-entry
      514             and buf_gds-grp.upper-code = v-upper-code
      515             no-error.
      516       if not available buf_gds-grp then do:
      517         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      518       end.
      519       else do:
      520         p-node-code = buf_gds-grp.node-code.
      521         v-upper-code = buf_gds-grp.node-code.
      522       end.
      523     end.
      524   end.
      525   end .
      526   procedure proc-alt-shift-f2:
      527     if not ibs.th.gbl.gbl-var:rcode
      528   then
      529     run gbl\inidebug.p .
      530   end.
      531   procedure proc-alt-shift-f3:
      532     run gbl/prvssinf.p
      533       ( input this-procedure
      534       ) .
      535   end.
      536   define variable v-inform-launched as logical no-undo initial false .
      537   procedure proc-alt-shift-f4:
      538     define variable v-action as character no-undo .
      539     if v-inform-launched = false then do:
      540       assign
      541         v-inform-launched = true
      542       .
      543       run gbl/d-inform.w
      544         (  input self
      545         ,  input this-procedure
      546         , output v-action
      547         ) no-error .
      548       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      549       assign
      550         v-inform-launched = false
      551       .
      552     end.
      553   end.
      554   procedure proc-alt-f1:
      555     run gbl/corrhelp.p
      556       (input this-procedure
      557       ) .
      558   end .
      559   on alt-shift-f2 anywhere do:
      560     run proc-alt-shift-f2.
      561   end.
      562   on alt-shift-f3 anywhere do:
      563     run proc-alt-shift-f3 in this-procedure .
      564   end.
      565   on alt-shift-f4 anywhere do:
      566     run proc-alt-shift-f4 in this-procedure.
      567   end.
      568   on alt-f1 anywhere do:
      569     run proc-alt-f1 in this-procedure .
      570   end.
