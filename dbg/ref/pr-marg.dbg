     1549           then do:
     1550             find first buf_temp-browse-handle
     1551               where buf_temp-browse-handle.browse-type   = 'height':u
     1552                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1553               no-error .
     1554             if available buf_temp-browse-handle
     1555             then do:
     1556             end.
     1557             else do:
     1558               create buf_temp-diasize-handle .
