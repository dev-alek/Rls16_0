     1113   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1114   DO:
     1115   define variable v-mess-firm as character no-undo.
     1116   if temp_attr.host-code = 0
     1117   and temp_attr.obj-type = ""
     1118   and temp_attr.obj-code = 0
     1119   then do:
     1120       message
     1121       "Нельзя удалить глобальное значение торговой наценки"
     1122       view-as alert-box ERROR.
     1123       return no-apply.
     1124   end.
     1125       if temp_attr.host-code <> v-cntxt-host-code-obj
     1126       then do:
     1127           message
     1128               skip "Нельзя удалить значение наценки"
     1129               skip "на объекте, не принадлежащем текущей фирме"
     1130           view-as alert-box error.
     1131           undo, return no-apply .
     1132       end.
     1133       if temp_attr.obj-type = ""
     1134       and temp_attr.obj-code = 0
     1135       then do:
     1136           assign
     1137               v-mess-firm = "по текущей фирме " + v-host-name
     1138           .
     1139       end.
     1140       else do:
     1141           assign
     1142               v-mess-firm = "по объекту " + temp_attr.obj-type + string( temp_attr.obj-code )
     1143           .
     1144       end.
     1145       message
     1146           "Подтвердите удаление торговых наценок для группы "
     1147           skip v-full-grp-name
     1148           skip(1) v-mess-firm
     1149       view-as alert-box buttons yes-no update v-yes-no as logical  .
     1150       if v-yes-no = yes
     1151       then do:
     1152           run delete-attr-by-br-line in this-procedure no-error .
     1153           if error-status :error
     1154           then do:
     1155               message
     1156                   vss-workfile vss-revision vss-description
     1157                   skip "Ошибка при удалении наценки для группы"
     1158                   skip v-full-grp-name
     1159                   skip(1) v-mess-firm
     1160                   skip return-value
     1161                   skip trim(error-status :get-message(1))
     1162                           trim(error-status :get-message(2))
     1163                           trim(error-status :get-message(3))
     1164                           trim(error-status :get-message(4))
     1165                           trim(error-status :get-message(5))
     1166               view-as alert-box error.
     1167               undo, return no-apply .
     1168           end.
     1169           else do:
     1170               run ui-on in this-procedure .
     1171           end.
     1172       end.
     1173   END.
