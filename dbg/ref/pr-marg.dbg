     1751     define variable v-window-width         as decimal   no-undo .
     1752     define variable v-window-virtual-width as decimal   no-undo .
     1753     define variable v-change-sign          as integer   no-undo .
     1754     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1755     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1756     if p-change-value > 0
     1757     then do:
     1758       if frame Dialog-Frame :width + p-change-value >
     1759           session :width-chars
     1760       then do:
     1761         assign
     1762           p-change-value = session :width-chars - frame Dialog-Frame :width
     1763         .
     1764         if p-change-value <= 0
     1765         then do:
     1766           run diasize_position-resize-button in this-procedure .
     1767           return .
     1768         end.
     1769       end.
     1770     end.
     1771     if p-change-value < 0
     1772     then do:
     1773       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1774       then do:
     1775         assign
     1776           p-change-value = v-diasize-orig-frame-width
     1777                          - frame Dialog-Frame :width
     1778         .
     1779         if p-change-value >= 0
     1780         then do:
     1781           run diasize_position-resize-button in this-procedure .
     1782           return .
     1783         end.
     1784       end.
     1785     end.
     1786     if p-change-value >= 0
     1787     then do:
     1788       assign
     1789         v-change-sign = 1
     1790       .
     1791     end.
     1792     else do:
     1793       assign
     1794         v-change-sign = -1
     1795       .
     1796     end.
     1797     assign
     1798       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1799     .
     1800     if p-change-value = 0
     1801     then do:
     1802       run diasize_position-resize-button in this-procedure .
     1803       return .
     1804     end.
     1805     move_block:
     1806     do
