     1204   ON VALUE-CHANGED OF S-round-method IN FRAME Dialog-Frame
     1205   DO:
     1206     assign
     1207     S-round-method
     1208     .
     1209     if lookup(S-round-method, 'Произвольно,Вверх,Коэффициент,9-99окончание':U) > 0 then do:
     1210       display
     1211       f-base
     1212       with frame Dialog-Frame.
     1213     end.
     1214     else do:
     1215       hide
     1216       f-base
     1217       in frame Dialog-Frame.
     1218     end.
     1219   END.
     1220   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1221   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1222   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1223   on help of frame Dialog-Frame
     1224   do:
     1225     run gbl/app_help.p
     1226       (input this-procedure :file-name
     1227       ,input ''
     1228       ,input ?
     1229       ) no-error.
     1230     if error-status :error then do:
     1231       message
     1232         "Ошибка при вызове помощи"
     1233         error-status :get-message(1)
     1234         view-as alert-box .
     1235     end.
     1236   end.
     1237   run minbtn-set in this-procedure .
     1238   on choose of b-help in frame Dialog-Frame
     1239   do:
     1240     apply "help":u to frame Dialog-Frame .
     1241   end.
     1242   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1243   procedure minbtn-set :
     1244       do
     1245           on error undo, return error return-value
     1246           :
     1247           define variable ii              as integer       no-undo .
     1248           define variable fh              as widget-handle no-undo .
     1249           define variable hh              as widget-handle no-undo .
     1250           define variable v-h             as handle        extent 4 no-undo .
     1251           define variable v-name-button   as character     no-undo .
     1252           define variable v-help-old-x    as decimal       no-undo .
     1253           define variable v-help-old-y    as decimal       no-undo .
     1254           define variable v-help-old-size as decimal       no-undo .
     1255           define variable v-frame-width   as decimal       no-undo .
     1256           define variable jj              as integer       no-undo .
     1257           do
     1258               on error undo, return error
     1259               :
     1260               assign
     1261                   v-frame-width = frame Dialog-Frame:width - 0.3
     1262                   fh            = frame Dialog-Frame:first-child
     1263                   hh            = fh:first-child
     1264                   ii            = 1
     1265                   .
     1266               do while valid-handle(hh):
     1267                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1268                   do:
     1269                       case lc(hh:name) :
     1270                           when "b-help" then
     1271                               do:
     1272                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1273                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1274                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1275                                   hh:TOOLTIP = "Помощь" .
     1276                                   v-help-old-x = hh:column .
     1277                                   v-help-old-y = hh:row    .
     1278                                   v-help-old-size = hh:width .
     1279                                   hh:width-chars = 2.5 .
     1280                               end.
     1281                           when "b-print" then
     1282                               do:
     1283                                   hh:load-image("cmp/b-print.bmp":u) .
     1284                                   hh:TOOLTIP = "Печать" .
     1285                                   v-h[ii] = hh:handle .
     1286                                   ii = ii + 1 .
     1287                                   hh:width-chars = 3 .
     1288                               end.
     1289                           when "b-history" or
     1290                           when "b-hist" then
     1291                               do:
     1292                                   hh:load-image("cmp/b-hist.bmp":u) .
     1293                                   hh:TOOLTIP = "История" .
     1294                                   v-h[ii] = hh:handle .
     1295                                   ii = ii + 1 .
     1296                                   hh:width-chars = 3 .
     1297                               end.
     1298                           when "b-sch" then
     1299                               do:
     1300                                   hh:load-image("cmp/b-sch.bmp":u) .
     1301                                   hh:TOOLTIP = "Установка Фильтра" .
     1302                                   v-h[ii] = hh:handle .
     1303                                   ii = ii + 1 .
     1304                                   hh:width-chars = 3 .
     1305                               end.
     1306                           when "b-hist-user" then
     1307                               do:
     1308                                   hh:load-image("cmp/b-hist.bmp":u) .
     1309                                   hh:TOOLTIP = "История пользователя" .
     1310                                   ii = ii + 1 .
     1311                               end.
     1312                       end case.
     1313                   end.
     1314                   hh = hh:next-sibling.
     1315               end.
     1316               b-help:column = v-frame-width - b-help:width-chars.
     1317               jj = 0.
     1318               repeat ii = 4 to 1 by -1 :
     1319                   if valid-handle (v-h[ii] ) then
     1320                   do:
     1321                       jj  = jj + 1 .
     1322                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1323                       v-h[ii]:row    = v-help-old-y .
     1324                   end.
     1325               end.
     1326           end.
     1327       end.
     1328   end procedure.
     1329   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1330   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1331   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1332   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1333   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1334   define variable v-diasize-current-frame-height as decimal   no-undo .
     1335   define variable v-diasize-change-size          as logical   no-undo .
     1336   define variable v-diasize-resize-button        as handle    no-undo .
     1337   define variable v-diasize-wndmax               as logical   no-undo .
     1338   define variable v-diasize-wndstore             as logical   no-undo .
     1339   define variable v-diasize-proc-name            as character no-undo .
     1340   define variable v-diasize-browse-handle        as handle    no-undo .
     1341   define variable v-diasize-browse-number        as integer   no-undo .
     1342   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1343   define temp-table temp-diasize-handle no-undo
     1344     field handle-value  as handle
     1345     field save-position as decimal
     1346     index xpk is primary unique handle-value
     1347     .
     1348   define temp-table temp-browse-handle no-undo
     1349     field browse-type   as character
     1350     field browse-number as integer
     1351     field browse-handle as handle
     1352     field original-size as decimal
     1353     index xpk is primary unique browse-type browse-number
     1354     index xie browse-type browse-handle
     1355   .
     1356   procedure diasize_change-height :
     1357     define input  parameter p-change-value  as decimal   no-undo .
     1358     define input  parameter p-move-resize   as logical   no-undo .
     1359     define variable v-field-group-handle    as handle    no-undo .
     1360     define variable v-object-handle         as handle    no-undo .
     1361     define variable v-frame-height          as decimal   no-undo .
     1362     define variable v-frame-virtual-height  as decimal   no-undo .
     1363     define variable v-browse-height         as decimal   no-undo .
     1364     define variable v-window-height         as decimal   no-undo .
     1365     define variable v-window-virtual-height as decimal   no-undo .
     1366     define variable v-change-sign           as integer   no-undo .
     1367     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1368     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1369     if p-change-value > 0
     1370     then do:
     1371       if frame Dialog-Frame :height + p-change-value
     1372           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1373       then do:
     1374         assign
     1375           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1376                           - (frame Dialog-Frame :height-chars)
     1377         .
     1378         if p-change-value <= 0
     1379         then do:
     1380           run diasize_position-resize-button in this-procedure .
     1381           return .
     1382         end.
     1383       end.
     1384     end.
     1385     if p-change-value < 0
     1386     then do:
     1387       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1388       then do:
     1389         assign
     1390           p-change-value = v-diasize-orig-frame-height
     1391                          - (frame Dialog-Frame :height-chars)
     1392         .
     1393         if p-change-value >= 0
     1394         then do:
     1395           run diasize_position-resize-button in this-procedure .
     1396           return .
     1397         end.
     1398       end.
     1399     end.
     1400     if p-change-value >= 0
     1401     then do:
     1402       assign
     1403         v-change-sign = 1
     1404       .
     1405     end.
     1406     else do:
     1407       assign
     1408         v-change-sign = -1
     1409       .
     1410     end.
     1411     assign
     1412       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1413     .
     1414     if p-change-value = 0
     1415     then do:
     1416       run diasize_position-resize-button in this-procedure .
     1417       return .
     1418     end.
     1419     move_block:
     1420     do
     1421     on error undo move_block, retry move_block
     1422     :
     1423       if retry
     1424       then do:
     1425         do
     1426         on error undo move_block, leave move_block
     1427         :
     1428           if p-change-value > 0
     1429           then do:
     1430             for each buf_temp-diasize-handle
     1431             on error undo, next
     1432             :
     1433               assign
     1434                 v-object-handle = buf_temp-diasize-handle.handle-value
     1435               .
     1436               if v-object-handle <> v-diasize-resize-button
     1437               then do:
     1438                 assign
     1439                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1440                 .
     1441               end.
     1442             end.
     1443             assign
     1444               v-diasize-browse-handle :height = v-browse-height
     1445             .
     1446             for each buf_temp-browse-handle
     1447               where buf_temp-browse-handle.browse-type = 'height':u
     1448             on error undo, next
     1449             :
     1450               assign
     1451                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1452               .
     1453             end.
     1454             assign
     1455               frame Dialog-Frame :height = v-frame-height
     1456             .
     1457             if frame Dialog-Frame :scrollable = true
     1458             then do:
     1459               assign
     1460                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1461               .
     1462             end.
     1463             run diasize_position-resize-button in this-procedure .
     1464           end.
     1465           else do:
     1466             if frame Dialog-Frame :scrollable = true
     1467             then do:
     1468               assign
     1469                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1470               .
     1471             end.
     1472             assign
     1473               frame Dialog-Frame :height = v-frame-height
     1474             .
     1475             assign
     1476               v-diasize-browse-handle :height = v-browse-height
     1477             .
     1478             for each buf_temp-browse-handle
     1479               where buf_temp-browse-handle.browse-type = 'height':u
     1480             on error undo, next
     1481             :
