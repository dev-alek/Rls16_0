      773   procedure grp-obj-notcorr-value :
      774   do
      775   on error undo, return error
      776   :
      777   define input parameter p-node-code             as integer      no-undo.
      778   define input parameter p-obj-type              as character    no-undo.
      779   define input parameter p-obj-code              as integer      no-undo.
      780   define output parameter p-notcorr              as character    no-undo init ?.
      781   define output parameter p-range-notcorr     as integer      no-undo.
      782   define output parameter p-exists-notcorr    as logical      no-undo.
      783   define variable v-host-code as integer      no-undo.
      784   DEFINE VARIABLE v-found as logical no-undo .
      785   DEFINE VARIABLE v-exists as logical no-undo .
      786   DEFINE VARIABLE v-range as integer no-undo .
      787   DEFINE VARIABLE jj as integer no-undo .
      788   DEFINE VARIABLE v-notcorr-found as logical no-undo .
      789   DEFINE VARIABLE v-notcorr-value as char      no-undo.
      790   define buffer buf_gds-grp for ub.gds-grp.
      791   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
      792   find first buf_gds-grp no-lock where
      793              buf_gds-grp.node-code = p-node-code no-error .
      794   if not avail buf_gds-grp and p-node-code <> 0 then do:
      795     message
      796       vss-workfile vss-revision vss-description
      797       skip "Не удалось найти группу товаров с кодом" p-node-code
      798       view-as alert-box error .
      799     undo, return error .
      800   end.
      801   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      802   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      803     (input  p-obj-type
      804     ,input  p-obj-code
      805     ,output v-host-code
      806     ) no-error .
      807   if error-status :error
      808   then do:
      809       message
      810         vss-workfile vss-revision vss-description
      811         skip "Не удалось найти фирму объекта"
      812         skip p-obj-type p-obj-code
      813         skip return-value
      814         skip trim(error-status :get-message(1))
      815       view-as alert-box error.
      816       undo, return error .
      817   end.
      818   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
      819   do while v-found = no and jj < 2:
      820     if v-range <> 3 then do:
      821       find first buf_gds-grp-obj no-lock
      822           where buf_gds-grp-obj.node-code = p-node-code
      823             and buf_gds-grp-obj.host-code = v-host-code
      824             and buf_gds-grp-obj.obj-type  = p-obj-type
      825             and buf_gds-grp-obj.obj-code  = p-obj-code
      826       no-error .
      827     end.
      828     if v-range = 3 or not available buf_gds-grp-obj
      829     then do:
      830        if v-range <> 2 then do:
      831           find first buf_gds-grp-obj no-lock
      832               where buf_gds-grp-obj.node-code = p-node-code
      833                 and buf_gds-grp-obj.host-code = v-host-code
      834                 and buf_gds-grp-obj.obj-type  = ""
      835                 and buf_gds-grp-obj.obj-code  = 0
      836           no-error .
      837         end.
      838         if v-range = 2 or not available buf_gds-grp-obj
      839         then do:
      840             if v-range <> 1 then do:
      841               find first buf_gds-grp-obj no-lock
      842                   where buf_gds-grp-obj.node-code = p-node-code
      843                   and buf_gds-grp-obj.host-code = 0
      844                   and buf_gds-grp-obj.obj-type  = ""
      845                   and buf_gds-grp-obj.obj-code  = 0
      846               no-error .
      847             end.
      848             if v-range = 1 or not available buf_gds-grp-obj
      849             then do:
      850                 assign
      851                     v-exists = no
      852                 .
      853             end.
      854             else do:
      855                 assign
      856                     v-exists = yes
      857                     v-range = 1
      858                 .
      859             end.
      860         end.
      861         else do:
      862             assign
      863                 v-exists = yes
      864                 v-range  = 2
      865             .
      866         end.
      867     end.
      868     else do:
      869         assign
      870             v-exists = yes
      871             v-range  = 3
      872         .
      873     end.
      874     if available buf_gds-grp-obj
      875     then do:
      876       find first buf_gds-grp-obj-attr no-lock
      877         where buf_gds-grp-obj-attr.node-code   = p-node-code
      878           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
      879           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
      880           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
      881           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
      882         no-error .
      883       if available buf_gds-grp-obj-attr then do:
      884         assign
      885           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
      886         .
      887       end.
      888       else do:
      889         assign
      890           v-notcorr-value = ?
      891         .
      892       end.
      893       assign
      894       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
      895                           then yes
      896                           else p-exists-notcorr)
      897       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
      898                         then v-range
      899                         else p-range-notcorr
      900       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
      901                         then v-notcorr-value
      902                         else p-notcorr
      903       v-found =  (p-exists-notcorr ) or (v-range <= 1)
      904       jj = jj + 1
      905       .
      906     end.
      907     else do:
      908       assign
      909       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
      910       jj = jj + 1
      911       .
      912     end.
      913   end.
      914   end.
      915   end procedure.
      916   define variable v-obj-list  as character    no-undo.
      917   define variable v-host-name as character    no-undo.
      918   define variable v-margins   as character    no-undo.
      919   define variable v-full-grp-name as character no-undo.
      920   define variable add-option as character no-undo.
      921   define temp-table temp_attr no-undo
      922       field name            as character
      923       field host-code       as integer
      924       field obj-type        as character
      925       field obj-code        as integer
      926       field min-marg        as character
      927       field max-marg        as character
      928       field increase-pc     as character
      929       field round-method    as character
      930       field cli-type        as character
      931       field cli-code        as integer
      932       field notcorr         as character
      933       field alc-min-price   as character
      934       field marg-pr-paraf   as character
      935       field level-dis-attr  as character
      936       index pi is primary unique host-code obj-type obj-code
      937   .
      938   DEFINE MENU MENU-B-add
      939          MENU-ITEM m_company      LABEL "Фирма"
      940          MENU-ITEM m_object       LABEL "Объект"
      941          MENU-ITEM m_object-list  LABEL "Список объектов".
      942   DEFINE BUTTON B-add
      943        LABEL "&Добавить"
      944        SIZE 10 BY 1.
      945   DEFINE BUTTON B-chg
      946        LABEL "&Изменить"
      947        SIZE 10 BY 1.
