     2075         or error-status :get-message(1) <> ""
     2076         then do:
     2077           undo move_block, retry move_block.
     2078         end.
     2079         if frame Dialog-Frame :scrollable = true
     2080         then do:
     2081           assign
     2082             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2083           no-error .
     2084           if error-status :error
     2085           or error-status :get-message(1) <> ""
     2086           then do:
     2087             undo move_block, retry move_block.
     2088           end.
     2089         end.
     2090       end.
     2091       if p-move-resize
     2092       then do:
     2093         run diasize_position-resize-button in this-procedure .
     2094       end.
     2095       if v-diasize-wndstore = true
     2096       then do:
     2097         if connected("ub") = true
     2098         then do:
     2099           define variable v-cntxt-db-num        as integer   no-undo .
     2100           define variable v-cntxt-userid        as character no-undo .
     2101           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2102                                             , OUTPUT v-cntxt-userid
     2103                                             ) .
     2104           run gbl/wndsizew.p
     2105             (input  v-cntxt-db-num
     2106             ,input  v-cntxt-userid
     2107             ,input  v-diasize-proc-name
     2108             ,input  'width':u
     2109             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2110             ) .
     2111         end.
     2112       end.
     2113     end.
     2114     assign
     2115       v-diasize-change-size = false
     2116     .
     2117   end procedure.
     2118   procedure diasize_set-width :
     2119     define input  parameter p-new-width  as decimal   no-undo .
     2120     define input  parameter p-move-resize as logical   no-undo .
     2121     do
     2122     on error undo, return error return-value
     2123     :
     2124       run diasize_change-width in this-procedure
     2125         (input  (p-new-width - frame Dialog-Frame :width)
     2126         ,input  p-move-resize
     2127         ) .
     2128     end.
     2129   end procedure.
     2130   procedure diasize_position-resize-button :
     2131     do with frame Dialog-Frame
     2132     :
     2133       hide v-diasize-resize-button .
     2134       assign
     2135         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2136                     - 1
     2137                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2138         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2139                     - 1
     2140                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2141       .
     2142       view v-diasize-resize-button .
     2143     end.
     2144   end procedure.
     2145   on alt-right anywhere
     2146   do:
     2147     run diasize_change-width in this-procedure
     2148       (input 1
     2149       ,input true
     2150       ) .
     2151     return no-apply .
     2152   end.
     2153   on alt-left anywhere
     2154   do:
     2155     run diasize_change-width in this-procedure
     2156       (input -1
     2157       ,input true
     2158       ) .
     2159     return no-apply .
     2160   end.
     2161   on alt-down anywhere
     2162   do:
     2163     run diasize_change-height in this-procedure
     2164       (input 1
     2165       ,input true
     2166       ) .
     2167     return no-apply .
     2168   end.
     2169   on alt-up anywhere
     2170   do:
     2171     run diasize_change-height in this-procedure
     2172       (input -1
     2173       ,input true
     2174       ) .
     2175     return no-apply .
     2176   end.
     2177   on alt-enter of frame Dialog-Frame
     2178   do:
     2179     run diasize_maximize in this-procedure
     2180       (input  ?
     2181       ).
     2182     return no-apply .
     2183   end.
     2184   procedure diasize_end-move :
     2185     do
     2186     on error undo, return error return-value
     2187     :
     2188       define variable v-row-delta as decimal   no-undo .
     2189       define variable v-col-delta as decimal   no-undo .
     2190       define variable v-new-row as decimal   no-undo .
     2191       define variable v-new-col as decimal   no-undo .
     2192       assign
     2193         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2194         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2195       .
     2196       assign
     2197         v-row-delta = v-new-row - frame Dialog-Frame :height
     2198         v-col-delta = v-new-col - frame Dialog-Frame :width
     2199       .
     2200       run diasize_change-height in this-procedure
     2201         (input v-row-delta
     2202         ,input true
     2203         ) .
     2204       run diasize_change-width in this-procedure
     2205         (input v-col-delta
     2206         ,input true
     2207         ) .
     2208     end.
     2209   end procedure.
     2210   procedure diasize_maximize :
     2211     define input  parameter p-action as logical   no-undo .
     2212     do
     2213     on error undo, return error return-value
     2214     :
     2215       if p-action = ?
     2216       then do:
     2217         if v-diasize-need-maximize = true
     2218         then do:
     2219           assign
     2220             p-action = true
     2221           .
     2222         end.
     2223         else do:
     2224           assign
     2225             p-action = false
     2226           .
     2227         end.
     2228       end.
     2229       if p-action = true
     2230       then do:
     2231         run diasize_change-height in this-procedure
     2232           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2233               - frame Dialog-Frame :height-chars
     2234           ,input true
     2235           ) .
     2236         run diasize_change-width in this-procedure
     2237           (input session :width-chars
     2238               - frame Dialog-Frame :width-chars
     2239           ,input true
     2240           ) .
     2241         assign
     2242           v-diasize-need-maximize = false
     2243         .
     2244       end.
     2245       else do:
     2246         run diasize_change-width in this-procedure
     2247           (input v-diasize-orig-frame-width
     2248               - frame Dialog-Frame :width-chars
     2249           ,input true
     2250           ) .
     2251         run diasize_change-height in this-procedure
     2252           (input v-diasize-orig-frame-height
     2253               - frame Dialog-Frame :height-chars
     2254           ,input true
     2255           ) .
     2256         assign
     2257           v-diasize-need-maximize = true
     2258         .
     2259       end.
     2260     end.
     2261   end procedure.
     2262   procedure diasize_restore-orig-size :
     2263     do
     2264     on error undo, return error return-value
     2265     :
     2266       assign
     2267         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2268         v-diasize-current-frame-height = frame Dialog-Frame :height
     2269       .
     2270       run diasize_set-height in this-procedure
     2271         (input  v-diasize-orig-frame-height
     2272         ,input  true
     2273         ) .
     2274       run diasize_set-width in this-procedure
     2275         (input  v-diasize-orig-frame-width
     2276         ,input  true
     2277         ) .
     2278     end.
     2279   end procedure.
     2280   procedure diasize_restore-current-size :
     2281     do
     2282     on error undo, return error return-value
     2283     :
     2284       run diasize_set-height in this-procedure
     2285         (input  v-diasize-current-frame-height
     2286         ,input  true
     2287         ) .
     2288       run diasize_set-width in this-procedure
     2289         (input  v-diasize-current-frame-width
     2290         ,input  true
     2291         ) .
     2292     end.
     2293   end procedure.
     2294   procedure diasize_set-browse-handle :
     2295     define input  parameter p-browse-handle as handle   no-undo .
     2296     define buffer buf_temp-browse-handle for temp-browse-handle .
     2297     do
     2298     on error undo, return error return-value
     2299     :
     2300       assign
     2301         v-diasize-browse-handle = p-browse-handle
     2302       .
     2303       for each buf_temp-browse-handle
     2304       on error undo, return error return-value
     2305       :
     2306         delete buf_temp-browse-handle .
     2307       end.
     2308     end.
     2309   end procedure.
     2310   procedure diasize_add_browse :
     2311     define input  parameter p-browse-type   as character no-undo .
     2312     define input  parameter p-browse-handle as handle    no-undo .
     2313     define buffer buf_temp-browse-handle for temp-browse-handle .
     2314     do
     2315     on error undo, return error return-value
     2316     :
     2317       assign
     2318         v-diasize-browse-number = v-diasize-browse-number + 1
     2319       .
     2320       create buf_temp-browse-handle .
     2321       assign
     2322         buf_temp-browse-handle.browse-type   = p-browse-type
     2323         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2324         buf_temp-browse-handle.browse-handle = p-browse-handle
     2325       .
     2326     end.
     2327   end procedure.
     2328   procedure diasize_init :
     2329     define variable v-default-value    as logical   no-undo .
     2330     define variable v-restore-saved    as logical   no-undo .
     2331     define variable v-resize-value-str as character no-undo .
     2332     do
     2333     on error undo, return error return-value
     2334     :
     2335       do with frame Dialog-Frame
     2336       :
     2337         assign
     2338           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2339           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2340           v-diasize-browse-handle     = browse br-margins-list :handle
     2341         .
     2342         create button v-diasize-resize-button
     2343         assign
     2344           parent        = frame Dialog-Frame :first-child
     2345           label         = "s"
     2346           height-pixels = 16
     2347           width-pixels  = 16
     2348           visible       = true
     2349           sensitive     = true
     2350           movable       = true
     2351           triggers:
     2352             on end-move persistent run diasize_end-move in this-procedure .
     2353           end triggers.
     2354         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2355         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2356         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2357         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2358         assign
     2359           v-diasize-wndmax = false
     2360         .
     2361         if connected("ub") = true
     2362         then do:
     2363           define variable v-cntxt-db-num        as integer   no-undo .
     2364           define variable v-cntxt-userid        as character no-undo .
     2365           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2366                                             , OUTPUT v-cntxt-userid
     2367                                             ) .
     2368           run gbl/wndpar_r.p
     2369             (input  v-cntxt-db-num
     2370             ,input  v-cntxt-userid
     2371             ,input  'wndmax':U
     2372             ,output v-diasize-wndmax
     2373             ,output v-default-value
     2374             ) .
     2375         end.
     2376         assign
     2377           v-diasize-wndstore = false
     2378         .
     2379         if connected("ub") = true
     2380         then do:
     2381           run gbl/wndpar_r.p
     2382             (input  v-cntxt-db-num
     2383             ,input  v-cntxt-userid
     2384             ,input  'wndstore':U
     2385             ,output v-diasize-wndstore
     2386             ,output v-default-value
     2387             ) .
     2388         end.
     2389         assign
     2390           v-diasize-proc-name = entry(1, program-name(2), '.')
     2391         .
     2392         if v-diasize-wndstore = true
     2393         then do:
     2394           assign
     2395             v-restore-saved = false
     2396           .
     2397           if connected("ub") = true
     2398           then do:
     2399             run gbl/wndsizer.p
     2400               (input  v-cntxt-db-num
     2401               ,input  v-cntxt-userid
     2402               ,input  v-diasize-proc-name
     2403               ,input  'height':u
     2404               ,output v-resize-value-str
     2405               ) .
     2406             if v-resize-value-str <> '':U
     2407             then do:
     2408               run diasize_change-height in this-procedure
     2409                 (input  integer(v-resize-value-str)
     2410                 ,input  true
     2411                 ) .
     2412               assign
     2413                 v-restore-saved = true
     2414               .
     2415             end.
     2416           end.
     2417           if connected("ub") = true
     2418           then do:
     2419             run gbl/wndsizer.p
     2420               (input  v-cntxt-db-num
     2421               ,input  v-cntxt-userid
     2422               ,input  v-diasize-proc-name
     2423               ,input  'width':u
     2424               ,output v-resize-value-str
     2425               ) .
     2426             if v-resize-value-str <> '':U
     2427             then do:
     2428               run diasize_change-width in this-procedure
     2429                 (input  integer(v-resize-value-str)
     2430                 ,input  true
     2431                 ) .
     2432               assign
     2433                 v-restore-saved = true
     2434               .
     2435             end.
     2436           end.
     2437           if v-restore-saved <> true
     2438           then do:
     2439             if v-diasize-wndmax = true
     2440             then do:
     2441               run diasize_maximize in this-procedure
     2442                 (input  true
     2443                 ) .
     2444             end.
     2445           end.
     2446         end.
     2447         else do:
     2448           if v-diasize-wndmax = true
     2449           then do:
     2450             run diasize_maximize in this-procedure
     2451               (input  true
     2452               ) .
     2453           end.
     2454         end.
     2455       end.
     2456     end.
     2457   end procedure.
     2458   procedure diasize_need-full-display :
     2459     define output parameter p-need-full-display as logical   no-undo .
     2460     do
     2461     on error undo, return error return-value
     2462     :
     2463       assign
     2464         p-need-full-display = v-diasize-need-full-display
     2465       .
     2466       assign
     2467         v-diasize-need-full-display = false
     2468       .
     2469     end.
     2470   end procedure.
     2471   procedure get-context :
     2472      define output parameter p-db-num as integer          no-undo.
     2473      define output parameter p-user-id as character        no-undo.
     2474      define variable v-login               as character    no-undo.
     2475      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2476      define buffer buf_user-login  for ub.user-login .
     2477      do
     2478      on error undo, return error
     2479      :
     2480            FIND FIRST buf_sys-ctrl no-lock.
     2481            ASSIGN
     2482               v-login = USERID("ub")
     2483               p-db-num = buf_sys-ctrl.db-num
     2484            .
     2485            FIND FIRST buf_user-login
     2486                 WHERE buf_user-login.db-num = p-db-num
     2487                   AND buf_user-login.user-login = v-login
     2488                 no-lock
     2489                 no-error
     2490                 .
     2491            IF AVAILABLE buf_user-login
     2492            THEN DO:
     2493               assign
     2494                  p-user-id = buf_user-login.user-id
     2495               .
     2496            END.
     2497      end.
     2498   end procedure.
     2499       run diasize_init in this-procedure .
     2500   MAIN-BLOCK:
     2501   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2502      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2503   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2504     run mainmenu_getcntxt in parparentproc
     2505       (output v-cntxt-db-num
     2506       ,output v-cntxt-userid
     2507       ,output v-cntxt-level
     2508       ,output v-cntxt-host-code-obj
     2509       ,output v-cntxt-obj-type
     2510       ,output v-cntxt-obj-code
     2511       ,output v-cntxt-db-num-obj
     2512       ,output v-cntxt-is-admin
     2513       ) .
     2514       run get-host-name in this-procedure ( input v-cntxt-host-code-obj, output v-host-name ) no-error.
     2515       if error-status :error
     2516       then do:
     2517           message
     2518             vss-workfile vss-revision vss-description
     2519             skip "Не удалось найти наименование фирмы."
     2520             skip "Код фирмы: " v-cntxt-host-code-obj
     2521             skip return-value
     2522             skip trim(error-status :get-message(1))
     2523                  trim(error-status :get-message(2))
     2524                  trim(error-status :get-message(3))
     2525                  trim(error-status :get-message(4))
     2526                  trim(error-status :get-message(5))
     2527           view-as alert-box error.
     2528           undo, return error .
     2529       end.
     2530       RUN UI-on.
     2531       WAIT-FOR GO OF FRAME Dialog-Frame.
     2532   END.
     2533   RUN disable_UI.
     2534   PROCEDURE delete-attr-by-br-line :
     2535   do
     2536   on error undo, return error
     2537   :
     2538   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     2539   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr.
     2540   find first  buf_gds-grp-obj  exclusive-lock
     2541        where buf_gds-grp-obj.node-code = p-node-code
     2542          and buf_gds-grp-obj.host-code = temp_attr.host-code
     2543          and buf_gds-grp-obj.obj-type = temp_attr.obj-type
     2544          and buf_gds-grp-obj.obj-code = temp_attr.obj-code
     2545   no-error .
     2546   if not available temp_attr
     2547   then do:
     2548       message
     2549           skip "Не найдена запись, соответствующая значению, выбранному в списке"
     2550           skip "наценок для группы товаров."
     2551       view-as alert-box error.
     2552       undo, return error .
     2553   end.
     2554   else do:
     2555       delete buf_gds-grp-obj.
     2556       for each buf_gds-grp-obj-attr where buf_gds-grp-obj-attr.node-code = p-node-code and buf_gds-grp-obj-attr.host-code = temp_attr.host-code and
     2557                                   buf_gds-grp-obj-attr.obj-code = temp_attr.obj-code and buf_gds-grp-obj-attr.obj-type = temp_attr.obj-type exclusive-lock.
     2558         delete buf_gds-grp-obj-attr .
     2559       end.
     2560   end.
     2561   end.
     2562   END PROCEDURE.
     2563   PROCEDURE disable_UI :
     2564     HIDE FRAME Dialog-Frame.
     2565   END PROCEDURE.
     2566   PROCEDURE enable_UI :
     2567     DISPLAY ed-grp-name fi-range-increase fi-range-rmethod fi-increase-pc
     2568             S-round-method F-base fi-range-margin fi-marg-min fi-marg-max
     2569             fi-range-income-cli fi-cli-type fi-cli-code
     2570         WITH FRAME Dialog-Frame.
     2571    ENABLE B-exit RECT-3 RECT-2 RECT-1 RECT-4 B-Help S-round-method B-add B-chg B-rev
     2572            B-del br-margins-list
     2573         WITH FRAME Dialog-Frame.
     2574     VIEW FRAME Dialog-Frame.
     2575     OPEN QUERY br-margins-list FOR EACH temp_attr no-lock by temp_attr.host-code by temp_attr.obj-type by temp_attr.obj-code.
     2576   END PROCEDURE.
     2577   PROCEDURE fill-temp-attr :
     2578   do
     2579   on error undo, return error
     2580   :
     2581   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     2582   define variable v-min     as decimal           no-undo.
     2583   define variable v-max     as decimal           no-undo.
     2584   define variable v-incr    like ub.gds-grp.increase-pc  no-undo.
     2585   define variable v-round-method as character no-undo.
     2586   define variable v-base         as decimal no-undo .
     2587   define variable v-type as character no-undo .
     2588       for each temp_attr
     2589       :
     2590           delete temp_attr.
     2591       end.
     2592       for each buf_gds-grp-obj no-lock
     2593          where buf_gds-grp-obj.node-code = p-node-code
     2594       :
     2595           create temp_attr.
     2596           assign
     2597           v-min = buf_gds-grp-obj.min-increase
     2598           v-max = buf_gds-grp-obj.max-increase
     2599           v-incr = buf_gds-grp-obj.increase-pc
     2600           v-round-method = buf_gds-grp-obj.round-method
     2601           v-base = buf_gds-grp-obj.round-coef
     2602           .
     2603           if  buf_gds-grp-obj.host-code  = 0
     2604           and buf_gds-grp-obj.obj-type   = ""
     2605           and buf_gds-grp-obj.obj-code   = 0
     2606           then do:
     2607               assign
     2608                   temp_attr.name = "Глобально"
     2609               .
     2610           end.
     2611           else do:
     2612               if  buf_gds-grp-obj.obj-type   = ""
     2613               and buf_gds-grp-obj.obj-code   = 0
     2614               then do:
     2615                   run get-host-name in this-procedure ( input buf_gds-grp-obj.host-code
     2616                                                       , output temp_attr.name
     2617                   ).
     2618                   assign
     2619                       temp_attr.name = fill( " ", 2 ) + temp_attr.name
     2620                   .
     2621               end.
     2622               else do:
     2623                   assign
     2624                       temp_attr.name = fill( " ", 2 * 2 )
     2625                                       + buf_gds-grp-obj.obj-type
     2626                                       + string( buf_gds-grp-obj.obj-code )
     2627                   .
     2628               end.
     2629           end.
     2630           assign
     2631               temp_attr.host-code = buf_gds-grp-obj.host-code
     2632               temp_attr.obj-type  = buf_gds-grp-obj.obj-type
     2633               temp_attr.obj-code  = buf_gds-grp-obj.obj-code
     2634               temp_attr.cli-type  = buf_gds-grp-obj.cli-type
     2635               temp_attr.cli-code  = buf_gds-grp-obj.cli-code
     2636               temp_attr.min-marg  = (if v-min <> ? then string(v-min, "->>>>9.99") else "":U)
     2637               temp_attr.max-marg  = (if v-max <> ? then string(v-max, "->>>>9.99") else "":U)
     2638               temp_attr.increase-pc  = (if v-incr <> ? then string(v-incr, "->>>>9.99") else "":U)
     2639               temp_attr.round-method = v-round-method + chr(32) +
     2640                                      (if lookup(v-round-method, 'Произвольно,Вверх,Коэффициент,9-99окончание':U) > 0
     2641                                       then string(v-base, "->>>>9.99")
     2642                                       else "":U
     2643                                      )
     2644           .
     2645       run ggoattr-value (
     2646          input   p-node-code
     2647         ,input   buf_gds-grp-obj.host-code
     2648         ,input   buf_gds-grp-obj.obj-type
     2649         ,input   buf_gds-grp-obj.obj-code
     2650         ,input   'NotCorrOP':U
     2651         ,output  temp_attr.notcorr
     2652         ,output  v-type ) no-error .
     2653       run ggoattr-value (
     2654          input   p-node-code
     2655         ,input   buf_gds-grp-obj.host-code
     2656         ,input   buf_gds-grp-obj.obj-type
     2657         ,input   buf_gds-grp-obj.obj-code
     2658         ,input   'alc-min-price':U
     2659         ,output  temp_attr.alc-min-price
     2660         ,output  v-type ) no-error .
     2661       run ggoattr-value (
     2662          input   p-node-code
     2663         ,input   buf_gds-grp-obj.host-code
     2664         ,input   buf_gds-grp-obj.obj-type
     2665         ,input   buf_gds-grp-obj.obj-code
     2666         ,input   'marg-pr-paraf':U
     2667         ,output  temp_attr.marg-pr-paraf
     2668         ,output  v-type ) no-error .
     2669       run ggoattr-value (
     2670          input   p-node-code
     2671         ,input   buf_gds-grp-obj.host-code
     2672         ,input   buf_gds-grp-obj.obj-type
     2673         ,input   buf_gds-grp-obj.obj-code
     2674         ,input   'level-dis':U
     2675         ,output  temp_attr.level-dis-attr
     2676         ,output  v-type ) no-error .
     2677       end.
     2678   end.
     2679   END PROCEDURE.
     2680   PROCEDURE get-host-name :
     2681   do
     2682   on error undo, return error
     2683   :
     2684   define input parameter p-host-code  as integer      no-undo.
     2685   define output parameter p-host-name as character    no-undo.
     2686   define buffer buf_clients   for ub.clients.
     2687       find first buf_clients no-lock
     2688            where buf_clients.obj-type = 'орг':U
     2689              and buf_clients.obj-code = p-host-code
     2690       no-error.
     2691       if not available buf_clients
     2692       then do:
     2693           message
     2694             vss-workfile vss-revision vss-description
     2695             skip "Не удалось найти текущую фирму"
     2696             skip return-value
     2697             skip trim(error-status :get-message(1))
     2698                  trim(error-status :get-message(2))
     2699                  trim(error-status :get-message(3))
     2700                  trim(error-status :get-message(4))
     2701                  trim(error-status :get-message(5))
     2702           view-as alert-box error.
     2703           undo, return error .
     2704       end.
     2705       else do:
     2706           assign
     2707               p-host-name = buf_clients.obj-name
     2708           .
     2709       end.
     2710   end.
     2711   END PROCEDURE.
     2712   PROCEDURE proc-b-add :
     2713   define variable rr as recid no-undo.
     2714   if add-option = "":U then do:
     2715       run gbl/pop-up.p (B-add:handle in frame Dialog-Frame, no) no-error.
     2716       if error-status:error then do:
     2717           assign add-option = "":U.
     2718           return no-apply.
     2719        end.
     2720   end.
     2721    run ref/pr-mchg.w ( input parparentproc, 'ДОБАВЛЕНИЕ':U, p-node-code, add-option, v-cntxt-host-code-obj ,v-cntxt-obj-type, v-cntxt-obj-code, output rr).
     2722   assign
     2723   add-option = "":U.
     2724   run ui-on in this-procedure .
     2725   END PROCEDURE.
     2726   PROCEDURE proc-b-chg :
     2727   define variable rr as recid no-undo.
     2728   define variable v-option as character no-undo.
     2729   define buffer buf_gds-grp-obj for ub.gds-grp-obj.
     2730   if not available temp_attr then return error.
     2731   find first  buf_gds-grp-obj  exclusive-lock
     2732        where buf_gds-grp-obj.node-code = p-node-code
     2733          and buf_gds-grp-obj.host-code = temp_attr.host-code
     2734          and buf_gds-grp-obj.obj-type = temp_attr.obj-type
     2735          and buf_gds-grp-obj.obj-code = temp_attr.obj-code
     2736   no-error .
     2737   if not available temp_attr
     2738   then do:
     2739       message
     2740           skip "Не найдена запись, соответствующая значению, выбранному в списке"
     2741           skip "наценок для группы товаров."
     2742       view-as alert-box error.
     2743       undo, return error .
     2744   end.
     2745   assign
     2746   v-option = (if buf_gds-grp-obj.obj-type = "":U and
     2747                       buf_gds-grp-obj.obj-code = 0 and
     2748                       buf_gds-grp-obj.host-code = 0
     2749                       then "global":U
     2750                       else (if buf_gds-grp-obj.obj-type = "":U and
     2751                                buf_gds-grp-obj.obj-code = 0
     2752                                then 'фирма':U
     2753                                else 'объект':U)
     2754                       )
     2755    .
     2756    run ref/pr-mchg.w ( input parparentproc, 'ИЗМЕНЕНИЕ':U, p-node-code, v-option, buf_gds-grp-obj.host-code , buf_gds-grp-obj.obj-type, buf_gds-grp-obj.obj-code, output rr).
     2757   assign
     2758   add-option = "":U.
     2759   run ui-on in this-procedure .
     2760   END PROCEDURE.
     2761   PROCEDURE proc-b-rev :
     2762   define variable rr as recid no-undo.
     2763   define variable v-option as character no-undo.
     2764   define buffer buf_gds-grp-obj for ub.gds-grp-obj.
     2765   if not available temp_attr then return error.
     2766   find first  buf_gds-grp-obj  exclusive-lock
     2767        where buf_gds-grp-obj.node-code = p-node-code
     2768          and buf_gds-grp-obj.host-code = temp_attr.host-code
     2769          and buf_gds-grp-obj.obj-type = temp_attr.obj-type
     2770          and buf_gds-grp-obj.obj-code = temp_attr.obj-code
     2771   no-error .
     2772   if not available temp_attr
     2773   then do:
     2774       message
     2775           skip "Не найдена запись, соответствующая значению, выбранному в списке"
     2776           skip "наценок для группы товаров."
     2777       view-as alert-box error.
     2778       undo, return error .
     2779   end.
     2780   assign
     2781   v-option = (if buf_gds-grp-obj.obj-type = "":U and
     2782                       buf_gds-grp-obj.obj-code = 0 and
     2783                       buf_gds-grp-obj.host-code = 0
     2784                       then "global":U
     2785                       else (if buf_gds-grp-obj.obj-type = "":U and
     2786                                buf_gds-grp-obj.obj-code = 0
     2787                                then 'фирма':U
     2788                                else 'объект':U)
     2789                       )
     2790    .
     2791    run ref/pr-mchg.w ( input parparentproc, 'ПРОСМОТР':U, p-node-code, v-option, buf_gds-grp-obj.host-code , buf_gds-grp-obj.obj-type, buf_gds-grp-obj.obj-code, output rr).
     2792   assign
     2793   add-option = "":U.
     2794   run ui-on in this-procedure .
     2795   END PROCEDURE.
     2796   PROCEDURE UI-on :
     2797   do
     2798   on error undo, return error
     2799   :
     2800   define buffer buf_gds-grp       for ub.gds-grp.
     2801   define variable v-margins-range     as integer  no-undo.
     2802   define variable v-margins-exists    as logical  no-undo.
     2803   define variable v-increase-range     as integer  no-undo.
     2804   define variable v-increase-exists    as logical  no-undo.
     2805   define variable v-min-marg          as decimal  no-undo.
     2806   define variable v-max-marg          as decimal  no-undo.
     2807   define variable v-increase-pc          as decimal  no-undo.
     2808   define variable v-round-method as character  no-undo.
     2809   define variable v-base              as decimal no-undo .
     2810   define variable v-rmethod-range     as integer  no-undo.
     2811   define variable v-rmethod-exists    as logical  no-undo.
     2812   define variable v-cli-type as character no-undo .
     2813   define variable v-cli-code as integer no-undo .
     2814   define variable v-income-cli-range     as integer  no-undo.
     2815   define variable v-income-cli-exists    as logical  no-undo.
     2816   ASSIGN
     2817   B-add:MENU-MOUSE in frame Dialog-Frame =  1.
     2818   s-round-method:list-items = '9-окончание,9-99окончание,Без-дробных,Произвольно,Вверх,Коэффициент,Отключено':U.
     2819   DISPLAY ed-grp-name fi-marg-min fi-marg-max fi-increase-pc S-round-method
     2820       WITH FRAME Dialog-Frame.
     2821   ENABLE B-exit B-Help br-margins-list
     2822        B-add B-chg B-rev B-del
     2823       WITH FRAME Dialog-Frame.
     2824   VIEW FRAME Dialog-Frame.
     2825       run fill-temp-attr in this-procedure .
     2826       find first buf_gds-grp no-lock
     2827            where buf_gds-grp.node-code = p-node-code
     2828       no-error.
     2829       run grplib-get-full-name in this-procedure (input p-node-code, output v-full-grp-name) no-error.
     2830       if error-status :error
     2831       then do:
     2832           message
     2833               vss-workfile vss-revision vss-description
     2834               skip "Ошибка вычисления полного имени группы"
     2835               skip return-value
     2836               skip trim(error-status :get-message(1))
     2837                      trim(error-status :get-message(2))
     2838                      trim(error-status :get-message(3))
     2839                      trim(error-status :get-message(4))
     2840                      trim(error-status :get-message(5))
     2841           view-as alert-box error.
     2842           assign
     2843               ed-grp-name :screen-value = ""
     2844           .
     2845       end.
     2846       else do:
     2847           assign
     2848               ed-grp-name :screen-value = v-full-grp-name
     2849           .
     2850       end.
     2851       run grp-obj-margin-value in this-procedure (
     2852                                 input p-node-code
     2853                               , input v-cntxt-obj-type
     2854                               , input v-cntxt-obj-code
     2855                               , output v-min-marg
     2856                               , output v-max-marg
     2857                               , output v-increase-pc
     2858                               , output v-round-method
     2859                               , output v-base
     2860                               , output v-margins-range
     2861                               , output v-margins-exists
     2862                               , output v-increase-range
     2863                               , output v-increase-exists
     2864                               , output v-rmethod-range
     2865                               , output v-rmethod-exists
     2866       ) no-error .
     2867       run grp-obj-income-cli-value in this-procedure (
     2868                                 input p-node-code
     2869                               , input v-cntxt-obj-type
     2870                               , input v-cntxt-obj-code
     2871                               , output v-cli-type
     2872                               , output v-cli-code
     2873                               , output v-income-cli-range
     2874                               , output v-income-cli-exists
     2875       ) no-error .
     2876       if v-income-cli-exists then do:
     2877           assign
     2878           fi-range-income-cli:visible = yes
     2879           fi-range-income-cli:screen-value = if v-income-cli-range = 1
     2880                                               then "Глобальные значения"
     2881                                               else (if v-income-cli-range = 2
     2882                                                        then "Значения по фирме " + v-host-name
     2883                                                        else  "Значения по объекту " + v-cntxt-obj-type + string( v-cntxt-obj-code )
     2884                                                        )
     2885           fi-cli-type:screen-value = string( v-cli-type )
     2886           fi-cli-code:screen-value = string( v-cli-code )
     2887          .
     2888       end.
     2889       else do:
     2890           assign
     2891           fi-range-income-cli:visible = no
     2892           fi-cli-type:visible = no
     2893           fi-cli-code:visible = no
     2894           .
     2895       end.
     2896       if v-margins-exists then do:
     2897           assign
     2898           fi-range-margin:visible = yes
     2899           fi-range-margin:screen-value = if v-margins-range = 1
     2900                                               then "Глобальные значения"
     2901                                               else (if v-margins-range = 2
     2902                                                        then "Значения по фирме " + v-host-name
     2903                                                        else  "Значения по объекту " + v-cntxt-obj-type + string( v-cntxt-obj-code )
     2904                                                        )
     2905           fi-marg-min:screen-value = string( v-min-marg )
     2906           fi-marg-max:screen-value = string( v-max-marg )
     2907          .
     2908       end.
     2909       else do:
     2910           assign
     2911           fi-range-margin:visible = no
     2912           fi-marg-min:visible = no
     2913           fi-marg-max:visible = no
     2914           .
     2915       end.
     2916       if v-increase-exists then do:
     2917           assign
     2918           fi-range-increase:visible = yes
     2919           fi-range-increase:screen-value = if v-increase-range = 1
     2920                                               then "Глобальные значения"
     2921                                               else (if v-increase-range = 2
     2922                                                        then "Значения по фирме " + v-host-name
     2923                                                        else  "Значения по объекту " + v-cntxt-obj-type + string( v-cntxt-obj-code )
     2924                                                        )
     2925           fi-increase-pc:screen-value = string( v-increase-pc )
     2926          .
     2927       end.
     2928       else do:
     2929           assign
     2930           fi-range-increase:visible = no
     2931           fi-increase-pc:visible = no
     2932           .
     2933       end.
     2934       if v-rmethod-exists then do:
     2935           assign
     2936           fi-range-rmethod:visible = yes
     2937           fi-range-rmethod:screen-value = if v-rmethod-range = 1
     2938                                               then "Глобальные значения"
     2939                                               else (if v-increase-range = 2
     2940                                                        then "Значения по фирме " + v-host-name
     2941                                                        else  "Значения по объекту " + v-cntxt-obj-type + string( v-cntxt-obj-code )
     2942                                                        )
     2943           s-round-method:screen-value = string( v-round-method )
     2944           f-base = v-base
     2945          .
     2946          apply "VALUE-CHANGED" to s-round-method.
     2947       end.
     2948       else do:
     2949           assign
     2950           fi-range-increase:visible = no
     2951           fi-increase-pc:visible = no
     2952           .
     2953       end.
     2954   if (g#db-num <> 0) then do:
     2955   hide    b-add       in frame Dialog-Frame
     2956           b-chg      in frame Dialog-Frame
     2957           b-del       in frame Dialog-Frame
     2958        .
     2959   end.
     2960   OPEN QUERY br-margins-list FOR EACH temp_attr no-lock by temp_attr.host-code by temp_attr.obj-type by temp_attr.obj-code.
     2961   end.
     2962   END PROCEDURE.
