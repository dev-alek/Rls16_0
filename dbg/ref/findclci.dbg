      433   ON CHOOSE OF B-base-rate IN FRAME Dialog-Frame
      434   DO:
      435   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      436   if lookup(self :type
      437            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      438            ) = 0
      439   then do:
      440     message
      441       "$Workfile$"
      442       "Указанному интерфейсному элементу фокус не может быть передан" skip
      443       "Интерфейсный элемент" self :name  skip
      444       "Тип" self :type  skip
      445       "Процедура" this-procedure :file-name skip
      446       view-as alert-box .
      447   end.
      448   else do:
      449     apply "entry":u to self  .
      450     if focus :handle <> self :handle  then do:
      451       return no-apply .
      452     end.
      453   end.
      454     RUN proc-calc-base-rate IN this-procedure.
      455   END.
