      955   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      956   procedure minbtn-set :
      957       do
      958           on error undo, return error return-value
      959           :
      960           define variable ii              as integer       no-undo .
      961           define variable fh              as widget-handle no-undo .
      962           define variable hh              as widget-handle no-undo .
      963           define variable v-h             as handle        extent 4 no-undo .
      964           define variable v-name-button   as character     no-undo .
      965           define variable v-help-old-x    as decimal       no-undo .
      966           define variable v-help-old-y    as decimal       no-undo .
      967           define variable v-help-old-size as decimal       no-undo .
      968           define variable v-frame-width   as decimal       no-undo .
      969           define variable jj              as integer       no-undo .
      970           do
      971               on error undo, return error
      972               :
      973               assign
      974                   v-frame-width = frame Dialog-Frame:width - 0.3
      975                   fh            = frame Dialog-Frame:first-child
      976                   hh            = fh:first-child
      977                   ii            = 1
      978                   .
      979               do while valid-handle(hh):
      980                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      981                   do:
      982                       case lc(hh:name) :
      983                           when "b-help" then
      984                               do:
      985                                   hh:load-image-up("cmp/b-help.bmp":u) .
      986                                   hh:load-image-down("cmp/b-help.bmp":u) .
      987                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      988                                   hh:TOOLTIP = "Помощь" .
      989                                   v-help-old-x = hh:column .
      990                                   v-help-old-y = hh:row    .
      991                                   v-help-old-size = hh:width .
      992                                   hh:width-chars = 2.5 .
      993                               end.
      994                           when "b-print" then
      995                               do:
      996                                   hh:load-image("cmp/b-print.bmp":u) .
      997                                   hh:TOOLTIP = "Печать" .
      998                                   v-h[ii] = hh:handle .
      999                                   ii = ii + 1 .
     1000                                   hh:width-chars = 3 .
     1001                               end.
     1002                           when "b-history" or
     1003                           when "b-hist" then
     1004                               do:
     1005                                   hh:load-image("cmp/b-hist.bmp":u) .
     1006                                   hh:TOOLTIP = "История" .
     1007                                   v-h[ii] = hh:handle .
     1008                                   ii = ii + 1 .
     1009                                   hh:width-chars = 3 .
     1010                               end.
     1011                           when "b-sch" then
     1012                               do:
     1013                                   hh:load-image("cmp/b-sch.bmp":u) .
     1014                                   hh:TOOLTIP = "Установка Фильтра" .
     1015                                   v-h[ii] = hh:handle .
     1016                                   ii = ii + 1 .
     1017                                   hh:width-chars = 3 .
     1018                               end.
     1019                           when "b-hist-user" then
     1020                               do:
     1021                                   hh:load-image("cmp/b-hist.bmp":u) .
     1022                                   hh:TOOLTIP = "История пользователя" .
     1023                                   ii = ii + 1 .
     1024                               end.
     1025                       end case.
     1026                   end.
     1027                   hh = hh:next-sibling.
     1028               end.
     1029               b-help:column = v-frame-width - b-help:width-chars.
     1030               jj = 0.
     1031               repeat ii = 4 to 1 by -1 :
     1032                   if valid-handle (v-h[ii] ) then
     1033                   do:
     1034                       jj  = jj + 1 .
     1035                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1036                       v-h[ii]:row    = v-help-old-y .
     1037                   end.
     1038               end.
     1039           end.
     1040       end.
     1041   end procedure.
     1042   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1043   ON TAB ANYWHERE
     1044   DO:
     1045   define variable ii as integer no-undo .
     1046   define variable fh as widget-handle no-undo .
     1047   define variable hh as widget-handle no-undo .
     1048   define variable v-next-widget-name as character no-undo .
     1049   if v-tab-order <> '' then do:
     1050     if self:type = "TOGGLE-BOX" then
     1051     self:BGCOLOR = ?.
     1052     assign
     1053     ii = lookup(self:name, v-tab-order).
     1054     assign
     1055     ii = ii + 1
     1056     v-next-widget-name = entry(ii, v-tab-order)
     1057     no-error .
     1058     if error-status:error then do:
     1059       assign
     1060       ii = 1
     1061       v-next-widget-name = entry( ii, v-tab-order)
     1062       .
     1063     end.
     1064     assign
     1065     fh = frame Dialog-Frame:first-child
     1066     hh = fh:first-child
     1067     .
     1068     do while valid-handle(hh):
     1069       if hh:name = v-next-widget-name then do:
     1070         if hh:sensitive  = yes
     1071         AND hh:visible = yes then do:
     1072           if hh:type = "TOGGLE-BOX":U then do:
     1073             assign
     1074             hh:BGcolor = 1
     1075             .
     1076           end.
     1077           APPLY "ENTRY" to hh.
     1078           return no-apply.
     1079         end.
     1080         else do:
     1081           APPLY "TAB" to hh.
     1082           return no-apply.
     1083         end.
     1084       end.
     1085       hh = hh:next-sibling.
     1086     end.
     1087   end.
     1088   END.
     1089   ON BACK-TAB ANYWHERE
     1090   DO:
     1091   define variable ii as integer no-undo .
     1092   define variable fh as widget-handle no-undo .
     1093   define variable hh as widget-handle no-undo .
     1094   define variable v-next-widget-name as character no-undo .
     1095   if v-tab-order <> '' then do:
     1096     assign
     1097     ii = lookup(self:name, v-tab-order).
     1098     .
     1099     assign
     1100     ii = (if ii = 1
     1101           then  num-entries(v-tab-order)
     1102           else ii - 1
     1103           )
     1104     v-next-widget-name = entry(ii, v-tab-order)
     1105     .
     1106     assign
     1107     fh = frame Dialog-Frame:first-child
     1108     hh = fh:first-child
     1109     .
     1110     do while valid-handle(hh):
     1111       if hh:name = v-next-widget-name then do:
     1112         if hh:sensitive  = yes
     1113         AND hh:visible = yes then do:
     1114           if hh:type = "TOGGLE-BOX":U then do:
     1115             assign
     1116             hh:BGcolor = 1
     1117             .
     1118           end.
     1119           APPLY "ENTRY" to hh.
     1120           return no-apply.
     1121         end.
     1122         else do:
     1123         APPLY "BACK-TAB" to hh.
     1124         return no-apply.
     1125         end.
     1126       end.
     1127       hh = hh:next-sibling.
     1128     end.
     1129     end.
     1130   END.
     1131   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1132   ON RETURN ANYWHERE
     1133   DO:
     1134   define variable ii as integer no-undo .
     1135   define variable fh as widget-handle no-undo .
     1136   define variable hh as widget-handle no-undo .
     1137   define variable v-next-widget-name as character no-undo .
     1138     if v-tab-order <> '' then do:
     1139       assign
     1140       ii = lookup(self:name, v-tab-order).
     1141       if ii = num-entries(v-tab-order) then do:
     1142           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     1143           return no-apply.
     1144       end.
     1145       if self:type <> "BUTTON" and
     1146         self:type <> "EDITOR"  then do:
     1147         run proc-move-forward in this-procedure .
     1148         return no-apply.
     1149       end.
     1150       if self:type = "BUTTON" then do:
     1151         APPLY "CHOOSE" to self.
     1152       end.
     1153       if self:type = "TOGGLE-BOX" then
     1154       self:BGCOLOR = ?.
     1155       assign
     1156       ii = ii + 1
     1157       v-next-widget-name = entry(ii, v-tab-order)
     1158       no-error .
     1159       if error-status:error then do:
     1160         assign
     1161         ii = 1
     1162         v-next-widget-name = entry( ii, v-tab-order)
     1163         .
     1164       end.
     1165       assign
     1166       fh = frame Dialog-Frame:first-child
     1167       hh = fh:first-child
     1168       .
     1169       do while valid-handle(hh):
     1170         if hh:name = v-next-widget-name then do:
     1171           if hh:sensitive  = yes
     1172           AND hh:visible = yes then do:
     1173             if hh:type = "TOGGLE-BOX":U then do:
     1174               assign
     1175               hh:BGcolor = 1
     1176               .
     1177             end.
     1178             APPLY "ENTRY" to hh.
     1179             return no-apply.
     1180           end.
     1181           else do:
     1182             APPLY "TAB" to hh.
     1183             return no-apply.
     1184           end.
     1185         end.
     1186         hh = hh:next-sibling.
     1187       end.
     1188     end.
     1189   END.
     1190   procedure proc-move-forward :
     1191   define variable ii as integer no-undo .
     1192   define variable fh as widget-handle no-undo .
     1193   define variable hh as widget-handle no-undo .
     1194   define variable v-next-widget-name as character no-undo .
     1195   do
     1196   on error undo, return error
     1197   :
     1198     if v-tab-order <> '' then do:
     1199       if self:type = "TOGGLE-BOX" then
     1200       self:BGCOLOR = ?.
     1201       assign
     1202       ii = lookup(self:name, v-tab-order).
     1203       assign
     1204       ii = ii + 1
     1205       v-next-widget-name = entry(ii, v-tab-order)
     1206       no-error .
     1207       if error-status:error then do:
     1208         assign
     1209         ii = 1
     1210         v-next-widget-name = entry( ii, v-tab-order)
     1211         .
     1212       end.
     1213       assign
     1214       fh = frame Dialog-Frame:first-child
     1215       hh = fh:first-child
     1216       .
     1217       do while valid-handle(hh):
     1218         if hh:name = v-next-widget-name then do:
     1219           if hh:sensitive  = yes
     1220           AND hh:visible = yes then do:
     1221             if hh:type = "TOGGLE-BOX":U then do:
     1222               assign
     1223               hh:BGcolor = 1
     1224               .
     1225             end.
     1226             APPLY "ENTRY" to hh.
     1227             return.
     1228           end.
     1229           else do:
     1230             assign
     1231             ii = ii + 1
     1232             v-next-widget-name = entry(ii, v-tab-order)
     1233             no-error .
     1234             if error-status:error then do:
     1235               assign
     1236               ii = 1
     1237               v-next-widget-name = entry( ii, v-tab-order)
     1238               .
     1239             end.
     1240           end.
     1241         end.
     1242         hh = hh:next-sibling.
     1243       end.
     1244     end.
     1245   end.
     1246   end procedure.
     1247   MAIN-BLOCK:
     1248   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1249      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1250     FIND FIRST buf_currency NO-LOCK WHERE
     1251               buf_Currency.curr-code = p-curr-code  NO-ERROR.
     1252     IF NOT AVAILABLE buf_currency THEN DO:
     1253         MESSAGE
     1254       "Неверное значение параметра p-curr-code:" p-curr-code
     1255       vss-workfile vss-revision vss-description skip
     1256       view-as alert-box .
     1257     END.
     1258     FIND FIRST buf_base-currency NO-LOCK WHERE
     1259               buf_base-currency.curr-code = p-base-code NO-ERROR.
     1260     IF NOT available buf_base-currency THEN DO:
     1261         MESSAGE
     1262       "Неверное значение параметра p-base-code:" p-base-code
     1263       vss-workfile vss-revision vss-description skip
     1264       view-as alert-box .
     1265       RETURN ERROR.
     1266     END.
     1267     FIND FIRST buf_contract-currency NO-LOCK WHERE
     1268               buf_contract-currency.curr-code = p-contract-curr NO-ERROR.
     1269     IF NOT AVAILABLE buf_contract-currency THEN DO:
     1270         MESSAGE
     1271           "Неверное значение параметра p-contract-curr:" p-contract-curr
     1272           vss-workfile vss-revision vss-description skip
     1273           view-as alert-box .
     1274       RETURN ERROR.
     1275     END.
     1276     RUN Myenable.
     1277     WAIT-FOR GO OF FRAME Dialog-Frame.
     1278   END.
     1279   RUN disable_UI.
     1280   PROCEDURE disable_UI :
     1281     HIDE FRAME Dialog-Frame.
     1282   END PROCEDURE.
     1283   PROCEDURE enable_UI :
     1284     DISPLAY doc-date-0 curr-code-0 F-curr-abbr-0 sum-doc-0 exch-rate-0
     1285             exch-scale-0 sum-rubl-0 base-code-0 F-base-abbr-0 contract-curr-code-0
     1286             F-contract-curr-abbr-0 sum-base-0 sum-contr-0 base-rate-0 base-scale-0
     1287             contract-rate-0 contract-scale-0 curr-code-1 F-curr-abbr-1 sum-doc-1
     1288             exch-rate-1 exch-scale-1 sum-rubl-1 base-code-1 F-base-abbr-1
     1289             contract-curr-code-1 F-contract-curr-abbr-1 sum-base-1 sum-contr-1
     1290             base-rate-1 base-scale-1 contract-rate-1 contract-scale-1
     1291         WITH FRAME Dialog-Frame.
     1292     ENABLE B-exit b-quit B-Help BUTTON-1 sum-doc-1 B-doc-sum exch-rate-1
     1293            exch-scale-1 B-get-rate B-rate sum-rubl-1 B-rubl-sum sum-base-1
     1294            B-base-sum sum-contr-1 B-contract-sum base-rate-1 base-scale-1
     1295            B-get-base B-base-rate contract-rate-1 contract-scale-1 B-get-contract
     1296            B-contract-rate RECT-1 RECT-2
     1297         WITH FRAME Dialog-Frame.
     1298     VIEW FRAME Dialog-Frame.
     1299   END PROCEDURE.
     1300   PROCEDURE MyEnable :
     1301   assign
     1302   b-rubl-sum:MENU-MOUSE IN FRAME Dialog-Frame = 1
     1303   curr-code-0  = p-curr-code
     1304   F-curr-abbr-0 = buf_currency.curr-abbr
     1305   curr-code-1  = p-curr-code
     1306   F-curr-abbr-1  =  buf_currency.curr-abbr
     1307   doc-date-0   =  p-doc-date
     1308   sum-doc-0  =  p-sum-doc
     1309   exch-rate-0  = p-exch-rate
     1310   exch-scale-0  =  p-exch-scale
     1311   sum-rubl-0 = p-sum-rubl
     1312   base-code-0  = p-base-code
     1313   F-base-abbr-0 =  buf_base-currency.curr-abbr
     1314   contract-curr-code-0 = p-contract-curr
     1315   F-contract-curr-abbr-0  = buf_contract-currency.curr-abbr
     1316   sum-base-0  = p-sum-base
     1317   sum-contr-0  = p-sum-contr
     1318   base-rate-0  = p-base-rate
     1319   base-scale-0 = p-base-scale
     1320   contract-rate-0  = p-contract-rate
     1321   contract-scale-0  = p-contract-scale
     1322   sum-doc-1 = p-sum-doc
     1323   exch-rate-1  = p-exch-rate
     1324   exch-scale-1  = p-exch-scale
     1325   sum-rubl-1 = p-sum-rubl
     1326   base-code-1  = p-base-code
     1327   F-base-abbr-1 = buf_base-currency.curr-abbr
     1328   contract-curr-code-1  = p-contract-curr
     1329   F-contract-curr-abbr-1 = buf_contract-currency.curr-abbr
     1330   sum-base-1 = p-sum-base
     1331   sum-contr-1 = p-sum-contr
     1332   base-rate-1  = p-base-rate
     1333   base-scale-1  = p-base-scale
     1334   contract-rate-1 = p-contract-rate
     1335   contract-scale-1 = p-contract-scale
     1336   sum-doc-1:tooltip                         =    string(p-sum-doc)
     1337   exch-rate-1:tooltip                       =    string(p-exch-rate)
     1338   exch-scale-1:tooltip                      =    string(p-exch-scale)
     1339   sum-rubl-1:tooltip                        =    string(p-sum-rubl)
     1340   base-code-1:tooltip                       =    string(p-base-code)
     1341   F-base-abbr-1:tooltip                     =    string(buf_base-currency.curr-abbr)
     1342   contract-curr-code-1:tooltip              =    string(p-contract-curr)
     1343   F-contract-curr-abbr-1:tooltip            =    string(buf_contract-currency.curr-abbr)
     1344   sum-base-1:tooltip                        =    string(p-sum-base)
     1345   sum-contr-1:tooltip                       =    string(p-sum-contr)
     1346   base-rate-1:tooltip                       =    string(p-base-rate)
     1347   base-scale-1:tooltip                      =    string(p-base-scale)
     1348   contract-rate-1:tooltip                   =    string(p-contract-rate)
     1349   contract-scale-1:tooltip                  =    string(p-contract-scale)
     1350   sum-rubl-0 :label                         =    "Рубли"
     1351   sum-rubl-1 :label                         =    "Рубли"
     1352   .
     1353   if p-curr-code <> 0
     1354   then do:
     1355     assign
     1356     v-rubf = yes
     1357     v-exchf = yes
     1358     .
     1359   end.
     1360   if
     1361   p-base-code <> 0
     1362   then do:
     1363     assign
     1364     v-basef = yes
     1365     v-baseratef = yes
     1366     v-rubf = yes
     1367     v-exchf = yes
     1368     .
     1369   end.
     1370   if
     1371     (p-contract-curr <> 0
     1372       )
     1373     then do:
     1374     assign
     1375     v-contractf = yes
     1376     v-contractratef = yes
     1377     v-rubf = yes
     1378     v-exchf = yes
     1379     .
     1380   end.
     1381   ASSIGN
     1382   MENU-ITEM m_base:SENSITIVE IN MENU menu-b-rubl-sum = v-basef OR v-baseratef
     1383   MENU-ITEM m_contr:SENSITIVE IN MENU menu-b-rubl-sum = v-contractf OR v-contractratef
     1384   .
     1385   IF NOT (MENU-ITEM m_base:SENSITIVE IN MENU menu-b-rubl-sum OR MENU-ITEM m_contr:SENSITIVE IN MENU menu-b-rubl-sum)
     1386   THEN
     1387   b-rubl-sum:POPUP-MENU = ?
     1388   .
     1389   ASSIGN
     1390   v-tab-order = "sum-doc-1,B-doc-sum," +
     1391                 (IF v-exchf THEN "exch-rate-1,exch-scale-1,B-get-rate,B-rate,":U ELSE "":U) +
     1392                 (IF v-rubf THEN "sum-rubl-1,b-rubl-sum,":U ELSE "":U) +
     1393                 (IF v-basef THEN "sum-base-1,b-base-sum,":U ELSE "":U) +
     1394                 (IF v-basef THEN "base-rate-1,base-scale-1,B-get-base,B-base-rate,":U ELSE "":U) +
     1395                 (IF v-contractf THEN "sum-contr-1,b-contract-sum,":U ELSE "":U) +
     1396                 (IF v-contractratef THEN "contract-rate-1,contract-scale-1,b-get-contract,b-contract-rate,":U ELSE "":U) +
     1397                 "b-exit,b-quit,b-help":U
     1398                 .
     1399    DISPLAY doc-date-0 curr-code-0 F-curr-abbr-0 sum-doc-0 exch-rate-0
     1400             exch-scale-0 sum-rubl-0 base-code-0 F-base-abbr-0 contract-curr-code-0
     1401             F-contract-curr-abbr-0 sum-base-0 sum-contr-0 base-rate-0 base-scale-0
     1402             contract-rate-0 contract-scale-0 curr-code-1 F-curr-abbr-1 sum-doc-1
     1403             exch-rate-1 exch-scale-1 sum-rubl-1 base-code-1 F-base-abbr-1
     1404             contract-curr-code-1 F-contract-curr-abbr-1 sum-base-1 sum-contr-1
     1405             base-rate-1 base-scale-1 contract-rate-1 contract-scale-1
     1406         WITH FRAME Dialog-Frame .
     1407   ENABLE
     1408   B-exit b-quit B-Help
     1409   sum-doc-1 B-doc-sum
     1410   exch-rate-1 WHEN v-exchf
     1411   exch-scale-1 WHEN v-exchf
     1412   B-get-rate WHEN v-exchf
     1413   B-rate WHEN v-exchf
     1414   sum-rubl-1  WHEN v-rubf
     1415   B-rubl-sum WHEN v-rubf
     1416   sum-base-1 WHEN v-basef
     1417   base-rate-1 WHEN v-baseratef
     1418   base-scale-1 WHEN v-baseratef
     1419   B-base-sum WHEN v-basef
     1420   B-get-base  WHEN v-baseratef
     1421   B-base-rate WHEN v-baseratef
     1422   sum-contr-1 WHEN v-contractf
     1423   B-contract-sum WHEN v-contractf
     1424   contract-rate-1 WHEN v-contractratef = yes
     1425   contract-scale-1 WHEN v-contractratef = yes
     1426   B-get-contract WHEN v-contractratef = yes
     1427   B-contract-rate WHEN v-contractratef = yes
     1428   RECT-1 RECT-2
     1429   button-1
     1430   WITH FRAME Dialog-Frame .
     1431   VIEW FRAME Dialog-Frame .
     1432   hide
     1433   button-1 in frame Dialog-Frame .
     1434   APPLY "ENTRY" TO sum-doc-1 IN FRAME Dialog-Frame.
     1435   END PROCEDURE.
     1436   PROCEDURE proc-calc-base-rate :
     1437   ASSIGN
     1438   v-base-rate-c = "sum-rubl/sum-base":U
     1439   v-sum-base-c = "":U
     1440   v-sum-rubl-c = "":U
     1441   base-scale-1 = 1
     1442   base-rate-1 = sum-rubl-1 / sum-base-1
     1443   base-rate-1:tooltip in frame Dialog-Frame  = string(base-rate-1)
     1444   v-sum-base-m = 0
     1445   .
     1446   DISPLAY
     1447   base-rate-1
     1448   base-scale-1
     1449   WITH FRAME Dialog-Frame.
     1450   END PROCEDURE.
     1451   PROCEDURE proc-calc-base-sum :
     1452   ASSIGN
     1453   v-sum-base-c = "sum-rubl/base-rate":U
     1454   v-base-rate-c = "":U
     1455   v-sum-rubl-c = "":U
     1456   sum-base-1 = sum-rubl-1 / ( base-rate-1 / base-scale-1 )
     1457   sum-base-1:tooltip in frame Dialog-Frame = string(sum-base-1)
     1458   v-base-rate-m = 0
     1459   .
     1460   DISPLAY
     1461   SUM-base-1
     1462   WITH FRAME Dialog-Frame.
     1463   END PROCEDURE.
     1464   PROCEDURE proc-calc-contract-rate :
     1465   ASSIGN
     1466   v-contract-rate-c = "sum-rubl/sum-contr":U
     1467   v-sum-rubl-c = "":U
     1468   v-sum-contr-c = "":U
     1469   contract-scale-1 = 1
     1470   contract-rate-1 = sum-rubl-1 / sum-contr-1
     1471   contract-rate-1:tooltip  in frame Dialog-Frame = string(contract-rate-1)
     1472   v-sum-contr-m = 0
     1473   .
     1474   DISPLAY
     1475   contract-rate-1
     1476   contract-scale-1
     1477   WITH FRAME Dialog-Frame.
     1478   END PROCEDURE.
     1479   PROCEDURE proc-calc-contract-sum :
     1480   ASSIGN
     1481   v-sum-contr-c = "sum-rubl/contract-rate":U
     1482   v-sum-rubl-c = "":U
     1483   v-contract-rate-c = "":U
     1484   sum-contr-1 = sum-rubl-1 / ( contract-rate-1 / contract-scale-1 )
     1485   sum-contr-1:tooltip in frame Dialog-Frame  = string(sum-contr-1)
     1486   v-contract-rate-m = 0
     1487   .
     1488   DISPLAY
     1489   SUM-contr-1
     1490   WITH FRAME Dialog-Frame.
     1491   END PROCEDURE.
     1492   PROCEDURE proc-calc-doc-sum :
     1493   ASSIGN
     1494   v-sum-doc-c = "sum-rubl/exch-rate":U
     1495   v-sum-rubl-c = "":U
     1496   v-exch-rate-c = "":U
     1497   sum-doc-1 = sum-rubl-1 / ( exch-rate-1 / exch-scale-1 )
     1498   sum-doc-1:tooltip in frame Dialog-Frame  = string(sum-doc-1)
     1499   v-exch-rate-m = 0
     1500   .
     1501   DISPLAY
     1502   SUM-doc-1
     1503   WITH FRAME Dialog-Frame.
     1504   RUN proc-not-enable-base IN THIS-PROCEDURE.
     1505   RUN proc-not-enable-contr IN THIS-PROCEDURE.
     1506   END PROCEDURE.
     1507   PROCEDURE proc-calc-exch-rate :
     1508   ASSIGN
     1509   v-exch-rate-c = "sum-rubl/sum-doc":U
     1510   v-sum-rubl-c = "":U
     1511   v-sum-doc-c = "":U
     1512   exch-scale-1 = 1
     1513   exch-rate-1 = sum-rubl-1 / sum-doc-1
     1514   exch-rate-1:tooltip in frame Dialog-Frame  = string(exch-rate-1)
     1515   v-sum-doc-m = 0
     1516   .
     1517   DISPLAY
     1518   exch-rate-1
     1519   exch-scale-1
     1520   WITH FRAME Dialog-Frame.
     1521   RUN proc-not-enable-base IN THIS-PROCEDURE.
     1522   RUN proc-not-enable-contr IN THIS-PROCEDURE.
     1523   END PROCEDURE.
     1524   PROCEDURE proc-calc-rubl-sum :
     1525   DEFINE INPUT PARAMETER p-calc-option AS CHARACTER NO-UNDO.
     1526   if round(base-rate-1           , 4) <> input frame Dialog-Frame base-rate-1             then apply "leave" to base-rate-1            in frame Dialog-Frame. if       base-scale-1               <> input frame Dialog-Frame base-scale-1            then apply "leave" to base-scale-1           in frame Dialog-Frame. if round(sum-base-1          , 3) <> input frame Dialog-Frame sum-base-1            then apply "leave" to sum-base-1           in frame Dialog-Frame. if round(sum-rubl-1          , 3) <> input frame Dialog-Frame sum-rubl-1            then apply "leave" to sum-rubl-1           in frame Dialog-Frame. if round(exch-rate-1           , 4) <> input frame Dialog-Frame exch-rate-1             then apply "leave" to exch-rate-1            in frame Dialog-Frame. if       exch-scale-1               <> input frame Dialog-Frame exch-scale-1            then apply "leave" to exch-scale-1           in frame Dialog-Frame. if round(sum-doc-1          , 3) <> input frame Dialog-Frame sum-doc-1            then apply "leave" to sum-doc-1           in frame Dialog-Frame. if round(contract-rate-1           , 4) <> input frame Dialog-Frame contract-rate-1             then apply "leave" to contract-rate-1            in frame Dialog-Frame. if       contract-scale-1               <> input frame Dialog-Frame contract-scale-1            then apply "leave" to contract-scale-1           in frame Dialog-Frame. if round(sum-contr-1          , 3) <> input frame Dialog-Frame sum-contr-1            then apply "leave" to sum-contr-1           in frame Dialog-Frame.
     1527   CASE p-calc-option:
     1528     WHEN "doc":U  THEN DO:
     1529       ASSIGN
     1530       v-sum-rubl-c = "sum-doc*exch-rate":U
     1531       v-exch-rate-c = "":U
     1532       v-sum-doc-c = "":U
     1533       v-base-rate-c = "!":U
     1534       v-sum-base-c = "!":U
     1535       v-contract-rate-c = "!":U
     1536       v-sum-contr-c = "!":U
     1537       sum-rubl-1 = sum-doc-1 * ( exch-rate-1 / exch-scale-1 )
     1538       v-exch-rate-m = 0
     1539       v-sum-doc-m = 0
     1540       .
     1541       RUN proc-not-enable-base IN THIS-PROCEDURE.
     1542       RUN proc-not-enable-contr IN THIS-PROCEDURE.
     1543     END.
     1544     WHEN "base":U  THEN DO:
     1545       ASSIGN
     1546       v-sum-rubl-c = "sum-base*base-rate":U
     1547       v-base-rate-c = "":U
     1548       v-sum-base-c = "":U
     1549       v-exch-rate-c = "!":U
     1550       v-sum-doc-c = "!":U
     1551       v-contract-rate-c = "!":U
     1552       v-sum-contr-c = "!":U
     1553       sum-rubl-1 = sum-base-1 * ( base-rate-1 / base-scale-1 )
     1554       v-base-rate-m = 0
     1555       v-sum-base-m = 0
     1556       .
     1557        RUN proc-not-enable-contr IN THIS-PROCEDURE.
     1558     END.
     1559     WHEN "contract":U THEN DO:
     1560         ASSIGN
     1561         v-sum-rubl-c = "sum-contr*contract-rate":U
     1562         v-contract-rate-c = "":U
     1563         v-sum-contr-c = "":U
     1564         v-base-rate-c = "!":U
     1565         v-sum-base-c = "!":U
     1566         v-exch-rate-c = "!":U
     1567         v-sum-doc-c = "!":U
     1568         sum-rubl-1 = sum-contr-1 * ( contract-rate-1 / contract-scale-1 )
     1569         v-contract-rate-m = 0
     1570         v-sum-contr-m = 0
     1571         .
     1572         RUN proc-not-enable-base IN THIS-PROCEDURE.
     1573     END.
     1574   END CASE.
     1575   assign
     1576   sum-rubl-1:tooltip  in frame Dialog-Frame = string(sum-rubl-1)
     1577   .
     1578   DISPLAY
     1579   sum-rubl-1
     1580   WITH FRAME Dialog-Frame.
     1581   END PROCEDURE.
     1582   PROCEDURE proc-not-enable-base :
     1583       IF NOT v-basef OR NOT v-baseratef THEN  DO:
     1584           IF p-base-code = 0 THEN DO:
     1585               ASSIGN
     1586               sum-base-1 = SUM-rubl-1
     1587               base-rate-1 = 1
     1588               base-scale-1 = 1
     1589               .
     1590           END.
     1591           ELSE IF p-base-code = p-curr-code THEN DO:
     1592               ASSIGN
     1593               sum-base-1 = sum-doc-1
     1594               base-rate-1 = exch-rate-1
     1595               base-scale-1 = exch-scale-1
     1596               .
     1597           END.
     1598       END.
     1599   assign
     1600   sum-base-1:tooltip in frame Dialog-Frame = string(sum-base-1)
     1601   base-rate-1:tooltip in frame Dialog-Frame  = string(base-rate-1)
     1602   base-scale-1:tooltip in frame Dialog-Frame  = string(base-scale-1)
     1603   .
     1604   DISPLAY
     1605   sum-base-1
     1606   base-rate-1
     1607   base-scale-1
     1608   WITH FRAME Dialog-Frame.
     1609   END PROCEDURE.
     1610   PROCEDURE proc-not-enable-contr :
     1611   IF NOT v-contractf OR NOT v-contractratef THEN DO:
     1612          IF p-contract-curr = 0  THEN DO:
     1613               ASSIGN
     1614               sum-contr-1 = SUM-rubl-1
     1615               contract-rate-1 = 1
     1616               contract-scale-1 = 1
     1617               .
     1618          END.
     1619          ELSE DO:
     1620              IF p-contract-curr = p-curr-code THEN DO:
     1621                   ASSIGN
     1622                   sum-contr-1 = SUM-doc-1
     1623                   contract-rate-1 = exch-rate-1
     1624                   contract-scale-1 = exch-scale-1
     1625                   .
     1626              END.
     1627              IF p-contract-curr = p-base-code THEN DO:
     1628                    ASSIGN
     1629                    sum-contr-1 = SUM-base-1
     1630                    contract-rate-1 = base-rate-1
     1631                    contract-scale-1 = base-scale-1
     1632                    .
     1633               END.
     1634          END.
     1635       END.
     1636   assign
     1637   sum-contr-1:tooltip in frame Dialog-Frame  = string(sum-contr-1)
     1638   contract-rate-1:tooltip in frame Dialog-Frame  = string(contract-rate-1)
     1639   contract-scale-1:tooltip in frame Dialog-Frame  = string(contract-scale-1)
     1640   .
     1641   DISPLAY
     1642   sum-contr-1
     1643   contract-rate-1
     1644   contract-scale-1
     1645   WITH FRAME Dialog-Frame.
     1646   END PROCEDURE.
     1647   PROCEDURE proc-not-enable-rubl :
     1648     IF NOT v-rubf OR NOT v-exchf THEN DO:
     1649         ASSIGN
     1650         exch-rate-1 = 1
     1651         exch-scale-1 = 1
     1652         sum-rubl-1 = sum-doc-1
     1653         .
     1654     END.
     1655     assign
     1656     sum-rubl-1:tooltip in frame Dialog-Frame  = string(sum-rubl-1)
     1657     exch-rate-1:tooltip in frame Dialog-Frame  = string(exch-rate-1)
     1658     exch-scale-1:tooltip in frame Dialog-Frame  = string(exch-scale-1)
     1659     .
     1660     DISPLAY
     1661     exch-rate-1
     1662     exch-scale-1
     1663     sum-rubl-1
     1664     WITH FRAME Dialog-Frame.
     1665   END PROCEDURE.
     1666   PROCEDURE proc-save :
     1667   DEFINE VARIABLE v-rate-correct AS CHARACTER NO-UNDO.
     1668   if round(base-rate-1           , 4) <> input frame Dialog-Frame base-rate-1             then apply "leave" to base-rate-1            in frame Dialog-Frame. if       base-scale-1               <> input frame Dialog-Frame base-scale-1            then apply "leave" to base-scale-1           in frame Dialog-Frame. if round(sum-base-1          , 3) <> input frame Dialog-Frame sum-base-1            then apply "leave" to sum-base-1           in frame Dialog-Frame. if round(sum-rubl-1          , 3) <> input frame Dialog-Frame sum-rubl-1            then apply "leave" to sum-rubl-1           in frame Dialog-Frame. if round(exch-rate-1           , 4) <> input frame Dialog-Frame exch-rate-1             then apply "leave" to exch-rate-1            in frame Dialog-Frame. if       exch-scale-1               <> input frame Dialog-Frame exch-scale-1            then apply "leave" to exch-scale-1           in frame Dialog-Frame. if round(sum-doc-1          , 3) <> input frame Dialog-Frame sum-doc-1            then apply "leave" to sum-doc-1           in frame Dialog-Frame. if round(contract-rate-1           , 4) <> input frame Dialog-Frame contract-rate-1             then apply "leave" to contract-rate-1            in frame Dialog-Frame. if       contract-scale-1               <> input frame Dialog-Frame contract-scale-1            then apply "leave" to contract-scale-1           in frame Dialog-Frame. if round(sum-contr-1          , 3) <> input frame Dialog-Frame sum-contr-1            then apply "leave" to sum-contr-1           in frame Dialog-Frame.
     1669   RUN rate-correct IN THIS-PROCEDURE (OUTPUT v-rate-correct) NO-ERROR.
     1670   if error-status:error then do:
     1671     message "Ошибка при вызове процедуры rate-correct." skip
     1672             return-value
     1673             error-status:get-message(1)
     1674             error-status:get-message(2)
     1675     view-as alert-box error.
     1676     return no-apply.
     1677   end.
     1678   CASE v-rate-correct:
     1679       WHEN "sum-doc":U then do:
     1680         message
     1681         "Неверная сумма платежа или сумма платежа не согласована с другими суммами"
     1682         view-as alert-box .
     1683          apply "entry" to sum-doc-1.
     1684          return error .
     1685       end.
     1686       WHEN "sum-rubl":U then do:
     1687         message
     1688         "Неверная сумма в рублях или сумма в рублях не согласована с другими суммами"
     1689         view-as alert-box .
     1690          apply "entry" to sum-rubl-1.
     1691          return error .
     1692       end.
     1693       when "sum-base":U then do:
     1694         message
     1695         "Неверная сумма в баз вал или сумма в баз. вал. не согласована с суммой в рублях и курсом баз.вал."
     1696         view-as alert-box .
     1697          apply "entry" to sum-base-1.
     1698          return error .
     1699       end.
     1700       when "sum-contr":U then do:
     1701         message
     1702         "Неверная сумма в вал дог-ра или сумма в вал. дог-ра не согласована с суммой в рублях и курсом вал.дог-ра"
     1703         view-as alert-box .
     1704          apply "entry" to sum-contr-1.
     1705          return error .
     1706       end.
     1707       WHEN "exch-rate" THEN DO:
     1708           message
     1709             "Курс валюты платежа не согласован с суммой платежа и суммой в национальной валюте" skip
     1710             "Сумма в валюте платежа: " sum-doc-1 skip
     1711             "Сумма в рублях: " sum-rubl-1 skip
     1712             "Курс валюты платежа: " exch-rate-1 skip
     1713             "Шкала валюты платежа: " exch-scale-1
     1714           view-as alert-box information.
     1715         if b-rate:sensitive IN FRAME Dialog-Frame then do:
     1716           apply "entry" to b-rate.
     1717         end.
     1718         else do:
     1719           apply "entry" to sum-doc-1.
     1720         end.
     1721           return ERROR.
     1722       END.
     1723       WHEN "base-rate":U THEN DO:
     1724              message
     1725             "Курс базовой валюты не согласован с суммой в базовой валюте и суммой в национальной валюте" skip
     1726             "Сумма в базовой валюте: " sum-base-1 skip
     1727             "Сумма в рублях: " sum-rubl-1 skip
     1728             "Курс базовой валюты: " base-rate-1 skip
     1729             "Шкала базовой валюты: " base-scale-1
     1730     view-as alert-box information.
     1731         if b-base-rate:sensitive then do:
     1732           apply "entry" to b-base-rate.
     1733         end.
     1734         else do:
     1735           apply "entry" to sum-doc-1.
     1736         end.
     1737           RETURN error.
     1738       END.
     1739       WHEN "contract-rate":U THEN DO:
     1740           message
     1741             "Курс валюты договора не согласован с суммой платежа и суммой в национальной валюте" skip
     1742             "Сумма в валюте договора: " sum-contr-1 skip
     1743             "Сумма в рублях: " sum-rubl-1 skip
     1744             "Курс валюты договора: " contract-rate-1 skip
     1745             "Шкала валюты договора: " contract-scale-1
     1746     view-as alert-box information.
     1747         if b-contract-rate:sensitive then do:
     1748           apply "entry" to b-contract-rate.
     1749         end.
     1750         else do:
     1751           apply "entry" to sum-contr-1.
     1752         end.
     1753           return error.
     1754     END.
     1755   END CASE.
     1756   ASSIGN
     1757   p-sum-rubl = sum-rubl-1
     1758   p-sum-doc = sum-doc-1
     1759   p-exch-rate = exch-rate-1
     1760   p-exch-scale = exch-scale-1
     1761   p-sum-base = sum-base-1
     1762   p-base-rate = base-rate-1
     1763   p-base-scale = base-scale-1
     1764   p-sum-contr = sum-contr-1
     1765   p-contract-rate = contract-rate-1
     1766   p-contract-scale = contract-scale-1
     1767   .
     1768   END PROCEDURE.
     1769   PROCEDURE rate-correct :
     1770   DEFINE OUTPUT PARAMETER p-rate-correct AS CHARACTER NO-UNDO.
     1771   if sum-doc-0 = sum-doc-1
     1772   AND sum-rubl-0 = sum-rubl-1
     1773   and exch-rate-0 = exch-rate-1
     1774   and exch-scale-0 = exch-scale-1
     1775   AND sum-base-0 = sum-base-1
     1776   and base-rate-0 = base-rate-1
     1777   and base-scale-0 = base-scale-1
     1778   AND sum-contr-0 = sum-contr-1
     1779   and contract-rate-0 = contract-rate-1
     1780   and contract-scale-0 = contract-scale-1 then do:
     1781     p-rate-correct = "":U.
     1782     return .
     1783   end.
     1784   if (sum-doc-1 = 0
     1785   and not (sum-rubl-1 = 0 and sum-base-1 = 0 and sum-contr-1 = 0))
     1786   or sum-doc-1 < 0
     1787   or sum-doc-1 = ?
     1788   then do:
     1789     p-rate-correct = "sum-doc":U.
     1790     return.
     1791   end.
     1792   if sum-rubl-1 = ?
     1793   or sum-rubl-1 < 0
     1794   or ( sum-doc-1 <> 0  and sum-rubl-1 = 0)
     1795   then do:
     1796      p-rate-correct = "sum-rubl":U.
     1797      return.
     1798   end.
     1799   if sum-base-1 < 0
     1800   or ( sum-doc-1 <> 0  and sum-base-1 = 0)
     1801   or sum-base-1 = ?
     1802   then do:
     1803      p-rate-correct = "sum-base":U.
     1804      return.
     1805   end.
     1806   if sum-contr-1 < 0
     1807   or ( sum-doc-1 <> 0  and sum-contr-1 = 0)
     1808   or sum-contr-1 = ?
     1809   then do:
     1810      p-rate-correct = "sum-contr":U.
     1811      return.
     1812   end.
     1813   IF EXCH-RATE-1 = ? or exch-scale-1 = ?
     1814   or EXCH-RATE-1 = 0 or exch-scale-1 = 0
     1815   then do:
     1816       p-rate-correct = "exch-rate":U.
     1817       RETURN.
     1818   END.
     1819   IF v-exch-rate-c <> "":U AND v-exch-rate-c <> "0":U
     1820   AND abs((exch-rate-1 / exch-scale-1) - (sum-rubl-1 / sum-doc-1)) >  0.0001 THEN DO:
     1821       p-rate-correct = "exch-rate":U.
     1822       RETURN.
     1823   END.
     1824   IF v-sum-doc-c <> "":U AND v-sum-doc-c <> "0":U
     1825   AND abs(sum-doc-1 - (sum-rubl-1 / ( exch-rate-1 / exch-scale-1 ))) >  0.01 THEN DO:
     1826       p-rate-correct = "sum-doc":U.
     1827       RETURN.
     1828   END.
     1829   IF base-rate-1 = ? or  base-scale-1 = ?
     1830   or base-rate-1 = 0 or  base-scale-1 = 0
     1831   then do:
     1832     p-rate-correct = "base-rate":U.
     1833     RETURN.
     1834   end.
     1835   IF  v-baseratef
     1836   and v-base-rate-c <> "":U AND v-base-rate-c <> "0":U
     1837   AND abs((base-rate-1 / base-scale-1) - (sum-rubl-1 / sum-base-1)) > 0.0001 THEN DO:
     1838       p-rate-correct = "base-rate":U.
     1839       RETURN.
     1840   END.
     1841   IF v-basef
     1842   and v-sum-base-c <> "":U AND v-sum-base-c <> "0":U
     1843   AND abs(sum-base-1 - (sum-rubl-1 / ( base-rate-1 / base-scale-1 ))) >  0.0001 THEN DO:
     1844     p-rate-correct = "sum-base":U.
     1845     RETURN.
     1846   END.
     1847   IF contract-rate-1 = ? or  contract-scale-1 = ?
     1848   or contract-rate-1 = 0 or  contract-scale-1 = 0
     1849   then do:
     1850       p-rate-correct = "contract-rate":U.
     1851       RETURN.
     1852   end.
     1853   IF v-contractratef
     1854   and v-contract-rate-c <> "":U AND v-contract-rate-c <> "0":U
     1855   AND abs((contract-rate-1 / contract-scale-1) - (sum-rubl-1 / sum-contr-1)) > 0.0001 THEN DO:
     1856       p-rate-correct = "contract-rate":U.
     1857       RETURN.
     1858   END.
     1859   IF v-contractf
     1860   and v-sum-contr-c <> "":U AND v-sum-contr-c <> "0":U
     1861   AND abs(sum-contr-1 - (sum-rubl-1 / ( contract-rate-1 / contract-scale-1 ))) >  0.0001 THEN DO:
     1862     p-rate-correct = "sum-contract":U.
     1863     RETURN.
     1864   END.
     1865   if v-rubf then do:
     1866   CASE v-sum-rubl-c:
     1867     when "sum-doc*exch-rate":U then do:
     1868       if ABS(sum-rubl-1 - sum-doc-1 * (exch-rate-1 / exch-scale-1)) > 0.0001 then do:
     1869         p-rate-correct = "sum-rubl":U.
     1870         RETURN.
     1871       end.
     1872     end.
     1873     when "sum-contr*contract-rate":U then do:
     1874       if ABS(sum-rubl-1 - sum-contr-1 * (contract-rate-1 /  contract-scale-1)) > 0.0001 then do:
     1875         p-rate-correct = "sum-rubl":U.
     1876         RETURN.
     1877       end.
     1878     end.
     1879     when "sum-base*base-rate":U then do:
     1880       if ABS(sum-rubl-1 - sum-base-1 * (base-rate-1 /  base-scale-1)) > 0.0001 then do:
     1881         p-rate-correct = "sum-rubl":U.
     1882         RETURN.
     1883       end.
     1884     end.
     1885     when "":U then do:
     1886     end.
     1887     when "!":U then do:
     1888       p-rate-correct = "sum-rubl":U.
     1889       RETURN.
     1890     end.
     1891   END CASE.
     1892   end.
     1893   END PROCEDURE.
