        1   DEFINE BUFFER buf_base-currency FOR ub.currency.
        2   DEFINE BUFFER buf_contract-currency FOR ub.currency.
        3   DEFINE BUFFER buf_currency FOR ub.currency.
        4   DEFINE INPUT        PARAMETER parParentProc    AS WIDGET-HANDLE               NO-UNDO.
        5   define input        parameter p-mode           as character                   no-undo.
        6   DEFINE INPUT        PARAMETER p-doc-date       LIKE ub.fin-doc.doc-date       NO-UNDO.
        7   DEFINE INPUT        PARAMETER p-curr-code      LIKE ub.fin-doc.curr-code      NO-UNDO.
        8   DEFINE INPUT        PARAMETER p-base-code      LIKE ub.sysconf.base-code      NO-UNDO.
        9   DEFINE INPUT        PARAMETER p-contract-curr  LIKE ub.fin-doc.contract-curr  NO-UNDO.
       10   DEFINE INPUT-OUTPUT PARAMETER p-sum-doc        LIKE ub.fin-doc.sum-doc        NO-UNDO.
       11   DEFINE INPUT-OUTPUT PARAMETER p-exch-rate      LIKE ub.fin-doc.exch-rate      NO-UNDO.
       12   DEFINE INPUT-OUTPUT PARAMETER p-exch-scale     LIKE ub.fin-doc.exch-scale     NO-UNDO.
       13   DEFINE INPUT-OUTPUT PARAMETER p-sum-rubl       LIKE ub.fin-doc.sum-rubl       NO-UNDO.
       14   DEFINE INPUT-OUTPUT PARAMETER p-sum-base       LIKE ub.fin-doc.sum-base       NO-UNDO.
       15   DEFINE INPUT-OUTPUT PARAMETER p-base-rate      LIKE ub.fin-doc.base-rate      NO-UNDO.
       16   DEFINE INPUT-OUTPUT PARAMETER p-base-scale     LIKE ub.fin-doc.base-scale     NO-UNDO.
       17   DEFINE INPUT-OUTPUT PARAMETER p-sum-contr      LIKE ub.fin-doc.sum-contr      NO-UNDO.
       18   DEFINE INPUT-OUTPUT PARAMETER p-contract-rate  LIKE ub.fin-doc.contract-rate  NO-UNDO.
       19   DEFINE INPUT-OUTPUT PARAMETER p-contract-scale LIKE ub.fin-doc.contract-scale NO-UNDO.
       20   def var vss-revision    as character no-undo init "$Revision$":U .
       21   def var vss-author      as character no-undo init "$Author$":U .
       22   def var vss-date        as character no-undo init "$Date$":U .
       23   def var vss-workfile    as character no-undo init "$Workfile$":U .
       24   def var vss-archive     as character no-undo init "$Archive$":U .
       25   def var vss-description as character no-undo init "Карточка редактирования сумм и курсов платежного документа".
       26   procedure vss-get-info :
       27     define output parameter p-vss-revision    like vss-revision    no-undo .
       28     define output parameter p-vss-author      like vss-author      no-undo .
       29     define output parameter p-vss-date        like vss-date        no-undo .
       30     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       31     define output parameter p-vss-archive     like vss-archive     no-undo .
       32     define output parameter p-vss-description like vss-description no-undo .
       33     assign
       34       p-vss-revision    = vss-revision
       35       p-vss-author      = vss-author
       36       p-vss-date        = vss-date
       37       p-vss-workfile    = vss-workfile
       38       p-vss-archive     = vss-archive
       39       p-vss-description = vss-description
       40     .
       41   end procedure.
       42   procedure vss-get-parameters :
       43     define output parameter p-vss-parameters as character no-undo .
       44   end procedure.
       45   define new global shared variable g#vssrevis-logger as handle    no-undo .
       46   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       47   define variable v-vssrevis-logger                   as handle    no-undo .
       48   procedure vss-logevent :
       49     define input  parameter p-extra-paramters as character no-undo .
       50     define variable v-vssrevis-parameters as character no-undo .
       51     do
       52     on error undo, return error return-value
       53     :
       54       if  valid-handle(v-vssrevis-logger)
       55       and v-vssrevis-logger :get-signature("logevent") <> ""
       56       then do:
       57         run vss-get-parameters in this-procedure
       58           (output v-vssrevis-parameters
       59           ).
       60         run logevent in v-vssrevis-logger
       61           (input vss-workfile
       62           ,input vss-revision
       63           ,input v-vssrevis-parameters
       64           ,input p-extra-paramters
       65           ).
       66       end.
       67     end.
       68   end procedure.
       69   assign
       70     v-vssrevis-logger = g#vssrevis-logger
       71   .
       72   if  valid-handle(v-vssrevis-logger)
       73   and v-vssrevis-logger :get-signature("logevent") <> ""
       74   then do:
       75     assign
       76       v-vssrevis-logevent = true
       77     .
       78     run vss-logevent in this-procedure (input vss-description) .
       79   end.
       80   define new global shared variable g#language as character no-undo .
       81   if g#language <> '' and g#language <> 'rus':U then do:
       82     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       83   end.
       84   define new global shared variable g#library  as handle no-undo .
       85   define new global shared variable g#library2 as handle no-undo .
       86   procedure proc-alt-shift-f2:
       87     if not ibs.th.gbl.gbl-var:rcode
       88   then
       89     run gbl\inidebug.p .
       90   end.
       91   procedure proc-alt-shift-f3:
       92     run gbl/prvssinf.p
       93       ( input this-procedure
       94       ) .
       95   end.
       96   define variable v-inform-launched as logical no-undo initial false .
       97   procedure proc-alt-shift-f4:
       98     define variable v-action as character no-undo .
       99     if v-inform-launched = false then do:
      100       assign
      101         v-inform-launched = true
      102       .
      103       run gbl/d-inform.w
      104         (  input self
      105         ,  input this-procedure
      106         , output v-action
      107         ) no-error .
      108       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      109       assign
      110         v-inform-launched = false
      111       .
      112     end.
      113   end.
      114   procedure proc-alt-f1:
      115     run gbl/corrhelp.p
      116       (input this-procedure
      117       ) .
      118   end .
      119   on alt-shift-f2 anywhere do:
      120     run proc-alt-shift-f2.
      121   end.
      122   on alt-shift-f3 anywhere do:
      123     run proc-alt-shift-f3 in this-procedure .
      124   end.
      125   on alt-shift-f4 anywhere do:
      126     run proc-alt-shift-f4 in this-procedure.
      127   end.
      128   on alt-f1 anywhere do:
      129     run proc-alt-f1 in this-procedure .
      130   end.
