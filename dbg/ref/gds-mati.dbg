        1   DEFINE BUFFER locked_assortment-matrix-goods FOR ub.assortment-matrix-goods.
        2   DEFINE TEMP-TABLE tt-assortment-matrix-goods NO-UNDO LIKE ub.assortment-matrix-goods
        3          field artic as char
        4          field prod-code as int
        5          field prod-type as char
        6          field gds-name as char.
        7   DEFINE BUFFER X_curr_clients FOR ub.clients.
        8   define input parameter parparentproc  as widget-handle no-undo.
        9   define input parameter p-mode         as character no-undo.
       10   define input parameter p-asmt-id      like ub.assortment-matrix.asmt-id no-undo.
       11   define input parameter p-db-num       like ub.assortment-matrix.db-num no-undo.
       12   define input-output parameter p-doc-rec as recid no-undo.
       13   def var vss-revision    as character no-undo init "$Revision$":U .
       14   def var vss-author      as character no-undo init "$Author$":U .
       15   def var vss-date        as character no-undo init "$Date$":U .
       16   def var vss-workfile    as character no-undo init "$Workfile$":U .
       17   def var vss-archive     as character no-undo init "$Archive$":U .
       18   def var vss-description as character no-undo init "Карточка редактирования товаров ассортиментной матрицы ".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   define   shared variable g#auto as logical no-undo.
       80   define   shared variable g#news as logical no-undo.
       81   define   shared variable g#oxml as logical no-undo.
       82   define   shared variable g#esys as logical no-undo.
       83   define   shared variable g#news-source-db as integer no-undo.
       84   define   shared variable g#esys-source-esys as integer no-undo.
       85   define   shared variable g#db-num as integer   no-undo .
       86   define   shared variable g#userid as character no-undo .
       87   define   shared variable g#passwd as character no-undo .
       88   procedure proc-alt-shift-f2:
       89     if not ibs.th.gbl.gbl-var:rcode
       90   then
       91     run gbl\inidebug.p .
       92   end.
       93   procedure proc-alt-shift-f3:
       94     run gbl/prvssinf.p
       95       ( input this-procedure
       96       ) .
       97   end.
       98   define variable v-inform-launched as logical no-undo initial false .
       99   procedure proc-alt-shift-f4:
      100     define variable v-action as character no-undo .
      101     if v-inform-launched = false then do:
      102       assign
      103         v-inform-launched = true
      104       .
      105       run gbl/d-inform.w
      106         (  input self
      107         ,  input this-procedure
      108         , output v-action
      109         ) no-error .
      110       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      111       assign
      112         v-inform-launched = false
      113       .
      114     end.
      115   end.
      116   procedure proc-alt-f1:
      117     run gbl/corrhelp.p
      118       (input this-procedure
      119       ) .
      120   end .
      121   on alt-shift-f2 anywhere do:
      122     run proc-alt-shift-f2.
      123   end.
      124   on alt-shift-f3 anywhere do:
      125     run proc-alt-shift-f3 in this-procedure .
      126   end.
      127   on alt-shift-f4 anywhere do:
      128     run proc-alt-shift-f4 in this-procedure.
      129   end.
      130   on alt-f1 anywhere do:
      131     run proc-alt-f1 in this-procedure .
      132   end.
      133   define new global shared variable g#lib-Matrix  as handle no-undo .
      134   define buffer buf_assortment-matrix for ub.assortment-matrix  .
      135   define variable v-tab-order as character no-undo.
      136   define variable v-db-num LIKE ub.db.db-num no-undo.
      137   define variable v-last-code like ub.assortment-matrix-goods.asmt-id no-undo.
      138   DEFINE BUTTON B-exit AUTO-GO
      139        LABEL "&Ввод"
      140        SIZE 10 BY 1
      141        BGCOLOR 8 .
      142   DEFINE BUTTON B-Help
      143        LABEL "Помо&щь"
      144        SIZE 10 BY 1
      145        BGCOLOR 8 .
      146   DEFINE BUTTON B-Hist
      147        LABEL "Ис&тория"
      148        SIZE 10 BY 1
      149        BGCOLOR 8 .
      150   DEFINE BUTTON b-quit AUTO-END-KEY
      151        LABEL "&Отмена"
      152        SIZE 10 BY 1
      153        BGCOLOR 8 .
      154   DEFINE QUERY Dialog-Frame FOR
      155         tt-assortment-matrix-goods,
      156         ub.goods SCROLLING.
      157   DEFINE FRAME Dialog-Frame
      158        B-exit AT ROW 1 COL 1
      159        b-quit AT ROW 1 COL 11
      160        B-Hist AT ROW 1 COL 79
      161        B-Help AT ROW 1 COL 89
      162        tt-assortment-matrix-goods.asmg-des AT ROW 7.5 COL 1 NO-LABEL
      163             VIEW-AS EDITOR SCROLLBAR-VERTICAL
      164             SIZE 98 BY 6.5
      165        tt-assortment-matrix-goods.asmt-id AT ROW 2 COL 34 COLON-ALIGNED
      166             LABEL "Внутр.код ассортиментной матрицы"
      167              VIEW-AS TEXT
      168             SIZE 11 BY .67
      169        tt-assortment-matrix-goods.gds-code AT ROW 3 COL 34 COLON-ALIGNED
      170              VIEW-AS TEXT
      171             SIZE 14 BY .67
      172        tt-assortment-matrix-goods.artic AT ROW 4 COL 34 COLON-ALIGNED
      173             LABEL "Артикул" FORMAT "x(16)"
      174              VIEW-AS TEXT
      175             SIZE 17 BY .67
      176             FGCOLOR 4
      177        tt-assortment-matrix-goods.prod-type AT ROW 4 COL 51.5 COLON-ALIGNED NO-LABEL
      178              VIEW-AS TEXT
      179             SIZE 4 BY .67
      180             FGCOLOR 4
      181        tt-assortment-matrix-goods.prod-code AT ROW 4 COL 56 COLON-ALIGNED NO-LABEL
      182              VIEW-AS TEXT
      183             SIZE 10 BY .67
      184             FGCOLOR 4
      185        tt-assortment-matrix-goods.gds-name AT ROW 5 COL 34 COLON-ALIGNED
      186             LABEL "Наименование" FORMAT "x(255)"
      187              VIEW-AS TEXT
      188             SIZE 60 BY .67
      189             FGCOLOR 4
      190        "Описание товара:" VIEW-AS TEXT
      191             SIZE 19.5 BY 1 AT ROW 6.5 COL 1.5
      192        SPACE(78.00) SKIP(6.82)
      193       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      194            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      195            TITLE "Заголовок ассортиментной матрицы"
      196            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      197   ASSIGN
      198          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      199          FRAME Dialog-Frame:HIDDEN           = TRUE.
      200   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      201   DO:
      202     APPLY "END-ERROR":U TO SELF.
      203   END.
      204   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      205   DO:
      206       run proc-save in this-procedure no-error.
      207     if error-status:error then return no-apply.
      208   END.
      209   ON CHOOSE OF B-Hist IN FRAME Dialog-Frame
      210   DO:
      211     define variable pp-rid-list as character no-undo .
      212    run str/cgdsmatr.w
      213    (input  parparentproc ,
      214     input  tt-assortment-matrix-goods.asmt-id ,
      215     input  tt-assortment-matrix-goods.db-num ,
      216     input  tt-assortment-matrix-goods.gds-code,
      217     input-output pp-rid-list    ).
      218   END.
      219   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      220   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      221   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      222   on help of frame Dialog-Frame
      223   do:
      224     run gbl/app_help.p
      225       (input this-procedure :file-name
      226       ,input ''
      227       ,input ?
      228       ) no-error.
      229     if error-status :error then do:
      230       message
      231         "Ошибка при вызове помощи"
      232         error-status :get-message(1)
      233         view-as alert-box .
      234     end.
      235   end.
      236   run minbtn-set in this-procedure .
      237   on choose of b-help in frame Dialog-Frame
      238   do:
      239     apply "help":u to frame Dialog-Frame .
      240   end.
      241   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      242   procedure minbtn-set :
      243       do
      244           on error undo, return error return-value
      245           :
      246           define variable ii              as integer       no-undo .
      247           define variable fh              as widget-handle no-undo .
      248           define variable hh              as widget-handle no-undo .
      249           define variable v-h             as handle        extent 4 no-undo .
      250           define variable v-name-button   as character     no-undo .
      251           define variable v-help-old-x    as decimal       no-undo .
      252           define variable v-help-old-y    as decimal       no-undo .
      253           define variable v-help-old-size as decimal       no-undo .
      254           define variable v-frame-width   as decimal       no-undo .
      255           define variable jj              as integer       no-undo .
      256           do
      257               on error undo, return error
      258               :
      259               assign
      260                   v-frame-width = frame Dialog-Frame:width - 0.3
      261                   fh            = frame Dialog-Frame:first-child
      262                   hh            = fh:first-child
      263                   ii            = 1
      264                   .
      265               do while valid-handle(hh):
      266                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      267                   do:
      268                       case lc(hh:name) :
      269                           when "b-help" then
      270                               do:
      271                                   hh:load-image-up("cmp/b-help.bmp":u) .
      272                                   hh:load-image-down("cmp/b-help.bmp":u) .
      273                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      274                                   hh:TOOLTIP = "Помощь" .
      275                                   v-help-old-x = hh:column .
      276                                   v-help-old-y = hh:row    .
      277                                   v-help-old-size = hh:width .
      278                                   hh:width-chars = 2.5 .
      279                               end.
      280                           when "b-print" then
      281                               do:
      282                                   hh:load-image("cmp/b-print.bmp":u) .
      283                                   hh:TOOLTIP = "Печать" .
      284                                   v-h[ii] = hh:handle .
      285                                   ii = ii + 1 .
      286                                   hh:width-chars = 3 .
      287                               end.
      288                           when "b-history" or
      289                           when "b-hist" then
      290                               do:
      291                                   hh:load-image("cmp/b-hist.bmp":u) .
      292                                   hh:TOOLTIP = "История" .
      293                                   v-h[ii] = hh:handle .
      294                                   ii = ii + 1 .
      295                                   hh:width-chars = 3 .
      296                               end.
      297                           when "b-sch" then
      298                               do:
      299                                   hh:load-image("cmp/b-sch.bmp":u) .
      300                                   hh:TOOLTIP = "Установка Фильтра" .
      301                                   v-h[ii] = hh:handle .
      302                                   ii = ii + 1 .
      303                                   hh:width-chars = 3 .
      304                               end.
      305                           when "b-hist-user" then
      306                               do:
      307                                   hh:load-image("cmp/b-hist.bmp":u) .
      308                                   hh:TOOLTIP = "История пользователя" .
      309                                   ii = ii + 1 .
      310                               end.
      311                       end case.
      312                   end.
      313                   hh = hh:next-sibling.
      314               end.
      315               b-help:column = v-frame-width - b-help:width-chars.
      316               jj = 0.
      317               repeat ii = 4 to 1 by -1 :
      318                   if valid-handle (v-h[ii] ) then
      319                   do:
      320                       jj  = jj + 1 .
      321                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      322                       v-h[ii]:row    = v-help-old-y .
      323                   end.
      324               end.
      325           end.
      326       end.
      327   end procedure.
      328   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      329   ON TAB ANYWHERE
      330   DO:
      331   define variable ii as integer no-undo .
      332   define variable fh as widget-handle no-undo .
      333   define variable hh as widget-handle no-undo .
      334   define variable v-next-widget-name as character no-undo .
      335   if v-tab-order <> '' then do:
      336     if self:type = "TOGGLE-BOX" then
      337     self:BGCOLOR = ?.
      338     assign
      339     ii = lookup(self:name, v-tab-order).
      340     assign
      341     ii = ii + 1
      342     v-next-widget-name = entry(ii, v-tab-order)
      343     no-error .
      344     if error-status:error then do:
      345       assign
      346       ii = 1
      347       v-next-widget-name = entry( ii, v-tab-order)
      348       .
      349     end.
      350     assign
      351     fh = frame Dialog-Frame:first-child
      352     hh = fh:first-child
      353     .
      354     do while valid-handle(hh):
      355       if hh:name = v-next-widget-name then do:
      356         if hh:sensitive  = yes
      357         AND hh:visible = yes then do:
      358           APPLY "ENTRY" to hh.
      359           return no-apply.
      360         end.
      361         else do:
      362           APPLY "TAB" to hh.
      363           return no-apply.
      364         end.
      365       end.
      366       hh = hh:next-sibling.
      367     end.
      368   end.
      369   END.
      370   ON BACK-TAB ANYWHERE
      371   DO:
      372   define variable ii as integer no-undo .
      373   define variable fh as widget-handle no-undo .
      374   define variable hh as widget-handle no-undo .
      375   define variable v-next-widget-name as character no-undo .
      376   if v-tab-order <> '' then do:
      377     assign
      378     ii = lookup(self:name, v-tab-order).
      379     .
      380     assign
      381     ii = (if ii = 1
      382           then  num-entries(v-tab-order)
      383           else ii - 1
      384           )
      385     v-next-widget-name = entry(ii, v-tab-order)
      386     .
      387     assign
      388     fh = frame Dialog-Frame:first-child
      389     hh = fh:first-child
      390     .
      391     do while valid-handle(hh):
      392       if hh:name = v-next-widget-name then do:
      393         if hh:sensitive  = yes
      394         AND hh:visible = yes then do:
      395           APPLY "ENTRY" to hh.
      396           return no-apply.
      397         end.
      398         else do:
      399         APPLY "BACK-TAB" to hh.
      400         return no-apply.
      401         end.
      402       end.
      403       hh = hh:next-sibling.
      404     end.
      405     end.
      406   END.
      407   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      408   ON RETURN ANYWHERE
      409   DO:
      410   define variable ii as integer no-undo .
      411   define variable fh as widget-handle no-undo .
      412   define variable hh as widget-handle no-undo .
      413   define variable v-next-widget-name as character no-undo .
      414     if v-tab-order <> '' then do:
      415       assign
      416       ii = lookup(self:name, v-tab-order).
      417       if ii = num-entries(v-tab-order) then do:
      418           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
      419           return no-apply.
      420       end.
      421       if self:type <> "BUTTON" and
      422         self:type <> "EDITOR"  then do:
      423         run proc-move-forward in this-procedure .
      424         return no-apply.
      425       end.
      426       if self:type = "BUTTON" then do:
      427         APPLY "CHOOSE" to self.
      428       end.
      429       if self:type = "TOGGLE-BOX" then
      430       self:BGCOLOR = ?.
      431       assign
      432       ii = ii + 1
      433       v-next-widget-name = entry(ii, v-tab-order)
      434       no-error .
      435       if error-status:error then do:
      436         assign
      437         ii = 1
      438         v-next-widget-name = entry( ii, v-tab-order)
      439         .
      440       end.
      441       assign
      442       fh = frame Dialog-Frame:first-child
      443       hh = fh:first-child
      444       .
      445       do while valid-handle(hh):
      446         if hh:name = v-next-widget-name then do:
      447           if hh:sensitive  = yes
      448           AND hh:visible = yes then do:
      449             if hh:type = "TOGGLE-BOX":U then do:
      450               assign
      451               hh:BGcolor = 1
      452               .
      453             end.
      454             APPLY "ENTRY" to hh.
      455             return no-apply.
      456           end.
      457           else do:
      458             APPLY "TAB" to hh.
      459             return no-apply.
      460           end.
      461         end.
      462         hh = hh:next-sibling.
      463       end.
      464     end.
      465   END.
      466   procedure proc-move-forward :
      467   define variable ii as integer no-undo .
      468   define variable fh as widget-handle no-undo .
      469   define variable hh as widget-handle no-undo .
      470   define variable v-next-widget-name as character no-undo .
      471   do
      472   on error undo, return error
      473   :
      474     if v-tab-order <> '' then do:
      475       if self:type = "TOGGLE-BOX" then
      476       self:BGCOLOR = ?.
      477       assign
      478       ii = lookup(self:name, v-tab-order).
      479       assign
      480       ii = ii + 1
      481       v-next-widget-name = entry(ii, v-tab-order)
      482       no-error .
      483       if error-status:error then do:
      484         assign
      485         ii = 1
      486         v-next-widget-name = entry( ii, v-tab-order)
      487         .
      488       end.
      489       assign
      490       fh = frame Dialog-Frame:first-child
      491       hh = fh:first-child
      492       .
      493       do while valid-handle(hh):
      494         if hh:name = v-next-widget-name then do:
      495           if hh:sensitive  = yes
      496           AND hh:visible = yes then do:
      497             if hh:type = "TOGGLE-BOX":U then do:
      498               assign
      499               hh:BGcolor = 1
      500               .
      501             end.
      502             APPLY "ENTRY" to hh.
      503             return.
      504           end.
      505           else do:
      506             assign
      507             ii = ii + 1
      508             v-next-widget-name = entry(ii, v-tab-order)
      509             no-error .
      510             if error-status:error then do:
      511               assign
      512               ii = 1
      513               v-next-widget-name = entry( ii, v-tab-order)
      514               .
      515             end.
      516           end.
      517         end.
      518         hh = hh:next-sibling.
      519       end.
      520     end.
      521   end.
      522   end procedure.
      523   MAIN-BLOCK:
      524   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      525      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      526      find first buf_assortment-matrix exclusive-lock where
      527                 buf_assortment-matrix.asmt-id = p-asmt-id and
      528                 buf_assortment-matrix.db-num = p-db-num no-error .
      529     if error-status :error then message
      530       vss-workfile vss-revision vss-description skip
      531       error-status :get-message(1) skip
      532       return-value skip
      533       ""
      534       view-as alert-box error
      535     .
      536    ASSIGN frame Dialog-Frame:TITLE = buf_assortment-matrix.asmt-name .
      537    if p-mode  <> 'ДОБАВЛЕНИЕ':U
      538    and p-mode <> 'ИЗМЕНЕНИЕ':U
      539    and p-mode <> 'ПРОСМОТР':U
      540    then do:
      541       message
      542       vss-workfile vss-revision vss-description skip
      543       "Неверное значение параметров вызова p-mode"  p-mode
      544       view-as alert-box ERROR.
      545       undo, return error.
      546    end.
      547   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      548   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      549     (output v-db-num
      550     )  .
      551     for each tt-assortment-matrix-goods:
      552       delete tt-assortment-matrix-goods.
      553     end.
      554     if p-mode = 'ИЗМЕНЕНИЕ':U
      555     or p-mode = 'ПРОСМОТР':U then do:
      556       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      557         find first locked_assortment-matrix-goods exclusive-lock where
      558                      recid(locked_assortment-matrix-goods) = p-doc-rec no-wait no-error.
      559         if locked locked_assortment-matrix-goods then do:
      560           message
      561           vss-workfile vss-revision vss-description skip
      562            "Запись товара Ассортиментной матрицы занята"
      563           view-as alert-box error .
      564           undo, return error.
      565         end.
      566       end.
      567       else do:
      568         find first locked_assortment-matrix-goods no-lock where
      569                          recid(locked_assortment-matrix-goods) = p-doc-rec no-error .
      570         if not avail locked_assortment-matrix-goods then do:
      571           find first locked_assortment-matrix-goods no-lock where
      572                      locked_assortment-matrix-goods.db-num  = p-db-num and
      573                      locked_assortment-matrix-goods.asmt-id = p-asmt-id no-error .
      574         end.
      575       end.
      576       if not available locked_assortment-matrix-goods then do:
      577         message
      578         vss-workfile vss-revision vss-description skip
      579         "Не найдена запись товара Ассортиментной матрицы"
      580         view-as alert-box error .
      581         undo, return error.
      582       end.
      583       create tt-assortment-matrix-goods.
      584       buffer-copy locked_assortment-matrix-goods to tt-assortment-matrix-goods.
      585       find first goods no-lock where goods.gds-code = locked_assortment-matrix-goods.gds-code no-error .
      586       assign
      587         tt-assortment-matrix-goods.artic     = goods.artic
      588         tt-assortment-matrix-goods.prod-code = goods.prod-code
      589         tt-assortment-matrix-goods.prod-type = goods.prod-type
      590         tt-assortment-matrix-goods.gds-name  = goods.gds-name
      591       .
      592      end.
      593      else do:
      594             create tt-assortment-matrix-goods.
      595             assign
      596             tt-assortment-matrix-goods.asmt-id = v-last-code + 1
      597             tt-assortment-matrix-goods.db-num  = p-db-num
      598            .
      599      end.
      600     run myenable.
      601     wait-for go of frame Dialog-Frame focus tt-assortment-matrix-goods.asmg-des .
      602   END.
      603   run disable_ui.
      604   PROCEDURE disable_UI :
      605     HIDE FRAME Dialog-Frame.
      606   END PROCEDURE.
      607   PROCEDURE enable_UI :
      608     OPEN QUERY Dialog-Frame FOR EACH tt-assortment-matrix-goods SHARE-LOCK,       EACH ub.goods WHERE TRUE  SHARE-LOCK.
      609     GET FIRST Dialog-Frame.
      610     IF AVAILABLE tt-assortment-matrix-goods THEN
      611       DISPLAY tt-assortment-matrix-goods.asmg-des tt-assortment-matrix-goods.asmt-id
      612             tt-assortment-matrix-goods.gds-code tt-assortment-matrix-goods.artic
      613             tt-assortment-matrix-goods.prod-type
      614             tt-assortment-matrix-goods.prod-code
      615             tt-assortment-matrix-goods.gds-name
      616         WITH FRAME Dialog-Frame.
      617     ENABLE B-exit b-quit B-Hist B-Help tt-assortment-matrix-goods.asmg-des
      618            tt-assortment-matrix-goods.asmt-id tt-assortment-matrix-goods.gds-code
      619            tt-assortment-matrix-goods.artic tt-assortment-matrix-goods.prod-type
      620            tt-assortment-matrix-goods.prod-code
      621            tt-assortment-matrix-goods.gds-name
      622         WITH FRAME Dialog-Frame.
      623     VIEW FRAME Dialog-Frame.
      624   END PROCEDURE.
      625   PROCEDURE MyENable :
      626     case p-mode:
      627     when 'ДОБАВЛЕНИЕ':U then do:
      628     end.
      629     otherwise do:
      630       IF AVAILABLE tt-assortment-matrix-goods THEN
      631       DISPLAY
      632       tt-assortment-matrix-goods.asmt-id
      633       tt-assortment-matrix-goods.artic
      634       tt-assortment-matrix-goods.prod-code
      635       tt-assortment-matrix-goods.prod-type
      636       tt-assortment-matrix-goods.gds-name
      637       tt-assortment-matrix-goods.gds-code
      638       tt-assortment-matrix-goods.asmg-des
      639       WITH FRAME Dialog-Frame.
      640     end.
      641   END CASE.
      642   if p-mode = 'ПРОСМОТР':U then do:
      643   assign
      644   b-quit:label = "&Выход"
      645   b-quit:col = 1
      646   .
      647   hide
      648   b-exit in frame Dialog-Frame.
      649   end.
      650   ENABLE
      651   B-exit when p-mode <> 'ПРОСМОТР':U
      652   b-quit
      653   B-Hist when p-mode <> 'ДОБАВЛЕНИЕ':U
      654   B-Help
      655   tt-assortment-matrix-goods.asmg-des   when p-mode <> 'ПРОСМОТР':U
      656   WITH FRAME Dialog-Frame.
      657   VIEW FRAME Dialog-Frame.
      658   END PROCEDURE.
      659   PROCEDURE Proc-save :
      660   if p-mode = 'ПРОСМОТР':U then do:
      661       return error.
      662   end.
      663   if not available tt-assortment-matrix-goods then do:
      664       create tt-assortment-matrix-goods.
      665   end.
      666   assign
      667   frame Dialog-Frame
      668   tt-assortment-matrix-goods.asmt-id
      669   .
      670   assign
      671     tt-assortment-matrix-goods.asmg-des = tt-assortment-matrix-goods.asmg-des:SCREEN-VALUE.
      672   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run main_gds-mat1 in g#lib-Matrix
      673    (input this-procedure
      674    ,input-output p-doc-rec
      675    ,input p-mode
      676    ,input tt-assortment-matrix-goods.asmt-id
      677    ,input tt-assortment-matrix-goods.db-num
      678    ,input tt-assortment-matrix-goods.gds-code
      679    ,input tt-assortment-matrix-goods.asmg-des
      680     ) no-error .
      681       if error-status:error then do:
      682   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      683   define variable fh as widget-handle no-undo .
      684   define variable hh as widget-handle no-undo .
      685   define variable rv as character no-undo .
      686   assign
      687   rv = entry(1, return-value , chr(4)).
      688   if rv <> "":U then do:
      689     assign
      690     fh = frame Dialog-Frame:first-child
      691     hh = fh:first-child
      692     .
      693     do while valid-handle(hh):
      694       if hh:name = rv then do:
      695         APPLY "ENTRY" to hh.
      696         undo ,
      697         return error.
      698       end.
      699       hh = hh:next-sibling.
      700     end.
      701   end.
      702         undo, return error.
      703       end.
      704   END PROCEDURE.
