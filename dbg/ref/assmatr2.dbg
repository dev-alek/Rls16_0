        1   block-level on error undo, throw.
        2   define input parameter p-recid as recid no-undo.
        3   define input-output parameter p-asmt-status like ub.assortment-matrix.asmt-status no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: assmatr2.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: ref/assmatr2.p $":U .
        9   define variable vss-description as character no-undo init "Изменение статуса ассортиментной матрицы".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   DEFINE VARIABLE loc#log as logical no-undo .
       80   DEFINE BUFFER bf-assortment-matrix for ub.assortment-matrix.
       81   DEFINE VARIABLE choice as logical no-undo .
       82   DEFINE VARIABLE v-old-asmt-status like ub.assortment-matrix.asmt-status no-undo .
       83   define variable v-db-num as integer   no-undo .
       84   _main:
       85   do
       86   on error undo, return error
       87   :
       88   define buffer old_assortment-matrix for ub.assortment-matrix  .
       89   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
       91     (output v-db-num
       92     )  .
       93   FIND FIRST bf-assortment-matrix WHERE
       94              recid(bf-assortment-matrix) = p-recid.
       95       define buffer x_curr_clients for ub.clients.
       96         find first  x_curr_clients no-lock where
       97                   x_curr_clients.obj-type = bf-assortment-matrix.obj-type and
       98                   x_curr_clients.obj-code = bf-assortment-matrix.obj-code no-error.
       99         if available x_curr_clients then do:
      100             if v-db-num > 0 then do:
      101               if x_curr_clients.db-num <>  v-db-num then do:
      102                   message
      103                   "На УБД нельзя добавлять/корректировать Ассортиментные матрици по Объектам других БД" skip
      104                       x_curr_clients.obj-type x_curr_clients.obj-code skip
      105                       "БД : " x_curr_clients.db-num
      106                       view-as alert-box error.
      107                   undo, return error .
      108               end.
      109             end.
      110         end.
      111   v-old-asmt-status = bf-assortment-matrix.asmt-status.
      112   if p-asmt-status = ? then do:
      113     CASE v-old-asmt-status:
      114       when integer('0':U) then do:
      115         assign
      116         p-asmt-status = integer('1':U).
      117       end.
      118       when integer('1':U) then do:
      119         if bf-assortment-matrix.obj-type <> "" then do:
      120             find first old_assortment-matrix no-lock where
      121                         old_assortment-matrix.asmt-status = integer('0':U) and
      122                         old_assortment-matrix.obj-type    = bf-assortment-matrix.obj-type and
      123                         old_assortment-matrix.obj-code    = bf-assortment-matrix.obj-code and
      124                        not ( old_assortment-matrix.asmt-id   = bf-assortment-matrix.asmt-id and
      125                              old_assortment-matrix.db-num     = bf-assortment-matrix.db-num ) no-error .
      126             if not available old_assortment-matrix then
      127             assign
      128             p-asmt-status = integer('0':U).
      129             else do:
      130                 message "Уже есть матрица в статусе ТЕКУЩИЙ по объекту !"
      131                 bf-assortment-matrix.obj-type
      132                 bf-assortment-matrix.obj-code
      133                 view-as alert-box ERROR.
      134                 p-asmt-status = ?.
      135                 return error.
      136             end.
      137         end.
      138         else do:
      139             assign
      140             p-asmt-status = integer('0':U).
      141         end.
      142       end.
      143     END CASE.
      144   end.
      145   CASE p-asmt-status:
      146     WHEN integer('0':U) then do:
      147       if integer('0':U) = bf-assortment-matrix.asmt-status  then do:
      148         message "Запись уже имеет статус ТЕКУЩИЙ!"
      149         view-as alert-box ERROR.
      150         p-asmt-status = ?.
      151         return error.
      152       end.
      153       else do:
      154         if v-db-num <> 0 then do:
      155             message
      156             "Восстановить матрицу можно только в ГБД"
      157             view-as alert-box information .
      158             choice = false .
      159         end.
      160         else do:
      161           message
      162           "Матрица уже удалена - восстановить?"
      163           view-as alert-box QUestion buttons YEs-no update choice.
      164         end.
      165       end.
      166     end.
      167     WHEN integer('1':U) then do:
      168       if integer('1':U) = bf-assortment-matrix.asmt-status  then do:
      169         message "Запись уже имеет статус УДАЛЕН!"
      170         view-as alert-box ERROR.
      171         p-asmt-status = ?.
      172         return error.
      173       end.
      174       else do:
      175         message
      176         "Удалить Ассортиментную матрицу?"
      177         view-as alert-box QUestion buttons yes-no update choice.
      178       end.
      179     end.
      180   END CASE.
      181   if choice = false  then do:
      182      release bf-assortment-matrix no-error .
      183      return .
      184   end.
      185   if choice then
      186   assign
      187   bf-assortment-matrix.asmt-status = p-asmt-status.
      188   release bf-assortment-matrix no-error .
      189   if error-status:error then do:
      190     message
      191     "Ошибка при сохранении записи Ассортиментной Матрицы" skip
      192     error-status:get-message(1) skip
      193     return-value
      194     view-as alert-box error .
      195     undo _main, return error .
      196   end.
      197   define buffer buf_assortment-matrix-goods for ub.assortment-matrix-goods  .
      198   define buffer buf_gds-obj-prop for ub.gds-obj-prop  .
      199   FIND FIRST bf-assortment-matrix no-lock WHERE
      200             recid(bf-assortment-matrix) = p-recid.
      201   if p-asmt-status = integer('1':U) and
      202      bf-assortment-matrix.asmt-type = 'Объект':U then do:
      203      choice = false .
      204      message
      205      "Изменить ИЖТ всех товаров удаленной Ассортиментной матрицы на ПУСТО ?"
      206      view-as alert-box QUestion buttons yes-no update choice.
      207      if choice then do:
      208         FIND FIRST bf-assortment-matrix exclusive-lock WHERE
      209                   recid(bf-assortment-matrix) = p-recid.
      210         for each buf_assortment-matrix-goods exclusive-lock where
      211                  buf_assortment-matrix-goods.asmt-id = bf-assortment-matrix.asmt-id and
      212                  buf_assortment-matrix-goods.db-num  = bf-assortment-matrix.db-num
      213                  :
      214                  for each buf_gds-obj-prop exclusive-lock where
      215                           buf_gds-obj-prop.gds-code = buf_assortment-matrix-goods.gds-code and
      216                           buf_gds-obj-prop.obj-type = bf-assortment-matrix.obj-type and
      217                           buf_gds-obj-prop.obj-code = bf-assortment-matrix.obj-code :
      218                           buf_gds-obj-prop.gdop-igt = 'Пусто':U .
      219                  end.
      220         end.
      221      end.
      222   end.
      223   p-asmt-status = ?.
      224   end.
