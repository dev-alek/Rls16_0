        1   DEFINE TEMP-TABLE tt-tax-rate NO-UNDO LIKE ub.tax-rate.
        2   def input parameter ref-mode as char no-undo.
        3   def input-output param rid as recid no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision$":u .
        5   define variable vss-author      as character no-undo init "$Author$":u .
        6   define variable vss-date        as character no-undo init "$Date$":u .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":u .
        8   define variable vss-archive     as character no-undo init "$Archive$":u .
        9   define variable vss-description as character no-undo init "Карточка ставки налога" .
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   define variable taxcode like ub.tax.tax-code no-undo.
      116   define buffer buf_tax-rate-attr for ub.tax-rate-attr .
      117   define VARIABLE v-envd-old as LOGICAL NO-UNDO .
      118   DEFINE BUTTON b-exit AUTO-GO
      119        LABEL "&Ввод "
      120        SIZE 10 BY 1
      121        BGCOLOR 8 .
      122   DEFINE BUTTON B-help
      123        LABEL "Помо&щь"
      124        SIZE 10 BY 1
      125        BGCOLOR 8 .
      126   DEFINE BUTTON b-quit AUTO-END-KEY
      127        LABEL "&Отмена"
      128        SIZE 10 BY 1
      129        BGCOLOR 8 .
      130   DEFINE VARIABLE T-envd AS LOGICAL INITIAL no
      131        LABEL "без НДС"
      132        VIEW-AS TOGGLE-BOX
      133        SIZE 11.13 BY .83 NO-UNDO.
      134   DEFINE QUERY d-add-tax-rate FOR
      135         tt-tax-rate SCROLLING.
      136   DEFINE FRAME d-add-tax-rate
      137        b-exit AT ROW 1 COL 1
      138        b-quit AT ROW 1 COL 11
      139        B-help AT ROW 1 COL 40
      140        T-envd AT ROW 3.08 COL 42 WIDGET-ID 2
      141        tt-tax-rate.tax-code AT ROW 3.13 COL 21.88 COLON-ALIGNED
      142             LABEL "Код вида налога"
      143             VIEW-AS FILL-IN
      144             SIZE 7 BY 1
      145        tt-tax-rate.rate-code AT ROW 4.42 COL 21.88 COLON-ALIGNED
      146             LABEL "Код ставки налога" FORMAT ">>>>>9"
      147             VIEW-AS FILL-IN
      148             SIZE 9.88 BY 1
      149        tt-tax-rate.rate-name AT ROW 5.71 COL 21.88 COLON-ALIGNED
      150             LABEL "Название ставки"
      151             VIEW-AS FILL-IN
      152             SIZE 30.5 BY 1
      153        SPACE(0.99) SKIP(1.36)
      154       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      155            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      156            TITLE "Ставка налога"
      157            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit.
      158   ASSIGN
      159          FRAME d-add-tax-rate:SCROLLABLE       = FALSE
      160          FRAME d-add-tax-rate:HIDDEN           = TRUE.
      161   ON GO OF FRAME d-add-tax-rate
      162   DO:
      163     find first tt-tax-rate No-ERROR.
      164    if not avail tt-tax-rate then create tt-tax-rate.
      165    assign
      166    tt-tax-rate.rate-code
      167    tt-tax-rate.rate-name
      168    tt-tax-rate.tax-code
      169    .
      170    if v-envd-old <> t-envd then do:
      171        find first buf_tax-rate-attr where buf_tax-rate-attr.tax-code = tt-tax-rate.tax-code
      172                                       and buf_tax-rate-attr.attr-code = "envd" no-error .
      173           if AVAILABLE buf_tax-rate-attr then do:
      174                    if t-envd then do:
      175                        MESSAGE SUBSTITUTE ("У кода ставки налога &1, уже есть атрибут без НДС", buf_tax-rate-attr.rate-code)
      176                        VIEW-AS ALERT-BOX.
      177                    end.
      178                    else do:
      179                       delete buf_tax-rate-attr.
      180                    end.
      181           end.
      182           else do:
      183                        create buf_tax-rate-attr .
      184                        assign
      185                           buf_tax-rate-attr.tax-code = tt-tax-rate.tax-code
      186                           buf_tax-rate-attr.attr-code = "envd"
      187                           buf_tax-rate-attr.rate-code = tt-tax-rate.rate-code
      188                        .
      189           end.
      190     end.
      191    run ref/taxrati1.p
      192    ( input-output rid
      193    , input ref-mode
      194    , input no
      195    , input taxcode
      196    , input tt-tax-rate.rate-code
      197    , input tt-tax-rate.rate-name
      198    , input tt-tax-rate.status_
      199    ) no-error.
      200     if error-status:error then do:
      201           if return-value = "":U then return no-apply.
      202       case return-value:
      203               when "rate-name":U then do:
      204                   APPLY "ENTRY" to tt-tax-rate.rate-name.
      205               end.
      206               when "rate-code":U then do:
      207                    APPLY "ENTRY" to tt-tax-rate.rate-code.
      208               end.
      209           end.
      210       return no-apply.
      211     end.
      212    END.
      213   ON WINDOW-CLOSE OF FRAME d-add-tax-rate
      214   DO:
      215     rid = ?.
      216     APPLY "END-ERROR":U TO SELF.
      217   END.
      218   ON CHOOSE OF b-quit IN FRAME d-add-tax-rate
      219   DO:
      220     rid = ?.
      221   END.
      222   ON VALUE-CHANGED OF T-envd IN FRAME d-add-tax-rate
      223   DO:
      224       IF T-envd:checked then do:
      225               assign T-envd
      226               .
      227        end.
      228        else t-envd = no.
      229   END.
      230   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-add-tax-rate:PARENT eq ?
      231   THEN FRAME d-add-tax-rate:PARENT = ACTIVE-WINDOW.
      232   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      233   on help of frame d-add-tax-rate
      234   do:
      235     run gbl/app_help.p
      236       (input this-procedure :file-name
      237       ,input ''
      238       ,input ?
      239       ) no-error.
      240     if error-status :error then do:
      241       message
      242         "Ошибка при вызове помощи"
      243         error-status :get-message(1)
      244         view-as alert-box .
      245     end.
      246   end.
      247   run minbtn-set in this-procedure .
      248   on choose of b-help in frame d-add-tax-rate
      249   do:
      250     apply "help":u to frame d-add-tax-rate .
      251   end.
      252   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      253   procedure minbtn-set :
      254       do
      255           on error undo, return error return-value
      256           :
      257           define variable ii              as integer       no-undo .
      258           define variable fh              as widget-handle no-undo .
      259           define variable hh              as widget-handle no-undo .
      260           define variable v-h             as handle        extent 4 no-undo .
      261           define variable v-name-button   as character     no-undo .
      262           define variable v-help-old-x    as decimal       no-undo .
      263           define variable v-help-old-y    as decimal       no-undo .
      264           define variable v-help-old-size as decimal       no-undo .
      265           define variable v-frame-width   as decimal       no-undo .
      266           define variable jj              as integer       no-undo .
      267           do
      268               on error undo, return error
      269               :
      270               assign
      271                   v-frame-width = frame d-add-tax-rate:width - 0.3
      272                   fh            = frame d-add-tax-rate:first-child
      273                   hh            = fh:first-child
      274                   ii            = 1
      275                   .
      276               do while valid-handle(hh):
      277                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      278                   do:
      279                       case lc(hh:name) :
      280                           when "b-help" then
      281                               do:
      282                                   hh:load-image-up("cmp/b-help.bmp":u) .
      283                                   hh:load-image-down("cmp/b-help.bmp":u) .
      284                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      285                                   hh:TOOLTIP = "Помощь" .
      286                                   v-help-old-x = hh:column .
      287                                   v-help-old-y = hh:row    .
      288                                   v-help-old-size = hh:width .
      289                                   hh:width-chars = 2.5 .
      290                               end.
      291                           when "b-print" then
      292                               do:
      293                                   hh:load-image("cmp/b-print.bmp":u) .
      294                                   hh:TOOLTIP = "Печать" .
      295                                   v-h[ii] = hh:handle .
      296                                   ii = ii + 1 .
      297                                   hh:width-chars = 3 .
      298                               end.
      299                           when "b-history" or
      300                           when "b-hist" then
      301                               do:
      302                                   hh:load-image("cmp/b-hist.bmp":u) .
      303                                   hh:TOOLTIP = "История" .
      304                                   v-h[ii] = hh:handle .
      305                                   ii = ii + 1 .
      306                                   hh:width-chars = 3 .
      307                               end.
      308                           when "b-sch" then
      309                               do:
      310                                   hh:load-image("cmp/b-sch.bmp":u) .
      311                                   hh:TOOLTIP = "Установка Фильтра" .
      312                                   v-h[ii] = hh:handle .
      313                                   ii = ii + 1 .
      314                                   hh:width-chars = 3 .
      315                               end.
      316                           when "b-hist-user" then
      317                               do:
      318                                   hh:load-image("cmp/b-hist.bmp":u) .
      319                                   hh:TOOLTIP = "История пользователя" .
      320                                   ii = ii + 1 .
      321                               end.
      322                       end case.
      323                   end.
      324                   hh = hh:next-sibling.
      325               end.
      326               b-help:column = v-frame-width - b-help:width-chars.
      327               jj = 0.
      328               repeat ii = 4 to 1 by -1 :
      329                   if valid-handle (v-h[ii] ) then
      330                   do:
      331                       jj  = jj + 1 .
      332                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      333                       v-h[ii]:row    = v-help-old-y .
      334                   end.
      335               end.
      336           end.
      337       end.
      338   end procedure.
      339   MAIN-BLOCK:
      340   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      341      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      342   if ref-mode <> 'ИЗМЕНЕНИЕ':U and ref-mode <> 'ДОБАВЛЕНИЕ':U then do:
      343           message vss-workfile vss-revision vss-description skip
      344                       "Неверный параметр вызова ref-mode"
      345           view-as alert-box ERROR.
      346           return error.
      347       end.
      348     IF ref-mode = 'ДОБАВЛЕНИЕ':U then do:
      349       FIND FIRST ub.tax Exclusive-LOCK WHERE recid(ub.tax) = rid No-WAIT no-error.
      350       if locked tax then do:
      351         message vss-workfile vss-revision vss-description skip
      352                 "Запись налога занята"
      353         view-as alert-box error .
      354         return error.
      355       end.
      356       IF NOT AVAIL tax then do:
      357         message vss-workfile vss-revision vss-description skip
      358                 "Запись налога не найдена"
      359         view-as alert-box error .
      360         return error.
      361       end.
      362       assign
      363       taxcode =  tax.tax-code.
      364     end.
      365     else do:
      366       FIND FIRST ub.tax-rate EXclusive-lock WHERE recid(ub.tax-rate) = rid no-wait no-error .
      367       if locked ub.tax-rate then do:
      368         message vss-workfile vss-revision vss-description skip
      369                 "Запись ставки налога занята"
      370         view-as alert-box error .
      371         return error.
      372       end.
      373       IF NOT AVAIL tax-rate then do:
      374         message vss-workfile vss-revision vss-description skip
      375                 "Запись ставки налога не найдена"
      376         view-as alert-box error .
      377         return error.
      378       end.
      379       if tax-rate.status_ = 'удал':U then do:
      380         message "Ставка удалена - изменение невозможно"
      381         view-as alert-box ERROR.
      382         return error.
      383       end.
      384       for each tt-tax-rate:
      385               delete tt-tax-rate.
      386           end.
      387           create tt-tax-rate.
      388           buffer-copy tax-rate to tt-tax-rate.
      389     end.
      390     RUN MyEnable.
      391     WAIT-FOR GO OF FRAME d-add-tax-rate.
      392   END.
      393   RUN disable_UI.
      394   PROCEDURE disable_UI :
      395     HIDE FRAME d-add-tax-rate.
      396   END PROCEDURE.
      397   PROCEDURE enable_UI :
      398     OPEN QUERY d-add-tax-rate FOR EACH tt-tax-rate SHARE-LOCK.
      399     GET FIRST d-add-tax-rate.
      400     DISPLAY T-envd
      401         WITH FRAME d-add-tax-rate.
      402     IF AVAILABLE tt-tax-rate THEN
      403       DISPLAY tt-tax-rate.tax-code tt-tax-rate.rate-code tt-tax-rate.rate-name
      404         WITH FRAME d-add-tax-rate.
      405     ENABLE b-exit b-quit B-help T-envd tt-tax-rate.rate-code
      406            tt-tax-rate.rate-name
      407         WITH FRAME d-add-tax-rate.
      408     VIEW FRAME d-add-tax-rate.
      409   END PROCEDURE.
      410   PROCEDURE MyEnable :
      411     IF AVAILABLE tt-tax-rate THEN
      412       DISPLAY
      413       tt-tax-rate.tax-code
      414       tt-tax-rate.rate-code
      415       tt-tax-rate.rate-name
      416       WITH FRAME D-add-tax-rate.
      417     find first buf_tax-rate-attr where buf_tax-rate-attr.tax-code = tt-tax-rate.tax-code
      418                                       and buf_tax-rate-attr.rate-code = tt-tax-rate.rate-code
      419                                       and buf_tax-rate-attr.attr-code = "envd" no-error .
      420       if AVAILABLE buf_tax-rate-attr then do:
      421        T-envd = yes.
      422        v-envd-old = yes.
      423       end.
      424     ENABLE
      425     B-exit
      426     B-quit
      427     B-Help
      428     tt-tax-rate.rate-name
      429     T-envd
      430     WITH FRAME D-add-tax-rate.
      431     VIEW FRAME D-add-tax-rate.
      432     display t-envd with frame d-add-tax-rate.
      433     ENABLE
      434     tt-tax-rate.rate-code when ref-mode = 'ДОБАВЛЕНИЕ':U
      435     WITH FRAME d-add-tax-rate.
      436     IF ref-mode = 'ИЗМЕНЕНИЕ':U then do:
      437         FRAME d-add-tax-rate:title = "Изменение ставки налога".
      438         DISPLAY
      439         tt-tax-rate.tax-code
      440         tt-tax-rate.rate-code
      441         tt-tax-rate.rate-name
      442         WITH frame d-add-tax-rate.
      443     END.
      444     ELSE do:
      445       DISPLAY
      446       taxcode @ tt-tax-rate.tax-code
      447       WITH frame d-add-tax-rate.
      448     END.
      449   END PROCEDURE.
