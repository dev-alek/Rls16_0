        1   block-level on error undo, throw.
        2   define input parameter  p-time-rule-num     like ub.dis-time-rule.time-rule-num          no-undo .
        3   define input parameter  p-rl-root           like ub.dis-time-rule.rl-root           no-undo .
        4   define input parameter  p-templ-rl-root     like ub.dis-time-rule.templ-rl-root     no-undo .
        5   define input parameter  p-des               like ub.dis-time-rule.des               no-undo .
        6   define input parameter  p-date-from         like ub.dis-time-rule.date-from no-undo .
        7   define input parameter  p-date-to           like ub.dis-time-rule.date-to no-undo .
        8   define input parameter  p-time-from         like ub.dis-time-rule.time-from no-undo .
        9   define input parameter  p-time-to           like ub.dis-time-rule.time-to no-undo .
       10   define input parameter  p-month-day         like ub.dis-time-rule.month-day no-undo .
       11   define input parameter  p-week-day-0        like ub.dis-time-rule.week-day-0 no-undo .
       12   define input parameter  p-week-day-1        like ub.dis-time-rule.week-day-1 no-undo .
       13   define input parameter  p-week-day-2        like ub.dis-time-rule.week-day-2 no-undo .
       14   define input parameter  p-week-day-3        like ub.dis-time-rule.week-day-3 no-undo .
       15   define input parameter  p-week-day-4        like ub.dis-time-rule.week-day-4 no-undo .
       16   define input parameter  p-week-day-5        like ub.dis-time-rule.week-day-5 no-undo .
       17   define input parameter  p-week-day-6        like ub.dis-time-rule.week-day-6 no-undo .
       18   define input parameter  p-week-day-7        like ub.dis-time-rule.week-day-7 no-undo .
       19   define input parameter  p-upper-time-rule-num    like ub.dis-time-rule.upper-time-rule-num    no-undo .
       20   define input parameter  p-value-type        like ub.dis-time-rule.value-type        no-undo .
       21   define temp-table tt0-term_dis-time-rule no-undo like ub.dis-time-rule.
       22   DEFINE INPUT PARAMETER TABLE FOR tt0-term_dis-time-rule.
       23   define input-output parameter p-recid as recid no-undo.
       24   define input parameter p-mode                         as character no-undo .
       25   define input parameter p-silent                       as logical no-undo .
       26   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       27   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       28   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       29   define variable vss-workfile    as character no-undo init "$Workfile: dis-tim1.p $":U .
       30   define variable vss-archive     as character no-undo init "$Archive: ref/dis-tim1.p $":U .
       31   define variable vss-description as character no-undo init "Сохранение изменений в расписаниях".
       32   procedure vss-get-info :
       33     define output parameter p-vss-revision    like vss-revision    no-undo .
       34     define output parameter p-vss-author      like vss-author      no-undo .
       35     define output parameter p-vss-date        like vss-date        no-undo .
       36     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       37     define output parameter p-vss-archive     like vss-archive     no-undo .
       38     define output parameter p-vss-description like vss-description no-undo .
       39     assign
       40       p-vss-revision    = vss-revision
       41       p-vss-author      = vss-author
       42       p-vss-date        = vss-date
       43       p-vss-workfile    = vss-workfile
       44       p-vss-archive     = vss-archive
       45       p-vss-description = vss-description
       46     .
       47   end procedure.
       48   procedure vss-get-parameters :
       49     define output parameter p-vss-parameters as character no-undo .
       50   end procedure.
       51   define new global shared variable g#vssrevis-logger as handle    no-undo .
       52   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       53   define variable v-vssrevis-logger                   as handle    no-undo .
       54   procedure vss-logevent :
       55     define input  parameter p-extra-paramters as character no-undo .
       56     define variable v-vssrevis-parameters as character no-undo .
       57     do
       58     on error undo, return error return-value
       59     :
       60       if  valid-handle(v-vssrevis-logger)
       61       and v-vssrevis-logger :get-signature("logevent") <> ""
       62       then do:
       63         run vss-get-parameters in this-procedure
       64           (output v-vssrevis-parameters
       65           ).
       66         run logevent in v-vssrevis-logger
       67           (input vss-workfile
       68           ,input vss-revision
       69           ,input v-vssrevis-parameters
       70           ,input p-extra-paramters
       71           ).
       72       end.
       73     end.
       74   end procedure.
       75   assign
       76     v-vssrevis-logger = g#vssrevis-logger
       77   .
       78   if  valid-handle(v-vssrevis-logger)
       79   and v-vssrevis-logger :get-signature("logevent") <> ""
       80   then do:
       81     assign
       82       v-vssrevis-logevent = true
       83     .
       84     run vss-logevent in this-procedure (input vss-description) .
       85   end.
       86   define new global shared variable g#language as character no-undo .
       87   if g#language <> '' and g#language <> 'rus':U then do:
       88     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       89   end.
       90   define new global shared variable g#library  as handle no-undo .
       91   define new global shared variable g#library2 as handle no-undo .
       92   define   shared variable g#auto as logical no-undo.
       93   define   shared variable g#news as logical no-undo.
       94   define   shared variable g#oxml as logical no-undo.
       95   define   shared variable g#esys as logical no-undo.
       96   define   shared variable g#news-source-db as integer no-undo.
       97   define   shared variable g#esys-source-esys as integer no-undo.
       98   define   shared variable g#db-num as integer   no-undo .
       99   define   shared variable g#userid as character no-undo .
      100   define   shared variable g#passwd as character no-undo .
      101   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      102   procedure dtr-code :
      103     do
      104     on error undo, return error
      105     :
      106       define input  parameter  p-templ-rl-root     like ub.dis-time-rule.templ-rl-root     no-undo .
      107       define output parameter  p-des               like ub.dis-time-rule.des               no-undo .
      108       define output parameter  p-upper-time-rule-num    like ub.dis-time-rule.upper-time-rule-num    no-undo .
      109       define output parameter  p-value-type        like ub.dis-time-rule.value-type        no-undo .
      110       define output parameter  p-level-1 as character no-undo .
      111       define output parameter  p-level-2 as character no-undo .
      112       define output parameter  p-output-display as logical   no-undo .
      113       define output parameter  p-tree           as char  no-undo .
      114       define output parameter  p-other          as character no-undo .
      115       define variable v-templ-rl-root like ub.dis-time-rule.templ-rl-root no-undo .
      116       define buffer buf_dis-time-rule for ub.dis-time-rule .
      117       define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      118       if p-templ-rl-root < 50000 then
      119       v-templ-rl-root = (p-templ-rl-root + 50000).
      120       else v-templ-rl-root = p-templ-rl-root.
      121       find first buf_dis-time-rule no-lock where
      122                 buf_dis-time-rule.time-rule-num = v-templ-rl-root no-error .
      123       if not available buf_dis-time-rule then do:
      124         undo, return error substitute("неизвестный тип расписания &1", p-templ-rl-root) .
      125       end.
      126       find first buf_dis-cfg-rule no-lock where
      127               buf_dis-cfg-rule.templ-rl-root = 0
      128           and buf_dis-cfg-rule.time-templ-rl-root = p-templ-rl-root
      129           and buf_dis-cfg-rule.pos-type = '':U
      130           and buf_dis-cfg-rule.table-name = '':U
      131           and buf_dis-cfg-rule.discnt-role = '':U
      132           and buf_dis-cfg-rule.self-nonunique = '':U
      133               no-error.
      134       if not available buf_Dis-cfg-rule then do:
      135           undo, return error substitute("неизвестный тип расписания &1", p-templ-rl-root ).
      136       end.
      137       assign
      138       p-des = buf_dis-time-rule.des
      139       p-upper-time-rule-num = (buf_dis-time-rule.upper-time-rule-num - 50000)
      140       p-value-type = buf_dis-time-rule.value-type
      141       p-level-1 = entry(1, buf_dis-cfg-rule.other-inf, ";":U)
      142       p-level-2 = (if num-entries(buf_dis-cfg-rule.other-inf, ";":U) > 1
      143                    then entry(2, buf_dis-cfg-rule.other-inf, ";":U)
      144                    else '')
      145       p-output-display = (buf_dis-time-rule.sts = integer('0':U))
      146       p-tree = buf_dis-time-rule.uniq-field
      147       p-other = buf_dis-time-rule.other-inf
      148       .
      149     end.
      150   end procedure.
      151   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      152   procedure dr-code :
      153     do
      154     on error undo, return error
      155     :
      156       define input  parameter  p-templ-rl-root     like ub.dis-rule.templ-rl-root     no-undo .
      157       define output parameter  p-des               like ub.dis-rule.des               no-undo .
      158       define output parameter  p-discnt-type       like ub.dis-rule.discnt-type       no-undo .
      159       define output parameter  p-subject-type      like ub.dis-rule.subject-type      no-undo .
      160       define output parameter  p-value-type        like ub.dis-rule.value-type        no-undo .
      161       define output parameter  p-level-1           as character no-undo .
      162       define output parameter  p-level-2           as character no-undo .
      163       define output parameter  p-global             as integer no-undo .
      164       define output parameter  p-host               as integer no-undo .
      165       define output parameter  p-object             as integer no-undo .
      166       define output parameter  p-output-display as logical   no-undo .
      167       define output parameter  p-tree           as char  no-undo .
      168       define output parameter  p-other          as character no-undo .
      169       define variable v-other as character no-undo .
      170       define buffer buf_dis-rule for ub.dis-rule .
      171       define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      172       find first buf_dis-rule no-lock where
      173                 buf_dis-rule.rule-num = p-templ-rl-root no-error.
      174       find first buf_dis-cfg-rule no-lock where
      175               buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
      176           and buf_dis-cfg-rule.pos-type = '':U
      177           and buf_dis-cfg-rule.table-name = '':U
      178           and buf_dis-cfg-rule.discnt-role = '':U
      179           and buf_dis-cfg-rule.self-nonunique = '':U
      180               no-error.
      181       if not available buf_Dis-cfg-rule then do:
      182           undo, return error substitute("неизвестный шаблон скидки &1", p-templ-rl-root ).
      183       end.
      184       assign
      185       p-des = buf_dis-rule.des
      186       p-discnt-type = buf_dis-rule.discnt-type
      187       p-subject-type = buf_dis-rule.subject-type
      188       p-value-type = buf_dis-rule.value-type
      189       p-global = (if available buf_dis-cfg-rule
      190                   then buf_dis-cfg-rule.has-global
      191                   else 0)
      192       p-host = (if available buf_dis-cfg-rule
      193                 then buf_dis-cfg-rule.has-host
      194                 else 0)
      195       p-object = (if available buf_dis-cfg-rule
      196                 then buf_dis-cfg-rule.has-obj
      197                 else 0)
      198       p-output-display = (buf_dis-rule.sts = integer('0':U))
      199       p-tree = buf_Dis-rule.uniq-field
      200       p-other = buf_dis-rule.other-inf
      201       p-level-1 = entry(1, buf_dis-cfg-rule.other-inf, ";":U)
      202       p-level-2 = (if num-entries(buf_dis-cfg-rule.other-inf, ";":U) > 1
      203                    then entry(2, buf_dis-cfg-rule.other-inf, ";":U)
      204                    else '')
      205       .
      206     end.
      207   end procedure.
      208   define temp-table temp-drt-prop no-undo like ub.drt-prop.
      209   procedure disrules-fill-properties:
      210   define input  parameter p-templ-rl-root as integer   no-undo .
      211   define buffer buf_drt-prop for ub.drt-prop.
      212   define buffer buf_temp-drt-prop for temp-drt-prop.
      213   do
      214   on error undo, return error return-value
      215   :
      216     for each buf_temp-drt-prop:
      217       delete buf_temp-drt-prop.
      218     end.
      219     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
      220       create buf_temp-drt-prop.
      221       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      222     end.
      223   end.
      224   end procedure.
      225   procedure disrules-get-interface-form :
      226   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
      227   define output parameter p-form-name as character no-undo .
      228   define buffer buf_temp-drt-prop for temp-drt-prop.
      229   define buffer buf_drt-prop for ub.drt-prop.
      230   find first buf_temp-drt-prop where
      231             buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
      232         and buf_temp-drt-prop.upper-prop-code = "InputForm"
      233         and buf_temp-drt-prop.prop-code = "FormName" no-error.
      234   if not available buf_temp-drt-prop then do:
      235     find first buf_drt-prop where
      236               buf_drt-prop.templ-rl-root = p-templ-rl-root
      237           and buf_drt-prop.upper-prop-code = "InputForm"
      238           and buf_drt-prop.prop-code = "FormName" no-error.
      239     if available buf_drt-prop then do:
      240       p-form-name = buf_drt-prop.property-value.
      241     end.
      242     else do:
      243       p-form-name = "ref/dis-ruli.w".
      244     end.
      245   end.
      246   else do:
      247     p-form-name = buf_temp-drt-prop.property-value.
      248   end.
      249   end procedure.
      250   ~
      251   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      252   procedure gen-b-code :
      253     define input  parameter type-code like ub.code-range.range-type no-undo .
      254     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
      255     do
      256     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      257     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
      258     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
      259     :
      260       define buffer buf_thbj-attr     for ub.thbj-attr .
      261       define buffer buf_sys-ctrl   for ub.sys-ctrl .
      262       define buffer buf_code-range for ub.code-range .
      263       define variable l-code         as   integer              no-undo .
      264       define variable v-db-num       like ub.db.db-num         no-undo .
      265       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      266       if type-code = 'sslc':U
      267       or type-code = 'ssgb':U
      268       then do:
      269         message
      270           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      271           "Обратитесь к администратору системы."
      272           view-as alert-box error .
      273         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
      274       end.
      275       run trg/getpcode.p ( input  type-code
      276                      ,output cfg-param-code
      277                     ).
      278       run get-next-seq( input  type-code,
      279                         output l-code
      280                       ).
      281       find first buf_sys-ctrl no-lock.
      282       if type-code = 'sclc':U
      283       or type-code = 'pglc':U
      284       then do:
      285         assign
      286           v-db-num = 0
      287         .
      288       end.
      289       else do:
      290         assign
      291           v-db-num = buf_sys-ctrl.db-num
      292         .
      293       end.
      294       find first buf_code-range no-lock
      295         where buf_code-range.db-num     = v-db-num
      296           and buf_code-range.range-type = type-code
      297           and buf_code-range.stts       = "a"
      298         use-index stts
      299         no-error .
      300       if available buf_code-range
      301          and l-code <= buf_code-range.last-code
      302          and l-code >= buf_code-range.first-code then do:
      303         assign
      304           p-b-code = l-code
      305         .
      306       end.
      307       else do:
      308         if available buf_code-range
      309            and l-code < buf_code-range.last-code then do:
      310           message
      311             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      312             "Обратитесь к администратору системы."
      313             view-as alert-box error .
      314           undo, return error "sequence":U .
      315         end.
      316         do transaction
      317         on error undo, return error
      318         :
      319           find first buf_thbj-attr exclusive-lock
      320             where buf_thbj-attr.upper-prop-code = 'code-range':U
      321               and buf_thbj-attr.prop-code = cfg-param-code
      322               and buf_thbj-attr.obj-type   = 'БД':U
      323               and buf_thbj-attr.obj-code   = v-db-num
      324             no-error .
      325           if not available buf_thbj-attr then do:
      326             find first buf_thbj-attr exclusive-lock
      327               where buf_thbj-attr.upper-prop-code = 'code-range':U
      328                 and buf_thbj-attr.prop-code = cfg-param-code
      329                 and buf_thbj-attr.obj-type   = ''
      330                 and buf_thbj-attr.obj-code   = 0
      331               no-error .
      332             if not available buf_thbj-attr then do:
      333               if not locked buf_thbj-attr then do:
      334                 message
      335                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      336                   "Обратитесь к администратору системы."
      337                   view-as alert-box error .
      338               end.
      339               undo, return error "config":U .
      340             end.
      341           end.
      342           run get-next-seq( input type-code,
      343                             output l-code
      344                           ).
      345           find first buf_code-range
      346             where buf_code-range.db-num     = v-db-num
      347               and buf_code-range.range-type = type-code
      348               and buf_code-range.stts       = "a"
      349             use-index stts
      350             no-error .
      351           if available buf_code-range
      352           and l-code <= buf_code-range.last-code
      353           and l-code >= buf_code-range.first-code
      354           then do:
      355             assign
      356               p-b-code = l-code
      357             .
      358           end.
      359           else do:
      360             if available buf_code-range then do:
      361               assign
      362                 buf_code-range.stts = "u"
      363               .
      364             end.
      365             find first buf_code-range
      366               where buf_code-range.db-num     = v-db-num
      367                 and buf_code-range.range-type = type-code
      368                 and buf_code-range.stts       = "f"
      369               use-index stts
      370               no-error .
      371             if not available buf_code-range then do:
      372               message
      373                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      374                 "Обратитесь к администратору системы"
      375                 view-as alert-box error .
      376               undo, return error "code-range":U .
      377             end.
      378             assign
      379               buf_code-range.stts           = "a"
      380             .
      381             if buf_code-range.first-code = 1 then do:
      382               run set-seq-cr( input type-code,
      383                               input buf_code-range.first-code
      384                             ).
      385               assign
      386                 p-b-code = 1
      387               .
      388             end.
      389             else do:
      390               run set-seq-cr( input type-code,
      391                               input ( buf_code-range.first-code - 1 )
      392                             ).
      393               run get-next-seq( input type-code,
      394                                 output p-b-code
      395                               ).
      396             end.
      397           end.
      398         end.
      399       end.
      400     end.
      401   end procedure.
      402   procedure get-next-seq :
      403     define input  parameter type-code like ub.code-range.range-type no-undo .
      404     define output parameter next-seq  as   integer                  no-undo .
      405     do
      406     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      407     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      408     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      409     :
      410       case type-code:
      411         when 'bcgb':U then do:
      412           assign
      413             next-seq = next-value(s-bcgb-code, ub)
      414           .
      415         end.
      416         when 'scgb':U then do:
      417           assign
      418             next-seq = next-value(s-scgb-code, ub)
      419           .
      420         end.
      421         when 'sclc':U then do:
      422           assign
      423             next-seq = next-value(s-sclc-code, ub)
      424           .
      425         end.
      426         when 'pglc':U then do:
      427           assign
      428             next-seq = next-value(s-pglc-code, ub)
      429           .
      430         end.
      431         when 'dcgb':U then do:
      432           assign
      433             next-seq = next-value(s-dcgb-code, ub)
      434           .
      435         end.
      436         when 'ctgb':U then do:
      437           assign
      438             next-seq = next-value(s-ctgb-code, ub)
      439           .
      440         end.
      441         when 'drgb':U then do:
      442           assign
      443             next-seq = next-value(s-drgb-code, ub)
      444           .
      445         end.
      446         when 'fmgb':U then do:
      447           assign
      448             next-seq = next-value(s-fmgb-code, ub)
      449           .
      450         end.
      451         when 'pngb':U then do:
      452           assign
      453             next-seq = next-value(s-pngb-code, ub)
      454           .
      455         end.
      456         when 'cagb':U then do:
      457           assign
      458             next-seq = next-value(s-cagb-code, ub)
      459           .
      460         end.
      461         when 'fdgb':U then do:
      462           assign
      463             next-seq = next-value(s-fin-doc, ub)
      464           .
      465         end.
      466       end case.
      467     end.
      468   end procedure.
      469   procedure set-seq-cr :
      470     define input parameter type-code like ub.code-range.range-type no-undo .
      471     define input parameter set-val   like ub.code-range.first-code no-undo .
      472     do
      473     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      474     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      475     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      476     :
      477       case type-code:
      478         when 'bcgb':U then do:
      479           assign
      480             current-value(s-bcgb-code, ub) = set-val
      481           .
      482         end.
      483         when 'scgb':U then do:
      484           assign
      485             current-value(s-scgb-code, ub) = set-val
      486           .
      487         end.
      488         when 'sclc':U then do:
      489           assign
      490             current-value(s-sclc-code, ub) = set-val
      491           .
      492         end.
      493         when 'pglc':U then do:
      494           assign
      495             current-value(s-pglc-code, ub) = set-val
      496           .
      497         end.
      498         when 'dcgb':U then do:
      499           assign
      500             current-value(s-dcgb-code, ub) = set-val
      501           .
      502         end.
      503         when 'ctgb':U then do:
      504           assign
      505             current-value(s-ctgb-code, ub) = set-val
      506           .
      507         end.
      508         when 'drgb':U then do:
      509           assign
      510             current-value(s-drgb-code, ub) = set-val
      511           .
      512         end.
      513         when 'fmgb':U then do:
      514           assign
      515             current-value(s-fmgb-code, ub) = set-val
      516           .
      517         end.
      518         when 'pngb':U then do:
      519           assign
      520             current-value(s-pngb-code, ub) = set-val
      521           .
      522         end.
      523         when 'cagb':U then do:
      524           assign
      525             current-value(s-cagb-code, ub) = set-val
      526           .
      527         end.
      528         when 'fdgb':U then do:
      529           assign
      530             current-value(s-fin-doc, ub) = set-val
      531           .
      532         end.
      533       end case.
      534     end.
      535   end procedure.
      536   procedure new-bcod-gen-code-range :
      537     do
      538     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      539     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      540     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      541     :
      542       define input parameter p-db-num  like ub.db.db-num             no-undo .
      543       define input parameter type-code like ub.code-range.range-type no-undo .
      544       define buffer buf_code-range      for ub.code-range .
      545       define buffer last_code-range     for ub.code-range .
      546       define buffer last-1_code-range   for ub.code-range .
      547       define buffer last-2_code-range   for ub.code-range .
      548       define buffer last-3_code-range   for ub.code-range .
      549       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      550       define variable conf-par       as character no-undo .
      551       define variable par-type       as character no-undo .
      552       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      553       define variable v-cre-cdrg as logical   no-undo .
      554       define variable v-cre-str  as character no-undo .
      555       define variable v-cr1      as integer no-undo .
      556       define variable v-cr2      as integer no-undo .
      557       define variable v-cr3      as integer no-undo .
      558       define variable v-cmax     as integer no-undo .
      559       find first buf_sys-ctrl no-lock .
      560       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      561         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      562                                       ,vss-workfile
      563                                       ,vss-revision
      564                                       ,vss-description
      565                                       ,chr(10)
      566                                       , p-db-num
      567                                      ).
      568       end.
      569       run trg/getpcode.p ( input  type-code
      570                      ,output cfg-param-code
      571                     ).
      572       for each buf_code-range
      573         where buf_code-range.db-num     = -1
      574           and buf_code-range.range-type = type-code
      575           and buf_code-range.stts       = "f"
      576       by buf_code-range.first-code
      577       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      578       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      579       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      580       :
      581         assign
      582           buf_code-range.db-num = p-db-num
      583         .
      584         return .
      585       end.
      586       assign
      587         v-cre-cdrg = TRUE
      588       .
      589       case type-code:
      590         when 'sclc':U
      591         or when 'scgb':U
      592         or when 'pglc':U
      593         then do:
      594           find last last-1_code-range no-lock
      595             where last-1_code-range.range-type = 'sclc':U
      596             no-error .
      597           if available last-1_code-range then do:
      598             v-cr1 = last-1_code-range.last-code.
      599           end.
      600           find last last-2_code-range no-lock
      601             where last-2_code-range.range-type = 'scgb':U
      602             no-error .
      603           if available last-2_code-range then do:
      604             v-cr2 = last-2_code-range.last-code.
      605             end.
      606           find last last-3_code-range no-lock
      607             where last-3_code-range.range-type = 'pglc':U
      608             no-error .
      609           if available last-3_code-range then do:
      610             v-cr3 = last-3_code-range.last-code.
      611           end.
      612           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      613           .
      614           if v-cmax = v-cr1  then do:
      615               find last last_code-range no-lock
      616                 where recid( last_code-range ) = recid( last-1_code-range )
      617                 .
      618             end.
      619           if v-cmax = v-cr2  then do:
      620               find last last_code-range no-lock
      621                 where recid( last_code-range ) = recid( last-2_code-range )
      622                 .
      623             end.
      624           if v-cmax = v-cr3  then do:
      625             find last last_code-range no-lock
      626               where recid( last_code-range ) = recid( last-3_code-range )
      627               .
      628           end.
      629           if last_code-range.last-code + 1 > 99999 then do:
      630             assign
      631               v-cre-cdrg = FALSE
      632             .
      633           end.
      634         end.
      635         when 'bcgb':U
      636         or when 'sslc':U
      637         or when 'ssgb':U
      638         then do:
      639           find last last-1_code-range no-lock
      640             where last-1_code-range.range-type = 'sslc':U
      641             no-error .
      642           if available last-1_code-range then do:
      643             v-cr1 = last-1_code-range.last-code.
      644           end.
      645           find last last-2_code-range no-lock
      646             where last-2_code-range.range-type = 'bcgb':U
      647             no-error .
      648           if available last-2_code-range then do:
      649             v-cr2 = last-2_code-range.last-code.
      650             end.
      651           find last last-3_code-range no-lock
      652             where last-3_code-range.range-type = 'ssgb':U
      653             no-error .
      654           if available last-3_code-range then do:
      655             v-cr3 = last-3_code-range.last-code.
      656           end.
      657           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      658           .
      659           if v-cmax = v-cr1  then do:
      660               find last last_code-range no-lock
      661                 where recid( last_code-range ) = recid( last-1_code-range )
      662                 .
      663             end.
      664           if v-cmax = v-cr2  then do:
      665               find last last_code-range no-lock
      666                 where recid( last_code-range ) = recid( last-2_code-range )
      667                 .
      668             end.
      669           if v-cmax = v-cr3  then do:
      670             find last last_code-range no-lock
      671               where recid( last_code-range ) = recid( last-3_code-range )
      672               .
      673           end.
      674         end.
      675         otherwise do:
      676           find last last_code-range no-lock
      677             where last_code-range.range-type = type-code
      678             no-error .
      679         end.
      680       end case.
      681       if not available last_code-range then do:
      682         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      683                                       ,vss-workfile
      684                                       ,vss-revision
      685                                       ,vss-description
      686                                       , chr(10)
      687                                       , type-code
      688                                      ) .
      689       end.
      690       define variable v-mes2 as character no-undo .
      691       define variable v-param-type2 as character no-undo .
      692       define variable v-value-character2 as INTEGER no-undo .
      693       define variable v-value-date2 as date no-undo .
      694       define variable v-value-decimal2 as decimal no-undo .
      695       define variable v-value-integer2 AS integer no-undo .
      696       define variable v-value-logical2 AS LOGICAL no-undo .
      697       define variable v-tth2 as handle no-undo .
      698       run adm/shattri.p (
      699           input "get":U
      700           ,input  'БД':U
      701           ,input  p-db-num
      702           ,input  'code-range':U
      703           ,input  cfg-param-code
      704           ,output v-value-character2
      705           ,output v-value-date2
      706           ,output v-value-decimal2
      707           ,output v-value-integer2
      708           ,output v-value-logical2
      709           ,output v-param-type2
      710           ,INPUT-OUTPUT table-handle v-tth2
      711           ) no-error .
      712       if error-status :error then do:
      713         delete object v-tth2.
      714         v-mes2 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      715                            , error-status:get-message(1)
      716                            , chr(10)
      717                            , return-value ).
      718         undo, return error v-mes2.
      719       end.
      720       delete object v-tth2.
      721       if v-cre-cdrg = TRUE then do:
      722         create buf_code-range .
      723         assign
      724           buf_code-range.db-num     = p-db-num
      725           buf_code-range.range-type = type-code
      726           buf_code-range.stts       = "f"
      727           buf_code-range.first-code = last_code-range.last-code + 1
      728           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer2)
      729           v-cre-str = "Свободный диапазон успешно создан"
      730         .
      731       end.
      732       else do:
      733         assign
      734           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
      735                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
      736         .
      737       end.
      738     end.
      739     return v-cre-str .
      740   end procedure.
      741   procedure gen-new-code-range-if-neces :
      742     define input parameter v-db-num           like ub.db.db-num             no-undo .
      743     define input parameter v-range-type       like ub.code-range.range-type no-undo .
      744     define input parameter v-cur-code         as   integer                  no-undo .
      745     define input parameter v-g#news           as   logical                  no-undo .
      746     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
      747     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
      748     do
      749     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      750     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
      751     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
      752     :
      753       define variable l-code-range-exist as logical   no-undo init false .
      754       define variable v-db-for-send      as character no-undo .
      755       define buffer buf_code-range  for ub.code-range .
      756       define buffer buf1_code-range for ub.code-range .
      757       define buffer buf_db          for ub.db .
      758       find first buf_code-range
      759         where buf_code-range.range-type = v-range-type
      760           and buf_code-range.last-code >= v-cur-code
      761         use-index last-codei
      762         no-error .
      763       if
      764       (
      765          available buf_code-range
      766          and
      767         (buf_code-range.db-num = v-db-num
      768           and
      769         buf_code-range.first-code <= v-cur-code
      770         )
      771       or
      772         (
      773           v-range-type = 'drgb':U
      774           AND
      775           v-cur-code = 0
      776         )
      777      )
      778      then do:
      779         assign
      780           l-code-range-exist = true
      781         .
      782         if v-g#news
      783         and buf_code-range.stts = "f" then do:
      784           assign
      785             buf_code-range.stts = "u"
      786           .
      787         end.
      788       end.
      789       if not l-code-range-exist
      790          and v-g#news-source-db <> 0
      791       then do:
      792         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
      793                                       ,vss-workfile
      794                                       ,vss-revision
      795                                       ,vss-description
      796                                       ,chr(10)
      797                                       ,v-db-num
      798                                       ,v-range-type
      799                                       ,v-cur-code
      800                                      ).
      801       end.
      802       if (not l-code-range-exist
      803           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
      804          )
      805       and ( not can-find (first buf1_code-range no-lock
      806                           where buf1_code-range.db-num = v-db-num
      807                             and buf1_code-range.range-type = v-range-type
      808                             and buf1_code-range.stts = "f"
      809                          )
      810           )
      811       then do:
      812         if v-g#db-num = 0 then do:
      813           run new-bcod-gen-code-range in this-procedure
      814             (input v-db-num,
      815              input v-range-type
      816             ) no-error .
      817           if error-status :error then do:
      818             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
      819                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
      820                                           ,v-db-num
      821                                           ,v-range-type
      822                                           ,v-cur-code
      823                                           ,chr(10)
      824                                           ,error-status:get-message(1)
      825                                           ,return-value
      826                                          ).
      827           end.
      828         end.
      829         else do:
      830           if v-range-type = 'sclc':U
      831           or v-range-type = 'pglc':U
      832           then do:
      833             assign
      834               v-db-for-send = "":U
      835             .
      836             if v-g#db-num = 0 then do:
      837               for each buf_db no-lock
      838                 where buf_db.db-num > 0
      839                   and buf_db.db-num <> v-g#news-source-db
      840               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      841               :
      842                 assign
      843                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
      844                 .
      845               end.
      846               assign
      847                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
      848               .
      849             end.
      850             else do:
      851               if not v-g#news then do:
      852                 assign
      853                   v-db-for-send = "0":U
      854                 .
      855               end.
      856             end.
      857             run nws/cr-route.p ( input 'send-cmd':U
      858                           ,input ("command":U + chr(1) + "create":U + chr(1) +
      859                                  "code-range":U + chr(1) +
      860                                  (if v-range-type = 'sclc':U
      861                                   then string( current-value(s-sclc-code, ub))
      862                                   else string( current-value(s-pglc-code, ub))
      863                                   ) + chr(1) +
      864                                   v-range-type)
      865                           ,input ?
      866                           ,input v-db-for-send
      867                           ) no-error .
      868             if error-status :error then do:
      869               undo, return error return-value.
      870             end.
      871           end.
      872         end.
      873       end.
      874     end.
      875   end procedure.
      876   procedure cre-loc-sc-code-range :
      877     define input parameter v-cur-code as integer no-undo .
      878   define input parameter p-cdrg-type as character no-undo .
      879     do
      880     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      881     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
      882     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
      883     :
      884       define buffer buf_code-range for ub.code-range .
      885       find first buf_code-range
      886            where buf_code-range.range-type = p-cdrg-type
      887              and buf_code-range.first-code >= v-cur-code
      888            no-error .
      889       if not available buf_code-range then do:
      890         run new-bcod-gen-code-range in this-procedure
      891           ( input 0,
      892             input p-cdrg-type
      893           ) no-error .
      894         if error-status :error then do:
      895           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
      896                                          + "Код &2&1&3 &4"
      897                                         , chr(10)
      898                                         , v-cur-code
      899                                         , error-status:get-message(1)
      900                                         , return-value
      901                                        ) .
      902         end.
      903       end.
      904     end.
      905   end procedure.
      906   procedure mark-used-if-need :
      907   define input parameter p-cur-code as integer no-undo .
      908   define input parameter p-range-type like ub.code-range.range-type no-undo .
      909   define input parameter p-db-num like ub.code-range.db-num no-undo .
      910     do
      911     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      912     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
      913     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
      914     :
      915       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
      916       define buffer buf_code-range for ub.code-range .
      917       assign
      918       v-db-num = if p-range-type = 'sclc':U
      919                  then 0
      920                  else p-db-num
      921       .
      922   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      923   define buffer locK-batchprocess3 for ub.batchprocess.
      924   run gbl/lock-prc.p
      925       (input 'lscc':U
      926       ,input 0
      927       ,input 0
      928       ,input 0
      929       ,input ""
      930       ,input ""
      931       ,input ""
      932       ,input (
      933               ",,,Вкл/выкл лок. вес. кодов"
      934              )
      935       ,input true
      936       ,buffer lock-batchprocess3
      937       ) no-error .
      938     if error-status :error then do:
      939       message
      940         vss-workfile vss-revision vss-description skip
      941         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
      942         view-as alert-box error .
      943       undo, return error .
      944     end.
      945       find first buf_code-range
      946            where buf_code-range.range-type = p-range-type
      947              and buf_code-range.first-code >= p-cur-code
      948              and buf_code-range.last-code <= p-cur-code
      949              and buf_code-range.db-num = v-db-num
      950            no-error .
      951       if not available buf_code-range then do:
      952         message
      953           vss-workfile vss-revision vss-description skip
      954           "Ошибка при создании поиске диапазона" skip
      955           "База данных" p-db-num skip
      956           "Код" p-cur-code skip
      957           "Тип" p-range-type
      958           error-status :get-message(1) skip
      959           return-value skip
      960           view-as alert-box error .
      961         undo, return error .
      962       end.
      963       if buf_code-range.stts = "f":U then do:
      964         assign
      965         buf_code-range.stts = "u":U
      966         .
      967       end.
      968     end.
      969   end procedure.
      970   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      971   FUNCTION gtregion RETURNS CHARACTER
      972     ( input parhost-code as integer
      973     , input parobj-type as character
      974     , input parobj-code as integer
      975     , input p-tab as logical
      976     ) :
      977     def var par-region as character no-undo.
      978     if parhost-code = 0 and
      979          parobj-type = "":U and
      980          parobj-code = 0 then do:
      981          par-region = "Глобально".
      982          return par-region.
      983       end.
      984       if parobj-type = "" and
      985          parobj-code = 0 then do:
      986          par-region = if p-tab then fill(chr(32), 2) else "":U +
      987                       "Фирма" + chr(32) + string(parhost-code).
      988          return par-region.
      989       end.
      990       par-region = if p-tab then fill(chr(32), 4) else "":U +
      991                    parobj-type + chr(32) + string(parobj-code).
      992       return par-region.
      993   END FUNCTION.
      994   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      995   define variable v-waitfram-action01         as character   no-undo .
      996   define variable v-waitfram-action02         as character   no-undo .
      997   define variable v-waitfram-action03         as character   no-undo .
      998   define variable mWaitFramTextBeg            as character   no-undo.
      999   define variable mWaitFramTextEnd            as character   no-undo.
     1000   define variable mWaitFramView               as logical     no-undo.
     1001   define variable mWaitProcEvent              as logical     no-undo init yes.
     1002   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1003   define variable mWaitFramStop               as logical     no-undo.
     1004   define variable mWaitFramStopUser           as logical     no-undo.
     1005   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1006   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1007   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1008   define button B-WaitFramStop auto-end-key
     1009        label "Стоп"
     1010        size 10 by 1 tooltip "Остоновить процесс".
     1011   define button B-viewProcInfo
     1012        label "Информация"
     1013        size 15 by 1 tooltip "Информация о процесс".
     1014   define frame waitfram
     1015     v-waitfram-action01 format "x(72)" no-label skip
     1016     v-waitfram-action02 format "x(72)" no-label skip
     1017     v-waitfram-action03 format "x(72)" no-label skip
     1018     B-viewProcInfo
     1019     B-WaitFramStop at row 4 col 30
     1020     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1021     .
     1022   define new global shared variable mBatchMode as logical no-undo init ?.
     1023   define variable mFramBachModHandle as handle no-undo.
     1024   mFramBachModHandle = frame waitfram:handle.
     1025   define variable mFameOldVis as logical no-undo.
     1026   define variable mVisCUrentVin as logical no-undo.
     1027   if session:batch-mode
     1028   then
     1029      mBatchMode = yes.
     1030   if mBatchMode = ? then do:
     1031     mVisCUrentVin = current-window:visible.
     1032     mFameOldVis = mFramBachModHandle:visible.
     1033     mFramBachModHandle:visible  = yes.
     1034     mBatchMode = mFramBachModHandle:visible ne yes.
     1035     mFramBachModHandle:visible = mFameOldVis.
     1036     current-window:visible = mVisCUrentVin.
     1037   end.
     1038    if  log-manager:logfile-name ne ?
     1039     then DO:
     1040         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1041         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1042         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1043     end.
     1044   on choose of B-WaitFramStop in frame waitfram
     1045   do:
     1046     mWaitFramStop = yes.
     1047     mWaitFramStopUser = yes.
     1048   end.
     1049   function waitfram-check-timeout returns logical():
     1050      define variable vtime as int64 no-undo.
     1051      if mWaitFramStopTimeOut
     1052      then
     1053         return yes.
     1054      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1055      if     mWaitFramTimeOut ne ?
     1056         and mWaitFramTimeOut ne 0
     1057         and mWaitFramTimeOut lt vtime
     1058      then do:
     1059         mWaitFramStopTimeOut = yes.
     1060      end.
     1061      return mWaitFramStopTimeOut.
     1062   end.
     1063   procedure waitfram-hide :
     1064     if not session:batch-mode
     1065     then do
     1066     on error undo, return error return-value
     1067     :
     1068       pause 0 before-hide .
     1069       if not mBatchMode then
     1070         hide frame waitfram .
     1071     if     not mWaitFramView
     1072        and mWaitProcEvent
     1073     then
     1074       process events .
     1075     end.
     1076   end procedure.
     1077   procedure waitfram-show :
     1078     define input  parameter p-message as character no-undo .
     1079     define variable v-left-margin as integer   no-undo .
     1080     if not session:batch-mode
     1081     then do
     1082     on error undo, return error return-value
     1083     :
     1084       if length(p-message) <= 70 then do:
     1085         assign
     1086           v-left-margin = integer((70 - length(p-message)) / 2)
     1087         .
     1088         assign
     1089           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1090         .
     1091         assign
     1092           v-waitfram-action01 = " "
     1093           v-waitfram-action02 = " "
     1094                                    + fill(" ", v-left-margin)
     1095                                    + p-message
     1096           v-waitfram-action03 = " "
     1097         .
     1098       end.
     1099       else do:
     1100         define variable vRindex1 as integer no-undo.
     1101         define variable vRindex2 as integer no-undo.
     1102         vRindex1 = r-index(p-message," ",70).
     1103         if vRindex1 = 0
     1104         then
     1105            vRindex1 = 70.
     1106         if length(p-message)  <= vRindex1 + 70 then do:
     1107           assign
     1108             v-waitfram-action01 = " "
     1109             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1110             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1111           .
     1112         end.
     1113         else do:
     1114           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1115           if vRindex2 <= vRindex1
     1116           then
     1117              vRindex2 = vRindex1 + 70.
     1118           assign
     1119             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1120             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1121             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1122           .
     1123         end.
     1124       end.
     1125       B-viewProcInfo:visible   in frame waitfram = no.
     1126       B-viewProcInfo:sensitive in frame waitfram = no.
     1127       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1128       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1129       if  (   mWaitFramView
     1130          or  mWaitProcEvent)
     1131          and not mBatchMode
     1132       then
     1133          display
     1134             v-waitfram-action01 skip
     1135             v-waitfram-action02 skip
     1136             v-waitfram-action03 skip
     1137          with frame waitfram .
     1138       if     mWaitFramView
     1139          then do:
     1140             if     mWaitFramInterval ne ?
     1141                and not mBatchMode
     1142             then
     1143                wait-for go of frame waitfram pause mWaitFramInterval.
     1144          end.
     1145          else
     1146             if     mWaitProcEvent
     1147                and not mBatchMode
     1148             then
     1149                process events .
     1150     end.
     1151   end procedure.
     1152      procedure waitfram-show-this:
     1153         define input  parameter iInterval as int64 no-undo.
     1154         define variable vtime as int64 no-undo.
     1155         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1156         mWaitFramInterval = iInterval.
     1157         run waitfram-show (substitute("&1&2 &3&4" ,
     1158                                       mWaitFramTextBeg ,
     1159                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1160                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1161                                       mWaitFramTextEnd
     1162                                      )
     1163                           ).
     1164      end.
     1165      procedure WaitFramRunPause:
     1166         define input  parameter iInterval as dec no-undo.
     1167         define variable vStart  as datetime-tz no-undo.
     1168         define variable vend    as datetime-tz no-undo.
     1169         define variable vint as int64 no-undo.
     1170         define variable vOk as logical no-undo.
     1171         vStart = now.
     1172         vend   = vStart.
     1173         publish "WaitFramPause" (iInterval,output vOk).
     1174         vend   =  now.
     1175         vint = vend - vStart.
     1176         vint = iInterval - vint / 1000.
     1177         if     not mWaitFramStop
     1178            and (   vint > 0
     1179                 or (    not vOk
     1180                     and iInterval eq ?
     1181                     )
     1182                 )
     1183         then
     1184            run waitfram-show-this (iInterval).
     1185         vend   =  now.
     1186         vint = vend - vStart.
     1187         vint = iInterval - vint / 1000.
     1188         if     not mWaitFramStop
     1189            and vint > 0
     1190         then do:
     1191            run gbl/pause.p (vint * 1000).
     1192         end.
     1193         if iInterval ne ?
     1194         then
     1195            publish "WaitFramStop".
     1196         waitfram-check-timeout().
     1197      end.
     1198      procedure WaitFramWaitFor:
     1199         define input  parameter iInterval as dec no-undo.
     1200         assign
     1201            mWaitFramStartProc   = now
     1202            mWaitFramStopUser    = no
     1203            mWaitFramStopTimeOut = no
     1204         .
     1205         block-wait:
     1206         do while not mWaitFramStop:
     1207            run WaitFramRunPause (iInterval).
     1208            if  waitfram-check-timeout()
     1209            then do:
     1210               leave block-wait.
     1211            end.
     1212         end.
     1213         run waitfram-hide.
     1214      end.
     1215   procedure waitfram-join :
     1216     define input  parameter p-line-1  as character no-undo .
     1217     define input  parameter p-line-2  as character no-undo .
     1218     define input  parameter p-line-3  as character no-undo .
     1219     define output parameter p-message as character no-undo .
     1220     do
     1221     on error undo, return error return-value
     1222     :
     1223       assign
     1224         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1225                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1226                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1227       .
     1228     end.
     1229   end procedure.
     1230   function waitfram-join-function returns character
     1231     (input p-line-1 as character
     1232     ,input p-line-2 as character
     1233     ,input p-line-3 as character
     1234     ).
     1235     define variable v-message as character no-undo .
     1236     run waitfram-join in this-procedure
     1237       (input  p-line-1
     1238       ,input  p-line-2
     1239       ,input  p-line-3
     1240       ,output v-message
     1241       ) .
     1242     return v-message .
     1243   end function .
     1244   define variable v-db-num like ub.db.db-num no-undo .
     1245   define variable v-dr-code as character no-undo .
     1246   define variable  v-new-time-rule-num      like ub.dis-time-rule.time-rule-num          no-undo .
     1247   define variable  v-time-rule-num          like ub.dis-time-rule.time-rule-num          no-undo .
     1248   define variable  v-des               like ub.dis-time-rule.des               no-undo .
     1249   define variable  v-upper-time-rule-num    like ub.dis-time-rule.upper-time-rule-num    no-undo .
     1250   define variable  v-value-type        like ub.dis-time-rule.value-type        no-undo .
     1251   define variable  vt-level-1 as character no-undo .
     1252   define variable  vt-level-2 as character no-undo .
     1253   define variable  v-output-display    as logical   no-undo .
     1254   define variable  v-tree              as character no-undo .
     1255   define variable  v-other             as character no-undo .
     1256   define variable  v-dub               as logical no-undo .
     1257   define variable  v-entry             as character no-undo .
     1258   define variable ii as integer no-undo .
     1259   define variable jj as integer no-undo .
     1260   define variable v-curr-field as character no-undo .
     1261   define variable v-curr-field1 as character no-undo .
     1262   define variable v-curr-field2 as character no-undo .
     1263   define variable v-tree-field as logical no-undo extent 18.
     1264   define variable v-num-rec as integer no-undo extent 18.
     1265   define variable v-num-rec-sign as character no-undo extent 18.
     1266   define variable v-uniq-field as logical no-undo extent 18.
     1267   define variable v-gds-obj-attr as character no-undo .
     1268   define variable v-found as logical no-undo .
     1269   define variable v-str as character no-undo .
     1270   define variable v-changes as logical no-undo .
     1271   define variable v-run-cn as logical no-undo .
     1272   define variable v-field-label as character no-undo .
     1273   define buffer buf_temp-drt-prop for ub.drt-prop.
     1274   define buffer buf_sysconf  for ub.sysconf.
     1275   DEFINE BUFFER buf_clients-obj FOR ub.clients.
     1276   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     1277   define buffer buf_db for ub.db .
     1278   define buffer buf_dis-time-rule for ub.dis-time-rule.
     1279   define buffer buf_dis-rule for ub.dis-rule.
     1280   define buffer dub_dis-time-rule for ub.dis-time-rule.
     1281   define buffer term_dis-time-rule for ub.dis-time-rule.
     1282   define buffer dub_tt-dis-time-rule  for tt0-term_dis-time-rule.
     1283   define temp-table temp-dis-time-rule no-undo like ub.dis-time-rule.
     1284   define buffer check_dis-time-rule for temp-dis-time-rule.
     1285   FUNCTION get-week-day-num RETURNS integer (buffer buf_tt-dis-time-rule for tt0-term_dis-time-rule, input p-mode as character):
     1286   define variable v-correct as integer no-undo .
     1287   assign
     1288   v-correct = (if buf_tt-dis-time-rule.week-day-0 <> ? and p-mode = "week-day-a"
     1289               then (if buf_tt-dis-time-rule.week-day-0
     1290                     then (if p-mode = "week-day-c"
     1291                           then 128
     1292                           else 0)
     1293                     else 1
     1294                     )
     1295               else 0)     +
     1296               (if buf_tt-dis-time-rule.week-day-1 <> ?
     1297               then (if buf_tt-dis-time-rule.week-day-1
     1298                     then 1
     1299                     else 0)
     1300               else 0)     +
     1301               (if buf_tt-dis-time-rule.week-day-2 <> ?
     1302               then (if buf_tt-dis-time-rule.week-day-2
     1303                     then (if p-mode = "week-day-c"
     1304                           then  2
     1305                           else 0)
     1306                     else 0
     1307                    )
     1308               else 0)     +
     1309               (if buf_tt-dis-time-rule.week-day-3 <> ?
     1310               then (if buf_tt-dis-time-rule.week-day-3
     1311                     then (if p-mode = "week-day-c"
     1312                           then  4
     1313                           else 0)
     1314                     else 0
     1315                     )
     1316               else 0)     +
     1317               (if buf_tt-dis-time-rule.week-day-4 <> ?
     1318               then (if buf_tt-dis-time-rule.week-day-4
     1319                     then (if p-mode = "week-day-c"
     1320                           then  8
     1321                           else 0)
     1322                     else 0
     1323                     )
     1324               else 0)     +
     1325               (if buf_tt-dis-time-rule.week-day-5 <> ?
     1326               then (if buf_tt-dis-time-rule.week-day-5
     1327                     then (if p-mode = "week-day-c"
     1328                           then  16
     1329                           else 0)
     1330                     else 0
     1331                     )
     1332               else 0)     +
     1333               (if buf_tt-dis-time-rule.week-day-6 <> ?
     1334               then (if buf_tt-dis-time-rule.week-day-6
     1335                     then (if p-mode = "week-day-c"
     1336                           then  32
     1337                           else 0)
     1338                     else 0
     1339                     )
     1340               else 0)     +
     1341               (if buf_tt-dis-time-rule.week-day-7 <> ?
     1342               then (if buf_tt-dis-time-rule.week-day-7
     1343                     then (if p-mode = "week-day-c"
     1344                           then  64
     1345                           else 0)
     1346                     else 0
     1347                     )
     1348               else 0)
     1349   .
     1350   if v-correct <> 1 then return ?.
     1351   if buf_tt-dis-time-rule.week-day-0 <> ?
     1352   and p-mode = "week-day-a" then return 0.
     1353   if buf_tt-dis-time-rule.week-day-1 <> ?
     1354   then return 1.
     1355   if buf_tt-dis-time-rule.week-day-2 <> ?
     1356   then return 2.
     1357   if buf_tt-dis-time-rule.week-day-3 <> ?
     1358   then return 3.
     1359   if buf_tt-dis-time-rule.week-day-4 <> ?
     1360   then return 4.
     1361   if buf_tt-dis-time-rule.week-day-5 <> ?
     1362   then return 5.
     1363   if buf_tt-dis-time-rule.week-day-6 <> ?
     1364   then return 6.
     1365   if buf_tt-dis-time-rule.week-day-7 <> ?
     1366   then return 7.
     1367   END.
     1368   if p-mode <> 'ДОБАВЛЕНИЕ':U
     1369   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
     1370     message
     1371     vss-workfile vss-revision vss-description skip
     1372     "Неверный параметр p-mode" p-mode
     1373     view-as alert-box error .
     1374     undo, return error '':u.
     1375   end.
     1376   run dtr-code  in this-procedure (
     1377        input  p-templ-rl-root
     1378       ,output v-des
     1379       ,output v-upper-time-rule-num
     1380       ,output v-value-type
     1381       ,output vt-level-1
     1382       ,output vt-level-2
     1383       ,output v-output-display
     1384       ,output v-tree
     1385       ,output v-other
     1386                                  ) no-error .
     1387   if error-status:error then do:
     1388       run err-mess in this-procedure (substitute("Неверный номер шаблона для расписания: &1, &2", p-templ-rl-root, return-value)).
     1389       undo, return error "time-rule-num":U.
     1390   end.
     1391   run disrules-fill-properties in this-procedure ( input p-templ-rl-root).
     1392   do jj = 1 to num-entries("time-from,time-to,date-from,date-to,week-day-0,week-day-1,week-day-2,week-day-3,week-day-4,week-day-5,"  +                     "week-day-6,week-day-7,month-day,week-day-a,week-day-b,week-day-c,time-period,date-period"):
     1393     assign
     1394     v-curr-field = entry(jj, "time-from,time-to,date-from,date-to,week-day-0,week-day-1,week-day-2,week-day-3,week-day-4,week-day-5,"  +                     "week-day-6,week-day-7,month-day,week-day-a,week-day-b,week-day-c,time-period,date-period")
     1395     .
     1396     find first buf_temp-drt-prop where
     1397         buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
     1398     and buf_temp-drt-prop.upper-prop-code = "":U
     1399     and buf_temp-drt-prop.prop-code = v-curr-field + "=uniq" no-error .
     1400     if available buf_temp-drt-prop then do:
     1401       assign
     1402       v-uniq-field[jj] = yes
     1403       .
     1404     end.
     1405   end.
     1406   if p-mode = 'ИЗМЕНЕНИЕ':U
     1407   then do:
     1408     find first buf_db no-lock where
     1409               buf_db.db-num > 0 no-error.
     1410     if available buf_db then do:
     1411       run check-changes(
     1412                            input p-time-rule-num
     1413                           ,output v-changes) no-error .
     1414       if error-status:error
     1415       or v-changes then do:
     1416         run err-mess  in this-procedure (substitute("Т.к. в Системе имеются Удаленные БД,то можно менять только описания РАСПИСАНИЯ")).
     1417         undo, return error "":U.
     1418       end.
     1419     end.
     1420     run waitfram-show in this-procedure ("Ждите .. Проводится проверка возможности изменения правила" ).
     1421       _dis-rule:
     1422     for each buf_dis-rule no-lock where
     1423             buf_dis-rule.time-rule-num = p-time-rule-num:
     1424       assign
     1425       v-found = (yes AND v-changes)
     1426       .
     1427       leave _dis-rule.
     1428     end.
     1429   end.
     1430   if v-found then do:
     1431     run waitfram-hide in this-procedure .
     1432     run err-mess in this-procedure (substitute("Нельзя изменять запись РАСПИСАНИЯ: &1 ~
     1433                             с ней связано ПРАВИЛО СКИДОК №&2 &3"
     1434                             , chr(10)
     1435                             , buf_dis-rule.rule-num
     1436                             , buf_dis-rule.des
     1437                             )).
     1438     undo, return error "":U.
     1439   end.
     1440   run waitfram-hide in this-procedure .
     1441   DO ii = 1 TO NUM-ENTRIES(p-value-type):
     1442      ASSIGN
     1443      v-str =  entry (lookup (ENTRY(ii, p-value-type), '0,1,2,4,8,16':U), '?,Период времени,Период дат,День недели,Дата,День месяца':U) NO-ERROR.
     1444      if error-status:error then do:
     1445       run err-mess in this-procedure (substitute("Неверный тип расписания: &1", p-value-type)).
     1446       undo, return error "value-type":U.
     1447      end.
     1448   END.
     1449   find first buf_dis-time-rule no-lock where
     1450           buf_dis-time-rule.time-rule-num = p-upper-time-rule-num no-error .
     1451   if not available buf_dis-time-rule then do:
     1452     run err-mess in this-procedure (substitute("Неверный номер корневого расписания: &1", p-upper-time-rule-num)).
     1453     undo, return error "upper-time-rule-num":U.
     1454   end.
     1455   if p-time-rule-num <=  99999 then do:
     1456       run err-mess in this-procedure (substitute("Неверный номер расписания: &1, значения меньшие &2 зарезервированы", p-time-rule-num, 99999)).
     1457       undo, return error "time-rule-num":U.
     1458   end.
     1459   assign
     1460   v-time-rule-num = p-upper-time-rule-num
     1461   .
     1462   if lookup("time-from", vt-level-1) = 0
     1463   and lookup("time-from", vt-level-2) = 0  then do:
     1464     p-time-from = -1.
     1465   end.
     1466   if lookup("time-to", vt-level-1) = 0
     1467   and lookup("time-to", vt-level-2) = 0  then do:
     1468     p-time-to = -1.
     1469   end.
     1470   if lookup("date-from", vt-level-1) = 0
     1471   and lookup("date-from", vt-level-2) = 0  then do:
     1472     p-date-from = 12/31/1989.
     1473   end.
