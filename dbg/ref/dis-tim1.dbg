     1847       find first tt0-term_dis-time-rule no-lock where
     1848                   tt0-term_dis-time-rule.upper-time-rule-num = v-time-rule-num
     1849               AND tt0-term_dis-time-rule.time-rule-num = term_dis-time-rule.time-rule-num no-error .
     1850       if not available tt0-term_dis-time-rule then do:
     1851         delete term_dis-time-rule no-error .
     1852         if error-status:error then do:
     1853           run err-mess in this-procedure (substitute("Ошибка при попытке удаления расписания: &1 (детализация к расписанию &2): &3 ", tt0-term_dis-time-rule.time-rule-num, v-time-rule-num, return-value )).
     1854           undo _main, return error .
     1855         end.
     1856       end.
     1857     end.
     1858    end.
     1859    for each tt0-term_dis-time-rule :
     1860       find first term_dis-time-rule where
     1861                   term_dis-time-rule.upper-time-rule-num = v-time-rule-num
     1862               AND term_dis-time-rule.time-rule-num       = tt0-term_dis-time-rule.time-rule-num
     1863               no-error .
     1864       if not available term_dis-time-rule then do:
     1865         run gen-b-code in this-procedure ( input 'drgb':U, output v-new-time-rule-num) no-error .
     1866         if error-status:error then do:
     1867         end.
     1868         create term_dis-time-rule.
     1869         assign
     1870         term_dis-time-rule.upper-time-rule-num = v-time-rule-num
     1871         term_dis-time-rule.time-rule-num       = v-new-time-rule-num
     1872         term_dis-time-rule.rl-root        = v-time-rule-num
     1873         .
     1874         v-run-cn = yes.
     1875       end.
     1876       buffer-copy tt0-term_dis-time-rule except time-rule-num upper-time-rule-num root is-term lvl-num uniq-field
     1877       time-from time-to date-from date-to month-day
     1878       week-day-0 week-day-1 week-day-2 week-day-3 week-day-4 week-day-5 week-day-6 week-day-7
     1879       to term_dis-time-rule
     1880       assign
     1881       term_dis-time-rule.time-from = (if lookup("time-from", vt-level-2) = 0
     1882                                       then -1
     1883                                       else tt0-term_dis-time-rule.time-from)
     1884       term_dis-time-rule.time-to = (if lookup("time-to", vt-level-2) = 0
     1885                                     then -1
     1886                                     else tt0-term_dis-time-rule.time-to)
     1887       term_dis-time-rule.date-from = (if lookup("date-from", vt-level-2) = 0
     1888                                       then 12/31/1989
     1889                                       else tt0-term_dis-time-rule.date-from)
     1890       term_dis-time-rule.date-to = (if lookup("date-to", vt-level-2) = 0
     1891                                      then 12/31/1989
     1892                                      else tt0-term_dis-time-rule.date-to)
     1893       term_dis-time-rule.week-day-0 = (if lookup("week-day-0", vt-level-2) = 0
     1894                                        then ?
     1895                                        else tt0-term_dis-time-rule.week-day-0)
     1896       term_dis-time-rule.week-day-1 = (if lookup("week-day-1", vt-level-2) = 0
     1897                                        then ?
     1898                                        else tt0-term_dis-time-rule.week-day-1)
     1899       term_dis-time-rule.week-day-2 = (if lookup("week-day-2", vt-level-2) = 0
     1900                                        then ?
     1901                                        else tt0-term_dis-time-rule.week-day-2)
     1902       term_dis-time-rule.week-day-3 = (if lookup("week-day-3", vt-level-2) = 0
     1903                                        then ?
     1904                                        else tt0-term_dis-time-rule.week-day-3)
     1905       term_dis-time-rule.week-day-4 = (if lookup("week-day-4", vt-level-2) = 0
     1906                                        then ?
     1907                                        else tt0-term_dis-time-rule.week-day-4)
     1908       term_dis-time-rule.week-day-5 = (if lookup("week-day-5", vt-level-2) = 0
     1909                                        then ?
     1910                                        else tt0-term_dis-time-rule.week-day-5)
     1911       term_dis-time-rule.week-day-6 = (if lookup("week-day-6", vt-level-2) = 0
     1912                                        then ?
     1913                                        else tt0-term_dis-time-rule.week-day-6)
     1914       term_dis-time-rule.week-day-7 = (if lookup("week-day-7", vt-level-2) = 0
     1915                                        then ?
     1916                                        else tt0-term_dis-time-rule.week-day-7)
     1917       term_dis-time-rule.month-day = (if lookup("month-day", vt-level-2) = 0
     1918                                       then -1
     1919                                       else tt0-term_dis-time-rule.month-day)
     1920       term_dis-time-rule.root              = no
     1921       term_dis-time-rule.lvl-num           = 2
     1922       term_dis-time-rule.is-term           = yes
     1923       term_dis-time-rule.uniq-field        = v-tree
     1924       term_dis-time-rule.other-inf         = v-other
     1925       .
     1926       release term_dis-time-rule no-error .
     1927       if error-status:error then do:
     1928         run err-mess in this-procedure (substitute("Ошибка при попытке сохранения расписания: &1 (детализация к правилу &2): &3 ", v-new-time-rule-num, v-time-rule-num, return-value )).
     1929         undo _main, return error .
     1930       end.
     1931     end.
     1932    if v-run-cn then do:
     1933       find first ub.dis-time-rule no-lock where
     1934                 ub.dis-time-rule.time-rule-num = v-time-rule-num .
     1935       run str/callnews.p
     1936           (input 'dis-time-rule':U
     1937           ,input (buffer ub.dis-time-rule:handle)
     1938           ).
     1939     end.
     1940   end.
     1941   PROCEDURE err-mess:
     1942     DEFINE INPUT PARAMETER p-mess as character No-UNDO.
     1943     CASE p-silent:
     1944       when yes then do:
     1945         p-mess = substitute("ПРАВИЛО СКИДКИ &1: ", (if p-mode = 'ИЗМЕНЕНИЕ':U then string(p-time-rule-num) else p-des) ) + chr(10) + p-mess.
     1946       end.
     1947       otherwise do:
     1948         message
     1949         p-mess
     1950         view-as alert-box error .
     1951       end.
     1952     end.
     1953   END PROCEDURE.
     1954   procedure check-changes :
     1955   define input parameter p-time-rule-num like ub.dis-time-rule.time-rule-num no-undo .
     1956   define output parameter p-changes as logical no-undo .
     1957   define buffer buf_dis-time-rule for ub.dis-time-rule.
     1958     do
     1959     on error undo, return error
     1960     :
     1961       find first buf_dis-time-rule where buf_dis-time-rule.time-rule-num = p-time-rule-num.
     1962       assign
     1963       p-changes = (buf_dis-time-rule.value-type        <> p-value-type)
     1964                   or
     1965                   (buf_dis-time-rule.date-from         <> p-date-from )
     1966                   or
     1967                   (buf_dis-time-rule.date-to           <> p-date-to   )
     1968                   or
     1969                   (buf_dis-time-rule.time-from         <> p-time-from )
     1970                   or
     1971                   (buf_dis-time-rule.time-to           <> p-time-to   )
     1972                   or
     1973                   (buf_dis-time-rule.month-day         <> p-month-day )
     1974                   or
     1975                   (buf_dis-time-rule.week-day-0        <> p-week-day-0)
     1976                   or
     1977                   (buf_dis-time-rule.week-day-1        <> p-week-day-1)
     1978                   or
     1979                   (buf_dis-time-rule.week-day-2        <> p-week-day-2)
     1980                   or
     1981                   (buf_dis-time-rule.week-day-3        <> p-week-day-3)
     1982                   or
     1983                   (buf_dis-time-rule.week-day-4        <> p-week-day-4)
     1984                   or
     1985                   (buf_dis-time-rule.week-day-5        <> p-week-day-5)
     1986                   or
     1987                   (buf_dis-time-rule.week-day-6        <> p-week-day-6)
     1988                   or
     1989                   (buf_dis-time-rule.week-day-7        <> p-week-day-7)
     1990     .
     1991     end.
     1992   end procedure.
     1993   procedure distruls-override-labels-2 :
     1994   define input parameter p-templ-rl-root like ub.dis-time-rule.templ-rl-root no-undo .
     1995   define input parameter p-field-name as character no-undo .
     1996   define output parameter p-label as character no-undo .
     1997   define buffer buf_temp-drt-prop for temp-drt-prop.
     1998   do
     1999   on error undo, return error
     2000   :
     2001     for each buf_temp-drt-prop no-lock where
     2002                     buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
     2003                 and buf_temp-drt-prop.prop-code = "Label":U
     2004                 aND buf_temp-drt-prop.UPPER-prop-code = p-field-name
     2005                 :
     2006       assign
     2007       p-label = buf_temp-drt-prop.property-value
     2008       .
     2009       leave.
     2010     end.
     2011     if p-label = '':U then do:
     2012       case p-field-name:
     2013         when "date-from" then do:
     2014           p-label = "Дата с".
     2015         end.
     2016         when "date-to" then do:
     2017           p-label = "Дата по".
     2018         end.
     2019         when "time-from" then do:
     2020           p-label = "Время с".
     2021         end.
     2022         when "time-to" then do:
     2023           p-label = "Время по".
     2024         end.
     2025         when "week-day-0" then do:
     2026           p-label = "Все дни недели".
     2027         end.
     2028         when "week-day-1" then do:
     2029           p-label = "Понедельник".
     2030         end.
     2031         when "week-day-2" then do:
     2032           p-label = "Вторник".
     2033         end.
     2034         when "week-day-3" then do:
     2035           p-label = "Среда".
     2036         end.
     2037         when "week-day-4" then do:
     2038           p-label = "Четверг".
     2039         end.
     2040         when "week-day-5" then do:
     2041           p-label = "Пятница".
     2042         end.
     2043         when "week-day-6" then do:
     2044           p-label = "Суббота".
     2045         end.
     2046         when "week-day-7" then do:
     2047           p-label = "Восресенье".
     2048         end.
     2049         when "month-day" then do:
     2050           p-label = "День месяца".
     2051         end.
     2052         when "time-period" then do:
     2053           p-label = "Период времени суток".
     2054         end.
     2055         when "date-period" then do:
     2056           p-label = "Период дат".
     2057         end.
     2058       end case.
     2059     end.
     2060     end.
     2061   end procedure.
