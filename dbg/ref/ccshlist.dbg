     3288   PROCEDURE proc-view-changes :
     3289   define variable v-description as character no-undo .
     3290   for each temp-changes:
     3291       delete temp-changes.
     3292   END.
     3293   if not available X_c-cash-desk then do:
     3294     Open QUery br-changes for each temp-changes.
     3295     return.
     3296   end.
     3297   run ref/ccshdskv.p (
     3298                      input X_c-cash-desk.db-num
     3299                     ,input X_c-cash-desk.obj-code
     3300                     ,input X_c-cash-desk.pos-type
     3301                     ,input X_c-cash-desk.cash-num
     3302                     ,input X_c-cash-desk.attr-code
     3303                     ,input X_c-cash-desk.corr-user-db-num
     3304                     ,input X_c-cash-desk.chip-num
     3305                     ,input X_c-cash-desk.subject
     3306                     ,input 0
     3307                     ,input no
     3308                     ,output v-description
     3309                  ) no-error .
     3310   Open QUery br-changes for each temp-changes.
     3311   assign
     3312   br-changes:title in frame Dialog-Frame = v-description
     3313   .
     3314   END PROCEDURE.
     3315   FUNCTION get-action RETURNS CHARACTER
     3316     ( p-action as integer ) :
     3317      define variable dops as character no-undo.
     3318   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     3319   RETURN dops.
     3320   END FUNCTION.
