     3247   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3248   run fltfield-add in this-procedure('obj-code', 'Код объекта', '',
     3249   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3250   run fltfield-add in this-procedure('cash-num', 'Номер', '',
     3251   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3252   run fltfield-add in this-procedure('pos-type', 'Тип POS', '',
     3253   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3254   run fltfield-add in this-procedure('cash-on', 'Вкл', '',
     3255   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3256   run fltfield-add in this-procedure('autonomy', 'Автономность', '',
     3257   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3258   run fltfield-add in this-procedure('attr-code', 'Атрибут', '',
     3259   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3260   run fltfield-add in this-procedure('addr-path', 'Адрес (путь к кассе)', '',
     3261   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3262   run fltfield-add in this-procedure('corr-date', 'Дата изменений', '',
     3263   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3264   run fltfield-add in this-procedure('corr-time', 'Время изменений', 'time',
     3265   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3266   run fltfield-add in this-procedure('corr-user-db-num', 'БД изменений', '',
     3267   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3268   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     3269   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3270   run fltfield-add in this-procedure('is-del', 'Удаленная запись', '',
     3271   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3272   run fltfield-add in this-procedure('registration-code', 'Регистрационный №', '',
     3273   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3274   run fltfield-add in this-procedure('serial-code', 'Серийный №', '',
     3275   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
