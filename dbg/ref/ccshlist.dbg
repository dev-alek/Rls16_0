      375   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input  parameter parfact-date    like ub.wth-line.fact-date    no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                                                                                       cur_wth-line.wth-code   = parwth-code   and                                        cur_wth-line.fact-date  = parfact-date  and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-cld no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                                                                             start_wth-line.wth-code   = parwth-code         and                                start_wth-line.fact-date  < parfact-date   and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-cld no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income - cur_wth-line.incass              parincome        = cur_wth-line.income                     parincome-cassa  = cur_wth-line.income-cassa               parincome-other  = cur_wth-line.income-other               parincass        = cur_wth-line.incass                     parincass-bank   = cur_wth-line.incass-bank                parincass-other  = cur_wth-line.incass-other.              parincass-cassa  = cur_wth-line.incass-cassa.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income     - start_wth-line.incass               parstock-end     = cur_wth-line.income       - cur_wth-line.incass                 parincome        = cur_wth-line.income       - start_wth-line.income               parincome-cassa  = cur_wth-line.income-cassa - start_wth-line.income-cassa         parincome-other  = cur_wth-line.income-other - start_wth-line.income-other         parincass        = cur_wth-line.incass       - start_wth-line.incass               parincass-bank   = cur_wth-line.incass-bank  - start_wth-line.incass-bank          parincass-other  = cur_wth-line.incass-other - start_wth-line.incass-other.        parincass-cassa  = cur_wth-line.incass-cassa - start_wth-line.incass-cassa.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income - start_wth-line.incass                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
      376   end procedure.
      377   procedure wth-lib_full-inf-calend-date-place:
      378   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input parameter parw-p-code  like ub.wth-line.w-p-code  no-undo.                        define input parameter parfact-date like ub.wth-line.fact-date no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                        cur_wth-line.w-p-code   = parw-p-code and                                                               cur_wth-line.wth-code   = parwth-code   and                                        cur_wth-line.fact-date  = parfact-date  and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-cld-pl no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                start_wth-line.w-p-code = parw-p-code and                                                             start_wth-line.wth-code   = parwth-code         and                                start_wth-line.fact-date  < parfact-date   and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-cld-pl no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income-pl - cur_wth-line.incass-pl              parincome        = cur_wth-line.income-pl                     parincome-cassa  = cur_wth-line.income-cassa-pl               parincome-other  = cur_wth-line.income-other-pl               parincass        = cur_wth-line.incass-pl                     parincass-bank   = cur_wth-line.incass-bank-pl                parincass-other  = cur_wth-line.incass-other-pl.              parincass-cassa  = cur_wth-line.incass-cassa-pl.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income-pl     - start_wth-line.incass-pl               parstock-end     = cur_wth-line.income-pl       - cur_wth-line.incass-pl                 parincome        = cur_wth-line.income-pl       - start_wth-line.income-pl               parincome-cassa  = cur_wth-line.income-cassa-pl - start_wth-line.income-cassa-pl         parincome-other  = cur_wth-line.income-other-pl - start_wth-line.income-other-pl         parincass        = cur_wth-line.incass-pl       - start_wth-line.incass-pl               parincass-bank   = cur_wth-line.incass-bank-pl  - start_wth-line.incass-bank-pl          parincass-other  = cur_wth-line.incass-other-pl - start_wth-line.incass-other-pl.        parincass-cassa  = cur_wth-line.incass-cassa-pl - start_wth-line.incass-cassa-pl.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income-pl - start_wth-line.incass-pl                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
      379   end procedure.
      380   FUNCTION get-curr RETURNS CHARACTER
      381     (buffer loc-wealth for ub.wealth ) :
      382   define buffer buf_currency for ub.currency.
      383   if loc-wealth.curr-code = ? or loc-wealth.is-money = no then
      384   return loc-wealth.unit-base.
      385   FIND FIRST buf_currency no-lock where
      386             buf_currency.curr-code = loc-wealth.curr-code No-ERROR.
      387   if avail buf_currency then
      388     RETURN buf_currency.curr-abbr.
      389   else return "".
      390   END FUNCTION.
      391   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      392   define variable c-point  as character no-undo .
      393   define variable tbl      as character no-undo .
      394   define variable join-tbl as character no-undo .
      395   define variable fld      as character no-undo .
      396   define variable lab      as character no-undo .
      397   define variable spr      as character no-undo .
      398   define variable dim      as character no-undo .
      399   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      400   procedure fltfield-clear :
      401     define output parameter loc-fld as character no-undo.
      402     define output parameter loc-lab as character no-undo .
      403     define output parameter loc-spr as character no-undo .
      404     define output parameter loc-dim as character no-undo .
      405     assign
      406       loc-fld = ""
      407       loc-lab = ""
      408       loc-spr = ""
      409       loc-dim = "0"
      410     .
      411   end procedure .
      412   procedure fltfield-add :
      413     define input        parameter par-fld as character no-undo.
      414     define input        parameter par-lab as character no-undo .
      415     define input        parameter par-spr as character no-undo .
      416     define input-output parameter loc-fld as character no-undo.
      417     define input-output parameter loc-lab as character no-undo .
      418     define input-output parameter loc-spr as character no-undo .
      419     define input-output parameter loc-dim as character no-undo .
      420     do
      421     on error undo, return error
      422     :
      423       assign
      424       loc-fld = if loc-dim = '0'
      425                 then par-fld
      426                 else (loc-fld + chr(44) + par-fld)
      427       loc-lab = if loc-dim = '0'
      428                 then par-lab
      429                 else (loc-lab + chr(44) + par-lab)
      430       loc-spr = if loc-dim = '0'
      431                 then par-spr
      432                 else (loc-spr + chr(44) + par-spr)
      433       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      434                 string(integer(if num-entries(loc-dim) > 1
      435                               then entry(2, loc-dim)
      436                               else entry(1, loc-dim)
      437                               ) + 1)
      438       no-error
      439       .
      440     end.
      441   end procedure.
      442   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      443   define variable v-waitfram-action01         as character   no-undo .
      444   define variable v-waitfram-action02         as character   no-undo .
      445   define variable v-waitfram-action03         as character   no-undo .
      446   define variable mWaitFramTextBeg            as character   no-undo.
      447   define variable mWaitFramTextEnd            as character   no-undo.
      448   define variable mWaitFramView               as logical     no-undo.
      449   define variable mWaitProcEvent              as logical     no-undo init yes.
      450   define variable mWaitFramInterval           as integer     no-undo init 1 .
      451   define variable mWaitFramStop               as logical     no-undo.
      452   define variable mWaitFramStopUser           as logical     no-undo.
      453   define variable mWaitFramStopTimeOut        as logical     no-undo.
      454   define variable mWaitFramStartProc          as datetime-tz no-undo.
      455   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      456   define button B-WaitFramStop auto-end-key
      457        label "Стоп"
      458        size 10 by 1 tooltip "Остоновить процесс".
      459   define button B-viewProcInfo
      460        label "Информация"
      461        size 15 by 1 tooltip "Информация о процесс".
      462   define frame waitfram
      463     v-waitfram-action01 format "x(72)" no-label skip
      464     v-waitfram-action02 format "x(72)" no-label skip
      465     v-waitfram-action03 format "x(72)" no-label skip
      466     B-viewProcInfo
      467     B-WaitFramStop at row 4 col 30
      468     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      469     .
      470   define new global shared variable mBatchMode as logical no-undo init ?.
      471   define variable mFramBachModHandle as handle no-undo.
      472   mFramBachModHandle = frame waitfram:handle.
      473   define variable mFameOldVis as logical no-undo.
      474   define variable mVisCUrentVin as logical no-undo.
      475   if session:batch-mode
      476   then
      477      mBatchMode = yes.
      478   if mBatchMode = ? then do:
      479     mVisCUrentVin = current-window:visible.
      480     mFameOldVis = mFramBachModHandle:visible.
      481     mFramBachModHandle:visible  = yes.
      482     mBatchMode = mFramBachModHandle:visible ne yes.
      483     mFramBachModHandle:visible = mFameOldVis.
      484     current-window:visible = mVisCUrentVin.
      485   end.
      486    if  log-manager:logfile-name ne ?
      487     then DO:
      488         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      489         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      490         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      491     end.
      492   on choose of B-WaitFramStop in frame waitfram
      493   do:
      494     mWaitFramStop = yes.
      495     mWaitFramStopUser = yes.
      496   end.
      497   function waitfram-check-timeout returns logical():
      498      define variable vtime as int64 no-undo.
      499      if mWaitFramStopTimeOut
      500      then
      501         return yes.
      502      vtime = ( now - mWaitFramStartProc ) / 1000 .
      503      if     mWaitFramTimeOut ne ?
      504         and mWaitFramTimeOut ne 0
      505         and mWaitFramTimeOut lt vtime
      506      then do:
      507         mWaitFramStopTimeOut = yes.
      508      end.
      509      return mWaitFramStopTimeOut.
      510   end.
      511   procedure waitfram-hide :
      512     if not session:batch-mode
      513     then do
      514     on error undo, return error return-value
      515     :
      516       pause 0 before-hide .
      517       if not mBatchMode then
      518         hide frame waitfram .
      519     if     not mWaitFramView
      520        and mWaitProcEvent
      521     then
      522       process events .
      523     end.
      524   end procedure.
      525   procedure waitfram-show :
      526     define input  parameter p-message as character no-undo .
      527     define variable v-left-margin as integer   no-undo .
      528     if not session:batch-mode
      529     then do
      530     on error undo, return error return-value
      531     :
      532       if length(p-message) <= 70 then do:
      533         assign
      534           v-left-margin = integer((70 - length(p-message)) / 2)
      535         .
      536         assign
      537           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      538         .
      539         assign
      540           v-waitfram-action01 = " "
      541           v-waitfram-action02 = " "
      542                                    + fill(" ", v-left-margin)
      543                                    + p-message
      544           v-waitfram-action03 = " "
      545         .
      546       end.
      547       else do:
      548         define variable vRindex1 as integer no-undo.
      549         define variable vRindex2 as integer no-undo.
      550         vRindex1 = r-index(p-message," ",70).
      551         if vRindex1 = 0
      552         then
      553            vRindex1 = 70.
      554         if length(p-message)  <= vRindex1 + 70 then do:
      555           assign
      556             v-waitfram-action01 = " "
      557             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      558             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      559           .
      560         end.
      561         else do:
      562           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      563           if vRindex2 <= vRindex1
      564           then
      565              vRindex2 = vRindex1 + 70.
      566           assign
      567             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      568             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      569             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      570           .
      571         end.
      572       end.
      573       B-viewProcInfo:visible   in frame waitfram = no.
      574       B-viewProcInfo:sensitive in frame waitfram = no.
      575       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      576       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      577       if  (   mWaitFramView
      578          or  mWaitProcEvent)
      579          and not mBatchMode
      580       then
      581          display
      582             v-waitfram-action01 skip
      583             v-waitfram-action02 skip
      584             v-waitfram-action03 skip
      585          with frame waitfram .
      586       if     mWaitFramView
      587          then do:
      588             if     mWaitFramInterval ne ?
      589                and not mBatchMode
      590             then
      591                wait-for go of frame waitfram pause mWaitFramInterval.
      592          end.
      593          else
      594             if     mWaitProcEvent
      595                and not mBatchMode
      596             then
      597                process events .
      598     end.
      599   end procedure.
      600      procedure waitfram-show-this:
      601         define input  parameter iInterval as int64 no-undo.
      602         define variable vtime as int64 no-undo.
      603         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      604         mWaitFramInterval = iInterval.
      605         run waitfram-show (substitute("&1&2 &3&4" ,
      606                                       mWaitFramTextBeg ,
      607                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      608                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      609                                       mWaitFramTextEnd
      610                                      )
      611                           ).
      612      end.
      613      procedure WaitFramRunPause:
      614         define input  parameter iInterval as dec no-undo.
      615         define variable vStart  as datetime-tz no-undo.
      616         define variable vend    as datetime-tz no-undo.
      617         define variable vint as int64 no-undo.
      618         define variable vOk as logical no-undo.
      619         vStart = now.
      620         vend   = vStart.
      621         publish "WaitFramPause" (iInterval,output vOk).
      622         vend   =  now.
      623         vint = vend - vStart.
      624         vint = iInterval - vint / 1000.
      625         if     not mWaitFramStop
      626            and (   vint > 0
      627                 or (    not vOk
      628                     and iInterval eq ?
      629                     )
      630                 )
      631         then
      632            run waitfram-show-this (iInterval).
      633         vend   =  now.
      634         vint = vend - vStart.
      635         vint = iInterval - vint / 1000.
      636         if     not mWaitFramStop
      637            and vint > 0
      638         then do:
      639            run gbl/pause.p (vint * 1000).
      640         end.
      641         if iInterval ne ?
      642         then
      643            publish "WaitFramStop".
      644         waitfram-check-timeout().
      645      end.
      646      procedure WaitFramWaitFor:
      647         define input  parameter iInterval as dec no-undo.
      648         assign
      649            mWaitFramStartProc   = now
      650            mWaitFramStopUser    = no
      651            mWaitFramStopTimeOut = no
      652         .
      653         block-wait:
      654         do while not mWaitFramStop:
      655            run WaitFramRunPause (iInterval).
      656            if  waitfram-check-timeout()
      657            then do:
      658               leave block-wait.
      659            end.
      660         end.
      661         run waitfram-hide.
      662      end.
      663   procedure waitfram-join :
      664     define input  parameter p-line-1  as character no-undo .
      665     define input  parameter p-line-2  as character no-undo .
      666     define input  parameter p-line-3  as character no-undo .
      667     define output parameter p-message as character no-undo .
      668     do
      669     on error undo, return error return-value
      670     :
      671       assign
      672         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      673                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      674                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      675       .
      676     end.
      677   end procedure.
      678   function waitfram-join-function returns character
      679     (input p-line-1 as character
      680     ,input p-line-2 as character
      681     ,input p-line-3 as character
      682     ).
      683     define variable v-message as character no-undo .
      684     run waitfram-join in this-procedure
      685       (input  p-line-1
      686       ,input  p-line-2
      687       ,input  p-line-3
      688       ,output v-message
      689       ) .
      690     return v-message .
      691   end function .
      692   procedure proc-alt-shift-f2:
      693     if not ibs.th.gbl.gbl-var:rcode
      694   then
      695     run gbl\inidebug.p .
      696   end.
      697   procedure proc-alt-shift-f3:
      698     run gbl/prvssinf.p
      699       ( input this-procedure
      700       ) .
      701   end.
      702   define variable v-inform-launched as logical no-undo initial false .
      703   procedure proc-alt-shift-f4:
      704     define variable v-action as character no-undo .
      705     if v-inform-launched = false then do:
      706       assign
      707         v-inform-launched = true
      708       .
      709       run gbl/d-inform.w
      710         (  input self
      711         ,  input this-procedure
      712         , output v-action
      713         ) no-error .
      714       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      715       assign
      716         v-inform-launched = false
      717       .
      718     end.
      719   end.
      720   procedure proc-alt-f1:
      721     run gbl/corrhelp.p
      722       (input this-procedure
      723       ) .
      724   end .
      725   on alt-shift-f2 anywhere do:
      726     run proc-alt-shift-f2.
      727   end.
      728   on alt-shift-f3 anywhere do:
      729     run proc-alt-shift-f3 in this-procedure .
      730   end.
      731   on alt-shift-f4 anywhere do:
      732     run proc-alt-shift-f4 in this-procedure.
      733   end.
      734   on alt-f1 anywhere do:
      735     run proc-alt-f1 in this-procedure .
      736   end.
      737   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      738   FUNCTION mark-string RETURNS CHARACTER
      739     ( input p-recid as recid, input mark-list as character  ) :
      740     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      741   END FUNCTION.
      742   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      743   function usrfulnf returns character ( input p-user-id as character):
      744   define variable v-user-name as character no-undo .
      745   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      746   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      747     (input  p-user-id
      748     ,output v-user-name
      749     ) no-error .
      750   if error-status:error
      751   or v-user-name = ""
      752   then do:
      753     return p-user-id.
      754   end.
      755   else do:
      756     return v-user-name.
      757   end.
      758   end function.
      759   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      760   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      761   procedure fltopend_fltopend :
      762   define input parameter p-parent-handle as handle no-undo .
      763   define input parameter p-qh as handle no-undo .
      764   define input parameter p-flt-open-open-query  as character no-undo .
      765   define input parameter p-where-cond as character no-undo .
      766   define input parameter p-use-indFIRST-query-tail as character no-undo .
      767   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      768   define input parameter p-indexed-reposition as character no-undo .
      769     do
      770     on error undo, return error
      771     :
      772   define variable v-prepare-string as character no-undo .
      773   define variable glog as logical no-undo .
      774   assign
      775   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      776                      p-where-cond + chr(32)  +
      777                      p-use-indFIRST-query-tail + chr(32) +
      778                      p-use-ind-sort-clmn-by + chr(32) +
      779                      p-indexed-reposition
      780   .
      781   assign
      782   glog = p-qh:query-prepare(v-prepare-string) no-error .
      783   if not glog
      784   or error-status:error then do:
      785     message error-status:get-message(1) view-as alert-box .
      786     undo, return error .
      787   end.
      788   assign
      789   glog = p-qh:query-open no-error .
      790   if not glog
      791   or error-status:error then do:
      792     message error-status:get-message(1) view-as alert-box .
      793     undo, return error .
      794   end.
      795     end.
      796   end procedure.
      797   procedure fltopend_fltfindd :
      798   define input parameter p-parent-handle as handle no-undo .
      799   define input parameter p-qh as handle no-undo .
      800   define input parameter p-rowid as rowid no-undo .
      801   define input parameter p-next as logical no-undo .
      802   define input parameter p-lock as integer no-undo .
      803   define input parameter p-bh as handle no-undo .
      804   define input parameter p-where-cond as character no-undo .
      805   define input parameter p-use-index-phrase as character no-undo .
      806   define variable glog as logical no-undo .
      807   define variable v-qh as handle no-undo .
      808   define variable v-bh as handle no-undo .
      809   define variable v-recid as recid no-undo .
      810   define variable v-prepare-string as character no-undo .
      811   do
      812   on error undo, return error
      813   on stop undo, return error
      814   :
      815     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      816     create buffer v-bh for table p-bh buffer-name p-bh:name.
      817     create query v-qh.
      818     v-qh:set-buffers(v-bh).
      819     v-prepare-string = substitute("for each &1 &2 &3"
      820                                     ,v-bh:name
      821                                     ,p-where-cond
      822                                     ,p-use-index-phrase).
      823     glog = v-qh:query-prepare(v-prepare-string) no-error.
      824     if not glog then do:
      825       delete object v-qh.
      826       delete object v-bh.
      827       undo, return error .
      828     end.
      829     glog = v-qh:query-open no-error .
      830     if not glog then do:
      831       delete object v-qh.
      832       delete object v-bh.
      833       undo, return error .
      834     end.
      835     if p-next then do:
      836       v-qh:reposition-to-rowid(p-rowid) no-error .
      837       glog = v-qh:get-next( p-lock) no-error .
      838       glog = v-qh:get-next( p-lock) no-error .
      839       if not glog or v-qh:query-off-end = yes then do:
      840         glog = v-qh:get-first( p-lock) no-error .
      841       end.
      842     end.
      843     else do:
      844       glog = v-qh:get-first( p-lock) no-error .
      845     end.
      846     v-recid = v-bh:recid no-error .
      847     delete object v-qh.
      848     delete object v-bh.
      849     return string(v-recid) .
      850   end.
      851   end procedure.
      852   procedure fltopend_fltfindq :
      853   define input parameter p-parent-handle as handle no-undo .
      854   define input parameter p-qh as handle no-undo .
      855   define input parameter p-next as logical no-undo .
      856   define input parameter p-lock as integer no-undo .
      857   define input parameter p-flt-open-open-query  as character no-undo .
      858   define input parameter p-where-cond as character no-undo .
      859   define input parameter p-use-indFIRST-query-tail as character no-undo .
      860   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      861   define input parameter p-indexed-reposition as character no-undo .
      862   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      863   define variable glog as logical no-undo .
      864   define variable v-qh as handle no-undo .
      865   define variable v-bh as handle no-undo extent 18.
      866   define variable v-rowid as rowid no-undo extent 18.
      867   define variable v-ii as integer no-undo .
      868   define variable v-prepare-string as character no-undo .
      869   do
      870   on error undo, return error
      871   on stop undo, return error
      872   :
      873     create query v-qh.
      874     do v-ii = 1 to p-qh:num-buffers:
      875       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      876       assign
      877       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      878       no-error.
      879       v-qh:add-buffer(v-bh[v-ii]).
      880     end.
      881     assign
      882     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      883                       p-where-cond + chr(32)  +
      884                       p-use-indFIRST-query-tail + chr(32) +
      885                       p-use-ind-sort-clmn-by + chr(32) +
      886                       p-indexed-reposition
      887     .
      888     glog = v-qh:query-prepare( v-prepare-string) no-error .
      889     if not glog then do:
      890       delete object v-qh.
      891       do v-ii = 1 to p-qh:num-buffers:
      892         delete object v-bh[v-ii].
      893       end.
      894       undo, return error .
      895     end.
      896     glog = v-qh:query-open no-error .
      897     if not glog then do:
      898       delete object v-qh.
      899       do v-ii = 1 to p-qh:num-buffers:
      900         delete object v-bh[v-ii].
      901       end.
      902       undo, return error .
      903     end.
      904     if p-next then do:
      905       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      906       glog = v-qh:get-next( p-lock) no-error .
      907       glog = v-qh:get-next( p-lock) no-error .
      908       if not glog or v-qh:query-off-end = yes then do:
      909         glog = v-qh:get-first( p-lock) no-error .
      910       end.
      911     end.
      912     else do:
      913       glog = v-qh:get-first( p-lock) no-error .
      914     end.
      915     do v-ii = 1 to p-qh:num-buffers:
      916       assign
      917       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      918       no-error.
      919     end.
      920     delete object v-qh.
      921     do v-ii = 1 to p-qh:num-buffers:
      922       delete object v-bh[v-ii].
      923     end.
      924   end.
      925   end procedure.
      926   define variable log-res as log no-undo.
      927   define variable rr as recid no-undo.
      928   define variable jj as integer no-undo .
      929   define variable str as char no-undo.
      930   define variable conf-par as char no-undo.
      931   define variable par-type as char no-undo.
      932   define variable vartbl-name as char no-undo.
      933   define variable varact      as char no-undo.
      934   DEFINE VARIABLE parstock like ub.wth-pobj.income-pl no-undo .
      935   define variable filter-point0 as character no-undo init "ccshlist" .
      936   define variable filter-point as character no-undo init "ccshlist" .
      937   define variable filter-label0 as character no-undo init "Справочник_истории_касс" .
      938   define variable filter-label as character no-undo init "Справочник_истории_касс" .
      939   define variable v-rid-list as character no-undo .
      940   define variable sort-column-name as character no-undo .
      941   define variable v-doc-rec as recid no-undo .
      942   define buffer X_cash-desk for ub.cash-desk.
      943   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      944   define NEW SHARED temp-table temp-changes no-undo
      945   field f_name as character
      946   field l_name as character
      947   field v_old as character
      948   field v_new as character
      949   field t_name as character
      950   field num_ as integer
      951   field uniq-key-rec as character
      952   field action as integer
      953   field fNotChange as logical
      954   index pi is unique primary
      955   num_
      956   t_name
      957   f_name
      958   index
      959   Chan
      960   fnotChange
      961   t_name
      962   f_name
      963   index imain uniq-key-rec
      964   .
      965   FUNCTION get-all-fields returns character (p-file-name as character ):
      966   define variable v-dop as character no-undo .
      967     find first _file no-lock where _file._file-name = p-file-name no-error .
      968     if not available _file then return "":U.
      969     for each _field no-lock where
      970              _field._file-recid = recid(_file) :
      971       assign
      972       v-dop = v-dop + _field._field-name + chr(44)
      973       .
      974     end.
      975     return trim(v-dop).
      976   END FUNCTION.
      977   PROCEDURE proc-full-temp-changes :
      978     define input  parameter p-hst-handle as handle    no-undo .
      979     define input  parameter p-main-table as character no-undo .
      980     define input  parameter p-field-list as character no-undo .
      981     define input  parameter p-label-form as character no-undo .
      982     define variable h-new-buf         as handle    no-undo .
      983     define variable h-main-buf        as handle    no-undo .
      984     define variable h-for-comp        as handle    no-undo .
      985     define variable v-inform          as character no-undo .
      986     define variable v-ind             as integer   no-undo .
      987     define variable v-idx-field-qnty  as integer   no-undo .
      988     define variable v-num-entries     as integer   no-undo .
      989     define variable fh                as handle    no-undo .
      990     define variable fh-main           as handle    no-undo .
      991     define variable fh-old            as handle    no-undo .
      992     define variable fh-new            as handle    no-undo .
      993     define variable v-field-name      as character no-undo .
      994     define variable v-field-lvl       as character no-undo .
      995     define variable v-field-form      as character no-undo .
      996     define variable v-search-exp      as character no-undo .
      997     define variable v-srch-main       as character no-undo .
      998     define variable v-word-link       as character no-undo .
      999     define variable v-av-chip-num     as logical   no-undo .
     1000     define variable v-main-pi-fld-lst as character no-undo .
     1001     define variable v-main-fld-lst    as character no-undo .
     1002     define variable v-delim-list      as character no-undo .
     1003     define variable v-label           as character no-undo .
     1004     define variable v-old-value       as character no-undo case-sensitive.
     1005     define variable v-new-value       as character no-undo case-sensitive.
     1006     define variable v-chg-fields as character no-undo.
     1007     for each temp-changes:
     1008       delete temp-changes.
     1009     end.
     1010     if not p-hst-handle:available then do:
     1011       return .
     1012     end.
     1013     create buffer h-new-buf  for table p-hst-handle .
     1014     create buffer h-main-buf for table p-main-table .
     1015     assign
     1016       v-inform = h-main-buf:index-information(1)
     1017       v-ind    = 2
     1018     .
     1019     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1020     on error undo, return error
     1021     :
     1022       assign
     1023         v-inform = h-main-buf:index-information( v-ind )
     1024         v-ind    = v-ind + 1
     1025       .
     1026     end.
     1027     if v-inform = ?
     1028       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1029       or entry( 3, v-inform, ",":U ) <> "1":U
     1030     then do:
     1031       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1032     end.
     1033     assign
     1034       v-idx-field-qnty = num-entries( v-inform ) - 4
     1035     .
     1036     if v-idx-field-qnty < 2 then do:
     1037       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1038     end.
     1039     assign
     1040       v-srch-main   = "where":U
     1041       v-word-link   = "":U
     1042       v-av-chip-num = false
     1043       v-delim-list  = "":U
     1044     .
     1045     do v-ind = 1 to v-idx-field-qnty by 2
     1046     on error undo, return error
     1047     :
     1048       assign
     1049         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1050         fh                = p-hst-handle:buffer-field( v-field-name )
     1051         fh-main           = h-main-buf:buffer-field( v-field-name )
     1052         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1053         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1054       .
     1055       if fh:data-type ="character":U then do:
     1056         assign
     1057           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1058         .
     1059       end.
     1060       else do:
     1061         assign
     1062           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1063         .
     1064       end.
     1065       if v-delim-list = "":U then do:
     1066         assign
     1067           v-delim-list = ",":U
     1068         .
     1069       end.
     1070       if v-word-link = "":U then do:
     1071         assign
     1072           v-word-link = "and":U
     1073         .
     1074       end.
     1075     end.
     1076     assign
     1077       v-delim-list  = "":U
     1078     .
     1079     do v-ind = 1 to h-main-buf:num-fields
     1080     on error undo, return error
     1081     :
     1082       assign
     1083         fh-main      = h-main-buf:buffer-field( v-ind )
     1084         v-field-name = fh-main:name
     1085       .
     1086         assign
     1087           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1088         .
     1089         if v-delim-list = "":U then do:
     1090           assign
     1091             v-delim-list = ",":U
     1092           .
     1093         end.
     1094     end.
     1095     assign
     1096       v-inform = p-hst-handle:index-information(1)
     1097       v-ind    = 2
     1098     .
     1099     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1100     on error undo, return error
     1101     :
     1102       assign
     1103         v-inform = p-hst-handle:index-information( v-ind )
     1104         v-ind    = v-ind + 1
     1105       .
     1106     end.
     1107     if v-inform = ?
     1108       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1109       or entry( 3, v-inform, ",":U ) <> "1":U
     1110     then do:
     1111       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1112     end.
     1113     assign
     1114       v-idx-field-qnty = num-entries( v-inform ) - 4
     1115     .
     1116     if v-idx-field-qnty < 2 then do:
     1117       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1118     end.
     1119     assign
     1120       v-search-exp  = "where":U
     1121       v-word-link   = "":U
     1122       v-av-chip-num = false
     1123     .
     1124     do v-ind = 1 to v-idx-field-qnty by 2
     1125     on error undo, return error
     1126     :
     1127       assign
     1128         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1129         fh           = p-hst-handle:buffer-field( v-field-name )
     1130         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1131       .
     1132       if v-field-name = "chip-num":U then do:
     1133         assign
     1134           v-search-exp  = substitute( "&1 >", v-search-exp )
     1135           v-av-chip-num = true
     1136         .
     1137       end.
     1138       else do:
     1139         assign
     1140           v-search-exp = substitute( "&1 =", v-search-exp )
     1141         .
     1142       end.
     1143       if fh:data-type ="character":U then do:
     1144         assign
     1145           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1146         .
     1147       end.
     1148       else do:
     1149         assign
     1150           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1151         .
     1152       end.
     1153       if v-word-link = "":U then do:
     1154         assign
     1155           v-word-link = "and":U
     1156         .
     1157       end.
     1158     end.
     1159     if v-av-chip-num = false then do:
     1160       message
     1161         vss-workfile vss-revision vss-description skip
     1162         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1163         "Использование данной процедуры невозможно!" skip
     1164         view-as alert-box error .
     1165       return error .
     1166     end.
     1167     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1168     if not h-new-buf:available then do:
     1169       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1170       if not h-main-buf:available then do:
     1171         assign
     1172           h-for-comp = ?
     1173         .
     1174       end.
     1175       else do:
     1176         assign
     1177           h-for-comp = h-main-buf
     1178         .
     1179       end.
     1180     end.
     1181     else do:
     1182       assign
     1183         h-for-comp = h-new-buf
     1184       .
     1185     end.
     1186     assign
     1187       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1188     .
     1189     do v-ind = 1 to v-num-entries
     1190     on error undo, return error return-value
     1191     :
     1192       assign
     1193         v-field-name = entry( v-ind, v-main-fld-lst )
     1194         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1195         v-old-value  = fh-old:buffer-value()
     1196         v-label      = trim( fh-old:label )
     1197       .
     1198       if ( trim( p-field-list ) <> "":U
     1199            and lookup( v-field-name, p-field-list ) > 0
     1200          )
     1201          or trim( p-field-list ) = "":U
     1202       then do:
     1203         if h-for-comp <> ? then do:
     1204           assign
     1205             fh-new      = h-for-comp:buffer-field( v-field-name )
     1206             v-new-value = fh-new:buffer-value()
     1207           .
     1208         end.
     1209         else do:
     1210           assign
     1211             v-new-value = "":U
     1212           .
     1213         end.
     1214         if v-old-value <> v-new-value
     1215         then do:
     1216           create temp-changes.
     1217           assign
     1218             temp-changes.t_name = p-main-table
     1219             temp-changes.f_name = v-field-name
     1220             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1221             temp-changes.v_old  = trim( v-old-value )
     1222             temp-changes.v_new  = trim( v-new-value )
     1223             temp-changes.num_   = 0
     1224             temp-changes.fNotChange = v-old-value eq v-new-value
     1225           .
     1226         end.
     1227       end.
     1228     end.
     1229     assign
     1230       v-num-entries = num-entries( p-label-form, chr(8) )
     1231     .
     1232     do v-ind = 1 to v-num-entries
     1233     on error undo, return error return-value
     1234     :
     1235       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1236         assign
     1237           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1238           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1239           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1240         .
     1241         find first temp-changes
     1242           where temp-changes.f_name = v-field-name
     1243           no-error .
     1244         if available temp-changes then do:
     1245           if trim( v-field-lvl ) <> "":U then do:
     1246             assign
     1247               temp-changes.l_name = v-field-lvl
     1248             .
     1249           end.
     1250           if trim( v-field-form ) <> "":U then do:
     1251             assign
     1252               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1253             .
     1254             if h-for-comp <> ? then do:
     1255               assign
     1256                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1257               .
     1258             end.
     1259           end.
     1260         end.
     1261       end.
     1262       else do:
     1263         message
     1264           vss-workfile vss-revision vss-description skip
     1265           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1266           substitute( "список для поля '&1': '&2'"
     1267                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1268                       ,entry( v-ind, p-label-form, chr(8) )
     1269                     ) skip
     1270           substitute( "полный список: &2", p-label-form ) skip
     1271           view-as alert-box error .
     1272       end.
     1273     end.
     1274     delete object h-new-buf .
     1275     delete object h-main-buf .
     1276   END PROCEDURE.
     1277   FUNCTION get-action RETURNS CHARACTER
     1278     ( p-action as integer )  FORWARD.
     1279   DEFINE BUTTON B-Help
     1280        LABEL "Помо&щь"
     1281        SIZE 3 BY 1
     1282        BGCOLOR 8 .
     1283   DEFINE BUTTON B-mark
     1284        LABEL "&*"
     1285        SIZE 3 BY 1.
     1286   DEFINE BUTTON b-quit AUTO-END-KEY
     1287        LABEL "&Выход"
     1288        SIZE 10 BY 1
     1289        BGCOLOR 8 .
     1290   DEFINE BUTTON B-sch
     1291        LABEL "&Фильтр"
     1292        SIZE 3 BY 1.
     1293   DEFINE BUTTON b-sel AUTO-GO
     1294        LABEL "Вы&бор"
     1295        SIZE 10 BY 1.
     1296   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1297        VIEW-AS FILL-IN
     1298        SIZE 9 BY 1
     1299        FGCOLOR 4  NO-UNDO.
     1300   DEFINE QUERY BR-c-cash-desk FOR
     1301         X_c-cash-desk SCROLLING.
     1302   DEFINE QUERY BR-changes FOR
     1303         temp-changes SCROLLING.
     1304   DEFINE BROWSE BR-c-cash-desk
     1305     QUERY BR-c-cash-desk DISPLAY
     1306         mark-string( recid(X_c-cash-desk), v-rid-list ) COLUMN-LABEL "*" FORMAT "X(1)":U
     1307         entry (lookup (X_c-cash-desk.subject, 'cash-desk,cash-desk-attr':U), 'Касса,Аттр.кассы':U) COLUMN-LABEL "Предмет изменений" FORMAT "X(12)":U
     1308         get-action(X_c-cash-desk.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1309         X_c-cash-desk.corr-date COLUMN-LABEL "Дата корр" FORMAT "99/99/9999":U
     1310         usrfulnf(X_c-cash-desk.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1311         string(X_c-cash-desk.corr-time, "HH:MM")
     1312       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 12.33.
     1313   DEFINE BROWSE BR-changes
     1314     QUERY BR-changes DISPLAY
     1315         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(15)"
     1316   temp-changes.v_old COLUMn-LABEL "Было" format "X(40)"
     1317   temp-changes.v_new COLUMn-LABEL "Стало" format "X(40)"
     1318       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6.
     1319   DEFINE FRAME Dialog-Frame
     1320        b-quit AT ROW 1 COL 1
     1321        B-mark AT ROW 1 COL 11
     1322        b-sel AT ROW 1 COL 14
     1323        B-sch AT ROW 1 COL 92
     1324        B-Help AT ROW 1 COL 95
     1325        mark-num AT ROW 1.92 COL 9 COLON-ALIGNED NO-LABEL
     1326        BR-c-cash-desk AT ROW 3.42 COL 1
     1327        BR-changes AT ROW 16.04 COL 1
     1328        SPACE(0.24) SKIP(0.00)
     1329       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1330            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1331            TITLE "Справочник касс"
     1332            CANCEL-BUTTON b-quit.
     1333   ASSIGN
     1334          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1335          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1336   ASSIGN
     1337          BR-c-cash-desk:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1338   ON GO OF FRAME Dialog-Frame
     1339   DO:
     1340     p-rid-list = v-rid-list.
     1341   END.
     1342   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1343   DO:
     1344     APPLY "END-ERROR":U TO SELF.
     1345   END.
     1346   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1347   DO:
     1348   define variable glog as logical no-undo .
     1349    if not available X_c-cash-desk then return no-apply.
     1350   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1351   define variable v-str-recid13 as character no-undo .
     1352   define variable v-num-entry13 as integer   no-undo .
     1353   assign
     1354     v-str-recid13 = trim( string( recid( X_c-cash-desk ) , "->>>>>>>>>>>9":U ) )
     1355     v-num-entry13 = lookup( v-str-recid13 , v-rid-list )
     1356   .
     1357   if v-num-entry13 > 0 then do:
     1358     assign
     1359       entry( v-num-entry13, v-rid-list ) = "":U
     1360       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1361     .
     1362   end.
     1363   else do:
     1364     assign
     1365       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid13
     1366     .
     1367   end.
     1368    glog = br-c-cash-desk :refresh( )  in frame Dialog-Frame.
     1369     if not can-do ("MOUSE-SELECT-DBLCLICK,Return", last-event:function) then do:
     1370       glog = br-c-cash-desk:select-next-row () in frame Dialog-Frame.
     1371       apply "value-changed" to br-c-cash-desk in frame Dialog-Frame.
     1372     end.
     1373     if num-entries (v-rid-list) = 0 then
     1374         hide mark-num in frame Dialog-Frame.
     1375     else
     1376     disp num-entries (v-rid-list) @ mark-num
     1377     with frame Dialog-Frame.
     1378     apply "entry" to br-c-cash-desk in frame Dialog-Frame.
     1379   END.
     1380   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1381   DO:
     1382     run proc-b-sch in this-procedure no-error.
     1383     if error-status:error then return no-apply.
     1384   END.
     1385   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1386   DO:
     1387       if ( available X_c-cash-desk ) AND ( v-rid-list = "" ) then
     1388           v-rid-list = string( recid( X_c-cash-desk ) ) .
     1389   END.
     1390   ON RETURN OF BR-c-cash-desk IN FRAME Dialog-Frame
     1391   DO:
     1392         apply "DEFAULT-ACTION":U to self.
     1393   END.
     1394   ON VALUE-CHANGED OF BR-c-cash-desk IN FRAME Dialog-Frame
     1395   DO:
     1396     run proc-view-changes in this-procedure no-error.
     1397   END.
     1398   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1399   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1400   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1401   on help of frame Dialog-Frame
     1402   do:
     1403     run gbl/app_help.p
     1404       (input this-procedure :file-name
     1405       ,input ''
     1406       ,input ?
     1407       ) no-error.
     1408     if error-status :error then do:
     1409       message
     1410         "Ошибка при вызове помощи"
     1411         error-status :get-message(1)
     1412         view-as alert-box .
     1413     end.
     1414   end.
     1415   run minbtn-set in this-procedure .
     1416   on choose of b-help in frame Dialog-Frame
     1417   do:
     1418     apply "help":u to frame Dialog-Frame .
     1419   end.
     1420   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1421   procedure minbtn-set :
     1422       do
     1423           on error undo, return error return-value
     1424           :
     1425           define variable ii              as integer       no-undo .
     1426           define variable fh              as widget-handle no-undo .
     1427           define variable hh              as widget-handle no-undo .
     1428           define variable v-h             as handle        extent 4 no-undo .
     1429           define variable v-name-button   as character     no-undo .
     1430           define variable v-help-old-x    as decimal       no-undo .
     1431           define variable v-help-old-y    as decimal       no-undo .
     1432           define variable v-help-old-size as decimal       no-undo .
     1433           define variable v-frame-width   as decimal       no-undo .
     1434           define variable jj              as integer       no-undo .
     1435           do
     1436               on error undo, return error
     1437               :
     1438               assign
     1439                   v-frame-width = frame Dialog-Frame:width - 0.3
     1440                   fh            = frame Dialog-Frame:first-child
     1441                   hh            = fh:first-child
     1442                   ii            = 1
     1443                   .
     1444               do while valid-handle(hh):
     1445                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1446                   do:
     1447                       case lc(hh:name) :
     1448                           when "b-help" then
     1449                               do:
     1450                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1451                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1452                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1453                                   hh:TOOLTIP = "Помощь" .
     1454                                   v-help-old-x = hh:column .
     1455                                   v-help-old-y = hh:row    .
     1456                                   v-help-old-size = hh:width .
     1457                                   hh:width-chars = 2.5 .
     1458                               end.
     1459                           when "b-print" then
     1460                               do:
     1461                                   hh:load-image("cmp/b-print.bmp":u) .
     1462                                   hh:TOOLTIP = "Печать" .
     1463                                   v-h[ii] = hh:handle .
     1464                                   ii = ii + 1 .
     1465                                   hh:width-chars = 3 .
     1466                               end.
     1467                           when "b-history" or
     1468                           when "b-hist" then
     1469                               do:
     1470                                   hh:load-image("cmp/b-hist.bmp":u) .
     1471                                   hh:TOOLTIP = "История" .
     1472                                   v-h[ii] = hh:handle .
     1473                                   ii = ii + 1 .
     1474                                   hh:width-chars = 3 .
     1475                               end.
     1476                           when "b-sch" then
     1477                               do:
     1478                                   hh:load-image("cmp/b-sch.bmp":u) .
     1479                                   hh:TOOLTIP = "Установка Фильтра" .
     1480                                   v-h[ii] = hh:handle .
     1481                                   ii = ii + 1 .
     1482                                   hh:width-chars = 3 .
     1483                               end.
     1484                           when "b-hist-user" then
     1485                               do:
     1486                                   hh:load-image("cmp/b-hist.bmp":u) .
     1487                                   hh:TOOLTIP = "История пользователя" .
     1488                                   ii = ii + 1 .
     1489                               end.
     1490                       end case.
     1491                   end.
     1492                   hh = hh:next-sibling.
     1493               end.
     1494               b-help:column = v-frame-width - b-help:width-chars.
     1495               jj = 0.
     1496               repeat ii = 4 to 1 by -1 :
     1497                   if valid-handle (v-h[ii] ) then
     1498                   do:
     1499                       jj  = jj + 1 .
     1500                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1501                       v-h[ii]:row    = v-help-old-y .
     1502                   end.
     1503               end.
     1504           end.
     1505       end.
     1506   end procedure.
     1507   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1508   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1509   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1510   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1511   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1512   define variable v-diasize-current-frame-height as decimal   no-undo .
     1513   define variable v-diasize-change-size          as logical   no-undo .
     1514   define variable v-diasize-resize-button        as handle    no-undo .
     1515   define variable v-diasize-wndmax               as logical   no-undo .
     1516   define variable v-diasize-wndstore             as logical   no-undo .
     1517   define variable v-diasize-proc-name            as character no-undo .
     1518   define variable v-diasize-browse-handle        as handle    no-undo .
     1519   define variable v-diasize-browse-number        as integer   no-undo .
     1520   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1521   define temp-table temp-diasize-handle no-undo
     1522     field handle-value  as handle
     1523     field save-position as decimal
     1524     index xpk is primary unique handle-value
     1525     .
     1526   define temp-table temp-browse-handle no-undo
     1527     field browse-type   as character
     1528     field browse-number as integer
     1529     field browse-handle as handle
     1530     field original-size as decimal
     1531     index xpk is primary unique browse-type browse-number
     1532     index xie browse-type browse-handle
     1533   .
     1534   procedure diasize_change-height :
     1535     define input  parameter p-change-value  as decimal   no-undo .
     1536     define input  parameter p-move-resize   as logical   no-undo .
     1537     define variable v-field-group-handle    as handle    no-undo .
     1538     define variable v-object-handle         as handle    no-undo .
     1539     define variable v-frame-height          as decimal   no-undo .
     1540     define variable v-frame-virtual-height  as decimal   no-undo .
     1541     define variable v-browse-height         as decimal   no-undo .
     1542     define variable v-window-height         as decimal   no-undo .
     1543     define variable v-window-virtual-height as decimal   no-undo .
     1544     define variable v-change-sign           as integer   no-undo .
     1545     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1546     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1547     if p-change-value > 0
     1548     then do:
     1549       if frame Dialog-Frame :height + p-change-value
     1550           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1551       then do:
     1552         assign
     1553           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1554                           - (frame Dialog-Frame :height-chars)
     1555         .
     1556         if p-change-value <= 0
     1557         then do:
     1558           run diasize_position-resize-button in this-procedure .
     1559           return .
     1560         end.
     1561       end.
     1562     end.
     1563     if p-change-value < 0
     1564     then do:
     1565       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1566       then do:
     1567         assign
     1568           p-change-value = v-diasize-orig-frame-height
     1569                          - (frame Dialog-Frame :height-chars)
     1570         .
     1571         if p-change-value >= 0
     1572         then do:
     1573           run diasize_position-resize-button in this-procedure .
     1574           return .
     1575         end.
     1576       end.
     1577     end.
     1578     if p-change-value >= 0
     1579     then do:
     1580       assign
     1581         v-change-sign = 1
     1582       .
     1583     end.
     1584     else do:
     1585       assign
     1586         v-change-sign = -1
     1587       .
     1588     end.
     1589     assign
     1590       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1591     .
     1592     if p-change-value = 0
     1593     then do:
     1594       run diasize_position-resize-button in this-procedure .
     1595       return .
     1596     end.
     1597     move_block:
     1598     do
     1599     on error undo move_block, retry move_block
     1600     :
     1601       if retry
     1602       then do:
     1603         do
     1604         on error undo move_block, leave move_block
     1605         :
     1606           if p-change-value > 0
     1607           then do:
     1608             for each buf_temp-diasize-handle
     1609             on error undo, next
     1610             :
     1611               assign
     1612                 v-object-handle = buf_temp-diasize-handle.handle-value
     1613               .
     1614               if v-object-handle <> v-diasize-resize-button
     1615               then do:
     1616                 assign
     1617                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1618                 .
     1619               end.
     1620             end.
     1621             assign
     1622               v-diasize-browse-handle :height = v-browse-height
     1623             .
     1624             for each buf_temp-browse-handle
     1625               where buf_temp-browse-handle.browse-type = 'height':u
     1626             on error undo, next
     1627             :
     1628               assign
     1629                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1630               .
     1631             end.
     1632             assign
     1633               frame Dialog-Frame :height = v-frame-height
     1634             .
     1635             if frame Dialog-Frame :scrollable = true
     1636             then do:
     1637               assign
     1638                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1639               .
     1640             end.
     1641             run diasize_position-resize-button in this-procedure .
     1642           end.
     1643           else do:
     1644             if frame Dialog-Frame :scrollable = true
     1645             then do:
     1646               assign
     1647                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1648               .
     1649             end.
     1650             assign
     1651               frame Dialog-Frame :height = v-frame-height
     1652             .
     1653             assign
     1654               v-diasize-browse-handle :height = v-browse-height
     1655             .
     1656             for each buf_temp-browse-handle
     1657               where buf_temp-browse-handle.browse-type = 'height':u
     1658             on error undo, next
     1659             :
     1660               assign
     1661                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1662               .
     1663             end.
     1664             for each buf_temp-diasize-handle
     1665             on error undo, next
     1666             :
     1667               assign
     1668                 v-object-handle = buf_temp-diasize-handle.handle-value
     1669               .
     1670               if v-object-handle <> v-diasize-resize-button
     1671               then do:
     1672                 assign
     1673                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1674                 .
     1675               end.
     1676             end.
     1677             run diasize_position-resize-button in this-procedure .
     1678           end.
     1679           assign
     1680             v-diasize-change-size = false
     1681           .
     1682           leave move_block .
     1683         end.
     1684       end.
     1685       assign
     1686         v-diasize-need-full-display = true
     1687       .
     1688       if v-diasize-change-size = false
     1689       then do:
     1690         assign
     1691           v-diasize-change-size = true
     1692         .
     1693       end.
     1694       else do:
     1695         return .
     1696       end.
     1697       assign
     1698         v-frame-height = frame Dialog-Frame :height
     1699         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1700         v-browse-height = v-diasize-browse-handle :height
     1701       .
     1702       for each buf_temp-browse-handle
     1703         where buf_temp-browse-handle.browse-type = 'height':u
     1704       :
     1705         assign
     1706           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1707         .
     1708       end.
     1709       for each buf_temp-diasize-handle
     1710       :
     1711         delete buf_temp-diasize-handle .
     1712       end.
     1713       assign
     1714         v-field-group-handle = frame Dialog-Frame :first-child
     1715       .
     1716       do while valid-handle(v-field-group-handle)
     1717       :
     1718         assign
     1719           v-object-handle = v-field-group-handle :first-child
     1720         .
     1721         do while valid-handle(v-object-handle)
     1722         :
     1723           if  v-object-handle <> v-diasize-browse-handle :handle
     1724           and can-query(v-object-handle, "row")
     1725           and can-query(v-object-handle, "height")
     1726           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1727           then do:
     1728             find first buf_temp-browse-handle
     1729               where buf_temp-browse-handle.browse-type   = 'height':u
     1730                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1731               no-error .
     1732             if available buf_temp-browse-handle
     1733             then do:
     1734             end.
     1735             else do:
     1736               create buf_temp-diasize-handle .
     1737               assign
     1738                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1739                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1740               .
     1741             end.
     1742           end.
     1743           assign
     1744             v-object-handle = v-object-handle :next-sibling
     1745           .
     1746         end.
     1747         assign
     1748           v-field-group-handle = v-field-group-handle :next-sibling
     1749         .
     1750       end.
     1751       do with frame Dialog-Frame
     1752       :
     1753         hide v-diasize-resize-button .
     1754         assign
     1755           v-diasize-resize-button :row    = 1
     1756           v-diasize-resize-button :column = 1
     1757         .
     1758       end.
     1759       if p-change-value > 0
     1760       then do:
     1761         if frame Dialog-Frame :scrollable = true
     1762         then do:
     1763           assign
     1764             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1765             no-error .
     1766           if error-status :error
     1767           or error-status :get-message(1) <> ""
     1768           then do:
     1769             undo move_block, retry move_block .
     1770           end.
     1771         end.
     1772         assign
     1773           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1774           no-error .
     1775         if error-status :error
     1776         or error-status :get-message(1) <> ""
     1777         then do:
     1778           undo move_block, retry move_block .
     1779         end.
     1780         assign
     1781           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1782           no-error .
     1783         if error-status :error
     1784         or error-status :get-message(1) <> ""
     1785         then do:
     1786           undo move_block, retry move_block .
     1787         end.
     1788         for each buf_temp-browse-handle
     1789           where buf_temp-browse-handle.browse-type = 'height':u
     1790         on error undo move_block, retry move_block
     1791         :
     1792           assign
     1793             buf_temp-browse-handle.browse-handle :height
     1794               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1795             no-error .
     1796           if error-status :error
     1797           or error-status :get-message(1) <> ""
     1798           then do:
     1799             undo move_block, retry move_block .
     1800           end.
     1801         end.
     1802         for each buf_temp-diasize-handle
     1803         on error undo move_block, retry move_block
     1804         :
     1805           assign
     1806             v-object-handle = buf_temp-diasize-handle.handle-value
     1807           .
     1808           if v-object-handle <> v-diasize-resize-button
     1809           then do:
     1810             assign
     1811               v-object-handle :row = v-object-handle :row + p-change-value
     1812               no-error .
     1813             if error-status :error
     1814             or error-status :get-message(1) <> ""
     1815             then do:
     1816               undo move_block, retry move_block .
     1817             end.
     1818           end.
     1819         end.
     1820       end.
     1821       else do:
     1822         for each buf_temp-diasize-handle
     1823         on error undo move_block, retry move_block
     1824         :
     1825           assign
     1826             v-object-handle = buf_temp-diasize-handle.handle-value
     1827           .
     1828           if v-object-handle <> v-diasize-resize-button
     1829           then do:
     1830             assign
     1831               v-object-handle :row = v-object-handle :row + p-change-value
     1832               no-error .
     1833             if error-status :error
     1834             or error-status :get-message(1) <> ""
     1835             then do:
     1836               undo move_block, retry move_block .
     1837             end.
     1838           end.
     1839         end.
     1840         assign
     1841           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1842           no-error .
     1843         if error-status :error
     1844         or error-status :get-message(1) <> ""
     1845         then do:
     1846           undo move_block, retry move_block .
     1847         end.
     1848         for each buf_temp-browse-handle
     1849           where buf_temp-browse-handle.browse-type = 'height':u
     1850         on error undo move_block, retry move_block
     1851         :
     1852           assign
     1853             buf_temp-browse-handle.browse-handle :height
     1854               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1855             no-error .
     1856           if error-status :error
     1857           or error-status :get-message(1) <> ""
     1858           then do:
     1859             undo move_block, retry move_block .
     1860           end.
     1861         end.
     1862         assign
     1863           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1864           no-error .
     1865         if error-status :error
     1866         or error-status :get-message(1) <> ""
     1867         then do:
     1868           undo move_block, retry move_block .
     1869         end.
     1870         if frame Dialog-Frame :scrollable = true
     1871         then do:
     1872           assign
     1873             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1874             no-error .
     1875           if error-status :error
     1876           or error-status :get-message(1) <> ""
     1877           then do:
     1878             undo move_block, retry move_block .
     1879           end.
     1880         end.
     1881       end.
     1882       if p-move-resize = true
     1883       then do:
     1884         run diasize_position-resize-button in this-procedure .
     1885       end.
     1886       if v-diasize-wndstore = true
     1887       then do:
     1888         if connected("ub") = true
     1889         then do:
     1890           define variable v-cntxt-db-num        as integer   no-undo .
     1891           define variable v-cntxt-userid        as character no-undo .
     1892           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1893                                             , OUTPUT v-cntxt-userid
     1894                                             ) .
     1895           run gbl/wndsizew.p
     1896             (input  v-cntxt-db-num
     1897             ,input  v-cntxt-userid
     1898             ,input  v-diasize-proc-name
     1899             ,input  'height':u
     1900             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1901             ) .
     1902         end.
     1903       end.
     1904     end.
     1905     assign
     1906       v-diasize-change-size = false
     1907     .
     1908   end procedure.
     1909   procedure diasize_set-height :
     1910     define input  parameter p-new-height  as decimal   no-undo .
     1911     define input  parameter p-move-resize as logical   no-undo .
     1912     do
     1913     on error undo, return error return-value
     1914     :
     1915       run diasize_change-height in this-procedure
     1916         (input  (p-new-height - frame Dialog-Frame :height)
     1917         ,input  p-move-resize
     1918         ) .
     1919     end.
     1920   end procedure.
     1921   procedure diasize_change-width :
     1922     define input  parameter p-change-value as decimal   no-undo .
     1923     define input  parameter p-move-resize  as logical   no-undo .
     1924     define variable v-field-group-handle   as handle    no-undo .
     1925     define variable v-object-handle        as handle    no-undo .
     1926     define variable v-frame-width          as decimal   no-undo .
     1927     define variable v-frame-virtual-width  as decimal   no-undo .
     1928     define variable v-browse-width         as decimal   no-undo .
     1929     define variable v-window-width         as decimal   no-undo .
     1930     define variable v-window-virtual-width as decimal   no-undo .
     1931     define variable v-change-sign          as integer   no-undo .
     1932     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1933     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1934     if p-change-value > 0
     1935     then do:
     1936       if frame Dialog-Frame :width + p-change-value >
     1937           session :width-chars
     1938       then do:
     1939         assign
     1940           p-change-value = session :width-chars - frame Dialog-Frame :width
     1941         .
     1942         if p-change-value <= 0
     1943         then do:
     1944           run diasize_position-resize-button in this-procedure .
     1945           return .
     1946         end.
     1947       end.
     1948     end.
     1949     if p-change-value < 0
     1950     then do:
     1951       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1952       then do:
     1953         assign
     1954           p-change-value = v-diasize-orig-frame-width
     1955                          - frame Dialog-Frame :width
     1956         .
     1957         if p-change-value >= 0
     1958         then do:
     1959           run diasize_position-resize-button in this-procedure .
     1960           return .
     1961         end.
     1962       end.
     1963     end.
     1964     if p-change-value >= 0
     1965     then do:
     1966       assign
     1967         v-change-sign = 1
     1968       .
     1969     end.
     1970     else do:
     1971       assign
     1972         v-change-sign = -1
     1973       .
     1974     end.
     1975     assign
     1976       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1977     .
     1978     if p-change-value = 0
     1979     then do:
     1980       run diasize_position-resize-button in this-procedure .
     1981       return .
     1982     end.
     1983     move_block:
     1984     do
     1985     on error undo move_block, leave move_block
     1986     :
     1987       if retry
     1988       then do:
     1989         do
     1990         on error undo move_block, leave move_block
     1991         :
     1992           if p-change-value > 0
     1993           then do:
     1994             for each buf_temp-diasize-handle
     1995             on error undo, next
     1996             :
     1997               assign
     1998                 v-object-handle = buf_temp-diasize-handle.handle-value
     1999               .
     2000               if v-object-handle <> v-diasize-resize-button
     2001               then do:
     2002                 assign
     2003                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2004                 .
     2005               end.
     2006             end.
     2007             assign
     2008               v-diasize-browse-handle :width = v-browse-width
     2009             .
     2010             for each buf_temp-browse-handle
     2011               where buf_temp-browse-handle.browse-type = 'width':u
     2012             on error undo, next
     2013             :
     2014               assign
     2015                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2016               .
     2017             end.
     2018             assign
     2019               frame Dialog-Frame :width = v-frame-width
     2020             .
     2021             if frame Dialog-Frame :scrollable = true
     2022             then do:
     2023               assign
     2024                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2025               .
     2026             end.
     2027             run diasize_position-resize-button in this-procedure .
     2028           end.
     2029           else do:
     2030             if frame Dialog-Frame :scrollable = true
     2031             then do:
     2032               assign
     2033                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2034               .
     2035             end.
     2036             assign
     2037               frame Dialog-Frame :width = v-frame-width
     2038             .
     2039             for each buf_temp-browse-handle
     2040               where buf_temp-browse-handle.browse-type = 'width':u
     2041             on error undo, next
     2042             :
     2043               assign
     2044                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2045               .
     2046             end.
     2047             assign
     2048               v-diasize-browse-handle :width = v-browse-width
     2049             .
     2050             for each buf_temp-diasize-handle
     2051             on error undo, next
     2052             :
     2053               assign
     2054                 v-object-handle = buf_temp-diasize-handle.handle-value
     2055               .
     2056               if v-object-handle <> v-diasize-resize-button
     2057               then do:
     2058                 assign
     2059                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2060                 .
     2061               end.
     2062             end.
     2063             run diasize_position-resize-button in this-procedure .
     2064           end.
     2065           assign
     2066             v-diasize-change-size = false
     2067           .
     2068           leave move_block .
     2069         end.
     2070       end.
     2071       assign
     2072         v-diasize-need-full-display = true
     2073       .
     2074       if v-diasize-change-size = false
     2075       then do:
     2076         assign
     2077           v-diasize-change-size = true
     2078         .
     2079       end.
     2080       else do:
     2081         return .
     2082       end.
     2083       assign
     2084         v-frame-width = frame Dialog-Frame :width
     2085         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2086         v-browse-width = v-diasize-browse-handle :width
     2087       .
     2088       for each buf_temp-browse-handle
     2089         where buf_temp-browse-handle.browse-type = 'width':u
     2090       :
     2091         assign
     2092           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2093         .
     2094       end.
     2095       for each buf_temp-diasize-handle
     2096       :
     2097         delete buf_temp-diasize-handle .
     2098       end.
     2099       assign
     2100         v-field-group-handle = frame Dialog-Frame :first-child
     2101       .
     2102       do while valid-handle(v-field-group-handle)
     2103       :
     2104         assign
     2105           v-object-handle = v-field-group-handle :first-child
     2106         .
     2107         do while valid-handle(v-object-handle)
     2108         :
     2109           if  v-object-handle <> v-diasize-browse-handle :handle
     2110           and v-object-handle <> v-diasize-resize-button
     2111           and can-query(v-object-handle, "row")
     2112           and can-query(v-object-handle, "height")
     2113           and ( v-object-handle :col + v-object-handle :width
     2114                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2115               )
     2116           then do:
     2117             find first buf_temp-browse-handle
     2118               where buf_temp-browse-handle.browse-type   = 'width':u
     2119                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2120               no-error .
     2121             if available buf_temp-browse-handle
     2122             then do:
     2123             end.
     2124             else do:
     2125               create buf_temp-diasize-handle .
     2126               assign
     2127                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2128                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2129               .
     2130             end.
     2131           end.
     2132           assign
     2133             v-object-handle = v-object-handle :next-sibling
     2134           .
     2135         end.
     2136         assign
     2137           v-field-group-handle = v-field-group-handle :next-sibling
     2138         .
     2139       end.
     2140       do with frame Dialog-Frame
     2141       :
     2142         hide v-diasize-resize-button .
     2143         v-diasize-resize-button :row = 1.
     2144         v-diasize-resize-button :column = 1.
     2145       end.
     2146       if p-change-value > 0
     2147       then do:
     2148         if frame Dialog-Frame :scrollable = true
     2149         then do:
     2150           assign
     2151             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2152             no-error .
     2153           if error-status :error
     2154           or error-status :get-message(1) <> ""
     2155           then do:
     2156             undo move_block, retry move_block.
     2157           end.
     2158         end.
     2159         assign
     2160           frame Dialog-Frame :width = v-frame-width + p-change-value
     2161           no-error .
     2162         if error-status :error
     2163         or error-status :get-message(1) <> ""
     2164         then do:
     2165           undo move_block, retry move_block.
     2166         end.
     2167         assign
     2168           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2169         no-error .
     2170         if error-status :error
     2171         or error-status :get-message(1) <> ""
     2172         then do:
     2173           undo move_block, retry move_block.
     2174         end.
     2175         for each buf_temp-browse-handle
     2176           where buf_temp-browse-handle.browse-type = 'width':u
     2177         on error undo move_block, retry move_block
     2178         :
     2179           assign
     2180             buf_temp-browse-handle.browse-handle :width
     2181               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2182             no-error .
     2183           if error-status :error
     2184           or error-status :get-message(1) <> ""
     2185           then do:
     2186             undo move_block, retry move_block .
     2187           end.
     2188         end.
     2189         for each buf_temp-diasize-handle
     2190         on error undo move_block, retry move_block
     2191         :
     2192           assign
     2193             v-object-handle = buf_temp-diasize-handle.handle-value
     2194           .
     2195           if v-object-handle <> v-diasize-resize-button
     2196           then do:
     2197             assign
     2198               v-object-handle :col = v-object-handle :col + p-change-value
     2199               no-error .
     2200             if error-status :error
     2201             or error-status :get-message(1) <> ""
     2202             then do:
     2203               undo move_block, retry move_block .
     2204             end.
     2205           end.
     2206         end.
     2207       end.
     2208       else do:
     2209         for each buf_temp-diasize-handle
     2210         on error undo move_block, retry move_block
     2211         :
     2212           assign
     2213             v-object-handle = buf_temp-diasize-handle.handle-value
     2214           .
     2215           if v-object-handle <> v-diasize-resize-button
     2216           then do:
     2217             assign
     2218               v-object-handle :col = v-object-handle :col + p-change-value
     2219               no-error .
     2220             if error-status :error
     2221             or error-status :get-message(1) <> ""
     2222             then do:
     2223               undo move_block, retry move_block .
     2224             end.
     2225           end.
     2226         end.
     2227         for each buf_temp-browse-handle
     2228           where buf_temp-browse-handle.browse-type = 'width':u
     2229         on error undo move_block, retry move_block
     2230         :
     2231           assign
     2232             buf_temp-browse-handle.browse-handle :width
     2233               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2234             no-error .
     2235           if error-status :error
     2236           or error-status :get-message(1) <> ""
     2237           then do:
     2238             undo move_block, retry move_block .
     2239           end.
     2240         end.
     2241         assign
     2242           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2243           no-error .
     2244         if error-status :error
     2245         or error-status :get-message(1) <> ""
     2246         then do:
     2247           undo move_block, retry move_block.
     2248         end.
     2249         assign
     2250           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2251         no-error .
     2252         if error-status :error
     2253         or error-status :get-message(1) <> ""
     2254         then do:
     2255           undo move_block, retry move_block.
     2256         end.
     2257         if frame Dialog-Frame :scrollable = true
     2258         then do:
     2259           assign
     2260             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2261           no-error .
     2262           if error-status :error
     2263           or error-status :get-message(1) <> ""
     2264           then do:
     2265             undo move_block, retry move_block.
     2266           end.
     2267         end.
     2268       end.
     2269       if p-move-resize
     2270       then do:
     2271         run diasize_position-resize-button in this-procedure .
     2272       end.
     2273       if v-diasize-wndstore = true
     2274       then do:
     2275         if connected("ub") = true
     2276         then do:
     2277           define variable v-cntxt-db-num        as integer   no-undo .
     2278           define variable v-cntxt-userid        as character no-undo .
     2279           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2280                                             , OUTPUT v-cntxt-userid
     2281                                             ) .
     2282           run gbl/wndsizew.p
     2283             (input  v-cntxt-db-num
     2284             ,input  v-cntxt-userid
     2285             ,input  v-diasize-proc-name
     2286             ,input  'width':u
     2287             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2288             ) .
     2289         end.
     2290       end.
     2291     end.
     2292     assign
     2293       v-diasize-change-size = false
     2294     .
     2295   end procedure.
     2296   procedure diasize_set-width :
     2297     define input  parameter p-new-width  as decimal   no-undo .
     2298     define input  parameter p-move-resize as logical   no-undo .
     2299     do
     2300     on error undo, return error return-value
     2301     :
     2302       run diasize_change-width in this-procedure
     2303         (input  (p-new-width - frame Dialog-Frame :width)
     2304         ,input  p-move-resize
     2305         ) .
     2306     end.
     2307   end procedure.
     2308   procedure diasize_position-resize-button :
     2309     do with frame Dialog-Frame
     2310     :
     2311       hide v-diasize-resize-button .
     2312       assign
     2313         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2314                     - 1
     2315                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2316         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2317                     - 1
     2318                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2319       .
     2320       view v-diasize-resize-button .
     2321     end.
     2322   end procedure.
     2323   on alt-right anywhere
     2324   do:
     2325     run diasize_change-width in this-procedure
     2326       (input 1
     2327       ,input true
     2328       ) .
     2329     return no-apply .
     2330   end.
     2331   on alt-left anywhere
     2332   do:
     2333     run diasize_change-width in this-procedure
     2334       (input -1
     2335       ,input true
     2336       ) .
     2337     return no-apply .
     2338   end.
     2339   on alt-down anywhere
     2340   do:
     2341     run diasize_change-height in this-procedure
     2342       (input 1
     2343       ,input true
     2344       ) .
     2345     return no-apply .
     2346   end.
     2347   on alt-up anywhere
     2348   do:
     2349     run diasize_change-height in this-procedure
     2350       (input -1
     2351       ,input true
     2352       ) .
     2353     return no-apply .
     2354   end.
     2355   on alt-enter of frame Dialog-Frame
     2356   do:
     2357     run diasize_maximize in this-procedure
     2358       (input  ?
     2359       ).
     2360     return no-apply .
     2361   end.
     2362   procedure diasize_end-move :
     2363     do
     2364     on error undo, return error return-value
     2365     :
     2366       define variable v-row-delta as decimal   no-undo .
     2367       define variable v-col-delta as decimal   no-undo .
     2368       define variable v-new-row as decimal   no-undo .
     2369       define variable v-new-col as decimal   no-undo .
     2370       assign
     2371         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2372         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2373       .
     2374       assign
     2375         v-row-delta = v-new-row - frame Dialog-Frame :height
     2376         v-col-delta = v-new-col - frame Dialog-Frame :width
     2377       .
     2378       run diasize_change-height in this-procedure
     2379         (input v-row-delta
     2380         ,input true
     2381         ) .
     2382       run diasize_change-width in this-procedure
     2383         (input v-col-delta
     2384         ,input true
     2385         ) .
     2386     end.
     2387   end procedure.
     2388   procedure diasize_maximize :
     2389     define input  parameter p-action as logical   no-undo .
     2390     do
     2391     on error undo, return error return-value
     2392     :
     2393       if p-action = ?
     2394       then do:
     2395         if v-diasize-need-maximize = true
     2396         then do:
     2397           assign
     2398             p-action = true
     2399           .
     2400         end.
     2401         else do:
     2402           assign
     2403             p-action = false
     2404           .
     2405         end.
     2406       end.
     2407       if p-action = true
     2408       then do:
     2409         run diasize_change-height in this-procedure
     2410           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2411               - frame Dialog-Frame :height-chars
     2412           ,input true
     2413           ) .
     2414         run diasize_change-width in this-procedure
     2415           (input session :width-chars
     2416               - frame Dialog-Frame :width-chars
     2417           ,input true
     2418           ) .
     2419         assign
     2420           v-diasize-need-maximize = false
     2421         .
     2422       end.
     2423       else do:
     2424         run diasize_change-width in this-procedure
     2425           (input v-diasize-orig-frame-width
     2426               - frame Dialog-Frame :width-chars
     2427           ,input true
     2428           ) .
     2429         run diasize_change-height in this-procedure
     2430           (input v-diasize-orig-frame-height
     2431               - frame Dialog-Frame :height-chars
     2432           ,input true
     2433           ) .
     2434         assign
     2435           v-diasize-need-maximize = true
     2436         .
     2437       end.
     2438     end.
     2439   end procedure.
     2440   procedure diasize_restore-orig-size :
     2441     do
     2442     on error undo, return error return-value
     2443     :
     2444       assign
     2445         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2446         v-diasize-current-frame-height = frame Dialog-Frame :height
     2447       .
     2448       run diasize_set-height in this-procedure
     2449         (input  v-diasize-orig-frame-height
     2450         ,input  true
     2451         ) .
     2452       run diasize_set-width in this-procedure
     2453         (input  v-diasize-orig-frame-width
     2454         ,input  true
     2455         ) .
     2456     end.
     2457   end procedure.
     2458   procedure diasize_restore-current-size :
     2459     do
     2460     on error undo, return error return-value
     2461     :
     2462       run diasize_set-height in this-procedure
     2463         (input  v-diasize-current-frame-height
     2464         ,input  true
     2465         ) .
     2466       run diasize_set-width in this-procedure
     2467         (input  v-diasize-current-frame-width
     2468         ,input  true
     2469         ) .
     2470     end.
     2471   end procedure.
     2472   procedure diasize_set-browse-handle :
     2473     define input  parameter p-browse-handle as handle   no-undo .
     2474     define buffer buf_temp-browse-handle for temp-browse-handle .
     2475     do
     2476     on error undo, return error return-value
     2477     :
     2478       assign
     2479         v-diasize-browse-handle = p-browse-handle
     2480       .
     2481       for each buf_temp-browse-handle
     2482       on error undo, return error return-value
     2483       :
     2484         delete buf_temp-browse-handle .
     2485       end.
     2486     end.
     2487   end procedure.
     2488   procedure diasize_add_browse :
     2489     define input  parameter p-browse-type   as character no-undo .
     2490     define input  parameter p-browse-handle as handle    no-undo .
     2491     define buffer buf_temp-browse-handle for temp-browse-handle .
     2492     do
     2493     on error undo, return error return-value
     2494     :
     2495       assign
     2496         v-diasize-browse-number = v-diasize-browse-number + 1
     2497       .
     2498       create buf_temp-browse-handle .
     2499       assign
     2500         buf_temp-browse-handle.browse-type   = p-browse-type
     2501         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2502         buf_temp-browse-handle.browse-handle = p-browse-handle
     2503       .
     2504     end.
     2505   end procedure.
     2506   procedure diasize_init :
     2507     define variable v-default-value    as logical   no-undo .
     2508     define variable v-restore-saved    as logical   no-undo .
     2509     define variable v-resize-value-str as character no-undo .
     2510     do
     2511     on error undo, return error return-value
     2512     :
     2513       do with frame Dialog-Frame
     2514       :
     2515         assign
     2516           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2517           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2518           v-diasize-browse-handle     = browse br-c-cash-desk :handle
     2519         .
     2520         create button v-diasize-resize-button
     2521         assign
     2522           parent        = frame Dialog-Frame :first-child
     2523           label         = "s"
     2524           height-pixels = 16
     2525           width-pixels  = 16
     2526           visible       = true
     2527           sensitive     = true
     2528           movable       = true
     2529           triggers:
     2530             on end-move persistent run diasize_end-move in this-procedure .
     2531           end triggers.
     2532         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2533         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2534         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2535         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2536         assign
     2537           v-diasize-wndmax = false
     2538         .
     2539         if connected("ub") = true
     2540         then do:
     2541           define variable v-cntxt-db-num        as integer   no-undo .
     2542           define variable v-cntxt-userid        as character no-undo .
     2543           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2544                                             , OUTPUT v-cntxt-userid
     2545                                             ) .
     2546           run gbl/wndpar_r.p
     2547             (input  v-cntxt-db-num
     2548             ,input  v-cntxt-userid
     2549             ,input  'wndmax':U
     2550             ,output v-diasize-wndmax
     2551             ,output v-default-value
     2552             ) .
     2553         end.
     2554         assign
     2555           v-diasize-wndstore = false
     2556         .
     2557         if connected("ub") = true
     2558         then do:
     2559           run gbl/wndpar_r.p
     2560             (input  v-cntxt-db-num
     2561             ,input  v-cntxt-userid
     2562             ,input  'wndstore':U
     2563             ,output v-diasize-wndstore
     2564             ,output v-default-value
     2565             ) .
     2566         end.
     2567         assign
     2568           v-diasize-proc-name = entry(1, program-name(2), '.')
     2569         .
     2570         if v-diasize-wndstore = true
     2571         then do:
     2572           assign
     2573             v-restore-saved = false
     2574           .
     2575           if connected("ub") = true
     2576           then do:
     2577             run gbl/wndsizer.p
     2578               (input  v-cntxt-db-num
     2579               ,input  v-cntxt-userid
     2580               ,input  v-diasize-proc-name
     2581               ,input  'height':u
     2582               ,output v-resize-value-str
     2583               ) .
     2584             if v-resize-value-str <> '':U
     2585             then do:
     2586               run diasize_change-height in this-procedure
     2587                 (input  integer(v-resize-value-str)
     2588                 ,input  true
     2589                 ) .
     2590               assign
     2591                 v-restore-saved = true
     2592               .
     2593             end.
     2594           end.
     2595           if connected("ub") = true
     2596           then do:
     2597             run gbl/wndsizer.p
     2598               (input  v-cntxt-db-num
     2599               ,input  v-cntxt-userid
     2600               ,input  v-diasize-proc-name
     2601               ,input  'width':u
     2602               ,output v-resize-value-str
     2603               ) .
     2604             if v-resize-value-str <> '':U
     2605             then do:
     2606               run diasize_change-width in this-procedure
     2607                 (input  integer(v-resize-value-str)
     2608                 ,input  true
     2609                 ) .
     2610               assign
     2611                 v-restore-saved = true
     2612               .
     2613             end.
     2614           end.
     2615           if v-restore-saved <> true
     2616           then do:
     2617             if v-diasize-wndmax = true
     2618             then do:
     2619               run diasize_maximize in this-procedure
     2620                 (input  true
     2621                 ) .
     2622             end.
     2623           end.
     2624         end.
     2625         else do:
     2626           if v-diasize-wndmax = true
     2627           then do:
     2628             run diasize_maximize in this-procedure
     2629               (input  true
     2630               ) .
     2631           end.
     2632         end.
     2633       end.
     2634     end.
     2635   end procedure.
     2636   procedure diasize_need-full-display :
     2637     define output parameter p-need-full-display as logical   no-undo .
     2638     do
     2639     on error undo, return error return-value
     2640     :
     2641       assign
     2642         p-need-full-display = v-diasize-need-full-display
     2643       .
     2644       assign
     2645         v-diasize-need-full-display = false
     2646       .
     2647     end.
     2648   end procedure.
     2649   procedure get-context :
     2650      define output parameter p-db-num as integer          no-undo.
     2651      define output parameter p-user-id as character        no-undo.
     2652      define variable v-login               as character    no-undo.
     2653      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2654      define buffer buf_user-login  for ub.user-login .
     2655      do
     2656      on error undo, return error
     2657      :
     2658            FIND FIRST buf_sys-ctrl no-lock.
     2659            ASSIGN
     2660               v-login = USERID("ub")
     2661               p-db-num = buf_sys-ctrl.db-num
     2662            .
     2663            FIND FIRST buf_user-login
     2664                 WHERE buf_user-login.db-num = p-db-num
     2665                   AND buf_user-login.user-login = v-login
     2666                 no-lock
     2667                 no-error
     2668                 .
     2669            IF AVAILABLE buf_user-login
     2670            THEN DO:
     2671               assign
     2672                  p-user-id = buf_user-login.user-id
     2673               .
     2674            END.
     2675      end.
     2676   end procedure.
     2677   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2678   on f5 of frame Dialog-Frame anywhere
     2679   do:
     2680     v-doc-rec = recid(X_c-cash-desk). run openbr in this-procedure. reposition br-c-cash-desk to recid v-doc-rec no-error.               APPLY 'ENTRY' to br-c-cash-desk. APPLY 'VALUE-CHANGED' to br-c-cash-desk.
     2681       apply "VALUE-CHANGED" to BR-c-cash-desk.
     2682   end.
     2683   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2684   do:
     2685     BR-c-cash-desk :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2686   end.
     2687   def var sort-labelbr-c-cash-desk   as character no-undo .
     2688   def var sort-clmnbr-c-cash-desk    as handle    no-undo .
     2689   def var cur-clmnbr-c-cash-desk     as handle    no-undo .
     2690   def var cur-clmn-locbr-c-cash-desk as integer   no-undo .
     2691   def var re-querybr-c-cash-desk     as logical   initial no no-undo .
     2692   on start-search, ctrl-o of br-c-cash-desk in frame Dialog-Frame do:
     2693      run sort-brbr-c-cash-desk
     2694        (input (if available X_c-cash-desk
     2695                then recid(X_c-cash-desk)
     2696                else ?
     2697               )
     2698        ).
     2699   end.
     2700   PROCEDURE sort-brbr-c-cash-desk :
     2701     define input parameter p-recid as recid no-undo .
     2702     if re-querybr-c-cash-desk = no then do:
     2703       assign
     2704          cur-clmnbr-c-cash-desk = br-c-cash-desk:current-column in frame Dialog-Frame
     2705       .
     2706       if sort-clmnbr-c-cash-desk <> ? then sort-clmnbr-c-cash-desk:column-fgcolor = 0.
     2707       if cur-clmnbr-c-cash-desk = sort-clmnbr-c-cash-desk then do:
     2708         assign
     2709            sort-labelbr-c-cash-desk = ""
     2710            sort-clmnbr-c-cash-desk = ?
     2711         .
     2712        end.
     2713        else do:
     2714          assign
     2715            sort-labelbr-c-cash-desk = cur-clmnbr-c-cash-desk:label
     2716            sort-clmnbr-c-cash-desk  = cur-clmnbr-c-cash-desk
     2717            sort-clmnbr-c-cash-desk:column-fgcolor = 4
     2718          .
     2719        end.
     2720      end.
     2721     assign
     2722       cur-clmn-locbr-c-cash-desk = 1
     2723     .
     2724     def var column-handle as handle no-undo .
     2725     column-handle = br-c-cash-desk:first-column.
     2726     do while valid-handle(column-handle) :
     2727       if column-handle = cur-clmnbr-c-cash-desk then do:
     2728         leave .
     2729       end.
     2730       column-handle = column-handle:NEXT-COLUMN.
     2731       assign
     2732         cur-clmn-locbr-c-cash-desk = cur-clmn-locbr-c-cash-desk + 1
     2733       .
     2734     end.
     2735     case sort-labelbr-c-cash-desk:
     2736           when X_c-cash-desk.corr-date:label in browse br-c-cash-desk then DO:    assign       sort-column-name = "X_c-cash-desk.corr-date"     .     run OpenBr in this-procedure.   . END.
     2737       otherwise do:
     2738         assign
     2739           sort-column-name = ""
     2740         .
     2741         run OpenBr in this-procedure.
     2742         if sort-labelbr-c-cash-desk <> "" then do:
     2743           assign
     2744             cur-clmnbr-c-cash-desk:column-fgcolor = 0
     2745           .
     2746         end.
     2747         assign
     2748           cur-clmn-locbr-c-cash-desk = ?
     2749         .
     2750       end.
     2751     end case.
     2752     if p-recid <> ? then do:
     2753       reposition br-c-cash-desk to recid p-recid no-error.
     2754       apply "value-changed" to br-c-cash-desk in frame Dialog-Frame.
     2755     end.
     2756     apply "entry" to br-c-cash-desk in frame Dialog-Frame.
     2757   END PROCEDURE.
     2758   procedure re-open-query-srt-clmnbr-c-cash-desk:
     2759   if cur-clmnbr-c-cash-desk = ? then do:
     2760      run OpenBr in this-procedure.
     2761   end.
     2762   else do:
     2763      assign re-querybr-c-cash-desk = yes.
     2764      run sort-brbr-c-cash-desk
     2765        (input (if available X_c-cash-desk
     2766                then recid(X_c-cash-desk)
     2767                else ?
     2768               )
     2769        ).
     2770      assign re-querybr-c-cash-desk = no.
     2771   end.
     2772   end.
     2773   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2774   procedure set-filter-name :
     2775   define input parameter p-filter-name as character no-undo .
     2776     do with frame Dialog-Frame:
     2777       if p-filter-name > "" then do:
     2778         assign
     2779           frame Dialog-Frame:title
     2780             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2781         .
     2782         assign
     2783           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2784         .
     2785       end.
     2786       else do:
     2787         assign
     2788           b-sch :tooltip = ""
     2789         .
     2790       end.
     2791     end.
     2792   end procedure.
     2793   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2794   on INS of frame Dialog-Frame anywhere do:
     2795     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     2796     return no-apply.
     2797   end.
     2798   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2799   on F2 of frame Dialog-Frame anywhere do:
     2800     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     2801     return no-apply.
     2802   end.
     2803   MAIN-BLOCK:
     2804   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2805      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2806     CASE parref-mode:
     2807      WHEN 'все':U        THEN DO:
     2808      END.
     2809      WHEN "one":U THEN DO:
     2810        find first X_cash-desk no-lock where
     2811                   X_cash-desk.db-num = pardb-num
     2812              AND  X_cash-desk.obj-code = parobj-code
     2813              AND  X_cash-desk.pos-type = parpos-type
     2814              AND  X_cash-desk.cash-num = parcash-num no-error .
     2815        if not available X_cash-desk then do:
     2816           message
     2817           vss-workfile vss-revision vss-description skip
     2818           "Неверный значение параметров pardb-num parpos-type parobj-type parobj-code parcash-num"
     2819           view-as alert-box ERROR.
     2820           return.
     2821        end.
     2822      END.
     2823      otherwise do:
     2824         message vss-workfile vss-revision vss-description skip
     2825         "Неверный вызов - parref-mode=" parref-mode
     2826         view-as alert-box ERROR.
     2827         return.
     2828       end.
     2829     end case.
     2830     RUN MyEnable in this-procedure .
     2831     HIDE mark-num in frame Dialog-Frame .
     2832     run OpenBR in this-procedure.
     2833     run diasize_add_browse in this-procedure
     2834       (input  'width':u
     2835       ,input  browse br-changes :handle
     2836       ) .
     2837     run diasize_init in this-procedure .
     2838     WAIT-FOR GO OF FRAME Dialog-Frame.
     2839   END.
     2840   RUN disable_UI.
     2841   PROCEDURE disable_UI :
     2842     HIDE FRAME Dialog-Frame.
     2843   END PROCEDURE.
     2844   PROCEDURE enable_UI :
     2845     DISPLAY mark-num
     2846         WITH FRAME Dialog-Frame.
     2847     ENABLE b-quit B-mark b-sel B-sch B-Help mark-num BR-c-cash-desk BR-changes
     2848         WITH FRAME Dialog-Frame.
     2849     VIEW FRAME Dialog-Frame.
     2850   END PROCEDURE.
     2851   PROCEDURE MyEnable :
     2852   br-changes:title in frame Dialog-Frame  = "":U.
     2853   assign
     2854   temp-changes.l_name:resizable in browse br-changes = true
     2855   temp-changes.v_old:resizable in browse br-changes = true
     2856   temp-changes.v_new:resizable in browse br-changes = true
     2857   temp-changes.l_name:width in browse br-changes = 30
     2858   temp-changes.v_old:width in browse br-changes = 40
     2859   temp-changes.v_new:width in browse br-changes = 40
     2860   .
     2861   DISPLAY
     2862   mark-num
     2863   br-changes
     2864   WITH FRAME Dialog-Frame.
     2865   ENABLE
     2866   B-quit
     2867   B-mark when lookup('b-mark':U, bttns) >0
     2868   B-sel when lookup('b-sel':U, bttns) >0
     2869   B-sch
     2870   B-Help
     2871   BR-c-cash-desk
     2872   br-changes
     2873   mark-num
     2874   WITH FRAME Dialog-Frame.
     2875   VIEW FRAME Dialog-Frame.
     2876   END PROCEDURE.
     2877   PROCEDURE OpenBr :
     2878   define variable l-query-was-opened as logical no-undo .
     2879   define variable sort-column-phrase as character no-undo .
     2880   case sort-column-name :
     2881     when "" then do:
     2882       assign
     2883         sort-column-phrase = ""
     2884       .
     2885     end.
     2886     otherwise do:
     2887       assign
     2888         sort-column-phrase = "by " + sort-column-name
     2889       .
     2890     end.
     2891   end case.
     2892   CASE parref-mode:
     2893       when 'все':U then do:
     2894           ASSIGN frame Dialog-Frame:TITLE = "Справочник истории касс"
     2895           filter-point = filter-point0 + parref-mode
     2896           filter-label = substitute("&1", filter-label0)
     2897           .
     2898   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2899   define variable  l-disable-where-23  as logical   no-undo .
     2900   define variable  l-filter-open-23    as logical   .
     2901   define variable  flt-rec-23       as recid     no-undo .
     2902   define variable  filter-name-23      as character no-undo .
     2903   define variable  where-phrase-23     as character no-undo .
     2904   define variable  sort-phrase-23      as character no-undo .
     2905   define variable  where-phrase-rus-23 as character no-undo .
     2906   define variable  sort-phrase-rus-23  as character no-undo .
     2907     run waitfram-show in this-procedure
     2908       (input "ЖДИТЕ ..."
     2909       ).
     2910   run gbl/flt-get.p
     2911     (input filter-point
     2912     ,output flt-rec-23
     2913     ,output filter-name-23
     2914     ,output where-phrase-23
     2915     ,output sort-phrase-23
     2916     ,output where-phrase-rus-23
     2917     ,output sort-phrase-rus-23
     2918     ).
     2919       run set-filter-name in this-procedure
     2920         (INPUT filter-name-23
     2921         ) no-error .
     2922     assign
     2923       l-filter-open-23 = false
     2924     .
     2925     if flt-rec-23 <> ?
     2926       or sort-column-phrase > ""
     2927     then do:
     2928       define variable  parameter-2-23 as character no-undo .
     2929       define variable  parameter-3-23 as character no-undo .
     2930       define variable  parameter-4-23 as character no-undo .
     2931       define variable  parameter-5-23 as character no-undo .
     2932       define variable  parameter-6-23 as character no-undo .
     2933       define variable  parameter-7-23 as character no-undo .
     2934         assign
     2935         parameter-3-23 =
     2936                                 "FOR EACH X_c-cash-desk"
     2937         parameter-4-23 =
     2938           (
     2939             if (" TRUE " + " " + where-phrase-23) <> ""
     2940             then " TRUE " + " " + where-phrase-23
     2941             else "true"
     2942           )
     2943         parameter-5-23 = (" " + "" + " " + "")
     2944         parameter-6-23 = if sort-phrase-23 = ''
     2945                              then
     2946           (
     2947           " " + "  " +
     2948             " " + sort-column-phrase +
     2949           " " + "  "
