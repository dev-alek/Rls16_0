     3237   PROCEDURE proc-b-sch :
     3238   assign
     3239   tbl = 'c-cash-desk'
     3240   join-tbl = 'X_c-cash-desk'
     3241   fld = ""
     3242   lab = ""
     3243   spr = ""
     3244   dim = '0'
     3245   .
