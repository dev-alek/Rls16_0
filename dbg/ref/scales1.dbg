      364   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      365   FUNCTION check-ip returns logical ( input p-ip-string as character, output p-mess as character):
      366   define variable v-ii as integer no-undo .
      367   define variable v-entry as character no-undo .
      368   define variable v-entry-int as integer no-undo .
      369   IF num-entries(p-ip-string, ".") <> 4 then do:
      370     p-mess = substitute("Неверный IP-адрес &1&2" +
      371                         "IP-адрес должен иметь вид NNN.NNN.NNN.NNN"
      372                         ,p-ip-string
      373                         ,chr(10)
      374                         ).
      375     return no.
      376   end.
      377   do v-ii = 1 to 4:
      378     v-entry = entry(v-ii, p-ip-string, '.':U).
      379     assign
      380     v-entry-int = integer(v-entry)
      381     no-error .
      382     if error-status:error then do:
      383       p-mess = substitute("Неверный IP-адрес &1&2" +
      384                           "IP-адрес должен состоять из 4 целых чисел, разделенных точками (NNN.NNN.NNN.NNN)"
      385                           ,p-ip-string
      386                           ,chr(10)
      387                           ).
      388       return no.
      389     end.
      390     if v-entry-int < 0
      391     or v-entry-int > 255
      392     or trim(string(v-entry-int, ">>9")) <> v-entry
      393     then do:
      394       p-mess = substitute("Неверный IP-адрес &1&2" +
      395                           "IP-адрес должен состоять из 4 положительных целых чисел (0-255), разделенных точками (NNN.NNN.NNN.NNN) БЕЗ ЛИДИРУЮЩИХ НУЛЕЙ"
      396                           ,p-ip-string
      397                           ,chr(10)
      398                           ).
      399       return no.
      400     end.
      401   end.
      402   return yes.
      403   END FUNCTION.
      404   define variable v-err-mess as character no-undo .
      405   define variable v-db-num like ub.db.db-num no-undo .
      406   define variable choice as logical no-undo .
      407   define variable v-ok as logical no-undo .
      408   define variable v-mess as character no-undo .
      409   define variable v-address as character no-undo .
      410   define variable v-dopi as integer no-undo .
      411   define buffer buf_db for ub.db.
      412   define buffer buf_scales for ub.scales.
      413   define buffer b-scales for ub.scales.
      414   define buffer dupl_scales for ub.scales.
      415   main-block:
      416   do
      417   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status:get-message (1))
      418   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      419   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      420   :
      421     if p-mode <> 'ДОБАВЛЕНИЕ':U
      422     AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
      423       message
      424       vss-workfile vss-revision vss-description skip
      425       "Неверный параметр p-mode" p-mode
      426       view-as alert-box error .
      427       undo main-block, return error '':u.
      428     end.
      429   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      430   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      431     (output v-db-num
      432     )  .
      433     if LOOKUP(p-scales-type, 'CAS_LP-15,CAS_LP-6,HELMAC_net,HELMAC_model-Z,HELMAC_model-T,CAS_LP-485,BOLET_P-280,BZB-SC515,DIGI_SM-80,CAS_LP-15v1.6,TIGER,MIRA,TIGER2,CAS_LP-16x,DIGI-SM,TIGER-SPCT2,SHTRIH-M,CAS_LP-II,CAS_CL5000J,CAS_CL5000,DIGI_AW-4600_FX,TIGER-SPCT1':U) = 0 then do:
      434       assign
      435       v-err-mess = substitute("Неверный тип весов &1", p-scales-type).
      436       run err-mess(input-output v-err-mess).
      437       undo main-block, return error (if p-silent then v-err-mess else "s-type":U).
      438     end.
      439     find first buf_db no-lock where
      440               buf_db.db-num = p-db-num no-error .
      441     if not avail buf_db then dO:
      442       assign
      443       v-err-mess = substitute("Не найдена БД &1", p-db-num).
      444       run err-mess(input-output v-err-mess).
      445       undo main-block, return error (if p-silent then v-err-mess else '':U).
      446     end.
      447     if p-db-num <> v-db-num
      448     then do:
      449       v-err-mess = substitute("Нельзя изменять запись ВЕСОВ в чужой БД&1" +
      450                               "Номер текущей БД  - &2, номер БД весов - &3"
      451                               ,chr(10)
      452                               ,v-db-num
      453                               ,p-db-num).
      454       run err-mess(input-output v-err-mess).
      455       undo main-block, return error (if p-silent then v-err-mess else "":U).
      456     end.
      457     if p-scales-num = 0 then do:
      458       assign
      459       v-err-mess = substitute("Не указан номер весов !") .
      460       run err-mess(input-output v-err-mess).
      461       undo main-block, return error (if p-silent then v-err-mess else "scales-num":U).
      462     end.
      463     if p-scales-type = "TIGER-SPCT2"
      464     and p-scales-num > 99 then do:
      465       assign
      466       v-err-mess = substitute("Для весов типа &1 номер весов не может быть > 99!", p-scales-num)
      467       .
      468       run err-mess(input-output v-err-mess).
      469       undo main-block, return error (if p-silent then v-err-mess else "scales-num":U).
      470     end.
      471     if p-scales-name = "" then do:
      472       assign
      473       v-err-mess = substitute("Не указано название весов !")
      474       .
      475       run err-mess(input-output v-err-mess).
      476       undo main-block, return error (if p-silent then v-err-mess else "scales-name":U).
      477     end.
      478     if p-address = "" then do:
      479       assign
      480       v-err-mess = substitute("Не задан адрес для весов!").
      481       run err-mess(input-output v-err-mess).
      482       undo main-block, return error (if p-silent then v-err-mess else "address":U).
      483     end.
      484     if p-scales-type = 'DIGI-SM' then do:
      485       v-ok = check-ip ( input p-address, output v-mess).
      486       if not v-ok then do:
      487         assign
      488         v-err-mess = v-mess.
      489         run err-mess(input-output v-err-mess).
      490         undo main-block, return error (if p-silent then v-err-mess else "address":U).
      491       end.
      492     end.
      493     if p-scales-type = 'SHTRIH-M'
      494     then do:
      495       if num-entries(p-address, ":") <> 2 then do:
      496         assign
      497         v-err-mess = substitute("Формат адреса весов данного типа:&1" +                    "nnn.nnn.nnn.nnn:port - для весов, работающих по TCP-IP&1" +                    "COMn:timeout - для весов, работающих по RS232"                    , chr(10)                    ).
      498         run err-mess(input-output v-err-mess).
      499         undo main-block, return error (if p-silent then v-err-mess else "address":U).
      500         .
      501       end.
      502       assign
      503       v-ok = (integer( entry(2, p-address, ":")) > 0)
      504       no-error.
      505       if not v-ok
      506       or trim(entry(2, p-address, ":"), "1234567890") <> "" then do:
      507         assign
      508         v-err-mess = substitute("Формат адреса весов данного типа:&1" +                    "nnn.nnn.nnn.nnn:port - для весов, работающих по TCP-IP&1" +                    "COMn:timeout - для весов, работающих по RS232"                    , chr(10)                    ).
      509         run err-mess(input-output v-err-mess).
      510         undo main-block, return error (if p-silent then v-err-mess else "address":U).
      511         .
      512       end.
      513       if  entry(1, p-address, ":") begins "COM" then do:
      514         assign
      515         v-ok = (integer( entry(1, p-address, ":")) > 0)
      516         no-error.
      517         if not v-ok
      518         or trim(entry(2, p-address, ":"), "1234567890") <> "" then do:
      519           assign
      520           v-err-mess = substitute("Формат адреса весов данного типа:&1" +                    "nnn.nnn.nnn.nnn:port - для весов, работающих по TCP-IP&1" +                    "COMn:timeout - для весов, работающих по RS232"                    , chr(10)                    ).
      521           run err-mess(input-output v-err-mess).
      522           undo main-block, return error (if p-silent then v-err-mess else "address":U).
      523           .
      524         end.
      525       end.
      526       else do:
      527         v-ok = check-ip ( input entry(1, p-address, ":"), output v-mess).
      528         if not v-ok then do:
      529           assign
      530           v-err-mess = v-mess + chr(10) + substitute("Формат адреса весов данного типа:&1" +                    "nnn.nnn.nnn.nnn:port - для весов, работающих по TCP-IP&1" +                    "COMn:timeout - для весов, работающих по RS232"                    , chr(10)                    ).
      531           run err-mess(input-output v-err-mess).
      532           undo main-block, return error (if p-silent then v-err-mess else "address":U).
      533         end.
      534       end.
      535     end.
      536     if p-scales-type = 'CAS_CL5000J'
      537     or p-scales-type = 'CAS_CL5000'
      538     then do:
      539       if num-entries(p-address) <> 2 then do:
      540         assign
      541         v-err-mess = substitute("Формат адреса весов данного типа:&1" +                    "nnn.nnn.nnn.nnn:port,№ - для весов, работающих по TCP-IP&1"                     , chr(10)                    ).
      542         run err-mess(input-output v-err-mess).
      543         undo main-block, return error (if p-silent then v-err-mess else "address":U).
      544         .
      545       end.
      546       if entry(2, p-address) <> string(p-scales-num) then do:
      547         assign
      548         v-err-mess = substitute("Формат адреса весов данного типа:&1" +                    "nnn.nnn.nnn.nnn:port,№ - для весов, работающих по TCP-IP&1"                     , chr(10)                    ).
      549         run err-mess(input-output v-err-mess).
      550         undo main-block, return error (if p-silent then v-err-mess else "address":U).
      551         .
      552       end.
      553       if num-entries(p-address, ":") <> 2 then do:
      554         assign
      555         v-err-mess = substitute("Формат адреса весов данного типа:&1" +                    "nnn.nnn.nnn.nnn:port,№ - для весов, работающих по TCP-IP&1"                     , chr(10)                    ).
      556         run err-mess(input-output v-err-mess).
      557         undo main-block, return error (if p-silent then v-err-mess else "address":U).
      558         .
      559       end.
      560       v-address = entry(1, p-address).
      561       assign
      562       v-ok = (integer( entry(2, v-address, ":")) > 0)
      563       no-error.
      564       if not v-ok
      565       or trim(entry(2, v-address, ":"), "1234567890") <> "" then do:
      566         assign
      567         v-err-mess = substitute("Формат адреса весов данного типа:&1" +                    "nnn.nnn.nnn.nnn:port,№ - для весов, работающих по TCP-IP&1"                     , chr(10)                    ).
      568         run err-mess(input-output v-err-mess).
      569         undo main-block, return error (if p-silent then v-err-mess else "address":U).
      570         .
      571       end.
      572       v-ok = check-ip ( input entry(1, v-address, ":"), output v-mess).
      573       if not v-ok then do:
      574         assign
      575         v-err-mess = v-mess + chr(10) + substitute("Формат адреса весов данного типа:&1" +                    "nnn.nnn.nnn.nnn:port,№ - для весов, работающих по TCP-IP&1"                     , chr(10)                    ).
      576         run err-mess(input-output v-err-mess).
      577         undo main-block, return error (if p-silent then v-err-mess else "address":U).
      578       end.
      579     end.
      580     if p-scales-type = "" then do:
      581       v-ok = check-ip ( input entry(1, p-address, ":"), output v-mess).
      582       if not v-ok then do:
      583         assign
      584         v-err-mess = v-mess + chr(10) + substitute("Формат адреса весов данного типа:&1" +                    "nnn.nnn.nnn.nnn:port&1"                     , chr(10)                    ).
      585         run err-mess(input-output v-err-mess).
      586         undo main-block, return error (if p-silent then v-err-mess else "address":U).
      587       end.
      588       if num-entries(p-address, ":") <> 2 then do:
      589         assign
      590         v-err-mess = substitute("Формат адреса весов данного типа:&1" +                    "nnn.nnn.nnn.nnn:port&1"                     , chr(10)                    ).
      591         run err-mess(input-output v-err-mess).
      592         undo main-block, return error (if p-silent then v-err-mess else "address":U).
      593         .
      594       end.
      595       assign
      596       v-dopi = integer(entry(2, p-address, ":"))
      597       no-error.
      598       if entry(2, p-address, ":") <> string(v-dopi, ">>>>9") then do:
      599         assign
      600         v-err-mess = substitute("Формат адреса весов данного типа:&1" +                    "nnn.nnn.nnn.nnn:port&1"                     , chr(10)                    ).
      601         run err-mess(input-output v-err-mess).
      602         undo main-block, return error (if p-silent then v-err-mess else "address":U).
      603         .
      604       end.
      605     end.
      606     if p-unit-base = "" then do:
      607       assign
      608       v-err-mess = substitute("Не задана единица измерения весов !").
      609       run err-mess(input-output v-err-mess).
      610       undo main-block, return error (if p-silent then v-err-mess else "unit-base":U).
      611     end.
      612     if NOT can-find( first ub.units where
      613                           ub.units.unit-name = p-unit-base ) then do:
      614       assign
      615       v-err-mess = substitute("Введенная Вами единица измерения &1&2" +
      616                               "ОТСУТСТВУЕТ в справочнике единиц измерений !"
      617                             , p-unit-base).
      618       run err-mess(input-output v-err-mess).
      619       undo main-block, return error (if p-silent then v-err-mess else "unit-base":U).
      620     end.
      621     if p-max-gds = 0 then do:
      622       assign
      623       v-err-mess = substitute("Не указана номенклатура (максимальное количество товаров на весах)!")
      624       .
      625       run err-mess(input-output v-err-mess).
      626       undo main-block, return error (if p-silent then v-err-mess else "max-gds":U).
      627     end.
      628     if p-master > 0 then do:
      629       FIND FIRST b-scales where
      630                 b-scales.db-num = p-db-num
      631           AND b-scales.scales-num = p-master
      632       No-ERROR.
      633       if not avail b-scales then do:
      634           v-err-mess = substitute("Не найдены главные весы № &1 в БД &2&3," +
      635                                 "подчиненными которым будут весы &4!"
      636                                 , p-master
      637                                 , p-db-num
      638                                 , chr(10)
      639                                 , p-scales-num).
      640         run err-mess(input-output v-err-mess).
      641         undo main-block, return error (if p-silent then v-err-mess else "":U).
      642       end.
      643       if p-master = p-scales-num then do:
      644         v-err-mess = substitute("Весы не могут быть главными сами для себя!").
      645         run err-mess(input-output v-err-mess).
      646         undo main-block, return error (if p-silent then v-err-mess else "":U).
      647       end.
      648       if b-scales.scales-type <> p-scales-type
      649       OR b-scales.max-gds <> p-max-gds
      650       OR b-scales.unit-base <> p-unit-base then do:
      651         v-err-mess = substitute("Главные весы имеют отличный от данных весов ТИП или&1"  +
      652                                 "НОМЕНКЛАТУРУ или ЕДИНИЦУ ИЗМЕРЕНИЯ!"
      653                                 , chr(10)).
      654         run err-mess(input-output v-err-mess).
      655       end.
      656       if b-scales.master > 0 then do:
      657         v-err-mess =  substitute("Главные-весы &1 в БД &2 сами по себе являются подчиненными для других весов!"
      658                                 ,  b-scales.scales-num
      659                                 , b-scales.db-num).
      660         run err-mess(input-output v-err-mess).
      661         undo main-block, return error (if p-silent then v-err-mess else "":U).
      662       end.
      663     end.
      664     find first  dupl_scales no-lock where
      665                 dupl_scales.db-num = p-db-num
      666             AND dupl_scales.address = p-address
      667             and dupl_scales.scales-num <> p-scales-num
      668             no-error .
      669     if available dupl_scales
      670     then do:
      671       assign
      672       v-err-mess = substitute("Весы с адресом уже &1 есть в БД &2&3- весы № &4 &5!"
      673                               ,p-address
      674                               ,p-db-num
      675                               , chr(10)
      676                               ,dupl_scales.scales-num
      677                               ,dupl_scales.scales-name).
      678       if p-silent then do:
      679         run err-mess(input-output v-err-mess).
      680         undo main-block, return error v-err-mess.
      681       end.
      682       else do:
      683         message
      684         v-err-mess skip
      685         "Вас это устраивает ?"
      686         view-as alert-box WARNING buttons YES-NO update choice .
      687         if NOT choice then undo main-block, return error '':U.
      688       end.
      689     end.
      690     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      691       if can-find (ub.scales where
      692                     ub.scales.db-num  = p-db-num
      693                 AND ub.scales.scales-num = p-scales-num )  then do:
      694         assign
      695         v-err-mess = substitute("В БД &1 Весы с таким номером уже есть!", p-db-num)
      696         .
      697         run err-mess(input-output v-err-mess).
      698         undo main-block, return error (if p-silent then v-err-mess else "":U).
      699       end.
      700       create buf_scales.
      701       assign
      702       buf_scales.scales-num   = p-scales-num
      703       buf_scales.scales-name  = p-scales-name
      704       buf_scales.max-gds      = p-max-gds
      705       buf_scales.address      = p-address
      706       buf_scales.unit-base    = p-unit-base
      707       buf_scales.master       = p-master
      708       buf_scales.db-num = p-db-num
      709       buf_scales.scales-type = p-scales-type
      710       buf_scales.tot-gds = (if buf_scales.master > 0
      711                             then b-scales.tot-gds else buf_scales.tot-gds)
      712       buf_scales.to-send = (if buf_scales.master > 0
      713                             then b-scales.to-send
      714                             else buf_scales.to-send)
      715       p-doc-rec = recid(buf_scales)
      716       .
      717     end.
      718     else do:
      719       FIND FIRST buf_scales where
      720                 recid(buf_scales) = p-doc-rec No-ERROR.
      721       if not available buf_scales then do:
      722         v-err-mess = substitute("&1 &2 &3&4" +
      723                                 "Не найдена запись ВЕСЫ - p-doc-rec &5"
      724                                 ,vss-workfile
      725                                 ,vss-revision
      726                                 ,vss-description
      727                                 ,chr(10)
      728                                 , p-doc-rec ).
      729         run err-mess(input-output v-err-mess).
      730         undo main-block, return error (if p-silent then v-err-mess else "":U).
      731       end.
      732       if buf_scales.db-num <> p-db-num
      733       OR buf_scales.scales-num <> p-scales-num
      734       then do:
      735         v-err-mess = substitute("&1 &2 &3&4" +
      736                                "Для уже имеющейся записи нельзя изменить&4" +
      737                                "номер БД и номер весов"
      738                                 ,vss-workfile
      739                                 ,vss-revision
      740                                 ,vss-description
      741                                 ,chr(10)).
      742         run err-mess(input-output v-err-mess).
      743         undo main-block, return error (if p-silent then v-err-mess else "":U).
      744       end.
      745       if p-max-gds < buf_scales.max-gds
      746       AND ( can-find( FIRST ub.scales-gds WHERE
      747                           ub.scales-gds.db-num = p-db-num
      748                       AND ub.scales-gds.scales-num = p-scales-num ) ) then do:
      749         v-err-mess = substitute("Есть товары на весах &1 БД &2&3" +
      750                                 "Уменьшение номенклатуры невозможно!"
      751                               , p-scales-num
      752                               , p-db-num
      753                               , chr(10)).
      754         run err-mess(input-output v-err-mess).
      755         undo main-block, return error (if p-silent then v-err-mess else "":U).
      756       end.
      757       if p-scales-type <> buf_scales.scales-type
      758       and buf_scales.tot-gds <> 0
      759       then do:
      760         assign
      761         v-err-mess = substitute("Для уже имеющихся весов, к которым привязаны товары,&1" +
      762                                 "изменение типа весов может нарушить работу весов"
      763                                 , chr(10))
      764         .
      765         if p-silent then do:
      766           run err-mess(input-output v-err-mess).
      767           undo main-block, return error v-err-mess.
      768         end.
      769         else do:
      770           message
      771           v-err-mess skip
      772           "Все равно изменить тип весов?"
      773           view-as alert-box WARNING buttons YES-NO update choice .
      774           if NOT choice then undo main-block, return error '':U.
      775         end.
      776       end.
      777       assign
      778       buf_scales.scales-name = p-scales-name
      779       buf_scales.max-gds     = p-max-gds
      780       buf_scales.address     = p-address
      781       buf_scales.unit-base   = p-unit-base
      782       buf_scales.master      = p-master
      783       buf_scales.scales-type = p-scales-type
      784       .
      785     end.
      786     release buf_Scales no-error.
      787     if error-status:error then do:
      788       v-err-mess = substitute("&1 &2 &3&4" +
      789                               "Ошибка при сохранении записи ВЕСЫ&4" +
      790                               "&5&4&6&4"
      791                               ,vss-workfile
      792                               ,vss-revision
      793                               ,vss-description
      794                               ,chr(10)
      795                               , error-status:get-message(1)
      796                               , return-value ).
      797       run err-mess(input-output v-err-mess).
      798       undo main-block, return error (if p-silent then v-err-mess else "":U).
      799     end.
      800   end.
      801   PROCEDURE err-mess:
      802   DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      803   p-mess = substitute("Ошибка при сохранении/изменении ВЕСОВ № &1 БД &2&3&4"
      804                     , p-scales-num
      805                     , p-db-num
      806                     , chr(10)
      807                     , p-mess) .
      808   if not p-silent then
      809   message
      810   p-mess
      811   view-as alert-box error .
      812   END PROCEDURE.
