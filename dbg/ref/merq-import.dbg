      395     field update_Date    as date      label "Дата изменени" format "99.99.9999"
      396     field prod-type      as integer   label "Тип продукции" format ">>>>9"
      397     field prod-type-name as character label "Тип продукции"
      398     field GUID-type      as character label "GUID-type"
      399     field GUID-subtype   as character label "GUID-subtype"
