      486     BGCOLOR 8 .
      487   DEFINE VARIABLE file-name AS CHARACTER FORMAT "X(256)":U
      488     LABEL "Файл для импорта"
      489     VIEW-AS FILL-IN
      490     SIZE 35.88 BY 1 NO-UNDO.
      491   DEFINE FRAME Dialog-Frame
      492     B-exit AT ROW 1 COL 1
      493     b-quit AT ROW 1 COL 11
      494     B-Help AT ROW 1 COL 58
      495     file-name AT ROW 3.42 COL 1.38 WIDGET-ID 16
      496     B-file AT ROW 3.42 COL 55.75 WIDGET-ID 20
      497     SPACE(2.99) SKIP(2.36)
      498     WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      499     SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      500     TITLE "Импорт товаров"
      501     DEFAULT-BUTTON B-exit.
      502   ASSIGN
      503     FRAME Dialog-Frame:SCROLLABLE = FALSE
      504     FRAME Dialog-Frame:HIDDEN     = TRUE.
      505   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      506     DO:
      507       APPLY "END-ERROR":U TO SELF.
      508     END.
      509   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      510     DO:
      511       if  trim(file-name) = "" then
      512       do:
      513         message "Не задан файл для импорта "
      514           view-as alert-box ERROR.
      515         return no-apply.
      516       end.
      517       RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      518       IF ERROR-STATUS:error THEN RETURN NO-APPLY.
      519     END.
      520   ON CHOOSE OF B-file IN FRAME Dialog-Frame
      521     DO:
      522       DEF VAR ll_commit AS LOG NO-UNDO INIT NO.
      523       SYSTEM-DIALOG GET-FILE v_file
      524         TITLE "Выберите файл для импорта"
      525         FILTERS "Текстовый файл (*.txt)" "*.txt"
      526         MUST-EXIST
      527         USE-FILENAME
      528         .
      529       ASSIGN
      530         file-name = ( IF SEARCH( v_file ) = ? THEN v_file ELSE SEARCH( v_file ) ).
      531       DISP file-name WITH FRAME Dialog-Frame.
      532     END.
      533   ON LEAVE OF file-name IN FRAME Dialog-Frame
      534     DO:
      535       ASSIGN file-name.
      536       IF SEARCH( file-name ) <> ? AND SEARCH( file-name ) <> "":U THEN
      537       DO:
      538         ASSIGN
      539           FILE-INFO:FILE-NAME = file-name.
      540         IF FILE-INFO:FULL-PATHNAME <> ? THEN ASSIGN file-name = FILE-INFO:FULL-PATHNAME.
      541         DISP file-name WITH FRAME Dialog-Frame.
      542       END.
      543     END.
      544   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      545     THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      546   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      547   on help of frame Dialog-Frame
      548   do:
      549     run gbl/app_help.p
      550       (input this-procedure :file-name
      551       ,input ''
      552       ,input ?
      553       ) no-error.
      554     if error-status :error then do:
      555       message
      556         "Ошибка при вызове помощи"
      557         error-status :get-message(1)
      558         view-as alert-box .
      559     end.
      560   end.
      561   run minbtn-set in this-procedure .
      562   on choose of b-help in frame Dialog-Frame
      563   do:
      564     apply "help":u to frame Dialog-Frame .
      565   end.
      566   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      567   procedure minbtn-set :
      568       do
      569           on error undo, return error return-value
      570           :
      571           define variable ii              as integer       no-undo .
      572           define variable fh              as widget-handle no-undo .
      573           define variable hh              as widget-handle no-undo .
      574           define variable v-h             as handle        extent 4 no-undo .
      575           define variable v-name-button   as character     no-undo .
      576           define variable v-help-old-x    as decimal       no-undo .
      577           define variable v-help-old-y    as decimal       no-undo .
      578           define variable v-help-old-size as decimal       no-undo .
      579           define variable v-frame-width   as decimal       no-undo .
      580           define variable jj              as integer       no-undo .
      581           do
      582               on error undo, return error
      583               :
      584               assign
      585                   v-frame-width = frame Dialog-Frame:width - 0.3
      586                   fh            = frame Dialog-Frame:first-child
      587                   hh            = fh:first-child
      588                   ii            = 1
      589                   .
      590               do while valid-handle(hh):
      591                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      592                   do:
      593                       case lc(hh:name) :
      594                           when "b-help" then
      595                               do:
      596                                   hh:load-image-up("cmp/b-help.bmp":u) .
      597                                   hh:load-image-down("cmp/b-help.bmp":u) .
      598                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      599                                   hh:TOOLTIP = "Помощь" .
      600                                   v-help-old-x = hh:column .
      601                                   v-help-old-y = hh:row    .
      602                                   v-help-old-size = hh:width .
      603                                   hh:width-chars = 2.5 .
      604                               end.
      605                           when "b-print" then
      606                               do:
      607                                   hh:load-image("cmp/b-print.bmp":u) .
      608                                   hh:TOOLTIP = "Печать" .
      609                                   v-h[ii] = hh:handle .
      610                                   ii = ii + 1 .
      611                                   hh:width-chars = 3 .
      612                               end.
      613                           when "b-history" or
      614                           when "b-hist" then
      615                               do:
      616                                   hh:load-image("cmp/b-hist.bmp":u) .
      617                                   hh:TOOLTIP = "История" .
      618                                   v-h[ii] = hh:handle .
      619                                   ii = ii + 1 .
      620                                   hh:width-chars = 3 .
      621                               end.
      622                           when "b-sch" then
      623                               do:
      624                                   hh:load-image("cmp/b-sch.bmp":u) .
      625                                   hh:TOOLTIP = "Установка Фильтра" .
      626                                   v-h[ii] = hh:handle .
      627                                   ii = ii + 1 .
      628                                   hh:width-chars = 3 .
      629                               end.
      630                           when "b-hist-user" then
      631                               do:
      632                                   hh:load-image("cmp/b-hist.bmp":u) .
      633                                   hh:TOOLTIP = "История пользователя" .
      634                                   ii = ii + 1 .
      635                               end.
      636                       end case.
      637                   end.
      638                   hh = hh:next-sibling.
      639               end.
      640               b-help:column = v-frame-width - b-help:width-chars.
      641               jj = 0.
      642               repeat ii = 4 to 1 by -1 :
      643                   if valid-handle (v-h[ii] ) then
      644                   do:
      645                       jj  = jj + 1 .
      646                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      647                       v-h[ii]:row    = v-help-old-y .
      648                   end.
      649               end.
      650           end.
      651       end.
      652   end procedure.
      653   MAIN-BLOCK:
      654   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      655     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      656     RUN enable_UI IN THIS-PROCEDURE.
      657     WAIT-FOR GO OF FRAME Dialog-Frame.
      658   END.
      659   RUN disable_UI.
      660   PROCEDURE disable_UI :
      661     HIDE FRAME Dialog-Frame.
      662   END PROCEDURE.
      663   PROCEDURE enable_UI :
      664     DISPLAY file-name
      665       WITH FRAME Dialog-Frame.
      666     ENABLE B-exit b-quit B-Help file-name B-file
      667       WITH FRAME Dialog-Frame.
      668     VIEW FRAME Dialog-Frame.
      669   END PROCEDURE.
      670   PROCEDURE proc-save :
      671     define variable gdsMercsubsObj as class     gdsmercsubs.
      672     define variable gdsMercObj     as class     gdsmercsub.
      673     define variable gdsmercstrObj  as class     gdsmercstr.
      674     define variable ii             as integer   no-undo .
      675     DEFINE VARIABLE V-GUID         AS CHARACTER NO-UNDO .
      676     define VARIABLE Msg            as character no-undo .
      677     empty TEMP-TABLE tt-gds-answer .
      678     gdsMercsubsObj = new gdsmercsubs ().
      679     gdsmercstrObj = new gdsmercstr ().
      680     gdsMercObj = new gdsmercsub().
      681     input stream imp from value (file-name) .
      682     repeat:
      683       IMPORT stream imp UNFORMATTED text-string .
      684       if trim(text-string) = "" then   leave.
      685       impc = impc + 1.
      686       if num-entries (text-string, ";") < 3 then
      687       do:
      688         N-param = num-entries (text-string, ";").
      689         OUTPUT stream Err TO value ("Imp_mercur.err") append.
      690         put stream Err unformatted
      691           string(today, "99/99/9999") " "
      692           string(time, "HH:MM")
      693           " Неправильное число параметров в строке, должно быть 3 "  N-param skip.
      694         export stream  Err text-string .
      695         output stream Err close.
      696         next.
      697       end.
      698       find first buf_goods NO-LOCK where buf_goods.gds-code = INTEGER (ENTRY( 1, text-string, ";")) no-error .
      699       if not AVAILABLE (buf_goods) then
      700       do:
      701         find FIRST buf_goods  NO-LOCK where buf_goods.artic = ENTRY( 2, text-string, ";") no-error .
      702         if not AVAILABLE (buf_goods) then
      703         do:
      704           OUTPUT stream Err TO value ("Imp_mercur.err") append.
      705           put stream Err unformatted
      706             string(today, "99/99/9999") " "
      707             string(time, "HH:MM")
      708             " Нет товара с таким кодом и артикулом"  skip.
      709           export stream  Err text-string .
      710           output stream Err close.
      711           next.
      712         end.
      713       end.
      714       else
      715       do:
      716         find first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_goods.gds-code and buf_goods-attr.attr-code = 'mercur_FGIS':U
      717           and buf_goods-attr.attr-value = "yes" no-error .
      718         if not AVAILABLE (buf_goods-attr) then
      719         do:
      720           OUTPUT stream Err TO value ("Imp_mercur.err") append.
      721           put stream Err unformatted
      722             string(today, "99/99/9999") " "
      723             string(time, "HH:MM")
      724             " У товара нет атрибута - не загружен"  skip.
      725           export stream  Err text-string .
      726           output stream Err close.
      727           next.
      728         end.
      729         else
      730         do:
      731           V-GUID = ENTRY( 3, text-string, ";") .
      732           run checkguid(INPUT-OUTPUT V-GUID,OUTPUT Msg) no-error .
      733           if Msg <> "" then
      734           do:
      735             OUTPUT stream Err TO value ("Imp_mercur.err") append.
      736             put stream Err unformatted
      737               string(today, "99/99/9999") " "
      738               string(time, "HH:MM")
      739               " Неверный формат поля GUID - не загружен" skip.
      740             export stream  Err text-string .
      741             output stream Err close.
      742             next.
      743           end.
      744           p-list = p-list + "," + STRING (buf_goods-attr.gds-code) .
      745           gdsMercsubsObj = gdsmercstrObj:getgdsmercs(buf_goods-attr.gds-code).
      746           if VALID-OBJECT (gdsMercsubsObj:GdsMercsubsCurr) then
      747           do:
      748             do ii = 1 to gdsMercsubsObj:GetItem (ii):
      749               gdsMercObj = gdsMercsubsObj:GdsMercsubsCurr.
      750             end.
      751             gdsMercObj:GUID_       = V-GUID .
      752             gdsmercstrObj:updateDB(gdsMercObj).
      753             OUTPUT stream Err TO value ("Imp_mercur.err") append.
      754             put stream Err unformatted
      755               string(today, "99/99/9999") " "
      756               string(time, "HH:MM")
      757               " Изменили GUID у товара" skip.
      758             export stream  Err text-string .
      759             output stream Err close.
      760             next.
      761           end.
      762           else
      763           do:
      764             gdsMercObj = new gdsmercsub().
      765             gdsMercObj:GUID_       = V-GUID .
      766             gdsMercObj:GdsCode     = buf_goods-attr.gds-code .
      767             gdsmercstrObj:insertDB(gdsMercObj).
      768           end.
      769         end.
      770         display
      771           impc  label "Прочитано"
      772           text-string format "x(40)" label "Строка файла"
      773           with frame ff view-as dialog-box
      774           title ": Импорт справочника товаров из файла".
      775         pause 0.
      776       end.
      777     end.
      778     input stream imp close.
      779     p-list = TRIM (p-list) .
      780     message ("Импорт из файла " + file-name + " закончен, прочитано " + string(impc) +
      781       ",  " ) skip
      782       "Все строки из файла которые не удалось импортировать можно посмотреть в файле Imp_goods.err "
      783       view-as alert-box  .
      784     delete object gdsMercObj no-error .
      785     delete object gdsmercstrObj no-error .
      786     delete object gdsMercsubsObj no-error .
      787   END PROCEDURE.
      788   PROCEDURE send-news :
      789     for each ub.gds-mercury EXCLUSIVE-LOCK:
      790       run str/callnews.p
      791         (input 'gds-mercury':U
      792         ,input (buffer ub.gds-mercury:handle)
      793         ) no-error .
      794       if error-status :error then
      795       do:
      796         message
      797           error-status :get-message(1) skip
      798           return-value skip
      799           view-as alert-box.
      800         return error.
      801       end.
      802     end.
      803   END PROCEDURE.
