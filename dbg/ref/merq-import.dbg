      469   DEFINE BUTTON B-exit AUTO-GO
      470     LABEL "&Выполнить"
      471     SIZE 10 BY 1
      472     BGCOLOR 8 .
      473   DEFINE BUTTON B-file
      474     IMAGE-UP FILE "btn-down-arrow":U
      475     IMAGE-DOWN FILE "btn-down-arrow":U
      476     IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      477     LABEL ""
      478     SIZE 3 BY 1.
      479   DEFINE BUTTON B-Help
      480     LABEL "Помо&щь"
      481     SIZE 3 BY 1
      482     BGCOLOR 8 .
      483   DEFINE BUTTON b-quit AUTO-END-KEY
      484     LABEL "&Отмена"
