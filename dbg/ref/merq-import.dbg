      386   define temp-table tt-gds-merq no-undo
      387     field ID             as integer
      388     field merc-name      like ub.goods.gds-name label "Полное наименование" format "X(100)"
      389     field UUID           as character label "UUID"
      390     field GUID_          as character label "GUID"
      391     field units          as character label "Ед.измерения"
      392     field units_th       as character label "Ед.измерения в ТН"
      393     field status_        as integer   label "Статус"
