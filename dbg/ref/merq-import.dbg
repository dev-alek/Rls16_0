      406     .
      407   PROCEDURE checkguid :
      408     define INPUT-output parameter guid_ as CHARACTER NO-UNDO .
      409     define OUTPUT parameter Msg as CHARACTER  NO-UNDO .
      410     def var ii      as int       no-undo.
      411     def var err     as logical   no-undo.
      412     def var str     as character no-undo.
      413     def var numentr as integer   no-undo.
      414     numentr = num-entries (guid_, "-") no-error.
      415     if numentr = 8
      416       then
      417     do:
      418       do ii = 1 to numentr:
      419         if length (trim (entry (ii, guid_, "-"))) <> 4
      420           then err = true.
      421         str = str + trim (entry (ii, guid_, "-")).
      422         if ii = 2 or ii = 3 or ii = 4 or ii = 5
      423           then
      424         do:
      425           str = str + "-".
      426         end.
      427       end.
      428       guid_ = str.
      429     end.
      430     numentr = num-entries (guid_, "-") no-error.
      431     do ii = 1 to numentr:
      432       case ii:
      433         when 1 then
      434           do:
      435             if length (trim (entry (ii, guid_, "-"))) <> 8
      436               then err = true.
      437           end.
      438         when 2 or
      439         when 3 or
      440         when 4 then
      441           do:
      442             if length (entry (ii, guid_, "-")) <> 4
      443               then err = true.
      444           end.
      445         when 5 then
      446           do:
      447             if length (entry (ii, guid_, "-")) <> 12
      448               then err = true.
      449           end.
      450       end case.
      451     end.
      452     if ii <> 6
      453       then err = true.
      454     if err then Msg = "Неверный формат GUID".
      455   END PROCEDURE.
      456   define variable gdsMercsubsObj as class gdsmercsubs.
