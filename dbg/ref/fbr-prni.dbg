        1   DEFINE BUFFER loc_fbr-prn FOR ub.fbr-prn.
        2   DEFINE TEMP-TABLE tt-fbr-prn NO-UNDO LIKE ub.fbr-prn.
        3   define input parameter parparentproc as widget-handle no-undo .
        4   define input parameter par-mode as character no-undo.
        5   define input parameter p-db-num like ub.fbr-prn.db-num no-undo.
        6   define input parameter p-prn-num like ub.fbr-prn.prn-num no-undo.
        7   define output parameter par-recid as recid no-undo.
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "Принтер кухни".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   procedure proc-alt-shift-f2:
       75     if not ibs.th.gbl.gbl-var:rcode
       76   then
       77     run gbl\inidebug.p .
       78   end.
       79   procedure proc-alt-shift-f3:
       80     run gbl/prvssinf.p
       81       ( input this-procedure
       82       ) .
       83   end.
       84   define variable v-inform-launched as logical no-undo initial false .
       85   procedure proc-alt-shift-f4:
       86     define variable v-action as character no-undo .
       87     if v-inform-launched = false then do:
       88       assign
       89         v-inform-launched = true
       90       .
       91       run gbl/d-inform.w
       92         (  input self
       93         ,  input this-procedure
       94         , output v-action
       95         ) no-error .
       96       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       97       assign
       98         v-inform-launched = false
       99       .
      100     end.
      101   end.
      102   procedure proc-alt-f1:
      103     run gbl/corrhelp.p
      104       (input this-procedure
      105       ) .
      106   end .
      107   on alt-shift-f2 anywhere do:
      108     run proc-alt-shift-f2.
      109   end.
      110   on alt-shift-f3 anywhere do:
      111     run proc-alt-shift-f3 in this-procedure .
      112   end.
      113   on alt-shift-f4 anywhere do:
      114     run proc-alt-shift-f4 in this-procedure.
      115   end.
      116   on alt-f1 anywhere do:
      117     run proc-alt-f1 in this-procedure .
      118   end.
      119   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      120     define variable v-cntxt-db-num        as integer   no-undo .
      121     define variable v-cntxt-userid        as character no-undo .
      122     define variable v-cntxt-level         as character no-undo .
      123     define variable v-cntxt-host-code-obj as integer   no-undo .
      124     define variable v-cntxt-obj-type      as character no-undo .
      125     define variable v-cntxt-obj-code      as integer   no-undo .
      126     define variable v-cntxt-db-num-obj    as integer   no-undo .
      127     define variable v-cntxt-is-admin      as logical   no-undo .
      128   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      129   define temp-table userobjs_temp-user-obj no-undo
      130     field obj-type as character
      131     field obj-code as integer
      132     index xpk is primary unique obj-type obj-code
      133     .
      134   procedure userobjs_clear :
      135     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      136     do
      137     on error undo, return error return-value
      138     :
      139       for each buf_userobjs_temp-user-obj
      140       on error undo, return error return-value
      141       :
      142         delete buf_userobjs_temp-user-obj .
      143       end.
      144     end.
      145   end .
      146   procedure userobjs_object-count :
      147     define output parameter p-total-count as integer   no-undo .
      148     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      149     do
      150     on error undo, return error return-value
      151     :
      152       assign
      153         p-total-count = 0
      154       .
      155       for each buf_userobjs_temp-user-obj
      156       on error undo, return error return-value
      157       :
      158         assign
      159           p-total-count = p-total-count + 1
      160         .
      161       end.
      162     end.
      163   end.
      164   procedure userobjs_append :
      165      define input  parameter p-obj-type as character no-undo .
      166      define input  parameter p-obj-code as integer   no-undo .
      167     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      168     do
      169     on error undo, return error return-value
      170     :
      171       find first buf_userobjs_temp-user-obj
      172         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      173           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      174         no-error .
      175       if not available buf_userobjs_temp-user-obj
      176       then do:
      177         create buf_userobjs_temp-user-obj .
      178         assign
      179           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      180           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      181         .
      182       end.
      183     end.
      184   end.
      185   procedure userobjs_object-exist :
      186     define output parameter p-object-exist as logical   no-undo .
      187     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      188     do
      189     on error undo, return error return-value
      190     :
      191       find first buf_userobjs_temp-user-obj
      192         no-error .
      193       if not available buf_userobjs_temp-user-obj
      194       then do:
      195         assign
      196           p-object-exist = false
      197         .
      198       end.
      199       else do:
      200         assign
      201           p-object-exist = true
      202         .
      203       end.
      204     end.
      205   end.
      206   procedure userobjs_transfer :
      207     define input  parameter p-callback-handle as handle no-undo .
      208     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      209     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      210     do
      211     on error undo, return error return-value
      212     :
      213       if valid-handle(p-callback-handle) <> true
      214       then do:
      215         message
      216           vss-workfile vss-revision vss-description skip
      217           "Ошибка задания входных параметров" skip
      218           "Неизвестный указатель на процедуру" skip
      219           view-as alert-box error .
      220         undo, return error return-value .
      221       end.
      222       if p-callback-handle :get-signature("userobjs_append") = ""
      223       then do:
      224         message
      225           vss-workfile vss-revision vss-description skip
      226           "Ошибка задания входных параметров" skip
      227           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      228                     ,p-callback-handle :file-name
      229                     ) skip
      230           view-as alert-box error .
      231         undo, return error return-value .
      232       end.
      233       for each buf_userobjs_temp-user-obj
      234       on error undo, return error return-value
      235       :
      236         run userobjs_append in p-callback-handle
      237           (input  buf_userobjs_temp-user-obj.obj-type
      238           ,input  buf_userobjs_temp-user-obj.obj-code
      239           ) .
      240       end.
      241     end.
      242   end procedure.
      243   procedure userobjs_select-one :
      244      define input  parameter parparentproc     as widget-handle no-undo .
      245      define input  parameter p-db-num          as integer   no-undo .
      246      define input  parameter p-user-id         as character no-undo .
      247      define input  parameter p-host-code-obj   as integer   no-undo .
      248      define input  parameter p-obj-type        as character no-undo .
      249      define input  parameter p-obj-code        as integer   no-undo .
      250      define output parameter p-user-select     as logical   no-undo .
      251      define output parameter p-select-obj-type as character no-undo .
      252      define output parameter p-select-obj-code as character no-undo .
      253     do
      254     on error undo, return error return-value
      255     :
      256       run gbl/userobjs.w
      257         (input  parparentproc
      258         ,input  this-procedure :handle
      259         ,input  p-db-num
      260         ,input  p-user-id
      261         ,input  p-host-code-obj
      262         ,input  p-obj-type
      263         ,input  p-obj-code
      264         ,INPUT  "b-sel"
      265         ,output p-user-select
      266         ,output p-select-obj-type
      267         ,output p-select-obj-code
      268         ) .
      269     end.
      270   end.
      271   procedure userobjs_select-many :
      272     define input  parameter parparentproc   as widget-handle no-undo .
      273     define input  parameter p-db-num        as integer   no-undo .
      274     define input  parameter p-user-id       as character no-undo .
      275     define input  parameter p-host-code-obj as integer   no-undo .
      276     define input  parameter p-obj-type      as character no-undo .
      277     define input  parameter p-obj-code      as integer   no-undo .
      278     define output parameter p-user-select   as logical   no-undo .
      279     define variable v-select-obj-type as character no-undo .
      280     define variable v-select-obj-code as integer   no-undo .
      281     do
      282     on error undo, return error return-value
      283     :
      284       run gbl/userobjs.w
      285         (input  parparentproc
      286         ,input  this-procedure :handle
      287         ,input  p-db-num
      288         ,input  p-user-id
      289         ,input  p-host-code-obj
      290         ,input  p-obj-type
      291         ,input  p-obj-code
      292         ,INPUT  "b-sel,b-mark"
      293         ,output p-user-select
      294         ,output v-select-obj-type
      295         ,output v-select-obj-code
      296         ) .
      297     end.
      298   end.
      299   procedure thobjs :
      300      define input        parameter parparentproc     as widget-handle no-undo .
      301      define input        parameter i-bttns           as character     no-undo .
      302      define input        parameter i-list-mode       as character     no-undo.
      303      define input        parameter i-obj-type        as character     no-undo.
      304      define input        parameter i-db-num          as integer       no-undo.
      305      define input        parameter i-host-code       as integer       no-undo.
      306      define input-output parameter p-rid-list        as character     no-undo .
      307   run ref/thobjs.p
      308           ( input parparentproc
      309            ,input  this-procedure :handle
      310           , input i-bttns
      311           , input i-list-mode
      312           , input i-obj-type
      313           , input i-db-num
      314           , input i-host-code
      315           , input-output p-rid-list ) no-error .
      316   end.
      317   define variable v-db-num like ub.db.db-num no-undo.
      318   DEFINE BUTTON B-exit AUTO-GO
      319        LABEL "&Ввод"
      320        SIZE 10 BY 1
      321        BGCOLOR 8 .
      322   DEFINE BUTTON B-Help
      323        LABEL "Помо&щь"
      324        SIZE 10 BY 1
      325        BGCOLOR 8 .
      326   DEFINE BUTTON b-quit AUTO-END-KEY
      327        LABEL "&Отмена"
      328        SIZE 10 BY 1
      329        BGCOLOR 8 .
      330   DEFINE BUTTON B-shop
      331        IMAGE-UP FILE "btn-down-arrow":U
      332        IMAGE-DOWN FILE "btn-down-arrow":U
      333        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      334        LABEL "Btn 2"
      335        SIZE 3 BY 1.
      336   DEFINE VARIABLE fbr-obj-name AS CHARACTER FORMAT "X(256)":U
      337         VIEW-AS TEXT
      338        SIZE 32.38 BY 1 NO-UNDO.
      339   DEFINE QUERY Dialog-Frame FOR
      340         tt-fbr-prn SCROLLING.
      341   DEFINE FRAME Dialog-Frame
      342        b-quit AT ROW 1 COL 1
      343        B-exit AT ROW 1 COL 11
      344        B-Help AT ROW 1 COL 54.88
      345        tt-fbr-prn.prn-num AT ROW 3.5 COL 16.75 COLON-ALIGNED
      346             LABEL "Номер"
      347             VIEW-AS FILL-IN
      348             SIZE 5.13 BY 1
      349        tt-fbr-prn.prn-name AT ROW 5.42 COL 17 COLON-ALIGNED
      350             LABEL "Название"
      351             VIEW-AS FILL-IN
      352             SIZE 46.25 BY 1
      353        B-shop AT ROW 7.42 COL 37.5
      354        tt-fbr-prn.prn-type AT ROW 10.38 COL 19.13 NO-LABEL
      355             VIEW-AS SELECTION-LIST SINGLE SCROLLBAR-VERTICAL
      356             SIZE 17.38 BY 3.17
      357        tt-fbr-prn.fbr-obj-type AT ROW 7.54 COL 21.25 COLON-ALIGNED
      358             LABEL "Объект производства"
      359              VIEW-AS TEXT
      360             SIZE 4 BY .67
      361        tt-fbr-prn.fbr-obj-code AT ROW 7.58 COL 27 COLON-ALIGNED NO-LABEL
      362              VIEW-AS TEXT
      363             SIZE 7 BY .67
      364        fbr-obj-name AT ROW 8.83 COL 16.75 COLON-ALIGNED NO-LABEL
      365        "Тип" VIEW-AS TEXT
      366             SIZE 7.38 BY .83 AT ROW 10.46 COL 10.5
      367        SPACE(53.11) SKIP(3.58)
      368       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      369            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      370            TITLE "Принтер кухни"
      371            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      372   ASSIGN
      373          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      374          FRAME Dialog-Frame:HIDDEN           = TRUE.
      375   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      376   DO:
      377     APPLY "END-ERROR":U TO SELF.
      378   END.
      379   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      380   DO:
      381     run proc-save-prn in this-procedure no-error.
      382     if error-status:error then return no-apply.
      383   END.
      384   ON CHOOSE OF B-shop IN FRAME Dialog-Frame
      385   DO:
      386     define buffer b-clients for ub.clients .
      387     define variable v-user-select as logical   no-undo .
      388     define variable v-obj-type    as character no-undo .
      389     define variable v-obj-code    as integer   no-undo .
      390   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      391   run userobjs_select-one in this-procedure
      392     (input  parparentproc
      393     ,input  v-cntxt-db-num
      394     ,input  v-cntxt-userid
      395     ,input  v-cntxt-host-code-obj
      396     ,input  v-cntxt-obj-type
      397     ,input  v-cntxt-obj-code
      398     ,output v-user-select
      399     ,output v-obj-type
      400     ,output v-obj-code
      401     )  .
      402     if v-user-select <> true
      403     then do:
      404       return no-apply .
      405     end.
      406     find first b-clients no-lock
      407       where b-clients.obj-type = v-obj-type
      408         and b-clients.obj-code = v-obj-code
      409       no-error .
      410     if not available b-clients
      411     then do:
      412       return no-apply .
      413     end.
      414     assign
      415       fbr-obj-name:screen-value            = b-clients.obj-name
      416       tt-fbr-prn.fbr-obj-code:screen-value = string(b-clients.obj-code)
      417       tt-fbr-prn.fbr-obj-type:screen-value = string(b-clients.obj-type)
      418     .
      419   END.
      420   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      421   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      422   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      423   on help of frame Dialog-Frame
      424   do:
      425     run gbl/app_help.p
      426       (input this-procedure :file-name
      427       ,input ''
      428       ,input ?
      429       ) no-error.
      430     if error-status :error then do:
      431       message
      432         "Ошибка при вызове помощи"
      433         error-status :get-message(1)
      434         view-as alert-box .
      435     end.
      436   end.
      437   run minbtn-set in this-procedure .
      438   on choose of b-help in frame Dialog-Frame
      439   do:
      440     apply "help":u to frame Dialog-Frame .
      441   end.
      442   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      443   procedure minbtn-set :
      444       do
      445           on error undo, return error return-value
      446           :
      447           define variable ii              as integer       no-undo .
      448           define variable fh              as widget-handle no-undo .
      449           define variable hh              as widget-handle no-undo .
      450           define variable v-h             as handle        extent 4 no-undo .
      451           define variable v-name-button   as character     no-undo .
      452           define variable v-help-old-x    as decimal       no-undo .
      453           define variable v-help-old-y    as decimal       no-undo .
      454           define variable v-help-old-size as decimal       no-undo .
      455           define variable v-frame-width   as decimal       no-undo .
      456           define variable jj              as integer       no-undo .
      457           do
      458               on error undo, return error
      459               :
      460               assign
      461                   v-frame-width = frame Dialog-Frame:width - 0.3
      462                   fh            = frame Dialog-Frame:first-child
      463                   hh            = fh:first-child
      464                   ii            = 1
      465                   .
      466               do while valid-handle(hh):
      467                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      468                   do:
      469                       case lc(hh:name) :
      470                           when "b-help" then
      471                               do:
      472                                   hh:load-image-up("cmp/b-help.bmp":u) .
      473                                   hh:load-image-down("cmp/b-help.bmp":u) .
      474                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      475                                   hh:TOOLTIP = "Помощь" .
      476                                   v-help-old-x = hh:column .
      477                                   v-help-old-y = hh:row    .
      478                                   v-help-old-size = hh:width .
      479                                   hh:width-chars = 2.5 .
      480                               end.
      481                           when "b-print" then
      482                               do:
      483                                   hh:load-image("cmp/b-print.bmp":u) .
      484                                   hh:TOOLTIP = "Печать" .
      485                                   v-h[ii] = hh:handle .
      486                                   ii = ii + 1 .
      487                                   hh:width-chars = 3 .
      488                               end.
      489                           when "b-history" or
      490                           when "b-hist" then
      491                               do:
      492                                   hh:load-image("cmp/b-hist.bmp":u) .
      493                                   hh:TOOLTIP = "История" .
      494                                   v-h[ii] = hh:handle .
      495                                   ii = ii + 1 .
      496                                   hh:width-chars = 3 .
      497                               end.
      498                           when "b-sch" then
      499                               do:
      500                                   hh:load-image("cmp/b-sch.bmp":u) .
      501                                   hh:TOOLTIP = "Установка Фильтра" .
      502                                   v-h[ii] = hh:handle .
      503                                   ii = ii + 1 .
      504                                   hh:width-chars = 3 .
      505                               end.
      506                           when "b-hist-user" then
      507                               do:
      508                                   hh:load-image("cmp/b-hist.bmp":u) .
      509                                   hh:TOOLTIP = "История пользователя" .
      510                                   ii = ii + 1 .
      511                               end.
      512                       end case.
      513                   end.
      514                   hh = hh:next-sibling.
      515               end.
      516               b-help:column = v-frame-width - b-help:width-chars.
      517               jj = 0.
      518               repeat ii = 4 to 1 by -1 :
      519                   if valid-handle (v-h[ii] ) then
      520                   do:
      521                       jj  = jj + 1 .
      522                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      523                       v-h[ii]:row    = v-help-old-y .
      524                   end.
      525               end.
      526           end.
      527       end.
      528   end procedure.
      529   MAIN-BLOCK:
      530   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      531      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      532   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      533     run mainmenu_getcntxt in parparentproc
      534       (output v-cntxt-db-num
      535       ,output v-cntxt-userid
      536       ,output v-cntxt-level
      537       ,output v-cntxt-host-code-obj
      538       ,output v-cntxt-obj-type
      539       ,output v-cntxt-obj-code
      540       ,output v-cntxt-db-num-obj
      541       ,output v-cntxt-is-admin
      542       ) .
      543   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      544   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      545     (output v-db-num
      546     )  .
      547       if v-db-num <> p-db-num then do:
      548           message
      549           vss-workfile vss-revision vss-description skip
      550           "Неверное значение параметра p-db-num" p-db-num
      551           view-as alert-box error.
      552           return error.
      553       end.
      554     if par-mode <> 'ИЗМЕНЕНИЕ':U and par-mode <> 'ДОБАВЛЕНИЕ':U then do:
      555       message
      556       vss-workfile vss-revision vss-description skip
      557        "Неверный параметр вызова par-mode"
      558       view-as alert-box ERROR.
      559       return error.
      560     end.
      561     run fill-tables in this-procedure .
      562     RUN Myenable in this-procedure .
      563     WAIT-FOR GO OF FRAME Dialog-Frame.
      564   END.
      565   RUN disable_UI.
      566   PROCEDURE disable_UI :
      567     HIDE FRAME Dialog-Frame.
      568   END PROCEDURE.
      569   PROCEDURE enable_UI :
      570     OPEN QUERY Dialog-Frame FOR EACH tt-fbr-prn SHARE-LOCK.
      571     GET FIRST Dialog-Frame.
      572     DISPLAY fbr-obj-name
      573         WITH FRAME Dialog-Frame.
      574     IF AVAILABLE tt-fbr-prn THEN
      575       DISPLAY tt-fbr-prn.prn-num tt-fbr-prn.prn-name tt-fbr-prn.prn-type
      576             tt-fbr-prn.fbr-obj-type tt-fbr-prn.fbr-obj-code
      577         WITH FRAME Dialog-Frame.
      578     ENABLE b-quit B-exit B-Help tt-fbr-prn.prn-num tt-fbr-prn.prn-name B-shop
      579            tt-fbr-prn.prn-type tt-fbr-prn.fbr-obj-type tt-fbr-prn.fbr-obj-code
      580            fbr-obj-name
      581         WITH FRAME Dialog-Frame.
      582     VIEW FRAME Dialog-Frame.
      583   END PROCEDURE.
      584   PROCEDURE fill-tables :
      585   define variable v-prn-num like ub.fbr-prn.prn-num no-undo.
      586   define buffer last_fbr-prn for ub.fbr-prn.
      587   CASE par-mode:
      588       when 'ДОБАВЛЕНИЕ':U then do:
      589           find last last_fbr-prn no-lock where
      590                        last_fbr-prn.db-num = p-db-num use-index pi no-error.
      591           if available last_fbr-prn then do:
      592               assign
      593               v-prn-num = last_fbr-prn.prn-num + 1
      594               .
      595           end.
      596           else do:
      597               assign
      598               v-prn-num = 1
      599               .
      600           end.
      601           create tt-fbr-prn.
      602           assign
      603           tt-fbr-prn.db-num = p-db-num
      604           tt-fbr-prn.prn-num = v-prn-num
      605           .
      606       end.
      607       when 'ИЗМЕНЕНИЕ':U then do:
      608           find first loc_fbr-prn exclusive-lock where
      609                       loc_fbr-prn.db-num = p-db-num
      610                   AND loc_fbr-prn.prn-num = p-prn-num no-error.
      611           if not available loc_fbr-prn then do:
      612               return error.
      613           end.
      614           assign
      615                   par-recid = recid(loc_fbr-prn)
      616                   .
      617           create tt-fbr-prn.
      618           buffer-copy loc_fbr-prn to tt-fbr-prn.
      619       end.
      620   END CASE.
      621   END PROCEDURE.
      622   PROCEDURE Myenable :
      623   define buffer buf_clients for ub.clients.
      624   find first buf_clients no-lock where
      625                        buf_clients.obj-type = loc_fbr-prn.fbr-obj-type
      626                   AND buf_clients.obj-code = loc_fbr-prn.fbr-obj-code no-error.
      627   if available buf_clients then do:
      628       assign
      629       fbr-obj-name = buf_clients.obj-name
      630       .
      631   end.
      632   assign
      633   tt-fbr-prn.prn-type:list-items in frame Dialog-Frame = "TM230"
      634   .
      635   assign
      636   frame Dialog-Frame:title = frame Dialog-Frame:title + chr(32) + par-mode
      637   .
      638   if par-mode = 'ИЗМЕНЕНИЕ':U then do:
      639     assign
      640     frame Dialog-Frame:title = frame Dialog-Frame:title + chr(32) + string(tt-fbr-prn.prn-num)
      641     .
      642   end.
      643   DISPLAY
      644   fbr-obj-name
      645   WITH FRAME Dialog-Frame.
      646   IF AVAILABLE tt-fbr-prn THEN
      647   DISPLAY
      648   tt-fbr-prn.prn-num
      649   tt-fbr-prn.prn-name
      650   tt-fbr-prn.prn-type
      651   tt-fbr-prn.fbr-obj-type
      652   tt-fbr-prn.fbr-obj-code
      653   WITH FRAME Dialog-Frame.
      654   ENABLE
      655   b-quit
      656   B-exit
      657   B-Help
      658   tt-fbr-prn.prn-num when par-mode = 'ДОБАВЛЕНИЕ':U
      659   tt-fbr-prn.prn-name
      660   B-shop
      661   tt-fbr-prn.prn-type
      662   tt-fbr-prn.fbr-obj-type
      663   tt-fbr-prn.fbr-obj-code
      664   WITH FRAME Dialog-Frame.
      665   VIEW FRAME Dialog-Frame.
      666   END PROCEDURE.
      667   PROCEDURE proc-save-prn :
      668   if par-mode = 'ДОБАВЛЕНИЕ':U then
      669   assign
      670   frame Dialog-Frame tt-fbr-prn.prn-num
      671   .
      672   assign
      673   tt-fbr-prn.fbr-obj-code = integer(tt-fbr-prn.fbr-obj-code:screen-value)
      674   tt-fbr-prn.fbr-obj-type = tt-fbr-prn.fbr-obj-type:screen-value
      675   tt-fbr-prn.prn-name
      676   tt-fbr-prn.prn-type
      677   .
      678   run ref/fbrprn01.p (
      679                           input-output par-recid
      680                          ,input par-mode
      681                          ,input tt-fbr-prn.db-num
      682                          ,input tt-fbr-prn.prn-num
      683                          ,input tt-fbr-prn.prn-type
      684                          ,input tt-fbr-prn.prn-name
      685                          ,input tt-fbr-prn.fbr-obj-type
      686                          ,input tt-fbr-prn.fbr-obj-code
      687                          ) no-error.
      688   if error-status:error then do:
      689       return error.
      690   end.
      691   END PROCEDURE.
