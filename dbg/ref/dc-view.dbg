     1463          BR-dis-host-r:NUM-LOCKED-COLUMNS IN FRAME d-disc     = 1.
     1464   ASSIGN
     1465          BR-dis-obj-b:HIDDEN  IN FRAME d-disc                = TRUE
     1466          BR-dis-obj-b:NUM-LOCKED-COLUMNS IN FRAME d-disc     = 1.
     1467   ASSIGN
     1468          BR-dis-obj-r:NUM-LOCKED-COLUMNS IN FRAME d-disc     = 1.
     1469   ASSIGN
     1470          Btn_Cost:HIDDEN IN FRAME d-disc           = TRUE.
     1471   ASSIGN
     1472          f-smart-info-sums:HIDDEN IN FRAME d-disc           = TRUE.
     1473   ON WINDOW-CLOSE OF FRAME d-disc
     1474   DO:
     1475     APPLY "END-ERROR":U TO SELF.
     1476   END.
     1477   ON CHOOSE OF B-chk IN FRAME d-disc
     1478   DO:
     1479       DEFINE VARIABLE varrid-list as character no-undo .
     1480       if available ub.dis-obj THEN  do:
     1481           run str/chk-docs.w (
     1482                           input parparentproc
     1483                          ,input '':U
     1484                          ,input "d-card":U
     1485                          ,input ?
     1486                          ,input (if selectcurr = 'base':U then dis-obj.obj-type else r_dis-obj.obj-type)
     1487                          ,input  (if selectcurr = 'base':U then dis-obj.obj-code else r_dis-obj.obj-code)
     1488                          ,input '':U
     1489                          ,input (if selectcurr = 'base':U then entry(1, dis-obj.d-card, chr(4)) else entry(1, r_dis-obj.d-card, chr(4)) )
     1490                          ,input 0
     1491                          ,input  ?
     1492                          ,input  ?
     1493                          ,input 0
     1494                          ,output varrid-list) no-error.
     1495       end.
     1496       if SelectCurr = 'rubl':U then
     1497       apply "entry" to br-dis-obj-r.
     1498       else
     1499       apply "entry" to br-dis-obj-b.
     1500   END.
     1501   ON CHOOSE OF b-history IN FRAME d-disc
     1502   DO:
     1503   define variable parref-list as character no-undo .
     1504   CASE rs-host-obj:
     1505     when 'объект':U then do:
     1506       if
     1507       (SelectCurr = 'rubl':U
     1508       and available r_dis-obj )
     1509       or
     1510       (SelectCurr = 'base':U
     1511       and
     1512       available ub.dis-obj ) then
     1513       run ref/cdchist.w (
     1514                         INPUT parparentproc
     1515                         ,input p-curr-host-code
     1516                         ,input p-curr-obj-type
     1517                         ,input p-curr-obj-code
     1518                         ,input "":U
     1519                         ,input "subject-object":U
     1520                         ,input dis-obj.d-card
     1521                         ,input ?
     1522                         ,input (if selectcurr = 'base':U then dis-obj.obj-type else r_dis-obj.obj-type)
     1523                         ,input (if selectcurr = 'base':U then dis-obj.obj-code else r_dis-obj.obj-code)
     1524                         ,input (if selectcurr = 'base':U then dis-obj.host-code else r_dis-obj.host-code)
     1525                         ,input ?
     1526                         ,input "":U
     1527                         ,input 'dis-obj':U
     1528                         ,input ?
     1529                         ,input-output parref-list
     1530                     ) no-error .
     1531         if SelectCurr = 'rubl':U then
     1532         apply "entry" to BR-dis-obj-r.
     1533         else
     1534         apply "entry" to BR-dis-obj-b.
     1535      end.
     1536      when 'фирма':U then do:
     1537       if
     1538       (SelectCurr = 'rubl':U
     1539       and available r_dis-host )
     1540       or
     1541       (SelectCurr = 'base':U
     1542       and
     1543       available ub.dis-host ) then
     1544        run ref/cdchist.w (
     1545                           INPUT parparentproc
     1546                           ,input p-curr-host-code
     1547                           ,input p-curr-obj-type
     1548                           ,input p-curr-obj-code
     1549                           ,input "":U
     1550                           ,input "subject"
     1551                           ,input dis-obj.d-card
     1552                           ,input ?
     1553                           ,input '':U
     1554                           ,input 0
     1555                           ,input (if selectcurr = 'base':U then dis-host.host-code else r_dis-host.host-code)
     1556                           ,input ?
     1557                           ,input "":U
     1558                           ,input 'dis-host':U
     1559                           ,input ?
     1560                           ,input-output parref-list
     1561                       ) no-error .
     1562         if SelectCurr = 'rubl':U then
     1563         apply "entry" to BR-dis-host-r.
     1564         else
     1565         apply "entry" to BR-dis-host-b.
     1566        end.
     1567      END CASE.
     1568    END.
     1569   ON CHOOSE OF B-print IN FRAME d-disc
     1570   DO:
     1571   define variable v-doc-rec as recid no-undo .
     1572    CASE rs-host-obj:
     1573        WHEN 'объект':U THEN DO:
     1574         v-doc-rec = recid( ub.dis-obj ).
     1575         DO WHILE available ub.dis-obj :
     1576           GET prev br-dis-obj-b.
     1577         END.
     1578         run PrintProc IN THIS-PROCEDURE (rs-gen-private, rs-host-obj) .
     1579         reposition br-dis-obj-b to recid v-doc-rec no-error.
     1580         IF selectcurr = 'base':U THEN
     1581         apply "entry" to br-dis-obj-b in frame d-disc.
     1582         ELSE
     1583         apply "entry" to br-dis-obj-r in frame d-disc.
     1584      END.
     1585      WHEN 'фирма':U THEN DO:
     1586         v-doc-rec = recid( ub.dis-host ).
     1587         DO WHILE available ub.dis-host :
     1588             GET prev br-dis-host-b.
     1589         END.
     1590         run PrintProc IN THIS-PROCEDURE (rs-gen-private, rs-host-obj) .
     1591         reposition br-dis-host-b to recid v-doc-rec no-error.
     1592         IF selectcurr = 'base':U THEN
     1593         apply "entry" to br-dis-host-b in frame d-disc.
     1594         ELSE
     1595         apply "entry" to br-dis-host-r in frame d-disc.
     1596     END.
     1597    END CASE.
     1598   END.
     1599   ON CHOOSE OF Btn_Cost IN FRAME d-disc
     1600   DO:
     1601     if available ub.dis-obj
     1602     or available r_Dis-obj
     1603     then do:
     1604       define variable v-host-code as integer   no-undo .
     1605       define variable v-obj-type as character no-undo .
     1606       define variable v-obj-code as integer no-undo .
     1607       define variable v-base-sum as decimal no-undo .
     1608       define variable v-rubl-sum as decimal no-undo .
     1609       case selectcurr:
     1610         when 'rubl':U then do:
     1611           assign
     1612           v-obj-type = (if available r_dis-obj
     1613                         then r_dis-obj.obj-type
     1614                         else ?)
     1615           v-obj-code = (if available r_dis-obj
     1616                         then r_dis-obj.obj-code
     1617                         else ?)
     1618           v-base-sum = r_dis-obj.gds-tot-b0
     1619           v-rubl-sum = r_dis-obj.gds-tot-r0
     1620           .
     1621         end.
     1622         when 'base':U then do:
     1623           assign
     1624           v-obj-type = (if available dis-obj
     1625                         then dis-obj.obj-type
     1626                         else ?)
     1627           v-obj-code = (if available dis-obj
     1628                         then dis-obj.obj-code
     1629                         else ?)
     1630           v-base-sum = dis-obj.gds-tot-b0
     1631           v-rubl-sum = dis-obj.gds-tot-r0
     1632           .
     1633         end.
     1634       end.
     1635       if v-obj-type = ? then do:
     1636         return no-apply.
     1637       end.
     1638   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1639   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1640     (input  v-obj-type
     1641     ,input  v-obj-code
     1642     ,output v-host-code
     1643     )  .
     1644   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1645   do:
     1646     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1647       (input  v-cntxt-db-num
     1648       ,input  v-cntxt-userid
     1649       ,input  0
     1650       ,input  'actn_archive_cost':U
     1651       ,input  'object':U
     1652       ,input  v-host-code
     1653       ,input  v-obj-type
     1654       ,input  v-obj-code
     1655       ,input  0
     1656       ,input  0
     1657       ,input  0
     1658       ,input  true
     1659       ,output LogRes
     1660       )  .
     1661   end.
     1662       if NOT LogRes then
     1663           return no-apply.
     1664       else do:
     1665         message
     1666         substitute("Сумма учетных цен (б.в.) : &1&2"  +
     1667                     "Сумма учетных цен (руб.) : &3"
     1668                     ,v-base-sum
     1669                     ,chr(10)
     1670                     ,v-rubl-sum)
     1671                     view-as alert-box INFORMATION
     1672         title substitute( "По объекту &1&2"
     1673                           ,v-obj-type
     1674                           ,v-obj-code ) .
     1675       end.
     1676     end.
     1677   END.
     1678   ON VALUE-CHANGED OF Rs-gen-private IN FRAME d-disc
     1679   DO:
     1680     assign rs-gen-private.
     1681     if RS-gen-PRivate = 1 then do:                          hide SelectCurr TotalSum NumCard NumChk DiscSum NettoSum SaldoSum TotalPay Mustpay CreditSum RestLimit LimitSum in frame d-disc.            display selectcurr with frame d-disc.      end.                                                  else do:                                                display SelectCurr TotalSum NumCard NumChk DiscSum NettoSum SaldoSum TotalPay Mustpay CreditSum RestLimit LimitSum with frame d-disc.     end.
     1682     RUN OpenBr IN THIS-PROCEDURE (
     1683                                   input t-legacy
     1684                                 , input t-subsid
     1685                                 , input selectcurr
     1686                                 , input rs-gen-private
     1687                                 , input rs-host-obj).
     1688     IF rs-host-obj = 'объект':U THEN DO:
     1689         IF SELECTcurr = 'base':U THEN
     1690         apply "ENTRY" to BR-dis-obj-b.
     1691         ELSE
     1692         apply "ENTRY" to BR-dis-obj-r.
     1693     END.
     1694     IF rs-host-obj = 'фирма':U THEN DO:
