     3896     RUN re-move-clmnbr-dis-host-r (9, 1).
     3897   END.
     3898   PROCEDURE re-move-clmnbr-dis-host-r:
     3899     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3900     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3901     DO varmvibr-dis-host-r = 1 TO EXTENT(cur-clmn-numbr-dis-host-r):
     3902       if cur-clmn-numbr-dis-host-r[varmvibr-dis-host-r] = source-column THEN cur-clmn-numbr-dis-host-r[varmvibr-dis-host-r] = -1.
     3903     END.
     3904     if br-dis-host-r:MOVE-COLUMN(source-column, target-column) IN FRAME d-disc then.
     3905     if source-column > target-column THEN
     3906     DO varmvjbr-dis-host-r = source-column - 1 to target-column BY -1:
     3907       DO varmvibr-dis-host-r = 1 TO EXTENT(cur-clmn-numbr-dis-host-r):
     3908           if cur-clmn-numbr-dis-host-r[varmvibr-dis-host-r] = varmvjbr-dis-host-r THEN DO:
     3909             cur-clmn-numbr-dis-host-r[varmvibr-dis-host-r] = cur-clmn-numbr-dis-host-r[varmvibr-dis-host-r] + 1.
     3910           END.
     3911       END.
     3912     END.
     3913     ELSE
     3914     DO varmvjbr-dis-host-r = source-column + 1 to target-column:
     3915       DO varmvibr-dis-host-r = 1 TO EXTENT(cur-clmn-numbr-dis-host-r):
     3916         if cur-clmn-numbr-dis-host-r[varmvibr-dis-host-r] = varmvjbr-dis-host-r THEN DO:
     3917           cur-clmn-numbr-dis-host-r[varmvibr-dis-host-r] = cur-clmn-numbr-dis-host-r[varmvibr-dis-host-r] - 1.
     3918         END.
     3919       END.
     3920     END.
     3921     DO varmvibr-dis-host-r = 1 TO EXTENT(cur-clmn-numbr-dis-host-r):
     3922       if cur-clmn-numbr-dis-host-r[varmvibr-dis-host-r] = -1 THEN cur-clmn-numbr-dis-host-r[varmvibr-dis-host-r] = target-column.
     3923     END.
     3924   END PROCEDURE.
     3925   PROCEDURE ch-clmnbr-dis-host-r:
     3926     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3927     if cur-clmn-loc <= 1 then do:
     3928       return .
     3929     end.
     3930     DO varmvibr-dis-host-r = 1 TO EXTENT(cur-clmn-numbr-dis-host-r):
     3931       if cur-clmn-numbr-dis-host-r[varmvibr-dis-host-r] = cur-clmn-loc THEN move-elementbr-dis-host-r = varmvibr-dis-host-r.
     3932     END.
     3933     RUN re-move-clmnbr-dis-host-r (cur-clmn-loc, 1).
     3934   END PROCEDURE.
     3935   PROCEDURE mv-brw-defaultbr-dis-host-r:
     3936   def var old-session as logical no-undo.
     3937     old-session = SESSION:IMMEDIATE-DISPLAY.
     3938     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3939     do varmvlbr-dis-host-r = 1 to EXTENT(cur-clmn-numbr-dis-host-r):
     3940       RUN re-move-clmnbr-dis-host-r (cur-clmn-numbr-dis-host-r[varmvlbr-dis-host-r], varmvlbr-dis-host-r).
     3941     END.
     3942     RUN start-mv-clmnbr-dis-host-r.
     3943     SESSION:IMMEDIATE-DISPLAY = old-session.
     3944   END PROCEDURE.
     3945   .
     3946   MAIN-BLOCK:
     3947   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3948      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
