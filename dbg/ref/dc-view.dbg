     3631   def var old-session as logical no-undo.
     3632      old-session = SESSION:IMMEDIATE-DISPLAY.
     3633      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3634          IF  t-legacy = no and t-subsid = no  THEN DO:
     3635      DO jjbr-dis-obj-b = NUM-ENTRIES('1,2,3,4,5,6,7,8,9') TO 1 BY -1:
