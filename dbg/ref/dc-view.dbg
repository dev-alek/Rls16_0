     4047      END.
     4048   RUN disable_UI.
     4049   PROCEDURE disable_UI :
     4050     HIDE FRAME d-disc.
     4051   END PROCEDURE.
     4052   PROCEDURE enable_UI :
     4053     DISPLAY T-legacy T-subsid SelectCurr Rs-gen-private rs-host-obj
     4054             f-smart-info-sums val-title TotalSum lNumCard NumCard NumChk DiscSum
     4055             NettoSum SaldoSum TotalPay Mustpay CreditSum RestLimit LimitSum
     4056         WITH FRAME d-disc.
     4057     ENABLE Btn_Cancel B-chk B-print b-history B-help RECT-1 T-legacy T-subsid
     4058            SelectCurr Rs-gen-private rs-host-obj BR-dis-obj-r BR-dis-obj-b
     4059            BR-dis-host-r TotalSum lNumCard NumCard NumChk DiscSum NettoSum
     4060            SaldoSum TotalPay Mustpay CreditSum RestLimit LimitSum
     4061         WITH FRAME d-disc.
     4062     VIEW FRAME d-disc.
     4063     OPEN QUERY BR-dis-host-b FOR EACH htt-dis-card NO-LOCK,              FIRST ub.dis-host WHERE TRUE  NO-LOCK,              EACH ub.sysconf OF ub.dis-host NO-LOCK.    OPEN QUERY BR-dis-host-r FOR EACH hrtt-dis-card NO-LOCK,              FIRST r_dis-host WHERE TRUE  NO-LOCK,              EACH r_sysconf OF r_dis-host NO-LOCK.    OPEN QUERY BR-dis-obj-b FOR EACH tt-dis-card NO-LOCK,              FIRST ub.dis-obj WHERE TRUE  NO-LOCK,              EACH ub.shop OF ub.dis-obj NO-LOCK.    OPEN QUERY BR-dis-obj-r FOR EACH rtt-dis-card NO-LOCK,              FIRST r_dis-obj WHERE TRUE  NO-LOCK,              EACH r_shop OF r_dis-obj NO-LOCK.
     4064   END PROCEDURE.
     4065   PROCEDURE fill-tables :
     4066   define input parameter  t-legacy as logical no-undo.
     4067   define input parameter t-subsid as logical no-undo .
     4068   define buffer buf_dis-card for ub.dis-card.
     4069   for each tt-dis-card :
     4070       delete tt-dis-card.
     4071   end.
     4072   for each rtt-dis-card :
     4073       delete rtt-dis-card.
     4074   end.
     4075   for each htt-dis-card :
     4076       delete htt-dis-card.
     4077   end.
     4078   for each hrtt-dis-card :
     4079       delete hrtt-dis-card.
     4080   end.
     4081   CASE t-legacy:
     4082     when no then do:
     4083       CASE t-subsid:
     4084         when no then do:
     4085           create tt-dis-card.
     4086           buffer-copy ub.dis-card to tt-dis-card.
     4087           create rtt-dis-card.
     4088           buffer-copy ub.dis-card to rtt-dis-card.
     4089           create htt-dis-card.
     4090           buffer-copy ub.dis-card to htt-dis-card.
     4091           create hrtt-dis-card.
     4092           buffer-copy ub.dis-card to hrtt-dis-card.
     4093           assign
     4094           numcard = 1.
     4095           find first current_dis-card no-lock where recid(current_dis-card) = recid(dis-card).
     4096         end.
     4097         when yes then do:
     4098           assign
     4099           numcard = 0.
     4100           for each buf_dis-card no-lock where buf_dis-card.main-card = ub.dis-card.main-card:
     4101             if buf_dis-card.main-card = buf_dis-card.d-card then do:
     4102               find first current_dis-card no-lock where recid(current_dis-card) = recid(buf_dis-card).
     4103             end.
     4104             create tt-dis-card.
     4105               buffer-copy buf_dis-card to tt-dis-card.
     4106             create rtt-dis-card.
     4107               buffer-copy buf_dis-card to rtt-dis-card.
     4108               create htt-dis-card.
     4109                 buffer-copy buf_dis-card to htt-dis-card.
     4110               create hrtt-dis-card.
     4111                 buffer-copy buf_dis-card to hrtt-dis-card.
     4112             assign
     4113             numcard = numcard + 1.
     4114           end.
     4115           find first current_dis-card no-lock where recid(current_dis-card) = recid(dis-card).
     4116         end.
     4117       END CASE.
     4118     end.
     4119     when yes then do:
     4120       CASE t-subsid :
     4121         when no then do:
     4122           assign
     4123           numcard = 0.
     4124           for each buf_dis-card no-lock where buf_dis-card.card-num = ub.dis-card.card-num:
     4125             if buf_dis-card.overissue-num = 0 then do:
     4126               find first current_dis-card no-lock where recid(current_dis-card) = recid(ub.dis-card).
     4127             end.
     4128             create tt-dis-card.
     4129               buffer-copy buf_dis-card to tt-dis-card.
     4130             create rtt-dis-card.
     4131               buffer-copy buf_dis-card to rtt-dis-card.
     4132               create htt-dis-card.
     4133                 buffer-copy buf_dis-card to htt-dis-card.
     4134               create hrtt-dis-card.
     4135                 buffer-copy buf_dis-card to hrtt-dis-card.
     4136             assign
     4137             numcard = numcard + 1.
     4138           end.
     4139         end.
     4140         when yes then do:
     4141           assign
     4142           numcard = 0.
     4143           for each buf_dis-card no-lock where buf_dis-card.first-main-card = ub.dis-card.first-main-card:
     4144             if buf_dis-card.first-main-card = buf_dis-card.d-card then do:
     4145               find first current_dis-card no-lock where recid(current_dis-card) = recid(buf_dis-card).
     4146             end.
     4147             create tt-dis-card.
     4148             buffer-copy buf_dis-card to tt-dis-card.
     4149             create rtt-dis-card.
     4150             buffer-copy buf_dis-card to rtt-dis-card.
     4151             create htt-dis-card.
     4152             buffer-copy buf_dis-card to htt-dis-card.
     4153             create hrtt-dis-card.
     4154             buffer-copy buf_dis-card to hrtt-dis-card.
     4155             assign
     4156             numcard = numcard + 1.
     4157           end.
     4158         end.
     4159       END CASE.
     4160     end.
     4161   END CASE.
     4162   END PROCEDURE.
     4163   PROCEDURE GetSums :
     4164   define buffer buf_tt-dis-card for tt-dis-card.
     4165   define variable v-exch-rate like ub.curr-accnt.exch-rate no-undo .
     4166   define variable v-exch-scale like ub.curr-accnt.exch-scale no-undo .
     4167   define variable v-abbr-curr as character no-undo .
     4168   DEFINE VARIABLE v-today as date no-undo .
     4169   DEFINE VARIABLE v-time as integer no-undo .
     4170   DEFINE VARIABLE v-ok-tot-sums AS logical NO-UNDO.
     4171   DEFINE VARIABLE v-ok AS CHARACTER NO-UNDO.
     4172   DEFINE VARIABLE v-found AS logical NO-UNDO.
     4173   define buffer buf_dis-host for ub.dis-host.
     4174   assign frame d-disc
     4175   t-legacy
     4176   t-subsid
     4177   .
     4178   run fill-tables in this-procedure ( input t-legacy, input t-subsid).
     4179   CASE t-legacy:
     4180     when no then do:
     4181       CASE t-subsid:
     4182         when no then do:
     4183           v-ok-tot-sums = YES.
     4184           FOR EACH buf_dis-host no-lock where
     4185                   buf_dis-host.d-card = inp-d-card
     4186             and buf_dis-host.host-code > 0
     4187             and (globalcard or buf_dis-host.host-code = p-curr-host-code)
     4188             and buf_dis-host.dt-code = 0
     4189             :
     4190             v-ok  = dc-smart_is-this-correct( INPUT buf_dis-host.dt-code
     4191                                    ,INPUT 'dis-host':U
     4192                                    ,INPUT v-cntxt-db-num
     4193                                    ,INPUT ub.dis-card.TYPE
     4194                                    ,INPUT ub.dis-card.emitent-host-code
     4195                                    ,INPUT (IF buf_Dis-host.host-code > 0 THEN 'орг':U ELSE "")
     4196                                    ,INPUT buf_dis-host.host-code
     4197                                    ,INPUT dis-card.d-card).
     4198             v-ok-tot-sums = v-ok-tot-sums AND (v-ok = "+").
     4199             v-found = YES.
     4200             ACCUMULATE
     4201             buf_dis-host.pay-tot-rubl ( TOTAL )
     4202             buf_dis-host.gds-tot-rubl ( TOTAL )
     4203             buf_dis-host.num-chk      ( TOTAL )
     4204             buf_dis-host.gds-dis-rubl ( TOTAL )
     4205             buf_dis-host.pay-tot-base ( TOTAL )
     4206             buf_dis-host.gds-tot-base ( TOTAL )
     4207             buf_dis-host.num-chk      ( TOTAL )
     4208             buf_dis-host.gds-dis-base ( TOTAL )
     4209             .
     4210           END.
     4211         end.
     4212         when yes then do:
     4213           v-ok-tot-sums = YES.
     4214           for each buf_tt-dis-card no-lock where
     4215                  buf_tt-dis-card.main-card = ub.dis-card.main-card,
     4216               EACH buf_dis-host no-lock where
     4217                    buf_dis-host.d-card = buf_tt-dis-card.d-card
     4218             and buf_dis-host.host-code > 0
     4219             and buf_dis-host.dt-code = 0
     4220             and (globalcard or buf_dis-host.host-code = p-curr-host-code):
     4221           v-ok  = dc-smart_is-this-correct( INPUT buf_dis-host.dt-code
     4222                                  ,INPUT 'dis-host':U
     4223                                  ,INPUT v-cntxt-db-num
     4224                                  ,INPUT buf_TT-dis-card.TYPE
     4225                                  ,INPUT BUF_TT-dis-card.emitent-host-code
     4226                                    ,INPUT (IF buf_Dis-host.host-code > 0 THEN 'орг':U ELSE "")
     4227                                    ,INPUT buf_dis-host.host-code
     4228                                    ,INPUT buf_tt-dis-card.d-card).
     4229           v-ok-tot-sums = v-ok-tot-sums AND (v-ok = "+").
     4230           v-found = YES.
     4231             ACCUMULATE
     4232             buf_dis-host.pay-tot-rubl ( TOTAL )
     4233             buf_dis-host.gds-tot-rubl ( TOTAL )
     4234             buf_dis-host.num-chk      ( TOTAL )
     4235             buf_dis-host.gds-dis-rubl ( TOTAL )
     4236             buf_dis-host.pay-tot-base ( TOTAL )
     4237             buf_dis-host.gds-tot-base ( TOTAL )
     4238             buf_dis-host.num-chk      ( TOTAL )
     4239             buf_dis-host.gds-dis-base ( TOTAL )
     4240             .
     4241           END.
     4242         end.
     4243       END CASE.
     4244     end.
     4245     when yes then do:
     4246       CASE t-subsid:
     4247         when no then do:
     4248           v-ok-tot-sums = YES.
     4249           for each buf_tt-dis-card no-lock,
     4250               each buf_dis-host no-lock where
     4251                     buf_dis-host.d-card = buf_tt-dis-card.d-card
     4252                 and buf_dis-host.host-code > 0
     4253                 AND (globalcard or buf_dis-host.host-code = p-curr-host-code)
     4254                 and buf_dis-host.dt-code = 0
     4255                 :
     4256               v-ok  = dc-smart_is-this-correct( INPUT buf_dis-host.dt-code
     4257                                      ,INPUT 'dis-host':U
     4258                                      ,INPUT v-cntxt-db-num
     4259                                      ,INPUT buf_TT-dis-card.TYPE
     4260                                      ,INPUT BUF_TT-dis-card.emitent-host-code
     4261                                        ,INPUT (IF buf_Dis-host.host-code > 0 THEN 'орг':U ELSE "")
     4262                                        ,INPUT buf_dis-host.host-code
     4263                                        ,INPUT buf_tt-dis-card.d-card).
     4264               v-ok-tot-sums = v-ok-tot-sums AND (v-ok = "+").
     4265               v-found = YES.
     4266             ACCUMULATE
     4267             buf_dis-host.pay-tot-rubl ( TOTAL )
     4268             buf_dis-host.gds-tot-rubl ( TOTAL )
     4269             buf_dis-host.num-chk      ( TOTAL )
     4270             buf_dis-host.gds-dis-rubl ( TOTAL )
     4271             buf_dis-host.pay-tot-base ( TOTAL )
     4272             buf_dis-host.gds-tot-base ( TOTAL )
     4273             buf_dis-host.num-chk      ( TOTAL )
     4274             buf_dis-host.gds-dis-base ( TOTAL )
     4275             .
     4276           end.
     4277         end.
     4278         when yes then do:
     4279           v-ok-tot-sums = YES.
     4280           for each buf_tt-dis-card no-lock
     4281               where  buf_tt-dis-card.first-main-card = ub.dis-card.first-main-card ,
     4282               each buf_dis-host no-lock where
     4283                   buf_dis-host.d-card = buf_tt-dis-card.d-card
     4284                 and buf_dis-host.host-code > 0
     4285                 AND (globalcard or buf_dis-host.host-code = p-curr-host-code)
     4286                 and buf_dis-host.dt-code = 0
     4287                 :
     4288               v-ok  = dc-smart_is-this-correct( INPUT buf_dis-host.dt-code
     4289                                      ,INPUT 'dis-host':U
     4290                                      ,INPUT v-cntxt-db-num
     4291                                      ,INPUT buf_TT-dis-card.TYPE
     4292                                      ,INPUT BUF_TT-dis-card.emitent-host-code
     4293                                        ,INPUT (IF buf_Dis-host.host-code > 0 THEN 'орг':U ELSE "")
     4294                                        ,INPUT buf_dis-host.host-code
     4295                                        ,INPUT buf_tt-dis-card.d-card).
     4296               v-ok-tot-sums = v-ok-tot-sums AND (v-ok = "+").
     4297               v-found = YES.
     4298             ACCUMULATE
     4299             buf_dis-host.pay-tot-rubl ( TOTAL )
     4300             buf_dis-host.gds-tot-rubl ( TOTAL )
     4301             buf_dis-host.num-chk      ( TOTAL )
     4302             buf_dis-host.gds-dis-rubl ( TOTAL )
     4303             buf_dis-host.pay-tot-base ( TOTAL )
     4304             buf_dis-host.gds-tot-base ( TOTAL )
     4305             buf_dis-host.num-chk      ( TOTAL )
     4306             buf_dis-host.gds-dis-base ( TOTAL )
     4307             .
     4308           end.
     4309         end.
     4310       END CASE.
     4311     end.
     4312   END CASE.
     4313   if glob-val then do:
     4314     run cur-time in this-procedure(output v-today, output v-time).
     4315   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4316   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     4317     (input  v-glob-curr-code
     4318     ,input  v-today
     4319     ,output v-exch-rate
     4320     ,output v-exch-scale
     4321     ,output v-abbr-curr
     4322     ) no-error .
     4323     if error-status:error then
     4324     v-exch-rate = ?.
     4325   end.
     4326   else do:
     4327     assign
     4328     v-exch-rate = ?.
     4329   end.
     4330   if SelectCurr = 'rubl':U then do:
     4331     ASSIGN
     4332     TotalPay = ( ACCUM TOTAL buf_dis-host.pay-tot-rubl)
     4333     TotalSum = ( ACCUM TOTAL buf_dis-host.gds-tot-rubl )
     4334     DiscSum = ( ACCUM TOTAL buf_dis-host.gds-dis-rubl )
     4335     SaldoSUm = dis-card.saldo-rubl
     4336     TotalPayPrim = ( ACCUM TOTAL buf_dis-host.pay-tot-base)
     4337     TotalSumPrim = ( ACCUM TOTAL buf_dis-host.gds-tot-base )
     4338     DiscSumPrim = ( ACCUM TOTAL buf_dis-host.gds-dis-base )
     4339     SaldoSumPrim = dis-card.saldo-base
     4340     .
     4341     ASSIGN NettoSum = TotalSum - DiscSum
     4342     CreditSUm = NettoSum - TotalPay
     4343     MustPay = if saldosum < 0 then (- saldosum) else 0
     4344     NettoSumPrim = TotalSumPrim - DiscSumPrim
     4345     CreditSUmPrim = NettoSumPrim - TotalPayPrim
     4346     MustPayPrim = if saldosumPrim < 0 then (- saldosum) else 0
     4347     NumChk =  ACCUM TOTAL buf_dis-host.num-chk
     4348     .
     4349     IF v-curr-r-b = 'rubl':U THEN DO:
     4350       assign
     4351       LimitSum = current_dis-card.lim-kr
     4352       RestLimit = LimitSum - (if mustpay > 0 then mustpay else 0)
     4353       LimitSumPrim = current_dis-card.lim-kr / v-exch-rate * v-exch-scale
     4354       RestLimitPrim = LimitSumPrim - (if mustpayPrim > 0 then mustpayPrim else 0)
     4355           .
     4356     END.
     4357     else do:
     4358       assign
     4359       LimitSum =  current_dis-card.lim-kr * v-exch-rate / v-exch-scale
     4360       RestLimit = LimitSum - (if mustpay > 0 then mustpay else 0)
     4361       LimitSumPrim =  current_dis-card.lim-kr
     4362       RestLimitPrim = LimitSumPrim - (if mustpayPrim > 0 then mustpayPrim else 0)
     4363       .
     4364     end.
     4365   end.
     4366   else do:
     4367     ASSIGN
     4368     TotalPay = ( ACCUM TOTAL buf_dis-host.pay-tot-base)
     4369     TotalSum = ( ACCUM TOTAL buf_dis-host.gds-tot-base )
     4370     DiscSum = ( ACCUM TOTAL buf_dis-host.gds-dis-base )
     4371     SaldoSUm = dis-card.saldo-base
     4372     TotalPayPrim = ( ACCUM TOTAL buf_dis-host.pay-tot-rubl)
     4373     TotalSumPrim = ( ACCUM TOTAL buf_dis-host.gds-tot-rubl )
     4374     DiscSumPrim = ( ACCUM TOTAL buf_dis-host.gds-dis-rubl )
     4375     SaldoSumPrim = dis-card.saldo-rubl
     4376     .
     4377     ASSIGN
     4378     NettoSum = TotalSum - DiscSum
     4379     CreditSUm = NettoSum - TotalPay
     4380     MustPay = if SaldoSUm < 0 then (- saldosum) else 0
     4381     NettoSumPrim = TotalSumPrim - DiscSumPrim
     4382     CreditSumPrim = NettoSumPrim - TotalPayPrim
     4383     MustPayPrim = if SaldoSUmPrim < 0 then (- saldosumPrim) else 0
     4384     NumChk =  ACCUM TOTAL buf_dis-host.num-chk .
     4385     IF v-curr-r-b = 'rubl':U THEN DO:
     4386       assign
     4387       LimitSum =  current_dis-card.lim-kr / v-exch-rate * v-exch-scale
     4388       RestLimit = LimitSum - (if mustpay > 0 then mustpay else 0)
     4389       LimitSumPrim =  current_dis-card.lim-kr
     4390       RestLimitPrim = LimitSumPrim - (if mustpayPrim > 0 then mustpayPrim else 0)
     4391       .
     4392     END.
     4393     else do:
     4394       assign
     4395       LimitSum =  current_dis-card.lim-kr
     4396       RestLimit = LimitSum - (if mustpay > 0 then mustpay else 0)
     4397       LimitSumPrim =  current_dis-card.lim-kr * v-exch-rate / v-exch-scale
     4398       RestLimitPrim = LimitSumPrim  - (if mustpayPrim > 0 then mustpayPrim else 0)
     4399       .
     4400     end.
     4401   end.
     4402   IF NOT (V-OK-TOT-SUMS AND v-found) THEN
     4403   DISPLAY
     4404   F-SMART-INFO-SUMS
     4405   WITH FRAME d-disc.
     4406   ELSE
     4407   HIDE
     4408   F-SMART-INFO-SUMS
     4409   in FRAME d-disc.
     4410   END PROCEDURE.
     4411   PROCEDURE Myenable :
     4412    assign
     4413    SelectCurr:radio-buttons in frame d-disc = "Рубли" + chr(44) + 'rubl':U + chr(44) +
     4414                                                      "Баз.вал." + chr(44) + 'base':U
     4415    rs-host-obj:radio-buttons in frame d-disc = "Объекты" + chr(44) + 'объект':U + chr(44) +
     4416                                                      "Фирмы" + chr(44) + 'фирма':U
     4417    br-dis-obj-r:title in frame d-disc = "В рублях"
     4418    br-dis-host-r:title in frame d-disc = "В рублях"
     4419    .
     4420     DISPLAY
     4421     SelectCurr
     4422     rs-gen-private
     4423     rs-host-obj
     4424     DiscSum
     4425     Mustpay
     4426     NettoSum
     4427     NumChk
     4428     TotalSum
     4429     val-title
     4430     CreditSum
     4431     SaldoSum
     4432     RestLimit
     4433     LimitSum
     4434     WITH FRAME d-disc.
     4435     assign
     4436     ub.dis-obj.num-chk:read-only in browse br-dis-obj-b = yes
     4437     r_dis-obj.num-chk:read-only in browse br-dis-obj-r = yes
     4438     ub.dis-host.num-chk:read-only in browse br-dis-host-b = yes
     4439     r_dis-host.num-chk:read-only in browse br-dis-host-r = yes
     4440    .
     4441     assign
     4442     t-legacy = no
     4443     t-subsid = no
     4444     .
     4445     ENABLE
     4446     B-help
     4447     b-history
     4448     Btn_Cancel
     4449     B-chk
     4450     btn_cost
     4451     B-print
     4452     SelectCurr
     4453     rs-gen-private
     4454     rs-host-obj
     4455     RECT-1 BR-dis-obj-r BR-dis-obj-b DiscSum Mustpay NettoSum NumChk RestLimit LimitSum
     4456     TotalSum
     4457     t-legacy
     4458     t-subsid
     4459     WITH FRAME d-disc.
     4460     VIEW FRAME d-disc.
     4461     assign
     4462     t-legacy = (if p-legacy <> no then yes  else t-legacy)
     4463     t-subsid = (if p-subsid <> no then yes  else t-subsid)
     4464     .
     4465     display
     4466     t-legacy
     4467     t-subsid
     4468     with frame d-disc .
     4469     run fill-tables in this-procedure ( input t-legacy, input t-subsid).
     4470     APPLY "VALUE-CHANGED" to T-legacy.
     4471     IF rs-host-obj = 'объект':U THEN DO:
     4472       hide
     4473       br-dis-host-b
     4474       br-dis-host-r
     4475       in frame d-disc .
     4476     END.
     4477     IF rs-host-obj = 'фирма':U THEN DO:
     4478       hide
     4479       br-dis-obj-b
     4480       br-dis-obj-r
     4481       in frame d-disc .
     4482     END.
     4483    END PROCEDURE.
     4484   PROCEDURE OpenBr :
     4485   define input parameter p-legacy as logical no-undo.
     4486   define input parameter p-is-subsid as logical no-undo .
     4487   DEFINE INPUT PARAMETER p-selectcurr AS CHARACTER NO-UNDO.
     4488   DEFINE INPUT PARAMETER p-gen-private AS integer NO-UNDO.
     4489   DEFINE INPUT PARAMETER p-host-obj AS character NO-UNDO.
     4490   DISABLE
     4491   br-dis-obj-b
     4492   br-dis-obj-r
     4493   br-dis-host-b
     4494   br-dis-host-r
     4495   WITH FRAME d-disc.
     4496   hide
     4497   br-dis-obj-b
     4498   br-dis-obj-r
     4499   br-dis-host-b
     4500   br-dis-host-r
     4501   in FRAME d-disc.
     4502   IF p-gen-private = 0
     4503   AND p-host-obj = 'объект':U THEN DO:
     4504     ASSIGN
     4505     vob:VISIBLE IN BROWSE br-dis-obj-b = NO
     4506     vor:VISIBLE IN BROWSE br-dis-obj-r = NO
     4507     .
     4508     if globalcard then do:
     4509       assign
     4510       FRAME d-disc:title = "Архивы по магазинам"
     4511       .
     4512     end.
     4513     else do:
     4514       assign
     4515       FRAME d-disc:title = "Архивы по магазинам текущей фирмы".
     4516     end.
     4517     assign
     4518     FRAME d-disc:title = FRAME d-disc:title + substitute(" по карте &1 &2 &3 &4"
     4519                                                                         , inp-d-card
     4520                                                                         , (if t-legacy then "с учетом перевыпуска карт" else "":U)
     4521                                                                         , (if t-subsid then "с учетом дополнительных карт" else "":U)
     4522                                                                         , (if ub.dis-card.is-subsid then "(дополнительная карта)" else "")
     4523                                                                         ).
     4524     OPEN QUERY BR-dis-obj-r
     4525     FOR EACH rtt-dis-card,
     4526         EACH r_dis-obj WHERE
     4527               r_dis-obj.d-card = rtt-dis-card.d-card
     4528          AND r_dis-obj.dt-code = 0
     4529         AND (if globalcard then true else r_dis-obj.host-code = p-curr-host-code) NO-LOCK,
     4530           FIRST r_shop WHERE r_shop.obj-code = r_dis-obj.obj-code NO-LOCK
     4531         BY r_dis-obj.d-card
     4532             BY r_dis-obj.obj-type
     4533             BY r_dis-obj.obj-code.
     4534     OPEN QUERY BR-dis-obj-b
     4535     FOR EACH tt-dis-card,
     4536         each  ub.dis-obj  WHERE
     4537               ub.dis-obj.d-card = tt-dis-card.d-card
     4538         AND ub.dis-obj.dt-code = 0
     4539          and
     4540     (if globalcard then true else ub.dis-obj.host-code = p-curr-host-code) NO-LOCK,
     4541          FIRST ub.shop WHERE ub.shop.obj-code = ub.dis-obj.obj-code NO-LOCK
     4542         BY dis-obj.d-card
     4543             BY dis-obj.obj-type
     4544             BY dis-obj.obj-code.
     4545      CASE p-selectcurr:
     4546        WHEN 'rubl':U THEN DO:
     4547          DISPLAY
     4548          br-dis-obj-r
     4549          WITH FRAME d-disc.
     4550          ENABLE
     4551          br-dis-obj-r
     4552          WITH FRAME d-disc.
     4553          APPLY "entry" TO br-dis-obj-r.
     4554        END.
     4555          WHEN 'base':U THEN DO:
     4556            DISPLAY
     4557            br-dis-obj-b
     4558            WITH FRAME d-disc.
     4559            ENABLE
     4560            br-dis-obj-b
     4561            WITH FRAME d-disc.
     4562            APPLY "entry" TO br-dis-obj-b.
     4563          END.
     4564      END CASE.
     4565   END.
     4566   IF p-gen-private = 1
     4567   AND p-host-obj = 'объект':U THEN DO:
     4568     ASSIGN
     4569     vob:VISIBLE IN BROWSE br-dis-obj-b = YES
     4570     vor:VISIBLE IN BROWSE br-dis-obj-r = YES
     4571     .
     4572     if globalcard then do:
     4573       assign
     4574       FRAME d-disc:title = "Архивы частных итогов по магазинам"
     4575       .
     4576     end.
     4577     else do:
     4578       assign
     4579       FRAME d-disc:title = "Архивы частных итогов по магазинам текущей фирмы".
     4580     end.
     4581     assign
     4582     FRAME d-disc:title = FRAME d-disc:title + substitute(" по карте &1 &2 &3 &4"
     4583                                                                         , inp-d-card
     4584                                                                         , (if t-legacy then " с учетом перевыпуска карт" else "":U)
     4585                                                                         , (if t-subsid then " с учетом дополнительных карт" else "":U )
     4586                                                                         , (if ub.dis-card.is-subsid then "(дополнительная карта)" else "")
     4587                                                                         ).
     4588     OPEN QUERY BR-dis-obj-r
     4589     FOR EACH rtt-dis-card,
     4590         EACH r_dis-obj WHERE
     4591               r_dis-obj.d-card = rtt-dis-card.d-card
     4592          and  r_dis-obj.dt-code > 0
     4593          AND (if globalcard then true else r_dis-obj.host-code = p-curr-host-code) NO-LOCK,
     4594           FIRST r_shop WHERE r_shop.obj-code = r_dis-obj.obj-code NO-LOCK
     4595         BY r_dis-obj.d-card
     4596             BY r_dis-obj.obj-type
     4597             BY r_dis-obj.obj-code.
     4598     OPEN QUERY BR-dis-obj-b
     4599     FOR EACH tt-dis-card,
     4600         each  dis-obj  WHERE
     4601               dis-obj.d-card = tt-dis-card.d-card
     4602           and dis-obj.dt-code > 0
     4603           and (if globalcard then true else dis-obj.host-code = p-curr-host-code) NO-LOCK,
     4604           FIRST shop WHERE shop.obj-code = dis-obj.obj-code NO-LOCK
     4605         BY dis-obj.d-card
     4606             BY dis-obj.obj-type
     4607             BY dis-obj.obj-code.
     4608       CASE p-selectcurr:
     4609         WHEN 'rubl':U THEN DO:
     4610           DISPLAY
     4611           br-dis-obj-r
     4612           WITH FRAME d-disc.
     4613           ENABLE
     4614           br-dis-obj-r
     4615           WITH FRAME d-disc.
     4616           APPLY "entry" TO br-dis-obj-r.
     4617         END.
     4618           WHEN 'base':U THEN DO:
     4619             DISPLAY
     4620             br-dis-obj-b
     4621             WITH FRAME d-disc.
     4622             ENABLE
     4623             br-dis-obj-b
     4624             WITH FRAME d-disc.
     4625             APPLY "entry" TO br-dis-obj-b.
     4626           END.
     4627       END CASE.
     4628   END.
     4629   IF p-gen-private = 0
     4630   AND p-host-obj = 'фирма':U THEN DO:
     4631       ASSIGN
     4632       vhb:VISIBLE IN BROWSE br-dis-host-b = NO
     4633       vhr:VISIBLE IN BROWSE br-dis-host-r = NO
     4634       .
     4635     if globalcard then do:
     4636       assign
     4637       FRAME d-disc:title = "Архивы по фирмам"
     4638       .
     4639     end.
     4640     else do:
     4641       assign
     4642       FRAME d-disc:title = "Архивы по фирме".
     4643     end.
     4644     assign
     4645     FRAME d-disc:title = FRAME d-disc:title + substitute(" по карте &1 &2 &3 &4"
     4646                                                                         , inp-d-card
     4647                                                                         , (if t-legacy then " с учетом перевыпуска карт" else "":U)
     4648                                                                         , (if t-subsid then " с учетом дополнительных карт" else "":U)
     4649                                                                         , (if ub.dis-card.is-subsid then "(дополнительная карта)" else "")
     4650                                                                         ).
     4651     OPEN QUERY BR-dis-host-r
     4652     FOR EACH hrtt-dis-card,
     4653         EACH r_dis-host WHERE
     4654               r_dis-host.d-card = hrtt-dis-card.d-card
     4655          AND r_dis-host.dt-code = 0
     4656          and (if globalcard then true else r_dis-host.host-code = p-curr-host-code) NO-LOCK,
     4657           FIRST r_sysconf WHERE r_sysconf.host-code = r_dis-host.host-code NO-LOCK
     4658         BY r_dis-host.d-card
     4659             BY r_dis-host.host-code.
     4660     OPEN QUERY BR-dis-host-b
     4661     FOR EACH htt-dis-card,
     4662         each  ub.dis-host  WHERE
     4663               ub.dis-host.d-card = htt-dis-card.d-card
     4664         and  ub.dis-host.dt-code = 0
     4665         and  (if globalcard then true else ub.dis-host.host-code = p-curr-host-code) NO-LOCK,
     4666           FIRST ub.sysconf WHERE ub.sysconf.host-code = ub.dis-host.host-code NO-LOCK
     4667         BY ub.dis-host.d-card
     4668             BY ub.dis-host.host-code
     4669             .
     4670       CASE p-selectcurr:
     4671         WHEN 'rubl':U THEN DO:
     4672           DISPLAY
     4673           br-dis-host-r
     4674           WITH FRAME d-disc.
     4675           ENABLE
     4676           br-dis-host-r
     4677           WITH FRAME d-disc.
     4678           APPLY "entry" TO br-dis-host-r.
     4679         END.
     4680           WHEN 'base':U THEN DO:
     4681             DISPLAY
     4682             br-dis-host-b
     4683             WITH FRAME d-disc.
     4684             ENABLE
     4685             br-dis-host-b
     4686             WITH FRAME d-disc.
     4687             APPLY "entry" TO br-dis-host-b.
     4688           END.
     4689       END CASE.
     4690     END.
     4691   IF p-gen-private = 1
     4692   AND p-host-obj = 'фирма':U THEN DO:
     4693     ASSIGN
     4694     vhb:VISIBLE IN BROWSE br-dis-host-b = YES
     4695     vhr:VISIBLE IN BROWSE br-dis-host-r = YES
     4696     .
     4697     if globalcard then do:
     4698       assign
     4699       FRAME d-disc:title = "Архивы частных итогов по фирмам"
     4700       .
     4701     end.
     4702     else do:
     4703       assign
     4704       FRAME d-disc:title = "Архивы частных итогов по фирме".
     4705     end.
     4706     assign
     4707     FRAME d-disc:title = FRAME d-disc:title + substitute(" по карте &1 &2 &3 &4"
     4708                                                                         , inp-d-card
     4709                                                                         , (if t-legacy then " с учетом перевыпуска карт" else "":U)
     4710                                                                         , (if t-subsid then " с учетом дополнительных карт" else "":U)
     4711                                                                         , (if ub.dis-card.is-subsid then "(дополнительная карта)" else "")
     4712                                                                         ).
     4713     OPEN QUERY BR-dis-host-r
     4714     FOR EACH hrtt-dis-card,
     4715         EACH r_dis-host WHERE
     4716               r_dis-host.d-card = hrtt-dis-card.d-card
     4717           and r_dis-host.dt-code > 0
     4718           AND (if globalcard then true else r_dis-host.host-code = p-curr-host-code) NO-LOCK,
     4719           FIRST r_sysconf WHERE r_sysconf.host-code = r_dis-host.host-code NO-LOCK
     4720         BY r_dis-host.d-card
     4721             BY r_dis-host.host-code.
     4722     OPEN QUERY BR-dis-host-b
     4723     FOR EACH htt-dis-card,
     4724         each  dis-host  WHERE
     4725               dis-host.d-card = htt-dis-card.d-card
     4726           and dis-host.dt-code > 0
     4727           and (if globalcard then true else dis-host.host-code = p-curr-host-code) NO-LOCK,
     4728           FIRST sysconf WHERE sysconf.host-code = dis-host.host-code NO-LOCK
     4729         BY dis-host.d-card
     4730             BY dis-host.host-code.
     4731     CASE p-selectcurr:
     4732       WHEN 'rubl':U THEN DO:
     4733         DISPLAY
     4734         br-dis-host-r
     4735         WITH FRAME d-disc.
     4736         ENABLE
     4737         br-dis-host-r
     4738         WITH FRAME d-disc.
     4739         APPLY "entry" TO br-dis-host-r.
     4740       END.
     4741         WHEN 'base':U THEN DO:
     4742           DISPLAY
     4743           br-dis-host-b
     4744           WITH FRAME d-disc.
     4745           ENABLE
     4746           br-dis-host-b
     4747           WITH FRAME d-disc.
     4748           APPLY "entry" TO br-dis-host-b.
     4749         END.
     4750     END CASE.
     4751             .
     4752     END.
     4753   CASE (t-legacy or t-subsid):
     4754       when no then do:
     4755           hide
     4756           NumCard in frame d-disc
     4757           lnumcard in frame d-disc.
     4758       end.
     4759       when yes then do:
     4760           display
     4761           NumCard
     4762           lnumcard
     4763           with frame d-disc.
     4764       end.
     4765   END CASE.
     4766   END PROCEDURE.
     4767   PROCEDURE PrintProc :
     4768   DEFINE INPUT PARAMETER p-gen-private AS integer NO-UNDO.
     4769   DEFINE INPUT PARAMETER p-host-obj AS CHARACTER NO-UNDO.
     4770   define variable sym1   as char format "X(1)" init ":".
     4771   define variable sym10 as char format "X(1)" init ":".
     4772   define variable date_string     as      char    no-undo.
     4773   define variable Line                as      char    no-undo.
     4774   define variable for-obj-code as integer FORMAT ">>>>9" no-undo.
     4775   define variable for-netto like ub.dis-obj.pay-tot-rubl no-undo.
     4776   define variable credit-sum like ub.dis-obj.pay-tot-rubl no-undo.
     4777   DEFINE VARIABLE v-sum-id AS CHARACTER NO-UNDO.
     4778   DEFINE FRAME List
     4779   sym1 column-label " " format "X(1)" space(0)
     4780   for-obj-code COLUMN-LABEL "Объект!Фирма"
     4781   v-sum-id COLUMN-LABEL "Частный итог" FORMAT "X(32)"
     4782   ub.dis-obj.gds-tot-rubl COLUMN-LABEL "Сумма товарная"
     4783   ub.dis-obj.gds-dis-rubl COLUMN-LABEL "Скидка товарная"
     4784   for-netto COLUMN-LABEL "Сумма нетто"
     4785   ub.dis-obj.pay-tot-rubl COLUMN-LABEL "Платежи"
     4786   credit-sum COLUMn-LABEL "Сумма в кредит"
     4787   ub.dis-obj.num-chk
     4788   ub.dis-obj.d-card COLUMN-LABEL "№ карты"
     4789   sym10 column-label " " format "X(1)"
     4790   HEADER  date_string AT 5 format "X(35)"
     4791   string( if SelectCurr = 'base':U then "(баз.вал)" else "(рубли)" ) format "X(20)"
     4792   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     4793   Line format "X(193)" AT 1
     4794   with width 232 down stream-io use-text    .
     4795   Line = fill("-", 193).
     4796   date_string = cur-time-print() .
     4797   run prn-lib-open-stream  in this-procedure (
     4798                                                input parParentProc
     4799                                               ,input 43
     4800                                               ,input yes
     4801                                               ,input no
     4802                                               ).
     4803   PUT  STREAM PrnLibStream
     4804   SPACE(25) ( frame d-disc:title )
     4805   format "x(90)" SKIP(1) .
     4806   FORM HEADER
     4807   Line format "X(193)" AT 1 SKIP
     4808   "Продолжение - на следующей странице" AT 30 SKIP
     4809   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     4810   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     4811   FORM with FRAME list  .
     4812   run waitfram-show in this-procedure ("Ждите...").
     4813   CASE p-host-obj:
     4814     WHEN 'объект':U THEN DO:
     4815       GET next br-dis-obj-b.
     4816       DO WHILE available dis-obj :
     4817           DISPLAY STREAM PrnLibStream
     4818           sym1
     4819           dis-obj.obj-code @ for-obj-code
     4820           dct-algo-get-sum-id-from-dt-code(INPUT dis-obj.dt-code) @ v-sum-id
     4821           (if SelectCurr = 'base':U
     4822           then dis-obj.gds-tot-base
     4823           else dis-obj.gds-tot-rubl) @ dis-obj.gds-tot-rubl
     4824           (if SelectCurr = 'base':U
     4825           then dis-obj.gds-dis-base
     4826           else dis-obj.gds-dis-rubl) @ dis-obj.gds-dis-rubl
     4827           (if SelectCurr = 'base':U then
     4828           (dis-obj.gds-tot-base + dis-obj.sum-tot-base -
     4829           dis-obj.gds-dis-base - dis-obj.sum-dis-base)
     4830           else
     4831           (dis-obj.gds-tot-rubl + dis-obj.sum-tot-rubl -
     4832           dis-obj.gds-dis-rubl - dis-obj.sum-dis-rubl)) @ for-netto
     4833           (if SelectCurr = 'base':U
     4834           then
     4835           (dis-obj.gds-tot-base + dis-obj.sum-tot-base -
     4836            dis-obj.gds-dis-base - dis-obj.sum-dis-base -
     4837            dis-obj.pay-tot-base)
     4838           else
     4839           (dis-obj.gds-tot-rubl + dis-obj.sum-tot-rubl -
     4840            dis-obj.gds-dis-rubl - dis-obj.sum-dis-rubl -
     4841            dis-obj.pay-tot-rubl)) @ credit-sum
     4842           dis-obj.num-chk
     4843           (if SelectCurr = 'base':U
     4844           then dis-obj.pay-tot-base
     4845           else dis-obj.pay-tot-rubl) @ dis-obj.pay-tot-rubl
     4846           sym10
     4847           dis-obj.d-card
     4848           with FRAME list .
     4849           DOWN STREAM PrnLibStream 1 with FRAME list  .
     4850           GET next br-dis-obj-b.
     4851       END.
     4852     END.
     4853     WHEN 'фирма':U THEN DO:
     4854       GET next br-dis-host-b.
     4855       DO WHILE available dis-obj :
     4856           DISPLAY STREAM PrnLibStream
     4857           sym1
     4858           ub.dis-host.host-code @ for-obj-code
     4859           dct-algo-get-sum-id-from-dt-code(INPUT ub.dis-host.dt-code) @ v-sum-id
     4860           (if SelectCurr = 'base':U
     4861           then ub.dis-host.gds-tot-base
     4862           else ub.dis-host.gds-tot-rubl) @ dis-obj.gds-tot-rubl
     4863           (if SelectCurr = 'base':U
     4864           then ub.dis-host.gds-dis-base
     4865           else ub.dis-host.gds-dis-rubl) @ dis-obj.gds-dis-rubl
     4866           (if SelectCurr = 'base':U then
     4867           (ub.dis-host.gds-tot-base - ub.dis-host.gds-dis-base)
     4868           else
     4869           (ub.dis-host.gds-tot-rubl  - ub.dis-host.gds-dis-rubl )) @ for-netto
     4870           (if SelectCurr = 'base':U
     4871           then
     4872           (ub.dis-host.gds-tot-base - ub.dis-host.gds-dis-base - ub.dis-host.pay-tot-base)
     4873           else
     4874           (ub.dis-host.gds-tot-rubl - ub.dis-host.gds-dis-rubl - ub.dis-host.pay-tot-rubl))
     4875           @ credit-sum
     4876           ub.dis-host.num-chk @ ub.dis-obj.num-chk
     4877           (if SelectCurr = 'base':U
     4878           then ub.dis-host.pay-tot-base
     4879           else ub.dis-host.pay-tot-rubl) @ ub.dis-obj.pay-tot-rubl
     4880           sym10
     4881           ub.dis-host.d-card @ ub.dis-obj.d-card
     4882           with FRAME list .
     4883           DOWN STREAM PrnLibStream 1 with FRAME list  .
     4884           GET next br-dis-host-b.
     4885        END.
     4886     END.
     4887   END CASE.
     4888   UNDERLINE  STREAM PrnLibStream
     4889   sym1
     4890   for-obj-code
     4891   dis-obj.gds-tot-rubl
     4892   dis-obj.gds-dis-rubl
     4893   for-netto
     4894   dis-obj.pay-tot-rubl
     4895   credit-sum
     4896   dis-obj.num-chk
     4897   sym10
     4898   with FRAME list .
     4899   DISPLAY STREAM PrnLibStream
     4900   sym1
     4901   "ИТОГО б.в."  @ for-obj-code
     4902   (IF SelectCurr = 'rubl':U or SelectCurr = "" then TotalSumPrim
     4903                                              else TotalSum)
     4904                                               @ dis-obj.gds-tot-rubl
     4905   (IF SelectCurr = 'rubl':U or SelectCurr = "" then DiscSumprim
     4906                                              else DiscSum)
     4907                                               @ dis-obj.gds-dis-rubl
     4908   (IF SelectCurr = 'rubl':U or SelectCurr = "" then NettoSumPrim else NettoSum) @ for-netto
     4909   (IF SelectCurr = 'rubl':U or SelectCurr = "" then TotalPayPrim else TotalPay) @ dis-obj.pay-tot-rubl
     4910   (IF SelectCurr = 'rubl':U or SelectCurr = "" then (NettoSumPrim - TotalPayPrim)
     4911                                      else (NettoSum - TotalPay)) @ credit-sum
     4912   NumChk @ dis-obj.num-chk
     4913   sym10
     4914   with frame list.
     4915   DOWN STREAM PrnLibStream 1 with FRAME list  .
     4916   DISPLAY STREAM PrnLibStream
     4917   sym1
     4918   "ИТОГО руб"  @ for-obj-code
     4919   (IF SelectCurr = 'rubl':U or SelectCurr = "" then TotalSum
     4920                                              else TotalSumPrim)
     4921                                                           @ dis-obj.gds-tot-rubl
     4922   (IF SelectCurr = "rubl" or SelectCurr = "" then DiscSum
     4923                                              else DiscSumPrim)
     4924                                                           @ dis-obj.gds-dis-rubl
     4925   (IF SelectCurr = "rubl" or SelectCurr = "" then NettoSum else NettoSumPrim) @ for-netto
     4926   (IF SelectCurr = "rubl" or SelectCurr = "" then TotalPay else TotalPayPrim) @ dis-obj.pay-tot-rubl
     4927   (IF SelectCurr = "rubl" or SelectCurr = "" then (NettoSum - TotalPay)
     4928                              else (NettoSumPrim - TotalPayPrim)) @ credit-sum
     4929   NumChk @ dis-obj.num-chk
     4930   sym10
     4931   with frame list.
     4932   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     4933   HIDE  STREAM PrnLibStream FRAME CheckList.
     4934   output  STREAM PrnLibStream CLOSE.
     4935   run waitfram-hide in this-procedure .
     4936   run prn-lib-prn-file in this-procedure (
     4937                                             input parParentProc
     4938                                             ,input 8
     4939                                             ).
     4940   END PROCEDURE.
