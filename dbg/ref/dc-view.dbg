     3573           when vhr:label in browse BR-dis-host-r then DO:   assign     sort-column-name = "vhr"   .   run OpenBr in this-procedure (input t-legacy, input t-subsid, input selectcurr, input rs-gen-private, input rs-host-obj).   . END.
     3574       otherwise do:
     3575         assign
     3576           sort-column-name = ""
     3577         .
     3578         run OpenBr in this-procedure(input t-legacy, input t-subsid, input selectcurr, input rs-gen-private, input rs-host-obj).
     3579           if can-do( this-procedure:internal-entries, 'mv-brw-defaultBR-dis-host-r') then do:
     3580             run mv-brw-defaultBR-dis-host-r.
     3581           end.
     3582         if sort-labelBR-dis-host-r <> "" then do:
     3583           assign
     3584             cur-clmnBR-dis-host-r:column-fgcolor = 0
     3585           .
     3586         end.
     3587         assign
     3588           cur-clmn-locBR-dis-host-r = ?
     3589         .
     3590       end.
     3591     end case.
     3592       if cur-clmn-locBR-dis-host-r <> ? then do:
     3593         if can-do( this-procedure:internal-entries, 'ch-clmnBR-dis-host-r') then do:
     3594           run ch-clmnBR-dis-host-r in this-procedure (cur-clmn-locBR-dis-host-r).
     3595         end.
     3596       end.
     3597     if p-recid <> ? then do:
     3598       reposition BR-dis-host-r to recid p-recid no-error.
     3599       apply "value-changed" to BR-dis-host-r in frame d-disc.
     3600     end.
     3601     apply "entry" to BR-dis-host-r in frame d-disc.
     3602   END PROCEDURE.
     3603   procedure re-open-query-srt-clmnBR-dis-host-r:
     3604   if cur-clmnBR-dis-host-r = ? then do:
     3605      run OpenBr in this-procedure(input t-legacy, input t-subsid, input selectcurr, input rs-gen-private, input rs-host-obj).
     3606   end.
     3607   else do:
     3608      assign re-queryBR-dis-host-r = yes.
     3609      run sort-brBR-dis-host-r
     3610        (input (if available hrtt-dis-card
     3611                then recid(hrtt-dis-card)
     3612                else ?
     3613               )
     3614        ).
     3615      assign re-queryBR-dis-host-r = no.
     3616   end.
     3617   end.
