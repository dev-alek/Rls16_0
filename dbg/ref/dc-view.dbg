      501   procedure prn-lib-reportviewer :
      502     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      503     define input parameter p-report-name-html as character no-undo .
      504     define input parameter p-param        as character no-undo .
      505     define variable v-excel           as character no-undo init 'TRUE' .
      506     define variable v-value-character as character no-undo .
      507     define variable v-value-integer   as character no-undo .
      508     define variable v-value-date      as date      no-undo .
      509     define variable v-value-decimal   as decimal   no-undo .
      510     define variable rep-excel         as logical   no-undo .
      511     define variable excel-string      as character no-undo .
      512     define variable v-param-type      as character no-undo .
      513     define variable v-tth             as handle    no-undo .
      514     run adm/shattri.p (
      515       input "get":U
      516       ,input  ""
      517       ,input  0
      518       ,input  'report-glob':U
      519       ,input  'rep-excel':U
      520       ,output v-value-character
      521       ,output v-value-date
      522       ,output v-value-decimal
      523       ,output v-value-integer
      524       ,output rep-excel
      525       ,output v-param-type
      526       ,INPUT-OUTPUT table-handle v-tth
      527       )  .
      528     if rep-excel then v-excel = "TRUE" .
      529     else v-excel = "FALSE" .
      530     if p-param eq ""
      531     then
      532        p-param = "EXCEL:" + v-excel.
      533     else
      534        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      535     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      536   end procedure.
