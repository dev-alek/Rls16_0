     3682       return .
     3683     end.
     3684     DO varmvibr-dis-obj-b = 1 TO EXTENT(cur-clmn-numbr-dis-obj-b):
     3685       if cur-clmn-numbr-dis-obj-b[varmvibr-dis-obj-b] = cur-clmn-loc THEN move-elementbr-dis-obj-b = varmvibr-dis-obj-b.
     3686     END.
     3687     RUN re-move-clmnbr-dis-obj-b (cur-clmn-loc, 1).
     3688   END PROCEDURE.
