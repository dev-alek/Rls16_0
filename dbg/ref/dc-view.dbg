     3956       ,output v-cntxt-obj-code
     3957       ,output v-cntxt-db-num-obj
     3958       ,output v-cntxt-is-admin
     3959       ) .
     3960       define variable v-ok as logical   no-undo .
     3961   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3962   do:
     3963     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3964       (input  v-cntxt-db-num
     3965       ,input  v-cntxt-userid
     3966       ,input  0
     3967       ,input  'actn_discount-cards-totals_print':U
     3968       ,input  'firm':U
     3969       ,input  v-cntxt-host-code-obj
     3970       ,input  '':U
     3971       ,input  0
     3972       ,input  0
     3973       ,input  0
     3974       ,input  0
     3975       ,input  false
     3976       ,output LogRes
     3977       )  .
     3978   end.
     3979       if NOT LogRes then
     3980           do:
     3981               message
     3982                   "У Вас недостаточно прав" skip
     3983                   "для выполнения данного действия." skip
     3984                   "Обратитесь к администратору системы." view-as alert-box error.
     3985               LEAVE MAIN-BLOCK .
     3986           end.
     3987       find first ub.dis-card no-lock
     3988         where ub.dis-card.d-card = inp-d-card
     3989         no-error .
     3990       if not available ub.dis-card then do:
     3991         message
     3992           vss-workfile vss-revision vss-description skip
     3993           "Не найдена дисконтная карта с номером " inp-d-card
     3994           view-as alert-box error.
     3995         undo, return error .
     3996       END.
     3997       find first ub.clients no-lock
     3998         where ub.clients.obj-type = ub.dis-card.cli-type
     3999           and ub.clients.obj-code = ub.dis-card.cli-code
     4000           no-error .
     4001       if not available ub.clients then do:
     4002         message
     4003           vss-workfile vss-revision vss-description skip
     4004           "Не найден контрагент" ub.dis-card.cli-type ub.dis-card.cli-code skip
     4005           view-as alert-box error.
     4006         undo, return error .
     4007       END.
     4008       assign
     4009         globalcard = (ub.dis-card.emitent-host-code = 0)
     4010       .
     4011       if not globalcard then do:
     4012   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4013   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     4014     (input  ub.dis-card.emitent-host-code
     4015     ,output v-glob-curr-code
     4016     )  .
     4017       end.
     4018       FIND FIRST ub.sysconf No-LOCK WHERE ub.sysconf.host-code = p-curr-host-code No-ERROR.
     4019       IF Not avail ub.sysconf then do:
     4020         message "Не найдена запись о фирме " p-curr-host-code
     4021         view-as alert-box ERROR.
