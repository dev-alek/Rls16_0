      357   define  stream PrnLibStream.
      358   procedure prn-lib-prn-file :
      359     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      360     define input parameter p-DIsabledoptions as integer no-undo .
      361     define variable v-report-name as character no-undo .
      362     define variable v-user-action as character no-undo .
      363     define variable v-printed     as logical   no-undo .
      364     define variable v-exist       as logical   no-undo .
