      571   then
      572      mBatchMode = yes.
      573   if mBatchMode = ? then do:
      574     mVisCUrentVin = current-window:visible.
      575     mFameOldVis = mFramBachModHandle:visible.
      576     mFramBachModHandle:visible  = yes.
      577     mBatchMode = mFramBachModHandle:visible ne yes.
      578     mFramBachModHandle:visible = mFameOldVis.
      579     current-window:visible = mVisCUrentVin.
      580   end.
      581    if  log-manager:logfile-name ne ?
      582     then DO:
      583         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      584         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      585         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      586     end.
      587   on choose of B-WaitFramStop in frame waitfram
      588   do:
      589     mWaitFramStop = yes.
      590     mWaitFramStopUser = yes.
      591   end.
      592   function waitfram-check-timeout returns logical():
      593      define variable vtime as int64 no-undo.
      594      if mWaitFramStopTimeOut
      595      then
      596         return yes.
      597      vtime = ( now - mWaitFramStartProc ) / 1000 .
      598      if     mWaitFramTimeOut ne ?
      599         and mWaitFramTimeOut ne 0
      600         and mWaitFramTimeOut lt vtime
      601      then do:
      602         mWaitFramStopTimeOut = yes.
      603      end.
      604      return mWaitFramStopTimeOut.
      605   end.
      606   procedure waitfram-hide :
      607     if not session:batch-mode
      608     then do
      609     on error undo, return error return-value
      610     :
      611       pause 0 before-hide .
      612       if not mBatchMode then
      613         hide frame waitfram .
      614     if     not mWaitFramView
      615        and mWaitProcEvent
      616     then
      617       process events .
      618     end.
      619   end procedure.
      620   procedure waitfram-show :
      621     define input  parameter p-message as character no-undo .
      622     define variable v-left-margin as integer   no-undo .
      623     if not session:batch-mode
      624     then do
      625     on error undo, return error return-value
      626     :
      627       if length(p-message) <= 70 then do:
      628         assign
      629           v-left-margin = integer((70 - length(p-message)) / 2)
      630         .
      631         assign
      632           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      633         .
      634         assign
      635           v-waitfram-action01 = " "
      636           v-waitfram-action02 = " "
      637                                    + fill(" ", v-left-margin)
      638                                    + p-message
      639           v-waitfram-action03 = " "
      640         .
      641       end.
      642       else do:
      643         define variable vRindex1 as integer no-undo.
      644         define variable vRindex2 as integer no-undo.
      645         vRindex1 = r-index(p-message," ",70).
      646         if vRindex1 = 0
      647         then
      648            vRindex1 = 70.
      649         if length(p-message)  <= vRindex1 + 70 then do:
      650           assign
      651             v-waitfram-action01 = " "
      652             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      653             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      654           .
      655         end.
      656         else do:
      657           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      658           if vRindex2 <= vRindex1
      659           then
      660              vRindex2 = vRindex1 + 70.
      661           assign
      662             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      663             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      664             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      665           .
      666         end.
      667       end.
      668       B-viewProcInfo:visible   in frame waitfram = no.
      669       B-viewProcInfo:sensitive in frame waitfram = no.
      670       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      671       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      672       if  (   mWaitFramView
      673          or  mWaitProcEvent)
      674          and not mBatchMode
      675       then
      676          display
      677             v-waitfram-action01 skip
      678             v-waitfram-action02 skip
      679             v-waitfram-action03 skip
      680          with frame waitfram .
      681       if     mWaitFramView
      682          then do:
      683             if     mWaitFramInterval ne ?
      684                and not mBatchMode
      685             then
      686                wait-for go of frame waitfram pause mWaitFramInterval.
      687          end.
      688          else
      689             if     mWaitProcEvent
      690                and not mBatchMode
      691             then
      692                process events .
      693     end.
      694   end procedure.
      695      procedure waitfram-show-this:
      696         define input  parameter iInterval as int64 no-undo.
      697         define variable vtime as int64 no-undo.
      698         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      699         mWaitFramInterval = iInterval.
      700         run waitfram-show (substitute("&1&2 &3&4" ,
      701                                       mWaitFramTextBeg ,
      702                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      703                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      704                                       mWaitFramTextEnd
      705                                      )
      706                           ).
      707      end.
      708      procedure WaitFramRunPause:
      709         define input  parameter iInterval as dec no-undo.
      710         define variable vStart  as datetime-tz no-undo.
      711         define variable vend    as datetime-tz no-undo.
      712         define variable vint as int64 no-undo.
      713         define variable vOk as logical no-undo.
      714         vStart = now.
      715         vend   = vStart.
      716         publish "WaitFramPause" (iInterval,output vOk).
      717         vend   =  now.
      718         vint = vend - vStart.
      719         vint = iInterval - vint / 1000.
      720         if     not mWaitFramStop
      721            and (   vint > 0
      722                 or (    not vOk
      723                     and iInterval eq ?
      724                     )
      725                 )
      726         then
      727            run waitfram-show-this (iInterval).
      728         vend   =  now.
      729         vint = vend - vStart.
      730         vint = iInterval - vint / 1000.
      731         if     not mWaitFramStop
      732            and vint > 0
      733         then do:
      734            run gbl/pause.p (vint * 1000).
      735         end.
      736         if iInterval ne ?
      737         then
      738            publish "WaitFramStop".
      739         waitfram-check-timeout().
      740      end.
      741      procedure WaitFramWaitFor:
      742         define input  parameter iInterval as dec no-undo.
      743         assign
      744            mWaitFramStartProc   = now
      745            mWaitFramStopUser    = no
      746            mWaitFramStopTimeOut = no
      747         .
      748         block-wait:
      749         do while not mWaitFramStop:
      750            run WaitFramRunPause (iInterval).
      751            if  waitfram-check-timeout()
      752            then do:
      753               leave block-wait.
      754            end.
      755         end.
      756         run waitfram-hide.
      757      end.
      758   procedure waitfram-join :
      759     define input  parameter p-line-1  as character no-undo .
      760     define input  parameter p-line-2  as character no-undo .
      761     define input  parameter p-line-3  as character no-undo .
      762     define output parameter p-message as character no-undo .
      763     do
      764     on error undo, return error return-value
      765     :
      766       assign
      767         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      768                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      769                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      770       .
      771     end.
      772   end procedure.
      773   function waitfram-join-function returns character
      774     (input p-line-1 as character
      775     ,input p-line-2 as character
      776     ,input p-line-3 as character
      777     ).
      778     define variable v-message as character no-undo .
      779     run waitfram-join in this-procedure
      780       (input  p-line-1
      781       ,input  p-line-2
      782       ,input  p-line-3
      783       ,output v-message
      784       ) .
      785     return v-message .
      786   end function .
      787   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      788   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      789   define variable dcard-algo-field-name as character no-undo extent 3 init [
      790    'd-pcnt':U
      791   ,'cash-d-pcnt':U
      792   ,'pcnt-kat':U].
      793   define variable algo-field-abbr as character no-undo extent 3 init [
      794    'ITEM%':U
      795   ,'TOTAL%':U
      796   ,'CATEG':U].
      797   FUNCTION dct-algo-Date-to-String returns character(input  p-date as date):
      798   define variable v-date-str as character no-undo .
      799   assign
      800   v-date-str = string(YEAR(p-date), "9999":U) + chr(47) +
      801                string(Month(p-date), "99":U) + chr(47) +
      802                string(DAY(p-date), "99":U).
      803   return v-date-str.
      804   END FUNCTION.
      805   function dct-algo-string-to-date returns date ( input p-string  as character):
      806     define variable v-date as date no-undo .
      807     assign
      808     v-date = date(integer(substring(p-string, 6, 2))
      809                   ,integer(substring(p-string, 9, 2))
      810                   ,integer(substring(p-string, 1, 4))
      811                  ) no-error .
      812     if error-status:error then return ?.
      813     return v-date.
      814   END FUNCTION.
      815   FUNCTION dct-algo-get-sum-id-from-DT-CODE returns character ( input p-DT-CODE as integer):
      816   define buffer buf_prop-ref for ub.prop-ref.
      817   find first buf_prop-ref no-lock where
      818             buf_prop-ref.DT-CODE = p-DT-CODE no-error.
      819   if not available buf_prop-ref then do:
      820     return chr(63).
      821   end.
      822   return buf_prop-ref.sum-id.
      823   END FUNCTION.
      824   FUNCTION dct-algo-get-description-sum-id returns character ( input p-dt-code as integer):
      825   define variable v-des as character no-undo .
      826   define buffer buf_prop-ref for ub.prop-ref.
      827   define buffer buf_prop-head for ub.prop-head.
      828   find first buf_prop-ref no-lock where
      829             buf_prop-ref.dt-code = p-dt-code no-error.
      830   if not available buf_prop-ref then do:
      831     return substitute("Срез/итог по ДК c кодом &1 - срез не найден", p-dt-code).
      832   end.
      833   find first buf_prop-head no-lock where
      834           buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error.
      835   if not available buf_prop-head then do:
      836     return substitute("Срез/итог по ДК &1 c кодом &2 - неизвестное", p-dt-code, buf_prop-ref.dtm-code).
      837   end.
      838   assign
      839   v-des = substitute("&1  &2 &3"
      840                     , buf_prop-head.prop-name
      841                     , buf_prop-ref.sum-id
      842                     , buf_prop-ref.caller_id).
      843   return v-des.
      844   end FUNCTION.
      845   FUNCTION dct-algo-get-description-node-code returns character ( input p-dtm-code as integer
      846                                                               ,input p-dt-code as integer
      847                                                               ,input p-node-code as integer
      848                                                               ):
      849   define variable v-des as character no-undo .
      850   define buffer buf_prop-ref for ub.prop-ref.
      851   define buffer buf_prop-head for ub.prop-head.
      852   define buffer buf_prop-map for ub.prop-map.
      853   find first buf_prop-ref no-lock where
      854             buf_prop-ref.dt-code = p-dt-code no-error.
      855   if not available buf_prop-ref then do:
      856     return substitute("Срез/итог по ДК c кодом &1 - срез не найден", p-dt-code).
      857   end.
      858   find first buf_prop-head no-lock where
      859           buf_prop-head.dtm-code = p-dtm-code no-error.
      860   if not available buf_prop-head then do:
      861     return substitute("Срез/итог по ДК &1 c кодом &2 - неизвестное", p-dt-code, p-dtm-code).
      862   end.
      863   find first buf_prop-map no-lock where
      864           buf_prop-map.dtm-code = p-dtm-code
      865       and buf_prop-map.node-code = p-node-code no-error .
      866   if not available buf_prop-map then do:
      867     return substitute("Срез/итог по ДК &1, &2.&3 - неизвестно"
      868                       , p-dt-code
      869                       , buf_prop-head.prop-label
      870                       , p-node-code).
      871   end.
      872   assign
      873   v-des = substitute("&1.&2 &3 &4"
      874                     , buf_prop-head.prop-label
      875                     , buf_prop-map.node-label
      876                     , buf_prop-ref.sum-id
      877                     , buf_prop-ref.caller_id).
      878   return v-des.
      879   end FUNCTION.
      880   function dct-algo-get-prev-sum-id RETURNS integer (
      881                                                       input p-dt-code as integer
      882                                                      ):
      883   define variable v-dtm-code as integer no-undo .
      884   define variable v-sum-id as character no-undo .
      885   define variable v-caller-id as character no-undo .
      886   define buffer buf_prop-ref for ub.prop-ref.
      887   find first buf_prop-ref no-lock where
      888           buf_prop-ref.dt-code = p-dt-code no-error.
      889   if not available buf_prop-ref then return ?.
      890   assign
      891   v-dtm-code = buf_prop-ref.dtm-code
      892   v-sum-id = buf_prop-ref.sum-id.
      893   v-caller-id = buf_prop-ref.caller_id.
      894   find last buf_prop-ref no-lock where
      895             buf_prop-ref.dtm-code = v-dtm-code
      896        and  buf_prop-ref.sum-id < v-sum-id
      897        and  buf_prop-ref.caller_id = v-caller-id
      898        no-error.
      899   if available buf_prop-ref then return buf_prop-ref.dt-code.
      900   return -1 .
      901   END FUNCTION.
      902   FUNCTION dct-algo-get_dcproperty-value returns logical (
      903                                                             input p-prop-name as character
      904                                                           , input p-d-card    as character
      905                                                           , input p-host-code as integer
      906                                                           , input p-obj-type  as character
      907                                                           , input p-obj-code  as integer
      908                                                           , output p-value-character as character
      909                                                           , output p-value-date   as date
      910                                                           , output p-value-integer as integer
      911                                                           , output p-value-decimal as decimal
      912                                                           , output p-value-logical as logical):
      913     return no.
      914   END FUNCTION.
      915   FUNCTION dct-algo-get_dcproperty-value-chr returns logical (
      916                                                             input p-d-card    as character
      917                                                           , input p-emitent-host-code as integer
      918                                                           , input p-type as character
      919                                                           , input p-host-code as integer
      920                                                           , input p-obj-type  as character
      921                                                           , input p-obj-code  as integer
      922                                                           , output p-value-chr as character):
      923   define variable v-dt-code as integer no-undo .
      924   define variable v-node-code as integer no-undo .
      925   define variable v-field-name as character no-undo .
      926   define variable v-storage-place as character no-undo .
      927   define variable v-sum-id-value as character no-undo .
      928   define variable v-sum-id-output as logical no-undo .
      929   define variable v-value-chr as character no-undo .
      930   define variable v-ii as integer no-undo .
      931   define buffer buf_dis-card-property for ub.dis-card-property.
      932   define buffer buf_dis-host for ub.dis-host.
      933   define buffer buf_dis-obj for ub.dis-obj.
      934   run get-cd-sumid in this-procedure (
      935                                         input p-emitent-host-code
      936                                        ,input p-type
      937                                        ,input p-host-code
      938                                        ,input p-obj-type
      939                                        ,input p-obj-code
      940                                        ,output v-sum-id-value
      941                                        ,output v-sum-id-output
      942                                       ) no-error.
      943   if not v-sum-id-output then do:
      944     return no.
      945   end.
      946   do v-ii = 1 to num-entries(v-sum-id-value):
      947     assign
      948     v-storage-place = entry(1, entry(v-ii, v-sum-id-value), chr(4))
      949     v-dt-code = integer(entry(2, entry(v-ii, v-sum-id-value), chr(4)))
      950     v-node-code = integer(entry(3, entry(v-ii, v-sum-id-value), chr(4)))
      951     v-field-name = entry(4, entry(v-ii, v-sum-id-value), chr(4))
      952     no-error .
      953     if not error-status:error then do:
      954       case v-storage-place:
      955         when 'dis-card-property':U then do:
      956           find first buf_dis-card-property no-lock where
      957                     buf_dis-card-property.d-card = p-d-card
      958               and  buf_dis-card-property.host-code = p-host-code
      959               and  buf_dis-card-property.obj-type = p-obj-type
      960               and  buf_dis-card-property.obj-code = p-obj-code
      961               and  buf_dis-card-property.dt-code = v-dt-code
      962               and  buf_dis-card-property.node-code = v-node-code no-error .
      963           if available buf_dis-card-property then do:
      964             v-value-chr = buffer buf_dis-card-property:handle:buffer-field(v-field-name):string-value.
      965           end.
      966           else do:
      967             v-value-chr = chr(63).
      968           end.
      969         end.
      970         when 'dis-obj':U then do:
      971           find first buf_dis-obj no-lock where
      972                     buf_dis-obj.d-card = p-d-card
      973               and  buf_dis-obj.obj-type = p-obj-type
      974               and  buf_dis-obj.obj-code = p-obj-code
      975               and  buf_dis-obj.dt-code = v-dt-code no-error .
      976           if available buf_dis-obj then do:
      977             v-value-chr = buffer buf_dis-obj:handle:buffer-field(v-field-name):string-value.
      978           end.
      979           else do:
      980             v-value-chr = chr(63).
      981           end.
      982         end.
      983         when 'dis-host':U then do:
      984           find first buf_dis-host no-lock where
      985                     buf_dis-host.d-card = p-d-card
      986               and  buf_dis-host.host-code = p-host-code
      987               and  buf_dis-host.dt-code = v-dt-code no-error .
      988           if available buf_dis-host then do:
      989             v-value-chr = buffer buf_dis-host:handle:buffer-field(v-field-name):string-value.
      990           end.
      991           else do:
      992             v-value-chr = chr(63).
      993           end.
      994         end.
      995       end.
      996     end.
      997     p-value-chr = p-value-chr + (if v-ii = 1 then '':U else chr(44)) + v-value-chr.
      998   end.
      999   END FUNCTION.
     1000   FUNCTION dct-algo_custom-sent-description RETURNS CHARACTER
     1001     ( INPUT p-custom-sent as character ) :
     1002   DEFINE VARIABLE v-storage-place AS CHARACTER NO-UNDO.
     1003   DEFINE VARIABLE v-dtm-code AS integer NO-UNDO.
     1004   DEFINE VARIABLE v-sum-id AS character NO-UNDO.
     1005   DEFINE VARIABLE v-caller-id AS character NO-UNDO.
     1006   DEFINE VARIABLE v-node-code AS INTEGER NO-UNDO.
     1007   DEFINE VARIABLE v-sum-id-description AS CHARACTER.
     1008   DEFINE BUFFER buf_prop-ref FOR ub.prop-ref.
     1009   IF p-custom-sent = chr(63) THEN RETURN "Не отсылать".
     1010   assign
     1011   v-storage-place = entry(1, p-custom-sent, chr(4))
     1012   v-dtm-code = integer(entry(2, p-custom-sent, chr(4)))
     1013   v-sum-id   = entry(3, p-custom-sent, chr(4))
     1014   v-caller-id = entry(4, p-custom-sent, chr(4))
     1015   v-node-code = integer(entry(5, p-custom-sent, chr(4)))
     1016   no-error .
     1017   IF ERROR-STATUS:ERROR THEN DO:
     1018     MESSAGE
     1019     "Не могу разобрать строку, описывающую итог"
     1020      VIEW-AS ALERT-BOX WARNING.
     1021     RETURN chr(63).
     1022   END.
     1023   FIND FIRST buf_prop-ref NO-LOCK WHERE
     1024             buf_prop-ref.dtm-code = v-dtm-code
     1025        AND  buf_prop-ref.sum-id = v-sum-id
     1026        AND  buf_prop-ref.caller_id = v-caller-id NO-ERROR.
     1027   IF NOT AVAILABLE buf_prop-ref THEN DO:
     1028     FIND FIRST buf_prop-ref NO-LOCK WHERE
     1029               buf_prop-ref.dtm-code = v-dtm-code
     1030         AND  buf_prop-ref.caller_id = v-caller-id NO-ERROR.
     1031     IF NOT AVAILABLE buf_prop-ref THEN DO:
     1032         MESSAGE
     1033         "Не могу разобрать строку, описывающую итог"
     1034          VIEW-AS ALERT-BOX WARNING.
     1035         RETURN chr(63).
     1036      end.
     1037   end.
     1038   ASSIGN
     1039   v-sum-id-description =  dct-algo-get-description-node-code ( v-dtm-code
     1040                                                          ,buf_prop-ref.dt-code
     1041                                                          ,v-node-code).
     1042   RETURN v-sum-id-description.
     1043   END FUNCTION.
     1044   FUNCTION one-base-cur-for-objs  returns logical (output p-glob-curr-code as integer):
     1045   define variable v-glob-val as logical no-undo init yes.
     1046   define buffer buf_sysconf for ub.sysconf.
     1047   define buffer buf_clients for ub.clients.
     1048   assign
     1049   p-glob-curr-code =  -1
     1050   .
     1051   FOR EACH buf_sysconf NO-LOCK,
     1052       first buf_clients no-lock where
     1053            buf_clients.host-code = buf_sysconf.host-code:
     1054       if p-glob-curr-code = -1 then
     1055       assign
     1056       p-glob-curr-code = buf_sysconf.base-code
     1057       .
     1058       else if p-glob-curr-code <> buf_sysconf.base-code then do:
     1059           assign
     1060           v-glob-val = no
     1061           p-glob-curr-code = ?
     1062           .
     1063           LEAVE.
     1064       end.
     1065   END.
     1066   return v-glob-val.
     1067   END FUNCTION.
     1068   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1069     define variable v-cntxt-db-num        as integer   no-undo .
     1070     define variable v-cntxt-userid        as character no-undo .
     1071     define variable v-cntxt-level         as character no-undo .
     1072     define variable v-cntxt-host-code-obj as integer   no-undo .
     1073     define variable v-cntxt-obj-type      as character no-undo .
     1074     define variable v-cntxt-obj-code      as integer   no-undo .
     1075     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1076     define variable v-cntxt-is-admin      as logical   no-undo .
     1077   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1078   define new global shared variable g#lib-nws as handle no-undo .
     1079   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1080   function dc-smart_is-this-correct RETURNS CHARACTER
     1081     ( INPUT p-dt-code AS INTEGER
     1082     , INPUT p-table-name AS CHARACTER
     1083     , INPUT p-db-num AS INTEGER
     1084     , INPUT p-type AS CHARACTER
     1085     , INPUT p-emitent-host-code AS INTEGER
     1086     , INPUT p-obj-type AS CHARACTER
     1087      ,input p-obj-code AS INTEGER
     1088      ,INPUT p-d-card AS CHARACTER
     1089       ) :
     1090   define VARIABLE v-dtm-code AS INTEGER NO-UNDO.
     1091   define VARIABLE v-smart-nws AS INTEGER NO-UNDO.
     1092   define VARIABLE v-obj-db-num AS INTEGER NO-UNDO INIT -1.
     1093   DEFINE BUFFER buf_dis-obj FOR ub.dis-obj.
     1094   DEFINE BUFFER buf_hist-nws-option FOR ub.hist-nws-option.
     1095   DEFINE BUFFER buf_prop-ref FOR ub.prop-ref.
     1096   DEFINE BUFFER buf_clients FOR ub.clients.
     1097   IF p-db-num = 0 THEN  RETURN "+".
     1098   IF p-table-name = 'dis-obj':U THEN DO:
     1099   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1100   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1101     (input  p-obj-type
     1102     ,input  p-obj-code
     1103     ,output v-obj-db-num
     1104     ) NO-ERROR .
     1105     IF v-obj-db-num = p-db-num THEN RETURN "+".
     1106   END.
     1107   IF p-dt-code = 0 THEN DO:
     1108     v-dtm-code = 1.
     1109   END.
     1110   ELSE DO:
     1111      FIND FIRST buf_prop-ref NO-LOCK WHERE
     1112               buf_prop-ref.dt-code = p-dt-code NO-ERROR.
     1113     IF AVAILABLE buf_prop-ref  THEN DO:
     1114       v-dtm-code = buf_prop-ref.dtm-code.
     1115     END.
     1116   END.
     1117   find first buf_HIST-NWS-OPTION WHERE
     1118         buf_HIST-NWS-OPTION.db-num = 0
     1119         and buf_hist-nws-option.table-name = p-table-name
     1120         and buf_hist-nws-option.host-code = p-emitent-host-code
     1121         and buf_hist-nws-option.obj-type = '':U
     1122         and buf_hist-nws-option.obj-code = 0
     1123         and buf_hist-nws-option.key#_one = 1
     1124         and buf_hist-nws-option.charkey_one = p-type
     1125         and buf_hist-nws-option.subject-group = 'c-dc-hist':U NO-ERROR.
     1126   IF NOT AVAILABLE buf_hist-nws-option THEN v-smart-nws = -1.
     1127   ELSE v-smart-nws = buf_hist-nws-option.smart-nws .
     1128   IF v-smart-nws = INTEGER('0':U) THEN DO:
     1129     FOR EACH buf_dis-obj NO-LOCK WHERE
     1130              buf_Dis-obj.d-card = p-d-card,
     1131         FIRST buf_clients NO-LOCK WHERE
     1132             buf_Clients.obj-type = buf_dis-obj.obj-type
     1133          AND buf_clients.obj-code = buf_dis-obj.obj-code
     1134         AND buf_clients.db-num =  p-db-num:
     1135        LEAVE.
     1136     END.
     1137     IF AVAILABLE buf_dis-obj THEN RETURN "+".
     1138     RETURN "-".
     1139   END.
     1140   IF v-smart-nws = INTEGER('1':U) THEN RETURN "-".
     1141   RETURN "+".
     1142   END FUNCTION.
     1143   define variable LogRes as logical no-undo .
     1144   define buffer for-dis for ub.dis-obj.
     1145   define variable max-pay-sum like ub.dis-obj.pay-tot-base.
     1146   define variable TotalPayPrim as decimal no-undo.
     1147   define variable CreditSumPrim as decimal no-undo.
     1148   define variable TotalSumPrim as decimal no-undo.
     1149   define variable DiscSumPrim as decimal no-undo.
     1150   define variable NettoSumPrim as decimal no-undo.
     1151   define variable MustPayPrim as decimal no-undo.
     1152   define variable SaldosumPrim as decimal no-undo.
     1153   define variable RestLimitPrim as decimal no-undo.
     1154   define variable LimitSumPrim as decimal no-undo.
     1155   define variable globalcard as logical no-undo.
     1156   define variable sort-column-name as character no-undo .
     1157   define variable rid as recid no-undo.
     1158   define variable glob-val as logical no-undo init yes.
     1159   define variable v-glob-curr-code like ub.currency.curr-code no-undo .
     1160   define variable v-curr-r-b as character no-undo .
     1161   define variable v-first as logical no-undo init yes.
     1162   define variable vhb as character no-undo .
     1163   define variable vhr as character NO-UNDO .
     1164   define variable vob as character no-undo .
     1165   define variable vor as character no-undo .
     1166   DEFINE VARIABLE v-ok-dis-obj AS CHARACTER NO-UNDO.
     1167   DEFINE VARIABLE v-ok-rdis-obj AS CHARACTER NO-UNDO.
     1168   DEFINE VARIABLE v-ok-dis-host AS CHARACTER NO-UNDO.
     1169   DEFINE VARIABLE v-ok-rdis-host AS CHARACTER NO-UNDO.
     1170   define buffer current_dis-card for ub.dis-card.
     1171   DEFINE BUTTON B-chk
     1172        LABEL "Че&ки"
     1173        SIZE 10 BY 1.
     1174   DEFINE BUTTON B-help
     1175        LABEL "Помо&щь"
     1176        SIZE 3 BY 1.
     1177   DEFINE BUTTON b-history
     1178        LABEL "Ис&тория"
     1179        SIZE 3 BY 1
     1180        BGCOLOR 8 .
     1181   DEFINE BUTTON B-print
     1182        LABEL "Пе&чать"
     1183        SIZE 3 BY 1.
     1184   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
     1185        LABEL "&Выход "
     1186        SIZE 10 BY 1
     1187        BGCOLOR 8 .
     1188   DEFINE BUTTON Btn_Cost
     1189        LABEL "&Учет"
     1190        SIZE 10 BY 1
     1191        BGCOLOR 8 .
     1192   DEFINE VARIABLE CreditSum AS DECIMAL FORMAT "->>,>>>,>>>,>>9.99" INITIAL 0
     1193         VIEW-AS TEXT
     1194        SIZE 19 BY .67
     1195        BGCOLOR 8  NO-UNDO.
     1196   DEFINE VARIABLE DiscSum AS DECIMAL FORMAT "->>,>>>,>>>,>>9.99" INITIAL 0
     1197         VIEW-AS TEXT
     1198        SIZE 19 BY .67
     1199        BGCOLOR 8 FGCOLOR 0  NO-UNDO.
     1200   DEFINE VARIABLE f-smart-info-sums AS CHARACTER FORMAT "X(256)":U INITIAL "Нет маршрутизации:данные м.б. некорректны!!!!"
     1201         VIEW-AS TEXT
     1202        SIZE 46.5 BY .67
     1203        FGCOLOR 4  NO-UNDO.
     1204   DEFINE VARIABLE LimitSum AS DECIMAL FORMAT "->>,>>>,>>>,>>9.99" INITIAL 0
     1205         VIEW-AS TEXT
     1206        SIZE 19 BY .67
     1207        BGCOLOR 8  NO-UNDO.
     1208   DEFINE VARIABLE lNumCard AS CHARACTER FORMAT "X(256)":U INITIAL "Карт с учетом перевыпуска"
     1209         VIEW-AS TEXT
     1210        SIZE 27.3 BY .67
     1211        FGCOLOR 1  NO-UNDO.
     1212   DEFINE VARIABLE Mustpay AS DECIMAL FORMAT "->>,>>>,>>>,>>9.99" INITIAL 0
     1213         VIEW-AS TEXT
     1214        SIZE 19 BY .67
     1215        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
     1216   DEFINE VARIABLE NettoSum AS DECIMAL FORMAT "->>,>>>,>>>,>>9.99" INITIAL 0
     1217         VIEW-AS TEXT
     1218        SIZE 19 BY .7
     1219        BGCOLOR 8 FGCOLOR 0  NO-UNDO.
     1220   DEFINE VARIABLE NumCard AS INTEGER FORMAT ">,>>>,>>9":U INITIAL 0
     1221         VIEW-AS TEXT
     1222        SIZE 6.8 BY .67
     1223        BGCOLOR 8 FGCOLOR 0  NO-UNDO.
     1224   DEFINE VARIABLE NumChk AS INTEGER FORMAT "->>>>>>9":U INITIAL 0
     1225         VIEW-AS TEXT
     1226        SIZE 8 BY .67
     1227        BGCOLOR 8 FGCOLOR 0  NO-UNDO.
     1228   DEFINE VARIABLE RestLimit AS DECIMAL FORMAT "->>,>>>,>>>,>>9.99" INITIAL 0
     1229         VIEW-AS TEXT
     1230        SIZE 19 BY .67
     1231        BGCOLOR 8  NO-UNDO.
     1232   DEFINE VARIABLE SaldoSum AS DECIMAL FORMAT "->>,>>>,>>>,>>9.99" INITIAL 0
     1233         VIEW-AS TEXT
     1234        SIZE 19 BY .67
     1235        BGCOLOR 8  NO-UNDO.
     1236   DEFINE VARIABLE TotalPay AS DECIMAL FORMAT "->>,>>>,>>>,>>9.99" INITIAL 0
     1237         VIEW-AS TEXT
     1238        SIZE 19 BY .7
     1239        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
     1240   DEFINE VARIABLE TotalSum AS DECIMAL FORMAT "->>,>>>,>>>,>>9.99" INITIAL 0
     1241         VIEW-AS TEXT
     1242        SIZE 19 BY .67
     1243        BGCOLOR 8 FGCOLOR 0  NO-UNDO.
     1244   DEFINE VARIABLE val-title AS CHARACTER FORMAT "X(256)":U INITIAL "ИТОГО по карте (данные офиса)"
     1245         VIEW-AS TEXT
     1246        SIZE 29.4 BY .67 NO-UNDO.
     1247   DEFINE VARIABLE Rs-gen-private AS INTEGER
     1248        VIEW-AS RADIO-SET HORIZONTAL
     1249        RADIO-BUTTONS
     1250             "Общие", 0,
     1251   "Частные", 1
     1252        SIZE 18 BY .67 NO-UNDO.
     1253   DEFINE VARIABLE rs-host-obj AS CHARACTER
     1254        VIEW-AS RADIO-SET HORIZONTAL
     1255        RADIO-BUTTONS
     1256             "Объекты", "obj",
     1257   "Фирмы", "host"
     1258        SIZE 18 BY .67 NO-UNDO.
     1259   DEFINE VARIABLE SelectCurr AS CHARACTER
     1260        VIEW-AS RADIO-SET HORIZONTAL
     1261        RADIO-BUTTONS
     1262             "abbr_rubli_firstshift", "rubl",
     1263   "Баз.вал.", "base"
     1264        SIZE 25.8 BY .63 NO-UNDO.
     1265   DEFINE RECTANGLE RECT-1
     1266        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1267        SIZE 98 BY 7.33
     1268        BGCOLOR 8 FGCOLOR 0 .
     1269   DEFINE VARIABLE T-legacy AS LOGICAL INITIAL no
     1270        LABEL "Перевыпуск"
     1271        VIEW-AS TOGGLE-BOX
     1272        SIZE 12.5 BY .97 TOOLTIP "С учетом перевыпуска карт" NO-UNDO.
     1273   DEFINE VARIABLE T-subsid AS LOGICAL INITIAL no
     1274        LABEL "Дополнит-ные"
     1275        VIEW-AS TOGGLE-BOX
     1276        SIZE 15.5 BY .97 TOOLTIP "С учетом дополнительных карт" NO-UNDO.
     1277   DEFINE QUERY BR-dis-host-b FOR
     1278         htt-dis-card,
     1279         ub.dis-host,
     1280         ub.sysconf SCROLLING.
     1281   DEFINE QUERY BR-dis-host-r FOR
     1282         hrtt-dis-card,
     1283         r_dis-host,
     1284         r_sysconf SCROLLING.
     1285   DEFINE QUERY BR-dis-obj-b FOR
     1286         tt-dis-card,
     1287         ub.dis-obj,
     1288         ub.shop SCROLLING.
     1289   DEFINE QUERY BR-dis-obj-r FOR
     1290         rtt-dis-card,
     1291         r_dis-obj,
     1292         r_shop SCROLLING.
     1293   DEFINE BROWSE BR-dis-host-b
     1294     QUERY BR-dis-host-b NO-LOCK DISPLAY
     1295         dc-smart_is-this-correct( INPUT dis-host.dt-code
     1296                         ,INPUT 'dis-host':U
     1297                         ,INPUT v-cntxt-db-num
     1298                         ,INPUT htt-dis-card.TYPE
     1299                          ,INPUT htt-dis-card.emitent-host-code
     1300                          ,INPUT 'орг':U
     1301                          ,INPUT dis-host.host-code
     1302                          ,INPUT htt-dis-card.d-card)
     1303         @ v-ok-dis-host COLUMN-LABEL "OK" FORMAT "X(1)"
     1304         dis-host.host-code COLUMN-LABEL "Фирма" FORMAT "99999"
     1305         dct-algo-get-sum-id-from-dt-code(INPUT dis-host.dt-code) @ vhb COLUMN-LABEL "ЧАСТНЫЙ ИТОГ" FORMAT "X(32)"
     1306         dis-host.gds-tot-base COLUMN-LABEL "Сумма товарная" format "->>,>>>,>>>,>>>,>>9.99"
     1307         dis-host.gds-dis-base COLUMN-LABEL "Скидка товарная" format "->>,>>>,>>>,>>>,>>9.99"
     1308         dis-host.gds-tot-base  - dis-host.gds-dis-base COLUMN-LABEL "Сумма нетто" FORMAT "->>,>>>,>>>,>>>,>>>.<<"
     1309         dis-host.num-chk COLUMN-LABEL "Число!чеков" format "->>>>>9"
     1310         dis-host.gds-tot-base  - dis-host.gds-dis-base  - dis-host.pay-tot-base COLUMN-LABEL "Сумма в кредит" FORMAT "->>,>>>,>>>,>>>,>>>.<<"
     1311         dis-host.d-card COLUMN-LABEL "Дисконтная карта" format "X(16)"
     1312      ENABLE
     1313         dis-host.num-chk
     1314       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 8.63
     1315            BGCOLOR 15
     1316            TITLE BGCOLOR 15 "В баз. вал.".
     1317   DEFINE BROWSE BR-dis-host-r
     1318     QUERY BR-dis-host-r NO-LOCK DISPLAY
     1319         dc-smart_is-this-correct( INPUT r_dis-host.dt-code
     1320                         ,INPUT 'dis-host':U
     1321                         ,INPUT v-cntxt-db-num
     1322                         ,INPUT hrtt-dis-card.TYPE
     1323                          ,INPUT hrtt-dis-card.emitent-host-code
     1324                          ,INPUT 'орг':U
     1325                          ,INPUT r_dis-host.host-code
     1326                          ,INPUT hrtt-dis-card.d-card)
     1327         @ v-ok-rdis-host COLUMN-LABEL "OK" FORMAT "X(1)"
     1328         r_dis-host.host-code COLUMN-LABEL "Фирма" FORMAT "99999"
     1329         dct-algo-get-sum-id-from-dt-code(INPUT r_dis-host.dt-code) @ vhr COLUMN-LABEL "ЧАСТНЫЙ ИТОГ" FORMAT "X(32)"
     1330         r_dis-host.gds-tot-rubl COLUMN-LABEL "Сумма товарная" format "->>,>>>,>>>,>>>,>>9.99"
     1331         r_dis-host.gds-dis-rubl COLUMN-LABEL "Скидка товарная" format "->>,>>>,>>>,>>>,>>9.99"
     1332         r_dis-host.gds-tot-rubl  - r_dis-host.gds-dis-rubl COLUMN-LABEL "Сумма нетто" FORMAT "->>,>>>,>>>,>>>,>>>.<<"
     1333         r_dis-host.num-chk COLUMN-LABEL "Число!чеков" format "->>>>>9"
     1334         r_dis-host.gds-tot-rubl - r_dis-host.gds-dis-rubl - r_dis-host.pay-tot-rubl COLUMN-LABEL "Сумма в кредит" FORMAT "->>,>>>,>>>,>>>,>>>.<<"
     1335         r_dis-host.d-card COLUMN-LABEL "Дисконтная карта" format "X(16)"
     1336     ENABLE
     1337         r_dis-host.num-chk
     1338       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 8.63
     1339            BGCOLOR 15 FGCOLOR 0
     1340            TITLE BGCOLOR 15 FGCOLOR 0 "В abbr_rublyah".
     1341   DEFINE BROWSE BR-dis-obj-b
     1342     QUERY BR-dis-obj-b NO-LOCK DISPLAY
     1343         dc-smart_is-this-correct( INPUT ub.dis-obj.dt-code
     1344                         ,INPUT 'dis-obj':U
     1345                         ,INPUT v-cntxt-db-num
     1346                         ,INPUT tt-dis-card.TYPE
     1347                          ,INPUT tt-dis-card.emitent-host-code
     1348                          ,INPUT ub.dis-obj.obj-type
     1349                          ,INPUT ub.dis-obj.obj-code
     1350                          ,INPUT tt-dis-card.d-card)
     1351         @ v-ok-dis-obj COLUMN-LABEL "OK" FORMAT "X(1)"
     1352         ub.dis-obj.obj-code COLUMN-LABEL "Магазин" FORMAT ">>>>9"
     1353         dct-algo-get-sum-id-from-dt-code(INPUT ub.dis-obj.dt-code) @ vob COLUMN-LABEL "ЧАСТНЫЙ ИТОГ" FORMAT "X(32)"
     1354         ub.dis-obj.gds-tot-base COLUMN-LABEL "Сумма товарная"  format "->>,>>>,>>>,>>>,>>9.99"
     1355         ub.dis-obj.gds-dis-base COLUMN-LABEL "Скидка товарная" format "->>,>>>,>>>,>>>,>>9.99"
     1356         ub.dis-obj.gds-tot-base + ub.dis-obj.sum-tot-base - ub.dis-obj.gds-dis-base - ub.dis-obj.sum-dis-base COLUMN-LABEL "Сумма нетто" FORMAT "->>,>>>,>>>,>>>,>>9.99"
     1357         ub.dis-obj.num-chk COLUMN-LABEL "Число!чеков" format "->>>>>9"
     1358         ub.dis-obj.gds-tot-base - ub.dis-obj.gds-dis-base + ub.dis-obj.sum-tot-base - ub.dis-obj.sum-dis-base - ub.dis-obj.pay-tot-base COLUMN-LABEL "Сумма в кредит" FORMAT "->>,>>>,>>>,>>>,>>9.99"
     1359         ub.dis-obj.d-card COLUMN-LABEL "Дисконтная карта" format "X(16)"
     1360      ENABLE
     1361         ub.dis-obj.num-chk
     1362       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 8.63
     1363            BGCOLOR 15 FGCOLOR 0
     1364            TITLE BGCOLOR 15 FGCOLOR 0 "В баз. вал.".
     1365   DEFINE BROWSE BR-dis-obj-r
     1366     QUERY BR-dis-obj-r NO-LOCK DISPLAY
     1367         dc-smart_is-this-correct( INPUT r_dis-obj.dt-code
     1368                         ,INPUT 'dis-obj':U
     1369                         ,INPUT v-cntxt-db-num
     1370                         ,INPUT rtt-dis-card.TYPE
     1371                         ,INPUT rtt-dis-card.emitent-host-code
     1372                         ,INPUT r_dis-obj.obj-type
     1373                         ,INPUT r_dis-obj.obj-code
     1374                         ,INPUT rtt-dis-card.d-card)
     1375         @ v-ok-rdis-obj COLUMN-LABEL "OK" FORMAT "X(1)"
     1376         r_dis-obj.obj-code COLUMN-LABEL "Магазин" FORMAT "99999"
     1377         dct-algo-get-sum-id-from-dt-code(INPUT r_dis-obj.dt-code) @ vor COLUMN-LABEL "ЧАСТНЫЙ ИТОГ" FORMAT "X(32)"
     1378         r_dis-obj.gds-tot-rubl COLUMN-LABEL "Сумма товарная" format "->>,>>>,>>>,>>>,>>9.99"
     1379         r_dis-obj.gds-dis-rubl COLUMN-LABEL "Скидка товарная" format "->>,>>>,>>>,>>>,>>9.99"
     1380         r_dis-obj.gds-tot-rubl + r_dis-obj.sum-tot-rubl - r_dis-obj.gds-dis-rubl - r_dis-obj.sum-dis-rubl COLUMN-LABEL "Сумма нетто" FORMAT "->>,>>>,>>>,>>>,>>>.<<"
     1381         r_dis-obj.num-chk COLUMN-LABEL "Число!чеков" format "->>>>>9"
     1382         r_dis-obj.gds-tot-rubl + r_dis-obj.sum-tot-rubl - r_dis-obj.gds-dis-rubl - r_dis-obj.sum-dis-rubl - r_dis-obj.pay-tot-rubl COLUMN-LABEL "Сумма в кредит" FORMAT "->>,>>>,>>>,>>>,>>>.<<"
     1383         r_dis-obj.d-card COLUMN-LABEL "Дисконтная карта" format "X(16)"
     1384         ENABLE
     1385         r_dis-obj.num-chk
     1386       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 8.63
     1387            BGCOLOR 15 FGCOLOR 0
     1388            TITLE BGCOLOR 15 FGCOLOR 0 "В abbr_rublyah".
