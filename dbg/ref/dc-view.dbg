     1887   ON VALUE-CHANGED OF T-legacy IN FRAME d-disc
     1888   DO:
     1889     assign
     1890     t-legacy.
     1891     if ub.dis-card.is-subsid = yes
     1892     and t-legacy = yes
     1893     then do:
     1894       assign
     1895       t-subsid = yes.
     1896       display
     1897       t-subsid
     1898       with frame d-disc .
     1899       disable
     1900       t-subsid
     1901       with frame d-disc .
     1902     end.
     1903     else do:
     1904       enable
     1905       t-subsid
     1906       with frame d-disc .
     1907     end.
     1908     run fill-tables in this-procedure ( input t-legacy, input t-subsid ).
     1909     run openbr in this-procedure ( input t-legacy
     1910                                  , input t-subsid
     1911                                  , input selectcurr
     1912                                  , input rs-gen-private
     1913                                  , input rs-host-obj).
     1914     RUN start-mv-clmnbr-dis-obj-b.
     1915     RUN start-mv-clmnbr-dis-obj-r.
     1916     run GetSums in this-procedure .
     1917     if RS-gen-PRivate = 1 then do:                          hide SelectCurr TotalSum NumCard NumChk DiscSum NettoSum SaldoSum TotalPay Mustpay CreditSum RestLimit LimitSum in frame d-disc.            display selectcurr with frame d-disc.      end.                                                  else do:                                                display SelectCurr TotalSum NumCard NumChk DiscSum NettoSum SaldoSum TotalPay Mustpay CreditSum RestLimit LimitSum with frame d-disc.     end.
     1918     CASE t-legacy:
     1919       when yes then do:
     1920         display SelectCurr TotalSum NumCard NumChk DiscSum NettoSum SaldoSum TotalPay Mustpay CreditSum RestLimit LimitSum with frame d-disc.
     1921       end.
     1922       when no then do:
     1923         hide lnumcard numcard in frame d-disc.
     1924       end.
     1925     END CASE.
     1926   END.
     1927   ON VALUE-CHANGED OF T-subsid IN FRAME d-disc
     1928   DO:
     1929     assign
     1930     t-subsid.
     1931     run fill-tables in this-procedure ( input t-legacy, input t-subsid).
     1932     run openbr in this-procedure (
     1933                                    input t-legacy
     1934                                  , input t-subsid
     1935                                  , input selectcurr
     1936                                  , input rs-gen-private
     1937                                  , input rs-host-obj).
     1938     RUN start-mv-clmnbr-dis-obj-b.
     1939     RUN start-mv-clmnbr-dis-obj-r.
     1940     run GetSums in this-procedure .
     1941     if RS-gen-PRivate = 1 then do:                          hide SelectCurr TotalSum NumCard NumChk DiscSum NettoSum SaldoSum TotalPay Mustpay CreditSum RestLimit LimitSum in frame d-disc.            display selectcurr with frame d-disc.      end.                                                  else do:                                                display SelectCurr TotalSum NumCard NumChk DiscSum NettoSum SaldoSum TotalPay Mustpay CreditSum RestLimit LimitSum with frame d-disc.     end.
     1942     CASE t-subsid:
     1943       when yes then do:
     1944         display SelectCurr TotalSum NumCard NumChk DiscSum NettoSum SaldoSum TotalPay Mustpay CreditSum RestLimit LimitSum with frame d-disc.
     1945       end.
     1946       when no then do:
     1947         hide lnumcard numcard in frame d-disc.
     1948       end.
     1949     END CASE.
     1950   END.
     1951   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-disc:PARENT eq ?
     1952   THEN FRAME d-disc:PARENT = ACTIVE-WINDOW.
     1953   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1954   on help of frame d-disc
     1955   do:
     1956     run gbl/app_help.p
     1957       (input this-procedure :file-name
     1958       ,input ''
     1959       ,input ?
     1960       ) no-error.
     1961     if error-status :error then do:
     1962       message
     1963         "Ошибка при вызове помощи"
     1964         error-status :get-message(1)
     1965         view-as alert-box .
     1966     end.
     1967   end.
     1968   run minbtn-set in this-procedure .
     1969   on choose of b-help in frame d-disc
     1970   do:
     1971     apply "help":u to frame d-disc .
     1972   end.
     1973   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1974   procedure minbtn-set :
     1975       do
     1976           on error undo, return error return-value
     1977           :
     1978           define variable ii              as integer       no-undo .
     1979           define variable fh              as widget-handle no-undo .
     1980           define variable hh              as widget-handle no-undo .
     1981           define variable v-h             as handle        extent 4 no-undo .
     1982           define variable v-name-button   as character     no-undo .
     1983           define variable v-help-old-x    as decimal       no-undo .
     1984           define variable v-help-old-y    as decimal       no-undo .
     1985           define variable v-help-old-size as decimal       no-undo .
     1986           define variable v-frame-width   as decimal       no-undo .
     1987           define variable jj              as integer       no-undo .
     1988           do
     1989               on error undo, return error
     1990               :
     1991               assign
     1992                   v-frame-width = frame d-disc:width - 0.3
     1993                   fh            = frame d-disc:first-child
     1994                   hh            = fh:first-child
     1995                   ii            = 1
     1996                   .
     1997               do while valid-handle(hh):
     1998                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1999                   do:
     2000                       case lc(hh:name) :
     2001                           when "b-help" then
     2002                               do:
     2003                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2004                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2005                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2006                                   hh:TOOLTIP = "Помощь" .
     2007                                   v-help-old-x = hh:column .
     2008                                   v-help-old-y = hh:row    .
     2009                                   v-help-old-size = hh:width .
     2010                                   hh:width-chars = 2.5 .
     2011                               end.
     2012                           when "b-print" then
     2013                               do:
     2014                                   hh:load-image("cmp/b-print.bmp":u) .
     2015                                   hh:TOOLTIP = "Печать" .
     2016                                   v-h[ii] = hh:handle .
     2017                                   ii = ii + 1 .
     2018                                   hh:width-chars = 3 .
     2019                               end.
     2020                           when "b-history" or
     2021                           when "b-hist" then
     2022                               do:
     2023                                   hh:load-image("cmp/b-hist.bmp":u) .
     2024                                   hh:TOOLTIP = "История" .
     2025                                   v-h[ii] = hh:handle .
     2026                                   ii = ii + 1 .
     2027                                   hh:width-chars = 3 .
     2028                               end.
     2029                           when "b-sch" then
     2030                               do:
     2031                                   hh:load-image("cmp/b-sch.bmp":u) .
     2032                                   hh:TOOLTIP = "Установка Фильтра" .
     2033                                   v-h[ii] = hh:handle .
     2034                                   ii = ii + 1 .
     2035                                   hh:width-chars = 3 .
     2036                               end.
     2037                           when "b-hist-user" then
     2038                               do:
     2039                                   hh:load-image("cmp/b-hist.bmp":u) .
     2040                                   hh:TOOLTIP = "История пользователя" .
     2041                                   ii = ii + 1 .
     2042                               end.
     2043                       end case.
     2044                   end.
     2045                   hh = hh:next-sibling.
     2046               end.
     2047               b-help:column = v-frame-width - b-help:width-chars.
     2048               jj = 0.
     2049               repeat ii = 4 to 1 by -1 :
     2050                   if valid-handle (v-h[ii] ) then
     2051                   do:
     2052                       jj  = jj + 1 .
     2053                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2054                       v-h[ii]:row    = v-help-old-y .
     2055                   end.
     2056               end.
     2057           end.
     2058       end.
     2059   end procedure.
     2060   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2061   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2062   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2063   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2064   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2065   define variable v-diasize-current-frame-height as decimal   no-undo .
     2066   define variable v-diasize-change-size          as logical   no-undo .
     2067   define variable v-diasize-resize-button        as handle    no-undo .
     2068   define variable v-diasize-wndmax               as logical   no-undo .
     2069   define variable v-diasize-wndstore             as logical   no-undo .
     2070   define variable v-diasize-proc-name            as character no-undo .
     2071   define variable v-diasize-browse-handle        as handle    no-undo .
     2072   define variable v-diasize-browse-number        as integer   no-undo .
     2073   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2074   define temp-table temp-diasize-handle no-undo
     2075     field handle-value  as handle
     2076     field save-position as decimal
     2077     index xpk is primary unique handle-value
     2078     .
     2079   define temp-table temp-browse-handle no-undo
     2080     field browse-type   as character
     2081     field browse-number as integer
     2082     field browse-handle as handle
     2083     field original-size as decimal
     2084     index xpk is primary unique browse-type browse-number
     2085     index xie browse-type browse-handle
     2086   .
     2087   procedure diasize_change-height :
     2088     define input  parameter p-change-value  as decimal   no-undo .
     2089     define input  parameter p-move-resize   as logical   no-undo .
     2090     define variable v-field-group-handle    as handle    no-undo .
     2091     define variable v-object-handle         as handle    no-undo .
     2092     define variable v-frame-height          as decimal   no-undo .
     2093     define variable v-frame-virtual-height  as decimal   no-undo .
     2094     define variable v-browse-height         as decimal   no-undo .
     2095     define variable v-window-height         as decimal   no-undo .
     2096     define variable v-window-virtual-height as decimal   no-undo .
     2097     define variable v-change-sign           as integer   no-undo .
     2098     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2099     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2100     if p-change-value > 0
     2101     then do:
     2102       if frame d-disc :height + p-change-value
     2103           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2104       then do:
     2105         assign
     2106           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2107                           - (frame d-disc :height-chars)
     2108         .
     2109         if p-change-value <= 0
     2110         then do:
     2111           run diasize_position-resize-button in this-procedure .
     2112           return .
     2113         end.
     2114       end.
     2115     end.
     2116     if p-change-value < 0
     2117     then do:
     2118       if frame d-disc :height + p-change-value < v-diasize-orig-frame-height
     2119       then do:
     2120         assign
     2121           p-change-value = v-diasize-orig-frame-height
     2122                          - (frame d-disc :height-chars)
     2123         .
     2124         if p-change-value >= 0
     2125         then do:
     2126           run diasize_position-resize-button in this-procedure .
     2127           return .
     2128         end.
     2129       end.
     2130     end.
     2131     if p-change-value >= 0
     2132     then do:
     2133       assign
     2134         v-change-sign = 1
     2135       .
     2136     end.
     2137     else do:
     2138       assign
     2139         v-change-sign = -1
     2140       .
     2141     end.
     2142     assign
     2143       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2144     .
     2145     if p-change-value = 0
     2146     then do:
     2147       run diasize_position-resize-button in this-procedure .
     2148       return .
     2149     end.
     2150     move_block:
     2151     do
     2152     on error undo move_block, retry move_block
     2153     :
     2154       if retry
     2155       then do:
     2156         do
     2157         on error undo move_block, leave move_block
     2158         :
     2159           if p-change-value > 0
     2160           then do:
     2161             for each buf_temp-diasize-handle
     2162             on error undo, next
     2163             :
     2164               assign
     2165                 v-object-handle = buf_temp-diasize-handle.handle-value
     2166               .
     2167               if v-object-handle <> v-diasize-resize-button
     2168               then do:
     2169                 assign
     2170                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2171                 .
     2172               end.
     2173             end.
     2174             assign
     2175               v-diasize-browse-handle :height = v-browse-height
     2176             .
     2177             for each buf_temp-browse-handle
     2178               where buf_temp-browse-handle.browse-type = 'height':u
     2179             on error undo, next
     2180             :
     2181               assign
     2182                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2183               .
     2184             end.
     2185             assign
     2186               frame d-disc :height = v-frame-height
     2187             .
     2188             if frame d-disc :scrollable = true
     2189             then do:
     2190               assign
     2191                 frame d-disc :virtual-height = v-frame-virtual-height
     2192               .
     2193             end.
     2194             run diasize_position-resize-button in this-procedure .
     2195           end.
     2196           else do:
     2197             if frame d-disc :scrollable = true
     2198             then do:
     2199               assign
     2200                 frame d-disc :virtual-height = v-frame-virtual-height
     2201               .
     2202             end.
     2203             assign
     2204               frame d-disc :height = v-frame-height
     2205             .
     2206             assign
     2207               v-diasize-browse-handle :height = v-browse-height
     2208             .
     2209             for each buf_temp-browse-handle
     2210               where buf_temp-browse-handle.browse-type = 'height':u
     2211             on error undo, next
     2212             :
     2213               assign
     2214                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2215               .
     2216             end.
     2217             for each buf_temp-diasize-handle
     2218             on error undo, next
     2219             :
     2220               assign
     2221                 v-object-handle = buf_temp-diasize-handle.handle-value
     2222               .
     2223               if v-object-handle <> v-diasize-resize-button
     2224               then do:
     2225                 assign
     2226                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2227                 .
     2228               end.
     2229             end.
     2230             run diasize_position-resize-button in this-procedure .
     2231           end.
     2232           assign
     2233             v-diasize-change-size = false
     2234           .
     2235           leave move_block .
     2236         end.
     2237       end.
     2238       assign
     2239         v-diasize-need-full-display = true
     2240       .
     2241       if v-diasize-change-size = false
     2242       then do:
     2243         assign
     2244           v-diasize-change-size = true
     2245         .
     2246       end.
     2247       else do:
     2248         return .
     2249       end.
     2250       assign
     2251         v-frame-height = frame d-disc :height
     2252         v-frame-virtual-height = frame d-disc :virtual-height
     2253         v-browse-height = v-diasize-browse-handle :height
     2254       .
     2255       for each buf_temp-browse-handle
     2256         where buf_temp-browse-handle.browse-type = 'height':u
     2257       :
     2258         assign
     2259           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2260         .
     2261       end.
     2262       for each buf_temp-diasize-handle
     2263       :
     2264         delete buf_temp-diasize-handle .
     2265       end.
     2266       assign
     2267         v-field-group-handle = frame d-disc :first-child
     2268       .
     2269       do while valid-handle(v-field-group-handle)
     2270       :
     2271         assign
     2272           v-object-handle = v-field-group-handle :first-child
     2273         .
     2274         do while valid-handle(v-object-handle)
     2275         :
     2276           if  v-object-handle <> v-diasize-browse-handle :handle
     2277           and can-query(v-object-handle, "row")
     2278           and can-query(v-object-handle, "height")
     2279           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2280           then do:
     2281             find first buf_temp-browse-handle
     2282               where buf_temp-browse-handle.browse-type   = 'height':u
     2283                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2284               no-error .
     2285             if available buf_temp-browse-handle
     2286             then do:
     2287             end.
     2288             else do:
     2289               create buf_temp-diasize-handle .
     2290               assign
     2291                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2292                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2293               .
     2294             end.
     2295           end.
     2296           assign
     2297             v-object-handle = v-object-handle :next-sibling
     2298           .
     2299         end.
     2300         assign
     2301           v-field-group-handle = v-field-group-handle :next-sibling
     2302         .
     2303       end.
     2304       do with frame d-disc
     2305       :
     2306         hide v-diasize-resize-button .
     2307         assign
     2308           v-diasize-resize-button :row    = 1
     2309           v-diasize-resize-button :column = 1
     2310         .
     2311       end.
     2312       if p-change-value > 0
     2313       then do:
     2314         if frame d-disc :scrollable = true
     2315         then do:
     2316           assign
     2317             frame d-disc :virtual-height = frame d-disc :virtual-height + p-change-value
     2318             no-error .
     2319           if error-status :error
     2320           or error-status :get-message(1) <> ""
     2321           then do:
     2322             undo move_block, retry move_block .
     2323           end.
     2324         end.
     2325         assign
     2326           frame d-disc :height = frame d-disc :height + p-change-value
     2327           no-error .
     2328         if error-status :error
     2329         or error-status :get-message(1) <> ""
     2330         then do:
     2331           undo move_block, retry move_block .
     2332         end.
     2333         assign
     2334           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2335           no-error .
     2336         if error-status :error
     2337         or error-status :get-message(1) <> ""
     2338         then do:
     2339           undo move_block, retry move_block .
     2340         end.
     2341         for each buf_temp-browse-handle
     2342           where buf_temp-browse-handle.browse-type = 'height':u
     2343         on error undo move_block, retry move_block
     2344         :
     2345           assign
     2346             buf_temp-browse-handle.browse-handle :height
     2347               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2348             no-error .
     2349           if error-status :error
     2350           or error-status :get-message(1) <> ""
     2351           then do:
     2352             undo move_block, retry move_block .
     2353           end.
     2354         end.
     2355         for each buf_temp-diasize-handle
     2356         on error undo move_block, retry move_block
     2357         :
     2358           assign
     2359             v-object-handle = buf_temp-diasize-handle.handle-value
     2360           .
     2361           if v-object-handle <> v-diasize-resize-button
     2362           then do:
     2363             assign
     2364               v-object-handle :row = v-object-handle :row + p-change-value
     2365               no-error .
     2366             if error-status :error
     2367             or error-status :get-message(1) <> ""
     2368             then do:
     2369               undo move_block, retry move_block .
     2370             end.
     2371           end.
     2372         end.
     2373       end.
     2374       else do:
     2375         for each buf_temp-diasize-handle
     2376         on error undo move_block, retry move_block
     2377         :
     2378           assign
     2379             v-object-handle = buf_temp-diasize-handle.handle-value
     2380           .
     2381           if v-object-handle <> v-diasize-resize-button
     2382           then do:
     2383             assign
     2384               v-object-handle :row = v-object-handle :row + p-change-value
     2385               no-error .
     2386             if error-status :error
     2387             or error-status :get-message(1) <> ""
     2388             then do:
     2389               undo move_block, retry move_block .
     2390             end.
     2391           end.
     2392         end.
     2393         assign
     2394           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2395           no-error .
     2396         if error-status :error
     2397         or error-status :get-message(1) <> ""
     2398         then do:
     2399           undo move_block, retry move_block .
     2400         end.
     2401         for each buf_temp-browse-handle
     2402           where buf_temp-browse-handle.browse-type = 'height':u
     2403         on error undo move_block, retry move_block
     2404         :
     2405           assign
     2406             buf_temp-browse-handle.browse-handle :height
     2407               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2408             no-error .
     2409           if error-status :error
     2410           or error-status :get-message(1) <> ""
     2411           then do:
     2412             undo move_block, retry move_block .
     2413           end.
     2414         end.
     2415         assign
     2416           frame d-disc :height = frame d-disc :height + p-change-value
     2417           no-error .
     2418         if error-status :error
     2419         or error-status :get-message(1) <> ""
     2420         then do:
     2421           undo move_block, retry move_block .
     2422         end.
     2423         if frame d-disc :scrollable = true
     2424         then do:
     2425           assign
     2426             frame d-disc :virtual-height = frame d-disc :virtual-height + p-change-value
     2427             no-error .
     2428           if error-status :error
     2429           or error-status :get-message(1) <> ""
     2430           then do:
     2431             undo move_block, retry move_block .
     2432           end.
     2433         end.
     2434       end.
     2435       if p-move-resize = true
     2436       then do:
     2437         run diasize_position-resize-button in this-procedure .
     2438       end.
     2439       if v-diasize-wndstore = true
     2440       then do:
     2441         if connected("ub") = true
     2442         then do:
     2443           define variable v-cntxt-db-num        as integer   no-undo .
     2444           define variable v-cntxt-userid        as character no-undo .
     2445           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2446                                             , OUTPUT v-cntxt-userid
     2447                                             ) .
     2448           run gbl/wndsizew.p
     2449             (input  v-cntxt-db-num
     2450             ,input  v-cntxt-userid
     2451             ,input  v-diasize-proc-name
     2452             ,input  'height':u
     2453             ,input  string(frame d-disc :height - v-diasize-orig-frame-height)
     2454             ) .
     2455         end.
     2456       end.
     2457     end.
     2458     assign
     2459       v-diasize-change-size = false
     2460     .
     2461   end procedure.
     2462   procedure diasize_set-height :
     2463     define input  parameter p-new-height  as decimal   no-undo .
     2464     define input  parameter p-move-resize as logical   no-undo .
     2465     do
     2466     on error undo, return error return-value
     2467     :
     2468       run diasize_change-height in this-procedure
     2469         (input  (p-new-height - frame d-disc :height)
     2470         ,input  p-move-resize
     2471         ) .
     2472     end.
     2473   end procedure.
     2474   procedure diasize_change-width :
     2475     define input  parameter p-change-value as decimal   no-undo .
     2476     define input  parameter p-move-resize  as logical   no-undo .
     2477     define variable v-field-group-handle   as handle    no-undo .
     2478     define variable v-object-handle        as handle    no-undo .
     2479     define variable v-frame-width          as decimal   no-undo .
     2480     define variable v-frame-virtual-width  as decimal   no-undo .
     2481     define variable v-browse-width         as decimal   no-undo .
     2482     define variable v-window-width         as decimal   no-undo .
     2483     define variable v-window-virtual-width as decimal   no-undo .
     2484     define variable v-change-sign          as integer   no-undo .
     2485     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2486     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2487     if p-change-value > 0
     2488     then do:
     2489       if frame d-disc :width + p-change-value >
     2490           session :width-chars
     2491       then do:
     2492         assign
     2493           p-change-value = session :width-chars - frame d-disc :width
     2494         .
     2495         if p-change-value <= 0
     2496         then do:
     2497           run diasize_position-resize-button in this-procedure .
     2498           return .
     2499         end.
     2500       end.
     2501     end.
     2502     if p-change-value < 0
     2503     then do:
     2504       if frame d-disc :width + p-change-value < v-diasize-orig-frame-width
     2505       then do:
     2506         assign
     2507           p-change-value = v-diasize-orig-frame-width
     2508                          - frame d-disc :width
     2509         .
     2510         if p-change-value >= 0
     2511         then do:
     2512           run diasize_position-resize-button in this-procedure .
     2513           return .
     2514         end.
     2515       end.
     2516     end.
     2517     if p-change-value >= 0
     2518     then do:
     2519       assign
     2520         v-change-sign = 1
     2521       .
     2522     end.
     2523     else do:
     2524       assign
     2525         v-change-sign = -1
     2526       .
     2527     end.
     2528     assign
     2529       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2530     .
     2531     if p-change-value = 0
     2532     then do:
     2533       run diasize_position-resize-button in this-procedure .
     2534       return .
     2535     end.
     2536     move_block:
     2537     do
     2538     on error undo move_block, leave move_block
     2539     :
     2540       if retry
     2541       then do:
     2542         do
     2543         on error undo move_block, leave move_block
     2544         :
     2545           if p-change-value > 0
     2546           then do:
     2547             for each buf_temp-diasize-handle
     2548             on error undo, next
     2549             :
     2550               assign
     2551                 v-object-handle = buf_temp-diasize-handle.handle-value
     2552               .
     2553               if v-object-handle <> v-diasize-resize-button
     2554               then do:
     2555                 assign
     2556                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2557                 .
     2558               end.
     2559             end.
     2560             assign
     2561               v-diasize-browse-handle :width = v-browse-width
     2562             .
     2563             for each buf_temp-browse-handle
     2564               where buf_temp-browse-handle.browse-type = 'width':u
     2565             on error undo, next
     2566             :
     2567               assign
     2568                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2569               .
     2570             end.
     2571             assign
     2572               frame d-disc :width = v-frame-width
     2573             .
     2574             if frame d-disc :scrollable = true
     2575             then do:
     2576               assign
     2577                 frame d-disc :virtual-width = v-frame-virtual-width
     2578               .
     2579             end.
     2580             run diasize_position-resize-button in this-procedure .
     2581           end.
     2582           else do:
     2583             if frame d-disc :scrollable = true
     2584             then do:
     2585               assign
     2586                 frame d-disc :virtual-width = v-frame-virtual-width
     2587               .
     2588             end.
     2589             assign
     2590               frame d-disc :width = v-frame-width
     2591             .
     2592             for each buf_temp-browse-handle
     2593               where buf_temp-browse-handle.browse-type = 'width':u
     2594             on error undo, next
     2595             :
     2596               assign
     2597                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2598               .
     2599             end.
     2600             assign
     2601               v-diasize-browse-handle :width = v-browse-width
     2602             .
     2603             for each buf_temp-diasize-handle
     2604             on error undo, next
     2605             :
     2606               assign
     2607                 v-object-handle = buf_temp-diasize-handle.handle-value
     2608               .
     2609               if v-object-handle <> v-diasize-resize-button
     2610               then do:
     2611                 assign
     2612                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2613                 .
     2614               end.
     2615             end.
     2616             run diasize_position-resize-button in this-procedure .
     2617           end.
     2618           assign
     2619             v-diasize-change-size = false
     2620           .
     2621           leave move_block .
     2622         end.
     2623       end.
     2624       assign
     2625         v-diasize-need-full-display = true
     2626       .
     2627       if v-diasize-change-size = false
     2628       then do:
     2629         assign
     2630           v-diasize-change-size = true
     2631         .
     2632       end.
     2633       else do:
     2634         return .
     2635       end.
     2636       assign
     2637         v-frame-width = frame d-disc :width
     2638         v-frame-virtual-width = frame d-disc :virtual-width
     2639         v-browse-width = v-diasize-browse-handle :width
     2640       .
     2641       for each buf_temp-browse-handle
     2642         where buf_temp-browse-handle.browse-type = 'width':u
     2643       :
     2644         assign
     2645           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2646         .
     2647       end.
     2648       for each buf_temp-diasize-handle
     2649       :
     2650         delete buf_temp-diasize-handle .
     2651       end.
     2652       assign
     2653         v-field-group-handle = frame d-disc :first-child
     2654       .
     2655       do while valid-handle(v-field-group-handle)
     2656       :
     2657         assign
     2658           v-object-handle = v-field-group-handle :first-child
     2659         .
     2660         do while valid-handle(v-object-handle)
     2661         :
     2662           if  v-object-handle <> v-diasize-browse-handle :handle
     2663           and v-object-handle <> v-diasize-resize-button
     2664           and can-query(v-object-handle, "row")
     2665           and can-query(v-object-handle, "height")
     2666           and ( v-object-handle :col + v-object-handle :width
     2667                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2668               )
     2669           then do:
     2670             find first buf_temp-browse-handle
     2671               where buf_temp-browse-handle.browse-type   = 'width':u
     2672                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2673               no-error .
     2674             if available buf_temp-browse-handle
     2675             then do:
     2676             end.
     2677             else do:
     2678               create buf_temp-diasize-handle .
     2679               assign
     2680                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2681                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2682               .
     2683             end.
     2684           end.
     2685           assign
     2686             v-object-handle = v-object-handle :next-sibling
     2687           .
     2688         end.
     2689         assign
     2690           v-field-group-handle = v-field-group-handle :next-sibling
     2691         .
     2692       end.
     2693       do with frame d-disc
     2694       :
     2695         hide v-diasize-resize-button .
     2696         v-diasize-resize-button :row = 1.
     2697         v-diasize-resize-button :column = 1.
     2698       end.
     2699       if p-change-value > 0
     2700       then do:
     2701         if frame d-disc :scrollable = true
     2702         then do:
     2703           assign
     2704             frame d-disc :virtual-width = frame d-disc :virtual-width + p-change-value
     2705             no-error .
     2706           if error-status :error
     2707           or error-status :get-message(1) <> ""
     2708           then do:
     2709             undo move_block, retry move_block.
     2710           end.
     2711         end.
     2712         assign
     2713           frame d-disc :width = v-frame-width + p-change-value
     2714           no-error .
     2715         if error-status :error
     2716         or error-status :get-message(1) <> ""
     2717         then do:
     2718           undo move_block, retry move_block.
     2719         end.
     2720         assign
     2721           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2722         no-error .
     2723         if error-status :error
     2724         or error-status :get-message(1) <> ""
     2725         then do:
     2726           undo move_block, retry move_block.
     2727         end.
     2728         for each buf_temp-browse-handle
     2729           where buf_temp-browse-handle.browse-type = 'width':u
     2730         on error undo move_block, retry move_block
     2731         :
     2732           assign
     2733             buf_temp-browse-handle.browse-handle :width
     2734               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2735             no-error .
     2736           if error-status :error
     2737           or error-status :get-message(1) <> ""
     2738           then do:
     2739             undo move_block, retry move_block .
     2740           end.
     2741         end.
     2742         for each buf_temp-diasize-handle
     2743         on error undo move_block, retry move_block
     2744         :
     2745           assign
     2746             v-object-handle = buf_temp-diasize-handle.handle-value
     2747           .
     2748           if v-object-handle <> v-diasize-resize-button
     2749           then do:
     2750             assign
     2751               v-object-handle :col = v-object-handle :col + p-change-value
     2752               no-error .
     2753             if error-status :error
     2754             or error-status :get-message(1) <> ""
     2755             then do:
     2756               undo move_block, retry move_block .
     2757             end.
     2758           end.
     2759         end.
     2760       end.
     2761       else do:
     2762         for each buf_temp-diasize-handle
     2763         on error undo move_block, retry move_block
     2764         :
     2765           assign
     2766             v-object-handle = buf_temp-diasize-handle.handle-value
     2767           .
     2768           if v-object-handle <> v-diasize-resize-button
     2769           then do:
     2770             assign
     2771               v-object-handle :col = v-object-handle :col + p-change-value
     2772               no-error .
     2773             if error-status :error
     2774             or error-status :get-message(1) <> ""
     2775             then do:
     2776               undo move_block, retry move_block .
     2777             end.
     2778           end.
     2779         end.
     2780         for each buf_temp-browse-handle
     2781           where buf_temp-browse-handle.browse-type = 'width':u
     2782         on error undo move_block, retry move_block
     2783         :
     2784           assign
     2785             buf_temp-browse-handle.browse-handle :width
     2786               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2787             no-error .
     2788           if error-status :error
     2789           or error-status :get-message(1) <> ""
     2790           then do:
     2791             undo move_block, retry move_block .
     2792           end.
     2793         end.
     2794         assign
     2795           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2796           no-error .
     2797         if error-status :error
     2798         or error-status :get-message(1) <> ""
     2799         then do:
     2800           undo move_block, retry move_block.
     2801         end.
     2802         assign
     2803           frame d-disc :width = frame d-disc :width + p-change-value
     2804         no-error .
     2805         if error-status :error
     2806         or error-status :get-message(1) <> ""
     2807         then do:
     2808           undo move_block, retry move_block.
     2809         end.
     2810         if frame d-disc :scrollable = true
     2811         then do:
     2812           assign
     2813             frame d-disc :virtual-width = frame d-disc :virtual-width + p-change-value
     2814           no-error .
     2815           if error-status :error
     2816           or error-status :get-message(1) <> ""
     2817           then do:
     2818             undo move_block, retry move_block.
     2819           end.
     2820         end.
     2821       end.
     2822       if p-move-resize
     2823       then do:
     2824         run diasize_position-resize-button in this-procedure .
     2825       end.
     2826       if v-diasize-wndstore = true
     2827       then do:
     2828         if connected("ub") = true
     2829         then do:
     2830           define variable v-cntxt-db-num        as integer   no-undo .
     2831           define variable v-cntxt-userid        as character no-undo .
     2832           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2833                                             , OUTPUT v-cntxt-userid
     2834                                             ) .
     2835           run gbl/wndsizew.p
     2836             (input  v-cntxt-db-num
     2837             ,input  v-cntxt-userid
     2838             ,input  v-diasize-proc-name
     2839             ,input  'width':u
     2840             ,input  string(frame d-disc :width - v-diasize-orig-frame-width)
     2841             ) .
     2842         end.
     2843       end.
     2844     end.
     2845     assign
     2846       v-diasize-change-size = false
     2847     .
     2848   end procedure.
     2849   procedure diasize_set-width :
     2850     define input  parameter p-new-width  as decimal   no-undo .
     2851     define input  parameter p-move-resize as logical   no-undo .
     2852     do
     2853     on error undo, return error return-value
     2854     :
     2855       run diasize_change-width in this-procedure
     2856         (input  (p-new-width - frame d-disc :width)
     2857         ,input  p-move-resize
     2858         ) .
     2859     end.
     2860   end procedure.
     2861   procedure diasize_position-resize-button :
     2862     do with frame d-disc
     2863     :
     2864       hide v-diasize-resize-button .
     2865       assign
     2866         v-diasize-resize-button :row = frame d-disc :height - v-diasize-resize-button :height
     2867                     - 1
     2868                     - (frame d-disc :border-bottom-pixels / session :pixels-per-row)
     2869         v-diasize-resize-button :col = frame d-disc :width - v-diasize-resize-button :width
     2870                     - 1
     2871                     - (frame d-disc :border-right-pixels / session :pixels-per-column)
     2872       .
     2873       view v-diasize-resize-button .
     2874     end.
     2875   end procedure.
     2876   on alt-right anywhere
     2877   do:
     2878     run diasize_change-width in this-procedure
     2879       (input 1
     2880       ,input true
     2881       ) .
     2882     return no-apply .
     2883   end.
     2884   on alt-left anywhere
     2885   do:
     2886     run diasize_change-width in this-procedure
     2887       (input -1
     2888       ,input true
     2889       ) .
     2890     return no-apply .
     2891   end.
     2892   on alt-down anywhere
     2893   do:
     2894     run diasize_change-height in this-procedure
     2895       (input 1
     2896       ,input true
     2897       ) .
     2898     return no-apply .
     2899   end.
     2900   on alt-up anywhere
     2901   do:
     2902     run diasize_change-height in this-procedure
     2903       (input -1
     2904       ,input true
     2905       ) .
     2906     return no-apply .
     2907   end.
     2908   on alt-enter of frame d-disc
     2909   do:
     2910     run diasize_maximize in this-procedure
     2911       (input  ?
     2912       ).
     2913     return no-apply .
     2914   end.
     2915   procedure diasize_end-move :
     2916     do
     2917     on error undo, return error return-value
     2918     :
     2919       define variable v-row-delta as decimal   no-undo .
     2920       define variable v-col-delta as decimal   no-undo .
     2921       define variable v-new-row as decimal   no-undo .
     2922       define variable v-new-col as decimal   no-undo .
     2923       assign
     2924         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2925         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2926       .
     2927       assign
     2928         v-row-delta = v-new-row - frame d-disc :height
     2929         v-col-delta = v-new-col - frame d-disc :width
     2930       .
     2931       run diasize_change-height in this-procedure
     2932         (input v-row-delta
     2933         ,input true
     2934         ) .
     2935       run diasize_change-width in this-procedure
     2936         (input v-col-delta
     2937         ,input true
     2938         ) .
     2939     end.
     2940   end procedure.
     2941   procedure diasize_maximize :
     2942     define input  parameter p-action as logical   no-undo .
     2943     do
     2944     on error undo, return error return-value
     2945     :
     2946       if p-action = ?
     2947       then do:
     2948         if v-diasize-need-maximize = true
     2949         then do:
     2950           assign
     2951             p-action = true
     2952           .
     2953         end.
     2954         else do:
     2955           assign
     2956             p-action = false
     2957           .
     2958         end.
     2959       end.
     2960       if p-action = true
     2961       then do:
     2962         run diasize_change-height in this-procedure
     2963           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2964               - frame d-disc :height-chars
     2965           ,input true
     2966           ) .
     2967         run diasize_change-width in this-procedure
     2968           (input session :width-chars
     2969               - frame d-disc :width-chars
     2970           ,input true
     2971           ) .
     2972         assign
     2973           v-diasize-need-maximize = false
     2974         .
     2975       end.
     2976       else do:
     2977         run diasize_change-width in this-procedure
     2978           (input v-diasize-orig-frame-width
     2979               - frame d-disc :width-chars
     2980           ,input true
     2981           ) .
     2982         run diasize_change-height in this-procedure
     2983           (input v-diasize-orig-frame-height
     2984               - frame d-disc :height-chars
     2985           ,input true
     2986           ) .
     2987         assign
     2988           v-diasize-need-maximize = true
     2989         .
     2990       end.
     2991     end.
     2992   end procedure.
     2993   procedure diasize_restore-orig-size :
     2994     do
     2995     on error undo, return error return-value
     2996     :
     2997       assign
     2998         v-diasize-current-frame-width  = frame d-disc :width
     2999         v-diasize-current-frame-height = frame d-disc :height
     3000       .
     3001       run diasize_set-height in this-procedure
     3002         (input  v-diasize-orig-frame-height
     3003         ,input  true
     3004         ) .
     3005       run diasize_set-width in this-procedure
     3006         (input  v-diasize-orig-frame-width
     3007         ,input  true
     3008         ) .
     3009     end.
     3010   end procedure.
     3011   procedure diasize_restore-current-size :
     3012     do
     3013     on error undo, return error return-value
     3014     :
     3015       run diasize_set-height in this-procedure
     3016         (input  v-diasize-current-frame-height
     3017         ,input  true
     3018         ) .
     3019       run diasize_set-width in this-procedure
     3020         (input  v-diasize-current-frame-width
     3021         ,input  true
     3022         ) .
     3023     end.
     3024   end procedure.
     3025   procedure diasize_set-browse-handle :
     3026     define input  parameter p-browse-handle as handle   no-undo .
     3027     define buffer buf_temp-browse-handle for temp-browse-handle .
     3028     do
     3029     on error undo, return error return-value
     3030     :
     3031       assign
     3032         v-diasize-browse-handle = p-browse-handle
     3033       .
     3034       for each buf_temp-browse-handle
     3035       on error undo, return error return-value
     3036       :
     3037         delete buf_temp-browse-handle .
     3038       end.
     3039     end.
     3040   end procedure.
     3041   procedure diasize_add_browse :
     3042     define input  parameter p-browse-type   as character no-undo .
     3043     define input  parameter p-browse-handle as handle    no-undo .
     3044     define buffer buf_temp-browse-handle for temp-browse-handle .
     3045     do
     3046     on error undo, return error return-value
     3047     :
     3048       assign
     3049         v-diasize-browse-number = v-diasize-browse-number + 1
     3050       .
     3051       create buf_temp-browse-handle .
     3052       assign
     3053         buf_temp-browse-handle.browse-type   = p-browse-type
     3054         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3055         buf_temp-browse-handle.browse-handle = p-browse-handle
     3056       .
     3057     end.
     3058   end procedure.
     3059   procedure diasize_init :
     3060     define variable v-default-value    as logical   no-undo .
     3061     define variable v-restore-saved    as logical   no-undo .
     3062     define variable v-resize-value-str as character no-undo .
     3063     do
     3064     on error undo, return error return-value
     3065     :
     3066       do with frame d-disc
     3067       :
     3068         assign
     3069           v-diasize-orig-frame-height = frame d-disc :height
     3070           v-diasize-orig-frame-width  = frame d-disc :width
     3071           v-diasize-browse-handle     = browse BR-dis-host-b :handle
     3072         .
     3073         create button v-diasize-resize-button
     3074         assign
     3075           parent        = frame d-disc :first-child
     3076           label         = "s"
     3077           height-pixels = 16
     3078           width-pixels  = 16
     3079           visible       = true
     3080           sensitive     = true
     3081           movable       = true
     3082           triggers:
     3083             on end-move persistent run diasize_end-move in this-procedure .
     3084           end triggers.
     3085         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3086         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3087         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3088         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3089         assign
     3090           v-diasize-wndmax = false
     3091         .
     3092         if connected("ub") = true
     3093         then do:
     3094           define variable v-cntxt-db-num        as integer   no-undo .
     3095           define variable v-cntxt-userid        as character no-undo .
     3096           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3097                                             , OUTPUT v-cntxt-userid
     3098                                             ) .
     3099           run gbl/wndpar_r.p
     3100             (input  v-cntxt-db-num
     3101             ,input  v-cntxt-userid
     3102             ,input  'wndmax':U
     3103             ,output v-diasize-wndmax
     3104             ,output v-default-value
     3105             ) .
     3106         end.
     3107         assign
     3108           v-diasize-wndstore = false
     3109         .
     3110         if connected("ub") = true
     3111         then do:
     3112           run gbl/wndpar_r.p
     3113             (input  v-cntxt-db-num
     3114             ,input  v-cntxt-userid
     3115             ,input  'wndstore':U
     3116             ,output v-diasize-wndstore
     3117             ,output v-default-value
     3118             ) .
     3119         end.
     3120         assign
     3121           v-diasize-proc-name = entry(1, program-name(2), '.')
     3122         .
     3123         if v-diasize-wndstore = true
     3124         then do:
     3125           assign
     3126             v-restore-saved = false
     3127           .
     3128           if connected("ub") = true
     3129           then do:
     3130             run gbl/wndsizer.p
     3131               (input  v-cntxt-db-num
     3132               ,input  v-cntxt-userid
     3133               ,input  v-diasize-proc-name
     3134               ,input  'height':u
     3135               ,output v-resize-value-str
     3136               ) .
     3137             if v-resize-value-str <> '':U
     3138             then do:
     3139               run diasize_change-height in this-procedure
     3140                 (input  integer(v-resize-value-str)
     3141                 ,input  true
     3142                 ) .
     3143               assign
     3144                 v-restore-saved = true
     3145               .
     3146             end.
     3147           end.
     3148           if connected("ub") = true
     3149           then do:
     3150             run gbl/wndsizer.p
     3151               (input  v-cntxt-db-num
     3152               ,input  v-cntxt-userid
     3153               ,input  v-diasize-proc-name
     3154               ,input  'width':u
     3155               ,output v-resize-value-str
     3156               ) .
     3157             if v-resize-value-str <> '':U
     3158             then do:
     3159               run diasize_change-width in this-procedure
     3160                 (input  integer(v-resize-value-str)
     3161                 ,input  true
     3162                 ) .
     3163               assign
     3164                 v-restore-saved = true
     3165               .
     3166             end.
     3167           end.
     3168           if v-restore-saved <> true
     3169           then do:
     3170             if v-diasize-wndmax = true
     3171             then do:
     3172               run diasize_maximize in this-procedure
     3173                 (input  true
     3174                 ) .
     3175             end.
     3176           end.
     3177         end.
     3178         else do:
     3179           if v-diasize-wndmax = true
     3180           then do:
     3181             run diasize_maximize in this-procedure
     3182               (input  true
     3183               ) .
     3184           end.
     3185         end.
     3186       end.
     3187     end.
     3188   end procedure.
     3189   procedure diasize_need-full-display :
     3190     define output parameter p-need-full-display as logical   no-undo .
     3191     do
     3192     on error undo, return error return-value
     3193     :
     3194       assign
     3195         p-need-full-display = v-diasize-need-full-display
     3196       .
     3197       assign
     3198         v-diasize-need-full-display = false
     3199       .
     3200     end.
     3201   end procedure.
     3202   procedure get-context :
     3203      define output parameter p-db-num as integer          no-undo.
     3204      define output parameter p-user-id as character        no-undo.
     3205      define variable v-login               as character    no-undo.
     3206      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3207      define buffer buf_user-login  for ub.user-login .
     3208      do
     3209      on error undo, return error
     3210      :
     3211            FIND FIRST buf_sys-ctrl no-lock.
     3212            ASSIGN
     3213               v-login = USERID("ub")
     3214               p-db-num = buf_sys-ctrl.db-num
     3215            .
     3216            FIND FIRST buf_user-login
     3217                 WHERE buf_user-login.db-num = p-db-num
     3218                   AND buf_user-login.user-login = v-login
     3219                 no-lock
     3220                 no-error
     3221                 .
     3222            IF AVAILABLE buf_user-login
     3223            THEN DO:
     3224               assign
     3225                  p-user-id = buf_user-login.user-id
     3226               .
     3227            END.
     3228      end.
     3229   end procedure.
     3230   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3231   do:
