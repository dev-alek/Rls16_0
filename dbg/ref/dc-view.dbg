     3238   def var re-queryBR-dis-obj-b     as logical   initial no no-undo .
     3239   on start-search, ctrl-o of BR-dis-obj-b in frame d-disc do:
     3240      run sort-brBR-dis-obj-b
     3241        (input (if available tt-dis-card
     3242                then recid(tt-dis-card)
     3243                else ?
     3244               )
     3245        ).
     3246   end.
     3247   PROCEDURE sort-brBR-dis-obj-b :
     3248     define input parameter p-recid as recid no-undo .
     3249     if re-queryBR-dis-obj-b = no then do:
     3250       assign
     3251          cur-clmnBR-dis-obj-b = BR-dis-obj-b:current-column in frame d-disc
     3252       .
     3253       if sort-clmnBR-dis-obj-b <> ? then sort-clmnBR-dis-obj-b:column-fgcolor = 0.
     3254       if cur-clmnBR-dis-obj-b = sort-clmnBR-dis-obj-b then do:
     3255         assign
     3256            sort-labelBR-dis-obj-b = ""
     3257            sort-clmnBR-dis-obj-b = ?
     3258         .
     3259        end.
     3260        else do:
     3261          assign
     3262            sort-labelBR-dis-obj-b = cur-clmnBR-dis-obj-b:label
     3263            sort-clmnBR-dis-obj-b  = cur-clmnBR-dis-obj-b
     3264            sort-clmnBR-dis-obj-b:column-fgcolor = 4
     3265          .
     3266        end.
     3267      end.
     3268     assign
     3269       cur-clmn-locBR-dis-obj-b = 1
     3270     .
     3271     def var column-handle as handle no-undo .
     3272     column-handle = BR-dis-obj-b:first-column.
     3273     do while valid-handle(column-handle) :
     3274       if column-handle = cur-clmnBR-dis-obj-b then do:
     3275         leave .
     3276       end.
     3277       column-handle = column-handle:NEXT-COLUMN.
     3278       assign
     3279         cur-clmn-locBR-dis-obj-b = cur-clmn-locBR-dis-obj-b + 1
     3280       .
     3281     end.
     3282     case sort-labelBR-dis-obj-b:
     3283           when ub.dis-obj.obj-code:label in browse BR-dis-obj-b then DO:   assign     sort-column-name = "ub.dis-obj.obj-code"   .   run OpenBr in this-procedure ( input t-legacy, input t-subsid, input selectcurr, input rs-gen-private, input rs-host-obj).   . END.
     3284           when ub.dis-obj.d-card:label in browse BR-dis-obj-b then DO:   assign     sort-column-name = "ub.dis-obj.d-card"   .   run OpenBr in this-procedure ( input t-legacy, input t-subsid, input selectcurr, input rs-gen-private, input rs-host-obj).   . END.
     3285           when vob:label in browse BR-dis-obj-b then DO:   assign     sort-column-name = "vob"   .   run OpenBr in this-procedure ( input t-legacy, input t-subsid, input selectcurr, input rs-gen-private, input rs-host-obj).   . END.
     3286       otherwise do:
     3287         assign
     3288           sort-column-name = ""
     3289         .
     3290         run OpenBr in this-procedure ( input t-legacy, input t-subsid, input selectcurr, input rs-gen-private, input rs-host-obj).
     3291           if can-do( this-procedure:internal-entries, 'mv-brw-defaultBR-dis-obj-b') then do:
     3292             run mv-brw-defaultBR-dis-obj-b.
     3293           end.
     3294         if sort-labelBR-dis-obj-b <> "" then do:
     3295           assign
     3296             cur-clmnBR-dis-obj-b:column-fgcolor = 0
     3297           .
     3298         end.
     3299         assign
     3300           cur-clmn-locBR-dis-obj-b = ?
     3301         .
     3302       end.
     3303     end case.
     3304       if cur-clmn-locBR-dis-obj-b <> ? then do:
     3305         if can-do( this-procedure:internal-entries, 'ch-clmnBR-dis-obj-b') then do:
     3306           run ch-clmnBR-dis-obj-b in this-procedure (cur-clmn-locBR-dis-obj-b).
     3307         end.
     3308       end.
     3309     if p-recid <> ? then do:
     3310       reposition BR-dis-obj-b to recid p-recid no-error.
     3311       apply "value-changed" to BR-dis-obj-b in frame d-disc.
     3312     end.
     3313     apply "entry" to BR-dis-obj-b in frame d-disc.
     3314   END PROCEDURE.
