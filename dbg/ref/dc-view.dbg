     1422        "Лимит кредита" VIEW-AS TEXT
     1423             SIZE 15.5 BY .83 AT ROW 18.93 COL 2.8
     1424             BGCOLOR 8 FGCOLOR 1
     1425        "Cумма к оплате" VIEW-AS TEXT
     1426             SIZE 15.5 BY 1 AT ROW 17.63 COL 40.4
     1427             BGCOLOR 8 FGCOLOR 1
     1428        "Сумма скидок" VIEW-AS TEXT
     1429             SIZE 13.3 BY 1 AT ROW 14.07 COL 2.9
     1430             BGCOLOR 8 FGCOLOR 1
     1431        "Cумма в кредит" VIEW-AS TEXT
     1432             SIZE 15.5 BY 1 AT ROW 17.63 COL 2.8
     1433             BGCOLOR 8 FGCOLOR 1
     1434        "Сумма оплат" VIEW-AS TEXT
     1435             SIZE 13.3 BY 1 AT ROW 16.53 COL 2.9
     1436             BGCOLOR 8 FGCOLOR 1
     1437        "Остаток лимита" VIEW-AS TEXT
     1438             SIZE 15.5 BY .83 AT ROW 18.93 COL 40.4
     1439             BGCOLOR 8 FGCOLOR 1
     1440        "Баланс карты" VIEW-AS TEXT
     1441             SIZE 15.5 BY 1 AT ROW 16.33 COL 40.4
     1442             BGCOLOR 8 FGCOLOR 1
     1443        "Сумма покупок" VIEW-AS TEXT
     1444             SIZE 13.3 BY 1 AT ROW 12.93 COL 2.8
     1445             BGCOLOR 8 FGCOLOR 1
     1446        "Сумма нетто" VIEW-AS TEXT
     1447             SIZE 13.3 BY 1 AT ROW 15.27 COL 2.8
     1448             BGCOLOR 8 FGCOLOR 1
     1449        RECT-1 AT ROW 12.53 COL 1.4
     1450        SPACE(0.33) SKIP(0.25)
     1451       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1452            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1453            BGCOLOR 8 FGCOLOR 0
     1454            TITLE "Архивы по магазинам текущей фирмы"
     1455            DEFAULT-BUTTON Btn_Cancel CANCEL-BUTTON Btn_Cancel.
     1456   ASSIGN
     1457          FRAME d-disc:SCROLLABLE       = FALSE
     1458          FRAME d-disc:HIDDEN           = TRUE.
