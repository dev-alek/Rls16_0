     3652   PROCEDURE re-move-clmnbr-dis-obj-b:
     3653     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3654     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3655     DO varmvibr-dis-obj-b = 1 TO EXTENT(cur-clmn-numbr-dis-obj-b):
     3656       if cur-clmn-numbr-dis-obj-b[varmvibr-dis-obj-b] = source-column THEN cur-clmn-numbr-dis-obj-b[varmvibr-dis-obj-b] = -1.
     3657     END.
     3658     if br-dis-obj-b:MOVE-COLUMN(source-column, target-column) IN FRAME d-disc then.
     3659     if source-column > target-column THEN
     3660     DO varmvjbr-dis-obj-b = source-column - 1 to target-column BY -1:
     3661       DO varmvibr-dis-obj-b = 1 TO EXTENT(cur-clmn-numbr-dis-obj-b):
     3662           if cur-clmn-numbr-dis-obj-b[varmvibr-dis-obj-b] = varmvjbr-dis-obj-b THEN DO:
     3663             cur-clmn-numbr-dis-obj-b[varmvibr-dis-obj-b] = cur-clmn-numbr-dis-obj-b[varmvibr-dis-obj-b] + 1.
     3664           END.
     3665       END.
     3666     END.
     3667     ELSE
     3668     DO varmvjbr-dis-obj-b = source-column + 1 to target-column:
     3669       DO varmvibr-dis-obj-b = 1 TO EXTENT(cur-clmn-numbr-dis-obj-b):
     3670         if cur-clmn-numbr-dis-obj-b[varmvibr-dis-obj-b] = varmvjbr-dis-obj-b THEN DO:
     3671           cur-clmn-numbr-dis-obj-b[varmvibr-dis-obj-b] = cur-clmn-numbr-dis-obj-b[varmvibr-dis-obj-b] - 1.
     3672         END.
     3673       END.
     3674     END.
     3675     DO varmvibr-dis-obj-b = 1 TO EXTENT(cur-clmn-numbr-dis-obj-b):
     3676       if cur-clmn-numbr-dis-obj-b[varmvibr-dis-obj-b] = -1 THEN cur-clmn-numbr-dis-obj-b[varmvibr-dis-obj-b] = target-column.
     3677     END.
     3678   END PROCEDURE.
