      583     v-waitfram-action03 format "x(72)" no-label skip
      584     B-viewProcInfo
      585     B-WaitFramStop at row 4 col 30
      586     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      587     .
      588   define new global shared variable mBatchMode as logical no-undo init ?.
      589   define variable mFramBachModHandle as handle no-undo.
      590   mFramBachModHandle = frame waitfram:handle.
      591   define variable mFameOldVis as logical no-undo.
      592   define variable mVisCUrentVin as logical no-undo.
      593   if session:batch-mode
      594   then
      595      mBatchMode = yes.
      596   if mBatchMode = ? then do:
      597     mVisCUrentVin = current-window:visible.
      598     mFameOldVis = mFramBachModHandle:visible.
      599     mFramBachModHandle:visible  = yes.
      600     mBatchMode = mFramBachModHandle:visible ne yes.
      601     mFramBachModHandle:visible = mFameOldVis.
      602     current-window:visible = mVisCUrentVin.
      603   end.
      604    if  log-manager:logfile-name ne ?
      605     then DO:
      606         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      607         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      608         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      609     end.
      610   on choose of B-WaitFramStop in frame waitfram
      611   do:
      612     mWaitFramStop = yes.
      613     mWaitFramStopUser = yes.
      614   end.
      615   function waitfram-check-timeout returns logical():
      616      define variable vtime as int64 no-undo.
      617      if mWaitFramStopTimeOut
      618      then
      619         return yes.
      620      vtime = ( now - mWaitFramStartProc ) / 1000 .
      621      if     mWaitFramTimeOut ne ?
      622         and mWaitFramTimeOut ne 0
      623         and mWaitFramTimeOut lt vtime
      624      then do:
      625         mWaitFramStopTimeOut = yes.
      626      end.
      627      return mWaitFramStopTimeOut.
      628   end.
      629   procedure waitfram-hide :
      630     if not session:batch-mode
      631     then do
      632     on error undo, return error return-value
      633     :
      634       pause 0 before-hide .
      635       if not mBatchMode then
      636         hide frame waitfram .
      637     if     not mWaitFramView
      638        and mWaitProcEvent
      639     then
      640       process events .
      641     end.
      642   end procedure.
      643   procedure waitfram-show :
      644     define input  parameter p-message as character no-undo .
      645     define variable v-left-margin as integer   no-undo .
      646     if not session:batch-mode
      647     then do
      648     on error undo, return error return-value
      649     :
      650       if length(p-message) <= 70 then do:
      651         assign
      652           v-left-margin = integer((70 - length(p-message)) / 2)
      653         .
      654         assign
      655           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      656         .
      657         assign
      658           v-waitfram-action01 = " "
      659           v-waitfram-action02 = " "
      660                                    + fill(" ", v-left-margin)
      661                                    + p-message
      662           v-waitfram-action03 = " "
      663         .
      664       end.
      665       else do:
      666         define variable vRindex1 as integer no-undo.
      667         define variable vRindex2 as integer no-undo.
      668         vRindex1 = r-index(p-message," ",70).
      669         if vRindex1 = 0
      670         then
      671            vRindex1 = 70.
      672         if length(p-message)  <= vRindex1 + 70 then do:
      673           assign
      674             v-waitfram-action01 = " "
      675             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      676             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      677           .
      678         end.
      679         else do:
      680           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      681           if vRindex2 <= vRindex1
      682           then
      683              vRindex2 = vRindex1 + 70.
      684           assign
      685             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      686             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      687             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      688           .
      689         end.
      690       end.
      691       B-viewProcInfo:visible   in frame waitfram = no.
      692       B-viewProcInfo:sensitive in frame waitfram = no.
      693       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      694       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      695       if  (   mWaitFramView
      696          or  mWaitProcEvent)
      697          and not mBatchMode
      698       then
      699          display
      700             v-waitfram-action01 skip
      701             v-waitfram-action02 skip
      702             v-waitfram-action03 skip
      703          with frame waitfram .
      704       if     mWaitFramView
      705          then do:
      706             if     mWaitFramInterval ne ?
      707                and not mBatchMode
      708             then
      709                wait-for go of frame waitfram pause mWaitFramInterval.
      710          end.
      711          else
      712             if     mWaitProcEvent
      713                and not mBatchMode
      714             then
      715                process events .
      716     end.
      717   end procedure.
      718      procedure waitfram-show-this:
      719         define input  parameter iInterval as int64 no-undo.
      720         define variable vtime as int64 no-undo.
      721         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      722         mWaitFramInterval = iInterval.
      723         run waitfram-show (substitute("&1&2 &3&4" ,
      724                                       mWaitFramTextBeg ,
      725                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      726                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      727                                       mWaitFramTextEnd
      728                                      )
      729                           ).
      730      end.
      731      procedure WaitFramRunPause:
      732         define input  parameter iInterval as dec no-undo.
      733         define variable vStart  as datetime-tz no-undo.
      734         define variable vend    as datetime-tz no-undo.
      735         define variable vint as int64 no-undo.
      736         define variable vOk as logical no-undo.
      737         vStart = now.
      738         vend   = vStart.
      739         publish "WaitFramPause" (iInterval,output vOk).
      740         vend   =  now.
      741         vint = vend - vStart.
      742         vint = iInterval - vint / 1000.
      743         if     not mWaitFramStop
      744            and (   vint > 0
      745                 or (    not vOk
      746                     and iInterval eq ?
      747                     )
      748                 )
      749         then
      750            run waitfram-show-this (iInterval).
      751         vend   =  now.
      752         vint = vend - vStart.
      753         vint = iInterval - vint / 1000.
      754         if     not mWaitFramStop
      755            and vint > 0
      756         then do:
      757            run gbl/pause.p (vint * 1000).
      758         end.
      759         if iInterval ne ?
      760         then
      761            publish "WaitFramStop".
      762         waitfram-check-timeout().
      763      end.
      764      procedure WaitFramWaitFor:
      765         define input  parameter iInterval as dec no-undo.
      766         assign
      767            mWaitFramStartProc   = now
      768            mWaitFramStopUser    = no
      769            mWaitFramStopTimeOut = no
      770         .
      771         block-wait:
      772         do while not mWaitFramStop:
      773            run WaitFramRunPause (iInterval).
      774            if  waitfram-check-timeout()
      775            then do:
      776               leave block-wait.
      777            end.
      778         end.
      779         run waitfram-hide.
      780      end.
      781   procedure waitfram-join :
      782     define input  parameter p-line-1  as character no-undo .
      783     define input  parameter p-line-2  as character no-undo .
      784     define input  parameter p-line-3  as character no-undo .
      785     define output parameter p-message as character no-undo .
      786     do
      787     on error undo, return error return-value
      788     :
      789       assign
      790         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      791                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      792                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      793       .
      794     end.
      795   end procedure.
      796   function waitfram-join-function returns character
      797     (input p-line-1 as character
      798     ,input p-line-2 as character
      799     ,input p-line-3 as character
      800     ).
      801     define variable v-message as character no-undo .
      802     run waitfram-join in this-procedure
      803       (input  p-line-1
      804       ,input  p-line-2
      805       ,input  p-line-3
      806       ,output v-message
      807       ) .
      808     return v-message .
      809   end function .
      810   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      811   define  stream PrnLibStream.
      812   procedure prn-lib-prn-file :
      813     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      814     define input parameter p-DIsabledoptions as integer no-undo .
      815     define variable v-report-name as character no-undo .
      816     define variable v-user-action as character no-undo .
      817     define variable v-printed     as logical   no-undo .
      818     define variable v-exist       as logical   no-undo .
      819     do
      820       on error undo, return error
      821       :
      822       run prn-lib-get-report-name  in this-procedure (
      823         input parParentProc
      824         ,output v-report-name
      825         ).
      826   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      827   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      828     (input  v-report-name
      829     ,input  2
      830     ,output v-exist
      831     )  .
      832       if NOT v-exist then
      833       DO:
      834         Message
      835           "Нет заданий на печать ! "
      836           view-as alert-box .
      837         Return  .
      838       End.
      839       run gbl/prnfilen.w
      840         (input  ""
      841         ,input  p-DisabledOptions
      842         ,input  string(v-report-name )
      843         ,input  7
      844         ,output v-user-action
      845         ,output v-printed
      846         ) .
      847       if v-printed then
      848       do:
      849         return "YES" .
      850       end.
      851       else
      852       do:
      853         return "NO" .
      854       end.
      855     end.
      856   end procedure.
      857   procedure prn-lib-open-stream :
      858     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      859     define input parameter p-page-size    as integer no-undo .
      860     define input parameter p-is-stream    as logical no-undo .
      861     define input parameter p-append       as logical no-undo .
      862     define variable v-report-name as character no-undo .
      863     do
      864       on error undo, return error
      865       :
      866       run prn-lib-get-report-name  in this-procedure (
      867         input parParentProc
      868         ,output v-report-name
      869         ).
      870       if p-is-stream then
      871       do:
      872         if p-append then
      873         do:
      874           output stream PrnLibStream to value( v-report-name )
      875             page-size value(p-page-size) append .
      876         end.
      877         if not p-append then
      878         do:
      879           output stream PrnLibStream to value( v-report-name )
      880             page-size value(p-page-size) .
      881         end.
      882       end.
      883       if not p-is-stream then
      884       do:
      885         if p-append then
      886         do:
      887           output to value( v-report-name )
      888             page-size value(p-page-size) append .
      889         end.
      890         if not p-append then
      891         do:
      892           output to value( v-report-name )
      893             page-size value(p-page-size) .
      894         end.
      895       end.
      896     end.
      897   end procedure.
      898   procedure prn-lib-open-exp :
      899     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      900     define input parameter p-is-stream    as logical no-undo .
      901     define input parameter p-is-append    as logical no-undo .
      902     define output parameter p-ReportFileName as char init "report" no-undo.
      903     define output parameter p-process as logical no-undo .
      904     define variable glog as logical no-undo .
      905     do
      906       on error undo, return error
      907       :
      908       SYSTEM-DIALOG GET-FILE p-ReportFileName
      909         TITLE      "Укажите путь"
      910         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      911         ASK-OVERWRITE
      912         CREATE-TEST-FILE
      913         SAVE-AS
      914         USE-FILENAME
      915         DEFAULT-EXTENSION "txt"
      916         UPDATE glog
      917         .
      918       if not glog then  return.
      919       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      920       if p-is-stream then
      921       do:
      922         if p-is-append then
      923         do:
      924           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      925         end.
      926         else
      927         do:
      928           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      929         end.
      930       end.
      931       else
      932       do:
      933         if p-is-append then
      934         do:
      935           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      936         end.
      937         else
      938         do:
      939           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      940         end.
      941       end.
      942       p-process = yes.
      943     end.
      944   end procedure.
      945   procedure prn-lib-get-report-name :
      946     define input parameter parParentProc  as widget-handle no-undo.
      947     define output parameter p-report-name as character no-undo .
      948     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      949   end procedure.
      950   procedure prn-lib-reportviewer-report-name :
      951     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      952     define input parameter p-report-name-html as character no-undo .
      953     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      954   end procedure.
      955   procedure prn-lib-reportviewer :
      956     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      957     define input parameter p-report-name-html as character no-undo .
      958     define input parameter p-param        as character no-undo .
      959     define variable v-excel           as character no-undo init 'TRUE' .
      960     define variable v-value-character as character no-undo .
      961     define variable v-value-integer   as character no-undo .
      962     define variable v-value-date      as date      no-undo .
      963     define variable v-value-decimal   as decimal   no-undo .
      964     define variable rep-excel         as logical   no-undo .
      965     define variable excel-string      as character no-undo .
      966     define variable v-param-type      as character no-undo .
      967     define variable v-tth             as handle    no-undo .
      968     run adm/shattri.p (
      969       input "get":U
      970       ,input  ""
      971       ,input  0
      972       ,input  'report-glob':U
      973       ,input  'rep-excel':U
      974       ,output v-value-character
      975       ,output v-value-date
      976       ,output v-value-decimal
      977       ,output v-value-integer
      978       ,output rep-excel
      979       ,output v-param-type
      980       ,INPUT-OUTPUT table-handle v-tth
      981       )  .
      982     if rep-excel then v-excel = "TRUE" .
      983     else v-excel = "FALSE" .
      984     if p-param eq ""
      985     then
      986        p-param = "EXCEL:" + v-excel.
      987     else
      988        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      989     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      990   end procedure.
