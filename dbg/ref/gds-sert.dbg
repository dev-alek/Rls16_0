     1906         (input  (p-new-height - frame Dialog-Frame :height)
     1907         ,input  p-move-resize
     1908         ) .
     1909     end.
     1910   end procedure.
     1911   procedure diasize_change-width :
     1912     define input  parameter p-change-value as decimal   no-undo .
