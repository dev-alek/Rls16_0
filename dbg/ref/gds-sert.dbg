     1115        B-hist AT ROW 1 COL 78
     1116        B-Help AT ROW 1 COL 88
     1117        v-artic AT ROW 2.13 COL 8.25 COLON-ALIGNED
     1118        v-gds-name AT ROW 2.13 COL 39.88 COLON-ALIGNED
     1119        v-days AT ROW 3.25 COL 70.5 COLON-ALIGNED NO-LABEL
     1120        v-code AT ROW 3.25 COL 72.5 COLON-ALIGNED NO-LABEL
     1121        v-type AT ROW 3.25 COL 90.63 COLON-ALIGNED NO-LABEL
     1122        r-b-sort AT ROW 3.29 COL 8 NO-LABEL
     1123        br-docs AT ROW 4.75 COL 1.5
     1124        "Фильтр:" VIEW-AS TEXT
     1125             SIZE 7 BY 1 AT ROW 3.25 COL 1
     1126        SPACE(90.74) SKIP(19.12)
     1127       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1128            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1129            TITLE "Сертификаты для товара"
     1130            CANCEL-BUTTON b-exit.
     1131   ASSIGN
     1132          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1133          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1134   ASSIGN
     1135          B-hist:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-hist:HANDLE.
     1136   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1137   DO:
     1138     APPLY "END-ERROR":U TO SELF.
     1139   END.
     1140   ON CHOOSE OF b-cli IN FRAME Dialog-Frame
     1141   DO:
     1142     run ref/cli-sert.w ( input parparentproc
     1143                        , input p-curr-obj-type
     1144                        , input p-curr-obj-code
     1145                        , input "all":U
     1146                        , input ?
     1147                        , input ?
     1148                        , input i-b-code).
     1149     run Openbr in this-procedure .
     1150   END.
     1151   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1152   DO:
     1153     define variable ri as recid no-undo.
     1154     define variable rr as recid no-undo.
     1155     if not available b-sert-join THEN return no-apply.
     1156     message "Отсоединить сертификат " b-sert.sert-code " от товара?"
     1157                      view-as alert-box  warning buttons  yes-no set OK as log .
     1158     if OK   then do:
     1159         ri = recid( b-sert-join ).
     1160         get prev br-docs .
     1161         if available b-sert-join
     1162             then   rr = recid( b-sert-join ).
     1163             else do:
     1164                 get next br-docs.
     1165                 get next br-docs.
     1166                 rr = recid( b-sert-join ).
     1167             end.
     1168         find b-sert-join where recid( b-sert-join ) = ri.
     1169         delete b-sert-join.
     1170         run Openbr in this-procedure .
     1171         reposition br-docs to recid rr no-error.
     1172         apply "ENTRY":U to br-docs.
     1173         apply "VALUE-CHANGED":U to br-docs.
     1174      end.
     1175   END.
     1176   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
     1177   DO:
     1178     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1179     IF NOT AVAILABLE b-sert-join THEN RETURN.
     1180     if hist-option = '':U then do:
     1181           run gbl/pop-up.p ( input self:handle, input no) no-error.
     1182     end.
     1183     if hist-option = '':U then return no-apply.
     1184     run ref/c-serts.w (
     1185                   INPut parParentProc
     1186                  ,INPUT '':U
     1187                  ,INPUT 'subject'
     1188                  ,INPUT (IF hist-option = 'all' THEN '':U ELSE b-sert-join.cli-type)
     1189                  ,INPUT (IF hist-option = 'all' THEN 0 ELSE b-sert-join.cli-code)
     1190                  ,INPUT (IF hist-option = 'all' THEN '':U ELSE b-sert-join.sert-code)
     1191                  ,INPUT b-sert-join.b-code
     1192                  ,INPUT 'sert-join':U
     1193                  ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     1194     APPLY "entry" TO br-docs.
     1195   END.
     1196   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1197   DO:
     1198   define variable loc#log as logical no-undo .
     1199   if i-point = 'все':U then do:
     1200         message "Вы хотите напечатать весь список сертифицированных товаров" skip
     1201         "Эта процедура может занять долгое время! Продолжать?" view-as alert-box
     1202         WARNING buttons YES-NO update loc#log.
     1203         if NOT loc#log then return no-apply.
     1204   end.
     1205   v-doc-rec = recid( b-sert-join ).
     1206   DO WHILE available b-sert-join :
     1207         GET prev br-docs.
     1208   END.
     1209   run Print-List in this-procedure .
     1210   reposition br-docs to recid v-doc-rec no-error.
     1211   apply "entry" to br-docs in frame Dialog-Frame.
     1212   END.
     1213   ON VALUE-CHANGED OF br-docs IN FRAME Dialog-Frame
     1214   DO:
     1215           find ub.bar-code where ub.bar-code.b-code = b-sert-join.b-code no-lock no-error.
     1216           if available ub.bar-code then do:
     1217               find ub.goods where ub.goods.gds-code = ub.bar-code.gds-code no-lock.
     1218               assign
     1219                   v-gds-name = ub.goods.gds-name
     1220                   v-artic = ub.goods.artic
     1221                   v-b-code = b-sert-join.b-code.
     1222           end.
     1223           else if i-b-code <> ? then do:
     1224               find ub.bar-code where ub.bar-code.b-code = i-b-code no-lock no-error.
     1225               if available ub.bar-code then do:
     1226                   find ub.goods where goods.gds-code = ub.bar-code.gds-code no-lock.
     1227                   assign
     1228                       v-gds-name = goods.gds-name
     1229                       v-artic = goods.artic
     1230                       v-b-code = i-b-code.
     1231                end.
     1232            end.
     1233            disp v-gds-name v-artic v-b-code with frame Dialog-Frame.
     1234   END.
     1235   ON CHOOSE OF MENU-ITEM m-all
     1236   DO:
     1237     assign
     1238     hist-option = 'all'.
     1239     APPLY "CHOOSE" to b-hist  in frame Dialog-Frame.
     1240   END.
     1241   ON CHOOSE OF MENU-ITEM m-one
     1242   DO:
     1243     assign
     1244     hist-option = 'one'.
     1245     APPLY "CHOOSE" to b-hist  in frame Dialog-Frame.
     1246   END.
     1247   ON VALUE-CHANGED OF r-b-sort IN FRAME Dialog-Frame
     1248   DO:
     1249     assign r-b-sort.
     1250       case r-b-sort:
     1251       when 2 then do:
     1252           disable v-b-code v-days with frame Dialog-Frame.
     1253           hide v-b-code v-days .
     1254           if i-point = "cli":U then do:
     1255               message "Сортировка итак по одному клиенту" view-as alert-box warning.
     1256               r-b-sort = 1.
     1257               disp r-b-sort with frame Dialog-Frame.
     1258               apply "VALUE-CHANGED":U to r-b-sort.
     1259               return no-apply.
     1260           end.
     1261           view v-code v-type.
     1262           enable v-code v-type with frame Dialog-Frame.
     1263           apply "entry" to v-code.
     1264           return no-apply.
     1265       end.
     1266       when 3 then do:
     1267           disable v-type v-code v-days with frame Dialog-Frame.
     1268           hide v-type v-code v-days .
     1269           if i-point = "gds:U" then do:
     1270               message "Сортировка итак по одному товару" view-as alert-box warning.
     1271               r-b-sort = 1.
     1272               disp r-b-sort with frame Dialog-Frame.
     1273               apply "VALUE-CHANGED":U to r-b-sort.
     1274           end.
     1275           else do:
     1276               enable v-b-code with frame Dialog-Frame.
     1277               apply "entry" to v-b-code.
     1278               return no-apply.
     1279           end.
     1280       end.
     1281       when 5 then do:
     1282           disable v-type v-code v-b-code v-days with frame Dialog-Frame.
     1283           hide v-type v-code v-b-code.
     1284           if i-point = "over":U then do:
     1285               message "Сортировка итак по просроченным" view-as alert-box warning.
     1286               r-b-sort = 1.
     1287               disp r-b-sort with frame Dialog-Frame.
     1288               apply "VALUE-CHANGED":U to r-b-sort.
     1289           end.
     1290           i-point = "over":U.
     1291           RUN OpenBr in this-procedure .
     1292       end.
     1293       when 4 then do:
     1294           disable v-type v-code v-b-code v-days with frame Dialog-Frame.
     1295           hide v-type v-code v-b-code.
     1296           if i-point = "true":U then do:
     1297               message "Сортировка итак по действующим" view-as alert-box warning.
     1298               r-b-sort = 1.
     1299               disp r-b-sort with frame Dialog-Frame.
     1300               apply "VALUE-CHANGED":U to r-b-sort.
     1301           end.
     1302           i-point = "true":U.
     1303           RUN OpenBr in this-procedure .
     1304       end.
     1305       when 6 then do:
     1306           disable v-type v-code v-b-code with frame Dialog-Frame.
     1307           hide v-type v-code v-b-code .
     1308           enable v-days with frame Dialog-Frame.
     1309           apply "entry" to v-days.
     1310           return no-apply.
     1311       end.
     1312       otherwise do:
     1313           disable v-code v-type v-b-code v-days with frame Dialog-Frame.
     1314           hide v-code v-type v-b-code v-days .
     1315           i-point = "all":U.
     1316           run Openbr in this-procedure .
     1317        end.
     1318     end case.
     1319   END.
     1320   ON RETURN OF v-b-code IN FRAME Dialog-Frame
     1321   DO:
     1322   def buffer buf-b-code for ub.bar-code.
     1323     assign
     1324         v-b-code
     1325         i-b-code = v-b-code
     1326         i-point = "gds":U.
     1327     find first buf-b-code where
     1328                buf-b-code.b-code =  i-b-code no-lock no-error.
     1329     if available buf-b-code then do:
     1330         find first ub.goods where
     1331                    ub.goods.gds-code = buf-b-code.gds-code no-lock.
     1332         FIND FIRST ub.gds-prt WHERE
     1333                    ub.gds-prt.upper-code = goods.prt-root NO-LOCK .
     1334         find FIRST ub.bar-code where
     1335                    ub.bar-code.gds-code = ub.goods.gds-code AND
     1336                    ub.bar-code.node-code = ub.gds-prt.node-code AND
     1337                    ub.bar-code.part-code = "" AND
     1338                    ub.bar-code.in-code = "" AND
     1339                    ub.bar-code.unit-cli = ub.goods.unit-base no-lock.
     1340         i-b-code = ub.bar-code.b-code.
     1341         run Openbr in this-procedure .
     1342     end.
     1343     else
     1344       message "Нет такого товара" view-as alert-box warning.
     1345     i-point = "ALL":U.
     1346     return no-apply.
     1347   END.
     1348   ON RETURN OF v-code IN FRAME Dialog-Frame
     1349   DO:
     1350     assign v-code .
     1351     if v-code <> 0 then do:
     1352           apply "ENTRY" to v-type.
     1353           apply "VALUE-CHANGED":U to br-docs.
     1354     end.
     1355     else do:
     1356               r-b-sort = 1.
     1357               disp r-b-sort with frame Dialog-Frame.
     1358               apply "VALUE-CHANGED":U to r-b-sort.
     1359               return no-apply.
     1360     end.
     1361   END.
     1362   ON RETURN OF v-days IN FRAME Dialog-Frame
     1363   DO:
     1364      assign
     1365         v-days
     1366         i-days = v-days
     1367         i-point = "day-off":U.
     1368         run Openbr in this-procedure .
     1369     return no-apply.
     1370   END.
     1371   ON RETURN OF v-type IN FRAME Dialog-Frame
     1372   DO:
     1373     assign
     1374     v-code v-type
     1375     i-code = v-code
     1376     i-type = v-type
     1377     i-point = "cli":U.
     1378     if can-find(first ub.clients where
     1379                       ub.clients.obj-type = v-type and ub.clients.obj-code = v-code) then  dO:
     1380         run Openbr in this-procedure .
     1381     end.
     1382     else do:
     1383       message "Нет такого контрагента" view-as alert-box warning.
     1384     i-point = "all":U.
     1385     end.
     1386     return no-apply.
     1387   END.
     1388   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1389   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1390   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1391   on help of frame Dialog-Frame
     1392   do:
     1393     run gbl/app_help.p
     1394       (input this-procedure :file-name
     1395       ,input ''
     1396       ,input ?
     1397       ) no-error.
     1398     if error-status :error then do:
     1399       message
     1400         "Ошибка при вызове помощи"
     1401         error-status :get-message(1)
     1402         view-as alert-box .
     1403     end.
     1404   end.
     1405   run minbtn-set in this-procedure .
     1406   on choose of b-help in frame Dialog-Frame
     1407   do:
     1408     apply "help":u to frame Dialog-Frame .
     1409   end.
     1410   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1411   procedure minbtn-set :
     1412       do
     1413           on error undo, return error return-value
     1414           :
     1415           define variable ii              as integer       no-undo .
     1416           define variable fh              as widget-handle no-undo .
     1417           define variable hh              as widget-handle no-undo .
     1418           define variable v-h             as handle        extent 4 no-undo .
     1419           define variable v-name-button   as character     no-undo .
     1420           define variable v-help-old-x    as decimal       no-undo .
     1421           define variable v-help-old-y    as decimal       no-undo .
     1422           define variable v-help-old-size as decimal       no-undo .
     1423           define variable v-frame-width   as decimal       no-undo .
     1424           define variable jj              as integer       no-undo .
     1425           do
     1426               on error undo, return error
     1427               :
     1428               assign
     1429                   v-frame-width = frame Dialog-Frame:width - 0.3
     1430                   fh            = frame Dialog-Frame:first-child
     1431                   hh            = fh:first-child
     1432                   ii            = 1
     1433                   .
     1434               do while valid-handle(hh):
     1435                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1436                   do:
     1437                       case lc(hh:name) :
     1438                           when "b-help" then
     1439                               do:
     1440                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1441                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1442                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1443                                   hh:TOOLTIP = "Помощь" .
     1444                                   v-help-old-x = hh:column .
     1445                                   v-help-old-y = hh:row    .
     1446                                   v-help-old-size = hh:width .
     1447                                   hh:width-chars = 2.5 .
     1448                               end.
     1449                           when "b-print" then
     1450                               do:
     1451                                   hh:load-image("cmp/b-print.bmp":u) .
     1452                                   hh:TOOLTIP = "Печать" .
     1453                                   v-h[ii] = hh:handle .
     1454                                   ii = ii + 1 .
     1455                                   hh:width-chars = 3 .
     1456                               end.
     1457                           when "b-history" or
     1458                           when "b-hist" then
     1459                               do:
     1460                                   hh:load-image("cmp/b-hist.bmp":u) .
     1461                                   hh:TOOLTIP = "История" .
     1462                                   v-h[ii] = hh:handle .
     1463                                   ii = ii + 1 .
     1464                                   hh:width-chars = 3 .
     1465                               end.
     1466                           when "b-sch" then
     1467                               do:
     1468                                   hh:load-image("cmp/b-sch.bmp":u) .
     1469                                   hh:TOOLTIP = "Установка Фильтра" .
     1470                                   v-h[ii] = hh:handle .
     1471                                   ii = ii + 1 .
     1472                                   hh:width-chars = 3 .
     1473                               end.
     1474                           when "b-hist-user" then
     1475                               do:
     1476                                   hh:load-image("cmp/b-hist.bmp":u) .
     1477                                   hh:TOOLTIP = "История пользователя" .
     1478                                   ii = ii + 1 .
     1479                               end.
     1480                       end case.
     1481                   end.
     1482                   hh = hh:next-sibling.
     1483               end.
     1484               b-help:column = v-frame-width - b-help:width-chars.
     1485               jj = 0.
     1486               repeat ii = 4 to 1 by -1 :
     1487                   if valid-handle (v-h[ii] ) then
     1488                   do:
     1489                       jj  = jj + 1 .
     1490                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1491                       v-h[ii]:row    = v-help-old-y .
     1492                   end.
     1493               end.
     1494           end.
     1495       end.
     1496   end procedure.
     1497   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1498   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1499   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1500   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1501   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1502   define variable v-diasize-current-frame-height as decimal   no-undo .
     1503   define variable v-diasize-change-size          as logical   no-undo .
     1504   define variable v-diasize-resize-button        as handle    no-undo .
     1505   define variable v-diasize-wndmax               as logical   no-undo .
     1506   define variable v-diasize-wndstore             as logical   no-undo .
     1507   define variable v-diasize-proc-name            as character no-undo .
     1508   define variable v-diasize-browse-handle        as handle    no-undo .
     1509   define variable v-diasize-browse-number        as integer   no-undo .
     1510   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1511   define temp-table temp-diasize-handle no-undo
     1512     field handle-value  as handle
     1513     field save-position as decimal
     1514     index xpk is primary unique handle-value
     1515     .
     1516   define temp-table temp-browse-handle no-undo
     1517     field browse-type   as character
     1518     field browse-number as integer
     1519     field browse-handle as handle
     1520     field original-size as decimal
     1521     index xpk is primary unique browse-type browse-number
     1522     index xie browse-type browse-handle
     1523   .
     1524   procedure diasize_change-height :
     1525     define input  parameter p-change-value  as decimal   no-undo .
     1526     define input  parameter p-move-resize   as logical   no-undo .
     1527     define variable v-field-group-handle    as handle    no-undo .
     1528     define variable v-object-handle         as handle    no-undo .
     1529     define variable v-frame-height          as decimal   no-undo .
     1530     define variable v-frame-virtual-height  as decimal   no-undo .
     1531     define variable v-browse-height         as decimal   no-undo .
     1532     define variable v-window-height         as decimal   no-undo .
     1533     define variable v-window-virtual-height as decimal   no-undo .
     1534     define variable v-change-sign           as integer   no-undo .
     1535     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1536     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1537     if p-change-value > 0
     1538     then do:
     1539       if frame Dialog-Frame :height + p-change-value
     1540           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1541       then do:
     1542         assign
     1543           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1544                           - (frame Dialog-Frame :height-chars)
     1545         .
     1546         if p-change-value <= 0
     1547         then do:
     1548           run diasize_position-resize-button in this-procedure .
     1549           return .
     1550         end.
     1551       end.
     1552     end.
     1553     if p-change-value < 0
     1554     then do:
     1555       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1556       then do:
     1557         assign
     1558           p-change-value = v-diasize-orig-frame-height
     1559                          - (frame Dialog-Frame :height-chars)
     1560         .
     1561         if p-change-value >= 0
     1562         then do:
     1563           run diasize_position-resize-button in this-procedure .
     1564           return .
     1565         end.
     1566       end.
     1567     end.
     1568     if p-change-value >= 0
     1569     then do:
     1570       assign
     1571         v-change-sign = 1
     1572       .
     1573     end.
     1574     else do:
     1575       assign
     1576         v-change-sign = -1
     1577       .
     1578     end.
     1579     assign
     1580       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1581     .
     1582     if p-change-value = 0
     1583     then do:
     1584       run diasize_position-resize-button in this-procedure .
     1585       return .
     1586     end.
     1587     move_block:
     1588     do
     1589     on error undo move_block, retry move_block
     1590     :
     1591       if retry
     1592       then do:
     1593         do
     1594         on error undo move_block, leave move_block
     1595         :
     1596           if p-change-value > 0
     1597           then do:
     1598             for each buf_temp-diasize-handle
     1599             on error undo, next
     1600             :
     1601               assign
     1602                 v-object-handle = buf_temp-diasize-handle.handle-value
     1603               .
     1604               if v-object-handle <> v-diasize-resize-button
     1605               then do:
     1606                 assign
     1607                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1608                 .
     1609               end.
     1610             end.
     1611             assign
     1612               v-diasize-browse-handle :height = v-browse-height
     1613             .
     1614             for each buf_temp-browse-handle
     1615               where buf_temp-browse-handle.browse-type = 'height':u
     1616             on error undo, next
     1617             :
     1618               assign
     1619                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1620               .
     1621             end.
     1622             assign
     1623               frame Dialog-Frame :height = v-frame-height
     1624             .
     1625             if frame Dialog-Frame :scrollable = true
     1626             then do:
     1627               assign
