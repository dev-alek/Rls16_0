      121   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      122   procedure cur-time :
      123      define output parameter p-today as date      no-undo .
      124      define output parameter p-time  as integer   no-undo .
      125     do
      126     on error undo, return error
      127     :
      128       define variable v-date1 as date      no-undo .
      129       define variable v-date2 as date      no-undo .
      130       define variable v-time  as integer   no-undo .
      131       assign
      132         v-date1 = today
      133         v-time  = time
      134         v-date2 = today
      135       .
      136       if v-date1 <> v-date2
      137       then do:
      138         assign
      139           v-date1 = today
      140           v-time  = v-time
      141         .
      142       end.
      143       assign
      144         p-today = v-date1
      145         p-time  = v-time
      146       .
      147     end.
      148   end.
      149   function cur-time-date returns character
      150   :
      151     return string(today, '99/99/9999':U) .
      152   end.
      153   function cur-time-mjd returns decimal
      154   :
      155     define variable v-date as date      no-undo .
      156     define variable v-time as integer   no-undo .
      157     run cur-time in this-procedure
      158       (output v-date
      159       ,output v-time
      160       ) .
      161     return integer(v-date) - 2400002 + (v-time / 86400) .
      162   end.
      163   function cur-time-get-ending-index returns integer
      164   (input p-number as integer
      165   )
      166   :
      167     if p-number < 0
      168     or p-number = ?
      169     then do:
      170       return 1 .
      171     end.
      172     define variable v-rest as integer   no-undo .
      173     assign
      174       p-number = p-number modulo 100
      175     .
      176     if p-number < 20
      177     then do:
      178       assign
      179         v-rest = p-number
      180       .
      181     end.
      182     else do:
      183       assign
      184         v-rest = p-number modulo 10
      185       .
      186     end.
      187     case v-rest :
      188       when 1
      189       then do:
      190         return 2 .
      191       end.
      192       when 2 or
      193       when 3 or
      194       when 4
      195       then do:
      196         return 3 .
      197       end.
      198       otherwise do:
      199         return 1 .
      200       end.
      201     end case .
      202   end.
      203   procedure cur-time-mjd-to-date :
      204      define input  parameter i-mjd-diff as decimal no-undo.
      205      define output parameter o-Date     as date    no-undo.
      206      define output parameter o-Time     as integer no-undo.
      207      define variable v-day-number as integer   no-undo .
      208      if    i-mjd-diff < 0
      209         or i-mjd-diff = ?
      210      then do:
      211         return "?" .
      212      end.
      213      assign
      214         v-day-number = truncate(i-mjd-diff,0).
      215         o-Date = date(v-day-number + 2400002).
      216         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      217     .
      218   end.
      219   function cur-time-mjd-to-string returns character
      220   (input p-mjd-diff as decimal
      221   )
      222   :
      223     define variable v-day-number as integer   no-undo .
      224     define variable v-seconds    as integer   no-undo .
      225     define variable v-hour       as integer   no-undo .
      226     define variable v-min        as integer   no-undo .
      227     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      228     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      229     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      230     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      231     if p-mjd-diff < 0
      232     or p-mjd-diff = ?
      233     then do:
      234       return "?" .
      235     end.
      236     assign
      237       v-day-number = integer(truncate(p-mjd-diff,0))
      238       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      239     .
      240     if v-seconds > 86400
      241     then do:
      242       assign
      243         v-seconds = 86400 - 1
      244       .
      245     end.
      246     if v-seconds < 0
      247     then do:
      248       assign
      249         v-seconds = 0
      250       .
      251     end.
      252     assign
      253       v-hour = truncate(v-seconds / 3600, 0)
      254     .
      255     assign
      256       v-seconds = v-seconds modulo 3600
      257     .
      258     assign
      259       v-min = truncate(v-seconds / 60, 0)
      260     .
      261     assign
      262       v-seconds = v-seconds modulo 60
      263     .
      264     return
      265         (if v-day-number <> 0
      266           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      267           else ""
      268         )
      269       + (if v-day-number <> 0 or v-hour <> 0
      270           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      271           else ""
      272         )
      273       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      274           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      275           else ""
      276         )
      277       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      278       .
      279   end.
      280   function cur-time-string returns character
      281   :
      282     define variable v-date as date      no-undo .
      283     define variable v-time as integer   no-undo .
      284     run cur-time in this-procedure
      285       (output v-date
      286       ,output v-time
      287       ) .
      288     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      289   end.
      290   function cur-time-string-sec returns character
      291   :
      292     define variable v-date as date      no-undo .
      293     define variable v-time as integer   no-undo .
      294     run cur-time in this-procedure
      295       (output v-date
      296       ,output v-time
      297       ) .
      298     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      299   end.
      300   function cur-time-custom  returns character
      301   (input p-prefix as character
      302   ,input p-date-format as character
      303   ,input p-delimiter as character
      304   ,input p-time-format as character
      305   ,input p-suffix as character
      306   )
      307   :
      308     define variable v-date as date      no-undo .
      309     define variable v-time as integer   no-undo .
      310     run cur-time in this-procedure
      311       (output v-date
      312       ,output v-time
      313       ) .
      314     return
      315       p-prefix
      316       + string(v-date, p-date-format)
      317       + p-delimiter
      318       + string(v-time, p-time-format)
      319       + p-suffix
      320       .
      321   end.
      322   function cur-time-print  returns character
      323   :
      324     define variable v-date as date      no-undo .
      325     define variable v-time as integer   no-undo .
      326     run cur-time in this-procedure
      327       (output v-date
      328       ,output v-time
      329       ) .
      330     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      331   end.
      332   function cur-time-datetime returns datetime
      333   :
      334     define variable v-char as character no-undo .
      335     define variable v-datetime as datetime no-undo .
      336     v-char = cur-time-string().
      337     v-datetime = datetime(v-char).
      338     return  v-datetime.
      339   end.
      340   function cur-time-string-msec returns character
      341   :
      342     define variable v-date as datetime  no-undo .
      343     v-date = now.
      344     return string(v-date) .
      345   end.
      346   function diff-list returns character (
      347     input parfirst-list  as character,
      348     input parsecond-list as character,
      349     input pardelim       as character).
      350     if pardelim = ""
      351     or pardelim = ?
      352     then do:
      353       assign
      354         pardelim = ","
      355       .
      356     end.
      357     def var ind as integer no-undo .
      358     def var v-elem as character no-undo .
      359     def var v-result-list as character no-undo init "".
      360     def var v-num-parfirst-list as integer no-undo .
      361     assign
      362       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      363     .
      364     do ind = 1 to v-num-parfirst-list
      365     :
      366       assign
      367         v-elem = entry(ind, parfirst-list, pardelim)
      368       .
      369       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      370         assign
      371           v-result-list = v-result-list
      372                         + (if v-result-list > "" then pardelim else "")
      373                         + v-elem
      374         .
      375       end.
      376     end.
      377     return v-result-list .
      378   end function.
      379   function add-list returns character (
      380    input parfirst-list  as character,
      381    input parsecond-list as character,
      382    input pardelim       as character).
      383     if pardelim = ""
      384     or pardelim = ?
      385     then do:
      386       assign
      387         pardelim = ","
      388       .
      389     end.
      390     def var ind as integer no-undo .
      391     def var v-elem as character no-undo .
      392     def var v-result-list as character no-undo init "".
      393     def var v-num-parfirst-list as integer no-undo .
      394     assign
      395       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      396     .
      397     do ind = 1 to v-num-parfirst-list
      398     :
      399       assign
      400         v-elem = entry(ind, parfirst-list, pardelim)
      401       .
      402       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      403         assign
      404           v-result-list = v-result-list
      405                         + (if v-result-list > "" then pardelim else "")
      406                         + v-elem
      407         .
      408       end.
      409     end.
      410     def var v-num-parsecond-list as integer no-undo .
      411     assign
      412       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      413     .
      414     do ind = 1 to v-num-parsecond-list
      415     :
      416       assign
      417         v-elem = entry(ind, parsecond-list, pardelim)
      418       .
      419       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      420         assign
      421           v-result-list = v-result-list
      422                         + (if v-result-list > "" then pardelim else "")
      423                         + v-elem
      424         .
      425       end.
      426     end.
      427     return v-result-list .
      428   end function.
      429   function cross-list returns character (
      430    input parfirst-list  as character,
      431    input parsecond-list as character,
      432    input pardelim       as character).
      433     if pardelim = ""
      434     or pardelim = ?
      435     then do:
      436       assign
      437         pardelim = ","
      438       .
      439     end.
      440     def var ind as integer no-undo .
      441     def var v-elem as character no-undo .
      442     def var v-result-list as character no-undo init "".
      443     def var v-num-parfirst-list as integer no-undo .
      444     assign
      445       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      446     .
      447     do ind = 1 to v-num-parfirst-list
      448     :
      449       assign
      450         v-elem = entry(ind, parfirst-list, pardelim)
      451       .
      452       if lookup(v-elem, v-result-list, pardelim) = 0
      453       and lookup(v-elem, parsecond-list, pardelim) > 0
      454       then do:
      455         assign
      456           v-result-list = v-result-list
      457                         + (if v-result-list > "" then pardelim else "")
      458                         + v-elem
      459         .
      460       end.
      461     end.
      462     return v-result-list .
      463   end function.
      464   function radio-label returns character (
      465    input par-rs-value  as character,
      466    input par-rs-radio-buttons as character)
      467    .
      468    DEFINE variable v-result-label as character no-undo.
      469    assign
      470    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      471                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      472                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      473                             ), par-rs-radio-buttons
      474                           )
      475    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      476    .
      477   return v-result-label.
      478   end function.
      479   function m-radio-label returns character (
      480    input par-rs-value  as character,
      481    input par-rs-radio-buttons as character,
      482    input par-delim as character
      483    )
      484    .
      485    DEFINE variable v-result-label as character no-undo.
      486    assign
      487    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      488                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      489                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      490                             ), par-rs-radio-buttons, par-delim
      491                           )
      492    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      493    .
      494   return v-result-label.
      495   end function.
      496   FUNCTION mixlist returns character
      497   (
      498    input parfirst-list  as character
      499    ,input parsecond-list as character
      500    ,input pardelim       as character
      501    ,input pardelim-result as character ) :
      502     if pardelim = ""
      503     or pardelim = ?
      504     then do:
      505       assign
      506         pardelim = ","
      507       .
      508     end.
      509     def var ind as integer no-undo .
      510     def var v-elem1 as character no-undo .
      511     def var v-elem2 as character no-undo .
      512     def var v-result-list as character no-undo init "".
      513     do ind = 1 to num-entries(parfirst-list, pardelim)
      514     :
      515       assign
      516         v-elem1 = entry(ind, parfirst-list, pardelim)
      517         v-elem2 = entry(ind, parsecond-list, pardelim)
      518       .
      519         assign
      520           v-result-list = v-result-list
      521                         + (if v-result-list > "" then pardelim-result else "")
      522                         + v-elem1 + pardelim-result + v-elem2
      523         .
      524     end.
      525     return v-result-list .
      526   END FUNCTION.
      527   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      528   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      529   define new shared variable RepPathName        as character no-undo .
      530   define new shared variable PrintRubl          as logical   no-undo .
      531   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      532   function breakstr returns character ( input        for-name    as character,
      533                                         input        line-length as integer,
      534                                         input-output line1       as character,
      535                                         input-output line2       as character ) :
      536     define variable ii as integer no-undo.
      537     if length( for-name ) > line-length then do:
      538       assign ii    = 1
      539              line1 = "":u
      540              line2 = "":u.
      541       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      542         assign line1 =       substring( for-name, 1, line-length     )
      543                line2 = trim( substring( for-name,    line-length + 1 ) ).
      544       end.                                                     else do:
      545         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      546           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      547                  ii    = ii    + 1.
      548           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      549             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      550           end.
      551         end.
      552         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      553       end.
      554     end.                                else do:
      555       assign line1 = for-name
      556              line2 = "":u.
      557     end.
      558     return ( line1 ).
      559   end function.
