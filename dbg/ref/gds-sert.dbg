     1922     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1923     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1924     if p-change-value > 0
     1925     then do:
     1926       if frame Dialog-Frame :width + p-change-value >
     1927           session :width-chars
     1928       then do:
     1929         assign
     1930           p-change-value = session :width-chars - frame Dialog-Frame :width
     1931         .
     1932         if p-change-value <= 0
     1933         then do:
     1934           run diasize_position-resize-button in this-procedure .
     1935           return .
     1936         end.
     1937       end.
     1938     end.
     1939     if p-change-value < 0
     1940     then do:
     1941       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1942       then do:
     1943         assign
     1944           p-change-value = v-diasize-orig-frame-width
     1945                          - frame Dialog-Frame :width
     1946         .
     1947         if p-change-value >= 0
     1948         then do:
     1949           run diasize_position-resize-button in this-procedure .
     1950           return .
     1951         end.
     1952       end.
     1953     end.
     1954     if p-change-value >= 0
     1955     then do:
     1956       assign
     1957         v-change-sign = 1
     1958       .
     1959     end.
     1960     else do:
     1961       assign
     1962         v-change-sign = -1
     1963       .
     1964     end.
     1965     assign
     1966       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1967     .
     1968     if p-change-value = 0
     1969     then do:
     1970       run diasize_position-resize-button in this-procedure .
     1971       return .
     1972     end.
