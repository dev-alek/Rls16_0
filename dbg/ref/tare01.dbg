        1   block-level on error undo, throw.
        2   define input-output parameter p-rec as recid no-undo.
        3   define input parameter        p-silent         as logical no-undo .
        4   define input parameter        p-mode             as character no-undo .
        5   define input parameter        p-tare-name      like ub.tare.tare-name no-undo .
        6   define input parameter        p-tare-code      like ub.tare.tare-code  no-undo .
        7   define input parameter        p-key#_one       as integer no-undo .
        8   define input parameter        p-key#_two       as integer no-undo .
        9   define input parameter        p-charkey_one    as character no-undo .
       10   define input parameter        p-charkey_two    as character no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       12   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       13   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile: tare01.p $":U .
       15   define variable vss-archive     as character no-undo init "$Archive: ref/tare01.p $":U .
       16   define variable vss-description as character no-undo init "Сохранение изменений в карточке ТАРЫ".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define variable v-db-num like ub.db.db-num no-undo .
       78   define variable v-log         as logical   no-undo .
       79   define variable v-err-mess as character no-undo .
       80   define buffer buf_tare for ub.tare.
       81   if p-mode <> 'ДОБАВЛЕНИЕ':U
       82   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
       83     message
       84     vss-workfile vss-revision vss-description skip
       85     "Неверный параметр p-mode" p-mode
       86     view-as alert-box error .
       87     return error '':u.
       88   end.
       89   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       90   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
       91     (output v-db-num
       92     )  .
       93   if v-db-num <> 0
       94   then do:
       95     v-err-mess = substitute("Нельзя изменять запись ТАРЫ в УБД: Номер текущей БД &1 ", v-db-num ).
       96     run err-mess in this-procedure ( input-output v-err-mess).
       97     undo, return error (if p-silent then v-err-mess else "":U).
       98   end.
       99   if p-tare-name = "":U then do:
      100     v-err-mess = substitute("Не указано полное наименование тары" ).
      101     run err-mess in this-procedure ( input-output v-err-mess).
      102     undo, return error (if p-silent then v-err-mess else "tare-name":U).
      103   end.
      104   if p-tare-code = "":U
      105   or p-tare-code = ?
      106   then do:
      107     v-err-mess = "Не указан код (аббревиатура) тары".
      108     run err-mess in this-procedure ( input-output v-err-mess).
      109     undo, return error (if p-silent then v-err-mess else "tare-code":U).
      110   end.
      111   if trim(p-tare-code) <> p-tare-code
      112   then do:
      113     v-err-mess = "В коде (аббревиатуре) тары присутствуют недопустимые символы".
      114     run err-mess in this-procedure ( input-output v-err-mess).
      115     undo, return error (if p-silent then v-err-mess else "tare-code":U).
      116   end.
      117   if can-find(first buf_tare no-lock where
      118                     buf_tare.tare-code = p-tare-code
      119                 AND (p-mode = 'ДОБАВЛЕНИЕ':U OR p-rec <> recid(buf_tare))
      120                 ) then do:
      121     v-err-mess = substitute("Уже есть такая ТАРА &1", p-tare-code).
      122     run err-mess in this-procedure ( input-output v-err-mess).
      123     undo, return error (if p-silent then v-err-mess else "tare-code":U).
      124   end.
      125   main-block:
      126   do
      127   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      128   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      129   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      130   :
      131     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      132       create buf_tare.
      133       assign
      134       buf_tare.tare-code = p-tare-code
      135       .
      136     end.
      137     else do:
      138       FIND FIRST buf_tare where
      139                 recid(buf_tare) = p-rec No-ERROR.
      140       if not available buf_tare then do:
      141         v-err-mess = substitute("&1 &2 &3&4Не найдена запись ТАРЫ - p-rec=&5"
      142                                 ,vss-workfile
      143                                 ,vss-revision
      144                                 ,vss-description
      145                                 , chr(10)
      146                                 ,p-rec).
      147         run err-mess in this-procedure ( input-output v-err-mess).
      148         undo main-block, return error (if p-silent then v-err-mess else "":U).
      149       end.
      150       if buf_tare.tare-code <> p-tare-code
      151       then do:
      152         v-err-mess = substitute("&1 &2 &3&4Для уже имеющейся записи нельзя изменить код тары&4ранее был &5 - попытка изменить на &6"
      153                                 ,vss-workfile
      154                                 ,vss-revision
      155                                 ,vss-description
      156                                 , chr(10)
      157                                 ,buf_tare.tare-code
      158                                 ,p-tare-code
      159                                  ).
      160         run err-mess in this-procedure ( input-output v-err-mess).
      161         undo main-block, return error (if p-silent then v-err-mess else "":U).
      162       end.
      163     end.
      164     assign
      165     buf_tare.tare-code = p-tare-code
      166     buf_tare.tare-name  = p-tare-name
      167     buf_tare.key#_one = p-key#_one
      168     buf_tare.key#_two = p-key#_two
      169     buf_tare.charkey_one = p-charkey_one
      170     buf_tare.charkey_two = p-charkey_two
      171     buf_tare.stts    =  (if p-mode = 'ДОБАВЛЕНИЕ':U
      172                                then 0
      173                                else buf_tare.stts)
      174     p-rec = recid(buf_tare)
      175     .
      176     release buf_tare no-error.
      177     if error-status:error then do:
      178       v-err-mess = substitute("Ошибка при попытке сохранения записи:&1&2&1&3"
      179                               , chr(10)
      180                               , error-status:get-message(1)
      181                               , return-value ).
      182       run err-mess in this-procedure ( input-output v-err-mess).
      183       undo main-block, return error (if p-silent then v-err-mess else "":U).
      184     end.
      185   end.
      186   PROCEDURE err-mess:
      187   DEFINE INPUT-output PARAMETER p-mess as character No-UNDO.
      188   if p-silent then do:
      189     assign
      190     p-mess = substitute("ТАРА: код &1&2:&3"
      191                         , (if p-mode = 'ДОБАВЛЕНИЕ':U or not available buf_tare then p-tare-code else buf_tare.tare-code)
      192                         , chr(10)
      193                         , p-mess)
      194     .
      195   end.
      196   else do:
      197     message
      198     p-mess
      199     view-as alert-box error .
      200   end.
      201   END PROCEDURE.
