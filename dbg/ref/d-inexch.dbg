      372        )
      373     or (can-query (self, "read-only")
      374        and
      375        self :read-only = false
      376        )
      377     then do:
      378       assign
      379         self :screen-value = ?
      380       .
      381     end.
      382     return no-apply.
      383   end.
      384   on delete-character of fi-exch-date in frame Dialog-Frame
      385   do:
