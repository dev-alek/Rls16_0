        1   define input         parameter h-callback         as handle    no-undo .
        2   define input         parameter p-title            as character no-undo .
        3   define input         parameter p-enable-update    as logical   no-undo .
        4   define input         parameter p-enable-exch-date as logical   no-undo .
        5   define input-output  parameter p-exch-date        as date      no-undo .
        6   define input-output  parameter p-exch-rate        as decimal   no-undo .
        7   define input-output  parameter p-exch-scale       as integer   no-undo .
        8   define output        parameter p-data-update      as logical   no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision$":U .
       10   define variable vss-author      as character no-undo init "$Author$":U .
       11   define variable vss-date        as character no-undo init "$Date$":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       13   define variable vss-archive     as character no-undo init "$Archive$":U .
       14   define variable vss-description as character no-undo init "Ввести дату и курс валюты".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       70   procedure sel-date :
       71     define input  parameter p-date-handle as handle    no-undo .
       72     define input  parameter p-description as character no-undo .
       73     do
       74     on error undo, return error return-value
       75     :
       76       if (can-query (p-date-handle, "sensitive")
       77         and
       78         p-date-handle :sensitive = true
       79         )
       80       or (can-query (p-date-handle, "read-only")
       81         and
       82         p-date-handle :read-only = false
       83         )
       84       then do:
       85         if p-date-handle :handle <> focus :handle
       86         then do:
       87           apply "entry":u to p-date-handle .
       88         end.
       89         define variable v-ok            as logical no-undo .
       90         define variable v-curr-sv-date as date no-undo .
       91         assign
       92           v-curr-sv-date = date(p-date-handle :screen-value) no-error
       93         .
       94         if v-curr-sv-date = ?
       95         then do:
       96           run gbl/getcurdt.p
       97             (output v-curr-sv-date
       98             ) .
       99         end.
      100         if v-curr-sv-date <> ?
      101         then do:
      102           run gbl/d-inpday.w
      103             (input ?
      104             ,input "Выбор даты"
      105             ,input p-description
      106             ,input ""
      107             ,input-output v-curr-sv-date
      108             ,output v-ok
      109             ).
      110           if v-ok = true
      111           then do:
      112             assign
      113               p-date-handle :screen-value = string(v-curr-sv-date) .
      114             .
      115           end.
      116         end.
      117       end.
      118     end.
      119   end procedure.
      120   procedure proc-alt-shift-f2:
      121     if not ibs.th.gbl.gbl-var:rcode
      122   then
      123     run gbl\inidebug.p .
      124   end.
      125   procedure proc-alt-shift-f3:
      126     run gbl/prvssinf.p
      127       ( input this-procedure
      128       ) .
      129   end.
      130   define variable v-inform-launched as logical no-undo initial false .
      131   procedure proc-alt-shift-f4:
      132     define variable v-action as character no-undo .
      133     if v-inform-launched = false then do:
      134       assign
      135         v-inform-launched = true
      136       .
      137       run gbl/d-inform.w
      138         (  input self
      139         ,  input this-procedure
      140         , output v-action
      141         ) no-error .
      142       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      143       assign
      144         v-inform-launched = false
      145       .
      146     end.
      147   end.
      148   procedure proc-alt-f1:
      149     run gbl/corrhelp.p
      150       (input this-procedure
      151       ) .
      152   end .
      153   on alt-shift-f2 anywhere do:
      154     run proc-alt-shift-f2.
      155   end.
      156   on alt-shift-f3 anywhere do:
      157     run proc-alt-shift-f3 in this-procedure .
      158   end.
      159   on alt-shift-f4 anywhere do:
      160     run proc-alt-shift-f4 in this-procedure.
      161   end.
      162   on alt-f1 anywhere do:
      163     run proc-alt-f1 in this-procedure .
      164   end.
      165   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      166   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
      167   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
      168   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
      169   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
      170   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
      171   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      172   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      173   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
      174   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
      175   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
      176   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      177   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      178   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      179   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      180   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      181   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      182   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      183   DEFINE BUTTON b-choose-exch-date
      184        IMAGE-UP FILE "btn-down-arrow":U
      185        IMAGE-DOWN FILE "btn-down-arrow":U
      186        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      187        LABEL "b-choose-exch-date"
      188        SIZE 3 BY .88 TOOLTIP "Годен до".
      189   DEFINE BUTTON b-exit AUTO-GO
      190        LABEL "&Ввод"
      191        SIZE 10 BY 1
      192        BGCOLOR 8 .
      193   DEFINE BUTTON b-help
      194        LABEL "Помо&щь"
      195        SIZE 10 BY 1
      196        BGCOLOR 8 .
      197   DEFINE BUTTON b-quit AUTO-END-KEY
      198        LABEL "&Отмена"
      199        SIZE 10 BY 1
      200        BGCOLOR 8 .
      201   DEFINE VARIABLE fi-exch-date AS DATE FORMAT "99/99/9999":U
      202        LABEL "&Дата курса"
      203        VIEW-AS FILL-IN
      204        SIZE 11.5 BY 1 NO-UNDO.
      205   DEFINE VARIABLE fi-exch-rate AS DECIMAL FORMAT ">>,>>9.9999":U INITIAL 0
      206        LABEL "&Курс валюты"
      207        VIEW-AS FILL-IN
      208        SIZE 12.5 BY 1 NO-UNDO.
      209   DEFINE VARIABLE fi-exch-scale AS INTEGER FORMAT ">>>9":U INITIAL 0
      210        LABEL "&Масштаб"
      211        VIEW-AS FILL-IN
      212        SIZE 5.5 BY 1 NO-UNDO.
      213   DEFINE FRAME Dialog-Frame
      214        b-exit AT ROW 1 COL 1
      215        b-quit AT ROW 1 COL 11
      216        b-help AT ROW 1 COL 21
      217        fi-exch-date AT ROW 2.25 COL 17.5 COLON-ALIGNED
      218        b-choose-exch-date AT ROW 2.25 COL 32
      219        fi-exch-rate AT ROW 3.5 COL 17.5 COLON-ALIGNED
      220        fi-exch-scale AT ROW 4.75 COL 17.5 COLON-ALIGNED
      221        SPACE(19.12) SKIP(0.41)
      222       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      223            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      224            TITLE "Заголовок диалога"
      225            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit.
      226   ASSIGN
      227          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      228          FRAME Dialog-Frame:HIDDEN           = TRUE.
      229   ON GO OF FRAME Dialog-Frame
      230   DO:
      231     if p-enable-update = true
      232     then do:
      233       assign
      234         fi-exch-date
      235         fi-exch-rate
      236         fi-exch-scale
      237       .
      238       if p-enable-exch-date = true
      239       then do:
      240         assign
      241           p-exch-date = fi-exch-date
      242         .
      243       end.
      244       assign
      245         p-exch-rate  = fi-exch-rate
      246         p-exch-scale = fi-exch-scale
      247       .
      248       assign
      249         p-data-update = true
      250       .
      251     end.
      252   END.
      253   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      254   DO:
      255     APPLY "END-ERROR":U TO SELF.
      256   END.
      257   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      258   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      259   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      260   on help of frame Dialog-Frame
      261   do:
      262     run gbl/app_help.p
      263       (input this-procedure :file-name
      264       ,input ''
      265       ,input ?
      266       ) no-error.
      267     if error-status :error then do:
      268       message
      269         "Ошибка при вызове помощи"
      270         error-status :get-message(1)
      271         view-as alert-box .
      272     end.
      273   end.
      274   run minbtn-set in this-procedure .
      275   on choose of b-help in frame Dialog-Frame
      276   do:
      277     apply "help":u to frame Dialog-Frame .
      278   end.
      279   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      280   procedure minbtn-set :
      281       do
      282           on error undo, return error return-value
      283           :
      284           define variable ii              as integer       no-undo .
      285           define variable fh              as widget-handle no-undo .
      286           define variable hh              as widget-handle no-undo .
      287           define variable v-h             as handle        extent 4 no-undo .
      288           define variable v-name-button   as character     no-undo .
      289           define variable v-help-old-x    as decimal       no-undo .
      290           define variable v-help-old-y    as decimal       no-undo .
      291           define variable v-help-old-size as decimal       no-undo .
      292           define variable v-frame-width   as decimal       no-undo .
      293           define variable jj              as integer       no-undo .
      294           do
      295               on error undo, return error
      296               :
      297               assign
      298                   v-frame-width = frame Dialog-Frame:width - 0.3
      299                   fh            = frame Dialog-Frame:first-child
      300                   hh            = fh:first-child
      301                   ii            = 1
      302                   .
      303               do while valid-handle(hh):
      304                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      305                   do:
      306                       case lc(hh:name) :
      307                           when "b-help" then
      308                               do:
      309                                   hh:load-image-up("cmp/b-help.bmp":u) .
      310                                   hh:load-image-down("cmp/b-help.bmp":u) .
      311                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      312                                   hh:TOOLTIP = "Помощь" .
      313                                   v-help-old-x = hh:column .
      314                                   v-help-old-y = hh:row    .
      315                                   v-help-old-size = hh:width .
      316                                   hh:width-chars = 2.5 .
      317                               end.
      318                           when "b-print" then
      319                               do:
      320                                   hh:load-image("cmp/b-print.bmp":u) .
      321                                   hh:TOOLTIP = "Печать" .
      322                                   v-h[ii] = hh:handle .
      323                                   ii = ii + 1 .
      324                                   hh:width-chars = 3 .
      325                               end.
      326                           when "b-history" or
      327                           when "b-hist" then
      328                               do:
      329                                   hh:load-image("cmp/b-hist.bmp":u) .
      330                                   hh:TOOLTIP = "История" .
      331                                   v-h[ii] = hh:handle .
      332                                   ii = ii + 1 .
      333                                   hh:width-chars = 3 .
      334                               end.
      335                           when "b-sch" then
      336                               do:
      337                                   hh:load-image("cmp/b-sch.bmp":u) .
      338                                   hh:TOOLTIP = "Установка Фильтра" .
      339                                   v-h[ii] = hh:handle .
      340                                   ii = ii + 1 .
      341                                   hh:width-chars = 3 .
      342                               end.
      343                           when "b-hist-user" then
      344                               do:
      345                                   hh:load-image("cmp/b-hist.bmp":u) .
      346                                   hh:TOOLTIP = "История пользователя" .
      347                                   ii = ii + 1 .
      348                               end.
      349                       end case.
      350                   end.
      351                   hh = hh:next-sibling.
      352               end.
      353               b-help:column = v-frame-width - b-help:width-chars.
      354               jj = 0.
      355               repeat ii = 4 to 1 by -1 :
      356                   if valid-handle (v-h[ii] ) then
      357                   do:
      358                       jj  = jj + 1 .
      359                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      360                       v-h[ii]:row    = v-help-old-y .
      361                   end.
      362               end.
      363           end.
      364       end.
      365   end procedure.
      366   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      367   on ' ' of fi-exch-date in frame Dialog-Frame
      368   do:
