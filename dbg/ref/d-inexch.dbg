      548     return no-apply .
      549   end.
      550     define MENU m-ed-date5
      551       MENU-ITEM m-ed-date5-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
      552       MENU-ITEM m-ed-date5-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
      553       MENU-ITEM m-ed-date5-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
      554       MENU-ITEM m-ed-date5-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
      555       .
      556     if fi-exch-date :POPUP-MENU in frame Dialog-Frame = ?
      557     then do:
      558       ASSIGN
      559         fi-exch-date :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date5 :HANDLE
      560         fi-exch-date :MENU-MOUSE in frame Dialog-Frame = 3
      561       .
      562     end.
      563     define variable v-label-handle5 as handle no-undo .
      564     assign
      565       v-label-handle5 = fi-exch-date :side-label-handle in frame Dialog-Frame
      566     .
      567     if valid-handle (v-label-handle5)
      568     then do:
      569       if v-label-handle5 :tooltip = ""
      570       or v-label-handle5 :tooltip = ?
      571       then do:
      572         assign
      573           v-label-handle5 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
      574         .
      575       end.
      576     end.
      577     ON CHOOSE OF MENU-ITEM m-ed-date5-1 in menu m-ed-date5 DO:
      578       apply "ctrl-b":U to fi-exch-date in frame Dialog-Frame .
      579     END.
      580     ON CHOOSE OF MENU-ITEM m-ed-date5-2 in menu m-ed-date5 DO:
      581       apply "ctrl-d":U to fi-exch-date in frame Dialog-Frame .
      582     END.
      583     ON CHOOSE OF MENU-ITEM m-ed-date5-3 in menu m-ed-date5 DO:
      584       apply "ctrl-e":U to fi-exch-date in frame Dialog-Frame .
      585     END.
      586     ON CHOOSE OF MENU-ITEM m-ed-date5-4 in menu m-ed-date5 DO:
      587       apply "ctrl-f":U to fi-exch-date in frame Dialog-Frame .
      588     END.
      589   on choose of b-choose-exch-date in frame Dialog-Frame
      590   do:
      591     run sel-date in this-procedure
      592       (input fi-exch-date :handle
      593       ,input "Дата курса &1"
      594       ) .
      595   end.
      596   MAIN-BLOCK:
      597   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      598      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      599     assign
      600       frame Dialog-Frame :title = p-title
      601     .
      602     RUN enable_UI.
      603     display
      604       p-exch-date  @ fi-exch-date
      605       p-exch-rate  @ fi-exch-rate
      606       p-exch-scale @ fi-exch-scale
      607       with frame Dialog-Frame .
      608     if p-enable-update = true
      609     then do:
      610       if p-enable-exch-date = true
      611       then do:
      612         enable
      613           fi-exch-date
      614           b-choose-exch-date
      615           with frame Dialog-Frame .
      616       end.
      617       else do:
      618         assign
      619           fi-exch-date :fgcolor = BROWN_COLOR
      620         .
      621       end.
      622       enable
      623         fi-exch-rate
      624         fi-exch-scale
      625         with frame Dialog-Frame .
      626     end.
      627     else do:
      628       assign
      629         fi-exch-date  :fgcolor = BROWN_COLOR
      630         fi-exch-rate  :fgcolor = BROWN_COLOR
      631         fi-exch-scale :fgcolor = BROWN_COLOR
      632       .
      633       disable
      634         b-quit
      635         with frame Dialog-Frame .
      636       hide
      637         b-quit
      638         in frame Dialog-Frame .
      639       assign
      640         b-exit :label = "&Выход"
      641       .
      642     end.
      643     WAIT-FOR GO OF FRAME Dialog-Frame.
      644   END.
      645   RUN disable_UI.
      646   PROCEDURE disable_UI :
      647     HIDE FRAME Dialog-Frame.
      648   END PROCEDURE.
      649   PROCEDURE enable_UI :
      650     DISPLAY fi-exch-date fi-exch-rate fi-exch-scale
      651         WITH FRAME Dialog-Frame.
      652     ENABLE b-exit b-quit b-help
      653         WITH FRAME Dialog-Frame.
      654     VIEW FRAME Dialog-Frame.
      655   END PROCEDURE.
