      423     end.
      424     return no-apply.
      425   end.
      426   on ctrl-b of fi-exch-date in frame Dialog-Frame
      427   do:
      428     if (can-query (self, "sensitive")
      429        and
      430        self :sensitive = true
      431        )
      432     or (can-query (self, "read-only")
      433        and
      434        self :read-only = false
      435        )
      436     then do:
      437       if self :handle <> focus :handle
      438       then do:
      439         apply "entry":u to self .
      440       end.
      441       define variable v-curr-sv-date as date no-undo .
