      493           (input  v-curr-sv-date
      494           ,output v-new-sv-date
      495           ).
      496         assign
      497           self :screen-value = string(v-new-sv-date) .
      498         .
      499       end.
      500     end.
      501     return no-apply .
      502   end.
      503   on ctrl-f of fi-exch-date in frame Dialog-Frame
      504   do:
      505     if (can-query (self, "sensitive")
      506        and
      507        self :sensitive = true
      508        )
      509     or (can-query (self, "read-only")
      510        and
      511        self :read-only = false
      512        )
      513     then do:
      514       if self :handle <> focus :handle
      515       then do:
      516         apply "entry":u to self .
