      518       define variable v-ok            as logical   no-undo .
      519       define variable v-curr-sv-date  as date      no-undo .
      520       define variable v-description   as character no-undo .
      521       assign
      522         v-curr-sv-date = date(self :screen-value) no-error
      523       .
      524       if v-curr-sv-date = ?
      525       then do:
      526         run gbl/getcurdt.p
      527           (output v-curr-sv-date
      528           ) .
      529       end.
      530       if v-curr-sv-date <> ?
      531       then do:
      532         run gbl/d-inpday.w
      533           (input ?
