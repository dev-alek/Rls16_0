      450           ) .
      451       end.
      452       if v-curr-sv-date <> ?
      453       then do:
      454         assign
      455           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      456         .
      457         assign
      458           self :screen-value = string(v-new-sv-date) .
      459         .
      460       end.
      461     end.
      462     return no-apply .
      463   end.
      464   on ctrl-e of fi-exch-date in frame Dialog-Frame
      465   do:
      466     if (can-query (self, "sensitive")
      467        and
      468        self :sensitive = true
      469        )
      470     or (can-query (self, "read-only")
      471        and
      472        self :read-only = false
      473        )
      474     then do:
      475       if self :handle <> focus :handle
      476       then do:
      477         apply "entry":u to self .
      478       end.
      479       define variable v-curr-sv-date as date no-undo .
      480       define variable v-new-sv-date  as date no-undo .
      481       assign
      482         v-curr-sv-date = date(self :screen-value) no-error
      483       .
      484       if v-curr-sv-date = ?
      485       then do:
      486         run gbl/getcurdt.p
      487           (output v-curr-sv-date
      488           ) .
      489       end.
      490       if v-curr-sv-date <> ?
      491       then do:
