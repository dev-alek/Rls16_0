      397       .
      398     end.
      399     return no-apply.
      400   end.
      401   on ctrl-d of fi-exch-date in frame Dialog-Frame
      402   do:
      403     define variable v-curr-sv-date as date no-undo .
      404     if (can-query (self, "sensitive")
      405        and
      406        self :sensitive = true
      407        )
      408     or (can-query (self, "read-only")
      409        and
      410        self :read-only = false
      411        )
      412     then do:
      413       if self :handle <> focus :handle
      414       then do:
      415         apply "entry":u to self .
