     1176   procedure prn-lib-prn-file :
     1177     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1178     define input parameter p-DIsabledoptions as integer no-undo .
     1179     define variable v-report-name as character no-undo .
     1180     define variable v-user-action as character no-undo .
     1181     define variable v-printed     as logical   no-undo .
     1182     define variable v-exist       as logical   no-undo .
     1183     do
     1184       on error undo, return error
     1185       :
     1186       run prn-lib-get-report-name  in this-procedure (
     1187         input parParentProc
     1188         ,output v-report-name
     1189         ).
     1190   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1191   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1192     (input  v-report-name
     1193     ,input  2
     1194     ,output v-exist
     1195     )  .
     1196       if NOT v-exist then
     1197       DO:
     1198         Message
     1199           "Нет заданий на печать ! "
     1200           view-as alert-box .
     1201         Return  .
     1202       End.
     1203       run gbl/prnfilen.w
     1204         (input  ""
     1205         ,input  p-DisabledOptions
     1206         ,input  string(v-report-name )
     1207         ,input  7
     1208         ,output v-user-action
     1209         ,output v-printed
     1210         ) .
     1211       if v-printed then
     1212       do:
     1213         return "YES" .
     1214       end.
     1215       else
     1216       do:
     1217         return "NO" .
     1218       end.
     1219     end.
     1220   end procedure.
     1221   procedure prn-lib-open-stream :
     1222     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1223     define input parameter p-page-size    as integer no-undo .
     1224     define input parameter p-is-stream    as logical no-undo .
     1225     define input parameter p-append       as logical no-undo .
     1226     define variable v-report-name as character no-undo .
     1227     do
     1228       on error undo, return error
     1229       :
     1230       run prn-lib-get-report-name  in this-procedure (
     1231         input parParentProc
     1232         ,output v-report-name
     1233         ).
     1234       if p-is-stream then
     1235       do:
     1236         if p-append then
     1237         do:
     1238           output stream PrnLibStream to value( v-report-name )
     1239             page-size value(p-page-size) append .
     1240         end.
     1241         if not p-append then
     1242         do:
     1243           output stream PrnLibStream to value( v-report-name )
     1244             page-size value(p-page-size) .
     1245         end.
     1246       end.
     1247       if not p-is-stream then
     1248       do:
     1249         if p-append then
     1250         do:
     1251           output to value( v-report-name )
     1252             page-size value(p-page-size) append .
     1253         end.
     1254         if not p-append then
     1255         do:
     1256           output to value( v-report-name )
     1257             page-size value(p-page-size) .
     1258         end.
     1259       end.
     1260     end.
     1261   end procedure.
     1262   procedure prn-lib-open-exp :
     1263     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1264     define input parameter p-is-stream    as logical no-undo .
     1265     define input parameter p-is-append    as logical no-undo .
     1266     define output parameter p-ReportFileName as char init "report" no-undo.
     1267     define output parameter p-process as logical no-undo .
     1268     define variable glog as logical no-undo .
     1269     do
     1270       on error undo, return error
     1271       :
     1272       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1273         TITLE      "Укажите путь"
     1274         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1275         ASK-OVERWRITE
     1276         CREATE-TEST-FILE
     1277         SAVE-AS
     1278         USE-FILENAME
     1279         DEFAULT-EXTENSION "txt"
     1280         UPDATE glog
     1281         .
     1282       if not glog then  return.
     1283       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1284       if p-is-stream then
     1285       do:
     1286         if p-is-append then
     1287         do:
     1288           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1289         end.
     1290         else
     1291         do:
     1292           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1293         end.
     1294       end.
     1295       else
     1296       do:
     1297         if p-is-append then
     1298         do:
     1299           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1300         end.
     1301         else
     1302         do:
     1303           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1304         end.
     1305       end.
     1306       p-process = yes.
     1307     end.
     1308   end procedure.
     1309   procedure prn-lib-get-report-name :
     1310     define input parameter parParentProc  as widget-handle no-undo.
     1311     define output parameter p-report-name as character no-undo .
     1312     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1313   end procedure.
     1314   procedure prn-lib-reportviewer-report-name :
     1315     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1316     define input parameter p-report-name-html as character no-undo .
     1317     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1318   end procedure.
     1319   procedure prn-lib-reportviewer :
     1320     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1321     define input parameter p-report-name-html as character no-undo .
     1322     define input parameter p-param        as character no-undo .
     1323     define variable v-excel           as character no-undo init 'TRUE' .
     1324     define variable v-value-character as character no-undo .
     1325     define variable v-value-integer   as character no-undo .
     1326     define variable v-value-date      as date      no-undo .
     1327     define variable v-value-decimal   as decimal   no-undo .
     1328     define variable rep-excel         as logical   no-undo .
     1329     define variable excel-string      as character no-undo .
     1330     define variable v-param-type      as character no-undo .
     1331     define variable v-tth             as handle    no-undo .
     1332     run adm/shattri.p (
     1333       input "get":U
     1334       ,input  ""
     1335       ,input  0
     1336       ,input  'report-glob':U
     1337       ,input  'rep-excel':U
     1338       ,output v-value-character
     1339       ,output v-value-date
     1340       ,output v-value-decimal
     1341       ,output v-value-integer
     1342       ,output rep-excel
     1343       ,output v-param-type
     1344       ,INPUT-OUTPUT table-handle v-tth
     1345       )  .
     1346     if rep-excel then v-excel = "TRUE" .
     1347     else v-excel = "FALSE" .
     1348     if p-param eq ""
     1349     then
     1350        p-param = "EXCEL:" + v-excel.
     1351     else
     1352        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1353     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1354   end procedure.
     1355   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1356   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1357   procedure fltopend_fltopend :
     1358   define input parameter p-parent-handle as handle no-undo .
     1359   define input parameter p-qh as handle no-undo .
     1360   define input parameter p-flt-open-open-query  as character no-undo .
     1361   define input parameter p-where-cond as character no-undo .
     1362   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1363   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1364   define input parameter p-indexed-reposition as character no-undo .
     1365     do
     1366     on error undo, return error
     1367     :
     1368   define variable v-prepare-string as character no-undo .
     1369   define variable glog as logical no-undo .
     1370   assign
     1371   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1372                      p-where-cond + chr(32)  +
     1373                      p-use-indFIRST-query-tail + chr(32) +
     1374                      p-use-ind-sort-clmn-by + chr(32) +
     1375                      p-indexed-reposition
     1376   .
     1377   assign
     1378   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1379   if not glog
     1380   or error-status:error then do:
     1381     message error-status:get-message(1) view-as alert-box .
     1382     undo, return error .
     1383   end.
     1384   assign
     1385   glog = p-qh:query-open no-error .
     1386   if not glog
     1387   or error-status:error then do:
     1388     message error-status:get-message(1) view-as alert-box .
     1389     undo, return error .
     1390   end.
     1391     end.
     1392   end procedure.
     1393   procedure fltopend_fltfindd :
     1394   define input parameter p-parent-handle as handle no-undo .
     1395   define input parameter p-qh as handle no-undo .
     1396   define input parameter p-rowid as rowid no-undo .
     1397   define input parameter p-next as logical no-undo .
     1398   define input parameter p-lock as integer no-undo .
     1399   define input parameter p-bh as handle no-undo .
     1400   define input parameter p-where-cond as character no-undo .
     1401   define input parameter p-use-index-phrase as character no-undo .
     1402   define variable glog as logical no-undo .
     1403   define variable v-qh as handle no-undo .
     1404   define variable v-bh as handle no-undo .
     1405   define variable v-recid as recid no-undo .
     1406   define variable v-prepare-string as character no-undo .
     1407   do
     1408   on error undo, return error
     1409   on stop undo, return error
     1410   :
     1411     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1412     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1413     create query v-qh.
     1414     v-qh:set-buffers(v-bh).
     1415     v-prepare-string = substitute("for each &1 &2 &3"
     1416                                     ,v-bh:name
     1417                                     ,p-where-cond
     1418                                     ,p-use-index-phrase).
     1419     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1420     if not glog then do:
     1421       delete object v-qh.
     1422       delete object v-bh.
     1423       undo, return error .
     1424     end.
     1425     glog = v-qh:query-open no-error .
     1426     if not glog then do:
     1427       delete object v-qh.
     1428       delete object v-bh.
     1429       undo, return error .
     1430     end.
     1431     if p-next then do:
     1432       v-qh:reposition-to-rowid(p-rowid) no-error .
     1433       glog = v-qh:get-next( p-lock) no-error .
     1434       glog = v-qh:get-next( p-lock) no-error .
     1435       if not glog or v-qh:query-off-end = yes then do:
     1436         glog = v-qh:get-first( p-lock) no-error .
     1437       end.
     1438     end.
     1439     else do:
     1440       glog = v-qh:get-first( p-lock) no-error .
     1441     end.
     1442     v-recid = v-bh:recid no-error .
     1443     delete object v-qh.
     1444     delete object v-bh.
     1445     return string(v-recid) .
     1446   end.
     1447   end procedure.
     1448   procedure fltopend_fltfindq :
     1449   define input parameter p-parent-handle as handle no-undo .
     1450   define input parameter p-qh as handle no-undo .
     1451   define input parameter p-next as logical no-undo .
     1452   define input parameter p-lock as integer no-undo .
     1453   define input parameter p-flt-open-open-query  as character no-undo .
     1454   define input parameter p-where-cond as character no-undo .
     1455   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1456   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1457   define input parameter p-indexed-reposition as character no-undo .
     1458   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1459   define variable glog as logical no-undo .
     1460   define variable v-qh as handle no-undo .
     1461   define variable v-bh as handle no-undo extent 18.
     1462   define variable v-rowid as rowid no-undo extent 18.
     1463   define variable v-ii as integer no-undo .
     1464   define variable v-prepare-string as character no-undo .
     1465   do
     1466   on error undo, return error
     1467   on stop undo, return error
     1468   :
     1469     create query v-qh.
     1470     do v-ii = 1 to p-qh:num-buffers:
     1471       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1472       assign
     1473       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1474       no-error.
     1475       v-qh:add-buffer(v-bh[v-ii]).
     1476     end.
     1477     assign
     1478     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1479                       p-where-cond + chr(32)  +
     1480                       p-use-indFIRST-query-tail + chr(32) +
     1481                       p-use-ind-sort-clmn-by + chr(32) +
     1482                       p-indexed-reposition
     1483     .
     1484     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1485     if not glog then do:
     1486       delete object v-qh.
     1487       do v-ii = 1 to p-qh:num-buffers:
     1488         delete object v-bh[v-ii].
     1489       end.
     1490       undo, return error .
     1491     end.
     1492     glog = v-qh:query-open no-error .
     1493     if not glog then do:
     1494       delete object v-qh.
     1495       do v-ii = 1 to p-qh:num-buffers:
     1496         delete object v-bh[v-ii].
     1497       end.
     1498       undo, return error .
     1499     end.
     1500     if p-next then do:
     1501       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1502       glog = v-qh:get-next( p-lock) no-error .
     1503       glog = v-qh:get-next( p-lock) no-error .
     1504       if not glog or v-qh:query-off-end = yes then do:
     1505         glog = v-qh:get-first( p-lock) no-error .
     1506       end.
     1507     end.
     1508     else do:
     1509       glog = v-qh:get-first( p-lock) no-error .
     1510     end.
     1511     do v-ii = 1 to p-qh:num-buffers:
     1512       assign
     1513       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1514       no-error.
     1515     end.
     1516     delete object v-qh.
     1517     do v-ii = 1 to p-qh:num-buffers:
     1518       delete object v-bh[v-ii].
     1519     end.
     1520   end.
     1521   end procedure.
     1522   def var vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1523   define new global shared variable g#attr-lib  as handle no-undo .
     1524   define variable v-attr-lib-variable as handle no-undo .
     1525   procedure clntattr-code :
     1526     define input  parameter p-code           as character no-undo .
     1527     define output parameter p-type           as character no-undo .
