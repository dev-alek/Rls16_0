     3550           " " + sort-phrase-26
     3551           )
     3552         parameter-7-26 =
     3553           " indexed-reposition  "
     3554       .
     3555         run fltopend_fltfindq in this-procedure  (
     3556                             input this-procedure:handle
     3557                             ,input query br-cplgdsobj:handle
     3558                             ,input logical(parameter-2-26)
     3559                             ,input no-lock
     3560                             ,input parameter-3-26
     3561                             ,input parameter-4-26
     3562                             ,input parameter-5-26
     3563                             ,input parameter-6-26
     3564                             ,input parameter-7-26
     3565                             ,output v-fltopend-rowid
     3566                             ) no-error.
     3567         .
     3568         v-doc-rec = ?.
     3569       end.
     3570       assign
     3571         l-query-was-opened = true
     3572       .
     3573     end.
     3574   end.
     3575     run waitfram-hide in this-procedure .
     3576     END.
