      908   procedure userobjs_transfer :
      909     define input  parameter p-callback-handle as handle no-undo .
      910     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      911     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      912     do
      913     on error undo, return error return-value
      914     :
      915       if valid-handle(p-callback-handle) <> true
      916       then do:
      917         message
      918           vss-workfile vss-revision vss-description skip
      919           "Ошибка задания входных параметров" skip
      920           "Неизвестный указатель на процедуру" skip
      921           view-as alert-box error .
      922         undo, return error return-value .
      923       end.
      924       if p-callback-handle :get-signature("userobjs_append") = ""
      925       then do:
      926         message
      927           vss-workfile vss-revision vss-description skip
      928           "Ошибка задания входных параметров" skip
      929           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      930                     ,p-callback-handle :file-name
      931                     ) skip
      932           view-as alert-box error .
      933         undo, return error return-value .
      934       end.
      935       for each buf_userobjs_temp-user-obj
      936       on error undo, return error return-value
      937       :
      938         run userobjs_append in p-callback-handle
      939           (input  buf_userobjs_temp-user-obj.obj-type
      940           ,input  buf_userobjs_temp-user-obj.obj-code
      941           ) .
      942       end.
      943     end.
      944   end procedure.
