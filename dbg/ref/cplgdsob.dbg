      866   procedure userobjs_append :
      867      define input  parameter p-obj-type as character no-undo .
      868      define input  parameter p-obj-code as integer   no-undo .
      869     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      870     do
      871     on error undo, return error return-value
      872     :
      873       find first buf_userobjs_temp-user-obj
      874         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      875           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      876         no-error .
      877       if not available buf_userobjs_temp-user-obj
      878       then do:
      879         create buf_userobjs_temp-user-obj .
      880         assign
      881           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      882           buf_userobjs_temp-user-obj.obj-code = p-obj-code
