     2995   RUN disable_UI.
     2996   PROCEDURE check-parameters :
     2997   define variable v-obj-type like ub.clients.obj-type no-undo .
     2998     define variable v-obj-code like ub.clients.obj-code no-undo .
     2999     define buffer buf_clients for ub.clients .
     3000     define buffer buf_goods   for ub.goods .
     3001     define buffer buf_place  for ub.place .
     3002     define variable v-host-code   as integer   no-undo .
     3003     define variable v-user-select as logical   no-undo .
     3004     do for buf_clients, buf_goods
     3005     on error undo, return error return-value
     3006     :
     3007       if  p-obj-type = ""
     3008       and p-obj-code = 0
     3009       then do:
     3010         message
     3011           "Текущий объект не задан" skip
     3012           "Выберите объект" skip
     3013           view-as alert-box information .
     3014   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3015   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3016     (input  p-obj-type
     3017     ,input  p-obj-code
     3018     ,output v-host-code
     3019     )  .
     3020   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3021   run userobjs_select-one in this-procedure
     3022     (input  parparentproc
     3023     ,input  v-cntxt-db-num
     3024     ,input  v-cntxt-userid
     3025     ,input  v-host-code
     3026     ,input  p-obj-type
     3027     ,input  p-obj-code
     3028     ,output v-user-select
     3029     ,output v-obj-type
     3030     ,output v-obj-code
     3031     )  .
     3032         if v-user-select <> true
     3033         then do:
     3034           undo, return error "Объект не выбран" .
     3035         end.
     3036         assign
     3037         p-obj-type = v-obj-type
     3038         p-obj-code = v-obj-code
     3039         .
     3040       end.
     3041       find first buf_clients no-lock
     3042         where buf_clients.obj-type = p-obj-type
     3043           and buf_clients.obj-code = p-obj-code
     3044         no-error .
     3045       if not available buf_clients
     3046       then do:
     3047         message
     3048           vss-workfile vss-revision vss-description skip
     3049           "Ошибка задания входных параметров" skip
     3050           "Объект не найден" skip
     3051           "Объект" p-obj-type p-obj-code skip
     3052           "Код товара" p-gds-code skip
     3053           view-as alert-box error .
     3054         undo, return error return-value .
     3055       end.
     3056       IF p-mode = 'one' THEN DO:
     3057           find first buf_goods no-lock
     3058             where buf_goods.gds-code = p-gds-code
     3059             no-error .
     3060           if not available buf_goods
     3061           then do:
     3062             message
     3063               vss-workfile vss-revision vss-description skip
     3064               "Ошибка задания входных параметров" skip
     3065               "Объект" p-obj-type p-obj-code skip
     3066               "Код товара" p-gds-code skip
     3067               view-as alert-box error .
     3068             undo, return error return-value .
     3069           end.
     3070       END.
     3071       find first buf_place no-lock
     3072         where buf_place.obj-type = p-obj-type
     3073           AND buf_place.obj-code = p-obj-code
     3074           AND buf_place.pl-code = p-pl-code
     3075         no-error .
     3076       if not available buf_place
     3077       then do:
     3078         message
     3079           vss-workfile vss-revision vss-description skip
     3080           "Ошибка задания входных параметров" skip
     3081           "Объект" p-obj-type p-obj-code skip
     3082           "Код складского места" p-pl-code skip
     3083           view-as alert-box error .
     3084         undo, return error return-value .
     3085       end.
     3086       do with frame Dialog-Frame:
     3087         if available buf_clients then do:
     3088         assign
     3089           fi-obj = substitute('&1 &2 &3':u
     3090                              ,buf_clients.obj-type
     3091                              ,buf_clients.obj-code
     3092                              ,buf_clients.obj-name
     3093                              ).
     3094         end.
     3095         if available buf_goods then do:
     3096           fi-gds = substitute('&1 &2 &3 &4':u
     3097                              ,buf_goods.artic
     3098                              ,buf_goods.prod-type
     3099                              ,buf_goods.prod-code
     3100                              ,buf_goods.gds-name
     3101                              )
     3102           .
     3103         end.
     3104       end.
     3105     end.
     3106   END PROCEDURE.
     3107   PROCEDURE disable_UI :
     3108     HIDE FRAME Dialog-Frame.
     3109   END PROCEDURE.
     3110   PROCEDURE display-doc :
     3111     define input  parameter p-doc-type as character no-undo .
     3112     define input  parameter p-doc-code as character no-undo .
     3113     define buffer buf_goods for ub.goods .
     3114     define buffer buf_trn-doc for ub.trn-doc.
     3115     define buffer buf_c-trn-doc for ub.c-trn-doc.
     3116     do
     3117     on error undo, return error return-value
     3118     :
     3119       find first buf_goods no-lock
     3120         where buf_goods.gds-code = p-gds-code
     3121         no-error .
     3122       if not available buf_goods
     3123       then do:
     3124         message
     3125           vss-workfile vss-revision vss-description skip
     3126           "Внутренняя ошибка" skip
     3127           "Не найден товар" skip
     3128           "Код товара" p-gds-code skip
     3129           view-as alert-box error .
     3130         undo, return error return-value .
     3131       end.
     3132       case p-doc-type
     3133       :
     3134         when 'trn-doc':U
     3135         then do:
     3136           find first buf_trn-doc no-lock where
     3137                     buf_trn-doc.doc-code = p-doc-code no-error .
     3138           if available buf_trn-doc then do:
     3139             run str/showdoc.p
     3140               (input parparentproc
     3141               ,input p-doc-code
     3142               ,input buf_goods.artic
     3143               ,input buf_goods.prod-type
     3144               ,input buf_goods.prod-code
     3145               ,input true
     3146               ) .
     3147           end.
     3148           else do:
     3149             for each buf_c-trn-doc no-lock where
     3150                       buf_c-trn-doc.doc-code = p-doc-code
     3151                   AND buf_c-trn-doc.is-del = yes :
     3152               run str/c-doc.w ( input parparentproc, input buf_c-trn-doc.doc-code, input buf_c-trn-doc.chip-num ).
     3153               leave.
     3154             end.
     3155             if not available buf_c-trn-doc then do:
     3156               message
     3157                 vss-workfile vss-revision vss-description skip
     3158                 "Документ не может быть показан" skip
     3159                 "Тип документа" p-doc-type skip
     3160                 "Код документа" p-doc-code skip
     3161                 view-as alert-box error .
     3162             end.
     3163           end.
     3164         end.
     3165         when 'price-doc':U
     3166         then do:
     3167           run str/showdoc.p
     3168             (input parparentproc
     3169             ,input p-doc-code
     3170             ,input buf_goods.artic
     3171             ,input buf_goods.prod-type
     3172             ,input buf_goods.prod-code
     3173             ,input false
     3174             ) .
     3175         end.
     3176         otherwise do:
     3177           message
     3178             vss-workfile vss-revision vss-description skip
     3179             "Документ не может быть показан" skip
     3180             "Тип документа" p-doc-type skip
     3181             "Код документа" p-doc-code skip
     3182             view-as alert-box error .
     3183         end.
     3184       end.
     3185     end.
     3186   END PROCEDURE.
     3187   PROCEDURE display-record :
     3188     define variable v-gds-is-twounit as logical   no-undo .
     3189     define buffer buf_goods for ub.goods .
     3190     define buffer buf_currency for ub.currency .
     3191     define variable v-host-code as integer   no-undo .
     3192     define variable v-base-code as integer   no-undo .
     3193     do
     3194     on error undo, return error return-value
     3195     :
     3196       IF NOT AVAILABLE X_c-pl-gds-obj THEN DO:
     3197           assign
     3198           ub.c-pl-gds-obj.fact-qnty:visible in frame Dialog-Frame = no
     3199           ub.c-pl-gds-obj.old-fact-qnty:visible in frame Dialog-Frame = no
     3200           ub.c-pl-gds-obj.cli-qnty:visible in frame Dialog-Frame = no
     3201           ub.c-pl-gds-obj.old-cli-qnty:visible in frame Dialog-Frame = no
     3202           ub.c-pl-gds-obj.free-qnty:visible in frame Dialog-Frame = no
     3203           ub.c-pl-gds-obj.old-free-qnty:visible in frame Dialog-Frame = no
     3204           .
     3205       END.
     3206       else do:
     3207   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscdat in g#library
     3208     (input  X_c-pl-gds-obj.gds-code
     3209     ,input  'twounit=request':u
     3210     ,output v-gds-is-twounit
     3211     ) no-error .
     3212         if error-status :error
     3213         then do:
     3214           message
     3215             vss-workfile vss-revision vss-description skip
     3216             "Ошибка при определении атрибута товара" skip
     3217             "Атрибут" 'twounit=request':u skip
     3218             "Код товара" X_c-pl-gds-obj.gds-code skip
     3219             view-as alert-box error .
     3220           undo, return error return-value .
     3221         end.
     3222         find first buf_goods no-lock
     3223           where buf_goods.gds-code = X_c-pl-gds-obj.gds-code
     3224           .
     3225         display
     3226           buf_goods.unit-base @ fi-fact-qnty-descr
     3227           with frame Dialog-Frame .
     3228         if v-gds-is-twounit = true
     3229         then do:
     3230           display
     3231             buf_goods.unit-cli  @ fi-cli-qnty-descr
     3232             with frame Dialog-Frame .
     3233         end.
     3234   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3235   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3236     (input  p-obj-type
     3237     ,input  p-obj-code
     3238     ,output v-host-code
     3239     )  .
     3240   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3241   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     3242     (input  v-host-code
     3243     ,output v-base-code
     3244     )  .
     3245         do with frame Dialog-Frame:
     3246           if v-gds-is-twounit = true
     3247           then do:
     3248             assign
     3249               c-pl-gds-obj.cli-qnty     :visible = true
     3250               c-pl-gds-obj.old-cli-qnty :visible = true
     3251             .
     3252           end.
     3253           else do:
     3254             assign
     3255               c-pl-gds-obj.cli-qnty     :visible = false
     3256               c-pl-gds-obj.old-cli-qnty :visible = false
     3257             .
     3258           end.
     3259         end.
     3260       end.
     3261       if available X_c-pl-gds-obj
     3262       then do:
     3263         display
     3264           X_c-pl-gds-obj.fact-qnty     @ c-pl-gds-obj.fact-qnty
     3265           X_c-pl-gds-obj.old-fact-qnty @ c-pl-gds-obj.old-fact-qnty
     3266           X_c-pl-gds-obj.free-qnty     @ c-pl-gds-obj.free-qnty
     3267           X_c-pl-gds-obj.old-free-qnty @ c-pl-gds-obj.old-free-qnty
     3268           with frame Dialog-Frame .
     3269         if v-gds-is-twounit = true
     3270         then do:
     3271           display
     3272             X_c-pl-gds-obj.cli-qnty      @ c-pl-gds-obj.cli-qnty
     3273             X_c-pl-gds-obj.old-cli-qnty  @ c-pl-gds-obj.old-cli-qnty
     3274             with frame Dialog-Frame .
     3275         end.
     3276       end.
     3277       else do:
     3278         display
     3279           0 @ c-pl-gds-obj.fact-qnty
     3280           0 @ c-pl-gds-obj.old-fact-qnty
     3281           0 @ c-pl-gds-obj.cli-qnty
     3282           0 @ c-pl-gds-obj.old-cli-qnty
     3283           with frame Dialog-Frame .
     3284         if v-gds-is-twounit = true
     3285         then do:
     3286           display
     3287             0 @ c-pl-gds-obj.cli-qnty
     3288             0 @ c-pl-gds-obj.old-cli-qnty
     3289             with frame Dialog-Frame .
     3290         end.
     3291       end.
     3292     end.
     3293   END PROCEDURE.
     3294   PROCEDURE enable_UI :
     3295     OPEN QUERY Dialog-Frame FOR EACH X_c-pl-gds-obj NO-LOCK.
     3296     GET FIRST Dialog-Frame.
     3297     DISPLAY sch-gds-code sch-corr-date sch-source-ref sch-corr-user-name fi-obj
     3298             fi-gds fi-place fi-fact-qnty-descr fi-cli-qnty-descr
     3299             fi-free-qnty-descr
     3300         WITH FRAME Dialog-Frame.
     3301     IF AVAILABLE ub.c-pl-gds-obj THEN
     3302       DISPLAY ub.c-pl-gds-obj.fact-qnty ub.c-pl-gds-obj.old-fact-qnty
     3303             ub.c-pl-gds-obj.cli-qnty ub.c-pl-gds-obj.old-cli-qnty
     3304             ub.c-pl-gds-obj.free-qnty ub.c-pl-gds-obj.old-free-qnty
     3305         WITH FRAME Dialog-Frame.
     3306     ENABLE b-exit b-show-doc B-print B-sch b-help BR-cplgdsobj sch-gds-code
     3307            sch-corr-date sch-source-ref sch-corr-user-name fi-obj fi-gds fi-place
     3308            ub.c-pl-gds-obj.fact-qnty fi-fact-qnty-descr
     3309            ub.c-pl-gds-obj.old-fact-qnty ub.c-pl-gds-obj.cli-qnty
     3310            fi-cli-qnty-descr ub.c-pl-gds-obj.old-cli-qnty
     3311            ub.c-pl-gds-obj.free-qnty fi-free-qnty-descr
     3312            ub.c-pl-gds-obj.old-free-qnty
     3313         WITH FRAME Dialog-Frame.
     3314     VIEW FRAME Dialog-Frame.
     3315     run OpenBr in this-procedure ( input YES,        input NO,        input NO).
     3316   END PROCEDURE.
     3317   PROCEDURE MyEnable :
     3318   DISPLAY
