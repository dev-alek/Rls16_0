     1046   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1047   procedure fltopend_fltopend :
     1048   define input parameter p-parent-handle as handle no-undo .
     1049   define input parameter p-qh as handle no-undo .
     1050   define input parameter p-flt-open-open-query  as character no-undo .
     1051   define input parameter p-where-cond as character no-undo .
     1052   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1053   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1054   define input parameter p-indexed-reposition as character no-undo .
     1055     do
     1056     on error undo, return error
     1057     :
     1058   define variable v-prepare-string as character no-undo .
     1059   define variable glog as logical no-undo .
     1060   assign
     1061   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1062                      p-where-cond + chr(32)  +
     1063                      p-use-indFIRST-query-tail + chr(32) +
     1064                      p-use-ind-sort-clmn-by + chr(32) +
     1065                      p-indexed-reposition
     1066   .
     1067   assign
     1068   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1069   if not glog
     1070   or error-status:error then do:
     1071     message error-status:get-message(1) view-as alert-box .
     1072     undo, return error .
     1073   end.
     1074   assign
     1075   glog = p-qh:query-open no-error .
     1076   if not glog
     1077   or error-status:error then do:
     1078     message error-status:get-message(1) view-as alert-box .
     1079     undo, return error .
     1080   end.
     1081     end.
     1082   end procedure.
     1083   procedure fltopend_fltfindd :
     1084   define input parameter p-parent-handle as handle no-undo .
     1085   define input parameter p-qh as handle no-undo .
     1086   define input parameter p-rowid as rowid no-undo .
     1087   define input parameter p-next as logical no-undo .
     1088   define input parameter p-lock as integer no-undo .
     1089   define input parameter p-bh as handle no-undo .
     1090   define input parameter p-where-cond as character no-undo .
     1091   define input parameter p-use-index-phrase as character no-undo .
     1092   define variable glog as logical no-undo .
     1093   define variable v-qh as handle no-undo .
     1094   define variable v-bh as handle no-undo .
     1095   define variable v-recid as recid no-undo .
     1096   define variable v-prepare-string as character no-undo .
     1097   do
     1098   on error undo, return error
     1099   on stop undo, return error
     1100   :
     1101     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1102     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1103     create query v-qh.
     1104     v-qh:set-buffers(v-bh).
     1105     v-prepare-string = substitute("for each &1 &2 &3"
     1106                                     ,v-bh:name
     1107                                     ,p-where-cond
     1108                                     ,p-use-index-phrase).
     1109     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1110     if not glog then do:
     1111       delete object v-qh.
     1112       delete object v-bh.
     1113       undo, return error .
     1114     end.
     1115     glog = v-qh:query-open no-error .
     1116     if not glog then do:
     1117       delete object v-qh.
     1118       delete object v-bh.
     1119       undo, return error .
     1120     end.
     1121     if p-next then do:
     1122       v-qh:reposition-to-rowid(p-rowid) no-error .
     1123       glog = v-qh:get-next( p-lock) no-error .
     1124       glog = v-qh:get-next( p-lock) no-error .
     1125       if not glog or v-qh:query-off-end = yes then do:
     1126         glog = v-qh:get-first( p-lock) no-error .
     1127       end.
     1128     end.
     1129     else do:
     1130       glog = v-qh:get-first( p-lock) no-error .
     1131     end.
     1132     v-recid = v-bh:recid no-error .
     1133     delete object v-qh.
     1134     delete object v-bh.
     1135     return string(v-recid) .
     1136   end.
     1137   end procedure.
     1138   procedure fltopend_fltfindq :
     1139   define input parameter p-parent-handle as handle no-undo .
     1140   define input parameter p-qh as handle no-undo .
     1141   define input parameter p-next as logical no-undo .
     1142   define input parameter p-lock as integer no-undo .
     1143   define input parameter p-flt-open-open-query  as character no-undo .
     1144   define input parameter p-where-cond as character no-undo .
     1145   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1146   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1147   define input parameter p-indexed-reposition as character no-undo .
     1148   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1149   define variable glog as logical no-undo .
     1150   define variable v-qh as handle no-undo .
     1151   define variable v-bh as handle no-undo extent 18.
     1152   define variable v-rowid as rowid no-undo extent 18.
     1153   define variable v-ii as integer no-undo .
     1154   define variable v-prepare-string as character no-undo .
     1155   do
     1156   on error undo, return error
     1157   on stop undo, return error
     1158   :
     1159     create query v-qh.
     1160     do v-ii = 1 to p-qh:num-buffers:
     1161       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1162       assign
     1163       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1164       no-error.
     1165       v-qh:add-buffer(v-bh[v-ii]).
     1166     end.
     1167     assign
     1168     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1169                       p-where-cond + chr(32)  +
     1170                       p-use-indFIRST-query-tail + chr(32) +
     1171                       p-use-ind-sort-clmn-by + chr(32) +
     1172                       p-indexed-reposition
     1173     .
     1174     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1175     if not glog then do:
     1176       delete object v-qh.
     1177       do v-ii = 1 to p-qh:num-buffers:
     1178         delete object v-bh[v-ii].
     1179       end.
     1180       undo, return error .
     1181     end.
     1182     glog = v-qh:query-open no-error .
     1183     if not glog then do:
     1184       delete object v-qh.
     1185       do v-ii = 1 to p-qh:num-buffers:
     1186         delete object v-bh[v-ii].
     1187       end.
     1188       undo, return error .
     1189     end.
     1190     if p-next then do:
     1191       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1192       glog = v-qh:get-next( p-lock) no-error .
     1193       glog = v-qh:get-next( p-lock) no-error .
     1194       if not glog or v-qh:query-off-end = yes then do:
     1195         glog = v-qh:get-first( p-lock) no-error .
     1196       end.
     1197     end.
     1198     else do:
     1199       glog = v-qh:get-first( p-lock) no-error .
     1200     end.
     1201     do v-ii = 1 to p-qh:num-buffers:
     1202       assign
     1203       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1204       no-error.
     1205     end.
     1206     delete object v-qh.
     1207     do v-ii = 1 to p-qh:num-buffers:
     1208       delete object v-bh[v-ii].
     1209     end.
     1210   end.
     1211   end procedure.
     1212   define variable v-doc-type  as character no-undo format "X(10)" column-label "Тип".
     1213   define variable v-diff-qnty as decimal   no-undo format "->>,>>>,>>9.<<<" column-label "Разница" .
