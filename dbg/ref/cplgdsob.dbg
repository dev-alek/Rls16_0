     3508         parameter-4-26 =
     3509           "where ":u +  substitute(' X_c-pl-gds-obj.obj-type = &1&2&1 and X_c-pl-gds-obj.obj-code = &3                             AND X_c-pl-gds-obj.pl-code = &4 ', chr(34), p-obj-type, p-obj-code, p-pl-code) + " ":u + where-phrase-26 + " ":u + p-find-condition + " " + ""
     3510         parameter-5-26 = " "
     3511       .
     3512         run fltopend_fltfindd in this-procedure  (
     3513                             input this-procedure:handle
     3514                             ,input query br-cplgdsobj:handle
     3515                             ,input rowid(X_c-pl-gds-obj)
     3516                             ,input logical(parameter-2-26)
     3517                             ,input no-lock
     3518                             ,input (buffer X_c-pl-gds-obj:handle)
     3519                             ,input parameter-4-26
     3520                             ,input parameter-5-26
     3521                             ) no-error.
     3522         .
     3523         assign
     3524           v-doc-rec = integer(return-value)
     3525           v-fltopend-rowid[1] = ?
     3526         .
     3527       end.
     3528       else do:
     3529         assign
     3530         parameter-2-26 = (if p-find-next then "true":u else "false":u )
     3531         parameter-3-26 =  "FOR EACH X_c-pl-gds-obj"
     3532         parameter-4-26 =
     3533           (
     3534             if ("                           X_c-pl-gds-obj.obj-type = p-obj-type and X_c-pl-gds-obj.obj-code = p-obj-code                             AND X_c-pl-gds-obj.pl-code = p-pl-code " + " " + where-phrase-26) <> ""
     3535             then  substitute(' X_c-pl-gds-obj.obj-type = &1&2&1 and X_c-pl-gds-obj.obj-code = &3                             AND X_c-pl-gds-obj.pl-code = &4 ', chr(34), p-obj-type, p-obj-code, p-pl-code) + " " + where-phrase-26
     3536             else "true"
     3537           )
     3538         parameter-5-26 = (" " + "" + " " + "" + " " + p-find-condition)
     3539         parameter-6-26 = if sort-phrase-26 = ''
     3540                              then
     3541           (
     3542           " " + " " +
     3543             " " + sort-column-phrase +
     3544           " " + " by X_c-pl-gds-obj.gds-code by X_c-pl-gds-obj.chip-num descending "
     3545           )
