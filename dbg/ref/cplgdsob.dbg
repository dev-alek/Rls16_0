     1335              VIEW-AS TEXT
     1336             SIZE 13 BY .67
     1337             FGCOLOR 4
     1338        ub.c-pl-gds-obj.free-qnty AT ROW 20.63 COL 16.5 COLON-ALIGNED
     1339             LABEL "Своб-но"
     1340              VIEW-AS TEXT
