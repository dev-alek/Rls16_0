     2970   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2971     run mainmenu_getcntxt in parparentproc
     2972       (output v-cntxt-db-num
     2973       ,output v-cntxt-userid
