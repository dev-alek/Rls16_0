     3354   PROCEDURE OpenBr :
     3355   define input  parameter p-open-query     as logical   no-undo .
     3356   define input  parameter p-find-next      as logical   no-undo .
     3357   define input  parameter p-find-condition as character no-undo .
     3358   def var l-query-was-opened as logical no-undo .
     3359   define variable v-title as character no-undo .
     3360   define variable title0 as character no-undo.
     3361   title0 = "История остатков по складским местам" + chr(32).
     3362   def var sort-column-phrase as character no-undo .
     3363   case sort-column-name :
     3364     when "" then do:
     3365       assign
     3366         sort-column-phrase = ""
     3367       .
     3368     end.
     3369     otherwise do:
     3370       assign
     3371         sort-column-phrase = "by " + sort-column-name
     3372       .
     3373     end.
     3374   end case.
     3375   define variable l-open-query as logical   no-undo .
     3376   CASE p-mode :
     3377     WHEN 'place':U THEN DO:
     3378         assign
     3379         filter-point = filter-point0 + p-mode
     3380         filter-label = substitute("&1 Одно скл.место", filter-label0)
     3381         .
     3382       if p-open-query then do:
     3383         ASSIGN
     3384         frame Dialog-Frame:TITLE = title0 + substitute("Объект &1&2 Остатки товаров на складском месте &3"
     3385                                                           ,p-obj-type
     3386                                                           ,p-obj-code
     3387                                                           ,p-pl-code
     3388                                                         ).
     3389       end.
     3390   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3391   define variable  l-disable-where-26  as logical   no-undo .
     3392   define variable  l-filter-open-26    as logical   .
     3393   define variable  flt-rec-26       as recid     no-undo .
     3394   define variable  filter-name-26      as character no-undo .
     3395   define variable  where-phrase-26     as character no-undo .
     3396   define variable  sort-phrase-26      as character no-undo .
     3397   define variable  where-phrase-rus-26 as character no-undo .
     3398   define variable  sort-phrase-rus-26  as character no-undo .
     3399     run waitfram-show in this-procedure
     3400       (input "ЖДИТЕ ..."
     3401       ).
     3402   run gbl/flt-get.p
     3403     (input filter-point
     3404     ,output flt-rec-26
     3405     ,output filter-name-26
     3406     ,output where-phrase-26
     3407     ,output sort-phrase-26
     3408     ,output where-phrase-rus-26
     3409     ,output sort-phrase-rus-26
     3410     ).
     3411   if p-open-query then do:
     3412       run set-filter-name in this-procedure
     3413         (INPUT filter-name-26
     3414         ) no-error .
     3415     assign
     3416       l-filter-open-26 = false
     3417     .
     3418     if flt-rec-26 <> ?
     3419       or sort-column-phrase > ""
     3420     then do:
     3421       define variable  parameter-2-26 as character no-undo .
     3422       define variable  parameter-3-26 as character no-undo .
     3423       define variable  parameter-4-26 as character no-undo .
     3424       define variable  parameter-5-26 as character no-undo .
     3425       define variable  parameter-6-26 as character no-undo .
     3426       define variable  parameter-7-26 as character no-undo .
     3427         assign
     3428         parameter-3-26 =
     3429                                 "FOR EACH X_c-pl-gds-obj"
     3430         parameter-4-26 =
     3431           (
     3432             if ("                           X_c-pl-gds-obj.obj-type = p-obj-type and X_c-pl-gds-obj.obj-code = p-obj-code                             AND X_c-pl-gds-obj.pl-code = p-pl-code " + " " + where-phrase-26) <> ""
     3433             then  substitute(' X_c-pl-gds-obj.obj-type = &1&2&1 and X_c-pl-gds-obj.obj-code = &3                             AND X_c-pl-gds-obj.pl-code = &4 ', chr(34), p-obj-type, p-obj-code, p-pl-code) + " " + where-phrase-26
     3434             else "true"
     3435           )
     3436         parameter-5-26 = (" " + "" + " " + "")
     3437         parameter-6-26 = if sort-phrase-26 = ''
     3438                              then
     3439           (
     3440           " " + " " +
     3441             " " + sort-column-phrase +
     3442           " " + " by X_c-pl-gds-obj.gds-code by X_c-pl-gds-obj.chip-num descending "
     3443           )
     3444                              else
     3445           (
     3446           " " + " " +
     3447             " " + sort-column-phrase +
     3448           " " + sort-phrase-26
     3449           )
     3450         parameter-7-26 =
     3451           " indexed-reposition  "
     3452       .
     3453       do
     3454       on stop undo, leave
     3455       on error undo, leave
     3456       :
     3457         assign
     3458           l-disable-where-26 =
     3459             ("                           X_c-pl-gds-obj.obj-type = p-obj-type and X_c-pl-gds-obj.obj-code = p-obj-code                             AND X_c-pl-gds-obj.pl-code = p-pl-code " + " " + where-phrase-26 = "")
     3460         .
     3461         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3462                             ,input query br-cplgdsobj:handle
     3463                             ,input parameter-3-26
     3464                             ,input parameter-4-26
     3465                             ,input parameter-5-26
     3466                             ,input parameter-6-26
     3467                             ,input parameter-7-26
     3468                             )
     3469         .
     3470         assign
     3471           l-filter-open-26 = true
     3472         .
     3473       end.
     3474       if l-filter-open-26 = false then do:
     3475         message
     3476           "Ошибка при фильтрации / сортировке" skip
     3477           "Будут показаны записи без учета фильтра" skip
     3478           view-as alert-box .
     3479       end.
     3480       else do:
     3481           assign
     3482             l-query-was-opened = true
     3483           .
     3484       end.
     3485     end.
     3486     if l-filter-open-26 = false then do:
     3487       OPEN QUERY br-cplgdsobj FOR EACH X_c-pl-gds-obj
     3488         where                            X_c-pl-gds-obj.obj-type = p-obj-type and X_c-pl-gds-obj.obj-code = p-obj-code                             AND X_c-pl-gds-obj.pl-code = p-pl-code
     3489          by X_c-pl-gds-obj.gds-code by X_c-pl-gds-obj.chip-num descending
     3490         indexed-reposition
     3491     .
     3492         assign
     3493           l-query-was-opened = true
     3494         .
     3495     end.
     3496   end.
     3497   else do:
     3498     assign
     3499       v-doc-rec = recid( X_c-pl-gds-obj )
     3500     .
     3501     do
     3502     on stop undo, leave
     3503     on error undo, leave
