     3770       assign
     3771         l-query-was-opened = true
     3772       .
     3773     end.
     3774   end.
     3775     run waitfram-hide in this-procedure .
     3776     END.
     3777   END CASE.
     3778   if not p-open-query  and v-doc-rec <> ? then
     3779   REPOSITION br-cplgdsobj to recid v-doc-rec No-ERROR.
     3780   if not p-open-query and v-fltopend-rowid[1] <> ? then
     3781   query br-cplgdsobj:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     3782   run waitfram-hide in this-procedure .
     3783   APPLY "VALUE-CHANGED" TO br-cplgdsobj in frame Dialog-Frame.
     3784   APPLY "ENTRY" TO br-cplgdsobj.
     3785   END PROCEDURE.
     3786   PROCEDURE proc-b-print :
     3787   def var date_string     as      char    no-undo.
     3788   def var Line                as      char    no-undo.
     3789   def var for-time as char.
     3790   def var accum-count as integer.
     3791   define variable v-doc-rec as recid no-undo.
     3792   define variable v-prod as character no-undo .
     3793   define variable v-upd-time as character no-undo .
     3794   define variable v-obj as character no-undo .
     3795   define variable v-action-chr as character no-undo .
     3796   DEFINE VARIABLE v-for-user-name AS CHARACTER NO-UNDO.
     3797   DEFINE FRAME HistoryList
     3798   X_c-pl-gds-obj.gds-code COLUMN-LABEL "Код товара"
     3799   X_c-pl-gds-obj.pl-code COLUMN-LABEL "Код скл.!места"
     3800   X_c-pl-gds-obj.old-fact-qnty COLUMN-LABEL "Количество!было"
     3801   X_c-pl-gds-obj.fact-qnty COLUMN-LABEL "Количество!стало"
     3802   v-action-chr FORMAT "X(10)" COLUMn-LABEL "Действие"
     3803   X_c-pl-gds-obj.source-ref COLUMn-LABEL "№"
     3804   X_c-pl-gds-obj.corr-date
     3805   v-upd-time COLUMN-LABEL "Время изм." FORMAT "X(8)"
     3806   v-for-user-name  column-label "Изменил" format "X(18)"
     3807   X_c-pl-gds-obj.corr-user-db-num
     3808   v-obj COLUMN-LABEL "Объект" FORMAT "X(8)"
     3809   HEADER  date_string AT 5 format "X(35)"
     3810   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     3811   Line format "X(195)" AT 1
     3812   with width 232 down stream-io use-text    .
     3813   Line = fill("-", 195).
     3814   date_string = cur-time-print() .
     3815   assign
     3816   v-doc-rec = recid( X_c-pl-gds-obj ).
     3817   DO WHILE available X_c-pl-gds-obj :
     3818         GET prev br-cplgdsobj.
     3819   END.
     3820   run prn-lib-open-stream  in this-procedure (
     3821                                                input parparentProc
     3822                                               ,input 43
     3823                                               ,input yes
     3824                                               ,input no
     3825                                               ).
     3826   PUT  STREAM PrnLibStream
     3827   SPACE(25) ( frame Dialog-Frame:title )
     3828   format "x(90)" SKIP(1) .
     3829   FORM HEADER
     3830   Line format "X(180)" AT 1 SKIP
     3831   "Продолжение - на следующей странице" AT 30 SKIP
     3832   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3833   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3834   FORM with FRAME HistoryList  .
     3835   run waitfram-show in this-procedure ( input "Ждите...").
     3836     GET next br-cplgdsobj.
     3837       DO WHILE available X_c-pl-gds-obj :
     3838         Display STREAM PrnLibStream
     3839         X_c-pl-gds-obj.gds-code
     3840         X_c-pl-gds-obj.pl-code
     3841         X_c-pl-gds-obj.old-fact-qnty COLUMN-LABEL "Количество!было"
     3842         X_c-pl-gds-obj.fact-qnty COLUMN-LABEL "Количество!стало"
     3843         get-action(X_c-pl-gds-obj.action-type) @ v-action-chr
     3844         X_c-pl-gds-obj.source-ref
     3845         X_c-pl-gds-obj.corr-date
     3846         string(X_c-pl-gds-obj.corr-time, "HH:MM:SS":U) @ v-upd-time
     3847         usrfulnf(X_c-pl-gds-obj.corr-user-name) @ v-for-user-name
     3848         X_c-pl-gds-obj.corr-user-db-num
     3849         X_c-pl-gds-obj.obj-type + string(X_c-pl-gds-obj.obj-code) @ v-obj
     3850         with FRAME HistoryList .
     3851     DOWN STREAM PrnLibStream 1 with FRAME HistoryList  .
     3852     assign
     3853     accum-count = accum-count + 1
     3854     .
     3855     GET next br-cplgdsobj.
     3856   END.
     3857   UNDERLINE  STREAM PrnLibStream
     3858   X_c-pl-gds-obj.gds-code
     3859   X_c-pl-gds-obj.pl-code
     3860   X_c-pl-gds-obj.old-fact-qnty
     3861   X_c-pl-gds-obj.fact-qnty
     3862   v-action-chr
     3863   X_c-pl-gds-obj.source-ref
     3864   X_c-pl-gds-obj.corr-date
     3865   v-upd-time
     3866   v-for-user-name
     3867   X_c-pl-gds-obj.corr-user-db-num
     3868   v-obj
     3869   with FRAME HistoryList .
     3870   DISPLAY STREAM PrnLibStream
     3871   "ИТОГО"  @ X_c-pl-gds-obj.gds-code
     3872   string(accum-count)  @ v-action-chr
     3873   with frame HistoryList.
     3874   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     3875   HIDE  STREAM PrnLibStream FRAME CheckList.
     3876   output  STREAM PrnLibStream CLOSE.
     3877   run waitfram-hide in this-procedure.
     3878   run prn-lib-prn-file in this-procedure (
     3879                                             input parparentproc
     3880                                             ,input 8
     3881                                             ).
     3882   reposition br-cplgdsobj to recid v-doc-rec no-error.
     3883   apply "entry" to br-cplgdsobj in frame Dialog-Frame.
     3884   END PROCEDURE.
     3885   PROCEDURE proc-b-sch :
     3886   assign
     3887     tbl = 'c-pl-gds-obj'
     3888     join-tbl = 'X_c-pl-gds-obj'
     3889     fld = ""
     3890     lab = ""
     3891     spr = ""
     3892     dim = '0'
     3893     .
     3894   run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', '',
     3895   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3896   run fltfield-add in this-procedure('gds-code', 'Код товара', '',
     3897   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3898   run fltfield-add in this-procedure('pl-code', 'Код складского места', '',
     3899   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3900   run fltfield-add in this-procedure('corr-date', '', '',
     3901   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3902   run fltfield-add in this-procedure('corr-time', 'Время корр.', 'time',
     3903   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3904   run fltfield-add in this-procedure('corr-user-db-num', '', '',
     3905   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3906   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     3907   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3908   run fltfield-add in this-procedure('action-type', 'Действие', 'hist-action',
     3909   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3910   run fltfield-add in this-procedure('source-type', 'Источник_измен-я', 'hist-source-type',
     3911   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3912   run fltfield-add in this-procedure('source-ref', '', '',
     3913   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3914   Filter-Block:
     3915   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     3916       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     3917       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     3918     run gbl/filter.w ( INPUT parparentproc
     3919                       ,INPUT (filter-point + chr(4) + filter-label + chr(4) + 'yes':U)
     3920                       ,INPUT tbl
     3921                       ,INPUT join-tbl
     3922                       ,INPUT fld
     3923                       ,INPUT lab
     3924                       ,INPUT spr
     3925                       ,INPUT dim ).
     3926     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     3927   END.
     3928   END PROCEDURE.
     3929   PROCEDURE proc-find-corr-date :
     3930   define input parameter p-next as logical no-undo.
     3931   define input parameter p-date AS DATE no-undo.
     3932   define variable v-date-chr as character no-undo.
     3933   if p-date = ? then return .
     3934   display
     3935   0 @ sch-gds-code
     3936   "":U @ sch-corr-user-name
     3937   '':U @ sch-source-ref
     3938   with frame Dialog-Frame.
     3939   assign
     3940   v-date-chr = string(day(p-date)) + chr(47) +
     3941                    string(month(p-date)) + chr(47) +
     3942                    string(year(p-date)).
     3943          run OpenBr in this-procedure
     3944           (input false
     3945           ,input true
     3946           ,input substitute("and X_c-pl-gds-obj.corr-date = &1 "
     3947             , v-date-chr)
     3948           ).
     3949         apply "entry":u to sch-corr-date in frame Dialog-Frame.
     3950   END PROCEDURE.
     3951   PROCEDURE proc-find-gds-code :
     3952   define input parameter p-next as logical no-undo.
     3953   define input parameter p-gds-code like ub.c-pl-gds-obj.gds-code no-undo.
     3954   define variable v-gds-code as character no-undo.
     3955   assign
     3956   sch-corr-date = ?.
     3957   display
     3958   "":U @ sch-corr-user-name
     3959   sch-corr-date
     3960   '':U @ sch-source-ref
     3961   with frame Dialog-Frame.
     3962   assign
     3963   v-gds-code = string(p-gds-code).
     3964   run OpenBr in this-procedure
     3965       (input false
     3966       ,input p-next
     3967       ,input substitute("and X_c-pl-gds-obj.gds-code = &1 "
     3968         , v-gds-code)
     3969       ).
     3970   apply "entry":u to sch-gds-code in frame Dialog-Frame .
     3971   END PROCEDURE.
     3972   PROCEDURE proc-find-source-ref :
     3973   define input parameter p-next as logical no-undo.
     3974   define input parameter p-user like ub.c-pl-gds-obj.corr-user-name no-undo.
     3975   assign
     3976   sch-corr-date = ?
     3977   .
     3978   display
     3979   sch-corr-date
     3980   0 @ sch-gds-code
     3981   '':U @ sch-corr-user-name
     3982   with frame Dialog-Frame.
     3983   p-user = chr(34) + p-user + chr(34).
     3984   run OpenBr in this-procedure
     3985       (input false
     3986       ,input p-next
     3987       ,input substitute("and X_c-pl-gds-obj.source-type = 'trn-doc' and X_c-pl-gds-obj.source-ref = &1 "
     3988         , p-user)
     3989       ).
     3990   apply "entry":u to sch-source-ref in frame Dialog-Frame .
     3991   END PROCEDURE.
     3992   PROCEDURE proc-find-user :
     3993   define input parameter p-next as logical no-undo.
     3994   define input parameter p-user like ub.c-pl-gds-obj.corr-user-name no-undo.
     3995   assign
     3996   sch-corr-date = ?.
     3997   display
     3998   sch-corr-date
     3999   0 @ sch-gds-code
     4000   '':U @ sch-source-ref
     4001   with frame Dialog-Frame.
     4002   p-user = chr(34) + p-user + chr(34).
     4003   run OpenBr in this-procedure
     4004       (input false
     4005       ,input p-next
     4006       ,input substitute("and X_c-pl-gds-obj.corr-user-name = &1 "
     4007         , p-user)
     4008       ).
     4009   apply "entry":u to sch-corr-user-name in frame Dialog-Frame .
     4010   END PROCEDURE.
     4011   FUNCTION get-action RETURNS CHARACTER
     4012     ( INPUT p-action AS CHARACTER ) :
     4013     define variable dops as character no-undo.
     4014   CASE p-action:
     4015      when 'close':U then do:
     4016         return "Закр.на факт".
     4017      end.
     4018      when 'delete':U then do:
     4019         return "Удаление".
     4020      end.
     4021   END CASE.
     4022   RETURN dops.
     4023   END FUNCTION.
     4024   FUNCTION get-doc-type RETURNS CHARACTER
     4025     ( BUFFER buf_c-pl-gds-obj FOR c-pl-gds-obj ) :
     4026     if available buf_c-pl-gds-obj
     4027     then do:
     4028       case buf_c-pl-gds-obj.source-type
     4029       :
     4030         when 'trn-doc':U
     4031         then do:
     4032           return "документ" .
     4033         end.
     4034         when 'price-doc':U
     4035         then do:
     4036           return "переоценка" .
     4037         end.
     4038         otherwise do:
     4039           return buf_c-pl-gds-obj.source-type .
     4040         end.
     4041       end case.
     4042     end.
     4043     RETURN "".
     4044   END FUNCTION.
