     1627   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1628   define temp-table temp-thbj-attr no-undo
     1629   like ub.thbj-attr.
     1630   find first current_c-thbj-attr no-lock where
     1631             current_c-thbj-attr.upper-prop-code       = p-upper-prop-code
     1632         AND current_c-thbj-attr.prop-code             = p-prop-code
     1633         AND current_c-thbj-attr.obj-type              = p-obj-type
     1634         AND current_c-thbj-attr.obj-code              = p-obj-code
     1635         AND current_c-thbj-attr.chip-num              = p-chip-num
     1636         AND current_c-thbj-attr.corr-user-db-num = p-corr-user-db-num  no-error .
     1637   if not available current_c-thbj-attr then do:
     1638     v-mess = "Неверная ссылка на c-thbj-attr в таблице c-cli-hist".
     1639     run err-mess ( input-output v-mess).
     1640     return error (if p-silent then v-mess else '':U).
     1641   end.
     1642   create temp-thbj-attr.
     1643   assign
     1644   temp-thbj-attr.upper-prop-code       = p-upper-prop-code
     1645   temp-thbj-attr.prop-code             = p-prop-code
     1646   temp-thbj-attr.obj-type              = p-obj-type
     1647   temp-thbj-attr.obj-code              = p-obj-code
     1648   .
     1649   run gen-key-rec in this-procedure ( input 'thbj-attr':U
     1650                                      ,input (buffer temp-thbj-attr:handle)
     1651                                      ,output v-thbj-attr-uniq-key-rec) .
     1652   CASE p-subject:
     1653     when 'thbj-attr':U
     1654     or when '' then do:
     1655       run thbj-attr-self-proc in this-procedure(input current_c-thbj-attr.action, output p-description) no-error  .
     1656     end.
     1657     when 'rp-by-call':U then do:
     1658       run rp-by-call-proc in this-procedure(output p-description) no-error .
     1659     end.
     1660     when 'rule-by-call':U then do:
     1661       run rule-by-call-proc in this-procedure(output p-description) no-error .
     1662     end.
     1663     when 'rule-call-param':U then do:
     1664       run rule-call-param-proc in this-procedure(output p-description) no-error .
     1665     end.
     1666   END CASE.
     1667   if error-status:error then do:
     1668     return error .
     1669   end.
     1670   PROCEDURE err-mess:
     1671     DEFINE INPUT-output PARAMETER p-mess as character No-UNDO.
     1672     p-mess =
     1673     substitute("История параметров объектов IBS TH: &1: щепка &2 БД:&3:Предмет изменений &4"
     1674                 ,get-objregion(p-obj-type, p-obj-code)
     1675                 ,p-chip-num
     1676                 ,p-corr-user-db-num
     1677                 ,p-subject) + chr(10) + p-mess
     1678                 .
     1679     CASE p-silent:
     1680       when yes then do:
     1681       end.
     1682       otherwise do:
     1683         message
     1684         p-mess
     1685         view-as alert-box error .
     1686       end.
     1687     end.
     1688   END PROCEDURE.
