        1   block-level on error undo, throw.
        2   define input parameter p-obj-type like ub.c-thbj-attr.obj-type no-undo .
        3   define input parameter p-obj-code like ub.c-thbj-attr.obj-code no-undo .
        4   define input parameter p-upper-prop-code like ub.c-thbj-attr.upper-prop-code no-undo .
        5   define input parameter p-prop-code like ub.c-thbj-attr.prop-code no-undo .
        6   define input parameter p-corr-user-db-num as integer no-undo .
        7   define input parameter p-chip-num as integer no-undo .
        8   define input parameter p-subject as character no-undo .
        9   define input parameter p-action as integer no-undo .
       10   define input parameter p-silent as logical no-undo .
       11   define output parameter p-description as character no-undo .
       12   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       13   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       14   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile: cthbjatv.p $":U .
       16   define variable vss-archive     as character no-undo init "$Archive: ref/cthbjatv.p $":U .
       17   define variable vss-description as character no-undo init "Заполнение временной таблицы для показа изменений по таблицам истории настроек объектов".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   define SHARED temp-table temp-changes no-undo
       89   field f_name as character
       90   field l_name as character
       91   field v_old as character
       92   field v_new as character
       93   field t_name as character
       94   field num_ as integer
       95   field uniq-key-rec as character
       96   field action as integer
       97   field fNotChange as logical
       98   index pi is unique primary
       99   num_
      100   t_name
      101   f_name
      102   index
      103   Chan
      104   fnotChange
      105   t_name
      106   f_name
      107   index imain uniq-key-rec
      108   .
      109   FUNCTION get-all-fields returns character (p-file-name as character ):
      110   define variable v-dop as character no-undo .
      111     find first _file no-lock where _file._file-name = p-file-name no-error .
      112     if not available _file then return "":U.
      113     for each _field no-lock where
      114              _field._file-recid = recid(_file) :
      115       assign
      116       v-dop = v-dop + _field._field-name + chr(44)
      117       .
      118     end.
      119     return trim(v-dop).
      120   END FUNCTION.
      121   PROCEDURE proc-full-temp-changes :
      122     define input  parameter p-act-create as logical   no-undo .
      123     define input  parameter p-act-delete as logical   no-undo .
      124     define input  parameter p-hst-handle as handle    no-undo .
      125     define input  parameter p-main-table as character no-undo .
      126     define input  parameter p-field-list as character no-undo .
      127     define input  parameter p-label-form as character no-undo .
      128     define variable h-new-buf         as handle    no-undo .
      129     define variable h-main-buf        as handle    no-undo .
      130     define variable h-for-comp        as handle    no-undo .
      131     define variable v-inform          as character no-undo .
      132     define variable v-ind             as integer   no-undo .
      133     define variable v-idx-field-qnty  as integer   no-undo .
      134     define variable v-num-entries     as integer   no-undo .
      135     define variable fh                as handle    no-undo .
      136     define variable fh-main           as handle    no-undo .
      137     define variable fh-old            as handle    no-undo .
      138     define variable fh-new            as handle    no-undo .
      139     define variable v-field-name      as character no-undo .
      140     define variable v-field-lvl       as character no-undo .
      141     define variable v-field-form      as character no-undo .
      142     define variable v-search-exp      as character no-undo .
      143     define variable v-srch-main       as character no-undo .
      144     define variable v-word-link       as character no-undo .
      145     define variable v-av-chip-num     as logical   no-undo .
      146     define variable v-main-pi-fld-lst as character no-undo .
      147     define variable v-main-fld-lst    as character no-undo .
      148     define variable v-delim-list      as character no-undo .
      149     define variable v-label           as character no-undo .
      150     define variable v-old-value       as character no-undo case-sensitive.
      151     define variable v-new-value       as character no-undo case-sensitive.
      152     define variable v-chg-fields as character no-undo.
      153     for each temp-changes:
      154       delete temp-changes.
      155     end.
      156     if not p-hst-handle:available then do:
      157       return .
      158     end.
      159     create buffer h-new-buf  for table p-hst-handle .
      160     create buffer h-main-buf for table p-main-table .
      161     assign
      162       v-inform = h-main-buf:index-information(1)
      163       v-ind    = 2
      164     .
      165     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      166     on error undo, return error
      167     :
      168       assign
      169         v-inform = h-main-buf:index-information( v-ind )
      170         v-ind    = v-ind + 1
      171       .
      172     end.
      173     if v-inform = ?
      174       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      175       or entry( 3, v-inform, ",":U ) <> "1":U
      176     then do:
      177       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      178     end.
      179     assign
      180       v-idx-field-qnty = num-entries( v-inform ) - 4
      181     .
      182     if v-idx-field-qnty < 2 then do:
      183       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      184     end.
      185     assign
      186       v-srch-main   = "where":U
      187       v-word-link   = "":U
      188       v-av-chip-num = false
      189       v-delim-list  = "":U
      190     .
      191     do v-ind = 1 to v-idx-field-qnty by 2
      192     on error undo, return error
      193     :
      194       assign
      195         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      196         fh                = p-hst-handle:buffer-field( v-field-name )
      197         fh-main           = h-main-buf:buffer-field( v-field-name )
      198         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      199         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      200       .
      201       if fh:data-type ="character":U then do:
      202         assign
      203           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      204         .
      205       end.
      206       else do:
      207         assign
      208           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      209         .
      210       end.
      211       if v-delim-list = "":U then do:
      212         assign
      213           v-delim-list = ",":U
      214         .
      215       end.
      216       if v-word-link = "":U then do:
      217         assign
      218           v-word-link = "and":U
      219         .
      220       end.
      221     end.
      222     assign
      223       v-delim-list  = "":U
      224     .
      225     do v-ind = 1 to h-main-buf:num-fields
      226     on error undo, return error
      227     :
      228       assign
      229         fh-main      = h-main-buf:buffer-field( v-ind )
      230         v-field-name = fh-main:name
      231       .
      232         assign
      233           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      234         .
      235         if v-delim-list = "":U then do:
      236           assign
      237             v-delim-list = ",":U
      238           .
      239         end.
      240     end.
      241     assign
      242       v-inform = p-hst-handle:index-information(1)
      243       v-ind    = 2
      244     .
      245     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      246     on error undo, return error
      247     :
      248       assign
      249         v-inform = p-hst-handle:index-information( v-ind )
      250         v-ind    = v-ind + 1
      251       .
      252     end.
      253     if v-inform = ?
      254       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      255       or entry( 3, v-inform, ",":U ) <> "1":U
      256     then do:
      257       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      258     end.
      259     assign
      260       v-idx-field-qnty = num-entries( v-inform ) - 4
      261     .
      262     if v-idx-field-qnty < 2 then do:
      263       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      264     end.
      265     assign
      266       v-search-exp  = "where":U
      267       v-word-link   = "":U
      268       v-av-chip-num = false
      269     .
      270     do v-ind = 1 to v-idx-field-qnty by 2
      271     on error undo, return error
      272     :
      273       assign
      274         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      275         fh           = p-hst-handle:buffer-field( v-field-name )
      276         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      277       .
      278       if v-field-name = "chip-num":U then do:
      279         assign
      280           v-search-exp  = substitute( "&1 >", v-search-exp )
      281           v-av-chip-num = true
      282         .
      283       end.
      284       else do:
      285         assign
      286           v-search-exp = substitute( "&1 =", v-search-exp )
      287         .
      288       end.
      289       if fh:data-type ="character":U then do:
      290         assign
      291           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      292         .
      293       end.
      294       else do:
      295         assign
      296           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
      297         .
      298       end.
      299       if v-word-link = "":U then do:
      300         assign
      301           v-word-link = "and":U
      302         .
      303       end.
      304     end.
      305     if v-av-chip-num = false then do:
      306       message
      307         vss-workfile vss-revision vss-description skip
      308         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
      309         "Использование данной процедуры невозможно!" skip
      310         view-as alert-box error .
      311       return error .
      312     end.
      313     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
      314     if not h-new-buf:available then do:
      315       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
      316       if not h-main-buf:available then do:
      317         assign
      318           h-for-comp = ?
      319         .
      320       end.
      321       else do:
      322         assign
      323           h-for-comp = h-main-buf
      324         .
      325       end.
      326     end.
      327     else do:
      328       assign
      329         h-for-comp = h-new-buf
      330       .
      331     end.
      332     assign
      333       v-num-entries = num-entries( v-main-fld-lst, ",":U )
      334     .
      335     do v-ind = 1 to v-num-entries
      336     on error undo, return error return-value
      337     :
      338       assign
      339         v-field-name = entry( v-ind, v-main-fld-lst )
      340         fh-old       = p-hst-handle:buffer-field( v-field-name )
      341         v-old-value  = fh-old:buffer-value()
      342         v-label      = trim( fh-old:label )
      343       .
      344       if ( trim( p-field-list ) <> "":U
      345            and lookup( v-field-name, p-field-list ) > 0
      346          )
      347          or trim( p-field-list ) = "":U
      348       then do:
      349         if h-for-comp <> ? then do:
      350           assign
      351             fh-new      = h-for-comp:buffer-field( v-field-name )
      352             v-new-value = fh-new:buffer-value()
      353           .
      354         end.
      355         else do:
      356           assign
      357             v-new-value = "":U
      358           .
      359         end.
      360           if p-act-create = true then do:
      361             assign
      362               v-old-value = "":U
      363             .
      364           end.
      365           if p-act-delete = true then do:
      366             assign
      367               v-new-value = "":U
      368             .
      369           end.
      370         if v-old-value <> v-new-value
      371         then do:
      372           create temp-changes.
      373           assign
      374             temp-changes.t_name = p-main-table
      375             temp-changes.f_name = v-field-name
      376             temp-changes.l_name = replace( v-label, "&":U, "":U )
      377             temp-changes.v_old  = trim( v-old-value )
      378             temp-changes.v_new  = trim( v-new-value )
      379             temp-changes.num_   = 0
      380             temp-changes.fNotChange = v-old-value eq v-new-value
      381           .
      382         end.
      383       end.
      384     end.
      385     assign
      386       v-num-entries = num-entries( p-label-form, chr(8) )
      387     .
      388     do v-ind = 1 to v-num-entries
      389     on error undo, return error return-value
      390     :
      391       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
      392         assign
      393           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      394           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      395           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      396         .
      397         find first temp-changes
      398           where temp-changes.f_name = v-field-name
      399           no-error .
      400         if available temp-changes then do:
      401           if trim( v-field-lvl ) <> "":U then do:
      402             assign
      403               temp-changes.l_name = v-field-lvl
      404             .
      405           end.
      406           if trim( v-field-form ) <> "":U then do:
      407             assign
      408               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
      409             .
      410             if h-for-comp <> ? then do:
      411               assign
      412                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
      413               .
      414             end.
      415           end.
      416         end.
      417       end.
      418       else do:
      419         message
      420           vss-workfile vss-revision vss-description skip
      421           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
      422           substitute( "список для поля '&1': '&2'"
      423                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      424                       ,entry( v-ind, p-label-form, chr(8) )
      425                     ) skip
      426           substitute( "полный список: &2", p-label-form ) skip
      427           view-as alert-box error .
      428       end.
      429     end.
      430     delete object h-new-buf .
      431     delete object h-main-buf .
      432   END PROCEDURE.
      433   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      434   FUNCTION get-region RETURNS CHARACTER
      435     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      436     define variable par-region as character no-undo.
      437     if parhost-code = 0 and
      438          parobj-type = "":U and
      439          parobj-code = 0 then do:
      440          par-region = "Глобально".
      441          return par-region.
      442       end.
      443       if parobj-type = 'орг':U then do:
      444          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      445          return par-region.
      446       end.
      447       if parobj-type = 'регион':U
      448       then do:
      449          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      450          return par-region.
      451       end.
      452       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      453       return par-region.
      454   END FUNCTION.
      455   FUNCTION get-objregion RETURNS CHARACTER
      456     (  input parobj-type as character, input parobj-code as integer ) :
      457     define variable par-region as character no-undo.
      458     if  parobj-type = "":U and
      459         parobj-code = 0
      460     then do:
      461        par-region = "Глобально".
      462     end.
      463     else if parobj-type = 'орг':U
      464     then do:
      465        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      466     end.
      467     else if parobj-type = 'регион':U
      468     then do:
      469        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      470     end.
      471     else
      472        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      473     return par-region.
      474   END FUNCTION.
      475   define variable v-mess as character no-undo .
      476   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      477   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      478   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      479   procedure gen-key-rec :
      480     define input  parameter p-tbl-name    as character no-undo.
      481     define input  parameter p-bh_tbl-name as handle    no-undo.
      482     define output parameter p-key-rec     as character no-undo.
      483     do
      484     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      485     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      486     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      487     :
      488       define variable fh               as handle    no-undo .
      489       define variable v-ok             as logical   no-undo .
      490       define variable v-inform         as character no-undo .
      491       define variable v-ind            as integer   no-undo .
      492       define variable v-idx-field-qnty as integer   no-undo .
      493       if p-tbl-name = ?
      494         or p-tbl-name = "":U
      495       then do:
      496         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info4 ).
      497       end.
      498       if not p-bh_tbl-name:available then do:
      499         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info4, p-tbl-name ).
      500       end.
      501       assign
      502         p-key-rec = p-tbl-name
      503         v-inform  = p-bh_tbl-name:index-information(1)
      504         v-ind     = 2
      505       .
      506       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      507       on error undo, return error
      508       :
      509         assign
      510           v-inform = p-bh_tbl-name:index-information( v-ind )
      511           v-ind    = v-ind + 1
      512         .
      513       end.
      514       if v-inform = ?
      515         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      516         or entry( 3, v-inform, ",":U ) <> "1":U
      517       then do:
      518         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, p-tbl-name ).
      519       end.
      520       else do:
      521         assign
      522           v-idx-field-qnty = num-entries( v-inform ) - 4
      523         .
      524         if v-idx-field-qnty < 2 then do:
      525           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, p-tbl-name ).
      526         end.
      527         do v-ind = 1 to v-idx-field-qnty by 2
      528         on error undo, return error
      529         :
      530           assign
      531             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      532             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      533           .
      534         end.
      535       end.
      536       if p-key-rec = ? then do:
      537         assign
      538           p-key-rec = "":U
      539         .
      540         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info4, p-tbl-name ).
      541       end.
      542     end.
      543     return.
      544   end procedure.
      545   procedure gen-where-keyr-tab :
      546     define input  parameter i-tableSerach as character no-undo.
      547     define input  parameter i-tablekey   as character  no-undo.
      548     define input  parameter p-key-rec    as character  no-undo.
      549     define input  parameter p-key-handle as handle     no-undo .
      550     define input  parameter p-db-name    as character  no-undo .
      551     define input  parameter p-tt-handle  as handle     no-undo .
      552     define output parameter o-Where      as character  no-undo.
      553     do
      554     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      555     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      556     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      557     :
      558       define variable v-full-tbl-name  as character no-undo .
      559       define variable bh_tbl-name      as handle    no-undo .
      560       define variable fh_key           as handle    no-undo .
      561       define variable fh_search        as handle    no-undo .
      562       define variable v-field-num      as integer   no-undo .
      563       define variable v-count-fld      as integer   no-undo .
      564       define variable v-inform         as character no-undo .
      565       define variable v-ind            as integer   no-undo .
      566       define variable v-idx-field-qnty as integer   no-undo .
      567       define variable v-field-name     as character no-undo .
      568       define variable v-field-val      as character no-undo .
      569       define variable v-word-link      as character no-undo .
      570       define variable vTable           as character no-undo.
      571       define variable bh_tbl-key       as handle    no-undo .
      572       assign
      573         p-key-rec = trim( p-key-rec )
      574       .
      575       if p-key-handle <> ? then do:
      576         if not valid-handle(p-key-handle)
      577            or p-key-handle:type <> "buffer"
      578         then do:
      579           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info4 ).
      580         end.
      581         if num-entries( p-key-rec, chr(3) ) > 1
      582           or p-key-rec = ?
      583           or p-key-rec = "":U
      584         then do:
      585           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info4, p-key-rec ).
      586         end.
      587       end.
      588       else do:
      589         if p-key-rec = ?
      590           or p-key-rec = "":U
      591         then do:
      592           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      593         end.
      594       end.
      595       assign
      596         vTable = entry( 1 , p-key-rec, chr(3) )
      597       .
      598       if p-tt-handle <> ?
      599         and ( not valid-handle(p-tt-handle)
      600               or p-tt-handle:type <> "buffer"
      601             )
      602       then do:
      603         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info4, vTable, chr(10) ).
      604       end.
      605       if p-tt-handle = ? then do:
      606         assign
      607           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      608         .
      609         create buffer bh_tbl-name for table v-full-tbl-name .
      610       end.
      611       else do:
      612         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      613       end.
      614       assign
      615         v-inform = bh_tbl-name:index-information(1)
      616         v-ind    = 2
      617       .
      618       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      619       on error undo, return error
      620       :
      621         assign
      622           v-inform = bh_tbl-name:index-information( v-ind )
      623           v-ind    = v-ind + 1
      624         .
      625       end.
      626       if v-inform = ?
      627         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      628         or entry( 3, v-inform, ",":U ) <> "1":U
      629       then do:
      630         delete object bh_tbl-name no-error.
      631         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info4, vTable ).
      632       end.
      633       assign
      634         v-idx-field-qnty = num-entries( v-inform ) - 4
      635       .
      636       if v-idx-field-qnty < 2 then do:
      637         delete object bh_tbl-name no-error.
      638         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, vTable ).
      639       end.
      640       assign
      641         o-where     = "where":U
      642         v-word-link = "":U
      643         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      644         v-count-fld = 0
      645       .
      646       if i-tablekey ne "" and i-tablekey ne ?
      647       then do:
      648         assign
      649           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      650         .
      651         create buffer bh_tbl-key for table v-full-tbl-name .
      652       end.
      653       if i-tableSerach ne "" and i-tableSerach ne ?
      654       then do:
      655         delete object bh_tbl-name no-error.
      656         assign
      657           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      658         .
      659         create buffer bh_tbl-name for table v-full-tbl-name .
      660       end.
      661       block_where:
      662       do v-ind = 1 to v-idx-field-qnty by 2
      663       on error undo, return error
      664       :
      665         assign
      666           v-count-fld = v-count-fld + 1
      667         .
      668         if p-key-handle = ?
      669           and v-count-fld > v-field-num
      670         then do:
      671           leave block_where.
      672         end.
      673         define variable VfieldKeyTable as handle no-undo.
      674         assign
      675           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      676           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      677         .
      678         if     bh_tbl-key ne ?
      679         then do:
      680            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      681            if VfieldKeyTable eq ?
      682            then next block_where.
      683         end.
      684         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      685         then
      686            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      687         else
      688            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      689         if p-key-handle = ? then do:
      690           assign
      691             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      692           .
      693         end.
      694         else do:
      695           assign
      696             fh_key = p-key-handle:buffer-field( v-field-name )
      697           .
      698           if fh_key = ?
      699             or not valid-handle( fh_key )
      700           then do:
      701             delete object bh_tbl-name.
      702             if     bh_tbl-key ne ?
      703             then
      704                delete object bh_tbl-key.
      705             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info4, p-key-handle:name, v-field-name ).
      706           end.
      707           assign
      708             v-field-val = fh_key:buffer-value
      709           .
      710         end.
      711         if fh_search:data-type ="character":U then do:
      712           assign
      713             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      714             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      715             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      716             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      717             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      718             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      719             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      720             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      721             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      722             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      723             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      724             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      725             v-field-val = substitute( '"&1"', v-field-val )
      726           .
      727         end.
      728         assign
      729           o-where = substitute( "&1 &2", o-where, v-field-val )
      730         .
      731         if v-word-link = "":U then do:
      732           assign
      733             v-word-link = "and":U
      734           .
      735         end.
      736       end.
      737       delete object bh_tbl-name.
      738       if     bh_tbl-key ne ?
      739       then
      740          delete object bh_tbl-key.
      741       if p-key-handle = ?
      742         and v-count-fld <> v-field-num
      743       then do:
      744         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info4, vTable ).
      745       end.
      746     end.
      747   end procedure.
      748   procedure gen-hn-keyr-tab :
      749     define input  parameter i-tableSerach as character no-undo.
      750     define input  parameter i-tablekey   as character no-undo.
      751     define input  parameter p-key-rec    as character no-undo.
      752     define input  parameter p-key-handle as handle    no-undo .
      753     define input  parameter p-db-name    as character no-undo .
      754     define input  parameter p-tt-handle  as handle    no-undo .
      755     define input  parameter p-stts-lock  as integer   no-undo .
      756     define output parameter o-hn         as handle    no-undo.
      757     define variable v-full-tbl-name as character no-undo.
      758     define variable v-where         as character no-undo.
      759     define variable bh_tbl-name     as handle    no-undo.
      760     define variable vTable          as character no-undo.
      761     do
      762     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      763     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      764     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      765         run gen-where-keyr-tab(i-tableSerach,
      766                                i-tablekey,
      767                                p-key-rec,
      768                                p-key-handle,
      769                                p-db-name,
      770                                p-tt-handle,
      771                                output v-where).
      772         if i-tableSerach ne "" and i-tableSerach ne ?
      773         then do:
      774            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      775            create buffer bh_tbl-name for table v-full-tbl-name .
      776         end.
      777         else do:
      778            if p-tt-handle = ? then do:
      779               assign
      780                  vTable = entry( 1 , p-key-rec, chr(3) )
      781               .
      782               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      783               create buffer bh_tbl-name for table v-full-tbl-name .
      784            end.
      785            else do:
      786               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      787            end.
      788         end.
      789         if p-tt-handle = ? then do:
      790            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      791         end.
      792         else do:
      793            bh_tbl-name:find-first( v-where ) no-error .
      794         end.
      795         o-hn = bh_tbl-name.
      796      end.
      797   end procedure.
      798   procedure gen-hn-keyr :
      799     define input  parameter p-key-rec    as character no-undo.
      800     define input  parameter p-key-handle as handle    no-undo .
      801     define input  parameter p-db-name    as character no-undo .
      802     define input  parameter p-tt-handle  as handle    no-undo .
      803     define input  parameter p-stts-lock  as integer   no-undo .
      804     define output parameter o-hn         as handle    no-undo.
      805     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      806   end.
      807   procedure gen-row-keyr :
      808     define input  parameter p-key-rec    as character no-undo.
      809     define input  parameter p-key-handle as handle    no-undo .
      810     define input  parameter p-db-name    as character no-undo .
      811     define input  parameter p-tt-handle  as handle    no-undo .
      812     define input  parameter p-stts-lock  as integer   no-undo .
      813     define output parameter p-tbl-row    as rowid     no-undo.
      814     define output parameter p-tbl-name   as character no-undo.
      815     define variable vHn as handle no-undo.
      816       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      817       p-tbl-row = if vHn:available then vHn:rowid else ?.
      818       p-tbl-name =  vHn:table.
      819       delete object vHn no-error.
      820     if p-tbl-row = ? then do:
      821       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info4, p-tbl-name, p-key-rec ).
      822     end.
      823     else do:
      824       return.
      825     end.
      826   end procedure.
      827   procedure gen-key-fv :
      828     define input  parameter p-key-rec    as character no-undo .
      829     define output parameter p-field-list as character no-undo .
      830     define output parameter p-value-list as character no-undo.
      831     do
      832     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      833     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      834     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      835     :
      836       define variable v-full-tbl-name  as character no-undo .
      837       define variable bh_tbl-name      as handle    no-undo .
      838       define variable v-tbl-name       as character no-undo .
      839       define variable v-field-num      as integer   no-undo .
      840       define variable v-count-fld      as integer   no-undo .
      841       define variable v-inform         as character no-undo .
      842       define variable v-ind            as integer   no-undo .
      843       define variable v-idx-field-qnty as integer   no-undo .
      844       define variable v-delim-key      as character no-undo .
      845       if p-key-rec = ?
      846         or p-key-rec = "":U
      847       then do:
      848         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      849       end.
      850       assign
      851         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      852         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      853       .
      854       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      855       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info4 ).
      856       assign
      857         v-inform = bh_tbl-name:index-information(1)
      858         v-ind    = 2
      859       .
      860       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      861       on error undo, return error
      862       :
      863         assign
      864           v-inform = bh_tbl-name:index-information( v-ind )
      865           v-ind    = v-ind + 1
      866         .
      867       end.
      868       if v-inform = ?
      869         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      870         or entry( 3, v-inform, ",":U ) <> "1":U
      871       then do:
      872         delete object bh_tbl-name no-error.
      873         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      874       end.
      875       assign
      876         v-idx-field-qnty = num-entries( v-inform ) - 4
      877       .
      878       if v-idx-field-qnty < 2 then do:
      879         delete object bh_tbl-name no-error.
      880         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      881       end.
      882       assign
      883         p-field-list = "":U
      884         p-value-list = "":U
      885         v-delim-key  = "":U
      886         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      887         v-count-fld  = 0
      888       .
      889       block_where:
      890       do v-ind = 1 to v-idx-field-qnty by 2
      891       on error undo, return error
      892       :
      893         assign
      894           v-count-fld = v-count-fld + 1
      895         .
      896         if v-count-fld > v-field-num then do:
      897           leave block_where.
      898         end.
      899         assign
      900           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      901           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      902         .
      903         if v-ind = 1 then do:
      904           assign
      905             v-delim-key = chr(3)
      906           .
      907         end.
      908       end.
      909       delete object bh_tbl-name.
      910       if v-count-fld <> v-field-num then do:
      911         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info4, v-tbl-name ).
      912       end.
      913     end.
      914   end procedure.
      915   procedure gen-key-field :
      916     define input  parameter p-table      as character no-undo .
      917     define output parameter p-field-list as character no-undo .
      918     do
      919     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      920     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      921     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      922     :
      923       define variable v-full-tbl-name  as character no-undo .
      924       define variable bh_tbl-name      as handle    no-undo .
      925       define variable v-tbl-name       as character no-undo .
      926       define variable v-field-num      as integer   no-undo .
      927       define variable v-count-fld      as integer   no-undo .
      928       define variable v-inform         as character no-undo .
      929       define variable v-ind            as integer   no-undo .
      930       define variable v-idx-field-qnty as integer   no-undo .
      931       define variable v-delim-key      as character no-undo .
      932       if p-table = ?
      933         or p-table = "":U
      934       then do:
      935         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info4 ).
      936       end.
      937       assign
      938         v-tbl-name      = p-table
      939         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      940       .
      941       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      942       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info4 ).
      943       assign
      944         v-inform = bh_tbl-name:index-information(1)
      945         v-ind    = 2
      946       .
      947       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      948       on error undo, return error
      949       :
      950         assign
      951           v-inform = bh_tbl-name:index-information( v-ind )
      952           v-ind    = v-ind + 1
      953         .
      954       end.
      955       if v-inform = ?
      956         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      957         or entry( 3, v-inform, ",":U ) <> "1":U
      958       then do:
      959         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
      960       end.
      961       assign
      962         v-idx-field-qnty = num-entries( v-inform ) - 4
      963       .
      964       if v-idx-field-qnty < 2 then do:
      965         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
      966       end.
      967       assign
      968         p-field-list = "":U
      969         v-delim-key  = "":U
      970         v-count-fld  = 0
      971       .
      972       block_where:
      973       do v-ind = 1 to v-idx-field-qnty by 2
      974       on error undo, return error
      975       :
      976         assign
      977           v-count-fld = v-count-fld + 1
      978         .
      979         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      980         if v-ind = 1 then do:
      981           assign
      982             v-delim-key = chr(3)
      983           .
      984         end.
      985       end.
      986       delete object bh_tbl-name.
      987     end.
      988   end procedure.
      989   FUNCTION calldscr returns character ( input p-call-id as character):
      990   define variable v-descr as character no-undo .
      991   define variable v-field-list as character no-undo .
      992   define variable v-value-list as character no-undo.
      993   define variable v-prop-label as character no-undo .
      994   define variable v-node-label as character no-undo .
      995   define variable v-dt-code as integer no-undo .
      996   define variable v-host-code as integer no-undo .
      997   define variable v-obj-type as character no-undo .
      998   define variable v-obj-code as integer no-undo .
      999   define variable v-label as character no-undo .
     1000   define variable v-node-code as integer no-undo .
     1001   define buffer buf_prop-head for ub.prop-head.
     1002   define buffer buf_prop-ref for ub.prop-ref.
     1003   define buffer buf_prop-map for ub.prop-map.
     1004   run gen-key-fv in this-procedure ( input p-call-id
     1005                                     ,output v-field-list
     1006                                     ,output v-value-list) no-error .
     1007   if error-status:error then return p-call-id.
     1008   CASE entry(1, p-call-id, chr(3)):
     1009     when 'dis-card-type':U then do:
     1010       v-descr = substitute("Тип ДК: эмитент &1 тип: &2"
     1011                            ,integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1012                            ,entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
     1013                            ).
     1014     end.
     1015     when 'dis-card':U then do:
     1016       v-descr = substitute("ДК: № &1"
     1017                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1018                            ).
     1019     end.
     1020     when 'dis-card-property':U then do:
     1021       v-dt-code = integer(entry(lookup("dt-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1022       v-node-code = integer(entry(lookup("node-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1023       v-host-code = integer(entry(lookup("host-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1024       v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3)) .
     1025       v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1026       find first buf_prop-ref no-lock where
     1027                 buf_prop-ref.dt-code = v-dt-code no-error .
     1028       if available buf_prop-ref then do:
     1029         find first buf_prop-head no-lock where
     1030                   buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error .
     1031         v-prop-label = buf_prop-head.prop-label.
     1032         find first buf_prop-map no-lock where
     1033                   buf_prop-map.dtm-code = buf_prop-ref.dtm-code
     1034               and buf_prop-map.node-code = v-node-code no-error .
     1035         if available buf_prop-map then do:
     1036           v-label = buf_prop-map.node-label.
     1037         end.
     1038       end.
     1039       v-descr = substitute("ДК: № &1 &2:&3 &4"
     1040                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1041                            ,v-prop-label
     1042                            ,v-label
     1043                            ,get-region(v-host-code, v-obj-type, v-obj-code)
     1044                            ).
     1045     end.
     1046     when 'clients':U then do:
     1047       v-descr = substitute("&1&2"
     1048                            ,entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
     1049                            ,integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1050                            ).
     1051     end.
     1052     when 'ext-system':U then do:
     1053       v-descr = substitute("Внешняя система &1"
     1054                            ,integer(entry(lookup("esys-id", v-field-list, chr(3)), v-value-list, chr(3)))
     1055                            ).
     1056     end.
     1057     WHEN 'thbj-attr':U then do:
     1058       if entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum':U
     1059       or entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum_obj':U
     1060       then do:
     1061         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'goods':U then do:
     1062           v-descr = "Операции с товарами".
     1063         end.
     1064         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'clients':U then do:
     1065           v-descr = "Операции с клиентами".
     1066         end.
     1067         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'gds-grp':U then do:
     1068           v-descr = "Операции с группами товаров".
     1069         end.
     1070         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'cli-grp':U then do:
     1071           v-descr = "Операции с группами клиентов".
     1072         end.
     1073         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th':U then do:
     1074           v-descr = "Операции с чеками на POS IBS-TH".
     1075         end.
     1076         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th-mob':U then do:
     1077           v-descr = "Операции с чеками на POS IBS-TH-MOB".
     1078         end.
     1079         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'edoc':U then do:
     1080           v-descr = "Операции в системе электронного документооборота".
     1081         end.
     1082         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'thref':U then do:
     1083           v-descr = "Операции со справочниками".
     1084         end.
     1085         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'pdf':U then do:
     1086           v-descr = "Операции с ДНЦ и переоценками".
     1087         end.
     1088         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rep':U then do:
     1089           v-descr = "Отчеты".
     1090         end.
     1091         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'ord':U then do:
     1092           v-descr = "Операции с заказами".
     1093         end.
     1094       end.
     1095     end.
     1096     when 'cash-desk':U then do:
     1097       v-descr = substitute("БД &1 Маг &2 Касса № &4 &3"
     1098                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1099                            ,entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3))
     1100                            ,entry(lookup("cash-num", v-field-list, chr(3)), v-value-list, chr(3))
     1101                            ,entry(lookup("pos-type", v-field-list, chr(3)), v-value-list, chr(3))
     1102                            ).
     1103     end.
     1104     when 'ext-file':U then do:
     1105       v-descr = substitute("БД &1 Файл № &3 (из БД &2)"
     1106                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1107                            ,entry(lookup("from-db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1108                            ,entry(lookup("file-num", v-field-list, chr(3)), v-value-list, chr(3))
     1109                            ).
     1110     end.
     1111   end case.
     1112   return v-descr.
     1113   end function.
     1114   define variable v-thbj-attr-uniq-key-rec as character no-undo .
     1115   define buffer current_c-thbj-attr for ub.c-thbj-attr.
     1116   function  getPSwd returns character (istr as char ):
     1117      return fill("*",length(istr)).
     1118   end.
     1119   procedure thbj-attr-self-proc :
     1120   define input parameter p-action as integer no-undo .
     1121   define output parameter p-description as character no-undo .
     1122   define variable v-tooltip as character no-undo .
     1123   define variable v-label as character no-undo .
     1124   define variable v-tooltip-code as character no-undo .
     1125   define variable v-global as logical no-undo .
     1126   define variable v-host as logical no-undo .
     1127   define variable v-shop as logical no-undo .
     1128   define variable v-store as logical no-undo .
     1129   define variable v-db as logical   no-undo .
     1130   define variable v-other as character no-undo .
     1131   define variable v-user-can-edit as logical no-undo .
     1132   define variable v-output-display as logical no-undo .
     1133   define variable v-prop-list as character no-undo .
     1134   define variable v-prop-type-list as character no-undo .
     1135   define variable v-prop-label-list as character no-undo .
     1136   define variable v-fields-name-list as character no-undo .
     1137   define variable v-label-param as character no-undo .
     1138   define variable v-prop-code-num as integer no-undo .
     1139   define variable v-type as character no-undo .
     1140   do
     1141   on error undo, return error
     1142   :
     1143     run thbjattr_tooltip in this-procedure (
     1144                   input  current_c-thbj-attr.upper-prop-code
     1145                 ,input  current_c-thbj-attr.prop-code
     1146                 ,output v-tooltip
     1147                 ,output v-label
     1148                 ,output v-tooltip-code
     1149                 ) no-error .
     1150     p-description = "Параметр" + chr(32) + v-label.
     1151     run thbjattr_code in this-procedure (
     1152         input  current_c-thbj-attr.upper-prop-code
     1153         ,input current_c-thbj-attr.prop-code
     1154         ,output v-label
     1155         ,output v-user-can-edit
     1156         ,output v-output-display
     1157         ,output v-other
     1158         ,output v-prop-list
     1159         ,output v-prop-type-list
     1160         ,output v-prop-label-list
     1161         ,output v-global
     1162         ,output v-host
     1163         ,output v-shop
     1164         ,output v-store
     1165         ,output v-db
     1166         ) no-error .
     1167     assign
     1168     v-prop-code-num = lookup(current_c-thbj-attr.prop-code, v-prop-list)
     1169     v-type = entry(v-prop-code-num, v-prop-type-list)
     1170     no-error
     1171     .
     1172     if current_c-thbj-attr.subject = 'thbj-attr':U
     1173     or current_c-thbj-attr.subject = ''
     1174     then do:
     1175           v-label-param =  "upper-prop-code" + chr(4) + "Группа параметра" + chr(4) + "" + chr(8)
     1176                       + " prop-code" + chr(4) + "Параметр" + chr(4) + "" + chr(8)
     1177                       + "prop-value-type" + chr(4) + "Тип Значения" + chr(4) + "" + chr(8)
     1178                       + "obj-type" + chr(4) + "Тип объекта" + chr(4) + "" + chr(8)
     1179                       + "obj-code" + chr(4) + "Код объекта" + chr(4) + ""  .
     1180       case v-type:
     1181         when 'character':U then do:
     1182            if     current_c-thbj-attr.upper-prop-code eq "gismt"
     1183               and (current_c-thbj-attr.prop-code eq "oflinepswd"
     1184                    or current_c-thbj-attr.prop-code eq "proxypswd"
     1185                    or current_c-thbj-attr.prop-code eq "MaxApiToken")
     1186            then v-label-param = "property-value-character" + chr(4) + "Значение(строк.)" + chr(4) + "getpswd" + chr(8) +
     1187                         v-label-param.
     1188            else assign
     1189                v-label-param = "property-value-character" + chr(4) + "Значение(строк.)" + chr(4) + "" + chr(8) +
     1190                         v-label-param.
     1191           v-fields-name-list = "property-value-character," + "upper-prop-code, prop-code,prop-value-type,obj-type,obj-code".
     1192         end.
     1193         when 'date':U then do:
     1194           v-label-param = "property-value-date" + chr(4) + "Значение(Дата)" + chr(4) + "" + chr(8)  +
     1195                         v-label-param.
     1196           v-fields-name-list = "property-value-date," + "upper-prop-code, prop-code,prop-value-type,obj-type,obj-code".
     1197         end.
     1198         when 'decimal':U then do:
     1199           v-label-param = "property-value-decimal" + chr(4) + "Значение" + chr(4) + "" + chr(8) +
     1200                           v-label-param.
     1201           v-fields-name-list = "property-value-decimal," + "upper-prop-code, prop-code,prop-value-type,obj-type,obj-code".
     1202         end.
     1203         when 'integer':U then do:
     1204           v-label-param = "property-value-integer" + chr(4) + "Значение" + chr(4) + "" + chr(8) +
     1205                           v-label-param.
     1206           v-fields-name-list = "property-value-integer," + "upper-prop-code, prop-code,prop-value-type,obj-type,obj-code".
     1207         end.
     1208         when 'logical':U then do:
     1209           v-label-param = "property-value-logical" + chr(4) + "Значение" + chr(4) + "" + chr(8) +
     1210           v-label-param.
     1211           v-fields-name-list = "property-value-logical," + "upper-prop-code, prop-code,prop-value-type,obj-type,obj-code".
     1212         end.
     1213       end case.
     1214       run proc-full-temp-changes in this-procedure (
     1215                                                   input p-action = integer('1':U)
     1216                                                   ,input p-action = integer('99':U)
     1217                                                   ,input  buffer current_c-thbj-attr:handle
     1218                                                   ,input  'thbj-attr':U
     1219                                                   ,input  v-fields-name-list
     1220                                                   ,input  v-label-param).
     1221     end.
     1222   end.
     1223   end procedure.
     1224   procedure rp-by-call-proc :
     1225   define output parameter p-description as character no-undo .
     1226   define buffer current_c-rp-by-call for ub.c-rp-by-call .
     1227     do
     1228     on error undo, return error
     1229     :
     1230       find first current_c-rp-by-call no-lock where
     1231                  current_c-rp-by-call.chip-num = current_c-thbj-attr.chip-num
     1232              AND current_c-rp-by-call.corr-user-db-num = current_c-thbj-attr.corr-user-db-num
     1233              AND current_c-rp-by-call.call_id = v-thbj-attr-uniq-key-rec no-error .
     1234       if not avail current_c-rp-by-call then do:
     1235          v-mess = "Неверная ссылка на c-rp-by-call в таблице c-thbj-attr".
     1236          run err-mess(input-output v-mess).
     1237       end.
     1238   define variable v-label-param as character no-undo .
     1239   v-label-param =
     1240     "call_id" + chr(4) + "Точка вызова" + chr(4) + "calldscr" + chr(8)
     1241    + "call#_id" + chr(4) + "Уник.идент.точки вызова" + chr(4) + "" + chr(8)
     1242    + "profile_id" + chr(4) + "Профайл" + chr(4) + "" .
     1243    run proc-full-temp-changes in this-procedure (
     1244                                                input  (current_c-thbj-attr.action = integer('1':U))
     1245                                               ,input  (current_c-thbj-attr.action = integer('99':U))
     1246                                               ,input  buffer current_c-rp-by-call:handle
     1247                                               ,input  'rp-by-call':U
     1248                                               ,input  "call_id,call#_id,profile_id"
     1249                                               ,input  v-label-param).
     1250   end.
     1251   end procedure.
     1252   procedure rule-by-call-proc :
     1253   define output parameter p-description as character no-undo .
     1254   define buffer current_c-rule-by-call for ub.c-rule-by-call .
     1255     do
     1256     on error undo, return error
     1257     :
     1258       find first current_c-rule-by-call no-lock where
     1259                  current_c-rule-by-call.chip-num = current_c-thbj-attr.chip-num
     1260              AND current_c-rule-by-call.corr-user-db-num = current_c-thbj-attr.corr-user-db-num
     1261              AND current_c-rule-by-call.call_id = v-thbj-attr-uniq-key-rec no-error .
     1262       if not avail current_c-rule-by-call then do:
     1263          v-mess = "Неверная ссылка на c-rule-by-call в таблице c-thbj-attr".
     1264          run err-mess(input-output v-mess).
     1265       end.
     1266   define variable v-label-param as character no-undo .
     1267   v-label-param =
     1268     "call_id" + chr(4) + "Точка вызова" + chr(4) + "calldscr" + chr(8)
     1269    + "call#_id" + chr(4) + "Уник.идент.точки вызова" + chr(4) + "" + chr(8)
     1270    + "profile_id" + chr(4) + "Профайл" + chr(4) + ""  + chr(8)
     1271    + "can-calc" + chr(4) + "Включено" + chr(4) + ""  + chr(8)
     1272    + "can-run" + chr(4) + "Может быть включено" + chr(4) + ""  + chr(8)
     1273    + "codex_id" + chr(4) + "Кодекс" + chr(4) + ""  + chr(8)
     1274    + "ruleset_id" + chr(4) + "Набор правил" + chr(4) + ""  + chr(8)
     1275    + "order_id" + chr(4) + "Порядок вызова" + chr(4) + ""  + chr(8)
     1276    + "rule_id" + chr(4) + "№ правила" + chr(4) + ""  + chr(8)
     1277    + "algo-des" + chr(4) + "Описание правила" + chr(4) + ""  + chr(8)
     1278    + "is_dynamic" + chr(4) + "Отключаемое" + chr(4) + ""
     1279    .
     1280    run proc-full-temp-changes in this-procedure (
     1281                                                input  (current_c-thbj-attr.action = integer('1':U))
     1282                                               ,input  (current_c-thbj-attr.action = integer('99':U))
     1283                                               ,input  buffer current_c-rule-by-call:handle
     1284                                               ,input  'rule-by-call':U
     1285                                               ,input  "call_id,call#_id,profile_id,can-calc,can-run,codex_id,ruleset_id,order_id,algo-des,rule_id,is_dynamic"
     1286                                               ,input  v-label-param).
     1287   end.
     1288   end procedure.
     1289   procedure rule-call-param-proc :
     1290   define output parameter p-description as character no-undo .
     1291   define buffer current_c-rule-call-param for ub.c-rule-call-param .
     1292     do
     1293     on error undo, return error
     1294     :
     1295       find first current_c-rule-call-param no-lock where
     1296                  current_c-rule-call-param.chip-num = current_c-thbj-attr.chip-num
     1297              AND current_c-rule-call-param.corr-user-db-num = current_c-thbj-attr.corr-user-db-num
     1298              AND current_c-rule-call-param.call_id = v-thbj-attr-uniq-key-rec no-error .
     1299       if not avail current_c-rule-call-param then do:
     1300          v-mess = "Неверная ссылка на c-rule-call-param в таблице c-thbj-attr".
     1301          run err-mess(input-output v-mess).
     1302       end.
     1303   define variable v-label-param as character no-undo .
     1304   v-label-param =
     1305     "call_id" + chr(4) + "Точка вызова" + chr(4) + "calldscr" + chr(8)
     1306    + "call#_id" + chr(4) + "Уник.идент.точки вызова" + chr(4) + "" + chr(8)
     1307    + "profile_id" + chr(4) + "Профайл" + chr(4) + ""  + chr(8)
     1308    + "codex_id" + chr(4) + "Кодекс" + chr(4) + ""  + chr(8)
     1309    + "ruleset_id" + chr(4) + "Набор правил" + chr(4) + ""  + chr(8)
     1310    + "order_id" + chr(4) + "Порядок вызова" + chr(4) + ""  + chr(8)
     1311    + "rule_id" + chr(4) + "№ правила" + chr(4) + ""  + chr(8)
     1312    + "param-des" + chr(4) + "Описание параметра" + chr(4) + ""  + chr(8)
     1313    + "param-data-type" + chr(4) + "Тип данных" + chr(4) + ""  + chr(8)
     1314    + "param-2-data-type" + chr(4) + "Тип данных2" + chr(4) + ""  + chr(8)
     1315    + "param-3-data-type" + chr(4) + "Тип данных3" + chr(4) + ""  + chr(8)
     1316    + "param-label" + chr(4) + "Лейбл параметра" + chr(4) + ""  + chr(8)
     1317    + "param-mode" + chr(4) + "Мода параметра" + chr(4) + ""  + chr(8)
     1318    + "param-name" + chr(4) + "Имя параметра" + chr(4) + ""  + chr(8)
     1319    + "p-index" + chr(4) + "Индекс" + chr(4) + ""  + chr(8)
     1320    + "param-num" + chr(4) + "№ параметра" + chr(4) + ""  + chr(8)
     1321    + "param-value-character" + chr(4) + "Значение параметра" + chr(4) + ""  + chr(8)
     1322    + "param-value-date" + chr(4) + "Значение параметра" + chr(4) + ""  + chr(8)
     1323    + "param-value-decimal" + chr(4) + "Значение параметра" + chr(4) + ""  + chr(8)
