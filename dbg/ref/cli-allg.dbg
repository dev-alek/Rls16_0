        1   block-level on error undo, throw.
        2   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        3   define input  parameter p-open-query     as logical   no-undo .
        4   define input  parameter p-find-next      as logical   no-undo .
        5   define input  parameter p-find-condition as character no-undo .
        6   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        7   define input     parameter attr-option_   as character no-undo .
        8   define input     parameter show-as        as character no-undo .
        9   define input     parameter JoinType       as character no-undo .
       10   define input     parameter Cli-Types      as character no-undo .
       11   define input     parameter Curr-grp-name  as character no-undo .
       12   define input     parameter NameOrCode     as character no-undo .
       13   define input     parameter SupGds         as logical no-undo .
       14   define input     parameter SupCOns        as logical no-undo .
       15   define input     parameter SupServ        as logical no-undo .
       16   define input     parameter BuyGds         as logical no-undo .
       17   define input     parameter BuyCons        as logical no-undo .
       18   define input     parameter BuyServ        as logical no-undo .
       19   define input     parameter Wlim-Kr        as logical no-undo .
       20   define input     parameter v-list-b       as logical   no-undo .
       21   define input-output param  p-rid-list     as  character no-undo .
       22   define input parameter filter-point as character no-undo .
       23   define input parameter filter-point0 as character no-undo .
       24   define input parameter sort-column-name as character no-undo .
       25   define output parameter p-filter-name   as character  no-undo .
       26   define input-output parameter v-doc-rec as recid no-undo .
       27   def var vss-revision    as character no-undo init "$Revision$":U .
       28   def var vss-author      as character no-undo init "$Author$":U .
       29   def var vss-date        as character no-undo init "$Date$":U .
       30   def var vss-workfile    as character no-undo init "$Workfile$":U .
       31   def var vss-archive     as character no-undo init "$Archive$":U .
       32   def var vss-description as character no-undo init "Список клиентов  - открытие запроса".
       33   procedure vss-get-info :
       34     define output parameter p-vss-revision    like vss-revision    no-undo .
       35     define output parameter p-vss-author      like vss-author      no-undo .
       36     define output parameter p-vss-date        like vss-date        no-undo .
       37     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       38     define output parameter p-vss-archive     like vss-archive     no-undo .
       39     define output parameter p-vss-description like vss-description no-undo .
       40     assign
       41       p-vss-revision    = vss-revision
       42       p-vss-author      = vss-author
       43       p-vss-date        = vss-date
       44       p-vss-workfile    = vss-workfile
       45       p-vss-archive     = vss-archive
       46       p-vss-description = vss-description
       47     .
       48   end procedure.
       49   procedure vss-get-parameters :
       50     define output parameter p-vss-parameters as character no-undo .
       51   end procedure.
       52   define new global shared variable g#vssrevis-logger as handle    no-undo .
       53   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       54   define variable v-vssrevis-logger                   as handle    no-undo .
       55   procedure vss-logevent :
       56     define input  parameter p-extra-paramters as character no-undo .
       57     define variable v-vssrevis-parameters as character no-undo .
       58     do
       59     on error undo, return error return-value
       60     :
       61       if  valid-handle(v-vssrevis-logger)
       62       and v-vssrevis-logger :get-signature("logevent") <> ""
       63       then do:
       64         run vss-get-parameters in this-procedure
       65           (output v-vssrevis-parameters
       66           ).
       67         run logevent in v-vssrevis-logger
       68           (input vss-workfile
       69           ,input vss-revision
       70           ,input v-vssrevis-parameters
       71           ,input p-extra-paramters
       72           ).
       73       end.
       74     end.
       75   end procedure.
       76   assign
       77     v-vssrevis-logger = g#vssrevis-logger
       78   .
       79   if  valid-handle(v-vssrevis-logger)
       80   and v-vssrevis-logger :get-signature("logevent") <> ""
       81   then do:
       82     assign
       83       v-vssrevis-logevent = true
       84     .
       85     run vss-logevent in this-procedure (input vss-description) .
       86   end.
       87   define new global shared variable g#language as character no-undo .
       88   if g#language <> '' and g#language <> 'rus':U then do:
       89     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       90   end.
       91   define new global shared variable g#library  as handle no-undo .
       92   define new global shared variable g#library2 as handle no-undo .
       93   define   shared variable g#auto as logical no-undo.
       94   define   shared variable g#news as logical no-undo.
       95   define   shared variable g#oxml as logical no-undo.
       96   define   shared variable g#esys as logical no-undo.
       97   define   shared variable g#news-source-db as integer no-undo.
       98   define   shared variable g#esys-source-esys as integer no-undo.
       99   define   shared variable g#db-num as integer   no-undo .
      100   define   shared variable g#userid as character no-undo .
      101   define   shared variable g#passwd as character no-undo .
      102   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      103   define variable v-waitfram-action01         as character   no-undo .
      104   define variable v-waitfram-action02         as character   no-undo .
      105   define variable v-waitfram-action03         as character   no-undo .
      106   define variable mWaitFramTextBeg            as character   no-undo.
      107   define variable mWaitFramTextEnd            as character   no-undo.
      108   define variable mWaitFramView               as logical     no-undo.
      109   define variable mWaitProcEvent              as logical     no-undo init yes.
      110   define variable mWaitFramInterval           as integer     no-undo init 1 .
      111   define variable mWaitFramStop               as logical     no-undo.
      112   define variable mWaitFramStopUser           as logical     no-undo.
      113   define variable mWaitFramStopTimeOut        as logical     no-undo.
      114   define variable mWaitFramStartProc          as datetime-tz no-undo.
      115   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      116   define button B-WaitFramStop auto-end-key
      117        label "Стоп"
      118        size 10 by 1 tooltip "Остоновить процесс".
      119   define button B-viewProcInfo
      120        label "Информация"
      121        size 15 by 1 tooltip "Информация о процесс".
      122   define frame waitfram
      123     v-waitfram-action01 format "x(72)" no-label skip
      124     v-waitfram-action02 format "x(72)" no-label skip
      125     v-waitfram-action03 format "x(72)" no-label skip
      126     B-viewProcInfo
      127     B-WaitFramStop at row 4 col 30
      128     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      129     .
      130   define new global shared variable mBatchMode as logical no-undo init ?.
      131   define variable mFramBachModHandle as handle no-undo.
      132   mFramBachModHandle = frame waitfram:handle.
      133   define variable mFameOldVis as logical no-undo.
      134   define variable mVisCUrentVin as logical no-undo.
      135   if session:batch-mode
      136   then
      137      mBatchMode = yes.
      138   if mBatchMode = ? then do:
      139     mVisCUrentVin = current-window:visible.
      140     mFameOldVis = mFramBachModHandle:visible.
      141     mFramBachModHandle:visible  = yes.
      142     mBatchMode = mFramBachModHandle:visible ne yes.
      143     mFramBachModHandle:visible = mFameOldVis.
      144     current-window:visible = mVisCUrentVin.
      145   end.
      146    if  log-manager:logfile-name ne ?
      147     then DO:
      148         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      149         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      150         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      151     end.
      152   on choose of B-WaitFramStop in frame waitfram
      153   do:
      154     mWaitFramStop = yes.
      155     mWaitFramStopUser = yes.
      156   end.
      157   function waitfram-check-timeout returns logical():
      158      define variable vtime as int64 no-undo.
      159      if mWaitFramStopTimeOut
      160      then
      161         return yes.
      162      vtime = ( now - mWaitFramStartProc ) / 1000 .
      163      if     mWaitFramTimeOut ne ?
      164         and mWaitFramTimeOut ne 0
      165         and mWaitFramTimeOut lt vtime
      166      then do:
      167         mWaitFramStopTimeOut = yes.
      168      end.
      169      return mWaitFramStopTimeOut.
      170   end.
      171   procedure waitfram-hide :
      172     if not session:batch-mode
      173     then do
      174     on error undo, return error return-value
      175     :
      176       pause 0 before-hide .
      177       if not mBatchMode then
      178         hide frame waitfram .
      179     if     not mWaitFramView
      180        and mWaitProcEvent
      181     then
      182       process events .
      183     end.
      184   end procedure.
      185   procedure waitfram-show :
      186     define input  parameter p-message as character no-undo .
      187     define variable v-left-margin as integer   no-undo .
      188     if not session:batch-mode
      189     then do
      190     on error undo, return error return-value
      191     :
      192       if length(p-message) <= 70 then do:
      193         assign
      194           v-left-margin = integer((70 - length(p-message)) / 2)
      195         .
      196         assign
      197           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      198         .
      199         assign
      200           v-waitfram-action01 = " "
      201           v-waitfram-action02 = " "
      202                                    + fill(" ", v-left-margin)
      203                                    + p-message
      204           v-waitfram-action03 = " "
      205         .
      206       end.
      207       else do:
      208         define variable vRindex1 as integer no-undo.
      209         define variable vRindex2 as integer no-undo.
      210         vRindex1 = r-index(p-message," ",70).
      211         if vRindex1 = 0
      212         then
      213            vRindex1 = 70.
      214         if length(p-message)  <= vRindex1 + 70 then do:
      215           assign
      216             v-waitfram-action01 = " "
      217             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      218             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      219           .
      220         end.
      221         else do:
      222           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      223           if vRindex2 <= vRindex1
      224           then
      225              vRindex2 = vRindex1 + 70.
      226           assign
      227             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      228             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      229             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      230           .
      231         end.
      232       end.
      233       B-viewProcInfo:visible   in frame waitfram = no.
      234       B-viewProcInfo:sensitive in frame waitfram = no.
      235       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      236       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      237       if  (   mWaitFramView
      238          or  mWaitProcEvent)
      239          and not mBatchMode
      240       then
      241          display
      242             v-waitfram-action01 skip
      243             v-waitfram-action02 skip
      244             v-waitfram-action03 skip
      245          with frame waitfram .
      246       if     mWaitFramView
      247          then do:
      248             if     mWaitFramInterval ne ?
      249                and not mBatchMode
      250             then
      251                wait-for go of frame waitfram pause mWaitFramInterval.
      252          end.
      253          else
      254             if     mWaitProcEvent
      255                and not mBatchMode
      256             then
      257                process events .
      258     end.
      259   end procedure.
      260      procedure waitfram-show-this:
      261         define input  parameter iInterval as int64 no-undo.
      262         define variable vtime as int64 no-undo.
      263         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      264         mWaitFramInterval = iInterval.
      265         run waitfram-show (substitute("&1&2 &3&4" ,
      266                                       mWaitFramTextBeg ,
      267                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      268                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      269                                       mWaitFramTextEnd
      270                                      )
      271                           ).
      272      end.
      273      procedure WaitFramRunPause:
      274         define input  parameter iInterval as dec no-undo.
      275         define variable vStart  as datetime-tz no-undo.
      276         define variable vend    as datetime-tz no-undo.
      277         define variable vint as int64 no-undo.
      278         define variable vOk as logical no-undo.
      279         vStart = now.
      280         vend   = vStart.
      281         publish "WaitFramPause" (iInterval,output vOk).
      282         vend   =  now.
      283         vint = vend - vStart.
      284         vint = iInterval - vint / 1000.
      285         if     not mWaitFramStop
      286            and (   vint > 0
      287                 or (    not vOk
      288                     and iInterval eq ?
      289                     )
      290                 )
      291         then
      292            run waitfram-show-this (iInterval).
      293         vend   =  now.
      294         vint = vend - vStart.
      295         vint = iInterval - vint / 1000.
      296         if     not mWaitFramStop
      297            and vint > 0
      298         then do:
      299            run gbl/pause.p (vint * 1000).
      300         end.
      301         if iInterval ne ?
      302         then
      303            publish "WaitFramStop".
      304         waitfram-check-timeout().
      305      end.
      306      procedure WaitFramWaitFor:
      307         define input  parameter iInterval as dec no-undo.
      308         assign
      309            mWaitFramStartProc   = now
      310            mWaitFramStopUser    = no
      311            mWaitFramStopTimeOut = no
      312         .
      313         block-wait:
      314         do while not mWaitFramStop:
      315            run WaitFramRunPause (iInterval).
      316            if  waitfram-check-timeout()
      317            then do:
      318               leave block-wait.
      319            end.
      320         end.
      321         run waitfram-hide.
      322      end.
      323   procedure waitfram-join :
      324     define input  parameter p-line-1  as character no-undo .
      325     define input  parameter p-line-2  as character no-undo .
      326     define input  parameter p-line-3  as character no-undo .
      327     define output parameter p-message as character no-undo .
      328     do
      329     on error undo, return error return-value
      330     :
      331       assign
      332         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      333                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      334                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      335       .
      336     end.
      337   end procedure.
      338   function waitfram-join-function returns character
      339     (input p-line-1 as character
      340     ,input p-line-2 as character
      341     ,input p-line-3 as character
      342     ).
      343     define variable v-message as character no-undo .
      344     run waitfram-join in this-procedure
      345       (input  p-line-1
      346       ,input  p-line-2
      347       ,input  p-line-3
      348       ,output v-message
      349       ) .
      350     return v-message .
      351   end function .
      352    define shared temp-table temp-list-buyer no-undo ~
      353   field obj-type as character ~
      354   field obj-code as integer   ~
      355   index pi is primary unique  ~
      356   obj-type ~
      357   obj-code.
      358   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      359   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      360   procedure fltopend_fltopend :
      361   define input parameter p-parent-handle as handle no-undo .
      362   define input parameter p-qh as handle no-undo .
      363   define input parameter p-flt-open-open-query  as character no-undo .
      364   define input parameter p-where-cond as character no-undo .
      365   define input parameter p-use-indFIRST-query-tail as character no-undo .
      366   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      367   define input parameter p-indexed-reposition as character no-undo .
      368     do
      369     on error undo, return error
      370     :
      371   define variable v-prepare-string as character no-undo .
      372   define variable glog as logical no-undo .
      373   assign
      374   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      375                      p-where-cond + chr(32)  +
      376                      p-use-indFIRST-query-tail + chr(32) +
      377                      p-use-ind-sort-clmn-by + chr(32) +
      378                      p-indexed-reposition
      379   .
      380   assign
      381   glog = p-qh:query-prepare(v-prepare-string) no-error .
      382   if not glog
      383   or error-status:error then do:
      384     message error-status:get-message(1) view-as alert-box .
      385     undo, return error .
      386   end.
      387   assign
      388   glog = p-qh:query-open no-error .
      389   if not glog
      390   or error-status:error then do:
      391     message error-status:get-message(1) view-as alert-box .
      392     undo, return error .
      393   end.
      394     end.
      395   end procedure.
      396   procedure fltopend_fltfindd :
      397   define input parameter p-parent-handle as handle no-undo .
      398   define input parameter p-qh as handle no-undo .
      399   define input parameter p-rowid as rowid no-undo .
      400   define input parameter p-next as logical no-undo .
      401   define input parameter p-lock as integer no-undo .
      402   define input parameter p-bh as handle no-undo .
      403   define input parameter p-where-cond as character no-undo .
      404   define input parameter p-use-index-phrase as character no-undo .
      405   define variable glog as logical no-undo .
      406   define variable v-qh as handle no-undo .
      407   define variable v-bh as handle no-undo .
      408   define variable v-recid as recid no-undo .
      409   define variable v-prepare-string as character no-undo .
      410   do
      411   on error undo, return error
      412   on stop undo, return error
      413   :
      414     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      415     create buffer v-bh for table p-bh buffer-name p-bh:name.
      416     create query v-qh.
      417     v-qh:set-buffers(v-bh).
      418     v-prepare-string = substitute("for each &1 &2 &3"
      419                                     ,v-bh:name
      420                                     ,p-where-cond
      421                                     ,p-use-index-phrase).
      422     glog = v-qh:query-prepare(v-prepare-string) no-error.
      423     if not glog then do:
      424       delete object v-qh.
      425       delete object v-bh.
      426       undo, return error .
      427     end.
      428     glog = v-qh:query-open no-error .
      429     if not glog then do:
      430       delete object v-qh.
      431       delete object v-bh.
      432       undo, return error .
      433     end.
      434     if p-next then do:
      435       v-qh:reposition-to-rowid(p-rowid) no-error .
      436       glog = v-qh:get-next( p-lock) no-error .
      437       glog = v-qh:get-next( p-lock) no-error .
      438       if not glog or v-qh:query-off-end = yes then do:
      439         glog = v-qh:get-first( p-lock) no-error .
      440       end.
      441     end.
      442     else do:
      443       glog = v-qh:get-first( p-lock) no-error .
      444     end.
      445     v-recid = v-bh:recid no-error .
      446     delete object v-qh.
      447     delete object v-bh.
      448     return string(v-recid) .
      449   end.
      450   end procedure.
      451   procedure fltopend_fltfindq :
      452   define input parameter p-parent-handle as handle no-undo .
      453   define input parameter p-qh as handle no-undo .
      454   define input parameter p-next as logical no-undo .
      455   define input parameter p-lock as integer no-undo .
      456   define input parameter p-flt-open-open-query  as character no-undo .
      457   define input parameter p-where-cond as character no-undo .
      458   define input parameter p-use-indFIRST-query-tail as character no-undo .
      459   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      460   define input parameter p-indexed-reposition as character no-undo .
      461   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      462   define variable glog as logical no-undo .
      463   define variable v-qh as handle no-undo .
      464   define variable v-bh as handle no-undo extent 18.
      465   define variable v-rowid as rowid no-undo extent 18.
      466   define variable v-ii as integer no-undo .
      467   define variable v-prepare-string as character no-undo .
      468   do
      469   on error undo, return error
      470   on stop undo, return error
      471   :
      472     create query v-qh.
      473     do v-ii = 1 to p-qh:num-buffers:
      474       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      475       assign
      476       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      477       no-error.
      478       v-qh:add-buffer(v-bh[v-ii]).
      479     end.
      480     assign
      481     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      482                       p-where-cond + chr(32)  +
      483                       p-use-indFIRST-query-tail + chr(32) +
      484                       p-use-ind-sort-clmn-by + chr(32) +
      485                       p-indexed-reposition
      486     .
      487     glog = v-qh:query-prepare( v-prepare-string) no-error .
      488     if not glog then do:
      489       delete object v-qh.
      490       do v-ii = 1 to p-qh:num-buffers:
      491         delete object v-bh[v-ii].
      492       end.
      493       undo, return error .
      494     end.
      495     glog = v-qh:query-open no-error .
      496     if not glog then do:
      497       delete object v-qh.
      498       do v-ii = 1 to p-qh:num-buffers:
      499         delete object v-bh[v-ii].
      500       end.
      501       undo, return error .
      502     end.
      503     if p-next then do:
      504       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      505       glog = v-qh:get-next( p-lock) no-error .
      506       glog = v-qh:get-next( p-lock) no-error .
      507       if not glog or v-qh:query-off-end = yes then do:
      508         glog = v-qh:get-first( p-lock) no-error .
      509       end.
      510     end.
      511     else do:
      512       glog = v-qh:get-first( p-lock) no-error .
      513     end.
      514     do v-ii = 1 to p-qh:num-buffers:
      515       assign
      516       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      517       no-error.
      518     end.
      519     delete object v-qh.
      520     do v-ii = 1 to p-qh:num-buffers:
      521       delete object v-bh[v-ii].
      522     end.
      523   end.
      524   end procedure.
      525   DEFINE SHARED BUFFER X_clients FOR ub.clients.
      526   DEFINE SHARED BUFFER x_temp-list-buyer FOR temp-list-buyer.
