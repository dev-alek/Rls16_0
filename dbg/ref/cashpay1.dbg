        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-silent as logical no-undo .
        4   define input-output parameter par-rid as recid no-undo .
        5   define input parameter par-mode as character no-undo .
        6   define input parameter parcdpay-code  like ub.cash-pay.cdpay-code  no-undo .
        7   define input parameter parobj-name  like ub.cash-pay.obj-name  no-undo .
        8   define input parameter parcurr-code like ub.cash-pay.curr-code no-undo .
        9   define input parameter parpay-code  like ub.cash-pay.pay-code  no-undo .
       10   define input parameter parwth-code  like ub.cash-pay.wth-code  no-undo .
       11   define input parameter parpay-limit like ub.cash-pay.pay-limit no-undo .
       12   define input parameter paris-cash   like ub.cash-pay.is-cash   no-undo .
       13   define input parameter par-atr1     like ub.cash-pay.atr1      no-undo .
       14   define input parameter par-atr2     like ub.cash-pay.atr2      no-undo .
       15   define input parameter par-atr4     like ub.cash-pay.atr4      no-undo .
       16   define input parameter par-atr8     like ub.cash-pay.atr8      no-undo .
       17   define input parameter par-atr16    like ub.cash-pay.atr16     no-undo .
       18   define input parameter par-atr32    like ub.cash-pay.atr32     no-undo .
       19   define input parameter par-atr64    like ub.cash-pay.atr64     no-undo .
       20   define input parameter par-atr128    like ub.cash-pay.atr128     no-undo .
       21   define input parameter parpay-card-view like ub.cash-pay.pay-card-view no-undo .
       22   define input parameter par-is-advance    like ub.cash-pay.is-advance     no-undo .
       23   define input parameter par-is-credit     like ub.cash-pay.is-credit      no-undo .
       24   define input parameter par-is-credit-card like ub.cash-pay.is-credit-card no-undo .
       25   define input parameter par-is-debet-card like ub.cash-pay.is-debet-card no-undo .
       26   define input parameter par-is-all-pay     like ub.cash-pay.is-all-pay     no-undo .
       27   define input parameter par-is-bar-read    like ub.cash-pay.is-bar-read    no-undo .
       28   define input parameter par-is-card-swap   like ub.cash-pay.is-card-swap   no-undo .
       29   define input parameter par-is-goods-pay   like ub.cash-pay.is-goods-pay   no-undo .
       30   define input parameter par-is-service-pay like ub.cash-pay.is-service-pay no-undo .
       31   define input parameter par-is-kbo         like ub.cash-pay.is-kbo no-undo .
       32   define input parameter par-is-lnr         like ub.cash-pay.is-lnr no-undo .
       33   define input parameter par-can-mix        like ub.cash-pay.can-mix no-undo .
       34   define input parameter par-has-return     like ub.cash-pay.has-return no-undo .
       35   define input parameter par-has-overpay    like ub.cash-pay.has-overpay no-undo .
       36   define input parameter par-rule-file-name like ub.cash-pay.rule-file-name no-undo .
       37   define input parameter par-slip-file-name like ub.cash-pay.slip-file-name no-undo .
       38   define input parameter par-register       like ub.cash-pay.register no-undo .
       39   define variable vss-revision    as character no-undo init "$Revision: b9071463af06, 3465, rls $":U .
       40   define variable vss-author      as character no-undo init "$Author: VSpiridonov $":U .
       41   define variable vss-date        as character no-undo init "$Date: 2023/10/16 15:13:34 $":U .
       42   define variable vss-workfile    as character no-undo init "$Workfile: cashpay1.p $":U .
       43   define variable vss-archive     as character no-undo init "$Archive: ref/cashpay1.p $":U .
       44   define variable vss-description as character no-undo init "Сохранение изменений в типе кассовых платежей".
       45   procedure vss-get-info :
       46     define output parameter p-vss-revision    like vss-revision    no-undo .
       47     define output parameter p-vss-author      like vss-author      no-undo .
       48     define output parameter p-vss-date        like vss-date        no-undo .
       49     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       50     define output parameter p-vss-archive     like vss-archive     no-undo .
       51     define output parameter p-vss-description like vss-description no-undo .
       52     assign
       53       p-vss-revision    = vss-revision
       54       p-vss-author      = vss-author
       55       p-vss-date        = vss-date
       56       p-vss-workfile    = vss-workfile
       57       p-vss-archive     = vss-archive
       58       p-vss-description = vss-description
       59     .
       60   end procedure.
       61   procedure vss-get-parameters :
       62     define output parameter p-vss-parameters as character no-undo .
       63   end procedure.
       64   define new global shared variable g#vssrevis-logger as handle    no-undo .
       65   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       66   define variable v-vssrevis-logger                   as handle    no-undo .
       67   procedure vss-logevent :
       68     define input  parameter p-extra-paramters as character no-undo .
       69     define variable v-vssrevis-parameters as character no-undo .
       70     do
       71     on error undo, return error return-value
       72     :
       73       if  valid-handle(v-vssrevis-logger)
       74       and v-vssrevis-logger :get-signature("logevent") <> ""
       75       then do:
       76         run vss-get-parameters in this-procedure
       77           (output v-vssrevis-parameters
       78           ).
       79         run logevent in v-vssrevis-logger
       80           (input vss-workfile
       81           ,input vss-revision
       82           ,input v-vssrevis-parameters
       83           ,input p-extra-paramters
       84           ).
       85       end.
       86     end.
       87   end procedure.
       88   assign
       89     v-vssrevis-logger = g#vssrevis-logger
       90   .
       91   if  valid-handle(v-vssrevis-logger)
       92   and v-vssrevis-logger :get-signature("logevent") <> ""
       93   then do:
       94     assign
       95       v-vssrevis-logevent = true
       96     .
       97     run vss-logevent in this-procedure (input vss-description) .
       98   end.
       99   define new global shared variable g#language as character no-undo .
      100   if g#language <> '' and g#language <> 'rus':U then do:
      101     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      102   end.
      103   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      104     define variable v-cntxt-db-num        as integer   no-undo .
      105     define variable v-cntxt-userid        as character no-undo .
      106     define variable v-cntxt-level         as character no-undo .
      107     define variable v-cntxt-host-code-obj as integer   no-undo .
      108     define variable v-cntxt-obj-type      as character no-undo .
      109     define variable v-cntxt-obj-code      as integer   no-undo .
      110     define variable v-cntxt-db-num-obj    as integer   no-undo .
      111     define variable v-cntxt-is-admin      as logical   no-undo .
      112   define new global shared variable g#library  as handle no-undo .
      113   define new global shared variable g#library2 as handle no-undo .
      114   define   shared variable g#auto as logical no-undo.
      115   define   shared variable g#news as logical no-undo.
      116   define   shared variable g#oxml as logical no-undo.
      117   define   shared variable g#esys as logical no-undo.
      118   define   shared variable g#news-source-db as integer no-undo.
      119   define   shared variable g#esys-source-esys as integer no-undo.
      120   define   shared variable g#db-num as integer   no-undo .
      121   define   shared variable g#userid as character no-undo .
      122   define   shared variable g#passwd as character no-undo .
      123   DEFINE VARIABLE loc#log as logical no-undo .
      124   DEFINE VARIABLE var-entry as character no-undo .
      125   DEFINE VARIABLE is-wth as logical no-undo .
      126   DEFINE VARIABLE conf-par as character no-undo .
      127   DEFINE VARIABLE par-type as character no-undo .
      128   define variable v-mess as character no-undo .
      129   define variable glog as logical no-undo .
      130   define buffer buf_cash-pay for ub.cash-pay.
      131   define buffer buf_db for ub.db.
      132   define buffer buf_chk-pay for ub.chk-pay.
      133   do
      134   on error undo, return error return-value
      135   :
      136   define variable v-value as character no-undo.
      137   define variable v-ttype as character no-undo.
      138     if NOT (par-mode = 'ДОБАВЛЕНИЕ':U OR par-mode = 'ИЗМЕНЕНИЕ':U) then do:
      139       message
      140       vss-workfile vss-revision vss-description skip
      141       "Неверный параметр вызова par-mode" par-mode
      142       view-as alert-box ERROR.
      143       return error '':U.
      144     end.
      145     if par-mode = 'ДОБАВЛЕНИЕ':U AND
      146       can-find(FIRST ub.cash-pay where
      147                     ub.cash-pay.cdpay-code = parcdpay-code AND
      148                     ub.cash-pay.curr-code = parcurr-code
      149                     ) then do:
      150       message
      151       vss-workfile vss-revision vss-description skip
      152       "Неверный параметр вызова parcdpay-code " parcdpay-code
      153       "и/или parcurr-code " parcurr-code
      154       "Уже есть тип кассового платежа:"  skip
      155       "Код платежа" parcdpay-code SKIP
      156       "Код валюты" parcurr-code
      157       view-as alert-box ERROR.
      158       return error '':U.
      159     end.
      160     run gbl/conf-rd.p ("is-erpRN", "", "", 0, "", "", "", no, output v-value, output v-ttype) no-error.
      161     if v-value = "no"  then do:
      162   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      163     run mainmenu_getcntxt in parparentproc
      164       (output v-cntxt-db-num
      165       ,output v-cntxt-userid
      166       ,output v-cntxt-level
      167       ,output v-cntxt-host-code-obj
      168       ,output v-cntxt-obj-type
      169       ,output v-cntxt-obj-code
      170       ,output v-cntxt-db-num-obj
      171       ,output v-cntxt-is-admin
      172       ) .
      173     if v-cntxt-db-num <> 0 then do:
      174       message
      175       vss-workfile vss-revision vss-description skip
      176       "Запрещено создание и редактирование типа кассового платежа в УБД "
      177       view-as alert-box ERROR.
      178       return error '':U.
      179     end.
      180     end.
      181     run trg/cashpay2.p (
      182                      input p-silent
      183                     ,INPUT parcdpay-code
      184                     ,INPUT parobj-name
      185                     ,INPUT parcurr-code
      186                     ,INPUT parpay-code
      187                     ,INPUT parwth-code
      188                     ,INPUT parpay-limit
      189                     ,INPUT parpay-card-view
      190                     ) no-error.
      191     if error-status:error then do:
      192       return error return-value.
      193     end.
      194     if paris-cash then do:
      195       if par-is-credit-card
      196       or par-is-debet-card
      197       or par-atr128
      198       or (parpay-card-view <> "":U and p-silent)
      199       or par-is-card-swap
      200       or par-atr32
      201       or par-atr16
      202       or par-atr4 then do:
      203         v-mess = substitute("Платеж со свойством <Наличные> не может одновременно иметь свойства КРЕДИТНАЯ КАРТА, ДЕБЕТОВАЯ КАРТА,&1" +
      204                             "НЕОБХОДИМА ON-LINE АВТОРИЗАЦИЯ, ОБЯЗАТЕЛЕН ВВОД PIN-КОДА, <ПРОКАТЫВАТЬ КАРТУ>, ИСПОЛЬЗОВАТЬ СКАНЕР БАР-КОДОВ,&1"  +
      205                             "ПРЕФИКСЫ ПЛАТЕЖНЫХ КАРТ ДЛЯ ПРОСМОТРА, ПЛАТЕЖ ПО СМАРТ-КАРТЕ"
      206                             , chr(10)).
      207         run err-mess in this-procedure ( input-output v-mess).
      208         return error (if p-silent = yes then v-mess else 'is-cash':U).
      209       end.
      210     end.
      211     if paris-cash then do:
      212       if parpay-card-view <> "":U
      213       and not p-silent
      214       then do:
      215         message
      216         "Вы уверены, что платеж со свойством <Наличные> имеет" skip
      217         "ПРЕФИКСЫ ПЛАТЕЖНЫХ КАРТ ДЛЯ ПРОСМОТРА?"
      218         view-as alert-box question buttons yes-no update glog.
      219         if not glog then return error "is-cash:U".
      220       end.
      221     end.
      222     if parcdpay-code = 1 then do:
      223       if paris-cash = no then do:
      224         v-mess = "Тип кассового платежа с кодом 1 ДОЛЖЕН  иметь свойство НАЛИЧНЫЕ".
      225         run err-mess in this-procedure ( input-output v-mess).
      226         return error (if p-silent = yes then v-mess else 'is-cash':U).
      227       end.
      228       if par-has-overpay = 1 then  do:
      229         v-mess = "Тип кассового платежа с кодом 1 НЕ ДОЛЖЕН  иметь свойство Разрешена переплата".
      230         run err-mess in this-procedure ( input-output v-mess).
      231         return error (if p-silent = yes then v-mess else 'has-overpay':U).
      232       end.
      233       if par-atr1 = no then do:
      234         v-mess = "Тип кассового платежа с кодом 1 ДОЛЖЕН  иметь свойство Разрешается сдача на платеж".
      235         run err-mess in this-procedure ( input-output v-mess).
      236         return error (if p-silent = yes then v-mess else 'atr1':U).
      237       end.
      238       if par-has-return = 0 then do:
      239         v-mess = "Тип кассового платежа с кодом 1 ДОЛЖЕН  иметь свойство Разрешен Возврат".
      240         run err-mess in this-procedure ( input-output v-mess).
      241         return error (if p-silent = yes then v-mess else 'has-return':U).
      242       end.
      243       if par-can-mix = 0 then do:
      244         v-mess = "Тип кассового платежа с кодом 1 ДОЛЖЕН  иметь свойство Разрешена смешанная оплата".
      245         run err-mess in this-procedure ( input-output v-mess).
      246         return error (if p-silent = yes then v-mess else 'can-mix':U).
      247       end.
      248     end.
      249     if par-is-credit = yes then do:
      250       if paris-cash
      251       or par-is-credit-card
      252       or par-is-advance
      253       then do:
      254         v-mess = "Платеж <В кредит> не может одновременно иметь свойства НАЛИЧНЫЕ, КРЕДИТНАЯ КАРТА, УЧЕТ АВАНСА".
      255         run err-mess in this-procedure ( input-output v-mess).
      256         return error (if p-silent = yes then v-mess else 'is-credit':U).
      257       end.
      258     end.
      259     if par-is-advance = yes then do:
      260       if paris-cash
      261       or par-is-credit-card
      262       or par-is-debet-card
      263       or par-is-credit
      264       then do:
      265         v-mess = "Платеж <Учет аванса> не может одновременно иметь свойства НАЛИЧНЫЕ, КРЕДИТНАЯ КАРТА, ДЕБЕТОВАЯ КАРТА, ПЛАТЕЖ В КРЕДИТ".
      266         run err-mess in this-procedure ( input-output v-mess).
      267         return error (if p-silent = yes then v-mess else 'is-advance':U).
      268       end.
      269     end.
      270     if par-is-kbo > 0 then do:
      271       if parcurr-code <> 0 then do:
      272          v-mess = substitute("Атрибут КБО можно задать только для типа кассового платежа с нац. валютой").
      273         run err-mess in this-procedure ( input-output v-mess).
      274         return error (if p-silent = yes then v-mess else 'is-kbo':U).
      275       end.
      276       if paris-cash = yes then do:
      277         v-mess = substitute("Нельзя задать атрибут КБО для типа кассового платежа, имеющего свойство НАЛИЧНЫЕ").
      278         run err-mess in this-procedure ( input-output v-mess).
      279         return error (if p-silent = yes then v-mess else 'is-kbo':U).
      280       end.
      281       if par-atr16 = yes then do:
      282         v-mess =  substitute("Нельзя задать атрибут КБО для типа кассового платежа, имеющего свойство НЕОБХОДИМА ОНЛАЙН АВТОРИЗАЦИЯ").
      283         run err-mess in this-procedure ( input-output v-mess).
      284         return error (if p-silent = yes then v-mess else 'is-kbo':U).
      285       end.
      286     end.
      287     if par-mode = 'ДОБАВЛЕНИЕ':U then do:
      288       create buf_cash-pay.
      289       assign par-rid = recid(buf_cash-pay).
      290     end.
      291     else do:
      292       FIND FIRST buf_cash-pay EXCLUSIVE-LOCK WHERE
      293                 recid(buf_cash-pay) = par-rid NO-WAIT No-ERROR.
      294       if locked buf_cash-pay then do:
      295         v-mess = "Запись типа кассового платежа занята".
      296         run err-mess in this-procedure ( input-output v-mess).
      297         return error (if p-silent = yes then v-mess else '':U).
      298       end.
      299       if not avail buf_cash-pay then do:
      300         v-mess =  "Не найдена запись типа кассового платежа".
      301         run err-mess in this-procedure ( input-output v-mess).
      302         return error (if p-silent = yes then v-mess else '':U).
      303       end.
      304       if buf_cash-pay.cdpay-code <> parcdpay-code OR
      305       buf_cash-pay.curr-code <> parcurr-code then do:
      306         find first buf_db No-LOCK where buf_db.db-num > 0 No-ERROR.
      307         if not avail buf_db then do:
      308           FIND FIRST buf_chk-pay No-LOCK WHERE
      309                     buf_chk-pay.pay-code = parcdpay-code  AND
      310                     buf_chk-pay.curr-code = parcurr-code No-ERROR.
      311         end.
      312         if available buf_db or available buf_chk-pay then
      313         v-mess = substitute("&1 &2 &3 Для уже имеющейся записи нельзя изменить&4" +
      314                             "код типа платежа и код валюты&4" +
      315                             "в системе с УБД и/или если имеются чеки с таким типом кассового платежа"
      316                           , vss-workfile
      317                           ,vss-revision
      318                           ,vss-description
      319                           , chr(10)).
      320         run err-mess in this-procedure ( input-output v-mess).
      321         return error (if p-silent = yes then v-mess else '':U).
      322       end.
      323     end.
      324     assign
      325     buf_cash-pay.cdpay-code =  parcdpay-code
      326     buf_cash-pay.obj-name = parobj-name
      327     buf_cash-pay.curr-code = parcurr-code
      328     buf_cash-pay.pay-code = parpay-code
      329     buf_cash-pay.wth-code =  parwth-code
      330     buf_cash-pay.pay-limit = parpay-limit
      331     buf_cash-pay.is-cash = paris-cash
      332     buf_cash-pay.atr1 = par-atr1
      333     buf_cash-pay.atr2 =  par-atr2
      334     buf_cash-pay.atr4 =  par-atr4
      335     buf_cash-pay.atr8 =  par-atr8
      336     buf_cash-pay.atr16 = par-atr16
      337     buf_cash-pay.atr32 = par-atr32
      338     buf_cash-pay.atr64 = par-atr64
      339     buf_cash-pay.atr128 = par-atr128
      340     buf_cash-pay.pay-card-view = parpay-card-view
      341     buf_cash-pay.is-advance     = par-is-advance
      342     buf_cash-pay.is-credit      = par-is-credit
      343     buf_cash-pay.is-credit-card = par-is-credit-card
      344     buf_cash-pay.is-debet-card = par-is-debet-card
      345     buf_cash-pay.is-all-pay     =  par-is-all-pay
      346     buf_cash-pay.is-bar-read    =  par-is-bar-read
      347     buf_cash-pay.is-card-swap   =  par-is-card-swap
      348     buf_cash-pay.is-goods-pay   =  par-is-goods-pay
      349     buf_cash-pay.is-service-pay =  par-is-service-pay
      350     buf_cash-pay.is-kbo         =  par-is-kbo
      351     buf_cash-pay.is-lnr         =  par-is-lnr
      352     buf_cash-pay.can-mix        =  par-can-mix
      353     buf_cash-pay.has-return     =  par-has-return
      354     buf_cash-pay.has-overpay    =  par-has-overpay
      355     buf_cash-pay.rule-file-name =  par-rule-file-name
      356     buf_cash-pay.slip-file-name =  par-slip-file-name
      357     buf_cash-pay.status_        = (if par-mode = 'ДОБАВЛЕНИЕ':U then  'тек':U else buf_cash-pay.status_)
      358     buf_cash-pay.register       = par-register
      359     .
      360     release buf_cash-pay no-error.
      361     if error-status:error then do:
      362       v-mess = substitute("&1 &2 &3&4" +
      363                           "Ошибка при сохранении записи типа кассового платежа&4" +
      364                           "код платежа &5 код валюты &6&4&7&4&8"
      365                            ,vss-workfile
      366                            ,vss-revision
      367                            ,vss-description
      368                            ,chr(10)
      369                            ,parcdpay-code
      370                            ,parcurr-code
      371                            , error-status:get-message(1)
      372                            , return-value ).
      373       run err-mess in this-procedure ( input-output v-mess).
      374       return error (if p-silent = yes then v-mess else '':U).
      375     end.
      376     return '':U.
      377   end.
      378   PROCEDURE err-mess:
      379     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      380     CASE p-silent:
      381       when yes then
      382         do:
      383           assign
      384             p-mess = substitute("Тип касс.платежа с кодом &1 и кодом валюты &2&3&4"
      385                            , parcdpay-code
      386                            , parcurr-code
      387                            , chr(10)
      388                            , p-mess)
      389             .
      390         end.
      391       when no then
      392         do:
      393           if g#esys then
      394           do:
      395           assign
      396             p-mess = substitute("Тип касс.платежа с кодом &1 и кодом валюты &2&3&4"
      397                            , parcdpay-code
      398                            , parcurr-code
      399                            , chr(10)
      400                            , p-mess)
      401             .
      402             return error.
      403           end.
      404           else
      405           do:
      406             message
      407               p-mess
      408               view-as alert-box error .
      409           end.
      410         end.
      411     end.
      412   END PROCEDURE.
