     1061        LABEL "&Пар-тры типа кассы"
     1062        SIZE 20 BY 1.
     1063   DEFINE BUTTON B-exit AUTO-GO
     1064        LABEL "&Ввод"
     1065        SIZE 10 BY 1
     1066        BGCOLOR 8 .
     1067   DEFINE BUTTON B-Help
     1068        LABEL "Помо&щь"
     1069        SIZE 3 BY 1
     1070        BGCOLOR 8 .
     1071   DEFINE BUTTON B-hist
     1072        LABEL "Ис&тория"
     1073        SIZE 3 BY 1.
     1074   DEFINE BUTTON b-quit AUTO-GO
     1075        LABEL "&Отмена"
     1076        SIZE 10 BY 1
     1077        BGCOLOR 8 .
     1078   DEFINE VARIABLE cb-device-kind AS INTEGER FORMAT ">9":U
     1079        LABEL "Признак исполнения кассы"
     1080        VIEW-AS COMBO-BOX INNER-LINES 4
     1081        LIST-ITEM-PAIRS "Стандартное",0,
     1082                        "ТСО Элекснет",1,
     1083                        "ТСО Auto GC",2,
     1084                        "Мобильное приложение",3
     1085        DROP-DOWN-LIST
     1086        SIZE 25 BY 1.
     1087   DEFINE VARIABLE CB-fr-type AS CHARACTER FORMAT "x(15)"
     1088        LABEL "Тип ФР"
     1089        VIEW-AS COMBO-BOX INNER-LINES 5
     1090        LIST-ITEM-PAIRS "Item 1","Item 1",
     1091                        "Item 1","Item 1"
     1092        DROP-DOWN-LIST
     1093        SIZE 30 BY 1 TOOLTIP "Модель (класс, тип, марка) ККМ, Тип ФР".
     1094   DEFINE VARIABLE COMBO-protocol AS CHARACTER FORMAT "X(256)":U
     1095        LABEL "Протокол"
     1096        VIEW-AS COMBO-BOX INNER-LINES 5
     1097        LIST-ITEMS "","ftp","http","samba","SMTP"
     1098        DROP-DOWN-LIST
     1099        SIZE 10 BY 1 NO-UNDO.
     1100   DEFINE VARIABLE COMBO-protocol-maria AS CHARACTER FORMAT "X(256)":U
     1101        LABEL "Протокол"
     1102        VIEW-AS COMBO-BOX INNER-LINES 4
     1103        LIST-ITEMS "","local","remote","ftp","shared"
     1104        DROP-DOWN-LIST
     1105        SIZE 10 BY 1 NO-UNDO.
     1106   DEFINE VARIABLE f-cash-num-char AS CHARACTER FORMAT "X(256)":U
     1107        LABEL "Зав.#"
     1108        VIEW-AS FILL-IN
     1109        SIZE 27 BY 1 NO-UNDO.
     1110   DEFINE VARIABLE f-fr-type AS CHARACTER FORMAT "X(256)":U
     1111        LABEL "Модель ККМ"
     1112        VIEW-AS FILL-IN
     1113        SIZE 30 BY 1 TOOLTIP "Модель (класс, тип, марка) ККМ, Тип ФР" NO-UNDO.
     1114   DEFINE VARIABLE f-obj-name AS CHARACTER FORMAT "X(256)":U
     1115        VIEW-AS FILL-IN
     1116        SIZE 40.8 BY .95 NO-UNDO.
     1117   DEFINE VARIABLE f-pswd AS CHARACTER FORMAT "X(256)":U
     1118        LABEL "Пароль"
     1119        VIEW-AS FILL-IN
     1120        SIZE 27 BY 1 NO-UNDO.
     1121   DEFINE RECTANGLE RECT-1
     1122        EDGE-PIXELS 1 GRAPHIC-EDGE  NO-FILL
     1123        SIZE 77 BY 2.14.
     1124   DEFINE VARIABLE T-remote AS LOGICAL INITIAL no
     1125        LABEL "Удаленная"
     1126        VIEW-AS TOGGLE-BOX
     1127        SIZE 29 BY 1 NO-UNDO.
     1128   DEFINE QUERY Dialog-Frame FOR
     1129         tt-cash-desk,
     1130         cash-desk SCROLLING.
     1131   DEFINE FRAME Dialog-Frame
     1132        B-exit AT ROW 1 COL 1
     1133        b-quit AT ROW 1 COL 11
     1134        B-attr AT ROW 1 COL 31
     1135        B-attr-2 AT ROW 1 COL 41 WIDGET-ID 6
     1136        B-cli-attr AT ROW 1 COL 51
     1137        B-hist AT ROW 1 COL 77
     1138        B-Help AT ROW 1 COL 81
     1139        tt-cash-desk.cash-num AT ROW 2.52 COL 11.4 COLON-ALIGNED
     1140             LABEL "Номер"
     1141             VIEW-AS FILL-IN
     1142             SIZE 6 BY 1
     1143        tt-cash-desk.db-num AT ROW 2.5 COL 32.63 COLON-ALIGNED
     1144             LABEL "Номер БД"
     1145             VIEW-AS FILL-IN
     1146             SIZE 5.63 BY 1
     1147        tt-cash-desk.obj-code AT ROW 3.75 COL 11.63 COLON-ALIGNED
     1148             LABEL "Магазин"
     1149             VIEW-AS FILL-IN
     1150             SIZE 6.38 BY 1
     1151             BGCOLOR 15 FGCOLOR 0
     1152        f-obj-name AT ROW 3.75 COL 22.75 COLON-ALIGNED NO-LABEL
     1153        f-cash-num-char AT ROW 5 COL 11.63 COLON-ALIGNED
     1154        f-pswd AT ROW 5 COL 50 COLON-ALIGNED
     1155        tt-cash-desk.addr-path AT ROW 7.5 COL 27 COLON-ALIGNED
     1156             LABEL "Адрес/путь"
     1157             VIEW-AS FILL-IN
     1158             SIZE 25 BY 1
     1159             BGCOLOR 15 FGCOLOR 0
     1160        COMBO-protocol-maria AT ROW 7.5 COL 64 COLON-ALIGNED
     1161        COMBO-protocol AT ROW 7.5 COL 64 COLON-ALIGNED
     1162        cb-device-kind  AT ROW 6.29 COL 27 COLON-ALIGNED WIDGET-ID 14
     1163        tt-cash-desk.cash-os AT ROW 6.29 COL 64 COLON-ALIGNED
     1164             LABEL "Тип ОС"
     1165             VIEW-AS COMBO-BOX INNER-LINES 4
     1166             LIST-ITEMS "","DOS","LINUX","WINDOWS"
     1167             DROP-DOWN-LIST
     1168             SIZE 10 BY 1
     1169             BGCOLOR 15 FGCOLOR 0
     1170        tt-cash-desk.autonomy AT ROW 9.75 COL 13.63 NO-LABEL
     1171             VIEW-AS RADIO-SET HORIZONTAL
     1172             RADIO-BUTTONS
     1173                       "Item 1", 1,
     1174   "Item 2", 2,
     1175   "Item 3", 3
     1176             SIZE 66 BY 1
     1177        tt-cash-desk.pos-type AT ROW 11.29 COL 60.2 COLON-ALIGNED
     1178             LABEL "Тип POS"
     1179             VIEW-AS COMBO-BOX INNER-LINES 11
     1180             LIST-ITEM-PAIRS "1","1",
     1181                        "2","2",
     1182                        "3","3",
     1183                        "4","4",
     1184                        "5","5",
     1185                        "6","6",
     1186                        "7","7"
     1187             DROP-DOWN-LIST
     1188             SIZE 24 BY 1
     1189             BGCOLOR 15 FGCOLOR 0
     1190        CB-fr-type AT ROW 13.67 COL 11.2 COLON-ALIGNED WIDGET-ID 4
     1191        tt-cash-desk.version AT ROW 13.67 COL 60.2 COLON-ALIGNED
     1192             LABEL "Версия протокола"
     1193             VIEW-AS FILL-IN
     1194             SIZE 24 BY 1
     1195        f-fr-type AT ROW 14.81 COL 49.6 COLON-ALIGNED WIDGET-ID 8
     1196        T-remote AT ROW 14.95 COL 13
     1197        tt-cash-desk.registration-code AT ROW 16.14 COL 11.8 COLON-ALIGNED
     1198             LABEL "Регистр. №"
     1199             VIEW-AS FILL-IN
     1200             SIZE 30 BY 1
     1201        tt-cash-desk.serial-code AT ROW 16.14 COL 51.6 COLON-ALIGNED
     1202             LABEL "Сер. №"
     1203             VIEW-AS FILL-IN
     1204             SIZE 30 BY 1
     1205        RECT-1 AT ROW 9.14 COL 3 WIDGET-ID 10
     1206        SPACE(3.99) SKIP(7.76)
     1207       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1208            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1209            TITLE "Касса"
     1210            DEFAULT-BUTTON B-exit.
     1211   ASSIGN
     1212          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1213          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1214   ASSIGN
     1215          COMBO-protocol:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1216   ASSIGN
     1217          COMBO-protocol-maria:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1218   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1219   DO:
     1220     APPLY "END-ERROR":U TO SELF.
     1221   END.
     1222   ON VALUE-CHANGED OF cb-device-kind IN FRAME Dialog-Frame
     1223   DO:
     1224     if p-mode = 'ПРОСМОТР':U then return no-apply.
     1225     ASSIGN
     1226     cb-device-kind.
     1227     tt-cash-desk.pos-type = if    cb-device-kind eq mCashDevice:Tanker:keyint
     1228                                or cb-device-kind eq mCashDevice:TankerIntegr:keyint
     1229                             then 'Autotank':U
     1230                             else 'IBM-XML':U.
     1231     DISPLAY
     1232        tt-cash-desk.pos-type
     1233     WITH FRAME Dialog-Frame.
     1234   END.
     1235   ON VALUE-CHANGED OF tt-cash-desk.autonomy IN FRAME Dialog-Frame
     1236   DO:
     1237     if p-mode = 'ПРОСМОТР':U then return no-apply.
     1238     ASSIGN
     1239     tt-cash-desk.autonomy.
     1240     CASE tt-cash-desk.autonomy:
     1241         WHEN INTEGER('2':U) THEN DO:
     1242             ASSIGN
     1243             tt-cash-desk.cash-num = 0
     1244             .
     1245             DISPLAY
     1246             tt-cash-desk.cash-num
     1247             cb-device-kind
     1248             WITH FRAME Dialog-Frame.
     1249             DISABLE
     1250             tt-cash-desk.cash-num
     1251             WITH FRAME Dialog-Frame.
     1252         END.
     1253         OTHERWISE DO:
     1254             ASSIGN
     1255             tt-cash-desk.cash-num = tcode.
     1256             DISPLAY
     1257             tt-cash-desk.cash-num
     1258             cb-device-kind
     1259             WITH FRAME Dialog-Frame.
     1260             ENABLE
     1261             tt-cash-desk.cash-num when p-mode = 'ДОБАВЛЕНИЕ':U
     1262             cb-device-kind
     1263             WITH FRAME Dialog-Frame.
     1264         END.
     1265     END CASE.
     1266   END.
     1267   ON CHOOSE OF B-attr IN FRAME Dialog-Frame
     1268   DO:
     1269   define variable v-rid-list as character no-undo .
     1270     v-rid-list = string(recid(locked_cash-desk)).
     1271     if tt-cash-desk.pos-type = 'IBS-TH':U then do:
     1272       if p-mode <> 'ПРОСМОТР':U then do:
     1273         message
     1274         "Для данного типа кассы режим ИЗМЕНЕНИЕ для оперативных данных недоступен" skip
     1275         "предалагаем Оперативные данные в режиме ПРОСМОТР" skip
     1276         view-as alert-box .
     1277       end.
     1278       run ref/cda-cc.w ( input parparentproc
     1279                         ,input tt-cash-desk.db-num
     1280                         ,input 'маг':U
     1281                         ,input tt-cash-desk.obj-code
     1282                         ,input tt-cash-desk.pos-type
     1283                         ,input tt-cash-desk.cash-num
     1284                         ,input ''
     1285                         ,input-output v-rid-list) no-error.
     1286     end.
     1287     else do:
     1288       run ref/cd-atti.w (   input parparentproc
     1289                       ,input 'ПРОСМОТР':U
     1290                       ,input "oper"
     1291                       ,input tt-cash-desk.db-num
     1292                       ,input tt-cash-desk.obj-code
     1293                       ,input tt-cash-desk.pos-type
     1294                       ,input tt-cash-desk.cash-num
     1295                                           ,input no
     1296                     ).
     1297     end.
     1298   END.
     1299   ON CHOOSE OF B-attr-2 IN FRAME Dialog-Frame
     1300   DO:
     1301   define variable v-setted as logical no-undo .
     1302     case tt-cash-desk.pos-type:
     1303       when 'IBS-TH':U then do:
     1304           run ref/cda-29.w ( input parparentproc
     1305                             ,input 'ПРОСМОТР':U
     1306                             ,input tt-cash-desk.db-num
     1307                             ,input tt-cash-desk.obj-code
     1308                             ,input tt-cash-desk.pos-type
     1309                             ,input tt-cash-desk.cash-num
     1310                             ,input ""
     1311                             ,input ''
     1312                             ,output v-setted) no-error.
     1313       end.
     1314       when 'IBS-TH-MOB':U then do:
     1315           run ref/cda-31.w ( input parparentproc
     1316                             ,input 'ПРОСМОТР':U
     1317                             ,input tt-cash-desk.db-num
     1318                             ,input tt-cash-desk.obj-code
     1319                             ,input tt-cash-desk.pos-type
     1320                             ,input tt-cash-desk.cash-num
     1321                             ,input ""
     1322                             ,input ''
     1323                             ,output v-setted) no-error.
     1324       end.
     1325       otherwise do:
     1326         run ref/cd-atti.w (   input parparentproc
     1327                         ,input 'ПРОСМОТР':U
     1328                         ,input "ref"
     1329                         ,input tt-cash-desk.db-num
     1330                         ,input tt-cash-desk.obj-code
     1331                         ,input tt-cash-desk.pos-type
     1332                         ,input tt-cash-desk.cash-num
     1333                                             ,input no
     1334                       ).
     1335       end.
     1336     end case.
     1337   END.
     1338   ON CHOOSE OF B-cli-attr IN FRAME Dialog-Frame
     1339   DO:
     1340   define variable attr-type as character no-undo .
     1341   define variable attr-format as character no-undo .
     1342   define variable attr-label as character no-undo .
     1343   define variable attr-user-can-edit as logical no-undo .
     1344   define variable attr-output-display as logical no-undo .
     1345   define variable attr-other as char no-undo .
     1346   define variable attr-value as char no-undo .
     1347   define variable attr-prop-list      as character no-undo .
     1348   define variable attr-prop-type-list as character no-undo .
     1349   define variable attr-prop-label-list as character no-undo .
     1350   define variable attr-global          as logical no-undo .
     1351   define variable attr-host           as logical no-undo .
     1352   define variable attr-shop           as logical no-undo .
     1353   define variable attr-store          as logical no-undo .
     1354   define variable attr-db             as logical no-undo .
     1355   define variable v-spr as character no-undo .
     1356   define variable ii as integer no-undo .
     1357     run  thbjattr_code in this-procedure (
     1358                                            input   "cd-type-":U + locked_cash-desk.pos-type
     1359                                            ,input ''
     1360                                            ,output attr-label
     1361                                            ,output attr-user-can-edit
     1362                                            ,output attr-output-display
     1363                                            ,output attr-other
     1364                                            ,output attr-prop-list
     1365                                            ,output attr-prop-type-list
     1366                                            ,output attr-prop-label-list
     1367                                            ,output attr-global
     1368                                            ,output attr-host
     1369                                            ,output attr-shop
     1370                                            ,output attr-store
     1371                                            ,output attr-db ).
     1372     do ii = 1 to num-entries(attr-other, chr(47)):
     1373       if entry(ii, attr-other, chr(47)) begins "spr-ext=":U then do:
     1374         assign
     1375         v-spr = entry(2, entry(ii, attr-other, chr(47)), "=").
     1376       end.
     1377     end.
     1378       run value(v-spr)(
     1379                     input parparentproc
     1380                   ,'ПРОСМОТР':U
     1381                   ,'маг':U
     1382                   ,locked_cash-desk.obj-code
     1383                   ).
     1384   END.
     1385   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1386   DO:
     1387     assign
     1388       frame Dialog-Frame
     1389       tt-cash-desk.pos-type
     1390     .
     1391     if tt-cash-desk.pos-type = 'r-keeper':U then do :
     1392   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1393     (input  'is-rkeep':U
     1394     ,input  '':U
     1395     ,input  '':U
     1396     ,input  0
     1397     ,input  '':U
     1398     ,input  '':U
     1399     ,input  '':U
     1400     ,input  no
     1401     ,output conf-par
     1402     ,output par-type
     1403     ) no-error .
     1404       if error-status :error
     1405       or conf-par <> 'yes'
     1406       then do:
     1407         message
     1408           "В системе запрещена работа с кассами R-Keeper либо отсутсвует конфигурационный параметр is-rkeep" skip
     1409           "Обратитесь к администратору" skip
     1410           error-status :get-message(1) skip
     1411           return-value skip
     1412           view-as alert-box error .
     1413         return no-apply.
     1414       end.
     1415     end.
     1416     run proc-save in this-procedure no-error.
     1417     if error-status:error then return no-apply.
     1418   END.
     1419   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
     1420   DO:
     1421   define variable rid-list as character no-undo.
     1422         run ref/ccshlist.w (
     1423                            INPUT parparentproc
     1424                          , INPUT "":U
     1425                          , INPUT "one":U
     1426                          , OUTPUT  rid-list
     1427                          , INPUT tt-cash-desk.db-num
     1428                          , INPUT 'маг':U
     1429                          , INPUT tt-cash-desk.obj-code
     1430                          , input tt-cash-desk.pos-type
     1431                          , input tt-cash-desk.cash-num
     1432                          , input "":U
     1433                           ).
     1434   END.
     1435   ON LEAVE OF tt-cash-desk.cash-num IN FRAME Dialog-Frame
     1436   DO:
     1437     assign tt-cash-desk.cash-num .
     1438     assign tcode = tt-cash-desk.cash-num .
     1439   END.
     1440   ON LEAVE OF tt-cash-desk.obj-code IN FRAME Dialog-Frame
     1441   DO:
     1442      define buffer buf_shop for ub.shop.
     1443     define buffer buf_clients for ub.clients.
     1444     find first buf_shop no-lock where
     1445                   buf_shop.obj-code = input frame Dialog-Frame tt-cash-desk.obj-code no-error.
     1446     if available buf_shop then do:
     1447       find first buf_clients no-lock where
     1448                   buf_clients.obj-type = 'маг':U
     1449              AND buf_clients.obj-code = buf_shop.obj-code .
     1450       assign
     1451       tt-cash-desk.obj-code
     1452       f-obj-name = buf_clients.obj-name.
     1453       display
     1454      tt-cash-desk.obj-code
     1455      f-obj-name
     1456       with frame Dialog-Frame.
     1457     end.
     1458     else do:
     1459         assign
     1460           tt-cash-desk.obj-code = 0
     1461           f-obj-name = "":U.
     1462         return no-apply.
     1463     end.
     1464   END.
     1465   ON VALUE-CHANGED OF tt-cash-desk.pos-type IN FRAME Dialog-Frame
     1466   DO:
     1467     if p-mode = 'ПРОСМОТР':U then return no-apply.
     1468     assign
     1469     tt-cash-desk.pos-type.
     1470     if lookup(tt-cash-desk.pos-type,
     1471               ('IBM':U + chr(44) +
     1472                'IBM-XML':U + chr(44) +
     1473                'MARIA':U)) = 0 then do:
     1474         disable
     1475         t-remote
     1476         with frame Dialog-Frame.
     1477     end.
     1478     else do:
     1479         enable
     1480         t-remote when (p-mode <> 'ПРОСМОТР':U and not l-shift-on)
     1481         with frame Dialog-Frame.
     1482     end.
     1483     if lookup(tt-cash-desk.pos-type
     1484               , ('IBM-XML':U + chr(44) +
     1485                  'Autotank':U)) > 0
     1486         then do:
     1487         if p-mode <> 'ПРОСМОТР':U then do:
     1488           view
     1489           combo-protocol
     1490           in frame Dialog-Frame.
     1491         end.
     1492         enable
     1493         combo-protocol when (p-mode <> 'ПРОСМОТР':U and not l-shift-on)
     1494         with frame Dialog-Frame.
     1495     end.
     1496     else do:
     1497         disable
     1498         combo-protocol
     1499         with frame Dialog-Frame.
     1500         HIDE
     1501         combo-protocol
     1502         in frame Dialog-Frame.
     1503     end.
     1504     if lookup('MARIA':U, tt-cash-desk.pos-type) > 0
     1505         then do:
     1506         if p-mode <> 'ПРОСМОТР':U then do:
     1507           view
     1508           combo-protocol-maria
     1509           in frame Dialog-Frame.
     1510         end.
     1511         enable
     1512         combo-protocol-maria when (p-mode <> 'ПРОСМОТР':U and not l-shift-on)
     1513         with frame Dialog-Frame.
     1514     end.
     1515     else do:
     1516         disable
     1517         combo-protocol-maria
     1518         with frame Dialog-Frame.
     1519         HIDE
     1520         combo-protocol-maria
     1521         in frame Dialog-Frame.
     1522     end.
     1523     if lookup('MARIA':U, tt-cash-desk.pos-type) > 0
     1524         then do:
     1525         enable
     1526         f-cash-num-char when (p-mode <> 'ПРОСМОТР':U and not l-shift-on)
     1527         with frame Dialog-Frame.
     1528     end.
     1529     else do:
     1530         disable
     1531         f-cash-num-char
     1532         with frame Dialog-Frame.
     1533         HIDE
     1534         f-cash-num-char
     1535         in frame Dialog-Frame.
     1536     end.
     1537     if lookup('MARIA':U, tt-cash-desk.pos-type) > 0
     1538         then do:
     1539         enable
     1540         f-pswd when (p-mode <> 'ПРОСМОТР':U and not l-shift-on)
     1541         with frame Dialog-Frame.
     1542     end.
     1543     else do:
     1544         disable
     1545         f-pswd
     1546         with frame Dialog-Frame.
     1547         HIDE
     1548         f-pswd
     1549         in frame Dialog-Frame.
     1550     end.
     1551     if lookup(tt-cash-desk.pos-type,
     1552              ('IBM-XML':U + chr(44) +
     1553               'NCR-GM':U + chr(44) +
     1554               'MAGIA-XML':U + chr(44) +
     1555               'NCR-AS@R':U + chr(44) +
     1556               'Autotank':U
     1557               )) > 0 then do:
     1558         enable
     1559         tt-cash-desk.autonomy when (p-mode <> 'ПРОСМОТР':U and not l-shift-on)
     1560         with frame Dialog-Frame.
     1561     end.
     1562     else do:
     1563         ASSIGN
     1564         tt-cash-desk.autonomy = 0.
     1565         DISPLAY
     1566         tt-cash-desk.autonomy
     1567         with frame Dialog-Frame.
     1568         disable
     1569         tt-cash-desk.autonomy
     1570         with frame Dialog-Frame.
     1571     end.
     1572   END.
     1573   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1574   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1575   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1576   on help of frame Dialog-Frame
     1577   do:
     1578     run gbl/app_help.p
     1579       (input this-procedure :file-name
     1580       ,input ''
     1581       ,input ?
     1582       ) no-error.
     1583     if error-status :error then do:
     1584       message
     1585         "Ошибка при вызове помощи"
     1586         error-status :get-message(1)
     1587         view-as alert-box .
     1588     end.
     1589   end.
     1590   run minbtn-set in this-procedure .
     1591   on choose of b-help in frame Dialog-Frame
     1592   do:
     1593     apply "help":u to frame Dialog-Frame .
     1594   end.
     1595   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1596   procedure minbtn-set :
     1597       do
     1598           on error undo, return error return-value
     1599           :
     1600           define variable ii              as integer       no-undo .
     1601           define variable fh              as widget-handle no-undo .
     1602           define variable hh              as widget-handle no-undo .
     1603           define variable v-h             as handle        extent 4 no-undo .
     1604           define variable v-name-button   as character     no-undo .
     1605           define variable v-help-old-x    as decimal       no-undo .
     1606           define variable v-help-old-y    as decimal       no-undo .
     1607           define variable v-help-old-size as decimal       no-undo .
     1608           define variable v-frame-width   as decimal       no-undo .
     1609           define variable jj              as integer       no-undo .
     1610           do
     1611               on error undo, return error
     1612               :
     1613               assign
     1614                   v-frame-width = frame Dialog-Frame:width - 0.3
     1615                   fh            = frame Dialog-Frame:first-child
     1616                   hh            = fh:first-child
     1617                   ii            = 1
     1618                   .
     1619               do while valid-handle(hh):
     1620                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1621                   do:
     1622                       case lc(hh:name) :
     1623                           when "b-help" then
     1624                               do:
     1625                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1626                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1627                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1628                                   hh:TOOLTIP = "Помощь" .
     1629                                   v-help-old-x = hh:column .
     1630                                   v-help-old-y = hh:row    .
     1631                                   v-help-old-size = hh:width .
     1632                                   hh:width-chars = 2.5 .
     1633                               end.
     1634                           when "b-print" then
     1635                               do:
     1636                                   hh:load-image("cmp/b-print.bmp":u) .
     1637                                   hh:TOOLTIP = "Печать" .
     1638                                   v-h[ii] = hh:handle .
     1639                                   ii = ii + 1 .
     1640                                   hh:width-chars = 3 .
     1641                               end.
     1642                           when "b-history" or
     1643                           when "b-hist" then
     1644                               do:
     1645                                   hh:load-image("cmp/b-hist.bmp":u) .
     1646                                   hh:TOOLTIP = "История" .
     1647                                   v-h[ii] = hh:handle .
     1648                                   ii = ii + 1 .
     1649                                   hh:width-chars = 3 .
     1650                               end.
     1651                           when "b-sch" then
     1652                               do:
     1653                                   hh:load-image("cmp/b-sch.bmp":u) .
     1654                                   hh:TOOLTIP = "Установка Фильтра" .
     1655                                   v-h[ii] = hh:handle .
     1656                                   ii = ii + 1 .
     1657                                   hh:width-chars = 3 .
     1658                               end.
     1659                           when "b-hist-user" then
     1660                               do:
     1661                                   hh:load-image("cmp/b-hist.bmp":u) .
     1662                                   hh:TOOLTIP = "История пользователя" .
     1663                                   ii = ii + 1 .
     1664                               end.
     1665                       end case.
     1666                   end.
     1667                   hh = hh:next-sibling.
     1668               end.
     1669               b-help:column = v-frame-width - b-help:width-chars.
     1670               jj = 0.
     1671               repeat ii = 4 to 1 by -1 :
     1672                   if valid-handle (v-h[ii] ) then
     1673                   do:
     1674                       jj  = jj + 1 .
     1675                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1676                       v-h[ii]:row    = v-help-old-y .
     1677                   end.
     1678               end.
     1679           end.
     1680       end.
     1681   end procedure.
     1682   MAIN-BLOCK:
     1683   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1684      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1685    if num-entries(p-mode, chr(4)) > 1 then do:
     1686      assign
     1687      l-shift-on = logical(entry(2, p-mode, chr(4)))
     1688      p-mode = entry(1, p-mode, chr(4))
     1689      .
     1690    end.
     1691    if p-mode  <> 'ДОБАВЛЕНИЕ':U
     1692    and p-mode <> 'ИЗМЕНЕНИЕ':U
     1693    and p-mode <> 'ПРОСМОТР':U
     1694    then do:
     1695       message
     1696       vss-workfile vss-revision vss-description skip
     1697       "Неверное значение параметров вызова p-mode"  p-mode
     1698       view-as alert-box ERROR.
     1699       undo, return error.
     1700    end.
     1701    v-db-num = ibs.th.gbl.gbl-var:g#db-num .
     1702   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1703   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1704     (input  'маг':U
     1705     ,input  p-obj-code
     1706     ,output v-host-code
     1707     )  .
     1708     empty temp-table tt-cash-desk .
     1709     case p-mode :
     1710       when 'ИЗМЕНЕНИЕ':U then do:
     1711         find first locked_cash-desk EXclusive-lock
     1712              where recid(locked_cash-desk) = p-rid no-wait no-error.
     1713         if locked locked_cash-desk then do:
     1714           message
     1715           vss-workfile vss-revision vss-description skip
     1716            "Запись КАССЫ занята"
     1717           view-as alert-box error .
     1718           undo, return error.
     1719         end.
     1720         if not available locked_cash-desk then do:
     1721         message
     1722         vss-workfile vss-revision vss-description skip
     1723         "Не найдена запись КАССА"
     1724         view-as alert-box error .
     1725         undo, return error.
     1726         end.
     1727         if locked_cash-desk.db-num <> v-db-num then do:
     1728               message
     1729               vss-workfile vss-revision vss-description skip
     1730               "Нельзя изменять кассу чужой БД"
     1731               view-as alert-box error .
     1732               undo, return error.
     1733         end.
     1734         IF LOCKED_cash-desk.is-del THEN DO:
     1735           message
     1736           vss-workfile vss-revision vss-description skip
     1737           "Нельзя изменять кассу? которая логически удалена"
     1738           view-as alert-box error .
     1739           undo, return error.
     1740         END.
     1741         create tt-cash-desk.
     1742         buffer-copy locked_cash-desk to tt-cash-desk .
     1743         tcode = tt-cash-desk.cash-num .
     1744       end.
     1745       when 'ПРОСМОТР':U then do :
     1746         find first locked_cash-desk no-lock
     1747              where recid(locked_cash-desk) = p-rid no-error .
     1748         if not available locked_cash-desk then do:
     1749           find first locked_cash-desk no-lock
     1750                where locked_cash-desk.db-num   = p-db-num
     1751                  AND Locked_Cash-desk.obj-code = p-obj-code
     1752                  AND locked_cash-desk.cash-num = p-cash-num
     1753                  AND locked_cash-desk.pos-type = p-pos-type    no-error.
     1754           if not available locked_cash-desk then do:
     1755         message
     1756         vss-workfile vss-revision vss-description skip
     1757         "Не найдена запись КАССА"
     1758         view-as alert-box error .
     1759         undo, return error.
     1760           end.
     1761         end.
     1762         create tt-cash-desk.
     1763         buffer-copy locked_cash-desk to tt-cash-desk .
     1764         tcode = tt-cash-desk.cash-num .
     1765       end .
     1766       when 'ДОБАВЛЕНИЕ':U then do:
     1767   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1768   define variable v-param-type7 as character no-undo .
     1769   define variable v-value-date7 as date no-undo .
     1770   define variable v-value-decimal7 as decimal no-undo .
     1771   define variable v-value-integer7 as INTEGER no-undo .
     1772   define variable v-value-logical7 AS LOGICAL no-undo .
     1773   define variable v-tth7 as handle no-undo .
     1774   run adm/shattri.p (
     1775       input "get":U
     1776       ,input  'маг':U
     1777       ,input  p-obj-code
     1778       ,input  'cd-sending':U
     1779       ,input  'dflt-cd':U
     1780       ,output dflt-cd
     1781       ,output v-value-date7
     1782       ,output v-value-decimal7
     1783       ,output v-value-integer7
     1784       ,output v-value-logical7
     1785       ,output v-param-type7
     1786       ,INPUT-OUTPUT table-handle v-tth7
     1787       )  .
     1788   delete object v-tth7 no-error.
     1789         for each buf_cash-desk NO-LOCK
     1790            where buf_cash-desk.db-num = v-db-num
     1791                BY buf_cash-desk.cash-num :
     1792           tcode = buf_cash-desk.cash-num.
     1793         end.
     1794         tcode = tcode + 1.
     1795         create tt-cash-desk.
     1796         assign
     1797       tt-cash-desk.db-num    = v-db-num
     1798       tt-cash-desk.obj-code  = p-obj-code
     1799       tt-cash-desk.cash-num  = tcode
     1800       tt-cash-desk.pos-type  = dflt-cd
     1801       tt-cash-desk.addr-path = (if dflt-cd = 'IBM':U or dflt-cd = 'OMRON':U then "192.1.1.1":U else "":U)
     1802       tt-cash-desk.cash-os   = "OS/2"
     1803       tt-cash-desk.cash-on   = no
     1804         .
     1805       end.
     1806       otherwise do :
     1807       message
     1808       vss-workfile vss-revision vss-description skip
     1809       "Неверное значение параметров вызова p-mode"  p-mode
     1810       view-as alert-box ERROR.
     1811       undo, return error .
     1812       end .
     1813     end case .
     1814     RUN MyENable in this-procedure .
     1815     WAIT-FOR GO OF FRAME Dialog-Frame.
     1816   END.
     1817   delete object mCashDevice.
     1818   RUN disable_UI.
     1819   PROCEDURE disable_UI :
     1820     HIDE FRAME Dialog-Frame.
     1821   END PROCEDURE.
     1822   PROCEDURE enable_UI :
     1823     OPEN QUERY Dialog-Frame FOR EACH tt-cash-desk SHARE-LOCK,       EACH cash-desk WHERE TRUE  SHARE-LOCK.
     1824     GET FIRST Dialog-Frame.
     1825     DISPLAY f-obj-name f-cash-num-char f-pswd COMBO-protocol-maria COMBO-protocol
     1826             cb-device-kind CB-fr-type f-fr-type T-remote
     1827         WITH FRAME Dialog-Frame.
     1828     IF AVAILABLE tt-cash-desk THEN
     1829       DISPLAY tt-cash-desk.cash-num tt-cash-desk.db-num tt-cash-desk.obj-code
     1830             tt-cash-desk.addr-path tt-cash-desk.pos-type tt-cash-desk.cash-os
     1831             tt-cash-desk.autonomy tt-cash-desk.version
     1832             tt-cash-desk.registration-code tt-cash-desk.serial-code
     1833         WITH FRAME Dialog-Frame.
     1834     ENABLE B-exit RECT-1 b-quit B-attr B-attr-2 B-cli-attr B-hist B-Help
     1835            tt-cash-desk.obj-code f-obj-name tt-cash-desk.addr-path
     1836            COMBO-protocol-maria COMBO-protocol tt-cash-desk.pos-type
     1837            tt-cash-desk.cash-os tt-cash-desk.autonomy cb-device-kind CB-fr-type
     1838            tt-cash-desk.version f-fr-type T-remote tt-cash-desk.registration-code
     1839            tt-cash-desk.serial-code
     1840         WITH FRAME Dialog-Frame.
     1841     VIEW FRAME Dialog-Frame.
     1842   END PROCEDURE.
     1843   PROCEDURE MyEnable :
     1844   DEFINE VARIABLE v-list-items AS CHARACTER NO-UNDO.
     1845   DEFINE VARIABLE v-ii         AS INTEGER   NO-UNDO.
     1846    define variable objType    as ibs.th.gbl.propmap no-undo.
     1847      mCashDevice      = new ibs.th.str.cash.CashDevice().
     1848      do v-ii = 1 to mCashDevice:mapType:GetItem(v-ii):
     1849         objType = mCashDevice:CurrProp.
     1850         v-list-items = v-list-items + chr(44) + objType:Label_ + chr(44) + string(objType:KeyIntDB) .
     1851      end.
     1852      cb-device-kind:LIST-ITEM-PAIRS  in frame Dialog-Frame = trim(v-list-items,chr(44)) .
     1853   v-list-items = "".
     1854   DO v-ii = 1 TO NUM-ENTRIES('IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA':U):
     1855       ASSIGN
     1856       v-list-items = v-list-items + (IF v-ii > 1 THEN  chr(44) ELSE "":U) +
     1857                      ENTRY(v-ii, 'IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA':U) + chr(44) +
     1858                      ENTRY(v-ii, 'IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA':U).
     1859   END.
     1860   tt-cash-desk.pos-type:list-item-pairs in frame Dialog-Frame = v-list-items .
     1861   define variable v-fr-type-list-item-pairs as character no-undo .
     1862   DO v-ii = 1 TO NUM-ENTRIES('shtrih-fr-k-01,prim08tk':U):
     1863       ASSIGN
     1864       v-fr-type-list-item-pairs = v-fr-type-list-item-pairs + (IF v-ii > 1 THEN  chr(44) ELSE "":U) +
     1865                                         ENTRY(v-ii, 'Штрих-ФР-К 01,ПРИМ08ТК':U) +
     1866                                         chr(44) +
     1867                                         ENTRY(v-ii, 'shtrih-fr-k-01,prim08tk':U)
     1868       v-fr-type-list-items-full = v-fr-type-list-items-full + (IF v-ii > 1 THEN  chr(44) ELSE "":U) +
     1869                                         ENTRY(v-ii, 'Штрих-ФР-К 01,ПРИМ08ТК':U)
     1870       v-fr-type-list-items = v-fr-type-list-items + (IF v-ii > 1 THEN  chr(44) ELSE "":U) +
     1871                                         ENTRY(v-ii, 'shtrih-fr-k-01,prim08tk':U)
     1872       .
     1873   END.
     1874   assign
     1875   cb-fr-type:LIST-ITEM-pairs IN FRAME Dialog-Frame = trim(v-fr-type-list-item-pairs, chr(44))
     1876   cb-fr-type = tt-cash-desk.fr-type
     1877   f-fr-type = tt-cash-desk.fr-type
     1878   f-fr-type:column = cb-fr-type:column
     1879   f-fr-type:row = cb-fr-type:row
     1880   f-fr-type:side-label-handle:row = f-fr-type:row
     1881   f-fr-type:side-label-handle:column = f-fr-type:column
     1882   .
     1883     cb-device-kind = tt-cash-desk.device-kind .
     1884   assign
     1885   t-remote = (tt-cash-desk.remote = 1)
     1886   tt-cash-desk.autonomy:radio-buttons = "&Автономная касса"  + chr(44) + '0':U +  chr(44) +
     1887                                         "&Подчиненная касса" + chr(44) + '1':U + chr(44) +
     1888                                         "&Касс.менеджер"     + chr(44) + '2':U
     1889   .
     1890   DISPLAY
     1891   f-obj-name
     1892   cb-device-kind
     1893   T-remote
     1894   WITH FRAME Dialog-Frame .
     1895   IF AVAILABLE tt-cash-desk THEN DO:
     1896    combo-protocol:SCREEN-VALUE = (IF num-entries(tt-cash-desk.addr-path, chr(4)) > 1
     1897                                   and (tt-cash-desk.pos-type = 'IBM-XML':U
     1898                                        or tt-cash-desk.pos-type = 'Autotank':U)
     1899                                   THEN ENTRY(1, tt-cash-desk.addr-path, chr(4))
     1900                                   ELSE chr(32)) .
     1901    combo-protocol-maria:SCREEN-VALUE = (IF num-entries(tt-cash-desk.addr-path, chr(4)) > 1
     1902                                         and tt-cash-desk.pos-type = 'MARIA':U
     1903                                         THEN ENTRY(1, tt-cash-desk.addr-path, chr(4))
     1904                                         ELSE chr(32)) .
     1905   DISPLAY
     1906   f-fr-type
     1907   tt-cash-desk.cash-num
     1908   tt-cash-desk.db-num
     1909   tt-cash-desk.obj-code
     1910   (IF num-entries(tt-cash-desk.addr-path, chr(4)) > 1
     1911   THEN ENTRY(2, tt-cash-desk.addr-path, chr(4))
     1912   ELSE tt-cash-desk.addr-path) @ tt-cash-desk.addr-path
     1913   tt-cash-desk.pos-type
     1914   tt-cash-desk.cash-os
     1915   tt-cash-desk.version
     1916   tt-cash-desk.autonomy
     1917   tt-cash-desk.registration-code
     1918   tt-cash-desk.serial-code
     1919   WITH FRAME Dialog-Frame .
     1920   IF NUM-ENTRIES(tt-cash-desk.addr-path, chr(4)) > 2
     1921   AND tt-cash-desk.pos-type = 'MARIA':U
     1922       THEN DO:
     1923       DISPLAY
     1924       ENTRY(3, tt-cash-desk.addr-path, chr(4)) @ f-cash-num-char
     1925       WITH FRAME Dialog-Frame.
     1926   END.
     1927   IF NUM-ENTRIES(tt-cash-desk.addr-path, chr(4)) > 3
     1928   AND tt-cash-desk.pos-type = 'MARIA':U
     1929       THEN DO:
     1930       DISPLAY
     1931       ENTRY(4, tt-cash-desk.addr-path, chr(4)) @ f-pswd
     1932       WITH FRAME Dialog-Frame.
     1933   END.
     1934   END.
     1935   ENABLE
     1936   b-quit
     1937   B-exit
     1938   b-attr when (p-mode <> 'ДОБАВЛЕНИЕ':U and not l-shift-on)
     1939   b-attr-2 when (p-mode <> 'ДОБАВЛЕНИЕ':U and not l-shift-on)
     1940   b-cli-attr when (p-mode <> 'ДОБАВЛЕНИЕ':U and not l-shift-on)
     1941   b-hist when p-mode <> 'ДОБАВЛЕНИЕ':U
     1942   B-Help
     1943   tt-cash-desk.cash-num when (p-mode = 'ДОБАВЛЕНИЕ':U and not l-shift-on)
     1944   tt-cash-desk.obj-code  when (p-mode = 'ДОБАВЛЕНИЕ':U and not l-shift-on)
     1945   tt-cash-desk.addr-path when (p-mode <> 'ПРОСМОТР':U)
     1946   tt-cash-desk.pos-type  when (p-mode = 'ДОБАВЛЕНИЕ':U and not l-shift-on)
     1947   tt-cash-desk.cash-os when (p-mode <> 'ПРОСМОТР':U and not l-shift-on)
     1948   tt-cash-desk.version when p-mode <> 'ПРОСМОТР':U
     1949   tt-cash-desk.registration-code when p-mode <> 'ПРОСМОТР':U
     1950   tt-cash-desk.serial-code when p-mode <> 'ПРОСМОТР':U
     1951   T-remote when (p-mode <> 'ПРОСМОТР':U and not l-shift-on)
     1952   tt-cash-desk.autonomy when (p-mode <> 'ПРОСМОТР':U and not l-shift-on)
     1953   cb-device-kind when (p-mode <> 'ПРОСМОТР':U)
     1954   WITH FRAME Dialog-Frame.
     1955   if p-mode = 'ПРОСМОТР':U then do:
     1956       assign
     1957       b-quit:label = "&Выход"
     1958       .
     1959       hide
     1960       b-exit
     1961       in frame Dialog-Frame.
     1962   end.
     1963   APPLY "VALUE-CHANGED" to tt-cash-desk.pos-type.
     1964   enable tt-cash-desk.pos-type WITH FRAME Dialog-Frame.
     1965   APPLY "VALUE-CHANGED" to tt-cash-desk.autonomy.
     1966   VIEW FRAME Dialog-Frame .
     1967   END PROCEDURE.
     1968   PROCEDURE proc-save :
     1969   IF COMBO-protocol:visible in FRAME Dialog-Frame THEN
     1970   ASSIGN
     1971   COMBO-protocol
     1972   .
     1973   ELSE
     1974   combo-protocol = "":U.
     1975   IF COMBO-protocol-maria:visible in FRAME Dialog-Frame THEN
     1976   ASSIGN
     1977   COMBO-protocol-maria
     1978   .
     1979   ELSE
     1980   combo-protocol-maria = "":U.
     1981   IF f-cash-num-char:visible in FRAME Dialog-Frame THEN
     1982   ASSIGN
     1983   f-cash-num-char
     1984   .
     1985   ELSE
     1986   f-cash-num-char = "":U.
     1987   IF f-pswd:visible in FRAME Dialog-Frame THEN
     1988   ASSIGN
     1989   f-pswd
     1990   .
     1991   ELSE
     1992   f-pswd = "":U.
     1993   IF cb-FR-TYPE:SENSITIVE in FRAME Dialog-Frame THEN do:
     1994     ASSIGN
     1995     cb-FR-TYPE
     1996     tt-cash-desk.fr-type = cb-FR-TYPE
     1997     .
     1998   end.
     1999   ELSE do:
     2000     cb-FR-TYPE = "":U.
     2001   end.
     2002   IF f-FR-TYPE:SENSITIVE in FRAME Dialog-Frame THEN do:
     2003     ASSIGN
     2004     f-FR-TYPE
     2005     tt-cash-desk.fr-type = f-FR-TYPE
     2006     .
     2007   end.
     2008   ELSE do:
     2009     f-FR-TYPE = "":U.
     2010   end.
     2011   if cb-device-kind:sensitive in frame Dialog-Frame
     2012     then assign cb-device-kind .
     2013     else cb-device-kind = 0 .
     2014   assign
     2015   frame Dialog-Frame tt-cash-desk.addr-path
     2016   tt-cash-desk.addr-path = (IF combo-protocol <> "":U
     2017                             THEN (combo-protocol + chr(4))
     2018                             ELSE '':U) +
     2019                             tt-cash-desk.addr-path
     2020   tt-cash-desk.addr-path =   (IF combo-protocol-maria <> "":U
     2021                             THEN (combo-protocol-maria + chr(4))
     2022                             ELSE '':U) +
     2023                             tt-cash-desk.addr-path
     2024   tt-cash-desk.addr-path = tt-cash-desk.addr-path +
     2025                           (IF f-cash-num-char <> "":U
     2026                           THEN (chr(4) + f-cash-num-char )
     2027                           ELSE '':U)
     2028   tt-cash-desk.addr-path = tt-cash-desk.addr-path +
     2029                           (IF f-pswd <> "":U
     2030                           THEN (chr(4) + f-pswd )
     2031                           ELSE '':U)
     2032   tt-cash-desk.cash-num
     2033   tt-cash-desk.cash-os
     2034   tt-cash-desk.obj-code
     2035   tt-cash-desk.pos-type
     2036   tt-cash-desk.version
     2037   T-remote
     2038   tt-cash-desk.remote = (if T-remote and T-remote:sensitive then 1 else 0)
     2039   tt-cash-desk.autonomy
     2040   tt-cash-desk.serial-code
     2041   tt-cash-desk.registration-code
     2042   .
     2043   run ref/cashdsk1.p (
     2044    input-output p-rid
     2045   ,input p-mode
     2046   ,input tt-cash-desk.db-num
     2047   ,input tt-cash-desk.obj-code
     2048   ,input tt-cash-desk.pos-type
     2049   ,input tt-cash-desk.cash-num
     2050   ,input tt-cash-desk.autonomy
     2051   ,input tt-cash-desk.addr-path
     2052   ,input tt-cash-desk.cash-on
     2053   ,input tt-cash-desk.cash-os
     2054   ,input tt-cash-desk.is-del
     2055   ,input tt-cash-desk.remote
     2056   ,input tt-cash-desk.version
     2057   ,input tt-cash-desk.registration-code
     2058   ,input tt-cash-desk.serial-code
     2059   ,input tt-cash-desk.fr-type
     2060   ,input cb-device-kind
     2061   ) no-error .
     2062   if error-status:error then do:
     2063     if num-entries(return-value, " ") > 1 then message
     2064       substitute("&1&2&3", error-status:get-message(1) , chr(10), return-value)
     2065     view-as alert-box error .
     2066     else if return-value > "" then do:
     2067     end .
     2068     undo, return error.
     2069   end.
     2070   END PROCEDURE.
