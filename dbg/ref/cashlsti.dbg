      202   FUNCTION get-curr RETURNS CHARACTER
      203     (buffer loc-wealth for ub.wealth ) :
      204   define buffer buf_currency for ub.currency.
      205   if loc-wealth.curr-code = ? or loc-wealth.is-money = no then
      206   return loc-wealth.unit-base.
      207   FIND FIRST buf_currency no-lock where
      208             buf_currency.curr-code = loc-wealth.curr-code No-ERROR.
      209   if avail buf_currency then
      210     RETURN buf_currency.curr-abbr.
      211   else return "".
      212   END FUNCTION.
