        1   block-level on error undo, throw.
        2   define input-output parameter p-doc-rec as recid no-undo.
        3   define input parameter p-mode            as character no-undo .
        4   define input parameter p-deliv-type-code like ub.var-deliv-gr-per-val.deliv-type-code no-undo .
        5   define input parameter p-deliv-subj-code like ub.var-deliv-gr-per-val.deliv-subj-code no-undo .
        6   define input parameter p-deliv-obj-type  like ub.var-deliv-gr-per-val.obj-type no-undo .
        7   define input parameter p-deliv-obj-code  like ub.var-deliv-gr-per-val.obj-code no-undo .
        8   define input parameter p-gr-per-val-code like ub.var-deliv-gr-per-val.gr-per-val-code no-undo .
        9   define input parameter p-des like ub.delivery-type-subject.des no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       11   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       12   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile: vrdlgrp1.p $":U .
       14   define variable vss-archive     as character no-undo init "$Archive: ref/vrdlgrp1.p $":U .
       15   define variable vss-description as character no-undo init "Сохранение изменений в карточке варианта доставки ПО ГРУППЕ СРОКА ГОДНОСТИ".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define variable v-db-num like ub.db.db-num no-undo .
       77   define buffer buf_delivery-type  for ub.delivery-type.
       78   define buffer buf_delivery-subject  for ub.delivery-subject.
       79   define buffer buf_delivery-type-subject  for ub.delivery-type-subject.
       80   define buffer buf_variant-delivery for ub.variant-delivery.
       81   define buffer buf_group-period-validity for ub.group-period-validity.
       82   define buffer buf_var-deliv-gr-per-val for ub.var-deliv-gr-per-val.
       83   define buffer buf_clients for ub.clients.
       84   define stream LogStream.
       85   if p-mode <> 'ДОБАВЛЕНИЕ':U
       86   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
       87     message
       88     vss-workfile vss-revision vss-description skip
       89     "Неверный параметр p-mode" p-mode
       90     view-as alert-box error .
       91     return error '':u.
       92   end.
       93   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       94   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
       95     (output v-db-num
       96     )  .
       97   if v-db-num <> 0 then do:
       98     run err-mess (substitute("Нельзя изменять запись ВАРИАНТ ДОСТАВКИ ПО ГРУППЕ СРОКОВ ГОДНОСТИ в УБД: Номер текущей БД &1"
       99                   , v-db-num) ).
      100     undo, return error "":U.
      101   end.
      102   find first buf_delivery-type no-lock where
      103               buf_delivery-type.deliv-type-code = p-deliv-type-code  no-error .
      104   if not available buf_delivery-type then do:
      105     run err-mess (substitute("Неправильная ссылка на ТИП ДОСТАВКИ, код типа доставки: &1"
      106                   , p-deliv-type-code) ).
      107     undo, return error "deliv-type-code":U.
      108   end.
      109   find first buf_delivery-subject no-lock where
      110               buf_delivery-subject.deliv-subj-code = p-deliv-subj-code  no-error .
      111   if not available buf_delivery-subject then do:
      112     run err-mess (substitute("Неправильная ссылка на СУБЪЕКТ ДОСТАВКИ, код субъекта доставки: &1"
      113                   , p-deliv-subj-code) ).
      114     undo, return error "deliv-subj-code":U.
      115   end.
      116   find first buf_delivery-type-subject no-lock where
      117               buf_delivery-type-subject.deliv-type-code = p-deliv-type-code
      118           AND buf_delivery-type-subject.deliv-subj-code = p-deliv-subj-code
      119           no-error .
      120   if not available buf_delivery-type-subject then do:
      121     run err-mess (substitute("Неправильная ссылка на ТИП ДОСТАВКИ ОТ СУБЪЕКТА, код типа доставки: &1, код субъекта: &2"
      122                   , p-deliv-type-code
      123                   , p-deliv-subj-code
      124                   ) ).
      125     undo, return error "deliv-type-code":U.
      126   end.
      127   find first buf_clients no-lock where
      128             buf_clients.obj-type = p-deliv-obj-type
      129         AND buf_clients.obj-code = p-deliv-obj-code  no-error .
      130   if not available buf_clients then do:
      131     run err-mess (substitute("Неправильная ссылка на ОБЪЕКТ ДОСТАВКИ: &1&2"
      132                   , p-deliv-obj-type
      133                   , p-deliv-obj-code
      134                   ) ).
      135     undo, return error "obj-code":U.
      136   end.
      137   if buf_clients.obj-type <> 'маг':U
      138   and buf_clients.obj-type <> 'скл':U then do:
      139     run err-mess (substitute("Неверный тип ОБЪЕКТА ДОСТАВКИ: &1, может быть только &2 или &3"
      140                   , p-deliv-obj-type
      141                   , 'маг':U
      142                   , 'скл':U
      143                   ) ).
      144     undo, return error "obj-type":U.
      145   end.
      146   find first buf_variant-delivery no-lock where
      147               buf_variant-delivery.deliv-type-code = p-deliv-type-code
      148           AND buf_variant-delivery.deliv-subj-code = p-deliv-subj-code
      149           AND buf_variant-delivery.obj-type = p-deliv-obj-type
      150           AND buf_variant-delivery.obj-code = p-deliv-obj-code
      151           no-error .
      152   if not available buf_variant-delivery then do:
      153     run err-mess (substitute("Неправильная ссылка на ВАРИАНТ ДОСТАВКИ, код типа доставки: &1, код субъекта: &2, объект доставки &3&4"
      154                   , p-deliv-type-code
      155                   , p-deliv-subj-code
      156                   , p-deliv-obj-type
      157                   , p-deliv-obj-code
      158                   ) ).
      159     undo, return error "deliv-type-code":U.
      160   end.
      161   find first buf_group-period-validity no-lock where
      162             buf_group-period-validity.gr-per-val-code = p-gr-per-val-code no-error .
      163   if not available buf_group-period-validity then do:
      164     run err-mess (substitute("Неправильная ссылка на ГРУППУ СРОКОВ ГОДНОСТИ, код группы сроков годности: &1"
      165                   , p-gr-per-val-code
      166                   ) ).
      167     undo, return error "gr-per-val-code":U.
      168   end.
      169   if buf_group-period-validity.gr-per-from <= buf_variant-delivery.term-delivery then do:
      170     run err-mess (substitute(("Слишком большой срок доставки для данной группы сроков годности, &1" +
      171                              "срок доставки: &2 срок годности: &3-&4 дня " +
      172                              "код типа доставки: &5, код субъекта: &6, объект доставки: &7&8 " +
      173                              "код группы сроков годности: &9")
      174                   , chr(10)
      175                   , buf_variant-delivery.term-delivery
      176                   , buf_group-period-validity.gr-per-from
      177                   , buf_group-period-validity.gr-per-to
      178                   , p-deliv-type-code
      179                   , p-deliv-subj-code
      180                   , p-deliv-obj-type
      181                   , p-deliv-obj-code
      182                   , p-gr-per-val-code
      183                   ) ).
      184     undo, return error "":U.
      185   end.
      186   if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      187     find first buf_var-deliv-gr-per-val no-lock where
      188               buf_var-deliv-gr-per-val.deliv-type-code = p-deliv-type-code
      189           AND buf_var-deliv-gr-per-val.deliv-subj-code = p-deliv-subj-code
      190           AND buf_var-deliv-gr-per-val.obj-type = p-deliv-obj-type
      191           AND buf_var-deliv-gr-per-val.obj-code = p-deliv-obj-code
      192           AND buf_var-deliv-gr-per-val.gr-per-val-code = p-gr-per-val-code
      193           no-error .
      194     if available buf_var-deliv-gr-per-val then do:
      195       run err-mess (substitute("Уже есть запись ВАРИАНТА ДОСТАВКИ ПО ГРУППЕ СРОКОВ ХРАНЕНИЯ &1, у которой код типа доставки: &2 и код субъекта доставки: &3 и объект &4&5 и код группы сроков хранения &6"
      196                     , chr(10)
      197                     , p-deliv-type-code
      198                     , p-deliv-subj-code
      199                     , p-deliv-obj-type
      200                     , p-deliv-obj-code
      201                     , p-gr-per-val-code
      202                     ) ).
      203       undo, return error "deliv-type-code":U.
      204     end.
      205   end.
      206   _MAIN:
      207   DO ON ERROR UNDO, RETURN ERROR
      208   ON STOP UNDO, RETURN ERROR:
      209     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      210       create ub.var-deliv-gr-per-val.
      211       assign
      212       ub.var-deliv-gr-per-val.deliv-type-code = p-deliv-type-code
      213       ub.var-deliv-gr-per-val.deliv-subj-code = p-deliv-subj-code
      214       ub.var-deliv-gr-per-val.obj-type        = p-deliv-obj-type
      215       ub.var-deliv-gr-per-val.obj-code        = p-deliv-obj-code
      216       ub.var-deliv-gr-per-val.gr-per-val-code = p-gr-per-val-code
      217       p-doc-rec = recid(ub.var-deliv-gr-per-val)
      218       .
      219     end.
      220     else do:
      221       FIND FIRST ub.var-deliv-gr-per-val where
      222                 recid(ub.var-deliv-gr-per-val) = p-doc-rec No-ERROR.
      223       if not available ub.var-deliv-gr-per-val then do:
      224         message
      225         vss-workfile vss-revision vss-description skip
      226         "Не найдена запись ВАРИАНТ ДОСТАВКИ ПО ГРУППЕ СРОКОВ ХРАНЕНИЯ - p-doc-rec" p-doc-rec
      227         view-as alert-box error .
      228         undo, return error '':u.
      229       end.
      230       if ub.var-deliv-gr-per-val.deliv-type-code <> p-deliv-type-code
      231       or ub.var-deliv-gr-per-val.deliv-subj-code <> p-deliv-subj-code
      232       or ub.var-deliv-gr-per-val.obj-type        <> p-deliv-obj-type
      233       or ub.var-deliv-gr-per-val.obj-code        <> p-deliv-obj-code
      234       or ub.var-deliv-gr-per-val.gr-per-val-code <> p-gr-per-val-code
      235       then do:
      236         message
      237         vss-workfile vss-revision vss-description skip
      238         "Для уже имеющейся записи нельзя изменить"
      239         "внутренний код типа доставки и/или" skip
      240         "внутренний код субъекта доставки и/или" skip
      241         "объект доставки и/или" skip
      242         "внутр. код группы сроков годности"
      243         view-as alert-box ERROR.
      244         undo, return error '':U.
      245       end.
      246     end.
      247     assign
      248     ub.var-deliv-gr-per-val.des                 = p-des
      249     ub.var-deliv-gr-per-val.sts                 =  (if p-mode = 'ДОБАВЛЕНИЕ':U
      250                                then 0
      251                                else ub.var-deliv-gr-per-val.sts)
      252     .
      253     release ub.var-deliv-gr-per-val no-error.
      254     if error-status:error then do:
      255        run err-mess(substitute("Ошибка при сохранении записи ВАРИАНТ ДОСТАВКИ ПО ГРУППЕ СРОКОВ ГОДНОСТИ: тип доставки &1, субъект доставки &2, объект доставки &3&4, код группы сроков годности &5: &6: &7"
      256                                , p-deliv-type-code
      257                                , p-deliv-subj-code
      258                                , p-deliv-obj-type
      259                                , p-deliv-obj-code
      260                                , p-gr-per-val-code
      261                                , ERROR-STATUS:GET-message(1)
      262                                , return-value
      263                                )).
      264       undo, return error "":U.
      265    end.
      266   end.
      267   PROCEDURE err-mess:
      268     DEFINE INPUT PARAMETER p-mess as character No-UNDO.
      269         message
      270         p-mess
      271         view-as alert-box error .
      272   END PROCEDURE.
