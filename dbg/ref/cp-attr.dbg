        1   BLOCK-LEVEL ON ERROR UNDO, THROW.
        2   define output parameter this-proc-hndl as handle no-undo.
        3   define new global shared variable g#language as character no-undo .
        4   if g#language <> '' and g#language <> 'rus':U then do:
        5     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        6   end.
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Библиотека работы с атрибутами типов кассовых платежей".
       13   do:
       14     this-proc-hndl = this-procedure.
       15   end.
       16   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       17   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       18   procedure cur-time :
       19      define output parameter p-today as date      no-undo .
       20      define output parameter p-time  as integer   no-undo .
       21     do
       22     on error undo, return error
       23     :
       24       define variable v-date1 as date      no-undo .
       25       define variable v-date2 as date      no-undo .
       26       define variable v-time  as integer   no-undo .
       27       assign
       28         v-date1 = today
       29         v-time  = time
       30         v-date2 = today
       31       .
       32       if v-date1 <> v-date2
       33       then do:
       34         assign
       35           v-date1 = today
       36           v-time  = v-time
       37         .
       38       end.
       39       assign
       40         p-today = v-date1
       41         p-time  = v-time
       42       .
       43     end.
       44   end.
       45   function cur-time-date returns character
       46   :
       47     return string(today, '99/99/9999':U) .
       48   end.
       49   function cur-time-mjd returns decimal
       50   :
       51     define variable v-date as date      no-undo .
       52     define variable v-time as integer   no-undo .
       53     run cur-time in this-procedure
       54       (output v-date
       55       ,output v-time
       56       ) .
       57     return integer(v-date) - 2400002 + (v-time / 86400) .
       58   end.
       59   function cur-time-get-ending-index returns integer
       60   (input p-number as integer
       61   )
       62   :
       63     if p-number < 0
       64     or p-number = ?
       65     then do:
       66       return 1 .
       67     end.
       68     define variable v-rest as integer   no-undo .
       69     assign
       70       p-number = p-number modulo 100
       71     .
       72     if p-number < 20
       73     then do:
       74       assign
       75         v-rest = p-number
       76       .
       77     end.
       78     else do:
       79       assign
       80         v-rest = p-number modulo 10
       81       .
       82     end.
       83     case v-rest :
       84       when 1
       85       then do:
       86         return 2 .
       87       end.
       88       when 2 or
       89       when 3 or
       90       when 4
       91       then do:
       92         return 3 .
       93       end.
       94       otherwise do:
       95         return 1 .
       96       end.
       97     end case .
       98   end.
       99   procedure cur-time-mjd-to-date :
      100      define input  parameter i-mjd-diff as decimal no-undo.
      101      define output parameter o-Date     as date    no-undo.
      102      define output parameter o-Time     as integer no-undo.
      103      define variable v-day-number as integer   no-undo .
      104      if    i-mjd-diff < 0
      105         or i-mjd-diff = ?
      106      then do:
      107         return "?" .
      108      end.
      109      assign
      110         v-day-number = truncate(i-mjd-diff,0).
      111         o-Date = date(v-day-number + 2400002).
      112         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      113     .
      114   end.
      115   function cur-time-mjd-to-string returns character
      116   (input p-mjd-diff as decimal
      117   )
      118   :
      119     define variable v-day-number as integer   no-undo .
      120     define variable v-seconds    as integer   no-undo .
      121     define variable v-hour       as integer   no-undo .
      122     define variable v-min        as integer   no-undo .
      123     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      124     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      125     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      126     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      127     if p-mjd-diff < 0
      128     or p-mjd-diff = ?
      129     then do:
      130       return "?" .
      131     end.
      132     assign
      133       v-day-number = integer(truncate(p-mjd-diff,0))
      134       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      135     .
      136     if v-seconds > 86400
      137     then do:
      138       assign
      139         v-seconds = 86400 - 1
      140       .
      141     end.
      142     if v-seconds < 0
      143     then do:
      144       assign
      145         v-seconds = 0
      146       .
      147     end.
      148     assign
      149       v-hour = truncate(v-seconds / 3600, 0)
      150     .
      151     assign
      152       v-seconds = v-seconds modulo 3600
      153     .
      154     assign
      155       v-min = truncate(v-seconds / 60, 0)
      156     .
      157     assign
      158       v-seconds = v-seconds modulo 60
      159     .
      160     return
      161         (if v-day-number <> 0
      162           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      163           else ""
      164         )
      165       + (if v-day-number <> 0 or v-hour <> 0
      166           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      167           else ""
      168         )
      169       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      170           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      171           else ""
      172         )
      173       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      174       .
      175   end.
      176   function cur-time-string returns character
      177   :
      178     define variable v-date as date      no-undo .
      179     define variable v-time as integer   no-undo .
      180     run cur-time in this-procedure
      181       (output v-date
      182       ,output v-time
      183       ) .
      184     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      185   end.
      186   function cur-time-string-sec returns character
      187   :
      188     define variable v-date as date      no-undo .
      189     define variable v-time as integer   no-undo .
      190     run cur-time in this-procedure
      191       (output v-date
      192       ,output v-time
      193       ) .
      194     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      195   end.
      196   function cur-time-custom  returns character
      197   (input p-prefix as character
      198   ,input p-date-format as character
      199   ,input p-delimiter as character
      200   ,input p-time-format as character
      201   ,input p-suffix as character
      202   )
      203   :
      204     define variable v-date as date      no-undo .
      205     define variable v-time as integer   no-undo .
      206     run cur-time in this-procedure
      207       (output v-date
      208       ,output v-time
      209       ) .
      210     return
      211       p-prefix
      212       + string(v-date, p-date-format)
      213       + p-delimiter
      214       + string(v-time, p-time-format)
      215       + p-suffix
      216       .
      217   end.
      218   function cur-time-print  returns character
      219   :
      220     define variable v-date as date      no-undo .
      221     define variable v-time as integer   no-undo .
      222     run cur-time in this-procedure
      223       (output v-date
      224       ,output v-time
      225       ) .
      226     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      227   end.
      228   function cur-time-datetime returns datetime
      229   :
      230     define variable v-char as character no-undo .
      231     define variable v-datetime as datetime no-undo .
      232     v-char = cur-time-string().
      233     v-datetime = datetime(v-char).
      234     return  v-datetime.
      235   end.
      236   function cur-time-string-msec returns character
      237   :
      238     define variable v-date as datetime  no-undo .
      239     v-date = now.
      240     return string(v-date) .
      241   end.
      242   procedure cp-attr-code :
      243     do
      244     on error undo, return error
      245     :
      246       define input  parameter p-code           as character no-undo .
      247       define output parameter p-type           as character no-undo .
      248       define output parameter p-format         as character no-undo .
      249       define output parameter p-label          as character no-undo .
      250       define output parameter p-range          as integer   no-undo .
      251       define output parameter p-user-can-edit  as logical   no-undo .
      252       define output parameter p-output-display as logical   no-undo .
      253       define output parameter p-other          as character no-undo .
      254       case p-code :
      255               when 'paycard-export-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      256               when 'grp-code':U then do:     assign     p-label = "Группа платежа"     p-type = 'C':U      p-format = "X(45)"     p-label = "Группа платежа"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=grp-code':u      .   end.
      257               when 'is-use':U then do:     assign     p-label = "Используется"     p-type = 'C':U      p-format = "X(255)"     p-label = "Используется"     p-range = 4     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=is-use':u      .   end.
      258               when 'dop-doc':U then do:     assign     p-label = "Дополнительный документ"     p-type = 'C':U      p-format = "X(255)"     p-label = "Дополнительный документ"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=dop-doc':u      .   end.
      259               when 'paycard-all-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      260               when 'paycard-edit-prefix':U then do:     assign     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      261               when 'form_km3':U then do:     assign     p-label = "Формировать КМ-3 по чекам возврата"     p-type = 'L':U      p-format = "+/-"     p-label = "Формировать КМ-3 по чекам возврата"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      262               when 'bal_malina':U then do:     assign     p-label = "Оплата баллами Малина"     p-type = 'L':U      p-format = "+/-"     p-label = "Оплата баллами Малина"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      263               when 'max_proc_sum':U then do:     assign     p-label = "Максимальный % порог от суммы"     p-type = 'D':U      p-format = ">>9.99"     p-label = "Максимальный % порог от суммы"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      264               when 'mask_card_kup':U then do:     assign     p-label = "Маска карты\купона"     p-type = 'C':U      p-format = "x(129)"     p-label = "Маска карты\купона"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      265         otherwise do:
      266           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code ).
      267         end.
      268       end.
      269     end.
      270   end procedure.
      271   procedure cp-attr-tooltip :
      272     do
      273     on error undo, return error
      274     :
      275       define input  parameter p-code    as character no-undo .
      276       define output parameter p-tooltip as character no-undo .
      277       define output parameter p-label   as character no-undo .
      278       case p-code :
      279               when 'paycard-export-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для выгрузки в XML)"     p-label = "Префиксы платежных карт (для выгрузки в XML)" .   end.
      280               when 'grp-code':U then do:     assign     p-tooltip = "Группа платежа"     p-label = "Группа платежа" .   end.
      281               when 'is-use':U then do:     assign     p-tooltip = "Используется"     p-label = "Используется" .   end.
      282               when 'dop-doc':U then do:     assign     p-tooltip = "Дополнительный документ"     p-label = "Дополнительный документ" .   end.
      283               when 'paycard-all-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)" .   end.
      284               when 'paycard-edit-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт, разрешенных для редактировани"     p-label = "Префиксы платежных карт, разрешенных для редактирования" .   end.
      285               when 'form_km3':U then do:     assign     p-tooltip = "Формировать КМ-3 по чекам возврата"     p-label = "Формировать КМ-3 по чекам возврата" .   end.
      286               when 'bal_malina':U then do:     assign     p-tooltip = "Оплата баллами Малина"     p-label = "Оплата баллами Малина" .   end.
      287               when 'max_proc_sum':U then do:     assign     p-tooltip = "Максимальный % порог от суммы"     p-label = "Максимальный % порог от суммы" .   end.
      288               when 'mask_card_kup':U then do:     assign     p-tooltip = "Маска карты\купона"     p-label = "Маска карты\купона" .   end.
      289         otherwise do:
      290           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code) .
      291         end.
      292       end.
      293     end.
      294   end procedure.
      295   procedure cp-attr-value :
      296     do
      297     on error undo, return error
      298     :
      299       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      300       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      301       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      302       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      303       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      304       define input  parameter p-code        like ub.cash-pay-attr.attr-code      no-undo .
      305       define output parameter p-value       like ub.cash-pay-attr.attr-value    no-undo .
      306       define output parameter p-type        as character no-undo .
      307       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      308       define variable v-format         as character no-undo .
      309       define variable v-label          as character no-undo .
      310       define variable v-range          as integer   no-undo .
      311       define variable v-user-can-edit  as logical   no-undo .
      312       define variable v-output-display as logical   no-undo .
      313       define variable v-other          as character no-undo .
      314       run cp-attr-code in this-procedure
      315         (input  p-code
      316         ,output p-type
      317         ,output v-format
      318         ,output v-label
      319         ,output v-range
      320         ,output v-user-can-edit
      321         ,output v-output-display
      322         ,output v-other
      323         ) no-error .
      324       if error-status :error then do:
      325         undo, return error return-value .
      326       end.
      327       find first buf_cash-pay-attr no-lock
      328         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      329           and buf_cash-pay-attr.curr-code  = p-curr-code
      330           and buf_cash-pay-attr.host-code  = p-host-code
      331           and buf_cash-pay-attr.obj-type   = p-obj-type
      332           and buf_cash-pay-attr.obj-code   = p-obj-code
      333           and buf_cash-pay-attr.attr-code  = p-code
      334         no-error .
      335       if avail buf_cash-pay-attr then do:
      336         assign
      337           p-value =  buf_cash-pay-attr.attr-value
      338         .
      339       end.
      340       else do:
      341         assign
      342           p-value = if p-type = 'L':U then "no":U else ""
      343         .
      344       end.
      345     end.
      346   end procedure.
      347   procedure cp-attr-write :
      348     do
      349     on error undo, return error
      350     :
      351       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      352       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      353       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      354       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      355       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      356       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      357       define input parameter p-value    like ub.cash-pay-attr.attr-value no-undo .
      358       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      359       define buffer last_cash-pay-attr for ub.cash-pay-attr .
      360       define variable v-type           as character no-undo .
      361       define variable v-format         as character no-undo .
      362       define variable v-label          as character no-undo .
      363       define variable v-range          as integer   no-undo .
      364       define variable v-user-can-edit  as logical   no-undo .
      365       define variable v-output-display as logical   no-undo .
      366       define variable v-other          as character no-undo .
      367       run cp-attr-code in this-procedure
      368         (input  p-code
      369         ,output v-type
      370         ,output v-format
      371         ,output v-label
      372         ,output v-range
      373         ,output v-user-can-edit
      374         ,output v-output-display
      375         ,output v-other
      376         ) no-error .
      377       if error-status :error then do:
      378         undo, return error return-value .
      379       end.
      380       find first buf_cash-pay-attr exclusive-lock
      381         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      382           and buf_cash-pay-attr.curr-code  = p-curr-code
      383           and buf_cash-pay-attr.host-code  = p-host-code
      384           and buf_cash-pay-attr.obj-type   = p-obj-type
      385           and buf_cash-pay-attr.obj-code   = p-obj-code
      386           and buf_cash-pay-attr.attr-code = p-code
      387         no-error .
      388       if not available buf_cash-pay-attr then do:
      389         create buf_cash-pay-attr .
      390         assign
      391         buf_cash-pay-attr.cdpay-code = p-cdpay-code
      392         buf_cash-pay-attr.curr-code  = p-curr-code
      393         buf_cash-pay-attr.host-code  = p-host-code
      394         buf_cash-pay-attr.obj-type   = p-obj-type
      395         buf_cash-pay-attr.obj-code   = p-obj-code
      396         buf_cash-pay-attr.attr-code = p-code
      397         .
      398       end.
      399       assign
      400         buf_cash-pay-attr.attr-value = p-value
      401       .
      402       release buf_cash-pay-attr no-error .
      403       if error-status:error then do:
      404         undo, return error return-value .
      405       end.
      406     end.
      407   end procedure.
      408   procedure cp-attr-exist :
      409     do
      410     on error undo, return error
      411     :
      412       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      413       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      414       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      415       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      416       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      417       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      418       define output parameter p-exist   as logical  no-undo .
      419       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      420       define variable v-type           as character no-undo .
      421       define variable v-format         as character no-undo .
      422       define variable v-label          as character no-undo .
      423       define variable v-range          as integer   no-undo .
      424       define variable v-user-can-edit  as logical   no-undo .
      425       define variable v-output-display as logical   no-undo .
      426       define variable v-other          as character no-undo .
      427       run cp-attr-code in this-procedure
      428         (input  p-code
      429         ,output v-type
      430         ,output v-format
      431         ,output v-label
      432         ,output v-range
      433         ,output v-user-can-edit
      434         ,output v-output-display
      435         ,output v-other
      436         ) no-error .
      437       if error-status :error then do:
      438         undo, return error return-value .
      439       end.
      440       find first buf_cash-pay-attr exclusive-lock
      441         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      442           and buf_cash-pay-attr.curr-code  = p-curr-code
      443           and buf_cash-pay-attr.host-code  = p-host-code
      444           and buf_cash-pay-attr.obj-type   = p-obj-type
      445           and buf_cash-pay-attr.obj-code   = p-obj-code
      446           and buf_cash-pay-attr.attr-code = p-code
      447         no-error .
      448       if  available buf_cash-pay-attr then do:
      449         p-exist = yes.
      450       end.
      451     end.
      452   end procedure.
      453   procedure cp-attr-delete :
      454     do
      455     on error undo, return error
      456     :
      457       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      458       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      459       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      460       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      461       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      462       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      463       define output parameter p-deleted  as logical no-undo.
      464       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      465       define variable v-type           as character no-undo .
      466       define variable v-format         as character no-undo .
      467       define variable v-label          as character no-undo .
      468       define variable v-range          as integer   no-undo .
      469       define variable v-user-can-edit  as logical   no-undo .
      470       define variable v-output-display as logical   no-undo .
      471       define variable v-other          as character no-undo .
      472       run cp-attr-code in this-procedure
      473         (input  p-code
      474         ,output v-type
      475         ,output v-format
      476         ,output v-label
      477         ,output v-range
      478         ,output v-user-can-edit
      479         ,output v-output-display
      480         ,output v-other
      481         ) no-error .
      482       if error-status :error then do:
      483         undo, return error return-value .
      484       end.
      485       find first buf_cash-pay-attr exclusive-lock
      486         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      487           and buf_cash-pay-attr.curr-code  = p-curr-code
      488           and buf_cash-pay-attr.host-code  = p-host-code
      489           and buf_cash-pay-attr.obj-type   = p-obj-type
      490           and buf_cash-pay-attr.obj-code   = p-obj-code
      491           and buf_cash-pay-attr.attr-code = p-code
      492         no-error NO-WAIT.
      493       if not available buf_cash-pay-attr then do:
      494         p-deleted = no.
      495       end.
      496       else do:
      497         delete buf_cash-pay-attr no-error .
      498         if error-status:error then do:
      499           undo, return error return-value .
      500         end.
      501         p-deleted = yes.
      502       end.
      503     end.
      504   end procedure.
      505   procedure cp-attr-news :
      506     do
      507     on error undo, return error
      508     :
      509       define input  parameter p-code           as character no-undo .
      510       define output parameter p-news           as logical   no-undo .
      511       case p-code :
      512               when 'paycard-export-prefix':U then do:     assign     p-news = true.   end.
      513               when 'grp-code':U then do:     assign     p-news = true.   end.
      514               when 'is-use':U then do:     assign     p-news = true.   end.
      515               when 'dop-doc':U then do:     assign     p-news = true.   end.
      516               when 'paycard-all-prefix':U then do:     assign     p-news = true.   end.
      517               when 'paycard-edit-prefix':U then do:     assign     p-news = true.   end.
      518               when 'form_km3':U then do:     assign     p-news = false.   end.
      519               when 'bal_malina':U then do:     assign     p-news = false.   end.
      520               when 'max_proc_sum':U then do:     assign     p-news = true.   end.
      521               when 'mask_card_kup':U then do:     assign     p-news = true.   end.
      522         otherwise do:
      523           p-news = no.
      524         end.
      525       end.
      526     end.
      527   end procedure.
      528   procedure cp-attr-hist :
      529     do
      530     on error undo, return error
      531     :
      532       define input  parameter p-code           as character no-undo .
      533       define output parameter p-hist           as logical   no-undo .
      534       case p-code :
      535               when 'paycard-export-prefix':U then do:     assign     p-hist = true.   end.
      536               when 'paycard-all-prefix':U then do:     assign     p-hist = true.   end.
      537               when 'paycard-edit-prefix':U then do:     assign     p-hist = true.   end.
      538               when 'form_km3':U then do:     assign     p-hist = true.   end.
      539               when 'bal_malina':U then do:     assign     p-hist = true.   end.
      540               when 'max_proc_sum':U then do:     assign     p-hist = true.   end.
      541               when 'mask_card_kup':U then do:     assign     p-hist = true.   end.
      542         otherwise do:
      543           p-hist = no.
      544         end.
      545       end.
      546     end.
      547   end procedure.
