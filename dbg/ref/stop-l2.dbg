        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-rec as recid no-undo .
        4   define input parameter p-silent as logical no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: stop-l2.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: ref/stop-l2.p $":U .
       10   define variable vss-description as character no-undo init "Закрытие стоплиста".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   define variable v-waitfram-action01         as character   no-undo .
       82   define variable v-waitfram-action02         as character   no-undo .
       83   define variable v-waitfram-action03         as character   no-undo .
       84   define variable mWaitFramTextBeg            as character   no-undo.
       85   define variable mWaitFramTextEnd            as character   no-undo.
       86   define variable mWaitFramView               as logical     no-undo.
       87   define variable mWaitProcEvent              as logical     no-undo init yes.
       88   define variable mWaitFramInterval           as integer     no-undo init 1 .
       89   define variable mWaitFramStop               as logical     no-undo.
       90   define variable mWaitFramStopUser           as logical     no-undo.
       91   define variable mWaitFramStopTimeOut        as logical     no-undo.
       92   define variable mWaitFramStartProc          as datetime-tz no-undo.
       93   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       94   define button B-WaitFramStop auto-end-key
       95        label "Стоп"
       96        size 10 by 1 tooltip "Остоновить процесс".
       97   define button B-viewProcInfo
       98        label "Информация"
       99        size 15 by 1 tooltip "Информация о процесс".
      100   define frame waitfram
      101     v-waitfram-action01 format "x(72)" no-label skip
      102     v-waitfram-action02 format "x(72)" no-label skip
      103     v-waitfram-action03 format "x(72)" no-label skip
      104     B-viewProcInfo
      105     B-WaitFramStop at row 4 col 30
      106     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      107     .
      108   define new global shared variable mBatchMode as logical no-undo init ?.
      109   define variable mFramBachModHandle as handle no-undo.
      110   mFramBachModHandle = frame waitfram:handle.
      111   define variable mFameOldVis as logical no-undo.
      112   define variable mVisCUrentVin as logical no-undo.
      113   if session:batch-mode
      114   then
      115      mBatchMode = yes.
      116   if mBatchMode = ? then do:
      117     mVisCUrentVin = current-window:visible.
      118     mFameOldVis = mFramBachModHandle:visible.
      119     mFramBachModHandle:visible  = yes.
      120     mBatchMode = mFramBachModHandle:visible ne yes.
      121     mFramBachModHandle:visible = mFameOldVis.
      122     current-window:visible = mVisCUrentVin.
      123   end.
      124    if  log-manager:logfile-name ne ?
      125     then DO:
      126         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      127         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      128         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      129     end.
      130   on choose of B-WaitFramStop in frame waitfram
      131   do:
      132     mWaitFramStop = yes.
      133     mWaitFramStopUser = yes.
      134   end.
      135   function waitfram-check-timeout returns logical():
      136      define variable vtime as int64 no-undo.
      137      if mWaitFramStopTimeOut
      138      then
      139         return yes.
      140      vtime = ( now - mWaitFramStartProc ) / 1000 .
      141      if     mWaitFramTimeOut ne ?
      142         and mWaitFramTimeOut ne 0
      143         and mWaitFramTimeOut lt vtime
      144      then do:
      145         mWaitFramStopTimeOut = yes.
      146      end.
      147      return mWaitFramStopTimeOut.
      148   end.
      149   procedure waitfram-hide :
      150     if not session:batch-mode
      151     then do
      152     on error undo, return error return-value
      153     :
      154       pause 0 before-hide .
      155       if not mBatchMode then
      156         hide frame waitfram .
      157     if     not mWaitFramView
      158        and mWaitProcEvent
      159     then
      160       process events .
      161     end.
      162   end procedure.
      163   procedure waitfram-show :
      164     define input  parameter p-message as character no-undo .
      165     define variable v-left-margin as integer   no-undo .
      166     if not session:batch-mode
      167     then do
      168     on error undo, return error return-value
      169     :
      170       if length(p-message) <= 70 then do:
      171         assign
      172           v-left-margin = integer((70 - length(p-message)) / 2)
      173         .
      174         assign
      175           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      176         .
      177         assign
      178           v-waitfram-action01 = " "
      179           v-waitfram-action02 = " "
      180                                    + fill(" ", v-left-margin)
      181                                    + p-message
      182           v-waitfram-action03 = " "
      183         .
      184       end.
      185       else do:
      186         define variable vRindex1 as integer no-undo.
      187         define variable vRindex2 as integer no-undo.
      188         vRindex1 = r-index(p-message," ",70).
      189         if vRindex1 = 0
      190         then
      191            vRindex1 = 70.
      192         if length(p-message)  <= vRindex1 + 70 then do:
      193           assign
      194             v-waitfram-action01 = " "
      195             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      196             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      197           .
      198         end.
      199         else do:
      200           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      201           if vRindex2 <= vRindex1
      202           then
      203              vRindex2 = vRindex1 + 70.
      204           assign
      205             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      206             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      207             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      208           .
      209         end.
      210       end.
      211       B-viewProcInfo:visible   in frame waitfram = no.
      212       B-viewProcInfo:sensitive in frame waitfram = no.
      213       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      214       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      215       if  (   mWaitFramView
      216          or  mWaitProcEvent)
      217          and not mBatchMode
      218       then
      219          display
      220             v-waitfram-action01 skip
      221             v-waitfram-action02 skip
      222             v-waitfram-action03 skip
      223          with frame waitfram .
      224       if     mWaitFramView
      225          then do:
      226             if     mWaitFramInterval ne ?
      227                and not mBatchMode
      228             then
      229                wait-for go of frame waitfram pause mWaitFramInterval.
      230          end.
      231          else
      232             if     mWaitProcEvent
      233                and not mBatchMode
      234             then
      235                process events .
      236     end.
      237   end procedure.
      238      procedure waitfram-show-this:
      239         define input  parameter iInterval as int64 no-undo.
      240         define variable vtime as int64 no-undo.
      241         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      242         mWaitFramInterval = iInterval.
      243         run waitfram-show (substitute("&1&2 &3&4" ,
      244                                       mWaitFramTextBeg ,
      245                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      246                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      247                                       mWaitFramTextEnd
      248                                      )
      249                           ).
      250      end.
      251      procedure WaitFramRunPause:
      252         define input  parameter iInterval as dec no-undo.
      253         define variable vStart  as datetime-tz no-undo.
      254         define variable vend    as datetime-tz no-undo.
      255         define variable vint as int64 no-undo.
      256         define variable vOk as logical no-undo.
      257         vStart = now.
      258         vend   = vStart.
      259         publish "WaitFramPause" (iInterval,output vOk).
      260         vend   =  now.
      261         vint = vend - vStart.
      262         vint = iInterval - vint / 1000.
      263         if     not mWaitFramStop
      264            and (   vint > 0
      265                 or (    not vOk
      266                     and iInterval eq ?
      267                     )
      268                 )
      269         then
      270            run waitfram-show-this (iInterval).
      271         vend   =  now.
      272         vint = vend - vStart.
      273         vint = iInterval - vint / 1000.
      274         if     not mWaitFramStop
      275            and vint > 0
      276         then do:
      277            run gbl/pause.p (vint * 1000).
      278         end.
      279         if iInterval ne ?
      280         then
      281            publish "WaitFramStop".
      282         waitfram-check-timeout().
      283      end.
      284      procedure WaitFramWaitFor:
      285         define input  parameter iInterval as dec no-undo.
      286         assign
      287            mWaitFramStartProc   = now
      288            mWaitFramStopUser    = no
      289            mWaitFramStopTimeOut = no
      290         .
      291         block-wait:
      292         do while not mWaitFramStop:
      293            run WaitFramRunPause (iInterval).
      294            if  waitfram-check-timeout()
      295            then do:
      296               leave block-wait.
      297            end.
      298         end.
      299         run waitfram-hide.
      300      end.
      301   procedure waitfram-join :
      302     define input  parameter p-line-1  as character no-undo .
      303     define input  parameter p-line-2  as character no-undo .
      304     define input  parameter p-line-3  as character no-undo .
      305     define output parameter p-message as character no-undo .
      306     do
      307     on error undo, return error return-value
      308     :
      309       assign
      310         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      311                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      312                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      313       .
      314     end.
      315   end procedure.
      316   function waitfram-join-function returns character
      317     (input p-line-1 as character
      318     ,input p-line-2 as character
      319     ,input p-line-3 as character
      320     ).
      321     define variable v-message as character no-undo .
      322     run waitfram-join in this-procedure
      323       (input  p-line-1
      324       ,input  p-line-2
      325       ,input  p-line-3
      326       ,output v-message
      327       ) .
      328     return v-message .
      329   end function .
      330   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      331   procedure cur-time :
      332      define output parameter p-today as date      no-undo .
      333      define output parameter p-time  as integer   no-undo .
      334     do
      335     on error undo, return error
      336     :
      337       define variable v-date1 as date      no-undo .
      338       define variable v-date2 as date      no-undo .
      339       define variable v-time  as integer   no-undo .
      340       assign
      341         v-date1 = today
      342         v-time  = time
      343         v-date2 = today
      344       .
      345       if v-date1 <> v-date2
      346       then do:
      347         assign
      348           v-date1 = today
      349           v-time  = v-time
      350         .
      351       end.
      352       assign
      353         p-today = v-date1
      354         p-time  = v-time
      355       .
      356     end.
      357   end.
      358   function cur-time-date returns character
      359   :
      360     return string(today, '99/99/9999':U) .
      361   end.
      362   function cur-time-mjd returns decimal
      363   :
      364     define variable v-date as date      no-undo .
      365     define variable v-time as integer   no-undo .
      366     run cur-time in this-procedure
      367       (output v-date
      368       ,output v-time
      369       ) .
      370     return integer(v-date) - 2400002 + (v-time / 86400) .
      371   end.
      372   function cur-time-get-ending-index returns integer
      373   (input p-number as integer
      374   )
      375   :
      376     if p-number < 0
      377     or p-number = ?
      378     then do:
      379       return 1 .
      380     end.
      381     define variable v-rest as integer   no-undo .
      382     assign
      383       p-number = p-number modulo 100
      384     .
      385     if p-number < 20
      386     then do:
      387       assign
      388         v-rest = p-number
      389       .
      390     end.
      391     else do:
      392       assign
      393         v-rest = p-number modulo 10
      394       .
      395     end.
      396     case v-rest :
      397       when 1
      398       then do:
      399         return 2 .
      400       end.
      401       when 2 or
      402       when 3 or
      403       when 4
      404       then do:
      405         return 3 .
      406       end.
      407       otherwise do:
      408         return 1 .
      409       end.
      410     end case .
      411   end.
      412   procedure cur-time-mjd-to-date :
      413      define input  parameter i-mjd-diff as decimal no-undo.
      414      define output parameter o-Date     as date    no-undo.
      415      define output parameter o-Time     as integer no-undo.
      416      define variable v-day-number as integer   no-undo .
      417      if    i-mjd-diff < 0
      418         or i-mjd-diff = ?
      419      then do:
      420         return "?" .
      421      end.
      422      assign
      423         v-day-number = truncate(i-mjd-diff,0).
      424         o-Date = date(v-day-number + 2400002).
      425         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      426     .
      427   end.
      428   function cur-time-mjd-to-string returns character
      429   (input p-mjd-diff as decimal
      430   )
      431   :
      432     define variable v-day-number as integer   no-undo .
      433     define variable v-seconds    as integer   no-undo .
      434     define variable v-hour       as integer   no-undo .
      435     define variable v-min        as integer   no-undo .
      436     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      437     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      438     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      439     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      440     if p-mjd-diff < 0
      441     or p-mjd-diff = ?
      442     then do:
      443       return "?" .
      444     end.
      445     assign
      446       v-day-number = integer(truncate(p-mjd-diff,0))
      447       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      448     .
      449     if v-seconds > 86400
      450     then do:
      451       assign
      452         v-seconds = 86400 - 1
      453       .
      454     end.
      455     if v-seconds < 0
      456     then do:
      457       assign
      458         v-seconds = 0
      459       .
      460     end.
      461     assign
      462       v-hour = truncate(v-seconds / 3600, 0)
      463     .
      464     assign
      465       v-seconds = v-seconds modulo 3600
      466     .
      467     assign
      468       v-min = truncate(v-seconds / 60, 0)
      469     .
      470     assign
      471       v-seconds = v-seconds modulo 60
      472     .
      473     return
      474         (if v-day-number <> 0
      475           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      476           else ""
      477         )
      478       + (if v-day-number <> 0 or v-hour <> 0
      479           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      480           else ""
      481         )
      482       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      483           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      484           else ""
      485         )
      486       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      487       .
      488   end.
      489   function cur-time-string returns character
      490   :
      491     define variable v-date as date      no-undo .
      492     define variable v-time as integer   no-undo .
      493     run cur-time in this-procedure
      494       (output v-date
      495       ,output v-time
      496       ) .
      497     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      498   end.
      499   function cur-time-string-sec returns character
      500   :
      501     define variable v-date as date      no-undo .
      502     define variable v-time as integer   no-undo .
      503     run cur-time in this-procedure
      504       (output v-date
      505       ,output v-time
      506       ) .
      507     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      508   end.
      509   function cur-time-custom  returns character
      510   (input p-prefix as character
      511   ,input p-date-format as character
      512   ,input p-delimiter as character
      513   ,input p-time-format as character
      514   ,input p-suffix as character
      515   )
      516   :
      517     define variable v-date as date      no-undo .
      518     define variable v-time as integer   no-undo .
      519     run cur-time in this-procedure
      520       (output v-date
      521       ,output v-time
      522       ) .
      523     return
      524       p-prefix
      525       + string(v-date, p-date-format)
      526       + p-delimiter
      527       + string(v-time, p-time-format)
      528       + p-suffix
      529       .
      530   end.
      531   function cur-time-print  returns character
      532   :
      533     define variable v-date as date      no-undo .
      534     define variable v-time as integer   no-undo .
      535     run cur-time in this-procedure
      536       (output v-date
      537       ,output v-time
      538       ) .
      539     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      540   end.
      541   function cur-time-datetime returns datetime
      542   :
      543     define variable v-char as character no-undo .
      544     define variable v-datetime as datetime no-undo .
      545     v-char = cur-time-string().
      546     v-datetime = datetime(v-char).
      547     return  v-datetime.
      548   end.
      549   function cur-time-string-msec returns character
      550   :
      551     define variable v-date as datetime  no-undo .
      552     v-date = now.
      553     return string(v-date) .
      554   end.
      555   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      556   procedure factord :
      557     define input  parameter p-fact-date            as date    no-undo .
      558     define input  parameter p-fact-time            as integer no-undo .
      559     define input  parameter p-fact-num             as integer no-undo .
      560     define input  parameter p-shift-date           as date    no-undo .
      561     define input  parameter p-shift-num            as integer no-undo .
      562     define input  parameter p-shift-on             as logical no-undo .
      563     define output parameter p-fact-order           as decimal no-undo .
      564     define output parameter p-shift-end-fact-order as decimal no-undo .
      565     define output parameter p-day-end-fact-order   as decimal no-undo .
      566     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      567     if p-fact-date = ?
      568     then do:
      569       return error "Не указана фактическая дата" .
      570     end.
      571     define variable v-fact-date-num as integer no-undo .
      572     assign
      573       v-fact-date-num = integer(p-fact-date)
      574     .
      575     if p-fact-num = ?
      576     or p-fact-num = 0
      577     then do:
      578       return error "Не задан p-fact-num " + string(p-fact-num) .
      579     end.
      580     if p-fact-num < 0
      581     then do:
      582       return error "Отрицательный fact-num " + string(p-fact-num) .
      583     end.
      584     if p-fact-num >= 100000000
      585     then do:
      586       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      587     end.
      588     if p-shift-on = true
      589     then do:
      590       if p-shift-date = ?
      591       then do:
      592         return error "Не задана дата смены" .
      593       end.
      594       if p-shift-num = ?
      595       or p-shift-num = 0
      596       then do:
      597         return error "Не задан номер смены" .
      598       end.
      599     end.
      600     else do:
      601       assign
      602         p-shift-date = p-fact-date
      603         p-shift-num  = 24
      604       .
      605     end.
      606     define variable v-shift-offset as integer no-undo .
      607     if p-shift-date = p-fact-date
      608     then do:
      609       assign
      610         v-shift-offset = 1
      611       .
      612     end.
      613     if p-shift-date < p-fact-date
      614     then do:
      615       assign
      616         v-shift-offset = 0
      617       .
      618     end.
      619     if p-shift-date > p-fact-date
      620     then do:
      621       message
      622         vss-workfile vss-revision vss-description skip
      623         "Неправильная дата закрытия смены" skip
      624         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      625         view-as alert-box error .
      626       undo, return error
      627         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      628           ,string(p-fact-date, '99/99/9999':U)
      629           ,string(p-shift-date, '99/99/9999':U)
      630           )
      631       .
      632     end.
      633     if p-shift-num < 1
      634     or p-shift-num > 24
      635     then do:
      636       message
      637         vss-workfile vss-revision vss-description skip
      638         "Неправильный номер смены" skip
      639         "p-shift-num" p-shift-num skip
      640         view-as alert-box error .
      641       undo, return error return-value .
      642     end.
      643     assign
      644       p-fact-order           = v-fact-date-num
      645                              + v-shift-offset * 0.5
      646                              + p-shift-num    * 0.02 - 0.01
      647                              + p-fact-num     * 0.0000000001
      648       p-shift-end-fact-order = v-fact-date-num
      649                              + v-shift-offset * 0.5
      650                              + p-shift-num    * 0.02
      651       p-day-end-fact-order   = v-fact-date-num
      652                              + 0.99
      653     .
      654     if p-fact-order           <= v-fact-date-num
      655     or p-shift-end-fact-order <= v-fact-date-num
      656     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      657     or p-shift-end-fact-order >= p-day-end-fact-order
      658     then do:
      659       message
      660         vss-workfile vss-revision vss-description skip
      661         "Внутренняя ошибка при генерации фактического номера" skip
      662         "p-fact-date"            p-fact-date            skip
      663         "p-fact-time"            p-fact-time            skip
      664         "p-fact-num"             p-fact-num             skip
      665         "p-shift-date"           p-shift-date           skip
      666         "p-shift-num"            p-shift-num            skip
      667         "p-shift-on"             p-shift-on             skip
      668         "p-shift-end-fact-order" p-shift-end-fact-order skip
      669         "p-day-end-fact-order"   p-day-end-fact-order   skip
      670         "v-fact-date-num"        v-fact-date-num        skip
      671         view-as alert-box error .
      672       undo, return error return-value .
      673     end.
      674   end procedure.
      675   procedure day-begin-fact-order :
      676     define input  parameter p-fact-date            as date    no-undo .
      677     define output parameter p-day-begin-fact-order as decimal no-undo .
      678     do
      679     on error undo, return error return-value
      680     :
      681       if p-fact-date = ?
      682       then do:
      683         assign
      684           p-day-begin-fact-order = 0
      685         .
      686       end.
      687       else do:
      688         assign
      689           p-day-begin-fact-order = integer(p-fact-date)
      690         .
      691       end.
      692     end.
      693   end procedure.
      694   procedure factord-max-fact-order :
      695     define output parameter p-max-fact-order as decimal   no-undo .
      696     do
      697     on error undo, return error return-value
      698     :
      699       run day-begin-fact-order in this-procedure
      700         (input  date(1, 1, 5000)
      701         ,output p-max-fact-order
      702         ) .
      703     end.
      704   end procedure.
      705   procedure factord-cut-archive :
      706     define input  parameter p-obj-type             as character no-undo .
      707     define input  parameter p-obj-code             as integer   no-undo .
      708     define input  parameter p-fact-date            as date      no-undo .
      709     define output parameter p-shift-on             as logical   no-undo .
      710     define output parameter p-shift-date           as date      no-undo .
      711     define output parameter p-shift-num            as integer   no-undo .
      712     define output parameter p-day-end-fact-order   as decimal   no-undo .
      713     define output parameter p-shift-end-fact-order as decimal   no-undo .
      714     define variable v-fact-order as decimal   no-undo .
      715     define buffer buf_shift-obj for ub.shift-obj .
      716     do
      717     on error undo, return error return-value
      718     :
      719   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      720   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      721     (input  p-obj-type
      722     ,input  p-obj-code
      723     ,input  'shift-on=request'
      724     ,output p-shift-on
      725     ) no-error .
      726       if error-status :error
      727       then do:
      728         message
      729           vss-workfile vss-revision vss-description skip
      730           "Ошибка при определении атрибута объекта" skip
      731           "Объект" p-obj-type p-obj-code skip
      732           error-status :get-message(1) skip
      733           return-value skip
      734           view-as alert-box error .
      735         undo, return error return-value .
      736       end.
      737       if p-shift-on = false
      738       then do:
      739         assign
      740           p-shift-date               = ?
      741           p-shift-num                = 0
      742         .
      743       end.
      744       else do:
      745         find first buf_shift-obj share-lock
      746           where buf_shift-obj.obj-type   = p-obj-type
      747             and buf_shift-obj.obj-code   = p-obj-code
      748             and buf_shift-obj.shift-date > p-fact-date
      749           use-index pi
      750           no-error .
      751         if not available buf_shift-obj
      752         or buf_shift-obj.status_ <> 'зкр':U
      753         then do:
      754           message
      755             vss-workfile vss-revision vss-description skip
      756             "Невозможно вычислить последнюю смену" skip
      757             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      758             "Объект" p-obj-type p-obj-code skip
      759             "Дата" p-fact-date skip
      760             view-as alert-box error .
      761           undo, return error return-value .
      762         end.
      763         find last buf_shift-obj share-lock
      764           where buf_shift-obj.obj-type = p-obj-type
      765             and buf_shift-obj.obj-code = p-obj-code
      766             and buf_shift-obj.shift-date <= p-fact-date
      767           use-index pi
      768           no-error .
      769         if available buf_shift-obj
      770         then do:
      771           if  buf_shift-obj.status_ = 'зкр':U
      772           then do:
      773             assign
      774               p-shift-date = buf_shift-obj.shift-date
      775               p-shift-num  = buf_shift-obj.shift-num
      776             .
      777           end.
      778           else do:
      779             message
      780               vss-workfile vss-revision vss-description skip
      781               "Невозможно вычислить последнюю смену" skip
      782               "Статус смены отличен от статуса" 'зкр':U skip
      783               "Объект" p-obj-type p-obj-code skip
      784               "Дата" p-fact-date skip
      785               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      786               view-as alert-box error .
      787             undo, return error return-value .
      788           end.
      789         end.
      790         else do:
      791           assign
      792             p-shift-date = p-fact-date - 1
      793             p-shift-num  = 1
      794           .
      795         end.
      796       end.
      797       run factord in this-procedure
      798         (input  p-fact-date
      799         ,input  1
      800         ,input  1
      801         ,input  p-shift-date
      802         ,input  p-shift-num
      803         ,input  p-shift-on
      804         ,output v-fact-order
      805         ,output p-shift-end-fact-order
      806         ,output p-day-end-fact-order
      807         ) no-error .
      808       if error-status :error
      809       then do:
      810         message
      811           vss-workfile vss-revision vss-description skip
      812           "Ошибка при вызове процедуры factord"
      813           error-status :get-message(1) skip
      814           return-value skip
      815           view-as alert-box error .
      816         undo, return error return-value .
      817       end.
      818     end.
      819   end procedure.
      820   procedure factord-lock-shift :
      821     define input  parameter p-obj-type  as character no-undo .
      822     define input  parameter p-obj-code  as integer   no-undo .
      823     define input  parameter p-fact-date as date      no-undo .
      824     define parameter buffer buf_shift-obj for ub.shift-obj .
      825     define variable v-shift-on      as logical   no-undo .
      826     define variable v-extra-message as character no-undo .
      827     define variable v-error as character no-undo .
      828     do
      829     on error undo, return error return-value
      830     :
      831   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      832   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      833     (input  p-obj-type
      834     ,input  p-obj-code
      835     ,input  'shift-on=request'
      836     ,output v-shift-on
      837     ) no-error .
      838       if error-status :error
      839       then do:
      840         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      841         undo, return error v-error .
      842       end.
      843       if v-shift-on = true
      844       then do:
      845         find first buf_shift-obj share-lock
      846           where buf_shift-obj.obj-type   = p-obj-type
      847             and buf_shift-obj.obj-code   = p-obj-code
      848             and buf_shift-obj.shift-date > p-fact-date
      849           use-index pi
      850           no-error .
      851         if not available buf_shift-obj
      852         or buf_shift-obj.status_ <> 'зкр':U
      853         then do:
      854           find last buf_shift-obj
      855             where buf_shift-obj.obj-type = p-obj-type
      856               and buf_shift-obj.obj-code = p-obj-code
      857               and buf_shift-obj.status_  = 'зкр':U
      858             use-index stts
      859             no-error .
      860           if available buf_shift-obj
      861           then do:
      862             assign
      863               v-extra-message =
      864                     substitute("Дата начала последеней закрытой смены на объекте &1"
      865                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      866                               )
      867             .
      868           end.
      869           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      870           undo, return error v-error .
      871         end.
      872       end.
      873     end.
      874   end procedure.
      875   procedure factord-end-day :
      876     define input  parameter p-fact-date            as date    no-undo .
      877     define output parameter p-day-end-fact-order   as decimal no-undo .
      878     do
      879     on error undo, return error return-value
      880     :
      881       if p-fact-date = ?
      882       then do:
      883         return error "Не указана фактическая дата" .
      884       end.
      885       assign
      886         p-day-end-fact-order = integer(p-fact-date) + 0.99
      887       .
      888     end.
      889   end procedure.
      890   procedure factord-to-date :
      891     define input  parameter p-fact-order as decimal no-undo .
      892     define output parameter p-fact-date  as date    no-undo .
      893     define variable v-ref-date  as date      no-undo .
      894     define variable v-ref-delta as integer   no-undo .
      895     do
      896     on error undo, return error return-value
      897     :
      898       if p-fact-order = ?
      899       or p-fact-order = 0
      900       then do:
      901         return error "Не указан fact-order" .
      902       end.
      903       assign
      904         v-ref-date  = date(1, 1, 2000)
      905       .
      906       assign
      907         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      908       .
      909       assign
      910         p-fact-date = v-ref-date + v-ref-delta
      911       .
      912     end.
      913   end procedure.
      914   procedure factord-to-fact-num :
      915     define input  parameter p-fact-order as decimal no-undo .
      916     define output parameter p-fact-num   as integer no-undo .
      917     define variable v-fact-order-trunc as decimal no-undo .
      918     do
      919     on error undo, return error return-value
      920     :
      921       if p-fact-order = ?
      922       or p-fact-order = 0
      923       then do:
      924         return error "Не указан fact-order" .
      925       end.
      926       assign
      927        v-fact-order-trunc = truncate(p-fact-order, 2)
      928       .
      929       assign
      930         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      931       .
      932     end.
      933   end procedure.
      934   procedure factord-to-shift-num :
      935     define input  parameter p-fact-order as decimal no-undo .
      936     define output parameter p-shift-num   as integer no-undo .
      937     define variable  p-shift-numd  as decimal   no-undo .
      938     define variable v-fact-order-trunc as decimal no-undo .
      939     do
      940     on error undo, return error return-value
      941     :
      942       if p-fact-order = ?
      943       or p-fact-order = 0
      944       then do:
      945         return error "Не указан fact-order" .
      946       end.
      947       assign
      948        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      949       .
      950       if v-fact-order-trunc < 0.5 then do:
      951         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      952       end.
      953       assign
      954         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      955         .
      956        assign
      957         p-shift-num = truncate (p-shift-numd , 0)
      958       .
      959     end.
      960   end procedure.
      961   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      962     define variable v-cntxt-db-num        as integer   no-undo .
      963     define variable v-cntxt-userid        as character no-undo .
      964     define variable v-cntxt-level         as character no-undo .
      965     define variable v-cntxt-host-code-obj as integer   no-undo .
      966     define variable v-cntxt-obj-type      as character no-undo .
      967     define variable v-cntxt-obj-code      as integer   no-undo .
      968     define variable v-cntxt-db-num-obj    as integer   no-undo .
      969     define variable v-cntxt-is-admin      as logical   no-undo .
      970   define variable v-mess as character no-undo .
      971   DEFINE VARIABLE v-today as date no-undo .
      972   DEFINE VARIABLE v-time as integer no-undo .
      973   define variable v-doc-date as date no-undo .
      974   define variable v-fact-date as date no-undo .
      975   define variable v-fact-time as integer no-undo .
      976   define variable v-status_ as character no-undo .
      977   define variable v-stop-list-value as character no-undo .
      978   DEFINE VARIABLE d-fact-ord  LIKE ub.stop-list.fact-order NO-UNDO.
      979   DEFINE VARIABLE d-shift-ord LIKE ub.stop-list.fact-order NO-UNDO.
      980   DEFINE VARIABLE day-end-ord LIKE ub.stop-list.fact-order NO-UNDO.
      981   define variable v-fact-num as integer no-undo .
      982   define variable v-status as character no-undo .
      983   define buffer buf_stop-list  for ub.stop-list.
      984   define buffer buf_stop-list-line for ub.stop-list-line.
      985   define buffer buf_Dis-card for ub.dis-card.
      986   main-block:
      987   do
      988   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      989   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      990   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      991   :
      992     if g#db-num <> 0 then do:
      993       message
      994       vss-workfile vss-revision vss-description skip
      995       "Данная процедура не может вызываться в УБД"
      996       view-as alert-box error .
      997       undo main-block, return error .
      998     end.
      999     find first buf_stop-list exclusive-lock where
     1000           recid(buf_stop-list) = p-rec .
     1001     if buf_stop-list.status_ = 'факт':U then do:
     1002       v-mess = substitute("Стоплист &1 уже закрыт до статуса &2"
     1003                           , buf_stop-list.stop-list-code
     1004                           , buf_stop-list.status_
     1005                           ).
     1006       run err-mess in this-procedure ( input-output v-mess).
     1007       return error (if p-silent = yes then v-mess else '':U).
     1008     end.
     1009   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1010     run mainmenu_getcntxt in parparentproc
     1011       (output v-cntxt-db-num
     1012       ,output v-cntxt-userid
     1013       ,output v-cntxt-level
     1014       ,output v-cntxt-host-code-obj
     1015       ,output v-cntxt-obj-type
     1016       ,output v-cntxt-obj-code
     1017       ,output v-cntxt-db-num-obj
     1018       ,output v-cntxt-is-admin
     1019       ) .
     1020     run cur-time in this-procedure ( output v-today, output v-time).
     1021     v-fact-num = NEXT-VALUE( s-stop-list-fact, ub ).
     1022     RUN factord IN THIS-PROCEDURE (
     1023                                     INPUT v-today
     1024                                    ,INPUT v-time
     1025                                    ,INPUT v-fact-num
     1026                                    ,INPUT ?
     1027                                    ,INPUT 0
     1028                                    ,INPUT no
     1029                                    ,OUTPUT d-fact-ord
     1030                                    ,OUTPUT d-shift-ord
     1031                                    ,OUTPUT day-end-ord
     1032                                   ) NO-ERROR.
     1033     IF ERROR-STATUS:ERROR OR
     1034         d-fact-ord = ? OR
     1035         d-fact-ord = 0 THEN DO:
     1036       v-mess   = substitute("Ошибка при определении фактического номера стоплиста&1"
     1037                             ,chr(10)).
     1038       run err-mess in this-procedure ( input-output v-mess).
     1039       return error (if p-silent = yes then v-mess else '':U).
     1040     END.
     1041     if buf_stop-list.classif-type = 'dis-card':U then do:
     1042       for each buf_stop-list-line no-lock where
     1043              buf_stop-list-line.classif-type = buf_stop-list.classif-type
     1044          and buf_stop-list-line.stop-list-code = buf_stop-list.stop-list-code
     1045       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1046       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1047       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1048       :
     1049         if buf_stop-list-line.resource_id begins 'dis-card':U
     1050         and buf_stop-list-line.key#_one = integer('4':U) then do:
     1051           find first buf_dis-card no-lock where
     1052                    buf_dis-card.d-card = buf_stop-list-line.charkey_one no-error.
     1053           if not available buf_dis-card then do:
     1054             v-mess = substitute("!!!Не найдена карта &1 (строка &2)"
     1055                                  , buf_stop-list-line.charkey_one
     1056                                  , buf_stop-list-line.line-num).
     1057             run err-mess in this-procedure ( input-output v-mess).
     1058             return error (if p-silent = yes then v-mess else '':U).
     1059           end.
     1060           v-status = 'удал':U.
     1061           run ref/dcardi02.p (
     1062                              input parparentproc
     1063                             ,input recid(buf_dis-card)
     1064                             ,input yes
     1065                             ,input yes
     1066                             ,input "":U
     1067                             ,input 'stop-list':U
     1068                             ,input buf_stop-list.stop-list-code
     1069                             ,input v-cntxt-obj-type
     1070                             ,input v-cntxt-obj-code
     1071                             ,input-output v-status ) no-error .
     1072           if error-status:error then do:
     1073             v-mess =  substitute("!!!Ошибка при изменении статуса ДК &1 для клиента &2&3&4" +
     1074                                     "&5&4&6"
     1075                                     ,buf_dis-card.d-card
     1076                                     ,buf_dis-card.cli-type
     1077                                     ,buf_dis-card.cli-code
     1078                                     ,chr(10)
     1079                                     , error-status:get-message(1)
     1080                                     , return-value ).
     1081             run err-mess in this-procedure ( input-output v-mess).
     1082             return error (if p-silent = yes then v-mess else '':U).
     1083           end.
     1084         end.
     1085       end.
     1086     end.
     1087     assign
     1088     buf_stop-list.fact-num   = v-fact-num
     1089     buf_stop-list.fact-order = d-fact-ord
     1090     buf_stop-list.fact-date = v-today
     1091     buf_stop-list.status_ = 'факт':U
     1092     .
     1093     release buf_stop-list no-error.
     1094     if error-status:error then do:
     1095       v-mess =  substitute("Ошибка при записи шапки стоплиста &1&2" +
     1096                               "&3&2&4"
     1097                               ,buf_stop-list.stop-list-code
     1098                               ,chr(10)
     1099                               ,error-status:get-message(1)
     1100                               ,return-value ).
     1101       run err-mess in this-procedure ( input-output v-mess).
     1102       return error (if p-silent = yes then v-mess else '':U).
     1103     end.
     1104   end.
     1105   PROCEDURE err-mess:
     1106     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
     1107     CASE p-silent:
     1108       when yes then do:
     1109         assign
     1110         p-mess = substitute("Стоплист &1"
     1111                            , buf_stop-list.stop-list-code
     1112                            , p-mess)
     1113         .
     1114       end.
     1115       when no then do:
     1116         message
     1117         p-mess
     1118         view-as alert-box error .
     1119       end.
     1120     end.
     1121   END PROCEDURE.
