        1   DEFINE TEMP-TABLE tt0-rp-by-call NO-UNDO LIKE ub.rp-by-call.
        2   DEFINE TEMP-TABLE tt0-rule-by-call NO-UNDO LIKE ub.rule-by-call.
        3   DEFINE NEW SHARED TEMP-TABLE tt0-rule-call-param NO-UNDO LIKE ub.rule-call-param.
        4   DEFINE BUFFER X_dis-card-type FOR ub.dis-card-type.
        5   DEFINE BUFFER X_rp-by-call FOR ub.rp-by-call.
        6   DEFINE BUFFER X_rule FOR ub.rule.
        7   DEFINE BUFFER X_rule-by-call FOR ub.rule-by-call.
        8   DEFINE BUFFER X_rule-by-profile FOR ub.rule-by-profile.
        9   DEFINE BUFFER X_rule-profile FOR ub.rule-profile.
       10   define input parameter parparentproc as widget-handle no-undo .
       11   define input parameter p-parent-handle  as widget-handle no-undo .
       12   define input parameter p-log-handle  as handle no-undo .
       13   define input parameter p-parameter   as character no-undo .
       14   define variable vss-revision    as character no-undo init "$Revision$":U .
       15   define variable vss-author      as character no-undo init "$Author$":U .
       16   define variable vss-date        as character no-undo init "$Date$":U .
       17   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       18   define variable vss-archive     as character no-undo init "$Archive$":U .
       19   define variable vss-description as character no-undo init "Утилиты закачки стоплистов дисконтных карт-интерфейс".
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define new global shared variable g#library  as handle no-undo .
       79   define new global shared variable g#library2 as handle no-undo .
       80   procedure proc-alt-shift-f2:
       81     if not ibs.th.gbl.gbl-var:rcode
       82   then
       83     run gbl\inidebug.p .
       84   end.
       85   procedure proc-alt-shift-f3:
       86     run gbl/prvssinf.p
       87       ( input this-procedure
       88       ) .
       89   end.
       90   define variable v-inform-launched as logical no-undo initial false .
       91   procedure proc-alt-shift-f4:
       92     define variable v-action as character no-undo .
       93     if v-inform-launched = false then do:
       94       assign
       95         v-inform-launched = true
       96       .
       97       run gbl/d-inform.w
       98         (  input self
       99         ,  input this-procedure
      100         , output v-action
      101         ) no-error .
      102       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      103       assign
      104         v-inform-launched = false
      105       .
      106     end.
      107   end.
      108   procedure proc-alt-f1:
      109     run gbl/corrhelp.p
      110       (input this-procedure
      111       ) .
      112   end .
      113   on alt-shift-f2 anywhere do:
      114     run proc-alt-shift-f2.
      115   end.
      116   on alt-shift-f3 anywhere do:
      117     run proc-alt-shift-f3 in this-procedure .
      118   end.
      119   on alt-shift-f4 anywhere do:
      120     run proc-alt-shift-f4 in this-procedure.
      121   end.
      122   on alt-f1 anywhere do:
      123     run proc-alt-f1 in this-procedure .
      124   end.
      125   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      126     define variable v-cntxt-db-num        as integer   no-undo .
      127     define variable v-cntxt-userid        as character no-undo .
      128     define variable v-cntxt-level         as character no-undo .
      129     define variable v-cntxt-host-code-obj as integer   no-undo .
      130     define variable v-cntxt-obj-type      as character no-undo .
      131     define variable v-cntxt-obj-code      as integer   no-undo .
      132     define variable v-cntxt-db-num-obj    as integer   no-undo .
      133     define variable v-cntxt-is-admin      as logical   no-undo .
      134   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      135   procedure cur-time :
      136      define output parameter p-today as date      no-undo .
      137      define output parameter p-time  as integer   no-undo .
      138     do
      139     on error undo, return error
      140     :
      141       define variable v-date1 as date      no-undo .
      142       define variable v-date2 as date      no-undo .
      143       define variable v-time  as integer   no-undo .
      144       assign
      145         v-date1 = today
      146         v-time  = time
      147         v-date2 = today
      148       .
      149       if v-date1 <> v-date2
      150       then do:
      151         assign
      152           v-date1 = today
      153           v-time  = v-time
      154         .
      155       end.
      156       assign
      157         p-today = v-date1
      158         p-time  = v-time
      159       .
      160     end.
      161   end.
      162   function cur-time-date returns character
      163   :
      164     return string(today, '99/99/9999':U) .
      165   end.
      166   function cur-time-mjd returns decimal
      167   :
      168     define variable v-date as date      no-undo .
      169     define variable v-time as integer   no-undo .
      170     run cur-time in this-procedure
      171       (output v-date
      172       ,output v-time
      173       ) .
      174     return integer(v-date) - 2400002 + (v-time / 86400) .
      175   end.
      176   function cur-time-get-ending-index returns integer
      177   (input p-number as integer
      178   )
      179   :
      180     if p-number < 0
      181     or p-number = ?
      182     then do:
      183       return 1 .
      184     end.
      185     define variable v-rest as integer   no-undo .
      186     assign
      187       p-number = p-number modulo 100
      188     .
      189     if p-number < 20
      190     then do:
      191       assign
      192         v-rest = p-number
      193       .
      194     end.
      195     else do:
      196       assign
      197         v-rest = p-number modulo 10
      198       .
      199     end.
      200     case v-rest :
      201       when 1
      202       then do:
      203         return 2 .
      204       end.
      205       when 2 or
      206       when 3 or
      207       when 4
      208       then do:
      209         return 3 .
      210       end.
      211       otherwise do:
      212         return 1 .
      213       end.
      214     end case .
      215   end.
      216   procedure cur-time-mjd-to-date :
      217      define input  parameter i-mjd-diff as decimal no-undo.
      218      define output parameter o-Date     as date    no-undo.
      219      define output parameter o-Time     as integer no-undo.
      220      define variable v-day-number as integer   no-undo .
      221      if    i-mjd-diff < 0
      222         or i-mjd-diff = ?
      223      then do:
      224         return "?" .
      225      end.
      226      assign
      227         v-day-number = truncate(i-mjd-diff,0).
      228         o-Date = date(v-day-number + 2400002).
      229         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      230     .
      231   end.
      232   function cur-time-mjd-to-string returns character
      233   (input p-mjd-diff as decimal
      234   )
      235   :
      236     define variable v-day-number as integer   no-undo .
      237     define variable v-seconds    as integer   no-undo .
      238     define variable v-hour       as integer   no-undo .
      239     define variable v-min        as integer   no-undo .
      240     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      241     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      242     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      243     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      244     if p-mjd-diff < 0
      245     or p-mjd-diff = ?
      246     then do:
      247       return "?" .
      248     end.
      249     assign
      250       v-day-number = integer(truncate(p-mjd-diff,0))
      251       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      252     .
      253     if v-seconds > 86400
      254     then do:
      255       assign
      256         v-seconds = 86400 - 1
      257       .
      258     end.
      259     if v-seconds < 0
      260     then do:
      261       assign
      262         v-seconds = 0
      263       .
      264     end.
      265     assign
      266       v-hour = truncate(v-seconds / 3600, 0)
      267     .
      268     assign
      269       v-seconds = v-seconds modulo 3600
      270     .
      271     assign
      272       v-min = truncate(v-seconds / 60, 0)
      273     .
      274     assign
      275       v-seconds = v-seconds modulo 60
      276     .
      277     return
      278         (if v-day-number <> 0
      279           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      280           else ""
      281         )
      282       + (if v-day-number <> 0 or v-hour <> 0
      283           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      284           else ""
      285         )
      286       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      287           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      288           else ""
      289         )
      290       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      291       .
      292   end.
      293   function cur-time-string returns character
      294   :
      295     define variable v-date as date      no-undo .
      296     define variable v-time as integer   no-undo .
      297     run cur-time in this-procedure
      298       (output v-date
      299       ,output v-time
      300       ) .
      301     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      302   end.
      303   function cur-time-string-sec returns character
      304   :
      305     define variable v-date as date      no-undo .
      306     define variable v-time as integer   no-undo .
      307     run cur-time in this-procedure
      308       (output v-date
      309       ,output v-time
      310       ) .
      311     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      312   end.
      313   function cur-time-custom  returns character
      314   (input p-prefix as character
      315   ,input p-date-format as character
      316   ,input p-delimiter as character
      317   ,input p-time-format as character
      318   ,input p-suffix as character
      319   )
      320   :
      321     define variable v-date as date      no-undo .
      322     define variable v-time as integer   no-undo .
      323     run cur-time in this-procedure
      324       (output v-date
      325       ,output v-time
      326       ) .
      327     return
      328       p-prefix
      329       + string(v-date, p-date-format)
      330       + p-delimiter
      331       + string(v-time, p-time-format)
      332       + p-suffix
      333       .
      334   end.
      335   function cur-time-print  returns character
      336   :
      337     define variable v-date as date      no-undo .
      338     define variable v-time as integer   no-undo .
      339     run cur-time in this-procedure
      340       (output v-date
      341       ,output v-time
      342       ) .
      343     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      344   end.
      345   function cur-time-datetime returns datetime
      346   :
      347     define variable v-char as character no-undo .
      348     define variable v-datetime as datetime no-undo .
      349     v-char = cur-time-string().
      350     v-datetime = datetime(v-char).
      351     return  v-datetime.
      352   end.
      353   function cur-time-string-msec returns character
      354   :
      355     define variable v-date as datetime  no-undo .
      356     v-date = now.
      357     return string(v-date) .
      358   end.
      359   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      360   procedure gen-key-rec :
      361     define input  parameter p-tbl-name    as character no-undo.
      362     define input  parameter p-bh_tbl-name as handle    no-undo.
      363     define output parameter p-key-rec     as character no-undo.
      364     do
      365     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      366     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      367     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      368     :
      369       define variable fh               as handle    no-undo .
      370       define variable v-ok             as logical   no-undo .
      371       define variable v-inform         as character no-undo .
      372       define variable v-ind            as integer   no-undo .
      373       define variable v-idx-field-qnty as integer   no-undo .
      374       if p-tbl-name = ?
      375         or p-tbl-name = "":U
      376       then do:
      377         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info2 ).
      378       end.
      379       if not p-bh_tbl-name:available then do:
      380         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info2, p-tbl-name ).
      381       end.
      382       assign
      383         p-key-rec = p-tbl-name
      384         v-inform  = p-bh_tbl-name:index-information(1)
      385         v-ind     = 2
      386       .
      387       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      388       on error undo, return error
      389       :
      390         assign
      391           v-inform = p-bh_tbl-name:index-information( v-ind )
      392           v-ind    = v-ind + 1
      393         .
      394       end.
      395       if v-inform = ?
      396         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      397         or entry( 3, v-inform, ",":U ) <> "1":U
      398       then do:
      399         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, p-tbl-name ).
      400       end.
      401       else do:
      402         assign
      403           v-idx-field-qnty = num-entries( v-inform ) - 4
      404         .
      405         if v-idx-field-qnty < 2 then do:
      406           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, p-tbl-name ).
      407         end.
      408         do v-ind = 1 to v-idx-field-qnty by 2
      409         on error undo, return error
      410         :
      411           assign
      412             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      413             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      414           .
      415         end.
      416       end.
      417       if p-key-rec = ? then do:
      418         assign
      419           p-key-rec = "":U
      420         .
      421         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info2, p-tbl-name ).
      422       end.
      423     end.
      424     return.
      425   end procedure.
      426   procedure gen-where-keyr-tab :
      427     define input  parameter i-tableSerach as character no-undo.
      428     define input  parameter i-tablekey   as character  no-undo.
      429     define input  parameter p-key-rec    as character  no-undo.
      430     define input  parameter p-key-handle as handle     no-undo .
      431     define input  parameter p-db-name    as character  no-undo .
      432     define input  parameter p-tt-handle  as handle     no-undo .
      433     define output parameter o-Where      as character  no-undo.
      434     do
      435     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      436     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      437     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      438     :
      439       define variable v-full-tbl-name  as character no-undo .
      440       define variable bh_tbl-name      as handle    no-undo .
      441       define variable fh_key           as handle    no-undo .
      442       define variable fh_search        as handle    no-undo .
      443       define variable v-field-num      as integer   no-undo .
      444       define variable v-count-fld      as integer   no-undo .
      445       define variable v-inform         as character no-undo .
      446       define variable v-ind            as integer   no-undo .
      447       define variable v-idx-field-qnty as integer   no-undo .
      448       define variable v-field-name     as character no-undo .
      449       define variable v-field-val      as character no-undo .
      450       define variable v-word-link      as character no-undo .
      451       define variable vTable           as character no-undo.
      452       define variable bh_tbl-key       as handle    no-undo .
      453       assign
      454         p-key-rec = trim( p-key-rec )
      455       .
      456       if p-key-handle <> ? then do:
      457         if not valid-handle(p-key-handle)
      458            or p-key-handle:type <> "buffer"
      459         then do:
      460           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info2 ).
      461         end.
      462         if num-entries( p-key-rec, chr(3) ) > 1
      463           or p-key-rec = ?
      464           or p-key-rec = "":U
      465         then do:
      466           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info2, p-key-rec ).
      467         end.
      468       end.
      469       else do:
      470         if p-key-rec = ?
      471           or p-key-rec = "":U
      472         then do:
      473           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      474         end.
      475       end.
      476       assign
      477         vTable = entry( 1 , p-key-rec, chr(3) )
      478       .
      479       if p-tt-handle <> ?
      480         and ( not valid-handle(p-tt-handle)
      481               or p-tt-handle:type <> "buffer"
      482             )
      483       then do:
      484         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info2, vTable, chr(10) ).
      485       end.
      486       if p-tt-handle = ? then do:
      487         assign
      488           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      489         .
      490         create buffer bh_tbl-name for table v-full-tbl-name .
      491       end.
      492       else do:
      493         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      494       end.
      495       assign
      496         v-inform = bh_tbl-name:index-information(1)
      497         v-ind    = 2
      498       .
      499       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      500       on error undo, return error
      501       :
      502         assign
      503           v-inform = bh_tbl-name:index-information( v-ind )
      504           v-ind    = v-ind + 1
      505         .
      506       end.
      507       if v-inform = ?
      508         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      509         or entry( 3, v-inform, ",":U ) <> "1":U
      510       then do:
      511         delete object bh_tbl-name no-error.
      512         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info2, vTable ).
      513       end.
      514       assign
      515         v-idx-field-qnty = num-entries( v-inform ) - 4
      516       .
      517       if v-idx-field-qnty < 2 then do:
      518         delete object bh_tbl-name no-error.
      519         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, vTable ).
      520       end.
      521       assign
      522         o-where     = "where":U
      523         v-word-link = "":U
      524         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      525         v-count-fld = 0
      526       .
      527       if i-tablekey ne "" and i-tablekey ne ?
      528       then do:
      529         assign
      530           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      531         .
      532         create buffer bh_tbl-key for table v-full-tbl-name .
      533       end.
      534       if i-tableSerach ne "" and i-tableSerach ne ?
      535       then do:
      536         delete object bh_tbl-name no-error.
      537         assign
      538           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      539         .
      540         create buffer bh_tbl-name for table v-full-tbl-name .
      541       end.
      542       block_where:
      543       do v-ind = 1 to v-idx-field-qnty by 2
      544       on error undo, return error
      545       :
      546         assign
      547           v-count-fld = v-count-fld + 1
      548         .
      549         if p-key-handle = ?
      550           and v-count-fld > v-field-num
      551         then do:
      552           leave block_where.
      553         end.
      554         define variable VfieldKeyTable as handle no-undo.
      555         assign
      556           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      557           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      558         .
      559         if     bh_tbl-key ne ?
      560         then do:
      561            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      562            if VfieldKeyTable eq ?
      563            then next block_where.
      564         end.
      565         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      566         then
      567            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      568         else
      569            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      570         if p-key-handle = ? then do:
      571           assign
      572             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      573           .
      574         end.
      575         else do:
      576           assign
      577             fh_key = p-key-handle:buffer-field( v-field-name )
      578           .
      579           if fh_key = ?
      580             or not valid-handle( fh_key )
      581           then do:
      582             delete object bh_tbl-name.
      583             if     bh_tbl-key ne ?
      584             then
      585                delete object bh_tbl-key.
      586             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info2, p-key-handle:name, v-field-name ).
      587           end.
      588           assign
      589             v-field-val = fh_key:buffer-value
      590           .
      591         end.
      592         if fh_search:data-type ="character":U then do:
      593           assign
      594             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      595             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      596             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      597             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      598             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      599             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      600             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      601             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      602             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      603             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      604             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      605             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      606             v-field-val = substitute( '"&1"', v-field-val )
      607           .
      608         end.
      609         assign
      610           o-where = substitute( "&1 &2", o-where, v-field-val )
      611         .
      612         if v-word-link = "":U then do:
      613           assign
      614             v-word-link = "and":U
      615           .
      616         end.
      617       end.
      618       delete object bh_tbl-name.
      619       if     bh_tbl-key ne ?
      620       then
      621          delete object bh_tbl-key.
      622       if p-key-handle = ?
      623         and v-count-fld <> v-field-num
      624       then do:
      625         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info2, vTable ).
      626       end.
      627     end.
      628   end procedure.
      629   procedure gen-hn-keyr-tab :
      630     define input  parameter i-tableSerach as character no-undo.
      631     define input  parameter i-tablekey   as character no-undo.
      632     define input  parameter p-key-rec    as character no-undo.
      633     define input  parameter p-key-handle as handle    no-undo .
      634     define input  parameter p-db-name    as character no-undo .
      635     define input  parameter p-tt-handle  as handle    no-undo .
      636     define input  parameter p-stts-lock  as integer   no-undo .
      637     define output parameter o-hn         as handle    no-undo.
      638     define variable v-full-tbl-name as character no-undo.
      639     define variable v-where         as character no-undo.
      640     define variable bh_tbl-name     as handle    no-undo.
      641     define variable vTable          as character no-undo.
      642     do
      643     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      644     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      645     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      646         run gen-where-keyr-tab(i-tableSerach,
      647                                i-tablekey,
      648                                p-key-rec,
      649                                p-key-handle,
      650                                p-db-name,
      651                                p-tt-handle,
      652                                output v-where).
      653         if i-tableSerach ne "" and i-tableSerach ne ?
      654         then do:
      655            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      656            create buffer bh_tbl-name for table v-full-tbl-name .
      657         end.
      658         else do:
      659            if p-tt-handle = ? then do:
      660               assign
      661                  vTable = entry( 1 , p-key-rec, chr(3) )
      662               .
      663               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      664               create buffer bh_tbl-name for table v-full-tbl-name .
      665            end.
      666            else do:
      667               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      668            end.
      669         end.
      670         if p-tt-handle = ? then do:
      671            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      672         end.
      673         else do:
      674            bh_tbl-name:find-first( v-where ) no-error .
      675         end.
      676         o-hn = bh_tbl-name.
      677      end.
      678   end procedure.
      679   procedure gen-hn-keyr :
      680     define input  parameter p-key-rec    as character no-undo.
      681     define input  parameter p-key-handle as handle    no-undo .
      682     define input  parameter p-db-name    as character no-undo .
      683     define input  parameter p-tt-handle  as handle    no-undo .
      684     define input  parameter p-stts-lock  as integer   no-undo .
      685     define output parameter o-hn         as handle    no-undo.
      686     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      687   end.
      688   procedure gen-row-keyr :
      689     define input  parameter p-key-rec    as character no-undo.
      690     define input  parameter p-key-handle as handle    no-undo .
      691     define input  parameter p-db-name    as character no-undo .
      692     define input  parameter p-tt-handle  as handle    no-undo .
      693     define input  parameter p-stts-lock  as integer   no-undo .
      694     define output parameter p-tbl-row    as rowid     no-undo.
      695     define output parameter p-tbl-name   as character no-undo.
      696     define variable vHn as handle no-undo.
      697       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      698       p-tbl-row = if vHn:available then vHn:rowid else ?.
      699       p-tbl-name =  vHn:table.
      700       delete object vHn no-error.
      701     if p-tbl-row = ? then do:
      702       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info2, p-tbl-name, p-key-rec ).
      703     end.
      704     else do:
      705       return.
      706     end.
      707   end procedure.
      708   procedure gen-key-fv :
      709     define input  parameter p-key-rec    as character no-undo .
      710     define output parameter p-field-list as character no-undo .
      711     define output parameter p-value-list as character no-undo.
      712     do
      713     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      714     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      715     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      716     :
      717       define variable v-full-tbl-name  as character no-undo .
      718       define variable bh_tbl-name      as handle    no-undo .
      719       define variable v-tbl-name       as character no-undo .
      720       define variable v-field-num      as integer   no-undo .
      721       define variable v-count-fld      as integer   no-undo .
      722       define variable v-inform         as character no-undo .
      723       define variable v-ind            as integer   no-undo .
      724       define variable v-idx-field-qnty as integer   no-undo .
      725       define variable v-delim-key      as character no-undo .
      726       if p-key-rec = ?
      727         or p-key-rec = "":U
      728       then do:
      729         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      730       end.
      731       assign
      732         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      733         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      734       .
      735       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      736       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info2 ).
      737       assign
      738         v-inform = bh_tbl-name:index-information(1)
      739         v-ind    = 2
      740       .
      741       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      742       on error undo, return error
      743       :
      744         assign
      745           v-inform = bh_tbl-name:index-information( v-ind )
      746           v-ind    = v-ind + 1
      747         .
      748       end.
      749       if v-inform = ?
      750         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      751         or entry( 3, v-inform, ",":U ) <> "1":U
      752       then do:
      753         delete object bh_tbl-name no-error.
      754         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      755       end.
      756       assign
      757         v-idx-field-qnty = num-entries( v-inform ) - 4
      758       .
      759       if v-idx-field-qnty < 2 then do:
      760         delete object bh_tbl-name no-error.
      761         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      762       end.
      763       assign
      764         p-field-list = "":U
      765         p-value-list = "":U
      766         v-delim-key  = "":U
      767         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      768         v-count-fld  = 0
      769       .
      770       block_where:
      771       do v-ind = 1 to v-idx-field-qnty by 2
      772       on error undo, return error
      773       :
      774         assign
      775           v-count-fld = v-count-fld + 1
      776         .
      777         if v-count-fld > v-field-num then do:
      778           leave block_where.
      779         end.
      780         assign
      781           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      782           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      783         .
      784         if v-ind = 1 then do:
      785           assign
      786             v-delim-key = chr(3)
      787           .
      788         end.
      789       end.
      790       delete object bh_tbl-name.
      791       if v-count-fld <> v-field-num then do:
      792         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info2, v-tbl-name ).
      793       end.
      794     end.
      795   end procedure.
      796   procedure gen-key-field :
      797     define input  parameter p-table      as character no-undo .
      798     define output parameter p-field-list as character no-undo .
      799     do
      800     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      801     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      802     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      803     :
      804       define variable v-full-tbl-name  as character no-undo .
      805       define variable bh_tbl-name      as handle    no-undo .
      806       define variable v-tbl-name       as character no-undo .
      807       define variable v-field-num      as integer   no-undo .
      808       define variable v-count-fld      as integer   no-undo .
      809       define variable v-inform         as character no-undo .
      810       define variable v-ind            as integer   no-undo .
      811       define variable v-idx-field-qnty as integer   no-undo .
      812       define variable v-delim-key      as character no-undo .
      813       if p-table = ?
      814         or p-table = "":U
      815       then do:
      816         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info2 ).
      817       end.
      818       assign
      819         v-tbl-name      = p-table
      820         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      821       .
      822       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      823       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info2 ).
      824       assign
      825         v-inform = bh_tbl-name:index-information(1)
      826         v-ind    = 2
      827       .
      828       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      829       on error undo, return error
      830       :
      831         assign
      832           v-inform = bh_tbl-name:index-information( v-ind )
      833           v-ind    = v-ind + 1
      834         .
      835       end.
      836       if v-inform = ?
      837         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      838         or entry( 3, v-inform, ",":U ) <> "1":U
      839       then do:
      840         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      841       end.
      842       assign
      843         v-idx-field-qnty = num-entries( v-inform ) - 4
      844       .
      845       if v-idx-field-qnty < 2 then do:
      846         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info2, v-inform, v-tbl-name ).
      847       end.
      848       assign
      849         p-field-list = "":U
      850         v-delim-key  = "":U
      851         v-count-fld  = 0
      852       .
      853       block_where:
      854       do v-ind = 1 to v-idx-field-qnty by 2
      855       on error undo, return error
      856       :
      857         assign
      858           v-count-fld = v-count-fld + 1
      859         .
      860         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      861         if v-ind = 1 then do:
      862           assign
      863             v-delim-key = chr(3)
      864           .
      865         end.
      866       end.
      867       delete object bh_tbl-name.
      868     end.
      869   end procedure.
      870   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      871   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      872   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      873   FUNCTION get-region RETURNS CHARACTER
      874     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      875     define variable par-region as character no-undo.
      876     if parhost-code = 0 and
      877          parobj-type = "":U and
      878          parobj-code = 0 then do:
      879          par-region = "Глобально".
      880          return par-region.
      881       end.
      882       if parobj-type = 'орг':U then do:
      883          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      884          return par-region.
      885       end.
      886       if parobj-type = 'регион':U
      887       then do:
      888          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      889          return par-region.
      890       end.
      891       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      892       return par-region.
      893   END FUNCTION.
      894   FUNCTION get-objregion RETURNS CHARACTER
      895     (  input parobj-type as character, input parobj-code as integer ) :
      896     define variable par-region as character no-undo.
      897     if  parobj-type = "":U and
      898         parobj-code = 0
      899     then do:
      900        par-region = "Глобально".
      901     end.
      902     else if parobj-type = 'орг':U
      903     then do:
      904        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      905     end.
      906     else if parobj-type = 'регион':U
      907     then do:
      908        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      909     end.
      910     else
      911        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      912     return par-region.
      913   END FUNCTION.
      914   FUNCTION calldscr returns character ( input p-call-id as character):
      915   define variable v-descr as character no-undo .
      916   define variable v-field-list as character no-undo .
      917   define variable v-value-list as character no-undo.
      918   define variable v-prop-label as character no-undo .
      919   define variable v-node-label as character no-undo .
      920   define variable v-dt-code as integer no-undo .
      921   define variable v-host-code as integer no-undo .
      922   define variable v-obj-type as character no-undo .
      923   define variable v-obj-code as integer no-undo .
      924   define variable v-label as character no-undo .
      925   define variable v-node-code as integer no-undo .
      926   define buffer buf_prop-head for ub.prop-head.
      927   define buffer buf_prop-ref for ub.prop-ref.
      928   define buffer buf_prop-map for ub.prop-map.
      929   run gen-key-fv in this-procedure ( input p-call-id
      930                                     ,output v-field-list
      931                                     ,output v-value-list) no-error .
      932   if error-status:error then return p-call-id.
      933   CASE entry(1, p-call-id, chr(3)):
      934     when 'dis-card-type':U then do:
      935       v-descr = substitute("Тип ДК: эмитент &1 тип: &2"
      936                            ,integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)) )
      937                            ,entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
      938                            ).
      939     end.
      940     when 'dis-card':U then do:
      941       v-descr = substitute("ДК: № &1"
      942                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
      943                            ).
      944     end.
      945     when 'dis-card-property':U then do:
      946       v-dt-code = integer(entry(lookup("dt-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      947       v-node-code = integer(entry(lookup("node-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      948       v-host-code = integer(entry(lookup("host-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      949       v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3)) .
      950       v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
      951       find first buf_prop-ref no-lock where
      952                 buf_prop-ref.dt-code = v-dt-code no-error .
      953       if available buf_prop-ref then do:
      954         find first buf_prop-head no-lock where
      955                   buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error .
      956         v-prop-label = buf_prop-head.prop-label.
      957         find first buf_prop-map no-lock where
      958                   buf_prop-map.dtm-code = buf_prop-ref.dtm-code
      959               and buf_prop-map.node-code = v-node-code no-error .
      960         if available buf_prop-map then do:
      961           v-label = buf_prop-map.node-label.
      962         end.
      963       end.
      964       v-descr = substitute("ДК: № &1 &2:&3 &4"
      965                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
      966                            ,v-prop-label
      967                            ,v-label
      968                            ,get-region(v-host-code, v-obj-type, v-obj-code)
      969                            ).
      970     end.
      971     when 'clients':U then do:
      972       v-descr = substitute("&1&2"
      973                            ,entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
      974                            ,integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
      975                            ).
      976     end.
      977     when 'ext-system':U then do:
      978       v-descr = substitute("Внешняя система &1"
      979                            ,integer(entry(lookup("esys-id", v-field-list, chr(3)), v-value-list, chr(3)))
      980                            ).
      981     end.
      982     WHEN 'thbj-attr':U then do:
      983       if entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum':U
      984       or entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum_obj':U
      985       then do:
      986         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'goods':U then do:
      987           v-descr = "Операции с товарами".
      988         end.
      989         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'clients':U then do:
      990           v-descr = "Операции с клиентами".
      991         end.
      992         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'gds-grp':U then do:
      993           v-descr = "Операции с группами товаров".
      994         end.
      995         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'cli-grp':U then do:
      996           v-descr = "Операции с группами клиентов".
      997         end.
      998         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th':U then do:
      999           v-descr = "Операции с чеками на POS IBS-TH".
     1000         end.
     1001         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th-mob':U then do:
     1002           v-descr = "Операции с чеками на POS IBS-TH-MOB".
     1003         end.
     1004         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'edoc':U then do:
     1005           v-descr = "Операции в системе электронного документооборота".
     1006         end.
     1007         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'thref':U then do:
     1008           v-descr = "Операции со справочниками".
     1009         end.
     1010         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'pdf':U then do:
     1011           v-descr = "Операции с ДНЦ и переоценками".
     1012         end.
     1013         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rep':U then do:
     1014           v-descr = "Отчеты".
     1015         end.
     1016         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'ord':U then do:
     1017           v-descr = "Операции с заказами".
     1018         end.
     1019       end.
     1020     end.
     1021     when 'cash-desk':U then do:
     1022       v-descr = substitute("БД &1 Маг &2 Касса № &4 &3"
     1023                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1024                            ,entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3))
     1025                            ,entry(lookup("cash-num", v-field-list, chr(3)), v-value-list, chr(3))
     1026                            ,entry(lookup("pos-type", v-field-list, chr(3)), v-value-list, chr(3))
     1027                            ).
     1028     end.
     1029     when 'ext-file':U then do:
     1030       v-descr = substitute("БД &1 Файл № &3 (из БД &2)"
     1031                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1032                            ,entry(lookup("from-db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1033                            ,entry(lookup("file-num", v-field-list, chr(3)), v-value-list, chr(3))
     1034                            ).
     1035     end.
     1036   end case.
     1037   return v-descr.
     1038   end function.
     1039   define variable dops0 as character no-undo format "X(8)".
     1040   define variable dops as character no-undo format "X(250)".
     1041   define variable dopst as character no-undo format "X(1)".
     1042   define variable dopsp as character no-undo format "X(10)".
     1043   define variable v-is-dc as character no-undo .
     1044   define variable v-conf-type as character no-undo .
     1045   define variable v-run as logical no-undo .
     1046   define buffer buf_stop-list for ub.stop-list.
     1047   define variable p-mode as character no-undo .
     1048   define variable p-stop-list-code as character no-undo .
     1049   DEFINE BUTTON b-exit AUTO-GO
     1050        LABEL "&Ввод"
     1051        SIZE 10 BY 1
     1052        BGCOLOR 8 .
     1053   DEFINE BUTTON B-file
     1054        IMAGE-UP FILE "btn-down-arrow":U
     1055        IMAGE-DOWN FILE "btn-down-arrow":U
     1056        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1057        LABEL ""
     1058        SIZE 3 BY 1.
     1059   DEFINE BUTTON B-help
     1060        LABEL "Помо&щь"
     1061        SIZE 3 BY 1
     1062        BGCOLOR 8 .
     1063   DEFINE BUTTON b-param
     1064        LABEL "&Параметры"
     1065        SIZE 10 BY 1.
     1066   DEFINE BUTTON B-profile
     1067        IMAGE-UP FILE "btn-down-arrow":U
     1068        IMAGE-DOWN FILE "btn-down-arrow":U
     1069        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1070        LABEL ""
     1071        SIZE 3 BY 1.
     1072   DEFINE BUTTON B-quit AUTO-END-KEY
     1073        LABEL "&Отмена"
     1074        SIZE 10 BY 1
     1075        BGCOLOR 8 .
     1076   DEFINE BUTTON B-type
     1077        IMAGE-UP FILE "btn-down-arrow":U
     1078        IMAGE-DOWN FILE "btn-down-arrow":U
     1079        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1080        LABEL ""
     1081        SIZE 3 BY 1.
     1082   DEFINE VARIABLE emitent-name AS CHARACTER FORMAT "X(256)":U
     1083         VIEW-AS TEXT
     1084        SIZE 42 BY .67 NO-UNDO.
     1085   DEFINE VARIABLE f-stop-list-code AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
     1086        LABEL "№ стоплиста"
     1087        VIEW-AS FILL-IN
     1088        SIZE 10 BY 1 NO-UNDO.
     1089   DEFINE VARIABLE file-name AS CHARACTER FORMAT "X(256)":U
     1090        LABEL "Файл импорта"
     1091        VIEW-AS FILL-IN
     1092        SIZE 78.5 BY 1 NO-UNDO.
     1093   DEFINE VARIABLE T-tocd AS LOGICAL INITIAL no
     1094        LABEL "Отправить на кассу по окончании импорта"
     1095        VIEW-AS TOGGLE-BOX
     1096        SIZE 46.5 BY 1 NO-UNDO.
     1097   DEFINE QUERY Dialog-Frame FOR
     1098         X_rule-profile,
     1099         X_dis-card-type SCROLLING.
     1100   DEFINE FRAME Dialog-Frame
     1101        b-exit AT ROW 1 COL 1
     1102        B-quit AT ROW 1 COL 11
     1103        B-help AT ROW 1 COL 95
     1104        X_rule-profile.name AT ROW 2 COL 14 COLON-ALIGNED WIDGET-ID 10
     1105             LABEL "Профайл"
     1106             VIEW-AS FILL-IN
     1107             SIZE 79 BY 1
     1108        B-profile AT ROW 2 COL 95 WIDGET-ID 12
     1109        ub.X_rule.name AT ROW 3 COL 16 NO-LABEL WIDGET-ID 18
     1110             VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1111             SIZE 79.5 BY 2
     1112        B-type AT ROW 5 COL 24 WIDGET-ID 24
     1113        b-param AT ROW 5 COL 88 WIDGET-ID 14
     1114        file-name AT ROW 6 COL 2
     1115        B-file AT ROW 6 COL 95
     1116        f-stop-list-code AT ROW 7.4 COL 14 COLON-ALIGNED WIDGET-ID 22
     1117        T-tocd AT ROW 8.47 COL 17
     1118        X_dis-card-type.type AT ROW 5 COL 7 COLON-ALIGNED WIDGET-ID 30
     1119             LABEL "Тип ДК"
     1120              VIEW-AS TEXT
     1121             SIZE 14.8 BY .67
     1122        X_dis-card-type.emitent-host-code AT ROW 5 COL 34 COLON-ALIGNED WIDGET-ID 26
     1123             LABEL "Эмитент"
     1124              VIEW-AS TEXT
     1125             SIZE 6 BY .67
     1126        emitent-name AT ROW 5 COL 41 COLON-ALIGNED NO-LABEL WIDGET-ID 28
     1127        "Правило:" VIEW-AS TEXT
     1128             SIZE 8.5 BY 1 AT ROW 3 COL 7 WIDGET-ID 20
     1129        SPACE(84.29) SKIP(6.46)
     1130       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1131            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1132            TITLE "Импорт стоплистов ДК"
     1133            DEFAULT-BUTTON b-exit CANCEL-BUTTON B-quit.
     1134   ASSIGN
     1135          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1136          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1137   ASSIGN
     1138          X_rule.name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1139   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1140   DO:
     1141     APPLY "END-ERROR":U TO SELF.
     1142   END.
     1143   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     1144   DO:
     1145     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
     1146     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1147     v-run = yes.
     1148   END.
     1149   ON CHOOSE OF B-file IN FRAME Dialog-Frame
     1150   DO:
     1151   define variable v_os-file   AS CHAR NO-UNDO INIT "".
     1152   define variable ll_commit AS LOG    NO-UNDO INIT NO.
     1153   define variable v-full-path        as character no-undo .
     1154   define variable v-path             as character no-undo .
     1155   define variable v-file-name        as character no-undo .
     1156   define variable v-file-name-no-ext as character no-undo .
     1157   define variable v-file-name-ext    as character no-undo .
     1158       SYSTEM-DIALOG GET-FILE v_os-file
     1159           TITLE "Выберите файл для импорта"
     1160           FILTERS
     1161             " Все текстовые файлы (*.txt) " "*.txt",
     1162             " Все файлы Excel (*.xls) " "*.xls",
     1163             " Все файлы (*.*) "                      "*.*"
     1164           INITIAL-FILTER 1
     1165           DEFAULT-EXTENSION ".txt"
     1166           USE-FILENAME
     1167           MUST-EXIST
     1168           UPDATE ll_commit
     1169           .
     1170       IF ll_commit <> YES THEN do:
     1171          RETURN NO-APPLY.
     1172       end.
     1173       IF v_os-file = PROGRAM-NAME( 1 ) THEN DO:
     1174           BELL.
     1175           MESSAGE "Рекурсия!" VIEW-AS ALERT-BOX ERROR.
     1176           RETURN NO-APPLY.
     1177       END.
     1178       ASSIGN file-name = ( IF SEARCH( v_os-file ) = ? THEN v_os-file ELSE SEARCH( v_os-file ) ).
     1179       run gbl/filename.p (
     1180                       input  v_os-file
     1181                       ,output v-full-path
     1182                       ,output v-path
     1183                       ,output v-file-name
     1184                       ,output v-file-name-no-ext
     1185                       ,output v-file-name-ext
     1186                       ) no-error .
     1187       if error-status:error  = ? then do:
     1188         return no-apply.
     1189       end.
     1190       assign
     1191       file-name = v-full-path.
     1192       DISP file-name WITH FRAME Dialog-Frame.
     1193   END.
     1194   ON CHOOSE OF b-param IN FRAME Dialog-Frame
     1195   DO:
     1196       RUN proc-b-param IN THIS-PROCEDURE NO-ERROR.
     1197       IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1198   END.
     1199   ON CHOOSE OF B-profile IN FRAME Dialog-Frame
     1200   DO:
     1201   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1202   IF AVAILABLE X_rule-by-profile THEN DO:
     1203      ASSIGN
     1204      v-rid-list = STRING(RECID(X_rule-by-profile)).
     1205   END.
     1206    run rul/rule-by-profile-s.w ( INPUT parparentproc
     1207                                 ,INPUT "b-sel":u
     1208                                 ,INPUT "ruleset"
     1209                                 ,INPUT 0
     1210                                 ,INPUT 6
     1211                                 ,INPUT 1
     1212                                 ,INPUT 0
     1213                                 ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     1214   if v-rid-list = '':U then RETURN NO-APPLY.
     1215   find first X_rule-by-profile no-lock where
     1216             recid(X_rule-by-profile) = integer(v-rid-list).
     1217   FIND FIRST X_rule-profile NO-LOCK WHERE
     1218           X_rule-profile.profile_id = X_rule-by-profile.profile_id.
     1219   FIND FIRST X_rule NO-LOCK WHERE
     1220           X_rule.rule_id = X_rule-by-profile.rule_id.
     1221   DISPLAY
     1222   X_rule-profile.NAME
     1223   X_rule.NAME
     1224   WITH FRAME Dialog-Frame.
     1225   ENABLE
     1226   b-param
     1227   b-type
     1228   WITH FRAME Dialog-Frame.
     1229   END.
     1230   ON CHOOSE OF B-type IN FRAME Dialog-Frame
     1231   DO:
     1232    run proc-b-type in this-procedure no-error.
     1233    if error-status:error then return no-apply.
     1234   END.
     1235   ON LEAVE OF file-name IN FRAME Dialog-Frame
     1236   DO:
     1237       ASSIGN file-name.
     1238       IF SEARCH( file-name ) <> ? AND SEARCH( file-name ) <> "":U THEN DO:
     1239           ASSIGN FILE-INFO:FILE-NAME = file-name.
     1240           IF FILE-INFO:FULL-PATHNAME <> ? THEN ASSIGN file-name = FILE-INFO:FULL-PATHNAME.
     1241           DISP file-name WITH FRAME Dialog-Frame.
     1242       END.
     1243       APPLY "TAB":U TO file-name IN FRAME Dialog-Frame.
     1244   END.
     1245   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1246   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1247   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1248   on help of frame Dialog-Frame
     1249   do:
     1250     run gbl/app_help.p
     1251       (input this-procedure :file-name
     1252       ,input ''
     1253       ,input ?
     1254       ) no-error.
     1255     if error-status :error then do:
     1256       message
     1257         "Ошибка при вызове помощи"
     1258         error-status :get-message(1)
     1259         view-as alert-box .
     1260     end.
     1261   end.
     1262   run minbtn-set in this-procedure .
     1263   on choose of b-help in frame Dialog-Frame
     1264   do:
     1265     apply "help":u to frame Dialog-Frame .
     1266   end.
     1267   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1268   procedure minbtn-set :
     1269       do
     1270           on error undo, return error return-value
     1271           :
     1272           define variable ii              as integer       no-undo .
     1273           define variable fh              as widget-handle no-undo .
     1274           define variable hh              as widget-handle no-undo .
     1275           define variable v-h             as handle        extent 4 no-undo .
     1276           define variable v-name-button   as character     no-undo .
     1277           define variable v-help-old-x    as decimal       no-undo .
     1278           define variable v-help-old-y    as decimal       no-undo .
     1279           define variable v-help-old-size as decimal       no-undo .
     1280           define variable v-frame-width   as decimal       no-undo .
     1281           define variable jj              as integer       no-undo .
     1282           do
     1283               on error undo, return error
     1284               :
     1285               assign
     1286                   v-frame-width = frame Dialog-Frame:width - 0.3
     1287                   fh            = frame Dialog-Frame:first-child
     1288                   hh            = fh:first-child
     1289                   ii            = 1
     1290                   .
     1291               do while valid-handle(hh):
     1292                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1293                   do:
     1294                       case lc(hh:name) :
     1295                           when "b-help" then
     1296                               do:
     1297                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1298                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1299                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1300                                   hh:TOOLTIP = "Помощь" .
     1301                                   v-help-old-x = hh:column .
     1302                                   v-help-old-y = hh:row    .
     1303                                   v-help-old-size = hh:width .
     1304                                   hh:width-chars = 2.5 .
     1305                               end.
     1306                           when "b-print" then
     1307                               do:
     1308                                   hh:load-image("cmp/b-print.bmp":u) .
     1309                                   hh:TOOLTIP = "Печать" .
     1310                                   v-h[ii] = hh:handle .
     1311                                   ii = ii + 1 .
     1312                                   hh:width-chars = 3 .
     1313                               end.
     1314                           when "b-history" or
     1315                           when "b-hist" then
     1316                               do:
     1317                                   hh:load-image("cmp/b-hist.bmp":u) .
     1318                                   hh:TOOLTIP = "История" .
     1319                                   v-h[ii] = hh:handle .
     1320                                   ii = ii + 1 .
     1321                                   hh:width-chars = 3 .
     1322                               end.
     1323                           when "b-sch" then
     1324                               do:
     1325                                   hh:load-image("cmp/b-sch.bmp":u) .
     1326                                   hh:TOOLTIP = "Установка Фильтра" .
     1327                                   v-h[ii] = hh:handle .
     1328                                   ii = ii + 1 .
     1329                                   hh:width-chars = 3 .
     1330                               end.
     1331                           when "b-hist-user" then
     1332                               do:
     1333                                   hh:load-image("cmp/b-hist.bmp":u) .
     1334                                   hh:TOOLTIP = "История пользователя" .
     1335                                   ii = ii + 1 .
     1336                               end.
     1337                       end case.
     1338                   end.
     1339                   hh = hh:next-sibling.
     1340               end.
     1341               b-help:column = v-frame-width - b-help:width-chars.
     1342               jj = 0.
     1343               repeat ii = 4 to 1 by -1 :
     1344                   if valid-handle (v-h[ii] ) then
     1345                   do:
     1346                       jj  = jj + 1 .
     1347                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1348                       v-h[ii]:row    = v-help-old-y .
     1349                   end.
     1350               end.
     1351           end.
     1352       end.
     1353   end procedure.
     1354   MAIN-BLOCK:
     1355   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1356      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1357   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1358     run mainmenu_getcntxt in parparentproc
     1359       (output v-cntxt-db-num
     1360       ,output v-cntxt-userid
     1361       ,output v-cntxt-level
     1362       ,output v-cntxt-host-code-obj
     1363       ,output v-cntxt-obj-type
     1364       ,output v-cntxt-obj-code
     1365       ,output v-cntxt-db-num-obj
     1366       ,output v-cntxt-is-admin
     1367       ) .
     1368   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1369     (input  'is-dc'
     1370     ,input  0
     1371     ,input  '':U
     1372     ,input  0
     1373     ,input  '':U
     1374     ,input  '':U
     1375     ,input  '':U
     1376     ,input  NO
     1377     ,output v-is-dc
     1378     ,output v-conf-type
     1379     ) NO-ERROR .
     1380       IF ERROR-STATUS:ERROR OR
     1381         v-conf-type <> 'L':U THEN
     1382         v-is-dc = "no".
     1383       if logical(v-is-dc) = no then do:
     1384         message
     1385         "В Вашей системе недоступна функциональность работы с дисконтными картами"
     1386         view-as alert-box WARNING.
     1387         undo main-block, return error .
     1388       end.
     1389    if v-cntxt-db-num > 0 then do:
     1390       message
     1391       "Запрещен импорт стоплистов в УБД"
     1392       view-as alert-box error .
     1393       undo, return error .
     1394     end.
     1395     assign
     1396     p-mode = entry(1, p-parameter, chr(4) )
     1397     p-stop-list-code = entry(2, p-parameter, chr(4) )
     1398     .
     1399     if p-mode <> 'ДОБАВЛЕНИЕ':U
     1400     and p-mode <> 'ИЗМЕНЕНИЕ':U then do:
     1401       message
     1402       substitute("Неверное значение параметра p-mode=&1", p-mode)
     1403       view-as alert-box error .
     1404       undo, return error .
     1405     end.
     1406     if p-stop-list-code <> '':U then do:
     1407       find first buf_stop-list exclusive-lock where
     1408                 buf_stop-list.classif-type = 'dis-card':U
     1409             and buf_stop-list.stop-list-code = p-stop-list-code
     1410              no-error .
     1411       if not available buf_stop-list then do:
     1412         message
     1413         vss-workfile vss-revision vss-description skip
     1414         "Неверное значение параметра p-stop-list-code" p-stop-list-code
     1415         view-as alert-box error .
     1416         undo, return error .
     1417       end.
     1418       if buf_stop-list.status_ = 'факт':U then do:
     1419         message
     1420         substitute("Стоплист &1 закрыт до статуса &2"
     1421                     , p-stop-list-code
     1422                     , buf_stop-list.status_
     1423                     )
     1424         view-as alert-box error .
     1425         undo, return error .
     1426       end.
     1427     end.
     1428     ELSE DO:
     1429         find last buf_stop-list no-lock where
     1430                   buf_stop-list.classif-type = 'dis-card':U no-error .
     1431         if not available buf_stop-list then do:
     1432         end.
     1433         ELSE DO:
     1434            if buf_stop-list.status_ <> 'факт':U then do:
     1435              message
     1436              substitute("Предыдущий стоплист &1 не закрыт до статуса &2&3Добавление невозможно"
     1437                         ,buf_stop-list.stop-list-code
     1438                         ,'факт':U
     1439                         ,chr(10))
     1440              view-as alert-box error .
     1441              undo, return error .
     1442            end.
     1443            run ref/stop-l1.p ( input no
     1444                               ,output p-stop-list-code) no-error.
     1445            if error-status:error then do:
     1446            end.
     1447         END.
     1448     END.
     1449     run Myenable in this-procedure .
     1450     WAIT-FOR GO OF FRAME Dialog-Frame.
     1451   END.
     1452   run disable_UI in this-procedure .
     1453   if v-run then do:
     1454     ASSIGN FRAME Dialog-Frame
     1455     f-stop-list-code
     1456     t-tocd
     1457     file-name
     1458     .
     1459     run str/saledc.p
     1460       (
     1461        input parparentproc
     1462       ,input this-procedure :handle
     1463       ,input p-log-handle
     1464       ,input ('stop-list-import':U + chr(4) +  p-mode)
     1465       ,input X_dis-card-type.emitent-host-code
     1466       ,input X_dis-card-type.TYPE
     1467       ,input X_rule-by-profile.profile_id
     1468       ,input 0
     1469       ,input 0
     1470       ,input v-cntxt-db-num
     1471       ,input (string(f-stop-list-code, "999999999") + chr(4) +
     1472                     file-name
     1473               )
     1474       ,input (if p-mode = 'ИЗМЕНЕНИЕ':U
     1475               then buf_stop-list.doc-date
     1476               else ?)
     1477       ,input ?
     1478       ,input ?
     1479       ,input 1
     1480       ,input 1
     1481       ,input yes
     1482       ) no-error .
     1483     if error-status:error then do:
     1484       undo, return error return-value .
     1485     end.
     1486     if t-tocd
     1487     then do:
     1488       find first buf_stop-list no-lock where
     1489                 buf_stop-list.classif-type = 'dis-card':U
     1490               and buf_stop-list.stop-list-code = string(f-stop-list-code, "999999999").
     1491       if buf_stop-list.status_ = 'факт':U then do:
     1492         run str/diallog.w (
     1493                       input parparentproc
     1494                       ,input this-procedure
     1495                       ,input 'str/snd-stpl.p':U
     1496                       ,input f-stop-list-code
     1497                       ,input yes
     1498                       ,input '':U
     1499                       ,input 'Отправка информации по стоплистам на кассы') no-error .
     1500       end.
     1501     end.
     1502   end.
     1503   PROCEDURE disable_UI :
     1504     HIDE FRAME Dialog-Frame.
     1505   END PROCEDURE.
     1506   PROCEDURE enable_UI :
     1507     OPEN QUERY Dialog-Frame FOR EACH X_rule-profile SHARE-LOCK,       EACH X_dis-card-type WHERE TRUE  SHARE-LOCK.
     1508     GET FIRST Dialog-Frame.
     1509     DISPLAY file-name f-stop-list-code T-tocd emitent-name
     1510         WITH FRAME Dialog-Frame.
     1511     IF AVAILABLE X_dis-card-type THEN
     1512       DISPLAY X_dis-card-type.type X_dis-card-type.emitent-host-code
     1513         WITH FRAME Dialog-Frame.
     1514     IF AVAILABLE X_rule THEN
     1515       DISPLAY X_rule.name
     1516         WITH FRAME Dialog-Frame.
     1517     IF AVAILABLE X_rule-profile THEN
     1518       DISPLAY X_rule-profile.name
     1519         WITH FRAME Dialog-Frame.
     1520     ENABLE b-exit B-quit B-help X_rule-profile.name B-profile X_rule.name B-type
     1521            b-param file-name B-file f-stop-list-code T-tocd X_dis-card-type.type
     1522            X_dis-card-type.emitent-host-code emitent-name
     1523         WITH FRAME Dialog-Frame.
     1524     VIEW FRAME Dialog-Frame.
     1525   END PROCEDURE.
     1526   PROCEDURE MyEnable :
     1527   define buffer buf_clients for ub.clients.
     1528   find first buf_clients no-lock where
     1529              buf_clients.obj-type = 'маг':U
     1530         and  buf_clients.db-num = 0
     1531         and buf_clients.stts = integer('0':U) no-error.
     1532   assign
     1533   f-stop-list-code = integer(p-stop-list-code).
     1534   .
     1535   DISPLAY
     1536   file-name
     1537   T-tocd
     1538   f-stop-list-code
     1539   WITH FRAME Dialog-Frame .
     1540   ENABLE
     1541   b-exit
     1542   B-quit
     1543   B-help
     1544   file-name
     1545   B-file
     1546   b-profile
     1547   f-stop-list-code  when p-stop-list-code = '':U
     1548   T-tocd when (available buf_clients)
     1549   WITH FRAME Dialog-Frame .
     1550   VIEW FRAME Dialog-Frame .
     1551   END PROCEDURE.
     1552   PROCEDURE proc-b-param :
     1553   if not available X_rule-by-profile then do:
     1554     message
     1555     "Сначала необходимо определить правило для импорта"
     1556     view-as alert-box error .
     1557     return error.
     1558   end.
     1559   define variable v-param-form as character no-undo .
     1560   define variable v-list-mode as character no-undo .
     1561   define buffer buf_rule-profile for ub.rule-profile.
     1562   find first buf_rule-profile no-lock where
     1563             buf_rule-profile.profile_id = X_rp-by-call.profile_id.
     1564   assign
     1565   v-param-form = (if buf_rule-profile.custom-param-form > 0
     1566                   then  substitute("rul/rcps-&1.w", buf_rule-profile.profile_id)
     1567                   else "ref/rulercps.w")
     1568   v-list-mode = (if buf_rule-profile.custom-param-form > 0
     1569                  then 'rp-rule-param':U
     1570                  else 'rule-call-param':U)
     1571   .
     1572   run value(v-param-form) (
     1573                        input parparentproc
     1574                       ,input this-procedure:handle
     1575                       ,input "b-chg":U
     1576                       ,input 'ИЗМЕНЕНИЕ':U
     1577                       ,input v-list-mode
     1578                       ,input 0
     1579                       ,input ?
     1580                       ,input X_rp-by-call.call_id
     1581                       ,input X_rule-by-profile.codex_id
     1582                       ,input X_rule-by-profile.ruleset_id
     1583                       ,input ?
     1584                       ,input X_rule-by-profile.RULE_id
     1585                       ,INput substitute("Правило &1 &2"
     1586                                         , X_rule-by-profile.RULE_id, calldscr(X_rp-by-call.call_id))
     1587                       ,input-output table tt0-rule-call-param  ) no-error.
     1588   END PROCEDURE.
     1589   PROCEDURE proc-b-type :
     1590   define variable v-rid-list as character no-undo.
     1591   DEFINE VARIABLE v-today as date no-undo .
     1592   DEFINE VARIABLE v-time as integer no-undo .
     1593   define buffer buf_clients for ub.clients.
     1594   DEFINE BUFFER buf_rp-by-call FOR ub.rp-by-call.
     1595   DEFINE BUFFER buf_dis-card-type FOR ub.dis-card-type.
     1596   define buffer buf_rule for ub.rule.
     1597   define buffer buf_ruledict for ub.ruledict.
     1598   define buffer buf_rule-call-param for ub.rule-call-param.
     1599   define buffer buf_ruledict-param for ub.ruledict-param.
     1600   define buffer buf_tt0-rule-call-param for tt0-rule-call-param.
     1601   IF NOT AVAILABLE X_rule-by-profile THEN DO:
     1602     MESSAGE
     1603     "Сначала необходимо определить правило импорта"
     1604     VIEW-AS ALERT-BOX.
     1605     disable b-param
     1606     with frame Dialog-Frame .
     1607     RETURN ERROR.
     1608   END.
     1609   IF AVAILABLE X_rp-by-call THEN DO:
     1610      ASSIGN
     1611      v-rid-list = STRING(RECID(X_rp-by-call)).
     1612   END.
     1613   run rul/rp-by-call-s.w ( INPUT parparentproc
     1614                           ,INPUT "b-sel":U
     1615                           ,INPUT "profile-id"
     1616                           ,INPUT X_rule-by-profile.profile_id
     1617                           ,INPUT '':U
     1618                           ,input ''
     1619                           ,input 0
     1620                           ,input 0
     1621                           ,INPUT-OUTPUT v-rid-list
     1622                           ) NO-ERROR.
     1623   if v-rid-list = "" then return error.
     1624   find first buf_rp-by-call no-lock where
     1625             recid(buf_rp-by-call) = integer(v-rid-list) no-error.
     1626   if not available buf_rp-by-call then do:
     1627     message
     1628     substitute("Не найдена привязка правила rp-by-call с recid &1" , v-rid-list)
     1629     view-as alert-box error .
     1630     return.
     1631   end.
     1632   FIND FIRST X_rp-by-call WHERE RECID(X_rp-by-call) = RECID(buf_rp-by-call).
     1633   FIND FIRST X_dis-card-type WHERE
     1634           X_dis-card-type.uniq-key-rec = buf_rp-by-call.call_id.
     1635   display
     1636   X_dis-card-type.type
     1637   X_dis-card-type.emitent-host-code
     1638   with frame Dialog-Frame.
     1639   FOR EACH buf_tt0-rule-call-param:
     1640      DELETE buf_tt0-rule-call-param.
     1641   END.
     1642   find X_rule-by-call where
     1643       X_rule-by-call.call#_id = X_rp-by-call.call#_id
     1644     and X_rule-by-call.rule_id = X_rule-by-profile.rule_id
     1645     and X_rule-by-call.profile_id = X_rule-by-profile.profile_id no-error .
     1646   if ambiguous X_rule-by-call then do:
     1647     message
     1648     "Выберите какой вызов правила Вас необходим"
     1649     view-as alert-box .
     1650     run rul/rule-by-call-s.w ( input parparentproc
     1651                               ,input "b-sel"
     1652                               ,input "call_id"
     1653                               ,input X_rp-by-call.call_id
     1654                               ,input X_rule-by-profile.codex_id
     1655                               ,input X_rule-by-profile.ruleset_id
     1656                               ,input X_rule-by-profile.rule_id
     1657                               ,input-output v-rid-list) no-error .
     1658     if v-rid-list = '':u then do:
     1659       UNDO, RETURN ERROR.
     1660     end.
     1661     find first X_rule-by-call no-lock where
     1662               recid(X_rule-by-call) = integer(v-rid-list) no-error .
     1663     if not available X_rule-by-call then do:
     1664       UNDO, RETURN ERROR.
     1665     end.
     1666   end.
     1667   for each buf_Rule-call-param no-lock where
     1668           buf_rule-call-param.call#_id = X_rp-by-call.call#_id
     1669       and  buf_rule-call-param.codex_id = X_rule-by-profile.codex_id
     1670       and  buf_rule-call-param.ruleset_id = X_rule-by-profile.ruleset_id
     1671       and  buf_rule-call-param.rule_id = X_rule-by-profile.rule_id:
     1672     create buf_tt0-rule-call-param.
     1673     buffer-copy buf_rule-call-param to buf_tt0-rule-call-param.
     1674   end.
     1675   RUN proc-b-param IN THIS-PROCEDURE NO-ERROR.
     1676   END PROCEDURE.
     1677   PROCEDURE proc-save :
     1678   define variable v-full-path        as character no-undo .
     1679   define variable v-path             as character no-undo .
     1680   define variable v-file-name        as character no-undo .
     1681   define variable v-file-name-no-ext as character no-undo .
     1682   define variable v-file-name-ext    as character no-undo .
     1683   if not available X_dis-card-type then do:
     1684     message
     1685     "Вы не выбрали тип ДК"
     1686     view-as alert-box error .
     1687     undo, return error .
     1688   end.
     1689   ASSIGN FRAME Dialog-Frame
     1690   file-name
     1691   t-tocd
     1692   .
     1693   if file-name = '':u
     1694   or file-name = ?
     1695   then do:
     1696     message
     1697     "Не выбран файл для импорта"
     1698     view-as alert-box error .
     1699     undo, return error .
     1700   end.
     1701   run gbl/filename.p (
     1702                    input  file-name
     1703                   ,output v-full-path
     1704                   ,output v-path
     1705                   ,output v-file-name
     1706                   ,output v-file-name-no-ext
     1707                   ,output v-file-name-ext
     1708                   ) no-error .
     1709   if error-status:error then do:
     1710     message
     1711     "Не найден файл, выбранный в качестве файла для импорта"
     1712     view-as alert-box error .
     1713     undo, return error .
     1714   end.
     1715   run rul/ruprcall.p ( input 'dis-card-type':U
     1716                       ,input X_dis-card-type.uniq-key-rec
     1717                       ,input 'rule-call-param':U
     1718                       ,input ?
     1719                       ,input 0
     1720                       ,INPUT TABLE tt0-rp-by-call
     1721                       ,INPUT TABLE tt0-rule-by-call
     1722                       ,INPUT TABLE tt0-rule-call-param) no-error .
     1723   if error-status:error then do:
     1724     message
     1725     "Ошибка при сохранении параметров правила импорта" skip
     1726     error-status:get-message(1) skip
     1727     return-value
     1728     view-as alert-box error .
     1729     undo, return error .
     1730   end.
     1731   END PROCEDURE.
