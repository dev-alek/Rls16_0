        1   block-level on error undo, throw.
        2   define input-output parameter p-doc-rec as recid no-undo.
        3   define input parameter p-mode            as character no-undo .
        4   define input parameter p-deliv-subj-code like ub.delivery-subject.deliv-subj-code no-undo .
        5   define input parameter p-deliv-subj-name like ub.delivery-subject.deliv-subj-name no-undo .
        6   define input parameter p-reg-code        like ub.delivery-subject.reg-code no-undo .
        7   define input parameter p-des like ub.delivery-subject.des no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: dlvsubj1.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: ref/dlvsubj1.p $":U .
       13   define variable vss-description as character no-undo init "Сохранение изменений в карточке субъекта доставки".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   define variable v-db-num like ub.db.db-num no-undo .
       84   define buffer buf_regions for ub.regions.
       85   if p-mode <> 'ДОБАВЛЕНИЕ':U
       86   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
       87     message
       88     vss-workfile vss-revision vss-description skip
       89     "Неверный параметр p-mode" p-mode
       90     view-as alert-box error .
       91     return error '':u.
       92   end.
       93   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       94   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
       95     (output v-db-num
       96     )  .
       97   if v-db-num <> 0 then do:
       98     run err-mess (substitute("Нельзя изменять запись СУБЪЕКТ ДОСТАВКИ в УБД: Номер текущей БД &1"
       99                   , v-db-num) ).
      100     undo, return error "":U.
      101   end.
      102   if p-deliv-subj-name = "":U then do:
      103     run err-mess in this-procedure ( input "Название СУБЪЕКТА ДОСТАВКИ не может быть пустым").
      104     return error "deliv-subj-name":U.
      105   end.
      106   if p-reg-code <> 0 then do:
      107     find first buf_regions no-lock where
      108               buf_regions.reg-code = p-reg-code no-error.
      109     if not available buf_regions then do:
      110       run err-mess in this-procedure (input substitute("Не найден регион с кодом &1", p-reg-code)).
      111       return error "deliv-subj-name":U.
      112     end.
      113   end.
      114   _MAIN:
      115   DO ON ERROR UNDO, RETURN ERROR
      116   ON STOP UNDO, RETURN ERROR:
      117     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      118       create ub.delivery-subject.
      119       assign
      120       ub.delivery-subject.deliv-subj-code = next-value(delivery, ub)
      121       p-doc-rec = recid(ub.delivery-subject)
      122       .
      123     end.
      124     else do:
      125       FIND FIRST ub.delivery-subject where
      126                 recid(ub.delivery-subject) = p-doc-rec No-ERROR.
      127       if not available ub.delivery-subject then do:
      128         message
      129         vss-workfile vss-revision vss-description skip
      130         "Не найдена запись СУБЪЕКТ ДОСТАВКИ - p-doc-rec" p-doc-rec
      131         view-as alert-box error .
      132         undo _main, return error '':u.
      133       end.
      134       if ub.delivery-subject.deliv-subj-code <> p-deliv-subj-code
      135       then do:
      136         message
      137         vss-workfile vss-revision vss-description skip
      138         "Для уже имеющейся записи нельзя изменить"
      139         "внутренний код" skip
      140         view-as alert-box ERROR.
      141         undo _main, return error '':U.
      142       end.
      143     end.
      144     assign
      145     ub.delivery-subject.deliv-subj-name     = p-deliv-subj-name
      146     ub.delivery-subject.des                 = p-des
      147     ub.delivery-subject.reg-code            = p-reg-code
      148     ub.delivery-subject.sts                 =  (if p-mode = 'ДОБАВЛЕНИЕ':U
      149                                                 then 0
      150                                                 else ub.delivery-subject.sts)
      151     .
      152     release ub.delivery-subject no-error.
      153     if error-status:error then do:
      154        run err-mess in this-procedure ( input
      155                                              substitute("Ошибка при сохранении записи СУБЪЕКТ ДОСТАВКИ с кодом &1: &2: &3"
      156                                                         , p-deliv-subj-code
      157                                                         , ERROR-STATUS:GET-message(1)
      158                                                         , return-value
      159                                                         )
      160                      ).
      161       undo _main, return error "":U.
      162    end.
      163   end.
      164   PROCEDURE err-mess:
      165     DEFINE INPUT PARAMETER p-mess as character No-UNDO.
      166         message
      167         p-mess
      168         view-as alert-box error .
      169   END PROCEDURE.
