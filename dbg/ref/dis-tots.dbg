      449   define  stream PrnLibStream.
      450   procedure prn-lib-prn-file :
      451     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      452     define input parameter p-DIsabledoptions as integer no-undo .
      453     define variable v-report-name as character no-undo .
      454     define variable v-user-action as character no-undo .
      455     define variable v-printed     as logical   no-undo .
      456     define variable v-exist       as logical   no-undo .
      457     do
      458       on error undo, return error
      459       :
      460       run prn-lib-get-report-name  in this-procedure (
      461         input parParentProc
      462         ,output v-report-name
      463         ).
      464   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      465   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      466     (input  v-report-name
      467     ,input  2
      468     ,output v-exist
      469     )  .
      470       if NOT v-exist then
      471       DO:
      472         Message
      473           "Нет заданий на печать ! "
      474           view-as alert-box .
      475         Return  .
      476       End.
      477       run gbl/prnfilen.w
      478         (input  ""
      479         ,input  p-DisabledOptions
      480         ,input  string(v-report-name )
      481         ,input  7
      482         ,output v-user-action
      483         ,output v-printed
      484         ) .
      485       if v-printed then
      486       do:
      487         return "YES" .
      488       end.
      489       else
      490       do:
      491         return "NO" .
      492       end.
      493     end.
      494   end procedure.
      495   procedure prn-lib-open-stream :
      496     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      497     define input parameter p-page-size    as integer no-undo .
      498     define input parameter p-is-stream    as logical no-undo .
      499     define input parameter p-append       as logical no-undo .
      500     define variable v-report-name as character no-undo .
      501     do
      502       on error undo, return error
      503       :
      504       run prn-lib-get-report-name  in this-procedure (
      505         input parParentProc
      506         ,output v-report-name
      507         ).
      508       if p-is-stream then
      509       do:
      510         if p-append then
      511         do:
      512           output stream PrnLibStream to value( v-report-name )
      513             page-size value(p-page-size) append .
      514         end.
      515         if not p-append then
      516         do:
      517           output stream PrnLibStream to value( v-report-name )
      518             page-size value(p-page-size) .
      519         end.
      520       end.
      521       if not p-is-stream then
      522       do:
      523         if p-append then
      524         do:
      525           output to value( v-report-name )
      526             page-size value(p-page-size) append .
      527         end.
      528         if not p-append then
      529         do:
      530           output to value( v-report-name )
      531             page-size value(p-page-size) .
      532         end.
      533       end.
      534     end.
      535   end procedure.
      536   procedure prn-lib-open-exp :
      537     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      538     define input parameter p-is-stream    as logical no-undo .
      539     define input parameter p-is-append    as logical no-undo .
      540     define output parameter p-ReportFileName as char init "report" no-undo.
      541     define output parameter p-process as logical no-undo .
      542     define variable glog as logical no-undo .
      543     do
      544       on error undo, return error
      545       :
      546       SYSTEM-DIALOG GET-FILE p-ReportFileName
      547         TITLE      "Укажите путь"
      548         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      549         ASK-OVERWRITE
      550         CREATE-TEST-FILE
      551         SAVE-AS
      552         USE-FILENAME
      553         DEFAULT-EXTENSION "txt"
      554         UPDATE glog
      555         .
      556       if not glog then  return.
      557       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      558       if p-is-stream then
      559       do:
      560         if p-is-append then
      561         do:
      562           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      563         end.
      564         else
      565         do:
      566           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      567         end.
      568       end.
      569       else
      570       do:
      571         if p-is-append then
      572         do:
      573           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      574         end.
      575         else
      576         do:
      577           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      578         end.
      579       end.
      580       p-process = yes.
      581     end.
      582   end procedure.
      583   procedure prn-lib-get-report-name :
      584     define input parameter parParentProc  as widget-handle no-undo.
      585     define output parameter p-report-name as character no-undo .
      586     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      587   end procedure.
      588   procedure prn-lib-reportviewer-report-name :
      589     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      590     define input parameter p-report-name-html as character no-undo .
      591     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      592   end procedure.
      593   procedure prn-lib-reportviewer :
      594     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      595     define input parameter p-report-name-html as character no-undo .
      596     define input parameter p-param        as character no-undo .
      597     define variable v-excel           as character no-undo init 'TRUE' .
      598     define variable v-value-character as character no-undo .
      599     define variable v-value-integer   as character no-undo .
      600     define variable v-value-date      as date      no-undo .
      601     define variable v-value-decimal   as decimal   no-undo .
      602     define variable rep-excel         as logical   no-undo .
      603     define variable excel-string      as character no-undo .
      604     define variable v-param-type      as character no-undo .
      605     define variable v-tth             as handle    no-undo .
      606     run adm/shattri.p (
      607       input "get":U
      608       ,input  ""
      609       ,input  0
      610       ,input  'report-glob':U
      611       ,input  'rep-excel':U
      612       ,output v-value-character
      613       ,output v-value-date
      614       ,output v-value-decimal
      615       ,output v-value-integer
      616       ,output rep-excel
      617       ,output v-param-type
      618       ,INPUT-OUTPUT table-handle v-tth
      619       )  .
      620     if rep-excel then v-excel = "TRUE" .
      621     else v-excel = "FALSE" .
      622     if p-param eq ""
      623     then
      624        p-param = "EXCEL:" + v-excel.
      625     else
      626        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      627     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      628   end procedure.
      629   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      630   procedure cur-time :
      631      define output parameter p-today as date      no-undo .
      632      define output parameter p-time  as integer   no-undo .
      633     do
      634     on error undo, return error
      635     :
      636       define variable v-date1 as date      no-undo .
      637       define variable v-date2 as date      no-undo .
      638       define variable v-time  as integer   no-undo .
      639       assign
      640         v-date1 = today
      641         v-time  = time
      642         v-date2 = today
      643       .
      644       if v-date1 <> v-date2
      645       then do:
      646         assign
      647           v-date1 = today
      648           v-time  = v-time
      649         .
      650       end.
      651       assign
      652         p-today = v-date1
      653         p-time  = v-time
      654       .
      655     end.
      656   end.
      657   function cur-time-date returns character
      658   :
      659     return string(today, '99/99/9999':U) .
      660   end.
      661   function cur-time-mjd returns decimal
      662   :
      663     define variable v-date as date      no-undo .
      664     define variable v-time as integer   no-undo .
      665     run cur-time in this-procedure
      666       (output v-date
      667       ,output v-time
      668       ) .
      669     return integer(v-date) - 2400002 + (v-time / 86400) .
      670   end.
      671   function cur-time-get-ending-index returns integer
      672   (input p-number as integer
      673   )
      674   :
      675     if p-number < 0
      676     or p-number = ?
      677     then do:
      678       return 1 .
      679     end.
      680     define variable v-rest as integer   no-undo .
      681     assign
      682       p-number = p-number modulo 100
      683     .
      684     if p-number < 20
      685     then do:
      686       assign
      687         v-rest = p-number
      688       .
      689     end.
      690     else do:
      691       assign
      692         v-rest = p-number modulo 10
      693       .
      694     end.
      695     case v-rest :
      696       when 1
      697       then do:
      698         return 2 .
      699       end.
      700       when 2 or
      701       when 3 or
      702       when 4
      703       then do:
      704         return 3 .
      705       end.
      706       otherwise do:
      707         return 1 .
      708       end.
      709     end case .
      710   end.
      711   procedure cur-time-mjd-to-date :
      712      define input  parameter i-mjd-diff as decimal no-undo.
      713      define output parameter o-Date     as date    no-undo.
      714      define output parameter o-Time     as integer no-undo.
      715      define variable v-day-number as integer   no-undo .
      716      if    i-mjd-diff < 0
      717         or i-mjd-diff = ?
      718      then do:
      719         return "?" .
      720      end.
      721      assign
      722         v-day-number = truncate(i-mjd-diff,0).
      723         o-Date = date(v-day-number + 2400002).
      724         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      725     .
      726   end.
      727   function cur-time-mjd-to-string returns character
      728   (input p-mjd-diff as decimal
      729   )
      730   :
      731     define variable v-day-number as integer   no-undo .
      732     define variable v-seconds    as integer   no-undo .
      733     define variable v-hour       as integer   no-undo .
      734     define variable v-min        as integer   no-undo .
      735     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      736     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      737     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      738     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      739     if p-mjd-diff < 0
      740     or p-mjd-diff = ?
      741     then do:
      742       return "?" .
      743     end.
      744     assign
      745       v-day-number = integer(truncate(p-mjd-diff,0))
      746       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      747     .
      748     if v-seconds > 86400
      749     then do:
      750       assign
      751         v-seconds = 86400 - 1
      752       .
      753     end.
      754     if v-seconds < 0
      755     then do:
      756       assign
      757         v-seconds = 0
      758       .
      759     end.
      760     assign
      761       v-hour = truncate(v-seconds / 3600, 0)
      762     .
      763     assign
      764       v-seconds = v-seconds modulo 3600
      765     .
      766     assign
      767       v-min = truncate(v-seconds / 60, 0)
      768     .
      769     assign
      770       v-seconds = v-seconds modulo 60
      771     .
      772     return
      773         (if v-day-number <> 0
      774           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      775           else ""
      776         )
      777       + (if v-day-number <> 0 or v-hour <> 0
      778           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      779           else ""
      780         )
      781       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      782           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      783           else ""
      784         )
      785       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      786       .
      787   end.
      788   function cur-time-string returns character
      789   :
      790     define variable v-date as date      no-undo .
      791     define variable v-time as integer   no-undo .
      792     run cur-time in this-procedure
      793       (output v-date
      794       ,output v-time
      795       ) .
      796     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      797   end.
      798   function cur-time-string-sec returns character
      799   :
      800     define variable v-date as date      no-undo .
      801     define variable v-time as integer   no-undo .
      802     run cur-time in this-procedure
      803       (output v-date
      804       ,output v-time
      805       ) .
      806     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      807   end.
      808   function cur-time-custom  returns character
      809   (input p-prefix as character
      810   ,input p-date-format as character
      811   ,input p-delimiter as character
      812   ,input p-time-format as character
      813   ,input p-suffix as character
      814   )
      815   :
      816     define variable v-date as date      no-undo .
      817     define variable v-time as integer   no-undo .
      818     run cur-time in this-procedure
      819       (output v-date
      820       ,output v-time
      821       ) .
      822     return
      823       p-prefix
      824       + string(v-date, p-date-format)
      825       + p-delimiter
      826       + string(v-time, p-time-format)
      827       + p-suffix
      828       .
      829   end.
      830   function cur-time-print  returns character
      831   :
      832     define variable v-date as date      no-undo .
      833     define variable v-time as integer   no-undo .
      834     run cur-time in this-procedure
      835       (output v-date
      836       ,output v-time
      837       ) .
      838     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      839   end.
      840   function cur-time-datetime returns datetime
      841   :
      842     define variable v-char as character no-undo .
      843     define variable v-datetime as datetime no-undo .
      844     v-char = cur-time-string().
      845     v-datetime = datetime(v-char).
      846     return  v-datetime.
      847   end.
      848   function cur-time-string-msec returns character
      849   :
      850     define variable v-date as datetime  no-undo .
      851     v-date = now.
      852     return string(v-date) .
      853   end.
      854   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      855   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      856   procedure fltopend_fltopend :
      857   define input parameter p-parent-handle as handle no-undo .
      858   define input parameter p-qh as handle no-undo .
      859   define input parameter p-flt-open-open-query  as character no-undo .
      860   define input parameter p-where-cond as character no-undo .
      861   define input parameter p-use-indFIRST-query-tail as character no-undo .
      862   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      863   define input parameter p-indexed-reposition as character no-undo .
      864     do
      865     on error undo, return error
      866     :
      867   define variable v-prepare-string as character no-undo .
      868   define variable glog as logical no-undo .
      869   assign
      870   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      871                      p-where-cond + chr(32)  +
      872                      p-use-indFIRST-query-tail + chr(32) +
      873                      p-use-ind-sort-clmn-by + chr(32) +
      874                      p-indexed-reposition
      875   .
      876   assign
      877   glog = p-qh:query-prepare(v-prepare-string) no-error .
      878   if not glog
      879   or error-status:error then do:
      880     message error-status:get-message(1) view-as alert-box .
      881     undo, return error .
      882   end.
      883   assign
      884   glog = p-qh:query-open no-error .
      885   if not glog
      886   or error-status:error then do:
      887     message error-status:get-message(1) view-as alert-box .
      888     undo, return error .
      889   end.
      890     end.
      891   end procedure.
      892   procedure fltopend_fltfindd :
      893   define input parameter p-parent-handle as handle no-undo .
      894   define input parameter p-qh as handle no-undo .
      895   define input parameter p-rowid as rowid no-undo .
      896   define input parameter p-next as logical no-undo .
      897   define input parameter p-lock as integer no-undo .
      898   define input parameter p-bh as handle no-undo .
      899   define input parameter p-where-cond as character no-undo .
      900   define input parameter p-use-index-phrase as character no-undo .
      901   define variable glog as logical no-undo .
      902   define variable v-qh as handle no-undo .
      903   define variable v-bh as handle no-undo .
      904   define variable v-recid as recid no-undo .
      905   define variable v-prepare-string as character no-undo .
      906   do
      907   on error undo, return error
      908   on stop undo, return error
      909   :
      910     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      911     create buffer v-bh for table p-bh buffer-name p-bh:name.
      912     create query v-qh.
      913     v-qh:set-buffers(v-bh).
      914     v-prepare-string = substitute("for each &1 &2 &3"
      915                                     ,v-bh:name
      916                                     ,p-where-cond
      917                                     ,p-use-index-phrase).
      918     glog = v-qh:query-prepare(v-prepare-string) no-error.
      919     if not glog then do:
      920       delete object v-qh.
      921       delete object v-bh.
      922       undo, return error .
      923     end.
      924     glog = v-qh:query-open no-error .
      925     if not glog then do:
      926       delete object v-qh.
      927       delete object v-bh.
      928       undo, return error .
      929     end.
      930     if p-next then do:
      931       v-qh:reposition-to-rowid(p-rowid) no-error .
      932       glog = v-qh:get-next( p-lock) no-error .
      933       glog = v-qh:get-next( p-lock) no-error .
      934       if not glog or v-qh:query-off-end = yes then do:
      935         glog = v-qh:get-first( p-lock) no-error .
      936       end.
      937     end.
      938     else do:
      939       glog = v-qh:get-first( p-lock) no-error .
      940     end.
      941     v-recid = v-bh:recid no-error .
      942     delete object v-qh.
      943     delete object v-bh.
      944     return string(v-recid) .
      945   end.
      946   end procedure.
      947   procedure fltopend_fltfindq :
      948   define input parameter p-parent-handle as handle no-undo .
      949   define input parameter p-qh as handle no-undo .
      950   define input parameter p-next as logical no-undo .
      951   define input parameter p-lock as integer no-undo .
      952   define input parameter p-flt-open-open-query  as character no-undo .
      953   define input parameter p-where-cond as character no-undo .
      954   define input parameter p-use-indFIRST-query-tail as character no-undo .
      955   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      956   define input parameter p-indexed-reposition as character no-undo .
      957   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      958   define variable glog as logical no-undo .
      959   define variable v-qh as handle no-undo .
      960   define variable v-bh as handle no-undo extent 18.
      961   define variable v-rowid as rowid no-undo extent 18.
      962   define variable v-ii as integer no-undo .
      963   define variable v-prepare-string as character no-undo .
      964   do
      965   on error undo, return error
      966   on stop undo, return error
      967   :
      968     create query v-qh.
      969     do v-ii = 1 to p-qh:num-buffers:
      970       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      971       assign
      972       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      973       no-error.
      974       v-qh:add-buffer(v-bh[v-ii]).
      975     end.
      976     assign
      977     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      978                       p-where-cond + chr(32)  +
      979                       p-use-indFIRST-query-tail + chr(32) +
      980                       p-use-ind-sort-clmn-by + chr(32) +
      981                       p-indexed-reposition
      982     .
      983     glog = v-qh:query-prepare( v-prepare-string) no-error .
      984     if not glog then do:
      985       delete object v-qh.
      986       do v-ii = 1 to p-qh:num-buffers:
      987         delete object v-bh[v-ii].
      988       end.
      989       undo, return error .
      990     end.
      991     glog = v-qh:query-open no-error .
      992     if not glog then do:
      993       delete object v-qh.
      994       do v-ii = 1 to p-qh:num-buffers:
      995         delete object v-bh[v-ii].
      996       end.
      997       undo, return error .
      998     end.
      999     if p-next then do:
     1000       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1001       glog = v-qh:get-next( p-lock) no-error .
     1002       glog = v-qh:get-next( p-lock) no-error .
     1003       if not glog or v-qh:query-off-end = yes then do:
     1004         glog = v-qh:get-first( p-lock) no-error .
     1005       end.
     1006     end.
     1007     else do:
     1008       glog = v-qh:get-first( p-lock) no-error .
     1009     end.
     1010     do v-ii = 1 to p-qh:num-buffers:
     1011       assign
     1012       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1013       no-error.
     1014     end.
     1015     delete object v-qh.
     1016     do v-ii = 1 to p-qh:num-buffers:
     1017       delete object v-bh[v-ii].
     1018     end.
     1019   end.
     1020   end procedure.
