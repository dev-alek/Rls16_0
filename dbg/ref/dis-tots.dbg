      402   procedure fltfield-clear :
      403     define output parameter loc-fld as character no-undo.
      404     define output parameter loc-lab as character no-undo .
      405     define output parameter loc-spr as character no-undo .
      406     define output parameter loc-dim as character no-undo .
      407     assign
      408       loc-fld = ""
      409       loc-lab = ""
      410       loc-spr = ""
      411       loc-dim = "0"
      412     .
      413   end procedure .
      414   procedure fltfield-add :
      415     define input        parameter par-fld as character no-undo.
      416     define input        parameter par-lab as character no-undo .
      417     define input        parameter par-spr as character no-undo .
      418     define input-output parameter loc-fld as character no-undo.
      419     define input-output parameter loc-lab as character no-undo .
      420     define input-output parameter loc-spr as character no-undo .
      421     define input-output parameter loc-dim as character no-undo .
      422     do
      423     on error undo, return error
      424     :
      425       assign
      426       loc-fld = if loc-dim = '0'
      427                 then par-fld
      428                 else (loc-fld + chr(44) + par-fld)
      429       loc-lab = if loc-dim = '0'
      430                 then par-lab
      431                 else (loc-lab + chr(44) + par-lab)
      432       loc-spr = if loc-dim = '0'
      433                 then par-spr
      434                 else (loc-spr + chr(44) + par-spr)
      435       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      436                 string(integer(if num-entries(loc-dim) > 1
      437                               then entry(2, loc-dim)
      438                               else entry(1, loc-dim)
      439                               ) + 1)
      440       no-error
      441       .
      442     end.
      443   end procedure.
      444   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
