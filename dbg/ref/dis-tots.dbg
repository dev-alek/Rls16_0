     1588   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1589   on help of frame Dialog-Frame
     1590   do:
     1591     run gbl/app_help.p
     1592       (input this-procedure :file-name
     1593       ,input ''
     1594       ,input ?
     1595       ) no-error.
     1596     if error-status :error then do:
     1597       message
     1598         "Ошибка при вызове помощи"
     1599         error-status :get-message(1)
     1600         view-as alert-box .
     1601     end.
     1602   end.
     1603   run minbtn-set in this-procedure .
     1604   on choose of b-help in frame Dialog-Frame
     1605   do:
     1606     apply "help":u to frame Dialog-Frame .
     1607   end.
     1608   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1609   procedure minbtn-set :
     1610       do
     1611           on error undo, return error return-value
     1612           :
     1613           define variable ii              as integer       no-undo .
     1614           define variable fh              as widget-handle no-undo .
     1615           define variable hh              as widget-handle no-undo .
     1616           define variable v-h             as handle        extent 4 no-undo .
     1617           define variable v-name-button   as character     no-undo .
     1618           define variable v-help-old-x    as decimal       no-undo .
     1619           define variable v-help-old-y    as decimal       no-undo .
     1620           define variable v-help-old-size as decimal       no-undo .
     1621           define variable v-frame-width   as decimal       no-undo .
     1622           define variable jj              as integer       no-undo .
     1623           do
     1624               on error undo, return error
     1625               :
     1626               assign
     1627                   v-frame-width = frame Dialog-Frame:width - 0.3
     1628                   fh            = frame Dialog-Frame:first-child
     1629                   hh            = fh:first-child
     1630                   ii            = 1
     1631                   .
     1632               do while valid-handle(hh):
     1633                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1634                   do:
     1635                       case lc(hh:name) :
     1636                           when "b-help" then
     1637                               do:
     1638                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1639                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1640                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1641                                   hh:TOOLTIP = "Помощь" .
     1642                                   v-help-old-x = hh:column .
     1643                                   v-help-old-y = hh:row    .
     1644                                   v-help-old-size = hh:width .
     1645                                   hh:width-chars = 2.5 .
     1646                               end.
     1647                           when "b-print" then
     1648                               do:
     1649                                   hh:load-image("cmp/b-print.bmp":u) .
     1650                                   hh:TOOLTIP = "Печать" .
     1651                                   v-h[ii] = hh:handle .
     1652                                   ii = ii + 1 .
     1653                                   hh:width-chars = 3 .
     1654                               end.
     1655                           when "b-history" or
     1656                           when "b-hist" then
     1657                               do:
     1658                                   hh:load-image("cmp/b-hist.bmp":u) .
     1659                                   hh:TOOLTIP = "История" .
     1660                                   v-h[ii] = hh:handle .
     1661                                   ii = ii + 1 .
     1662                                   hh:width-chars = 3 .
     1663                               end.
     1664                           when "b-sch" then
     1665                               do:
     1666                                   hh:load-image("cmp/b-sch.bmp":u) .
     1667                                   hh:TOOLTIP = "Установка Фильтра" .
     1668                                   v-h[ii] = hh:handle .
     1669                                   ii = ii + 1 .
     1670                                   hh:width-chars = 3 .
     1671                               end.
     1672                           when "b-hist-user" then
     1673                               do:
     1674                                   hh:load-image("cmp/b-hist.bmp":u) .
     1675                                   hh:TOOLTIP = "История пользователя" .
     1676                                   ii = ii + 1 .
     1677                               end.
     1678                       end case.
     1679                   end.
     1680                   hh = hh:next-sibling.
     1681               end.
     1682               b-help:column = v-frame-width - b-help:width-chars.
     1683               jj = 0.
     1684               repeat ii = 4 to 1 by -1 :
     1685                   if valid-handle (v-h[ii] ) then
     1686                   do:
     1687                       jj  = jj + 1 .
     1688                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1689                       v-h[ii]:row    = v-help-old-y .
     1690                   end.
     1691               end.
     1692           end.
     1693       end.
     1694   end procedure.
     1695   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1696   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1697   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1698   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1699   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1700   define variable v-diasize-current-frame-height as decimal   no-undo .
     1701   define variable v-diasize-change-size          as logical   no-undo .
     1702   define variable v-diasize-resize-button        as handle    no-undo .
     1703   define variable v-diasize-wndmax               as logical   no-undo .
     1704   define variable v-diasize-wndstore             as logical   no-undo .
     1705   define variable v-diasize-proc-name            as character no-undo .
     1706   define variable v-diasize-browse-handle        as handle    no-undo .
     1707   define variable v-diasize-browse-number        as integer   no-undo .
     1708   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1709   define temp-table temp-diasize-handle no-undo
     1710     field handle-value  as handle
     1711     field save-position as decimal
     1712     index xpk is primary unique handle-value
     1713     .
     1714   define temp-table temp-browse-handle no-undo
     1715     field browse-type   as character
     1716     field browse-number as integer
     1717     field browse-handle as handle
     1718     field original-size as decimal
     1719     index xpk is primary unique browse-type browse-number
     1720     index xie browse-type browse-handle
     1721   .
     1722   procedure diasize_change-height :
     1723     define input  parameter p-change-value  as decimal   no-undo .
     1724     define input  parameter p-move-resize   as logical   no-undo .
     1725     define variable v-field-group-handle    as handle    no-undo .
     1726     define variable v-object-handle         as handle    no-undo .
     1727     define variable v-frame-height          as decimal   no-undo .
     1728     define variable v-frame-virtual-height  as decimal   no-undo .
     1729     define variable v-browse-height         as decimal   no-undo .
     1730     define variable v-window-height         as decimal   no-undo .
     1731     define variable v-window-virtual-height as decimal   no-undo .
     1732     define variable v-change-sign           as integer   no-undo .
     1733     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1734     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1735     if p-change-value > 0
     1736     then do:
     1737       if frame Dialog-Frame :height + p-change-value
     1738           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1739       then do:
     1740         assign
     1741           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1742                           - (frame Dialog-Frame :height-chars)
     1743         .
     1744         if p-change-value <= 0
     1745         then do:
     1746           run diasize_position-resize-button in this-procedure .
     1747           return .
     1748         end.
     1749       end.
     1750     end.
     1751     if p-change-value < 0
     1752     then do:
     1753       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1754       then do:
     1755         assign
     1756           p-change-value = v-diasize-orig-frame-height
     1757                          - (frame Dialog-Frame :height-chars)
     1758         .
     1759         if p-change-value >= 0
     1760         then do:
     1761           run diasize_position-resize-button in this-procedure .
     1762           return .
     1763         end.
     1764       end.
     1765     end.
     1766     if p-change-value >= 0
     1767     then do:
     1768       assign
     1769         v-change-sign = 1
     1770       .
     1771     end.
     1772     else do:
     1773       assign
     1774         v-change-sign = -1
     1775       .
     1776     end.
     1777     assign
     1778       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1779     .
     1780     if p-change-value = 0
     1781     then do:
     1782       run diasize_position-resize-button in this-procedure .
     1783       return .
     1784     end.
     1785     move_block:
     1786     do
     1787     on error undo move_block, retry move_block
     1788     :
     1789       if retry
     1790       then do:
     1791         do
     1792         on error undo move_block, leave move_block
     1793         :
     1794           if p-change-value > 0
     1795           then do:
     1796             for each buf_temp-diasize-handle
     1797             on error undo, next
     1798             :
     1799               assign
     1800                 v-object-handle = buf_temp-diasize-handle.handle-value
     1801               .
     1802               if v-object-handle <> v-diasize-resize-button
     1803               then do:
     1804                 assign
     1805                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1806                 .
     1807               end.
     1808             end.
     1809             assign
     1810               v-diasize-browse-handle :height = v-browse-height
     1811             .
     1812             for each buf_temp-browse-handle
     1813               where buf_temp-browse-handle.browse-type = 'height':u
     1814             on error undo, next
     1815             :
     1816               assign
     1817                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1818               .
     1819             end.
     1820             assign
     1821               frame Dialog-Frame :height = v-frame-height
     1822             .
     1823             if frame Dialog-Frame :scrollable = true
     1824             then do:
     1825               assign
     1826                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1827               .
     1828             end.
     1829             run diasize_position-resize-button in this-procedure .
     1830           end.
     1831           else do:
     1832             if frame Dialog-Frame :scrollable = true
     1833             then do:
     1834               assign
     1835                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1836               .
     1837             end.
     1838             assign
     1839               frame Dialog-Frame :height = v-frame-height
     1840             .
     1841             assign
     1842               v-diasize-browse-handle :height = v-browse-height
     1843             .
     1844             for each buf_temp-browse-handle
     1845               where buf_temp-browse-handle.browse-type = 'height':u
     1846             on error undo, next
     1847             :
     1848               assign
     1849                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1850               .
     1851             end.
     1852             for each buf_temp-diasize-handle
     1853             on error undo, next
     1854             :
     1855               assign
     1856                 v-object-handle = buf_temp-diasize-handle.handle-value
     1857               .
     1858               if v-object-handle <> v-diasize-resize-button
     1859               then do:
     1860                 assign
     1861                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1862                 .
     1863               end.
     1864             end.
     1865             run diasize_position-resize-button in this-procedure .
     1866           end.
     1867           assign
     1868             v-diasize-change-size = false
     1869           .
     1870           leave move_block .
     1871         end.
     1872       end.
     1873       assign
     1874         v-diasize-need-full-display = true
     1875       .
     1876       if v-diasize-change-size = false
     1877       then do:
     1878         assign
     1879           v-diasize-change-size = true
     1880         .
     1881       end.
     1882       else do:
     1883         return .
     1884       end.
     1885       assign
     1886         v-frame-height = frame Dialog-Frame :height
     1887         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1888         v-browse-height = v-diasize-browse-handle :height
     1889       .
     1890       for each buf_temp-browse-handle
     1891         where buf_temp-browse-handle.browse-type = 'height':u
     1892       :
     1893         assign
     1894           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1895         .
     1896       end.
     1897       for each buf_temp-diasize-handle
     1898       :
     1899         delete buf_temp-diasize-handle .
     1900       end.
     1901       assign
     1902         v-field-group-handle = frame Dialog-Frame :first-child
     1903       .
     1904       do while valid-handle(v-field-group-handle)
     1905       :
     1906         assign
     1907           v-object-handle = v-field-group-handle :first-child
     1908         .
     1909         do while valid-handle(v-object-handle)
     1910         :
     1911           if  v-object-handle <> v-diasize-browse-handle :handle
     1912           and can-query(v-object-handle, "row")
     1913           and can-query(v-object-handle, "height")
     1914           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1915           then do:
     1916             find first buf_temp-browse-handle
     1917               where buf_temp-browse-handle.browse-type   = 'height':u
     1918                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1919               no-error .
     1920             if available buf_temp-browse-handle
     1921             then do:
     1922             end.
     1923             else do:
     1924               create buf_temp-diasize-handle .
     1925               assign
     1926                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1927                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1928               .
     1929             end.
     1930           end.
     1931           assign
     1932             v-object-handle = v-object-handle :next-sibling
     1933           .
     1934         end.
     1935         assign
     1936           v-field-group-handle = v-field-group-handle :next-sibling
     1937         .
     1938       end.
     1939       do with frame Dialog-Frame
     1940       :
     1941         hide v-diasize-resize-button .
     1942         assign
     1943           v-diasize-resize-button :row    = 1
     1944           v-diasize-resize-button :column = 1
     1945         .
     1946       end.
     1947       if p-change-value > 0
     1948       then do:
     1949         if frame Dialog-Frame :scrollable = true
     1950         then do:
     1951           assign
     1952             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1953             no-error .
     1954           if error-status :error
     1955           or error-status :get-message(1) <> ""
     1956           then do:
     1957             undo move_block, retry move_block .
     1958           end.
     1959         end.
     1960         assign
     1961           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1962           no-error .
     1963         if error-status :error
     1964         or error-status :get-message(1) <> ""
     1965         then do:
     1966           undo move_block, retry move_block .
     1967         end.
     1968         assign
     1969           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1970           no-error .
     1971         if error-status :error
     1972         or error-status :get-message(1) <> ""
     1973         then do:
     1974           undo move_block, retry move_block .
     1975         end.
     1976         for each buf_temp-browse-handle
     1977           where buf_temp-browse-handle.browse-type = 'height':u
     1978         on error undo move_block, retry move_block
     1979         :
     1980           assign
     1981             buf_temp-browse-handle.browse-handle :height
     1982               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1983             no-error .
     1984           if error-status :error
     1985           or error-status :get-message(1) <> ""
     1986           then do:
     1987             undo move_block, retry move_block .
     1988           end.
     1989         end.
     1990         for each buf_temp-diasize-handle
     1991         on error undo move_block, retry move_block
     1992         :
     1993           assign
     1994             v-object-handle = buf_temp-diasize-handle.handle-value
     1995           .
     1996           if v-object-handle <> v-diasize-resize-button
     1997           then do:
     1998             assign
     1999               v-object-handle :row = v-object-handle :row + p-change-value
     2000               no-error .
     2001             if error-status :error
     2002             or error-status :get-message(1) <> ""
     2003             then do:
     2004               undo move_block, retry move_block .
     2005             end.
     2006           end.
     2007         end.
     2008       end.
     2009       else do:
     2010         for each buf_temp-diasize-handle
     2011         on error undo move_block, retry move_block
     2012         :
     2013           assign
     2014             v-object-handle = buf_temp-diasize-handle.handle-value
     2015           .
     2016           if v-object-handle <> v-diasize-resize-button
     2017           then do:
     2018             assign
     2019               v-object-handle :row = v-object-handle :row + p-change-value
     2020               no-error .
     2021             if error-status :error
     2022             or error-status :get-message(1) <> ""
     2023             then do:
     2024               undo move_block, retry move_block .
     2025             end.
     2026           end.
     2027         end.
     2028         assign
     2029           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2030           no-error .
     2031         if error-status :error
     2032         or error-status :get-message(1) <> ""
     2033         then do:
     2034           undo move_block, retry move_block .
     2035         end.
     2036         for each buf_temp-browse-handle
     2037           where buf_temp-browse-handle.browse-type = 'height':u
     2038         on error undo move_block, retry move_block
     2039         :
     2040           assign
     2041             buf_temp-browse-handle.browse-handle :height
     2042               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2043             no-error .
     2044           if error-status :error
     2045           or error-status :get-message(1) <> ""
     2046           then do:
     2047             undo move_block, retry move_block .
     2048           end.
     2049         end.
     2050         assign
     2051           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2052           no-error .
     2053         if error-status :error
     2054         or error-status :get-message(1) <> ""
     2055         then do:
     2056           undo move_block, retry move_block .
     2057         end.
     2058         if frame Dialog-Frame :scrollable = true
     2059         then do:
     2060           assign
     2061             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2062             no-error .
     2063           if error-status :error
     2064           or error-status :get-message(1) <> ""
     2065           then do:
     2066             undo move_block, retry move_block .
     2067           end.
     2068         end.
     2069       end.
     2070       if p-move-resize = true
     2071       then do:
     2072         run diasize_position-resize-button in this-procedure .
     2073       end.
     2074       if v-diasize-wndstore = true
     2075       then do:
     2076         if connected("ub") = true
     2077         then do:
     2078           define variable v-cntxt-db-num        as integer   no-undo .
     2079           define variable v-cntxt-userid        as character no-undo .
     2080           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2081                                             , OUTPUT v-cntxt-userid
     2082                                             ) .
     2083           run gbl/wndsizew.p
     2084             (input  v-cntxt-db-num
     2085             ,input  v-cntxt-userid
     2086             ,input  v-diasize-proc-name
     2087             ,input  'height':u
     2088             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2089             ) .
     2090         end.
     2091       end.
     2092     end.
     2093     assign
     2094       v-diasize-change-size = false
     2095     .
     2096   end procedure.
     2097   procedure diasize_set-height :
     2098     define input  parameter p-new-height  as decimal   no-undo .
     2099     define input  parameter p-move-resize as logical   no-undo .
     2100     do
     2101     on error undo, return error return-value
     2102     :
     2103       run diasize_change-height in this-procedure
     2104         (input  (p-new-height - frame Dialog-Frame :height)
     2105         ,input  p-move-resize
     2106         ) .
     2107     end.
     2108   end procedure.
     2109   procedure diasize_change-width :
     2110     define input  parameter p-change-value as decimal   no-undo .
     2111     define input  parameter p-move-resize  as logical   no-undo .
     2112     define variable v-field-group-handle   as handle    no-undo .
     2113     define variable v-object-handle        as handle    no-undo .
     2114     define variable v-frame-width          as decimal   no-undo .
     2115     define variable v-frame-virtual-width  as decimal   no-undo .
     2116     define variable v-browse-width         as decimal   no-undo .
     2117     define variable v-window-width         as decimal   no-undo .
     2118     define variable v-window-virtual-width as decimal   no-undo .
     2119     define variable v-change-sign          as integer   no-undo .
     2120     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2121     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2122     if p-change-value > 0
     2123     then do:
     2124       if frame Dialog-Frame :width + p-change-value >
     2125           session :width-chars
     2126       then do:
     2127         assign
     2128           p-change-value = session :width-chars - frame Dialog-Frame :width
     2129         .
     2130         if p-change-value <= 0
     2131         then do:
     2132           run diasize_position-resize-button in this-procedure .
     2133           return .
     2134         end.
     2135       end.
     2136     end.
     2137     if p-change-value < 0
     2138     then do:
     2139       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2140       then do:
     2141         assign
     2142           p-change-value = v-diasize-orig-frame-width
     2143                          - frame Dialog-Frame :width
     2144         .
     2145         if p-change-value >= 0
     2146         then do:
     2147           run diasize_position-resize-button in this-procedure .
     2148           return .
     2149         end.
     2150       end.
     2151     end.
     2152     if p-change-value >= 0
     2153     then do:
     2154       assign
     2155         v-change-sign = 1
     2156       .
     2157     end.
     2158     else do:
     2159       assign
     2160         v-change-sign = -1
     2161       .
     2162     end.
     2163     assign
     2164       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2165     .
     2166     if p-change-value = 0
     2167     then do:
     2168       run diasize_position-resize-button in this-procedure .
     2169       return .
     2170     end.
     2171     move_block:
     2172     do
     2173     on error undo move_block, leave move_block
     2174     :
     2175       if retry
     2176       then do:
     2177         do
     2178         on error undo move_block, leave move_block
     2179         :
     2180           if p-change-value > 0
     2181           then do:
     2182             for each buf_temp-diasize-handle
     2183             on error undo, next
     2184             :
     2185               assign
     2186                 v-object-handle = buf_temp-diasize-handle.handle-value
     2187               .
     2188               if v-object-handle <> v-diasize-resize-button
     2189               then do:
     2190                 assign
     2191                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2192                 .
     2193               end.
     2194             end.
     2195             assign
     2196               v-diasize-browse-handle :width = v-browse-width
     2197             .
     2198             for each buf_temp-browse-handle
     2199               where buf_temp-browse-handle.browse-type = 'width':u
     2200             on error undo, next
     2201             :
     2202               assign
     2203                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2204               .
     2205             end.
     2206             assign
     2207               frame Dialog-Frame :width = v-frame-width
     2208             .
     2209             if frame Dialog-Frame :scrollable = true
     2210             then do:
     2211               assign
     2212                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2213               .
     2214             end.
     2215             run diasize_position-resize-button in this-procedure .
     2216           end.
     2217           else do:
     2218             if frame Dialog-Frame :scrollable = true
     2219             then do:
     2220               assign
     2221                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2222               .
     2223             end.
     2224             assign
     2225               frame Dialog-Frame :width = v-frame-width
     2226             .
     2227             for each buf_temp-browse-handle
     2228               where buf_temp-browse-handle.browse-type = 'width':u
     2229             on error undo, next
     2230             :
     2231               assign
     2232                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2233               .
     2234             end.
     2235             assign
     2236               v-diasize-browse-handle :width = v-browse-width
     2237             .
     2238             for each buf_temp-diasize-handle
     2239             on error undo, next
     2240             :
     2241               assign
     2242                 v-object-handle = buf_temp-diasize-handle.handle-value
     2243               .
     2244               if v-object-handle <> v-diasize-resize-button
     2245               then do:
     2246                 assign
     2247                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2248                 .
     2249               end.
     2250             end.
     2251             run diasize_position-resize-button in this-procedure .
     2252           end.
     2253           assign
     2254             v-diasize-change-size = false
     2255           .
     2256           leave move_block .
     2257         end.
     2258       end.
     2259       assign
     2260         v-diasize-need-full-display = true
     2261       .
     2262       if v-diasize-change-size = false
     2263       then do:
     2264         assign
     2265           v-diasize-change-size = true
     2266         .
     2267       end.
     2268       else do:
     2269         return .
     2270       end.
     2271       assign
     2272         v-frame-width = frame Dialog-Frame :width
     2273         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2274         v-browse-width = v-diasize-browse-handle :width
     2275       .
     2276       for each buf_temp-browse-handle
     2277         where buf_temp-browse-handle.browse-type = 'width':u
     2278       :
     2279         assign
     2280           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2281         .
     2282       end.
     2283       for each buf_temp-diasize-handle
     2284       :
     2285         delete buf_temp-diasize-handle .
     2286       end.
     2287       assign
     2288         v-field-group-handle = frame Dialog-Frame :first-child
     2289       .
     2290       do while valid-handle(v-field-group-handle)
     2291       :
     2292         assign
     2293           v-object-handle = v-field-group-handle :first-child
     2294         .
     2295         do while valid-handle(v-object-handle)
     2296         :
     2297           if  v-object-handle <> v-diasize-browse-handle :handle
     2298           and v-object-handle <> v-diasize-resize-button
     2299           and can-query(v-object-handle, "row")
     2300           and can-query(v-object-handle, "height")
     2301           and ( v-object-handle :col + v-object-handle :width
     2302                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2303               )
     2304           then do:
     2305             find first buf_temp-browse-handle
     2306               where buf_temp-browse-handle.browse-type   = 'width':u
     2307                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2308               no-error .
     2309             if available buf_temp-browse-handle
     2310             then do:
     2311             end.
     2312             else do:
     2313               create buf_temp-diasize-handle .
     2314               assign
     2315                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2316                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2317               .
     2318             end.
     2319           end.
     2320           assign
     2321             v-object-handle = v-object-handle :next-sibling
     2322           .
     2323         end.
     2324         assign
     2325           v-field-group-handle = v-field-group-handle :next-sibling
     2326         .
     2327       end.
     2328       do with frame Dialog-Frame
     2329       :
     2330         hide v-diasize-resize-button .
     2331         v-diasize-resize-button :row = 1.
     2332         v-diasize-resize-button :column = 1.
     2333       end.
     2334       if p-change-value > 0
     2335       then do:
     2336         if frame Dialog-Frame :scrollable = true
     2337         then do:
     2338           assign
     2339             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2340             no-error .
     2341           if error-status :error
     2342           or error-status :get-message(1) <> ""
     2343           then do:
     2344             undo move_block, retry move_block.
     2345           end.
     2346         end.
     2347         assign
     2348           frame Dialog-Frame :width = v-frame-width + p-change-value
     2349           no-error .
     2350         if error-status :error
     2351         or error-status :get-message(1) <> ""
     2352         then do:
     2353           undo move_block, retry move_block.
     2354         end.
     2355         assign
     2356           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2357         no-error .
     2358         if error-status :error
     2359         or error-status :get-message(1) <> ""
     2360         then do:
     2361           undo move_block, retry move_block.
     2362         end.
     2363         for each buf_temp-browse-handle
     2364           where buf_temp-browse-handle.browse-type = 'width':u
     2365         on error undo move_block, retry move_block
     2366         :
     2367           assign
     2368             buf_temp-browse-handle.browse-handle :width
     2369               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2370             no-error .
     2371           if error-status :error
     2372           or error-status :get-message(1) <> ""
     2373           then do:
     2374             undo move_block, retry move_block .
     2375           end.
     2376         end.
     2377         for each buf_temp-diasize-handle
     2378         on error undo move_block, retry move_block
     2379         :
     2380           assign
     2381             v-object-handle = buf_temp-diasize-handle.handle-value
     2382           .
     2383           if v-object-handle <> v-diasize-resize-button
     2384           then do:
     2385             assign
     2386               v-object-handle :col = v-object-handle :col + p-change-value
     2387               no-error .
     2388             if error-status :error
     2389             or error-status :get-message(1) <> ""
     2390             then do:
     2391               undo move_block, retry move_block .
     2392             end.
     2393           end.
     2394         end.
     2395       end.
     2396       else do:
     2397         for each buf_temp-diasize-handle
     2398         on error undo move_block, retry move_block
     2399         :
     2400           assign
     2401             v-object-handle = buf_temp-diasize-handle.handle-value
     2402           .
     2403           if v-object-handle <> v-diasize-resize-button
     2404           then do:
     2405             assign
     2406               v-object-handle :col = v-object-handle :col + p-change-value
     2407               no-error .
     2408             if error-status :error
     2409             or error-status :get-message(1) <> ""
     2410             then do:
     2411               undo move_block, retry move_block .
     2412             end.
     2413           end.
     2414         end.
     2415         for each buf_temp-browse-handle
     2416           where buf_temp-browse-handle.browse-type = 'width':u
     2417         on error undo move_block, retry move_block
     2418         :
     2419           assign
     2420             buf_temp-browse-handle.browse-handle :width
     2421               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2422             no-error .
     2423           if error-status :error
     2424           or error-status :get-message(1) <> ""
     2425           then do:
     2426             undo move_block, retry move_block .
     2427           end.
     2428         end.
     2429         assign
     2430           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2431           no-error .
     2432         if error-status :error
     2433         or error-status :get-message(1) <> ""
     2434         then do:
     2435           undo move_block, retry move_block.
     2436         end.
     2437         assign
     2438           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2439         no-error .
     2440         if error-status :error
     2441         or error-status :get-message(1) <> ""
     2442         then do:
     2443           undo move_block, retry move_block.
     2444         end.
     2445         if frame Dialog-Frame :scrollable = true
     2446         then do:
     2447           assign
     2448             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2449           no-error .
     2450           if error-status :error
     2451           or error-status :get-message(1) <> ""
     2452           then do:
     2453             undo move_block, retry move_block.
     2454           end.
     2455         end.
     2456       end.
     2457       if p-move-resize
     2458       then do:
     2459         run diasize_position-resize-button in this-procedure .
     2460       end.
     2461       if v-diasize-wndstore = true
     2462       then do:
     2463         if connected("ub") = true
     2464         then do:
     2465           define variable v-cntxt-db-num        as integer   no-undo .
     2466           define variable v-cntxt-userid        as character no-undo .
     2467           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2468                                             , OUTPUT v-cntxt-userid
     2469                                             ) .
     2470           run gbl/wndsizew.p
     2471             (input  v-cntxt-db-num
     2472             ,input  v-cntxt-userid
     2473             ,input  v-diasize-proc-name
     2474             ,input  'width':u
     2475             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2476             ) .
     2477         end.
     2478       end.
     2479     end.
     2480     assign
     2481       v-diasize-change-size = false
     2482     .
     2483   end procedure.
     2484   procedure diasize_set-width :
     2485     define input  parameter p-new-width  as decimal   no-undo .
     2486     define input  parameter p-move-resize as logical   no-undo .
     2487     do
     2488     on error undo, return error return-value
     2489     :
     2490       run diasize_change-width in this-procedure
     2491         (input  (p-new-width - frame Dialog-Frame :width)
     2492         ,input  p-move-resize
     2493         ) .
     2494     end.
     2495   end procedure.
     2496   procedure diasize_position-resize-button :
     2497     do with frame Dialog-Frame
     2498     :
     2499       hide v-diasize-resize-button .
     2500       assign
     2501         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2502                     - 1
     2503                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2504         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2505                     - 1
     2506                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2507       .
     2508       view v-diasize-resize-button .
     2509     end.
     2510   end procedure.
     2511   on alt-right anywhere
     2512   do:
     2513     run diasize_change-width in this-procedure
     2514       (input 1
     2515       ,input true
     2516       ) .
     2517     return no-apply .
     2518   end.
     2519   on alt-left anywhere
     2520   do:
     2521     run diasize_change-width in this-procedure
     2522       (input -1
     2523       ,input true
     2524       ) .
     2525     return no-apply .
     2526   end.
     2527   on alt-down anywhere
     2528   do:
     2529     run diasize_change-height in this-procedure
     2530       (input 1
     2531       ,input true
     2532       ) .
     2533     return no-apply .
     2534   end.
     2535   on alt-up anywhere
     2536   do:
     2537     run diasize_change-height in this-procedure
     2538       (input -1
     2539       ,input true
     2540       ) .
     2541     return no-apply .
     2542   end.
     2543   on alt-enter of frame Dialog-Frame
     2544   do:
     2545     run diasize_maximize in this-procedure
     2546       (input  ?
     2547       ).
     2548     return no-apply .
     2549   end.
     2550   procedure diasize_end-move :
     2551     do
     2552     on error undo, return error return-value
     2553     :
     2554       define variable v-row-delta as decimal   no-undo .
     2555       define variable v-col-delta as decimal   no-undo .
     2556       define variable v-new-row as decimal   no-undo .
     2557       define variable v-new-col as decimal   no-undo .
     2558       assign
     2559         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2560         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2561       .
     2562       assign
     2563         v-row-delta = v-new-row - frame Dialog-Frame :height
     2564         v-col-delta = v-new-col - frame Dialog-Frame :width
     2565       .
     2566       run diasize_change-height in this-procedure
     2567         (input v-row-delta
     2568         ,input true
     2569         ) .
     2570       run diasize_change-width in this-procedure
     2571         (input v-col-delta
     2572         ,input true
     2573         ) .
     2574     end.
     2575   end procedure.
     2576   procedure diasize_maximize :
     2577     define input  parameter p-action as logical   no-undo .
     2578     do
     2579     on error undo, return error return-value
     2580     :
     2581       if p-action = ?
     2582       then do:
     2583         if v-diasize-need-maximize = true
     2584         then do:
     2585           assign
     2586             p-action = true
     2587           .
     2588         end.
     2589         else do:
     2590           assign
     2591             p-action = false
     2592           .
     2593         end.
     2594       end.
     2595       if p-action = true
     2596       then do:
     2597         run diasize_change-height in this-procedure
     2598           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2599               - frame Dialog-Frame :height-chars
     2600           ,input true
     2601           ) .
     2602         run diasize_change-width in this-procedure
     2603           (input session :width-chars
     2604               - frame Dialog-Frame :width-chars
     2605           ,input true
     2606           ) .
     2607         assign
     2608           v-diasize-need-maximize = false
     2609         .
     2610       end.
     2611       else do:
     2612         run diasize_change-width in this-procedure
     2613           (input v-diasize-orig-frame-width
     2614               - frame Dialog-Frame :width-chars
     2615           ,input true
     2616           ) .
     2617         run diasize_change-height in this-procedure
     2618           (input v-diasize-orig-frame-height
     2619               - frame Dialog-Frame :height-chars
     2620           ,input true
     2621           ) .
     2622         assign
     2623           v-diasize-need-maximize = true
     2624         .
     2625       end.
     2626     end.
     2627   end procedure.
     2628   procedure diasize_restore-orig-size :
     2629     do
     2630     on error undo, return error return-value
     2631     :
     2632       assign
     2633         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2634         v-diasize-current-frame-height = frame Dialog-Frame :height
     2635       .
     2636       run diasize_set-height in this-procedure
     2637         (input  v-diasize-orig-frame-height
     2638         ,input  true
     2639         ) .
     2640       run diasize_set-width in this-procedure
     2641         (input  v-diasize-orig-frame-width
     2642         ,input  true
     2643         ) .
     2644     end.
     2645   end procedure.
     2646   procedure diasize_restore-current-size :
     2647     do
     2648     on error undo, return error return-value
     2649     :
     2650       run diasize_set-height in this-procedure
     2651         (input  v-diasize-current-frame-height
     2652         ,input  true
     2653         ) .
     2654       run diasize_set-width in this-procedure
     2655         (input  v-diasize-current-frame-width
     2656         ,input  true
     2657         ) .
     2658     end.
     2659   end procedure.
     2660   procedure diasize_set-browse-handle :
     2661     define input  parameter p-browse-handle as handle   no-undo .
     2662     define buffer buf_temp-browse-handle for temp-browse-handle .
     2663     do
     2664     on error undo, return error return-value
     2665     :
     2666       assign
     2667         v-diasize-browse-handle = p-browse-handle
     2668       .
     2669       for each buf_temp-browse-handle
     2670       on error undo, return error return-value
     2671       :
     2672         delete buf_temp-browse-handle .
     2673       end.
     2674     end.
     2675   end procedure.
     2676   procedure diasize_add_browse :
     2677     define input  parameter p-browse-type   as character no-undo .
     2678     define input  parameter p-browse-handle as handle    no-undo .
     2679     define buffer buf_temp-browse-handle for temp-browse-handle .
     2680     do
     2681     on error undo, return error return-value
     2682     :
     2683       assign
     2684         v-diasize-browse-number = v-diasize-browse-number + 1
     2685       .
     2686       create buf_temp-browse-handle .
     2687       assign
     2688         buf_temp-browse-handle.browse-type   = p-browse-type
     2689         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2690         buf_temp-browse-handle.browse-handle = p-browse-handle
     2691       .
     2692     end.
     2693   end procedure.
     2694   procedure diasize_init :
     2695     define variable v-default-value    as logical   no-undo .
     2696     define variable v-restore-saved    as logical   no-undo .
     2697     define variable v-resize-value-str as character no-undo .
     2698     do
     2699     on error undo, return error return-value
     2700     :
     2701       do with frame Dialog-Frame
     2702       :
     2703         assign
     2704           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2705           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2706           v-diasize-browse-handle     = browse br-dis-tot_ :handle
     2707         .
     2708         create button v-diasize-resize-button
     2709         assign
     2710           parent        = frame Dialog-Frame :first-child
     2711           label         = "s"
     2712           height-pixels = 16
     2713           width-pixels  = 16
     2714           visible       = true
     2715           sensitive     = true
     2716           movable       = true
     2717           triggers:
     2718             on end-move persistent run diasize_end-move in this-procedure .
     2719           end triggers.
     2720         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2721         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2722         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2723         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2724         assign
     2725           v-diasize-wndmax = false
     2726         .
     2727         if connected("ub") = true
     2728         then do:
     2729           define variable v-cntxt-db-num        as integer   no-undo .
     2730           define variable v-cntxt-userid        as character no-undo .
     2731           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2732                                             , OUTPUT v-cntxt-userid
     2733                                             ) .
     2734           run gbl/wndpar_r.p
     2735             (input  v-cntxt-db-num
     2736             ,input  v-cntxt-userid
     2737             ,input  'wndmax':U
     2738             ,output v-diasize-wndmax
     2739             ,output v-default-value
     2740             ) .
     2741         end.
     2742         assign
     2743           v-diasize-wndstore = false
     2744         .
     2745         if connected("ub") = true
     2746         then do:
     2747           run gbl/wndpar_r.p
     2748             (input  v-cntxt-db-num
     2749             ,input  v-cntxt-userid
     2750             ,input  'wndstore':U
     2751             ,output v-diasize-wndstore
     2752             ,output v-default-value
     2753             ) .
     2754         end.
     2755         assign
     2756           v-diasize-proc-name = entry(1, program-name(2), '.')
     2757         .
     2758         if v-diasize-wndstore = true
     2759         then do:
     2760           assign
     2761             v-restore-saved = false
     2762           .
     2763           if connected("ub") = true
     2764           then do:
     2765             run gbl/wndsizer.p
     2766               (input  v-cntxt-db-num
     2767               ,input  v-cntxt-userid
     2768               ,input  v-diasize-proc-name
     2769               ,input  'height':u
     2770               ,output v-resize-value-str
     2771               ) .
     2772             if v-resize-value-str <> '':U
     2773             then do:
     2774               run diasize_change-height in this-procedure
     2775                 (input  integer(v-resize-value-str)
     2776                 ,input  true
     2777                 ) .
     2778               assign
     2779                 v-restore-saved = true
     2780               .
     2781             end.
     2782           end.
     2783           if connected("ub") = true
     2784           then do:
     2785             run gbl/wndsizer.p
     2786               (input  v-cntxt-db-num
     2787               ,input  v-cntxt-userid
     2788               ,input  v-diasize-proc-name
     2789               ,input  'width':u
     2790               ,output v-resize-value-str
     2791               ) .
     2792             if v-resize-value-str <> '':U
     2793             then do:
     2794               run diasize_change-width in this-procedure
     2795                 (input  integer(v-resize-value-str)
     2796                 ,input  true
     2797                 ) .
     2798               assign
     2799                 v-restore-saved = true
     2800               .
     2801             end.
     2802           end.
     2803           if v-restore-saved <> true
     2804           then do:
     2805             if v-diasize-wndmax = true
     2806             then do:
     2807               run diasize_maximize in this-procedure
     2808                 (input  true
     2809                 ) .
     2810             end.
     2811           end.
     2812         end.
     2813         else do:
     2814           if v-diasize-wndmax = true
     2815           then do:
     2816             run diasize_maximize in this-procedure
     2817               (input  true
     2818               ) .
     2819           end.
     2820         end.
     2821       end.
     2822     end.
     2823   end procedure.
     2824   procedure diasize_need-full-display :
     2825     define output parameter p-need-full-display as logical   no-undo .
     2826     do
     2827     on error undo, return error return-value
     2828     :
     2829       assign
     2830         p-need-full-display = v-diasize-need-full-display
     2831       .
     2832       assign
     2833         v-diasize-need-full-display = false
     2834       .
     2835     end.
     2836   end procedure.
     2837   procedure get-context :
     2838      define output parameter p-db-num as integer          no-undo.
     2839      define output parameter p-user-id as character        no-undo.
     2840      define variable v-login               as character    no-undo.
     2841      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2842      define buffer buf_user-login  for ub.user-login .
     2843      do
     2844      on error undo, return error
     2845      :
     2846            FIND FIRST buf_sys-ctrl no-lock.
     2847            ASSIGN
     2848               v-login = USERID("ub")
     2849               p-db-num = buf_sys-ctrl.db-num
     2850            .
     2851            FIND FIRST buf_user-login
     2852                 WHERE buf_user-login.db-num = p-db-num
     2853                   AND buf_user-login.user-login = v-login
     2854                 no-lock
     2855                 no-error
     2856                 .
     2857            IF AVAILABLE buf_user-login
     2858            THEN DO:
     2859               assign
     2860                  p-user-id = buf_user-login.user-id
     2861               .
     2862            END.
     2863      end.
     2864   end procedure.
     2865       run diasize_init in this-procedure .
     2866   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2867   procedure set-filter-name :
     2868   define input parameter p-filter-name as character no-undo .
     2869     do with frame Dialog-Frame:
     2870       if p-filter-name > "" then do:
     2871         assign
     2872           frame Dialog-Frame:title
     2873             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2874         .
     2875         assign
     2876           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2877         .
     2878       end.
     2879       else do:
     2880         assign
     2881           b-sch :tooltip = ""
     2882         .
     2883       end.
     2884     end.
     2885   end procedure.
     2886   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2887   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2888   MAIN-BLOCK:
     2889   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2890      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2891     IF lookup(p-list-mode, 'все':U + chr(44) + "dtm-code" + chr(44) + "dt-code") = 0  THEN DO:
     2892       MESSAGE
     2893       vss-workfile vss-revision vss-description SKIP
     2894       "Неверное значение параметра p-list-mode" p-list-mode
     2895       VIEW-AS ALERT-BOX.
     2896       UNDO, RETURN ERROR.
     2897     END.
     2898     if lookup(p-region, 'объект':U + chr(44) + 'фирма':U + chr(44) + "global")  = 0 then do:
     2899           MESSAGE
     2900           vss-workfile vss-revision vss-description SKIP
     2901           "Неверное значение параметра p-region" p-region SKIP
     2902           "Нет хранилища данных"  p-region
     2903           VIEW-AS ALERT-BOX.
     2904           UNDO, RETURN ERROR.
     2905     end.
     2906     IF p-list-mode = "dtm-code" THEN DO:
     2907       FIND FIRST buf_prop-head NO-LOCK WHERE
     2908                 buf_prop-head.dtm-code = p-dtm-code NO-ERROR.
     2909       IF NOT AVAILABLE buf_prop-head THEN DO:
     2910           MESSAGE
     2911           vss-workfile vss-revision vss-description SKIP
     2912           "Неверное значение параметра p-dtm-code" p-dtm-code SKIP
     2913           "Нет объекта-операнда c кодом"  p-dtm-code
     2914           VIEW-AS ALERT-BOX.
     2915           UNDO, RETURN ERROR.
     2916       END.
     2917     END.
     2918     IF p-list-mode = "dt-code"
     2919     OR (p-list-mode = "dtm-code" AND p-dt-code > 0) THEN DO:
     2920       FIND FIRST buf_prop-ref NO-LOCK WHERE
     2921                 buf_prop-ref.dt-code = p-dt-code NO-ERROR.
     2922       IF NOT AVAILABLE buf_prop-ref THEN DO:
     2923           MESSAGE
     2924           vss-workfile vss-revision vss-description SKIP
     2925           "Неверное значение параметра p-dt-code" p-dt-code SKIP
     2926           "Нет итога c кодом"  p-dt-code
     2927           VIEW-AS ALERT-BOX.
     2928           UNDO, RETURN ERROR.
     2929       END.
     2930       IF p-list-mode = "dtm-code"
     2931       AND p-dtm-code <> buf_prop-ref.dtm-code THEN DO:
     2932           MESSAGE
     2933           vss-workfile vss-revision vss-description SKIP
     2934           "Неверное значение параметра p-dt-code" p-dt-code SKIP
     2935           substitute("Код итога &1 соответствует  коду объекта &2, хотя p-dtm-code = &3"
     2936                      , p-dt-code
     2937                      , buf_prop-ref.dtm-code
     2938                      , p-dtm-code)
     2939           VIEW-AS ALERT-BOX.
     2940           UNDO, RETURN ERROR.
     2941       END.
     2942     END.
     2943   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2944     run mainmenu_getcntxt in parparentproc
     2945       (output v-cntxt-db-num
     2946       ,output v-cntxt-userid
     2947       ,output v-cntxt-level
     2948       ,output v-cntxt-host-code-obj
     2949       ,output v-cntxt-obj-type
     2950       ,output v-cntxt-obj-code
     2951       ,output v-cntxt-db-num-obj
     2952       ,output v-cntxt-is-admin
     2953       ) .
     2954      v-list-mode = p-list-mode.
     2955     run Myenable in this-procedure .
     2956     v-rid-list = p-rid-list.
     2957     WAIT-FOR GO OF FRAME Dialog-Frame.
     2958   END.
     2959   RUN disable_UI.
     2960   PROCEDURE disable_UI :
     2961     HIDE FRAME Dialog-Frame.
     2962   END PROCEDURE.
     2963   PROCEDURE enable_UI :
     2964     DISPLAY rs-region f-dtm-code f-dtm-name f-dt-code f-sum-id rs-curr mark-num
     2965         WITH FRAME Dialog-Frame.
     2966     ENABLE b-quit b-mark b-sel rs-region b-lkp b-card b-sch B-print b-history
     2967            B-Help b-dtm-code b-dt-code rs-curr br-dis-tot_obj br-dis-tot_host
     2968            br-dis-tot_ mark-num
     2969         WITH FRAME Dialog-Frame.
     2970     VIEW FRAME Dialog-Frame.
     2971     OPEN QUERY br-dis-tot_ FOR EACH X_dis-tot_ NO-LOCK,            FIRST X_prop-ref_ NO-LOCK WHERE          X_prop-ref_.dt-code = X_dis-tot_.dt-code INDEXED-REPOSITION.    OPEN QUERY br-dis-tot_host FOR EACH X_dis-tot_host NO-LOCK,            FIRST X_prop-ref_host NO-LOCK WHERE          X_prop-ref_host.dt-code = X_dis-tot_host.dt-code INDEXED-REPOSITION.    OPEN QUERY br-dis-tot_obj FOR EACH X_dis-tot_obj NO-LOCK,            FIRST X_prop-ref_obj NO-LOCK WHERE          X_prop-ref_obj.dt-code = X_dis-tot_obj.dt-code INDEXED-REPOSITION.
     2972   END PROCEDURE.
     2973   PROCEDURE MyEnable :
     2974   DEFINE VARIABLE v-curr-r-b AS CHARACTER NO-UNDO.
     2975   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2976   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2977     (output v-curr-r-b
     2978     )  .
     2979   ASSIGN
     2980   rs-curr:RADIO-BUTTONS IN FRAME Dialog-Frame= "Нац.вал." + chr(44) + 'rubl':U + chr(44) +
     2981                           "Баз.вал." + chr(44) + 'base':U + chr(44) +
     2982                           "все" + chr(44) + 'все':U
     2983   rs-curr = v-curr-r-b
     2984   rs-region:RADIO-BUTTONS = "Объекты" + chr(44) + 'объект':U + chr(44) +
     2985                           "Фирмы" + chr(44) + 'фирма':U + chr(44) +
     2986                           "Глобально" + chr(44) + "global"
     2987   rs-region = (IF p-region = '':U
     2988                THEN 'объект':U
     2989                ELSE p-region)
     2990   .
     2991   if p-list-mode = "dtm-code" then do:
     2992     assign
     2993     f-dtm-code  = buf_prop-head.dtm-code
     2994     f-dtm-name  = buf_prop-head.prop-label
     2995     .
     2996     if p-dtm-code = 1 then do:
     2997       assign
     2998       X_prop-ref_.sum-id:visible in browse br-dis-tot_ = no
     2999       X_prop-ref_.caller_id:visible in browse br-dis-tot_ = no
     3000       X_prop-ref_host.sum-id:visible in browse br-dis-tot_host = no
     3001       X_prop-ref_host.caller_id:visible in browse br-dis-tot_host = no
     3002       X_prop-ref_obj.sum-id:visible in browse br-dis-tot_obj = no
     3003       X_prop-ref_obj.caller_id:visible in browse br-dis-tot_obj = no
     3004       .
     3005     end.
     3006     assign
     3007     X_prop-ref_.dtm-code:visible in browse br-dis-tot_ = no
     3008     X_prop-ref_host.dtm-code:visible in browse br-dis-tot_host = no
     3009     X_prop-ref_obj.dtm-code:visible in browse br-dis-tot_obj = no
     3010     .
     3011   end.
     3012   else do:
     3013     f-dtm-code = ?.
     3014   end.
     3015   if p-list-mode = "dt-code"
     3016   or (p-list-mode = "dtm-code" and p-dt-code > 0)
     3017   then do:
     3018     assign
     3019     f-dt-code  = buf_prop-ref.dtm-code
     3020     f-sum-id   = buf_prop-ref.sum-id
     3021     .
     3022   end.
     3023   else do:
     3024     f-dt-code = ?.
     3025   end.
     3026   display
     3027   f-dtm-code
     3028   f-dtm-name
     3029   f-dt-code
     3030   f-sum-id
     3031   rs-region
     3032   with frame Dialog-Frame .
     3033   ENABLE
     3034   rs-curr
     3035   rs-region
     3036   b-quit
     3037   b-lkp
     3038   B-Help
     3039   b-mark when lookup("b-mark", bttns) > 0
     3040   b-sel when lookup("b-sel", bttns) > 0
     3041   b-card
     3042   b-sch
     3043   b-print
     3044   b-history
     3045   b-dtm-code WHEN (p-list-mode <> "dtm-code")
     3046   b-dt-code WHEN (p-list-mode <> "dt-code"
     3047                   AND NOT (p-list-mode = "dtm-code" AND p-dt-code > 0)
     3048                   and NOT (p-list-mode = "dtm-code" AND p-dtm-code = 1)
     3049                   )
     3050   br-dis-tot_obj
     3051   br-dis-tot_host
     3052   br-dis-tot_
     3053   WITH FRAME Dialog-Frame.
     3054   VIEW FRAME Dialog-Frame.
     3055   run Openbr in this-procedure ( input yes, input no, input '':U).
     3056   APPLY "VALUE-CHANGED" to rs-curr.
     3057   END PROCEDURE.
     3058   PROCEDURE Openbr :
     3059   define input  parameter p-open-query     as logical   no-undo .
     3060   define input  parameter p-find-next      as logical   no-undo .
     3061   define input  parameter p-find-condition as character no-undo .
     3062   CASE rs-region:
     3063     WHEN 'объект':U THEN DO:
     3064       RUN Openbr_obj ( INPUT p-open-query
     3065                       ,INPUT p-find-next
     3066                       ,INPUT p-find-condition).
     3067       br-dis-tot_obj:move-to-top() in frame Dialog-Frame .
     3068       apply "ENTRY" to br-dis-tot_obj.
     3069       apply "VALUE-CHANGED" to br-dis-tot_obj.
     3070     END.
     3071     WHEN 'фирма':U THEN DO:
     3072       RUN Openbr_host ( INPUT p-open-query
     3073                         ,INPUT p-find-next
     3074                         ,INPUT p-find-condition).
     3075       br-dis-tot_host:move-to-top().
     3076       apply "ENTRY" to br-dis-tot_host.
     3077       apply "VALUE-CHANGED" to br-dis-tot_host.
     3078     END.
     3079     WHEN "global" THEN DO:
     3080       RUN Openbr_ ( INPUT p-open-query
     3081                         ,INPUT p-find-next
     3082                         ,INPUT p-find-condition).
     3083        br-dis-tot_:move-to-top().
     3084        apply "ENTRY" to br-dis-tot_.
     3085        apply "VALUE-CHANGED" to br-dis-tot_.
     3086     END.
     3087   END CASE.
     3088   END PROCEDURE.
     3089   PROCEDURE Openbr_ :
     3090   define input  parameter p-open-query     as logical   no-undo .
     3091   define input  parameter p-find-next      as logical   no-undo .
     3092   define input  parameter p-find-condition as character no-undo .
     3093   define variable l-query-was-opened as logical no-undo .
     3094   run waitfram-show in this-procedure ("Ждите...").
     3095   define variable sort-column-phrase as character no-undo .
     3096   case sort-column-name :
     3097     when "" then do:
     3098       assign
     3099         sort-column-phrase = ""
     3100       .
     3101     end.
     3102     otherwise do:
     3103       assign
     3104         sort-column-phrase = "by " + sort-column-name
     3105       .
     3106     end.
     3107   end case.
     3108   define variable l-open-query as logical   no-undo .
     3109   filter-point = filter-point0 + v-list-mode.
     3110   CASE v-list-mode :
     3111     WHEN 'все':U        THEN DO:
     3112       assign
     3113       filter-point-label = substitute("Все итоги по ДК по фирмам")
     3114       frame Dialog-Frame:title = filter-point-label
     3115       .
     3116   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3117   define variable  l-disable-where-21  as logical   no-undo .
     3118   define variable  l-filter-open-21    as logical   .
     3119   define variable  flt-rec-21       as recid     no-undo .
     3120   define variable  filter-name-21      as character no-undo .
     3121   define variable  where-phrase-21     as character no-undo .
     3122   define variable  sort-phrase-21      as character no-undo .
     3123   define variable  where-phrase-rus-21 as character no-undo .
     3124   define variable  sort-phrase-rus-21  as character no-undo .
     3125     run waitfram-show in this-procedure
     3126       (input "ЖДИТЕ ..."
     3127       ).
     3128   run gbl/flt-get.p
     3129     (input filter-point
     3130     ,output flt-rec-21
     3131     ,output filter-name-21
     3132     ,output where-phrase-21
     3133     ,output sort-phrase-21
     3134     ,output where-phrase-rus-21
     3135     ,output sort-phrase-rus-21
     3136     ).
     3137   if p-open-query then do:
     3138       run set-filter-name in this-procedure
     3139         (INPUT filter-name-21
     3140         ) no-error .
     3141     assign
     3142       l-filter-open-21 = false
     3143     .
     3144     if flt-rec-21 <> ?
     3145       or sort-column-phrase > ""
     3146     then do:
     3147       define variable  parameter-2-21 as character no-undo .
     3148       define variable  parameter-3-21 as character no-undo .
     3149       define variable  parameter-4-21 as character no-undo .
     3150       define variable  parameter-5-21 as character no-undo .
     3151       define variable  parameter-6-21 as character no-undo .
     3152       define variable  parameter-7-21 as character no-undo .
     3153         assign
     3154         parameter-3-21 =
     3155                                 "FOR EACH X_dis-tot_ NO-LOcK"
