     4760         parameter-4-37 =
     4761           (
     4762             if (" X_dis-tot_obj.dt-code = f-dt-code " + " " + where-phrase-37) <> ""
     4763             then  substitute('X_prop-ref_obj.dt-code = &1', f-dt-code)  + " " + where-phrase-37
     4764             else "true"
     4765           )
     4766         parameter-5-37 = (" " + "" + " " + substitute('  , FIRST X_prop-ref_obj NO-LOCK WHERE                                           X_prop-ref_obj.dt-code = X_dis-tot_obj.dt-code AND                                           X_prop-ref_obj.dtm-code = &1', f-dtm-code))
     4767         parameter-6-37 = if sort-phrase-37 = ''
     4768                              then
     4769           (
     4770           " " + "  " +
     4771             " " + sort-column-phrase +
     4772           " " + " "
     4773           )
     4774                              else
     4775           (
     4776           " " + "  " +
     4777             " " + sort-column-phrase +
     4778           " " + sort-phrase-37
     4779           )
     4780         parameter-7-37 =
     4781           " indexed-reposition  "
     4782       .
     4783       do
     4784       on stop undo, leave
     4785       on error undo, leave
     4786       :
     4787         assign
     4788           l-disable-where-37 =
     4789             (" X_dis-tot_obj.dt-code = f-dt-code " + " " + where-phrase-37 = "")
     4790         .
     4791         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4792                             ,input QUERY br-dis-tot_obj:handle
     4793                             ,input parameter-3-37
     4794                             ,input parameter-4-37
     4795                             ,input parameter-5-37
     4796                             ,input parameter-6-37
     4797                             ,input parameter-7-37
     4798                             )
     4799         .
     4800         assign
     4801           l-filter-open-37 = true
     4802         .
     4803       end.
     4804       if l-filter-open-37 = false then do:
     4805         message
     4806           "Ошибка при фильтрации / сортировке" skip
     4807           "Будут показаны записи без учета фильтра" skip
     4808           view-as alert-box .
     4809       end.
     4810       else do:
     4811           assign
     4812             l-query-was-opened = true
     4813           .
     4814       end.
     4815     end.
     4816     if l-filter-open-37 = false then do:
     4817       OPEN QUERY br-dis-tot_obj FOR EACH X_dis-tot_obj NO-LOcK
     4818         where  X_dis-tot_obj.dt-code = f-dt-code
     4819       , FIRST X_prop-ref_obj WHERE                                            X_prop-ref_Obj.dt-code = X_dis-tot_obj.dt-code
     4820         indexed-reposition
     4821     .
     4822         assign
     4823           l-query-was-opened = true
     4824         .
     4825     end.
     4826   end.
     4827   else do:
     4828     assign
     4829       v-doc-rec = recid( X_dis-tot_obj )
     4830     .
     4831     do
     4832     on stop undo, leave
     4833     on error undo, leave
     4834     :
     4835       if QUERY br-dis-tot_obj:handle:get-buffer-handle(1) = (buffer X_dis-tot_obj:handle) then do:
     4836         assign
     4837         parameter-2-37 = (if p-find-next then "true":u else "false":u )
     4838         parameter-4-37 =
     4839           "where ":u +  substitute('X_prop-ref_obj.dt-code = &1', f-dt-code)  + " ":u + where-phrase-37 + " ":u + p-find-condition + " " + ""
     4840         parameter-5-37 = "  "
     4841       .
     4842         run fltopend_fltfindd in this-procedure  (
     4843                             input this-procedure:handle
     4844                             ,input QUERY br-dis-tot_obj:handle
     4845                             ,input rowid(X_dis-tot_obj)
     4846                             ,input logical(parameter-2-37)
     4847                             ,input no-lock
     4848                             ,input (buffer X_dis-tot_obj:handle)
     4849                             ,input parameter-4-37
     4850                             ,input parameter-5-37
     4851                             ) no-error.
     4852         .
     4853         assign
     4854           v-doc-rec = integer(return-value)
     4855           v-fltopend-rowid[1] = ?
     4856         .
     4857       end.
     4858       else do:
     4859         assign
     4860         parameter-2-37 = (if p-find-next then "true":u else "false":u )
     4861         parameter-3-37 =  "FOR EACH X_dis-tot_obj NO-LOcK"
     4862         parameter-4-37 =
     4863           (
     4864             if (" X_dis-tot_obj.dt-code = f-dt-code " + " " + where-phrase-37) <> ""
     4865             then  substitute('X_prop-ref_obj.dt-code = &1', f-dt-code)  + " " + where-phrase-37
     4866             else "true"
     4867           )
     4868         parameter-5-37 = (" " + "" + " " + substitute('  , FIRST X_prop-ref_obj NO-LOCK WHERE                                           X_prop-ref_obj.dt-code = X_dis-tot_obj.dt-code AND                                           X_prop-ref_obj.dtm-code = &1', f-dtm-code) + " " + p-find-condition)
     4869         parameter-6-37 = if sort-phrase-37 = ''
     4870                              then
     4871           (
     4872           " " + "  " +
     4873             " " + sort-column-phrase +
     4874           " " + " "
     4875           )
     4876                              else
     4877           (
     4878           " " + "  " +
     4879             " " + sort-column-phrase +
     4880           " " + sort-phrase-37
     4881           )
     4882         parameter-7-37 =
     4883           " indexed-reposition  "
     4884       .
     4885         run fltopend_fltfindq in this-procedure  (
     4886                             input this-procedure:handle
     4887                             ,input QUERY br-dis-tot_obj:handle
     4888                             ,input logical(parameter-2-37)
     4889                             ,input no-lock
     4890                             ,input parameter-3-37
     4891                             ,input parameter-4-37
     4892                             ,input parameter-5-37
     4893                             ,input parameter-6-37
     4894                             ,input parameter-7-37
     4895                             ,output v-fltopend-rowid
     4896                             ) no-error.
     4897         .
     4898         v-doc-rec = ?.
     4899       end.
     4900       assign
     4901         l-query-was-opened = true
     4902       .
     4903     end.
     4904   end.
     4905     run waitfram-hide in this-procedure .
     4906     END.
     4907   END CASE.
     4908   if not p-open-query then
     4909   REPOSITION br-dis-tot_obj to recid v-doc-rec No-ERROR.
     4910   if not p-open-query and v-fltopend-rowid[1] <> ? then
     4911   query br-dis-tot_obj:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     4912   run waitfram-hide in this-procedure.
     4913   APPLY "ENTRY" TO br-dis-tot_obj.
     4914   APPLY "VALUE-CHANGED" TO br-dis-tot_obj in frame Dialog-Frame.
     4915   END PROCEDURE.
     4916   PROCEDURE Printproc :
     4917   DEFINE INPUT PARAMETER p-dtm-code AS INTEGER NO-UNDO.
     4918   DEFINE INPUT PARAMETER p-region AS CHARACTER NO-UNDO.
     4919   define variable  date_string        as character no-undo.
     4920   define variable  Line               as character no-undo.
     4921   define variable  for-time           as character no-undo .
     4922   define variable  accum-count        as integer   no-undo .
     4923   define variable  accum-gds-tot-base as decimal   no-undo .
     4924   define variable  accum-gds-tot-rubl as decimal   no-undo .
     4925   define variable  accum-gds-dis-base as decimal   no-undo .
     4926   define variable  accum-gds-dis-rubl as decimal   no-undo .
     4927   define variable  accum-pay-tot-base as decimal   no-undo .
     4928   define variable  accum-pay-tot-rubl as decimal   no-undo .
     4929   define variable  accum-num-chk      as integer   no-undo .
     4930   DEFINE FRAME dis-tot_
     4931   X_prop-ref_.sum-id COLUMN-LABEL "Идентификатор"
     4932   X_prop-ref_.caller_id COLUMN-LABEL "Доп!Идентификатор"
     4933   X_prop-ref_.dtm-code COLUMN-LABEL "Код!объекта-!операнда" format ">>9"
     4934   X_dis-tot_.d-card COLUMN-LABEL "№ ДК" FORMAT "X(19)"
     4935   X_dis-tot_.gds-tot-rubl COLUMN-LABEL "Сумма товарная!нац.вал." format "->>,>>>,>>>,>>>,>>9.99"
     4936   X_dis-tot_.gds-dis-rubl COLUMN-LABEL "Скидка товарная!нац.вал." format "->>,>>>,>>>,>>>,>>9.99"
     4937   X_dis-tot_.pay-tot-rubl COLUMN-LABEL "Сумма оплат!нац.вал." FORMAT "->>,>>>,>>>,>>>,>>>.<<"
     4938   X_dis-tot_.gds-tot-base COLUMN-LABEL "Сумма товарная!баз.вал." format "->>,>>>,>>>,>>>,>>9.99"
     4939   X_dis-tot_.gds-dis-base COLUMN-LABEL "Скидка товарная!баз.вал." format "->>,>>>,>>>,>>>,>>9.99"
     4940   X_dis-tot_.pay-tot-base COLUMN-LABEL "Сумма оплат!баз.вал." FORMAT "->>,>>>,>>>,>>>,>>>.<<"
     4941   X_dis-tot_.num-chk COLUMN-LABEL "Число чеков" format ">>>,>>9"
     4942   HEADER  date_string AT 5 format "X(35)"
     4943   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>>>9" SKIP
     4944   Line format "X(198)" AT 1
     4945   with width 232 down stream-io use-text    .
     4946   DEFINE FRAME dis-tot_host
     4947   X_prop-ref_host.sum-id COLUMN-LABEL "Идентификатор"
     4948   X_prop-ref_host.caller_id COLUMN-LABEL "Доп!Идентификатор"
     4949   X_prop-ref_host.dtm-code COLUMN-LABEL "Код!объекта-!операнда" format ">>9"
     4950   X_dis-tot_host.d-card COLUMN-LABEL "№ ДК" FORMAT "X(19)"
     4951   X_dis-tot_host.host-code COLUMN-LABEL "Код!фирмы" FORMAT ">>>>9"
     4952   X_dis-tot_host.gds-tot-rubl COLUMN-LABEL "Сумма товарная!нац.вал." format "->>,>>>,>>>,>>>,>>9.99"
     4953   X_dis-tot_host.gds-dis-rubl COLUMN-LABEL "Скидка товарная!нац.вал." format "->>,>>>,>>>,>>>,>>9.99"
     4954   X_dis-tot_host.pay-tot-rubl COLUMN-LABEL "Сумма оплат!нац.вал." FORMAT "->>,>>>,>>>,>>>,>>>.<<"
     4955   X_dis-tot_host.gds-tot-base COLUMN-LABEL "Сумма товарная!баз.вал." format "->>,>>>,>>>,>>>,>>9.99"
     4956   X_dis-tot_host.gds-dis-base COLUMN-LABEL "Скидка товарная!баз.вал." format "->>,>>>,>>>,>>>,>>9.99"
     4957   X_dis-tot_host.pay-tot-base COLUMN-LABEL "Сумма оплат!баз.вал." FORMAT "->>,>>>,>>>,>>>,>>>.<<"
     4958   X_dis-tot_host.num-chk COLUMN-LABEL "Число чеков" format ">>>,>>9"
     4959   HEADER  date_string AT 5 format "X(35)"
     4960   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>>>9" SKIP
     4961   Line format "X(198)" AT 1
     4962   with width 232 down stream-io use-text    .
     4963   DEFINE FRAME dis-tot_obj
     4964   X_prop-ref_obj.sum-id COLUMN-LABEL "Идентификатор"
     4965   X_prop-ref_obj.caller_id COLUMN-LABEL "Доп!Идентификатор"
     4966   X_prop-ref_obj.dtm-code COLUMN-LABEL "Код!объекта-!операнда" format ">>9"
     4967   X_dis-tot_obj.d-card COLUMN-LABEL "№ ДК" FORMAT "X(19)"
     4968   X_dis-tot_obj.obj-code COLUMN-LABEL "Код!объекта" FORMAT ">>>>9"
     4969   X_dis-tot_obj.obj-type COLUMN-LABEL "Тип!объекта" FORMAT "X(3)"
     4970   X_dis-tot_obj.gds-tot-rubl COLUMN-LABEL "Сумма товарная!нац.вал." format "->>,>>>,>>>,>>>,>>9.99"
     4971   X_dis-tot_obj.gds-dis-rubl COLUMN-LABEL "Скидка товарная!нац.вал." format "->>,>>>,>>>,>>>,>>9.99"
     4972   X_dis-tot_obj.pay-tot-rubl COLUMN-LABEL "Сумма оплат!нац.вал." FORMAT "->>,>>>,>>>,>>>,>>>.<<"
     4973   X_dis-tot_obj.gds-tot-base COLUMN-LABEL "Сумма товарная!баз.вал." format "->>,>>>,>>>,>>>,>>9.99"
     4974   X_dis-tot_obj.gds-dis-base COLUMN-LABEL "Скидка товарная!баз.вал." format "->>,>>>,>>>,>>>,>>9.99"
     4975   X_dis-tot_obj.pay-tot-base COLUMN-LABEL "Сумма оплат!баз.вал." FORMAT "->>,>>>,>>>,>>>,>>>.<<"
     4976   X_dis-tot_obj.num-chk COLUMN-LABEL "Число чеков" format ">>>,>>9"
     4977   HEADER  date_string AT 5 format "X(35)"
     4978   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>>>9" SKIP
     4979   Line format "X(198)" AT 1
     4980   with width 232 down stream-io use-text    .
     4981   Line = fill("-", 198).
     4982   date_string = cur-time-print() .
     4983   run prn-lib-open-stream  in this-procedure (
     4984                                                input parParentProc
     4985                                               ,input 43
     4986                                               ,input yes
     4987                                               ,input no
     4988                                               ).
     4989   PUT  STREAM PrnLibStream unformatted
     4990   SPACE(25) ( frame Dialog-Frame:title )
     4991   format "x(90)" SKIP(0)
     4992   (if f-dtm-code <> 0 then f-dtm-name else '':U) skip(0)
     4993   (if f-dt-code <> ? then f-sum-id else '':U)
     4994   .
     4995   FORM HEADER
     4996   Line format "X(177)" AT 1 SKIP
     4997   "Продолжение - на следующей странице" AT 30 SKIP
     4998   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     4999   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     5000   CASE p-region:
     5001     when "global" then do:
     5002       FORM with FRAME dis-tot_ .
     5003       run waitfram-show in this-procedure ( input "Ждите...").
     5004       GET next br-dis-tot_  no-lock.
     5005       DO WHILE available X_dis-tot_:
     5006         Display STREAM PrnLibStream
     5007         X_prop-ref_.sum-id
     5008         X_prop-ref_.caller_id
     5009         X_prop-ref_.dtm-code
     5010         X_dis-tot_.d-card
     5011         X_dis-tot_.gds-tot-rubl
     5012         X_dis-tot_.gds-dis-rubl
     5013         X_dis-tot_.pay-tot-rubl
     5014         X_dis-tot_.gds-tot-base
     5015         X_dis-tot_.gds-dis-base
     5016         X_dis-tot_.pay-tot-base
     5017         X_dis-tot_.num-chk
     5018         with FRAME dis-tot_ .
     5019         DOWN STREAM PrnLibStream 1 with FRAME dis-tot_ .
     5020         assign
     5021         accum-count = accum-count + 1
     5022         accum-gds-tot-base = accum-gds-tot-base + X_dis-tot_.gds-tot-base
     5023         accum-gds-tot-rubl = accum-gds-tot-rubl + X_dis-tot_.gds-tot-rubl
     5024         accum-gds-dis-base = accum-gds-dis-base + X_dis-tot_.gds-dis-base
     5025         accum-gds-dis-rubl = accum-gds-dis-rubl + X_dis-tot_.gds-dis-rubl
     5026         accum-pay-tot-base = accum-pay-tot-base + X_dis-tot_.pay-tot-base
     5027         accum-pay-tot-rubl = accum-pay-tot-rubl + X_dis-tot_.pay-tot-rubl
     5028         accum-num-chk = accum-num-chk + X_dis-tot_.num-chk
     5029         .
     5030         GET next br-dis-tot_ no-lock.
     5031       END.
     5032       UNDERLINE  STREAM PrnLibStream
     5033       X_prop-ref_.sum-id
     5034       X_prop-ref_.caller_id
     5035       X_prop-ref_.dtm-code
     5036       X_dis-tot_.d-card
     5037       X_dis-tot_.gds-tot-rubl
     5038       X_dis-tot_.gds-dis-rubl
     5039       X_dis-tot_.pay-tot-rubl
     5040       X_dis-tot_.gds-tot-base
     5041       X_dis-tot_.gds-dis-base
     5042       X_dis-tot_.pay-tot-base
     5043       X_dis-tot_.num-chk
     5044       with FRAME dis-tot_ .
     5045       DISPLAY STREAM PrnLibStream
     5046       "Итого" @ X_prop-ref_.sum-id
     5047       accum-count @ X_dis-tot_.d-card
     5048       accum-gds-tot-base @   X_dis-tot_.gds-tot-rubl
     5049       accum-gds-tot-rubl @   X_dis-tot_.gds-dis-rubl
     5050       accum-gds-dis-base @   X_dis-tot_.pay-tot-rubl
     5051       accum-gds-dis-rubl @   X_dis-tot_.gds-tot-base
     5052       accum-pay-tot-base @   X_dis-tot_.gds-dis-base
     5053       accum-pay-tot-rubl @   X_dis-tot_.pay-tot-base
     5054       accum-num-chk      @   X_dis-tot_.num-chk
     5055       with frame dis-tot_.
     5056     end.
     5057     when 'фирма':U then do:
     5058       FORM with FRAME dis-tot_host .
