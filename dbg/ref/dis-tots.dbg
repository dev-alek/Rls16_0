     5066         X_dis-tot_host.d-card
     5067         X_dis-tot_host.host-code
     5068         X_dis-tot_host.gds-tot-rubl
     5069         X_dis-tot_host.gds-dis-rubl
     5070         X_dis-tot_host.pay-tot-rubl
     5071         X_dis-tot_host.gds-tot-base
     5072         X_dis-tot_host.gds-dis-base
     5073         X_dis-tot_host.pay-tot-base
     5074         X_dis-tot_host.num-chk
     5075         with FRAME dis-tot_host .
     5076         DOWN STREAM PrnLibStream 1 with FRAME dis-tot_host .
