     5079         accum-gds-tot-base = accum-gds-tot-base + X_dis-tot_host.gds-tot-base
     5080         accum-gds-tot-rubl = accum-gds-tot-rubl + X_dis-tot_host.gds-tot-rubl
     5081         accum-gds-dis-base = accum-gds-dis-base + X_dis-tot_host.gds-dis-base
     5082         accum-gds-dis-rubl = accum-gds-dis-rubl + X_dis-tot_host.gds-dis-rubl
     5083         accum-pay-tot-base = accum-pay-tot-base + X_dis-tot_host.pay-tot-base
     5084         accum-pay-tot-rubl = accum-pay-tot-rubl + X_dis-tot_host.pay-tot-rubl
     5085         accum-num-chk = accum-num-chk + X_dis-tot_host.num-chk
     5086         .
     5087         GET next br-dis-tot_host no-lock.
     5088       END.
     5089       UNDERLINE  STREAM PrnLibStream
     5090       X_prop-ref_host.sum-id
     5091       X_prop-ref_host.caller_id
     5092       X_prop-ref_host.dtm-code
     5093       X_dis-tot_host.d-card
     5094       X_dis-tot_host.host-code
     5095       X_dis-tot_host.gds-tot-rubl
     5096       X_dis-tot_host.gds-dis-rubl
     5097       X_dis-tot_host.pay-tot-rubl
     5098       X_dis-tot_host.gds-tot-base
     5099       X_dis-tot_host.gds-dis-base
     5100       X_dis-tot_host.pay-tot-base
     5101       X_dis-tot_host.num-chk
     5102       with FRAME dis-tot_host .
     5103       DISPLAY STREAM PrnLibStream
     5104       "Итого" @ X_prop-ref_host.sum-id
     5105       accum-count @ X_dis-tot_host.d-card
     5106       accum-gds-tot-base @   X_dis-tot_host.gds-tot-rubl
     5107       accum-gds-tot-rubl @   X_dis-tot_host.gds-dis-rubl
     5108       accum-gds-dis-base @   X_dis-tot_host.pay-tot-rubl
     5109       accum-gds-dis-rubl @   X_dis-tot_host.gds-tot-base
     5110       accum-pay-tot-base @   X_dis-tot_host.gds-dis-base
     5111       accum-pay-tot-rubl @   X_dis-tot_host.pay-tot-base
     5112       accum-num-chk      @   X_dis-tot_host.num-chk
     5113       with frame dis-tot_host.
     5114     end.
     5115     when 'объект':U then do:
