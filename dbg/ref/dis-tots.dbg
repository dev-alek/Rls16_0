     5121         X_prop-ref_obj.sum-id
     5122         X_prop-ref_obj.caller_id
     5123         X_prop-ref_obj.dtm-code
     5124         X_dis-tot_obj.d-card
     5125         X_dis-tot_obj.obj-code
     5126         X_dis-tot_obj.obj-type
     5127         X_dis-tot_obj.gds-tot-rubl
     5128         X_dis-tot_obj.gds-dis-rubl
     5129         X_dis-tot_obj.pay-tot-rubl
     5130         X_dis-tot_obj.gds-tot-base
     5131         X_dis-tot_obj.gds-dis-base
     5132         X_dis-tot_obj.pay-tot-base
     5133         X_dis-tot_obj.num-chk
     5134         with FRAME dis-tot_obj .
     5135         DOWN STREAM PrnLibStream 1 with FRAME dis-tot_obj .
     5136         assign
     5137         accum-count = accum-count + 1
     5138         accum-gds-tot-base = accum-gds-tot-base + X_dis-tot_obj.gds-tot-base
     5139         accum-gds-tot-rubl = accum-gds-tot-rubl + X_dis-tot_obj.gds-tot-rubl
     5140         accum-gds-dis-base = accum-gds-dis-base + X_dis-tot_obj.gds-dis-base
     5141         accum-gds-dis-rubl = accum-gds-dis-rubl + X_dis-tot_obj.gds-dis-rubl
     5142         accum-pay-tot-base = accum-pay-tot-base + X_dis-tot_obj.pay-tot-base
     5143         accum-pay-tot-rubl = accum-pay-tot-rubl + X_dis-tot_obj.pay-tot-rubl
     5144         accum-num-chk = accum-num-chk + X_dis-tot_obj.num-chk
     5145         .
     5146         GET next br-dis-tot_obj no-lock.
     5147       END.
     5148       UNDERLINE  STREAM PrnLibStream
     5149       X_prop-ref_obj.sum-id
     5150       X_prop-ref_obj.caller_id
     5151       X_prop-ref_obj.dtm-code
     5152       X_dis-tot_obj.d-card
     5153       X_dis-tot_obj.obj-code
     5154       X_dis-tot_obj.obj-type
     5155       X_dis-tot_obj.gds-tot-rubl
     5156       X_dis-tot_obj.gds-dis-rubl
     5157       X_dis-tot_obj.pay-tot-rubl
     5158       X_dis-tot_obj.gds-tot-base
     5159       X_dis-tot_obj.gds-dis-base
     5160       X_dis-tot_obj.pay-tot-base
     5161       X_dis-tot_obj.num-chk
     5162       with FRAME dis-tot_obj .
     5163       DISPLAY STREAM PrnLibStream
     5164       "Итого" @ X_prop-ref_obj.sum-id
     5165       accum-count @ X_dis-tot_obj.d-card
     5166       accum-gds-tot-base @   X_dis-tot_obj.gds-tot-rubl
     5167       accum-gds-tot-rubl @   X_dis-tot_obj.gds-dis-rubl
     5168       accum-gds-dis-base @   X_dis-tot_obj.pay-tot-rubl
     5169       accum-gds-dis-rubl @   X_dis-tot_obj.gds-tot-base
     5170       accum-pay-tot-base @   X_dis-tot_obj.gds-dis-base
     5171       accum-pay-tot-rubl @   X_dis-tot_obj.pay-tot-base
     5172       accum-num-chk      @   X_dis-tot_obj.num-chk
     5173       with frame dis-tot_obj.
     5174     end.
     5175   end case.
     5176   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     5177   HIDE  STREAM PrnLibStream FRAME CheckList.
     5178   output  STREAM PrnLibStream CLOSE.
     5179   run waitfram-hide in this-procedure .
     5180   run prn-lib-prn-file in this-procedure (
     5181                                             input parParentProc
     5182                                             ,input 8
     5183                                             ).
     5184   END PROCEDURE.
     5185   PROCEDURE proc-b-link :
     5186   DEFINE INPUT PARAMETER p-option AS CHARACTER NO-UNDO.
     5187   DEFINE variable v-rid-list AS CHARACTER NO-undo.
     5188   CASE p-option:
     5189   END CASE.
     5190   END PROCEDURE.
     5191   PROCEDURE proc-b-sch :
     5192   DEFINE INPUT PARAMETER p-region AS CHARACTER NO-UNDO.
     5193   define variable loc-point as character no-undo .
     5194   define variable loc-label as character no-undo .
     5195   CASE p-region:
     5196     WHEN 'объект':U THEN DO:
     5197       run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', 'cli',
     5198       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5199       run fltfield-add in this-procedure('host-code', 'Фирма', '',
     5200       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5201       assign
     5202         tbl = 'dis-obj'
     5203         join-tbl = 'X_dis-tot_obj'
     5204         fld = ""
     5205         lab = ""
     5206         spr = ""
     5207         dim = '0'
     5208         loc-point = substitute('&1_obj', filter-point)
     5209         loc-label = substitute('&1 ОБъект', filter-point-label)
     5210         .
     5211     END.
     5212     WHEN 'фирма':U THEN DO:
     5213        run fltfield-add in this-procedure('host-code', 'Фирма', '',
     5214        input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5215        assign
     5216          tbl = 'dis-host'
     5217          join-tbl = 'X_dis-tot_host'
     5218          fld = ""
     5219          lab = ""
     5220          spr = ""
     5221          dim = '0'
     5222         loc-point = substitute('&1_host', filter-point)
     5223         loc-label = substitute('&1 Фирма', filter-point-label)
     5224          .
     5225     END.
     5226     WHEN "global" THEN DO:
     5227         assign
     5228           tbl = 'dis-host'
     5229           join-tbl = 'X_dis-tot_'
     5230           fld = ""
     5231           lab = ""
     5232           spr = ""
     5233           dim = '0'
     5234         loc-point = substitute('&1', filter-point)
     5235         loc-label = substitute('&1', filter-point-label)
     5236           .
     5237     END.
     5238   END CASE.
     5239   run fltfield-add in this-procedure('d-card', '№ карты', '',
     5240   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5241   run fltfield-add in this-procedure('gds-tot-base', 'Сум. тов. в ценах продажи баз вал.', '',
     5242   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5243   run fltfield-add in this-procedure('gds-tot-rubl', 'Сум. тов. в ценах продажи нац вал.', '',
     5244   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5245   run fltfield-add in this-procedure('gds-dis-base', 'Скидка в ценах продажи баз вал.', '',
     5246   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5247   run fltfield-add in this-procedure('gds-dis-rubl', 'Скидка в ценах продажи нац вал.', '',
     5248   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5249   run fltfield-add in this-procedure('pay-tot-base', 'Сумма оплат в баз вал.', '',
     5250   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5251   run fltfield-add in this-procedure('pay-tot-rubl', 'Сумма оплат в нац вал.', '',
     5252   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5253   run fltfield-add in this-procedure('num-chk', 'Кол-во чеков', '',
     5254   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5255   Filter-Block:
     5256   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     5257       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     5258       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     5259     run gbl/filter.w ( input parparentproc
     5260                      , INPUT (loc-point + chr(4) + loc-label)
     5261                      , INPUT tbl
     5262                      , INPUT join-tbl
     5263                      , INPUT fld
     5264                      , INPUT lab
     5265                      , INPUT spr
     5266                      , INPUT dim ).
     5267     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     5268   END.
     5269   END PROCEDURE.
