     1104   "Фирмы", "2",
     1105   "Глобально", "3"
     1106        SIZE 30 BY 1 NO-UNDO.
     1107   DEFINE QUERY br-dis-tot_ FOR
     1108                   X_dis-tot_,
     1109                   X_prop-ref_ SCROLLING.
     1110   DEFINE QUERY br-dis-tot_host FOR
     1111                   X_dis-tot_host,
     1112                   X_prop-ref_host SCROLLING.
     1113   DEFINE QUERY br-dis-tot_obj FOR X_dis-tot_obj, X_prop-ref_obj scrolling.
     1114   DEFINE BROWSE br-dis-tot_
     1115     QUERY br-dis-tot_ NO-LOCK DISPLAY
     1116         mark-string(recid(X_dis-tot_), v-rid-list) Format "X(1)" COLUMN-LABEL "*"
     1117   X_prop-ref_.sum-id COLUMN-LABEL "Идентификатор"
     1118   X_prop-ref_.caller_id COLUMN-LABEL "Доп!Идентификатор"
     1119   X_prop-ref_.dtm-code COLUMN-LABEL "Код!объекта-!операнда" format ">>9"
     1120   X_dis-tot_.d-card COLUMN-LABEL "№ ДК" FORMAT "X(19)"
     1121   X_dis-tot_.gds-tot-rubl COLUMN-LABEL "Сумма товарная!нац.вал." format "->>,>>>,>>>,>>>,>>9.99"
     1122   X_dis-tot_.gds-dis-rubl COLUMN-LABEL "Скидка товарная!нац.вал." format "->>,>>>,>>>,>>>,>>9.99"
     1123   X_dis-tot_.pay-tot-rubl COLUMN-LABEL "Сумма оплат!нац.вал." FORMAT "->>,>>>,>>>,>>>,>>>.<<"
     1124   X_dis-tot_.gds-tot-base COLUMN-LABEL "Сумма товарная!баз.вал." format "->>,>>>,>>>,>>>,>>9.99"
     1125   X_dis-tot_.gds-dis-base COLUMN-LABEL "Скидка товарная!баз.вал." format "->>,>>>,>>>,>>>,>>9.99"
     1126   X_dis-tot_.pay-tot-base COLUMN-LABEL "Сумма оплат!баз.вал." FORMAT "->>,>>>,>>>,>>>,>>>.<<"
     1127   X_dis-tot_.num-chk COLUMN-LABEL "Число чеков" format "->>>,>>9"
     1128       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 18.87 FIT-LAST-COLUMN.
     1129   DEFINE BROWSE br-dis-tot_host
     1130     QUERY br-dis-tot_host NO-LOCK DISPLAY
     1131         mark-string(recid(X_dis-tot_host), v-rid-list) Format "X(1)" COLUMN-LABEL "*"
     1132   X_prop-ref_host.sum-id COLUMN-LABEL "Идентификатор"
     1133   X_prop-ref_host.caller_id COLUMN-LABEL "Доп!Идентификатор"
     1134   X_prop-ref_host.dtm-code COLUMN-LABEL "Код!объекта-!операнда" format ">>9"
     1135   X_dis-tot_host.d-card COLUMN-LABEL "№ ДК" FORMAT "X(19)"
     1136   X_dis-tot_host.host-code COLUMN-LABEL "Код!фирмы" FORMAT ">>>>9"
     1137   X_dis-tot_host.gds-tot-rubl COLUMN-LABEL "Сумма товарная!нац.вал." format "->>,>>>,>>>,>>>,>>9.99"
     1138   X_dis-tot_host.gds-dis-rubl COLUMN-LABEL "Скидка товарная!нац.вал." format "->>,>>>,>>>,>>>,>>9.99"
     1139   X_dis-tot_host.pay-tot-rubl COLUMN-LABEL "Сумма оплат!нац.вал." FORMAT "->>,>>>,>>>,>>>,>>>.<<"
     1140   X_dis-tot_host.gds-tot-base COLUMN-LABEL "Сумма товарная!баз.вал." format "->>,>>>,>>>,>>>,>>9.99"
     1141   X_dis-tot_host.gds-dis-base COLUMN-LABEL "Скидка товарная!баз.вал." format "->>,>>>,>>>,>>>,>>9.99"
     1142   X_dis-tot_host.pay-tot-base COLUMN-LABEL "Сумма оплат!баз.вал." FORMAT "->>,>>>,>>>,>>>,>>>.<<"
     1143   X_dis-tot_host.num-chk COLUMN-LABEL "Число чеков" format "->>>,>>9"
     1144       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 18.87 FIT-LAST-COLUMN.
     1145   DEFINE BROWSE br-dis-tot_obj
     1146     QUERY br-dis-tot_obj NO-LOCK DISPLAY
     1147         mark-string(recid(X_dis-tot_obj), v-rid-list) Format "X(1)" COLUMN-LABEL "*"
     1148   X_prop-ref_obj.sum-id COLUMN-LABEL "Идентификатор"
     1149   X_prop-ref_obj.caller_id COLUMN-LABEL "Доп!Идентификатор"
     1150   X_prop-ref_obj.dtm-code COLUMN-LABEL "Код!объекта-!операнда" format ">>9"
     1151   X_dis-tot_obj.d-card COLUMN-LABEL "№ ДК" FORMAT "X(19)"
     1152   X_dis-tot_obj.obj-code COLUMN-LABEL "Код!объекта" FORMAT ">>>>9"
     1153   X_dis-tot_obj.obj-type COLUMN-LABEL "Тип!объекта" FORMAT "X(3)"
     1154   X_dis-tot_obj.gds-tot-rubl COLUMN-LABEL "Сумма товарная!нац.вал." format "->>,>>>,>>>,>>>,>>9.99"
     1155   X_dis-tot_obj.gds-dis-rubl COLUMN-LABEL "Скидка товарная!нац.вал." format "->>,>>>,>>>,>>>,>>9.99"
     1156   X_dis-tot_obj.pay-tot-rubl COLUMN-LABEL "Сумма оплат!нац.вал." FORMAT "->>,>>>,>>>,>>>,>>>.<<"
     1157   X_dis-tot_obj.gds-tot-base COLUMN-LABEL "Сумма товарная!баз.вал." format "->>,>>>,>>>,>>>,>>9.99"
     1158   X_dis-tot_obj.gds-dis-base COLUMN-LABEL "Скидка товарная!баз.вал." format "->>,>>>,>>>,>>>,>>9.99"
     1159   X_dis-tot_obj.pay-tot-base COLUMN-LABEL "Сумма оплат!баз.вал." FORMAT "->>,>>>,>>>,>>>,>>>.<<"
     1160   X_dis-tot_obj.num-chk COLUMN-LABEL "Число чеков" format "->>>,>>9"
     1161       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 18.87 FIT-LAST-COLUMN.
     1162   DEFINE FRAME Dialog-Frame
     1163        b-quit AT ROW 1 COL 1
     1164        b-mark AT ROW 1 COL 21 WIDGET-ID 12
     1165        b-sel AT ROW 1 COL 25 WIDGET-ID 10
     1166        rs-region AT ROW 1 COL 35 NO-LABEL WIDGET-ID 26
     1167        b-lkp AT ROW 1 COL 66 WIDGET-ID 6
     1168        b-card AT ROW 1 COL 76 WIDGET-ID 16
     1169        b-sch AT ROW 1 COL 86 WIDGET-ID 2
     1170        B-print AT ROW 1 COL 89 WIDGET-ID 20
     1171        b-history AT ROW 1 COL 92 WIDGET-ID 18
     1172        B-Help AT ROW 1 COL 95
     1173        f-dtm-code AT ROW 2 COL 1 WIDGET-ID 34
     1174        b-dtm-code AT ROW 2 COL 22.5 WIDGET-ID 32
     1175        f-dtm-name AT ROW 2 COL 25.5 NO-LABEL WIDGET-ID 30
     1176        f-dt-code AT ROW 3 COL 3 WIDGET-ID 36
     1177        b-dt-code AT ROW 3 COL 22.5 WIDGET-ID 38
     1178        f-sum-id AT ROW 3 COL 25.5 NO-LABEL WIDGET-ID 40
     1179        rs-curr AT ROW 3 COL 58 NO-LABEL WIDGET-ID 22
     1180        br-dis-tot_obj AT ROW 4 COL 1.5 WIDGET-ID 100
     1181        br-dis-tot_host AT ROW 4 COL 1.5 WIDGET-ID 200
     1182        br-dis-tot_ AT ROW 4 COL 1.5 WIDGET-ID 300
     1183        mark-num AT ROW 1 COL 9 COLON-ALIGNED NO-LABEL WIDGET-ID 14
     1184        SPACE(78.50) SKIP(21.21)
     1185       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1186            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1187            TITLE ""
     1188            CANCEL-BUTTON b-quit.
     1189   ASSIGN
     1190          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1191          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1192   ON GO OF FRAME Dialog-Frame
     1193   DO:
     1194     p-rid-list = v-rid-list.
     1195   END.
     1196   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1197   DO:
     1198     APPLY "END-ERROR":U TO SELF.
     1199   END.
     1200   ON CHOOSE OF b-card IN FRAME Dialog-Frame
     1201   DO:
     1202   DEFINE VARIABLE v-d-card AS CHARACTER NO-UNDO.
     1203   DEFINE variable v-ri as recid no-undo .
     1204   define buffer buf_dis-card for ub.dis-card.
     1205   CASE rs-region:
     1206     WHEN 'объект':U THEN DO:
     1207       IF NOT AVAILABLE X_dis-tot_obj THEN RETURN NO-APPLY.
     1208       v-d-card = X_dis-tot_obj.d-card.
     1209     END.
     1210     WHEN 'фирма':U THEN DO:
     1211       IF NOT AVAILABLE X_dis-tot_host THEN RETURN NO-APPLY.
     1212       v-d-card = X_dis-tot_host.d-card.
     1213     END.
     1214     WHEN "global" THEN DO:
     1215       IF NOT AVAILABLE X_dis-tot_ THEN RETURN NO-APPLY.
     1216       v-d-card = X_dis-tot_.d-card.
     1217     END.
     1218   END CASE.
     1219   find first buf_dis-card no-lock where
     1220              buf_dis-card.d-card = v-d-card no-error .
     1221   if avail buf_dis-card then do:
     1222     assign
     1223     v-ri = recid( buf_dis-card )
     1224    .
     1225     run ref/dcardi.w (
     1226                   input parparentproc
     1227                 , input 'ПРОСМОТР':U
     1228                 , input buf_dis-card.emitent-host-code
     1229                 , input p-curr-host-code
     1230                 , input p-curr-obj-type
     1231                 , input p-curr-obj-code
     1232                 , input ?
     1233                 , input-output v-ri ) .
     1234   END.
     1235   END.
     1236   ON CHOOSE OF b-dt-code IN FRAME Dialog-Frame
     1237   DO:
     1238   DEFINE variable v-ref-list AS CHARACTER NO-UNDO.
     1239   DEFINE BUFFER buf_prop-ref FOR ub.prop-ref.
     1240   run ref/proprefs.w (
     1241                   input parparentproc
     1242                 ,input 'b-sel'
     1243                 ,input 'dis-tot':U
     1244                 ,input (if f-dtm-code = ? then 0 else f-dtm-code)
     1245                 ,input '':U
     1246                 ,input '':U
     1247                 ,input-output  v-ref-list) no-error.
     1248   if error-status:error or v-ref-list = '':u then do:
     1249     v-list-mode = p-list-mode.
     1250     assign
     1251     f-dt-code = ?
     1252     f-sum-id = '':U.
     1253     DISPLAY
     1254     f-sum-id
     1255     f-dt-code
     1256     WITH FRAME Dialog-Frame.
     1257     run openbr in this-procedure ( input yes, input no, input '':U).
     1258     return.
     1259   end.
     1260   find first buf_prop-ref no-lock where
     1261             recid(buf_prop-ref) = integer(v-ref-list) no-error.
     1262   if not available buf_prop-ref then return.
     1263   if buf_prop-ref.dt-code = f-dtm-code then return no-apply.
     1264   ASSIGN
     1265   f-dt-code = buf_prop-ref.dt-code
     1266   f-sum-id = buf_prop-ref.sum-id.
     1267   DISPLAY
     1268   f-sum-id
     1269   f-dt-code
     1270   WITH FRAME Dialog-Frame.
     1271   v-list-mode ="dt-code".
     1272   run openbr in this-procedure ( input yes, input no, input '':U).
     1273   END.
     1274   ON CHOOSE OF b-dtm-code IN FRAME Dialog-Frame
     1275   DO:
     1276   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1277   DEFINE BUFFER buf_prop-head FOR ub.prop-head.
     1278    run rul/prop-head-s.w ( INPUT parparentproc
     1279                            ,INPUT "b-sel"
     1280                            ,input "general-view"
     1281                            ,input 'dis-card-type':U
     1282                            ,input-output v-rid-list ) NO-ERROR.
     1283    IF ERROR-STATUS:error OR v-rid-list = '':U THEN DO:
     1284       UNDO, RETURN NO-APPLY.
     1285    END.
     1286    FIND FIRST buf_prop-head NO-LOCK WHERE
     1287              recid(buf_prop-head) = INTEGER(v-rid-list) NO-ERROR.
     1288    IF NOT AVAILABLE buf_prop-head  THEN DO:
     1289     v-list-mode = p-list-mode.
     1290     run openbr in this-procedure ( input yes, input no, input '':U).
     1291     UNDO, RETURN NO-APPLY.
     1292    END.
     1293    if buf_prop-head.dtm-code = f-dtm-code then return no-apply.
     1294    assign
     1295    f-dtm-code = buf_prop-head.dtm-code
     1296    f-dtm-name = buf_prop-head.prop-label
     1297    .
     1298    display
     1299    f-dtm-code
     1300    f-dtm-name
     1301    with frame Dialog-Frame .
     1302    v-list-mode = "dtm-code".
     1303    run openbr in this-procedure ( input yes, input no, input '':U).
     1304   END.
     1305   ON CHOOSE OF b-history IN FRAME Dialog-Frame
     1306   DO:
     1307   define variable parref-list as character no-undo .
     1308   CASE rs-region:
     1309     when 'объект':U then do:
     1310       if available X_dis-tot_obj  then do:
     1311         run ref/cdchist.w (
     1312                           INPUT parparentproc
     1313                           ,input p-curr-host-code
     1314                           ,input p-curr-obj-type
     1315                           ,input p-curr-obj-code
     1316                           ,input "":U
     1317                           ,input "subject":U
     1318                           ,input X_dis-tot_obj.d-card
     1319                           ,input ?
     1320                           ,input X_dis-tot_obj.obj-type
     1321                           ,input X_dis-tot_obj.obj-code
     1322                           ,input X_dis-tot_obj.host-code
     1323                           ,input ?
     1324                           ,input "":U
     1325                           ,input 'dis-obj':U
     1326                           ,input ?
     1327                           ,input-output parref-list
     1328                       ) no-error .
     1329           apply "entry" to br-dis-tot_obj.
     1330        end.
     1331      end.
     1332      when 'фирма':U then do:
     1333        if available X_dis-tot_host then do:
     1334         run ref/cdchist.w (
     1335                             INPUT parparentproc
     1336                             ,input p-curr-host-code
     1337                             ,input p-curr-obj-type
     1338                             ,input p-curr-obj-code
     1339                             ,input "":U
     1340                             ,input "subject"
     1341                             ,input X_dis-tot_host.d-card
     1342                             ,input ?
     1343                             ,input '':U
     1344                             ,input 0
     1345                             ,input X_dis-tot_host.host-code
     1346                             ,input ?
     1347                             ,input "":U
     1348                             ,input 'dis-host':U
     1349                             ,input ?
     1350                             ,input-output parref-list
     1351                         ) no-error .
     1352           apply "entry" to br-dis-tot_host.
     1353         end.
     1354       end.
     1355       when "global" then do:
     1356        if available X_dis-tot_ then do:
     1357         run ref/cdchist.w (
     1358                             INPUT parparentproc
     1359                             ,input p-curr-host-code
     1360                             ,input p-curr-obj-type
     1361                             ,input p-curr-obj-code
     1362                             ,input "":U
     1363                             ,input "subject"
     1364                             ,input X_dis-tot_.d-card
     1365                             ,input ?
     1366                             ,input '':U
     1367                             ,input 0
     1368                             ,input 0
     1369                             ,input ?
     1370                             ,input "":U
     1371                             ,input 'dis-host':U
     1372                             ,input ?
     1373                             ,input-output parref-list
     1374                         ) no-error .
     1375           apply "entry" to br-dis-tot_host.
     1376         end.
     1377       END.
     1378     END CASE.
     1379   END.
     1380   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1381   DO:
     1382   define variable v-rec as recid no-undo.
     1383   DEFINE VARIABLE v-d-card AS CHARACTER NO-UNDO.
     1384   DEFINE variable v-ri as recid no-undo .
     1385   define buffer buf_dis-card for ub.dis-card.
     1386   CASE rs-region:
     1387       WHEN 'объект':U THEN DO:
     1388         IF NOT AVAILABLE X_dis-tot_obj THEN RETURN NO-APPLY.
     1389         v-d-card = X_dis-tot_obj.d-card.
     1390       END.
     1391       WHEN 'фирма':U THEN DO:
     1392         IF NOT AVAILABLE X_dis-tot_host THEN RETURN NO-APPLY.
     1393         v-d-card = X_dis-tot_host.d-card.
     1394       END.
     1395       WHEN "global" THEN DO:
     1396         IF NOT AVAILABLE X_dis-tot_ THEN RETURN NO-APPLY.
     1397         v-d-card = X_dis-tot_.d-card.
     1398       END.
     1399    END CASE.
     1400   find first buf_dis-card no-lock where
     1401              buf_dis-card.d-card = v-d-card no-error .
     1402   if avail buf_dis-card then do:
     1403     assign
     1404     v-ri = recid( buf_dis-card )
     1405    .
     1406     if buf_dis-card.emitent-host-code = p-curr-host-code
     1407     or buf_dis-card.emitent-host-code = 0 then do:
     1408         run ref/dc-view.w ( input parparentproc
     1409                       ,input p-curr-host-code
     1410                       ,input p-curr-obj-type
     1411                       ,input p-curr-obj-code
     1412                       ,input buf_dis-card.d-card
     1413                       ,input NO
     1414                       ,input NO
     1415                       ) NO-ERROR.
     1416     end.
     1417     else do:
     1418         message "Данная дисконтная карта принадлежит другой фирме - просмотр запрещен!"
     1419         view-as alert-box ERROR.
     1420     end.
     1421   end.
     1422   END.
     1423   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1424   DO:
     1425       define variable glog as logical no-undo .
     1426     if available X_dis-tot_obj then do:
     1427   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1428   define variable v-str-recid12 as character no-undo .
     1429   define variable v-num-entry12 as integer   no-undo .
     1430   assign
     1431     v-str-recid12 = trim( string( recid( X_dis-tot_obj ) , "->>>>>>>>>>>9":U ) )
     1432     v-num-entry12 = lookup( v-str-recid12 , v-rid-list )
     1433   .
     1434   if v-num-entry12 > 0 then do:
     1435     assign
     1436       entry( v-num-entry12, v-rid-list ) = "":U
     1437       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1438     .
     1439   end.
     1440   else do:
     1441     assign
     1442       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid12
     1443     .
     1444   end.
     1445     glog = br-dis-tot_obj:refresh() .
     1446     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1447         glog = br-dis-tot_obj:select-next-row ().
     1448         apply "VALUE-CHANGED" to br-dis-tot_obj in frame Dialog-Frame.
     1449     end.
     1450     if num-entries( v-rid-list ) = 0
     1451     then
     1452         hide mark-num in frame Dialog-Frame.
     1453     else
     1454         disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1455   end.
     1456   apply "entry" to br-dis-tot_obj in frame Dialog-Frame.
     1457   END.
     1458   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1459   DO:
     1460   define variable v-doc-rec as recid no-undo .
     1461    CASE rs-region:
     1462        WHEN 'объект':U THEN DO:
     1463         v-doc-rec = recid( X_dis-tot_obj ).
     1464         DO WHILE available X_dis-tot_obj :
     1465           GET prev br-dis-tot_obj.
     1466         END.
     1467         run PrintProc IN THIS-PROCEDURE ( f-dtm-code, rs-region) .
     1468         reposition br-dis-tot_obj to recid v-doc-rec no-error.
     1469         apply "entry" to br-dis-tot_obj in frame Dialog-Frame.
     1470      END.
     1471      WHEN 'фирма':U THEN DO:
     1472         v-doc-rec = recid( X_dis-tot_host ).
     1473         DO WHILE available X_dis-tot_host :
     1474             GET prev br-dis-tot_host.
     1475         END.
     1476         run PrintProc IN THIS-PROCEDURE ( f-dtm-code, rs-region) .
     1477         reposition br-dis-tot_host to recid v-doc-rec no-error.
     1478         apply "entry" to br-dis-tot_host in frame Dialog-Frame.
     1479     END.
     1480     WHEN "global" THEN DO:
     1481         v-doc-rec = recid( X_dis-tot_ ).
     1482         DO WHILE available X_dis-tot_ :
     1483             GET prev br-dis-tot_.
     1484         END.
     1485         run PrintProc IN THIS-PROCEDURE ( f-dtm-code, rs-region) .
     1486         reposition br-dis-tot_ to recid v-doc-rec no-error.
     1487         apply "entry" to br-dis-tot_ in frame Dialog-Frame.
     1488     END.
     1489    END CASE.
     1490   END.
     1491   ON CHOOSE OF b-sch IN FRAME Dialog-Frame
     1492   DO:
     1493     RUN proc-b-sch IN THIS-PROCEDURE (INPUT rs-region) NO-ERROR.
     1494     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1495   END.
     1496   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1497   DO:
     1498     if available X_dis-tot_obj then do:
     1499       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1500       then  v-rid-list = string( recid( X_dis-tot_obj ) ) .
     1501     end.
     1502   END.
     1503   ON VALUE-CHANGED OF rs-curr IN FRAME Dialog-Frame
     1504   DO:
     1505     ASSIGN
     1506     rs-curr.
     1507     CASE rs-curr:
     1508       WHEN 'rubl':U THEN DO:
     1509           ASSIGN
     1510           X_dis-tot_.gds-tot-rubl:VISIBLE IN BROWSE br-dis-tot_ = YES
     1511           X_dis-tot_.gds-dis-rubl:VISIBLE IN BROWSE br-dis-tot_ = YES
     1512           X_dis-tot_.pay-tot-rubl:VISIBLE IN BROWSE br-dis-tot_ = YES
     1513           X_dis-tot_.gds-tot-base:VISIBLE IN BROWSE br-dis-tot_ = NO
     1514           X_dis-tot_.gds-dis-base:VISIBLE IN BROWSE br-dis-tot_ = NO
     1515           X_dis-tot_.pay-tot-base:VISIBLE IN BROWSE br-dis-tot_ = NO
     1516           X_dis-tot_host.gds-tot-rubl:VISIBLE IN BROWSE br-dis-tot_host = YES
     1517           X_dis-tot_host.gds-dis-rubl:VISIBLE IN BROWSE br-dis-tot_host = YES
     1518           X_dis-tot_host.pay-tot-rubl:VISIBLE IN BROWSE br-dis-tot_host = YES
     1519           X_dis-tot_host.gds-tot-base:VISIBLE IN BROWSE br-dis-tot_host = NO
     1520           X_dis-tot_host.gds-dis-base:VISIBLE IN BROWSE br-dis-tot_host = NO
     1521           X_dis-tot_host.pay-tot-base:VISIBLE IN BROWSE br-dis-tot_host = NO
     1522           X_dis-tot_obj.gds-tot-rubl:VISIBLE IN BROWSE br-dis-tot_Obj = YES
     1523           X_dis-tot_obj.gds-dis-rubl:VISIBLE IN BROWSE br-dis-tot_Obj = YES
     1524           X_dis-tot_obj.pay-tot-rubl:VISIBLE IN BROWSE br-dis-tot_Obj = YES
     1525           X_dis-tot_obj.gds-tot-base:VISIBLE IN BROWSE br-dis-tot_Obj = NO
     1526           X_dis-tot_obj.gds-dis-base:VISIBLE IN BROWSE br-dis-tot_Obj = NO
     1527           X_dis-tot_obj.pay-tot-base:VISIBLE IN BROWSE br-dis-tot_Obj = NO
     1528           .
     1529       END.
     1530       WHEN 'base':U THEN DO:
     1531           ASSIGN
     1532           X_dis-tot_.gds-tot-rubl:VISIBLE IN BROWSE br-dis-tot_ = NO
     1533           X_dis-tot_.gds-dis-rubl:VISIBLE IN BROWSE br-dis-tot_ = NO
     1534           X_dis-tot_.pay-tot-rubl:VISIBLE IN BROWSE br-dis-tot_ = NO
     1535           X_dis-tot_.gds-tot-base:VISIBLE IN BROWSE br-dis-tot_ = YES
     1536           X_dis-tot_.gds-dis-base:VISIBLE IN BROWSE br-dis-tot_ = YES
     1537           X_dis-tot_.pay-tot-base:VISIBLE IN BROWSE br-dis-tot_ = YES
     1538           X_dis-tot_host.gds-tot-rubl:VISIBLE IN BROWSE br-dis-tot_host = NO
     1539           X_dis-tot_host.gds-dis-rubl:VISIBLE IN BROWSE br-dis-tot_host = NO
     1540           X_dis-tot_host.pay-tot-rubl:VISIBLE IN BROWSE br-dis-tot_host = NO
     1541           X_dis-tot_host.gds-tot-base:VISIBLE IN BROWSE br-dis-tot_host = YES
     1542           X_dis-tot_host.gds-dis-base:VISIBLE IN BROWSE br-dis-tot_host = YES
     1543           X_dis-tot_host.pay-tot-base:VISIBLE IN BROWSE br-dis-tot_host = YES
     1544           X_dis-tot_obj.gds-tot-rubl:VISIBLE IN BROWSE br-dis-tot_Obj = NO
     1545           X_dis-tot_obj.gds-dis-rubl:VISIBLE IN BROWSE br-dis-tot_Obj = NO
     1546           X_dis-tot_obj.pay-tot-rubl:VISIBLE IN BROWSE br-dis-tot_Obj = NO
     1547           X_dis-tot_obj.gds-tot-base:VISIBLE IN BROWSE br-dis-tot_Obj = YES
     1548           X_dis-tot_obj.gds-dis-base:VISIBLE IN BROWSE br-dis-tot_Obj = YES
     1549           X_dis-tot_obj.pay-tot-base:VISIBLE IN BROWSE br-dis-tot_Obj = YES
     1550           .
     1551       END.
     1552       OTHERWISE DO:
     1553           ASSIGN
     1554           X_dis-tot_.gds-tot-rubl:VISIBLE IN BROWSE br-dis-tot_ = YES
     1555           X_dis-tot_.gds-dis-rubl:VISIBLE IN BROWSE br-dis-tot_ = YES
     1556           X_dis-tot_.pay-tot-rubl:VISIBLE IN BROWSE br-dis-tot_ = YES
     1557           X_dis-tot_.gds-tot-base:VISIBLE IN BROWSE br-dis-tot_ = YES
     1558           X_dis-tot_.gds-dis-base:VISIBLE IN BROWSE br-dis-tot_ = YES
     1559           X_dis-tot_.pay-tot-base:VISIBLE IN BROWSE br-dis-tot_ = YES
     1560           X_dis-tot_host.gds-tot-rubl:VISIBLE IN BROWSE br-dis-tot_host = YES
     1561           X_dis-tot_host.gds-dis-rubl:VISIBLE IN BROWSE br-dis-tot_host = YES
     1562           X_dis-tot_host.pay-tot-rubl:VISIBLE IN BROWSE br-dis-tot_host = YES
     1563           X_dis-tot_host.gds-tot-base:VISIBLE IN BROWSE br-dis-tot_host = yes
     1564           X_dis-tot_host.gds-dis-base:VISIBLE IN BROWSE br-dis-tot_host = yes
     1565           X_dis-tot_host.pay-tot-base:VISIBLE IN BROWSE br-dis-tot_host = yes
     1566           X_dis-tot_obj.gds-tot-rubl:VISIBLE IN BROWSE br-dis-tot_Obj = YES
     1567           X_dis-tot_obj.gds-dis-rubl:VISIBLE IN BROWSE br-dis-tot_Obj = YES
     1568           X_dis-tot_obj.pay-tot-rubl:VISIBLE IN BROWSE br-dis-tot_Obj = YES
     1569           X_dis-tot_obj.gds-tot-base:VISIBLE IN BROWSE br-dis-tot_Obj = yes
     1570           X_dis-tot_obj.gds-dis-base:VISIBLE IN BROWSE br-dis-tot_Obj = yes
     1571           X_dis-tot_obj.pay-tot-base:VISIBLE IN BROWSE br-dis-tot_Obj = yes
     1572           .
     1573       END.
     1574     END CASE.
     1575   END.
     1576   ON VALUE-CHANGED OF rs-region IN FRAME Dialog-Frame
     1577   DO:
     1578     ASSIGN
     1579     rs-region.
     1580     RUN Openbr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
