        1   DEFINE TEMP-TABLE temp-odisc NO-UNDO LIKE ub.dis-dct-rule
        2          field rule-label as character.
        3   DEFINE TEMP-TABLE tt0-dis-dct-rule NO-UNDO LIKE ub.dis-dct-rule.
        4   define input parameter parparentproc as widget-handle no-undo .
        5   define input parameter p-mode as character no-undo.
        6   define input parameter p-type as character no-undo.
        7   define input parameter p-emitent-host-code as integer no-undo .
        8   define input parameter p-host-code like ub.sysconf.host-code no-undo .
        9   define input parameter p-obj-type like ub.clients.obj-type no-undo.
       10   define input parameter p-obj-code like ub.clients.obj-code no-undo.
       11   define input parameter p-pos-type as character no-undo .
       12   define input parameter p-discnt-role-list as character no-undo .
       13   define INPUT-OUTPUT parameter table for tt0-dis-dct-rule.
       14   define variable vss-revision    as character no-undo init "$Revision$":U .
       15   define variable vss-author      as character no-undo init "$Author$":U .
       16   define variable vss-date        as character no-undo init "$Date$":U .
       17   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       18   define variable vss-archive     as character no-undo init "$Archive$":U .
       19   define variable vss-description as character no-undo init "Скидки на тип ДК".
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define new global shared variable g#library  as handle no-undo .
       79   define new global shared variable g#library2 as handle no-undo .
       80   procedure proc-alt-shift-f2:
       81     if not ibs.th.gbl.gbl-var:rcode
       82   then
       83     run gbl\inidebug.p .
       84   end.
       85   procedure proc-alt-shift-f3:
       86     run gbl/prvssinf.p
       87       ( input this-procedure
       88       ) .
       89   end.
       90   define variable v-inform-launched as logical no-undo initial false .
       91   procedure proc-alt-shift-f4:
       92     define variable v-action as character no-undo .
       93     if v-inform-launched = false then do:
       94       assign
       95         v-inform-launched = true
       96       .
       97       run gbl/d-inform.w
       98         (  input self
       99         ,  input this-procedure
      100         , output v-action
      101         ) no-error .
      102       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      103       assign
      104         v-inform-launched = false
      105       .
      106     end.
      107   end.
      108   procedure proc-alt-f1:
      109     run gbl/corrhelp.p
      110       (input this-procedure
      111       ) .
      112   end .
      113   on alt-shift-f2 anywhere do:
      114     run proc-alt-shift-f2.
      115   end.
      116   on alt-shift-f3 anywhere do:
      117     run proc-alt-shift-f3 in this-procedure .
      118   end.
      119   on alt-shift-f4 anywhere do:
      120     run proc-alt-shift-f4 in this-procedure.
      121   end.
      122   on alt-f1 anywhere do:
      123     run proc-alt-f1 in this-procedure .
      124   end.
      125   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      126     define variable v-cntxt-db-num        as integer   no-undo .
      127     define variable v-cntxt-userid        as character no-undo .
      128     define variable v-cntxt-level         as character no-undo .
      129     define variable v-cntxt-host-code-obj as integer   no-undo .
      130     define variable v-cntxt-obj-type      as character no-undo .
      131     define variable v-cntxt-obj-code      as integer   no-undo .
      132     define variable v-cntxt-db-num-obj    as integer   no-undo .
      133     define variable v-cntxt-is-admin      as logical   no-undo .
      134   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      135   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      136   define temp-table temp-drt-prop no-undo like ub.drt-prop.
      137   procedure disrules-fill-properties:
      138   define input  parameter p-templ-rl-root as integer   no-undo .
      139   define buffer buf_drt-prop for ub.drt-prop.
      140   define buffer buf_temp-drt-prop for temp-drt-prop.
      141   do
      142   on error undo, return error return-value
      143   :
      144     for each buf_temp-drt-prop:
      145       delete buf_temp-drt-prop.
      146     end.
      147     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
      148       create buf_temp-drt-prop.
      149       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      150     end.
      151   end.
      152   end procedure.
      153   ~
      154   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      155   procedure discfgru-check :
      156   define input parameter p-table-name as character no-undo .
      157   define input parameter p-templ-rl-root as integer no-undo .
      158   define input parameter p-time-templ-rl-root as integer no-undo .
      159   define input parameter p-pos-type as character no-undo .
      160   define output parameter p-disnct-role as character no-undo .
      161   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      162     do
      163     on error undo, return error return-value
      164     :
      165       find first buf_dis-cfg-rule no-lock where
      166               buf_dis-cfg-rule.table-name = p-table-name
      167           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
      168           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
      169           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
      170       if not available buf_dis-cfg-rule
      171       or p-pos-type = "":U
      172       then do:
      173          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
      174                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
      175                                  , p-templ-rl-root
      176                                  , (if p-time-templ-rl-root = ?
      177                                     then '':U
      178                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
      179                                     )
      180                                  ).
      181       end.
      182       assign
      183       p-disnct-role = buf_dis-cfg-rule.discnt-role
      184       .
      185     end.
      186   end procedure.
      187   procedure disdctru-name :
      188   define buffer buf_dis-rule for ub.dis-rule.
      189   do
      190     on error undo, return error
      191     :
      192     define input  parameter p-templ-rl-root  as integer no-undo .
      193     define output parameter p-label          as character no-undo .
      194     find first buf_dis-rule no-lock where
      195               buf_dis-rule.rule-num = p-templ-rl-root no-error.
      196     if available buf_dis-rule then do:
      197       p-label = buf_dis-rule.des.
      198     end.
      199     else do:
      200       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
      201     end.
      202   end.
      203   end procedure.
      204   function disdctru-get-disc-label returns character ( input p-templ-rl-root as integer):
      205   define variable v-rule-label as character no-undo .
      206   run disdctru-name in this-procedure ( input p-templ-rl-root
      207                                        ,output v-rule-label) no-error.
      208   return v-rule-label.
      209   end function.
      210   function disdctru-get-disc-role-label returns character ( input p-discnt-role as character):
      211   define variable v-rule-label as character no-undo .
      212   return entry (lookup (p-discnt-role, 'calc-d-pcnt,calc-cash-d-pcnt,calc-categ,dis-tot-flag,def-categ,def-pcnt,def-cash-pcnt':u) + 1, ',' + 'Расчет %скидки ДК на товар,Расчет %скидки ДК на итог,Расчет категории ДК,Участие в итогах по ДК,Категория ДК по умолчанию,% скидки ДК на товар по умолч.,% скидки ДК на итог по умолч.':u).
      213   end function.
      214   procedure disdctru-write :
      215     do
      216     on error undo, return error
      217     :
      218       define input parameter p-type           like ub.dis-dct-rule.type       no-undo .
      219       define input parameter p-emitent-host-code      like ub.dis-dct-rule.emitent-host-code  no-undo .
      220       define input parameter p-host-code      like ub.dis-dct-rule.host-code  no-undo .
      221       define input parameter p-obj-type       like ub.dis-dct-rule.obj-type   no-undo .
      222       define input parameter p-obj-code       like ub.dis-dct-rule.obj-code   no-undo .
      223       define input parameter p-pos-type       like ub.dis-dct-rule.pos-type   no-undo .
      224       define input parameter p-discnt-role    like ub.dis-dct-rule.discnt-role no-undo .
      225       define input parameter p-templ-rl-root  like ub.dis-dct-rule.templ-rl-root  no-undo .
      226       define input parameter p-time-templ-rl-root  like ub.dis-dct-rule.time-templ-rl-root  no-undo .
      227       define input parameter p-rule-num       like ub.dis-dct-rule.rule-num    no-undo .
      228       define input parameter p-NONUNIQUE as character no-undo .
      229       define buffer buf_dis-dct-rule for ub.dis-dct-rule .
      230       define buffer lock_dis-dct-rule for ub.dis-dct-rule .
      231       define buffer buf_dis-rule for ub.dis-rule.
      232       define variable v-label          as character no-undo .
      233       define variable v-discnt-role as character no-undo .
      234       run discfgru-check in this-procedure (
      235                                             input 'dis-dct-rule':U
      236                                            ,input p-templ-rl-root
      237                                            ,input p-time-templ-rl-root
      238                                            ,input p-pos-type
      239                                            ,output v-discnt-role
      240                                             ) no-error .
      241       if error-status :error then do:
      242         undo, return error return-value .
      243       end.
      244       if p-discnt-role = ? then do:
      245         p-discnt-role = v-discnt-role.
      246       end.
      247       if p-discnt-role <> v-discnt-role then do:
      248         undo, return error substitute("Тип ДК &1 код валюты &2 фирма &3 &4 место использ. &5 скидка типа &6&7не может быть по шаблону &8 и расписанию &9"
      249                                 ,p-type
      250                                 ,p-emitent-host-code
      251                                 ,p-host-code
      252                                 ,p-obj-type + string(p-obj-code)
      253                                 ,p-pos-type
      254                                 ,entry (lookup (p-discnt-role, 'calc-d-pcnt,calc-cash-d-pcnt,calc-categ,dis-tot-flag,def-categ,def-pcnt,def-cash-pcnt':u) + 1, ',' + 'Расчет %скидки ДК на товар,Расчет %скидки ДК на итог,Расчет категории ДК,Участие в итогах по ДК,Категория ДК по умолчанию,% скидки ДК на товар по умолч.,% скидки ДК на итог по умолч.':u)
      255                                 ,chr(10)
      256                                 ,p-templ-rl-root
      257                                 ,p-rule-num).
      258       end.
      259       if p-pos-type = ? then do:
      260   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      261   define variable v-param-type4 as character no-undo .
      262   define variable v-value-date4 as date no-undo .
      263   define variable v-value-decimal4 as decimal no-undo .
      264   define variable v-value-integer4 as INTEGER no-undo .
      265   define variable v-value-logical4 AS LOGICAL no-undo .
      266   define variable v-tth4 as handle no-undo .
      267   run adm/shattri.p (
      268       input "get":U
      269       ,input  p-obj-type
      270       ,input  p-obj-code
      271       ,input  'cd-sending':U
      272       ,input  'dflt-cd':U
      273       ,output p-pos-type
      274       ,output v-value-date4
      275       ,output v-value-decimal4
      276       ,output v-value-integer4
      277       ,output v-value-logical4
      278       ,output v-param-type4
      279       ,INPUT-OUTPUT table-handle v-tth4
      280       )  .
      281   delete object v-tth4 no-error.
      282       end.
      283       find first buf_dis-rule no-lock where
      284                 buf_dis-rule.rule-num = p-rule-num no-error.
      285       if not available buf_Dis-rule then do:
      286         undo, return error substitute("Тип ДК &1 код валюты &2 фирма &3 &4 место использ. &5 скидка типа &6&7не найдено правило скидки &9"
      287                                 ,p-type
      288                                 ,p-emitent-host-code
      289                                 ,p-host-code
      290                                 ,p-obj-type + string(p-obj-code)
      291                                 ,p-pos-type
      292                                 ,entry (lookup (p-discnt-role, 'calc-d-pcnt,calc-cash-d-pcnt,calc-categ,dis-tot-flag,def-categ,def-pcnt,def-cash-pcnt':u) + 1, ',' + 'Расчет %скидки ДК на товар,Расчет %скидки ДК на итог,Расчет категории ДК,Участие в итогах по ДК,Категория ДК по умолчанию,% скидки ДК на товар по умолч.,% скидки ДК на итог по умолч.':u)
      293                                 ,chr(10)
      294                                 ,p-templ-rl-root
      295                                 ,p-rule-num).
      296       end.
      297       if buf_dis-rule.root <> yes then do:
      298         undo, return error substitute("Тип ДК &1 код валюты &2 фирма &3 &4 место использ. &5 скидка типа &6&7правило скидки &9 - некорневое"
      299                                 ,p-type
      300                                 ,p-emitent-host-code
      301                                 ,p-host-code
      302                                 ,p-obj-type + string(p-obj-code)
      303                                 ,p-pos-type
      304                                 ,entry (lookup (p-discnt-role, 'calc-d-pcnt,calc-cash-d-pcnt,calc-categ,dis-tot-flag,def-categ,def-pcnt,def-cash-pcnt':u) + 1, ',' + 'Расчет %скидки ДК на товар,Расчет %скидки ДК на итог,Расчет категории ДК,Участие в итогах по ДК,Категория ДК по умолчанию,% скидки ДК на товар по умолч.,% скидки ДК на итог по умолч.':u)
      305                                 ,chr(10)
      306                                 ,p-templ-rl-root
      307                                 ,p-rule-num).
      308       end.
      309       find first buf_dis-dct-rule exclusive-lock where
      310                  buf_dis-dct-rule.type  = p-type
      311              AND buf_dis-dct-rule.emitent-host-code = p-emitent-host-code
      312              AND buf_dis-dct-rule.obj-type  = p-obj-type
      313              AND buf_dis-dct-rule.host-code = p-host-code
      314              AND buf_dis-dct-rule.obj-code  = p-obj-code
      315              AND buf_dis-dct-rule.pos-type  = p-pos-type
      316              AND buf_dis-dct-rule.discnt-role = p-discnt-role  no-error .
      317       if not available buf_dis-dct-rule then do:
      318         create buf_dis-dct-rule .
      319         assign
      320         buf_dis-dct-rule.type  = p-type
      321         buf_dis-dct-rule.emitent-host-code  = p-emitent-host-code
      322         buf_dis-dct-rule.host-code  = p-host-code
      323         buf_dis-dct-rule.obj-type  = p-obj-type
      324         buf_dis-dct-rule.obj-code  = p-obj-code
      325         buf_dis-dct-rule.pos-type = p-pos-type
      326         buf_dis-dct-rule.discnt-role = v-discnt-role
      327         buf_dis-dct-rule.rule-num = p-rule-num no-error
      328         .
      329       end.
      330       ELSE
      331       ASSIGN
      332       buf_dis-dct-rule.rule-num = p-rule-num
      333       buf_dis-dct-rule.rl-root = buf_Dis-rule.rl-root
      334       buf_dis-dct-rule.time-templ-rl-root = p-time-templ-rl-root
      335       buf_dis-dct-rule.templ-rl-root = p-templ-rl-root
      336       buf_dis-dct-rule.nonunique = p-nonunique
      337       no-error.
      338     end.
      339   end procedure.
      340   procedure disdctru-delete :
      341   define input parameter p-cdpay-code     like ub.dis-dct-rule.emitent-host-code no-undo .
      342   define input parameter p-curr-code      like ub.dis-dct-rule.type no-undo .
      343   define input parameter p-host-code      like ub.dis-dct-rule.host-code   no-undo .
      344   define input parameter p-obj-type       like ub.dis-dct-rule.obj-type   no-undo .
      345   define input parameter p-obj-code       like ub.dis-dct-rule.obj-code   no-undo .
      346   define input parameter p-pos-type       like ub.dis-dct-rule.pos-type   no-undo .
      347   define input parameter p-discnt-role    like ub.dis-dct-rule.discnt-role no-undo .
      348   define input parameter p-nonunique      like ub.dis-dct-rule.nonunique   no-undo .
      349   define output parameter p-deleted       as logical no-undo .
      350   define variable v-rule-label as character no-undo .
      351   define buffer buf_dis-dct-rule for ub.dis-dct-rule.
      352   do
      353   on error undo, return error
      354   :
      355   find first buf_dis-dct-rule exclusive-lock where
      356               buf_dis-dct-rule.emitent-host-code  = p-host-code
      357           AND buf_dis-dct-rule.type  = p-type
      358           AND buf_dis-dct-rule.obj-type  = p-obj-type
      359           AND buf_dis-dct-rule.host-code = p-host-code
      360           AND buf_dis-dct-rule.obj-code  = p-obj-code
      361           AND buf_dis-dct-rule.pos-type  = p-pos-type
      362           AND buf_dis-dct-rule.discnt-role = p-discnt-role
      363           and buf_dis-dct-rule.nonunique = p-nonunique
      364           no-error .
      365   if not available buf_dis-dct-rule then do:
      366     return '':U.
      367   end.
      368   delete buf_dis-dct-rule no-error.
      369   if error-status:error then do:
      370     run disdctru-name in this-procedure
      371       (input  buf_dis-dct-rule.templ-rl-root
      372       ,output v-rule-label
      373       ) no-error .
      374     undo, return error substitute("Ошибка при удалении скидки по типу ДК:&1" +
      375                                  "скидка &2 (POS &3) на фирме &4 &5&6 для платежа&1&7&1&8"
      376                                   ,chr(10)
      377                                   ,v-rule-label
      378                                   ,p-pos-type
      379                                   ,p-host-code
      380                                   ,p-obj-type
      381                                   ,p-obj-code
      382                                   ,error-status:get-message(1)
      383                                   ,return-value ).
      384   end.
      385   p-deleted = yes.
      386   return '':U.
      387   end.
      388   end procedure.
      389   procedure disdctru-edit :
      390   define input parameter p-mode as character no-undo .
      391   define input parameter p-type   like ub.dis-dct-rule.type no-undo .
      392   define input parameter p-emitent-host-code like ub.dis-dct-rule.emitent-host-code no-undo .
      393   define input parameter p-host-code like ub.dis-dct-rule.host-code no-undo .
      394   define input parameter p-obj-type like ub.dis-dct-rule.obj-type no-undo .
      395   define input parameter p-obj-code like ub.dis-dct-rule.obj-code no-undo .
      396   define input parameter p-pos-type like ub.dis-dct-rule.pos-type no-undo .
      397   define input parameter p-discnt-role    like ub.dis-dct-rule.discnt-role no-undo .
      398   define input parameter p-templ-rl-root like ub.dis-dct-rule.templ-rl-root no-undo .
      399   define input parameter p-time-templ-rl-root like ub.dis-dct-rule.time-templ-rl-root no-undo .
      400   define input parameter p-cfg-NONUNIQUE as character no-undo .
      401   define input parameter p-check as integer no-undo .
      402   define input-output parameter p-rule-num as integer no-undo .
      403   define input-output parameter p-NONUNIQUE like ub.dis-dct-rule.NONUNIQUE no-undo .
      404   define output parameter p-setted as logical no-undo .
      405   DEFINE VARIABLE v-value as character no-undo .
      406   define variable v-sts as integer no-undo .
      407   define variable v-rid-list as character no-undo .
      408   define variable v-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
      409   DEFINE VARIABLE v-rule-num as integer no-undo .
      410   define variable v-cd-dr-correct  as logical no-undo .
      411   define variable jj as integer no-undo .
      412   define variable conf-par as character no-undo .
      413   define variable conf-attr as character no-undo .
      414   define variable par-type as character no-undo .
      415   define variable dflt-cd as character no-undo .
      416   define variable v-cd-list as character no-undo .
      417   define variable v-is-time-rule as logical no-undo .
      418   define variable v-label as character no-undo .
      419   define variable v-nonunique as character no-undo .
      420   define buffer buf_dis-rule for ub.dis-rule.
      421   define buffer buf_dis-time-rule for ub.dis-time-rule .
      422   define buffer term_dis-rule for ub.dis-rule.
      423   define buffer buf_dis-dct-rule for ub.dis-dct-rule.
      424   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      425   define buffer buf_temp-odisc for temp-odisc.
      426   assign
      427   v-rule-num = p-rule-num.
      428   v-sts = integer('0':U).
      429   if v-rule-num <> 0
      430   and v-rule-num <> ?
      431   then do:
      432     find first buf_dis-rule no-lock where
      433               buf_dis-rule.rule-num = v-rule-num no-error .
      434     if error-status:error then do:
      435       message
      436       "Ошибка при поиске правила с номером" v-rule-num
      437       view-as alert-box error .
      438       return .
      439     end.
      440     assign
      441     v-rid-list = string(recid(buf_dis-rule))
      442     .
      443   end.
      444     run disdctru-name in this-procedure (
      445                                   input p-templ-rl-root
      446                                   ,output v-label) no-error.
      447   if p-pos-type = ?
      448   or p-pos-type = '':U then do:
      449   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      450   define variable v-param-type5 as character no-undo .
      451   define variable v-value-date5 as date no-undo .
      452   define variable v-value-decimal5 as decimal no-undo .
      453   define variable v-value-integer5 as INTEGER no-undo .
      454   define variable v-value-logical5 AS LOGICAL no-undo .
      455   define variable v-tth5 as handle no-undo .
      456   run adm/shattri.p (
      457       input "get":U
      458       ,input  p-obj-type
      459       ,input  p-obj-code
      460       ,input  'cd-sending':U
      461       ,input  'dflt-cd':U
      462       ,output dflt-cd
      463       ,output v-value-date5
      464       ,output v-value-decimal5
      465       ,output v-value-integer5
      466       ,output v-value-logical5
      467       ,output v-param-type5
      468       ,INPUT-OUTPUT table-handle v-tth5
      469       )  .
      470   delete object v-tth5 no-error.
      471   end.
      472   else do:
      473     dflt-cd = p-pos-type.
      474   end.
      475   run ref/dis-ruls.w (
      476               input parparentproc
      477               ,input p-host-code
      478               ,input p-obj-type
      479               ,input p-obj-code
      480               ,input "b-add,b-sel":U
      481               ,input (if p-obj-code > 0
      482                       then "upper-rule-num-object"
      483                       else ( if p-host-code > 0
      484                              then "upper-rule-num-host"
      485                              else "upper-rule-num-global"
      486                            )
      487                      )
      488               ,input p-templ-rl-root
      489               ,input p-time-templ-rl-root
      490               ,input 0
      491               ,input-output v-sts
      492               ,input-output v-rid-list ) no-error .
      493   do
      494   on error undo, return error return-value
      495   :
      496     if v-rid-list <> "":U then do:
      497       find first buf_dis-rule exclusive-lock where
      498                   recid(buf_dis-rule) = integer(v-rid-list) no-wait no-error .
      499       if not available buf_dis-rule
      500       then do:
      501         message
      502         "Ошибка при поиске правила с recid" v-rid-list
      503         view-as alert-box error .
      504         return .
      505       end.
      506       if buf_dis-rule.sts <> integer('0':U) then do:
      507         message
      508         "Правило скидки имеет статус" entry (lookup (string(buf_dis-rule.sts), '0,1,2,99,98':U), 'исп,не-исп,детализ,удаление,запр.удал':U) skip
      509         "Нельзя привязать к нему скидку на тип ДК"
      510         view-as alert-box error .
      511         return .
      512       end.
      513       find first buf_dis-cfg-rule no-lock where
      514               buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
      515           and buf_dis-cfg-rule.time-templ-rl-root = (if buf_dis-rule.time-templ-rl-root = 0
      516                                                      then 0
      517                                                      else buf_dis-rule.time-templ-rl-root)
      518           and buf_dis-cfg-rule.pos-type = dflt-cd no-error.
      519       if available buf_dis-cfg-rule then do:
      520         assign
      521         v-cd-dr-correct = yes
      522         .
      523       end.
      524       if not v-cd-dr-correct
      525       then do:
      526         message
      527         substitute("Правило скидки &1 неприменимо для касс &2.&3" +
      528                   "(АРМ АДМИНИСТРАТОР-Магазины(Фирмы)-Параметры-Общие опции коммуникации с кассами)"
      529                   ,buf_dis-rule.rule-num
      530                   ,dflt-cd
      531                   ,chr(10)
      532                   )
      533         view-as alert-box error .
      534         undo, return error .
      535       end.
      536       v-nonunique = if p-cfg-nonunique = '':U
      537                     then '':U
      538                     else string(buffer buf_Dis-rule:handle:buffer-field(p-cfg-nonunique):buffer-value).
      539       if p-check = 0
      540       or p-check = 2
      541       then do:
      542         find first buf_dis-dct-rule no-lock where
      543                    buf_dis-dct-rule.host-code = p-host-code
      544                 and buf_dis-dct-rule.obj-type = p-obj-type
      545                 and buf_dis-dct-rule.obj-code = p-obj-code
      546                 and buf_dis-dct-rule.type = p-type
      547                 and buf_dis-dct-rule.emitent-host-code = p-emitent-host-code
      548                 and buf_dis-dct-rule.pos-type = p-pos-type
      549                 and buf_dis-dct-rule.discnt-role = p-discnt-role
      550                 and buf_dis-dct-rule.nonunique = v-nonunique no-error .
      551         if available buf_dis-dct-rule
      552         then do:
      553           if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      554             message
      555             "Скидка такого типа на данный тип ДК уже существует"
      556             view-as alert-box error .
      557             return error.
      558           end.
      559         end.
      560       end.
      561       if p-check = 1
      562       or p-check = 2
      563       then do:
      564         find first buf_temp-odisc no-lock where
      565                    buf_temp-odisc.host-code = p-host-code
      566                 and buf_temp-odisc.obj-type = p-obj-type
      567                 and buf_temp-odisc.obj-code = p-obj-code
      568                 and buf_temp-odisc.type = p-type
      569                 and buf_temp-odisc.emitent-host-code = p-emitent-host-code
      570                 and buf_temp-odisc.pos-type = p-pos-type
      571                 and buf_temp-odisc.discnt-role = p-discnt-role
      572                 and buf_temp-odisc.nonunique = v-nonunique no-error .
      573         if available buf_temp-odisc
      574         and buf_temp-odisc.rule-num <> 0
      575         then do:
      576           if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      577             message
      578           "Скидка такого типа на данный тип ДК уже существует"
      579             view-as alert-box error .
      580             return error.
      581           end.
      582         end.
      583       end.
      584       if p-rule-num <> buf_dis-rule.rule-num then do:
      585         assign
      586         p-setted = yes
      587         p-rule-num = buf_dis-rule.rule-num
      588         p-nonunique = v-nonunique
      589         .
      590       end.
      591     end.
      592   end.
      593   end procedure.
      594   define variable updated as logical no-undo.
      595   DEFINE VARIABLE added  as logical no-undo .
      596   define variable add-option as CHARACTER no-undo.
      597   define variable ini-title as char no-undo.
      598   define variable temp-doc-rec as recid no-undo.
      599   define variable dops as character no-undo.
      600   define variable dopst as character no-undo.
      601   define variable v-tab-order as character no-undo .
      602   DEFINE VARIABLE dflt-cd AS CHARACTER NO-UNDO.
      603   define variable loc-glob as logical no-undo .
      604   define variable loc-firm as logical no-undo .
      605   define variable loc-object as logical no-undo .
      606   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      607   define variable send-ref as logical no-undo.
      608   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      609     (input  'send-ref'
      610     ,input  0
      611     ,input  ''
      612     ,input  0
      613     ,input  ''
      614     ,input  ''
      615     ,input  ''
      616     ,input  no
      617     ,output dops
      618     ,output dopst
      619     ) no-error .
      620     send-ref = (IF error-status:error or dops <> "yes" then no else yes).
      621   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      622   FUNCTION get-region RETURNS CHARACTER
      623     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      624     define variable par-region as character no-undo.
      625     if parhost-code = 0 and
      626          parobj-type = "":U and
      627          parobj-code = 0 then do:
      628          par-region = "Глобально".
      629          return par-region.
      630       end.
      631       if parobj-type = 'орг':U then do:
      632          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      633          return par-region.
      634       end.
      635       if parobj-type = 'регион':U
      636       then do:
      637          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      638          return par-region.
      639       end.
      640       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      641       return par-region.
      642   END FUNCTION.
      643   FUNCTION get-objregion RETURNS CHARACTER
      644     (  input parobj-type as character, input parobj-code as integer ) :
      645     define variable par-region as character no-undo.
      646     if  parobj-type = "":U and
      647         parobj-code = 0
      648     then do:
      649        par-region = "Глобально".
      650     end.
      651     else if parobj-type = 'орг':U
      652     then do:
      653        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      654     end.
      655     else if parobj-type = 'регион':U
      656     then do:
      657        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      658     end.
      659     else
      660        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      661     return par-region.
      662   END FUNCTION.
      663   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      664   define new shared temp-table dc-list no-undo like ub.dis-card
      665     field to-del as logical
      666     field order-num as integer
      667     field fdec as decimal
      668     field fint as integer
      669     field flog as logical
      670     field fchar as character
      671     index pi  is primary unique d-card
      672     index cn      card-num
      673     index cli cli-type cli-code
      674     index host-dscnt  emitent-host-code status_ d-pcnt
      675     index host-type  emitent-host-code type d-pcnt
      676     index oi order-num
      677     .
      678   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      679   define  new shared  temp-table dc-list-hist no-undo
      680   field list-table as character
      681   field id as integer
      682   field line as integer
      683   field hist-mode as character
      684   field des as character
      685   field num-recs as integer
      686   field option_ as character
      687   field item_ as character
      688   field status_ as character
      689   field num-add as integer
      690   field num-ignored as integer
      691   field done as logical
      692   field err_ as logical
      693   field err-mes as character
      694   index pi is primary
      695   id
      696   line
      697   index isdone
      698   done
      699   .
      700   DEFINE MENU MENU-b-add
      701          MENU-ITEM m_pos-type     LABEL "m_pos-type"
      702          MENU-ITEM m_no-pos       LABEL "По накладной"
      703          MENU-ITEM m_bo           LABEL "Бэкофис"      .
      704   DEFINE BUTTON b-add
      705        LABEL "&Добавить":L
      706        SIZE 10 BY 1 TOOLTIP "Добавить скидку на тип ДК".
      707   DEFINE BUTTON b-chg
      708        LABEL "&Изменить":L
      709        SIZE 10 BY 1 TOOLTIP "Изменить скидку на тип ДК".
      710   DEFINE BUTTON b-del
      711        LABEL "&Удалить":L
      712        SIZE 10 BY 1 TOOLTIP "Удалитиь  скидку на тип ДК".
      713   DEFINE BUTTON B-exit AUTO-GO
      714        LABEL "&Ввод"
      715        SIZE 10 BY 1 TOOLTIP "Выход с сохранением".
      716   DEFINE BUTTON b-help
      717        LABEL "Помо&щь":L
      718        SIZE 3 BY 1.
      719   DEFINE BUTTON B-lookup
      720        LABEL "&Просмотр"
      721        SIZE 10 BY 1.
      722   DEFINE BUTTON b-quit AUTO-END-KEY
      723        LABEL "&Отмена":L
      724        SIZE 10 BY 1 TOOLTIP "Выход из режима".
      725   DEFINE VARIABLE card-emitent AS INTEGER FORMAT ">>>>>>>>>>9":U INITIAL 0
      726        LABEL "Эмитент"
      727         VIEW-AS TEXT
      728        SIZE 16.4 BY 1
      729        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      730   DEFINE VARIABLE card-type AS CHARACTER FORMAT "X(16)":U
      731        LABEL "Тип карты"
      732         VIEW-AS TEXT
      733        SIZE 16.4 BY 1
      734        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      735   DEFINE QUERY br-dis-dct FOR
      736         temp-odisc SCROLLING.
      737   DEFINE BROWSE br-dis-dct
      738     QUERY br-dis-dct DISPLAY
      739         temp-odisc.templ-rl-root COLUMN-LABEL "Тип правила" FORMAT ">>>9":U
      740   disdctru-get-disc-label(temp-odisc.templ-rl-root) COLUMN-LABEL 'Тип скидки' FORMAT "X(255)":U WIDTH 50
      741   temp-odisc.rule-num COLUMN-LABEL "№ правила" FORMAT ">>>>>>>>9":U
      742   temp-odisc.rl-root COLUMN-LABEL "№ корн.!правила" FORMAT ">>>>>>>>9":U
      743   get-region(temp-odisc.host-code, temp-odisc.obj-type, temp-odisc.obj-code) COLUMN-LABEL "Действует" FORMAT "X(12)":U
      744   entry (lookup (temp-odisc.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U) FORMAT "X(20)":U COLUMn-LABEL "Место использ."
      745       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 18.
      746   DEFINE FRAME Dialog-Frame
      747        B-exit AT ROW 1 COL 1
      748        b-quit AT ROW 1 COL 11
      749        b-add AT ROW 1 COL 21
      750        B-lookup AT ROW 1 COL 31
      751        b-chg AT ROW 1 COL 41
      752        b-del AT ROW 1 COL 51
      753        b-help AT ROW 1 COL 95
      754        br-dis-dct AT ROW 4 COL 1
      755        card-type AT ROW 2.27 COL 1
      756        card-emitent AT ROW 2.27 COL 30.5 WIDGET-ID 2
      757        SPACE(43.10) SKIP(18.92)
      758       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      759            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      760            TITLE "Скидки на типы ДК".
      761   ASSIGN
      762          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      763          FRAME Dialog-Frame:HIDDEN           = TRUE.
      764   ASSIGN
      765          b-add:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-add:HANDLE.
      766   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      767   DO:
      768     APPLY "END-ERROR":U TO SELF.
      769   END.
      770   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      771   DO:
      772     if p-pos-type = '':U then do:
      773       if add-option = '':U then do:
      774         run gbl/pop-up.p ( input self:handle, input no) no-error.
      775       end.
      776       if add-option = '':U then return no-apply.
      777     end.
      778     run proc-add-chg in this-procedure ( input yes, input add-option ) no-error.
      779     if error-status:error then do:
      780       add-option = '':U.
      781       return no-apply.
      782     end.
      783     add-option = '':U.
      784   END.
      785   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      786   DO:
      787     if not avail temp-odisc then return no-apply.
      788     run proc-add-chg in this-procedure ( input no, input temp-odisc.pos-type) no-error .
      789     if error-status:error then return no-apply.
      790     OPEN QUERY br-dis-dct FOR EACH temp-odisc NO-LOCK.
      791   END.
      792   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      793   DO:
      794   define variable loc#log as logical no-undo.
      795   define variable v-deleted as logical no-undo .
      796   define variable v-rule-label as character no-undo .
      797     if not avail temp-odisc then return no-apply.
      798       run disdctru-name in this-procedure
      799         (input  temp-odisc.templ-rl-root
      800         ,output v-rule-label
      801         ) no-error .
      802       if error-status :error then do:
      803         return no-apply .
      804       end.
      805     loc#log = no.
      806     message
      807     substitute("Вы уверены, что хотите удалить скидку &1 (место использ &2) для типа ДК &3 (эмитент &4)"
      808              ,temp-odisc.templ-rl-root
      809              ,entry (lookup (temp-odisc.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
      810              ,p-type
      811              ,p-emitent-host-code
      812              )
      813             view-as alert-box QUESTIOn buttons YES-NO update loc#log.
      814     if NOT loc#log then return no-apply.
      815     delete temp-odisc.
      816     updated = yes.
      817    OPEN QUERY br-dis-dct FOR EACH temp-odisc NO-LOCK.
      818   END.
      819   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      820   DO:
      821     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      822     IF ERROR-STATUS:ERROR THEN DO:
      823        RETURN NO-APPLY.
      824     END.
      825   END.
      826   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
      827   DO:
      828     if not avail temp-odisc then return no-apply.
      829     RUN proc-b-lookup IN THIS-PROCEDURE NO-ERROR.
      830     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      831   END.
      832   ON MOUSE-SELECT-DBLCLICK OF br-dis-dct IN FRAME Dialog-Frame
      833   DO:
      834     if not avail temp-odisc then return no-apply.
      835     RUN proc-b-lookup IN THIS-PROCEDURE NO-ERROR.
      836     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      837   END.
      838   ON RETURN OF br-dis-dct IN FRAME Dialog-Frame
      839   DO:
      840     if not avail temp-odisc then return no-apply.
      841     RUN proc-b-lookup IN THIS-PROCEDURE NO-ERROR.
      842     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      843   END.
      844   ON VALUE-CHANGED OF br-dis-dct IN FRAME Dialog-Frame
      845   DO:
      846     IF v-cntxt-db-num > 0
      847     AND (temp-odisc.obj-type = '':U
      848     OR temp-odisc.host-code = 0) THEN DO:
      849        DISABLE
      850        b-chg
      851        with FRAME Dialog-Frame.
      852     END.
      853     ELSE DO:
      854         enable
      855         b-chg WHEN (p-mode <> 'ПРОСМОТР':U)
      856         with FRAME Dialog-Frame.
      857     END.
      858   END.
      859   ON CHOOSE OF MENU-ITEM m_bo
      860   DO:
      861       add-option = 'bo':U.
      862     run proc-add-chg in this-procedure ( input yes, input add-option ) no-error.
      863     if error-status:error then do:
      864       add-option = '':U.
      865       return no-apply.
      866     end.
      867     add-option = '':U.
      868   END.
      869   ON CHOOSE OF MENU-ITEM m_no-pos
      870   DO:
      871     add-option = '-':U.
      872     run proc-add-chg in this-procedure ( input yes, input add-option ) no-error.
      873     if error-status:error then do:
      874       add-option = '':U.
      875       return no-apply.
      876     end.
      877     add-option = '':U.
      878   END.
      879   ON CHOOSE OF MENU-ITEM m_pos-type
      880   DO:
      881     add-option = dflt-cd.
      882     run proc-add-chg in this-procedure ( input yes, input add-option ) no-error.
      883     if error-status:error then do:
      884       add-option = '':U.
      885       return no-apply.
      886     end.
      887     add-option = '':U.
      888   END.
      889   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      890   on help of frame Dialog-Frame
      891   do:
      892     run gbl/app_help.p
      893       (input this-procedure :file-name
      894       ,input ''
      895       ,input ?
      896       ) no-error.
      897     if error-status :error then do:
      898       message
      899         "Ошибка при вызове помощи"
      900         error-status :get-message(1)
      901         view-as alert-box .
      902     end.
      903   end.
      904   run minbtn-set in this-procedure .
      905   on choose of b-help in frame Dialog-Frame
      906   do:
      907     apply "help":u to frame Dialog-Frame .
      908   end.
      909   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      910   procedure minbtn-set :
      911       do
      912           on error undo, return error return-value
      913           :
      914           define variable ii              as integer       no-undo .
      915           define variable fh              as widget-handle no-undo .
      916           define variable hh              as widget-handle no-undo .
      917           define variable v-h             as handle        extent 4 no-undo .
      918           define variable v-name-button   as character     no-undo .
      919           define variable v-help-old-x    as decimal       no-undo .
      920           define variable v-help-old-y    as decimal       no-undo .
      921           define variable v-help-old-size as decimal       no-undo .
      922           define variable v-frame-width   as decimal       no-undo .
      923           define variable jj              as integer       no-undo .
      924           do
      925               on error undo, return error
      926               :
      927               assign
      928                   v-frame-width = frame Dialog-Frame:width - 0.3
      929                   fh            = frame Dialog-Frame:first-child
      930                   hh            = fh:first-child
      931                   ii            = 1
      932                   .
      933               do while valid-handle(hh):
      934                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      935                   do:
      936                       case lc(hh:name) :
      937                           when "b-help" then
      938                               do:
      939                                   hh:load-image-up("cmp/b-help.bmp":u) .
      940                                   hh:load-image-down("cmp/b-help.bmp":u) .
      941                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      942                                   hh:TOOLTIP = "Помощь" .
      943                                   v-help-old-x = hh:column .
      944                                   v-help-old-y = hh:row    .
      945                                   v-help-old-size = hh:width .
      946                                   hh:width-chars = 2.5 .
      947                               end.
      948                           when "b-print" then
      949                               do:
      950                                   hh:load-image("cmp/b-print.bmp":u) .
      951                                   hh:TOOLTIP = "Печать" .
      952                                   v-h[ii] = hh:handle .
      953                                   ii = ii + 1 .
      954                                   hh:width-chars = 3 .
      955                               end.
      956                           when "b-history" or
      957                           when "b-hist" then
      958                               do:
      959                                   hh:load-image("cmp/b-hist.bmp":u) .
      960                                   hh:TOOLTIP = "История" .
      961                                   v-h[ii] = hh:handle .
      962                                   ii = ii + 1 .
      963                                   hh:width-chars = 3 .
      964                               end.
      965                           when "b-sch" then
      966                               do:
      967                                   hh:load-image("cmp/b-sch.bmp":u) .
      968                                   hh:TOOLTIP = "Установка Фильтра" .
      969                                   v-h[ii] = hh:handle .
      970                                   ii = ii + 1 .
      971                                   hh:width-chars = 3 .
      972                               end.
      973                           when "b-hist-user" then
      974                               do:
      975                                   hh:load-image("cmp/b-hist.bmp":u) .
      976                                   hh:TOOLTIP = "История пользователя" .
      977                                   ii = ii + 1 .
      978                               end.
      979                       end case.
      980                   end.
      981                   hh = hh:next-sibling.
      982               end.
      983               b-help:column = v-frame-width - b-help:width-chars.
      984               jj = 0.
      985               repeat ii = 4 to 1 by -1 :
      986                   if valid-handle (v-h[ii] ) then
      987                   do:
      988                       jj  = jj + 1 .
      989                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      990                       v-h[ii]:row    = v-help-old-y .
      991                   end.
      992               end.
      993           end.
      994       end.
      995   end procedure.
      996   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      997   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      998   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      999   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1000   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1001   define variable v-diasize-current-frame-height as decimal   no-undo .
     1002   define variable v-diasize-change-size          as logical   no-undo .
     1003   define variable v-diasize-resize-button        as handle    no-undo .
     1004   define variable v-diasize-wndmax               as logical   no-undo .
     1005   define variable v-diasize-wndstore             as logical   no-undo .
     1006   define variable v-diasize-proc-name            as character no-undo .
     1007   define variable v-diasize-browse-handle        as handle    no-undo .
     1008   define variable v-diasize-browse-number        as integer   no-undo .
     1009   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1010   define temp-table temp-diasize-handle no-undo
     1011     field handle-value  as handle
     1012     field save-position as decimal
     1013     index xpk is primary unique handle-value
     1014     .
     1015   define temp-table temp-browse-handle no-undo
     1016     field browse-type   as character
     1017     field browse-number as integer
     1018     field browse-handle as handle
     1019     field original-size as decimal
     1020     index xpk is primary unique browse-type browse-number
     1021     index xie browse-type browse-handle
     1022   .
     1023   procedure diasize_change-height :
     1024     define input  parameter p-change-value  as decimal   no-undo .
     1025     define input  parameter p-move-resize   as logical   no-undo .
     1026     define variable v-field-group-handle    as handle    no-undo .
     1027     define variable v-object-handle         as handle    no-undo .
     1028     define variable v-frame-height          as decimal   no-undo .
     1029     define variable v-frame-virtual-height  as decimal   no-undo .
     1030     define variable v-browse-height         as decimal   no-undo .
     1031     define variable v-window-height         as decimal   no-undo .
     1032     define variable v-window-virtual-height as decimal   no-undo .
     1033     define variable v-change-sign           as integer   no-undo .
     1034     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1035     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1036     if p-change-value > 0
     1037     then do:
     1038       if frame Dialog-Frame :height + p-change-value
     1039           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1040       then do:
     1041         assign
     1042           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1043                           - (frame Dialog-Frame :height-chars)
     1044         .
     1045         if p-change-value <= 0
     1046         then do:
     1047           run diasize_position-resize-button in this-procedure .
     1048           return .
     1049         end.
     1050       end.
     1051     end.
     1052     if p-change-value < 0
     1053     then do:
     1054       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1055       then do:
     1056         assign
     1057           p-change-value = v-diasize-orig-frame-height
     1058                          - (frame Dialog-Frame :height-chars)
     1059         .
     1060         if p-change-value >= 0
     1061         then do:
     1062           run diasize_position-resize-button in this-procedure .
     1063           return .
     1064         end.
     1065       end.
     1066     end.
     1067     if p-change-value >= 0
     1068     then do:
     1069       assign
     1070         v-change-sign = 1
     1071       .
     1072     end.
     1073     else do:
     1074       assign
     1075         v-change-sign = -1
     1076       .
     1077     end.
     1078     assign
     1079       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1080     .
     1081     if p-change-value = 0
     1082     then do:
     1083       run diasize_position-resize-button in this-procedure .
     1084       return .
     1085     end.
     1086     move_block:
     1087     do
     1088     on error undo move_block, retry move_block
     1089     :
     1090       if retry
     1091       then do:
     1092         do
     1093         on error undo move_block, leave move_block
     1094         :
     1095           if p-change-value > 0
     1096           then do:
     1097             for each buf_temp-diasize-handle
     1098             on error undo, next
     1099             :
     1100               assign
     1101                 v-object-handle = buf_temp-diasize-handle.handle-value
     1102               .
     1103               if v-object-handle <> v-diasize-resize-button
     1104               then do:
     1105                 assign
     1106                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1107                 .
     1108               end.
     1109             end.
     1110             assign
     1111               v-diasize-browse-handle :height = v-browse-height
     1112             .
     1113             for each buf_temp-browse-handle
     1114               where buf_temp-browse-handle.browse-type = 'height':u
     1115             on error undo, next
     1116             :
     1117               assign
     1118                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1119               .
     1120             end.
     1121             assign
     1122               frame Dialog-Frame :height = v-frame-height
     1123             .
     1124             if frame Dialog-Frame :scrollable = true
     1125             then do:
     1126               assign
     1127                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1128               .
     1129             end.
     1130             run diasize_position-resize-button in this-procedure .
     1131           end.
     1132           else do:
     1133             if frame Dialog-Frame :scrollable = true
     1134             then do:
     1135               assign
     1136                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1137               .
     1138             end.
     1139             assign
     1140               frame Dialog-Frame :height = v-frame-height
     1141             .
     1142             assign
     1143               v-diasize-browse-handle :height = v-browse-height
     1144             .
     1145             for each buf_temp-browse-handle
     1146               where buf_temp-browse-handle.browse-type = 'height':u
     1147             on error undo, next
     1148             :
     1149               assign
     1150                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1151               .
     1152             end.
     1153             for each buf_temp-diasize-handle
     1154             on error undo, next
     1155             :
     1156               assign
     1157                 v-object-handle = buf_temp-diasize-handle.handle-value
     1158               .
     1159               if v-object-handle <> v-diasize-resize-button
     1160               then do:
     1161                 assign
     1162                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1163                 .
     1164               end.
     1165             end.
     1166             run diasize_position-resize-button in this-procedure .
     1167           end.
     1168           assign
     1169             v-diasize-change-size = false
     1170           .
     1171           leave move_block .
     1172         end.
     1173       end.
     1174       assign
     1175         v-diasize-need-full-display = true
     1176       .
     1177       if v-diasize-change-size = false
     1178       then do:
     1179         assign
     1180           v-diasize-change-size = true
     1181         .
     1182       end.
     1183       else do:
     1184         return .
     1185       end.
     1186       assign
     1187         v-frame-height = frame Dialog-Frame :height
     1188         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1189         v-browse-height = v-diasize-browse-handle :height
     1190       .
     1191       for each buf_temp-browse-handle
     1192         where buf_temp-browse-handle.browse-type = 'height':u
     1193       :
     1194         assign
     1195           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1196         .
     1197       end.
     1198       for each buf_temp-diasize-handle
     1199       :
     1200         delete buf_temp-diasize-handle .
     1201       end.
     1202       assign
     1203         v-field-group-handle = frame Dialog-Frame :first-child
     1204       .
     1205       do while valid-handle(v-field-group-handle)
     1206       :
     1207         assign
     1208           v-object-handle = v-field-group-handle :first-child
     1209         .
     1210         do while valid-handle(v-object-handle)
     1211         :
     1212           if  v-object-handle <> v-diasize-browse-handle :handle
     1213           and can-query(v-object-handle, "row")
     1214           and can-query(v-object-handle, "height")
     1215           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1216           then do:
     1217             find first buf_temp-browse-handle
     1218               where buf_temp-browse-handle.browse-type   = 'height':u
     1219                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1220               no-error .
     1221             if available buf_temp-browse-handle
     1222             then do:
     1223             end.
     1224             else do:
     1225               create buf_temp-diasize-handle .
     1226               assign
     1227                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1228                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1229               .
     1230             end.
     1231           end.
     1232           assign
     1233             v-object-handle = v-object-handle :next-sibling
     1234           .
     1235         end.
     1236         assign
     1237           v-field-group-handle = v-field-group-handle :next-sibling
     1238         .
     1239       end.
     1240       do with frame Dialog-Frame
     1241       :
     1242         hide v-diasize-resize-button .
     1243         assign
     1244           v-diasize-resize-button :row    = 1
     1245           v-diasize-resize-button :column = 1
     1246         .
     1247       end.
     1248       if p-change-value > 0
     1249       then do:
     1250         if frame Dialog-Frame :scrollable = true
     1251         then do:
     1252           assign
     1253             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1254             no-error .
     1255           if error-status :error
     1256           or error-status :get-message(1) <> ""
     1257           then do:
     1258             undo move_block, retry move_block .
     1259           end.
     1260         end.
     1261         assign
     1262           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1263           no-error .
     1264         if error-status :error
     1265         or error-status :get-message(1) <> ""
     1266         then do:
     1267           undo move_block, retry move_block .
     1268         end.
     1269         assign
     1270           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1271           no-error .
     1272         if error-status :error
     1273         or error-status :get-message(1) <> ""
     1274         then do:
     1275           undo move_block, retry move_block .
     1276         end.
     1277         for each buf_temp-browse-handle
     1278           where buf_temp-browse-handle.browse-type = 'height':u
     1279         on error undo move_block, retry move_block
     1280         :
     1281           assign
     1282             buf_temp-browse-handle.browse-handle :height
     1283               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1284             no-error .
     1285           if error-status :error
     1286           or error-status :get-message(1) <> ""
     1287           then do:
     1288             undo move_block, retry move_block .
     1289           end.
     1290         end.
     1291         for each buf_temp-diasize-handle
     1292         on error undo move_block, retry move_block
     1293         :
     1294           assign
     1295             v-object-handle = buf_temp-diasize-handle.handle-value
     1296           .
     1297           if v-object-handle <> v-diasize-resize-button
     1298           then do:
     1299             assign
     1300               v-object-handle :row = v-object-handle :row + p-change-value
     1301               no-error .
     1302             if error-status :error
     1303             or error-status :get-message(1) <> ""
     1304             then do:
     1305               undo move_block, retry move_block .
     1306             end.
     1307           end.
     1308         end.
     1309       end.
     1310       else do:
     1311         for each buf_temp-diasize-handle
     1312         on error undo move_block, retry move_block
     1313         :
     1314           assign
     1315             v-object-handle = buf_temp-diasize-handle.handle-value
     1316           .
     1317           if v-object-handle <> v-diasize-resize-button
     1318           then do:
     1319             assign
     1320               v-object-handle :row = v-object-handle :row + p-change-value
     1321               no-error .
     1322             if error-status :error
     1323             or error-status :get-message(1) <> ""
     1324             then do:
     1325               undo move_block, retry move_block .
     1326             end.
     1327           end.
     1328         end.
     1329         assign
     1330           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1331           no-error .
     1332         if error-status :error
     1333         or error-status :get-message(1) <> ""
     1334         then do:
     1335           undo move_block, retry move_block .
     1336         end.
     1337         for each buf_temp-browse-handle
     1338           where buf_temp-browse-handle.browse-type = 'height':u
     1339         on error undo move_block, retry move_block
     1340         :
     1341           assign
     1342             buf_temp-browse-handle.browse-handle :height
     1343               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1344             no-error .
     1345           if error-status :error
     1346           or error-status :get-message(1) <> ""
     1347           then do:
     1348             undo move_block, retry move_block .
     1349           end.
     1350         end.
     1351         assign
     1352           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1353           no-error .
     1354         if error-status :error
     1355         or error-status :get-message(1) <> ""
     1356         then do:
     1357           undo move_block, retry move_block .
     1358         end.
     1359         if frame Dialog-Frame :scrollable = true
     1360         then do:
     1361           assign
     1362             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1363             no-error .
     1364           if error-status :error
     1365           or error-status :get-message(1) <> ""
     1366           then do:
     1367             undo move_block, retry move_block .
     1368           end.
     1369         end.
     1370       end.
     1371       if p-move-resize = true
     1372       then do:
     1373         run diasize_position-resize-button in this-procedure .
     1374       end.
     1375       if v-diasize-wndstore = true
     1376       then do:
     1377         if connected("ub") = true
     1378         then do:
     1379           define variable v-cntxt-db-num        as integer   no-undo .
     1380           define variable v-cntxt-userid        as character no-undo .
     1381           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1382                                             , OUTPUT v-cntxt-userid
     1383                                             ) .
     1384           run gbl/wndsizew.p
     1385             (input  v-cntxt-db-num
     1386             ,input  v-cntxt-userid
     1387             ,input  v-diasize-proc-name
     1388             ,input  'height':u
     1389             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1390             ) .
     1391         end.
     1392       end.
     1393     end.
     1394     assign
     1395       v-diasize-change-size = false
     1396     .
     1397   end procedure.
     1398   procedure diasize_set-height :
     1399     define input  parameter p-new-height  as decimal   no-undo .
     1400     define input  parameter p-move-resize as logical   no-undo .
     1401     do
     1402     on error undo, return error return-value
     1403     :
     1404       run diasize_change-height in this-procedure
     1405         (input  (p-new-height - frame Dialog-Frame :height)
     1406         ,input  p-move-resize
     1407         ) .
     1408     end.
     1409   end procedure.
     1410   procedure diasize_change-width :
     1411     define input  parameter p-change-value as decimal   no-undo .
     1412     define input  parameter p-move-resize  as logical   no-undo .
     1413     define variable v-field-group-handle   as handle    no-undo .
     1414     define variable v-object-handle        as handle    no-undo .
     1415     define variable v-frame-width          as decimal   no-undo .
     1416     define variable v-frame-virtual-width  as decimal   no-undo .
     1417     define variable v-browse-width         as decimal   no-undo .
     1418     define variable v-window-width         as decimal   no-undo .
     1419     define variable v-window-virtual-width as decimal   no-undo .
     1420     define variable v-change-sign          as integer   no-undo .
     1421     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1422     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1423     if p-change-value > 0
     1424     then do:
     1425       if frame Dialog-Frame :width + p-change-value >
     1426           session :width-chars
     1427       then do:
     1428         assign
     1429           p-change-value = session :width-chars - frame Dialog-Frame :width
     1430         .
     1431         if p-change-value <= 0
     1432         then do:
     1433           run diasize_position-resize-button in this-procedure .
     1434           return .
     1435         end.
     1436       end.
     1437     end.
     1438     if p-change-value < 0
     1439     then do:
     1440       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1441       then do:
     1442         assign
     1443           p-change-value = v-diasize-orig-frame-width
     1444                          - frame Dialog-Frame :width
     1445         .
     1446         if p-change-value >= 0
     1447         then do:
     1448           run diasize_position-resize-button in this-procedure .
     1449           return .
     1450         end.
     1451       end.
     1452     end.
     1453     if p-change-value >= 0
     1454     then do:
     1455       assign
     1456         v-change-sign = 1
     1457       .
     1458     end.
     1459     else do:
     1460       assign
     1461         v-change-sign = -1
     1462       .
     1463     end.
     1464     assign
     1465       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1466     .
     1467     if p-change-value = 0
     1468     then do:
     1469       run diasize_position-resize-button in this-procedure .
     1470       return .
     1471     end.
     1472     move_block:
     1473     do
     1474     on error undo move_block, leave move_block
     1475     :
     1476       if retry
     1477       then do:
     1478         do
     1479         on error undo move_block, leave move_block
     1480         :
     1481           if p-change-value > 0
     1482           then do:
     1483             for each buf_temp-diasize-handle
     1484             on error undo, next
     1485             :
     1486               assign
     1487                 v-object-handle = buf_temp-diasize-handle.handle-value
     1488               .
     1489               if v-object-handle <> v-diasize-resize-button
     1490               then do:
     1491                 assign
     1492                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1493                 .
     1494               end.
     1495             end.
     1496             assign
     1497               v-diasize-browse-handle :width = v-browse-width
     1498             .
     1499             for each buf_temp-browse-handle
     1500               where buf_temp-browse-handle.browse-type = 'width':u
     1501             on error undo, next
     1502             :
     1503               assign
     1504                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1505               .
     1506             end.
     1507             assign
     1508               frame Dialog-Frame :width = v-frame-width
     1509             .
     1510             if frame Dialog-Frame :scrollable = true
     1511             then do:
     1512               assign
     1513                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1514               .
     1515             end.
     1516             run diasize_position-resize-button in this-procedure .
     1517           end.
     1518           else do:
     1519             if frame Dialog-Frame :scrollable = true
     1520             then do:
     1521               assign
     1522                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1523               .
     1524             end.
     1525             assign
     1526               frame Dialog-Frame :width = v-frame-width
     1527             .
     1528             for each buf_temp-browse-handle
     1529               where buf_temp-browse-handle.browse-type = 'width':u
     1530             on error undo, next
     1531             :
     1532               assign
     1533                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1534               .
     1535             end.
     1536             assign
     1537               v-diasize-browse-handle :width = v-browse-width
     1538             .
     1539             for each buf_temp-diasize-handle
     1540             on error undo, next
     1541             :
     1542               assign
     1543                 v-object-handle = buf_temp-diasize-handle.handle-value
     1544               .
     1545               if v-object-handle <> v-diasize-resize-button
     1546               then do:
     1547                 assign
     1548                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1549                 .
     1550               end.
     1551             end.
     1552             run diasize_position-resize-button in this-procedure .
     1553           end.
     1554           assign
     1555             v-diasize-change-size = false
     1556           .
     1557           leave move_block .
     1558         end.
     1559       end.
     1560       assign
     1561         v-diasize-need-full-display = true
     1562       .
     1563       if v-diasize-change-size = false
     1564       then do:
     1565         assign
     1566           v-diasize-change-size = true
     1567         .
     1568       end.
     1569       else do:
     1570         return .
     1571       end.
     1572       assign
     1573         v-frame-width = frame Dialog-Frame :width
     1574         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1575         v-browse-width = v-diasize-browse-handle :width
     1576       .
     1577       for each buf_temp-browse-handle
     1578         where buf_temp-browse-handle.browse-type = 'width':u
     1579       :
     1580         assign
     1581           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1582         .
     1583       end.
     1584       for each buf_temp-diasize-handle
     1585       :
     1586         delete buf_temp-diasize-handle .
     1587       end.
     1588       assign
     1589         v-field-group-handle = frame Dialog-Frame :first-child
     1590       .
     1591       do while valid-handle(v-field-group-handle)
     1592       :
     1593         assign
     1594           v-object-handle = v-field-group-handle :first-child
     1595         .
     1596         do while valid-handle(v-object-handle)
     1597         :
     1598           if  v-object-handle <> v-diasize-browse-handle :handle
     1599           and v-object-handle <> v-diasize-resize-button
     1600           and can-query(v-object-handle, "row")
     1601           and can-query(v-object-handle, "height")
     1602           and ( v-object-handle :col + v-object-handle :width
     1603                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1604               )
     1605           then do:
     1606             find first buf_temp-browse-handle
     1607               where buf_temp-browse-handle.browse-type   = 'width':u
     1608                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1609               no-error .
     1610             if available buf_temp-browse-handle
     1611             then do:
     1612             end.
     1613             else do:
     1614               create buf_temp-diasize-handle .
     1615               assign
     1616                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1617                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1618               .
     1619             end.
     1620           end.
     1621           assign
     1622             v-object-handle = v-object-handle :next-sibling
     1623           .
     1624         end.
     1625         assign
     1626           v-field-group-handle = v-field-group-handle :next-sibling
     1627         .
     1628       end.
     1629       do with frame Dialog-Frame
     1630       :
     1631         hide v-diasize-resize-button .
     1632         v-diasize-resize-button :row = 1.
     1633         v-diasize-resize-button :column = 1.
     1634       end.
     1635       if p-change-value > 0
     1636       then do:
     1637         if frame Dialog-Frame :scrollable = true
     1638         then do:
     1639           assign
     1640             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1641             no-error .
     1642           if error-status :error
     1643           or error-status :get-message(1) <> ""
     1644           then do:
     1645             undo move_block, retry move_block.
     1646           end.
     1647         end.
     1648         assign
     1649           frame Dialog-Frame :width = v-frame-width + p-change-value
     1650           no-error .
     1651         if error-status :error
     1652         or error-status :get-message(1) <> ""
     1653         then do:
     1654           undo move_block, retry move_block.
     1655         end.
     1656         assign
     1657           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1658         no-error .
     1659         if error-status :error
     1660         or error-status :get-message(1) <> ""
     1661         then do:
     1662           undo move_block, retry move_block.
     1663         end.
     1664         for each buf_temp-browse-handle
     1665           where buf_temp-browse-handle.browse-type = 'width':u
     1666         on error undo move_block, retry move_block
     1667         :
     1668           assign
     1669             buf_temp-browse-handle.browse-handle :width
     1670               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1671             no-error .
     1672           if error-status :error
     1673           or error-status :get-message(1) <> ""
     1674           then do:
     1675             undo move_block, retry move_block .
     1676           end.
     1677         end.
     1678         for each buf_temp-diasize-handle
     1679         on error undo move_block, retry move_block
     1680         :
     1681           assign
     1682             v-object-handle = buf_temp-diasize-handle.handle-value
     1683           .
     1684           if v-object-handle <> v-diasize-resize-button
     1685           then do:
     1686             assign
     1687               v-object-handle :col = v-object-handle :col + p-change-value
     1688               no-error .
     1689             if error-status :error
     1690             or error-status :get-message(1) <> ""
     1691             then do:
     1692               undo move_block, retry move_block .
     1693             end.
     1694           end.
     1695         end.
     1696       end.
     1697       else do:
     1698         for each buf_temp-diasize-handle
     1699         on error undo move_block, retry move_block
     1700         :
     1701           assign
     1702             v-object-handle = buf_temp-diasize-handle.handle-value
     1703           .
     1704           if v-object-handle <> v-diasize-resize-button
     1705           then do:
     1706             assign
     1707               v-object-handle :col = v-object-handle :col + p-change-value
     1708               no-error .
     1709             if error-status :error
     1710             or error-status :get-message(1) <> ""
     1711             then do:
     1712               undo move_block, retry move_block .
     1713             end.
     1714           end.
     1715         end.
     1716         for each buf_temp-browse-handle
     1717           where buf_temp-browse-handle.browse-type = 'width':u
     1718         on error undo move_block, retry move_block
     1719         :
     1720           assign
     1721             buf_temp-browse-handle.browse-handle :width
     1722               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1723             no-error .
     1724           if error-status :error
     1725           or error-status :get-message(1) <> ""
     1726           then do:
     1727             undo move_block, retry move_block .
     1728           end.
     1729         end.
     1730         assign
     1731           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1732           no-error .
     1733         if error-status :error
     1734         or error-status :get-message(1) <> ""
     1735         then do:
     1736           undo move_block, retry move_block.
     1737         end.
     1738         assign
     1739           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1740         no-error .
     1741         if error-status :error
     1742         or error-status :get-message(1) <> ""
     1743         then do:
     1744           undo move_block, retry move_block.
     1745         end.
     1746         if frame Dialog-Frame :scrollable = true
     1747         then do:
     1748           assign
     1749             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1750           no-error .
     1751           if error-status :error
     1752           or error-status :get-message(1) <> ""
     1753           then do:
     1754             undo move_block, retry move_block.
     1755           end.
     1756         end.
     1757       end.
     1758       if p-move-resize
     1759       then do:
     1760         run diasize_position-resize-button in this-procedure .
     1761       end.
     1762       if v-diasize-wndstore = true
     1763       then do:
     1764         if connected("ub") = true
     1765         then do:
     1766           define variable v-cntxt-db-num        as integer   no-undo .
     1767           define variable v-cntxt-userid        as character no-undo .
     1768           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1769                                             , OUTPUT v-cntxt-userid
     1770                                             ) .
     1771           run gbl/wndsizew.p
     1772             (input  v-cntxt-db-num
     1773             ,input  v-cntxt-userid
     1774             ,input  v-diasize-proc-name
     1775             ,input  'width':u
     1776             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1777             ) .
     1778         end.
     1779       end.
     1780     end.
     1781     assign
     1782       v-diasize-change-size = false
     1783     .
     1784   end procedure.
     1785   procedure diasize_set-width :
     1786     define input  parameter p-new-width  as decimal   no-undo .
     1787     define input  parameter p-move-resize as logical   no-undo .
     1788     do
     1789     on error undo, return error return-value
     1790     :
     1791       run diasize_change-width in this-procedure
     1792         (input  (p-new-width - frame Dialog-Frame :width)
     1793         ,input  p-move-resize
     1794         ) .
     1795     end.
     1796   end procedure.
     1797   procedure diasize_position-resize-button :
     1798     do with frame Dialog-Frame
     1799     :
     1800       hide v-diasize-resize-button .
     1801       assign
     1802         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1803                     - 1
     1804                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1805         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1806                     - 1
     1807                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1808       .
     1809       view v-diasize-resize-button .
     1810     end.
     1811   end procedure.
     1812   on alt-right anywhere
     1813   do:
     1814     run diasize_change-width in this-procedure
     1815       (input 1
     1816       ,input true
     1817       ) .
     1818     return no-apply .
     1819   end.
     1820   on alt-left anywhere
     1821   do:
     1822     run diasize_change-width in this-procedure
     1823       (input -1
     1824       ,input true
     1825       ) .
     1826     return no-apply .
     1827   end.
     1828   on alt-down anywhere
     1829   do:
     1830     run diasize_change-height in this-procedure
     1831       (input 1
     1832       ,input true
     1833       ) .
     1834     return no-apply .
     1835   end.
     1836   on alt-up anywhere
     1837   do:
     1838     run diasize_change-height in this-procedure
     1839       (input -1
     1840       ,input true
     1841       ) .
     1842     return no-apply .
     1843   end.
     1844   on alt-enter of frame Dialog-Frame
     1845   do:
     1846     run diasize_maximize in this-procedure
     1847       (input  ?
     1848       ).
     1849     return no-apply .
     1850   end.
     1851   procedure diasize_end-move :
     1852     do
     1853     on error undo, return error return-value
     1854     :
     1855       define variable v-row-delta as decimal   no-undo .
     1856       define variable v-col-delta as decimal   no-undo .
     1857       define variable v-new-row as decimal   no-undo .
     1858       define variable v-new-col as decimal   no-undo .
     1859       assign
     1860         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1861         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1862       .
     1863       assign
     1864         v-row-delta = v-new-row - frame Dialog-Frame :height
     1865         v-col-delta = v-new-col - frame Dialog-Frame :width
     1866       .
     1867       run diasize_change-height in this-procedure
     1868         (input v-row-delta
     1869         ,input true
     1870         ) .
     1871       run diasize_change-width in this-procedure
     1872         (input v-col-delta
     1873         ,input true
     1874         ) .
     1875     end.
     1876   end procedure.
     1877   procedure diasize_maximize :
     1878     define input  parameter p-action as logical   no-undo .
     1879     do
     1880     on error undo, return error return-value
     1881     :
     1882       if p-action = ?
     1883       then do:
     1884         if v-diasize-need-maximize = true
     1885         then do:
     1886           assign
     1887             p-action = true
     1888           .
     1889         end.
     1890         else do:
     1891           assign
     1892             p-action = false
     1893           .
     1894         end.
     1895       end.
     1896       if p-action = true
     1897       then do:
     1898         run diasize_change-height in this-procedure
     1899           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1900               - frame Dialog-Frame :height-chars
     1901           ,input true
     1902           ) .
     1903         run diasize_change-width in this-procedure
     1904           (input session :width-chars
     1905               - frame Dialog-Frame :width-chars
     1906           ,input true
     1907           ) .
     1908         assign
     1909           v-diasize-need-maximize = false
     1910         .
     1911       end.
     1912       else do:
     1913         run diasize_change-width in this-procedure
     1914           (input v-diasize-orig-frame-width
     1915               - frame Dialog-Frame :width-chars
     1916           ,input true
     1917           ) .
     1918         run diasize_change-height in this-procedure
     1919           (input v-diasize-orig-frame-height
     1920               - frame Dialog-Frame :height-chars
     1921           ,input true
     1922           ) .
     1923         assign
     1924           v-diasize-need-maximize = true
     1925         .
     1926       end.
     1927     end.
     1928   end procedure.
     1929   procedure diasize_restore-orig-size :
     1930     do
     1931     on error undo, return error return-value
     1932     :
     1933       assign
     1934         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1935         v-diasize-current-frame-height = frame Dialog-Frame :height
     1936       .
     1937       run diasize_set-height in this-procedure
     1938         (input  v-diasize-orig-frame-height
     1939         ,input  true
     1940         ) .
     1941       run diasize_set-width in this-procedure
     1942         (input  v-diasize-orig-frame-width
     1943         ,input  true
     1944         ) .
     1945     end.
     1946   end procedure.
     1947   procedure diasize_restore-current-size :
     1948     do
     1949     on error undo, return error return-value
     1950     :
     1951       run diasize_set-height in this-procedure
     1952         (input  v-diasize-current-frame-height
     1953         ,input  true
     1954         ) .
     1955       run diasize_set-width in this-procedure
     1956         (input  v-diasize-current-frame-width
     1957         ,input  true
     1958         ) .
     1959     end.
     1960   end procedure.
     1961   procedure diasize_set-browse-handle :
     1962     define input  parameter p-browse-handle as handle   no-undo .
     1963     define buffer buf_temp-browse-handle for temp-browse-handle .
     1964     do
     1965     on error undo, return error return-value
     1966     :
     1967       assign
     1968         v-diasize-browse-handle = p-browse-handle
     1969       .
     1970       for each buf_temp-browse-handle
     1971       on error undo, return error return-value
     1972       :
     1973         delete buf_temp-browse-handle .
     1974       end.
     1975     end.
     1976   end procedure.
     1977   procedure diasize_add_browse :
     1978     define input  parameter p-browse-type   as character no-undo .
     1979     define input  parameter p-browse-handle as handle    no-undo .
     1980     define buffer buf_temp-browse-handle for temp-browse-handle .
     1981     do
     1982     on error undo, return error return-value
     1983     :
     1984       assign
     1985         v-diasize-browse-number = v-diasize-browse-number + 1
     1986       .
     1987       create buf_temp-browse-handle .
     1988       assign
     1989         buf_temp-browse-handle.browse-type   = p-browse-type
     1990         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1991         buf_temp-browse-handle.browse-handle = p-browse-handle
     1992       .
     1993     end.
     1994   end procedure.
     1995   procedure diasize_init :
     1996     define variable v-default-value    as logical   no-undo .
     1997     define variable v-restore-saved    as logical   no-undo .
     1998     define variable v-resize-value-str as character no-undo .
     1999     do
     2000     on error undo, return error return-value
     2001     :
     2002       do with frame Dialog-Frame
     2003       :
     2004         assign
     2005           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2006           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2007           v-diasize-browse-handle     = browse br-dis-dct :handle
     2008         .
     2009         create button v-diasize-resize-button
     2010         assign
     2011           parent        = frame Dialog-Frame :first-child
     2012           label         = "s"
     2013           height-pixels = 16
     2014           width-pixels  = 16
     2015           visible       = true
     2016           sensitive     = true
     2017           movable       = true
     2018           triggers:
     2019             on end-move persistent run diasize_end-move in this-procedure .
     2020           end triggers.
     2021         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2022         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2023         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2024         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2025         assign
     2026           v-diasize-wndmax = false
     2027         .
     2028         if connected("ub") = true
     2029         then do:
     2030           define variable v-cntxt-db-num        as integer   no-undo .
     2031           define variable v-cntxt-userid        as character no-undo .
     2032           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2033                                             , OUTPUT v-cntxt-userid
     2034                                             ) .
     2035           run gbl/wndpar_r.p
     2036             (input  v-cntxt-db-num
     2037             ,input  v-cntxt-userid
     2038             ,input  'wndmax':U
     2039             ,output v-diasize-wndmax
     2040             ,output v-default-value
     2041             ) .
     2042         end.
     2043         assign
     2044           v-diasize-wndstore = false
     2045         .
     2046         if connected("ub") = true
     2047         then do:
     2048           run gbl/wndpar_r.p
     2049             (input  v-cntxt-db-num
     2050             ,input  v-cntxt-userid
     2051             ,input  'wndstore':U
     2052             ,output v-diasize-wndstore
     2053             ,output v-default-value
     2054             ) .
     2055         end.
     2056         assign
     2057           v-diasize-proc-name = entry(1, program-name(2), '.')
     2058         .
     2059         if v-diasize-wndstore = true
     2060         then do:
     2061           assign
     2062             v-restore-saved = false
     2063           .
     2064           if connected("ub") = true
     2065           then do:
     2066             run gbl/wndsizer.p
     2067               (input  v-cntxt-db-num
     2068               ,input  v-cntxt-userid
     2069               ,input  v-diasize-proc-name
     2070               ,input  'height':u
     2071               ,output v-resize-value-str
     2072               ) .
     2073             if v-resize-value-str <> '':U
     2074             then do:
     2075               run diasize_change-height in this-procedure
     2076                 (input  integer(v-resize-value-str)
     2077                 ,input  true
     2078                 ) .
     2079               assign
     2080                 v-restore-saved = true
     2081               .
     2082             end.
     2083           end.
     2084           if connected("ub") = true
     2085           then do:
     2086             run gbl/wndsizer.p
     2087               (input  v-cntxt-db-num
     2088               ,input  v-cntxt-userid
     2089               ,input  v-diasize-proc-name
     2090               ,input  'width':u
     2091               ,output v-resize-value-str
     2092               ) .
     2093             if v-resize-value-str <> '':U
     2094             then do:
     2095               run diasize_change-width in this-procedure
     2096                 (input  integer(v-resize-value-str)
     2097                 ,input  true
     2098                 ) .
     2099               assign
     2100                 v-restore-saved = true
     2101               .
     2102             end.
     2103           end.
     2104           if v-restore-saved <> true
     2105           then do:
     2106             if v-diasize-wndmax = true
     2107             then do:
     2108               run diasize_maximize in this-procedure
     2109                 (input  true
     2110                 ) .
     2111             end.
     2112           end.
     2113         end.
     2114         else do:
     2115           if v-diasize-wndmax = true
     2116           then do:
     2117             run diasize_maximize in this-procedure
     2118               (input  true
     2119               ) .
     2120           end.
     2121         end.
     2122       end.
     2123     end.
     2124   end procedure.
     2125   procedure diasize_need-full-display :
     2126     define output parameter p-need-full-display as logical   no-undo .
     2127     do
     2128     on error undo, return error return-value
     2129     :
     2130       assign
     2131         p-need-full-display = v-diasize-need-full-display
     2132       .
     2133       assign
     2134         v-diasize-need-full-display = false
     2135       .
     2136     end.
     2137   end procedure.
     2138   procedure get-context :
     2139      define output parameter p-db-num as integer          no-undo.
     2140      define output parameter p-user-id as character        no-undo.
     2141      define variable v-login               as character    no-undo.
     2142      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2143      define buffer buf_user-login  for ub.user-login .
     2144      do
     2145      on error undo, return error
     2146      :
     2147            FIND FIRST buf_sys-ctrl no-lock.
     2148            ASSIGN
     2149               v-login = USERID("ub")
     2150               p-db-num = buf_sys-ctrl.db-num
     2151            .
     2152            FIND FIRST buf_user-login
     2153                 WHERE buf_user-login.db-num = p-db-num
     2154                   AND buf_user-login.user-login = v-login
     2155                 no-lock
     2156                 no-error
     2157                 .
     2158            IF AVAILABLE buf_user-login
     2159            THEN DO:
     2160               assign
     2161                  p-user-id = buf_user-login.user-id
     2162               .
     2163            END.
     2164      end.
     2165   end procedure.
     2166       run diasize_init in this-procedure .
     2167   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2168   do:
     2169     br-dis-dct :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2170   end.
     2171   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2172   on f5 of frame Dialog-Frame anywhere
     2173   do:
     2174     OPEN QUERY br-dis-dct FOR EACH temp-odisc NO-LOCK.
     2175       apply "VALUE-CHANGED" to br-dis-dct.
     2176   end.
     2177   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2178   ON TAB ANYWHERE
     2179   DO:
     2180   define variable ii as integer no-undo .
     2181   define variable fh as widget-handle no-undo .
     2182   define variable hh as widget-handle no-undo .
     2183   define variable v-next-widget-name as character no-undo .
     2184   if v-tab-order <> '' then do:
     2185     if self:type = "TOGGLE-BOX" then
     2186     self:BGCOLOR = ?.
     2187     assign
     2188     ii = lookup(self:name, v-tab-order).
     2189     assign
     2190     ii = ii + 1
     2191     v-next-widget-name = entry(ii, v-tab-order)
     2192     no-error .
     2193     if error-status:error then do:
     2194       assign
     2195       ii = 1
     2196       v-next-widget-name = entry( ii, v-tab-order)
     2197       .
     2198     end.
     2199     assign
     2200     fh = frame Dialog-Frame:first-child
     2201     hh = fh:first-child
     2202     .
     2203     do while valid-handle(hh):
     2204       if hh:name = v-next-widget-name then do:
     2205         if hh:sensitive  = yes
     2206         AND hh:visible = yes then do:
     2207           if hh:type = "TOGGLE-BOX":U then do:
     2208             assign
     2209             hh:BGcolor = 1
     2210             .
     2211           end.
     2212           APPLY "ENTRY" to hh.
     2213           return no-apply.
     2214         end.
     2215         else do:
     2216           APPLY "TAB" to hh.
     2217           return no-apply.
     2218         end.
     2219       end.
     2220       hh = hh:next-sibling.
     2221     end.
     2222   end.
     2223   END.
     2224   ON BACK-TAB ANYWHERE
     2225   DO:
     2226   define variable ii as integer no-undo .
     2227   define variable fh as widget-handle no-undo .
     2228   define variable hh as widget-handle no-undo .
     2229   define variable v-next-widget-name as character no-undo .
     2230   if v-tab-order <> '' then do:
     2231     assign
     2232     ii = lookup(self:name, v-tab-order).
     2233     .
     2234     assign
     2235     ii = (if ii = 1
     2236           then  num-entries(v-tab-order)
     2237           else ii - 1
     2238           )
     2239     v-next-widget-name = entry(ii, v-tab-order)
     2240     .
     2241     assign
     2242     fh = frame Dialog-Frame:first-child
     2243     hh = fh:first-child
     2244     .
     2245     do while valid-handle(hh):
     2246       if hh:name = v-next-widget-name then do:
     2247         if hh:sensitive  = yes
     2248         AND hh:visible = yes then do:
     2249           if hh:type = "TOGGLE-BOX":U then do:
     2250             assign
     2251             hh:BGcolor = 1
     2252             .
     2253           end.
     2254           APPLY "ENTRY" to hh.
     2255           return no-apply.
     2256         end.
     2257         else do:
     2258         APPLY "BACK-TAB" to hh.
     2259         return no-apply.
     2260         end.
     2261       end.
     2262       hh = hh:next-sibling.
     2263     end.
     2264     end.
     2265   END.
     2266   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2267   ON RETURN ANYWHERE
     2268   DO:
     2269   define variable ii as integer no-undo .
     2270   define variable fh as widget-handle no-undo .
     2271   define variable hh as widget-handle no-undo .
     2272   define variable v-next-widget-name as character no-undo .
     2273     if v-tab-order <> '' then do:
     2274       assign
     2275       ii = lookup(self:name, v-tab-order).
     2276       if ii = num-entries(v-tab-order) then do:
     2277           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     2278           return no-apply.
     2279       end.
     2280       if self:type <> "BUTTON" and
     2281         self:type <> "EDITOR"  then do:
     2282         run proc-move-forward in this-procedure .
     2283         return no-apply.
     2284       end.
     2285       if self:type = "BUTTON" then do:
     2286         APPLY "CHOOSE" to self.
     2287       end.
     2288       if self:type = "TOGGLE-BOX" then
     2289       self:BGCOLOR = ?.
     2290       assign
     2291       ii = ii + 1
     2292       v-next-widget-name = entry(ii, v-tab-order)
     2293       no-error .
     2294       if error-status:error then do:
     2295         assign
     2296         ii = 1
     2297         v-next-widget-name = entry( ii, v-tab-order)
     2298         .
     2299       end.
     2300       assign
     2301       fh = frame Dialog-Frame:first-child
     2302       hh = fh:first-child
     2303       .
     2304       do while valid-handle(hh):
     2305         if hh:name = v-next-widget-name then do:
     2306           if hh:sensitive  = yes
     2307           AND hh:visible = yes then do:
     2308             if hh:type = "TOGGLE-BOX":U then do:
     2309               assign
     2310               hh:BGcolor = 1
     2311               .
     2312             end.
     2313             APPLY "ENTRY" to hh.
     2314             return no-apply.
     2315           end.
     2316           else do:
     2317             APPLY "TAB" to hh.
     2318             return no-apply.
     2319           end.
     2320         end.
     2321         hh = hh:next-sibling.
     2322       end.
     2323     end.
     2324   END.
     2325   procedure proc-move-forward :
     2326   define variable ii as integer no-undo .
     2327   define variable fh as widget-handle no-undo .
     2328   define variable hh as widget-handle no-undo .
     2329   define variable v-next-widget-name as character no-undo .
     2330   do
     2331   on error undo, return error
     2332   :
     2333     if v-tab-order <> '' then do:
     2334       if self:type = "TOGGLE-BOX" then
     2335       self:BGCOLOR = ?.
     2336       assign
     2337       ii = lookup(self:name, v-tab-order).
     2338       assign
     2339       ii = ii + 1
     2340       v-next-widget-name = entry(ii, v-tab-order)
     2341       no-error .
     2342       if error-status:error then do:
     2343         assign
     2344         ii = 1
     2345         v-next-widget-name = entry( ii, v-tab-order)
     2346         .
     2347       end.
     2348       assign
     2349       fh = frame Dialog-Frame:first-child
     2350       hh = fh:first-child
     2351       .
     2352       do while valid-handle(hh):
     2353         if hh:name = v-next-widget-name then do:
     2354           if hh:sensitive  = yes
     2355           AND hh:visible = yes then do:
     2356             if hh:type = "TOGGLE-BOX":U then do:
     2357               assign
     2358               hh:BGcolor = 1
     2359               .
     2360             end.
     2361             APPLY "ENTRY" to hh.
     2362             return.
     2363           end.
     2364           else do:
     2365             assign
     2366             ii = ii + 1
     2367             v-next-widget-name = entry(ii, v-tab-order)
     2368             no-error .
     2369             if error-status:error then do:
     2370               assign
     2371               ii = 1
     2372               v-next-widget-name = entry( ii, v-tab-order)
     2373               .
     2374             end.
     2375           end.
     2376         end.
     2377         hh = hh:next-sibling.
     2378       end.
     2379     end.
     2380   end.
     2381   end procedure.
     2382   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2383   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2384   MAIN-BLOCK:
     2385   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2386      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2387   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2388     run mainmenu_getcntxt in parparentproc
     2389       (output v-cntxt-db-num
     2390       ,output v-cntxt-userid
     2391       ,output v-cntxt-level
     2392       ,output v-cntxt-host-code-obj
     2393       ,output v-cntxt-obj-type
     2394       ,output v-cntxt-obj-code
     2395       ,output v-cntxt-db-num-obj
     2396       ,output v-cntxt-is-admin
     2397       ) .
     2398     ini-title  = frame Dialog-Frame:TITLE.
     2399     if NOT (p-mode = 'ПРОСМОТР':U
     2400           or p-mode = 'ИЗМЕНЕНИЕ':U
     2401           or p-mode = 'ДОБАВЛЕНИЕ':U
     2402           ) then do:
     2403       message
     2404       vss-workfile vss-revision vss-description skip
     2405       "Неверный параметр вызова p-mode" p-mode
     2406       view-as alert-box ERROR.
     2407       return error.
     2408     end.
     2409     for each  temp-odisc share-lock:
     2410       delete temp-odisc.
     2411     end.
     2412     RUN MyEnable in this-procedure .
     2413     Run init-proc in this-procedure .
     2414     WAIT-FOR GO OF FRAME Dialog-Frame.
     2415   END.
     2416   RUN disable_UI in this-procedure .
     2417   if updated then return 'ИЗМЕНЕНИЕ':U.
     2418   PROCEDURE disable_UI :
     2419     HIDE FRAME Dialog-Frame.
     2420   END PROCEDURE.
     2421   PROCEDURE enable_UI :
     2422     DISPLAY card-type card-emitent
     2423         WITH FRAME Dialog-Frame.
     2424     ENABLE B-exit b-quit b-add B-lookup b-chg b-del b-help card-type card-emitent
     2425         WITH FRAME Dialog-Frame.
     2426     VIEW FRAME Dialog-Frame.
     2427     OPEN QUERY br-dis-dct FOR EACH temp-odisc NO-LOCK.
     2428   END PROCEDURE.
     2429   PROCEDURE init-proc :
     2430   define variable v-rule-label as character no-undo .
     2431   define buffer buf_dis-card-type for ub.dis-card-type.
     2432   define buffer buf_clients for ub.clients.
     2433   for each  temp-odisc share-lock:
     2434     if p-mode = 'ИЗМЕНЕНИЕ':U
     2435     and (temp-odisc.obj-type = p-obj-type
     2436         and
     2437         temp-odisc.obj-code = p-obj-code)
     2438     or (v-cntxt-db-num = 0
     2439         and temp-odisc.obj-type = '':U
     2440         and
     2441         temp-odisc.obj-code = 0)
     2442     or (v-cntxt-db-num = 0
     2443         and temp-odisc.obj-type = 'орг':U
     2444         and temp-odisc.obj-code = p-host-code)
     2445         then do:
     2446     end.
     2447     else do:
     2448       delete temp-odisc.
     2449     end.
     2450   end.
     2451   if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
     2452     Assign
     2453     card-type = p-TYPE
     2454     card-emitent = p-emitent-host-code
     2455     .
     2456     display
     2457     card-type
     2458     card-emitent
     2459     with frame Dialog-Frame  .
     2460   end.
     2461    For each tt0-dis-dct-rule where
     2462            tt0-dis-dct-rule.type  = p-type
     2463       and  tt0-dis-dct-rule.emitent-host-code  = p-emitent-host-code
     2464       no-lock :
     2465       if p-pos-type <> '':U
     2466       and p-pos-type <> tt0-dis-dct-rule.pos-type then do:
     2467         NEXT.
     2468       end.
     2469       if lookup(tt0-dis-dct-rule.discnt-role, p-discnt-role-list) = 0 then next.
     2470       run disdctru-name ( input tt0-dis-dct-rule.templ-rl-root
     2471                           ,output v-rule-label
     2472                            ).
     2473       find first temp-odisc where
     2474                 temp-odisc.discnt-role = tt0-dis-dct-rule.discnt-role
     2475             AND temp-odisc.host-code = tt0-dis-dct-rule.host-code
     2476             AND temp-odisc.obj-code = tt0-dis-dct-rule.obj-code
     2477             AND temp-odisc.obj-type = tt0-dis-dct-rule.obj-type
     2478             AND temp-odisc.type = tt0-dis-dct-rule.type
     2479             AND temp-odisc.emitent-host-code = tt0-dis-dct-rule.emitent-host-code
     2480             AND temp-odisc.nonunique = tt0-dis-dct-rule.nonunique
     2481             AND temp-odisc.pos-type = tt0-dis-dct-rule.pos-type
     2482             no-error.
     2483       if not available temp-odisc then do:
     2484         create temp-odisc.
     2485         assign
     2486         temp-odisc.host-code = tt0-dis-dct-rule.host-code
     2487         temp-odisc.obj-code = tt0-dis-dct-rule.obj-code
     2488         temp-odisc.obj-type = tt0-dis-dct-rule.obj-type
     2489         temp-odisc.type = tt0-dis-dct-rule.type
     2490         temp-odisc.emitent-host-code = tt0-dis-dct-rule.emitent-host-code
     2491         temp-odisc.pos-type = tt0-dis-dct-rule.pos-type
     2492         temp-odisc.nonunique = tt0-dis-dct-rule.nonunique
     2493         temp-odisc.discnt-role = tt0-dis-dct-rule.discnt-role
     2494         .
     2495       end.
     2496       assign
     2497       temp-odisc.templ-rl-root = tt0-dis-dct-rule.templ-rl-root
     2498       temp-odisc.time-templ-rl-root = tt0-dis-dct-rule.time-templ-rl-root
     2499       temp-odisc.rule-num =  tt0-dis-dct-rule.rule-num
     2500       temp-odisc.rl-root =  tt0-dis-dct-rule.rl-root
     2501       temp-odisc.rule-label = v-rule-label
     2502       .
     2503     End.
     2504     OPEN QUERY br-dis-dct FOR EACH temp-odisc NO-LOCK.
     2505   END PROCEDURE.
     2506   PROCEDURE MyEnable :
     2507   DEFINE VARIABLE v-h AS WIDGET-HANDLE NO-UNDO.
     2508   v-h = br-dis-dct:FIRST-COLUMN IN FRAME Dialog-Frame.
     2509   DO while valid-handle(v-h) :
     2510     if v-h:LABEL = 'Тип скидки' then do:
     2511       v-h:RESIZABLE = YES.
     2512       leave.
     2513     end.
     2514     ELSE DO:
     2515       v-h = v-h:NEXT-COLUMN.
     2516     END.
     2517   END.
     2518   IF p-obj-type = 'маг':U THEN DO:
     2519   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2520   define variable v-param-type18 as character no-undo .
     2521   define variable v-value-date18 as date no-undo .
     2522   define variable v-value-decimal18 as decimal no-undo .
     2523   define variable v-value-integer18 as INTEGER no-undo .
     2524   define variable v-value-logical18 AS LOGICAL no-undo .
     2525   define variable v-tth18 as handle no-undo .
     2526   run adm/shattri.p (
     2527       input "get":U
     2528       ,input  p-obj-type
     2529       ,input  p-obj-code
     2530       ,input  'cd-sending':U
     2531       ,input  'dflt-cd':U
     2532       ,output dflt-cd
     2533       ,output v-value-date18
     2534       ,output v-value-decimal18
     2535       ,output v-value-integer18
     2536       ,output v-value-logical18
     2537       ,output v-param-type18
     2538       ,INPUT-OUTPUT table-handle v-tth18
     2539       )  .
     2540   delete object v-tth18 no-error.
     2541   END.
     2542   if p-obj-type = 'скл':U then do:
     2543     dflt-cd = '-':U.
     2544   end.
     2545   ASSIGN
     2546   b-add:POPUP-MENU IN FRAME Dialog-Frame = MENU MENU-b-add:HANDLE
     2547   b-add:MENU-MOUSE = 1
     2548   MENU-ITEM m_pos-type:LABEL IN MENU menu-b-add  = dflt-cd
     2549   MENU-ITEM m_pos-type:sensitive IN MENU menu-b-add  = ((dflt-cd <> '':U) and (dflt-cd <> '-':U))
     2550   .
     2551   if p-pos-type <> '':U then do:
     2552     assign
     2553     MENU-ITEM m_pos-type:sensitive IN MENU menu-b-add  = (MENU-ITEM m_pos-type:LABEL IN MENU menu-b-add = p-pos-type)
     2554     MENU-ITEM m_bo:sensitive IN MENU menu-b-add  = (p-pos-type = 'bo':U)
     2555     MENU-ITEM m_no-pos:sensitive IN MENU menu-b-add  = (p-pos-type = '-':U)
     2556     .
     2557   end.
     2558   assign
     2559   v-tab-order = "b-exit,b-quit,b-add,b-lookup,b-chg,b-del,b-help,br-dis-dct".
     2560                           .
     2561   DISPLAY
     2562   card-type
     2563   card-emitent
     2564   WITH FRAME Dialog-Frame.
     2565   ENABLE
     2566   b-exit when (p-mode <> 'ПРОСМОТР':U )
     2567   b-quit
     2568   b-del when (p-mode <> 'ПРОСМОТР':U )
     2569   b-add when (p-mode <> 'ПРОСМОТР':U )
     2570   b-chg when (p-mode <> 'ПРОСМОТР':U )
     2571   b-lookup
     2572   b-help br-dis-dct
     2573   card-type
     2574   WITH FRAME Dialog-Frame .
     2575   VIEW FRAME Dialog-Frame .
     2576   if p-mode = 'ПРОСМОТР':U then do:
     2577     hide
     2578     b-exit
     2579     in frame Dialog-Frame .
     2580     assign
     2581     b-quit:label = "&Выход"
     2582     b-quit:col    = 1
     2583     .
     2584   end.
     2585   OPEN QUERY br-dis-dct FOR EACH temp-odisc NO-LOCK.
     2586   APPLY "ENTRY" to br-dis-dct.
     2587   END PROCEDURE.
     2588   PROCEDURE proc-add-chg :
     2589   define input parameter p-add as logical no-undo.
     2590   define input parameter p-pos-type as character no-undo.
     2591   define variable v-rule-label as character no-undo .
     2592   DEFINE VARIABLE v-rule-num as integer no-undo .
     2593   define variable v-setted as logical no-undo .
     2594   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     2595   define variable v-templ-rl-root as integer no-undo .
     2596   define variable v-time-templ-rl-root as integer no-undo .
     2597   define variable v-cfg-nonunique as character no-undo .
     2598   define variable v-nonunique as character no-undo .
     2599   define variable v-pos-type as character no-undo .
     2600   define variable v-discnt-role as character no-undo .
     2601   define variable v-obj-type as character no-undo .
     2602   define variable v-obj-code as integer no-undo .
     2603   define variable v-host-code as integer no-undo .
     2604   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     2605   define buffer buf_dis-dct-rule for ub.dis-dct-rule.
     2606   define buffer buf_temp-odisc for temp-odisc.
     2607   CASE p-add:
     2608     when yes then do:
     2609       run ref/dis-pos.w ( INPUT parparentproc
     2610                           ,INPUT "b-sel":U
     2611                           ,INPUT (if p-pos-type = '':U then 'все':U else "cd-type-list")
     2612                           ,INPUT (if v-cntxt-db-num = 0 and loc-glob  then 1 else 0)
     2613                           ,INPUT (if v-cntxt-db-num = 0 and loc-firm  then 1 else 0)
     2614                           ,INPUT (if loc-object then 1 else 0)
     2615                           ,input 'dis-dct-rule':U
     2616                           ,input '':U
     2617                           ,input ?
     2618                           ,INPUT p-pos-type
     2619                           ,input p-discnt-role-list
     2620                           ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2621      IF ERROR-STATUS:ERROR
     2622      OR v-rid-list = '':U THEN DO:
     2623         RETURN.
     2624      END.
     2625      FIND FIRST buf_dis-cfg-rule NO-LOCK where
     2626                recid(buf_dis-cfg-rule) = INTEGER(v-rid-list).
     2627       assign
     2628       v-templ-rl-root = buf_dis-cfg-rule.templ-rl-root
     2629       v-time-templ-rl-root = buf_dis-cfg-rule.time-templ-rl-root
     2630       V-cfg-NONUNIQUE = buf_dis-cfg-rule.nonunique
     2631       v-pos-type   = buf_dis-cfg-rule.pos-type
     2632       v-discnt-role = buf_dis-cfg-rule.discnt-role
     2633       .
     2634       assign
     2635       added = yes.
     2636       v-rule-num = 0.
     2637      if (buf_dis-cfg-rule.has-global +
     2638          buf_dis-cfg-rule.has-host +
     2639          buf_dis-cfg-rule.has-obj) > 1 then do:
     2640         define variable v-sel-vals as character no-undo .
     2641         define variable v-sel-labels as character no-undo .
     2642         define variable var-region as character no-undo .
     2643         assign
     2644         v-sel-vals = v-sel-vals +
     2645                       (if buf_dis-cfg-rule.has-global = 1
     2646                       then (fill(chr(32), 3)  + string(0) + chr(44))
     2647                       else "":U)
     2648         v-sel-labels = v-sel-labels +
     2649                       (if buf_dis-cfg-rule.has-global  = 1
     2650                       then ("Глобально" + chr(44))
     2651                       else "":U)
     2652         .
     2653         assign
     2654         v-sel-vals = v-sel-vals +
     2655                       (if buf_dis-cfg-rule.has-host = 1
     2656                       then ('орг':U  + string(v-cntxt-host-code-obj)  + chr(44))
     2657                       else "":U)
     2658         v-sel-labels = v-sel-labels +
     2659                       (if buf_dis-cfg-rule.has-host = 1
     2660                       then ("Фирма"  + string(v-cntxt-host-code-obj) + chr(44))
     2661                       else "":U)
     2662         .
     2663         assign
     2664         v-sel-vals = v-sel-vals +
     2665                       (if buf_dis-cfg-rule.has-obj = 1
     2666                       then (v-cntxt-obj-type  + string(v-cntxt-obj-code)  + chr(44))
     2667                       else "":U)
     2668         v-sel-labels = v-sel-labels +
     2669                       (if buf_dis-cfg-rule.has-obj = 1
     2670                       then (v-cntxt-obj-type  + string(v-cntxt-obj-code)  + chr(44))
     2671                       else "":U)
     2672         .
     2673         run gbl/d-list.w (
     2674                             input "b-sel":U
     2675                             ,input "Выберите область действия"
     2676                             ,input v-sel-vals
     2677                             ,input v-sel-labels
     2678                             ,input chr(44)
     2679                             ,input "":U
     2680                             ,output var-region) no-error.
     2681         if error-status:error then do:
     2682           return error.
     2683         end.
     2684         assign
     2685         v-obj-type = (if var-region begins 'орг':U
     2686                       then ''
     2687                       else trim(substring(var-region, 1, 3))
     2688                       )
     2689         v-obj-code = (if var-region begins 'орг':U
     2690                       then 0
     2691                       else  integer(substring(var-region, 4))
     2692                       )
     2693         v-host-code = (if var-region begins 'орг':U
     2694                         then integer(substring(var-region, 4))
     2695                         else 0)
     2696         .
     2697         if v-host-code = 0
     2698          and v-obj-type <> '':U then do:
     2699   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2700   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2701     (input  v-obj-type
     2702     ,input  v-obj-code
     2703     ,output v-host-code
     2704     )  .
     2705         end.
     2706       end.
     2707       else do:
     2708         if buf_dis-cfg-rule.has-obj = 1 then do:
     2709           assign
     2710           v-obj-type = p-obj-type
     2711           v-obj-code = p-obj-code
     2712           .
     2713         end.
     2714         if buf_dis-cfg-rule.has-host = 1 then do:
     2715   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2716   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2717     (input  p-obj-type
     2718     ,input  p-obj-code
     2719     ,output v-host-code
     2720     )  .
     2721           assign
     2722           v-obj-type = ""
     2723           v-obj-code = 0
     2724           .
     2725         end.
     2726         if buf_dis-cfg-rule.has-glob = 1 then do:
     2727           assign
     2728           v-host-code = 0
     2729           v-obj-type = '':U
     2730           v-obj-code = 0
     2731           .
     2732         end.
     2733       end.
     2734     end.
     2735     when no then do:
     2736       find first buf_dis-cfg-rule no-lock where
     2737                 buf_dis-cfg-rule.table-name = 'dis-dct-rule':U
     2738             and buf_dis-cfg-rule.discnt-role = temp-odisc.discnt-role
     2739             and buf_dis-cfg-rule.pos-type = temp-odisc.pos-type
     2740             no-error .
     2741       if available buf_dis-cfg-rule then do:
     2742         assign
     2743         v-nonunique = buf_dis-cfg-rule.nonunique.
     2744       end.
     2745       v-rule-num  = temp-odisc.rule-num.
     2746     end.
     2747   END CASE.
     2748   run disdctru-edit in this-procedure (
     2749                                          input (if p-add then 'ДОБАВЛЕНИЕ':U else 'ИЗМЕНЕНИЕ':U)
     2750                                         ,input p-type
     2751                                         ,input p-emitent-host-code
     2752                                         ,input (if p-add then v-host-code else temp-odisc.host-code)
     2753                                         ,input (if p-add then v-obj-type  else temp-odisc.obj-type)
     2754                                         ,input (if p-add then v-obj-code  else temp-odisc.obj-code)
     2755                                         ,INPUT (if p-add then v-pos-type else temp-odisc.pos-type)
     2756                                         ,input (if p-add then v-discnt-role else temp-odisc.discnt-role)
     2757                                         ,input (if p-add then v-templ-rl-root else temp-odisc.templ-rl-root)
     2758                                         ,input (if p-add then v-time-templ-rl-root else temp-odisc.time-templ-rl-root)
     2759                                         ,input v-cfg-nonunique
     2760                                         ,input 1
     2761                                         ,input-output v-rule-num
     2762                                         ,input-output v-nonunique
     2763                                         ,output v-setted ) no-error.
     2764   if not v-setted then return error.
     2765   run temp-disdcrul-write in this-procedure (
     2766                                              input p-type
     2767                                             ,input p-emitent-host-code
     2768                                             ,input (if p-add then v-host-code else temp-odisc.host-code)
     2769                                             ,input (if p-add then v-obj-type else temp-odisc.obj-type)
     2770                                             ,input (if p-add then v-obj-code else temp-odisc.obj-code)
     2771                                             ,input (if p-add then v-pos-type else temp-odisc.pos-type)
     2772                                             ,input (if p-add then v-templ-rl-root else temp-odisc.templ-rl-root)
     2773                                             ,input (if p-add then v-time-templ-rl-root else temp-odisc.time-templ-rl-root)
     2774                                             ,input (if p-add then v-discnt-role else temp-odisc.discnt-role)
     2775                                             ,input (if p-add then ? else temp-odisc.nonunique)
     2776                                             ,input v-rule-num
     2777                                             ,input v-nonunique
     2778                                             ) no-error .
     2779   IF not error-status:error then do:
     2780     assign
     2781     updated = yes
     2782     .
     2783     br-dis-dct:refresh() in frame Dialog-Frame no-error .
     2784   END.
     2785   assign
     2786   added = no.
     2787   if p-add = yes then do:
     2788     OPEN QUERY br-dis-dct FOR EACH temp-odisc NO-LOCK.
     2789     find first buf_temp-odisc no-lock where
     2790               buf_temp-odisc.pos-type = add-option
     2791           AND buf_temp-odisc.templ-rl-root = v-templ-rl-root
     2792           AND buf_temp-odisc.nonunique = v-nonunique
     2793          and buf_temp-odisc.pos-type = add-option
     2794          and buf_temp-odisc.host-code = v-host-code
     2795          and buf_temp-odisc.obj-type = v-obj-type
     2796          and buf_temp-odisc.obj-code = v-obj-code
     2797         no-error.
     2798     add-option = '':U.
     2799     if avail buf_temp-odisc then
     2800         temp-doc-rec = recid(buf_temp-odisc).
     2801         else temp-doc-rec = ?.
     2802     reposition br-dis-dct to recid temp-doc-rec no-error.
     2803     if error-status:error then return no-apply.
     2804   end.
     2805   END PROCEDURE.
     2806   PROCEDURE proc-b-lookup :
     2807   define variable disc-label as character no-undo .
     2808   run disdctru-name in this-procedure (
     2809                                         input temp-odisc.templ-rl-root
     2810                                       , output disc-label
     2811                                   ) no-error.
     2812   IF ERROR-STATUS:ERROR THEN DO:
     2813       message "Ошибка при определении названия и типа скидки на тип ДК!"         skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     2814       return error.
     2815   END.
     2816   run ref/show-dr.p ( input parparentproc
     2817                      ,input temp-odisc.rule-num) no-error.
     2818   END PROCEDURE.
     2819   PROCEDURE proc-save :
     2820   DEFINE VARIABLE v-updated AS LOGICAL NO-UNDO.
     2821   define variable v-created as logical no-undo .
     2822   define variable v-deleted as logical no-undo .
     2823   define variable v-updated-str as character no-undo .
     2824   for each temp-odisc NO-LOCK where
     2825            temp-odisc.type = p-type
     2826        and temp-odisc.emitent-host-code = p-emitent-host-code
     2827   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2828   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2829   on endkey undo , return error substitute( "&1. endkey", vss-workfile ):
     2830     if temp-odisc.obj-type = "" and v-cntxt-db-num <> 0 then next.
     2831     if temp-odisc.host-code = 0 and v-cntxt-db-num <> 0 then next.
     2832     find first tt0-dis-dct-rule NO-LOCK WHERE
     2833             tt0-dis-dct-rule.type = temp-odisc.type
     2834       AND   tt0-dis-dct-rule.host-code = temp-odisc.host-code
     2835       AND   tt0-dis-dct-rule.obj-type = temp-odisc.obj-type
     2836       AND   tt0-dis-dct-rule.obj-code = temp-odisc.obj-code
     2837       AND   tt0-dis-dct-rule.pos-type = temp-odisc.pos-type
     2838       AND   tt0-dis-dct-rule.discnt-role = temp-odisc.discnt-role
     2839       AND tt0-dis-dct-rule.nonunique = temp-odisc.nonunique
     2840       no-error.
     2841     assign
     2842     v-updated = no.
     2843     if available  tt0-dis-dct-rule then do:
     2844       BUFFER-COMPARE temp-odisc
     2845                   TO tt0-dis-dct-rule
     2846                   case-sensitive
     2847                   SAVE result IN v-updated-str.
     2848       assign
     2849       v-created = yes
     2850       v-updated = (v-updated-str <> "":U)
     2851       .
     2852     end.
     2853     else do:
     2854       assign
     2855       v-updated = yes.
     2856     end.
     2857     if v-updated then do:
     2858       run tt0-disdcrul-write in this-procedure(
     2859                                        input p-type
     2860                                       ,input p-emitent-host-code
     2861                                       ,input temp-odisc.host-code
     2862                                       ,input temp-odisc.obj-type
     2863                                       ,input temp-odisc.obj-code
     2864                                       ,input temp-odisc.pos-type
     2865                                       ,input temp-odisc.templ-rl-root
     2866                                       ,input temp-odisc.time-templ-rl-root
     2867                                       ,input temp-odisc.discnt-role
     2868                                       ,input temp-odisc.rule-num
     2869                                       ,input temp-odisc.nonunique
     2870                                       )  no-error.
     2871       if error-status:error then do:
     2872         message
     2873         "Ошибка при сохранении скидки на тип ДК" skip
     2874         "Тип" p-type skip
     2875         "Эмитент" p-emitent-host-code skip
     2876         "объект" temp-odisc.obj-type temp-odisc.obj-code
     2877         "Фирма" temp-odisc.host-code
     2878         "Тип скидки" temp-odisc.templ-rl-root
     2879         "Место использ." temp-odisc.pos-type
     2880         view-as alert-box  error .
     2881         undo, return error  .
     2882       end.
     2883       updated = yes.
     2884     end.
     2885   End.
     2886   FOR EACH tt0-dis-dct-rule where
     2887            tt0-dis-dct-rule.type = p-type
     2888        and tt0-dis-dct-rule.emitent-host-code = p-emitent-host-code
     2889   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2890   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2891   on endkey undo , return error substitute( "&1. endkey", vss-workfile ):
     2892     if p-pos-type <> '':U
     2893     and p-pos-type <> tt0-dis-dct-rule.pos-type then do:
     2894       NEXT.
     2895     end.
     2896     if tt0-dis-dct-rule.obj-type = "" and v-cntxt-db-num <> 0 then next.
     2897     if tt0-dis-dct-rule.host-code = 0 and v-cntxt-db-num <> 0 then next.
     2898     FIND FIRST temp-odisc NO-LOCK WHERE
     2899               temp-odisc.type = tt0-dis-dct-rule.type
     2900           AND temp-odisc.host-code = tt0-dis-dct-rule.host-code
     2901           AND temp-odisc.obj-type = tt0-dis-dct-rule.obj-type
     2902           AND temp-odisc.obj-code = tt0-dis-dct-rule.obj-code
     2903           AND temp-odisc.pos-type = tt0-dis-dct-rule.pos-type
     2904           AND temp-odisc.discnt-role = tt0-dis-dct-rule.discnt-role
     2905           AND temp-odisc.nonunique = tt0-dis-dct-rule.nonunique
     2906           NO-ERROR.
     2907       IF NOT AVAILABLE temp-odisc THEN DO:
     2908         DELETE tt0-dis-dct-rule.
     2909         assign
     2910         v-deleted = yes.
     2911       END.
     2912   END.
     2913   END PROCEDURE.
     2914   PROCEDURE temp-disdcrul-write :
     2915   do
     2916     on error undo, return error
     2917     :
     2918       define input parameter p-type like ub.dis-dct-rule.type   no-undo .
     2919       define input parameter p-emitent-host-code like ub.dis-dct-rule.emitent-host-code no-undo .
     2920       define input parameter p-host-code like ub.dis-dct-rule.host-code no-undo .
     2921       define input parameter p-obj-type like ub.dis-dct-rule.obj-type   no-undo .
     2922       define input parameter p-obj-code like ub.dis-dct-rule.obj-code   no-undo .
     2923       define input parameter p-pos-type like ub.dis-dct-rule.pos-type  no-undo .
     2924       define input parameter p-templ-rl-root     like ub.dis-dct-rule.templ-rl-root  no-undo .
     2925       define input parameter p-time-templ-rl-root     like ub.dis-dct-rule.time-templ-rl-root  no-undo .
     2926       define input parameter p-discnt-role like ub.dis-dct-rule.discnt-role no-undo .
     2927       define input parameter p-was-nonunique like ub.dis-dct-rule.nonunique no-undo .
     2928       define input parameter p-rule-num  like ub.dis-dct-rule.rule-num no-undo .
     2929       define input parameter p-nonunique like ub.dis-dct-rule.nonunique no-undo .
     2930       define variable v-rule-label as character no-undo .
     2931       define buffer buf_temp-odisc for temp-odisc .
     2932       define buffer buf_Dis-rule for ub.dis-rule.
     2933       run disdctru-name in this-procedure (
     2934                                              input  p-templ-rl-root
     2935                                             ,output v-rule-label
     2936                                             ) no-error .
     2937       if error-status :error then do:
     2938         undo, return error return-value .
     2939       end.
     2940       find first buf_temp-odisc exclusive-lock where
     2941                  buf_temp-odisc.type  = p-type
     2942              and buf_temp-odisc.emitent-host-code = p-emitent-host-code
     2943              AND buf_temp-odisc.host-code  = p-host-code
     2944              AND buf_temp-odisc.obj-type  = p-obj-type
     2945              AND buf_temp-odisc.obj-code  = p-obj-code
     2946              AND buf_temp-odisc.pos-type  = p-pos-type
     2947              AND buf_temp-odisc.discnt-role = p-discnt-role
     2948              AND buf_temp-odisc.nonunique = (if p-was-nonunique = ? then p-nonunique else p-was-nonunique)
     2949              no-error no-wait .
     2950       if not available buf_temp-odisc then do:
     2951         create buf_temp-odisc .
     2952         assign
     2953         buf_temp-odisc.type  = p-type
     2954         buf_temp-odisc.emitent-host-code = p-emitent-host-code
     2955         buf_temp-odisc.obj-type  = p-obj-type
     2956         buf_temp-odisc.obj-code  = p-obj-code
     2957         buf_temp-odisc.host-code  = p-host-code
     2958         buf_temp-odisc.pos-type  = p-pos-type
     2959         buf_temp-odisc.rule-num = p-rule-num
     2960         buf_temp-odisc.nonunique = p-nonunique
     2961         buf_temp-odisc.discnt-role = p-discnt-role
     2962         no-error
     2963         .
     2964       end.
     2965       find first buf_dis-rule no-lock where
     2966                 buf_dis-rule.rule-num = p-rule-num.
     2967       ASSIGN
     2968       buf_temp-odisc.rule-num =  p-rule-num
     2969       buf_temp-odisc.time-templ-rl-root = p-time-templ-rl-root
     2970       buf_temp-odisc.nonunique = p-nonunique
     2971       buf_temp-odisc.templ-rl-root = p-templ-rl-root
     2972       buf_temp-odisc.rl-root = buf_dis-rule.rl-root
     2973       no-error.
     2974     end.
     2975   END PROCEDURE.
     2976   PROCEDURE tt0-disdcrul-write :
     2977   do
     2978   on error undo, return error
     2979   :
     2980     define input parameter p-type like ub.dis-dct-rule.type   no-undo .
     2981     define input parameter p-emitent-host-code like ub.dis-dct-rule.emitent-host-code no-undo .
     2982     define input parameter p-host-code like ub.dis-dct-rule.host-code no-undo .
     2983     define input parameter p-obj-type like ub.dis-dct-rule.obj-type   no-undo .
     2984     define input parameter p-obj-code like ub.dis-dct-rule.obj-code   no-undo .
     2985     define input parameter p-pos-type like ub.dis-dct-rule.pos-type   no-undo .
     2986     define input parameter p-templ-rl-root     like ub.dis-dct-rule.templ-rl-root  no-undo .
     2987     define input parameter p-time-templ-rl-root     like ub.dis-dct-rule.time-templ-rl-root  no-undo .
     2988     define input parameter p-discnt-role       like ub.dis-dct-rule.discnt-role no-undo .
     2989     define input parameter p-rule-num    like ub.dis-dct-rule.rule-num no-undo .
     2990     define input parameter p-nonunique like ub.dis-dct-rule.nonunique no-undo .
     2991     define variable v-rule-label          as character no-undo .
     2992     define buffer buf_tt0-dis-dct-rule for tt0-dis-dct-rule .
     2993     define buffer buf_Dis-rule for ub.dis-rule.
     2994     run disdctru-name in this-procedure (
     2995                                         input  p-templ-rl-root
     2996                                         ,output v-rule-label
     2997                                         ) no-error .
     2998     if error-status :error then do:
     2999       undo, return error return-value .
     3000     end.
     3001     find first buf_tt0-dis-dct-rule exclusive-lock where
     3002                 buf_tt0-dis-dct-rule.type  = p-type
     3003             and buf_tt0-dis-dct-rule.emitent-host-code  = p-emitent-host-code
     3004             AND buf_tt0-dis-dct-rule.host-code  = p-host-code
     3005             AND buf_tt0-dis-dct-rule.obj-type  = p-obj-type
     3006             AND buf_tt0-dis-dct-rule.obj-code  = p-obj-code
     3007             AND buf_tt0-dis-dct-rule.pos-type  = p-pos-type
     3008             AND buf_tt0-dis-dct-rule.discnt-role = p-discnt-role
     3009             AND buf_tt0-dis-dct-rule.nonunique = p-nonunique
     3010             no-error .
     3011     if not available buf_tt0-dis-dct-rule then do:
     3012       create buf_tt0-dis-dct-rule .
     3013       assign
     3014       buf_tt0-dis-dct-rule.type  = p-type
     3015       buf_tt0-dis-dct-rule.emitent-host-code  = p-emitent-host-code
     3016       buf_tt0-dis-dct-rule.obj-type  = p-obj-type
     3017       buf_tt0-dis-dct-rule.obj-code  = p-obj-code
     3018       buf_tt0-dis-dct-rule.host-code  = p-host-code
     3019       buf_tt0-dis-dct-rule.pos-type  = p-pos-type
     3020       buf_tt0-dis-dct-rule.nonunique = p-nonunique
     3021       buf_tt0-dis-dct-rule.discnt-role = p-discnt-role
     3022       no-error
     3023       .
     3024     end.
     3025       find first buf_dis-rule no-lock where
     3026                 buf_dis-rule.rule-num = p-rule-num.
     3027     ASSIGN
     3028     buf_tt0-dis-dct-rule.templ-rl-root = p-templ-rl-root
     3029     buf_tt0-dis-dct-rule.rule-num = p-rule-num
     3030     buf_tt0-dis-dct-rule.rl-root = buf_Dis-rule.rl-root
     3031     buf_tt0-dis-dct-rule.time-templ-rl-root = p-time-templ-rl-root
     3032     buf_tt0-dis-dct-rule.nonunique = p-nonunique
     3033     no-error.
     3034     release buf_tt0-dis-dct-rule no-error .
     3035     if error-status:error then do:
     3036       undo, return error return-value .
     3037     end.
     3038   end.
     3039   END PROCEDURE.
