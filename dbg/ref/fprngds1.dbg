        1   block-level on error undo, throw.
        2   define input-output parameter par-rid as recid no-undo .
        3   define input parameter par-mode as character no-undo .
        4   define input parameter p-db-num like ub.fbr-prn.db-num no-undo .
        5   define input parameter p-prn-num like ub.fbr-prn.prn-num no-undo .
        6   define input parameter p-obj-type like ub.fbr-prn-gds.obj-type no-undo .
        7   define input parameter p-obj-code like ub.fbr-prn-gds.obj-code no-undo .
        8   define input parameter p-gds-code like ub.fbr-prn-gds.gds-code no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       11   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: fprngds1.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: ref/fprngds1.p $":U .
       14   define variable vss-description as character no-undo init "Сохранение изменений связки принтер кухни-товар".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define variable var-entry as character no-undo .
       76   define variable v-db-num like ub.db.db-num no-undo .
       77   define buffer buf_fbr-prn-gds for ub.fbr-prn-gds .
       78   define buffer buf_clients for ub.clients.
       79   if par-mode <> 'ДОБАВЛЕНИЕ':U AND par-mode <> 'ИЗМЕНЕНИЕ':U then do:
       80     message vss-workfile vss-revision vss-description skip
       81             "Неверный параметр par-mode - " par-mode
       82     view-as alert-box error .
       83     return error '':u.
       84   end.
       85   if p-gds-code = 0
       86   or not can-find(first ub.goods no-lock where
       87                         ub.goods.gds-code = p-gds-code)
       88   then do:
       89     assign
       90     var-entry = "gds-code":U
       91     .
       92     message
       93     vss-workfile vss-revision vss-description skip
       94     "Укажите товар"
       95     view-as alert-box error .
       96     return error var-entry.
       97   end.
       98   if p-prn-num = 0 then do:
       99     assign
      100     var-entry = "prn-num":U
      101     .
      102     message
      103     vss-workfile vss-revision vss-description skip
      104     "Укажите номер принтера"
      105     view-as alert-box error .
      106     return error var-entry.
      107   end.
      108   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      109   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      110     (output v-db-num
      111     )  .
      112   if p-db-num <> v-db-num then do:
      113     assign
      114     var-entry = "db-num":U
      115     .
      116     message
      117     vss-workfile vss-revision vss-description skip
      118     "Нельзя вводить товары для принтера в чужой БД"
      119     view-as alert-box error .
      120     return error var-entry.
      121   end.
      122   find first buf_clients no-lock where
      123             buf_clients.obj-type = p-obj-type
      124        AND  buf_clients.obj-code = p-obj-code no-error .
      125   if p-obj-type = "":u
      126   or p-obj-code = 0
      127   or not available buf_clients
      128   then do:
      129     assign
      130     var-entry = "obj-code":U
      131     .
      132     message
      133     vss-workfile vss-revision vss-description skip
      134     "Укажите объект"
      135     view-as alert-box error .
      136     return error var-entry.
      137   end.
      138   if buf_clients.db-num <> v-db-num then do:
      139     assign
      140     var-entry = "obj-code":U
      141     .
      142     message
      143     vss-workfile vss-revision vss-description skip
      144     "Укажите объект текущей БД"
      145     view-as alert-box error .
      146     return error var-entry.
      147   end.
      148   if LOOKUP(p-obj-type, ('маг':U + chr(44) + 'скл':U)) = 0 then do:
      149     assign
      150     var-entry = "obj-type":U
      151     .
      152     message
      153     vss-workfile vss-revision vss-description skip
      154     "Объект может быть только " 'маг':U "или"
      155     view-as alert-box error .
      156     return error var-entry.
      157   end.
      158   _main:
      159   do
      160   on error undo _main, return error
      161   :
      162     CASE par-mode:
      163       when 'ДОБАВЛЕНИЕ':U then do:
      164         find first buf_fbr-prn-gds no-lock where
      165                    buf_fbr-prn-gds.gds-code = p-gds-code
      166                AND buf_fbr-prn-gds.obj-type = p-obj-type
      167                AND buf_fbr-prn-gds.obj-code = p-obj-code no-error .
      168         if available buf_fbr-prn-gds then do:
      169           assign
      170           var-entry = "p-gds-code"
      171           .
      172           message
      173           "Невозможно привязать товар к принтеру кухни" skip
      174           "Для товара" p-gds-code skip
      175           "уже определен принтер на объекте" p-obj-type p-obj-code
      176           view-as alert-box error .
      177           return error var-entry.
      178         end.
      179         create ub.fbr-prn-gds.
      180       end.
      181       when 'ИЗМЕНЕНИЕ':U then do:
      182         find first ub.fbr-prn-gds exclusive-lock where
      183                   recid(ub.fbr-prn-gds) = par-rid no-error .
      184         if not available ub.fbr-prn-gds
      185         then do:
      186           assign
      187           var-entry = "gds-code":U
      188           .
      189           message
      190           "Не определен принтер кухни для товара" p-gds-code skip
      191           "на объекте" p-obj-type p-obj-code
      192           view-as alert-box error .
      193           return error var-entry.
      194         end.
      195         IF ub.fbr-prn-gds.obj-type <> p-obj-type
      196         OR ub.fbr-prn-gds.obj-code <> p-obj-code
      197         OR ub.fbr-prn-gds.gds-code <> p-gds-code
      198         OR ub.fbr-prn-gds.db-num <> p-db-num
      199         OR ub.fbr-prn-gds.prn-num <> p-prn-num
      200         then do:
      201           assign
      202           var-entry = "":U
      203           .
      204           message
      205           "Для записи товара на принтере кухни нельзя изменять поля первичного ключа"  skip
      206           view-as alert-box error .
      207           return error var-entry.
      208         end.
      209       end.
      210     END CASE.
      211     assign
      212     ub.fbr-prn-gds.db-num = p-db-num
      213     ub.fbr-prn-gds.prn-num = p-prn-num
      214     ub.fbr-prn-gds.obj-type = p-obj-type
      215     ub.fbr-prn-gds.obj-code = p-obj-code
      216     ub.fbr-prn-gds.gds-code = p-gds-code
      217     par-rid = recid(ub.fbr-prn-gds)
      218     .
      219   end.
