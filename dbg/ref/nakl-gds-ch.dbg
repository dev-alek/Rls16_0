     1418     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
     1419     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
     1420     define input  parameter p-gds-code as   integer                    no-undo .
     1421     define output parameter o-result   as   logical                    no-undo.
     1422     do
     1423     on error undo, return error
     1424     :
     1425           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run isExemplarGoods in g#attr-lib
     1426         (input  p-obj-type
     1427         ,input  p-obj-code
     1428         ,input p-gds-code
     1429         ,output o-result
     1430         ) no-error .
     1431       if error-status :error
     1432       then do:
     1433         undo, return error return-value .
     1434       end.
     1435     end.
     1436   end procedure.
     1437   procedure isVolumArticGoods :
     1438     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
     1439     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
     1440     define input  parameter p-gds-code as   integer                    no-undo .
     1441     define output parameter o-result   as   logical                    no-undo.
     1442     do
     1443     on error undo, return error
     1444     :
     1445           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run isVolumArticGoods in g#attr-lib
     1446         (input  p-obj-type
     1447         ,input  p-obj-code
     1448         ,input p-gds-code
     1449         ,output o-result
     1450         ) no-error .
     1451       if error-status :error
     1452       then do:
     1453         undo, return error return-value .
     1454       end.
     1455     end.
     1456   end procedure.
     1457   define variable v-gds-list as character no-undo.
     1458   define variable objSrv          as class     ibs.th.gbl.sys.objsrv no-undo.
     1459   define variable EDOParSec       as class     ibs.th.gbl.env.prmtrs.edo no-undo .
     1460   define variable varvalue        as character no-undo .
     1461   define variable vartype         as character no-undo .
     1462   FUNCTION mark-str RETURNS CHARACTER
     1463     ( buffer buf_gds for tt-gds, input v-gds-list as character)  FORWARD.
     1464   DEFINE BUTTON B-exit AUTO-END-KEY
     1465        LABEL "&Выход"
     1466        SIZE 10 BY 1
     1467        BGCOLOR 8 .
     1468   DEFINE BUTTON b-mark
     1469        LABEL "&*"
     1470        SIZE 3 BY 1.
     1471   define button b-sel-all
     1472     label "&+":L
     1473     size 3 by 1 tooltip "Отметить все объекты".
     1474   define button b-unmark
     1475     label "&-":L
     1476     size 3 by 1 tooltip "Снять все отметки".
     1477   DEFINE BUTTON B-sel AUTO-GO
     1478        LABEL "Вы&бор"
     1479        SIZE 10 BY 1
     1480        BGCOLOR 8 .
     1481   DEFINE QUERY br-gds FOR
     1482         tt-gds SCROLLING.
     1483   DEFINE BROWSE br-gds
     1484     QUERY br-gds NO-LOCK DISPLAY
     1485         mark-str(buffer tt-gds, v-gds-list) COLUMN-LABEL "*"
     1486               WIDTH 1
     1487         tt-gds.gds-code COLUMN-LABEL "Код товара" FORMAT ">>>>>>>>>9":U
     1488         tt-gds.gds-name COLUMN-LABEL "Наименование" FORMAT "X(100)":U width 60
     1489         tt-gds.qnty     COLUMN-LABEL "Кол-во по накладной"
     1490         tt-gds.price-rubl COLUMN-LABEL "Цена в ПН"
     1491       WITH NO-ROW-MARKERS NO-COLUMN-SCROLLING SEPARATORS SIZE 107 BY 22 FIT-LAST-COLUMN.
     1492   DEFINE FRAME Dialog-Frame
     1493        B-exit AT ROW 1 COL 1 WIDGET-ID 2
     1494        B-sel AT ROW 1 COL 11 WIDGET-ID 6
     1495        b-mark AT ROW 1 COL 26 WIDGET-ID 8
     1496        b-sel-all at row 1 col 29 widget-id 28
     1497        b-unmark at row 1 col 32 widget-id 30
     1498        br-gds AT ROW 3 COL 1 WIDGET-ID 200
     1499        SPACE(0.1) SKIP(0.2)
     1500       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1501            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1502            TITLE "Выберите товар(ы)" WIDGET-ID 100.
     1503   ASSIGN
     1504          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1505          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1506   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1507   DO:
     1508     APPLY "END-ERROR":U TO SELF.
     1509   END.
     1510   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1511   DO:
     1512   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1513   if lookup(self :type
     1514            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1515            ) = 0
     1516   then do:
     1517     message
     1518       "$Workfile$"
     1519       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1520       "Интерфейсный элемент" self :name  skip
     1521       "Тип" self :type  skip
     1522       "Процедура" this-procedure :file-name skip
     1523       view-as alert-box .
     1524   end.
     1525   else do:
     1526     apply "entry":u to self  .
     1527     if focus :handle <> self :handle  then do:
     1528       return no-apply .
     1529     end.
     1530   end.
     1531   END.
     1532   on choose of b-sel-all in frame Dialog-Frame
     1533     do:
     1534       assign
     1535         v-gds-list = "".
     1536       if not available tt-gds then return.
     1537       for each tt-gds no-lock :
     1538   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1539   define variable v-str-recid8 as character no-undo .
     1540   define variable v-num-entry8 as integer   no-undo .
     1541   assign
     1542     v-str-recid8 = trim( string( recid( tt-gds ) , "->>>>>>>>>>>9":U ) )
     1543     v-num-entry8 = lookup( v-str-recid8 , v-gds-list )
     1544   .
     1545   if v-num-entry8 > 0 then do:
     1546     assign
     1547       entry( v-num-entry8, v-gds-list ) = "":U
     1548       v-gds-list = trim( replace( v-gds-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1549     .
     1550   end.
     1551   else do:
     1552     assign
     1553       v-gds-list = v-gds-list + ( if v-gds-list = "":U then "":U else chr(44) ) + v-str-recid8
     1554     .
     1555   end.
     1556       end.
     1557       br-gds:refresh() in frame Dialog-Frame .
     1558     end.
     1559   on choose of b-unmark in frame Dialog-Frame
     1560     do:
     1561       if not available tt-gds then return.
     1562       v-gds-list  = "".
     1563       br-gds:refresh() in frame Dialog-Frame .
     1564     end.
     1565   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1566   DO:
     1567   define variable v-log as logical no-undo.
     1568       if available tt-gds then do:
     1569   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1570   define variable v-str-recid10 as character no-undo .
     1571   define variable v-num-entry10 as integer   no-undo .
     1572   assign
     1573     v-str-recid10 = trim( string( recid( tt-gds ) , "->>>>>>>>>>>9":U ) )
     1574     v-num-entry10 = lookup( v-str-recid10 , v-gds-list )
     1575   .
     1576   if v-num-entry10 > 0 then do:
     1577     assign
     1578       entry( v-num-entry10, v-gds-list ) = "":U
     1579       v-gds-list = trim( replace( v-gds-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1580     .
     1581   end.
     1582   else do:
     1583     assign
     1584       v-gds-list = v-gds-list + ( if v-gds-list = "":U then "":U else chr(44) ) + v-str-recid10
     1585     .
     1586   end.
     1587         v-log = br-gds:refresh() .
     1588         if last-event:function <> "MOUSE-SELECT-DBLCLICK" then  do:
     1589           v-log = br-gds:select-next-row ().
     1590           apply "iteration-changed" to br-gds in frame Dialog-Frame.
     1591         end.
     1592       end.
     1593       apply "entry" to br-gds in frame Dialog-Frame.
     1594   END.
     1595   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1596   DO:
     1597     define variable ii as integer no-undo .
     1598     if trim (v-gds-list, ",") > ""
     1599     then do :
     1600       p-rid-list = "" .
     1601       do ii = 1 to num-entries (v-gds-list) :
     1602         find first tt-gds no-lock where recid(tt-gds) = integer(entry(ii, v-gds-list)) .
     1603         find first buf_goods no-lock where buf_goods.gds-code = tt-gds.gds-code .
     1604         p-rid-list = p-rid-list + string(recid(buf_goods)) + "," .
     1605       end.
     1606       p-rid-list = trim(p-rid-list, ",") .
     1607     end.
     1608     else do :
     1609       if available tt-gds
     1610       then do:
     1611         find first buf_goods no-lock where buf_goods.gds-code = tt-gds.gds-code .
     1612         assign
     1613           p-rid-list = string(recid(buf_goods))
     1614         .
     1615       end.
     1616       else return no-apply .
     1617     end.
     1618   END.
     1619   ON MOUSE-SELECT-DBLCLICK OF br-gds IN FRAME Dialog-Frame
     1620   DO:
     1621     apply "choose" to b-sel.
     1622   END.
     1623   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1624   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1625   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1626   on F2 of frame Dialog-Frame anywhere do:
     1627     if b-exit :sensitive then DO: apply "CHOOSE":U to b-exit in frame Dialog-Frame. END.
     1628     return no-apply.
     1629   end.
     1630   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1631   on INS of frame Dialog-Frame anywhere do:
     1632     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     1633     return no-apply.
     1634   end.
     1635   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1636   on F2 of frame Dialog-Frame anywhere do:
     1637     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     1638     return no-apply.
     1639   end.
     1640   MAIN-BLOCK:
     1641   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1642      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1643     find first buf_trn-doc no-lock where buf_trn-doc.doc-code = p-doc-code .
     1644     run fill-tt .
     1645     RUN my-enable in this-procedure .
     1646     WAIT-FOR GO OF FRAME Dialog-Frame.
     1647   END.
     1648   RUN my-disable.
     1649   procedure fill-tt :
     1650     empty temp-table tt-gds .
     1651     if p-is-edo = ?
     1652     then do :
     1653       for each buf_doc-line no-lock where buf_doc-line.doc-code = p-doc-code,
     1654       first buf_goods no-lock where buf_goods.artic     = buf_doc-line.artic
     1655                                and buf_goods.prod-type = buf_doc-line.prod-type
     1656                                and buf_goods.prod-code = buf_doc-line.prod-code :
     1657         create tt-gds .
     1658         buffer-copy buf_goods to tt-gds
     1659         assign
     1660           tt-gds.qnty = buf_doc-line.fact-qnty
     1661           tt-gds.price-rubl = buf_doc-line.price-rubl
     1662         .
     1663       end .
     1664     end .
     1665     else do :
     1666       run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1667       EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(buf_trn-doc.obj-type, buf_trn-doc.obj-code).
     1668       for each buf_doc-line no-lock where buf_doc-line.doc-code = p-doc-code
     1669                                      and buf_doc-line.fact-qnty > 0 ,
     1670       first buf_goods no-lock where buf_goods.artic     = buf_doc-line.artic
     1671                                and buf_goods.prod-type = buf_doc-line.prod-type
     1672                                and buf_goods.prod-code = buf_doc-line.prod-code :
     1673         if p-is-edo
     1674         then do :
     1675           create tt-gds .
     1676           buffer-copy buf_goods to tt-gds
     1677           assign
     1678             tt-gds.qnty = buf_doc-line.fact-qnty
     1679             tt-gds.price-rubl = buf_doc-line.price-rubl
     1680           .
     1681         end .
     1682         if not p-is-edo
     1683         then do :
     1684           RUN gds-attr-value (
     1685             INPUT buf_goods.gds-code,
     1686             INPUT 'mark-type':U,
     1687             OUTPUT varvalue,
     1688             OUTPUT vartype
     1689             ).
     1690           if EDOParSec:GetIsEDOForType(varvalue)
     1691           or EDOParSec:GetIsArticForType(varvalue)
     1692           or EDOParSec:GetIsMarkingForType(varvalue)
     1693           then do :
     1694           end .
     1695           else do :
     1696             create tt-gds .
     1697             buffer-copy buf_goods to tt-gds
     1698             assign
     1699               tt-gds.qnty = buf_doc-line.fact-qnty
     1700               tt-gds.price-rubl = buf_doc-line.price-rubl
     1701             .
     1702           end .
     1703         end .
     1704       end .
     1705     end .
     1706   end procedure .
     1707   PROCEDURE disable_UI :
     1708     HIDE FRAME Dialog-Frame.
     1709   END PROCEDURE.
     1710   PROCEDURE enable_UI :
     1711     ENABLE B-exit B-sel b-mark br-gds b-sel-all b-unmark
     1712         WITH FRAME Dialog-Frame.
     1713     VIEW FRAME Dialog-Frame.
     1714     OPEN QUERY br-gds FOR EACH tt-gds NO-LOCK INDEXED-REPOSITION.
     1715   END PROCEDURE.
     1716   PROCEDURE my-disable :
     1717     run disable_UI in this-procedure .
     1718   END PROCEDURE.
     1719   PROCEDURE my-enable :
     1720     enable
     1721       b-exit
     1722       b-sel
     1723       b-mark
     1724       br-gds
     1725       b-sel-all
     1726       b-unmark
     1727     with frame Dialog-Frame.
     1728     view frame Dialog-Frame.
     1729     OPEN QUERY br-gds FOR EACH tt-gds NO-LOCK INDEXED-REPOSITION.
     1730   END PROCEDURE.
     1731   FUNCTION mark-str RETURNS CHARACTER
     1732     ( buffer buf_gds for tt-gds, input v-gds-list as character) :
     1733     RETURN (if ( lookup( string( recid( buf_gds ) ) , v-gds-list ) ) > 0 then "*":u else '':u ).
     1734   END FUNCTION.
