      839   procedure prn-lib-reportviewer :
      840     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      841     define input parameter p-report-name-html as character no-undo .
      842     define input parameter p-param        as character no-undo .
      843     define variable v-excel           as character no-undo init 'TRUE' .
      844     define variable v-value-character as character no-undo .
      845     define variable v-value-integer   as character no-undo .
      846     define variable v-value-date      as date      no-undo .
      847     define variable v-value-decimal   as decimal   no-undo .
      848     define variable rep-excel         as logical   no-undo .
      849     define variable excel-string      as character no-undo .
      850     define variable v-param-type      as character no-undo .
      851     define variable v-tth             as handle    no-undo .
      852     run adm/shattri.p (
      853       input "get":U
      854       ,input  ""
      855       ,input  0
      856       ,input  'report-glob':U
      857       ,input  'rep-excel':U
      858       ,output v-value-character
      859       ,output v-value-date
      860       ,output v-value-decimal
      861       ,output v-value-integer
      862       ,output rep-excel
      863       ,output v-param-type
      864       ,INPUT-OUTPUT table-handle v-tth
      865       )  .
      866     if rep-excel then v-excel = "TRUE" .
      867     else v-excel = "FALSE" .
      868     if p-param eq ""
      869     then
      870        p-param = "EXCEL:" + v-excel.
      871     else
      872        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      873     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      874   end procedure.
