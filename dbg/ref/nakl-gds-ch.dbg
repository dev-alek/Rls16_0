      138   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      139   define variable v-waitfram-action01         as character   no-undo .
      140   define variable v-waitfram-action02         as character   no-undo .
      141   define variable v-waitfram-action03         as character   no-undo .
      142   define variable mWaitFramTextBeg            as character   no-undo.
      143   define variable mWaitFramTextEnd            as character   no-undo.
      144   define variable mWaitFramView               as logical     no-undo.
      145   define variable mWaitProcEvent              as logical     no-undo init yes.
      146   define variable mWaitFramInterval           as integer     no-undo init 1 .
      147   define variable mWaitFramStop               as logical     no-undo.
      148   define variable mWaitFramStopUser           as logical     no-undo.
      149   define variable mWaitFramStopTimeOut        as logical     no-undo.
      150   define variable mWaitFramStartProc          as datetime-tz no-undo.
      151   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      152   define button B-WaitFramStop auto-end-key
      153        label "Стоп"
      154        size 10 by 1 tooltip "Остоновить процесс".
      155   define button B-viewProcInfo
      156        label "Информация"
      157        size 15 by 1 tooltip "Информация о процесс".
      158   define frame waitfram
      159     v-waitfram-action01 format "x(72)" no-label skip
      160     v-waitfram-action02 format "x(72)" no-label skip
      161     v-waitfram-action03 format "x(72)" no-label skip
      162     B-viewProcInfo
      163     B-WaitFramStop at row 4 col 30
      164     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      165     .
      166   define new global shared variable mBatchMode as logical no-undo init ?.
      167   define variable mFramBachModHandle as handle no-undo.
      168   mFramBachModHandle = frame waitfram:handle.
      169   define variable mFameOldVis as logical no-undo.
      170   define variable mVisCUrentVin as logical no-undo.
      171   if session:batch-mode
      172   then
      173      mBatchMode = yes.
      174   if mBatchMode = ? then do:
      175     mVisCUrentVin = current-window:visible.
      176     mFameOldVis = mFramBachModHandle:visible.
      177     mFramBachModHandle:visible  = yes.
      178     mBatchMode = mFramBachModHandle:visible ne yes.
      179     mFramBachModHandle:visible = mFameOldVis.
      180     current-window:visible = mVisCUrentVin.
      181   end.
      182    if  log-manager:logfile-name ne ?
      183     then DO:
      184         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      185         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      186         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      187     end.
      188   on choose of B-WaitFramStop in frame waitfram
      189   do:
      190     mWaitFramStop = yes.
      191     mWaitFramStopUser = yes.
      192   end.
      193   function waitfram-check-timeout returns logical():
      194      define variable vtime as int64 no-undo.
      195      if mWaitFramStopTimeOut
      196      then
      197         return yes.
      198      vtime = ( now - mWaitFramStartProc ) / 1000 .
      199      if     mWaitFramTimeOut ne ?
      200         and mWaitFramTimeOut ne 0
      201         and mWaitFramTimeOut lt vtime
      202      then do:
      203         mWaitFramStopTimeOut = yes.
      204      end.
      205      return mWaitFramStopTimeOut.
      206   end.
      207   procedure waitfram-hide :
      208     if not session:batch-mode
      209     then do
      210     on error undo, return error return-value
      211     :
      212       pause 0 before-hide .
      213       if not mBatchMode then
      214         hide frame waitfram .
      215     if     not mWaitFramView
      216        and mWaitProcEvent
      217     then
      218       process events .
      219     end.
      220   end procedure.
      221   procedure waitfram-show :
      222     define input  parameter p-message as character no-undo .
      223     define variable v-left-margin as integer   no-undo .
      224     if not session:batch-mode
      225     then do
      226     on error undo, return error return-value
      227     :
      228       if length(p-message) <= 70 then do:
      229         assign
      230           v-left-margin = integer((70 - length(p-message)) / 2)
      231         .
      232         assign
      233           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      234         .
      235         assign
      236           v-waitfram-action01 = " "
      237           v-waitfram-action02 = " "
      238                                    + fill(" ", v-left-margin)
      239                                    + p-message
      240           v-waitfram-action03 = " "
      241         .
      242       end.
      243       else do:
      244         define variable vRindex1 as integer no-undo.
      245         define variable vRindex2 as integer no-undo.
      246         vRindex1 = r-index(p-message," ",70).
      247         if vRindex1 = 0
      248         then
      249            vRindex1 = 70.
      250         if length(p-message)  <= vRindex1 + 70 then do:
      251           assign
      252             v-waitfram-action01 = " "
      253             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      254             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      255           .
      256         end.
      257         else do:
      258           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      259           if vRindex2 <= vRindex1
      260           then
      261              vRindex2 = vRindex1 + 70.
      262           assign
      263             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      264             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      265             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      266           .
      267         end.
      268       end.
      269       B-viewProcInfo:visible   in frame waitfram = no.
      270       B-viewProcInfo:sensitive in frame waitfram = no.
      271       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      272       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      273       if  (   mWaitFramView
      274          or  mWaitProcEvent)
      275          and not mBatchMode
      276       then
      277          display
      278             v-waitfram-action01 skip
      279             v-waitfram-action02 skip
      280             v-waitfram-action03 skip
      281          with frame waitfram .
      282       if     mWaitFramView
      283          then do:
      284             if     mWaitFramInterval ne ?
      285                and not mBatchMode
      286             then
      287                wait-for go of frame waitfram pause mWaitFramInterval.
      288          end.
      289          else
      290             if     mWaitProcEvent
      291                and not mBatchMode
      292             then
      293                process events .
      294     end.
      295   end procedure.
      296      procedure waitfram-show-this:
      297         define input  parameter iInterval as int64 no-undo.
      298         define variable vtime as int64 no-undo.
      299         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      300         mWaitFramInterval = iInterval.
      301         run waitfram-show (substitute("&1&2 &3&4" ,
      302                                       mWaitFramTextBeg ,
      303                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      304                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      305                                       mWaitFramTextEnd
      306                                      )
      307                           ).
      308      end.
      309      procedure WaitFramRunPause:
      310         define input  parameter iInterval as dec no-undo.
      311         define variable vStart  as datetime-tz no-undo.
      312         define variable vend    as datetime-tz no-undo.
      313         define variable vint as int64 no-undo.
      314         define variable vOk as logical no-undo.
      315         vStart = now.
      316         vend   = vStart.
      317         publish "WaitFramPause" (iInterval,output vOk).
      318         vend   =  now.
      319         vint = vend - vStart.
      320         vint = iInterval - vint / 1000.
      321         if     not mWaitFramStop
      322            and (   vint > 0
      323                 or (    not vOk
      324                     and iInterval eq ?
      325                     )
      326                 )
      327         then
      328            run waitfram-show-this (iInterval).
      329         vend   =  now.
      330         vint = vend - vStart.
      331         vint = iInterval - vint / 1000.
      332         if     not mWaitFramStop
      333            and vint > 0
      334         then do:
      335            run gbl/pause.p (vint * 1000).
      336         end.
      337         if iInterval ne ?
      338         then
      339            publish "WaitFramStop".
      340         waitfram-check-timeout().
      341      end.
      342      procedure WaitFramWaitFor:
      343         define input  parameter iInterval as dec no-undo.
      344         assign
      345            mWaitFramStartProc   = now
      346            mWaitFramStopUser    = no
      347            mWaitFramStopTimeOut = no
      348         .
      349         block-wait:
      350         do while not mWaitFramStop:
      351            run WaitFramRunPause (iInterval).
      352            if  waitfram-check-timeout()
      353            then do:
      354               leave block-wait.
      355            end.
      356         end.
      357         run waitfram-hide.
      358      end.
      359   procedure waitfram-join :
      360     define input  parameter p-line-1  as character no-undo .
      361     define input  parameter p-line-2  as character no-undo .
      362     define input  parameter p-line-3  as character no-undo .
      363     define output parameter p-message as character no-undo .
      364     do
      365     on error undo, return error return-value
      366     :
      367       assign
      368         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      369                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      370                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      371       .
      372     end.
      373   end procedure.
      374   function waitfram-join-function returns character
      375     (input p-line-1 as character
      376     ,input p-line-2 as character
      377     ,input p-line-3 as character
      378     ).
      379     define variable v-message as character no-undo .
      380     run waitfram-join in this-procedure
      381       (input  p-line-1
      382       ,input  p-line-2
      383       ,input  p-line-3
      384       ,output v-message
      385       ) .
      386     return v-message .
      387   end function .
      388   define variable vss-include-info1 as character format "X(65)" no-undo
      389   initial "@(#)$Workfile$ $Revision$".
      390   define temp-table temp_p-fmt_string-part no-undo
      391       field str-key       as integer
      392       field string-part   as character
      393       index pi is primary unique
      394           str-key
      395   .
      396   define variable v-p-fmt-1-str-key    as integer      no-undo.
      397   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
      398                                     iInput AS INTEGER).
      399     def var v-start-print as integer no-undo .
      400     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
      401     assign
      402       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
      403     .
      404     RETURN v-start-print .
      405   END FUNCTION.
      406   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
      407                                     iInput AS INTEGER).
      408     def var v-start-print as integer no-undo .
      409     assign
      410       v-start-print = INTEGER(iEndPix - 1 - iInput)
      411     .
      412     if v-start-print < 0 then return 0.
      413     RETURN v-start-print .
      414   END FUNCTION.
      415   function p-fmt-align-string returns character (
      416         p-in-string      as character
      417       , p-page-width     as integer
      418       , p-align-type     as character
      419   ).
      420       define variable v-string-length     as integer      no-undo.
      421       define variable v-out-string        as character    no-undo.
      422       assign
      423           v-string-length = length( trim( p-in-string ) )
      424       .
      425       if v-string-length >= p-page-width
      426       then do:
      427           assign
      428               v-out-string = trim( p-in-string )
      429           .
      430       end.
      431       else do:
      432           case p-align-type
      433           :
      434               when 'left':U
      435               then do:
      436                   assign
      437                       v-out-string = trim( p-in-string )
      438                   .
      439               end.
      440               when 'right':U
      441               then do:
      442                   assign
      443                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
      444                   .
      445               end.
      446               when 'center':U
      447               then do:
      448                   assign
      449                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
      450                   .
      451               end.
      452           end case.
      453       end.
      454       return v-out-string .
      455   end function.
      456   procedure p-fmt-split-string :
      457   define input parameter p-source-string  as character        no-undo.
      458   define input parameter p-split-length   as integer          no-undo.
      459   define output parameter p-string-1      as character        no-undo.
      460   define output parameter p-string-2      as character        no-undo.
      461   do
      462   on error undo, return error
      463   :
      464       define variable v-space-pos    as integer      no-undo.
      465       if length( p-source-string ) <= p-split-length
      466       then do:
      467           assign
      468               p-string-1 = p-source-string
      469           .
      470       end.
      471       else do:
      472           assign
      473               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
      474           .
      475           if v-space-pos = 0
      476           then do:
      477               assign
      478                   v-space-pos = index( p-source-string, " ":U )
      479               .
      480           end.
      481           if v-space-pos = 0
      482           then do:
      483               assign
      484                   p-string-1 = substring( p-source-string, 1, p-split-length )
      485                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
      486               .
      487           end.
      488           else do:
      489               assign
      490                   p-string-1 = substring( p-source-string, 1, v-space-pos )
      491                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
      492               .
      493           end.
      494       end.
      495   end.
      496   end procedure.
      497   procedure p-fmt-round :
      498   define input parameter p-qnty               as decimal          no-undo.
      499   define input parameter p-price-no-VAT       as decimal          no-undo.
      500   define input parameter p-VAT                as decimal          no-undo.
      501   define input parameter p-SLT                as decimal          no-undo.
      502   define input parameter p-road-tax           as decimal          no-undo.
      503   define output parameter p-new-price-no-VAT  as decimal          no-undo.
      504   define output parameter p-new-VAT           as decimal          no-undo.
      505   define output parameter p-new-SLT           as decimal          no-undo.
      506   define output parameter p-new-sum-VAT       as decimal          no-undo.
      507   define output parameter p-new-sum-SLT       as decimal          no-undo.
      508   define output parameter p-new-sum-road-tax  as decimal          no-undo.
      509   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
      510   define output parameter p-new-sum-full      as decimal          no-undo.
      511       define variable v-vat-pc    as decimal      no-undo.
      512       define variable v-slt-pc    as decimal      no-undo.
      513   do
      514   on error undo, return error
      515   :
      516       if p-price-no-VAT = 0
      517       then do:
      518           assign
      519               p-new-price-no-VAT = 0.0
      520               p-new-VAT          = ?
      521               p-new-SLT          = ?
      522               p-new-sum-VAT      = 0.0
      523               p-new-sum-SLT      = 0.0
      524               p-new-sum-no-VAT   = 0.0
      525               p-new-sum-road-tax = 0.0
      526               p-new-sum-full     = 0.0
      527           .
      528       end.
      529       else do:
      530           assign
      531               v-vat-pc            = p-VAT / p-price-no-VAT
      532               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
      533               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
      534               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
      535               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
      536               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
      537               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
      538               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
      539               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
      540               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
      541           .
      542       end.
      543   end.
      544   end procedure.
      545   procedure p-fmt-split :
      546   define input parameter p-in-string      as character        no-undo.
      547   define input parameter p-split-length   as integer          no-undo.
      548       define variable v-start-pos     as integer      no-undo.
      549       define variable v-end-pos       as integer      no-undo.
      550       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
      551   do
      552   for buf_temp_p-fmt_string-part
      553   on error undo, return error
      554   :
      555       empty temp-table buf_temp_p-fmt_string-part.
      556       if p-split-length < 1
      557       then do:
      558           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
      559       end.
      560       assign
      561           p-in-string                 = trim( p-in-string )
      562           v-p-fmt-1-str-key   = 0
      563           v-start-pos                 = 1
      564           v-end-pos                   = length( p-in-string )
      565       .
      566       run p-fmt-get-string-range in this-procedure (
      567             input p-in-string
      568           , input p-split-length
      569           , input v-start-pos
      570           , output v-start-pos
      571           , output v-end-pos
      572       ).
      573       do while v-end-pos <> 0
      574       :
      575           create buf_temp_p-fmt_string-part.
      576           assign
      577               v-p-fmt-1-str-key = v-p-fmt-1-str-key + 1
      578           .
      579           assign
      580               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-1-str-key
      581               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
      582           .
      583           assign
      584               v-start-pos = v-end-pos + 1
      585           .
      586           run p-fmt-get-string-range in this-procedure (
      587                 input p-in-string
      588               , input p-split-length
      589               , input v-start-pos
      590               , output v-start-pos
      591               , output v-end-pos
      592           ).
      593       end.
      594   end.
      595   end procedure.
      596   procedure p-fmt-get-string-range :
      597   define input parameter p-in-string      as character        no-undo.
      598   define input parameter p-split-length   as integer          no-undo.
      599   define input parameter p-old-start-pos  as integer          no-undo.
      600   define output parameter p-start-pos     as integer          no-undo.
      601   define output parameter p-end-pos       as integer          no-undo.
      602       define variable v-init-string    as character    no-undo.
      603       define variable v-temp-char      as character    no-undo.
      604       define variable v-temp-pos       as integer      no-undo.
      605       define variable v-counter        as integer      no-undo.
      606   do
      607   on error undo, return error
      608   :
      609       assign
      610           p-start-pos   = p-old-start-pos
      611           v-init-string = substring( p-in-string, p-start-pos )
      612       no-error.
      613       if error-status :error
      614       or trim( v-init-string ) = "":U
      615       then do:
      616           assign
      617               p-end-pos = 0
      618           .
      619           undo, return .
      620       end.
      621       assign
      622           v-temp-char   = substring( v-init-string, 1, 1 )
      623       .
      624       do
      625       while trim( v-temp-char ) = "":U
      626       :
      627           assign
      628               p-start-pos     = p-start-pos + 1
      629               v-init-string   = substring( p-in-string, p-start-pos )
      630               v-temp-char     = substring( v-init-string, 1, 1 )
      631           .
      632       end.
      633       assign
      634           v-temp-pos  = p-split-length
      635           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      636           v-counter   = 0
      637       .
      638       search-word-end:
      639       do
      640       while trim( v-temp-char ) <> "":U
      641       :
      642           assign
      643               v-counter   = v-counter + 1
      644           .
      645           if v-counter > 20
      646           then do:
      647               assign
      648                   v-temp-pos  = p-split-length
      649               .
      650               leave search-word-end.
      651           end.
      652           assign
      653               v-temp-pos  = v-temp-pos - 1
      654               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      655           .
      656       end.
      657       assign
      658           p-end-pos = p-start-pos + v-temp-pos - 1
      659       .
      660   end.
      661   end procedure.
