      696   procedure prn-lib-prn-file :
      697     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      698     define input parameter p-DIsabledoptions as integer no-undo .
      699     define variable v-report-name as character no-undo .
      700     define variable v-user-action as character no-undo .
      701     define variable v-printed     as logical   no-undo .
      702     define variable v-exist       as logical   no-undo .
      703     do
      704       on error undo, return error
      705       :
      706       run prn-lib-get-report-name  in this-procedure (
      707         input parParentProc
      708         ,output v-report-name
      709         ).
      710   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      711   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      712     (input  v-report-name
      713     ,input  2
      714     ,output v-exist
      715     )  .
      716       if NOT v-exist then
      717       DO:
      718         Message
      719           "Нет заданий на печать ! "
      720           view-as alert-box .
      721         Return  .
      722       End.
      723       run gbl/prnfilen.w
      724         (input  ""
      725         ,input  p-DisabledOptions
      726         ,input  string(v-report-name )
      727         ,input  7
      728         ,output v-user-action
      729         ,output v-printed
      730         ) .
      731       if v-printed then
      732       do:
      733         return "YES" .
      734       end.
      735       else
      736       do:
      737         return "NO" .
      738       end.
      739     end.
      740   end procedure.
      741   procedure prn-lib-open-stream :
      742     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      743     define input parameter p-page-size    as integer no-undo .
      744     define input parameter p-is-stream    as logical no-undo .
      745     define input parameter p-append       as logical no-undo .
      746     define variable v-report-name as character no-undo .
      747     do
      748       on error undo, return error
      749       :
      750       run prn-lib-get-report-name  in this-procedure (
      751         input parParentProc
      752         ,output v-report-name
      753         ).
      754       if p-is-stream then
      755       do:
      756         if p-append then
      757         do:
      758           output stream PrnLibStream to value( v-report-name )
      759             page-size value(p-page-size) append .
      760         end.
      761         if not p-append then
      762         do:
      763           output stream PrnLibStream to value( v-report-name )
      764             page-size value(p-page-size) .
      765         end.
      766       end.
      767       if not p-is-stream then
      768       do:
      769         if p-append then
      770         do:
      771           output to value( v-report-name )
      772             page-size value(p-page-size) append .
      773         end.
      774         if not p-append then
      775         do:
      776           output to value( v-report-name )
      777             page-size value(p-page-size) .
      778         end.
      779       end.
      780     end.
      781   end procedure.
      782   procedure prn-lib-open-exp :
      783     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      784     define input parameter p-is-stream    as logical no-undo .
      785     define input parameter p-is-append    as logical no-undo .
      786     define output parameter p-ReportFileName as char init "report" no-undo.
      787     define output parameter p-process as logical no-undo .
      788     define variable glog as logical no-undo .
      789     do
      790       on error undo, return error
      791       :
      792       SYSTEM-DIALOG GET-FILE p-ReportFileName
      793         TITLE      "Укажите путь"
      794         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      795         ASK-OVERWRITE
      796         CREATE-TEST-FILE
      797         SAVE-AS
      798         USE-FILENAME
      799         DEFAULT-EXTENSION "txt"
      800         UPDATE glog
      801         .
      802       if not glog then  return.
      803       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      804       if p-is-stream then
      805       do:
      806         if p-is-append then
      807         do:
      808           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      809         end.
      810         else
      811         do:
      812           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      813         end.
      814       end.
      815       else
      816       do:
      817         if p-is-append then
      818         do:
      819           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      820         end.
      821         else
      822         do:
      823           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      824         end.
      825       end.
      826       p-process = yes.
      827     end.
      828   end procedure.
      829   procedure prn-lib-get-report-name :
      830     define input parameter parParentProc  as widget-handle no-undo.
      831     define output parameter p-report-name as character no-undo .
      832     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      833   end procedure.
      834   procedure prn-lib-reportviewer-report-name :
      835     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      836     define input parameter p-report-name-html as character no-undo .
      837     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
