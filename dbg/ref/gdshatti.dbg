      358   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      359   define temp-table tt-attr-property  no-undo
      360   field upper-attr-code as character
      361   field attr-code as character
      362   field table-name as character
      363   field edit-menu-section-num as integer
      364   field attr-label as character
      365   field menu-item-handle as widget-handle
      366   field user-can-edit as logical
      367   field menu-name as character
      368   field parent-handle as handle
      369   index pi is unique primary
      370   table-name
      371   menu-name
      372   upper-attr-code
      373   attr-code
      374   index i-section
      375   edit-menu-section-num
      376   .
      377   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      378   procedure attr-pop-create-items :
      379   define input parameter p-table-name as character no-undo .
      380   define input parameter p-get-section-num-proc-name as character no-undo .
      381   define input parameter p-get-attr-label-proc-name as character no-undo .
      382   define input parameter p-attr-choose-proc-name as character no-undo .
      383   define input parameter p-menu-handle as widget-handle no-undo .
      384   define input parameter p-attr-list as character no-undo .
      385   define variable ii as integer no-undo .
      386   define variable V-CREATED as logical no-undo .
      387   define variable v-tool-tip as character no-undo .
      388   define variable v-dop as character no-undo .
      389   define variable v-attr-item as character no-undo .
      390   define variable p-upper-attr-code as character no-undo .
      391   define buffer buf_tt-attr-property for tt-attr-property.
      392     do
      393     on error undo, return error return-value
      394     :
      395        do ii = 1 to num-entries (p-attr-list):
      396          v-attr-item = entry(ii, p-attr-list) .
      397          find first tt-attr-property where
      398                    tt-attr-property.table-name = p-table-name
      399                and tt-attr-property.attr-code = v-attr-item
      400                and tt-attr-property.upper-attr-code = p-upper-attr-code
      401                and tt-attr-property.menu-name = p-menu-handle:name  no-error .
      402          if not available tt-attr-property then do:
      403            create tt-attr-property.
      404            assign
      405            tt-attr-property.table-name = p-table-name
      406            tt-attr-property.attr-code = v-attr-item
      407            tt-attr-property.upper-attr-code = p-upper-attr-code
      408            tt-attr-property.menu-name = p-menu-handle:name
      409            .
      410            run value ( p-get-section-num-proc-name) (
      411                                                      input tt-attr-property.attr-code
      412                                                     ,output tt-attr-property.edit-menu-section-num ) no-error .
      413            run value ( p-get-attr-label-proc-name ) (
      414                                           input tt-attr-property.attr-code
      415                                          ,output v-tool-tip
      416                                          ,output tt-attr-property.attr-label
      417                                         ) no-error .
      418            release tt-attr-property.
      419          end.
      420        end.
      421        for each tt-attr-property where tt-attr-property.menu-name = p-menu-handle:name
      422        break
      423        by  tt-attr-property.edit-menu-section-num
      424        by  tt-attr-property.attr-label
      425        :
      426          if tt-attr-property.edit-menu-section-num > 0
      427          then do:
      428             if not valid-handle(tt-attr-property.menu-item-handle) then do:
      429               if num-entries(tt-attr-property.attr-code, chr(4)) > 1
      430               and entry(2, tt-attr-property.attr-code, chr(4)) <> '':U
      431               then do:
      432                 find first buf_tt-attr-property where
      433                           buf_tt-attr-property.table-name = p-table-name
      434                       and buf_tt-attr-property.menu-name = p-menu-handle:name
      435                       and buf_tt-attr-property.upper-attr-code = p-upper-attr-code
      436                       and buf_tt-attr-property.attr-code = entry(1, tt-attr-property.attr-code, chr(4)) no-error .
      437                 if not available buf_tt-attr-property then do:
      438                   create buf_tt-attr-property.
      439                   assign
      440                   buf_tt-attr-property.table-name = p-table-name
      441                   buf_tt-attr-property.attr-code = entry(1, tt-attr-property.attr-code, chr(4))
      442                   buf_tt-attr-property.upper-attr-code = p-upper-attr-code
      443                   buf_tt-attr-property.menu-name = p-menu-handle:name
      444                   .
      445                   create sub-menu buf_tt-attr-property.menu-item-handle
      446                   assign
      447                   name = entry(1, tt-attr-property.attr-code, chr(4))  + chr(4)  + p-menu-handle:name
      448                   parent = p-menu-handle.
      449                 end.
      450                 create menu-item tt-attr-property.menu-item-handle
      451                 assign
      452                 label = tt-attr-property.attr-label
      453                 name = tt-attr-property.attr-code  + chr(4)  + p-menu-handle:name
      454                 parent = buf_tt-attr-property.menu-item-handle
      455                 triggers:
      456                   on choose
      457                     persistent run value(p-attr-choose-proc-name + "-2") (
      458                                                                            input  entry(1, tt-attr-property.attr-code, chr(4) )
      459                                                                           ,input entry(2, tt-attr-property.attr-code, chr(4) )
      460                                                                             ) .
      461                 end triggers.
      462                 assign
      463                 v-created = yes.
      464               end.
      465               else do:
      466                 create menu-item tt-attr-property.menu-item-handle
      467                 assign
      468                 label = tt-attr-property.attr-label
      469                 name = entry(1, tt-attr-property.attr-code, chr(4)) + chr(4)  + p-menu-handle:name
      470                 parent = p-menu-handle
      471                 triggers:
      472                   on choose
      473                     persistent run value(p-attr-choose-proc-name) (
      474                                                                    input  entry(1, tt-attr-property.attr-code, chr(4) )) .
      475                 end triggers.
      476                 assign
      477                 v-created = yes.
      478               end.
      479             end.
      480             if last-of(tt-attr-property.edit-menu-section-num)
      481               then do:
      482               find first buf_tt-attr-property where
      483                         buf_tt-attr-property.table-name = p-table-name
      484                    and  buf_tt-attr-property.attr-code = substitute("&1&2&3"
      485                                                            , p-table-name
      486                                                            , tt-attr-property.edit-menu-section-num
      487                                                            , p-menu-handle:name
      488                                                            )
      489                     and buf_tt-attr-property.menu-name = p-menu-handle:name  no-error .
      490               if not available buf_tt-attr-property then do:
      491                 create buf_tt-attr-property.
      492                 assign
      493                 buf_tt-attr-property.table-name = p-table-name
      494                 buf_tt-attr-property.edit-menu-section-num =  - 1
      495                 buf_tt-attr-property.menu-name = p-menu-handle:name
      496                 buf_tt-attr-property.upper-attr-code = ''
      497                 buf_tt-attr-property.attr-code = substitute("&1&2&3"
      498                                                             , p-table-name
      499                                                             , tt-attr-property.edit-menu-section-num
      500                                                             , p-menu-handle:name
      501                                                             )
      502                 .
      503                 create menu-item buf_tt-attr-property.menu-item-handle
      504                 assign
      505                 subtype = "rule"
      506                 parent = p-menu-handle
      507                 .
      508               end.
      509             end.
      510          end.
      511        end.
      512        if not v-created then do:
      513           run attr-pop-clean-up in this-procedure ( input p-table-name).
      514        end.
      515     end.
      516   end procedure.
      517   procedure attr-pop-clean-up :
      518   define input parameter p-table-name as character no-undo .
      519     for each tt-attr-property where
      520             tt-attr-property.table-name = p-table-name
      521       and tt-attr-property.edit-menu-section-num > 0:
      522       if valid-handle ( tt-attr-property.menu-item-handle) then do:
      523         delete widget tt-attr-property.menu-item-handle.
      524       end.
      525       delete tt-attr-property.
      526     end.
      527     for each tt-attr-property where
      528              tt-attr-property.table-name = p-table-name
      529          and tt-attr-property.edit-menu-section-num =  - 1:
      530       if valid-handle ( tt-attr-property.menu-item-handle) then do:
      531         delete widget tt-attr-property.menu-item-handle.
      532       end.
      533       delete tt-attr-property.
      534     end.
      535   end procedure.
      536   define variable updated as logical no-undo.
      537   define variable add-option as char no-undo.
      538   define variable temp-doc-rec as recid no-undo.
      539   DEFINE VARIABLE v-host-name AS CHARACTER NO-UNDO.
      540   DEFINE VARIABLE v-host-code LIKE ub.sysconf.host-code NO-UNDO.
      541   define variable v-tab-order as character no-undo .
      542   define buffer buf_clients for ub.clients.
      543   DEFINE MENU MENU-b-add .
      544   DEFINE BUTTON b-add
      545        LABEL "&Добавить":L
      546        SIZE 10 BY 1 TOOLTIP "Добавить атрибут товара".
      547   DEFINE BUTTON b-chg
      548        LABEL "&Изменить":L
      549        SIZE 10 BY 1 TOOLTIP "Изменить атрибут товара на фирме".
      550   DEFINE BUTTON b-del
      551        LABEL "&Удалить":L
      552        SIZE 10 BY 1 TOOLTIP "Удалить  атрибут товара на фирме".
      553   DEFINE BUTTON B-exit AUTO-GO
      554        LABEL "&Ввод"
      555        SIZE 10 BY 1 TOOLTIP "Выход с сохранением".
      556   DEFINE BUTTON b-help
      557        LABEL "Помо&щь":L
      558        SIZE 3 BY 1.
      559   DEFINE BUTTON b-lkp
      560        LABEL "&Просмотр"
      561        SIZE 10 BY 1.
      562   DEFINE BUTTON b-quit AUTO-END-KEY
      563        LABEL "&Отмена":L
      564        SIZE 10 BY 1 TOOLTIP "Выход из режима".
      565   DEFINE VARIABLE goods-artic AS CHARACTER FORMAT "X(16)":U
      566         VIEW-AS TEXT
      567        SIZE 16.4 BY 1
      568        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      569   DEFINE VARIABLE Goods-dsc-name AS CHARACTER FORMAT "X(60)":U
      570         VIEW-AS TEXT
      571        SIZE 61.6 BY 1
      572        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      573   DEFINE VARIABLE goods-gds-code AS INTEGER FORMAT ">>>>>>>>>>":U INITIAL 0
      574         VIEW-AS TEXT
      575        SIZE 11 BY 1
      576        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      577   DEFINE VARIABLE goods-prod-code AS INTEGER FORMAT ">>>>>>>>>":U INITIAL 0
      578         VIEW-AS TEXT
      579        SIZE 9.6 BY 1
      580        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      581   DEFINE VARIABLE goods-prod-name AS CHARACTER FORMAT "X(60)":U
      582         VIEW-AS TEXT
      583        SIZE 46.8 BY 1
      584        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      585   DEFINE VARIABLE goods-prod-type AS CHARACTER FORMAT "X(3)":U
      586         VIEW-AS TEXT
      587        SIZE 3.8 BY 1
      588        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      589   DEFINE QUERY br-attr FOR
      590         Temp-hattr SCROLLING.
      591   DEFINE BROWSE br-attr
      592     QUERY br-attr DISPLAY
      593         Temp-hattr.attr-code COLUMN-LABEL "Атрибут" FORMAT "X(50)":U
      594         Temp-hattr.attr-value COLUMN-LABEL "Значение" FORMAT "X(256)":U
      595               WIDTH 23
      596       WITH NO-ROW-MARKERS SEPARATORS SIZE 79 BY 15.33.
      597   DEFINE FRAME Dialog-Frame
      598        B-exit AT ROW 1 COL 1
      599        b-quit AT ROW 1 COL 11
      600        b-add AT ROW 1 COL 21
      601        b-lkp AT ROW 1 COL 31
      602        b-chg AT ROW 1 COL 41
      603        b-del AT ROW 1 COL 51
      604        b-help AT ROW 1.03 COL 78
      605        br-attr AT ROW 4.47 COL 1
      606        goods-artic AT ROW 2.13 COL 1.9 NO-LABEL
      607        Goods-dsc-name AT ROW 2.13 COL 19 NO-LABEL
      608        goods-gds-code AT ROW 3.3 COL 1.8 NO-LABEL
      609        goods-prod-type AT ROW 3.3 COL 19 NO-LABEL
      610        goods-prod-code AT ROW 3.3 COL 23.4 NO-LABEL
      611        goods-prod-name AT ROW 3.3 COL 33.8 NO-LABEL
      612        SPACE(0.64) SKIP(15.65)
      613       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      614            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      615            TITLE "Атрибуты товара на фирме".
      616   ASSIGN
      617          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      618          FRAME Dialog-Frame:HIDDEN           = TRUE.
      619   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      620   DO:
      621     APPLY "END-ERROR":U TO SELF.
      622   END.
      623   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      624   DO:
      625   define buffer buf_temp-hattr for temp-hattr.
      626   if add-option = "" then do:
      627     run gbl/pop-up.p ( input self:handle, input no) no-error.
      628   end.
      629   if add-option = "":U then return no-apply.
      630   run proc-add-chg in this-procedure ( input yes) no-error .
      631   if error-status:error then do:
      632     add-option = "":U.
      633     return no-apply.
      634   end.
      635   OPEN QUERY br-attr FOR EACH Temp-hattr NO-LOCK.
      636   find first buf_temp-hattr no-lock where
      637                           buf_temp-hattr.code = add-option no-error.
      638   add-option = "":U.
      639   if avail buf_temp-hattr then
      640       temp-doc-rec = recid(buf_temp-hattr).
      641       else temp-doc-rec = ?.
      642   reposition br-attr to recid temp-doc-rec no-error.
      643   if error-status:error then return no-apply.
      644   END.
      645   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      646   DO:
      647     if not avail temp-hattr then return NO-APPLY.
      648     run proc-add-chg in this-procedure ( input no) no-error .
      649     if error-status:error then return no-apply.
      650     OPEN QUERY br-attr FOR EACH Temp-hattr NO-LOCK.
      651   END.
      652   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      653   DO:
      654   define variable loc#log as logical no-undo.
      655   define variable attr-type as character no-undo .
      656   define variable attr-format as character no-undo .
      657   define variable attr-label as character no-undo .
      658   define variable attr-user-can-edit as logical no-undo .
      659   define variable attr-output-display as logical no-undo .
      660   define variable attr-other as char no-undo .
      661   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
      662     if not avail temp-hattr then return no-apply.
      663   run gdshattr-name in this-procedure (
      664                                         input   temp-hattr.code
      665                                         ,output attr-type
      666                                         ,output attr-format
      667                                         ,output attr-label
      668                                         ,output attr-user-can-edit
      669                                         ,output attr-output-display
      670                                         ,output attr-other
      671                                                         ).
      672     if not attr-user-can-edit then do:
      673       message
      674       "Атрибут нельзя удалить вручную"
      675       view-as alert-box error .
      676       return no-apply.
      677     end.
      678     glog = no.
      679     message "Вы уверены, что хотите удалить атрибут " temp-hattr.attr-code skip
      680             "на фирме " v-host-name " для товара " goods-dsc-name
      681             view-as alert-box QUESTIOn buttons YES-NO update glog.
      682     if NOT glog then return no-apply.
      683     delete temp-hattr.
      684     updated = yes.
      685     OPEN QUERY br-attr FOR EACH Temp-hattr NO-LOCK.
      686   END.
      687   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      688   DO:
      689      RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      690     IF ERROR-STATUS:ERROR THEN DO:
      691        RETURN NO-APPLY.
      692     END.
      693   END.
      694   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
      695   DO:
      696     if not avail temp-hattr then return no-apply.
      697     RUN proc-b-lkp IN THIS-PROCEDURE NO-ERROR.
      698     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      699   END.
      700   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      701   on help of frame Dialog-Frame
      702   do:
      703     run gbl/app_help.p
      704       (input this-procedure :file-name
      705       ,input ''
      706       ,input ?
      707       ) no-error.
      708     if error-status :error then do:
      709       message
      710         "Ошибка при вызове помощи"
      711         error-status :get-message(1)
      712         view-as alert-box .
      713     end.
      714   end.
      715   run minbtn-set in this-procedure .
      716   on choose of b-help in frame Dialog-Frame
      717   do:
      718     apply "help":u to frame Dialog-Frame .
      719   end.
      720   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      721   procedure minbtn-set :
      722       do
      723           on error undo, return error return-value
      724           :
      725           define variable ii              as integer       no-undo .
      726           define variable fh              as widget-handle no-undo .
      727           define variable hh              as widget-handle no-undo .
      728           define variable v-h             as handle        extent 4 no-undo .
      729           define variable v-name-button   as character     no-undo .
      730           define variable v-help-old-x    as decimal       no-undo .
      731           define variable v-help-old-y    as decimal       no-undo .
      732           define variable v-help-old-size as decimal       no-undo .
      733           define variable v-frame-width   as decimal       no-undo .
      734           define variable jj              as integer       no-undo .
      735           do
      736               on error undo, return error
      737               :
      738               assign
      739                   v-frame-width = frame Dialog-Frame:width - 0.3
      740                   fh            = frame Dialog-Frame:first-child
      741                   hh            = fh:first-child
      742                   ii            = 1
      743                   .
      744               do while valid-handle(hh):
      745                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      746                   do:
      747                       case lc(hh:name) :
      748                           when "b-help" then
      749                               do:
      750                                   hh:load-image-up("cmp/b-help.bmp":u) .
      751                                   hh:load-image-down("cmp/b-help.bmp":u) .
      752                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      753                                   hh:TOOLTIP = "Помощь" .
      754                                   v-help-old-x = hh:column .
      755                                   v-help-old-y = hh:row    .
      756                                   v-help-old-size = hh:width .
      757                                   hh:width-chars = 2.5 .
      758                               end.
      759                           when "b-print" then
      760                               do:
      761                                   hh:load-image("cmp/b-print.bmp":u) .
      762                                   hh:TOOLTIP = "Печать" .
      763                                   v-h[ii] = hh:handle .
      764                                   ii = ii + 1 .
      765                                   hh:width-chars = 3 .
      766                               end.
      767                           when "b-history" or
      768                           when "b-hist" then
      769                               do:
      770                                   hh:load-image("cmp/b-hist.bmp":u) .
      771                                   hh:TOOLTIP = "История" .
      772                                   v-h[ii] = hh:handle .
      773                                   ii = ii + 1 .
      774                                   hh:width-chars = 3 .
      775                               end.
      776                           when "b-sch" then
      777                               do:
      778                                   hh:load-image("cmp/b-sch.bmp":u) .
      779                                   hh:TOOLTIP = "Установка Фильтра" .
      780                                   v-h[ii] = hh:handle .
      781                                   ii = ii + 1 .
      782                                   hh:width-chars = 3 .
      783                               end.
      784                           when "b-hist-user" then
      785                               do:
      786                                   hh:load-image("cmp/b-hist.bmp":u) .
      787                                   hh:TOOLTIP = "История пользователя" .
      788                                   ii = ii + 1 .
      789                               end.
      790                       end case.
      791                   end.
      792                   hh = hh:next-sibling.
      793               end.
      794               b-help:column = v-frame-width - b-help:width-chars.
      795               jj = 0.
      796               repeat ii = 4 to 1 by -1 :
      797                   if valid-handle (v-h[ii] ) then
      798                   do:
      799                       jj  = jj + 1 .
      800                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      801                       v-h[ii]:row    = v-help-old-y .
      802                   end.
      803               end.
      804           end.
      805       end.
      806   end procedure.
      807   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      808   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      809   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      810   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      811   define variable v-diasize-current-frame-width  as decimal   no-undo .
      812   define variable v-diasize-current-frame-height as decimal   no-undo .
      813   define variable v-diasize-change-size          as logical   no-undo .
      814   define variable v-diasize-resize-button        as handle    no-undo .
      815   define variable v-diasize-wndmax               as logical   no-undo .
      816   define variable v-diasize-wndstore             as logical   no-undo .
      817   define variable v-diasize-proc-name            as character no-undo .
      818   define variable v-diasize-browse-handle        as handle    no-undo .
      819   define variable v-diasize-browse-number        as integer   no-undo .
      820   define variable v-diasize-need-full-display    as logical   no-undo init false .
      821   define temp-table temp-diasize-handle no-undo
      822     field handle-value  as handle
      823     field save-position as decimal
      824     index xpk is primary unique handle-value
      825     .
      826   define temp-table temp-browse-handle no-undo
      827     field browse-type   as character
      828     field browse-number as integer
      829     field browse-handle as handle
      830     field original-size as decimal
      831     index xpk is primary unique browse-type browse-number
      832     index xie browse-type browse-handle
      833   .
      834   procedure diasize_change-height :
      835     define input  parameter p-change-value  as decimal   no-undo .
      836     define input  parameter p-move-resize   as logical   no-undo .
      837     define variable v-field-group-handle    as handle    no-undo .
      838     define variable v-object-handle         as handle    no-undo .
      839     define variable v-frame-height          as decimal   no-undo .
      840     define variable v-frame-virtual-height  as decimal   no-undo .
      841     define variable v-browse-height         as decimal   no-undo .
      842     define variable v-window-height         as decimal   no-undo .
      843     define variable v-window-virtual-height as decimal   no-undo .
      844     define variable v-change-sign           as integer   no-undo .
      845     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      846     define buffer buf_temp-browse-handle  for temp-browse-handle .
      847     if p-change-value > 0
      848     then do:
      849       if frame Dialog-Frame :height + p-change-value
      850           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      851       then do:
      852         assign
      853           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      854                           - (frame Dialog-Frame :height-chars)
      855         .
      856         if p-change-value <= 0
      857         then do:
      858           run diasize_position-resize-button in this-procedure .
      859           return .
      860         end.
      861       end.
      862     end.
      863     if p-change-value < 0
      864     then do:
      865       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      866       then do:
      867         assign
      868           p-change-value = v-diasize-orig-frame-height
      869                          - (frame Dialog-Frame :height-chars)
      870         .
      871         if p-change-value >= 0
      872         then do:
      873           run diasize_position-resize-button in this-procedure .
      874           return .
      875         end.
      876       end.
      877     end.
      878     if p-change-value >= 0
      879     then do:
      880       assign
      881         v-change-sign = 1
      882       .
      883     end.
      884     else do:
      885       assign
      886         v-change-sign = -1
      887       .
      888     end.
      889     assign
      890       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      891     .
      892     if p-change-value = 0
      893     then do:
      894       run diasize_position-resize-button in this-procedure .
      895       return .
      896     end.
      897     move_block:
      898     do
      899     on error undo move_block, retry move_block
      900     :
      901       if retry
      902       then do:
      903         do
      904         on error undo move_block, leave move_block
      905         :
      906           if p-change-value > 0
      907           then do:
      908             for each buf_temp-diasize-handle
      909             on error undo, next
      910             :
      911               assign
      912                 v-object-handle = buf_temp-diasize-handle.handle-value
      913               .
      914               if v-object-handle <> v-diasize-resize-button
      915               then do:
      916                 assign
      917                   v-object-handle :row = buf_temp-diasize-handle.save-position
      918                 .
      919               end.
      920             end.
      921             assign
      922               v-diasize-browse-handle :height = v-browse-height
      923             .
      924             for each buf_temp-browse-handle
      925               where buf_temp-browse-handle.browse-type = 'height':u
      926             on error undo, next
      927             :
      928               assign
      929                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      930               .
      931             end.
      932             assign
      933               frame Dialog-Frame :height = v-frame-height
      934             .
      935             if frame Dialog-Frame :scrollable = true
      936             then do:
      937               assign
      938                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      939               .
      940             end.
      941             run diasize_position-resize-button in this-procedure .
      942           end.
      943           else do:
      944             if frame Dialog-Frame :scrollable = true
      945             then do:
      946               assign
      947                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      948               .
      949             end.
      950             assign
      951               frame Dialog-Frame :height = v-frame-height
      952             .
      953             assign
      954               v-diasize-browse-handle :height = v-browse-height
      955             .
      956             for each buf_temp-browse-handle
      957               where buf_temp-browse-handle.browse-type = 'height':u
      958             on error undo, next
      959             :
      960               assign
      961                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      962               .
      963             end.
      964             for each buf_temp-diasize-handle
      965             on error undo, next
      966             :
      967               assign
      968                 v-object-handle = buf_temp-diasize-handle.handle-value
      969               .
      970               if v-object-handle <> v-diasize-resize-button
      971               then do:
      972                 assign
      973                   v-object-handle :row = buf_temp-diasize-handle.save-position
      974                 .
      975               end.
      976             end.
      977             run diasize_position-resize-button in this-procedure .
      978           end.
      979           assign
      980             v-diasize-change-size = false
      981           .
      982           leave move_block .
      983         end.
      984       end.
      985       assign
      986         v-diasize-need-full-display = true
      987       .
      988       if v-diasize-change-size = false
      989       then do:
      990         assign
      991           v-diasize-change-size = true
      992         .
      993       end.
      994       else do:
      995         return .
      996       end.
      997       assign
      998         v-frame-height = frame Dialog-Frame :height
      999         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1000         v-browse-height = v-diasize-browse-handle :height
     1001       .
     1002       for each buf_temp-browse-handle
     1003         where buf_temp-browse-handle.browse-type = 'height':u
     1004       :
     1005         assign
     1006           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1007         .
     1008       end.
     1009       for each buf_temp-diasize-handle
     1010       :
     1011         delete buf_temp-diasize-handle .
     1012       end.
     1013       assign
     1014         v-field-group-handle = frame Dialog-Frame :first-child
     1015       .
     1016       do while valid-handle(v-field-group-handle)
     1017       :
     1018         assign
     1019           v-object-handle = v-field-group-handle :first-child
     1020         .
     1021         do while valid-handle(v-object-handle)
     1022         :
     1023           if  v-object-handle <> v-diasize-browse-handle :handle
     1024           and can-query(v-object-handle, "row")
     1025           and can-query(v-object-handle, "height")
     1026           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1027           then do:
     1028             find first buf_temp-browse-handle
     1029               where buf_temp-browse-handle.browse-type   = 'height':u
     1030                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1031               no-error .
     1032             if available buf_temp-browse-handle
     1033             then do:
     1034             end.
     1035             else do:
     1036               create buf_temp-diasize-handle .
     1037               assign
     1038                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1039                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1040               .
     1041             end.
     1042           end.
     1043           assign
     1044             v-object-handle = v-object-handle :next-sibling
     1045           .
     1046         end.
     1047         assign
     1048           v-field-group-handle = v-field-group-handle :next-sibling
     1049         .
     1050       end.
     1051       do with frame Dialog-Frame
     1052       :
     1053         hide v-diasize-resize-button .
     1054         assign
     1055           v-diasize-resize-button :row    = 1
     1056           v-diasize-resize-button :column = 1
     1057         .
     1058       end.
     1059       if p-change-value > 0
     1060       then do:
     1061         if frame Dialog-Frame :scrollable = true
     1062         then do:
     1063           assign
     1064             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1065             no-error .
     1066           if error-status :error
     1067           or error-status :get-message(1) <> ""
     1068           then do:
     1069             undo move_block, retry move_block .
     1070           end.
     1071         end.
     1072         assign
     1073           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1074           no-error .
     1075         if error-status :error
     1076         or error-status :get-message(1) <> ""
     1077         then do:
     1078           undo move_block, retry move_block .
     1079         end.
     1080         assign
     1081           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1082           no-error .
     1083         if error-status :error
     1084         or error-status :get-message(1) <> ""
     1085         then do:
     1086           undo move_block, retry move_block .
     1087         end.
     1088         for each buf_temp-browse-handle
     1089           where buf_temp-browse-handle.browse-type = 'height':u
     1090         on error undo move_block, retry move_block
     1091         :
     1092           assign
     1093             buf_temp-browse-handle.browse-handle :height
     1094               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1095             no-error .
     1096           if error-status :error
     1097           or error-status :get-message(1) <> ""
     1098           then do:
     1099             undo move_block, retry move_block .
     1100           end.
     1101         end.
     1102         for each buf_temp-diasize-handle
     1103         on error undo move_block, retry move_block
     1104         :
     1105           assign
     1106             v-object-handle = buf_temp-diasize-handle.handle-value
     1107           .
     1108           if v-object-handle <> v-diasize-resize-button
     1109           then do:
     1110             assign
     1111               v-object-handle :row = v-object-handle :row + p-change-value
     1112               no-error .
     1113             if error-status :error
     1114             or error-status :get-message(1) <> ""
     1115             then do:
     1116               undo move_block, retry move_block .
     1117             end.
     1118           end.
     1119         end.
     1120       end.
     1121       else do:
     1122         for each buf_temp-diasize-handle
     1123         on error undo move_block, retry move_block
     1124         :
     1125           assign
     1126             v-object-handle = buf_temp-diasize-handle.handle-value
     1127           .
     1128           if v-object-handle <> v-diasize-resize-button
     1129           then do:
     1130             assign
     1131               v-object-handle :row = v-object-handle :row + p-change-value
     1132               no-error .
     1133             if error-status :error
     1134             or error-status :get-message(1) <> ""
     1135             then do:
     1136               undo move_block, retry move_block .
     1137             end.
     1138           end.
     1139         end.
     1140         assign
     1141           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1142           no-error .
     1143         if error-status :error
     1144         or error-status :get-message(1) <> ""
     1145         then do:
     1146           undo move_block, retry move_block .
     1147         end.
     1148         for each buf_temp-browse-handle
     1149           where buf_temp-browse-handle.browse-type = 'height':u
     1150         on error undo move_block, retry move_block
     1151         :
     1152           assign
     1153             buf_temp-browse-handle.browse-handle :height
     1154               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1155             no-error .
     1156           if error-status :error
     1157           or error-status :get-message(1) <> ""
     1158           then do:
     1159             undo move_block, retry move_block .
     1160           end.
     1161         end.
     1162         assign
     1163           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1164           no-error .
     1165         if error-status :error
     1166         or error-status :get-message(1) <> ""
     1167         then do:
     1168           undo move_block, retry move_block .
     1169         end.
     1170         if frame Dialog-Frame :scrollable = true
     1171         then do:
     1172           assign
     1173             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1174             no-error .
     1175           if error-status :error
     1176           or error-status :get-message(1) <> ""
     1177           then do:
     1178             undo move_block, retry move_block .
     1179           end.
     1180         end.
     1181       end.
     1182       if p-move-resize = true
     1183       then do:
     1184         run diasize_position-resize-button in this-procedure .
     1185       end.
     1186       if v-diasize-wndstore = true
     1187       then do:
     1188         if connected("ub") = true
     1189         then do:
     1190           define variable v-cntxt-db-num        as integer   no-undo .
     1191           define variable v-cntxt-userid        as character no-undo .
     1192           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1193                                             , OUTPUT v-cntxt-userid
     1194                                             ) .
     1195           run gbl/wndsizew.p
     1196             (input  v-cntxt-db-num
     1197             ,input  v-cntxt-userid
     1198             ,input  v-diasize-proc-name
     1199             ,input  'height':u
     1200             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1201             ) .
     1202         end.
     1203       end.
     1204     end.
     1205     assign
     1206       v-diasize-change-size = false
     1207     .
     1208   end procedure.
     1209   procedure diasize_set-height :
     1210     define input  parameter p-new-height  as decimal   no-undo .
     1211     define input  parameter p-move-resize as logical   no-undo .
     1212     do
     1213     on error undo, return error return-value
     1214     :
     1215       run diasize_change-height in this-procedure
     1216         (input  (p-new-height - frame Dialog-Frame :height)
     1217         ,input  p-move-resize
     1218         ) .
     1219     end.
     1220   end procedure.
     1221   procedure diasize_change-width :
     1222     define input  parameter p-change-value as decimal   no-undo .
     1223     define input  parameter p-move-resize  as logical   no-undo .
     1224     define variable v-field-group-handle   as handle    no-undo .
     1225     define variable v-object-handle        as handle    no-undo .
     1226     define variable v-frame-width          as decimal   no-undo .
     1227     define variable v-frame-virtual-width  as decimal   no-undo .
     1228     define variable v-browse-width         as decimal   no-undo .
     1229     define variable v-window-width         as decimal   no-undo .
     1230     define variable v-window-virtual-width as decimal   no-undo .
     1231     define variable v-change-sign          as integer   no-undo .
     1232     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1233     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1234     if p-change-value > 0
     1235     then do:
     1236       if frame Dialog-Frame :width + p-change-value >
     1237           session :width-chars
     1238       then do:
     1239         assign
     1240           p-change-value = session :width-chars - frame Dialog-Frame :width
     1241         .
     1242         if p-change-value <= 0
     1243         then do:
     1244           run diasize_position-resize-button in this-procedure .
     1245           return .
     1246         end.
     1247       end.
     1248     end.
     1249     if p-change-value < 0
     1250     then do:
     1251       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1252       then do:
     1253         assign
     1254           p-change-value = v-diasize-orig-frame-width
     1255                          - frame Dialog-Frame :width
     1256         .
     1257         if p-change-value >= 0
     1258         then do:
     1259           run diasize_position-resize-button in this-procedure .
     1260           return .
     1261         end.
     1262       end.
     1263     end.
     1264     if p-change-value >= 0
     1265     then do:
     1266       assign
     1267         v-change-sign = 1
     1268       .
     1269     end.
     1270     else do:
     1271       assign
     1272         v-change-sign = -1
     1273       .
     1274     end.
     1275     assign
     1276       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1277     .
     1278     if p-change-value = 0
     1279     then do:
     1280       run diasize_position-resize-button in this-procedure .
     1281       return .
     1282     end.
     1283     move_block:
     1284     do
     1285     on error undo move_block, leave move_block
     1286     :
     1287       if retry
     1288       then do:
     1289         do
     1290         on error undo move_block, leave move_block
     1291         :
     1292           if p-change-value > 0
     1293           then do:
     1294             for each buf_temp-diasize-handle
     1295             on error undo, next
     1296             :
     1297               assign
     1298                 v-object-handle = buf_temp-diasize-handle.handle-value
     1299               .
     1300               if v-object-handle <> v-diasize-resize-button
     1301               then do:
     1302                 assign
     1303                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1304                 .
     1305               end.
     1306             end.
     1307             assign
     1308               v-diasize-browse-handle :width = v-browse-width
     1309             .
     1310             for each buf_temp-browse-handle
     1311               where buf_temp-browse-handle.browse-type = 'width':u
     1312             on error undo, next
     1313             :
     1314               assign
     1315                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1316               .
     1317             end.
     1318             assign
     1319               frame Dialog-Frame :width = v-frame-width
     1320             .
     1321             if frame Dialog-Frame :scrollable = true
     1322             then do:
     1323               assign
     1324                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1325               .
     1326             end.
     1327             run diasize_position-resize-button in this-procedure .
     1328           end.
     1329           else do:
     1330             if frame Dialog-Frame :scrollable = true
     1331             then do:
     1332               assign
     1333                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1334               .
     1335             end.
     1336             assign
     1337               frame Dialog-Frame :width = v-frame-width
     1338             .
     1339             for each buf_temp-browse-handle
     1340               where buf_temp-browse-handle.browse-type = 'width':u
     1341             on error undo, next
     1342             :
     1343               assign
     1344                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1345               .
     1346             end.
     1347             assign
     1348               v-diasize-browse-handle :width = v-browse-width
     1349             .
     1350             for each buf_temp-diasize-handle
     1351             on error undo, next
     1352             :
     1353               assign
     1354                 v-object-handle = buf_temp-diasize-handle.handle-value
     1355               .
     1356               if v-object-handle <> v-diasize-resize-button
     1357               then do:
     1358                 assign
     1359                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1360                 .
     1361               end.
     1362             end.
     1363             run diasize_position-resize-button in this-procedure .
     1364           end.
     1365           assign
     1366             v-diasize-change-size = false
     1367           .
     1368           leave move_block .
     1369         end.
     1370       end.
     1371       assign
     1372         v-diasize-need-full-display = true
     1373       .
     1374       if v-diasize-change-size = false
     1375       then do:
     1376         assign
     1377           v-diasize-change-size = true
     1378         .
     1379       end.
     1380       else do:
     1381         return .
     1382       end.
     1383       assign
     1384         v-frame-width = frame Dialog-Frame :width
     1385         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1386         v-browse-width = v-diasize-browse-handle :width
     1387       .
     1388       for each buf_temp-browse-handle
     1389         where buf_temp-browse-handle.browse-type = 'width':u
     1390       :
     1391         assign
     1392           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1393         .
     1394       end.
     1395       for each buf_temp-diasize-handle
     1396       :
     1397         delete buf_temp-diasize-handle .
     1398       end.
     1399       assign
     1400         v-field-group-handle = frame Dialog-Frame :first-child
     1401       .
     1402       do while valid-handle(v-field-group-handle)
     1403       :
     1404         assign
     1405           v-object-handle = v-field-group-handle :first-child
     1406         .
     1407         do while valid-handle(v-object-handle)
     1408         :
     1409           if  v-object-handle <> v-diasize-browse-handle :handle
     1410           and v-object-handle <> v-diasize-resize-button
     1411           and can-query(v-object-handle, "row")
     1412           and can-query(v-object-handle, "height")
     1413           and ( v-object-handle :col + v-object-handle :width
     1414                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1415               )
     1416           then do:
     1417             find first buf_temp-browse-handle
     1418               where buf_temp-browse-handle.browse-type   = 'width':u
     1419                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1420               no-error .
     1421             if available buf_temp-browse-handle
     1422             then do:
     1423             end.
     1424             else do:
     1425               create buf_temp-diasize-handle .
     1426               assign
     1427                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1428                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1429               .
     1430             end.
     1431           end.
     1432           assign
     1433             v-object-handle = v-object-handle :next-sibling
     1434           .
     1435         end.
     1436         assign
     1437           v-field-group-handle = v-field-group-handle :next-sibling
     1438         .
     1439       end.
     1440       do with frame Dialog-Frame
     1441       :
     1442         hide v-diasize-resize-button .
     1443         v-diasize-resize-button :row = 1.
     1444         v-diasize-resize-button :column = 1.
     1445       end.
     1446       if p-change-value > 0
     1447       then do:
     1448         if frame Dialog-Frame :scrollable = true
     1449         then do:
     1450           assign
     1451             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1452             no-error .
     1453           if error-status :error
     1454           or error-status :get-message(1) <> ""
     1455           then do:
     1456             undo move_block, retry move_block.
     1457           end.
     1458         end.
     1459         assign
     1460           frame Dialog-Frame :width = v-frame-width + p-change-value
     1461           no-error .
     1462         if error-status :error
     1463         or error-status :get-message(1) <> ""
     1464         then do:
     1465           undo move_block, retry move_block.
     1466         end.
     1467         assign
     1468           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1469         no-error .
     1470         if error-status :error
     1471         or error-status :get-message(1) <> ""
     1472         then do:
     1473           undo move_block, retry move_block.
     1474         end.
     1475         for each buf_temp-browse-handle
     1476           where buf_temp-browse-handle.browse-type = 'width':u
     1477         on error undo move_block, retry move_block
     1478         :
     1479           assign
     1480             buf_temp-browse-handle.browse-handle :width
     1481               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1482             no-error .
     1483           if error-status :error
     1484           or error-status :get-message(1) <> ""
     1485           then do:
     1486             undo move_block, retry move_block .
     1487           end.
     1488         end.
     1489         for each buf_temp-diasize-handle
     1490         on error undo move_block, retry move_block
     1491         :
     1492           assign
     1493             v-object-handle = buf_temp-diasize-handle.handle-value
     1494           .
     1495           if v-object-handle <> v-diasize-resize-button
     1496           then do:
     1497             assign
     1498               v-object-handle :col = v-object-handle :col + p-change-value
     1499               no-error .
     1500             if error-status :error
     1501             or error-status :get-message(1) <> ""
     1502             then do:
     1503               undo move_block, retry move_block .
     1504             end.
     1505           end.
     1506         end.
     1507       end.
     1508       else do:
     1509         for each buf_temp-diasize-handle
     1510         on error undo move_block, retry move_block
     1511         :
     1512           assign
     1513             v-object-handle = buf_temp-diasize-handle.handle-value
     1514           .
     1515           if v-object-handle <> v-diasize-resize-button
     1516           then do:
     1517             assign
     1518               v-object-handle :col = v-object-handle :col + p-change-value
     1519               no-error .
     1520             if error-status :error
     1521             or error-status :get-message(1) <> ""
     1522             then do:
     1523               undo move_block, retry move_block .
     1524             end.
     1525           end.
     1526         end.
     1527         for each buf_temp-browse-handle
     1528           where buf_temp-browse-handle.browse-type = 'width':u
     1529         on error undo move_block, retry move_block
     1530         :
     1531           assign
     1532             buf_temp-browse-handle.browse-handle :width
     1533               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1534             no-error .
     1535           if error-status :error
     1536           or error-status :get-message(1) <> ""
     1537           then do:
     1538             undo move_block, retry move_block .
     1539           end.
     1540         end.
     1541         assign
     1542           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1543           no-error .
     1544         if error-status :error
     1545         or error-status :get-message(1) <> ""
     1546         then do:
     1547           undo move_block, retry move_block.
     1548         end.
     1549         assign
     1550           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1551         no-error .
     1552         if error-status :error
     1553         or error-status :get-message(1) <> ""
     1554         then do:
     1555           undo move_block, retry move_block.
     1556         end.
     1557         if frame Dialog-Frame :scrollable = true
     1558         then do:
     1559           assign
     1560             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1561           no-error .
     1562           if error-status :error
     1563           or error-status :get-message(1) <> ""
     1564           then do:
     1565             undo move_block, retry move_block.
     1566           end.
     1567         end.
     1568       end.
     1569       if p-move-resize
     1570       then do:
     1571         run diasize_position-resize-button in this-procedure .
     1572       end.
     1573       if v-diasize-wndstore = true
     1574       then do:
     1575         if connected("ub") = true
     1576         then do:
     1577           define variable v-cntxt-db-num        as integer   no-undo .
     1578           define variable v-cntxt-userid        as character no-undo .
     1579           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1580                                             , OUTPUT v-cntxt-userid
     1581                                             ) .
     1582           run gbl/wndsizew.p
     1583             (input  v-cntxt-db-num
     1584             ,input  v-cntxt-userid
     1585             ,input  v-diasize-proc-name
     1586             ,input  'width':u
     1587             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1588             ) .
     1589         end.
     1590       end.
     1591     end.
     1592     assign
     1593       v-diasize-change-size = false
     1594     .
     1595   end procedure.
     1596   procedure diasize_set-width :
     1597     define input  parameter p-new-width  as decimal   no-undo .
     1598     define input  parameter p-move-resize as logical   no-undo .
     1599     do
     1600     on error undo, return error return-value
     1601     :
     1602       run diasize_change-width in this-procedure
     1603         (input  (p-new-width - frame Dialog-Frame :width)
     1604         ,input  p-move-resize
     1605         ) .
     1606     end.
     1607   end procedure.
     1608   procedure diasize_position-resize-button :
     1609     do with frame Dialog-Frame
     1610     :
     1611       hide v-diasize-resize-button .
     1612       assign
     1613         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1614                     - 1
     1615                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1616         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1617                     - 1
     1618                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1619       .
     1620       view v-diasize-resize-button .
     1621     end.
     1622   end procedure.
     1623   on alt-right anywhere
     1624   do:
     1625     run diasize_change-width in this-procedure
     1626       (input 1
     1627       ,input true
     1628       ) .
     1629     return no-apply .
     1630   end.
     1631   on alt-left anywhere
     1632   do:
     1633     run diasize_change-width in this-procedure
     1634       (input -1
     1635       ,input true
     1636       ) .
     1637     return no-apply .
     1638   end.
     1639   on alt-down anywhere
     1640   do:
     1641     run diasize_change-height in this-procedure
     1642       (input 1
     1643       ,input true
     1644       ) .
     1645     return no-apply .
     1646   end.
     1647   on alt-up anywhere
     1648   do:
     1649     run diasize_change-height in this-procedure
     1650       (input -1
     1651       ,input true
     1652       ) .
     1653     return no-apply .
     1654   end.
     1655   on alt-enter of frame Dialog-Frame
     1656   do:
     1657     run diasize_maximize in this-procedure
     1658       (input  ?
     1659       ).
     1660     return no-apply .
     1661   end.
     1662   procedure diasize_end-move :
     1663     do
     1664     on error undo, return error return-value
     1665     :
     1666       define variable v-row-delta as decimal   no-undo .
     1667       define variable v-col-delta as decimal   no-undo .
     1668       define variable v-new-row as decimal   no-undo .
     1669       define variable v-new-col as decimal   no-undo .
     1670       assign
     1671         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1672         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1673       .
     1674       assign
     1675         v-row-delta = v-new-row - frame Dialog-Frame :height
     1676         v-col-delta = v-new-col - frame Dialog-Frame :width
     1677       .
     1678       run diasize_change-height in this-procedure
     1679         (input v-row-delta
     1680         ,input true
     1681         ) .
     1682       run diasize_change-width in this-procedure
     1683         (input v-col-delta
     1684         ,input true
     1685         ) .
     1686     end.
     1687   end procedure.
     1688   procedure diasize_maximize :
     1689     define input  parameter p-action as logical   no-undo .
     1690     do
     1691     on error undo, return error return-value
     1692     :
     1693       if p-action = ?
     1694       then do:
     1695         if v-diasize-need-maximize = true
     1696         then do:
     1697           assign
     1698             p-action = true
     1699           .
     1700         end.
     1701         else do:
     1702           assign
     1703             p-action = false
     1704           .
     1705         end.
     1706       end.
     1707       if p-action = true
     1708       then do:
     1709         run diasize_change-height in this-procedure
     1710           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1711               - frame Dialog-Frame :height-chars
     1712           ,input true
     1713           ) .
     1714         run diasize_change-width in this-procedure
     1715           (input session :width-chars
     1716               - frame Dialog-Frame :width-chars
     1717           ,input true
     1718           ) .
     1719         assign
     1720           v-diasize-need-maximize = false
     1721         .
     1722       end.
     1723       else do:
     1724         run diasize_change-width in this-procedure
     1725           (input v-diasize-orig-frame-width
     1726               - frame Dialog-Frame :width-chars
     1727           ,input true
     1728           ) .
     1729         run diasize_change-height in this-procedure
     1730           (input v-diasize-orig-frame-height
     1731               - frame Dialog-Frame :height-chars
     1732           ,input true
     1733           ) .
     1734         assign
     1735           v-diasize-need-maximize = true
     1736         .
     1737       end.
     1738     end.
     1739   end procedure.
     1740   procedure diasize_restore-orig-size :
     1741     do
     1742     on error undo, return error return-value
     1743     :
     1744       assign
     1745         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1746         v-diasize-current-frame-height = frame Dialog-Frame :height
     1747       .
     1748       run diasize_set-height in this-procedure
     1749         (input  v-diasize-orig-frame-height
     1750         ,input  true
     1751         ) .
     1752       run diasize_set-width in this-procedure
     1753         (input  v-diasize-orig-frame-width
     1754         ,input  true
     1755         ) .
     1756     end.
     1757   end procedure.
     1758   procedure diasize_restore-current-size :
     1759     do
     1760     on error undo, return error return-value
     1761     :
     1762       run diasize_set-height in this-procedure
     1763         (input  v-diasize-current-frame-height
     1764         ,input  true
     1765         ) .
     1766       run diasize_set-width in this-procedure
     1767         (input  v-diasize-current-frame-width
     1768         ,input  true
     1769         ) .
     1770     end.
     1771   end procedure.
     1772   procedure diasize_set-browse-handle :
     1773     define input  parameter p-browse-handle as handle   no-undo .
     1774     define buffer buf_temp-browse-handle for temp-browse-handle .
     1775     do
     1776     on error undo, return error return-value
     1777     :
     1778       assign
     1779         v-diasize-browse-handle = p-browse-handle
     1780       .
     1781       for each buf_temp-browse-handle
     1782       on error undo, return error return-value
     1783       :
     1784         delete buf_temp-browse-handle .
     1785       end.
     1786     end.
     1787   end procedure.
     1788   procedure diasize_add_browse :
     1789     define input  parameter p-browse-type   as character no-undo .
     1790     define input  parameter p-browse-handle as handle    no-undo .
     1791     define buffer buf_temp-browse-handle for temp-browse-handle .
     1792     do
     1793     on error undo, return error return-value
     1794     :
     1795       assign
     1796         v-diasize-browse-number = v-diasize-browse-number + 1
     1797       .
     1798       create buf_temp-browse-handle .
     1799       assign
     1800         buf_temp-browse-handle.browse-type   = p-browse-type
     1801         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1802         buf_temp-browse-handle.browse-handle = p-browse-handle
     1803       .
     1804     end.
     1805   end procedure.
     1806   procedure diasize_init :
     1807     define variable v-default-value    as logical   no-undo .
     1808     define variable v-restore-saved    as logical   no-undo .
     1809     define variable v-resize-value-str as character no-undo .
     1810     do
     1811     on error undo, return error return-value
     1812     :
     1813       do with frame Dialog-Frame
     1814       :
     1815         assign
     1816           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1817           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1818           v-diasize-browse-handle     = browse br-attr :handle
     1819         .
     1820         create button v-diasize-resize-button
     1821         assign
     1822           parent        = frame Dialog-Frame :first-child
     1823           label         = "s"
     1824           height-pixels = 16
     1825           width-pixels  = 16
     1826           visible       = true
     1827           sensitive     = true
     1828           movable       = true
     1829           triggers:
     1830             on end-move persistent run diasize_end-move in this-procedure .
     1831           end triggers.
     1832         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1833         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1834         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1835         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1836         assign
     1837           v-diasize-wndmax = false
     1838         .
     1839         if connected("ub") = true
     1840         then do:
     1841           define variable v-cntxt-db-num        as integer   no-undo .
     1842           define variable v-cntxt-userid        as character no-undo .
     1843           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1844                                             , OUTPUT v-cntxt-userid
     1845                                             ) .
     1846           run gbl/wndpar_r.p
     1847             (input  v-cntxt-db-num
     1848             ,input  v-cntxt-userid
     1849             ,input  'wndmax':U
     1850             ,output v-diasize-wndmax
     1851             ,output v-default-value
     1852             ) .
     1853         end.
     1854         assign
     1855           v-diasize-wndstore = false
     1856         .
     1857         if connected("ub") = true
     1858         then do:
     1859           run gbl/wndpar_r.p
     1860             (input  v-cntxt-db-num
     1861             ,input  v-cntxt-userid
     1862             ,input  'wndstore':U
     1863             ,output v-diasize-wndstore
     1864             ,output v-default-value
     1865             ) .
     1866         end.
     1867         assign
     1868           v-diasize-proc-name = entry(1, program-name(2), '.')
     1869         .
     1870         if v-diasize-wndstore = true
     1871         then do:
     1872           assign
     1873             v-restore-saved = false
     1874           .
     1875           if connected("ub") = true
     1876           then do:
     1877             run gbl/wndsizer.p
     1878               (input  v-cntxt-db-num
     1879               ,input  v-cntxt-userid
     1880               ,input  v-diasize-proc-name
     1881               ,input  'height':u
     1882               ,output v-resize-value-str
     1883               ) .
     1884             if v-resize-value-str <> '':U
     1885             then do:
     1886               run diasize_change-height in this-procedure
     1887                 (input  integer(v-resize-value-str)
     1888                 ,input  true
     1889                 ) .
     1890               assign
     1891                 v-restore-saved = true
     1892               .
     1893             end.
     1894           end.
     1895           if connected("ub") = true
     1896           then do:
     1897             run gbl/wndsizer.p
     1898               (input  v-cntxt-db-num
     1899               ,input  v-cntxt-userid
     1900               ,input  v-diasize-proc-name
     1901               ,input  'width':u
     1902               ,output v-resize-value-str
     1903               ) .
     1904             if v-resize-value-str <> '':U
     1905             then do:
     1906               run diasize_change-width in this-procedure
     1907                 (input  integer(v-resize-value-str)
     1908                 ,input  true
     1909                 ) .
     1910               assign
     1911                 v-restore-saved = true
     1912               .
     1913             end.
     1914           end.
     1915           if v-restore-saved <> true
     1916           then do:
     1917             if v-diasize-wndmax = true
     1918             then do:
     1919               run diasize_maximize in this-procedure
     1920                 (input  true
     1921                 ) .
     1922             end.
     1923           end.
     1924         end.
     1925         else do:
     1926           if v-diasize-wndmax = true
     1927           then do:
     1928             run diasize_maximize in this-procedure
     1929               (input  true
     1930               ) .
     1931           end.
     1932         end.
     1933       end.
     1934     end.
     1935   end procedure.
     1936   procedure diasize_need-full-display :
     1937     define output parameter p-need-full-display as logical   no-undo .
     1938     do
     1939     on error undo, return error return-value
     1940     :
     1941       assign
     1942         p-need-full-display = v-diasize-need-full-display
     1943       .
     1944       assign
     1945         v-diasize-need-full-display = false
     1946       .
     1947     end.
     1948   end procedure.
     1949   procedure get-context :
     1950      define output parameter p-db-num as integer          no-undo.
     1951      define output parameter p-user-id as character        no-undo.
     1952      define variable v-login               as character    no-undo.
     1953      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1954      define buffer buf_user-login  for ub.user-login .
     1955      do
     1956      on error undo, return error
     1957      :
     1958            FIND FIRST buf_sys-ctrl no-lock.
     1959            ASSIGN
     1960               v-login = USERID("ub")
     1961               p-db-num = buf_sys-ctrl.db-num
     1962            .
     1963            FIND FIRST buf_user-login
     1964                 WHERE buf_user-login.db-num = p-db-num
     1965                   AND buf_user-login.user-login = v-login
     1966                 no-lock
     1967                 no-error
     1968                 .
     1969            IF AVAILABLE buf_user-login
     1970            THEN DO:
     1971               assign
     1972                  p-user-id = buf_user-login.user-id
     1973               .
     1974            END.
     1975      end.
     1976   end procedure.
     1977       run diasize_init in this-procedure .
     1978   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1979   do:
     1980     br-attr :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     1981   end.
     1982   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1983   on f5 of frame Dialog-Frame anywhere
     1984   do:
     1985     OPEN QUERY br-attr FOR EACH Temp-hattr NO-LOCK.
     1986       apply "VALUE-CHANGED" to br-attr.
     1987   end.
     1988   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1989   ON TAB ANYWHERE
     1990   DO:
     1991   define variable ii as integer no-undo .
     1992   define variable fh as widget-handle no-undo .
     1993   define variable hh as widget-handle no-undo .
     1994   define variable v-next-widget-name as character no-undo .
     1995   if v-tab-order <> '' then do:
     1996     if self:type = "TOGGLE-BOX" then
     1997     self:BGCOLOR = ?.
     1998     assign
     1999     ii = lookup(self:name, v-tab-order).
     2000     assign
     2001     ii = ii + 1
     2002     v-next-widget-name = entry(ii, v-tab-order)
     2003     no-error .
     2004     if error-status:error then do:
     2005       assign
     2006       ii = 1
     2007       v-next-widget-name = entry( ii, v-tab-order)
     2008       .
     2009     end.
     2010     assign
     2011     fh = frame Dialog-Frame:first-child
     2012     hh = fh:first-child
     2013     .
     2014     do while valid-handle(hh):
     2015       if hh:name = v-next-widget-name then do:
     2016         if hh:sensitive  = yes
     2017         AND hh:visible = yes then do:
     2018           if hh:type = "TOGGLE-BOX":U then do:
     2019             assign
     2020             hh:BGcolor = 1
     2021             .
     2022           end.
     2023           APPLY "ENTRY" to hh.
     2024           return no-apply.
     2025         end.
     2026         else do:
     2027           APPLY "TAB" to hh.
     2028           return no-apply.
     2029         end.
     2030       end.
     2031       hh = hh:next-sibling.
     2032     end.
     2033   end.
     2034   END.
     2035   ON BACK-TAB ANYWHERE
     2036   DO:
     2037   define variable ii as integer no-undo .
     2038   define variable fh as widget-handle no-undo .
     2039   define variable hh as widget-handle no-undo .
     2040   define variable v-next-widget-name as character no-undo .
     2041   if v-tab-order <> '' then do:
     2042     assign
     2043     ii = lookup(self:name, v-tab-order).
     2044     .
     2045     assign
     2046     ii = (if ii = 1
     2047           then  num-entries(v-tab-order)
     2048           else ii - 1
     2049           )
     2050     v-next-widget-name = entry(ii, v-tab-order)
     2051     .
     2052     assign
     2053     fh = frame Dialog-Frame:first-child
     2054     hh = fh:first-child
     2055     .
     2056     do while valid-handle(hh):
     2057       if hh:name = v-next-widget-name then do:
     2058         if hh:sensitive  = yes
     2059         AND hh:visible = yes then do:
     2060           if hh:type = "TOGGLE-BOX":U then do:
     2061             assign
     2062             hh:BGcolor = 1
     2063             .
     2064           end.
     2065           APPLY "ENTRY" to hh.
     2066           return no-apply.
     2067         end.
     2068         else do:
     2069         APPLY "BACK-TAB" to hh.
     2070         return no-apply.
     2071         end.
     2072       end.
     2073       hh = hh:next-sibling.
     2074     end.
     2075     end.
     2076   END.
     2077   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2078   ON RETURN ANYWHERE
     2079   DO:
     2080   define variable ii as integer no-undo .
     2081   define variable fh as widget-handle no-undo .
     2082   define variable hh as widget-handle no-undo .
     2083   define variable v-next-widget-name as character no-undo .
     2084     if v-tab-order <> '' then do:
     2085       assign
     2086       ii = lookup(self:name, v-tab-order).
     2087       if ii = num-entries(v-tab-order) then do:
     2088           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     2089           return no-apply.
     2090       end.
     2091       if self:type <> "BUTTON" and
     2092         self:type <> "EDITOR"  then do:
     2093         run proc-move-forward in this-procedure .
     2094         return no-apply.
     2095       end.
     2096       if self:type = "BUTTON" then do:
     2097         APPLY "CHOOSE" to self.
     2098       end.
     2099       if self:type = "TOGGLE-BOX" then
     2100       self:BGCOLOR = ?.
     2101       assign
     2102       ii = ii + 1
     2103       v-next-widget-name = entry(ii, v-tab-order)
     2104       no-error .
     2105       if error-status:error then do:
     2106         assign
     2107         ii = 1
     2108         v-next-widget-name = entry( ii, v-tab-order)
     2109         .
     2110       end.
     2111       assign
     2112       fh = frame Dialog-Frame:first-child
     2113       hh = fh:first-child
     2114       .
     2115       do while valid-handle(hh):
     2116         if hh:name = v-next-widget-name then do:
     2117           if hh:sensitive  = yes
     2118           AND hh:visible = yes then do:
     2119             if hh:type = "TOGGLE-BOX":U then do:
     2120               assign
     2121               hh:BGcolor = 1
     2122               .
     2123             end.
     2124             APPLY "ENTRY" to hh.
     2125             return no-apply.
     2126           end.
     2127           else do:
     2128             APPLY "TAB" to hh.
     2129             return no-apply.
     2130           end.
     2131         end.
     2132         hh = hh:next-sibling.
     2133       end.
     2134     end.
     2135   END.
     2136   procedure proc-move-forward :
     2137   define variable ii as integer no-undo .
     2138   define variable fh as widget-handle no-undo .
     2139   define variable hh as widget-handle no-undo .
     2140   define variable v-next-widget-name as character no-undo .
     2141   do
     2142   on error undo, return error
     2143   :
     2144     if v-tab-order <> '' then do:
     2145       if self:type = "TOGGLE-BOX" then
     2146       self:BGCOLOR = ?.
     2147       assign
     2148       ii = lookup(self:name, v-tab-order).
     2149       assign
     2150       ii = ii + 1
     2151       v-next-widget-name = entry(ii, v-tab-order)
     2152       no-error .
     2153       if error-status:error then do:
     2154         assign
     2155         ii = 1
     2156         v-next-widget-name = entry( ii, v-tab-order)
     2157         .
     2158       end.
     2159       assign
     2160       fh = frame Dialog-Frame:first-child
     2161       hh = fh:first-child
     2162       .
     2163       do while valid-handle(hh):
     2164         if hh:name = v-next-widget-name then do:
     2165           if hh:sensitive  = yes
     2166           AND hh:visible = yes then do:
     2167             if hh:type = "TOGGLE-BOX":U then do:
     2168               assign
     2169               hh:BGcolor = 1
     2170               .
     2171             end.
     2172             APPLY "ENTRY" to hh.
     2173             return.
     2174           end.
     2175           else do:
     2176             assign
     2177             ii = ii + 1
     2178             v-next-widget-name = entry(ii, v-tab-order)
     2179             no-error .
     2180             if error-status:error then do:
     2181               assign
     2182               ii = 1
     2183               v-next-widget-name = entry( ii, v-tab-order)
     2184               .
     2185             end.
     2186           end.
     2187         end.
     2188         hh = hh:next-sibling.
     2189       end.
     2190     end.
     2191   end.
     2192   end procedure.
     2193   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2194   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2195   MAIN-BLOCK:
     2196   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2197      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2198     if NOT (p-mode = 'ПРОСМОТР':U
     2199           or p-mode = 'ИЗМЕНЕНИЕ':U
     2200           or p-mode = 'ДОБАВЛЕНИЕ':U
     2201           ) then do:
     2202       message
     2203       vss-workfile vss-revision vss-description skip
     2204       "Неверный параметр вызова p-mode" p-mode
     2205       view-as alert-box ERROR.
     2206       return error.
     2207     end.
     2208   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2209   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2210     (input  p-obj-type
     2211     ,input  p-obj-code
     2212     ,output v-host-code
     2213     )  .
     2214     find first buf_clients no-lock where
     2215               buf_clients.obj-type = 'орг':U
     2216           and buf_clients.obj-code = v-host-code.
     2217     v-host-name = buf_clients.obj-name.
     2218   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2219     run myenable in this-procedure .
     2220     run init-proc in this-procedure .
     2221     WAIT-FOR GO OF FRAME Dialog-Frame.
     2222   END.
     2223   run disable_UI in this-procedure .
     2224   run attr-pop-clean-up in this-procedure ( input 'gds-host-attr':U ).
     2225   if updated then return 'ИЗМЕНЕНИЕ':U.
     2226   PROCEDURE choose-to-edit :
     2227   define input parameter p-attr-code as character no-undo .
     2228   assign
     2229   add-option = p-attr-code
     2230   .
     2231   APPLY "CHOOSE" to b-add in frame Dialog-Frame .
     2232   END PROCEDURE.
     2233   PROCEDURE disable_UI :
     2234     HIDE FRAME Dialog-Frame.
     2235   END PROCEDURE.
     2236   PROCEDURE enable_UI :
     2237     DISPLAY goods-artic Goods-dsc-name goods-gds-code goods-prod-type
     2238             goods-prod-code goods-prod-name
     2239         WITH FRAME Dialog-Frame.
     2240     ENABLE B-exit b-quit b-add b-lkp b-chg b-del b-help goods-artic
     2241            Goods-dsc-name goods-gds-code goods-prod-type goods-prod-code
     2242            goods-prod-name
     2243         WITH FRAME Dialog-Frame.
     2244     VIEW FRAME Dialog-Frame.
     2245     OPEN QUERY br-attr FOR EACH Temp-hattr NO-LOCK.
     2246   END PROCEDURE.
     2247   PROCEDURE init-proc :
     2248   define var  attr-type as character no-undo .
     2249   define var  attr-format as character no-undo .
     2250   define var  attr-label as character no-undo .
     2251   define var  attr-value as character no-undo .
     2252   define var  attr-user-can-edit as logical no-undo .
     2253   define var  attr-output-display as logical no-undo .
     2254   define var  attr-other as char no-undo .
     2255   define buffer buf_goods for ub.goods.
     2256   define buffer buf_prods for ub.clients.
     2257   for each  Temp-hattr share-lock:
     2258     delete Temp-hattr.
     2259   end.
     2260   if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
     2261     find first buf_goods where
     2262             buf_goods.gds-code =  p-gds-code no-lock no-error .
     2263     find first buf_prods where
     2264               buf_prods.obj-code =  buf_goods.prod-code
     2265           and buf_prods.obj-type =  buf_goods.prod-type   no-lock no-error .
     2266     Assign
     2267     Goods-dsc-name = buf_Goods.gds-name
     2268     goods-artic    = buf_goods.artic
     2269     goods-gds-code = buf_goods.gds-code
     2270     goods-prod-type = buf_goods.prod-type
     2271     goods-prod-code = buf_goods.prod-code
     2272     goods-prod-name = buf_prods.obj-name
     2273     .
     2274     display Goods-dsc-name goods-gds-code goods-artic
     2275     goods-prod-type goods-prod-code goods-prod-name
     2276       with frame Dialog-Frame  .
     2277   end.
     2278   For each tt0-gds-host-attr where
     2279           tt0-gds-host-attr.host-code = v-host-code and
     2280           tt0-gds-host-attr.gds-code  = p-gds-code
     2281           no-lock :
     2282     run gdshattr-name in this-procedure (
     2283                                           input tt0-gds-host-attr.attr-code
     2284                                           ,output attr-type
     2285                                           ,output attr-format
     2286                                           ,output attr-label
     2287                                           ,output attr-user-can-edit
     2288                                           ,output attr-output-display
     2289                                           ,output attr-other ).
     2290     if attr-output-display = true then DO:
     2291       run gdshattr-value in this-procedure (
     2292                                                 input tt0-gds-host-attr.attr-code
     2293                                               ,input p-obj-type
     2294                                               ,input p-obj-code
     2295                                               ,input tt0-gds-host-attr.gds-code
     2296                                               ,output attr-value
     2297                                               ,output attr-type ).
     2298       create Temp-hattr.
     2299       assign
     2300       Temp-hattr.attr-code = attr-label
     2301       Temp-hattr.value_ = tt0-gds-host-attr.attr-value
     2302       Temp-hattr.attr-value = (if attr-type = 'L':U
     2303                               then string(tt0-gds-host-attr.attr-value = "yes":U, attr-format)
     2304                               else tt0-gds-host-attr.attr-value)
     2305       Temp-hattr.user-can-edit = attr-user-can-edit
     2306       Temp-hattr.code = tt0-gds-host-attr.attr-code
     2307       temp-hattr.gds-code = tt0-gds-host-attr.gds-code
     2308       temp-hattr.host-code = tt0-gds-host-attr.host-code
     2309       .
     2310     End.
     2311   End.
     2312   OPEN QUERY br-attr FOR EACH Temp-hattr NO-LOCK.
     2313   END PROCEDURE.
     2314   PROCEDURE MyEnable :
     2315   assign
     2316   v-tab-order = "b-exit,b-quit,b-add,b-lkp,b-chg,b-del,b-help,br-attr"
     2317   b-add:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-add:HANDLE
     2318   temp-hattr.attr-value:RESIZABLE IN BROWSE br-attr = YES
     2319   .
     2320   frame Dialog-Frame:TITLE = frame Dialog-Frame:TITLE + " " + string(v-host-code) + " " + v-host-name.
     2321   if p-mode <> 'ПРОСМОТР':U then do:
     2322     run attr-pop-create-items in this-procedure  (
     2323                                                    input 'gds-obj-attr':U
     2324                                                   ,input 'gdshattr-manual-edit'
     2325                                                   ,input 'gdshattr-tooltip'
     2326                                                   ,input 'choose-to-edit'
     2327                                                   ,input menu menu-b-add:handle
     2328                                                   ,input 'no-envd,':u
     2329                                                 ).
     2330   end.
     2331   DISPLAY
     2332   Goods-dsc-name
     2333   goods-gds-code
     2334   goods-artic
     2335   WITH FRAME Dialog-Frame.
     2336   ENABLE
     2337   b-exit when p-mode <> 'ПРОСМОТР':U
     2338   b-quit
     2339   b-del when p-mode <> 'ПРОСМОТР':U
     2340   b-add when p-mode <> 'ПРОСМОТР':U
     2341   b-lkp
     2342   b-chg when p-mode <> 'ПРОСМОТР':U
     2343   b-help br-attr Goods-dsc-name goods-gds-code goods-artic
     2344   WITH FRAME Dialog-Frame.
     2345   VIEW FRAME Dialog-Frame.
     2346   if p-mode = 'ПРОСМОТР':U then do:
     2347     hide
     2348     b-exit
     2349     in frame Dialog-Frame .
     2350     assign
     2351     b-quit:label = "&Выход"
     2352     b-quit:col    = 1
     2353     .
     2354   end.
     2355   ASSIGN b-add:MENU-MOUSE = 1.
     2356   OPEN QUERY br-attr FOR EACH Temp-hattr NO-LOCK.
     2357   END PROCEDURE.
     2358   PROCEDURE proc-add-chg :
     2359   define input parameter p-add as logical no-undo .
     2360   define variable attr-type as character no-undo .
     2361   define variable attr-format as character no-undo .
     2362   define variable attr-label as character no-undo .
     2363   define variable attr-user-can-edit as logical no-undo .
     2364   define variable attr-output-display as logical no-undo .
     2365   define variable attr-other as char no-undo .
     2366   define variable attr-value as character no-undo .
     2367   define variable v-attr-value as character no-undo .
     2368   define variable v-init as character no-undo .
     2369   define var loc#log as logical no-undo.
     2370   DEFINE VARIABLE v-spr as character no-undo .
     2371   define variable v-spr-param as character no-undo .
     2372   define variable v-check as character no-undo .
     2373   define variable jj as integer no-undo .
     2374   define variable v-setted as logical no-undo .
     2375   define variable v-correct as logical no-undo .
     2376   define variable v-error-code as character no-undo .
     2377   case p-add:
     2378     when yes then do:
     2379       if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
     2380         run gdshattr-exist in this-procedure (
     2381                                               input p-gds-code
     2382                                               ,input p-obj-type
     2383                                               ,input p-obj-code
     2384                                               ,input add-option
     2385                                               ,output loc#log)  no-error.
     2386         if error-status:error then return error.
     2387         if loc#log then do:
     2388           message
     2389           "Данный атрибут уже существует"
     2390           view-as alert-box error .
     2391           return error.
     2392         end.
     2393       end.
     2394       run gdshattr-name in this-procedure (
     2395                                             input  add-option
     2396                                             ,output attr-type
     2397                                             ,output attr-format
     2398                                             ,output attr-label
     2399                                             ,output attr-user-can-edit
     2400                                             ,output attr-output-display
     2401                                             ,output attr-other
     2402                                             ) no-error .
     2403       if error-status :error then do:
     2404         return error .
     2405       end.
     2406       CASE attr-type:
     2407         when 'L':U then do:
     2408           assign
     2409           v-attr-value = "yes":U
     2410           .
     2411         end.
     2412         when 'I':U or when 'D':U then do:
     2413           assign
     2414           v-attr-value = if v-init <> "":U
     2415                         then attr-value
     2416                         else string(0)
     2417           .
     2418         end.
     2419         when 'T':U then do:
     2420           assign
     2421           v-attr-value = ?
     2422           .
     2423         end.
     2424         when 'C':U then do:
     2425           assign
     2426           v-attr-value = if v-init <> "":U
     2427                         then attr-value
     2428                         else "":U
     2429           .
     2430         end.
     2431       END CASE.
     2432       assign
     2433       attr-value = v-attr-value
     2434       .
     2435     end.
     2436     when no then do:
     2437       run gdshattr-name in this-procedure(
     2438                                             input TEMP-hattr.code
     2439                                             ,output attr-type
     2440                                             ,output attr-format
     2441                                             ,output attr-label
     2442                                             ,output attr-user-can-edit
     2443                                             ,output attr-output-display
     2444                                             ,output attr-other) no-error.
     2445       IF ERROR-STATUS:ERROR THEN DO:
     2446           message "Ошибка при определении названия и типа атрибута товара на фирме!"         skip "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     2447           return error.
     2448       END.
     2449       attr-value  = temp-hattr.value_.
     2450     end.
     2451   END CASE.
     2452   IF attr-user-can-edit Then DO:
     2453     do jj = 1 to num-entries(attr-other, chr(47)):
     2454       if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "spr-ext":U
     2455       or entry(1, entry(jj, attr-other, chr(47)), "=":U) = "spr":U
     2456       then do:
     2457         assign
     2458         v-spr = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     2459         .
     2460       end.
     2461       if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "spr-param":U then do:
     2462         assign
     2463         v-spr-param = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     2464         .
     2465       end.
     2466       if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "check-ext":U then do:
     2467         assign
     2468         v-check = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     2469         .
     2470       end.
     2471     end.
     2472     if v-spr = "":U then do:
     2473       run gbl/d-prompt.w (
     2474         'title=':u + "Изменение атрибута товара на фирме" + '\':u
     2475       + 'text1=':u + attr-label + '\':u
     2476       + 'format=' + (if attr-type = 'L':U then "yes/no" else attr-format) + '\':u
     2477       + 'type=' + attr-type + '\':u
     2478       + 'fillin_row=2\':u
     2479       + 'fillin_col=4\':u
     2480       + 'fillin_width=20\':u
     2481       + 'fillin_height=1\':u
     2482       + 'max-chars=70\':u
     2483       + 'readonly=' + (if p-mode = 'ПРОСМОТР':U then 'yes':u else 'no':u) + '\':u
     2484       , input-output attr-value
     2485           ).
     2486       if return-value = 'false':u then return error.
     2487     end.
     2488     else do:
     2489       if v-spr-param = "":U then do:
     2490         run  value(v-spr) in this-procedure  (
     2491                                                input p-gds-code
     2492                                               ,input p-obj-type
     2493                                               ,input p-obj-code
     2494                                               ,input-output attr-value
     2495                                               ,output v-setted) no-error .
     2496       end.
     2497       else do:
     2498         run  value(v-spr) in this-procedure (
     2499                                               input p-gds-code
     2500                                               ,input p-obj-type
     2501                                               ,input p-obj-code
     2502                                               ,input v-spr-param
     2503                                               ,input-output attr-value
     2504                                               ,output v-setted) no-error .
     2505        end.
     2506      if not v-setted then return error.
     2507     end.
     2508     if v-check <> "":U then do:
     2509       run value(v-check) (
     2510                          input p-gds-code
     2511                         ,input p-obj-type
     2512                         ,input p-obj-code
     2513                         ,input attr-value
     2514                         ,input (if p-add then 'ДОБАВЛЕНИЕ':U else 'ИЗМЕНЕНИЕ':U)
     2515                         ,output v-correct
     2516                         ,output v-error-code) no-error.
     2517       if error-status:error then do:
     2518         message
     2519         "Ошибка при проверке корректности задаваемого значения атрибута" skip
     2520         error-status:get-message(1) skip
     2521         view-as alert-box error .
     2522         undo, return error .
     2523       end.
     2524       if not v-correct then do:
     2525         message
     2526         "Задаваемое значение атрибута некорректно" skip
     2527         return-value
     2528         view-as alert-box error .
     2529         undo, return error .
     2530       end.
     2531     end.
     2532     run temp-gdshattr-write in this-procedure (
     2533                                                 input p-gds-code
     2534                                                 ,input p-obj-type
     2535                                                 ,input p-obj-code
     2536                                                 ,input (if p-add then add-option else temp-hattr.code)
     2537                                                 ,input attr-value)  no-error.
     2538     IF NOT error-status:error then do:
     2539         assign
     2540         updated = yes
     2541         .
     2542         br-attr:refresh() in frame Dialog-Frame no-error .
     2543     END.
     2544   End.
     2545   Else message "Изменение атрибута невозможно !" view-as alert-box error.
     2546   END PROCEDURE.
     2547   PROCEDURE proc-b-lkp :
     2548   define variable attr-type as character no-undo .
     2549   define variable attr-format as character no-undo .
     2550   define variable attr-label as character no-undo .
     2551   define variable attr-user-can-edit as logical no-undo .
     2552   define variable attr-output-display as logical no-undo .
     2553   define variable attr-other as char no-undo .
     2554   define variable attr-value as char no-undo .
     2555   define variable v-run-name as character no-undo .
     2556   define variable jj as integer no-undo .
     2557   run gdshattr-name in this-procedure (
     2558                                           input temp-hattr.code
     2559                                           ,output attr-type
     2560                                           ,output attr-format
     2561                                           ,output attr-label
     2562                                           ,output attr-user-can-edit
     2563                                           ,output attr-output-display
     2564                                           ,output attr-other) no-error.
     2565   IF ERROR-STATUS:ERROR THEN DO:
     2566       message "Ошибка при определении названия и типа атрибута товара на фирме!"         skip "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     2567       return error.
     2568   END.
     2569   do jj = 1 to num-entries(attr-other, chr(47)):
     2570     if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "display" then do:
     2571       v-run-name = entry(2, entry(jj, attr-other, chr(47)), "=":U).
     2572       run value(v-run-name) in this-procedure (
     2573                                                input p-gds-code
     2574                                               ,input temp-hattr.attr-code
     2575                                               ,input temp-hattr.value_
     2576                                               ,input p-obj-type
     2577                                               ,input p-obj-code
     2578                                                )
     2579                                                no-error .
     2580       if error-status:error then undo, return error .
     2581       return .
     2582     end.
     2583   END.
     2584   BELL.
     2585   END PROCEDURE.
     2586   PROCEDURE proc-save :
     2587   DEFINE VARIABLE v-updated AS LOGICAL NO-UNDO.
     2588   define variable v-created as logical no-undo .
     2589   define variable v-deleted as logical no-undo .
     2590   define variable v-updated-str as character no-undo .
     2591   define variable v-type as character no-undo .
     2592   for each temp-hattr NO-LOCK where
     2593          temp-hattr.gds-code = p-gds-code
     2594      AND temp-hattr.host-code = v-host-code :
     2595      find first tt0-gds-host-attr NO-LOCK WHERE
     2596             tt0-gds-host-attr.gds-code = temp-hattr.gds-code
     2597       AND   tt0-gds-host-attr.host-code = temp-hattr.host-code
     2598       AND   tt0-gds-host-attr.attr-code = temp-hattr.code no-error.
     2599     assign
     2600     v-updated = no.
     2601     if available  tt0-gds-host-attr then do:
     2602       BUFFER-COMPARE temp-hattr
     2603                   TO tt0-gds-host-attr
     2604                   case-sensitive
     2605                   SAVE result IN v-updated-str.
     2606       assign
     2607       v-created = yes
     2608       v-updated = (v-updated-str <> "":U)
     2609       .
     2610     end.
     2611     else do:
     2612       assign
     2613       v-updated = yes.
     2614     end.
     2615     if v-updated then do:
     2616       run tt0-gdshattr-write in this-procedure (
     2617                                                    input p-gds-code
     2618                                                   ,input p-obj-type
     2619                                                   ,input p-obj-code
     2620                                                   ,input temp-hattr.code
     2621                                                   ,input temp-hattr.value_)  no-error.
     2622       if error-status:error then do:
     2623         message
     2624         "Ошибка при сохранении атрибута товара на фирме" skip
     2625         "товар" p-gds-code skip
     2626         "фирма" temp-hattr.host-code
     2627         "Атрибут" temp-hattr.attr-code
     2628         view-as alert-box  error .
     2629         undo, return error  .
     2630       end.
     2631       updated = yes.
     2632     end.
     2633     ASSIGN
     2634     p-updated = v-updated OR p-updated.
     2635   End.
     2636   FOR EACH tt0-gds-host-attr where
     2637            tt0-gds-host-attr.gds-code = p-gds-code
     2638       AND  tt0-gds-host-attr.host-code = v-host-code :
     2639     FIND FIRST temp-hattr NO-LOCK WHERE
     2640               temp-hattr.gds-code = tt0-gds-host-attr.gds-code
     2641           AND temp-hattr.host-code = tt0-gds-host-attr.host-code
     2642           AND temp-hattr.code = tt0-gds-host-attr.attr-code NO-ERROR.
     2643       IF NOT AVAILABLE temp-hattr THEN DO:
     2644         DELETE tt0-gds-host-attr.
     2645         assign
     2646         v-deleted = yes.
     2647         ASSIGN
     2648         p-updated = (v-deleted OR p-updated).
     2649       END.
     2650   END.
     2651   if p-updated
     2652   and p-update-instantly then do:
     2653     run ref/gdshatr1.p (
     2654                        input p-mode
     2655                       ,input p-gds-code
     2656                       ,input v-host-code
     2657                       ,input p-obj-type
     2658                       ,input p-obj-code
     2659                       ,INPUT table tt0-gds-host-attr
     2660                       ) no-error .
     2661     if error-status:error then do:
     2662       message
     2663       substitute("Ошибка при сохранении атрибутов товара на фирме:&1&2&1&3"
     2664                  , chr(10)
     2665                  , error-status:get-message(1)
     2666                  , return-value )
     2667       view-as alert-box
     2668       error .
     2669       undo, return error .
     2670     end.
     2671   end.
     2672   END PROCEDURE.
     2673   PROCEDURE temp-gdshattr-exist :
     2674   do
     2675     on error undo, return error
     2676     :
     2677       define input parameter p-gds-code like ub.gds-host-attr.gds-code   no-undo .
     2678       define input parameter p-obj-type like ub.clients.obj-type   no-undo .
     2679       define input parameter p-obj-code like ub.clients.obj-code   no-undo .
     2680       define input parameter p-code     like ub.gds-host-attr.attr-code  no-undo .
     2681       define OUTPUT parameter p-EXIST   AS LOGICAL no-undo .
     2682       DEFINE buffer buf_temp-hattr for temp-hattr .
     2683       define variable v-type           as character no-undo .
     2684       define variable v-format         as character no-undo .
     2685       define variable v-label          as character no-undo .
     2686       define variable v-user-can-edit  as logical   no-undo .
     2687       define variable v-output-display as logical   no-undo .
     2688       define variable v-other          as character no-undo .
     2689       define var attr-host-code as int no-undo .
     2690   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2691   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2692     (input  p-obj-type
     2693     ,input  p-obj-code
     2694     ,output attr-host-code
     2695     ) no-error .
     2696    .
     2697       run gdshattr-name in this-procedure (
     2698                                             input  p-code
     2699                                             ,output v-type
     2700                                             ,output v-format
     2701                                             ,output v-label
     2702                                             ,output v-user-can-edit
     2703                                             ,output v-output-display
     2704                                             ,output v-other
     2705                                             ) no-error .
     2706       if error-status :error then do:
     2707         undo, return error return-value .
     2708       end.
     2709       find first buf_temp-hattr NO-lock where
     2710                  buf_temp-hattr.gds-code  = p-gds-code AND
     2711                  buf_temp-hattr.host-code  = attr-host-code AND
     2712                  buf_temp-hattr.attr-code = p-code no-error .
     2713       if available buf_temp-hattr then do:
     2714         P-EXIST = YES.
     2715       end.
     2716     end.
     2717   END PROCEDURE.
     2718   PROCEDURE temp-gdshattr-write :
     2719     do
     2720     on error undo, return error
     2721     :
     2722       define input parameter p-gds-code like ub.gds-host-attr.gds-code   no-undo .
     2723       define input parameter p-obj-type like ub.clients.obj-type   no-undo .
     2724       define input parameter p-obj-code like ub.clients.obj-code   no-undo .
     2725       define input parameter p-code     like ub.gds-host-attr.attr-code  no-undo .
     2726       define input parameter p-value    like ub.gds-host-attr.attr-value no-undo .
     2727       define buffer buf_temp-hattr for temp-hattr .
     2728       define variable v-type           as character no-undo .
     2729       define variable v-format         as character no-undo .
     2730       define variable v-label          as character no-undo .
     2731       define variable v-user-can-edit  as logical   no-undo .
     2732       define variable v-output-display as logical   no-undo .
     2733       define variable v-other          as character no-undo .
     2734       define var attr-host-code as int no-undo .
     2735   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2736   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2737     (input  p-obj-type
     2738     ,input  p-obj-code
     2739     ,output attr-host-code
     2740     ) no-error .
     2741    .
     2742       run gdshattr-name in this-procedure (
     2743                                             input  p-code
     2744                                             ,output v-type
     2745                                             ,output v-format
     2746                                             ,output v-label
     2747                                             ,output v-user-can-edit
     2748                                             ,output v-output-display
     2749                                             ,output v-other
     2750                                             ) no-error .
     2751       if error-status :error then do:
     2752         undo, return error return-value .
     2753       end.
     2754       find first buf_temp-hattr exclusive-lock where
     2755                  buf_temp-hattr.gds-code  = p-gds-code AND
     2756                  buf_temp-hattr.host-code  = attr-host-code AND
     2757                  buf_temp-hattr.code = p-code no-error .
     2758       if not available buf_temp-hattr then do:
     2759         create buf_temp-hattr .
     2760         assign
     2761         buf_temp-hattr.gds-code  = p-gds-code
     2762         buf_temp-hattr.host-code  = attr-host-code
     2763         buf_temp-hattr.attr-code = v-label
     2764         buf_temp-hattr.code      = p-code
     2765         buf_temp-hattr.attr-value = (if v-type = 'L':U then string(logical(p-value), v-format) else p-value)
     2766         buf_temp-hattr.value_ = p-value
     2767         no-error
     2768         .
     2769       end.
     2770       ELSE
     2771       assign
     2772       buf_temp-hattr.attr-value = (if v-type = 'L':U then string(logical(p-value), v-format) else p-value)
     2773       buf_temp-hattr.value_ = p-value
     2774       .
     2775     end.
     2776   END PROCEDURE.
