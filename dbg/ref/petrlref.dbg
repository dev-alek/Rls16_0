        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter bttns as character no-undo .
        4   define output parameter p-rid-list as character no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: petrlref.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: ref/petrlref.p $":U .
       10   define variable vss-description as character no-undo init "Список топлив в механизме списка товаров".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72     define variable v-cntxt-db-num        as integer   no-undo .
       73     define variable v-cntxt-userid        as character no-undo .
       74     define variable v-cntxt-level         as character no-undo .
       75     define variable v-cntxt-host-code-obj as integer   no-undo .
       76     define variable v-cntxt-obj-type      as character no-undo .
       77     define variable v-cntxt-obj-code      as integer   no-undo .
       78     define variable v-cntxt-db-num-obj    as integer   no-undo .
       79     define variable v-cntxt-is-admin      as logical   no-undo .
       80   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81     run mainmenu_getcntxt in parparentproc
       82       (output v-cntxt-db-num
       83       ,output v-cntxt-userid
       84       ,output v-cntxt-level
       85       ,output v-cntxt-host-code-obj
       86       ,output v-cntxt-obj-type
       87       ,output v-cntxt-obj-code
       88       ,output v-cntxt-db-num-obj
       89       ,output v-cntxt-is-admin
       90       ) .
       91   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       92   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       93   define     temp-table macro-list-hist no-undo
       94   field list-table as character
       95   field id as integer
       96   field line as integer
       97   field hist-mode as character
       98   field des as character
       99   field num-recs as integer
      100   field option_ as character
      101   field item_ as character
      102   field status_ as character
      103   field num-add as integer
      104   field num-ignored as integer
      105   field done as logical
      106   field err_ as logical
      107   field err-mes as character
      108   index pi is primary
      109   id
      110   line
      111   index isdone
      112   done
      113   .
      114   PROCEDURE request-create-macro-list-hist :
      115   DEFINE INPUT PARAMETER p-child-handle AS HANDLE NO-UNDO.
      116   define buffer buf_macro-list-hist for macro-list-hist.
      117   for each buf_macro-list-hist :
      118      RUN proc-create-macro-list-hist IN p-child-handle (
      119                                                          input buf_macro-list-hist.list-table
      120                                                         ,input buf_macro-list-hist.id
      121                                                         ,input buf_macro-list-hist.line
      122                                                         ,input buf_macro-list-hist.hist-mode
      123                                                         ,input buf_macro-list-hist.des
      124                                                         ,input buf_macro-list-hist.option_
      125                                                         ,input buf_macro-list-hist.item_
      126                                                         ,input buf_macro-list-hist.status_
      127                                                          ) no-error .
      128   end.
      129   end procedure.
      130   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      131   define new shared temp-table gds-list no-undo like ub.goods
      132     field qnty   as decimal
      133     field to-del as logical
      134     field order-num as integer
      135     field to-sel as logical
      136     field promo-code as character
      137     field ActionId  as int64
      138     field db-num as integer
      139     index art  is primary unique artic prod-type prod-code
      140     index code is         unique gds-code
      141     index oi order-num
      142     index isel to-sel
      143     .
      144   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      145   define  new shared  temp-table gds-list-hist no-undo
      146   field list-table as character
      147   field id as integer
      148   field line as integer
      149   field hist-mode as character
      150   field des as character
      151   field num-recs as integer
      152   field option_ as character
      153   field item_ as character
      154   field status_ as character
      155   field num-add as integer
      156   field num-ignored as integer
      157   field done as logical
      158   field err_ as logical
      159   field err-mes as character
      160   index pi is primary
      161   id
      162   line
      163   index isdone
      164   done
      165   .
      166   define variable v-ii as integer no-undo .
      167   define variable v-bttns as character no-undo .
      168   define buffer buf_macro-list-hist for macro-list-hist.
      169   define buffer buf_gds-list for gds-list.
      170   define buffer buf_goods for ub.goods.
      171   do
      172   on error undo, return error
      173   :
      174     for each buf_macro-list-hist:
      175       delete buf_macro-list-hist.
      176     end.
      177     for each gds-list-hist:
      178       delete gds-list-hist.
      179     end.
      180     create buf_macro-list-hist.
      181     assign
      182     buf_macro-list-hist.list-table = '':U
      183     buf_macro-list-hist.id         = 1
      184     buf_macro-list-hist.line       = 0
      185     buf_macro-list-hist.hist-mode  = '+'
      186     buf_macro-list-hist.option_    = "is-ptrl"
      187     buf_macro-list-hist.status_    = 'все':U
      188     buf_macro-list-hist.des        = "ВСЕ товары-топлива"
      189     buf_macro-list-hist.item_      = "":U
      190     .
      191     release buf_macro-list-hist.
      192     for each gds-list:
      193       delete gds-list.
      194     end.
      195     assign
      196     v-bttns = (if lookup("b-sel", bttns) > 0
      197                then "b-sel"
      198                else '':U)
      199     v-bttns = v-bttns + (if v-bttns = '':U then '':U else chr(44)) +
      200             (if lookup("b-mark", bttns) > 0
      201                       then "b-mark"
      202                       else '':U)
      203     .
      204     run str/gdsqlist.w (
      205                      input parparentproc
      206                     ,input this-procedure:handle
      207                     ,input v-cntxt-host-code-obj
      208                     ,input v-cntxt-obj-type
      209                     ,input v-cntxt-obj-code
      210                     ,input v-bttns
      211                     ,input "ВСЕ товары-топлива"
      212                     ,input yes
      213                     ).
      214     find first gds-list where
      215              gds-list.to-sel = yes no-error.
      216     if not available gds-list then return '':U.
      217     for each buf_gds-list
      218          where buf_gds-list.to-sel = yes,
      219         FIRST buf_goods NO-LOCK WHERE
      220               buf_goods.gds-code = gds-list.gds-code :
      221       assign
      222       v-ii = v-ii + 1
      223       p-rid-list = P-RID-LIST + (if v-ii = 1
      224                     then '':U
      225                     else chr(44)) + string(recid(buf_goods))
      226       .
      227     end.
      228   end.
