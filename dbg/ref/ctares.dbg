      389   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      390   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      391     (input  v-report-name
      392     ,input  2
      393     ,output v-exist
      394     )  .
      395       if NOT v-exist then
      396       DO:
      397         Message
      398           "Нет заданий на печать ! "
      399           view-as alert-box .
      400         Return  .
      401       End.
      402       run gbl/prnfilen.w
      403         (input  ""
      404         ,input  p-DisabledOptions
      405         ,input  string(v-report-name )
      406         ,input  7
      407         ,output v-user-action
      408         ,output v-printed
      409         ) .
      410       if v-printed then
      411       do:
      412         return "YES" .
      413       end.
      414       else
      415       do:
      416         return "NO" .
      417       end.
      418     end.
      419   end procedure.
      420   procedure prn-lib-open-stream :
      421     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      422     define input parameter p-page-size    as integer no-undo .
      423     define input parameter p-is-stream    as logical no-undo .
      424     define input parameter p-append       as logical no-undo .
      425     define variable v-report-name as character no-undo .
      426     do
      427       on error undo, return error
      428       :
      429       run prn-lib-get-report-name  in this-procedure (
      430         input parParentProc
      431         ,output v-report-name
      432         ).
      433       if p-is-stream then
      434       do:
      435         if p-append then
      436         do:
      437           output stream PrnLibStream to value( v-report-name )
      438             page-size value(p-page-size) append .
      439         end.
      440         if not p-append then
      441         do:
      442           output stream PrnLibStream to value( v-report-name )
      443             page-size value(p-page-size) .
      444         end.
      445       end.
      446       if not p-is-stream then
      447       do:
      448         if p-append then
      449         do:
      450           output to value( v-report-name )
      451             page-size value(p-page-size) append .
      452         end.
      453         if not p-append then
      454         do:
      455           output to value( v-report-name )
      456             page-size value(p-page-size) .
      457         end.
      458       end.
      459     end.
      460   end procedure.
      461   procedure prn-lib-open-exp :
      462     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      463     define input parameter p-is-stream    as logical no-undo .
      464     define input parameter p-is-append    as logical no-undo .
      465     define output parameter p-ReportFileName as char init "report" no-undo.
      466     define output parameter p-process as logical no-undo .
      467     define variable glog as logical no-undo .
      468     do
      469       on error undo, return error
      470       :
      471       SYSTEM-DIALOG GET-FILE p-ReportFileName
      472         TITLE      "Укажите путь"
      473         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      474         ASK-OVERWRITE
      475         CREATE-TEST-FILE
      476         SAVE-AS
      477         USE-FILENAME
      478         DEFAULT-EXTENSION "txt"
      479         UPDATE glog
      480         .
      481       if not glog then  return.
      482       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      483       if p-is-stream then
      484       do:
      485         if p-is-append then
      486         do:
      487           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      488         end.
      489         else
      490         do:
      491           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      492         end.
      493       end.
      494       else
      495       do:
      496         if p-is-append then
      497         do:
      498           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      499         end.
      500         else
      501         do:
      502           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      503         end.
      504       end.
      505       p-process = yes.
      506     end.
      507   end procedure.
      508   procedure prn-lib-get-report-name :
      509     define input parameter parParentProc  as widget-handle no-undo.
      510     define output parameter p-report-name as character no-undo .
      511     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      512   end procedure.
      513   procedure prn-lib-reportviewer-report-name :
      514     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      515     define input parameter p-report-name-html as character no-undo .
      516     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      517   end procedure.
      518   procedure prn-lib-reportviewer :
      519     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      520     define input parameter p-report-name-html as character no-undo .
      521     define input parameter p-param        as character no-undo .
      522     define variable v-excel           as character no-undo init 'TRUE' .
      523     define variable v-value-character as character no-undo .
      524     define variable v-value-integer   as character no-undo .
      525     define variable v-value-date      as date      no-undo .
      526     define variable v-value-decimal   as decimal   no-undo .
      527     define variable rep-excel         as logical   no-undo .
      528     define variable excel-string      as character no-undo .
      529     define variable v-param-type      as character no-undo .
      530     define variable v-tth             as handle    no-undo .
      531     run adm/shattri.p (
      532       input "get":U
      533       ,input  ""
      534       ,input  0
      535       ,input  'report-glob':U
      536       ,input  'rep-excel':U
      537       ,output v-value-character
      538       ,output v-value-date
      539       ,output v-value-decimal
      540       ,output v-value-integer
      541       ,output rep-excel
      542       ,output v-param-type
      543       ,INPUT-OUTPUT table-handle v-tth
      544       )  .
      545     if rep-excel then v-excel = "TRUE" .
      546     else v-excel = "FALSE" .
      547     if p-param eq ""
      548     then
      549        p-param = "EXCEL:" + v-excel.
      550     else
      551        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      552     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      553   end procedure.
      554   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      555   procedure cur-time :
      556      define output parameter p-today as date      no-undo .
      557      define output parameter p-time  as integer   no-undo .
      558     do
      559     on error undo, return error
      560     :
      561       define variable v-date1 as date      no-undo .
      562       define variable v-date2 as date      no-undo .
      563       define variable v-time  as integer   no-undo .
      564       assign
      565         v-date1 = today
      566         v-time  = time
      567         v-date2 = today
      568       .
      569       if v-date1 <> v-date2
      570       then do:
      571         assign
      572           v-date1 = today
      573           v-time  = v-time
      574         .
      575       end.
      576       assign
      577         p-today = v-date1
      578         p-time  = v-time
      579       .
      580     end.
      581   end.
      582   function cur-time-date returns character
      583   :
      584     return string(today, '99/99/9999':U) .
      585   end.
      586   function cur-time-mjd returns decimal
      587   :
      588     define variable v-date as date      no-undo .
      589     define variable v-time as integer   no-undo .
      590     run cur-time in this-procedure
      591       (output v-date
      592       ,output v-time
      593       ) .
      594     return integer(v-date) - 2400002 + (v-time / 86400) .
      595   end.
      596   function cur-time-get-ending-index returns integer
      597   (input p-number as integer
      598   )
      599   :
      600     if p-number < 0
      601     or p-number = ?
      602     then do:
      603       return 1 .
      604     end.
      605     define variable v-rest as integer   no-undo .
      606     assign
      607       p-number = p-number modulo 100
      608     .
      609     if p-number < 20
      610     then do:
      611       assign
      612         v-rest = p-number
      613       .
      614     end.
      615     else do:
      616       assign
      617         v-rest = p-number modulo 10
      618       .
      619     end.
      620     case v-rest :
      621       when 1
      622       then do:
      623         return 2 .
      624       end.
      625       when 2 or
      626       when 3 or
      627       when 4
      628       then do:
      629         return 3 .
      630       end.
      631       otherwise do:
      632         return 1 .
      633       end.
      634     end case .
      635   end.
      636   procedure cur-time-mjd-to-date :
      637      define input  parameter i-mjd-diff as decimal no-undo.
      638      define output parameter o-Date     as date    no-undo.
      639      define output parameter o-Time     as integer no-undo.
      640      define variable v-day-number as integer   no-undo .
      641      if    i-mjd-diff < 0
      642         or i-mjd-diff = ?
      643      then do:
      644         return "?" .
      645      end.
      646      assign
      647         v-day-number = truncate(i-mjd-diff,0).
      648         o-Date = date(v-day-number + 2400002).
      649         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      650     .
      651   end.
      652   function cur-time-mjd-to-string returns character
      653   (input p-mjd-diff as decimal
      654   )
      655   :
      656     define variable v-day-number as integer   no-undo .
      657     define variable v-seconds    as integer   no-undo .
      658     define variable v-hour       as integer   no-undo .
      659     define variable v-min        as integer   no-undo .
      660     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      661     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      662     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      663     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      664     if p-mjd-diff < 0
      665     or p-mjd-diff = ?
      666     then do:
      667       return "?" .
      668     end.
      669     assign
      670       v-day-number = integer(truncate(p-mjd-diff,0))
      671       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      672     .
      673     if v-seconds > 86400
      674     then do:
      675       assign
      676         v-seconds = 86400 - 1
      677       .
      678     end.
      679     if v-seconds < 0
      680     then do:
      681       assign
      682         v-seconds = 0
      683       .
      684     end.
      685     assign
      686       v-hour = truncate(v-seconds / 3600, 0)
      687     .
      688     assign
      689       v-seconds = v-seconds modulo 3600
      690     .
      691     assign
      692       v-min = truncate(v-seconds / 60, 0)
      693     .
      694     assign
      695       v-seconds = v-seconds modulo 60
      696     .
      697     return
      698         (if v-day-number <> 0
      699           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      700           else ""
      701         )
      702       + (if v-day-number <> 0 or v-hour <> 0
      703           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      704           else ""
      705         )
      706       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      707           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      708           else ""
      709         )
      710       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      711       .
      712   end.
      713   function cur-time-string returns character
      714   :
      715     define variable v-date as date      no-undo .
      716     define variable v-time as integer   no-undo .
      717     run cur-time in this-procedure
      718       (output v-date
      719       ,output v-time
      720       ) .
      721     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      722   end.
      723   function cur-time-string-sec returns character
      724   :
      725     define variable v-date as date      no-undo .
      726     define variable v-time as integer   no-undo .
      727     run cur-time in this-procedure
      728       (output v-date
      729       ,output v-time
      730       ) .
      731     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      732   end.
      733   function cur-time-custom  returns character
      734   (input p-prefix as character
      735   ,input p-date-format as character
      736   ,input p-delimiter as character
      737   ,input p-time-format as character
      738   ,input p-suffix as character
      739   )
      740   :
      741     define variable v-date as date      no-undo .
      742     define variable v-time as integer   no-undo .
      743     run cur-time in this-procedure
      744       (output v-date
      745       ,output v-time
      746       ) .
      747     return
      748       p-prefix
      749       + string(v-date, p-date-format)
      750       + p-delimiter
      751       + string(v-time, p-time-format)
      752       + p-suffix
      753       .
      754   end.
      755   function cur-time-print  returns character
      756   :
      757     define variable v-date as date      no-undo .
      758     define variable v-time as integer   no-undo .
      759     run cur-time in this-procedure
      760       (output v-date
      761       ,output v-time
      762       ) .
      763     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      764   end.
      765   function cur-time-datetime returns datetime
      766   :
      767     define variable v-char as character no-undo .
      768     define variable v-datetime as datetime no-undo .
      769     v-char = cur-time-string().
      770     v-datetime = datetime(v-char).
      771     return  v-datetime.
      772   end.
      773   function cur-time-string-msec returns character
      774   :
      775     define variable v-date as datetime  no-undo .
      776     v-date = now.
      777     return string(v-date) .
      778   end.
      779   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      780   FUNCTION mark-string RETURNS CHARACTER
      781     ( input p-recid as recid, input mark-list as character  ) :
      782     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      783   END FUNCTION.
      784   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
      785   define variable sort-column-name as character no-undo .
      786   define variable v-db-num LIKE ub.db.db-num no-undo.
      787   DEFINE variable v-rid-list AS CHARACTER NO-UNDO.
      788   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      789   define  temp-table temp-changes no-undo
      790   field f_name as character
      791   field l_name as character
      792   field v_old as character
      793   field v_new as character
      794   field t_name as character
      795   field num_ as integer
      796   field uniq-key-rec as character
      797   field action as integer
      798   field fNotChange as logical
      799   index pi is unique primary
      800   num_
      801   t_name
      802   f_name
      803   index
      804   Chan
      805   fnotChange
      806   t_name
      807   f_name
      808   index imain uniq-key-rec
      809   .
      810   FUNCTION get-all-fields returns character (p-file-name as character ):
      811   define variable v-dop as character no-undo .
      812     find first _file no-lock where _file._file-name = p-file-name no-error .
      813     if not available _file then return "":U.
      814     for each _field no-lock where
      815              _field._file-recid = recid(_file) :
      816       assign
      817       v-dop = v-dop + _field._field-name + chr(44)
      818       .
      819     end.
      820     return trim(v-dop).
      821   END FUNCTION.
      822   PROCEDURE proc-full-temp-changes :
      823     define input  parameter p-hst-handle as handle    no-undo .
      824     define input  parameter p-main-table as character no-undo .
      825     define input  parameter p-field-list as character no-undo .
      826     define input  parameter p-label-form as character no-undo .
      827     define variable h-new-buf         as handle    no-undo .
      828     define variable h-main-buf        as handle    no-undo .
      829     define variable h-for-comp        as handle    no-undo .
      830     define variable v-inform          as character no-undo .
      831     define variable v-ind             as integer   no-undo .
      832     define variable v-idx-field-qnty  as integer   no-undo .
      833     define variable v-num-entries     as integer   no-undo .
      834     define variable fh                as handle    no-undo .
      835     define variable fh-main           as handle    no-undo .
      836     define variable fh-old            as handle    no-undo .
      837     define variable fh-new            as handle    no-undo .
      838     define variable v-field-name      as character no-undo .
      839     define variable v-field-lvl       as character no-undo .
      840     define variable v-field-form      as character no-undo .
      841     define variable v-search-exp      as character no-undo .
      842     define variable v-srch-main       as character no-undo .
      843     define variable v-word-link       as character no-undo .
      844     define variable v-av-chip-num     as logical   no-undo .
      845     define variable v-main-pi-fld-lst as character no-undo .
      846     define variable v-main-fld-lst    as character no-undo .
      847     define variable v-delim-list      as character no-undo .
      848     define variable v-label           as character no-undo .
      849     define variable v-old-value       as character no-undo case-sensitive.
      850     define variable v-new-value       as character no-undo case-sensitive.
      851     define variable v-chg-fields as character no-undo.
      852     for each temp-changes:
      853       delete temp-changes.
      854     end.
      855     if not p-hst-handle:available then do:
      856       return .
      857     end.
      858     create buffer h-new-buf  for table p-hst-handle .
      859     create buffer h-main-buf for table p-main-table .
      860     assign
      861       v-inform = h-main-buf:index-information(1)
      862       v-ind    = 2
      863     .
      864     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      865     on error undo, return error
      866     :
      867       assign
      868         v-inform = h-main-buf:index-information( v-ind )
      869         v-ind    = v-ind + 1
      870       .
      871     end.
      872     if v-inform = ?
      873       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      874       or entry( 3, v-inform, ",":U ) <> "1":U
      875     then do:
      876       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      877     end.
      878     assign
      879       v-idx-field-qnty = num-entries( v-inform ) - 4
      880     .
      881     if v-idx-field-qnty < 2 then do:
      882       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      883     end.
      884     assign
      885       v-srch-main   = "where":U
      886       v-word-link   = "":U
      887       v-av-chip-num = false
      888       v-delim-list  = "":U
      889     .
      890     do v-ind = 1 to v-idx-field-qnty by 2
      891     on error undo, return error
      892     :
      893       assign
      894         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      895         fh                = p-hst-handle:buffer-field( v-field-name )
      896         fh-main           = h-main-buf:buffer-field( v-field-name )
      897         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      898         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      899       .
      900       if fh:data-type ="character":U then do:
      901         assign
      902           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      903         .
      904       end.
      905       else do:
      906         assign
      907           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      908         .
      909       end.
      910       if v-delim-list = "":U then do:
      911         assign
      912           v-delim-list = ",":U
      913         .
      914       end.
      915       if v-word-link = "":U then do:
      916         assign
      917           v-word-link = "and":U
      918         .
      919       end.
      920     end.
      921     assign
      922       v-delim-list  = "":U
      923     .
      924     do v-ind = 1 to h-main-buf:num-fields
      925     on error undo, return error
      926     :
      927       assign
      928         fh-main      = h-main-buf:buffer-field( v-ind )
      929         v-field-name = fh-main:name
      930       .
      931         assign
      932           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      933         .
      934         if v-delim-list = "":U then do:
      935           assign
      936             v-delim-list = ",":U
      937           .
      938         end.
      939     end.
      940     assign
      941       v-inform = p-hst-handle:index-information(1)
      942       v-ind    = 2
      943     .
      944     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      945     on error undo, return error
      946     :
      947       assign
      948         v-inform = p-hst-handle:index-information( v-ind )
      949         v-ind    = v-ind + 1
      950       .
      951     end.
      952     if v-inform = ?
      953       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      954       or entry( 3, v-inform, ",":U ) <> "1":U
      955     then do:
      956       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      957     end.
      958     assign
      959       v-idx-field-qnty = num-entries( v-inform ) - 4
      960     .
      961     if v-idx-field-qnty < 2 then do:
      962       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      963     end.
      964     assign
      965       v-search-exp  = "where":U
      966       v-word-link   = "":U
      967       v-av-chip-num = false
      968     .
      969     do v-ind = 1 to v-idx-field-qnty by 2
      970     on error undo, return error
      971     :
      972       assign
      973         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      974         fh           = p-hst-handle:buffer-field( v-field-name )
      975         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      976       .
      977       if v-field-name = "chip-num":U then do:
      978         assign
      979           v-search-exp  = substitute( "&1 >", v-search-exp )
      980           v-av-chip-num = true
      981         .
      982       end.
      983       else do:
      984         assign
      985           v-search-exp = substitute( "&1 =", v-search-exp )
      986         .
      987       end.
      988       if fh:data-type ="character":U then do:
      989         assign
      990           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      991         .
      992       end.
      993       else do:
      994         assign
      995           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
      996         .
      997       end.
      998       if v-word-link = "":U then do:
      999         assign
     1000           v-word-link = "and":U
     1001         .
     1002       end.
     1003     end.
     1004     if v-av-chip-num = false then do:
     1005       message
     1006         vss-workfile vss-revision vss-description skip
     1007         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1008         "Использование данной процедуры невозможно!" skip
     1009         view-as alert-box error .
     1010       return error .
     1011     end.
     1012     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1013     if not h-new-buf:available then do:
     1014       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1015       if not h-main-buf:available then do:
     1016         assign
     1017           h-for-comp = ?
     1018         .
     1019       end.
     1020       else do:
     1021         assign
     1022           h-for-comp = h-main-buf
     1023         .
     1024       end.
     1025     end.
     1026     else do:
     1027       assign
     1028         h-for-comp = h-new-buf
     1029       .
     1030     end.
     1031     assign
     1032       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1033     .
     1034     do v-ind = 1 to v-num-entries
     1035     on error undo, return error return-value
     1036     :
     1037       assign
     1038         v-field-name = entry( v-ind, v-main-fld-lst )
     1039         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1040         v-old-value  = fh-old:buffer-value()
     1041         v-label      = trim( fh-old:label )
     1042       .
     1043       if ( trim( p-field-list ) <> "":U
     1044            and lookup( v-field-name, p-field-list ) > 0
     1045          )
     1046          or trim( p-field-list ) = "":U
     1047       then do:
     1048         if h-for-comp <> ? then do:
     1049           assign
     1050             fh-new      = h-for-comp:buffer-field( v-field-name )
     1051             v-new-value = fh-new:buffer-value()
     1052           .
     1053         end.
     1054         else do:
     1055           assign
     1056             v-new-value = "":U
     1057           .
     1058         end.
     1059         if v-old-value <> v-new-value
     1060         then do:
     1061           create temp-changes.
     1062           assign
     1063             temp-changes.t_name = p-main-table
     1064             temp-changes.f_name = v-field-name
     1065             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1066             temp-changes.v_old  = trim( v-old-value )
     1067             temp-changes.v_new  = trim( v-new-value )
     1068             temp-changes.num_   = 0
     1069             temp-changes.fNotChange = v-old-value eq v-new-value
     1070           .
     1071         end.
     1072       end.
     1073     end.
     1074     assign
     1075       v-num-entries = num-entries( p-label-form, chr(8) )
     1076     .
     1077     do v-ind = 1 to v-num-entries
     1078     on error undo, return error return-value
     1079     :
     1080       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1081         assign
     1082           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1083           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1084           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1085         .
     1086         find first temp-changes
     1087           where temp-changes.f_name = v-field-name
     1088           no-error .
     1089         if available temp-changes then do:
     1090           if trim( v-field-lvl ) <> "":U then do:
     1091             assign
     1092               temp-changes.l_name = v-field-lvl
     1093             .
     1094           end.
     1095           if trim( v-field-form ) <> "":U then do:
     1096             assign
     1097               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1098             .
     1099             if h-for-comp <> ? then do:
     1100               assign
     1101                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1102               .
     1103             end.
     1104           end.
     1105         end.
     1106       end.
     1107       else do:
     1108         message
     1109           vss-workfile vss-revision vss-description skip
     1110           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1111           substitute( "список для поля '&1': '&2'"
     1112                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1113                       ,entry( v-ind, p-label-form, chr(8) )
     1114                     ) skip
     1115           substitute( "полный список: &2", p-label-form ) skip
     1116           view-as alert-box error .
     1117       end.
     1118     end.
     1119     delete object h-new-buf .
     1120     delete object h-main-buf .
     1121   END PROCEDURE.
     1122   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1123   function usrfulnf returns character ( input p-user-id as character):
     1124   define variable v-user-name as character no-undo .
     1125   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1126   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
     1127     (input  p-user-id
     1128     ,output v-user-name
     1129     ) no-error .
     1130   if error-status:error
     1131   or v-user-name = ""
     1132   then do:
     1133     return p-user-id.
     1134   end.
     1135   else do:
     1136     return v-user-name.
     1137   end.
     1138   end function.
     1139   DEFINE BUTTON B-Help
     1140        LABEL "Помо&щь"
     1141        SIZE 3 BY 1
     1142        BGCOLOR 8 .
     1143   DEFINE BUTTON B-lookup
     1144        LABEL "&Просмотр"
     1145        SIZE 10 BY 1.
     1146   DEFINE BUTTON B-mark
     1147        LABEL "&*"
     1148        SIZE 3 BY 1.
     1149   DEFINE BUTTON b-quit AUTO-END-KEY
     1150        LABEL "&Выход"
     1151        SIZE 10 BY 1
     1152        BGCOLOR 8 .
     1153   DEFINE BUTTON B-sel AUTO-GO
     1154        LABEL "Вы&бор"
     1155        SIZE 10 BY 1.
     1156   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1157         VIEW-AS TEXT
     1158        SIZE 6 BY 1
     1159        FGCOLOR 4  NO-UNDO.
     1160   DEFINE QUERY BR-changes FOR
     1161         temp-changes SCROLLING.
     1162   DEFINE QUERY br-ctare FOR
     1163         X_c-tare SCROLLING.
     1164   DEFINE BROWSE BR-changes
     1165     QUERY BR-changes DISPLAY
     1166         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1167   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1168   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1169       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.03.
     1170   DEFINE BROWSE br-ctare
     1171     QUERY br-ctare NO-LOCK DISPLAY
     1172         X_c-tare.tare-code COLUMN-LABEL "Название"
     1173   X_c-tare.tare-name FORMAT "X(40)":U
     1174   string(X_c-tare.corr-time, "HH:MM") COLUMN-LABEL "Время!измен" FORMAT "X(5)":U
     1175   X_c-tare.corr-date COLUMN-LABEL "Дата!измен" FORMAT "99/99/9999":U
     1176   usrfulnf( X_c-tare.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1177   WIDTH 18
     1178   mark-string(recid(X_c-tare), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1179       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.27 FIT-LAST-COLUMN.
     1180   DEFINE FRAME Dialog-Frame
     1181        b-quit AT ROW 1 COL 1
     1182        B-mark AT ROW 1 COL 11
     1183        B-sel AT ROW 1 COL 21
     1184        B-lookup AT ROW 1 COL 61
     1185        B-Help AT ROW 1 COL 95
     1186        br-ctare AT ROW 3 COL 1
     1187        BR-changes AT ROW 13 COL 1
     1188        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1189        SPACE(78.62) SKIP(20.04)
     1190       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1191            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1192            TITLE "История тары"
     1193            CANCEL-BUTTON b-quit.
     1194   ASSIGN
     1195          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1196          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1197   ASSIGN
     1198          B-lookup:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1199   ON GO OF FRAME Dialog-Frame
     1200   DO:
     1201     p-rid-list = v-rid-list.
     1202   END.
     1203   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1204   DO:
     1205     APPLY "END-ERROR":U TO SELF.
     1206   END.
     1207   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1208   DO:
     1209     define variable loc#log as logical no-undo .
     1210     if available X_c-tare then do:
     1211   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1212   define variable v-str-recid10 as character no-undo .
     1213   define variable v-num-entry10 as integer   no-undo .
     1214   assign
     1215     v-str-recid10 = trim( string( recid( X_c-tare ) , "->>>>>>>>>>>9":U ) )
     1216     v-num-entry10 = lookup( v-str-recid10 , v-rid-list )
     1217   .
     1218   if v-num-entry10 > 0 then do:
     1219     assign
     1220       entry( v-num-entry10, v-rid-list ) = "":U
     1221       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1222     .
     1223   end.
     1224   else do:
     1225     assign
     1226       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid10
     1227     .
     1228   end.
     1229       loc#log = br-ctare:refresh() .
     1230       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1231           loc#log = br-ctare:select-next-row ().
     1232           apply "VALUE-CHANGED" to br-ctare in frame Dialog-Frame.
     1233       end.
     1234       if num-entries( v-rid-list ) = 0
     1235       then
     1236           hide mark-num in frame Dialog-Frame.
     1237       else
     1238           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1239     end.
     1240     apply "entry" to br-ctare in frame Dialog-Frame.
     1241   END.
     1242   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1243   DO:
     1244       if ( available X_c-tare ) then do:
     1245       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1246       then
     1247       v-rid-list = string( recid( X_c-tare ) ) .
     1248     end.
     1249   END.
     1250   ON RETURN OF br-ctare IN FRAME Dialog-Frame
     1251   or MOUSE-SELECT-DBLCLICK OF br-ctare IN FRAME Dialog-Frame
     1252       DO:
     1253       run proc-br-ctare no-error.
     1254     if error-status:error then return no-apply.
     1255   END.
     1256   ON VALUE-CHANGED OF br-ctare IN FRAME Dialog-Frame
     1257   DO:
     1258     run proc-view-changes in this-procedure no-error.
     1259   END.
     1260   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1261   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1262   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1263   on help of frame Dialog-Frame
     1264   do:
     1265     run gbl/app_help.p
     1266       (input this-procedure :file-name
     1267       ,input ''
     1268       ,input ?
     1269       ) no-error.
     1270     if error-status :error then do:
     1271       message
     1272         "Ошибка при вызове помощи"
     1273         error-status :get-message(1)
     1274         view-as alert-box .
     1275     end.
     1276   end.
     1277   run minbtn-set in this-procedure .
     1278   on choose of b-help in frame Dialog-Frame
     1279   do:
     1280     apply "help":u to frame Dialog-Frame .
     1281   end.
     1282   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1283   procedure minbtn-set :
     1284       do
     1285           on error undo, return error return-value
     1286           :
     1287           define variable ii              as integer       no-undo .
     1288           define variable fh              as widget-handle no-undo .
     1289           define variable hh              as widget-handle no-undo .
     1290           define variable v-h             as handle        extent 4 no-undo .
     1291           define variable v-name-button   as character     no-undo .
     1292           define variable v-help-old-x    as decimal       no-undo .
     1293           define variable v-help-old-y    as decimal       no-undo .
     1294           define variable v-help-old-size as decimal       no-undo .
     1295           define variable v-frame-width   as decimal       no-undo .
     1296           define variable jj              as integer       no-undo .
     1297           do
     1298               on error undo, return error
     1299               :
     1300               assign
     1301                   v-frame-width = frame Dialog-Frame:width - 0.3
     1302                   fh            = frame Dialog-Frame:first-child
     1303                   hh            = fh:first-child
     1304                   ii            = 1
     1305                   .
     1306               do while valid-handle(hh):
     1307                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1308                   do:
     1309                       case lc(hh:name) :
     1310                           when "b-help" then
     1311                               do:
     1312                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1313                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1314                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1315                                   hh:TOOLTIP = "Помощь" .
     1316                                   v-help-old-x = hh:column .
     1317                                   v-help-old-y = hh:row    .
     1318                                   v-help-old-size = hh:width .
     1319                                   hh:width-chars = 2.5 .
     1320                               end.
     1321                           when "b-print" then
     1322                               do:
     1323                                   hh:load-image("cmp/b-print.bmp":u) .
     1324                                   hh:TOOLTIP = "Печать" .
     1325                                   v-h[ii] = hh:handle .
     1326                                   ii = ii + 1 .
     1327                                   hh:width-chars = 3 .
     1328                               end.
     1329                           when "b-history" or
     1330                           when "b-hist" then
     1331                               do:
     1332                                   hh:load-image("cmp/b-hist.bmp":u) .
     1333                                   hh:TOOLTIP = "История" .
     1334                                   v-h[ii] = hh:handle .
     1335                                   ii = ii + 1 .
     1336                                   hh:width-chars = 3 .
     1337                               end.
     1338                           when "b-sch" then
     1339                               do:
     1340                                   hh:load-image("cmp/b-sch.bmp":u) .
     1341                                   hh:TOOLTIP = "Установка Фильтра" .
     1342                                   v-h[ii] = hh:handle .
     1343                                   ii = ii + 1 .
     1344                                   hh:width-chars = 3 .
     1345                               end.
     1346                           when "b-hist-user" then
     1347                               do:
     1348                                   hh:load-image("cmp/b-hist.bmp":u) .
     1349                                   hh:TOOLTIP = "История пользователя" .
     1350                                   ii = ii + 1 .
     1351                               end.
     1352                       end case.
     1353                   end.
     1354                   hh = hh:next-sibling.
     1355               end.
     1356               b-help:column = v-frame-width - b-help:width-chars.
     1357               jj = 0.
     1358               repeat ii = 4 to 1 by -1 :
     1359                   if valid-handle (v-h[ii] ) then
     1360                   do:
     1361                       jj  = jj + 1 .
     1362                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1363                       v-h[ii]:row    = v-help-old-y .
     1364                   end.
     1365               end.
     1366           end.
     1367       end.
     1368   end procedure.
     1369   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1370   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1371   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1372   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1373   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1374   define variable v-diasize-current-frame-height as decimal   no-undo .
     1375   define variable v-diasize-change-size          as logical   no-undo .
     1376   define variable v-diasize-resize-button        as handle    no-undo .
     1377   define variable v-diasize-wndmax               as logical   no-undo .
     1378   define variable v-diasize-wndstore             as logical   no-undo .
     1379   define variable v-diasize-proc-name            as character no-undo .
     1380   define variable v-diasize-browse-handle        as handle    no-undo .
     1381   define variable v-diasize-browse-number        as integer   no-undo .
     1382   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1383   define temp-table temp-diasize-handle no-undo
     1384     field handle-value  as handle
     1385     field save-position as decimal
     1386     index xpk is primary unique handle-value
     1387     .
     1388   define temp-table temp-browse-handle no-undo
     1389     field browse-type   as character
     1390     field browse-number as integer
     1391     field browse-handle as handle
     1392     field original-size as decimal
     1393     index xpk is primary unique browse-type browse-number
     1394     index xie browse-type browse-handle
     1395   .
     1396   procedure diasize_change-height :
     1397     define input  parameter p-change-value  as decimal   no-undo .
     1398     define input  parameter p-move-resize   as logical   no-undo .
     1399     define variable v-field-group-handle    as handle    no-undo .
     1400     define variable v-object-handle         as handle    no-undo .
     1401     define variable v-frame-height          as decimal   no-undo .
     1402     define variable v-frame-virtual-height  as decimal   no-undo .
     1403     define variable v-browse-height         as decimal   no-undo .
     1404     define variable v-window-height         as decimal   no-undo .
     1405     define variable v-window-virtual-height as decimal   no-undo .
     1406     define variable v-change-sign           as integer   no-undo .
     1407     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1408     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1409     if p-change-value > 0
     1410     then do:
     1411       if frame Dialog-Frame :height + p-change-value
     1412           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1413       then do:
     1414         assign
     1415           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1416                           - (frame Dialog-Frame :height-chars)
     1417         .
     1418         if p-change-value <= 0
     1419         then do:
     1420           run diasize_position-resize-button in this-procedure .
     1421           return .
     1422         end.
     1423       end.
     1424     end.
     1425     if p-change-value < 0
     1426     then do:
     1427       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1428       then do:
     1429         assign
     1430           p-change-value = v-diasize-orig-frame-height
     1431                          - (frame Dialog-Frame :height-chars)
     1432         .
     1433         if p-change-value >= 0
     1434         then do:
     1435           run diasize_position-resize-button in this-procedure .
     1436           return .
     1437         end.
     1438       end.
     1439     end.
     1440     if p-change-value >= 0
     1441     then do:
     1442       assign
     1443         v-change-sign = 1
     1444       .
     1445     end.
     1446     else do:
     1447       assign
     1448         v-change-sign = -1
     1449       .
     1450     end.
     1451     assign
     1452       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1453     .
     1454     if p-change-value = 0
     1455     then do:
     1456       run diasize_position-resize-button in this-procedure .
     1457       return .
     1458     end.
     1459     move_block:
     1460     do
     1461     on error undo move_block, retry move_block
     1462     :
     1463       if retry
     1464       then do:
     1465         do
     1466         on error undo move_block, leave move_block
     1467         :
     1468           if p-change-value > 0
     1469           then do:
     1470             for each buf_temp-diasize-handle
     1471             on error undo, next
     1472             :
     1473               assign
     1474                 v-object-handle = buf_temp-diasize-handle.handle-value
     1475               .
     1476               if v-object-handle <> v-diasize-resize-button
     1477               then do:
     1478                 assign
     1479                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1480                 .
     1481               end.
     1482             end.
     1483             assign
     1484               v-diasize-browse-handle :height = v-browse-height
     1485             .
     1486             for each buf_temp-browse-handle
     1487               where buf_temp-browse-handle.browse-type = 'height':u
     1488             on error undo, next
     1489             :
     1490               assign
     1491                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1492               .
     1493             end.
     1494             assign
     1495               frame Dialog-Frame :height = v-frame-height
     1496             .
     1497             if frame Dialog-Frame :scrollable = true
     1498             then do:
     1499               assign
     1500                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1501               .
     1502             end.
     1503             run diasize_position-resize-button in this-procedure .
     1504           end.
     1505           else do:
     1506             if frame Dialog-Frame :scrollable = true
     1507             then do:
     1508               assign
     1509                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1510               .
     1511             end.
     1512             assign
     1513               frame Dialog-Frame :height = v-frame-height
     1514             .
     1515             assign
     1516               v-diasize-browse-handle :height = v-browse-height
     1517             .
     1518             for each buf_temp-browse-handle
     1519               where buf_temp-browse-handle.browse-type = 'height':u
     1520             on error undo, next
     1521             :
     1522               assign
     1523                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1524               .
     1525             end.
     1526             for each buf_temp-diasize-handle
     1527             on error undo, next
     1528             :
     1529               assign
     1530                 v-object-handle = buf_temp-diasize-handle.handle-value
     1531               .
     1532               if v-object-handle <> v-diasize-resize-button
     1533               then do:
     1534                 assign
     1535                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1536                 .
     1537               end.
     1538             end.
     1539             run diasize_position-resize-button in this-procedure .
     1540           end.
     1541           assign
     1542             v-diasize-change-size = false
     1543           .
     1544           leave move_block .
     1545         end.
     1546       end.
     1547       assign
     1548         v-diasize-need-full-display = true
     1549       .
     1550       if v-diasize-change-size = false
     1551       then do:
     1552         assign
     1553           v-diasize-change-size = true
     1554         .
     1555       end.
     1556       else do:
     1557         return .
     1558       end.
     1559       assign
     1560         v-frame-height = frame Dialog-Frame :height
     1561         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1562         v-browse-height = v-diasize-browse-handle :height
     1563       .
     1564       for each buf_temp-browse-handle
     1565         where buf_temp-browse-handle.browse-type = 'height':u
     1566       :
     1567         assign
     1568           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1569         .
     1570       end.
     1571       for each buf_temp-diasize-handle
     1572       :
     1573         delete buf_temp-diasize-handle .
     1574       end.
     1575       assign
     1576         v-field-group-handle = frame Dialog-Frame :first-child
     1577       .
     1578       do while valid-handle(v-field-group-handle)
     1579       :
     1580         assign
     1581           v-object-handle = v-field-group-handle :first-child
     1582         .
     1583         do while valid-handle(v-object-handle)
     1584         :
     1585           if  v-object-handle <> v-diasize-browse-handle :handle
     1586           and can-query(v-object-handle, "row")
     1587           and can-query(v-object-handle, "height")
     1588           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1589           then do:
     1590             find first buf_temp-browse-handle
     1591               where buf_temp-browse-handle.browse-type   = 'height':u
     1592                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1593               no-error .
     1594             if available buf_temp-browse-handle
     1595             then do:
     1596             end.
     1597             else do:
     1598               create buf_temp-diasize-handle .
     1599               assign
     1600                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1601                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1602               .
     1603             end.
     1604           end.
     1605           assign
     1606             v-object-handle = v-object-handle :next-sibling
     1607           .
     1608         end.
     1609         assign
     1610           v-field-group-handle = v-field-group-handle :next-sibling
     1611         .
     1612       end.
     1613       do with frame Dialog-Frame
     1614       :
     1615         hide v-diasize-resize-button .
     1616         assign
     1617           v-diasize-resize-button :row    = 1
     1618           v-diasize-resize-button :column = 1
     1619         .
     1620       end.
     1621       if p-change-value > 0
     1622       then do:
     1623         if frame Dialog-Frame :scrollable = true
     1624         then do:
     1625           assign
     1626             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1627             no-error .
     1628           if error-status :error
     1629           or error-status :get-message(1) <> ""
     1630           then do:
     1631             undo move_block, retry move_block .
     1632           end.
     1633         end.
     1634         assign
     1635           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1636           no-error .
     1637         if error-status :error
     1638         or error-status :get-message(1) <> ""
     1639         then do:
     1640           undo move_block, retry move_block .
     1641         end.
     1642         assign
     1643           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1644           no-error .
     1645         if error-status :error
     1646         or error-status :get-message(1) <> ""
     1647         then do:
     1648           undo move_block, retry move_block .
     1649         end.
     1650         for each buf_temp-browse-handle
     1651           where buf_temp-browse-handle.browse-type = 'height':u
     1652         on error undo move_block, retry move_block
     1653         :
     1654           assign
     1655             buf_temp-browse-handle.browse-handle :height
     1656               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1657             no-error .
     1658           if error-status :error
     1659           or error-status :get-message(1) <> ""
     1660           then do:
     1661             undo move_block, retry move_block .
     1662           end.
     1663         end.
     1664         for each buf_temp-diasize-handle
     1665         on error undo move_block, retry move_block
     1666         :
     1667           assign
     1668             v-object-handle = buf_temp-diasize-handle.handle-value
     1669           .
     1670           if v-object-handle <> v-diasize-resize-button
     1671           then do:
     1672             assign
     1673               v-object-handle :row = v-object-handle :row + p-change-value
     1674               no-error .
     1675             if error-status :error
     1676             or error-status :get-message(1) <> ""
     1677             then do:
     1678               undo move_block, retry move_block .
     1679             end.
     1680           end.
     1681         end.
     1682       end.
     1683       else do:
     1684         for each buf_temp-diasize-handle
     1685         on error undo move_block, retry move_block
     1686         :
     1687           assign
     1688             v-object-handle = buf_temp-diasize-handle.handle-value
     1689           .
     1690           if v-object-handle <> v-diasize-resize-button
     1691           then do:
     1692             assign
     1693               v-object-handle :row = v-object-handle :row + p-change-value
     1694               no-error .
     1695             if error-status :error
     1696             or error-status :get-message(1) <> ""
     1697             then do:
     1698               undo move_block, retry move_block .
     1699             end.
     1700           end.
     1701         end.
     1702         assign
     1703           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1704           no-error .
     1705         if error-status :error
     1706         or error-status :get-message(1) <> ""
     1707         then do:
     1708           undo move_block, retry move_block .
     1709         end.
     1710         for each buf_temp-browse-handle
     1711           where buf_temp-browse-handle.browse-type = 'height':u
     1712         on error undo move_block, retry move_block
     1713         :
     1714           assign
     1715             buf_temp-browse-handle.browse-handle :height
     1716               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1717             no-error .
     1718           if error-status :error
     1719           or error-status :get-message(1) <> ""
     1720           then do:
     1721             undo move_block, retry move_block .
     1722           end.
     1723         end.
     1724         assign
     1725           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1726           no-error .
     1727         if error-status :error
     1728         or error-status :get-message(1) <> ""
     1729         then do:
     1730           undo move_block, retry move_block .
     1731         end.
     1732         if frame Dialog-Frame :scrollable = true
     1733         then do:
     1734           assign
     1735             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1736             no-error .
     1737           if error-status :error
     1738           or error-status :get-message(1) <> ""
     1739           then do:
     1740             undo move_block, retry move_block .
     1741           end.
     1742         end.
     1743       end.
     1744       if p-move-resize = true
     1745       then do:
     1746         run diasize_position-resize-button in this-procedure .
     1747       end.
     1748       if v-diasize-wndstore = true
     1749       then do:
     1750         if connected("ub") = true
     1751         then do:
     1752           define variable v-cntxt-db-num        as integer   no-undo .
     1753           define variable v-cntxt-userid        as character no-undo .
     1754           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1755                                             , OUTPUT v-cntxt-userid
     1756                                             ) .
     1757           run gbl/wndsizew.p
     1758             (input  v-cntxt-db-num
     1759             ,input  v-cntxt-userid
     1760             ,input  v-diasize-proc-name
     1761             ,input  'height':u
     1762             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1763             ) .
     1764         end.
     1765       end.
     1766     end.
     1767     assign
     1768       v-diasize-change-size = false
     1769     .
     1770   end procedure.
     1771   procedure diasize_set-height :
     1772     define input  parameter p-new-height  as decimal   no-undo .
     1773     define input  parameter p-move-resize as logical   no-undo .
     1774     do
     1775     on error undo, return error return-value
     1776     :
     1777       run diasize_change-height in this-procedure
     1778         (input  (p-new-height - frame Dialog-Frame :height)
     1779         ,input  p-move-resize
     1780         ) .
     1781     end.
     1782   end procedure.
     1783   procedure diasize_change-width :
     1784     define input  parameter p-change-value as decimal   no-undo .
     1785     define input  parameter p-move-resize  as logical   no-undo .
     1786     define variable v-field-group-handle   as handle    no-undo .
     1787     define variable v-object-handle        as handle    no-undo .
     1788     define variable v-frame-width          as decimal   no-undo .
     1789     define variable v-frame-virtual-width  as decimal   no-undo .
     1790     define variable v-browse-width         as decimal   no-undo .
     1791     define variable v-window-width         as decimal   no-undo .
     1792     define variable v-window-virtual-width as decimal   no-undo .
     1793     define variable v-change-sign          as integer   no-undo .
     1794     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1795     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1796     if p-change-value > 0
     1797     then do:
     1798       if frame Dialog-Frame :width + p-change-value >
     1799           session :width-chars
     1800       then do:
     1801         assign
     1802           p-change-value = session :width-chars - frame Dialog-Frame :width
     1803         .
     1804         if p-change-value <= 0
     1805         then do:
     1806           run diasize_position-resize-button in this-procedure .
     1807           return .
     1808         end.
     1809       end.
     1810     end.
     1811     if p-change-value < 0
     1812     then do:
     1813       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1814       then do:
     1815         assign
     1816           p-change-value = v-diasize-orig-frame-width
     1817                          - frame Dialog-Frame :width
     1818         .
     1819         if p-change-value >= 0
     1820         then do:
     1821           run diasize_position-resize-button in this-procedure .
     1822           return .
     1823         end.
     1824       end.
     1825     end.
     1826     if p-change-value >= 0
     1827     then do:
     1828       assign
     1829         v-change-sign = 1
     1830       .
     1831     end.
     1832     else do:
     1833       assign
     1834         v-change-sign = -1
     1835       .
     1836     end.
     1837     assign
     1838       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1839     .
     1840     if p-change-value = 0
     1841     then do:
     1842       run diasize_position-resize-button in this-procedure .
     1843       return .
     1844     end.
     1845     move_block:
     1846     do
     1847     on error undo move_block, leave move_block
     1848     :
     1849       if retry
     1850       then do:
     1851         do
     1852         on error undo move_block, leave move_block
     1853         :
     1854           if p-change-value > 0
     1855           then do:
     1856             for each buf_temp-diasize-handle
     1857             on error undo, next
     1858             :
     1859               assign
     1860                 v-object-handle = buf_temp-diasize-handle.handle-value
     1861               .
     1862               if v-object-handle <> v-diasize-resize-button
     1863               then do:
     1864                 assign
     1865                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1866                 .
     1867               end.
     1868             end.
     1869             assign
     1870               v-diasize-browse-handle :width = v-browse-width
     1871             .
     1872             for each buf_temp-browse-handle
     1873               where buf_temp-browse-handle.browse-type = 'width':u
     1874             on error undo, next
     1875             :
     1876               assign
     1877                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1878               .
     1879             end.
     1880             assign
     1881               frame Dialog-Frame :width = v-frame-width
     1882             .
     1883             if frame Dialog-Frame :scrollable = true
     1884             then do:
     1885               assign
     1886                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1887               .
     1888             end.
     1889             run diasize_position-resize-button in this-procedure .
     1890           end.
     1891           else do:
     1892             if frame Dialog-Frame :scrollable = true
     1893             then do:
     1894               assign
     1895                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1896               .
     1897             end.
     1898             assign
     1899               frame Dialog-Frame :width = v-frame-width
     1900             .
     1901             for each buf_temp-browse-handle
     1902               where buf_temp-browse-handle.browse-type = 'width':u
     1903             on error undo, next
     1904             :
     1905               assign
     1906                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1907               .
     1908             end.
     1909             assign
     1910               v-diasize-browse-handle :width = v-browse-width
     1911             .
     1912             for each buf_temp-diasize-handle
     1913             on error undo, next
     1914             :
     1915               assign
     1916                 v-object-handle = buf_temp-diasize-handle.handle-value
     1917               .
     1918               if v-object-handle <> v-diasize-resize-button
     1919               then do:
     1920                 assign
     1921                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1922                 .
     1923               end.
     1924             end.
     1925             run diasize_position-resize-button in this-procedure .
     1926           end.
     1927           assign
     1928             v-diasize-change-size = false
     1929           .
     1930           leave move_block .
     1931         end.
     1932       end.
     1933       assign
     1934         v-diasize-need-full-display = true
     1935       .
     1936       if v-diasize-change-size = false
     1937       then do:
     1938         assign
     1939           v-diasize-change-size = true
     1940         .
     1941       end.
     1942       else do:
     1943         return .
     1944       end.
     1945       assign
     1946         v-frame-width = frame Dialog-Frame :width
     1947         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1948         v-browse-width = v-diasize-browse-handle :width
     1949       .
     1950       for each buf_temp-browse-handle
     1951         where buf_temp-browse-handle.browse-type = 'width':u
     1952       :
     1953         assign
     1954           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1955         .
     1956       end.
     1957       for each buf_temp-diasize-handle
     1958       :
     1959         delete buf_temp-diasize-handle .
     1960       end.
     1961       assign
     1962         v-field-group-handle = frame Dialog-Frame :first-child
     1963       .
     1964       do while valid-handle(v-field-group-handle)
     1965       :
     1966         assign
     1967           v-object-handle = v-field-group-handle :first-child
     1968         .
     1969         do while valid-handle(v-object-handle)
     1970         :
     1971           if  v-object-handle <> v-diasize-browse-handle :handle
     1972           and v-object-handle <> v-diasize-resize-button
     1973           and can-query(v-object-handle, "row")
     1974           and can-query(v-object-handle, "height")
     1975           and ( v-object-handle :col + v-object-handle :width
     1976                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1977               )
     1978           then do:
     1979             find first buf_temp-browse-handle
     1980               where buf_temp-browse-handle.browse-type   = 'width':u
     1981                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1982               no-error .
     1983             if available buf_temp-browse-handle
     1984             then do:
     1985             end.
     1986             else do:
     1987               create buf_temp-diasize-handle .
     1988               assign
     1989                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1990                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1991               .
     1992             end.
     1993           end.
     1994           assign
     1995             v-object-handle = v-object-handle :next-sibling
     1996           .
     1997         end.
     1998         assign
     1999           v-field-group-handle = v-field-group-handle :next-sibling
     2000         .
     2001       end.
     2002       do with frame Dialog-Frame
     2003       :
     2004         hide v-diasize-resize-button .
     2005         v-diasize-resize-button :row = 1.
     2006         v-diasize-resize-button :column = 1.
     2007       end.
     2008       if p-change-value > 0
     2009       then do:
     2010         if frame Dialog-Frame :scrollable = true
     2011         then do:
     2012           assign
     2013             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2014             no-error .
     2015           if error-status :error
     2016           or error-status :get-message(1) <> ""
     2017           then do:
     2018             undo move_block, retry move_block.
     2019           end.
     2020         end.
     2021         assign
     2022           frame Dialog-Frame :width = v-frame-width + p-change-value
     2023           no-error .
     2024         if error-status :error
     2025         or error-status :get-message(1) <> ""
     2026         then do:
     2027           undo move_block, retry move_block.
     2028         end.
     2029         assign
     2030           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2031         no-error .
     2032         if error-status :error
     2033         or error-status :get-message(1) <> ""
     2034         then do:
     2035           undo move_block, retry move_block.
     2036         end.
     2037         for each buf_temp-browse-handle
     2038           where buf_temp-browse-handle.browse-type = 'width':u
     2039         on error undo move_block, retry move_block
     2040         :
     2041           assign
     2042             buf_temp-browse-handle.browse-handle :width
     2043               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2044             no-error .
     2045           if error-status :error
     2046           or error-status :get-message(1) <> ""
     2047           then do:
     2048             undo move_block, retry move_block .
     2049           end.
     2050         end.
     2051         for each buf_temp-diasize-handle
     2052         on error undo move_block, retry move_block
     2053         :
     2054           assign
     2055             v-object-handle = buf_temp-diasize-handle.handle-value
     2056           .
     2057           if v-object-handle <> v-diasize-resize-button
     2058           then do:
     2059             assign
     2060               v-object-handle :col = v-object-handle :col + p-change-value
     2061               no-error .
     2062             if error-status :error
     2063             or error-status :get-message(1) <> ""
     2064             then do:
     2065               undo move_block, retry move_block .
     2066             end.
     2067           end.
     2068         end.
     2069       end.
     2070       else do:
     2071         for each buf_temp-diasize-handle
     2072         on error undo move_block, retry move_block
     2073         :
     2074           assign
     2075             v-object-handle = buf_temp-diasize-handle.handle-value
     2076           .
     2077           if v-object-handle <> v-diasize-resize-button
     2078           then do:
     2079             assign
     2080               v-object-handle :col = v-object-handle :col + p-change-value
     2081               no-error .
     2082             if error-status :error
     2083             or error-status :get-message(1) <> ""
     2084             then do:
     2085               undo move_block, retry move_block .
     2086             end.
     2087           end.
     2088         end.
     2089         for each buf_temp-browse-handle
     2090           where buf_temp-browse-handle.browse-type = 'width':u
     2091         on error undo move_block, retry move_block
     2092         :
     2093           assign
     2094             buf_temp-browse-handle.browse-handle :width
     2095               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2096             no-error .
     2097           if error-status :error
     2098           or error-status :get-message(1) <> ""
     2099           then do:
     2100             undo move_block, retry move_block .
     2101           end.
     2102         end.
     2103         assign
     2104           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2105           no-error .
     2106         if error-status :error
     2107         or error-status :get-message(1) <> ""
     2108         then do:
     2109           undo move_block, retry move_block.
     2110         end.
     2111         assign
     2112           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2113         no-error .
     2114         if error-status :error
     2115         or error-status :get-message(1) <> ""
     2116         then do:
     2117           undo move_block, retry move_block.
     2118         end.
     2119         if frame Dialog-Frame :scrollable = true
     2120         then do:
     2121           assign
     2122             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2123           no-error .
     2124           if error-status :error
     2125           or error-status :get-message(1) <> ""
     2126           then do:
     2127             undo move_block, retry move_block.
     2128           end.
     2129         end.
     2130       end.
     2131       if p-move-resize
     2132       then do:
     2133         run diasize_position-resize-button in this-procedure .
     2134       end.
     2135       if v-diasize-wndstore = true
     2136       then do:
     2137         if connected("ub") = true
     2138         then do:
     2139           define variable v-cntxt-db-num        as integer   no-undo .
     2140           define variable v-cntxt-userid        as character no-undo .
     2141           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2142                                             , OUTPUT v-cntxt-userid
     2143                                             ) .
     2144           run gbl/wndsizew.p
     2145             (input  v-cntxt-db-num
     2146             ,input  v-cntxt-userid
     2147             ,input  v-diasize-proc-name
     2148             ,input  'width':u
     2149             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2150             ) .
     2151         end.
     2152       end.
     2153     end.
     2154     assign
     2155       v-diasize-change-size = false
     2156     .
     2157   end procedure.
     2158   procedure diasize_set-width :
     2159     define input  parameter p-new-width  as decimal   no-undo .
     2160     define input  parameter p-move-resize as logical   no-undo .
     2161     do
     2162     on error undo, return error return-value
     2163     :
     2164       run diasize_change-width in this-procedure
     2165         (input  (p-new-width - frame Dialog-Frame :width)
     2166         ,input  p-move-resize
     2167         ) .
     2168     end.
     2169   end procedure.
     2170   procedure diasize_position-resize-button :
     2171     do with frame Dialog-Frame
     2172     :
     2173       hide v-diasize-resize-button .
     2174       assign
     2175         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2176                     - 1
     2177                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2178         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2179                     - 1
     2180                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2181       .
     2182       view v-diasize-resize-button .
     2183     end.
     2184   end procedure.
     2185   on alt-right anywhere
     2186   do:
     2187     run diasize_change-width in this-procedure
     2188       (input 1
     2189       ,input true
     2190       ) .
     2191     return no-apply .
     2192   end.
     2193   on alt-left anywhere
     2194   do:
     2195     run diasize_change-width in this-procedure
     2196       (input -1
     2197       ,input true
     2198       ) .
     2199     return no-apply .
     2200   end.
     2201   on alt-down anywhere
     2202   do:
     2203     run diasize_change-height in this-procedure
     2204       (input 1
     2205       ,input true
     2206       ) .
     2207     return no-apply .
     2208   end.
     2209   on alt-up anywhere
     2210   do:
     2211     run diasize_change-height in this-procedure
     2212       (input -1
     2213       ,input true
     2214       ) .
     2215     return no-apply .
     2216   end.
     2217   on alt-enter of frame Dialog-Frame
     2218   do:
     2219     run diasize_maximize in this-procedure
     2220       (input  ?
     2221       ).
     2222     return no-apply .
     2223   end.
     2224   procedure diasize_end-move :
     2225     do
     2226     on error undo, return error return-value
     2227     :
     2228       define variable v-row-delta as decimal   no-undo .
     2229       define variable v-col-delta as decimal   no-undo .
     2230       define variable v-new-row as decimal   no-undo .
     2231       define variable v-new-col as decimal   no-undo .
     2232       assign
     2233         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2234         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2235       .
     2236       assign
     2237         v-row-delta = v-new-row - frame Dialog-Frame :height
     2238         v-col-delta = v-new-col - frame Dialog-Frame :width
     2239       .
     2240       run diasize_change-height in this-procedure
     2241         (input v-row-delta
     2242         ,input true
     2243         ) .
     2244       run diasize_change-width in this-procedure
     2245         (input v-col-delta
     2246         ,input true
     2247         ) .
     2248     end.
     2249   end procedure.
     2250   procedure diasize_maximize :
     2251     define input  parameter p-action as logical   no-undo .
     2252     do
     2253     on error undo, return error return-value
     2254     :
     2255       if p-action = ?
     2256       then do:
     2257         if v-diasize-need-maximize = true
     2258         then do:
     2259           assign
     2260             p-action = true
     2261           .
     2262         end.
     2263         else do:
     2264           assign
     2265             p-action = false
     2266           .
     2267         end.
     2268       end.
     2269       if p-action = true
     2270       then do:
     2271         run diasize_change-height in this-procedure
     2272           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2273               - frame Dialog-Frame :height-chars
     2274           ,input true
     2275           ) .
     2276         run diasize_change-width in this-procedure
     2277           (input session :width-chars
     2278               - frame Dialog-Frame :width-chars
     2279           ,input true
     2280           ) .
     2281         assign
     2282           v-diasize-need-maximize = false
     2283         .
     2284       end.
     2285       else do:
     2286         run diasize_change-width in this-procedure
     2287           (input v-diasize-orig-frame-width
     2288               - frame Dialog-Frame :width-chars
     2289           ,input true
     2290           ) .
     2291         run diasize_change-height in this-procedure
     2292           (input v-diasize-orig-frame-height
     2293               - frame Dialog-Frame :height-chars
     2294           ,input true
     2295           ) .
     2296         assign
     2297           v-diasize-need-maximize = true
     2298         .
     2299       end.
     2300     end.
     2301   end procedure.
     2302   procedure diasize_restore-orig-size :
     2303     do
     2304     on error undo, return error return-value
     2305     :
     2306       assign
     2307         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2308         v-diasize-current-frame-height = frame Dialog-Frame :height
     2309       .
     2310       run diasize_set-height in this-procedure
     2311         (input  v-diasize-orig-frame-height
     2312         ,input  true
     2313         ) .
     2314       run diasize_set-width in this-procedure
     2315         (input  v-diasize-orig-frame-width
     2316         ,input  true
     2317         ) .
     2318     end.
     2319   end procedure.
     2320   procedure diasize_restore-current-size :
     2321     do
     2322     on error undo, return error return-value
     2323     :
     2324       run diasize_set-height in this-procedure
     2325         (input  v-diasize-current-frame-height
     2326         ,input  true
     2327         ) .
     2328       run diasize_set-width in this-procedure
     2329         (input  v-diasize-current-frame-width
     2330         ,input  true
     2331         ) .
     2332     end.
     2333   end procedure.
     2334   procedure diasize_set-browse-handle :
     2335     define input  parameter p-browse-handle as handle   no-undo .
     2336     define buffer buf_temp-browse-handle for temp-browse-handle .
     2337     do
     2338     on error undo, return error return-value
     2339     :
     2340       assign
     2341         v-diasize-browse-handle = p-browse-handle
     2342       .
     2343       for each buf_temp-browse-handle
     2344       on error undo, return error return-value
     2345       :
     2346         delete buf_temp-browse-handle .
     2347       end.
     2348     end.
     2349   end procedure.
     2350   procedure diasize_add_browse :
     2351     define input  parameter p-browse-type   as character no-undo .
     2352     define input  parameter p-browse-handle as handle    no-undo .
     2353     define buffer buf_temp-browse-handle for temp-browse-handle .
     2354     do
     2355     on error undo, return error return-value
     2356     :
     2357       assign
     2358         v-diasize-browse-number = v-diasize-browse-number + 1
     2359       .
     2360       create buf_temp-browse-handle .
     2361       assign
     2362         buf_temp-browse-handle.browse-type   = p-browse-type
     2363         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2364         buf_temp-browse-handle.browse-handle = p-browse-handle
     2365       .
     2366     end.
     2367   end procedure.
     2368   procedure diasize_init :
     2369     define variable v-default-value    as logical   no-undo .
     2370     define variable v-restore-saved    as logical   no-undo .
     2371     define variable v-resize-value-str as character no-undo .
     2372     do
     2373     on error undo, return error return-value
     2374     :
     2375       do with frame Dialog-Frame
     2376       :
     2377         assign
     2378           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2379           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2380           v-diasize-browse-handle     = browse br-ctare :handle
     2381         .
     2382         create button v-diasize-resize-button
     2383         assign
     2384           parent        = frame Dialog-Frame :first-child
     2385           label         = "s"
     2386           height-pixels = 16
     2387           width-pixels  = 16
     2388           visible       = true
     2389           sensitive     = true
     2390           movable       = true
     2391           triggers:
     2392             on end-move persistent run diasize_end-move in this-procedure .
     2393           end triggers.
     2394         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2395         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2396         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2397         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2398         assign
     2399           v-diasize-wndmax = false
     2400         .
     2401         if connected("ub") = true
     2402         then do:
     2403           define variable v-cntxt-db-num        as integer   no-undo .
     2404           define variable v-cntxt-userid        as character no-undo .
     2405           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2406                                             , OUTPUT v-cntxt-userid
     2407                                             ) .
     2408           run gbl/wndpar_r.p
     2409             (input  v-cntxt-db-num
     2410             ,input  v-cntxt-userid
     2411             ,input  'wndmax':U
     2412             ,output v-diasize-wndmax
     2413             ,output v-default-value
     2414             ) .
     2415         end.
     2416         assign
     2417           v-diasize-wndstore = false
     2418         .
     2419         if connected("ub") = true
     2420         then do:
     2421           run gbl/wndpar_r.p
     2422             (input  v-cntxt-db-num
     2423             ,input  v-cntxt-userid
     2424             ,input  'wndstore':U
     2425             ,output v-diasize-wndstore
     2426             ,output v-default-value
     2427             ) .
     2428         end.
     2429         assign
     2430           v-diasize-proc-name = entry(1, program-name(2), '.')
     2431         .
     2432         if v-diasize-wndstore = true
     2433         then do:
     2434           assign
     2435             v-restore-saved = false
     2436           .
     2437           if connected("ub") = true
     2438           then do:
     2439             run gbl/wndsizer.p
     2440               (input  v-cntxt-db-num
     2441               ,input  v-cntxt-userid
     2442               ,input  v-diasize-proc-name
     2443               ,input  'height':u
     2444               ,output v-resize-value-str
     2445               ) .
     2446             if v-resize-value-str <> '':U
     2447             then do:
     2448               run diasize_change-height in this-procedure
     2449                 (input  integer(v-resize-value-str)
     2450                 ,input  true
     2451                 ) .
     2452               assign
     2453                 v-restore-saved = true
     2454               .
     2455             end.
     2456           end.
     2457           if connected("ub") = true
     2458           then do:
     2459             run gbl/wndsizer.p
     2460               (input  v-cntxt-db-num
     2461               ,input  v-cntxt-userid
     2462               ,input  v-diasize-proc-name
     2463               ,input  'width':u
     2464               ,output v-resize-value-str
     2465               ) .
     2466             if v-resize-value-str <> '':U
     2467             then do:
     2468               run diasize_change-width in this-procedure
     2469                 (input  integer(v-resize-value-str)
     2470                 ,input  true
     2471                 ) .
     2472               assign
     2473                 v-restore-saved = true
     2474               .
     2475             end.
     2476           end.
     2477           if v-restore-saved <> true
     2478           then do:
     2479             if v-diasize-wndmax = true
     2480             then do:
     2481               run diasize_maximize in this-procedure
     2482                 (input  true
     2483                 ) .
     2484             end.
     2485           end.
     2486         end.
     2487         else do:
     2488           if v-diasize-wndmax = true
     2489           then do:
     2490             run diasize_maximize in this-procedure
     2491               (input  true
     2492               ) .
     2493           end.
     2494         end.
     2495       end.
     2496     end.
     2497   end procedure.
     2498   procedure diasize_need-full-display :
     2499     define output parameter p-need-full-display as logical   no-undo .
     2500     do
     2501     on error undo, return error return-value
     2502     :
     2503       assign
     2504         p-need-full-display = v-diasize-need-full-display
     2505       .
     2506       assign
     2507         v-diasize-need-full-display = false
     2508       .
     2509     end.
     2510   end procedure.
     2511   procedure get-context :
     2512      define output parameter p-db-num as integer          no-undo.
     2513      define output parameter p-user-id as character        no-undo.
     2514      define variable v-login               as character    no-undo.
     2515      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2516      define buffer buf_user-login  for ub.user-login .
     2517      do
     2518      on error undo, return error
     2519      :
     2520            FIND FIRST buf_sys-ctrl no-lock.
     2521            ASSIGN
     2522               v-login = USERID("ub")
     2523               p-db-num = buf_sys-ctrl.db-num
     2524            .
     2525            FIND FIRST buf_user-login
     2526                 WHERE buf_user-login.db-num = p-db-num
     2527                   AND buf_user-login.user-login = v-login
     2528                 no-lock
     2529                 no-error
     2530                 .
     2531            IF AVAILABLE buf_user-login
     2532            THEN DO:
     2533               assign
     2534                  p-user-id = buf_user-login.user-id
     2535               .
     2536            END.
     2537      end.
     2538   end procedure.
     2539   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2540   on f5 of frame Dialog-Frame anywhere
     2541   do:
     2542     v-doc-rec = recid(X_tare). run openbr in this-procedure. reposition br-ctare to recid v-doc-rec no-error.               apply 'value-changed' to br-ctare.
     2543       apply "VALUE-CHANGED" to BR-changes.
     2544   end.
     2545   def var sort-labelbr-ctare   as character no-undo .
     2546   def var sort-clmnbr-ctare    as handle    no-undo .
     2547   def var cur-clmnbr-ctare     as handle    no-undo .
     2548   def var cur-clmn-locbr-ctare as integer   no-undo .
     2549   def var re-querybr-ctare     as logical   initial no no-undo .
     2550   on start-search, ctrl-o of br-ctare in frame Dialog-Frame do:
     2551      run sort-brbr-ctare
     2552        (input (if available temp-changes
     2553                then recid(temp-changes)
     2554                else ?
     2555               )
     2556        ).
     2557   end.
     2558   PROCEDURE sort-brbr-ctare :
     2559     define input parameter p-recid as recid no-undo .
     2560     if re-querybr-ctare = no then do:
     2561       assign
     2562          cur-clmnbr-ctare = br-ctare:current-column in frame Dialog-Frame
     2563       .
     2564       if sort-clmnbr-ctare <> ? then sort-clmnbr-ctare:column-fgcolor = 0.
     2565       if cur-clmnbr-ctare = sort-clmnbr-ctare then do:
     2566         assign
     2567            sort-labelbr-ctare = ""
     2568            sort-clmnbr-ctare = ?
     2569         .
     2570        end.
     2571        else do:
     2572          assign
     2573            sort-labelbr-ctare = cur-clmnbr-ctare:label
     2574            sort-clmnbr-ctare  = cur-clmnbr-ctare
     2575            sort-clmnbr-ctare:column-fgcolor = 4
     2576          .
     2577        end.
     2578      end.
     2579     assign
     2580       cur-clmn-locbr-ctare = 1
     2581     .
     2582     def var column-handle as handle no-undo .
     2583     column-handle = br-ctare:first-column.
     2584     do while valid-handle(column-handle) :
     2585       if column-handle = cur-clmnbr-ctare then do:
     2586         leave .
     2587       end.
     2588       column-handle = column-handle:NEXT-COLUMN.
     2589       assign
     2590         cur-clmn-locbr-ctare = cur-clmn-locbr-ctare + 1
     2591       .
     2592     end.
     2593     case sort-labelbr-ctare:
     2594           when X_c-tare.tare-code:label in browse br-ctare then DO:   assign     sort-column-name = "X_c-tare.tare-code"   .   run OpenBr.   . END.
     2595           when X_c-tare.corr-date:label in browse br-ctare then DO:   assign     sort-column-name = "X_c-tare.corr-date"   .   run OpenBr.   . END.
     2596       otherwise do:
     2597         assign
     2598           sort-column-name = ""
     2599         .
     2600         run OpenBr.
     2601           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-ctare') then do:
     2602             run mv-brw-defaultbr-ctare.
     2603           end.
     2604         if sort-labelbr-ctare <> "" then do:
     2605           assign
     2606             cur-clmnbr-ctare:column-fgcolor = 0
     2607           .
     2608         end.
     2609         assign
     2610           cur-clmn-locbr-ctare = ?
     2611         .
     2612       end.
     2613     end case.
     2614       if cur-clmn-locbr-ctare <> ? then do:
     2615         if can-do( this-procedure:internal-entries, 'ch-clmnbr-ctare') then do:
     2616           run ch-clmnbr-ctare in this-procedure (cur-clmn-locbr-ctare).
     2617         end.
     2618       end.
     2619     if p-recid <> ? then do:
     2620       reposition br-ctare to recid p-recid no-error.
     2621       apply "value-changed" to br-ctare in frame Dialog-Frame.
     2622     end.
     2623     apply "entry" to br-ctare in frame Dialog-Frame.
     2624   END PROCEDURE.
     2625   procedure re-open-query-srt-clmnbr-ctare:
     2626   if cur-clmnbr-ctare = ? then do:
     2627      run OpenBr.
     2628   end.
     2629   else do:
     2630      assign re-querybr-ctare = yes.
     2631      run sort-brbr-ctare
     2632        (input (if available temp-changes
     2633                then recid(temp-changes)
     2634                else ?
     2635               )
     2636        ).
     2637      assign re-querybr-ctare = no.
     2638   end.
     2639   end.
     2640   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2641   do:
     2642     BR-changes :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2643   end.
     2644   MAIN-BLOCK:
     2645   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2646      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2647    if LOOKUP(p-mode, 'one':U,
     2648                   chr(4)) = 0
     2649        then dO:
     2650       message
     2651       vss-workfile vss-revision vss-description skip
     2652       "Неверное значение параметров вызова p-mode"
     2653       p-mode
     2654       view-as alert-box ERROR.
     2655       return error .
     2656    end.
     2657    if p-mode = "one":U then do:
     2658     find first X_tare no-lock where
     2659                   X_tare.tare-code = p-tare-code no-error.
     2660       if not available X_tare then do:
     2661           message
     2662           vss-workfile vss-revision vss-description skip
     2663           "Неверное значение параметра вызова p-tare-code"
     2664           p-tare-code
     2665           view-as alert-box ERROR.
     2666           return.
     2667       end.
     2668     end.
     2669     v-rid-list = p-rid-list.
     2670   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2671   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2672     (output v-db-num
     2673     )  .
     2674     RUN MyEnable.
     2675     RUn OpenBR.
     2676     HIDE mark-num in frame Dialog-Frame .
     2677     if v-doc-rec <> ? then
     2678     REPOSITION br-ctare to recid v-doc-rec No-ERROR.
     2679   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2680   DEF VAR cur-clmn-numbr-ctare as INT EXTENT 6 no-undo.
     2681   DEF VAR varmvibr-ctare       as INT no-undo.
     2682   DEF VAR varmvjbr-ctare       as INT no-undo.
     2683   DEF VAR varmvkbr-ctare       as INT no-undo.
     2684   DEF VAR varmvlbr-ctare       as INT no-undo.
     2685   DEF VAR move-elementbr-ctare as INT no-undo.
     2686   def var jjbr-ctare           as int no-undo.
     2687   do varmvibr-ctare = 1 to EXTENT(cur-clmn-numbr-ctare):
     2688     ASSIGN cur-clmn-numbr-ctare[varmvibr-ctare] = varmvibr-ctare.
     2689   END.
     2690   RUN start-mv-clmnbr-ctare.
     2691   PROCEDURE start-mv-clmnbr-ctare:
     2692   def var old-session as logical no-undo.
     2693      old-session = SESSION:IMMEDIATE-DISPLAY.
     2694      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2695          IF  p-mode = 'one'  THEN DO:
     2696      DO jjbr-ctare = NUM-ENTRIES('1,2,3,4,5,6') TO 1 BY -1:
     2697        RUN re-move-clmnbr-ctare ( cur-clmn-numbr-ctare[INTEGER(ENTRY (jjbr-ctare, '1,2,3,4,5,6'))] , 1).
     2698      END.
     2699          END.
     2700      SESSION:IMMEDIATE-DISPLAY = old-session.
     2701   END.
     2702   ON ctrl-cursor-right OF BROWSE br-ctare do:
     2703     RUN re-move-clmnbr-ctare ( 1, 6).
     2704   END.
     2705   ON ctrl-cursor-left OF BROWSE br-ctare do:
     2706     RUN re-move-clmnbr-ctare (6, 1).
     2707   END.
     2708   PROCEDURE re-move-clmnbr-ctare:
     2709     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2710     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2711     DO varmvibr-ctare = 1 TO EXTENT(cur-clmn-numbr-ctare):
     2712       if cur-clmn-numbr-ctare[varmvibr-ctare] = source-column THEN cur-clmn-numbr-ctare[varmvibr-ctare] = -1.
     2713     END.
     2714     if br-ctare:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2715     if source-column > target-column THEN
     2716     DO varmvjbr-ctare = source-column - 1 to target-column BY -1:
     2717       DO varmvibr-ctare = 1 TO EXTENT(cur-clmn-numbr-ctare):
     2718           if cur-clmn-numbr-ctare[varmvibr-ctare] = varmvjbr-ctare THEN DO:
     2719             cur-clmn-numbr-ctare[varmvibr-ctare] = cur-clmn-numbr-ctare[varmvibr-ctare] + 1.
     2720           END.
     2721       END.
     2722     END.
     2723     ELSE
     2724     DO varmvjbr-ctare = source-column + 1 to target-column:
     2725       DO varmvibr-ctare = 1 TO EXTENT(cur-clmn-numbr-ctare):
     2726         if cur-clmn-numbr-ctare[varmvibr-ctare] = varmvjbr-ctare THEN DO:
     2727           cur-clmn-numbr-ctare[varmvibr-ctare] = cur-clmn-numbr-ctare[varmvibr-ctare] - 1.
     2728         END.
     2729       END.
     2730     END.
     2731     DO varmvibr-ctare = 1 TO EXTENT(cur-clmn-numbr-ctare):
     2732       if cur-clmn-numbr-ctare[varmvibr-ctare] = -1 THEN cur-clmn-numbr-ctare[varmvibr-ctare] = target-column.
     2733     END.
     2734   END PROCEDURE.
     2735   PROCEDURE ch-clmnbr-ctare:
     2736     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2737     if cur-clmn-loc <= 1 then do:
     2738       return .
     2739     end.
     2740     DO varmvibr-ctare = 1 TO EXTENT(cur-clmn-numbr-ctare):
     2741       if cur-clmn-numbr-ctare[varmvibr-ctare] = cur-clmn-loc THEN move-elementbr-ctare = varmvibr-ctare.
     2742     END.
     2743     RUN re-move-clmnbr-ctare (cur-clmn-loc, 1).
     2744   END PROCEDURE.
     2745   PROCEDURE mv-brw-defaultbr-ctare:
     2746   def var old-session as logical no-undo.
     2747     old-session = SESSION:IMMEDIATE-DISPLAY.
     2748     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2749     do varmvlbr-ctare = 1 to EXTENT(cur-clmn-numbr-ctare):
     2750       RUN re-move-clmnbr-ctare (cur-clmn-numbr-ctare[varmvlbr-ctare], varmvlbr-ctare).
     2751     END.
     2752     RUN start-mv-clmnbr-ctare.
     2753     SESSION:IMMEDIATE-DISPLAY = old-session.
     2754   END PROCEDURE.
     2755   .
     2756    run diasize_add_browse in this-procedure
     2757       (input  'width':u
     2758       ,input  browse br-changes :handle
     2759       ) .
     2760    run diasize_init in this-procedure .
     2761   WAIT-FOR GO OF FRAME Dialog-Frame.
     2762   END.
     2763   RUN disable_UI.
     2764   PROCEDURE disable_UI :
     2765     HIDE FRAME Dialog-Frame.
     2766   END PROCEDURE.
     2767   PROCEDURE enable_UI :
     2768     DISPLAY mark-num
     2769         WITH FRAME Dialog-Frame.
     2770     ENABLE b-quit B-mark B-sel B-Help br-ctare BR-changes mark-num
     2771         WITH FRAME Dialog-Frame.
     2772     VIEW FRAME Dialog-Frame.
     2773     OPEN QUERY br-ctare FOR EACH X_c-tare NO-LOCK INDEXED-REPOSITION.
     2774   END PROCEDURE.
     2775   PROCEDURE MyEnable :
     2776   assign
     2777   temp-changes.l_name:resizable in browse br-changes = true
     2778   temp-changes.v_old:resizable in browse br-changes = true
     2779   temp-changes.v_new:resizable in browse br-changes = true
     2780   temp-changes.l_name:width in browse br-changes = 30
     2781   temp-changes.v_old:width in browse br-changes = 40
     2782   temp-changes.v_new:width in browse br-changes = 40
     2783   .
     2784   DISPLAY mark-num
     2785   WITH FRAME Dialog-Frame.
     2786   ENABLE
     2787   b-quit
     2788   B-mark when LOOKUP("b-mark":U, bttns) > 0
     2789   B-sel when LOOKUP("b-sel":U, bttns) > 0
     2790   B-Help
     2791   br-ctare mark-num
     2792   br-changes
     2793   with FRAME Dialog-Frame.
     2794   VIEW FRAME Dialog-Frame.
     2795   END PROCEDURE.
     2796   PROCEDURE OpenBr :
     2797   OPEN QUERY br-ctare FOR EACH X_c-tare NO-LOCK where
     2798                                  X_c-tare.tare-code = p-tare-code
     2799                              AND X_c-tare.corr-user-db-num = 0
     2800                                 INDEXED-REPOSITION.
     2801   APPLY "VALUE-CHANGED" TO br-ctare in frame Dialog-Frame.
     2802   APPLY "ENTRY" TO br-ctare.
     2803   END PROCEDURE.
     2804   PROCEDURE proc-br-ctare :
     2805   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2806   if b-sel:sensitive in frame Dialog-Frame then dO:
     2807       if b-mark:sensitive then do:
     2808           apply "choose" to b-mark in frame Dialog-Frame.
     2809       end.
     2810       else do:
     2811           apply "choose" to b-sel in frame Dialog-Frame.
     2812       end.
     2813   end.
     2814   else do:
     2815       if b-lookup:sensitive then
     2816       apply "choose" to b-lookup in frame Dialog-Frame.
     2817   end.
     2818   END PROCEDURE.
     2819   PROCEDURE proc-view-changes :
     2820   for each temp-changes:
     2821       delete temp-changes.
     2822   END.
     2823   if not available X_c-tare then do:
     2824     Open QUery br-changes for each temp-changes.
     2825     return.
     2826   end.
     2827   define variable v-label-param as character no-undo .
     2828   v-label-param =
     2829     "tare-code" + chr(4) + "Код" + chr(4) + "" + chr(8)
     2830     + "stts" + chr(4) + "Статус" + chr(4) + "" + chr(8)
     2831     + "tare-name" + chr(4) + "Длинное название" + chr(4) + ""  .
     2832    run proc-full-temp-changes in this-procedure (
     2833                                                input  buffer X_c-tare:handle
     2834                                               ,input  'tare':U
     2835                                               ,input  "tare-code,stts,tare-name"
     2836                                               ,input  v-label-param).
     2837   Open QUery br-changes for each temp-changes.
     2838   END PROCEDURE.
