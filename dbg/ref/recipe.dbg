     4377     define variable v-cntxt-obj-code      as integer   no-undo .
     4378     define variable v-cntxt-db-num-obj    as integer   no-undo .
     4379     define variable v-cntxt-is-admin      as logical   no-undo .
     4380   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4381   define new global shared variable g#attr-lib  as handle no-undo .
