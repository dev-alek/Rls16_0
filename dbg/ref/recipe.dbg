     6584        SIZE 10 BY 1.
     6585   DEFINE BUTTON b-change
     6586        LABEL "&Изменить"
     6587        SIZE 10 BY 1.
     6588   DEFINE BUTTON b-close
     6589        LABEL "&Выход"
     6590        SIZE 10 BY 1
     6591        BGCOLOR 8 .
     6592   DEFINE BUTTON b-down
     6593        LABEL "Вни&з"
     6594        SIZE 10 BY 1.
     6595   DEFINE BUTTON b-gds
     6596        LABEL "&Товары"
     6597        SIZE 10 BY 1.
     6598   DEFINE BUTTON b-help
     6599        LABEL "Помощ&ь"
     6600        SIZE 10 BY 1
     6601        BGCOLOR 8 .
     6602   DEFINE BUTTON b-hst
     6603        LABEL "&История"
     6604        SIZE 10 BY 1.
     6605   DEFINE BUTTON b-print
     6606        LABEL "Пе&чать"
     6607        SIZE 10 BY 1.
     6608   DEFINE BUTTON b-rcp
     6609        LABEL "&Рецепт"
     6610        SIZE 10 BY 1.
     6611   DEFINE BUTTON b-recipe-develop
     6612        LABEL "АктыПро"
     6613        SIZE 10 BY 1.
     6614   DEFINE BUTTON b-up
     6615        LABEL "Ввер&х"
     6616        SIZE 10 BY 1.
     6617   DEFINE VARIABLE ed-recipe-technique AS CHARACTER
     6618        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     6619        SIZE 96.63 BY 2.29 NO-UNDO.
     6620   DEFINE VARIABLE br-table-label AS CHARACTER FORMAT "X(256)":U INITIAL "Ингредиенты рецепта"
     6621        VIEW-AS FILL-IN
     6622        SIZE 43 BY 1 NO-UNDO.
     6623   DEFINE VARIABLE fi-init-units AS CHARACTER FORMAT "X(3)":U
     6624        LABEL "Ед.изм"
     6625        VIEW-AS FILL-IN
     6626        SIZE 4.13 BY 1
     6627        FGCOLOR 4  NO-UNDO.
     6628   DEFINE VARIABLE fi-portion-qnty AS INTEGER FORMAT ">,>>>,>>9":U INITIAL 0
     6629        LABEL "Порций"
     6630        VIEW-AS FILL-IN
     6631        SIZE 14 BY 1 NO-UNDO.
     6632   DEFINE VARIABLE fi-portion-weight AS DECIMAL FORMAT ">>>>9.999":U INITIAL 0
     6633        LABEL "Вес порции (кг)"
     6634        VIEW-AS FILL-IN
     6635        SIZE 14 BY 1 NO-UNDO.
     6636   DEFINE VARIABLE fi-recipe-name AS CHARACTER FORMAT "X(256)":U
     6637        LABEL "Наименование"
     6638        VIEW-AS FILL-IN
     6639        SIZE 67 BY 1 NO-UNDO.
     6640   DEFINE VARIABLE fi-recipe-qnty AS DECIMAL FORMAT ">>>>9.<<<":U INITIAL 0
     6641        LABEL "Нетто"
     6642        VIEW-AS FILL-IN
     6643        SIZE 14 BY 1 NO-UNDO.
     6644   DEFINE VARIABLE fi-recipe-ref-num AS CHARACTER FORMAT "X(14)":U
     6645        LABEL "Номер по справ. рецептур"
     6646        VIEW-AS FILL-IN
     6647        SIZE 14.13 BY 1 NO-UNDO.
     6648   DEFINE VARIABLE fi-recipe-technique-label AS CHARACTER FORMAT "X(256)":U INITIAL "Описание технологии приготовления"
     6649        VIEW-AS FILL-IN
     6650        SIZE 43 BY 1 NO-UNDO.
     6651   DEFINE VARIABLE v-calories AS DECIMAL FORMAT ">>>>9.9":U INITIAL 0
     6652        LABEL "Калории"
     6653         VIEW-AS TEXT
     6654        SIZE 7.5 BY .67
     6655        FGCOLOR 4  NO-UNDO.
     6656   DEFINE VARIABLE v-carbohydrate AS DECIMAL FORMAT ">>9.9":U INITIAL 0
     6657        LABEL "Углеводы"
     6658         VIEW-AS TEXT
     6659        SIZE 6.75 BY .67
     6660        FGCOLOR 4  NO-UNDO.
     6661   DEFINE VARIABLE v-fat AS DECIMAL FORMAT ">>9.9":U INITIAL 0
     6662        LABEL "Жиры"
     6663         VIEW-AS TEXT
     6664        SIZE 7.25 BY .67
     6665        FGCOLOR 4  NO-UNDO.
     6666   DEFINE VARIABLE v-protein AS DECIMAL FORMAT ">>9.9":U INITIAL 0
     6667        LABEL "Белки"
     6668         VIEW-AS TEXT
     6669        SIZE 6.75 BY .67
     6670        FGCOLOR 4  NO-UNDO.
     6671   DEFINE VARIABLE tb-global AS LOGICAL INITIAL no
     6672        LABEL "Глобальный"
     6673        VIEW-AS TOGGLE-BOX
     6674        SIZE 13.88 BY .83 NO-UNDO.
     6675   DEFINE QUERY br-table FOR
     6676         ub.recipe-gds SCROLLING.
     6677   DEFINE BROWSE br-table
     6678     QUERY br-table NO-LOCK DISPLAY
     6679         get-browse-field( input 1, input recipe-gds.artic, input recipe-gds.prod-type, input recipe-gds.prod-code ) COLUMN-LABEL "У" FORMAT "X(1)":U
     6680         ub.recipe-gds.is-waste COLUMN-LABEL "Отх" FORMAT "+/-":U
     6681         ub.recipe-gds.artic FORMAT "X(16)":U
     6682         get-browse-field( input 5, input recipe-gds.artic, input recipe-gds.prod-type, input recipe-gds.prod-code ) COLUMN-LABEL "Р" FORMAT "X(1)":U
     6683         ub.recipe-gds.qnty COLUMN-LABEL "Нетто" FORMAT "->>,>>>,>>9.<<<":U
     6684         ub.recipe-gds.brutto-qnty FORMAT "->>,>>>,>>9.<<<":U
     6685         ub.recipe-gds.coeff-waste COLUMN-LABEL "%Потерь" FORMAT "->,>>9.<<<":U
     6686         get-browse-field( input 3, input recipe-gds.artic, input recipe-gds.prod-type, input recipe-gds.prod-code ) COLUMN-LABEL "ЕИ" FORMAT "X(3)":U
     6687         get-browse-field( input 2, input recipe-gds.artic, input recipe-gds.prod-type, input recipe-gds.prod-code ) COLUMN-LABEL "Название товара" FORMAT "X(40)":U
     6688         recipe-gds.prod-type + " ":U + string(recipe-gds.prod-code) COLUMN-LABEL "Пр-ль" FORMAT "X(10)":U
     6689         get-browse-field( input 4, input recipe-gds.artic, input recipe-gds.prod-type, input recipe-gds.prod-code ) COLUMN-LABEL "Наименование пр-ля" FORMAT "X(40)":U
     6690         get-season-procent (buffer recipe-gds) COLUMN-LABEL "%Сезонн" FORMAT "->,>>9.<<<":U
     6691         get-brutto-qnty-season (buffer recipe-gds) COLUMN-LABEL "Брутто сез" FORMAT "->>,>>>,>>9.<<<":U
     6692               WIDTH 12
     6693         fbrnutro_get-gds-recipe-nutrition-by-code (recipe-gds.recipe-code,recipe-gds.artic, recipe-gds.prod-type, recipe-gds.prod-code, 'calories':U ) COLUMN-LABEL "Калории" FORMAT ">>>,>>9.9":U
     6694         fbrnutro_get-gds-recipe-nutrition-by-code (recipe-gds.recipe-code,recipe-gds.artic, recipe-gds.prod-type, recipe-gds.prod-code, 'protein':U ) COLUMN-LABEL "Белки" FORMAT ">>>,>>9.9":U
     6695         fbrnutro_get-gds-recipe-nutrition-by-code (recipe-gds.recipe-code,recipe-gds.artic, recipe-gds.prod-type, recipe-gds.prod-code, 'fat':U ) COLUMN-LABEL "Жиры" FORMAT ">>>,>>9.9":U
     6696         fbrnutro_get-gds-recipe-nutrition-by-code (recipe-gds.recipe-code,recipe-gds.artic, recipe-gds.prod-type, recipe-gds.prod-code, 'carbohydrate':U ) COLUMN-LABEL "Углеводы" FORMAT ">>>,>>9.9":U
     6697       WITH NO-ROW-MARKERS SEPARATORS SIZE 96.88 BY 12.5.
     6698   DEFINE FRAME Dialog-Frame
     6699        b-close AT ROW 1.21 COL 1.63
     6700        b-cancel AT ROW 1.21 COL 11.63
     6701        b-gds AT ROW 1.21 COL 21.63
     6702        b-hst AT ROW 1.21 COL 31.63
     6703        b-rcp AT ROW 1.21 COL 41.63
     6704        b-additional AT ROW 1.21 COL 51.63
     6705        b-recipe-develop AT ROW 1.21 COL 61.63
     6706        b-print AT ROW 1.21 COL 78.63
     6707        b-help AT ROW 1.21 COL 88.63
     6708        fi-recipe-name AT ROW 2.58 COL 14.63 COLON-ALIGNED
     6709        tb-global AT ROW 2.58 COL 85
     6710        fi-recipe-qnty AT ROW 3.67 COL 14.63 COLON-ALIGNED
     6711        fi-init-units AT ROW 3.67 COL 38 COLON-ALIGNED
     6712        fi-recipe-ref-num AT ROW 3.67 COL 82.5 COLON-ALIGNED
     6713        fi-portion-qnty AT ROW 4.79 COL 14.63 COLON-ALIGNED
     6714        fi-recipe-technique-label AT ROW 6.04 COL 2 NO-LABEL
     6715        fi-portion-weight AT ROW 6.08 COL 61.5 COLON-ALIGNED
     6716        ed-recipe-technique AT ROW 7.21 COL 2 NO-LABEL
     6717        br-table-label AT ROW 9.67 COL 2 NO-LABEL
     6718        b-change AT ROW 9.71 COL 46.63
     6719        b-up AT ROW 9.71 COL 77.88
     6720        b-down AT ROW 9.71 COL 88.63
     6721        br-table AT ROW 10.88 COL 1.75
     6722        v-fat AT ROW 5.04 COL 40.75 COLON-ALIGNED WIDGET-ID 4
     6723        v-protein AT ROW 5.04 COL 55.25 COLON-ALIGNED WIDGET-ID 6
     6724        v-calories AT ROW 5.04 COL 88.5 COLON-ALIGNED WIDGET-ID 2
     6725        v-carbohydrate AT ROW 5.08 COL 72.75 COLON-ALIGNED WIDGET-ID 8
     6726        SPACE(17.47) SKIP(17.78)
     6727       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     6728            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     6729            TITLE "Рецепт"
     6730            CANCEL-BUTTON b-cancel.
     6731   ASSIGN
     6732          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     6733          FRAME Dialog-Frame:HIDDEN           = TRUE.
     6734   ASSIGN
     6735          b-print:POPUP-MENU IN FRAME Dialog-Frame       = MENU POPUP-MENU-b-print:HANDLE.
     6736   ASSIGN
     6737          v-calories:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     6738   ASSIGN
     6739          v-carbohydrate:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     6740   ASSIGN
     6741          v-fat:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     6742   ASSIGN
     6743          v-protein:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     6744   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     6745   DO:
     6746       APPLY "END-ERROR":U TO SELF.
     6747   END.
     6748   ON CHOOSE OF b-additional IN FRAME Dialog-Frame
     6749   DO:
     6750   define variable vss-include-info44 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6751   if lookup(self :type
     6752            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     6753            ) = 0
     6754   then do:
     6755     message
     6756       "$Workfile$"
     6757       "Указанному интерфейсному элементу фокус не может быть передан" skip
     6758       "Интерфейсный элемент" self :name  skip
     6759       "Тип" self :type  skip
     6760       "Процедура" this-procedure :file-name skip
     6761       view-as alert-box .
     6762   end.
     6763   else do:
     6764     apply "entry":u to self  .
     6765     if focus :handle <> self :handle  then do:
     6766       return no-apply .
     6767     end.
     6768   end.
     6769       define variable v-cancel    as logical        no-undo.
     6770       define variable v-quality   as character      no-undo.
     6771       define variable v-design    as character      no-undo.
     6772       define variable v-mode      as character      no-undo.
     6773       if p-mode = 'ДОБАВЛЕНИЕ':U
     6774       or p-mode = 'ИЗМЕНЕНИЕ':U
     6775       then do:
     6776           assign
     6777               v-mode = 'ИЗМЕНЕНИЕ':U
     6778           .
     6779       end.
     6780       else do:
     6781           assign
     6782               v-mode = p-mode
     6783           .
     6784       end.
     6785       run ref/recipd.w (
     6786             input v-mode
     6787           , input buf_init_recipe.recipe-code
     6788           , input p-store-type
     6789           , input p-store-code
     6790           , input buf_init_recipe.recipe-quality
     6791           , input buf_init_recipe.recipe-design
     6792           , output v-quality
     6793           , output v-design
     6794       ) no-error.
     6795       if error-status :error
     6796       then do:
     6797           message
     6798               "Не удалось присвоить значения дополнительным параметрам рецепта."
     6799               skip return-value
     6800               skip trim(error-status :get-message(1))
     6801                    trim(error-status :get-message(2))
     6802                    trim(error-status :get-message(3))
     6803           view-as alert-box error.
     6804           undo, return no-apply.
     6805       end.
     6806       if buf_init_recipe.recipe-quality <> v-quality
     6807       then do:
     6808           assign
     6809               buf_init_recipe.recipe-quality = v-quality
     6810           .
     6811       end.
     6812       if buf_init_recipe.recipe-design  <> v-design
     6813       then do:
     6814           assign
     6815               buf_init_recipe.recipe-design  = v-design
     6816           .
     6817       end.
     6818   END.
     6819   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
     6820   DO:
     6821   define variable vss-include-info45 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6822   if lookup(self :type
     6823            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     6824            ) = 0
     6825   then do:
     6826     message
     6827       "$Workfile$"
     6828       "Указанному интерфейсному элементу фокус не может быть передан" skip
     6829       "Интерфейсный элемент" self :name  skip
     6830       "Тип" self :type  skip
     6831       "Процедура" this-procedure :file-name skip
     6832       view-as alert-box .
     6833   end.
     6834   else do:
     6835     apply "entry":u to self  .
     6836     if focus :handle <> self :handle  then do:
     6837       return no-apply .
     6838     end.
     6839   end.
     6840       if p-mode = 'ДОБАВЛЕНИЕ':U
     6841       then do:
     6842           assign
     6843               p-out-recipe-code = ""
     6844           .
     6845           if available buf_init_recipe
     6846           then do:
     6847               do transaction
     6848               :
     6849                   delete buf_init_recipe.
     6850               end.
     6851           end.
     6852       end.
     6853   END.
     6854   ON CHOOSE OF b-change IN FRAME Dialog-Frame
     6855   DO:
     6856       define variable v-new-qnty          as decimal        no-undo.
     6857       define variable v-new-coeff-waste   as decimal        no-undo.
     6858       define variable v-new-brutto-qnty   as decimal        no-undo.
     6859       define variable v-new-calc-method   as integer      no-undo.
     6860       define variable v-is-waste          as logical        no-undo.
     6861       define variable v-success           as logical        no-undo.
     6862       define variable v-goods-name        as character      no-undo.
     6863       define variable v-units             as character      no-undo.
     6864       define variable v-gds-code          as integer        no-undo.
     6865       define variable v-comp-gds-code     as integer        no-undo.
     6866       define variable v-date-on-object    as date           no-undo.
     6867       define buffer buf_units         for units.
     6868       define buffer buf_goods         for goods.
     6869       define buffer buf_comp_goods    for goods.
     6870       if available recipe-gds
     6871       then do:
     6872   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6873   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     6874     (input  recipe-gds.artic
     6875     ,input  recipe-gds.prod-type
     6876     ,input  recipe-gds.prod-code
     6877     ,output v-goods-name
     6878     )  .
     6879   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6880   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     6881     (input  recipe-gds.artic
     6882     ,input  recipe-gds.prod-type
     6883     ,input  recipe-gds.prod-code
     6884     ,output v-gds-code
     6885     )  .
     6886   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6887   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     6888     (input  v-gds-code
     6889     ,output v-units
     6890     )  .
     6891           find first buf_units no-lock
     6892                where buf_units.unit-name = v-units
     6893           .
     6894           run ref/recipln.w (
     6895                 input 'спр-к_рецептов':U
     6896               , input p-recipe-type
     6897               , input recipe-gds.recipe-code + " " + fi-recipe-name
     6898               , input recipe-gds.artic + " " + v-goods-name
     6899               , input lookup( 'шту':U, buf_units.type ) > 0
     6900               , input recipe-gds.is-waste
     6901               , input recipe-gds.qnty
     6902               , input get-season-procent ( buffer recipe-gds )
     6903               , input recipe-gds.coeff-waste
     6904               , input recipe-gds.brutto-qnty
     6905               , input recipe-gds.calc-method
     6906               , output v-is-waste
     6907               , output v-new-qnty
     6908               , output v-new-coeff-waste
     6909               , output v-new-brutto-qnty
     6910               , output v-new-calc-method
     6911               , output v-success
     6912           ).
     6913           if v-success = yes
     6914           then do:
     6915               do transaction
     6916               on error undo, return no-apply
     6917               :
     6918                   find current recipe-gds exclusive-lock .
     6919                   assign
     6920                       recipe-gds.qnty         = v-new-qnty
     6921                       recipe-gds.is-waste     = v-is-waste
     6922                       recipe-gds.coeff-waste  = v-new-coeff-waste
     6923                       recipe-gds.brutto-qnty  = v-new-brutto-qnty
     6924                       recipe-gds.calc-method  = v-new-calc-method
     6925                       recipe-gds.nws-self     = yes
     6926                   .
     6927               end.
     6928               br-table :refresh().
     6929               run calc-and-display-nutrition-info in this-procedure .
     6930           end.
     6931       end.
     6932   END.
     6933   ON CHOOSE OF b-close IN FRAME Dialog-Frame
     6934   DO:
     6935   define variable vss-include-info49 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6936   if lookup(self :type
     6937            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     6938            ) = 0
     6939   then do:
     6940     message
     6941       "$Workfile$"
     6942       "Указанному интерфейсному элементу фокус не может быть передан" skip
     6943       "Интерфейсный элемент" self :name  skip
     6944       "Тип" self :type  skip
     6945       "Процедура" this-procedure :file-name skip
     6946       view-as alert-box .
     6947   end.
     6948   else do:
     6949     apply "entry":u to self  .
     6950     if focus :handle <> self :handle  then do:
     6951       return no-apply .
     6952     end.
     6953   end.
     6954       define variable v-bad-data      as logical        no-undo.
     6955       define variable v-error-text    as character      no-undo.
     6956       define variable v-allow-global  as logical        no-undo.
     6957       if p-mode <> 'ИЗМЕНЕНИЕ':U
     6958       and p-mode <> 'ДОБАВЛЕНИЕ':U
     6959       then do:
     6960           apply "go" to frame Dialog-Frame .
     6961           return.
     6962       end.
     6963       if input frame Dialog-Frame tb-global = yes
     6964       and not( buf_init_recipe.host-code = 0
     6965               and buf_init_recipe.obj-type  = ""
     6966               and buf_init_recipe.obj-code  = 0 )
     6967       then do:
     6968           message
     6969               "После изменений рецепт станет глобальным."
     6970               skip "Сделать рецепт локальным будет невозможно."
     6971               skip "Редактировать или удалить его можно будет"
     6972               skip "только в главной базе данных."
     6973               skip(1)
     6974               skip "Внести изменения в рецепт?"
     6975           view-as alert-box question
     6976           buttons yes-no
     6977           title "Изменение рецепта"
     6978           update v-allow-global.
     6979           if v-allow-global = yes
     6980           then do:
     6981               assign
     6982                   buf_init_recipe.host-code = 0
     6983                   buf_init_recipe.obj-type  = ""
     6984                   buf_init_recipe.obj-code  = 0
     6985               .
     6986           end.
     6987           else do:
     6988               undo, return no-apply.
     6989           end.
     6990       end.
     6991       assign
     6992           tb-global
     6993           fi-recipe-name
     6994           fi-recipe-qnty
     6995           fi-portion-qnty
     6996           fi-portion-weight
     6997           fi-recipe-ref-num
     6998           ed-recipe-technique
     6999           v-fat
     7000           v-carbohydrate
     7001           v-calories
     7002           v-protein
     7003       .
     7004       RUN attr-save IN THIS-PROCEDURE.
     7005       run check-recipe in this-procedure (
     7006               input buf_init_recipe.recipe-code
     7007             , input fi-recipe-name
     7008             , input fi-recipe-qnty
     7009             , input fi-portion-qnty
     7010             , input fi-portion-weight
     7011             , input fi-recipe-ref-num
     7012             , input ed-recipe-technique
     7013             , output v-bad-data
     7014             , output v-error-text
     7015       ) no-error.
     7016       if error-status :error
     7017       then do:
     7018           message
     7019                    vss-workfile vss-revision vss-description
     7020               skip "Ошибка при проверке рецепта."
     7021               skip return-value
     7022               skip trim(error-status :get-message(1))
     7023                    trim(error-status :get-message(2))
     7024                    trim(error-status :get-message(3))
     7025           view-as alert-box error.
     7026           undo, return no-apply .
     7027       end.
     7028       if v-bad-data = yes
     7029       then do:
     7030           message
     7031               "Ошибка введенных данных рецепта."
     7032               skip v-error-text
     7033               skip(1)
     7034               "Исправьте данные или отмените ввод рецепта."
     7035           view-as alert-box error.
     7036           undo, return no-apply .
     7037       end.
     7038       assign
     7039           p-out-recipe-code                   = buf_init_recipe.recipe-code
     7040           buf_init_recipe.recipe-name         = fi-recipe-name
     7041           buf_init_recipe.qnty                = fi-recipe-qnty
     7042           buf_init_recipe.portion-qnty        = fi-portion-qnty
     7043           buf_init_recipe.portion-weight      = fi-portion-weight
     7044           buf_init_recipe.recipe-ref-num      = fi-recipe-ref-num
     7045           buf_init_recipe.recipe-technique    = ed-recipe-technique
     7046       .
     7047       apply "GO" TO FRAME Dialog-Frame .
     7048   END.
     7049   ON CHOOSE OF b-down IN FRAME Dialog-Frame
     7050   DO:
     7051   define variable vss-include-info50 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7052   if lookup(self :type
     7053            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     7054            ) = 0
     7055   then do:
     7056     message
     7057       "$Workfile$"
     7058       "Указанному интерфейсному элементу фокус не может быть передан" skip
     7059       "Интерфейсный элемент" self :name  skip
     7060       "Тип" self :type  skip
     7061       "Процедура" this-procedure :file-name skip
     7062       view-as alert-box .
     7063   end.
     7064   else do:
     7065     apply "entry":u to self  .
     7066     if focus :handle <> self :handle  then do:
     7067       return no-apply .
     7068     end.
     7069   end.
     7070       define variable v-cur-line          as recid          no-undo.
     7071       define variable v-proc-number       as integer        no-undo.
     7072       define variable v-old-proc-number   as integer        no-undo.
     7073       define variable v-focused-row       as integer        no-undo.
     7074       if not available recipe-gds
     7075       then do:
     7076           return no-apply.
     7077       end.
     7078       apply "entry" to br-table .
     7079       assign
     7080           v-focused-row   = br-table :focused-row in frame Dialog-Frame
     7081           v-cur-line      = recid( recipe-gds )
     7082           v-proc-number   = recipe-gds.proc-number
     7083       .
     7084       get next br-table.
     7085       if not available recipe-gds
     7086       then do:
     7087           apply "entry" to br-table.
     7088           return no-apply.
     7089       end.
     7090   if session :set-wait-state( "compiler" ) then.
     7091       swap-down:
     7092       do transaction
     7093       on error undo swap-down, return no-apply
     7094       :
     7095           find current recipe-gds exclusive-lock .
     7096           assign
     7097               v-old-proc-number       = recipe-gds.proc-number
     7098               recipe-gds.proc-number  = v-proc-number
     7099               recipe-gds.nws-self     = yes
     7100           .
     7101           find first recipe-gds exclusive-lock
     7102                where recid( recipe-gds ) = v-cur-line
     7103           .
     7104           assign
     7105               v-focused-row           = v-focused-row + 1
     7106               recipe-gds.proc-number  = v-old-proc-number
     7107               recipe-gds.nws-self     = yes
     7108           .
     7109       end.
     7110       OPEN QUERY br-table FOR EACH ub.recipe-gds       WHERE recipe-gds.recipe-code = buf_init_recipe.recipe-code NO-LOCK     BY ub.recipe-gds.proc-number.
     7111       br-table :set-repositioned-row( v-focused-row, "ALWAYS") in frame Dialog-Frame.
     7112       reposition br-table to recid v-cur-line .
     7113       apply "entry" to browse br-table.
     7114   if session :set-wait-state( "" ) then.
     7115   END.
