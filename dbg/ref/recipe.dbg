     6218     end case.
     6219     assign
     6220       p-nutro-value = v-nutro-value
     6221     .
     6222   end.
     6223   end procedure.
     6224   procedure fbrnutro_proc-get-recipe-nutrition-by-code :
     6225     define input  parameter p-recipe-code as character no-undo .
     6226     define input  parameter p-artic       as character no-undo .
     6227     define input  parameter p-prod-type   as character no-undo .
     6228     define input  parameter p-prod-code   as integer   no-undo .
     6229     define input  parameter p-attr-code   as character no-undo .
     6230     define input  parameter p-recipe-qnty as decimal   no-undo .
     6231     define output parameter p-nutro-value as decimal   no-undo .
     6232     define buffer buf_goods          for ub.goods      .
     6233     define buffer buf_units          for ub.units.
     6234     define buffer buf_recipe-gds     for ub.recipe-gds .
     6235     define buffer buf_recipe         for ub.recipe     .
     6236     define variable v-attr-value        as character no-undo .
     6237     define variable v-attr-type         as character no-undo .
     6238     define variable v-nutro-ingr        as decimal   no-undo .
     6239     define variable v-nutro             as decimal   no-undo .
     6240     define variable v-is-global         as logical   no-undo .
     6241     define variable v-line-weight       as decimal   no-undo .
     6242     define variable v-tot-weight        as decimal   no-undo .
     6243     define variable v-recipe-have-lines as logical   no-undo .
     6244   do
     6245   on error undo, return error return-value
     6246   :
     6247     assign
     6248       p-nutro-value = ?
     6249     .
     6250     if p-recipe-qnty = ? or
     6251        p-recipe-qnty = 0
     6252     then do:
     6253       return .
     6254     end.
     6255     if  p-recipe-code <> "":u
     6256     and p-recipe-code <> ?
     6257     then do:
     6258       find first buf_recipe no-lock
     6259           where buf_recipe.recipe-code = p-recipe-code
     6260             and buf_recipe.artic      = p-artic
     6261             and buf_recipe.prod-type  = p-prod-type
     6262             and buf_recipe.prod-code  = p-prod-code
     6263       no-error .
     6264       if available buf_recipe
     6265       then do:
     6266         _recipe-gds-cycle:
     6267         for each buf_recipe-gds no-lock
     6268           where buf_recipe-gds.recipe-code = p-recipe-code
     6269         , first buf_goods no-lock
     6270             where buf_goods.gds-code = buf_recipe-gds.gds-code
     6271         , first buf_units no-lock
     6272             where buf_units.unit-name = buf_goods.unit-base
     6273         :
     6274             assign
     6275               v-recipe-have-lines = yes
     6276               v-nutro-ingr = fbrnutro_get-gds-recipe-nutrition-by-code ( input p-recipe-code
     6277                                                                        , input buf_recipe-gds.artic
     6278                                                                        , input buf_recipe-gds.prod-type
     6279                                                                        , input buf_recipe-gds.prod-code
     6280                                                                        , input p-attr-code
     6281                                                                        )
     6282             .
     6283             if v-nutro-ingr = ?
     6284             then do:
     6285               return .
     6286             end.
     6287             if lookup('вес':U, buf_units.type) > 0
     6288             then do:
     6289               assign
     6290                 v-line-weight = buf_recipe-gds.qnty
     6291               .
     6292             end.
     6293             else do:
     6294               assign
     6295                 v-line-weight = buf_recipe-gds.qnty * buf_goods.wt-base
     6296               .
     6297             end.
     6298             assign
     6299               v-nutro       = v-nutro + ( v-nutro-ingr * v-line-weight )
     6300               v-tot-weight  = v-tot-weight + v-line-weight
     6301             .
     6302         end.
     6303         assign
     6304           v-nutro = v-nutro / ( p-recipe-qnty )
     6305         .
     6306       end.
     6307       else do:
     6308         return .
     6309       end.
     6310     end.
     6311     else do:
     6312       return .
     6313     end.
     6314     if v-recipe-have-lines = yes and
     6315        v-tot-weight <> 0
     6316     then do:
     6317       assign
     6318         p-nutro-value = v-nutro
     6319       .
     6320     end.
     6321   end.
     6322   end procedure.
     6323   procedure fbrnutro_proc-save-nutrition :
     6324     define input  parameter p-recipe-code   as character no-undo .
     6325     define input  parameter p-artic         as character no-undo .
     6326     define input  parameter p-prod-type     as character no-undo .
     6327     define input  parameter p-prod-code     as integer   no-undo .
     6328     define input  parameter p-calories      as decimal   no-undo .
     6329     define input  parameter p-protein       as decimal   no-undo .
     6330     define input  parameter p-carbohydrate  as decimal   no-undo .
     6331     define input  parameter p-fat           as decimal   no-undo .
     6332     define buffer buf_recipe    for ub.recipe.
     6333     define buffer buf_goods     for ub.goods.
     6334     define variable v-is-global as logical   no-undo .
     6335     define variable v-attr-code as character no-undo .
     6336   do
     6337   on error undo, return error return-value
     6338   :
     6339     find first buf_recipe no-lock
     6340       where buf_recipe.recipe-code = p-recipe-code
     6341     no-error .
     6342     if not available buf_recipe
     6343     then do:
     6344       return error substitute( "Не найден рецепт с кодом &1" , p-recipe-code ).
     6345     end.
     6346     find first buf_goods no-lock
     6347       where buf_goods.artic     = p-artic
     6348         and buf_goods.prod-type = p-prod-type
     6349         and buf_goods.prod-code = p-prod-code
     6350     no-error .
     6351     if not available buf_goods
     6352     then do:
     6353       return error substitute( "Не найден товар &1 &2 &3"
     6354                              , p-artic
     6355                              , p-prod-type
     6356                              , p-prod-code
     6357                              ).
     6358     end.
     6359     assign
     6360       v-is-global = fbrnutro_is-global-recipe(p-recipe-code)
     6361     .
     6362     if v-is-global
     6363     then do:
     6364       assign
     6365         v-attr-code = 'carbohydrate':U
     6366       .
     6367       run gds-attr-write in this-procedure ( input buf_goods.gds-code
     6368                                            , input v-attr-code
     6369                                            , input p-carbohydrate
     6370                                            ) no-error .
     6371       if error-status :error = yes                 then do:                   return error substitute( "Ошибка при сохранении атрибута &1&2&3&2&4&2&5"                                          , v-attr-code                                          , chr(10)                                          , return-value                                          , error-status :get-message(1)                                          , error-status :get-message(2)                                          ) .                 end.
     6372       assign
     6373         v-attr-code = 'fat':U
     6374       .
     6375       run gds-attr-write in this-procedure ( input buf_goods.gds-code
     6376                                            , input v-attr-code
     6377                                            , input p-fat
     6378                                            ) no-error .
     6379       if error-status :error = yes                 then do:                   return error substitute( "Ошибка при сохранении атрибута &1&2&3&2&4&2&5"                                          , v-attr-code                                          , chr(10)                                          , return-value                                          , error-status :get-message(1)                                          , error-status :get-message(2)                                          ) .                 end.
     6380       assign
     6381         v-attr-code = 'protein':U
     6382       .
     6383       run gds-attr-write in this-procedure ( input buf_goods.gds-code
     6384                                            , input v-attr-code
     6385                                            , input p-protein
     6386                                            ) no-error .
     6387       if error-status :error = yes                 then do:                   return error substitute( "Ошибка при сохранении атрибута &1&2&3&2&4&2&5"                                          , v-attr-code                                          , chr(10)                                          , return-value                                          , error-status :get-message(1)                                          , error-status :get-message(2)                                          ) .                 end.
     6388       assign
     6389         v-attr-code = 'calories':U
     6390       .
     6391       run gds-attr-write in this-procedure ( input buf_goods.gds-code
     6392                                            , input v-attr-code
     6393                                            , input p-calories
     6394                                            ) no-error .
     6395       if error-status :error = yes                 then do:                   return error substitute( "Ошибка при сохранении атрибута &1&2&3&2&4&2&5"                                          , v-attr-code                                          , chr(10)                                          , return-value                                          , error-status :get-message(1)                                          , error-status :get-message(2)                                          ) .                 end.
     6396     end.
     6397     else do:
     6398       assign
     6399         v-attr-code = 'carbohydrate-o':U
     6400       .
     6401       run gdsoattr-write in this-procedure ( input buf_goods.gds-code
     6402                                            , input v-cntxt-obj-type
     6403                                            , input v-cntxt-obj-code
     6404                                            , input v-attr-code
     6405                                            , input p-carbohydrate
     6406                                            ) no-error .
     6407       if error-status :error = yes                 then do:                   return error substitute( "Ошибка при сохранении атрибута &1&2&3&2&4&2&5"                                          , v-attr-code                                          , chr(10)                                          , return-value                                          , error-status :get-message(1)                                          , error-status :get-message(2)                                          ) .                 end.
     6408       assign
     6409         v-attr-code = 'fat-o':U
     6410       .
     6411       run gdsoattr-write in this-procedure ( input buf_goods.gds-code
     6412                                            , input v-cntxt-obj-type
     6413                                            , input v-cntxt-obj-code
     6414                                            , input v-attr-code
     6415                                            , input p-fat
     6416                                            ) no-error .
     6417       if error-status :error = yes                 then do:                   return error substitute( "Ошибка при сохранении атрибута &1&2&3&2&4&2&5"                                          , v-attr-code                                          , chr(10)                                          , return-value                                          , error-status :get-message(1)                                          , error-status :get-message(2)                                          ) .                 end.
     6418       assign
     6419         v-attr-code = 'protein-o':U
     6420       .
     6421       run gdsoattr-write in this-procedure ( input buf_goods.gds-code
     6422                                            , input v-cntxt-obj-type
     6423                                            , input v-cntxt-obj-code
     6424                                            , input v-attr-code
     6425                                            , input p-protein
     6426                                            ) no-error .
     6427       if error-status :error = yes                 then do:                   return error substitute( "Ошибка при сохранении атрибута &1&2&3&2&4&2&5"                                          , v-attr-code                                          , chr(10)                                          , return-value                                          , error-status :get-message(1)                                          , error-status :get-message(2)                                          ) .                 end.
     6428       assign
     6429         v-attr-code = 'calories-o':U
     6430       .
     6431       run gdsoattr-write in this-procedure ( input buf_goods.gds-code
     6432                                            , input v-cntxt-obj-type
     6433                                            , input v-cntxt-obj-code
     6434                                            , input v-attr-code
     6435                                            , input p-calories
     6436                                            ) no-error .
     6437       if error-status :error = yes                 then do:                   return error substitute( "Ошибка при сохранении атрибута &1&2&3&2&4&2&5"                                          , v-attr-code                                          , chr(10)                                          , return-value                                          , error-status :get-message(1)                                          , error-status :get-message(2)                                          ) .                 end.
     6438     end.
     6439   end.
     6440   end procedure.
     6441   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6442   FUNCTION check-ban-sales-via-cd return logical ( input p-gds-code as integer ) :
     6443       define variable v-upper-code as int no-undo.
     6444       define variable v-value as character no-undo.
     6445       define variable v-type as character no-undo.
     6446       define buffer lc_gds-grp for ub.gds-grp.
     6447       define buffer lc_goods for ub.goods.
     6448      if p-gds-code <> 0 then do:
     6449       find first lc_goods where lc_goods.gds-code = p-gds-code.
     6450       v-upper-code = lc_goods.grp-code.
     6451       do while v-upper-code > 0 :
     6452           find first lc_gds-grp where lc_gds-grp.node-code = v-upper-code.
     6453           run ggoattr-value(
     6454             input lc_gds-grp.node-code,
     6455             input 0,
     6456             input "",
     6457             input 0,
     6458             input 'ban-sales-via-cd':U,
     6459             output v-value,
     6460             output v-type
     6461           ).
     6462          if v-value = "yes" then
     6463             return true.
     6464          else
     6465          do:
     6466             run ggoattr-value(
     6467                input lc_gds-grp.node-code,
     6468                input v-cntxt-host-code-obj,
     6469                input "",
     6470                input 0,
     6471                input 'ban-sales-via-cd':U,
     6472                output v-value,
     6473                output v-type
     6474                ).
     6475             if v-value = "yes" then
     6476                return true.
     6477             else
     6478             do:
     6479                run ggoattr-value(
     6480                   input lc_gds-grp.node-code,
     6481                   input v-cntxt-host-code-obj,
     6482                   input v-cntxt-obj-type,
     6483                   input v-cntxt-obj-code,
     6484                   input 'ban-sales-via-cd':U,
     6485                   output v-value,
     6486                   output v-type
     6487                   ).
     6488                if v-value = "yes" then
     6489                   return true.
     6490                else v-upper-code = lc_gds-grp.upper-code.
     6491             end .
     6492          end.
     6493         end.
     6494       end.
     6495       if v-value = "" or logical(v-value) = false then return false .
     6496   end.
     6497   FUNCTION check-ban-sales-via-cd-grp return logical ( input p-grp-code as integer ) :
     6498       define variable v-upper-code as int no-undo.
     6499       define variable v-value as character no-undo.
     6500       define variable v-type as character no-undo.
     6501       define buffer lc_gds-grp for ub.gds-grp.
     6502       define buffer lc_goods for ub.goods.
     6503       v-upper-code = p-grp-code.
     6504       do while v-upper-code > 0 :
     6505           find first lc_gds-grp where lc_gds-grp.node-code = v-upper-code.
     6506           run ggoattr-value(
     6507             input lc_gds-grp.node-code,
     6508             input 0,
     6509             input "",
     6510             input 0,
     6511             input 'ban-sales-via-cd':U,
     6512             output v-value,
     6513             output v-type
     6514           ).
     6515          if v-value = "yes" then
     6516             return true.
     6517          else
     6518          do:
     6519             run ggoattr-value(
     6520                input lc_gds-grp.node-code,
     6521                input v-cntxt-host-code-obj,
     6522                input "",
     6523                input 0,
     6524                input 'ban-sales-via-cd':U,
     6525                output v-value,
     6526                output v-type
     6527                ).
     6528             if v-value = "yes" then
     6529                return true.
     6530             else
     6531             do:
     6532                run ggoattr-value(
     6533                   input lc_gds-grp.node-code,
     6534                   input v-cntxt-host-code-obj,
     6535                   input v-cntxt-obj-type,
     6536                   input v-cntxt-obj-code,
     6537                   input 'ban-sales-via-cd':U,
     6538                   output v-value,
     6539                   output v-type
     6540                   ).
     6541                if v-value = "yes" then
     6542                   return true.
     6543                else v-upper-code = lc_gds-grp.upper-code.
     6544             end .
     6545          end.
     6546         end.
     6547   end.
