     7434   define variable vss-include-info56 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7435   on help of frame Dialog-Frame
     7436   do:
     7437     run gbl/app_help.p
     7438       (input this-procedure :file-name
     7439       ,input ''
     7440       ,input ?
     7441       ) no-error.
     7442     if error-status :error then do:
     7443       message
     7444         "Ошибка при вызове помощи"
     7445         error-status :get-message(1)
     7446         view-as alert-box .
     7447     end.
     7448   end.
     7449   run minbtn-set in this-procedure .
     7450   on choose of b-help in frame Dialog-Frame
     7451   do:
     7452     apply "help":u to frame Dialog-Frame .
     7453   end.
     7454   define variable vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7455   procedure minbtn-set :
     7456       do
     7457           on error undo, return error return-value
     7458           :
     7459           define variable ii              as integer       no-undo .
     7460           define variable fh              as widget-handle no-undo .
     7461           define variable hh              as widget-handle no-undo .
     7462           define variable v-h             as handle        extent 4 no-undo .
     7463           define variable v-name-button   as character     no-undo .
     7464           define variable v-help-old-x    as decimal       no-undo .
     7465           define variable v-help-old-y    as decimal       no-undo .
     7466           define variable v-help-old-size as decimal       no-undo .
     7467           define variable v-frame-width   as decimal       no-undo .
     7468           define variable jj              as integer       no-undo .
     7469           do
     7470               on error undo, return error
     7471               :
     7472               assign
     7473                   v-frame-width = frame Dialog-Frame:width - 0.3
     7474                   fh            = frame Dialog-Frame:first-child
     7475                   hh            = fh:first-child
     7476                   ii            = 1
     7477                   .
     7478               do while valid-handle(hh):
     7479                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     7480                   do:
     7481                       case lc(hh:name) :
     7482                           when "b-help" then
     7483                               do:
     7484                                   hh:load-image-up("cmp/b-help.bmp":u) .
     7485                                   hh:load-image-down("cmp/b-help.bmp":u) .
     7486                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     7487                                   hh:TOOLTIP = "Помощь" .
     7488                                   v-help-old-x = hh:column .
     7489                                   v-help-old-y = hh:row    .
     7490                                   v-help-old-size = hh:width .
     7491                                   hh:width-chars = 2.5 .
     7492                               end.
     7493                           when "b-print" then
     7494                               do:
     7495                                   hh:load-image("cmp/b-print.bmp":u) .
     7496                                   hh:TOOLTIP = "Печать" .
     7497                                   v-h[ii] = hh:handle .
     7498                                   ii = ii + 1 .
     7499                                   hh:width-chars = 3 .
     7500                               end.
     7501                           when "b-history" or
     7502                           when "b-hist" then
     7503                               do:
     7504                                   hh:load-image("cmp/b-hist.bmp":u) .
     7505                                   hh:TOOLTIP = "История" .
     7506                                   v-h[ii] = hh:handle .
     7507                                   ii = ii + 1 .
     7508                                   hh:width-chars = 3 .
     7509                               end.
     7510                           when "b-sch" then
     7511                               do:
     7512                                   hh:load-image("cmp/b-sch.bmp":u) .
     7513                                   hh:TOOLTIP = "Установка Фильтра" .
     7514                                   v-h[ii] = hh:handle .
     7515                                   ii = ii + 1 .
     7516                                   hh:width-chars = 3 .
     7517                               end.
     7518                           when "b-hist-user" then
     7519                               do:
     7520                                   hh:load-image("cmp/b-hist.bmp":u) .
     7521                                   hh:TOOLTIP = "История пользователя" .
     7522                                   ii = ii + 1 .
     7523                               end.
     7524                       end case.
     7525                   end.
     7526                   hh = hh:next-sibling.
     7527               end.
     7528               b-help:column = v-frame-width - b-help:width-chars.
     7529               jj = 0.
     7530               repeat ii = 4 to 1 by -1 :
     7531                   if valid-handle (v-h[ii] ) then
     7532                   do:
     7533                       jj  = jj + 1 .
     7534                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     7535                       v-h[ii]:row    = v-help-old-y .
     7536                   end.
     7537               end.
     7538           end.
     7539       end.
     7540   end procedure.
     7541   define variable vss-include-info58 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     7542   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     7543   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     7544   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     7545   define variable v-diasize-current-frame-width  as decimal   no-undo .
     7546   define variable v-diasize-current-frame-height as decimal   no-undo .
     7547   define variable v-diasize-change-size          as logical   no-undo .
     7548   define variable v-diasize-resize-button        as handle    no-undo .
     7549   define variable v-diasize-wndmax               as logical   no-undo .
     7550   define variable v-diasize-wndstore             as logical   no-undo .
     7551   define variable v-diasize-proc-name            as character no-undo .
     7552   define variable v-diasize-browse-handle        as handle    no-undo .
     7553   define variable v-diasize-browse-number        as integer   no-undo .
     7554   define variable v-diasize-need-full-display    as logical   no-undo init false .
     7555   define temp-table temp-diasize-handle no-undo
     7556     field handle-value  as handle
     7557     field save-position as decimal
     7558     index xpk is primary unique handle-value
     7559     .
     7560   define temp-table temp-browse-handle no-undo
     7561     field browse-type   as character
     7562     field browse-number as integer
     7563     field browse-handle as handle
     7564     field original-size as decimal
     7565     index xpk is primary unique browse-type browse-number
     7566     index xie browse-type browse-handle
     7567   .
     7568   procedure diasize_change-height :
     7569     define input  parameter p-change-value  as decimal   no-undo .
     7570     define input  parameter p-move-resize   as logical   no-undo .
     7571     define variable v-field-group-handle    as handle    no-undo .
     7572     define variable v-object-handle         as handle    no-undo .
     7573     define variable v-frame-height          as decimal   no-undo .
     7574     define variable v-frame-virtual-height  as decimal   no-undo .
     7575     define variable v-browse-height         as decimal   no-undo .
     7576     define variable v-window-height         as decimal   no-undo .
     7577     define variable v-window-virtual-height as decimal   no-undo .
     7578     define variable v-change-sign           as integer   no-undo .
     7579     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     7580     define buffer buf_temp-browse-handle  for temp-browse-handle .
     7581     if p-change-value > 0
     7582     then do:
     7583       if frame Dialog-Frame :height + p-change-value
     7584           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     7585       then do:
     7586         assign
     7587           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     7588                           - (frame Dialog-Frame :height-chars)
     7589         .
     7590         if p-change-value <= 0
     7591         then do:
     7592           run diasize_position-resize-button in this-procedure .
     7593           return .
     7594         end.
     7595       end.
     7596     end.
     7597     if p-change-value < 0
     7598     then do:
     7599       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     7600       then do:
     7601         assign
     7602           p-change-value = v-diasize-orig-frame-height
     7603                          - (frame Dialog-Frame :height-chars)
     7604         .
     7605         if p-change-value >= 0
     7606         then do:
     7607           run diasize_position-resize-button in this-procedure .
     7608           return .
     7609         end.
     7610       end.
     7611     end.
     7612     if p-change-value >= 0
     7613     then do:
     7614       assign
     7615         v-change-sign = 1
     7616       .
     7617     end.
     7618     else do:
     7619       assign
     7620         v-change-sign = -1
     7621       .
     7622     end.
     7623     assign
     7624       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     7625     .
     7626     if p-change-value = 0
     7627     then do:
     7628       run diasize_position-resize-button in this-procedure .
     7629       return .
     7630     end.
     7631     move_block:
     7632     do
     7633     on error undo move_block, retry move_block
     7634     :
     7635       if retry
     7636       then do:
     7637         do
     7638         on error undo move_block, leave move_block
     7639         :
     7640           if p-change-value > 0
     7641           then do:
     7642             for each buf_temp-diasize-handle
     7643             on error undo, next
     7644             :
     7645               assign
     7646                 v-object-handle = buf_temp-diasize-handle.handle-value
     7647               .
     7648               if v-object-handle <> v-diasize-resize-button
     7649               then do:
     7650                 assign
     7651                   v-object-handle :row = buf_temp-diasize-handle.save-position
     7652                 .
     7653               end.
     7654             end.
     7655             assign
     7656               v-diasize-browse-handle :height = v-browse-height
     7657             .
     7658             for each buf_temp-browse-handle
     7659               where buf_temp-browse-handle.browse-type = 'height':u
     7660             on error undo, next
     7661             :
     7662               assign
     7663                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     7664               .
     7665             end.
     7666             assign
     7667               frame Dialog-Frame :height = v-frame-height
     7668             .
     7669             if frame Dialog-Frame :scrollable = true
     7670             then do:
     7671               assign
     7672                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     7673               .
     7674             end.
     7675             run diasize_position-resize-button in this-procedure .
     7676           end.
     7677           else do:
     7678             if frame Dialog-Frame :scrollable = true
     7679             then do:
     7680               assign
     7681                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     7682               .
     7683             end.
     7684             assign
     7685               frame Dialog-Frame :height = v-frame-height
     7686             .
     7687             assign
     7688               v-diasize-browse-handle :height = v-browse-height
     7689             .
     7690             for each buf_temp-browse-handle
     7691               where buf_temp-browse-handle.browse-type = 'height':u
     7692             on error undo, next
     7693             :
     7694               assign
     7695                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     7696               .
     7697             end.
     7698             for each buf_temp-diasize-handle
     7699             on error undo, next
     7700             :
     7701               assign
     7702                 v-object-handle = buf_temp-diasize-handle.handle-value
     7703               .
     7704               if v-object-handle <> v-diasize-resize-button
     7705               then do:
     7706                 assign
     7707                   v-object-handle :row = buf_temp-diasize-handle.save-position
     7708                 .
     7709               end.
     7710             end.
     7711             run diasize_position-resize-button in this-procedure .
     7712           end.
     7713           assign
     7714             v-diasize-change-size = false
     7715           .
     7716           leave move_block .
     7717         end.
     7718       end.
     7719       assign
     7720         v-diasize-need-full-display = true
     7721       .
     7722       if v-diasize-change-size = false
     7723       then do:
     7724         assign
     7725           v-diasize-change-size = true
     7726         .
     7727       end.
     7728       else do:
     7729         return .
     7730       end.
     7731       assign
     7732         v-frame-height = frame Dialog-Frame :height
     7733         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     7734         v-browse-height = v-diasize-browse-handle :height
     7735       .
     7736       for each buf_temp-browse-handle
     7737         where buf_temp-browse-handle.browse-type = 'height':u
     7738       :
     7739         assign
     7740           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     7741         .
     7742       end.
     7743       for each buf_temp-diasize-handle
     7744       :
     7745         delete buf_temp-diasize-handle .
     7746       end.
     7747       assign
     7748         v-field-group-handle = frame Dialog-Frame :first-child
     7749       .
     7750       do while valid-handle(v-field-group-handle)
     7751       :
     7752         assign
     7753           v-object-handle = v-field-group-handle :first-child
     7754         .
     7755         do while valid-handle(v-object-handle)
     7756         :
     7757           if  v-object-handle <> v-diasize-browse-handle :handle
     7758           and can-query(v-object-handle, "row")
     7759           and can-query(v-object-handle, "height")
     7760           and ( v-object-handle :row > v-diasize-browse-handle :row )
     7761           then do:
     7762             find first buf_temp-browse-handle
     7763               where buf_temp-browse-handle.browse-type   = 'height':u
     7764                 and buf_temp-browse-handle.browse-handle = v-object-handle
     7765               no-error .
     7766             if available buf_temp-browse-handle
     7767             then do:
     7768             end.
     7769             else do:
     7770               create buf_temp-diasize-handle .
     7771               assign
     7772                 buf_temp-diasize-handle.handle-value  = v-object-handle
     7773                 buf_temp-diasize-handle.save-position = v-object-handle :row
     7774               .
     7775             end.
     7776           end.
     7777           assign
     7778             v-object-handle = v-object-handle :next-sibling
     7779           .
     7780         end.
     7781         assign
     7782           v-field-group-handle = v-field-group-handle :next-sibling
     7783         .
     7784       end.
     7785       do with frame Dialog-Frame
     7786       :
     7787         hide v-diasize-resize-button .
     7788         assign
     7789           v-diasize-resize-button :row    = 1
     7790           v-diasize-resize-button :column = 1
     7791         .
     7792       end.
     7793       if p-change-value > 0
     7794       then do:
     7795         if frame Dialog-Frame :scrollable = true
     7796         then do:
     7797           assign
     7798             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     7799             no-error .
     7800           if error-status :error
     7801           or error-status :get-message(1) <> ""
     7802           then do:
     7803             undo move_block, retry move_block .
     7804           end.
     7805         end.
     7806         assign
     7807           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     7808           no-error .
     7809         if error-status :error
     7810         or error-status :get-message(1) <> ""
     7811         then do:
     7812           undo move_block, retry move_block .
     7813         end.
     7814         assign
     7815           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     7816           no-error .
     7817         if error-status :error
     7818         or error-status :get-message(1) <> ""
     7819         then do:
     7820           undo move_block, retry move_block .
     7821         end.
     7822         for each buf_temp-browse-handle
     7823           where buf_temp-browse-handle.browse-type = 'height':u
     7824         on error undo move_block, retry move_block
     7825         :
     7826           assign
     7827             buf_temp-browse-handle.browse-handle :height
     7828               = buf_temp-browse-handle.browse-handle :height + p-change-value
     7829             no-error .
     7830           if error-status :error
     7831           or error-status :get-message(1) <> ""
     7832           then do:
     7833             undo move_block, retry move_block .
     7834           end.
     7835         end.
     7836         for each buf_temp-diasize-handle
     7837         on error undo move_block, retry move_block
     7838         :
     7839           assign
     7840             v-object-handle = buf_temp-diasize-handle.handle-value
     7841           .
     7842           if v-object-handle <> v-diasize-resize-button
     7843           then do:
     7844             assign
     7845               v-object-handle :row = v-object-handle :row + p-change-value
     7846               no-error .
     7847             if error-status :error
     7848             or error-status :get-message(1) <> ""
     7849             then do:
     7850               undo move_block, retry move_block .
     7851             end.
     7852           end.
     7853         end.
     7854       end.
     7855       else do:
     7856         for each buf_temp-diasize-handle
     7857         on error undo move_block, retry move_block
     7858         :
     7859           assign
     7860             v-object-handle = buf_temp-diasize-handle.handle-value
     7861           .
     7862           if v-object-handle <> v-diasize-resize-button
     7863           then do:
     7864             assign
     7865               v-object-handle :row = v-object-handle :row + p-change-value
     7866               no-error .
     7867             if error-status :error
     7868             or error-status :get-message(1) <> ""
     7869             then do:
     7870               undo move_block, retry move_block .
     7871             end.
     7872           end.
     7873         end.
     7874         assign
     7875           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     7876           no-error .
     7877         if error-status :error
     7878         or error-status :get-message(1) <> ""
     7879         then do:
     7880           undo move_block, retry move_block .
     7881         end.
     7882         for each buf_temp-browse-handle
     7883           where buf_temp-browse-handle.browse-type = 'height':u
     7884         on error undo move_block, retry move_block
     7885         :
     7886           assign
     7887             buf_temp-browse-handle.browse-handle :height
     7888               = buf_temp-browse-handle.browse-handle :height + p-change-value
     7889             no-error .
     7890           if error-status :error
     7891           or error-status :get-message(1) <> ""
     7892           then do:
     7893             undo move_block, retry move_block .
     7894           end.
     7895         end.
     7896         assign
     7897           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     7898           no-error .
     7899         if error-status :error
     7900         or error-status :get-message(1) <> ""
     7901         then do:
     7902           undo move_block, retry move_block .
     7903         end.
     7904         if frame Dialog-Frame :scrollable = true
     7905         then do:
     7906           assign
     7907             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     7908             no-error .
     7909           if error-status :error
     7910           or error-status :get-message(1) <> ""
     7911           then do:
     7912             undo move_block, retry move_block .
     7913           end.
     7914         end.
     7915       end.
     7916       if p-move-resize = true
     7917       then do:
     7918         run diasize_position-resize-button in this-procedure .
     7919       end.
     7920       if v-diasize-wndstore = true
     7921       then do:
     7922         if connected("ub") = true
     7923         then do:
     7924           define variable v-cntxt-db-num        as integer   no-undo .
     7925           define variable v-cntxt-userid        as character no-undo .
     7926           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     7927                                             , OUTPUT v-cntxt-userid
     7928                                             ) .
     7929           run gbl/wndsizew.p
     7930             (input  v-cntxt-db-num
     7931             ,input  v-cntxt-userid
     7932             ,input  v-diasize-proc-name
     7933             ,input  'height':u
     7934             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     7935             ) .
     7936         end.
     7937       end.
     7938     end.
     7939     assign
     7940       v-diasize-change-size = false
     7941     .
     7942   end procedure.
     7943   procedure diasize_set-height :
     7944     define input  parameter p-new-height  as decimal   no-undo .
     7945     define input  parameter p-move-resize as logical   no-undo .
     7946     do
     7947     on error undo, return error return-value
     7948     :
     7949       run diasize_change-height in this-procedure
     7950         (input  (p-new-height - frame Dialog-Frame :height)
     7951         ,input  p-move-resize
     7952         ) .
     7953     end.
     7954   end procedure.
     7955   procedure diasize_change-width :
     7956     define input  parameter p-change-value as decimal   no-undo .
     7957     define input  parameter p-move-resize  as logical   no-undo .
     7958     define variable v-field-group-handle   as handle    no-undo .
     7959     define variable v-object-handle        as handle    no-undo .
     7960     define variable v-frame-width          as decimal   no-undo .
     7961     define variable v-frame-virtual-width  as decimal   no-undo .
     7962     define variable v-browse-width         as decimal   no-undo .
     7963     define variable v-window-width         as decimal   no-undo .
     7964     define variable v-window-virtual-width as decimal   no-undo .
     7965     define variable v-change-sign          as integer   no-undo .
     7966     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     7967     define buffer buf_temp-browse-handle  for temp-browse-handle .
     7968     if p-change-value > 0
     7969     then do:
     7970       if frame Dialog-Frame :width + p-change-value >
     7971           session :width-chars
     7972       then do:
     7973         assign
     7974           p-change-value = session :width-chars - frame Dialog-Frame :width
     7975         .
     7976         if p-change-value <= 0
     7977         then do:
     7978           run diasize_position-resize-button in this-procedure .
     7979           return .
     7980         end.
     7981       end.
     7982     end.
     7983     if p-change-value < 0
     7984     then do:
     7985       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     7986       then do:
     7987         assign
     7988           p-change-value = v-diasize-orig-frame-width
     7989                          - frame Dialog-Frame :width
     7990         .
     7991         if p-change-value >= 0
     7992         then do:
     7993           run diasize_position-resize-button in this-procedure .
     7994           return .
     7995         end.
     7996       end.
     7997     end.
     7998     if p-change-value >= 0
     7999     then do:
     8000       assign
     8001         v-change-sign = 1
     8002       .
     8003     end.
     8004     else do:
     8005       assign
     8006         v-change-sign = -1
     8007       .
     8008     end.
     8009     assign
     8010       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     8011     .
     8012     if p-change-value = 0
     8013     then do:
     8014       run diasize_position-resize-button in this-procedure .
     8015       return .
     8016     end.
     8017     move_block:
     8018     do
     8019     on error undo move_block, leave move_block
     8020     :
     8021       if retry
     8022       then do:
     8023         do
     8024         on error undo move_block, leave move_block
     8025         :
     8026           if p-change-value > 0
     8027           then do:
     8028             for each buf_temp-diasize-handle
     8029             on error undo, next
     8030             :
     8031               assign
     8032                 v-object-handle = buf_temp-diasize-handle.handle-value
     8033               .
     8034               if v-object-handle <> v-diasize-resize-button
     8035               then do:
     8036                 assign
     8037                   v-object-handle :col = buf_temp-diasize-handle.save-position
     8038                 .
     8039               end.
     8040             end.
     8041             assign
     8042               v-diasize-browse-handle :width = v-browse-width
     8043             .
     8044             for each buf_temp-browse-handle
     8045               where buf_temp-browse-handle.browse-type = 'width':u
     8046             on error undo, next
     8047             :
     8048               assign
     8049                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     8050               .
     8051             end.
     8052             assign
     8053               frame Dialog-Frame :width = v-frame-width
     8054             .
     8055             if frame Dialog-Frame :scrollable = true
     8056             then do:
     8057               assign
     8058                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     8059               .
     8060             end.
     8061             run diasize_position-resize-button in this-procedure .
     8062           end.
     8063           else do:
     8064             if frame Dialog-Frame :scrollable = true
     8065             then do:
     8066               assign
     8067                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     8068               .
     8069             end.
     8070             assign
     8071               frame Dialog-Frame :width = v-frame-width
     8072             .
     8073             for each buf_temp-browse-handle
     8074               where buf_temp-browse-handle.browse-type = 'width':u
     8075             on error undo, next
     8076             :
     8077               assign
     8078                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     8079               .
     8080             end.
     8081             assign
     8082               v-diasize-browse-handle :width = v-browse-width
     8083             .
     8084             for each buf_temp-diasize-handle
     8085             on error undo, next
     8086             :
     8087               assign
     8088                 v-object-handle = buf_temp-diasize-handle.handle-value
     8089               .
     8090               if v-object-handle <> v-diasize-resize-button
     8091               then do:
     8092                 assign
     8093                   v-object-handle :col = buf_temp-diasize-handle.save-position
     8094                 .
     8095               end.
     8096             end.
     8097             run diasize_position-resize-button in this-procedure .
     8098           end.
     8099           assign
     8100             v-diasize-change-size = false
     8101           .
     8102           leave move_block .
     8103         end.
     8104       end.
     8105       assign
     8106         v-diasize-need-full-display = true
     8107       .
     8108       if v-diasize-change-size = false
     8109       then do:
     8110         assign
     8111           v-diasize-change-size = true
     8112         .
     8113       end.
     8114       else do:
     8115         return .
     8116       end.
     8117       assign
     8118         v-frame-width = frame Dialog-Frame :width
     8119         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     8120         v-browse-width = v-diasize-browse-handle :width
     8121       .
     8122       for each buf_temp-browse-handle
     8123         where buf_temp-browse-handle.browse-type = 'width':u
     8124       :
     8125         assign
     8126           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     8127         .
     8128       end.
     8129       for each buf_temp-diasize-handle
     8130       :
     8131         delete buf_temp-diasize-handle .
     8132       end.
     8133       assign
     8134         v-field-group-handle = frame Dialog-Frame :first-child
     8135       .
     8136       do while valid-handle(v-field-group-handle)
     8137       :
     8138         assign
     8139           v-object-handle = v-field-group-handle :first-child
     8140         .
     8141         do while valid-handle(v-object-handle)
     8142         :
     8143           if  v-object-handle <> v-diasize-browse-handle :handle
     8144           and v-object-handle <> v-diasize-resize-button
     8145           and can-query(v-object-handle, "row")
     8146           and can-query(v-object-handle, "height")
     8147           and ( v-object-handle :col + v-object-handle :width
     8148                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     8149               )
     8150           then do:
     8151             find first buf_temp-browse-handle
     8152               where buf_temp-browse-handle.browse-type   = 'width':u
     8153                 and buf_temp-browse-handle.browse-handle = v-object-handle
     8154               no-error .
     8155             if available buf_temp-browse-handle
     8156             then do:
     8157             end.
     8158             else do:
     8159               create buf_temp-diasize-handle .
     8160               assign
     8161                 buf_temp-diasize-handle.handle-value  = v-object-handle
     8162                 buf_temp-diasize-handle.save-position = v-object-handle :col
     8163               .
     8164             end.
     8165           end.
     8166           assign
     8167             v-object-handle = v-object-handle :next-sibling
     8168           .
     8169         end.
     8170         assign
     8171           v-field-group-handle = v-field-group-handle :next-sibling
     8172         .
     8173       end.
     8174       do with frame Dialog-Frame
     8175       :
     8176         hide v-diasize-resize-button .
     8177         v-diasize-resize-button :row = 1.
     8178         v-diasize-resize-button :column = 1.
     8179       end.
     8180       if p-change-value > 0
     8181       then do:
     8182         if frame Dialog-Frame :scrollable = true
     8183         then do:
     8184           assign
     8185             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     8186             no-error .
     8187           if error-status :error
     8188           or error-status :get-message(1) <> ""
     8189           then do:
     8190             undo move_block, retry move_block.
     8191           end.
     8192         end.
     8193         assign
     8194           frame Dialog-Frame :width = v-frame-width + p-change-value
     8195           no-error .
     8196         if error-status :error
     8197         or error-status :get-message(1) <> ""
     8198         then do:
     8199           undo move_block, retry move_block.
     8200         end.
     8201         assign
     8202           v-diasize-browse-handle :width = v-browse-width + p-change-value
     8203         no-error .
     8204         if error-status :error
     8205         or error-status :get-message(1) <> ""
     8206         then do:
     8207           undo move_block, retry move_block.
     8208         end.
     8209         for each buf_temp-browse-handle
     8210           where buf_temp-browse-handle.browse-type = 'width':u
     8211         on error undo move_block, retry move_block
     8212         :
     8213           assign
     8214             buf_temp-browse-handle.browse-handle :width
     8215               = buf_temp-browse-handle.browse-handle :width + p-change-value
     8216             no-error .
     8217           if error-status :error
     8218           or error-status :get-message(1) <> ""
     8219           then do:
     8220             undo move_block, retry move_block .
     8221           end.
     8222         end.
     8223         for each buf_temp-diasize-handle
     8224         on error undo move_block, retry move_block
     8225         :
     8226           assign
     8227             v-object-handle = buf_temp-diasize-handle.handle-value
     8228           .
     8229           if v-object-handle <> v-diasize-resize-button
     8230           then do:
     8231             assign
     8232               v-object-handle :col = v-object-handle :col + p-change-value
     8233               no-error .
     8234             if error-status :error
     8235             or error-status :get-message(1) <> ""
     8236             then do:
     8237               undo move_block, retry move_block .
     8238             end.
     8239           end.
     8240         end.
     8241       end.
     8242       else do:
     8243         for each buf_temp-diasize-handle
     8244         on error undo move_block, retry move_block
     8245         :
     8246           assign
     8247             v-object-handle = buf_temp-diasize-handle.handle-value
     8248           .
     8249           if v-object-handle <> v-diasize-resize-button
     8250           then do:
     8251             assign
     8252               v-object-handle :col = v-object-handle :col + p-change-value
     8253               no-error .
     8254             if error-status :error
     8255             or error-status :get-message(1) <> ""
     8256             then do:
     8257               undo move_block, retry move_block .
     8258             end.
     8259           end.
     8260         end.
     8261         for each buf_temp-browse-handle
     8262           where buf_temp-browse-handle.browse-type = 'width':u
     8263         on error undo move_block, retry move_block
     8264         :
     8265           assign
     8266             buf_temp-browse-handle.browse-handle :width
     8267               = buf_temp-browse-handle.browse-handle :width + p-change-value
     8268             no-error .
     8269           if error-status :error
     8270           or error-status :get-message(1) <> ""
     8271           then do:
     8272             undo move_block, retry move_block .
     8273           end.
     8274         end.
     8275         assign
     8276           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     8277           no-error .
     8278         if error-status :error
     8279         or error-status :get-message(1) <> ""
     8280         then do:
     8281           undo move_block, retry move_block.
     8282         end.
     8283         assign
     8284           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     8285         no-error .
     8286         if error-status :error
     8287         or error-status :get-message(1) <> ""
     8288         then do:
     8289           undo move_block, retry move_block.
     8290         end.
     8291         if frame Dialog-Frame :scrollable = true
     8292         then do:
     8293           assign
     8294             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     8295           no-error .
     8296           if error-status :error
     8297           or error-status :get-message(1) <> ""
     8298           then do:
     8299             undo move_block, retry move_block.
     8300           end.
     8301         end.
     8302       end.
     8303       if p-move-resize
     8304       then do:
     8305         run diasize_position-resize-button in this-procedure .
     8306       end.
     8307       if v-diasize-wndstore = true
     8308       then do:
     8309         if connected("ub") = true
     8310         then do:
     8311           define variable v-cntxt-db-num        as integer   no-undo .
     8312           define variable v-cntxt-userid        as character no-undo .
     8313           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     8314                                             , OUTPUT v-cntxt-userid
     8315                                             ) .
     8316           run gbl/wndsizew.p
     8317             (input  v-cntxt-db-num
     8318             ,input  v-cntxt-userid
     8319             ,input  v-diasize-proc-name
     8320             ,input  'width':u
     8321             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     8322             ) .
     8323         end.
     8324       end.
     8325     end.
     8326     assign
     8327       v-diasize-change-size = false
     8328     .
     8329   end procedure.
     8330   procedure diasize_set-width :
     8331     define input  parameter p-new-width  as decimal   no-undo .
     8332     define input  parameter p-move-resize as logical   no-undo .
     8333     do
     8334     on error undo, return error return-value
     8335     :
     8336       run diasize_change-width in this-procedure
     8337         (input  (p-new-width - frame Dialog-Frame :width)
     8338         ,input  p-move-resize
     8339         ) .
     8340     end.
     8341   end procedure.
     8342   procedure diasize_position-resize-button :
     8343     do with frame Dialog-Frame
     8344     :
     8345       hide v-diasize-resize-button .
     8346       assign
     8347         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     8348                     - 1
     8349                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     8350         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     8351                     - 1
     8352                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     8353       .
     8354       view v-diasize-resize-button .
     8355     end.
     8356   end procedure.
     8357   on alt-right anywhere
     8358   do:
     8359     run diasize_change-width in this-procedure
     8360       (input 1
     8361       ,input true
     8362       ) .
     8363     return no-apply .
     8364   end.
     8365   on alt-left anywhere
     8366   do:
     8367     run diasize_change-width in this-procedure
     8368       (input -1
     8369       ,input true
     8370       ) .
     8371     return no-apply .
     8372   end.
     8373   on alt-down anywhere
     8374   do:
     8375     run diasize_change-height in this-procedure
     8376       (input 1
     8377       ,input true
     8378       ) .
     8379     return no-apply .
     8380   end.
     8381   on alt-up anywhere
     8382   do:
     8383     run diasize_change-height in this-procedure
     8384       (input -1
     8385       ,input true
     8386       ) .
     8387     return no-apply .
     8388   end.
     8389   on alt-enter of frame Dialog-Frame
     8390   do:
     8391     run diasize_maximize in this-procedure
     8392       (input  ?
     8393       ).
     8394     return no-apply .
     8395   end.
     8396   procedure diasize_end-move :
     8397     do
     8398     on error undo, return error return-value
     8399     :
     8400       define variable v-row-delta as decimal   no-undo .
     8401       define variable v-col-delta as decimal   no-undo .
     8402       define variable v-new-row as decimal   no-undo .
     8403       define variable v-new-col as decimal   no-undo .
     8404       assign
     8405         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     8406         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     8407       .
     8408       assign
     8409         v-row-delta = v-new-row - frame Dialog-Frame :height
     8410         v-col-delta = v-new-col - frame Dialog-Frame :width
     8411       .
     8412       run diasize_change-height in this-procedure
     8413         (input v-row-delta
     8414         ,input true
     8415         ) .
     8416       run diasize_change-width in this-procedure
     8417         (input v-col-delta
     8418         ,input true
     8419         ) .
     8420     end.
     8421   end procedure.
     8422   procedure diasize_maximize :
     8423     define input  parameter p-action as logical   no-undo .
     8424     do
     8425     on error undo, return error return-value
     8426     :
     8427       if p-action = ?
     8428       then do:
     8429         if v-diasize-need-maximize = true
     8430         then do:
     8431           assign
     8432             p-action = true
     8433           .
     8434         end.
     8435         else do:
     8436           assign
     8437             p-action = false
     8438           .
     8439         end.
     8440       end.
     8441       if p-action = true
     8442       then do:
     8443         run diasize_change-height in this-procedure
     8444           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     8445               - frame Dialog-Frame :height-chars
     8446           ,input true
     8447           ) .
     8448         run diasize_change-width in this-procedure
     8449           (input session :width-chars
     8450               - frame Dialog-Frame :width-chars
     8451           ,input true
     8452           ) .
     8453         assign
     8454           v-diasize-need-maximize = false
     8455         .
     8456       end.
     8457       else do:
     8458         run diasize_change-width in this-procedure
     8459           (input v-diasize-orig-frame-width
     8460               - frame Dialog-Frame :width-chars
     8461           ,input true
     8462           ) .
     8463         run diasize_change-height in this-procedure
     8464           (input v-diasize-orig-frame-height
     8465               - frame Dialog-Frame :height-chars
     8466           ,input true
     8467           ) .
     8468         assign
     8469           v-diasize-need-maximize = true
     8470         .
     8471       end.
     8472     end.
     8473   end procedure.
     8474   procedure diasize_restore-orig-size :
     8475     do
     8476     on error undo, return error return-value
     8477     :
     8478       assign
     8479         v-diasize-current-frame-width  = frame Dialog-Frame :width
     8480         v-diasize-current-frame-height = frame Dialog-Frame :height
     8481       .
     8482       run diasize_set-height in this-procedure
     8483         (input  v-diasize-orig-frame-height
     8484         ,input  true
     8485         ) .
     8486       run diasize_set-width in this-procedure
     8487         (input  v-diasize-orig-frame-width
     8488         ,input  true
     8489         ) .
     8490     end.
     8491   end procedure.
     8492   procedure diasize_restore-current-size :
     8493     do
     8494     on error undo, return error return-value
     8495     :
     8496       run diasize_set-height in this-procedure
     8497         (input  v-diasize-current-frame-height
     8498         ,input  true
     8499         ) .
     8500       run diasize_set-width in this-procedure
     8501         (input  v-diasize-current-frame-width
     8502         ,input  true
     8503         ) .
     8504     end.
     8505   end procedure.
     8506   procedure diasize_set-browse-handle :
     8507     define input  parameter p-browse-handle as handle   no-undo .
     8508     define buffer buf_temp-browse-handle for temp-browse-handle .
     8509     do
     8510     on error undo, return error return-value
     8511     :
     8512       assign
     8513         v-diasize-browse-handle = p-browse-handle
     8514       .
     8515       for each buf_temp-browse-handle
     8516       on error undo, return error return-value
     8517       :
     8518         delete buf_temp-browse-handle .
     8519       end.
     8520     end.
     8521   end procedure.
     8522   procedure diasize_add_browse :
     8523     define input  parameter p-browse-type   as character no-undo .
     8524     define input  parameter p-browse-handle as handle    no-undo .
     8525     define buffer buf_temp-browse-handle for temp-browse-handle .
     8526     do
     8527     on error undo, return error return-value
     8528     :
     8529       assign
     8530         v-diasize-browse-number = v-diasize-browse-number + 1
     8531       .
     8532       create buf_temp-browse-handle .
     8533       assign
     8534         buf_temp-browse-handle.browse-type   = p-browse-type
     8535         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     8536         buf_temp-browse-handle.browse-handle = p-browse-handle
     8537       .
     8538     end.
     8539   end procedure.
     8540   procedure diasize_init :
     8541     define variable v-default-value    as logical   no-undo .
     8542     define variable v-restore-saved    as logical   no-undo .
     8543     define variable v-resize-value-str as character no-undo .
     8544     do
     8545     on error undo, return error return-value
     8546     :
     8547       do with frame Dialog-Frame
     8548       :
     8549         assign
     8550           v-diasize-orig-frame-height = frame Dialog-Frame :height
     8551           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     8552           v-diasize-browse-handle     = browse br-table :handle
     8553         .
     8554         create button v-diasize-resize-button
     8555         assign
     8556           parent        = frame Dialog-Frame :first-child
     8557           label         = "s"
     8558           height-pixels = 16
     8559           width-pixels  = 16
     8560           visible       = true
     8561           sensitive     = true
     8562           movable       = true
     8563           triggers:
     8564             on end-move persistent run diasize_end-move in this-procedure .
     8565           end triggers.
     8566         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     8567         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     8568         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     8569         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     8570         assign
     8571           v-diasize-wndmax = false
     8572         .
     8573         if connected("ub") = true
     8574         then do:
     8575           define variable v-cntxt-db-num        as integer   no-undo .
     8576           define variable v-cntxt-userid        as character no-undo .
     8577           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     8578                                             , OUTPUT v-cntxt-userid
     8579                                             ) .
     8580           run gbl/wndpar_r.p
     8581             (input  v-cntxt-db-num
     8582             ,input  v-cntxt-userid
     8583             ,input  'wndmax':U
     8584             ,output v-diasize-wndmax
     8585             ,output v-default-value
     8586             ) .
     8587         end.
     8588         assign
     8589           v-diasize-wndstore = false
     8590         .
     8591         if connected("ub") = true
     8592         then do:
     8593           run gbl/wndpar_r.p
     8594             (input  v-cntxt-db-num
     8595             ,input  v-cntxt-userid
     8596             ,input  'wndstore':U
     8597             ,output v-diasize-wndstore
     8598             ,output v-default-value
     8599             ) .
     8600         end.
     8601         assign
     8602           v-diasize-proc-name = entry(1, program-name(2), '.')
     8603         .
     8604         if v-diasize-wndstore = true
     8605         then do:
     8606           assign
     8607             v-restore-saved = false
     8608           .
     8609           if connected("ub") = true
     8610           then do:
     8611             run gbl/wndsizer.p
     8612               (input  v-cntxt-db-num
     8613               ,input  v-cntxt-userid
     8614               ,input  v-diasize-proc-name
     8615               ,input  'height':u
     8616               ,output v-resize-value-str
     8617               ) .
     8618             if v-resize-value-str <> '':U
     8619             then do:
     8620               run diasize_change-height in this-procedure
     8621                 (input  integer(v-resize-value-str)
     8622                 ,input  true
     8623                 ) .
     8624               assign
     8625                 v-restore-saved = true
     8626               .
     8627             end.
     8628           end.
     8629           if connected("ub") = true
     8630           then do:
     8631             run gbl/wndsizer.p
     8632               (input  v-cntxt-db-num
     8633               ,input  v-cntxt-userid
     8634               ,input  v-diasize-proc-name
     8635               ,input  'width':u
     8636               ,output v-resize-value-str
     8637               ) .
     8638             if v-resize-value-str <> '':U
     8639             then do:
     8640               run diasize_change-width in this-procedure
     8641                 (input  integer(v-resize-value-str)
     8642                 ,input  true
     8643                 ) .
     8644               assign
     8645                 v-restore-saved = true
     8646               .
     8647             end.
     8648           end.
     8649           if v-restore-saved <> true
     8650           then do:
     8651             if v-diasize-wndmax = true
     8652             then do:
     8653               run diasize_maximize in this-procedure
     8654                 (input  true
     8655                 ) .
     8656             end.
     8657           end.
     8658         end.
     8659         else do:
     8660           if v-diasize-wndmax = true
     8661           then do:
     8662             run diasize_maximize in this-procedure
     8663               (input  true
     8664               ) .
     8665           end.
     8666         end.
     8667       end.
     8668     end.
     8669   end procedure.
     8670   procedure diasize_need-full-display :
     8671     define output parameter p-need-full-display as logical   no-undo .
     8672     do
     8673     on error undo, return error return-value
     8674     :
     8675       assign
     8676         p-need-full-display = v-diasize-need-full-display
     8677       .
     8678       assign
     8679         v-diasize-need-full-display = false
     8680       .
     8681     end.
     8682   end procedure.
     8683   procedure get-context :
     8684      define output parameter p-db-num as integer          no-undo.
     8685      define output parameter p-user-id as character        no-undo.
     8686      define variable v-login               as character    no-undo.
     8687      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     8688      define buffer buf_user-login  for ub.user-login .
     8689      do
     8690      on error undo, return error
     8691      :
     8692            FIND FIRST buf_sys-ctrl no-lock.
     8693            ASSIGN
     8694               v-login = USERID("ub")
     8695               p-db-num = buf_sys-ctrl.db-num
     8696            .
     8697            FIND FIRST buf_user-login
     8698                 WHERE buf_user-login.db-num = p-db-num
     8699                   AND buf_user-login.user-login = v-login
     8700                 no-lock
     8701                 no-error
     8702                 .
     8703            IF AVAILABLE buf_user-login
     8704            THEN DO:
     8705               assign
     8706                  p-user-id = buf_user-login.user-id
     8707               .
     8708            END.
     8709      end.
     8710   end procedure.
     8711       run diasize_init in this-procedure .
     8712   define variable vss-include-info59 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8713   on CTRL-F7 of frame Dialog-Frame anywhere do:
     8714     if b-close :sensitive then DO: apply "CHOOSE":U to b-close in frame Dialog-Frame. END.
     8715     return no-apply.
     8716   end.
     8717   define variable vss-include-info60 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8718   on CTRL-P, CTRL-З of frame Dialog-Frame anywhere do:
     8719     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame Dialog-Frame. END.
     8720     return no-apply.
     8721   end.
     8722     b-print:menu-mouse = 1.
     8723   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     8724   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     8725   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8726   on F9 of frame Dialog-Frame anywhere do:
     8727     run get-goods-recid.
     8728     if gds-rec = ? then
     8729       return no-apply.
     8730     run ref/gds-form.w ( input parparentproc
     8731                         ,input 'ПРОСМОТР':U
     8732                         ,input ?
     8733                         ,input ?
     8734                         ,input ?
     8735                         ,input-output gds-rec).
     8736     apply "entry" to br-table in frame Dialog-Frame.
     8737     return no-apply.
     8738   end.
     8739   MAIN-BLOCK:
     8740   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     8741      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     8742   define variable vss-include-info62 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8743     run mainmenu_getcntxt in parparentproc
     8744       (output v-cntxt-db-num
     8745       ,output v-cntxt-userid
     8746       ,output v-cntxt-level
     8747       ,output v-cntxt-host-code-obj
     8748       ,output v-cntxt-obj-type
     8749       ,output v-cntxt-obj-code
     8750       ,output v-cntxt-db-num-obj
     8751       ,output v-cntxt-is-admin
     8752       ) .
     8753       run get-report-num in parparentproc (
     8754           output g#report-num
     8755       ).
     8756       run get-quest-print in parparentproc (
     8757           output g#quest-print
     8758       ).
     8759      if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):IsBanRecipes then v-ban-recipes = true .
     8760      if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):IsBanAltr then v-ban-altr = true .
     8761       find first buf_init_goods no-lock
     8762            where recid( buf_init_goods ) = p-goods-recid
     8763       no-error.
     8764       if error-status :error
     8765       then do:
     8766           message
     8767                    vss-workfile vss-revision vss-description
     8768               skip "Неверно выбран товар."
     8769               skip return-value
     8770               skip trim(error-status :get-message(1))
     8771                    trim(error-status :get-message(2))
     8772                    trim(error-status :get-message(3))
     8773           view-as alert-box error.
     8774           undo, return error .
     8775       end.
     8776   define variable vss-include-info63 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8777   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     8778     (input  buf_init_goods.artic
     8779     ,input  buf_init_goods.prod-type
     8780     ,input  buf_init_goods.prod-code
     8781     ,output v-init-gds-code
     8782     )  .
     8783   define variable vss-include-info64 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8784   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     8785     (input  v-init-gds-code
     8786     ,output fi-init-units
     8787     )  .
     8788       find first buf_init_units no-lock
     8789            where buf_init_units.unit-name = fi-init-units
     8790       .
     8791       case p-mode:
     8792           when 'ДОБАВЛЕНИЕ':U
     8793           then do:
     8794               run fbrlib-create-or-update-recipe in this-procedure (
     8795                     input 'ДОБАВЛЕНИЕ':U
     8796                   , input p-store-type
     8797                   , input p-store-code
     8798                   , input ""
     8799                   , input p-recipe-type
     8800                   , input buf_init_goods.gds-code
     8801                   , input ""
     8802                   , input ""
     8803                   , input 0
     8804                   , input ""
     8805                   , input ""
     8806                   , input ""
     8807                   , input ""
     8808                   , input 1.0
     8809                   , input 0
     8810                   , input 0.0
     8811                   , output p-in-recipe-code
     8812               ).
     8813               assign
     8814                   p-out-recipe-code  = p-in-recipe-code
     8815               .
     8816               find first buf_init_recipe exclusive-lock
     8817                    where buf_init_recipe.recipe-code = p-in-recipe-code
     8818               .
     8819           end.
     8820           when 'ИЗМЕНЕНИЕ':U
     8821           then do:
     8822               find first buf_init_recipe exclusive-lock
     8823                    where buf_init_recipe.recipe-code = p-in-recipe-code
     8824               no-error.
     8825               if not available buf_init_recipe
     8826               then do:
     8827                   message
     8828                           vss-workfile vss-revision vss-description
     8829                       skip "Неверно выбран рецепт."
     8830                       skip return-value
     8831                       skip trim(error-status :get-message(1))
     8832                           trim(error-status :get-message(2))
     8833                           trim(error-status :get-message(3))
     8834                   view-as alert-box error.
     8835                   undo, return error .
     8836               end.
     8837           end.
     8838           when 'ПРОСМОТР':U
     8839           then do:
     8840               find first buf_init_recipe no-lock
     8841                    where buf_init_recipe.recipe-code = p-in-recipe-code
     8842               no-error.
     8843               if not available buf_init_recipe
     8844               then do:
     8845                   message
     8846                           vss-workfile vss-revision vss-description
     8847                       skip "Неверно выбран рецепт."
     8848                       skip return-value
     8849                       skip trim(error-status :get-message(1))
     8850                           trim(error-status :get-message(2))
     8851                           trim(error-status :get-message(3))
     8852                   view-as alert-box error.
     8853                   undo, return error .
     8854               end.
     8855           end.
     8856       end case.
     8857       FRAME Dialog-Frame :title = (                        buf_init_recipe.recipe-type
     8858                                       + " № "             + buf_init_recipe.recipe-code
     8859                                       + "    артикул : "  + buf_init_recipe.artic
     8860                                       + "     "           + buf_init_goods.gds-name
     8861                                       + "        "        + p-mode )
     8862       .
     8863       run init-fields in this-procedure .
     8864       RUN enable_UI.
     8865       run ui-on in this-procedure.
     8866       apply "entry" to br-table.
     8867       WAIT-FOR GO OF FRAME Dialog-Frame.
     8868   END.
     8869   RUN disable_UI.
     8870   PROCEDURE add-recipe :
     8871   do
     8872   on error undo, return error
     8873   :
     8874   define input parameter p-artic      as character    no-undo.
     8875   define input parameter p-prod-type  as character    no-undo.
     8876   define input parameter p-prod-code  as integer      no-undo.
     8877       define variable v-ref-list as character no-undo.
     8878       define buffer buf_goods     for goods.
     8879       define buffer buf_recipe    for ub.recipe .
     8880       find first buf_goods no-lock
     8881            where buf_goods.artic     = p-artic
     8882              AND buf_goods.prod-type = p-prod-type
     8883              AND buf_goods.prod-code = p-prod-code
     8884       .
     8885       run ref/rcp-all.w (
     8886             input parparentproc
     8887           , input ( if p-mode = 'ПРОСМОТР':U then "" else "b-add" )
     8888           , input 'все':U
     8889           , input recid( buf_goods )
     8890           , input p-store-type
     8891           , input p-store-code
     8892           , output v-ref-list
     8893       ).
     8894   end.
     8895   END PROCEDURE.
     8896   PROCEDURE attr-save :
     8897     define buffer buf_goods    for ub.goods .
     8898     define variable v-attr-value   as character    no-undo.
     8899     define variable v-attr-type    as character    no-undo.
     8900     if p-mode = 'ПРОСМОТР':U
     8901     then do:
     8902       return .
     8903     end.
     8904     find first buf_goods no-lock
     8905       where buf_goods.artic     = buf_init_recipe.artic
     8906         and buf_goods.prod-type = buf_init_recipe.prod-type
     8907         and buf_goods.prod-code = buf_init_recipe.prod-code
     8908     no-error .
     8909     if not available buf_goods
     8910     then do:
     8911       message
     8912         substitute( "Не найден товар с артикулом &1 производитель &2 &3"
     8913                   , buf_init_recipe.artic
     8914                   , buf_init_recipe.prod-type
     8915                   , buf_init_recipe.prod-code
     8916                   )
     8917       view-as alert-box error.
     8918       return .
     8919     end.
     8920     run gds-attr-value in this-procedure  ( input  buf_goods.gds-code
     8921                                           , input  'calc-cal-rec':U
     8922                                           , output v-attr-value
     8923                                           , output v-attr-type
     8924                                           ) no-error .
     8925     if error-status :error
     8926     then do:
     8927       message
     8928         "Не определен атрибут расчета калорийности"
     8929         skip
     8930       view-as alert-box information.
     8931       return.
     8932     END.
     8933     if logical(v-attr-value) = false
     8934     then do:
     8935       return.
     8936     end.
     8937     if v-calories     = ?
     8938     or v-protein      = ?
     8939     or v-fat          = ?
     8940     or v-carbohydrate = ?
     8941     then do:
     8942       message
     8943         "Не рассчитана пищевая и энергетическая ценность!"
     8944         skip
     8945       view-as alert-box information.
     8946       run str/diallog.w ( input parparentproc
     8947                         , input this-procedure
     8948                         , input ( 'get-incorrect-nutrition-goods':U + chr(4) +
     8949                                   "1" + chr(4) +
     8950                                   "0" + chr(4) +
     8951                                   "1" + chr(4) +
     8952                                   "1" + chr(4) +
     8953                                   "yes"
     8954                                 )
     8955                         , input ''
     8956                         , input no
     8957                         , input 'Закрыть'
     8958                         , input 'Список товаров с неполностью определенными атрибутами пищевой и энергетической ценности'
     8959                         ) no-error .
     8960       if error-status :error = yes
     8961       then do:
     8962         message
     8963           'Ошибка постороения списка товаров с неполностью определенными атрибутами пищевой и энергетической ценности' skip
     8964           error-status :get-message(1) skip
     8965           error-status :get-message(2)
     8966         view-as alert-box information.
     8967       end.
     8968       run fbrnutro_proc-save-nutrition in this-procedure ( input buf_init_recipe.recipe-code
     8969                                                          , input buf_init_recipe.artic
     8970                                                          , input buf_init_recipe.prod-type
     8971                                                          , input buf_init_recipe.prod-code
     8972                                                          , input ?
     8973                                                          , input ?
     8974                                                          , input ?
     8975                                                          , input ?
     8976                                                          ) no-error .
     8977       if error-status :error = yes
     8978       then do:
     8979         message
     8980           "Ошибка при сохранении атрибутов пищевой и энергетической ценности":U skip
     8981           return-value skip
     8982           error-status :get-message(1) skip
     8983           error-status :get-message(2)
     8984         view-as alert-box error.
     8985         return .
     8986       end.
     8987       return.
     8988     end.
     8989     run fbrnutro_proc-save-nutrition in this-procedure ( input buf_init_recipe.recipe-code
     8990                                                        , input buf_init_recipe.artic
     8991                                                        , input buf_init_recipe.prod-type
     8992                                                        , input buf_init_recipe.prod-code
     8993                                                        , input v-calories
     8994                                                        , input v-protein
     8995                                                        , input v-carbohydrate
     8996                                                        , input v-fat
     8997                                                        ) no-error .
     8998     if error-status :error = yes
     8999     then do:
     9000       message
     9001         "Ошибка при сохранении атрибутов пищевой и энергетической ценности":U skip
     9002         return-value skip
     9003         error-status :get-message(1) skip
     9004         error-status :get-message(2)
     9005       view-as alert-box error.
     9006       return .
     9007     end.
     9008   END PROCEDURE.
     9009   PROCEDURE calc-and-display-nutrition-info :
     9010   do
     9011   on error undo, return error return-value
     9012   :
     9013     assign
     9014       v-calories      = fbrnutro_get-recipe-nutrition-by-code ( buf_init_recipe.recipe-code, buf_init_recipe.artic, buf_init_recipe.prod-type, buf_init_recipe.prod-code, 'calories':U    ,fi-recipe-qnty)
     9015       v-protein       = fbrnutro_get-recipe-nutrition-by-code ( buf_init_recipe.recipe-code, buf_init_recipe.artic, buf_init_recipe.prod-type, buf_init_recipe.prod-code, 'protein':U     ,fi-recipe-qnty)
     9016       v-fat           = fbrnutro_get-recipe-nutrition-by-code ( buf_init_recipe.recipe-code, buf_init_recipe.artic, buf_init_recipe.prod-type, buf_init_recipe.prod-code, 'fat':U         ,fi-recipe-qnty)
     9017       v-carbohydrate  = fbrnutro_get-recipe-nutrition-by-code ( buf_init_recipe.recipe-code, buf_init_recipe.artic, buf_init_recipe.prod-type, buf_init_recipe.prod-code, 'carbohydrate':U,fi-recipe-qnty)
     9018     .
     9019     display
     9020       v-calories
     9021       v-protein
     9022       v-fat
     9023       v-carbohydrate
     9024     with frame Dialog-Frame .
     9025   end.
     9026   END PROCEDURE.
     9027   PROCEDURE change-goods-list :
     9028   define input parameter p-recipe-code as character        no-undo.
     9029   define input parameter p-recipe-type as character        no-undo.
     9030       define variable v-line-counter      as integer      no-undo.
     9031       define variable v-ok                as logical      no-undo.
     9032       define buffer buf_recipe-gds    for recipe-gds.
     9033       define buffer buf_goods         for goods.
     9034      define variable v-attr-value   as character no-undo.
     9035      define variable v-attr-type    as character no-undo.
     9036      define buffer buf_recipe     for recipe.
     9037      define variable ii as integer no-undo .
     9038      define variable type_mark as character no-undo .
     9039      define variable v-attr-value-rec as character no-undo .
     9040   do
     9041   for buf_recipe-gds
     9042     , buf_goods
     9043   on error undo, return error
     9044   :
     9045   if session :set-wait-state( "compiler" ) then.
     9046       assign
     9047           v-line-counter = 0
     9048       .
     9049       for each buf_recipe-gds
     9050          where buf_recipe-gds.recipe-code = p-recipe-code
     9051         , each goods no-lock
     9052          where goods.artic     = buf_recipe-gds.artic
     9053            and goods.prod-type = buf_recipe-gds.prod-type
     9054            and goods.prod-code = buf_recipe-gds.prod-code
     9055       :
     9056   define variable vss-include-info65 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9057   find scn-list
     9058     where scn-list.prod-type = goods.prod-type
     9059       and scn-list.prod-code = goods.prod-code
     9060       and scn-list.artic     = goods.artic
     9061     no-error .
     9062   if available scn-list then do:
     9063     assign
     9064       scn-list.to-del = no
     9065     .
     9066   end.
     9067   else do:
     9068     define variable v-last65 as integer no-undo .
     9069     find last scn-list use-index oi no-error.
     9070     if available scn-list then do:
     9071       v-last65 = scn-list.order-num .
     9072     end.
     9073     else do:
     9074       v-last65 = 0 .
     9075     end.
     9076     create scn-list .
     9077     buffer-copy goods to scn-list
     9078     assign
     9079       scn-list.to-del = no
     9080       scn-list.order-num = v-last65 + 1
     9081     .
     9082     assign
     9083       lns-cnt = lns-cnt + 1
     9084       line-rec = recid (scn-list)
     9085     .
     9086   end.
     9087           assign
     9088               scn-list.qnty = buf_recipe-gds.brutto-qnty
     9089           .
     9090           if buf_recipe-gds.proc-number > v-line-counter
     9091           then do:
     9092               assign
     9093                   v-line-counter = buf_recipe-gds.proc-number
     9094               .
     9095           end.
     9096       end.
     9097       for each scn-list
     9098          where scn-list.to-del = yes
     9099       :
     9100           delete scn-list.
     9101       end.
     9102   if session :set-wait-state( "" ) then.
     9103       run str/scn-list.w (
     9104             input parparentproc
     9105           , input v-cntxt-host-code-obj
     9106           , input v-cntxt-obj-type
     9107           , input v-cntxt-obj-code
     9108       ).
     9109   if session :set-wait-state( "compiler" ) then.
     9110       if p-recipe-type <> 'альтернатива':U
     9111       then do:
     9112           assign
     9113               v-line-counter = 0
     9114           .
     9115       end.
     9116       new-list-of-goods:
     9117       for each scn-list
     9118       :
     9119           assign
     9120               scn-list.to-del = yes
     9121           .
     9122           find first buf_goods no-lock
     9123                where buf_goods.prod-type = scn-list.prod-type
     9124                  and buf_goods.prod-code = scn-list.prod-code
     9125                  and buf_goods.artic     = scn-list.artic
     9126           .
     9127           if buf_goods.gds-type = 'у':U
     9128           and p-recipe-type <> 'производство':U
     9129           and p-recipe-type <> 'топливо':U
     9130           then do:
     9131               next new-list-of-goods.
     9132           end.
     9133          if p-recipe-type = 'производство':U and v-ban-recipes then
     9134          do:
     9135             run gds-attr-value in this-procedure  ( input buf_goods.gds-code
     9136                , input  'mark-type':U
     9137                , output v-attr-value
     9138                , output v-attr-type
     9139                ) no-error .
     9140             if v-attr-value <> "" and v-attr-value <> "not-type" then
     9141             do:
     9142                message "Товар " + buf_goods.gds-name + " имеет тип маркировки: " + v-attr-value + " и не может быть добавлен в рецепт производства"
     9143                   view-as alert-box.
     9144                next new-list-of-goods.
     9145             end.
     9146          end.
     9147          if p-recipe-type = 'альтернатива':U and v-ban-altr then
     9148          do:
     9149             ii = 0 .
     9150             FIND FIRST ub.recipe NO-LOCK WHERE
     9151                ub.recipe.prod-type = buf_goods.prod-type
     9152                AND ub.recipe.prod-code = buf_goods.prod-code
     9153                AND ub.recipe.artic     = buf_goods.artic
     9154                and ub.recipe.obj-code = v-cntxt-obj-code
     9155                and ub.recipe.obj-type = v-cntxt-obj-type no-error .
     9156             if available (ub.recipe) then
     9157             do:
     9158                message "Товар является рецептом: " + ub.recipe.recipe-code + " " + ub.recipe.recipe-name + chr(10) + " и не может быть добавлен в рецепт альтернатива"
     9159                   view-as alert-box.
     9160                next new-list-of-goods.
     9161             end.
     9162             if ii > 0 then
     9163             do:
     9164                run gds-attr-value in this-procedure  ( input  buf_goods.gds-code
     9165                   , input  'mark-type':U
     9166                   , output v-attr-value
     9167                   , output v-attr-type
     9168                   ) no-error .
     9169                if type_mark <> v-attr-value and v-attr-value <> "" and v-attr-value <> "not-type" then
     9170                do:
     9171                   message "Товар " + buf_goods.gds-name + " имеет тип маркировки: " + v-attr-value + chr(10) + " и не может быть добавлен в рецепт альтернатива," + chr(10) + " т.к. уже есть маркированные товары с другим типом"
     9172                      view-as alert-box.
     9173                   next new-list-of-goods.
     9174                end.
     9175             end.
     9176             else
     9177             do:
     9178                run gds-attr-value in this-procedure  ( input  buf_goods.gds-code
     9179                   , input  'mark-type':U
     9180                   , output v-attr-value
     9181                   , output v-attr-type
     9182                   ) no-error .
     9183                if v-attr-value <> "" and v-attr-value <> "not-type" then
     9184                do:
     9185                   type_mark = v-attr-value .
     9186                   ii = 1 .
     9187                end.
     9188             end.
     9189          end.
     9190          if p-recipe-type = 'комплектация':U and v-ban-recipes then
     9191          do:
     9192             run gds-attr-value in this-procedure  ( input  buf_goods.gds-code
     9193                , input  'mark-type':U
     9194                , output v-attr-value
     9195                , output v-attr-type
     9196                ) no-error .
     9197             if v-attr-value <> "" and v-attr-value <> "not-type" then
     9198             do:
     9199                for first buf_recipe no-lock where buf_recipe.recipe-code = p-recipe-code:
     9200                   run gds-attr-value in this-procedure  ( input  buf_recipe.gds-code
     9201                      , input  'mark-type':U
     9202                      , output v-attr-value-rec
     9203                      , output v-attr-type
     9204                      ) no-error .
     9205                   if v-attr-value-rec = "" or v-attr-value-rec = "not-type" then
     9206                   do:
     9207                      message "Рецепт комплектации " + buf_recipe.recipe-code + " " + buf_recipe.recipe-name + " не маркирован"
     9208                         view-as alert-box.
     9209                      return.
     9210                   end.
     9211                end.
     9212                if v-attr-value <> "milk" then
     9213                do:
     9214                   message "Товар " + buf_goods.gds-name + " не является молочным продуктом"
     9215                      view-as alert-box.
     9216                   next new-list-of-goods.
     9217                end.
     9218             end.
     9219          end.
     9220           assign
     9221               v-line-counter = v-line-counter + 1
     9222               ii = ii + 1
     9223           .
     9224           find first buf_recipe-gds no-lock
     9225                where buf_recipe-gds.recipe-code = p-recipe-code
     9226                  and buf_recipe-gds.prod-type   = scn-list.prod-type
     9227                  and buf_recipe-gds.prod-code   = scn-list.prod-code
     9228                  and buf_recipe-gds.artic       = scn-list.artic
     9229           no-error.
     9230           if not available buf_recipe-gds
     9231           or buf_recipe-gds.brutto-qnty <> scn-list.qnty
     9232           then do:
     9233               run fbrlib-create-or-update-recipe-gds in this-procedure (
     9234                     input p-recipe-code
     9235                   , input buf_goods.gds-code
     9236                   , input no
     9237                   , input scn-list.qnty
     9238                   , input v-line-counter
     9239                   , input yes
     9240               ).
     9241           end.
     9242       end.
     9243       for each buf_recipe-gds exclusive-lock
     9244          where buf_recipe-gds.recipe-code = p-recipe-code
     9245       :
     9246           if not can-find( scn-list where scn-list.artic      = buf_recipe-gds.artic
     9247                                       and scn-list.prod-type  = buf_recipe-gds.prod-type
     9248                                       and scn-list.prod-code  = buf_recipe-gds.prod-code )
     9249           then do:
     9250               assign
     9251                   buf_recipe-gds.nws-self    = yes
     9252               .
     9253               delete buf_recipe-gds.
     9254           end.
     9255       end.
     9256   if session :set-wait-state( "" ) then.
     9257   end.
     9258   END PROCEDURE.
     9259   PROCEDURE check-recipe :
     9260   do
     9261   on error undo, return error
     9262   :
     9263   define input parameter p-recipe-code        as character    no-undo.
     9264   define input parameter p-recipe-name        as character    no-undo.
     9265   define input parameter p-recipe-qnty        as decimal      no-undo.
     9266   define input parameter p-portion-qnty       as decimal      no-undo.
     9267   define input parameter p-portion-weight     as decimal      no-undo.
     9268   define input parameter p-recipe-ref-num     as character    no-undo.
     9269   define input parameter p-recipe-technique   as character    no-undo.
     9270   define output parameter p-bad-data          as logical      no-undo.
     9271   define output parameter p-error-text        as character    no-undo.
     9272      define variable v-gds-code            as integer   no-undo.
     9273      define variable v-unit-base           as character no-undo.
     9274      define variable v-is-goods            as logical   no-undo.
     9275      define variable v-empty-scale         as logical   no-undo.
     9276      define variable v-ingr-count          as integer   no-undo.
     9277      define variable v-waste-count         as integer   no-undo.
     9278      define variable v-sum-gds-qnty        as decimal   no-undo.
     9279      define variable v-sum-gds-brutto-qnty as decimal   no-undo.
     9280      define variable v-attr-value          as character no-undo.
     9281      define variable v-attr-value-rec      as character no-undo.
     9282      define variable v-attr-type           as character no-undo.
     9283      define variable v-ok                  as logical   no-undo .
     9284      define buffer buf_units            for units.
     9285      define buffer buf_recipe           for recipe.
     9286      define buffer buf_recipe-gds       for recipe-gds.
     9287      define buffer buf_other_recipe-gds for recipe-gds.
     9288      define buffer buf_goods            for ub.goods.
     9289       find first buf_recipe no-lock
     9290            where buf_recipe.recipe-code = p-recipe-code
     9291       .
     9292   define variable vss-include-info66 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9293   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     9294     (input  buf_recipe.artic
     9295     ,input  buf_recipe.prod-type
     9296     ,input  buf_recipe.prod-code
     9297     ,input  'empty-scale=request':u
     9298     ,output v-empty-scale
     9299     )  .
     9300   define variable vss-include-info67 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9301   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     9302     (input  buf_recipe.artic
     9303     ,input  buf_recipe.prod-type
     9304     ,input  buf_recipe.prod-code
     9305     ,output v-gds-code
     9306     )  .
     9307   define variable vss-include-info68 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9308   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     9309     (input  v-gds-code
     9310     ,output v-unit-base
     9311     )  .
     9312       find first buf_units no-lock
     9313            where buf_units.unit-name = v-unit-base
     9314       .
     9315       if p-portion-qnty < 1
     9316       and buf_recipe.recipe-type = 'производство':U
     9317       then do:
     9318           assign
     9319               p-bad-data   = yes
     9320               p-error-text = "Количество порций не может быть меньше 1."
     9321           .
     9322           undo, return.
     9323       end.
     9324       if lookup( 'шту':U, buf_units.type ) > 0
     9325       and buf_recipe.recipe-type = 'производство':U
     9326       then do:
     9327           if p-portion-qnty <> p-recipe-qnty
     9328           then do:
     9329               assign
     9330                   p-bad-data   = yes
     9331                   p-error-text = "Для штучного товара количество порций "
     9332                                  + chr(10) + "должно быть равно количеству товара рецепта."
     9333               .
     9334               undo, return.
     9335           end.
     9336       end.
     9337       if p-recipe-name = ?
     9338       or p-recipe-name = ""
     9339       then do:
     9340           assign
     9341               p-bad-data   = yes
     9342               p-error-text = "Название рецепта не может быть пустым."
     9343           .
     9344           undo, return.
     9345       end.
     9346       if v-empty-scale = no
     9347       then do:
     9348           assign
     9349               p-bad-data   = yes
     9350               p-error-text = "В рецепте могут быть только товары без шкал."
     9351           .
     9352           undo, return.
     9353       end.
     9354       if ( buf_recipe.recipe-type = 'производство':U
     9355         or buf_recipe.recipe-type = 'комплектация':U
     9356         or buf_recipe.recipe-type = 'альтернатива':U )
     9357       and ( p-recipe-qnty <= 0
     9358          or p-recipe-qnty = ? )
     9359       then do:
     9360           assign
     9361               p-bad-data   = yes
     9362               p-error-text = "Количество составного товара рецепта должно быть больше 0."
     9363           .
     9364           undo, return.
     9365       end.
     9366       if lookup( 'шту':U, buf_units.type ) > 0
     9367       and ( truncate( p-recipe-qnty, 0 ) - p-recipe-qnty ) <> 0
     9368       and buf_recipe.recipe-type <> 'альтернатива':U
     9369       then do:
     9370           assign
     9371               p-bad-data   = yes
     9372               p-error-text = "Товар рецепта штучный, его количество не может быть дробным."
     9373           .
     9374           undo, return.
     9375       end.
     9376   define variable vss-include-info69 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9377   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     9378     (input  buf_recipe.artic
     9379     ,input  buf_recipe.prod-type
     9380     ,input  buf_recipe.prod-code
     9381     ,input  'gds-goods=request':u
     9382     ,output v-is-goods
     9383     )  .
     9384       if buf_recipe.recipe-type = 'комплектация':U
     9385       and lookup( 'шту':U, buf_units.type ) = 0
     9386       and v-is-goods = yes
     9387       then do:
     9388           assign
     9389               p-bad-data   = yes
     9390               p-error-text = "Рецепт на комплектацию может быть составлен только для штучного товара."
     9391           .
     9392           undo, return.
     9393       end.
     9394       if buf_recipe.recipe-type = 'разделка':U
     9395       and lookup( 'вес':U, buf_units.type ) = 0
     9396       and v-is-goods = yes
     9397       then do:
     9398           assign
     9399               p-bad-data   = yes
     9400               p-error-text = "Рецепт на разделку может быть составлен только для весового товара."
     9401           .
     9402           undo, return.
     9403       end.
     9404       if lookup( 'сер':U, buf_units.type ) > 0
     9405       then do:
     9406           assign
     9407               p-bad-data   = yes
     9408               p-error-text = "Для серийного товара не может быть составлен рецепт."
     9409           .
     9410           undo, return.
     9411       end.
     9412       assign
     9413           v-ingr-count = 0
     9414       .
     9415       for each buf_recipe-gds
     9416          where buf_recipe-gds.recipe-code = buf_recipe.recipe-code
     9417       :
     9418           if buf_recipe-gds.qnty = 0
     9419           and buf_init_recipe.recipe-type <> 'разделка':U
     9420           then do:
     9421               assign
     9422                   p-bad-data   = yes
     9423                   p-error-text = "Нулевое количество товара в строке рецепта."
     9424                                   + chr(10) + "Артикул товара:" + buf_recipe-gds.artic
     9425               .
     9426               undo, return.
     9427           end.
     9428           if  buf_recipe-gds.artic     = buf_recipe.artic
     9429           and buf_recipe-gds.prod-type = buf_recipe.prod-type
     9430           and buf_recipe-gds.prod-code = buf_recipe.prod-code
     9431           then do:
     9432               assign
     9433                   p-bad-data   = yes
     9434                   p-error-text = "Строка рецепта не может содержать тот же товар, что и сам рецепт."
     9435               .
     9436               undo, return.
     9437           end.
     9438   define variable vss-include-info70 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9439   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     9440     (input  buf_recipe-gds.artic
     9441     ,input  buf_recipe-gds.prod-type
     9442     ,input  buf_recipe-gds.prod-code
     9443     ,output v-gds-code
     9444     )  .
     9445   define variable vss-include-info71 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9446   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     9447     (input  v-gds-code
     9448     ,output v-unit-base
     9449     )  .
     9450           find first buf_units no-lock
     9451                where buf_units.unit-name = v-unit-base
     9452           .
     9453           if lookup( 'шту':U, buf_units.type ) > 0
     9454           and ( truncate( buf_recipe-gds.qnty, 0 ) - buf_recipe-gds.qnty ) <> 0
     9455           and buf_recipe.recipe-type <> 'альтернатива':U
     9456           then do:
     9457               assign
     9458                   p-bad-data   = yes
     9459                   p-error-text = "Товар-ингредиент штучный, его количество не может быть дробным."
     9460               .
     9461               undo, return.
     9462           end.
     9463   define variable vss-include-info72 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9464   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     9465     (input  buf_recipe-gds.artic
     9466     ,input  buf_recipe-gds.prod-type
     9467     ,input  buf_recipe-gds.prod-code
     9468     ,input  'gds-goods=request':u
     9469     ,output v-is-goods
     9470     )  .
     9471           if buf_recipe.recipe-type = 'комплектация':U
     9472           and lookup( 'шту':U, buf_units.type ) = 0
     9473           and v-is-goods = yes
     9474           then do:
     9475               assign
     9476                   p-bad-data   = yes
     9477                   p-error-text = "В рецепте на комплектацию должен быть только штучный товар."
     9478               .
     9479               undo, return.
     9480           end.
     9481           if buf_recipe.recipe-type = 'разделка':U
     9482           and lookup( 'вес':U, buf_units.type ) = 0
     9483           and v-is-goods = yes
     9484           then do:
     9485               assign
     9486                   p-bad-data   = yes
     9487                   p-error-text = "В рецепте на разделку должен быть только весовой товар."
     9488               .
     9489               undo, return.
     9490           end.
     9491           if lookup( 'сер':U, buf_units.type ) > 0
     9492           then do:
     9493               assign
     9494                   p-bad-data   = yes
     9495                   p-error-text = "В рецепте не может быть серийного товара."
     9496               .
     9497               undo, return.
     9498           end.
     9499           if lookup( 'топ':U, buf_units.type ) > 0
     9500           then do:
     9501               find first buf_other_recipe-gds
     9502                    where buf_other_recipe-gds.artic        = buf_recipe-gds.artic
     9503                      and buf_other_recipe-gds.prod-type    = buf_recipe-gds.prod-type
     9504                      and buf_other_recipe-gds.prod-code    = buf_recipe-gds.prod-code
     9505                      and buf_other_recipe-gds.recipe-code  <> buf_recipe-gds.recipe-code
     9506               no-error.
     9507               if available buf_other_recipe-gds
     9508               then do:
     9509                   assign
     9510                       p-bad-data   = yes
     9511                       p-error-text = "Сервисный элемент может входить только в один рецепт."
     9512                   .
     9513                   undo, return.
     9514               end.
     9515           end.
     9516           if ( buf_recipe.recipe-type <> 'топливо':U
     9517               and lookup( 'топ':U, buf_units.type ) > 0 )
     9518           or ( buf_recipe.recipe-type = 'топливо':U
     9519               and lookup( 'топ':U, buf_units.type ) = 0 )
     9520           then do:
     9521               assign
     9522                   p-bad-data   = yes
     9523                   p-error-text = "Топливный товар (услуга) может входить только в топливный рецепт."
     9524               .
     9525               undo, return.
     9526           end.
     9527           assign
     9528               v-ingr-count = v-ingr-count + 1
     9529           .
     9530           if buf_recipe-gds.is-waste = yes
     9531           then do:
     9532               assign
     9533                   v-waste-count = v-waste-count + 1
     9534               .
     9535           end.
     9536           assign
     9537               v-sum-gds-qnty          = v-sum-gds-qnty        + buf_recipe-gds.qnty
     9538           .
     9539       end.
     9540       if buf_recipe.recipe-type = 'разделка':U
     9541       and v-sum-gds-qnty <> ?
     9542       and v-sum-gds-qnty <> decimal( fi-recipe-qnty :screen-value in frame Dialog-Frame )
     9543       then do:
     9544           assign
     9545               p-bad-data   = yes
     9546               p-error-text = "В рецепте разделки сумма количеств ингредиентов"
     9547                           + chr(10) + "не равна количеству составного товара."
     9548           .
     9549           undo, return.
     9550       end.
     9551       if v-ingr-count = 0
     9552       then do:
     9553           assign
     9554               p-bad-data   = yes
     9555               p-error-text = "В рецепте нет ни одной строки."
     9556           .
     9557           undo, return.
     9558       end.
     9559       if buf_recipe.recipe-type = 'топливо':U
     9560       and v-ingr-count <> 1
     9561       then do:
     9562           assign
     9563               p-bad-data   = yes
     9564               p-error-text = "В топливном рецепте должна быть ровно 1 строка."
     9565           .
     9566           undo, return.
     9567       end.
     9568       if buf_recipe.recipe-type = 'разделка':U
     9569       and v-ingr-count = 1
     9570       then do:
     9571           assign
     9572               p-bad-data   = yes
     9573               p-error-text = "В рецепте разделки не может быть только 1 строка."
     9574           .
     9575           undo, return.
     9576       end.
     9577       if v-ingr-count = v-waste-count
     9578       then do:
     9579           assign
     9580               p-bad-data   = yes
     9581               p-error-text = "Рецепт не может состоять из одних отходов."
     9582           .
     9583           undo, return.
     9584       end.
     9585      if p-recipe-type = 'производство':U and v-ban-recipes then
     9586      do:
     9587         for each ub.recipe-gds no-lock where ub.recipe-gds.recipe-code = buf_recipe.recipe-code:
     9588         run gds-attr-value in this-procedure  ( input  ub.recipe-gds.gds-code
     9589            , input  'mark-type':U
     9590            , output v-attr-value
     9591            , output v-attr-type
     9592            ) no-error .
     9593         if v-attr-value <> "" and v-attr-value <> "not-type" then
     9594         do:
     9595            for first ub.goods no-lock where ub.goods.gds-code = ub.recipe-gds.gds-code:
     9596            message "Товар " + ub.goods.gds-name + " имеет тип маркировки: " + v-attr-value + " и не может быть добавлен в рецепт производства"
     9597               view-as alert-box.
     9598            end.
     9599            return error .
     9600         end.
     9601         end.
     9602      end.
     9603      if buf_recipe.recipe-type = 'альтернатива':U and v-ban-altr then
     9604      do:
     9605         if not check-ban-sales-via-cd(buf_recipe.gds-code) then do:
     9606                  message "Товар " + buf_recipe.recipe-name + " входит в группу, у которой не установлен запрет передачи на кассу."
     9607                     view-as alert-box.
     9608                  return error .
     9609         end.
     9610      end.
     9611      if buf_recipe.recipe-type = 'комплектация':U and v-ban-recipes then
     9612      do:
     9613         for each ub.recipe-gds no-lock where ub.recipe-gds.recipe-code = buf_recipe.recipe-code:
     9614            run gds-attr-value in this-procedure  ( input  ub.recipe-gds.gds-code
     9615               , input  'mark-type':U
     9616               , output v-attr-value
     9617               , output v-attr-type
     9618               ) no-error .
     9619            if v-attr-value <> "" and v-attr-value <> "not-type" then
     9620            do:
     9621               if v-attr-value <> "milk" then
     9622               do:
     9623                  for first ub.goods no-lock where ub.goods.gds-code = ub.recipe-gds.gds-code:
     9624                     message "Товар " + ub.goods.gds-name + " не является молочным продуктом"
     9625                        view-as alert-box.
     9626                  end.
     9627                  return error .
     9628               end.
     9629               run gds-attr-value in this-procedure  ( input  buf_recipe.gds-code
     9630                  , input  'mark-type':U
     9631                  , output v-attr-value-rec
     9632                  , output v-attr-type
     9633                  ) no-error .
     9634               if v-attr-value-rec = "" or v-attr-value-rec = "not-type" then
     9635               do:
     9636                  message "Рецепт комплектации" + buf_recipe.recipe-code + " " + buf_recipe.recipe-name + " не маркирован"
     9637                     view-as alert-box.
     9638                    return error.
     9639               end.
     9640               else do:
     9641                  if v-attr-value <> v-attr-value-rec then do:
     9642                  message "Рецепт комплектации" + buf_recipe.recipe-code + " " + buf_recipe.recipe-name + " маркирован типом " + v-attr-value-rec
     9643                     view-as alert-box.
     9644                    return error.
     9645                  end.
     9646               end.
     9647            end.
     9648         end.
     9649      end.
     9650         end.
     9651   END PROCEDURE.
     9652   PROCEDURE create-new-recipe :
     9653   do
     9654   on error undo, return error
     9655   :
     9656   define input parameter p-gds-name   as character    no-undo.
     9657   define input parameter p-gds-code   as integer      no-undo.
     9658   define input parameter p-artic      as character    no-undo.
     9659   define input parameter p-prod-type  as character    no-undo.
     9660   define input parameter p-prod-code  as integer      no-undo.
     9661   define buffer buf_recipe        for recipe.
     9662       create buf_recipe .
     9663       assign
     9664           buf_recipe.recipe-type         = p-recipe-type
     9665           buf_recipe.recipe-name         = p-gds-name
     9666           buf_recipe.qnty                = 1.0
     9667           buf_recipe.portion-qnty        = 1
     9668           buf_recipe.gds-code            = p-gds-code
     9669           buf_recipe.artic               = p-artic
     9670           buf_recipe.prod-type           = p-prod-type
     9671           buf_recipe.prod-code           = p-prod-code
     9672           buf_recipe.host-code           = p-host-code
     9673           buf_recipe.obj-type            = p-store-type
     9674           buf_recipe.obj-code            = p-store-code
     9675           buf_recipe.recipe-design       = ""
     9676           buf_recipe.recipe-order        = 0
     9677           buf_recipe.recipe-quality      = ""
     9678           buf_recipe.recipe-ref-num      = ""
     9679           buf_recipe.recipe-technique    = ""
     9680           buf_recipe.recipe-template     = ""
     9681       .
     9682       run fbrcode-gen-recipe-code in this-procedure (
     9683             input p-store-type
     9684           , input p-store-code
     9685           , output buf_recipe.recipe-code
     9686       ).
     9687       assign
     9688           p-out-recipe-code                   = buf_recipe.recipe-code
     9689           p-in-recipe-code                    = buf_recipe.recipe-code
     9690       .
     9691       run fbrlib-recipe-set-default in this-procedure (
     9692           input buf_recipe.recipe-code
     9693       ).
     9694   end.
     9695   END PROCEDURE.
     9696   PROCEDURE disable_UI :
     9697     HIDE FRAME Dialog-Frame.
     9698   END PROCEDURE.
     9699   PROCEDURE enable_UI :
     9700     DISPLAY fi-recipe-name tb-global fi-recipe-qnty fi-init-units
     9701             fi-recipe-ref-num fi-portion-qnty fi-recipe-technique-label
     9702             fi-portion-weight ed-recipe-technique br-table-label v-fat v-protein
     9703             v-calories v-carbohydrate
     9704         WITH FRAME Dialog-Frame.
     9705     ENABLE b-close b-cancel b-gds b-hst b-rcp b-additional b-recipe-develop
     9706            b-print b-help fi-recipe-name fi-recipe-qnty fi-recipe-ref-num
     9707            fi-portion-qnty fi-portion-weight ed-recipe-technique b-change b-up
     9708            b-down br-table v-fat v-protein v-calories v-carbohydrate
     9709         WITH FRAME Dialog-Frame.
     9710     VIEW FRAME Dialog-Frame.
     9711     OPEN QUERY br-table FOR EACH ub.recipe-gds       WHERE recipe-gds.recipe-code = buf_init_recipe.recipe-code NO-LOCK     BY ub.recipe-gds.proc-number.
     9712   END PROCEDURE.
     9713   PROCEDURE get-goods-recid :
     9714       define buffer buf_goods     for goods.
     9715   do
     9716   on error undo, return error
     9717   :
     9718       assign
     9719           gds-rec = ?
     9720       .
     9721       if available recipe-gds
     9722       then do:
     9723           find first buf_goods no-lock
     9724                where buf_goods.artic      = recipe-gds.artic
     9725                  and buf_goods.prod-type  = recipe-gds.prod-type
     9726                  and buf_goods.prod-code  = recipe-gds.prod-code
     9727           no-error.
     9728           if available buf_goods
     9729           then do:
     9730               assign
     9731                   gds-rec = recid( buf_goods )
     9732               .
     9733           end.
     9734       end.
     9735   end.
     9736   END PROCEDURE.
     9737   PROCEDURE get-have-recipe :
     9738   define input parameter p-artic          as character  no-undo.
     9739   define input parameter p-prod-type      as character  no-undo.
     9740   define input parameter p-prod-code      as integer    no-undo.
     9741   define output parameter p-have-recipe   as logical    no-undo.
     9742       define buffer buf_recipe        for recipe.
     9743   do
     9744   on error undo, return error
     9745   :
     9746       find first buf_recipe no-lock
     9747            where buf_recipe.obj-type  = ""
     9748              and buf_recipe.obj-code  = 0
     9749              and buf_recipe.artic     = p-artic
     9750              and buf_recipe.prod-type = p-prod-type
     9751              and buf_recipe.prod-code = p-prod-code
     9752       no-error.
     9753       if available buf_recipe
     9754       then do:
     9755           assign
     9756               p-have-recipe = yes
     9757           .
     9758       end.
     9759       else do:
     9760           find first buf_recipe no-lock
     9761                where buf_recipe.obj-type  = p-store-type
     9762                  and buf_recipe.obj-code  = p-store-code
     9763                  and buf_recipe.artic     = p-artic
     9764                  and buf_recipe.prod-type = p-prod-type
     9765                  and buf_recipe.prod-code = p-prod-code
     9766           no-error.
     9767           if available buf_recipe
     9768           then do:
     9769               assign
     9770                   p-have-recipe = yes
     9771               .
     9772           end.
     9773           else do:
     9774               assign
     9775                   p-have-recipe = no
     9776               .
     9777           end.
     9778       end.
     9779   end.
     9780   END PROCEDURE.
     9781   PROCEDURE get-incorrect-nutrition-goods :
     9782     define input  parameter p-mainmenu-handle   as widget-handle  no-undo .
     9783     define input  parameter p-parent-handle     as widget-handle  no-undo .
     9784     define input  parameter p-log-handle        as handle         no-undo .
     9785     define input  parameter p-parameter-string  as character      no-undo .
     9786     define buffer buf_goods       for ub.goods.
     9787     define buffer buf_recipe-gds  for ub.recipe-gds.
     9788     define variable v-calories      as decimal   no-undo .
     9789     define variable v-protein       as decimal   no-undo .
     9790     define variable v-carbohydrate  as decimal   no-undo .
     9791     define variable v-fat           as decimal   no-undo .
     9792   do
     9793   on error undo, return error return-value
     9794   :
     9795     run write-log in p-log-handle ( input 0
     9796                                   , input 'Поиск товаров с неполными данными пищевой и энергетической ценности...':U + chr(10)
     9797                                   ).
     9798     for each buf_recipe-gds no-lock
     9799       where buf_recipe-gds.recipe-code = buf_init_recipe.recipe-code
     9800     , first buf_goods no-lock
     9801         where buf_goods.gds-code = buf_recipe-gds.gds-code
     9802     :
     9803       run nutro_get-nutrition-info in this-procedure ( input  buf_recipe-gds.artic
     9804                                                      , input  buf_recipe-gds.prod-type
     9805                                                      , input  buf_recipe-gds.prod-code
     9806                                                      , input  v-cntxt-obj-type
     9807                                                      , input  v-cntxt-obj-code
     9808                                                      , output v-calories
     9809                                                      , output v-protein
     9810                                                      , output v-carbohydrate
     9811                                                      , output v-fat
     9812                                                      ).
     9813       if  v-calories      = ? or
     9814           v-protein       = ? or
     9815           v-carbohydrate  = ? or
     9816           v-fat           = ?
     9817       then do:
     9818           run write-log in p-log-handle ( input 0
     9819                                         , input substitute("&1 &2 &3 - &4"
     9820                                                           , buf_goods.artic
     9821                                                           , buf_goods.prod-type
     9822                                                           , buf_goods.prod-code
     9823                                                           , buf_goods.gds-name
     9824                                                           )
     9825                                         ).
     9826       end.
     9827     end.
     9828     run write-log in p-log-handle ( input 0
     9829                                   , input chr(10) + 'Поиск товаров завершен.':U
     9830                                   ).
     9831   end.
     9832   END PROCEDURE.
     9833   PROCEDURE get-obj-name :
     9834   do
     9835   on error undo, return error
     9836   :
     9837   define input parameter p-obj-type as character no-undo.
     9838   define input parameter p-obj-code as integer no-undo.
     9839   define output parameter p-obj-name as character no-undo.
     9840       define buffer buf_clients for clients.
     9841       find first buf_clients no-lock
     9842            where buf_clients.obj-type = p-obj-type
     9843              and buf_clients.obj-code = p-obj-code
     9844       no-error.
     9845       if available buf_clients
     9846       then do:
     9847           assign
     9848               p-obj-name = buf_clients.obj-name
     9849           .
     9850       end.
     9851       else do:
     9852           assign
     9853               p-obj-name = ""
     9854           .
     9855       end.
     9856   end.
     9857   END PROCEDURE.
     9858   PROCEDURE init-fields :
     9859   do
     9860   on error undo, return error
     9861   :
     9862       assign
     9863           fi-recipe-name          = buf_init_recipe.recipe-name
     9864           fi-recipe-qnty          = buf_init_recipe.qnty
     9865           fi-portion-qnty         = buf_init_recipe.portion-qnty
     9866           fi-portion-weight       = buf_init_recipe.portion-weight
     9867           fi-recipe-ref-num       = buf_init_recipe.recipe-ref-num
     9868           ed-recipe-technique     = buf_init_recipe.recipe-technique
     9869       .
     9870       if  buf_init_recipe.host-code = 0
     9871       and buf_init_recipe.obj-type = ""
     9872       and buf_init_recipe.obj-code = 0
     9873       then do:
     9874           assign
     9875               tb-global = yes
     9876           .
     9877       end.
     9878       else do:
     9879           assign
     9880               tb-global = no
     9881           .
     9882       end.
     9883   define variable vss-include-info73 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9884   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     9885     (input  v-cntxt-obj-type
     9886     ,input  v-cntxt-obj-code
     9887     ,output v-obj-date
     9888     ) no-error .
     9889   end.
     9890   END PROCEDURE.
     9891   PROCEDURE print-recipe :
     9892    do
     9893    on error undo, return error return-value
     9894    :
     9895       define variable sym1          as character init ":"   no-undo.
     9896       define variable sym2          as character init ":"   no-undo.
     9897       define variable sym3          as character init ":"   no-undo.
     9898       define variable sym4          as character init ":"   no-undo.
     9899       define variable sym5          as character init ":"   no-undo.
     9900       define variable sym6          as character init ":"   no-undo.
     9901       define variable sym7          as character init ":"   no-undo.
     9902       define variable sym8          as character init ":"   no-undo.
     9903       define variable Line          as character            no-undo.
     9904       define variable prod-attr     as character            no-undo.
     9905       define variable ii            as integer              no-undo.
     9906       define variable StartRecid    as recid                no-undo.
     9907       DEFINE FRAME List
     9908           sym1 column-label ":" format "x(1)" space(0)
     9909           recipe-gds.artic column-label "Артикул" format "X(16)" space(0)
     9910           sym2 column-label ":" format "x(1)" space(0)
     9911           goods.gds-name COLUMN-LABEL "Название товара" FORMAT "X(40)" space(0)
     9912           sym3 column-label ":" format "x(1)" space(0)
     9913           recipe-gds.qnty column-label "Количество     " format "->>,>>>,>>9.<<<" space(0)
     9914           sym4 column-label ":" format "x(1)" space(0)
     9915           goods.unit-base column-label "Ед.Изм." format "X(7)" space(0)
     9916           sym5 column-label ":" format "x(1)" space(0)
     9917           recipe-gds.is-waste COLUMN-LABEL "Отходы" FORMAT "+/" space(0)
     9918           sym6 column-label ":" format "x(1)" space(0)
     9919           prod-attr COLUMN-LABEL "Производитель" format "x(13)" space(0)
     9920           sym7 column-label ":" format "x(1)" space(0)
     9921           clients.obj-name COLUMN-LABEL "Наименование производителя" FORMAT "X(30)" space(0)
     9922           sym8 column-label ":" format "x(1)" space(0)
     9923           HEADER
     9924               cur-time-print() AT 5 format "X(35)"
     9925                   string( "Страница " + string( PAGE-NUMBER( ListStream ) , ">>9") )
     9926                       AT 116 format "X(15)" SKIP
     9927               Line format "x(135)" AT 1
     9928           with width 160 down use-text stream-io no-box .
     9929       if num-results( "br-table" ) = 0 then
     9930           do:
     9931               message "Список  П У С Т !" skip view-as alert-box information .
     9932               return no-apply .
     9933           end.
     9934   if session :set-wait-state( "compiler" ) then.
     9935       Line = fill( "-" , 150 ) .
     9936       StartRecid = recid( recipe-gds ) .
     9937       DO WHILE available recipe-gds :
     9938           GET prev br-table NO-LOCK .
     9939       END.
     9940       GET next br-table NO-LOCK .
     9941       ii = 1 .
     9942   output stream ListStream to value( string( session:temp-directory +
     9943                                        "rpt" + string( g#report-num ) ) )
     9944                                        page-size 62 .
     9945       FORM HEADER
     9946                   Line format "X(135)" SKIP
     9947                   "Продолжение - на следующей странице" AT 30 SKIP
     9948                   with FRAME CliBottomFrame width 160 PAGE-BOTTOM NO-LABELS no-box.
     9949       VIEW stream ListStream FRAME CliBottomFrame .
     9950       FIND first goods NO-LOCK
     9951            WHERE goods.prod-type = buf_init_recipe.prod-type
     9952              AND goods.prod-code = buf_init_recipe.prod-code
     9953              AND goods.artic     = buf_init_recipe.artic
     9954       .
     9955       PUT stream ListStream
     9956           space(10) string( "Р Е Ц Е П Т: "  + trim( buf_init_recipe.recipe-name) + " (артикул: " + trim(buf_init_recipe.artic) + ")" ) format "X(100)" skip
     9957           space(10) string( "Д Л Я   Т О В А Р А: " + trim(goods.gds-name) ) format "X(100)" skip(1)
     9958           space(30) string( "Количество : " + string( buf_init_recipe.qnty ) ) format "X(80)" SKIP(1) .
     9959       FORM with frame List .
     9960       DO WHILE available recipe-gds :
     9961           FIND goods WHERE goods.prod-type = recipe-gds.prod-type AND
     9962                            goods.prod-code = recipe-gds.prod-code AND
     9963                            goods.artic = recipe-gds.artic NO-LOCK .
     9964           FIND clients WHERE clients.obj-type = recipe-gds.prod-type AND
     9965                              clients.obj-code = recipe-gds.prod-code NO-LOCK .
     9966           DISPLAY stream ListStream
     9967                           sym1 recipe-gds.artic
     9968                           sym2 goods.gds-name
     9969                           sym3 recipe-gds.qnty
     9970                           sym4 goods.unit-base
     9971                           sym5 recipe-gds.is-waste
     9972                           sym6 recipe-gds.prod-type + " " + STRING (recipe-gds.prod-code) @ prod-attr
     9973                           sym7 clients.obj-name
     9974                           sym8    with frame List .
     9975           DOWN stream ListStream 1 with frame List .
     9976           ii =  ii + 1 .
     9977           GET next br-table .
     9978       END.
     9979       PUT stream ListStream Line format "X(135)" SKIP.
     9980       HIDE stream ListStream FRAME CliBottomFrame .
     9981       output stream ListStream close .
     9982   if session :set-wait-state( "" ) then.
     9983       define variable v-user-action           as character            no-undo.
     9984       define variable v-printed               as logical              no-undo.
     9985       run gbl/prnfilen.w (
     9986             input "":U
     9987           , input 0
     9988           , input string( session :temp-directory ) + "rpt" + string( g#report-num )
     9989           , input 7
     9990           , output v-user-action
     9991           , output v-printed
     9992       ) .
     9993       reposition br-table to recid StartRecid .
     9994     end.
     9995   END PROCEDURE.
     9996   PROCEDURE proc-leave-ed-recipe-technique :
     9997   do
     9998   on error undo, return error return-value
     9999   :
    10000     do with frame Dialog-Frame:
    10001       assign
    10002         ed-recipe-technique
    10003       .
    10004     end.
    10005   end.
    10006   END PROCEDURE.
    10007   PROCEDURE ui-on :
    10008   do
    10009   on error undo, return error
    10010   :
    10011       run calc-and-display-nutrition-info in this-procedure .
    10012       case p-mode
    10013       :
    10014           when 'ПРОСМОТР':U
    10015           then do:
    10016               disable
    10017                   fi-recipe-name
    10018                   fi-recipe-qnty
    10019                   fi-portion-qnty
    10020                   fi-portion-weight
    10021                   fi-recipe-ref-num
    10022                   b-cancel
    10023                   b-gds
    10024                   b-hst
    10025                   b-up
    10026                   b-down
    10027                   tb-global
    10028                   b-change
    10029               with frame Dialog-Frame .
    10030               assign
    10031                   fi-recipe-name         :fgcolor = 4
    10032                   fi-recipe-qnty         :fgcolor = 4
    10033                   fi-portion-qnty        :fgcolor = 4
    10034                   fi-portion-weight      :fgcolor = 4
    10035                   fi-recipe-ref-num      :fgcolor = 4
    10036                   ed-recipe-technique    :fgcolor = 4
    10037                   ed-recipe-technique    :read-only in frame Dialog-Frame = yes
    10038               .
    10039           end.
    10040           otherwise do:
    10041               if tb-global = no
    10042               and p-can-set-global = yes
    10043               then do:
    10044                   define variable v-par-value     as character      no-undo.
    10045                   define variable v-par-type      as character      no-undo.
    10046   define variable vss-include-info74 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10047   do:
    10048     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    10049       (input  v-cntxt-db-num
    10050       ,input  v-cntxt-userid
    10051       ,input  0
    10052       ,input  'actn_recipe-reference_conjoint':U
    10053       ,input  'global':U
    10054       ,input  0
    10055       ,input  '':U
    10056       ,input  0
    10057       ,input  0
    10058       ,input  0
    10059       ,input  0
    10060       ,input  yes
    10061       ,output p-can-set-global
    10062       )  .
    10063   end.
    10064                  define variable v-value-character as character  no-undo .
    10065                  define variable v-value-date      as date       no-undo .
    10066                  define variable v-value-decimal   as decimal    no-undo .
    10067                  define variable v-value-integer   as integer    no-undo .
    10068                  define variable v-value-logical   as logical    no-undo .
    10069                  define variable v-tth             as handle     no-undo .
    10070                  define variable v-param-type            as character no-undo .
    10071                  run adm/shattri.p ( input "get":U
    10072                                    , input  '':u
    10073                                    , input  0
    10074                                    , input  'fbrattr':U
    10075                                    , input  'fbrrcpgb':U
    10076                                    , output v-value-character
    10077                                    , output v-value-date
    10078                                    , output v-value-decimal
    10079                                    , output v-value-integer
    10080                                    , output v-value-logical
    10081                                    , output v-param-type
    10082                                    , input-output table-handle v-tth
    10083                                    ) no-error .
    10084                  if error-status :error then do:
    10085                     assign
    10086                        v-value-logical = FALSE
    10087                     .
    10088                  end.
    10089                   if error-status :error
    10090                   or not v-value-logical
    10091                   then do:
    10092                       assign
    10093                           p-can-set-global = no
    10094                       .
    10095                   end.
    10096                   if p-can-set-global = yes
    10097                   then do:
    10098                       enable
    10099                           tb-global
    10100                       with frame Dialog-Frame .
    10101                   end.
    10102               end.
    10103           end.
    10104       end case.
    10105       if buf_init_recipe.recipe-type = 'производство':U
    10106       then do:
    10107           if lookup( 'шту':U, buf_init_units.type ) > 0
    10108           then do:
    10109               assign
    10110                   fi-portion-qnty = fi-recipe-qnty
    10111               .
    10112               disable
    10113                   fi-portion-qnty
    10114               with frame Dialog-Frame .
    10115               if p-mode <> 'ПРОСМОТР':U
    10116               then do:
    10117                   enable
    10118                       fi-portion-weight
    10119                   with frame Dialog-Frame .
    10120               end.
    10121           end.
    10122           else do:
    10123               assign
    10124                   fi-portion-weight = fi-recipe-qnty / fi-portion-qnty
    10125               .
    10126               if p-mode <> 'ПРОСМОТР':U
    10127               then do:
    10128                   enable
    10129                       fi-portion-qnty
    10130                   with frame Dialog-Frame .
    10131               end.
    10132               disable
    10133                   fi-portion-weight
    10134               with frame Dialog-Frame .
    10135           end.
    10136           display
    10137               fi-portion-qnty
    10138               fi-portion-weight
    10139           with frame Dialog-Frame .
    10140       end.
    10141       else do:
    10142           assign
    10143               fi-portion-qnty = 1
    10144           .
    10145           hide
    10146               fi-portion-qnty
    10147               fi-portion-weight
    10148           in frame Dialog-Frame .
    10149       end.
    10150   end.
    10151   END PROCEDURE.
    10152   FUNCTION get-browse-field RETURNS CHARACTER
    10153     ( input p-parameter-number as integer, input p-artic as character, input p-prod-type as character, input p-prod-code as integer ) :
    10154       define variable v-is-goods      as logical no-undo.
    10155       define variable v-output-string as character no-undo.
    10156       define variable v-gds-code      as integer no-undo.
    10157       define variable v-have-recipe   as logical    no-undo.
    10158       if p-parameter-number = 1
    10159       then do:
    10160   define variable vss-include-info75 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10161   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
    10162     (input  p-artic
    10163     ,input  p-prod-type
    10164     ,input  p-prod-code
    10165     ,input  'gds-goods=request':u
    10166     ,output v-is-goods
    10167     )  .
    10168           assign
    10169               v-output-string = ( if v-is-goods = yes then "-":U else "+":U )
    10170           .
    10171       end.
    10172       if p-parameter-number = 2
    10173       then do:
    10174   define variable vss-include-info76 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10175   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
    10176     (input  p-artic
    10177     ,input  p-prod-type
    10178     ,input  p-prod-code
    10179     ,output v-output-string
    10180     )  .
    10181       end.
    10182       if p-parameter-number = 3
    10183       then do:
    10184   define variable vss-include-info77 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10185   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
    10186     (input  p-artic
    10187     ,input  p-prod-type
    10188     ,input  p-prod-code
    10189     ,output v-gds-code
    10190     )  .
    10191   define variable vss-include-info78 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10192   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
    10193     (input  v-gds-code
    10194     ,output v-output-string
    10195     )  .
    10196       end.
    10197       if p-parameter-number = 4
    10198       then do:
    10199           run get-obj-name in this-procedure (
    10200                 input p-prod-type
    10201               , input p-prod-code
    10202               , output v-output-string
    10203           ).
    10204       end.
    10205       if p-parameter-number = 5
    10206       then do:
    10207           assign
    10208               v-have-recipe = no
    10209           .
    10210   define variable vss-include-info79 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10211   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
    10212     (input  p-artic
    10213     ,input  p-prod-type
    10214     ,input  p-prod-code
    10215     ,input  'gds-goods=request':u
    10216     ,output v-is-goods
    10217     )  .
    10218           if v-is-goods = yes
    10219           then do:
    10220               run get-have-recipe in this-procedure (
    10221                     input p-artic
    10222                   , input p-prod-type
    10223                   , input p-prod-code
    10224                   , output v-have-recipe
    10225               ).
    10226           end.
    10227           assign
