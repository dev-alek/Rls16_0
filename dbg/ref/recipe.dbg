    10229           .
    10230       end.
    10231       RETURN v-output-string.
    10232   END FUNCTION.
    10233   FUNCTION get-brutto-qnty RETURNS DECIMAL
    10234     ( buffer buf_recipe-gds for ub.recipe-gds ) :
    10235     RETURN buf_recipe-gds.qnty * ( 1 + buf_recipe-gds.coeff-waste ) .
    10236   END FUNCTION.
    10237   FUNCTION get-brutto-qnty-season RETURNS DECIMAL
    10238     ( buffer buf_recipe-gds for ub.recipe-gds ) :
    10239       define variable v-void-decimal      as decimal      no-undo.
    10240       define variable v-season-procent    as decimal      no-undo.
    10241       define variable v-void-integer      as integer      no-undo.
    10242       define variable v-brutto            as decimal      no-undo.
    10243       define buffer buf_goods for ub.goods.
    10244       find first buf_goods
    10245            where buf_goods.artic = buf_recipe-gds.artic
    10246              and buf_goods.prod-type = buf_recipe-gds.prod-type
    10247              and buf_goods.prod-code = buf_recipe-gds.prod-code
    10248       no-lock.
    10249       run fbrlib-s-coeff-value in this-procedure (
    10250             input buf_goods.gds-code
    10251           , input v-obj-date
    10252           , input v-cntxt-obj-type
    10253           , input v-cntxt-obj-code
    10254           , output v-season-procent
    10255       ).
    10256       run fbrlib-calc-brutto in this-procedure (
    10257             input p-recipe-type
    10258           , input buf_recipe-gds.qnty
    10259           , input v-season-procent
    10260           , input buf_recipe-gds.coeff-waste
    10261           , input 0.0
    10262           , input 3
    10263           , output v-void-decimal
    10264           , output v-void-decimal
    10265           , output v-brutto
    10266           , output v-void-integer
    10267       ).
    10268       RETURN
    10269           v-brutto
    10270       .
    10271   END FUNCTION.
    10272   FUNCTION get-season-procent RETURNS DECIMAL
    10273   ( buffer buf_recipe-gds for ub.recipe-gds ) :
    10274       define variable v-coeff as decimal no-undo.
    10275       define buffer buf_goods for ub.goods.
    10276       find first buf_goods
    10277            where buf_goods.artic      = buf_recipe-gds.artic
    10278              and buf_goods.prod-type  = buf_recipe-gds.prod-type
    10279              and buf_goods.prod-code  = buf_recipe-gds.prod-code
    10280       no-lock.
    10281       run fbrlib-s-coeff-value in this-procedure (
    10282             input buf_goods.gds-code
    10283           , input v-obj-date
    10284           , input v-cntxt-obj-type
    10285           , input v-cntxt-obj-code
    10286           , output v-coeff
    10287       ).
    10288       RETURN v-coeff.
    10289   END FUNCTION.
