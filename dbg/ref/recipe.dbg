     5731   procedure nutro_proc-get-carbohydrate :
     5732     define input  parameter p-artic         as character no-undo .
     5733     define input  parameter p-prod-type     as character no-undo .
     5734     define input  parameter p-prod-code     as integer   no-undo .
     5735     define input  parameter p-obj-type      as character no-undo .
     5736     define input  parameter p-obj-code      as integer   no-undo .
     5737     define output parameter p-carbohydrate  as decimal   no-undo .
     5738     define buffer buf_goods    for ub.goods .
     5739     define variable v-attr-value   as character no-undo .
     5740     define variable v-attr-type    as character no-undo .
     5741     define variable v-calories     as decimal   no-undo .
     5742     define variable v-protein      as decimal   no-undo .
     5743     define variable v-carbohydrate as decimal   no-undo .
     5744     define variable v-fat          as decimal   no-undo .
