     5490   procedure grp-obj-notcorr-value :
     5491   do
     5492   on error undo, return error
     5493   :
     5494   define input parameter p-node-code             as integer      no-undo.
     5495   define input parameter p-obj-type              as character    no-undo.
     5496   define input parameter p-obj-code              as integer      no-undo.
     5497   define output parameter p-notcorr              as character    no-undo init ?.
     5498   define output parameter p-range-notcorr     as integer      no-undo.
     5499   define output parameter p-exists-notcorr    as logical      no-undo.
     5500   define variable v-host-code as integer      no-undo.
     5501   DEFINE VARIABLE v-found as logical no-undo .
     5502   DEFINE VARIABLE v-exists as logical no-undo .
     5503   DEFINE VARIABLE v-range as integer no-undo .
     5504   DEFINE VARIABLE jj as integer no-undo .
     5505   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     5506   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     5507   define buffer buf_gds-grp for ub.gds-grp.
     5508   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     5509   find first buf_gds-grp no-lock where
     5510              buf_gds-grp.node-code = p-node-code no-error .
     5511   if not avail buf_gds-grp and p-node-code <> 0 then do:
     5512     message
     5513       vss-workfile vss-revision vss-description
     5514       skip "Не удалось найти группу товаров с кодом" p-node-code
     5515       view-as alert-box error .
     5516     undo, return error .
     5517   end.
     5518   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5519   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     5520     (input  p-obj-type
     5521     ,input  p-obj-code
     5522     ,output v-host-code
     5523     ) no-error .
     5524   if error-status :error
     5525   then do:
     5526       message
     5527         vss-workfile vss-revision vss-description
     5528         skip "Не удалось найти фирму объекта"
     5529         skip p-obj-type p-obj-code
     5530         skip return-value
     5531         skip trim(error-status :get-message(1))
     5532       view-as alert-box error.
     5533       undo, return error .
     5534   end.
     5535   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     5536   do while v-found = no and jj < 2:
     5537     if v-range <> 3 then do:
     5538       find first buf_gds-grp-obj no-lock
     5539           where buf_gds-grp-obj.node-code = p-node-code
     5540             and buf_gds-grp-obj.host-code = v-host-code
     5541             and buf_gds-grp-obj.obj-type  = p-obj-type
     5542             and buf_gds-grp-obj.obj-code  = p-obj-code
     5543       no-error .
     5544     end.
     5545     if v-range = 3 or not available buf_gds-grp-obj
     5546     then do:
     5547        if v-range <> 2 then do:
     5548           find first buf_gds-grp-obj no-lock
     5549               where buf_gds-grp-obj.node-code = p-node-code
     5550                 and buf_gds-grp-obj.host-code = v-host-code
     5551                 and buf_gds-grp-obj.obj-type  = ""
     5552                 and buf_gds-grp-obj.obj-code  = 0
     5553           no-error .
     5554         end.
     5555         if v-range = 2 or not available buf_gds-grp-obj
     5556         then do:
     5557             if v-range <> 1 then do:
     5558               find first buf_gds-grp-obj no-lock
     5559                   where buf_gds-grp-obj.node-code = p-node-code
     5560                   and buf_gds-grp-obj.host-code = 0
     5561                   and buf_gds-grp-obj.obj-type  = ""
     5562                   and buf_gds-grp-obj.obj-code  = 0
     5563               no-error .
     5564             end.
     5565             if v-range = 1 or not available buf_gds-grp-obj
     5566             then do:
     5567                 assign
     5568                     v-exists = no
     5569                 .
     5570             end.
     5571             else do:
     5572                 assign
     5573                     v-exists = yes
     5574                     v-range = 1
     5575                 .
     5576             end.
     5577         end.
     5578         else do:
     5579             assign
     5580                 v-exists = yes
     5581                 v-range  = 2
     5582             .
     5583         end.
     5584     end.
     5585     else do:
     5586         assign
     5587             v-exists = yes
     5588             v-range  = 3
     5589         .
     5590     end.
     5591     if available buf_gds-grp-obj
     5592     then do:
     5593       find first buf_gds-grp-obj-attr no-lock
     5594         where buf_gds-grp-obj-attr.node-code   = p-node-code
     5595           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     5596           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     5597           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     5598           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     5599         no-error .
     5600       if available buf_gds-grp-obj-attr then do:
     5601         assign
     5602           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     5603         .
     5604       end.
     5605       else do:
     5606         assign
     5607           v-notcorr-value = ?
     5608         .
     5609       end.
     5610       assign
     5611       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     5612                           then yes
     5613                           else p-exists-notcorr)
     5614       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     5615                         then v-range
     5616                         else p-range-notcorr
     5617       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     5618                         then v-notcorr-value
     5619                         else p-notcorr
     5620       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     5621       jj = jj + 1
     5622       .
     5623     end.
     5624     else do:
     5625       assign
     5626       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     5627       jj = jj + 1
     5628       .
     5629     end.
     5630   end.
     5631   end.
     5632   end procedure.
     5633   define variable vss-include-info41 as character format "X(65)" no-undo
