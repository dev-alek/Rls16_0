      129   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130   procedure cur-time :
      131      define output parameter p-today as date      no-undo .
      132      define output parameter p-time  as integer   no-undo .
      133     do
      134     on error undo, return error
      135     :
      136       define variable v-date1 as date      no-undo .
      137       define variable v-date2 as date      no-undo .
      138       define variable v-time  as integer   no-undo .
      139       assign
      140         v-date1 = today
      141         v-time  = time
      142         v-date2 = today
      143       .
      144       if v-date1 <> v-date2
      145       then do:
      146         assign
      147           v-date1 = today
      148           v-time  = v-time
      149         .
      150       end.
      151       assign
      152         p-today = v-date1
      153         p-time  = v-time
      154       .
      155     end.
      156   end.
      157   function cur-time-date returns character
      158   :
      159     return string(today, '99/99/9999':U) .
      160   end.
      161   function cur-time-mjd returns decimal
      162   :
      163     define variable v-date as date      no-undo .
      164     define variable v-time as integer   no-undo .
      165     run cur-time in this-procedure
      166       (output v-date
      167       ,output v-time
      168       ) .
      169     return integer(v-date) - 2400002 + (v-time / 86400) .
      170   end.
      171   function cur-time-get-ending-index returns integer
      172   (input p-number as integer
      173   )
      174   :
      175     if p-number < 0
      176     or p-number = ?
      177     then do:
      178       return 1 .
      179     end.
      180     define variable v-rest as integer   no-undo .
      181     assign
      182       p-number = p-number modulo 100
      183     .
      184     if p-number < 20
      185     then do:
      186       assign
      187         v-rest = p-number
      188       .
      189     end.
      190     else do:
      191       assign
      192         v-rest = p-number modulo 10
      193       .
      194     end.
      195     case v-rest :
      196       when 1
      197       then do:
      198         return 2 .
      199       end.
      200       when 2 or
      201       when 3 or
      202       when 4
      203       then do:
      204         return 3 .
      205       end.
      206       otherwise do:
      207         return 1 .
      208       end.
      209     end case .
      210   end.
      211   procedure cur-time-mjd-to-date :
      212      define input  parameter i-mjd-diff as decimal no-undo.
      213      define output parameter o-Date     as date    no-undo.
      214      define output parameter o-Time     as integer no-undo.
      215      define variable v-day-number as integer   no-undo .
      216      if    i-mjd-diff < 0
      217         or i-mjd-diff = ?
      218      then do:
      219         return "?" .
      220      end.
      221      assign
      222         v-day-number = truncate(i-mjd-diff,0).
      223         o-Date = date(v-day-number + 2400002).
      224         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      225     .
      226   end.
      227   function cur-time-mjd-to-string returns character
      228   (input p-mjd-diff as decimal
      229   )
      230   :
      231     define variable v-day-number as integer   no-undo .
      232     define variable v-seconds    as integer   no-undo .
      233     define variable v-hour       as integer   no-undo .
      234     define variable v-min        as integer   no-undo .
      235     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      236     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      237     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      238     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      239     if p-mjd-diff < 0
      240     or p-mjd-diff = ?
      241     then do:
      242       return "?" .
      243     end.
      244     assign
      245       v-day-number = integer(truncate(p-mjd-diff,0))
      246       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      247     .
      248     if v-seconds > 86400
      249     then do:
      250       assign
      251         v-seconds = 86400 - 1
      252       .
      253     end.
      254     if v-seconds < 0
      255     then do:
      256       assign
      257         v-seconds = 0
      258       .
      259     end.
      260     assign
      261       v-hour = truncate(v-seconds / 3600, 0)
      262     .
      263     assign
      264       v-seconds = v-seconds modulo 3600
      265     .
      266     assign
      267       v-min = truncate(v-seconds / 60, 0)
      268     .
      269     assign
      270       v-seconds = v-seconds modulo 60
      271     .
      272     return
      273         (if v-day-number <> 0
      274           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      275           else ""
      276         )
      277       + (if v-day-number <> 0 or v-hour <> 0
      278           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      279           else ""
      280         )
      281       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      282           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      283           else ""
      284         )
      285       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      286       .
      287   end.
      288   function cur-time-string returns character
      289   :
      290     define variable v-date as date      no-undo .
      291     define variable v-time as integer   no-undo .
      292     run cur-time in this-procedure
      293       (output v-date
      294       ,output v-time
      295       ) .
      296     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      297   end.
      298   function cur-time-string-sec returns character
      299   :
      300     define variable v-date as date      no-undo .
      301     define variable v-time as integer   no-undo .
      302     run cur-time in this-procedure
      303       (output v-date
      304       ,output v-time
      305       ) .
      306     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      307   end.
      308   function cur-time-custom  returns character
      309   (input p-prefix as character
      310   ,input p-date-format as character
      311   ,input p-delimiter as character
      312   ,input p-time-format as character
      313   ,input p-suffix as character
      314   )
      315   :
      316     define variable v-date as date      no-undo .
      317     define variable v-time as integer   no-undo .
      318     run cur-time in this-procedure
      319       (output v-date
      320       ,output v-time
      321       ) .
      322     return
      323       p-prefix
      324       + string(v-date, p-date-format)
      325       + p-delimiter
      326       + string(v-time, p-time-format)
      327       + p-suffix
      328       .
      329   end.
      330   function cur-time-print  returns character
      331   :
      332     define variable v-date as date      no-undo .
      333     define variable v-time as integer   no-undo .
      334     run cur-time in this-procedure
      335       (output v-date
      336       ,output v-time
      337       ) .
      338     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      339   end.
      340   function cur-time-datetime returns datetime
      341   :
      342     define variable v-char as character no-undo .
      343     define variable v-datetime as datetime no-undo .
      344     v-char = cur-time-string().
      345     v-datetime = datetime(v-char).
      346     return  v-datetime.
      347   end.
      348   function cur-time-string-msec returns character
      349   :
      350     define variable v-date as datetime  no-undo .
      351     v-date = now.
      352     return string(v-date) .
      353   end.
      354   define variable vss-include-info4 as character format "X(65)" no-undo
      355   initial "@(#)$Workfile$ $Revision$".
      356   define temp-table temp_fbrcode-doc-code no-undo
      357       field rec-type      as character
      358       field doc-code      as character
      359       field obj-type      as character
      360       field obj-code      as integer
      361       field cli-type      as character
      362       field cli-code      as integer
      363       field ext-doc-type  as character
      364       field doc-type      as character
      365       field order         as integer
      366       index pi is primary unique rec-type doc-code
      367       index od order
      368   .
      369   procedure fbrcode-gen-recipe-code :
      370   do
      371   on error undo, return error
      372   :
      373   define input parameter p-obj-type           as character    no-undo.
      374   define input parameter p-obj-code           as integer      no-undo.
      375   define output parameter p-recipe-code       as character    no-undo.
      376       assign
      377           p-recipe-code   = string( next-value( s-recipe, ub ) )
      378                               + "-"
      379                               + trim( string( p-obj-code, ">>>>9" ) )
      380                               + substring( p-obj-type, ( if g#language = "RUS" then 1 else 2 ), 1 )
      381       .
      382   end.
      383   end procedure.
      384   procedure fbrcode-is-from-object :
      385   do
      386   on error undo, return error
      387   :
      388   define input parameter p-doc-code           as character    no-undo.
      389   define input parameter p-obj-type           as character    no-undo.
      390   define input parameter p-obj-code           as integer      no-undo.
      391   define output parameter p-is-from-object    as logical      no-undo.
      392       if num-entries( p-doc-code, "-" ) < 2
      393       or entry( 2, p-doc-code, "-" ) <> trim (string (p-obj-code, ">>>>9"))
      394                                       + substring( p-obj-type, ( if g#language = "RUS" then 1 else 2 ), 1 )
      395       then do:
      396           assign
      397               p-is-from-object = no
      398           .
      399       end.
      400       else do:
      401           assign
      402               p-is-from-object = yes
      403           .
      404       end.
      405   end.
      406   end procedure.
      407   procedure fbrcode-trn-doc :
      408   do
      409   on error undo, return error
      410   :
      411       define input parameter p-out-doc-type       as character    no-undo.
      412       define input parameter p-out-code           as character    no-undo.
      413       define input parameter p-trn-doc-out-type   as character    no-undo.
      414       define output parameter p-trn-doc-doc-code  as character   no-undo.
      415       case p-out-doc-type:
      416           when 'производство':U
      417           then do:
      418               case p-trn-doc-out-type :
      419                   when 'рас':U
      420                   then do:
      421                       assign
      422                           p-trn-doc-doc-code = p-out-code
      423                       .
      424                   end.
      425                   when 'при':U
      426                   then do:
      427                       assign
      428                           p-trn-doc-doc-code = replace ( p-out-code, "-", "=" )
      429                       .
      430                   end.
      431                   when 'спи':U
      432                   then do:
      433                       assign
      434                           p-trn-doc-doc-code = replace ( p-out-code, "-", "*" )
      435                       .
      436                   end.
      437                   otherwise do:
      438                       assign
      439                           p-trn-doc-doc-code = ""
      440                       .
      441                       undo, return error "Не может быть обработан тип складского документа '"
      442                                           + p-trn-doc-out-type + "' во входных параметрах".
      443                   end.
      444               end case.
      445           end.
      446           otherwise do:
      447               assign
      448                   p-trn-doc-doc-code = ""
      449               .
      450               undo, return error "Не может быть обработан тип внешнего документа '"
      451                                   + p-out-doc-type + "' во входных параметрах".
      452           end.
      453       end case.
      454   end.
      455   end procedure.
      456   procedure fbrcode-fill-fbr-by-sale-or-pln :
      457   define input parameter p-main-doc-code      as character        no-undo.
      458       define variable v-order    as integer      no-undo.
      459       define buffer buf_fbr-doc               for ub.fbr-doc.
      460       define buffer buf_trn-doc               for ub.trn-doc.
      461       define buffer buf_temp_fbrcode-doc-code for temp_fbrcode-doc-code.
      462   do
      463   for buf_fbr-doc
      464     , buf_trn-doc
      465     , buf_temp_fbrcode-doc-code
      466   on error undo, return error
      467   :
      468       for each buf_temp_fbrcode-doc-code
      469       on error undo, return error
      470       :
      471           delete buf_temp_fbrcode-doc-code.
      472       end.
      473       assign
      474           v-order = 0
      475       .
      476       for each buf_fbr-doc no-lock
      477          where buf_fbr-doc.out-code = p-main-doc-code
      478       on error undo, return error
      479       :
      480           create buf_temp_fbrcode-doc-code.
      481           assign
      482               buf_temp_fbrcode-doc-code.rec-type      = 'производство':U
      483               buf_temp_fbrcode-doc-code.doc-code      = buf_fbr-doc.doc-code
      484               buf_temp_fbrcode-doc-code.ext-doc-type  = "":U
      485               buf_temp_fbrcode-doc-code.obj-type      = buf_fbr-doc.obj-type
      486               buf_temp_fbrcode-doc-code.obj-code      = buf_fbr-doc.obj-code
      487               buf_temp_fbrcode-doc-code.cli-type      = buf_fbr-doc.obj-type
      488               buf_temp_fbrcode-doc-code.cli-code      = buf_fbr-doc.obj-code
      489               buf_temp_fbrcode-doc-code.doc-type      = buf_fbr-doc.doc-type
      490           .
      491           for each buf_trn-doc no-lock
      492              where buf_trn-doc.out-code = buf_fbr-doc.doc-code
      493           by buf_trn-doc.fact-order
      494           on error undo, return error
      495           :
      496               if buf_trn-doc.ext-doc-type = 'em':U
      497               or buf_trn-doc.ext-doc-type = 'im':U
      498               or buf_trn-doc.ext-doc-type = 'wm':U
      499               or buf_trn-doc.ext-doc-type = 'ev':U
      500               then do:
      501                   assign
      502                       v-order = v-order + 1
      503                   .
      504                   create buf_temp_fbrcode-doc-code.
      505                   assign
      506                       buf_temp_fbrcode-doc-code.doc-code      = buf_trn-doc.doc-code
      507                       buf_temp_fbrcode-doc-code.rec-type      = 'скл':U
      508                       buf_temp_fbrcode-doc-code.ext-doc-type  = buf_trn-doc.ext-doc-type
      509                       buf_temp_fbrcode-doc-code.obj-type      = buf_trn-doc.obj-type
      510                       buf_temp_fbrcode-doc-code.obj-code      = buf_trn-doc.obj-code
      511                       buf_temp_fbrcode-doc-code.cli-type      = buf_trn-doc.cli-type
      512                       buf_temp_fbrcode-doc-code.cli-code      = buf_trn-doc.cli-code
      513                       buf_temp_fbrcode-doc-code.doc-type      = buf_trn-doc.doc-type
      514                       buf_temp_fbrcode-doc-code.order         = v-order
      515                   .
      516               end.
      517           end.
      518           assign
      519               v-order  = v-order + 1
      520           .
      521           find first buf_temp_fbrcode-doc-code
      522                where buf_temp_fbrcode-doc-code.rec-type = 'производство':U
      523                  and buf_temp_fbrcode-doc-code.doc-code = buf_fbr-doc.doc-code
      524           .
      525           assign
      526               buf_temp_fbrcode-doc-code.order = v-order
      527           .
      528       end.
      529       for each buf_trn-doc no-lock
      530          where buf_trn-doc.out-code = p-main-doc-code
      531       by buf_trn-doc.fact-order
      532       on error undo, return error
      533       :
      534           assign
      535               v-order = v-order + 1
      536           .
      537           create buf_temp_fbrcode-doc-code.
      538           assign
      539               buf_temp_fbrcode-doc-code.doc-code      = buf_trn-doc.doc-code
      540               buf_temp_fbrcode-doc-code.rec-type      = 'маг':U
      541               buf_temp_fbrcode-doc-code.ext-doc-type  = buf_trn-doc.ext-doc-type
      542               buf_temp_fbrcode-doc-code.obj-type      = buf_trn-doc.obj-type
      543               buf_temp_fbrcode-doc-code.obj-code      = buf_trn-doc.obj-code
      544               buf_temp_fbrcode-doc-code.cli-type      = buf_trn-doc.cli-type
      545               buf_temp_fbrcode-doc-code.cli-code      = buf_trn-doc.cli-code
      546               buf_temp_fbrcode-doc-code.doc-type      = buf_trn-doc.doc-type
      547               buf_temp_fbrcode-doc-code.order         = v-order
      548           .
      549       end.
      550   end.
      551   end procedure.
      552   procedure fbrcode-get-final-doc :
      553   define input parameter p-main-doc-code      as character        no-undo.
      554   define output parameter p-income-doc-code   as character        no-undo.
      555       define variable v-main-obj-type    as character    no-undo.
      556       define variable v-main-obj-code    as integer      no-undo.
      557       define buffer buf_trn-doc               for ub.trn-doc.
      558       define buffer buf_temp_fbrcode-doc-code for temp_fbrcode-doc-code.
      559   do
      560   for buf_trn-doc
      561   on error undo, return error
      562   :
      563       run fbrcode-fill-fbr-by-sale-or-pln in this-procedure (
      564           input p-main-doc-code
      565       ).
      566       find first buf_trn-doc no-lock
      567            where buf_trn-doc.doc-code = p-main-doc-code
      568       .
      569       assign
      570           v-main-obj-type = buf_trn-doc.obj-type
      571           v-main-obj-code = buf_trn-doc.obj-code
      572       .
      573       find first buf_temp_fbrcode-doc-code
      574            where buf_temp_fbrcode-doc-code.ext-doc-type = 'ev':U
      575              and buf_temp_fbrcode-doc-code.cli-type     = v-main-obj-type
      576              and buf_temp_fbrcode-doc-code.cli-code     = v-main-obj-code
      577       no-error.
      578       if available buf_temp_fbrcode-doc-code
      579       then do:
      580           find first buf_trn-doc no-lock
      581                where buf_trn-doc.out-code     = buf_temp_fbrcode-doc-code.doc-code
      582                  and buf_trn-doc.ext-doc-type = 'iv':U
      583           .
      584           assign
      585               p-income-doc-code = buf_trn-doc.doc-code
      586           .
      587       end.
      588       else do:
      589           find first buf_temp_fbrcode-doc-code
      590                where buf_temp_fbrcode-doc-code.ext-doc-type = 'im':U
      591                  and buf_temp_fbrcode-doc-code.obj-type     = v-main-obj-type
      592                  and buf_temp_fbrcode-doc-code.obj-code     = v-main-obj-code
      593           no-error.
      594           if available buf_temp_fbrcode-doc-code
      595           then do:
      596               assign
      597                   p-income-doc-code = buf_temp_fbrcode-doc-code.doc-code
      598               .
      599           end.
      600           else do:
      601               assign
      602                   p-income-doc-code = "":U
      603               .
      604           end.
      605       end.
      606   end.
      607   end procedure.
      608   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      609   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
      610   procedure partslib-clear-temp-parts :
      611     define buffer buf_temp-parts for temp-parts .
      612     do
      613     on error undo, return error
      614     :
      615       for each buf_temp-parts
      616       on error undo, return error
      617       :
      618         delete buf_temp-parts .
      619       end.
      620     end.
      621   end procedure.
      622   procedure partslib-create-temp-parts :
      623     define parameter buffer buf_parts       for ub.parts .
      624     define parameter buffer buf_temp-parts  for temp-parts .
      625     define input  parameter p-goods-twounit as logical   no-undo .
      626     define variable v-base-part-code as character no-undo .
      627     do
      628     on error undo, return error
      629     :
      630       if p-goods-twounit = true
      631       then do:
      632         assign
      633           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      634         .
      635       end.
      636       else do:
      637         assign
      638           v-base-part-code = buf_parts.part-code
      639         .
      640       end.
      641       find first buf_temp-parts exclusive-lock
      642         where buf_temp-parts.obj-type  = buf_parts.obj-type
      643           and buf_temp-parts.obj-code  = buf_parts.obj-code
      644           and buf_temp-parts.artic     = buf_parts.artic
      645           and buf_temp-parts.prod-type = buf_parts.prod-type
      646           and buf_temp-parts.prod-code = buf_parts.prod-code
      647           and buf_temp-parts.in-code   = buf_parts.in-code
      648           and buf_temp-parts.out-code  = 'free-zone':U
      649           and buf_temp-parts.part-code = v-base-part-code
      650         no-error.
      651       if not available buf_temp-parts
      652       then do:
      653         create buf_temp-parts .
      654         buffer-copy buf_parts to buf_temp-parts
      655         assign
      656           buf_temp-parts.out-code  = 'free-zone':U
      657           buf_temp-parts.part-code = v-base-part-code
      658           buf_temp-parts.rsrv-free = yes
      659           buf_temp-parts.status_   = no
      660           buf_temp-parts.qnty      = 0
      661           buf_temp-parts.fact-qnty = 0
      662           buf_temp-parts.real-qnty = 0
      663           buf_temp-parts.cli-qnty  = 0
      664         .
      665       end.
      666     end.
      667   end procedure.
      668   procedure partslib-init-temp-parts :
      669     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      670     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      671     define input parameter p-artic           like ub.parts.artic     no-undo .
      672     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      673     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      674     define buffer buf_parts      for ub.parts .
      675     define buffer buf_temp-parts for temp-parts .
      676     define variable v-goods-twounit    as logical   no-undo .
      677     do
      678     on error undo, return error
      679     :
      680   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      681   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      682     (input  p-artic
      683     ,input  p-prod-type
      684     ,input  p-prod-code
      685     ,input  'twounit=request':u
      686     ,output v-goods-twounit
      687     ) no-error .
      688       if error-status :error
      689       then do:
      690         message
      691           vss-workfile vss-revision vss-description skip
      692           vss-include-info5 skip
      693           "Ошибка при определении атрибута товара" skip
      694           "Артикул" p-artic p-prod-type p-prod-code skip
      695           "twounit=request" skip
      696           error-status :get-message(1) skip
      697           return-value skip
      698           view-as alert-box error .
      699         undo, return error return-value .
      700       end.
      701       run partslib-clear-temp-parts in this-procedure .
      702       for each buf_parts
      703         where buf_parts.obj-type  = p-obj-type
      704           and buf_parts.obj-code  = p-obj-code
      705           and buf_parts.artic     = p-artic
      706           and buf_parts.prod-type = p-prod-type
      707           and buf_parts.prod-code = p-prod-code
      708           and buf_parts.rsrv-free = yes
      709           and buf_parts.status_   = no
      710           and buf_parts.in-code   <> buf_parts.out-code
      711       on error undo, return error
      712       :
      713         run partslib-create-temp-parts in this-procedure
      714           (buffer buf_parts
      715           ,buffer buf_temp-parts
      716           ,input  v-goods-twounit
      717           ) .
      718         define variable v-parts-qnty          as decimal   no-undo .
      719         define variable v-parts-cli-qnty      as decimal   no-undo .
      720         define variable v-parts-free-qnty     as decimal   no-undo .
      721         define variable v-parts-free-cli-qnty as decimal   no-undo .
      722         if buf_parts.out-code = 'free-zone':U
      723         then do:
      724           assign
      725             v-parts-qnty          = buf_parts.qnty
      726             v-parts-cli-qnty      = buf_parts.cli-qnty
      727             v-parts-free-qnty     = buf_parts.qnty
      728             v-parts-free-cli-qnty = buf_parts.cli-qnty
      729           .
      730         end.
      731         else do:
      732           assign
      733             v-parts-qnty          = abs(buf_parts.qnty)
      734             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      735             v-parts-free-qnty     = 0
      736             v-parts-free-cli-qnty = 0
      737           .
      738         end.
      739         assign
      740           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      741           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      742           buf_temp-parts.real-qnty     = 0
      743           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      744           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      745           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      746         .
      747       end.
      748     end.
      749   end procedure.
      750   procedure partslib-init-temp-parts-by-factord :
      751     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      752     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      753     define input parameter p-artic              like ub.parts.artic     no-undo .
      754     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      755     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      756     define input parameter p-fact-order         as decimal   no-undo .
      757     define input parameter p-include-fact-order as logical   no-undo .
      758     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      759     define buffer buf_gds-obj  for ub.gds-obj .
      760     do
      761     on error undo, return error
      762     :
      763       do transaction
      764       on error undo, return error
      765       :
      766   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      767   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      768     (input  p-obj-type
      769     ,input  p-obj-code
      770     ,input  p-artic
      771     ,input  p-prod-type
      772     ,input  p-prod-code
      773     ,buffer buf_gds-obj
      774     ) no-error .
      775         if error-status :error
      776         then do:
      777           message
      778             vss-workfile vss-revision vss-description skip
      779             vss-include-info5 skip
      780             "Невозможно найти товар на объекте" skip
      781             "Объект" p-obj-type p-obj-code skip
      782             "Артикул" p-artic p-prod-type p-prod-code skip
      783             error-status :get-message(1) skip
      784             return-value skip
      785             view-as alert-box error .
      786           undo, return error .
      787         end.
      788         find current buf_gds-obj exclusive-lock .
      789       end.
      790       run partslib-init-temp-parts in this-procedure
      791         (input p-obj-type
      792         ,input p-obj-code
      793         ,input p-artic
      794         ,input p-prod-type
      795         ,input p-prod-code
      796         ) no-error .
      797       if error-status :error
      798       then do:
      799         message
      800           vss-workfile vss-revision vss-description skip
      801           vss-include-info5 skip
      802           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      803           "Объект" p-obj-type p-obj-code skip
      804           "Артикул" p-artic p-prod-type p-prod-code skip
      805           "p-fact-order" p-fact-order skip
      806           view-as alert-box error .
      807         undo, return error .
      808       end.
      809       if p-include-fact-order = true
      810       then do:
      811         assign
      812           p-fact-order = p-fact-order - 0.0000000001
      813         .
      814       end.
      815       define variable v-max-fact-order as character no-undo .
      816       run factord-max-fact-order in this-procedure
      817         (output v-max-fact-order
      818         ) no-error .
      819       if error-status :error
      820       then do:
      821         message
      822           vss-workfile vss-revision vss-description skip
      823           vss-include-info5 skip
      824           "Ошибка при вызове процедуры factord-max-fact-order" skip
      825           "Объект" p-obj-type p-obj-code skip
      826           "Артикул" p-artic p-prod-type p-prod-code skip
      827           "p-fact-order" p-fact-order skip
      828           view-as alert-box error .
      829         undo, return error .
      830       end.
      831       run partslib-update-by-factord in this-procedure
      832         (input p-obj-type
      833         ,input p-obj-code
      834         ,input p-artic
      835         ,input p-prod-type
      836         ,input p-prod-code
      837         ,input p-fact-order
      838         ,input v-max-fact-order
      839         ,input false
      840         ) no-error .
      841       if error-status :error
      842       then do:
      843         message
      844           vss-workfile vss-revision vss-description skip
      845           vss-include-info5 skip
      846           "Ошибка при вызове процедуры partslib-update-by-factord" skip
      847           "Объект" p-obj-type p-obj-code skip
      848           "Артикул" p-artic p-prod-type p-prod-code skip
      849           "p-fact-order" p-fact-order skip
      850           "v-max-fact-order" v-max-fact-order skip
      851           view-as alert-box error .
      852         undo, return error .
      853       end.
      854     end.
      855   end procedure.
      856   procedure partslib-update-by-factord :
      857     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      858     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      859     define input parameter p-artic              like ub.parts.artic     no-undo .
      860     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      861     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      862     define input parameter p-start-fact-order   as decimal   no-undo .
      863     define input parameter p-end-fact-order     as decimal   no-undo .
      864     define input parameter p-lock-gds-obj       as logical   no-undo .
      865     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      866     define buffer buf_gds-obj  for ub.gds-obj .
      867     define buffer buf_doc-line for ub.doc-line .
      868     define variable v-total-parts-qnty as decimal   no-undo .
      869     define variable v-goods-gds-goods  as logical   no-undo .
      870     define variable v-goods-twounit    as logical   no-undo .
      871     do
      872     on error undo, return error
      873     :
      874       if p-start-fact-order > p-end-fact-order
      875       then do:
      876         message
      877           vss-workfile vss-revision vss-description skip
      878           vss-include-info5 skip
      879           "Ошибка задания входных параметров" skip
      880           "Начало интервала превышает конец интервала" skip
      881           "Объект" p-obj-type p-obj-code skip
      882           "Артикул" p-artic p-prod-type p-prod-code skip
      883           "p-start-fact-order" p-start-fact-order skip
      884           "p-end-fact-order"   p-end-fact-order skip
      885           view-as alert-box error .
      886         undo, return error .
      887       end.
      888       if p-lock-gds-obj = true
      889       then do:
      890         do transaction
      891         on error undo, return error
      892         :
      893   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      894   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      895     (input  p-obj-type
      896     ,input  p-obj-code
      897     ,input  p-artic
      898     ,input  p-prod-type
      899     ,input  p-prod-code
      900     ,buffer buf_gds-obj
      901     ) no-error .
      902           if error-status :error
      903           then do:
      904             message
      905               vss-workfile vss-revision vss-description skip
      906               vss-include-info5 skip
      907               "Невозможно найти gds-obj" skip
      908               error-status :get-message(1) skip
      909               return-value skip
      910               view-as alert-box error .
      911             undo, return error .
      912           end.
      913           find current buf_gds-obj exclusive-lock .
      914         end.
      915       end.
      916   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      917   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      918     (input  p-artic
      919     ,input  p-prod-type
      920     ,input  p-prod-code
      921     ,input  'gds-goods=request':u
      922     ,output v-goods-gds-goods
      923     ) no-error .
      924       if error-status :error
      925       then do:
      926         message
      927           vss-workfile vss-revision vss-description skip
      928           vss-include-info5 skip
      929           "Ошибка при определении атрибута товара" skip
      930           "Артикул" p-artic p-prod-type p-prod-code skip
      931           "gds-goods=request" skip
      932           error-status :get-message(1) skip
      933           return-value skip
      934           view-as alert-box error .
      935         undo, return error return-value .
      936       end.
      937   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      938   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      939     (input  p-artic
      940     ,input  p-prod-type
      941     ,input  p-prod-code
      942     ,input  'twounit=request':u
      943     ,output v-goods-twounit
      944     ) no-error .
      945       if error-status :error
      946       then do:
      947         message
      948           vss-workfile vss-revision vss-description skip
      949           vss-include-info5 skip
      950           "Ошибка при определении атрибута товара" skip
      951           "Артикул" p-artic p-prod-type p-prod-code skip
      952           "twounit=request" skip
      953           error-status :get-message(1) skip
      954           return-value skip
      955           view-as alert-box error .
      956         undo, return error return-value .
      957       end.
      958       for each buf_doc-line no-lock
      959         where buf_doc-line.obj-type   = p-obj-type
      960           and buf_doc-line.obj-code   = p-obj-code
      961           and buf_doc-line.artic      = p-artic
      962           and buf_doc-line.prod-type  = p-prod-type
      963           and buf_doc-line.prod-code  = p-prod-code
      964           and buf_doc-line.status_    = 'факт':U
      965           and buf_doc-line.fact-order > p-start-fact-order
      966           and buf_doc-line.fact-order <= p-end-fact-order
      967       on error undo, return error
      968       :
      969         run partslib-process-document in this-procedure
      970           (input  buf_doc-line.doc-code
      971           ,input  p-obj-type
      972           ,input  p-obj-code
      973           ,input  p-artic
      974           ,input  p-prod-type
      975           ,input  p-prod-code
      976           ,input  v-goods-gds-goods
      977           ,input  v-goods-twounit
      978           ,output v-total-parts-qnty
      979           ) no-error .
      980         if error-status :error
      981         then do:
      982           message
      983             vss-workfile vss-revision vss-description skip
      984             vss-include-info5 skip
      985             "Ошибка при вызове процедуры partslib-process-document" skip
      986             "Документ" buf_doc-line.doc-code skip
      987             "Объект" p-obj-type p-obj-code skip
      988             "Артикул" p-artic p-prod-type p-prod-code skip
      989             "p-start-fact-order" p-start-fact-order skip
      990             "p-end-fact-order" p-end-fact-order skip
      991             error-status :get-message(1) skip
      992             return-value skip
      993             view-as alert-box error .
      994           undo, return error return-value .
      995         end.
      996       end.
      997     end.
      998   end procedure.
      999   procedure partslib-process-document :
     1000     define input  parameter p-doc-code         as character no-undo .
     1001     define input  parameter p-obj-type         as character no-undo .
     1002     define input  parameter p-obj-code         as integer   no-undo .
     1003     define input  parameter p-artic            as character no-undo .
     1004     define input  parameter p-prod-type        as character no-undo .
     1005     define input  parameter p-prod-code        as integer   no-undo .
     1006     define input  parameter p-goods-gds-goods  as logical   no-undo .
     1007     define input  parameter p-goods-twounit    as logical   no-undo .
     1008     define output parameter p-total-parts-qnty as decimal   no-undo .
     1009     define variable v-parts-sign as integer   no-undo .
     1010     define buffer buf_trn-doc    for ub.trn-doc .
     1011     define buffer buf_doc-line   for ub.doc-line .
     1012     define buffer buf_parts      for ub.parts .
     1013     define buffer buf_temp-parts for temp-parts .
     1014     do
     1015     on error undo, return error return-value
     1016     :
     1017       find first buf_trn-doc no-lock
     1018         where buf_trn-doc.doc-code = p-doc-code
     1019         no-error .
     1020       if not available buf_trn-doc
     1021       then do:
     1022         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     1023                                      ,p-doc-code
     1024                                      ) .
     1025       end.
     1026       case buf_trn-doc.doc-type
     1027       :
     1028         when 'при':U or
     1029         when 'возврат':U or
     1030         when 'инв':U
     1031         then do:
     1032           assign
     1033             v-parts-sign = -1
     1034           .
     1035         end.
     1036         when 'рас':U or
     1037         when 'спи':U
     1038         then do:
     1039           assign
     1040             v-parts-sign = 1
     1041           .
     1042         end.
     1043         otherwise do:
     1044           undo, return error substitute("Неизвестный тип документа &1"
     1045                                       ,buf_trn-doc.doc-type
     1046                                       ) .
     1047         end.
     1048       end.
     1049       find first buf_doc-line no-lock
     1050         where buf_doc-line.doc-code  = p-doc-code
     1051           and buf_doc-line.artic     = p-artic
     1052           and buf_doc-line.prod-type = p-prod-type
     1053           and buf_doc-line.prod-code = p-prod-code
     1054         no-error .
     1055       if not available buf_doc-line
     1056       then do:
     1057         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     1058                                      ,p-doc-code
     1059                                      ,artic
     1060                                      ,prod-type
     1061                                      ,prod-code
     1062                                      ) .
     1063       end.
     1064       assign
     1065         p-total-parts-qnty = 0
     1066       .
     1067       if p-goods-gds-goods = true
     1068       then do:
     1069         for each buf_parts no-lock
     1070           where buf_parts.out-code  = p-doc-code
     1071             and buf_parts.obj-type  = p-obj-type
     1072             and buf_parts.obj-code  = p-obj-code
     1073             and buf_parts.artic     = p-artic
     1074             and buf_parts.prod-type = p-prod-type
     1075             and buf_parts.prod-code = p-prod-code
     1076         on error undo, return error
     1077         :
     1078           run partslib-create-temp-parts in this-procedure
     1079             (buffer buf_parts
     1080             ,buffer buf_temp-parts
     1081             ,input  p-goods-twounit
     1082             ) .
     1083           assign
     1084             p-total-parts-qnty        = p-total-parts-qnty
     1085                                       + v-parts-sign * buf_parts.fact-qnty
     1086             buf_temp-parts.qnty       = buf_temp-parts.qnty
     1087                                       + v-parts-sign * buf_parts.fact-qnty
     1088             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     1089                                       + v-parts-sign * buf_parts.fact-qnty
     1090             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     1091                                       + v-parts-sign * buf_parts.cli-qnty
     1092           .
     1093           if buf_temp-parts.qnty = 0
     1094           then do:
     1095             delete buf_temp-parts .
     1096           end.
     1097         end.
     1098       end.
     1099       else do:
     1100         assign
     1101           p-total-parts-qnty = p-total-parts-qnty
     1102                              + v-parts-sign * buf_doc-line.fact-qnty
     1103         .
     1104       end.
     1105     end.
     1106   end procedure.
     1107   procedure partslib-init-temp-parts-by-date :
     1108     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1109     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1110     define input parameter p-artic           like ub.parts.artic     no-undo .
     1111     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1112     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1113     define input parameter p-fact-date       as date      no-undo .
     1114     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     1115     do
     1116     on error undo, return error
     1117     :
     1118       define variable v-fact-order                as decimal   no-undo .
     1119       define variable v-shift-end-fact-order      as decimal   no-undo .
     1120       define variable v-day-end-fact-order        as decimal   no-undo .
     1121       run factord in this-procedure
     1122         (input  p-fact-date
     1123         ,input  1
     1124         ,input  1
     1125         ,input  ?
     1126         ,input  0
     1127         ,input  false
     1128         ,output v-fact-order
     1129         ,output v-shift-end-fact-order
     1130         ,output v-day-end-fact-order
     1131         ) no-error .
     1132       if error-status :error
     1133       then do:
     1134         message
     1135           vss-workfile vss-revision vss-description skip
     1136           vss-include-info5 skip
     1137           "Ошибка при определении момента времени, на который требуется остаток" skip
     1138           "Объект" p-obj-type p-obj-code skip
     1139           "Артикул" p-artic p-prod-type p-prod-code skip
     1140           "Дата" p-fact-date skip
     1141           view-as alert-box error .
     1142         undo, return error .
     1143       end.
     1144       run partslib-init-temp-parts-by-factord in this-procedure
     1145         (input p-obj-type
     1146         ,input p-obj-code
     1147         ,input p-artic
     1148         ,input p-prod-type
     1149         ,input p-prod-code
     1150         ,input v-day-end-fact-order
     1151         ,input false
     1152         ) no-error .
     1153       if error-status :error
     1154       then do:
     1155         message
     1156           vss-workfile vss-revision vss-description skip
     1157           vss-include-info5 skip
     1158           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     1159           "Объект" p-obj-type p-obj-code skip
     1160           "Артикул" p-artic p-prod-type p-prod-code skip
     1161           "Дата" p-fact-date skip
     1162           view-as alert-box error .
     1163         undo, return error .
     1164       end.
     1165     end.
     1166   end procedure.
     1167   procedure partslib-calc-cost :
     1168     define output parameter p-fact-qnty      as decimal   no-undo .
     1169     define output parameter p-vat-pc         as decimal   no-undo .
     1170     define output parameter p-slt-pc         as decimal   no-undo .
     1171     define output parameter p-sum-base       as decimal   no-undo .
     1172     define output parameter p-sum-rubl       as decimal   no-undo .
     1173     define output parameter p-vat-base       as decimal   no-undo .
     1174     define output parameter p-vat-rubl       as decimal   no-undo .
     1175     define output parameter p-slt-base       as decimal   no-undo .
     1176     define output parameter p-slt-rubl       as decimal   no-undo .
     1177     define output parameter p-road-tax-base  as decimal   no-undo .
     1178     define output parameter p-road-tax-rubl  as decimal   no-undo .
     1179     define output parameter p-transport-base as decimal   no-undo .
     1180     define output parameter p-transport-rubl as decimal   no-undo .
     1181     define output parameter p-other-base     as decimal   no-undo .
     1182     define output parameter p-other-rubl     as decimal   no-undo .
     1183     define output parameter p-excise-base    as decimal   no-undo .
     1184     define output parameter p-excise-rubl    as decimal   no-undo .
     1185     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     1186     do
     1187     on error undo, return error return-value
     1188     :
     1189       define buffer buf_temp-parts for temp-parts .
     1190       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1191       define buffer   in-vatp-parts    for ub.parts   .
     1192       define buffer   in-vatp-doc      for ub.trn-doc .
     1193       define buffer   in-vatp-goods    for ub.goods   .
     1194       define buffer   in-vatp-sysconf  for ub.sysconf .
     1195       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1196       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1197       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1198       define variable varinvprb                  as   character              no-undo.
     1199       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1200       define variable cli-base-rate              as   decimal                no-undo.
     1201       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1202       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1203       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1204       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1205       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1206       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1207       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1208       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1209       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1210       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1211       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1212       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1213       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1214       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1215       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1216       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1217       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1218       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1219       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1220       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1221       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1222       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1223       define variable varinvatp-envd             as   character              no-undo.
     1224       define variable varinvatp-type             as   character              no-undo.
     1225       for each buf_temp-parts
     1226       on error undo, return error
     1227       :
     1228   assign
     1229     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1230     price-base-with-tax-loc = buf_temp-parts.price-base
     1231   .
     1232   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1233   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1234     (output varinvprb
     1235     )  .
     1236     if buf_temp-parts.out-code = 'free-zone':U     or
     1237        buf_temp-parts.out-code = 'out-zone':U   or
     1238        buf_temp-parts.doc-type = 'акт':U then do:
     1239       assign
     1240         in-vatp-have-vat-slt = yes.
     1241     end.
     1242     else do:
     1243       find first in-vatp_doc-attr no-lock
     1244         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1245           and in-vatp_doc-attr.attr-code = 'envd':U
     1246         no-error .
     1247       if not available in-vatp_doc-attr then do:
     1248         assign
     1249           in-vatp-have-vat-slt = yes.
     1250       end.
     1251       else do:
     1252            in-vatp-have-vat-slt = no.
     1253       end.
     1254     end.
     1255     assign
     1256      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1257      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1258     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1259              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1260     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1261             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1262             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1263             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1264             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1265             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1266             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1267       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1268     assign
     1269       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     1270     assign
     1271       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1272       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1273       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1274       transport-cli-loc  = 0
     1275       other-cli-loc      = 0
     1276     .
     1277   ASSIGN
     1278             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1279       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1280   .
     1281         assign
     1282           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     1283           p-vat-pc         = p-vat-pc         + vat-pc-loc
     1284           p-slt-pc         = p-slt-pc         + slt-pc-loc
     1285           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     1286           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     1287           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     1288           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     1289           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     1290           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     1291           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     1292           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     1293           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     1294           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     1295           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     1296           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     1297           p-excise-base    = p-excise-base    + 0
     1298           p-excise-rubl    = p-excise-rubl    + 0
     1299         .
     1300       end.
     1301       if p-fact-qnty      = ?
     1302       or p-sum-base       = ?
     1303       or p-sum-rubl       = ?
     1304       or p-vat-base       = ?
     1305       or p-vat-rubl       = ?
     1306       or p-slt-base       = ?
     1307       or p-slt-rubl       = ?
     1308       or p-road-tax-base  = ?
     1309       or p-road-tax-rubl  = ?
     1310       or p-transport-base = ?
     1311       or p-transport-rubl = ?
     1312       or p-other-base     = ?
     1313       or p-other-rubl     = ?
     1314       or p-excise-base    = ?
     1315       or p-excise-rubl    = ?
     1316       then do:
     1317         message
     1318           vss-workfile vss-revision vss-description skip
     1319           vss-include-info5 skip
     1320           "Программа in-vatp.i вернула неопределенные значения" skip
     1321           "p-fact-qnty"      p-fact-qnty      skip
     1322           "p-sum-base"       p-sum-base       skip
     1323           "p-sum-rubl"       p-sum-rubl       skip
     1324           "p-vat-base"       p-vat-base       skip
     1325           "p-vat-rubl"       p-vat-rubl       skip
     1326           "p-slt-base"       p-slt-base       skip
     1327           "p-slt-rubl"       p-slt-rubl       skip
     1328           "p-road-tax-base"  p-road-tax-base  skip
     1329           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1330           "p-transport-base" p-transport-base skip
     1331           "p-transport-rubl" p-transport-rubl skip
     1332           "p-other-base"     p-other-base     skip
     1333           "p-other-rubl"     p-other-rubl     skip
     1334           "p-excise-base"    p-excise-base    skip
     1335           "p-excise-rubl"    p-excise-rubl    skip
     1336           view-as alert-box error .
     1337         undo, return error .
     1338       end.
     1339     end.
     1340   end procedure.
     1341   define variable vss-include-info12 as character format "X(65)" no-undo
     1342   initial "@(#)$Workfile$ $Revision$".
     1343   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1344   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1345   define temp-table temp_fbrlib_recipe no-undo
     1346       field recipe-code                   as character
     1347       field fbr-doc-code                  as character
     1348       field income-goods-doc-code         as character
     1349       field count-income                  as integer
     1350       field qnty-income                   as decimal
     1351       field sum-income-sale               as decimal
     1352       field sum-income-cost-base          as decimal
     1353       field sum-income-cost-rubl          as decimal
     1354       field sum-income-vat-cost-base      as decimal
     1355       field sum-income-vat-cost-rubl      as decimal
     1356       field write-off-goods-doc-code      as character
     1357       field write-off-office-doc-code     as character
     1358       field count-write-off               as integer
     1359       field qnty-write-off                as decimal
     1360       field sum-write-off-sale            as decimal
     1361       field sum-write-off-cost-base       as decimal
     1362       field sum-write-off-cost-rubl       as decimal
     1363       field sum-write-off-vat-cost-base   as decimal
