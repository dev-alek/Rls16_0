     1420     (input  p-obj-type
     1421     ,input  p-obj-code
     1422     ,output v-host-code
     1423     )  .
     1424   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1425   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1426     (input  p-obj-type
     1427     ,input  p-obj-code
     1428     ,output v-obj-db-num
     1429     )  .
     1430   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1431   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1432     (output v-db-num
     1433     )  .
     1434   if v-obj-db-num <> v-db-num then do:
     1435     return error substitute("Запрещено создание документа производства в чужой БД:&1БД &2&3 - &4&1текущая БД - &5"
     1436                             , chr(10)
     1437                             , p-obj-type
     1438                             , p-obj-code
     1439                             , v-obj-db-num
     1440                             , v-db-num).
     1441   end.
     1442   run cur-time in this-procedure ( output v-today, output v-time).
     1443   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1444   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1445     (input  p-obj-type
     1446     ,input  p-obj-code
     1447     ,output v-today
     1448     )  .
     1449   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1450   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1451     (input  v-host-code
     1452     ,output v-base-code
     1453     )  .
     1454   find last buf_curr-accnt no-lock
     1455       where buf_curr-accnt.curr-code = v-base-code
     1456         and buf_curr-accnt.exch-date <= v-today use-index pi
     1457   no-error.
     1458   if not available buf_curr-accnt
     1459   then do:
     1460     undo, return error substitute("На дату &1 неизвестен курс базовой валюты с кодом &2"
     1461                                     , string(v-today, "99/99/9999")
     1462                                     , v-base-code).
     1463   end.
     1464   run doc-code in this-procedure (
     1465         input  "main"
     1466       , input  p-obj-type
     1467       , input  p-obj-code
     1468       , input  ?
     1469       , output v-doc-code
     1470   ) no-error.
     1471   if error-status:error
     1472   then do:
     1473     undo, return error substitute("Ошибка при генерации номера документа производства&1&2&1&3"
     1474                                   , chr(10)
     1475                                   , error-status:get-message(1)
     1476                                   , return-value ).
     1477   end.
     1478   run trg/chkdocnm.p (
     1479         input v-doc-code
     1480       , input 'fbr-doc':U
     1481       , input ?
     1482   ) no-error.
     1483   if error-status:error
     1484   then do:
     1485     undo, return error substitute("Ошибка при проверке номера для нового документа производства&1&2&1&3"
     1486                                   , chr(10)
     1487                                   , error-status:get-message(1)
     1488                                   , return-value ).
     1489   end.
     1490   create buf_fbr-doc.
     1491   assign
     1492   buf_fbr-doc.doc-code  = v-doc-code
     1493   buf_fbr-doc.creid     = p-userid
     1494   buf_fbr-doc.doc-date  = v-today
     1495   buf_fbr-doc.doc-type  = 'производство':U
     1496   buf_fbr-doc.host-code = v-host-code
     1497   buf_fbr-doc.obj-code  = p-obj-code
     1498   buf_fbr-doc.obj-type  = p-obj-type
     1499   buf_fbr-doc.PS        = "@"
     1500   buf_fbr-doc.status_   = 'новый':U
     1501   buf_fbr-doc.user-db-num = v-obj-db-num
     1502   buf_fbr-doc.user-name   = p-userid
     1503   .
     1504   run fbrlib_get-default-pay-code in this-procedure (
     1505         input buf_fbr-doc.obj-type
     1506       , input buf_fbr-doc.obj-code
     1507       , output fi-pay-code
     1508   ).
     1509   buf_fbr-doc.pay-code = fi-pay-code.
     1510   p-recid = recid(buf_fbr-doc).
     1511   p-fbr-doc-code = buf_fbr-doc.doc-code.
     1512   end.
     1513   end procedure.
     1514   procedure fbrlib_get-default-pay-code :
     1515   define input parameter p-obj-type   as character        no-undo.
     1516   define input parameter p-obj-code   as integer          no-undo.
     1517   define output parameter p-pay-code  as integer          no-undo.
     1518   define variable v-host-code as integer no-undo .
     1519   define buffer buf_shop          for ub.shop.
     1520   define buffer buf_store         for ub.store.
     1521   define buffer buf_sysconf       for ub.sysconf.
     1522   do
     1523   for buf_shop
     1524     , buf_store
     1525     , buf_sysconf
     1526   on error undo, return error
     1527   :
     1528     case p-obj-type  :
     1529       when 'маг':U then do:
     1530           find first buf_shop no-lock
     1531                 where buf_shop.obj-code = p-obj-code
     1532           no-error.
     1533           if available buf_shop
     1534           then do:
     1535               assign
     1536                   p-pay-code = buf_shop.fbr-pay
     1537               .
     1538           end.
     1539       end.
     1540       when 'скл':U then do:
     1541           find first buf_store no-lock
     1542                 where buf_store.obj-code = p-obj-code
     1543           no-error.
     1544           if available buf_store
     1545           then do:
     1546               assign
     1547                   p-pay-code = buf_store.fbr-pay
     1548               .
     1549           end.
     1550       end.
     1551     end case.
     1552     if p-pay-code = ?
     1553     or p-pay-code = 0
     1554     then do:
     1555   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1556   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1557     (input  p-obj-type
     1558     ,input  p-obj-code
     1559     ,output v-host-code
     1560     )  .
     1561         find first buf_sysconf no-lock
     1562               where buf_sysconf.host-code = v-host-code
     1563         no-error.
     1564         if available buf_sysconf
     1565         then do:
     1566             assign
     1567                 p-pay-code = buf_sysconf.fbr-pay
     1568             .
     1569         end.
     1570     end.
     1571     if p-pay-code = ?
     1572     or p-pay-code = 0
     1573     then do:
     1574   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1575   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdnpay in g#library
     1576     (input  p-obj-type
     1577     ,input  p-obj-code
     1578     ,output p-pay-code
     1579     )  .
     1580     end.
     1581   end.
     1582   end procedure.
     1583   procedure fbrlib-fill-and-check-temp_fbrlib_recipe :
     1584   do
     1585   on error undo, return error
     1586   :
     1587   define input parameter p-fbr-doc-code as character    no-undo.
     1588       define variable vss-description as character    no-undo init "fbrlib-fill-and-check-temp_fbrlib_recipe: ".
     1589       define variable v-gds-name      as character    no-undo.
     1590       define buffer buf_fbr-doc               for ub.fbr-doc.
     1591       define buffer buf_fbr-line              for ub.fbr-line.
     1592       define buffer buf_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     1593       define buffer buf_out_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     1594       find first buf_fbr-doc no-lock
     1595            where buf_fbr-doc.doc-code = p-fbr-doc-code
     1596       .
     1597       for each buf_temp_fbrlib_recipe
     1598       :
     1599           delete buf_temp_fbrlib_recipe.
     1600       end.
     1601       for each buf_fbr-line no-lock
     1602          where buf_fbr-line.doc-code = p-fbr-doc-code
     1603       :
     1604           find first buf_temp_fbrlib_recipe
     1605                where buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     1606           no-error.
     1607           if not available buf_temp_fbrlib_recipe
     1608           then do:
     1609               create buf_temp_fbrlib_recipe.
     1610               assign
     1611                   buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     1612                   buf_temp_fbrlib_recipe.fbr-doc-code = buf_fbr-line.doc-code
     1613               .
     1614           end.
     1615       end.
     1616       for each buf_temp_fbrlib_recipe
     1617       :
     1618           assign
     1619               buf_temp_fbrlib_recipe.count-income                = 0
     1620               buf_temp_fbrlib_recipe.qnty-income                 = 0
     1621               buf_temp_fbrlib_recipe.sum-income-sale             = 0
     1622               buf_temp_fbrlib_recipe.sum-income-cost-base        = 0
     1623               buf_temp_fbrlib_recipe.sum-income-cost-rubl        = 0
     1624               buf_temp_fbrlib_recipe.sum-income-vat-cost-base    = 0
     1625               buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl    = 0
     1626               buf_temp_fbrlib_recipe.count-write-off             = 0
     1627               buf_temp_fbrlib_recipe.qnty-write-off              = 0
     1628               buf_temp_fbrlib_recipe.sum-write-off-sale          = 0
     1629               buf_temp_fbrlib_recipe.sum-write-off-cost-base     = 0
     1630               buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = 0
     1631               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = 0
     1632               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = 0
     1633           .
     1634           for each buf_fbr-line no-lock
     1635              where buf_fbr-line.doc-code     = p-fbr-doc-code
     1636                and buf_fbr-line.trn-type     = 'при':U
     1637                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     1638           :
     1639               if ( buf_fbr-line.price-base   = ?
     1640                   or buf_fbr-line.price-rubl = ?
     1641                   or buf_fbr-line.price-base <= 0
     1642                   or buf_fbr-line.price-rubl <= 0 )
     1643               and buf_fbr-line.fact-qnty <> 0
     1644               and buf_fbr-line.rsrv-qnty <> ?
     1645               and buf_fbr-doc.is-free    = no
     1646               then do:
     1647   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1648   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1649     (input  buf_fbr-line.artic
     1650     ,input  buf_fbr-line.prod-type
     1651     ,input  buf_fbr-line.prod-code
     1652     ,output v-gds-name
     1653     ) no-error .
     1654                   if error-status :error
     1655                   then do:
     1656                       assign
     1657                           v-gds-name = ""
     1658                       .
     1659                   end.
     1660                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     1661                                                 ,vss-description
     1662                                                 ,buf_fbr-doc.doc-code
     1663                                                 ,chr(10)
     1664                                                 ,buf_fbr-line.recipe-code
     1665                                                 ,buf_fbr-line.artic
     1666                                                 ,v-gds-name).
     1667               end.
     1668               assign
     1669                   buf_temp_fbrlib_recipe.count-income             = buf_temp_fbrlib_recipe.count-income + 1
     1670                   buf_temp_fbrlib_recipe.qnty-income              = buf_temp_fbrlib_recipe.qnty-income
     1671                                                                   + buf_fbr-line.fact-qnty
     1672                   buf_temp_fbrlib_recipe.sum-income-sale          = buf_temp_fbrlib_recipe.sum-income-sale
     1673                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     1674               .
     1675               if buf_fbr-line.is-waste = no
     1676               then do:
     1677                   assign
     1678                       buf_temp_fbrlib_recipe.sum-income-cost-base     = buf_temp_fbrlib_recipe.sum-income-cost-base
     1679                                                                       + buf_fbr-line.price-sum-base
     1680                       buf_temp_fbrlib_recipe.sum-income-cost-rubl     = buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1681                                                                       + buf_fbr-line.price-sum-rubl
     1682                       buf_temp_fbrlib_recipe.sum-income-vat-cost-base = buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1683                                                                       + buf_fbr-line.price-sum-vat-base
     1684                       buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1685                                                                       + buf_fbr-line.price-sum-vat-rubl
     1686                   .
     1687               end.
     1688           end.
     1689           for each buf_fbr-line no-lock
     1690              where buf_fbr-line.doc-code     = p-fbr-doc-code
     1691                and buf_fbr-line.trn-type     = 'спи':U
     1692                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     1693           :
     1694               if ( buf_fbr-line.price-base   = ?
     1695                   or buf_fbr-line.price-rubl = ?
     1696                   or buf_fbr-line.price-base <= 0
     1697                   or buf_fbr-line.price-rubl <= 0 )
     1698               and buf_fbr-line.fact-qnty <> 0
     1699               and buf_fbr-line.rsrv-qnty <> ?
     1700               and buf_fbr-doc.is-free    = no
     1701               and buf_fbr-doc.status_    = 'разрешен':U
     1702               then do:
     1703   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1704   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1705     (input  buf_fbr-line.artic
     1706     ,input  buf_fbr-line.prod-type
     1707     ,input  buf_fbr-line.prod-code
     1708     ,output v-gds-name
     1709     ) no-error .
     1710                   if error-status :error
     1711                   then do:
     1712                       assign
     1713                           v-gds-name = ""
     1714                       .
     1715                   end.
     1716                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     1717                                                 ,vss-description
     1718                                                 ,buf_fbr-doc.doc-code
     1719                                                 ,chr(10)
     1720                                                 ,buf_fbr-line.recipe-code
     1721                                                 ,buf_fbr-line.artic
     1722                                                 ,v-gds-name).
     1723               end.
     1724               assign
     1725                   buf_temp_fbrlib_recipe.count-write-off             = buf_temp_fbrlib_recipe.count-write-off + 1
     1726                   buf_temp_fbrlib_recipe.qnty-write-off              = buf_temp_fbrlib_recipe.qnty-write-off
     1727                                                                   + buf_fbr-line.fact-qnty
     1728                   buf_temp_fbrlib_recipe.sum-write-off-sale          = buf_temp_fbrlib_recipe.sum-write-off-sale
     1729                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     1730               .
     1731               if buf_fbr-line.is-waste = no
     1732               then do:
     1733                   assign
     1734                       buf_temp_fbrlib_recipe.sum-write-off-cost-base     = buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1735                                                                       + buf_fbr-line.price-sum-base
     1736                       buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1737                                                                       + buf_fbr-line.price-sum-rubl
     1738                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1739                                                                       + buf_fbr-line.price-sum-vat-base
     1740                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1741                                                                       + buf_fbr-line.price-sum-vat-rubl
     1742                   .
     1743               end.
     1744           end.
     1745           if buf_fbr-doc.status_    = 'разрешен':U
     1746           and ( abs( buf_temp_fbrlib_recipe.sum-write-off-cost-base     - buf_temp_fbrlib_recipe.sum-income-cost-base     ) > 0.01
     1747           or abs( buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     - buf_temp_fbrlib_recipe.sum-income-cost-rubl     ) > 0.01
     1748           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base - buf_temp_fbrlib_recipe.sum-income-vat-cost-base ) > 0.01
     1749           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl - buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl ) > 0.01
     1750               )
     1751           then do:
     1752            undo, return error
     1753               substitute("В документе пр-ва &1 Не совпадают суммы учетных цен для списанного и оприходованного по рецепту товара.&2" +
     1754                           "Рецепт: &3&2&4&4по списанному товару&4по оприходованному товару&2"  +
     1755                           "Сумма в баз.вал.&4&5&4&4&6&2" +
     1756                           "Сумма в &9.&4&7&4&4&8&2"
     1757                          , buf_fbr-doc.doc-code
     1758                          , chr(10)
     1759                          , buf_temp_fbrlib_recipe.recipe-code
     1760                          , chr(9)
     1761                          , buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1762                          , buf_temp_fbrlib_recipe.sum-income-cost-base
     1763                          , buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1764                          , buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1765                          , "руб"
     1766                          )
     1767              +
     1768              substitute("НДС в баз.вал.&1&2&1&1&3&4" +
     1769                         "НДС в &7.&1&5&1&1&6&4"
     1770                        ,  chr(9)
     1771                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1772                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1773                        ,chr(10)
     1774                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1775                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1776                        ,"руб"
     1777                        )       .
     1778           end.
     1779       end.
     1780   end.
     1781   end procedure.
     1782   procedure fbrlib-fill-sum-fbr-doc :
     1783   do
     1784   on error undo, return error
     1785   :
     1786   define input parameter p-fbr-doc-recid  as recid        no-undo.
     1787   define input parameter p-mode           as character    no-undo.
     1788       define variable vss-description as character init "fbrlib-fill-sum-fbr-doc: "  no-undo.
     1789       define buffer buf_fbr-doc           for ub.fbr-doc.
     1790       define buffer buf_fbr-line          for ub.fbr-line.
     1791       define buffer buf_temp_fbrlib_recipe   for temp_fbrlib_recipe.
     1792       define variable v-in-count          as integer       no-undo.
     1793       define variable v-out-count         as integer       no-undo.
     1794       find first buf_fbr-doc exclusive-lock
     1795            where recid ( buf_fbr-doc ) = p-fbr-doc-recid
     1796       .
     1797       find first buf_temp_fbrlib_recipe no-error.
     1798       if not available buf_temp_fbrlib_recipe
     1799       then do:
     1800           run fbrlib-fill-and-check-temp_fbrlib_recipe in this-procedure (
     1801               input buf_fbr-doc.doc-code
     1802           ) no-error.
     1803           if error-status :error
     1804           then do:
     1805               undo, return error substitute("&1 Ошибка расчета сумм при заполнении шапки документа производства.&2&3&2&4"
     1806                                              , vss-description
     1807                                              , chr(10)
     1808                                              , error-status:get-message(1)
     1809                                              , return-value ).
     1810           end.
     1811       end.
     1812       assign
     1813           v-in-count                  = 0
     1814           buf_fbr-doc.in-qnty         = 0
     1815           buf_fbr-doc.in-sale         = 0
     1816           buf_fbr-doc.in-base         = 0
     1817           buf_fbr-doc.in-rubl         = 0
     1818           buf_fbr-doc.in-vat-base     = 0
     1819           buf_fbr-doc.in-vat-rubl     = 0
     1820           v-out-count                 = 0
     1821           buf_fbr-doc.out-qnty        = 0
     1822           buf_fbr-doc.out-sale        = 0
     1823           buf_fbr-doc.out-base        = 0
     1824           buf_fbr-doc.out-rubl        = 0
     1825           buf_fbr-doc.out-vat-base    = 0
     1826           buf_fbr-doc.out-vat-rubl    = 0
     1827       .
     1828       for each buf_temp_fbrlib_recipe
     1829       :
     1830           assign
     1831               v-in-count                  = v-in-count                + buf_temp_fbrlib_recipe.count-income
     1832               buf_fbr-doc.in-qnty         = buf_fbr-doc.in-qnty       + buf_temp_fbrlib_recipe.qnty-income
     1833               buf_fbr-doc.in-sale         = buf_fbr-doc.in-sale       + buf_temp_fbrlib_recipe.sum-income-sale
     1834               buf_fbr-doc.in-base         = buf_fbr-doc.in-base       + buf_temp_fbrlib_recipe.sum-income-cost-base
     1835               buf_fbr-doc.in-rubl         = buf_fbr-doc.in-rubl       + buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1836               buf_fbr-doc.in-vat-base     = buf_fbr-doc.in-vat-base   + buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1837               buf_fbr-doc.in-vat-rubl     = buf_fbr-doc.in-vat-rubl   + buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1838               v-out-count                 = v-out-count               + buf_temp_fbrlib_recipe.count-write-off
     1839               buf_fbr-doc.out-qnty        = buf_fbr-doc.out-qnty      + buf_temp_fbrlib_recipe.qnty-write-off
     1840               buf_fbr-doc.out-sale        = buf_fbr-doc.out-sale      + buf_temp_fbrlib_recipe.sum-write-off-sale
     1841               buf_fbr-doc.out-base        = buf_fbr-doc.out-base      + buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1842               buf_fbr-doc.out-rubl        = buf_fbr-doc.out-rubl      + buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1843               buf_fbr-doc.out-vat-base    = buf_fbr-doc.out-vat-base  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1844               buf_fbr-doc.out-vat-rubl    = buf_fbr-doc.out-vat-rubl  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1845           .
     1846       end.
     1847       if ( abs (buf_fbr-doc.in-rubl - buf_fbr-doc.out-rubl) <= 0.01
     1848       and   abs (buf_fbr-doc.in-base - buf_fbr-doc.out-base) <= 0.01 )
     1849       or p-mode <> 'факт':U
     1850       then do:
     1851           if substring( buf_fbr-doc.PS, 1, 1 ) = "@"
     1852           then do:
     1853               assign
     1854                   buf_fbr-doc.PS = "@ Строк полученных товаров : "
     1855                                   + string( v-out-count, ">>>,>>9" )
     1856                                   + chr(10) + "Строк исходных товаров : "
     1857                                   + string( v-in-count, ">>>,>>9" )
     1858               .
     1859           end.
     1860       end.
     1861       else do:
     1862         undo, return error substitute("В док-те пр-ва &1 не совпадают суммы списанных и оприходованных товаров.&2" +
     1863                                       "Сумма списанных товаров в &3 - &4&2" +
     1864                                       "Сумма оприходованных товаров в &3 - &5&2" +
     1865                                       "Сумма оприходованных товаров в &3 - &6&2" +
     1866                                       "Сумма списанных товаров в баз.вал. - &7&2" +
     1867                                       "Сумма оприходованных товаров в баз.вал. - &8&2"
     1868                                       , buf_fbr-doc.doc-code
     1869                                       , chr(10)
     1870                                       , "рублях"
     1871                                       , round( buf_fbr-doc.out-rubl, 2 )
     1872                                       , round( buf_fbr-doc.in-rubl,  2 )
     1873                                       , round( buf_fbr-doc.in-rubl,  2 )
     1874                                       , round( buf_fbr-doc.out-base, 2 )
     1875                                       , round( buf_fbr-doc.in-base,  2 )).
     1876       end.
     1877   end.
     1878   end procedure.
     1879   procedure fbrlib-calc-prices :
     1880   do
     1881   on error undo, return error
     1882   :
     1883   define input parameter p-fbr-line-recid as recid        no-undo.
     1884   define input parameter p-price-obj-type as character    no-undo.
     1885   define input parameter p-price-obj-code as integer      no-undo.
     1886   define output parameter p-current-price as decimal      no-undo.
     1887       define variable v-void          as decimal       no-undo.
     1888       define variable v-void-char     as character     no-undo.
     1889       define variable v-gds-code      as integer       no-undo.
     1890       define variable v-b-code        as integer       no-undo.
     1891       define buffer buf_fbr-doc   for ub.fbr-doc.
     1892       define buffer buf_fbr-line  for ub.fbr-line.
     1893       define buffer buf_gds-prt   for ub.gds-prt.
     1894       define buffer buf_bar-code  for ub.bar-code.
     1895       find first buf_fbr-line no-lock
     1896           where recid( buf_fbr-line ) = p-fbr-line-recid
     1897       .
     1898   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1899   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1900     (input  buf_fbr-line.artic
     1901     ,input  buf_fbr-line.prod-type
     1902     ,input  buf_fbr-line.prod-code
     1903     ,output v-gds-code
     1904     ) no-error .
     1905       if error-status :error
     1906       then do:
     1907         undo, return error substitute("&1 &2 &3&4Ошибка определения кода товара (артикул &7).&4&5&4&6"
     1908                                         ,vss-workfile
     1909                                         ,vss-revision
     1910                                         ,vss-description
     1911                                         ,chr(10)
     1912                                         , error-status:get-message(1)
     1913                                         , return-value
     1914                                         , buf_fbr-line.artic
     1915                                         ).
     1916       end.
     1917   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1918     (input  v-gds-code
     1919     ,input  ?
     1920     ,output v-b-code
     1921     ) no-error .
     1922       if error-status :error
     1923       then do:
     1924         undo, return error substitute("&1 &2 &3&4Ошибка определения основного бар-кода товара (код товара) &7.&4&5&4&6"
     1925                                         ,vss-workfile
     1926                                         ,vss-revision
     1927                                         ,vss-description
     1928                                         ,chr(10)
     1929                                         , error-status:get-message(1)
     1930                                         , return-value
     1931                                         , v-gds-code
     1932                                         ).
     1933       end.
     1934       if buf_fbr-line.is-calc = no
     1935       then do:
     1936   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1937   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1938     (input  p-price-obj-type
     1939     ,input  p-price-obj-code
     1940     ,input  v-b-code
     1941     ,input  0
     1942     ,input  0
     1943     ,output v-void-char
     1944     ,output p-current-price
     1945     ,output v-void
     1946     ,output v-void
     1947     ) no-error .
     1948           if error-status :error
     1949           then do:
     1950             undo, return error substitute("&1 &2 &3&4Ошибка определения продажной цены основного бар-кода товара (код товара) &7.&4&5&4&6"
     1951                                             ,vss-workfile
     1952                                             ,vss-revision
     1953                                             ,vss-description
     1954                                             ,chr(10)
     1955                                             , error-status:get-message(1)
     1956                                             , return-value
     1957                                             , v-gds-code
     1958                                             ).
     1959           end.
     1960       end.
     1961       else do:
     1962           assign
     1963               p-current-price = buf_fbr-line.price-sale
     1964           .
     1965       end.
     1966   end.
     1967   end procedure.
     1968   procedure fbrlib-put-in-order-recipe :
     1969   do
     1970   on error undo, return error
     1971   :
     1972   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     1973       define variable v-recipe-counter    as integer          no-undo.
     1974       define variable v-recipe-amount     as integer init 0   no-undo.
     1975       define variable v-child-counter     as integer          no-undo.
     1976       define variable v-is-call-cycle     as logical          no-undo.
     1977       define variable v-str as character     no-undo.
     1978       define buffer buf_in_fbr-line       for ub.fbr-line.
     1979       define buffer buf_dress_fbr-line    for ub.fbr-line.
     1980       define buffer buf_fbr-line          for ub.fbr-line.
     1981       define buffer buf_recipe-gds        for ub.recipe-gds.
     1982       define buffer buf_recipe            for ub.recipe.
     1983       for each temp_recipe-childs-qnty
     1984       :
     1985           delete temp_recipe-childs-qnty.
     1986       end.
     1987       for each temp_recipe-childs
     1988       :
     1989           delete temp_recipe-childs.
     1990       end.
     1991       for each temp_recipe-order
     1992       :
     1993           delete temp_recipe-order.
     1994       end.
     1995       for each buf_fbr-line no-lock
     1996          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     1997       on error undo, return error
     1998       :
     1999           find first temp_recipe-childs-qnty
     2000                where temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     2001           no-error.
     2002           if not available temp_recipe-childs-qnty
     2003           then do:
     2004               create temp_recipe-childs-qnty.
     2005               assign
     2006                   v-recipe-amount                     = v-recipe-amount + 1
     2007                   temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     2008                   temp_recipe-childs-qnty.order       = v-recipe-amount
     2009                   temp_recipe-childs-qnty.childs-qnty = 0
     2010                   v-child-counter                     = 0
     2011               .
     2012           end.
     2013       end.
     2014       for each buf_in_fbr-line no-lock
     2015          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     2016            and buf_in_fbr-line.trn-type = 'спи':U
     2017       on error undo, return error
     2018       :
     2019           for each buf_dress_fbr-line no-lock
     2020              where buf_dress_fbr-line.doc-code    = p-fbr-doc-doc-code
     2021                and buf_dress_fbr-line.trn-type    = 'при':U
     2022                and buf_dress_fbr-line.artic       = buf_in_fbr-line.artic
     2023                and buf_dress_fbr-line.prod-type   = buf_in_fbr-line.prod-type
     2024                and buf_dress_fbr-line.prod-code   = buf_in_fbr-line.prod-code
     2025           on error undo, return error
     2026           :
     2027               find first buf_recipe no-lock
     2028                    where buf_recipe.recipe-code = buf_dress_fbr-line.recipe-code
     2029               .
     2030               if buf_in_fbr-line.is-comp = yes
     2031               then do:
     2032                   find last temp_recipe-childs-qnty
     2033                       where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     2034                   .
     2035                   assign
     2036                       temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     2037                   .
     2038                   create temp_recipe-childs.
     2039                   assign
     2040                       temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     2041                       temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     2042                       temp_recipe-childs.child-recipe-code    = buf_dress_fbr-line.recipe-code
     2043                   .
     2044               end.
     2045               else do:
     2046               end.
     2047           end.
     2048       end.
     2049       for each buf_in_fbr-line no-lock
     2050          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     2051            and buf_in_fbr-line.trn-type = 'при':U
     2052       on error undo, return error
     2053       :
     2054           find first buf_recipe no-lock
     2055                where buf_recipe.recipe-code = buf_in_fbr-line.recipe-code
     2056           no-error.
     2057           if buf_in_fbr-line.is-comp = no
     2058           then do:
     2059           end.
     2060           else do:
     2061               for each buf_recipe-gds no-lock
     2062               where buf_recipe-gds.recipe-code = buf_in_fbr-line.recipe-code
     2063               :
     2064                   for each buf_fbr-line no-lock
     2065                   where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     2066                       and buf_fbr-line.trn-type    = 'при':U
     2067                       and buf_fbr-line.artic       = buf_recipe-gds.artic
     2068                       and buf_fbr-line.prod-type   = buf_recipe-gds.prod-type
     2069                       and buf_fbr-line.prod-code   = buf_recipe-gds.prod-code
     2070                   on error undo, return error
     2071                   :
     2072                       find first buf_recipe no-lock
     2073                            where buf_recipe.recipe-code = buf_fbr-line.recipe-code
     2074                       .
     2075                       if buf_recipe.recipe-type = 'разделка':U
     2076                       then do:
     2077                       end.
     2078                       else do:
     2079                           find last temp_recipe-childs-qnty
     2080                               where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     2081                           .
     2082                           assign
     2083                               temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     2084                           .
     2085                           create temp_recipe-childs.
     2086                           assign
     2087                               temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     2088                               temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     2089                               temp_recipe-childs.child-recipe-code    = buf_fbr-line.recipe-code
     2090                           .
     2091                       end.
     2092                   end.
     2093               end.
     2094           end.
     2095       end.
     2096       for each temp_recipe-order
     2097       on error undo, return error
     2098       :
     2099           delete temp_recipe-order.
     2100       end.
     2101       assign
     2102           v-fbrlib-recipe-order = 0
     2103       .
     2104       do v-recipe-counter = 1 to v-recipe-amount
     2105       on error undo, return error
     2106       :
     2107           run fbrlib-add-recipe-in-tmp-order in this-procedure (
     2108                 input v-recipe-counter
     2109               , input 0
     2110               , output v-is-call-cycle
     2111           ).
     2112           if v-is-call-cycle = yes
     2113           then do:
     2114               message
     2115                       "Достигнут максимальный уровень вложенности рецептов."
     2116                   skip(1)
     2117                   skip "Невозможно упорядочить рецепты."
     2118                   skip(1)
     2119                   skip "Необходимо изменить структуру рецептов,"
     2120                   skip "используемых при формировании"
     2121                   skip "данного документа производства."
     2122               view-as alert-box error
     2123               title "Невозможно рассчитать документ производства".
     2124               for each temp_recipe-childs-qnty
     2125               :
     2126                   delete temp_recipe-childs-qnty.
     2127               end.
     2128               for each temp_recipe-childs
     2129               :
     2130                   delete temp_recipe-childs.
     2131               end.
     2132               for each temp_recipe-order
     2133               :
     2134                   delete temp_recipe-order.
     2135               end.
     2136               for each temp_recipe-order
     2137               on error undo, return error
     2138               :
     2139                   delete temp_recipe-order.
     2140               end.
     2141               for each temp_fbrlib_recipe
     2142               on error undo, return error
     2143               :
     2144                   delete temp_recipe-order.
     2145               end.
     2146               undo, return error.
     2147           end.
     2148       end.
     2149   end.
     2150   end procedure.
     2151   procedure fbrlib-add-recipe-in-tmp-order :
     2152   do
     2153   on error undo, return error
     2154   :
     2155   define input parameter p-order              as integer      no-undo.
     2156   define input parameter p-call-counter       as integer      no-undo.
     2157   define output parameter p-is-call-cycle     as logical      no-undo.
     2158       define variable v-nodes-counter     as integer       no-undo.
     2159       define buffer buf_c_temp_recipe-childs-qnty for temp_recipe-childs-qnty.
     2160       define buffer buf_temp_recipe-childs-qnty   for temp_recipe-childs-qnty.
     2161       define buffer buf_temp_recipe-childs        for temp_recipe-childs     .
     2162       define buffer buf_temp_recipe-order         for temp_recipe-order.
     2163       assign
     2164           p-call-counter = p-call-counter + 1
     2165       .
     2166       if p-call-counter > 50
     2167       then do:
     2168           assign
     2169               p-is-call-cycle = yes
     2170           .
     2171       end.
     2172       else do:
     2173           find first buf_temp_recipe-childs-qnty
     2174                where buf_temp_recipe-childs-qnty.order = p-order
     2175           .
     2176           find first buf_temp_recipe-order
     2177                where buf_temp_recipe-order.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     2178           no-error.
     2179           if not available buf_temp_recipe-order
     2180           then do:
     2181               do v-nodes-counter = 1 to buf_temp_recipe-childs-qnty.childs-qnty
     2182               :
     2183                   find first buf_temp_recipe-childs
     2184                        where buf_temp_recipe-childs.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     2185                          and buf_temp_recipe-childs.child-code  = v-nodes-counter
     2186                   .
     2187                   find first buf_c_temp_recipe-childs-qnty
     2188                        where buf_c_temp_recipe-childs-qnty.recipe-code = buf_temp_recipe-childs.child-recipe-code
     2189                   .
     2190                   run fbrlib-add-recipe-in-tmp-order in this-procedure (
     2191                         input buf_c_temp_recipe-childs-qnty.order
     2192                       , input p-call-counter
     2193                       , output p-is-call-cycle
     2194                   ).
     2195                   if p-is-call-cycle = yes
     2196                   then do:
     2197                       return.
     2198                   end.
     2199               end.
     2200               assign
     2201                   v-fbrlib-recipe-order = v-fbrlib-recipe-order + 1
     2202               .
     2203               create buf_temp_recipe-order.
     2204               assign
     2205                   buf_temp_recipe-order.recipe-code   = buf_temp_recipe-childs-qnty.recipe-code
     2206                   buf_temp_recipe-order.order         = v-fbrlib-recipe-order
     2207               .
     2208           end.
     2209       end.
     2210   end.
     2211   end procedure.
     2212   procedure fbrlib-get-trn-type :
     2213   define input parameter p-recipe-code    as character    no-undo.
     2214   define input parameter p-goods-recid    as recid        no-undo.
     2215   define input parameter p-is-integration as logical      no-undo.
     2216   define output parameter p-is-comp       as logical      no-undo.
     2217   define output parameter p-trn-type      as character    no-undo.
     2218   define buffer buf_recipe    for ub.recipe.
     2219   define buffer buf_goods     for ub.goods.
     2220   do
     2221   for buf_recipe
     2222     , buf_goods
     2223   on error undo, return error
     2224   :
     2225       find first buf_goods no-lock
     2226            where recid( buf_goods ) = p-goods-recid
     2227       .
     2228       find first buf_recipe no-lock
     2229            where buf_recipe.recipe-code = p-recipe-code
     2230       no-error.
     2231       if not available buf_recipe
     2232       then do:
     2233           assign
     2234               p-is-comp = no
     2235               p-trn-type = "":U
     2236           .
     2237           undo, return.
     2238       end.
     2239       if  buf_recipe.artic        = buf_goods.artic
     2240       and buf_recipe.prod-type    = buf_goods.prod-type
     2241       and buf_recipe.prod-code    = buf_goods.prod-code
     2242       then do:
     2243           assign
     2244               p-is-comp = yes
     2245           .
     2246       end.
     2247       else do:
     2248           assign
     2249               p-is-comp = no
     2250           .
     2251       end.
     2252       case buf_recipe.recipe-type
     2253       :
     2254           when 'производство':U
     2255           then do:
     2256               if p-is-comp = yes
     2257               then do:
     2258                   assign
     2259                       p-trn-type = 'при':U
     2260                   .
     2261               end.
     2262               else do:
     2263                   assign
     2264                       p-trn-type = 'спи':U
     2265                   .
     2266               end.
     2267           end.
     2268           when 'альтернатива':U
     2269           then do:
     2270               if p-is-comp = yes
     2271               then do:
     2272                   assign
     2273                       p-trn-type = 'при':U
     2274                   .
     2275               end.
     2276               else do:
     2277                   assign
     2278                       p-trn-type = 'спи':U
     2279                   .
     2280               end.
     2281           end.
     2282           when 'разделка':U
     2283           then do:
     2284               if p-is-comp = no
     2285               then do:
     2286                   assign
     2287                       p-trn-type = 'при':U
     2288                   .
     2289               end.
     2290               else do:
     2291                   assign
     2292                       p-trn-type = 'спи':U
     2293                   .
     2294               end.
     2295           end.
     2296           when 'комплектация':U
     2297           then do:
     2298               if p-is-integration = ?
     2299               then do:
     2300                   message
     2301                       "Выберите тип операции по рецепту комплектации:"
     2302                       skip (2) "YES - комплектация"
     2303                       skip     "NO - разукомплектация"
     2304                   view-as alert-box question
     2305                   buttons YES-NO
     2306                   update p-is-integration.
     2307               end.
     2308               if p-is-integration = yes
     2309               then do:
     2310                   if p-is-comp = yes
     2311                   then do:
     2312                       assign
     2313                           p-trn-type = 'при':U
     2314                       .
     2315                   end.
     2316                   else do:
     2317                       assign
     2318                           p-trn-type = 'спи':U
     2319                       .
     2320                   end.
     2321               end.
     2322               else do:
     2323                   if p-is-comp = yes
     2324                   then do:
     2325                       assign
     2326                           p-trn-type = 'спи':U
     2327                       .
     2328                   end.
     2329                   else do:
     2330                       assign
     2331                           p-trn-type = 'при':U
     2332                       .
     2333                   end.
     2334               end.
     2335           end.
     2336       end case.
     2337   end.
     2338   end procedure.
     2339   procedure fbrlib-get-mark :
     2340   define input parameter p-recipe-code    as character    no-undo.
     2341   define output parameter p-mark          as logical    no-undo.
     2342   define buffer buf_goods-attr     for ub.goods-attr.
     2343   define buffer buf_recipe-gds for ub.recipe-gds .
     2344       for each buf_recipe-gds no-lock where buf_recipe-gds.recipe-code = p-recipe-code,
     2345            first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_recipe-gds.gds-code and
     2346                                               buf_goods-attr.attr-code = 'mark-type':U:
     2347            if buf_goods-attr.attr-value <> "" and buf_goods-attr.attr-value <> "not-type" then do:
     2348               p-mark = true .
     2349               return .
     2350            end.
     2351       end.
     2352   end procedure.
     2353   procedure fbrlib-check-temp-tables :
     2354   do
     2355   on error undo, return error
     2356   :
     2357   define input parameter p-title  as character    no-undo.
     2358       define variable v-str               as character        no-undo.
     2359       assign
     2360           v-str = v-str + chr(10) + "temp_recipe-childs-qnty:" + chr(10)
     2361       .
     2362       for each temp_recipe-childs-qnty
     2363       on error undo, return error
     2364       :
     2365           assign
     2366               v-str   = v-str + string( temp_recipe-childs-qnty.recipe-code )
     2367                       + "   " + string( temp_recipe-childs-qnty.childs-qnty )
     2368                       + "   " + string( temp_recipe-childs-qnty.order )
     2369                       + chr(10)
     2370           .
     2371       end.
     2372       assign
     2373           v-str = v-str + "temp_recipe-childs:" + chr(10)
     2374       .
     2375       for each temp_recipe-childs
     2376       on error undo, return error
     2377       :
     2378           assign
     2379               v-str   = v-str + string( temp_recipe-childs.recipe-code )
     2380                       + "   " + string( temp_recipe-childs.child-code )
     2381                       + "   " + string( temp_recipe-childs.child-recipe-code )
     2382                       + chr(10)
     2383           .
     2384       end.
     2385       assign
     2386           v-str = v-str + chr(10) + "temp_recipe-order:" + chr(10)
     2387       .
     2388       for each temp_recipe-order
     2389       on error undo, return error
     2390       :
     2391           assign
     2392               v-str   = v-str + string( temp_recipe-order.recipe-code )
     2393                       + "   " + string( temp_recipe-order.order )
     2394                       + chr(10)
     2395           .
     2396       end.
     2397       assign
     2398           v-str = v-str + chr(10) + "temp_fbrlib_recipe:" + chr(10)
     2399       .
     2400       run writelog in this-procedure ( input "fbr.log", input 0, input p-title ).
     2401       run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     2402       for each temp_fbrlib_recipe
     2403       on error undo, return error
     2404       :
     2405           assign
     2406               v-str   = "recipe-code: "                   + string( temp_fbrlib_recipe.recipe-code                 )
     2407                       + "   " + "count-income: "                  + string( temp_fbrlib_recipe.count-income                )
     2408                       + "   " + "qnty-income: "                   + string( temp_fbrlib_recipe.qnty-income                 )
     2409                       + "   " + "sum-income-sale: "               + string( temp_fbrlib_recipe.sum-income-sale             )
     2410                       + "   " + "sum-income-cost-base: "          + string( temp_fbrlib_recipe.sum-income-cost-base        )
     2411                       + "   " + "sum-income-cost-rubl: "          + string( temp_fbrlib_recipe.sum-income-cost-rubl        )
     2412                       + "   " + "sum-income-vat-cost-base: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-base    )
     2413                       + "   " + "sum-income-vat-cost-rubl: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-rubl    )
     2414                       + "   " + "count-write-off: "               + string( temp_fbrlib_recipe.count-write-off             )
     2415                       + "   " + "qnty-write-off: "                + string( temp_fbrlib_recipe.qnty-write-off              )
     2416                       + "   " + "sum-write-off-sale: "            + string( temp_fbrlib_recipe.sum-write-off-sale          )
     2417                       + "   " + "sum-write-off-cost-base: "       + string( temp_fbrlib_recipe.sum-write-off-cost-base     )
     2418                       + "   " + "sum-write-off-cost-rubl: "       + string( temp_fbrlib_recipe.sum-write-off-cost-rubl     )
     2419                       + "   " + "sum-write-off-vat-cost-base: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-base )
     2420                       + "   " + "sum-write-off-vat-cost-rubl: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-rubl )
     2421                       + chr(10)
     2422           .
     2423           run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     2424       end.
     2425   end.
     2426   end procedure.
     2427   procedure fbrlib-s-coeff-value :
     2428   define input  parameter p-gds-code    as integer        no-undo.
     2429   define input  parameter p-date        as date           no-undo.
     2430   define input  parameter p-obj-type    as character      no-undo.
     2431   define input  parameter p-obj-code    as integer        no-undo.
     2432   define output parameter p-coeff-value as decimal        no-undo.
     2433   define variable vss-description as character init "fbrlib-s-coeff-value-01: определяет значение сезонного коэффициента" no-undo.
     2434       define variable v-date          as date         no-undo.
     2435       define variable v-host-code     as integer      no-undo.
     2436       define buffer buf_goods       for ub.goods.
     2437       define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     2438       define buffer buf_clients     for ub.clients.
     2439       define buffer buf_s-coeff     for ub.s-coeff.
     2440   do
     2441   for buf_goods
     2442     , buf_fbr-gds-obj
     2443     , buf_clients
     2444     , buf_s-coeff
     2445   on error undo, return error return-value
     2446   :
     2447       find first buf_goods no-lock
     2448            where buf_goods.gds-code = p-gds-code
     2449       no-error .
     2450       if not available buf_goods
     2451       then do:
     2452          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден товар с кодом &1", p-gds-code).
     2453       end.
     2454       find first buf_clients no-lock
     2455            where buf_clients.obj-type = p-obj-type
     2456              and buf_clients.obj-code = p-obj-code
     2457       no-error.
     2458       if not available buf_clients
     2459       then do:
     2460          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден объект &1&2", p-obj-type, p-obj-code).
     2461       end.
     2462       assign
     2463           v-date = date(month(p-date), day(p-date), Year(01/01/1996))
     2464       .
     2465       find first buf_fbr-gds-obj no-lock
     2466            where buf_fbr-gds-obj.gds-code = p-gds-code
     2467              and buf_fbr-gds-obj.obj-type = p-obj-type
     2468              and buf_fbr-gds-obj.obj-code = p-obj-code
     2469       no-error.
     2470       if not available buf_fbr-gds-obj
     2471       or buf_fbr-gds-obj.is-season = no
     2472       then do:
     2473           assign
     2474               p-coeff-value = 0
     2475           .
     2476           return.
     2477       end.
     2478   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2479   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2480     (input  p-obj-type
     2481     ,input  p-obj-code
     2482     ,output v-host-code
     2483     )  .
     2484       find last buf_s-coeff no-lock
     2485           where buf_s-coeff.gds-code = p-gds-code
     2486             and buf_s-coeff.host-code = v-host-code
     2487             and buf_s-coeff.obj-type = p-obj-type
     2488             and buf_s-coeff.obj-code = p-obj-code
     2489             and buf_s-coeff.s-date <= v-date
     2490       no-error.
     2491       if available buf_s-coeff
     2492       then do:
     2493           assign
     2494               p-coeff-value = buf_s-coeff.coeff-value
     2495           .
     2496           return.
     2497       end.
     2498       find last buf_s-coeff no-lock
     2499           where buf_s-coeff.gds-code = p-gds-code
     2500             and buf_s-coeff.host-code = v-host-code
     2501             and buf_s-coeff.obj-type = "":U
     2502             and buf_s-coeff.obj-code = 0
     2503             and buf_s-coeff.s-date <= v-date
     2504       no-error.
     2505       if available buf_s-coeff
     2506       then do:
     2507           assign
     2508               p-coeff-value = buf_s-coeff.coeff-value
     2509           .
     2510           return.
     2511       end.
     2512       find last buf_s-coeff no-lock
     2513           where buf_s-coeff.gds-code = p-gds-code
     2514             and buf_s-coeff.host-code = 0
     2515             and buf_s-coeff.obj-type = "":U
     2516             and buf_s-coeff.obj-code = 0
     2517             and buf_s-coeff.s-date <= v-date
     2518       no-error.
     2519       if available buf_s-coeff
     2520       then do:
     2521           assign
     2522               p-coeff-value = buf_s-coeff.coeff-value
     2523           .
     2524       end.
     2525       else do:
     2526           assign
     2527               p-coeff-value = 0
     2528           .
     2529       end.
     2530   end.
     2531   end procedure.
     2532   procedure fbrlib_create-fbr-recipe-gds :
     2533   define input parameter p-doc-code         as character      no-undo.
     2534   define input parameter p-recipe-code      as character      no-undo.
     2535   define input parameter p-prod-type        as character      no-undo.
     2536   define input parameter p-prod-code        as integer        no-undo.
     2537   define input parameter p-artic            as character      no-undo.
     2538   define input parameter p-gds-code         as integer        no-undo.
     2539   define input parameter p-is-waste         as logical        no-undo.
     2540   define input parameter p-proc-number      as integer        no-undo.
     2541   define input parameter p-obj-date         as date           no-undo.
     2542   define input parameter p-obj-type         as character      no-undo.
     2543   define input parameter p-obj-code         as integer        no-undo.
     2544   define input parameter p-calc-method      as decimal        no-undo.
     2545   define input parameter p-coeff-waste      as decimal        no-undo.
     2546   define input parameter p-orig-qnty        as decimal        no-undo.
     2547   define input parameter p-orig-brutto-qnty as decimal        no-undo.
     2548       define variable v-coeff-season  as decimal      no-undo.
     2549       define variable v-void-decimal  as decimal      no-undo.
     2550       define variable v-void-integer  as integer      no-undo.
     2551       define variable v-recipe-type   as character    no-undo.
     2552       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     2553       define buffer buf_goods             for ub.goods.
     2554       define buffer buf_recipe            for ub.recipe.
     2555   do
     2556   for buf_fbr-recipe-gds
     2557     , buf_recipe
     2558     , buf_goods
     2559   on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2560   :
     2561       find first buf_fbr-recipe-gds exclusive-lock
     2562            where buf_fbr-recipe-gds.doc-code    = p-doc-code
     2563              and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     2564              and buf_fbr-recipe-gds.prod-type   = p-prod-type
     2565              and buf_fbr-recipe-gds.prod-code   = p-prod-code
     2566              and buf_fbr-recipe-gds.artic       = p-artic
     2567       no-error.
     2568       if not available buf_fbr-recipe-gds
     2569       then do:
     2570           create buf_fbr-recipe-gds.
     2571           assign
     2572               buf_fbr-recipe-gds.doc-code           = p-doc-code
     2573               buf_fbr-recipe-gds.recipe-code        = p-recipe-code
     2574               buf_fbr-recipe-gds.prod-type          = p-prod-type
     2575               buf_fbr-recipe-gds.prod-code          = p-prod-code
     2576               buf_fbr-recipe-gds.artic              = p-artic
     2577               buf_fbr-recipe-gds.gds-code           = p-gds-code
     2578               buf_fbr-recipe-gds.is-waste           = p-is-waste
     2579               buf_fbr-recipe-gds.proc-number        = p-proc-number
     2580               buf_fbr-recipe-gds.recipe-qnty        = p-orig-qnty
     2581               buf_fbr-recipe-gds.recipe-brutto-qnty = p-orig-brutto-qnty
     2582           .
     2583           find first buf_goods no-lock
     2584                where buf_goods.prod-type = buf_fbr-recipe-gds.prod-type
     2585                  and buf_goods.prod-code = buf_fbr-recipe-gds.prod-code
     2586                  and buf_goods.artic     = buf_fbr-recipe-gds.artic
     2587           .
     2588           run fbrlib-s-coeff-value in this-procedure (
     2589                 input buf_goods.gds-code
     2590               , input p-obj-date
     2591               , input p-obj-type
     2592               , input p-obj-code
     2593               , output v-coeff-season
     2594           ) no-error.
     2595           if error-status:error
     2596           then do:
     2597               return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
     2598           end.
     2599           assign
     2600               buf_fbr-recipe-gds.qnty         = p-orig-qnty
     2601               buf_fbr-recipe-gds.coeff-value  = v-coeff-season
     2602               buf_fbr-recipe-gds.coeff-waste  = p-coeff-waste
     2603           .
     2604           run fbrlib-get-recipe-type in this-procedure (
     2605                 input buf_fbr-recipe-gds.doc-code
     2606               , input buf_fbr-recipe-gds.recipe-code
     2607               , output v-recipe-type
     2608           ).
     2609           if v-recipe-type <> 'производство':U
     2610           then do:
     2611               assign
     2612                   buf_fbr-recipe-gds.coeff-value  = 0
     2613                   buf_fbr-recipe-gds.coeff-waste  = 0
     2614                   buf_fbr-recipe-gds.calc-method  = 1
     2615                   buf_fbr-recipe-gds.brutto-qnty  = buf_fbr-recipe-gds.qnty
     2616               .
     2617           end.
     2618           else do:
     2619               run fbrlib-calc-brutto in this-procedure (
     2620                     input v-recipe-type
     2621                   , input buf_fbr-recipe-gds.qnty
     2622                   , input buf_fbr-recipe-gds.coeff-value
     2623                   , input buf_fbr-recipe-gds.coeff-waste
     2624                   , input 0
     2625                   , input 3
     2626                   , output v-void-decimal
     2627                   , output v-void-decimal
     2628                   , output buf_fbr-recipe-gds.brutto-qnty
     2629                   , output v-void-integer
     2630               ).
     2631               assign
     2632                   buf_fbr-recipe-gds.calc-method  = p-calc-method
     2633               .
     2634               run fbrlib-calc-brutto in this-procedure (
     2635                     input v-recipe-type
     2636                   , input buf_fbr-recipe-gds.qnty
     2637                   , input buf_fbr-recipe-gds.coeff-value
     2638                   , input buf_fbr-recipe-gds.coeff-waste
     2639                   , input buf_fbr-recipe-gds.brutto-qnty
     2640                   , input buf_fbr-recipe-gds.calc-method
     2641                   , output buf_fbr-recipe-gds.qnty
     2642                   , output v-void-decimal
     2643                   , output v-void-decimal
     2644                   , output v-void-integer
     2645               ).
     2646           end.
     2647       end.
     2648   end.
     2649   end procedure.
     2650   procedure fbrlib-set-default-recipe :
     2651   define input parameter p-obj-type   as character    no-undo.
     2652   define input parameter p-obj-code   as integer      no-undo.
     2653   define input parameter p-gds-code   as integer      no-undo.
     2654       define variable v-artic             as character    no-undo.
     2655       define variable v-prod-type         as character    no-undo.
     2656       define variable v-prod-code         as character    no-undo.
     2657       define variable v-recipe-code       as character    no-undo.
     2658       define variable v-fbr-gds-obj-recid as recid        no-undo.
     2659       define variable v-recipe-found      as logical      no-undo.
     2660       define buffer buf_recipe        for ub.recipe.
     2661       define buffer buf_other_recipe  for ub.recipe.
     2662       define buffer buf_goods         for ub.goods.
     2663       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     2664   do
     2665   for buf_recipe
     2666     , buf_goods
     2667     , buf_fbr-gds-obj
     2668   on error undo, return error
     2669   :
     2670       find first buf_goods no-lock
     2671            where buf_goods.gds-code = p-gds-code
     2672       .
     2673       run fbrlib-get-obj-recipe in this-procedure (
     2674             input p-obj-type
     2675           , input p-obj-code
     2676           , input p-gds-code
     2677           , output v-recipe-code
     2678       ).
     2679       if v-recipe-code <> ""
     2680       then do:
     2681           find first buf_recipe no-lock
     2682               where buf_recipe.recipe-code = v-recipe-code
     2683           no-error.
     2684           if not available buf_recipe
     2685           then do:
     2686               assign
     2687                   v-recipe-code = ""
     2688               .
     2689           end.
     2690       end.
     2691       if v-recipe-code = ""
     2692       then do:
     2693           find first buf_fbr-gds-obj exclusive-lock
     2694                where buf_fbr-gds-obj.obj-type = p-obj-type
     2695                  and buf_fbr-gds-obj.obj-code = p-obj-code
     2696                  and buf_fbr-gds-obj.gds-code = p-gds-code
     2697           no-error.
     2698           if not available buf_fbr-gds-obj
     2699           then do:
     2700               run ref/fgdsobj1.p (
     2701                     input-output v-fbr-gds-obj-recid
     2702                   , input 'ДОБАВЛЕНИЕ':U
     2703                   , input no
     2704                   , input p-gds-code
     2705                   , input p-obj-type
     2706                   , input p-obj-code
     2707                   , input 0
     2708                   , input ""
     2709                   , input 0
     2710                   , input no
     2711                   , input no
     2712                   , input no
     2713                   , input no
     2714                   , input no
     2715                   , input no
     2716               ) no-error.
     2717               if error-status:error
     2718               then do:
     2719                   message
     2720                           vss-workfile vss-revision vss-description
     2721                       skip "Ошибка изменения атрибутов товара на объекте"
     2722                       skip return-value
     2723                       skip trim(error-status :get-message(1))
     2724                               trim(error-status :get-message(2))
     2725                               trim(error-status :get-message(3))
     2726                   view-as alert-box error.
     2727                   undo, return error .
     2728               end.
     2729               find first buf_fbr-gds-obj exclusive-lock
     2730                    where recid( buf_fbr-gds-obj ) = v-fbr-gds-obj-recid
     2731               .
     2732           end.
     2733           assign
     2734               v-recipe-found = no
     2735           .
     2736           for first buf_recipe no-lock
     2737               where buf_recipe.obj-type    = p-obj-type
     2738                 and buf_recipe.obj-code    = p-obj-code
     2739                 and buf_recipe.artic       = buf_goods.artic
     2740                 and buf_recipe.prod-type   = buf_goods.prod-type
     2741                 and buf_recipe.prod-code   = buf_goods.prod-code
     2742                 and buf_recipe.recipe-type = 'производство':U
     2743                 or (
     2744                     buf_recipe.obj-type    = ""
     2745                 and buf_recipe.obj-code    = 0
     2746                 and buf_recipe.artic       = buf_goods.artic
     2747                 and buf_recipe.prod-type   = buf_goods.prod-type
     2748                 and buf_recipe.prod-code   = buf_goods.prod-code
     2749                 and buf_recipe.recipe-type = 'производство':U
     2750                     )
     2751           :
     2752               assign
     2753                   v-recipe-found = yes
     2754                   buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2755               .
     2756           end.
     2757           if v-recipe-found = no
     2758           then do:
     2759               for first buf_recipe no-lock
     2760                   where buf_recipe.obj-type    = p-obj-type
     2761                     and buf_recipe.obj-code    = p-obj-code
     2762                     and buf_recipe.artic       = buf_goods.artic
     2763                     and buf_recipe.prod-type   = buf_goods.prod-type
     2764                     and buf_recipe.prod-code   = buf_goods.prod-code
     2765                     and buf_recipe.recipe-type <> 'альтернатива':U
     2766                     or (
     2767                         buf_recipe.obj-type    = ""
     2768                     and buf_recipe.obj-code    = 0
     2769                     and buf_recipe.artic       = buf_goods.artic
     2770                     and buf_recipe.prod-type   = buf_goods.prod-type
     2771                     and buf_recipe.prod-code   = buf_goods.prod-code
     2772                     and buf_recipe.recipe-type <> 'альтернатива':U
     2773                         )
     2774               :
     2775                   assign
     2776                       v-recipe-found = yes
     2777                       buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2778                   .
     2779               end.
     2780               if v-recipe-found = no
     2781               then do:
     2782                   for first buf_recipe no-lock
     2783                       where buf_recipe.obj-type    = p-obj-type
     2784                         and buf_recipe.obj-code    = p-obj-code
     2785                         and buf_recipe.artic       = buf_goods.artic
     2786                         and buf_recipe.prod-type   = buf_goods.prod-type
     2787                         and buf_recipe.prod-code   = buf_goods.prod-code
     2788                         or (
     2789                             buf_recipe.obj-type    = ""
     2790                         and buf_recipe.obj-code    = 0
     2791                         and buf_recipe.artic       = buf_goods.artic
     2792                         and buf_recipe.prod-type   = buf_goods.prod-type
     2793                         and buf_recipe.prod-code   = buf_goods.prod-code
     2794                             )
     2795                   :
     2796                       assign
     2797                           v-recipe-found = yes
     2798                           buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2799                       .
     2800                   end.
     2801                   if v-recipe-found = no
     2802                   then do:
     2803                       assign
     2804                           buf_fbr-gds-obj.default-recipe-code = ""
     2805                       .
     2806                   end.
     2807               end.
     2808           end.
     2809       end.
     2810   end.
     2811   end procedure.
     2812   procedure fbrlib-get-obj-recipe :
     2813   define input parameter p-obj-type       as character    no-undo.
     2814   define input parameter p-obj-code       as integer      no-undo.
     2815   define input parameter p-gds-code       as integer      no-undo.
     2816   define output parameter p-recipe-code   as character    no-undo.
     2817       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     2818   do
     2819   for buf_fbr-gds-obj
     2820   on error undo, return error
     2821   :
     2822       find first buf_fbr-gds-obj no-lock
     2823            where buf_fbr-gds-obj.obj-type = p-obj-type
     2824              and buf_fbr-gds-obj.obj-code = p-obj-code
     2825              and buf_fbr-gds-obj.gds-code = p-gds-code
     2826       no-error.
     2827       if available buf_fbr-gds-obj
     2828       then do:
     2829           assign
     2830               p-recipe-code = buf_fbr-gds-obj.default-recipe-code
     2831           .
     2832       end.
     2833       else do:
     2834           assign
     2835               p-recipe-code = ""
     2836           .
     2837       end.
     2838   end.
     2839   end procedure.
     2840   procedure fbrlib-create-or-update-recipe-gds :
     2841   define input parameter p-recipe-code    as character        no-undo.
     2842   define input parameter p-gds-code       as integer          no-undo.
     2843   define input parameter p-is-waste       as logical          no-undo.
     2844   define input parameter p-qnty           as decimal          no-undo.
     2845   define input parameter p-proc-number    as integer          no-undo.
     2846   define input parameter p-nws-self       as logical          no-undo.
     2847       define variable v-max-proc-num  as integer      no-undo.
     2848       define variable v-recipe-type   as character    no-undo.
     2849       define buffer buf_goods             for ub.goods.
     2850       define buffer buf_recipe-gds        for ub.recipe-gds.
     2851       define buffer buf_recipe            for ub.recipe.
     2852       define buffer buf_proc_recipe-gds   for ub.recipe-gds.
     2853   do
     2854   for buf_goods
     2855     , buf_recipe-gds
     2856     , buf_recipe
     2857     , buf_proc_recipe-gds
     2858   on error undo, return error
     2859   :
     2860       find first buf_recipe no-lock
     2861            where buf_recipe.recipe-code = p-recipe-code
     2862       .
     2863       find first buf_goods no-lock
     2864            where buf_goods.gds-code = p-gds-code
     2865       .
     2866       find first buf_recipe-gds
     2867            where buf_recipe-gds.recipe-code = p-recipe-code
     2868              and buf_recipe-gds.prod-type   = buf_goods.prod-type
     2869              and buf_recipe-gds.prod-code   = buf_goods.prod-code
     2870              and buf_recipe-gds.artic       = buf_goods.artic
     2871       no-error.
     2872       if not available buf_recipe-gds
     2873       then do:
     2874           create buf_recipe-gds.
     2875           assign
     2876               buf_recipe-gds.recipe-code = p-recipe-code
     2877               buf_recipe-gds.gds-code    = p-gds-code
     2878               buf_recipe-gds.prod-type   = buf_goods.prod-type
     2879               buf_recipe-gds.prod-code   = buf_goods.prod-code
     2880               buf_recipe-gds.artic       = buf_goods.artic
     2881           .
     2882           assign
     2883               buf_recipe-gds.is-waste    = no
     2884               buf_recipe-gds.qnty        = 0
     2885               buf_recipe-gds.coeff-waste = 0
     2886               buf_recipe-gds.brutto-qnty = 0
     2887               buf_recipe-gds.proc-number = 0
     2888               buf_recipe-gds.nws-self    = no
     2889           .
     2890       end.
     2891       assign
     2892           buf_recipe-gds.is-waste    = p-is-waste
     2893       .
     2894       run fbrlib-get-recipe-type in this-procedure (
     2895             input "":U
     2896           , input buf_recipe-gds.recipe-code
     2897           , output v-recipe-type
     2898       ).
     2899       if v-recipe-type <> 'производство':U
     2900       then do:
     2901           assign
     2902               buf_recipe-gds.calc-method = 1
     2903               buf_recipe-gds.qnty        = p-qnty
     2904               buf_recipe-gds.brutto-qnty = p-qnty
     2905               buf_recipe-gds.coeff-waste = 0
     2906           .
     2907       end.
     2908       else do:
     2909           assign
     2910               buf_recipe-gds.calc-method = 1
     2911               buf_recipe-gds.brutto-qnty = p-qnty
     2912           .
     2913           run fbrlib-calc-brutto in this-procedure (
     2914                 input v-recipe-type
     2915               , input 0
     2916               , input 0
     2917               , input buf_recipe-gds.coeff-waste
     2918               , input buf_recipe-gds.brutto-qnty
     2919               , input 1
     2920               , output buf_recipe-gds.qnty
     2921               , output buf_recipe-gds.coeff-waste
     2922               , output buf_recipe-gds.brutto-qnty
     2923               , output buf_recipe-gds.calc-method
     2924           ).
     2925       end.
     2926       assign
     2927           buf_recipe-gds.nws-self    = p-nws-self
     2928       .
     2929       if buf_recipe.recipe-type = 'альтернатива':U
     2930       and buf_recipe-gds.proc-number <> 0
     2931       then do:
     2932       end.
     2933       else do:
     2934           if p-proc-number <> 0
     2935           then do:
     2936               assign
     2937                   buf_recipe-gds.proc-number = p-proc-number
     2938               .
     2939           end.
     2940           else do:
     2941               assign
     2942                   v-max-proc-num = 0
     2943               .
     2944               for each buf_proc_recipe-gds no-lock
     2945                  where buf_proc_recipe-gds.recipe-code = p-recipe-code
     2946               :
     2947                   if recid( buf_proc_recipe-gds ) <> recid( buf_recipe-gds )
     2948                   then do:
     2949                       assign
     2950                           v-max-proc-num = ( if v-max-proc-num < buf_proc_recipe-gds.proc-number then buf_proc_recipe-gds.proc-number else v-max-proc-num )
     2951                       .
     2952                   end.
     2953               end.
     2954               assign
     2955                   buf_recipe-gds.proc-number = v-max-proc-num + 1
     2956               .
     2957           end.
     2958       end.
     2959   end.
     2960   end procedure.
     2961   PROCEDURE fbrlib-create-or-update-recipe :
     2962   define input parameter p-mode               as character    no-undo.
     2963   define input parameter p-obj-type           as character    no-undo.
     2964   define input parameter p-obj-code           as integer      no-undo.
     2965   define input parameter p-recipe-code        as character    no-undo.
     2966   define input parameter p-recipe-type        as character    no-undo.
     2967   define input parameter p-gds-code           as integer      no-undo.
     2968   define input parameter p-name               as character    no-undo.
     2969   define input parameter p-design             as character    no-undo.
     2970   define input parameter p-order              as integer      no-undo.
     2971   define input parameter p-quality            as character    no-undo.
     2972   define input parameter p-ref-num            as character    no-undo.
     2973   define input parameter p-technique          as character    no-undo.
     2974   define input parameter p-template           as character    no-undo.
     2975   define input parameter p-qnty               as decimal      no-undo.
     2976   define input parameter p-portion-qnty       as integer      no-undo.
     2977   define input parameter p-portion-weight     as decimal      no-undo.
     2978   define output parameter p-new-recipe-code   as character    no-undo.
     2979       define variable v-host-code         as integer      no-undo.
     2980       define variable v-fbr-gds-obj-recid as recid        no-undo.
     2981       define buffer buf_recipe    for ub.recipe.
     2982       define buffer buf_goods     for ub.goods.
     2983   do
     2984   for buf_recipe
     2985     , buf_goods
     2986   on error undo, return error
     2987   :
     2988       if p-mode <> 'ДОБАВЛЕНИЕ':U
     2989       and p-mode <> 'ИЗМЕНЕНИЕ':U
     2990       then do:
     2991           message
     2992               skip "Ошибка задания типа операции для создания или измения рецепта."
     2993               skip (1)
     2994               skip "Задан тип операции:" p-mode
     2995           view-as alert-box error.
     2996           undo, return error .
     2997       end.
     2998       if p-recipe-code = ""
     2999       then do:
     3000   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3001   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3002     (input  p-obj-type
     3003     ,input  p-obj-code
     3004     ,output v-host-code
     3005     )  .
     3006           find first buf_goods no-lock
     3007                where buf_goods.gds-code = p-gds-code
     3008           .
     3009           create buf_recipe .
     3010           run fbrcode-gen-recipe-code in this-procedure (
     3011                 input p-obj-type
     3012               , input p-obj-code
     3013               , output buf_recipe.recipe-code
     3014           ).
     3015           assign
     3016               buf_recipe.artic               = buf_goods.artic
     3017               buf_recipe.prod-type           = buf_goods.prod-type
     3018               buf_recipe.prod-code           = buf_goods.prod-code
     3019               buf_recipe.recipe-type         = p-recipe-type
     3020               buf_recipe.recipe-name         = ( if p-name = "" then buf_goods.gds-name else p-name )
     3021               buf_recipe.gds-code            = p-gds-code
     3022               buf_recipe.host-code           = v-host-code
     3023               buf_recipe.obj-type            = p-obj-type
     3024               buf_recipe.obj-code            = p-obj-code
     3025               buf_recipe.recipe-design       = ""
     3026               buf_recipe.recipe-order        = 0
     3027               buf_recipe.recipe-quality      = ""
     3028               buf_recipe.recipe-ref-num      = ""
     3029               buf_recipe.recipe-technique    = ""
     3030               buf_recipe.recipe-template     = ""
     3031               buf_recipe.qnty                = 1.0
     3032               buf_recipe.portion-qnty        = 1
     3033               buf_recipe.portion-weight      = 0
     3034           .
     3035       end.
     3036       if p-name <> ""
     3037       then do:
     3038           assign
     3039               buf_recipe.recipe-name = p-name
     3040           .
     3041       end.
     3042       assign
     3043           buf_recipe.recipe-design       = p-design
     3044           buf_recipe.recipe-order        = p-order
     3045           buf_recipe.recipe-quality      = p-quality
     3046           buf_recipe.recipe-ref-num      = p-ref-num
     3047           buf_recipe.recipe-technique    = p-technique
     3048           buf_recipe.recipe-template     = p-template
     3049           buf_recipe.qnty                = p-qnty
     3050           buf_recipe.portion-qnty        = p-portion-qnty
     3051           buf_recipe.portion-weight      = p-portion-weight
     3052       .
     3053       assign
     3054           p-new-recipe-code = buf_recipe.recipe-code
     3055       .
     3056       run fbrlib-set-default-recipe in this-procedure (
     3057             input p-obj-type
     3058           , input p-obj-code
     3059           , input buf_goods.gds-code
     3060       ).
     3061   end.
     3062   END PROCEDURE.
     3063   PROCEDURE fbrlib-delete-fact-fbr-doc :
     3064   define input parameter parparentproc-handle as widget-handle no-undo .
     3065   define input parameter p-doc-code   as character no-undo.
     3066   define input parameter p-chip-num   like ub.c-trn-doc.chip-num no-undo .
     3067       define variable v-shift-on      as logical      no-undo.
     3068       define variable v-shift-date    as date         no-undo.
     3069       define variable v-shift-num     as integer      no-undo.
     3070       define variable v-shift-name    as character    no-undo.
     3071       define variable v-obj-date      as date         no-undo.
     3072       define variable v-chip-num      as integer      no-undo.
     3073       define buffer buf_fbr-doc       for ub.fbr-doc.
     3074       define buffer buf_fbr-line      for ub.fbr-line.
     3075       define buffer buf_c-fbr-doc     for ub.c-fbr-doc.
     3076       define buffer buf_fbr-recipe     for ub.fbr-recipe.
     3077       define buffer buf_fbr-recipe-gds for ub.fbr-recipe-gds.
     3078       define buffer buf_marking-lines for ub.marking-lines .
     3079       define buffer buf_marking       for ub.marking .
     3080       define buffer buf_goods         for ub.goods .
     3081   do
     3082   for buf_fbr-doc
     3083     , buf_fbr-line
     3084     , buf_c-fbr-doc
     3085     , buf_fbr-recipe
     3086     , buf_fbr-recipe-gds
     3087     , buf_goods
     3088     , buf_marking
     3089     , buf_marking-lines
     3090   on error undo, return error
     3091   :
     3092   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3093     define variable v-cntxt-db-num        as integer   no-undo .
     3094     define variable v-cntxt-userid        as character no-undo .
     3095     define variable v-cntxt-level         as character no-undo .
     3096     define variable v-cntxt-host-code-obj as integer   no-undo .
     3097     define variable v-cntxt-obj-type      as character no-undo .
     3098     define variable v-cntxt-obj-code      as integer   no-undo .
     3099     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3100     define variable v-cntxt-is-admin      as logical   no-undo .
     3101   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3102     run mainmenu_getcntxt in parparentproc-handle
     3103       (output v-cntxt-db-num
     3104       ,output v-cntxt-userid
     3105       ,output v-cntxt-level
     3106       ,output v-cntxt-host-code-obj
     3107       ,output v-cntxt-obj-type
     3108       ,output v-cntxt-obj-code
     3109       ,output v-cntxt-db-num-obj
     3110       ,output v-cntxt-is-admin
     3111       ) .
     3112       if search ("delfbr.err") <> ?
     3113       then do:
     3114           os-delete "delfbr.err".
     3115       end.
     3116     _del-block:
     3117       do transaction
     3118     on error undo _del-block, return error return-value
     3119     on endkey undo _del-block , return error return-value
     3120     on stop undo _del-block , return error return-value
     3121       :
     3122           find first buf_fbr-doc exclusive-lock
     3123                where buf_fbr-doc.doc-code = p-doc-code
     3124           no-error.
     3125           if not available buf_fbr-doc
     3126           then do:
     3127         undo _del-block, return error substitute("&1 &2 &3&4Не найден документ производства &5 для удаления."
     3128                                           ,vss-workfile
     3129                                           ,vss-revision
     3130                                           ,vss-description
     3131                                           ,chr(10)
     3132                                           , p-doc-code).
     3133           end.
     3134           run fbrlib-delete-fact-trn-doc in this-procedure (
     3135               input parparentproc-handle
     3136              ,input p-doc-code
     3137              ,input 'при':U
     3138              ,input p-chip-num
     3139              ,output v-chip-num
     3140           ) no-error.
     3141           if error-status :error
     3142           then do:
     3143               run fbrlib-print-del-error-message in this-procedure .
     3144         undo _del-block, return error.
     3145           end.
     3146           assign
     3147           p-chip-num = (if p-chip-num = ?
     3148                         then v-chip-num
     3149                         else p-chip-num).
     3150           run fbrlib-delete-fact-trn-doc in this-procedure (
     3151               input parparentproc-handle
     3152              ,input p-doc-code
     3153              ,input 'рас':U
     3154              ,input p-chip-num
     3155              ,output v-chip-num
     3156           ) no-error.
     3157           if error-status :error
     3158           then do:
     3159               run fbrlib-print-del-error-message in this-procedure .
     3160         undo _del-block, return error.
     3161           end.
     3162           run fbrlib-delete-fact-trn-doc in this-procedure (
     3163               input parparentproc-handle
     3164              ,input p-doc-code
     3165              ,input 'спи':U
     3166              ,input p-chip-num
     3167              ,output v-chip-num
     3168           ) no-error.
     3169           if error-status :error
     3170           then do:
     3171               run fbrlib-print-del-error-message in this-procedure .
     3172         undo _del-block, return error.
     3173           end.
     3174           create buf_c-fbr-doc.
     3175           buffer-copy buf_fbr-doc to buf_c-fbr-doc.
     3176   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3177   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     3178     (input  buf_fbr-doc.obj-type
     3179     ,input  buf_fbr-doc.obj-code
     3180     ,output v-obj-date
     3181     ) no-error .
     3182           if error-status :error
     3183           or v-obj-date = ?
     3184           then do:
     3185         undo _del-block, return error "Нет текущей даты на объекте документа.".
     3186           end.
     3187   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3188   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3189     (input  buf_fbr-doc.obj-type
     3190     ,input  buf_fbr-doc.obj-code
     3191     ,input  'shift-on=request'
     3192     ,output v-shift-on
     3193     )  .
     3194           if v-shift-on
     3195           then do:
     3196   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3197   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     3198     (input  buf_fbr-doc.obj-type
     3199     ,input  buf_fbr-doc.obj-code
     3200     ,output v-shift-date
     3201     ,output v-shift-num
     3202     ,output v-shift-name
     3203     ) no-error .
     3204               if error-status :error
     3205               then do:
     3206           undo _del-block, return error "Ошибка при поиске текущей смены на объекте".
     3207               end.
     3208           end.
     3209           else do:
     3210               assign
     3211                   v-shift-date = ?
     3212                   v-shift-num  = ?
     3213                   v-shift-name = ?
     3214               .
     3215           end.
     3216           define variable v-today       as date         no-undo.
     3217           define variable v-time        as integer      no-undo.
     3218           run cur-time in this-procedure (
     3219                 output v-today
     3220               , output v-time
     3221           ).
     3222           assign
     3223               buf_c-fbr-doc.chip-num         = (if p-chip-num <> ? then p-chip-num else next-value( s-corr-chip, ub  ))
     3224               buf_c-fbr-doc.corr-user-name   = v-cntxt-userid
     3225               buf_c-fbr-doc.corr-user-db-num = v-cntxt-db-num
     3226               buf_c-fbr-doc.corr-date        = v-today
     3227               buf_c-fbr-doc.corr-time        = v-time
     3228               buf_c-fbr-doc.corr-shift-date  = v-shift-date
     3229               buf_c-fbr-doc.corr-shift-num   = v-shift-num
     3230               buf_c-fbr-doc.corr-shift-name  = v-shift-name
     3231               buf_c-fbr-doc.is-del           = yes
     3232           .
     3233           assign
     3234               buf_fbr-doc.is-del = yes
     3235           .
     3236           for each buf_fbr-line exclusive-lock
     3237              where buf_fbr-line.doc-code = p-doc-code
     3238       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3239       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3240       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3241           :
     3242               for first buf_goods no-lock where buf_goods.artic      = buf_fbr-line.artic
     3243                                             and buf_goods.prod-type  = buf_fbr-line.prod-type
     3244                                             and buf_goods.prod-code  = buf_fbr-line.prod-code,
     3245               each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = buf_goods.gds-code
     3246                                                       and buf_marking-lines.obj-type = buf_fbr-doc.obj-type
     3247                                                       and buf_marking-lines.obj-code = buf_fbr-doc.obj-code
     3248                                                       and buf_marking-lines.in-code  = "manufacturing"
     3249                                                       and buf_marking-lines.out-code = buf_fbr-line.doc-code
     3250                                                       and buf_marking-lines.part-code = buf_fbr-line.recipe-code
     3251                                                       and buf_marking-lines.prt-code = 0
     3252               :
     3253                 for first buf_marking exclusive-lock where buf_marking.mark begins buf_marking-lines.mark :
     3254                   assign
     3255                     buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB when buf_fbr-line.is-comp
     3256                   .
     3257                 end .
     3258                 delete buf_marking-lines.
     3259               end .
     3260               delete buf_fbr-line.
     3261           end.
     3262           for each buf_fbr-recipe exclusive-lock
     3263              where buf_fbr-recipe.doc-code = p-doc-code
     3264       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3265       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3266       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3267           :
     3268               delete buf_fbr-recipe.
     3269           end.
     3270           for each buf_fbr-recipe-gds exclusive-lock
     3271              where buf_fbr-recipe-gds.doc-code = p-doc-code
     3272       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3273       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3274       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3275           :
     3276               delete buf_fbr-recipe-gds.
     3277           end.
     3278           delete buf_fbr-doc.
     3279       end.
     3280   end.
     3281   END PROCEDURE.
     3282   PROCEDURE fbrlib-del-trn-doc :
     3283   do
     3284   on error undo, return error
     3285   :
     3286   define input parameter parparentproc        as widget-handle no-undo .
     3287   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     3288   define input parameter p-trn-doc-type       as character    no-undo.
     3289   define input parameter p-phchip-num         like ub.c-trn-doc.chip-num no-undo .
     3290   define output parameter p-chip-num           like ub.c-trn-doc.chip-num no-undo .
     3291       define variable v-trn-doc-doc-code  as character     no-undo.
     3292       define buffer buf_trn-doc       for ub.trn-doc.
     3293   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3294     define variable v-cntxt-db-num        as integer   no-undo .
     3295     define variable v-cntxt-userid        as character no-undo .
     3296     define variable v-cntxt-level         as character no-undo .
     3297     define variable v-cntxt-host-code-obj as integer   no-undo .
     3298     define variable v-cntxt-obj-type      as character no-undo .
     3299     define variable v-cntxt-obj-code      as integer   no-undo .
     3300     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3301     define variable v-cntxt-is-admin      as logical   no-undo .
     3302   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3303     run mainmenu_getcntxt in parparentproc
     3304       (output v-cntxt-db-num
     3305       ,output v-cntxt-userid
     3306       ,output v-cntxt-level
     3307       ,output v-cntxt-host-code-obj
     3308       ,output v-cntxt-obj-type
     3309       ,output v-cntxt-obj-code
     3310       ,output v-cntxt-db-num-obj
     3311       ,output v-cntxt-is-admin
     3312       ) .
     3313       run fbrcode-trn-doc in this-procedure (
     3314             input 'производство':U
     3315           , input p-fbr-doc-doc-code
     3316           , input p-trn-doc-type
     3317           , output v-trn-doc-doc-code
     3318       ).
     3319       find first buf_trn-doc no-lock
     3320            where buf_trn-doc.doc-code = v-trn-doc-doc-code
     3321       no-error.
     3322       if available buf_trn-doc
     3323       then do:
     3324           run str/del-doc.p (
     3325                 input parparentproc
     3326               , input buf_trn-doc.doc-code
     3327               , input v-cntxt-db-num
     3328               , input "del-doc.err"
     3329               , input ?
     3330               , input p-fbr-doc-doc-code
     3331               , input v-cntxt-userid
     3332               , input 0
     3333               , input p-phchip-num
     3334               , output p-chip-num
     3335           ) no-error.
     3336           if error-status :error
     3337           then do:
     3338             undo, return error substitute("Не удалось удалить складской документ &1, созданный по документу производства &2.&3&4&3&5"
     3339                                           ,v-trn-doc-doc-code
     3340                                           ,p-fbr-doc-doc-code
     3341                                           , chr(10)
     3342                                           , error-status:get-message(1)
     3343                                           , return-value ).
     3344           end.
     3345       end.
     3346   end.
     3347   END PROCEDURE.
     3348   PROCEDURE fbrlib-delete-fact-trn-doc :
     3349   define input parameter parparentproc    as widget-handle    no-undo.
     3350   define input parameter p-fbr-doc-code   as character        no-undo.
     3351   define input parameter p-doc-type       as character    no-undo.
     3352   define input parameter p-ph-chip-num       like ub.c-trn-doc.chip-num no-undo .
     3353   define output parameter p-chip-num      like ub.c-trn-doc.chip-num no-undo .
     3354       define variable v-doc-code          as character        no-undo.
     3355       define variable v-ext-doc-type      as character        no-undo.
     3356       define variable v-trn-doc-recid     as recid            no-undo.
     3357       define variable varchip-code        as integer          no-undo.
     3358       define variable varchip-code2       as integer          no-undo.
     3359       define variable v-chip-counter      as integer          no-undo.
     3360       define buffer buf_trn-doc       for ub.trn-doc.
     3361       define buffer buf_pri_trn-doc   for ub.trn-doc.
     3362       define buffer buf_cons_trn-doc  for ub.trn-doc.
     3363   do
     3364   for buf_trn-doc
     3365     , buf_pri_trn-doc
     3366     , buf_cons_trn-doc
     3367   on error undo, return error
     3368   :
     3369   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3370     define variable v-cntxt-db-num        as integer   no-undo .
     3371     define variable v-cntxt-userid        as character no-undo .
     3372     define variable v-cntxt-level         as character no-undo .
     3373     define variable v-cntxt-host-code-obj as integer   no-undo .
     3374     define variable v-cntxt-obj-type      as character no-undo .
     3375     define variable v-cntxt-obj-code      as integer   no-undo .
     3376     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3377     define variable v-cntxt-is-admin      as logical   no-undo .
     3378   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3379     run mainmenu_getcntxt in parparentproc
     3380       (output v-cntxt-db-num
     3381       ,output v-cntxt-userid
     3382       ,output v-cntxt-level
     3383       ,output v-cntxt-host-code-obj
     3384       ,output v-cntxt-obj-type
     3385       ,output v-cntxt-obj-code
     3386       ,output v-cntxt-db-num-obj
     3387       ,output v-cntxt-is-admin
     3388       ) .
     3389       run fbrcode-trn-doc in this-procedure (
     3390             input 'производство':U
     3391           , input p-fbr-doc-code
     3392           , input p-doc-type
     3393           , output v-doc-code
     3394       ).
     3395       find first buf_trn-doc no-lock
     3396            where buf_trn-doc.doc-code = v-doc-code
     3397       no-error.
     3398       if not available buf_trn-doc
     3399       then do:
     3400           if p-doc-type <> 'спи':U
     3401           then do:
     3402               message
     3403                   "Не найден документ '" p-doc-type "'"
     3404                   "по документу производства " p-fbr-doc-code
     3405               view-as alert-box.
     3406               undo, return error.
     3407           end.
     3408           else do:
     3409           end.
     3410       end.
     3411       else do:
     3412           assign
     3413               v-trn-doc-recid = recid( buf_trn-doc )
     3414               v-ext-doc-type  = buf_trn-doc.ext-doc-type
     3415           .
     3416           if v-ext-doc-type = 'ev':U
     3417           then do:
     3418               find first buf_pri_trn-doc no-lock
     3419                    where buf_pri_trn-doc.out-code     = v-doc-code
     3420                      and buf_pri_trn-doc.ext-doc-type = 'iv':U
     3421               no-error.
     3422               if available buf_pri_trn-doc
     3423               then do:
     3424                   run str/del-doc.p (
     3425                         input parparentproc
     3426                       , input buf_pri_trn-doc.doc-code
     3427                       , input v-cntxt-db-num
     3428                       , input "delfbr.err"
     3429                       , input ?
     3430                       , input p-fbr-doc-code
     3431                       , input v-cntxt-userid
     3432                       , input 0
     3433                       , input (if p-ph-chip-num <> ?
     3434                               then p-ph-chip-num
     3435                               else (if varchip-code <> 0
     3436                                   then varchip-code
     3437                                   else ?)
     3438                               )
     3439                       , output varchip-code2
     3440                   ) no-error.
     3441                   if error-status :error
     3442                   then do:
     3443                     undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     3444                                                   ,buf_pri_trn-doc.doc-code
     3445                                                   ,p-fbr-doc-code
     3446                                                   , chr(10)
     3447                                                   , error-status:get-message(1)
     3448                                                   , return-value ).
     3449                   end.
     3450               end.
     3451           end.
     3452           define buffer buf_out_trn-doc       for ub.trn-doc.
     3453           if p-doc-type = 'при':U
     3454           then do:
     3455               assign
     3456                   v-chip-counter = 0
     3457               .
     3458               for each buf_out_trn-doc exclusive-lock
     3459                  where buf_out_trn-doc.out-code = buf_trn-doc.doc-code
     3460               on error undo, return error
     3461               :
     3462                   assign
     3463                       v-chip-counter = v-chip-counter + 1
     3464                   .
     3465                   if v-chip-counter > 1
     3466                   then do:
     3467                       assign
     3468                           varchip-code = varchip-code2
     3469                       .
     3470                   end.
     3471                   run str/del-doc.p (
     3472                         input parparentproc
     3473                       , input buf_out_trn-doc.doc-code
     3474                       , input v-cntxt-db-num
     3475                       , input "delfbr.err"
     3476                       , input ?
     3477                       , input p-fbr-doc-code
     3478                       , input v-cntxt-userid
     3479                       , input 0
     3480                       , input (if p-ph-chip-num <> ?
     3481                               then p-ph-chip-num
     3482                               else (if varchip-code <> 0
     3483                                   then varchip-code
     3484                                   else ?)
     3485                               )
     3486                       , output varchip-code2
     3487                   ) no-error.
     3488                   if error-status :error
     3489                   then do:
     3490                     undo, return error substitute("Ошибка при удалении складского документа &1, связанного со складским документов прихода &2, созданный по документу производства &3.&4&5&4&6"
     3491                                                   ,buf_out_trn-doc.doc-code
     3492                                                   ,buf_trn-doc.doc-code
     3493                                                   ,p-fbr-doc-code
     3494                                                   , chr(10)
     3495                                                   , error-status:get-message(1)
     3496                                                   , return-value ).
     3497                   end.
     3498               end.
     3499           end.
     3500           run str/del-doc.p (
     3501                 input parparentproc
     3502               , input buf_trn-doc.doc-code
     3503               , input v-cntxt-db-num
     3504               , input "delfbr.err"
     3505               , input ?
     3506               , input p-fbr-doc-code
     3507               , input v-cntxt-userid
     3508               , input 0
     3509               , input (if p-ph-chip-num <> ?
     3510                        then p-ph-chip-num
     3511                        else (if varchip-code <> 0
     3512                              then varchip-code
     3513                              else ?)
     3514                        )
     3515               , output varchip-code2
     3516           ) no-error.
     3517           if error-status :error
     3518           then do:
     3519               undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     3520                                             ,buf_trn-doc.doc-code
     3521                                             ,p-fbr-doc-code
     3522                                             , chr(10)
     3523                                             , error-status:get-message(1)
     3524                                             , return-value ).
     3525           end.
     3526           if p-doc-type = 'рас':U
     3527           or p-doc-type = 'спи':U
     3528           then do:
     3529               assign
     3530                   v-chip-counter = 0
     3531               .
     3532               for each buf_cons_trn-doc no-lock
     3533                  where buf_cons_trn-doc.out-code      = v-doc-code
     3534                    and buf_cons_trn-doc.ext-doc-type  = 'pc':U
     3535               :
     3536                   assign
     3537                       v-trn-doc-recid = recid( buf_cons_trn-doc )
     3538                       v-chip-counter = v-chip-counter + 1
     3539                   .
     3540                   assign
     3541                   varchip-code = if v-chip-counter = 2
     3542                                  then varchip-code2
     3543                                  else varchip-code.
     3544                   run str/del-doc.p (
     3545                         input parparentproc
     3546                       , input buf_cons_trn-doc.doc-code
     3547                       , input v-cntxt-db-num
     3548                       , input "delfbr.err"
     3549                       , input ?
     3550                       , input ?
     3551                       , input v-cntxt-userid
     3552                       , input 0
     3553                       , input (if p-ph-chip-num <> ?
     3554                                then p-ph-chip-num
     3555                                else ( if v-chip-counter = 1
     3556                                       then ?
     3557                                       else varchip-code )
     3558                                )
     3559                       , output varchip-code2
     3560                   ) no-error.
     3561                   if error-status :error
     3562                   then do:
     3563                       undo, return error substitute("Ошибка при удалении складского документа смены типа приобретения &1, созданный по документу производства &2.&3&4&3&5"
     3564                                                     ,buf_cons_trn-doc.doc-code
     3565                                                     ,p-fbr-doc-code
     3566                                                     , chr(10)
     3567                                                     , error-status:get-message(1)
     3568                                                     , return-value ).
     3569                   end.
     3570                   assign
     3571                       p-chip-num = varchip-code2
     3572                   .
     3573               end.
     3574           end.
     3575           assign
     3576               p-chip-num = varchip-code2
     3577           .
     3578       end.
     3579   end.
     3580   END PROCEDURE.
     3581   PROCEDURE fbrlib-print-del-error-message :
     3582   do
     3583   on error undo, return error
     3584   :
     3585       define variable v-user-action   as character    no-undo.
     3586       define variable v-printed       as logical      no-undo.
     3587       message
     3588           vss-workfile vss-revision vss-description
     3589           skip "Ошибка при удалении документа."
     3590           skip return-value
     3591           skip trim(error-status :get-message(1))
     3592           skip trim(error-status :get-message(2))
     3593           skip trim(error-status :get-message(3))
     3594       view-as alert-box error.
     3595       if search ("delfbr.err") <> ?
     3596       then do:
     3597         run gbl/prnfilen.w
     3598           (input  "Ошибки при удалении документа производства"
     3599           ,input  0
     3600           ,input  "delfbr.err"
     3601           ,input  7
     3602           ,output v-user-action
     3603           ,output v-printed
     3604           ).
     3605       end.
     3606   end.
     3607   END PROCEDURE.
     3608   procedure fbrlib-calc-brutto :
     3609   define input parameter p-recipe-type        as character        no-undo.
     3610   define input parameter p-netto              as decimal          no-undo.
     3611   define input parameter p-coeff-value        as decimal          no-undo.
     3612   define input parameter p-coeff-waste        as decimal          no-undo.
     3613   define input parameter p-brutto             as decimal          no-undo.
     3614   define input parameter p-calc-method        as integer          no-undo.
     3615   define output parameter p-new-netto         as decimal          no-undo.
     3616   define output parameter p-new-coeff-waste   as decimal          no-undo.
     3617   define output parameter p-new-brutto        as decimal          no-undo.
     3618   define output parameter p-new-calc-method   as integer          no-undo.
     3619   do
     3620   on error undo, return error
     3621   :
     3622       if p-recipe-type <> 'производство':U
     3623       then do:
     3624           assign
     3625               p-new-coeff-waste = 0
     3626               p-new-calc-method = 1
     3627               p-new-netto       = ( if p-calc-method = 1 then p-brutto else p-netto )
     3628               p-new-brutto      = ( if p-calc-method = 1 then p-brutto else p-netto )
     3629           .
     3630       end.
     3631       else do:
     3632           assign
     3633               p-new-calc-method = p-calc-method
     3634           .
     3635           if p-coeff-waste = 0
     3636           then do:
     3637               assign
     3638                   p-coeff-value = 0
     3639               .
     3640           end.
     3641           case p-calc-method
     3642           :
     3643               when 1
     3644               then do:
     3645                   assign
     3646                       p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     3647                       p-new-coeff-waste   = p-coeff-waste
     3648                       p-new-brutto        = p-brutto
     3649                   .
     3650               end.
     3651               when 2
     3652               then do:
     3653                   assign
     3654                       p-new-netto         = p-netto
     3655                       p-new-coeff-waste   = 100 - p-coeff-value - ( 100 * p-netto / p-brutto )
     3656                       p-new-brutto        = p-brutto
     3657                   .
     3658               end.
     3659               when 3
     3660               then do:
     3661                   assign
     3662                       p-new-netto         = p-netto
     3663                       p-new-coeff-waste   = p-coeff-waste
     3664                       p-new-brutto        = 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste )
     3665                   .
     3666               end.
     3667               otherwise do:
     3668                   define variable v-yesno    as logical      no-undo.
     3669                   assign
     3670                       v-yesno = yes
     3671                   .
     3672                   message
     3673                       "Неверный метод для расчета брутто, нетто и процента потерь."
     3674                       skip "Значение метода должно быть 1, 2 или 3."
     3675                       skip(1)
     3676                       skip "Заданное значение:" p-calc-method
     3677                       skip(1)
     3678                       skip "Установить значение метода расчета 1"
     3679                       skip "(расчет нетто по брутто и проценту потерь)?"
     3680                   view-as alert-box warning
     3681                   buttons yes-no
     3682                   title "Неверное значение метода пересчета в строках документа-производства"
     3683                   update v-yesno
     3684                   .
     3685                   if v-yesno = yes
     3686                   then do:
     3687                       assign
     3688                           p-new-calc-method   = 1
     3689                           p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     3690                           p-new-coeff-waste   = p-coeff-waste
     3691                           p-new-brutto        = p-brutto
     3692                       .
     3693                   end.
     3694                   else do:
     3695                       message
     3696                               vss-workfile vss-revision vss-description
     3697                           skip(1)
     3698                           skip "Ошибка расчета брутто, нетто и процента потерь."
     3699                           skip return-value
     3700                           skip trim(error-status :get-message(1))
     3701                               trim(error-status :get-message(2))
     3702                               trim(error-status :get-message(3))
     3703                       view-as alert-box error
     3704                       title "Неверное значение метода расчета"
     3705                       .
     3706                       undo, return error .
     3707                   end.
     3708               end.
     3709           end case.
     3710       end.
     3711   end.
     3712   end procedure.
     3713   procedure fbrlib-check-brutto :
     3714   define input parameter p-recipe-type        as character        no-undo.
     3715   define input parameter p-netto              as decimal          no-undo.
     3716   define input parameter p-coeff-value        as decimal          no-undo.
     3717   define input parameter p-coeff-waste        as decimal          no-undo.
     3718   define input parameter p-brutto             as decimal          no-undo.
     3719   define input parameter p-calc-method        as integer          no-undo.
     3720   define output parameter p-error-message     as character        no-undo.
     3721   define output parameter p-not-good          as logical          no-undo.
     3722   do
     3723   on error undo, return error
     3724   :
     3725       if p-recipe-type <> 'производство':U
     3726       then do:
     3727           if p-netto <> p-brutto
     3728           or p-coeff-waste <> 0
     3729           then do:
     3730               assign
     3731                   p-not-good      = yes
     3732                   p-error-message = substitute( "Во всех рецептах кроме рецепта производства должно выполняться:&1брутто = нетто и процент потерь = 0.&1&1Тип рецепта: &2&1Брутто: &3&1Нетто: &4&1Процент потерь: &5"
     3733                                           , chr(10), p-recipe-type, p-brutto, p-netto, p-coeff-waste )
     3734               .
     3735           end.
     3736       end.
     3737       else do:
     3738           if p-coeff-waste = 0
     3739           then do:
     3740               assign
     3741                   p-coeff-value = 0
     3742               .
     3743           end.
     3744           case p-calc-method
     3745           :
     3746               when 1
     3747               then do:
     3748                   if round( p-netto, 9 ) <> round( p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100, 9 )
     3749                   then do:
     3750                       assign
     3751                           p-not-good      = yes
     3752                           p-error-message = substitute( "Ошибка расчета нетто ( &2 ) &1 по брутто ( &3 ) &1 и процентам потерь ( &4, &5 )."
     3753                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     3754                       .
     3755                   end.
     3756               end.
     3757               when 2
     3758               then do:
     3759                   if round( p-coeff-waste, 9 ) <> round( 100 - p-coeff-value - ( 100 * p-netto / p-brutto ), 9 )
     3760                   then do:
     3761                       assign
     3762                           p-not-good      = yes
     3763                           p-error-message =  substitute( "Ошибка расчета процента потерь ( &2 ) &1 по нетто ( &3 ) &1 брутто ( &4 ) &1 и cезонному проценту ( &5 )."
     3764                                                   , chr(10), p-coeff-waste, p-netto, p-brutto, p-coeff-value )
     3765                       .
     3766                   end.
     3767               end.
     3768               when 3
     3769               then do:
     3770                   if round( p-brutto, 9 ) <> round( 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste ), 9 )
     3771                   then do:
     3772                       assign
     3773                           p-not-good      = yes
     3774                           p-error-message = substitute( "Ошибка расчета брутто ( &3 ) &1 по нетто ( &2 ) &1 и процентам потерь ( &4, &5 )."
     3775                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     3776                       .
     3777                   end.
     3778               end.
     3779               otherwise do:
     3780                   assign
     3781                       p-not-good      = yes
     3782                       p-error-message = substitute( "Ошибка ввода метода расчета ( &1 ).", p-calc-method )
     3783                   .
     3784               end.
     3785           end case.
     3786       end.
     3787   end.
     3788   end procedure.
     3789   procedure fbrlib-check-fbr-recipe :
     3790   define input parameter p-doc-code       as character        no-undo.
     3791   define input parameter p-recipe-code    as character        no-undo.
     3792   define output parameter p-is-correct    as logical          no-undo.
     3793       define variable v-comp-factor    as decimal      no-undo.
     3794       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     3795       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3796       define buffer buf_fbr-line          for ub.fbr-line.
     3797   do
     3798   for buf_fbr-recipe
     3799     , buf_fbr-recipe-gds
     3800     , buf_fbr-line
     3801   on error undo, return error
     3802   :
     3803       assign
     3804           p-is-correct = yes
     3805       .
     3806       find first buf_fbr-recipe no-lock
     3807            where buf_fbr-recipe.doc-code    = p-doc-code
     3808              and buf_fbr-recipe.recipe-code = p-recipe-code no-error
     3809       .
     3810       if not available buf_fbr-recipe then do:
     3811         undo, return error substitute("Не найден рецепт (fbr-recipe) с кодом &1 для  документа пр-ва &2", p-recipe-code, p-doc-code).
     3812       end.
     3813       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     3814       then do:
     3815       end.
     3816       else do:
     3817           find first buf_fbr-line no-lock
     3818                where buf_fbr-line.doc-code    = buf_fbr-recipe.doc-code
     3819                  and buf_fbr-line.is-comp     = yes
     3820                  and buf_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     3821                  and buf_fbr-line.artic       = buf_fbr-recipe.artic
     3822                  and buf_fbr-line.prod-type   = buf_fbr-recipe.prod-type
     3823                  and buf_fbr-line.prod-code   = buf_fbr-recipe.prod-code
     3824           .
     3825           assign
     3826               v-comp-factor = buf_fbr-line.fact-qnty / buf_fbr-recipe.qnty
     3827           .
     3828           recipe-line-cycle:
     3829           for each buf_fbr-recipe-gds no-lock
     3830              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     3831                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     3832           on error undo, return error
     3833           :
     3834               find first buf_fbr-line no-lock
     3835                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     3836                      and buf_fbr-line.is-comp     = no
     3837                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     3838                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3839                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3840                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3841               .
     3842               if absolute( buf_fbr-line.fact-qnty / buf_fbr-recipe-gds.brutto-qnty - v-comp-factor ) > 0.000000001
     3843               then do:
     3844                   assign
     3845                       p-is-correct = no
     3846                   .
     3847                   leave recipe-line-cycle.
     3848               end.
     3849           end.
     3850       end.
     3851   end.
     3852   end procedure.
     3853   procedure fbrlib-get-recipe-type :
     3854   define input parameter p-fbr-doc-code   as character        no-undo.
     3855   define input parameter p-recipe-code    as character        no-undo.
     3856   define output parameter p-recipe-type   as character        no-undo.
     3857       define buffer buf_recipe        for ub.recipe.
     3858       define buffer buf_fbr-recipe    for ub.fbr-recipe.
     3859   do
     3860   for buf_recipe
     3861     , buf_fbr-recipe
     3862   on error undo, return error
     3863   :
     3864       if p-fbr-doc-code = ""
     3865       then do:
     3866           find first buf_recipe no-lock
     3867                where buf_recipe.recipe-code = p-recipe-code
     3868           no-error.
     3869           if available buf_recipe
     3870           then do:
     3871               assign
     3872                   p-recipe-type = buf_recipe.recipe-type
     3873               .
     3874           end.
     3875           else do:
     3876               assign
     3877                   p-recipe-type = "":U
     3878               .
     3879           end.
     3880       end.
     3881       else do:
     3882           find first buf_fbr-recipe no-lock
     3883                where buf_fbr-recipe.doc-code      = p-fbr-doc-code
     3884                  and buf_fbr-recipe.recipe-code   = p-recipe-code
     3885           no-error.
     3886           if available buf_fbr-recipe
     3887           then do:
     3888               assign
     3889                   p-recipe-type = buf_fbr-recipe.recipe-type
     3890               .
     3891           end.
     3892           else do:
     3893               assign
     3894                   p-recipe-type = "":U
     3895               .
     3896           end.
     3897       end.
     3898   end.
     3899   end procedure.
     3900   PROCEDURE calc-comp-from-ingr :
     3901   define input parameter p-fbr-v-fbr-doc-line-recid           as recid        no-undo.
     3902   define input parameter p-fact-qnty                          as decimal      no-undo.
     3903   define output parameter p-comp-fbr-v-fbr-doc-line-recid     as recid        no-undo.
     3904   define output parameter p-comp-qnty                         as decimal      no-undo.
     3905       define variable v-ingr-qnty     as decimal       no-undo.
     3906       define buffer buf_i_fbr-line    for ub.fbr-line.
     3907       define buffer buf_fbr-line      for ub.fbr-line.
     3908       define buffer buf_recipe        for ub.fbr-recipe.
     3909       define buffer buf_recipe-gds    for ub.fbr-recipe-gds.
     3910   do
     3911   for buf_i_fbr-line
     3912     , buf_fbr-line
     3913     , buf_recipe
     3914     , buf_recipe-gds
     3915   on error undo, return error
     3916   :
     3917       find first buf_i_fbr-line no-lock
     3918            where recid( buf_i_fbr-line ) = p-fbr-v-fbr-doc-line-recid
     3919       .
     3920       find first buf_recipe no-lock
     3921            where buf_recipe.doc-code      = buf_i_fbr-line.doc-code
     3922              and buf_recipe.recipe-code   = buf_i_fbr-line.recipe-code
     3923       no-error.
     3924       if not available buf_recipe
     3925       then do:
     3926           message
     3927                   vss-workfile vss-revision vss-description
     3928               skip "В строке производства не указан рецепт."
     3929               skip "Невозможно рассчитать количество составного товара."
     3930               skip return-value
     3931               skip trim(error-status :get-message(1))
     3932                   trim(error-status :get-message(2))
     3933                   trim(error-status :get-message(3))
     3934           view-as alert-box error.
     3935           undo, return error .
     3936       end.
     3937       if buf_recipe.recipe-type = 'альтернатива':U
     3938       then do:
     3939           for each buf_fbr-line no-lock
     3940              where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     3941                and buf_fbr-line.trn-type    = buf_i_fbr-line.trn-type
     3942                and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     3943           on error undo, return error
     3944           :
     3945               find first buf_recipe-gds no-lock
     3946                    where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     3947                      and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     3948                      and buf_recipe-gds.artic       = buf_fbr-line.artic
     3949                      and buf_recipe-gds.prod-type   = buf_fbr-line.prod-type
     3950                      and buf_recipe-gds.prod-code   = buf_fbr-line.prod-code
     3951               .
     3952               assign
     3953                   p-comp-qnty         = p-comp-qnty       + ( buf_fbr-line.fact-qnty * buf_recipe-gds.brutto-qnty )
     3954               .
     3955           end.
     3956           assign
     3957               p-comp-qnty         = p-comp-qnty       / buf_recipe.qnty
     3958           .
     3959       end.
     3960       else do:
     3961           find first buf_recipe-gds no-lock
     3962                where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     3963                  and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     3964                  and buf_recipe-gds.artic       = buf_i_fbr-line.artic
     3965                  and buf_recipe-gds.prod-type   = buf_i_fbr-line.prod-type
     3966                  and buf_recipe-gds.prod-code   = buf_i_fbr-line.prod-code
     3967           .
     3968           assign
     3969               p-comp-qnty = p-fact-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
     3970           .
     3971       end.
     3972       find first buf_fbr-line no-lock
     3973            where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     3974              and buf_fbr-line.is-comp     = yes
     3975              and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     3976       .
     3977       assign
     3978           p-comp-fbr-v-fbr-doc-line-recid = recid( buf_fbr-line )
     3979       .
     3980   end.
     3981   END PROCEDURE.
     3982   PROCEDURE get-temp_dressing-ingr-used-qnty :
     3983   define input parameter p-recipe-code    as character    no-undo.
     3984   define input parameter p-gds-code       as integer      no-undo.
     3985   define output parameter p-line-qnty     as decimal      no-undo.
     3986   define output parameter p-used-qnty     as decimal      no-undo.
     3987   define output parameter p-recipe-qnty   as decimal      no-undo.
     3988       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     3989   do
     3990   for buf_temp_dressing-ingr
     3991   on error undo, return error
     3992   :
     3993       find first buf_temp_dressing-ingr no-lock
     3994            where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     3995              and buf_temp_dressing-ingr.gds-code    = p-gds-code
     3996       no-error.
     3997       if available buf_temp_dressing-ingr
     3998       then do:
     3999           assign
     4000               p-line-qnty     = buf_temp_dressing-ingr.line-qnty
     4001               p-used-qnty     = buf_temp_dressing-ingr.used-qnty
     4002               p-recipe-qnty   = buf_temp_dressing-ingr.recipe-qnty
     4003           .
     4004       end.
     4005       else do:
     4006           assign
     4007               p-line-qnty     = 0
     4008               p-used-qnty     = 0
     4009               p-recipe-qnty   = 0
     4010           .
     4011       end.
     4012   end.
     4013   END PROCEDURE.
     4014   PROCEDURE fbrlib_adjust-recipe :
     4015   do
     4016   on error undo, return error
     4017   :
     4018   define input parameter parparentproc as widget-handle no-undo .
     4019   define input parameter p-fbrhist-handle as handle no-undo .
     4020   define input parameter p-doc-code       as character    no-undo.
     4021   define input parameter p-recipe-code    as character    no-undo.
     4022   define input parameter p-price-sale-obj-type as character no-undo .
     4023   define input parameter p-price-sale-obj-code as integer no-undo .
     4024       define variable v-recipe-qnty       as decimal      no-undo.
     4025       define variable v-comp-qnty         as decimal      no-undo.
     4026       define variable v-recipe-gds-qnty   as decimal      no-undo.
     4027       define variable v-ingr-qnty         as decimal      no-undo.
     4028       define variable v-qnty              as decimal      no-undo.
     4029       define variable v-coeff-waste       as decimal      no-undo.
     4030       define variable v-brutto-qnty       as decimal      no-undo.
     4031       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4032       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4033       define buffer buf_fbr-line          for ub.fbr-line.
     4034       define buffer buf_el_fbr-recipe-gds for ub.fbr-recipe-gds.
     4035       find first buf_fbr-recipe no-lock
     4036            where buf_fbr-recipe.doc-code      = p-doc-code
     4037              and buf_fbr-recipe.recipe-code   = p-recipe-code
     4038       .
     4039       assign
     4040           v-recipe-qnty = buf_fbr-recipe.qnty
     4041       .
     4042       find first buf_fbr-line no-lock
     4043            where buf_fbr-line.doc-code    = p-doc-code
     4044              and buf_fbr-line.is-comp     = yes
     4045              and buf_fbr-line.recipe-code = p-recipe-code
     4046       .
     4047       assign
     4048           v-comp-qnty = buf_fbr-line.fact-qnty
     4049       .
     4050       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     4051       then do:
     4052       end.
     4053       else do:
     4054           for each buf_fbr-recipe-gds no-lock
     4055              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     4056                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     4057           on error undo, return error
     4058           :
     4059               find first buf_fbr-line no-lock
     4060                    where buf_fbr-line.doc-code    = p-doc-code
     4061                      and buf_fbr-line.is-comp     = no
     4062                      and buf_fbr-line.recipe-code = p-recipe-code
     4063                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4064                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4065                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4066               .
     4067               if buf_fbr-line.fact-qnty / v-comp-qnty <> buf_fbr-recipe-gds.brutto-qnty / v-recipe-qnty
     4068               then do:
     4069                   do transaction
     4070                   on error undo, return error
     4071                   :
     4072                       find first buf_el_fbr-recipe-gds exclusive-lock
     4073                            where recid( buf_el_fbr-recipe-gds ) = recid( buf_fbr-recipe-gds )
     4074                       .
     4075                       assign
     4076                           buf_el_fbr-recipe-gds.calc-method   = 1
     4077                           buf_el_fbr-recipe-gds.brutto-qnty   = buf_fbr-line.fact-qnty * v-recipe-qnty / v-comp-qnty
     4078                       .
     4079                       run fbrlib-calc-brutto in this-procedure (
     4080                             input buf_fbr-recipe.recipe-type
     4081                           , input 0
     4082                           , input buf_el_fbr-recipe-gds.coeff-value
     4083                           , input buf_el_fbr-recipe-gds.coeff-waste
     4084                           , input buf_el_fbr-recipe-gds.brutto-qnty
     4085                           , input 1
     4086                           , output buf_el_fbr-recipe-gds.qnty
     4087                           , output buf_el_fbr-recipe-gds.coeff-waste
     4088                           , output buf_el_fbr-recipe-gds.brutto-qnty
     4089                           , output buf_el_fbr-recipe-gds.calc-method
     4090                       ).
     4091                   end.
     4092               end.
     4093           end.
     4094           run fbrlib_adjust-doc-lines in this-procedure (
     4095                 input parparentproc
     4096               , input p-fbrhist-handle
     4097               , input p-doc-code
     4098               , input p-recipe-code
     4099               , input p-price-sale-obj-type
     4100               , input p-price-sale-obj-code
     4101           ).
     4102       end.
     4103   end.
     4104   END PROCEDURE.
     4105   PROCEDURE fbrlib_adjust-doc-lines :
     4106   define input parameter parparentproc as widget-handle no-undo .
     4107   define input parameter p-fbrhist-handle as handle no-undo .
     4108   define input parameter p-doc-code       as character    no-undo.
     4109   define input parameter p-recipe-code    as character    no-undo.
     4110   define input parameter p-price-sale-obj-type as character no-undo .
     4111   define input parameter p-price-sale-obj-code as integer no-undo .
     4112   define variable v-comp-qnty         as decimal      no-undo.
     4113   define variable v-trn-type          as character    no-undo.
     4114   define variable v-ingr-qnty         as decimal      no-undo.
     4115   define variable v-recipe-qnty       as decimal      no-undo.
     4116   define variable v-fbr-v-fbr-doc-line-recid    as recid        no-undo.
     4117   define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4118   define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4119   define buffer buf_fbr-line          for ub.fbr-line.
     4120   define buffer buf_coeff_fbr-line    for ub.fbr-line.
     4121   define buffer buf_goods             for ub.goods.
     4122   define buffer buf_fbr-doc           for ub.fbr-doc.
     4123   do
     4124   for buf_fbr-recipe
     4125     , buf_fbr-recipe-gds
     4126     , buf_fbr-line
     4127     , buf_coeff_fbr-line
     4128     , buf_goods
     4129     , buf_fbr-doc
     4130   on error undo, return error
     4131   :
     4132       find first buf_fbr-line no-lock
     4133            where buf_fbr-line.doc-code      = p-doc-code
     4134              and buf_fbr-line.is-comp       = yes
     4135              and buf_fbr-line.recipe-code   = p-recipe-code
     4136       .
     4137       find first buf_fbr-doc no-lock
     4138            where buf_fbr-doc.doc-code      = p-doc-code
     4139       .
     4140       assign
     4141           v-comp-qnty = buf_fbr-line.fact-qnty
     4142           v-trn-type  = buf_fbr-line.trn-type
     4143       .
     4144       find first buf_fbr-recipe no-lock
     4145            where buf_fbr-recipe.doc-code    = p-doc-code
     4146              and buf_fbr-recipe.recipe-code = p-recipe-code
     4147       .
     4148       assign
     4149       v-recipe-qnty = buf_fbr-recipe.qnty
     4150       .
     4151       do transaction
     4152       on error undo, return error
     4153       :
     4154           for each buf_fbr-recipe-gds no-lock
     4155              where buf_fbr-recipe-gds.doc-code      = p-doc-code
     4156                and buf_fbr-recipe-gds.recipe-code   = p-recipe-code
     4157           on error undo, return error
     4158           :
     4159               find first buf_fbr-line no-lock
     4160                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4161                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4162                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4163                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4164                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4165               no-error.
     4166               if not available buf_fbr-line
     4167               then do:
     4168                   find first buf_goods no-lock
     4169                        where buf_goods.artic      = buf_fbr-recipe-gds.artic
     4170                          and buf_goods.prod-type  = buf_fbr-recipe-gds.prod-type
     4171                          and buf_goods.prod-code  = buf_fbr-recipe-gds.prod-code
     4172                   .
     4173                   run str/fbr-crln.p (
     4174                         input parparentproc
     4175                       , input recid( buf_fbr-doc )
     4176                       , input recid( buf_goods )
     4177                       , input buf_fbr-recipe-gds.recipe-code
     4178                       , input v-trn-type
     4179                       , input no
     4180                       , input no
     4181                       , input buf_fbr-doc.obj-type
     4182                       , input buf_fbr-doc.obj-code
     4183                       , output v-fbr-v-fbr-doc-line-recid
     4184                   ).
     4185                   find first buf_fbr-line no-lock
     4186                        where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4187                          and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4188                          and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4189                          and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4190                          and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4191                   no-error.
     4192                   if not available buf_fbr-line
     4193                   then do:
     4194                       undo, return error substitute("Не удалось создать строку документа производства &1 &2&3&4"
     4195                                                      , p-doc-code
     4196                                                      , buf_fbr-recipe-gds.artic
     4197                                                      , buf_fbr-recipe-gds.prod-type
     4198                                                      , buf_fbr-recipe-gds.prod-code).
     4199                   end.
     4200               end.
     4201               find first buf_coeff_fbr-line exclusive-lock
     4202                    where recid( buf_coeff_fbr-line ) = recid( buf_fbr-line )
     4203               .
     4204               if buf_coeff_fbr-line.calc-method <> buf_fbr-recipe-gds.calc-method
     4205               or buf_coeff_fbr-line.coeff-value <> buf_fbr-recipe-gds.coeff-value
     4206               or buf_coeff_fbr-line.coeff-waste <> buf_fbr-recipe-gds.coeff-waste
     4207               then do:
     4208                   assign
     4209                       buf_coeff_fbr-line.calc-method = buf_fbr-recipe-gds.calc-method
     4210                       buf_coeff_fbr-line.coeff-value = buf_fbr-recipe-gds.coeff-value
     4211                       buf_coeff_fbr-line.coeff-waste = buf_fbr-recipe-gds.coeff-waste
     4212                   .
     4213               end.
     4214           end.
     4215       end.
     4216       define variable v-need-goods    as logical       no-undo.
     4217       define variable v-need-goods-list       as character     no-undo.
     4218       define variable v-need-goods-qnty-list  as character     no-undo.
     4219       find first buf_fbr-line no-lock
     4220            where buf_fbr-line.doc-code    = buf_fbr-doc.doc-code
     4221              and buf_fbr-line.is-comp     = yes
     4222              and buf_fbr-line.recipe-code = p-recipe-code
     4223       .
     4224       run str/fbr-qnty.p (
     4225             input parparentproc
     4226           , input p-fbrhist-handle
     4227           , input recid( buf_fbr-doc )
     4228           , input recid( buf_fbr-line )
     4229           , input no
     4230           , input "ingr"
     4231           , input no
     4232           , input p-price-sale-obj-type
     4233           , input p-price-sale-obj-code
     4234           , input no
     4235           , input no
     4236           , input no
     4237           , output v-need-goods
     4238           , output v-need-goods-list
     4239           , output v-need-goods-qnty-list
     4240       ).
     4241   end.
     4242   END PROCEDURE.
     4243   procedure fbrlib_check-before-close :
     4244   define input parameter p-doc-code as character no-undo .
     4245   define variable same-sale as decimal no-undo .
     4246   define variable is-waste as logical no-undo .
     4247   define variable fix-price as logical no-undo .
     4248   define buffer buf_fbr-doc for ub.fbr-doc.
     4249   define buffer buf_fbr-line for ub.fbr-line.
     4250   define buffer buf_goods for ub.goods.
     4251   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     4252   do
     4253   on error undo, return error
     4254   :
     4255     for each buf_fbr-line no-lock
     4256         where buf_fbr-line.doc-code = p-doc-code
     4257       , each buf_goods no-lock
     4258         where buf_goods.artic     = buf_fbr-line.artic
     4259           and buf_goods.prod-type = buf_fbr-line.prod-type
     4260           and buf_goods.prod-code = buf_fbr-line.prod-code
     4261     break by buf_fbr-line.prod-type
     4262           by buf_fbr-line.prod-code
     4263           by buf_fbr-line.artic
     4264     :
     4265       if first-of (buf_fbr-line.artic)
     4266       then do:
     4267         assign
     4268         same-sale = buf_fbr-line.price-sale
     4269         is-waste = (buf_fbr-line.rsrv-qnty = ?)
     4270         fix-price = buf_fbr-line.is-calc
     4271         .
     4272       end.
     4273       if same-sale <> buf_fbr-line.price-sale
     4274       then do:
     4275           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром должна быть указана одна и та же цена продажи."
     4276                                         ,p-doc-code
     4277                                         ,buf_goods.artic
     4278                                         ,buf_goods.gds-name
     4279                                         ,chr(10)).
     4280       end.
     4281       if fix-price <> buf_fbr-line.is-calc then do:
     4282           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром цена должна быть фиксирована или нет."
     4283                                         ,p-doc-code
     4284                                         ,buf_goods.artic
     4285                                         ,buf_goods.gds-name
     4286                                         ,chr(10)).
     4287       end.
     4288       if is-waste <> (buf_fbr-line.rsrv-qnty = ?)
     4289       then do:
     4290         undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа этот товар должен быть отходом либо не отходом."
     4291                                         ,p-doc-code
     4292                                         ,buf_goods.artic
     4293                                         ,buf_goods.gds-name
     4294                                         ,chr(10)).
     4295       end.
     4296       if buf_fbr-line.rsrv-qnty <> ?
     4297       and buf_goods.gds-type <> 'у':U
     4298       and ( buf_fbr-line.price-sale <= 0 or buf_fbr-line.price-sale = ?  )
     4299       and buf_fbr-line.fact-qnty <> 0
     4300       then do:
     4301         if buf_fbr-line.trn-type     = 'при':U  then for first buf_fbr-doc where buf_fbr-doc.doc-code =  p-doc-code no-lock:
     4302           if  can-find(first buf_fbr-gds-obj no-lock where
     4303                   buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     4304               AND buf_fbr-gds-obj.obj-type = buf_fbr-doc.obj-type
     4305               AND buf_fbr-gds-obj.obj-code = buf_fbr-doc.obj-code
     4306               and buf_fbr-gds-obj.is-null-price  )  then .
     4307                     else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4308                                         ,p-doc-code
     4309                                         ,buf_goods.artic
     4310                                         ,buf_goods.gds-name
     4311                                         ,chr(10)
     4312                                         ,buf_fbr-line.recipe-code
     4313                                         ).
     4314         end.
     4315         else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4316                                         ,p-doc-code
     4317                                         ,buf_goods.artic
     4318                                         ,buf_goods.gds-name
     4319                                         ,chr(10)
     4320                                         ,buf_fbr-line.recipe-code
     4321                                         ).
     4322       end.
     4323     end.
     4324   end.
     4325   end procedure.
     4326   procedure proc-alt-shift-f2:
     4327     if not ibs.th.gbl.gbl-var:rcode
     4328   then
     4329     run gbl\inidebug.p .
     4330   end.
     4331   procedure proc-alt-shift-f3:
     4332     run gbl/prvssinf.p
     4333       ( input this-procedure
     4334       ) .
     4335   end.
     4336   define variable v-inform-launched as logical no-undo initial false .
     4337   procedure proc-alt-shift-f4:
     4338     define variable v-action as character no-undo .
     4339     if v-inform-launched = false then do:
     4340       assign
     4341         v-inform-launched = true
     4342       .
     4343       run gbl/d-inform.w
     4344         (  input self
     4345         ,  input this-procedure
     4346         , output v-action
     4347         ) no-error .
     4348       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     4349       assign
     4350         v-inform-launched = false
     4351       .
     4352     end.
     4353   end.
     4354   procedure proc-alt-f1:
     4355     run gbl/corrhelp.p
     4356       (input this-procedure
     4357       ) .
     4358   end .
     4359   on alt-shift-f2 anywhere do:
     4360     run proc-alt-shift-f2.
     4361   end.
     4362   on alt-shift-f3 anywhere do:
     4363     run proc-alt-shift-f3 in this-procedure .
     4364   end.
     4365   on alt-shift-f4 anywhere do:
     4366     run proc-alt-shift-f4 in this-procedure.
     4367   end.
     4368   on alt-f1 anywhere do:
     4369     run proc-alt-f1 in this-procedure .
     4370   end.
