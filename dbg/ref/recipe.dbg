     4383   procedure gds-attr-name :
     4384     define input  parameter p-code           as character no-undo .
     4385     define output parameter p-type           as character no-undo .
     4386     define output parameter p-format         as character no-undo .
     4387     define output parameter p-label          as character no-undo .
     4388     define output parameter p-user-can-edit  as logical   no-undo .
     4389     define output parameter p-output-display as logical   no-undo .
     4390     define output parameter p-other          as character no-undo .
     4391     do
     4392     on error undo, return error
     4393     :
     4394           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-name in g#attr-lib
     4395         (input  p-code
     4396         ,output p-type
     4397         ,output p-format
     4398         ,output p-label
     4399         ,output p-user-can-edit
     4400         ,output p-output-display
     4401         ,output p-other
     4402         ) no-error .
     4403       if error-status :error
     4404       then do:
     4405         undo, return error return-value .
     4406       end.
     4407     end.
