     6072   procedure fbrnutro_proc-is-global-recipe :
     6073     define input  parameter p-recipe-code       as character no-undo .
     6074     define output parameter p-is-global-recipe  as logical   no-undo .
     6075     define buffer buf_recipe    for ub.recipe .
     6076   do
     6077   on error undo, return error return-value
     6078   :
     6079     find first buf_recipe no-lock
     6080       where buf_recipe.recipe-code = p-recipe-code
     6081     no-error .
     6082     if not available buf_recipe
     6083     then do:
     6084       return .
     6085     end.
     6086     assign
     6087       p-is-global-recipe =  ( buf_recipe.host-code = 0    ) and
     6088                             ( buf_recipe.obj-type  = "":U ) and
     6089                             ( buf_recipe.obj-code  = 0    )
     6090     .
     6091   end.
     6092   end procedure.
     6093   procedure fbrnutro_proc-get-gds-recipe-nutrition-by-code :
     6094     define input  parameter p-recipe-code as character no-undo .
     6095     define input  parameter p-artic       as character no-undo .
     6096     define input  parameter p-prod-type   as character no-undo .
     6097     define input  parameter p-prod-code   as integer   no-undo .
     6098     define input  parameter p-attr-code   as character no-undo .
     6099     define output parameter p-nutro-value as decimal   no-undo .
     6100     define buffer buf_goods       for ub.goods .
     6101     define buffer buf_fbr-gds-obj for ub.fbr-gds-obj .
     6102     define variable v-attr-value    as character no-undo .
     6103     define variable v-attr-type     as character no-undo .
     6104     define variable v-attr-code     as character no-undo .
     6105     define variable v-nutro-value   as decimal   no-undo .
     6106     define variable v-is-global     as logical   no-undo .
     6107     define variable v-exist         as logical   no-undo .
     6108     define variable v-is-fbr-gds    as logical   no-undo .
     6109   do
     6110   on error undo, return error return-value
     6111   :
     6112     assign
     6113       p-nutro-value = ?
     6114     .
     6115     find first buf_goods no-lock
     6116         where buf_goods.artic     = p-artic
     6117           and buf_goods.prod-type = p-prod-type
     6118           and buf_goods.prod-code = p-prod-code
     6119     no-error .
     6120     if not available buf_goods
     6121     then do:
     6122       return .
     6123     end.
     6124     assign
     6125       v-is-fbr-gds = no
     6126     .
     6127     find first buf_fbr-gds-obj no-lock
     6128       where buf_fbr-gds-obj.obj-type = v-cntxt-obj-type
     6129         and buf_fbr-gds-obj.obj-code = v-cntxt-obj-code
     6130         and buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     6131     no-error .
     6132     if available buf_fbr-gds-obj
     6133     then do:
     6134       if  buf_fbr-gds-obj.is-semi-finished or
     6135           buf_fbr-gds-obj.is-menu
     6136       then do:
     6137         assign
     6138           v-is-fbr-gds = yes
     6139           v-is-global  = fbrnutro_is-global-recipe(buf_fbr-gds-obj.default-recipe-code)
     6140         .
     6141       end.
     6142     end.
     6143     if v-is-fbr-gds = no
     6144     then do:
     6145       assign
     6146         v-is-global = yes
     6147       .
     6148     end.
     6149     case p-attr-code
     6150     :
     6151       when 'calories':U
     6152       then do:
     6153         if v-is-global = yes
     6154         then do:
     6155           assign
     6156             v-attr-code = 'calories':U
     6157           .
     6158           run gds-attr-exist in this-procedure ( input  buf_goods.gds-code                                                          , input  v-attr-code                                                          , output v-exist                                                          ) no-error .                     if error-status :error = yes or                         v-exist = no                     then do:                       return .                      end.                     run gds-attr-value in this-procedure ( input  buf_goods.gds-code                                                          , input  v-attr-code                                                          , output v-attr-value                                                          , output v-attr-type                                                          ) no-error .                     if error-status :error                     then do:                       return .                      end.                     assign                       v-nutro-value = decimal( v-attr-value )                     no-error .                     if error-status :error = yes                     then do:                       return .                      end.
     6159         end.
     6160         else do:
     6161           assign
     6162             v-attr-code = 'calories-o':U
     6163           .
     6164           run gdsoattr-exist in this-procedure ( input buf_goods.gds-code                                                         , input v-cntxt-obj-type                                                         , input v-cntxt-obj-code                                                         , input v-attr-code                                                         , output v-exist                                                         ) no-error .                    if error-status :error = yes or                       v-exist = no                    then do:                      return .                     end.                    run gdsoattr-value in this-procedure ( input  v-attr-code                                                         , input  buf_goods.gds-code                                                         , input v-cntxt-obj-type                                                         , input v-cntxt-obj-code                                                         , output v-attr-value                                                         , output v-attr-type                                                         ) no-error .                    if error-status :error = yes                    then do:                      return .                     end.                    assign                      v-nutro-value = decimal(v-attr-value)                    no-error .                    if error-status :error = yes                    then do:                      return .                     end.
     6165         end.
     6166       end.
     6167       when 'carbohydrate':U
     6168       then do:
     6169         if v-is-global = yes
     6170         then do:
     6171           assign
     6172             v-attr-code = 'carbohydrate':U
     6173           .
     6174           run gds-attr-exist in this-procedure ( input  buf_goods.gds-code                                                          , input  v-attr-code                                                          , output v-exist                                                          ) no-error .                     if error-status :error = yes or                         v-exist = no                     then do:                       return .                      end.                     run gds-attr-value in this-procedure ( input  buf_goods.gds-code                                                          , input  v-attr-code                                                          , output v-attr-value                                                          , output v-attr-type                                                          ) no-error .                     if error-status :error                     then do:                       return .                      end.                     assign                       v-nutro-value = decimal( v-attr-value )                     no-error .                     if error-status :error = yes                     then do:                       return .                      end.
     6175         end.
     6176         else do:
     6177           assign
