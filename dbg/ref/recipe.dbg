     5887   procedure nutro_get-nutrition-info :
     5888     define input  parameter p-artic         as character no-undo .
     5889     define input  parameter p-prod-type     as character no-undo .
     5890     define input  parameter p-prod-code     as integer   no-undo .
     5891     define input  parameter p-obj-type      as character no-undo .
     5892     define input  parameter p-obj-code      as integer   no-undo .
     5893     define output parameter p-calories      as decimal   no-undo .
     5894     define output parameter p-protein       as decimal   no-undo .
     5895     define output parameter p-carbohydrate  as decimal   no-undo .
     5896     define output parameter p-fat           as decimal   no-undo .
     5897     define buffer buf_goods    for ub.goods .
     5898     define variable v-attr-value    as character no-undo .
     5899     define variable v-attr-type     as character no-undo .
     5900     define variable v-attr-code     as character no-undo .
     5901     define variable v-exist         as logical   no-undo .
     5902     define variable v-is-global     as logical   no-undo .
     5903     define variable v-nutro-value   as decimal   no-undo .
     5904     define buffer buf_fbr-gds-obj  for ub.fbr-gds-obj.
     5905     define buffer buf_recipe       for ub.recipe.
     5906   do
     5907   on error undo, return error return-value
     5908   :
     5909     assign
     5910       p-carbohydrate  = ?
     5911       p-fat           = ?
     5912       p-protein       = ?
     5913       p-calories      = ?
     5914     .
     5915     find first buf_goods no-lock
     5916       where buf_goods.artic     = p-artic
     5917         and buf_goods.prod-type = p-prod-type
     5918         and buf_goods.prod-code = p-prod-code
     5919     no-error .
     5920     if not available buf_goods
     5921     then do:
     5922       return .
     5923     end.
     5924     assign
     5925       v-is-global = yes
     5926     .
     5927     find first buf_fbr-gds-obj no-lock
     5928       where buf_fbr-gds-obj.obj-type = p-obj-type
     5929         and buf_fbr-gds-obj.obj-code = p-obj-code
     5930         and buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     5931     no-error .
     5932     if available buf_fbr-gds-obj
     5933     then do:
     5934       if  buf_fbr-gds-obj.is-semi-finished or
     5935           buf_fbr-gds-obj.is-menu
     5936       then do:
     5937         assign
     5938           v-is-global = no
     5939         .
     5940         find first buf_recipe no-lock
     5941           where buf_recipe.recipe-code = buf_fbr-gds-obj.default-recipe-code
     5942         no-error .
     5943         if available buf_recipe
     5944         then do:
     5945           assign
     5946             v-is-global = ( buf_recipe.host-code = 0    ) and
     5947                           ( buf_recipe.obj-type  = "":U ) and
     5948                           ( buf_recipe.obj-code  = 0    )
     5949           .
     5950         end.
     5951       end.
     5952     end.
     5953     if v-is-global = yes
     5954     then do:
     5955       assign
     5956         v-attr-code = 'calories':U
     5957       .
     5958       assign                       v-nutro-value = ?                     .                     run gds-attr-exist in this-procedure ( input  buf_goods.gds-code                                                          , input  v-attr-code                                                          , output v-exist                                                          ) no-error .                     if error-status :error = yes or                         v-exist = no                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     else do:                       run gds-attr-value in this-procedure ( input  buf_goods.gds-code                                                           , input  v-attr-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                       if error-status :error                       then do:                         assign                           v-nutro-value = ?                         .                       end.                       assign                         v-nutro-value = decimal( v-attr-value )                       no-error .                       if error-status :error = yes                       then do:                         assign                           v-nutro-value = ?                         .                       end.                     end.
     5959       assign
     5960         p-calories  = v-nutro-value
     5961         v-attr-code = 'carbohydrate':U
     5962       .
     5963       assign                       v-nutro-value = ?                     .                     run gds-attr-exist in this-procedure ( input  buf_goods.gds-code                                                          , input  v-attr-code                                                          , output v-exist                                                          ) no-error .                     if error-status :error = yes or                         v-exist = no                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     else do:                       run gds-attr-value in this-procedure ( input  buf_goods.gds-code                                                           , input  v-attr-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                       if error-status :error                       then do:                         assign                           v-nutro-value = ?                         .                       end.                       assign                         v-nutro-value = decimal( v-attr-value )                       no-error .                       if error-status :error = yes                       then do:                         assign                           v-nutro-value = ?                         .                       end.                     end.
     5964       assign
     5965         p-carbohydrate  = v-nutro-value
     5966         v-attr-code     = 'fat':U
     5967       .
     5968       assign                       v-nutro-value = ?                     .                     run gds-attr-exist in this-procedure ( input  buf_goods.gds-code                                                          , input  v-attr-code                                                          , output v-exist                                                          ) no-error .                     if error-status :error = yes or                         v-exist = no                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     else do:                       run gds-attr-value in this-procedure ( input  buf_goods.gds-code                                                           , input  v-attr-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                       if error-status :error                       then do:                         assign                           v-nutro-value = ?                         .                       end.                       assign                         v-nutro-value = decimal( v-attr-value )                       no-error .                       if error-status :error = yes                       then do:                         assign                           v-nutro-value = ?                         .                       end.                     end.
     5969       assign
     5970         p-fat       = v-nutro-value
     5971         v-attr-code = 'protein':U
     5972       .
     5973       assign                       v-nutro-value = ?                     .                     run gds-attr-exist in this-procedure ( input  buf_goods.gds-code                                                          , input  v-attr-code                                                          , output v-exist                                                          ) no-error .                     if error-status :error = yes or                         v-exist = no                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     else do:                       run gds-attr-value in this-procedure ( input  buf_goods.gds-code                                                           , input  v-attr-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                       if error-status :error                       then do:                         assign                           v-nutro-value = ?                         .                       end.                       assign                         v-nutro-value = decimal( v-attr-value )                       no-error .                       if error-status :error = yes                       then do:                         assign                           v-nutro-value = ?                         .                       end.                     end.
     5974       assign
     5975         p-protein = v-nutro-value
     5976       .
     5977     end.
     5978     else do:
     5979       assign
     5980         v-attr-code = 'calories-o':U
     5981       .
     5982       assign                      v-nutro-value = ?                    .                    run gdsoattr-exist in this-procedure ( input buf_goods.gds-code                                                         , input p-obj-type                                                         , input p-obj-code                                                         , input v-attr-code                                                         , output v-exist                                                         ) no-error .                    if error-status :error = yes or                       v-exist = no                    then do:                     assign                       v-nutro-value = ?                     .                    end.                    else do:                     run gdsoattr-value in this-procedure ( input  v-attr-code                                                           , input  buf_goods.gds-code                                                           , input  p-obj-type                                                           , input  p-obj-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                     if error-status :error = yes                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     assign                       v-nutro-value = decimal(v-attr-value)                     no-error .                     if error-status :error = yes                     then do:                       assign                         v-nutro-value = ?                       .                     end.                    end.
     5983       assign
     5984         p-calories  = v-nutro-value
     5985         v-attr-code = 'carbohydrate-o':U
     5986       .
     5987       assign                      v-nutro-value = ?                    .                    run gdsoattr-exist in this-procedure ( input buf_goods.gds-code                                                         , input p-obj-type                                                         , input p-obj-code                                                         , input v-attr-code                                                         , output v-exist                                                         ) no-error .                    if error-status :error = yes or                       v-exist = no                    then do:                     assign                       v-nutro-value = ?                     .                    end.                    else do:                     run gdsoattr-value in this-procedure ( input  v-attr-code                                                           , input  buf_goods.gds-code                                                           , input  p-obj-type                                                           , input  p-obj-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                     if error-status :error = yes                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     assign                       v-nutro-value = decimal(v-attr-value)                     no-error .                     if error-status :error = yes                     then do:                       assign                         v-nutro-value = ?                       .                     end.                    end.
     5988       assign
     5989         p-carbohydrate  = v-nutro-value
     5990         v-attr-code     = 'fat-o':U
     5991       .
     5992       assign                      v-nutro-value = ?                    .                    run gdsoattr-exist in this-procedure ( input buf_goods.gds-code                                                         , input p-obj-type                                                         , input p-obj-code                                                         , input v-attr-code                                                         , output v-exist                                                         ) no-error .                    if error-status :error = yes or                       v-exist = no                    then do:                     assign                       v-nutro-value = ?                     .                    end.                    else do:                     run gdsoattr-value in this-procedure ( input  v-attr-code                                                           , input  buf_goods.gds-code                                                           , input  p-obj-type                                                           , input  p-obj-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                     if error-status :error = yes                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     assign                       v-nutro-value = decimal(v-attr-value)                     no-error .                     if error-status :error = yes                     then do:                       assign                         v-nutro-value = ?                       .                     end.                    end.
     5993       assign
     5994         p-fat       = v-nutro-value
     5995         v-attr-code = 'protein-o':U
     5996       .
     5997       assign                      v-nutro-value = ?                    .                    run gdsoattr-exist in this-procedure ( input buf_goods.gds-code                                                         , input p-obj-type                                                         , input p-obj-code                                                         , input v-attr-code                                                         , output v-exist                                                         ) no-error .                    if error-status :error = yes or                       v-exist = no                    then do:                     assign                       v-nutro-value = ?                     .                    end.                    else do:                     run gdsoattr-value in this-procedure ( input  v-attr-code                                                           , input  buf_goods.gds-code                                                           , input  p-obj-type                                                           , input  p-obj-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                     if error-status :error = yes                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     assign                       v-nutro-value = decimal(v-attr-value)                     no-error .                     if error-status :error = yes                     then do:                       assign                         v-nutro-value = ?                       .                     end.                    end.
     5998       assign
     5999         p-protein = v-nutro-value
     6000       .
     6001     end.
     6002   end.
     6003   end procedure.
     6004   define variable vss-include-info42 as character format "X(65)" no-undo
     6005   initial "@(#)$Workfile$ $Revision$".
     6006   function fbrnutro_is-global-recipe RETURNS logical
