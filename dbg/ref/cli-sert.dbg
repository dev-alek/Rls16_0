     1225           end.
     1226           assign
     1227             v-diasize-change-size = false
     1228           .
     1229           leave move_block .
     1230         end.
     1231       end.
     1232       assign
     1233         v-diasize-need-full-display = true
     1234       .
     1235       if v-diasize-change-size = false
     1236       then do:
     1237         assign
