      577   FUNCTION get-status RETURNS CHARACTER
      578     (buffer buf-sert for ub.sert )  FORWARD.
      579   DEFINE BUTTON B-add
      580        LABEL "&Добавить"
      581        SIZE 10 BY 1
      582        BGCOLOR 8 .
