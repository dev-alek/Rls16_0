     1657           and v-object-handle <> v-diasize-resize-button
     1658           and can-query(v-object-handle, "row")
     1659           and can-query(v-object-handle, "height")
     1660           and ( v-object-handle :col + v-object-handle :width
     1661                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1662               )
     1663           then do:
     1664             find first buf_temp-browse-handle
     1665               where buf_temp-browse-handle.browse-type   = 'width':u
     1666                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1667               no-error .
     1668             if available buf_temp-browse-handle
     1669             then do:
     1670             end.
     1671             else do:
     1672               create buf_temp-diasize-handle .
     1673               assign
     1674                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1675                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1676               .
     1677             end.
     1678           end.
     1679           assign
     1680             v-object-handle = v-object-handle :next-sibling
     1681           .
     1682         end.
     1683         assign
     1684           v-field-group-handle = v-field-group-handle :next-sibling
     1685         .
     1686       end.
     1687       do with frame Dialog-Frame
     1688       :
     1689         hide v-diasize-resize-button .
     1690         v-diasize-resize-button :row = 1.
     1691         v-diasize-resize-button :column = 1.
     1692       end.
     1693       if p-change-value > 0
     1694       then do:
     1695         if frame Dialog-Frame :scrollable = true
     1696         then do:
     1697           assign
     1698             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1699             no-error .
     1700           if error-status :error
     1701           or error-status :get-message(1) <> ""
     1702           then do:
     1703             undo move_block, retry move_block.
     1704           end.
     1705         end.
     1706         assign
     1707           frame Dialog-Frame :width = v-frame-width + p-change-value
     1708           no-error .
     1709         if error-status :error
     1710         or error-status :get-message(1) <> ""
     1711         then do:
     1712           undo move_block, retry move_block.
     1713         end.
     1714         assign
     1715           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1716         no-error .
     1717         if error-status :error
     1718         or error-status :get-message(1) <> ""
     1719         then do:
     1720           undo move_block, retry move_block.
     1721         end.
     1722         for each buf_temp-browse-handle
     1723           where buf_temp-browse-handle.browse-type = 'width':u
     1724         on error undo move_block, retry move_block
     1725         :
     1726           assign
     1727             buf_temp-browse-handle.browse-handle :width
     1728               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1729             no-error .
     1730           if error-status :error
     1731           or error-status :get-message(1) <> ""
     1732           then do:
     1733             undo move_block, retry move_block .
     1734           end.
     1735         end.
     1736         for each buf_temp-diasize-handle
     1737         on error undo move_block, retry move_block
     1738         :
     1739           assign
     1740             v-object-handle = buf_temp-diasize-handle.handle-value
     1741           .
     1742           if v-object-handle <> v-diasize-resize-button
     1743           then do:
     1744             assign
     1745               v-object-handle :col = v-object-handle :col + p-change-value
     1746               no-error .
     1747             if error-status :error
     1748             or error-status :get-message(1) <> ""
     1749             then do:
     1750               undo move_block, retry move_block .
     1751             end.
     1752           end.
     1753         end.
     1754       end.
     1755       else do:
     1756         for each buf_temp-diasize-handle
     1757         on error undo move_block, retry move_block
     1758         :
     1759           assign
     1760             v-object-handle = buf_temp-diasize-handle.handle-value
     1761           .
     1762           if v-object-handle <> v-diasize-resize-button
     1763           then do:
     1764             assign
     1765               v-object-handle :col = v-object-handle :col + p-change-value
     1766               no-error .
     1767             if error-status :error
     1768             or error-status :get-message(1) <> ""
     1769             then do:
     1770               undo move_block, retry move_block .
     1771             end.
     1772           end.
     1773         end.
     1774         for each buf_temp-browse-handle
     1775           where buf_temp-browse-handle.browse-type = 'width':u
     1776         on error undo move_block, retry move_block
     1777         :
     1778           assign
     1779             buf_temp-browse-handle.browse-handle :width
     1780               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1781             no-error .
     1782           if error-status :error
     1783           or error-status :get-message(1) <> ""
     1784           then do:
     1785             undo move_block, retry move_block .
     1786           end.
     1787         end.
     1788         assign
     1789           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1790           no-error .
     1791         if error-status :error
     1792         or error-status :get-message(1) <> ""
     1793         then do:
     1794           undo move_block, retry move_block.
     1795         end.
     1796         assign
     1797           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1798         no-error .
     1799         if error-status :error
     1800         or error-status :get-message(1) <> ""
     1801         then do:
     1802           undo move_block, retry move_block.
     1803         end.
     1804         if frame Dialog-Frame :scrollable = true
     1805         then do:
     1806           assign
     1807             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1808           no-error .
     1809           if error-status :error
     1810           or error-status :get-message(1) <> ""
     1811           then do:
     1812             undo move_block, retry move_block.
     1813           end.
     1814         end.
     1815       end.
     1816       if p-move-resize
     1817       then do:
     1818         run diasize_position-resize-button in this-procedure .
     1819       end.
     1820       if v-diasize-wndstore = true
     1821       then do:
     1822         if connected("ub") = true
     1823         then do:
     1824           define variable v-cntxt-db-num        as integer   no-undo .
     1825           define variable v-cntxt-userid        as character no-undo .
     1826           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1827                                             , OUTPUT v-cntxt-userid
     1828                                             ) .
     1829           run gbl/wndsizew.p
     1830             (input  v-cntxt-db-num
     1831             ,input  v-cntxt-userid
     1832             ,input  v-diasize-proc-name
     1833             ,input  'width':u
     1834             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1835             ) .
     1836         end.
     1837       end.
     1838     end.
     1839     assign
     1840       v-diasize-change-size = false
     1841     .
     1842   end procedure.
     1843   procedure diasize_set-width :
     1844     define input  parameter p-new-width  as decimal   no-undo .
     1845     define input  parameter p-move-resize as logical   no-undo .
     1846     do
     1847     on error undo, return error return-value
     1848     :
     1849       run diasize_change-width in this-procedure
     1850         (input  (p-new-width - frame Dialog-Frame :width)
     1851         ,input  p-move-resize
     1852         ) .
     1853     end.
     1854   end procedure.
     1855   procedure diasize_position-resize-button :
     1856     do with frame Dialog-Frame
     1857     :
     1858       hide v-diasize-resize-button .
     1859       assign
     1860         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1861                     - 1
     1862                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1863         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1864                     - 1
     1865                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1866       .
     1867       view v-diasize-resize-button .
     1868     end.
     1869   end procedure.
     1870   on alt-right anywhere
     1871   do:
     1872     run diasize_change-width in this-procedure
     1873       (input 1
     1874       ,input true
     1875       ) .
     1876     return no-apply .
     1877   end.
     1878   on alt-left anywhere
     1879   do:
     1880     run diasize_change-width in this-procedure
     1881       (input -1
     1882       ,input true
     1883       ) .
     1884     return no-apply .
     1885   end.
     1886   on alt-down anywhere
     1887   do:
     1888     run diasize_change-height in this-procedure
     1889       (input 1
     1890       ,input true
     1891       ) .
     1892     return no-apply .
     1893   end.
     1894   on alt-up anywhere
     1895   do:
     1896     run diasize_change-height in this-procedure
     1897       (input -1
     1898       ,input true
     1899       ) .
     1900     return no-apply .
     1901   end.
     1902   on alt-enter of frame Dialog-Frame
     1903   do:
     1904     run diasize_maximize in this-procedure
     1905       (input  ?
     1906       ).
     1907     return no-apply .
     1908   end.
     1909   procedure diasize_end-move :
     1910     do
     1911     on error undo, return error return-value
     1912     :
     1913       define variable v-row-delta as decimal   no-undo .
     1914       define variable v-col-delta as decimal   no-undo .
     1915       define variable v-new-row as decimal   no-undo .
     1916       define variable v-new-col as decimal   no-undo .
     1917       assign
     1918         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1919         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1920       .
     1921       assign
     1922         v-row-delta = v-new-row - frame Dialog-Frame :height
     1923         v-col-delta = v-new-col - frame Dialog-Frame :width
     1924       .
     1925       run diasize_change-height in this-procedure
     1926         (input v-row-delta
     1927         ,input true
     1928         ) .
     1929       run diasize_change-width in this-procedure
     1930         (input v-col-delta
     1931         ,input true
     1932         ) .
     1933     end.
     1934   end procedure.
     1935   procedure diasize_maximize :
     1936     define input  parameter p-action as logical   no-undo .
     1937     do
     1938     on error undo, return error return-value
     1939     :
     1940       if p-action = ?
     1941       then do:
     1942         if v-diasize-need-maximize = true
     1943         then do:
     1944           assign
     1945             p-action = true
     1946           .
     1947         end.
     1948         else do:
     1949           assign
     1950             p-action = false
     1951           .
     1952         end.
     1953       end.
     1954       if p-action = true
     1955       then do:
     1956         run diasize_change-height in this-procedure
     1957           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1958               - frame Dialog-Frame :height-chars
     1959           ,input true
     1960           ) .
     1961         run diasize_change-width in this-procedure
     1962           (input session :width-chars
     1963               - frame Dialog-Frame :width-chars
     1964           ,input true
     1965           ) .
     1966         assign
     1967           v-diasize-need-maximize = false
     1968         .
     1969       end.
     1970       else do:
     1971         run diasize_change-width in this-procedure
     1972           (input v-diasize-orig-frame-width
     1973               - frame Dialog-Frame :width-chars
     1974           ,input true
     1975           ) .
     1976         run diasize_change-height in this-procedure
     1977           (input v-diasize-orig-frame-height
     1978               - frame Dialog-Frame :height-chars
     1979           ,input true
     1980           ) .
     1981         assign
     1982           v-diasize-need-maximize = true
     1983         .
     1984       end.
     1985     end.
     1986   end procedure.
     1987   procedure diasize_restore-orig-size :
     1988     do
     1989     on error undo, return error return-value
     1990     :
     1991       assign
     1992         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1993         v-diasize-current-frame-height = frame Dialog-Frame :height
     1994       .
     1995       run diasize_set-height in this-procedure
     1996         (input  v-diasize-orig-frame-height
     1997         ,input  true
     1998         ) .
     1999       run diasize_set-width in this-procedure
     2000         (input  v-diasize-orig-frame-width
     2001         ,input  true
     2002         ) .
     2003     end.
     2004   end procedure.
     2005   procedure diasize_restore-current-size :
     2006     do
     2007     on error undo, return error return-value
     2008     :
     2009       run diasize_set-height in this-procedure
     2010         (input  v-diasize-current-frame-height
     2011         ,input  true
     2012         ) .
     2013       run diasize_set-width in this-procedure
     2014         (input  v-diasize-current-frame-width
     2015         ,input  true
     2016         ) .
     2017     end.
     2018   end procedure.
     2019   procedure diasize_set-browse-handle :
     2020     define input  parameter p-browse-handle as handle   no-undo .
     2021     define buffer buf_temp-browse-handle for temp-browse-handle .
     2022     do
     2023     on error undo, return error return-value
     2024     :
     2025       assign
     2026         v-diasize-browse-handle = p-browse-handle
     2027       .
     2028       for each buf_temp-browse-handle
     2029       on error undo, return error return-value
     2030       :
     2031         delete buf_temp-browse-handle .
     2032       end.
     2033     end.
     2034   end procedure.
     2035   procedure diasize_add_browse :
     2036     define input  parameter p-browse-type   as character no-undo .
     2037     define input  parameter p-browse-handle as handle    no-undo .
     2038     define buffer buf_temp-browse-handle for temp-browse-handle .
     2039     do
     2040     on error undo, return error return-value
     2041     :
     2042       assign
     2043         v-diasize-browse-number = v-diasize-browse-number + 1
     2044       .
     2045       create buf_temp-browse-handle .
     2046       assign
     2047         buf_temp-browse-handle.browse-type   = p-browse-type
     2048         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2049         buf_temp-browse-handle.browse-handle = p-browse-handle
     2050       .
     2051     end.
     2052   end procedure.
     2053   procedure diasize_init :
     2054     define variable v-default-value    as logical   no-undo .
     2055     define variable v-restore-saved    as logical   no-undo .
     2056     define variable v-resize-value-str as character no-undo .
     2057     do
     2058     on error undo, return error return-value
     2059     :
     2060       do with frame Dialog-Frame
     2061       :
     2062         assign
     2063           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2064           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2065           v-diasize-browse-handle     = browse br-sert :handle
     2066         .
     2067         create button v-diasize-resize-button
     2068         assign
     2069           parent        = frame Dialog-Frame :first-child
     2070           label         = "s"
     2071           height-pixels = 16
     2072           width-pixels  = 16
     2073           visible       = true
     2074           sensitive     = true
     2075           movable       = true
     2076           triggers:
     2077             on end-move persistent run diasize_end-move in this-procedure .
     2078           end triggers.
     2079         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2080         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2081         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2082         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2083         assign
     2084           v-diasize-wndmax = false
     2085         .
     2086         if connected("ub") = true
     2087         then do:
     2088           define variable v-cntxt-db-num        as integer   no-undo .
     2089           define variable v-cntxt-userid        as character no-undo .
     2090           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2091                                             , OUTPUT v-cntxt-userid
     2092                                             ) .
     2093           run gbl/wndpar_r.p
     2094             (input  v-cntxt-db-num
     2095             ,input  v-cntxt-userid
     2096             ,input  'wndmax':U
     2097             ,output v-diasize-wndmax
     2098             ,output v-default-value
     2099             ) .
     2100         end.
     2101         assign
     2102           v-diasize-wndstore = false
     2103         .
     2104         if connected("ub") = true
     2105         then do:
     2106           run gbl/wndpar_r.p
     2107             (input  v-cntxt-db-num
     2108             ,input  v-cntxt-userid
     2109             ,input  'wndstore':U
     2110             ,output v-diasize-wndstore
     2111             ,output v-default-value
     2112             ) .
     2113         end.
     2114         assign
     2115           v-diasize-proc-name = entry(1, program-name(2), '.')
     2116         .
     2117         if v-diasize-wndstore = true
     2118         then do:
     2119           assign
     2120             v-restore-saved = false
     2121           .
     2122           if connected("ub") = true
     2123           then do:
     2124             run gbl/wndsizer.p
     2125               (input  v-cntxt-db-num
     2126               ,input  v-cntxt-userid
     2127               ,input  v-diasize-proc-name
     2128               ,input  'height':u
     2129               ,output v-resize-value-str
     2130               ) .
     2131             if v-resize-value-str <> '':U
     2132             then do:
     2133               run diasize_change-height in this-procedure
     2134                 (input  integer(v-resize-value-str)
     2135                 ,input  true
     2136                 ) .
     2137               assign
     2138                 v-restore-saved = true
     2139               .
     2140             end.
     2141           end.
     2142           if connected("ub") = true
     2143           then do:
     2144             run gbl/wndsizer.p
     2145               (input  v-cntxt-db-num
     2146               ,input  v-cntxt-userid
     2147               ,input  v-diasize-proc-name
     2148               ,input  'width':u
     2149               ,output v-resize-value-str
     2150               ) .
     2151             if v-resize-value-str <> '':U
     2152             then do:
     2153               run diasize_change-width in this-procedure
     2154                 (input  integer(v-resize-value-str)
     2155                 ,input  true
     2156                 ) .
     2157               assign
     2158                 v-restore-saved = true
     2159               .
     2160             end.
     2161           end.
     2162           if v-restore-saved <> true
     2163           then do:
     2164             if v-diasize-wndmax = true
     2165             then do:
     2166               run diasize_maximize in this-procedure
     2167                 (input  true
     2168                 ) .
     2169             end.
     2170           end.
     2171         end.
     2172         else do:
     2173           if v-diasize-wndmax = true
     2174           then do:
     2175             run diasize_maximize in this-procedure
     2176               (input  true
     2177               ) .
     2178           end.
     2179         end.
     2180       end.
     2181     end.
     2182   end procedure.
     2183   procedure diasize_need-full-display :
     2184     define output parameter p-need-full-display as logical   no-undo .
     2185     do
     2186     on error undo, return error return-value
     2187     :
     2188       assign
     2189         p-need-full-display = v-diasize-need-full-display
     2190       .
     2191       assign
     2192         v-diasize-need-full-display = false
     2193       .
     2194     end.
     2195   end procedure.
     2196   procedure get-context :
     2197      define output parameter p-db-num as integer          no-undo.
     2198      define output parameter p-user-id as character        no-undo.
     2199      define variable v-login               as character    no-undo.
     2200      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2201      define buffer buf_user-login  for ub.user-login .
     2202      do
     2203      on error undo, return error
     2204      :
     2205            FIND FIRST buf_sys-ctrl no-lock.
     2206            ASSIGN
     2207               v-login = USERID("ub")
     2208               p-db-num = buf_sys-ctrl.db-num
     2209            .
     2210            FIND FIRST buf_user-login
     2211                 WHERE buf_user-login.db-num = p-db-num
     2212                   AND buf_user-login.user-login = v-login
     2213                 no-lock
     2214                 no-error
     2215                 .
     2216            IF AVAILABLE buf_user-login
     2217            THEN DO:
     2218               assign
     2219                  p-user-id = buf_user-login.user-id
     2220               .
     2221            END.
     2222      end.
     2223   end procedure.
     2224       run diasize_init in this-procedure .
     2225   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2226   do:
     2227     br-sert :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2228   end.
     2229   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2230   on f5 of frame Dialog-Frame anywhere
     2231   do:
     2232     v-doc-rec = recid(ub.sert). run openbr in this-procedure. reposition br-sert to recid(v-doc-rec). v-doc-rec = ? .
     2233       apply "VALUE-CHANGED" to br-sert.
     2234   end.
     2235   MAIN-BLOCK:
     2236   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2237      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2238   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2239     run mainmenu_getcntxt in parparentproc
     2240       (output v-cntxt-db-num
     2241       ,output v-cntxt-userid
     2242       ,output v-cntxt-level
     2243       ,output v-cntxt-host-code-obj
     2244       ,output v-cntxt-obj-type
     2245       ,output v-cntxt-obj-code
     2246       ,output v-cntxt-db-num-obj
     2247       ,output v-cntxt-is-admin
     2248       ) .
     2249     RUN MYenable in this-procedure .
     2250     run openbr in this-procedure .
     2251     WAIT-FOR GO OF FRAME Dialog-Frame.
     2252   END.
     2253   RUN disable_UI in this-procedure .
     2254   PROCEDURE disable_UI :
     2255     HIDE FRAME Dialog-Frame.
     2256   END PROCEDURE.
     2257   PROCEDURE enable_UI :
     2258     DISPLAY v-code v-type v-name v-days r-b-sort
     2259         WITH FRAME Dialog-Frame.
     2260     ENABLE b-exit B-add b-chg b-gds b-incl b-del B-hist B-Help v-type br-sert
     2261            v-days r-b-sort
     2262         WITH FRAME Dialog-Frame.
     2263     VIEW FRAME Dialog-Frame.
     2264     OPEN QUERY br-sert FOR EACH ub.sert       WHERE ub.sert.cli-type = i-type and ub.sert.cli-code = i-code NO-LOCK     BY sert.last-date DESCENDING.
     2265   END PROCEDURE.
     2266   PROCEDURE MyEnable :
     2267   define variable loc#log as logical no-undo.
     2268   define variable disablevar as integer no-undo.
     2269   assign
     2270   s-point = i-point
     2271   s-b-code = i-b-code
     2272   s-type = i-type
     2273   s-code = i-code
     2274   i-point = "all":U
     2275   .
     2276       FIND FIRST ub.db WHERE ub.db.db-num = v-cntxt-db-num NO-LOCK .
     2277       DISPLAY v-code v-type v-name r-b-sort
     2278           WITH FRAME Dialog-Frame.
     2279       ENABLE b-exit B-add b-chg b-gds b-hist B-Help br-sert b-del r-b-sort
     2280           WITH FRAME Dialog-Frame.
     2281       VIEW FRAME Dialog-Frame.
     2282   if s-point = "cli":U then do:
     2283     disablevar = 3.
     2284     assign
     2285     loc#log = r-b-sort:disable(radio-label(string(disablevar), r-b-sort:radio-buttons)).
     2286   end.
     2287       if s-point = "all":U then do:
     2288           DISABLE b-add b-chg b-del WITH FRAME Dialog-Frame.
     2289           ENABLE b-incl         WITH FRAME Dialog-Frame.
     2290       end.
     2291   END PROCEDURE.
     2292   PROCEDURE Openbr :
     2293   DEFINE VARIABLE v-today as date no-undo .
     2294   DEFINE VARIABLE v-time as integer no-undo .
     2295   run cur-time in this-procedure ( output v-today, output v-time).
     2296   case i-point:
     2297     when "cli":U then dO:
     2298       CASE s-point:
     2299         when "ALL":U then
     2300         OPEN QUERY br-sert
     2301         FOR EACH ub.sert WHERE
     2302                   ub.sert.cli-type = i-type and
     2303                   ub.sert.cli-code = i-code NO-LOCK
     2304         BY ub.sert.last-date DESCENDING.
     2305         when "cli":U then return.
     2306       END CASE.
     2307     end.
     2308     when "all":U then do:
     2309       CASE s-point:
     2310         when "all":U then
     2311         OPEN QUERY br-sert
     2312         FOR EACH ub.sert  NO-LOCK
     2313         BY ub.sert.last-date DESCENDING.
     2314         when "cli":U then
     2315         OPEN QUERY br-sert
     2316         FOR EACH ub.sert  NO-LOCK where
     2317                   (ub.sert.cli-type = s-type or s-type = ?) and
     2318                   (ub.sert.cli-code = s-code or s-code = ?)
     2319         BY ub.sert.last-date DESCENDING.
     2320       END CASE.
     2321     END.
     2322     when "true":U then do:
     2323       CASE s-point:
     2324         when "all":U then do:
     2325           OPEN QUERY br-sert
     2326           FOR EACH ub.sert  NO-LOCK WHERE
     2327                   ub.sert.last-date >= v-today
     2328               BY ub.sert.last-date DESCENDING.
     2329         end.
     2330         when "cli":U then dO:
     2331           OPEN QUERY br-sert
     2332           FOR EACH ub.sert WHERE
     2333                     (ub.sert.cli-type = s-type or s-type = ?) and
     2334                     (ub.sert.cli-code = s-code or s-code = ?) AND
     2335                     ub.sert.last-date >= v-today
     2336               BY ub.sert.last-date DESCENDING.
     2337         end.
     2338       END CASE.
     2339     end.
     2340     when "over":U then do:
     2341       CASE s-point:
     2342         when "all":U then do:
     2343           OPEN QUERY br-sert
     2344           FOR EACH ub.sert  NO-LOCK WHERE
     2345                   ub.sert.last-date < v-today
     2346               BY ub.sert.last-date DESCENDING.
     2347         end.
     2348         when "cli":U then do:
     2349             OPEN QUERY br-sert
     2350             FOR EACH ub.sert WHERE
     2351                       (ub.sert.cli-type = s-type or s-type = ?) and
     2352                       (ub.sert.cli-code = s-code or s-code = ?) AND
     2353                       ub.sert.last-date < v-today
     2354                 BY ub.sert.last-date DESCENDING.
     2355         end.
     2356       END CASE.
     2357     end.
     2358     when "day-off":U then do:
     2359       CASE s-point:
     2360         when "all":U then do:
     2361           OPEN QUERY br-sert
     2362           FOR EACH ub.sert  NO-LOCK WHERE
     2363                     (ub.sert.last-date > v-today AND (ub.sert.last-date - v-today) <= i-days)
     2364               BY ub.sert.last-date DESCENDING.
     2365         end.
     2366         when "cli":U then do:
     2367           OPEN QUERY br-sert
     2368           FOR EACH ub.sert WHERE
     2369                     (ub.sert.cli-type = s-type or s-type = ?) and
     2370                     (ub.sert.cli-code = s-code or s-code = ?) AND
     2371                 (ub.sert.last-date > v-today AND (ub.sert.last-date - v-today) <= i-days)
     2372               BY ub.sert.last-date DESCENDING.
     2373         end.
     2374       END CASE.
     2375     end.
     2376   end case.
     2377   APPLY "VALUE-CHANGED" TO BR-SERT in frame Dialog-Frame.
     2378   APPLY "ENTRY" TO BR-SERT in frame Dialog-Frame.
     2379   END PROCEDURE.
     2380   FUNCTION get-status RETURNS CHARACTER
     2381     (buffer buf-sert for sert ) :
     2382   DEFINE VARIABLE v-today as date no-undo .
     2383   DEFINE VARIABLE v-time as integer no-undo .
     2384   define variable stt as char .
     2385   run cur-time in this-procedure ( output v-today, output v-time).
     2386       if buf-sert.first-date > v-today then stt = "Будущие".
     2387       else do:
     2388           if buf-sert.last-date > v-today then stt = "Действ".
     2389           else
     2390               stt =  "Просроч".
     2391       end.
     2392     RETURN stt.
     2393   END FUNCTION.
