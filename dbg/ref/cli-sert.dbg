     1428       end.
     1429       if p-move-resize = true
     1430       then do:
     1431         run diasize_position-resize-button in this-procedure .
     1432       end.
     1433       if v-diasize-wndstore = true
     1434       then do:
     1435         if connected("ub") = true
     1436         then do:
     1437           define variable v-cntxt-db-num        as integer   no-undo .
     1438           define variable v-cntxt-userid        as character no-undo .
     1439           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1440                                             , OUTPUT v-cntxt-userid
     1441                                             ) .
     1442           run gbl/wndsizew.p
     1443             (input  v-cntxt-db-num
     1444             ,input  v-cntxt-userid
     1445             ,input  v-diasize-proc-name
     1446             ,input  'height':u
     1447             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1448             ) .
     1449         end.
     1450       end.
     1451     end.
     1452     assign
     1453       v-diasize-change-size = false
     1454     .
     1455   end procedure.
     1456   procedure diasize_set-height :
     1457     define input  parameter p-new-height  as decimal   no-undo .
     1458     define input  parameter p-move-resize as logical   no-undo .
     1459     do
     1460     on error undo, return error return-value
     1461     :
     1462       run diasize_change-height in this-procedure
     1463         (input  (p-new-height - frame Dialog-Frame :height)
     1464         ,input  p-move-resize
     1465         ) .
     1466     end.
     1467   end procedure.
     1468   procedure diasize_change-width :
     1469     define input  parameter p-change-value as decimal   no-undo .
     1470     define input  parameter p-move-resize  as logical   no-undo .
     1471     define variable v-field-group-handle   as handle    no-undo .
     1472     define variable v-object-handle        as handle    no-undo .
     1473     define variable v-frame-width          as decimal   no-undo .
     1474     define variable v-frame-virtual-width  as decimal   no-undo .
     1475     define variable v-browse-width         as decimal   no-undo .
     1476     define variable v-window-width         as decimal   no-undo .
     1477     define variable v-window-virtual-width as decimal   no-undo .
     1478     define variable v-change-sign          as integer   no-undo .
     1479     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1480     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1481     if p-change-value > 0
     1482     then do:
     1483       if frame Dialog-Frame :width + p-change-value >
     1484           session :width-chars
     1485       then do:
     1486         assign
     1487           p-change-value = session :width-chars - frame Dialog-Frame :width
     1488         .
     1489         if p-change-value <= 0
     1490         then do:
     1491           run diasize_position-resize-button in this-procedure .
     1492           return .
     1493         end.
     1494       end.
     1495     end.
     1496     if p-change-value < 0
     1497     then do:
     1498       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1499       then do:
     1500         assign
     1501           p-change-value = v-diasize-orig-frame-width
     1502                          - frame Dialog-Frame :width
     1503         .
     1504         if p-change-value >= 0
     1505         then do:
     1506           run diasize_position-resize-button in this-procedure .
     1507           return .
     1508         end.
     1509       end.
     1510     end.
     1511     if p-change-value >= 0
     1512     then do:
     1513       assign
     1514         v-change-sign = 1
     1515       .
     1516     end.
     1517     else do:
     1518       assign
     1519         v-change-sign = -1
     1520       .
     1521     end.
     1522     assign
     1523       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1524     .
     1525     if p-change-value = 0
     1526     then do:
     1527       run diasize_position-resize-button in this-procedure .
     1528       return .
     1529     end.
     1530     move_block:
     1531     do
     1532     on error undo move_block, leave move_block
     1533     :
     1534       if retry
     1535       then do:
     1536         do
     1537         on error undo move_block, leave move_block
     1538         :
     1539           if p-change-value > 0
     1540           then do:
     1541             for each buf_temp-diasize-handle
     1542             on error undo, next
     1543             :
     1544               assign
     1545                 v-object-handle = buf_temp-diasize-handle.handle-value
     1546               .
