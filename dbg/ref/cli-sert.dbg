      155   function diff-list returns character (
      156     input parfirst-list  as character,
      157     input parsecond-list as character,
      158     input pardelim       as character).
      159     if pardelim = ""
      160     or pardelim = ?
      161     then do:
      162       assign
      163         pardelim = ","
      164       .
      165     end.
      166     def var ind as integer no-undo .
      167     def var v-elem as character no-undo .
      168     def var v-result-list as character no-undo init "".
      169     def var v-num-parfirst-list as integer no-undo .
      170     assign
      171       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      172     .
      173     do ind = 1 to v-num-parfirst-list
      174     :
      175       assign
      176         v-elem = entry(ind, parfirst-list, pardelim)
      177       .
      178       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      179         assign
      180           v-result-list = v-result-list
      181                         + (if v-result-list > "" then pardelim else "")
      182                         + v-elem
      183         .
      184       end.
      185     end.
      186     return v-result-list .
      187   end function.
      188   function add-list returns character (
      189    input parfirst-list  as character,
      190    input parsecond-list as character,
      191    input pardelim       as character).
      192     if pardelim = ""
      193     or pardelim = ?
      194     then do:
      195       assign
      196         pardelim = ","
      197       .
      198     end.
      199     def var ind as integer no-undo .
      200     def var v-elem as character no-undo .
      201     def var v-result-list as character no-undo init "".
      202     def var v-num-parfirst-list as integer no-undo .
      203     assign
      204       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      205     .
      206     do ind = 1 to v-num-parfirst-list
      207     :
      208       assign
      209         v-elem = entry(ind, parfirst-list, pardelim)
      210       .
      211       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      212         assign
      213           v-result-list = v-result-list
      214                         + (if v-result-list > "" then pardelim else "")
      215                         + v-elem
      216         .
      217       end.
      218     end.
      219     def var v-num-parsecond-list as integer no-undo .
      220     assign
      221       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      222     .
      223     do ind = 1 to v-num-parsecond-list
      224     :
      225       assign
      226         v-elem = entry(ind, parsecond-list, pardelim)
      227       .
      228       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      229         assign
      230           v-result-list = v-result-list
      231                         + (if v-result-list > "" then pardelim else "")
      232                         + v-elem
      233         .
      234       end.
      235     end.
      236     return v-result-list .
      237   end function.
      238   function cross-list returns character (
      239    input parfirst-list  as character,
      240    input parsecond-list as character,
      241    input pardelim       as character).
      242     if pardelim = ""
      243     or pardelim = ?
      244     then do:
      245       assign
      246         pardelim = ","
      247       .
      248     end.
      249     def var ind as integer no-undo .
      250     def var v-elem as character no-undo .
      251     def var v-result-list as character no-undo init "".
      252     def var v-num-parfirst-list as integer no-undo .
      253     assign
      254       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      255     .
      256     do ind = 1 to v-num-parfirst-list
      257     :
      258       assign
      259         v-elem = entry(ind, parfirst-list, pardelim)
      260       .
      261       if lookup(v-elem, v-result-list, pardelim) = 0
      262       and lookup(v-elem, parsecond-list, pardelim) > 0
      263       then do:
      264         assign
      265           v-result-list = v-result-list
      266                         + (if v-result-list > "" then pardelim else "")
      267                         + v-elem
      268         .
      269       end.
      270     end.
      271     return v-result-list .
      272   end function.
      273   function radio-label returns character (
      274    input par-rs-value  as character,
      275    input par-rs-radio-buttons as character)
      276    .
      277    DEFINE variable v-result-label as character no-undo.
      278    assign
      279    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      280                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      281                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      282                             ), par-rs-radio-buttons
      283                           )
      284    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      285    .
      286   return v-result-label.
      287   end function.
      288   function m-radio-label returns character (
      289    input par-rs-value  as character,
      290    input par-rs-radio-buttons as character,
      291    input par-delim as character
      292    )
      293    .
      294    DEFINE variable v-result-label as character no-undo.
      295    assign
      296    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      297                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      298                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      299                             ), par-rs-radio-buttons, par-delim
      300                           )
      301    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      302    .
      303   return v-result-label.
      304   end function.
      305   FUNCTION mixlist returns character
      306   (
      307    input parfirst-list  as character
      308    ,input parsecond-list as character
      309    ,input pardelim       as character
      310    ,input pardelim-result as character ) :
      311     if pardelim = ""
      312     or pardelim = ?
      313     then do:
      314       assign
      315         pardelim = ","
      316       .
      317     end.
      318     def var ind as integer no-undo .
      319     def var v-elem1 as character no-undo .
      320     def var v-elem2 as character no-undo .
      321     def var v-result-list as character no-undo init "".
      322     do ind = 1 to num-entries(parfirst-list, pardelim)
      323     :
      324       assign
      325         v-elem1 = entry(ind, parfirst-list, pardelim)
      326         v-elem2 = entry(ind, parsecond-list, pardelim)
      327       .
      328         assign
      329           v-result-list = v-result-list
      330                         + (if v-result-list > "" then pardelim-result else "")
      331                         + v-elem1 + pardelim-result + v-elem2
      332         .
      333     end.
      334     return v-result-list .
      335   END FUNCTION.
      336   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      337   procedure cur-time :
      338      define output parameter p-today as date      no-undo .
      339      define output parameter p-time  as integer   no-undo .
      340     do
      341     on error undo, return error
      342     :
      343       define variable v-date1 as date      no-undo .
      344       define variable v-date2 as date      no-undo .
      345       define variable v-time  as integer   no-undo .
      346       assign
      347         v-date1 = today
      348         v-time  = time
      349         v-date2 = today
      350       .
      351       if v-date1 <> v-date2
      352       then do:
      353         assign
      354           v-date1 = today
      355           v-time  = v-time
      356         .
      357       end.
      358       assign
      359         p-today = v-date1
      360         p-time  = v-time
      361       .
      362     end.
      363   end.
      364   function cur-time-date returns character
      365   :
      366     return string(today, '99/99/9999':U) .
      367   end.
      368   function cur-time-mjd returns decimal
      369   :
      370     define variable v-date as date      no-undo .
      371     define variable v-time as integer   no-undo .
      372     run cur-time in this-procedure
      373       (output v-date
      374       ,output v-time
      375       ) .
      376     return integer(v-date) - 2400002 + (v-time / 86400) .
      377   end.
      378   function cur-time-get-ending-index returns integer
      379   (input p-number as integer
      380   )
      381   :
      382     if p-number < 0
      383     or p-number = ?
      384     then do:
      385       return 1 .
      386     end.
      387     define variable v-rest as integer   no-undo .
      388     assign
      389       p-number = p-number modulo 100
      390     .
      391     if p-number < 20
      392     then do:
      393       assign
      394         v-rest = p-number
      395       .
      396     end.
      397     else do:
      398       assign
      399         v-rest = p-number modulo 10
      400       .
      401     end.
      402     case v-rest :
      403       when 1
      404       then do:
      405         return 2 .
      406       end.
      407       when 2 or
      408       when 3 or
      409       when 4
      410       then do:
      411         return 3 .
      412       end.
      413       otherwise do:
      414         return 1 .
      415       end.
      416     end case .
      417   end.
      418   procedure cur-time-mjd-to-date :
      419      define input  parameter i-mjd-diff as decimal no-undo.
      420      define output parameter o-Date     as date    no-undo.
      421      define output parameter o-Time     as integer no-undo.
      422      define variable v-day-number as integer   no-undo .
      423      if    i-mjd-diff < 0
      424         or i-mjd-diff = ?
      425      then do:
      426         return "?" .
      427      end.
      428      assign
      429         v-day-number = truncate(i-mjd-diff,0).
      430         o-Date = date(v-day-number + 2400002).
      431         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      432     .
      433   end.
      434   function cur-time-mjd-to-string returns character
      435   (input p-mjd-diff as decimal
      436   )
      437   :
      438     define variable v-day-number as integer   no-undo .
      439     define variable v-seconds    as integer   no-undo .
      440     define variable v-hour       as integer   no-undo .
      441     define variable v-min        as integer   no-undo .
      442     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      443     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      444     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      445     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      446     if p-mjd-diff < 0
      447     or p-mjd-diff = ?
      448     then do:
      449       return "?" .
      450     end.
      451     assign
      452       v-day-number = integer(truncate(p-mjd-diff,0))
      453       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      454     .
      455     if v-seconds > 86400
      456     then do:
      457       assign
      458         v-seconds = 86400 - 1
      459       .
      460     end.
      461     if v-seconds < 0
      462     then do:
      463       assign
      464         v-seconds = 0
      465       .
      466     end.
      467     assign
      468       v-hour = truncate(v-seconds / 3600, 0)
      469     .
      470     assign
      471       v-seconds = v-seconds modulo 3600
      472     .
      473     assign
      474       v-min = truncate(v-seconds / 60, 0)
      475     .
      476     assign
      477       v-seconds = v-seconds modulo 60
      478     .
      479     return
      480         (if v-day-number <> 0
      481           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      482           else ""
      483         )
      484       + (if v-day-number <> 0 or v-hour <> 0
      485           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      486           else ""
      487         )
      488       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      489           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      490           else ""
      491         )
      492       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      493       .
      494   end.
      495   function cur-time-string returns character
      496   :
      497     define variable v-date as date      no-undo .
      498     define variable v-time as integer   no-undo .
      499     run cur-time in this-procedure
      500       (output v-date
      501       ,output v-time
      502       ) .
      503     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      504   end.
      505   function cur-time-string-sec returns character
      506   :
      507     define variable v-date as date      no-undo .
      508     define variable v-time as integer   no-undo .
      509     run cur-time in this-procedure
      510       (output v-date
      511       ,output v-time
      512       ) .
      513     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      514   end.
      515   function cur-time-custom  returns character
      516   (input p-prefix as character
      517   ,input p-date-format as character
      518   ,input p-delimiter as character
      519   ,input p-time-format as character
      520   ,input p-suffix as character
      521   )
      522   :
      523     define variable v-date as date      no-undo .
      524     define variable v-time as integer   no-undo .
      525     run cur-time in this-procedure
      526       (output v-date
      527       ,output v-time
      528       ) .
      529     return
      530       p-prefix
      531       + string(v-date, p-date-format)
      532       + p-delimiter
      533       + string(v-time, p-time-format)
      534       + p-suffix
      535       .
      536   end.
      537   function cur-time-print  returns character
      538   :
      539     define variable v-date as date      no-undo .
      540     define variable v-time as integer   no-undo .
      541     run cur-time in this-procedure
      542       (output v-date
      543       ,output v-time
      544       ) .
      545     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      546   end.
      547   function cur-time-datetime returns datetime
      548   :
      549     define variable v-char as character no-undo .
      550     define variable v-datetime as datetime no-undo .
      551     v-char = cur-time-string().
      552     v-datetime = datetime(v-char).
      553     return  v-datetime.
      554   end.
      555   function cur-time-string-msec returns character
      556   :
      557     define variable v-date as datetime  no-undo .
      558     v-date = now.
      559     return string(v-date) .
      560   end.
