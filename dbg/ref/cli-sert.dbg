     1271           and can-query(v-object-handle, "row")
     1272           and can-query(v-object-handle, "height")
     1273           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1274           then do:
     1275             find first buf_temp-browse-handle
     1276               where buf_temp-browse-handle.browse-type   = 'height':u
     1277                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1278               no-error .
     1279             if available buf_temp-browse-handle
     1280             then do:
     1281             end.
     1282             else do:
     1283               create buf_temp-diasize-handle .
     1284               assign
     1285                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1286                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1287               .
     1288             end.
     1289           end.
     1290           assign
     1291             v-object-handle = v-object-handle :next-sibling
     1292           .
     1293         end.
     1294         assign
     1295           v-field-group-handle = v-field-group-handle :next-sibling
     1296         .
     1297       end.
     1298       do with frame Dialog-Frame
     1299       :
     1300         hide v-diasize-resize-button .
     1301         assign
     1302           v-diasize-resize-button :row    = 1
     1303           v-diasize-resize-button :column = 1
     1304         .
     1305       end.
     1306       if p-change-value > 0
     1307       then do:
     1308         if frame Dialog-Frame :scrollable = true
     1309         then do:
     1310           assign
     1311             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1312             no-error .
     1313           if error-status :error
     1314           or error-status :get-message(1) <> ""
     1315           then do:
     1316             undo move_block, retry move_block .
     1317           end.
     1318         end.
     1319         assign
     1320           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1321           no-error .
