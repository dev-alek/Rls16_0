      590        LABEL "&Выход"
      591        SIZE 10 BY 1
      592        BGCOLOR 8 .
      593   DEFINE BUTTON b-gds
      594        LABEL "&Товары"
      595        SIZE 10 BY 1.
      596   DEFINE BUTTON B-Help
      597        LABEL "Помо&щь"
      598        SIZE 10 BY 1
      599        BGCOLOR 8 .
      600   DEFINE BUTTON B-hist
      601        LABEL "Ис&тория"
      602        SIZE 10 BY 1.
      603   DEFINE BUTTON b-incl
      604        LABEL "В&ключить"
      605        SIZE 10 BY 1.
      606   DEFINE VARIABLE sert-num AS CHARACTER FORMAT "X(35)":U INITIAL "12345678901234567890123456789012345"
      607        VIEW-AS FILL-IN
      608        SIZE 37 BY 1 NO-UNDO.
      609   DEFINE VARIABLE v-code AS INTEGER FORMAT ">>>>>>>>9" INITIAL 0
      610        LABEL "Код"
      611        VIEW-AS FILL-IN
      612        SIZE 13.38 BY 1
      613        FGCOLOR 12  NO-UNDO.
      614   DEFINE VARIABLE v-days AS INTEGER FORMAT ">>9":U INITIAL 0
      615        VIEW-AS FILL-IN
      616        SIZE 10 BY 1 NO-UNDO.
      617   DEFINE VARIABLE v-name AS CHARACTER FORMAT "X(30)"
      618        LABEL "Название"
      619        VIEW-AS FILL-IN
      620        SIZE 55.25 BY 1
      621        FGCOLOR 12  NO-UNDO.
      622   DEFINE VARIABLE v-type AS CHARACTER FORMAT "X(3)":U
      623        VIEW-AS FILL-IN
      624        SIZE 3.88 BY 1 NO-UNDO.
      625   DEFINE VARIABLE r-b-sort AS INTEGER
      626        VIEW-AS RADIO-SET HORIZONTAL
      627        RADIO-BUTTONS
      628             "Все", 1,
      629   "Сертификат", 2,
      630   "Код Контрагента", 3,
      631   "Действ.", 4,
      632   "Просроч.", 5,
      633   "Истекающ.", 6
      634        SIZE 72.63 BY .88 NO-UNDO.
      635   DEFINE QUERY br-sert FOR
      636         ub.sert SCROLLING.
      637   DEFINE BROWSE br-sert
      638     QUERY br-sert NO-LOCK DISPLAY
      639         ub.sert.sert-code format "x(20)"
      640         ub.sert.first-date
      641         ub.sert.last-date
      642         get-status (buffer ub.sert) COLUMN-LABEL "Статус" FORMAT "X(7)"
      643         ub.sert.sert-org
      644         ub.sert.blank-num
      645         ub.sert.PS
      646       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.5 BY 10.25.
      647   DEFINE FRAME Dialog-Frame
      648        b-exit AT ROW 1 COL 1
      649        B-add AT ROW 1 COL 11
      650        b-chg AT ROW 1 COL 21
      651        b-gds AT ROW 1 COL 31
      652        b-incl AT ROW 1 COL 41
      653        b-del AT ROW 1 COL 51
      654        B-hist AT ROW 1 COL 71
      655        B-Help AT ROW 1 COL 81.13
      656        v-code AT ROW 2.92 COL 4 COLON-ALIGNED
      657        v-type AT ROW 2.92 COL 17.75 COLON-ALIGNED NO-LABEL
      658        v-name AT ROW 2.92 COL 33.75 COLON-ALIGNED
      659        br-sert AT ROW 3.96 COL 1
      660        v-days AT ROW 14.46 COL 83 COLON-ALIGNED NO-LABEL
      661        r-b-sort AT ROW 14.63 COL 10.25 NO-LABEL
      662        sert-num AT ROW 15.5 COL 56 COLON-ALIGNED NO-LABEL
      663        "Фильтр :" VIEW-AS TEXT
      664             SIZE 8.38 BY .88 AT ROW 14.67 COL 1
      665        SPACE(89.86) SKIP(1.08)
      666       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      667            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      668            TITLE " Сертификаты"
      669            DEFAULT-BUTTON B-add CANCEL-BUTTON b-exit.
      670   ASSIGN
      671          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      672          FRAME Dialog-Frame:HIDDEN           = TRUE.
      673   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      674   DO:
      675     APPLY "END-ERROR":U TO SELF.
      676   END.
      677   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      678   DO:
      679     rid = ?.
      680     run ref/add-sert.w ( input parparentproc
      681                         ,input p-curr-obj-type
      682                         ,input p-curr-obj-code
      683                         ,input 'ДОБАВЛЕНИЕ':U
      684                         ,input-output rid
      685                         ,input i-type
      686                         ,input i-code).
      687     if rid = ? then return no-apply.
      688     OPEN QUERY br-sert FOR EACH ub.sert       WHERE ub.sert.cli-type = i-type and ub.sert.cli-code = i-code NO-LOCK     BY sert.last-date DESCENDING.
      689     reposition br-sert to recid rid.
      690     apply "ENTRY" to br-sert.
      691     apply "VALUE-CHANGED":U to br-sert.
      692   END.
      693   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      694   DO:
      695     if not available ub.sert then do:
      696       message "Неправильно выбрана строка.".
      697       return no-apply.
      698     end.
      699     rid = recid (ub.sert).
      700     run ref/add-sert.w ( input parparentproc
      701                         ,input p-curr-obj-type
      702                         ,input p-curr-obj-code
      703                         ,input 'ИЗМЕНЕНИЕ':U
      704                         ,input-output rid
      705                         ,input i-type
      706                         ,input i-code).
      707     if rid = ? then return no-apply.
      708     OPEN QUERY br-sert FOR EACH ub.sert       WHERE ub.sert.cli-type = i-type and ub.sert.cli-code = i-code NO-LOCK     BY sert.last-date DESCENDING.
      709     reposition br-sert to recid rid.
      710     apply "ENTRY" to br-sert.
      711     apply "VALUE-CHANGED":U to br-sert.
      712   END.
      713   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      714   DO:
      715     define variable ri as recid no-undo.
      716     define variable rr as recid no-undo.
      717     DEFINE VARIABLE v-today as date no-undo .
      718     DEFINE VARIABLE v-time as integer no-undo .
      719     if not available ub.sert THEN return no-apply.
      720     message "Удалить сертификат " ub.sert.sert-code " ?"
      721                      view-as alert-box  warning buttons  yes-no set OK as log .
      722     if OK   then do:
      723       run cur-time in this-procedure ( output v-today, output v-time).
      724         if ub.sert.last-date >= v-today and can-find( first ub.sert-join where ub.sert.sert-code = ub.sert-join.sert-code) then do:
      725               message "По этому сертификату есть товары и сертификат не просрочен. Удаление невозможно."
      726               view-as alert-box error.
      727               return no-apply.
      728         end.
      729         ri = recid( ub.sert ).
      730         get prev br-sert .
      731         if available ub.sert
      732             then   rr = recid( ub.sert ).
      733             else do:
      734                 get next br-sert.
      735                 get next br-sert.
      736                 rr = recid( sert ).
      737             end.
      738         find ub.sert where recid( ub.sert ) = ri.
      739         for each ub.sert-join where ub.sert-join.sert-code = ub.sert.sert-code:
      740           delete ub.sert-join.
      741         end.
      742         delete sert.
      743         run openbr in this-procedure .
      744         reposition br-sert to recid rr no-error.
      745         apply "ENTRY":U to br-sert.
      746         apply "VALUE-CHANGED":U to br-sert.
      747      end.
      748   END.
      749   ON CHOOSE OF b-gds IN FRAME Dialog-Frame
      750   DO:
      751     if avail ub.sert then
      752     run ref/gds-sert.w (
      753                    input parparentproc
      754                  , input p-curr-obj-type
      755                  , input p-curr-obj-code
      756                  , input (if ub.db.add-goods then 'ИЗМЕНЕНИЕ':U else 'ПРОСМОТР':U)
      757                  , input "sert":U
      758                  , input ?
      759                  , input ub.sert.cli-type
      760                  , input ub.sert.cli-code
      761                  , input ub.sert.sert-code) no-error.
      762     END.
      763   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
      764   DO:
      765     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      766     IF NOT AVAILABLE ub.sert THEN RETURN.
      767     run ref/c-serts.w (
      768                   INPut parParentProc
      769                  ,INPUT '':U
      770                  ,INPUT 'one'
      771                  ,INPUT ub.sert.cli-type
      772                  ,INPUT ub.sert.cli-code
      773                  ,INPUT ub.sert.sert-code
      774                  ,INPUT 0
      775                  ,INPUT '':U
      776                  ,INPUT-OUTPUT v-rid-list) NO-ERROR.
      777   END.
      778   ON CHOOSE OF b-incl IN FRAME Dialog-Frame
      779   DO:
      780       find ub.bar-code where ub.bar-code.b-code = i-b-code no-lock.
      781       find ub.goods where ub.goods.gds-code = ub.bar-code.gds-code no-lock.
      782       find ub.sert-join where
      783               ub.sert-join.cli-type = ub.sert.cli-type    and
      784               ub.sert-join.cli-code = ub.sert.cli-code    and
      785               ub.sert-join.sert-code = ub.sert.sert-code  and
      786               ub.sert-join.b-code = i-b-code no-error.
      787       if available ub.sert-join then do:
      788         message "Такой сертификат для данного товара уже включен" view-as alert-box error.
      789         return no-apply.
      790       end.
      791       message "Вы действительно хотите включить этот сертификат для товара " ub.goods.gds-name
      792           view-as alert-box question buttons Yes-No update g-log as log.
      793       if g-log then do:
      794         create ub.sert-join.
      795         assign
      796         ub.sert-join.sert-code = ub.sert.sert-code
      797         ub.sert-join.cli-code = ub.sert.cli-code
      798         ub.sert-join.cli-type = ub.sert.cli-type
      799         ub.sert-join.b-code = i-b-code.
      800         release ub.sert-join no-error .
      801         if error-status:error then do:
      802           message
      803           "Не удалось включить сертификат для товара" skip
      804           error-status:get-message(1) return-value
      805           view-as alert-box .
      806         end.
      807      end.
      808   END.
      809   ON VALUE-CHANGED OF br-sert IN FRAME Dialog-Frame
      810   DO:
      811        find ub.clients where ub.clients.obj-type = ub.sert.cli-type and
      812                                     ub.clients.obj-code = ub.sert.cli-code no-lock no-error.
      813        if available ub.clients then
      814           assign
      815              v-code = ub.clients.obj-code
      816              v-type = ub.clients.obj-type
      817              v-name = ub.clients.obj-name.
      818        else if i-code <> ? and i-type <> ? then do:
      819            find ub.clients where ub.clients.obj-type = i-type and
      820                                     ub.clients.obj-code = i-code no-lock no-error.
      821           assign
      822              v-code = i-code
      823              v-type = i-type
      824              v-name = ub.clients.obj-name.
      825        end.
      826        disp v-code v-type v-name with frame Dialog-Frame.
      827   END.
      828   ON VALUE-CHANGED OF r-b-sort IN FRAME Dialog-Frame
      829   DO:
      830     assign r-b-sort.
      831     case r-b-sort:
      832       when 2 then do:
      833           disable v-code v-type with frame Dialog-Frame.
      834           view sert-num .
      835           enable sert-num with frame Dialog-Frame.
      836           apply "entry" to sert-num.
      837           return no-apply.
      838       end.
      839       when 3 then do:
      840           disable sert-num with frame Dialog-Frame.
      841           hide sert-num .
      842           if i-point = "cli":U then do:
      843               message "Сортировка итак по одному клиенту" view-as alert-box warning.
      844               r-b-sort = 1.
      845               disp r-b-sort with frame Dialog-Frame.
      846               apply "VALUE-CHANGED":U to r-b-sort.
      847           end.
      848           else do:
      849               enable v-code v-type with frame Dialog-Frame.
      850               apply "entry" to v-code.
      851               return no-apply.
      852           end.
      853       end.
      854       when 5 then do:
      855           disable v-type v-code sert-num v-days with frame Dialog-Frame.
      856           hide v-type v-code v-days sert-num.
      857           if i-point = "over":U then do:
      858               message "Сортировка итак по просроченным" view-as alert-box warning.
      859               r-b-sort = 1.
      860               disp r-b-sort with frame Dialog-Frame.
      861               apply "VALUE-CHANGED":U to r-b-sort.
      862           end.
      863           i-point = "over":U.
      864           RUN OpenBr in this-procedure .
      865       end.
      866       when 4 then do:
      867           disable v-type v-code sert-num v-days with frame Dialog-Frame.
      868           hide v-type v-code sert-num v-days.
      869           if i-point = "true":U then do:
      870               message "Сортировка итак по действующим" view-as alert-box warning.
      871               r-b-sort = 1.
      872               disp r-b-sort with frame Dialog-Frame.
      873               apply "VALUE-CHANGED":U to r-b-sort.
      874           end.
      875           i-point = "true":U.
      876           RUN OpenBr in this-procedure .
      877       end.
      878       when 6 then do:
      879           disable v-type v-code sert-num with frame Dialog-Frame.
      880           hide v-type v-code sert-num .
      881           enable v-days with frame Dialog-Frame.
      882           apply "entry" to v-days.
      883           return no-apply.
      884       end.
      885       otherwise do:
      886           disable sert-num v-code v-type v-days with frame Dialog-Frame.
      887           hide sert-num v-days.
      888           i-point = "all":U.
      889           run OpenBr in this-procedure .
      890        end.
      891     end case.
      892   END.
      893   ON RETURN OF sert-num IN FRAME Dialog-Frame
      894   DO:
      895     def buffer buf-s for ub.sert.
      896     assign sert-num.
      897     if sert-num <> "" then do:
      898         find first buf-s where buf-s.sert-code = sert-num no-lock no-error.
      899         if available buf-s then do:
      900           reposition br-sert to recid recid(buf-s).
      901           apply "ENTRY" to br-sert.
      902           apply "VALUE-CHANGED":U to br-sert.
      903         end.
      904         else
      905           message "Сертификат не найден" view-as alert-box warning.
      906     end.
      907   END.
      908   ON RETURN OF v-code IN FRAME Dialog-Frame
      909   DO:
      910     assign v-code .
      911     if v-code <> 0 then do:
      912           apply "ENTRY" to v-type.
      913           return no-apply.
      914     end.
      915     else do:
      916               r-b-sort = 1.
      917               disp r-b-sort with frame Dialog-Frame.
      918               apply "VALUE-CHANGED":U to r-b-sort.
      919               return no-apply.
      920     end.
      921   END.
      922   ON RETURN OF v-days IN FRAME Dialog-Frame
      923   DO:
      924        assign
      925         v-days
      926         i-days = v-days
      927         i-point = "day-off":U.
      928         run Openbr in this-procedure .
      929     return no-apply.
      930   END.
      931   ON RETURN OF v-type IN FRAME Dialog-Frame
      932   DO:
      933     assign
      934     v-code v-type
      935     i-code = v-code
      936     i-type = v-type
      937     i-point = "cli":U.
      938     if can-find(first ub.clients where ub.clients.obj-type = i-type and ub.clients.obj-code = i-code) then
      939         run OpenBr in this-procedure .
      940     else
      941       message "НЕт такого контрагента" view-as alert-box warning.
      942     i-point = "all":U.
      943     return no-apply.
      944   END.
      945   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      946   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      947   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      948   on help of frame Dialog-Frame
      949   do:
      950     run gbl/app_help.p
      951       (input this-procedure :file-name
      952       ,input ''
      953       ,input ?
      954       ) no-error.
      955     if error-status :error then do:
      956       message
      957         "Ошибка при вызове помощи"
      958         error-status :get-message(1)
      959         view-as alert-box .
      960     end.
      961   end.
      962   run minbtn-set in this-procedure .
      963   on choose of b-help in frame Dialog-Frame
      964   do:
      965     apply "help":u to frame Dialog-Frame .
      966   end.
      967   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      968   procedure minbtn-set :
      969       do
      970           on error undo, return error return-value
      971           :
      972           define variable ii              as integer       no-undo .
      973           define variable fh              as widget-handle no-undo .
      974           define variable hh              as widget-handle no-undo .
      975           define variable v-h             as handle        extent 4 no-undo .
      976           define variable v-name-button   as character     no-undo .
      977           define variable v-help-old-x    as decimal       no-undo .
      978           define variable v-help-old-y    as decimal       no-undo .
      979           define variable v-help-old-size as decimal       no-undo .
      980           define variable v-frame-width   as decimal       no-undo .
      981           define variable jj              as integer       no-undo .
      982           do
      983               on error undo, return error
      984               :
      985               assign
      986                   v-frame-width = frame Dialog-Frame:width - 0.3
      987                   fh            = frame Dialog-Frame:first-child
      988                   hh            = fh:first-child
      989                   ii            = 1
      990                   .
      991               do while valid-handle(hh):
      992                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      993                   do:
      994                       case lc(hh:name) :
      995                           when "b-help" then
      996                               do:
      997                                   hh:load-image-up("cmp/b-help.bmp":u) .
      998                                   hh:load-image-down("cmp/b-help.bmp":u) .
      999                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1000                                   hh:TOOLTIP = "Помощь" .
     1001                                   v-help-old-x = hh:column .
     1002                                   v-help-old-y = hh:row    .
     1003                                   v-help-old-size = hh:width .
     1004                                   hh:width-chars = 2.5 .
     1005                               end.
     1006                           when "b-print" then
     1007                               do:
     1008                                   hh:load-image("cmp/b-print.bmp":u) .
     1009                                   hh:TOOLTIP = "Печать" .
     1010                                   v-h[ii] = hh:handle .
     1011                                   ii = ii + 1 .
     1012                                   hh:width-chars = 3 .
     1013                               end.
     1014                           when "b-history" or
     1015                           when "b-hist" then
     1016                               do:
     1017                                   hh:load-image("cmp/b-hist.bmp":u) .
     1018                                   hh:TOOLTIP = "История" .
     1019                                   v-h[ii] = hh:handle .
     1020                                   ii = ii + 1 .
     1021                                   hh:width-chars = 3 .
     1022                               end.
     1023                           when "b-sch" then
     1024                               do:
     1025                                   hh:load-image("cmp/b-sch.bmp":u) .
     1026                                   hh:TOOLTIP = "Установка Фильтра" .
     1027                                   v-h[ii] = hh:handle .
     1028                                   ii = ii + 1 .
     1029                                   hh:width-chars = 3 .
     1030                               end.
     1031                           when "b-hist-user" then
     1032                               do:
     1033                                   hh:load-image("cmp/b-hist.bmp":u) .
     1034                                   hh:TOOLTIP = "История пользователя" .
     1035                                   ii = ii + 1 .
     1036                               end.
     1037                       end case.
     1038                   end.
     1039                   hh = hh:next-sibling.
     1040               end.
     1041               b-help:column = v-frame-width - b-help:width-chars.
     1042               jj = 0.
     1043               repeat ii = 4 to 1 by -1 :
     1044                   if valid-handle (v-h[ii] ) then
     1045                   do:
     1046                       jj  = jj + 1 .
     1047                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1048                       v-h[ii]:row    = v-help-old-y .
     1049                   end.
     1050               end.
     1051           end.
     1052       end.
     1053   end procedure.
     1054   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1055   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1056   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1057   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1058   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1059   define variable v-diasize-current-frame-height as decimal   no-undo .
     1060   define variable v-diasize-change-size          as logical   no-undo .
     1061   define variable v-diasize-resize-button        as handle    no-undo .
     1062   define variable v-diasize-wndmax               as logical   no-undo .
     1063   define variable v-diasize-wndstore             as logical   no-undo .
     1064   define variable v-diasize-proc-name            as character no-undo .
     1065   define variable v-diasize-browse-handle        as handle    no-undo .
     1066   define variable v-diasize-browse-number        as integer   no-undo .
     1067   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1068   define temp-table temp-diasize-handle no-undo
     1069     field handle-value  as handle
     1070     field save-position as decimal
     1071     index xpk is primary unique handle-value
     1072     .
     1073   define temp-table temp-browse-handle no-undo
     1074     field browse-type   as character
     1075     field browse-number as integer
     1076     field browse-handle as handle
     1077     field original-size as decimal
     1078     index xpk is primary unique browse-type browse-number
     1079     index xie browse-type browse-handle
     1080   .
     1081   procedure diasize_change-height :
     1082     define input  parameter p-change-value  as decimal   no-undo .
     1083     define input  parameter p-move-resize   as logical   no-undo .
     1084     define variable v-field-group-handle    as handle    no-undo .
     1085     define variable v-object-handle         as handle    no-undo .
     1086     define variable v-frame-height          as decimal   no-undo .
     1087     define variable v-frame-virtual-height  as decimal   no-undo .
     1088     define variable v-browse-height         as decimal   no-undo .
     1089     define variable v-window-height         as decimal   no-undo .
     1090     define variable v-window-virtual-height as decimal   no-undo .
     1091     define variable v-change-sign           as integer   no-undo .
     1092     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1093     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1094     if p-change-value > 0
     1095     then do:
     1096       if frame Dialog-Frame :height + p-change-value
     1097           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1098       then do:
     1099         assign
     1100           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1101                           - (frame Dialog-Frame :height-chars)
     1102         .
     1103         if p-change-value <= 0
     1104         then do:
     1105           run diasize_position-resize-button in this-procedure .
     1106           return .
     1107         end.
     1108       end.
     1109     end.
     1110     if p-change-value < 0
     1111     then do:
     1112       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1113       then do:
     1114         assign
     1115           p-change-value = v-diasize-orig-frame-height
     1116                          - (frame Dialog-Frame :height-chars)
     1117         .
     1118         if p-change-value >= 0
     1119         then do:
     1120           run diasize_position-resize-button in this-procedure .
     1121           return .
     1122         end.
     1123       end.
     1124     end.
     1125     if p-change-value >= 0
     1126     then do:
     1127       assign
     1128         v-change-sign = 1
     1129       .
     1130     end.
     1131     else do:
     1132       assign
     1133         v-change-sign = -1
     1134       .
     1135     end.
     1136     assign
     1137       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1138     .
     1139     if p-change-value = 0
     1140     then do:
     1141       run diasize_position-resize-button in this-procedure .
     1142       return .
     1143     end.
     1144     move_block:
     1145     do
     1146     on error undo move_block, retry move_block
     1147     :
     1148       if retry
     1149       then do:
     1150         do
     1151         on error undo move_block, leave move_block
     1152         :
     1153           if p-change-value > 0
     1154           then do:
     1155             for each buf_temp-diasize-handle
     1156             on error undo, next
     1157             :
     1158               assign
     1159                 v-object-handle = buf_temp-diasize-handle.handle-value
     1160               .
     1161               if v-object-handle <> v-diasize-resize-button
     1162               then do:
     1163                 assign
     1164                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1165                 .
     1166               end.
     1167             end.
     1168             assign
     1169               v-diasize-browse-handle :height = v-browse-height
     1170             .
     1171             for each buf_temp-browse-handle
     1172               where buf_temp-browse-handle.browse-type = 'height':u
     1173             on error undo, next
     1174             :
     1175               assign
     1176                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1177               .
     1178             end.
     1179             assign
     1180               frame Dialog-Frame :height = v-frame-height
     1181             .
     1182             if frame Dialog-Frame :scrollable = true
     1183             then do:
     1184               assign
     1185                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1186               .
     1187             end.
     1188             run diasize_position-resize-button in this-procedure .
     1189           end.
     1190           else do:
     1191             if frame Dialog-Frame :scrollable = true
     1192             then do:
     1193               assign
     1194                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1195               .
     1196             end.
     1197             assign
     1198               frame Dialog-Frame :height = v-frame-height
     1199             .
     1200             assign
     1201               v-diasize-browse-handle :height = v-browse-height
     1202             .
     1203             for each buf_temp-browse-handle
     1204               where buf_temp-browse-handle.browse-type = 'height':u
     1205             on error undo, next
