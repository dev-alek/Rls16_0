     1620       .
     1621       if v-diasize-change-size = false
     1622       then do:
     1623         assign
     1624           v-diasize-change-size = true
     1625         .
     1626       end.
     1627       else do:
     1628         return .
     1629       end.
     1630       assign
     1631         v-frame-width = frame Dialog-Frame :width
     1632         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1633         v-browse-width = v-diasize-browse-handle :width
     1634       .
