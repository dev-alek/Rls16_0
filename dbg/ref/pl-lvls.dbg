        1   define variable vss-revision    as character no-undo init "$Revision: 9995f7bf39ec, 3001, rls $":U .
        2   define variable vss-author      as character no-undo init "$Author: SSlivenko $":U .
        3   define variable vss-date        as character no-undo init "$Date: Ср апр 06 16:23:44 2022 +0300 $":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile: pl-lvls.w $":U .
        5   define variable vss-archive     as character no-undo init "$Archive: ref/pl-lvls.w $":U .
        6   define variable vss-description as character no-undo init "Градуировочная таблица для резервуара".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   define new global shared variable g#library  as handle no-undo .
       66   define new global shared variable g#library2 as handle no-undo .
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      113   define variable v-waitfram-action01         as character   no-undo .
      114   define variable v-waitfram-action02         as character   no-undo .
      115   define variable v-waitfram-action03         as character   no-undo .
      116   define variable mWaitFramTextBeg            as character   no-undo.
      117   define variable mWaitFramTextEnd            as character   no-undo.
      118   define variable mWaitFramView               as logical     no-undo.
      119   define variable mWaitProcEvent              as logical     no-undo init yes.
      120   define variable mWaitFramInterval           as integer     no-undo init 1 .
      121   define variable mWaitFramStop               as logical     no-undo.
      122   define variable mWaitFramStopUser           as logical     no-undo.
      123   define variable mWaitFramStopTimeOut        as logical     no-undo.
      124   define variable mWaitFramStartProc          as datetime-tz no-undo.
      125   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      126   define button B-WaitFramStop auto-end-key
      127        label "Стоп"
      128        size 10 by 1 tooltip "Остоновить процесс".
      129   define button B-viewProcInfo
      130        label "Информация"
      131        size 15 by 1 tooltip "Информация о процесс".
      132   define frame waitfram
      133     v-waitfram-action01 format "x(72)" no-label skip
      134     v-waitfram-action02 format "x(72)" no-label skip
      135     v-waitfram-action03 format "x(72)" no-label skip
      136     B-viewProcInfo
      137     B-WaitFramStop at row 4 col 30
      138     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      139     .
      140   define new global shared variable mBatchMode as logical no-undo init ?.
      141   define variable mFramBachModHandle as handle no-undo.
      142   mFramBachModHandle = frame waitfram:handle.
      143   define variable mFameOldVis as logical no-undo.
      144   define variable mVisCUrentVin as logical no-undo.
      145   if session:batch-mode
      146   then
      147      mBatchMode = yes.
      148   if mBatchMode = ? then do:
      149     mVisCUrentVin = current-window:visible.
      150     mFameOldVis = mFramBachModHandle:visible.
      151     mFramBachModHandle:visible  = yes.
      152     mBatchMode = mFramBachModHandle:visible ne yes.
      153     mFramBachModHandle:visible = mFameOldVis.
      154     current-window:visible = mVisCUrentVin.
      155   end.
      156    if  log-manager:logfile-name ne ?
      157     then DO:
      158         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      159         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      160         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      161     end.
      162   on choose of B-WaitFramStop in frame waitfram
      163   do:
      164     mWaitFramStop = yes.
      165     mWaitFramStopUser = yes.
      166   end.
      167   function waitfram-check-timeout returns logical():
      168      define variable vtime as int64 no-undo.
      169      if mWaitFramStopTimeOut
      170      then
      171         return yes.
      172      vtime = ( now - mWaitFramStartProc ) / 1000 .
      173      if     mWaitFramTimeOut ne ?
      174         and mWaitFramTimeOut ne 0
      175         and mWaitFramTimeOut lt vtime
      176      then do:
      177         mWaitFramStopTimeOut = yes.
      178      end.
      179      return mWaitFramStopTimeOut.
      180   end.
      181   procedure waitfram-hide :
      182     if not session:batch-mode
      183     then do
      184     on error undo, return error return-value
      185     :
      186       pause 0 before-hide .
      187       if not mBatchMode then
      188         hide frame waitfram .
      189     if     not mWaitFramView
      190        and mWaitProcEvent
      191     then
      192       process events .
      193     end.
      194   end procedure.
      195   procedure waitfram-show :
      196     define input  parameter p-message as character no-undo .
      197     define variable v-left-margin as integer   no-undo .
      198     if not session:batch-mode
      199     then do
      200     on error undo, return error return-value
      201     :
      202       if length(p-message) <= 70 then do:
      203         assign
      204           v-left-margin = integer((70 - length(p-message)) / 2)
      205         .
      206         assign
      207           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      208         .
      209         assign
      210           v-waitfram-action01 = " "
      211           v-waitfram-action02 = " "
      212                                    + fill(" ", v-left-margin)
      213                                    + p-message
      214           v-waitfram-action03 = " "
      215         .
      216       end.
      217       else do:
      218         define variable vRindex1 as integer no-undo.
      219         define variable vRindex2 as integer no-undo.
      220         vRindex1 = r-index(p-message," ",70).
      221         if vRindex1 = 0
      222         then
      223            vRindex1 = 70.
      224         if length(p-message)  <= vRindex1 + 70 then do:
      225           assign
      226             v-waitfram-action01 = " "
      227             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      228             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      229           .
      230         end.
      231         else do:
      232           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      233           if vRindex2 <= vRindex1
      234           then
      235              vRindex2 = vRindex1 + 70.
      236           assign
      237             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      238             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      239             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      240           .
      241         end.
      242       end.
      243       B-viewProcInfo:visible   in frame waitfram = no.
      244       B-viewProcInfo:sensitive in frame waitfram = no.
      245       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      246       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      247       if  (   mWaitFramView
      248          or  mWaitProcEvent)
      249          and not mBatchMode
      250       then
      251          display
      252             v-waitfram-action01 skip
      253             v-waitfram-action02 skip
      254             v-waitfram-action03 skip
      255          with frame waitfram .
      256       if     mWaitFramView
      257          then do:
      258             if     mWaitFramInterval ne ?
      259                and not mBatchMode
      260             then
      261                wait-for go of frame waitfram pause mWaitFramInterval.
      262          end.
      263          else
      264             if     mWaitProcEvent
      265                and not mBatchMode
      266             then
      267                process events .
      268     end.
      269   end procedure.
      270      procedure waitfram-show-this:
      271         define input  parameter iInterval as int64 no-undo.
      272         define variable vtime as int64 no-undo.
      273         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      274         mWaitFramInterval = iInterval.
      275         run waitfram-show (substitute("&1&2 &3&4" ,
      276                                       mWaitFramTextBeg ,
      277                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      278                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      279                                       mWaitFramTextEnd
      280                                      )
      281                           ).
      282      end.
      283      procedure WaitFramRunPause:
      284         define input  parameter iInterval as dec no-undo.
      285         define variable vStart  as datetime-tz no-undo.
      286         define variable vend    as datetime-tz no-undo.
      287         define variable vint as int64 no-undo.
      288         define variable vOk as logical no-undo.
      289         vStart = now.
      290         vend   = vStart.
      291         publish "WaitFramPause" (iInterval,output vOk).
      292         vend   =  now.
      293         vint = vend - vStart.
      294         vint = iInterval - vint / 1000.
      295         if     not mWaitFramStop
      296            and (   vint > 0
      297                 or (    not vOk
      298                     and iInterval eq ?
      299                     )
      300                 )
      301         then
      302            run waitfram-show-this (iInterval).
      303         vend   =  now.
      304         vint = vend - vStart.
      305         vint = iInterval - vint / 1000.
      306         if     not mWaitFramStop
      307            and vint > 0
      308         then do:
      309            run gbl/pause.p (vint * 1000).
      310         end.
      311         if iInterval ne ?
      312         then
      313            publish "WaitFramStop".
      314         waitfram-check-timeout().
      315      end.
      316      procedure WaitFramWaitFor:
      317         define input  parameter iInterval as dec no-undo.
      318         assign
      319            mWaitFramStartProc   = now
      320            mWaitFramStopUser    = no
      321            mWaitFramStopTimeOut = no
      322         .
      323         block-wait:
      324         do while not mWaitFramStop:
      325            run WaitFramRunPause (iInterval).
      326            if  waitfram-check-timeout()
      327            then do:
      328               leave block-wait.
      329            end.
      330         end.
      331         run waitfram-hide.
      332      end.
      333   procedure waitfram-join :
      334     define input  parameter p-line-1  as character no-undo .
      335     define input  parameter p-line-2  as character no-undo .
      336     define input  parameter p-line-3  as character no-undo .
      337     define output parameter p-message as character no-undo .
      338     do
      339     on error undo, return error return-value
      340     :
      341       assign
      342         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      343                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      344                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      345       .
      346     end.
      347   end procedure.
      348   function waitfram-join-function returns character
      349     (input p-line-1 as character
      350     ,input p-line-2 as character
      351     ,input p-line-3 as character
      352     ).
      353     define variable v-message as character no-undo .
      354     run waitfram-join in this-procedure
      355       (input  p-line-1
      356       ,input  p-line-2
      357       ,input  p-line-3
      358       ,output v-message
      359       ) .
      360     return v-message .
      361   end function .
      362   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      363     define variable v-cntxt-db-num        as integer   no-undo .
      364     define variable v-cntxt-userid        as character no-undo .
      365     define variable v-cntxt-level         as character no-undo .
      366     define variable v-cntxt-host-code-obj as integer   no-undo .
      367     define variable v-cntxt-obj-type      as character no-undo .
      368     define variable v-cntxt-obj-code      as integer   no-undo .
      369     define variable v-cntxt-db-num-obj    as integer   no-undo .
      370     define variable v-cntxt-is-admin      as logical   no-undo .
      371   define input parameter parparentproc   as widget-handle  no-undo .
      372   define input parameter p-obj-type      as character      no-undo .
      373   define input parameter p-obj-code      as integer        no-undo .
      374   define input parameter p-pl-code       as integer        no-undo .
      375   define variable v_ok as LOGICAL no-undo .
      376   define variable v-new as LOGICAL no-undo init no .
      377   define buffer buf_pl-level for ub.pl-level .
      378   define buffer buf_pl-level-mm for ub.pl-level-mm .
      379   define buffer buf_pl-level-attr for ub.pl-level-attr .
      380   define buffer buf2_pl-level-attr for ub.pl-level-attr .
      381   define buffer buf_place    for ub.place .
      382   define buffer buf_place-attr    for ub.place-attr .
      383   define VARIABLE v-ok-level as logical no-undo INIT no .
      384   define variable v-chk-act-host-code as integer   no-undo .
      385   define variable v-place-type as integer no-undo .
      386   define variable glog                as logical   no-undo .
      387   define stream   vTxt.
      388   DEFINE BUTTON b-add
      389        LABEL "&Добавить"
      390        SIZE 10 BY 1.
      391   DEFINE BUTTON b-chg
      392        LABEL "&Изменить"
      393        SIZE 10 BY 1.
      394   DEFINE BUTTON b-del
      395        LABEL "&Удалить"
      396        SIZE 10 BY 1.
      397   DEFINE BUTTON b-delete
      398        LABEL "Очистить"
      399        SIZE 9 BY 1.
      400   DEFINE BUTTON b-exit AUTO-GO
      401        LABEL "&Выход"
      402        SIZE 10 BY 1
      403        BGCOLOR 8 .
      404   DEFINE BUTTON b-help
      405        LABEL "Помо&щь"
      406        SIZE 10 BY 1
      407        BGCOLOR 8 .
      408   DEFINE BUTTON b-load
      409        LABEL "&Загрузить"
      410        SIZE 10 BY 1.
      411   DEFINE BUTTON b-zone
      412        LABEL "&Таблица поясов"
      413        SIZE 15 BY 1.
      414   DEFINE QUERY BROWSE-2 FOR
      415         buf_pl-level, buf_pl-level-mm, buf_pl-level-attr, buf2_pl-level-attr SCROLLING.
      416   DEFINE BROWSE BROWSE-2
      417     QUERY BROWSE-2 NO-LOCK DISPLAY
      418         buf_pl-level.pl-level COLUMN-LABEL "Уровень, см"
      419         buf_pl-level.pl-qnty WIDTH 15.5
      420         IF AVAIL buf_pl-level-mm THEN string(buf_pl-level-mm.zone,">>>>>>>9") ELSE "" COLUMN-LABEL "        Пояс" WIDTH 12
      421         decimal(buf_pl-level-attr.attr-value) WIDTH 14 format "9.999" COLUMN-LABEL "Погрешность!составления,%"
      422         if avail buf2_pl-level-attr then string(decimal(buf2_pl-level-attr.attr-value), ">>>>>>>>>>>9.9999") else "" format "X(17)" WIDTH 18 COLUMN-LABEL "Коэффициент!вместимости,м3/мм"
      423       WITH NO-ROW-MARKERS SEPARATORS SIZE 85 BY 17.5 FIT-LAST-COLUMN.
      424   DEFINE FRAME Dialog-Frame
      425        b-exit AT ROW 1 COL 1
      426        b-add AT ROW 1 COL 11 WIDGET-ID 2
      427        b-chg AT ROW 1 COL 21 WIDGET-ID 4
      428        b-del AT ROW 1 COL 31 WIDGET-ID 6
      429        b-load AT ROW 1 COL 41 WIDGET-ID 8
      430        b-delete AT ROW 1 COL 51 WIDGET-ID 10
      431        b-zone AT ROW 1 COL 60 WIDGET-ID 12
      432        b-help AT ROW 1 COL 70
      433        BROWSE-2 AT ROW 2.25 COL 1 WIDGET-ID 200
      434       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      435            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      436            TITLE "Градуировочная таблица"
      437            DEFAULT-BUTTON b-exit WIDGET-ID 100.
      438   ASSIGN
      439          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      440          FRAME Dialog-Frame:HIDDEN           = TRUE.
      441   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      442   DO:
      443     define variable v-gap as character no-undo.
      444     define variable v-ok  as logical   no-undo.
      445     if v-new
      446     then do :
      447       find first buf_pl-level no-lock where buf_pl-level.obj-type = p-obj-type
      448                                         and buf_pl-level.obj-code = p-obj-code
      449                                         and buf_pl-level.pl-code  = p-pl-code
      450                                         no-error .
      451       if available buf_pl-level
      452       then do :
      453         message "Внимание! После подтверждения завершения работы по вводу данных дальнейшая корректировка градуировочной таблицы резервуара будет возможна только в ИС УРТ. Подтвердите завершение работы!"
      454         view-as alert-box question buttons yes-no update v-ok .
      455         if not v-ok
      456         then do :
      457           return no-apply .
      458         end .
      459       end .
      460     end .
      461     run check-pl-level in this-procedure ( OUTPUT v-gap ).
      462     IF v-gap <> ""
      463         THEN
      464     DO:
      465         message
      466             "В тарировочной таблице имеются пропуски. Пропущены следующие уровни:"
      467             skip v-gap
      468             SKIP
      469             "Выйти и оставить пропуски?"
      470             view-as alert-box information
      471             BUTTONS YES-NO
      472             update v-ok
      473             .
      474         IF NOT v-ok THEN
      475         DO:
      476             RETURN NO-APPLY.
      477         END.
      478     END.
      479     if AVAILABLE (buf_pl-level) and v-ok-level then
      480     do:
      481   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
      482     (input ?
      483     ,input this-procedure:handle
      484     ,input ?
      485     ,input 'ref-event':U
      486     ,input  buffer buf_pl-level:handle
      487     ,input  buffer buf_pl-level:handle
      488     ,input ''
      489     ,input ''
      490     ) no-error .
      491         if error-status :error
      492             then
      493         do:
      494             message
      495                 error-status:get-message(1) skip
      496                 return-value
      497                 view-as alert-box error .
      498             return no-apply .
      499         end.
      500     end.
      501     if v-ok-level then
      502     do:
      503         run trg/userlog.p (
      504             input 'create':U
      505             , input 'pl-level':U
      506             , input ( buffer buf_pl-level :handle )
      507             , input ?
      508             , input ""
      509             ) no-error.
      510         if error-status :error
      511             then
      512         do:
      513             undo, return substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
      514                 , chr(10)
      515                 , vss-workfile
      516                 , return-value
      517                 , error-status :get-message ( 1 ) ).
      518         end.
      519     end.
      520     APPLY "END-ERROR":U TO SELF.
      521   END.
      522   on "ESC" ANYWHERE do:
      523     define variable v-gap as character no-undo.
      524     define variable v-ok  as logical   no-undo.
      525     if v-new
      526     then do :
      527       find first buf_pl-level no-lock where buf_pl-level.obj-type = p-obj-type
      528                                         and buf_pl-level.obj-code = p-obj-code
      529                                         and buf_pl-level.pl-code  = p-pl-code
      530                                         no-error .
      531       if available buf_pl-level
      532       then do :
