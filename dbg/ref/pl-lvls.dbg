     1023       END.
     1024   ON CHOOSE OF b-zone IN FRAME Dialog-Frame
     1025   DO:
     1026       run ref/pl-level-mm-brw.w (
     1027           parparentproc,
     1028           p-obj-type,
     1029           p-obj-code,
     1030           p-pl-code,
     1031           'ИЗМЕНЕНИЕ':U
     1032       ).
     1033       OPEN QUERY BROWSE-2 FOR EACH buf_pl-level       WHERE buf_pl-level.obj-type = p-obj-type  AND buf_pl-level.obj-code = p-obj-code  AND buf_pl-level.pl-code = p-pl-code NO-LOCK,  FIRST buf_pl-level-mm OUTER-JOIN where buf_pl-level-mm.obj-type = p-obj-type  and buf_pl-level-mm.obj-code = p-obj-code  and buf_pl-level-mm.pl-code = p-pl-code  and buf_pl-level-mm.min-level <= buf_pl-level.pl-level  and buf_pl-level-mm.max-level >= buf_pl-level.pl-level NO-LOCK,  first buf_pl-level-attr where buf_pl-level-attr.obj-type = p-obj-type  and buf_pl-level-attr.obj-code = p-obj-code  and buf_pl-level-attr.pl-code = p-pl-code  and buf_pl-level-attr.pl-level = buf_pl-level.pl-level  and buf_pl-level-attr.attr-code = "tarir-delta" no-lock,  first buf2_pl-level-attr OUTER-JOIN where buf2_pl-level-attr.obj-type = p-obj-type  and buf2_pl-level-attr.obj-code = p-obj-code  and buf2_pl-level-attr.pl-code = p-pl-code  and buf2_pl-level-attr.pl-level = buf_pl-level.pl-level  and buf2_pl-level-attr.attr-code = "deltaV" no-lock INDEXED-REPOSITION.
     1034   END.
     1035   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1036       THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1037   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1038   on help of frame Dialog-Frame
     1039   do:
     1040     run gbl/app_help.p
     1041       (input this-procedure :file-name
     1042       ,input ''
     1043       ,input ?
     1044       ) no-error.
     1045     if error-status :error then do:
     1046       message
     1047         "Ошибка при вызове помощи"
     1048         error-status :get-message(1)
     1049         view-as alert-box .
     1050     end.
     1051   end.
     1052   run minbtn-set in this-procedure .
     1053   on choose of b-help in frame Dialog-Frame
     1054   do:
     1055     apply "help":u to frame Dialog-Frame .
     1056   end.
     1057   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1058   procedure minbtn-set :
     1059       do
     1060           on error undo, return error return-value
     1061           :
     1062           define variable ii              as integer       no-undo .
     1063           define variable fh              as widget-handle no-undo .
     1064           define variable hh              as widget-handle no-undo .
     1065           define variable v-h             as handle        extent 4 no-undo .
     1066           define variable v-name-button   as character     no-undo .
     1067           define variable v-help-old-x    as decimal       no-undo .
     1068           define variable v-help-old-y    as decimal       no-undo .
     1069           define variable v-help-old-size as decimal       no-undo .
     1070           define variable v-frame-width   as decimal       no-undo .
     1071           define variable jj              as integer       no-undo .
     1072           do
     1073               on error undo, return error
     1074               :
     1075               assign
     1076                   v-frame-width = frame Dialog-Frame:width - 0.3
     1077                   fh            = frame Dialog-Frame:first-child
     1078                   hh            = fh:first-child
     1079                   ii            = 1
     1080                   .
     1081               do while valid-handle(hh):
     1082                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1083                   do:
     1084                       case lc(hh:name) :
     1085                           when "b-help" then
     1086                               do:
     1087                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1088                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1089                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1090                                   hh:TOOLTIP = "Помощь" .
     1091                                   v-help-old-x = hh:column .
     1092                                   v-help-old-y = hh:row    .
     1093                                   v-help-old-size = hh:width .
     1094                                   hh:width-chars = 2.5 .
     1095                               end.
     1096                           when "b-print" then
     1097                               do:
     1098                                   hh:load-image("cmp/b-print.bmp":u) .
     1099                                   hh:TOOLTIP = "Печать" .
     1100                                   v-h[ii] = hh:handle .
     1101                                   ii = ii + 1 .
     1102                                   hh:width-chars = 3 .
     1103                               end.
     1104                           when "b-history" or
     1105                           when "b-hist" then
     1106                               do:
     1107                                   hh:load-image("cmp/b-hist.bmp":u) .
     1108                                   hh:TOOLTIP = "История" .
     1109                                   v-h[ii] = hh:handle .
     1110                                   ii = ii + 1 .
     1111                                   hh:width-chars = 3 .
     1112                               end.
     1113                           when "b-sch" then
     1114                               do:
     1115                                   hh:load-image("cmp/b-sch.bmp":u) .
     1116                                   hh:TOOLTIP = "Установка Фильтра" .
     1117                                   v-h[ii] = hh:handle .
     1118                                   ii = ii + 1 .
     1119                                   hh:width-chars = 3 .
     1120                               end.
     1121                           when "b-hist-user" then
     1122                               do:
     1123                                   hh:load-image("cmp/b-hist.bmp":u) .
     1124                                   hh:TOOLTIP = "История пользователя" .
     1125                                   ii = ii + 1 .
     1126                               end.
     1127                       end case.
     1128                   end.
     1129                   hh = hh:next-sibling.
     1130               end.
     1131               b-help:column = v-frame-width - b-help:width-chars.
     1132               jj = 0.
     1133               repeat ii = 4 to 1 by -1 :
     1134                   if valid-handle (v-h[ii] ) then
     1135                   do:
     1136                       jj  = jj + 1 .
     1137                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1138                       v-h[ii]:row    = v-help-old-y .
     1139                   end.
     1140               end.
     1141           end.
     1142       end.
     1143   end procedure.
     1144   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1145   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1146   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1147   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1148   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1149   define variable v-diasize-current-frame-height as decimal   no-undo .
     1150   define variable v-diasize-change-size          as logical   no-undo .
     1151   define variable v-diasize-resize-button        as handle    no-undo .
     1152   define variable v-diasize-wndmax               as logical   no-undo .
     1153   define variable v-diasize-wndstore             as logical   no-undo .
     1154   define variable v-diasize-proc-name            as character no-undo .
     1155   define variable v-diasize-browse-handle        as handle    no-undo .
     1156   define variable v-diasize-browse-number        as integer   no-undo .
     1157   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1158   define temp-table temp-diasize-handle no-undo
     1159     field handle-value  as handle
     1160     field save-position as decimal
     1161     index xpk is primary unique handle-value
     1162     .
     1163   define temp-table temp-browse-handle no-undo
     1164     field browse-type   as character
     1165     field browse-number as integer
     1166     field browse-handle as handle
     1167     field original-size as decimal
     1168     index xpk is primary unique browse-type browse-number
     1169     index xie browse-type browse-handle
     1170   .
     1171   procedure diasize_change-height :
     1172     define input  parameter p-change-value  as decimal   no-undo .
     1173     define input  parameter p-move-resize   as logical   no-undo .
     1174     define variable v-field-group-handle    as handle    no-undo .
     1175     define variable v-object-handle         as handle    no-undo .
     1176     define variable v-frame-height          as decimal   no-undo .
     1177     define variable v-frame-virtual-height  as decimal   no-undo .
     1178     define variable v-browse-height         as decimal   no-undo .
     1179     define variable v-window-height         as decimal   no-undo .
     1180     define variable v-window-virtual-height as decimal   no-undo .
     1181     define variable v-change-sign           as integer   no-undo .
     1182     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1183     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1184     if p-change-value > 0
     1185     then do:
     1186       if frame Dialog-Frame :height + p-change-value
     1187           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1188       then do:
     1189         assign
     1190           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1191                           - (frame Dialog-Frame :height-chars)
     1192         .
     1193         if p-change-value <= 0
     1194         then do:
     1195           run diasize_position-resize-button in this-procedure .
     1196           return .
     1197         end.
     1198       end.
     1199     end.
     1200     if p-change-value < 0
     1201     then do:
     1202       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1203       then do:
     1204         assign
     1205           p-change-value = v-diasize-orig-frame-height
     1206                          - (frame Dialog-Frame :height-chars)
     1207         .
     1208         if p-change-value >= 0
     1209         then do:
     1210           run diasize_position-resize-button in this-procedure .
     1211           return .
     1212         end.
     1213       end.
     1214     end.
     1215     if p-change-value >= 0
     1216     then do:
     1217       assign
     1218         v-change-sign = 1
     1219       .
     1220     end.
     1221     else do:
     1222       assign
     1223         v-change-sign = -1
     1224       .
     1225     end.
     1226     assign
     1227       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1228     .
     1229     if p-change-value = 0
     1230     then do:
     1231       run diasize_position-resize-button in this-procedure .
     1232       return .
     1233     end.
     1234     move_block:
     1235     do
     1236     on error undo move_block, retry move_block
     1237     :
     1238       if retry
     1239       then do:
     1240         do
     1241         on error undo move_block, leave move_block
     1242         :
     1243           if p-change-value > 0
     1244           then do:
     1245             for each buf_temp-diasize-handle
     1246             on error undo, next
     1247             :
     1248               assign
     1249                 v-object-handle = buf_temp-diasize-handle.handle-value
     1250               .
     1251               if v-object-handle <> v-diasize-resize-button
     1252               then do:
     1253                 assign
     1254                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1255                 .
     1256               end.
     1257             end.
     1258             assign
     1259               v-diasize-browse-handle :height = v-browse-height
     1260             .
     1261             for each buf_temp-browse-handle
     1262               where buf_temp-browse-handle.browse-type = 'height':u
     1263             on error undo, next
     1264             :
     1265               assign
     1266                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1267               .
     1268             end.
     1269             assign
     1270               frame Dialog-Frame :height = v-frame-height
     1271             .
     1272             if frame Dialog-Frame :scrollable = true
     1273             then do:
     1274               assign
     1275                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1276               .
     1277             end.
     1278             run diasize_position-resize-button in this-procedure .
     1279           end.
     1280           else do:
     1281             if frame Dialog-Frame :scrollable = true
     1282             then do:
     1283               assign
     1284                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1285               .
     1286             end.
     1287             assign
     1288               frame Dialog-Frame :height = v-frame-height
     1289             .
     1290             assign
     1291               v-diasize-browse-handle :height = v-browse-height
     1292             .
     1293             for each buf_temp-browse-handle
     1294               where buf_temp-browse-handle.browse-type = 'height':u
     1295             on error undo, next
     1296             :
     1297               assign
     1298                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1299               .
     1300             end.
     1301             for each buf_temp-diasize-handle
     1302             on error undo, next
     1303             :
     1304               assign
     1305                 v-object-handle = buf_temp-diasize-handle.handle-value
     1306               .
     1307               if v-object-handle <> v-diasize-resize-button
     1308               then do:
     1309                 assign
     1310                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1311                 .
     1312               end.
     1313             end.
     1314             run diasize_position-resize-button in this-procedure .
     1315           end.
     1316           assign
     1317             v-diasize-change-size = false
     1318           .
     1319           leave move_block .
     1320         end.
     1321       end.
     1322       assign
     1323         v-diasize-need-full-display = true
     1324       .
     1325       if v-diasize-change-size = false
     1326       then do:
     1327         assign
     1328           v-diasize-change-size = true
     1329         .
     1330       end.
     1331       else do:
     1332         return .
     1333       end.
     1334       assign
     1335         v-frame-height = frame Dialog-Frame :height
     1336         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1337         v-browse-height = v-diasize-browse-handle :height
     1338       .
     1339       for each buf_temp-browse-handle
     1340         where buf_temp-browse-handle.browse-type = 'height':u
     1341       :
     1342         assign
     1343           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1344         .
     1345       end.
     1346       for each buf_temp-diasize-handle
     1347       :
     1348         delete buf_temp-diasize-handle .
     1349       end.
     1350       assign
     1351         v-field-group-handle = frame Dialog-Frame :first-child
     1352       .
     1353       do while valid-handle(v-field-group-handle)
     1354       :
     1355         assign
     1356           v-object-handle = v-field-group-handle :first-child
     1357         .
     1358         do while valid-handle(v-object-handle)
     1359         :
     1360           if  v-object-handle <> v-diasize-browse-handle :handle
     1361           and can-query(v-object-handle, "row")
     1362           and can-query(v-object-handle, "height")
     1363           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1364           then do:
     1365             find first buf_temp-browse-handle
     1366               where buf_temp-browse-handle.browse-type   = 'height':u
     1367                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1368               no-error .
     1369             if available buf_temp-browse-handle
     1370             then do:
     1371             end.
     1372             else do:
     1373               create buf_temp-diasize-handle .
     1374               assign
     1375                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1376                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1377               .
     1378             end.
     1379           end.
     1380           assign
     1381             v-object-handle = v-object-handle :next-sibling
     1382           .
     1383         end.
     1384         assign
     1385           v-field-group-handle = v-field-group-handle :next-sibling
     1386         .
     1387       end.
     1388       do with frame Dialog-Frame
     1389       :
     1390         hide v-diasize-resize-button .
     1391         assign
     1392           v-diasize-resize-button :row    = 1
     1393           v-diasize-resize-button :column = 1
     1394         .
     1395       end.
     1396       if p-change-value > 0
     1397       then do:
     1398         if frame Dialog-Frame :scrollable = true
     1399         then do:
     1400           assign
     1401             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1402             no-error .
     1403           if error-status :error
     1404           or error-status :get-message(1) <> ""
     1405           then do:
     1406             undo move_block, retry move_block .
     1407           end.
     1408         end.
     1409         assign
     1410           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1411           no-error .
     1412         if error-status :error
     1413         or error-status :get-message(1) <> ""
     1414         then do:
     1415           undo move_block, retry move_block .
     1416         end.
     1417         assign
     1418           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1419           no-error .
     1420         if error-status :error
     1421         or error-status :get-message(1) <> ""
     1422         then do:
     1423           undo move_block, retry move_block .
     1424         end.
     1425         for each buf_temp-browse-handle
     1426           where buf_temp-browse-handle.browse-type = 'height':u
     1427         on error undo move_block, retry move_block
     1428         :
     1429           assign
     1430             buf_temp-browse-handle.browse-handle :height
     1431               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1432             no-error .
     1433           if error-status :error
     1434           or error-status :get-message(1) <> ""
     1435           then do:
     1436             undo move_block, retry move_block .
     1437           end.
     1438         end.
     1439         for each buf_temp-diasize-handle
     1440         on error undo move_block, retry move_block
     1441         :
     1442           assign
     1443             v-object-handle = buf_temp-diasize-handle.handle-value
     1444           .
     1445           if v-object-handle <> v-diasize-resize-button
     1446           then do:
     1447             assign
     1448               v-object-handle :row = v-object-handle :row + p-change-value
     1449               no-error .
     1450             if error-status :error
     1451             or error-status :get-message(1) <> ""
     1452             then do:
     1453               undo move_block, retry move_block .
     1454             end.
     1455           end.
     1456         end.
     1457       end.
     1458       else do:
     1459         for each buf_temp-diasize-handle
     1460         on error undo move_block, retry move_block
     1461         :
     1462           assign
     1463             v-object-handle = buf_temp-diasize-handle.handle-value
     1464           .
     1465           if v-object-handle <> v-diasize-resize-button
     1466           then do:
     1467             assign
     1468               v-object-handle :row = v-object-handle :row + p-change-value
     1469               no-error .
     1470             if error-status :error
     1471             or error-status :get-message(1) <> ""
     1472             then do:
     1473               undo move_block, retry move_block .
     1474             end.
     1475           end.
     1476         end.
     1477         assign
     1478           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1479           no-error .
     1480         if error-status :error
     1481         or error-status :get-message(1) <> ""
     1482         then do:
     1483           undo move_block, retry move_block .
     1484         end.
     1485         for each buf_temp-browse-handle
     1486           where buf_temp-browse-handle.browse-type = 'height':u
     1487         on error undo move_block, retry move_block
     1488         :
     1489           assign
     1490             buf_temp-browse-handle.browse-handle :height
     1491               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1492             no-error .
     1493           if error-status :error
     1494           or error-status :get-message(1) <> ""
     1495           then do:
     1496             undo move_block, retry move_block .
     1497           end.
     1498         end.
     1499         assign
     1500           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1501           no-error .
     1502         if error-status :error
     1503         or error-status :get-message(1) <> ""
     1504         then do:
     1505           undo move_block, retry move_block .
     1506         end.
     1507         if frame Dialog-Frame :scrollable = true
     1508         then do:
     1509           assign
     1510             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1511             no-error .
     1512           if error-status :error
     1513           or error-status :get-message(1) <> ""
     1514           then do:
     1515             undo move_block, retry move_block .
     1516           end.
     1517         end.
     1518       end.
     1519       if p-move-resize = true
     1520       then do:
     1521         run diasize_position-resize-button in this-procedure .
     1522       end.
     1523       if v-diasize-wndstore = true
     1524       then do:
     1525         if connected("ub") = true
     1526         then do:
     1527           define variable v-cntxt-db-num        as integer   no-undo .
     1528           define variable v-cntxt-userid        as character no-undo .
     1529           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1530                                             , OUTPUT v-cntxt-userid
     1531                                             ) .
     1532           run gbl/wndsizew.p
     1533             (input  v-cntxt-db-num
     1534             ,input  v-cntxt-userid
     1535             ,input  v-diasize-proc-name
     1536             ,input  'height':u
     1537             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1538             ) .
     1539         end.
     1540       end.
     1541     end.
     1542     assign
     1543       v-diasize-change-size = false
     1544     .
     1545   end procedure.
     1546   procedure diasize_set-height :
     1547     define input  parameter p-new-height  as decimal   no-undo .
     1548     define input  parameter p-move-resize as logical   no-undo .
     1549     do
     1550     on error undo, return error return-value
     1551     :
     1552       run diasize_change-height in this-procedure
     1553         (input  (p-new-height - frame Dialog-Frame :height)
     1554         ,input  p-move-resize
     1555         ) .
     1556     end.
     1557   end procedure.
     1558   procedure diasize_change-width :
     1559     define input  parameter p-change-value as decimal   no-undo .
     1560     define input  parameter p-move-resize  as logical   no-undo .
     1561     define variable v-field-group-handle   as handle    no-undo .
     1562     define variable v-object-handle        as handle    no-undo .
     1563     define variable v-frame-width          as decimal   no-undo .
     1564     define variable v-frame-virtual-width  as decimal   no-undo .
     1565     define variable v-browse-width         as decimal   no-undo .
     1566     define variable v-window-width         as decimal   no-undo .
     1567     define variable v-window-virtual-width as decimal   no-undo .
     1568     define variable v-change-sign          as integer   no-undo .
     1569     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1570     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1571     if p-change-value > 0
     1572     then do:
     1573       if frame Dialog-Frame :width + p-change-value >
     1574           session :width-chars
     1575       then do:
     1576         assign
     1577           p-change-value = session :width-chars - frame Dialog-Frame :width
     1578         .
     1579         if p-change-value <= 0
     1580         then do:
     1581           run diasize_position-resize-button in this-procedure .
     1582           return .
     1583         end.
     1584       end.
     1585     end.
     1586     if p-change-value < 0
     1587     then do:
     1588       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1589       then do:
     1590         assign
     1591           p-change-value = v-diasize-orig-frame-width
     1592                          - frame Dialog-Frame :width
     1593         .
     1594         if p-change-value >= 0
     1595         then do:
     1596           run diasize_position-resize-button in this-procedure .
     1597           return .
     1598         end.
     1599       end.
     1600     end.
     1601     if p-change-value >= 0
     1602     then do:
     1603       assign
     1604         v-change-sign = 1
     1605       .
     1606     end.
     1607     else do:
     1608       assign
     1609         v-change-sign = -1
     1610       .
     1611     end.
     1612     assign
     1613       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1614     .
     1615     if p-change-value = 0
     1616     then do:
     1617       run diasize_position-resize-button in this-procedure .
     1618       return .
     1619     end.
     1620     move_block:
     1621     do
     1622     on error undo move_block, leave move_block
     1623     :
     1624       if retry
     1625       then do:
     1626         do
     1627         on error undo move_block, leave move_block
     1628         :
     1629           if p-change-value > 0
     1630           then do:
     1631             for each buf_temp-diasize-handle
     1632             on error undo, next
     1633             :
     1634               assign
     1635                 v-object-handle = buf_temp-diasize-handle.handle-value
     1636               .
     1637               if v-object-handle <> v-diasize-resize-button
     1638               then do:
     1639                 assign
     1640                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1641                 .
     1642               end.
     1643             end.
     1644             assign
     1645               v-diasize-browse-handle :width = v-browse-width
     1646             .
     1647             for each buf_temp-browse-handle
     1648               where buf_temp-browse-handle.browse-type = 'width':u
     1649             on error undo, next
     1650             :
     1651               assign
     1652                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1653               .
     1654             end.
     1655             assign
     1656               frame Dialog-Frame :width = v-frame-width
     1657             .
     1658             if frame Dialog-Frame :scrollable = true
     1659             then do:
     1660               assign
     1661                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1662               .
     1663             end.
     1664             run diasize_position-resize-button in this-procedure .
     1665           end.
     1666           else do:
     1667             if frame Dialog-Frame :scrollable = true
     1668             then do:
     1669               assign
     1670                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1671               .
     1672             end.
     1673             assign
     1674               frame Dialog-Frame :width = v-frame-width
     1675             .
     1676             for each buf_temp-browse-handle
     1677               where buf_temp-browse-handle.browse-type = 'width':u
     1678             on error undo, next
     1679             :
     1680               assign
     1681                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1682               .
     1683             end.
     1684             assign
     1685               v-diasize-browse-handle :width = v-browse-width
     1686             .
     1687             for each buf_temp-diasize-handle
     1688             on error undo, next
     1689             :
     1690               assign
     1691                 v-object-handle = buf_temp-diasize-handle.handle-value
     1692               .
     1693               if v-object-handle <> v-diasize-resize-button
     1694               then do:
     1695                 assign
     1696                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1697                 .
     1698               end.
     1699             end.
     1700             run diasize_position-resize-button in this-procedure .
     1701           end.
     1702           assign
     1703             v-diasize-change-size = false
     1704           .
     1705           leave move_block .
     1706         end.
     1707       end.
     1708       assign
     1709         v-diasize-need-full-display = true
     1710       .
     1711       if v-diasize-change-size = false
     1712       then do:
     1713         assign
     1714           v-diasize-change-size = true
     1715         .
     1716       end.
     1717       else do:
     1718         return .
     1719       end.
     1720       assign
     1721         v-frame-width = frame Dialog-Frame :width
     1722         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1723         v-browse-width = v-diasize-browse-handle :width
     1724       .
     1725       for each buf_temp-browse-handle
     1726         where buf_temp-browse-handle.browse-type = 'width':u
     1727       :
     1728         assign
     1729           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1730         .
     1731       end.
     1732       for each buf_temp-diasize-handle
     1733       :
     1734         delete buf_temp-diasize-handle .
     1735       end.
     1736       assign
     1737         v-field-group-handle = frame Dialog-Frame :first-child
     1738       .
     1739       do while valid-handle(v-field-group-handle)
     1740       :
     1741         assign
     1742           v-object-handle = v-field-group-handle :first-child
     1743         .
     1744         do while valid-handle(v-object-handle)
     1745         :
     1746           if  v-object-handle <> v-diasize-browse-handle :handle
     1747           and v-object-handle <> v-diasize-resize-button
     1748           and can-query(v-object-handle, "row")
     1749           and can-query(v-object-handle, "height")
     1750           and ( v-object-handle :col + v-object-handle :width
     1751                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1752               )
     1753           then do:
     1754             find first buf_temp-browse-handle
     1755               where buf_temp-browse-handle.browse-type   = 'width':u
     1756                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1757               no-error .
     1758             if available buf_temp-browse-handle
     1759             then do:
     1760             end.
     1761             else do:
     1762               create buf_temp-diasize-handle .
     1763               assign
     1764                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1765                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1766               .
     1767             end.
     1768           end.
     1769           assign
     1770             v-object-handle = v-object-handle :next-sibling
     1771           .
     1772         end.
     1773         assign
     1774           v-field-group-handle = v-field-group-handle :next-sibling
     1775         .
     1776       end.
     1777       do with frame Dialog-Frame
     1778       :
     1779         hide v-diasize-resize-button .
     1780         v-diasize-resize-button :row = 1.
     1781         v-diasize-resize-button :column = 1.
     1782       end.
     1783       if p-change-value > 0
     1784       then do:
     1785         if frame Dialog-Frame :scrollable = true
     1786         then do:
     1787           assign
     1788             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1789             no-error .
     1790           if error-status :error
     1791           or error-status :get-message(1) <> ""
     1792           then do:
     1793             undo move_block, retry move_block.
     1794           end.
     1795         end.
     1796         assign
     1797           frame Dialog-Frame :width = v-frame-width + p-change-value
     1798           no-error .
     1799         if error-status :error
     1800         or error-status :get-message(1) <> ""
     1801         then do:
     1802           undo move_block, retry move_block.
     1803         end.
     1804         assign
     1805           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1806         no-error .
     1807         if error-status :error
     1808         or error-status :get-message(1) <> ""
     1809         then do:
     1810           undo move_block, retry move_block.
     1811         end.
     1812         for each buf_temp-browse-handle
     1813           where buf_temp-browse-handle.browse-type = 'width':u
     1814         on error undo move_block, retry move_block
     1815         :
     1816           assign
     1817             buf_temp-browse-handle.browse-handle :width
     1818               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1819             no-error .
     1820           if error-status :error
     1821           or error-status :get-message(1) <> ""
     1822           then do:
     1823             undo move_block, retry move_block .
     1824           end.
     1825         end.
     1826         for each buf_temp-diasize-handle
     1827         on error undo move_block, retry move_block
     1828         :
     1829           assign
     1830             v-object-handle = buf_temp-diasize-handle.handle-value
     1831           .
     1832           if v-object-handle <> v-diasize-resize-button
     1833           then do:
     1834             assign
     1835               v-object-handle :col = v-object-handle :col + p-change-value
     1836               no-error .
     1837             if error-status :error
     1838             or error-status :get-message(1) <> ""
     1839             then do:
     1840               undo move_block, retry move_block .
     1841             end.
     1842           end.
     1843         end.
     1844       end.
     1845       else do:
     1846         for each buf_temp-diasize-handle
     1847         on error undo move_block, retry move_block
     1848         :
     1849           assign
     1850             v-object-handle = buf_temp-diasize-handle.handle-value
     1851           .
     1852           if v-object-handle <> v-diasize-resize-button
     1853           then do:
     1854             assign
     1855               v-object-handle :col = v-object-handle :col + p-change-value
     1856               no-error .
     1857             if error-status :error
     1858             or error-status :get-message(1) <> ""
     1859             then do:
     1860               undo move_block, retry move_block .
     1861             end.
     1862           end.
     1863         end.
     1864         for each buf_temp-browse-handle
     1865           where buf_temp-browse-handle.browse-type = 'width':u
     1866         on error undo move_block, retry move_block
     1867         :
     1868           assign
     1869             buf_temp-browse-handle.browse-handle :width
     1870               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1871             no-error .
     1872           if error-status :error
     1873           or error-status :get-message(1) <> ""
     1874           then do:
     1875             undo move_block, retry move_block .
     1876           end.
     1877         end.
     1878         assign
     1879           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1880           no-error .
     1881         if error-status :error
     1882         or error-status :get-message(1) <> ""
     1883         then do:
     1884           undo move_block, retry move_block.
     1885         end.
     1886         assign
     1887           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1888         no-error .
     1889         if error-status :error
     1890         or error-status :get-message(1) <> ""
     1891         then do:
     1892           undo move_block, retry move_block.
     1893         end.
     1894         if frame Dialog-Frame :scrollable = true
     1895         then do:
     1896           assign
     1897             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1898           no-error .
     1899           if error-status :error
     1900           or error-status :get-message(1) <> ""
     1901           then do:
     1902             undo move_block, retry move_block.
     1903           end.
     1904         end.
     1905       end.
     1906       if p-move-resize
     1907       then do:
     1908         run diasize_position-resize-button in this-procedure .
     1909       end.
     1910       if v-diasize-wndstore = true
     1911       then do:
     1912         if connected("ub") = true
     1913         then do:
     1914           define variable v-cntxt-db-num        as integer   no-undo .
     1915           define variable v-cntxt-userid        as character no-undo .
     1916           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1917                                             , OUTPUT v-cntxt-userid
     1918                                             ) .
     1919           run gbl/wndsizew.p
     1920             (input  v-cntxt-db-num
     1921             ,input  v-cntxt-userid
     1922             ,input  v-diasize-proc-name
     1923             ,input  'width':u
     1924             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1925             ) .
     1926         end.
     1927       end.
     1928     end.
     1929     assign
     1930       v-diasize-change-size = false
     1931     .
     1932   end procedure.
     1933   procedure diasize_set-width :
     1934     define input  parameter p-new-width  as decimal   no-undo .
     1935     define input  parameter p-move-resize as logical   no-undo .
     1936     do
     1937     on error undo, return error return-value
     1938     :
     1939       run diasize_change-width in this-procedure
     1940         (input  (p-new-width - frame Dialog-Frame :width)
     1941         ,input  p-move-resize
     1942         ) .
     1943     end.
     1944   end procedure.
     1945   procedure diasize_position-resize-button :
     1946     do with frame Dialog-Frame
     1947     :
     1948       hide v-diasize-resize-button .
     1949       assign
     1950         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1951                     - 1
     1952                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1953         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1954                     - 1
     1955                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1956       .
     1957       view v-diasize-resize-button .
     1958     end.
     1959   end procedure.
     1960   on alt-right anywhere
     1961   do:
     1962     run diasize_change-width in this-procedure
     1963       (input 1
     1964       ,input true
     1965       ) .
     1966     return no-apply .
     1967   end.
     1968   on alt-left anywhere
     1969   do:
     1970     run diasize_change-width in this-procedure
     1971       (input -1
     1972       ,input true
     1973       ) .
     1974     return no-apply .
     1975   end.
     1976   on alt-down anywhere
     1977   do:
     1978     run diasize_change-height in this-procedure
     1979       (input 1
     1980       ,input true
     1981       ) .
     1982     return no-apply .
     1983   end.
     1984   on alt-up anywhere
     1985   do:
     1986     run diasize_change-height in this-procedure
     1987       (input -1
     1988       ,input true
     1989       ) .
     1990     return no-apply .
     1991   end.
     1992   on alt-enter of frame Dialog-Frame
     1993   do:
     1994     run diasize_maximize in this-procedure
     1995       (input  ?
     1996       ).
     1997     return no-apply .
     1998   end.
     1999   procedure diasize_end-move :
     2000     do
     2001     on error undo, return error return-value
     2002     :
     2003       define variable v-row-delta as decimal   no-undo .
     2004       define variable v-col-delta as decimal   no-undo .
     2005       define variable v-new-row as decimal   no-undo .
     2006       define variable v-new-col as decimal   no-undo .
     2007       assign
     2008         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2009         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2010       .
     2011       assign
     2012         v-row-delta = v-new-row - frame Dialog-Frame :height
     2013         v-col-delta = v-new-col - frame Dialog-Frame :width
     2014       .
     2015       run diasize_change-height in this-procedure
     2016         (input v-row-delta
     2017         ,input true
     2018         ) .
     2019       run diasize_change-width in this-procedure
     2020         (input v-col-delta
     2021         ,input true
     2022         ) .
     2023     end.
     2024   end procedure.
     2025   procedure diasize_maximize :
     2026     define input  parameter p-action as logical   no-undo .
     2027     do
     2028     on error undo, return error return-value
     2029     :
     2030       if p-action = ?
     2031       then do:
     2032         if v-diasize-need-maximize = true
     2033         then do:
     2034           assign
     2035             p-action = true
     2036           .
     2037         end.
     2038         else do:
     2039           assign
     2040             p-action = false
     2041           .
     2042         end.
     2043       end.
     2044       if p-action = true
     2045       then do:
     2046         run diasize_change-height in this-procedure
     2047           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2048               - frame Dialog-Frame :height-chars
     2049           ,input true
     2050           ) .
     2051         run diasize_change-width in this-procedure
     2052           (input session :width-chars
     2053               - frame Dialog-Frame :width-chars
     2054           ,input true
     2055           ) .
     2056         assign
     2057           v-diasize-need-maximize = false
     2058         .
     2059       end.
     2060       else do:
     2061         run diasize_change-width in this-procedure
     2062           (input v-diasize-orig-frame-width
     2063               - frame Dialog-Frame :width-chars
     2064           ,input true
     2065           ) .
     2066         run diasize_change-height in this-procedure
     2067           (input v-diasize-orig-frame-height
     2068               - frame Dialog-Frame :height-chars
     2069           ,input true
     2070           ) .
     2071         assign
     2072           v-diasize-need-maximize = true
     2073         .
     2074       end.
     2075     end.
     2076   end procedure.
     2077   procedure diasize_restore-orig-size :
     2078     do
     2079     on error undo, return error return-value
     2080     :
     2081       assign
     2082         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2083         v-diasize-current-frame-height = frame Dialog-Frame :height
     2084       .
     2085       run diasize_set-height in this-procedure
     2086         (input  v-diasize-orig-frame-height
     2087         ,input  true
     2088         ) .
     2089       run diasize_set-width in this-procedure
     2090         (input  v-diasize-orig-frame-width
     2091         ,input  true
     2092         ) .
     2093     end.
     2094   end procedure.
     2095   procedure diasize_restore-current-size :
     2096     do
     2097     on error undo, return error return-value
     2098     :
     2099       run diasize_set-height in this-procedure
     2100         (input  v-diasize-current-frame-height
     2101         ,input  true
     2102         ) .
     2103       run diasize_set-width in this-procedure
     2104         (input  v-diasize-current-frame-width
     2105         ,input  true
     2106         ) .
     2107     end.
     2108   end procedure.
     2109   procedure diasize_set-browse-handle :
     2110     define input  parameter p-browse-handle as handle   no-undo .
     2111     define buffer buf_temp-browse-handle for temp-browse-handle .
     2112     do
     2113     on error undo, return error return-value
     2114     :
     2115       assign
     2116         v-diasize-browse-handle = p-browse-handle
     2117       .
     2118       for each buf_temp-browse-handle
     2119       on error undo, return error return-value
     2120       :
     2121         delete buf_temp-browse-handle .
     2122       end.
     2123     end.
     2124   end procedure.
     2125   procedure diasize_add_browse :
     2126     define input  parameter p-browse-type   as character no-undo .
     2127     define input  parameter p-browse-handle as handle    no-undo .
     2128     define buffer buf_temp-browse-handle for temp-browse-handle .
     2129     do
     2130     on error undo, return error return-value
     2131     :
     2132       assign
     2133         v-diasize-browse-number = v-diasize-browse-number + 1
     2134       .
     2135       create buf_temp-browse-handle .
     2136       assign
     2137         buf_temp-browse-handle.browse-type   = p-browse-type
     2138         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2139         buf_temp-browse-handle.browse-handle = p-browse-handle
     2140       .
     2141     end.
     2142   end procedure.
     2143   procedure diasize_init :
     2144     define variable v-default-value    as logical   no-undo .
     2145     define variable v-restore-saved    as logical   no-undo .
     2146     define variable v-resize-value-str as character no-undo .
     2147     do
     2148     on error undo, return error return-value
     2149     :
     2150       do with frame Dialog-Frame
     2151       :
     2152         assign
     2153           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2154           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2155           v-diasize-browse-handle     = browse BROWSE-2 :handle
     2156         .
     2157         create button v-diasize-resize-button
     2158         assign
     2159           parent        = frame Dialog-Frame :first-child
     2160           label         = "s"
     2161           height-pixels = 16
     2162           width-pixels  = 16
     2163           visible       = true
     2164           sensitive     = true
     2165           movable       = true
     2166           triggers:
     2167             on end-move persistent run diasize_end-move in this-procedure .
     2168           end triggers.
     2169         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2170         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2171         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2172         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2173         assign
     2174           v-diasize-wndmax = false
     2175         .
     2176         if connected("ub") = true
     2177         then do:
     2178           define variable v-cntxt-db-num        as integer   no-undo .
     2179           define variable v-cntxt-userid        as character no-undo .
     2180           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2181                                             , OUTPUT v-cntxt-userid
     2182                                             ) .
     2183           run gbl/wndpar_r.p
     2184             (input  v-cntxt-db-num
     2185             ,input  v-cntxt-userid
     2186             ,input  'wndmax':U
     2187             ,output v-diasize-wndmax
     2188             ,output v-default-value
     2189             ) .
     2190         end.
     2191         assign
     2192           v-diasize-wndstore = false
     2193         .
     2194         if connected("ub") = true
     2195         then do:
     2196           run gbl/wndpar_r.p
     2197             (input  v-cntxt-db-num
     2198             ,input  v-cntxt-userid
     2199             ,input  'wndstore':U
     2200             ,output v-diasize-wndstore
     2201             ,output v-default-value
     2202             ) .
     2203         end.
     2204         assign
     2205           v-diasize-proc-name = entry(1, program-name(2), '.')
     2206         .
     2207         if v-diasize-wndstore = true
     2208         then do:
     2209           assign
     2210             v-restore-saved = false
     2211           .
     2212           if connected("ub") = true
     2213           then do:
     2214             run gbl/wndsizer.p
     2215               (input  v-cntxt-db-num
     2216               ,input  v-cntxt-userid
     2217               ,input  v-diasize-proc-name
     2218               ,input  'height':u
     2219               ,output v-resize-value-str
     2220               ) .
     2221             if v-resize-value-str <> '':U
     2222             then do:
     2223               run diasize_change-height in this-procedure
     2224                 (input  integer(v-resize-value-str)
     2225                 ,input  true
     2226                 ) .
     2227               assign
     2228                 v-restore-saved = true
     2229               .
     2230             end.
     2231           end.
     2232           if connected("ub") = true
     2233           then do:
     2234             run gbl/wndsizer.p
     2235               (input  v-cntxt-db-num
     2236               ,input  v-cntxt-userid
     2237               ,input  v-diasize-proc-name
     2238               ,input  'width':u
     2239               ,output v-resize-value-str
     2240               ) .
     2241             if v-resize-value-str <> '':U
     2242             then do:
     2243               run diasize_change-width in this-procedure
     2244                 (input  integer(v-resize-value-str)
     2245                 ,input  true
     2246                 ) .
     2247               assign
     2248                 v-restore-saved = true
     2249               .
     2250             end.
     2251           end.
     2252           if v-restore-saved <> true
     2253           then do:
     2254             if v-diasize-wndmax = true
     2255             then do:
     2256               run diasize_maximize in this-procedure
     2257                 (input  true
     2258                 ) .
     2259             end.
     2260           end.
     2261         end.
     2262         else do:
     2263           if v-diasize-wndmax = true
     2264           then do:
     2265             run diasize_maximize in this-procedure
     2266               (input  true
     2267               ) .
     2268           end.
     2269         end.
     2270       end.
     2271     end.
     2272   end procedure.
     2273   procedure diasize_need-full-display :
     2274     define output parameter p-need-full-display as logical   no-undo .
     2275     do
     2276     on error undo, return error return-value
     2277     :
     2278       assign
     2279         p-need-full-display = v-diasize-need-full-display
     2280       .
     2281       assign
     2282         v-diasize-need-full-display = false
     2283       .
     2284     end.
     2285   end procedure.
     2286   procedure get-context :
     2287      define output parameter p-db-num as integer          no-undo.
     2288      define output parameter p-user-id as character        no-undo.
     2289      define variable v-login               as character    no-undo.
     2290      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2291      define buffer buf_user-login  for ub.user-login .
     2292      do
     2293      on error undo, return error
     2294      :
     2295            FIND FIRST buf_sys-ctrl no-lock.
     2296            ASSIGN
     2297               v-login = USERID("ub")
     2298               p-db-num = buf_sys-ctrl.db-num
     2299            .
     2300            FIND FIRST buf_user-login
     2301                 WHERE buf_user-login.db-num = p-db-num
     2302                   AND buf_user-login.user-login = v-login
     2303                 no-lock
     2304                 no-error
     2305                 .
     2306            IF AVAILABLE buf_user-login
     2307            THEN DO:
     2308               assign
     2309                  p-user-id = buf_user-login.user-id
     2310               .
     2311            END.
     2312      end.
     2313   end procedure.
     2314       run diasize_init in this-procedure .
     2315   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2316   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     2317     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     2318     return no-apply.
     2319   end.
     2320   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2321   on F4 of frame Dialog-Frame anywhere do:
     2322     if b-chg :sensitive then DO: apply "CHOOSE":U to b-chg in frame Dialog-Frame. END.
     2323     return no-apply.
     2324   end.
     2325   MAIN-BLOCK:
     2326   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2327       ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2328   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2329     run mainmenu_getcntxt in parparentproc
     2330       (output v-cntxt-db-num
     2331       ,output v-cntxt-userid
     2332       ,output v-cntxt-level
     2333       ,output v-cntxt-host-code-obj
     2334       ,output v-cntxt-obj-type
     2335       ,output v-cntxt-obj-code
     2336       ,output v-cntxt-db-num-obj
     2337       ,output v-cntxt-is-admin
     2338       ) .
     2339       find first buf_place
     2340           where buf_place.obj-type = p-obj-type
     2341           and buf_place.obj-code = p-obj-code
     2342           and buf_place.pl-code  = p-pl-code
     2343           no-lock
     2344           no-error
     2345           .
     2346       IF NOT AVAILABLE buf_place THEN
     2347       DO:
     2348           return error SUBSTITUTE ( "Не найдено складское место &1 &2 &3"
     2349               , p-pl-code
     2350               , p-obj-code
     2351               , p-obj-type
     2352               ) .
     2353       end.
     2354       v-place-type = 2 .
     2355       for first buf_place-attr no-lock where buf_place-attr.obj-type = buf_place.obj-type
     2356                                          and buf_place-attr.obj-code = buf_place.obj-code
     2357                                          and buf_place-attr.pl-code = buf_place.pl-code
     2358                                          and buf_place-attr.attr-code = "place-type"
     2359                                          :
     2360         v-place-type = integer(buf_place-attr.attr-value) .
     2361       end .
     2362       ASSIGN
     2363           FRAME Dialog-Frame:TITLE = SUBSTITUTE  ( "Градуировочная таблица для резервуара &1 (&2) &3 &4"
     2364                                                , p-pl-code
     2365                                                , buf_place.loc1
     2366                                                , p-obj-code
     2367                                                , p-obj-type
     2368                                                )
     2369       .
     2370       for each buf_pl-level no-lock where buf_pl-level.obj-type = p-obj-type
     2371                                       and buf_pl-level.obj-code = p-obj-code
     2372                                       and buf_pl-level.pl-code  = p-pl-code
     2373                                       :
     2374         find first buf_pl-level-attr no-lock where buf_pl-level-attr.obj-type  = buf_pl-level.obj-type
     2375                                                and buf_pl-level-attr.obj-code  = buf_pl-level.obj-code
     2376                                                and buf_pl-level-attr.pl-code   = buf_pl-level.pl-code
     2377                                                and buf_pl-level-attr.pl-level  = buf_pl-level.pl-level
     2378                                                and buf_pl-level-attr.attr-code = "tarir-delta"
     2379                                                no-error .
     2380         if not available buf_pl-level-attr
     2381         then do :
     2382           create buf_pl-level-attr .
     2383           assign
     2384             buf_pl-level-attr.obj-type  = buf_pl-level.obj-type
     2385             buf_pl-level-attr.obj-code  = buf_pl-level.obj-code
     2386             buf_pl-level-attr.pl-code   = buf_pl-level.pl-code
     2387             buf_pl-level-attr.pl-level  = buf_pl-level.pl-level
     2388             buf_pl-level-attr.attr-code = "tarir-delta"
     2389             buf_pl-level-attr.attr-value = (if v-place-type = 2 then string(0.25) else string(0.20))
     2390           .
     2391         end .
     2392       end .
     2393       RUN enable_UI.
     2394       find first buf_pl-level no-lock where buf_pl-level.obj-type = p-obj-type
     2395                                         and buf_pl-level.obj-code = p-obj-code
     2396                                         and buf_pl-level.pl-code  = p-pl-code
     2397                                         no-error .
     2398       if available buf_pl-level
     2399       then do :
     2400         disable
     2401           b-add b-chg b-del b-load b-delete
     2402         with frame Dialog-Frame .
     2403       end .
     2404       else do :
     2405         assign v-new = yes .
     2406       end .
     2407       WAIT-FOR GO OF FRAME Dialog-Frame.
     2408   END.
     2409   RUN disable_UI.
     2410   PROCEDURE check-pl-level :
     2411       define output parameter p-error as character        no-undo.
     2412       define buffer bf_pl-level for ub.pl-level .
     2413       define variable v-pl-level-begin as integer no-undo.
     2414       define variable v-pl-level-end   as integer no-undo.
     2415       define variable v-count          as integer no-undo.
     2416       FIND FIRST bf_pl-level
     2417           where bf_pl-level.obj-type = p-obj-type
     2418           and bf_pl-level.obj-code = p-obj-code
     2419           and bf_pl-level.pl-code  = p-pl-code
     2420           no-lock
     2421           no-error.
     2422       IF NOT AVAILABLE bf_pl-level THEN
     2423       DO:
     2424           RETURN.
     2425       END.
     2426       assign
     2427           v-pl-level-begin = bf_pl-level.pl-level
     2428           .
     2429       FIND LAST  bf_pl-level
     2430           where bf_pl-level.obj-type = p-obj-type
     2431           and bf_pl-level.obj-code = p-obj-code
     2432           and bf_pl-level.pl-code  = p-pl-code
     2433           no-lock
     2434           .
     2435       assign
     2436           v-pl-level-end = bf_pl-level.pl-level
     2437           .
     2438       do v-count = v-pl-level-begin to v-pl-level-end :
     2439           IF NOT CAN-FIND(FIRST bf_pl-level
     2440               where bf_pl-level.obj-type = p-obj-type
     2441               and bf_pl-level.obj-code = p-obj-code
     2442               and bf_pl-level.pl-code  = p-pl-code
     2443               and bf_pl-level.pl-level = v-count
     2444               no-lock)
     2445               THEN
     2446           DO:
     2447               ASSIGN
     2448                   p-error = IF p-error = "" THEN STRING(v-count)
     2449                                        ELSE SUBSTITUTE  ( "&1,&2"
     2450                                                         , p-error
     2451                                                         , v-count
     2452                                                         )
     2453                   .
     2454           END.
     2455       END.
     2456   END PROCEDURE.
     2457   PROCEDURE del-pl-level :
     2458       define buffer bf_pl-level for ub.pl-level .
     2459       define buffer bf_pl-level-attr for ub.pl-level-attr .
     2460       define variable v-ok  as logical no-undo.
     2461       define variable v-del as logical no-undo.
     2462       message
     2463           SUBSTITUTE ( "Удалить уровень &1 "
     2464           , buf_pl-level.pl-level
     2465           )
     2466           view-as alert-box information
     2467           BUTTONS YES-NO
     2468           update v-del
     2469           .
     2470       IF v-del
     2471           THEN
     2472       DO
     2473           on error undo, return error
     2474           :
     2475           IF CAN-FIND(FIRST bf_pl-level
     2476               where bf_pl-level.obj-type = p-obj-type
     2477               and bf_pl-level.obj-code = p-obj-code
     2478               and bf_pl-level.pl-code  = p-pl-code
     2479               and bf_pl-level.pl-level < buf_pl-level.pl-level
     2480               no-lock)
     2481               AND CAN-FIND(FIRST bf_pl-level
     2482               where bf_pl-level.obj-type = p-obj-type
     2483               and bf_pl-level.obj-code = p-obj-code
     2484               and bf_pl-level.pl-code  = p-pl-code
     2485               and bf_pl-level.pl-level > buf_pl-level.pl-level
     2486               no-lock)
     2487               THEN
     2488           DO:
     2489               message
     2490                   SUBSTITUTE ( "Уровень &1 находится в середине градуировочной таблицы"
     2491                   , buf_pl-level.pl-level
     2492                   )
     2493                   skip
     2494                   "При его удалении возникнут пропуски в таблице."
     2495                   skip
     2496                   "Все равно удалить Удалить?"
     2497                   view-as alert-box information
     2498                   BUTTONS YES-NO
     2499                   update v-ok
     2500                   .
     2501               IF v-ok THEN
     2502               DO:
     2503                   FIND FIRST bf_pl-level
     2504                       where RowID(bf_pl-level) = RowID(buf_pl-level)
     2505                       exclusive-lock
     2506                   .
     2507                   for each bf_pl-level-attr exclusive-lock where bf_pl-level-attr.obj-type = bf_pl-level.obj-type
     2508                                                              and bf_pl-level-attr.obj-code = bf_pl-level.obj-code
     2509                                                              and bf_pl-level-attr.pl-code  = bf_pl-level.pl-code
     2510                                                              and bf_pl-level-attr.pl-level = bf_pl-level.pl-level
     2511                   :
     2512                     delete bf_pl-level-attr .
     2513                   end .
     2514                   DELETE bf_pl-level .
     2515               END.
     2516           END.
     2517           ELSE
     2518           DO:
     2519               FIND FIRST bf_pl-level
     2520                   where RowID(bf_pl-level) = RowID(buf_pl-level)
     2521                   exclusive-lock
     2522               .
     2523               for each bf_pl-level-attr exclusive-lock where bf_pl-level-attr.obj-type = bf_pl-level.obj-type
     2524                                                          and bf_pl-level-attr.obj-code = bf_pl-level.obj-code
     2525                                                          and bf_pl-level-attr.pl-code  = bf_pl-level.pl-code
     2526                                                          and bf_pl-level-attr.pl-level = bf_pl-level.pl-level
     2527               :
     2528                 delete bf_pl-level-attr .
     2529               end .
     2530               DELETE bf_pl-level .
     2531           END.
     2532       END.
     2533   END PROCEDURE.
     2534   PROCEDURE importExcel :
     2535   define input parameter fileImport as character no-undo.
     2536   define variable mExcelApplication as component-handle no-undo.
     2537   define variable mWorkBook         as component-handle no-undo.
     2538   define variable mWorkSheet        as component-handle no-undo.
     2539   define variable cntLine           as integer   no-undo.
     2540   define variable vLine             as character no-undo.
     2541   define variable vErr              as character no-undo.
     2542   define variable vTarirDeltaMain   as decimal                no-undo.
     2543   define variable vLevel            like ub.pl-level.pl-level no-undo.
     2544   define variable vQnty             like ub.pl-level.pl-qnty  no-undo.
     2545   define variable vTarirDelta       as decimal                no-undo.
     2546   define variable vDeltaV           as decimal                no-undo.
     2547   define variable vFileTxt          as character.
     2548   define buffer b_pl-level for ub.pl-level.
     2549   define buffer b_pl-level-attr for ub.pl-level-attr.
     2550   create "Excel.Application":U mExcelApplication no-error.
     2551   if error-status :error then
     2552   do:
     2553    return error "Ошибка при запуске Excel".
     2554   end.
     2555   ASSIGN
     2556    mExcelApplication:DisplayAlerts = NO
     2557    mWorkbook                       = mExcelApplication:WorkBooks:Add(fileImport)
     2558    mWorkSheet                      = mWorkbook:Sheets:Item(1)
     2559   .
     2560   if trim(mWorkSheet:Range("A1"):VALUE) <> "Имя/Тип" or
     2561      trim(mWorkSheet:Range("A2"):VALUE) <> "Погрешность определения вместимости, ±%" or
     2562      trim(mWorkSheet:Range("A4"):VALUE) = "" then
     2563   do:
     2564     return error "В выбранном файле нет градуировочных таблиц.~nТаблицы не загружены.".
     2565   end.
     2566   vTarirDeltaMain = mWorkSheet:Range("B2"):VALUE no-error.
     2567   vFileTxt = substitute("&1&2.&3",
     2568                         session:temp-directory,
     2569                         entry(1,entry(num-entries(fileImport,"\"),fileImport,"\"),"."),
     2570                         "txt").
     2571   output stream vTxt to value(vFileTxt).
     2572   cntLine = 4.
     2573   IMP:
     2574   do transaction on error undo IMP, leave IMP:
     2575   repeat:
     2576     vLine  = string(cntLine).
     2577     if mWorkSheet:Range("A" + vLine):VALUE = "" or
     2578        mWorkSheet:Range("A" + vLine):VALUE = ? then
     2579       leave IMP.
     2580     assign
     2581       vLevel = mWorkSheet:Range("A" + vLine):VALUE
     2582       vQnty  = mWorkSheet:Range("B" + vLine):VALUE
     2583     no-error.
     2584     if error-status:error then
     2585     do:
     2586       vErr = "Ошибка при чтении строки: " + error-status:get-message(1).
     2587       undo IMP, leave IMP.
     2588     end.
     2589     assign
     2590       vTarirDelta = mWorkSheet:Range("C" + vLine):VALUE
     2591       vDeltaV     = mWorkSheet:Range("D" + vLine):VALUE
     2592     no-error.
     2593     put stream vTxt unformatted
     2594       string(buf_place.loc1) chr(9)
     2595       string(vLevel) chr(9)
     2596       string(round(vQnty * 1000,0)) chr(9)
     2597       string(round((if vTarirDelta > 0 then vTarirDelta else vTarirDeltaMain),3)) chr(9)
     2598       string(round(vDeltaV,4)) skip
     2599     .
     2600     cntLine = cntLine + 1.
     2601   end.
     2602   end.
     2603   output stream vTxt close.
     2604   mExcelApplication:Quit().
     2605   release object mExcelApplication.
     2606   if vErr = "" then
     2607   do:
     2608       run utl/tarir2.p  ( input vFileTxt
     2609           , input p-obj-type
     2610           , input p-obj-code
     2611           , input p-pl-code
     2612       ) no-error.
     2613       if error-status:error then
     2614         vErr = substitute("&1~n&2", error-status:get-message(1), return-value).
     2615   end.
     2616   os-delete value(vFileTxt).
     2617   if vErr <> "" then
     2618     return error vErr.
     2619   END PROCEDURE.
     2620   PROCEDURE disable_UI :
     2621       HIDE FRAME Dialog-Frame.
     2622   END PROCEDURE.
     2623   PROCEDURE enable_UI :
     2624       ENABLE b-exit b-add b-chg b-del b-load b-delete b-zone b-help BROWSE-2
     2625           WITH FRAME Dialog-Frame.
     2626       VIEW FRAME Dialog-Frame.
     2627       OPEN QUERY BROWSE-2 FOR EACH buf_pl-level       WHERE buf_pl-level.obj-type = p-obj-type  AND buf_pl-level.obj-code = p-obj-code  AND buf_pl-level.pl-code = p-pl-code NO-LOCK,  FIRST buf_pl-level-mm OUTER-JOIN where buf_pl-level-mm.obj-type = p-obj-type  and buf_pl-level-mm.obj-code = p-obj-code  and buf_pl-level-mm.pl-code = p-pl-code  and buf_pl-level-mm.min-level <= buf_pl-level.pl-level  and buf_pl-level-mm.max-level >= buf_pl-level.pl-level NO-LOCK,  first buf_pl-level-attr where buf_pl-level-attr.obj-type = p-obj-type  and buf_pl-level-attr.obj-code = p-obj-code  and buf_pl-level-attr.pl-code = p-pl-code  and buf_pl-level-attr.pl-level = buf_pl-level.pl-level  and buf_pl-level-attr.attr-code = "tarir-delta" no-lock,  first buf2_pl-level-attr OUTER-JOIN where buf2_pl-level-attr.obj-type = p-obj-type  and buf2_pl-level-attr.obj-code = p-obj-code  and buf2_pl-level-attr.pl-code = p-pl-code  and buf2_pl-level-attr.pl-level = buf_pl-level.pl-level  and buf2_pl-level-attr.attr-code = "deltaV" no-lock INDEXED-REPOSITION.
     2628   END PROCEDURE.
