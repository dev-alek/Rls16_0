      357   define variable v-update-attr as logical no-undo .
      358   define variable v-attr-type as character no-undo .
      359   define variable v-attr-format as character no-undo .
      360   define variable v-attr-label as character no-undo .
      361   define variable v-attr-user-can-edit as logical no-undo .
      362   define variable v-attr-output-display as logical no-undo .
      363   define variable v-attr-other as char no-undo .
      364   define variable v-return-value  as character no-undo .
      365   define temp-table tt0-clients-attr no-undo like ub.clients-attr.
      366   define buffer buf_clients-attr for ub.clients-attr.
      367   define buffer locked_clients-attr for ub.clients-attr.
      368   main-block:
      369   do
      370   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      371   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      372   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      373   :
      374     for each tt0-clients-attr:
      375       delete tt0-clients-attr.
      376     end.
      377     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      378       do on error undo, return error :
      379         FOR EACH buf_clients-attr no-lock  where
      380                 buf_clients-attr.obj-type = p-obj-type
      381             AND buf_clients-attr.obj-code = p-obj-code
      382         on error undo, return error :
      383           v-attr-user-can-edit = no.
      384           run clntattr-code in this-procedure (
      385                                                   input  buf_clients-attr.attr-code
      386                                                   ,output v-attr-type
      387                                                   ,output v-attr-format
      388                                                   ,output v-attr-label
      389                                                   ,output v-attr-user-can-edit
      390                                                   ,output v-attr-output-display
      391                                                   ,output v-attr-other
      392                                                ) no-error .
      393           if v-attr-user-can-edit then do:
      394             find first locked_clients-attr exclusive-lock where
      395                 locked_clients-attr.obj-type = p-obj-type
      396             AND locked_clients-attr.obj-code = p-obj-code
      397             AND locked_clients-attr.attr-code = buf_clients-attr.attr-code no-error.
      398             if available locked_clients-attr then do:
      399               CREATE tt0-clients-attr.
      400               BUFFER-COPY locked_clients-attr TO tt0-clients-attr.
      401             end.
      402           end.
      403           else do:
      404             CREATE tt0-clients-attr.
      405             BUFFER-COPY buf_clients-attr TO tt0-clients-attr.
      406           end.
      407         END.
      408         run ref/cli-atti.w (
      409                         input parparentproc
      410                       , input p-mode
      411                       , input p-obj-type
      412                       , input p-obj-code
      413                       , input p-update-on-exit
      414                       , output p-modified
      415                       , input-output table tt0-clients-attr
      416                             ) no-error.
      417         if error-status:error then do:
      418           assign
      419           v-return-value = substitute("&1&2&3", error-status:get-message(1), chr(10), return-value)
      420           p-is-error = yes.
      421         end.
      422         for each tt0-clients-attr:
      423           delete tt0-clients-attr.
      424         end.
      425       end.
      426     end.
      427     else do:
      428       FOR EACH buf_clients-attr no-lock where
      429            buf_clients-attr.obj-type = p-obj-type
      430        AND buf_clients-attr.obj-code = p-obj-code
      431       :
      432           CREATE tt0-clients-attr.
      433           BUFFER-COPY buf_clients-attr TO tt0-clients-attr.
      434       END.
      435       run ref/cli-atti.w (
      436                       input parparentproc
      437                     , input p-mode
      438                     , input p-obj-type
      439                     , input p-obj-code
      440                     , input p-update-on-exit
      441                     , output p-modified
      442                     , input-output table tt0-clients-attr
      443                           ) no-error.
      444       if error-status:error then do:
      445         assign
      446         v-return-value = substitute("&1&2&3", error-status:get-message(1), chr(10), return-value)
      447         p-is-error = yes.
      448       end.
      449       for each tt0-clients-attr:
      450         delete tt0-clients-attr.
      451       end.
      452     end.
      453     if p-is-error then do:
      454       return v-return-value .
      455     end.
      456   end.
