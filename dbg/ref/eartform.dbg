      398         buf_ext-artic.unit-cli-ord COLUMN-LABEL "Ед.изм. пост.!в заказе" FORMAT "X(3)":U
      399         buf_ext-artic.cli-base-rate-ord COLUMN-LABEL "Коэф. ед. пост.!в заказе" FORMAT ">>,>>9.<<<<":U
