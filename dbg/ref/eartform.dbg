        1   DEFINE BUFFER buf_clients FOR ub.clients.
        2   DEFINE BUFFER buf_ext-artic FOR ub.ext-artic.
        3   DEFINE BUFFER buf_goods FOR ub.goods.
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Справочник внешних артикулов".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114   define variable v-waitfram-action01         as character   no-undo .
      115   define variable v-waitfram-action02         as character   no-undo .
      116   define variable v-waitfram-action03         as character   no-undo .
      117   define variable mWaitFramTextBeg            as character   no-undo.
      118   define variable mWaitFramTextEnd            as character   no-undo.
      119   define variable mWaitFramView               as logical     no-undo.
      120   define variable mWaitProcEvent              as logical     no-undo init yes.
      121   define variable mWaitFramInterval           as integer     no-undo init 1 .
      122   define variable mWaitFramStop               as logical     no-undo.
      123   define variable mWaitFramStopUser           as logical     no-undo.
      124   define variable mWaitFramStopTimeOut        as logical     no-undo.
      125   define variable mWaitFramStartProc          as datetime-tz no-undo.
      126   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      127   define button B-WaitFramStop auto-end-key
      128        label "Стоп"
      129        size 10 by 1 tooltip "Остоновить процесс".
      130   define button B-viewProcInfo
      131        label "Информация"
      132        size 15 by 1 tooltip "Информация о процесс".
      133   define frame waitfram
      134     v-waitfram-action01 format "x(72)" no-label skip
      135     v-waitfram-action02 format "x(72)" no-label skip
      136     v-waitfram-action03 format "x(72)" no-label skip
      137     B-viewProcInfo
      138     B-WaitFramStop at row 4 col 30
      139     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      140     .
      141   define new global shared variable mBatchMode as logical no-undo init ?.
      142   define variable mFramBachModHandle as handle no-undo.
      143   mFramBachModHandle = frame waitfram:handle.
      144   define variable mFameOldVis as logical no-undo.
      145   define variable mVisCUrentVin as logical no-undo.
      146   if session:batch-mode
      147   then
      148      mBatchMode = yes.
      149   if mBatchMode = ? then do:
      150     mVisCUrentVin = current-window:visible.
      151     mFameOldVis = mFramBachModHandle:visible.
      152     mFramBachModHandle:visible  = yes.
      153     mBatchMode = mFramBachModHandle:visible ne yes.
      154     mFramBachModHandle:visible = mFameOldVis.
      155     current-window:visible = mVisCUrentVin.
      156   end.
      157    if  log-manager:logfile-name ne ?
      158     then DO:
      159         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      160         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      161         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      162     end.
      163   on choose of B-WaitFramStop in frame waitfram
      164   do:
      165     mWaitFramStop = yes.
      166     mWaitFramStopUser = yes.
      167   end.
      168   function waitfram-check-timeout returns logical():
      169      define variable vtime as int64 no-undo.
      170      if mWaitFramStopTimeOut
      171      then
      172         return yes.
      173      vtime = ( now - mWaitFramStartProc ) / 1000 .
      174      if     mWaitFramTimeOut ne ?
      175         and mWaitFramTimeOut ne 0
      176         and mWaitFramTimeOut lt vtime
      177      then do:
      178         mWaitFramStopTimeOut = yes.
      179      end.
      180      return mWaitFramStopTimeOut.
      181   end.
      182   procedure waitfram-hide :
      183     if not session:batch-mode
      184     then do
      185     on error undo, return error return-value
      186     :
      187       pause 0 before-hide .
      188       if not mBatchMode then
      189         hide frame waitfram .
      190     end.
      191   end procedure.
      192   procedure waitfram-show :
      193     define input  parameter p-message as character no-undo .
      194     define variable v-left-margin as integer   no-undo .
      195     if not session:batch-mode
      196     then do
      197     on error undo, return error return-value
      198     :
      199       if length(p-message) <= 70 then do:
      200         assign
      201           v-left-margin = integer((70 - length(p-message)) / 2)
      202         .
      203         assign
      204           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      205         .
      206         assign
      207           v-waitfram-action01 = " "
      208           v-waitfram-action02 = " "
      209                                    + fill(" ", v-left-margin)
      210                                    + p-message
      211           v-waitfram-action03 = " "
      212         .
      213       end.
      214       else do:
      215         define variable vRindex1 as integer no-undo.
      216         define variable vRindex2 as integer no-undo.
      217         vRindex1 = r-index(p-message," ",70).
      218         if vRindex1 = 0
      219         then
      220            vRindex1 = 70.
      221         if length(p-message)  <= vRindex1 + 70 then do:
      222           assign
      223             v-waitfram-action01 = " "
      224             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      225             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      226           .
      227         end.
      228         else do:
      229           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      230           if vRindex2 <= vRindex1
      231           then
      232              vRindex2 = vRindex1 + 70.
      233           assign
      234             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      235             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      236             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      237           .
      238         end.
      239       end.
      240       B-viewProcInfo:visible   in frame waitfram = no.
      241       B-viewProcInfo:sensitive in frame waitfram = no.
      242       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      243       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      244       if  (   mWaitFramView
      245          or  mWaitProcEvent)
      246          and not mBatchMode
      247       then
      248          display
      249             v-waitfram-action01 skip
      250             v-waitfram-action02 skip
      251             v-waitfram-action03 skip
      252          with frame waitfram .
      253     end.
      254   end procedure.
      255      procedure waitfram-show-this:
      256         define input  parameter iInterval as int64 no-undo.
      257         define variable vtime as int64 no-undo.
      258         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      259         mWaitFramInterval = iInterval.
      260         run waitfram-show (substitute("&1&2 &3&4" ,
      261                                       mWaitFramTextBeg ,
      262                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      263                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      264                                       mWaitFramTextEnd
      265                                      )
      266                           ).
      267      end.
      268      procedure WaitFramRunPause:
      269         define input  parameter iInterval as dec no-undo.
      270         define variable vStart  as datetime-tz no-undo.
      271         define variable vend    as datetime-tz no-undo.
      272         define variable vint as int64 no-undo.
      273         define variable vOk as logical no-undo.
      274         vStart = now.
      275         vend   = vStart.
      276         publish "WaitFramPause" (iInterval,output vOk).
      277         vend   =  now.
      278         vint = vend - vStart.
      279         vint = iInterval - vint / 1000.
      280         if     not mWaitFramStop
      281            and (   vint > 0
      282                 or (    not vOk
      283                     and iInterval eq ?
      284                     )
      285                 )
      286         then
      287            run waitfram-show-this (iInterval).
      288         vend   =  now.
      289         vint = vend - vStart.
      290         vint = iInterval - vint / 1000.
      291         if     not mWaitFramStop
      292            and vint > 0
      293         then do:
      294            run gbl/pause.p (vint * 1000).
      295         end.
      296         if iInterval ne ?
      297         then
      298            publish "WaitFramStop".
      299         waitfram-check-timeout().
      300      end.
      301      procedure WaitFramWaitFor:
      302         define input  parameter iInterval as dec no-undo.
      303         assign
      304            mWaitFramStartProc   = now
      305            mWaitFramStopUser    = no
      306            mWaitFramStopTimeOut = no
      307         .
      308         block-wait:
      309         do while not mWaitFramStop:
      310            run WaitFramRunPause (iInterval).
      311            if  waitfram-check-timeout()
      312            then do:
      313               leave block-wait.
      314            end.
      315         end.
      316         run waitfram-hide.
      317      end.
      318   procedure waitfram-join :
      319     define input  parameter p-line-1  as character no-undo .
      320     define input  parameter p-line-2  as character no-undo .
      321     define input  parameter p-line-3  as character no-undo .
      322     define output parameter p-message as character no-undo .
      323     do
      324     on error undo, return error return-value
      325     :
      326       assign
      327         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      328                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      329                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      330       .
      331     end.
      332   end procedure.
      333   function waitfram-join-function returns character
      334     (input p-line-1 as character
      335     ,input p-line-2 as character
      336     ,input p-line-3 as character
      337     ).
      338     define variable v-message as character no-undo .
      339     run waitfram-join in this-procedure
      340       (input  p-line-1
      341       ,input  p-line-2
      342       ,input  p-line-3
      343       ,output v-message
      344       ) .
      345     return v-message .
      346   end function .
      347   define new global shared variable g#library  as handle no-undo .
      348   define new global shared variable g#library2 as handle no-undo .
      349   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      350     define variable v-cntxt-db-num        as integer   no-undo .
      351     define variable v-cntxt-userid        as character no-undo .
      352     define variable v-cntxt-level         as character no-undo .
      353     define variable v-cntxt-host-code-obj as integer   no-undo .
      354     define variable v-cntxt-obj-type      as character no-undo .
      355     define variable v-cntxt-obj-code      as integer   no-undo .
      356     define variable v-cntxt-db-num-obj    as integer   no-undo .
      357     define variable v-cntxt-is-admin      as logical   no-undo .
      358   define input  parameter parParentProc as widget-handle        no-undo .
      359   define input  parameter p-mode        as character            no-undo .
      360   define input  parameter p-gds-code    like ub.goods.gds-code  no-undo .
      361   define variable g-log as logical   no-undo .
      362   DEFINE BUTTON b-add
