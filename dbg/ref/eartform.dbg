      389         buf_clients SCROLLING.
      390   DEFINE BROWSE br-ext-artic
      391     QUERY br-ext-artic NO-LOCK DISPLAY
      392         (STRING (buf_ext-artic.cli-code, "999999999")  +  " "  +  TRIM (buf_ext-artic.cli-type)) COLUMN-LABEL "Код/Тип" FORMAT "X(13)":U
      393         buf_clients.obj-name FORMAT "X(40)":U
      394         buf_ext-artic.ext-artic FORMAT "X(16)":U
      395         buf_ext-artic.status_ FORMAT "X(8)":U
