      510   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      511   if lookup(self :type
      512            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      513            ) = 0
      514   then do:
      515     message
      516       "$Workfile$"
      517       "Указанному интерфейсному элементу фокус не может быть передан" skip
      518       "Интерфейсный элемент" self :name  skip
      519       "Тип" self :type  skip
      520       "Процедура" this-procedure :file-name skip
      521       view-as alert-box .
      522   end.
      523   else do:
      524     apply "entry":u to self  .
      525     if focus :handle <> self :handle  then do:
      526       return no-apply .
      527     end.
      528   end.
      529     run proc-b-lkp in this-procedure no-error .
      530     if error-status :error then return no-apply.
      531   END.
      532   ON MOUSE-SELECT-DBLCLICK OF br-ext-artic IN FRAME Dialog-Frame
      533   DO:
      534     run proc-br-ext-artic in this-procedure no-error .
      535     if error-status :error then return no-apply.
      536   END.
      537   ON RETURN OF br-ext-artic IN FRAME Dialog-Frame
      538   DO:
      539     run proc-br-ext-artic in this-procedure no-error .
      540     if error-status :error then return no-apply.
      541   END.
      542   ON VALUE-CHANGED OF br-ext-artic IN FRAME Dialog-Frame
      543   DO:
      544     run proc-br-ext-artic-value-change in this-procedure no-error .
      545     if error-status :error then return no-apply.
      546   END.
      547   ON VALUE-CHANGED OF rs-stts IN FRAME Dialog-Frame
      548   DO:
      549     run proc-rs-stts in this-procedure no-error .
      550     if error-status :error then return no-apply.
      551   END.
      552   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      553   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      554   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      555   on F3 of frame Dialog-Frame anywhere do:
      556     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame Dialog-Frame. END.
      557     return no-apply.
      558   end.
      559   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      560   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
      561     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
      562     return no-apply.
      563   end.
      564   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      565   on F4 of frame Dialog-Frame anywhere do:
      566     if b-chg :sensitive then DO: apply "CHOOSE":U to b-chg in frame Dialog-Frame. END.
      567     return no-apply.
      568   end.
      569   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      570   on F8 of frame Dialog-Frame anywhere do:
      571     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame Dialog-Frame. END.
      572     return no-apply.
      573   end.
      574   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      575   on help of frame Dialog-Frame
      576   do:
      577     run gbl/app_help.p
      578       (input this-procedure :file-name
      579       ,input ''
      580       ,input ?
      581       ) no-error.
      582     if error-status :error then do:
      583       message
      584         "Ошибка при вызове помощи"
      585         error-status :get-message(1)
      586         view-as alert-box .
      587     end.
      588   end.
      589   run minbtn-set in this-procedure .
      590   on choose of b-help in frame Dialog-Frame
      591   do:
      592     apply "help":u to frame Dialog-Frame .
      593   end.
      594   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      595   procedure minbtn-set :
      596       do
      597           on error undo, return error return-value
      598           :
      599           define variable ii              as integer       no-undo .
      600           define variable fh              as widget-handle no-undo .
      601           define variable hh              as widget-handle no-undo .
      602           define variable v-h             as handle        extent 4 no-undo .
      603           define variable v-name-button   as character     no-undo .
      604           define variable v-help-old-x    as decimal       no-undo .
      605           define variable v-help-old-y    as decimal       no-undo .
      606           define variable v-help-old-size as decimal       no-undo .
      607           define variable v-frame-width   as decimal       no-undo .
      608           define variable jj              as integer       no-undo .
      609           do
      610               on error undo, return error
      611               :
      612               assign
      613                   v-frame-width = frame Dialog-Frame:width - 0.3
      614                   fh            = frame Dialog-Frame:first-child
      615                   hh            = fh:first-child
      616                   ii            = 1
      617                   .
      618               do while valid-handle(hh):
      619                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      620                   do:
      621                       case lc(hh:name) :
      622                           when "b-help" then
      623                               do:
      624                                   hh:load-image-up("cmp/b-help.bmp":u) .
      625                                   hh:load-image-down("cmp/b-help.bmp":u) .
      626                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      627                                   hh:TOOLTIP = "Помощь" .
      628                                   v-help-old-x = hh:column .
      629                                   v-help-old-y = hh:row    .
      630                                   v-help-old-size = hh:width .
      631                                   hh:width-chars = 2.5 .
      632                               end.
      633                           when "b-print" then
      634                               do:
      635                                   hh:load-image("cmp/b-print.bmp":u) .
      636                                   hh:TOOLTIP = "Печать" .
      637                                   v-h[ii] = hh:handle .
      638                                   ii = ii + 1 .
      639                                   hh:width-chars = 3 .
      640                               end.
      641                           when "b-history" or
      642                           when "b-hist" then
      643                               do:
      644                                   hh:load-image("cmp/b-hist.bmp":u) .
      645                                   hh:TOOLTIP = "История" .
      646                                   v-h[ii] = hh:handle .
      647                                   ii = ii + 1 .
      648                                   hh:width-chars = 3 .
      649                               end.
      650                           when "b-sch" then
      651                               do:
      652                                   hh:load-image("cmp/b-sch.bmp":u) .
      653                                   hh:TOOLTIP = "Установка Фильтра" .
      654                                   v-h[ii] = hh:handle .
      655                                   ii = ii + 1 .
      656                                   hh:width-chars = 3 .
      657                               end.
      658                           when "b-hist-user" then
      659                               do:
      660                                   hh:load-image("cmp/b-hist.bmp":u) .
      661                                   hh:TOOLTIP = "История пользователя" .
      662                                   ii = ii + 1 .
      663                               end.
      664                       end case.
      665                   end.
      666                   hh = hh:next-sibling.
      667               end.
      668               b-help:column = v-frame-width - b-help:width-chars.
      669               jj = 0.
      670               repeat ii = 4 to 1 by -1 :
      671                   if valid-handle (v-h[ii] ) then
      672                   do:
      673                       jj  = jj + 1 .
      674                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      675                       v-h[ii]:row    = v-help-old-y .
      676                   end.
      677               end.
      678           end.
      679       end.
      680   end procedure.
      681   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      682   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      683   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      684   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      685   define variable v-diasize-current-frame-width  as decimal   no-undo .
      686   define variable v-diasize-current-frame-height as decimal   no-undo .
      687   define variable v-diasize-change-size          as logical   no-undo .
      688   define variable v-diasize-resize-button        as handle    no-undo .
      689   define variable v-diasize-wndmax               as logical   no-undo .
      690   define variable v-diasize-wndstore             as logical   no-undo .
      691   define variable v-diasize-proc-name            as character no-undo .
      692   define variable v-diasize-browse-handle        as handle    no-undo .
      693   define variable v-diasize-browse-number        as integer   no-undo .
      694   define variable v-diasize-need-full-display    as logical   no-undo init false .
      695   define temp-table temp-diasize-handle no-undo
      696     field handle-value  as handle
      697     field save-position as decimal
      698     index xpk is primary unique handle-value
      699     .
      700   define temp-table temp-browse-handle no-undo
      701     field browse-type   as character
      702     field browse-number as integer
      703     field browse-handle as handle
      704     field original-size as decimal
      705     index xpk is primary unique browse-type browse-number
      706     index xie browse-type browse-handle
      707   .
      708   procedure diasize_change-height :
      709     define input  parameter p-change-value  as decimal   no-undo .
      710     define input  parameter p-move-resize   as logical   no-undo .
      711     define variable v-field-group-handle    as handle    no-undo .
      712     define variable v-object-handle         as handle    no-undo .
      713     define variable v-frame-height          as decimal   no-undo .
      714     define variable v-frame-virtual-height  as decimal   no-undo .
      715     define variable v-browse-height         as decimal   no-undo .
      716     define variable v-window-height         as decimal   no-undo .
      717     define variable v-window-virtual-height as decimal   no-undo .
      718     define variable v-change-sign           as integer   no-undo .
      719     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      720     define buffer buf_temp-browse-handle  for temp-browse-handle .
      721     if p-change-value > 0
      722     then do:
      723       if frame Dialog-Frame :height + p-change-value
      724           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      725       then do:
      726         assign
      727           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      728                           - (frame Dialog-Frame :height-chars)
      729         .
      730         if p-change-value <= 0
      731         then do:
      732           run diasize_position-resize-button in this-procedure .
      733           return .
      734         end.
      735       end.
      736     end.
      737     if p-change-value < 0
      738     then do:
      739       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      740       then do:
      741         assign
      742           p-change-value = v-diasize-orig-frame-height
      743                          - (frame Dialog-Frame :height-chars)
      744         .
      745         if p-change-value >= 0
      746         then do:
      747           run diasize_position-resize-button in this-procedure .
      748           return .
      749         end.
      750       end.
      751     end.
      752     if p-change-value >= 0
      753     then do:
      754       assign
      755         v-change-sign = 1
      756       .
      757     end.
      758     else do:
      759       assign
      760         v-change-sign = -1
      761       .
      762     end.
      763     assign
      764       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      765     .
      766     if p-change-value = 0
      767     then do:
      768       run diasize_position-resize-button in this-procedure .
      769       return .
      770     end.
      771     move_block:
      772     do
      773     on error undo move_block, retry move_block
      774     :
      775       if retry
      776       then do:
      777         do
      778         on error undo move_block, leave move_block
      779         :
      780           if p-change-value > 0
      781           then do:
      782             for each buf_temp-diasize-handle
      783             on error undo, next
      784             :
      785               assign
      786                 v-object-handle = buf_temp-diasize-handle.handle-value
      787               .
      788               if v-object-handle <> v-diasize-resize-button
      789               then do:
      790                 assign
      791                   v-object-handle :row = buf_temp-diasize-handle.save-position
      792                 .
      793               end.
      794             end.
      795             assign
      796               v-diasize-browse-handle :height = v-browse-height
      797             .
      798             for each buf_temp-browse-handle
      799               where buf_temp-browse-handle.browse-type = 'height':u
      800             on error undo, next
      801             :
      802               assign
      803                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      804               .
      805             end.
      806             assign
      807               frame Dialog-Frame :height = v-frame-height
      808             .
      809             if frame Dialog-Frame :scrollable = true
      810             then do:
      811               assign
      812                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      813               .
      814             end.
      815             run diasize_position-resize-button in this-procedure .
      816           end.
      817           else do:
      818             if frame Dialog-Frame :scrollable = true
      819             then do:
      820               assign
      821                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      822               .
      823             end.
      824             assign
      825               frame Dialog-Frame :height = v-frame-height
      826             .
      827             assign
      828               v-diasize-browse-handle :height = v-browse-height
      829             .
      830             for each buf_temp-browse-handle
      831               where buf_temp-browse-handle.browse-type = 'height':u
      832             on error undo, next
      833             :
      834               assign
      835                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      836               .
      837             end.
      838             for each buf_temp-diasize-handle
      839             on error undo, next
      840             :
      841               assign
      842                 v-object-handle = buf_temp-diasize-handle.handle-value
      843               .
      844               if v-object-handle <> v-diasize-resize-button
      845               then do:
      846                 assign
      847                   v-object-handle :row = buf_temp-diasize-handle.save-position
      848                 .
      849               end.
      850             end.
      851             run diasize_position-resize-button in this-procedure .
      852           end.
      853           assign
      854             v-diasize-change-size = false
      855           .
      856           leave move_block .
      857         end.
      858       end.
      859       assign
      860         v-diasize-need-full-display = true
      861       .
      862       if v-diasize-change-size = false
      863       then do:
      864         assign
      865           v-diasize-change-size = true
      866         .
      867       end.
      868       else do:
      869         return .
      870       end.
      871       assign
      872         v-frame-height = frame Dialog-Frame :height
      873         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      874         v-browse-height = v-diasize-browse-handle :height
      875       .
      876       for each buf_temp-browse-handle
      877         where buf_temp-browse-handle.browse-type = 'height':u
      878       :
      879         assign
      880           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      881         .
      882       end.
      883       for each buf_temp-diasize-handle
      884       :
      885         delete buf_temp-diasize-handle .
      886       end.
      887       assign
      888         v-field-group-handle = frame Dialog-Frame :first-child
      889       .
      890       do while valid-handle(v-field-group-handle)
      891       :
      892         assign
      893           v-object-handle = v-field-group-handle :first-child
      894         .
      895         do while valid-handle(v-object-handle)
      896         :
      897           if  v-object-handle <> v-diasize-browse-handle :handle
      898           and can-query(v-object-handle, "row")
      899           and can-query(v-object-handle, "height")
      900           and ( v-object-handle :row > v-diasize-browse-handle :row )
      901           then do:
      902             find first buf_temp-browse-handle
      903               where buf_temp-browse-handle.browse-type   = 'height':u
      904                 and buf_temp-browse-handle.browse-handle = v-object-handle
      905               no-error .
      906             if available buf_temp-browse-handle
      907             then do:
      908             end.
      909             else do:
      910               create buf_temp-diasize-handle .
      911               assign
      912                 buf_temp-diasize-handle.handle-value  = v-object-handle
      913                 buf_temp-diasize-handle.save-position = v-object-handle :row
      914               .
      915             end.
      916           end.
      917           assign
      918             v-object-handle = v-object-handle :next-sibling
      919           .
      920         end.
      921         assign
      922           v-field-group-handle = v-field-group-handle :next-sibling
      923         .
      924       end.
      925       do with frame Dialog-Frame
      926       :
      927         hide v-diasize-resize-button .
      928         assign
      929           v-diasize-resize-button :row    = 1
      930           v-diasize-resize-button :column = 1
      931         .
      932       end.
      933       if p-change-value > 0
      934       then do:
      935         if frame Dialog-Frame :scrollable = true
      936         then do:
      937           assign
      938             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      939             no-error .
      940           if error-status :error
      941           or error-status :get-message(1) <> ""
      942           then do:
      943             undo move_block, retry move_block .
      944           end.
      945         end.
      946         assign
      947           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      948           no-error .
      949         if error-status :error
      950         or error-status :get-message(1) <> ""
      951         then do:
      952           undo move_block, retry move_block .
      953         end.
      954         assign
      955           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      956           no-error .
      957         if error-status :error
      958         or error-status :get-message(1) <> ""
      959         then do:
      960           undo move_block, retry move_block .
      961         end.
      962         for each buf_temp-browse-handle
      963           where buf_temp-browse-handle.browse-type = 'height':u
      964         on error undo move_block, retry move_block
      965         :
      966           assign
      967             buf_temp-browse-handle.browse-handle :height
      968               = buf_temp-browse-handle.browse-handle :height + p-change-value
      969             no-error .
      970           if error-status :error
      971           or error-status :get-message(1) <> ""
      972           then do:
      973             undo move_block, retry move_block .
      974           end.
      975         end.
      976         for each buf_temp-diasize-handle
      977         on error undo move_block, retry move_block
      978         :
      979           assign
      980             v-object-handle = buf_temp-diasize-handle.handle-value
      981           .
      982           if v-object-handle <> v-diasize-resize-button
      983           then do:
      984             assign
      985               v-object-handle :row = v-object-handle :row + p-change-value
      986               no-error .
      987             if error-status :error
      988             or error-status :get-message(1) <> ""
      989             then do:
      990               undo move_block, retry move_block .
      991             end.
      992           end.
      993         end.
      994       end.
      995       else do:
      996         for each buf_temp-diasize-handle
      997         on error undo move_block, retry move_block
      998         :
      999           assign
     1000             v-object-handle = buf_temp-diasize-handle.handle-value
     1001           .
     1002           if v-object-handle <> v-diasize-resize-button
     1003           then do:
     1004             assign
     1005               v-object-handle :row = v-object-handle :row + p-change-value
     1006               no-error .
     1007             if error-status :error
     1008             or error-status :get-message(1) <> ""
     1009             then do:
     1010               undo move_block, retry move_block .
     1011             end.
     1012           end.
     1013         end.
     1014         assign
     1015           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1016           no-error .
     1017         if error-status :error
     1018         or error-status :get-message(1) <> ""
     1019         then do:
     1020           undo move_block, retry move_block .
     1021         end.
     1022         for each buf_temp-browse-handle
     1023           where buf_temp-browse-handle.browse-type = 'height':u
     1024         on error undo move_block, retry move_block
     1025         :
     1026           assign
     1027             buf_temp-browse-handle.browse-handle :height
     1028               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1029             no-error .
     1030           if error-status :error
     1031           or error-status :get-message(1) <> ""
     1032           then do:
     1033             undo move_block, retry move_block .
     1034           end.
     1035         end.
     1036         assign
     1037           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1038           no-error .
     1039         if error-status :error
     1040         or error-status :get-message(1) <> ""
     1041         then do:
     1042           undo move_block, retry move_block .
     1043         end.
     1044         if frame Dialog-Frame :scrollable = true
     1045         then do:
     1046           assign
     1047             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1048             no-error .
     1049           if error-status :error
     1050           or error-status :get-message(1) <> ""
     1051           then do:
     1052             undo move_block, retry move_block .
     1053           end.
     1054         end.
     1055       end.
     1056       if p-move-resize = true
     1057       then do:
     1058         run diasize_position-resize-button in this-procedure .
     1059       end.
     1060       if v-diasize-wndstore = true
     1061       then do:
     1062         if connected("ub") = true
     1063         then do:
     1064           define variable v-cntxt-db-num        as integer   no-undo .
     1065           define variable v-cntxt-userid        as character no-undo .
     1066           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1067                                             , OUTPUT v-cntxt-userid
     1068                                             ) .
     1069           run gbl/wndsizew.p
     1070             (input  v-cntxt-db-num
     1071             ,input  v-cntxt-userid
     1072             ,input  v-diasize-proc-name
     1073             ,input  'height':u
     1074             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1075             ) .
     1076         end.
     1077       end.
     1078     end.
     1079     assign
     1080       v-diasize-change-size = false
     1081     .
     1082   end procedure.
     1083   procedure diasize_set-height :
     1084     define input  parameter p-new-height  as decimal   no-undo .
     1085     define input  parameter p-move-resize as logical   no-undo .
     1086     do
     1087     on error undo, return error return-value
     1088     :
     1089       run diasize_change-height in this-procedure
     1090         (input  (p-new-height - frame Dialog-Frame :height)
     1091         ,input  p-move-resize
     1092         ) .
     1093     end.
     1094   end procedure.
     1095   procedure diasize_change-width :
     1096     define input  parameter p-change-value as decimal   no-undo .
     1097     define input  parameter p-move-resize  as logical   no-undo .
     1098     define variable v-field-group-handle   as handle    no-undo .
     1099     define variable v-object-handle        as handle    no-undo .
     1100     define variable v-frame-width          as decimal   no-undo .
     1101     define variable v-frame-virtual-width  as decimal   no-undo .
     1102     define variable v-browse-width         as decimal   no-undo .
     1103     define variable v-window-width         as decimal   no-undo .
     1104     define variable v-window-virtual-width as decimal   no-undo .
     1105     define variable v-change-sign          as integer   no-undo .
     1106     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1107     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1108     if p-change-value > 0
     1109     then do:
     1110       if frame Dialog-Frame :width + p-change-value >
     1111           session :width-chars
     1112       then do:
     1113         assign
     1114           p-change-value = session :width-chars - frame Dialog-Frame :width
     1115         .
     1116         if p-change-value <= 0
     1117         then do:
     1118           run diasize_position-resize-button in this-procedure .
     1119           return .
     1120         end.
     1121       end.
     1122     end.
     1123     if p-change-value < 0
     1124     then do:
     1125       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1126       then do:
     1127         assign
     1128           p-change-value = v-diasize-orig-frame-width
     1129                          - frame Dialog-Frame :width
     1130         .
     1131         if p-change-value >= 0
     1132         then do:
     1133           run diasize_position-resize-button in this-procedure .
     1134           return .
     1135         end.
     1136       end.
     1137     end.
     1138     if p-change-value >= 0
     1139     then do:
     1140       assign
     1141         v-change-sign = 1
     1142       .
     1143     end.
     1144     else do:
     1145       assign
     1146         v-change-sign = -1
     1147       .
     1148     end.
     1149     assign
     1150       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1151     .
     1152     if p-change-value = 0
     1153     then do:
     1154       run diasize_position-resize-button in this-procedure .
     1155       return .
     1156     end.
     1157     move_block:
     1158     do
     1159     on error undo move_block, leave move_block
     1160     :
     1161       if retry
     1162       then do:
     1163         do
     1164         on error undo move_block, leave move_block
     1165         :
     1166           if p-change-value > 0
     1167           then do:
     1168             for each buf_temp-diasize-handle
     1169             on error undo, next
     1170             :
     1171               assign
     1172                 v-object-handle = buf_temp-diasize-handle.handle-value
     1173               .
     1174               if v-object-handle <> v-diasize-resize-button
     1175               then do:
     1176                 assign
     1177                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1178                 .
     1179               end.
     1180             end.
     1181             assign
     1182               v-diasize-browse-handle :width = v-browse-width
     1183             .
     1184             for each buf_temp-browse-handle
     1185               where buf_temp-browse-handle.browse-type = 'width':u
     1186             on error undo, next
     1187             :
     1188               assign
     1189                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1190               .
     1191             end.
     1192             assign
     1193               frame Dialog-Frame :width = v-frame-width
     1194             .
     1195             if frame Dialog-Frame :scrollable = true
     1196             then do:
     1197               assign
     1198                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1199               .
     1200             end.
     1201             run diasize_position-resize-button in this-procedure .
     1202           end.
     1203           else do:
     1204             if frame Dialog-Frame :scrollable = true
     1205             then do:
     1206               assign
     1207                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1208               .
     1209             end.
     1210             assign
     1211               frame Dialog-Frame :width = v-frame-width
     1212             .
     1213             for each buf_temp-browse-handle
     1214               where buf_temp-browse-handle.browse-type = 'width':u
     1215             on error undo, next
     1216             :
     1217               assign
     1218                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1219               .
     1220             end.
     1221             assign
     1222               v-diasize-browse-handle :width = v-browse-width
     1223             .
     1224             for each buf_temp-diasize-handle
     1225             on error undo, next
     1226             :
     1227               assign
     1228                 v-object-handle = buf_temp-diasize-handle.handle-value
     1229               .
     1230               if v-object-handle <> v-diasize-resize-button
     1231               then do:
     1232                 assign
     1233                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1234                 .
     1235               end.
     1236             end.
     1237             run diasize_position-resize-button in this-procedure .
     1238           end.
     1239           assign
     1240             v-diasize-change-size = false
     1241           .
     1242           leave move_block .
     1243         end.
     1244       end.
     1245       assign
     1246         v-diasize-need-full-display = true
     1247       .
     1248       if v-diasize-change-size = false
     1249       then do:
     1250         assign
     1251           v-diasize-change-size = true
     1252         .
     1253       end.
     1254       else do:
     1255         return .
     1256       end.
     1257       assign
     1258         v-frame-width = frame Dialog-Frame :width
     1259         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1260         v-browse-width = v-diasize-browse-handle :width
     1261       .
     1262       for each buf_temp-browse-handle
     1263         where buf_temp-browse-handle.browse-type = 'width':u
     1264       :
     1265         assign
     1266           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1267         .
     1268       end.
     1269       for each buf_temp-diasize-handle
     1270       :
     1271         delete buf_temp-diasize-handle .
     1272       end.
     1273       assign
     1274         v-field-group-handle = frame Dialog-Frame :first-child
     1275       .
     1276       do while valid-handle(v-field-group-handle)
     1277       :
     1278         assign
     1279           v-object-handle = v-field-group-handle :first-child
     1280         .
     1281         do while valid-handle(v-object-handle)
     1282         :
     1283           if  v-object-handle <> v-diasize-browse-handle :handle
     1284           and v-object-handle <> v-diasize-resize-button
     1285           and can-query(v-object-handle, "row")
     1286           and can-query(v-object-handle, "height")
     1287           and ( v-object-handle :col + v-object-handle :width
     1288                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1289               )
     1290           then do:
     1291             find first buf_temp-browse-handle
     1292               where buf_temp-browse-handle.browse-type   = 'width':u
     1293                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1294               no-error .
     1295             if available buf_temp-browse-handle
     1296             then do:
     1297             end.
     1298             else do:
     1299               create buf_temp-diasize-handle .
     1300               assign
     1301                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1302                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1303               .
     1304             end.
     1305           end.
     1306           assign
     1307             v-object-handle = v-object-handle :next-sibling
     1308           .
     1309         end.
     1310         assign
     1311           v-field-group-handle = v-field-group-handle :next-sibling
     1312         .
     1313       end.
     1314       do with frame Dialog-Frame
     1315       :
     1316         hide v-diasize-resize-button .
     1317         v-diasize-resize-button :row = 1.
     1318         v-diasize-resize-button :column = 1.
     1319       end.
     1320       if p-change-value > 0
     1321       then do:
     1322         if frame Dialog-Frame :scrollable = true
     1323         then do:
     1324           assign
     1325             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1326             no-error .
     1327           if error-status :error
     1328           or error-status :get-message(1) <> ""
     1329           then do:
     1330             undo move_block, retry move_block.
     1331           end.
     1332         end.
     1333         assign
     1334           frame Dialog-Frame :width = v-frame-width + p-change-value
     1335           no-error .
     1336         if error-status :error
     1337         or error-status :get-message(1) <> ""
     1338         then do:
     1339           undo move_block, retry move_block.
     1340         end.
     1341         assign
     1342           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1343         no-error .
     1344         if error-status :error
     1345         or error-status :get-message(1) <> ""
     1346         then do:
     1347           undo move_block, retry move_block.
     1348         end.
     1349         for each buf_temp-browse-handle
     1350           where buf_temp-browse-handle.browse-type = 'width':u
     1351         on error undo move_block, retry move_block
     1352         :
     1353           assign
     1354             buf_temp-browse-handle.browse-handle :width
     1355               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1356             no-error .
     1357           if error-status :error
     1358           or error-status :get-message(1) <> ""
     1359           then do:
     1360             undo move_block, retry move_block .
     1361           end.
     1362         end.
     1363         for each buf_temp-diasize-handle
     1364         on error undo move_block, retry move_block
     1365         :
     1366           assign
     1367             v-object-handle = buf_temp-diasize-handle.handle-value
     1368           .
     1369           if v-object-handle <> v-diasize-resize-button
     1370           then do:
     1371             assign
     1372               v-object-handle :col = v-object-handle :col + p-change-value
     1373               no-error .
     1374             if error-status :error
     1375             or error-status :get-message(1) <> ""
     1376             then do:
     1377               undo move_block, retry move_block .
     1378             end.
     1379           end.
     1380         end.
     1381       end.
     1382       else do:
     1383         for each buf_temp-diasize-handle
     1384         on error undo move_block, retry move_block
     1385         :
     1386           assign
     1387             v-object-handle = buf_temp-diasize-handle.handle-value
     1388           .
     1389           if v-object-handle <> v-diasize-resize-button
     1390           then do:
     1391             assign
     1392               v-object-handle :col = v-object-handle :col + p-change-value
     1393               no-error .
     1394             if error-status :error
     1395             or error-status :get-message(1) <> ""
     1396             then do:
     1397               undo move_block, retry move_block .
     1398             end.
     1399           end.
     1400         end.
     1401         for each buf_temp-browse-handle
     1402           where buf_temp-browse-handle.browse-type = 'width':u
     1403         on error undo move_block, retry move_block
     1404         :
     1405           assign
     1406             buf_temp-browse-handle.browse-handle :width
     1407               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1408             no-error .
     1409           if error-status :error
     1410           or error-status :get-message(1) <> ""
     1411           then do:
     1412             undo move_block, retry move_block .
     1413           end.
     1414         end.
     1415         assign
     1416           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1417           no-error .
     1418         if error-status :error
     1419         or error-status :get-message(1) <> ""
     1420         then do:
     1421           undo move_block, retry move_block.
     1422         end.
     1423         assign
     1424           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1425         no-error .
     1426         if error-status :error
     1427         or error-status :get-message(1) <> ""
     1428         then do:
     1429           undo move_block, retry move_block.
     1430         end.
     1431         if frame Dialog-Frame :scrollable = true
     1432         then do:
     1433           assign
     1434             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1435           no-error .
     1436           if error-status :error
     1437           or error-status :get-message(1) <> ""
     1438           then do:
     1439             undo move_block, retry move_block.
     1440           end.
     1441         end.
     1442       end.
     1443       if p-move-resize
     1444       then do:
     1445         run diasize_position-resize-button in this-procedure .
     1446       end.
     1447       if v-diasize-wndstore = true
     1448       then do:
     1449         if connected("ub") = true
     1450         then do:
     1451           define variable v-cntxt-db-num        as integer   no-undo .
     1452           define variable v-cntxt-userid        as character no-undo .
     1453           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1454                                             , OUTPUT v-cntxt-userid
     1455                                             ) .
     1456           run gbl/wndsizew.p
     1457             (input  v-cntxt-db-num
     1458             ,input  v-cntxt-userid
     1459             ,input  v-diasize-proc-name
     1460             ,input  'width':u
     1461             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1462             ) .
     1463         end.
     1464       end.
     1465     end.
     1466     assign
     1467       v-diasize-change-size = false
     1468     .
     1469   end procedure.
     1470   procedure diasize_set-width :
     1471     define input  parameter p-new-width  as decimal   no-undo .
     1472     define input  parameter p-move-resize as logical   no-undo .
     1473     do
     1474     on error undo, return error return-value
     1475     :
     1476       run diasize_change-width in this-procedure
     1477         (input  (p-new-width - frame Dialog-Frame :width)
     1478         ,input  p-move-resize
     1479         ) .
     1480     end.
     1481   end procedure.
     1482   procedure diasize_position-resize-button :
     1483     do with frame Dialog-Frame
     1484     :
     1485       hide v-diasize-resize-button .
     1486       assign
     1487         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1488                     - 1
     1489                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1490         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1491                     - 1
     1492                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1493       .
     1494       view v-diasize-resize-button .
     1495     end.
     1496   end procedure.
     1497   on alt-right anywhere
     1498   do:
     1499     run diasize_change-width in this-procedure
     1500       (input 1
     1501       ,input true
     1502       ) .
     1503     return no-apply .
     1504   end.
     1505   on alt-left anywhere
     1506   do:
     1507     run diasize_change-width in this-procedure
     1508       (input -1
     1509       ,input true
     1510       ) .
     1511     return no-apply .
     1512   end.
     1513   on alt-down anywhere
     1514   do:
     1515     run diasize_change-height in this-procedure
     1516       (input 1
     1517       ,input true
     1518       ) .
     1519     return no-apply .
     1520   end.
     1521   on alt-up anywhere
     1522   do:
     1523     run diasize_change-height in this-procedure
     1524       (input -1
     1525       ,input true
     1526       ) .
     1527     return no-apply .
     1528   end.
     1529   on alt-enter of frame Dialog-Frame
     1530   do:
     1531     run diasize_maximize in this-procedure
     1532       (input  ?
     1533       ).
     1534     return no-apply .
     1535   end.
     1536   procedure diasize_end-move :
     1537     do
     1538     on error undo, return error return-value
     1539     :
     1540       define variable v-row-delta as decimal   no-undo .
     1541       define variable v-col-delta as decimal   no-undo .
     1542       define variable v-new-row as decimal   no-undo .
     1543       define variable v-new-col as decimal   no-undo .
     1544       assign
     1545         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1546         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1547       .
     1548       assign
     1549         v-row-delta = v-new-row - frame Dialog-Frame :height
     1550         v-col-delta = v-new-col - frame Dialog-Frame :width
     1551       .
     1552       run diasize_change-height in this-procedure
     1553         (input v-row-delta
     1554         ,input true
     1555         ) .
     1556       run diasize_change-width in this-procedure
     1557         (input v-col-delta
     1558         ,input true
     1559         ) .
     1560     end.
     1561   end procedure.
     1562   procedure diasize_maximize :
     1563     define input  parameter p-action as logical   no-undo .
     1564     do
     1565     on error undo, return error return-value
     1566     :
     1567       if p-action = ?
     1568       then do:
     1569         if v-diasize-need-maximize = true
     1570         then do:
     1571           assign
     1572             p-action = true
     1573           .
     1574         end.
     1575         else do:
     1576           assign
     1577             p-action = false
     1578           .
     1579         end.
     1580       end.
     1581       if p-action = true
     1582       then do:
     1583         run diasize_change-height in this-procedure
     1584           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1585               - frame Dialog-Frame :height-chars
     1586           ,input true
     1587           ) .
     1588         run diasize_change-width in this-procedure
     1589           (input session :width-chars
     1590               - frame Dialog-Frame :width-chars
     1591           ,input true
     1592           ) .
     1593         assign
     1594           v-diasize-need-maximize = false
     1595         .
     1596       end.
     1597       else do:
     1598         run diasize_change-width in this-procedure
     1599           (input v-diasize-orig-frame-width
     1600               - frame Dialog-Frame :width-chars
     1601           ,input true
     1602           ) .
     1603         run diasize_change-height in this-procedure
     1604           (input v-diasize-orig-frame-height
     1605               - frame Dialog-Frame :height-chars
     1606           ,input true
     1607           ) .
     1608         assign
     1609           v-diasize-need-maximize = true
     1610         .
     1611       end.
     1612     end.
     1613   end procedure.
     1614   procedure diasize_restore-orig-size :
     1615     do
     1616     on error undo, return error return-value
     1617     :
     1618       assign
     1619         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1620         v-diasize-current-frame-height = frame Dialog-Frame :height
     1621       .
     1622       run diasize_set-height in this-procedure
     1623         (input  v-diasize-orig-frame-height
     1624         ,input  true
     1625         ) .
     1626       run diasize_set-width in this-procedure
     1627         (input  v-diasize-orig-frame-width
     1628         ,input  true
     1629         ) .
     1630     end.
     1631   end procedure.
     1632   procedure diasize_restore-current-size :
     1633     do
     1634     on error undo, return error return-value
     1635     :
     1636       run diasize_set-height in this-procedure
     1637         (input  v-diasize-current-frame-height
     1638         ,input  true
     1639         ) .
     1640       run diasize_set-width in this-procedure
     1641         (input  v-diasize-current-frame-width
     1642         ,input  true
     1643         ) .
     1644     end.
     1645   end procedure.
     1646   procedure diasize_set-browse-handle :
     1647     define input  parameter p-browse-handle as handle   no-undo .
     1648     define buffer buf_temp-browse-handle for temp-browse-handle .
     1649     do
     1650     on error undo, return error return-value
     1651     :
     1652       assign
     1653         v-diasize-browse-handle = p-browse-handle
     1654       .
     1655       for each buf_temp-browse-handle
     1656       on error undo, return error return-value
     1657       :
     1658         delete buf_temp-browse-handle .
     1659       end.
     1660     end.
     1661   end procedure.
     1662   procedure diasize_add_browse :
     1663     define input  parameter p-browse-type   as character no-undo .
     1664     define input  parameter p-browse-handle as handle    no-undo .
     1665     define buffer buf_temp-browse-handle for temp-browse-handle .
     1666     do
     1667     on error undo, return error return-value
     1668     :
     1669       assign
     1670         v-diasize-browse-number = v-diasize-browse-number + 1
     1671       .
     1672       create buf_temp-browse-handle .
     1673       assign
     1674         buf_temp-browse-handle.browse-type   = p-browse-type
     1675         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1676         buf_temp-browse-handle.browse-handle = p-browse-handle
     1677       .
     1678     end.
     1679   end procedure.
     1680   procedure diasize_init :
     1681     define variable v-default-value    as logical   no-undo .
     1682     define variable v-restore-saved    as logical   no-undo .
     1683     define variable v-resize-value-str as character no-undo .
     1684     do
     1685     on error undo, return error return-value
     1686     :
     1687       do with frame Dialog-Frame
     1688       :
     1689         assign
     1690           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1691           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1692           v-diasize-browse-handle     = browse br-ext-artic :handle
     1693         .
     1694         create button v-diasize-resize-button
     1695         assign
     1696           parent        = frame Dialog-Frame :first-child
     1697           label         = "s"
     1698           height-pixels = 16
     1699           width-pixels  = 16
     1700           visible       = true
     1701           sensitive     = true
     1702           movable       = true
     1703           triggers:
     1704             on end-move persistent run diasize_end-move in this-procedure .
     1705           end triggers.
     1706         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1707         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1708         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1709         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1710         assign
     1711           v-diasize-wndmax = false
     1712         .
     1713         if connected("ub") = true
     1714         then do:
     1715           define variable v-cntxt-db-num        as integer   no-undo .
     1716           define variable v-cntxt-userid        as character no-undo .
     1717           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1718                                             , OUTPUT v-cntxt-userid
     1719                                             ) .
     1720           run gbl/wndpar_r.p
     1721             (input  v-cntxt-db-num
     1722             ,input  v-cntxt-userid
     1723             ,input  'wndmax':U
     1724             ,output v-diasize-wndmax
     1725             ,output v-default-value
     1726             ) .
     1727         end.
     1728         assign
     1729           v-diasize-wndstore = false
     1730         .
     1731         if connected("ub") = true
     1732         then do:
     1733           run gbl/wndpar_r.p
     1734             (input  v-cntxt-db-num
     1735             ,input  v-cntxt-userid
     1736             ,input  'wndstore':U
     1737             ,output v-diasize-wndstore
     1738             ,output v-default-value
     1739             ) .
     1740         end.
     1741         assign
     1742           v-diasize-proc-name = entry(1, program-name(2), '.')
     1743         .
     1744         if v-diasize-wndstore = true
     1745         then do:
     1746           assign
     1747             v-restore-saved = false
     1748           .
     1749           if connected("ub") = true
     1750           then do:
     1751             run gbl/wndsizer.p
     1752               (input  v-cntxt-db-num
     1753               ,input  v-cntxt-userid
     1754               ,input  v-diasize-proc-name
     1755               ,input  'height':u
     1756               ,output v-resize-value-str
     1757               ) .
     1758             if v-resize-value-str <> '':U
     1759             then do:
     1760               run diasize_change-height in this-procedure
     1761                 (input  integer(v-resize-value-str)
     1762                 ,input  true
     1763                 ) .
     1764               assign
     1765                 v-restore-saved = true
     1766               .
     1767             end.
     1768           end.
     1769           if connected("ub") = true
     1770           then do:
     1771             run gbl/wndsizer.p
     1772               (input  v-cntxt-db-num
     1773               ,input  v-cntxt-userid
     1774               ,input  v-diasize-proc-name
     1775               ,input  'width':u
     1776               ,output v-resize-value-str
     1777               ) .
     1778             if v-resize-value-str <> '':U
     1779             then do:
     1780               run diasize_change-width in this-procedure
     1781                 (input  integer(v-resize-value-str)
     1782                 ,input  true
     1783                 ) .
     1784               assign
     1785                 v-restore-saved = true
     1786               .
     1787             end.
     1788           end.
     1789           if v-restore-saved <> true
     1790           then do:
     1791             if v-diasize-wndmax = true
     1792             then do:
     1793               run diasize_maximize in this-procedure
     1794                 (input  true
     1795                 ) .
     1796             end.
     1797           end.
     1798         end.
     1799         else do:
     1800           if v-diasize-wndmax = true
     1801           then do:
     1802             run diasize_maximize in this-procedure
     1803               (input  true
     1804               ) .
     1805           end.
     1806         end.
     1807       end.
     1808     end.
     1809   end procedure.
     1810   procedure diasize_need-full-display :
     1811     define output parameter p-need-full-display as logical   no-undo .
     1812     do
     1813     on error undo, return error return-value
     1814     :
     1815       assign
     1816         p-need-full-display = v-diasize-need-full-display
     1817       .
     1818       assign
     1819         v-diasize-need-full-display = false
     1820       .
     1821     end.
     1822   end procedure.
     1823   procedure get-context :
     1824      define output parameter p-db-num as integer          no-undo.
     1825      define output parameter p-user-id as character        no-undo.
     1826      define variable v-login               as character    no-undo.
     1827      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1828      define buffer buf_user-login  for ub.user-login .
     1829      do
     1830      on error undo, return error
     1831      :
     1832            FIND FIRST buf_sys-ctrl no-lock.
     1833            ASSIGN
     1834               v-login = USERID("ub")
     1835               p-db-num = buf_sys-ctrl.db-num
     1836            .
     1837            FIND FIRST buf_user-login
     1838                 WHERE buf_user-login.db-num = p-db-num
     1839                   AND buf_user-login.user-login = v-login
     1840                 no-lock
     1841                 no-error
     1842                 .
     1843            IF AVAILABLE buf_user-login
     1844            THEN DO:
     1845               assign
     1846                  p-user-id = buf_user-login.user-id
     1847               .
     1848            END.
     1849      end.
     1850   end procedure.
     1851       run diasize_init in this-procedure .
     1852   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1853   do:
     1854     br-ext-artic :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     1855   end.
     1856   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1857   on f5 of frame Dialog-Frame anywhere
     1858   do:
     1859     RUN open-br IN THIS-PROCEDURE ( input ? ) .
     1860       apply "VALUE-CHANGED" to br-ext-artic.
     1861   end.
     1862   MAIN-BLOCK:
     1863   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1864      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1865   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1866     run mainmenu_getcntxt in parparentproc
     1867       (output v-cntxt-db-num
     1868       ,output v-cntxt-userid
     1869       ,output v-cntxt-level
     1870       ,output v-cntxt-host-code-obj
     1871       ,output v-cntxt-obj-type
     1872       ,output v-cntxt-obj-code
     1873       ,output v-cntxt-db-num-obj
     1874       ,output v-cntxt-is-admin
     1875       ) .
     1876     run my-enable in this-procedure .
     1877     WAIT-FOR GO OF FRAME Dialog-Frame.
     1878   END.
     1879   RUN disable_UI.
     1880   PROCEDURE disable_UI :
     1881     HIDE FRAME Dialog-Frame.
     1882   END PROCEDURE.
     1883   PROCEDURE enable_UI :
     1884     DISPLAY rs-stts
     1885         WITH FRAME Dialog-Frame.
     1886     IF AVAILABLE buf_goods THEN
     1887       DISPLAY buf_goods.artic buf_goods.gds-name
     1888         WITH FRAME Dialog-Frame.
     1889     ENABLE b-exit b-add b-lkp b-chg b-del b-help rs-stts br-ext-artic
     1890         WITH FRAME Dialog-Frame.
     1891     VIEW FRAME Dialog-Frame.
     1892     OPEN QUERY br-ext-artic FOR EACH buf_ext-artic NO-LOCK,       EACH buf_clients WHERE ub.buf_ext-artic.cli-type = buf_clients.obj-type   AND buf_ext-artic.cli-code = buf_clients.obj-code NO-LOCK INDEXED-REPOSITION.
     1893   END PROCEDURE.
     1894   PROCEDURE my-disable :
     1895   END PROCEDURE.
     1896   PROCEDURE my-enable :
     1897     find first buf_goods no-lock
     1898       where buf_goods.gds-code = p-gds-code
     1899     no-error .
     1900     if error-status :error
     1901     then do:
     1902       message
     1903         substitute("Не найден товар с кодом &1" , p-gds-code)
     1904       view-as alert-box information.
     1905       undo, return error substitute("Не найден товар с кодом &1" , p-gds-code).
     1906     end.
     1907     assign
     1908       rs-stts = 2
     1909     .
     1910     display
     1911       rs-stts
     1912       buf_goods.artic     when available buf_goods
     1913       buf_goods.gds-name  when available buf_goods
     1914     with frame Dialog-Frame.
     1915     enable
     1916       b-exit
     1917       b-add   when p-mode <> 'ПРОСМОТР':U
     1918       b-lkp
     1919       b-chg   when p-mode <> 'ПРОСМОТР':U
     1920       b-del   when p-mode <> 'ПРОСМОТР':U
     1921       b-help
     1922       rs-stts
     1923       br-ext-artic
     1924     with frame Dialog-Frame.
     1925     view frame Dialog-Frame.
     1926     run open-br in this-procedure (input ?).
     1927   END PROCEDURE.
     1928   PROCEDURE open-br :
     1929     define input  parameter p-recid as recid     no-undo .
     1930   do
     1931   on error undo, return error return-value
     1932   :
     1933     run waitfram-show in this-procedure ("Ждите...").
     1934     case rs-stts:
     1935       when 1
     1936       then do:
     1937         open query br-ext-artic
     1938           for each buf_ext-artic no-lock
     1939             where buf_ext-artic.gds-code = p-gds-code ,
     1940           each buf_clients no-lock
     1941             where buf_clients.obj-type = buf_ext-artic.cli-type
     1942               and buf_clients.obj-code = buf_ext-artic.cli-code
     1943         .
     1944       end.
     1945       when 2
     1946       then do:
     1947         open query br-ext-artic
     1948           for each buf_ext-artic no-lock
     1949             where buf_ext-artic.gds-code  = p-gds-code
     1950               and buf_ext-artic.status_   = 'тек':U ,
     1951           each buf_clients no-lock
     1952             where buf_clients.obj-type = buf_ext-artic.cli-type
     1953               and buf_clients.obj-code = buf_ext-artic.cli-code
     1954         .
     1955       end.
     1956       when 3
     1957       then do:
     1958         open query br-ext-artic
     1959           for each buf_ext-artic no-lock
     1960             where buf_ext-artic.gds-code  = p-gds-code
     1961               and buf_ext-artic.status_   = 'удал':U ,
     1962           each buf_clients no-lock
     1963             where buf_clients.obj-type = buf_ext-artic.cli-type
     1964               and buf_clients.obj-code = buf_ext-artic.cli-code
     1965         .
     1966       end.
     1967     end case.
     1968     if p-recid <> ? then do:
     1969       reposition br-ext-artic to recid p-recid no-error .
     1970     end.
     1971     apply "value-changed":U to br-ext-artic in frame Dialog-Frame.
     1972     run waitfram-hide in this-procedure .
     1973   end.
     1974   END PROCEDURE.
     1975   PROCEDURE proc-b-add :
     1976   do
     1977   on error undo, return error return-value
     1978   :
     1979     define variable v-recid as recid no-undo .
     1980   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1981   do:
     1982     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1983       (input  v-cntxt-db-num
     1984       ,input  v-cntxt-userid
     1985       ,input  0
     1986       ,input  'actn_ext-artic_add-def':U
     1987       ,input  'global':U
     1988       ,input  0
     1989       ,input  '':U
     1990       ,input  0
     1991       ,input  0
     1992       ,input  0
     1993       ,input  0
     1994       ,input  true
     1995       ,output g-log
     1996       )  .
     1997   end.
     1998     if not g-log then  return error .
     1999     run ref/ea-form.w ( input parParentProc
     2000                       , input 'ДОБАВЛЕНИЕ':U
     2001                       , input p-gds-code
     2002                       , input-output v-recid
     2003                       , input 0
     2004                       ) .
     2005     run open-br in this-procedure ( input v-recid ) .
     2006   end.
     2007   END PROCEDURE.
     2008   PROCEDURE proc-b-chg :
     2009   do
     2010   on error undo, return error return-value
     2011   :
     2012     define variable v-recid as recid    no-undo .
     2013   define variable vss-include-info17 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2014   do:
     2015     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2016       (input  v-cntxt-db-num
     2017       ,input  v-cntxt-userid
     2018       ,input  0
     2019       ,input  'actn_ext-artic_update':U
     2020       ,input  'global':U
     2021       ,input  0
     2022       ,input  '':U
     2023       ,input  0
     2024       ,input  0
     2025       ,input  0
     2026       ,input  0
     2027       ,input  true
     2028       ,output g-log
     2029       )  .
     2030   end.
     2031     if not g-log then  return error .
     2032     if not available buf_ext-artic then return .
     2033     if buf_ext-artic.status_ = 'удал':U
     2034     then do:
     2035       message
     2036         substitute("Нельзя редактировать запись в статусе '&1'" , 'удал':U)
     2037       view-as alert-box information.
     2038       return error.
     2039     end.
     2040     assign
     2041       v-recid = recid( buf_ext-artic )
     2042     .
     2043     run ref/ea-form.w ( input parParentProc
     2044                       , input 'ИЗМЕНЕНИЕ':U
     2045                       , input p-gds-code
     2046                       , input-output v-recid
     2047                       , input 0
     2048                       ) .
     2049     run open-br in this-procedure ( input v-recid ) .
     2050   end.
     2051   END PROCEDURE.
     2052   PROCEDURE proc-b-del :
     2053   do
     2054   on error undo, return error return-value
     2055   :
     2056     define buffer del_ext-artic for ub.ext-artic.
     2057     define variable v-recid   as recid      no-undo .
     2058     define variable v-next    as recid      no-undo .
     2059     define variable v-is-del  as logical    no-undo .
     2060   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2061   do:
     2062     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2063       (input  v-cntxt-db-num
     2064       ,input  v-cntxt-userid
     2065       ,input  0
     2066       ,input  'actn_ext-artic_deletion':U
     2067       ,input  'global':U
     2068       ,input  0
     2069       ,input  '':U
     2070       ,input  0
     2071       ,input  0
     2072       ,input  0
     2073       ,input  0
     2074       ,input  true
     2075       ,output g-log
     2076       )  .
     2077   end.
     2078     if not g-log then  return error .
     2079     if not available buf_ext-artic then return.
     2080     if buf_ext-artic.status_ <> 'удал':U
     2081     then do:
     2082       message
     2083         "Удалить запись?"
     2084       view-as alert-box question buttons yes-no update v-is-del.
     2085     end.
     2086     else do:
     2087       message
     2088         "Восстановить запись?"
     2089       view-as alert-box question buttons yes-no update v-is-del.
     2090     end.
     2091     if v-is-del = no then do:
     2092       return .
     2093     end.
     2094     find first del_ext-artic no-lock
     2095       where recid(del_ext-artic) = recid(buf_ext-artic)
     2096     .
     2097     assign
     2098       v-recid = recid(del_ext-artic)
     2099     .
     2100     run ref/extartd.p ( input del_ext-artic.cli-type
     2101                       , input del_ext-artic.cli-code
     2102                       , input del_ext-artic.gds-code
     2103                       , input if del_ext-artic.status_ = 'удал':U then 'тек':U else 'удал':U
     2104                       ) no-error .
     2105     if error-status :error then do:
     2106       message
     2107         return-value skip
     2108         error-status :get-message(1)
     2109       view-as alert-box error.
     2110       return error.
     2111     end.
     2112     run open-br in this-procedure ( input v-recid ) .
     2113   end.
     2114   END PROCEDURE.
     2115   PROCEDURE proc-b-lkp :
     2116   do
     2117   on error undo, return error return-value
     2118   :
     2119     define variable v-recid as recid    no-undo .
     2120     if not available buf_ext-artic then return .
     2121     assign
     2122       v-recid = recid( buf_ext-artic )
     2123     .
     2124     run ref/ea-form.w ( input parParentProc
     2125                       , input 'ПРОСМОТР':U
     2126                       , input p-gds-code
     2127                       , input-output v-recid
     2128                       , input 0
     2129                       ) .
     2130     run open-br in this-procedure ( input v-recid ) .
     2131   end.
     2132   END PROCEDURE.
     2133   PROCEDURE proc-br-ext-artic :
     2134   do
     2135   on error undo, return error return-value
     2136   :
     2137     if b-lkp :sensitive in frame Dialog-Frame then do:
     2138       run proc-b-lkp in this-procedure .
     2139     end.
     2140   end.
     2141   END PROCEDURE.
     2142   PROCEDURE proc-br-ext-artic-value-change :
     2143   do
     2144   on error undo, return error return-value
     2145   :
     2146     if available(buf_ext-artic)
     2147     then do:
     2148       if buf_ext-artic.status_ = 'удал':U
     2149       then do:
     2150         assign
     2151           b-del :label in frame Dialog-Frame = "В&осстанов":U
     2152         .
     2153       end.
     2154       else do:
     2155         assign
     2156           b-del :label in frame Dialog-Frame = "&Удалить":U
     2157         .
     2158       end.
     2159     end.
     2160   end.
     2161   END PROCEDURE.
     2162   PROCEDURE proc-rs-stts :
     2163   do
     2164   on error undo, return error return-value
     2165   :
     2166     assign frame Dialog-Frame
     2167       rs-stts
     2168     .
     2169     define variable v-recid as recid     no-undo .
     2170     if available buf_ext-artic
     2171     then do:
     2172       assign
     2173         v-recid = recid(buf_ext-artic)
     2174       .
     2175     end.
     2176     run open-br in this-procedure ( v-recid ) .
     2177   end.
     2178   END PROCEDURE.
