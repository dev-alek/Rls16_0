      440            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      441            ) = 0
      442   then do:
      443     message
      444       "$Workfile$"
      445       "Указанному интерфейсному элементу фокус не может быть передан" skip
      446       "Интерфейсный элемент" self :name  skip
      447       "Тип" self :type  skip
      448       "Процедура" this-procedure :file-name skip
      449       view-as alert-box .
      450   end.
      451   else do:
      452     apply "entry":u to self  .
      453     if focus :handle <> self :handle  then do:
      454       return no-apply .
      455     end.
      456   end.
      457     run proc-b-add in this-procedure no-error .
      458     if error-status :error then return no-apply.
