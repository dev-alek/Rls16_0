        1   block-level on error undo, throw.
        2   define input  parameter parparentproc  as handle no-undo .
        3   define input  parameter p-db-num  like ub.buyer-group.bgr-db-num no-undo .
        4   define input  parameter p-id      like ub.buyer-group.bgr-id  no-undo .
        5   define output parameter p-rec-id as recid no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: gr-buprb.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: ref/gr-buprb.p $":U .
       11   define variable vss-description as character no-undo init "Назначение покупателей из списка клиентов.".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   procedure proc-alt-shift-f2:
       73     if not ibs.th.gbl.gbl-var:rcode
       74   then
       75     run gbl\inidebug.p .
       76   end.
       77   procedure proc-alt-shift-f3:
       78     run gbl/prvssinf.p
       79       ( input this-procedure
       80       ) .
       81   end.
       82   define variable v-inform-launched as logical no-undo initial false .
       83   procedure proc-alt-shift-f4:
       84     define variable v-action as character no-undo .
       85     if v-inform-launched = false then do:
       86       assign
       87         v-inform-launched = true
       88       .
       89       run gbl/d-inform.w
       90         (  input self
       91         ,  input this-procedure
       92         , output v-action
       93         ) no-error .
       94       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       95       assign
       96         v-inform-launched = false
       97       .
       98     end.
       99   end.
      100   procedure proc-alt-f1:
      101     run gbl/corrhelp.p
      102       (input this-procedure
      103       ) .
      104   end .
      105   on alt-shift-f2 anywhere do:
      106     run proc-alt-shift-f2.
      107   end.
      108   on alt-shift-f3 anywhere do:
      109     run proc-alt-shift-f3 in this-procedure .
      110   end.
      111   on alt-shift-f4 anywhere do:
      112     run proc-alt-shift-f4 in this-procedure.
      113   end.
      114   on alt-f1 anywhere do:
      115     run proc-alt-f1 in this-procedure .
      116   end.
      117   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      118     define variable v-cntxt-db-num        as integer   no-undo .
      119     define variable v-cntxt-userid        as character no-undo .
      120     define variable v-cntxt-level         as character no-undo .
      121     define variable v-cntxt-host-code-obj as integer   no-undo .
      122     define variable v-cntxt-obj-type      as character no-undo .
      123     define variable v-cntxt-obj-code      as integer   no-undo .
      124     define variable v-cntxt-db-num-obj    as integer   no-undo .
      125     define variable v-cntxt-is-admin      as logical   no-undo .
      126   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      127     run mainmenu_getcntxt in parparentproc
      128       (output v-cntxt-db-num
      129       ,output v-cntxt-userid
      130       ,output v-cntxt-level
      131       ,output v-cntxt-host-code-obj
      132       ,output v-cntxt-obj-type
      133       ,output v-cntxt-obj-code
      134       ,output v-cntxt-db-num-obj
      135       ,output v-cntxt-is-admin
      136       ) .
      137   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      138   def new shared temp-table cli-list no-undo like ub.clients
      139     field to-del as logical
      140     index obj  is primary unique obj-type obj-code
      141     index cli-name      obj-name
      142     .
      143   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      144   define  new shared  temp-table cli-list-hist no-undo
      145   field list-table as character
      146   field id as integer
      147   field line as integer
      148   field hist-mode as character
      149   field des as character
      150   field num-recs as integer
      151   field option_ as character
      152   field item_ as character
      153   field status_ as character
      154   field num-add as integer
      155   field num-ignored as integer
      156   field done as logical
      157   field err_ as logical
      158   field err-mes as character
      159   index pi is primary
      160   id
      161   line
      162   index isdone
      163   done
      164   .
      165   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      166   define variable v-waitfram-action01         as character   no-undo .
      167   define variable v-waitfram-action02         as character   no-undo .
      168   define variable v-waitfram-action03         as character   no-undo .
      169   define variable mWaitFramTextBeg            as character   no-undo.
      170   define variable mWaitFramTextEnd            as character   no-undo.
      171   define variable mWaitFramView               as logical     no-undo.
      172   define variable mWaitProcEvent              as logical     no-undo init yes.
      173   define variable mWaitFramInterval           as integer     no-undo init 1 .
      174   define variable mWaitFramStop               as logical     no-undo.
      175   define variable mWaitFramStopUser           as logical     no-undo.
      176   define variable mWaitFramStopTimeOut        as logical     no-undo.
      177   define variable mWaitFramStartProc          as datetime-tz no-undo.
      178   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      179   define button B-WaitFramStop auto-end-key
      180        label "Стоп"
      181        size 10 by 1 tooltip "Остоновить процесс".
      182   define button B-viewProcInfo
      183        label "Информация"
      184        size 15 by 1 tooltip "Информация о процесс".
      185   define frame waitfram
      186     v-waitfram-action01 format "x(72)" no-label skip
      187     v-waitfram-action02 format "x(72)" no-label skip
      188     v-waitfram-action03 format "x(72)" no-label skip
      189     B-viewProcInfo
      190     B-WaitFramStop at row 4 col 30
      191     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      192     .
      193   define new global shared variable mBatchMode as logical no-undo init ?.
      194   define variable mFramBachModHandle as handle no-undo.
      195   mFramBachModHandle = frame waitfram:handle.
      196   define variable mFameOldVis as logical no-undo.
      197   define variable mVisCUrentVin as logical no-undo.
      198   if session:batch-mode
      199   then
      200      mBatchMode = yes.
      201   if mBatchMode = ? then do:
      202     mVisCUrentVin = current-window:visible.
      203     mFameOldVis = mFramBachModHandle:visible.
      204     mFramBachModHandle:visible  = yes.
      205     mBatchMode = mFramBachModHandle:visible ne yes.
      206     mFramBachModHandle:visible = mFameOldVis.
      207     current-window:visible = mVisCUrentVin.
      208   end.
      209    if  log-manager:logfile-name ne ?
      210     then DO:
      211         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      212         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      213         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      214     end.
      215   on choose of B-WaitFramStop in frame waitfram
      216   do:
      217     mWaitFramStop = yes.
      218     mWaitFramStopUser = yes.
      219   end.
      220   function waitfram-check-timeout returns logical():
      221      define variable vtime as int64 no-undo.
      222      if mWaitFramStopTimeOut
      223      then
      224         return yes.
      225      vtime = ( now - mWaitFramStartProc ) / 1000 .
      226      if     mWaitFramTimeOut ne ?
      227         and mWaitFramTimeOut ne 0
      228         and mWaitFramTimeOut lt vtime
      229      then do:
      230         mWaitFramStopTimeOut = yes.
      231      end.
      232      return mWaitFramStopTimeOut.
      233   end.
      234   procedure waitfram-hide :
      235     if not session:batch-mode
      236     then do
      237     on error undo, return error return-value
      238     :
      239       pause 0 before-hide .
      240       if not mBatchMode then
      241         hide frame waitfram .
      242     if     not mWaitFramView
      243        and mWaitProcEvent
      244     then
      245       process events .
      246     end.
      247   end procedure.
      248   procedure waitfram-show :
      249     define input  parameter p-message as character no-undo .
      250     define variable v-left-margin as integer   no-undo .
      251     if not session:batch-mode
      252     then do
      253     on error undo, return error return-value
      254     :
      255       if length(p-message) <= 70 then do:
      256         assign
      257           v-left-margin = integer((70 - length(p-message)) / 2)
      258         .
      259         assign
      260           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      261         .
      262         assign
      263           v-waitfram-action01 = " "
      264           v-waitfram-action02 = " "
      265                                    + fill(" ", v-left-margin)
      266                                    + p-message
      267           v-waitfram-action03 = " "
      268         .
      269       end.
      270       else do:
      271         define variable vRindex1 as integer no-undo.
      272         define variable vRindex2 as integer no-undo.
      273         vRindex1 = r-index(p-message," ",70).
      274         if vRindex1 = 0
      275         then
      276            vRindex1 = 70.
      277         if length(p-message)  <= vRindex1 + 70 then do:
      278           assign
      279             v-waitfram-action01 = " "
      280             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      281             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      282           .
      283         end.
      284         else do:
      285           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      286           if vRindex2 <= vRindex1
      287           then
      288              vRindex2 = vRindex1 + 70.
      289           assign
      290             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      291             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      292             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      293           .
      294         end.
      295       end.
      296       B-viewProcInfo:visible   in frame waitfram = no.
      297       B-viewProcInfo:sensitive in frame waitfram = no.
      298       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      299       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      300       if  (   mWaitFramView
      301          or  mWaitProcEvent)
      302          and not mBatchMode
      303       then
      304          display
      305             v-waitfram-action01 skip
      306             v-waitfram-action02 skip
      307             v-waitfram-action03 skip
      308          with frame waitfram .
      309       if     mWaitFramView
      310          then do:
      311             if     mWaitFramInterval ne ?
      312                and not mBatchMode
      313             then
      314                wait-for go of frame waitfram pause mWaitFramInterval.
      315          end.
      316          else
      317             if     mWaitProcEvent
      318                and not mBatchMode
      319             then
      320                process events .
      321     end.
      322   end procedure.
      323      procedure waitfram-show-this:
      324         define input  parameter iInterval as int64 no-undo.
      325         define variable vtime as int64 no-undo.
      326         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      327         mWaitFramInterval = iInterval.
      328         run waitfram-show (substitute("&1&2 &3&4" ,
      329                                       mWaitFramTextBeg ,
      330                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      331                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      332                                       mWaitFramTextEnd
      333                                      )
      334                           ).
      335      end.
      336      procedure WaitFramRunPause:
      337         define input  parameter iInterval as dec no-undo.
      338         define variable vStart  as datetime-tz no-undo.
      339         define variable vend    as datetime-tz no-undo.
      340         define variable vint as int64 no-undo.
      341         define variable vOk as logical no-undo.
      342         vStart = now.
      343         vend   = vStart.
      344         publish "WaitFramPause" (iInterval,output vOk).
      345         vend   =  now.
      346         vint = vend - vStart.
      347         vint = iInterval - vint / 1000.
      348         if     not mWaitFramStop
      349            and (   vint > 0
      350                 or (    not vOk
      351                     and iInterval eq ?
      352                     )
      353                 )
      354         then
      355            run waitfram-show-this (iInterval).
      356         vend   =  now.
      357         vint = vend - vStart.
      358         vint = iInterval - vint / 1000.
      359         if     not mWaitFramStop
      360            and vint > 0
      361         then do:
      362            run gbl/pause.p (vint * 1000).
      363         end.
      364         if iInterval ne ?
      365         then
      366            publish "WaitFramStop".
      367         waitfram-check-timeout().
      368      end.
      369      procedure WaitFramWaitFor:
      370         define input  parameter iInterval as dec no-undo.
      371         assign
      372            mWaitFramStartProc   = now
      373            mWaitFramStopUser    = no
      374            mWaitFramStopTimeOut = no
      375         .
      376         block-wait:
      377         do while not mWaitFramStop:
      378            run WaitFramRunPause (iInterval).
      379            if  waitfram-check-timeout()
      380            then do:
      381               leave block-wait.
      382            end.
      383         end.
      384         run waitfram-hide.
      385      end.
      386   procedure waitfram-join :
      387     define input  parameter p-line-1  as character no-undo .
      388     define input  parameter p-line-2  as character no-undo .
      389     define input  parameter p-line-3  as character no-undo .
      390     define output parameter p-message as character no-undo .
      391     do
      392     on error undo, return error return-value
      393     :
      394       assign
      395         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      396                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      397                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      398       .
      399     end.
      400   end procedure.
      401   function waitfram-join-function returns character
      402     (input p-line-1 as character
      403     ,input p-line-2 as character
      404     ,input p-line-3 as character
      405     ).
      406     define variable v-message as character no-undo .
      407     run waitfram-join in this-procedure
      408       (input  p-line-1
      409       ,input  p-line-2
      410       ,input  p-line-3
      411       ,output v-message
      412       ) .
      413     return v-message .
      414   end function .
      415   PROCEDURE BIB-ADD :
      416   define input  parameter p-db-num       as integer   no-undo .
      417   define input  parameter p-id           as integer   no-undo .
      418   define input  parameter p-obj-code     as integer   no-undo .
      419   define input  parameter p-obj-type     as character no-undo .
      420   define input  parameter p-stts         as integer   no-undo .
      421   define input  parameter p-db-num-usr   as integer   no-undo .
      422   define input  parameter p-userid       as character no-undo .
      423   define input-output parameter v-sec as integer   no-undo .
      424     do
      425     on error undo, return error return-value
      426     :
      427   if v-cntxt-db-num <> 0 then do :
      428      if p-db-num <> v-cntxt-db-num then do:
      429         message substitute(" Группа создана в другой БД (&1) , корректировать ее в текущей БД нельзя !" , p-db-num ) .
      430         return error substitute(" Группа создана в другой БД (&1) , корректировать ее нельзя !" , p-db-num).
      431      end.
      432   end.
      433   find first ub.buyer-in-buyer-group exclusive-lock where
      434           ub.buyer-in-buyer-group.bgr-db-num   = p-db-num  and
      435           ub.buyer-in-buyer-group.bgr-id       = p-id      and
      436           ub.buyer-in-buyer-group.bbg-obj-code = p-obj-code and
      437           ub.buyer-in-buyer-group.bbg-obj-type = p-obj-type no-error .
      438         if not available ub.buyer-in-buyer-group then do:
      439             create ub.buyer-in-buyer-group.
      440               assign
      441                   ub.buyer-in-buyer-group.bgr-db-num  = p-db-num
      442                   ub.buyer-in-buyer-group.bgr-id      = p-id
      443                   ub.buyer-in-buyer-group.bbg-obj-code = p-obj-code
      444                   ub.buyer-in-buyer-group.bbg-obj-type = p-obj-type
      445               .
      446         end.
      447         assign
      448           ub.buyer-in-buyer-group.db-num-chg    = p-db-num-usr
      449           ub.buyer-in-buyer-group.stts          = p-stts
      450           ub.buyer-in-buyer-group.sys-date      = today
      451           ub.buyer-in-buyer-group.sys-time      = time
      452           ub.buyer-in-buyer-group.sys-time-chr  = string(ub.buyer-in-buyer-group.sys-time,"hh:mm")
      453           ub.buyer-in-buyer-group.who           = p-userid
      454         .
      455         run ref/h-grbuy.p (buffer ub.buyer-in-buyer-group , input-output v-sec )  .
      456     end.
      457   end procedure.
      458   PROCEDURE BIB-DEL :
      459   define input  parameter p-db-num       as integer   no-undo .
      460   define input  parameter p-id           as integer   no-undo .
      461   define input  parameter p-obj-code     as integer   no-undo .
      462   define input  parameter p-obj-type     as character no-undo .
      463   define input  parameter p-db-num-usr   as integer   no-undo .
      464   define input  parameter p-userid       as character no-undo .
      465   define input-output parameter v-sec as integer   no-undo .
      466     do
      467     on error undo, return error return-value
      468     :
      469   if v-cntxt-db-num <> 0 then do :
      470      if p-db-num <> v-cntxt-db-num then do:
      471         message substitute(" Группа создана в другой БД (&1) , удалять покупателей в текущей БД нельзя !" , p-db-num ) .
      472         return error substitute(" Группа создана в другой БД (&1) , удалять покупателей нельзя !" , p-db-num).
      473      end.
      474   end.
      475   find first ub.buyer-in-buyer-group exclusive-lock where
      476           ub.buyer-in-buyer-group.bgr-db-num   = p-db-num  and
      477           ub.buyer-in-buyer-group.bgr-id       = p-id      and
      478           ub.buyer-in-buyer-group.bbg-obj-code = p-obj-code and
      479           ub.buyer-in-buyer-group.bbg-obj-type = p-obj-type no-error .
      480    if not available ub.buyer-in-buyer-group then  return error .
      481         assign
      482           ub.buyer-in-buyer-group.db-num-chg    = p-db-num-usr
      483           ub.buyer-in-buyer-group.stts          = 1
      484           ub.buyer-in-buyer-group.sys-date      = today
      485           ub.buyer-in-buyer-group.sys-time      = time
      486           ub.buyer-in-buyer-group.sys-time-chr  = string(ub.buyer-in-buyer-group.sys-time,"hh:mm")
      487           ub.buyer-in-buyer-group.who           = p-userid
      488         .
      489     run ref/h-grbuy.p (buffer ub.buyer-in-buyer-group , input-output v-sec )  .
      490     end.
      491   end procedure.
      492   define variable v-err as integer   no-undo  init 0.
      493   define variable v-sec as integer   no-undo .
      494   run str/cli-list.w
      495   ( input parparentproc ,
      496     input v-cntxt-host-code-obj ,
      497     input v-cntxt-obj-type ,
      498     input v-cntxt-obj-code
      499     ) .
      500     run waitfram-show ("Ждите...") .
      501     for each cli-list :
      502           run bib-add (
      503              input   p-db-num
      504             ,input   p-id
      505             ,input   cli-list.obj-code
      506             ,input   cli-list.obj-type
      507             ,input   0
      508             ,input   p-db-num
      509             ,input   v-cntxt-userid
      510             ,input-output   v-sec
      511              ) .
      512     end.
      513     run waitfram-hide .
      514   if v-err > 0 then message "Клиентов не добавлено : " v-err skip "Эти клиенты прикреплены к другим группам" view-as alert-box information .
