     4415   PROCEDURE proc-view-changes :
     4416   for each temp-changes:
     4417       delete temp-changes.
     4418   END.
     4419   if not available X_c-wth-obj then do:
     4420     Open QUery br-changes for each temp-changes.
     4421     return.
     4422   end.
     4423   define variable v-label-param as character no-undo .
     4424   v-label-param =
     4425     "host-code" + chr(4) + "Код фирмы" + chr(4) + "" + chr(8)
     4426    + "incass" + chr(4) + "Инкассировано" + chr(4) + "" + chr(8)
     4427    + "incass-bank" + chr(4) + "Инкассировано в банк" + chr(4) + "" + chr(8)
     4428    + "incass-cassa" + chr(4) + "Возврат по кассе" + chr(4) + "" + chr(8)
     4429    + "incass-other" + chr(4) + "Прочие инкассации" + chr(4) + "" + chr(8)
     4430    + "income" + chr(4) + "Получено" + chr(4) + "" + chr(8)
     4431    + "income-cassa" + chr(4) + "Выручка" + chr(4) + "" + chr(8)
     4432    + "income-other" + chr(4) + "Прочие поступления" + chr(4) + "" + chr(8)
     4433    + "obj-code" + chr(4) + "Код объекта" + chr(4) + "" + chr(8)
     4434    + "obj-type" + chr(4) + "Тип Объекта" + chr(4) + "" + chr(8)
     4435    + "wth-code" + chr(4) + "Код МЦ" + chr(4) + ""  .
     4436    run proc-full-temp-changes in this-procedure (
     4437                                                input  buffer X_c-wth-obj:handle
     4438                                               ,input  'wth-obj':U
     4439                                               ,input  "host-code,incass,incass-bank,incass-cassa,incass-other,income,income-cassa,income-other,obj-code,obj-type,wth-code"
     4440                                               ,input  v-label-param).
     4441   define variable c-stock-1 as decimal no-undo.
     4442   define variable c-stock-2 as decimal no-undo.
     4443   define buffer buf_c-wth-obj for ub.c-wth-obj.
     4444   RUN c-wth-lib_cur-stock-obj (
     4445                                buffer X_c-wth-obj
     4446                               ,output c-stock-1) no-error.
     4447   find first buf_c-wth-obj no-lock where
     4448             buf_c-wth-obj.obj-type =  X_c-wth-obj.obj-type
     4449         and buf_c-wth-obj.obj-code =  X_c-wth-obj.obj-code
     4450         and buf_c-wth-obj.wth-code =  X_c-wth-obj.wth-code
     4451         and buf_c-wth-obj.corr-user-db-num =  X_c-wth-obj.corr-user-db-num
     4452         and buf_c-wth-obj.chip-num > X_c-wth-obj.chip-num no-error.
     4453   if available buf_c-wth-obj then do:
     4454     RUN c-wth-lib_cur-stock-obj (
     4455                                 buffer buf_c-wth-obj
     4456                                 ,output c-stock-2) no-error.
     4457   end.
     4458   else do:
     4459     RUN wth-lib_cur-stock-obj (
     4460                                 input X_c-wth-obj.obj-type
     4461                                 ,input X_c-wth-obj.obj-code
     4462                                 ,input X_c-wth-obj.wth-code
     4463                                 ,output c-stock-2) no-error.
     4464   end.
     4465   create temp-changes.
     4466   assign
     4467   temp-changes.t_name = 'c-wth-obj':U
     4468   temp-changes.f_name = ""
     4469   temp-changes.l_name = "Остаток"
     4470   temp-changes.v_old  = string(c-stock-1)
     4471   temp-changes.v_new  = string(c-stock-2)
     4472   temp-changes.num_   = 0
     4473   .
     4474   release temp-changes.
     4475   Open QUery br-changes for each temp-changes.
     4476   END PROCEDURE.
     4477   FUNCTION get-action RETURNS CHARACTER
     4478     ( p-action as character ) :
     4479   define variable dops as character no-undo.
     4480   CASE p-action:
     4481      when 'close':U then do:
     4482         return "Закр.на факт".
     4483      end.
     4484      when 'delete':U then do:
     4485         return "Удаление".
     4486      end.
     4487   END CASE.
     4488   RETURN dops.
     4489   END FUNCTION.
     4490   FUNCTION get-source-type RETURNS CHARACTER
     4491     ( p-source-type as character ) :
     4492   define variable v-dop as character no-undo .
     4493   assign
     4494   v-dop =  entry (lookup (p-source-type, ',db,esys,trn-doc,payment,fin-doc,import,recalc,wth-doc,ren-gdsc,upgrade,grp-chg,stop-list,dis-card':U), ',БД,ВС,Документ,Платеж,Фин.док.,Импорт,Пересчет,Документ МЦ,Коллизия,Апгрейд,Изм.группы,Стоплист,ДК':U) no-error
     4495   .
     4496     RETURN v-dop .
     4497   END FUNCTION.
     4498   FUNCTION get-wealth RETURNS CHARACTER
     4499     ( p-obj-type as character, p-obj-code as integer, p-wth-code as integer ) :
     4500   define buffer buf_wealth for ub.wealth.
     4501   find first buf_wealth no-lock where
     4502        buf_wealth.wth-code = p-wth-code no-error.
     4503   if not available buf_wealth then do:
     4504       return "!!! Неизвестная МЦ!!!".
     4505   end.
     4506     RETURN buf_wealth.wth-name.
     4507   END FUNCTION.
