     1090   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input parameter parw-p-code   like ub.wth-line.w-p-code     no-undo.                        define input parameter parshift-date like ub.shift-obj.shift-date  no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                        cur_wth-line.w-p-code   = parw-p-code and                                                               cur_wth-line.wth-code   = parwth-code   and                                        cur_wth-line.shift-date = parshift-date   and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-sd-pl no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                start_wth-line.w-p-code = parw-p-code and                                                             start_wth-line.wth-code   = parwth-code         and                                start_wth-line.shift-date < parshift-date and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-sd-pl no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income-pl - cur_wth-line.incass-pl              parincome        = cur_wth-line.income-pl                     parincome-cassa  = cur_wth-line.income-cassa-pl               parincome-other  = cur_wth-line.income-other-pl               parincass        = cur_wth-line.incass-pl                     parincass-bank   = cur_wth-line.incass-bank-pl                parincass-other  = cur_wth-line.incass-other-pl.              parincass-cassa  = cur_wth-line.incass-cassa-pl.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income-pl     - start_wth-line.incass-pl               parstock-end     = cur_wth-line.income-pl       - cur_wth-line.incass-pl                 parincome        = cur_wth-line.income-pl       - start_wth-line.income-pl               parincome-cassa  = cur_wth-line.income-cassa-pl - start_wth-line.income-cassa-pl         parincome-other  = cur_wth-line.income-other-pl - start_wth-line.income-other-pl         parincass        = cur_wth-line.incass-pl       - start_wth-line.incass-pl               parincass-bank   = cur_wth-line.incass-bank-pl  - start_wth-line.incass-bank-pl          parincass-other  = cur_wth-line.incass-other-pl - start_wth-line.incass-other-pl.        parincass-cassa  = cur_wth-line.incass-cassa-pl - start_wth-line.incass-cassa-pl.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income-pl - start_wth-line.incass-pl                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
     1091   end procedure.
     1092   procedure wth-lib_full-inf-calend-date:
     1093   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input  parameter parfact-date    like ub.wth-line.fact-date    no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                                                                                       cur_wth-line.wth-code   = parwth-code   and                                        cur_wth-line.fact-date  = parfact-date  and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-cld no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                                                                             start_wth-line.wth-code   = parwth-code         and                                start_wth-line.fact-date  < parfact-date   and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-cld no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income - cur_wth-line.incass              parincome        = cur_wth-line.income                     parincome-cassa  = cur_wth-line.income-cassa               parincome-other  = cur_wth-line.income-other               parincass        = cur_wth-line.incass                     parincass-bank   = cur_wth-line.incass-bank                parincass-other  = cur_wth-line.incass-other.              parincass-cassa  = cur_wth-line.incass-cassa.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income     - start_wth-line.incass               parstock-end     = cur_wth-line.income       - cur_wth-line.incass                 parincome        = cur_wth-line.income       - start_wth-line.income               parincome-cassa  = cur_wth-line.income-cassa - start_wth-line.income-cassa         parincome-other  = cur_wth-line.income-other - start_wth-line.income-other         parincass        = cur_wth-line.incass       - start_wth-line.incass               parincass-bank   = cur_wth-line.incass-bank  - start_wth-line.incass-bank          parincass-other  = cur_wth-line.incass-other - start_wth-line.incass-other.        parincass-cassa  = cur_wth-line.incass-cassa - start_wth-line.incass-cassa.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income - start_wth-line.incass                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
     1094   end procedure.
     1095   procedure wth-lib_full-inf-calend-date-place:
     1096   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input parameter parw-p-code  like ub.wth-line.w-p-code  no-undo.                        define input parameter parfact-date like ub.wth-line.fact-date no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                        cur_wth-line.w-p-code   = parw-p-code and                                                               cur_wth-line.wth-code   = parwth-code   and                                        cur_wth-line.fact-date  = parfact-date  and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-cld-pl no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                start_wth-line.w-p-code = parw-p-code and                                                             start_wth-line.wth-code   = parwth-code         and                                start_wth-line.fact-date  < parfact-date   and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-cld-pl no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income-pl - cur_wth-line.incass-pl              parincome        = cur_wth-line.income-pl                     parincome-cassa  = cur_wth-line.income-cassa-pl               parincome-other  = cur_wth-line.income-other-pl               parincass        = cur_wth-line.incass-pl                     parincass-bank   = cur_wth-line.incass-bank-pl                parincass-other  = cur_wth-line.incass-other-pl.              parincass-cassa  = cur_wth-line.incass-cassa-pl.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income-pl     - start_wth-line.incass-pl               parstock-end     = cur_wth-line.income-pl       - cur_wth-line.incass-pl                 parincome        = cur_wth-line.income-pl       - start_wth-line.income-pl               parincome-cassa  = cur_wth-line.income-cassa-pl - start_wth-line.income-cassa-pl         parincome-other  = cur_wth-line.income-other-pl - start_wth-line.income-other-pl         parincass        = cur_wth-line.incass-pl       - start_wth-line.incass-pl               parincass-bank   = cur_wth-line.incass-bank-pl  - start_wth-line.incass-bank-pl          parincass-other  = cur_wth-line.incass-other-pl - start_wth-line.incass-other-pl.        parincass-cassa  = cur_wth-line.incass-cassa-pl - start_wth-line.incass-cassa-pl.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income-pl - start_wth-line.incass-pl                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
     1097   end procedure.
     1098   FUNCTION get-curr RETURNS CHARACTER
     1099     (buffer loc-wealth for ub.wealth ) :
     1100   define buffer buf_currency for ub.currency.
     1101   if loc-wealth.curr-code = ? or loc-wealth.is-money = no then
     1102   return loc-wealth.unit-base.
     1103   FIND FIRST buf_currency no-lock where
     1104             buf_currency.curr-code = loc-wealth.curr-code No-ERROR.
     1105   if avail buf_currency then
     1106     RETURN buf_currency.curr-abbr.
     1107   else return "".
     1108   END FUNCTION.
     1109   define variable filter-label as character no-undo init "История остатков МЦ" .
     1110   define variable filter-label0 as character no-undo init "История остатков МЦ" .
     1111   define variable filter-point0 as character no-undo init "cwthobj" .
     1112   define variable filter-point as character no-undo init "cwthobj" .
     1113   define variable sort-column-name as character no-undo .
     1114   define variable print-option as character no-undo.
     1115   DEFINE VARIABLE v-db-num like ub.db.db-num no-undo .
     1116   define variable v-doc-rec as recid no-undo .
     1117   define variable v-find as logical no-undo.
     1118   define variable v-wth-name like ub.wealth.wth-name no-undo.
     1119   define variable v-start-date-chr as character no-undo .
     1120   define variable v-end-date-chr as character no-undo .
     1121   define variable v-host-code like ub.sysconf.host-code no-undo .
     1122   define variable v-rid-list as character no-undo .
     1123   define variable dops as character no-undo format "X(250)".
     1124   define variable dopst as character no-undo format "X(1)".
     1125   define buffer X_curr_sysconf for ub.sysconf.
     1126   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1127   define  temp-table temp-changes no-undo
     1128   field f_name as character
     1129   field l_name as character
     1130   field v_old as character
     1131   field v_new as character
     1132   field t_name as character
     1133   field num_ as integer
     1134   field uniq-key-rec as character
     1135   field action as integer
     1136   field fNotChange as logical
     1137   index pi is unique primary
     1138   num_
     1139   t_name
     1140   f_name
     1141   index
     1142   Chan
     1143   fnotChange
     1144   t_name
     1145   f_name
     1146   index imain uniq-key-rec
     1147   .
     1148   FUNCTION get-all-fields returns character (p-file-name as character ):
     1149   define variable v-dop as character no-undo .
     1150     find first _file no-lock where _file._file-name = p-file-name no-error .
     1151     if not available _file then return "":U.
     1152     for each _field no-lock where
     1153              _field._file-recid = recid(_file) :
     1154       assign
     1155       v-dop = v-dop + _field._field-name + chr(44)
     1156       .
     1157     end.
     1158     return trim(v-dop).
     1159   END FUNCTION.
     1160   PROCEDURE proc-full-temp-changes :
     1161     define input  parameter p-hst-handle as handle    no-undo .
     1162     define input  parameter p-main-table as character no-undo .
     1163     define input  parameter p-field-list as character no-undo .
     1164     define input  parameter p-label-form as character no-undo .
     1165     define variable h-new-buf         as handle    no-undo .
     1166     define variable h-main-buf        as handle    no-undo .
     1167     define variable h-for-comp        as handle    no-undo .
     1168     define variable v-inform          as character no-undo .
     1169     define variable v-ind             as integer   no-undo .
     1170     define variable v-idx-field-qnty  as integer   no-undo .
     1171     define variable v-num-entries     as integer   no-undo .
     1172     define variable fh                as handle    no-undo .
     1173     define variable fh-main           as handle    no-undo .
     1174     define variable fh-old            as handle    no-undo .
     1175     define variable fh-new            as handle    no-undo .
     1176     define variable v-field-name      as character no-undo .
     1177     define variable v-field-lvl       as character no-undo .
     1178     define variable v-field-form      as character no-undo .
     1179     define variable v-search-exp      as character no-undo .
     1180     define variable v-srch-main       as character no-undo .
     1181     define variable v-word-link       as character no-undo .
     1182     define variable v-av-chip-num     as logical   no-undo .
     1183     define variable v-main-pi-fld-lst as character no-undo .
     1184     define variable v-main-fld-lst    as character no-undo .
     1185     define variable v-delim-list      as character no-undo .
     1186     define variable v-label           as character no-undo .
     1187     define variable v-old-value       as character no-undo case-sensitive.
     1188     define variable v-new-value       as character no-undo case-sensitive.
     1189     define variable v-chg-fields as character no-undo.
     1190     for each temp-changes:
     1191       delete temp-changes.
     1192     end.
     1193     if not p-hst-handle:available then do:
     1194       return .
     1195     end.
     1196     create buffer h-new-buf  for table p-hst-handle .
     1197     create buffer h-main-buf for table p-main-table .
     1198     assign
     1199       v-inform = h-main-buf:index-information(1)
     1200       v-ind    = 2
     1201     .
     1202     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1203     on error undo, return error
     1204     :
     1205       assign
     1206         v-inform = h-main-buf:index-information( v-ind )
     1207         v-ind    = v-ind + 1
     1208       .
     1209     end.
     1210     if v-inform = ?
     1211       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1212       or entry( 3, v-inform, ",":U ) <> "1":U
     1213     then do:
     1214       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1215     end.
     1216     assign
     1217       v-idx-field-qnty = num-entries( v-inform ) - 4
     1218     .
     1219     if v-idx-field-qnty < 2 then do:
     1220       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1221     end.
     1222     assign
     1223       v-srch-main   = "where":U
     1224       v-word-link   = "":U
     1225       v-av-chip-num = false
     1226       v-delim-list  = "":U
     1227     .
     1228     do v-ind = 1 to v-idx-field-qnty by 2
     1229     on error undo, return error
     1230     :
     1231       assign
     1232         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1233         fh                = p-hst-handle:buffer-field( v-field-name )
     1234         fh-main           = h-main-buf:buffer-field( v-field-name )
     1235         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1236         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1237       .
     1238       if fh:data-type ="character":U then do:
     1239         assign
     1240           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1241         .
     1242       end.
     1243       else do:
     1244         assign
     1245           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1246         .
     1247       end.
     1248       if v-delim-list = "":U then do:
     1249         assign
     1250           v-delim-list = ",":U
     1251         .
     1252       end.
     1253       if v-word-link = "":U then do:
     1254         assign
     1255           v-word-link = "and":U
     1256         .
     1257       end.
     1258     end.
     1259     assign
     1260       v-delim-list  = "":U
     1261     .
     1262     do v-ind = 1 to h-main-buf:num-fields
     1263     on error undo, return error
     1264     :
     1265       assign
     1266         fh-main      = h-main-buf:buffer-field( v-ind )
     1267         v-field-name = fh-main:name
     1268       .
     1269         assign
     1270           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1271         .
     1272         if v-delim-list = "":U then do:
     1273           assign
     1274             v-delim-list = ",":U
     1275           .
     1276         end.
     1277     end.
     1278     assign
     1279       v-inform = p-hst-handle:index-information(1)
     1280       v-ind    = 2
     1281     .
     1282     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1283     on error undo, return error
     1284     :
     1285       assign
     1286         v-inform = p-hst-handle:index-information( v-ind )
     1287         v-ind    = v-ind + 1
     1288       .
     1289     end.
     1290     if v-inform = ?
     1291       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1292       or entry( 3, v-inform, ",":U ) <> "1":U
     1293     then do:
     1294       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1295     end.
     1296     assign
     1297       v-idx-field-qnty = num-entries( v-inform ) - 4
     1298     .
     1299     if v-idx-field-qnty < 2 then do:
     1300       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1301     end.
     1302     assign
     1303       v-search-exp  = "where":U
     1304       v-word-link   = "":U
     1305       v-av-chip-num = false
     1306     .
     1307     do v-ind = 1 to v-idx-field-qnty by 2
     1308     on error undo, return error
     1309     :
     1310       assign
     1311         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1312         fh           = p-hst-handle:buffer-field( v-field-name )
     1313         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1314       .
     1315       if v-field-name = "chip-num":U then do:
     1316         assign
     1317           v-search-exp  = substitute( "&1 >", v-search-exp )
     1318           v-av-chip-num = true
     1319         .
     1320       end.
     1321       else do:
     1322         assign
     1323           v-search-exp = substitute( "&1 =", v-search-exp )
     1324         .
     1325       end.
     1326       if fh:data-type ="character":U then do:
     1327         assign
     1328           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1329         .
     1330       end.
     1331       else do:
     1332         assign
     1333           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1334         .
     1335       end.
     1336       if v-word-link = "":U then do:
     1337         assign
     1338           v-word-link = "and":U
     1339         .
     1340       end.
     1341     end.
     1342     if v-av-chip-num = false then do:
     1343       message
     1344         vss-workfile vss-revision vss-description skip
     1345         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1346         "Использование данной процедуры невозможно!" skip
     1347         view-as alert-box error .
     1348       return error .
     1349     end.
     1350     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1351     if not h-new-buf:available then do:
     1352       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1353       if not h-main-buf:available then do:
     1354         assign
     1355           h-for-comp = ?
     1356         .
     1357       end.
     1358       else do:
     1359         assign
     1360           h-for-comp = h-main-buf
     1361         .
     1362       end.
     1363     end.
     1364     else do:
     1365       assign
     1366         h-for-comp = h-new-buf
     1367       .
     1368     end.
     1369     assign
     1370       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1371     .
     1372     do v-ind = 1 to v-num-entries
     1373     on error undo, return error return-value
     1374     :
     1375       assign
     1376         v-field-name = entry( v-ind, v-main-fld-lst )
     1377         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1378         v-old-value  = fh-old:buffer-value()
     1379         v-label      = trim( fh-old:label )
     1380       .
     1381       if ( trim( p-field-list ) <> "":U
     1382            and lookup( v-field-name, p-field-list ) > 0
     1383          )
     1384          or trim( p-field-list ) = "":U
     1385       then do:
     1386         if h-for-comp <> ? then do:
     1387           assign
     1388             fh-new      = h-for-comp:buffer-field( v-field-name )
     1389             v-new-value = fh-new:buffer-value()
     1390           .
     1391         end.
     1392         else do:
     1393           assign
     1394             v-new-value = "":U
     1395           .
     1396         end.
     1397         if v-old-value <> v-new-value
     1398         then do:
     1399           create temp-changes.
     1400           assign
     1401             temp-changes.t_name = p-main-table
     1402             temp-changes.f_name = v-field-name
     1403             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1404             temp-changes.v_old  = trim( v-old-value )
     1405             temp-changes.v_new  = trim( v-new-value )
     1406             temp-changes.num_   = 0
     1407             temp-changes.fNotChange = v-old-value eq v-new-value
     1408           .
     1409         end.
     1410       end.
     1411     end.
     1412     assign
     1413       v-num-entries = num-entries( p-label-form, chr(8) )
     1414     .
     1415     do v-ind = 1 to v-num-entries
     1416     on error undo, return error return-value
     1417     :
     1418       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1419         assign
     1420           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1421           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1422           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1423         .
     1424         find first temp-changes
     1425           where temp-changes.f_name = v-field-name
     1426           no-error .
     1427         if available temp-changes then do:
     1428           if trim( v-field-lvl ) <> "":U then do:
     1429             assign
     1430               temp-changes.l_name = v-field-lvl
     1431             .
     1432           end.
     1433           if trim( v-field-form ) <> "":U then do:
     1434             assign
     1435               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1436             .
     1437             if h-for-comp <> ? then do:
     1438               assign
     1439                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1440               .
     1441             end.
     1442           end.
     1443         end.
     1444       end.
     1445       else do:
     1446         message
     1447           vss-workfile vss-revision vss-description skip
     1448           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1449           substitute( "список для поля '&1': '&2'"
     1450                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1451                       ,entry( v-ind, p-label-form, chr(8) )
     1452                     ) skip
     1453           substitute( "полный список: &2", p-label-form ) skip
     1454           view-as alert-box error .
     1455       end.
     1456     end.
     1457     delete object h-new-buf .
     1458     delete object h-main-buf .
     1459   END PROCEDURE.
     1460   FUNCTION get-action RETURNS CHARACTER
     1461     ( p-action as character )  FORWARD.
     1462   FUNCTION get-source-type RETURNS CHARACTER
     1463     ( p-source-type as character )  FORWARD.
     1464   FUNCTION get-wealth RETURNS CHARACTER
     1465     ( p-obj-type as character, p-obj-code as integer, p-wth-code as integer )  FORWARD.
     1466   DEFINE BUTTON B-Help
     1467        LABEL "Помо&щь"
     1468        SIZE 3 BY 1
     1469        BGCOLOR 8 .
     1470   DEFINE BUTTON B-lookup
     1471        LABEL "&Документ"
     1472        SIZE 10 BY 1.
     1473   DEFINE BUTTON B-mark
     1474        LABEL "&*"
     1475        SIZE 3 BY 1.
     1476   DEFINE BUTTON B-print
     1477        LABEL "Пе&чать"
     1478        SIZE 3 BY 1.
     1479   DEFINE BUTTON b-quit AUTO-END-KEY
     1480        LABEL "&Выход"
     1481        SIZE 10 BY 1
     1482        BGCOLOR 8 .
     1483   DEFINE BUTTON B-sch
     1484        LABEL "&Фильтр"
     1485        SIZE 3 BY 1.
     1486   DEFINE BUTTON b-sel AUTO-GO
     1487        LABEL "Вы&бор"
     1488        SIZE 10 BY 1
     1489        BGCOLOR 8 .
     1490   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1491         VIEW-AS TEXT
     1492        SIZE 6 BY 1
     1493        FGCOLOR 4  NO-UNDO.
     1494   DEFINE VARIABLE sch-corr-date AS DATE FORMAT "99/99/9999":U
     1495        LABEL "Дате изм."
     1496        VIEW-AS FILL-IN
     1497        SIZE 11 BY 1 NO-UNDO.
     1498   DEFINE VARIABLE sch-corr-user-name AS CHARACTER FORMAT "X(9)":U
     1499        LABEL "пользователю"
     1500        VIEW-AS FILL-IN
     1501        SIZE 12 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1502   DEFINE VARIABLE sch-source-ref AS CHARACTER FORMAT "X(9)":U
     1503        LABEL "док-ту"
     1504        VIEW-AS FILL-IN
     1505        SIZE 13 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1506   DEFINE VARIABLE sch-wth-code AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1507        LABEL "коду МЦ"
     1508        VIEW-AS FILL-IN
     1509        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1510   DEFINE QUERY BR-changes FOR
     1511         temp-changes SCROLLING.
     1512   DEFINE QUERY br-cwthobj FOR
     1513         X_c-wth-obj SCROLLING.
     1514   DEFINE BROWSE BR-changes
     1515     QUERY BR-changes DISPLAY
     1516         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1517   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1518   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1519       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.25.
     1520   DEFINE BROWSE br-cwthobj
     1521     QUERY br-cwthobj NO-LOCK DISPLAY
     1522         mark-string(recid(X_c-wth-obj), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1523         X_c-wth-obj.wth-code COLUMN-LABEL "Код МЦ" FORMAT ">>>>>>>>9":U
     1524         X_c-wth-obj.corr-date FORMAT "99/99/9999":U
     1525         string(X_c-wth-obj.corr-time, "HH:MM:SS":U) COLUMN-LABEL "Время изм." FORMAT "X(8)":U
     1526         usrfulnf(X_c-wth-obj.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1527         get-action(X_c-wth-obj.action-type) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1528         X_c-wth-obj.corr-user-db-num FORMAT ">>>>9":U
     1529         get-source-type(X_c-wth-obj.source-type) COLUMN-LABEL "Источн.!измен."
     1530         X_c-wth-obj.source-ref FORMAT "X(14)":U
     1531         if v-find then get-wealth(X_c-wth-obj.obj-type, X_c-wth-obj.obj-code, X_c-wth-obj.wth-code) else "":U COLUMN-LABEL "Назв. МЦ" FORMAT "X(25)":U
     1532         X_c-wth-obj.obj-type + string(X_c-wth-obj.obj-code) COLUMN-LABEL "Объект" FORMAT "X(8)":U
     1533     ENABLE
     1534         X_c-wth-obj.corr-date
     1535       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.46.
     1536   DEFINE FRAME Dialog-Frame
     1537        b-quit AT ROW 1 COL 1
     1538        B-mark AT ROW 1 COL 11
     1539        b-sel AT ROW 1 COL 21
     1540        B-print AT ROW 1 COL 89
     1541        B-sch AT ROW 1 COL 92
     1542        B-Help AT ROW 1 COL 95
     1543        B-lookup AT ROW 1.04 COL 45
     1544        br-cwthobj AT ROW 2 COL 1
     1545        sch-wth-code AT ROW 13.67 COL 45 COLON-ALIGNED
     1546        sch-corr-date AT ROW 13.67 COL 64.5 COLON-ALIGNED
     1547        sch-source-ref AT ROW 13.67 COL 84 COLON-ALIGNED
     1548        sch-corr-user-name AT ROW 13.71 COL 22.5 COLON-ALIGNED
     1549        BR-changes AT ROW 14.79 COL 1
     1550        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1551        "ПОИСК ПО" VIEW-AS TEXT
     1552             SIZE 8.38 BY 1 AT ROW 13.63 COL 1.38
     1553             FGCOLOR 4
     1554        SPACE(89.48) SKIP(7.44)
     1555       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1556            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1557            TITLE "История остатков МЦ"
     1558            CANCEL-BUTTON b-quit.
     1559   ASSIGN
     1560          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1561          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1562   ON GO OF FRAME Dialog-Frame
     1563   DO:
     1564     p-rid-list = v-rid-list.
     1565   END.
     1566   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1567   DO:
     1568     APPLY "END-ERROR":U TO SELF.
     1569   END.
     1570   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
     1571   DO:
     1572   define buffer buf_wth-doc for ub.wth-doc.
     1573   define buffer buf_C-wth-doc for ub.C-wth-doc.
     1574   if not available X_c-wth-obj then return no-apply.
     1575   IF X_c-wth-obj.source-type = 'wth-doc':U then do:
     1576     find first buf_wth-doc no-lock where
     1577           buf_wth-doc.doc-code =  X_c-wth-obj.source-ref no-error.
     1578     if not available buf_wth-doc then do:
     1579       for each  buf_C-wth-doc no-lock where
     1580             buf_c-wth-doc.doc-code =  X_c-wth-obj.source-ref
     1581         AND buf_c-wth-doc.is-del =  yes:
     1582                   run str/wthcdlkp.p (
     1583                         input parparentproc
     1584                        ,input recid(buf_C-wth-doc)) no-error .
     1585          LEAVE.
     1586       end.
     1587       if not available buf_c-wth-doc then do:
     1588         message
     1589         substitute("Не найден документ с № &1", X_c-wth-obj.source-ref)
     1590         view-as alert-box error .
     1591         return no-apply.
     1592       end.
     1593     END.
     1594     else do:
     1595       run str/wthd-lkp.p (
     1596                       input parparentproc
     1597                     ,input recid(buf_wth-doc)) no-error .
     1598     end.
     1599   end.
     1600   END.
     1601   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1602   DO:
     1603   define variable loc#log as logical no-undo .
     1604     if available X_c-wth-obj then do:
     1605   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1606   define variable v-str-recid15 as character no-undo .
     1607   define variable v-num-entry15 as integer   no-undo .
     1608   assign
     1609     v-str-recid15 = trim( string( recid( X_c-wth-obj ) , "->>>>>>>>>>>9":U ) )
     1610     v-num-entry15 = lookup( v-str-recid15 , v-rid-list )
     1611   .
     1612   if v-num-entry15 > 0 then do:
     1613     assign
     1614       entry( v-num-entry15, v-rid-list ) = "":U
     1615       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1616     .
     1617   end.
     1618   else do:
     1619     assign
     1620       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid15
     1621     .
     1622   end.
     1623       loc#log = br-cwthobj:refresh() .
     1624       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1625           loc#log = br-cwthobj:select-next-row ().
     1626           apply "VALUE-CHANGED" to br-cwthobj in frame Dialog-Frame.
     1627       end.
     1628       if num-entries( v-rid-list ) = 0
     1629       then
     1630           hide mark-num in frame Dialog-Frame.
     1631       else
     1632           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1633     end.
     1634     apply "entry" to br-cwthobj in frame Dialog-Frame.
     1635   END.
     1636   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1637   DO:
     1638       run proc-b-print in this-procedure no-error.
     1639     if error-status:error then return no-apply.
     1640   END.
     1641   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1642   DO:
     1643       run proc-b-sch in this-procedure no-error.
     1644     if error-status:error then return no-apply.
     1645   END.
     1646   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1647   DO:
     1648     if ( available X_c-wth-obj ) then do:
     1649       if ( v-rid-list = "" ) or b-mark:sensitive = no
     1650       then
     1651       v-rid-list = string( recid( X_c-wth-obj ) ) .
     1652     end.
     1653   END.
     1654   ON MOUSE-SELECT-DBLCLICK OF br-cwthobj IN FRAME Dialog-Frame
     1655   DO:
     1656        run proc-br-cwthobj in this-procedure no-error.
     1657     if error-status:error then return no-apply.
     1658   END.
     1659   ON RETURN OF br-cwthobj IN FRAME Dialog-Frame
     1660   DO:
     1661       run proc-br-cwthobj in this-procedure no-error.
     1662     if error-status:error then return no-apply.
     1663   END.
     1664   ON VALUE-CHANGED OF br-cwthobj IN FRAME Dialog-Frame
     1665   DO:
     1666     run proc-view-changes in this-procedure no-error.
     1667   END.
     1668   ON CTRL-J OF sch-corr-date IN FRAME Dialog-Frame
     1669   DO:
     1670      run proc-find-corr-date in this-procedure(yes, input frame Dialog-Frame sch-corr-date) no-error.
     1671     if error-status:error then return no-apply.
     1672   END.
     1673   ON RETURN OF sch-corr-date IN FRAME Dialog-Frame
     1674   DO:
     1675     run proc-find-corr-date in this-procedure(no, input frame Dialog-Frame sch-corr-date) no-error.
     1676     if error-status:error then return no-apply.
     1677   END.
     1678   ON CTRL-J OF sch-corr-user-name IN FRAME Dialog-Frame
     1679   DO:
     1680     run proc-find-user in this-procedure(yes, input frame Dialog-Frame sch-corr-user-name) no-error.
     1681     if error-status:error then return no-apply.
     1682   END.
     1683   ON RETURN OF sch-corr-user-name IN FRAME Dialog-Frame
     1684   DO:
     1685     run proc-find-user in this-procedure(no, input frame Dialog-Frame sch-corr-user-name) no-error.
     1686     if error-status:error then return no-apply.
     1687   END.
     1688   ON CTRL-J OF sch-source-ref IN FRAME Dialog-Frame
     1689   DO:
     1690     run proc-find-source-ref in this-procedure(yes, input frame Dialog-Frame sch-source-ref) no-error.
     1691     if error-status:error then return no-apply.
     1692   END.
     1693   ON RETURN OF sch-source-ref IN FRAME Dialog-Frame
     1694   DO:
     1695     run proc-find-source-ref in this-procedure(no, input frame Dialog-Frame sch-source-ref) no-error.
     1696     if error-status:error then return no-apply.
     1697   END.
     1698   ON CTRL-J OF sch-wth-code IN FRAME Dialog-Frame
     1699   DO:
     1700     run proc-find-wth-code in this-procedure(yes, input frame Dialog-Frame sch-wth-code) no-error.
     1701     if error-status:error then return no-apply.
     1702   END.
     1703   ON RETURN OF sch-wth-code IN FRAME Dialog-Frame
     1704   DO:
     1705     run proc-find-wth-code in this-procedure(no, input frame Dialog-Frame sch-wth-code) no-error.
     1706     if error-status:error then return no-apply.
     1707   END.
     1708   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1709   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1710   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1711   on help of frame Dialog-Frame
     1712   do:
     1713     run gbl/app_help.p
     1714       (input this-procedure :file-name
     1715       ,input ''
     1716       ,input ?
     1717       ) no-error.
     1718     if error-status :error then do:
     1719       message
     1720         "Ошибка при вызове помощи"
     1721         error-status :get-message(1)
     1722         view-as alert-box .
     1723     end.
     1724   end.
     1725   run minbtn-set in this-procedure .
     1726   on choose of b-help in frame Dialog-Frame
     1727   do:
     1728     apply "help":u to frame Dialog-Frame .
     1729   end.
     1730   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1731   procedure minbtn-set :
     1732       do
     1733           on error undo, return error return-value
     1734           :
     1735           define variable ii              as integer       no-undo .
     1736           define variable fh              as widget-handle no-undo .
     1737           define variable hh              as widget-handle no-undo .
     1738           define variable v-h             as handle        extent 4 no-undo .
     1739           define variable v-name-button   as character     no-undo .
     1740           define variable v-help-old-x    as decimal       no-undo .
     1741           define variable v-help-old-y    as decimal       no-undo .
     1742           define variable v-help-old-size as decimal       no-undo .
     1743           define variable v-frame-width   as decimal       no-undo .
     1744           define variable jj              as integer       no-undo .
     1745           do
     1746               on error undo, return error
     1747               :
     1748               assign
     1749                   v-frame-width = frame Dialog-Frame:width - 0.3
     1750                   fh            = frame Dialog-Frame:first-child
     1751                   hh            = fh:first-child
     1752                   ii            = 1
     1753                   .
     1754               do while valid-handle(hh):
     1755                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1756                   do:
     1757                       case lc(hh:name) :
     1758                           when "b-help" then
     1759                               do:
     1760                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1761                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1762                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1763                                   hh:TOOLTIP = "Помощь" .
     1764                                   v-help-old-x = hh:column .
     1765                                   v-help-old-y = hh:row    .
     1766                                   v-help-old-size = hh:width .
     1767                                   hh:width-chars = 2.5 .
     1768                               end.
     1769                           when "b-print" then
     1770                               do:
     1771                                   hh:load-image("cmp/b-print.bmp":u) .
     1772                                   hh:TOOLTIP = "Печать" .
     1773                                   v-h[ii] = hh:handle .
     1774                                   ii = ii + 1 .
     1775                                   hh:width-chars = 3 .
     1776                               end.
     1777                           when "b-history" or
     1778                           when "b-hist" then
     1779                               do:
     1780                                   hh:load-image("cmp/b-hist.bmp":u) .
     1781                                   hh:TOOLTIP = "История" .
     1782                                   v-h[ii] = hh:handle .
     1783                                   ii = ii + 1 .
     1784                                   hh:width-chars = 3 .
     1785                               end.
     1786                           when "b-sch" then
     1787                               do:
     1788                                   hh:load-image("cmp/b-sch.bmp":u) .
     1789                                   hh:TOOLTIP = "Установка Фильтра" .
     1790                                   v-h[ii] = hh:handle .
     1791                                   ii = ii + 1 .
     1792                                   hh:width-chars = 3 .
     1793                               end.
     1794                           when "b-hist-user" then
     1795                               do:
     1796                                   hh:load-image("cmp/b-hist.bmp":u) .
     1797                                   hh:TOOLTIP = "История пользователя" .
     1798                                   ii = ii + 1 .
     1799                               end.
     1800                       end case.
     1801                   end.
     1802                   hh = hh:next-sibling.
     1803               end.
     1804               b-help:column = v-frame-width - b-help:width-chars.
     1805               jj = 0.
     1806               repeat ii = 4 to 1 by -1 :
     1807                   if valid-handle (v-h[ii] ) then
     1808                   do:
     1809                       jj  = jj + 1 .
     1810                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1811                       v-h[ii]:row    = v-help-old-y .
     1812                   end.
     1813               end.
     1814           end.
     1815       end.
     1816   end procedure.
     1817   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1818   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1819   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1820   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1821   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1822   define variable v-diasize-current-frame-height as decimal   no-undo .
     1823   define variable v-diasize-change-size          as logical   no-undo .
     1824   define variable v-diasize-resize-button        as handle    no-undo .
     1825   define variable v-diasize-wndmax               as logical   no-undo .
     1826   define variable v-diasize-wndstore             as logical   no-undo .
     1827   define variable v-diasize-proc-name            as character no-undo .
     1828   define variable v-diasize-browse-handle        as handle    no-undo .
     1829   define variable v-diasize-browse-number        as integer   no-undo .
     1830   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1831   define temp-table temp-diasize-handle no-undo
     1832     field handle-value  as handle
     1833     field save-position as decimal
     1834     index xpk is primary unique handle-value
     1835     .
     1836   define temp-table temp-browse-handle no-undo
     1837     field browse-type   as character
     1838     field browse-number as integer
     1839     field browse-handle as handle
     1840     field original-size as decimal
     1841     index xpk is primary unique browse-type browse-number
     1842     index xie browse-type browse-handle
     1843   .
     1844   procedure diasize_change-height :
     1845     define input  parameter p-change-value  as decimal   no-undo .
     1846     define input  parameter p-move-resize   as logical   no-undo .
     1847     define variable v-field-group-handle    as handle    no-undo .
     1848     define variable v-object-handle         as handle    no-undo .
     1849     define variable v-frame-height          as decimal   no-undo .
     1850     define variable v-frame-virtual-height  as decimal   no-undo .
     1851     define variable v-browse-height         as decimal   no-undo .
     1852     define variable v-window-height         as decimal   no-undo .
     1853     define variable v-window-virtual-height as decimal   no-undo .
     1854     define variable v-change-sign           as integer   no-undo .
     1855     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1856     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1857     if p-change-value > 0
     1858     then do:
     1859       if frame Dialog-Frame :height + p-change-value
     1860           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1861       then do:
     1862         assign
     1863           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1864                           - (frame Dialog-Frame :height-chars)
     1865         .
     1866         if p-change-value <= 0
     1867         then do:
     1868           run diasize_position-resize-button in this-procedure .
     1869           return .
     1870         end.
     1871       end.
     1872     end.
     1873     if p-change-value < 0
     1874     then do:
     1875       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1876       then do:
     1877         assign
     1878           p-change-value = v-diasize-orig-frame-height
     1879                          - (frame Dialog-Frame :height-chars)
     1880         .
     1881         if p-change-value >= 0
     1882         then do:
     1883           run diasize_position-resize-button in this-procedure .
     1884           return .
     1885         end.
     1886       end.
     1887     end.
     1888     if p-change-value >= 0
     1889     then do:
     1890       assign
     1891         v-change-sign = 1
     1892       .
     1893     end.
     1894     else do:
     1895       assign
     1896         v-change-sign = -1
     1897       .
     1898     end.
     1899     assign
     1900       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1901     .
     1902     if p-change-value = 0
     1903     then do:
     1904       run diasize_position-resize-button in this-procedure .
     1905       return .
     1906     end.
     1907     move_block:
     1908     do
     1909     on error undo move_block, retry move_block
     1910     :
     1911       if retry
     1912       then do:
     1913         do
     1914         on error undo move_block, leave move_block
     1915         :
     1916           if p-change-value > 0
     1917           then do:
     1918             for each buf_temp-diasize-handle
     1919             on error undo, next
     1920             :
     1921               assign
     1922                 v-object-handle = buf_temp-diasize-handle.handle-value
     1923               .
     1924               if v-object-handle <> v-diasize-resize-button
     1925               then do:
     1926                 assign
     1927                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1928                 .
     1929               end.
     1930             end.
     1931             assign
     1932               v-diasize-browse-handle :height = v-browse-height
     1933             .
     1934             for each buf_temp-browse-handle
     1935               where buf_temp-browse-handle.browse-type = 'height':u
     1936             on error undo, next
     1937             :
     1938               assign
     1939                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1940               .
     1941             end.
     1942             assign
     1943               frame Dialog-Frame :height = v-frame-height
     1944             .
     1945             if frame Dialog-Frame :scrollable = true
     1946             then do:
     1947               assign
     1948                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1949               .
     1950             end.
     1951             run diasize_position-resize-button in this-procedure .
     1952           end.
     1953           else do:
     1954             if frame Dialog-Frame :scrollable = true
     1955             then do:
     1956               assign
     1957                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1958               .
     1959             end.
     1960             assign
     1961               frame Dialog-Frame :height = v-frame-height
     1962             .
     1963             assign
     1964               v-diasize-browse-handle :height = v-browse-height
     1965             .
     1966             for each buf_temp-browse-handle
     1967               where buf_temp-browse-handle.browse-type = 'height':u
     1968             on error undo, next
     1969             :
     1970               assign
     1971                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1972               .
     1973             end.
     1974             for each buf_temp-diasize-handle
     1975             on error undo, next
     1976             :
     1977               assign
     1978                 v-object-handle = buf_temp-diasize-handle.handle-value
     1979               .
     1980               if v-object-handle <> v-diasize-resize-button
     1981               then do:
     1982                 assign
     1983                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1984                 .
     1985               end.
     1986             end.
     1987             run diasize_position-resize-button in this-procedure .
     1988           end.
     1989           assign
     1990             v-diasize-change-size = false
     1991           .
     1992           leave move_block .
     1993         end.
     1994       end.
     1995       assign
     1996         v-diasize-need-full-display = true
     1997       .
     1998       if v-diasize-change-size = false
     1999       then do:
     2000         assign
     2001           v-diasize-change-size = true
     2002         .
     2003       end.
     2004       else do:
     2005         return .
     2006       end.
     2007       assign
     2008         v-frame-height = frame Dialog-Frame :height
     2009         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2010         v-browse-height = v-diasize-browse-handle :height
     2011       .
     2012       for each buf_temp-browse-handle
     2013         where buf_temp-browse-handle.browse-type = 'height':u
     2014       :
     2015         assign
     2016           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2017         .
     2018       end.
     2019       for each buf_temp-diasize-handle
     2020       :
     2021         delete buf_temp-diasize-handle .
     2022       end.
     2023       assign
     2024         v-field-group-handle = frame Dialog-Frame :first-child
     2025       .
     2026       do while valid-handle(v-field-group-handle)
     2027       :
     2028         assign
     2029           v-object-handle = v-field-group-handle :first-child
     2030         .
     2031         do while valid-handle(v-object-handle)
     2032         :
     2033           if  v-object-handle <> v-diasize-browse-handle :handle
     2034           and can-query(v-object-handle, "row")
     2035           and can-query(v-object-handle, "height")
     2036           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2037           then do:
     2038             find first buf_temp-browse-handle
     2039               where buf_temp-browse-handle.browse-type   = 'height':u
     2040                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2041               no-error .
     2042             if available buf_temp-browse-handle
     2043             then do:
     2044             end.
     2045             else do:
     2046               create buf_temp-diasize-handle .
     2047               assign
     2048                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2049                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2050               .
     2051             end.
     2052           end.
     2053           assign
     2054             v-object-handle = v-object-handle :next-sibling
     2055           .
     2056         end.
     2057         assign
     2058           v-field-group-handle = v-field-group-handle :next-sibling
     2059         .
     2060       end.
     2061       do with frame Dialog-Frame
     2062       :
     2063         hide v-diasize-resize-button .
     2064         assign
     2065           v-diasize-resize-button :row    = 1
     2066           v-diasize-resize-button :column = 1
     2067         .
     2068       end.
     2069       if p-change-value > 0
     2070       then do:
     2071         if frame Dialog-Frame :scrollable = true
     2072         then do:
     2073           assign
     2074             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2075             no-error .
     2076           if error-status :error
     2077           or error-status :get-message(1) <> ""
     2078           then do:
     2079             undo move_block, retry move_block .
     2080           end.
     2081         end.
     2082         assign
     2083           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2084           no-error .
     2085         if error-status :error
     2086         or error-status :get-message(1) <> ""
     2087         then do:
     2088           undo move_block, retry move_block .
     2089         end.
     2090         assign
     2091           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2092           no-error .
     2093         if error-status :error
     2094         or error-status :get-message(1) <> ""
     2095         then do:
     2096           undo move_block, retry move_block .
     2097         end.
     2098         for each buf_temp-browse-handle
     2099           where buf_temp-browse-handle.browse-type = 'height':u
     2100         on error undo move_block, retry move_block
     2101         :
     2102           assign
     2103             buf_temp-browse-handle.browse-handle :height
     2104               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2105             no-error .
     2106           if error-status :error
     2107           or error-status :get-message(1) <> ""
     2108           then do:
     2109             undo move_block, retry move_block .
     2110           end.
     2111         end.
     2112         for each buf_temp-diasize-handle
     2113         on error undo move_block, retry move_block
     2114         :
     2115           assign
     2116             v-object-handle = buf_temp-diasize-handle.handle-value
     2117           .
     2118           if v-object-handle <> v-diasize-resize-button
     2119           then do:
     2120             assign
     2121               v-object-handle :row = v-object-handle :row + p-change-value
     2122               no-error .
     2123             if error-status :error
     2124             or error-status :get-message(1) <> ""
     2125             then do:
     2126               undo move_block, retry move_block .
     2127             end.
     2128           end.
     2129         end.
     2130       end.
     2131       else do:
     2132         for each buf_temp-diasize-handle
     2133         on error undo move_block, retry move_block
     2134         :
     2135           assign
     2136             v-object-handle = buf_temp-diasize-handle.handle-value
     2137           .
     2138           if v-object-handle <> v-diasize-resize-button
     2139           then do:
     2140             assign
     2141               v-object-handle :row = v-object-handle :row + p-change-value
     2142               no-error .
     2143             if error-status :error
     2144             or error-status :get-message(1) <> ""
     2145             then do:
     2146               undo move_block, retry move_block .
     2147             end.
     2148           end.
     2149         end.
     2150         assign
     2151           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2152           no-error .
     2153         if error-status :error
     2154         or error-status :get-message(1) <> ""
     2155         then do:
     2156           undo move_block, retry move_block .
     2157         end.
     2158         for each buf_temp-browse-handle
     2159           where buf_temp-browse-handle.browse-type = 'height':u
     2160         on error undo move_block, retry move_block
     2161         :
     2162           assign
     2163             buf_temp-browse-handle.browse-handle :height
     2164               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2165             no-error .
     2166           if error-status :error
     2167           or error-status :get-message(1) <> ""
     2168           then do:
     2169             undo move_block, retry move_block .
     2170           end.
     2171         end.
     2172         assign
     2173           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2174           no-error .
     2175         if error-status :error
     2176         or error-status :get-message(1) <> ""
     2177         then do:
     2178           undo move_block, retry move_block .
     2179         end.
     2180         if frame Dialog-Frame :scrollable = true
     2181         then do:
     2182           assign
     2183             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2184             no-error .
     2185           if error-status :error
     2186           or error-status :get-message(1) <> ""
     2187           then do:
     2188             undo move_block, retry move_block .
     2189           end.
     2190         end.
     2191       end.
     2192       if p-move-resize = true
     2193       then do:
     2194         run diasize_position-resize-button in this-procedure .
     2195       end.
     2196       if v-diasize-wndstore = true
     2197       then do:
     2198         if connected("ub") = true
     2199         then do:
     2200           define variable v-cntxt-db-num        as integer   no-undo .
     2201           define variable v-cntxt-userid        as character no-undo .
     2202           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2203                                             , OUTPUT v-cntxt-userid
     2204                                             ) .
     2205           run gbl/wndsizew.p
     2206             (input  v-cntxt-db-num
     2207             ,input  v-cntxt-userid
     2208             ,input  v-diasize-proc-name
     2209             ,input  'height':u
     2210             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2211             ) .
     2212         end.
     2213       end.
     2214     end.
     2215     assign
     2216       v-diasize-change-size = false
     2217     .
     2218   end procedure.
     2219   procedure diasize_set-height :
     2220     define input  parameter p-new-height  as decimal   no-undo .
     2221     define input  parameter p-move-resize as logical   no-undo .
     2222     do
     2223     on error undo, return error return-value
     2224     :
     2225       run diasize_change-height in this-procedure
     2226         (input  (p-new-height - frame Dialog-Frame :height)
     2227         ,input  p-move-resize
     2228         ) .
     2229     end.
     2230   end procedure.
     2231   procedure diasize_change-width :
     2232     define input  parameter p-change-value as decimal   no-undo .
     2233     define input  parameter p-move-resize  as logical   no-undo .
     2234     define variable v-field-group-handle   as handle    no-undo .
     2235     define variable v-object-handle        as handle    no-undo .
     2236     define variable v-frame-width          as decimal   no-undo .
     2237     define variable v-frame-virtual-width  as decimal   no-undo .
     2238     define variable v-browse-width         as decimal   no-undo .
     2239     define variable v-window-width         as decimal   no-undo .
     2240     define variable v-window-virtual-width as decimal   no-undo .
     2241     define variable v-change-sign          as integer   no-undo .
     2242     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2243     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2244     if p-change-value > 0
     2245     then do:
     2246       if frame Dialog-Frame :width + p-change-value >
     2247           session :width-chars
     2248       then do:
     2249         assign
     2250           p-change-value = session :width-chars - frame Dialog-Frame :width
     2251         .
     2252         if p-change-value <= 0
     2253         then do:
     2254           run diasize_position-resize-button in this-procedure .
     2255           return .
     2256         end.
     2257       end.
     2258     end.
     2259     if p-change-value < 0
     2260     then do:
     2261       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2262       then do:
     2263         assign
     2264           p-change-value = v-diasize-orig-frame-width
     2265                          - frame Dialog-Frame :width
     2266         .
     2267         if p-change-value >= 0
     2268         then do:
     2269           run diasize_position-resize-button in this-procedure .
     2270           return .
     2271         end.
     2272       end.
     2273     end.
     2274     if p-change-value >= 0
     2275     then do:
     2276       assign
     2277         v-change-sign = 1
     2278       .
     2279     end.
     2280     else do:
     2281       assign
     2282         v-change-sign = -1
     2283       .
     2284     end.
     2285     assign
     2286       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2287     .
     2288     if p-change-value = 0
     2289     then do:
     2290       run diasize_position-resize-button in this-procedure .
     2291       return .
     2292     end.
     2293     move_block:
     2294     do
     2295     on error undo move_block, leave move_block
     2296     :
     2297       if retry
     2298       then do:
     2299         do
     2300         on error undo move_block, leave move_block
     2301         :
     2302           if p-change-value > 0
     2303           then do:
     2304             for each buf_temp-diasize-handle
     2305             on error undo, next
     2306             :
     2307               assign
     2308                 v-object-handle = buf_temp-diasize-handle.handle-value
     2309               .
     2310               if v-object-handle <> v-diasize-resize-button
     2311               then do:
     2312                 assign
     2313                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2314                 .
     2315               end.
     2316             end.
     2317             assign
     2318               v-diasize-browse-handle :width = v-browse-width
     2319             .
     2320             for each buf_temp-browse-handle
     2321               where buf_temp-browse-handle.browse-type = 'width':u
     2322             on error undo, next
     2323             :
     2324               assign
     2325                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2326               .
     2327             end.
     2328             assign
     2329               frame Dialog-Frame :width = v-frame-width
     2330             .
     2331             if frame Dialog-Frame :scrollable = true
     2332             then do:
     2333               assign
     2334                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2335               .
     2336             end.
     2337             run diasize_position-resize-button in this-procedure .
     2338           end.
     2339           else do:
     2340             if frame Dialog-Frame :scrollable = true
     2341             then do:
     2342               assign
     2343                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2344               .
     2345             end.
     2346             assign
     2347               frame Dialog-Frame :width = v-frame-width
     2348             .
     2349             for each buf_temp-browse-handle
     2350               where buf_temp-browse-handle.browse-type = 'width':u
     2351             on error undo, next
     2352             :
     2353               assign
     2354                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2355               .
     2356             end.
     2357             assign
     2358               v-diasize-browse-handle :width = v-browse-width
     2359             .
     2360             for each buf_temp-diasize-handle
     2361             on error undo, next
     2362             :
     2363               assign
     2364                 v-object-handle = buf_temp-diasize-handle.handle-value
     2365               .
     2366               if v-object-handle <> v-diasize-resize-button
     2367               then do:
     2368                 assign
     2369                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2370                 .
     2371               end.
     2372             end.
     2373             run diasize_position-resize-button in this-procedure .
     2374           end.
     2375           assign
     2376             v-diasize-change-size = false
     2377           .
     2378           leave move_block .
     2379         end.
     2380       end.
     2381       assign
     2382         v-diasize-need-full-display = true
     2383       .
     2384       if v-diasize-change-size = false
     2385       then do:
     2386         assign
     2387           v-diasize-change-size = true
     2388         .
     2389       end.
     2390       else do:
     2391         return .
     2392       end.
     2393       assign
     2394         v-frame-width = frame Dialog-Frame :width
     2395         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2396         v-browse-width = v-diasize-browse-handle :width
     2397       .
     2398       for each buf_temp-browse-handle
     2399         where buf_temp-browse-handle.browse-type = 'width':u
     2400       :
     2401         assign
     2402           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2403         .
     2404       end.
     2405       for each buf_temp-diasize-handle
     2406       :
     2407         delete buf_temp-diasize-handle .
     2408       end.
     2409       assign
     2410         v-field-group-handle = frame Dialog-Frame :first-child
     2411       .
     2412       do while valid-handle(v-field-group-handle)
     2413       :
     2414         assign
     2415           v-object-handle = v-field-group-handle :first-child
     2416         .
     2417         do while valid-handle(v-object-handle)
     2418         :
     2419           if  v-object-handle <> v-diasize-browse-handle :handle
     2420           and v-object-handle <> v-diasize-resize-button
     2421           and can-query(v-object-handle, "row")
     2422           and can-query(v-object-handle, "height")
     2423           and ( v-object-handle :col + v-object-handle :width
     2424                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2425               )
     2426           then do:
     2427             find first buf_temp-browse-handle
     2428               where buf_temp-browse-handle.browse-type   = 'width':u
     2429                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2430               no-error .
     2431             if available buf_temp-browse-handle
     2432             then do:
     2433             end.
     2434             else do:
     2435               create buf_temp-diasize-handle .
     2436               assign
     2437                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2438                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2439               .
     2440             end.
     2441           end.
     2442           assign
     2443             v-object-handle = v-object-handle :next-sibling
     2444           .
     2445         end.
     2446         assign
     2447           v-field-group-handle = v-field-group-handle :next-sibling
     2448         .
     2449       end.
     2450       do with frame Dialog-Frame
     2451       :
     2452         hide v-diasize-resize-button .
     2453         v-diasize-resize-button :row = 1.
     2454         v-diasize-resize-button :column = 1.
     2455       end.
     2456       if p-change-value > 0
     2457       then do:
     2458         if frame Dialog-Frame :scrollable = true
     2459         then do:
     2460           assign
     2461             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2462             no-error .
     2463           if error-status :error
     2464           or error-status :get-message(1) <> ""
     2465           then do:
     2466             undo move_block, retry move_block.
     2467           end.
     2468         end.
     2469         assign
     2470           frame Dialog-Frame :width = v-frame-width + p-change-value
     2471           no-error .
     2472         if error-status :error
     2473         or error-status :get-message(1) <> ""
     2474         then do:
     2475           undo move_block, retry move_block.
     2476         end.
     2477         assign
     2478           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2479         no-error .
     2480         if error-status :error
     2481         or error-status :get-message(1) <> ""
     2482         then do:
     2483           undo move_block, retry move_block.
     2484         end.
     2485         for each buf_temp-browse-handle
     2486           where buf_temp-browse-handle.browse-type = 'width':u
     2487         on error undo move_block, retry move_block
     2488         :
     2489           assign
     2490             buf_temp-browse-handle.browse-handle :width
     2491               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2492             no-error .
     2493           if error-status :error
     2494           or error-status :get-message(1) <> ""
     2495           then do:
     2496             undo move_block, retry move_block .
     2497           end.
     2498         end.
     2499         for each buf_temp-diasize-handle
     2500         on error undo move_block, retry move_block
     2501         :
     2502           assign
     2503             v-object-handle = buf_temp-diasize-handle.handle-value
     2504           .
     2505           if v-object-handle <> v-diasize-resize-button
     2506           then do:
     2507             assign
     2508               v-object-handle :col = v-object-handle :col + p-change-value
     2509               no-error .
     2510             if error-status :error
     2511             or error-status :get-message(1) <> ""
     2512             then do:
     2513               undo move_block, retry move_block .
     2514             end.
     2515           end.
     2516         end.
     2517       end.
     2518       else do:
     2519         for each buf_temp-diasize-handle
     2520         on error undo move_block, retry move_block
     2521         :
     2522           assign
     2523             v-object-handle = buf_temp-diasize-handle.handle-value
     2524           .
     2525           if v-object-handle <> v-diasize-resize-button
     2526           then do:
     2527             assign
     2528               v-object-handle :col = v-object-handle :col + p-change-value
     2529               no-error .
     2530             if error-status :error
     2531             or error-status :get-message(1) <> ""
     2532             then do:
     2533               undo move_block, retry move_block .
     2534             end.
     2535           end.
     2536         end.
     2537         for each buf_temp-browse-handle
     2538           where buf_temp-browse-handle.browse-type = 'width':u
     2539         on error undo move_block, retry move_block
     2540         :
     2541           assign
     2542             buf_temp-browse-handle.browse-handle :width
     2543               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2544             no-error .
     2545           if error-status :error
     2546           or error-status :get-message(1) <> ""
     2547           then do:
     2548             undo move_block, retry move_block .
     2549           end.
     2550         end.
     2551         assign
     2552           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2553           no-error .
     2554         if error-status :error
     2555         or error-status :get-message(1) <> ""
     2556         then do:
     2557           undo move_block, retry move_block.
     2558         end.
     2559         assign
     2560           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2561         no-error .
     2562         if error-status :error
     2563         or error-status :get-message(1) <> ""
     2564         then do:
     2565           undo move_block, retry move_block.
     2566         end.
     2567         if frame Dialog-Frame :scrollable = true
     2568         then do:
     2569           assign
     2570             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2571           no-error .
     2572           if error-status :error
     2573           or error-status :get-message(1) <> ""
     2574           then do:
     2575             undo move_block, retry move_block.
     2576           end.
     2577         end.
     2578       end.
     2579       if p-move-resize
     2580       then do:
     2581         run diasize_position-resize-button in this-procedure .
     2582       end.
     2583       if v-diasize-wndstore = true
     2584       then do:
     2585         if connected("ub") = true
     2586         then do:
     2587           define variable v-cntxt-db-num        as integer   no-undo .
     2588           define variable v-cntxt-userid        as character no-undo .
     2589           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2590                                             , OUTPUT v-cntxt-userid
     2591                                             ) .
     2592           run gbl/wndsizew.p
     2593             (input  v-cntxt-db-num
     2594             ,input  v-cntxt-userid
     2595             ,input  v-diasize-proc-name
     2596             ,input  'width':u
     2597             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2598             ) .
     2599         end.
     2600       end.
     2601     end.
     2602     assign
     2603       v-diasize-change-size = false
     2604     .
     2605   end procedure.
     2606   procedure diasize_set-width :
     2607     define input  parameter p-new-width  as decimal   no-undo .
     2608     define input  parameter p-move-resize as logical   no-undo .
     2609     do
     2610     on error undo, return error return-value
     2611     :
     2612       run diasize_change-width in this-procedure
     2613         (input  (p-new-width - frame Dialog-Frame :width)
     2614         ,input  p-move-resize
     2615         ) .
     2616     end.
     2617   end procedure.
     2618   procedure diasize_position-resize-button :
     2619     do with frame Dialog-Frame
     2620     :
     2621       hide v-diasize-resize-button .
     2622       assign
     2623         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2624                     - 1
     2625                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2626         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2627                     - 1
     2628                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2629       .
     2630       view v-diasize-resize-button .
     2631     end.
     2632   end procedure.
     2633   on alt-right anywhere
     2634   do:
     2635     run diasize_change-width in this-procedure
     2636       (input 1
     2637       ,input true
     2638       ) .
     2639     return no-apply .
     2640   end.
     2641   on alt-left anywhere
     2642   do:
     2643     run diasize_change-width in this-procedure
     2644       (input -1
     2645       ,input true
     2646       ) .
     2647     return no-apply .
     2648   end.
     2649   on alt-down anywhere
     2650   do:
     2651     run diasize_change-height in this-procedure
     2652       (input 1
     2653       ,input true
     2654       ) .
     2655     return no-apply .
     2656   end.
     2657   on alt-up anywhere
     2658   do:
     2659     run diasize_change-height in this-procedure
     2660       (input -1
     2661       ,input true
     2662       ) .
     2663     return no-apply .
     2664   end.
     2665   on alt-enter of frame Dialog-Frame
     2666   do:
     2667     run diasize_maximize in this-procedure
     2668       (input  ?
     2669       ).
     2670     return no-apply .
     2671   end.
     2672   procedure diasize_end-move :
     2673     do
     2674     on error undo, return error return-value
     2675     :
     2676       define variable v-row-delta as decimal   no-undo .
     2677       define variable v-col-delta as decimal   no-undo .
     2678       define variable v-new-row as decimal   no-undo .
     2679       define variable v-new-col as decimal   no-undo .
     2680       assign
     2681         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2682         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2683       .
     2684       assign
     2685         v-row-delta = v-new-row - frame Dialog-Frame :height
     2686         v-col-delta = v-new-col - frame Dialog-Frame :width
     2687       .
     2688       run diasize_change-height in this-procedure
     2689         (input v-row-delta
     2690         ,input true
     2691         ) .
     2692       run diasize_change-width in this-procedure
     2693         (input v-col-delta
     2694         ,input true
     2695         ) .
     2696     end.
     2697   end procedure.
     2698   procedure diasize_maximize :
     2699     define input  parameter p-action as logical   no-undo .
     2700     do
     2701     on error undo, return error return-value
     2702     :
     2703       if p-action = ?
     2704       then do:
     2705         if v-diasize-need-maximize = true
     2706         then do:
     2707           assign
     2708             p-action = true
     2709           .
     2710         end.
     2711         else do:
     2712           assign
     2713             p-action = false
     2714           .
     2715         end.
     2716       end.
     2717       if p-action = true
     2718       then do:
     2719         run diasize_change-height in this-procedure
     2720           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2721               - frame Dialog-Frame :height-chars
     2722           ,input true
     2723           ) .
     2724         run diasize_change-width in this-procedure
     2725           (input session :width-chars
     2726               - frame Dialog-Frame :width-chars
     2727           ,input true
     2728           ) .
     2729         assign
     2730           v-diasize-need-maximize = false
     2731         .
     2732       end.
     2733       else do:
     2734         run diasize_change-width in this-procedure
     2735           (input v-diasize-orig-frame-width
     2736               - frame Dialog-Frame :width-chars
     2737           ,input true
     2738           ) .
     2739         run diasize_change-height in this-procedure
     2740           (input v-diasize-orig-frame-height
     2741               - frame Dialog-Frame :height-chars
     2742           ,input true
     2743           ) .
     2744         assign
     2745           v-diasize-need-maximize = true
     2746         .
     2747       end.
     2748     end.
     2749   end procedure.
     2750   procedure diasize_restore-orig-size :
     2751     do
     2752     on error undo, return error return-value
     2753     :
     2754       assign
     2755         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2756         v-diasize-current-frame-height = frame Dialog-Frame :height
     2757       .
     2758       run diasize_set-height in this-procedure
     2759         (input  v-diasize-orig-frame-height
     2760         ,input  true
     2761         ) .
     2762       run diasize_set-width in this-procedure
     2763         (input  v-diasize-orig-frame-width
     2764         ,input  true
     2765         ) .
     2766     end.
     2767   end procedure.
     2768   procedure diasize_restore-current-size :
     2769     do
     2770     on error undo, return error return-value
     2771     :
     2772       run diasize_set-height in this-procedure
     2773         (input  v-diasize-current-frame-height
     2774         ,input  true
     2775         ) .
     2776       run diasize_set-width in this-procedure
     2777         (input  v-diasize-current-frame-width
     2778         ,input  true
     2779         ) .
     2780     end.
     2781   end procedure.
     2782   procedure diasize_set-browse-handle :
     2783     define input  parameter p-browse-handle as handle   no-undo .
     2784     define buffer buf_temp-browse-handle for temp-browse-handle .
     2785     do
     2786     on error undo, return error return-value
     2787     :
     2788       assign
     2789         v-diasize-browse-handle = p-browse-handle
     2790       .
     2791       for each buf_temp-browse-handle
     2792       on error undo, return error return-value
     2793       :
     2794         delete buf_temp-browse-handle .
     2795       end.
     2796     end.
     2797   end procedure.
     2798   procedure diasize_add_browse :
     2799     define input  parameter p-browse-type   as character no-undo .
     2800     define input  parameter p-browse-handle as handle    no-undo .
     2801     define buffer buf_temp-browse-handle for temp-browse-handle .
     2802     do
     2803     on error undo, return error return-value
     2804     :
     2805       assign
     2806         v-diasize-browse-number = v-diasize-browse-number + 1
     2807       .
     2808       create buf_temp-browse-handle .
     2809       assign
     2810         buf_temp-browse-handle.browse-type   = p-browse-type
     2811         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2812         buf_temp-browse-handle.browse-handle = p-browse-handle
     2813       .
     2814     end.
     2815   end procedure.
     2816   procedure diasize_init :
     2817     define variable v-default-value    as logical   no-undo .
     2818     define variable v-restore-saved    as logical   no-undo .
     2819     define variable v-resize-value-str as character no-undo .
     2820     do
     2821     on error undo, return error return-value
     2822     :
     2823       do with frame Dialog-Frame
     2824       :
     2825         assign
     2826           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2827           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2828           v-diasize-browse-handle     = browse br-cwthobj :handle
     2829         .
     2830         create button v-diasize-resize-button
     2831         assign
     2832           parent        = frame Dialog-Frame :first-child
     2833           label         = "s"
     2834           height-pixels = 16
     2835           width-pixels  = 16
     2836           visible       = true
     2837           sensitive     = true
     2838           movable       = true
     2839           triggers:
     2840             on end-move persistent run diasize_end-move in this-procedure .
     2841           end triggers.
     2842         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2843         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2844         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2845         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2846         assign
     2847           v-diasize-wndmax = false
     2848         .
     2849         if connected("ub") = true
     2850         then do:
     2851           define variable v-cntxt-db-num        as integer   no-undo .
     2852           define variable v-cntxt-userid        as character no-undo .
     2853           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2854                                             , OUTPUT v-cntxt-userid
     2855                                             ) .
     2856           run gbl/wndpar_r.p
     2857             (input  v-cntxt-db-num
     2858             ,input  v-cntxt-userid
     2859             ,input  'wndmax':U
     2860             ,output v-diasize-wndmax
     2861             ,output v-default-value
     2862             ) .
     2863         end.
     2864         assign
     2865           v-diasize-wndstore = false
     2866         .
     2867         if connected("ub") = true
     2868         then do:
     2869           run gbl/wndpar_r.p
     2870             (input  v-cntxt-db-num
     2871             ,input  v-cntxt-userid
     2872             ,input  'wndstore':U
     2873             ,output v-diasize-wndstore
     2874             ,output v-default-value
     2875             ) .
     2876         end.
     2877         assign
     2878           v-diasize-proc-name = entry(1, program-name(2), '.')
     2879         .
     2880         if v-diasize-wndstore = true
     2881         then do:
     2882           assign
     2883             v-restore-saved = false
     2884           .
     2885           if connected("ub") = true
     2886           then do:
     2887             run gbl/wndsizer.p
     2888               (input  v-cntxt-db-num
     2889               ,input  v-cntxt-userid
     2890               ,input  v-diasize-proc-name
     2891               ,input  'height':u
     2892               ,output v-resize-value-str
     2893               ) .
     2894             if v-resize-value-str <> '':U
     2895             then do:
     2896               run diasize_change-height in this-procedure
     2897                 (input  integer(v-resize-value-str)
     2898                 ,input  true
     2899                 ) .
     2900               assign
     2901                 v-restore-saved = true
     2902               .
     2903             end.
     2904           end.
     2905           if connected("ub") = true
     2906           then do:
     2907             run gbl/wndsizer.p
     2908               (input  v-cntxt-db-num
     2909               ,input  v-cntxt-userid
     2910               ,input  v-diasize-proc-name
     2911               ,input  'width':u
     2912               ,output v-resize-value-str
     2913               ) .
     2914             if v-resize-value-str <> '':U
     2915             then do:
     2916               run diasize_change-width in this-procedure
     2917                 (input  integer(v-resize-value-str)
     2918                 ,input  true
     2919                 ) .
     2920               assign
     2921                 v-restore-saved = true
     2922               .
     2923             end.
     2924           end.
     2925           if v-restore-saved <> true
     2926           then do:
     2927             if v-diasize-wndmax = true
     2928             then do:
     2929               run diasize_maximize in this-procedure
     2930                 (input  true
     2931                 ) .
     2932             end.
     2933           end.
     2934         end.
     2935         else do:
     2936           if v-diasize-wndmax = true
     2937           then do:
     2938             run diasize_maximize in this-procedure
     2939               (input  true
     2940               ) .
     2941           end.
     2942         end.
     2943       end.
     2944     end.
     2945   end procedure.
     2946   procedure diasize_need-full-display :
     2947     define output parameter p-need-full-display as logical   no-undo .
     2948     do
     2949     on error undo, return error return-value
     2950     :
     2951       assign
     2952         p-need-full-display = v-diasize-need-full-display
     2953       .
     2954       assign
     2955         v-diasize-need-full-display = false
     2956       .
     2957     end.
     2958   end procedure.
     2959   procedure get-context :
     2960      define output parameter p-db-num as integer          no-undo.
     2961      define output parameter p-user-id as character        no-undo.
     2962      define variable v-login               as character    no-undo.
     2963      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2964      define buffer buf_user-login  for ub.user-login .
     2965      do
     2966      on error undo, return error
     2967      :
     2968            FIND FIRST buf_sys-ctrl no-lock.
     2969            ASSIGN
     2970               v-login = USERID("ub")
     2971               p-db-num = buf_sys-ctrl.db-num
     2972            .
     2973            FIND FIRST buf_user-login
     2974                 WHERE buf_user-login.db-num = p-db-num
     2975                   AND buf_user-login.user-login = v-login
     2976                 no-lock
     2977                 no-error
     2978                 .
     2979            IF AVAILABLE buf_user-login
     2980            THEN DO:
     2981               assign
     2982                  p-user-id = buf_user-login.user-id
     2983               .
     2984            END.
     2985      end.
     2986   end procedure.
     2987   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2988   on f5 of frame Dialog-Frame anywhere
     2989   do:
     2990      v-doc-rec = recid(X_c-wth-obj).  RUn OpenBR in this-procedure ( input yes, input no, input '':U).  REPOSITION br-cwthobj to recid v-doc-rec No-ERROR.
     2991                  apply 'value-changed' to br-cwthobj.
     2992       apply "VALUE-CHANGED" to BR-changes.
     2993   end.
     2994   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2995   procedure set-filter-name :
     2996   define input parameter p-filter-name as character no-undo .
     2997     do with frame Dialog-Frame:
