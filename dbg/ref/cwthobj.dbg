      127   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      128   define variable c-point  as character no-undo .
      129   define variable tbl      as character no-undo .
      130   define variable join-tbl as character no-undo .
      131   define variable fld      as character no-undo .
      132   define variable lab      as character no-undo .
      133   define variable spr      as character no-undo .
      134   define variable dim      as character no-undo .
      135   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      136   procedure cur-time :
      137      define output parameter p-today as date      no-undo .
      138      define output parameter p-time  as integer   no-undo .
      139     do
      140     on error undo, return error
      141     :
      142       define variable v-date1 as date      no-undo .
      143       define variable v-date2 as date      no-undo .
      144       define variable v-time  as integer   no-undo .
      145       assign
      146         v-date1 = today
      147         v-time  = time
      148         v-date2 = today
      149       .
      150       if v-date1 <> v-date2
      151       then do:
      152         assign
      153           v-date1 = today
      154           v-time  = v-time
      155         .
      156       end.
      157       assign
      158         p-today = v-date1
      159         p-time  = v-time
      160       .
      161     end.
      162   end.
      163   function cur-time-date returns character
      164   :
      165     return string(today, '99/99/9999':U) .
      166   end.
      167   function cur-time-mjd returns decimal
      168   :
      169     define variable v-date as date      no-undo .
      170     define variable v-time as integer   no-undo .
      171     run cur-time in this-procedure
      172       (output v-date
      173       ,output v-time
      174       ) .
      175     return integer(v-date) - 2400002 + (v-time / 86400) .
      176   end.
      177   function cur-time-get-ending-index returns integer
      178   (input p-number as integer
      179   )
      180   :
      181     if p-number < 0
      182     or p-number = ?
      183     then do:
      184       return 1 .
      185     end.
      186     define variable v-rest as integer   no-undo .
      187     assign
      188       p-number = p-number modulo 100
      189     .
      190     if p-number < 20
      191     then do:
      192       assign
      193         v-rest = p-number
      194       .
      195     end.
      196     else do:
      197       assign
      198         v-rest = p-number modulo 10
      199       .
      200     end.
      201     case v-rest :
      202       when 1
      203       then do:
      204         return 2 .
      205       end.
      206       when 2 or
      207       when 3 or
      208       when 4
      209       then do:
      210         return 3 .
      211       end.
      212       otherwise do:
      213         return 1 .
      214       end.
      215     end case .
      216   end.
      217   procedure cur-time-mjd-to-date :
      218      define input  parameter i-mjd-diff as decimal no-undo.
      219      define output parameter o-Date     as date    no-undo.
      220      define output parameter o-Time     as integer no-undo.
      221      define variable v-day-number as integer   no-undo .
      222      if    i-mjd-diff < 0
      223         or i-mjd-diff = ?
      224      then do:
      225         return "?" .
      226      end.
      227      assign
      228         v-day-number = truncate(i-mjd-diff,0).
      229         o-Date = date(v-day-number + 2400002).
      230         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      231     .
      232   end.
      233   function cur-time-mjd-to-string returns character
      234   (input p-mjd-diff as decimal
      235   )
      236   :
      237     define variable v-day-number as integer   no-undo .
      238     define variable v-seconds    as integer   no-undo .
      239     define variable v-hour       as integer   no-undo .
      240     define variable v-min        as integer   no-undo .
      241     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      242     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      243     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      244     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      245     if p-mjd-diff < 0
      246     or p-mjd-diff = ?
      247     then do:
      248       return "?" .
      249     end.
      250     assign
      251       v-day-number = integer(truncate(p-mjd-diff,0))
      252       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      253     .
      254     if v-seconds > 86400
      255     then do:
      256       assign
      257         v-seconds = 86400 - 1
      258       .
      259     end.
      260     if v-seconds < 0
      261     then do:
      262       assign
      263         v-seconds = 0
      264       .
      265     end.
      266     assign
      267       v-hour = truncate(v-seconds / 3600, 0)
      268     .
      269     assign
      270       v-seconds = v-seconds modulo 3600
      271     .
      272     assign
      273       v-min = truncate(v-seconds / 60, 0)
      274     .
      275     assign
      276       v-seconds = v-seconds modulo 60
      277     .
      278     return
      279         (if v-day-number <> 0
      280           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      281           else ""
      282         )
      283       + (if v-day-number <> 0 or v-hour <> 0
      284           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      285           else ""
      286         )
      287       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      288           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      289           else ""
      290         )
      291       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      292       .
      293   end.
      294   function cur-time-string returns character
      295   :
      296     define variable v-date as date      no-undo .
      297     define variable v-time as integer   no-undo .
      298     run cur-time in this-procedure
      299       (output v-date
      300       ,output v-time
      301       ) .
      302     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      303   end.
      304   function cur-time-string-sec returns character
      305   :
      306     define variable v-date as date      no-undo .
      307     define variable v-time as integer   no-undo .
      308     run cur-time in this-procedure
      309       (output v-date
      310       ,output v-time
      311       ) .
      312     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      313   end.
      314   function cur-time-custom  returns character
      315   (input p-prefix as character
      316   ,input p-date-format as character
      317   ,input p-delimiter as character
      318   ,input p-time-format as character
      319   ,input p-suffix as character
      320   )
      321   :
      322     define variable v-date as date      no-undo .
      323     define variable v-time as integer   no-undo .
      324     run cur-time in this-procedure
      325       (output v-date
      326       ,output v-time
      327       ) .
      328     return
      329       p-prefix
      330       + string(v-date, p-date-format)
      331       + p-delimiter
      332       + string(v-time, p-time-format)
      333       + p-suffix
      334       .
      335   end.
      336   function cur-time-print  returns character
      337   :
      338     define variable v-date as date      no-undo .
      339     define variable v-time as integer   no-undo .
      340     run cur-time in this-procedure
      341       (output v-date
      342       ,output v-time
      343       ) .
      344     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      345   end.
      346   function cur-time-datetime returns datetime
      347   :
      348     define variable v-char as character no-undo .
      349     define variable v-datetime as datetime no-undo .
      350     v-char = cur-time-string().
      351     v-datetime = datetime(v-char).
      352     return  v-datetime.
      353   end.
      354   function cur-time-string-msec returns character
      355   :
      356     define variable v-date as datetime  no-undo .
      357     v-date = now.
      358     return string(v-date) .
      359   end.
      360   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      361   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      362   define new shared variable RepPathName        as character no-undo .
      363   define new shared variable PrintRubl          as logical   no-undo .
      364   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      365   define variable v-waitfram-action01         as character   no-undo .
      366   define variable v-waitfram-action02         as character   no-undo .
      367   define variable v-waitfram-action03         as character   no-undo .
      368   define variable mWaitFramTextBeg            as character   no-undo.
      369   define variable mWaitFramTextEnd            as character   no-undo.
      370   define variable mWaitFramView               as logical     no-undo.
      371   define variable mWaitProcEvent              as logical     no-undo init yes.
      372   define variable mWaitFramInterval           as integer     no-undo init 1 .
      373   define variable mWaitFramStop               as logical     no-undo.
      374   define variable mWaitFramStopUser           as logical     no-undo.
      375   define variable mWaitFramStopTimeOut        as logical     no-undo.
      376   define variable mWaitFramStartProc          as datetime-tz no-undo.
      377   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      378   define button B-WaitFramStop auto-end-key
      379        label "Стоп"
      380        size 10 by 1 tooltip "Остоновить процесс".
      381   define button B-viewProcInfo
      382        label "Информация"
      383        size 15 by 1 tooltip "Информация о процесс".
      384   define frame waitfram
      385     v-waitfram-action01 format "x(72)" no-label skip
      386     v-waitfram-action02 format "x(72)" no-label skip
      387     v-waitfram-action03 format "x(72)" no-label skip
      388     B-viewProcInfo
      389     B-WaitFramStop at row 4 col 30
      390     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      391     .
      392   define new global shared variable mBatchMode as logical no-undo init ?.
      393   define variable mFramBachModHandle as handle no-undo.
      394   mFramBachModHandle = frame waitfram:handle.
      395   define variable mFameOldVis as logical no-undo.
      396   define variable mVisCUrentVin as logical no-undo.
      397   if session:batch-mode
      398   then
      399      mBatchMode = yes.
      400   if mBatchMode = ? then do:
      401     mVisCUrentVin = current-window:visible.
      402     mFameOldVis = mFramBachModHandle:visible.
      403     mFramBachModHandle:visible  = yes.
      404     mBatchMode = mFramBachModHandle:visible ne yes.
      405     mFramBachModHandle:visible = mFameOldVis.
      406     current-window:visible = mVisCUrentVin.
      407   end.
      408    if  log-manager:logfile-name ne ?
      409     then DO:
      410         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      411         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      412         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      413     end.
      414   on choose of B-WaitFramStop in frame waitfram
      415   do:
      416     mWaitFramStop = yes.
      417     mWaitFramStopUser = yes.
      418   end.
      419   function waitfram-check-timeout returns logical():
      420      define variable vtime as int64 no-undo.
      421      if mWaitFramStopTimeOut
      422      then
      423         return yes.
      424      vtime = ( now - mWaitFramStartProc ) / 1000 .
      425      if     mWaitFramTimeOut ne ?
      426         and mWaitFramTimeOut ne 0
      427         and mWaitFramTimeOut lt vtime
      428      then do:
      429         mWaitFramStopTimeOut = yes.
      430      end.
      431      return mWaitFramStopTimeOut.
      432   end.
      433   procedure waitfram-hide :
      434     if not session:batch-mode
      435     then do
      436     on error undo, return error return-value
      437     :
      438       pause 0 before-hide .
      439       if not mBatchMode then
      440         hide frame waitfram .
      441     if     not mWaitFramView
      442        and mWaitProcEvent
      443     then
      444       process events .
      445     end.
      446   end procedure.
      447   procedure waitfram-show :
      448     define input  parameter p-message as character no-undo .
      449     define variable v-left-margin as integer   no-undo .
      450     if not session:batch-mode
      451     then do
      452     on error undo, return error return-value
      453     :
      454       if length(p-message) <= 70 then do:
      455         assign
      456           v-left-margin = integer((70 - length(p-message)) / 2)
      457         .
      458         assign
      459           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      460         .
      461         assign
      462           v-waitfram-action01 = " "
      463           v-waitfram-action02 = " "
      464                                    + fill(" ", v-left-margin)
      465                                    + p-message
      466           v-waitfram-action03 = " "
      467         .
      468       end.
      469       else do:
      470         define variable vRindex1 as integer no-undo.
      471         define variable vRindex2 as integer no-undo.
      472         vRindex1 = r-index(p-message," ",70).
      473         if vRindex1 = 0
      474         then
      475            vRindex1 = 70.
      476         if length(p-message)  <= vRindex1 + 70 then do:
      477           assign
      478             v-waitfram-action01 = " "
      479             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      480             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      481           .
      482         end.
      483         else do:
      484           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      485           if vRindex2 <= vRindex1
      486           then
      487              vRindex2 = vRindex1 + 70.
      488           assign
      489             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      490             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      491             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      492           .
      493         end.
      494       end.
      495       B-viewProcInfo:visible   in frame waitfram = no.
      496       B-viewProcInfo:sensitive in frame waitfram = no.
      497       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      498       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      499       if  (   mWaitFramView
      500          or  mWaitProcEvent)
      501          and not mBatchMode
      502       then
      503          display
      504             v-waitfram-action01 skip
      505             v-waitfram-action02 skip
      506             v-waitfram-action03 skip
      507          with frame waitfram .
      508       if     mWaitFramView
      509          then do:
      510             if     mWaitFramInterval ne ?
      511                and not mBatchMode
      512             then
      513                wait-for go of frame waitfram pause mWaitFramInterval.
      514          end.
      515          else
      516             if     mWaitProcEvent
      517                and not mBatchMode
      518             then
      519                process events .
      520     end.
      521   end procedure.
      522      procedure waitfram-show-this:
      523         define input  parameter iInterval as int64 no-undo.
      524         define variable vtime as int64 no-undo.
      525         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      526         mWaitFramInterval = iInterval.
      527         run waitfram-show (substitute("&1&2 &3&4" ,
      528                                       mWaitFramTextBeg ,
      529                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      530                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      531                                       mWaitFramTextEnd
      532                                      )
      533                           ).
      534      end.
      535      procedure WaitFramRunPause:
      536         define input  parameter iInterval as dec no-undo.
      537         define variable vStart  as datetime-tz no-undo.
      538         define variable vend    as datetime-tz no-undo.
      539         define variable vint as int64 no-undo.
      540         define variable vOk as logical no-undo.
      541         vStart = now.
      542         vend   = vStart.
      543         publish "WaitFramPause" (iInterval,output vOk).
      544         vend   =  now.
      545         vint = vend - vStart.
      546         vint = iInterval - vint / 1000.
      547         if     not mWaitFramStop
      548            and (   vint > 0
      549                 or (    not vOk
      550                     and iInterval eq ?
      551                     )
      552                 )
      553         then
      554            run waitfram-show-this (iInterval).
      555         vend   =  now.
      556         vint = vend - vStart.
      557         vint = iInterval - vint / 1000.
      558         if     not mWaitFramStop
      559            and vint > 0
      560         then do:
      561            run gbl/pause.p (vint * 1000).
      562         end.
      563         if iInterval ne ?
      564         then
      565            publish "WaitFramStop".
      566         waitfram-check-timeout().
      567      end.
      568      procedure WaitFramWaitFor:
      569         define input  parameter iInterval as dec no-undo.
      570         assign
      571            mWaitFramStartProc   = now
      572            mWaitFramStopUser    = no
      573            mWaitFramStopTimeOut = no
      574         .
      575         block-wait:
      576         do while not mWaitFramStop:
      577            run WaitFramRunPause (iInterval).
      578            if  waitfram-check-timeout()
      579            then do:
      580               leave block-wait.
      581            end.
      582         end.
      583         run waitfram-hide.
      584      end.
      585   procedure waitfram-join :
      586     define input  parameter p-line-1  as character no-undo .
      587     define input  parameter p-line-2  as character no-undo .
      588     define input  parameter p-line-3  as character no-undo .
      589     define output parameter p-message as character no-undo .
      590     do
      591     on error undo, return error return-value
      592     :
      593       assign
      594         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      595                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      596                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      597       .
      598     end.
      599   end procedure.
      600   function waitfram-join-function returns character
      601     (input p-line-1 as character
      602     ,input p-line-2 as character
      603     ,input p-line-3 as character
      604     ).
      605     define variable v-message as character no-undo .
      606     run waitfram-join in this-procedure
      607       (input  p-line-1
      608       ,input  p-line-2
      609       ,input  p-line-3
      610       ,output v-message
      611       ) .
      612     return v-message .
      613   end function .
      614   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      615   procedure fltfield-clear :
      616     define output parameter loc-fld as character no-undo.
      617     define output parameter loc-lab as character no-undo .
      618     define output parameter loc-spr as character no-undo .
      619     define output parameter loc-dim as character no-undo .
      620     assign
      621       loc-fld = ""
      622       loc-lab = ""
      623       loc-spr = ""
      624       loc-dim = "0"
      625     .
      626   end procedure .
      627   procedure fltfield-add :
      628     define input        parameter par-fld as character no-undo.
      629     define input        parameter par-lab as character no-undo .
      630     define input        parameter par-spr as character no-undo .
      631     define input-output parameter loc-fld as character no-undo.
      632     define input-output parameter loc-lab as character no-undo .
      633     define input-output parameter loc-spr as character no-undo .
      634     define input-output parameter loc-dim as character no-undo .
      635     do
      636     on error undo, return error
      637     :
      638       assign
      639       loc-fld = if loc-dim = '0'
      640                 then par-fld
      641                 else (loc-fld + chr(44) + par-fld)
      642       loc-lab = if loc-dim = '0'
      643                 then par-lab
      644                 else (loc-lab + chr(44) + par-lab)
      645       loc-spr = if loc-dim = '0'
      646                 then par-spr
      647                 else (loc-spr + chr(44) + par-spr)
      648       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      649                 string(integer(if num-entries(loc-dim) > 1
      650                               then entry(2, loc-dim)
      651                               else entry(1, loc-dim)
      652                               ) + 1)
      653       no-error
      654       .
      655     end.
      656   end procedure.
      657   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      658   define  stream PrnLibStream.
      659   procedure prn-lib-prn-file :
      660     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      661     define input parameter p-DIsabledoptions as integer no-undo .
      662     define variable v-report-name as character no-undo .
      663     define variable v-user-action as character no-undo .
      664     define variable v-printed     as logical   no-undo .
      665     define variable v-exist       as logical   no-undo .
