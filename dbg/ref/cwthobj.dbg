     4368       (input false
     4369       ,input p-next
     4370       ,input substitute("and X_c-wth-obj.soruce-type = 'wth-doc' and X_c-wth-obj.source-ref = &1 "
     4371         , p-user)
     4372       ).
     4373   apply "entry":u to sch-source-ref in frame Dialog-Frame .
     4374   END PROCEDURE.
     4375   PROCEDURE proc-find-user :
