      860   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      861   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      862   procedure fltopend_fltopend :
      863   define input parameter p-parent-handle as handle no-undo .
      864   define input parameter p-qh as handle no-undo .
      865   define input parameter p-flt-open-open-query  as character no-undo .
      866   define input parameter p-where-cond as character no-undo .
      867   define input parameter p-use-indFIRST-query-tail as character no-undo .
      868   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      869   define input parameter p-indexed-reposition as character no-undo .
      870     do
      871     on error undo, return error
      872     :
      873   define variable v-prepare-string as character no-undo .
      874   define variable glog as logical no-undo .
      875   assign
      876   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      877                      p-where-cond + chr(32)  +
      878                      p-use-indFIRST-query-tail + chr(32) +
      879                      p-use-ind-sort-clmn-by + chr(32) +
      880                      p-indexed-reposition
      881   .
      882   assign
      883   glog = p-qh:query-prepare(v-prepare-string) no-error .
      884   if not glog
      885   or error-status:error then do:
      886     message error-status:get-message(1) view-as alert-box .
      887     undo, return error .
      888   end.
      889   assign
      890   glog = p-qh:query-open no-error .
      891   if not glog
      892   or error-status:error then do:
      893     message error-status:get-message(1) view-as alert-box .
      894     undo, return error .
      895   end.
      896     end.
      897   end procedure.
      898   procedure fltopend_fltfindd :
      899   define input parameter p-parent-handle as handle no-undo .
      900   define input parameter p-qh as handle no-undo .
      901   define input parameter p-rowid as rowid no-undo .
      902   define input parameter p-next as logical no-undo .
      903   define input parameter p-lock as integer no-undo .
      904   define input parameter p-bh as handle no-undo .
      905   define input parameter p-where-cond as character no-undo .
      906   define input parameter p-use-index-phrase as character no-undo .
      907   define variable glog as logical no-undo .
      908   define variable v-qh as handle no-undo .
      909   define variable v-bh as handle no-undo .
      910   define variable v-recid as recid no-undo .
      911   define variable v-prepare-string as character no-undo .
      912   do
      913   on error undo, return error
      914   on stop undo, return error
      915   :
      916     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      917     create buffer v-bh for table p-bh buffer-name p-bh:name.
      918     create query v-qh.
      919     v-qh:set-buffers(v-bh).
      920     v-prepare-string = substitute("for each &1 &2 &3"
      921                                     ,v-bh:name
      922                                     ,p-where-cond
      923                                     ,p-use-index-phrase).
      924     glog = v-qh:query-prepare(v-prepare-string) no-error.
      925     if not glog then do:
      926       delete object v-qh.
      927       delete object v-bh.
      928       undo, return error .
      929     end.
      930     glog = v-qh:query-open no-error .
      931     if not glog then do:
      932       delete object v-qh.
      933       delete object v-bh.
      934       undo, return error .
      935     end.
      936     if p-next then do:
      937       v-qh:reposition-to-rowid(p-rowid) no-error .
      938       glog = v-qh:get-next( p-lock) no-error .
      939       glog = v-qh:get-next( p-lock) no-error .
      940       if not glog or v-qh:query-off-end = yes then do:
      941         glog = v-qh:get-first( p-lock) no-error .
      942       end.
      943     end.
      944     else do:
      945       glog = v-qh:get-first( p-lock) no-error .
      946     end.
      947     v-recid = v-bh:recid no-error .
      948     delete object v-qh.
      949     delete object v-bh.
      950     return string(v-recid) .
      951   end.
      952   end procedure.
      953   procedure fltopend_fltfindq :
      954   define input parameter p-parent-handle as handle no-undo .
      955   define input parameter p-qh as handle no-undo .
      956   define input parameter p-next as logical no-undo .
      957   define input parameter p-lock as integer no-undo .
      958   define input parameter p-flt-open-open-query  as character no-undo .
      959   define input parameter p-where-cond as character no-undo .
      960   define input parameter p-use-indFIRST-query-tail as character no-undo .
      961   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      962   define input parameter p-indexed-reposition as character no-undo .
      963   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      964   define variable glog as logical no-undo .
      965   define variable v-qh as handle no-undo .
      966   define variable v-bh as handle no-undo extent 18.
      967   define variable v-rowid as rowid no-undo extent 18.
      968   define variable v-ii as integer no-undo .
      969   define variable v-prepare-string as character no-undo .
      970   do
      971   on error undo, return error
      972   on stop undo, return error
      973   :
      974     create query v-qh.
      975     do v-ii = 1 to p-qh:num-buffers:
      976       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      977       assign
      978       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      979       no-error.
      980       v-qh:add-buffer(v-bh[v-ii]).
      981     end.
      982     assign
      983     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      984                       p-where-cond + chr(32)  +
      985                       p-use-indFIRST-query-tail + chr(32) +
      986                       p-use-ind-sort-clmn-by + chr(32) +
      987                       p-indexed-reposition
      988     .
      989     glog = v-qh:query-prepare( v-prepare-string) no-error .
      990     if not glog then do:
      991       delete object v-qh.
      992       do v-ii = 1 to p-qh:num-buffers:
      993         delete object v-bh[v-ii].
      994       end.
      995       undo, return error .
      996     end.
      997     glog = v-qh:query-open no-error .
      998     if not glog then do:
      999       delete object v-qh.
     1000       do v-ii = 1 to p-qh:num-buffers:
     1001         delete object v-bh[v-ii].
     1002       end.
     1003       undo, return error .
     1004     end.
     1005     if p-next then do:
     1006       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1007       glog = v-qh:get-next( p-lock) no-error .
     1008       glog = v-qh:get-next( p-lock) no-error .
     1009       if not glog or v-qh:query-off-end = yes then do:
     1010         glog = v-qh:get-first( p-lock) no-error .
     1011       end.
     1012     end.
     1013     else do:
     1014       glog = v-qh:get-first( p-lock) no-error .
     1015     end.
     1016     do v-ii = 1 to p-qh:num-buffers:
     1017       assign
     1018       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1019       no-error.
     1020     end.
     1021     delete object v-qh.
     1022     do v-ii = 1 to p-qh:num-buffers:
     1023       delete object v-bh[v-ii].
     1024     end.
     1025   end.
     1026   end procedure.
     1027   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1028   procedure wth-lib_cur-stock-place:
     1029   define input  parameter parobj-type like ub.clients.obj-type   no-undo.
     1030   define input  parameter parobj-code like ub.clients.obj-code   no-undo.
     1031   define input  parameter parw-p-code like ub.wth-pobj.w-p-code  no-undo.
     1032   define input  parameter parwth-code like ub.wth-pobj.wth-code  no-undo.
     1033   define output parameter parstock    like ub.wth-pobj.income-pl no-undo.
     1034   define buffer bf_wth-pobj for ub.wth-pobj.
     1035   find first bf_wth-pobj where bf_wth-pobj.obj-type = parobj-type and
     1036                                bf_wth-pobj.obj-code = parobj-code and
     1037                                bf_wth-pobj.w-p-code = parw-p-code and
     1038                                bf_wth-pobj.wth-code = parwth-code no-lock no-error.
     1039   if available bf_wth-pobj then assign parstock = bf_wth-pobj.income-pl - bf_wth-pobj.incass-pl.
     1040                            else assign parstock = 0.
     1041   end procedure.
     1042   procedure wth-lib_cur-stock-obj:
     1043   define input  parameter parobj-type like ub.clients.obj-type   no-undo.
     1044   define input  parameter parobj-code like ub.clients.obj-code   no-undo.
     1045   define input  parameter parwth-code like ub.wth-obj.wth-code   no-undo.
     1046   define output parameter parstock    like ub.wth-obj.income     no-undo.
     1047   define buffer bf_wth-obj for ub.wth-obj.
     1048   find first bf_wth-obj where bf_wth-obj.obj-type = parobj-type and
     1049                               bf_wth-obj.obj-code = parobj-code and
     1050                               bf_wth-obj.wth-code = parwth-code no-lock no-error.
     1051   if available bf_wth-obj then assign parstock = bf_wth-obj.income - bf_wth-obj.incass.
     1052                           else assign parstock = 0.
     1053   end.
     1054   FUNCTION wth-lib_cur-stock-obj-func RETURNS DECIMAL (INPUT parobj-type AS CHARACTER,
     1055                                                        INPUT parobj-code AS INTEGER,
     1056                                                        INPUT parwth-code AS INTEGER):
     1057   define buffer bf_wth-obj for ub.wth-obj.
     1058   find first bf_wth-obj where bf_wth-obj.obj-type = parobj-type and
     1059                               bf_wth-obj.obj-code = parobj-code and
     1060                               bf_wth-obj.wth-code = parwth-code no-lock no-error.
     1061   if available bf_wth-obj then return (bf_wth-obj.income - bf_wth-obj.incass).
     1062                           else return 0.00.
     1063   end function.
     1064   FUNCTION wth-lib_cur-stock-host-func RETURNS DECIMAL (INPUT parhost-code AS INTEGER,
     1065                                                         INPUT parwth-code  AS INTEGER):
     1066   define buffer bf_wth-obj for ub.wth-obj.
     1067   define variable v-stock like ub.wth-obj.income no-undo.
     1068   for each bf_wth-obj no-lock where bf_wth-obj.host-code = parhost-code and
     1069                                     bf_wth-obj.wth-code = parwth-code :
     1070     v-stock = v-stock +  bf_wth-obj.income - bf_wth-obj.incass.
     1071   end.
     1072   return v-stock.
     1073   end function.
     1074   procedure wth-lib_full-inf-shift:
