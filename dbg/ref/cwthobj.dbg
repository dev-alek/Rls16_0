     4013     then do:
     4014       define variable  parameter-2-32 as character no-undo .
     4015       define variable  parameter-3-32 as character no-undo .
     4016       define variable  parameter-4-32 as character no-undo .
     4017       define variable  parameter-5-32 as character no-undo .
     4018       define variable  parameter-6-32 as character no-undo .
     4019       define variable  parameter-7-32 as character no-undo .
     4020         assign
     4021         parameter-3-32 =
     4022                                 "FOR EACH X_c-wth-obj"
     4023         parameter-4-32 =
     4024           (
     4025             if (" X_c-wth-obj.obj-type = p-obj-type and X_c-wth-obj.obj-code = p-obj-code AND X_c-wth-obj.wth-code  = p-wth-code " + " " + where-phrase-32) <> ""
     4026             then  substitute('X_c-wth-obj.obj-type = &1&2&1 and X_c-wth-obj.obj-code = &3 AND X_c-wth-obj.wth-code  = &4 ', chr(34), p-obj-type, p-obj-code, p-wth-code) + " " + where-phrase-32
     4027             else "true"
     4028           )
     4029         parameter-5-32 = (" " + "" + " " + "")
     4030         parameter-6-32 = if sort-phrase-32 = ''
     4031                              then
     4032           (
     4033           " " + "  " +
     4034             " " + sort-column-phrase +
     4035           " " + "  "
     4036           )
     4037                              else
     4038           (
     4039           " " + "  " +
     4040             " " + sort-column-phrase +
     4041           " " + sort-phrase-32
     4042           )
     4043         parameter-7-32 =
     4044           " indexed-reposition  "
     4045       .
     4046       do
     4047       on stop undo, leave
     4048       on error undo, leave
     4049       :
     4050         assign
     4051           l-disable-where-32 =
     4052             (" X_c-wth-obj.obj-type = p-obj-type and X_c-wth-obj.obj-code = p-obj-code AND X_c-wth-obj.wth-code  = p-wth-code " + " " + where-phrase-32 = "")
     4053         .
     4054         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4055                             ,input query br-cwthobj:handle
     4056                             ,input parameter-3-32
     4057                             ,input parameter-4-32
     4058                             ,input parameter-5-32
     4059                             ,input parameter-6-32
     4060                             ,input parameter-7-32
     4061                             )
     4062         .
     4063         assign
     4064           l-filter-open-32 = true
     4065         .
     4066       end.
     4067       if l-filter-open-32 = false then do:
     4068         message
     4069           "Ошибка при фильтрации / сортировке" skip
     4070           "Будут показаны записи без учета фильтра" skip
     4071           view-as alert-box .
     4072       end.
     4073       else do:
     4074           assign
     4075             l-query-was-opened = true
     4076           .
     4077       end.
     4078     end.
     4079     if l-filter-open-32 = false then do:
     4080       OPEN QUERY br-cwthobj FOR EACH X_c-wth-obj
     4081         where  X_c-wth-obj.obj-type = p-obj-type and X_c-wth-obj.obj-code = p-obj-code AND X_c-wth-obj.wth-code  = p-wth-code
     4082         indexed-reposition
     4083     .
     4084         assign
     4085           l-query-was-opened = true
     4086         .
     4087     end.
     4088   end.
     4089   else do:
     4090     assign
     4091       v-doc-rec = recid( X_c-wth-obj )
     4092     .
     4093     do
     4094     on stop undo, leave
     4095     on error undo, leave
     4096     :
     4097       if query br-cwthobj:handle:get-buffer-handle(1) = (buffer X_c-wth-obj:handle) then do:
     4098         assign
     4099         parameter-2-32 = (if p-find-next then "true":u else "false":u )
     4100         parameter-4-32 =
     4101           "where ":u +  substitute('X_c-wth-obj.obj-type = &1&2&1 and X_c-wth-obj.obj-code = &3 AND X_c-wth-obj.wth-code  = &4 ', chr(34), p-obj-type, p-obj-code, p-wth-code) + " ":u + where-phrase-32 + " ":u + p-find-condition + " " + ""
     4102         parameter-5-32 = "  "
     4103       .
     4104         run fltopend_fltfindd in this-procedure  (
     4105                             input this-procedure:handle
     4106                             ,input query br-cwthobj:handle
     4107                             ,input rowid(X_c-wth-obj)
     4108                             ,input logical(parameter-2-32)
     4109                             ,input no-lock
     4110                             ,input (buffer X_c-wth-obj:handle)
     4111                             ,input parameter-4-32
     4112                             ,input parameter-5-32
     4113                             ) no-error.
     4114         .
     4115         assign
     4116           v-doc-rec = integer(return-value)
     4117           v-fltopend-rowid[1] = ?
     4118         .
     4119       end.
     4120       else do:
     4121         assign
     4122         parameter-2-32 = (if p-find-next then "true":u else "false":u )
     4123         parameter-3-32 =  "FOR EACH X_c-wth-obj"
     4124         parameter-4-32 =
     4125           (
     4126             if (" X_c-wth-obj.obj-type = p-obj-type and X_c-wth-obj.obj-code = p-obj-code AND X_c-wth-obj.wth-code  = p-wth-code " + " " + where-phrase-32) <> ""
     4127             then  substitute('X_c-wth-obj.obj-type = &1&2&1 and X_c-wth-obj.obj-code = &3 AND X_c-wth-obj.wth-code  = &4 ', chr(34), p-obj-type, p-obj-code, p-wth-code) + " " + where-phrase-32
     4128             else "true"
     4129           )
     4130         parameter-5-32 = (" " + "" + " " + "" + " " + p-find-condition)
     4131         parameter-6-32 = if sort-phrase-32 = ''
     4132                              then
     4133           (
     4134           " " + "  " +
     4135             " " + sort-column-phrase +
     4136           " " + "  "
     4137           )
     4138                              else
     4139           (
     4140           " " + "  " +
     4141             " " + sort-column-phrase +
     4142           " " + sort-phrase-32
     4143           )
     4144         parameter-7-32 =
     4145           " indexed-reposition  "
     4146       .
     4147         run fltopend_fltfindq in this-procedure  (
     4148                             input this-procedure:handle
     4149                             ,input query br-cwthobj:handle
     4150                             ,input logical(parameter-2-32)
     4151                             ,input no-lock
     4152                             ,input parameter-3-32
     4153                             ,input parameter-4-32
     4154                             ,input parameter-5-32
     4155                             ,input parameter-6-32
     4156                             ,input parameter-7-32
     4157                             ,output v-fltopend-rowid
     4158                             ) no-error.
     4159         .
     4160         v-doc-rec = ?.
     4161       end.
     4162       assign
     4163         l-query-was-opened = true
     4164       .
     4165     end.
     4166   end.
     4167     run waitfram-hide in this-procedure .
     4168     END.
     4169   END CASE.
     4170   if not p-open-query  and v-doc-rec <> ? then
     4171   REPOSITION br-cwthobj to recid v-doc-rec No-ERROR.
     4172   if not p-open-query and v-fltopend-rowid[1] <> ? then
     4173   query br-cwthobj:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     4174   run waitfram-hide in this-procedure .
     4175   APPLY "VALUE-CHANGED" TO br-cwthobj in frame Dialog-Frame.
     4176   APPLY "ENTRY" TO br-cwthobj.
     4177   END PROCEDURE.
     4178   PROCEDURE proc-b-print :
     4179   define variable date_string     as      char    no-undo.
     4180   define variable Line                as      char    no-undo.
     4181   define variable for-time as char.
     4182   define variable accum-count as integer.
     4183   define variable v-doc-rec as recid no-undo.
     4184   define variable v-prod as character no-undo .
     4185   define variable v-upd-time as character no-undo .
     4186   define variable v-obj as character no-undo .
     4187   define variable v-action-chr as character no-undo .
     4188   define variable v-source-type as character no-undo .
     4189   DEFINE VARIABLE v-for-user-name AS CHARACTER NO-UNDO.
     4190   DEFINE FRAME HistoryList
     4191   X_c-wth-obj.wth-code COLUMN-LABEL "Код МЦ"
     4192   v-action-chr FORMAT "X(10)" COLUMn-LABEL "Действие"
     4193   v-wth-name COLUMN-LABEL "Назв. МЦ" FORMAT "X(20)"
     4194   v-source-type COLUMn-LABEL "Источн.!измен"
     4195   X_c-wth-obj.source-ref COLUMn-LABEL "№"
     4196   X_c-wth-obj.corr-date
     4197   v-upd-time COLUMN-LABEL "Время изм." FORMAT "X(8)"
     4198   v-for-user-name COLUMN-LABEL "Изменил" FORMAT "X(18)"
     4199   X_c-wth-obj.corr-user-db-num
     4200   v-obj COLUMN-LABEL "Объект" FORMAT "X(8)"
     4201   HEADER  date_string AT 5 format "X(35)"
     4202   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     4203   Line format "X(195)" AT 1
     4204   with width 232 down stream-io use-text    .
     4205   Line = fill("-", 195).
     4206   date_string = cur-time-print() .
     4207   assign
     4208   v-doc-rec = recid( X_c-wth-obj ).
     4209   DO WHILE available X_c-wth-obj :
     4210         GET prev br-cwthobj.
     4211   END.
     4212   run prn-lib-open-stream  in this-procedure (
     4213                                                input parparentProc
     4214                                               ,input 43
     4215                                               ,input yes
     4216                                               ,input no
     4217                                               ).
     4218   PUT  STREAM PrnLibStream
     4219   SPACE(25) ( frame Dialog-Frame:title )
     4220   format "x(90)" SKIP(1) .
     4221   FORM HEADER
     4222   Line format "X(180)" AT 1 SKIP
     4223   "Продолжение - на следующей странице" AT 30 SKIP
     4224   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     4225   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     4226   FORM with FRAME HistoryList  .
     4227   run waitfram-show in this-procedure ("Ждите...").
     4228     GET next br-cwthobj.
     4229       DO WHILE available X_c-wth-obj :
     4230         Display STREAM PrnLibStream
     4231         X_c-wth-obj.wth-code
     4232         get-action(X_c-wth-obj.action-type) @ v-action-chr
     4233         (if v-find then get-wealth(X_c-wth-obj.obj-type, X_c-wth-obj.obj-code, X_c-wth-obj.wth-code) else "":U )
     4234         @ v-wth-name
     4235         get-source-type(X_c-wth-obj.source-type) @ v-source-type
     4236         X_c-wth-obj.source-ref
     4237         X_c-wth-obj.corr-date
     4238         string(X_c-wth-obj.corr-time, "HH:MM:SS":U) @ v-upd-time
     4239         usrfulnf(X_c-wth-obj.corr-user-name) @ v-for-user-name
     4240         X_c-wth-obj.corr-user-db-num
     4241         X_c-wth-obj.obj-type + string(X_c-wth-obj.obj-code) @ v-obj
     4242         with FRAME HistoryList .
     4243     DOWN STREAM PrnLibStream 1 with FRAME HistoryList  .
     4244     assign
     4245     accum-count = accum-count + 1
     4246     .
     4247     GET next br-cwthobj.
     4248   END.
     4249   UNDERLINE  STREAM PrnLibStream
     4250   X_c-wth-obj.wth-code
     4251   v-action-chr
     4252   v-wth-name
     4253   v-source-type
     4254   X_c-wth-obj.source-ref
     4255   X_c-wth-obj.corr-date
     4256   v-upd-time
     4257   v-for-user-name
     4258   X_c-wth-obj.corr-user-db-num
     4259   v-obj
     4260   with FRAME HistoryList .
     4261   DISPLAY STREAM PrnLibStream
     4262   "ИТОГО"  @ X_c-wth-obj.wth-code
     4263   string(accum-count)  @ v-action-chr
     4264   with frame HistoryList.
     4265   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     4266   HIDE  STREAM PrnLibStream FRAME CheckList.
     4267   output  STREAM PrnLibStream CLOSE.
     4268   run waitfram-hide in this-procedure.
     4269   run prn-lib-prn-file in this-procedure (
     4270                                             input parparentproc
     4271                                             ,input 8
     4272                                             ).
     4273   reposition br-cwthobj to recid v-doc-rec no-error.
     4274   apply "entry" to br-cwthobj in frame Dialog-Frame.
     4275   END PROCEDURE.
     4276   PROCEDURE proc-b-sch :
     4277   assign
     4278     tbl = 'c-wth-obj'
     4279     join-tbl = 'X_c-wth-obj'
     4280     fld = ""
     4281     lab = ""
     4282     spr = ""
     4283     dim = '0'
     4284     .
     4285   run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', '',
     4286   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4287   run fltfield-add in this-procedure('wth-code', 'Код МЦ', '',
     4288   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4289   run fltfield-add in this-procedure('corr-date', '', '',
     4290   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4291   run fltfield-add in this-procedure('corr-time', 'Время корр.', 'time',
     4292   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4293   run fltfield-add in this-procedure('corr-user-db-num', '', '',
     4294   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4295   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     4296   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4297   run fltfield-add in this-procedure('action-type', 'Действие', 'hist-action',
     4298   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4299   run fltfield-add in this-procedure('source-type', 'Источник_измен-я', 'hist-source-type',
     4300   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4301   run fltfield-add in this-procedure('source-ref', '', '',
     4302   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4303   Filter-Block:
     4304   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4305       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4306       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4307     run gbl/filter.w ( INPUT parparentproc
     4308                       ,INPUT (filter-point + chr(4) + filter-label + chr(4) + 'yes':U)
     4309                       ,INPUT tbl
     4310                       ,INPUT join-tbl
     4311                       ,INPUT fld
     4312                       ,INPUT lab
     4313                       ,INPUT spr
     4314                       ,INPUT dim ).
     4315     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     4316   END.
     4317   END PROCEDURE.
     4318   PROCEDURE proc-br-cwthobj :
     4319   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4320   if b-sel:sensitive in frame Dialog-Frame then dO:
     4321       if b-mark:sensitive then do:
     4322           apply "choose" to b-mark in frame Dialog-Frame.
     4323       end.
     4324       else do:
     4325           apply "choose" to b-sel in frame Dialog-Frame.
     4326       end.
     4327   end.
     4328   else do:
     4329       if b-lookup:sensitive then
     4330       apply "choose" to b-lookup in frame Dialog-Frame.
     4331   end.
     4332   END PROCEDURE.
     4333   PROCEDURE proc-find-corr-date :
     4334   define input parameter p-next as logical no-undo.
     4335   define input parameter p-date like ub.fin-doc.doc-date no-undo.
     4336   define variable v-date-chr as character no-undo.
     4337   if p-date = ? then return .
     4338   display
     4339   0 @ sch-wth-code
     4340   "":U @ sch-corr-user-name
     4341   '':U @ sch-source-ref
     4342   with frame Dialog-Frame.
     4343   assign
     4344   v-date-chr = string(day(p-date)) + chr(47) +
     4345                    string(month(p-date)) + chr(47) +
     4346                    string(year(p-date)).
     4347          run OpenBr in this-procedure
     4348           (input false
     4349           ,input true
     4350           ,input substitute("and X_c-wth-obj.corr-date = &1 "
     4351             , v-date-chr)
     4352           ).
     4353         apply "entry":u to sch-corr-date in frame Dialog-Frame.
     4354   END PROCEDURE.
     4355   PROCEDURE proc-find-source-ref :
