     3613         ) no-error .
     3614     assign
     3615       l-filter-open-28 = false
     3616     .
     3617     if flt-rec-28 <> ?
     3618       or sort-column-phrase > ""
     3619     then do:
     3620       define variable  parameter-2-28 as character no-undo .
     3621       define variable  parameter-3-28 as character no-undo .
     3622       define variable  parameter-4-28 as character no-undo .
     3623       define variable  parameter-5-28 as character no-undo .
     3624       define variable  parameter-6-28 as character no-undo .
     3625       define variable  parameter-7-28 as character no-undo .
     3626         assign
     3627         parameter-3-28 =
     3628                                 "FOR EACH X_c-wth-obj"
     3629         parameter-4-28 =
     3630           (
     3631             if (" TRUE " + " " + where-phrase-28) <> ""
     3632             then " TRUE " + " " + where-phrase-28
     3633             else "true"
     3634           )
     3635         parameter-5-28 = (" " + "" + " " + "")
     3636         parameter-6-28 = if sort-phrase-28 = ''
     3637                              then
     3638           (
     3639           " " + "  " +
     3640             " " + sort-column-phrase +
     3641           " " + "  "
     3642           )
     3643                              else
     3644           (
     3645           " " + "  " +
     3646             " " + sort-column-phrase +
     3647           " " + sort-phrase-28
     3648           )
     3649         parameter-7-28 =
     3650           " indexed-reposition  "
     3651       .
     3652       do
