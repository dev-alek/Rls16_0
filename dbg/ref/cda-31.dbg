      773   v-tth = buffer thbjattr_thbj-attr:table-handle
      774   v-tth_ = buffer thbjattr___thbj-attr:table-handle
      775   .
      776   DEFINE BUTTON B-exit AUTO-GO
      777        LABEL "&Ввод"
      778        SIZE 10 BY 1
      779        BGCOLOR 8 .
      780   DEFINE BUTTON B-Help
      781        LABEL "Помо&щь"
      782        SIZE 3 BY 1
      783        BGCOLOR 8 .
      784   DEFINE BUTTON B-main
      785        IMAGE-UP FILE "adeicon\ts-up110":U
      786        IMAGE-DOWN FILE "adeicon\ts-dn110":U
      787        IMAGE-INSENSITIVE FILE "adeicon\ts-up110":U NO-FOCUS
      788        LABEL "&1.Перемещ."
      789        SIZE 14 BY 1.13.
      790   DEFINE BUTTON b-quit AUTO-END-KEY
      791        LABEL "&Отмена"
      792        SIZE 10 BY 1
      793        BGCOLOR 8 .
      794   DEFINE BUTTON b-rec-print
      795        IMAGE-UP FILE "adeicon\ts-up110":U
      796        IMAGE-DOWN FILE "adeicon\ts-dn110":U
      797        IMAGE-INSENSITIVE FILE "adeicon\ts-up110":U NO-FOCUS
      798        LABEL ""
      799        SIZE 14 BY 1.13.
      800   DEFINE VARIABLE cb-pos-type-for-discnt AS CHARACTER FORMAT "X(256)":U
      801        LABEL "Тип POS, с которого брать скидки"
      802        VIEW-AS COMBO-BOX INNER-LINES 5
      803        LIST-ITEMS "Item 1"
      804        DROP-DOWN-LIST
      805        SIZE 25 BY 1 NO-UNDO.
      806   DEFINE VARIABLE f-main AS CHARACTER FORMAT "X(12)" INITIAL "Основные"
      807         VIEW-AS TEXT
      808        SIZE 11 BY .53
      809        FONT 4 NO-UNDO.
      810   DEFINE VARIABLE f-rec-print AS CHARACTER FORMAT "X(12)":U INITIAL "Чеки"
      811         VIEW-AS TEXT
      812        SIZE 11 BY .53
      813        FONT 4 NO-UNDO.
      814   DEFINE VARIABLE t-rcpt-ord-alt-print AS LOGICAL INITIAL no
      815        LABEL "Печатать отлож.чек на доп принтере"
      816        VIEW-AS TOGGLE-BOX
      817        SIZE 32 BY 1 NO-UNDO.
      818   DEFINE VARIABLE t-rcpt-ord-slip-print AS LOGICAL INITIAL no
      819        LABEL "Печатать слип отложенного чека"
      820        VIEW-AS TOGGLE-BOX
      821        SIZE 32 BY 1 NO-UNDO.
      822   DEFINE VARIABLE t-salesman-mandatory AS LOGICAL INITIAL no
      823        LABEL "Обязателен продавец"
      824        VIEW-AS TOGGLE-BOX
      825        SIZE 21.5 BY 1 NO-UNDO.
      826   DEFINE FRAME Dialog-Frame
      827        B-exit AT ROW 1 COL 1
      828        b-quit AT ROW 1 COL 11
      829        b-rec-print AT ROW 2.57 COL 43 WIDGET-ID 34
      830        B-Help AT ROW 1 COL 95
      831        t-salesman-mandatory AT ROW 4 COL 14 WIDGET-ID 156
      832        cb-pos-type-for-discnt AT ROW 6.33 COL 35 COLON-ALIGNED WIDGET-ID 158
      833        B-main AT ROW 2.57 COL 1 WIDGET-ID 14
      834        t-rcpt-ord-slip-print AT ROW 8 COL 18 WIDGET-ID 198
      835        t-rcpt-ord-alt-print AT ROW 9 COL 18 WIDGET-ID 200
      836        f-main AT ROW 2.93 COL 2.5 NO-LABEL WIDGET-ID 18
      837        f-rec-print AT ROW 2.93 COL 44.5 NO-LABEL WIDGET-ID 36
      838        SPACE(43.79) SKIP(18.80)
      839       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      840            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      841            TITLE "Настройки по умолчанию и опции работы POS IBS TH-MOB"
      842            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      843   ASSIGN
      844          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      845          FRAME Dialog-Frame:HIDDEN           = TRUE.
      846   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      847   DO:
      848     APPLY "END-ERROR":U TO SELF.
      849   END.
      850   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      851   DO:
      852     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      853     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      854     p-setted = yes.
      855   END.
      856   ON CHOOSE OF B-main IN FRAME Dialog-Frame
      857   DO:
      858      run proc-init-main in this-procedure .
      859   END.
      860   ON CHOOSE OF b-rec-print IN FRAME Dialog-Frame
      861   DO:
      862   run proc-init-rec-print in this-procedure .
      863   END.
      864   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      865   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      866   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      867   on help of frame Dialog-Frame
      868   do:
      869     run gbl/app_help.p
      870       (input this-procedure :file-name
      871       ,input ''
      872       ,input ?
      873       ) no-error.
      874     if error-status :error then do:
      875       message
      876         "Ошибка при вызове помощи"
      877         error-status :get-message(1)
      878         view-as alert-box .
      879     end.
      880   end.
      881   run minbtn-set in this-procedure .
      882   on choose of b-help in frame Dialog-Frame
      883   do:
      884     apply "help":u to frame Dialog-Frame .
      885   end.
      886   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      887   procedure minbtn-set :
      888       do
      889           on error undo, return error return-value
      890           :
      891           define variable ii              as integer       no-undo .
      892           define variable fh              as widget-handle no-undo .
      893           define variable hh              as widget-handle no-undo .
      894           define variable v-h             as handle        extent 4 no-undo .
      895           define variable v-name-button   as character     no-undo .
      896           define variable v-help-old-x    as decimal       no-undo .
      897           define variable v-help-old-y    as decimal       no-undo .
      898           define variable v-help-old-size as decimal       no-undo .
      899           define variable v-frame-width   as decimal       no-undo .
      900           define variable jj              as integer       no-undo .
      901           do
      902               on error undo, return error
      903               :
      904               assign
      905                   v-frame-width = frame Dialog-Frame:width - 0.3
      906                   fh            = frame Dialog-Frame:first-child
      907                   hh            = fh:first-child
      908                   ii            = 1
      909                   .
      910               do while valid-handle(hh):
      911                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      912                   do:
      913                       case lc(hh:name) :
      914                           when "b-help" then
      915                               do:
      916                                   hh:load-image-up("cmp/b-help.bmp":u) .
      917                                   hh:load-image-down("cmp/b-help.bmp":u) .
      918                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      919                                   hh:TOOLTIP = "Помощь" .
      920                                   v-help-old-x = hh:column .
      921                                   v-help-old-y = hh:row    .
      922                                   v-help-old-size = hh:width .
      923                                   hh:width-chars = 2.5 .
      924                               end.
      925                           when "b-print" then
      926                               do:
      927                                   hh:load-image("cmp/b-print.bmp":u) .
      928                                   hh:TOOLTIP = "Печать" .
      929                                   v-h[ii] = hh:handle .
      930                                   ii = ii + 1 .
      931                                   hh:width-chars = 3 .
      932                               end.
      933                           when "b-history" or
      934                           when "b-hist" then
      935                               do:
      936                                   hh:load-image("cmp/b-hist.bmp":u) .
      937                                   hh:TOOLTIP = "История" .
      938                                   v-h[ii] = hh:handle .
      939                                   ii = ii + 1 .
      940                                   hh:width-chars = 3 .
      941                               end.
      942                           when "b-sch" then
      943                               do:
      944                                   hh:load-image("cmp/b-sch.bmp":u) .
      945                                   hh:TOOLTIP = "Установка Фильтра" .
      946                                   v-h[ii] = hh:handle .
      947                                   ii = ii + 1 .
      948                                   hh:width-chars = 3 .
      949                               end.
      950                           when "b-hist-user" then
      951                               do:
      952                                   hh:load-image("cmp/b-hist.bmp":u) .
      953                                   hh:TOOLTIP = "История пользователя" .
      954                                   ii = ii + 1 .
      955                               end.
      956                       end case.
      957                   end.
      958                   hh = hh:next-sibling.
      959               end.
      960               b-help:column = v-frame-width - b-help:width-chars.
      961               jj = 0.
      962               repeat ii = 4 to 1 by -1 :
      963                   if valid-handle (v-h[ii] ) then
      964                   do:
      965                       jj  = jj + 1 .
      966                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      967                       v-h[ii]:row    = v-help-old-y .
      968                   end.
      969               end.
      970           end.
      971       end.
      972   end procedure.
      973   MAIN-BLOCK:
      974   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      975      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      976      ON STOP UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      977      :
      978   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      979     run mainmenu_getcntxt in parparentproc
      980       (output v-cntxt-db-num
      981       ,output v-cntxt-userid
      982       ,output v-cntxt-level
      983       ,output v-cntxt-host-code-obj
      984       ,output v-cntxt-obj-type
      985       ,output v-cntxt-obj-code
      986       ,output v-cntxt-db-num-obj
      987       ,output v-cntxt-is-admin
      988       ) .
      989   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      990   ON TAB ANYWHERE
      991   DO:
      992   define variable ii as integer no-undo .
      993   define variable fh as widget-handle no-undo .
      994   define variable hh as widget-handle no-undo .
      995   define variable v-next-widget-name as character no-undo .
      996   if v-current-tab-order <> '' then do:
      997     if self:type = "TOGGLE-BOX" then
      998     self:BGCOLOR = ?.
      999     assign
     1000     ii = lookup(self:name, v-current-tab-order).
     1001     assign
     1002     ii = ii + 1
     1003     v-next-widget-name = entry(ii, v-current-tab-order)
     1004     no-error .
     1005     if error-status:error then do:
     1006       assign
     1007       ii = 1
     1008       v-next-widget-name = entry( ii, v-current-tab-order)
     1009       .
     1010     end.
     1011     assign
     1012     fh = frame Dialog-Frame:first-child
     1013     hh = fh:first-child
     1014     .
     1015     do while valid-handle(hh):
     1016       if hh:name = v-next-widget-name then do:
     1017         if hh:sensitive  = yes
     1018         AND hh:visible = yes then do:
     1019           if hh:type = "TOGGLE-BOX":U then do:
     1020             assign
     1021             hh:BGcolor = 1
     1022             .
     1023           end.
     1024           APPLY "ENTRY" to hh.
     1025           return no-apply.
     1026         end.
     1027         else do:
     1028           APPLY "TAB" to hh.
     1029           return no-apply.
     1030         end.
     1031       end.
     1032       hh = hh:next-sibling.
     1033     end.
     1034   end.
     1035   END.
     1036   ON BACK-TAB ANYWHERE
     1037   DO:
     1038   define variable ii as integer no-undo .
     1039   define variable fh as widget-handle no-undo .
     1040   define variable hh as widget-handle no-undo .
     1041   define variable v-next-widget-name as character no-undo .
     1042   if v-current-tab-order <> '' then do:
     1043     assign
     1044     ii = lookup(self:name, v-current-tab-order).
     1045     .
     1046     assign
     1047     ii = (if ii = 1
     1048           then  num-entries(v-current-tab-order)
     1049           else ii - 1
     1050           )
     1051     v-next-widget-name = entry(ii, v-current-tab-order)
     1052     .
     1053     assign
     1054     fh = frame Dialog-Frame:first-child
     1055     hh = fh:first-child
     1056     .
     1057     do while valid-handle(hh):
     1058       if hh:name = v-next-widget-name then do:
     1059         if hh:sensitive  = yes
     1060         AND hh:visible = yes then do:
     1061           if hh:type = "TOGGLE-BOX":U then do:
     1062             assign
     1063             hh:BGcolor = 1
     1064             .
     1065           end.
     1066           APPLY "ENTRY" to hh.
     1067           return no-apply.
     1068         end.
     1069         else do:
     1070         APPLY "BACK-TAB" to hh.
     1071         return no-apply.
     1072         end.
     1073       end.
     1074       hh = hh:next-sibling.
     1075     end.
     1076     end.
     1077   END.
     1078   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1079   ON RETURN ANYWHERE
     1080   DO:
     1081   define variable ii as integer no-undo .
     1082   define variable fh as widget-handle no-undo .
     1083   define variable hh as widget-handle no-undo .
     1084   define variable v-next-widget-name as character no-undo .
     1085     if v-current-tab-order <> '' then do:
     1086       assign
     1087       ii = lookup(self:name, v-current-tab-order).
     1088       if ii = num-entries(v-current-tab-order) then do:
     1089           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     1090           return no-apply.
     1091       end.
     1092       if self:type <> "BUTTON" and
     1093         self:type <> "EDITOR"  then do:
     1094         run proc-move-forward in this-procedure .
     1095         return no-apply.
     1096       end.
     1097       if self:type = "BUTTON" then do:
     1098         APPLY "CHOOSE" to self.
     1099       end.
     1100       if self:type = "TOGGLE-BOX" then
     1101       self:BGCOLOR = ?.
     1102       assign
     1103       ii = ii + 1
     1104       v-next-widget-name = entry(ii, v-current-tab-order)
     1105       no-error .
     1106       if error-status:error then do:
     1107         assign
     1108         ii = 1
     1109         v-next-widget-name = entry( ii, v-current-tab-order)
     1110         .
     1111       end.
     1112       assign
     1113       fh = frame Dialog-Frame:first-child
     1114       hh = fh:first-child
     1115       .
     1116       do while valid-handle(hh):
     1117         if hh:name = v-next-widget-name then do:
     1118           if hh:sensitive  = yes
     1119           AND hh:visible = yes then do:
     1120             if hh:type = "TOGGLE-BOX":U then do:
     1121               assign
     1122               hh:BGcolor = 1
     1123               .
     1124             end.
     1125             APPLY "ENTRY" to hh.
     1126             return no-apply.
     1127           end.
     1128           else do:
     1129             APPLY "TAB" to hh.
     1130             return no-apply.
     1131           end.
     1132         end.
     1133         hh = hh:next-sibling.
     1134       end.
     1135     end.
     1136   END.
     1137   procedure proc-move-forward :
     1138   define variable ii as integer no-undo .
     1139   define variable fh as widget-handle no-undo .
     1140   define variable hh as widget-handle no-undo .
     1141   define variable v-next-widget-name as character no-undo .
     1142   do
     1143   on error undo, return error
     1144   :
     1145     if v-current-tab-order <> '' then do:
     1146       if self:type = "TOGGLE-BOX" then
     1147       self:BGCOLOR = ?.
     1148       assign
     1149       ii = lookup(self:name, v-current-tab-order).
     1150       assign
     1151       ii = ii + 1
     1152       v-next-widget-name = entry(ii, v-current-tab-order)
     1153       no-error .
     1154       if error-status:error then do:
     1155         assign
     1156         ii = 1
     1157         v-next-widget-name = entry( ii, v-current-tab-order)
     1158         .
     1159       end.
     1160       assign
     1161       fh = frame Dialog-Frame:first-child
     1162       hh = fh:first-child
     1163       .
     1164       do while valid-handle(hh):
     1165         if hh:name = v-next-widget-name then do:
     1166           if hh:sensitive  = yes
     1167           AND hh:visible = yes then do:
     1168             if hh:type = "TOGGLE-BOX":U then do:
     1169               assign
     1170               hh:BGcolor = 1
     1171               .
     1172             end.
     1173             APPLY "ENTRY" to hh.
     1174             return.
     1175           end.
     1176           else do:
     1177             assign
     1178             ii = ii + 1
     1179             v-next-widget-name = entry(ii, v-current-tab-order)
     1180             no-error .
     1181             if error-status:error then do:
     1182               assign
     1183               ii = 1
     1184               v-next-widget-name = entry( ii, v-current-tab-order)
     1185               .
     1186             end.
     1187           end.
     1188         end.
     1189         hh = hh:next-sibling.
     1190       end.
     1191     end.
     1192   end.
     1193   end procedure.
     1194     IF p-mode <> 'ПРОСМОТР':U
     1195     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     1196         MESSAGE
     1197         vss-workfile vss-revision vss-description skip
     1198         "Неверное значение параметра p-mode" p-mode
     1199         VIEW-AS ALERT-BOX ERROR.
     1200         UNDO, RETURN ERROR.
     1201     END.
     1202     IF p-obj-type <> 'маг':U
     1203     THEN DO:
     1204         MESSAGE
     1205         vss-workfile vss-revision vss-description skip
     1206         "Неверное значение параметра p-obj-type" p-obj-type
     1207         VIEW-AS ALERT-BOX ERROR.
     1208         UNDO, RETURN ERROR.
     1209     END.
     1210     if p-obj-type = 'маг':U then do:
     1211       FIND FIRST X_shop NO-LOCK WHERE X_shop.obj-code = p-obj-code NO-ERROR.
     1212       IF NOT AVAILABLE X_shop THEN DO:
     1213           MESSAGE
     1214           vss-workfile vss-revision vss-description skip
     1215           "Неверное значение параметра p-obj-code" p-obj-code
     1216           VIEW-AS ALERT-BOX ERROR.
     1217           UNDO, RETURN ERROR.
     1218       END.
     1219   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1220   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1221     (input  'маг':U
     1222     ,input  p-obj-code
     1223     ,output v-db-num
     1224     )  .
     1225       IF v-db-num <> v-cntxt-db-num
     1226       AND v-cntxt-db-num <> 0
     1227       and p-mode <> 'ПРОСМОТР':U
     1228       THEN DO:
     1229           MESSAGE
     1230           "Нельзя менять параметры кассы в чужой БД" skip
     1231           "магазин принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     1232           VIEW-AS ALERT-BOX ERROR.
     1233           UNDO, RETURN ERROR.
     1234       END.
     1235   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1236   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1237     (input  p-obj-type
     1238     ,input  p-obj-code
     1239     ,output v-host-code
     1240     )  .
     1241     end.
     1242     hide
     1243     frame Dialog-Frame.
     1244     FIND FIRST locked_cash-desk no-LOCK WHERE
     1245             locked_cash-desk.db-num = p-db-num
     1246       AND   locked_cash-desk.obj-code = p-obj-code
     1247       AND   locked_cash-desk.pos-type = p-pos-type
     1248       AND   locked_cash-desk.cash-num = p-cash-num
     1249       NO-ERROR.
     1250     if not available locked_cash-desk then do:
     1251       message
     1252       substitute("Нет POS &1 на БД &2 &3&4 №&5"
     1253                  , p-pos-type
     1254                  , p-db-num
     1255                  , 'маг':U
     1256                  , p-obj-code
     1257                  , p-cash-num)
     1258       view-as alert-box error.
     1259       undo, return error .
     1260     end.
     1261     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     1262       FIND FIRST locked_cash-desk-attr EXCLUSIVE-LOCK WHERE
     1263                 locked_cash-desk-attr.db-num = p-db-num
     1264           AND   locked_cash-desk-attr.obj-code = p-obj-code
     1265           AND   locked_cash-desk-attr.pos-type = p-pos-type
     1266           AND   locked_cash-desk-attr.cash-num = p-cash-num
     1267           AND   locked_cash-desk-attr.upper-attr-code = ''
     1268           AND   locked_cash-desk-attr.attr-code = ''
     1269           NO-WAIT NO-ERROR.
     1270       if not available locked_cash-desk-attr
     1271       and not locked locked_cash-desk-attr then do:
     1272         create locked_cash-desk-attr.
     1273         assign
     1274         locked_cash-desk-attr.db-num = p-db-num
     1275         locked_cash-desk-attr.obj-code = p-obj-code
     1276         locked_cash-desk-attr.pos-type = p-pos-type
     1277         locked_cash-desk-attr.cash-num = p-cash-num
     1278         locked_cash-desk-attr.upper-attr-code = ''
     1279         locked_cash-desk-attr.attr-code = ''
     1280         .
     1281        end.
     1282        if locked locked_cash-desk-attr then do:
     1283           FIND FIRST locked_cash-desk-attr EXCLUSIVE-LOCK WHERE
     1284                     locked_cash-desk-attr.db-num = p-db-num
     1285               AND   locked_cash-desk-attr.obj-code = p-obj-code
     1286               AND   locked_cash-desk-attr.pos-type = p-pos-type
     1287               AND   locked_cash-desk-attr.cash-num = p-cash-num
     1288               AND   locked_cash-desk-attr.upper-attr-code = ''
     1289               AND   locked_cash-desk-attr.attr-code = ''
     1290                NO-ERROR.
     1291         end.
     1292     END.
     1293     RUN FILL-WIDGETS IN THIS-PROCEDURE NO-ERROR.
     1294     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     1295     RUN Myenable.
     1296     WAIT-FOR GO OF FRAME Dialog-Frame.
     1297   END.
     1298   RUN disable_UI.
     1299   PROCEDURE disable_UI :
     1300     HIDE FRAME Dialog-Frame.
     1301   END PROCEDURE.
     1302   PROCEDURE enable_UI :
     1303     DISPLAY t-salesman-mandatory cb-pos-type-for-discnt t-rcpt-ord-slip-print
     1304             t-rcpt-ord-alt-print f-main f-rec-print
     1305         WITH FRAME Dialog-Frame.
     1306     ENABLE B-exit b-quit b-rec-print B-Help t-salesman-mandatory
     1307            cb-pos-type-for-discnt B-main t-rcpt-ord-slip-print
     1308            t-rcpt-ord-alt-print f-main f-rec-print
     1309         WITH FRAME Dialog-Frame.
     1310     VIEW FRAME Dialog-Frame.
     1311   END PROCEDURE.
     1312   PROCEDURE fill-widgets :
     1313   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     1314   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO.
     1315   define variable v-param-type as character no-undo .
     1316   define variable v-param-value as character no-undo .
     1317   define variable v-value-character as character no-undo .
     1318   define variable v-value-date as date no-undo .
     1319   define variable v-value-decimal as decimal no-undo .
     1320   define variable v-value-integer as INTEGER no-undo .
     1321   define variable v-value-logical AS LOGICAL no-undo .
     1322   DEFINE VARIABLE v-dop1 AS CHARACTER NO-UNDO.
     1323   DEFINE VARIABLE v-fr-code AS integer NO-UNDO.
     1324   DEFINE VARIABLE v-cp-list AS character NO-UNDO.
     1325   DEFINE VARIABLE v-name AS character NO-UNDO.
     1326   DEFINE VARIABLE v-ii AS integer NO-UNDO.
     1327   DEFINE VARIABLE v-jj AS integer NO-UNDO.
     1328   define buffer buf_cash-desk-attr for ub.cash-desk-attr.
     1329   DEFINE BUFFER buf_currency FOR ub.currency.
     1330   FOR EACH thbjattr_thbj-attr:
     1331     delete thbjattr_thbj-attr.
     1332   end.
     1333   FOR EACH temp-thbj-attr:
     1334     delete temp-thbj-attr.
     1335   end.
     1336   run adm/shattri.p (
     1337                 input "init":U
     1338               , input p-obj-type
     1339               , input p-obj-code
     1340               , input 'cd-type-IBS-TH-MOB':U
     1341               , input "":U
     1342               , output v-value-character
     1343               , output v-value-date
     1344               , output v-value-decimal
     1345               , output v-value-integer
     1346               , output v-value-logical
     1347               , output v-param-type
     1348               , INPUT-OUTPUT TABLE-handle v-tth
     1349               ) no-error .
     1350   if error-status:error
     1351   and not available locked_cash-desk then do:
     1352     message
     1353     "Не удалось получить начальные значения настроек" skip
     1354     error-status:get-message(1) return-value
     1355     view-as alert-box error .
     1356     undo, return error .
     1357   end.
     1358   for each buf_Cash-desk-attr no-lock where
     1359           buf_cash-desk-attr.db-num = p-db-num
     1360        and buf_cash-desk-attr.obj-code = p-obj-code
     1361        and buf_cash-desk-attr.pos-type = p-pos-type
     1362        and buf_cash-desk-attr.cash-num = p-cash-num
     1363        :
     1364     find first thbjattr_thbj-attr where
     1365               thbjattr_thbj-attr.obj-type = 'маг':U
     1366           and thbjattr_thbj-attr.obj-code = p-obj-code
     1367           and thbjattr_thbj-attr.upper-prop-code  = buf_cash-desk-attr.upper-attr-code
     1368           and thbjattr_thbj-attr.prop-code  = buf_cash-desk-attr.attr-code no-error.
     1369     if not available thbjattr_thbj-attr then do:
     1370       create thbjattr_thbj-attr.
     1371       assign
     1372       thbjattr_thbj-attr.obj-type = 'маг':U
     1373       thbjattr_thbj-attr.obj-code = p-obj-code
     1374       thbjattr_thbj-attr.upper-prop-code  = buf_cash-desk-attr.upper-attr-code
     1375       thbjattr_thbj-attr.prop-code  = buf_cash-desk-attr.attr-code
     1376       .
     1377     end.
     1378     assign
     1379     thbjattr_thbj-attr.property-value-character  = buf_cash-desk-attr.attr-value-character
     1380     thbjattr_thbj-attr.property-value-date  = buf_cash-desk-attr.attr-value-date
     1381     thbjattr_thbj-attr.property-value-decimal  = buf_cash-desk-attr.attr-value-decimal
     1382     thbjattr_thbj-attr.property-value-integer  = buf_cash-desk-attr.attr-value-integer
     1383     thbjattr_thbj-attr.property-value-logical  = buf_cash-desk-attr.attr-value-logical
     1384     thbjattr_thbj-attr.prop-value-type  = buf_cash-desk-attr.attr-value-type
     1385     .
     1386   end.
     1387   FOR EACH thbjattr_thbj-attr:
     1388     ASSIGN
     1389     v-entry = thbjattr_thbj-attr.prop-code.
     1390     CASE thbjattr_thbj-attr.upper-prop-code :
     1391       WHEN 'IBS-TH-MOB_main':U THEN DO:
     1392         CASE v-entry:
     1393          WHEN 'salesman-mandatory':U THEN DO:
     1394             ASSIGN
     1395             t-salesman-mandatory = logical(thbjattr_thbj-attr.property-value-integer)
     1396             t-salesman-mandatory:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1397             .
     1398           END.
     1399          WHEN 'pos-type-for-discnt':U THEN DO:
     1400             ASSIGN
     1401             cb-pos-type-for-discnt = thbjattr_thbj-attr.property-value-character
     1402             cb-pos-type-for-discnt:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1403             .
     1404          END.
     1405        END CASE.
     1406      END.
     1407      WHEN 'IBS-TH-MOB_rec-print':U THEN DO:
     1408        CASE v-entry:
     1409          WHEN 'rcpt-ord-slip-print':U THEN DO:
     1410             ASSIGN
     1411             t-rcpt-ord-slip-print = logical(thbjattr_thbj-attr.property-value-integer)
     1412             t-rcpt-ord-slip-print:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1413             .
     1414          end.
     1415          WHEN 'rcpt-ord-alt-print':U THEN DO:
     1416             ASSIGN
     1417             t-rcpt-ord-alt-print = logical(thbjattr_thbj-attr.property-value-integer)
     1418             t-rcpt-ord-alt-print:private-data in frame Dialog-Frame = "recid=" + string(recid(thbjattr_thbj-attr))
     1419             .
     1420          end.
     1421        END CASE.
     1422      end.
     1423     END CASE.
     1424     create temp-thbj-attr.
     1425     buffer-copy thbjattr_thbj-attr to temp-thbj-attr.
     1426   END.
     1427   END PROCEDURE.
     1428   PROCEDURE MyEnable :
     1429   DEFINE VARIABLE v-h AS HANDLE NO-UNDO.
     1430   DEFINE VARIABLE v-h1 AS HANDLE NO-UNDO.
     1431   DEFINE VARIABLE v-ii AS integer NO-UNDO.
     1432   DEFINE VARIABLE v-jj AS integer NO-UNDO.
     1433   define variable wh as widget-handle no-undo .
     1434   define variable fh as widget-handle no-undo .
     1435   ASSIGN
     1436   FRAME Dialog-Frame:TITLE = substitute("&1 &2&3"
     1437                                          ,FRAME Dialog-Frame:TITLE
     1438                                          ,(if p-obj-type = ""
     1439                                            then ""
     1440                                            else 'маг':U)
     1441                                          ,(IF p-obj-type = "" THEN "" ELSE string(p-obj-code)))
     1442   cb-pos-type-for-discnt:LIST-ITEMS = 'IBS-TH':U + chr(44) + 'IBS-TH-MOB':U
     1443   v-tab-order[1] = "t-salesman-mandatory,cb-pos-type-for-discnt"
     1444   v-labels[1] = ''
     1445   v-tab-order[2] = "t-rcpt-ord-slip-print,t-rcpt-ord-alt-print"
     1446   v-labels[2] = ''
     1447   .
     1448   v-h = FRAME Dialog-Frame:FIRST-CHILD.
     1449   DO WHILE valid-handle(v-h).
     1450     IF v-h:TYPE = "field-group"  THEN DO:
     1451        v-h1 = v-h:FIRST-CHILD.
     1452        DO WHILE valid-handle(v-h1).
     1453         RUN tempwidg_create-record IN THIS-PROCEDURE ( INPUT v-h1).
     1454         ASSIGN
     1455         v-h1 = v-h1:NEXT-sibling.
     1456       END.
     1457     END.
     1458     v-h = v-h:NEXT-SIBLING.
     1459   END.
     1460   DO v-ii = 1 TO 5:
     1461     IF v-tab-order[v-ii] > '' THEN do:
     1462       DO v-jj = 1 TO NUM-ENTRIES(v-tab-order[v-ii]):
     1463        FIND FIRST temp-widget WHERE
     1464                   temp-widget.name_ = ENTRY(v-jj,v-tab-order[v-ii]) NO-ERROR.
     1465        IF AVAILABLE temp-widget THEN DO:
     1466            temp-widget.section_ = STRING(v-ii).
     1467        END.
     1468       END.
     1469     END.
     1470     IF v-labels[v-ii] > '' THEN do:
     1471       DO v-jj = 1 TO NUM-ENTRIES(v-labels[v-ii]):
     1472        FIND FIRST temp-widget WHERE
     1473                   temp-widget.name_ = ENTRY(v-jj,v-labels[v-ii]) NO-ERROR.
     1474        IF AVAILABLE temp-widget THEN DO:
     1475           temp-widget.section_ = STRING(v-ii).
     1476         END.
     1477       END.
     1478     END.
     1479   END.
     1480   DISPLAY
     1481   f-main
     1482   f-rec-print
     1483   WITH FRAME Dialog-Frame.
     1484   assign
     1485   fh = frame Dialog-Frame:first-child
     1486   wh = fh:first-child
     1487   .
     1488   do while valid-handle(wh):
     1489   if wh:private-data begins "recid=" then do:
     1490     find first thbjattr_thbj-attr where
     1491               recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     1492     IF wh:DATA-TYPE = 'logical':U
     1493     AND thbjattr_thbj-attr.prop-value-type = 'integer':U THEN DO:
     1494        wh:screen-value = string(IF thbjattr_thbj-attr.property-value-integer = 1 THEN YES ELSE NO).
     1495     END.
     1496     ELSE DO:
     1497       assign
     1498       wh:screen-value = string(buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value).
     1499     END.
     1500   end.
     1501   ELSE DO:
     1502      FIND FIRST temp-widget NO-LOCK WHERE
     1503                temp-widget.NAME_ = wh:NAME NO-ERROR.
     1504      IF AVAILABLE temp-widget THEN DO:
     1505         CASE temp-widget.DATA-TYPE_:
     1506           WHEN 'character':U THEN DO:
     1507               ASSIGN
     1508               wh:SCREEN-VALUE = temp-widget.CHARACTER_.
     1509           END.
     1510         END CASE.
     1511      END.
     1512   END.
     1513   wh = wh:next-sibling.
     1514   end.
     1515   ENABLE
     1516   B-exit WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1517   b-quit
     1518   B-Help
     1519   b-main
     1520   b-rec-print
     1521   t-salesman-mandatory WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1522   cb-pos-type-for-discnt WHEN p-mode = 'ИЗМЕНЕНИЕ':U
     1523   t-rcpt-ord-slip-print
     1524   t-rcpt-ord-alt-print
     1525   WITH FRAME Dialog-Frame.
     1526   VIEW FRAME Dialog-Frame.
     1527   IF p-mode = 'ПРОСМОТР':U THEN DO:
     1528       HIDE
     1529       b-exit
     1530       IN FRAME Dialog-Frame.
     1531       ASSIGN
     1532       b-quit:LABEL = "&Выход"
     1533       b-quit:COLUMN = 1
     1534       .
     1535   END.
     1536   APPLY "CHOOSE" TO b-main.
     1537   END PROCEDURE.
     1538   PROCEDURE proc-init-main :
     1539   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     1540   DO on error undo, return error return-value:
     1541    b-main:LOAD-IMAGE-UP("adeicon\ts-up110":U)           in frame Dialog-Frame .
     1542    b-rec-print:LOAD-IMAGE-Up("adeicon\ts-dn110":U)      in frame Dialog-Frame .
     1543    f-main:fgcolor = 1   .
     1544    f-rec-print:fgcolor = ?.
     1545    FOR EACH temp-widget WHERE
     1546           temp-widget.SECTION_ = "1":
     1547      ASSIGN
     1548       temp-widget.HANDLE_:VISIBLE = YES.
     1549   END.
     1550   FOR EACH temp-widget WHERE
     1551           temp-widget.SECTION_ <> "1"
     1552       AND temp-widget.SECTION_ <> "":
     1553      ASSIGN
     1554       temp-widget.HANDLE_:VISIBLE = no.
     1555    END.
     1556    .
     1557    v-current-tab-order = v-tab-order[1].
     1558   end.
     1559   END PROCEDURE.
     1560   PROCEDURE proc-init-rec-print :
     1561   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     1562   DO on error undo, return error return-value:
     1563    b-main:LOAD-IMAGE-UP("adeicon\ts-dn110":U)           in frame Dialog-Frame .
     1564    b-rec-print:LOAD-IMAGE-Up("adeicon\ts-up110":U)      in frame Dialog-Frame .
     1565    f-main:fgcolor = ?   .
     1566    f-rec-print:fgcolor = 1.
     1567    FOR EACH temp-widget WHERE
     1568           temp-widget.SECTION_ = "2":
     1569      ASSIGN
     1570       temp-widget.HANDLE_:VISIBLE = YES.
     1571   END.
     1572   FOR EACH temp-widget WHERE
     1573           temp-widget.SECTION_ <> "2"
     1574       AND temp-widget.SECTION_ <> "":
     1575      ASSIGN
     1576       temp-widget.HANDLE_:VISIBLE = no.
     1577    END.
     1578    .
     1579    v-current-tab-order = v-tab-order[2].
     1580   end.
     1581   END PROCEDURE.
     1582   PROCEDURE proc-save :
     1583   define variable v-value-character as character no-undo .
     1584   define variable v-value-date as date no-undo .
     1585   define variable v-value-decimal as decimal no-undo .
     1586   define variable v-value-integer as INTEGER no-undo .
     1587   define variable v-value-logical AS LOGICAL no-undo .
     1588   define variable v-param-type as character no-undo .
     1589   define variable wh as widget-handle no-undo .
     1590   define variable fh as widget-handle no-undo .
     1591   define variable v-same as logical no-undo .
     1592   define variable v-loc-same as logical no-undo .
     1593   IF p-mode = 'ПРОСМОТР':U THEN RETURN ERROR.
     1594   assign
     1595   fh = frame Dialog-Frame:first-child
     1596   wh = fh:first-child
     1597   .
     1598     main-block:
     1599     do transaction:
     1600     do while valid-handle(wh):
     1601       if wh:private-data begins "recid=" then do:
     1602         find first thbjattr_thbj-attr where
     1603                   recid(thbjattr_thbj-attr) = integer(entry(2, wh:private-data, '=')).
     1604         IF wh:DATA-TYPE = 'logical':U
     1605         AND thbjattr_thbj-attr.prop-value-type = 'integer':U THEN DO:
     1606           assign
     1607           thbjattr_thbj-attr.property-value-integer = (IF wh:INPUT-VALUE = YES THEN 1 ELSE 0).
     1608         END.
     1609         ELSE DO:
     1610           assign
     1611           buffer thbjattr_thbj-attr:buffer-field("property-value-" + wh:data-type):buffer-value = wh:input-value.
     1612         END.
     1613       end.
     1614       wh = wh:next-sibling.
     1615     end.
     1616     for each thbjattr_thbj-attr
     1617     break by thbjattr_thbj-attr.upper-prop-code
     1618     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1619     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     1620     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     1621     :
     1622       if first-of(thbjattr_thbj-attr.upper-prop-code) then do:
     1623         empty temp-table thbjattr___thbj-attr.
     1624       end.
     1625       create thbjattr___thbj-attr.
     1626       buffer-copy
     1627       thbjattr_thbj-attr
     1628       to
     1629       thbjattr___thbj-attr.
     1630     end.
     1631     v-same = yes.
     1632     for each thbjattr_thbj-attr,
     1633         first temp-thbj-attr where
     1634               temp-thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     1635           and temp-thbj-attr.obj-code = thbjattr_thbj-attr.obj-code
     1636           and temp-thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     1637           and temp-thbj-attr.prop-code = thbjattr_thbj-attr.prop-code
     1638     break
     1639     by thbjattr_thbj-attr.upper-prop-code :
     1640       buffer-compare
     1641       thbjattr_thbj-attr
     1642       to temp-thbj-attr
     1643       save result in v-loc-same.
     1644       if v-loc-same = no then do:
     1645         if  thbjattr_thbj-attr.upper-prop-code <> 'cd-type-IBS-TH-MOB':U
     1646         then do:
     1647           run update-cda in this-procedure ( buffer thbjattr_thbj-attr).
     1648         end.
     1649       end.
     1650     end.
     1651   end.
     1652   v-same = no.
     1653   END PROCEDURE.
     1654   PROCEDURE update-cda :
     1655   DEFINE PARAMETER BUFFER buf_thbjattr_thbj-attr FOR thbjattr_thbj-attr.
     1656   define buffer buf_cash-desk-attr for ub.cash-desk-attr.
     1657   find first   buf_cash-desk-attr share-lock where
     1658         buf_cash-desk-attr.db-num = locked_Cash-desk.db-num
     1659     and buf_cash-desk-attr.obj-code = locked_Cash-desk.obj-code
     1660     and buf_cash-desk-attr.pos-type = locked_Cash-desk.pos-type
     1661     and buf_cash-desk-attr.cash-num = locked_cash-desk.cash-num
     1662     and buf_cash-desk-attr.upper-attr-code = buf_thbjattr_thbj-attr.upper-prop-code
     1663   and buf_cash-desk-attr.attr-code = buf_thbjattr_thbj-attr.prop-code
     1664   no-error.
     1665   if not available buf_Cash-desk-attr then do:
     1666     create buf_cash-desk-attr.
     1667     assign
     1668     buf_cash-desk-attr.db-num = locked_Cash-desk.db-num
     1669     buf_cash-desk-attr.obj-code = locked_Cash-desk.obj-code
     1670     buf_cash-desk-attr.pos-type = locked_Cash-desk.pos-type
     1671     buf_cash-desk-attr.cash-num = locked_cash-desk.cash-num
     1672     buf_cash-desk-attr.upper-attr-code = buf_thbjattr_thbj-attr.upper-prop-code
     1673     buf_cash-desk-attr.attr-code = buf_thbjattr_thbj-attr.prop-code
     1674     .
     1675   end.
     1676   assign
     1677   buf_cash-desk-attr.attr-value-character = buf_thbjattr_thbj-attr.property-value-character
     1678   buf_cash-desk-attr.attr-value-date = buf_thbjattr_thbj-attr.property-value-date
     1679   buf_cash-desk-attr.attr-value-decimal = buf_thbjattr_thbj-attr.property-value-decimal
     1680   buf_cash-desk-attr.attr-value-integer = buf_thbjattr_thbj-attr.property-value-integer
     1681   buf_cash-desk-attr.attr-value-logical = buf_thbjattr_thbj-attr.property-value-logical
     1682   buf_cash-desk-attr.attr-value-type = buf_thbjattr_thbj-attr.prop-value-type
     1683   .
     1684   END PROCEDURE.
