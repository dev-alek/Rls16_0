      385   do
      386   on error undo, return error return-value
      387   :
      388       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      389       (input  p-upper-code
      390       ,input  p-code
      391       ,output p-label
      392       ,output p-user-can-edit
      393       ,output p-output-display
      394       ,output p-other
      395       ,output p-prop-list
      396       ,output p-prop-type-list
      397       ,output p-prop-label-list
      398       ,output p-global
      399       ,output p-host
      400       ,output p-shop
      401       ,output p-store
      402       ,output p-db
      403       ,output p-region
      404       ) no-error .
      405     if error-status :error
      406     then do:
      407       undo, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message (1)).
