      621   procedure proc-alt-shift-f2:
      622     if not ibs.th.gbl.gbl-var:rcode
      623   then
      624     run gbl\inidebug.p .
      625   end.
      626   procedure proc-alt-shift-f3:
      627     run gbl/prvssinf.p
      628       ( input this-procedure
      629       ) .
      630   end.
      631   define variable v-inform-launched as logical no-undo initial false .
      632   procedure proc-alt-shift-f4:
      633     define variable v-action as character no-undo .
      634     if v-inform-launched = false then do:
      635       assign
      636         v-inform-launched = true
      637       .
      638       run gbl/d-inform.w
      639         (  input self
      640         ,  input this-procedure
      641         , output v-action
      642         ) no-error .
      643       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      644       assign
      645         v-inform-launched = false
      646       .
      647     end.
      648   end.
      649   procedure proc-alt-f1:
      650     run gbl/corrhelp.p
      651       (input this-procedure
      652       ) .
      653   end .
      654   on alt-shift-f2 anywhere do:
      655     run proc-alt-shift-f2.
      656   end.
      657   on alt-shift-f3 anywhere do:
      658     run proc-alt-shift-f3 in this-procedure .
      659   end.
      660   on alt-shift-f4 anywhere do:
      661     run proc-alt-shift-f4 in this-procedure.
      662   end.
      663   on alt-f1 anywhere do:
      664     run proc-alt-f1 in this-procedure .
      665   end.
