      485   procedure thbjattr_get-section :
      486   define input  parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
      487   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
      488   define input  parameter p-upper-param-code  like ub.thbj-attr.upper-prop-code  no-undo .
