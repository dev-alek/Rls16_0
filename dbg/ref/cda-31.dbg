      760   DEFINE VARIABLE v-current-tab-order AS CHARACTER NO-UNDO .
      761   DEFINE VARIABLE v-to-create AS logical NO-UNDO.
      762   DEFINE VARIABLE v-host-code AS INTEGER NO-UNDO.
