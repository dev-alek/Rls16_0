      766   define variable v-tth_main as handle NO-UNDO .
      767   define variable v-tth_devices as handle NO-UNDO .
      768   define variable v-tth_fisreg as handle NO-UNDO .
      769   define variable v-tth_rec-print as handle NO-UNDO .
