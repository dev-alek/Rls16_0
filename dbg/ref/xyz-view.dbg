     2430   function fnc-convert-dot-to-colon returns character
     2431       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     2432   function fnc-convert-dot-to-colon returns character
     2433   (input p-data as decimal, input p-accur as character, input p-num as integer):
     2434       define variable result as character no-undo.
     2435       define variable v-str-result as character no-undo.
     2436       if p-data = ? then p-data = 0 .
     2437       p-data = round(p-data, p-num).
     2438       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     2439       return v-str-result.
     2440   END FUNCTION.
