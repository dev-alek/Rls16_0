     4554                   '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     4555                   '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
     4556                   '   </style>' skip
     4557                   '  </head>' skip
     4558               .
     4559       put stream OutStr-html unformatted
     4560           '<body>' skip
     4561           '<TABLE name="1"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
     4562           '<thead>' skip
