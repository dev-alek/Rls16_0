     2749     .
     2750   end.
     2751   else do:
     2752     assign
     2753       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid25
     2754     .
     2755   end.
     2756           g-log = browse-goods:refresh() .
     2757           if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     2758               g-log = browse-goods:select-next-row ().
     2759               apply "VALUE-CHANGED" to browse-goods in frame Dialog-Frame.
     2760           end.
     2761       end.
     2762       apply "entry" to browse-goods in frame Dialog-Frame.
     2763   END.
     2764   ON CHOOSE OF B-ord IN FRAME Dialog-Frame
     2765   DO:
     2766   END.
     2767   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     2768   DO:
     2769     run print-proc ( true  ).
     2770   END.
     2771   ON CHOOSE OF B-save IN FRAME Dialog-Frame
     2772   DO:
     2773     run proc-save.
     2774   END.
     2775   ON CHOOSE OF B-spis-ord IN FRAME Dialog-Frame
     2776   DO:
     2777   define variable v-recid as character no-undo .
     2778   for each doc-list : delete doc-list. end.
     2779     run cus/mdoclist.p ( rid-list ) .
     2780     run cus/dord-doc.w (
     2781     parParentProc
     2782     ,""
     2783     ,?
     2784     ,?
     2785     ,?
     2786     ,?
     2787     , input-output v-recid
     2788     ).
     2789     reposition browse-goods to recid integer(entry(1,rid-list)) no-error.
     2790   END.
     2791   ON ROW-DISPLAY OF BROWSE-goods IN FRAME Dialog-Frame
     2792   DO:
     2793     if available  buf_XYZ-analysis-goods then do:
     2794       run proc-disp-goods in this-procedure .
     2795       if v-Amin = "входит" then  v-Amin:fgcolor  in browse browse-goods  = 4.
     2796       if buf_xyz-analysis-goods.xyzg-xyz = "X" then
     2797          assign
     2798            buf_goods.artic:fgcolor  in browse browse-goods  = 12
     2799            buf_goods.gds-name:fgcolor  in browse browse-goods  = 12
     2800            buf_XYZ-analysis-goods.XYZg-XYZ:fgcolor  in browse browse-goods  = 12
     2801            buf_XYZ-analysis-goods.XYZg-prcnt-for-estimate:fgcolor  in browse browse-goods  = 12
     2802          .
     2803       if buf_xyz-analysis-goods.xyzg-xyz = "Y" then
     2804          assign
     2805            buf_goods.artic:fgcolor  in browse browse-goods  = 9
     2806            buf_goods.gds-name:fgcolor  in browse browse-goods  = 9
     2807            buf_XYZ-analysis-goods.XYZg-XYZ:fgcolor  in browse browse-goods  = 9
     2808            buf_XYZ-analysis-goods.XYZg-prcnt-for-estimate:fgcolor  in browse browse-goods  = 9
     2809          .
     2810     END.
     2811   END.
     2812   ON VALUE-CHANGED OF BROWSE-goods IN FRAME Dialog-Frame
     2813   DO:
     2814     if available  buf_XYZ-analysis-goods then do:
     2815        OPEN QUERY BROWSE-obj       FOR EACH Buf_XYZ-analysis-obj WHERE                Buf_XYZ-analysis-obj.XYZ-id = v-id AND                Buf_XYZ-analysis-obj.db-num = v-db-num                NO-LOCK,                  EACH buf_XYZ-analysis-gds-obj WHERE                buf_XYZ-analysis-gds-obj.obj-type = Buf_XYZ-analysis-obj.obj-type AND                buf_XYZ-analysis-gds-obj.obj-code = Buf_XYZ-analysis-obj.obj-code AND                buf_XYZ-analysis-gds-obj.gds-code = Buf_XYZ-analysis-goods.gds-code AND                buf_XYZ-analysis-gds-obj.XYZ-id   =  v-id AND                buf_XYZ-analysis-gds-obj.db-num   = v-db-num                OUTER-JOIN NO-LOCK,                  EACH Buf_gds-obj-prop WHERE                Buf_gds-obj-prop.obj-type = ub.buf_XYZ-analysis-obj.obj-type AND                Buf_gds-obj-prop.obj-code = ub.buf_XYZ-analysis-obj.obj-code AND                Buf_gds-obj-prop.gds-code = ub.buf_XYZ-analysis-goods.gds-code                OUTER-JOIN NO-LOCK,                 first buf_assortment-matrix WHERE                buf_assortment-matrix.asmt-status        = 0  AND                buf_assortment-matrix.obj-type =  Buf_XYZ-analysis-obj.obj-type AND                buf_assortment-matrix.obj-code =  Buf_XYZ-analysis-obj.obj-code                OUTER-JOIN NO-LOCK,                 FIRST buf_assortment-matrix-goods WHERE                buf_assortment-matrix-goods.asmg-status        = 0  AND                buf_assortment-matrix-goods.asmt-id  =  buf_assortment-matrix.asmt-id AND                buf_assortment-matrix-goods.db-num   =  buf_assortment-matrix.db-num  AND                buf_assortment-matrix-goods.gds-code =  buf_XYZ-analysis-goods.gds-code                OUTER-JOIN NO-LOCK INDEXED-REPOSITION.
     2816     end.
     2817   END.
     2818   ON ROW-DISPLAY OF BROWSE-obj IN FRAME Dialog-Frame
     2819   DO:
     2820    run disp-obj in this-procedure .
     2821   END.
     2822   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2823   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2824   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2825   on help of frame Dialog-Frame
     2826   do:
     2827     run gbl/app_help.p
     2828       (input this-procedure :file-name
     2829       ,input ''
     2830       ,input ?
     2831       ) no-error.
     2832     if error-status :error then do:
     2833       message
     2834         "Ошибка при вызове помощи"
     2835         error-status :get-message(1)
     2836         view-as alert-box .
     2837     end.
     2838   end.
     2839   run minbtn-set in this-procedure .
     2840   on choose of b-help in frame Dialog-Frame
     2841   do:
     2842     apply "help":u to frame Dialog-Frame .
     2843   end.
     2844   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2845   procedure minbtn-set :
     2846       do
     2847           on error undo, return error return-value
     2848           :
     2849           define variable ii              as integer       no-undo .
     2850           define variable fh              as widget-handle no-undo .
     2851           define variable hh              as widget-handle no-undo .
     2852           define variable v-h             as handle        extent 4 no-undo .
     2853           define variable v-name-button   as character     no-undo .
     2854           define variable v-help-old-x    as decimal       no-undo .
     2855           define variable v-help-old-y    as decimal       no-undo .
     2856           define variable v-help-old-size as decimal       no-undo .
     2857           define variable v-frame-width   as decimal       no-undo .
     2858           define variable jj              as integer       no-undo .
     2859           do
     2860               on error undo, return error
     2861               :
     2862               assign
     2863                   v-frame-width = frame Dialog-Frame:width - 0.3
     2864                   fh            = frame Dialog-Frame:first-child
     2865                   hh            = fh:first-child
     2866                   ii            = 1
     2867                   .
     2868               do while valid-handle(hh):
     2869                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2870                   do:
     2871                       case lc(hh:name) :
     2872                           when "b-help" then
     2873                               do:
     2874                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2875                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2876                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2877                                   hh:TOOLTIP = "Помощь" .
     2878                                   v-help-old-x = hh:column .
     2879                                   v-help-old-y = hh:row    .
     2880                                   v-help-old-size = hh:width .
     2881                                   hh:width-chars = 2.5 .
     2882                               end.
     2883                           when "b-print" then
     2884                               do:
     2885                                   hh:load-image("cmp/b-print.bmp":u) .
     2886                                   hh:TOOLTIP = "Печать" .
     2887                                   v-h[ii] = hh:handle .
     2888                                   ii = ii + 1 .
     2889                                   hh:width-chars = 3 .
     2890                               end.
     2891                           when "b-history" or
     2892                           when "b-hist" then
     2893                               do:
     2894                                   hh:load-image("cmp/b-hist.bmp":u) .
     2895                                   hh:TOOLTIP = "История" .
     2896                                   v-h[ii] = hh:handle .
     2897                                   ii = ii + 1 .
     2898                                   hh:width-chars = 3 .
     2899                               end.
     2900                           when "b-sch" then
     2901                               do:
     2902                                   hh:load-image("cmp/b-sch.bmp":u) .
     2903                                   hh:TOOLTIP = "Установка Фильтра" .
     2904                                   v-h[ii] = hh:handle .
     2905                                   ii = ii + 1 .
     2906                                   hh:width-chars = 3 .
     2907                               end.
     2908                           when "b-hist-user" then
     2909                               do:
     2910                                   hh:load-image("cmp/b-hist.bmp":u) .
     2911                                   hh:TOOLTIP = "История пользователя" .
     2912                                   ii = ii + 1 .
     2913                               end.
     2914                       end case.
     2915                   end.
     2916                   hh = hh:next-sibling.
     2917               end.
     2918               b-help:column = v-frame-width - b-help:width-chars.
     2919               jj = 0.
     2920               repeat ii = 4 to 1 by -1 :
     2921                   if valid-handle (v-h[ii] ) then
     2922                   do:
     2923                       jj  = jj + 1 .
     2924                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2925                       v-h[ii]:row    = v-help-old-y .
     2926                   end.
     2927               end.
     2928           end.
     2929       end.
     2930   end procedure.
     2931   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2932   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2933   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2934   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2935   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2936   define variable v-diasize-current-frame-height as decimal   no-undo .
     2937   define variable v-diasize-change-size          as logical   no-undo .
     2938   define variable v-diasize-resize-button        as handle    no-undo .
     2939   define variable v-diasize-wndmax               as logical   no-undo .
     2940   define variable v-diasize-wndstore             as logical   no-undo .
     2941   define variable v-diasize-proc-name            as character no-undo .
     2942   define variable v-diasize-browse-handle        as handle    no-undo .
     2943   define variable v-diasize-browse-number        as integer   no-undo .
     2944   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2945   define temp-table temp-diasize-handle no-undo
     2946     field handle-value  as handle
     2947     field save-position as decimal
     2948     index xpk is primary unique handle-value
     2949     .
     2950   define temp-table temp-browse-handle no-undo
     2951     field browse-type   as character
     2952     field browse-number as integer
     2953     field browse-handle as handle
     2954     field original-size as decimal
     2955     index xpk is primary unique browse-type browse-number
     2956     index xie browse-type browse-handle
     2957   .
     2958   procedure diasize_change-height :
     2959     define input  parameter p-change-value  as decimal   no-undo .
     2960     define input  parameter p-move-resize   as logical   no-undo .
     2961     define variable v-field-group-handle    as handle    no-undo .
     2962     define variable v-object-handle         as handle    no-undo .
     2963     define variable v-frame-height          as decimal   no-undo .
     2964     define variable v-frame-virtual-height  as decimal   no-undo .
     2965     define variable v-browse-height         as decimal   no-undo .
     2966     define variable v-window-height         as decimal   no-undo .
     2967     define variable v-window-virtual-height as decimal   no-undo .
     2968     define variable v-change-sign           as integer   no-undo .
     2969     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2970     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2971     if p-change-value > 0
     2972     then do:
     2973       if frame Dialog-Frame :height + p-change-value
     2974           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2975       then do:
     2976         assign
     2977           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2978                           - (frame Dialog-Frame :height-chars)
     2979         .
     2980         if p-change-value <= 0
     2981         then do:
     2982           run diasize_position-resize-button in this-procedure .
     2983           return .
     2984         end.
     2985       end.
     2986     end.
     2987     if p-change-value < 0
     2988     then do:
     2989       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2990       then do:
     2991         assign
     2992           p-change-value = v-diasize-orig-frame-height
     2993                          - (frame Dialog-Frame :height-chars)
     2994         .
     2995         if p-change-value >= 0
     2996         then do:
     2997           run diasize_position-resize-button in this-procedure .
     2998           return .
     2999         end.
     3000       end.
     3001     end.
     3002     if p-change-value >= 0
     3003     then do:
     3004       assign
     3005         v-change-sign = 1
     3006       .
     3007     end.
     3008     else do:
     3009       assign
     3010         v-change-sign = -1
     3011       .
     3012     end.
     3013     assign
     3014       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3015     .
     3016     if p-change-value = 0
     3017     then do:
     3018       run diasize_position-resize-button in this-procedure .
     3019       return .
     3020     end.
     3021     move_block:
     3022     do
     3023     on error undo move_block, retry move_block
     3024     :
     3025       if retry
     3026       then do:
     3027         do
     3028         on error undo move_block, leave move_block
     3029         :
     3030           if p-change-value > 0
     3031           then do:
     3032             for each buf_temp-diasize-handle
     3033             on error undo, next
     3034             :
     3035               assign
     3036                 v-object-handle = buf_temp-diasize-handle.handle-value
     3037               .
     3038               if v-object-handle <> v-diasize-resize-button
     3039               then do:
     3040                 assign
     3041                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3042                 .
     3043               end.
     3044             end.
     3045             assign
     3046               v-diasize-browse-handle :height = v-browse-height
     3047             .
     3048             for each buf_temp-browse-handle
     3049               where buf_temp-browse-handle.browse-type = 'height':u
     3050             on error undo, next
     3051             :
     3052               assign
     3053                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3054               .
     3055             end.
     3056             assign
     3057               frame Dialog-Frame :height = v-frame-height
     3058             .
     3059             if frame Dialog-Frame :scrollable = true
     3060             then do:
     3061               assign
     3062                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3063               .
     3064             end.
     3065             run diasize_position-resize-button in this-procedure .
     3066           end.
     3067           else do:
     3068             if frame Dialog-Frame :scrollable = true
     3069             then do:
     3070               assign
     3071                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3072               .
     3073             end.
     3074             assign
     3075               frame Dialog-Frame :height = v-frame-height
     3076             .
     3077             assign
     3078               v-diasize-browse-handle :height = v-browse-height
     3079             .
     3080             for each buf_temp-browse-handle
     3081               where buf_temp-browse-handle.browse-type = 'height':u
     3082             on error undo, next
     3083             :
     3084               assign
     3085                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3086               .
     3087             end.
     3088             for each buf_temp-diasize-handle
     3089             on error undo, next
     3090             :
     3091               assign
     3092                 v-object-handle = buf_temp-diasize-handle.handle-value
     3093               .
     3094               if v-object-handle <> v-diasize-resize-button
     3095               then do:
     3096                 assign
     3097                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3098                 .
     3099               end.
     3100             end.
     3101             run diasize_position-resize-button in this-procedure .
     3102           end.
     3103           assign
     3104             v-diasize-change-size = false
     3105           .
     3106           leave move_block .
     3107         end.
     3108       end.
     3109       assign
     3110         v-diasize-need-full-display = true
     3111       .
     3112       if v-diasize-change-size = false
     3113       then do:
     3114         assign
     3115           v-diasize-change-size = true
     3116         .
     3117       end.
     3118       else do:
     3119         return .
     3120       end.
     3121       assign
     3122         v-frame-height = frame Dialog-Frame :height
     3123         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     3124         v-browse-height = v-diasize-browse-handle :height
     3125       .
     3126       for each buf_temp-browse-handle
     3127         where buf_temp-browse-handle.browse-type = 'height':u
     3128       :
     3129         assign
     3130           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3131         .
     3132       end.
     3133       for each buf_temp-diasize-handle
     3134       :
     3135         delete buf_temp-diasize-handle .
     3136       end.
     3137       assign
     3138         v-field-group-handle = frame Dialog-Frame :first-child
     3139       .
     3140       do while valid-handle(v-field-group-handle)
     3141       :
     3142         assign
     3143           v-object-handle = v-field-group-handle :first-child
     3144         .
     3145         do while valid-handle(v-object-handle)
     3146         :
     3147           if  v-object-handle <> v-diasize-browse-handle :handle
     3148           and can-query(v-object-handle, "row")
     3149           and can-query(v-object-handle, "height")
     3150           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3151           then do:
     3152             find first buf_temp-browse-handle
     3153               where buf_temp-browse-handle.browse-type   = 'height':u
     3154                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3155               no-error .
     3156             if available buf_temp-browse-handle
     3157             then do:
     3158             end.
     3159             else do:
     3160               create buf_temp-diasize-handle .
     3161               assign
     3162                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3163                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3164               .
     3165             end.
     3166           end.
     3167           assign
     3168             v-object-handle = v-object-handle :next-sibling
     3169           .
     3170         end.
     3171         assign
     3172           v-field-group-handle = v-field-group-handle :next-sibling
     3173         .
     3174       end.
     3175       do with frame Dialog-Frame
     3176       :
     3177         hide v-diasize-resize-button .
     3178         assign
     3179           v-diasize-resize-button :row    = 1
     3180           v-diasize-resize-button :column = 1
     3181         .
     3182       end.
     3183       if p-change-value > 0
     3184       then do:
     3185         if frame Dialog-Frame :scrollable = true
     3186         then do:
     3187           assign
     3188             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3189             no-error .
     3190           if error-status :error
     3191           or error-status :get-message(1) <> ""
     3192           then do:
     3193             undo move_block, retry move_block .
     3194           end.
     3195         end.
     3196         assign
     3197           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3198           no-error .
     3199         if error-status :error
     3200         or error-status :get-message(1) <> ""
     3201         then do:
     3202           undo move_block, retry move_block .
     3203         end.
     3204         assign
     3205           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3206           no-error .
     3207         if error-status :error
     3208         or error-status :get-message(1) <> ""
     3209         then do:
     3210           undo move_block, retry move_block .
     3211         end.
     3212         for each buf_temp-browse-handle
     3213           where buf_temp-browse-handle.browse-type = 'height':u
     3214         on error undo move_block, retry move_block
     3215         :
     3216           assign
     3217             buf_temp-browse-handle.browse-handle :height
     3218               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3219             no-error .
     3220           if error-status :error
     3221           or error-status :get-message(1) <> ""
     3222           then do:
     3223             undo move_block, retry move_block .
     3224           end.
     3225         end.
     3226         for each buf_temp-diasize-handle
     3227         on error undo move_block, retry move_block
     3228         :
     3229           assign
     3230             v-object-handle = buf_temp-diasize-handle.handle-value
     3231           .
     3232           if v-object-handle <> v-diasize-resize-button
     3233           then do:
     3234             assign
     3235               v-object-handle :row = v-object-handle :row + p-change-value
     3236               no-error .
     3237             if error-status :error
     3238             or error-status :get-message(1) <> ""
     3239             then do:
     3240               undo move_block, retry move_block .
     3241             end.
     3242           end.
     3243         end.
     3244       end.
     3245       else do:
     3246         for each buf_temp-diasize-handle
     3247         on error undo move_block, retry move_block
     3248         :
     3249           assign
     3250             v-object-handle = buf_temp-diasize-handle.handle-value
     3251           .
     3252           if v-object-handle <> v-diasize-resize-button
     3253           then do:
     3254             assign
     3255               v-object-handle :row = v-object-handle :row + p-change-value
     3256               no-error .
     3257             if error-status :error
     3258             or error-status :get-message(1) <> ""
     3259             then do:
     3260               undo move_block, retry move_block .
     3261             end.
     3262           end.
     3263         end.
     3264         assign
     3265           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3266           no-error .
     3267         if error-status :error
     3268         or error-status :get-message(1) <> ""
     3269         then do:
     3270           undo move_block, retry move_block .
     3271         end.
     3272         for each buf_temp-browse-handle
     3273           where buf_temp-browse-handle.browse-type = 'height':u
     3274         on error undo move_block, retry move_block
     3275         :
     3276           assign
     3277             buf_temp-browse-handle.browse-handle :height
     3278               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3279             no-error .
     3280           if error-status :error
     3281           or error-status :get-message(1) <> ""
     3282           then do:
     3283             undo move_block, retry move_block .
     3284           end.
     3285         end.
     3286         assign
     3287           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3288           no-error .
     3289         if error-status :error
     3290         or error-status :get-message(1) <> ""
     3291         then do:
     3292           undo move_block, retry move_block .
     3293         end.
     3294         if frame Dialog-Frame :scrollable = true
     3295         then do:
     3296           assign
     3297             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3298             no-error .
     3299           if error-status :error
     3300           or error-status :get-message(1) <> ""
     3301           then do:
     3302             undo move_block, retry move_block .
     3303           end.
     3304         end.
     3305       end.
     3306       if p-move-resize = true
     3307       then do:
     3308         run diasize_position-resize-button in this-procedure .
     3309       end.
     3310       if v-diasize-wndstore = true
     3311       then do:
     3312         if connected("ub") = true
     3313         then do:
     3314           define variable v-cntxt-db-num        as integer   no-undo .
     3315           define variable v-cntxt-userid        as character no-undo .
     3316           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3317                                             , OUTPUT v-cntxt-userid
     3318                                             ) .
     3319           run gbl/wndsizew.p
     3320             (input  v-cntxt-db-num
     3321             ,input  v-cntxt-userid
     3322             ,input  v-diasize-proc-name
     3323             ,input  'height':u
     3324             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3325             ) .
     3326         end.
     3327       end.
     3328     end.
     3329     assign
     3330       v-diasize-change-size = false
     3331     .
     3332   end procedure.
     3333   procedure diasize_set-height :
     3334     define input  parameter p-new-height  as decimal   no-undo .
     3335     define input  parameter p-move-resize as logical   no-undo .
     3336     do
     3337     on error undo, return error return-value
     3338     :
     3339       run diasize_change-height in this-procedure
     3340         (input  (p-new-height - frame Dialog-Frame :height)
     3341         ,input  p-move-resize
     3342         ) .
     3343     end.
     3344   end procedure.
     3345   procedure diasize_change-width :
     3346     define input  parameter p-change-value as decimal   no-undo .
     3347     define input  parameter p-move-resize  as logical   no-undo .
     3348     define variable v-field-group-handle   as handle    no-undo .
     3349     define variable v-object-handle        as handle    no-undo .
     3350     define variable v-frame-width          as decimal   no-undo .
     3351     define variable v-frame-virtual-width  as decimal   no-undo .
     3352     define variable v-browse-width         as decimal   no-undo .
     3353     define variable v-window-width         as decimal   no-undo .
     3354     define variable v-window-virtual-width as decimal   no-undo .
     3355     define variable v-change-sign          as integer   no-undo .
     3356     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3357     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3358     if p-change-value > 0
     3359     then do:
     3360       if frame Dialog-Frame :width + p-change-value >
     3361           session :width-chars
     3362       then do:
     3363         assign
     3364           p-change-value = session :width-chars - frame Dialog-Frame :width
     3365         .
     3366         if p-change-value <= 0
     3367         then do:
     3368           run diasize_position-resize-button in this-procedure .
     3369           return .
     3370         end.
     3371       end.
     3372     end.
     3373     if p-change-value < 0
     3374     then do:
     3375       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3376       then do:
     3377         assign
     3378           p-change-value = v-diasize-orig-frame-width
     3379                          - frame Dialog-Frame :width
     3380         .
     3381         if p-change-value >= 0
     3382         then do:
     3383           run diasize_position-resize-button in this-procedure .
     3384           return .
     3385         end.
     3386       end.
     3387     end.
     3388     if p-change-value >= 0
     3389     then do:
     3390       assign
     3391         v-change-sign = 1
     3392       .
     3393     end.
     3394     else do:
     3395       assign
     3396         v-change-sign = -1
     3397       .
     3398     end.
     3399     assign
     3400       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3401     .
     3402     if p-change-value = 0
     3403     then do:
     3404       run diasize_position-resize-button in this-procedure .
     3405       return .
     3406     end.
     3407     move_block:
     3408     do
     3409     on error undo move_block, leave move_block
     3410     :
     3411       if retry
     3412       then do:
     3413         do
     3414         on error undo move_block, leave move_block
     3415         :
     3416           if p-change-value > 0
     3417           then do:
     3418             for each buf_temp-diasize-handle
     3419             on error undo, next
     3420             :
     3421               assign
     3422                 v-object-handle = buf_temp-diasize-handle.handle-value
     3423               .
     3424               if v-object-handle <> v-diasize-resize-button
     3425               then do:
     3426                 assign
     3427                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3428                 .
     3429               end.
     3430             end.
     3431             assign
     3432               v-diasize-browse-handle :width = v-browse-width
     3433             .
     3434             for each buf_temp-browse-handle
     3435               where buf_temp-browse-handle.browse-type = 'width':u
     3436             on error undo, next
     3437             :
     3438               assign
     3439                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3440               .
     3441             end.
     3442             assign
     3443               frame Dialog-Frame :width = v-frame-width
     3444             .
     3445             if frame Dialog-Frame :scrollable = true
     3446             then do:
     3447               assign
     3448                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3449               .
     3450             end.
     3451             run diasize_position-resize-button in this-procedure .
     3452           end.
     3453           else do:
     3454             if frame Dialog-Frame :scrollable = true
     3455             then do:
     3456               assign
     3457                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3458               .
     3459             end.
     3460             assign
     3461               frame Dialog-Frame :width = v-frame-width
     3462             .
     3463             for each buf_temp-browse-handle
     3464               where buf_temp-browse-handle.browse-type = 'width':u
     3465             on error undo, next
     3466             :
     3467               assign
     3468                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3469               .
     3470             end.
     3471             assign
     3472               v-diasize-browse-handle :width = v-browse-width
     3473             .
     3474             for each buf_temp-diasize-handle
     3475             on error undo, next
     3476             :
     3477               assign
     3478                 v-object-handle = buf_temp-diasize-handle.handle-value
     3479               .
     3480               if v-object-handle <> v-diasize-resize-button
     3481               then do:
     3482                 assign
     3483                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3484                 .
     3485               end.
     3486             end.
     3487             run diasize_position-resize-button in this-procedure .
     3488           end.
     3489           assign
     3490             v-diasize-change-size = false
     3491           .
     3492           leave move_block .
     3493         end.
     3494       end.
     3495       assign
     3496         v-diasize-need-full-display = true
     3497       .
     3498       if v-diasize-change-size = false
     3499       then do:
     3500         assign
     3501           v-diasize-change-size = true
     3502         .
     3503       end.
     3504       else do:
     3505         return .
     3506       end.
     3507       assign
     3508         v-frame-width = frame Dialog-Frame :width
     3509         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3510         v-browse-width = v-diasize-browse-handle :width
     3511       .
     3512       for each buf_temp-browse-handle
     3513         where buf_temp-browse-handle.browse-type = 'width':u
     3514       :
     3515         assign
     3516           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3517         .
     3518       end.
     3519       for each buf_temp-diasize-handle
     3520       :
     3521         delete buf_temp-diasize-handle .
     3522       end.
     3523       assign
     3524         v-field-group-handle = frame Dialog-Frame :first-child
     3525       .
     3526       do while valid-handle(v-field-group-handle)
     3527       :
     3528         assign
     3529           v-object-handle = v-field-group-handle :first-child
     3530         .
     3531         do while valid-handle(v-object-handle)
     3532         :
     3533           if  v-object-handle <> v-diasize-browse-handle :handle
     3534           and v-object-handle <> v-diasize-resize-button
     3535           and can-query(v-object-handle, "row")
     3536           and can-query(v-object-handle, "height")
     3537           and ( v-object-handle :col + v-object-handle :width
     3538                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3539               )
     3540           then do:
     3541             find first buf_temp-browse-handle
     3542               where buf_temp-browse-handle.browse-type   = 'width':u
     3543                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3544               no-error .
     3545             if available buf_temp-browse-handle
     3546             then do:
     3547             end.
     3548             else do:
     3549               create buf_temp-diasize-handle .
     3550               assign
     3551                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3552                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3553               .
     3554             end.
     3555           end.
     3556           assign
     3557             v-object-handle = v-object-handle :next-sibling
     3558           .
     3559         end.
     3560         assign
     3561           v-field-group-handle = v-field-group-handle :next-sibling
     3562         .
     3563       end.
     3564       do with frame Dialog-Frame
     3565       :
     3566         hide v-diasize-resize-button .
     3567         v-diasize-resize-button :row = 1.
     3568         v-diasize-resize-button :column = 1.
     3569       end.
     3570       if p-change-value > 0
     3571       then do:
     3572         if frame Dialog-Frame :scrollable = true
     3573         then do:
     3574           assign
     3575             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3576             no-error .
     3577           if error-status :error
     3578           or error-status :get-message(1) <> ""
     3579           then do:
     3580             undo move_block, retry move_block.
     3581           end.
     3582         end.
     3583         assign
     3584           frame Dialog-Frame :width = v-frame-width + p-change-value
     3585           no-error .
     3586         if error-status :error
     3587         or error-status :get-message(1) <> ""
     3588         then do:
     3589           undo move_block, retry move_block.
     3590         end.
     3591         assign
     3592           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3593         no-error .
     3594         if error-status :error
     3595         or error-status :get-message(1) <> ""
     3596         then do:
     3597           undo move_block, retry move_block.
     3598         end.
     3599         for each buf_temp-browse-handle
     3600           where buf_temp-browse-handle.browse-type = 'width':u
     3601         on error undo move_block, retry move_block
     3602         :
     3603           assign
     3604             buf_temp-browse-handle.browse-handle :width
     3605               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3606             no-error .
     3607           if error-status :error
     3608           or error-status :get-message(1) <> ""
     3609           then do:
     3610             undo move_block, retry move_block .
     3611           end.
     3612         end.
     3613         for each buf_temp-diasize-handle
     3614         on error undo move_block, retry move_block
     3615         :
     3616           assign
     3617             v-object-handle = buf_temp-diasize-handle.handle-value
     3618           .
     3619           if v-object-handle <> v-diasize-resize-button
     3620           then do:
     3621             assign
     3622               v-object-handle :col = v-object-handle :col + p-change-value
     3623               no-error .
     3624             if error-status :error
     3625             or error-status :get-message(1) <> ""
     3626             then do:
     3627               undo move_block, retry move_block .
     3628             end.
     3629           end.
     3630         end.
     3631       end.
     3632       else do:
     3633         for each buf_temp-diasize-handle
     3634         on error undo move_block, retry move_block
     3635         :
     3636           assign
     3637             v-object-handle = buf_temp-diasize-handle.handle-value
     3638           .
     3639           if v-object-handle <> v-diasize-resize-button
     3640           then do:
     3641             assign
     3642               v-object-handle :col = v-object-handle :col + p-change-value
     3643               no-error .
     3644             if error-status :error
     3645             or error-status :get-message(1) <> ""
     3646             then do:
     3647               undo move_block, retry move_block .
     3648             end.
     3649           end.
     3650         end.
     3651         for each buf_temp-browse-handle
     3652           where buf_temp-browse-handle.browse-type = 'width':u
     3653         on error undo move_block, retry move_block
     3654         :
     3655           assign
     3656             buf_temp-browse-handle.browse-handle :width
     3657               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3658             no-error .
     3659           if error-status :error
     3660           or error-status :get-message(1) <> ""
     3661           then do:
     3662             undo move_block, retry move_block .
     3663           end.
     3664         end.
     3665         assign
     3666           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3667           no-error .
     3668         if error-status :error
     3669         or error-status :get-message(1) <> ""
     3670         then do:
     3671           undo move_block, retry move_block.
     3672         end.
     3673         assign
     3674           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3675         no-error .
     3676         if error-status :error
     3677         or error-status :get-message(1) <> ""
     3678         then do:
     3679           undo move_block, retry move_block.
     3680         end.
     3681         if frame Dialog-Frame :scrollable = true
     3682         then do:
     3683           assign
     3684             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3685           no-error .
     3686           if error-status :error
     3687           or error-status :get-message(1) <> ""
     3688           then do:
     3689             undo move_block, retry move_block.
     3690           end.
     3691         end.
     3692       end.
     3693       if p-move-resize
     3694       then do:
     3695         run diasize_position-resize-button in this-procedure .
     3696       end.
     3697       if v-diasize-wndstore = true
     3698       then do:
     3699         if connected("ub") = true
     3700         then do:
     3701           define variable v-cntxt-db-num        as integer   no-undo .
     3702           define variable v-cntxt-userid        as character no-undo .
     3703           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3704                                             , OUTPUT v-cntxt-userid
     3705                                             ) .
     3706           run gbl/wndsizew.p
     3707             (input  v-cntxt-db-num
     3708             ,input  v-cntxt-userid
     3709             ,input  v-diasize-proc-name
     3710             ,input  'width':u
     3711             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3712             ) .
     3713         end.
     3714       end.
     3715     end.
     3716     assign
     3717       v-diasize-change-size = false
     3718     .
     3719   end procedure.
     3720   procedure diasize_set-width :
     3721     define input  parameter p-new-width  as decimal   no-undo .
     3722     define input  parameter p-move-resize as logical   no-undo .
     3723     do
     3724     on error undo, return error return-value
     3725     :
     3726       run diasize_change-width in this-procedure
     3727         (input  (p-new-width - frame Dialog-Frame :width)
     3728         ,input  p-move-resize
     3729         ) .
     3730     end.
     3731   end procedure.
     3732   procedure diasize_position-resize-button :
     3733     do with frame Dialog-Frame
     3734     :
     3735       hide v-diasize-resize-button .
     3736       assign
     3737         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3738                     - 1
     3739                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3740         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3741                     - 1
     3742                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3743       .
     3744       view v-diasize-resize-button .
     3745     end.
     3746   end procedure.
     3747   on alt-right anywhere
     3748   do:
     3749     run diasize_change-width in this-procedure
     3750       (input 1
     3751       ,input true
     3752       ) .
     3753     return no-apply .
     3754   end.
     3755   on alt-left anywhere
     3756   do:
     3757     run diasize_change-width in this-procedure
     3758       (input -1
     3759       ,input true
     3760       ) .
     3761     return no-apply .
     3762   end.
     3763   on alt-down anywhere
     3764   do:
     3765     run diasize_change-height in this-procedure
     3766       (input 1
     3767       ,input true
     3768       ) .
     3769     return no-apply .
     3770   end.
     3771   on alt-up anywhere
     3772   do:
     3773     run diasize_change-height in this-procedure
     3774       (input -1
     3775       ,input true
     3776       ) .
     3777     return no-apply .
     3778   end.
     3779   on alt-enter of frame Dialog-Frame
     3780   do:
     3781     run diasize_maximize in this-procedure
     3782       (input  ?
     3783       ).
     3784     return no-apply .
     3785   end.
     3786   procedure diasize_end-move :
     3787     do
     3788     on error undo, return error return-value
     3789     :
     3790       define variable v-row-delta as decimal   no-undo .
     3791       define variable v-col-delta as decimal   no-undo .
     3792       define variable v-new-row as decimal   no-undo .
     3793       define variable v-new-col as decimal   no-undo .
     3794       assign
     3795         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3796         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3797       .
     3798       assign
     3799         v-row-delta = v-new-row - frame Dialog-Frame :height
     3800         v-col-delta = v-new-col - frame Dialog-Frame :width
     3801       .
     3802       run diasize_change-height in this-procedure
     3803         (input v-row-delta
     3804         ,input true
     3805         ) .
     3806       run diasize_change-width in this-procedure
     3807         (input v-col-delta
     3808         ,input true
     3809         ) .
     3810     end.
     3811   end procedure.
     3812   procedure diasize_maximize :
     3813     define input  parameter p-action as logical   no-undo .
     3814     do
     3815     on error undo, return error return-value
     3816     :
     3817       if p-action = ?
     3818       then do:
     3819         if v-diasize-need-maximize = true
     3820         then do:
     3821           assign
     3822             p-action = true
     3823           .
     3824         end.
     3825         else do:
     3826           assign
     3827             p-action = false
     3828           .
     3829         end.
     3830       end.
     3831       if p-action = true
     3832       then do:
     3833         run diasize_change-height in this-procedure
     3834           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3835               - frame Dialog-Frame :height-chars
     3836           ,input true
     3837           ) .
     3838         run diasize_change-width in this-procedure
     3839           (input session :width-chars
     3840               - frame Dialog-Frame :width-chars
     3841           ,input true
     3842           ) .
     3843         assign
     3844           v-diasize-need-maximize = false
     3845         .
     3846       end.
     3847       else do:
     3848         run diasize_change-width in this-procedure
     3849           (input v-diasize-orig-frame-width
     3850               - frame Dialog-Frame :width-chars
     3851           ,input true
     3852           ) .
     3853         run diasize_change-height in this-procedure
     3854           (input v-diasize-orig-frame-height
     3855               - frame Dialog-Frame :height-chars
     3856           ,input true
     3857           ) .
     3858         assign
     3859           v-diasize-need-maximize = true
     3860         .
     3861       end.
     3862     end.
     3863   end procedure.
     3864   procedure diasize_restore-orig-size :
     3865     do
     3866     on error undo, return error return-value
     3867     :
     3868       assign
     3869         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3870         v-diasize-current-frame-height = frame Dialog-Frame :height
     3871       .
     3872       run diasize_set-height in this-procedure
     3873         (input  v-diasize-orig-frame-height
     3874         ,input  true
     3875         ) .
     3876       run diasize_set-width in this-procedure
     3877         (input  v-diasize-orig-frame-width
     3878         ,input  true
     3879         ) .
     3880     end.
     3881   end procedure.
     3882   procedure diasize_restore-current-size :
     3883     do
     3884     on error undo, return error return-value
     3885     :
     3886       run diasize_set-height in this-procedure
     3887         (input  v-diasize-current-frame-height
     3888         ,input  true
     3889         ) .
     3890       run diasize_set-width in this-procedure
     3891         (input  v-diasize-current-frame-width
     3892         ,input  true
     3893         ) .
     3894     end.
     3895   end procedure.
     3896   procedure diasize_set-browse-handle :
     3897     define input  parameter p-browse-handle as handle   no-undo .
     3898     define buffer buf_temp-browse-handle for temp-browse-handle .
     3899     do
     3900     on error undo, return error return-value
     3901     :
     3902       assign
     3903         v-diasize-browse-handle = p-browse-handle
     3904       .
     3905       for each buf_temp-browse-handle
     3906       on error undo, return error return-value
     3907       :
     3908         delete buf_temp-browse-handle .
     3909       end.
     3910     end.
     3911   end procedure.
     3912   procedure diasize_add_browse :
     3913     define input  parameter p-browse-type   as character no-undo .
     3914     define input  parameter p-browse-handle as handle    no-undo .
     3915     define buffer buf_temp-browse-handle for temp-browse-handle .
     3916     do
     3917     on error undo, return error return-value
     3918     :
     3919       assign
     3920         v-diasize-browse-number = v-diasize-browse-number + 1
     3921       .
     3922       create buf_temp-browse-handle .
     3923       assign
     3924         buf_temp-browse-handle.browse-type   = p-browse-type
     3925         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3926         buf_temp-browse-handle.browse-handle = p-browse-handle
     3927       .
     3928     end.
     3929   end procedure.
     3930   procedure diasize_init :
     3931     define variable v-default-value    as logical   no-undo .
     3932     define variable v-restore-saved    as logical   no-undo .
     3933     define variable v-resize-value-str as character no-undo .
     3934     do
     3935     on error undo, return error return-value
     3936     :
     3937       do with frame Dialog-Frame
     3938       :
     3939         assign
     3940           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3941           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3942           v-diasize-browse-handle     = browse browse-goods :handle
     3943         .
     3944         create button v-diasize-resize-button
     3945         assign
     3946           parent        = frame Dialog-Frame :first-child
     3947           label         = "s"
     3948           height-pixels = 16
     3949           width-pixels  = 16
     3950           visible       = true
     3951           sensitive     = true
     3952           movable       = true
     3953           triggers:
     3954             on end-move persistent run diasize_end-move in this-procedure .
     3955           end triggers.
     3956         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3957         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3958         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3959         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3960         assign
     3961           v-diasize-wndmax = false
     3962         .
     3963         if connected("ub") = true
     3964         then do:
     3965           define variable v-cntxt-db-num        as integer   no-undo .
     3966           define variable v-cntxt-userid        as character no-undo .
     3967           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3968                                             , OUTPUT v-cntxt-userid
     3969                                             ) .
     3970           run gbl/wndpar_r.p
     3971             (input  v-cntxt-db-num
     3972             ,input  v-cntxt-userid
     3973             ,input  'wndmax':U
     3974             ,output v-diasize-wndmax
     3975             ,output v-default-value
     3976             ) .
     3977         end.
     3978         assign
     3979           v-diasize-wndstore = false
     3980         .
     3981         if connected("ub") = true
     3982         then do:
     3983           run gbl/wndpar_r.p
     3984             (input  v-cntxt-db-num
     3985             ,input  v-cntxt-userid
     3986             ,input  'wndstore':U
     3987             ,output v-diasize-wndstore
     3988             ,output v-default-value
     3989             ) .
     3990         end.
     3991         assign
     3992           v-diasize-proc-name = entry(1, program-name(2), '.')
     3993         .
     3994         if v-diasize-wndstore = true
     3995         then do:
     3996           assign
     3997             v-restore-saved = false
     3998           .
     3999           if connected("ub") = true
     4000           then do:
     4001             run gbl/wndsizer.p
     4002               (input  v-cntxt-db-num
     4003               ,input  v-cntxt-userid
     4004               ,input  v-diasize-proc-name
     4005               ,input  'height':u
     4006               ,output v-resize-value-str
     4007               ) .
     4008             if v-resize-value-str <> '':U
     4009             then do:
     4010               run diasize_change-height in this-procedure
     4011                 (input  integer(v-resize-value-str)
     4012                 ,input  true
     4013                 ) .
     4014               assign
     4015                 v-restore-saved = true
     4016               .
     4017             end.
     4018           end.
     4019           if connected("ub") = true
     4020           then do:
     4021             run gbl/wndsizer.p
     4022               (input  v-cntxt-db-num
     4023               ,input  v-cntxt-userid
     4024               ,input  v-diasize-proc-name
     4025               ,input  'width':u
     4026               ,output v-resize-value-str
     4027               ) .
     4028             if v-resize-value-str <> '':U
     4029             then do:
     4030               run diasize_change-width in this-procedure
     4031                 (input  integer(v-resize-value-str)
     4032                 ,input  true
     4033                 ) .
     4034               assign
     4035                 v-restore-saved = true
     4036               .
     4037             end.
     4038           end.
     4039           if v-restore-saved <> true
     4040           then do:
     4041             if v-diasize-wndmax = true
     4042             then do:
     4043               run diasize_maximize in this-procedure
     4044                 (input  true
     4045                 ) .
     4046             end.
     4047           end.
     4048         end.
     4049         else do:
     4050           if v-diasize-wndmax = true
     4051           then do:
     4052             run diasize_maximize in this-procedure
     4053               (input  true
     4054               ) .
     4055           end.
     4056         end.
     4057       end.
     4058     end.
     4059   end procedure.
     4060   procedure diasize_need-full-display :
     4061     define output parameter p-need-full-display as logical   no-undo .
     4062     do
     4063     on error undo, return error return-value
     4064     :
     4065       assign
     4066         p-need-full-display = v-diasize-need-full-display
     4067       .
     4068       assign
     4069         v-diasize-need-full-display = false
     4070       .
     4071     end.
     4072   end procedure.
     4073   procedure get-context :
     4074      define output parameter p-db-num as integer          no-undo.
     4075      define output parameter p-user-id as character        no-undo.
     4076      define variable v-login               as character    no-undo.
     4077      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4078      define buffer buf_user-login  for ub.user-login .
     4079      do
     4080      on error undo, return error
     4081      :
     4082            FIND FIRST buf_sys-ctrl no-lock.
     4083            ASSIGN
     4084               v-login = USERID("ub")
     4085               p-db-num = buf_sys-ctrl.db-num
     4086            .
     4087            FIND FIRST buf_user-login
     4088                 WHERE buf_user-login.db-num = p-db-num
     4089                   AND buf_user-login.user-login = v-login
     4090                 no-lock
     4091                 no-error
     4092                 .
     4093            IF AVAILABLE buf_user-login
     4094            THEN DO:
     4095               assign
     4096                  p-user-id = buf_user-login.user-id
     4097               .
     4098            END.
     4099      end.
     4100   end procedure.
     4101   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4102   on F9 of frame Dialog-Frame anywhere do:
     4103     run init-gds-rec.
     4104     if gds-rec = ? then
     4105       return no-apply.
     4106     run ref/gds-form.w ( input parparentproc
     4107                         ,input 'ПРОСМОТР':U
     4108                         ,input ?
     4109                         ,input ?
     4110                         ,input ?
     4111                         ,input-output gds-rec).
     4112     apply "entry" to browse-goods in frame Dialog-Frame.
     4113     return no-apply.
     4114   end.
     4115   run diasize_add_browse in this-procedure
     4116     (input  'width':u
     4117     ,input  browse BROWSE-obj :handle
     4118     ) .
     4119   run diasize_init in this-procedure .
     4120   def var sort-labelbrowse-goods   as character no-undo .
     4121   def var sort-clmnbrowse-goods    as handle    no-undo .
     4122   def var cur-clmnbrowse-goods     as handle    no-undo .
     4123   def var cur-clmn-locbrowse-goods as integer   no-undo .
     4124   def var re-querybrowse-goods     as logical   initial no no-undo .
     4125   on start-search, ctrl-o of browse-goods in frame Dialog-Frame do:
     4126      run sort-brbrowse-goods
     4127        (input (if available XYZ-analysis-goods
     4128                then recid(XYZ-analysis-goods)
     4129                else ?
     4130               )
     4131        ).
     4132   end.
     4133   PROCEDURE sort-brbrowse-goods :
     4134     define input parameter p-recid as recid no-undo .
     4135     if re-querybrowse-goods = no then do:
     4136       assign
     4137          cur-clmnbrowse-goods = browse-goods:current-column in frame Dialog-Frame
     4138       .
     4139       if sort-clmnbrowse-goods <> ? then sort-clmnbrowse-goods:column-fgcolor = 0.
     4140       if cur-clmnbrowse-goods = sort-clmnbrowse-goods then do:
     4141         assign
     4142            sort-labelbrowse-goods = ""
     4143            sort-clmnbrowse-goods = ?
     4144         .
     4145        end.
     4146        else do:
     4147          assign
     4148            sort-labelbrowse-goods = cur-clmnbrowse-goods:label
     4149            sort-clmnbrowse-goods  = cur-clmnbrowse-goods
     4150            sort-clmnbrowse-goods:column-fgcolor = 4
     4151          .
     4152        end.
     4153      end.
     4154     assign
     4155       cur-clmn-locbrowse-goods = 1
     4156     .
     4157     def var column-handle as handle no-undo .
     4158     column-handle = browse-goods:first-column.
     4159     do while valid-handle(column-handle) :
     4160       if column-handle = cur-clmnbrowse-goods then do:
     4161         leave .
     4162       end.
     4163       column-handle = column-handle:NEXT-COLUMN.
     4164       assign
     4165         cur-clmn-locbrowse-goods = cur-clmn-locbrowse-goods + 1
     4166       .
     4167     end.
     4168     case sort-labelbrowse-goods:
     4169           when '*! !'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1mark-string&1, recid(buf_XYZ-analysis-goods), &1&2&1)', chr(34), rid-list)     .     run OpenBr (yes, no, '':U).   . END.
     4170           when 'Артикул! !'  then DO:    assign       sort-column-name = "buf_goods.artic"     .     run OpenBr (yes, no, '':U).   . END.
     4171           when 'Название! !'  then DO:    assign       sort-column-name = "buf_goods.gds-name"     .     run OpenBr (yes, no, '':U).   . END.
     4172           when 'X!Y!Z'  then DO:    assign       sort-column-name = "buf_XYZ-analysis-goods.XYZg-XYZ"     .     run OpenBr (yes, no, '':U).   . END.
     4173           when '% по  !крите-!рию   '  then DO:    assign       sort-column-name = "buf_XYZ-analysis-goods.XYZg-prcnt-for-estimate"     .     run OpenBr (yes, no, '':U).   . END.
     4174           when 'Сумма!для оценки!по критерию'  then DO:    assign       sort-column-name = "buf_XYZ-analysis-goods.XYZg-sum-for-estimate"     .     run OpenBr (yes, no, '':U).   . END.
     4175           when 'Заказанное!количество!товара'  then DO:    assign       sort-column-name = "buf_XYZ-analysis-goods.XYZg-order-qnty"     .     run OpenBr (yes, no, '':U).   . END.
     4176           when 'Количество!по!реализации'  then DO:    assign       sort-column-name = "buf_XYZ-analysis-goods.XYZg-qnty"     .     run OpenBr (yes, no, '':U).   . END.
     4177           when 'Остаток!количество!'  then DO:    assign       sort-column-name = "buf_XYZ-analysis-goods.XYZg-stock-qnty"     .     run OpenBr (yes, no, '':U).   . END.
     4178           when 'Остаток!товара в!учет.ценах'  then DO:    assign       sort-column-name = "buf_XYZ-analysis-goods.XYZg-stock-price-acc"     .     run OpenBr (yes, no, '':U).   . END.
     4179           when 'Остаток!товара в!продаж.ценах'  then DO:    assign       sort-column-name = "buf_XYZ-analysis-goods.XYZg-stock-price-sale"     .     run OpenBr (yes, no, '':U).   . END.
     4180           when 'Сумма!реализации в!учет.ценах'  then DO:    assign       sort-column-name = "buf_XYZ-analysis-goods.XYZg-sum-acc"     .     run OpenBr (yes, no, '':U).   . END.
     4181           when 'Сумма!реализации в!прод.ценах'  then DO:    assign       sort-column-name = "buf_XYZ-analysis-goods.XYZg-sum-cur"     .     run OpenBr (yes, no, '':U).   . END.
     4182           when 'Сумма!реализации в!ценах докум.'  then DO:    assign       sort-column-name = "buf_XYZ-analysis-goods.XYZg-sum-doc"     .     run OpenBr (yes, no, '':U).   . END.
     4183           when 'Темп!продаж!'  then DO:    assign       sort-column-name = "buf_XYZ-analysis-goods.XYZg-temp-sale-goods"     .     run OpenBr (yes, no, '':U).   . END.
     4184       otherwise do:
     4185         assign
     4186           sort-column-name = ""
     4187         .
     4188         run OpenBr (yes, no, '':U).
     4189         if sort-labelbrowse-goods <> "" then do:
     4190           assign
     4191             cur-clmnbrowse-goods:column-fgcolor = 0
     4192           .
     4193         end.
     4194         assign
     4195           cur-clmn-locbrowse-goods = ?
     4196         .
     4197       end.
     4198     end case.
     4199     if p-recid <> ? then do:
     4200       reposition browse-goods to recid p-recid no-error.
     4201       apply "value-changed" to browse-goods in frame Dialog-Frame.
     4202     end.
     4203     apply "entry" to browse-goods in frame Dialog-Frame.
     4204   END PROCEDURE.
     4205   procedure re-open-query-srt-clmnbrowse-goods:
     4206   if cur-clmnbrowse-goods = ? then do:
     4207      run OpenBr (yes, no, '':U).
     4208   end.
     4209   else do:
     4210      assign re-querybrowse-goods = yes.
     4211      run sort-brbrowse-goods
     4212        (input (if available XYZ-analysis-goods
     4213                then recid(XYZ-analysis-goods)
     4214                else ?
     4215               )
     4216        ).
     4217      assign re-querybrowse-goods = no.
     4218   end.
     4219   end.
     4220   MAIN-BLOCK:
     4221   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4222      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4223      buf_goods.artic:resizable in browse BROWSE-goods = true .
     4224      buf_goods.gds-name:resizable in browse BROWSE-goods = true .
     4225      v-izt:resizable in browse BROWSE-goods = true .
     4226      buf_goods.artic:read-only in browse BROWSE-goods = true .
     4227      v-ass-name:resizable in browse BROWSE-obj = true .
     4228      v-obj-igt:resizable in browse BROWSE-obj = true .
     4229     run my_enable.
     4230     WAIT-FOR GO OF FRAME Dialog-Frame.
     4231   END.
     4232   run disable_ui.
     4233   PROCEDURE disable_UI :
     4234     HIDE FRAME Dialog-Frame.
     4235   END PROCEDURE.
     4236   PROCEDURE DISP-OBJ :
     4237    define buffer   buf2_assortment-matrix for ub.assortment-matrix .
     4238         v-ass-name = "" .
     4239         if available buf_assortment-matrix-goods  then do:
     4240             find first buf2_assortment-matrix no-lock where
     4241                        buf2_assortment-matrix.asmt-id  =  buf_assortment-matrix-goods.asmt-id and
     4242                        buf2_assortment-matrix.db-num   =  buf_assortment-matrix-goods.db-num no-error .
     4243                        if available buf2_assortment-matrix
     4244                           then  v-ass-name = buf2_assortment-matrix.asmt-name .
     4245         end.
     4246         if available buf_XYZ-analysis-obj then do:
     4247   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4248   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjpr in g#library
     4249     (input  buf_XYZ-analysis-obj.obj-type
     4250     ,input  buf_XYZ-analysis-obj.obj-code
     4251     ,input  ?
     4252     ,input  ?
     4253     ,input  ?
     4254     ,input  buf_XYZ-analysis-goods.gds-code
     4255     ,output v-obj-AssMin
     4256     ,output v-obj-igt
     4257     ,output v-gdop-min-stock
     4258     ,output v-grop-max-stock
     4259     ,output v-grop-level-always-presence
     4260     ,output v-grop-min-order
     4261     )  .
     4262         end.
     4263   END PROCEDURE.
     4264   PROCEDURE enable_UI :
     4265     ENABLE B-cancel B-mark B-save B-chg-izt B-add-AM B-del-AM B-spis-ord B-Help
     4266            B-add-AMin B-del-AMin B-ord B-print BROWSE-goods BROWSE-obj
     4267         WITH FRAME Dialog-Frame.
     4268     VIEW FRAME Dialog-Frame.
     4269     OPEN QUERY BROWSE-goods FOR EACH Buf_XYZ-analysis-goods       WHERE Buf_XYZ-analysis-goods.XYZ-id = v-id and Buf_XYZ-analysis-goods.db-num = v-db-num NO-LOCK,              EACH buf_goods OF ub.Buf_XYZ-analysis-goods NO-LOCK INDEXED-REPOSITION.    OPEN QUERY BROWSE-obj       FOR EACH Buf_XYZ-analysis-obj WHERE                Buf_XYZ-analysis-obj.XYZ-id = v-id AND                Buf_XYZ-analysis-obj.db-num = v-db-num                NO-LOCK,                  EACH buf_XYZ-analysis-gds-obj WHERE                buf_XYZ-analysis-gds-obj.obj-type = Buf_XYZ-analysis-obj.obj-type AND                buf_XYZ-analysis-gds-obj.obj-code = Buf_XYZ-analysis-obj.obj-code AND                buf_XYZ-analysis-gds-obj.gds-code = Buf_XYZ-analysis-goods.gds-code AND                buf_XYZ-analysis-gds-obj.XYZ-id   =  v-id AND                buf_XYZ-analysis-gds-obj.db-num   = v-db-num                OUTER-JOIN NO-LOCK,                  EACH Buf_gds-obj-prop WHERE                Buf_gds-obj-prop.obj-type = ub.buf_XYZ-analysis-obj.obj-type AND                Buf_gds-obj-prop.obj-code = ub.buf_XYZ-analysis-obj.obj-code AND                Buf_gds-obj-prop.gds-code = ub.buf_XYZ-analysis-goods.gds-code                OUTER-JOIN NO-LOCK,                 first buf_assortment-matrix WHERE                buf_assortment-matrix.asmt-status        = 0  AND                buf_assortment-matrix.obj-type =  Buf_XYZ-analysis-obj.obj-type AND                buf_assortment-matrix.obj-code =  Buf_XYZ-analysis-obj.obj-code                OUTER-JOIN NO-LOCK,                 FIRST buf_assortment-matrix-goods WHERE                buf_assortment-matrix-goods.asmg-status        = 0  AND                buf_assortment-matrix-goods.asmt-id  =  buf_assortment-matrix.asmt-id AND                buf_assortment-matrix-goods.db-num   =  buf_assortment-matrix.db-num  AND                buf_assortment-matrix-goods.gds-code =  buf_XYZ-analysis-goods.gds-code                OUTER-JOIN NO-LOCK INDEXED-REPOSITION.
     4270   END PROCEDURE.
     4271   PROCEDURE init-gds-rec :
     4272   if available buf_goods then
     4273   gds-rec = recid(buf_goods) .
     4274   END PROCEDURE.
     4275   PROCEDURE make-gds-list :
     4276   do
     4277     on error undo, return error return-value
     4278     :
     4279   define buffer buf2_goods for ub.goods.
     4280   define buffer buf2_XYZ-analysis-goods for ub.XYZ-analysis-goods.
     4281   define variable v-kol as integer   no-undo .
     4282   define variable i as integer   no-undo .
     4283   run waitfram-show ( "Подготовка временных таблиц.... ") .
     4284       for each gds-list : delete gds-list. end.
     4285       v-kol = num-entries( rid-list ) .
     4286       repeat i = 1 to v-kol :
     4287         find first buf2_XYZ-analysis-goods no-lock where recid(buf2_XYZ-analysis-goods) = integer(entry(i,rid-list)) no-error .
     4288         if available buf2_XYZ-analysis-goods then do:
     4289             find first buf2_goods no-lock where buf2_goods.gds-code = buf2_XYZ-analysis-goods.gds-code no-error .
     4290             if available buf2_goods then do:
     4291                 create gds-list.
     4292                 BUFFER-COPY buf2_goods TO gds-list .
     4293             end.
     4294         end.
     4295       end.
     4296    run waitfram-hide.
     4297     end.
     4298   END PROCEDURE.
     4299   PROCEDURE my_enable :
     4300   define buffer Buf2_XYZ-analysis-obj for ub.XYZ-analysis-obj.
     4301   hide b-ord in frame Dialog-Frame .
     4302     ENABLE B-Cancel
     4303            B-mark
     4304            B-save
     4305            B-chg-izt
     4306            B-add-AM
     4307            B-del-AM
     4308            B-spis-ord
     4309            B-Help
     4310            B-add-AMin
     4311            B-del-AMin
     4312            B-print
     4313            BROWSE-goods
     4314            BROWSE-obj
     4315         WITH FRAME Dialog-Frame.
     4316     view frame dialog-frame.
     4317     FOR EACH Buf2_XYZ-analysis-obj WHERE
     4318              Buf2_XYZ-analysis-obj.XYZ-id = v-id AND
     4319              Buf2_XYZ-analysis-obj.db-num = v-db-num     NO-LOCK :
     4320       run create_obj-list (Buf2_XYZ-analysis-obj.obj-type , Buf2_XYZ-analysis-obj.obj-code ) .
     4321     end.
     4322     run openbr ( yes, no, '':u).
     4323   END PROCEDURE.
     4324   PROCEDURE OPenbr :
     4325   define input  parameter p-open-query     as logical   no-undo .
     4326   define input  parameter p-find-next      as logical   no-undo .
     4327   define input  parameter p-find-condition as character no-undo .
     4328   def var l-query-was-opened as logical no-undo .
     4329   define variable title0 as character no-undo.
     4330   define buffer buff_contract for contract.
     4331   define variable loc_contract-code as character no-undo .
     4332   def var sort-column-phrase as character no-undo .
     4333   case sort-column-name :
     4334     when "" then do:
     4335       assign
     4336         sort-column-phrase = ""
     4337       .
     4338     end.
     4339     otherwise do:
     4340       assign
     4341         sort-column-phrase = "by " + sort-column-name
     4342       .
     4343     end.
     4344   end case.
     4345   define variable l-open-query as logical   no-undo .
     4346   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4347   define variable  l-disable-where-32  as logical   no-undo .
     4348   define variable  l-filter-open-32    as logical   .
     4349   define variable  flt-rec-32       as recid     no-undo .
     4350   define variable  filter-name-32      as character no-undo .
     4351   define variable  where-phrase-32     as character no-undo .
     4352   define variable  sort-phrase-32      as character no-undo .
     4353   define variable  where-phrase-rus-32 as character no-undo .
     4354   define variable  sort-phrase-rus-32  as character no-undo .
     4355     run waitfram-show in this-procedure
     4356       (input "ЖДИТЕ ..."
     4357       ).
     4358   run gbl/flt-get.p
     4359     (input filter-point
     4360     ,output flt-rec-32
     4361     ,output filter-name-32
     4362     ,output where-phrase-32
     4363     ,output sort-phrase-32
     4364     ,output where-phrase-rus-32
     4365     ,output sort-phrase-rus-32
     4366     ).
     4367   if p-open-query then do:
     4368     assign
     4369       l-filter-open-32 = false
     4370     .
     4371     if flt-rec-32 <> ?
     4372       or sort-column-phrase > ""
     4373     then do:
     4374       define variable  parameter-2-32 as character no-undo .
     4375       define variable  parameter-3-32 as character no-undo .
     4376       define variable  parameter-4-32 as character no-undo .
     4377       define variable  parameter-5-32 as character no-undo .
     4378       define variable  parameter-6-32 as character no-undo .
     4379       define variable  parameter-7-32 as character no-undo .
     4380         assign
     4381         parameter-3-32 =
     4382                                 "FOR EACH Buf_XYZ-analysis-goods"
     4383         parameter-4-32 =
     4384           (
     4385             if (" Buf_XYZ-analysis-goods.XYZ-id = v-id  and Buf_XYZ-analysis-goods.db-num = v-db-num  " + " " + where-phrase-32) <> ""
     4386             then  substitute ( ' Buf_XYZ-analysis-goods.XYZ-id = &1  and Buf_XYZ-analysis-goods.db-num = &2 ', v-id, v-db-num )  + " " + where-phrase-32
     4387             else "true"
     4388           )
     4389         parameter-5-32 = (" " + "" + " " + ", EACH buf_goods OF ub.Buf_XYZ-analysis-goods NO-LOCK")
     4390         parameter-6-32 = if sort-phrase-32 = ''
     4391                              then
     4392           (
     4393           " " + "  " +
     4394             " " + sort-column-phrase +
     4395           " " + "  "
     4396           )
     4397                              else
     4398           (
     4399           " " + "  " +
     4400             " " + sort-column-phrase +
     4401           " " + sort-phrase-32
     4402           )
     4403         parameter-7-32 =
     4404           " indexed-reposition  "
     4405       .
     4406       do
     4407       on stop undo, leave
     4408       on error undo, leave
     4409       :
     4410         assign
     4411           l-disable-where-32 =
     4412             (" Buf_XYZ-analysis-goods.XYZ-id = v-id  and Buf_XYZ-analysis-goods.db-num = v-db-num  " + " " + where-phrase-32 = "")
     4413         .
     4414         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4415                             ,input query browse-goods:handle
     4416                             ,input parameter-3-32
     4417                             ,input parameter-4-32
     4418                             ,input parameter-5-32
     4419                             ,input parameter-6-32
     4420                             ,input parameter-7-32
     4421                             )
     4422         .
     4423         assign
     4424           l-filter-open-32 = true
     4425         .
     4426       end.
     4427       if l-filter-open-32 = false then do:
     4428         message
     4429           "Ошибка при фильтрации / сортировке" skip
     4430           "Будут показаны записи без учета фильтра" skip
     4431           view-as alert-box .
     4432       end.
     4433       else do:
     4434           assign
     4435             l-query-was-opened = true
     4436           .
     4437       end.
     4438     end.
     4439     if l-filter-open-32 = false then do:
     4440       OPEN QUERY browse-goods FOR EACH Buf_XYZ-analysis-goods use-index sort-pcnt
     4441         where  Buf_XYZ-analysis-goods.XYZ-id = v-id  and Buf_XYZ-analysis-goods.db-num = v-db-num
     4442       , EACH buf_goods OF ub.Buf_XYZ-analysis-goods NO-LOCK
     4443         indexed-reposition
     4444     .
     4445         assign
     4446           l-query-was-opened = true
     4447         .
     4448     end.
     4449   end.
     4450   else do:
     4451     assign
     4452       doc-rec = recid( Buf_XYZ-analysis-goods )
     4453     .
     4454     do
     4455     on stop undo, leave
     4456     on error undo, leave
     4457     :
     4458       if query browse-goods:handle:get-buffer-handle(1) = (buffer Buf_XYZ-analysis-goods:handle) then do:
     4459         assign
     4460         parameter-2-32 = (if p-find-next then "true":u else "false":u )
     4461         parameter-4-32 =
     4462           "where ":u +  substitute ( ' Buf_XYZ-analysis-goods.XYZ-id = &1  and Buf_XYZ-analysis-goods.db-num = &2 ', v-id, v-db-num )  + " ":u + where-phrase-32 + " ":u + p-find-condition + " " + ""
     4463         parameter-5-32 = "  "
     4464       .
     4465         run fltopend_fltfindd in this-procedure  (
     4466                             input this-procedure:handle
     4467                             ,input query browse-goods:handle
     4468                             ,input rowid(Buf_XYZ-analysis-goods)
     4469                             ,input logical(parameter-2-32)
     4470                             ,input no-lock
     4471                             ,input (buffer Buf_XYZ-analysis-goods:handle)
     4472                             ,input parameter-4-32
     4473                             ,input parameter-5-32
     4474                             ) no-error.
     4475         .
     4476         assign
     4477           doc-rec = integer(return-value)
     4478           v-fltopend-rowid[1] = ?
     4479         .
     4480       end.
     4481       else do:
     4482         assign
     4483         parameter-2-32 = (if p-find-next then "true":u else "false":u )
     4484         parameter-3-32 =  "FOR EACH Buf_XYZ-analysis-goods"
     4485         parameter-4-32 =
     4486           (
     4487             if (" Buf_XYZ-analysis-goods.XYZ-id = v-id  and Buf_XYZ-analysis-goods.db-num = v-db-num  " + " " + where-phrase-32) <> ""
     4488             then  substitute ( ' Buf_XYZ-analysis-goods.XYZ-id = &1  and Buf_XYZ-analysis-goods.db-num = &2 ', v-id, v-db-num )  + " " + where-phrase-32
     4489             else "true"
     4490           )
     4491         parameter-5-32 = (" " + "" + " " + ", EACH buf_goods OF ub.Buf_XYZ-analysis-goods NO-LOCK" + " " + p-find-condition)
     4492         parameter-6-32 = if sort-phrase-32 = ''
     4493                              then
     4494           (
     4495           " " + "  " +
     4496             " " + sort-column-phrase +
     4497           " " + "  "
     4498           )
     4499                              else
     4500           (
     4501           " " + "  " +
     4502             " " + sort-column-phrase +
     4503           " " + sort-phrase-32
     4504           )
     4505         parameter-7-32 =
     4506           " indexed-reposition  "
     4507       .
     4508         run fltopend_fltfindq in this-procedure  (
     4509                             input this-procedure:handle
     4510                             ,input query browse-goods:handle
     4511                             ,input logical(parameter-2-32)
     4512                             ,input no-lock
     4513                             ,input parameter-3-32
     4514                             ,input parameter-4-32
     4515                             ,input parameter-5-32
     4516                             ,input parameter-6-32
     4517                             ,input parameter-7-32
     4518                             ,output v-fltopend-rowid
     4519                             ) no-error.
     4520         .
     4521         doc-rec = ?.
     4522       end.
     4523       assign
     4524         l-query-was-opened = true
     4525       .
     4526     end.
     4527   end.
     4528     run waitfram-hide in this-procedure .
     4529   if not p-open-query then
     4530   REPOSITION browse-goods to recid doc-rec No-ERROR.
     4531   if not p-open-query and v-fltopend-rowid[1] <> ? then
     4532   query browse-goods:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     4533     if available  buf_XYZ-analysis-goods then do:
     4534        OPEN QUERY BROWSE-obj       FOR EACH Buf_XYZ-analysis-obj WHERE                Buf_XYZ-analysis-obj.XYZ-id = v-id AND                Buf_XYZ-analysis-obj.db-num = v-db-num                NO-LOCK,                  EACH buf_XYZ-analysis-gds-obj WHERE                buf_XYZ-analysis-gds-obj.obj-type = Buf_XYZ-analysis-obj.obj-type AND                buf_XYZ-analysis-gds-obj.obj-code = Buf_XYZ-analysis-obj.obj-code AND                buf_XYZ-analysis-gds-obj.gds-code = Buf_XYZ-analysis-goods.gds-code AND                buf_XYZ-analysis-gds-obj.XYZ-id   =  v-id AND                buf_XYZ-analysis-gds-obj.db-num   = v-db-num                OUTER-JOIN NO-LOCK,                  EACH Buf_gds-obj-prop WHERE                Buf_gds-obj-prop.obj-type = ub.buf_XYZ-analysis-obj.obj-type AND                Buf_gds-obj-prop.obj-code = ub.buf_XYZ-analysis-obj.obj-code AND                Buf_gds-obj-prop.gds-code = ub.buf_XYZ-analysis-goods.gds-code                OUTER-JOIN NO-LOCK,                 first buf_assortment-matrix WHERE                buf_assortment-matrix.asmt-status        = 0  AND                buf_assortment-matrix.obj-type =  Buf_XYZ-analysis-obj.obj-type AND                buf_assortment-matrix.obj-code =  Buf_XYZ-analysis-obj.obj-code                OUTER-JOIN NO-LOCK,                 FIRST buf_assortment-matrix-goods WHERE                buf_assortment-matrix-goods.asmg-status        = 0  AND                buf_assortment-matrix-goods.asmt-id  =  buf_assortment-matrix.asmt-id AND                buf_assortment-matrix-goods.db-num   =  buf_assortment-matrix.db-num  AND                buf_assortment-matrix-goods.gds-code =  buf_XYZ-analysis-goods.gds-code                OUTER-JOIN NO-LOCK INDEXED-REPOSITION.
     4535     end.
     4536   END PROCEDURE.
     4537   PROCEDURE print-proc :
     4538   define input  parameter p-obj as logical   no-undo .
     4539   def var date_string     as      char    no-undo.
     4540   def var Line                as      char    no-undo.
     4541   def var for-time as char.
     4542              run get-report-num (
     4543               output p-report-id
     4544           ).
     4545       v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
     4546       output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
     4547       put stream OutStr-html unformatted
     4548                "<!DOCTYPE HTML>" skip
     4549                   ' <html>' skip
     4550                   '  <head>' skip
     4551                   '   <meta charset="utf-8">' skip
     4552                   '    <style type="text/css">' skip
