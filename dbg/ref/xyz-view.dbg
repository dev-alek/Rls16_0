     4565               '<TD style="width: 150px;"></TD>'skip
     4566               '<TD style="width: 30px;"></TD>'skip
     4567               '<TD style="width: 60px;"></TD>'skip
     4568               '<TD style="width: 60px;"></TD>'skip
     4569               '<TD style="width: 60px;"></TD>'skip
     4570               '<TD style="width: 80px;"></TD>'skip
     4571               '<TD style="width: 80px;"></TD>'skip
     4572               '<TD style="width: 80px;"></TD>'skip
     4573               '<TD style="width: 60px;"></TD>'skip
     4574               '<TD style="width: 60px;"></TD>'skip
     4575               '<TD style="width: 60px;"></TD>'skip
     4576               '<TD style="width: 60px;"></TD>'skip
     4577               '<TD style="width: 60px;"></TD>'skip
     4578               '<TD style="width: 60px;"></TD>'skip
     4579               '<TD style="width: 60px;"></TD>'skip
     4580               '<TD style="width: 60px;"></TD>'skip
     4581               '<TD style="width: 60px;"></TD>'skip
     4582           '</TR>'skip
     4583           '<TR>'skip
     4584               '<TD colspan="18" STYLE="font-size: 14px;">Вн.Код     :' + string(buf_XYZ-analysis.XYZ-id) + '</TD>' skip
     4585           '</TR>'skip
     4586           '<TR>'skip
     4587               '<TD colspan="18" STYLE="font-size: 14px;">Название   :' + string(buf_XYZ-analysis.XYZ-name) + '</TD>' skip
     4588           '</TR>'skip
     4589           '<TR>'skip
     4590               '<TD colspan="18" STYLE="font-size: 14px;">Критерий   :' + string(buf_criterion-analysis.cral-name) + '</TD>' skip
     4591           '</TR>'skip
     4592           '<TR>'skip
     4593               '<TD colspan="18" STYLE="font-size: 14px;">Коментарии :' + string(buf_XYZ-analysis.XYZ-des) + '</TD>' skip
     4594           '</TR>'skip
     4595           '<TR>'skip
     4596               '<TD colspan="18" STYLE="font-size: 14px;">Создание анализа :' + string(buf_XYZ-analysis.XYZ-date-create,"99.99.9999") + '' + string(buf_XYZ-analysis.XYZ-time-create,"hh:mm") + '' + buf_XYZ-analysis.XYZ-who-create + '</TD>' skip
     4597           '</TR>'skip
     4598       .
     4599       define buffer bufp_XYZ-analysis-obj for ub.XYZ-analysis-obj.
     4600       define VARIABLE v-obj as character no-undo .
     4601       for each bufp_XYZ-analysis-obj no-lock where bufp_XYZ-analysis-obj.db-num = buf_XYZ-analysis.db-num and
     4602                                                    bufp_XYZ-analysis-obj.XYZ-id = buf_XYZ-analysis.XYZ-id :
     4603          v-obj = v-obj + "," + trim(bufp_XYZ-analysis-obj.obj-type) + " " + trim(string(bufp_XYZ-analysis-obj.obj-code)) .
     4604       end.
     4605       v-obj = TRIM (v-obj,",") .
     4606           put stream OutStr-html unformatted
     4607           '<TR>'skip
     4608               '<TD colspan="18" STYLE="font-size: 14px;">Объекты    :' + string(v-obj) + '</TD>' skip
     4609           '</TR>'skip
     4610           .
     4611       define buffer bufp_XYZ-analysis-period for ub.XYZ-analysis-period.
     4612       define VARIABLE v-period as character no-undo .
     4613       for each bufp_XYZ-analysis-period no-lock where bufp_XYZ-analysis-period.db-num = buf_XYZ-analysis.db-num and
     4614                                                       bufp_XYZ-analysis-period.XYZ-id = buf_XYZ-analysis.XYZ-id :
     4615          v-period = v-period + "," + string(bufp_XYZ-analysis-period.XYZp-start,"99.99.9999") + "-" + string(bufp_XYZ-analysis-period.XYZp-end,"99.99.9999") .
     4616       end.
     4617           v-period = TRIM (v-period,",") .
     4618           put stream OutStr-html unformatted
     4619           '<TR>'skip
     4620               '<TD colspan="18" STYLE="font-size: 14px;">Периоды    :' + string(v-period) + '</TD>' skip
     4621           '</TR>'skip
     4622           .
     4623       define buffer bufp_XYZ-analysis-doc for ub.XYZ-analysis-doc.
     4624       define VARIABLE v-doc-type as character no-undo .
     4625       for each bufp_XYZ-analysis-doc no-lock where bufp_XYZ-analysis-doc.db-num = buf_XYZ-analysis.db-num and
     4626                                                    bufp_XYZ-analysis-doc.XYZ-id = buf_XYZ-analysis.XYZ-id :
     4627          v-doc-type = v-doc-type + "," + func-get-name-from-ext-type( bufp_XYZ-analysis-doc.XYZd-ext-doc-type , false ) .
     4628       end.
     4629           v-doc-type = TRIM (v-doc-type,",") .
     4630           put stream OutStr-html unformatted
     4631           '<TR>'skip
     4632               '<TD colspan="18" STYLE="font-size: 14px;">Типы документов  :' + string(v-doc-type) + '</TD>' skip
     4633           '</TR>'skip
     4634           .
     4635           put stream OutStr-html unformatted
     4636           '</thead>'skip
     4637       .
     4638        put stream OutStr-html unformatted
     4639           '<tbody>'
     4640           '<TR>'skip
     4641               '<TH style="text-align: center;">Артикул</TH>'skip
     4642               '<TH style="text-align: center;">Название</TH>'skip
     4643               '<TH style="text-align: center;">XYZ</TH>'skip
     4644               '<TH style="text-align: center;">Коэфф-т вариац %</TH>'skip
     4645               '<TH style="text-align: center;">Кол-во период продаж</TH>'skip
     4646               '<TH style="text-align: center;">Сумма для оценки по критер</TH>'skip
     4647               '<TH style="text-align: center;">ИЖТ</TH>'skip
     4648               '<TH style="text-align: center;">Ассорт. min</TH>'skip
     4649               '<TH style="text-align: center;">Ассорт. матрица</TH>'skip
     4650               '<TH style="text-align: center;">Кол-во по реализац</TH>'skip
     4651               '<TH style="text-align: center;">Остаток кол-во</TH>'skip
     4652               '<TH style="text-align: center;">Остаток товара в учет.ценах</TH>'skip
     4653               '<TH style="text-align: center;">Остаток товара в продаж.ценах</TH>'skip
     4654               '<TH style="text-align: center;">Сумма реализ. в учет.ценах</TH>'skip
     4655               '<TH style="text-align: center;">Сумма реализ. в прод.ценах</TH>'skip
     4656               '<TH style="text-align: center;">Сумма реализ. в ценах докум.</TH>'skip
     4657               '<TH style="text-align: center;">Темп продаж среднесут</TH>'skip
     4658               '<TH style="text-align: center;">Заказ кол-во товара </TH>'skip
     4659           '</TR>'skip
     4660           .
     4661       run OpenBR in this-procedure (yes, no, '':U).
     4662       DO WHILE available Buf_XYZ-analysis-goods :
     4663           run prt-goods in this-procedure .
     4664                   put stream OutStr-html unformatted
     4665                       '<TR>'skip
     4666                       '<TD> ' + string(buf_goods.artic) + '</TD>'skip
     4667                       '<TD> ' + string(buf_goods.gds-name) + '</TD>'skip
     4668                       '<TD> ' + string(Buf_XYZ-analysis-goods.XYZg-XYZ) + '</TD>'skip
     4669                       '<TD num="0.00" val="' + fnc-convert-dot-to-colon(Buf_XYZ-analysis-goods.XYZg-prcnt-for-estimate,"->>>>>>>>>>>9.99",2) + '" style="text-align: right"> ' + if Buf_XYZ-analysis-goods.XYZg-prcnt-for-estimate <> ? then fnc-convert-dot-to-colon(Buf_XYZ-analysis-goods.XYZg-prcnt-for-estimate,"->>>>>>>>>>>9.99",2) + '</TD>' else "" + '</td>' skip
     4670                       '<TD num="0" val="' + fnc-convert-dot-to-colon(Buf_XYZ-analysis-goods.kol-period,"->>>>>>>>>>>9",0) + '" style="text-align: right"> ' + if Buf_XYZ-analysis-goods.kol-period <> ? then fnc-convert-dot-to-colon(Buf_XYZ-analysis-goods.kol-period,"->>>>>>>>>>>9",0) + '</TD>' else "" + '</td>' skip
     4671                       '<TD num="0.00" val="' + fnc-convert-dot-to-colon(Buf_XYZ-analysis-goods.XYZg-sum-for-estimate,"->>>>>>>>>>>9.99",2) + '" style="text-align: right"> ' + if Buf_XYZ-analysis-goods.XYZg-sum-for-estimate <> ? then fnc-convert-dot-to-colon(Buf_XYZ-analysis-goods.XYZg-sum-for-estimate,"->>>>>>>>>>>9.99",2) + '</TD>' else "" + '</td>' skip
     4672                       '<TD> ' + string(v-izt) + '</TD>'skip
     4673                       '<TD> ' + string(v-Amin) + '</TD>'skip
     4674                       '<TD> ' + string(v-Acc-mat) + '</TD>'skip
     4675                       '<TD num="0.00" val="' + fnc-convert-dot-to-colon(Buf_XYZ-analysis-goods.XYZg-qnty,"->>>>>>>>>>>9.99",2) + '" style="text-align: right"> ' + if Buf_XYZ-analysis-goods.XYZg-qnty <> ? then fnc-convert-dot-to-colon(Buf_XYZ-analysis-goods.XYZg-qnty,"->>>>>>>>>>>9.99",2) + '</TD>' else "" + '</td>' skip
     4676                       '<TD num="0.00" val="' + fnc-convert-dot-to-colon(Buf_XYZ-analysis-goods.XYZg-stock-qnty,"->>>>>>>>>>>9.99",2) + '" style="text-align: right"> ' + if Buf_XYZ-analysis-goods.XYZg-stock-qnty <> ? then fnc-convert-dot-to-colon(Buf_XYZ-analysis-goods.XYZg-stock-qnty,"->>>>>>>>>>>9.99",2) + '</TD>' else "" + '</td>' skip
     4677                       '<TD num="0.00" val="' + fnc-convert-dot-to-colon(Buf_XYZ-analysis-goods.XYZg-stock-price-acc,"->>>>>>>>>>>9.99",2) + '" style="text-align: right"> ' + if Buf_XYZ-analysis-goods.XYZg-stock-price-acc <> ? then fnc-convert-dot-to-colon(Buf_XYZ-analysis-goods.XYZg-stock-price-acc,"->>>>>>>>>>>9.99",2) + '</TD>' else "" + '</td>' skip
     4678                       '<TD num="0.00" val="' + fnc-convert-dot-to-colon(Buf_XYZ-analysis-goods.XYZg-stock-price-sale,"->>>>>>>>>>>9.99",2) + '" style="text-align: right"> ' + if Buf_XYZ-analysis-goods.XYZg-stock-price-sale <> ? then fnc-convert-dot-to-colon(Buf_XYZ-analysis-goods.XYZg-stock-price-sale,"->>>>>>>>>>>9.99",2) + '</TD>' else "" + '</td>' skip
     4679                       '<TD num="0.00" val="' + fnc-convert-dot-to-colon(Buf_XYZ-analysis-goods.XYZg-sum-acc,"->>>>>>>>>>>9.99",2) + '" style="text-align: right"> ' + if Buf_XYZ-analysis-goods.XYZg-sum-acc <> ? then fnc-convert-dot-to-colon(Buf_XYZ-analysis-goods.XYZg-sum-acc,"->>>>>>>>>>>9.99",2) + '</TD>' else "" + '</td>' skip
     4680                       '<TD num="0.00" val="' + fnc-convert-dot-to-colon(Buf_XYZ-analysis-goods.XYZg-sum-cur,"->>>>>>>>>>>9.99",2) + '" style="text-align: right"> ' + if Buf_XYZ-analysis-goods.XYZg-sum-cur <> ? then fnc-convert-dot-to-colon(Buf_XYZ-analysis-goods.XYZg-sum-cur,"->>>>>>>>>>>9.99",2) + '</TD>' else "" + '</td>' skip
     4681                       '<TD num="0.00" val="' + fnc-convert-dot-to-colon(Buf_XYZ-analysis-goods.XYZg-sum-doc,"->>>>>>>>>>>9.99",2) + '" style="text-align: right"> ' + if Buf_XYZ-analysis-goods.XYZg-sum-doc <> ? then fnc-convert-dot-to-colon(Buf_XYZ-analysis-goods.XYZg-sum-doc,"->>>>>>>>>>>9.99",2) + '</TD>' else "" + '</td>' skip
     4682                       '<TD num="0.00" val="' + fnc-convert-dot-to-colon(Buf_XYZ-analysis-goods.XYZg-temp-sale-goods,"->>>>>>>>>>>9.99",2) + '" style="text-align: right"> ' + if Buf_XYZ-analysis-goods.XYZg-temp-sale-goods <> ? then fnc-convert-dot-to-colon(Buf_XYZ-analysis-goods.XYZg-temp-sale-goods,"->>>>>>>>>>>9.99",2) + '</TD>' else "" + '</td>' skip
     4683                       '<TD num="0.00" val="' + fnc-convert-dot-to-colon(Buf_XYZ-analysis-goods.XYZg-order-qnty,"->>>>>>>>>>>9.99",2) + '" style="text-align: right"> ' + if Buf_XYZ-analysis-goods.XYZg-order-qnty <> ? then fnc-convert-dot-to-colon(Buf_XYZ-analysis-goods.XYZg-order-qnty,"->>>>>>>>>>>9.99",2) + '</TD>' else "" + '</td>' skip
     4684                       '</TR>'skip
     4685                       .
     4686           if p-obj = true then
     4687           do:
     4688               OPEN QUERY BROWSE-obj       FOR EACH Buf_XYZ-analysis-obj WHERE                Buf_XYZ-analysis-obj.XYZ-id = v-id AND                Buf_XYZ-analysis-obj.db-num = v-db-num                NO-LOCK,                  EACH buf_XYZ-analysis-gds-obj WHERE                buf_XYZ-analysis-gds-obj.obj-type = Buf_XYZ-analysis-obj.obj-type AND                buf_XYZ-analysis-gds-obj.obj-code = Buf_XYZ-analysis-obj.obj-code AND                buf_XYZ-analysis-gds-obj.gds-code = Buf_XYZ-analysis-goods.gds-code AND                buf_XYZ-analysis-gds-obj.XYZ-id   =  v-id AND                buf_XYZ-analysis-gds-obj.db-num   = v-db-num                OUTER-JOIN NO-LOCK,                  EACH Buf_gds-obj-prop WHERE                Buf_gds-obj-prop.obj-type = ub.buf_XYZ-analysis-obj.obj-type AND                Buf_gds-obj-prop.obj-code = ub.buf_XYZ-analysis-obj.obj-code AND                Buf_gds-obj-prop.gds-code = ub.buf_XYZ-analysis-goods.gds-code                OUTER-JOIN NO-LOCK,                 first buf_assortment-matrix WHERE                buf_assortment-matrix.asmt-status        = 0  AND                buf_assortment-matrix.obj-type =  Buf_XYZ-analysis-obj.obj-type AND                buf_assortment-matrix.obj-code =  Buf_XYZ-analysis-obj.obj-code                OUTER-JOIN NO-LOCK,                 FIRST buf_assortment-matrix-goods WHERE                buf_assortment-matrix-goods.asmg-status        = 0  AND                buf_assortment-matrix-goods.asmt-id  =  buf_assortment-matrix.asmt-id AND                buf_assortment-matrix-goods.db-num   =  buf_assortment-matrix.db-num  AND                buf_assortment-matrix-goods.gds-code =  buf_XYZ-analysis-goods.gds-code                OUTER-JOIN NO-LOCK INDEXED-REPOSITION.
     4689               DO WHILE available Buf_XYZ-analysis-obj :
     4690                   run disp-obj in this-procedure .
     4691                       if AVAILABLE Buf_XYZ-analysis-gds-obj then
     4692                       do:
     4693                           if Buf_XYZ-analysis-gds-obj.XYog-qnty <> ? or Buf_XYZ-analysis-gds-obj.XYog-qnty <> 0 then
     4694                           do:
     4695                               put stream OutStr-html unformatted
     4696                                   '<TR>'skip
     4697                                   '<TD></TD>'skip
     4698                                   '<TD> ' + string(Buf_XYZ-analysis-obj.obj-type + " " + string(Buf_XYZ-analysis-obj.obj-code)) + '</TD>'skip
     4699                                   '<TD></TD>'skip
     4700                                   '<TD></TD>'skip
     4701                                   '<TD></TD>'skip
     4702                                   '<TD></TD>'skip
     4703                                   '<TD> ' + string(v-obj-igt) + '</TD>'skip
     4704                                   '<TD> ' + string( v-obj-AssMin , "да/нет" ) + '</TD>'skip
     4705                                   '<TD> ' + string(v-ass-name) + '</TD>'skip
     4706                                   .
     4707                               put stream OutStr-html unformatted
     4708                                   '<TD num="0.00" val="' + fnc-convert-dot-to-colon(Buf_XYZ-analysis-gds-obj.XYog-qnty,"->>>>>>>>>>>9.99",2) + '" style="text-align: right"> ' + if Buf_XYZ-analysis-gds-obj.XYog-qnty <> ? then fnc-convert-dot-to-colon(Buf_XYZ-analysis-gds-obj.XYog-qnty,"->>>>>>>>>>>9.99",2) + '</TD>' else "-" + '</td>' skip
     4709                                   '<TD num="0.00" val="' + fnc-convert-dot-to-colon(Buf_XYZ-analysis-gds-obj.XYog-stock-qnty,"->>>>>>>>>>>9.99",2) + '" style="text-align: right"> ' + if Buf_XYZ-analysis-gds-obj.XYog-stock-qnty <> ? then fnc-convert-dot-to-colon(Buf_XYZ-analysis-gds-obj.XYog-stock-qnty,"->>>>>>>>>>>9.99",2) + '</TD>' else "-" + '</td>' skip
     4710                                   '<TD></TD>'skip
     4711                                   '<TD num="0.00" val="' + fnc-convert-dot-to-colon((Buf_XYZ-analysis-gds-obj.XYog-stock-qnty * buf_XYZ-analysis-gds-obj.XYog-price-crc ),"->>>>>>>>>>>9.99",2) + '" style="text-align: right"> ' + if (Buf_XYZ-analysis-gds-obj.XYog-stock-qnty * buf_XYZ-analysis-gds-obj.XYog-price-crc ) <> ? then fnc-convert-dot-to-colon((Buf_XYZ-analysis-gds-obj.XYog-stock-qnty * buf_XYZ-analysis-gds-obj.XYog-price-crc ),"->>>>>>>>>>>9.99",2) + '</TD>' else "-" + '</td>' skip
     4712                                     '<TD num="0.00" val="' + fnc-convert-dot-to-colon(Buf_XYZ-analysis-gds-obj.XYog-sum-acc,"->>>>>>>>>>>9.99",2) + '" style="text-align: right"> ' + if Buf_XYZ-analysis-gds-obj.XYog-sum-acc <> ? then fnc-convert-dot-to-colon(Buf_XYZ-analysis-gds-obj.XYog-sum-acc,"->>>>>>>>>>>9.99",2) + '</TD>' else "-" + '</td>' skip
     4713                                     '<TD num="0.00" val="' + fnc-convert-dot-to-colon(Buf_XYZ-analysis-gds-obj.XYog-sum-cur,"->>>>>>>>>>>9.99",2) + '" style="text-align: right"> ' + if Buf_XYZ-analysis-gds-obj.XYog-sum-cur <> ? then fnc-convert-dot-to-colon(Buf_XYZ-analysis-gds-obj.XYog-sum-cur,"->>>>>>>>>>>9.99",2) + '</TD>' else "-" + '</td>' skip
     4714                                     '<TD num="0.00" val="' + fnc-convert-dot-to-colon(Buf_XYZ-analysis-gds-obj.XYog-sum-doc,"->>>>>>>>>>>9.99",2) + '" style="text-align: right"> ' + if Buf_XYZ-analysis-gds-obj.XYog-sum-doc <> ? then fnc-convert-dot-to-colon(Buf_XYZ-analysis-gds-obj.XYog-sum-doc,"->>>>>>>>>>>9.99",2) + '</TD>' else "-" + '</td>' skip
     4715                                     '<TD num="0.00" val="' + fnc-convert-dot-to-colon(Buf_XYZ-analysis-gds-obj.XYog-temp-sale-goods,"->>>>>>>>>>>9.99",2) + '" style="text-align: right"> ' + if Buf_XYZ-analysis-gds-obj.XYog-temp-sale-goods <> ? then fnc-convert-dot-to-colon(Buf_XYZ-analysis-gds-obj.XYog-temp-sale-goods,"->>>>>>>>>>>9.99",2) + '</TD>' else "-" + '</td>' skip
     4716                                     '<TD></TD>'skip
     4717                                 '</TR>'skip
     4718                                   .
     4719                           end.
     4720                       end.
     4721                       get next browse-obj.
     4722                   END.
     4723           end.
     4724               GET next BROWSE-goods.
     4725         END.
     4726      put stream OutStr-html unformatted
     4727                                   '</tbody>' skip
     4728                                   '</table>' skip
     4729                                   '</body>' skip
     4730                                   '</html>' skip
     4731                                   .
     4732   output stream OutStr-html close.
     4733     run prn-lib-reportviewer-report-name in this-procedure (
     4734                                                             input parParentProc
     4735                                                             ,input v-file-name-rep-htm
     4736                                                             ).
     4737   END PROCEDURE.
     4738   PROCEDURE proc-cgh-Am :
     4739       do
     4740       on error undo, return error return-value
     4741       :
     4742   define input  parameter v-new as logical   no-undo .
     4743   define buffer buf_matrix                  for  ub.assortment-matrix .
     4744   define buffer buf2_assortment-matrix-goods for ub.assortment-matrix-goods .
     4745   define buffer buf_gds-obj for ub.gds-obj.
     4746   define variable p-doc-rec as recid no-undo .
     4747   define variable v-sts as integer   no-undo .
     4748   DEFINE VARIABLE cError as CHARACTER NO-UNDO INITIAL "".
     4749   DEFINE VARIABLE iDelta as INTEGER   NO-UNDO INITIAL 0.
     4750   v-err-ext = false  .
     4751   v-longchar = "".
     4752    run make-gds-list .
     4753    for each obj-list :
     4754         Label-AM:
     4755         for each  buf_matrix no-lock where
     4756             buf_matrix.asmt-status = 0 and
     4757             buf_matrix.obj-type = obj-list.obj-type and
     4758             buf_matrix.obj-code = obj-list.obj-code :
     4759              if v-new = true then do:
     4760                 run waitfram-show in this-procedure  ("Добавление товаров в ассортиментную матрицу  "  +
     4761                                                     buf_matrix.asmt-name +
     4762                                                     "  на объекте " +
     4763                                                     string( obj-list.obj-code )) .
     4764             end.
     4765             else do:
     4766                 run waitfram-show in this-procedure  ("Удаление товаров из ассортиментную матрицу  "  +
     4767                                                     buf_matrix.asmt-name +
     4768                                                     "  на объекте " +
     4769                                                     string( obj-list.obj-code )) .
     4770             end.
     4771             if v-new = true then do:
     4772                RUN Get-Gl-Param-Proc-Otkl in THIS-PROCEDURE(
     4773                    buf_matrix.asmt-id,
     4774                    buf_matrix.db-num,
     4775                    OUTPUT cError
     4776                    ).
     4777                if cError <> "" THEN DO:
     4778                   v-err-ext = true .
     4779                   v-longchar = v-longchar + cError + chr(10).
     4780                   NEXT Label-AM.
     4781                END.
     4782   DEFINE VARIABLE vss-include-info33 AS CHARACTER FORMAT "x(65)" NO-UNDO INITIAL "@(#)$Workfile$ $Revision$".
     4783   FOR EACH gds-list NO-LOCK:
     4784       IF NOT CAN-FIND(FIRST ub.Assortment-matrix-goods WHERE
     4785                             ub.Assortment-matrix-goods.Asmt-id      = buf_matrix.Asmt-id
     4786                         AND ub.Assortment-matrix-goods.Db-num       = buf_matrix.db-num
     4787                         AND ub.Assortment-matrix-goods.gds-code     = gds-list.gds-code
     4788                         AND ub.Assortment-matrix-goods.asmg-status  = INTEGER('0':U)
     4789                         NO-LOCK) THEN DO:
     4790          ASSIGN
     4791             iDelta = iDelta + 1.
     4792       END.
     4793   END.
     4794                RUN Cntrl-AM-Add-1 IN THIS-PROCEDURE(
     4795                    iDelta,
     4796                    OUTPUT cError
     4797                    ).
     4798                if cError <> "" THEN DO:
     4799                   v-err-ext = true .
     4800                   v-longchar = v-longchar + cError + chr(10).
     4801                   NEXT Label-AM.
     4802                END.
     4803             END.
     4804             for each gds-list :
     4805                   if v-new = true then do:
     4806                      find first buf_gds-obj no-lock where
     4807                           buf_gds-obj.obj-type = obj-list.obj-type and
     4808                           buf_gds-obj.obj-code = obj-list.obj-code and
     4809                           buf_gds-obj.gds-code = gds-list.gds-code no-error .
     4810                           if available buf_gds-obj then do:
     4811   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run main_gds-mat1 in g#lib-Matrix
     4812    (input this-procedure
     4813    ,input-output p-doc-rec
     4814    ,input 'ДОБАВЛЕНИЕ':U
     4815    ,input buf_matrix.asmt-id
     4816    ,input buf_matrix.db-num
     4817    ,input gds-list.gds-code
     4818    ,input ''
     4819     ) no-error .
     4820                               if error-status :error then do:
     4821                                   v-err-ext = true .
     4822                                   v-longchar = v-longchar + return-value + chr(10).
     4823                               end.
     4824                           end.
     4825                   end.
     4826                   else do:
     4827                     find first buf2_assortment-matrix-goods no-lock where
     4828                           buf2_assortment-matrix-goods.asmt-id  = buf_matrix.asmt-id and
     4829                           buf2_assortment-matrix-goods.db-num   = buf_matrix.db-num  and
     4830                           buf2_assortment-matrix-goods.gds-code = gds-list.gds-code  and
     4831                           buf2_assortment-matrix-goods.asmg-status = 0
     4832                           no-error .
     4833                           if available buf2_assortment-matrix-goods then do:
     4834                               v-sts = int('1':U) .
     4835   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run main_gds-mat2 in g#lib-Matrix
     4836    (input this-procedure
     4837    ,input recid(buf2_assortment-matrix-goods)
     4838    ,input-output v-sts
     4839    ,input no
     4840     ) no-error .
     4841                                 if error-status :error then do:
     4842                                   v-err-ext = true .
     4843                                   v-longchar = v-longchar + return-value + chr(10).
     4844                                 end.
     4845                           end.
     4846                   end.
     4847             end.
     4848         end.
     4849   end.
     4850   run waitfram-hide in this-procedure .
     4851       if v-err-ext = true  then do:
     4852       define variable v-ok as logical   no-undo .
     4853         run gbl/d-longchar.w (
     4854             ?,
     4855             'Editor_row=2\':u
     4856           + 'title=При добавлении в Ассортиментные матрицы\':u
     4857           + 'Editor_col=1\':u
     4858           + 'Editor_width=96\':u
     4859           + 'Editor_height=21\':u
     4860           + 'readonly=yes\':u
     4861         ,input-output v-longchar
     4862         ,output v-ok ) no-error .
     4863           v-longchar = "" .
     4864   if (valid-handle(g#lib-Matrix) <> true) then do:   run ref/gds-mat1.p persistent no-error .   if error-status :error or (valid-handle(g#lib-Matrix) <> true) then do:     message       "Error starting library.p" skip       g#lib-Matrix skip       g#lib-Matrix :type skip       g#lib-Matrix :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clear-longmess in g#lib-Matrix
     4865      .
     4866       end.
     4867   run OpenBr (yes, no, '':U).
     4868   end.
     4869   END PROCEDURE.
     4870   PROCEDURE proc-cgh-Amin :
     4871       do
     4872       on error undo, return error return-value
     4873       :
     4874   define input  parameter v-new as logical   no-undo .
     4875     run make-gds-list .
     4876     run ref/chg-amin.p ( input v-new ) no-error  .
     4877         if error-status :error then
     4878             message vss-workfile vss-revision vss-description skip
     4879             error-status :get-message(1)
     4880             return-value
     4881             .
     4882     run OpenBr (yes, no, '':U).
     4883       end.
     4884   END PROCEDURE.
     4885   PROCEDURE proc-chg-igt :
     4886       do
     4887       on error undo, return error return-value
     4888       :
     4889   define variable  v-old as character no-undo .
     4890   define variable  v-new as character no-undo .
     4891     run make-gds-list in this-procedure .
     4892     run ref/graf-igt.w ( output v-old, output v-new ).
     4893     if not(v-old = "" and v-new = "")  then do:
     4894         run ref/chg-igt.p ( input v-old, input v-new , input true ) no-error  .
     4895             if error-status :error then
     4896                 message vss-workfile vss-revision vss-description skip
     4897                 error-status :get-message(1)
     4898                 return-value
     4899                 .
     4900     end.
     4901   run OpenBr ( yes, no, '':U).
     4902       end.
     4903   END PROCEDURE.
     4904   PROCEDURE proc-disp-goods :
     4905   define variable   v-old-izt  as character no-undo .
     4906   define variable   v-old-amin  as character no-undo .
     4907   define variable   v-old-acc-mat  as character no-undo .
     4908   define variable vt-Amin as character no-undo .
     4909       assign
     4910       v-old-izt  = ""
     4911       v-izt      = ""
     4912       v-Amin     = ""
     4913       v-old-Amin = ""
     4914       v-acc-mat     =  ""
     4915       v-old-acc-mat = ""
     4916       .
     4917   OPEN QUERY BROWSE-obj       FOR EACH Buf_XYZ-analysis-obj WHERE                Buf_XYZ-analysis-obj.XYZ-id = v-id AND                Buf_XYZ-analysis-obj.db-num = v-db-num                NO-LOCK,                  EACH buf_XYZ-analysis-gds-obj WHERE                buf_XYZ-analysis-gds-obj.obj-type = Buf_XYZ-analysis-obj.obj-type AND                buf_XYZ-analysis-gds-obj.obj-code = Buf_XYZ-analysis-obj.obj-code AND                buf_XYZ-analysis-gds-obj.gds-code = Buf_XYZ-analysis-goods.gds-code AND                buf_XYZ-analysis-gds-obj.XYZ-id   =  v-id AND                buf_XYZ-analysis-gds-obj.db-num   = v-db-num                OUTER-JOIN NO-LOCK,                  EACH Buf_gds-obj-prop WHERE                Buf_gds-obj-prop.obj-type = ub.buf_XYZ-analysis-obj.obj-type AND                Buf_gds-obj-prop.obj-code = ub.buf_XYZ-analysis-obj.obj-code AND                Buf_gds-obj-prop.gds-code = ub.buf_XYZ-analysis-goods.gds-code                OUTER-JOIN NO-LOCK,                 first buf_assortment-matrix WHERE                buf_assortment-matrix.asmt-status        = 0  AND                buf_assortment-matrix.obj-type =  Buf_XYZ-analysis-obj.obj-type AND                buf_assortment-matrix.obj-code =  Buf_XYZ-analysis-obj.obj-code                OUTER-JOIN NO-LOCK,                 FIRST buf_assortment-matrix-goods WHERE                buf_assortment-matrix-goods.asmg-status        = 0  AND                buf_assortment-matrix-goods.asmt-id  =  buf_assortment-matrix.asmt-id AND                buf_assortment-matrix-goods.db-num   =  buf_assortment-matrix.db-num  AND                buf_assortment-matrix-goods.gds-code =  buf_XYZ-analysis-goods.gds-code                OUTER-JOIN NO-LOCK INDEXED-REPOSITION.
     4918       GET next BROWSE-obj.
     4919       assign
     4920       v-old-izt  =  Buf_gds-obj-prop.gdop-igt
     4921       v-izt      =  Buf_gds-obj-prop.gdop-igt
     4922       v-Amin     =  string(Buf_gds-obj-prop.gdop-assort-min)
     4923       v-old-Amin =  string(Buf_gds-obj-prop.gdop-assort-min)
     4924       v-acc-mat     =  string(buf_assortment-matrix-goods.asmt-id)
     4925       v-old-acc-mat =  string(buf_assortment-matrix-goods.asmt-id)
     4926       no-error
     4927       .
     4928           if v-old-Amin = ? or
     4929             v-old-Amin = 'no' or
     4930             v-old-Amin = "?" or
     4931             v-old-Amin = "" then v-old-Amin = "" .
     4932       if v-izt = ? or v-izt = "" then v-izt = 'Пусто':U .
     4933       if v-old-izt = ? or v-old-izt = "" then v-old-izt = 'Пусто':U .
     4934       if v-Amin = ? or v-Amin = 'no' or v-Amin = "?" or v-Amin = "" then v-Amin = "не входит" .
     4935          else v-Amin = "входит" .
     4936       if v-acc-mat = ? or v-acc-mat = ""  then v-acc-mat = "не входит" .
     4937          else v-acc-mat = "входит" .
     4938       DO WHILE AVAILABLE(Buf_XYZ-analysis-obj):
     4939           if Buf_gds-obj-prop.gdop-igt <> ? then
     4940           if v-old-izt     <> Buf_gds-obj-prop.gdop-igt                then  v-izt = "разное" .
     4941              vt-amin = string(Buf_gds-obj-prop.gdop-assort-min) .
     4942           if vt-Amin = ?    or
     4943              vt-Amin = 'no' or
     4944              vt-Amin = "?"  or
     4945              vt-Amin = "" then vt-Amin = "" .
     4946           if v-old-Amin    <> vt-Amin  then  v-Amin = "разное" .
     4947           if v-old-acc-mat <> string(buf_assortment-matrix-goods.asmt-id)
     4948             and (v-old-acc-mat = ? or string(buf_assortment-matrix-goods.asmt-id) = ?  )
     4949             then  v-acc-mat = "разное" .
     4950         assign
     4951           v-old-izt     = Buf_gds-obj-prop.gdop-igt
     4952           v-old-Amin    = string(Buf_gds-obj-prop.gdop-assort-min)
     4953           v-old-acc-mat = string(buf_assortment-matrix-goods.asmt-id)
     4954           no-error
     4955         .
     4956           if v-old-Amin = ? or
     4957              v-old-Amin = 'no' or
     4958              v-old-Amin = "?" or
     4959              v-old-Amin = "" then v-old-Amin = "" .
     4960           if v-old-izt = ? or v-old-izt = "" then v-old-izt = 'Пусто':U .
     4961         GET NEXT BROWSE-obj.
     4962       END.
     4963   END PROCEDURE.
     4964   PROCEDURE proc-save :
     4965     define variable v-list-doc as character no-undo .
     4966     define variable v-list-obj as character no-undo .
     4967     define variable v-possb-keep-string-obj as logical   no-undo .
     4968     define variable v-string-obj            as character no-undo .
     4969     define variable v-hash-string-obj       as character no-undo .
     4970     define variable v-recid as recid  no-undo .
     4971     define buffer x-XYZ-analysis for ub.XYZ-analysis.
     4972     define buffer x-XYZ-analysis-obj for ub.XYZ-analysis-obj .
     4973     define buffer x-XYZ-analysis-doc for ub.XYZ-analysis-doc .
     4974     run waitfram-show ( "Сохранение анализа по умолчанию ... ") .
     4975     v-list-obj = "" .
     4976     find first x-XYZ-analysis no-lock  where
     4977                x-XYZ-analysis.XYZ-id  = v-id and
     4978                x-XYZ-analysis.db-num  = v-db-num  no-error .
     4979                if error-status :error then return .
     4980     for each  x-XYZ-analysis-obj no-lock
     4981         where x-XYZ-analysis-obj.XYZ-id = x-XYZ-analysis.XYZ-id and
     4982               x-XYZ-analysis-obj.db-num = x-XYZ-analysis.db-num  :
     4983               v-list-obj = v-list-obj + x-XYZ-analysis-obj.obj-type + string(x-XYZ-analysis-obj.obj-code) + "," .
     4984     end.
     4985     run find-from-hash  (
     4986        input v-list-obj
     4987       ,input "rang-XYZ-def"
     4988       ,input "raxd-possb-keep-string-obj"
     4989       ,input "raxd-string-obj"
     4990       ,input "raxd-hash-string-obj"
     4991       ,input "rang-XYZ-def-obj"
     4992       ,output v-recid
     4993       ).
     4994     run update-rang-xyz-def (
     4995        input v-recid
     4996       ,input v-list-obj
     4997       ,input x-XYZ-analysis.XYZ-x
     4998       ,input x-XYZ-analysis.XYZ-y
     4999       ,input x-XYZ-analysis.XYZ-z
     5000       ).
     5001     v-list-doc = "".
     5002     for each x-XYZ-analysis-doc no-lock
     5003         where x-XYZ-analysis-doc.XYZ-id = x-XYZ-analysis.XYZ-id and
     5004               x-XYZ-analysis-doc.db-num = x-XYZ-analysis.db-num  :
     5005               v-list-doc = v-list-doc + x-XYZ-analysis-doc.XYZd-ext-doc-type  + "," .
     5006     end.
     5007     run find-from-hash  (
     5008        input v-list-obj
     5009       ,input "doc-XYZ-def"
     5010       ,input "doxd-possb-keep-string-obj"
     5011       ,input "doxd-string-obj"
     5012       ,input "doxd-hash-string-obj"
     5013       ,input "doc-XYZ-def-obj"
     5014       ,output v-recid
     5015       ).
     5016     run update-doc-def (
     5017        input v-recid
     5018       ,input v-list-obj
     5019       ,input v-list-doc
     5020       ).
     5021     run waitfram-hide in this-procedure .
     5022     define variable p-ok as logical   no-undo .
     5023       run save-def-analysis-obj (
     5024         input  "xyz"
     5025       , input  x-xyz-analysis.db-num
     5026       , input  x-xyz-analysis.xyz-id
     5027       , output p-ok
     5028       ) .
     5029       if p-ok then
     5030      message
     5031      "Интервалы ранжирования и типы документов запомнены для данного списка объектов по умолчанию" skip
     5032      "Этот анализ будет использоваться в отчетах как анализ по умолчанию" skip
     5033      x-xyz-analysis.xyz-id skip
     5034      x-xyz-analysis.xyz-name
     5035     view-as alert-box information .
     5036   END PROCEDURE.
     5037   PROCEDURE prt-goods :
     5038   define variable v-old-izt  as character no-undo .
     5039   define variable v-old-amin  as character no-undo .
     5040   define variable v-old-acc-mat  as character no-undo .
     5041   define variable vt-Amin as character no-undo .
     5042   define variable t-izt   as character no-undo .
     5043   define variable t-Amin  as character no-undo .
     5044   define variable t-asm   as character no-undo .
     5045   define variable fl      as logical   no-undo .
     5046   fl = true .
     5047       assign
     5048       v-old-izt  = ""
     5049       v-izt      = ""
     5050       v-Amin     = ""
     5051       v-old-Amin = ""
     5052       v-acc-mat     =  ""
     5053       v-old-acc-mat = ""
     5054       .
     5055   define buffer buf2_XYZ-analysis-gds-obj for ub.XYZ-analysis-gds-obj   .
     5056   define buffer buf2_assortment-matrix for ub.assortment-matrix.
     5057   define buffer buf2_assortment-matrix-goods for ub.assortment-matrix-goods.
     5058   FOR EACH Buf_XYZ-analysis-obj WHERE
     5059            Buf_XYZ-analysis-obj.XYZ-id = v-id AND
     5060            Buf_XYZ-analysis-obj.db-num = v-db-num
     5061            NO-LOCK
     5062            :
     5063           find first buf2_XYZ-analysis-gds-obj WHERE
     5064                      buf2_XYZ-analysis-gds-obj.obj-type = Buf_XYZ-analysis-obj.obj-type AND
     5065                      buf2_XYZ-analysis-gds-obj.obj-code = Buf_XYZ-analysis-obj.obj-code AND
     5066                      buf2_XYZ-analysis-gds-obj.gds-code = Buf_XYZ-analysis-goods.gds-code AND
     5067                      buf2_XYZ-analysis-gds-obj.XYZ-id   =  v-id AND
     5068                      buf2_XYZ-analysis-gds-obj.db-num   = v-db-num
     5069                      NO-LOCK  no-error .
     5070                   find first buf2_assortment-matrix WHERE
     5071                         buf2_assortment-matrix.asmt-status        = 0  AND
     5072                         buf2_assortment-matrix.obj-type =  Buf_XYZ-analysis-obj.obj-type AND
     5073                         buf2_assortment-matrix.obj-code =  Buf_XYZ-analysis-obj.obj-code
     5074                         NO-LOCK no-error .
     5075                   find first buf2_assortment-matrix-goods WHERE
     5076                         buf2_assortment-matrix-goods.asmg-status        = 0  AND
     5077                         buf2_assortment-matrix-goods.asmt-id  =  buf2_assortment-matrix.asmt-id AND
     5078                         buf2_assortment-matrix-goods.db-num   =  buf2_assortment-matrix.db-num  AND
     5079                         buf2_assortment-matrix-goods.gds-code =  buf_XYZ-analysis-goods.gds-code
     5080                         NO-LOCK no-error .
     5081   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5082   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjpr in g#library
     5083     (input  Buf_XYZ-analysis-obj.obj-type
     5084     ,input  Buf_XYZ-analysis-obj.obj-code
     5085     ,input  ?
     5086     ,input  ?
     5087     ,input  ?
     5088     ,input  Buf_XYZ-analysis-goods.gds-code
     5089     ,output t-amin
     5090     ,output t-izt
     5091     ,output v-gdop-min-stock
     5092     ,output v-grop-max-stock
     5093     ,output v-grop-level-always-presence
     5094     ,output v-grop-min-order
     5095     )  .
     5096                if not available buf2_assortment-matrix-goods then t-asm = "0" .
     5097                                                              else t-asm = "1".
     5098                if fl = true then do:
     5099                     assign
     5100                     fl =  false
     5101                     v-old-izt  =  t-izt
     5102                     v-izt      =  t-izt
     5103                     v-Amin     =  t-amin
     5104                     v-old-Amin =  t-amin
     5105                     v-acc-mat     =  t-asm
     5106                     v-old-acc-mat =  t-asm
     5107                     .
     5108                     if  v-Amin = 'no'  then v-Amin = "не входит" .
     5109                                        else v-Amin = "входит" .
     5110                     if v-acc-mat = "0" then v-acc-mat = "не входит" .
     5111                                        else v-acc-mat = "входит" .
     5112                 end.
     5113           if v-old-izt     <> t-izt            then  v-izt = "разное" .
     5114           if v-old-Amin    <> t-Amin           then  v-Amin = "разное" .
     5115           if v-old-acc-mat <> t-asm            then  v-acc-mat = "разное" .
     5116         assign
     5117           v-old-izt     = t-izt
     5118           v-old-Amin    = t-Amin
     5119           v-old-acc-mat = t-asm
     5120         .
     5121   end.
     5122   END PROCEDURE.
     5123   PROCEDURE get-report-num :
     5124   define output parameter p-report-num as integer no-undo .
     5125     do
     5126     on error undo, return error return-value
     5127     :
     5128       run gbl/getrpnum.p (output p-report-num).
     5129     end.
     5130   END PROCEDURE.
