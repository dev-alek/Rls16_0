     1894   procedure correct-message :
     1895   define input  parameter p-longchar as longchar no-undo .
     1896   define variable v-longchar as longchar no-undo .
     1897   define variable v-err-ext  as logical  no-undo .
     1898     do
     1899     on error undo, return error return-value
     1900     :
     1901      run get-long-message in this-procedure  (output v-longchar ).
     1902       v-longchar = v-longchar + p-longchar.
     1903       v-err-ext  = true .
     1904       run set-long-message  in this-procedure  (input v-longchar,  input v-err-ext ).
     1905     end.
     1906   end procedure.
     1907   define variable v-longchar as longchar no-undo .
     1908   define variable v-err-ext as logical   no-undo .
