     2104   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2105   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     2106   DEFINE VARIABLE vss-include-info20 AS CHARACTER FORMAT "x(65)" NO-UNDO INITIAL "@(#)$Workfile$ $Revision$".
     2107   FUNCTION indicator-life-gds-n RETURNS CHARACTER ( input p-rec as recid ) FORWARD.
     2108   DEFINE VARIABLE v-gl-iProc-Otkl AS DECIMAL NO-UNDO INITIAL 0.
     2109   DEFINE VARIABLE v-gl-lAM-Is-Obj         AS LOGICAL NO-UNDO INITIAL FALSE.
     2110   DEFINE VARIABLE v-gl-iAM-Gds-All        AS INTEGER NO-UNDO INITIAL 0.
     2111   DEFINE VARIABLE v-gl-iAM-Sbl-Gds-All    AS INTEGER NO-UNDO INITIAL 0.
     2112   DEFINE VARIABLE v-gl-iAM-Gds-Vyv        AS INTEGER NO-UNDO INITIAL 0.
     2113   DEFINE VARIABLE v-gl-lAM-Ref-Shablon    AS LOGICAL NO-UNDO INITIAL FALSE.
     2114   DEFINE VARIABLE v-gl-dAM-Proc-Otkl      AS DECIMAL NO-UNDO INITIAL 0.
     2115   DEFINE VARIABLE v-gl-dAM-Proc-Otkl-Ras  AS DECIMAL NO-UNDO INITIAL 0.
     2116   FUNCTION Is-Gds-In-AssMatr RETURN LOGICAL(
     2117      p-Gds-code AS INTEGER,
     2118      p-Asmt-id  AS INTEGER,
     2119      p-Db-num   AS INTEGER):
     2120      DEFINE BUFFER buf_Gds FOR Ub.Assortment-matrix-goods.
     2121      RETURN CAN-FIND(FIRST buf_Gds WHERE
     2122                            buf_Gds.Asmt-id     = p-Asmt-id
     2123                        AND buf_Gds.Db-num      = p-Db-num
     2124                        AND buf_Gds.Gds-code    = p-Gds-code
     2125                        AND buf_Gds.Asmg-status = INTEGER('0':U)
     2126                      NO-LOCK).
     2127   END FUNCTION.
     2128   PROCEDURE Get-Delta-Gds-2-Matrix:
     2129      DEFINE PARAMETER BUFFER buf_AM-1 FOR ub.Assortment-matrix.
     2130      DEFINE PARAMETER BUFFER buf_AM-2 FOR ub.Assortment-matrix.
     2131      DEFINE OUTPUT PARAMETER iDelta AS INTEGER NO-UNDO INITIAL 0.
     2132      DEFINE BUFFER buf_Gds-1 FOR ub.Assortment-matrix-goods.
     2133      DEFINE BUFFER buf_Gds-2 FOR ub.Assortment-matrix-goods.
     2134      FOR EACH buf_Gds-1 WHERE
     2135               buf_Gds-1.Asmt-id = buf_AM-1.Asmt-id
     2136           AND buf_Gds-1.Db-num  = buf_AM-1.Db-num
     2137           AND buf_Gds-1.Asmg-status = INTEGER('0':U)
     2138          NO-LOCK:
     2139          IF NOT CAN-FIND(FIRST buf_Gds-2 WHERE
     2140                                buf_Gds-2.Asmt-id     = buf_AM-2.Asmt-id
     2141                            AND buf_Gds-2.Db-num      = buf_AM-2.Db-num
     2142                            AND buf_Gds-2.Gds-code    = buf_Gds-1.Gds-code
     2143                            AND buf_Gds-2.Asmg-status = INTEGER('0':U)
     2144                            NO-LOCK) THEN DO:
     2145             ASSIGN
     2146                iDelta = iDelta + 1.
     2147          END.
     2148      END.
     2149      RETURN.
     2150   END PROCEDURE.
     2151   PROCEDURE Cntrl-AM-Add-1:
     2152      DEFINE INPUT PARAMETER iDelta  AS INTEGER   NO-UNDO.
     2153      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     2154      IF v-gl-iProc-Otkl = 0      THEN RETURN.
     2155      IF NOT v-gl-lAM-Is-Obj      THEN RETURN.
     2156      IF NOT v-gl-lAM-Ref-Shablon THEN RETURN.
     2157      RUN Calc-Proc-Otkl IN THIS-PROCEDURE(iDelta).
     2158      IF iDelta = 0 THEN DO:
     2159         IF v-gl-dAM-Proc-Otkl >= v-gl-iProc-Otkl THEN DO:
     2160            cError = "В данной матрице процент отклонения товаров от шаблона (=" + STRING(v-gl-dAM-Proc-Otkl) + ")" + chr(10) +
     2161                     " больше допустимого (=" + STRING( v-gl-iProc-Otkl) +  ")." + chr(10) +
     2162                     "Добавление товаров невозможно !".
     2163         END.
     2164      END. ELSE DO:
     2165         IF v-gl-dAM-Proc-Otkl-Ras >= v-gl-iProc-Otkl THEN DO:
     2166            cError = "В данной матрице будущий расчетный процент отклонения товаров от шаблона (=" + STRING(v-gl-dAM-Proc-Otkl-Ras) + ")" + chr(10) +
     2167                     " больше допустимого (=" + STRING( v-gl-iProc-Otkl ) +  ")." + chr(10) +
     2168                     " Добавление товаров невозможно !".
     2169         END.
     2170      END.
     2171      RETURN.
     2172   END PROCEDURE.
     2173   PROCEDURE Get-Gl-Param-Proc-Otkl:
     2174      DEFINE INPUT PARAMETER   p-Asmt-Id AS INTEGER    NO-UNDO.
     2175      DEFINE INPUT PARAMETER   p-Db-num  AS INTEGER    NO-UNDO.
     2176      DEFINE OUTPUT PARAMETER  cError    AS CHARACTER  NO-UNDO INITIAL "".
     2177      DEFINE BUFFER buf_AM   FOR ub.Assortment-Matrix.
     2178      FIND FIRST buf_AM WHERE
     2179                 buf_AM.asmt-id = p-Asmt-id
     2180             AND buf_AM.db-num  = p-Db-num
     2181           NO-LOCK NO-ERROR.
     2182      IF NOT AVAILABLE buf_AM THEN DO:
     2183         cError = PROGRAM-NAME(1) +  ":Не найдена АМ id=" + STRING(p-Asmt-id) + " db-num=" + STRING(p-Db-num).
     2184         RETURN.
     2185      END.
     2186      RUN Get-Gl-Set-Proc-Otkl IN THIS-PROCEDURE(
     2187          buf_AM.obj-type,
     2188          buf_AM.obj-code
     2189          ).
     2190      RUN Get-Gl-Param-AM-All in THIS-PROCEDURE(
     2191          buf_AM.Asmt-id,
     2192          buf_AM.db-num
     2193          ).
     2194      RETURN.
     2195   END PROCEDURE.
     2196   PROCEDURE Get-Gl-Param-AM-All:
     2197      DEFINE INPUT PARAMETER   p-Asmt-Id AS INTEGER    NO-UNDO.
     2198      DEFINE INPUT PARAMETER   p-Db-num  AS INTEGER    NO-UNDO.
     2199      DEFINE VARIABLE lIsAmObj    AS LOGICAL    NO-UNDO INITIAL FALSE.
     2200      DEFINE VARIABLE iSh-Asmt-id AS INTEGER    NO-UNDO INITIAL 0.
     2201      DEFINE VARIABLE iSh-Db-num  AS INTEGER    NO-UNDO INITIAL 0.
     2202      DEFINE VARIABLE cSh-Type    AS CHARACTER  NO-UNDO INITIAL "".
     2203      DEFINE VARIABLE cError      AS CHARACTER  NO-UNDO INITIAL "".
     2204      DEFINE VARIABLE dAmt        AS DECIMAL    EXTENT 2  NO-UNDO INITIAL 0.
     2205      DEFINE VARIABLE cMode       AS CHARACTER  NO-UNDO INITIAL "".
     2206      ASSIGN
     2207         v-gl-iAM-Gds-All     = 0
     2208         v-gl-iAM-Sbl-Gds-All = 0
     2209         v-gl-iAM-Gds-Vyv     = 0
     2210         v-gl-dAM-Proc-Otkl   = 0
     2211         v-gl-lAM-Ref-Shablon = FALSE
     2212         .
     2213      RUN Get-Param-AM IN THIS-PROCEDURE (
     2214          p-Asmt-id,
     2215          p-Db-num,
     2216          OUTPUT lIsAmObj,
     2217          OUTPUT iSh-Asmt-id,
     2218          OUTPUT iSh-Db-num,
     2219          OUTPUT cSh-Type,
     2220          OUTPUT cError
     2221          ).
     2222      IF cError <> "" THEN DO:
     2223         MESSAGE
     2224            PROGRAM-NAME(1) ":" SKIP
     2225            "Такого быть не должно !!!" SKIP
     2226            cError SKIP
     2227            VIEW-AS ALERT-BOX INFO BUTTONS OK.
     2228         RETURN.
     2229      END.
     2230      ASSIGN
     2231         cMode                 = (IF lIsAmObj THEN "IL_GDS":U ELSE "")
     2232         v-gl-lAM-Ref-Shablon  = (IF iSh-Asmt-id = 0 THEN FALSE ELSE TRUE)
     2233         .
     2234      RUN Get-Param-AM-Gds IN THIS-PROCEDURE(
     2235          p-Asmt-Id,
     2236          p-Db-num,
     2237          '0':U,
     2238          cMode,
     2239          OUTPUT dAmt
     2240          ).
     2241      ASSIGN
     2242         v-gl-iAM-Gds-All = dAmt[1]
     2243         v-gl-iAM-Gds-Vyv = (IF lIsAmObj THEN dAmt[2] ELSE 0)
     2244         .
     2245       IF NOT v-gl-lAM-Ref-Shablon THEN DO:
     2246          RETURN.
     2247       END.
     2248      RUN Get-Param-AM-Gds IN THIS-PROCEDURE(
     2249          iSh-Asmt-id,
     2250          iSh-Db-num,
     2251          '0':U,
     2252          "",
     2253          OUTPUT dAmt
     2254          ).
     2255      ASSIGN
     2256         v-gl-iAM-Sbl-Gds-All = dAmt[1].
     2257      RUN Calc-Proc-Otkl IN THIS-PROCEDURE(0).
     2258      RETURN.
     2259   END PROCEDURE.
     2260   PROCEDURE Get-Param-AM-Gds:
     2261      DEFINE INPUT PARAMETER   p-Asmt-Id AS INTEGER    NO-UNDO.
     2262      DEFINE INPUT PARAMETER   p-Db-num  AS INTEGER    NO-UNDO.
     2263      DEFINE INPUT PARAMETER   p-Stat    AS INTEGER    NO-UNDO.
     2264      DEFINE INPUT PARAMETER   p-Mode    AS CHARACTER  NO-UNDO.
     2265      DEFINE OUTPUT PARAMETER  o-dAmt    AS DECIMAL    EXTENT 2 NO-UNDO INITIAL 0.
     2266      DEFINE BUFFER buf_AM-goods FOR ub.Assortment-matrix-goods.
     2267      FOR EACH buf_AM-goods WHERE
     2268               buf_AM-goods.Asmt-id      = p-Asmt-Id
     2269           AND buf_AM-goods.Db-num       = p-Db-num
     2270           AND buf_AM-goods.asmg-status  = p-Stat
     2271          NO-LOCK:
     2272          ASSIGN
     2273             o-dAmt[1] = o-dAmt[1] + 1.
     2274          IF CAN-DO("IL_GDS":U, p-Mode) THEN DO:
     2275             IF Indicator-life-gds-n(recid(buf_AM-goods)) = 'На вывод из ассортимента':U THEN DO:
     2276                ASSIGN
     2277                   o-dAmt[2] = o-dAmt[2] + 1.
     2278             END.
     2279          END.
     2280      END.
     2281      RETURN.
     2282   END PROCEDURE.
     2283   PROCEDURE Get-Param-AM:
     2284      DEFINE INPUT  PARAMETER  p-Asmt-id   AS INTEGER   NO-UNDO.
     2285      DEFINE INPUT  PARAMETER  p-Db-num    AS INTEGER   NO-UNDO.
     2286      DEFINE OUTPUT PARAMETER  lIsObj      AS LOGICAL   NO-UNDO INITIAL FALSE.
     2287      DEFINE OUTPUT PARAMETER  o-Asmt-id   AS INTEGER   NO-UNDO INITIAL 0.
     2288      DEFINE OUTPUT PARAMETER  o-Db-Num    AS INTEGER   NO-UNDO INITIAL 0.
     2289      DEFINE OUTPUT PARAMETER  v-Type      AS CHARACTER NO-UNDO INITIAL "".
     2290      DEFINE OUTPUT PARAMETER  cError      AS CHARACTER NO-UNDO INITIAL "".
     2291      DEFINE VARIABLE v-value AS  CHARACTER NO-UNDO INITIAL "".
     2292      DEFINE BUFFER buf_AM   FOR ub.Assortment-Matrix.
     2293      DEFINE BUFFER buf_AM-2 FOR ub.Assortment-Matrix.
     2294      ASSIGN
     2295         v-gl-lAM-Is-Obj = FALSE.
     2296      FIND FIRST buf_AM WHERE
     2297                 buf_AM.asmt-id = p-Asmt-id
     2298             AND buf_AM.db-num  = p-Db-num
     2299           NO-LOCK NO-ERROR.
     2300      IF NOT AVAILABLE buf_AM THEN DO:
     2301         cError = "Не найдена АМ id=" + STRING(p-Asmt-id) + " db-num=" + STRING(p-Db-num).
     2302         RETURN.
     2303      END.
     2304      IF buf_AM.asmt-type <> 'Объект':U THEN DO:
     2305         RETURN.
     2306      END. ELSE DO:
     2307         ASSIGN
     2308            lIsObj           = TRUE
     2309            v-gl-lAM-Is-Obj  = TRUE
     2310            .
     2311      END.
     2312      run assmatat-value (
     2313          input buf_AM.asmt-id
     2314         ,input buf_AM.db-num
     2315         ,input 'RootShablon':U
     2316         ,output v-value
     2317         ,output v-type
     2318         ) .
     2319      IF v-value = "" OR v-value = ? THEN DO:
     2320         RETURN.
     2321      END.
     2322      ASSIGN
     2323         o-Asmt-id = INTEGER(ENTRY(1, v-value, chr(4)))
     2324         o-Db-num  = INTEGER(ENTRY(2, v-value, chr(4)))
     2325         NO-ERROR.
     2326      IF ERROR-STATUS:ERROR THEN DO:
     2327         cError = PROGRAM-NAME(1) + ":" + ERROR-STATUS:GET-MESSAGE(1).
     2328         RETURN.
     2329      END.
     2330      FIND FIRST buf_AM-2 WHERE
     2331                 buf_AM-2.asmt-id = o-Asmt-id
     2332             AND buf_AM-2.db-num  = o-Db-num
     2333           NO-LOCK NO-ERROR.
     2334      IF NOT AVAILABLE buf_AM-2 THEN DO:
     2335         cError = "Не найден шаблон АМ id=" + STRING(o-Asmt-id) + " db-num=" + STRING(o-Db-num).
     2336         RETURN.
     2337      END.
     2338      RETURN.
     2339   END PROCEDURE.
     2340   PROCEDURE Get-Gl-Set-Proc-Otkl:
     2341      DEFINE INPUT PARAMETER  cObj-type AS CHARACTER NO-UNDO.
     2342      DEFINE INPUT PARAMETER  iObj-code AS INTEGER   NO-UNDO.
     2343      DEFINE VARIABLE v-Character   AS CHARACTER  NO-UNDO .
     2344      DEFINE VARIABLE v-Date        AS DATE       NO-UNDO .
     2345      DEFINE VARIABLE v-Decimal     AS DECIMAL    NO-UNDO .
     2346      DEFINE VARIABLE v-Integer     AS INTEGER    NO-UNDO .
     2347      DEFINE VARIABLE v-Logical     AS LOGICAL    NO-UNDO .
     2348      DEFINE VARIABLE v-Param-Type  AS CHARACTER  NO-UNDO .
     2349      ASSIGN
     2350         v-gl-iProc-Otkl = 0
     2351         .
     2352      EMPTY TEMP-TABLE thbjattr_thbj-attr .
     2353      RUN adm/shattri.p (
     2354              INPUT  "get":U,
     2355              INPUT  cObj-type,
     2356              INPUT  iObj-code,
     2357              INPUT  'Ass-obj':U,
     2358              INPUT  'ass-proc-matr-shabl':U ,
     2359              OUTPUT v-Character,
     2360              OUTPUT v-Date,
     2361              OUTPUT v-Decimal,
     2362              OUTPUT v-Integer,
     2363              OUTPUT v-Logical,
     2364              OUTPUT v-Param-Type,
     2365              INPUT-OUTPUT TABLE thbjattr_thbj-attr
     2366          ) NO-ERROR.
     2367      IF ERROR-STATUS:ERROR THEN DO:
     2368         ASSIGN
     2369            v-Integer  = 0
     2370            v-Decimal  = 0.
     2371      END. ELSE DO:
     2372         ASSIGN
     2373            v-gl-iProc-Otkl = v-Integer
     2374            .
     2375      END.
     2376      RETURN.
     2377   END PROCEDURE.
     2378   PROCEDURE Calc-Proc-Otkl:
     2379      DEFINE INPUT PARAMETER iDeltaGds AS INTEGER NO-UNDO.
     2380      DEFINE VARIABLE iTmp AS INTEGER NO-UNDO INITIAL 0.
     2381      ASSIGN
     2382         v-gl-dAM-Proc-Otkl     = 0
     2383         v-gl-dAM-Proc-Otkl-Ras = 0
     2384         .
     2385      IF NOT v-gl-lAM-Ref-Shablon THEN DO:
     2386         RETURN.
     2387      END.
     2388      IF v-gl-iAM-Sbl-Gds-All = 0 THEN DO:
     2389         ASSIGN
     2390            v-gl-dAM-Proc-Otkl     = 999999
     2391            v-gl-dAM-Proc-Otkl-Ras = 999999
     2392            .
     2393         RETURN.
     2394      END.
     2395      ASSIGN
     2396         iTmp = (v-gl-iAM-Gds-All - v-gl-iAM-Sbl-Gds-All)
     2397         v-gl-dAM-Proc-Otkl     = ROUND(iTmp * 100 / v-gl-iAM-Sbl-Gds-All, 2)
     2398         v-gl-dAM-Proc-Otkl-Ras = ROUND((iTmp + iDeltaGds)  * 100 / v-gl-iAM-Sbl-Gds-All, 2)
     2399         .
     2400      RETURN.
     2401   END PROCEDURE.
     2402   FUNCTION indicator-life-gds-n RETURNS CHARACTER
     2403   ( input p-rec as recid ) :
     2404   define buffer buf_matrix-goods for ub.assortment-matrix-goods .
     2405   define variable v-gdop-min-stock              as decimal   no-undo .
     2406   define variable v-grop-max-stock              as decimal   no-undo .
     2407   define variable v-grop-level-always-presence  as decimal   no-undo .
