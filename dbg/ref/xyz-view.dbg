     1314   PROCEDURE find-def-analysis-obj :
     1315   define input  parameter p-type     as character no-undo .
     1316   define input  parameter p-obj-type as character no-undo .
     1317   define input  parameter p-obj-code as integer   no-undo .
     1318   define output parameter p-abc-id   as integer   no-undo .
     1319   define output parameter p-db-num   as integer   no-undo .
     1320     do
     1321     on error undo, return error return-value
     1322     :
     1323     if p-type = "abc"  then do:
     1324         define buffer buf_abc-analysis-obj for ub.abc-analysis-obj  .
     1325         define buffer buf_abc-analysis     for ub.abc-analysis      .
     1326         find first buf_abc-analysis-obj no-lock where
     1327                   buf_abc-analysis-obj.obj-type = p-obj-type and
     1328                   buf_abc-analysis-obj.obj-code = p-obj-code and
     1329                   buf_abc-analysis-obj.is-def   = true use-index objdef no-error .
     1330                   if available buf_abc-analysis-obj then do:
     1331                       p-abc-id = buf_abc-analysis-obj.abc-id .
     1332                       p-db-num = buf_abc-analysis-obj.db-num .
     1333                   end.
     1334                   else do:
     1335                       p-abc-id = 0 .
     1336                       p-db-num = 0.
     1337                       return "На объекте нет анализа по умолчанию" .
     1338                   end.
     1339     end.
     1340     if p-type = "xyz"  then do:
     1341         define buffer buf_xyz-analysis-obj for ub.xyz-analysis-obj  .
     1342         define buffer buf_xyz-analysis     for ub.xyz-analysis      .
     1343         find first buf_xyz-analysis-obj no-lock where
     1344                   buf_xyz-analysis-obj.obj-type = p-obj-type and
     1345                   buf_xyz-analysis-obj.obj-code = p-obj-code and
     1346                   buf_xyz-analysis-obj.is-def   = true use-index objdef no-error .
     1347                   if available buf_xyz-analysis-obj then do:
     1348                       p-abc-id = buf_xyz-analysis-obj.xyz-id .
     1349                       p-db-num = buf_xyz-analysis-obj.db-num .
     1350                   end.
     1351                   else do:
     1352                       p-abc-id = 0 .
     1353                       p-db-num = 0 .
     1354                       return "На объекте нет анализа по умолчанию" .
     1355                   end.
     1356     end.
     1357     return .
     1358   end.
     1359   END PROCEDURE.
     1360   procedure save-def-analysis-obj :
     1361   define input  parameter p-type     as character no-undo .
     1362   define input  parameter p-db-num   as integer   no-undo .
     1363   define input  parameter p-abc-id   as integer   no-undo .
     1364   define output parameter v-log      as logical   no-undo .
     1365     do
     1366     on error undo, return error return-value
     1367     :
     1368     v-log = true .
     1369     if p-type = "abc"  then do:
     1370         define buffer buf_abc-analysis-obj for ub.abc-analysis-obj  .
     1371         define buffer buf_abc-obj          for ub.abc-analysis-obj  .
     1372         define buffer buf_abc-analysis     for ub.abc-analysis      .
     1373         for each buf_abc-obj no-lock where
     1374                  buf_abc-obj.abc-id = p-abc-id and
     1375                  buf_abc-obj.db-num = p-db-num :
     1376               define variable v-exist    as logical   no-undo init false .
     1377               define variable v-list-anal as character no-undo init ""    .
     1378               for each  buf_abc-analysis-obj no-lock where
     1379                         not (buf_abc-analysis-obj.abc-id = p-abc-id and
     1380                              buf_abc-analysis-obj.db-num = p-db-num) and
     1381                         buf_abc-analysis-obj.is-def   = true   and
     1382                         buf_abc-analysis-obj.obj-type = buf_abc-obj.obj-type and
     1383                         buf_abc-analysis-obj.obj-code = buf_abc-obj.obj-code
     1384                         :
     1385                   v-exist    = true .
     1386                   v-list-anal = string( buf_abc-analysis-obj.abc-id ) + "," .
     1387               end.
     1388               if v-exist then do:
     1389                   message "На объекте "
     1390                   buf_abc-obj.obj-type
     1391                   buf_abc-obj.obj-code
     1392                   skip
     1393                   "уже есть анализы по умолчанию , их внутренние номера :" skip
     1394                   v-list-anal                                              skip
     1395                   "Сделать по умолчанию анализ текущий " p-abc-id " ?"
     1396                   view-as alert-box question
     1397                   buttons yes-no update v-log .
     1398                   if v-log then do:
     1399                       for each  buf_abc-analysis-obj exclusive-lock where
     1400                                 buf_abc-analysis-obj.obj-type = buf_abc-obj.obj-type and
     1401                                 buf_abc-analysis-obj.obj-code = buf_abc-obj.obj-code :
     1402                         if ( buf_abc-analysis-obj.abc-id = p-abc-id and
     1403                              buf_abc-analysis-obj.db-num = p-db-num ) then
     1404                                 buf_abc-analysis-obj.is-def   = true .
     1405                         else buf_abc-analysis-obj.is-def   = false  .
     1406                       end.
     1407                   end.
     1408               end.
     1409               else do:
     1410                 for each  buf_abc-analysis-obj exclusive-lock where
     1411                           buf_abc-analysis-obj.obj-type = buf_abc-obj.obj-type and
     1412                           buf_abc-analysis-obj.obj-code = buf_abc-obj.obj-code and
     1413                           buf_abc-analysis-obj.abc-id = p-abc-id and
     1414                           buf_abc-analysis-obj.db-num = p-db-num
     1415                           :
     1416                     buf_abc-analysis-obj.is-def   = true .
     1417                 end.
     1418               end.
     1419         end.
     1420     end.
     1421     if p-type = "xyz"  then do:
     1422         define buffer buf_xyz-analysis-obj for ub.xyz-analysis-obj  .
     1423         define buffer buf_xyz-obj          for ub.xyz-analysis-obj  .
     1424         define buffer buf_xyz-analysis     for ub.xyz-analysis      .
     1425         for each buf_xyz-obj no-lock where
     1426                  buf_xyz-obj.xyz-id = p-abc-id and
     1427                  buf_xyz-obj.db-num = p-db-num :
     1428               v-exist = false .
     1429               v-list-anal = ""    .
     1430               for each  buf_xyz-analysis-obj no-lock where
     1431                         not (buf_xyz-analysis-obj.xyz-id = p-abc-id and
     1432                              buf_xyz-analysis-obj.db-num = p-db-num) and
     1433                         buf_xyz-analysis-obj.is-def   = true   and
     1434                         buf_xyz-analysis-obj.obj-type = buf_xyz-obj.obj-type and
     1435                         buf_xyz-analysis-obj.obj-code = buf_xyz-obj.obj-code
     1436                         :
     1437                   v-exist    = true .
     1438                   v-list-anal = string( buf_xyz-analysis-obj.xyz-id ) + "," .
     1439               end.
     1440               if v-exist then do:
     1441                   message "На объекте "
     1442                   buf_xyz-obj.obj-type
     1443                   buf_xyz-obj.obj-code
     1444                   skip
     1445                   "уже есть анализы по умолчанию , их внутренние номера :" skip
     1446                   v-list-anal                                              skip
     1447                   "Сделать по умолчанию анализ текущий " p-abc-id " ?"
     1448                   view-as alert-box question
     1449                   buttons yes-no update v-log .
     1450                   if v-log then do:
     1451                       for each  buf_xyz-analysis-obj exclusive-lock where
     1452                                 buf_xyz-analysis-obj.obj-type = buf_xyz-obj.obj-type and
     1453                                 buf_xyz-analysis-obj.obj-code = buf_xyz-obj.obj-code :
     1454                         if ( buf_xyz-analysis-obj.xyz-id = p-abc-id and
     1455                              buf_xyz-analysis-obj.db-num = p-db-num ) then
     1456                                 buf_xyz-analysis-obj.is-def   = true .
     1457                         else buf_xyz-analysis-obj.is-def   = false  .
     1458                       end.
     1459                   end.
     1460               end.
     1461               else do:
     1462                 for each  buf_xyz-analysis-obj exclusive-lock where
     1463                           buf_xyz-analysis-obj.obj-type = buf_xyz-obj.obj-type and
     1464                           buf_xyz-analysis-obj.obj-code = buf_xyz-obj.obj-code and
     1465                           buf_xyz-analysis-obj.xyz-id = p-abc-id and
     1466                           buf_xyz-analysis-obj.db-num = p-db-num
     1467                           :
     1468                     buf_xyz-analysis-obj.is-def   = true .
     1469                 end.
     1470               end.
     1471         end.
     1472     end.
     1473   end.
     1474   end procedure.
     1475   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1476   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
     1477   define new shared variable RepPathName        as character no-undo .
     1478   define new shared variable PrintRubl          as logical   no-undo .
     1479   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1480   define  stream PrnLibStream.
     1481   procedure prn-lib-prn-file :
     1482     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1483     define input parameter p-DIsabledoptions as integer no-undo .
     1484     define variable v-report-name as character no-undo .
     1485     define variable v-user-action as character no-undo .
     1486     define variable v-printed     as logical   no-undo .
     1487     define variable v-exist       as logical   no-undo .
     1488     do
     1489       on error undo, return error
     1490       :
     1491       run prn-lib-get-report-name  in this-procedure (
     1492         input parParentProc
     1493         ,output v-report-name
     1494         ).
     1495   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1496   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1497     (input  v-report-name
     1498     ,input  2
     1499     ,output v-exist
     1500     )  .
     1501       if NOT v-exist then
     1502       DO:
     1503         Message
     1504           "Нет заданий на печать ! "
     1505           view-as alert-box .
     1506         Return  .
     1507       End.
     1508       run gbl/prnfilen.w
     1509         (input  ""
     1510         ,input  p-DisabledOptions
     1511         ,input  string(v-report-name )
     1512         ,input  7
     1513         ,output v-user-action
     1514         ,output v-printed
     1515         ) .
     1516       if v-printed then
     1517       do:
     1518         return "YES" .
     1519       end.
     1520       else
     1521       do:
     1522         return "NO" .
     1523       end.
     1524     end.
     1525   end procedure.
     1526   procedure prn-lib-open-stream :
     1527     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1528     define input parameter p-page-size    as integer no-undo .
     1529     define input parameter p-is-stream    as logical no-undo .
     1530     define input parameter p-append       as logical no-undo .
     1531     define variable v-report-name as character no-undo .
     1532     do
     1533       on error undo, return error
     1534       :
     1535       run prn-lib-get-report-name  in this-procedure (
     1536         input parParentProc
     1537         ,output v-report-name
     1538         ).
     1539       if p-is-stream then
     1540       do:
     1541         if p-append then
     1542         do:
     1543           output stream PrnLibStream to value( v-report-name )
     1544             page-size value(p-page-size) append .
     1545         end.
     1546         if not p-append then
     1547         do:
     1548           output stream PrnLibStream to value( v-report-name )
     1549             page-size value(p-page-size) .
     1550         end.
     1551       end.
     1552       if not p-is-stream then
     1553       do:
     1554         if p-append then
     1555         do:
     1556           output to value( v-report-name )
     1557             page-size value(p-page-size) append .
     1558         end.
     1559         if not p-append then
     1560         do:
     1561           output to value( v-report-name )
     1562             page-size value(p-page-size) .
     1563         end.
     1564       end.
     1565     end.
     1566   end procedure.
     1567   procedure prn-lib-open-exp :
     1568     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1569     define input parameter p-is-stream    as logical no-undo .
     1570     define input parameter p-is-append    as logical no-undo .
     1571     define output parameter p-ReportFileName as char init "report" no-undo.
     1572     define output parameter p-process as logical no-undo .
     1573     define variable glog as logical no-undo .
     1574     do
     1575       on error undo, return error
     1576       :
     1577       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1578         TITLE      "Укажите путь"
     1579         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1580         ASK-OVERWRITE
     1581         CREATE-TEST-FILE
     1582         SAVE-AS
     1583         USE-FILENAME
     1584         DEFAULT-EXTENSION "txt"
     1585         UPDATE glog
     1586         .
     1587       if not glog then  return.
     1588       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1589       if p-is-stream then
     1590       do:
     1591         if p-is-append then
     1592         do:
     1593           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1594         end.
     1595         else
     1596         do:
     1597           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1598         end.
     1599       end.
     1600       else
     1601       do:
     1602         if p-is-append then
     1603         do:
     1604           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1605         end.
     1606         else
     1607         do:
     1608           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1609         end.
     1610       end.
     1611       p-process = yes.
     1612     end.
     1613   end procedure.
     1614   procedure prn-lib-get-report-name :
     1615     define input parameter parParentProc  as widget-handle no-undo.
     1616     define output parameter p-report-name as character no-undo .
     1617     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1618   end procedure.
     1619   procedure prn-lib-reportviewer-report-name :
     1620     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1621     define input parameter p-report-name-html as character no-undo .
     1622     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1623   end procedure.
     1624   procedure prn-lib-reportviewer :
     1625     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1626     define input parameter p-report-name-html as character no-undo .
     1627     define input parameter p-param        as character no-undo .
     1628     define variable v-excel           as character no-undo init 'TRUE' .
     1629     define variable v-value-character as character no-undo .
     1630     define variable v-value-integer   as character no-undo .
     1631     define variable v-value-date      as date      no-undo .
     1632     define variable v-value-decimal   as decimal   no-undo .
     1633     define variable rep-excel         as logical   no-undo .
     1634     define variable excel-string      as character no-undo .
     1635     define variable v-param-type      as character no-undo .
     1636     define variable v-tth             as handle    no-undo .
     1637     run adm/shattri.p (
     1638       input "get":U
     1639       ,input  ""
     1640       ,input  0
     1641       ,input  'report-glob':U
     1642       ,input  'rep-excel':U
     1643       ,output v-value-character
     1644       ,output v-value-date
     1645       ,output v-value-decimal
     1646       ,output v-value-integer
     1647       ,output rep-excel
     1648       ,output v-param-type
     1649       ,INPUT-OUTPUT table-handle v-tth
     1650       )  .
     1651     if rep-excel then v-excel = "TRUE" .
     1652     else v-excel = "FALSE" .
     1653     if p-param eq ""
     1654     then
     1655        p-param = "EXCEL:" + v-excel.
     1656     else
     1657        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1658     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1659   end procedure.
     1660   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1661   function func-get-name-from-ext-type   returns char
     1662     ( p-ext-type as character   ,
     1663       p-caps     as logical ).
     1664   define variable v-ext-name as character no-undo .
     1665   run get-name-from-ext-type in this-procedure (
     1666       input p-ext-type  ,
     1667       input p-caps  ,
     1668       output v-ext-name )
     1669       no-error .
     1670       if error-status :error then do:
     1671          assign
     1672            v-ext-name = p-ext-type
     1673          .
     1674       end.
     1675    return (v-ext-name) .
     1676   end.
     1677   procedure get-name-from-ext-type :
     1678    do
     1679    on error undo, return error return-value
     1680    :
     1681   define input  parameter p-ext-type as character no-undo .
     1682   define input  parameter p-caps     as logical no-undo   .
     1683   define output parameter p-ext-name as character no-undo .
     1684   define variable v-num as integer no-undo .
     1685     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
     1686       message
     1687         vss-include-info11 skip
     1688         "Неправильно задано значение входящего параметра! "
     1689         "Нет такого типа документов " p-ext-type
     1690         view-as alert-box error .
     1691         undo, return error .
     1692     end.
     1693     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
     1694     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
     1695     if p-caps  = true then do :
     1696        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
     1697     end .
     1698     end.
     1699   end procedure.
     1700   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1701   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1702   procedure fltopend_fltopend :
     1703   define input parameter p-parent-handle as handle no-undo .
     1704   define input parameter p-qh as handle no-undo .
     1705   define input parameter p-flt-open-open-query  as character no-undo .
     1706   define input parameter p-where-cond as character no-undo .
     1707   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1708   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1709   define input parameter p-indexed-reposition as character no-undo .
     1710     do
     1711     on error undo, return error
     1712     :
     1713   define variable v-prepare-string as character no-undo .
     1714   define variable glog as logical no-undo .
     1715   assign
     1716   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1717                      p-where-cond + chr(32)  +
     1718                      p-use-indFIRST-query-tail + chr(32) +
     1719                      p-use-ind-sort-clmn-by + chr(32) +
     1720                      p-indexed-reposition
     1721   .
     1722   assign
     1723   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1724   if not glog
     1725   or error-status:error then do:
     1726     message error-status:get-message(1) view-as alert-box .
     1727     undo, return error .
     1728   end.
     1729   assign
     1730   glog = p-qh:query-open no-error .
     1731   if not glog
     1732   or error-status:error then do:
     1733     message error-status:get-message(1) view-as alert-box .
     1734     undo, return error .
     1735   end.
     1736     end.
     1737   end procedure.
     1738   procedure fltopend_fltfindd :
     1739   define input parameter p-parent-handle as handle no-undo .
     1740   define input parameter p-qh as handle no-undo .
     1741   define input parameter p-rowid as rowid no-undo .
     1742   define input parameter p-next as logical no-undo .
     1743   define input parameter p-lock as integer no-undo .
     1744   define input parameter p-bh as handle no-undo .
     1745   define input parameter p-where-cond as character no-undo .
     1746   define input parameter p-use-index-phrase as character no-undo .
     1747   define variable glog as logical no-undo .
     1748   define variable v-qh as handle no-undo .
     1749   define variable v-bh as handle no-undo .
     1750   define variable v-recid as recid no-undo .
     1751   define variable v-prepare-string as character no-undo .
     1752   do
     1753   on error undo, return error
     1754   on stop undo, return error
     1755   :
     1756     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1757     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1758     create query v-qh.
     1759     v-qh:set-buffers(v-bh).
     1760     v-prepare-string = substitute("for each &1 &2 &3"
     1761                                     ,v-bh:name
     1762                                     ,p-where-cond
     1763                                     ,p-use-index-phrase).
     1764     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1765     if not glog then do:
     1766       delete object v-qh.
     1767       delete object v-bh.
     1768       undo, return error .
     1769     end.
     1770     glog = v-qh:query-open no-error .
     1771     if not glog then do:
     1772       delete object v-qh.
     1773       delete object v-bh.
     1774       undo, return error .
     1775     end.
     1776     if p-next then do:
     1777       v-qh:reposition-to-rowid(p-rowid) no-error .
     1778       glog = v-qh:get-next( p-lock) no-error .
     1779       glog = v-qh:get-next( p-lock) no-error .
     1780       if not glog or v-qh:query-off-end = yes then do:
     1781         glog = v-qh:get-first( p-lock) no-error .
     1782       end.
     1783     end.
     1784     else do:
     1785       glog = v-qh:get-first( p-lock) no-error .
     1786     end.
     1787     v-recid = v-bh:recid no-error .
     1788     delete object v-qh.
     1789     delete object v-bh.
     1790     return string(v-recid) .
     1791   end.
     1792   end procedure.
     1793   procedure fltopend_fltfindq :
     1794   define input parameter p-parent-handle as handle no-undo .
     1795   define input parameter p-qh as handle no-undo .
     1796   define input parameter p-next as logical no-undo .
     1797   define input parameter p-lock as integer no-undo .
     1798   define input parameter p-flt-open-open-query  as character no-undo .
     1799   define input parameter p-where-cond as character no-undo .
     1800   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1801   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1802   define input parameter p-indexed-reposition as character no-undo .
     1803   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1804   define variable glog as logical no-undo .
     1805   define variable v-qh as handle no-undo .
     1806   define variable v-bh as handle no-undo extent 18.
     1807   define variable v-rowid as rowid no-undo extent 18.
     1808   define variable v-ii as integer no-undo .
     1809   define variable v-prepare-string as character no-undo .
     1810   do
     1811   on error undo, return error
     1812   on stop undo, return error
     1813   :
     1814     create query v-qh.
     1815     do v-ii = 1 to p-qh:num-buffers:
     1816       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1817       assign
     1818       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1819       no-error.
     1820       v-qh:add-buffer(v-bh[v-ii]).
     1821     end.
     1822     assign
     1823     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1824                       p-where-cond + chr(32)  +
     1825                       p-use-indFIRST-query-tail + chr(32) +
     1826                       p-use-ind-sort-clmn-by + chr(32) +
     1827                       p-indexed-reposition
     1828     .
     1829     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1830     if not glog then do:
     1831       delete object v-qh.
     1832       do v-ii = 1 to p-qh:num-buffers:
     1833         delete object v-bh[v-ii].
     1834       end.
     1835       undo, return error .
     1836     end.
     1837     glog = v-qh:query-open no-error .
     1838     if not glog then do:
     1839       delete object v-qh.
     1840       do v-ii = 1 to p-qh:num-buffers:
     1841         delete object v-bh[v-ii].
     1842       end.
     1843       undo, return error .
     1844     end.
     1845     if p-next then do:
     1846       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1847       glog = v-qh:get-next( p-lock) no-error .
     1848       glog = v-qh:get-next( p-lock) no-error .
     1849       if not glog or v-qh:query-off-end = yes then do:
     1850         glog = v-qh:get-first( p-lock) no-error .
     1851       end.
     1852     end.
     1853     else do:
     1854       glog = v-qh:get-first( p-lock) no-error .
     1855     end.
     1856     do v-ii = 1 to p-qh:num-buffers:
     1857       assign
     1858       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1859       no-error.
     1860     end.
     1861     delete object v-qh.
     1862     do v-ii = 1 to p-qh:num-buffers:
     1863       delete object v-bh[v-ii].
     1864     end.
     1865   end.
     1866   end procedure.
     1867   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1868   FUNCTION mark-string RETURNS CHARACTER
     1869     ( input p-recid as recid, input mark-list as character  ) :
     1870     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     1871   END FUNCTION.
