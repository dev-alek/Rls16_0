      801   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      802   function func-get-name-from-ext-type   returns char
      803     ( p-ext-type as character   ,
      804       p-caps     as logical ).
      805   define variable v-ext-name as character no-undo .
      806   run get-name-from-ext-type in this-procedure (
      807       input p-ext-type  ,
      808       input p-caps  ,
      809       output v-ext-name )
      810       no-error .
      811       if error-status :error then do:
      812          assign
      813            v-ext-name = p-ext-type
      814          .
      815       end.
      816    return (v-ext-name) .
      817   end.
      818   procedure get-name-from-ext-type :
      819    do
      820    on error undo, return error return-value
      821    :
      822   define input  parameter p-ext-type as character no-undo .
      823   define input  parameter p-caps     as logical no-undo   .
      824   define output parameter p-ext-name as character no-undo .
      825   define variable v-num as integer no-undo .
      826     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
      827       message
      828         vss-include-info8 skip
      829         "Неправильно задано значение входящего параметра! "
      830         "Нет такого типа документов " p-ext-type
      831         view-as alert-box error .
      832         undo, return error .
      833     end.
      834     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
      835     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
      836     if p-caps  = true then do :
      837        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
      838     end .
      839     end.
      840   end procedure.
      841   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      842   define temp-table temp-index_name-value no-undo
      843   field name-key  as character
      844   field value-key as character
      845   index pi name-key
      846   .
      847   define temp-table temp-sub-index_name no-undo
      848   field name-key  as character
      849   field nn as integer
      850   index pi nn
      851   .
      852   procedure def-hash :
      853     do
      854     on error undo, return error return-value
      855     :
      856     define input  parameter p-full-string as character no-undo .
      857     define output parameter p-possb-keep-string as logical   no-undo .
      858     define output parameter p-string            as character no-undo .
      859     define output parameter p-hash-string       as character no-undo .
      860       p-full-string = trim( p-full-string ) .
      861       if length (p-full-string ) > 150 then do:
      862       assign
      863         p-possb-keep-string =  false
      864         p-string            =  substring(p-full-string,1,150)
      865         p-hash-string       =  encode(p-full-string)
      866       .
      867       end.
      868       else do:
      869       assign
      870         p-possb-keep-string =  true
      871         p-string            =  p-full-string
      872         p-hash-string       =  encode(p-full-string)
      873       .
      874       end.
      875     end.
      876   end procedure.
      877   procedure find-from-hash :
      878     do
      879     on error undo, return error return-value
      880     :
      881   define input  parameter  p-full-string            as character no-undo .
      882   define input  parameter  p-table-name             as character no-undo .
      883   define input  parameter  p-field-possb-keep-name  as character no-undo .
      884   define input  parameter  p-field-string-name      as character no-undo .
      885   define input  parameter  p-field-hash-string-name as character no-undo .
      886   define input  parameter  p-sub-table-name         as character no-undo .
      887   define output parameter  p-recid                  as recid     no-undo .
      888   define variable v-possb-keep-string as logical   no-undo .
      889   define variable v-string            as character no-undo .
      890   define variable v-hash-string       as character no-undo .
      891   define variable v-query-prepare     as character no-undo .
      892   define variable i  as integer no-undo .
      893   define variable qh as widget-handle no-undo .
      894   define variable bh as widget-handle no-undo .
      895   define variable p-rez as logical   no-undo .
      896   run def-hash in this-procedure (input  p-full-string ,
      897                 output v-possb-keep-string ,
      898                 output v-string            ,
      899                 output v-hash-string
      900                 ).
      901   p-recid = ? .
      902   create buffer bh for table p-table-name.
      903   create query qh.
      904      v-query-prepare =
      905       "for each " + p-table-name + " no-lock where "
      906       + p-field-possb-keep-name   + " = "  + string(v-possb-keep-string) + " and "
      907       + p-field-string-name       + " = '" + v-string            + "' and "
      908       + p-field-hash-string-name  + " = '" + v-hash-string       + "'"
      909       .
      910   if v-possb-keep-string = true then do:
      911       qh:set-buffers(bh).
      912       qh:query-prepare(v-query-prepare).
      913       qh:query-open.
      914       qh:get-first.
      915       p-recid = bh:recid.
      916   end.
      917   else do:
      918   message false "анализ hash" .
      919     qh:set-buffers(bh).
      920     qh:query-prepare(v-query-prepare).
      921     qh:query-open.
      922     qh:get-first.
      923     p-recid = bh:recid.
      924     repeat :
      925       qh:get-next.
      926       if bh:available then do:
      927          qh:get-first.
      928          run ver-sub-table in this-procedure (
      929              input  p-full-string ,
      930              input  p-table-name ,
      931              input  p-sub-table-name ,
      932              input  bh:recid  ,
      933              output p-rez
      934              ).
      935          if p-rez = true  then do:
      936             p-recid = bh:recid .
      937             leave.
      938          end.
      939          else do:
      940            next.
      941          end.
      942       end.
      943       leave.
      944     end.
      945   end.
      946   delete widget bh.
      947   delete widget qh.
      948     end.
      949   end procedure.
      950   procedure ver-sub-table :
      951     do
      952     on error undo, return error return-value
      953     :
      954   define input  parameter p-full-string as character no-undo .
      955   define input  parameter p-name-table as character no-undo .
      956   define input  parameter p-sub-name-table as character no-undo .
      957   define input  parameter p-recid as recid no-undo .
      958   define output parameter p-ok as logical   no-undo .
      959   define variable v-query-prepare     as character no-undo .
      960   define variable i  as integer no-undo .
      961   define variable qh as widget-handle no-undo .
      962   define variable bh as widget-handle no-undo .
      963   define variable p-rez as logical   no-undo .
      964   for each temp-index_name-value : delete temp-index_name-value . end.
      965   for each temp-sub-index_name : delete temp-sub-index_name . end.
      966       create buffer bh for table p-name-table.
      967       create query qh.
      968       v-query-prepare = "for each " + p-name-table + " no-lock where recid(" + p-name-table + ") = " + string ( p-recid ) .
      969       qh:set-buffers(bh).
      970       qh:query-prepare(v-query-prepare).
      971       qh:query-open.
      972       qh:get-first.
      973       p-recid = bh:recid.
      974   define variable v-inf-ind AS CHAR NO-UNDO.
      975   define variable v-name-pi as character no-undo .
      976   define variable v-num-fl-inkey as integer   no-undo .
      977   define variable v-num-fl       as integer   no-undo .
      978   define variable j as integer   no-undo .
      979   v-name-pi = bh:PRIMARY .
      980   v-inf-ind = "1".
      981   i = 0.
      982   DO while ( v-inf-ind <> ? )
      983       on error undo, return error:
      984       i = i + 1 .
      985       v-inf-ind = bh:INDEX-INFORMATION(i) .
      986       if v-inf-ind = ? then leave.
      987       if entry( 1 , v-inf-ind ) = v-name-pi then do:
      988          v-num-fl-inkey = ( num-entries(v-inf-ind) - 4 ) / 2 .
      989          v-num-fl       = ( num-entries(v-inf-ind) - 4 )     .
      990         if v-num-fl-inkey >= 1 then do:
      991             do j = 5 to v-num-fl  by 2 :
      992                 create temp-index_name-value .
      993                 assign
      994                   temp-index_name-value.name-key  = entry( j , v-inf-ind )
      995                   temp-index_name-value.value-key = bh:BUFFER-FIELD(entry( j , v-inf-ind )):BUFFER-VALUE
      996                 .
      997             end.
      998          end.
      999       end.
     1000   END.
     1001   define variable qh-sub as widget-handle no-undo .
     1002   define variable bh-sub as widget-handle no-undo .
     1003       create buffer bh-sub for table p-sub-name-table.
     1004       create query qh-sub.
     1005   define variable k as integer   no-undo init 0 .
     1006       v-query-prepare = "for each " + p-sub-name-table + " no-lock where " .
     1007       for each temp-index_name-value :
     1008           v-query-prepare = v-query-prepare  + p-sub-name-table + "." + temp-index_name-value.name-key +
     1009                         " = " + temp-index_name-value.value-key + " and " .
     1010       end.
     1011       v-query-prepare = v-query-prepare + " true = true " .
     1012       qh-sub:set-buffers(bh-sub).
     1013       qh-sub:query-prepare(v-query-prepare).
     1014       qh-sub:query-open.
     1015         v-name-pi = bh-sub:PRIMARY .
     1016         v-inf-ind = "1".
     1017         i = 0.
     1018         DO while ( v-inf-ind <> ? )
     1019             on error undo, return error:
     1020             i = i + 1 .
     1021             v-inf-ind = bh-sub:INDEX-INFORMATION(i) .
     1022             if v-inf-ind = ? then leave.
     1023             if entry( 1 , v-inf-ind ) = v-name-pi then do:
     1024               v-num-fl-inkey = ( num-entries(v-inf-ind) - 4 ) / 2 .
     1025               v-num-fl       = ( num-entries(v-inf-ind) - 4 )     .
     1026               if v-num-fl-inkey >= 1 then do:
     1027                   do j = 5 to v-num-fl  by 2 :
     1028                       if not can-find (first temp-index_name-value  where temp-index_name-value.name-key =  entry( j , v-inf-ind )) then do:
     1029                           create temp-sub-index_name .
     1030                           assign
     1031                             temp-sub-index_name.name-key  = entry( j , v-inf-ind )
     1032                             temp-sub-index_name.nn  = j
     1033                           .
     1034                       end.
     1035                   end.
     1036               end.
     1037             end.
     1038         END.
     1039         define variable v-qw as character no-undo .
     1040         v-qw = "".
     1041         qh-sub:GET-first.
     1042         DO WHILE (bh-sub:AVAILABLE):
     1043           for each temp-sub-index_name :
     1044               v-qw = v-qw + string(bh-sub:BUFFER-FIELD(temp-sub-index_name.name-key):BUFFER-VALUE) .
     1045           end.
     1046           v-qw = v-qw + ",".
     1047           qh-sub:GET-NEXT.
     1048         END.
     1049         p-ok = false .
     1050         if trim(p-full-string, ",")  =  trim (v-qw, ",") then p-ok = true  .
     1051       delete widget bh-sub.
     1052       delete widget qh-sub.
     1053       delete widget bh.
     1054       delete widget qh.
     1055     end.
     1056   end procedure.
     1057   PROCEDURE update-rang-def :
     1058   define input  parameter p-recid as recid     no-undo .
     1059   define input  parameter p-list-obj as character no-undo .
     1060   define input  parameter p-a as decimal   no-undo .
     1061   define input  parameter p-b as decimal   no-undo .
     1062   define input  parameter p-c as decimal   no-undo .
     1063   define input  parameter p-d as decimal   no-undo .
     1064   define input  parameter p-e as decimal   no-undo .
     1065   define input  parameter p-f as decimal   no-undo .
     1066   define variable v-date as date no-undo .
     1067   define variable v-time as integer no-undo .
     1068   define variable v-exist as logical   no-undo .
     1069   define variable p-id as integer   no-undo .
     1070   define variable p-db as integer   no-undo .
     1071   define variable  p-possb-keep-string-obj as logical   no-undo .
     1072   define variable  p-string-obj            as character no-undo .
     1073   define variable  p-hash-string-obj       as character no-undo .
     1074   define buffer buf_rang-abc-def     for ub.rang-abc-def.
     1075   define buffer buf_rang-abc-def-obj for ub.rang-abc-def-obj.
