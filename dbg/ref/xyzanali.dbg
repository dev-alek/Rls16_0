      417       end.
      418       else
      419       do:
      420         return "NO" .
      421       end.
      422     end.
      423   end procedure.
      424   procedure prn-lib-open-stream :
      425     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      426     define input parameter p-page-size    as integer no-undo .
      427     define input parameter p-is-stream    as logical no-undo .
      428     define input parameter p-append       as logical no-undo .
      429     define variable v-report-name as character no-undo .
      430     do
      431       on error undo, return error
      432       :
      433       run prn-lib-get-report-name  in this-procedure (
      434         input parParentProc
      435         ,output v-report-name
      436         ).
      437       if p-is-stream then
      438       do:
      439         if p-append then
      440         do:
      441           output stream PrnLibStream to value( v-report-name )
      442             page-size value(p-page-size) append .
      443         end.
      444         if not p-append then
      445         do:
      446           output stream PrnLibStream to value( v-report-name )
      447             page-size value(p-page-size) .
      448         end.
      449       end.
      450       if not p-is-stream then
      451       do:
      452         if p-append then
      453         do:
      454           output to value( v-report-name )
      455             page-size value(p-page-size) append .
      456         end.
      457         if not p-append then
      458         do:
      459           output to value( v-report-name )
      460             page-size value(p-page-size) .
      461         end.
      462       end.
      463     end.
      464   end procedure.
      465   procedure prn-lib-open-exp :
      466     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      467     define input parameter p-is-stream    as logical no-undo .
      468     define input parameter p-is-append    as logical no-undo .
      469     define output parameter p-ReportFileName as char init "report" no-undo.
      470     define output parameter p-process as logical no-undo .
      471     define variable glog as logical no-undo .
      472     do
      473       on error undo, return error
      474       :
      475       SYSTEM-DIALOG GET-FILE p-ReportFileName
      476         TITLE      "Укажите путь"
      477         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      478         ASK-OVERWRITE
      479         CREATE-TEST-FILE
      480         SAVE-AS
      481         USE-FILENAME
      482         DEFAULT-EXTENSION "txt"
      483         UPDATE glog
      484         .
      485       if not glog then  return.
      486       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      487       if p-is-stream then
      488       do:
      489         if p-is-append then
      490         do:
      491           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      492         end.
      493         else
      494         do:
      495           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      496         end.
      497       end.
      498       else
      499       do:
      500         if p-is-append then
      501         do:
      502           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      503         end.
      504         else
      505         do:
      506           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      507         end.
      508       end.
      509       p-process = yes.
      510     end.
      511   end procedure.
      512   procedure prn-lib-get-report-name :
      513     define input parameter parParentProc  as widget-handle no-undo.
      514     define output parameter p-report-name as character no-undo .
      515     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      516   end procedure.
      517   procedure prn-lib-reportviewer-report-name :
      518     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      519     define input parameter p-report-name-html as character no-undo .
      520     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      521   end procedure.
      522   procedure prn-lib-reportviewer :
      523     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      524     define input parameter p-report-name-html as character no-undo .
      525     define input parameter p-param        as character no-undo .
      526     define variable v-excel           as character no-undo init 'TRUE' .
      527     define variable v-value-character as character no-undo .
      528     define variable v-value-integer   as character no-undo .
      529     define variable v-value-date      as date      no-undo .
      530     define variable v-value-decimal   as decimal   no-undo .
      531     define variable rep-excel         as logical   no-undo .
      532     define variable excel-string      as character no-undo .
      533     define variable v-param-type      as character no-undo .
      534     define variable v-tth             as handle    no-undo .
      535     run adm/shattri.p (
      536       input "get":U
      537       ,input  ""
      538       ,input  0
      539       ,input  'report-glob':U
      540       ,input  'rep-excel':U
      541       ,output v-value-character
      542       ,output v-value-date
      543       ,output v-value-decimal
      544       ,output v-value-integer
      545       ,output rep-excel
      546       ,output v-param-type
      547       ,INPUT-OUTPUT table-handle v-tth
      548       )  .
      549     if rep-excel then v-excel = "TRUE" .
      550     else v-excel = "FALSE" .
      551     if p-param eq ""
      552     then
      553        p-param = "EXCEL:" + v-excel.
      554     else
      555        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      556     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      557   end procedure.
      558   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      559   procedure cur-time :
      560      define output parameter p-today as date      no-undo .
      561      define output parameter p-time  as integer   no-undo .
      562     do
      563     on error undo, return error
      564     :
      565       define variable v-date1 as date      no-undo .
      566       define variable v-date2 as date      no-undo .
      567       define variable v-time  as integer   no-undo .
      568       assign
      569         v-date1 = today
      570         v-time  = time
      571         v-date2 = today
      572       .
      573       if v-date1 <> v-date2
      574       then do:
      575         assign
      576           v-date1 = today
      577           v-time  = v-time
      578         .
      579       end.
      580       assign
      581         p-today = v-date1
      582         p-time  = v-time
      583       .
      584     end.
      585   end.
      586   function cur-time-date returns character
      587   :
      588     return string(today, '99/99/9999':U) .
      589   end.
      590   function cur-time-mjd returns decimal
      591   :
      592     define variable v-date as date      no-undo .
      593     define variable v-time as integer   no-undo .
      594     run cur-time in this-procedure
      595       (output v-date
      596       ,output v-time
      597       ) .
      598     return integer(v-date) - 2400002 + (v-time / 86400) .
      599   end.
      600   function cur-time-get-ending-index returns integer
      601   (input p-number as integer
      602   )
      603   :
      604     if p-number < 0
      605     or p-number = ?
      606     then do:
      607       return 1 .
      608     end.
      609     define variable v-rest as integer   no-undo .
      610     assign
      611       p-number = p-number modulo 100
      612     .
      613     if p-number < 20
      614     then do:
      615       assign
      616         v-rest = p-number
      617       .
      618     end.
      619     else do:
      620       assign
      621         v-rest = p-number modulo 10
      622       .
      623     end.
      624     case v-rest :
      625       when 1
      626       then do:
      627         return 2 .
      628       end.
      629       when 2 or
      630       when 3 or
      631       when 4
      632       then do:
      633         return 3 .
      634       end.
      635       otherwise do:
      636         return 1 .
      637       end.
      638     end case .
      639   end.
      640   procedure cur-time-mjd-to-date :
      641      define input  parameter i-mjd-diff as decimal no-undo.
      642      define output parameter o-Date     as date    no-undo.
      643      define output parameter o-Time     as integer no-undo.
      644      define variable v-day-number as integer   no-undo .
      645      if    i-mjd-diff < 0
      646         or i-mjd-diff = ?
      647      then do:
      648         return "?" .
      649      end.
      650      assign
      651         v-day-number = truncate(i-mjd-diff,0).
      652         o-Date = date(v-day-number + 2400002).
      653         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      654     .
      655   end.
      656   function cur-time-mjd-to-string returns character
      657   (input p-mjd-diff as decimal
      658   )
      659   :
      660     define variable v-day-number as integer   no-undo .
      661     define variable v-seconds    as integer   no-undo .
      662     define variable v-hour       as integer   no-undo .
      663     define variable v-min        as integer   no-undo .
      664     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      665     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      666     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      667     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      668     if p-mjd-diff < 0
      669     or p-mjd-diff = ?
      670     then do:
      671       return "?" .
      672     end.
      673     assign
      674       v-day-number = integer(truncate(p-mjd-diff,0))
      675       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      676     .
      677     if v-seconds > 86400
      678     then do:
      679       assign
      680         v-seconds = 86400 - 1
      681       .
      682     end.
      683     if v-seconds < 0
      684     then do:
      685       assign
      686         v-seconds = 0
      687       .
      688     end.
      689     assign
      690       v-hour = truncate(v-seconds / 3600, 0)
      691     .
      692     assign
      693       v-seconds = v-seconds modulo 3600
      694     .
      695     assign
      696       v-min = truncate(v-seconds / 60, 0)
      697     .
      698     assign
      699       v-seconds = v-seconds modulo 60
      700     .
      701     return
      702         (if v-day-number <> 0
      703           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      704           else ""
      705         )
      706       + (if v-day-number <> 0 or v-hour <> 0
      707           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      708           else ""
      709         )
      710       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      711           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      712           else ""
      713         )
      714       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      715       .
      716   end.
      717   function cur-time-string returns character
      718   :
      719     define variable v-date as date      no-undo .
      720     define variable v-time as integer   no-undo .
      721     run cur-time in this-procedure
      722       (output v-date
      723       ,output v-time
      724       ) .
      725     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      726   end.
      727   function cur-time-string-sec returns character
      728   :
      729     define variable v-date as date      no-undo .
      730     define variable v-time as integer   no-undo .
      731     run cur-time in this-procedure
      732       (output v-date
      733       ,output v-time
      734       ) .
      735     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      736   end.
      737   function cur-time-custom  returns character
      738   (input p-prefix as character
      739   ,input p-date-format as character
      740   ,input p-delimiter as character
      741   ,input p-time-format as character
      742   ,input p-suffix as character
      743   )
      744   :
      745     define variable v-date as date      no-undo .
      746     define variable v-time as integer   no-undo .
      747     run cur-time in this-procedure
      748       (output v-date
      749       ,output v-time
      750       ) .
      751     return
      752       p-prefix
      753       + string(v-date, p-date-format)
      754       + p-delimiter
      755       + string(v-time, p-time-format)
      756       + p-suffix
      757       .
      758   end.
      759   function cur-time-print  returns character
      760   :
      761     define variable v-date as date      no-undo .
      762     define variable v-time as integer   no-undo .
      763     run cur-time in this-procedure
      764       (output v-date
      765       ,output v-time
      766       ) .
      767     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      768   end.
      769   function cur-time-datetime returns datetime
      770   :
      771     define variable v-char as character no-undo .
      772     define variable v-datetime as datetime no-undo .
      773     v-char = cur-time-string().
      774     v-datetime = datetime(v-char).
      775     return  v-datetime.
      776   end.
      777   function cur-time-string-msec returns character
      778   :
      779     define variable v-date as datetime  no-undo .
      780     v-date = now.
      781     return string(v-date) .
      782   end.
      783   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      784   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
