     2502   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2503   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2504   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2505   on help of frame Dialog-Frame
     2506   do:
     2507     run gbl/app_help.p
     2508       (input this-procedure :file-name
     2509       ,input ''
     2510       ,input ?
     2511       ) no-error.
     2512     if error-status :error then do:
     2513       message
     2514         "Ошибка при вызове помощи"
     2515         error-status :get-message(1)
     2516         view-as alert-box .
     2517     end.
     2518   end.
     2519   run minbtn-set in this-procedure .
     2520   on choose of b-help in frame Dialog-Frame
     2521   do:
     2522     apply "help":u to frame Dialog-Frame .
     2523   end.
     2524   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2525   procedure minbtn-set :
     2526       do
     2527           on error undo, return error return-value
     2528           :
     2529           define variable ii              as integer       no-undo .
     2530           define variable fh              as widget-handle no-undo .
     2531           define variable hh              as widget-handle no-undo .
     2532           define variable v-h             as handle        extent 4 no-undo .
     2533           define variable v-name-button   as character     no-undo .
     2534           define variable v-help-old-x    as decimal       no-undo .
     2535           define variable v-help-old-y    as decimal       no-undo .
     2536           define variable v-help-old-size as decimal       no-undo .
     2537           define variable v-frame-width   as decimal       no-undo .
     2538           define variable jj              as integer       no-undo .
     2539           do
     2540               on error undo, return error
     2541               :
     2542               assign
     2543                   v-frame-width = frame Dialog-Frame:width - 0.3
     2544                   fh            = frame Dialog-Frame:first-child
     2545                   hh            = fh:first-child
     2546                   ii            = 1
     2547                   .
     2548               do while valid-handle(hh):
     2549                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2550                   do:
     2551                       case lc(hh:name) :
     2552                           when "b-help" then
     2553                               do:
     2554                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2555                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2556                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2557                                   hh:TOOLTIP = "Помощь" .
     2558                                   v-help-old-x = hh:column .
     2559                                   v-help-old-y = hh:row    .
     2560                                   v-help-old-size = hh:width .
     2561                                   hh:width-chars = 2.5 .
     2562                               end.
     2563                           when "b-print" then
     2564                               do:
     2565                                   hh:load-image("cmp/b-print.bmp":u) .
     2566                                   hh:TOOLTIP = "Печать" .
     2567                                   v-h[ii] = hh:handle .
     2568                                   ii = ii + 1 .
     2569                                   hh:width-chars = 3 .
     2570                               end.
     2571                           when "b-history" or
     2572                           when "b-hist" then
     2573                               do:
     2574                                   hh:load-image("cmp/b-hist.bmp":u) .
     2575                                   hh:TOOLTIP = "История" .
     2576                                   v-h[ii] = hh:handle .
     2577                                   ii = ii + 1 .
     2578                                   hh:width-chars = 3 .
     2579                               end.
     2580                           when "b-sch" then
     2581                               do:
     2582                                   hh:load-image("cmp/b-sch.bmp":u) .
     2583                                   hh:TOOLTIP = "Установка Фильтра" .
     2584                                   v-h[ii] = hh:handle .
     2585                                   ii = ii + 1 .
     2586                                   hh:width-chars = 3 .
     2587                               end.
     2588                           when "b-hist-user" then
     2589                               do:
     2590                                   hh:load-image("cmp/b-hist.bmp":u) .
     2591                                   hh:TOOLTIP = "История пользователя" .
     2592                                   ii = ii + 1 .
     2593                               end.
     2594                       end case.
     2595                   end.
     2596                   hh = hh:next-sibling.
     2597               end.
     2598               b-help:column = v-frame-width - b-help:width-chars.
     2599               jj = 0.
     2600               repeat ii = 4 to 1 by -1 :
     2601                   if valid-handle (v-h[ii] ) then
     2602                   do:
     2603                       jj  = jj + 1 .
     2604                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2605                       v-h[ii]:row    = v-help-old-y .
     2606                   end.
     2607               end.
     2608           end.
     2609       end.
     2610   end procedure.
     2611   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2612   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2613   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2614   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2615   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2616   define variable v-diasize-current-frame-height as decimal   no-undo .
     2617   define variable v-diasize-change-size          as logical   no-undo .
     2618   define variable v-diasize-resize-button        as handle    no-undo .
     2619   define variable v-diasize-wndmax               as logical   no-undo .
     2620   define variable v-diasize-wndstore             as logical   no-undo .
     2621   define variable v-diasize-proc-name            as character no-undo .
     2622   define variable v-diasize-browse-handle        as handle    no-undo .
     2623   define variable v-diasize-browse-number        as integer   no-undo .
     2624   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2625   define temp-table temp-diasize-handle no-undo
     2626     field handle-value  as handle
     2627     field save-position as decimal
     2628     index xpk is primary unique handle-value
     2629     .
     2630   define temp-table temp-browse-handle no-undo
     2631     field browse-type   as character
     2632     field browse-number as integer
     2633     field browse-handle as handle
     2634     field original-size as decimal
     2635     index xpk is primary unique browse-type browse-number
     2636     index xie browse-type browse-handle
     2637   .
     2638   procedure diasize_change-height :
     2639     define input  parameter p-change-value  as decimal   no-undo .
     2640     define input  parameter p-move-resize   as logical   no-undo .
     2641     define variable v-field-group-handle    as handle    no-undo .
     2642     define variable v-object-handle         as handle    no-undo .
     2643     define variable v-frame-height          as decimal   no-undo .
     2644     define variable v-frame-virtual-height  as decimal   no-undo .
     2645     define variable v-browse-height         as decimal   no-undo .
     2646     define variable v-window-height         as decimal   no-undo .
     2647     define variable v-window-virtual-height as decimal   no-undo .
     2648     define variable v-change-sign           as integer   no-undo .
     2649     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2650     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2651     if p-change-value > 0
     2652     then do:
     2653       if frame Dialog-Frame :height + p-change-value
     2654           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2655       then do:
     2656         assign
     2657           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2658                           - (frame Dialog-Frame :height-chars)
     2659         .
     2660         if p-change-value <= 0
     2661         then do:
     2662           run diasize_position-resize-button in this-procedure .
     2663           return .
     2664         end.
     2665       end.
     2666     end.
     2667     if p-change-value < 0
     2668     then do:
     2669       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2670       then do:
     2671         assign
     2672           p-change-value = v-diasize-orig-frame-height
     2673                          - (frame Dialog-Frame :height-chars)
     2674         .
     2675         if p-change-value >= 0
     2676         then do:
     2677           run diasize_position-resize-button in this-procedure .
     2678           return .
     2679         end.
     2680       end.
     2681     end.
     2682     if p-change-value >= 0
     2683     then do:
     2684       assign
     2685         v-change-sign = 1
     2686       .
     2687     end.
     2688     else do:
     2689       assign
     2690         v-change-sign = -1
     2691       .
     2692     end.
     2693     assign
     2694       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2695     .
     2696     if p-change-value = 0
     2697     then do:
     2698       run diasize_position-resize-button in this-procedure .
     2699       return .
     2700     end.
     2701     move_block:
     2702     do
     2703     on error undo move_block, retry move_block
     2704     :
     2705       if retry
     2706       then do:
     2707         do
     2708         on error undo move_block, leave move_block
     2709         :
     2710           if p-change-value > 0
     2711           then do:
     2712             for each buf_temp-diasize-handle
     2713             on error undo, next
     2714             :
     2715               assign
     2716                 v-object-handle = buf_temp-diasize-handle.handle-value
     2717               .
     2718               if v-object-handle <> v-diasize-resize-button
     2719               then do:
     2720                 assign
     2721                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2722                 .
     2723               end.
     2724             end.
     2725             assign
     2726               v-diasize-browse-handle :height = v-browse-height
     2727             .
     2728             for each buf_temp-browse-handle
     2729               where buf_temp-browse-handle.browse-type = 'height':u
     2730             on error undo, next
     2731             :
     2732               assign
     2733                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2734               .
     2735             end.
     2736             assign
     2737               frame Dialog-Frame :height = v-frame-height
     2738             .
     2739             if frame Dialog-Frame :scrollable = true
     2740             then do:
     2741               assign
     2742                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2743               .
     2744             end.
     2745             run diasize_position-resize-button in this-procedure .
     2746           end.
     2747           else do:
     2748             if frame Dialog-Frame :scrollable = true
     2749             then do:
     2750               assign
     2751                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2752               .
     2753             end.
     2754             assign
     2755               frame Dialog-Frame :height = v-frame-height
     2756             .
     2757             assign
     2758               v-diasize-browse-handle :height = v-browse-height
     2759             .
     2760             for each buf_temp-browse-handle
     2761               where buf_temp-browse-handle.browse-type = 'height':u
     2762             on error undo, next
     2763             :
     2764               assign
     2765                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2766               .
     2767             end.
     2768             for each buf_temp-diasize-handle
     2769             on error undo, next
     2770             :
     2771               assign
     2772                 v-object-handle = buf_temp-diasize-handle.handle-value
     2773               .
     2774               if v-object-handle <> v-diasize-resize-button
     2775               then do:
     2776                 assign
     2777                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2778                 .
     2779               end.
     2780             end.
     2781             run diasize_position-resize-button in this-procedure .
     2782           end.
     2783           assign
     2784             v-diasize-change-size = false
     2785           .
     2786           leave move_block .
     2787         end.
     2788       end.
     2789       assign
     2790         v-diasize-need-full-display = true
     2791       .
     2792       if v-diasize-change-size = false
     2793       then do:
     2794         assign
     2795           v-diasize-change-size = true
     2796         .
     2797       end.
     2798       else do:
     2799         return .
     2800       end.
     2801       assign
     2802         v-frame-height = frame Dialog-Frame :height
     2803         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2804         v-browse-height = v-diasize-browse-handle :height
     2805       .
     2806       for each buf_temp-browse-handle
     2807         where buf_temp-browse-handle.browse-type = 'height':u
     2808       :
     2809         assign
     2810           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2811         .
     2812       end.
     2813       for each buf_temp-diasize-handle
     2814       :
     2815         delete buf_temp-diasize-handle .
     2816       end.
     2817       assign
     2818         v-field-group-handle = frame Dialog-Frame :first-child
     2819       .
     2820       do while valid-handle(v-field-group-handle)
     2821       :
     2822         assign
     2823           v-object-handle = v-field-group-handle :first-child
     2824         .
     2825         do while valid-handle(v-object-handle)
     2826         :
     2827           if  v-object-handle <> v-diasize-browse-handle :handle
     2828           and can-query(v-object-handle, "row")
     2829           and can-query(v-object-handle, "height")
     2830           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2831           then do:
     2832             find first buf_temp-browse-handle
     2833               where buf_temp-browse-handle.browse-type   = 'height':u
     2834                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2835               no-error .
     2836             if available buf_temp-browse-handle
     2837             then do:
     2838             end.
     2839             else do:
     2840               create buf_temp-diasize-handle .
     2841               assign
     2842                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2843                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2844               .
     2845             end.
     2846           end.
     2847           assign
     2848             v-object-handle = v-object-handle :next-sibling
     2849           .
     2850         end.
     2851         assign
     2852           v-field-group-handle = v-field-group-handle :next-sibling
     2853         .
     2854       end.
     2855       do with frame Dialog-Frame
     2856       :
     2857         hide v-diasize-resize-button .
     2858         assign
     2859           v-diasize-resize-button :row    = 1
     2860           v-diasize-resize-button :column = 1
     2861         .
     2862       end.
     2863       if p-change-value > 0
     2864       then do:
     2865         if frame Dialog-Frame :scrollable = true
     2866         then do:
     2867           assign
     2868             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2869             no-error .
     2870           if error-status :error
     2871           or error-status :get-message(1) <> ""
     2872           then do:
     2873             undo move_block, retry move_block .
     2874           end.
     2875         end.
     2876         assign
     2877           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2878           no-error .
     2879         if error-status :error
     2880         or error-status :get-message(1) <> ""
     2881         then do:
     2882           undo move_block, retry move_block .
     2883         end.
     2884         assign
     2885           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2886           no-error .
     2887         if error-status :error
     2888         or error-status :get-message(1) <> ""
     2889         then do:
     2890           undo move_block, retry move_block .
     2891         end.
     2892         for each buf_temp-browse-handle
     2893           where buf_temp-browse-handle.browse-type = 'height':u
     2894         on error undo move_block, retry move_block
     2895         :
     2896           assign
     2897             buf_temp-browse-handle.browse-handle :height
     2898               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2899             no-error .
     2900           if error-status :error
     2901           or error-status :get-message(1) <> ""
     2902           then do:
     2903             undo move_block, retry move_block .
     2904           end.
     2905         end.
     2906         for each buf_temp-diasize-handle
     2907         on error undo move_block, retry move_block
     2908         :
     2909           assign
     2910             v-object-handle = buf_temp-diasize-handle.handle-value
     2911           .
     2912           if v-object-handle <> v-diasize-resize-button
     2913           then do:
     2914             assign
     2915               v-object-handle :row = v-object-handle :row + p-change-value
     2916               no-error .
     2917             if error-status :error
     2918             or error-status :get-message(1) <> ""
     2919             then do:
     2920               undo move_block, retry move_block .
     2921             end.
     2922           end.
     2923         end.
     2924       end.
     2925       else do:
     2926         for each buf_temp-diasize-handle
     2927         on error undo move_block, retry move_block
     2928         :
     2929           assign
     2930             v-object-handle = buf_temp-diasize-handle.handle-value
     2931           .
     2932           if v-object-handle <> v-diasize-resize-button
     2933           then do:
     2934             assign
     2935               v-object-handle :row = v-object-handle :row + p-change-value
     2936               no-error .
     2937             if error-status :error
     2938             or error-status :get-message(1) <> ""
     2939             then do:
     2940               undo move_block, retry move_block .
     2941             end.
     2942           end.
     2943         end.
     2944         assign
     2945           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2946           no-error .
     2947         if error-status :error
     2948         or error-status :get-message(1) <> ""
     2949         then do:
     2950           undo move_block, retry move_block .
     2951         end.
     2952         for each buf_temp-browse-handle
     2953           where buf_temp-browse-handle.browse-type = 'height':u
     2954         on error undo move_block, retry move_block
     2955         :
     2956           assign
     2957             buf_temp-browse-handle.browse-handle :height
     2958               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2959             no-error .
     2960           if error-status :error
     2961           or error-status :get-message(1) <> ""
     2962           then do:
     2963             undo move_block, retry move_block .
     2964           end.
     2965         end.
     2966         assign
     2967           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2968           no-error .
     2969         if error-status :error
     2970         or error-status :get-message(1) <> ""
     2971         then do:
     2972           undo move_block, retry move_block .
     2973         end.
     2974         if frame Dialog-Frame :scrollable = true
     2975         then do:
     2976           assign
     2977             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2978             no-error .
     2979           if error-status :error
     2980           or error-status :get-message(1) <> ""
     2981           then do:
     2982             undo move_block, retry move_block .
     2983           end.
     2984         end.
     2985       end.
     2986       if p-move-resize = true
     2987       then do:
     2988         run diasize_position-resize-button in this-procedure .
     2989       end.
     2990       if v-diasize-wndstore = true
     2991       then do:
     2992         if connected("ub") = true
     2993         then do:
     2994           define variable v-cntxt-db-num        as integer   no-undo .
     2995           define variable v-cntxt-userid        as character no-undo .
     2996           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2997                                             , OUTPUT v-cntxt-userid
     2998                                             ) .
     2999           run gbl/wndsizew.p
     3000             (input  v-cntxt-db-num
     3001             ,input  v-cntxt-userid
     3002             ,input  v-diasize-proc-name
     3003             ,input  'height':u
     3004             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3005             ) .
     3006         end.
     3007       end.
     3008     end.
     3009     assign
     3010       v-diasize-change-size = false
     3011     .
     3012   end procedure.
     3013   procedure diasize_set-height :
     3014     define input  parameter p-new-height  as decimal   no-undo .
     3015     define input  parameter p-move-resize as logical   no-undo .
     3016     do
     3017     on error undo, return error return-value
     3018     :
     3019       run diasize_change-height in this-procedure
     3020         (input  (p-new-height - frame Dialog-Frame :height)
     3021         ,input  p-move-resize
     3022         ) .
     3023     end.
     3024   end procedure.
     3025   procedure diasize_change-width :
     3026     define input  parameter p-change-value as decimal   no-undo .
     3027     define input  parameter p-move-resize  as logical   no-undo .
     3028     define variable v-field-group-handle   as handle    no-undo .
     3029     define variable v-object-handle        as handle    no-undo .
     3030     define variable v-frame-width          as decimal   no-undo .
     3031     define variable v-frame-virtual-width  as decimal   no-undo .
     3032     define variable v-browse-width         as decimal   no-undo .
     3033     define variable v-window-width         as decimal   no-undo .
     3034     define variable v-window-virtual-width as decimal   no-undo .
     3035     define variable v-change-sign          as integer   no-undo .
     3036     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3037     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3038     if p-change-value > 0
     3039     then do:
     3040       if frame Dialog-Frame :width + p-change-value >
     3041           session :width-chars
     3042       then do:
     3043         assign
     3044           p-change-value = session :width-chars - frame Dialog-Frame :width
     3045         .
     3046         if p-change-value <= 0
     3047         then do:
     3048           run diasize_position-resize-button in this-procedure .
     3049           return .
     3050         end.
     3051       end.
     3052     end.
     3053     if p-change-value < 0
     3054     then do:
     3055       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3056       then do:
     3057         assign
     3058           p-change-value = v-diasize-orig-frame-width
     3059                          - frame Dialog-Frame :width
     3060         .
     3061         if p-change-value >= 0
     3062         then do:
     3063           run diasize_position-resize-button in this-procedure .
     3064           return .
     3065         end.
     3066       end.
     3067     end.
     3068     if p-change-value >= 0
     3069     then do:
     3070       assign
     3071         v-change-sign = 1
     3072       .
     3073     end.
     3074     else do:
     3075       assign
     3076         v-change-sign = -1
     3077       .
     3078     end.
     3079     assign
     3080       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3081     .
     3082     if p-change-value = 0
     3083     then do:
     3084       run diasize_position-resize-button in this-procedure .
     3085       return .
     3086     end.
     3087     move_block:
     3088     do
     3089     on error undo move_block, leave move_block
     3090     :
     3091       if retry
     3092       then do:
     3093         do
     3094         on error undo move_block, leave move_block
     3095         :
     3096           if p-change-value > 0
     3097           then do:
     3098             for each buf_temp-diasize-handle
     3099             on error undo, next
     3100             :
     3101               assign
     3102                 v-object-handle = buf_temp-diasize-handle.handle-value
     3103               .
     3104               if v-object-handle <> v-diasize-resize-button
     3105               then do:
     3106                 assign
     3107                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3108                 .
     3109               end.
     3110             end.
     3111             assign
     3112               v-diasize-browse-handle :width = v-browse-width
     3113             .
     3114             for each buf_temp-browse-handle
     3115               where buf_temp-browse-handle.browse-type = 'width':u
     3116             on error undo, next
     3117             :
     3118               assign
     3119                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3120               .
     3121             end.
     3122             assign
     3123               frame Dialog-Frame :width = v-frame-width
     3124             .
     3125             if frame Dialog-Frame :scrollable = true
     3126             then do:
     3127               assign
     3128                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3129               .
     3130             end.
     3131             run diasize_position-resize-button in this-procedure .
     3132           end.
     3133           else do:
     3134             if frame Dialog-Frame :scrollable = true
     3135             then do:
     3136               assign
     3137                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3138               .
     3139             end.
     3140             assign
     3141               frame Dialog-Frame :width = v-frame-width
     3142             .
     3143             for each buf_temp-browse-handle
     3144               where buf_temp-browse-handle.browse-type = 'width':u
     3145             on error undo, next
     3146             :
     3147               assign
     3148                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3149               .
     3150             end.
     3151             assign
     3152               v-diasize-browse-handle :width = v-browse-width
     3153             .
     3154             for each buf_temp-diasize-handle
     3155             on error undo, next
     3156             :
     3157               assign
     3158                 v-object-handle = buf_temp-diasize-handle.handle-value
     3159               .
     3160               if v-object-handle <> v-diasize-resize-button
     3161               then do:
     3162                 assign
     3163                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3164                 .
     3165               end.
     3166             end.
     3167             run diasize_position-resize-button in this-procedure .
     3168           end.
     3169           assign
     3170             v-diasize-change-size = false
     3171           .
     3172           leave move_block .
     3173         end.
     3174       end.
     3175       assign
     3176         v-diasize-need-full-display = true
     3177       .
     3178       if v-diasize-change-size = false
     3179       then do:
     3180         assign
     3181           v-diasize-change-size = true
     3182         .
     3183       end.
     3184       else do:
     3185         return .
     3186       end.
     3187       assign
     3188         v-frame-width = frame Dialog-Frame :width
     3189         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3190         v-browse-width = v-diasize-browse-handle :width
     3191       .
     3192       for each buf_temp-browse-handle
     3193         where buf_temp-browse-handle.browse-type = 'width':u
     3194       :
     3195         assign
     3196           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3197         .
     3198       end.
     3199       for each buf_temp-diasize-handle
     3200       :
     3201         delete buf_temp-diasize-handle .
     3202       end.
     3203       assign
     3204         v-field-group-handle = frame Dialog-Frame :first-child
     3205       .
     3206       do while valid-handle(v-field-group-handle)
     3207       :
     3208         assign
     3209           v-object-handle = v-field-group-handle :first-child
     3210         .
     3211         do while valid-handle(v-object-handle)
     3212         :
     3213           if  v-object-handle <> v-diasize-browse-handle :handle
     3214           and v-object-handle <> v-diasize-resize-button
     3215           and can-query(v-object-handle, "row")
     3216           and can-query(v-object-handle, "height")
     3217           and ( v-object-handle :col + v-object-handle :width
     3218                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3219               )
     3220           then do:
     3221             find first buf_temp-browse-handle
     3222               where buf_temp-browse-handle.browse-type   = 'width':u
     3223                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3224               no-error .
     3225             if available buf_temp-browse-handle
     3226             then do:
     3227             end.
     3228             else do:
     3229               create buf_temp-diasize-handle .
     3230               assign
     3231                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3232                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3233               .
     3234             end.
     3235           end.
     3236           assign
     3237             v-object-handle = v-object-handle :next-sibling
     3238           .
     3239         end.
     3240         assign
     3241           v-field-group-handle = v-field-group-handle :next-sibling
     3242         .
     3243       end.
     3244       do with frame Dialog-Frame
     3245       :
     3246         hide v-diasize-resize-button .
     3247         v-diasize-resize-button :row = 1.
     3248         v-diasize-resize-button :column = 1.
     3249       end.
     3250       if p-change-value > 0
     3251       then do:
     3252         if frame Dialog-Frame :scrollable = true
     3253         then do:
     3254           assign
     3255             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3256             no-error .
     3257           if error-status :error
     3258           or error-status :get-message(1) <> ""
     3259           then do:
     3260             undo move_block, retry move_block.
     3261           end.
     3262         end.
     3263         assign
     3264           frame Dialog-Frame :width = v-frame-width + p-change-value
     3265           no-error .
     3266         if error-status :error
     3267         or error-status :get-message(1) <> ""
     3268         then do:
     3269           undo move_block, retry move_block.
     3270         end.
     3271         assign
     3272           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3273         no-error .
     3274         if error-status :error
     3275         or error-status :get-message(1) <> ""
     3276         then do:
     3277           undo move_block, retry move_block.
     3278         end.
     3279         for each buf_temp-browse-handle
     3280           where buf_temp-browse-handle.browse-type = 'width':u
     3281         on error undo move_block, retry move_block
     3282         :
     3283           assign
     3284             buf_temp-browse-handle.browse-handle :width
     3285               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3286             no-error .
     3287           if error-status :error
     3288           or error-status :get-message(1) <> ""
     3289           then do:
     3290             undo move_block, retry move_block .
     3291           end.
     3292         end.
     3293         for each buf_temp-diasize-handle
     3294         on error undo move_block, retry move_block
     3295         :
     3296           assign
     3297             v-object-handle = buf_temp-diasize-handle.handle-value
     3298           .
     3299           if v-object-handle <> v-diasize-resize-button
     3300           then do:
     3301             assign
     3302               v-object-handle :col = v-object-handle :col + p-change-value
     3303               no-error .
     3304             if error-status :error
     3305             or error-status :get-message(1) <> ""
     3306             then do:
     3307               undo move_block, retry move_block .
     3308             end.
     3309           end.
     3310         end.
     3311       end.
     3312       else do:
     3313         for each buf_temp-diasize-handle
     3314         on error undo move_block, retry move_block
     3315         :
     3316           assign
     3317             v-object-handle = buf_temp-diasize-handle.handle-value
     3318           .
     3319           if v-object-handle <> v-diasize-resize-button
     3320           then do:
     3321             assign
     3322               v-object-handle :col = v-object-handle :col + p-change-value
     3323               no-error .
     3324             if error-status :error
     3325             or error-status :get-message(1) <> ""
     3326             then do:
     3327               undo move_block, retry move_block .
     3328             end.
     3329           end.
     3330         end.
     3331         for each buf_temp-browse-handle
     3332           where buf_temp-browse-handle.browse-type = 'width':u
     3333         on error undo move_block, retry move_block
     3334         :
     3335           assign
     3336             buf_temp-browse-handle.browse-handle :width
     3337               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3338             no-error .
     3339           if error-status :error
     3340           or error-status :get-message(1) <> ""
     3341           then do:
     3342             undo move_block, retry move_block .
     3343           end.
     3344         end.
     3345         assign
     3346           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3347           no-error .
     3348         if error-status :error
     3349         or error-status :get-message(1) <> ""
     3350         then do:
     3351           undo move_block, retry move_block.
     3352         end.
     3353         assign
     3354           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3355         no-error .
     3356         if error-status :error
     3357         or error-status :get-message(1) <> ""
     3358         then do:
     3359           undo move_block, retry move_block.
     3360         end.
     3361         if frame Dialog-Frame :scrollable = true
     3362         then do:
     3363           assign
     3364             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3365           no-error .
     3366           if error-status :error
     3367           or error-status :get-message(1) <> ""
     3368           then do:
     3369             undo move_block, retry move_block.
     3370           end.
     3371         end.
     3372       end.
     3373       if p-move-resize
     3374       then do:
     3375         run diasize_position-resize-button in this-procedure .
     3376       end.
     3377       if v-diasize-wndstore = true
     3378       then do:
     3379         if connected("ub") = true
     3380         then do:
     3381           define variable v-cntxt-db-num        as integer   no-undo .
     3382           define variable v-cntxt-userid        as character no-undo .
     3383           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3384                                             , OUTPUT v-cntxt-userid
     3385                                             ) .
     3386           run gbl/wndsizew.p
     3387             (input  v-cntxt-db-num
     3388             ,input  v-cntxt-userid
     3389             ,input  v-diasize-proc-name
     3390             ,input  'width':u
     3391             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3392             ) .
     3393         end.
     3394       end.
     3395     end.
     3396     assign
     3397       v-diasize-change-size = false
     3398     .
     3399   end procedure.
     3400   procedure diasize_set-width :
     3401     define input  parameter p-new-width  as decimal   no-undo .
     3402     define input  parameter p-move-resize as logical   no-undo .
     3403     do
     3404     on error undo, return error return-value
     3405     :
     3406       run diasize_change-width in this-procedure
     3407         (input  (p-new-width - frame Dialog-Frame :width)
     3408         ,input  p-move-resize
     3409         ) .
     3410     end.
     3411   end procedure.
     3412   procedure diasize_position-resize-button :
     3413     do with frame Dialog-Frame
     3414     :
     3415       hide v-diasize-resize-button .
     3416       assign
     3417         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3418                     - 1
     3419                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3420         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3421                     - 1
     3422                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3423       .
     3424       view v-diasize-resize-button .
     3425     end.
     3426   end procedure.
     3427   on alt-right anywhere
     3428   do:
     3429     run diasize_change-width in this-procedure
     3430       (input 1
     3431       ,input true
     3432       ) .
     3433     return no-apply .
     3434   end.
     3435   on alt-left anywhere
     3436   do:
     3437     run diasize_change-width in this-procedure
     3438       (input -1
     3439       ,input true
     3440       ) .
     3441     return no-apply .
     3442   end.
     3443   on alt-down anywhere
     3444   do:
     3445     run diasize_change-height in this-procedure
     3446       (input 1
     3447       ,input true
     3448       ) .
     3449     return no-apply .
     3450   end.
     3451   on alt-up anywhere
     3452   do:
     3453     run diasize_change-height in this-procedure
     3454       (input -1
     3455       ,input true
     3456       ) .
     3457     return no-apply .
     3458   end.
     3459   on alt-enter of frame Dialog-Frame
     3460   do:
     3461     run diasize_maximize in this-procedure
     3462       (input  ?
     3463       ).
     3464     return no-apply .
     3465   end.
     3466   procedure diasize_end-move :
     3467     do
     3468     on error undo, return error return-value
     3469     :
     3470       define variable v-row-delta as decimal   no-undo .
     3471       define variable v-col-delta as decimal   no-undo .
     3472       define variable v-new-row as decimal   no-undo .
     3473       define variable v-new-col as decimal   no-undo .
     3474       assign
     3475         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3476         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3477       .
     3478       assign
     3479         v-row-delta = v-new-row - frame Dialog-Frame :height
     3480         v-col-delta = v-new-col - frame Dialog-Frame :width
     3481       .
     3482       run diasize_change-height in this-procedure
     3483         (input v-row-delta
     3484         ,input true
     3485         ) .
     3486       run diasize_change-width in this-procedure
     3487         (input v-col-delta
     3488         ,input true
     3489         ) .
     3490     end.
     3491   end procedure.
     3492   procedure diasize_maximize :
     3493     define input  parameter p-action as logical   no-undo .
     3494     do
     3495     on error undo, return error return-value
     3496     :
     3497       if p-action = ?
     3498       then do:
     3499         if v-diasize-need-maximize = true
     3500         then do:
     3501           assign
     3502             p-action = true
     3503           .
     3504         end.
     3505         else do:
     3506           assign
     3507             p-action = false
     3508           .
     3509         end.
     3510       end.
     3511       if p-action = true
     3512       then do:
     3513         run diasize_change-height in this-procedure
     3514           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3515               - frame Dialog-Frame :height-chars
     3516           ,input true
     3517           ) .
     3518         run diasize_change-width in this-procedure
     3519           (input session :width-chars
     3520               - frame Dialog-Frame :width-chars
     3521           ,input true
     3522           ) .
     3523         assign
     3524           v-diasize-need-maximize = false
     3525         .
     3526       end.
     3527       else do:
     3528         run diasize_change-width in this-procedure
     3529           (input v-diasize-orig-frame-width
     3530               - frame Dialog-Frame :width-chars
     3531           ,input true
     3532           ) .
     3533         run diasize_change-height in this-procedure
     3534           (input v-diasize-orig-frame-height
     3535               - frame Dialog-Frame :height-chars
     3536           ,input true
     3537           ) .
     3538         assign
     3539           v-diasize-need-maximize = true
     3540         .
     3541       end.
     3542     end.
     3543   end procedure.
     3544   procedure diasize_restore-orig-size :
     3545     do
     3546     on error undo, return error return-value
     3547     :
     3548       assign
     3549         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3550         v-diasize-current-frame-height = frame Dialog-Frame :height
     3551       .
     3552       run diasize_set-height in this-procedure
     3553         (input  v-diasize-orig-frame-height
     3554         ,input  true
     3555         ) .
     3556       run diasize_set-width in this-procedure
     3557         (input  v-diasize-orig-frame-width
     3558         ,input  true
     3559         ) .
     3560     end.
     3561   end procedure.
     3562   procedure diasize_restore-current-size :
     3563     do
     3564     on error undo, return error return-value
     3565     :
     3566       run diasize_set-height in this-procedure
     3567         (input  v-diasize-current-frame-height
     3568         ,input  true
     3569         ) .
     3570       run diasize_set-width in this-procedure
     3571         (input  v-diasize-current-frame-width
     3572         ,input  true
     3573         ) .
     3574     end.
     3575   end procedure.
     3576   procedure diasize_set-browse-handle :
     3577     define input  parameter p-browse-handle as handle   no-undo .
     3578     define buffer buf_temp-browse-handle for temp-browse-handle .
     3579     do
     3580     on error undo, return error return-value
     3581     :
     3582       assign
     3583         v-diasize-browse-handle = p-browse-handle
     3584       .
     3585       for each buf_temp-browse-handle
     3586       on error undo, return error return-value
     3587       :
     3588         delete buf_temp-browse-handle .
     3589       end.
     3590     end.
     3591   end procedure.
     3592   procedure diasize_add_browse :
     3593     define input  parameter p-browse-type   as character no-undo .
     3594     define input  parameter p-browse-handle as handle    no-undo .
     3595     define buffer buf_temp-browse-handle for temp-browse-handle .
     3596     do
     3597     on error undo, return error return-value
     3598     :
     3599       assign
     3600         v-diasize-browse-number = v-diasize-browse-number + 1
     3601       .
     3602       create buf_temp-browse-handle .
     3603       assign
     3604         buf_temp-browse-handle.browse-type   = p-browse-type
     3605         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3606         buf_temp-browse-handle.browse-handle = p-browse-handle
     3607       .
     3608     end.
     3609   end procedure.
     3610   procedure diasize_init :
     3611     define variable v-default-value    as logical   no-undo .
     3612     define variable v-restore-saved    as logical   no-undo .
     3613     define variable v-resize-value-str as character no-undo .
     3614     do
     3615     on error undo, return error return-value
     3616     :
     3617       do with frame Dialog-Frame
     3618       :
     3619         assign
     3620           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3621           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3622           v-diasize-browse-handle     = browse BROWSE-obj :handle
     3623         .
     3624         create button v-diasize-resize-button
     3625         assign
     3626           parent        = frame Dialog-Frame :first-child
     3627           label         = "s"
     3628           height-pixels = 16
     3629           width-pixels  = 16
     3630           visible       = true
     3631           sensitive     = true
     3632           movable       = true
     3633           triggers:
     3634             on end-move persistent run diasize_end-move in this-procedure .
     3635           end triggers.
     3636         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3637         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3638         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3639         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3640         assign
     3641           v-diasize-wndmax = false
     3642         .
     3643         if connected("ub") = true
     3644         then do:
     3645           define variable v-cntxt-db-num        as integer   no-undo .
     3646           define variable v-cntxt-userid        as character no-undo .
     3647           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3648                                             , OUTPUT v-cntxt-userid
     3649                                             ) .
     3650           run gbl/wndpar_r.p
     3651             (input  v-cntxt-db-num
     3652             ,input  v-cntxt-userid
     3653             ,input  'wndmax':U
     3654             ,output v-diasize-wndmax
     3655             ,output v-default-value
     3656             ) .
     3657         end.
     3658         assign
     3659           v-diasize-wndstore = false
     3660         .
     3661         if connected("ub") = true
     3662         then do:
     3663           run gbl/wndpar_r.p
     3664             (input  v-cntxt-db-num
     3665             ,input  v-cntxt-userid
     3666             ,input  'wndstore':U
     3667             ,output v-diasize-wndstore
     3668             ,output v-default-value
     3669             ) .
     3670         end.
     3671         assign
     3672           v-diasize-proc-name = entry(1, program-name(2), '.')
     3673         .
     3674         if v-diasize-wndstore = true
     3675         then do:
     3676           assign
     3677             v-restore-saved = false
     3678           .
     3679           if connected("ub") = true
     3680           then do:
     3681             run gbl/wndsizer.p
     3682               (input  v-cntxt-db-num
     3683               ,input  v-cntxt-userid
     3684               ,input  v-diasize-proc-name
     3685               ,input  'height':u
     3686               ,output v-resize-value-str
     3687               ) .
     3688             if v-resize-value-str <> '':U
     3689             then do:
     3690               run diasize_change-height in this-procedure
     3691                 (input  integer(v-resize-value-str)
     3692                 ,input  true
     3693                 ) .
     3694               assign
     3695                 v-restore-saved = true
     3696               .
     3697             end.
     3698           end.
     3699           if connected("ub") = true
     3700           then do:
     3701             run gbl/wndsizer.p
     3702               (input  v-cntxt-db-num
     3703               ,input  v-cntxt-userid
     3704               ,input  v-diasize-proc-name
     3705               ,input  'width':u
     3706               ,output v-resize-value-str
     3707               ) .
     3708             if v-resize-value-str <> '':U
     3709             then do:
     3710               run diasize_change-width in this-procedure
     3711                 (input  integer(v-resize-value-str)
     3712                 ,input  true
     3713                 ) .
     3714               assign
     3715                 v-restore-saved = true
     3716               .
     3717             end.
     3718           end.
     3719           if v-restore-saved <> true
     3720           then do:
     3721             if v-diasize-wndmax = true
     3722             then do:
     3723               run diasize_maximize in this-procedure
     3724                 (input  true
     3725                 ) .
     3726             end.
     3727           end.
     3728         end.
     3729         else do:
     3730           if v-diasize-wndmax = true
     3731           then do:
     3732             run diasize_maximize in this-procedure
     3733               (input  true
     3734               ) .
     3735           end.
     3736         end.
     3737       end.
     3738     end.
     3739   end procedure.
     3740   procedure diasize_need-full-display :
     3741     define output parameter p-need-full-display as logical   no-undo .
     3742     do
     3743     on error undo, return error return-value
     3744     :
     3745       assign
     3746         p-need-full-display = v-diasize-need-full-display
     3747       .
     3748       assign
     3749         v-diasize-need-full-display = false
     3750       .
     3751     end.
     3752   end procedure.
     3753   procedure get-context :
     3754      define output parameter p-db-num as integer          no-undo.
     3755      define output parameter p-user-id as character        no-undo.
     3756      define variable v-login               as character    no-undo.
     3757      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3758      define buffer buf_user-login  for ub.user-login .
     3759      do
     3760      on error undo, return error
     3761      :
     3762            FIND FIRST buf_sys-ctrl no-lock.
     3763            ASSIGN
     3764               v-login = USERID("ub")
     3765               p-db-num = buf_sys-ctrl.db-num
     3766            .
     3767            FIND FIRST buf_user-login
     3768                 WHERE buf_user-login.db-num = p-db-num
     3769                   AND buf_user-login.user-login = v-login
     3770                 no-lock
     3771                 no-error
     3772                 .
     3773            IF AVAILABLE buf_user-login
     3774            THEN DO:
     3775               assign
     3776                  p-user-id = buf_user-login.user-id
     3777               .
     3778            END.
     3779      end.
     3780   end procedure.
     3781       run diasize_init in this-procedure .
     3782   MAIN-BLOCK:
     3783   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3784      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3785   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3786     run mainmenu_getcntxt in parparentproc
     3787       (output v-cntxt-db-num
     3788       ,output v-cntxt-userid
     3789       ,output v-cntxt-level
     3790       ,output v-cntxt-host-code-obj
     3791       ,output v-cntxt-obj-type
     3792       ,output v-cntxt-obj-code
     3793       ,output v-cntxt-db-num-obj
     3794       ,output v-cntxt-is-admin
     3795       ) .
     3796   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3797   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     3798     (output v-db-num
     3799     )  .
     3800    define variable loc#log as logical   no-undo .
     3801   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3802   do:
     3803     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3804       (input  v-cntxt-db-num
     3805       ,input  v-cntxt-userid
     3806       ,input  0
     3807       ,input  'actn_ABC-XYZ_lookup':U
     3808       ,input  'global':U
     3809       ,input  0
     3810       ,input  '':U
     3811       ,input  0
     3812       ,input  0
     3813       ,input  0
     3814       ,input  0
     3815       ,input  true
     3816       ,output loc#log
     3817       )  .
     3818   end.
     3819      if not loc#log then return .
     3820     for each x-XYZ-analysis:
     3821       delete x-XYZ-analysis.
     3822     end.
     3823     if p-mode = 'ИЗМЕНЕНИЕ':U
     3824     or p-mode = 'ПРОСМОТР':U then do:
     3825       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     3826         find first locked_XYZ-analysis  no-lock  where
     3827                     recid(locked_XYZ-analysis) = p-doc-rec no-wait no-error.
     3828         if locked locked_XYZ-analysis then do:
     3829           message
     3830           vss-workfile vss-revision vss-description skip
     3831            "Запись XYZ анализа занята"
     3832           view-as alert-box error .
     3833           undo, return error.
     3834         end.
     3835       end.
     3836       else do:
     3837         find first locked_XYZ-analysis no-lock where
     3838                          recid(locked_XYZ-analysis) = p-doc-rec no-error .
     3839         if not avail locked_XYZ-analysis then do:
     3840           find first locked_XYZ-analysis no-lock where
     3841                      locked_XYZ-analysis.db-num = p-db-num and
     3842                      locked_XYZ-analysis.XYZ-id = p-id
     3843                      no-error .
     3844         end.
     3845       end.
     3846       if not available locked_XYZ-analysis then do:
     3847         message
     3848         vss-workfile vss-revision vss-description skip
     3849         "Не найдена запись XYZ анализа"
     3850         view-as alert-box error .
     3851         undo, return error.
     3852       end.
     3853       create x-XYZ-analysis.
     3854       buffer-copy locked_XYZ-analysis to x-XYZ-analysis.
     3855      end.
     3856      else do:
     3857             run cur-time in this-procedure(output v-date, output v-time).
     3858             create x-XYZ-analysis.
     3859             assign
     3860             x-XYZ-analysis.XYZ-id = v-last-code + 1
     3861             x-XYZ-analysis.db-num = v-db-num
     3862             x-XYZ-analysis.XYZ-date-create = v-date
     3863             x-XYZ-analysis.XYZ-time-create = v-time
     3864             x-XYZ-analysis.XYZ-db-num-create = v-db-num
     3865             x-XYZ-analysis.XYZ-who-create  = g#userid
     3866            .
     3867      end.
     3868     run my_enable.
     3869     WAIT-FOR GO OF FRAME Dialog-Frame focus x-XYZ-analysis.XYZ-name.
     3870   END.
     3871   run disable_ui.
     3872   PROCEDURE disable_UI :
     3873     HIDE FRAME Dialog-Frame.
     3874   END PROCEDURE.
     3875   PROCEDURE enable_UI :
     3876     DISPLAY v-IN_xyz-y v-IN_xyz-y-2 FILL-IN-1 FILL-IN-2 FILL-IN-9 FILL-IN-3
     3877             FILL-IN-10 FILL-rez F-time
     3878         WITH FRAME Dialog-Frame.
     3879     IF AVAILABLE x-XYZ-analysis THEN
     3880       DISPLAY x-XYZ-analysis.r-goods
     3881         WITH FRAME Dialog-Frame.
     3882     IF AVAILABLE x-criterion-analysis THEN
     3883       DISPLAY x-criterion-analysis.cral-name
     3884         WITH FRAME Dialog-Frame.
     3885     IF AVAILABLE x-XYZ-analysis THEN
     3886       DISPLAY x-XYZ-analysis.xyz-name x-XYZ-analysis.xyz-x x-XYZ-analysis.xyz-z
     3887             x-XYZ-analysis.xyz-des x-XYZ-analysis.xyz-id x-XYZ-analysis.cral-id
     3888             x-XYZ-analysis.xyz-who-create x-XYZ-analysis.xyz-date-create
     3889             x-XYZ-analysis.xyz-db-num-create
     3890         WITH FRAME Dialog-Frame.
     3891     ENABLE b-quit B-exit B-save-rang B-save-doc-typd B-rez B-Help
     3892            x-XYZ-analysis.xyz-name B-crt B-add-obj B-del-obj B-add-period
     3893            B-del-period B-add-doc B-del-doc BROWSE-obj BROWSE-period
     3894            BROWSE-type-doc x-XYZ-analysis.xyz-x x-XYZ-analysis.xyz-z
     3895            x-XYZ-analysis.r-goods B-gds-list x-XYZ-analysis.xyz-des BROWSE-rez
     3896            x-XYZ-analysis.xyz-id x-XYZ-analysis.cral-id
     3897            x-criterion-analysis.cral-name FILL-IN-1 FILL-IN-2 FILL-IN-9 FILL-IN-3
     3898            FILL-IN-10 FILL-rez x-XYZ-analysis.xyz-who-create
     3899            x-XYZ-analysis.xyz-date-create F-time x-XYZ-analysis.xyz-db-num-create
     3900         WITH FRAME Dialog-Frame.
     3901     VIEW FRAME Dialog-Frame.
     3902     OPEN QUERY BROWSE-obj FOR EACH x-XYZ-analysis-obj       WHERE x-XYZ-analysis-obj.XYZ-id = x-XYZ-analysis.XYZ-id and x-XYZ-analysis-obj.db-num = x-XYZ-analysis.db-num NO-LOCK INDEXED-REPOSITION.    OPEN QUERY BROWSE-period FOR EACH x-XYZ-analysis-period       WHERE x-XYZ-analysis-period.XYZ-id = x-XYZ-analysis.XYZ-id and x-XYZ-analysis-period.db-num = x-XYZ-analysis.db-num NO-LOCK INDEXED-REPOSITION.    OPEN QUERY BROWSE-rez FOR EACH temp-rez .    OPEN QUERY BROWSE-type-doc FOR EACH x-XYZ-analysis-doc       WHERE x-XYZ-analysis-doc.XYZ-id = x-XYZ-analysis.XYZ-id and x-XYZ-analysis-doc.db-num = x-XYZ-analysis.db-num NO-LOCK INDEXED-REPOSITION.
     3903   END PROCEDURE.
     3904   PROCEDURE find-hash-obj :
     3905     define variable v-list-obj as character no-undo .
     3906     define variable v-possb-keep-string-obj as logical   no-undo .
     3907     define variable v-string-obj            as character no-undo .
     3908     define variable v-hash-string-obj       as character no-undo .
     3909     define variable v-recid as recid     no-undo .
     3910     v-list-obj = "".
     3911     for each x-XYZ-analysis-obj no-lock
     3912         where x-XYZ-analysis-obj.XYZ-id = x-XYZ-analysis.XYZ-id and
     3913               x-XYZ-analysis-obj.db-num = x-XYZ-analysis.db-num  :
     3914               v-list-obj = v-list-obj + x-XYZ-analysis-obj.obj-type + string(x-XYZ-analysis-obj.obj-code) + "," .
     3915     end.
     3916     run find-from-hash  in this-procedure (
     3917        input v-list-obj
     3918       ,input "rang-XYZ-def"
     3919       ,input "raxd-possb-keep-string-obj"
     3920       ,input "raxd-string-obj"
     3921       ,input "raxd-hash-string-obj"
     3922       ,input "rang-XYZ-def-obj"
     3923       ,output v-recid
     3924       ).
     3925      find first ub.rang-XYZ-def no-lock where
     3926                 recid(ub.rang-XYZ-def) = v-recid
     3927                 no-error .
     3928       if available ub.rang-XYZ-def then do:
     3929          message "Найдено значение уровней ранжирования для данного списка объектов по умолчанию : "    skip
     3930                   ub.rang-XYZ-def.raxd-x "%" skip
     3931                   ub.rang-XYZ-def.raxd-z "%" .
     3932          assign
     3933           x-XYZ-analysis.XYZ-x  = ub.rang-XYZ-def.raxd-x
     3934           x-XYZ-analysis.XYZ-y  = ub.rang-XYZ-def.raxd-y
     3935           x-XYZ-analysis.XYZ-z  = ub.rang-XYZ-def.raxd-z
     3936           x-XYZ-analysis.raxd-x = ub.rang-XYZ-def.raxd-x
     3937           x-XYZ-analysis.raxd-y = ub.rang-XYZ-def.raxd-y
     3938           x-XYZ-analysis.raxd-z = ub.rang-XYZ-def.raxd-z
     3939          .
     3940          display x-XYZ-analysis.XYZ-x
     3941                  x-XYZ-analysis.XYZ-z
     3942                  with frame Dialog-Frame .
     3943          apply "LEAVE" to x-XYZ-analysis.XYZ-z  in frame Dialog-Frame .
     3944       end.
     3945     run find-from-hash in this-procedure  (
     3946        input v-list-obj
     3947       ,input "doc-XYZ-def"
     3948       ,input "doxd-possb-keep-string-obj"
     3949       ,input "doxd-string-obj"
     3950       ,input "doxd-hash-string-obj"
     3951       ,input "doc-XYZ-def-obj"
     3952       ,output v-recid
     3953       ).
     3954      find first ub.doc-XYZ-def no-lock where
     3955                 recid(ub.doc-XYZ-def) = v-recid
     3956                 no-error .
     3957       if available ub.doc-XYZ-def then do:
     3958       for each ub.doc-XYZ-def-doc no-lock  where
     3959               ub.doc-XYZ-def-doc.doxd-id = ub.doc-XYZ-def.doxd-id and
     3960               ub.doc-XYZ-def-doc.db-num  = ub.doc-XYZ-def.db-num   :
     3961           create x-XYZ-analysis-doc.
     3962            assign
     3963               x-XYZ-analysis-doc.XYZd-ext-doc-type = ub.doc-XYZ-def-doc.dxdd-ext-doc-type
     3964               x-XYZ-analysis-doc.XYZ-id   = x-XYZ-analysis.XYZ-id
     3965               x-XYZ-analysis-doc.db-num   = x-XYZ-analysis.db-num
     3966            .
     3967           OPEN QUERY BROWSE-type-doc FOR EACH x-XYZ-analysis-doc       WHERE x-XYZ-analysis-doc.XYZ-id = x-XYZ-analysis.XYZ-id and x-XYZ-analysis-doc.db-num = x-XYZ-analysis.db-num NO-LOCK INDEXED-REPOSITION.
     3968       end.
     3969       end.
     3970   END PROCEDURE.
     3971   PROCEDURE make-temp-rez :
     3972   define buffer bb_xyz-analysis for ub.xyz-analysis.
     3973   find first bb_xyz-analysis no-lock where
     3974              bb_xyz-analysis.xyz-id = p-id and
     3975              bb_xyz-analysis.db-num = p-db-num
     3976              no-error .
     3977   for each temp-rez : delete temp-rez. end.
     3978       CREATE temp-rez.
     3979       ASSIGN
     3980       temp-rez.n  = 1
     3981       temp-rez.xyz  = "X"
     3982       temp-rez.Sum-cr   = bb_xyz-analysis.xyz-x-sum
     3983       temp-rez.Sum_prc  = bb_xyz-analysis.xyz-x-sum-prc
     3984       temp-rez.qnty     = bb_xyz-analysis.xyz-x-qnty
     3985       temp-rez.qnty_prc = bb_xyz-analysis.xyz-x-prc-qnty
     3986        .
     3987       CREATE temp-rez.
     3988       ASSIGN
     3989       temp-rez.n  = 2
     3990       temp-rez.xyz  = "Y"
     3991       temp-rez.Sum-cr   = bb_xyz-analysis.xyz-y-sum
     3992       temp-rez.Sum_prc  = bb_xyz-analysis.xyz-y-sum-prc
     3993       temp-rez.qnty     = bb_xyz-analysis.xyz-y-qnty
     3994       temp-rez.qnty_prc = bb_xyz-analysis.xyz-y-prc-qnty
     3995        .
     3996       CREATE temp-rez.
     3997       ASSIGN
     3998       temp-rez.n  = 3
     3999       temp-rez.xyz  = "Z"
     4000       temp-rez.Sum-cr   = bb_xyz-analysis.xyz-z-sum
     4001       temp-rez.Sum_prc  = bb_xyz-analysis.xyz-z-sum-prc
     4002       temp-rez.qnty     = bb_xyz-analysis.xyz-z-qnty
     4003       temp-rez.qnty_prc = bb_xyz-analysis.xyz-z-prc-qnty
     4004        .
     4005       CREATE temp-rez.
     4006       ASSIGN
     4007       temp-rez.n  = 7
     4008       temp-rez.xyz  = "ИТОГО"
     4009       temp-rez.Sum-cr     =
     4010                             bb_xyz-analysis.xyz-x-sum + bb_xyz-analysis.xyz-y-sum +
     4011                             bb_xyz-analysis.xyz-z-sum
     4012       temp-rez.Sum_prc    = 100
     4013       temp-rez.qnty       =
     4014                             bb_xyz-analysis.xyz-x-qnty + bb_xyz-analysis.xyz-y-qnty +
     4015                             bb_xyz-analysis.xyz-z-qnty
     4016       temp-rez.qnty_prc   = 100
     4017        .
     4018   OPEN QUERY BROWSE-rez FOR EACH temp-rez .
     4019   END PROCEDURE.
     4020   PROCEDURE my_enable :
     4021   if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
     4022      assign frame Dialog-Frame:title = "Просмотр XYZ анализа " .
     4023       for each ub.XYZ-analysis-doc no-lock  where
     4024               ub.XYZ-analysis-doc.XYZ-id = x-XYZ-analysis.XYZ-id and
     4025               ub.XYZ-analysis-doc.db-num = x-XYZ-analysis.db-num   :
     4026           create x-XYZ-analysis-doc.
     4027           BUFFER-COPY ub.XYZ-analysis-doc  TO x-XYZ-analysis-doc
     4028               .
     4029       end.
     4030       for each ub.XYZ-analysis-obj no-lock  where
     4031               ub.XYZ-analysis-obj.XYZ-id = x-XYZ-analysis.XYZ-id and
     4032               ub.XYZ-analysis-obj.db-num = x-XYZ-analysis.db-num   :
     4033           create x-XYZ-analysis-obj.
     4034           BUFFER-COPY ub.XYZ-analysis-obj  TO x-XYZ-analysis-obj.
     4035       end.
     4036       for each ub.XYZ-analysis-period no-lock where
     4037               ub.XYZ-analysis-period.XYZ-id = x-XYZ-analysis.XYZ-id and
     4038               ub.XYZ-analysis-period.db-num = x-XYZ-analysis.db-num   :
     4039           create x-XYZ-analysis-period.
     4040           BUFFER-COPY ub.XYZ-analysis-period TO x-XYZ-analysis-period.
     4041       end.
     4042       run make-temp-rez in this-procedure .
     4043   end.
     4044   define variable v-user-name as character no-undo .
     4045   IF AVAILABLE x-XYZ-analysis THEN DO:
     4046       f-time =  STRING (x-XYZ-analysis.XYZ-time-create,'HH:MM') .
     4047   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4048   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
     4049     (input  x-XYZ-analysis.XYZ-who-create
     4050     ,output v-user-name
     4051     )  .
     4052       DISPLAY x-XYZ-analysis.XYZ-name
     4053               x-XYZ-analysis.XYZ-x
     4054               x-XYZ-analysis.XYZ-z
     4055             FILL-IN-1 FILL-IN-2 FILL-IN-9 FILL-IN-3 FILL-IN-10 FILL-rez
     4056             x-XYZ-analysis.XYZ-des
     4057             x-XYZ-analysis.cral-id
     4058             v-user-name  when p-mode <> 'ДОБАВЛЕНИЕ':U @ x-XYZ-analysis.XYZ-who-create
     4059             x-XYZ-analysis.XYZ-date-create   when p-mode <> 'ДОБАВЛЕНИЕ':U
     4060             f-time                           when p-mode <> 'ДОБАВЛЕНИЕ':U
     4061             x-XYZ-analysis.XYZ-db-num-create when p-mode <> 'ДОБАВЛЕНИЕ':U
     4062             x-XYZ-analysis.XYZ-id            when p-mode <> 'ДОБАВЛЕНИЕ':U
     4063             x-XYZ-analysis.r-goods           when p-mode <> 'ДОБАВЛЕНИЕ':U
     4064             b-gds-list                       when p-mode <> 'ПРОСМОТР':U
     4065         WITH FRAME Dialog-Frame.
     4066       find first x-criterion-analysis no-lock where x-criterion-analysis.cral-id = x-XYZ-analysis.cral-id no-error .
     4067          IF AVAILABLE x-criterion-analysis THEN
     4068              DISPLAY x-criterion-analysis.cral-name WITH FRAME Dialog-Frame.
     4069    END.
     4070           if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     4071           assign frame Dialog-Frame:title = "Добавление XYZ анализа " .
     4072           display  ""  @  x-criterion-analysis.cral-name     with frame Dialog-Frame .
     4073         end.
     4074         if p-mode = 'ПРОСМОТР':U then do:
     4075           assign
     4076             b-quit:label = "&Выход"
     4077             b-quit:col = 1
     4078           .
     4079             hide b-exit in frame Dialog-Frame.
     4080             if x-XYZ-analysis.XYZ-x > 0 then
     4081                run proc-sel-rec in this-procedure (x-XYZ-analysis.XYZ-x , x-XYZ-analysis.XYZ-z)  .
     4082         end.
     4083         ENABLE
     4084         B-exit when p-mode <> 'ПРОСМОТР':U
     4085         b-quit
     4086         B-Help
     4087         x-XYZ-analysis.XYZ-name when p-mode <> 'ПРОСМОТР':U
     4088         B-crt                   when p-mode <> 'ПРОСМОТР':U
     4089         x-XYZ-analysis.XYZ-x    when p-mode <> 'ПРОСМОТР':U
     4090         x-XYZ-analysis.XYZ-z    when p-mode <> 'ПРОСМОТР':U
     4091         x-XYZ-analysis.r-goods  when p-mode <> 'ПРОСМОТР':U
     4092         b-gds-list              when p-mode <> 'ПРОСМОТР':U
     4093         FILL-IN-1
     4094         B-add-obj               when p-mode <> 'ПРОСМОТР':U
     4095         B-del-obj               when p-mode <> 'ПРОСМОТР':U
     4096         B-add-period            when p-mode <> 'ПРОСМОТР':U
     4097         B-del-period            when p-mode <> 'ПРОСМОТР':U
     4098         B-add-doc               when p-mode <> 'ПРОСМОТР':U
     4099         B-del-doc               when p-mode <> 'ПРОСМОТР':U
     4100         x-XYZ-analysis.XYZ-des  when p-mode <> 'ПРОСМОТР':U
     4101         BROWSE-obj
     4102         BROWSE-period
     4103         BROWSE-type-doc
     4104         B-save-doc-typd   when p-mode <> 'ПРОСМОТР':U
     4105         B-save-rang       when p-mode <> 'ПРОСМОТР':U
     4106         b-rez             when p-mode = 'ПРОСМОТР':U
     4107         WITH FRAME Dialog-Frame.
     4108     VIEW FRAME Dialog-Frame.
     4109     OPEN QUERY BROWSE-obj FOR EACH x-XYZ-analysis-obj       WHERE x-XYZ-analysis-obj.XYZ-id = x-XYZ-analysis.XYZ-id and x-XYZ-analysis-obj.db-num = x-XYZ-analysis.db-num NO-LOCK INDEXED-REPOSITION.    OPEN QUERY BROWSE-period FOR EACH x-XYZ-analysis-period       WHERE x-XYZ-analysis-period.XYZ-id = x-XYZ-analysis.XYZ-id and x-XYZ-analysis-period.db-num = x-XYZ-analysis.db-num NO-LOCK INDEXED-REPOSITION.    OPEN QUERY BROWSE-rez FOR EACH temp-rez .    OPEN QUERY BROWSE-type-doc FOR EACH x-XYZ-analysis-doc       WHERE x-XYZ-analysis-doc.XYZ-id = x-XYZ-analysis.XYZ-id and x-XYZ-analysis-doc.db-num = x-XYZ-analysis.db-num NO-LOCK INDEXED-REPOSITION.
     4110   END PROCEDURE.
     4111   PROCEDURE next-focus :
     4112     define input parameter p-widget-handle as handle no-undo .
     4113     define variable l-apply-entry as logical no-undo .
     4114     assign
     4115       l-apply-entry =  true
     4116     .
     4117     do with frame Dialog-Frame :
     4118       if  x-XYZ-analysis.XYZ-name  :handle = p-widget-handle then do:    if B-crt                  :sensitive then do: apply "entry":u to B-crt                  .  return . end. end.
     4119       if  B-crt              :handle = p-widget-handle then do:          if B-add-obj              :sensitive then do: apply "entry":u to B-add-obj              .  return . end. end.
     4120       if  B-add-obj          :handle = p-widget-handle then do:          if B-add-period           :sensitive then do: apply "entry":u to B-add-period           .  return . end. end.
     4121       if  B-add-period         :handle = p-widget-handle then do:        if B-add-doc              :sensitive then do: apply "entry":u to B-add-doc              .  return . end. end.
     4122       if  B-add-doc        :handle = p-widget-handle then do:            if x-XYZ-analysis.XYZ-x   :sensitive then do: apply "entry":u to x-XYZ-analysis.XYZ-x   .  return . end. end.
     4123       if  x-XYZ-analysis.XYZ-x        :handle = p-widget-handle then do: if x-XYZ-analysis.XYZ-z   :sensitive then do: apply "entry":u to x-XYZ-analysis.XYZ-z   .  return . end. end.
     4124       if  x-XYZ-analysis.XYZ-z        :handle = p-widget-handle then do: if x-XYZ-analysis.XYZ-des :sensitive then do: apply "entry":u to x-XYZ-analysis.XYZ-des .  return . end. end.
     4125       if  x-XYZ-analysis.XYZ-des      :handle = p-widget-handle then do: if B-exit                 :sensitive then do: apply "entry":u to B-exit                 .  return . end. end.
     4126     end.
     4127   END PROCEDURE.
     4128   PROCEDURE OpenBR :
     4129   OPEN QUERY BROWSE-obj FOR EACH x-XYZ-analysis-obj       WHERE x-XYZ-analysis-obj.XYZ-id = x-XYZ-analysis.XYZ-id and x-XYZ-analysis-obj.db-num = x-XYZ-analysis.db-num NO-LOCK INDEXED-REPOSITION.    OPEN QUERY BROWSE-period FOR EACH x-XYZ-analysis-period       WHERE x-XYZ-analysis-period.XYZ-id = x-XYZ-analysis.XYZ-id and x-XYZ-analysis-period.db-num = x-XYZ-analysis.db-num NO-LOCK INDEXED-REPOSITION.    OPEN QUERY BROWSE-rez FOR EACH temp-rez .    OPEN QUERY BROWSE-type-doc FOR EACH x-XYZ-analysis-doc       WHERE x-XYZ-analysis-doc.XYZ-id = x-XYZ-analysis.XYZ-id and x-XYZ-analysis-doc.db-num = x-XYZ-analysis.db-num NO-LOCK INDEXED-REPOSITION.
     4130   END PROCEDURE.
     4131   PROCEDURE proc-save :
     4132   if p-mode = 'ПРОСМОТР':U then do:
     4133       return error.
     4134   end.
     4135   if not available x-XYZ-analysis then do:
     4136       create x-XYZ-analysis.
     4137   end.
     4138   assign
     4139   frame Dialog-Frame
     4140   x-XYZ-analysis.XYZ-id
     4141   x-XYZ-analysis.XYZ-name
     4142   x-XYZ-analysis.XYZ-x
     4143   x-XYZ-analysis.XYZ-z
     4144   x-XYZ-analysis.r-goods
     4145   .
     4146   IF  x-XYZ-analysis.XYZ-x  >= 100 or
     4147       x-XYZ-analysis.XYZ-z >= 100  or
     4148       x-XYZ-analysis.XYZ-x <= 0    or
     4149       x-XYZ-analysis.XYZ-z <= 0
     4150       THEN DO:
     4151       return ERROR "Не верно установлено соотношение ранжирования ".
     4152   END.
     4153   IF x-XYZ-analysis.XYZ-x  >= x-XYZ-analysis.XYZ-z
     4154       THEN DO:
     4155       return ERROR "Уровень X должен быть меньше уровня Z " .
     4156   END.
     4157   assign
     4158     x-xyz-analysis.xyz-des = x-xyz-analysis.xyz-des:screen-value.
     4159    run ref/xyzanal1.p (
     4160                   input-output p-doc-rec
     4161                   ,p-mode
     4162                   ,x-XYZ-analysis.XYZ-id
     4163                   ,v-db-num
     4164                   ,x-XYZ-analysis.cral-id
     4165                   ,x-XYZ-analysis.XYZ-name
     4166                   ,x-XYZ-analysis.XYZ-des
     4167                   ,x-XYZ-analysis.raxd-x
     4168                   ,x-XYZ-analysis.raxd-y
     4169                   ,x-XYZ-analysis.raxd-z
     4170                   ,x-XYZ-analysis.XYZ-x
     4171                   ,x-XYZ-analysis.XYZ-y
     4172                   ,x-XYZ-analysis.XYZ-z
     4173                   ,x-XYZ-analysis.xyz-x-prc-qnty
     4174                   ,x-XYZ-analysis.xyz-x-qnty
     4175                   ,x-XYZ-analysis.xyz-x-sum-prc
     4176                   ,x-XYZ-analysis.xyz-x-sum
     4177                   ,x-XYZ-analysis.xyz-y-prc-qnty
     4178                   ,x-XYZ-analysis.xyz-y-qnty
     4179                   ,x-XYZ-analysis.xyz-y-sum-prc
     4180                   ,x-XYZ-analysis.xyz-y-sum
     4181                   ,x-XYZ-analysis.xyz-z-prc-qnty
     4182                   ,x-XYZ-analysis.xyz-z-qnty
     4183                   ,x-XYZ-analysis.xyz-z-sum-prc
     4184                   ,x-XYZ-analysis.xyz-z-sum
     4185                   ,x-XYZ-analysis.r-goods
     4186                   ,table x-XYZ-analysis-doc
     4187                   ,table x-XYZ-analysis-obj
     4188                   ,table x-XYZ-analysis-period
     4189                               )
     4190   no-error .
     4191   if error-status :error then do:
     4192       return error return-value .
     4193   end.
     4194   END PROCEDURE.
     4195   PROCEDURE proc-sel-rec :
     4196   define input  parameter p-XYZ-x as decimal   no-undo .
     4197   define input  parameter p-XYZ-z as decimal   no-undo .
     4198   define variable v-c as decimal   no-undo .
     4199   define variable v-a as decimal   no-undo .
     4200   define variable v-b as decimal   no-undo .
     4201   define variable v-a-pr as decimal   no-undo .
     4202   define variable v-b-pr as decimal   no-undo .
     4203   DISPLAY
     4204     p-XYZ-x @ v-IN_xyz-y
     4205     p-XYZ-z @ v-IN_xyz-y-2
     4206     WITH FRAME Dialog-Frame .
     4207   END PROCEDURE.
     4208   FUNCTION f-name-doc RETURNS CHARACTER
     4209     ( BUFFER buf_XYZ-analysis-doc FOR  x-XYZ-analysis-doc   ) :
     4210     define variable v-ret as character no-undo .
     4211     run get-name-from-ext-type in this-procedure ( buf_xyz-analysis-doc.xyzd-ext-doc-type , no , output v-ret ) .
     4212     RETURN v-ret.
     4213   END FUNCTION.
