     1825   define variable v-db-num LIKE ub.db.db-num no-undo.
     1826   define variable v-type as character no-undo .
     1827   define variable p-mark as character no-undo .
     1828   define variable p-obj  as character no-undo .
     1829   define variable p-time-upd as character no-undo .
     1830   define variable p-time-cr  as character no-undo .
