     2024        FILL-IN-1 AT ROW 6.25 COL 60 NO-LABEL
     2025        FILL-IN-2 AT ROW 7.25 COL 78.5 COLON-ALIGNED NO-LABEL
     2026        FILL-IN-9 AT ROW 8.5 COL 78.5 COLON-ALIGNED NO-LABEL
     2027        FILL-IN-3 AT ROW 10.25 COL 75 COLON-ALIGNED NO-LABEL
     2028        FILL-IN-10 AT ROW 10.25 COL 87.5 COLON-ALIGNED NO-LABEL
     2029        FILL-rez AT ROW 16.5 COL 1.5 NO-LABEL
     2030        x-XYZ-analysis.xyz-who-create AT ROW 17.75 COL 82 COLON-ALIGNED FORMAT "X(15)"
     2031              VIEW-AS TEXT
     2032             SIZE 14 BY .67
     2033        x-XYZ-analysis.xyz-date-create AT ROW 18.5 COL 82 COLON-ALIGNED
     2034              VIEW-AS TEXT
     2035             SIZE 13 BY .67
     2036        F-time AT ROW 19.25 COL 82 COLON-ALIGNED
     2037        x-XYZ-analysis.xyz-db-num-create AT ROW 20 COL 82 COLON-ALIGNED
     2038              VIEW-AS TEXT
     2039             SIZE 3 BY .67
     2040        SPACE(11.38) SKIP(2.37)
     2041       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2042            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2043            TITLE "Список XYZ-анализов".
     2044   ASSIGN
     2045          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2046          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2047   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2048   DO:
     2049     APPLY "END-ERROR":U TO SELF.
     2050   END.
     2051   ON CHOOSE OF B-add-doc IN FRAME Dialog-Frame
     2052   DO:
     2053   define variable  pattr-codes as character no-undo.
     2054   define variable pattr-labels as character no-undo.
     2055   define variable ppresel-codes as character no-undo.
     2056   define variable  psel-codes as character no-undo.
     2057   pattr-codes      =  'ee,es,re,rs,we':u .
     2058   pattr-labels     =  'расход внешний,касса продажа,возврат внешний,касса возврат,списание':u .
     2059   if p-id = ? then p-id = 1 .
     2060     run gbl/d-list.w (
     2061         "b-sel,b-mark"     ,
     2062         "Расширенный тип"  ,
     2063         pattr-codes        ,
     2064         pattr-labels       ,
     2065         ","                ,
     2066         ppresel-codes  ,
     2067         OUTPUT  psel-codes             ) .
     2068   if  psel-codes = "" then return no-apply.
     2069   define variable ii as integer   no-undo .
     2070   define variable i-all as integer   no-undo .
     2071   i-all = num-entries (psel-codes) .
     2072   repeat ii = 1 to  i-all :
     2073          find first x-XYZ-analysis-doc where x-XYZ-analysis-doc.XYZd-ext-doc-type = entry(ii, psel-codes ) no-error .
     2074            if not available x-XYZ-analysis-doc   then do:
     2075                 create x-XYZ-analysis-doc .
     2076                 assign
     2077                   x-XYZ-analysis-doc.XYZ-id   = p-id
     2078                   x-XYZ-analysis-doc.db-num   = p-db-num
     2079                   x-XYZ-analysis-doc.XYZd-ext-doc-type = entry(ii, psel-codes )
     2080                 .
     2081            end.
     2082   end.
     2083   OPEN QUERY BROWSE-type-doc FOR EACH x-XYZ-analysis-doc       WHERE x-XYZ-analysis-doc.XYZ-id = x-XYZ-analysis.XYZ-id and x-XYZ-analysis-doc.db-num = x-XYZ-analysis.db-num NO-LOCK INDEXED-REPOSITION.
     2084   END.
     2085   ON return OF B-add-doc IN FRAME Dialog-Frame
     2086   DO:
     2087       run next-focus in this-procedure  (input  B-add-doc:handle ) .
     2088     return no-apply .
     2089   END.
     2090   ON CHOOSE OF B-add-obj IN FRAME Dialog-Frame
     2091   DO:
     2092     define variable v-user-select as logical   no-undo .
     2093   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2094   run userobjs_select-many in this-procedure
     2095     (input  parparentproc
     2096     ,input  v-cntxt-db-num
     2097     ,input  v-cntxt-userid
     2098     ,input  v-cntxt-host-code-obj
     2099     ,input  v-cntxt-obj-type
     2100     ,input  v-cntxt-obj-code
     2101     ,output v-user-select
     2102     )  .
     2103     if v-user-select <> true
     2104     then do:
     2105       return no-apply .
     2106     end.
     2107     if p-id = ?
     2108     then do:
     2109       assign
     2110         p-id = 1
     2111       .
     2112     end.
     2113     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     2114     for each buf_userobjs_temp-user-obj
     2115     on error undo, return no-apply
     2116     :
     2117       find first x-XYZ-analysis-obj
     2118         where x-XYZ-analysis-obj.obj-type = buf_userobjs_temp-user-obj.obj-type
     2119           and x-XYZ-analysis-obj.obj-code = buf_userobjs_temp-user-obj.obj-code
     2120         no-error .
     2121       if not available x-XYZ-analysis-obj
     2122       then do :
     2123         create x-XYZ-analysis-obj .
     2124         assign
     2125           x-XYZ-analysis-obj.XYZ-id   = p-id
     2126           x-XYZ-analysis-obj.db-num   = p-db-num
     2127           x-XYZ-analysis-obj.obj-type = buf_userobjs_temp-user-obj.obj-type
     2128           x-XYZ-analysis-obj.obj-code = buf_userobjs_temp-user-obj.obj-code
     2129         .
     2130       end.
     2131     end.
     2132     OPEN QUERY BROWSE-obj FOR EACH x-XYZ-analysis-obj       WHERE x-XYZ-analysis-obj.XYZ-id = x-XYZ-analysis.XYZ-id and x-XYZ-analysis-obj.db-num = x-XYZ-analysis.db-num NO-LOCK INDEXED-REPOSITION.
     2133     if x-XYZ-analysis.XYZ-x = 0
     2134     then do:
     2135       run find-hash-obj in this-procedure .
     2136     end.
     2137   END.
     2138   ON return OF B-add-obj IN FRAME Dialog-Frame
     2139   DO:
     2140       run next-focus in this-procedure  (input  B-add-obj:handle ) .
     2141     return no-apply .
     2142   END.
     2143   ON CHOOSE OF B-add-period IN FRAME Dialog-Frame
     2144   DO:
     2145   if p-id = ? then p-id = 1 .
     2146   define variable date-1  as date   no-undo .
     2147   define variable date-2  as date   no-undo .
     2148   define variable v-ok as logical   no-undo .
     2149   for each temp-date : delete temp-date . end.
     2150      run ref/div-per.w (
     2151           input-output  table temp-date
     2152             ) .
     2153       for each temp-date :
     2154          find first x-XYZ-analysis-period where
     2155             x-XYZ-analysis-period.XYZp-end   = temp-date.date2 and
     2156             x-XYZ-analysis-period.XYZp-start = temp-date.date1 no-error .
     2157          if not available x-XYZ-analysis-period then do:
     2158           create x-XYZ-analysis-period .
     2159           assign
     2160             x-XYZ-analysis-period.XYZ-id     = p-id
     2161             x-XYZ-analysis-period.db-num     = p-db-num
     2162             x-XYZ-analysis-period.XYZp-end   = temp-date.date2
     2163             x-XYZ-analysis-period.XYZp-start = temp-date.date1
     2164           .
     2165          end.
     2166       end.
     2167     OPEN QUERY BROWSE-period FOR EACH x-XYZ-analysis-period       WHERE x-XYZ-analysis-period.XYZ-id = x-XYZ-analysis.XYZ-id and x-XYZ-analysis-period.db-num = x-XYZ-analysis.db-num NO-LOCK INDEXED-REPOSITION.
     2168   END.
     2169   ON return OF B-add-period IN FRAME Dialog-Frame
     2170   DO:
     2171       run next-focus in this-procedure  (input  B-add-period:handle ) .
     2172     return no-apply .
     2173   END.
     2174   ON CHOOSE OF B-crt IN FRAME Dialog-Frame
     2175   DO:
     2176   define VAR v-rid-list    as  char no-undo .
     2177         DISPLAY
     2178          "" @ x-XYZ-analysis.cral-id
     2179          "" @ x-criterion-analysis.cral-name
     2180         WITH FRAME Dialog-Frame.
     2181   run ref/critanal.w (parParentProc,"b-sel", "", OUTPUT v-rid-list ) no-error .
     2182     if error-status :error or  v-rid-list = "" or v-rid-list = ? then do:
     2183        message "Не выбран критерий анализа!" skip
     2184        error-status :get-message(1) skip
     2185        return-value skip
     2186        view-as alert-box error
     2187        .
     2188        return no-apply.
     2189     end.
     2190     find first x-criterion-analysis no-lock where recid(x-criterion-analysis) = integer(v-rid-list) no-error.
     2191         if error-status :error or  v-rid-list = "" or v-rid-list = ? then do:
     2192           message "Не правильно выбран критерий анализа!" skip
     2193           error-status :get-message(1) skip
     2194           return-value skip
     2195           view-as alert-box error
     2196           .
     2197           return no-apply.
     2198         end.
     2199         if x-criterion-analysis.cral-status <> 0 then do:
     2200           message "Не правильно выбран критерий анализа! Статус критерия должен быть АКТИВНЫЙ ." skip
     2201           view-as alert-box error
     2202           .
     2203           return no-apply.
     2204         end.
     2205      ASSIGN
     2206         x-XYZ-analysis.cral-id = x-criterion-analysis.cral-id
     2207       .
     2208         DISPLAY
     2209           x-XYZ-analysis.cral-id
     2210           x-criterion-analysis.cral-name
     2211         WITH FRAME Dialog-Frame.
     2212   END.
     2213   ON return OF B-crt IN FRAME Dialog-Frame
     2214   DO:
     2215       run next-focus in this-procedure  (input  B-crt:handle ) .
     2216     return no-apply .
     2217   END.
     2218   ON CHOOSE OF B-del-doc IN FRAME Dialog-Frame
     2219   DO:
     2220     IF AVAILABLE x-XYZ-analysis-doc THEN DELETE x-XYZ-analysis-doc.
     2221     OPEN QUERY BROWSE-type-doc FOR EACH x-XYZ-analysis-doc       WHERE x-XYZ-analysis-doc.XYZ-id = x-XYZ-analysis.XYZ-id and x-XYZ-analysis-doc.db-num = x-XYZ-analysis.db-num NO-LOCK INDEXED-REPOSITION.
     2222   END.
     2223   ON CHOOSE OF B-del-obj IN FRAME Dialog-Frame
     2224   DO:
     2225    IF AVAILABLE x-XYZ-analysis-obj THEN DELETE x-XYZ-analysis-obj.
     2226   OPEN QUERY BROWSE-obj FOR EACH x-XYZ-analysis-obj       WHERE x-XYZ-analysis-obj.XYZ-id = x-XYZ-analysis.XYZ-id and x-XYZ-analysis-obj.db-num = x-XYZ-analysis.db-num NO-LOCK INDEXED-REPOSITION.
     2227   END.
     2228   ON CHOOSE OF B-del-period IN FRAME Dialog-Frame
     2229   DO:
     2230     IF AVAILABLE x-XYZ-analysis-period THEN DELETE x-XYZ-analysis-period.
     2231     OPEN QUERY BROWSE-period FOR EACH x-XYZ-analysis-period       WHERE x-XYZ-analysis-period.XYZ-id = x-XYZ-analysis.XYZ-id and x-XYZ-analysis-period.db-num = x-XYZ-analysis.db-num NO-LOCK INDEXED-REPOSITION.
     2232   END.
     2233   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     2234   DO:
     2235       run proc-save in this-procedure no-error.
     2236       if error-status:error then do:
     2237           case return-value
     2238           :
     2239           when "cral-id"
     2240             then do:
     2241                 apply "CHOOSE" to B-crt IN FRAME Dialog-Frame .
     2242             end.
     2243           when "obj"
     2244             then do:
     2245                 apply "CHOOSE" to B-add-obj IN FRAME Dialog-Frame .
     2246             end.
     2247           when "date"
     2248             then do:
     2249              apply "CHOOSE" to B-add-period IN FRAME Dialog-Frame .
     2250             end.
     2251           when "doc"
     2252             then do:
     2253               apply "CHOOSE" to B-add-doc IN FRAME Dialog-Frame .
     2254             end.
     2255           when "period"
     2256             then do:
     2257               apply "CHOOSE" to B-add-period IN FRAME Dialog-Frame .
     2258             end.
     2259           when "XYZ-name"
     2260             then do:
     2261               apply "entry" to x-xyz-analysis.xyz-name IN FRAME Dialog-Frame .
     2262             end.
     2263           otherwise do:
     2264             MESSAGE  RETURN-VALUE view-as alert-box information .
     2265           end.
     2266           end case.
     2267           return no-apply.
     2268       end.
     2269       find first locked_XYZ-analysis no-lock where
     2270                         recid(locked_XYZ-analysis) = p-doc-rec no-error .
     2271       run ref/xyz-a.p  (
     2272            input parparentproc
     2273          , input "xyz":U
     2274          , input locked_XYZ-analysis.XYZ-id
     2275          , input locked_XYZ-analysis.db-num
     2276          , input table x-XYZ-analysis
     2277          , input table x-XYZ-analysis-doc
     2278          , input table x-XYZ-analysis-obj
     2279          , input table x-XYZ-analysis-period )
     2280       no-error.
     2281       if error-status:error then do:
     2282           MESSAGE "Ошибка расчета XYZ анализа"
     2283           error-status :get-message(1)
     2284           return-value
     2285           "456" skip
     2286        .
     2287         return no-apply.
     2288         end.
     2289       run ref/xyz-view.w (
     2290       parParentProc,
     2291       locked_XYZ-analysis.XYZ-id ,
     2292       locked_XYZ-analysis.db-num
     2293       )  .
     2294   END.
     2295   ON CHOOSE OF B-gds-list IN FRAME Dialog-Frame
     2296   DO:
     2297   define variable v-ps as character no-undo .
     2298   v-ps = "".
     2299   for each gds-list-hist:
     2300     v-ps = v-ps + gds-list-hist.des + chr(10).
     2301   end.
     2302     run gbl/d-prompt.w (
     2303           'title=':u + "Список товаров" + '\':u
     2304         + 'format=' + "x(1000)" + '\':u
     2305         + 'type=' + "edit" + '\':u
     2306         + 'fillin_row=2\':u
     2307         + 'fillin_col=4\':u
     2308         + 'fillin_width=60\':u
     2309         + 'fillin_height=10\':u
     2310         + 'max-chars=1000\':u
     2311         + 'readonly=yes\':u
     2312         , input-output v-ps
     2313         ) no-error.
     2314   END.
     2315   ON CHOOSE OF B-rez IN FRAME Dialog-Frame
     2316   DO:
     2317     run ref/xyz-view.w (
     2318     parParentProc,
     2319     x-XYZ-analysis.XYZ-id ,
     2320     x-XYZ-analysis.db-num
     2321     ) no-error .
     2322     if error-status :error then
     2323     message
     2324     vss-workfile vss-revision vss-description skip
     2325     error-status :get-message(1) skip
     2326     return-value                 skip
     2327     "Ошибка процедуры XYZ-view.w"
     2328     .
     2329     run make-temp-rez .
     2330   END.
     2331   ON CHOOSE OF B-save-doc-typd IN FRAME Dialog-Frame
     2332   DO:
     2333     if not can-find (first x-xyz-analysis-obj no-lock
     2334           where x-xyz-analysis-obj.xyz-id = x-xyz-analysis.xyz-id and
     2335                 x-xyz-analysis-obj.db-num = x-xyz-analysis.db-num  ) then do:
     2336                 message "Не выбрано ни одного объекта! Сохранить список типов документов можно после определения списка объектов." view-as alert-box information .
     2337                 return .
     2338     end.
     2339     if not can-find (first x-xyz-analysis-doc no-lock
     2340           where x-xyz-analysis-doc.xyz-id = x-xyz-analysis.xyz-id and
     2341                 x-xyz-analysis-doc.db-num = x-xyz-analysis.db-num  ) then do:
     2342                 message "Список типов документов для сохранения пуст! Заполните список типов документов." view-as alert-box information .
     2343                 return .
     2344     end.
     2345     run waitfram-show ("Ждите...").
     2346     define variable v-list-obj as character no-undo .
     2347     define variable v-list-doc as character no-undo .
     2348     define variable v-possb-keep-string-obj as logical   no-undo .
     2349     define variable v-string-obj            as character no-undo .
     2350     define variable v-hash-string-obj       as character no-undo .
     2351     define variable v-possb-keep-string-doc as logical   no-undo .
     2352     define variable v-string-doc            as character no-undo .
     2353     define variable v-hash-string-doc       as character no-undo .
     2354     define variable v-id as integer   no-undo .
     2355     define variable v-db as integer   no-undo .
     2356     define variable v-recid as recid  no-undo .
     2357     v-list-obj = "".
     2358     for each x-xyz-analysis-obj no-lock
     2359         where x-xyz-analysis-obj.xyz-id = x-xyz-analysis.xyz-id and
     2360               x-xyz-analysis-obj.db-num = x-xyz-analysis.db-num  :
     2361               v-list-obj = v-list-obj + x-xyz-analysis-obj.obj-type + string(x-xyz-analysis-obj.obj-code) + "," .
     2362     end.
     2363     v-list-doc = "".
     2364     for each x-xyz-analysis-doc no-lock
     2365         where x-xyz-analysis-doc.xyz-id = x-xyz-analysis.xyz-id and
     2366               x-xyz-analysis-doc.db-num = x-xyz-analysis.db-num  :
     2367               v-list-doc = v-list-doc + x-xyz-analysis-doc.xyzd-ext-doc-type  + "," .
     2368     end.
     2369     run find-from-hash  (
     2370        input v-list-obj
     2371       ,input "doc-XYZ-def"
     2372       ,input "doxd-possb-keep-string-obj"
     2373       ,input "doxd-string-obj"
     2374       ,input "doxd-hash-string-obj"
     2375       ,input "doc-XYZ-def-obj"
     2376       ,output v-recid
     2377       ).
     2378     run update-doc-xyz-def (
     2379        input v-recid
     2380       ,input v-list-obj
     2381       ,input v-list-doc
     2382       ).
     2383     run waitfram-hide in this-procedure .
     2384   END.
     2385   ON CHOOSE OF B-save-rang IN FRAME Dialog-Frame
     2386   DO:
     2387     if not can-find (first x-XYZ-analysis-obj no-lock
     2388           where x-XYZ-analysis-obj.XYZ-id = x-XYZ-analysis.XYZ-id and
     2389                 x-XYZ-analysis-obj.db-num = x-XYZ-analysis.db-num  ) then do:
     2390                 message "Не выбрано ни одного объекта! Сохранить ранжирование можно после определения списка объектов." view-as alert-box information .
     2391                 return .
     2392     end.
     2393     if  x-XYZ-analysis.XYZ-x  = 0  or  x-XYZ-analysis.XYZ-z = 0  then do:
     2394                 message "Ранжирование XYZ не задано !!!" view-as alert-box information .
     2395                 return .
     2396     end.
     2397     run waitfram-show in this-procedure  ("Ждите...") .
     2398     define variable v-list-obj as character no-undo .
     2399     define variable v-possb-keep-string-obj as logical   no-undo .
     2400     define variable v-string-obj            as character no-undo .
     2401     define variable v-hash-string-obj       as character no-undo .
     2402     define variable v-id as integer   no-undo .
     2403     define variable v-db as integer   no-undo .
     2404     define variable v-recid as recid  no-undo .
     2405     v-list-obj = "".
     2406     for each x-XYZ-analysis-obj no-lock
     2407         where x-XYZ-analysis-obj.XYZ-id = x-XYZ-analysis.XYZ-id and
     2408               x-XYZ-analysis-obj.db-num = x-XYZ-analysis.db-num  :
     2409               v-list-obj = v-list-obj + x-XYZ-analysis-obj.obj-type + string(x-XYZ-analysis-obj.obj-code) + "," .
     2410     end.
     2411     run find-from-hash  (
     2412        input v-list-obj
     2413       ,input "rang-XYZ-def"
     2414       ,input "raxd-possb-keep-string-obj"
     2415       ,input "raxd-string-obj"
     2416       ,input "raxd-hash-string-obj"
     2417       ,input "rang-XYZ-def-obj"
     2418       ,output v-recid
     2419       ).
     2420     run update-rang-xyz-def (
     2421        input v-recid
     2422       ,input v-list-obj
     2423       ,input x-XYZ-analysis.XYZ-x
     2424       ,input x-XYZ-analysis.XYZ-y
     2425       ,input x-XYZ-analysis.XYZ-z
     2426       ) .
     2427       x-XYZ-analysis.raxd-x = x-XYZ-analysis.XYZ-x .
     2428       x-XYZ-analysis.raxd-y = x-XYZ-analysis.XYZ-y .
     2429       x-XYZ-analysis.raxd-z = x-XYZ-analysis.XYZ-z .
     2430     run waitfram-hide .
     2431   END.
     2432   ON ROW-DISPLAY OF BROWSE-rez IN FRAME Dialog-Frame
     2433   DO:
     2434     IF AVAILABLE temp-rez THEN DO:
     2435         IF  temp-rez.xyz = "X" THEN DO:
     2436             temp-rez.xyz:fgcolor in browse BROWSE-rez = 12 .
     2437             temp-rez.Sum-cr:fgcolor in browse BROWSE-rez = 12 .
     2438             temp-rez.Sum_prc:fgcolor in browse BROWSE-rez = 12 .
     2439             temp-rez.qnty:fgcolor in browse BROWSE-rez = 12 .
     2440             temp-rez.qnty_prc:fgcolor in browse BROWSE-rez = 12 .
     2441         END.
     2442         IF  temp-rez.xyz = "Y" THEN DO:
     2443             temp-rez.xyz:fgcolor      in browse BROWSE-rez = 9 .
     2444             temp-rez.Sum-cr:fgcolor     in browse BROWSE-rez = 9 .
     2445             temp-rez.Sum_prc:fgcolor  in browse BROWSE-rez = 9 .
     2446             temp-rez.qnty:fgcolor     in browse BROWSE-rez = 9 .
     2447             temp-rez.qnty_prc:fgcolor in browse BROWSE-rez = 9 .
     2448         END.
     2449     END.
     2450   END.
