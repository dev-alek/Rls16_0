     1850   FUNCTION f-name-doc RETURNS CHARACTER
     1851     ( BUFFER buf_XYZ-analysis-doc FOR  x-XYZ-analysis-doc   )  FORWARD.
     1852   DEFINE BUTTON B-add-doc
     1853        LABEL "+"
     1854        SIZE 3 BY 1 TOOLTIP "Добавить типы документов".
     1855   DEFINE BUTTON B-add-obj
     1856        LABEL "+"
     1857        SIZE 3 BY 1 TOOLTIP "Добавить объекты".
     1858   DEFINE BUTTON B-add-period
     1859        LABEL "+"
     1860        SIZE 3 BY 1 TOOLTIP "Добавить период".
     1861   DEFINE BUTTON B-crt
     1862        IMAGE-UP FILE "btn-down-arrow":U
     1863        IMAGE-DOWN FILE "btn-down-arrow":U
     1864        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1865        LABEL ""
     1866        SIZE 3 BY 1 TOOLTIP "Справочник критериев анализа".
     1867   DEFINE BUTTON B-del-doc
     1868        LABEL "-"
     1869        SIZE 3 BY 1 TOOLTIP "Удалить тип документа".
     1870   DEFINE BUTTON B-del-obj
     1871        LABEL "-"
     1872        SIZE 3 BY 1 TOOLTIP "Удалить объект".
     1873   DEFINE BUTTON B-del-period
     1874        LABEL "-"
     1875        SIZE 3 BY 1 TOOLTIP "Удалить период".
     1876   DEFINE BUTTON B-exit AUTO-GO
     1877        LABEL "&Расчет"
     1878        SIZE 10 BY 1
     1879        BGCOLOR 8 .
     1880   DEFINE BUTTON B-gds-list
     1881        IMAGE-UP FILE "cmp/btn-fnd.bmp":U
     1882        IMAGE-DOWN FILE "cmp/btn-fnd.bmp":U
     1883        IMAGE-INSENSITIVE FILE "cmp/btn-fnd.bmp":U
     1884        LABEL "?"
     1885        SIZE 3 BY .88.
     1886   DEFINE BUTTON B-Help
     1887        LABEL "Помо&щь"
     1888        SIZE 10 BY 1
     1889        BGCOLOR 8 .
     1890   DEFINE BUTTON b-quit AUTO-END-KEY
     1891        LABEL "&Выход"
     1892        SIZE 10 BY 1
     1893        BGCOLOR 8 .
     1894   DEFINE BUTTON B-rez
     1895        LABEL "Результат анализа"
     1896        SIZE 20 BY 1 TOOLTIP "Просмотр результатов XYZанализа".
     1897   DEFINE BUTTON B-save-doc-typd
     1898        LABEL "Сохранить ТД"
     1899        SIZE 15 BY 1 TOOLTIP "Сохранить список типов док-тов(ТД) по выбранным объектам".
     1900   DEFINE BUTTON B-save-rang
     1901        LABEL "Сохранить XYZ%"
     1902        SIZE 16.5 BY 1 TOOLTIP "Сохранить соотношение ранжирования(XYZ%) по выбранным объектам".
     1903   DEFINE VARIABLE F-time AS CHARACTER FORMAT "X(256)":U
     1904        LABEL "Время создания анализа"
     1905         VIEW-AS TEXT
     1906        SIZE 14 BY .67 NO-UNDO.
     1907   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Соотношение ранжирования"
     1908         VIEW-AS TEXT
     1909        SIZE 25.5 BY .67
     1910        FGCOLOR 4  NO-UNDO.
     1911   DEFINE VARIABLE FILL-IN-10 AS CHARACTER FORMAT "X(256)":U INITIAL "%"
     1912         VIEW-AS TEXT
     1913        SIZE 2 BY 1 NO-UNDO.
     1914   DEFINE VARIABLE FILL-IN-2 AS CHARACTER FORMAT "X(256)":U INITIAL "%"
     1915         VIEW-AS TEXT
     1916        SIZE 2 BY 1 NO-UNDO.
     1917   DEFINE VARIABLE FILL-IN-3 AS CHARACTER FORMAT "X(256)":U INITIAL "% -"
     1918         VIEW-AS TEXT
     1919        SIZE 3.5 BY 1 NO-UNDO.
     1920   DEFINE VARIABLE FILL-IN-9 AS CHARACTER FORMAT "X(256)":U INITIAL "%"
     1921         VIEW-AS TEXT
     1922        SIZE 2 BY 1 NO-UNDO.
     1923   DEFINE VARIABLE FILL-rez AS CHARACTER FORMAT "X(256)":U INITIAL "Результат анализа:"
     1924         VIEW-AS TEXT
     1925        SIZE 19.5 BY .67
     1926        FGCOLOR 4  NO-UNDO.
     1927   DEFINE VARIABLE v-IN_xyz-y AS DECIMAL FORMAT ">9.9999" INITIAL 0
     1928        LABEL "Y"
     1929        VIEW-AS FILL-IN NATIVE
     1930        SIZE 8.5 BY 1 NO-UNDO.
     1931   DEFINE VARIABLE v-IN_xyz-y-2 AS DECIMAL FORMAT ">9.9999" INITIAL 0
     1932        VIEW-AS FILL-IN NATIVE
     1933        SIZE 8 BY 1 NO-UNDO.
     1934   DEFINE QUERY BROWSE-obj FOR
     1935         x-XYZ-analysis-obj SCROLLING.
     1936   DEFINE QUERY BROWSE-period FOR
     1937         x-XYZ-analysis-period SCROLLING.
     1938   DEFINE QUERY BROWSE-rez FOR
     1939         temp-rez SCROLLING.
     1940   DEFINE QUERY BROWSE-type-doc FOR
     1941         x-XYZ-analysis-doc SCROLLING.
     1942   DEFINE QUERY Dialog-Frame FOR
     1943         x-XYZ-analysis,
     1944         x-criterion-analysis SCROLLING.
     1945   DEFINE BROWSE BROWSE-obj
     1946     QUERY BROWSE-obj NO-LOCK DISPLAY
     1947         x-XYZ-analysis-obj.obj-type FORMAT "X(3)":U
     1948         x-XYZ-analysis-obj.obj-code FORMAT ">>>>>>>>9":U
     1949       WITH NO-ROW-MARKERS SEPARATORS MULTIPLE SIZE 13 BY 7.63
     1950            TITLE "Объекты" EXPANDABLE TOOLTIP "Объекты XYZ анализа".
     1951   DEFINE BROWSE BROWSE-period
     1952     QUERY BROWSE-period NO-LOCK DISPLAY
     1953         x-XYZ-analysis-period.XYZp-start COLUMN-LABEL "Начало" FORMAT "99/99/99":U
     1954         x-XYZ-analysis-period.XYZp-end COLUMN-LABEL "Конец" FORMAT "99/99/99":U
     1955       WITH NO-ROW-MARKERS SEPARATORS SIZE 20 BY 7.63
     1956            TITLE "Интервалы анализа" EXPANDABLE TOOLTIP "Интервалы анализа".
     1957   DEFINE BROWSE BROWSE-rez
     1958     QUERY BROWSE-rez DISPLAY
     1959         temp-rez.XYZ       COLUMN-LABEL "X!Y!Z"           FORMAT "x(5)"
     1960         temp-rez.Sum-cr    COLUMN-LABEL "Сумма!группы! "
     1961         temp-rez.Sum_prc   COLUMN-LABEL "Доля!группы! "
     1962         temp-rez.qnty      COLUMN-LABEL "Число!артик.!"
     1963         temp-rez.qnty_prc  COLUMN-LABEL "Распределение!номенклатуры!по группам"
     1964       WITH NO-ROW-MARKERS SEPARATORS MULTIPLE SIZE 54 BY 5.75 EXPANDABLE.
     1965   DEFINE BROWSE BROWSE-type-doc
     1966     QUERY BROWSE-type-doc NO-LOCK DISPLAY
     1967         f-name-doc ( buffer x-XYZ-analysis-doc) COLUMN-LABEL "Тип документа" FORMAT "x(22)":U
     1968       WITH NO-ROW-MARKERS SEPARATORS SIZE 25 BY 7.63
     1969            TITLE "Типы документов" EXPANDABLE TOOLTIP "Типы документов анализа".
     1970   DEFINE FRAME Dialog-Frame
     1971        b-quit AT ROW 1 COL 1
     1972        B-exit AT ROW 1 COL 11
     1973        B-save-rang AT ROW 1 COL 26
     1974        B-save-doc-typd AT ROW 1 COL 42.5
     1975        B-rez AT ROW 1 COL 57.5
     1976        B-Help AT ROW 1 COL 87.5
