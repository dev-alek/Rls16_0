     1415   PROCEDURE find-def-analysis-obj :
     1416   define input  parameter p-type     as character no-undo .
     1417   define input  parameter p-obj-type as character no-undo .
     1418   define input  parameter p-obj-code as integer   no-undo .
     1419   define output parameter p-abc-id   as integer   no-undo .
     1420   define output parameter p-db-num   as integer   no-undo .
     1421     do
     1422     on error undo, return error return-value
     1423     :
     1424     if p-type = "abc"  then do:
     1425         define buffer buf_abc-analysis-obj for ub.abc-analysis-obj  .
     1426         define buffer buf_abc-analysis     for ub.abc-analysis      .
     1427         find first buf_abc-analysis-obj no-lock where
     1428                   buf_abc-analysis-obj.obj-type = p-obj-type and
     1429                   buf_abc-analysis-obj.obj-code = p-obj-code and
     1430                   buf_abc-analysis-obj.is-def   = true use-index objdef no-error .
     1431                   if available buf_abc-analysis-obj then do:
     1432                       p-abc-id = buf_abc-analysis-obj.abc-id .
     1433                       p-db-num = buf_abc-analysis-obj.db-num .
     1434                   end.
     1435                   else do:
     1436                       p-abc-id = 0 .
     1437                       p-db-num = 0.
     1438                       return "На объекте нет анализа по умолчанию" .
     1439                   end.
     1440     end.
     1441     if p-type = "xyz"  then do:
     1442         define buffer buf_xyz-analysis-obj for ub.xyz-analysis-obj  .
     1443         define buffer buf_xyz-analysis     for ub.xyz-analysis      .
     1444         find first buf_xyz-analysis-obj no-lock where
     1445                   buf_xyz-analysis-obj.obj-type = p-obj-type and
     1446                   buf_xyz-analysis-obj.obj-code = p-obj-code and
     1447                   buf_xyz-analysis-obj.is-def   = true use-index objdef no-error .
     1448                   if available buf_xyz-analysis-obj then do:
     1449                       p-abc-id = buf_xyz-analysis-obj.xyz-id .
     1450                       p-db-num = buf_xyz-analysis-obj.db-num .
     1451                   end.
     1452                   else do:
     1453                       p-abc-id = 0 .
     1454                       p-db-num = 0 .
     1455                       return "На объекте нет анализа по умолчанию" .
     1456                   end.
     1457     end.
     1458     return .
     1459   end.
     1460   END PROCEDURE.
     1461   procedure save-def-analysis-obj :
     1462   define input  parameter p-type     as character no-undo .
     1463   define input  parameter p-db-num   as integer   no-undo .
     1464   define input  parameter p-abc-id   as integer   no-undo .
     1465   define output parameter v-log      as logical   no-undo .
     1466     do
     1467     on error undo, return error return-value
     1468     :
     1469     v-log = true .
     1470     if p-type = "abc"  then do:
     1471         define buffer buf_abc-analysis-obj for ub.abc-analysis-obj  .
     1472         define buffer buf_abc-obj          for ub.abc-analysis-obj  .
     1473         define buffer buf_abc-analysis     for ub.abc-analysis      .
     1474         for each buf_abc-obj no-lock where
     1475                  buf_abc-obj.abc-id = p-abc-id and
     1476                  buf_abc-obj.db-num = p-db-num :
     1477               define variable v-exist    as logical   no-undo init false .
     1478               define variable v-list-anal as character no-undo init ""    .
     1479               for each  buf_abc-analysis-obj no-lock where
     1480                         not (buf_abc-analysis-obj.abc-id = p-abc-id and
     1481                              buf_abc-analysis-obj.db-num = p-db-num) and
     1482                         buf_abc-analysis-obj.is-def   = true   and
     1483                         buf_abc-analysis-obj.obj-type = buf_abc-obj.obj-type and
     1484                         buf_abc-analysis-obj.obj-code = buf_abc-obj.obj-code
     1485                         :
     1486                   v-exist    = true .
     1487                   v-list-anal = string( buf_abc-analysis-obj.abc-id ) + "," .
     1488               end.
     1489               if v-exist then do:
     1490                   message "На объекте "
     1491                   buf_abc-obj.obj-type
     1492                   buf_abc-obj.obj-code
     1493                   skip
     1494                   "уже есть анализы по умолчанию , их внутренние номера :" skip
     1495                   v-list-anal                                              skip
     1496                   "Сделать по умолчанию анализ текущий " p-abc-id " ?"
     1497                   view-as alert-box question
     1498                   buttons yes-no update v-log .
     1499                   if v-log then do:
     1500                       for each  buf_abc-analysis-obj exclusive-lock where
     1501                                 buf_abc-analysis-obj.obj-type = buf_abc-obj.obj-type and
     1502                                 buf_abc-analysis-obj.obj-code = buf_abc-obj.obj-code :
     1503                         if ( buf_abc-analysis-obj.abc-id = p-abc-id and
     1504                              buf_abc-analysis-obj.db-num = p-db-num ) then
     1505                                 buf_abc-analysis-obj.is-def   = true .
     1506                         else buf_abc-analysis-obj.is-def   = false  .
     1507                       end.
     1508                   end.
     1509               end.
     1510               else do:
     1511                 for each  buf_abc-analysis-obj exclusive-lock where
     1512                           buf_abc-analysis-obj.obj-type = buf_abc-obj.obj-type and
     1513                           buf_abc-analysis-obj.obj-code = buf_abc-obj.obj-code and
     1514                           buf_abc-analysis-obj.abc-id = p-abc-id and
     1515                           buf_abc-analysis-obj.db-num = p-db-num
     1516                           :
     1517                     buf_abc-analysis-obj.is-def   = true .
     1518                 end.
     1519               end.
     1520         end.
     1521     end.
     1522     if p-type = "xyz"  then do:
     1523         define buffer buf_xyz-analysis-obj for ub.xyz-analysis-obj  .
     1524         define buffer buf_xyz-obj          for ub.xyz-analysis-obj  .
     1525         define buffer buf_xyz-analysis     for ub.xyz-analysis      .
     1526         for each buf_xyz-obj no-lock where
     1527                  buf_xyz-obj.xyz-id = p-abc-id and
     1528                  buf_xyz-obj.db-num = p-db-num :
     1529               v-exist = false .
     1530               v-list-anal = ""    .
     1531               for each  buf_xyz-analysis-obj no-lock where
     1532                         not (buf_xyz-analysis-obj.xyz-id = p-abc-id and
     1533                              buf_xyz-analysis-obj.db-num = p-db-num) and
     1534                         buf_xyz-analysis-obj.is-def   = true   and
     1535                         buf_xyz-analysis-obj.obj-type = buf_xyz-obj.obj-type and
     1536                         buf_xyz-analysis-obj.obj-code = buf_xyz-obj.obj-code
     1537                         :
     1538                   v-exist    = true .
     1539                   v-list-anal = string( buf_xyz-analysis-obj.xyz-id ) + "," .
     1540               end.
     1541               if v-exist then do:
     1542                   message "На объекте "
     1543                   buf_xyz-obj.obj-type
     1544                   buf_xyz-obj.obj-code
     1545                   skip
     1546                   "уже есть анализы по умолчанию , их внутренние номера :" skip
     1547                   v-list-anal                                              skip
     1548                   "Сделать по умолчанию анализ текущий " p-abc-id " ?"
     1549                   view-as alert-box question
     1550                   buttons yes-no update v-log .
     1551                   if v-log then do:
     1552                       for each  buf_xyz-analysis-obj exclusive-lock where
     1553                                 buf_xyz-analysis-obj.obj-type = buf_xyz-obj.obj-type and
     1554                                 buf_xyz-analysis-obj.obj-code = buf_xyz-obj.obj-code :
     1555                         if ( buf_xyz-analysis-obj.xyz-id = p-abc-id and
     1556                              buf_xyz-analysis-obj.db-num = p-db-num ) then
     1557                                 buf_xyz-analysis-obj.is-def   = true .
     1558                         else buf_xyz-analysis-obj.is-def   = false  .
     1559                       end.
     1560                   end.
     1561               end.
     1562               else do:
     1563                 for each  buf_xyz-analysis-obj exclusive-lock where
     1564                           buf_xyz-analysis-obj.obj-type = buf_xyz-obj.obj-type and
     1565                           buf_xyz-analysis-obj.obj-code = buf_xyz-obj.obj-code and
     1566                           buf_xyz-analysis-obj.xyz-id = p-abc-id and
     1567                           buf_xyz-analysis-obj.db-num = p-db-num
     1568                           :
     1569                     buf_xyz-analysis-obj.is-def   = true .
     1570                 end.
     1571               end.
     1572         end.
     1573     end.
     1574   end.
     1575   end procedure.
     1576   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1577     define variable v-cntxt-db-num        as integer   no-undo .
     1578     define variable v-cntxt-userid        as character no-undo .
     1579     define variable v-cntxt-level         as character no-undo .
     1580     define variable v-cntxt-host-code-obj as integer   no-undo .
     1581     define variable v-cntxt-obj-type      as character no-undo .
     1582     define variable v-cntxt-obj-code      as integer   no-undo .
     1583     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1584     define variable v-cntxt-is-admin      as logical   no-undo .
     1585   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1586   define temp-table userobjs_temp-user-obj no-undo
     1587     field obj-type as character
     1588     field obj-code as integer
     1589     index xpk is primary unique obj-type obj-code
     1590     .
     1591   procedure userobjs_clear :
     1592     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1593     do
     1594     on error undo, return error return-value
     1595     :
     1596       for each buf_userobjs_temp-user-obj
     1597       on error undo, return error return-value
     1598       :
     1599         delete buf_userobjs_temp-user-obj .
     1600       end.
     1601     end.
     1602   end .
     1603   procedure userobjs_object-count :
     1604     define output parameter p-total-count as integer   no-undo .
     1605     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1606     do
     1607     on error undo, return error return-value
     1608     :
     1609       assign
     1610         p-total-count = 0
     1611       .
     1612       for each buf_userobjs_temp-user-obj
     1613       on error undo, return error return-value
     1614       :
     1615         assign
     1616           p-total-count = p-total-count + 1
     1617         .
     1618       end.
     1619     end.
     1620   end.
     1621   procedure userobjs_append :
     1622      define input  parameter p-obj-type as character no-undo .
     1623      define input  parameter p-obj-code as integer   no-undo .
     1624     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1625     do
     1626     on error undo, return error return-value
     1627     :
     1628       find first buf_userobjs_temp-user-obj
     1629         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1630           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1631         no-error .
     1632       if not available buf_userobjs_temp-user-obj
     1633       then do:
     1634         create buf_userobjs_temp-user-obj .
     1635         assign
     1636           buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1637           buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1638         .
     1639       end.
     1640     end.
     1641   end.
     1642   procedure userobjs_object-exist :
     1643     define output parameter p-object-exist as logical   no-undo .
     1644     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1645     do
     1646     on error undo, return error return-value
     1647     :
     1648       find first buf_userobjs_temp-user-obj
     1649         no-error .
     1650       if not available buf_userobjs_temp-user-obj
     1651       then do:
     1652         assign
     1653           p-object-exist = false
     1654         .
     1655       end.
     1656       else do:
     1657         assign
     1658           p-object-exist = true
     1659         .
     1660       end.
     1661     end.
     1662   end.
     1663   procedure userobjs_transfer :
     1664     define input  parameter p-callback-handle as handle no-undo .
     1665     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
     1666     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1667     do
     1668     on error undo, return error return-value
     1669     :
     1670       if valid-handle(p-callback-handle) <> true
     1671       then do:
     1672         message
     1673           vss-workfile vss-revision vss-description skip
     1674           "Ошибка задания входных параметров" skip
     1675           "Неизвестный указатель на процедуру" skip
     1676           view-as alert-box error .
     1677         undo, return error return-value .
     1678       end.
     1679       if p-callback-handle :get-signature("userobjs_append") = ""
     1680       then do:
     1681         message
     1682           vss-workfile vss-revision vss-description skip
     1683           "Ошибка задания входных параметров" skip
     1684           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
     1685                     ,p-callback-handle :file-name
     1686                     ) skip
     1687           view-as alert-box error .
     1688         undo, return error return-value .
     1689       end.
     1690       for each buf_userobjs_temp-user-obj
     1691       on error undo, return error return-value
     1692       :
     1693         run userobjs_append in p-callback-handle
     1694           (input  buf_userobjs_temp-user-obj.obj-type
     1695           ,input  buf_userobjs_temp-user-obj.obj-code
     1696           ) .
     1697       end.
     1698     end.
     1699   end procedure.
     1700   procedure userobjs_select-one :
     1701      define input  parameter parparentproc     as widget-handle no-undo .
     1702      define input  parameter p-db-num          as integer   no-undo .
     1703      define input  parameter p-user-id         as character no-undo .
     1704      define input  parameter p-host-code-obj   as integer   no-undo .
     1705      define input  parameter p-obj-type        as character no-undo .
     1706      define input  parameter p-obj-code        as integer   no-undo .
     1707      define output parameter p-user-select     as logical   no-undo .
     1708      define output parameter p-select-obj-type as character no-undo .
     1709      define output parameter p-select-obj-code as character no-undo .
     1710     do
     1711     on error undo, return error return-value
     1712     :
     1713       run gbl/userobjs.w
     1714         (input  parparentproc
     1715         ,input  this-procedure :handle
     1716         ,input  p-db-num
     1717         ,input  p-user-id
     1718         ,input  p-host-code-obj
     1719         ,input  p-obj-type
     1720         ,input  p-obj-code
     1721         ,INPUT  "b-sel"
     1722         ,output p-user-select
     1723         ,output p-select-obj-type
     1724         ,output p-select-obj-code
     1725         ) .
     1726     end.
     1727   end.
     1728   procedure userobjs_select-many :
     1729     define input  parameter parparentproc   as widget-handle no-undo .
     1730     define input  parameter p-db-num        as integer   no-undo .
     1731     define input  parameter p-user-id       as character no-undo .
     1732     define input  parameter p-host-code-obj as integer   no-undo .
     1733     define input  parameter p-obj-type      as character no-undo .
     1734     define input  parameter p-obj-code      as integer   no-undo .
     1735     define output parameter p-user-select   as logical   no-undo .
     1736     define variable v-select-obj-type as character no-undo .
     1737     define variable v-select-obj-code as integer   no-undo .
     1738     do
     1739     on error undo, return error return-value
     1740     :
     1741       run gbl/userobjs.w
     1742         (input  parparentproc
     1743         ,input  this-procedure :handle
     1744         ,input  p-db-num
     1745         ,input  p-user-id
     1746         ,input  p-host-code-obj
     1747         ,input  p-obj-type
     1748         ,input  p-obj-code
     1749         ,INPUT  "b-sel,b-mark"
     1750         ,output p-user-select
     1751         ,output v-select-obj-type
     1752         ,output v-select-obj-code
     1753         ) .
     1754     end.
     1755   end.
     1756   procedure thobjs :
     1757      define input        parameter parparentproc     as widget-handle no-undo .
     1758      define input        parameter i-bttns           as character     no-undo .
     1759      define input        parameter i-list-mode       as character     no-undo.
     1760      define input        parameter i-obj-type        as character     no-undo.
     1761      define input        parameter i-db-num          as integer       no-undo.
     1762      define input        parameter i-host-code       as integer       no-undo.
     1763      define input-output parameter p-rid-list        as character     no-undo .
     1764   run ref/thobjs.p
     1765           ( input parparentproc
     1766            ,input  this-procedure :handle
     1767           , input i-bttns
     1768           , input i-list-mode
     1769           , input i-obj-type
     1770           , input i-db-num
     1771           , input i-host-code
     1772           , input-output p-rid-list ) no-error .
     1773   end.
     1774   procedure proc-alt-shift-f2:
     1775     if not ibs.th.gbl.gbl-var:rcode
     1776   then
     1777     run gbl\inidebug.p .
     1778   end.
     1779   procedure proc-alt-shift-f3:
     1780     run gbl/prvssinf.p
     1781       ( input this-procedure
     1782       ) .
     1783   end.
     1784   define variable v-inform-launched as logical no-undo initial false .
     1785   procedure proc-alt-shift-f4:
     1786     define variable v-action as character no-undo .
     1787     if v-inform-launched = false then do:
     1788       assign
     1789         v-inform-launched = true
     1790       .
     1791       run gbl/d-inform.w
     1792         (  input self
     1793         ,  input this-procedure
     1794         , output v-action
     1795         ) no-error .
     1796       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1797       assign
     1798         v-inform-launched = false
     1799       .
     1800     end.
     1801   end.
     1802   procedure proc-alt-f1:
     1803     run gbl/corrhelp.p
     1804       (input this-procedure
     1805       ) .
     1806   end .
     1807   on alt-shift-f2 anywhere do:
     1808     run proc-alt-shift-f2.
     1809   end.
     1810   on alt-shift-f3 anywhere do:
     1811     run proc-alt-shift-f3 in this-procedure .
     1812   end.
     1813   on alt-shift-f4 anywhere do:
     1814     run proc-alt-shift-f4 in this-procedure.
     1815   end.
     1816   on alt-f1 anywhere do:
     1817     run proc-alt-f1 in this-procedure .
     1818   end.
     1819   define variable p-rid-list    as  char no-undo .
     1820   define variable mark-str  AS CHARACTER NO-UNDO.
