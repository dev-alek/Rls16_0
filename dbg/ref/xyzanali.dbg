       87   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       89   define new shared variable RepPathName        as character no-undo .
