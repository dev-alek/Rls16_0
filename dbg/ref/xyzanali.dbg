      387       on error undo, return error
      388       :
      389       run prn-lib-get-report-name  in this-procedure (
      390         input parParentProc
      391         ,output v-report-name
      392         ).
      393   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      394   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      395     (input  v-report-name
      396     ,input  2
      397     ,output v-exist
      398     )  .
      399       if NOT v-exist then
      400       DO:
      401         Message
      402           "Нет заданий на печать ! "
      403           view-as alert-box .
      404         Return  .
      405       End.
      406       run gbl/prnfilen.w
      407         (input  ""
      408         ,input  p-DisabledOptions
      409         ,input  string(v-report-name )
      410         ,input  7
      411         ,output v-user-action
      412         ,output v-printed
      413         ) .
      414       if v-printed then
