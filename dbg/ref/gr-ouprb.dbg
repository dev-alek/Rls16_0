        1   define input  parameter parparentproc as handle no-undo .
        2   define input  parameter p-mode as character no-undo .
        3   define input  parameter p-db-num  as integer   no-undo .
        4   define input  parameter p-id     as integer   no-undo .
        5   define input  parameter p-name as character no-undo .
        6   define input-output parameter p-recid as recid no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Добавление и корректировка состава группы оборотов".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   procedure proc-alt-shift-f2:
       74     if not ibs.th.gbl.gbl-var:rcode
       75   then
       76     run gbl\inidebug.p .
       77   end.
       78   procedure proc-alt-shift-f3:
       79     run gbl/prvssinf.p
       80       ( input this-procedure
       81       ) .
       82   end.
       83   define variable v-inform-launched as logical no-undo initial false .
       84   procedure proc-alt-shift-f4:
       85     define variable v-action as character no-undo .
       86     if v-inform-launched = false then do:
       87       assign
       88         v-inform-launched = true
       89       .
       90       run gbl/d-inform.w
       91         (  input self
       92         ,  input this-procedure
       93         , output v-action
       94         ) no-error .
       95       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       96       assign
       97         v-inform-launched = false
       98       .
       99     end.
      100   end.
      101   procedure proc-alt-f1:
      102     run gbl/corrhelp.p
      103       (input this-procedure
      104       ) .
      105   end .
      106   on alt-shift-f2 anywhere do:
      107     run proc-alt-shift-f2.
      108   end.
      109   on alt-shift-f3 anywhere do:
      110     run proc-alt-shift-f3 in this-procedure .
      111   end.
      112   on alt-shift-f4 anywhere do:
      113     run proc-alt-shift-f4 in this-procedure.
      114   end.
      115   on alt-f1 anywhere do:
      116     run proc-alt-f1 in this-procedure .
      117   end.
      118   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      119     define variable v-cntxt-db-num        as integer   no-undo .
      120     define variable v-cntxt-userid        as character no-undo .
      121     define variable v-cntxt-level         as character no-undo .
      122     define variable v-cntxt-host-code-obj as integer   no-undo .
      123     define variable v-cntxt-obj-type      as character no-undo .
      124     define variable v-cntxt-obj-code      as integer   no-undo .
      125     define variable v-cntxt-db-num-obj    as integer   no-undo .
      126     define variable v-cntxt-is-admin      as logical   no-undo .
      127   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      128     run mainmenu_getcntxt in parparentproc
      129       (output v-cntxt-db-num
      130       ,output v-cntxt-userid
      131       ,output v-cntxt-level
      132       ,output v-cntxt-host-code-obj
      133       ,output v-cntxt-obj-type
      134       ,output v-cntxt-obj-code
      135       ,output v-cntxt-db-num-obj
      136       ,output v-cntxt-is-admin
      137       ) .
      138   PROCEDURE oio-ADD :
      139   define input  parameter p-db-num       as integer   no-undo .
      140   define input  parameter p-id           as integer   no-undo .
      141   define input  parameter p-ttg-summa    as decimal   no-undo .
      142   define input  parameter p-use-discnt           as logical   no-undo .
      143   define input  parameter p-discnt-pc            as decimal   no-undo .
      144   define input  parameter p-discnt-method-round  as character no-undo .
      145   define input  parameter p-stts         as integer   no-undo .
      146   define input  parameter p-db-num-usr   as integer   no-undo .
      147   define input  parameter p-userid       as character no-undo .
      148   define output parameter p-recid as recid no-undo .
      149     do
      150     on error undo, return error return-value
      151     :
      152   find first ub.tnv-in-turnover-group exclusive-lock where
      153           ub.tnv-in-turnover-group.tog-db-num   = p-db-num  and
      154           ub.tnv-in-turnover-group.tog-id       = p-id      and
      155           ub.tnv-in-turnover-group.ttg-summa    = p-ttg-summa
      156           no-error .
      157         if not available ub.tnv-in-turnover-group then do:
      158             create ub.tnv-in-turnover-group.
      159               assign
      160                   ub.tnv-in-turnover-group.tog-db-num          = p-db-num
      161                   ub.tnv-in-turnover-group.tog-id              = p-id
      162                   ub.tnv-in-turnover-group.ttg-summa           = p-ttg-summa
      163                   ub.tnv-in-turnover-group.use-discnt          = p-use-discnt
      164                   ub.tnv-in-turnover-group.discnt-pc           = p-discnt-pc
      165                   ub.tnv-in-turnover-group.discnt-method-round = p-discnt-method-round
      166               .
      167         end.
      168         assign
      169           ub.tnv-in-turnover-group.db-num-chg    = p-db-num-usr
      170           ub.tnv-in-turnover-group.stts          = p-stts
      171           ub.tnv-in-turnover-group.sys-date      = today
      172           ub.tnv-in-turnover-group.sys-time      = time
      173           ub.tnv-in-turnover-group.sys-time-chr  = string ( ub.tnv-in-turnover-group.sys-time,"hh:mm" )
      174           ub.tnv-in-turnover-group.who           = p-userid
      175           p-recid = recid ( ub.tnv-in-turnover-group )
      176         .
      177     end.
      178   end procedure.
      179   PROCEDURE oio-DEL :
      180   define input  parameter p-db-num       as integer   no-undo .
      181   define input  parameter p-id           as integer   no-undo .
      182   define input  parameter p-ttg-summa     as decimal   no-undo .
      183   define input  parameter p-db-num-usr   as integer   no-undo .
      184   define input  parameter p-userid       as character no-undo .
      185     do
      186     on error undo, return error return-value
      187     :
      188   find first ub.tnv-in-turnover-group exclusive-lock where
      189           ub.tnv-in-turnover-group.tog-db-num   = p-db-num  and
      190           ub.tnv-in-turnover-group.tog-id       = p-id      and
      191           ub.tnv-in-turnover-group.ttg-summa = p-ttg-summa
      192           no-error .
      193    if not available ub.tnv-in-turnover-group then  return error .
      194         assign
      195           ub.tnv-in-turnover-group.db-num-chg    = p-db-num-usr
      196           ub.tnv-in-turnover-group.stts          = 1
      197           ub.tnv-in-turnover-group.sys-date      = today
      198           ub.tnv-in-turnover-group.sys-time      = time
      199           ub.tnv-in-turnover-group.sys-time-chr  = string(ub.tnv-in-turnover-group.sys-time,"hh:mm")
      200           ub.tnv-in-turnover-group.who           = p-userid
      201         .
      202     end.
      203   end procedure.
      204   PROCEDURE oio-update :
      205   define input  parameter p-recid       as recid no-undo .
      206   define input  parameter p-db-num       as integer   no-undo .
      207   define input  parameter p-id           as integer   no-undo .
      208   define input  parameter p-ttg-summa    as decimal   no-undo .
      209   define input  parameter p-use-discnt           as logical   no-undo .
      210   define input  parameter p-discnt-pc            as decimal   no-undo .
      211   define input  parameter p-discnt-method-round  as character no-undo .
      212   define input  parameter p-stts         as integer   no-undo .
      213   define input  parameter p-db-num-usr   as integer   no-undo .
      214   define input  parameter p-userid       as character no-undo .
      215     do
      216     on error undo, return error return-value
      217     :
      218   find first ub.tnv-in-turnover-group exclusive-lock where
      219           recid(ub.tnv-in-turnover-group) = p-recid
      220           no-error .
      221         if not available ub.tnv-in-turnover-group then do:
      222             create ub.tnv-in-turnover-group.
      223               assign
      224                   ub.tnv-in-turnover-group.tog-db-num          = p-db-num
      225                   ub.tnv-in-turnover-group.tog-id              = p-id
      226                   ub.tnv-in-turnover-group.ttg-summa           = p-ttg-summa
      227                   ub.tnv-in-turnover-group.use-discnt          = p-use-discnt
      228                   ub.tnv-in-turnover-group.discnt-pc           = p-discnt-pc
      229                   ub.tnv-in-turnover-group.discnt-method-round = p-discnt-method-round
      230               .
      231         end.
      232         assign
      233           ub.tnv-in-turnover-group.tog-db-num          = p-db-num
      234           ub.tnv-in-turnover-group.tog-id              = p-id
      235           ub.tnv-in-turnover-group.ttg-summa           = p-ttg-summa
      236           ub.tnv-in-turnover-group.use-discnt          = p-use-discnt
      237           ub.tnv-in-turnover-group.discnt-pc           = p-discnt-pc
      238           ub.tnv-in-turnover-group.discnt-method-round = p-discnt-method-round
      239           ub.tnv-in-turnover-group.db-num-chg    = p-db-num-usr
      240           ub.tnv-in-turnover-group.stts          = p-stts
      241           ub.tnv-in-turnover-group.sys-date      = today
      242           ub.tnv-in-turnover-group.sys-time      = time
      243           ub.tnv-in-turnover-group.sys-time-chr  = string ( ub.tnv-in-turnover-group.sys-time,"hh:mm" )
      244           ub.tnv-in-turnover-group.who           = p-userid
      245         .
      246     end.
      247   end procedure.
      248   DEFINE BUTTON B-Cancel AUTO-END-KEY
      249        LABEL "Отмена"
      250        SIZE 10 BY 1
      251        BGCOLOR 8 .
      252   DEFINE BUTTON B-Help
      253        LABEL "Помо&щь"
      254        SIZE 10 BY 1
      255        BGCOLOR 8 .
      256   DEFINE BUTTON B-save AUTO-GO
      257        LABEL "Ввод"
      258        SIZE 10 BY 1
      259        BGCOLOR 8 .
      260   DEFINE VARIABLE rubl AS CHARACTER FORMAT "X(256)":U
      261         VIEW-AS TEXT
      262        SIZE 19.5 BY .67
      263        FGCOLOR 4  NO-UNDO.
      264   DEFINE VARIABLE V-discnt-method-round LIKE ub.tnv-in-turnover-group.discnt-method-round
      265        LABEL "Метод округления по скидке"
      266        VIEW-AS FILL-IN
      267        SIZE 25 BY 1 NO-UNDO.
      268   DEFINE VARIABLE v-discnt-pc LIKE ub.tnv-in-turnover-group.discnt-pc
      269        LABEL "Процент скидки"
      270        VIEW-AS FILL-IN
      271        SIZE 7 BY 1 NO-UNDO.
      272   DEFINE VARIABLE v-name LIKE ub.turnover-group.name
      273        LABEL "Группа"
      274         VIEW-AS TEXT
      275        SIZE 76.5 BY .67
      276        FGCOLOR 1  NO-UNDO.
      277   DEFINE VARIABLE v-ttg-summa LIKE ub.tnv-in-turnover-group.ttg-summa
      278        LABEL "Оборот покупателей"
      279        VIEW-AS FILL-IN
      280        SIZE 26.5 BY 1 NO-UNDO.
      281   DEFINE VARIABLE v-use-d AS LOGICAL INITIAL no
      282        LABEL "Использовать скидку"
      283        VIEW-AS TOGGLE-BOX
      284        SIZE 28 BY .83 NO-UNDO.
      285   DEFINE QUERY Dialog-Frame FOR
      286         ub.tnv-in-turnover-group SCROLLING.
      287   DEFINE FRAME Dialog-Frame
      288        B-save AT ROW 1 COL 1
      289        B-Cancel AT ROW 1 COL 11
      290        B-Help AT ROW 1 COL 77
      291        v-ttg-summa AT ROW 4.75 COL 33.5 COLON-ALIGNED HELP
      292             ""
      293             LABEL "Оборот покупателей" FORMAT ">>>,>>>,>>>,>>9.99"
      294        v-use-d AT ROW 5.75 COL 35.5
      295        v-discnt-pc AT ROW 6.75 COL 33.5 COLON-ALIGNED HELP
      296             ""
      297             LABEL "Процент скидки" FORMAT ">>9.99"
      298        V-discnt-method-round AT ROW 7.92 COL 33.5 COLON-ALIGNED HELP
      299             ""
      300             LABEL "Метод округления по скидке" FORMAT "X(28)"
      301        v-name AT ROW 3 COL 7.5 COLON-ALIGNED HELP
      302             ""
      303             LABEL "Группа" FORMAT "X(80)"
      304             FGCOLOR 1
      305        rubl AT ROW 4.92 COL 61 COLON-ALIGNED NO-LABEL
      306        "%" VIEW-AS TEXT
      307             SIZE 1.75 BY 1 AT ROW 6.75 COL 43.25
      308             FGCOLOR 4
      309        SPACE(42.49) SKIP(3.28)
      310       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      311            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      312            TITLE "Добавление Оборота покупателей "
      313            DEFAULT-BUTTON B-save CANCEL-BUTTON B-Cancel.
      314   ASSIGN
      315          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      316          FRAME Dialog-Frame:HIDDEN           = TRUE.
      317   ASSIGN
      318          V-discnt-method-round:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      319   ASSIGN
      320          v-use-d:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      321   ON GO OF FRAME Dialog-Frame
      322   DO:
      323     run save-proc in this-procedure no-error .
      324     if error-status :error then do:
      325        return no-apply .
      326     end.
      327   END.
      328   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      329   DO:
      330     APPLY "END-ERROR":U TO SELF.
      331   END.
      332   ON VALUE-CHANGED OF v-use-d IN FRAME Dialog-Frame
      333   DO:
      334     ASSIGN v-use-d .
      335     IF v-use-d  THEN DO:
      336        ENABLE v-discnt-pc WITH FRAME Dialog-Frame.
      337     END.
      338     ELSE DO:
      339         v-discnt-pc = 0 .
      340         DISABLE v-discnt-pc WITH FRAME Dialog-Frame.
      341     END.
      342   END.
      343   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      344   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      345   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      346   on help of frame Dialog-Frame
      347   do:
      348     run gbl/app_help.p
      349       (input this-procedure :file-name
      350       ,input ''
      351       ,input ?
      352       ) no-error.
      353     if error-status :error then do:
      354       message
      355         "Ошибка при вызове помощи"
      356         error-status :get-message(1)
      357         view-as alert-box .
      358     end.
      359   end.
      360   run minbtn-set in this-procedure .
      361   on choose of b-help in frame Dialog-Frame
      362   do:
      363     apply "help":u to frame Dialog-Frame .
      364   end.
      365   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      366   procedure minbtn-set :
      367       do
      368           on error undo, return error return-value
      369           :
      370           define variable ii              as integer       no-undo .
      371           define variable fh              as widget-handle no-undo .
      372           define variable hh              as widget-handle no-undo .
      373           define variable v-h             as handle        extent 4 no-undo .
      374           define variable v-name-button   as character     no-undo .
      375           define variable v-help-old-x    as decimal       no-undo .
      376           define variable v-help-old-y    as decimal       no-undo .
      377           define variable v-help-old-size as decimal       no-undo .
      378           define variable v-frame-width   as decimal       no-undo .
      379           define variable jj              as integer       no-undo .
      380           do
      381               on error undo, return error
      382               :
      383               assign
      384                   v-frame-width = frame Dialog-Frame:width - 0.3
      385                   fh            = frame Dialog-Frame:first-child
      386                   hh            = fh:first-child
      387                   ii            = 1
      388                   .
      389               do while valid-handle(hh):
      390                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      391                   do:
      392                       case lc(hh:name) :
      393                           when "b-help" then
      394                               do:
      395                                   hh:load-image-up("cmp/b-help.bmp":u) .
      396                                   hh:load-image-down("cmp/b-help.bmp":u) .
      397                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      398                                   hh:TOOLTIP = "Помощь" .
      399                                   v-help-old-x = hh:column .
      400                                   v-help-old-y = hh:row    .
      401                                   v-help-old-size = hh:width .
      402                                   hh:width-chars = 2.5 .
      403                               end.
      404                           when "b-print" then
      405                               do:
      406                                   hh:load-image("cmp/b-print.bmp":u) .
      407                                   hh:TOOLTIP = "Печать" .
      408                                   v-h[ii] = hh:handle .
      409                                   ii = ii + 1 .
      410                                   hh:width-chars = 3 .
      411                               end.
      412                           when "b-history" or
      413                           when "b-hist" then
      414                               do:
      415                                   hh:load-image("cmp/b-hist.bmp":u) .
      416                                   hh:TOOLTIP = "История" .
      417                                   v-h[ii] = hh:handle .
      418                                   ii = ii + 1 .
      419                                   hh:width-chars = 3 .
      420                               end.
      421                           when "b-sch" then
      422                               do:
      423                                   hh:load-image("cmp/b-sch.bmp":u) .
      424                                   hh:TOOLTIP = "Установка Фильтра" .
      425                                   v-h[ii] = hh:handle .
      426                                   ii = ii + 1 .
      427                                   hh:width-chars = 3 .
      428                               end.
      429                           when "b-hist-user" then
      430                               do:
      431                                   hh:load-image("cmp/b-hist.bmp":u) .
      432                                   hh:TOOLTIP = "История пользователя" .
      433                                   ii = ii + 1 .
      434                               end.
      435                       end case.
      436                   end.
      437                   hh = hh:next-sibling.
      438               end.
      439               b-help:column = v-frame-width - b-help:width-chars.
      440               jj = 0.
      441               repeat ii = 4 to 1 by -1 :
      442                   if valid-handle (v-h[ii] ) then
      443                   do:
      444                       jj  = jj + 1 .
      445                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      446                       v-h[ii]:row    = v-help-old-y .
      447                   end.
      448               end.
      449           end.
      450       end.
      451   end procedure.
      452   MAIN-BLOCK:
      453   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      454      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      455     run init-proc in this-procedure .
      456     run enable_ui in this-procedure .
      457     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      458        disable v-ttg-summa with frame Dialog-Frame.
      459        WAIT-FOR GO OF FRAME Dialog-Frame FOCUS v-discnt-pc .
      460     end.
      461     else do:
      462        WAIT-FOR GO OF FRAME Dialog-Frame FOCUS v-ttg-summa .
      463     end.
      464   END.
      465   run disable_ui in this-procedure .
      466   PROCEDURE disable_UI :
      467     HIDE FRAME Dialog-Frame.
      468   END PROCEDURE.
      469   PROCEDURE enable_UI :
      470     OPEN QUERY Dialog-Frame FOR EACH ub.tnv-in-turnover-group SHARE-LOCK.
      471     GET FIRST Dialog-Frame.
      472     DISPLAY v-ttg-summa v-discnt-pc v-name rubl
      473         WITH FRAME Dialog-Frame.
      474     ENABLE B-save B-Cancel B-Help v-ttg-summa v-discnt-pc v-name rubl
      475         WITH FRAME Dialog-Frame.
      476     VIEW FRAME Dialog-Frame.
      477   END PROCEDURE.
      478   PROCEDURE init-proc :
      479     v-name = p-name .
      480     rubl = "РУБ" .
      481   define buffer buf_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
      482     if p-mode = 'ИЗМЕНЕНИЕ':U  then do:
      483     find first buf_tnv-in-turnover-group no-lock where recid(buf_tnv-in-turnover-group) = p-recid no-error .
      484     if not available buf_tnv-in-turnover-group then
      485     message
      486       vss-workfile vss-revision vss-description skip
      487       error-status :get-message(1) skip
      488       return-value skip
      489       "Ошибка "
      490       view-as alert-box error
      491     .
      492     assign
      493      v-ttg-summa  =  buf_tnv-in-turnover-group.ttg-summa
      494      v-use-d      =  buf_tnv-in-turnover-group.use-discnt
      495      v-discnt-pc  =  buf_tnv-in-turnover-group.discnt-pc
      496      V-discnt-method-round =  buf_tnv-in-turnover-group.discnt-method-round
      497     .
      498     end.
      499   END PROCEDURE.
      500   PROCEDURE save-proc :
      501   ASSIGN frame Dialog-Frame
      502       V-discnt-method-round
      503       v-discnt-pc
      504       v-ttg-summa
      505       v-use-d
      506        .
      507   if v-discnt-pc >= 100 then do:
      508      message "Процент не может быть 100 и выше !"  view-as alert-box error .
      509      return error return-value .
      510   end.
      511   if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      512       run oio-ADD in this-procedure (
      513           input  p-db-num      ,
      514           input  p-id          ,
      515           input  v-ttg-summa   ,
      516           input  v-use-d  ,
      517           input  v-discnt-pc   ,
      518           input  v-discnt-method-round,
      519           input  0        ,
      520           input  v-cntxt-db-num  ,
      521           input  v-cntxt-userid  ,
      522           output p-recid
      523           ).
      524    end.
      525    else do:
      526       run oio-update in this-procedure (
      527           input  p-recid       ,
      528           input  p-db-num      ,
      529           input  p-id          ,
      530           input  v-ttg-summa   ,
      531           input  v-use-d       ,
      532           input  v-discnt-pc   ,
      533           input  v-discnt-method-round,
      534           input  0               ,
      535           input  v-cntxt-db-num  ,
      536           input  v-cntxt-userid
      537           ).
      538    end.
      539   END PROCEDURE.
