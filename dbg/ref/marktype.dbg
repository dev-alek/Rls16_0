        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: c575f5acca55, 2347, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: ARostovtsev $":U .
        4   define variable vss-date        as character no-undo init "$Date: Ср июн 10 21:13:33 2020 +0300 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: marktype.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: rep/marktype.p $":U .
        7   define variable vss-description as character no-undo init "Форма изменения типа маркировки".
        8   SESSION:ERROR-STACK-TRACE=YES.
        9   DEFINE TEMP-TABLE tt_code NO-UNDO LIKE code.
       10   define input        parameter parparentproc as handle            no-undo.
       11   define input        parameter iMode         as character         no-undo.
       12   define input-output parameter iCode       like ub.code.code      no-undo.
       13   define input-output parameter iCodeValue  like ub.code.codevalue no-undo.
       14   define input-output parameter iCodeName   like ub.code.codename  no-undo.
       15   define input-output parameter iMisc1      like ub.code.misc1 no-undo.
       16   define input-output parameter iMisc2      like ub.code.misc2 no-undo.
       17   define input-output parameter iMisc3      like ub.code.misc3 no-undo.
       18   define input-output parameter iMisc4      like ub.code.misc4 no-undo.
       19   define output       parameter isUpdated     as logical       no-undo.
       20   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       21   define temp-table userobjs_temp-user-obj no-undo
       22     field obj-type as character
       23     field obj-code as integer
       24     index xpk is primary unique obj-type obj-code
       25     .
       26   procedure userobjs_clear :
       27     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       28     do
       29     on error undo, return error return-value
       30     :
       31       for each buf_userobjs_temp-user-obj
       32       on error undo, return error return-value
       33       :
       34         delete buf_userobjs_temp-user-obj .
       35       end.
       36     end.
       37   end .
       38   procedure userobjs_object-count :
       39     define output parameter p-total-count as integer   no-undo .
       40     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       41     do
       42     on error undo, return error return-value
       43     :
       44       assign
       45         p-total-count = 0
       46       .
       47       for each buf_userobjs_temp-user-obj
       48       on error undo, return error return-value
       49       :
       50         assign
       51           p-total-count = p-total-count + 1
       52         .
       53       end.
       54     end.
       55   end.
       56   procedure userobjs_append :
       57      define input  parameter p-obj-type as character no-undo .
       58      define input  parameter p-obj-code as integer   no-undo .
       59     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       60     do
       61     on error undo, return error return-value
       62     :
       63       find first buf_userobjs_temp-user-obj
       64         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
       65           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
       66         no-error .
       67       if not available buf_userobjs_temp-user-obj
       68       then do:
       69         create buf_userobjs_temp-user-obj .
       70         assign
       71           buf_userobjs_temp-user-obj.obj-type = p-obj-type
       72           buf_userobjs_temp-user-obj.obj-code = p-obj-code
       73         .
       74       end.
       75     end.
       76   end.
       77   procedure userobjs_object-exist :
       78     define output parameter p-object-exist as logical   no-undo .
       79     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       80     do
       81     on error undo, return error return-value
       82     :
       83       find first buf_userobjs_temp-user-obj
       84         no-error .
       85       if not available buf_userobjs_temp-user-obj
       86       then do:
       87         assign
       88           p-object-exist = false
       89         .
       90       end.
       91       else do:
       92         assign
       93           p-object-exist = true
       94         .
       95       end.
       96     end.
       97   end.
       98   procedure userobjs_transfer :
       99     define input  parameter p-callback-handle as handle no-undo .
      100     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      101     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      102     do
      103     on error undo, return error return-value
      104     :
      105       if valid-handle(p-callback-handle) <> true
      106       then do:
      107         message
      108           vss-workfile vss-revision vss-description skip
      109           "Ошибка задания входных параметров" skip
      110           "Неизвестный указатель на процедуру" skip
      111           view-as alert-box error .
      112         undo, return error return-value .
      113       end.
      114       if p-callback-handle :get-signature("userobjs_append") = ""
      115       then do:
      116         message
      117           vss-workfile vss-revision vss-description skip
      118           "Ошибка задания входных параметров" skip
      119           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      120                     ,p-callback-handle :file-name
      121                     ) skip
      122           view-as alert-box error .
      123         undo, return error return-value .
      124       end.
      125       for each buf_userobjs_temp-user-obj
      126       on error undo, return error return-value
      127       :
      128         run userobjs_append in p-callback-handle
      129           (input  buf_userobjs_temp-user-obj.obj-type
      130           ,input  buf_userobjs_temp-user-obj.obj-code
      131           ) .
      132       end.
      133     end.
      134   end procedure.
      135   procedure userobjs_select-one :
      136      define input  parameter parparentproc     as widget-handle no-undo .
      137      define input  parameter p-db-num          as integer   no-undo .
      138      define input  parameter p-user-id         as character no-undo .
      139      define input  parameter p-host-code-obj   as integer   no-undo .
      140      define input  parameter p-obj-type        as character no-undo .
      141      define input  parameter p-obj-code        as integer   no-undo .
      142      define output parameter p-user-select     as logical   no-undo .
      143      define output parameter p-select-obj-type as character no-undo .
      144      define output parameter p-select-obj-code as character no-undo .
      145     do
      146     on error undo, return error return-value
      147     :
      148       run gbl/userobjs.w
      149         (input  parparentproc
      150         ,input  this-procedure :handle
      151         ,input  p-db-num
      152         ,input  p-user-id
      153         ,input  p-host-code-obj
      154         ,input  p-obj-type
      155         ,input  p-obj-code
      156         ,INPUT  "b-sel"
      157         ,output p-user-select
      158         ,output p-select-obj-type
      159         ,output p-select-obj-code
      160         ) .
      161     end.
      162   end.
      163   procedure userobjs_select-many :
      164     define input  parameter parparentproc   as widget-handle no-undo .
      165     define input  parameter p-db-num        as integer   no-undo .
      166     define input  parameter p-user-id       as character no-undo .
      167     define input  parameter p-host-code-obj as integer   no-undo .
      168     define input  parameter p-obj-type      as character no-undo .
      169     define input  parameter p-obj-code      as integer   no-undo .
      170     define output parameter p-user-select   as logical   no-undo .
      171     define variable v-select-obj-type as character no-undo .
      172     define variable v-select-obj-code as integer   no-undo .
      173     do
      174     on error undo, return error return-value
      175     :
      176       run gbl/userobjs.w
      177         (input  parparentproc
      178         ,input  this-procedure :handle
      179         ,input  p-db-num
      180         ,input  p-user-id
      181         ,input  p-host-code-obj
      182         ,input  p-obj-type
      183         ,input  p-obj-code
      184         ,INPUT  "b-sel,b-mark"
      185         ,output p-user-select
      186         ,output v-select-obj-type
      187         ,output v-select-obj-code
      188         ) .
      189     end.
      190   end.
      191   procedure thobjs :
      192      define input        parameter parparentproc     as widget-handle no-undo .
      193      define input        parameter i-bttns           as character     no-undo .
      194      define input        parameter i-list-mode       as character     no-undo.
      195      define input        parameter i-obj-type        as character     no-undo.
      196      define input        parameter i-db-num          as integer       no-undo.
      197      define input        parameter i-host-code       as integer       no-undo.
      198      define input-output parameter p-rid-list        as character     no-undo .
      199   run ref/thobjs.p
      200           ( input parparentproc
      201            ,input  this-procedure :handle
      202           , input i-bttns
      203           , input i-list-mode
      204           , input i-obj-type
      205           , input i-db-num
      206           , input i-host-code
      207           , input-output p-rid-list ) no-error .
      208   end.
      209   define variable mMarkType as class ibs.th.ref.marktype no-undo .
      210   mMarkType = new ibs.th.ref.marktype (
      211                       parparentproc, iMode,
      212                       iCode, iCodeValue, iCodeName, iMisc1, iMisc2, iMisc3, iMisc4
      213                   ).
      214   wait-for  mMarkType:ShowDialog() .
      215   isUpdated = mMarkType:isUpdated.
      216   if isUpdated then
      217   do:
      218       assign
      219           iCode      = mMarkType:codeType
      220           iCodeValue = mMarkType:codeValue
      221           iCodeName  = mMarkType:codeName
      222           iMisc1     = mMarkType:codeMisc1
      223           iMisc2     = mMarkType:codeMisc2
      224           iMisc3     = mMarkType:codeMisc3
      225           iMisc4     = mMarkType:codeMisc4
      226       .
      227   end.
      228   define variable v-err-msg as character no-undo .
      229   catch exAppErrors as class Progress.Lang.AppError :
      230     v-err-msg = exAppErrors:ReturnValue .
      231     if v-err-msg > "" then .
      232     else
      233     do :
      234       v-err-msg = exAppErrors:GetMessage(1) .
      235       if v-err-msg > "" then .
      236       else v-err-msg = "AppError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ref\marktype.p" .
      237     end .
      238     message v-err-msg  view-as alert-box.
      239   end catch .
      240   catch exProErrors as class Progress.Lang.ProError :
      241     v-err-msg = exProErrors:GetMessage(1) .
      242     if v-err-msg > "" then .
      243     else v-err-msg = "ProError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ref\marktype.p" .
      244     message "ProError" skip(1) v-err-msg  view-as alert-box.
      245   end catch .
      246   catch exAnyErrors as class Progress.Lang.Error:
      247     v-err-msg = "Unexpected error в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ref\marktype.p " + exAnyErrors:GetMessage(1).
      248     message "LangError" skip(1) v-err-msg  view-as alert-box.
      249   end catch .
      250   finally:
      251     SESSION:ERROR-STACK-TRACE=no.
      252     if valid-object(mMarkType) then delete object mMarkType no-error .
      253   end finally.
