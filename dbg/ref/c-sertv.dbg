        1   block-level on error undo, throw.
        2   define input parameter p-cli-type like ub.c-sert.cli-type no-undo .
        3   define input parameter p-cli-code like ub.c-sert.cli-code no-undo .
        4   define input parameter p-sert-code like ub.c-sert.sert-code no-undo .
        5   define input parameter p-b-code    like ub.c-sert.b-code no-undo .
        6   define input parameter p-chip-num like ub.c-sert.chip-num no-undo .
        7   define input parameter p-corr-user-db-num like ub.c-sert.corr-user-db-num no-undo .
        8   define input parameter p-subject like ub.c-sert.subject no-undo .
        9   define input parameter p-action   like ub.c-sert.action no-undo .
       10   define input parameter p-silent  as logical no-undo .
       11   define output parameter p-description as character no-undo .
       12   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       13   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       14   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile: c-sertv.p $":U .
       16   define variable vss-archive     as character no-undo init "$Archive: ref/c-sertv.p $":U .
       17   define variable vss-description as character no-undo init "Заполнение временной таблицы для показа изменений по таблицам истории сертификата".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define variable v-chg-fields as character no-undo.
       77   define variable v-old-fields as character no-undo.
       78   define variable v-new-fields as character no-undo.
       79   define variable ii as integer no-undo.
       80   define variable v-mess as character no-undo .
       81   define buffer buf_c-sert for ub.c-sert.
       82   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   define SHARED temp-table temp-changes no-undo
       84   field f_name as character
       85   field l_name as character
       86   field v_old as character
       87   field v_new as character
       88   field t_name as character
       89   field num_ as integer
       90   field uniq-key-rec as character
       91   field action as integer
       92   field fNotChange as logical
       93   index pi is unique primary
       94   num_
       95   t_name
       96   f_name
       97   index
       98   Chan
       99   fnotChange
      100   t_name
      101   f_name
      102   index imain uniq-key-rec
      103   .
      104   FUNCTION get-all-fields returns character (p-file-name as character ):
      105   define variable v-dop as character no-undo .
      106     find first _file no-lock where _file._file-name = p-file-name no-error .
      107     if not available _file then return "":U.
      108     for each _field no-lock where
      109              _field._file-recid = recid(_file) :
      110       assign
      111       v-dop = v-dop + _field._field-name + chr(44)
      112       .
      113     end.
      114     return trim(v-dop).
      115   END FUNCTION.
      116   PROCEDURE proc-full-temp-changes :
      117     define input  parameter p-act-create as logical   no-undo .
      118     define input  parameter p-act-delete as logical   no-undo .
      119     define input  parameter p-hst-handle as handle    no-undo .
      120     define input  parameter p-main-table as character no-undo .
      121     define input  parameter p-field-list as character no-undo .
      122     define input  parameter p-label-form as character no-undo .
      123     define variable h-new-buf         as handle    no-undo .
      124     define variable h-main-buf        as handle    no-undo .
      125     define variable h-for-comp        as handle    no-undo .
      126     define variable v-inform          as character no-undo .
      127     define variable v-ind             as integer   no-undo .
      128     define variable v-idx-field-qnty  as integer   no-undo .
      129     define variable v-num-entries     as integer   no-undo .
      130     define variable fh                as handle    no-undo .
      131     define variable fh-main           as handle    no-undo .
      132     define variable fh-old            as handle    no-undo .
      133     define variable fh-new            as handle    no-undo .
      134     define variable v-field-name      as character no-undo .
      135     define variable v-field-lvl       as character no-undo .
      136     define variable v-field-form      as character no-undo .
      137     define variable v-search-exp      as character no-undo .
      138     define variable v-srch-main       as character no-undo .
      139     define variable v-word-link       as character no-undo .
      140     define variable v-av-chip-num     as logical   no-undo .
      141     define variable v-main-pi-fld-lst as character no-undo .
      142     define variable v-main-fld-lst    as character no-undo .
      143     define variable v-delim-list      as character no-undo .
      144     define variable v-label           as character no-undo .
      145     define variable v-old-value       as character no-undo case-sensitive.
      146     define variable v-new-value       as character no-undo case-sensitive.
      147     define variable v-chg-fields as character no-undo.
      148     for each temp-changes:
      149       delete temp-changes.
      150     end.
      151     if not p-hst-handle:available then do:
      152       return .
      153     end.
      154     create buffer h-new-buf  for table p-hst-handle .
      155     create buffer h-main-buf for table p-main-table .
      156     assign
      157       v-inform = h-main-buf:index-information(1)
      158       v-ind    = 2
      159     .
      160     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      161     on error undo, return error
      162     :
      163       assign
      164         v-inform = h-main-buf:index-information( v-ind )
      165         v-ind    = v-ind + 1
      166       .
      167     end.
      168     if v-inform = ?
      169       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      170       or entry( 3, v-inform, ",":U ) <> "1":U
      171     then do:
      172       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      173     end.
      174     assign
      175       v-idx-field-qnty = num-entries( v-inform ) - 4
      176     .
      177     if v-idx-field-qnty < 2 then do:
      178       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      179     end.
      180     assign
      181       v-srch-main   = "where":U
      182       v-word-link   = "":U
      183       v-av-chip-num = false
      184       v-delim-list  = "":U
      185     .
      186     do v-ind = 1 to v-idx-field-qnty by 2
      187     on error undo, return error
      188     :
      189       assign
      190         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      191         fh                = p-hst-handle:buffer-field( v-field-name )
      192         fh-main           = h-main-buf:buffer-field( v-field-name )
      193         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      194         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      195       .
      196       if fh:data-type ="character":U then do:
      197         assign
      198           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      199         .
      200       end.
      201       else do:
      202         assign
      203           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      204         .
      205       end.
      206       if v-delim-list = "":U then do:
      207         assign
      208           v-delim-list = ",":U
      209         .
      210       end.
      211       if v-word-link = "":U then do:
      212         assign
      213           v-word-link = "and":U
      214         .
      215       end.
      216     end.
      217     assign
      218       v-delim-list  = "":U
      219     .
      220     do v-ind = 1 to h-main-buf:num-fields
      221     on error undo, return error
      222     :
      223       assign
      224         fh-main      = h-main-buf:buffer-field( v-ind )
      225         v-field-name = fh-main:name
      226       .
      227         assign
      228           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      229         .
      230         if v-delim-list = "":U then do:
      231           assign
      232             v-delim-list = ",":U
      233           .
      234         end.
      235     end.
      236     assign
      237       v-inform = p-hst-handle:index-information(1)
      238       v-ind    = 2
      239     .
      240     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      241     on error undo, return error
      242     :
      243       assign
      244         v-inform = p-hst-handle:index-information( v-ind )
      245         v-ind    = v-ind + 1
      246       .
      247     end.
      248     if v-inform = ?
      249       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      250       or entry( 3, v-inform, ",":U ) <> "1":U
      251     then do:
      252       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      253     end.
      254     assign
      255       v-idx-field-qnty = num-entries( v-inform ) - 4
      256     .
      257     if v-idx-field-qnty < 2 then do:
      258       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      259     end.
      260     assign
      261       v-search-exp  = "where":U
      262       v-word-link   = "":U
      263       v-av-chip-num = false
      264     .
      265     do v-ind = 1 to v-idx-field-qnty by 2
      266     on error undo, return error
      267     :
      268       assign
      269         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      270         fh           = p-hst-handle:buffer-field( v-field-name )
      271         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      272       .
      273       if v-field-name = "chip-num":U then do:
      274         assign
      275           v-search-exp  = substitute( "&1 >", v-search-exp )
      276           v-av-chip-num = true
      277         .
      278       end.
      279       else do:
      280         assign
      281           v-search-exp = substitute( "&1 =", v-search-exp )
      282         .
      283       end.
      284       if fh:data-type ="character":U then do:
      285         assign
      286           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      287         .
      288       end.
      289       else do:
      290         assign
      291           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
      292         .
      293       end.
      294       if v-word-link = "":U then do:
      295         assign
      296           v-word-link = "and":U
      297         .
      298       end.
      299     end.
      300     if v-av-chip-num = false then do:
      301       message
      302         vss-workfile vss-revision vss-description skip
      303         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
      304         "Использование данной процедуры невозможно!" skip
      305         view-as alert-box error .
      306       return error .
      307     end.
      308     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
      309     if not h-new-buf:available then do:
      310       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
      311       if not h-main-buf:available then do:
      312         assign
      313           h-for-comp = ?
      314         .
      315       end.
      316       else do:
      317         assign
      318           h-for-comp = h-main-buf
      319         .
      320       end.
      321     end.
      322     else do:
      323       assign
      324         h-for-comp = h-new-buf
      325       .
      326     end.
      327     assign
      328       v-num-entries = num-entries( v-main-fld-lst, ",":U )
      329     .
      330     do v-ind = 1 to v-num-entries
      331     on error undo, return error return-value
      332     :
      333       assign
      334         v-field-name = entry( v-ind, v-main-fld-lst )
      335         fh-old       = p-hst-handle:buffer-field( v-field-name )
      336         v-old-value  = fh-old:buffer-value()
      337         v-label      = trim( fh-old:label )
      338       .
      339       if ( trim( p-field-list ) <> "":U
      340            and lookup( v-field-name, p-field-list ) > 0
      341          )
      342          or trim( p-field-list ) = "":U
      343       then do:
      344         if h-for-comp <> ? then do:
      345           assign
      346             fh-new      = h-for-comp:buffer-field( v-field-name )
      347             v-new-value = fh-new:buffer-value()
      348           .
      349         end.
      350         else do:
      351           assign
      352             v-new-value = "":U
      353           .
      354         end.
      355           if p-act-create = true then do:
      356             assign
      357               v-old-value = "":U
      358             .
      359           end.
      360           if p-act-delete = true then do:
      361             assign
      362               v-new-value = "":U
      363             .
      364           end.
      365         if v-old-value <> v-new-value
      366         then do:
      367           create temp-changes.
      368           assign
      369             temp-changes.t_name = p-main-table
      370             temp-changes.f_name = v-field-name
      371             temp-changes.l_name = replace( v-label, "&":U, "":U )
      372             temp-changes.v_old  = trim( v-old-value )
      373             temp-changes.v_new  = trim( v-new-value )
      374             temp-changes.num_   = 0
      375             temp-changes.fNotChange = v-old-value eq v-new-value
      376           .
      377         end.
      378       end.
      379     end.
      380     assign
      381       v-num-entries = num-entries( p-label-form, chr(8) )
      382     .
      383     do v-ind = 1 to v-num-entries
      384     on error undo, return error return-value
      385     :
      386       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
      387         assign
      388           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      389           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      390           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      391         .
      392         find first temp-changes
      393           where temp-changes.f_name = v-field-name
      394           no-error .
      395         if available temp-changes then do:
      396           if trim( v-field-lvl ) <> "":U then do:
      397             assign
      398               temp-changes.l_name = v-field-lvl
      399             .
      400           end.
      401           if trim( v-field-form ) <> "":U then do:
      402             assign
      403               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
      404             .
      405             if h-for-comp <> ? then do:
      406               assign
      407                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
      408               .
      409             end.
      410           end.
      411         end.
      412       end.
      413       else do:
      414         message
      415           vss-workfile vss-revision vss-description skip
      416           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
      417           substitute( "список для поля '&1': '&2'"
      418                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      419                       ,entry( v-ind, p-label-form, chr(8) )
      420                     ) skip
      421           substitute( "полный список: &2", p-label-form ) skip
      422           view-as alert-box error .
      423       end.
      424     end.
      425     delete object h-new-buf .
      426     delete object h-main-buf .
      427   END PROCEDURE.
      428   find first buf_c-sert no-lock where
      429             buf_c-sert.cli-type = p-cli-type
      430         AND buf_c-sert.cli-code = p-cli-code
      431         AND buf_c-sert.sert-code = p-sert-code
      432         AND buf_c-sert.chip-num = p-chip-num
      433         AND buf_c-sert.corr-user-db-num = p-corr-user-db-num  no-error .
      434   if not available buf_c-sert then do:
      435     return error .
      436   end.
      437   CASE p-subject:
      438     when 'sert':U then do:
      439       run sert-proc in this-procedure(output p-description) no-error  .
      440     end.
      441     when 'sert-join':U then do:
      442       run sert-join-proc in this-procedure(output p-description) no-error  .
      443     end.
      444   END CASE.
      445   if error-status:error then do:
      446     return error .
      447   end.
      448   procedure sert-proc :
      449   define output parameter p-description as character no-undo .
      450   define buffer curr_c-sert for ub.c-sert  .
      451     do
      452     on error undo, return error
      453     :
      454       find first curr_c-sert no-lock where
      455                  curr_c-sert.cli-type = p-cli-type
      456              AND curr_c-sert.cli-code = p-cli-code
      457              AND curr_c-sert.sert-code = buf_c-sert.sert-code
      458              AND curr_c-sert.chip-num = p-chip-num
      459              AND curr_c-sert.corr-user-db-num = p-corr-user-db-num
      460              no-error .
      461       if not avail curr_c-sert then do:
      462         v-mess = "Неверная ссылка на c-sert в таблице c-sert".
      463         run err-mess in this-procedure ( input-output v-mess ).
      464         return error v-mess.
      465       end.
      466   define variable v-label-param as character no-undo .
      467   v-label-param =
      468     "b-code" + chr(4) + "Бар-код" + chr(4) + "" + chr(8)
      469    + "cli-code" + chr(4) + "Код контрагента" + chr(4) + "" + chr(8)
      470    + "cli-type" + chr(4) + "Тип контрагента" + chr(4) + "" + chr(8)
      471    + "sert-code" + chr(4) + "№ сертификата" + chr(4) + "" + chr(8)
      472    + "first-date" + chr(4) + "Дата начал действия" + chr(4) + "" + chr(8)
      473    + "last-date" + chr(4) + "Дата окончаняи действия" + chr(4) + "" + chr(8)
      474    + "PS" + chr(4) + "Примечания" + chr(4) + ""  .
      475    run proc-full-temp-changes in this-procedure (
      476                                                input (curr_c-sert.action = integer('1':U))
      477                                               ,input (curr_c-sert.action = integer('99':U))
      478                                               ,input  buffer curr_c-sert:handle
      479                                               ,input  'sert':U
      480                                               ,input  "b-code,cli-code,cli-type,sert-code,first-date,last-date,PS"
      481                                               ,input  v-label-param).
      482   end.
      483   end procedure.
      484   procedure sert-join-proc :
      485   define output parameter p-description as character no-undo .
      486   define variable v-tooltip as character no-undo .
      487   define variable v-label as character no-undo .
      488   define variable v-field-name as character no-undo .
      489   define variable v-field-function as character no-undo .
      490   define variable jj as integer no-undo .
      491   define variable v-field-label as character no-undo .
      492   define buffer curr_sert-join for ub.sert-join  .
      493   define buffer curr_c-sert for ub.c-sert  .
      494   define buffer new_c-sert for ub.c-sert  .
      495     do
      496     on error undo, return error
      497     :
      498       find first curr_c-sert no-lock where
      499                  curr_c-sert.cli-type = p-cli-type
      500              AND curr_c-sert.cli-code = p-cli-code
      501              AND curr_c-sert.sert-code = p-sert-code
      502              AND curr_c-sert.chip-num = p-chip-num
      503              AND curr_c-sert.corr-user-db-num = p-corr-user-db-num  no-error .
      504       if not avail curr_c-sert then do:
      505         v-mess = "Неверная ссылка на c-sert в таблице c-sert".
      506         run err-mess in this-procedure ( input-output v-mess).
      507         return error v-mess.
      508       end.
      509       find first new_c-sert no-lock where
      510                  new_c-sert.cli-type = p-cli-type
      511               AND new_c-sert.cli-code = p-cli-code
      512               AND new_c-sert.sert-code = buf_c-sert.sert-code
      513               AND new_c-sert.b-code = p-b-code
      514               AND new_c-sert.chip-num > p-chip-num
      515               AND new_c-sert.corr-user-db-num = p-corr-user-db-num
      516               no-error.
      517       if not available new_c-sert then do:
      518           find first curr_sert-join no-lock where
      519                      curr_sert-join.cli-type = p-cli-type
      520                   AND curr_sert-join.cli-code = p-cli-code
      521                   AND curr_sert-join.sert-code = buf_c-sert.sert-code
      522                   AND curr_sert-join.b-code = buf_c-sert.b-code
      523                   no-error.
      524           if not available curr_sert-join then do:
      525               return error.
      526           end.
      527           buffer-compare curr_sert-join to curr_c-sert
      528           case-sensitive
      529           save result in v-chg-fields.
      530       end.
      531       else do:
      532           buffer-compare new_c-sert except chip-num corr-date corr-time corr-user-name corr-user-db-num to curr_c-sert
      533           case-sensitive
      534           save result in v-chg-fields.
      535       end.
      536     _ii:
      537     do ii = 1 to num-entries(v-chg-fields):
      538       assign
      539       v-field-name = entry(ii, v-chg-fields)
      540       jj = lookup(v-field-name, "b-code,cli-code,cli-type,sert-code").
      541       if jj = 0 then next _ii.
      542       assign
      543       v-field-label = entry(jj, "Бар-код,Код контрагента,Тип контрагента,№ сертификата")
      544       v-field-function = entry(jj, ",,,")
      545       .
      546       create temp-changes.
      547       assign
      548       temp-changes.f_name = v-field-name
      549       temp-changes.l_name = v-field-label
      550       temp-changes.v_old = (if curr_c-sert.action = integer('1':U)
      551                             then "":U
      552                             else string(buffer curr_c-sert:buffer-field(v-field-name):buffer-value))
      553       temp-changes.v_new =  (if available new_c-sert
      554                                   then string(buffer new_c-sert:buffer-field(v-field-name):buffer-value)
      555                                   else string(buffer curr_sert-join:buffer-field(v-field-name):buffer-value)
      556                              )
      557       .
      558       if v-field-function <> '':U then do:
      559         assign
      560         temp-changes.v_old = DYNAMIC-function(v-field-function, temp-changes.v_old)
      561         temp-changes.v_new = DYNAMIC-function(v-field-function, temp-changes.v_new)
      562         .
      563       end.
      564     end.
      565   end.
      566   end procedure.
      567   PROCEDURE err-mess:
      568     DEFINE INPUT-output PARAMETER p-mess as character No-UNDO.
      569     CASE p-silent:
      570       when yes then do:
      571         p-mess =
      572         substitute("История сертификата  &1 на &2&3: щепка &4 БД:&5  Предмет изменений &6&7&8"
      573                     ,p-sert-code
      574                     , p-cli-type
      575                     , p-cli-code
      576                     , p-chip-num
      577                     , p-corr-user-db-num
      578                     , p-subject
      579                     , chr(10)
      580                     , p-mess
      581                     ).
      582       end.
      583       otherwise do:
      584         message
      585         p-mess
      586         view-as alert-box error .
      587       end.
      588     end.
      589   END PROCEDURE.
