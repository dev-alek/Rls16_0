      538   END.
      539   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      540   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      541   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      542   on help of frame Dialog-Frame
      543   do:
      544     run gbl/app_help.p
      545       (input this-procedure :file-name
