      382             VIEW-AS FILL-IN
      383             SIZE 84 BY 1
      384             FGCOLOR 4
      385        tt-dis-rule.value-type AT ROW 3 COL 10 COLON-ALIGNED WIDGET-ID 2
      386             LABEL "Тип знач."
      387             VIEW-AS COMBO-BOX INNER-LINES 5
      388             LIST-ITEM-PAIRS "0",1
      389             DROP-DOWN-LIST
      390             SIZE 31 BY 1
      391        s-discnt-type AT ROW 3.93 COL 14 COLON-ALIGNED
      392        f-pos-type AT ROW 3.93 COL 46 COLON-ALIGNED WIDGET-ID 6
      393        s-subject-type AT ROW 4.93 COL 14 COLON-ALIGNED
      394        tt-dis-rule.Key#_One AT ROW 6.6 COL 28 COLON-ALIGNED WIDGET-ID 10
      395             LABEL "ИПоле1"
      396             VIEW-AS FILL-IN
      397             SIZE 10 BY 1
      398        B-dis-rule AT ROW 6.6 COL 41 WIDGET-ID 16
      399        b-rule-lookup AT ROW 6.6 COL 45 WIDGET-ID 18
      400        key#_one-name AT ROW 7.93 COL 2 NO-LABEL WIDGET-ID 12
      401        tt-dis-rule.time-rule-num AT ROW 9.53 COL 11 COLON-ALIGNED
      402             LABEL "№ распис."
      403             VIEW-AS FILL-IN
      404             SIZE 8 BY 1
      405        B-dis-time-rule AT ROW 9.53 COL 21.5
      406        tt-dis-rule.rule-num AT ROW 1.27 COL 71.5 COLON-ALIGNED
      407             LABEL "№ правила"
      408              VIEW-AS TEXT
      409             SIZE 14 BY .67
      410             FGCOLOR 4
      411        F-region AT ROW 3 COL 74.5 COLON-ALIGNED
      412        SPACE(0.29) SKIP(18.62)
      413       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      414            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      415            TITLE "Правило скидки ТИПА:"
      416            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      417   ASSIGN
      418          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      419          FRAME Dialog-Frame:HIDDEN           = TRUE.
      420   ASSIGN
      421          B-dis-rule:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      422   ASSIGN
      423          B-dis-time-rule:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      424   ASSIGN
      425          B-time-rule-lookup:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      426   ASSIGN
      427          tt-dis-rule.Key#_One:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      428   ASSIGN
      429          key#_one-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      430   ASSIGN
      431          tt-dis-rule.time-rule-num:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      432   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      433   DO:
      434     APPLY "END-ERROR":U TO SELF.
      435   END.
      436   ON CHOOSE OF B-dis-rule IN FRAME Dialog-Frame
      437   DO:
      438      RUN local-dr-chk ("key#_one", "button").
      439     apply "entry" to tt-dis-rule.key#_one in FRAME Dialog-Frame.
      440     return no-apply.
      441   END.
      442   ON CHOOSE OF B-dis-time-rule IN FRAME Dialog-Frame
      443   DO:
      444    run proc-b-dis-time-rule in this-procedure no-error.
      445    if error-status:error then return no-apply.
      446   END.
      447   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      448   DO:
      449     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      450     IF ERROR-STATUS:ERROR THEN DO:
      451         RETURN NO-APPLY.
      452     END.
      453   END.
      454   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
      455   DO:
      456     define variable v-rid-list as character no-undo.
      457     if NOT available locked_dis-rule then return no-apply.
      458     run ref/discruls.w (
      459                      INPUT parParentProc
      460                     ,input "":U
      461                     ,input "rl-root":U
      462                     ,input tt-dis-rule.rule-num
      463                     ,input tt-dis-rule.upper-rule-num
      464                     ,input "":U
      465                     ,input 0
      466                     ,input-output v-rid-list ).
      467   END.
      468   ON CHOOSE OF b-rule-lookup IN FRAME Dialog-Frame
      469   DO:
      470     IF AVAILABLE dr-chk_dis-rule THEN DO:
      471       run ref/show-dr.p ( input parparentproc
      472                         ,input dr-chk_dis-rule.rule-num) no-error.
      473     END.
      474   END.
      475   ON CHOOSE OF B-time-rule-lookup IN FRAME Dialog-Frame
      476   DO:
      477     RUN proc-time-rule-lookup IN THIS-PROCEDURE (V-TREE) NO-ERROR.
      478     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
      479   END.
      480   ON LEAVE OF tt-dis-rule.Key#_One IN FRAME Dialog-Frame
      481   DO:
