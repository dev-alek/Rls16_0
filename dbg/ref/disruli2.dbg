       33   define variable vss-revision    as character no-undo init "$Revision$":U .
       34   define variable vss-author      as character no-undo init "$Author$":U .
       35   define variable vss-date        as character no-undo init "$Date$":U .
       36   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       37   define variable vss-archive     as character no-undo init "$Archive$":U .
       38   define variable vss-description as character no-undo init "Редактирование правил скидок по шаблону 75".
       39   procedure vss-get-info :
       40     define output parameter p-vss-revision    like vss-revision    no-undo .
       41     define output parameter p-vss-author      like vss-author      no-undo .
       42     define output parameter p-vss-date        like vss-date        no-undo .
       43     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       44     define output parameter p-vss-archive     like vss-archive     no-undo .
       45     define output parameter p-vss-description like vss-description no-undo .
       46     assign
       47       p-vss-revision    = vss-revision
       48       p-vss-author      = vss-author
       49       p-vss-date        = vss-date
       50       p-vss-workfile    = vss-workfile
       51       p-vss-archive     = vss-archive
       52       p-vss-description = vss-description
       53     .
       54   end procedure.
       55   procedure vss-get-parameters :
       56     define output parameter p-vss-parameters as character no-undo .
       57   end procedure.
       58   define new global shared variable g#vssrevis-logger as handle    no-undo .
       59   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       60   define variable v-vssrevis-logger                   as handle    no-undo .
       61   procedure vss-logevent :
       62     define input  parameter p-extra-paramters as character no-undo .
       63     define variable v-vssrevis-parameters as character no-undo .
       64     do
       65     on error undo, return error return-value
       66     :
       67       if  valid-handle(v-vssrevis-logger)
       68       and v-vssrevis-logger :get-signature("logevent") <> ""
       69       then do:
       70         run vss-get-parameters in this-procedure
       71           (output v-vssrevis-parameters
       72           ).
       73         run logevent in v-vssrevis-logger
       74           (input vss-workfile
       75           ,input vss-revision
       76           ,input v-vssrevis-parameters
       77           ,input p-extra-paramters
       78           ).
       79       end.
       80     end.
       81   end procedure.
       82   assign
       83     v-vssrevis-logger = g#vssrevis-logger
       84   .
       85   if  valid-handle(v-vssrevis-logger)
       86   and v-vssrevis-logger :get-signature("logevent") <> ""
       87   then do:
       88     assign
       89       v-vssrevis-logevent = true
       90     .
       91     run vss-logevent in this-procedure (input vss-description) .
       92   end.
       93   define new global shared variable g#language as character no-undo .
       94   if g#language <> '' and g#language <> 'rus':U then do:
       95     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       96   end.
       97   define new global shared variable g#library  as handle no-undo .
       98   define new global shared variable g#library2 as handle no-undo .
       99   procedure proc-alt-shift-f2:
      100     if not ibs.th.gbl.gbl-var:rcode
      101   then
      102     run gbl\inidebug.p .
      103   end.
      104   procedure proc-alt-shift-f3:
      105     run gbl/prvssinf.p
      106       ( input this-procedure
      107       ) .
      108   end.
      109   define variable v-inform-launched as logical no-undo initial false .
      110   procedure proc-alt-shift-f4:
      111     define variable v-action as character no-undo .
      112     if v-inform-launched = false then do:
      113       assign
      114         v-inform-launched = true
      115       .
      116       run gbl/d-inform.w
      117         (  input self
      118         ,  input this-procedure
      119         , output v-action
      120         ) no-error .
      121       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      122       assign
      123         v-inform-launched = false
      124       .
      125     end.
      126   end.
      127   procedure proc-alt-f1:
      128     run gbl/corrhelp.p
      129       (input this-procedure
      130       ) .
      131   end .
      132   on alt-shift-f2 anywhere do:
      133     run proc-alt-shift-f2.
      134   end.
      135   on alt-shift-f3 anywhere do:
      136     run proc-alt-shift-f3 in this-procedure .
      137   end.
      138   on alt-shift-f4 anywhere do:
      139     run proc-alt-shift-f4 in this-procedure.
      140   end.
      141   on alt-f1 anywhere do:
      142     run proc-alt-f1 in this-procedure .
      143   end.
      144   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      145   procedure dr-code :
      146     do
      147     on error undo, return error
      148     :
      149       define input  parameter  p-templ-rl-root     like ub.dis-rule.templ-rl-root     no-undo .
      150       define output parameter  p-des               like ub.dis-rule.des               no-undo .
      151       define output parameter  p-discnt-type       like ub.dis-rule.discnt-type       no-undo .
      152       define output parameter  p-subject-type      like ub.dis-rule.subject-type      no-undo .
      153       define output parameter  p-value-type        like ub.dis-rule.value-type        no-undo .
      154       define output parameter  p-level-1           as character no-undo .
      155       define output parameter  p-level-2           as character no-undo .
      156       define output parameter  p-global             as integer no-undo .
      157       define output parameter  p-host               as integer no-undo .
      158       define output parameter  p-object             as integer no-undo .
      159       define output parameter  p-output-display as logical   no-undo .
      160       define output parameter  p-tree           as char  no-undo .
      161       define output parameter  p-other          as character no-undo .
      162       define variable v-other as character no-undo .
      163       define buffer buf_dis-rule for ub.dis-rule .
      164       define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      165       find first buf_dis-rule no-lock where
      166                 buf_dis-rule.rule-num = p-templ-rl-root no-error.
      167       find first buf_dis-cfg-rule no-lock where
      168               buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
      169           and buf_dis-cfg-rule.pos-type = '':U
      170           and buf_dis-cfg-rule.table-name = '':U
      171           and buf_dis-cfg-rule.discnt-role = '':U
      172           and buf_dis-cfg-rule.self-nonunique = '':U
      173               no-error.
      174       if not available buf_Dis-cfg-rule then do:
      175           undo, return error substitute("неизвестный шаблон скидки &1", p-templ-rl-root ).
      176       end.
      177       assign
      178       p-des = buf_dis-rule.des
      179       p-discnt-type = buf_dis-rule.discnt-type
      180       p-subject-type = buf_dis-rule.subject-type
      181       p-value-type = buf_dis-rule.value-type
      182       p-global = (if available buf_dis-cfg-rule
      183                   then buf_dis-cfg-rule.has-global
      184                   else 0)
      185       p-host = (if available buf_dis-cfg-rule
      186                 then buf_dis-cfg-rule.has-host
      187                 else 0)
      188       p-object = (if available buf_dis-cfg-rule
      189                 then buf_dis-cfg-rule.has-obj
      190                 else 0)
      191       p-output-display = (buf_dis-rule.sts = integer('0':U))
      192       p-tree = buf_Dis-rule.uniq-field
      193       p-other = buf_dis-rule.other-inf
      194       p-level-1 = entry(1, buf_dis-cfg-rule.other-inf, ";":U)
      195       p-level-2 = (if num-entries(buf_dis-cfg-rule.other-inf, ";":U) > 1
      196                    then entry(2, buf_dis-cfg-rule.other-inf, ";":U)
      197                    else '')
      198       .
      199     end.
      200   end procedure.
      201   define temp-table temp-drt-prop no-undo like ub.drt-prop.
      202   procedure disrules-fill-properties:
      203   define input  parameter p-templ-rl-root as integer   no-undo .
      204   define buffer buf_drt-prop for ub.drt-prop.
      205   define buffer buf_temp-drt-prop for temp-drt-prop.
      206   do
      207   on error undo, return error return-value
      208   :
      209     for each buf_temp-drt-prop:
      210       delete buf_temp-drt-prop.
      211     end.
      212     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
      213       create buf_temp-drt-prop.
      214       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      215     end.
      216   end.
      217   end procedure.
      218   procedure disrules-get-interface-form :
      219   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
      220   define output parameter p-form-name as character no-undo .
      221   define buffer buf_temp-drt-prop for temp-drt-prop.
      222   define buffer buf_drt-prop for ub.drt-prop.
      223   find first buf_temp-drt-prop where
      224             buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
      225         and buf_temp-drt-prop.upper-prop-code = "InputForm"
      226         and buf_temp-drt-prop.prop-code = "FormName" no-error.
      227   if not available buf_temp-drt-prop then do:
      228     find first buf_drt-prop where
      229               buf_drt-prop.templ-rl-root = p-templ-rl-root
      230           and buf_drt-prop.upper-prop-code = "InputForm"
      231           and buf_drt-prop.prop-code = "FormName" no-error.
      232     if available buf_drt-prop then do:
      233       p-form-name = buf_drt-prop.property-value.
      234     end.
      235     else do:
      236       p-form-name = "ref/dis-ruli.w".
      237     end.
      238   end.
      239   else do:
      240     p-form-name = buf_temp-drt-prop.property-value.
      241   end.
      242   end procedure.
      243   ~
      244   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      245   FUNCTION gtregion RETURNS CHARACTER
      246     ( input parhost-code as integer
      247     , input parobj-type as character
      248     , input parobj-code as integer
      249     , input p-tab as logical
      250     ) :
      251     def var par-region as character no-undo.
      252     if parhost-code = 0 and
      253          parobj-type = "":U and
      254          parobj-code = 0 then do:
      255          par-region = "Глобально".
      256          return par-region.
      257       end.
      258       if parobj-type = "" and
      259          parobj-code = 0 then do:
      260          par-region = if p-tab then fill(chr(32), 2) else "":U +
      261                       "Фирма" + chr(32) + string(parhost-code).
      262          return par-region.
      263       end.
      264       par-region = if p-tab then fill(chr(32), 4) else "":U +
      265                    parobj-type + chr(32) + string(parobj-code).
      266       return par-region.
      267   END FUNCTION.
