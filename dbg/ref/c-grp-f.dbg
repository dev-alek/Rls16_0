        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter mode as char no-undo.
        3   define input parameter up-code like ub.cli-grp.upper-code no-undo.
        4   define input-output parameter rid as recid no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision$":u .
        6   define variable vss-author      as character no-undo init "$Author$":u .
        7   define variable vss-date        as character no-undo init "$Date$":u .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":u .
        9   define variable vss-archive     as character no-undo init "$Archive$":u .
       10   define variable vss-description as character no-undo init "Форма для создания и редактирования группы клиентов" .
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define variable vss-include-info0 as character format "X(65)" no-undo
       72   initial "@(#)$Workfile$ $Revision$".
       73   define temp-table temp_cgrplib_grp no-undo
       74       field sel           as character
       75       field full-name     as character
       76       field sort-name     as character
       77       field node-code     as integer
       78       field upper-code    as integer
       79       field d-pcnt        as decimal
       80       field name          as character
       81       field level         as integer
       82       field mark          as character
       83       index pi is primary unique sort-name
       84       index fn full-name
       85       index nc is unique node-code
       86       index sl sel
       87       index uc upper-code
       88   .
       89   define temp-table temp_cgrplib_found-grp no-undo
       90       field full-name   as character
       91       field sort-name   as character
       92       field node-code   as integer
       93       field level       as integer
       94       field is-terminal as logical
       95       field d-pcnt      as decimal
       96       index pi is primary unique sort-name
       97       index fn full-name
       98       index lv level
       99       index it is-terminal
      100   .
      101   define temp-table temp_cfound-result-nodelist no-undo
      102       field node-code     as recid
      103       field processed     as logical
      104       field full-name     as character
      105       field sort-name     as character
      106       index pi is primary unique node-code
      107       index ps processed
      108   .
      109   procedure cli-grplib-get-sort-name :
      110   do
      111   on error undo, return error
      112   :
      113   define input parameter p-node-code  as integer      no-undo.
      114   define output parameter p-sort-name as character    no-undo.
      115       define variable v-upper-code    as integer           no-undo.
      116       define buffer buf_cli-grp       for ub.cli-grp.
      117       define buffer buf_upper_cli-grp for ub.cli-grp.
      118       find first buf_cli-grp no-lock
      119            where buf_cli-grp.node-code = p-node-code
      120       no-error.
      121       if not available buf_cli-grp
      122       then do:
      123           undo, return error "cli-grplib-get-sort-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
      124       end.
      125       assign
      126           p-sort-name  = ""
      127           v-upper-code = 1
      128       .
      129       do while buf_cli-grp.upper-code <> 0
      130       on error undo, return error "cli-grplib-get-sort-name: Ошибка составления полного имени группы"
      131       :
      132           assign
      133               p-sort-name  = buf_cli-grp.node-name
      134                            + (if p-sort-name <> "" then chr(2) else "")
      135                            + p-sort-name
      136               v-upper-code = buf_cli-grp.upper-code
      137           .
      138           find first buf_cli-grp no-lock
      139                where buf_cli-grp.node-code = v-upper-code
      140           no-error.
      141           if not available buf_cli-grp
      142           then do:
      143               undo, return error "cli-grplib-get-sort-name: Не найдена группа клиентов с кодом "
      144                                   + string( v-upper-code )
      145                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      146           end.
      147       end.
      148   end.
      149   end procedure.
      150   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      151   procedure cli-grplib-get-full-name :
      152      define input parameter  p-node-code  as integer      no-undo.
      153      define output parameter p-full-name as character    no-undo.
      154   do
      155   on error undo, return error
      156   :
      157       define variable v-upper-code    as integer           no-undo.
      158       define buffer buf_cli-grp       for ub.cli-grp.
      159       define buffer buf_upper_cli-grp for ub.cli-grp.
      160       find first buf_cli-grp no-lock
      161            where buf_cli-grp.node-code = p-node-code
      162       no-error.
      163       if not available buf_cli-grp
      164       then do:
      165           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
      166       end.
      167       assign
      168           p-full-name  = ""
      169           v-upper-code = 1
      170       .
      171       do while buf_cli-grp.upper-code <> 0
      172       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      173       :
      174           assign
      175               p-full-name  = buf_cli-grp.node-name
      176                            + (if p-full-name <> "" then chr(47) else "")
      177                            + p-full-name
      178               v-upper-code = buf_cli-grp.upper-code
      179           .
      180           find first buf_cli-grp no-lock
      181                where buf_cli-grp.node-code = v-upper-code
      182           no-error.
      183           if not available buf_cli-grp
      184           then do:
      185               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
      186                                   + string( v-upper-code )
      187                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      188           end.
      189       end.
      190       assign
      191       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      192       .
      193   end.
      194   end .
      195   procedure cgrplib-get-node-from-full-name :
      196   define input parameter p-full-name as character no-undo .
      197   define output parameter p-node-code as integer no-undo .
      198   define variable v-ii as integer no-undo .
      199   define variable v-upper-code as integer no-undo .
      200   define variable v-root-code as integer no-undo .
      201   define variable v-entry as character no-undo .
      202   define buffer buf_cli-grp       for ub.cli-grp.
      203   do
      204   on error undo, return error
      205   :
      206     find first buf_cli-grp no-lock
      207         where buf_cli-grp.upper-code = 0
      208     no-error .
      209     if not available buf_cli-grp
      210     then do:
      211         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
      212     end.
      213     else do:
      214       assign
      215       v-root-code = buf_cli-grp.node-code
      216       .
      217     end.
      218     v-upper-code = v-root-code.
      219     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      220       assign
      221       v-entry = entry(v-ii, p-full-name, chr(47)).
      222       if v-entry = '' then leave.
      223       find first buf_cli-grp no-lock where
      224                 buf_cli-grp.node-name = v-entry
      225             and buf_cli-grp.upper-code = v-upper-code
      226             no-error.
      227       if not available buf_cli-grp then do:
      228         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      229       end.
      230       else do:
      231         p-node-code = buf_cli-grp.node-code.
      232         v-upper-code = buf_cli-grp.node-code.
      233       end.
      234     end.
      235   end.
      236   end .
      237   procedure cgrplib-get-root-code :
      238   do
      239   on error undo, return error
      240   :
      241   define output parameter p-root-code as integer      no-undo.
      242       define buffer buf_cli-grp       for ub.cli-grp.
      243       find first buf_cli-grp no-lock
      244           where buf_cli-grp.upper-code = 0
      245       no-error .
      246       if not available buf_cli-grp
      247       then do:
      248           undo, return error .
      249       end.
      250       else do:
      251           assign
      252               p-root-code = buf_cli-grp.node-code
      253           .
      254       end.
      255   end.
      256   end procedure.
      257   procedure cgrplib-find-grp-by-full-name :
      258   do
      259   on error undo, return error
      260   :
      261   define input parameter p-search-name  as character    no-undo.
      262   define input parameter p-fill-path    as logical      no-undo.
      263       define variable v-upper-code    as integer          no-undo.
      264       define variable v-not-found     as logical init yes no-undo.
      265       define variable v-counter       as integer           no-undo.
      266       define variable v-level         as integer           no-undo.
      267       define variable v-full-name     as character         no-undo.
      268       define variable v-sort-name     as character         no-undo.
      269       define buffer buf_cli-grp       for ub.cli-grp.
      270       assign
      271           p-search-name = replace( p-search-name, chr(47), chr(2) )
      272       .
      273       run cgrplib-get-root-code ( output v-upper-code ) no-error .
      274       if error-status :error
      275       then do:
      276           undo, return error "cgrplib-expand-name: Ошибка при поиске корневого узла".
      277       end.
      278       assign
      279           v-full-name  = ""
      280           v-level      = num-entries( p-search-name, chr(2) )
      281       .
      282       for each temp_cgrplib_found-grp
      283       :
      284           delete temp_cgrplib_found-grp.
      285       end.
      286       start-name-analyze:
      287       do v-counter = 1 to v-level
      288       :
      289           if v-counter < v-level
      290           then do:
      291               find first buf_cli-grp no-lock
      292                    where buf_cli-grp.upper-code = v-upper-code
      293                      and buf_cli-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
      294               no-error .
      295               if not available buf_cli-grp
      296               then do:
      297                   assign
      298                       v-full-name  = p-search-name
      299                       v-sort-name  = p-search-name
      300                   .
      301                   return error "cgrplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      302               end.
      303               else do:
      304                   assign
      305                       v-full-name = v-full-name + (if v-full-name = "" then "" else chr(47) )         + buf_cli-grp.node-name
      306                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_cli-grp.node-name
      307                       v-upper-code = buf_cli-grp.node-code
      308                   .
      309                   if p-fill-path = yes
      310                   then do:
      311                       create temp_cgrplib_found-grp.
      312                       assign
      313                           temp_cgrplib_found-grp.full-name = v-full-name + chr(47)
      314                           temp_cgrplib_found-grp.sort-name = v-sort-name
      315                           temp_cgrplib_found-grp.node-code = v-upper-code
      316                           temp_cgrplib_found-grp.level     = v-counter
      317                       .
      318                   end.
      319               end.
      320           end.
      321           else do:
      322               for each buf_cli-grp no-lock
      323                  where buf_cli-grp.upper-code = v-upper-code
      324                    and buf_cli-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      325               :
      326                   assign
      327                       v-not-found = no
      328                   .
      329                   create temp_cgrplib_found-grp.
      330                   assign
      331                       temp_cgrplib_found-grp.full-name = v-full-name
      332                                                           + ( if v-full-name = "" then "" else chr(47) )
      333                                                           + buf_cli-grp.node-name + chr(47)
      334                       temp_cgrplib_found-grp.sort-name = v-sort-name
      335                                                           + ( if v-sort-name = "" then "" else chr(2) )
      336                                                           + buf_cli-grp.node-name
      337                       temp_cgrplib_found-grp.node-code = buf_cli-grp.node-code
      338                       temp_cgrplib_found-grp.level     = v-level
      339                   .
      340               end.
      341               if v-not-found = yes
      342               then do:
      343                   assign
      344                       v-full-name  = p-search-name
      345                       v-sort-name  = p-search-name
      346                   .
      347                   for each temp_cgrplib_found-grp
      348                   :
      349                       delete temp_cgrplib_found-grp.
      350                   end.
      351                   return error "cgrplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      352               end.
      353           end.
      354       end.
      355   end.
      356   end procedure.
      357   procedure cgrplib-find-all-subgroup :
      358   do
      359   on error undo, return error
      360   :
      361   define input parameter p-start-node-code    as integer      no-undo.
      362   define input parameter p-terminal-only      as logical      no-undo.
      363       define variable v-start-full-name   as character     no-undo.
      364       define variable v-start-sort-name   as character     no-undo.
      365       define variable v-not-found         as logical       no-undo.
      366       define variable v-is-terminal       as logical       no-undo.
      367       define variable v-d-pcnt            as decimal       no-undo.
      368       define buffer buf_cli-grp           for ub.cli-grp.
      369       create temp_cfound-result-nodelist.
      370       assign
      371           temp_cfound-result-nodelist.node-code = p-start-node-code
      372           temp_cfound-result-nodelist.processed = no
      373       .
      374       run cli-grplib-get-full-name in this-procedure (
      375             input p-start-node-code
      376           , output v-start-full-name
      377       ).
      378       run cli-grplib-get-sort-name in this-procedure (
      379             input p-start-node-code
      380           , output v-start-sort-name
      381       ).
      382       process-nodes:
      383       do while yes
      384       :
      385           find first temp_cfound-result-nodelist
      386                where temp_cfound-result-nodelist.node-code = p-start-node-code
      387           .
      388           assign
      389               temp_cfound-result-nodelist.processed = yes
      390           .
      391           for each buf_cli-grp no-lock
      392              where buf_cli-grp.upper-code = p-start-node-code
      393           on error undo, return error
      394           :
      395               run cgrplib-is-terminal in this-procedure (
      396                     input buf_cli-grp.node-code
      397                   , output v-is-terminal
      398               ).
      399               if v-is-terminal = yes
      400               then do:
      401                   create temp_cgrplib_found-grp.
      402                   assign
      403                       temp_cgrplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      404                                                           chr(47) + buf_cli-grp.node-name + chr(47)
      405                       temp_cgrplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      406                                                           chr(2) + buf_cli-grp.node-name + chr(2)
      407                       temp_cgrplib_found-grp.node-code   = buf_cli-grp.node-code
      408                       temp_cgrplib_found-grp.is-terminal = yes
      409                   .
      410                  run cgrplib-get-pcnt-value in this-procedure ( input temp_cgrplib_found-grp.node-code , output v-d-pcnt) no-error .
      411                  if not error-status:error then do:
      412                    temp_cgrplib_found-grp.d-pcnt = v-d-pcnt.
      413                  end.
      414                  else do:
      415                    temp_cgrplib_found-grp.d-pcnt = ?.
      416                  end.
      417               end.
      418               else do:
      419                   create temp_cfound-result-nodelist.
      420                   assign
      421                       temp_cfound-result-nodelist.node-code = buf_cli-grp.node-code
      422                       temp_cfound-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
      423                                                              chr(47) + buf_cli-grp.node-name + chr(47)
      424                       temp_cfound-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
      425                                                              chr(2) + buf_cli-grp.node-name + chr(2)
      426                       temp_cfound-result-nodelist.processed = no
      427                   .
      428                   if p-terminal-only = no
      429                   then do:
      430                       create temp_cgrplib_found-grp.
      431                       assign
      432                           temp_cgrplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      433                                                               chr(47) + buf_cli-grp.node-name + chr(47)
      434                           temp_cgrplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      435                                                               chr(2) + buf_cli-grp.node-name + chr(2)
      436                           temp_cgrplib_found-grp.node-code   = buf_cli-grp.node-code
      437                           temp_cgrplib_found-grp.is-terminal = no
      438                       .
      439                   end.
      440               end.
      441           end.
      442           find first temp_cfound-result-nodelist
      443                where temp_cfound-result-nodelist.processed = no
      444           no-error.
      445           if not available temp_cfound-result-nodelist
      446           then do:
      447               leave process-nodes.
      448           end.
      449           else do:
      450               assign
      451                   p-start-node-code = temp_cfound-result-nodelist.node-code
      452                   v-start-full-name = temp_cfound-result-nodelist.full-name
      453                   v-start-sort-name = temp_cfound-result-nodelist.sort-name
      454               .
      455           end.
      456       end.
      457   end.
      458   end procedure.
      459   procedure cgrplib-expand-name :
      460   do
      461   on error undo, return error
      462   :
      463   define input parameter p-start-name as character        no-undo.
      464   define output parameter p-end-name  as character        no-undo.
      465       define variable v-is-terminal     as logical           no-undo.
      466       define buffer buf_temp_cgrplib_found-grp     for temp_cgrplib_found-grp.
      467       run cgrplib-find-grp-by-full-name in this-procedure (
      468             input p-start-name
      469           , input no
      470       ) no-error.
      471       run cgrplib-get-max-substring in this-procedure (
      472                   input length( p-start-name )
      473                 , output p-end-name
      474       ) no-error .
      475       if error-status :error
      476       then do:
      477           assign
      478               p-end-name = ""
      479           .
      480       end.
      481       else do:
      482           find first temp_cgrplib_found-grp
      483               where temp_cgrplib_found-grp.full-name = p-end-name
      484           no-error.
      485           if available temp_cgrplib_found-grp
      486           then do:
      487               find first buf_temp_cgrplib_found-grp
      488                   where buf_temp_cgrplib_found-grp.full-name begins p-end-name
      489                   and recid( buf_temp_cgrplib_found-grp ) <> recid( temp_cgrplib_found-grp )
      490               no-error.
      491               if not available buf_temp_cgrplib_found-grp
      492               then do:
      493                   run cgrplib-is-terminal in this-procedure (
      494                       input temp_cgrplib_found-grp.node-code
      495                       , output v-is-terminal
      496                   ).
      497               end.
      498           end.
      499       end.
      500   end.
      501   end procedure.
      502   procedure cgrplib-get-max-substring :
      503   do
      504   on error undo, return error
      505   :
      506   define input parameter p-min-substring-length   as integer      no-undo.
      507   define output parameter p-substring             as character    no-undo.
      508           define variable v-char-counter  as integer           no-undo.
      509           define variable v-current-char  as character         no-undo.
      510           define variable v-names-counter  as integer           no-undo.
      511           define variable v-base-string   as character         no-undo.
      512           assign
      513               v-char-counter  = p-min-substring-length
      514           .
      515           find first temp_cgrplib_found-grp no-error.
      516           if not available temp_cgrplib_found-grp
      517           then do:
      518               undo, return error "cgrplib-get-max-substring: Нет строк для вычисления общей подстроки".
      519           end.
      520           else do:
      521               assign
      522                   v-base-string = temp_cgrplib_found-grp.full-name
      523               .
      524               counter-block:
      525               do while yes
      526               on error undo, return error "cgrplib-get-max-substring: Ошибка вычисления продолжения имени группы."
      527               :
      528                   assign
      529                       v-char-counter  = v-char-counter + 1
      530                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
      531                       v-names-counter = 0
      532                   .
      533                   compare-block:
      534                   for each temp_cgrplib_found-grp
      535                   :
      536                       assign
      537                           v-names-counter = v-names-counter + 1
      538                       .
      539                       if v-names-counter = 1
      540                       then do:
      541                           next compare-block.
      542                       end.
      543                       if substring( temp_cgrplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
      544                       then do:
      545                           leave counter-block.
      546                       end.
      547                   end.
      548                   if v-names-counter = 1
      549                   then do:
      550                       assign
      551                           p-substring = v-base-string
      552                       .
      553                       return.
      554                   end.
      555               end.
      556               assign
      557                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
      558               .
      559           end.
      560   end.
      561   end procedure.
      562   procedure cgrplib-is-terminal :
      563   do
      564   on error undo, return error "Ошибка процедуры cgrplib-is-terminal"
      565   :
      566   define input parameter p-node-code      as integer      no-undo.
      567   define output parameter p-is-terminal   as logical      no-undo.
      568       define buffer buf_cli-grp       for ub.cli-grp.
      569       find first buf_cli-grp no-lock
      570           where buf_cli-grp.upper-code = p-node-code
      571       no-error .
      572       if not available buf_cli-grp
      573       then do:
      574           assign
      575               p-is-terminal = yes
      576           .
      577       end.
      578       else do:
      579           assign
      580               p-is-terminal = no
      581           .
      582       end.
      583   end.
      584   end procedure.
      585   procedure cgrplib-have-clients :
      586   do
      587   on error undo, return error
      588   :
      589   define input parameter p-node-code      as integer      no-undo.
      590   define output parameter p-have-clients   as logical      no-undo.
      591       define buffer buf_clients         for ub.clients.
      592       find first buf_clients no-lock
      593            where buf_clients.grp-code = p-node-code
      594       no-error .
      595       if available buf_clients
      596       then do:
      597           assign
      598               p-have-clients = yes
      599           .
      600       end.
      601       else do:
      602           assign
      603               p-have-clients = no
      604           .
      605       end.
      606   end.
      607   end procedure.
      608   procedure cgrplib-find-by-substring :
      609   do
      610   on error undo, return error
      611   :
      612   define input parameter p-start-code         as integer      no-undo.
      613   define input parameter p-full-search-string as character    no-undo.
      614   define output parameter p-found-code        as integer      no-undo.
      615   define output parameter p-full-name         as character    no-undo.
      616       define variable v-start-code     as integer           no-undo.
      617       define variable v-found          as logical  init no  no-undo.
      618       define buffer buf_cli-grp       for ub.cli-grp.
      619       search-grp:
      620       for each buf_cli-grp no-lock
      621           where buf_cli-grp.node-code > p-start-code
      622       :
      623           if index( buf_cli-grp.node-name, p-full-search-string ) <> 0
      624           then do:
      625               assign
      626                   p-found-code = buf_cli-grp.node-code
      627                   v-found      = yes
      628               .
      629               run cli-grplib-get-full-name in this-procedure (
      630                     input p-found-code
      631                   , output p-full-name
      632               ) no-error .
      633               if error-status :error
      634               then do:
      635                   undo, return error "cgrplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
      636               end.
      637               leave search-grp.
      638           end.
      639       end.
      640       if v-found = yes
      641       then do:
      642       end.
      643       else do:
      644           assign
      645               p-full-name  = ""
      646               p-found-code = 0
      647           .
      648       end.
      649   end.
      650   end procedure.
      651   procedure cgrplib-analyze-grp-name :
      652   do
      653   on error undo, return error
      654   :
      655   define input parameter p-grp-name       as character            no-undo.
      656   define input parameter p-upper-code     as integer              no-undo.
      657   define output parameter p-error-message as character init ""    no-undo.
      658       define variable v-char-list     as character    no-undo.
      659       define variable v-char-counter  as integer      no-undo.
      660       define variable v-full-name     as character    no-undo.
      661       if p-grp-name = "" then do:
      662           assign
      663               p-error-message = "Название группы не может быть пустым.".
      664           .
      665       end.
      666       else do:
      667           assign
      668               v-char-list = "47,92,58,63,34,60,62,171,187,183"
      669           .
      670           do v-char-counter = 1 to num-entries( v-char-list )
      671           :
      672               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
      673               then do:
      674                   assign
      675                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
      676                   .
      677                   return.
      678               end.
      679           end.
      680           run cli-grplib-get-full-name in this-procedure (
      681                 input p-upper-code
      682               , output v-full-name
      683           ) no-error .
      684           if error-status :error
      685           then do:
      686               undo, return error "cgrplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
      687           end.
      688           if length( v-full-name ) + 1 + length( p-grp-name ) > 120
      689           then do:
      690               assign
      691                   p-error-message = 'Полное название группы не может содержать более 120 символов.'
      692               .
      693           end.
      694       end.
      695   end.
      696   end procedure.
      697   procedure cgrplib-get-lvl-num :
      698   define input parameter p-node-code  as integer      no-undo.
      699   define output parameter p-lvl-num   as integer      no-undo.
      700       define variable v-full-name    as character    no-undo.
      701   do
      702   on error undo, return error
      703   :
      704       run cli-grplib-get-full-name in this-procedure (
      705             input p-node-code
      706           , output v-full-name
      707       ).
      708       assign
      709           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
      710       .
      711       if p-lvl-num = -1
      712       then do:
      713           assign
      714               p-lvl-num = 0
      715           .
      716       end.
      717   end.
      718   end procedure.
      719   PROCEDURE cgrplib-get-pcnt-value :
      720   DEFINE INPUT PARAMETER p-node-code AS INTEGER NO-UNDO.
      721   DEFINE output PARAMETER p-pcnt-value AS DECIMAL NO-UNDO.
      722   define buffer buf_dis-grp-rule for ub.dis-grp-rule.
      723   define buffer buf_dis-rule for ub.dis-rule.
      724   find first buf_dis-grp-rule no-lock where
      725             buf_dis-grp-rule.classif-type = 'cli-grp':U
      726         and buf_dis-grp-rule.node-code = p-node-code
      727         and buf_dis-grp-rule.host-code = 0
      728         and buf_dis-grp-rule.obj-type = '':U
      729         and buf_dis-grp-rule.obj-code = 0
      730         and buf_dis-grp-rule.pos-type = '-':U
      731         and buf_dis-grp-rule.discnt-role = 'cli-grp-pcnt':U no-error.
      732   if available buf_dis-grp-rule then do:
      733     find first buf_dis-rule no-lock where
      734               buf_dis-rule.rule-num = buf_dis-grp-rule.rule-num no-error.
      735     if available buf_dis-rule then do:
      736       assign
      737       p-pcnt-value        = buf_dis-rule.discnt-value.
      738       .
      739     end.
      740   end.
      741   END PROCEDURE.
      742   procedure proc-alt-shift-f2:
      743     if not ibs.th.gbl.gbl-var:rcode
      744   then
      745     run gbl\inidebug.p .
      746   end.
      747   procedure proc-alt-shift-f3:
      748     run gbl/prvssinf.p
      749       ( input this-procedure
      750       ) .
      751   end.
      752   define variable v-inform-launched as logical no-undo initial false .
      753   procedure proc-alt-shift-f4:
      754     define variable v-action as character no-undo .
      755     if v-inform-launched = false then do:
      756       assign
      757         v-inform-launched = true
      758       .
      759       run gbl/d-inform.w
      760         (  input self
      761         ,  input this-procedure
      762         , output v-action
      763         ) no-error .
      764       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      765       assign
      766         v-inform-launched = false
      767       .
      768     end.
      769   end.
      770   procedure proc-alt-f1:
      771     run gbl/corrhelp.p
      772       (input this-procedure
      773       ) .
      774   end .
      775   on alt-shift-f2 anywhere do:
      776     run proc-alt-shift-f2.
      777   end.
      778   on alt-shift-f3 anywhere do:
      779     run proc-alt-shift-f3 in this-procedure .
      780   end.
      781   on alt-shift-f4 anywhere do:
      782     run proc-alt-shift-f4 in this-procedure.
      783   end.
      784   on alt-f1 anywhere do:
      785     run proc-alt-f1 in this-procedure .
      786   end.
      787   define variable grp-code like ub.cli-grp.node-code no-undo.
      788   define variable v-need-update   as logical  init yes    no-undo.
      789   define buffer upper_cli-grp for ub.cli-grp.
      790   DEFINE BUTTON b-exit AUTO-GO
      791        LABEL "&Ввод ":L
      792        SIZE 10 BY 1.
      793   DEFINE BUTTON b-quit AUTO-END-KEY
      794        LABEL "&Отмена":L
      795        SIZE 10 BY 1.
      796   DEFINE BUTTON b-help AUTO-END-KEY
      797        LABEL "Помо&щь":L
      798        SIZE 3 BY 1.
      799   DEFINE FRAME d-c-grp-f
      800   b-exit AT ROW 1 COL 1
      801   b-quit AT ROW 1 COL 11
      802   b-help AT ROW 1 COL 21
      803   ub.cli-grp.node-name AT ROW 3.25 COL 7.5 COLON-ALIGNED LABEL "Группа" VIEW-AS FILL-IN SIZE 41 BY 1
      804   SPACE (16.65) SKIP (0.35) WITH VIEW-AS DIALOG-BOX SIDE-LABELS THREE-D SCROLLABLE DEFAULT-BUTTON b-exit.
      805   ASSIGN FRAME d-c-grp-f:SCROLLABLE = FALSE.
      806   ON GO OF FRAME d-c-grp-f DO:
      807   define variable v-grp-name      as character         no-undo.
      808   define variable v-error-code    as integer           no-undo.
      809   DEFINE VARIABLE v-node-code     like ub.cli-grp.node-code no-undo .
      810   DEFINE VARIABLE v-upper-code    like ub.cli-grp.upper-code no-undo .
      811   define buffer buf_cli-grp       for ub.cli-grp.
      812    do on endkey undo, return no-apply on error undo, return no-apply on stop undo, return no-apply:
      813       if mode = 'ДОБАВЛЕНИЕ':U  then do:
      814         assign
      815         v-node-code = 0
      816         v-upper-code = up-code
      817           .
      818       end.
      819     else do:
      820       assign
      821         v-node-code = ub.cli-grp.node-code
      822         v-upper-code = ub.cli-grp.upper-code
      823         .
      824     end.
      825     run ref/cligrp01.p (
      826                     input mode
      827                     ,input no
      828                     ,input no
      829                     ,input-output  v-node-code
      830                     ,input-output  v-upper-code
      831                     ,input frame d-c-grp-f cli-grp.node-name
      832                     ,output rid
      833                     ) no-error .
      834     if error-status:error then UNDO, return no-apply.
      835    end.
      836   END.
      837   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      838   on help of frame d-c-grp-f
      839   do:
      840     run gbl/app_help.p
      841       (input this-procedure :file-name
      842       ,input ''
      843       ,input ?
      844       ) no-error.
      845     if error-status :error then do:
      846       message
      847         "Ошибка при вызове помощи"
      848         error-status :get-message(1)
      849         view-as alert-box .
      850     end.
      851   end.
      852   run minbtn-set in this-procedure .
      853   on choose of b-help in frame d-c-grp-f
      854   do:
      855     apply "help":u to frame d-c-grp-f .
      856   end.
      857   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      858   procedure minbtn-set :
      859       do
      860           on error undo, return error return-value
      861           :
      862           define variable ii              as integer       no-undo .
      863           define variable fh              as widget-handle no-undo .
      864           define variable hh              as widget-handle no-undo .
      865           define variable v-h             as handle        extent 4 no-undo .
      866           define variable v-name-button   as character     no-undo .
      867           define variable v-help-old-x    as decimal       no-undo .
      868           define variable v-help-old-y    as decimal       no-undo .
      869           define variable v-help-old-size as decimal       no-undo .
      870           define variable v-frame-width   as decimal       no-undo .
      871           define variable jj              as integer       no-undo .
      872           do
      873               on error undo, return error
      874               :
      875               assign
      876                   v-frame-width = frame d-c-grp-f:width - 0.3
      877                   fh            = frame d-c-grp-f:first-child
      878                   hh            = fh:first-child
      879                   ii            = 1
      880                   .
      881               do while valid-handle(hh):
      882                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      883                   do:
      884                       case lc(hh:name) :
      885                           when "b-help" then
      886                               do:
      887                                   hh:load-image-up("cmp/b-help.bmp":u) .
      888                                   hh:load-image-down("cmp/b-help.bmp":u) .
      889                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      890                                   hh:TOOLTIP = "Помощь" .
      891                                   v-help-old-x = hh:column .
      892                                   v-help-old-y = hh:row    .
      893                                   v-help-old-size = hh:width .
      894                                   hh:width-chars = 2.5 .
      895                               end.
      896                           when "b-print" then
      897                               do:
      898                                   hh:load-image("cmp/b-print.bmp":u) .
      899                                   hh:TOOLTIP = "Печать" .
      900                                   v-h[ii] = hh:handle .
      901                                   ii = ii + 1 .
      902                                   hh:width-chars = 3 .
      903                               end.
      904                           when "b-history" or
      905                           when "b-hist" then
      906                               do:
      907                                   hh:load-image("cmp/b-hist.bmp":u) .
      908                                   hh:TOOLTIP = "История" .
      909                                   v-h[ii] = hh:handle .
      910                                   ii = ii + 1 .
      911                                   hh:width-chars = 3 .
      912                               end.
      913                           when "b-sch" then
      914                               do:
      915                                   hh:load-image("cmp/b-sch.bmp":u) .
      916                                   hh:TOOLTIP = "Установка Фильтра" .
      917                                   v-h[ii] = hh:handle .
      918                                   ii = ii + 1 .
      919                                   hh:width-chars = 3 .
      920                               end.
      921                           when "b-hist-user" then
      922                               do:
      923                                   hh:load-image("cmp/b-hist.bmp":u) .
      924                                   hh:TOOLTIP = "История пользователя" .
      925                                   ii = ii + 1 .
      926                               end.
      927                       end case.
      928                   end.
      929                   hh = hh:next-sibling.
      930               end.
      931               b-help:column = v-frame-width - b-help:width-chars.
      932               jj = 0.
      933               repeat ii = 4 to 1 by -1 :
      934                   if valid-handle (v-h[ii] ) then
      935                   do:
      936                       jj  = jj + 1 .
      937                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      938                       v-h[ii]:row    = v-help-old-y .
      939                   end.
      940               end.
      941           end.
      942       end.
      943   end procedure.
      944   IF CURRENT-WINDOW:WINDOW-STATE = WINDOW-MINIMIZED
      945   THEN CURRENT-WINDOW:WINDOW-STATE = WINDOW-NORMAL.
      946   ON WINDOW-CLOSE OF FRAME d-c-grp-f APPLY "END-ERROR":U TO SELF.
      947   if mode = 'ДОБАВЛЕНИЕ':U then do:
      948     find upper_cli-grp no-lock where
      949          upper_cli-grp.node-code = up-code no-error .
      950     if not avail upper_cli-grp then do:
      951       message
      952       vss-workfile vss-revision vss-description skip
      953       "Не найдена группа с кодом"
      954       up-code
      955       view-as alert-box error .
      956       return error .
      957     end.
      958   end.
      959   if mode = 'ИЗМЕНЕНИЕ':U then
      960     find cli-grp where recid (cli-grp) =  rid.
      961   rid = ?.
      962   frame d-c-grp-f:title = "ГРУППА КЛИЕНТОВ   -    " + mode.
      963   if available cli-grp then
      964   display cli-grp.node-name  WITH FRAME d-c-grp-f.
      965   enable
      966   cli-grp.node-name
      967   b-exit
      968   b-quit
      969   b-help WITH FRAME d-c-grp-f.
      970   if mode = 'ИЗМЕНЕНИЕ':U then do:
      971     grp-code = cli-grp.node-code.
      972   end.
      973   WAIT-FOR GO OF FRAME d-c-grp-f.
      974   RUN disable_UI.
      975   PROCEDURE disable_UI :
      976     HIDE FRAME d-c-grp-f.
      977   END PROCEDURE.
