     1387   ON CHOOSE OF b-mark IN FRAME d-prod-cds
     1388   DO:
     1389   if not available prod-cds then  return no-apply.
     1390   define variable v-num-entry as integer no-undo .
     1391   if prod-cds.is-prod-bc = no
     1392   and prod-cds.cr-db-num <> v-cntxt-db-num
     1393   and not(prod-cds.is-global)
     1394   then do:
     1395     message
     1396     "Нельзя выбрать неглобальный ДопБК другой БД!"
     1397     view-as alert-box error .
     1398     return no-apply.
     1399   end.
     1400   if prod-cds.rid = ? then do:
     1401     message
     1402     "Нельзя выбрать ДопБК другой БД!"
     1403     view-as alert-box error .
     1404     return no-apply.
     1405   end.
     1406   assign
     1407   v-num-entry = lookup(string( prod-cds.rid ), p-rec-list ).
     1408   if v-num-entry > 0 then do:
     1409     assign
     1410       entry(v-num-entry, p-rec-list) = "":U
     1411       p-rec-list = replace( p-rec-list, chr(44) + chr(44), chr(44)) .
     1412       p-rec-list = trim(p-rec-list, chr(44)).
     1413   end.
     1414   else do:
     1415     assign
     1416       p-rec-list = p-rec-list + ( if p-rec-list = "":U then "":U else chr(44) ) + string( prod-cds.rid ) .
     1417   end.
     1418   br-cds :refresh ().
     1419   if last-event :function <> "mouse-select-dblclick" then
     1420     br-cds :select-next-row ().
     1421   apply "entry" to br-cds in frame d-prod-cds.
     1422   END.
     1423   ON CHOOSE OF b-print IN FRAME d-prod-cds
     1424   DO:
     1425     if available (prod-cds) then do:
     1426      run print-label in this-procedure(prod-cds.rid) no-error.
     1427      if error-status:error then do:
     1428       return no-apply.
     1429      end.
     1430      end.
     1431   END.
     1432   ON CHOOSE OF b-quit IN FRAME d-prod-cds
     1433   DO:
     1434     p-rec-list= ''.
     1435   END.
     1436   ON CHOOSE OF b-sel IN FRAME d-prod-cds
     1437   DO:
