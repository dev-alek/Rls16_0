      890   FUNCTION get-mark RETURNS CHARACTER
      891     (local-rid as recid)  FORWARD.
      892   DEFINE BUTTON b-add
      893        LABEL "&Добавить"
      894        SIZE 10 BY 1
      895        BGCOLOR 8 .
      896   DEFINE BUTTON b-help
      897        LABEL "Помо&щь"
      898        SIZE 3 BY 1
      899        BGCOLOR 8 .
      900   DEFINE BUTTON b-mark
      901        LABEL "&*"
      902        SIZE 3 BY 1.
      903   DEFINE BUTTON b-print
      904        LABEL "Пе&чать"
      905        SIZE 3 BY 1
      906        BGCOLOR 8 .
      907   DEFINE BUTTON b-quit AUTO-GO
      908        LABEL "&Выход"
      909        SIZE 10 BY 1
      910        BGCOLOR 8 .
      911   DEFINE BUTTON b-sel AUTO-GO
      912        LABEL "Вы&бор"
      913        SIZE 10 BY 1
      914        BGCOLOR 8 .
      915   DEFINE QUERY br-cds FOR
      916         prod-cds SCROLLING.
      917   DEFINE QUERY d-prod-cds FOR
      918         prod-cds SCROLLING.
      919   DEFINE BROWSE br-cds
