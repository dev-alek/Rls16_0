     1487   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1488   procedure minbtn-set :
     1489       do
     1490           on error undo, return error return-value
     1491           :
     1492           define variable ii              as integer       no-undo .
     1493           define variable fh              as widget-handle no-undo .
     1494           define variable hh              as widget-handle no-undo .
     1495           define variable v-h             as handle        extent 4 no-undo .
     1496           define variable v-name-button   as character     no-undo .
     1497           define variable v-help-old-x    as decimal       no-undo .
     1498           define variable v-help-old-y    as decimal       no-undo .
     1499           define variable v-help-old-size as decimal       no-undo .
     1500           define variable v-frame-width   as decimal       no-undo .
     1501           define variable jj              as integer       no-undo .
     1502           do
     1503               on error undo, return error
     1504               :
     1505               assign
     1506                   v-frame-width = frame d-prod-cds:width - 0.3
     1507                   fh            = frame d-prod-cds:first-child
     1508                   hh            = fh:first-child
     1509                   ii            = 1
     1510                   .
     1511               do while valid-handle(hh):
     1512                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1513                   do:
     1514                       case lc(hh:name) :
     1515                           when "b-help" then
     1516                               do:
     1517                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1518                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1519                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1520                                   hh:TOOLTIP = "Помощь" .
     1521                                   v-help-old-x = hh:column .
     1522                                   v-help-old-y = hh:row    .
     1523                                   v-help-old-size = hh:width .
     1524                                   hh:width-chars = 2.5 .
     1525                               end.
     1526                           when "b-print" then
     1527                               do:
     1528                                   hh:load-image("cmp/b-print.bmp":u) .
     1529                                   hh:TOOLTIP = "Печать" .
     1530                                   v-h[ii] = hh:handle .
     1531                                   ii = ii + 1 .
     1532                                   hh:width-chars = 3 .
     1533                               end.
     1534                           when "b-history" or
     1535                           when "b-hist" then
     1536                               do:
     1537                                   hh:load-image("cmp/b-hist.bmp":u) .
     1538                                   hh:TOOLTIP = "История" .
     1539                                   v-h[ii] = hh:handle .
     1540                                   ii = ii + 1 .
     1541                                   hh:width-chars = 3 .
     1542                               end.
     1543                           when "b-sch" then
     1544                               do:
     1545                                   hh:load-image("cmp/b-sch.bmp":u) .
     1546                                   hh:TOOLTIP = "Установка Фильтра" .
     1547                                   v-h[ii] = hh:handle .
     1548                                   ii = ii + 1 .
     1549                                   hh:width-chars = 3 .
     1550                               end.
     1551                           when "b-hist-user" then
     1552                               do:
     1553                                   hh:load-image("cmp/b-hist.bmp":u) .
     1554                                   hh:TOOLTIP = "История пользователя" .
     1555                                   ii = ii + 1 .
     1556                               end.
     1557                       end case.
     1558                   end.
     1559                   hh = hh:next-sibling.
     1560               end.
     1561               b-help:column = v-frame-width - b-help:width-chars.
     1562               jj = 0.
     1563               repeat ii = 4 to 1 by -1 :
     1564                   if valid-handle (v-h[ii] ) then
     1565                   do:
     1566                       jj  = jj + 1 .
     1567                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1568                       v-h[ii]:row    = v-help-old-y .
     1569                   end.
     1570               end.
     1571           end.
     1572       end.
     1573   end procedure.
     1574   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1575   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1576   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1577   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1578   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1579   define variable v-diasize-current-frame-height as decimal   no-undo .
     1580   define variable v-diasize-change-size          as logical   no-undo .
     1581   define variable v-diasize-resize-button        as handle    no-undo .
     1582   define variable v-diasize-wndmax               as logical   no-undo .
     1583   define variable v-diasize-wndstore             as logical   no-undo .
     1584   define variable v-diasize-proc-name            as character no-undo .
     1585   define variable v-diasize-browse-handle        as handle    no-undo .
     1586   define variable v-diasize-browse-number        as integer   no-undo .
     1587   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1588   define temp-table temp-diasize-handle no-undo
     1589     field handle-value  as handle
     1590     field save-position as decimal
     1591     index xpk is primary unique handle-value
     1592     .
     1593   define temp-table temp-browse-handle no-undo
     1594     field browse-type   as character
     1595     field browse-number as integer
     1596     field browse-handle as handle
     1597     field original-size as decimal
     1598     index xpk is primary unique browse-type browse-number
     1599     index xie browse-type browse-handle
     1600   .
     1601   procedure diasize_change-height :
     1602     define input  parameter p-change-value  as decimal   no-undo .
     1603     define input  parameter p-move-resize   as logical   no-undo .
     1604     define variable v-field-group-handle    as handle    no-undo .
     1605     define variable v-object-handle         as handle    no-undo .
     1606     define variable v-frame-height          as decimal   no-undo .
     1607     define variable v-frame-virtual-height  as decimal   no-undo .
     1608     define variable v-browse-height         as decimal   no-undo .
     1609     define variable v-window-height         as decimal   no-undo .
     1610     define variable v-window-virtual-height as decimal   no-undo .
     1611     define variable v-change-sign           as integer   no-undo .
     1612     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1613     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1614     if p-change-value > 0
     1615     then do:
     1616       if frame d-prod-cds :height + p-change-value
     1617           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1618       then do:
     1619         assign
     1620           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1621                           - (frame d-prod-cds :height-chars)
     1622         .
     1623         if p-change-value <= 0
     1624         then do:
     1625           run diasize_position-resize-button in this-procedure .
     1626           return .
     1627         end.
     1628       end.
     1629     end.
     1630     if p-change-value < 0
     1631     then do:
     1632       if frame d-prod-cds :height + p-change-value < v-diasize-orig-frame-height
     1633       then do:
     1634         assign
     1635           p-change-value = v-diasize-orig-frame-height
     1636                          - (frame d-prod-cds :height-chars)
     1637         .
     1638         if p-change-value >= 0
     1639         then do:
     1640           run diasize_position-resize-button in this-procedure .
     1641           return .
     1642         end.
     1643       end.
     1644     end.
     1645     if p-change-value >= 0
     1646     then do:
     1647       assign
     1648         v-change-sign = 1
     1649       .
     1650     end.
     1651     else do:
     1652       assign
     1653         v-change-sign = -1
     1654       .
     1655     end.
     1656     assign
     1657       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1658     .
     1659     if p-change-value = 0
     1660     then do:
     1661       run diasize_position-resize-button in this-procedure .
     1662       return .
     1663     end.
     1664     move_block:
     1665     do
     1666     on error undo move_block, retry move_block
     1667     :
     1668       if retry
     1669       then do:
     1670         do
     1671         on error undo move_block, leave move_block
     1672         :
     1673           if p-change-value > 0
     1674           then do:
     1675             for each buf_temp-diasize-handle
     1676             on error undo, next
     1677             :
     1678               assign
     1679                 v-object-handle = buf_temp-diasize-handle.handle-value
     1680               .
     1681               if v-object-handle <> v-diasize-resize-button
     1682               then do:
     1683                 assign
     1684                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1685                 .
     1686               end.
     1687             end.
     1688             assign
     1689               v-diasize-browse-handle :height = v-browse-height
     1690             .
     1691             for each buf_temp-browse-handle
     1692               where buf_temp-browse-handle.browse-type = 'height':u
     1693             on error undo, next
     1694             :
     1695               assign
     1696                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1697               .
     1698             end.
     1699             assign
     1700               frame d-prod-cds :height = v-frame-height
     1701             .
     1702             if frame d-prod-cds :scrollable = true
     1703             then do:
     1704               assign
     1705                 frame d-prod-cds :virtual-height = v-frame-virtual-height
     1706               .
     1707             end.
     1708             run diasize_position-resize-button in this-procedure .
     1709           end.
     1710           else do:
     1711             if frame d-prod-cds :scrollable = true
     1712             then do:
     1713               assign
     1714                 frame d-prod-cds :virtual-height = v-frame-virtual-height
     1715               .
     1716             end.
     1717             assign
     1718               frame d-prod-cds :height = v-frame-height
     1719             .
     1720             assign
     1721               v-diasize-browse-handle :height = v-browse-height
     1722             .
     1723             for each buf_temp-browse-handle
     1724               where buf_temp-browse-handle.browse-type = 'height':u
     1725             on error undo, next
     1726             :
     1727               assign
     1728                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1729               .
     1730             end.
     1731             for each buf_temp-diasize-handle
     1732             on error undo, next
     1733             :
     1734               assign
     1735                 v-object-handle = buf_temp-diasize-handle.handle-value
     1736               .
     1737               if v-object-handle <> v-diasize-resize-button
     1738               then do:
     1739                 assign
     1740                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1741                 .
     1742               end.
     1743             end.
     1744             run diasize_position-resize-button in this-procedure .
     1745           end.
     1746           assign
     1747             v-diasize-change-size = false
     1748           .
     1749           leave move_block .
     1750         end.
     1751       end.
     1752       assign
     1753         v-diasize-need-full-display = true
     1754       .
     1755       if v-diasize-change-size = false
     1756       then do:
     1757         assign
     1758           v-diasize-change-size = true
     1759         .
     1760       end.
     1761       else do:
     1762         return .
     1763       end.
     1764       assign
     1765         v-frame-height = frame d-prod-cds :height
     1766         v-frame-virtual-height = frame d-prod-cds :virtual-height
     1767         v-browse-height = v-diasize-browse-handle :height
     1768       .
     1769       for each buf_temp-browse-handle
     1770         where buf_temp-browse-handle.browse-type = 'height':u
     1771       :
     1772         assign
     1773           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1774         .
     1775       end.
     1776       for each buf_temp-diasize-handle
     1777       :
     1778         delete buf_temp-diasize-handle .
     1779       end.
     1780       assign
     1781         v-field-group-handle = frame d-prod-cds :first-child
     1782       .
     1783       do while valid-handle(v-field-group-handle)
     1784       :
     1785         assign
     1786           v-object-handle = v-field-group-handle :first-child
     1787         .
     1788         do while valid-handle(v-object-handle)
     1789         :
     1790           if  v-object-handle <> v-diasize-browse-handle :handle
     1791           and can-query(v-object-handle, "row")
     1792           and can-query(v-object-handle, "height")
     1793           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1794           then do:
     1795             find first buf_temp-browse-handle
     1796               where buf_temp-browse-handle.browse-type   = 'height':u
     1797                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1798               no-error .
     1799             if available buf_temp-browse-handle
     1800             then do:
     1801             end.
     1802             else do:
     1803               create buf_temp-diasize-handle .
     1804               assign
     1805                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1806                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1807               .
     1808             end.
     1809           end.
     1810           assign
     1811             v-object-handle = v-object-handle :next-sibling
     1812           .
     1813         end.
     1814         assign
     1815           v-field-group-handle = v-field-group-handle :next-sibling
     1816         .
     1817       end.
     1818       do with frame d-prod-cds
     1819       :
     1820         hide v-diasize-resize-button .
     1821         assign
     1822           v-diasize-resize-button :row    = 1
     1823           v-diasize-resize-button :column = 1
     1824         .
     1825       end.
     1826       if p-change-value > 0
     1827       then do:
     1828         if frame d-prod-cds :scrollable = true
     1829         then do:
     1830           assign
     1831             frame d-prod-cds :virtual-height = frame d-prod-cds :virtual-height + p-change-value
     1832             no-error .
     1833           if error-status :error
     1834           or error-status :get-message(1) <> ""
     1835           then do:
     1836             undo move_block, retry move_block .
     1837           end.
     1838         end.
     1839         assign
     1840           frame d-prod-cds :height = frame d-prod-cds :height + p-change-value
     1841           no-error .
     1842         if error-status :error
     1843         or error-status :get-message(1) <> ""
     1844         then do:
     1845           undo move_block, retry move_block .
     1846         end.
     1847         assign
     1848           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1849           no-error .
     1850         if error-status :error
     1851         or error-status :get-message(1) <> ""
     1852         then do:
     1853           undo move_block, retry move_block .
     1854         end.
     1855         for each buf_temp-browse-handle
     1856           where buf_temp-browse-handle.browse-type = 'height':u
     1857         on error undo move_block, retry move_block
     1858         :
     1859           assign
     1860             buf_temp-browse-handle.browse-handle :height
     1861               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1862             no-error .
     1863           if error-status :error
     1864           or error-status :get-message(1) <> ""
     1865           then do:
     1866             undo move_block, retry move_block .
     1867           end.
     1868         end.
     1869         for each buf_temp-diasize-handle
     1870         on error undo move_block, retry move_block
     1871         :
     1872           assign
     1873             v-object-handle = buf_temp-diasize-handle.handle-value
     1874           .
     1875           if v-object-handle <> v-diasize-resize-button
     1876           then do:
     1877             assign
     1878               v-object-handle :row = v-object-handle :row + p-change-value
     1879               no-error .
     1880             if error-status :error
     1881             or error-status :get-message(1) <> ""
     1882             then do:
     1883               undo move_block, retry move_block .
     1884             end.
     1885           end.
     1886         end.
     1887       end.
     1888       else do:
     1889         for each buf_temp-diasize-handle
     1890         on error undo move_block, retry move_block
     1891         :
     1892           assign
     1893             v-object-handle = buf_temp-diasize-handle.handle-value
     1894           .
     1895           if v-object-handle <> v-diasize-resize-button
     1896           then do:
     1897             assign
     1898               v-object-handle :row = v-object-handle :row + p-change-value
     1899               no-error .
     1900             if error-status :error
     1901             or error-status :get-message(1) <> ""
     1902             then do:
     1903               undo move_block, retry move_block .
     1904             end.
     1905           end.
     1906         end.
     1907         assign
     1908           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1909           no-error .
     1910         if error-status :error
     1911         or error-status :get-message(1) <> ""
     1912         then do:
     1913           undo move_block, retry move_block .
     1914         end.
     1915         for each buf_temp-browse-handle
     1916           where buf_temp-browse-handle.browse-type = 'height':u
     1917         on error undo move_block, retry move_block
     1918         :
     1919           assign
     1920             buf_temp-browse-handle.browse-handle :height
     1921               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1922             no-error .
     1923           if error-status :error
     1924           or error-status :get-message(1) <> ""
     1925           then do:
     1926             undo move_block, retry move_block .
     1927           end.
     1928         end.
     1929         assign
     1930           frame d-prod-cds :height = frame d-prod-cds :height + p-change-value
     1931           no-error .
     1932         if error-status :error
     1933         or error-status :get-message(1) <> ""
     1934         then do:
     1935           undo move_block, retry move_block .
     1936         end.
     1937         if frame d-prod-cds :scrollable = true
     1938         then do:
     1939           assign
     1940             frame d-prod-cds :virtual-height = frame d-prod-cds :virtual-height + p-change-value
     1941             no-error .
     1942           if error-status :error
     1943           or error-status :get-message(1) <> ""
     1944           then do:
     1945             undo move_block, retry move_block .
     1946           end.
     1947         end.
     1948       end.
     1949       if p-move-resize = true
     1950       then do:
     1951         run diasize_position-resize-button in this-procedure .
     1952       end.
     1953       if v-diasize-wndstore = true
     1954       then do:
     1955         if connected("ub") = true
     1956         then do:
     1957           define variable v-cntxt-db-num        as integer   no-undo .
     1958           define variable v-cntxt-userid        as character no-undo .
     1959           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1960                                             , OUTPUT v-cntxt-userid
     1961                                             ) .
     1962           run gbl/wndsizew.p
     1963             (input  v-cntxt-db-num
     1964             ,input  v-cntxt-userid
     1965             ,input  v-diasize-proc-name
     1966             ,input  'height':u
     1967             ,input  string(frame d-prod-cds :height - v-diasize-orig-frame-height)
     1968             ) .
     1969         end.
     1970       end.
     1971     end.
     1972     assign
     1973       v-diasize-change-size = false
     1974     .
     1975   end procedure.
     1976   procedure diasize_set-height :
     1977     define input  parameter p-new-height  as decimal   no-undo .
     1978     define input  parameter p-move-resize as logical   no-undo .
     1979     do
     1980     on error undo, return error return-value
     1981     :
     1982       run diasize_change-height in this-procedure
     1983         (input  (p-new-height - frame d-prod-cds :height)
     1984         ,input  p-move-resize
     1985         ) .
     1986     end.
     1987   end procedure.
     1988   procedure diasize_change-width :
     1989     define input  parameter p-change-value as decimal   no-undo .
     1990     define input  parameter p-move-resize  as logical   no-undo .
     1991     define variable v-field-group-handle   as handle    no-undo .
     1992     define variable v-object-handle        as handle    no-undo .
     1993     define variable v-frame-width          as decimal   no-undo .
     1994     define variable v-frame-virtual-width  as decimal   no-undo .
     1995     define variable v-browse-width         as decimal   no-undo .
     1996     define variable v-window-width         as decimal   no-undo .
     1997     define variable v-window-virtual-width as decimal   no-undo .
     1998     define variable v-change-sign          as integer   no-undo .
     1999     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2000     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2001     if p-change-value > 0
     2002     then do:
     2003       if frame d-prod-cds :width + p-change-value >
     2004           session :width-chars
     2005       then do:
     2006         assign
     2007           p-change-value = session :width-chars - frame d-prod-cds :width
     2008         .
     2009         if p-change-value <= 0
     2010         then do:
     2011           run diasize_position-resize-button in this-procedure .
     2012           return .
     2013         end.
     2014       end.
     2015     end.
     2016     if p-change-value < 0
     2017     then do:
     2018       if frame d-prod-cds :width + p-change-value < v-diasize-orig-frame-width
     2019       then do:
     2020         assign
     2021           p-change-value = v-diasize-orig-frame-width
     2022                          - frame d-prod-cds :width
     2023         .
     2024         if p-change-value >= 0
     2025         then do:
     2026           run diasize_position-resize-button in this-procedure .
     2027           return .
     2028         end.
     2029       end.
     2030     end.
     2031     if p-change-value >= 0
     2032     then do:
     2033       assign
     2034         v-change-sign = 1
     2035       .
     2036     end.
     2037     else do:
     2038       assign
     2039         v-change-sign = -1
     2040       .
     2041     end.
     2042     assign
     2043       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2044     .
     2045     if p-change-value = 0
     2046     then do:
     2047       run diasize_position-resize-button in this-procedure .
     2048       return .
     2049     end.
     2050     move_block:
     2051     do
     2052     on error undo move_block, leave move_block
     2053     :
     2054       if retry
     2055       then do:
     2056         do
     2057         on error undo move_block, leave move_block
     2058         :
     2059           if p-change-value > 0
     2060           then do:
     2061             for each buf_temp-diasize-handle
     2062             on error undo, next
     2063             :
     2064               assign
     2065                 v-object-handle = buf_temp-diasize-handle.handle-value
     2066               .
     2067               if v-object-handle <> v-diasize-resize-button
     2068               then do:
     2069                 assign
     2070                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2071                 .
     2072               end.
     2073             end.
     2074             assign
     2075               v-diasize-browse-handle :width = v-browse-width
     2076             .
     2077             for each buf_temp-browse-handle
     2078               where buf_temp-browse-handle.browse-type = 'width':u
     2079             on error undo, next
     2080             :
     2081               assign
     2082                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2083               .
     2084             end.
     2085             assign
     2086               frame d-prod-cds :width = v-frame-width
     2087             .
     2088             if frame d-prod-cds :scrollable = true
     2089             then do:
     2090               assign
     2091                 frame d-prod-cds :virtual-width = v-frame-virtual-width
     2092               .
     2093             end.
     2094             run diasize_position-resize-button in this-procedure .
     2095           end.
     2096           else do:
     2097             if frame d-prod-cds :scrollable = true
     2098             then do:
     2099               assign
     2100                 frame d-prod-cds :virtual-width = v-frame-virtual-width
     2101               .
     2102             end.
     2103             assign
     2104               frame d-prod-cds :width = v-frame-width
     2105             .
     2106             for each buf_temp-browse-handle
     2107               where buf_temp-browse-handle.browse-type = 'width':u
     2108             on error undo, next
     2109             :
     2110               assign
     2111                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2112               .
     2113             end.
     2114             assign
     2115               v-diasize-browse-handle :width = v-browse-width
     2116             .
     2117             for each buf_temp-diasize-handle
     2118             on error undo, next
     2119             :
     2120               assign
     2121                 v-object-handle = buf_temp-diasize-handle.handle-value
     2122               .
     2123               if v-object-handle <> v-diasize-resize-button
     2124               then do:
     2125                 assign
     2126                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2127                 .
     2128               end.
     2129             end.
     2130             run diasize_position-resize-button in this-procedure .
     2131           end.
     2132           assign
     2133             v-diasize-change-size = false
     2134           .
     2135           leave move_block .
     2136         end.
     2137       end.
     2138       assign
     2139         v-diasize-need-full-display = true
     2140       .
     2141       if v-diasize-change-size = false
     2142       then do:
     2143         assign
     2144           v-diasize-change-size = true
     2145         .
     2146       end.
     2147       else do:
     2148         return .
     2149       end.
     2150       assign
     2151         v-frame-width = frame d-prod-cds :width
     2152         v-frame-virtual-width = frame d-prod-cds :virtual-width
     2153         v-browse-width = v-diasize-browse-handle :width
     2154       .
     2155       for each buf_temp-browse-handle
     2156         where buf_temp-browse-handle.browse-type = 'width':u
     2157       :
     2158         assign
     2159           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2160         .
     2161       end.
     2162       for each buf_temp-diasize-handle
     2163       :
     2164         delete buf_temp-diasize-handle .
     2165       end.
     2166       assign
     2167         v-field-group-handle = frame d-prod-cds :first-child
     2168       .
     2169       do while valid-handle(v-field-group-handle)
     2170       :
     2171         assign
     2172           v-object-handle = v-field-group-handle :first-child
     2173         .
     2174         do while valid-handle(v-object-handle)
     2175         :
     2176           if  v-object-handle <> v-diasize-browse-handle :handle
     2177           and v-object-handle <> v-diasize-resize-button
     2178           and can-query(v-object-handle, "row")
     2179           and can-query(v-object-handle, "height")
     2180           and ( v-object-handle :col + v-object-handle :width
     2181                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2182               )
     2183           then do:
     2184             find first buf_temp-browse-handle
     2185               where buf_temp-browse-handle.browse-type   = 'width':u
     2186                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2187               no-error .
     2188             if available buf_temp-browse-handle
     2189             then do:
     2190             end.
     2191             else do:
     2192               create buf_temp-diasize-handle .
     2193               assign
     2194                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2195                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2196               .
     2197             end.
     2198           end.
     2199           assign
     2200             v-object-handle = v-object-handle :next-sibling
     2201           .
     2202         end.
     2203         assign
     2204           v-field-group-handle = v-field-group-handle :next-sibling
     2205         .
     2206       end.
     2207       do with frame d-prod-cds
     2208       :
     2209         hide v-diasize-resize-button .
     2210         v-diasize-resize-button :row = 1.
     2211         v-diasize-resize-button :column = 1.
     2212       end.
     2213       if p-change-value > 0
     2214       then do:
     2215         if frame d-prod-cds :scrollable = true
     2216         then do:
     2217           assign
     2218             frame d-prod-cds :virtual-width = frame d-prod-cds :virtual-width + p-change-value
     2219             no-error .
     2220           if error-status :error
     2221           or error-status :get-message(1) <> ""
     2222           then do:
     2223             undo move_block, retry move_block.
     2224           end.
     2225         end.
     2226         assign
     2227           frame d-prod-cds :width = v-frame-width + p-change-value
     2228           no-error .
     2229         if error-status :error
     2230         or error-status :get-message(1) <> ""
     2231         then do:
     2232           undo move_block, retry move_block.
     2233         end.
     2234         assign
     2235           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2236         no-error .
     2237         if error-status :error
     2238         or error-status :get-message(1) <> ""
     2239         then do:
     2240           undo move_block, retry move_block.
     2241         end.
     2242         for each buf_temp-browse-handle
     2243           where buf_temp-browse-handle.browse-type = 'width':u
     2244         on error undo move_block, retry move_block
     2245         :
     2246           assign
     2247             buf_temp-browse-handle.browse-handle :width
     2248               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2249             no-error .
     2250           if error-status :error
     2251           or error-status :get-message(1) <> ""
     2252           then do:
     2253             undo move_block, retry move_block .
     2254           end.
     2255         end.
     2256         for each buf_temp-diasize-handle
     2257         on error undo move_block, retry move_block
     2258         :
     2259           assign
     2260             v-object-handle = buf_temp-diasize-handle.handle-value
     2261           .
     2262           if v-object-handle <> v-diasize-resize-button
     2263           then do:
     2264             assign
     2265               v-object-handle :col = v-object-handle :col + p-change-value
     2266               no-error .
     2267             if error-status :error
     2268             or error-status :get-message(1) <> ""
     2269             then do:
     2270               undo move_block, retry move_block .
     2271             end.
     2272           end.
     2273         end.
     2274       end.
     2275       else do:
     2276         for each buf_temp-diasize-handle
     2277         on error undo move_block, retry move_block
     2278         :
     2279           assign
     2280             v-object-handle = buf_temp-diasize-handle.handle-value
     2281           .
     2282           if v-object-handle <> v-diasize-resize-button
     2283           then do:
     2284             assign
     2285               v-object-handle :col = v-object-handle :col + p-change-value
     2286               no-error .
     2287             if error-status :error
     2288             or error-status :get-message(1) <> ""
     2289             then do:
     2290               undo move_block, retry move_block .
     2291             end.
     2292           end.
     2293         end.
     2294         for each buf_temp-browse-handle
     2295           where buf_temp-browse-handle.browse-type = 'width':u
     2296         on error undo move_block, retry move_block
     2297         :
     2298           assign
     2299             buf_temp-browse-handle.browse-handle :width
     2300               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2301             no-error .
     2302           if error-status :error
     2303           or error-status :get-message(1) <> ""
     2304           then do:
     2305             undo move_block, retry move_block .
     2306           end.
     2307         end.
     2308         assign
     2309           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2310           no-error .
     2311         if error-status :error
     2312         or error-status :get-message(1) <> ""
     2313         then do:
     2314           undo move_block, retry move_block.
     2315         end.
     2316         assign
     2317           frame d-prod-cds :width = frame d-prod-cds :width + p-change-value
     2318         no-error .
     2319         if error-status :error
     2320         or error-status :get-message(1) <> ""
     2321         then do:
     2322           undo move_block, retry move_block.
     2323         end.
     2324         if frame d-prod-cds :scrollable = true
     2325         then do:
     2326           assign
     2327             frame d-prod-cds :virtual-width = frame d-prod-cds :virtual-width + p-change-value
     2328           no-error .
     2329           if error-status :error
     2330           or error-status :get-message(1) <> ""
     2331           then do:
     2332             undo move_block, retry move_block.
     2333           end.
     2334         end.
     2335       end.
     2336       if p-move-resize
     2337       then do:
     2338         run diasize_position-resize-button in this-procedure .
     2339       end.
     2340       if v-diasize-wndstore = true
     2341       then do:
     2342         if connected("ub") = true
     2343         then do:
     2344           define variable v-cntxt-db-num        as integer   no-undo .
     2345           define variable v-cntxt-userid        as character no-undo .
     2346           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2347                                             , OUTPUT v-cntxt-userid
     2348                                             ) .
     2349           run gbl/wndsizew.p
     2350             (input  v-cntxt-db-num
     2351             ,input  v-cntxt-userid
     2352             ,input  v-diasize-proc-name
     2353             ,input  'width':u
     2354             ,input  string(frame d-prod-cds :width - v-diasize-orig-frame-width)
     2355             ) .
     2356         end.
     2357       end.
     2358     end.
     2359     assign
     2360       v-diasize-change-size = false
     2361     .
     2362   end procedure.
     2363   procedure diasize_set-width :
     2364     define input  parameter p-new-width  as decimal   no-undo .
     2365     define input  parameter p-move-resize as logical   no-undo .
     2366     do
     2367     on error undo, return error return-value
     2368     :
     2369       run diasize_change-width in this-procedure
     2370         (input  (p-new-width - frame d-prod-cds :width)
     2371         ,input  p-move-resize
     2372         ) .
     2373     end.
     2374   end procedure.
     2375   procedure diasize_position-resize-button :
     2376     do with frame d-prod-cds
     2377     :
     2378       hide v-diasize-resize-button .
     2379       assign
     2380         v-diasize-resize-button :row = frame d-prod-cds :height - v-diasize-resize-button :height
     2381                     - 1
     2382                     - (frame d-prod-cds :border-bottom-pixels / session :pixels-per-row)
     2383         v-diasize-resize-button :col = frame d-prod-cds :width - v-diasize-resize-button :width
     2384                     - 1
     2385                     - (frame d-prod-cds :border-right-pixels / session :pixels-per-column)
     2386       .
     2387       view v-diasize-resize-button .
     2388     end.
     2389   end procedure.
     2390   on alt-right anywhere
     2391   do:
     2392     run diasize_change-width in this-procedure
     2393       (input 1
     2394       ,input true
     2395       ) .
     2396     return no-apply .
     2397   end.
     2398   on alt-left anywhere
     2399   do:
     2400     run diasize_change-width in this-procedure
     2401       (input -1
     2402       ,input true
     2403       ) .
     2404     return no-apply .
     2405   end.
     2406   on alt-down anywhere
     2407   do:
     2408     run diasize_change-height in this-procedure
     2409       (input 1
     2410       ,input true
     2411       ) .
     2412     return no-apply .
     2413   end.
     2414   on alt-up anywhere
     2415   do:
     2416     run diasize_change-height in this-procedure
     2417       (input -1
     2418       ,input true
     2419       ) .
     2420     return no-apply .
     2421   end.
     2422   on alt-enter of frame d-prod-cds
     2423   do:
     2424     run diasize_maximize in this-procedure
     2425       (input  ?
     2426       ).
     2427     return no-apply .
     2428   end.
     2429   procedure diasize_end-move :
     2430     do
     2431     on error undo, return error return-value
     2432     :
     2433       define variable v-row-delta as decimal   no-undo .
     2434       define variable v-col-delta as decimal   no-undo .
     2435       define variable v-new-row as decimal   no-undo .
     2436       define variable v-new-col as decimal   no-undo .
     2437       assign
     2438         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2439         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2440       .
     2441       assign
     2442         v-row-delta = v-new-row - frame d-prod-cds :height
     2443         v-col-delta = v-new-col - frame d-prod-cds :width
     2444       .
     2445       run diasize_change-height in this-procedure
     2446         (input v-row-delta
     2447         ,input true
     2448         ) .
     2449       run diasize_change-width in this-procedure
     2450         (input v-col-delta
     2451         ,input true
     2452         ) .
     2453     end.
     2454   end procedure.
     2455   procedure diasize_maximize :
     2456     define input  parameter p-action as logical   no-undo .
     2457     do
     2458     on error undo, return error return-value
     2459     :
     2460       if p-action = ?
     2461       then do:
     2462         if v-diasize-need-maximize = true
     2463         then do:
     2464           assign
     2465             p-action = true
     2466           .
     2467         end.
     2468         else do:
     2469           assign
     2470             p-action = false
     2471           .
     2472         end.
     2473       end.
     2474       if p-action = true
     2475       then do:
     2476         run diasize_change-height in this-procedure
     2477           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2478               - frame d-prod-cds :height-chars
     2479           ,input true
     2480           ) .
     2481         run diasize_change-width in this-procedure
     2482           (input session :width-chars
     2483               - frame d-prod-cds :width-chars
     2484           ,input true
     2485           ) .
     2486         assign
     2487           v-diasize-need-maximize = false
     2488         .
     2489       end.
     2490       else do:
     2491         run diasize_change-width in this-procedure
     2492           (input v-diasize-orig-frame-width
     2493               - frame d-prod-cds :width-chars
     2494           ,input true
     2495           ) .
     2496         run diasize_change-height in this-procedure
     2497           (input v-diasize-orig-frame-height
     2498               - frame d-prod-cds :height-chars
     2499           ,input true
     2500           ) .
     2501         assign
     2502           v-diasize-need-maximize = true
     2503         .
     2504       end.
     2505     end.
     2506   end procedure.
     2507   procedure diasize_restore-orig-size :
     2508     do
     2509     on error undo, return error return-value
     2510     :
     2511       assign
     2512         v-diasize-current-frame-width  = frame d-prod-cds :width
     2513         v-diasize-current-frame-height = frame d-prod-cds :height
     2514       .
     2515       run diasize_set-height in this-procedure
     2516         (input  v-diasize-orig-frame-height
     2517         ,input  true
     2518         ) .
     2519       run diasize_set-width in this-procedure
     2520         (input  v-diasize-orig-frame-width
     2521         ,input  true
     2522         ) .
     2523     end.
     2524   end procedure.
     2525   procedure diasize_restore-current-size :
     2526     do
     2527     on error undo, return error return-value
     2528     :
     2529       run diasize_set-height in this-procedure
     2530         (input  v-diasize-current-frame-height
     2531         ,input  true
     2532         ) .
     2533       run diasize_set-width in this-procedure
     2534         (input  v-diasize-current-frame-width
     2535         ,input  true
     2536         ) .
     2537     end.
     2538   end procedure.
     2539   procedure diasize_set-browse-handle :
     2540     define input  parameter p-browse-handle as handle   no-undo .
     2541     define buffer buf_temp-browse-handle for temp-browse-handle .
     2542     do
     2543     on error undo, return error return-value
     2544     :
     2545       assign
     2546         v-diasize-browse-handle = p-browse-handle
     2547       .
     2548       for each buf_temp-browse-handle
     2549       on error undo, return error return-value
     2550       :
     2551         delete buf_temp-browse-handle .
     2552       end.
     2553     end.
     2554   end procedure.
     2555   procedure diasize_add_browse :
     2556     define input  parameter p-browse-type   as character no-undo .
     2557     define input  parameter p-browse-handle as handle    no-undo .
     2558     define buffer buf_temp-browse-handle for temp-browse-handle .
     2559     do
     2560     on error undo, return error return-value
     2561     :
     2562       assign
     2563         v-diasize-browse-number = v-diasize-browse-number + 1
     2564       .
     2565       create buf_temp-browse-handle .
     2566       assign
     2567         buf_temp-browse-handle.browse-type   = p-browse-type
     2568         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2569         buf_temp-browse-handle.browse-handle = p-browse-handle
     2570       .
     2571     end.
     2572   end procedure.
     2573   procedure diasize_init :
     2574     define variable v-default-value    as logical   no-undo .
     2575     define variable v-restore-saved    as logical   no-undo .
     2576     define variable v-resize-value-str as character no-undo .
     2577     do
     2578     on error undo, return error return-value
     2579     :
     2580       do with frame d-prod-cds
     2581       :
     2582         assign
     2583           v-diasize-orig-frame-height = frame d-prod-cds :height
     2584           v-diasize-orig-frame-width  = frame d-prod-cds :width
     2585           v-diasize-browse-handle     = browse br-cds :handle
     2586         .
     2587         create button v-diasize-resize-button
     2588         assign
     2589           parent        = frame d-prod-cds :first-child
     2590           label         = "s"
     2591           height-pixels = 16
     2592           width-pixels  = 16
     2593           visible       = true
     2594           sensitive     = true
     2595           movable       = true
     2596           triggers:
     2597             on end-move persistent run diasize_end-move in this-procedure .
     2598           end triggers.
     2599         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2600         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2601         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2602         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2603         assign
     2604           v-diasize-wndmax = false
     2605         .
     2606         if connected("ub") = true
     2607         then do:
     2608           define variable v-cntxt-db-num        as integer   no-undo .
     2609           define variable v-cntxt-userid        as character no-undo .
     2610           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2611                                             , OUTPUT v-cntxt-userid
     2612                                             ) .
     2613           run gbl/wndpar_r.p
     2614             (input  v-cntxt-db-num
     2615             ,input  v-cntxt-userid
     2616             ,input  'wndmax':U
     2617             ,output v-diasize-wndmax
     2618             ,output v-default-value
     2619             ) .
     2620         end.
     2621         assign
     2622           v-diasize-wndstore = false
     2623         .
     2624         if connected("ub") = true
     2625         then do:
     2626           run gbl/wndpar_r.p
     2627             (input  v-cntxt-db-num
     2628             ,input  v-cntxt-userid
     2629             ,input  'wndstore':U
     2630             ,output v-diasize-wndstore
     2631             ,output v-default-value
     2632             ) .
     2633         end.
     2634         assign
     2635           v-diasize-proc-name = entry(1, program-name(2), '.')
     2636         .
     2637         if v-diasize-wndstore = true
     2638         then do:
     2639           assign
     2640             v-restore-saved = false
     2641           .
     2642           if connected("ub") = true
     2643           then do:
     2644             run gbl/wndsizer.p
     2645               (input  v-cntxt-db-num
     2646               ,input  v-cntxt-userid
     2647               ,input  v-diasize-proc-name
     2648               ,input  'height':u
     2649               ,output v-resize-value-str
     2650               ) .
     2651             if v-resize-value-str <> '':U
     2652             then do:
     2653               run diasize_change-height in this-procedure
     2654                 (input  integer(v-resize-value-str)
     2655                 ,input  true
     2656                 ) .
     2657               assign
     2658                 v-restore-saved = true
     2659               .
     2660             end.
     2661           end.
     2662           if connected("ub") = true
     2663           then do:
     2664             run gbl/wndsizer.p
     2665               (input  v-cntxt-db-num
     2666               ,input  v-cntxt-userid
     2667               ,input  v-diasize-proc-name
     2668               ,input  'width':u
     2669               ,output v-resize-value-str
     2670               ) .
     2671             if v-resize-value-str <> '':U
     2672             then do:
     2673               run diasize_change-width in this-procedure
     2674                 (input  integer(v-resize-value-str)
     2675                 ,input  true
     2676                 ) .
     2677               assign
     2678                 v-restore-saved = true
     2679               .
     2680             end.
     2681           end.
     2682           if v-restore-saved <> true
     2683           then do:
     2684             if v-diasize-wndmax = true
     2685             then do:
     2686               run diasize_maximize in this-procedure
     2687                 (input  true
     2688                 ) .
     2689             end.
     2690           end.
     2691         end.
     2692         else do:
     2693           if v-diasize-wndmax = true
     2694           then do:
     2695             run diasize_maximize in this-procedure
     2696               (input  true
     2697               ) .
     2698           end.
     2699         end.
     2700       end.
     2701     end.
     2702   end procedure.
     2703   procedure diasize_need-full-display :
     2704     define output parameter p-need-full-display as logical   no-undo .
     2705     do
     2706     on error undo, return error return-value
     2707     :
     2708       assign
     2709         p-need-full-display = v-diasize-need-full-display
     2710       .
     2711       assign
     2712         v-diasize-need-full-display = false
     2713       .
     2714     end.
     2715   end procedure.
     2716   procedure get-context :
     2717      define output parameter p-db-num as integer          no-undo.
     2718      define output parameter p-user-id as character        no-undo.
     2719      define variable v-login               as character    no-undo.
     2720      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2721      define buffer buf_user-login  for ub.user-login .
     2722      do
     2723      on error undo, return error
     2724      :
     2725            FIND FIRST buf_sys-ctrl no-lock.
     2726            ASSIGN
     2727               v-login = USERID("ub")
     2728               p-db-num = buf_sys-ctrl.db-num
     2729            .
     2730            FIND FIRST buf_user-login
     2731                 WHERE buf_user-login.db-num = p-db-num
     2732                   AND buf_user-login.user-login = v-login
     2733                 no-lock
     2734                 no-error
     2735                 .
     2736            IF AVAILABLE buf_user-login
     2737            THEN DO:
     2738               assign
     2739                  p-user-id = buf_user-login.user-id
     2740               .
     2741            END.
     2742      end.
     2743   end procedure.
     2744       run diasize_init in this-procedure .
     2745   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2746   DEF VAR cur-clmn-numbr-cds as INT EXTENT 10 no-undo.
     2747   DEF VAR varmvibr-cds       as INT no-undo.
     2748   DEF VAR varmvjbr-cds       as INT no-undo.
     2749   DEF VAR varmvkbr-cds       as INT no-undo.
     2750   DEF VAR varmvlbr-cds       as INT no-undo.
     2751   DEF VAR move-elementbr-cds as INT no-undo.
     2752   def var jjbr-cds           as int no-undo.
     2753   do varmvibr-cds = 1 to EXTENT(cur-clmn-numbr-cds):
     2754     ASSIGN cur-clmn-numbr-cds[varmvibr-cds] = varmvibr-cds.
     2755   END.
     2756   RUN start-mv-clmnbr-cds.
     2757   PROCEDURE start-mv-clmnbr-cds:
     2758   def var old-session as logical no-undo.
     2759      old-session = SESSION:IMMEDIATE-DISPLAY.
     2760      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2761      SESSION:IMMEDIATE-DISPLAY = old-session.
     2762   END.
     2763   ON ctrl-cursor-right OF BROWSE br-cds do:
     2764     RUN re-move-clmnbr-cds ( 4, 10).
     2765   END.
     2766   ON ctrl-cursor-left OF BROWSE br-cds do:
     2767     RUN re-move-clmnbr-cds (10, 4).
     2768   END.
     2769   PROCEDURE re-move-clmnbr-cds:
     2770     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2771     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2772     DO varmvibr-cds = 1 TO EXTENT(cur-clmn-numbr-cds):
     2773       if cur-clmn-numbr-cds[varmvibr-cds] = source-column THEN cur-clmn-numbr-cds[varmvibr-cds] = -1.
     2774     END.
     2775     if br-cds:MOVE-COLUMN(source-column, target-column) IN FRAME d-prod-cds then.
     2776     if source-column > target-column THEN
     2777     DO varmvjbr-cds = source-column - 1 to target-column BY -1:
     2778       DO varmvibr-cds = 1 TO EXTENT(cur-clmn-numbr-cds):
     2779           if cur-clmn-numbr-cds[varmvibr-cds] = varmvjbr-cds THEN DO:
     2780             cur-clmn-numbr-cds[varmvibr-cds] = cur-clmn-numbr-cds[varmvibr-cds] + 1.
     2781           END.
     2782       END.
     2783     END.
     2784     ELSE
     2785     DO varmvjbr-cds = source-column + 1 to target-column:
     2786       DO varmvibr-cds = 1 TO EXTENT(cur-clmn-numbr-cds):
     2787         if cur-clmn-numbr-cds[varmvibr-cds] = varmvjbr-cds THEN DO:
     2788           cur-clmn-numbr-cds[varmvibr-cds] = cur-clmn-numbr-cds[varmvibr-cds] - 1.
     2789         END.
     2790       END.
     2791     END.
     2792     DO varmvibr-cds = 1 TO EXTENT(cur-clmn-numbr-cds):
     2793       if cur-clmn-numbr-cds[varmvibr-cds] = -1 THEN cur-clmn-numbr-cds[varmvibr-cds] = target-column.
     2794     END.
     2795   END PROCEDURE.
     2796   PROCEDURE ch-clmnbr-cds:
     2797     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2798     if cur-clmn-loc <= 4 then do:
     2799       return .
     2800     end.
     2801     DO varmvibr-cds = 1 TO EXTENT(cur-clmn-numbr-cds):
     2802       if cur-clmn-numbr-cds[varmvibr-cds] = cur-clmn-loc THEN move-elementbr-cds = varmvibr-cds.
     2803     END.
     2804     RUN re-move-clmnbr-cds (cur-clmn-loc, 4).
     2805   END PROCEDURE.
     2806   PROCEDURE mv-brw-defaultbr-cds:
     2807   def var old-session as logical no-undo.
     2808     old-session = SESSION:IMMEDIATE-DISPLAY.
     2809     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2810     do varmvlbr-cds = 4 to EXTENT(cur-clmn-numbr-cds):
     2811       RUN re-move-clmnbr-cds (cur-clmn-numbr-cds[varmvlbr-cds], varmvlbr-cds).
     2812     END.
     2813     RUN start-mv-clmnbr-cds.
     2814     SESSION:IMMEDIATE-DISPLAY = old-session.
     2815   END PROCEDURE.
     2816   .
     2817   MAIN-BLOCK:
     2818   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2819      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2820   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2821     run mainmenu_getcntxt in parparentproc
     2822       (output v-cntxt-db-num
     2823       ,output v-cntxt-userid
     2824       ,output v-cntxt-level
     2825       ,output v-cntxt-host-code-obj
     2826       ,output v-cntxt-obj-type
     2827       ,output v-cntxt-obj-code
     2828       ,output v-cntxt-db-num-obj
     2829       ,output v-cntxt-is-admin
     2830       ) .
     2831     find ub.goods no-lock where
     2832          ub.goods.gds-code = g-code.
     2833     find first ub.gds-prt no-lock where
     2834                ub.gds-prt.upper-code = ub.goods.prt-root.
     2835     find base-bar-code no-lock where
     2836          base-bar-code.b-code  = base-bc.
     2837     if base-bar-code.gds-code <> ub.goods.gds-code then do:
     2838       message
     2839         "Ошибка параметров prod-cds.w"
     2840         view-as alert-box.
     2841       return error.
     2842     end.
     2843     RUN UI-on.
     2844     WAIT-FOR GO OF FRAME d-prod-cds.
     2845   END.
     2846   RUN disable_UI.
     2847   PROCEDURE cre-prod :
     2848   define input parameter bc like ub.bar-code.b-code.
     2849   define buffer buf-bar-code for ub.bar-code.
     2850   define buffer buf-prod-bc  for ub.prod-bc.
     2851   define buffer buf_prod-bc-db  for ub.prod-bc-db.
     2852   define buffer buf-gds-prt  for ub.gds-prt.
     2853   define buffer buf_Units    for ub.units.
     2854   define variable local-dtl-name as character                     no-undo.
     2855   define variable pr-rec         as recid                    no-undo.
     2856   define variable pr-c-b-r       like ub.bar-code.cli-base-rate no-undo.
     2857   define variable v-is-scales-code as logical no-undo .
     2858   find buf-bar-code no-lock where
     2859        buf-bar-code.b-code = bc.
     2860   find buf-gds-prt no-lock where
     2861        buf-gds-prt.node-code = buf-bar-code.node-code.
     2862   if not buf-gds-prt.root and
     2863      not buf-gds-prt.is-term then
     2864     return.
     2865   if buf-gds-prt.upper-code = ub.goods.prt-root then
     2866     if buf-bar-code.in-code = "" then
     2867       local-dtl-name = "".
     2868     else
     2869       if buf-bar-code.part-code = "" then
     2870         local-dtl-name = buf-bar-code.in-code.
     2871       else
     2872         local-dtl-name = buf-bar-code.in-code + " (" + buf-bar-code.part-code + ")".
     2873   else
     2874     local-dtl-name = buf-gds-prt.f-name.
     2875   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2876   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     2877     (input  p-obj-type
     2878     ,input  p-obj-code
     2879     ,input  buf-bar-code.b-code
     2880     ,input  0
     2881     ,input  0
     2882     ,output pr-rec
     2883     ,output pr-c-b-r
     2884     )  .
     2885   if v-cntxt-db-num-obj <> v-cntxt-db-num then do:
     2886     find first buf_units no-lock where
     2887               buf_units.unit-name = buf-bar-code.unit-cli .
     2888     if lookup('вес':U, buf_units.type) > 0 then do:
     2889       v-is-scales-code = yes.
     2890     end.
     2891   end.
     2892   find  ub.price-list no-lock where
     2893         recid (ub.price-list) = pr-rec no-error.
     2894      v-show-db-num = no.
     2895     _buf-prod-bc:
     2896     for each buf-prod-bc no-lock where
     2897             buf-prod-bc.b-code = bc
     2898     :
     2899       create prod-cds.
     2900       buffer-copy buf-prod-bc to prod-cds
     2901         assign
     2902           prod-cds.cli-base-rate = buf-bar-code.cli-base-rate
     2903           prod-cds.unit-cli      = buf-bar-code.unit-cli
     2904           prod-cds.in-code       = buf-bar-code.in-code
     2905           prod-cds.part-code     = buf-bar-code.part-code
     2906           prod-cds.rid           = recid (buf-prod-bc)
     2907           prod-cds.dtl-name      = local-dtl-name
     2908       prod-cds.is-prod-bc    = yes
     2909           .
     2910   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2911   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbctv in g#library
     2912     (input prod-cds.b-str
     2913     ,input  prod-cds.unit-cli
     2914     ,input  goods.unit-base
     2915     ,input  'global=request'
     2916     ,output prod-cds.is-global
     2917     ) no-error .
     2918         if error-status:error then do:
     2919           prod-cds.is-global = ?.
     2920         end.
     2921       if available price-list and
     2922         price-list.b-code = buf-bar-code.b-code then
     2923         assign
     2924           prod-cds.price-sale = price-list.price-sale
     2925           prod-cds.d-pcnt     = price-list.d-pcnt
     2926           prod-cds.doc-num    = price-list.doc-num
     2927           .
     2928       else
     2929         if available price-list then
     2930           assign
     2931             prod-cds.price-sale = price-list.price-sale * buf-bar-code.cli-base-rate
     2932             prod-cds.d-pcnt     = 0
     2933             prod-cds.doc-num    = "-"
     2934             .
     2935         else
     2936           assign
     2937             prod-cds.price-sale = ?
     2938             prod-cds.d-pcnt     = ?
     2939             prod-cds.doc-num    = ?
     2940             .
     2941     end.
     2942   if v-cntxt-db-num-obj = v-cntxt-db-num
     2943   or v-is-scales-code = no
     2944   then do:
     2945   end.
     2946   else do:
     2947      v-show-db-num = yes.
     2948     _buf-prod-bc:
     2949     for each buf_prod-bc-db no-lock where
     2950             buf_prod-bc-db.b-code = bc
     2951     :
     2952       find first prod-cds no-lock where
     2953                 prod-cds.b-code = bc
     2954             and prod-cds.b-str  = buf_prod-bc-db.b-str
     2955             and prod-cds.cr-db-num = buf_prod-bc-db.db-num no-error.
     2956       if not available prod-cds then do:
     2957       create prod-cds.
     2958       buffer-copy buf_prod-bc-db to prod-cds
     2959         assign
     2960           prod-cds.cli-base-rate = buf-bar-code.cli-base-rate
     2961           prod-cds.unit-cli      = buf-bar-code.unit-cli
     2962           prod-cds.in-code       = buf-bar-code.in-code
     2963           prod-cds.part-code     = buf-bar-code.part-code
     2964           prod-cds.dtl-name      = local-dtl-name
     2965       prod-cds.cr-db-num     = buf_prod-bc-db.db-num
     2966           .
     2967   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2968   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbctv in g#library
     2969     (input prod-cds.b-str
     2970     ,input  prod-cds.unit-cli
     2971     ,input  goods.unit-base
     2972     ,input  'global=request'
     2973     ,output prod-cds.is-global
     2974     ) no-error .
     2975       if error-status:error then do:
     2976         prod-cds.is-global = ?.
     2977       end.
     2978       if v-is-scales-code
     2979       and (prod-cds.is-global
     2980       or prod-cds.is-global = ?
     2981       or prod-cds.cr-db-num = v-cntxt-db-num
     2982       )
     2983       then do:
     2984         define buffer buf_prod-bc for ub.prod-bc.
     2985         find first buf_prod-bc no-lock where
     2986                   buf_prod-bc.b-str = prod-cds.b-str
     2987               and buf_prod-bc.b-code = prod-cds.b-code no-error.
     2988         if available buf_prod-bc then do:
     2989           prod-cds.rid           = recid (buf_prod-bc).
     2990         end.
     2991       end.
     2992       if available price-list and
     2993         price-list.b-code = buf-bar-code.b-code then
     2994         assign
     2995           prod-cds.price-sale = price-list.price-sale
     2996           prod-cds.d-pcnt     = price-list.d-pcnt
     2997           prod-cds.doc-num    = price-list.doc-num
     2998           .
     2999       else
     3000         if available price-list then
     3001           assign
     3002             prod-cds.price-sale = price-list.price-sale * buf-bar-code.cli-base-rate
     3003             prod-cds.d-pcnt     = 0
     3004             prod-cds.doc-num    = "-"
     3005             .
     3006         else
     3007           assign
     3008             prod-cds.price-sale = ?
     3009             prod-cds.d-pcnt     = ?
     3010               prod-cds.doc-num    = ?.
     3011       end.
     3012     end.
     3013   end.
     3014   END PROCEDURE.
     3015   PROCEDURE disable_UI :
     3016     HIDE FRAME d-prod-cds.
     3017   END PROCEDURE.
     3018   PROCEDURE enable_UI :
     3019     IF AVAILABLE prod-cds THEN
     3020       DISPLAY prod-cds.b-str
     3021         WITH FRAME d-prod-cds.
     3022     ENABLE br-cds b-print b-quit b-sel b-mark b-add b-help
     3023         WITH FRAME d-prod-cds.
     3024     VIEW FRAME d-prod-cds.
     3025     OPEN QUERY br-cds FOR EACH prod-cds NO-LOCK.
     3026   END PROCEDURE.
     3027   PROCEDURE print-label :
     3028   define input parameter p-rid as recid no-undo.
     3029   define variable loc#log as logical no-undo.
     3030   define buffer buf_prod-bc for ub.prod-bc .
     3031   find first buf_prod-bc no-lock where
     3032               recid(buf_prod-bc) = p-rid no-error.
     3033   if not available buf_prod-bc then return error.
     3034   if buf_prod-bc.bc-on = no then do:
     3035       message
     3036       "Данный ДопБК выключен" skip
     3037       "Вы действительно хотите напечать этикетку на него?"
     3038       view-as alert-box QUestion buttons YEs-No update loc#log.
     3039       if not loc#log then return error.
     3040   end.
     3041       run rep/tick-pbc.p (      input parparentproc
     3042                           ,input p-obj-type
     3043                           ,input p-obj-code
     3044                           ,input recid(buf_prod-bc)
     3045                           ,input buf_prod-bc.b-code
     3046                           ) no-error.
     3047       if error-status:error then return error.
     3048   END PROCEDURE.
     3049   PROCEDURE UI-on :
     3050   ENABLE b-quit b-sel b-mark b-help br-cds b-print WITH FRAME d-prod-cds.
     3051   VIEW FRAME d-prod-cds.
     3052   for each prod-cds
     3053   :
     3054     delete prod-cds.
     3055   end.
     3056   case mode:
     3057     when "all-no-part" then do:
     3058       frame d-prod-cds :title = "Все ДопБК на все имеющиеся основные и неосновные бар-коды:   " +
     3059                                    "Основной код: " + string (base-bc, ">>>>>>>>9")
     3060                                    .
     3061       for each ub.bar-code no-lock where
     3062                ub.bar-code.gds-code  = base-bar-code.gds-code:
     3063         if ub.bar-code.in-code   = base-bar-code.in-code and
     3064         ub.bar-code.part-code = base-bar-code.part-code then do:
     3065           run cre-prod (ub.bar-code.b-code).
     3066         end.
     3067       end.
     3068     end.
     3069     when "code-all" then do:
     3070       if base-bar-code.unit-cli = ub.goods.unit-cli then do:
     3071         frame d-prod-cds :title = "Все дополнительные коды:   Основной код: " + string (base-bc, "999999999") +
     3072                                     "   Товар: " + ub.goods.artic + "  " + ub.goods.gds-name
     3073                                     .
     3074         for each ub.bar-code no-lock where
     3075                 ub.bar-code.gds-code  = base-bar-code.gds-code and
     3076                 ub.bar-code.node-code = base-bar-code.node-code and
     3077                 ub.bar-code.in-code   = base-bar-code.in-code and
     3078                 ub.bar-code.part-code = base-bar-code.part-code
     3079         :
     3080           run cre-prod (ub.bar-code.b-code).
     3081         end.
     3082       end.
     3083       else do:
     3084         frame d-prod-cds :title = "Все дополнительные коды:   Неосновной код: " + string (base-bc, "999999999") +
     3085                                     "   Товар: " + goods.artic + "  " + goods.gds-name
     3086                                     .
     3087         run cre-prod (base-bar-code.b-code).
     3088       end.
     3089       ENABLE b-add WITH FRAME d-prod-cds.
     3090     end.
     3091     when "scl-gds-all" then do:
     3092       frame d-prod-cds :title = "Все дополнительные коды по признакам:   " +
     3093                                    "Товар: " + ub.goods.artic + "  " + ub.goods.gds-name
     3094                                    .
     3095       for each ub.bar-code no-lock where
     3096                ub.bar-code.gds-code  = base-bar-code.gds-code and
     3097                ub.bar-code.in-code   = ""
     3098       :
     3099         run cre-prod (ub.bar-code.b-code).
     3100       end.
     3101       ENABLE b-add WITH FRAME d-prod-cds.
     3102     end.
     3103     when "par-gds-all" then do:
     3104       frame d-prod-cds :title = "Все дополнительные коды по партиям:   " +
     3105                                    "Товар: " + ub.goods.artic + "  " + ub.goods.gds-name
     3106                                    .
     3107       for each ub.bar-code no-lock where
     3108                ub.bar-code.gds-code  = base-bar-code.gds-code and
     3109                ub.bar-code.in-code  <> ""
     3110       :
     3111         run cre-prod (ub.bar-code.b-code).
     3112       end.
     3113       ENABLE b-add WITH FRAME d-prod-cds.
     3114     end.
     3115     when "gds-all" then do:
     3116       frame d-prod-cds :title = "Все дополнительные коды по товару:   " +
     3117                                    "Товар: " + ub.goods.artic + "  " + ub.goods.gds-name
     3118                                    .
     3119       for each ub.bar-code no-lock where
     3120                ub.bar-code.gds-code  = base-bar-code.gds-code
     3121       :
     3122         run cre-prod (ub.bar-code.b-code).
     3123       end.
     3124     end.
     3125     when "code-current" then do:
     3126       frame d-prod-cds :title = "Все дополнительные коды по товару:   Код: " + string (base-bc, "999999999") +
     3127                                    "  Товар: " + ub.goods.artic + "  " + ub.goods.gds-name
     3128                                    .
     3129       run cre-prod (base-bar-code.b-code).
     3130     end.
     3131     when "code-current-other-db-scale" then do:
     3132       frame d-prod-cds :title = "Все дополнительные коды по товару:   Код: " + string (base-bc, "999999999") +
     3133                                    "  Товар: " + ub.goods.artic + "  " + ub.goods.gds-name
     3134                                    .
     3135       run cre-prod (base-bar-code.b-code).
     3136     end.
     3137   end case.
     3138   frame d-prod-cds :title = frame d-prod-cds :title +
     3139                                "      Текущий объект: " + string (p-obj-type, "x(3)") +
     3140                                " " + string (p-obj-code, ">>>>9").
     3141   open query br-cds
     3142     for each prod-cds no-lock.
     3143   apply "value-changed" to br-cds in frame d-prod-cds.
     3144   END PROCEDURE.
     3145   FUNCTION get-mark RETURNS CHARACTER
     3146     (local-rid as recid) :
     3147   if local-rid = ? then return "".
     3148   if lookup (string (local-rid), p-rec-list) > 0 then
     3149     return "*".
     3150   else
     3151     return "".
     3152   END FUNCTION.
