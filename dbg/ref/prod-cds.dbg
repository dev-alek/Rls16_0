      921         get-mark (prod-cds.rid) @ mark format "x(1)"  column-label "*"
      922         prod-cds.bc-on                   format "+/"  column-label "+"
      923         prod-cds.b-str                                column-label "Доп. код"
      924         prod-cds.is-global               FORMAT "+/-" column-label "Глоб"
      925         prod-cds.cr-db-num             FORMAT ">>>>9" column-label "Создан(БД)"
      926         prod-cds.b-code                               column-label "Соб. код"
      927         prod-cds.cli-base-rate                        column-label "Коэф"
      928         prod-cds.d-pcnt                               column-label "Скидка"
      929         prod-cds.price-sale                           column-label "Цена"
      930         prod-cds.unit-cli                             column-label "Изм"
      931         prod-cds.dtl-name              format "x(20)" column-label "Привязка"
      932         prod-cds.doc-num                              column-label "Переоценка"
      933       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.3 BY 14.13.
      934   DEFINE FRAME d-prod-cds
      935        br-cds AT ROW 2.37 COL 1.1
      936        b-print AT ROW 1 COL 92
      937        b-quit AT ROW 1 COL 1
      938        b-sel AT ROW 1 COL 11
      939        b-mark AT ROW 1 COL 21
      940        b-add AT ROW 1 COL 24
      941        b-help AT ROW 1 COL 95
      942        prod-cds.b-str AT ROW 16.77 COL 1.1 NO-LABEL FORMAT "X(256)"
      943             VIEW-AS FILL-IN
      944             SIZE 98.3 BY 1
      945             FGCOLOR 4
      946        SPACE(0.09) SKIP(0.22)
      947       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      948            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      949            TITLE "Список дополнительных кодов"
      950            DEFAULT-BUTTON b-quit CANCEL-BUTTON b-quit.
      951   ASSIGN
      952          FRAME d-prod-cds:SCROLLABLE       = FALSE
      953          FRAME d-prod-cds:HIDDEN           = TRUE.
      954   ASSIGN
      955          br-cds:NUM-LOCKED-COLUMNS IN FRAME d-prod-cds     = 3.
      956   ON END-ERROR OF FRAME d-prod-cds
      957   OR ENDKEY OF FRAME d-prod-cds DO:
      958      run gbl/markqwa.p (
      959                              input b-mark:sensitive
      960                             , input p-rec-list) no-error.
      961       if error-status:error then return no-apply.
      962   END.
      963   ON WINDOW-CLOSE OF FRAME d-prod-cds
      964   DO:
      965     APPLY "END-ERROR":U TO SELF.
      966   END.
      967   ON CHOOSE OF b-add IN FRAME d-prod-cds
      968   DO:
      969   define variable sc-code like ub.bar-code.b-code no-undo .
      970   DEFINE VARIABLE case-num as integer no-undo .
      971   DEFINE VARIABLE vattr-codes as character no-undo .
      972   DEFINE VARIABLE vattr-labels as character no-undo .
      973   DEFINE VARIABLE voutput as character no-undo .
      974   DEFINE VARIABLE is-ean as logical no-undo init yes.
      975   DEFINE VARIABLE v-on as logical no-undo .
      976   DEFINE VARIABLE v-b-str like ub.prod-bc.b-str no-undo .
      977   define variable glog as logical no-undo .
      978   define variable glog2 as logical no-undo .
      979   define variable glog3 as logical no-undo .
      980   define variable v-main-b-code as integer   no-undo .
      981   define variable conf-par as character no-undo .
      982   define variable par-type as character no-undo .
      983   define variable unq-artc as logical no-undo .
      984   define variable v-prt-rec as recid no-undo .
      985   define variable v-cdrg-type as character no-undo .
      986   define variable v-rid as recid no-undo .
      987   define variable v-param-type as character no-undo .
      988   define variable v-value-character as character no-undo .
      989   define variable v-value-date as date no-undo .
      990   define variable v-value-decimal as decimal no-undo .
      991   define variable v-value-integer as INTEGER no-undo .
      992   define variable v-value-logical AS LOGICAL no-undo .
      993   define variable v-tth as handle no-undo .
      994   define buffer buf_code-range for ub.code-range.
      995   define buffer goods_units for ub.units.
      996   define buffer buf_goods for ub.goods.
      997   assign
      998   v-tth = buffer thbjattr_thbj-attr:table-handle .
      999   find first buf_goods no-lock
     1000        where buf_goods.gds-code = g-code no-error.
     1001   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1002   do:
     1003     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1004       (input  v-cntxt-db-num
     1005       ,input  v-cntxt-userid
     1006       ,input  0
     1007       ,input  'actn_alt-barcode_preparation':U
     1008       ,input  'object':U
     1009       ,input  0
     1010       ,input  '':U
     1011       ,input  0
     1012       ,input  0
     1013       ,input  buf_goods.grp-code
     1014       ,input  0
     1015       ,input  true
     1016       ,output glog
     1017       )  .
     1018   end.
     1019   if not glog then return no-apply.
     1020   find first ub.units no-lock where
     1021               ub.units.unit-name = base-bar-code.unit-cli No-ERROR.
     1022   if not avail ub.units then return no-apply.
     1023   find first goods_units no-lock where
     1024               goods_units.unit-name = ub.goods.unit-base No-ERROR.
     1025   if not avail goods_units then return no-apply.
     1026   if lookup('вес':U, units.type) > 0 then do:
     1027   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
