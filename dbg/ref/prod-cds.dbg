        1   DEFINE TEMP-TABLE prod-cds NO-UNDO LIKE ub.prod-bc
        2          field cli-base-rate like ub.bar-code.cli-base-rate
        3          field unit-cli like ub.bar-code.unit-cli
        4          field in-code like ub.bar-code.in-code
        5          field part-code like ub.bar-code.part-code
        6          field price-sale like ub.price-list.price-sale
        7          field d-pcnt like ub.price-list.d-pcnt
        8          field dtl-name as char
        9          field rid as recid
       10          field doc-num like ub.price-doc.doc-num
       11          field is-global as logical
       12          field is-prod-bc as logical
       13          index pi is unique primary
       14          b-code b-str cr-db-num
       15          .
       16   DEFINE INPUT  PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
       17   define input  parameter p-obj-type like ub.clients.obj-type no-undo .
       18   define input  parameter p-obj-code like ub.clients.obj-code no-undo .
       19   define input  parameter mode     as char             no-undo.
       20   define input  parameter g-code  like ub.goods.gds-code  no-undo.
       21   define input  parameter base-bc like ub.bar-code.b-code no-undo.
       22   define output parameter p-rec-list as char             no-undo.
       23   define variable vss-revision    as character no-undo init "$Revision$":U .
       24   define variable vss-author      as character no-undo init "$Author$":U .
       25   define variable vss-date        as character no-undo init "$Date$":U .
       26   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       27   define variable vss-archive     as character no-undo init "$Archive$":U .
       28   define variable vss-description as character no-undo init "Список дополнительных кодов".
       29   procedure vss-get-info :
       30     define output parameter p-vss-revision    like vss-revision    no-undo .
       31     define output parameter p-vss-author      like vss-author      no-undo .
       32     define output parameter p-vss-date        like vss-date        no-undo .
       33     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       34     define output parameter p-vss-archive     like vss-archive     no-undo .
       35     define output parameter p-vss-description like vss-description no-undo .
       36     assign
       37       p-vss-revision    = vss-revision
       38       p-vss-author      = vss-author
       39       p-vss-date        = vss-date
       40       p-vss-workfile    = vss-workfile
       41       p-vss-archive     = vss-archive
       42       p-vss-description = vss-description
       43     .
       44   end procedure.
       45   procedure vss-get-parameters :
       46     define output parameter p-vss-parameters as character no-undo .
       47   end procedure.
       48   define new global shared variable g#vssrevis-logger as handle    no-undo .
       49   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       50   define variable v-vssrevis-logger                   as handle    no-undo .
       51   procedure vss-logevent :
       52     define input  parameter p-extra-paramters as character no-undo .
       53     define variable v-vssrevis-parameters as character no-undo .
       54     do
       55     on error undo, return error return-value
       56     :
       57       if  valid-handle(v-vssrevis-logger)
       58       and v-vssrevis-logger :get-signature("logevent") <> ""
       59       then do:
       60         run vss-get-parameters in this-procedure
       61           (output v-vssrevis-parameters
       62           ).
       63         run logevent in v-vssrevis-logger
       64           (input vss-workfile
       65           ,input vss-revision
       66           ,input v-vssrevis-parameters
       67           ,input p-extra-paramters
       68           ).
       69       end.
       70     end.
       71   end procedure.
       72   assign
       73     v-vssrevis-logger = g#vssrevis-logger
       74   .
       75   if  valid-handle(v-vssrevis-logger)
       76   and v-vssrevis-logger :get-signature("logevent") <> ""
       77   then do:
       78     assign
       79       v-vssrevis-logevent = true
       80     .
       81     run vss-logevent in this-procedure (input vss-description) .
       82   end.
       83   define new global shared variable g#language as character no-undo .
       84   if g#language <> '' and g#language <> 'rus':U then do:
       85     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       86   end.
       87   define new global shared variable g#library  as handle no-undo .
       88   define new global shared variable g#library2 as handle no-undo .
       89   procedure proc-alt-shift-f2:
       90     if not ibs.th.gbl.gbl-var:rcode
       91   then
       92     run gbl\inidebug.p .
       93   end.
       94   procedure proc-alt-shift-f3:
       95     run gbl/prvssinf.p
       96       ( input this-procedure
       97       ) .
       98   end.
       99   define variable v-inform-launched as logical no-undo initial false .
      100   procedure proc-alt-shift-f4:
      101     define variable v-action as character no-undo .
      102     if v-inform-launched = false then do:
      103       assign
      104         v-inform-launched = true
      105       .
      106       run gbl/d-inform.w
      107         (  input self
      108         ,  input this-procedure
      109         , output v-action
      110         ) no-error .
      111       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      112       assign
      113         v-inform-launched = false
      114       .
      115     end.
      116   end.
      117   procedure proc-alt-f1:
      118     run gbl/corrhelp.p
      119       (input this-procedure
      120       ) .
      121   end .
      122   on alt-shift-f2 anywhere do:
      123     run proc-alt-shift-f2.
      124   end.
      125   on alt-shift-f3 anywhere do:
      126     run proc-alt-shift-f3 in this-procedure .
      127   end.
      128   on alt-shift-f4 anywhere do:
      129     run proc-alt-shift-f4 in this-procedure.
      130   end.
      131   on alt-f1 anywhere do:
      132     run proc-alt-f1 in this-procedure .
      133   end.
      134   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      135   procedure gen-b-code :
      136     define input  parameter type-code like ub.code-range.range-type no-undo .
      137     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
      138     do
      139     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      140     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
      141     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
      142     :
      143       define buffer buf_thbj-attr     for ub.thbj-attr .
      144       define buffer buf_sys-ctrl   for ub.sys-ctrl .
      145       define buffer buf_code-range for ub.code-range .
      146       define variable l-code         as   integer              no-undo .
      147       define variable v-db-num       like ub.db.db-num         no-undo .
      148       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      149       if type-code = 'sslc':U
      150       or type-code = 'ssgb':U
      151       then do:
      152         message
      153           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      154           "Обратитесь к администратору системы."
      155           view-as alert-box error .
      156         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
      157       end.
      158       run trg/getpcode.p ( input  type-code
      159                      ,output cfg-param-code
      160                     ).
      161       run get-next-seq( input  type-code,
      162                         output l-code
      163                       ).
      164       find first buf_sys-ctrl no-lock.
      165       if type-code = 'sclc':U
      166       or type-code = 'pglc':U
      167       then do:
      168         assign
      169           v-db-num = 0
      170         .
      171       end.
      172       else do:
      173         assign
      174           v-db-num = buf_sys-ctrl.db-num
      175         .
      176       end.
      177       find first buf_code-range no-lock
      178         where buf_code-range.db-num     = v-db-num
      179           and buf_code-range.range-type = type-code
      180           and buf_code-range.stts       = "a"
      181         use-index stts
      182         no-error .
      183       if available buf_code-range
      184          and l-code <= buf_code-range.last-code
      185          and l-code >= buf_code-range.first-code then do:
      186         assign
      187           p-b-code = l-code
      188         .
      189       end.
      190       else do:
      191         if available buf_code-range
      192            and l-code < buf_code-range.last-code then do:
      193           message
      194             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      195             "Обратитесь к администратору системы."
      196             view-as alert-box error .
      197           undo, return error "sequence":U .
      198         end.
      199         do transaction
      200         on error undo, return error
      201         :
      202           find first buf_thbj-attr exclusive-lock
      203             where buf_thbj-attr.upper-prop-code = 'code-range':U
      204               and buf_thbj-attr.prop-code = cfg-param-code
      205               and buf_thbj-attr.obj-type   = 'БД':U
      206               and buf_thbj-attr.obj-code   = v-db-num
      207             no-error .
      208           if not available buf_thbj-attr then do:
      209             find first buf_thbj-attr exclusive-lock
      210               where buf_thbj-attr.upper-prop-code = 'code-range':U
      211                 and buf_thbj-attr.prop-code = cfg-param-code
      212                 and buf_thbj-attr.obj-type   = ''
      213                 and buf_thbj-attr.obj-code   = 0
      214               no-error .
      215             if not available buf_thbj-attr then do:
      216               if not locked buf_thbj-attr then do:
      217                 message
      218                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      219                   "Обратитесь к администратору системы."
      220                   view-as alert-box error .
      221               end.
      222               undo, return error "config":U .
      223             end.
      224           end.
      225           run get-next-seq( input type-code,
      226                             output l-code
      227                           ).
      228           find first buf_code-range
      229             where buf_code-range.db-num     = v-db-num
      230               and buf_code-range.range-type = type-code
      231               and buf_code-range.stts       = "a"
      232             use-index stts
      233             no-error .
      234           if available buf_code-range
      235           and l-code <= buf_code-range.last-code
      236           and l-code >= buf_code-range.first-code
      237           then do:
      238             assign
      239               p-b-code = l-code
      240             .
      241           end.
      242           else do:
      243             if available buf_code-range then do:
      244               assign
      245                 buf_code-range.stts = "u"
      246               .
      247             end.
      248             find first buf_code-range
      249               where buf_code-range.db-num     = v-db-num
      250                 and buf_code-range.range-type = type-code
      251                 and buf_code-range.stts       = "f"
      252               use-index stts
      253               no-error .
      254             if not available buf_code-range then do:
      255               message
      256                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      257                 "Обратитесь к администратору системы"
      258                 view-as alert-box error .
      259               undo, return error "code-range":U .
      260             end.
      261             assign
      262               buf_code-range.stts           = "a"
      263             .
      264             if buf_code-range.first-code = 1 then do:
      265               run set-seq-cr( input type-code,
      266                               input buf_code-range.first-code
      267                             ).
      268               assign
      269                 p-b-code = 1
      270               .
      271             end.
      272             else do:
      273               run set-seq-cr( input type-code,
      274                               input ( buf_code-range.first-code - 1 )
      275                             ).
      276               run get-next-seq( input type-code,
      277                                 output p-b-code
      278                               ).
      279             end.
      280           end.
      281         end.
      282       end.
      283     end.
      284   end procedure.
      285   procedure get-next-seq :
      286     define input  parameter type-code like ub.code-range.range-type no-undo .
      287     define output parameter next-seq  as   integer                  no-undo .
      288     do
      289     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      290     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      291     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      292     :
      293       case type-code:
      294         when 'bcgb':U then do:
      295           assign
      296             next-seq = next-value(s-bcgb-code, ub)
      297           .
      298         end.
      299         when 'scgb':U then do:
      300           assign
      301             next-seq = next-value(s-scgb-code, ub)
      302           .
      303         end.
      304         when 'sclc':U then do:
      305           assign
      306             next-seq = next-value(s-sclc-code, ub)
      307           .
      308         end.
      309         when 'pglc':U then do:
      310           assign
      311             next-seq = next-value(s-pglc-code, ub)
      312           .
      313         end.
      314         when 'dcgb':U then do:
      315           assign
      316             next-seq = next-value(s-dcgb-code, ub)
      317           .
      318         end.
      319         when 'ctgb':U then do:
      320           assign
      321             next-seq = next-value(s-ctgb-code, ub)
      322           .
      323         end.
      324         when 'drgb':U then do:
      325           assign
      326             next-seq = next-value(s-drgb-code, ub)
      327           .
      328         end.
      329         when 'fmgb':U then do:
      330           assign
      331             next-seq = next-value(s-fmgb-code, ub)
      332           .
      333         end.
      334         when 'pngb':U then do:
      335           assign
      336             next-seq = next-value(s-pngb-code, ub)
      337           .
      338         end.
      339         when 'cagb':U then do:
      340           assign
      341             next-seq = next-value(s-cagb-code, ub)
      342           .
      343         end.
      344         when 'fdgb':U then do:
      345           assign
      346             next-seq = next-value(s-fin-doc, ub)
      347           .
      348         end.
      349       end case.
      350     end.
      351   end procedure.
      352   procedure set-seq-cr :
      353     define input parameter type-code like ub.code-range.range-type no-undo .
      354     define input parameter set-val   like ub.code-range.first-code no-undo .
      355     do
      356     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      357     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      358     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      359     :
      360       case type-code:
      361         when 'bcgb':U then do:
      362           assign
      363             current-value(s-bcgb-code, ub) = set-val
      364           .
      365         end.
      366         when 'scgb':U then do:
      367           assign
      368             current-value(s-scgb-code, ub) = set-val
      369           .
      370         end.
      371         when 'sclc':U then do:
      372           assign
      373             current-value(s-sclc-code, ub) = set-val
      374           .
      375         end.
      376         when 'pglc':U then do:
      377           assign
      378             current-value(s-pglc-code, ub) = set-val
      379           .
      380         end.
      381         when 'dcgb':U then do:
      382           assign
      383             current-value(s-dcgb-code, ub) = set-val
      384           .
      385         end.
      386         when 'ctgb':U then do:
      387           assign
      388             current-value(s-ctgb-code, ub) = set-val
      389           .
      390         end.
      391         when 'drgb':U then do:
      392           assign
      393             current-value(s-drgb-code, ub) = set-val
      394           .
      395         end.
      396         when 'fmgb':U then do:
      397           assign
      398             current-value(s-fmgb-code, ub) = set-val
      399           .
      400         end.
      401         when 'pngb':U then do:
      402           assign
      403             current-value(s-pngb-code, ub) = set-val
      404           .
      405         end.
      406         when 'cagb':U then do:
      407           assign
      408             current-value(s-cagb-code, ub) = set-val
      409           .
      410         end.
      411         when 'fdgb':U then do:
      412           assign
      413             current-value(s-fin-doc, ub) = set-val
      414           .
      415         end.
      416       end case.
      417     end.
      418   end procedure.
      419   procedure new-bcod-gen-code-range :
      420     do
      421     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      422     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      423     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      424     :
      425       define input parameter p-db-num  like ub.db.db-num             no-undo .
      426       define input parameter type-code like ub.code-range.range-type no-undo .
      427       define buffer buf_code-range      for ub.code-range .
      428       define buffer last_code-range     for ub.code-range .
      429       define buffer last-1_code-range   for ub.code-range .
      430       define buffer last-2_code-range   for ub.code-range .
      431       define buffer last-3_code-range   for ub.code-range .
      432       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      433       define variable conf-par       as character no-undo .
      434       define variable par-type       as character no-undo .
      435       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      436       define variable v-cre-cdrg as logical   no-undo .
      437       define variable v-cre-str  as character no-undo .
      438       define variable v-cr1      as integer no-undo .
      439       define variable v-cr2      as integer no-undo .
      440       define variable v-cr3      as integer no-undo .
      441       define variable v-cmax     as integer no-undo .
      442       find first buf_sys-ctrl no-lock .
      443       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      444         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      445                                       ,vss-workfile
      446                                       ,vss-revision
      447                                       ,vss-description
      448                                       ,chr(10)
      449                                       , p-db-num
      450                                      ).
      451       end.
      452       run trg/getpcode.p ( input  type-code
      453                      ,output cfg-param-code
      454                     ).
      455       for each buf_code-range
      456         where buf_code-range.db-num     = -1
      457           and buf_code-range.range-type = type-code
      458           and buf_code-range.stts       = "f"
      459       by buf_code-range.first-code
      460       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      461       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      462       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      463       :
      464         assign
      465           buf_code-range.db-num = p-db-num
      466         .
      467         return .
      468       end.
      469       assign
      470         v-cre-cdrg = TRUE
      471       .
      472       case type-code:
      473         when 'sclc':U
      474         or when 'scgb':U
      475         or when 'pglc':U
      476         then do:
      477           find last last-1_code-range no-lock
      478             where last-1_code-range.range-type = 'sclc':U
      479             no-error .
      480           if available last-1_code-range then do:
      481             v-cr1 = last-1_code-range.last-code.
      482           end.
      483           find last last-2_code-range no-lock
      484             where last-2_code-range.range-type = 'scgb':U
      485             no-error .
      486           if available last-2_code-range then do:
      487             v-cr2 = last-2_code-range.last-code.
      488             end.
      489           find last last-3_code-range no-lock
      490             where last-3_code-range.range-type = 'pglc':U
      491             no-error .
      492           if available last-3_code-range then do:
      493             v-cr3 = last-3_code-range.last-code.
      494           end.
      495           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      496           .
      497           if v-cmax = v-cr1  then do:
      498               find last last_code-range no-lock
      499                 where recid( last_code-range ) = recid( last-1_code-range )
      500                 .
      501             end.
      502           if v-cmax = v-cr2  then do:
      503               find last last_code-range no-lock
      504                 where recid( last_code-range ) = recid( last-2_code-range )
      505                 .
      506             end.
      507           if v-cmax = v-cr3  then do:
      508             find last last_code-range no-lock
      509               where recid( last_code-range ) = recid( last-3_code-range )
      510               .
      511           end.
      512           if last_code-range.last-code + 1 > 99999 then do:
      513             assign
      514               v-cre-cdrg = FALSE
      515             .
      516           end.
      517         end.
      518         when 'bcgb':U
      519         or when 'sslc':U
      520         or when 'ssgb':U
      521         then do:
      522           find last last-1_code-range no-lock
      523             where last-1_code-range.range-type = 'sslc':U
      524             no-error .
      525           if available last-1_code-range then do:
      526             v-cr1 = last-1_code-range.last-code.
      527           end.
      528           find last last-2_code-range no-lock
      529             where last-2_code-range.range-type = 'bcgb':U
      530             no-error .
      531           if available last-2_code-range then do:
      532             v-cr2 = last-2_code-range.last-code.
      533             end.
      534           find last last-3_code-range no-lock
      535             where last-3_code-range.range-type = 'ssgb':U
      536             no-error .
      537           if available last-3_code-range then do:
      538             v-cr3 = last-3_code-range.last-code.
      539           end.
      540           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      541           .
      542           if v-cmax = v-cr1  then do:
      543               find last last_code-range no-lock
      544                 where recid( last_code-range ) = recid( last-1_code-range )
      545                 .
      546             end.
      547           if v-cmax = v-cr2  then do:
      548               find last last_code-range no-lock
      549                 where recid( last_code-range ) = recid( last-2_code-range )
      550                 .
      551             end.
      552           if v-cmax = v-cr3  then do:
      553             find last last_code-range no-lock
      554               where recid( last_code-range ) = recid( last-3_code-range )
      555               .
      556           end.
      557         end.
      558         otherwise do:
      559           find last last_code-range no-lock
      560             where last_code-range.range-type = type-code
      561             no-error .
      562         end.
      563       end case.
      564       if not available last_code-range then do:
      565         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      566                                       ,vss-workfile
      567                                       ,vss-revision
      568                                       ,vss-description
      569                                       , chr(10)
      570                                       , type-code
      571                                      ) .
      572       end.
      573       define variable v-mes0 as character no-undo .
      574       define variable v-param-type0 as character no-undo .
      575       define variable v-value-character0 as INTEGER no-undo .
      576       define variable v-value-date0 as date no-undo .
      577       define variable v-value-decimal0 as decimal no-undo .
      578       define variable v-value-integer0 AS integer no-undo .
      579       define variable v-value-logical0 AS LOGICAL no-undo .
      580       define variable v-tth0 as handle no-undo .
      581       run adm/shattri.p (
      582           input "get":U
      583           ,input  'БД':U
      584           ,input  p-db-num
      585           ,input  'code-range':U
      586           ,input  cfg-param-code
      587           ,output v-value-character0
      588           ,output v-value-date0
      589           ,output v-value-decimal0
      590           ,output v-value-integer0
      591           ,output v-value-logical0
      592           ,output v-param-type0
      593           ,INPUT-OUTPUT table-handle v-tth0
      594           ) no-error .
      595       if error-status :error then do:
      596         delete object v-tth0.
      597         v-mes0 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      598                            , error-status:get-message(1)
      599                            , chr(10)
      600                            , return-value ).
      601         undo, return error v-mes0.
      602       end.
      603       delete object v-tth0.
      604       if v-cre-cdrg = TRUE then do:
      605         create buf_code-range .
      606         assign
      607           buf_code-range.db-num     = p-db-num
      608           buf_code-range.range-type = type-code
      609           buf_code-range.stts       = "f"
      610           buf_code-range.first-code = last_code-range.last-code + 1
      611           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer0)
      612           v-cre-str = "Свободный диапазон успешно создан"
      613         .
      614       end.
      615       else do:
      616         assign
      617           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
      618                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
      619         .
      620       end.
      621     end.
      622     return v-cre-str .
      623   end procedure.
      624   procedure gen-new-code-range-if-neces :
      625     define input parameter v-db-num           like ub.db.db-num             no-undo .
      626     define input parameter v-range-type       like ub.code-range.range-type no-undo .
      627     define input parameter v-cur-code         as   integer                  no-undo .
      628     define input parameter v-g#news           as   logical                  no-undo .
      629     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
      630     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
      631     do
      632     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      633     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
      634     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
      635     :
      636       define variable l-code-range-exist as logical   no-undo init false .
      637       define variable v-db-for-send      as character no-undo .
      638       define buffer buf_code-range  for ub.code-range .
      639       define buffer buf1_code-range for ub.code-range .
      640       define buffer buf_db          for ub.db .
      641       find first buf_code-range
      642         where buf_code-range.range-type = v-range-type
      643           and buf_code-range.last-code >= v-cur-code
      644         use-index last-codei
      645         no-error .
      646       if
      647       (
      648          available buf_code-range
      649          and
      650         (buf_code-range.db-num = v-db-num
      651           and
      652         buf_code-range.first-code <= v-cur-code
      653         )
      654       or
      655         (
      656           v-range-type = 'drgb':U
      657           AND
      658           v-cur-code = 0
      659         )
      660      )
      661      then do:
      662         assign
      663           l-code-range-exist = true
      664         .
      665         if v-g#news
      666         and buf_code-range.stts = "f" then do:
      667           assign
      668             buf_code-range.stts = "u"
      669           .
      670         end.
      671       end.
      672       if not l-code-range-exist
      673          and v-g#news-source-db <> 0
      674       then do:
      675         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
      676                                       ,vss-workfile
      677                                       ,vss-revision
      678                                       ,vss-description
      679                                       ,chr(10)
      680                                       ,v-db-num
      681                                       ,v-range-type
      682                                       ,v-cur-code
      683                                      ).
      684       end.
      685       if (not l-code-range-exist
      686           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
      687          )
      688       and ( not can-find (first buf1_code-range no-lock
      689                           where buf1_code-range.db-num = v-db-num
      690                             and buf1_code-range.range-type = v-range-type
      691                             and buf1_code-range.stts = "f"
      692                          )
      693           )
      694       then do:
      695         if v-g#db-num = 0 then do:
      696           run new-bcod-gen-code-range in this-procedure
      697             (input v-db-num,
      698              input v-range-type
      699             ) no-error .
      700           if error-status :error then do:
      701             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
      702                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
      703                                           ,v-db-num
      704                                           ,v-range-type
      705                                           ,v-cur-code
      706                                           ,chr(10)
      707                                           ,error-status:get-message(1)
      708                                           ,return-value
      709                                          ).
      710           end.
      711         end.
      712         else do:
      713           if v-range-type = 'sclc':U
      714           or v-range-type = 'pglc':U
      715           then do:
      716             assign
      717               v-db-for-send = "":U
      718             .
      719             if v-g#db-num = 0 then do:
      720               for each buf_db no-lock
      721                 where buf_db.db-num > 0
      722                   and buf_db.db-num <> v-g#news-source-db
      723               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      724               :
      725                 assign
      726                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
      727                 .
      728               end.
      729               assign
      730                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
      731               .
      732             end.
      733             else do:
      734               if not v-g#news then do:
      735                 assign
      736                   v-db-for-send = "0":U
      737                 .
      738               end.
      739             end.
      740             run nws/cr-route.p ( input 'send-cmd':U
      741                           ,input ("command":U + chr(1) + "create":U + chr(1) +
      742                                  "code-range":U + chr(1) +
      743                                  (if v-range-type = 'sclc':U
      744                                   then string( current-value(s-sclc-code, ub))
      745                                   else string( current-value(s-pglc-code, ub))
      746                                   ) + chr(1) +
      747                                   v-range-type)
      748                           ,input ?
      749                           ,input v-db-for-send
      750                           ) no-error .
      751             if error-status :error then do:
      752               undo, return error return-value.
      753             end.
      754           end.
      755         end.
      756       end.
      757     end.
      758   end procedure.
      759   procedure cre-loc-sc-code-range :
      760     define input parameter v-cur-code as integer no-undo .
      761   define input parameter p-cdrg-type as character no-undo .
      762     do
      763     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      764     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
      765     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
      766     :
      767       define buffer buf_code-range for ub.code-range .
      768       find first buf_code-range
      769            where buf_code-range.range-type = p-cdrg-type
      770              and buf_code-range.first-code >= v-cur-code
      771            no-error .
      772       if not available buf_code-range then do:
      773         run new-bcod-gen-code-range in this-procedure
      774           ( input 0,
      775             input p-cdrg-type
      776           ) no-error .
      777         if error-status :error then do:
      778           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
      779                                          + "Код &2&1&3 &4"
      780                                         , chr(10)
      781                                         , v-cur-code
      782                                         , error-status:get-message(1)
      783                                         , return-value
      784                                        ) .
      785         end.
      786       end.
      787     end.
      788   end procedure.
      789   procedure mark-used-if-need :
      790   define input parameter p-cur-code as integer no-undo .
      791   define input parameter p-range-type like ub.code-range.range-type no-undo .
      792   define input parameter p-db-num like ub.code-range.db-num no-undo .
      793     do
      794     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      795     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
      796     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
      797     :
      798       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
      799       define buffer buf_code-range for ub.code-range .
      800       assign
      801       v-db-num = if p-range-type = 'sclc':U
      802                  then 0
      803                  else p-db-num
      804       .
      805   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      806   define buffer locK-batchprocess1 for ub.batchprocess.
      807   run gbl/lock-prc.p
      808       (input 'lscc':U
      809       ,input 0
      810       ,input 0
      811       ,input 0
      812       ,input ""
      813       ,input ""
      814       ,input ""
      815       ,input (
      816               ",,,Вкл/выкл лок. вес. кодов"
      817              )
      818       ,input true
      819       ,buffer lock-batchprocess1
      820       ) no-error .
      821     if error-status :error then do:
      822       message
      823         vss-workfile vss-revision vss-description skip
      824         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
      825         view-as alert-box error .
      826       undo, return error .
      827     end.
      828       find first buf_code-range
      829            where buf_code-range.range-type = p-range-type
      830              and buf_code-range.first-code >= p-cur-code
      831              and buf_code-range.last-code <= p-cur-code
      832              and buf_code-range.db-num = v-db-num
      833            no-error .
      834       if not available buf_code-range then do:
      835         message
      836           vss-workfile vss-revision vss-description skip
      837           "Ошибка при создании поиске диапазона" skip
      838           "База данных" p-db-num skip
      839           "Код" p-cur-code skip
      840           "Тип" p-range-type
      841           error-status :get-message(1) skip
      842           return-value skip
      843           view-as alert-box error .
      844         undo, return error .
      845       end.
      846       if buf_code-range.stts = "f":U then do:
      847         assign
      848         buf_code-range.stts = "u":U
      849         .
      850       end.
      851     end.
      852   end procedure.
      853   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      854   FUNCTION MakeShbl RETURNS CHARACTER(input par-int1 as integer, input par-int2 as integer):
      855   DEFINE VARIABLE ii as integer no-undo init 1.
      856   DEFINE VARIABLE var-char1 as character no-undo .
      857   DEFINE VARIABLE var-char2 as character no-undo .
      858   DEFINE VARIABLE par-shbl as character no-undo .
      859   assign
      860   var-char1 = string(par-int1)
      861   var-char2 = string(par-int2)
      862   .
      863   if length(var-char1) <> length(var-char2) then return error.
      864   do while ii <= length(var-char1):
      865     if substring(var-char1, ii, 1) = substring(var-char2, ii, 1) then do:
      866       par-shbl = par-shbl + substring(var-char1, ii, 1).
      867     end.
      868     else do:
      869       par-shbl = par-shbl + fill("?", length(var-char1) - length(par-shbl)).
      870       return par-shbl.
      871     end.
      872     ii = ii + 1.
      873   end.
      874   END FUNCTION.
      875   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
