     2398   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2399   define variable v-waitfram-action01         as character   no-undo .
     2400   define variable v-waitfram-action02         as character   no-undo .
     2401   define variable v-waitfram-action03         as character   no-undo .
     2402   define variable mWaitFramTextBeg            as character   no-undo.
     2403   define variable mWaitFramTextEnd            as character   no-undo.
     2404   define variable mWaitFramView               as logical     no-undo.
     2405   define variable mWaitProcEvent              as logical     no-undo init yes.
     2406   define variable mWaitFramInterval           as integer     no-undo init 1 .
     2407   define variable mWaitFramStop               as logical     no-undo.
     2408   define variable mWaitFramStopUser           as logical     no-undo.
     2409   define variable mWaitFramStopTimeOut        as logical     no-undo.
     2410   define variable mWaitFramStartProc          as datetime-tz no-undo.
     2411   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     2412   define button B-WaitFramStop auto-end-key
     2413        label "Стоп"
     2414        size 10 by 1 tooltip "Остоновить процесс".
     2415   define button B-viewProcInfo
     2416        label "Информация"
     2417        size 15 by 1 tooltip "Информация о процесс".
     2418   define frame waitfram
     2419     v-waitfram-action01 format "x(72)" no-label skip
     2420     v-waitfram-action02 format "x(72)" no-label skip
     2421     v-waitfram-action03 format "x(72)" no-label skip
     2422     B-viewProcInfo
     2423     B-WaitFramStop at row 4 col 30
     2424     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     2425     .
     2426   define new global shared variable mBatchMode as logical no-undo init ?.
     2427   define variable mFramBachModHandle as handle no-undo.
     2428   mFramBachModHandle = frame waitfram:handle.
     2429   define variable mFameOldVis as logical no-undo.
     2430   define variable mVisCUrentVin as logical no-undo.
     2431   if session:batch-mode
     2432   then
     2433      mBatchMode = yes.
     2434   if mBatchMode = ? then do:
     2435     mVisCUrentVin = current-window:visible.
     2436     mFameOldVis = mFramBachModHandle:visible.
     2437     mFramBachModHandle:visible  = yes.
     2438     mBatchMode = mFramBachModHandle:visible ne yes.
     2439     mFramBachModHandle:visible = mFameOldVis.
     2440     current-window:visible = mVisCUrentVin.
     2441   end.
     2442    if  log-manager:logfile-name ne ?
     2443     then DO:
     2444         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2445         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2446         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     2447     end.
     2448   on choose of B-WaitFramStop in frame waitfram
     2449   do:
     2450     mWaitFramStop = yes.
     2451     mWaitFramStopUser = yes.
     2452   end.
     2453   function waitfram-check-timeout returns logical():
     2454      define variable vtime as int64 no-undo.
     2455      if mWaitFramStopTimeOut
     2456      then
     2457         return yes.
     2458      vtime = ( now - mWaitFramStartProc ) / 1000 .
     2459      if     mWaitFramTimeOut ne ?
     2460         and mWaitFramTimeOut ne 0
     2461         and mWaitFramTimeOut lt vtime
     2462      then do:
     2463         mWaitFramStopTimeOut = yes.
     2464      end.
     2465      return mWaitFramStopTimeOut.
     2466   end.
     2467   procedure waitfram-hide :
     2468     if not session:batch-mode
     2469     then do
     2470     on error undo, return error return-value
     2471     :
     2472       pause 0 before-hide .
     2473       if not mBatchMode then
     2474         hide frame waitfram .
     2475     if     not mWaitFramView
     2476        and mWaitProcEvent
     2477     then
     2478       process events .
     2479     end.
     2480   end procedure.
     2481   procedure waitfram-show :
     2482     define input  parameter p-message as character no-undo .
     2483     define variable v-left-margin as integer   no-undo .
     2484     if not session:batch-mode
     2485     then do
     2486     on error undo, return error return-value
     2487     :
     2488       if length(p-message) <= 70 then do:
     2489         assign
     2490           v-left-margin = integer((70 - length(p-message)) / 2)
     2491         .
     2492         assign
     2493           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     2494         .
     2495         assign
     2496           v-waitfram-action01 = " "
     2497           v-waitfram-action02 = " "
     2498                                    + fill(" ", v-left-margin)
     2499                                    + p-message
     2500           v-waitfram-action03 = " "
     2501         .
     2502       end.
     2503       else do:
     2504         define variable vRindex1 as integer no-undo.
     2505         define variable vRindex2 as integer no-undo.
     2506         vRindex1 = r-index(p-message," ",70).
     2507         if vRindex1 = 0
     2508         then
     2509            vRindex1 = 70.
     2510         if length(p-message)  <= vRindex1 + 70 then do:
     2511           assign
     2512             v-waitfram-action01 = " "
     2513             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     2514             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     2515           .
     2516         end.
     2517         else do:
     2518           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     2519           if vRindex2 <= vRindex1
     2520           then
     2521              vRindex2 = vRindex1 + 70.
     2522           assign
     2523             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     2524             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     2525             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     2526           .
     2527         end.
     2528       end.
     2529       B-viewProcInfo:visible   in frame waitfram = no.
     2530       B-viewProcInfo:sensitive in frame waitfram = no.
     2531       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2532       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2533       if  (   mWaitFramView
     2534          or  mWaitProcEvent)
     2535          and not mBatchMode
     2536       then
     2537          display
     2538             v-waitfram-action01 skip
     2539             v-waitfram-action02 skip
     2540             v-waitfram-action03 skip
     2541          with frame waitfram .
     2542       if     mWaitFramView
     2543          then do:
     2544             if     mWaitFramInterval ne ?
     2545                and not mBatchMode
     2546             then
     2547                wait-for go of frame waitfram pause mWaitFramInterval.
     2548          end.
     2549          else
     2550             if     mWaitProcEvent
     2551                and not mBatchMode
     2552             then
     2553                process events .
     2554     end.
     2555   end procedure.
     2556      procedure waitfram-show-this:
     2557         define input  parameter iInterval as int64 no-undo.
     2558         define variable vtime as int64 no-undo.
     2559         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     2560         mWaitFramInterval = iInterval.
     2561         run waitfram-show (substitute("&1&2 &3&4" ,
     2562                                       mWaitFramTextBeg ,
     2563                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     2564                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     2565                                       mWaitFramTextEnd
     2566                                      )
     2567                           ).
     2568      end.
     2569      procedure WaitFramRunPause:
     2570         define input  parameter iInterval as dec no-undo.
     2571         define variable vStart  as datetime-tz no-undo.
     2572         define variable vend    as datetime-tz no-undo.
     2573         define variable vint as int64 no-undo.
     2574         define variable vOk as logical no-undo.
     2575         vStart = now.
     2576         vend   = vStart.
     2577         publish "WaitFramPause" (iInterval,output vOk).
     2578         vend   =  now.
     2579         vint = vend - vStart.
     2580         vint = iInterval - vint / 1000.
     2581         if     not mWaitFramStop
     2582            and (   vint > 0
     2583                 or (    not vOk
     2584                     and iInterval eq ?
     2585                     )
     2586                 )
     2587         then
     2588            run waitfram-show-this (iInterval).
     2589         vend   =  now.
     2590         vint = vend - vStart.
     2591         vint = iInterval - vint / 1000.
     2592         if     not mWaitFramStop
     2593            and vint > 0
     2594         then do:
     2595            run gbl/pause.p (vint * 1000).
     2596         end.
     2597         if iInterval ne ?
     2598         then
     2599            publish "WaitFramStop".
     2600         waitfram-check-timeout().
     2601      end.
     2602      procedure WaitFramWaitFor:
     2603         define input  parameter iInterval as dec no-undo.
     2604         assign
     2605            mWaitFramStartProc   = now
     2606            mWaitFramStopUser    = no
     2607            mWaitFramStopTimeOut = no
     2608         .
     2609         block-wait:
     2610         do while not mWaitFramStop:
     2611            run WaitFramRunPause (iInterval).
     2612            if  waitfram-check-timeout()
     2613            then do:
     2614               leave block-wait.
     2615            end.
     2616         end.
     2617         run waitfram-hide.
     2618      end.
     2619   procedure waitfram-join :
     2620     define input  parameter p-line-1  as character no-undo .
     2621     define input  parameter p-line-2  as character no-undo .
     2622     define input  parameter p-line-3  as character no-undo .
     2623     define output parameter p-message as character no-undo .
     2624     do
     2625     on error undo, return error return-value
     2626     :
     2627       assign
     2628         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     2629                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     2630                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     2631       .
     2632     end.
     2633   end procedure.
     2634   function waitfram-join-function returns character
     2635     (input p-line-1 as character
     2636     ,input p-line-2 as character
     2637     ,input p-line-3 as character
     2638     ).
     2639     define variable v-message as character no-undo .
     2640     run waitfram-join in this-procedure
     2641       (input  p-line-1
     2642       ,input  p-line-2
     2643       ,input  p-line-3
     2644       ,output v-message
     2645       ) .
     2646     return v-message .
     2647   end function .
     2648   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2649   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
     2650   define variable gp-price-sale like ub.price-list.price-sale no-undo.
     2651   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
     2652   define variable gp-excise     like ub.price-list.excise     no-undo.
     2653   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
     2654   define variable gp-fact-order as decimal   no-undo .
     2655   define variable gp-price-sale-parts as decimal   no-undo .
     2656   def var vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2657   procedure check-use-bar-code :
     2658     define input  parameter p-b-code    like ub.bar-code.b-code no-undo .
     2659     do
     2660     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info21, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2661     on stop   undo, return error substitute( "&1. stop", vss-include-info21 )
     2662     on endkey undo, return error substitute( "&1. endkey", vss-include-info21 )
     2663     :
     2664       define buffer buf_bar-code for ub.bar-code .
     2665       find first buf_bar-code no-lock
     2666         where buf_bar-code.b-code     = p-b-code
     2667         no-error .
     2668       if not available buf_bar-code then do:
     2669         return error substitute( "&1 (check-use-bar-code). Не найден бар-код &2", vss-include-info21, p-b-code ) .
     2670       end.
     2671       if buf_bar-code.stts = integer('99':U) then do:
     2672         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     2673                                 + "Выполняется удаление бар-кода"
     2674                                 ,vss-include-info21
     2675                                 ,p-b-code
     2676                                 ,chr(10)
     2677                               ) .
     2678       end.
     2679       if buf_bar-code.stts = integer('79':U) then do:
     2680         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
     2681                                 + "Бар-код выключен"
     2682                                 ,vss-include-info21
     2683                                 ,p-b-code
     2684                                 ,chr(10)
     2685                               ) .
     2686       end.
     2687       return .
     2688     end.
     2689   end procedure.
     2690   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2691   define temp-table tt-level-dis-attr no-undo
     2692         field attr-code   like global-state-attr.attr-code
     2693         field attr-value  like global-state-attr.attr-value
     2694         index pi   attr-value descending
     2695         index pi1 is unique attr-value
     2696               attr-code .
     2697   procedure lvldsc-byattr :
     2698   define input  parameter p-attr-code  as character no-undo .
     2699   define input  parameter p-attr-value as character no-undo .
     2700   define output parameter p-val1       as decimal   no-undo .
     2701   define output parameter p-val2       as decimal   no-undo .
     2702   define output parameter p-prc        as decimal   no-undo .
     2703     do
     2704     on error undo, return error return-value
     2705     :
     2706     define variable v-str1 as character no-undo .
     2707     v-str1 = trim ( p-attr-code , 'level-discnt':U ) .
     2708     v-str1 = trim ( v-str1 , chr(4) ) .
     2709    run lvldsc-bytt (
     2710         input   v-str1
     2711       , input   p-attr-value
     2712       , output  p-val1
     2713       , output  p-val2
     2714       , output  p-prc )
     2715         no-error .
     2716     end.
     2717   end procedure.
     2718   procedure lvldsc-bytt :
     2719   define input  parameter p-attr-code as character no-undo .
     2720   define input  parameter p-attr-value as character no-undo .
     2721   define output parameter p-val1 as decimal   no-undo .
     2722   define output parameter p-val2 as decimal   no-undo .
     2723   define output parameter p-prc  as decimal   no-undo .
     2724   define variable v-str1 as character no-undo .
     2725     do
     2726     on error undo, return error return-value
     2727     :
     2728     assign
     2729        v-str1 = trim ( p-attr-code , "[]()" )
     2730        p-val1 = decimal(entry(1,v-str1, ";"))
     2731        p-val2 = decimal(entry(2,v-str1, ";"))
     2732        p-prc  = decimal(p-attr-value)
     2733        no-error
     2734     .
     2735     end.
     2736   end procedure.
     2737   procedure level-dis-value :
     2738   define input  parameter p-price-prod as decimal   no-undo .
     2739   define input  parameter p-b-code     as integer   no-undo .
     2740   define input  parameter p-obj-type   as character no-undo .
     2741   define input  parameter p-obj-code   as integer   no-undo .
     2742   define output parameter p-prc as decimal   no-undo .
     2743   define variable v-level-dis-attr as character no-undo .
     2744   define variable v-type as character no-undo .
     2745   define variable v-val1 as decimal   no-undo .
     2746   define variable v-val2 as decimal   no-undo .
     2747   define variable v-prc  as decimal   no-undo .
     2748   define variable ix     as integer   no-undo .
     2749   do
     2750    on error undo, return error return-value
     2751    :
     2752   define buffer buf_goods for ub.goods  .
     2753   define buffer buf_bar-code for ub.bar-code  .
     2754   find first buf_bar-code no-lock where
     2755              buf_bar-code.b-code = p-b-code
     2756              no-error .
     2757   find first buf_goods no-lock where
     2758              buf_goods.gds-code = buf_bar-code.gds-code
     2759              no-error .
     2760   run ggoattr-value (
     2761      input   buf_goods.grp-code
     2762     ,input   v-cntxt-host-code-obj
     2763     ,input   p-obj-type
     2764     ,input   p-obj-code
     2765     ,input   'level-dis':U
     2766     ,output  v-level-dis-attr
     2767     ,output  v-type ) no-error .
     2768   repeat ix = 1 to num-entries (v-level-dis-attr, chr(4)) - 1 :
     2769     create
     2770       tt-level-dis-attr
     2771     .
     2772     tt-level-dis-attr.attr-code = entry (1, entry (ix, v-level-dis-attr, chr(4)), chr(44)) .
     2773     tt-level-dis-attr.attr-value = entry (2, entry (ix, v-level-dis-attr, chr(4)), chr(44)) .
     2774   end.
     2775   p-prc = 0 .
     2776     if p-price-prod = 0 then do:
     2777         for each tt-level-dis-attr no-lock
     2778                 :
     2779               run lvldsc-bytt (
     2780                 input   tt-level-dis-attr.attr-code
     2781               , input   tt-level-dis-attr.attr-value
     2782               , output  v-val1
     2783               , output  v-val2
     2784               , output  v-prc  )
     2785               .
     2786               if v-val1  = 0  then do:
     2787                  p-prc = v-prc .
     2788                 leave.
     2789               end.
     2790         end.
     2791     end.
     2792     else do:
     2793         for each tt-level-dis-attr no-lock
     2794                 :
     2795               run lvldsc-bytt (
     2796                 input   tt-level-dis-attr.attr-code
     2797               , input   tt-level-dis-attr.attr-value
     2798               , output  v-val1
     2799               , output  v-val2
     2800               , output  v-prc  )
     2801               .
     2802               if p-price-prod   > v-val1 and
     2803                  p-price-prod  <= v-val2 then do:
     2804                  p-prc = v-prc .
     2805                 leave.
     2806               end.
     2807         end.
     2808     end.
     2809   for each tt-level-dis-attr no-lock. delete tt-level-dis-attr. end.
     2810    end.
     2811   end procedure.
     2812   procedure calc-price-levelprod :
     2813   define input  parameter p-mode     as integer   no-undo .
     2814   define input  parameter p-rb       as character no-undo .
     2815   define input  parameter p-b-code   as integer   no-undo .
     2816   define input  parameter p-obj-type as character no-undo .
     2817   define input  parameter p-obj-code as integer   no-undo .
     2818   define output parameter p-price-sale as decimal   no-undo .
     2819   define output parameter p-descript-calc as character no-undo .
     2820   define variable  v-PriceWithoutVat as decimal   no-undo init 0.
     2821   define variable  v-PriceWithVat    as decimal   no-undo init 0.
     2822   define variable  v-prod-vat        as decimal   no-undo init 0.
     2823   define variable  v-discnt          as decimal   no-undo init 0.
     2824   define buffer buf_goods for ub.goods  .
     2825   define buffer buf_bar-code for ub.bar-code  .
     2826   define buffer buf_parts for ub.parts  .
     2827   define variable v-part-code as character no-undo .
     2828   define variable v-in-code   as character no-undo .
     2829     do
     2830     on error undo, return error return-value
     2831     :
     2832   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2833   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run proprice in g#library
     2834   (  input  p-b-code
     2835    , input  p-obj-type
     2836    , input  p-obj-code
     2837    , output v-PriceWithoutVat
     2838    , output v-PriceWithVat
     2839    , output v-prod-vat
     2840    , output v-part-code
     2841    , output v-in-code
     2842           ) no-error .
     2843         if error-status :error then do:
     2844           return error "Нет цены производителя!".
     2845         end.
     2846   find first buf_bar-code no-lock where
     2847              buf_bar-code.b-code = p-b-code
     2848              no-error .
     2849   find first buf_goods no-lock where
     2850              buf_goods.gds-code = buf_bar-code.gds-code
     2851              no-error .
     2852   find first buf_parts no-lock where
     2853              buf_parts.artic      = buf_goods.artic        and
     2854              buf_parts.prod-type  = buf_goods.prod-type    and
     2855              buf_parts.prod-code  = buf_goods.prod-code    and
     2856              buf_parts.in-code    = buf_bar-code.in-code   and
     2857              buf_parts.out-code   = buf_bar-code.in-code   and
     2858              buf_parts.part-code  = buf_bar-code.part-code
     2859              no-error .
     2860               if error-status :error then do:
     2861                   find first buf_parts no-lock where
     2862                             buf_parts.artic      = buf_goods.artic        and
     2863                             buf_parts.prod-type  = buf_goods.prod-type    and
     2864                             buf_parts.prod-code  = buf_goods.prod-code    and
     2865                             buf_parts.in-code    = v-in-code              and
     2866                             buf_parts.out-code   = v-in-code              and
     2867                             buf_parts.part-code  = v-part-code
     2868                             no-error .
     2869                   if error-status :error then do:
     2870                      message
     2871                       substitute("Нет цены производителя !  &1 &2&3&4&5"  ,
     2872                                   v-in-code,
     2873                                   v-part-code ,
     2874                                   buf_goods.artic   ,
     2875                                   buf_goods.prod-type,
     2876                                   buf_goods.prod-code ) .
     2877                      return error "Нет цены производителя !!!".
     2878                   end.
     2879               end.
     2880   run level-dis-value ( input (if p-mode = 2 then v-PriceWithoutVat else v-PriceWithVat) , input p-b-code, input p-obj-type, input p-obj-code, output v-discnt ) no-error .
     2881   define variable v-postWithoutVat-rubl as decimal   no-undo .
     2882   define variable v-postWithoutVat-base as decimal   no-undo .
     2883      case p-mode :
     2884       when 1 then do:
     2885          if p-rb = "rubl" then do:
     2886             p-price-sale = buf_parts.price-rubl + ( MINIMUM ( buf_parts.price-rubl , v-PriceWithVat ) * v-discnt / 100 ).
     2887          end.
     2888          else do:
     2889             p-price-sale = buf_parts.price-base + ( MINIMUM ( v-PriceWithVat , buf_parts.price-base ) * v-discnt / 100 ).
     2890          end.
     2891       end.
     2892       when 2 then do:
     2893         if p-rb = "rubl" then do:
     2894           v-postWithoutVat-rubl =  buf_parts.price-rubl - (buf_parts.price-rubl * buf_parts.vat-pc / (100 + buf_parts.vat-pc) ).
     2895           p-price-sale = v-postWithoutVat-rubl + ( MINIMUM ( v-PriceWithoutVat , v-postWithoutVat-rubl ) * v-discnt / 100 ) .
     2896         end.
     2897         else do:
     2898           v-postWithoutVat-base = buf_parts.price-base - (buf_parts.price-base * buf_parts.vat-pc / ( 100 + buf_parts.vat-pc) ) .
     2899           p-price-sale = v-postWithoutVat-base + ( MINIMUM ( v-PriceWithoutVat, v-postWithoutVat-base) * v-discnt / 100 ) .
     2900         end.
     2901       end.
     2902      end case.
     2903   p-descript-calc =
     2904     string(p-mode) + '_Элементы расчета: ' +  chr(10)  +
     2905     buf_goods.gds-name                  +  chr(10) +
     2906     buf_goods.artic +
     2907     buf_goods.prod-type +
     2908     string(buf_goods.prod-code)         + chr(10) +
     2909     "бар-код " +  string(p-b-code)      + chr(10)  +
     2910     'ПН    ' + v-in-code  +
     2911     ' серия ' + v-part-code             +  chr(10)  + chr(10) +
     2912     'Цена поставщика без ндс    '  + string((buf_parts.price-rubl - (buf_parts.price-rubl * buf_parts.vat-pc / (100 + buf_parts.vat-pc) ) ))  + chr(10) +
     2913     'Цена поставщика   c ндс    '  + string ( buf_parts.price-rubl )  + chr(10) +
     2914     'Цена производителя без ндс ' +  string( v-PriceWithoutVat)       + chr(10) +
     2915     'Цена производителя   c ндс ' +  string( v-PriceWithVat  )        + chr(10) +
     2916     chr(10) +
     2917     "% пороговой наценки        "  + string(v-discnt)                 + chr(10) +
     2918     chr(10) +
     2919     "сумма наценки от произв без ндс "  + string( v-PriceWithoutVat * v-discnt / 100 ) +  chr(10) +
     2920     "сумма наценки от произв   с ндс "  + string( v-PriceWithVat * v-discnt / 100 )    +  chr(10)  +
     2921     chr(10) +
     2922     string(p-price-sale)                                                               +  chr(10) +
     2923     (if p-mode = 1 then substitute("ПорогПр+НДС  &1 + ( min(&2или &1) * &3 / 100 )  = &4 " , buf_parts.price-rubl , v-PriceWithVat , v-discnt , p-price-sale)
     2924     else                substitute("ПорогПр-НДС  &1 - ( &1 * &2 / 100 ) + ( min(&3 или &6 ) * &4 / 100 ) = &5 и еще накручивается НДС " , buf_parts.price-rubl , buf_parts.vat-pc , v-PriceWithoutVat , v-discnt , p-price-sale , v-postWithoutVat-rubl))
     2925   .
     2926     end.
     2927   end procedure.
     2928   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2929   PROCEDURE write-bonus :
     2930   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2931   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2932   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2933   define input  parameter v-bonus as decimal   no-undo .
     2934     do
     2935     on error undo, return error return-value
     2936     :
     2937       find first ub.contract-specif-attr exclusive-lock  where
     2938                  ub.contract-specif-attr.contract-num = p-contract-num  and
     2939                  ub.contract-specif-attr.host-code    = p-host-code     and
     2940                  ub.contract-specif-attr.gds-code     = p-gds-code      and
     2941                  ub.contract-specif-attr.attr-code    = 'bonus':U
     2942                 no-error .
     2943         if not available ub.contract-specif-attr then do:
     2944            create ub.contract-specif-attr .
     2945            assign
     2946                 ub.contract-specif-attr.contract-num = p-contract-num
     2947                 ub.contract-specif-attr.host-code    = p-host-code
     2948                 ub.contract-specif-attr.gds-code     = p-gds-code
     2949                 ub.contract-specif-attr.attr-code    = 'bonus':U
     2950            .
     2951         end.
     2952         ub.contract-specif-attr.attr-value  = string (v-bonus) .
     2953   end.
     2954   END PROCEDURE.
     2955   PROCEDURE read-bonus :
     2956   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2957   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2958   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2959   define output parameter v-bonus as decimal   no-undo .
     2960     do
     2961     on error undo, return error return-value
     2962     :
     2963   find first ub.contract-specif-attr no-lock  where
     2964              ub.contract-specif-attr.contract-num = p-contract-num  and
     2965              ub.contract-specif-attr.host-code    = p-host-code     and
     2966              ub.contract-specif-attr.gds-code     = p-gds-code      and
     2967              ub.contract-specif-attr.attr-code    = 'bonus':U
     2968              no-error .
     2969      if available ub.contract-specif-attr then  v-bonus = decimal (ub.contract-specif-attr.attr-value ) .
     2970                                           else  v-bonus = 0 .
     2971   end.
     2972   END PROCEDURE.
     2973   PROCEDURE write-prc-min :
     2974   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
     2975   define input  parameter p-host-code      like ub.contract-specif.host-code     no-undo .
     2976   define input  parameter p-gds-code       like ub.contract-specif.gds-code      no-undo .
     2977   define input  parameter v-prc-min        as decimal   no-undo .
     2978     do
     2979     on error undo, return error return-value
     2980     :
     2981       find first ub.contract-specif-attr exclusive-lock  where
     2982                 ub.contract-specif-attr.contract-num = p-contract-num  and
     2983                 ub.contract-specif-attr.host-code    = p-host-code     and
     2984                 ub.contract-specif-attr.gds-code     = p-gds-code      and
     2985                 ub.contract-specif-attr.attr-code    = 'prc-min':U
     2986                 no-error .
     2987         if not available ub.contract-specif-attr then do:
     2988            create ub.contract-specif-attr .
     2989            assign
     2990                 ub.contract-specif-attr.contract-num = p-contract-num
     2991                 ub.contract-specif-attr.host-code    = p-host-code
     2992                 ub.contract-specif-attr.gds-code     = p-gds-code
     2993                 ub.contract-specif-attr.attr-code    = 'prc-min':U
     2994                 ub.contract-specif-attr.attr-value  = string (v-prc-min)
     2995            .
     2996         end.
     2997         else do:
     2998            ub.contract-specif-attr.attr-value  = string (v-prc-min) .
     2999         end.
     3000       find first ub.contract-specif exclusive-lock where
     3001           ub.contract-specif.contract-num = p-contract-num and
     3002           ub.contract-specif.host-code    = p-host-code    and
     3003           ub.contract-specif.gds-code     = p-gds-code.
     3004           ub.contract-specif.whole-send-news  = ub.contract-specif.whole-send-news + 1.
     3005   end.
     3006   END PROCEDURE.
     3007   PROCEDURE read-prc-min :
     3008   define input  parameter p-contract-num   like ub.contract-specif.contract-num  no-undo .
