     2230     ,input  local-doc-line.prod-code
     2231     ,output v-gds-code
     2232     )  .
     2233     run lineattr-value (
     2234         input   local-doc-line.doc-code ,
     2235         input   v-gds-code              ,
     2236         input   'reason-code':U ,
     2237         output  v-code                  ,
     2238         output  v-type ) .
     2239     find first ub.trn-reason no-lock where
     2240                ub.trn-reason.reason-code = integer ( v-code ) no-error.
     2241     if not available ub.trn-reason then do:
     2242        return "" .
     2243     end.
     2244     else do:
     2245        return ub.trn-reason.reason-name .
     2246     end.
     2247   end function.
     2248   procedure lineattr-value-parts :
     2249     do
     2250     on error undo, return error return-value
     2251     :
     2252       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
     2253       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
     2254       define input  parameter p-part-code   as character no-undo .
     2255       define input  parameter p_in-code     as character no-undo .
     2256       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
     2257       define output parameter p-value       as    decimal   no-undo .
     2258       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2259       find first buf_doc-line-attr no-lock
     2260         where buf_doc-line-attr.doc-code  = p-doc-code
     2261           and buf_doc-line-attr.gds-code  = p-gds-code
     2262           and buf_doc-line-attr.attr-code = p-code  + chr(4) + trim(p-part-code)  + chr(4) + trim(p_in-code)
     2263         no-error .
     2264       if avail buf_doc-line-attr then do:
     2265         assign
     2266           p-value = decimal( buf_doc-line-attr.attr-value)
     2267         .
     2268       end.
     2269       else do:
     2270         assign
     2271           p-value = 0
     2272         .
     2273       end.
     2274     end.
     2275   end procedure.
     2276   procedure lineattr-write-parts :
     2277     do
     2278     on error undo, return error return-value
     2279     :
     2280       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     2281       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2282       define input parameter p-part-code  as character no-undo .
     2283       define input parameter p_in-code    as character no-undo .
     2284       define input parameter p-code       like ub.doc-line-attr.attr-code  no-undo .
     2285       define input parameter p-value      as decimal   no-undo .
     2286       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2287       find first buf_doc-line-attr exclusive-lock
     2288         where buf_doc-line-attr.doc-code  = p-doc-code
     2289           and buf_doc-line-attr.gds-code  = p-gds-code
     2290           and buf_doc-line-attr.attr-code = p-code + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
     2291         no-error .
     2292       if not available buf_doc-line-attr then do:
     2293         create buf_doc-line-attr .
     2294         assign
     2295           buf_doc-line-attr.doc-code  = p-doc-code
     2296           buf_doc-line-attr.gds-code  = p-gds-code
     2297           buf_doc-line-attr.attr-code = p-code  + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
     2298         .
     2299       end.
     2300       assign
     2301         buf_doc-line-attr.attr-value = string( p-value )
     2302       .
     2303     end.
     2304   end procedure.
