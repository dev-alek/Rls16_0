     7860                   run read-bonus (
     7861                       input  buf_contract-specif.contract-num  ,
     7862                       input  buf_contract-specif.host-code     ,
     7863                       input  buf_contract-specif.gds-code      ,
     7864                       output v-bonus  ) .
     7865                   if v-bonus <> ? and v-bonus <> 0 then do:
     7866                     assign
