     7894               and buf_contract.cli-type      = ub.trn-doc.cli-type
     7895               and buf_contract.cli-code      = ub.trn-doc.cli-code
     7896               and buf_contract.status_       = 'тек':U
     7897               and buf_contract.contract-date-beg   <= ub.trn-doc.doc-date
     7898               and ( buf_contract.contract-date-end >= ub.trn-doc.doc-date
     7899                 or buf_contract.contract-date-end   = date('') )
     7900             no-error.
     7901             if available buf_contract then do:
     7902   define variable vss-include-info79 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7903   ASSIGN
     7904      i-gl-Host-Code      = 0
     7905      i-gl-Contract-Code  = 0
     7906      i-gl-Extent3        = 0
     7907      .
     7908   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     7909       INPUT  v-cntxt-host-code-obj,
     7910       INPUT  buf_contract.contract-code,
     7911       OUTPUT i-gl-Extent3
     7912      ).
     7913   IF i-gl-Extent3[1] = 2 THEN DO:
     7914      ASSIGN
     7915         i-gl-Host-Code      = i-gl-Extent3[2]
     7916         i-gl-Contract-Code  = i-gl-Extent3[3]
     7917         .
     7918   END. ELSE DO:
     7919      ASSIGN
     7920         i-gl-Host-Code      = v-cntxt-host-code-obj
     7921         i-gl-Contract-Code  = buf_contract.contract-code
     7922         .
     7923   END.
     7924   FOR EACH
     7925       buf_contract-specif
     7926        NO-LOCK
     7927        WHERE
     7928            buf_contract-specif.Host-code    = i-gl-Host-Code
     7929        AND buf_contract-specif.Contract-num = i-gl-Contract-Code
     7930               :
     7931                 if buf_contract-specif.gds-code     = buf-goods.gds-code then do:
     7932                   run read-bonus (
     7933                       input  buf_contract-specif.contract-num  ,
     7934                       input  buf_contract-specif.host-code     ,
     7935                       input  buf_contract-specif.gds-code      ,
     7936                       output v-bonus  ) .
     7937                   if v-bonus <> ? and v-bonus <> 0 then do:
     7938                     assign
     7939                       buf-price-list.calc-method = 'Спецификация':U
     7940                       buf-price-list.price-calc  = buf_contract-specif.price-cli + ( buf_contract-specif.price-cli * v-bonus / 100 )
     7941                       buf-price-list.price-sale = (buf_contract-specif.price-cli + ( buf_contract-specif.price-cli * v-bonus / 100 )) * (1 + increase-pc / 100)
     7942                       tt-price-sale  = (buf_contract-specif.price-cli + ( buf_contract-specif.price-cli * v-bonus / 100 )) * (1 + increase-pc / 100)
     7943                     .
     7944                   end.
     7945                   else do:
     7946                     assign
     7947                       buf-price-list.calc-method = 'Спецификация':U
     7948                       buf-price-list.price-calc  = buf_contract-specif.price-cli
     7949                       buf-price-list.price-sale  = buf_contract-specif.price-cli * (1 + increase-pc / 100)
     7950                       tt-price-sale   = buf_contract-specif.price-cli * (1 + increase-pc / 100)
     7951                     .
     7952                   end.
     7953                 end.
     7954               end.
     7955             end.
     7956             else do:
