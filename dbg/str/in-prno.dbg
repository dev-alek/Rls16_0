     1888         create buf_doc-line-attr .
     1889         assign
     1890           buf_doc-line-attr.doc-code  = p-doc-code
     1891           buf_doc-line-attr.gds-code = p-gds-code
     1892           buf_doc-line-attr.attr-code = p-code
     1893         .
     1894       end.
     1895       assign
     1896         buf_doc-line-attr.attr-value = p-value
     1897       .
     1898        release buf_doc-line-attr.
     1899     end.
     1900   end procedure.
     1901   procedure lineattr-exist :
