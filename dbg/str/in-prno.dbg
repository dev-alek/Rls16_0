     1590   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1591   procedure ver-modificator-price-is-null :
     1592    do
     1593    on error undo, return error return-value
     1594    :
     1595   define input parameter p-artic     like ub.goods.artic no-undo.
     1596   define input parameter p-prod-type like ub.goods.prod-type no-undo.
     1597   define input parameter p-prod-code like ub.goods.prod-code no-undo.
     1598   define input parameter p-obj-type  like ub.clients.obj-type no-undo.
     1599   define input parameter p-obj-code  like ub.clients.obj-code no-undo.
     1600   define output parameter p-ret as logical no-undo .
     1601   define variable v-gds-code  like ub.goods.gds-code no-undo .
     1602   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     1603   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1604   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1605     (input  p-artic
     1606     ,input  p-prod-type
     1607     ,input  p-prod-code
     1608     ,output v-gds-code
     1609     )  .
     1610   p-ret = true .
     1611   find first buf_fbr-gds-obj no-lock where
     1612               buf_fbr-gds-obj.gds-code = v-gds-code and
     1613               buf_fbr-gds-obj.obj-code = p-obj-code and
     1614               buf_fbr-gds-obj.obj-type = p-obj-type use-index pi no-error .
     1615    if available buf_fbr-gds-obj then
     1616                 if buf_fbr-gds-obj.is-modificator = true and
     1617                    buf_fbr-gds-obj.is-null-price = true
     1618                    then  p-ret = false .
     1619    end.
     1620   end procedure.
     1621   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1622   procedure doc-code:
     1623   define input  parameter parmode          as   character           no-undo.
     1624   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
     1625   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
     1626   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
     1627   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
     1628   define buffer buf_sys-ctrl for ub.sys-ctrl  .
     1629   define variable vardb-remote     as   logical             no-undo.
     1630   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
     1631   define variable v-delimiter as character no-undo .
     1632   do
     1633   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1634   :
     1635   find first buf_sys-ctrl no-lock .
     1636   vardb-remote = buf_sys-ctrl.db-num <> 0 .
     1637     CASE parmode:
     1638       when "main":u then do:
     1639         if vardb-remote then do:
     1640           assign
     1641             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
     1642         end.
     1643         else do:
     1644           assign
     1645             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
     1646         end.
     1647       end.
     1648       when "trio" then do:
     1649         assign
     1650           pardoc-code = replace (parroot-doc-code, "=", "*").
     1651       end.
     1652       otherwise do:
     1653         assign
     1654         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
     1655         no-error
     1656         .
     1657         if error-status:error  then do:
     1658           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
     1659                                         ,chr(10)
     1660                                         ,parmode
     1661                                         ).
     1662         end.
     1663         if num-entries(parmode) = 1
     1664         and parmode <> "chip":U
     1665         and parmode <> "chip_s":U
     1666         then do:
     1667           assign
     1668           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
     1669         end.
     1670         else if (lookup("chip":U, parmode) > 0
     1671                  or
     1672                  lookup("chip_s":U, parmode) > 0) then do:
     1673           assign
     1674             vartemp-doc-code = parroot-doc-code.
     1675           do while true:
     1676             if index (vartemp-doc-code , ".") = 0 then
     1677               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
     1678             else
     1679               vartemp-doc-code  =
     1680               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
     1681               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
     1682               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
     1683             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
     1684           end.
     1685           assign
     1686             pardoc-code = vartemp-doc-code.
     1687         end.
     1688       end.
     1689     end CASE.
     1690     if pardoc-code = '':U
     1691     or (parroot-doc-code <> '':U
     1692     and pardoc-code = parroot-doc-code) then do:
     1693       undo, return error substitute("Ошибка при генерации номера документа&1"
     1694                                     ,chr(10)).
     1695     end.
     1696   end.
     1697   end. // procedure/method
     1698   function get-doc-code-int64 returns int64
     1699     ( input p-doc-code as character ) :
     1700     define variable v-ind              as integer   no-undo .
     1701     define variable v-num-entries      as integer   no-undo .
     1702     define variable v-doc-code-int64   as int64     no-undo .
     1703     define variable v-canonic-doc-code as character no-undo .
     1704     assign
     1705       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
     1706       v-canonic-doc-code = p-doc-code
     1707     .
     1708     do v-ind = 1 to v-num-entries
     1709     :
     1710       assign
     1711         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
     1712       .
     1713     end.
     1714     assign
     1715       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
     1716     .
     1717     return v-doc-code-int64 .
     1718   end. // function/method
     1719   procedure create-price-list-attr :
     1720    do
     1721    on error undo, return error return-value
     1722    :
     1723   define input parameter p-attr-code    like ub.price-list-attr.attr-code  no-undo .
     1724   define input parameter p-attr-value   like ub.price-list-attr.attr-value no-undo .
     1725   define input parameter p-b-code       like ub.price-list-attr.b-code     no-undo .
     1726   define input parameter p-doc-num      like ub.price-list-attr.doc-num    no-undo .
     1727   define input parameter p-price-type   like ub.price-list-attr.price-type no-undo .
     1728   define buffer buf_price-list-attr for ub.price-list-attr.
     1729   find first buf_price-list-attr  exclusive-lock  where
     1730     buf_price-list-attr.attr-code    = p-attr-code    and
     1731     buf_price-list-attr.b-code       = p-b-code       and
     1732     buf_price-list-attr.doc-num      = p-doc-num      and
     1733     buf_price-list-attr.price-type   = p-price-type  no-error .
     1734     if not available  buf_price-list-attr then do:
     1735         create buf_price-list-attr.
     1736         assign
     1737           buf_price-list-attr.attr-code    = p-attr-code
     1738           buf_price-list-attr.attr-value   = p-attr-value
     1739           buf_price-list-attr.b-code       = p-b-code
     1740           buf_price-list-attr.doc-num      = p-doc-num
     1741           buf_price-list-attr.price-type   = p-price-type
     1742         .
     1743     end.
     1744     else do:
     1745           buf_price-list-attr.attr-value   = p-attr-value .
     1746     end.
     1747    end.
     1748   end procedure.
     1749   procedure view-price-list-attr :
     1750    do
     1751    on error undo, return error return-value
     1752    :
     1753   define input  parameter p-attr-code    like ub.price-list-attr.attr-code  no-undo .
     1754   define input  parameter p-b-code       like ub.price-list-attr.b-code     no-undo .
     1755   define input  parameter p-doc-num      like ub.price-list-attr.doc-num    no-undo .
     1756   define input  parameter p-price-type   like ub.price-list-attr.price-type no-undo .
