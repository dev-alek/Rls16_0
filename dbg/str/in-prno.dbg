     5422         varprice-rubl  = bf_price-list.price-sale
     5423         vardiscnt-base = 0
     5424         vardiscnt-rubl = 0
     5425       .
     5426       assign
     5427         varfact-qnty = 0
     5428       .
     5429       for each bf_parts no-lock
     5430         where bf_parts.out-code   = bf_price-list.doc-num
     5431           and bf_parts.obj-type   = bf_price-list.obj-type
     5432           and bf_parts.obj-code   = bf_price-list.obj-code
     5433           and bf_parts.artic      = bf_price-list.artic
     5434           and bf_parts.prod-type  = bf_price-list.prod-type
     5435           and bf_parts.prod-code  = bf_price-list.prod-code
     5436       :
     5437         assign
     5438           varfact-qnty = varfact-qnty + bf_parts.fact-qnty
     5439         .
     5440       end.
     5441       assign
     5442         vardoc-num   = bf_price-list.doc-num
     5443         vardoc-code  = bf_price-list.doc-num
     5444         varobj-type  = bf_price-list.obj-type
     5445         varobj-code  = bf_price-list.obj-code
     5446         varartic     = bf_price-list.artic
     5447         varprod-type = bf_price-list.prod-type
     5448         varprod-code = bf_price-list.prod-code
     5449         vardoc-qnty  = varfact-qnty
     5450         varext-doc-type = 'ot':U
     5451       .
