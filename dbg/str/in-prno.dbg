      261   function cross-list returns logical (
      262     input parfirst-stream  as character,
      263     input parsecond-stream as character,
      264     input pardelim         as character).
      265     if pardelim = ""
      266     or pardelim = ?
      267     then do:
      268       assign
      269         pardelim = ","
      270       .
      271     end.
      272     define variable vari            as integer no-undo .
      273     define variable varresult-cross as logical no-undo .
      274     assign
      275       varresult-cross = no
      276     .
      277     def var v-num-parfirst-stream as integer no-undo .
      278     assign
      279       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      280     .
      281     do vari = 1 to v-num-parfirst-stream
      282     :
      283       if lookup(entry(vari, parfirst-stream, pardelim)
      284                ,parsecond-stream
      285                ,pardelim
      286                ) > 0 then do:
      287         assign
      288           varresult-cross = yes
      289         .
      290         leave.
      291       end.
      292     end.
      293     return varresult-cross .
      294   end function.
