     7821       when 'Спецификация':U then do:
     7822         if available ub.trn-doc
     7823         then do:
     7824           if ub.trn-doc.contract-code <> 0 then do:
     7825             find first buf_contract no-lock
     7826             where buf_contract.host-code     = buf-price-doc.host-code
     7827               and buf_contract.contract-code = ub.trn-doc.contract-code
     7828             no-error.
