     7958                       ub.trn-doc.cli-type ub.trn-doc.cli-code
     7959                       "- расчет невозможен."
     7960                       view-as alert-box question buttons OK-Cancel update g#log.
     7961             end.
     7962           end.
     7963         end.
     7964       end.
     7965       otherwise do:
     7966         message "Не задан способ вычисления цены : " skip
     7967                 "Артикул:" buf-price-list.artic buf-goods.gds-name skip
     7968                 "in-pr"
     7969                 view-as alert-box error.
     7970         g#log = no.
     7971         return error .
