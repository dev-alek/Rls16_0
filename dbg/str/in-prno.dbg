     3408   define output parameter p-pdf-id     as integer   no-undo .
     3409   define output parameter p-plt-db-num as integer   no-undo .
     3410   define output parameter p-plt-id     as integer   no-undo .
     3411   define buffer buf_price-list-type for ub.price-list-type  .
     3412   define variable v-host-code  as integer   no-undo .
     3413   define variable v-base-rate  as decimal   no-undo .
     3414   define variable v-base-scale as integer   no-undo .
     3415   define variable v-exch-rate  as decimal   no-undo .
     3416   define variable v-exch-scale as integer   no-undo .
     3417   define variable v-base as logical   no-undo .
     3418     do
     3419     on error undo, return error return-value
     3420     :
     3421   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3422   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     3423     (output v-base
     3424     )  .
     3425   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3426   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3427     (input  p-obj-type
     3428     ,input  p-obj-code
     3429     ,output v-host-code
     3430     )  .
     3431   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3432   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     3433     (input  v-host-code
     3434     ,input  today
     3435     ,output v-base-rate
     3436     ,output v-base-scale
     3437     )  .
     3438   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3439   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplobj in g#library2
     3440     (input  ?
     3441     ,input  p-obj-type
     3442     ,input  p-obj-code
     3443     ,input  yes
     3444     ,output p-plt-id
     3445     ,output p-plt-db-num
     3446     )  .
     3447      create ub.price-doc-forming.
     3448      assign
     3449         ub.price-doc-forming.plt-id       = p-plt-id
     3450         ub.price-doc-forming.plt-db-num   = p-plt-db-num
     3451         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
     3452         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
     3453         ub.price-doc-forming.base-rate    = v-base-rate
     3454         ub.price-doc-forming.base-scale   = v-base-scale
     3455         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
     3456         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
     3457         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
     3458         ub.price-doc-forming.stts         = 0
     3459         ub.price-doc-forming.sys-date     = today
     3460         ub.price-doc-forming.sys-time     = time
     3461         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
     3462         ub.price-doc-forming.who          = v-cntxt-userid
     3463         ub.price-doc-forming.name         = "автосоздание"
     3464      .
     3465      assign
     3466       p-pdf-db-num  = ub.price-doc-forming.pdf-db
     3467       p-pdf-id      = ub.price-doc-forming.pdf-id
     3468       p-plt-db-num  = ub.price-doc-forming.plt-db-num
     3469       p-plt-id      = ub.price-doc-forming.plt-id
     3470      .
