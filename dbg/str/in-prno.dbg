     5509     (input  varroot-nodeprl
     5510     ,input  'empty-scale=request'
     5511     ,output varempty-scaleprl
     5512     ) no-error .
     5513   if error-status :error then do:
     5514     message
     5515       vss-workfile vss-revision vss-description skip
     5516       "Ошибка при определении атрибута признака" skip
     5517       "Артикул" varartic varprod-type varprod-code skip
     5518       "Признак" varroot-nodeprl skip
     5519       "Запрашивался атрибут" "empty-scale=request" skip
     5520       error-status :get-message(1) skip
     5521       return-value skip
     5522       view-as alert-box error .
     5523     undo, return error .
     5524   end.
     5525   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5526   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     5527     (output varoutvprbprl
     5528     )  .
     5529   if varoutvprbprl = "base":u then do:
     5530     assign
     5531           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax * 1)
     5532       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   * 1)
     5533     .
     5534   end.
     5535   else do:
     5536     assign
     5537           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax / varbase-rate * varbase-scale)
     5538       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   / varbase-rate * varbase-scale)
     5539     .
     5540   end.
     5541   if varoutvprbprl = "rubl":u then do:
     5542     assign
     5543           road-tax-rubl-saleprl    = (if varroad-tax = ? then 0 else varroad-tax * 1)
     5544       excise-rubl-saleprl      = (if varexcise   = ? then 0 else varexcise   * 1) .
     5545   end.
     5546   else do:
     5547     assign
     5548           road-tax-rubl-saleprl    = (if varroad-tax = ? then 0 else varroad-tax * varbase-rate / varbase-scale)
     5549       excise-rubl-saleprl      = (if varexcise   = ? then 0 else varexcise   * varbase-rate / varbase-scale) .
     5550   end.
     5551   assign
     5552     varis-cons-parts-haveprl =  no.
     5553   assign
     5554     varfact-qntyprl       = 0
     5555     varcons-qntyprl       = 0
     5556     varprice-base-consprl = 0
     5557     varprice-rubl-consprl = 0.
     5558   find first out-vatp_doc-lineprl where
     5559              out-vatp_doc-lineprl.doc-code   = vardoc-num
     5560          and out-vatp_doc-lineprl.artic      = varartic
     5561          and out-vatp_doc-lineprl.prod-type  = varprod-type
     5562          and out-vatp_doc-lineprl.prod-code  = varprod-code no-lock no-error.
     5563   if available out-vatp_doc-lineprl           and
     5564     (out-vatp_doc-lineprl.status_ = 'запрос':U or out-vatp_goodsprl.gds-type = 'у':U) then do:
     5565     assign
     5566       varfact-qntyprl = out-vatp_doc-lineprl.fact-qnty.
     5567   end.
     5568   else do:
     5569     for each out-vatp_partsprl where out-vatp_partsprl.out-code   = vardoc-num
     5570                                  and out-vatp_partsprl.obj-type   = varobj-type
     5571                                  and out-vatp_partsprl.obj-code   = varobj-code
     5572                                  and out-vatp_partsprl.artic      = varartic
     5573                                  and out-vatp_partsprl.prod-type  = varprod-type
     5574                                  and out-vatp_partsprl.prod-code  = varprod-code no-lock :
     5575       if out-vatp_partsprl.purch-code = 2 then do:
     5576   assign
     5577     price-rubl-with-tax-locoprl = out-vatp_partsprl.price-rubl
     5578     price-base-with-tax-locoprl = out-vatp_partsprl.price-base
     5579   .
     5580   define variable vss-include-info60 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5581   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     5582     (output varinvprboprl
     5583     )  .
     5584     if out-vatp_partsprl.out-code = 'free-zone':U     or
