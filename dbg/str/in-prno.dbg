     6465               and buf_contract.cli-code      = ub.trn-doc.cli-code
     6466               and buf_contract.status_       = 'тек':U
     6467               and buf_contract.contract-date-beg   <= ub.trn-doc.doc-date
     6468               and ( buf_contract.contract-date-end >= ub.trn-doc.doc-date
     6469                 or buf_contract.contract-date-end   = date('') )
