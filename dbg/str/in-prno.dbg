     5468         .
     5469       end.
     5470   if varext-doc-type = 'ot':U or
     5471      varext-doc-type = ?                 then do:
     5472     assign
     5473      out-vatp-have-vat-sltprl = yes.
     5474   end.
     5475   else do:
     5476     find first out-vatp_doc-attrprl no-lock
     5477       where out-vatp_doc-attrprl.doc-code  = vardoc-code
     5478         and out-vatp_doc-attrprl.attr-code = 'envd':U
     5479         no-error .
     5480     if not available out-vatp_doc-attrprl then do:
     5481       assign
     5482         out-vatp-have-vat-sltprl = yes.
     5483     end.
     5484     else do:
     5485        out-vatp-have-vat-sltprl = no.
     5486     end.
     5487   end.
     5488   find first out-vatp_goodsprl where out-vatp_goodsprl.artic     = varartic     and
     5489                                      out-vatp_goodsprl.prod-type = varprod-type and
     5490                                      out-vatp_goodsprl.prod-code = varprod-code no-lock.
