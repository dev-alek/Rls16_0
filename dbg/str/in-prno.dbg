     1182   procedure gds-attr-margin-value :
     1183     define input  parameter p-gds-code         as integer   no-undo .
     1184     define input  parameter p-obj-type         as character no-undo .
     1185     define input  parameter p-obj-code         as integer   no-undo .
     1186     define output parameter p-min-value        as decimal   no-undo initial ? .
     1187     define output parameter p-max-value        as decimal   no-undo initial ? .
     1188     define output parameter p-increase-pc      as decimal   no-undo initial ? .
     1189     define output parameter p-rmethod          as character no-undo initial '':U .
     1190     define output parameter p-base             as decimal   no-undo initial ? .
     1191     define output parameter p-range-margin     as integer   no-undo .
     1192     define output parameter p-exists-margin    as logical   no-undo .
     1193     define output parameter p-range-increase   as integer   no-undo .
     1194     define output parameter p-exists-increase  as logical   no-undo .
     1195     define output parameter p-range-rmethod    as integer   no-undo .
     1196     define output parameter p-exists-rmethod   as logical   no-undo .
     1197     do
     1198     on error undo, return error
     1199     :
