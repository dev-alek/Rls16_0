     5882                               buf-price-list.calc-method = 'Накл-безНДС':U + " " + doc-code
     5883                               buf-price-list.price-calc  =  if var-pr-r-b = "rubl" then p-doc-price-rubl-novat else p-doc-price-base-novat
     5884                               buf-price-list.price-sale  =  if var-pr-r-b = "rubl" then v-price-rubl        else v-price-base
     5885                               buf-price-list.road-tax    = cur-rt
     5886                               tt-price-sale   =  if var-pr-r-b = "rubl" then v-price-rubl        else v-price-base
     5887                             .
     5888                         end.
     5889                   End.
     5890         else do:
     5891             run str/gdsnovat.p ('Накл-безНДС':U + "Other":U ,
     5892                 buf-price-list.obj-type,
     5893                 buf-price-list.obj-code,
     5894                 buf-price-doc.host-code,
     5895                 buf-price-list.artic,
     5896                 buf-price-list.prod-type,
     5897                 buf-price-list.prod-code,
     5898                 loc-grp-increase-pc,
     5899                 doc-code,
