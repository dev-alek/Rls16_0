     1477      find first in-vatp_doc-attr no-lock
     1478       where in-vatp_doc-attr.doc-code  = b-td_trn-doc.doc-code
     1479         and in-vatp_doc-attr.attr-code = 'envd':U
     1480       no-error .
     1481       if available in-vatp_doc-attr
     1482          then do:
