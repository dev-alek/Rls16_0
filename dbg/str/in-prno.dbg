     4374   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4375   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplpnakl in g#library2
     4376     (input  ?
     4377     ,input  l-type
     4378     ,input  l-code
     4379     ,output par-pr-nakl-ie
     4380     ,output par-pr-nakl-iv
     4381     ,output par-pr-nakl-im
     4382     ) no-error .
     4383      define variable ii as integer   no-undo .
     4384      define variable nn as integer   no-undo .
     4385      define variable v-fullname as character no-undo .
     4386      nn = num-entries ( par-pr-nogds ).
     4387      par-pr-nogds-long = "".
     4388      if par-pr-nogds <> "0" and par-pr-nogds <> ""  then do:
     4389         repeat ii = 1 to nn :
     4390           run grplib-get-full-name  ( input integer(entry(ii,par-pr-nogds)) , output v-fullname ) .
     4391           par-pr-nogds-long = par-pr-nogds-long + v-fullname + chr(4) .
     4392         end.
     4393         par-pr-nogds-long = trim (par-pr-nogds-long,chr(4)) .
     4394      end.
     4395   l-par = true .
     4396   end procedure.
     4397   PROCEDURE cre-pr-list:
     4398   define input  parameter bc      like ub.price-list.b-code no-undo.
     4399   define input  parameter new-num like ub.price-doc.doc-num no-undo.
     4400   define output parameter new-rec as recid             no-undo.
     4401   define buffer buf-price-list for ub.price-list.
     4402   define buffer buf-price-doc  for ub.price-doc.
     4403   define buffer buf-bar-code   for ub.bar-code.
     4404   define buffer buf-goods      for ub.goods.
     4405   define buffer buf-gds-prt    for ub.gds-prt.
     4406   define buffer root-gds-prt   for ub.gds-prt.
     4407   define variable cur-pr like ub.price-list.price-sale no-undo.
     4408   define variable cur-rt like ub.price-list.road-tax   no-undo.
     4409   define variable cur-ex like ub.price-list.excise     no-undo.
     4410   define variable cur-dn like ub.price-list.doc-num    no-undo.
     4411   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
     4412   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
     4413   define variable cur-rt-base as decimal no-undo .
     4414   define variable cur-rt-rubl as decimal no-undo .
     4415   define variable p-hostcode as int no-undo .
     4416   define variable v-line-num as integer no-undo .
     4417   define variable v-skip-del-gds as logical no-undo initial no .
     4418   cre-pr:
     4419   do on error undo cre-pr, return error:
     4420     find  buf-bar-code no-lock where
     4421           buf-bar-code.b-code = bc.
     4422     run check-use-bar-code ( buf-bar-code.b-code ) no-error .
     4423     if error-status :error then do:
     4424       message
     4425         return-value skip
     4426         "Ошибка !"
     4427         view-as alert-box error
     4428       .
     4429       undo cre-pr, return.
     4430     end.
     4431     find  buf-goods no-lock where
     4432           buf-goods.gds-code = buf-bar-code.gds-code.
     4433     find first root-gds-prt no-lock where
     4434               root-gds-prt.upper-code = buf-goods.prt-root.
     4435     if root-gds-prt.node-name <> '_Пустая шкала':U and
     4436       buf-bar-code.in-code <> "" then do:
     4437       message
     4438         "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
     4439         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     4440         view-as alert-box error.
     4441       undo cre-pr, return.
     4442     end.
     4443     find  buf-gds-prt no-lock where
     4444           buf-gds-prt.node-code = buf-bar-code.node-code.
     4445     if buf-goods.stts <> 0 and not v-skip-del-gds then do:
     4446       message
     4447         "Не допускается создавать цены на удаленные товары!" skip (2)
     4448         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     4449         view-as alert-box error.
     4450       undo cre-pr, return.
     4451     end.
     4452     find  buf-price-doc where
     4453           buf-price-doc.doc-num = new-num.
     4454   define variable v-ret as logical no-undo .
     4455      run ver-modificator-price-is-null (
     4456             input    buf-goods.artic        ,
     4457             input    buf-goods.prod-type    ,
     4458             input    buf-goods.prod-code    ,
     4459             input    buf-price-doc.obj-type   ,
     4460             input    buf-price-doc.obj-code   ,
     4461             output   v-ret ).
     4462         if v-ret = false then dO:
     4463             message
     4464               "Не допускается создавать цены на модификаторы с нулевой ценой !" skip (2)
     4465               "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     4466               view-as alert-box error.
     4467             undo cre-pr, return.
     4468           end.
     4469   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4470   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4471     (input  buf-price-doc.obj-type
     4472     ,input  buf-price-doc.obj-code
     4473     ,output p-hostcode
     4474     ) no-error .
     4475   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4476   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     4477     (input  buf-goods.gds-code
     4478     ,input  '1':U
     4479     ,input  ?
     4480     ,input  p-hostcode
     4481     ,input  buf-price-doc.obj-type
     4482     ,input  buf-price-doc.obj-code
     4483     ,output local_vat-pc
     4484     ) no-error .
     4485   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4486   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     4487     (input  buf-goods.gds-code
     4488     ,input  '2':U
     4489     ,input  ?
     4490     ,input  p-hostcode
     4491     ,input  buf-price-doc.obj-type
     4492     ,input  buf-price-doc.obj-code
     4493     ,output local_slt-pc
     4494     ) no-error .
     4495   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4496   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     4497     (input  buf-price-doc.obj-type
     4498     ,input  buf-price-doc.obj-code
     4499     ,input  bc
     4500     ,input  0
     4501     ,input  0
     4502     ,output cur-dn
     4503     ,output cur-pr
     4504     ,output cur-rt
     4505     ,output cur-ex
     4506     ) no-error .
     4507     find first buf-price-list where
     4508               buf-price-list.b-code  = buf-bar-code.b-code and
     4509               buf-price-list.doc-num = new-num  and
     4510               buf-price-list.price-type = ""    no-error .
     4511     if not available buf-price-list then do:
     4512       run calc-price-line-num (input  new-num , output v-line-num) .
     4513       create buf-price-list.
     4514       assign
     4515         buf-price-list.line-num  = v-line-num
     4516         buf-price-list.b-code    = buf-bar-code.b-code
     4517         buf-price-list.doc-num   = buf-price-doc.doc-num
     4518         buf-price-list.prod-type = buf-goods.prod-type
     4519         buf-price-list.prod-code = buf-goods.prod-code
     4520         buf-price-list.artic     = buf-goods.artic
     4521         buf-price-list.obj-type  = buf-price-doc.obj-type
     4522         buf-price-list.obj-code  = buf-price-doc.obj-code
     4523         buf-price-list.vat-pc    = local_vat-pc
     4524         buf-price-list.slt-pc    = local_slt-pc
     4525         buf-price-list.price-prev = cur-pr
     4526         .
     4527       if  buf-gds-prt.upper-code = buf-goods.prt-root and
     4528           buf-bar-code.in-code   = "" and
     4529           buf-bar-code.part-code = "" and
     4530           buf-bar-code.unit-cli  = buf-goods.unit-base then do:
     4531         buf-price-list.main-price = yes.
     4532         if cur-pr <> ? then do:
     4533           run exp-prt (input buf-goods.gds-code,
     4534                       input cur-dn,
     4535                       input new-num,
     4536                       output new-rec) no-error.
     4537           if error-status :error then do:
     4538             message
     4539               "Ошибка вызова процедуры разворота специальных и неосновных цен."
     4540               view-as alert-box error.
     4541             undo cre-pr, return error.
     4542           end.
     4543         end.
     4544       end.
     4545       else do:
     4546         if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     4547           buf-price-list.d-pcnt = ?.
     4548         end.
     4549         buf-price-list.main-price = no.
     4550       end.
     4551     end.
     4552   end.
     4553   new-rec = recid (buf-price-list).
     4554   END PROCEDURE.
     4555   procedure calc-price-line-num :
     4556    do
     4557    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     4558    :
     4559   define input parameter p-doc-num as character no-undo .
     4560   define output parameter p-num  as integer no-undo .
     4561   define variable v-fact as integer no-undo .
     4562   define buffer buf_1_price-list for ub.price-list .
     4563   p-num = 1 .
     4564   find last  buf_1_price-list no-lock where
     4565              buf_1_price-list.doc-num = p-doc-num use-index line-num no-error .
     4566              if available buf_1_price-list then
     4567                   assign
     4568                     v-fact = buf_1_price-list.line-num
     4569                   .
     4570   v-fact = v-fact + 1.
     4571   if v-fact <> ? then if p-num < v-fact then p-num = v-fact .
     4572    end.
     4573   end procedure.
     4574   PROCEDURE del-pr-list:
     4575   define input parameter bc    like ub.bar-code.b-code   no-undo.
     4576   define input parameter d-num like ub.price-doc.doc-num no-undo.
     4577   define input parameter round-method as character         no-undo.
     4578   define input parameter round-base   as decimal      no-undo.
     4579   define buffer buf-price-list for ub.price-list.
     4580   define buffer buf-bar-code   for ub.bar-code.
     4581   define buffer buf-goods      for ub.goods.
     4582   define variable l-ov-on as logical no-undo .
     4583   del-pr:
     4584   do on error undo del-pr, return error:
     4585     find first  buf-price-list no-lock where
     4586                 buf-price-list.doc-num    = d-num and
     4587                 buf-price-list.b-code     = bc and
     4588                 buf-price-list.price-type = "" no-error.
     4589     if not available buf-price-list then
     4590       undo del-pr, return error.
     4591     find  buf-goods no-lock where
     4592           buf-goods.prod-type = buf-price-list.prod-type and
     4593           buf-goods.prod-code = buf-price-list.prod-code and
     4594           buf-goods.artic     = buf-price-list.artic.
     4595     if buf-price-list.main-price then do:
     4596       for each  buf-price-list exclusive-lock where
     4597                 buf-price-list.doc-num   = d-num and
     4598                 buf-price-list.artic     = buf-goods.artic and
     4599                 buf-price-list.prod-type = buf-goods.prod-type and
     4600                 buf-price-list.prod-code = buf-goods.prod-code,
     4601           first buf-bar-code no-lock where
     4602                 buf-bar-code.b-code = buf-price-list.b-code
     4603       on error undo del-pr, return error:
     4604   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4605   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     4606     (input  ub.buf-price-list.obj-type
     4607     ,input  ub.buf-price-list.obj-code
     4608     ,input  ub.buf-price-list.artic
     4609     ,input  ub.buf-price-list.prod-type
     4610     ,input  ub.buf-price-list.prod-code
     4611     ,input  'ov-on=request:exclusive'
     4612     ,output l-ov-on
     4613     ) no-error .
     4614         if error-status:error then do:
     4615           message
     4616             vss-workfile vss-revision vss-description skip
     4617             "Ошибка получения признака товара на объекте" skip
     4618             error-status :get-message(1) skip
     4619             return-value skip
     4620             view-as alert-box error .
     4621         end.
     4622         if l-ov-on then do:
     4623   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4624   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     4625     (input  ub.buf-price-list.obj-type
     4626     ,input  ub.buf-price-list.obj-code
     4627     ,input  ub.buf-price-list.artic
     4628     ,input  ub.buf-price-list.prod-type
     4629     ,input  ub.buf-price-list.prod-code
     4630     ,input  'ov-on=false'
     4631     ,output l-ov-on
     4632     ) no-error .
     4633           if error-status :error then do:
     4634           end.
     4635          end.
     4636         delete buf-price-list.
     4637       end.
     4638     end.
     4639     else do:
     4640       find  buf-bar-code no-lock where
     4641             buf-bar-code.b-code = buf-price-list.b-code.
     4642       if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     4643         message
     4644           "Нельзя удалить неосновную цену." skip
     4645           "Неосновная цена (скидка) не может быть неопределенной." skip
     4646           "Код:" bc skip
     4647           "Переоценка:" d-num
     4648           view-as alert-box error.
     4649         undo del-pr, return error.
     4650       end.
     4651       find current buf-price-list exclusive-lock no-error .
     4652       delete buf-price-list.
     4653       run calc-base-upd (input buf-bar-code.b-code,
     4654                         input d-num,
     4655                         input round-method,
     4656                         input round-base) no-error.
     4657       if error-status :error then
     4658         undo del-pr, return error.
     4659     end.
     4660   end.
     4661   END PROCEDURE.
     4662   PROCEDURE calc-base-upd:
     4663   define input parameter bc    like ub.bar-code.b-code   no-undo.
     4664   define input parameter d-num like ub.price-doc.doc-num no-undo.
     4665   define input parameter round-method as character         no-undo.
     4666   define input parameter round-base   as decimal      no-undo.
     4667   define buffer alt-bar-code   for ub.bar-code.
     4668   define buffer alt-price-list for ub.price-list.
     4669   define buffer buf-bar-code   for ub.bar-code.
     4670   define buffer buf-goods      for ub.goods.
     4671   calc-base:
     4672   do on error undo calc-base, return error:
     4673     find  buf-bar-code no-lock where
     4674           buf-bar-code.b-code = bc.
     4675     find  buf-goods no-lock where
     4676           buf-goods.gds-code = buf-bar-code.gds-code.
     4677     for each  alt-bar-code no-lock where
     4678               alt-bar-code.gds-code  = buf-bar-code.gds-code and
     4679               alt-bar-code.node-code = buf-bar-code.node-code and
     4680               alt-bar-code.part-code = buf-bar-code.part-code and
     4681               alt-bar-code.in-code   = buf-bar-code.in-code and
     4682               alt-bar-code.unit-cli <> buf-goods.unit-base,
     4683         each  alt-price-list where
     4684               alt-price-list.doc-num    = d-num and
     4685               alt-price-list.b-code     = alt-bar-code.b-code and
     4686               alt-price-list.price-type = ""
     4687         on error undo calc-base, return error:
     4688       run calc-pr-alt (input d-num,
     4689                       input alt-bar-code.b-code,
     4690                       input round-method,
     4691                       input round-base) no-error.
     4692       if error-status:error then
     4693         undo calc-base, return error.
     4694     end.
     4695   end.
     4696   END PROCEDURE.
     4697   PROCEDURE calc-pr-alt:
     4698   define input parameter d-num like ub.price-doc.doc-num no-undo.
     4699   define input parameter bc    like ub.bar-code.b-code   no-undo.
     4700   define input parameter r-method as character             no-undo.
     4701   define input parameter r-base   as decimal              no-undo.
     4702   define buffer buf-price-doc  for ub.price-doc.
     4703   define buffer buf-price-list for ub.price-list.
     4704   define buffer buf-bar-code   for ub.bar-code.
     4705   define buffer buf-goods      for ub.goods.
     4706   define buffer old-price-list for ub.price-list.
     4707   define variable pr-rec   as   recid                  no-undo.
     4708   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     4709   pr-alt:
     4710   do on error undo pr-alt, return error:
     4711     if r-method = ? or
     4712        r-base = ? then do:
     4713       message
     4714         "Нельзя удалить основную цену." skip
     4715         "Не задан способ округления для расчета зависящих от нее неосновных цен." skip
     4716         "Код:" bc skip
     4717         "Переоценка:" d-num
     4718         view-as alert-box error.
     4719       undo pr-alt, return error.
     4720     end.
     4721     find  buf-price-doc where
     4722           buf-price-doc.doc-num = d-num.
     4723     find  buf-bar-code no-lock where
     4724           buf-bar-code.b-code = bc.
     4725     find  buf-goods no-lock where
     4726           buf-goods.gds-code = buf-bar-code.gds-code.
     4727     find  buf-price-list where
     4728           buf-price-list.doc-num = buf-price-doc.doc-num and
     4729           buf-price-list.b-code  = bc.
     4730     if buf-price-list.d-pcnt = ? then do:
     4731   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4732   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     4733     (input  buf-price-doc.obj-type
     4734     ,input  buf-price-doc.obj-code
     4735     ,input  bc
     4736     ,input  0
     4737     ,input  0
     4738     ,output pr-rec
     4739     ,output pr-c-b-r
     4740     )  .
     4741       find old-price-list no-lock where
     4742           recid (old-price-list) = pr-rec no-error.
     4743       if available old-price-list and
     4744         old-price-list.b-code = bc then
     4745         buf-price-list.d-pcnt = old-price-list.d-pcnt.
     4746       else
     4747         buf-price-list.d-pcnt = 0.
     4748     end.
     4749      if buf-price-list.d-pcnt = ? then do:
     4750         assign
     4751           buf-price-list.price-sale =   if available old-price-list then old-price-list.price-sale else 0
     4752           buf-price-list.calc-method =  'Не-считать':U + 'Основная':U
     4753           .
     4754     end.
     4755     else do:
     4756         assign
     4757           buf-price-list.price-sale =   fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) *
     4758                                         buf-bar-code.cli-base-rate *
     4759                                         (1 - buf-price-list.d-pcnt / 100)
     4760           buf-price-list.calc-method =  'Основная':U
     4761           .
     4762   case r-method :
     4763     when '9-окончание':U then do:
     4764       if buf-price-list.price-sale < 29 then do:
     4765         if (buf-price-list.price-sale - truncate (buf-price-list.price-sale, 0)) <> 0 then do:
     4766           assign
     4767             buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 1
     4768           .
     4769         end.
     4770       end.
     4771       else do:
     4772         if (buf-price-list.price-sale modulo 10) < 3 then do:
     4773           assign
     4774             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     4775                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     4776                   - 1 ) * 10
     4777                 + 9
     4778           .
     4779         end.
     4780         else do:
     4781           assign
     4782             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     4783                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     4784                   ) * 10
     4785                 + 9
     4786           .
     4787         end.
     4788         assign
     4789           buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     4790         .
     4791       end.
     4792     end.
     4793     when '9-99окончание':U then do:
     4794       if buf-price-list.price-sale < r-base then do:
     4795         assign
     4796           buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 0.99
     4797         .
     4798       end.
     4799       else do:
     4800         assign
     4801           buf-price-list.price-sale = truncate (buf-price-list.price-sale / 10 , 0) * 10 + 9.99
     4802         .
     4803       end.
     4804     end.
     4805     when 'Без-дробных':U then do:
     4806       assign
     4807         buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     4808       .
     4809     end.
     4810     when 'Произвольно':U then do:
     4811       if r-base <> 0 then do:
     4812         assign
     4813           buf-price-list.price-sale = round (buf-price-list.price-sale / r-base, 0) * r-base
     4814         .
     4815         if buf-price-list.price-sale = 0 then do:
     4816           assign
     4817             buf-price-list.price-sale = r-base
     4818           .
     4819         end.
     4820       end.
     4821     end.
     4822     when 'Вверх':U then do:
     4823       if r-base <> 0 then do:
     4824         if truncate ( buf-price-list.price-sale / r-base, 0 ) <> (buf-price-list.price-sale / r-base) then do:
     4825           assign
     4826             buf-price-list.price-sale = truncate (buf-price-list.price-sale / r-base, 0) * r-base + r-base
     4827           .
     4828         end.
     4829       end.
     4830       if buf-price-list.price-sale = 0 then do:
     4831         assign
     4832           buf-price-list.price-sale = r-base
     4833         .
     4834       end.
     4835     end.
     4836     when 'Коэффициент':U then do:
     4837       if r-base <> 0 then do:
     4838         assign
     4839           buf-price-list.price-sale = buf-price-list.price-sale * r-base
     4840         .
     4841       end.
     4842     end.
     4843     when 'Отключено':U then do:
     4844     end.
     4845     otherwise do:
     4846       message
     4847         vss-workfile vss-revision vss-description skip
     4848         "Неизвестный метод округления продажной цены" skip
     4849         "round-method" r-method skip
     4850         "round-base"   r-base   skip
     4851         "price"        buf-price-list.price-sale             skip
     4852         view-as alert-box error .
     4853     end.
     4854   end.
     4855     end.
     4856   end.
     4857   END PROCEDURE.
     4858   PROCEDURE calc-pr-discnt:
     4859   define input parameter d-num like ub.price-doc.doc-num no-undo.
     4860   define input parameter bc    like ub.bar-code.b-code   no-undo.
     4861   define buffer buf-price-doc  for ub.price-doc.
     4862   define buffer buf-price-list for ub.price-list.
     4863   define buffer buf-bar-code   for ub.bar-code.
     4864   define buffer buf-goods      for ub.goods.
     4865   define buffer old-price-list for ub.price-list.
     4866   define variable pr-rec   as   recid                  no-undo.
     4867   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     4868   pr-discnt:
     4869   do on error undo pr-discnt, return error:
     4870     find  buf-price-doc where
     4871           buf-price-doc.doc-num = d-num.
     4872     find  buf-bar-code no-lock where
     4873           buf-bar-code.b-code = bc.
     4874     find  buf-goods no-lock where
     4875           buf-goods.gds-code = buf-bar-code.gds-code.
     4876     find  buf-price-list where
     4877           buf-price-list.doc-num = buf-price-doc.doc-num and
     4878           buf-price-list.b-code  = bc.
     4879     buf-price-list.d-pcnt = (1 -
     4880                              buf-price-list.price-sale /
     4881                              fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) /
     4882                              buf-bar-code.cli-base-rate) *
     4883                              100
     4884                              .
     4885   end.
     4886   END PROCEDURE.
     4887   PROCEDURE calc-pr-sub :
     4888   define  input  parameter bc             like ub.price-list.b-code no-undo.
     4889   define  input  parameter d-num          like ub.price-doc.doc-num no-undo.
     4890   define  input  parameter calc-method  as character    no-undo.
     4891   define  input  parameter increase-pc  as decimal      no-undo.
     4892   define  input  parameter round-method as character    no-undo.
     4893   define  input  parameter round-base   as decimal      no-undo.
     4894   define  output parameter calc-rec     as recid        no-undo.
     4895   define  buffer buf-price-list for ub.price-list.
     4896   define  buffer buf-bar-code   for ub.bar-code.
     4897   define  buffer buf-goods      for ub.goods.
     4898   define  buffer buf-gds-prt    for ub.gds-prt.
     4899   define  buffer buf-gds-grp    for ub.gds-grp.
     4900   define  buffer buf-price-doc  for ub.price-doc.
     4901   calc-sub:
     4902   do on error undo calc-sub, return error:
     4903     find  buf-bar-code no-lock where
     4904           buf-bar-code.b-code = bc.
     4905     find  buf-goods no-lock where
     4906           buf-goods.gds-code = buf-bar-code.gds-code.
     4907     find  buf-gds-prt no-lock where
     4908           buf-gds-prt.node-code = buf-bar-code.node-code.
     4909     find  buf-price-list where
     4910           buf-price-list.doc-num    = d-num and
     4911           buf-price-list.b-code     = bc and
     4912           buf-price-list.price-type = "".
     4913     find  buf-price-doc where
     4914           buf-price-doc.doc-num = d-num.
     4915     calc-rec = recid (buf-price-list).
     4916     if buf-price-list.main-price then do:
     4917       for each  buf-price-list where
     4918                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     4919                 buf-price-list.main-price = no and
     4920                 buf-price-list.artic      = buf-goods.artic and
     4921                 buf-price-list.prod-type  = buf-goods.prod-type and
     4922                 buf-price-list.prod-code  = buf-goods.prod-code,
     4923           first buf-bar-code no-lock where
     4924                 buf-bar-code.b-code   = buf-price-list.b-code and
     4925                 buf-bar-code.unit-cli = buf-goods.unit-base
     4926           on error undo calc-sub, return error:
     4927         run calc-pr-list (input  buf-bar-code.b-code,
     4928                           input  buf-price-list.doc-num,
     4929                           input  calc-method,
     4930                           input  increase-pc,
     4931                           input  round-method,
     4932                           input  round-base,
     4933                           input ? ,
     4934                           input ? ,
     4935                           input ? ,
     4936                           input ? ,
     4937                           output calc-rec) no-error.
     4938         if error-status :error then
     4939           undo calc-sub, return error.
     4940         calc-rec = recid (buf-price-list).
     4941       end.
     4942       for each  buf-price-list where
     4943                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     4944                 buf-price-list.main-price = no and
     4945                 buf-price-list.artic      = buf-goods.artic and
     4946                 buf-price-list.prod-type  = buf-goods.prod-type and
     4947                 buf-price-list.prod-code  = buf-goods.prod-code,
     4948           first buf-bar-code no-lock where
     4949                 buf-bar-code.b-code    = buf-price-list.b-code and
     4950                 buf-bar-code.unit-cli <> buf-goods.unit-base
     4951           on error undo calc-sub, return error:
     4952         run calc-pr-alt (input buf-price-doc.doc-num,
     4953                         input buf-bar-code.b-code,
     4954                         input round-method,
     4955                         input round-base) no-error.
     4956         if error-status :error then
     4957           undo calc-sub, return error.
     4958       end.
     4959     end.
     4960     else do:
     4961       run calc-base-upd (input buf-bar-code.b-code,
     4962                         input buf-price-doc.doc-num,
     4963                         input round-method,
     4964                         input round-base) no-error.
     4965       if error-status :error then
     4966         undo calc-sub, return error.
     4967     end.
     4968   end.
     4969   END PROCEDURE.
     4970   procedure ver-pr-nogds :
     4971   define input  parameter p-gds-code      as integer   no-undo .
     4972   define input  parameter p-par-pr-nogds  as character no-undo .
     4973   define output parameter p-not           as logical   no-undo .
     4974   define output parameter p-str           as character no-undo .
     4975   define buffer buf_goods for ub.goods  .
     4976   define variable nn as integer   no-undo .
     4977   define variable ii as integer   no-undo .
     4978   define variable v-namegrp as character no-undo .
     4979     do
     4980     on error undo, return error return-value
     4981     :
     4982     if p-par-pr-nogds = "1" then do:
     4983        assign
     4984         p-not = true
     4985         p-str = ""
     4986        .
     4987        return .
     4988     end.
     4989     assign
     4990       p-not = false
     4991       p-str = ""
     4992     .
     4993     find first buf_goods no-lock where
     4994                buf_goods.gds-code = p-gds-code no-error .
     4995     nn = num-entries(par-pr-nogds-long,chr(4)) .
     4996     repeat ii = 1 to nn:
     4997        v-namegrp = entry(ii , par-pr-nogds-long , chr(4) ) no-error .
     4998        if buf_goods.grp-name  begins v-namegrp  then do:
     4999           assign
     5000             p-not = true
     5001             p-str = substitute ( "Товар &1 &2 &3  может быть включен в ДНЦ из-за исключения запрета по группе : &4"  , buf_goods.artic, buf_goods.gds-name , buf_goods.grp-name , v-namegrp )
     5002           .
     5003           leave .
     5004        end.
     5005     end.
     5006     end.
     5007   end procedure.
