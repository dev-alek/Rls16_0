     1792       assign
     1793         ub.price-doc-forming-attr.plt-id       = p-plt-id
     1794         ub.price-doc-forming-attr.plt-db-num   = p-plt-db-num
     1795         ub.price-doc-forming-attr.pdf-id       = p-pdf-id
     1796         ub.price-doc-forming-attr.pdf-db       = p-pdf-db
     1797         ub.price-doc-forming-attr.attr-code    = p-attr-code
     1798         ub.price-doc-forming-attr.attr-value   = p-val
     1799       .
     1800     end.
     1801   end procedure.
     1802   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1803   procedure lineattr-value :
     1804     do
     1805     on error undo, return error return-value
     1806     :
     1807       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     1808       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     1809       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     1810       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
     1811       define output parameter p-type     as character no-undo .
     1812       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1813       def var v-format         as character no-undo .
     1814       def var v-fillin_width   as integer   no-undo .
     1815       def var v-fillin_height  as integer   no-undo .
     1816       def var v-label          as character no-undo .
     1817       def var v-user-can-edit  as logical   no-undo .
     1818       def var v-output-display as logical   no-undo .
     1819       def var v-other          as character no-undo .
     1820       run lineattr-code in this-procedure
     1821         (input  p-code
     1822         ,output p-type
     1823         ,output v-format
     1824         ,output v-fillin_width
     1825         ,output v-fillin_height
     1826         ,output v-label
     1827         ,output v-user-can-edit
     1828         ,output v-output-display
     1829         ,output v-other
     1830         ) no-error .
     1831       if error-status :error then do:
     1832         undo, return error return-value .
     1833       end.
     1834       find first buf_doc-line-attr no-lock
     1835         where buf_doc-line-attr.doc-code  = p-doc-code
     1836           and buf_doc-line-attr.gds-code  = p-gds-code
     1837           and buf_doc-line-attr.attr-code = p-code
     1838         no-error .
     1839       if avail buf_doc-line-attr then do:
     1840         assign
     1841           p-value =  buf_doc-line-attr.attr-value
     1842         .
     1843       end.
     1844       else do:
     1845         assign
     1846           p-value = if p-type = 'L':U then "no":U else ""
     1847         .
     1848       end.
     1849     end.
     1850   end procedure.
     1851   procedure lineattr-write :
     1852     do
     1853     on error undo, return error return-value
     1854     :
     1855       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     1856       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     1857       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     1858       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
     1859       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1860       def var v-type           as character no-undo .
     1861       def var v-format         as character no-undo .
     1862       def var v-fillin_width   as integer   no-undo .
     1863       def var v-fillin_height  as integer   no-undo .
     1864       def var v-label          as character no-undo .
     1865       def var v-user-can-edit  as logical   no-undo .
     1866       def var v-output-display as logical   no-undo .
     1867       def var v-other          as character no-undo .
     1868       run lineattr-code in this-procedure
     1869         (input  p-code
     1870         ,output v-type
     1871         ,output v-format
     1872         ,output v-fillin_width
     1873         ,output v-fillin_height
     1874         ,output v-label
     1875         ,output v-user-can-edit
     1876         ,output v-output-display
     1877         ,output v-other
     1878         ) no-error .
     1879       if error-status :error then do:
     1880         undo, return error return-value .
     1881       end.
     1882       find first buf_doc-line-attr exclusive-lock
     1883         where buf_doc-line-attr.doc-code  = p-doc-code
     1884           and buf_doc-line-attr.gds-code  = p-gds-code
     1885           and buf_doc-line-attr.attr-code = p-code
     1886         no-error .
