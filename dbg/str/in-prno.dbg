     7868                       buf-price-list.price-calc  = buf_contract-specif.price-cli + ( buf_contract-specif.price-cli * v-bonus / 100 )
     7869                       buf-price-list.price-sale = (buf_contract-specif.price-cli + ( buf_contract-specif.price-cli * v-bonus / 100 )) * (1 + increase-pc / 100)
     7870                       tt-price-sale  = (buf_contract-specif.price-cli + ( buf_contract-specif.price-cli * v-bonus / 100 )) * (1 + increase-pc / 100)
     7871                     .
     7872                   end.
     7873                   else do:
     7874                     assign
     7875                       buf-price-list.calc-method = 'Спецификация':U
     7876                       buf-price-list.price-calc  = buf_contract-specif.price-cli
     7877                       buf-price-list.price-sale  = buf_contract-specif.price-cli * (1 + increase-pc / 100)
     7878                       tt-price-sale   = buf_contract-specif.price-cli * (1 + increase-pc / 100)
     7879                     .
     7880                   end.
     7881                 end.
     7882               end.
     7883             end.
     7884             else do:
