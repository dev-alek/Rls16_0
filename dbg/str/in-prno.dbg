     3765   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3766   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     3767   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3768   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
     3769   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
     3770   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
     3771   ASSIGN
     3772      v-S_CONTRACT                = "Contract":U
     3773      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
     3774      v-DELIM_CHR_3               = ","
     3775      .
     3776   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     3777   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     3778   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     3779   FUNCTION Can-Find-Spec RETURN LOGICAL (
     3780      INPUT iHost-Code    AS INTEGER,
     3781      INPUT iContract-Num AS INTEGER,
     3782      INPUT iGds-Code     AS INTEGER ):
     3783      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     3784      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     3785      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     3786      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     3787      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     3788      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     3789          INPUT  iHost-Code,
     3790          INPUT  iContract-Num,
     3791          OUTPUT iTmp-Extent3
     3792          ).
     3793      IF iTmp-Extent3[1] = 2 THEN DO:
     3794         ASSIGN
     3795            iTmp-Host-Code      = iTmp-Extent3[2]
     3796            iTmp-Contract-Num   = iTmp-Extent3[3]
     3797            .
     3798      END. ELSE DO:
     3799         ASSIGN
     3800            iTmp-Host-Code      = iHost-Code
     3801            iTmp-Contract-Num   = iContract-Num
     3802            .
     3803      END.
     3804      IF iGds-Code = ? THEN DO:
     3805         ASSIGN
     3806            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     3807                                  buf_Spec.Host-Code     = iTmp-Host-Code
     3808                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     3809                           ).
     3810      END. ELSE DO:
     3811            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     3812                                  buf_Spec.Host-Code     = iTmp-Host-Code
     3813                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     3814                              AND buf_Spec.Gds-Code      = iGds-Code
     3815                            ).
     3816      END.
     3817      RETURN (lRet).
     3818   END FUNCTION.
     3819   PROCEDURE MS-Contract-EXTENT-3:
     3820      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     3821      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     3822      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     3823      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     3824      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     3825      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     3826      FIND FIRST buf_Cont-2 WHERE
     3827                 buf_Cont-2.Host-Code      = i-Host-Code
     3828             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     3829           NO-LOCK NO-ERROR.
     3830      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     3831         RETURN.
     3832      END.
     3833      FOR FIRST buf_Ext-Classif WHERE
     3834                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     3835           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     3836                                               STRING(i-Contract-code)
     3837           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     3838          NO-LOCK,
     3839          EACH buf_Cont WHERE
     3840               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     3841           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     3842          NO-LOCK:
     3843          ASSIGN
     3844             i-Ret[1] = 1
     3845             i-Ret[2] = buf_Cont.Host-code
     3846             i-Ret[3] = buf_Cont.Contract-code
     3847             .
     3848          LEAVE.
     3849      END.
     3850      IF i-Ret[1] <> 1 THEN DO:
     3851         FOR FIRST buf_Ext-Classif WHERE
     3852                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     3853              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     3854                                                  STRING(i-Contract-code)
     3855              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     3856             NO-LOCK,
     3857             EACH buf_Cont WHERE
     3858                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     3859              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     3860             NO-LOCK:
     3861             ASSIGN
     3862                i-Ret[1] = 2
     3863                i-Ret[2] = buf_Cont.Host-code
     3864                i-Ret[3] = buf_Cont.Contract-code
     3865                .
     3866             LEAVE.
     3867         END.
     3868      END.
     3869      RETURN.
     3870   END PROCEDURE.
