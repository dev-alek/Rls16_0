     1933         where buf_doc-line-attr.doc-code  = p-doc-code
     1934           and buf_doc-line-attr.gds-code = p-gds-code
     1935           and buf_doc-line-attr.attr-code = p-code
     1936         no-error .
     1937       if  available buf_doc-line-attr then do:
