     2139   procedure lineattr-write-add-line-cli :
     2140   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
     2141   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
     2142   define input  parameter p-cli-type      as character no-undo .
     2143   define input  parameter p-cli-code      as integer   no-undo .
     2144   define input  parameter p-contract-code as integer   no-undo .
     2145   define input  parameter p-host-code     as integer   no-undo .
     2146   define input  parameter p-exch-code     as integer   no-undo .
     2147   define input  parameter p-exch-rate     as decimal   no-undo .
     2148   define input  parameter p-exch-scale    as integer   no-undo .
     2149   define input  parameter p-sum-cli       as decimal   no-undo .
     2150   define input  parameter p-sum-vat       as decimal   no-undo .
     2151   define buffer buf_doc-line-attr for ub.doc-line-attr .
     2152     do
     2153     on error undo, return error return-value
     2154     :
     2155       find first buf_doc-line-attr exclusive-lock
     2156         where buf_doc-line-attr.doc-code  = p-doc-code
     2157           and buf_doc-line-attr.gds-code  = p-gds-code
     2158           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
     2159                                             chr(4) + p-cli-type +
     2160                                             chr(4) + string(p-cli-code) +
     2161                                             chr(4) + string(p-contract-code) +
     2162                                             chr(4) + string(p-host-code)
     2163         no-error .
     2164       if not available buf_doc-line-attr then do:
     2165         create buf_doc-line-attr .
     2166         assign
     2167           buf_doc-line-attr.doc-code  = p-doc-code
     2168           buf_doc-line-attr.gds-code  = p-gds-code
     2169           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
     2170                                         chr(4) + p-cli-type +
     2171                                         chr(4) + string(p-cli-code) +
     2172                                         chr(4) + string(p-contract-code) +
     2173                                         chr(4) + string(p-host-code)
     2174         .
     2175       end.
     2176       assign
     2177         buf_doc-line-attr.attr-value =
     2178         string(p-exch-code)  + chr(4) +
     2179         string(p-exch-rate)  + chr(4) +
     2180         string(p-exch-scale) + chr(4) +
     2181         string(p-sum-cli)    + chr(4) +
     2182         string(p-sum-vat)
     2183         .
     2184     end.
     2185   end procedure.
     2186   procedure lineattr-value-add-line-cli :
     2187   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
     2188   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
     2189   define input   parameter p-cli-type      as character no-undo .
     2190   define input   parameter p-cli-code      as integer   no-undo .
     2191   define input   parameter p-contract-code as integer   no-undo .
     2192   define input   parameter p-host-code     as integer   no-undo .
     2193   define output  parameter p-exch-code     as integer   no-undo .
     2194   define output  parameter p-exch-rate     as decimal   no-undo .
     2195   define output  parameter p-exch-scale    as integer   no-undo .
     2196   define output  parameter p-sum-cli       as decimal   no-undo .
     2197   define output  parameter p-sum-vat       as decimal   no-undo .
     2198   define buffer buf_doc-line-attr for ub.doc-line-attr .
     2199     do
     2200     on error undo, return error return-value
     2201     :
     2202       find first buf_doc-line-attr exclusive-lock
     2203         where buf_doc-line-attr.doc-code  = p-doc-code
     2204           and buf_doc-line-attr.gds-code  = p-gds-code
     2205           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
     2206                                             chr(4) + p-cli-type +
     2207                                             chr(4) + string(p-cli-code) +
     2208                                             chr(4) + string(p-contract-code) +
     2209                                             chr(4) + string(p-host-code)
     2210         no-error .
     2211       if available buf_doc-line-attr then do:
     2212        assign
     2213           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
     2214           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
     2215           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
     2216           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
     2217           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
     2218          .
     2219        end.
     2220     end.
     2221   end procedure.
     2222   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
     2223     define variable v-code as character no-undo .
     2224     define variable v-type as character no-undo .
     2225     define variable v-gds-code as integer   no-undo .
     2226   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2227   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     2228     (input  local-doc-line.artic
