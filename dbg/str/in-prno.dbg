     2347             v-cntxp-price-calc      = bf-cntxp_store.price-calc
     2348             v-cntxp-inout-price     = bf-cntxp_store.inout-price
     2349             v-cntxp-unit-cli-perm   = bf-cntxp_store.unit-cli-perm
     2350             v-cntxp-out-rate        = bf-cntxp_store.out-rate
