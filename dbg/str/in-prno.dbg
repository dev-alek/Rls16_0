     6391       when 'Спецификация':U then do:
     6392         if available ub.trn-doc
     6393         then do:
     6394           if ub.trn-doc.contract-code <> 0 then do:
     6395             find first buf_contract no-lock
     6396             where buf_contract.host-code     = buf-price-doc.host-code
     6397               and buf_contract.contract-code = ub.trn-doc.contract-code
     6398             no-error.
     6399             if available buf_contract then do:
     6400   define variable vss-include-info68 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6401   ASSIGN
     6402      i-gl-Host-Code      = 0
     6403      i-gl-Contract-Code  = 0
     6404      i-gl-Extent3        = 0
     6405      .
