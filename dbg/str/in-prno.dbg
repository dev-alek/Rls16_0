     5872                               buf-price-list.calc-method = 'Накл-безНДС':U + " " + doc-code
     5873                               buf-price-list.price-calc  =  if var-pr-r-b = "rubl" then ub.doc-line.price-rubl else ub.doc-line.price-base
     5874                               buf-price-list.price-sale  =  if var-pr-r-b = "rubl" then v-price-rubl        else v-price-base
     5875                               buf-price-list.road-tax    = cur-rt
     5876                               tt-price-sale   =  if var-pr-r-b = "rubl" then v-price-rubl        else v-price-base
     5877                             .
     5878                         end.
