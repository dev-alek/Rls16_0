     2362             v-cntxp-down-pay        = bf-cntxp_store.down-pay
     2363             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
     2364             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
