     3089   FUNCTION fnc-base-price RETURN decimal (local-bc      as integer,
     3090                                           local-doc-num as char).
     3091   define buffer base-price        for ub.price-list.
     3092   define variable local-main-code like ub.bar-code.b-code no-undo.
     3093   define variable local-base-code like ub.bar-code.b-code no-undo.
     3094     run prc-base-code (input local-bc, output local-base-code).
     3095     find base-price no-lock where
     3096          base-price.doc-num = local-doc-num and
     3097          base-price.b-code  = local-base-code and
     3098          base-price.price-type = "" no-error.
     3099     if not available base-price then do:
     3100       run prc-main-code (input local-bc, output local-main-code).
     3101       find  base-price no-lock where
     3102             base-price.doc-num = local-doc-num and
     3103             base-price.b-code  = local-main-code and
     3104             base-price.price-type = "" no-error.
     3105     end.
     3106     if available base-price then
     3107       return (base-price.price-sale).
     3108     else
     3109       return (?).
     3110   END FUNCTION.
     3111   procedure prc-main-code:
     3112   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
     3113   define output parameter local-main-code like ub.bar-code.b-code no-undo.
     3114   define buffer local-bar-code        for ub.bar-code.
     3115   define buffer local-goods           for ub.goods.
     3116   define buffer main-code             for ub.bar-code.
     3117   define buffer main-prt              for ub.gds-prt.
     3118     local-main-code = ?.
     3119     find local-bar-code no-lock where
     3120          local-bar-code.b-code = local-bc no-error.
     3121     if not available local-bar-code then
     3122       return.
     3123     find local-goods no-lock where
     3124          local-goods.gds-code = local-bar-code.gds-code.
     3125     find first  main-prt no-lock where
     3126                 main-prt.upper-code = local-goods.prt-root.
     3127     find  main-code no-lock where
     3128           main-code.gds-code  = local-bar-code.gds-code and
     3129           main-code.in-code   = "" and
     3130           main-code.part-code = "" and
     3131           main-code.unit-cli  = local-goods.unit-base and
     3132           main-code.node-code = main-prt.node-code.
     3133     local-main-code = main-code.b-code.
     3134   end procedure.
     3135   procedure prc-base-code:
     3136   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
     3137   define output parameter local-base-code like ub.bar-code.b-code no-undo.
     3138   define buffer local-bar-code for ub.bar-code.
     3139   define buffer local-goods    for ub.goods.
     3140   define buffer base-code      for ub.bar-code.
     3141     local-base-code = ?.
     3142     find local-bar-code no-lock where
     3143          local-bar-code.b-code = local-bc no-error.
     3144     if not available local-bar-code then
     3145       return.
     3146     find local-goods no-lock where
     3147          local-goods.gds-code = local-bar-code.gds-code.
     3148     find base-code no-lock where
     3149          base-code.gds-code  = local-bar-code.gds-code and
     3150          base-code.node-code = local-bar-code.node-code and
     3151          base-code.in-code   = local-bar-code.in-code and
     3152          base-code.part-code = local-bar-code.part-code and
     3153          base-code.unit-cli  = local-goods.unit-base.
     3154     local-base-code = base-code.b-code.
     3155   end procedure.
