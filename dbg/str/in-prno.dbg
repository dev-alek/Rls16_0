     1574           slt-cli-loc            = ?
     1575           price-cli-with-tax-loc = ?.
     1576      end.
     1577   ASSIGN
     1578             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
