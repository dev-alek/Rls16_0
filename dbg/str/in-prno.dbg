      578   procedure grp-obj-write :
      579   do
      580   on error undo, return error
      581   :
      582   define input parameter p-node-code  like ub.gds-grp-obj.node-code      no-undo.
      583   define input parameter p-host-code  as integer                          no-undo.
      584   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
      585   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
      586   define input parameter p-min-increase like ub.gds-grp-obj.min-increase  no-undo.
      587   define input parameter p-max-increase like ub.gds-grp-obj.max-increase  no-undo.
      588   define input parameter p-increase-pc like ub.gds-grp-obj.increase-pc  no-undo.
      589   define input parameter p-calc-method like ub.gds-grp-obj.calc-method no-undo .
      590   define input parameter p-round-method like ub.gds-grp-obj.round-method no-undo .
      591   define input parameter p-round-coef like ub.gds-grp-obj.round-coef no-undo .
      592   define input parameter p-cli-type   like ub.clients.obj-type            no-undo.
      593   define input parameter p-cli-code   like ub.clients.obj-code            no-undo.
      594   define buffer buf_gds-grp-obj for ub.gds-grp-obj.
      595       find first buf_gds-grp-obj exclusive-lock
      596            where buf_gds-grp-obj.node-code  = p-node-code
      597              and buf_gds-grp-obj.host-code  = p-host-code
      598              and buf_gds-grp-obj.obj-type   = p-obj-type
      599              and buf_gds-grp-obj.obj-code   = p-obj-code
      600       no-error.
      601       if not available buf_gds-grp-obj
      602       then do:
      603           create buf_gds-grp-obj.
      604           assign
      605                   buf_gds-grp-obj.node-code  = p-node-code
      606                   buf_gds-grp-obj.host-code  = p-host-code
      607                   buf_gds-grp-obj.obj-type   = p-obj-type
      608                   buf_gds-grp-obj.obj-code   = p-obj-code
      609           .
      610       end.
      611       assign
      612       buf_gds-grp-obj.min-increase = p-min-increase
      613       buf_gds-grp-obj.max-increase = p-max-increase
      614       buf_gds-grp-obj.increase-pc = p-increase-pc
      615       buf_gds-grp-obj.calc-method = p-calc-method
      616       buf_gds-grp-obj.round-method = p-round-method
      617       buf_gds-grp-obj.round-coef = p-round-coef
      618       buf_gds-grp-obj.cli-type   = p-cli-type
      619       buf_gds-grp-obj.cli-code   = p-cli-code
      620       .
      621   end.
      622   end procedure.
      623   procedure grp-obj-margin-value :
      624   do
      625   on error undo, return error
      626   :
      627   define input parameter p-node-code as integer      no-undo.
      628   define input parameter p-obj-type  as character    no-undo.
      629   define input parameter p-obj-code  as integer      no-undo.
      630   define output parameter p-min-value as decimal      no-undo init ?.
      631   define output parameter p-max-value as decimal      no-undo init ?.
      632   define output parameter p-increase-pc as decimal      no-undo init ?.
      633   define output parameter p-round-method as character no-undo init "":U.
      634   define output parameter p-base as decimal no-undo init ?.
      635   define output parameter p-range-margin     as integer      no-undo.
      636   define output parameter p-exists-margin    as logical      no-undo.
      637   define output parameter p-range-increase     as integer      no-undo.
      638   define output parameter p-exists-increase    as logical      no-undo.
      639   define output parameter p-range-rmethod     as integer no-undo .
      640   define output parameter p-exists-rmethod    as logical no-undo .
      641   define variable v-host-code as integer      no-undo.
      642   DEFINE VARIABLE v-found as logical no-undo .
      643   DEFINE VARIABLE v-exists as logical no-undo .
      644   DEFINE VARIABLE v-range as integer no-undo .
      645   DEFINE VARIABLE jj as integer no-undo .
      646   DEFINE VARIABLE v-margin-found as logical no-undo .
      647   DEFINE VARIABLE v-increase-found as logical no-undo .
      648   DEFINE VARIABLE v-min-value as decimal      no-undo.
      649   DEFINE VARIABLE v-max-value as decimal      no-undo.
      650   DEFINE VARIABLE v-increase-pc as decimal      no-undo.
      651   define variable v-round-method as character no-undo .
      652   define variable v-base as decimal no-undo .
      653   define variable v-print-code as character no-undo .
      654   define buffer buf_gds-grp for ub.gds-grp.
      655   find first buf_gds-grp no-lock where
      656              buf_gds-grp.node-code = p-node-code no-error .
      657   if not avail buf_gds-grp and p-node-code <> 0 then do:
      658     message
      659       vss-workfile vss-revision vss-description
      660       skip "Не удалось найти группу товаров с кодом" p-node-code
      661       view-as alert-box error .
      662     undo, return error .
      663   end.
      664   if p-obj-type <> '' then do:
      665   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      666   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      667     (input  p-obj-type
      668     ,input  p-obj-code
      669     ,output v-host-code
      670     ) no-error .
      671     if error-status :error
      672     then do:
      673         message
      674           vss-workfile vss-revision vss-description
      675           skip "Не удалось найти фирму объекта"
      676           skip p-obj-type p-obj-code
      677           skip return-value
      678           skip trim(error-status :get-message(1))
      679               trim(error-status :get-message(2))
      680               trim(error-status :get-message(3))
      681               trim(error-status :get-message(4))
      682               trim(error-status :get-message(5))
      683         view-as alert-box error.
      684         undo, return error .
      685     end.
      686   end.
      687   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
      688   do while v-found = no and jj < 2:
      689     if v-range <> 3 then do:
      690       find first buf_gds-grp-obj no-lock
      691           where buf_gds-grp-obj.node-code = p-node-code
      692             and buf_gds-grp-obj.host-code = v-host-code
      693             and buf_gds-grp-obj.obj-type  = p-obj-type
      694             and buf_gds-grp-obj.obj-code  = p-obj-code
      695       no-error .
      696     end.
      697     if v-range = 3 or not available buf_gds-grp-obj
      698     then do:
      699        if v-range <> 2 then do:
      700           find first buf_gds-grp-obj no-lock
      701               where buf_gds-grp-obj.node-code = p-node-code
      702                 and buf_gds-grp-obj.host-code = v-host-code
      703                 and buf_gds-grp-obj.obj-type  = ""
      704                 and buf_gds-grp-obj.obj-code  = 0
      705           no-error .
      706         end.
      707         if v-range = 2 or not available buf_gds-grp-obj
      708         then do:
      709             if v-range <> 1 then do:
      710               find first buf_gds-grp-obj no-lock
      711                   where buf_gds-grp-obj.node-code = p-node-code
      712                   and buf_gds-grp-obj.host-code = 0
      713                   and buf_gds-grp-obj.obj-type  = ""
      714                   and buf_gds-grp-obj.obj-code  = 0
      715               no-error .
      716             end.
      717             if v-range = 1 or not available buf_gds-grp-obj
      718             then do:
      719                 assign
      720                     v-exists = no
      721                 .
      722             end.
      723             else do:
      724                 assign
      725                     v-exists = yes
      726                     v-range = 1
      727                 .
      728             end.
      729         end.
      730         else do:
      731             assign
      732                 v-exists = yes
      733                 v-range  = 2
      734             .
      735         end.
      736     end.
      737     else do:
      738         assign
      739             v-exists = yes
      740             v-range  = 3
      741         .
      742     end.
      743     if available buf_gds-grp-obj
      744     then do:
      745       assign
      746       v-min-value    = buf_gds-grp-obj.min-increase
      747       v-max-value    = buf_gds-grp-obj.max-increase
      748       v-increase-pc  = buf_gds-grp-obj.increase-pc
      749       v-round-method = buf_gds-grp-obj.round-method
      750       v-base         = buf_gds-grp-obj.round-coef
      751       .
      752       assign
      753       p-exists-margin = (if v-min-value <> ? and v-max-value <> ? and p-min-value = ?
      754                           then yes
      755                           else p-exists-margin)
      756       p-range-margin = if p-exists-margin and p-min-value = ?
      757                         then v-range
      758                         else p-range-margin
      759       p-min-value   =  if p-exists-margin and  p-min-value = ?
      760                         then v-min-value
      761                         else p-min-value
      762       p-max-value   =  if p-exists-margin and  p-max-value = ?
      763                         then v-max-value
      764                         else p-max-value
      765       p-exists-increase = (if v-increase-pc <> ? and p-increase-pc = ?
      766                           then yes
      767                           else p-exists-increase)
      768       p-range-increase = if p-exists-increase and p-increase-pc = ?
      769                         then v-range
      770                         else p-range-increase
      771       p-increase-pc = (if p-exists-increase and p-increase-pc = ?
      772                         then v-increase-pc
      773                         else p-increase-pc)
      774       p-exists-rmethod = if v-round-method <> "":U and p-round-method = "":U
      775                           then yes
      776                           else p-exists-rmethod
      777       p-range-rmethod = (if p-exists-rmethod and p-round-method = "":U
      778                           then v-range
      779                           else p-range-rmethod)
      780       p-round-method  = (if p-exists-rmethod and p-round-method = "":U
      781                           then v-round-method
      782                           else p-round-method)
      783       p-base          = (if p-exists-rmethod and p-base = ?
      784                           then v-base
      785                           else p-base)
      786       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod) or (v-range <= 1)
      787       jj = jj + 1
      788       .
      789     end.
      790     else do:
      791       assign
      792       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod ) or (v-range <= 1)
      793       jj = jj + 1
      794       .
      795     end.
      796   end.
      797   end.
      798   end procedure.
      799   procedure grp-obj-income-cli-value :
      800   do
      801   on error undo, return error
      802   :
      803   define input parameter p-node-code as integer      no-undo.
      804   define input parameter p-obj-type  as character    no-undo.
      805   define input parameter p-obj-code  as integer      no-undo.
      806   define output parameter p-cli-type as character    no-undo init ?.
      807   define output parameter p-cli-code as integer      no-undo init ?.
      808   define output parameter p-range-income-cli     as integer      no-undo.
      809   define output parameter p-exists-income-cli    as logical      no-undo.
      810   define variable v-host-code as integer      no-undo.
      811   DEFINE VARIABLE v-found as logical no-undo .
      812   DEFINE VARIABLE v-exists as logical no-undo .
      813   DEFINE VARIABLE v-range as integer no-undo .
      814   DEFINE VARIABLE jj as integer no-undo .
      815   DEFINE VARIABLE v-income-cli-found as logical no-undo .
      816   DEFINE VARIABLE v-cli-type-value as char      no-undo.
      817   DEFINE VARIABLE v-cli-code-value as int      no-undo.
      818   define buffer buf_gds-grp for ub.gds-grp.
      819   find first buf_gds-grp no-lock where
      820              buf_gds-grp.node-code = p-node-code no-error .
      821   if not avail buf_gds-grp and p-node-code <> 0 then do:
      822     message
      823       vss-workfile vss-revision vss-description
      824       skip "Не удалось найти группу товаров с кодом" p-node-code
      825       view-as alert-box error .
      826     undo, return error .
      827   end.
      828   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      829   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      830     (input  p-obj-type
      831     ,input  p-obj-code
      832     ,output v-host-code
      833     ) no-error .
      834   if error-status :error
      835   then do:
      836       message
      837         vss-workfile vss-revision vss-description
      838         skip "Не удалось найти фирму объекта"
      839         skip p-obj-type p-obj-code
      840         skip return-value
      841         skip trim(error-status :get-message(1))
      842              trim(error-status :get-message(2))
      843              trim(error-status :get-message(3))
      844              trim(error-status :get-message(4))
      845              trim(error-status :get-message(5))
      846       view-as alert-box error.
      847       undo, return error .
      848   end.
      849   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
      850   do while v-found = no and jj < 2:
      851     if v-range <> 3 then do:
      852       find first buf_gds-grp-obj no-lock
      853           where buf_gds-grp-obj.node-code = p-node-code
      854             and buf_gds-grp-obj.host-code = v-host-code
      855             and buf_gds-grp-obj.obj-type  = p-obj-type
      856             and buf_gds-grp-obj.obj-code  = p-obj-code
      857       no-error .
      858     end.
      859     if v-range = 3 or not available buf_gds-grp-obj
      860     then do:
      861        if v-range <> 2 then do:
      862           find first buf_gds-grp-obj no-lock
      863               where buf_gds-grp-obj.node-code = p-node-code
      864                 and buf_gds-grp-obj.host-code = v-host-code
      865                 and buf_gds-grp-obj.obj-type  = ""
      866                 and buf_gds-grp-obj.obj-code  = 0
      867           no-error .
      868         end.
      869         if v-range = 2 or not available buf_gds-grp-obj
      870         then do:
      871             if v-range <> 1 then do:
      872               find first buf_gds-grp-obj no-lock
      873                   where buf_gds-grp-obj.node-code = p-node-code
      874                   and buf_gds-grp-obj.host-code = 0
      875                   and buf_gds-grp-obj.obj-type  = ""
      876                   and buf_gds-grp-obj.obj-code  = 0
      877               no-error .
      878             end.
      879             if v-range = 1 or not available buf_gds-grp-obj
      880             then do:
      881                 assign
      882                     v-exists = no
      883                 .
      884             end.
      885             else do:
      886                 assign
      887                     v-exists = yes
      888                     v-range = 1
      889                 .
      890             end.
      891         end.
      892         else do:
      893             assign
      894                 v-exists = yes
      895                 v-range  = 2
      896             .
      897         end.
      898     end.
      899     else do:
      900         assign
      901             v-exists = yes
      902             v-range  = 3
      903         .
      904     end.
      905     if available buf_gds-grp-obj
      906     then do:
      907       assign
      908       v-cli-type-value    = buf_gds-grp-obj.cli-type
      909       v-cli-code-value    = buf_gds-grp-obj.cli-code
      910       .
      911       assign
      912       p-exists-income-cli = (if v-cli-type-value <> ? and v-cli-code-value <> ? and p-cli-type = ?
      913                           then yes
      914                           else p-exists-income-cli)
      915       p-range-income-cli = if p-exists-income-cli and p-cli-type = ?
      916                         then v-range
      917                         else p-range-income-cli
      918       p-cli-type   =  if p-exists-income-cli and  p-cli-type = ?
      919                         then v-cli-type-value
      920                         else p-cli-type
      921       p-cli-code   =  if p-exists-income-cli and  p-cli-code = ?
      922                         then v-cli-code-value
      923                         else p-cli-code
      924       v-found =  (p-exists-income-cli ) or (v-range <= 1)
      925       jj = jj + 1
      926       .
      927     end.
      928     else do:
      929       assign
      930       v-found =  (p-exists-income-cli  ) or (v-range <= 1)
      931       jj = jj + 1
      932       .
      933     end.
      934   end.
      935   end.
      936   end procedure.
