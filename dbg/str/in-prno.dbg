     1298   define new global shared variable g#lib-trn4 as handle no-undo .
     1299   procedure main-road-tax :
     1300   define input parameter p-obj-type  like ub.gds-obj.obj-type  no-undo .
     1301   define input parameter p-obj-code  like ub.gds-obj.obj-code  no-undo .
     1302   define input parameter p-artic     like ub.gds-obj.artic     no-undo .
     1303   define input parameter p-prod-type like ub.gds-obj.prod-type no-undo .
     1304   define input parameter p-prod-code like ub.gds-obj.prod-code no-undo .
     1305   define input-output parameter p-road-tax-base as decimal no-undo .
     1306   define input-output parameter p-road-tax-rubl as decimal no-undo .
     1307   define variable v-doc-code as character no-undo .
     1308   define buffer     buff-goods    for ub.goods      .
     1309   define buffer     buf_gds-obj   for ub.gds-obj .
     1310   define buffer     buf_parts     for ub.parts   .
     1311   define buffer b-td_trn-doc for ub.trn-doc  .
     1312   define buffer b-dl_doc-line for ub.doc-line .
     1313   define variable is-petrolium              as logical no-undo .
     1314   define variable is-pieces                 as logical no-undo .
     1315   define variable is-hold-td                as logical no-undo .
     1316   define variable v-rec                     as recid   no-undo .
     1317   define variable t-ret                     as logical no-undo .
     1318   define variable v-total-avrg-base         as decimal no-undo .
     1319   define variable v-total-avrg-rubl         as decimal no-undo .
     1320   define variable v-total-avrg-qnty         as decimal no-undo .
     1321   define variable v-total-road-tax-base     as decimal no-undo .
     1322   define variable v-total-road-tax-rubl     as decimal no-undo .
     1323   define variable v-all-total-road-tax-base as decimal no-undo .
     1324   define variable v-all-total-road-tax-rubl as decimal no-undo .
     1325   assign
     1326     p-road-tax-base = ?
     1327     p-road-tax-rubl = ?
     1328     .
     1329     Find first buff-goods no-lock where
     1330           buff-goods.artic     = p-artic and
     1331           buff-goods.prod-type = p-prod-type and
     1332           buff-goods.prod-code = p-prod-code
     1333           no-error .
     1334         If avail buff-goods Then DO:
     1335              v-rec = recid (buff-goods).
     1336              t-ret =  session:SET-WAIT-STATE("GENERAL") .
     1337   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1338     (
     1339        input p-artic
     1340     ,  input p-prod-type
     1341     ,  input p-prod-code
     1342     , output is-petrolium
     1343     , output is-pieces
     1344     ) .
     1345              t-ret =  session:set-wait-state("") .
     1346              if not ( hvrdtax( v-rec ) = true and  is-petrolium = false  )   then  do:
     1347                   assign
     1348                     p-road-tax-base = ?
     1349                     p-road-tax-rubl = ?
     1350                     .
     1351                   return.
     1352              end.
     1353         end.
     1354         assign
     1355             v-total-avrg-qnty = 0
     1356             v-total-road-tax-base =  0
     1357             v-total-road-tax-rubl =  0
     1358             v-all-total-road-tax-base =  0
     1359             v-all-total-road-tax-rubl =  0
     1360             .
     1361         for each buf_parts no-lock
     1362           where buf_parts.obj-type  = p-obj-type
     1363             and buf_parts.obj-code  = p-obj-code
     1364             and buf_parts.artic     = p-artic
     1365             and buf_parts.prod-type = p-prod-type
     1366             and buf_parts.prod-code = p-prod-code
     1367             and buf_parts.status_   = no
     1368             and buf_parts.out-code  = 'free-zone':U
     1369             and buf_parts.qnty      > 0
     1370         on error undo, return error
     1371         :
     1372            v-total-avrg-qnty = v-total-avrg-qnty + buf_parts.fact-qnty.
     1373   assign
     1374     price-rubl-with-tax-loc = buf_parts.price-rubl
     1375     price-base-with-tax-loc = buf_parts.price-base
     1376   .
     1377   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1378   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1379     (output varinvprb
     1380     )  .
     1381     if buf_parts.out-code = 'free-zone':U     or
     1382        buf_parts.out-code = 'out-zone':U   or
     1383        buf_parts.doc-type = 'акт':U then do:
     1384       assign
     1385         in-vatp-have-vat-slt = yes.
     1386     end.
     1387     else do:
     1388       find first in-vatp_doc-attr no-lock
     1389         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     1390           and in-vatp_doc-attr.attr-code = 'envd':U
     1391         no-error .
     1392       if not available in-vatp_doc-attr then do:
     1393         assign
     1394           in-vatp-have-vat-slt = yes.
     1395       end.
     1396       else do:
     1397            in-vatp-have-vat-slt = no.
     1398       end.
     1399     end.
     1400     assign
     1401      price-cli-with-tax-loc = buf_parts.price-cli
     1402      cli-base-rate          = buf_parts.cli-base-rate.
     1403     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     1404              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     1405     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     1406             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     1407             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     1408             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     1409             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     1410             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     1411             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1412       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1413     assign
     1414       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     1415     assign
     1416       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1417       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1418       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1419       transport-cli-loc  = 0
     1420       other-cli-loc      = 0
     1421     .
     1422   ASSIGN
     1423             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1424       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1425   .
     1426           assign
     1427             v-all-total-road-tax-base =  v-all-total-road-tax-base + (road-tax-base-loc * buf_parts.fact-qnty)
     1428             v-all-total-road-tax-rubl =  v-all-total-road-tax-rubl + (road-tax-rubl-loc * buf_parts.fact-qnty)
     1429            .
     1430         end.
     1431             if v-total-avrg-qnty > 0 then  do :
     1432                 assign
     1433                     p-road-tax-base =  v-all-total-road-tax-base  / v-total-avrg-qnty
     1434                     p-road-tax-rubl =  v-all-total-road-tax-rubl  / v-total-avrg-qnty
     1435                     .
     1436              end.
     1437               if v-total-avrg-qnty <= 0 then do :
     1438                 find first buf_gds-obj no-lock
     1439                   where buf_gds-obj.obj-type  = p-obj-type
     1440                     and buf_gds-obj.obj-code  = p-obj-code
     1441                     and buf_gds-obj.artic     = p-artic
     1442                     and buf_gds-obj.prod-type = p-prod-type
     1443                     and buf_gds-obj.prod-code = p-prod-code
     1444                   no-error .
     1445                       if available buf_gds-obj then do :
     1446                         if buf_gds-obj.in-code <> "" then
     1447                              v-doc-code = buf_gds-obj.in-code.
     1448                         else do:
     1449                           if available ub.price-doc then  v-doc-code = ub.price-doc.out-code.
     1450                         end.
     1451   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1452   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     1453     (input  v-doc-code
