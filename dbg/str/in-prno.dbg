     1274   function hvrdtax return logical (input parrecid as recid):
     1275   define variable varresult as logical no-undo.
     1276   run hvrdtax-proc (input parrecid, output varresult).
     1277   return varresult.
     1278   end function.
     1279   procedure hvrdtax-proc:
     1280   define input  parameter parrecid  as recid   no-undo.
     1281   define output parameter parresult as logical no-undo.
     1282   define buffer bf_goods for ub.goods.
     1283   define buffer bf_units for ub.units.
     1284   define buffer rt_tax   for ub.tax.
     1285   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
     1286   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
     1287   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
     1288   if available rt_tax and
     1289       can-find(first ub.tax-units No-LOCK WHERE
     1290                      ub.tax-units.tax-code = rt_tax.tax-code AND
     1291                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
     1292                                                       else assign parresult = no.
     1293   end procedure.
     1294   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1295   define new global shared variable g#lib-trn  as handle no-undo .
