     1785                 ub.price-doc-forming-attr.plt-id       = p-plt-id       and
     1786                 ub.price-doc-forming-attr.plt-db-num   = p-plt-db-num   and
     1787                 ub.price-doc-forming-attr.pdf-id       = p-pdf-id       and
