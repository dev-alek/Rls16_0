     3472   end procedure.
     3473   procedure prcreate-new-price-doc-forming-gds :
     3474   define input  parameter p-price-doc-forming-recid as recid  no-undo.
     3475   define input  parameter p-obj-type   as character no-undo .
     3476   define input  parameter p-obj-code   as integer   no-undo .
     3477   define input  parameter par-pr-notls as character no-undo .
     3478   define input  parameter par-pr-altex as character no-undo .
     3479   define input  parameter par-pr-sclex as character no-undo .
     3480   define input  parameter p-line-num    as integer   no-undo .
     3481   define input  parameter p-gds-code    as integer   no-undo .
     3482   define input  parameter p-price-sale  as decimal   no-undo .
     3483   define buffer buf_price-doc-forming for ub.price-doc-forming  .
     3484   define buffer buf_goods for ub.goods  .
     3485   define buffer buf_bar-code for ub.bar-code  .
     3486   define buffer main_bar-code for ub.bar-code  .
     3487   define variable main-b-code as integer   no-undo .
     3488   define variable v-sec as integer   no-undo .
     3489     do
     3490     on error undo, return error return-value
     3491     :
     3492   define variable v-cur-dn as character no-undo .
     3493   define variable v-cur-pr as decimal   no-undo .
     3494   define variable v-cur-rt as decimal   no-undo .
     3495   define variable v-cur-ex as decimal   no-undo .
     3496   find first buf_price-doc-forming no-lock where
     3497              recid(buf_price-doc-forming) = p-price-doc-forming-recid  no-error .
     3498              if error-status :error then return error .
     3499   find first buf_goods no-lock where
     3500              buf_goods.gds-code  = p-gds-code no-error .
     3501              if error-status :error then return error .
     3502   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3503     (input  buf_goods.gds-code
     3504     ,input  ?
     3505     ,output main-b-code
     3506     ) no-error .
     3507   run check-use-bar-code (main-b-code) no-error .
     3508   if error-status :error then return .
     3509   run create-line-pdf-mpl-lib (
     3510        input buf_price-doc-forming.plt-db-num
     3511       ,input buf_price-doc-forming.plt-id
     3512       ,input buf_price-doc-forming.pdf-db
     3513       ,input buf_price-doc-forming.pdf-id
     3514       ,input p-line-num
     3515       ,input main-b-code
     3516       ,input buf_goods.artic
     3517       ,input buf_goods.prod-type
     3518       ,input buf_goods.prod-code
     3519       ,input ""
     3520       ,input 0
     3521       ,input p-price-sale
     3522       ,input ""
     3523       ,input 0
     3524      ,input-output v-sec ) no-error .
     3525      if error-status :error  then do:
     3526        message
     3527          vss-workfile vss-revision vss-description skip
     3528          error-status :get-message(1) skip
     3529          return-value skip
     3530          "2"
     3531          view-as alert-box error
     3532        .
     3533      end.
     3534   define buffer old_price-list for ub.price-list  .
     3535   if par-pr-notls = "yes" then do:
     3536   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3537   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     3538     (input  p-obj-type
     3539     ,input  p-obj-code
     3540     ,input  main-b-code
     3541     ,input  0
     3542     ,input  0
     3543     ,output v-cur-dn
     3544     ,output v-cur-pr
     3545     ,output v-cur-rt
     3546     ,output v-cur-ex
     3547     )  .
     3548   end.
     3549   if par-pr-altex = "yes" and
     3550      par-pr-notls = "yes" then do:
     3551       if v-cur-dn <> "" then do:
     3552           for each old_price-list no-lock where
     3553                    old_price-list.doc-num = v-cur-dn and
     3554                    old_price-list.artic      = buf_goods.artic and
     3555                    old_price-list.prod-type  = buf_goods.prod-type and
     3556                    old_price-list.prod-code  = buf_goods.prod-code and
     3557                    old_price-list.main-price = no,
     3558                   first buf_bar-code no-lock where
     3559                         buf_bar-code.b-code   = old_price-list.b-code and
     3560                         buf_bar-code.unit-cli <> buf_goods.unit-base
     3561                         :
     3562                          run check-use-bar-code (buf_bar-code.b-code) no-error .
     3563                          if error-status :error then next.
     3564                    run create-line-pdf-mpl-lib (
     3565                          input buf_price-doc-forming.plt-db-num
     3566                         ,input buf_price-doc-forming.plt-id
     3567                         ,input buf_price-doc-forming.pdf-db
     3568                         ,input buf_price-doc-forming.pdf-id
     3569                         ,input p-line-num
     3570                         ,input old_price-list.b-code
     3571                         ,input buf_goods.artic
     3572                         ,input buf_goods.prod-type
     3573                         ,input buf_goods.prod-code
     3574                         ,input ""
     3575                         ,input 0
     3576                         ,input old_price-list.price-sale
     3577                         ,input ""
     3578                         ,input 0
     3579                        ,input-output v-sec ) no-error .
     3580           end.
     3581       end.
     3582   end.
     3583   if par-pr-sclex = "yes" and
     3584      par-pr-notls = "yes" then do:
     3585       if v-cur-dn <> "" then do:
     3586           for each old_price-list no-lock where
     3587                    old_price-list.doc-num    = v-cur-dn and
     3588                    old_price-list.artic      = buf_goods.artic and
     3589                    old_price-list.prod-type  = buf_goods.prod-type and
     3590                    old_price-list.prod-code  = buf_goods.prod-code and
     3591                    old_price-list.main-price = no,
     3592                   first buf_bar-code no-lock where
     3593                         buf_bar-code.b-code   = old_price-list.b-code and
     3594                         buf_bar-code.in-code  = "" and
     3595                         buf_bar-code.unit-cli = buf_goods.unit-base
     3596                         :
     3597                          run check-use-bar-code (buf_bar-code.b-code) no-error .
     3598                          if error-status :error then next.
     3599                    run create-line-pdf-mpl-lib (
     3600                          input buf_price-doc-forming.plt-db-num
     3601                         ,input buf_price-doc-forming.plt-id
     3602                         ,input buf_price-doc-forming.pdf-db
     3603                         ,input buf_price-doc-forming.pdf-id
     3604                         ,input p-line-num
     3605                         ,input old_price-list.b-code
     3606                         ,input buf_goods.artic
     3607                         ,input buf_goods.prod-type
     3608                         ,input buf_goods.prod-code
     3609                         ,input ""
     3610                         ,input 0
     3611                         ,input old_price-list.price-sale
     3612                         ,input ""
     3613                         ,input 0
     3614                       ,input-output v-sec ) no-error .
     3615           end.
     3616       end.
     3617   end.
     3618   end.
     3619   end procedure.
     3620   procedure copy_new_price-doc-forming :
     3621   define input  parameter       p-recid      as recid no-undo .
     3622   define input-output parameter p-plt-db-num as integer   no-undo .
     3623   define input-output parameter p-plt-id     as integer   no-undo .
     3624   define output parameter       p-pdf-db-num as integer   no-undo .
     3625   define output parameter       p-pdf-id     as integer   no-undo .
     3626   define buffer buf_price-list-type        for ub.price-list-type  .
     3627   define buffer buf_price-doc-forming      for ub.price-doc-forming .
     3628   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr .
     3629   define buffer buf_price-doc-forming-gds  for ub.price-doc-forming-gds .
     3630   define buffer buf_pd-forming-gds-attr    for ub.price-doc-forming-gdsattr .
     3631   define variable v-host-code  as integer   no-undo .
     3632   define variable v-base-rate  as decimal   no-undo .
     3633   define variable v-base-scale as integer   no-undo .
     3634   define variable v-exch-rate  as decimal   no-undo .
     3635   define variable v-exch-scale as integer   no-undo .
     3636   define variable v-base as logical   no-undo .
     3637   define variable v-name as character no-undo .
     3638     do
     3639     on error undo, return error return-value
     3640     :
     3641   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3642   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     3643     (output v-base
     3644     )  .
     3645   find first buf_price-list-type no-lock where
     3646              buf_price-list-type.plt-db-num = p-plt-db-num and
     3647              buf_price-list-type.plt-id     = p-plt-id no-error .
     3648   if error-status :error then return error "Не найден ТПЛ".
     3649   if buf_price-list-type.stts <> 0 then return error "ТПЛ удален" .
     3650   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming )  = p-recid no-error .
     3651       if available buf_price-doc-forming then do :
     3652           assign
     3653             v-base-rate  = buf_price-doc-forming.base-rate
     3654             v-base-scale = buf_price-doc-forming.base-scale
     3655             v-name       =  substitute("Скопировано с ДНЦ &1 &2",  buf_price-doc-forming.pdf-id , trim(buf_price-doc-forming.name)  )
     3656           .
     3657       end.
     3658       else do:
     3659           assign
     3660             v-base-rate  = 1
     3661             v-base-scale = 1
     3662             v-name       = "Автосоздание"
     3663           .
     3664       end.
     3665      create ub.price-doc-forming.
     3666      assign
     3667         ub.price-doc-forming.plt-id       = p-plt-id
     3668         ub.price-doc-forming.plt-db-num   = p-plt-db-num
     3669         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
     3670         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
     3671         ub.price-doc-forming.base-rate    = v-base-rate
     3672         ub.price-doc-forming.base-scale   = v-base-scale
     3673         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
     3674         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
     3675         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
     3676         ub.price-doc-forming.stts         = 0
     3677         ub.price-doc-forming.sys-date     = today
     3678         ub.price-doc-forming.sys-time     = time
     3679         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
     3680         ub.price-doc-forming.who          = v-cntxt-userid
     3681         ub.price-doc-forming.name         = v-name
     3682      .
     3683      assign
     3684       p-pdf-db-num  = ub.price-doc-forming.pdf-db
     3685       p-pdf-id      = ub.price-doc-forming.pdf-id
     3686       p-plt-db-num  = ub.price-doc-forming.plt-db-num
     3687       p-plt-id      = ub.price-doc-forming.plt-id
     3688      .
     3689     end.
     3690     if not available buf_price-doc-forming then return .
     3691   for each buf_price-doc-forming-attr no-lock where
     3692            buf_price-doc-forming-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     3693            buf_price-doc-forming-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     3694            buf_price-doc-forming-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     3695            buf_price-doc-forming-attr.plt-id      = buf_price-doc-forming.plt-id       :
     3696       create ub.price-doc-forming-attr.
     3697       buffer-copy buf_price-doc-forming-attr to ub.price-doc-forming-attr
     3698       assign
     3699         ub.price-doc-forming-attr.plt-db-num  = p-plt-db-num
     3700         ub.price-doc-forming-attr.plt-id      = p-plt-id
     3701         ub.price-doc-forming-attr.pdf-db     = p-pdf-db-num
     3702         ub.price-doc-forming-attr.pdf-id      = p-pdf-id
     3703         .
     3704   end.
     3705   for each buf_price-doc-forming-gds no-lock where
     3706            buf_price-doc-forming-gds.pdf-db      = buf_price-doc-forming.pdf-db       and
     3707            buf_price-doc-forming-gds.pdf-id      = buf_price-doc-forming.pdf-id       and
     3708            buf_price-doc-forming-gds.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     3709            buf_price-doc-forming-gds.plt-id      = buf_price-doc-forming.plt-id       :
     3710       create ub.price-doc-forming-gds.
     3711       buffer-copy buf_price-doc-forming-gds to ub.price-doc-forming-gds
     3712       assign
     3713         ub.price-doc-forming-gds.plt-db-num  = p-plt-db-num
     3714         ub.price-doc-forming-gds.plt-id      = p-plt-id
     3715         ub.price-doc-forming-gds.pdf-db      = p-pdf-db-num
     3716         ub.price-doc-forming-gds.pdf-id      = p-pdf-id
     3717       .
     3718   end.
     3719   for each buf_pd-forming-gds-attr no-lock where
     3720            buf_pd-forming-gds-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     3721            buf_pd-forming-gds-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     3722            buf_pd-forming-gds-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     3723            buf_pd-forming-gds-attr.plt-id      = buf_price-doc-forming.plt-id       :
     3724       create ub.price-doc-forming-gdsattr.
     3725       buffer-copy buf_pd-forming-gds-attr to ub.price-doc-forming-gdsattr
     3726       assign
     3727         ub.price-doc-forming-gdsattr.plt-db-num  = p-plt-db-num
     3728         ub.price-doc-forming-gdsattr.plt-id      = p-plt-id
     3729         ub.price-doc-forming-gdsattr.pdf-db      = p-pdf-db-num
     3730         ub.price-doc-forming-gdsattr.pdf-id      = p-pdf-id
     3731       .
     3732   end.
     3733   end procedure.
     3734   define variable par-pr-incpc as character no-undo.
     3735   define variable par-pr-rndmt as character no-undo.
