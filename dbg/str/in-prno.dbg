     1942   procedure lineattr-delete :
     1943     do
     1944     on error undo, return error return-value
     1945     :
     1946       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     1947       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     1948       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     1949       define output parameter p-deleted  as logical no-undo.
     1950       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1951       def var v-type           as character no-undo .
     1952       def var v-format         as character no-undo .
     1953       def var v-fillin_width   as integer   no-undo .
     1954       def var v-fillin_height  as integer   no-undo .
     1955       def var v-label          as character no-undo .
     1956       def var v-user-can-edit  as logical   no-undo .
     1957       def var v-output-display as logical   no-undo .
     1958       def var v-other          as character no-undo .
     1959       run lineattr-code in this-procedure
     1960         (input  p-code
     1961         ,output v-type
     1962         ,output v-format
     1963         ,output v-fillin_width
     1964         ,output v-fillin_height
     1965         ,output v-label
     1966         ,output v-user-can-edit
     1967         ,output v-output-display
     1968         ,output v-other
     1969         ) no-error .
     1970       if error-status :error then do:
     1971         undo, return error return-value .
     1972       end.
     1973       find first buf_doc-line-attr exclusive-lock
     1974         where buf_doc-line-attr.doc-code  = p-doc-code
     1975           and buf_doc-line-attr.gds-code  = p-gds-code
     1976           and buf_doc-line-attr.attr-code = p-code
     1977         no-error NO-WAIT.
     1978       if not available buf_doc-line-attr then do:
     1979         p-deleted = no.
     1980       end.
     1981       else do:
     1982         delete buf_doc-line-attr.
     1983         p-deleted = yes.
     1984       end.
     1985     end.
     1986   end procedure.
     1987   procedure lineattr-code :
     1988     do on error undo, return error return-value
     1989     :
     1990       define input  parameter p-code           as character no-undo .
     1991       define output parameter p-type           as character no-undo .
     1992       define output parameter p-format         as character no-undo .
     1993       define output parameter p-fillin_width   as integer   no-undo .
     1994       define output parameter p-fillin_height  as integer   no-undo .
     1995       define output parameter p-label          as character no-undo .
     1996       define output parameter p-user-can-edit  as logical   no-undo .
     1997       define output parameter p-output-display as logical   no-undo .
     1998       define output parameter p-other          as character no-undo .
     1999       case p-code :
     2000               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     2001               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     2002               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     2003               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     2004               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     2005               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     2006               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     2007               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     2008               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     2009               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     2010               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     2011         otherwise do:
     2012           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
     2013         end.
     2014       end.
     2015     end.
     2016   end procedure.
     2017   procedure lineattr-value-flora-gds :
     2018     do
     2019     on error undo, return error return-value
     2020     :
     2021       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
     2022       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
     2023       define input  parameter p-prt-code    as integer   no-undo .
     2024       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
     2025       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
     2026       define output parameter p-value       as    decimal   no-undo .
     2027       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2028       find first buf_doc-line-attr no-lock
     2029         where buf_doc-line-attr.doc-code  = p-doc-code
     2030           and buf_doc-line-attr.gds-code  = p-gds-code
     2031           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     2032         no-error .
     2033       if avail buf_doc-line-attr then do:
     2034         assign
     2035           p-value = decimal( buf_doc-line-attr.attr-value)
     2036         .
     2037       end.
     2038       else do:
     2039         assign
     2040           p-value = 0
     2041         .
     2042       end.
     2043     end.
     2044   end procedure.
     2045   procedure lineattr-write-flora-gds :
     2046     do
     2047     on error undo, return error return-value
     2048     :
     2049       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     2050       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2051       define input parameter p-prt-code    as integer   no-undo .
     2052       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2053       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     2054       define input parameter p-value    as decimal   no-undo .
     2055       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2056       find first buf_doc-line-attr exclusive-lock
     2057         where buf_doc-line-attr.doc-code  = p-doc-code
     2058           and buf_doc-line-attr.gds-code  = p-gds-code
     2059           and buf_doc-line-attr.attr-code = p-code + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     2060         no-error .
     2061       if not available buf_doc-line-attr then do:
     2062         create buf_doc-line-attr .
     2063         assign
     2064           buf_doc-line-attr.doc-code  = p-doc-code
     2065           buf_doc-line-attr.gds-code  = p-gds-code
     2066           buf_doc-line-attr.attr-code = p-code  + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     2067         .
     2068       end.
     2069       assign
     2070         buf_doc-line-attr.attr-value = string( p-value )
     2071       .
     2072     end.
     2073   end procedure.
     2074   procedure lineattr-delete-flora-gds :
     2075     do
     2076     on error undo, return error return-value
     2077     :
     2078       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     2079       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2080       define input  parameter p-prt-code    as integer   no-undo .
     2081       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2082       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     2083       define output parameter p-deleted  as logical no-undo.
     2084       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2085       find first buf_doc-line-attr exclusive-lock
     2086         where buf_doc-line-attr.doc-code  = p-doc-code
     2087           and buf_doc-line-attr.gds-code  = p-gds-code
     2088           and buf_doc-line-attr.attr-code = p-code + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     2089         no-error NO-WAIT.
     2090       if not available buf_doc-line-attr then do:
     2091         p-deleted = no.
     2092       end.
     2093       else do:
     2094         delete buf_doc-line-attr.
     2095         p-deleted = yes.
     2096       end.
     2097     end.
     2098   end procedure.
     2099   procedure lineattr-delete-flora-all :
     2100     do
     2101     on error undo, return error return-value
     2102     :
     2103       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     2104       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     2105       define input  parameter p-prt-code    as integer   no-undo .
     2106       define buffer buf_doc-line-attr for ub.doc-line-attr .
     2107       for each buf_doc-line-attr exclusive-lock
     2108         where buf_doc-line-attr.doc-code  = p-doc-code
     2109           and buf_doc-line-attr.gds-code  = p-gds-code
     2110           and buf_doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(p-prt-code)  + chr(44)
     2111        :
     2112         delete buf_doc-line-attr.
     2113       end.
     2114    end.
     2115   end procedure.
     2116   procedure lineattr-exist-flora-gds :
     2117     do
     2118     on error undo, return error return-value
     2119     :
     2120       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
     2121       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
