     1774   procedure pdoc-forming-attr :
     1775   define input  parameter p-plt-id       as integer   no-undo .
     1776   define input  parameter p-plt-db-num   as integer   no-undo .
     1777   define input  parameter p-pdf-id       as integer   no-undo .
     1778   define input  parameter p-pdf-db       as integer   no-undo .
     1779   define input  parameter p-attr-code    as character no-undo .
     1780   define input  parameter p-val          as character no-undo .
     1781     do
     1782     on error undo, return error return-value
     1783     :
