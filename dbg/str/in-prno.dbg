     5911                       buf-price-list.calc-method = 'Накл-безНДС':U + " " + doc-code
     5912                       buf-price-list.price-calc  =  if var-pr-r-b = "rubl" then ub.doc-line.price-rubl else ub.doc-line.price-base
     5913                       buf-price-list.price-sale  =  if var-pr-r-b = "rubl" then v-price-rubl        else v-price-base
     5914                       buf-price-list.road-tax    = cur-rt
     5915                       tt-price-sale   =  if var-pr-r-b = "rubl" then v-price-rubl        else v-price-base
     5916                     .
     5917                 end.
     5918                 else do:
