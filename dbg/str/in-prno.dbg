     5727     define variable p-cur-rt   as decimal   no-undo .
     5728     define variable p-cur-ex   as decimal   no-undo .
     5729     define variable v-name-tax as character no-undo .
     5730   define variable vss-include-info62 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
