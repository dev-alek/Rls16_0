     3361     ,input  ?
     3362     ,input  p-hostcode
     3363     ,input  buf_price-doc.obj-type
     3364     ,input  buf_price-doc.obj-code
     3365     ,output local_vat-pc
     3366     ) no-error .
     3367   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3368   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3369     (input  buf_goods.gds-code
     3370     ,input  '2':U
     3371     ,input  ?
     3372     ,input  p-hostcode
     3373     ,input  buf_price-doc.obj-type
     3374     ,input  buf_price-doc.obj-code
     3375     ,output local_slt-pc
     3376     ) no-error .
     3377       kk = kk + 1.
     3378   define variable v-main-bar-code as integer   no-undo .
     3379   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3380     (input  buf_goods.gds-code
     3381     ,input  ?
     3382     ,output v-main-bar-code
     3383     )  .
     3384       create buf_price-list.
     3385       assign
     3386           buf_price-list.line-num    = kk
     3387           buf_price-list.doc-num     = buf_price-doc.doc-num
     3388           buf_price-list.b-code      = buf_bar-code.b-code
     3389           buf_price-list.artic       = buf_goods.artic
     3390           buf_price-list.prod-type   = buf_goods.prod-type
     3391           buf_price-list.prod-code   = buf_goods.prod-code
     3392           buf_price-list.main-price  = (buf_bar-code.b-code = v-main-bar-code )
     3393           buf_price-list.calc-method = 'Отсутствует':U
     3394           buf_price-list.obj-type    = buf_price-doc.obj-type
     3395           buf_price-list.obj-code    = buf_price-doc.obj-code
     3396           buf_price-list.price-sale  = p-price-sale
     3397           buf_price-list.vat-pc      = local_vat-pc
     3398           buf_price-list.slt-pc      = local_slt-pc
     3399           p-update                   = no
     3400       .
     3401   end.
     3402   end.
     3403   end procedure.
     3404   procedure create_new_price-doc-forming :
     3405   define input  parameter p-obj-type   as character no-undo .
     3406   define input  parameter p-obj-code   as integer   no-undo .
