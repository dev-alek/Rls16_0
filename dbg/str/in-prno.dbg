     2374             v-cntxp-price-calc      = bf-cntxp_shop.price-calc
     2375             v-cntxp-inout-price     = bf-cntxp_shop.inout-price
     2376             v-cntxp-unit-cli-perm   = bf-cntxp_shop.unit-cli-perm
     2377             v-cntxp-out-rate        = bf-cntxp_shop.out-rate
     2378             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
     2379             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
     2380             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
     2381             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
     2382             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
     2383             v-cntxp-load-time       = bf-cntxp_shop.load-time
