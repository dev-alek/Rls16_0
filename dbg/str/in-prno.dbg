     7973     end case.
     7974     run create-price-list-attr
     7975     ( 'full-price-sale':U ,
     7976        tt-price-sale      ,
     7977        buf-price-list.b-code ,
     7978        buf-price-list.doc-num ,
     7979        buf-price-list.price-type  ).
     7980   run main-road-tax
     7981     ( input buf-price-list.obj-type ,
     7982       input buf-price-list.obj-code ,
     7983       input buf-price-list.artic    ,
     7984       input buf-price-list.prod-type,
     7985       input buf-price-list.prod-code,
     7986       input-output cur-rt-base,
     7987       input-output cur-rt-rubl )
     7988       .
     7989       if var-pr-r-b = "rubl" then do:
     7990           if ( cur-rt-rubl <> ? )   then
     7991             assign
     7992               buf-price-list.road-tax  = cur-rt-rubl
     7993               .
     7994               else
     7995                   assign
     7996                     buf-price-list.road-tax  = 0
     7997                     .
     7998      end.
     7999      else do:
     8000           if ( cur-rt-base <> ? )   then
     8001             assign
     8002               buf-price-list.road-tax  = cur-rt-base
     8003               .
     8004               else
     8005                   assign
     8006                     buf-price-list.road-tax  = 0
     8007                     .
     8008      end.
     8009   case round-method :
     8010     when '9-окончание':U then do:
     8011       if buf-price-list.price-sale < 29 then do:
     8012         if (buf-price-list.price-sale - truncate (buf-price-list.price-sale, 0)) <> 0 then do:
     8013           assign
     8014             buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 1
     8015           .
     8016         end.
     8017       end.
     8018       else do:
     8019         if (buf-price-list.price-sale modulo 10) < 3 then do:
     8020           assign
     8021             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     8022                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     8023                   - 1 ) * 10
     8024                 + 9
     8025           .
     8026         end.
     8027         else do:
     8028           assign
     8029             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     8030                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     8031                   ) * 10
     8032                 + 9
     8033           .
     8034         end.
     8035         assign
     8036           buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     8037         .
     8038       end.
     8039     end.
     8040     when '9-99окончание':U then do:
     8041       if buf-price-list.price-sale < round-base then do:
     8042         assign
     8043           buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 0.99
     8044         .
     8045       end.
     8046       else do:
     8047         assign
     8048           buf-price-list.price-sale = truncate (buf-price-list.price-sale / 10 , 0) * 10 + 9.99
     8049         .
     8050       end.
     8051     end.
     8052     when 'Без-дробных':U then do:
     8053       assign
     8054         buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     8055       .
     8056     end.
     8057     when 'Произвольно':U then do:
     8058       if round-base <> 0 then do:
     8059         assign
     8060           buf-price-list.price-sale = round (buf-price-list.price-sale / round-base, 0) * round-base
     8061         .
     8062         if buf-price-list.price-sale = 0 then do:
     8063           assign
     8064             buf-price-list.price-sale = round-base
     8065           .
     8066         end.
     8067       end.
     8068     end.
     8069     when 'Вверх':U then do:
     8070       if round-base <> 0 then do:
     8071         if truncate ( buf-price-list.price-sale / round-base, 0 ) <> (buf-price-list.price-sale / round-base) then do:
     8072           assign
     8073             buf-price-list.price-sale = truncate (buf-price-list.price-sale / round-base, 0) * round-base + round-base
     8074           .
     8075         end.
     8076       end.
     8077       if buf-price-list.price-sale = 0 then do:
     8078         assign
     8079           buf-price-list.price-sale = round-base
     8080         .
     8081       end.
     8082     end.
     8083     when 'Коэффициент':U then do:
     8084       if round-base <> 0 then do:
     8085         assign
     8086           buf-price-list.price-sale = buf-price-list.price-sale * round-base
     8087         .
     8088       end.
     8089     end.
     8090     when 'Отключено':U then do:
     8091     end.
     8092     otherwise do:
     8093       message
     8094         vss-workfile vss-revision vss-description skip
     8095         "Неизвестный метод округления продажной цены" skip
     8096         "round-method" round-method skip
     8097         "round-base"   round-base   skip
     8098         "price"        buf-price-list.price-sale             skip
     8099         view-as alert-box error .
     8100     end.
     8101   end.
     8102     calc-rec = recid (buf-price-list).
     8103     run calc-pr-sub (input  buf-bar-code.b-code,
     8104                      input  buf-price-list.doc-num,
     8105                      input  calc-method,
     8106                      input  increase-pc,
     8107                      input  round-method,
     8108                      input  round-base,
     8109                      output calc-rec) no-error.
     8110     if error-status :error then
     8111       undo calc-pr, return error.
     8112       old-price-sale = buf-price-list.price-sale .
     8113      if line-mode = "calc":u then do:
     8114           run calc-sigma (input buf-price-list.b-code,
     8115                           input-output buf-price-list.price-sale,
     8116                           input buf-price-doc.host-code,
     8117                           input buf-price-doc.obj-code,
     8118                           input buf-price-doc.obj-type,
     8119                           output loc-ret).
     8120           if loc-ret = false then
     8121             message "Цена товара :" SKIP
     8122             "артикул :" buf-price-list.artic buf-price-list.prod-type buf-price-list.prod-code skip
     8123             "бар-код :" buf-price-list.b-code skip
     8124               "не изменилась из-за заданного максимально допустимого отклонения! " skip
     8125               " Рассчитанная цена "  old-price-sale skip
     8126               " Действующая цена "   buf-price-list.price-sale
     8127               view-as alert-box .
     8128      end.
     8129   end.
     8130   END PROCEDURE.
     8131   procedure calc-sigma :
     8132    do
     8133    on error undo, return error return-value
     8134    :
     8135   define input parameter l-bcode like ub.price-list.b-code no-undo .
     8136   define input-output parameter new-price as decimal no-undo .
     8137   define input parameter l-host as integer no-undo .
     8138   define input parameter l-code as integer no-undo .
     8139   define input parameter l-type as character no-undo .
     8140   define output parameter p-ret as logical no-undo .
     8141   define variable conf-par     as character no-undo.
     8142   define variable par-type     as character no-undo.
     8143   define variable i-sigma as decimal no-undo .
     8144   define variable cur-pr like ub.price-list.price-sale no-undo.
     8145   define variable cur-rt like ub.price-list.road-tax   no-undo.
     8146   define variable cur-ex like ub.price-list.excise     no-undo.
     8147   define variable cur-dn like ub.price-list.doc-num    no-undo.
     8148   define variable old-price as decimal no-undo .
     8149   define variable v-value-character as character no-undo .
     8150   define variable v-value-date      as date      no-undo .
     8151   define variable v-value-decimal   as decimal   no-undo .
     8152   define variable v-value-integer   as integer   no-undo .
     8153   define variable v-value-logical   as logical   no-undo .
     8154   p-ret = true  .
     8155   if par-pr-sigma <> ? and par-pr-sigma <> "" and par-pr-sigma <> "0" then do:
     8156   define variable vss-include-info80 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8157   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     8158     (input  l-type
     8159     ,input  l-code
     8160     ,input  l-bcode
     8161     ,input  0
     8162     ,input  0
     8163     ,output cur-dn
     8164     ,output cur-pr
     8165     ,output cur-rt
     8166     ,output cur-ex
     8167     )  .
     8168   old-price = cur-pr .
     8169   if old-price =  new-price then do:
     8170      p-ret = true .
     8171      return.
     8172   end.
     8173      i-sigma = decimal(par-pr-sigma) .
     8174      if ( 100 * ABSOLUTE( old-price - new-price ) / old-price ) <= i-sigma then do:
     8175          assign
     8176            p-ret = false
     8177            new-price = old-price
     8178          .
     8179          end.
     8180      else p-ret = true .
     8181     end.
     8182    end.
     8183   end procedure.
     8184   define variable vss-include-info81 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8185   PROCEDURE VER-PR-EQU-DQ :
     8186   define input parameter  l-doc-num    like ub.price-list.doc-num    no-undo .
     8187   define input parameter  l-num       as integer no-undo .
     8188   define input parameter  l-b-code    as integer   no-undo .
     8189   define variable  l-doc-num2    like ub.price-list.doc-num    no-undo .
     8190   define buffer l-price-list  for ub.price-list .
     8191   define buffer pp_price-list for ub.price-list .
     8192   define buffer p2_price-list for ub.price-list .
     8193   define buffer main_price-list for ub.price-list .
     8194   define buffer alt_price-list  for ub.price-list .
     8195   define buffer buf1-bar-code for ub.bar-code .
     8196   define buffer buf2-bar-code for ub.bar-code .
     8197   define variable v-num as integer init 0 no-undo .
     8198   define variable bbb as logical no-undo .
     8199   define variable  l-price-sale like ub.price-list.price-sale no-undo .
     8200   define variable  l-road-tax   like ub.price-list.road-tax   no-undo .
     8201   define variable  l-excise     like ub.price-list.excise     no-undo .
     8202   define variable  l-ok         as logical no-undo .
     8203   define variable  check-par    as logical no-undo .
     8204   for each l-price-list where l-price-list.doc-num = l-doc-num     and
     8205                               l-price-list.main-price = true
     8206                               exclusive-lock  :
     8207     find first ub.goods where ub.goods.artic    = l-price-list.artic and
     8208                           ub.goods.prod-type = l-price-list.prod-type and
     8209                           ub.goods.prod-code = l-price-list.prod-code no-lock   .
     8210         check-par = false .
     8211         if l-num = 2 then do:
     8212           find first buf2-bar-code where buf2-bar-code.b-code = l-b-code no-lock no-error .
     8213           if ub.goods.gds-code <> buf2-bar-code.gds-code then next.
     8214         end.
     8215   define variable vss-include-info82 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8216   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     8217     (input  l-price-list.obj-type
     8218     ,input  l-price-list.obj-code
     8219     ,input  l-price-list.b-code
     8220     ,input  0
     8221     ,input  0
     8222     ,output l-doc-num2
     8223     ,output l-price-sale
     8224     ,output l-road-tax
     8225     ,output l-excise
     8226     ) no-error .
     8227         if l-doc-num2 <> ? then do :
     8228           if l-price-sale = l-price-list.price-sale
     8229           then do:
     8230             if par-pr-equ-dq >= 2 then do:
     8231               check-par = false .
     8232                  for each pp_price-list no-lock where pp_price-list.doc-num = l-doc-num   and
     8233                     pp_price-list.artic       =  l-price-list.artic      and
     8234                     pp_price-list.prod-type   =  l-price-list.prod-type  and
     8235                     pp_price-list.prod-code   =  l-price-list.prod-code  and
     8236                     pp_price-list.main-price  =  no  :
     8237                       check-par = true  .
     8238                       leave.
     8239                   end.
     8240               if  check-par = true then NEXT .
     8241               if par-pr-equ-dq = 2 then do:
     8242                 if  ( v-num <= 2  and check-par = false ) then
     8243                 run gbl/d-askw.w
     8244                   (input "Удалить строку?"
     8245                   ,input      "Предыдущая цена РАВНА цене по закрываемому документу " + chr(10)
     8246                               + " Объект "  + l-price-list.obj-type + " " + String(l-price-list.obj-code) + chr(10)
     8247                               + " Артикул " + l-price-list.artic    + " " +  ub.goods.gds-name + chr(10)
     8248                               + " Бар-код " + string(l-price-list.b-code)
     8249                               + " Цена по предыдущему документу № " + l-doc-num + " "
     8250                               + string(l-price-sale) + chr(10)
     8251                               + string(l-price-list.price-sale)
     8252                               + " Удалить строку? "
     8253                   ,input "|^"
     8254                   ,input "Да|Нет|Да для всех^confirm|Нет для всех^confirm"
     8255                   ,input "Удалить строку|"
     8256                       + "Не удалять строку|"
     8257                       + "Удалять у всех товаров, цена на которые не изменилась|"
     8258                       + "Не удалять у всех товаров, цена на которые не изменилась"
     8259                   ,input 1
     8260                   ,input 2
     8261                   ,output v-num
     8262                   ).
     8263                 end.
     8264                 else do:
     8265                   v-num = 3 .
     8266                 end.
     8267                   if v-num = 1 then do:
     8268                     run del-pr-list (input l-price-list.b-code,
     8269                                     input l-price-list.doc-num,
     8270                                     input ?,
     8271                                     input ?) no-error.
     8272                                     if error-status :error then do:
     8273                                             message  vss-workfile vss-revision vss-description skip
     8274                                             "Ошибка при удаление строки переоценки "
     8275                                             l-price-list.b-code skip
     8276                                             error-status :get-message(1) .
     8277                                             return error.
     8278                                     end.
     8279                   end.
     8280                   if v-num = 3  then do:
     8281                      run del-pr-list (input l-price-list.b-code,
     8282                                       input l-price-list.doc-num,
     8283                                       input ?,
     8284                                       input ?)
     8285                                       no-error.
     8286                   end.
     8287             end.
     8288           end.
     8289          end.
     8290   end.
     8291     if par-pr-equ-dq >= 2 then do:
     8292        for each main_price-list no-lock where
     8293                 main_price-list.doc-num         = l-doc-num   and
     8294                 main_price-list.main-price      = true ,
     8295           first ub.goods where ub.goods.artic   = main_price-list.artic and
     8296                           ub.goods.prod-type = main_price-list.prod-type and
     8297                           ub.goods.prod-code = main_price-list.prod-code no-lock   :
     8298                if l-num = 2 then do:
     8299                   find first buf2-bar-code where buf2-bar-code.b-code = l-b-code no-lock no-error .
     8300                   if ub.goods.gds-code <> buf2-bar-code.gds-code then next.
     8301                end.
     8302                   for each pp_price-list no-lock where
     8303                     pp_price-list.doc-num         = main_price-list.doc-num    and
     8304                     pp_price-list.artic           = main_price-list.artic      and
     8305                     pp_price-list.prod-type       = main_price-list.prod-type  and
     8306                     pp_price-list.prod-code       = main_price-list.prod-code  and
     8307                     pp_price-list.main-price      = no and
     8308                     pp_price-list.price-sale      = main_price-list.price-sale  ,
     8309                       first buf1-bar-code no-lock where
     8310                         buf1-bar-code.b-code    = pp_price-list.b-code and
     8311                         buf1-bar-code.unit-cli  = ub.goods.unit-base break by buf1-bar-code.b-code :
     8312                             if first-of( buf1-bar-code.b-code ) then do:
     8313                             bbb = false.
     8314                                      for each alt_price-list where
     8315                                             pp_price-list.doc-num         = alt_price-list.doc-num    and
     8316                                             pp_price-list.artic           = alt_price-list.artic      and
     8317                                             pp_price-list.prod-type       = alt_price-list.prod-type  and
     8318                                             pp_price-list.prod-code       = alt_price-list.prod-code  and
     8319                                             pp_price-list.main-price      = no  no-lock :
     8320                                           if pp_price-list.b-code   =  fnc-base-code (alt_price-list.b-code) and
     8321                                             alt_price-list.b-code = pp_price-list.b-code then next.
     8322                                             if fnc-base-code (alt_price-list.b-code) = pp_price-list.b-code
     8323                                             then do:
     8324                                                   bbb = true .
     8325                                                   leave.
     8326                                              end.
     8327                                      end.
     8328                                       if bbb = false then do:
     8329                                           run del-pr-list ( input pp_price-list.b-code  ,
     8330                                                             input pp_price-list.doc-num ,
     8331                                                             input ? ,
     8332                                                             input ? ) no-error.
     8333                                           if error-status :error then do:
     8334                                             message  vss-workfile vss-revision vss-description skip
     8335                                             " Нельзя удалить " pp_price-list.b-code skip
     8336                                             error-status :get-message(1) .
     8337                                             end.
     8338                                       end.
     8339                             end.
     8340                   end.
     8341        end.
     8342    end.
     8343   end procedure.
     8344   define variable vss-include-info83 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8345   procedure exp-prt :
     8346     define input  parameter  g-code  like ub.goods.gds-code    no-undo.
     8347     define input  parameter  old-num like ub.price-doc.doc-num no-undo.
     8348     define input  parameter  new-num like ub.price-doc.doc-num no-undo.
     8349     define output parameter  new-rec as recid               no-undo.
     8350     do
     8351     on error undo, return error return-value
     8352     :
     8353     define buffer buf-bar-code   for ub.bar-code.
     8354     define buffer buf-goods      for ub.goods.
     8355     define buffer buf-price-list for ub.price-list.
     8356     find buf-goods no-lock where
     8357         buf-goods.gds-code = g-code.
     8358     if par-pr-altex = "yes" and
     8359        par-pr-notls = "yes" then do:
     8360   define variable vss-include-info84 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8361   for each  buf-price-list where
     8362             buf-price-list.doc-num    = old-num and
     8363             buf-price-list.artic      = buf-goods.artic and
     8364             buf-price-list.prod-type  = buf-goods.prod-type and
     8365             buf-price-list.prod-code  = buf-goods.prod-code and
     8366             buf-price-list.main-price = no,
     8367       first buf-bar-code no-lock where
     8368             buf-bar-code.b-code   = buf-price-list.b-code and
     8369             buf-bar-code.unit-cli <> buf-goods.unit-base:
     8370     run cre-pr-list (input  buf-bar-code.b-code,
     8371                      input  new-num,
     8372                      output new-rec) no-error.
     8373     if error-status:error then do:
     8374       message
     8375         "Ошибка cre-pr-list." skip
     8376         "Код:" buf-bar-code.b-code
     8377         view-as alert-box.
     8378       next.
     8379     end.
     8380   end.
     8381     end.
     8382     if par-pr-sclex = "yes" and
     8383       par-pr-notls = "yes" then do:
     8384   define variable vss-include-info85 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8385       define buffer buf_alt-calc_price-doc86 for ub.price-doc .
     8386     find first buf_alt-calc_price-doc86 no-lock
     8387       where buf_alt-calc_price-doc86.doc-num = old-num
     8388       .
     8389     define variable v-ok as logical   no-undo .
     8390   define variable vss-include-info87 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8391   do:
     8392     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8393       (input  v-cntxt-db-num
     8394       ,input  v-cntxt-userid
     8395       ,input  0
     8396       ,input  'actn_overvalue_properties':U
     8397       ,input  'object':U
     8398       ,input  buf_alt-calc_price-doc86.host-code
     8399       ,input  buf_alt-calc_price-doc86.obj-type
     8400       ,input  buf_alt-calc_price-doc86.obj-code
     8401       ,input  0
     8402       ,input  0
     8403       ,input  0
     8404       ,input  false
     8405       ,output v-ok
     8406       )  .
     8407   end.
     8408     if v-ok then do:
     8409   for each  buf-price-list where
     8410             buf-price-list.doc-num    = old-num and
     8411             buf-price-list.artic      = buf-goods.artic and
     8412             buf-price-list.prod-type  = buf-goods.prod-type and
     8413             buf-price-list.prod-code  = buf-goods.prod-code and
     8414             buf-price-list.main-price = no,
     8415       first buf-bar-code no-lock where
     8416             buf-bar-code.b-code   = buf-price-list.b-code and
     8417             buf-bar-code.in-code = "" and
     8418             buf-bar-code.unit-cli = buf-goods.unit-base:
     8419     run cre-pr-list (input  buf-bar-code.b-code,
     8420                      input  new-num,
     8421                      output new-rec) no-error.
     8422     if error-status:error then do:
     8423       message
     8424         "Ошибка cre-pr-list." skip
     8425         "Код:" buf-bar-code.b-code
     8426         view-as alert-box.
     8427       next.
     8428     end.
     8429   end.
     8430   end.
     8431     end.
     8432     end.
     8433   end procedure.
     8434   procedure ver-par-disc-mar :
     8435    do
     8436    on error undo, return error return-value
     8437    :
     8438   define input parameter   p-obj-type    like ub.clients.obj-type no-undo .
     8439   define input parameter   p-obj-code    like ub.clients.obj-type no-undo .
     8440   define input parameter   p-node-code   like ub.goods.grp-code no-undo .
     8441   define output parameter  par-disc-mar  as logical no-undo .
     8442   define variable p-host-code as integer no-undo .
     8443   define variable p-prc-min as decimal no-undo .
     8444   define variable p-prc-max as decimal no-undo .
     8445   define variable p-increase-pc as decimal no-undo .
     8446   define variable p-round-method as character no-undo .
     8447   define variable p-base          as decimal no-undo .
     8448   define variable p-value-margin  as integer  no-undo.
     8449   define variable p-type-margin   as logical no-undo .
     8450   define variable p-value-increase  as integer  no-undo.
     8451   define variable p-type-increase  as logical no-undo .
     8452   define variable p-value-rmethod  as integer  no-undo.
     8453   define variable p-type-rmethod  as logical no-undo .
     8454    par-disc-mar = false .
     8455   define variable vss-include-info88 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8456   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     8457     (input  p-obj-type
     8458     ,input  p-obj-code
     8459     ,output p-host-code
     8460     )  .
     8461   if trim(par-pr-discm) = "" then return .
     8462   run grp-obj-margin-value
     8463   ( input   p-node-code    ,
     8464     input   p-obj-type     ,
     8465     input   p-obj-code     ,
     8466     output  p-prc-min      ,
     8467     output  p-prc-max      ,
     8468     output  p-increase-pc  ,
     8469     output  p-round-method ,
     8470     output  p-base         ,
     8471     output  p-value-margin ,
     8472     output  p-type-margin  ,
     8473     output  p-value-increase,
     8474     output  p-type-increase ,
     8475     output  p-value-rmethod ,
     8476     output  p-type-rmethod
     8477     ) .
     8478   if p-type-margin = false  then return.
     8479   par-disc-mar = true  .
     8480    end.
     8481   end procedure.
