     5923                       buf-price-list.price-sale  =  if var-pr-r-b = "rubl" then v-price-rubl           else v-price-base
     5924                       buf-price-list.road-tax    = cur-rt
     5925                       tt-price-sale   =  if var-pr-r-b = "rubl" then v-price-rubl            else v-price-base
     5926                     .
     5927                 end.
     5928             End.
     5929       end.
     5930       when 'НсП':U then do:
     5931         run str/gdsnovat.p ( 'НсП':U,
     5932             buf-price-list.obj-type,
     5933             buf-price-list.obj-code,
     5934             buf-price-doc.host-code,
     5935             buf-price-list.artic,
