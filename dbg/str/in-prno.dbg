     7830   define variable vss-include-info78 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7831   ASSIGN
     7832      i-gl-Host-Code      = 0
     7833      i-gl-Contract-Code  = 0
     7834      i-gl-Extent3        = 0
     7835      .
     7836   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     7837       INPUT  v-cntxt-host-code-obj,
     7838       INPUT  buf_contract.contract-code,
     7839       OUTPUT i-gl-Extent3
     7840      ).
     7841   IF i-gl-Extent3[1] = 2 THEN DO:
     7842      ASSIGN
     7843         i-gl-Host-Code      = i-gl-Extent3[2]
     7844         i-gl-Contract-Code  = i-gl-Extent3[3]
     7845         .
     7846   END. ELSE DO:
     7847      ASSIGN
     7848         i-gl-Host-Code      = v-cntxt-host-code-obj
     7849         i-gl-Contract-Code  = buf_contract.contract-code
     7850         .
     7851   END.
     7852   FOR EACH
     7853       buf_contract-specif
