     4062   procedure grp-obj-notcorr-value :
     4063   do
     4064   on error undo, return error
     4065   :
     4066   define input parameter p-node-code             as integer      no-undo.
     4067   define input parameter p-obj-type              as character    no-undo.
     4068   define input parameter p-obj-code              as integer      no-undo.
     4069   define output parameter p-notcorr              as character    no-undo init ?.
     4070   define output parameter p-range-notcorr     as integer      no-undo.
     4071   define output parameter p-exists-notcorr    as logical      no-undo.
     4072   define variable v-host-code as integer      no-undo.
     4073   DEFINE VARIABLE v-found as logical no-undo .
     4074   DEFINE VARIABLE v-exists as logical no-undo .
     4075   DEFINE VARIABLE v-range as integer no-undo .
     4076   DEFINE VARIABLE jj as integer no-undo .
     4077   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     4078   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     4079   define buffer buf_gds-grp for ub.gds-grp.
     4080   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     4081   find first buf_gds-grp no-lock where
     4082              buf_gds-grp.node-code = p-node-code no-error .
     4083   if not avail buf_gds-grp and p-node-code <> 0 then do:
     4084     message
     4085       vss-workfile vss-revision vss-description
     4086       skip "Не удалось найти группу товаров с кодом" p-node-code
     4087       view-as alert-box error .
     4088     undo, return error .
     4089   end.
     4090   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4091   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4092     (input  p-obj-type
     4093     ,input  p-obj-code
     4094     ,output v-host-code
     4095     ) no-error .
     4096   if error-status :error
     4097   then do:
     4098       message
     4099         vss-workfile vss-revision vss-description
     4100         skip "Не удалось найти фирму объекта"
     4101         skip p-obj-type p-obj-code
     4102         skip return-value
     4103         skip trim(error-status :get-message(1))
     4104       view-as alert-box error.
     4105       undo, return error .
     4106   end.
     4107   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     4108   do while v-found = no and jj < 2:
     4109     if v-range <> 3 then do:
     4110       find first buf_gds-grp-obj no-lock
     4111           where buf_gds-grp-obj.node-code = p-node-code
     4112             and buf_gds-grp-obj.host-code = v-host-code
     4113             and buf_gds-grp-obj.obj-type  = p-obj-type
     4114             and buf_gds-grp-obj.obj-code  = p-obj-code
     4115       no-error .
     4116     end.
     4117     if v-range = 3 or not available buf_gds-grp-obj
     4118     then do:
     4119        if v-range <> 2 then do:
     4120           find first buf_gds-grp-obj no-lock
     4121               where buf_gds-grp-obj.node-code = p-node-code
     4122                 and buf_gds-grp-obj.host-code = v-host-code
     4123                 and buf_gds-grp-obj.obj-type  = ""
     4124                 and buf_gds-grp-obj.obj-code  = 0
     4125           no-error .
     4126         end.
     4127         if v-range = 2 or not available buf_gds-grp-obj
     4128         then do:
     4129             if v-range <> 1 then do:
     4130               find first buf_gds-grp-obj no-lock
     4131                   where buf_gds-grp-obj.node-code = p-node-code
     4132                   and buf_gds-grp-obj.host-code = 0
     4133                   and buf_gds-grp-obj.obj-type  = ""
     4134                   and buf_gds-grp-obj.obj-code  = 0
     4135               no-error .
     4136             end.
     4137             if v-range = 1 or not available buf_gds-grp-obj
     4138             then do:
     4139                 assign
     4140                     v-exists = no
     4141                 .
     4142             end.
     4143             else do:
     4144                 assign
     4145                     v-exists = yes
     4146                     v-range = 1
     4147                 .
     4148             end.
     4149         end.
     4150         else do:
     4151             assign
     4152                 v-exists = yes
     4153                 v-range  = 2
     4154             .
     4155         end.
     4156     end.
     4157     else do:
     4158         assign
     4159             v-exists = yes
     4160             v-range  = 3
     4161         .
     4162     end.
     4163     if available buf_gds-grp-obj
     4164     then do:
     4165       find first buf_gds-grp-obj-attr no-lock
     4166         where buf_gds-grp-obj-attr.node-code   = p-node-code
     4167           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     4168           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     4169           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     4170           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     4171         no-error .
     4172       if available buf_gds-grp-obj-attr then do:
     4173         assign
     4174           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     4175         .
     4176       end.
     4177       else do:
     4178         assign
     4179           v-notcorr-value = ?
     4180         .
     4181       end.
     4182       assign
     4183       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     4184                           then yes
     4185                           else p-exists-notcorr)
     4186       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     4187                         then v-range
     4188                         else p-range-notcorr
     4189       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     4190                         then v-notcorr-value
     4191                         else p-notcorr
     4192       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     4193       jj = jj + 1
     4194       .
     4195     end.
     4196     else do:
     4197       assign
     4198       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     4199       jj = jj + 1
     4200       .
     4201     end.
     4202   end.
     4203   end.
     4204   end procedure.
     4205   define variable vss-include-info43 as character format "X(65)" no-undo
     4206   initial "@(#)$Workfile$ $Revision$".
     4207   procedure grplib-get-full-name :
     4208      define input parameter p-node-code  as integer      no-undo.
     4209      define output parameter p-full-name as character    no-undo.
     4210      do
     4211   on error undo, return error
     4212   :
     4213       define variable v-upper-code    as integer           no-undo.
     4214       define buffer buf_gds-grp       for ub.gds-grp.
     4215       define buffer buf_upper_gds-grp for ub.gds-grp.
     4216       find first buf_gds-grp no-lock
     4217            where buf_gds-grp.node-code = p-node-code
     4218       no-error.
     4219       if not available buf_gds-grp
     4220       then do:
     4221           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     4222       end.
     4223       assign
     4224           p-full-name  = ""
     4225           v-upper-code = 1
     4226       .
     4227       do while buf_gds-grp.upper-code <> 0
     4228       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     4229       :
     4230           assign
     4231               p-full-name  = buf_gds-grp.node-name
     4232                            + (if p-full-name <> "" then chr(47) else "")
     4233                            + p-full-name
     4234               v-upper-code = buf_gds-grp.upper-code
     4235           .
     4236           find first buf_gds-grp no-lock
     4237                where buf_gds-grp.node-code = v-upper-code
     4238           no-error.
     4239           if not available buf_gds-grp
     4240           then do:
     4241               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     4242                                   + string( v-upper-code )
     4243                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     4244           end.
     4245       end.
     4246       assign
     4247       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     4248       .
     4249   end.
     4250   end .
     4251   procedure grplib-get-node-from-full-name :
     4252   define input parameter p-full-name as character no-undo .
     4253   define output parameter p-node-code as integer no-undo .
     4254   define variable v-ii as integer no-undo .
     4255   define variable v-upper-code as integer no-undo .
     4256   define variable v-root-code as integer no-undo .
     4257   define variable v-entry as character no-undo .
     4258   define buffer buf_gds-grp       for ub.gds-grp.
     4259   do
     4260   on error undo, return error
     4261   :
     4262     find first buf_gds-grp no-lock
     4263         where buf_gds-grp.upper-code = 0
     4264     no-error .
     4265     if not available buf_gds-grp
     4266     then do:
     4267         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     4268     end.
     4269     else do:
     4270       assign
     4271       v-root-code = buf_gds-grp.node-code
     4272       .
     4273     end.
     4274     v-upper-code = v-root-code.
     4275     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     4276       assign
     4277       v-entry = entry(v-ii, p-full-name, chr(47)).
     4278       if v-entry = '' then leave.
     4279       find first buf_gds-grp no-lock where
     4280                 buf_gds-grp.node-name = v-entry
     4281             and buf_gds-grp.upper-code = v-upper-code
     4282             no-error.
     4283       if not available buf_gds-grp then do:
     4284         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     4285       end.
     4286       else do:
     4287         p-node-code = buf_gds-grp.node-code.
     4288         v-upper-code = buf_gds-grp.node-code.
     4289       end.
     4290     end.
     4291   end.
     4292   end .
     4293   procedure  chec-par :
     4294   define output parameter l-par as logical no-undo .
