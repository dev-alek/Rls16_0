     6407       INPUT  v-cntxt-host-code-obj,
     6408       INPUT  buf_contract.contract-code,
     6409       OUTPUT i-gl-Extent3
     6410      ).
     6411   IF i-gl-Extent3[1] = 2 THEN DO:
     6412      ASSIGN
     6413         i-gl-Host-Code      = i-gl-Extent3[2]
     6414         i-gl-Contract-Code  = i-gl-Extent3[3]
     6415         .
     6416   END. ELSE DO:
     6417      ASSIGN
     6418         i-gl-Host-Code      = v-cntxt-host-code-obj
     6419         i-gl-Contract-Code  = buf_contract.contract-code
     6420         .
     6421   END.
     6422   FOR EACH
     6423       buf_contract-specif
     6424        NO-LOCK
     6425        WHERE
     6426            buf_contract-specif.Host-code    = i-gl-Host-Code
     6427        AND buf_contract-specif.Contract-num = i-gl-Contract-Code
     6428               :
     6429                 if buf_contract-specif.gds-code     = buf-goods.gds-code then do:
     6430                   run read-bonus (
     6431                       input  buf_contract-specif.contract-num  ,
     6432                       input  buf_contract-specif.host-code     ,
     6433                       input  buf_contract-specif.gds-code      ,
     6434                       output v-bonus  ) .
     6435                   if v-bonus <> ? and v-bonus <> 0 then do:
     6436                     assign
     6437                       buf-price-list.calc-method = 'Спецификация':U
     6438                       buf-price-list.price-calc  = buf_contract-specif.price-cli + ( buf_contract-specif.price-cli * v-bonus / 100 )
     6439                       buf-price-list.price-sale = (buf_contract-specif.price-cli + ( buf_contract-specif.price-cli * v-bonus / 100 )) * (1 + loc-grp-increase-pc / 100)
     6440                       tt-price-sale  = (buf_contract-specif.price-cli + ( buf_contract-specif.price-cli * v-bonus / 100 )) * (1 + loc-grp-increase-pc / 100)
     6441                     .
     6442                   end.
     6443                   else do:
     6444                     assign
     6445                       buf-price-list.calc-method = 'Спецификация':U
     6446                       buf-price-list.price-calc  = buf_contract-specif.price-cli
     6447                       buf-price-list.price-sale  = buf_contract-specif.price-cli * (1 + loc-grp-increase-pc / 100)
     6448                       tt-price-sale   = buf_contract-specif.price-cli * (1 + loc-grp-increase-pc / 100)
     6449                     .
     6450                   end.
     6451                 end.
     6452               end.
     6453             end.
     6454             else do:
     6455               message "Не найден договор с кодом :"
     6456                       ub.trn-doc.contract-code
     6457                       "- расчет невозможен."
     6458                       view-as alert-box question buttons OK-Cancel update g#log.
     6459             end.
     6460           end.
     6461           else do:
     6462             find first buf_contract no-lock
