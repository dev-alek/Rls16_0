     6486         i-gl-Contract-Code  = i-gl-Extent3[3]
     6487         .
     6488   END. ELSE DO:
     6489      ASSIGN
     6490         i-gl-Host-Code      = v-cntxt-host-code-obj
     6491         i-gl-Contract-Code  = buf_contract.contract-code
     6492         .
     6493   END.
