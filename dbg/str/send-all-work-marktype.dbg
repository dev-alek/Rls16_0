      611   procedure putc :
      612      define input parameter iSAXWriter as handle no-undo .
      613      define input parameter i-action   as character  no-undo .
      614      define input parameter p-value    as character  no-undo .
      615      define output parameter oSend      as logical    no-undo.
      616      define variable vTypesForKass as character no-undo.
      617      define variable vTimeDate as character no-undo.
      618      define variable vCount        as integer   no-undo.
      619      define buffer buf_code for ub.code.
      620      for each buf_code where
      621               buf_code.parent = "MarkType"
      622           and logical(buf_code.misc2)
      623          no-lock by int(buf_code.code):
      624         vTypesForKass = substitute("&1,&2", vTypesForKass, int(buf_code.code)).
      625      end.
      626      if vTypesForKass <> "" then
      627      do:
      628         vTypesForKass = substring(vTypesForKass,2).
      629         iSAXWriter:start-element("Param") .
      630           iSAXWriter:insert-attribute("ctrl", "ADD").
      631           iSAXWriter:insert-attribute("group", "GS1").
      632           iSAXWriter:insert-attribute("key", "MACC_Types").
      633           iSAXWriter:write-data-element("ParamValue" , vTypesForKass ) .
      634           iSAXWriter:write-data-element("ParamDesc" , "Типы маркированной продукции для проверка по БД").
      635         iSAXWriter:end-element("Param" ).
      636         iSAXWriter:start-element("Param") .
      637           iSAXWriter:insert-attribute("ctrl", "ADD").
      638           iSAXWriter:insert-attribute("group", "GS1").
      639           iSAXWriter:insert-attribute("key", "MARK_REQ_TYPES").
      640           iSAXWriter:write-data-element("ParamValue" , vTypesForKass ) .
      641           iSAXWriter:write-data-element("ParamDesc" , "Типы, подлежашие обязательной маркировке").
      642         iSAXWriter:end-element("Param" ).
      643         do vCount = 1 to num-entries(vTypesForKass):
      644            find first buf_code where
      645                       buf_code.parent = "MarkType"
      646                   and int(buf_code.code)   = int(entry(vCount, vTypesForKass))
      647                 no-lock no-error.
      648            vTimeDate = substitute("&1 &2",
      649              string(int(buf_code.misc4),"HH:MM"),
      650              string(date(buf_code.misc3),"99.99.9999")).
      651            iSAXWriter:start-element("Param") .
      652               iSAXWriter:insert-attribute("ctrl", "ADD").
      653               iSAXWriter:insert-attribute("group", "GS1").
      654               iSAXWriter:insert-attribute("key", substitute("MARK_REQ_DATE_&1", int(buf_code.code))).
      655               iSAXWriter:write-data-element("ParamValue" , vTimeDate) .
      656               iSAXWriter:write-data-element("ParamDesc" , "Время и Дата начала обязательной маркировки").
      657            iSAXWriter:end-element("Param" ).
      658         end.
      659      end.
      660      oSend = true.
      661   end procedure.
      662   procedure get-root-teg:
      663      define output parameter otypes as character no-undo init "config".
      664   end.
      665   procedure get-xml-encoding:
      666      define output parameter oEncoding as character no-undo init "UTF-8".
      667   end.
      668   procedure get-tag-from:
      669      define output parameter oValue as character no-undo init "empty".
      670   end.
      671   procedure get-tag-to:
      672      define output parameter oValue as character no-undo init "*".
      673   end.
      674   procedure Warning:
      675     define input parameter ErrMessage as character no-undo.
      676     message "The following WARNING was generated:~n" + ErrMessage
      677          view-as alert-box info buttons ok.
      678   end procedure.
      679   procedure Error:
      680     define input parameter ErrMessage as character no-undo.
      681     message "The following NONFATAL ERROR was generated:~n" + ErrMessage
      682          view-as alert-box info buttons ok.
      683   end procedure.
      684   procedure FatalError:
      685     define input parameter ErrMessage as character no-undo.
      686     return error "The following FATAL ERROR was generated:~n" + ErrMessage.
      687   end procedure.
