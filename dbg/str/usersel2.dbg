        1   block-level on error undo, throw.
        2   define input parameter parparentproc            as handle           no-undo.
        3   define input parameter p-old-user-id            as character        no-undo.
        4   define input parameter p-mode                   as integer          no-undo.
        5   define output parameter p-new-user-id           as character        no-undo.
        6   define output parameter p-new-parent-user-id    as character        no-undo.
        7   define output parameter p-accepted              as logical          no-undo.
        8   define variable vss-revision    as character no-undo init "$Revision: 79a9852ece24, 1698, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: druban $":U .
       10   define variable vss-date        as character no-undo init "$Date: Tue Dec 11 11:54:14 2018 +0300 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: usersel2.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: str/usersel2.p $":U .
       13   define variable vss-description as character no-undo init "Диалог выбора пользователя".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define variable vss-include-info0 as character format "X(65)" no-undo
       75   initial "@(#)$Workfile$ $Revision$".
       76   define temp-table temp_onewin_items no-undo
       77       field itm-key       as integer
       78       field itmExtKey     as character
       79       field itmName       as character
       80       field itmDesc       as character
       81       field itmSelected   as logical
       82       index pi is primary unique
       83           itm-key
       84       index ie
       85           itmExtKey
       86   .
       87   define temp-table temp_onewin_itemsSelected no-undo
       88       field its-key   as integer
       89       field itm-key   as integer
       90       field itmExtKey as character
       91       index pi is primary unique
       92           its-key
       93       index im
       94           itm-key
       95   .
       96   define variable v-onewin0-itm-key    as integer      no-undo.
       97   procedure onewin_clear :
       98       define buffer buf_temp_onewin_items        for temp_onewin_items.
       99   do
      100   for buf_temp_onewin_items
      101   on error undo, return error
      102   :
      103       empty temp-table buf_temp_onewin_items.
      104   end.
      105   end procedure.
      106   procedure onewin_add-item :
      107   define input parameter p-ext-key   as character        no-undo.
      108   define input parameter p-item-name as character        no-undo.
      109   define input parameter p-item-desc as character        no-undo.
      110   define input parameter p-selected  as logical          no-undo.
      111       define buffer buf_temp_onewin_items        for temp_onewin_items.
      112   do
      113   for buf_temp_onewin_items
      114   on error undo, return error
      115   :
      116       find last buf_temp_onewin_items no-error.
      117       if available buf_temp_onewin_items then do:
      118         v-onewin0-itm-key = buf_temp_onewin_items.itm-key.
      119       end.
      120       else do:
      121         v-onewin0-itm-key = 0.
      122       end.
      123       assign
      124           v-onewin0-itm-key = v-onewin0-itm-key + 1
      125       .
      126       create buf_temp_onewin_items.
      127       assign
      128       buf_temp_onewin_items.itm-key      = v-onewin0-itm-key
      129       buf_temp_onewin_items.itmExtKey    = p-ext-key
      130       buf_temp_onewin_items.itmName      = p-item-name
      131       buf_temp_onewin_items.itmDesc      = p-item-desc
      132       buf_temp_onewin_items.itmSelected  = p-selected
      133       .
      134   end.
      135   end procedure.
      136   procedure onewin_create-selection :
      137   define input parameter p-itm-key as integer no-undo .
      138   define input parameter p-itmextkey as character no-undo .
      139   define variable v-counter as integer no-undo .
      140   define buffer buf_temp_onewin_itemsSelected for temp_onewin_itemsSelected .
      141   do
      142   on error undo, return error
      143   :
      144     find last buf_temp_onewin_itemsSelected use-index pi no-error.
      145     if available buf_temp_onewin_itemsSelected then do:
      146       v-counter = buf_temp_onewin_itemsSelected.its-key.
      147     end.
      148     find first buf_temp_onewin_itemsSelected where
      149          buf_temp_onewin_itemsSelected.itm-key = p-itm-key no-error.
      150     if not available buf_temp_onewin_itemsSelected then do:
      151       create buf_temp_onewin_itemsSelected.
      152       assign
      153       buf_temp_onewin_itemsSelected.its-key   = v-counter + 1
      154       v-counter = v-counter + 1
      155       buf_temp_onewin_itemsSelected.itm-key   = p-itm-key
      156       buf_temp_onewin_itemsSelected.itmExtKey = p-itmExtKey
      157       .
      158     end.
      159   end.
      160   end procedure.
      161   procedure onewin_check-item :
      162   define input parameter p-ext-key   as character        no-undo.
      163   define output parameter p-exists as logical no-undo .
      164   define buffer buf_temp_onewin_items for temp_onewin_items.
      165   find first buf_temp_onewin_items where
      166   buf_temp_onewin_items.itmExtKey    = p-ext-key no-error.
      167   if available buf_temp_onewin_items then do:
      168     p-exists = yes.
      169   end.
      170   end procedure.
      171       define variable v-cur-ext-key   as character    no-undo.
      172       define variable v-login-string  as character    no-undo.
      173       define variable v-cntxt-userid as character no-undo .
      174       define variable v-cntxt-db-num as integer no-undo .
      175       define variable vI             as integer no-undo .
      176       define buffer buf_user-account      for user-account.
      177       define buffer buf_user-login        for user-login.
      178   do
      179   for buf_user-account
      180     , buf_user-login
      181   on error undo, return error
      182   :
      183       run get-userid in parparentproc ( output v-cntxt-userid).
      184       run get-db-num in parparentproc ( output v-cntxt-db-num).
      185       assign
      186           p-new-user-id = p-old-user-id
      187       .
      188       run onewin_clear in this-procedure.
      189       empty temp-table temp_onewin_itemsSelected.
      190       for each buf_user-account no-lock
      191       on error undo, return error
      192       :
      193           assign
      194               v-login-string = "":U
      195           .
      196           for each buf_user-login no-lock
      197              where buf_user-login.user-id = buf_user-account.user-id
      198                and buf_user-login.db-num = 0
      199           :
      200               assign
      201                   v-login-string = substitute( "&1&2БД &3: &4"
      202                                               , v-login-string
      203                                               , ( if v-login-string = "":U then "":U else ", ":U )
      204                                               , buf_user-login.db-num
      205                                               , buf_user-login.user-login
      206                                               )
      207               .
      208           end.
      209           if v-login-string ne "":U
      210           then
      211           run onewin_add-item in this-procedure (
      212                 input buf_user-account.user-id
      213               , input buf_user-account.nik
      214               , input substitute( "Фамилия, Имя, Отчество:   &2&1Уникальный идентификатор: &4&1Логины:             &5"
      215                                   , chr(10)
      216                                   , trim( substitute( "&1 &2 &3", buf_user-account.last-name, buf_user-account.first-name, buf_user-account.second-name ) )
      217                                   , v-cntxt-db-num
      218                                   , buf_user-account.user-id
      219                                   , v-login-string
      220                                   )
      221               , input ( buf_user-account.user-id = v-cntxt-userid )
      222           ).
      223       end.
      224       run gbl/onewin.w (
      225             input parparentproc
      226           , input p-mode
      227           , input "Список псевдонимов пользователей"
      228           , input "":U
      229           , input "":U
      230           , input table temp_onewin_items
      231           , output table temp_onewin_itemsSelected
      232           , output v-cur-ext-key
      233           , output p-accepted
      234       ).
      235       if p-accepted = yes
      236       then do:
      237            if p-mode = 1 then
      238            do:
      239               for each temp_onewin_itemsSelected:
      240                  p-new-user-id = substitute("&1,&2",
      241                                             p-new-user-id,
      242                                             temp_onewin_itemsSelected.itmExtKey).
      243               end.
      244               p-new-user-id = trim(p-new-user-id,",").
      245            end.
      246            else
      247            do:
      248               p-new-user-id = v-cur-ext-key.
      249               find first buf_user-account no-lock
      250                    where buf_user-account.user-id = p-new-user-id
      251               no-error.
      252               if available buf_user-account then
      253                  p-new-parent-user-id = buf_user-account.parent-user-id.
      254            end.
      255       end.
      256       else do:
      257           assign
      258               p-new-user-id           = "":U
      259               p-new-parent-user-id    = "":U
      260           .
      261       end.
      262   end.
