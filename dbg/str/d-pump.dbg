        1   define input  parameter parparentproc as   handle              no-undo .
        2   define input  parameter parobj-type   like ub.clients.obj-type no-undo.
        3   define input  parameter parobj-code   like ub.clients.obj-code no-undo.
        4   define output parameter parrec-id     as   recid initial ?     no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Диалог на добавление пистолета ТРК".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   procedure proc-alt-shift-f2:
       81     if not ibs.th.gbl.gbl-var:rcode
       82   then
       83     run gbl\inidebug.p .
       84   end.
       85   procedure proc-alt-shift-f3:
       86     run gbl/prvssinf.p
       87       ( input this-procedure
       88       ) .
       89   end.
       90   define variable v-inform-launched as logical no-undo initial false .
       91   procedure proc-alt-shift-f4:
       92     define variable v-action as character no-undo .
       93     if v-inform-launched = false then do:
       94       assign
       95         v-inform-launched = true
       96       .
       97       run gbl/d-inform.w
       98         (  input self
       99         ,  input this-procedure
      100         , output v-action
      101         ) no-error .
      102       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      103       assign
      104         v-inform-launched = false
      105       .
      106     end.
      107   end.
      108   procedure proc-alt-f1:
      109     run gbl/corrhelp.p
      110       (input this-procedure
      111       ) .
      112   end .
      113   on alt-shift-f2 anywhere do:
      114     run proc-alt-shift-f2.
      115   end.
      116   on alt-shift-f3 anywhere do:
      117     run proc-alt-shift-f3 in this-procedure .
      118   end.
      119   on alt-shift-f4 anywhere do:
      120     run proc-alt-shift-f4 in this-procedure.
      121   end.
      122   on alt-f1 anywhere do:
      123     run proc-alt-f1 in this-procedure .
      124   end.
      125   define variable varmes-log as logical no-undo.
      126   define variable varobj-type like ub.clients.obj-type no-undo.
      127   define variable varobj-code like ub.clients.obj-code no-undo.
      128   define variable varbuttons  as   character        no-undo.
      129   define variable varps-upd   as   logical          no-undo.
      130   procedure pumpav:
      131     define input parameter parobj-type  like ub.clients.obj-type   no-undo.
      132     define input parameter parobj-code  like ub.clients.obj-code   no-undo.
      133     define input parameter parpump-code like ub.pump.pump-code no-undo.
      134     define buffer bf_clients for ub.clients.
      135     define buffer bf_pump    for ub.pump.
      136   find first bf_clients where bf_clients.obj-type = parobj-type and
      137                               bf_clients.obj-code = parobj-code no-lock no-error.
      138   if not available bf_clients then
      139      return error SUBSTITUTE("Нет такого объекта &1 &2 .", parobj-type, parobj-code).
      140     find first bf_pump no-lock
      141       where bf_pump.obj-type  = parobj-type
      142         and bf_pump.obj-code  = parobj-code
      143         and bf_pump.pump-code = parpump-code
      144       no-error.
      145     if available bf_pump then do:
      146       return error SUBSTITUTE("Уже есть ТРК с номером &1", parpump-code) + SUBSTITUTE(" на объекте &1 &2 .", parobj-type, parobj-code).
      147     end.
      148     create bf_pump.
      149     assign
      150       bf_pump.obj-type  = parobj-type
      151       bf_pump.obj-code  = parobj-code
      152       bf_pump.pump-code = parpump-code
      153     .
      154   end procedure.
      155   DEFINE BUTTON b-cancel AUTO-END-KEY
      156        LABEL "&Отмена"
      157        SIZE 10 BY 1
      158        BGCOLOR 8 .
      159   DEFINE BUTTON b-help
      160        LABEL "Помо&щь"
      161        SIZE 10 BY 1
      162        BGCOLOR 8 .
      163   DEFINE BUTTON b-save AUTO-GO
      164        LABEL "&Ввод"
      165        SIZE 10 BY 1
      166        BGCOLOR 8 .
      167   DEFINE VARIABLE varpump-code AS INTEGER FORMAT ">9":U INITIAL 0
      168        LABEL "Номер ТРК"
      169        VIEW-AS FILL-IN
      170        SIZE 3 BY 1 NO-UNDO.
      171   DEFINE FRAME Dialog-Frame
      172        b-save AT ROW 1 COL 1
      173        b-cancel AT ROW 1 COL 11
      174        b-help AT ROW 1 COL 21
      175        varpump-code AT ROW 2.75 COL 10.88 COLON-ALIGNED
      176        SPACE(17.24) SKIP(0.32)
      177       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      178            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      179            TITLE "Добавление  ТРК"
      180            DEFAULT-BUTTON b-save CANCEL-BUTTON b-cancel.
      181   ASSIGN
      182          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      183          FRAME Dialog-Frame:HIDDEN           = TRUE.
      184   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      185   DO:
      186     APPLY "END-ERROR":U TO SELF.
      187   END.
      188   ON CHOOSE OF b-save IN FRAME Dialog-Frame
      189   DO:
      190   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      191   if lookup(self :type
      192            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      193            ) = 0
      194   then do:
      195     message
      196       "$Workfile$"
      197       "Указанному интерфейсному элементу фокус не может быть передан" skip
      198       "Интерфейсный элемент" self :name  skip
      199       "Тип" self :type  skip
      200       "Процедура" this-procedure :file-name skip
      201       view-as alert-box .
      202   end.
      203   else do:
      204     apply "entry":u to self  .
      205     if focus :handle <> self :handle  then do:
      206       return no-apply .
      207     end.
      208   end.
      209     define buffer buf_pump for ub.pump .
      210     assign
      211       frame Dialog-Frame varpump-code
      212     .
      213     run pumpav in this-procedure
      214       ( input parobj-type
      215        ,input parobj-code
      216        ,input varpump-code
      217       ) no-error.
      218     if error-status:error then do:
      219   message
      220     vss-workfile vss-revision vss-description skip
      221     "Ошибка при создании ТРК" skip
      222     "-----------Cистемная ошибка------------" skip
      223     return-value skip
      224     "------Ошибка исполнения программы------" skip
      225     trim(error-status :get-message(1)) +
      226     trim(error-status :get-message(2)) +
      227     trim(error-status :get-message(3)) +
      228     trim(error-status :get-message(4)) +
      229     trim(error-status :get-message(5)) skip
      230     view-as alert-box error .
      231        return no-apply.
      232     end.
      233     find first buf_pump
      234       where buf_pump.obj-type  = parobj-type
      235         and buf_pump.obj-code  = parobj-code
      236         and buf_pump.pump-code = varpump-code
      237       no-lock.
      238     assign
      239       parrec-id = recid(buf_pump)
      240     .
      241   END.
      242   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      243   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      244   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      245   on help of frame Dialog-Frame
      246   do:
      247     run gbl/app_help.p
      248       (input this-procedure :file-name
      249       ,input ''
      250       ,input ?
      251       ) no-error.
      252     if error-status :error then do:
      253       message
      254         "Ошибка при вызове помощи"
      255         error-status :get-message(1)
      256         view-as alert-box .
      257     end.
      258   end.
      259   run minbtn-set in this-procedure .
      260   on choose of b-help in frame Dialog-Frame
      261   do:
      262     apply "help":u to frame Dialog-Frame .
      263   end.
      264   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      265   procedure minbtn-set :
      266       do
      267           on error undo, return error return-value
      268           :
      269           define variable ii              as integer       no-undo .
      270           define variable fh              as widget-handle no-undo .
      271           define variable hh              as widget-handle no-undo .
      272           define variable v-h             as handle        extent 4 no-undo .
      273           define variable v-name-button   as character     no-undo .
      274           define variable v-help-old-x    as decimal       no-undo .
      275           define variable v-help-old-y    as decimal       no-undo .
      276           define variable v-help-old-size as decimal       no-undo .
      277           define variable v-frame-width   as decimal       no-undo .
      278           define variable jj              as integer       no-undo .
      279           do
      280               on error undo, return error
      281               :
      282               assign
      283                   v-frame-width = frame Dialog-Frame:width - 0.3
      284                   fh            = frame Dialog-Frame:first-child
      285                   hh            = fh:first-child
      286                   ii            = 1
      287                   .
      288               do while valid-handle(hh):
      289                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      290                   do:
      291                       case lc(hh:name) :
      292                           when "b-help" then
      293                               do:
      294                                   hh:load-image-up("cmp/b-help.bmp":u) .
      295                                   hh:load-image-down("cmp/b-help.bmp":u) .
      296                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      297                                   hh:TOOLTIP = "Помощь" .
      298                                   v-help-old-x = hh:column .
      299                                   v-help-old-y = hh:row    .
      300                                   v-help-old-size = hh:width .
      301                                   hh:width-chars = 2.5 .
      302                               end.
      303                           when "b-print" then
      304                               do:
      305                                   hh:load-image("cmp/b-print.bmp":u) .
      306                                   hh:TOOLTIP = "Печать" .
      307                                   v-h[ii] = hh:handle .
      308                                   ii = ii + 1 .
      309                                   hh:width-chars = 3 .
      310                               end.
      311                           when "b-history" or
      312                           when "b-hist" then
      313                               do:
      314                                   hh:load-image("cmp/b-hist.bmp":u) .
      315                                   hh:TOOLTIP = "История" .
      316                                   v-h[ii] = hh:handle .
      317                                   ii = ii + 1 .
      318                                   hh:width-chars = 3 .
      319                               end.
      320                           when "b-sch" then
      321                               do:
      322                                   hh:load-image("cmp/b-sch.bmp":u) .
      323                                   hh:TOOLTIP = "Установка Фильтра" .
      324                                   v-h[ii] = hh:handle .
      325                                   ii = ii + 1 .
      326                                   hh:width-chars = 3 .
      327                               end.
      328                           when "b-hist-user" then
      329                               do:
      330                                   hh:load-image("cmp/b-hist.bmp":u) .
      331                                   hh:TOOLTIP = "История пользователя" .
      332                                   ii = ii + 1 .
      333                               end.
      334                       end case.
      335                   end.
      336                   hh = hh:next-sibling.
      337               end.
      338               b-help:column = v-frame-width - b-help:width-chars.
      339               jj = 0.
      340               repeat ii = 4 to 1 by -1 :
      341                   if valid-handle (v-h[ii] ) then
      342                   do:
      343                       jj  = jj + 1 .
      344                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      345                       v-h[ii]:row    = v-help-old-y .
      346                   end.
      347               end.
      348           end.
      349       end.
      350   end procedure.
      351   MAIN-BLOCK:
      352   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      353      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      354     RUN enable_UI.
      355     WAIT-FOR GO OF FRAME Dialog-Frame.
      356   END.
      357   RUN disable_UI.
      358   PROCEDURE disable_UI :
      359     HIDE FRAME Dialog-Frame.
      360   END PROCEDURE.
      361   PROCEDURE enable_UI :
      362     DISPLAY varpump-code
      363         WITH FRAME Dialog-Frame.
      364     ENABLE b-save b-cancel b-help varpump-code
      365         WITH FRAME Dialog-Frame.
      366     VIEW FRAME Dialog-Frame.
      367   END PROCEDURE.
