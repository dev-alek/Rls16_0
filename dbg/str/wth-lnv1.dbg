      386   procedure wth-lib_full-inf-calend-date:
      387   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input  parameter parfact-date    like ub.wth-line.fact-date    no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                                                                                       cur_wth-line.wth-code   = parwth-code   and                                        cur_wth-line.fact-date  = parfact-date  and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-cld no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                                                                             start_wth-line.wth-code   = parwth-code         and                                start_wth-line.fact-date  < parfact-date   and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-cld no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income - cur_wth-line.incass              parincome        = cur_wth-line.income                     parincome-cassa  = cur_wth-line.income-cassa               parincome-other  = cur_wth-line.income-other               parincass        = cur_wth-line.incass                     parincass-bank   = cur_wth-line.incass-bank                parincass-other  = cur_wth-line.incass-other.              parincass-cassa  = cur_wth-line.incass-cassa.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income     - start_wth-line.incass               parstock-end     = cur_wth-line.income       - cur_wth-line.incass                 parincome        = cur_wth-line.income       - start_wth-line.income               parincome-cassa  = cur_wth-line.income-cassa - start_wth-line.income-cassa         parincome-other  = cur_wth-line.income-other - start_wth-line.income-other         parincass        = cur_wth-line.incass       - start_wth-line.incass               parincass-bank   = cur_wth-line.incass-bank  - start_wth-line.incass-bank          parincass-other  = cur_wth-line.incass-other - start_wth-line.incass-other.        parincass-cassa  = cur_wth-line.incass-cassa - start_wth-line.incass-cassa.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income - start_wth-line.incass                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
      388   end procedure.
      389   procedure wth-lib_full-inf-calend-date-place:
      390   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input parameter parw-p-code  like ub.wth-line.w-p-code  no-undo.                        define input parameter parfact-date like ub.wth-line.fact-date no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                        cur_wth-line.w-p-code   = parw-p-code and                                                               cur_wth-line.wth-code   = parwth-code   and                                        cur_wth-line.fact-date  = parfact-date  and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-cld-pl no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                start_wth-line.w-p-code = parw-p-code and                                                             start_wth-line.wth-code   = parwth-code         and                                start_wth-line.fact-date  < parfact-date   and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-cld-pl no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income-pl - cur_wth-line.incass-pl              parincome        = cur_wth-line.income-pl                     parincome-cassa  = cur_wth-line.income-cassa-pl               parincome-other  = cur_wth-line.income-other-pl               parincass        = cur_wth-line.incass-pl                     parincass-bank   = cur_wth-line.incass-bank-pl                parincass-other  = cur_wth-line.incass-other-pl.              parincass-cassa  = cur_wth-line.incass-cassa-pl.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income-pl     - start_wth-line.incass-pl               parstock-end     = cur_wth-line.income-pl       - cur_wth-line.incass-pl                 parincome        = cur_wth-line.income-pl       - start_wth-line.income-pl               parincome-cassa  = cur_wth-line.income-cassa-pl - start_wth-line.income-cassa-pl         parincome-other  = cur_wth-line.income-other-pl - start_wth-line.income-other-pl         parincass        = cur_wth-line.incass-pl       - start_wth-line.incass-pl               parincass-bank   = cur_wth-line.incass-bank-pl  - start_wth-line.incass-bank-pl          parincass-other  = cur_wth-line.incass-other-pl - start_wth-line.incass-other-pl.        parincass-cassa  = cur_wth-line.incass-cassa-pl - start_wth-line.incass-cassa-pl.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income-pl - start_wth-line.incass-pl                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
      391   end procedure.
      392   FUNCTION get-curr RETURNS CHARACTER
      393     (buffer loc-wealth for ub.wealth ) :
      394   define buffer buf_currency for ub.currency.
      395   if loc-wealth.curr-code = ? or loc-wealth.is-money = no then
      396   return loc-wealth.unit-base.
      397   FIND FIRST buf_currency no-lock where
      398             buf_currency.curr-code = loc-wealth.curr-code No-ERROR.
      399   if avail buf_currency then
      400     RETURN buf_currency.curr-abbr.
      401   else return "".
      402   END FUNCTION.
      403   define variable var-entry         as character no-undo .
      404   define variable loc#log           as logical   no-undo .
      405   define variable vardtl-rec        as recid     no-undo .
      406   define variable varis-dtl         as logical   no-undo .
      407   define variable vardtl-bef-sum    as decimal   no-undo .
      408   define variable vardtl-aft-sum    as decimal   no-undo .
      409   define variable varline-bef-sum   as decimal   no-undo .
      410   define variable varline-aft-sum   as decimal   no-undo .
      411   define variable v-today           as date      no-undo .
      412   define variable v-time            as integer   no-undo .
      413   define variable varbef-sum        as decimal   no-undo .
      414   define variable vdoc-bef-sum      as decimal   no-undo .
      415   define variable v-added           as logical   no-undo .
      416   define variable calc-line-bef-sum as decimal   no-undo .
      417   define buffer buf_wth-doc  for ub.wth-doc .
      418   define buffer buf_wth-line for ub.wth-line .
      419   define buffer inv_wth-doc  for ub.wth-doc.
      420   if not (par-mode = 'ДОБАВЛЕНИЕ':U
      421           or par-mode = 'ИЗМЕНЕНИЕ':U
      422           or par-mode = 'удаление':U
      423          )
      424   then do:
      425     message
      426       vss-workfile vss-revision vss-description skip
      427       "Неверный параметр вызова par-mode" par-mode
      428       view-as alert-box ERROR.
      429     return error '':U.
      430   end.
      431   find first buf_wth-doc exclusive-lock
      432     where buf_wth-doc.doc-code = pardoc-code
      433     no-error
      434     no-wait.
      435   if locked buf_wth-doc
      436   then do:
      437     message vss-workfile vss-revision vss-description skip
      438             "Запись документа МЦ" pardoc-code "занята"
      439             "добавление/изменение строки невозможно"
      440     view-as alert-box error .
      441     return error substitute("Запись документа МЦ &1 занята", pardoc-code ).
      442   end.
      443   if not available buf_wth-doc
      444   then do:
      445     message vss-workfile vss-revision vss-description skip
      446             "Не найден документ МЦ" pardoc-code
      447     view-as alert-box error .
      448     return error substitute("Не найден документ МЦ &1", pardoc-code ).
      449   end.
      450   if buf_wth-doc.status_ = 'факт':U
      451   then do:
      452     message
      453     vss-workfile vss-revision vss-description skip
      454     "Документ МЦ имеет статус" buf_wth-doc.status_
      455     "добавление/изменение строки невозможно"
      456     view-as alert-box ERROR.
      457     return error '':U.
      458   end.
      459   if  buf_wth-doc.status_ = 'разрешен':U
      460   and par-mode = 'ДОБАВЛЕНИЕ':U
      461   then do:
      462     message
      463     vss-workfile vss-revision vss-description skip
      464     "Документ МЦ имеет статус" buf_wth-doc.status_
      465     "добавление строки невозможно"
      466     view-as alert-box ERROR.
      467     return error '':U.
      468   end.
      469   assign
      470   varbef-sum = parbef-sum.
      471   if buf_wth-doc.auto-fill
      472   or parbef-sum = ?
      473   then do:
      474     run wth-lib_cur-stock-place in this-procedure (
      475                                                       input  buf_wth-doc.obj-type
      476                                                     ,input  buf_wth-doc.obj-code
      477                                                     ,input  parw-p-code
      478                                                     ,input parwth-code
      479                                                     ,output calc-line-bef-sum
      480                                                     ) no-error.
      481     if error-status:error
      482     then do:
      483       return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
      484     end.
      485   end.
      486   if par-mode = 'ДОБАВЛЕНИЕ':U
      487   then do:
      488     par-rid = ?.
      489     if  parline-exist = yes
      490     then do:
      491       FIND FIRST ub.wth-line No-LOCK WHERE
      492                 ub.wth-line.doc-code = pardoc-code AND
      493                 ub.wth-line.wth-code = parwth-code AND
      494                 ub.wth-line.w-p-code = parw-p-code No-ERROR.
      495       if available ub.wth-line
      496       then do:
      497         par-rid = recid(ub.wth-line).
      498         assign
      499         v-added = yes
      500         varbef-sum = (if parbef-sum = ?
      501                       then calc-line-bef-sum
      502                       else (varbef-sum + ub.wth-line.bef-sum))
      503         paraft-sum = paraft-sum + ub.wth-line.aft-sum
      504         .
      505       end.
      506       else do:
      507         if parbef-sum = ?
      508         then do:
      509           assign
      510           varbef-sum = calc-line-bef-sum.
      511         end.
      512       end.
      513     end.
      514   end.
      515   run trg/wth-lnv2.p (
      516                   input pardoc-code,
      517                   input buf_wth-doc.host-code,
      518                   input buf_wth-doc.obj-type,
      519                   input buf_wth-doc.obj-code,
      520                   input buf_wth-doc.cli-type,
      521                   input buf_wth-doc.cli-code,
      522                   input buf_wth-doc.auto-fill,
      523                   input buf_wth-doc.borned,
      524                   input par-rid,
      525                   input parwth-code,
      526                   input parw-p-code ) no-error.
      527   if error-status:error then return error return-value.
      528   find first buf_wth-line no-lock
      529     where buf_wth-line.obj-type    = buf_wth-doc.obj-type
      530       and buf_wth-line.obj-code    = buf_wth-doc.obj-code
      531       and buf_wth-line.w-p-code    = parw-p-code
      532       and buf_wth-line.shift-date  = buf_wth-doc.shift-date
      533       and buf_wth-line.shift-num   = buf_wth-doc.shift-num
      534       and buf_wth-line.wth-code    = parwth-code
      535       and buf_wth-line.status_    <> 'факт':U
      536       and recid( buf_wth-line )   <>  par-rid
      537     no-error .
      538   if available buf_wth-line
      539   then do:
      540     find first inv_wth-doc no-lock
      541       where inv_wth-doc.doc-code = buf_wth-line.doc-code
      542       no-error .
      543     if inv_wth-doc.doc-type = 'инв':U
      544     then do:
      545       message
      546         "Материальная ценность" parwth-code "есть в незакрытой инвентаризации"
      547         buf_wth-line.doc-code "по м/х" parw-p-code "!" Skip
      548         "Невозможно добавить в документ!"
      549         view-as alert-box error.
      550         assign
      551           var-entry = "wth-code":u
      552         .
      553         return error var-entry.
      554     end.
      555     else do:
      556       message
      557         "Материальная ценность" parwth-code "есть в незакрытом документе"
      558         buf_wth-line.doc-code "по м/х" parw-p-code "!" Skip
      559         "Невозможно добавить в документ!"
      560         view-as alert-box error.
      561         assign
      562           var-entry = "wth-code":U
      563         .
      564         return error var-entry.
      565     End.
      566   END.
      567   do
      568   on error undo, return '':u
      569   on stop undo, return '':u
      570   :
      571     if par-mode = 'ДОБАВЛЕНИЕ':U and par-rid = ?
      572     then do:
      573       run cur-time in this-procedure(output v-today, output v-time).
      574   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      575   CREATE wth-line.
      576   ASSIGN
      577     wth-line.doc-code     = buf_wth-doc.doc-code
      578     wth-line.w-p-code     = parw-p-code
      579     wth-line.obj-type     = buf_wth-doc.obj-type
      580     wth-line.obj-code     = buf_wth-doc.obj-code
      581     wth-line.shift-date   = buf_wth-doc.shift-date
      582     wth-line.shift-num    = buf_wth-doc.shift-num
      583     wth-line.shift-name   = buf_wth-doc.shift-name
      584     wth-line.creid        = g#userid
      585     wth-line.credate      = v-today
      586   .
      587       assign par-rid = recid(ub.wth-line).
      588     end.
      589     else do:
      590       FIND FIRST ub.wth-line EXCLUSIVE-LOCK WHERE
      591                 recid(ub.wth-line) = par-rid No-WAIT No-ERROR.
      592       if locked ub.wth-line
      593       then do:
      594         message "Строка документа МЦ занят"
      595         view-as alert-box error .
      596         return error '':U.
      597       end.
      598       if not avail ub.wth-line
      599       then do:
      600         message "Не найдена строка документа МЦ"
      601         view-as alert-box error .
      602         return error '':U.
      603       end.
      604       if  buf_wth-doc.status_ = 'разрешен':U
      605       and (ub.wth-line.doc-code <> pardoc-code
      606            or ub.wth-line.wth-code <> parwth-code
      607            or ub.wth-line.w-p-code <> parw-p-code
      608            or ub.wth-line.bef-sum <> parbef-sum
      609           )
      610       then dO:
      611         message
      612         vss-workfile vss-revision vss-description skip
      613         "Документ МЦ имеет статус" buf_wth-doc.status_
      614         "возможно изменить только сумму факт"
      615         view-as alert-box ERROR.
      616         return error '':U.
      617       end.
      618     end.
      619     if buf_wth-doc.auto-fill
      620     or parbef-sum = ?
      621     then do:
      622     end.
      623     else do:
      624       calc-line-bef-sum = if par-mode = 'удаление':U
      625                           then 0
      626                           else varbef-sum.
      627     end.
      628     assign
      629       ub.wth-line.doc-code = pardoc-code
      630       ub.wth-line.wth-code = parwth-code
      631       ub.wth-line.w-p-code = parw-p-code
      632     .
      633     if parbef-sum = ?
      634     then do:
      635       for each buf_wth-line no-lock where
      636               buf_wth-line.doc-code = buf_wth-doc.doc-code:
      637         if recid(buf_wth-line) = recid(ub.wth-line) then next.
      638         assign
      639         vdoc-bef-sum = vdoc-bef-sum + buf_wth-line.bef-sum.
      640       end.
      641       assign
      642       vdoc-bef-sum = vdoc-bef-sum + varbef-sum
      643       buf_wth-doc.bef-sum = vdoc-bef-sum
      644       .
      645     end.
      646     else do:
      647       assign
      648       buf_wth-doc.bef-sum = buf_wth-doc.bef-sum - ub.wth-line.bef-sum + calc-line-bef-sum
      649       .
      650     end.
      651     assign
      652     ub.wth-line.bef-sum = parbef-sum
      653     buf_wth-doc.aft-sum = buf_wth-doc.aft-sum - ub.wth-line.aft-sum + paraft-sum
      654     ub.wth-line.aft-sum = paraft-sum
      655     .
      656     assign
      657     varline-bef-sum = ub.wth-line.bef-sum
      658     varline-aft-sum = ub.wth-line.aft-sum
      659     .
      660     if par-mode = 'ДОБАВЛЕНИЕ':U
      661     then do:
      662       release ub.wth-line no-error.
      663       if error-status:error
      664       then do:
      665         return error '':U.
      666       end.
      667     end.
      668     for each tt-par-dtl:
      669       varis-dtl = yes.
      670       run str/wth-dtl1.p (output vardtl-rec,
      671                     input par-mode,
      672                     input pardoc-code,
      673                     input parwth-code,
      674                     input parw-p-code,
      675                     input tt-par-dtl.par-code,
      676                     input tt-par-dtl.sum-BEF,
      677                     input tt-par-dtl.sum-aft,
      678                     input 0,
      679                     input 0,
      680                     input parline-exist
      681                     ) no-error.
      682       if error-status:error or vardtl-rec = ?
      683       then do:
      684         assign
      685           var-entry = "b-par":U
      686         .
      687         return error var-entry.
      688       end.
      689       assign
      690       vardtl-bef-sum = vardtl-bef-sum + tt-par-dtl.sum-bef
      691       vardtl-aft-sum = vardtl-aft-sum + tt-par-dtl.sum-aft
      692       .
      693     END.
      694     if varis-dtl
      695     then do:
      696       case buf_wth-doc.status_ :
      697         when 'накл':U
      698         then do:
      699           if varline-bef-sum <> vardtl-bef-sum
      700           and NOT (vardtl-bef-sum  = 0 and
      701                    not can-find(first ub.wth-dtl No-LOCK WHERE
      702                                       ub.wth-dtl.doc-code = pardoc-code AND
      703                                       ub.wth-dtl.wth-code = parwth-code AND
      704                                       ub.wth-dtl.w-p-code = parw-p-code)
      705                   )
      706           then do:
      707             message "Сумма по номиналам не совпадает с суммой движения материального средства!"
      708             view-as alert-box error .
      709             var-entry = "wth-dtl":U.
      710             return error var-entry.
      711           end.
      712         end.
      713         when 'разрешен':U
      714         then do:
      715           if varline-aft-sum <> vardtl-aft-sum and
      716             NOT (vardtl-aft-sum  = 0 and
      717                   not can-find(first ub.wth-dtl No-LOCK WHERE
      718                                       ub.wth-dtl.doc-code = pardoc-code AND
      719                                       ub.wth-dtl.wth-code = parwth-code AND
      720                                       ub.wth-dtl.w-p-code = parw-p-code)
      721                   )
      722           then dO:
      723             message "Сумма по номиналам не совпадает с суммой движения материального средства!"
      724             view-as alert-box error .
      725             var-entry = "wth-dtl":U.
      726             return error var-entry.
      727           end.
      728         end.
      729       END CASE.
      730     end.
      731     else do:
      732       if can-find(first ub.wth-dtl No-LOCK WHERE
      733                         ub.wth-dtl.doc-code = pardoc-code AND
      734                         ub.wth-dtl.wth-code = parwth-code AND
      735                         ub.wth-dtl.w-p-code = parw-p-code)
      736       then do:
      737         FOR EACH ub.wth-dtl No-LOCK WHERE
      738                   ub.wth-dtl.doc-code = ub.wth-line.doc-code AND
      739                   ub.wth-dtl.wth-code = ub.wth-line.wth-code AND
      740                   ub.wth-dtl.w-p-code = ub.wth-line.w-p-code:
      741           assign
      742           vardtl-bef-sum = vardtl-bef-sum + ub.wth-dtl.bef-sum
      743           vardtl-aft-sum = vardtl-aft-sum + ub.wth-dtl.aft-sum
      744           .
      745         END.
      746         if varline-bef-sum <> vardtl-bef-sum or
      747            varline-aft-sum <> vardtl-aft-sum
      748         then dO:
      749           message "Сумма по номиналам не совпадает с суммой движения материального средства!"
      750           view-as alert-box error .
      751           var-entry = "wth-dtl":U.
      752           return error var-entry.
      753         end.
      754       end.
      755     end.
      756   END.
      757   return '':U.
