        1   block-level on error undo, throw.
        2   DEFINE TEMP-TABLE tt-par-dtl NO-UNDO LIKE ub.wth-par
        3   FIELD q-ty-bef     AS   DEC FORM     ">,>>>,>>>,>>>":U    COLUMN-LABEL "Кол-во план"
        4   FIELD q-ty-aft     AS   DEC FORM     ">,>>>,>>>,>>>":U    COLUMN-LABEL "Кол-во факт"
        5   FIELD sum-bef  like ub.wth-line.bef-sum FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма план"
        6   FIELD sum-aft  like ub.wth-line.aft-sum FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма факт"
        7   FIELD sum-fact  like ub.wth-line.fact-sum FORM "->,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Расхождение"
        8   INDEX tt-pi    IS   PRIMARY UNIQUE par-code
        9   INDEX tt-i1                        par-feat par-unit par-val
       10   INDEX tt-i2                        sum-bef  q-ty-bef
       11   .
       12   define input-output parameter par-rid as recid no-undo .
       13   define input parameter par-mode    as character no-undo .
       14   define input parameter pardoc-code like ub.wth-line.doc-code no-undo .
       15   define input parameter parwth-code like ub.wth-line.wth-code no-undo .
       16   define input parameter parw-p-code like ub.wth-line.w-p-code no-undo .
       17   define input parameter parbef-sum  like ub.wth-line.BEF-sum no-undo .
       18   define input parameter paraft-sum  like ub.wth-line.AFT-sum no-undo .
       19   define input parameter table for tt-par-dtl.
       20   define input parameter parline-exist as logical no-undo .
       21   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       22   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       23   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       24   define variable vss-workfile    as character no-undo init "$Workfile: wth-lnv1.p $":U .
       25   define variable vss-archive     as character no-undo init "$Archive: str/wth-lnv1.p $":U .
       26   define variable vss-description as character no-undo init "Сохранение изменений в строке документа МЦ инвентаризации".
       27   procedure vss-get-info :
       28     define output parameter p-vss-revision    like vss-revision    no-undo .
       29     define output parameter p-vss-author      like vss-author      no-undo .
       30     define output parameter p-vss-date        like vss-date        no-undo .
       31     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       32     define output parameter p-vss-archive     like vss-archive     no-undo .
       33     define output parameter p-vss-description like vss-description no-undo .
       34     assign
       35       p-vss-revision    = vss-revision
       36       p-vss-author      = vss-author
       37       p-vss-date        = vss-date
       38       p-vss-workfile    = vss-workfile
       39       p-vss-archive     = vss-archive
       40       p-vss-description = vss-description
       41     .
       42   end procedure.
       43   procedure vss-get-parameters :
       44     define output parameter p-vss-parameters as character no-undo .
       45   end procedure.
       46   define new global shared variable g#vssrevis-logger as handle    no-undo .
       47   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       48   define variable v-vssrevis-logger                   as handle    no-undo .
       49   procedure vss-logevent :
       50     define input  parameter p-extra-paramters as character no-undo .
       51     define variable v-vssrevis-parameters as character no-undo .
       52     do
       53     on error undo, return error return-value
       54     :
       55       if  valid-handle(v-vssrevis-logger)
       56       and v-vssrevis-logger :get-signature("logevent") <> ""
       57       then do:
       58         run vss-get-parameters in this-procedure
       59           (output v-vssrevis-parameters
       60           ).
       61         run logevent in v-vssrevis-logger
       62           (input vss-workfile
       63           ,input vss-revision
       64           ,input v-vssrevis-parameters
       65           ,input p-extra-paramters
       66           ).
       67       end.
       68     end.
       69   end procedure.
       70   assign
       71     v-vssrevis-logger = g#vssrevis-logger
       72   .
       73   if  valid-handle(v-vssrevis-logger)
       74   and v-vssrevis-logger :get-signature("logevent") <> ""
       75   then do:
       76     assign
       77       v-vssrevis-logevent = true
       78     .
       79     run vss-logevent in this-procedure (input vss-description) .
       80   end.
       81   define new global shared variable g#language as character no-undo .
       82   if g#language <> '' and g#language <> 'rus':U then do:
       83     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       84   end.
       85   define new global shared variable g#library  as handle no-undo .
       86   define new global shared variable g#library2 as handle no-undo .
       87   define   shared variable g#auto as logical no-undo.
       88   define   shared variable g#news as logical no-undo.
       89   define   shared variable g#oxml as logical no-undo.
       90   define   shared variable g#esys as logical no-undo.
       91   define   shared variable g#news-source-db as integer no-undo.
       92   define   shared variable g#esys-source-esys as integer no-undo.
       93   define   shared variable g#db-num as integer   no-undo .
       94   define   shared variable g#userid as character no-undo .
       95   define   shared variable g#passwd as character no-undo .
       96   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       97   procedure cur-time :
       98      define output parameter p-today as date      no-undo .
       99      define output parameter p-time  as integer   no-undo .
      100     do
      101     on error undo, return error
      102     :
      103       define variable v-date1 as date      no-undo .
      104       define variable v-date2 as date      no-undo .
      105       define variable v-time  as integer   no-undo .
      106       assign
      107         v-date1 = today
      108         v-time  = time
      109         v-date2 = today
      110       .
      111       if v-date1 <> v-date2
      112       then do:
      113         assign
      114           v-date1 = today
      115           v-time  = v-time
      116         .
      117       end.
      118       assign
      119         p-today = v-date1
      120         p-time  = v-time
      121       .
      122     end.
      123   end.
      124   function cur-time-date returns character
      125   :
      126     return string(today, '99/99/9999':U) .
      127   end.
      128   function cur-time-mjd returns decimal
      129   :
      130     define variable v-date as date      no-undo .
      131     define variable v-time as integer   no-undo .
      132     run cur-time in this-procedure
      133       (output v-date
      134       ,output v-time
      135       ) .
      136     return integer(v-date) - 2400002 + (v-time / 86400) .
      137   end.
      138   function cur-time-get-ending-index returns integer
      139   (input p-number as integer
      140   )
      141   :
      142     if p-number < 0
      143     or p-number = ?
      144     then do:
      145       return 1 .
      146     end.
      147     define variable v-rest as integer   no-undo .
      148     assign
      149       p-number = p-number modulo 100
      150     .
      151     if p-number < 20
      152     then do:
      153       assign
      154         v-rest = p-number
      155       .
      156     end.
      157     else do:
      158       assign
      159         v-rest = p-number modulo 10
      160       .
      161     end.
      162     case v-rest :
      163       when 1
      164       then do:
      165         return 2 .
      166       end.
      167       when 2 or
      168       when 3 or
      169       when 4
      170       then do:
      171         return 3 .
      172       end.
      173       otherwise do:
      174         return 1 .
      175       end.
      176     end case .
      177   end.
      178   procedure cur-time-mjd-to-date :
      179      define input  parameter i-mjd-diff as decimal no-undo.
      180      define output parameter o-Date     as date    no-undo.
      181      define output parameter o-Time     as integer no-undo.
      182      define variable v-day-number as integer   no-undo .
      183      if    i-mjd-diff < 0
      184         or i-mjd-diff = ?
      185      then do:
      186         return "?" .
      187      end.
      188      assign
      189         v-day-number = truncate(i-mjd-diff,0).
      190         o-Date = date(v-day-number + 2400002).
      191         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      192     .
      193   end.
      194   function cur-time-mjd-to-string returns character
      195   (input p-mjd-diff as decimal
      196   )
      197   :
      198     define variable v-day-number as integer   no-undo .
      199     define variable v-seconds    as integer   no-undo .
      200     define variable v-hour       as integer   no-undo .
      201     define variable v-min        as integer   no-undo .
      202     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      203     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      204     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      205     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      206     if p-mjd-diff < 0
      207     or p-mjd-diff = ?
      208     then do:
      209       return "?" .
      210     end.
      211     assign
      212       v-day-number = integer(truncate(p-mjd-diff,0))
      213       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      214     .
      215     if v-seconds > 86400
      216     then do:
      217       assign
      218         v-seconds = 86400 - 1
      219       .
      220     end.
      221     if v-seconds < 0
      222     then do:
      223       assign
      224         v-seconds = 0
      225       .
      226     end.
      227     assign
      228       v-hour = truncate(v-seconds / 3600, 0)
      229     .
      230     assign
      231       v-seconds = v-seconds modulo 3600
      232     .
      233     assign
      234       v-min = truncate(v-seconds / 60, 0)
      235     .
      236     assign
      237       v-seconds = v-seconds modulo 60
      238     .
      239     return
      240         (if v-day-number <> 0
      241           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      242           else ""
      243         )
      244       + (if v-day-number <> 0 or v-hour <> 0
      245           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      246           else ""
      247         )
      248       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      249           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      250           else ""
      251         )
      252       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      253       .
      254   end.
      255   function cur-time-string returns character
      256   :
      257     define variable v-date as date      no-undo .
      258     define variable v-time as integer   no-undo .
      259     run cur-time in this-procedure
      260       (output v-date
      261       ,output v-time
      262       ) .
      263     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      264   end.
      265   function cur-time-string-sec returns character
      266   :
      267     define variable v-date as date      no-undo .
      268     define variable v-time as integer   no-undo .
      269     run cur-time in this-procedure
      270       (output v-date
      271       ,output v-time
      272       ) .
      273     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      274   end.
      275   function cur-time-custom  returns character
      276   (input p-prefix as character
      277   ,input p-date-format as character
      278   ,input p-delimiter as character
      279   ,input p-time-format as character
      280   ,input p-suffix as character
      281   )
      282   :
      283     define variable v-date as date      no-undo .
      284     define variable v-time as integer   no-undo .
      285     run cur-time in this-procedure
      286       (output v-date
      287       ,output v-time
      288       ) .
      289     return
      290       p-prefix
      291       + string(v-date, p-date-format)
      292       + p-delimiter
      293       + string(v-time, p-time-format)
      294       + p-suffix
      295       .
      296   end.
      297   function cur-time-print  returns character
      298   :
      299     define variable v-date as date      no-undo .
      300     define variable v-time as integer   no-undo .
      301     run cur-time in this-procedure
      302       (output v-date
      303       ,output v-time
      304       ) .
      305     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      306   end.
      307   function cur-time-datetime returns datetime
      308   :
      309     define variable v-char as character no-undo .
      310     define variable v-datetime as datetime no-undo .
      311     v-char = cur-time-string().
      312     v-datetime = datetime(v-char).
      313     return  v-datetime.
      314   end.
      315   function cur-time-string-msec returns character
      316   :
      317     define variable v-date as datetime  no-undo .
      318     v-date = now.
      319     return string(v-date) .
      320   end.
      321   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      322   procedure wth-lib_cur-stock-place:
      323   define input  parameter parobj-type like ub.clients.obj-type   no-undo.
      324   define input  parameter parobj-code like ub.clients.obj-code   no-undo.
      325   define input  parameter parw-p-code like ub.wth-pobj.w-p-code  no-undo.
      326   define input  parameter parwth-code like ub.wth-pobj.wth-code  no-undo.
      327   define output parameter parstock    like ub.wth-pobj.income-pl no-undo.
      328   define buffer bf_wth-pobj for ub.wth-pobj.
      329   find first bf_wth-pobj where bf_wth-pobj.obj-type = parobj-type and
      330                                bf_wth-pobj.obj-code = parobj-code and
      331                                bf_wth-pobj.w-p-code = parw-p-code and
      332                                bf_wth-pobj.wth-code = parwth-code no-lock no-error.
      333   if available bf_wth-pobj then assign parstock = bf_wth-pobj.income-pl - bf_wth-pobj.incass-pl.
      334                            else assign parstock = 0.
      335   end procedure.
      336   procedure wth-lib_cur-stock-obj:
      337   define input  parameter parobj-type like ub.clients.obj-type   no-undo.
      338   define input  parameter parobj-code like ub.clients.obj-code   no-undo.
      339   define input  parameter parwth-code like ub.wth-obj.wth-code   no-undo.
      340   define output parameter parstock    like ub.wth-obj.income     no-undo.
      341   define buffer bf_wth-obj for ub.wth-obj.
      342   find first bf_wth-obj where bf_wth-obj.obj-type = parobj-type and
      343                               bf_wth-obj.obj-code = parobj-code and
      344                               bf_wth-obj.wth-code = parwth-code no-lock no-error.
      345   if available bf_wth-obj then assign parstock = bf_wth-obj.income - bf_wth-obj.incass.
      346                           else assign parstock = 0.
      347   end.
      348   FUNCTION wth-lib_cur-stock-obj-func RETURNS DECIMAL (INPUT parobj-type AS CHARACTER,
      349                                                        INPUT parobj-code AS INTEGER,
      350                                                        INPUT parwth-code AS INTEGER):
      351   define buffer bf_wth-obj for ub.wth-obj.
      352   find first bf_wth-obj where bf_wth-obj.obj-type = parobj-type and
      353                               bf_wth-obj.obj-code = parobj-code and
      354                               bf_wth-obj.wth-code = parwth-code no-lock no-error.
      355   if available bf_wth-obj then return (bf_wth-obj.income - bf_wth-obj.incass).
      356                           else return 0.00.
      357   end function.
      358   FUNCTION wth-lib_cur-stock-host-func RETURNS DECIMAL (INPUT parhost-code AS INTEGER,
      359                                                         INPUT parwth-code  AS INTEGER):
      360   define buffer bf_wth-obj for ub.wth-obj.
      361   define variable v-stock like ub.wth-obj.income no-undo.
      362   for each bf_wth-obj no-lock where bf_wth-obj.host-code = parhost-code and
      363                                     bf_wth-obj.wth-code = parwth-code :
      364     v-stock = v-stock +  bf_wth-obj.income - bf_wth-obj.incass.
      365   end.
      366   return v-stock.
      367   end function.
      368   procedure wth-lib_full-inf-shift:
      369   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input  parameter parshift-date   like ub.shift-obj.shift-date  no-undo.                        define input  parameter parshift-num    like ub.shift-obj.shift-num   no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                                                                                       cur_wth-line.wth-code   = parwth-code   and                                        cur_wth-line.shift-date = parshift-date and                        cur_wth-line.shift-num  = parshift-num  and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-sdn no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                                                                             start_wth-line.wth-code   = parwth-code         and                                (start_wth-line.shift-date = parshift-date and                           start_wth-line.shift-num  < parshift-num  or                            start_wth-line.shift-date < parshift-date ) and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-sdn no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income - cur_wth-line.incass              parincome        = cur_wth-line.income                     parincome-cassa  = cur_wth-line.income-cassa               parincome-other  = cur_wth-line.income-other               parincass        = cur_wth-line.incass                     parincass-bank   = cur_wth-line.incass-bank                parincass-other  = cur_wth-line.incass-other.              parincass-cassa  = cur_wth-line.incass-cassa.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income     - start_wth-line.incass               parstock-end     = cur_wth-line.income       - cur_wth-line.incass                 parincome        = cur_wth-line.income       - start_wth-line.income               parincome-cassa  = cur_wth-line.income-cassa - start_wth-line.income-cassa         parincome-other  = cur_wth-line.income-other - start_wth-line.income-other         parincass        = cur_wth-line.incass       - start_wth-line.incass               parincass-bank   = cur_wth-line.incass-bank  - start_wth-line.incass-bank          parincass-other  = cur_wth-line.incass-other - start_wth-line.incass-other.        parincass-cassa  = cur_wth-line.incass-cassa - start_wth-line.incass-cassa.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income - start_wth-line.incass                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
      370   end procedure.
      371   procedure wth-lib_full-inf-shift-inter:
      372   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input  parameter parshift-date   like ub.shift-obj.shift-date  no-undo.                        define input  parameter parshift-num    like ub.shift-obj.shift-num   no-undo.                        define input  parameter parshift-date1  like ub.shift-obj.shift-date  no-undo.                        define input  parameter parshift-num1   like ub.shift-obj.shift-num   no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                                                                                       cur_wth-line.wth-code   = parwth-code   and                                     