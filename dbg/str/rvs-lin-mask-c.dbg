        1   define  input parameter parparentproc   as handle    no-undo.
        2   define  input parameter p-code-rec-line as recid    no-undo.
        3   define  input parameter parmode         as character no-undo.
        4   define  input parameter partitle        as character no-undo.
        5   define variable vss-revision    as character no-undo initial "$Revision$":U.
        6   define variable vss-author      as character no-undo initial "$Author$":U.
        7   define variable vss-date        as character no-undo initial "$Date$":U.
        8   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
        9   define variable vss-archive     as character no-undo initial "$Archive$":U.
       10   define variable vss-description as character no-undo initial "Экран работы со строкой сверки":U.
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   procedure proc-alt-shift-f2:
       70     if not ibs.th.gbl.gbl-var:rcode
       71   then
       72     run gbl\inidebug.p .
       73   end.
       74   procedure proc-alt-shift-f3:
       75     run gbl/prvssinf.p
       76       ( input this-procedure
       77       ) .
       78   end.
       79   define variable v-inform-launched as logical no-undo initial false .
       80   procedure proc-alt-shift-f4:
       81     define variable v-action as character no-undo .
       82     if v-inform-launched = false then do:
       83       assign
       84         v-inform-launched = true
       85       .
       86       run gbl/d-inform.w
       87         (  input self
       88         ,  input this-procedure
       89         , output v-action
       90         ) no-error .
       91       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       92       assign
       93         v-inform-launched = false
       94       .
       95     end.
       96   end.
       97   procedure proc-alt-f1:
       98     run gbl/corrhelp.p
       99       (input this-procedure
      100       ) .
      101   end .
      102   on alt-shift-f2 anywhere do:
      103     run proc-alt-shift-f2.
      104   end.
      105   on alt-shift-f3 anywhere do:
      106     run proc-alt-shift-f3 in this-procedure .
      107   end.
      108   on alt-shift-f4 anywhere do:
      109     run proc-alt-shift-f4 in this-procedure.
      110   end.
      111   on alt-f1 anywhere do:
      112     run proc-alt-f1 in this-procedure .
      113   end.
      114   define new global shared variable g#library  as handle no-undo .
      115   define new global shared variable g#library2 as handle no-undo .
      116   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117     define variable v-cntxt-db-num        as integer   no-undo .
      118     define variable v-cntxt-userid        as character no-undo .
      119     define variable v-cntxt-level         as character no-undo .
      120     define variable v-cntxt-host-code-obj as integer   no-undo .
      121     define variable v-cntxt-obj-type      as character no-undo .
      122     define variable v-cntxt-obj-code      as integer   no-undo .
      123     define variable v-cntxt-db-num-obj    as integer   no-undo .
      124     define variable v-cntxt-is-admin      as logical   no-undo .
      125   define variable v-return-val as character no-undo initial "":U.
      126   define buffer buf_c-rvs-line for ub.c-rvs-line.
      127   DEFINE BUTTON b-cancel AUTO-END-KEY
      128        LABEL "&Отмена"
      129        SIZE 10 BY 1
      130        BGCOLOR 8 .
      131   DEFINE BUTTON b-save AUTO-GO
      132        LABEL "&Ввод"
      133        SIZE 10 BY 1
      134        BGCOLOR 8 .
      135   DEFINE VARIABLE fill-in-cap-count AS DECIMAL FORMAT ">>,>>>,>>9.99":U INITIAL 0
      136        LABEL "Показания счетчика"
      137        VIEW-AS FILL-IN
      138        SIZE 15 BY .95 NO-UNDO.
      139   DEFINE VARIABLE fill-in-cap-pres AS DECIMAL FORMAT ">>9.99":U INITIAL 0
      140        LABEL "Остаточное давление"
      141        VIEW-AS FILL-IN
      142        SIZE 15 BY .95 NO-UNDO.
      143   DEFINE RECTANGLE RECT-C
      144        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      145        SIZE 57 BY 3.57.
      146   DEFINE RECTANGLE RECT-M
      147        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      148        SIZE 57 BY 5.
      149   DEFINE FRAME Dialog-Frame
      150        b-save AT ROW 1 COL 1
      151        b-cancel AT ROW 1 COL 11
      152        fill-in-cap-count AT ROW 9.57 COL 34 COLON-ALIGNED WIDGET-ID 36
      153        fill-in-cap-pres AT ROW 11 COL 34 COLON-ALIGNED WIDGET-ID 38
      154        "Данные по накопительной емкости" VIEW-AS TEXT
      155             SIZE 38 BY .71 AT ROW 8.14 COL 24 WIDGET-ID 32
      156        "Данные о заборе газа из магистрали" VIEW-AS TEXT
      157             SIZE 40 BY .71 AT ROW 2.19 COL 22 WIDGET-ID 22
      158        RECT-M AT ROW 2.91 COL 12 WIDGET-ID 24
      159        RECT-C AT ROW 8.86 COL 12 WIDGET-ID 34
      160        SPACE(11.19) SKIP(0.61)
      161       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      162            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      163            TITLE "Документ сверки"
      164            CANCEL-BUTTON b-cancel.
      165   ASSIGN
      166          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      167          FRAME Dialog-Frame:HIDDEN           = TRUE.
      168   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      169   DO:
      170     v-return-val = "cancel".
      171     APPLY "END-ERROR":U TO SELF.
      172   END.
      173   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
      174   DO:
      175   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      176   if lookup(self :type
      177            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      178            ) = 0
      179   then do:
      180     message
      181       "$Workfile$"
      182       "Указанному интерфейсному элементу фокус не может быть передан" skip
      183       "Интерфейсный элемент" self :name  skip
      184       "Тип" self :type  skip
      185       "Процедура" this-procedure :file-name skip
      186       view-as alert-box .
      187   end.
      188   else do:
      189     apply "entry":u to self  .
      190     if focus :handle <> self :handle  then do:
      191       return no-apply .
      192     end.
      193   end.
      194     v-return-val = "cancel".
      195     APPLY "END-ERROR":U TO SELF.
      196   END.
      197   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      198   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      199   MAIN-BLOCK:
      200   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      201      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      202     run get-values in this-procedure.
      203     run enable_UI in this-procedure.
      204     assign frame Dialog-Frame :title = frame Dialog-Frame :title + " - " + parmode + " - " +  partitle.
      205     run ui-on in this-procedure.
      206     WAIT-FOR GO OF FRAME Dialog-Frame.
      207   END.
      208   RUN disable_UI.
      209   return v-return-val.
      210   PROCEDURE disable_UI :
      211     HIDE FRAME Dialog-Frame.
      212   END PROCEDURE.
      213   PROCEDURE enable_UI :
      214     DISPLAY fill-in-cap-count fill-in-cap-pres
      215         WITH FRAME Dialog-Frame.
      216     ENABLE b-save RECT-M RECT-C b-cancel  fill-in-cap-count fill-in-cap-pres
      217         WITH FRAME Dialog-Frame.
      218     VIEW FRAME Dialog-Frame.
      219   END PROCEDURE.
      220   procedure ui-on:
      221   if parmode = 'ПРОСМОТР':U then
      222       disable b-save fill-in-cap-count fill-in-cap-pres
      223               with frame Dialog-Frame.
      224   end procedure.
      225   procedure get-values:
      226   find first buf_c-rvs-line no-lock where recid(buf_c-rvs-line) = p-code-rec-line no-error.
      227   if not available buf_c-rvs-line then do:
      228      message "Неверно переданы параметры."
      229              "Не найдена  сверка  " p-code-rec-line " ."
      230      view-as alert-box error.
      231      return error.
      232   end.
      233   assign
      234       fill-in-cap-count = buf_c-rvs-line.state-level-petrol
      235       fill-in-cap-pres = buf_c-rvs-line.state-level-total
      236   .
      237   end procedure.
