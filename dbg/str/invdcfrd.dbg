        1   block-level on error undo, throw.
        2   define input  parameter pardoc-code like ub.trn-doc.doc-code no-undo.
        3   define output parameter parinvclcspvalue as character no-undo.
        4   define output parameter parprtvalue      as character no-undo.
        5   define output parameter parr-b           as character no-undo.
        6   define output parameter par-is-cdinv     as character no-undo .
        7   define new global shared variable g#language as character no-undo .
        8   if g#language <> '' and g#language <> 'rus':U then do:
        9     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       10   end.
       11   define new global shared variable g#library  as handle no-undo .
       12   define new global shared variable g#library2 as handle no-undo .
       13   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       14   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       15   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
       16   define variable par-type          as character no-undo.
       17   define variable v-value-character as character no-undo .
       18   define variable v-value-date      as date      no-undo .
       19   define variable v-value-decimal   as decimal   no-undo .
       20   define variable v-value-integer   as integer   no-undo .
       21   define variable v-value-logical   as logical   no-undo .
       22   define variable var-type1 as character no-undo.
       23   define variable var-type2 as character no-undo.
       24   define variable var-type3 as character no-undo.
       25   define variable var-type4 as character no-undo.
       26   define variable var-type5 as character no-undo.
       27   define buffer bf_trn-doc for ub.trn-doc.
       28   find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code no-lock.
       29   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
       30     (input  'is-prt':u
       31     ,input  ''
       32     ,input  ''
       33     ,input  0
       34     ,input  ''
       35     ,input  ''
       36     ,input  ''
       37     ,input  yes
       38     ,output parprtvalue
       39     ,output var-type2
       40     ) no-error .
       41   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$".
       42   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
       43     (output parr-b
       44     )  .
       45   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
       46     (input  'is-cdinv':u
       47     ,input  ''
       48     ,input  ''
       49     ,input  0
       50     ,input  ''
       51     ,input  ''
       52     ,input  ''
       53     ,input  yes
       54     ,output par-is-cdinv
       55     ,output var-type5
       56     ) no-error .
       57     if error-status :error or
       58       par-is-cdinv  <> "yes"
       59     then do:
       60       assign par-is-cdinv = "no".
       61     end.
       62   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       63   empty temp-table thbjattr_thbj-attr.
       64   run adm/shattri.p (
       65      input "get":U
       66     ,input bf_trn-doc.obj-type
       67     ,input bf_trn-doc.obj-code
       68     ,input 'inv-obj':U
       69     ,input  ""
       70     ,output v-value-character
       71     ,output v-value-date
       72     ,output v-value-decimal
       73     ,output v-value-integer
       74     ,output v-value-logical
       75     ,output par-type
       76     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
       77     ) no-error .
       78     for each thbjattr_thbj-attr :
       79         if thbjattr_thbj-attr.prop-code = 'invclcsp'  then parinvclcspvalue = string( thbjattr_thbj-attr.property-value-logical, "yes/no").
       80     end.
