       86   define variable p-section as character no-undo .
       87   define variable p-what-send as character no-undo .
       88   define variable ncr-save-param               as character         no-undo init 'no'.
       89   define variable cr-ncr-dis-kat               as integer       no-undo .
       90   define variable conf-attr as character no-undo .
       91   define variable conf-par  as character no-undo .
       92   define variable par-type as character no-undo .
       93   define variable i-obj-code as integer no-undo .
       94   define variable v-host-code as integer no-undo .
       95   define temp-table temp-talon-pay no-undo
       96   field cdpay-code1 as integer
       97   field cdpay-code2 as integer
       98   field diap as character
       99   field rank as integer
      100   index pi is unique primary cdpay-code1
      101   index pi2 cdpay-code2
