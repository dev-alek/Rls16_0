     3562         ,input (replace( v-xml-file-name-path, "/", "\" ) + "xml")
     3563         ,input (replace(in_ + spl + "/" + v-xml-file-name, "/", "\" ) + ".xml")
     3564         ,input 30
     3565         ,input   ( if action = 'U'
     3566                     then ('Ждите - ' + 'добавление/изменение параметров')
     3567                     else ('Ждите - ' + 'удаление параметров') ) +
     3568                     substitute("Маг&1 касса&2", for-cash-desk.obj-code, for-cash-desk.cash-num)
     3569         ) no-error .
     3570       if error-status:error
     3571       or return-value = "error" then do:
     3572         run write-log-and-file in p-log-handle (
     3573               input 1
     3574             , input log-file-name
     3575             , input 1
     3576             , input substitute( "!!!Не удалось получить ответ с маг&1 касса &2 об успешной доставке данных:&3&4 &5"
     3577                                   ,for-cash-desk.obj-code
     3578                                   ,for-cash-desk.cash-num
     3579                                   , chr(10)
