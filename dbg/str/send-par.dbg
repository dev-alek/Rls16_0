     3622             , input substitute( "!!!Не удалось получить ответ с маг&1 касса &2 об успешной доставке данных"
     3623                                   ,for-cash-desk.obj-code
     3624                                   ,for-cash-desk.cash-num
     3625                               )
     3626                                               ).
     3627         assign
     3628         v-view-log = yes
     3629         .
     3630       end.
     3631     end.
     3632   end.
     3633   if g#news
     3634   or g#auto
     3635   or g#esys
     3636   and for-cash-desk.pos-type = 'MAGIA-XML':U
     3637   then do:
     3638   end.
     3639     end.
     3640     when 'NCR-GM':U
     3641     then do:
     3642   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3643   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3644   if action = 'D':U then do:
     3645     assign                                                                       v-temp-kat-file = out + fname + '.dat'                                       v-kat-file = entry(3, out2, chr(4)) + 'p_regpar.dat':U               v-updated-subject-dis-kat = no.                                              if ncr-save-param <> 'no' then do:                                             v-kat-file-save = if ncr-save-param = 'NCR'                                                    then replace(v-kat-file, '.dat', '.sav')                                     else search(replace('p_regpar.dat', '.dat', '.sav')).    end.
     3646     V-NEXT = NO.
     3647     if search(v-kat-file) <> ? then do:
     3648       if ncr-save-param <> 'no':U then do:                                           if search(v-kat-file-save) <> ? then do:                                     input stream bar from value(v-kat-file-save) convert source "ibm866" .       repeat:                                                                        import stream bar unformatted ss.                                            find first cash-ncr-save-param where                                                  cash-ncr-save-param.dis-kat = 0                                          AND cash-ncr-save-param.cd-line = substring(ss, 1, 5) no-error.         if not available cash-ncr-save-param then do:                                  create cash-ncr-save-param.                                                  assign                                                                       cash-ncr-save-param.dis-kat = 0                                              cash-ncr-save-param.cd-line = substring(ss, 1, 5)                            cash-ncr-save-param.cd-other = substring(ss, 6)                              .                                                                          end.                                                                       end.                                                                         input stream bar close .                                                     end.                                                                         else do:                                                                     end.                                                                       end.
     3649     end.
     3650     input stream bar from value(v-kat-file) convert source "ibm866" .
     3651     output stream plucash to value(v-temp-kat-file) convert target "ibm866".
     3652     _rr:
     3653     repeat:
     3654       import stream bar unformatted ss.
     3655       ss0 = substring(ss, 1, 5).
     3656       if not can-find(first cash-ncr-dis-kat where cash-ncr-dis-kat.cd-subject-code <= substring(ss, 1, 5))
     3657       or can-find(first cash-ncr-save-param no-lock where
     3658                         cash-ncr-save-param.dis-kat = 0
     3659                     AND cash-ncr-save-param.cd-line = substring(ss, 1, 5))
     3660       then do:
     3661         put stream plucash unformatted
     3662         ss skip.
     3663         next _rr.
     3664       end.
     3665       find first buf_cash-ncr-dis-kat no-lock where
     3666               buf_cash-ncr-dis-kat.cd-subject-code = substring(ss, 1, 5) no-error.
     3667       if not available buf_cash-ncr-dis-kat then do:
     3668         put stream plucash unformatted
     3669         ss skip.
     3670       end.
     3671       ELSE DO:
     3672         ASSIGN
     3673         V-NEXT = YES.
     3674       END.
     3675     end.
     3676     input stream bar close.
     3677     output stream plucash close.
     3678     IF V-NEXT THEN DO:
     3679       find first temp-dis-kat-file no-lock where                                                       temp-dis-kat-file.dis-kat = 0 no-error.                                      if not available temp-dis-kat-file then                                                create temp-dis-kat-file.                                                              assign                                                                                 temp-dis-kat-file.dis-kat   = 0                                                        .                                                                                      assign                                                                                 temp-dis-kat-file.temp-file = v-temp-kat-file                                          temp-dis-kat-file.send-file = v-kat-file                                               temp-dis-kat-file.to-send   = yes .
     3680     END.
     3681   end.
     3682   if action = 'U':U then do:
     3683     assign                                                                       v-temp-kat-file = out + fname + '.dat'                                       v-kat-file = entry(3, out2, chr(4)) + 'p_regpar.dat':U               v-updated-subject-dis-kat = no.                                              if ncr-save-param <> 'no' then do:                                             v-kat-file-save = if ncr-save-param = 'NCR'                                                    then replace(v-kat-file, '.dat', '.sav')                                     else search(replace('p_regpar.dat', '.dat', '.sav')).    end.
     3684     if search(v-kat-file) = ? then do:
     3685       output stream bar to value(v-kat-file) convert target "ibm866" .
     3686       put stream bar unformatted skip.
     3687       output stream bar close.
     3688     end.
     3689     else do:
     3690       if ncr-save-param <> 'no':U then do:                                           if search(v-kat-file-save) <> ? then do:                                     input stream bar from value(v-kat-file-save) convert source "ibm866" .       repeat:                                                                        import stream bar unformatted ss.                                            find first cash-ncr-save-param where                                                  cash-ncr-save-param.dis-kat = 0                                          AND cash-ncr-save-param.cd-line = substring(ss, 1, 5) no-error.         if not available cash-ncr-save-param then do:                                  create cash-ncr-save-param.                                                  assign                                                                       cash-ncr-save-param.dis-kat = 0                                              cash-ncr-save-param.cd-line = substring(ss, 1, 5)                            cash-ncr-save-param.cd-other = substring(ss, 6)                              .                                                                          end.                                                                       end.                                                                         input stream bar close .                                                     end.                                                                         else do:                                                                     end.                                                                       end.
     3691     end.
     3692     input stream bar from value(v-kat-file) convert source "ibm866" .
     3693     assign
     3694     ss0 = ''
     3695     ss = '':U
     3696     v-cd-subject-code = '':U
     3697     v-next = no
     3698     v-updated-subject-dis-kat = no
     3699     .
     3700     output stream plucash to value(v-temp-kat-file) convert target "ibm866".
     3701     _rr2:
     3702     repeat:
     3703       import stream bar unformatted ss.
     3704       if ss = '':U then next _rr2.
     3705       assign
     3706       v-next = no
     3707       v-updated-subject-dis-kat = no
     3708       v-cd-subject-code = substring(ss, 1, 5)
     3709       .
     3710       find first cash-ncr-dis-kat where
     3711                 cash-ncr-dis-kat.dis-kat = 0
     3712             and  cash-ncr-dis-kat.cd-subject-code = v-cd-subject-code no-error .
     3713       if not available cash-ncr-dis-kat
     3714       then do:
     3715         v-next = yes.
     3716       end.
     3717       _for_rr2:
     3718       for each  buf_cash-ncr-dis-kat no-lock where
     3719                 buf_cash-ncr-dis-kat.dis-kat = 0
     3720             AND buf_cash-ncr-dis-kat.cd-subject-code <= v-cd-subject-code
     3721             AND buf_cash-ncr-dis-kat.cd-subject-code > ss0
     3722             and crf <= cr-ncr-dis-kat
     3723       by buf_cash-ncr-dis-kat.cd-subject-code
     3724       by buf_cash-ncr-dis-kat.cd-disc-string
     3725       :
     3726         if buf_cash-ncr-dis-kat.cd-subject-code = v-cd-subject-code then do:
     3727           v-updated-subject-dis-kat = yes.
     3728         end.
     3729         find first  cash-ncr-save-param no-lock where
     3730                         cash-ncr-save-param.dis-kat = 0
     3731                     AND cash-ncr-save-param.cd-line = buf_cash-ncr-dis-kat.cd-subject-code  no-error.
     3732         if available cash-ncr-save-param then do:
     3733           put stream plucash unformatted
     3734           cash-ncr-save-param.cd-line
     3735           cash-ncr-save-param.cd-other
     3736           skip.
