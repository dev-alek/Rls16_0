     1470   procedure alienini-getkey :
     1471   define input parameter i-filename as char.
     1472   define input parameter i-section as char.
     1473   define input parameter i-key as char.
     1474   define output parameter o-value as char.
     1475   define variable EntryPointer as integer no-undo.
     1476   define variable mem1 as memptr no-undo.
     1477   define variable mem2 as memptr no-undo.
     1478   define variable mem1size as integer no-undo.
     1479   define variable mem2size as integer no-undo.
     1480   define variable ii       as integer    no-undo.
     1481   define variable cbReturnSize  as integer    no-undo.
     1482   assign
     1483   set-size(mem1)  = 4000
     1484   mem1size = 4000.
     1485   if i-key = "" then EntryPointer = 0.
     1486   else do:
     1487     assign
     1488     set-size(mem2) = 128
     1489     mem2size = 128
     1490     EntryPointer = get-pointer-value(mem2)
     1491     put-string(mem2, 1) = i-key.
     1492   end.
     1493   run getprivateprofilestringA
     1494                                 (i-section,
     1495                                  EntryPointer,
     1496                                  "",
     1497                                  get-pointer-value(mem1),
     1498                                  input mem1size,
     1499                                  i-filename,
     1500                                  output cbReturnSize).
     1501   do ii = 1 to cbReturnSize:
     1502     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
     1503                  then o-value + ","
     1504                  else o-value + chr(get-byte(mem1, ii)).
     1505   end.
     1506     set-size(mem1) = 0.
     1507     set-size(mem2) = 0.
     1508   end procedure.
     1509   procedure alienini-putkey :
     1510   define input parameter i-filename as char.
     1511   define input parameter i-section as char.
     1512   define input parameter i-key as char.
     1513   define input parameter i-value as char.
     1514   define variable cbReturnSize as integer.
     1515   run writeprivateprofilestringA
     1516                                  (i-section,
     1517                                   i-key,
     1518                                   i-value,
     1519                                   i-filename,
     1520                                   output cbReturnSize ).
     1521   end procedure.
     1522   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
     1523     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
     1524     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
     1525     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
     1526     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
     1527     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
     1528     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
     1529     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
     1530   END PROCEDURE.
     1531   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
     1532     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
     1533     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
     1534     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
     1535     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
     1536     DEFINE RETURN PARAMETER lpszValue    AS LONG.
     1537   END PROCEDURE.
