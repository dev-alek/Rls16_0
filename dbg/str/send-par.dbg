     3050               when 'paycard-all-prefix':U then do:     assign     p-hist = true.   end.
     3051               when 'paycard-edit-prefix':U then do:     assign     p-hist = true.   end.
     3052               when 'form_km3':U then do:     assign     p-hist = true.   end.
     3053               when 'bal_malina':U then do:     assign     p-hist = true.   end.
     3054               when 'max_proc_sum':U then do:     assign     p-hist = true.   end.
     3055               when 'mask_card_kup':U then do:     assign     p-hist = true.   end.
     3056         otherwise do:
     3057           p-hist = no.
