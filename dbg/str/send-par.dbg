     4093       ,output v-value-decimal30
     4094       ,output v-value-integer30
     4095       ,output v-value-logical30
     4096       ,output v-param-type30
     4097       ,INPUT-OUTPUT table-handle v-tth30
     4098       ) no-error .
     4099   delete object v-tth30 no-error.
     4100   case ub.cash-desk.pos-type:
     4101       when 'IBM-XML':U or when 'Autotank':U
     4102     then do:
     4103   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4104   run str/get-inis.p (
     4105                   input 'маг':U
     4106                 , input ub.cash-desk.obj-code
