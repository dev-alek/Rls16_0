     4064   PROCEDURE SENDING:
     4065   _cash-desk:
     4066   FOR EACH ub.cash-desk NO-LOCK WHERE
     4067            ub.cash-desk.db-num = p-db-num AND
     4068            ub.cash-desk.obj-code = p-obj-code AND
     4069            ub.cash-desk.pos-type = p-pos-type AND
