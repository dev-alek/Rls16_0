     3423           for-cash-desk.obj-code = p-obj-code AND
     3424           for-cash-desk.cash-on  = yes AND
     3425           (p-cash-num = ? or
     3426           for-cash-desk.cash-num = p-cash-num)
     3427       BREAK
     3428       BY for-cash-desk.db-num
     3429       BY for-cash-desk.obj-code
     3430       BY for-cash-desk.pos-type
     3431       BY for-cash-desk.cash-on
     3432       :
     3433     if LOOKUP(ub.cash-desk.pos-type,
     3434               ('NCR-GM':U + chr(44) +
     3435                'IBM-XML':U + chr(44) +
     3436                'MAGIA-XML':U + chr(44) +
     3437                'NCR-AS@R':U
     3438                  )) > 0
     3439     and for-cash-desk.autonomy = integer('1':U) then NEXT.
