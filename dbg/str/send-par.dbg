     3062   FUNCTION cp-isuse returns logical ( input p-cdpay-code as integer
     3063                                      ,input p-curr-code as integer
     3064                                      ,input p-host-code as integer
     3065                                      ,input p-obj-type as character
     3066                                      ,input p-obj-code as integer
     3067                                      ,input p-cp-is-use as logical
     3068                                      ,input p-cash-num as integer
     3069                                      ,input p-pos-type as character
     3070                                      ):
     3071   define variable v-value as character no-undo .
     3072   define variable v-type as character no-undo .
     3073   if p-cp-is-use then do:
     3074     run cp-attr-value  in this-procedure (
     3075                                              input p-cdpay-code
     3076                                             ,input p-curr-code
     3077                                             ,input p-host-code
     3078                                             ,input p-obj-type
     3079                                             ,input p-obj-code
     3080                                             ,input 'is-use':U
     3081                                             ,output v-value
     3082                                             ,output v-type) no-error .
     3083     if error-status:error
     3084     or v-value = '':u then do:
     3085       run cp-attr-value  in this-procedure (
     3086                                                input p-cdpay-code
     3087                                               ,input p-curr-code
     3088                                               ,input p-host-code
     3089                                               ,input '':U
     3090                                               ,input  0
     3091                                               ,input 'is-use':U
     3092                                               ,output v-value
     3093                                               ,output v-type) no-error .
     3094       if error-status:error
     3095       or v-value = '':u then do:
     3096         run cp-attr-value  in this-procedure (
     3097                                                 input  p-cdpay-code
     3098                                                 ,input p-curr-code
     3099                                                 ,input  0
     3100                                                 ,input  '':U
     3101                                                 ,input  0
     3102                                                 ,input  'is-use':U
     3103                                                 ,output v-value
     3104                                                 ,output v-type) no-error .
     3105       end.
     3106     end.
     3107     if v-value <> '*':U
     3108     and lookup(string(p-cash-num) + chr(44) + p-pos-type, v-value, chr(4)) = 0 then do:
     3109       return no.
     3110     end.
     3111   end.
     3112   return yes.
     3113   END FUNCTION.
     3114   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3115   procedure putc-par :
     3116   define parameter buffer buf_cash-desk for ub.cash-desk.
     3117   define input parameter p-pos-type like ub.cash-desk.pos-type no-undo .
     3118   define input parameter p-version like ub.cash-desk.version no-undo .
     3119   define input parameter p-cash-os like ub.cash-desk.cash-os no-undo .
     3120   define input parameter p-cash-num like ub.cash-desk.cash-num  no-undo .
     3121   define variable v-cda-character as character no-undo .
     3122   define variable v-cda-date as date no-undo .
     3123   define variable v-cda-decimal as decimal no-undo .
     3124   define variable v-cda-integer as integer no-undo .
     3125   define variable v-cda-logical as logical no-undo .
     3126   define variable v-type as character no-undo .
     3127   define variable v-limit as decimal no-undo .
     3128   define variable attr-type as character no-undo .
     3129   define variable attr-format as character no-undo .
     3130   define variable attr-label as character no-undo .
     3131   define variable attr-value as character no-undo .
     3132   define variable attr-user-can-edit as logical no-undo .
     3133   define variable attr-output-display as logical no-undo .
     3134   define variable attr-other as char no-undo .
     3135   define variable attr-from-gbd as logical no-undo .
     3136   define variable attr-from-ubd as logical no-undo .
     3137   define variable attr-news as logical no-undo .
     3138   define variable v-prop-list as character no-undo .
     3139   define variable v-what-send as character no-undo .
     3140   define variable v-section as character no-undo .
     3141   define variable v-cash-num as integer no-undo init -1.
     3142   define variable v-tare-string as character no-undo .
     3143   define variable v-tare-weight as integer no-undo .
     3144   define variable v-ii as integer no-undo .
     3145   define variable v-jj as integer no-undo .
     3146   define buffer buf_cash-desk-attr for ub.cash-desk-attr.
     3147   define buffer buf2_cash-desk-attr for ub.cash-desk-attr.
     3148     do
     3149     on error undo, return error return-value
     3150     :
     3151       v-what-send = p-what-send.
     3152       v-section = p-section.
     3153       for each buf_cash-desk-attr no-lock where
     3154             buf_cash-desk-attr.db-num = p-db-num
     3155         and buf_cash-desk-attr.obj-code = p-obj-code
     3156         and buf_cash-desk-attr.pos-type = p-pos-type
     3157         and buf_cash-desk-attr.upper-attr-code = v-section
     3158         and ( p-cash-num = ?
     3159              or
     3160              buf_cash-desk-attr.cash-num = p-cash-num)
     3161         and (p-what-send = '':U
     3162              or
     3163              buf_cash-desk-attr.attr-code = p-what-send
     3164             or
     3165              buf_cash-desk-attr.attr-code begins (p-what-send + chr(4))
     3166              ):
     3167         run cd-attr-value(
     3168                                 input  p-db-num
     3169                               ,input  p-obj-code
     3170                               ,input  p-pos-type
     3171                               ,input  p-cash-num
     3172                               ,input  buf_cash-desk-attr.upper-attr-code
     3173                               ,input  buf_cash-desk-attr.attr-code
     3174                               ,output v-cda-character
     3175                               ,output v-cda-date
     3176                               ,output v-cda-decimal
     3177                               ,output v-cda-integer
     3178                               ,output v-cda-integer
     3179                               ,output v-type) no-error .
     3180         if not error-status:error then do:
     3181           if v-what-send = '':u then p-what-send = buf_cash-desk-attr.attr-code.
     3182           CASE p-what-send:
     3183             when 'message-by-lim-sum-check':U
     3184             or
     3185             when 'message-by-lim-sum-check':U
     3186             then do:
     3187               assign
     3188               v-limit = v-cda-decimal
     3189               no-error .
     3190               if not error-status:error then do:
     3191                 run create-ncr-par in this-procedure (
     3192                                                           input 'GVCD0'
     3193                                                          ,input string(round(v-limit, 0), "99999") + fill('0', 35) ).
     3194               end.
     3195             end.
     3196             when 'tara-ref':U
     3197             or
     3198             when 'tara-ref':U
     3199             then do:
     3200               if v-cash-num = buf_cash-desk-attr.cash-num then next.
     3201               do v-ii = 0 to 9:
     3202                 v-tare-string = "".
     3203                 do v-jj = 0 to 9:
     3204                   find first buf2_cash-desk-attr no-lock where
     3205                           buf2_cash-desk-attr.db-num = p-db-num
     3206                       and buf2_cash-desk-attr.obj-code = p-obj-code
     3207                       and buf2_cash-desk-attr.pos-type = p-pos-type
     3208                       and buf2_cash-desk-attr.cash-num = buf_cash-desk-attr.cash-num
     3209                       and buf2_cash-desk-attr.upper-attr-code = buf_cash-desk-attr.upper-attr-code
     3210                       and buf2_cash-desk-attr.attr-code = p-what-send + chr(4) + string(v-ii * 10 + v-jj, '99') no-error.
     3211                   if available buf2_cash-desk-attr
     3212                   and (v-ii * 10 + v-jj) > 0
     3213                   then do:
     3214                     assign
     3215                     v-tare-weight = integer(buf2_cash-desk-attr.attr-value-character) no-error.
     3216                     if not error-status:error
     3217                     and v-tare-weight >= 0
     3218                     and v-tare-weight <= 9999 then do:
     3219                         assign
     3220                         v-tare-string = v-tare-string + (string(v-tare-weight, "9999"))
     3221                         .
     3222                     end.
     3223                     else do:
     3224                         assign
     3225                         v-tare-string = v-tare-string + "0000":U
     3226                         .
     3227                     end.
     3228                   end.
     3229                   else do:
     3230                     assign
     3231                     v-tare-string = v-tare-string + "0000":U
     3232                     .
     3233                   end.
     3234                 end.
     3235                 run create-ncr-par in this-procedure (
     3236                                                             input ('TARE' + string (v-ii))
     3237                                                             ,input v-tare-string ).
     3238               end.
     3239               v-cash-num = buf_cash-desk-attr.cash-num.
     3240             end.
     3241             when 'use-kbo':U then do:
     3242               define variable v-cp-is-use as logical no-undo .
     3243               define variable v-kbo-string as character no-undo extent 5.
     3244               define variable v-prev-cdpay-code as integer no-undo .
     3245               define buffer buf_cash-pay for ub.cash-pay.
     3246               for each temp-talon-pay:
     3247                 delete temp-talon-pay.
     3248               end.
     3249               if v-cda-logical = yes then do:
     3250                 if action = 'D':U then do:
     3251                   assign
     3252                   v-cp-is-use = no.
     3253                 end.
     3254                 if action <> 'D':U then do:
     3255                   run adm/shattri.p (
     3256                       input "get":U
     3257                       ,input  'маг':U
     3258                       ,input  p-obj-code
     3259                       ,input  'cd-inf-send':U
     3260                       ,input  'cp-is-use':U
     3261                       ,output v-value-character
     3262                       ,output v-value-date
     3263                       ,output v-value-decimal
     3264                       ,output v-value-integer
     3265                       ,output v-value-logical
     3266                       ,output v-param-type
     3267                       ,INPUT-OUTPUT table-handle v-tth
     3268                       ) no-error .
     3269                   IF not error-status:error
     3270                   then do:
     3271                     v-cp-is-use = v-value-logical.
     3272                     delete object v-tth.
     3273                   end.
     3274                   else do:
     3275                     delete object v-tth.
     3276                     return error return-value .
     3277                   end.
     3278                 end.
     3279                 v-ii = 1.
     3280                 v-prev-cdpay-code = 0.
     3281                 for each buf_cash-pay no-lock where
     3282                         buf_cash-pay.is-kbo > 0
     3283                 and buf_cash-pay.curr-code = 0
     3284                 break
     3285                 by buf_cash-pay.cdpay-code
     3286                 by buf_cash-pay.curr-code:
     3287                   if cp-isuse ( input  buf_cash-pay.cdpay-code
     3288                                 ,input  buf_cash-pay.curr-code
     3289                                 ,input  v-host-code
     3290                                 ,input 'маг':U
     3291                                 ,input p-obj-code
     3292                                 ,input v-cp-is-use
     3293                                 ,input p-cash-num
     3294                                 ,input p-pos-type )
     3295                   then do:
     3296                     if v-prev-cdpay-code = buf_cash-pay.cdpay-code - 1 then do:
     3297                       find first temp-talon-pay where
     3298                                 temp-talon-pay.cdpay-code1 <= v-prev-cdpay-code
     3299                           and  temp-talon-pay.cdpay-code2 = v-prev-cdpay-code  no-error.
     3300                       if not available temp-talon-pay then do:
     3301                         create temp-talon-pay.
     3302                         assign
     3303                         temp-talon-pay.cdpay-code1 = buf_cash-pay.cdpay-code
     3304                         temp-talon-pay.cdpay-code2 = buf_cash-pay.cdpay-code
     3305                         .
     3306                       end.
     3307                       else do:
     3308                         assign
     3309                         temp-talon-pay.cdpay-code2 = buf_cash-pay.cdpay-code
     3310                         .
     3311                       end.
     3312                     end.
     3313                     else do:
     3314                       create temp-talon-pay.
     3315                       assign
     3316                       temp-talon-pay.cdpay-code1 = buf_cash-pay.cdpay-code
     3317                       temp-talon-pay.cdpay-code2 = buf_cash-pay.cdpay-code
     3318                       .
     3319                     end.
     3320                     assign
     3321                     temp-talon-pay.diap = (if temp-talon-pay.cdpay-code1 = temp-talon-pay.cdpay-code2
     3322                                            then string(temp-talon-pay.cdpay-code1)
     3323                                            else substitute('&1-&2'
     3324                                                       , temp-talon-pay.cdpay-code1
     3325                                                       ,temp-talon-pay.cdpay-code2)
     3326                                            )
     3327                     temp-talon-pay.rank = (if temp-talon-pay.cdpay-code1 = temp-talon-pay.cdpay-code2
     3328                                            then 1
     3329                                            else 0)
     3330                     .
     3331                     release temp-talon-pay.
     3332                     v-prev-cdpay-code = buf_cash-pay.cdpay-code.
     3333                   end.
     3334                 end.
     3335                 v-ii = 1.
     3336                 for each temp-talon-pay
     3337                 by temp-talon-pay.rank
     3338                 by temp-talon-pay.cdpay-code1
     3339                 :
     3340                     if length(v-kbo-string[v-ii] + (if v-kbo-string[v-ii] = '':U then '':U else chr(44)) + temp-talon-pay.diap) > 39 then do:
     3341                       v-ii = v-ii + 1.
     3342                       if v-ii > 5 then do:
     3343                         if not g#auto
     3344                         and not g#news then do:
     3345                           message
     3346                           "Параметр ИСПОЛЬЗОВАТЬ КБО отошлется на кассу, однако списки ВСЕХ КБО в него не поместились!"
     3347                           view-as alert-box error .
     3348                         end.
     3349                         leave.
     3350                       end.
     3351                     end.
     3352                     assign
     3353                     v-kbo-string[v-ii] = v-kbo-string[v-ii] + (if v-kbo-string[v-ii] = '':U then '':U else chr(44)) +
     3354                                         temp-talon-pay.diap.
     3355                 end.
     3356               end.
     3357               do v-ii = 1 to 5 :
     3358                 run bgelib-tag-open in this-procedure ( input 2, input "Param"
     3359                                                        ,input substitute("ctrl='&1' tms='&2' group='UFO2' key='TalonPay&3'"
     3360                                                                          ,'ADD':u
     3361                                                                          ,OS2-time
     3362                                                                          ,v-ii)).
     3363                 run bgelib-tag-put in this-procedure ( input 3, input "ParamValue", v-kbo-string[v-ii] , input 1 ).
     3364                 run bgelib-tag-put in this-procedure ( input 3, input "ParamDesc"
     3365                                                      , substitute("Список КБО, строка &1-ПЕРЕДАНО ИЗ IBS TH"
     3366                                                                   ,v-ii)
     3367                                                      , input 1 ).
     3368                 run bgelib-tag-close in this-procedure ( input 2, input "Param" ).
     3369               end.
     3370             end.
     3371           END.
     3372         end.
     3373         else do:
     3374           run cd-attr-code ( input buf_cash-desk-attr.upper-attr-code
     3375                              ,input buf_cash-desk-attr.attr-code
     3376                              ,output attr-type
     3377                              ,output attr-format
     3378                              ,output attr-label
     3379                              ,output attr-user-can-edit
     3380                              ,output attr-output-display
     3381                              ,output attr-other
     3382                              ,output v-prop-list
     3383                               ).
     3384           run write-log-and-file in p-log-handle (
     3385                 input 1
     3386               , input log-file-name
     3387               , input 1
     3388               , input substitute( "!!!Ошибки при чтении атрибута кассы &1 &2 маг&3:&4" +
     3389                                   "атрибут &5"
     3390                                 , p-pos-type
     3391                                 , p-cash-num
     3392                                 , p-obj-code
     3393                                 , chr(10)
     3394                                 , attr-label) ).
     3395         end.
     3396       end.
     3397     end.
     3398   end procedure.
     3399   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3400   PROCEDURE   for-cash-cycle:
     3401   DEFINE VARIABLE fname-list as character no-undo .
