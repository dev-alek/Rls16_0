     1597   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
     1598   define variable v-is-closed-shift-journal as integer no-undo .
     1599   assign
     1600   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
     1601                               +
     1602                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
     1603                               +
     1604                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
     1605   .
     1606   return v-is-closed-shift-journal.
     1607   END FUNCTION.
     1608   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
     1609   define variable v-is-first-journal as logical no-undo .
     1610   assign
     1611   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
     1612                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
     1613                     or (p-journal-num =  integer(entry(1, '17':U)))
     1614                     or (p-journal-num = integer(entry(1, '16':U)))
     1615   .
     1616   return v-is-first-journal.
     1617   END FUNCTION.
     1618   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
     1619   define variable v-is-petrol-journal as logical no-undo .
     1620   assign
     1621   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
     1622   return v-is-petrol-journal.
     1623   END FUNCTION.
     1624   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
     1625   define variable v-max-record-num as integer no-undo .
     1626   assign
     1627   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     1628                       then 1489
     1629                       else 2340).
     1630   return v-max-record-num.
     1631   END FUNCTION.
     1632   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
     1633   define variable v-max-record-num as integer no-undo .
     1634   assign
     1635   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     1636                       then 1489 * num-entries('30,31,32,33':U)
     1637                       else 2340 * num-entries('17':U)).
     1638   return v-max-record-num.
     1639   END FUNCTION.
     1640   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
     1641                                           ,input p-rec-no as integer):
     1642   define variable v-num-recs as integer no-undo .
     1643   if tekka-is-petrol-journal (p-journal-num) then do:
     1644     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
     1645       assign
     1646       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
     1647       .
     1648     end.
     1649     else do:
     1650       assign
     1651       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
     1652       .
     1653     end.
     1654   end.
     1655   else do:
     1656     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
     1657       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     1658         assign
     1659         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
     1660         .
     1661       end.
     1662       else do:
     1663         assign
     1664         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
     1665         .
     1666       end.
     1667     end.
     1668     else do:
     1669       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     1670         assign
     1671         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
     1672         .
     1673       end.
     1674       else do:
     1675         assign
     1676         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
     1677         .
     1678       end.
     1679     end.
     1680   end.
     1681   return v-num-recs.
     1682   END FUNCTION.
     1683   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
     1684                                              ,input p-is-petrol as logical
     1685                                              ,input p-is-current as logical
     1686                                              ,output p-rec-no as decimal
     1687                                              ):
     1688   define variable v-obj-num0 as integer no-undo .
     1689   define variable v-obj-num as integer no-undo .
     1690   define variable v-obj-num2 as integer no-undo .
     1691   define variable p-num-recs2 as integer no-undo .
     1692   define variable p-rec-no2 as integer no-undo .
     1693   if p-is-petrol then do:
     1694     assign
     1695     v-obj-num0 = trunc(p-num-recs / 1489, 0)
     1696     .
     1697     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
     1698     then
     1699     assign
     1700     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
     1701     p-rec-no = p-num-recs modulo 1489
     1702     .
     1703     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
     1704     then
     1705     assign
     1706     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
     1707     p-rec-no = p-num-recs modulo 1489
     1708     .
     1709   end.
     1710   else do:
     1711     assign
     1712     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
     1713     p-num-recs = trunc(p-num-recs, 0)
     1714     v-obj-num0 = trunc(p-num-recs / 2340, 0)
     1715     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
     1716     .
     1717     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
     1718     then
     1719     assign
     1720     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
     1721     p-rec-no = p-num-recs modulo 2340
     1722     .
     1723     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
     1724     then
     1725     assign
     1726     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
     1727     p-rec-no = p-num-recs modulo 2340
     1728     .
     1729     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
     1730     then
     1731     assign
     1732     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
     1733     p-rec-no2 = p-num-recs2 modulo 2978
     1734     .
     1735     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
     1736     then
     1737     assign
     1738     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
     1739     p-rec-no2 = p-num-recs2 modulo 2978
     1740     .
     1741     assign
     1742     p-rec-no = p-rec-no + p-rec-no2 / 10000
     1743     .
     1744   end.
     1745   if v-obj-num = 0 then v-obj-num = 100.
     1746   return v-obj-num.
     1747   END FUNCTION.
     1748   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
     1749   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
     1750   if lookup (string(p-obj-num), '17':U) > 0 then do:
     1751      if p-is-ptrl then
     1752      return integer(entry(1, '26,27,28,29':U)).
     1753      if not p-is-ptrl then
     1754      return integer(entry(1, '16':U)).
     1755   end.
     1756   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     1757   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     1758   return 0.
     1759   END FUNCTION.
     1760   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
     1761   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
     1762   if lookup (string(p-obj-num), '17':U) > 0 then do:
     1763     if p-is-ptrl then
     1764     return integer(entry(1, '26,27,28,29':U)).
     1765     if not p-is-ptrl then
     1766     return integer(entry(1, '16':U)).
     1767   end.
     1768   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     1769   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     1770   return 0.
     1771   END FUNCTION.
     1772   PROCEDURE maria-put:
     1773   define parameter buffer buf_cash-desk for ub.cash-desk.
     1774   define input parameter p-out    as character no-undo .
     1775   define input parameter p-fname as character no-undo .
     1776   define input parameter p-by-record as logical no-undo .
     1777   define input parameter p-shift-fields as integer no-undo .
     1778   define input parameter p-binary as logical no-undo .
     1779   define input parameter p-obj-num as integer no-undo .
     1780   define input parameter p-max-records as integer no-undo .
     1781   define input parameter p-plu as integer no-undo .
     1782   define input parameter p-value as character no-undo .
     1783   define variable v-file-name as character no-undo .
     1784   define variable v-create as logical no-undo .
     1785   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1786   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
     1787   output stream IBMSTREAM
     1788   to value(v-file-name) append .
     1789   Put  stream IBMSTREAM unformatted
     1790   p-plu
     1791   chr(3)
     1792   p-value
     1793   skip.
     1794   output stream IBMSTREAM
     1795   close.
     1796   if not p-by-record then do:
     1797     find first buf_temp-tekka-tsk where
     1798               buf_temp-tekka-tsk.filename  = v-file-name no-error .
     1799     if not available buf_temp-tekka-tsk then do:
     1800       v-create = yes.
     1801     end.
     1802   end.
     1803   else do:
     1804     find first buf_temp-tekka-tsk where
     1805               buf_temp-tekka-tsk.filename  = v-file-name
     1806           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
     1807     if not available buf_temp-tekka-tsk
     1808     then do:
     1809       find first buf_temp-tekka-tsk where
     1810                 buf_temp-tekka-tsk.filename  = v-file-name
     1811             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
     1812       if not available buf_temp-tekka-tsk
     1813       then do:
     1814         v-create = yes.
     1815       end.
     1816     end.
     1817   end.
     1818   if v-create then do:
     1819     create buf_temp-tekka-tsk.
     1820     assign
     1821     buf_temp-tekka-tsk.filename = v-file-name
     1822     buf_temp-tekka-tsk.range    = p-plu
     1823     buf_temp-tekka-tsk.obj-num = p-obj-num
     1824     buf_temp-tekka-tsk.obj-name = '':U
     1825     buf_temp-tekka-tsk.num-records = 0
     1826     buf_temp-tekka-tsk.max-records = p-max-records
     1827     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
     1828     buf_temp-tekka-tsk.task-num = p-fname
     1829     buf_temp-tekka-tsk.by-record = p-by-record
     1830     buf_temp-tekka-tsk.shift-fields = p-shift-fields
     1831     buf_temp-tekka-tsk.binary = p-binary
     1832     buf_temp-tekka-tsk.send-get = 'send'
     1833     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1834     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1835     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1836     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1837                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1838                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1839                                 then 'local'
     1840                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1841     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1842     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1843     buf_temp-tekka-tsk.waiting-sek = 30
     1844     buf_temp-tekka-tsk.min-plu     = p-plu
     1845     buf_temp-tekka-tsk.max-plu     = p-plu
     1846     .
     1847   end.
     1848   assign
     1849   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
     1850   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
     1851   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
     1852   .
     1853   END PROCEDURE.
     1854   PROCEDURE maria-get:
     1855   define parameter buffer buf_cash-desk for ub.cash-desk.
     1856   define input parameter p-out    as character no-undo .
     1857   define input parameter p-fname as character no-undo .
     1858   define input parameter p-by-record as logical no-undo .
     1859   define input parameter p-obj-num as integer no-undo .
     1860   define input parameter p-num-fields as integer no-undo .
     1861   define input parameter p-max-records as integer no-undo .
     1862   define input parameter p-min-plu as integer no-undo .
     1863   define input parameter p-max-plu as integer no-undo .
     1864   define input parameter p-other as character no-undo .
     1865   define input parameter p-order-num as integer no-undo .
     1866   define variable v-file-name as character no-undo .
     1867   define variable v-secondary-obj-num as character no-undo .
     1868   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1869   if p-by-record then do:
     1870     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
     1871   end.
     1872   else do:
     1873     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
     1874   end.
     1875   find first buf_temp-tekka-tsk where
     1876             buf_temp-tekka-tsk.filename  = v-file-name no-error .
     1877   if not available buf_temp-tekka-tsk then do:
     1878     create buf_temp-tekka-tsk.
     1879     assign
     1880     buf_temp-tekka-tsk.filename = v-file-name
     1881     buf_temp-tekka-tsk.obj-num = p-obj-num
     1882     buf_temp-tekka-tsk.obj-name = '':U
     1883     buf_temp-tekka-tsk.max-records = p-max-records
     1884     buf_temp-tekka-tsk.num-fields = p-num-fields
     1885     buf_temp-tekka-tsk.task-num = p-fname
     1886     buf_temp-tekka-tsk.by-record = p-by-record
     1887     buf_temp-tekka-tsk.send-get = 'get'
     1888     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1889     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1890     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1891     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1892                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1893                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1894                                   then 'local'
     1895                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1896     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1897     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1898     buf_temp-tekka-tsk.waiting-sek = 30
     1899     buf_temp-tekka-tsk.min-plu     = p-min-plu
     1900     buf_temp-tekka-tsk.max-plu     = p-max-plu
     1901     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
     1902                                       and p-max-plu <> ?
     1903                                       then p-max-plu - p-min-plu + 1
     1904                                       else 0)
     1905     buf_temp-tekka-tsk.other-info = p-other
     1906     buf_temp-tekka-tsk.order-num = p-order-num
     1907     .
     1908     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
     1909       assign
     1910       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
     1911       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
     1912       v-secondary-obj-num = entry(1, v-secondary-obj-num)
     1913       no-error
     1914       .
     1915       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
     1916     end.
     1917   end.
     1918   END PROCEDURE.
     1919   PROCEDURE maria-task:
     1920   define parameter buffer buf_cash-desk for ub.cash-desk.
     1921   define input parameter p-fname as character no-undo .
     1922   define input parameter p-obj-num-list as character no-undo .
     1923   define input parameter p-parameters as character no-undo .
     1924   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     1925   find first buf_temp-tekka-tsk where
     1926             buf_temp-tekka-tsk.task-num  = p-fname no-error .
     1927   if not available buf_temp-tekka-tsk then do:
     1928     create buf_temp-tekka-tsk.
     1929     assign
     1930     buf_temp-tekka-tsk.filename = ''
     1931     buf_temp-tekka-tsk.range = 1
     1932     buf_temp-tekka-tsk.obj-num = 0
     1933     buf_temp-tekka-tsk.obj-name = p-obj-num-list
     1934     buf_temp-tekka-tsk.task-num = p-fname
     1935     buf_temp-tekka-tsk.by-record = no
     1936     buf_temp-tekka-tsk.send-get = 'task'
     1937     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     1938     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     1939     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     1940     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     1941                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     1942                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     1943                                   then 'local'
     1944                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     1945     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     1946     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     1947     buf_temp-tekka-tsk.waiting-sek = 30
     1948     buf_temp-tekka-tsk.other-info = p-parameters
     1949     buf_temp-tekka-tsk.order-num = 0
     1950     .
     1951   end.
     1952   END PROCEDURE.
     1953   procedure tekkatsk-verify-schema :
     1954   define input parameter p-obj-list as character no-undo .
     1955   define input parameter p-dir-path as character no-undo .
     1956   define variable v-obj-num as integer no-undo .
     1957   define variable v-obj-name as character no-undo .
     1958   define variable v-num-records as integer no-undo .
     1959   define variable v-size_ as integer no-undo .
     1960   define variable v-value as character no-undo .
     1961   define variable ii as integer no-undo .
     1962   define variable jj as integer no-undo .
     1963   define variable ii-ibs as integer no-undo .
     1964   define variable ii-tekka as integer no-undo .
     1965   define variable v-result as character no-undo .
     1966   define buffer buf_temp-tekka-schema for temp-tekka-schema.
     1967   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
     1968     do
     1969     on error undo, return error
     1970     :
     1971        for each buf_temp-tekka-schema:
     1972          delete buf_temp-tekka-schema.
     1973        end.
     1974        input from value('tekkasch.d').
     1975        repeat :
     1976          create buf_temp-tekka-schema.
     1977          import buf_temp-tekka-schema.
     1978          assign
     1979          buf_temp-tekka-schema.host = 'IBS'
     1980          ii = ii + 1.
     1981          .
     1982        end.
     1983        input close.
     1984        ii-ibs = ii.
     1985         _ii:
     1986         do ii = 1 to 256:
     1987           if p-obj-list = "ALL"
     1988           or lookup(string(ii), p-obj-list) > 0 then do:
     1989             assign
     1990             v-obj-num = 0
     1991             v-obj-name = ''
     1992             v-num-records = 0
     1993             v-size_ = 0
     1994             .
     1995             run alienini-getkey in this-procedure (
     1996                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     1997                                                     ,input ('obj' + string(ii, '999'))
     1998                                                     ,input 'oname'
     1999                                                     ,output v-value) no-error .
     2000             if v-value = ? then next _ii.
     2001             assign
     2002             v-obj-num = ii
     2003             v-obj-name = v-value
     2004             .
     2005             run alienini-getkey in this-procedure (
     2006                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     2007                                                     ,input ('obj' + string(ii, '999'))
     2008                                                     ,input 'size'
     2009                                                     ,output v-value) no-error .
     2010             assign
     2011             v-num-records = integer(v-value) no-error  .
     2012             if error-status:error
     2013             or v-num-records = 0 then next _ii.
     2014             run alienini-getkey in this-procedure (
     2015                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     2016                                                     ,input 'obj' + string(ii, '999')
     2017                                                     ,input 'f000'
     2018                                                     ,output v-value) no-error .
     2019             assign
     2020             v-size_ = integer(v-value) no-error  .
     2021             if error-status:error
     2022             or v-size_ = 0 then next _ii.
     2023             _jj:
     2024             do jj = 1 to 256:
     2025               run alienini-getkey in this-procedure (
     2026                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     2027                                                       ,input 'obj' + string(ii, '999')
     2028                                                       ,input 'f' + string(jj, '999')
     2029                                                       ,output v-value) no-error .
     2030               if v-value = ? then next _ii.
     2031               create buf_temp-tekka-schema.
     2032               assign
     2033               buf_temp-tekka-schema.host = 'tekka'
     2034               buf_temp-tekka-schema.obj-num = v-obj-num
     2035               buf_temp-tekka-schema.obj-name = v-obj-name
     2036               buf_temp-tekka-schema.num-records = v-num-records
     2037               buf_temp-tekka-schema.size_ = v-size_
     2038               buf_temp-tekka-schema.field-num = jj
     2039               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
     2040               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
     2041                                                  then entry(2, entry(2, v-value, '#'), ':')
     2042                                                  else '':U)
     2043               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
     2044               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
     2045               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
     2046                                                           , 'C,I,I,I,D,D,D,D,D':U)
     2047               no-error
     2048               .
     2049               if error-status:error then do:
     2050                 delete buf_temp-tekka-schema.
     2051                 next _jj.
     2052               end.
     2053               run alienini-getkey in this-procedure (
     2054                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     2055                                                       ,input 'obj' + string(ii, '999') + 'name'
     2056                                                       ,input 'n' + string(jj, '999')
     2057                                                       ,output v-value) no-error .
     2058               if v-value <> ? then
     2059               buf_temp-tekka-schema.field-name = v-value.
     2060             end.
     2061           end.
     2062         end.
     2063         ii-tekka = ii - 1.
     2064        if p-obj-list <> 'ALL' then do:
     2065         if ii-tekka <> ii-ibs then do:
     2066           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
     2067                                   , ii-ibs
     2068                                   , ii-tekka).
     2069         end.
     2070        end.
     2071        for each buf_temp-tekka-schema where
     2072               buf_temp-tekka-schema.host = 'tekka':
     2073          find first buf2_temp-tekka-schema where
     2074                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
     2075                AND buf2_temp-tekka-schema.host = 'ibs'
     2076                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
     2077          if not available buf2_temp-tekka-schema then do:
     2078           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
     2079                                   , buf_temp-tekka-schema.field-num
     2080                                   , buf_temp-tekka-schema.obj-num).
     2081          end.
     2082          buffer-compare buf_temp-tekka-schema
     2083          to buf2_temp-tekka-schema
     2084          save result in v-result.
     2085          if v-result <> '':U then do:
     2086           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
     2087                                   , buf_temp-tekka-schema.field-num
     2088                                   , buf_temp-tekka-schema.obj-num).
     2089          end.
     2090        end.
     2091     end.
     2092   end procedure.
     2093   FUNCTION set-Sx returns character (input p-string as character):
     2094   return p-string.
     2095   END FUNCTION.
     2096   FUNCTION get-Sx returns character (input p-string  as character):
     2097   return p-string.
     2098   END FUNCTION.
     2099   FUNCTION set-B returns character (input p-string  as character):
     2100   return chr(integer(p-string)).
     2101   END FUNCTION.
     2102   FUNCTION get-B returns character (input p-string  as character):
     2103   return string(asc(p-string)).
     2104   END FUNCTION.
     2105   FUNCTION set-BF returns character (input p-string  as character):
     2106   define variable v-dopi as integer no-undo .
     2107   define variable ii as integer no-undo .
     2108   do ii = 1 to 8:
     2109     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     2110   end.
     2111   return chr(v-dopi).
     2112   END FUNCTION.
     2113   FUNCTION get-BF returns character (input p-string  as character):
     2114   define variable v-dopi as integer no-undo .
     2115   define variable v-dops as character no-undo .
     2116   define variable ii as integer no-undo .
     2117   v-dopi = asc(p-string).
     2118   do ii = 8 to 1 BY -1:
     2119     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     2120   end.
     2121   return v-dops.
     2122   END FUNCTION.
     2123   FUNCTION set-BN returns character (input p-string  as character
     2124                                     ,input p-bin-group as character):
     2125   define variable v-dopi as integer no-undo .
     2126   define variable ii as integer no-undo .
     2127   define variable jj as integer no-undo .
     2128   define variable v-grp-nums as integer no-undo .
     2129   define variable v-dopi2 as integer no-undo .
     2130   v-grp-nums = num-entries(p-bin-group).
     2131   do jj = 0 to v-grp-nums - 1:
     2132     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
     2133     do ii = 1 to 8:
     2134       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     2135     end.
     2136   end.
     2137   return chr(v-dopi).
     2138   END FUNCTION.
     2139   FUNCTION get-BN returns character (input p-string  as character
     2140                                     ,input p-bin-group as character):
     2141   define variable v-dopi as integer no-undo .
     2142   define variable v-dops as character no-undo .
     2143   define variable v-grp-nums as integer no-undo .
     2144   define variable ii as integer no-undo .
     2145   define variable jj as integer no-undo .
     2146   v-dopi = asc(p-string).
     2147   v-grp-nums = num-entries(p-bin-group).
     2148   do jj = 1 to v-grp-nums:
     2149   do ii = 8 to 1 BY -1:
     2150     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     2151   end.
     2152   end.
     2153   return v-dops.
     2154   END FUNCTION.
     2155   procedure fill-temp-cd :
     2156   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
     2157   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     2158   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     2159   define input parameter p-clear-table as logical no-undo .
     2160   define buffer buf_temp-cd for temp-cd.
     2161   define buffer buf_cash-desk for ub.cash-desk.
     2162     do
     2163     on error undo, return error
     2164     :
     2165        if p-clear-table  then do:
     2166          for each buf_temp-cd:
     2167            delete buf_temp-cd.
     2168          end.
     2169        end.
     2170        for each buf_cash-desk no-lock where
     2171               buf_cash-desk.db-num = p-db-num
     2172           AND buf_cash-desk.obj-code = p-obj-code
     2173           and buf_cash-desk.cash-on  = yes
     2174        BREAK by buf_cash-desk.pos-type:
     2175          if first-of(buf_cash-desk.pos-type) then do:
     2176            create buf_temp-cd.
     2177            buffer-copy buf_cash-desk to buf_temp-cd.
     2178          end.
     2179        end.
     2180     end.
     2181   end procedure.
