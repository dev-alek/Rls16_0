      356   initial "@(#)$Workfile$ $Revision$".
      357   procedure xmlchar-test :
      358   define input parameter p-in-string          as character        no-undo.
      359   define output parameter p-out-string-enc    as character        no-undo.
      360   define output parameter p-out-string-dec    as character        no-undo.
      361   do
      362   on error undo, return error
      363   :
      364          run xmlchar-encode in this-procedure
      365       (
      366             input p-in-string
      367           , output p-out-string-enc
      368       ).
      369          run xmlchar-decode in this-procedure
      370       (
      371             input p-out-string-enc
      372           , output p-out-string-dec
