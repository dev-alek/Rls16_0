     3581                                   , return-value
     3582                               )
     3583                                               ).
     3584         assign
     3585         v-view-log = yes
     3586         .
     3587       end.
     3588     end.
     3589     if not available ub.shop then do:
     3590       find first ub.shop no-lock where
     3591                 ub.shop.obj-code = for-cash-desk.obj-code.
     3592     end.
     3593     if
     3594     not (g#news or g#esys)
     3595     then do:
     3596       run str/getxibmf.p (
     3597                       input parparentproc
     3598                     ,input p-log-handle
     3599                     ,input 'маг':U
     3600                     ,input for-cash-desk.obj-code
     3601                     ,input ub.shop.host-code
     3602                     ,input in_
     3603                     ,input spl
     3604                     ,input (in_ + sav)
     3605                     ,input for-cash-desk.pos-type
     3606                     ,input (if (for-cash-desk.pos-type = 'IBM-XML':U
     3607                             and for-cash-desk.autonomy = integer('0':U))
     3608                             or (for-cash-desk.pos-type = 'Autotank':U
     3609                             and for-cash-desk.autonomy = integer('2':U))
     3610                             then "utf-8":U
     3611                             else "windows-1251")
     3612                     ,input log-file-name
     3613                     ,input "data":U
     3614                     ,input v-xml-file-name
     3615                     ,input-output v-view-log
     3616                     ) no-error .
     3617       if error-status:error then do:
     3618         run write-log-and-file in p-log-handle (
     3619               input 1
     3620             , input log-file-name
