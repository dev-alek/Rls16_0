     4133   or ub.cash-desk.pos-type = 'Autotank':U
     4134   then do:
     4135     file-info:file-name = (out  + "undelivered").
     4136     if file-info:FULL-PATHNAME <> ? then do:
     4137       run str/rsndxibm.p ( input parparentproc
     4138                           ,input p-parent-handle
     4139                           ,input p-log-handle
     4140                           ,input out  + "undelivered" ) no-error.
