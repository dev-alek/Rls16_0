      376   procedure xmlchar-encode :
      377   define input parameter p-in-string      as character        no-undo.
      378   define output parameter p-out-string    as character        no-undo.
      379       define variable v-position      as integer      no-undo.
      380       define variable v-current-char  as character    no-undo.
      381   do
      382   on error undo, return error
      383   :
      384       assign
      385           p-out-string = "":U
      386       .
      387       case p-in-string
      388       :
      389           when ?
      390           then do:
      391               assign
      392                   p-out-string = "?":U
      393               .
      394           end.
      395           when "?":U
      396           then do:
      397               assign
      398                   p-out-string = "&#63;":U
      399               .
      400           end.
      401           otherwise do:
      402               do v-position = 1 to length( p-in-string )
      403               :
      404                   assign
      405                       v-current-char = substring( p-in-string, v-position, 1 )
      406                   .
      407                   case v-current-char
      408                   :
      409                       when "&":U
      410                       then do:
      411                           assign
      412                               p-out-string = p-out-string + "&amp;":U
      413                           .
      414                       end.
      415                       when ">":U
      416                       then do:
      417                           assign
      418                               p-out-string = p-out-string + "&gt;":U
      419                           .
      420                       end.
      421                       when "<":U
      422                       then do:
      423                           assign
      424                               p-out-string = p-out-string + "&lt;":U
      425                           .
      426                       end.
      427                       when "'":U
      428                       then do:
      429                           assign
      430                               p-out-string = p-out-string + "&apos;":U
      431                           .
      432                       end.
      433                       when '"':U
      434                       then do:
      435                           assign
      436                               p-out-string = p-out-string + "&quot;":U
      437                           .
      438                       end.
      439                       when chr(1)
      440                       then do:
      441                           assign
      442                               p-out-string = p-out-string + "":U
      443                           .
      444                       end.
      445                       when chr(2)
      446                       then do:
      447                           assign
      448                               p-out-string = p-out-string + "":U
      449                           .
      450                       end.
      451                       when chr(3)
      452                       then do:
      453                           assign
      454                               p-out-string = p-out-string + "":U
      455                           .
      456                       end.
      457                       when chr(4)
      458                       then do:
      459                           assign
      460                               p-out-string = p-out-string + "":U
      461                           .
      462                       end.
      463                       when chr(5)
      464                       then do:
      465                           assign
      466                               p-out-string = p-out-string + "":U
      467                           .
      468                       end.
      469                       when chr(6)
      470                       then do:
      471                           assign
      472                               p-out-string = p-out-string + "":U
      473                           .
      474                       end.
      475                       when chr(7)
      476                       then do:
      477                           assign
      478                               p-out-string = p-out-string + "":U
      479                           .
      480                       end.
      481                       when chr(8)
      482                       then do:
      483                           assign
      484                               p-out-string = p-out-string + "":U
      485                           .
      486                       end.
      487                       when chr(9)
      488                       then do:
      489                           assign
      490                               p-out-string = p-out-string + "":U
      491                           .
      492                       end.
      493                       when chr(29)
      494                       then do:
      495                           assign
      496                               p-out-string = p-out-string + "":U
      497                           .
      498                       end.
      499                       when chr(10)
      500                       then do:
      501                           assign
      502                               p-out-string = p-out-string + "&#10;":U
      503                           .
      504                       end.
      505                       when chr(13)
      506                       then do:
      507                           assign
      508                               p-out-string = p-out-string + "&#13;":U
      509                           .
      510                       end.
      511                       otherwise do:
      512                           assign
      513                               p-out-string = p-out-string + v-current-char
      514                           .
      515                       end.
      516                   end case.
      517               end.
      518           end.
      519       end case.
      520   end.
      521   end .
