     4355                            , p-pos-type, p-cash-num, p-obj-code
     4356                           )
     4357                                           ).
     4358     assign
     4359     v-view-log = yes
     4360     .
     4361   end.
     4362   if v-view-log then return error .
     4363   procedure create-ncr-par :
     4364   define input parameter p-cd-subject-code as character no-undo .
     4365   define input parameter p-subject-name as character no-undo .
     4366   define buffer buf_cash-ncr-dis-kat for cash-ncr-dis-kat.
     4367     do
     4368     on error undo, return error
     4369     :
     4370       FIND FIRST buf_cash-ncr-dis-kat where
     4371               buf_cash-ncr-dis-kat.crf = (cr-ncr-dis-kat + 1) No-ERROR.
     4372       if not avail buf_cash-ncr-dis-kat then do:
     4373         create buf_cash-ncr-dis-kat.
     4374         error-status:error = false.
     4375       end.
     4376       buf_cash-ncr-dis-kat.crf = cr-ncr-dis-kat + 1.
     4377       cr-ncr-dis-kat = cr-ncr-dis-kat + 1.
     4378       assign
     4379       buf_cash-ncr-dis-kat.dis-kat  = 0
     4380       buf_cash-ncr-dis-kat.cd-subject-code  = p-cd-subject-code
     4381       buf_cash-ncr-dis-kat.cd-subject-name  = p-subject-name
     4382       .
     4383     end.
     4384   end procedure.
