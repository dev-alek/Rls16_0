     2828       run cp-attr-code in this-procedure
     2829         (input  p-code
     2830         ,output p-type
     2831         ,output v-format
     2832         ,output v-label
     2833         ,output v-range
     2834         ,output v-user-can-edit
     2835         ,output v-output-display
     2836         ,output v-other
     2837         ) no-error .
     2838       if error-status :error then do:
     2839         undo, return error return-value .
     2840       end.
     2841       find first buf_cash-pay-attr no-lock
     2842         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     2843           and buf_cash-pay-attr.curr-code  = p-curr-code
     2844           and buf_cash-pay-attr.host-code  = p-host-code
     2845           and buf_cash-pay-attr.obj-type   = p-obj-type
     2846           and buf_cash-pay-attr.obj-code   = p-obj-code
     2847           and buf_cash-pay-attr.attr-code  = p-code
     2848         no-error .
     2849       if avail buf_cash-pay-attr then do:
     2850         assign
     2851           p-value =  buf_cash-pay-attr.attr-value
     2852         .
     2853       end.
     2854       else do:
     2855         assign
     2856           p-value = if p-type = 'L':U then "no":U else ""
     2857         .
     2858       end.
     2859     end.
     2860   end procedure.
     2861   procedure cp-attr-write :
     2862     do
     2863     on error undo, return error
     2864     :
     2865       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     2866       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     2867       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     2868       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     2869       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     2870       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     2871       define input parameter p-value    like ub.cash-pay-attr.attr-value no-undo .
     2872       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     2873       define buffer last_cash-pay-attr for ub.cash-pay-attr .
     2874       define variable v-type           as character no-undo .
     2875       define variable v-format         as character no-undo .
     2876       define variable v-label          as character no-undo .
     2877       define variable v-range          as integer   no-undo .
     2878       define variable v-user-can-edit  as logical   no-undo .
     2879       define variable v-output-display as logical   no-undo .
     2880       define variable v-other          as character no-undo .
     2881       run cp-attr-code in this-procedure
     2882         (input  p-code
     2883         ,output v-type
     2884         ,output v-format
     2885         ,output v-label
     2886         ,output v-range
     2887         ,output v-user-can-edit
     2888         ,output v-output-display
     2889         ,output v-other
     2890         ) no-error .
     2891       if error-status :error then do:
     2892         undo, return error return-value .
     2893       end.
     2894       find first buf_cash-pay-attr exclusive-lock
     2895         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     2896           and buf_cash-pay-attr.curr-code  = p-curr-code
     2897           and buf_cash-pay-attr.host-code  = p-host-code
     2898           and buf_cash-pay-attr.obj-type   = p-obj-type
     2899           and buf_cash-pay-attr.obj-code   = p-obj-code
     2900           and buf_cash-pay-attr.attr-code = p-code
     2901         no-error .
     2902       if not available buf_cash-pay-attr then do:
     2903         create buf_cash-pay-attr .
     2904         assign
     2905         buf_cash-pay-attr.cdpay-code = p-cdpay-code
     2906         buf_cash-pay-attr.curr-code  = p-curr-code
     2907         buf_cash-pay-attr.host-code  = p-host-code
     2908         buf_cash-pay-attr.obj-type   = p-obj-type
     2909         buf_cash-pay-attr.obj-code   = p-obj-code
     2910         buf_cash-pay-attr.attr-code = p-code
     2911         .
     2912       end.
     2913       assign
     2914         buf_cash-pay-attr.attr-value = p-value
     2915       .
     2916       release buf_cash-pay-attr no-error .
     2917       if error-status:error then do:
     2918         undo, return error return-value .
     2919       end.
     2920     end.
     2921   end procedure.
     2922   procedure cp-attr-exist :
     2923     do
     2924     on error undo, return error
     2925     :
     2926       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     2927       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     2928       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     2929       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     2930       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     2931       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     2932       define output parameter p-exist   as logical  no-undo .
     2933       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     2934       define variable v-type           as character no-undo .
     2935       define variable v-format         as character no-undo .
     2936       define variable v-label          as character no-undo .
     2937       define variable v-range          as integer   no-undo .
     2938       define variable v-user-can-edit  as logical   no-undo .
     2939       define variable v-output-display as logical   no-undo .
     2940       define variable v-other          as character no-undo .
     2941       run cp-attr-code in this-procedure
     2942         (input  p-code
     2943         ,output v-type
     2944         ,output v-format
     2945         ,output v-label
     2946         ,output v-range
     2947         ,output v-user-can-edit
     2948         ,output v-output-display
     2949         ,output v-other
     2950         ) no-error .
     2951       if error-status :error then do:
     2952         undo, return error return-value .
     2953       end.
     2954       find first buf_cash-pay-attr exclusive-lock
     2955         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     2956           and buf_cash-pay-attr.curr-code  = p-curr-code
     2957           and buf_cash-pay-attr.host-code  = p-host-code
     2958           and buf_cash-pay-attr.obj-type   = p-obj-type
     2959           and buf_cash-pay-attr.obj-code   = p-obj-code
     2960           and buf_cash-pay-attr.attr-code = p-code
     2961         no-error .
     2962       if  available buf_cash-pay-attr then do:
     2963         p-exist = yes.
     2964       end.
     2965     end.
     2966   end procedure.
     2967   procedure cp-attr-delete :
     2968     do
     2969     on error undo, return error
     2970     :
     2971       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
     2972       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
     2973       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
     2974       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
     2975       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
     2976       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
     2977       define output parameter p-deleted  as logical no-undo.
     2978       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
     2979       define variable v-type           as character no-undo .
     2980       define variable v-format         as character no-undo .
     2981       define variable v-label          as character no-undo .
     2982       define variable v-range          as integer   no-undo .
     2983       define variable v-user-can-edit  as logical   no-undo .
     2984       define variable v-output-display as logical   no-undo .
     2985       define variable v-other          as character no-undo .
     2986       run cp-attr-code in this-procedure
     2987         (input  p-code
     2988         ,output v-type
     2989         ,output v-format
     2990         ,output v-label
     2991         ,output v-range
     2992         ,output v-user-can-edit
     2993         ,output v-output-display
     2994         ,output v-other
     2995         ) no-error .
     2996       if error-status :error then do:
     2997         undo, return error return-value .
     2998       end.
     2999       find first buf_cash-pay-attr exclusive-lock
     3000         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     3001           and buf_cash-pay-attr.curr-code  = p-curr-code
     3002           and buf_cash-pay-attr.host-code  = p-host-code
     3003           and buf_cash-pay-attr.obj-type   = p-obj-type
     3004           and buf_cash-pay-attr.obj-code   = p-obj-code
     3005           and buf_cash-pay-attr.attr-code = p-code
     3006         no-error NO-WAIT.
     3007       if not available buf_cash-pay-attr then do:
     3008         p-deleted = no.
     3009       end.
     3010       else do:
     3011         delete buf_cash-pay-attr no-error .
     3012         if error-status:error then do:
     3013           undo, return error return-value .
     3014         end.
     3015         p-deleted = yes.
     3016       end.
     3017     end.
     3018   end procedure.
     3019   procedure cp-attr-news :
     3020     do
     3021     on error undo, return error
     3022     :
     3023       define input  parameter p-code           as character no-undo .
     3024       define output parameter p-news           as logical   no-undo .
     3025       case p-code :
     3026               when 'paycard-export-prefix':U then do:     assign     p-news = true.   end.
     3027               when 'grp-code':U then do:     assign     p-news = true.   end.
     3028               when 'is-use':U then do:     assign     p-news = true.   end.
     3029               when 'dop-doc':U then do:     assign     p-news = true.   end.
     3030               when 'paycard-all-prefix':U then do:     assign     p-news = true.   end.
     3031               when 'paycard-edit-prefix':U then do:     assign     p-news = true.   end.
     3032               when 'form_km3':U then do:     assign     p-news = false.   end.
     3033               when 'bal_malina':U then do:     assign     p-news = false.   end.
     3034               when 'max_proc_sum':U then do:     assign     p-news = true.   end.
     3035               when 'mask_card_kup':U then do:     assign     p-news = true.   end.
     3036         otherwise do:
     3037           p-news = no.
     3038         end.
     3039       end.
     3040     end.
     3041   end procedure.
     3042   procedure cp-attr-hist :
