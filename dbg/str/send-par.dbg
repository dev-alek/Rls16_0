      632   procedure xmlchar-decode :
      633   define input parameter p-in-string      as character        no-undo.
      634   define output parameter p-out-string    as character        no-undo.
      635       define variable v-position      as integer      no-undo.
      636       define variable v-last-position as integer      no-undo.
      637       define variable v-temp-integer  as integer      no-undo.
      638       define variable v-current-char  as character    no-undo.
      639       define variable v-next-char     as character    no-undo.
      640       define variable v-success       as logical      no-undo.
      641   do
      642   on error undo, return error
      643   :
      644       assign
      645           p-out-string = "":U
      646           v-position   = 0
      647       .
      648       replace-cycle:
      649       do while yes
      650       on error undo, return error
      651       :
      652           assign
      653               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      654           .
      655           if v-last-position <= v-position
      656           then do:
      657               if v-position = 0
      658               then do:
      659                   assign
      660                       p-out-string = p-in-string
      661                   .
      662               end.
      663               else do:
      664                   assign
      665                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      666                   .
      667               end.
      668               leave replace-cycle.
      669           end.
      670           else do:
      671               assign
      672                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      673                   v-position      = v-last-position
      674                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      675               .
      676               if v-current-char = "#":U
      677               then do:
      678                   assign
      679                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      680                   .
      681                   if v-last-position > 0
      682                   then do:
      683                       run xmlchar-read-integer in this-procedure
      684                        (
      685                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      686                           , output v-temp-integer
      687                           , output v-success
      688                       ).
      689                       if v-success = yes
      690                       and v-temp-integer >= 1
      691                       and v-temp-integer <= 255
      692                       then do:
      693                           assign
      694                               p-out-string = p-out-string + chr( v-temp-integer )
      695                               v-position   = v-last-position + 1
      696                           .
      697                       end.
      698                       else do:
      699                           assign
      700                               p-out-string = p-out-string + "&":U
      701                               v-position   = v-position   + 1
      702                           .
      703                       end.
      704                   end.
      705                   else do:
      706                       assign
      707                           p-out-string = p-out-string + "&":U
      708                           v-position   = v-position   + 1
      709                       .
      710                   end.
      711               end.
      712               else do:
      713                   case substring( p-in-string, v-position + 1, 3 )
      714                   :
      715                       when "lt;":U
      716                       then do:
      717                           assign
      718                               p-out-string = p-out-string + "<":U
      719                               v-position   = v-position   + 3
      720                           .
      721                       end.
      722                       when "gt;":U
      723                       then do:
      724                           assign
      725                               p-out-string = p-out-string + ">":U
      726                               v-position   = v-position   + 3
      727                           .
      728                       end.
      729                       otherwise do:
      730                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      731                           then do:
      732                               assign
      733                                   p-out-string = p-out-string + "&":U
      734                                   v-position   = v-position   + 4
      735                               .
      736                           end.
      737                           else do:
      738                               case substring( p-in-string, v-position + 1, 5 )
      739                               :
      740                                   when "quot;":U
      741                                   then do:
      742                                       assign
      743                                           p-out-string = p-out-string + '"':U
      744                                           v-position   = v-position   + 5
      745                                       .
      746                                   end.
      747                                   when "apos;":U
      748                                   then do:
      749                                       assign
      750                                           p-out-string = p-out-string + "'":U
      751                                           v-position   = v-position   + 5
      752                                       .
      753                                   end.
      754                                   otherwise do:
      755                                       assign
      756                                           p-out-string = p-out-string + "&":U
      757                                       .
      758                                   end.
      759                               end case.
      760                           end.
      761                       end.
      762                   end case.
      763               end.
      764           end.
      765       end.
      766   end.
      767   end .
      768   procedure xmlchar-read-integer :
      769   define input parameter p-input-string      as character        no-undo.
      770   define output parameter p-output-integer   as integer          no-undo.
      771   define output parameter p-success       as logical          no-undo.
      772   do
      773   on error undo, return error
      774   :
      775       assign
      776           p-output-integer = integer( p-input-string )
      777       no-error.
      778       if error-status :error
      779       then do:
      780           assign
      781               p-success           = no
      782               p-output-integer    = 0
      783           .
      784       end.
      785       else do:
      786           assign
      787               p-success           = yes
      788           .
      789       end.
      790   end.
      791   end.
      792   define variable v-bgelib-bgeclall           as logical      no-undo.
      793   define variable v-bgelib-bgedict            as logical      no-undo.
      794   define temp-table temp_ext-doc-type no-undo
      795       field edt-key               as integer
      796       field ext-doc-type          as character
      797       field ext-doc-type-label    as character
      798       index pi is primary unique
      799           edt-key
      800   .
      801   define temp-table temp_bgelib_goods no-undo
      802       field gds-code as integer
      803       index pi is primary unique
      804           gds-code
      805   .
      806   define temp-table temp_bgelib_clients no-undo
      807       field obj-type as character
      808       field obj-code as integer
      809       index pi is primary unique
      810           obj-type
      811           obj-code
      812   .
      813   define temp-table temp_bgelib_dis-card no-undo
      814       field d-card as character
      815       index pi is primary unique
      816           d-card
      817   .
      818   define temp-table temp_bgelib_trn-doc no-undo
      819       field doc-code as integer
      820   .
      821   procedure bgelib-tag-open:
      822   do
      823   on error undo, return error
      824   :
      825   define input parameter v-tag-level  as integer      no-undo.
      826   define input parameter v-tag-name   as character    no-undo.
      827   define input parameter v-tag-value  as character    no-undo.
      828       put stream stmXMLOut unformatted
      829           chr(10)
      830           + fill(" ", 4 * v-tag-level)
      831           + "<" + v-tag-name
      832           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
      833           + v-tag-value + ">"
      834       .
      835   end.
      836   end procedure.
      837   procedure bgelib-tag-put:
      838   do
      839   on error undo, return error
      840   :
      841   define input parameter v-tag-level      as integer      no-undo.
      842   define input parameter v-tag-name       as character    no-undo.
      843   define input parameter v-tag-value      as character    no-undo.
      844   define input parameter v-empty-mode     as integer      no-undo.
      845       v-tag-name = trim(v-tag-name).
      846       if  v-empty-mode = 1
      847       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
      848       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
      849       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
      850       then do:
      851           run xmlchar-encode in this-procedure (
      852                 input v-tag-value
      853               , output v-tag-value
      854           ).
      855           put stream stmXMLOut unformatted
      856               chr(10) + fill(" ", 4 * v-tag-level)
      857                           + '<' + v-tag-name + '>'
      858                           + v-tag-value
      859                           + '</' + v-tag-name + '>'
      860           .
      861       end.
      862   end.
      863   end procedure.
      864   procedure bgelib-tag-close:
      865   do
      866   on error undo, return error
      867   :
      868   define input parameter v-tag-level as integer      no-undo.
      869   define input parameter v-tag-name  as character    no-undo.
      870       put stream stmXMLOut unformatted
      871           chr(10)
      872           + fill( " ", 4 * v-tag-level)
      873           + '</' + v-tag-name + '>'
      874       .
      875   end.
      876   end procedure.
      877   procedure bgelib-write-log:
      878   do
      879   on error undo, return error
      880   :
      881   define input parameter v-filename   as character    no-undo.
      882   define input parameter v-log-level  as integer      no-undo.
      883   define input parameter v-out-string as character    no-undo.
      884       output stream stmXMLLog to value( v-filename ) append.
      885       put stream stmXMLLog unformatted
      886           chr(10)
      887       .
      888       put stream stmXMLLog unformatted
      889           ( if v-log-level = 0
      890             or v-out-string = "&DLine"
      891             or v-out-string = "&Line"
      892             then ""
      893             else cur-time-string-sec() + " " )
      894       .
      895       put stream stmXMLLog unformatted
      896           ( if v-out-string = "&Line"
      897             then fill( "-", 80 )
      898             else if v-out-string = "&DLine"
      899                  then fill( "=", 80 )
      900                  else v-out-string )
      901       .
      902       output stream stmXMLLog close.
      903   end.
      904   end procedure.
      905   procedure bgelib-write-edt:
      906   do
      907   on error undo, return error
      908   :
      909   define input parameter v-editor-handle    as handle       no-undo.
      910   define input parameter v-log-level        as integer      no-undo.
      911   define input parameter v-out-string       as character    no-undo.
      912       if valid-handle ( v-editor-handle )
      913       then do:
      914           v-editor-handle :move-to-eof().
      915           v-editor-handle :insert-string( ( if v-log-level = 0
      916                                             or v-out-string = "&DLine"
      917                                             or v-out-string = "&Line"
      918                                             then ""
      919                                             else cur-time-string-sec() + " "
      920                                         ) ).
      921           v-editor-handle :insert-string( ( if v-out-string = "&Line"
      922                                             then fill( "-", 80 )
      923                                             else if v-out-string = "&DLine" then fill("=", 80)
      924                                             else fill( " ", v-log-level) + v-out-string
      925                                         ) ).
      926           v-editor-handle :insert-string( chr(10) ).
      927       end.
      928       process events.
      929       output to 'bgescn.txt' append.
      930           put unformatted
      931               chr(10)
      932               string( ( if v-log-level = 0
      933                         or v-out-string = "&DLine"
      934                         or v-out-string = "&Line"
      935                         then ""
      936                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
      937                     ) )
      938               string( ( if v-out-string = "&Line"
      939                         then fill( "-", 80 )
      940                         else if v-out-string = "&DLine"
      941                              then fill( "=", 80 )
      942                              else fill( " ", v-log-level ) + v-out-string
      943                     ) )
      944           .
      945       output close.
      946   end.
      947   end procedure.
      948   procedure bgelib-show-cnt:
      949   do
      950   on error undo, return error
      951   :
      952   define input parameter v-fillin-handle     as handle   no-undo.
      953       if valid-handle( v-fillin-handle )
      954       then do:
      955           assign
      956               v-fillin-handle :visible = true
      957           .
      958       end.
      959   end.
      960   end procedure.
      961   procedure bgelib-hide-cnt:
      962   do
      963   on error undo, return error
      964   :
      965   define input parameter v-fillin-handle     as handle   no-undo.
      966       if valid-handle( v-fillin-handle )
      967       then do:
      968           assign v-fillin-handle :visible = false.
      969       end.
      970   end.
      971   end procedure.
      972   procedure bgelib-write-cnt:
      973   do
      974   on error undo, return error
      975   :
      976   define input parameter v-fillin-handle    as handle       no-undo.
      977   define input parameter v-fillin-string    as character    no-undo.
      978       if valid-handle( v-fillin-handle )
      979       then do:
      980           assign
      981               v-fillin-handle :SCREEN-value = v-fillin-string
      982           .
      983       end.
      984   end.
      985   end procedure.
      986   procedure bgelib-write-header:
      987   do
      988   on error undo, return error
      989   :
      990   define input parameter p-first-file     as logical      no-undo.
      991   define input parameter p-xml-file-name  as character    no-undo.
      992   define input parameter p-list-file-name as character    no-undo.
      993   define input parameter p-file-number    as integer      no-undo.
      994   define input parameter p-have-prev      as logical      no-undo.
      995   define input parameter p-prev-filename  as character    no-undo.
      996   define input parameter p-obj-list       as character    no-undo.
      997   define input parameter p-doc-type-list  as character    no-undo.
      998   define input parameter p-parameter-list as character    no-undo.
      999       define variable v-counter    as integer        no-undo.
     1000       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1001       put stream stmXMLOut unformatted
     1002           "<?xml version='1.0' encoding='windows-1251'?>"
     1003       .
     1004       run bgelib-tag-open( input 0, input "root"  , input "" ).
     1005       run bgelib-tag-open( input 0, input "header", input "" ).
     1006       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1007       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1008       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1009       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1010       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     1011       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1012       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1013       :
     1014           run bgelib-tag-put(
     1015                 input 1
     1016               , input entry( 2 * v-counter, p-parameter-list )
     1017               , input entry( 2 * v-counter + 1, p-parameter-list )
     1018               , input 0
     1019           ).
     1020       end.
     1021       run bgelib-tag-close( input 0, input "header" ).
     1022       output stream stmXMLOut close.
     1023       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1024       if p-first-file = yes
     1025       then do:
     1026           put stream stmXMLOut unformatted
     1027               "<?xml version='1.0' encoding='windows-1251'?>"
     1028           .
     1029           run bgelib-tag-open( input 0, input "export", input "" ).
     1030       end.
     1031       run bgelib-tag-open( input 1, input "file", input "" ).
     1032       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1033       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1034       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1035       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1036       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     1037       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1038       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1039       :
     1040           run bgelib-tag-put(
     1041                 input 2
     1042               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1043               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1044               , input 0
     1045           ).
     1046       end.
     1047       run bgelib-tag-close( input 1, input "file" ).
     1048       output stream stmXMLOut close.
     1049   end.
     1050   end procedure.
     1051   procedure bgelib-write-footer:
     1052   do
     1053   on error undo, return error
     1054   :
     1055   define input parameter p-last-file      as logical      no-undo.
     1056   define input parameter p-xml-file-name  as character    no-undo.
     1057   define input parameter p-list-file-name as character    no-undo.
     1058   define input parameter p-have-next      as logical      no-undo.
     1059   define input parameter p-next-file-name as character    no-undo.
     1060       define variable v-error-num     as integer           no-undo.
     1061       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1062       if p-have-next = yes
     1063       then do:
     1064           run bgelib-tag-open( input 0, input "footer", "" ).
     1065           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1066           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1067           run bgelib-tag-close( input 0, input "footer" ).
     1068       end.
     1069       run bgelib-tag-close( input 0, input "root" ).
     1070       output stream stmXMLOut close.
     1071       run bge/os_copy.p (
     1072             input "M"
     1073           , input p-xml-file-name + "tmp"
     1074           , input p-xml-file-name + "xml"
     1075           , output v-error-num
     1076       ).
     1077       if p-last-file = yes
     1078       then do:
     1079           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1080               run bgelib-tag-close( input 0, input "export" ).
     1081           output stream stmXMLOut close.
     1082           run bge/os_copy.p (
     1083                 input "M"
     1084               , input p-list-file-name + "tmp"
     1085               , input p-list-file-name + "xml"
     1086               , output v-error-num
     1087           ).
     1088       end.
     1089   end.
     1090   end procedure.
     1091   procedure bgelib-filename :
     1092   do
     1093   on error undo, return error
     1094   :
     1095   define input parameter p-prefix             as character    no-undo.
     1096   define output parameter p-xml-file-name     as character    no-undo.
     1097   define output parameter p-log-file-name     as character    no-undo.
     1098   define output parameter p-list-file-name    as character    no-undo.
     1099       define variable v-home-dir  as character    no-undo.
     1100       define variable v-error-num as integer      no-undo.
     1101       get-key-value section "BGE" key "outdir" value v-home-dir.
     1102       if v-home-dir = ?
     1103       then do:
     1104           message
     1105             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1106             skip(1)
     1107             skip "Обратитесь к администратору."
     1108           view-as alert-box error.
     1109           undo, return error .
     1110       end.
     1111       run gbl/dir-cre.p (
     1112           input v-home-dir
     1113       ) no-error.
     1114       if error-status :error
     1115       then do:
     1116           message
     1117             skip "Неверно задан каталог экспорта."
     1118             skip(1)
     1119             skip "Обратитесь к администратору."
     1120           view-as alert-box error.
     1121           undo, return error .
     1122       end.
     1123       run bge/genfname.p (
     1124             input v-home-dir
     1125           , input p-prefix
     1126           , input ""
     1127           , input "xml"
     1128           , input "tmp"
     1129           , output p-xml-file-name
     1130       ).
     1131       assign
     1132           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1133           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1134           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1135       .
     1136   end.
     1137   end procedure.
     1138   procedure bgelib-read-config :
     1139   do
     1140   on error undo, return error
     1141   :
     1142   define variable v-par-type as character     no-undo.
     1143     define variable v-param-type      as character  no-undo .
     1144     define variable v-value-character as character  no-undo .
     1145     define variable v-value-date      as date       no-undo .
     1146     define variable v-value-decimal   as decimal    no-undo .
     1147     define variable v-value-integer   as integer    no-undo .
     1148     define variable v-value-logical   as logical    no-undo .
     1149     define variable v-tth             as handle     no-undo .
     1150       assign
     1151           v-bgelib-bgeclall = no
     1152           v-bgelib-bgedict  = no
     1153       .
     1154       run adm/shattri.p ( input "get":U
     1155                         , input  '':u
     1156                         , input  0
     1157                         , input  'bge-export':U
     1158                         , input  'bgeclall':U
     1159                         , output v-value-character
     1160                         , output v-value-date
     1161                         , output v-value-decimal
     1162                         , output v-value-integer
     1163                         , output v-value-logical
     1164                         , output v-param-type
     1165                         , input-output table-handle v-tth
     1166                         ) no-error .
     1167       if error-status :error
     1168       then do:
     1169         assign
     1170           v-bgelib-bgeclall = no
     1171         .
     1172       end.
     1173       else do:
     1174         assign
     1175           v-bgelib-bgeclall = v-value-logical
     1176         .
     1177       end.
     1178       delete object v-tth.
     1179       run adm/shattri.p ( input "get":U
     1180                         , input  '':u
     1181                         , input  0
     1182                         , input  'bge-export':U
     1183                         , input  'bgedict':U
     1184                         , output v-value-character
     1185                         , output v-value-date
     1186                         , output v-value-decimal
     1187                         , output v-value-integer
     1188                         , output v-value-logical
     1189                         , output v-param-type
     1190                         , input-output table-handle v-tth
     1191                         ) no-error .
     1192       if error-status :error
     1193       then do:
     1194         assign
     1195           v-bgelib-bgedict = no
     1196         .
     1197       end.
     1198       else do:
     1199         assign
     1200           v-bgelib-bgedict = v-value-logical
     1201         .
     1202       end.
     1203       delete object v-tth.
     1204       run adm/shattri.p ( input "get":U
     1205                         , input  '':u
     1206                         , input  0
     1207                         , input  'bge-export':U
     1208                         , input  'bgefmt':U
     1209                         , output v-value-character
     1210                         , output v-value-date
     1211                         , output v-value-decimal
     1212                         , output v-value-integer
     1213                         , output v-value-logical
     1214                         , output v-param-type
     1215                         , input-output table-handle v-tth
     1216                         ) no-error .
     1217       if error-status :error
     1218       then do:
     1219         assign
     1220           v-bgelib-bgefmt  = "xml":U
     1221         .
     1222       end.
     1223       else do:
     1224         assign
     1225           v-bgelib-bgefmt  = v-value-character
     1226         .
     1227       end.
     1228       delete object v-tth.
     1229       run adm/shattri.p ( input "get":U
     1230                         , input  '':u
     1231                         , input  0
     1232                         , input  'bge-export':U
     1233                         , input  'bgeflold':U
     1234                         , output v-value-character
     1235                         , output v-value-date
     1236                         , output v-value-decimal
     1237                         , output v-value-integer
     1238                         , output v-value-logical
     1239                         , output v-param-type
     1240                         , input-output table-handle v-tth
     1241                         ) no-error .
     1242       if error-status :error
     1243       then do:
     1244         assign
     1245           v-bgelib-bgeflold  = "old":U
     1246         .
     1247       end.
     1248       else do:
     1249         assign
     1250           v-bgelib-bgeflold  = v-value-character
     1251         .
     1252       end.
     1253       delete object v-tth.
     1254   end.
     1255   end procedure.
     1256   procedure bgelib-check-file-size :
     1257   do
     1258   on error undo, return error
     1259   :
     1260   define input parameter p-out-filename   as character    no-undo.
     1261   define output parameter p-is-big        as logical      no-undo.
     1262       define variable v-current-position    as integer        no-undo.
     1263       assign
     1264           v-current-position = seek( stmXMLOut )
     1265       .
     1266       if v-current-position / 1024 / 1024  >= 100
     1267       then do:
     1268           assign
     1269               p-is-big = yes
     1270           .
     1271       end.
     1272   end.
     1273   end procedure.
     1274   procedure bgelib-init-ext-doc-type :
     1275       define variable v-counter    as integer      no-undo.
     1276       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1277   do
     1278   for buf_temp_ext-doc-type
     1279   on error undo, return error
     1280   :
     1281       empty temp-table buf_temp_ext-doc-type.
     1282       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1283       :
     1284           create buf_temp_ext-doc-type.
     1285           assign
     1286               buf_temp_ext-doc-type.edt-key               = v-counter
     1287               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1288               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     1289           .
     1290       end.
     1291   end.
     1292   end procedure.
