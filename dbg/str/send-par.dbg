     1305   procedure xml-cd-write-header:
     1306   do
     1307   on error undo, return error
     1308   :
     1309   define input parameter p-xml-file-name       as character    no-undo.
     1310   define input parameter p-xml-file-name-path  as character    no-undo.
     1311   define input parameter p-doc-name            as character    no-undo.
     1312   define input parameter p-version             as character    no-undo.
     1313   define input parameter p-obj-list            as character    no-undo.
     1314   define input parameter p-correspondent       as character    no-undo .
     1315   define input parameter p-write-header        as logical      no-undo .
     1316   define variable OS-time as character no-undo .
     1317   define variable id as character no-undo .
     1318   define buffer buf_db for ub.db.
     1319   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     1320   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     1321   assign
     1322   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     1323   .
     1324   run bgelib-tag-open in this-procedure (
     1325                                        1
     1326                                       ,p-doc-name
     1327                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     1328                                         ).
     1329   if p-write-header then do:
     1330     run bgelib-tag-open(2, "Header","").
     1331     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     1332     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     1333     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     1334     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     1335     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     1336     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     1337     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     1338     find first buf_db where buf_db.db-num = g#db-num no-lock.
     1339     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     1340     run bgelib-tag-close( 2, "Header" ).
     1341   end.
     1342   output stream stmXMLOut close.
     1343   end.
     1344   end procedure.
     1345   procedure xml-cd-write-footer:
     1346   do
     1347   on error undo, return error
     1348   :
     1349   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     1350   define input parameter p-xml-file-name as character    no-undo.
     1351   define input parameter p-doc-name      as character    no-undo .
     1352   define variable v-error-num     as integer           no-undo.
     1353   define variable v-md5-signature as character no-undo .
     1354   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     1355   run bgelib-tag-close( 0, p-doc-name ).
     1356   put stream stmXMLOut unformatted skip.
     1357   output stream stmXMLOut close.
     1358   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     1359   if v-error-num > 0
     1360   then do:
     1361      return error.
     1362   end.
     1363   if opsys = "unix"
     1364   then do:
     1365       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     1366   end.
     1367   end.
     1368   end procedure.
     1369   procedure xml-cd-filename :
     1370   do
     1371   on error undo, return error
     1372   :
     1373   define input parameter  p-out               as character no-undo .
     1374   define output parameter p-xml-file-name     as character    no-undo.
     1375   define output parameter p-xml-file-name-path   as character    no-undo.
     1376   define output parameter p-log-file-name     as character    no-undo.
     1377   define output parameter p-locked            as logical      no-undo.
     1378   define variable v-out as character     no-undo.
     1379   define variable loc#log as logical no-undo .
     1380   define variable BadFlag as logical no-undo .
     1381   define variable fq as integer no-undo .
     1382   define variable v-remote as character no-undo .
     1383   assign
     1384   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     1385   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     1386   p-log-file-name = p-out + "actions.log"
     1387   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     1388   .
     1389   end.
     1390   end procedure.
     1391   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     1392   define variable v-date-str as character no-undo .
     1393   assign
     1394   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     1395                string(Month(p-date), "99":U) + "-":U +
     1396                string(DAY(p-date), "99":U).
     1397   return v-date-str.
     1398   END FUNCTION.
     1399   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     1400   define variable v-date-str as character no-undo .
     1401   assign
     1402   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     1403                string(Month(p-date), "99":U) + "-":U +
     1404                string(DAY(p-date), "99":U) + chr(32) +
     1405                string(p-time, "HH:MM:SS").
     1406   return v-date-str.
     1407   END FUNCTION.
     1408   function string-to-date returns date ( input p-string  as character):
     1409     define variable v-date as date no-undo .
     1410     assign
     1411     v-date = date(integer(substring(p-string, 4, 2))
     1412                   ,integer(substring(p-string, 1, 2))
     1413                   ,integer(substring(p-string, 7, 4))
     1414                  ) no-error .
     1415     if error-status:error then return ?.
     1416     return v-date.
     1417   END FUNCTION.
     1418   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     1419   define variable v-time as integer no-undo init ?.
     1420   define variable v-dop1 as character no-undo .
     1421   define variable v-dop2 as character no-undo .
     1422   assign
     1423   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     1424   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     1425   no-error .
     1426   if error-status:error then return ?.
     1427   assign
     1428   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     1429             integer(entry(2, v-dop2, ";":U)) * 60 +
     1430             integer(entry(3, v-dop2, ";":U)) no-error .
     1431   return v-time.
     1432   END FUNCTION.
