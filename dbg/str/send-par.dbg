     4108                 , input cash-desk.remote
     4109                 , input "send":U
     4110                 , output out
     4111                 , output out2
     4112                 , output in_
     4113                 , output spl
     4114                 , output sav
     4115                 , output v-remote
     4116                 )  no-error .
     4117   if error-status:error then do:
     4118     run write-log-and-file in p-log-handle (
     4119           input 1
     4120         , input log-file-name
     4121         , input 1
     4122         , input substitute("!!!Не удалось получить настройки для  POS типа &1 для маг&2 из ini-файла:&3&4 &5"
     4123                             , ub.cash-desk.pos-type
     4124                             , ub.cash-desk.obj-code
     4125                             , chr(10)
     4126                             , error-status:get-message(1)
     4127                             , return-value )).
     4128     assign
