        1   block-level on error undo, throw.
        2   define input parameter p-doc-code like ub.c-chk-doc.doc-code no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Восстановление удаленного чека".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   define variable v-obj-db-num as integer no-undo .
       79   define variable v-discnt as character no-undo .
       80   define buffer buf_c-chk-doc for ub.c-chk-doc.
       81   define buffer buf_c-chk-gds for ub.c-chk-gds.
       82   define buffer buf_c-chk-pay for ub.c-chk-pay.
       83   define buffer buf_c-chk-discnt for ub.c-chk-discnt.
       84   define buffer buf_c-chk-doc-attr for ub.c-chk-doc-attr.
       85   define buffer buf2_c-chk-doc for ub.c-chk-doc.
       86   define buffer buf2_c-chk-gds for ub.c-chk-gds.
       87   define buffer buf2_c-chk-pay for ub.c-chk-pay.
       88   define buffer buf2_c-chk-discnt for ub.c-chk-discnt.
       89   define buffer buf2_c-chk-doc-attr for ub.c-chk-doc-attr.
       90   define buffer buf_marking-chk for ub.marking-chk.
       91   define buffer buf_c-marking-chk for ub.c-marking-chk.
       92   define buffer buf2_c-marking-chk for ub.c-marking-chk.
       93   define buffer buf_chk-doc for ub.chk-doc.
       94   define buffer buf_chk-gds for ub.chk-gds.
       95   define buffer buf_chk-pay for ub.chk-pay.
       96   define buffer buf_chk-discnt for ub.chk-discnt.
       97   define buffer buf_chk-doc-attr for ub.chk-doc-attr.
       98   define buffer buf_chk-gds-attr for ub.chk-gds-attr.
       99   define buffer buf_chk-pay-attr for ub.chk-pay-attr.
      100   define buffer buf_chk-discnt-attr for ub.chk-discnt-attr.
      101   main-block:
      102   do
      103   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      104   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      105   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      106   :
      107     find last buf_c-chk-doc exclusive-lock where
      108             buf_c-chk-doc.doc-code = p-doc-code use-index pi.
      109     if buf_c-chk-doc.is-del = no then do:
      110       undo main-block, return error substitute("Нельзя восстановить чек &1 по истории - чек не был удален", p-doc-code).
      111     end.
      112   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      113   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      114     (input  buf_c-chk-doc.obj-type
      115     ,input  buf_c-chk-doc.obj-code
      116     ,output v-obj-db-num
      117     )  .
      118     if v-obj-db-num <> g#db-num then do:
      119       undo main-block, return error substitute("Нельзя восстановить чек &1 по истории&2" +
      120                                                 "чек объекта &3&4, принадлежащего БД &5" +
      121                                                 "текущая БД - &6"
      122                                                 , p-doc-code
      123                                                 , chr(10)
      124                                                 , buf_c-chk-doc.obj-type
      125                                                 , buf_c-chk-doc.obj-code
      126                                                 , v-obj-db-num
      127                                                 , g#db-num
      128                                                 ).
      129     end.
      130     if buf_c-chk-doc.out-code <> '':U
      131     and buf_c-chk-doc.out-code <> ? then do:
      132        undo main-block, return error substitute("Нельзя восстановить чек &1 по истории&2" +
      133                                                  "в выбранном срезе истории &3 чек привязан к документу продажи"
      134                                                  , buf_c-chk-doc.doc-code
      135                                                  , chr(10)
      136                                                  , buf_c-chk-doc.chip-num).
      137     end.
      138     FIND  buf_chk-doc where
      139           buf_chk-doc.obj-type = buf_c-chk-doc.obj-type
      140       and buf_chk-doc.obj-code = buf_c-chk-doc.obj-code
      141       and buf_chk-doc.chk-date = buf_c-chk-doc.chk-date
      142       and buf_chk-doc.pay-desk = buf_c-chk-doc.pay-desk
      143       and buf_chk-doc.chk-time = buf_c-chk-doc.chk-time
      144       and buf_chk-doc.chk-num = buf_c-chk-doc.chk-num
      145       and buf_chk-doc.sales-man = buf_c-chk-doc.sales-man NO-ERROR NO-WAIT.
      146      IF NOT AVAIL buf_chk-doc
      147      AND NOT LOCKED buf_chk-doc  AND NOT AMBIGUOUS buf_chk-doc then do:
      148        create buf_chk-doc.
      149        buffer-copy buf_c-chk-doc to buf_chk-doc.
      150        create buf2_c-chk-doc.
      151        buffer-copy buf_c-chk-doc
      152        except is-del chip-num
      153        to buf2_c-chk-doc
      154        assign
      155        buf2_c-chk-doc.is-del = ?
      156        buf2_c-chk-doc.chip-num = buf_c-chk-doc.chip-num + 1
      157        .
      158        for each buf_c-chk-gds no-lock where
      159               buf_c-chk-gds.doc-code = buf_c-chk-doc.doc-code
      160           and buf_c-chk-gds.chip-num = buf_c-chk-doc.chip-num
      161        on error undo main-block, return error:
      162          create buf_chk-gds.
      163          buffer-copy buf_c-chk-gds to buf_chk-gds.
      164          create buf2_c-chk-gds.
      165          buffer-copy buf_c-chk-gds
      166          except chip-num to buf2_c-chk-gds
      167          assign
      168          buf2_c-chk-gds.chip-num = buf2_c-chk-doc.chip-num
      169          .
      170        end.
      171        for each buf_c-chk-discnt no-lock where
      172               buf_c-chk-discnt.doc-code = buf_c-chk-doc.doc-code
      173           and buf_c-chk-discnt.chip-num = buf_c-chk-doc.chip-num
      174        on error undo main-block, return error:
      175          create buf_chk-discnt.
      176          buffer-copy buf_c-chk-discnt to buf_chk-discnt.
      177          create buf2_c-chk-discnt.
      178          buffer-copy buf_c-chk-discnt
      179          except chip-num to buf2_c-chk-discnt
      180          assign
      181          buf2_c-chk-discnt.chip-num = buf2_c-chk-doc.chip-num
      182          .
      183        end.
      184        for each buf_c-chk-pay no-lock where
      185               buf_c-chk-pay.doc-code = buf_c-chk-doc.doc-code
      186           and buf_c-chk-pay.chip-num = buf_c-chk-doc.chip-num
      187        on error undo main-block, return error:
      188          create buf_chk-pay.
      189          buffer-copy buf_c-chk-pay to buf_chk-pay.
      190          create buf2_c-chk-pay.
      191          buffer-copy buf_c-chk-pay
      192          except chip-num to buf2_c-chk-pay
      193          assign
      194          buf2_c-chk-pay.chip-num = buf2_c-chk-doc.chip-num
      195          .
      196        end.
      197        for each buf_c-marking-chk no-lock where
      198                buf_c-marking-chk.doc-code = buf_c-chk-doc.doc-code
      199            and buf_c-marking-chk.chip-num = buf_c-chk-doc.chip-num
      200        on error undo main-block, return error:
      201          create buf_marking-chk.
      202          buffer-copy buf_c-marking-chk to buf_marking-chk.
      203          create buf2_c-marking-chk.
      204          buffer-copy buf_c-marking-chk
      205          except chip-num to buf2_c-marking-chk
      206          assign
      207          buf2_c-marking-chk.chip-num = buf2_c-chk-doc.chip-num
      208          .
      209        end.
      210        chk-doc-attr_ :
      211        for each buf_c-chk-doc-attr no-lock where
      212               buf_c-chk-doc-attr.doc-code = buf_c-chk-doc.doc-code
      213           and buf_c-chk-doc-attr.chip-num = buf_c-chk-doc.chip-num
      214        on error undo main-block, return error:
      215          if num-entries(buf_c-chk-doc-attr.attr-code, chr(4)) > 1
      216          then do :
      217            if entry(1, buf_c-chk-doc-attr.attr-code, chr(4)) begins "gds="
      218            then do :
      219              find first buf_chk-gds-attr exclusive-lock where buf_chk-gds-attr.attr-code = entry(2, buf_c-chk-doc-attr.attr-code, chr(4)) and
      220              buf_chk-gds-attr.doc-code = buf_c-chk-doc-attr.doc-code and
      221              buf_chk-gds-attr.line-num = integer(entry(2, entry(1, buf_c-chk-doc-attr.attr-code, chr(4)), "=")) no-error .
      222              if not available (buf_chk-gds-attr) then do:
      223              create buf_chk-gds-attr.
      224              assign
      225              buf_chk-gds-attr.attr-code = entry(2, buf_c-chk-doc-attr.attr-code, chr(4))
      226              buf_chk-gds-attr.line-num = integer(entry(2, entry(1, buf_c-chk-doc-attr.attr-code, chr(4)), "="))
      227              buf_chk-gds-attr.attr-value = buf_c-chk-doc-attr.attr-value
      228              buf_chk-gds-attr.doc-code = buf_c-chk-doc-attr.doc-code
      229              .
      230              end.
      231              else do:
      232                buf_chk-gds-attr.attr-value = buf_c-chk-doc-attr.attr-value .
      233              end.
      234              create buf2_c-chk-doc-attr.
      235              buffer-copy buf_c-chk-doc-attr
      236              except chip-num to buf2_c-chk-doc-attr
      237              assign
      238              buf2_c-chk-doc-attr.chip-num = buf2_c-chk-doc.chip-num
      239              .
      240              next chk-doc-attr_ .
      241            end .
      242            if entry(1, buf_c-chk-doc-attr.attr-code, chr(4)) begins "pay="
      243            then do :
      244              find first buf_chk-pay-attr no-lock where buf_chk-pay-attr.attr-code = entry(2, buf_c-chk-doc-attr.attr-code, chr(4)) and
      245              buf_chk-pay-attr.doc-code = buf_c-chk-doc-attr.doc-code and
      246              buf_chk-pay-attr.line-num = integer(entry(2, entry(1, buf_c-chk-doc-attr.attr-code, chr(4)), "=")) no-error .
      247              if not available (buf_chk-pay-attr) then do:
      248              create buf_chk-pay-attr.
      249              buffer-copy buf_c-chk-doc-attr to buf_chk-pay-attr
      250              assign
      251              buf_chk-pay-attr.attr-code = entry(2, buf_c-chk-doc-attr.attr-code, chr(4))
      252              buf_chk-pay-attr.line-num = integer(entry(2, entry(1, buf_c-chk-doc-attr.attr-code, chr(4)), "="))
      253              buf_chk-pay-attr.doc-code = buf_c-chk-doc-attr.doc-code
      254              buf_chk-pay-attr.attr-value = buf_c-chk-doc-attr.attr-value
      255              .
      256              end.
      257              create buf2_c-chk-doc-attr.
      258              buffer-copy buf_c-chk-doc-attr
      259              except chip-num to buf2_c-chk-doc-attr
      260              assign
      261              buf2_c-chk-doc-attr.chip-num = buf2_c-chk-doc.chip-num
      262              .
      263              next chk-doc-attr_ .
      264            end .
      265            if entry(1, buf_c-chk-doc-attr.attr-code, chr(4)) begins "discnt="
      266            then do :
      267              v-discnt = entry(2, entry(1, buf_c-chk-doc-attr.attr-code, chr(4)), "=") .
      268              create buf_chk-discnt-attr.
      269              buffer-copy buf_c-chk-doc-attr to buf_chk-discnt-attr
      270              assign
      271              buf_chk-discnt-attr.attr-code = entry(2, buf_c-chk-doc-attr.attr-code, chr(4))
      272              buf_chk-discnt-attr.line-num = integer(entry(1, v-discnt, chr(3)))
      273              buf_chk-discnt-attr.record-type = integer(entry(2, v-discnt, chr(3)))
      274              buf_chk-discnt-attr.discnt-id = integer(entry(3, v-discnt, chr(3)))
      275              buf_chk-discnt-attr.object-line-num = integer(entry(4, v-discnt, chr(3)))
      276              .
      277              create buf2_c-chk-doc-attr.
      278              buffer-copy buf_c-chk-doc-attr
      279              except chip-num to buf2_c-chk-doc-attr
      280              assign
      281              buf2_c-chk-doc-attr.chip-num = buf2_c-chk-doc.chip-num
      282              .
      283              next chk-doc-attr_ .
      284            end .
      285          find first buf_chk-gds-attr exclusive-lock where buf_chk-gds-attr.attr-code = buf_c-chk-doc-attr.attr-code and
      286            buf_chk-gds-attr.doc-code = buf_c-chk-doc-attr.doc-code and
      287            buf_chk-pay-attr.line-num = integer(entry(2, entry(1, buf_c-chk-doc-attr.attr-code, chr(4)), "=")) no-error .
      288          if not available (buf_chk-gds-attr) then
      289          do:
      290            create buf_chk-gds-attr.
      291              assign
      292              buf_chk-gds-attr.attr-code = entry(2, buf_c-chk-doc-attr.attr-code, chr(4))
      293              buf_chk-pay-attr.line-num = integer(entry(2, entry(1, buf_c-chk-doc-attr.attr-code, chr(4)), "="))
      294              buf_chk-gds-attr.attr-value = buf_c-chk-doc-attr.attr-value
      295              buf_chk-gds-attr.doc-code = buf_c-chk-doc-attr.doc-code
      296              .
      297          end.
      298          else
      299          do:
      300            buf_chk-gds-attr.attr-value = buf_c-chk-doc-attr.attr-value .
      301          end.
      302          end .
      303          find first buf_chk-doc-attr exclusive-lock where buf_chk-doc-attr.attr-code = buf_c-chk-doc-attr.attr-code and
      304          buf_chk-doc-attr.doc-code = buf_c-chk-doc-attr.doc-code no-error .
      305          if not available (buf_chk-doc-attr) then do:
      306          create buf_chk-doc-attr.
      307          buffer-copy buf_c-chk-doc-attr to buf_chk-doc-attr.
      308          end.
      309          else do:
      310            buf_chk-doc-attr.attr-value = buf_c-chk-doc-attr.attr-value .
      311          end.
      312          create buf2_c-chk-doc-attr.
      313          buffer-copy buf_c-chk-doc-attr
      314          except chip-num to buf2_c-chk-doc-attr
      315          assign
      316          buf2_c-chk-doc-attr.chip-num = buf2_c-chk-doc.chip-num
      317          .
      318        end.
      319      end.
      320      else do:
      321        undo main-block, return error substitute("Нельзя восстановить чек &1 по истории&2" +
      322                                "такой чек уже существует либо проверка его отсутствия не удалась"
      323                                , p-doc-code
      324                                , chr(10)).
      325      end.
      326   end.
