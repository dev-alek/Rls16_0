        1   define input parameter parmode as character no-undo.
        2   define input parameter parnum-tank as CHARACTER no-undo.
        3   define input parameter partype-AC  as integer   no-undo .
        4   define input parameter par-neck  as integer   no-undo .
        5   define input-output parameter parsec-num as CHARACTER no-undo.
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Измерение по резервуару".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   DEFINE BUFFER buf_auto-tank FOR auto-tank.
      116   define buffer buf_auto-section for ub.auto-section .
      117   define temp-table tt-section no-undo
      118      field dif     as integer
      119      field volume1 as decimal
      120      field deltaV  as character
      121      index pi dif
      122      .
      123   define variable ii as integer no-undo .
      124   DEFINE BUTTON b-cancel AUTO-END-KEY
      125      LABEL "&Отмена"
      126      SIZE 10 BY 1
      127      BGCOLOR 8 .
      128   DEFINE BUTTON b-help
      129      LABEL "Помо&щь"
      130      SIZE 10 BY 1
      131      BGCOLOR 8 .
      132   DEFINE BUTTON b-save AUTO-GO
      133      LABEL "&Ввод"
      134      SIZE 10 BY 1
      135      BGCOLOR 8 .
      136   DEFINE VARIABLE ellipse-depth      AS CHARACTER FORMAT "x(8)"
      137      LABEL "Толщина стенки горловины, мм"
      138      VIEW-AS FILL-IN
      139      SIZE 15 BY 1 NO-UNDO.
      140   DEFINE VARIABLE ellipse-max        AS CHARACTER FORMAT "x(8)"
      141      LABEL "Диаметр горловины большой оси эллипса, мм"
      142      VIEW-AS FILL-IN
      143      SIZE 15 BY 1 NO-UNDO.
      144   DEFINE VARIABLE ellipse-min        AS CHARACTER FORMAT "x(8)"
      145      LABEL "Диаметр горловины малой оси эллипса, мм"
      146      VIEW-AS FILL-IN
      147      SIZE 15 BY 1 NO-UNDO.
      148   DEFINE VARIABLE F-dop-volume       AS DECIMAL   FORMAT ">>,>>9.999":U INITIAL 0
      149      LABEL "Доп.объем трубопровода нижнего налива, л"
      150      VIEW-AS FILL-IN
      151      SIZE 14 BY 1 NO-UNDO.
      152   DEFINE VARIABLE square-depth       AS CHARACTER FORMAT "x(8)"
      153      LABEL "Толщина стенки горловины, мм"
      154      VIEW-AS FILL-IN
      155      SIZE 15 BY 1 NO-UNDO.
      156   DEFINE VARIABLE square-lenght      AS CHARACTER FORMAT "x(8)"
      157      LABEL "Длина горловины, мм"
      158      VIEW-AS FILL-IN
      159      SIZE 15 BY 1 NO-UNDO.
      160   DEFINE VARIABLE square-width       AS CHARACTER FORMAT "x(8)"
      161      LABEL "Ширина горловины, мм"
      162      VIEW-AS FILL-IN
      163      SIZE 15 BY 1 NO-UNDO.
      164   DEFINE VARIABLE varsec-diam-in     AS CHARACTER FORMAT "x(8)"
      165      LABEL "Внутренний диаметр горловины, мм"
      166      VIEW-AS FILL-IN
      167      SIZE 15 BY 1 NO-UNDO.
      168   DEFINE VARIABLE varsec-diam-out    AS CHARACTER FORMAT "x(8)"
      169      LABEL "Внешний диаметр горловины, мм"
      170      VIEW-AS FILL-IN
      171      SIZE 15 BY 1 NO-UNDO.
      172   DEFINE VARIABLE varsec-diam-depth  AS CHARACTER FORMAT "x(8)"
      173      LABEL "Толщина стенки горловины, мм"
      174      VIEW-AS FILL-IN
      175      SIZE 15 BY 1 NO-UNDO.
      176   DEFINE VARIABLE varsec-diam-lenght AS CHARACTER FORMAT "x(8)"
      177      LABEL "Длина внешней окружности горловины, мм"
      178      VIEW-AS FILL-IN
      179      SIZE 15 BY 1 NO-UNDO.
      180   DEFINE VARIABLE varsec-num         AS INTEGER   FORMAT "->,>>>,>>9" INITIAL 0
      181      LABEL "Номер секции"
      182      VIEW-AS FILL-IN
      183      SIZE 15 BY 1 NO-UNDO.
      184   DEFINE VARIABLE varsec-qnty        AS DECIMAL   FORMAT "->>>,>>>,>>9.999" INITIAL 0
      185      LABEL "Вместимость секции, л"
      186      VIEW-AS FILL-IN
      187      SIZE 15 BY 1 NO-UNDO.
      188   DEFINE QUERY BROWSE-2 FOR
      189      tt-section SCROLLING.
      190   DEFINE BROWSE BROWSE-2
      191      QUERY BROWSE-2 DISPLAY
      192      tt-section.dif COLUMN-LABEL "Отклонение от!тарировочной!планки, см" FORMAT "->9.9":U WIDTH 15
      193      tt-section.volume1 COLUMN-LABEL "Объем!для указанного!отклонения от планки, л" FORMAT "->>,>>9.99":U
      194      if tt-section.deltaV > "" and decimal(tt-section.deltaV) > 0 then string(decimal(tt-section.deltaV), ">>>>>>>>>>9.9999") else "" COLUMN-LABEL "Коэффициент!вместимости!горловины,дм3/мм" FORMAT "X(16)"
      195     ENABLE
      196         tt-section.volume1
      197       WITH NO-ROW-MARKERS SEPARATORS SIZE 58 BY 7.75 FIT-LAST-COLUMN.
      198   DEFINE FRAME Dialog-Frame
      199      b-save AT ROW 1 COL 1 WIDGET-ID 2
      200      b-cancel AT ROW 1 COL 11 WIDGET-ID 4
      201      b-help AT ROW 1 COL 21 WIDGET-ID 6
      202      varsec-num AT ROW 2.25 COL 42.5 COLON-ALIGNED WIDGET-ID 8
      203      varsec-qnty AT ROW 3.5 COL 42.5 COLON-ALIGNED WIDGET-ID 10
      204      F-dop-volume AT ROW 4.75 COL 42.5 COLON-ALIGNED WIDGET-ID 18
      205      BROWSE-2 AT ROW 6 COL 1.5 WIDGET-ID 100
      206      varsec-diam-in AT ROW 6 COL 42.5 COLON-ALIGNED WIDGET-ID 16
      207      varsec-diam-out AT ROW 7.25 COL 42.5 COLON-ALIGNED WIDGET-ID 38
      208      varsec-diam-depth AT ROW 8.5 COL 42.5 COLON-ALIGNED WIDGET-ID 40
      209      varsec-diam-lenght AT ROW 9.75 COL 42.5 COLON-ALIGNED WIDGET-ID 42
      210      square-lenght AT ROW 6 COL 42.5 COLON-ALIGNED WIDGET-ID 26
      211      ellipse-max AT ROW 6 COL 42.5 COLON-ALIGNED WIDGET-ID 32
      212      square-width AT ROW 7.25 COL 42.5 COLON-ALIGNED WIDGET-ID 28
      213      ellipse-min AT ROW 7.25 COL 42.5 COLON-ALIGNED WIDGET-ID 34
      214      square-depth AT ROW 8.5 COL 42.5 COLON-ALIGNED WIDGET-ID 30
      215      ellipse-depth AT ROW 8.5 COL 42.5 COLON-ALIGNED WIDGET-ID 36
      216      SPACE(1.12) SKIP(4.87)
      217      WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      218      SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      219      TITLE "Данные по секции"
      220      DEFAULT-BUTTON b-save CANCEL-BUTTON b-cancel.
      221   ASSIGN
      222      FRAME Dialog-Frame:SCROLLABLE = FALSE
      223      FRAME Dialog-Frame:HIDDEN     = TRUE.
      224   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      225      DO:
      226         APPLY "END-ERROR":U TO SELF.
      227      END.
      228   ON CHOOSE OF b-save IN FRAME Dialog-Frame
      229   DO:
      230     IF input frame Dialog-Frame varsec-num <= 0 THEN DO:
      231       message "Номер секции указан неверно." view-as alert-box error.
      232       RETURN no-apply.
      233     END.
      234         if (par-neck = 0 and partype-AC = 1) OR
      235            (par-neck = 0 and partype-AC = 2) OR
      236            (par-neck = 1 and
      237            input frame Dialog-Frame square-depth <> '' and
      238            input frame Dialog-Frame square-lenght <> '' and
      239            input frame Dialog-Frame square-width <> '') OR
      240            (par-neck = 2 and
      241            input frame Dialog-Frame ellipse-min <> '' and
      242            input frame Dialog-Frame ellipse-max <> '' and
      243            input frame Dialog-Frame ellipse-depth <> '') OR
      244            (par-neck = 3 and input frame Dialog-Frame varsec-diam-depth <> '' and
      245            input frame Dialog-Frame varsec-diam-out <> '' and
      246            (parmode = 'ДОБАВЛЕНИЕ':U or parmode = 'ИЗМЕНЕНИЕ':U) AND
      247            input frame Dialog-Frame varsec-num <> 0 AND
      248            input frame Dialog-Frame varsec-qnty <> 0) OR
      249            (par-neck = 3 and input frame Dialog-Frame varsec-diam-depth <> '' and
      250            input frame Dialog-Frame varsec-diam-lenght <> '' AND
      251            (parmode = 'ДОБАВЛЕНИЕ':U or parmode = 'ИЗМЕНЕНИЕ':U) AND
      252            input frame Dialog-Frame varsec-num <> 0 AND
      253            input frame Dialog-Frame varsec-qnty <> 0) OR
      254            (par-neck = 3 and input frame Dialog-Frame varsec-diam-in <> '' and
      255            varsec-diam-depth = "" and varsec-diam-lenght = "" and varsec-diam-out = "" and
      256            (parmode = 'ДОБАВЛЕНИЕ':U or parmode = 'ИЗМЕНЕНИЕ':U) AND
      257            input frame Dialog-Frame varsec-num <> 0 AND
      258            input frame Dialog-Frame varsec-qnty <> 0)
      259            then
      260         do:
      261       end.
      262         else
      263         do :
      264            if par-neck <> 3 then
      265            do:
      266               message "Введите данные! Не все поля заполнены" view-as alert-box.
      267               return no-apply.
      268            end.
      269            else
      270            do:
      271               if varsec-diam-in = "" and varsec-diam-out = "" and varsec-diam-lenght = "" then
      272               do:
      273                  message "Введите данные! Необходимо указать одно из значений:" skip
      274                     "внешний диаметр, внутренний диаметр или длину внешней окружности горловины."
      275                     view-as alert-box.
      276                  return no-apply.
      277               end.
      278               else
      279               do:
      280                  if varsec-diam-in = "" then do:
      281                  if varsec-diam-out > "" or varsec-diam-lenght > "" then do:
      282                  if varsec-diam-depth = "" then
      283                  do:
      284                     message "Введите данные! Необходимо указать толщину стенки горловины." view-as alert-box.
      285                     return no-apply.
      286                  end.
      287                  end.
      288                  end.
      289            end.
      290         end.
      291      end.
      292   if par-neck = 3 and decimal(varsec-diam-in) > decimal(varsec-diam-out) and
      293      varsec-diam-in <> "" and varsec-diam-out <> "" then
      294   do:
      295      message "Внутренний диаметр горловины должен быть меньше внешнего"
      296         view-as alert-box error.
      297      return no-apply.
      298   end.
      299        IF AVAILABLE ub.auto-section THEN do:
      300        if integer(parsec-num) <> ub.auto-section.section-num then do:
      301           IF CAN-FIND(buf_auto-section WHERE buf_auto-section.auto-num = parnum-tank
      302                                          and buf_auto-section.section-num = integer(parsec-num)) THEN DO:
      303               message "Секция с таким номером уже существует." view-as alert-box error.
      304               RETURN.
      305           END. ELSE.
      306        end.
      307        END.
      308        ELSE
      309           IF CAN-FIND(buf_auto-section WHERE buf_auto-section.auto-num = parnum-tank
      310                                            and buf_auto-section.section-num = integer(parsec-num)) THEN DO:
      311               message "Секция с таким номером уже существует." view-as alert-box error.
      312               RETURN.
      313           END.
      314        IF NOT AVAILABLE ub.auto-section THEN DO:
      315           create ub.auto-section.
      316                   ub.auto-section.auto-num = parnum-tank
      317                   .
      318        END.
      319        assign
      320           ub.auto-section.section-num = integer(varsec-num)
      321           ub.auto-section.brutto-qnty = varsec-qnty
      322           ub.auto-section.add-volume  = F-dop-volume
      323           .
      324        case par-neck:
      325           when 0 then
      326              do:
      327                 do ii = -10 to 10:
      328                    find first ub.auto-section-table exclusive-lock where ub.auto-section-table.auto-num = parnum-tank
      329                       and ub.auto-section-table.section-num = integer(varsec-num)
      330                       and ub.auto-section-table.error = ii no-error .
      331                    if not available (ub.auto-section-table) then
      332                    do:
      333                       create ub.auto-section-table .
      334                       assign
      335                          ub.auto-section-table.auto-num    = parnum-tank
      336                          ub.auto-section-table.section-num = integer(varsec-num)
      337                          ub.auto-section-table.error       = ii
      338                          .
      339                    end.
      340                    for first tt-section where tt-section.dif = ii:
      341                       assign
      342                          ub.auto-section-table.volume-error = tt-section.volume1
      343                          ub.auto-section-table.volume-between = decimal(tt-section.deltaV) * 100
      344                       .
      345                    end.
      346                 end.
      347              end.
      348           when 1 then
      349              do:
      350                 assign
      351                    ub.auto-section.length        = decimal(square-lenght)
      352                    ub.auto-section.width         = decimal(square-width)
      353                    ub.auto-section.section-depth = decimal(square-depth)
      354                    .
      355              end.
      356           when 2 then
      357              do:
      358                 assign
      359                    ub.auto-section.diameter-max  = decimal(ellipse-max)
      360                    ub.auto-section.diameter-min  = decimal(ellipse-min)
      361                    ub.auto-section.section-depth = decimal(ellipse-depth)
      362                    .
      363              end.
      364           when 3 then
      365              do:
      366                 assign
      367                    ub.auto-section.diameter-max  = decimal(varsec-diam-out)
      368                    ub.auto-section.diameter-min  = decimal(varsec-diam-in)
      369                    ub.auto-section.length        = decimal(varsec-diam-lenght)
      370                    ub.auto-section.section-depth = decimal(varsec-diam-depth)
      371                    .
      372              end.
      373        end case .
      374   END.
      375   ON LEAVE OF ellipse-depth IN FRAME Dialog-Frame
      376      DO:
      377         assign ellipse-depth .
      378      END.
      379   ON LEAVE OF ellipse-max IN FRAME Dialog-Frame
      380      DO:
      381         assign ellipse-max .
      382      END.
      383   ON LEAVE OF ellipse-min IN FRAME Dialog-Frame
      384      DO:
      385         assign ellipse-min .
      386      END.
      387   ON LEAVE OF F-dop-volume IN FRAME Dialog-Frame
      388      DO:
      389         assign f-dop-volume .
      390      END.
      391   ON LEAVE OF square-depth IN FRAME Dialog-Frame
      392      DO:
      393         assign square-depth .
      394      END.
      395   ON LEAVE OF square-lenght IN FRAME Dialog-Frame
      396      DO:
      397         assign square-lenght .
      398      END.
      399   ON LEAVE OF square-width IN FRAME Dialog-Frame
      400      DO:
      401         assign square-width .
      402      END.
      403   ON LEAVE OF varsec-diam-in IN FRAME Dialog-Frame
      404      DO:
      405         if string(varsec-diam-in) <> varsec-diam-in:screen-value then
      406         do:
      407            assign varsec-diam-in .
      408         end.
      409      END.
      410   ON LEAVE OF varsec-diam-out IN FRAME Dialog-Frame
      411      DO:
      412         if string(varsec-diam-out) <> varsec-diam-out:screen-value then
      413         do:
      414            assign varsec-diam-out .
      415         end.
      416      END.
      417   ON LEAVE OF varsec-diam-depth IN FRAME Dialog-Frame
      418      DO:
      419         assign varsec-diam-depth .
      420      END.
      421   ON LEAVE OF varsec-diam-lenght IN FRAME Dialog-Frame
      422      DO:
      423         assign varsec-diam-lenght .
      424      END.
      425   ON LEAVE OF varsec-num IN FRAME Dialog-Frame
      426      DO:
      427         assign varsec-num .
      428      END.
      429   ON LEAVE OF varsec-qnty IN FRAME Dialog-Frame
      430      DO:
      431         assign varsec-qnty .
      432      END.
      433   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      434      THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      435   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      436   on help of frame Dialog-Frame
      437   do:
      438     run gbl/app_help.p
      439       (input this-procedure :file-name
      440       ,input ''
      441       ,input ?
      442       ) no-error.
      443     if error-status :error then do:
      444       message
      445         "Ошибка при вызове помощи"
      446         error-status :get-message(1)
      447         view-as alert-box .
      448     end.
      449   end.
      450   run minbtn-set in this-procedure .
      451   on choose of b-help in frame Dialog-Frame
      452   do:
      453     apply "help":u to frame Dialog-Frame .
      454   end.
      455   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      456   procedure minbtn-set :
      457       do
      458           on error undo, return error return-value
      459           :
      460           define variable ii              as integer       no-undo .
      461           define variable fh              as widget-handle no-undo .
      462           define variable hh              as widget-handle no-undo .
      463           define variable v-h             as handle        extent 4 no-undo .
      464           define variable v-name-button   as character     no-undo .
      465           define variable v-help-old-x    as decimal       no-undo .
      466           define variable v-help-old-y    as decimal       no-undo .
      467           define variable v-help-old-size as decimal       no-undo .
      468           define variable v-frame-width   as decimal       no-undo .
      469           define variable jj              as integer       no-undo .
      470           do
      471               on error undo, return error
      472               :
      473               assign
      474                   v-frame-width = frame Dialog-Frame:width - 0.3
      475                   fh            = frame Dialog-Frame:first-child
      476                   hh            = fh:first-child
      477                   ii            = 1
      478                   .
      479               do while valid-handle(hh):
      480                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      481                   do:
      482                       case lc(hh:name) :
      483                           when "b-help" then
      484                               do:
      485                                   hh:load-image-up("cmp/b-help.bmp":u) .
      486                                   hh:load-image-down("cmp/b-help.bmp":u) .
      487                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      488                                   hh:TOOLTIP = "Помощь" .
      489                                   v-help-old-x = hh:column .
      490                                   v-help-old-y = hh:row    .
      491                                   v-help-old-size = hh:width .
      492                                   hh:width-chars = 2.5 .
      493                               end.
      494                           when "b-print" then
      495                               do:
      496                                   hh:load-image("cmp/b-print.bmp":u) .
      497                                   hh:TOOLTIP = "Печать" .
      498                                   v-h[ii] = hh:handle .
      499                                   ii = ii + 1 .
      500                                   hh:width-chars = 3 .
      501                               end.
      502                           when "b-history" or
      503                           when "b-hist" then
      504                               do:
      505                                   hh:load-image("cmp/b-hist.bmp":u) .
      506                                   hh:TOOLTIP = "История" .
      507                                   v-h[ii] = hh:handle .
      508                                   ii = ii + 1 .
      509                                   hh:width-chars = 3 .
      510                               end.
      511                           when "b-sch" then
      512                               do:
      513                                   hh:load-image("cmp/b-sch.bmp":u) .
      514                                   hh:TOOLTIP = "Установка Фильтра" .
      515                                   v-h[ii] = hh:handle .
      516                                   ii = ii + 1 .
      517                                   hh:width-chars = 3 .
      518                               end.
      519                           when "b-hist-user" then
      520                               do:
      521                                   hh:load-image("cmp/b-hist.bmp":u) .
      522                                   hh:TOOLTIP = "История пользователя" .
      523                                   ii = ii + 1 .
      524                               end.
      525                       end case.
      526                   end.
      527                   hh = hh:next-sibling.
      528               end.
      529               b-help:column = v-frame-width - b-help:width-chars.
      530               jj = 0.
      531               repeat ii = 4 to 1 by -1 :
      532                   if valid-handle (v-h[ii] ) then
      533                   do:
      534                       jj  = jj + 1 .
      535                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      536                       v-h[ii]:row    = v-help-old-y .
      537                   end.
      538               end.
      539           end.
      540       end.
      541   end procedure.
      542   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      543   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      544   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      545   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      546   define variable v-diasize-current-frame-width  as decimal   no-undo .
      547   define variable v-diasize-current-frame-height as decimal   no-undo .
      548   define variable v-diasize-change-size          as logical   no-undo .
      549   define variable v-diasize-resize-button        as handle    no-undo .
      550   define variable v-diasize-wndmax               as logical   no-undo .
      551   define variable v-diasize-wndstore             as logical   no-undo .
      552   define variable v-diasize-proc-name            as character no-undo .
      553   define variable v-diasize-browse-handle        as handle    no-undo .
      554   define variable v-diasize-browse-number        as integer   no-undo .
      555   define variable v-diasize-need-full-display    as logical   no-undo init false .
      556   define temp-table temp-diasize-handle no-undo
      557     field handle-value  as handle
      558     field save-position as decimal
      559     index xpk is primary unique handle-value
      560     .
      561   define temp-table temp-browse-handle no-undo
      562     field browse-type   as character
      563     field browse-number as integer
      564     field browse-handle as handle
      565     field original-size as decimal
      566     index xpk is primary unique browse-type browse-number
      567     index xie browse-type browse-handle
      568   .
      569   procedure diasize_change-height :
      570     define input  parameter p-change-value  as decimal   no-undo .
      571     define input  parameter p-move-resize   as logical   no-undo .
      572     define variable v-field-group-handle    as handle    no-undo .
      573     define variable v-object-handle         as handle    no-undo .
      574     define variable v-frame-height          as decimal   no-undo .
      575     define variable v-frame-virtual-height  as decimal   no-undo .
      576     define variable v-browse-height         as decimal   no-undo .
      577     define variable v-window-height         as decimal   no-undo .
      578     define variable v-window-virtual-height as decimal   no-undo .
      579     define variable v-change-sign           as integer   no-undo .
      580     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      581     define buffer buf_temp-browse-handle  for temp-browse-handle .
      582     if p-change-value > 0
      583     then do:
      584       if frame Dialog-Frame :height + p-change-value
      585           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      586       then do:
      587         assign
      588           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      589                           - (frame Dialog-Frame :height-chars)
      590         .
      591         if p-change-value <= 0
      592         then do:
      593           run diasize_position-resize-button in this-procedure .
      594           return .
      595         end.
      596       end.
      597     end.
      598     if p-change-value < 0
      599     then do:
      600       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      601       then do:
      602         assign
      603           p-change-value = v-diasize-orig-frame-height
      604                          - (frame Dialog-Frame :height-chars)
      605         .
      606         if p-change-value >= 0
      607         then do:
      608           run diasize_position-resize-button in this-procedure .
      609           return .
      610         end.
      611       end.
      612     end.
      613     if p-change-value >= 0
      614     then do:
      615       assign
      616         v-change-sign = 1
      617       .
      618     end.
      619     else do:
      620       assign
      621         v-change-sign = -1
      622       .
      623     end.
      624     assign
      625       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      626     .
      627     if p-change-value = 0
      628     then do:
      629       run diasize_position-resize-button in this-procedure .
      630       return .
      631     end.
      632     move_block:
      633     do
      634     on error undo move_block, retry move_block
      635     :
      636       if retry
      637       then do:
      638         do
      639         on error undo move_block, leave move_block
      640         :
      641           if p-change-value > 0
      642           then do:
      643             for each buf_temp-diasize-handle
      644             on error undo, next
      645             :
      646               assign
      647                 v-object-handle = buf_temp-diasize-handle.handle-value
      648               .
      649               if v-object-handle <> v-diasize-resize-button
      650               then do:
      651                 assign
      652                   v-object-handle :row = buf_temp-diasize-handle.save-position
      653                 .
      654               end.
      655             end.
      656             assign
      657               v-diasize-browse-handle :height = v-browse-height
      658             .
      659             for each buf_temp-browse-handle
      660               where buf_temp-browse-handle.browse-type = 'height':u
      661             on error undo, next
      662             :
      663               assign
      664                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      665               .
      666             end.
      667             assign
      668               frame Dialog-Frame :height = v-frame-height
      669             .
      670             if frame Dialog-Frame :scrollable = true
      671             then do:
      672               assign
      673                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      674               .
      675             end.
      676             run diasize_position-resize-button in this-procedure .
      677           end.
      678           else do:
      679             if frame Dialog-Frame :scrollable = true
      680             then do:
      681               assign
      682                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      683               .
      684             end.
      685             assign
      686               frame Dialog-Frame :height = v-frame-height
      687             .
      688             assign
      689               v-diasize-browse-handle :height = v-browse-height
      690             .
      691             for each buf_temp-browse-handle
      692               where buf_temp-browse-handle.browse-type = 'height':u
      693             on error undo, next
      694             :
      695               assign
      696                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      697               .
      698             end.
      699             for each buf_temp-diasize-handle
      700             on error undo, next
      701             :
      702               assign
      703                 v-object-handle = buf_temp-diasize-handle.handle-value
      704               .
      705               if v-object-handle <> v-diasize-resize-button
      706               then do:
      707                 assign
      708                   v-object-handle :row = buf_temp-diasize-handle.save-position
      709                 .
      710               end.
      711             end.
      712             run diasize_position-resize-button in this-procedure .
      713           end.
      714           assign
      715             v-diasize-change-size = false
      716           .
      717           leave move_block .
      718         end.
      719       end.
      720       assign
      721         v-diasize-need-full-display = true
      722       .
      723       if v-diasize-change-size = false
      724       then do:
      725         assign
      726           v-diasize-change-size = true
      727         .
      728       end.
      729       else do:
      730         return .
      731       end.
      732       assign
      733         v-frame-height = frame Dialog-Frame :height
      734         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      735         v-browse-height = v-diasize-browse-handle :height
      736       .
      737       for each buf_temp-browse-handle
      738         where buf_temp-browse-handle.browse-type = 'height':u
      739       :
      740         assign
      741           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      742         .
      743       end.
      744       for each buf_temp-diasize-handle
      745       :
      746         delete buf_temp-diasize-handle .
      747       end.
      748       assign
      749         v-field-group-handle = frame Dialog-Frame :first-child
      750       .
      751       do while valid-handle(v-field-group-handle)
      752       :
      753         assign
      754           v-object-handle = v-field-group-handle :first-child
      755         .
      756         do while valid-handle(v-object-handle)
      757         :
      758           if  v-object-handle <> v-diasize-browse-handle :handle
      759           and can-query(v-object-handle, "row")
      760           and can-query(v-object-handle, "height")
      761           and ( v-object-handle :row > v-diasize-browse-handle :row )
      762           then do:
      763             find first buf_temp-browse-handle
      764               where buf_temp-browse-handle.browse-type   = 'height':u
      765                 and buf_temp-browse-handle.browse-handle = v-object-handle
      766               no-error .
      767             if available buf_temp-browse-handle
      768             then do:
      769             end.
      770             else do:
      771               create buf_temp-diasize-handle .
      772               assign
      773                 buf_temp-diasize-handle.handle-value  = v-object-handle
      774                 buf_temp-diasize-handle.save-position = v-object-handle :row
      775               .
      776             end.
      777           end.
      778           assign
      779             v-object-handle = v-object-handle :next-sibling
      780           .
      781         end.
      782         assign
      783           v-field-group-handle = v-field-group-handle :next-sibling
      784         .
      785       end.
      786       do with frame Dialog-Frame
      787       :
      788         hide v-diasize-resize-button .
      789         assign
      790           v-diasize-resize-button :row    = 1
      791           v-diasize-resize-button :column = 1
      792         .
      793       end.
      794       if p-change-value > 0
      795       then do:
      796         if frame Dialog-Frame :scrollable = true
      797         then do:
      798           assign
      799             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      800             no-error .
      801           if error-status :error
      802           or error-status :get-message(1) <> ""
      803           then do:
      804             undo move_block, retry move_block .
      805           end.
      806         end.
      807         assign
      808           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      809           no-error .
      810         if error-status :error
      811         or error-status :get-message(1) <> ""
      812         then do:
      813           undo move_block, retry move_block .
      814         end.
      815         assign
      816           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      817           no-error .
      818         if error-status :error
      819         or error-status :get-message(1) <> ""
      820         then do:
      821           undo move_block, retry move_block .
      822         end.
      823         for each buf_temp-browse-handle
      824           where buf_temp-browse-handle.browse-type = 'height':u
      825         on error undo move_block, retry move_block
      826         :
      827           assign
      828             buf_temp-browse-handle.browse-handle :height
      829               = buf_temp-browse-handle.browse-handle :height + p-change-value
      830             no-error .
      831           if error-status :error
      832           or error-status :get-message(1) <> ""
      833           then do:
      834             undo move_block, retry move_block .
      835           end.
      836         end.
      837         for each buf_temp-diasize-handle
      838         on error undo move_block, retry move_block
      839         :
      840           assign
      841             v-object-handle = buf_temp-diasize-handle.handle-value
      842           .
      843           if v-object-handle <> v-diasize-resize-button
      844           then do:
      845             assign
      846               v-object-handle :row = v-object-handle :row + p-change-value
      847               no-error .
      848             if error-status :error
      849             or error-status :get-message(1) <> ""
      850             then do:
      851               undo move_block, retry move_block .
      852             end.
      853           end.
      854         end.
      855       end.
      856       else do:
      857         for each buf_temp-diasize-handle
      858         on error undo move_block, retry move_block
      859         :
      860           assign
      861             v-object-handle = buf_temp-diasize-handle.handle-value
      862           .
      863           if v-object-handle <> v-diasize-resize-button
      864           then do:
      865             assign
      866               v-object-handle :row = v-object-handle :row + p-change-value
      867               no-error .
      868             if error-status :error
      869             or error-status :get-message(1) <> ""
      870             then do:
      871               undo move_block, retry move_block .
      872             end.
      873           end.
      874         end.
      875         assign
      876           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      877           no-error .
      878         if error-status :error
      879         or error-status :get-message(1) <> ""
      880         then do:
      881           undo move_block, retry move_block .
      882         end.
      883         for each buf_temp-browse-handle
      884           where buf_temp-browse-handle.browse-type = 'height':u
      885         on error undo move_block, retry move_block
      886         :
      887           assign
      888             buf_temp-browse-handle.browse-handle :height
      889               = buf_temp-browse-handle.browse-handle :height + p-change-value
      890             no-error .
      891           if error-status :error
      892           or error-status :get-message(1) <> ""
      893           then do:
      894             undo move_block, retry move_block .
      895           end.
      896         end.
      897         assign
      898           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      899           no-error .
      900         if error-status :error
      901         or error-status :get-message(1) <> ""
      902         then do:
      903           undo move_block, retry move_block .
      904         end.
      905         if frame Dialog-Frame :scrollable = true
      906         then do:
      907           assign
      908             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      909             no-error .
      910           if error-status :error
      911           or error-status :get-message(1) <> ""
      912           then do:
      913             undo move_block, retry move_block .
      914           end.
      915         end.
      916       end.
      917       if p-move-resize = true
      918       then do:
      919         run diasize_position-resize-button in this-procedure .
      920       end.
      921       if v-diasize-wndstore = true
      922       then do:
      923         if connected("ub") = true
      924         then do:
      925           define variable v-cntxt-db-num        as integer   no-undo .
      926           define variable v-cntxt-userid        as character no-undo .
      927           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      928                                             , OUTPUT v-cntxt-userid
      929                                             ) .
      930           run gbl/wndsizew.p
      931             (input  v-cntxt-db-num
      932             ,input  v-cntxt-userid
      933             ,input  v-diasize-proc-name
      934             ,input  'height':u
      935             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      936             ) .
      937         end.
      938       end.
      939     end.
      940     assign
      941       v-diasize-change-size = false
      942     .
      943   end procedure.
      944   procedure diasize_set-height :
      945     define input  parameter p-new-height  as decimal   no-undo .
      946     define input  parameter p-move-resize as logical   no-undo .
      947     do
      948     on error undo, return error return-value
      949     :
      950       run diasize_change-height in this-procedure
      951         (input  (p-new-height - frame Dialog-Frame :height)
      952         ,input  p-move-resize
      953         ) .
      954     end.
      955   end procedure.
      956   procedure diasize_change-width :
      957     define input  parameter p-change-value as decimal   no-undo .
      958     define input  parameter p-move-resize  as logical   no-undo .
      959     define variable v-field-group-handle   as handle    no-undo .
      960     define variable v-object-handle        as handle    no-undo .
      961     define variable v-frame-width          as decimal   no-undo .
      962     define variable v-frame-virtual-width  as decimal   no-undo .
      963     define variable v-browse-width         as decimal   no-undo .
      964     define variable v-window-width         as decimal   no-undo .
      965     define variable v-window-virtual-width as decimal   no-undo .
      966     define variable v-change-sign          as integer   no-undo .
      967     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      968     define buffer buf_temp-browse-handle  for temp-browse-handle .
      969     if p-change-value > 0
      970     then do:
      971       if frame Dialog-Frame :width + p-change-value >
      972           session :width-chars
      973       then do:
      974         assign
      975           p-change-value = session :width-chars - frame Dialog-Frame :width
      976         .
      977         if p-change-value <= 0
      978         then do:
      979           run diasize_position-resize-button in this-procedure .
      980           return .
      981         end.
      982       end.
      983     end.
      984     if p-change-value < 0
      985     then do:
      986       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      987       then do:
      988         assign
      989           p-change-value = v-diasize-orig-frame-width
      990                          - frame Dialog-Frame :width
      991         .
      992         if p-change-value >= 0
      993         then do:
      994           run diasize_position-resize-button in this-procedure .
      995           return .
      996         end.
      997       end.
      998     end.
      999     if p-change-value >= 0
     1000     then do:
     1001       assign
     1002         v-change-sign = 1
     1003       .
     1004     end.
     1005     else do:
     1006       assign
     1007         v-change-sign = -1
     1008       .
     1009     end.
     1010     assign
     1011       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1012     .
     1013     if p-change-value = 0
     1014     then do:
     1015       run diasize_position-resize-button in this-procedure .
     1016       return .
     1017     end.
     1018     move_block:
     1019     do
     1020     on error undo move_block, leave move_block
     1021     :
     1022       if retry
     1023       then do:
     1024         do
     1025         on error undo move_block, leave move_block
     1026         :
     1027           if p-change-value > 0
     1028           then do:
     1029             for each buf_temp-diasize-handle
     1030             on error undo, next
     1031             :
     1032               assign
     1033                 v-object-handle = buf_temp-diasize-handle.handle-value
     1034               .
     1035               if v-object-handle <> v-diasize-resize-button
     1036               then do:
     1037                 assign
     1038                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1039                 .
     1040               end.
     1041             end.
     1042             assign
     1043               v-diasize-browse-handle :width = v-browse-width
     1044             .
     1045             for each buf_temp-browse-handle
     1046               where buf_temp-browse-handle.browse-type = 'width':u
     1047             on error undo, next
     1048             :
     1049               assign
     1050                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1051               .
     1052             end.
     1053             assign
     1054               frame Dialog-Frame :width = v-frame-width
     1055             .
     1056             if frame Dialog-Frame :scrollable = true
     1057             then do:
     1058               assign
     1059                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1060               .
     1061             end.
     1062             run diasize_position-resize-button in this-procedure .
     1063           end.
     1064           else do:
     1065             if frame Dialog-Frame :scrollable = true
     1066             then do:
     1067               assign
     1068                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1069               .
     1070             end.
     1071             assign
     1072               frame Dialog-Frame :width = v-frame-width
     1073             .
     1074             for each buf_temp-browse-handle
     1075               where buf_temp-browse-handle.browse-type = 'width':u
     1076             on error undo, next
     1077             :
     1078               assign
     1079                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1080               .
     1081             end.
     1082             assign
     1083               v-diasize-browse-handle :width = v-browse-width
     1084             .
     1085             for each buf_temp-diasize-handle
     1086             on error undo, next
     1087             :
     1088               assign
     1089                 v-object-handle = buf_temp-diasize-handle.handle-value
     1090               .
     1091               if v-object-handle <> v-diasize-resize-button
     1092               then do:
     1093                 assign
     1094                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1095                 .
     1096               end.
     1097             end.
     1098             run diasize_position-resize-button in this-procedure .
     1099           end.
     1100           assign
     1101             v-diasize-change-size = false
     1102           .
     1103           leave move_block .
     1104         end.
     1105       end.
     1106       assign
     1107         v-diasize-need-full-display = true
     1108       .
     1109       if v-diasize-change-size = false
     1110       then do:
     1111         assign
     1112           v-diasize-change-size = true
     1113         .
     1114       end.
     1115       else do:
     1116         return .
     1117       end.
     1118       assign
     1119         v-frame-width = frame Dialog-Frame :width
     1120         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1121         v-browse-width = v-diasize-browse-handle :width
     1122       .
     1123       for each buf_temp-browse-handle
     1124         where buf_temp-browse-handle.browse-type = 'width':u
     1125       :
     1126         assign
     1127           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1128         .
     1129       end.
     1130       for each buf_temp-diasize-handle
     1131       :
     1132         delete buf_temp-diasize-handle .
     1133       end.
     1134       assign
     1135         v-field-group-handle = frame Dialog-Frame :first-child
     1136       .
     1137       do while valid-handle(v-field-group-handle)
     1138       :
     1139         assign
     1140           v-object-handle = v-field-group-handle :first-child
     1141         .
     1142         do while valid-handle(v-object-handle)
     1143         :
     1144           if  v-object-handle <> v-diasize-browse-handle :handle
     1145           and v-object-handle <> v-diasize-resize-button
     1146           and can-query(v-object-handle, "row")
     1147           and can-query(v-object-handle, "height")
     1148           and ( v-object-handle :col + v-object-handle :width
     1149                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1150               )
     1151           then do:
     1152             find first buf_temp-browse-handle
     1153               where buf_temp-browse-handle.browse-type   = 'width':u
     1154                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1155               no-error .
     1156             if available buf_temp-browse-handle
     1157             then do:
     1158             end.
     1159             else do:
     1160               create buf_temp-diasize-handle .
     1161               assign
     1162                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1163                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1164               .
     1165             end.
     1166           end.
     1167           assign
     1168             v-object-handle = v-object-handle :next-sibling
     1169           .
     1170         end.
     1171         assign
     1172           v-field-group-handle = v-field-group-handle :next-sibling
     1173         .
     1174       end.
     1175       do with frame Dialog-Frame
     1176       :
     1177         hide v-diasize-resize-button .
     1178         v-diasize-resize-button :row = 1.
     1179         v-diasize-resize-button :column = 1.
     1180       end.
     1181       if p-change-value > 0
     1182       then do:
     1183         if frame Dialog-Frame :scrollable = true
     1184         then do:
     1185           assign
     1186             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1187             no-error .
     1188           if error-status :error
     1189           or error-status :get-message(1) <> ""
     1190           then do:
     1191             undo move_block, retry move_block.
     1192           end.
     1193         end.
     1194         assign
     1195           frame Dialog-Frame :width = v-frame-width + p-change-value
     1196           no-error .
     1197         if error-status :error
     1198         or error-status :get-message(1) <> ""
     1199         then do:
     1200           undo move_block, retry move_block.
     1201         end.
     1202         assign
     1203           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1204         no-error .
     1205         if error-status :error
     1206         or error-status :get-message(1) <> ""
     1207         then do:
     1208           undo move_block, retry move_block.
     1209         end.
     1210         for each buf_temp-browse-handle
     1211           where buf_temp-browse-handle.browse-type = 'width':u
     1212         on error undo move_block, retry move_block
     1213         :
     1214           assign
     1215             buf_temp-browse-handle.browse-handle :width
     1216               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1217             no-error .
     1218           if error-status :error
     1219           or error-status :get-message(1) <> ""
     1220           then do:
     1221             undo move_block, retry move_block .
     1222           end.
     1223         end.
     1224         for each buf_temp-diasize-handle
     1225         on error undo move_block, retry move_block
     1226         :
     1227           assign
     1228             v-object-handle = buf_temp-diasize-handle.handle-value
     1229           .
     1230           if v-object-handle <> v-diasize-resize-button
     1231           then do:
     1232             assign
     1233               v-object-handle :col = v-object-handle :col + p-change-value
     1234               no-error .
     1235             if error-status :error
     1236             or error-status :get-message(1) <> ""
     1237             then do:
     1238               undo move_block, retry move_block .
     1239             end.
     1240           end.
     1241         end.
     1242       end.
     1243       else do:
     1244         for each buf_temp-diasize-handle
     1245         on error undo move_block, retry move_block
     1246         :
     1247           assign
     1248             v-object-handle = buf_temp-diasize-handle.handle-value
     1249           .
     1250           if v-object-handle <> v-diasize-resize-button
     1251           then do:
     1252             assign
     1253               v-object-handle :col = v-object-handle :col + p-change-value
     1254               no-error .
     1255             if error-status :error
     1256             or error-status :get-message(1) <> ""
     1257             then do:
     1258               undo move_block, retry move_block .
     1259             end.
     1260           end.
     1261         end.
     1262         for each buf_temp-browse-handle
     1263           where buf_temp-browse-handle.browse-type = 'width':u
     1264         on error undo move_block, retry move_block
     1265         :
     1266           assign
     1267             buf_temp-browse-handle.browse-handle :width
     1268               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1269             no-error .
     1270           if error-status :error
     1271           or error-status :get-message(1) <> ""
     1272           then do:
     1273             undo move_block, retry move_block .
     1274           end.
     1275         end.
     1276         assign
     1277           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1278           no-error .
     1279         if error-status :error
     1280         or error-status :get-message(1) <> ""
     1281         then do:
     1282           undo move_block, retry move_block.
     1283         end.
     1284         assign
     1285           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1286         no-error .
     1287         if error-status :error
     1288         or error-status :get-message(1) <> ""
     1289         then do:
     1290           undo move_block, retry move_block.
     1291         end.
     1292         if frame Dialog-Frame :scrollable = true
     1293         then do:
     1294           assign
     1295             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1296           no-error .
     1297           if error-status :error
     1298           or error-status :get-message(1) <> ""
     1299           then do:
     1300             undo move_block, retry move_block.
     1301           end.
     1302         end.
     1303       end.
     1304       if p-move-resize
     1305       then do:
     1306         run diasize_position-resize-button in this-procedure .
     1307       end.
     1308       if v-diasize-wndstore = true
     1309       then do:
     1310         if connected("ub") = true
     1311         then do:
     1312           define variable v-cntxt-db-num        as integer   no-undo .
     1313           define variable v-cntxt-userid        as character no-undo .
     1314           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1315                                             , OUTPUT v-cntxt-userid
     1316                                             ) .
     1317           run gbl/wndsizew.p
     1318             (input  v-cntxt-db-num
     1319             ,input  v-cntxt-userid
     1320             ,input  v-diasize-proc-name
     1321             ,input  'width':u
     1322             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1323             ) .
     1324         end.
     1325       end.
     1326     end.
     1327     assign
     1328       v-diasize-change-size = false
     1329     .
     1330   end procedure.
     1331   procedure diasize_set-width :
     1332     define input  parameter p-new-width  as decimal   no-undo .
     1333     define input  parameter p-move-resize as logical   no-undo .
     1334     do
     1335     on error undo, return error return-value
     1336     :
     1337       run diasize_change-width in this-procedure
     1338         (input  (p-new-width - frame Dialog-Frame :width)
     1339         ,input  p-move-resize
     1340         ) .
     1341     end.
     1342   end procedure.
     1343   procedure diasize_position-resize-button :
     1344     do with frame Dialog-Frame
     1345     :
     1346       hide v-diasize-resize-button .
     1347       assign
     1348         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1349                     - 1
     1350                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1351         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1352                     - 1
     1353                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1354       .
     1355       view v-diasize-resize-button .
     1356     end.
     1357   end procedure.
     1358   on alt-right anywhere
     1359   do:
     1360     run diasize_change-width in this-procedure
     1361       (input 1
     1362       ,input true
     1363       ) .
     1364     return no-apply .
     1365   end.
     1366   on alt-left anywhere
     1367   do:
     1368     run diasize_change-width in this-procedure
     1369       (input -1
     1370       ,input true
     1371       ) .
     1372     return no-apply .
     1373   end.
     1374   on alt-down anywhere
     1375   do:
     1376     run diasize_change-height in this-procedure
     1377       (input 1
     1378       ,input true
     1379       ) .
     1380     return no-apply .
     1381   end.
     1382   on alt-up anywhere
     1383   do:
     1384     run diasize_change-height in this-procedure
     1385       (input -1
     1386       ,input true
     1387       ) .
     1388     return no-apply .
     1389   end.
     1390   on alt-enter of frame Dialog-Frame
     1391   do:
     1392     run diasize_maximize in this-procedure
     1393       (input  ?
     1394       ).
     1395     return no-apply .
     1396   end.
     1397   procedure diasize_end-move :
     1398     do
     1399     on error undo, return error return-value
     1400     :
     1401       define variable v-row-delta as decimal   no-undo .
     1402       define variable v-col-delta as decimal   no-undo .
     1403       define variable v-new-row as decimal   no-undo .
     1404       define variable v-new-col as decimal   no-undo .
     1405       assign
     1406         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1407         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1408       .
     1409       assign
     1410         v-row-delta = v-new-row - frame Dialog-Frame :height
     1411         v-col-delta = v-new-col - frame Dialog-Frame :width
     1412       .
     1413       run diasize_change-height in this-procedure
     1414         (input v-row-delta
     1415         ,input true
     1416         ) .
     1417       run diasize_change-width in this-procedure
     1418         (input v-col-delta
     1419         ,input true
     1420         ) .
     1421     end.
     1422   end procedure.
     1423   procedure diasize_maximize :
     1424     define input  parameter p-action as logical   no-undo .
     1425     do
     1426     on error undo, return error return-value
     1427     :
     1428       if p-action = ?
     1429       then do:
     1430         if v-diasize-need-maximize = true
     1431         then do:
     1432           assign
     1433             p-action = true
     1434           .
     1435         end.
     1436         else do:
     1437           assign
     1438             p-action = false
     1439           .
     1440         end.
     1441       end.
     1442       if p-action = true
     1443       then do:
     1444         run diasize_change-height in this-procedure
     1445           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1446               - frame Dialog-Frame :height-chars
     1447           ,input true
     1448           ) .
     1449         run diasize_change-width in this-procedure
     1450           (input session :width-chars
     1451               - frame Dialog-Frame :width-chars
     1452           ,input true
     1453           ) .
     1454         assign
     1455           v-diasize-need-maximize = false
     1456         .
     1457       end.
     1458       else do:
     1459         run diasize_change-width in this-procedure
     1460           (input v-diasize-orig-frame-width
     1461               - frame Dialog-Frame :width-chars
     1462           ,input true
     1463           ) .
     1464         run diasize_change-height in this-procedure
     1465           (input v-diasize-orig-frame-height
     1466               - frame Dialog-Frame :height-chars
     1467           ,input true
     1468           ) .
     1469         assign
     1470           v-diasize-need-maximize = true
     1471         .
     1472       end.
     1473     end.
     1474   end procedure.
     1475   procedure diasize_restore-orig-size :
     1476     do
     1477     on error undo, return error return-value
     1478     :
     1479       assign
     1480         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1481         v-diasize-current-frame-height = frame Dialog-Frame :height
     1482       .
     1483       run diasize_set-height in this-procedure
     1484         (input  v-diasize-orig-frame-height
     1485         ,input  true
     1486         ) .
     1487       run diasize_set-width in this-procedure
     1488         (input  v-diasize-orig-frame-width
     1489         ,input  true
     1490         ) .
     1491     end.
     1492   end procedure.
     1493   procedure diasize_restore-current-size :
     1494     do
     1495     on error undo, return error return-value
     1496     :
     1497       run diasize_set-height in this-procedure
     1498         (input  v-diasize-current-frame-height
     1499         ,input  true
     1500         ) .
     1501       run diasize_set-width in this-procedure
     1502         (input  v-diasize-current-frame-width
     1503         ,input  true
     1504         ) .
     1505     end.
     1506   end procedure.
     1507   procedure diasize_set-browse-handle :
     1508     define input  parameter p-browse-handle as handle   no-undo .
     1509     define buffer buf_temp-browse-handle for temp-browse-handle .
     1510     do
     1511     on error undo, return error return-value
     1512     :
     1513       assign
     1514         v-diasize-browse-handle = p-browse-handle
     1515       .
     1516       for each buf_temp-browse-handle
     1517       on error undo, return error return-value
     1518       :
     1519         delete buf_temp-browse-handle .
     1520       end.
     1521     end.
     1522   end procedure.
     1523   procedure diasize_add_browse :
     1524     define input  parameter p-browse-type   as character no-undo .
     1525     define input  parameter p-browse-handle as handle    no-undo .
     1526     define buffer buf_temp-browse-handle for temp-browse-handle .
     1527     do
     1528     on error undo, return error return-value
     1529     :
     1530       assign
     1531         v-diasize-browse-number = v-diasize-browse-number + 1
     1532       .
     1533       create buf_temp-browse-handle .
     1534       assign
     1535         buf_temp-browse-handle.browse-type   = p-browse-type
     1536         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1537         buf_temp-browse-handle.browse-handle = p-browse-handle
     1538       .
     1539     end.
     1540   end procedure.
     1541   procedure diasize_init :
     1542     define variable v-default-value    as logical   no-undo .
     1543     define variable v-restore-saved    as logical   no-undo .
     1544     define variable v-resize-value-str as character no-undo .
     1545     do
     1546     on error undo, return error return-value
     1547     :
     1548       do with frame Dialog-Frame
     1549       :
     1550         assign
     1551           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1552           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1553           v-diasize-browse-handle     = browse BROWSE-2 :handle
     1554         .
     1555         create button v-diasize-resize-button
     1556         assign
     1557           parent        = frame Dialog-Frame :first-child
     1558           label         = "s"
     1559           height-pixels = 16
     1560           width-pixels  = 16
     1561           visible       = true
     1562           sensitive     = true
     1563           movable       = true
     1564           triggers:
     1565             on end-move persistent run diasize_end-move in this-procedure .
     1566           end triggers.
     1567         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1568         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1569         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1570         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1571         assign
     1572           v-diasize-wndmax = false
     1573         .
     1574         if connected("ub") = true
     1575         then do:
     1576           define variable v-cntxt-db-num        as integer   no-undo .
     1577           define variable v-cntxt-userid        as character no-undo .
     1578           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1579                                             , OUTPUT v-cntxt-userid
     1580                                             ) .
     1581           run gbl/wndpar_r.p
     1582             (input  v-cntxt-db-num
     1583             ,input  v-cntxt-userid
     1584             ,input  'wndmax':U
     1585             ,output v-diasize-wndmax
     1586             ,output v-default-value
     1587             ) .
     1588         end.
     1589         assign
     1590           v-diasize-wndstore = false
     1591         .
     1592         if connected("ub") = true
     1593         then do:
     1594           run gbl/wndpar_r.p
     1595             (input  v-cntxt-db-num
     1596             ,input  v-cntxt-userid
     1597             ,input  'wndstore':U
     1598             ,output v-diasize-wndstore
     1599             ,output v-default-value
     1600             ) .
     1601         end.
     1602         assign
     1603           v-diasize-proc-name = entry(1, program-name(2), '.')
     1604         .
     1605         if v-diasize-wndstore = true
     1606         then do:
     1607           assign
     1608             v-restore-saved = false
     1609           .
     1610           if connected("ub") = true
     1611           then do:
     1612             run gbl/wndsizer.p
     1613               (input  v-cntxt-db-num
     1614               ,input  v-cntxt-userid
     1615               ,input  v-diasize-proc-name
     1616               ,input  'height':u
     1617               ,output v-resize-value-str
     1618               ) .
     1619             if v-resize-value-str <> '':U
     1620             then do:
     1621               run diasize_change-height in this-procedure
     1622                 (input  integer(v-resize-value-str)
     1623                 ,input  true
     1624                 ) .
     1625               assign
     1626                 v-restore-saved = true
     1627               .
     1628             end.
     1629           end.
     1630           if connected("ub") = true
     1631           then do:
     1632             run gbl/wndsizer.p
     1633               (input  v-cntxt-db-num
     1634               ,input  v-cntxt-userid
     1635               ,input  v-diasize-proc-name
     1636               ,input  'width':u
     1637               ,output v-resize-value-str
     1638               ) .
     1639             if v-resize-value-str <> '':U
     1640             then do:
     1641               run diasize_change-width in this-procedure
     1642                 (input  integer(v-resize-value-str)
     1643                 ,input  true
     1644                 ) .
     1645               assign
     1646                 v-restore-saved = true
     1647               .
     1648             end.
     1649           end.
     1650           if v-restore-saved <> true
     1651           then do:
     1652             if v-diasize-wndmax = true
     1653             then do:
     1654               run diasize_maximize in this-procedure
     1655                 (input  true
     1656                 ) .
     1657             end.
     1658           end.
     1659         end.
     1660         else do:
     1661           if v-diasize-wndmax = true
     1662           then do:
     1663             run diasize_maximize in this-procedure
     1664               (input  true
     1665               ) .
     1666           end.
     1667         end.
     1668       end.
     1669     end.
     1670   end procedure.
     1671   procedure diasize_need-full-display :
     1672     define output parameter p-need-full-display as logical   no-undo .
     1673     do
     1674     on error undo, return error return-value
     1675     :
     1676       assign
     1677         p-need-full-display = v-diasize-need-full-display
     1678       .
     1679       assign
     1680         v-diasize-need-full-display = false
     1681       .
     1682     end.
     1683   end procedure.
     1684   procedure get-context :
     1685      define output parameter p-db-num as integer          no-undo.
     1686      define output parameter p-user-id as character        no-undo.
     1687      define variable v-login               as character    no-undo.
     1688      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1689      define buffer buf_user-login  for ub.user-login .
     1690      do
     1691      on error undo, return error
     1692      :
     1693            FIND FIRST buf_sys-ctrl no-lock.
     1694            ASSIGN
     1695               v-login = USERID("ub")
     1696               p-db-num = buf_sys-ctrl.db-num
     1697            .
     1698            FIND FIRST buf_user-login
     1699                 WHERE buf_user-login.db-num = p-db-num
     1700                   AND buf_user-login.user-login = v-login
     1701                 no-lock
     1702                 no-error
     1703                 .
     1704            IF AVAILABLE buf_user-login
     1705            THEN DO:
     1706               assign
     1707                  p-user-id = buf_user-login.user-id
     1708               .
     1709            END.
     1710      end.
     1711   end procedure.
     1712       run diasize_init in this-procedure .
     1713   MAIN-BLOCK:
     1714   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1715      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1716     if parmode = 'ПРОСМОТР':U then do:
     1717       find first ub.auto-section where ub.auto-section.auto-num = parnum-tank and ub.auto-section.section-num = integer(parsec-num) NO-LOCK NO-ERROR.
     1718     end.
     1719     if parmode = 'ИЗМЕНЕНИЕ':U then do:
     1720       do transaction:
     1721         find first ub.auto-section where ub.auto-section.auto-num = parnum-tank and ub.auto-section.section-num = integer(parsec-num) exclusive-lock NO-ERROR.
     1722       end.
     1723     end.
     1724     if parmode = 'ДОБАВЛЕНИЕ':U then do:
     1725       varsec-num = 0.
     1726     end.
     1727     ELSE varsec-num = INTEGER(parsec-num).
     1728     if AVAILABLE ub.auto-section AND
     1729        (parmode = 'ПРОСМОТР':U or
     1730         parmode = 'ИЗМЕНЕНИЕ':U) then do:
     1731       assign
     1732         varsec-qnty   = ub.auto-section.brutto-qnty
     1733         F-dop-volume  = ub.auto-section.add-volume
     1734         .
     1735        case par-neck:
     1736           when 0 then
     1737              do:
     1738                 output to vtvt.txt.
     1739                 for each ub.auto-section-table exclusive-lock where ub.auto-section-table.auto-num = ub.auto-section.auto-num
     1740                    and ub.auto-section-table.section-num = ub.auto-section.section-num:
     1741                    create tt-section .
     1742                    assign
     1743                       tt-section.dif     = ub.auto-section-table.error
     1744                       tt-section.volume1 = ub.auto-section-table.volume-error
     1745                       tt-section.deltaV  = string(ub.auto-section-table.volume-between / 100)
     1746                    .
     1747                    export tt-section .
     1748                 end.
     1749                 output close.
     1750              end.
     1751           when 1 then
     1752              do:
     1753                 assign
     1754                    square-depth  = string(ub.auto-section.section-depth)
     1755                    square-lenght = string(ub.auto-section.length)
     1756                    square-width  = string(ub.auto-section.width)
     1757                    .
     1758              end.
     1759           when 2 then
     1760              do:
     1761                 assign
     1762                    ellipse-depth = string(ub.auto-section.section-depth)
     1763                    ellipse-max   = string(ub.auto-section.diameter-max)
     1764                    ellipse-min   = string(ub.auto-section.diameter-min)
     1765                    .
     1766              end.
     1767           when 3 then
     1768              do:
     1769                 assign
     1770                    varsec-diam-in     = string(ub.auto-section.diameter-min)
     1771                    varsec-diam-out    = string(ub.auto-section.diameter-max)
     1772                    varsec-diam-depth  = string(ub.auto-section.section-depth)
     1773                    varsec-diam-lenght = string(ub.auto-section.length)
     1774                    .
     1775              end.
     1776        end case .
     1777     END.
     1778     ELSE DO:
     1779         assign
     1780            varsec-qnty    = 0
     1781            varsec-diam-in = ''
     1782            .
     1783         if par-neck = 0 and partype-AC = 1 then
     1784         do:
     1785            do ii = -10 to 10:
     1786               if ii = 0 then next .
     1787               create tt-section .
     1788               assign
     1789                  tt-section.dif = ii
     1790                  .
     1791            end.
     1792         end.
     1793      END.
     1794      RUN local-enable_UI.
     1795      WAIT-FOR GO OF FRAME Dialog-Frame.
     1796   END.
     1797   RUN disable_UI.
     1798   PROCEDURE disable_UI :
     1799      HIDE FRAME Dialog-Frame.
     1800   END PROCEDURE.
     1801   PROCEDURE enable_UI :
     1802      DISPLAY varsec-num varsec-qnty F-dop-volume
     1803         WITH FRAME Dialog-Frame.
     1804      ENABLE b-cancel b-help F-dop-volume BROWSE-2
     1805         WITH FRAME Dialog-Frame.
     1806      VIEW FRAME Dialog-Frame.
     1807   END PROCEDURE.
     1808   PROCEDURE local-enable_UI :
     1809      RUN enable_ui.
     1810     if parmode = 'ДОБАВЛЕНИЕ':U or
     1811        parmode = 'ИЗМЕНЕНИЕ':U then do:
     1812        case par-neck:
     1813            when 2 then do:
     1814               enable
     1815               ellipse-depth
     1816               ellipse-max
     1817               ellipse-min
     1818               with frame Dialog-Frame .
     1819               display
     1820               ellipse-depth
     1821               ellipse-max
     1822               ellipse-min
     1823               with frame Dialog-Frame .
     1824               hide
     1825               square-depth
     1826               square-lenght
     1827               square-width
     1828               varsec-diam-in
     1829               varsec-diam-out
     1830               varsec-diam-depth
     1831               varsec-diam-lenght
     1832               BROWSE-2
     1833               in frame Dialog-Frame .
     1834            end.
     1835            when 1 then do:
     1836               enable
     1837               square-depth
     1838               square-lenght
     1839               square-width
     1840               with frame Dialog-Frame .
     1841               display
     1842               square-depth
     1843               square-lenght
     1844               square-width
     1845               with frame Dialog-Frame .
     1846               hide
     1847               ellipse-depth
     1848               ellipse-max
     1849               ellipse-min
     1850               varsec-diam-in
     1851               varsec-diam-out
     1852               varsec-diam-depth
     1853               varsec-diam-lenght
     1854               BROWSE-2
     1855               in frame Dialog-Frame .
     1856            end.
     1857            when 3 then do:
     1858               enable
     1859               varsec-diam-in
     1860               varsec-diam-out
     1861               varsec-diam-depth
     1862               varsec-diam-lenght
     1863               with frame Dialog-Frame .
     1864               display
     1865               varsec-diam-in
     1866               varsec-diam-out
     1867               varsec-diam-depth
     1868               varsec-diam-lenght
     1869               with frame Dialog-Frame .
     1870               hide
     1871               ellipse-depth
     1872               ellipse-max
     1873               ellipse-min
     1874               square-depth
     1875               square-lenght
     1876               square-width
     1877               BROWSE-2
     1878               in frame Dialog-Frame .
     1879            end.
     1880            when 0 then do:
     1881            if partype-AC = 1 then do:
     1882               enable
     1883               BROWSE-2
     1884               with frame Dialog-Frame .
     1885               OPEN QUERY BROWSE-2 FOR EACH tt-section exclusive-LOCK INDEXED-REPOSITION.
     1886            end.
     1887            else do:
     1888               hide
     1889               BROWSE-2
     1890               in frame Dialog-Frame .
     1891            end.
     1892               hide
     1893               ellipse-depth
     1894               ellipse-max
     1895               ellipse-min
     1896               varsec-diam-in
     1897               varsec-diam-out
     1898               varsec-diam-depth
     1899               varsec-diam-lenght
     1900               square-depth
     1901               square-lenght
     1902               square-width
     1903               in frame Dialog-Frame .
     1904            end.
     1905        end case .
     1906        enable varsec-num varsec-qnty b-save with frame Dialog-Frame.
     1907        if partype-AC = 2 then do:
     1908            hide
     1909                F-dop-volume
     1910                ellipse-depth
     1911                ellipse-max
     1912                ellipse-min
     1913                varsec-diam-in
     1914                varsec-diam-out
     1915                varsec-diam-depth
     1916                varsec-diam-lenght
     1917                square-depth
     1918                square-lenght
     1919                square-width
     1920                BROWSE-2
     1921                in frame Dialog-Frame .
     1922   end.
     1923        else enable F-dop-volume with frame Dialog-Frame .
     1924     end.
     1925     else do:
     1926        case par-neck:
     1927            when 2 then do:
     1928               disable
     1929               ellipse-depth
     1930               ellipse-max
     1931               ellipse-min
     1932               with frame Dialog-Frame .
     1933               display
     1934               ellipse-depth
     1935               ellipse-max
     1936               ellipse-min
     1937               with frame Dialog-Frame .
     1938               hide
     1939               square-depth
     1940               square-lenght
     1941               square-width
     1942               varsec-diam-in
     1943               varsec-diam-out
     1944               varsec-diam-depth
     1945               varsec-diam-lenght
     1946               BROWSE-2
     1947               in frame Dialog-Frame .
     1948            end.
     1949            when 1 then do:
     1950               disable
     1951               square-depth
     1952               square-lenght
     1953               square-width
     1954               with frame Dialog-Frame .
     1955               display
     1956               square-depth
     1957               square-lenght
     1958               square-width
     1959               with frame Dialog-Frame .
     1960               hide
     1961               ellipse-depth
     1962               ellipse-max
     1963               ellipse-min
     1964               varsec-diam-in
     1965               varsec-diam-out
     1966               varsec-diam-depth
     1967               varsec-diam-lenght
     1968               BROWSE-2
     1969               in frame Dialog-Frame .
     1970            end.
     1971            when 3 then do:
     1972               disable
     1973               varsec-diam-in
     1974               varsec-diam-out
     1975               varsec-diam-depth
     1976               varsec-diam-lenght
     1977               with frame Dialog-Frame .
     1978               display
     1979               varsec-diam-in
     1980               varsec-diam-out
     1981               varsec-diam-depth
     1982               varsec-diam-lenght
     1983               with frame Dialog-Frame .
     1984               hide
     1985               ellipse-depth
     1986               ellipse-max
     1987               ellipse-min
     1988               square-depth
     1989               square-lenght
     1990               square-width
     1991               BROWSE-2
     1992               in frame Dialog-Frame .
     1993            end.
     1994            when 0 then do:
     1995            if partype-AC = 1 then do:
     1996               display
     1997               BROWSE-2
     1998               with frame Dialog-Frame .
     1999               OPEN QUERY BROWSE-2 FOR EACH tt-section exclusive-LOCK INDEXED-REPOSITION.
     2000            end.
     2001            else do:
     2002               hide
     2003               BROWSE-2
     2004               in frame Dialog-Frame .
     2005            end.
     2006               hide
     2007               ellipse-depth
     2008               ellipse-max
     2009               ellipse-min
     2010               varsec-diam-in
     2011               varsec-diam-out
     2012               varsec-diam-depth
     2013               varsec-diam-lenght
     2014               square-depth
     2015               square-lenght
     2016               square-width
     2017               in frame Dialog-Frame .
     2018            end.
     2019        end case .
     2020        disable varsec-num varsec-qnty b-save with frame Dialog-Frame.
     2021        if partype-AC = 2 then
     2022        hide
     2023        BROWSE-2
     2024        F-dop-volume
     2025        ellipse-depth
     2026        ellipse-max
     2027        ellipse-min
     2028        varsec-diam-in
     2029        varsec-diam-out
     2030        varsec-diam-depth
     2031        varsec-diam-lenght
     2032        square-depth
     2033        square-lenght
     2034        square-width
     2035        in frame Dialog-Frame .
     2036        else disable F-dop-volume with frame Dialog-Frame .
     2037     end .
     2038   END PROCEDURE.
