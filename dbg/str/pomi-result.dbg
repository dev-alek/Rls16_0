        1   define input-output parameter p-InfoSec as class ibs.th.str.InfoSection .
        2   DEFINE BUTTON Btn_OK AUTO-GO
        3        LABEL "OK"
        4        SIZE 15 BY 1.14
        5        BGCOLOR 8 .
        6   DEFINE VARIABLE e-pokmi-warnings AS CHARACTER
        7        VIEW-AS EDITOR SCROLLBAR-VERTICAL
        8        SIZE 73 BY 2.62 NO-UNDO.
        9   DEFINE VARIABLE v-legend AS CHARACTER
       10        VIEW-AS EDITOR
       11        SIZE 69 BY 3.6 NO-UNDO.
       12   DEFINE VARIABLE f-deficit AS CHARACTER format "X(20)":U INITIAL 0
       13        LABEL "Масса недостачи (кг)"
       14         VIEW-AS TEXT
       15        SIZE 14 BY .62 NO-UNDO.
       16   DEFINE VARIABLE f-density AS CHARACTER format "X(20)":U INITIAL 0
       17        LABEL "Плотность НП (г/см3)"
       18         VIEW-AS TEXT
       19        SIZE 14 BY .62 NO-UNDO.
       20   DEFINE VARIABLE f-excess AS CHARACTER format "X(20)":U INITIAL 0
       21        LABEL "Масса излишка (кг)"
       22         VIEW-AS TEXT
       23        SIZE 14 BY .62 NO-UNDO.
       24   DEFINE VARIABLE f-fact-kg-qnty AS CHARACTER format "X(20)":U INITIAL 0
       25        LABEL "Масса НП, подлежащая оприходованию по результатам приема (кг)"
       26         VIEW-AS TEXT
       27        SIZE 14 BY .62 NO-UNDO.
       28   DEFINE VARIABLE f-fact-qnty AS CHARACTER format "X(20)":U INITIAL 0
       29        LABEL "Объем НП, подлежащий оприходованию по результатам приема (л)"
       30         VIEW-AS TEXT
       31        SIZE 14 BY .62 NO-UNDO.
       32   DEFINE VARIABLE f-limit AS CHARACTER format "X(20)":U INITIAL 0
       33        LABEL "Масса допустимого расхождения (кг)"
       34         VIEW-AS TEXT
       35        SIZE 14 BY .62 NO-UNDO.
       36   DEFINE VARIABLE f-norm-loss AS CHARACTER format "X(20)":U INITIAL 0
       37        LABEL "Масса ЕУ при перевозке (кг)"
       38         VIEW-AS TEXT
       39        SIZE 14 BY .62 NO-UNDO.
       40   DEFINE VARIABLE f-pokmi-kg-qnty AS CHARACTER format "X(20)":U INITIAL 0
       41        LABEL "Масса НП, по результатам расчета модуля ПОкМИ (кг)"
       42         VIEW-AS TEXT
       43        SIZE 14 BY .62 NO-UNDO.
       44   DEFINE VARIABLE f-pokmi-qnty AS CHARACTER format "X(20)":U INITIAL 0
       45        LABEL "Объем НП, по результатам расчета модуля ПОкМИ (л)"
       46         VIEW-AS TEXT
       47        SIZE 14 BY .62 NO-UNDO.
       48   DEFINE VARIABLE f-temperature AS CHARACTER format "X(20)":U INITIAL 0
       49        LABEL "Температура (С)"
       50         VIEW-AS TEXT
       51        SIZE 14 BY .62 NO-UNDO.
       52   DEFINE FRAME Dialog-Frame
       53        e-pokmi-warnings AT ROW 12.02 COL 2 NO-LABEL WIDGET-ID 40
       54        v-legend AT ROW 14.84 COL 2 NO-LABEL WIDGET-ID 2
       55        Btn_OK AT ROW 16.74 COL 72
       56        f-fact-kg-qnty AT ROW 1.48 COL 2 WIDGET-ID 4
       57        f-pokmi-kg-qnty AT ROW 2.52 COL 2 WIDGET-ID 6
       58        f-limit AT ROW 3.52 COL 2 WIDGET-ID 8
       59        f-excess AT ROW 4.48 COL 2 WIDGET-ID 10
       60        f-deficit AT ROW 5.48 COL 2 WIDGET-ID 12
       61        f-norm-loss AT ROW 6.43 COL 2 WIDGET-ID 14
       62        f-fact-qnty AT ROW 7.43 COL 2 WIDGET-ID 16
       63        f-pokmi-qnty AT ROW 8.38 COL 2 WIDGET-ID 18
       64        f-density AT ROW 9.33 COL 2 WIDGET-ID 20
       65        f-temperature AT ROW 10.24 COL 2 WIDGET-ID 22
       66        "Предупреждения:" VIEW-AS TEXT
       67             SIZE 22 BY .62 AT ROW 11.25 COL 3 WIDGET-ID 38
       68        SPACE(2.00) SKIP(1.5)
       69       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
       70            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
       71            TITLE "Результат расчета"
       72            DEFAULT-BUTTON Btn_OK WIDGET-ID 100.
       73   ASSIGN
       74          FRAME Dialog-Frame:SCROLLABLE       = FALSE
       75          FRAME Dialog-Frame:HIDDEN           = TRUE.
       76   ASSIGN
       77          e-pokmi-warnings:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
       78   ASSIGN
       79          f-deficit:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
       80   ASSIGN
       81          f-density:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
       82   ASSIGN
       83          f-excess:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
       84   ASSIGN
       85          f-fact-kg-qnty:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
       86   ASSIGN
       87          f-fact-qnty:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
       88   ASSIGN
       89          f-limit:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
       90   ASSIGN
       91          f-norm-loss:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
       92   ASSIGN
       93          f-pokmi-kg-qnty:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
       94   ASSIGN
       95          f-pokmi-qnty:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
       96   ASSIGN
       97          f-temperature:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
       98   ASSIGN
       99          v-legend:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      100   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      101   DO:
      102     APPLY "END-ERROR":U TO SELF.
      103   END.
      104   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      105   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      106   MAIN-BLOCK:
      107   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      108      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      109     assign
      110       v-legend = "Для посекционных сверок выводится результат расчета по секциям отдельно."
      111                + " Для общих сверок выводится результат расчета, суммированный по всем секциям."
      112                + " Для сообщающихся резервуаров выводится результат расчета, суммированный по всем сообщающимся резервуарам."
      113     .
      114     if p-InfoSec:AccMeth = 1
      115     then do :
      116       assign
      117         frame Dialog-Frame:title = frame Dialog-Frame:title + " (Принято к учёту)"
      118         f-fact-kg-qnty    = trim(string(p-InfoSec:FactKgQnty, "->>,>>>,>>9.9":U))
      119         f-pokmi-kg-qnty   = trim(string(p-InfoSec:TankWeightRvs, "->>,>>>,>>9.9":U))
      120         f-limit           = trim(string(p-InfoSec:AccAbsFact, "->>,>>>,>>9.9":U))
      121         f-excess          = trim(string(p-InfoSec:Excess, "->>,>>>,>>9.9":U))
      122         f-deficit         = trim(string(p-InfoSec:Deficit, "->>,>>>,>>9.9":U))
      123         f-norm-loss       = trim(string(p-InfoSec:NaturalLoss, "->>,>>>,>>9.9":U))
      124         f-fact-qnty       = trim(string(p-InfoSec:FactQnty, "->>,>>>,>>9":U))
      125         f-pokmi-qnty      = trim(string(p-InfoSec:TankVolPomiRvs, "->>,>>>,>>9":U))
      126         f-density         = trim(string((p-InfoSec:FactKgQnty / p-InfoSec:FactQnty), "9.9999"))
      127         f-temperature     = trim(string(p-InfoSec:AvgTempRvs, "->>9.9"))
      128         e-pokmi-warnings  = p-InfoSec:PokmiWarningsRVS
      129       .
      130     end .
      131     else do :
      132       assign
      133         frame Dialog-Frame:title = frame Dialog-Frame:title + " (Справка)"
      134         f-fact-kg-qnty    = ""
      135         f-pokmi-kg-qnty   = trim(string(p-InfoSec:TankWeightRvs, "->>,>>>,>>9.9":U))
      136         f-limit           = trim(string(p-InfoSec:AccAbsFact, "->>,>>>,>>9.9":U))
      137         f-excess          = ""
      138         f-deficit         = ""
      139         f-norm-loss       = trim(string(p-InfoSec:NaturalLoss, "->>,>>>,>>9.9":U))
      140         f-fact-qnty       = ""
      141         f-pokmi-qnty      = trim(string(p-InfoSec:TankVolPomiRvs, "->>,>>>,>>9":U))
      142         f-density         = trim(string((p-InfoSec:TankWeightRvs / p-InfoSec:TankVolPomiRvs), "9.9999"))
      143         f-temperature     = trim(string(p-InfoSec:AvgTempRvs, "->>9.9"))
      144         e-pokmi-warnings  = p-InfoSec:PokmiWarningsRVS
      145       .
      146     end .
      147     RUN enable_UI.
      148     WAIT-FOR GO OF FRAME Dialog-Frame.
      149   END.
      150   RUN disable_UI.
      151   PROCEDURE disable_UI :
      152     HIDE FRAME Dialog-Frame.
      153   END PROCEDURE.
      154   PROCEDURE enable_UI :
      155     DISPLAY v-legend f-fact-kg-qnty f-pokmi-kg-qnty f-limit f-excess f-deficit
      156             f-norm-loss f-fact-qnty f-pokmi-qnty f-density f-temperature
      157         WITH FRAME Dialog-Frame.
      158     ENABLE e-pokmi-warnings Btn_OK
      159         WITH FRAME Dialog-Frame.
      160     VIEW FRAME Dialog-Frame.
      161   END PROCEDURE.
