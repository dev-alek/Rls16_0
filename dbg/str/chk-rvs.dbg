      588   function is-gas returns logical
      589           (input p-gds-code as integer):
      590   define variable result as logical no-undo.
      591   define variable c-value as character no-undo.
      592   define variable c-type as character no-undo.
      593   do on error undo, return error:
      594           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
      595         (input  p-gds-code
      596         ,input  'fuel-type':U
      597         ,output c-value
      598         ,output c-type) no-error.
      599   end.
      600   result = logical(c-value = 'metan':U) no-error.
      601   return result.
      602   end function.
      603   procedure placelib_write-attr:
      604   define input  parameter p-code     like ub.place-attr.attr-code .
      605   define input  parameter p-obj-code like ub.place-attr.obj-code .
      606   define input  parameter p-obj-type like ub.place-attr.obj-type .
      607   define input  parameter p-pl-code  like ub.place-attr.pl-code .
      608   define input  parameter p-value    like ub.place-attr.attr-value .
      609   define output parameter p-ok       as logical.
      610   define buffer buf_place-attr for ub.place-attr .
      611     do on error undo, return error return-value :
      612        p-ok = false.
      613        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      614                                                   and buf_place-attr.obj-code    = p-obj-code
      615                                                   and buf_place-attr.obj-type    = p-obj-type
      616                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      617        if not available buf_place-attr then do :
      618           create buf_place-attr.
      619           assign
      620             buf_place-attr.attr-code   = p-code
      621             buf_place-attr.attr-value  = p-value
      622             buf_place-attr.obj-code    = p-obj-code
      623             buf_place-attr.obj-type    = p-obj-type
      624             buf_place-attr.pl-code     = p-pl-code
      625           .
      626           p-ok = true.
      627        end.
      628        else do:
      629           buf_place-attr.attr-value  = p-value .
      630           p-ok = true.
      631        end.
      632     end.
      633   end.
      634   procedure placelib_get-attr:
      635   define input  parameter  p-code     like ub.place-attr.attr-code .
      636   define input  parameter  p-obj-code like ub.place-attr.obj-code .
      637   define input  parameter  p-obj-type like ub.place-attr.obj-type .
      638   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
      639   define output parameter  p-value    like ub.place-attr.attr-value .
      640   define output parameter  p-ok       as logical.
      641   define buffer buf_place-attr for ub.place-attr .
      642     do on error undo, return error return-value :
      643        p-ok = false.
      644        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
      645                                                   and buf_place-attr.obj-code    = p-obj-code
      646                                                   and buf_place-attr.obj-type    = p-obj-type
      647                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      648        if available buf_place-attr then do :
      649          p-value = buf_place-attr.attr-value.
      650          p-ok = true.
      651        end.
      652        else do :
      653          p-ok = false.
      654        end.
      655     end.
      656   end.
      657   procedure placelib_del-attr:
      658   define input parameter  p-code     like ub.place-attr.attr-code .
      659   define input parameter  p-obj-code like ub.place-attr.obj-code .
      660   define input parameter  p-obj-type like ub.place-attr.obj-type .
      661   define input parameter  p-pl-code  like ub.place-attr.pl-code .
      662   define input parameter  p-value    like ub.place-attr.attr-value .
      663   define output parameter p-ok       as logical.
      664   define buffer buf_place-attr for ub.place-attr .
      665     do on error undo, return error return-value :
      666        p-ok = false.
      667        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
      668                                                   and buf_place-attr.obj-code    = p-obj-code
      669                                                   and buf_place-attr.obj-type    = p-obj-type
      670                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
      671        if available buf_place-attr then do :
      672           delete buf_place-attr.
      673           p-ok = true.
      674        end.
      675     end.
      676   end.
      677   define input parameter parrecid as recid no-undo.
      678   define buffer aft-rvs-doc       for ub.rvs-doc.
      679   define buffer bef-rvs-doc       for ub.rvs-doc.
      680   define buffer broser-rvs-doc    for ub.rvs-doc.
      681   define buffer shift_rvs-doc     for ub.rvs-doc.
      682   define buffer open_rvs-doc      for ub.rvs-doc.
      683   define buffer rvs-shift-rvs-doc for ub.rvs-doc.
      684   define variable varis-back-date as logical initial "no" no-undo.
      685   tr:
      686   do transaction
      687   on error   undo tr, return error
      688   on end-key undo tr, return error
      689   on stop    undo tr, return error
      690   :
      691     find ub.rvs-doc exclusive-lock
      692       where recid( ub.rvs-doc ) = parrecid
      693       no-error.
      694     if not available ub.rvs-doc then do:
      695       undo tr, return error "Ошибка при поиске документа сверки (файл chk-rvs.p)".
      696     end.
      697     find first ub.trn-doc
      698       where ub.trn-doc.doc-code = ub.rvs-doc.out-code
      699       no-error.
      700     if available ub.trn-doc
      701       and ub.trn-doc.is-back-date = yes
      702     then do:
      703       assign
      704         varis-back-date = yes
      705       .
      706     end.
      707     if varis-back-date <> yes
      708       and not ( ub.rvs-doc.status_ = 'факт':U and ub.rvs-doc.is-corr = yes )
      709     then do:
      710       find first aft-rvs-doc no-lock
      711         where aft-rvs-doc.obj-type    = ub.rvs-doc.obj-type
      712           and aft-rvs-doc.obj-code    = ub.rvs-doc.obj-code
      713           and ( aft-rvs-doc.shift-date >  ub.rvs-doc.shift-date
      714                 or ( aft-rvs-doc.shift-date  = ub.rvs-doc.shift-date
      715                      and aft-rvs-doc.shift-num  >  ub.rvs-doc.shift-num
      716                    )
      717               )
      718           and aft-rvs-doc.status_     = 'факт':U
      719         no-error.
      720       if available aft-rvs-doc then do:
      721         undo tr, return error substitute( "Уже имеется более поздняя сверка: &1 Смена: &2 &3",
      722                                           aft-rvs-doc.rvs-code, aft-rvs-doc.shift-date, (if aft-rvs-doc.shift-name = string(aft-rvs-doc.shift-num) then aft-rvs-doc.shift-name else aft-rvs-doc.shift-name + "(" + string(aft-rvs-doc.shift-num) + ")")).
      723       end.
      724       find first rvs-shift-rvs-doc no-lock
      725         where rvs-shift-rvs-doc.obj-type    = ub.rvs-doc.obj-type
      726           and rvs-shift-rvs-doc.obj-code    = ub.rvs-doc.obj-code
      727           and rvs-shift-rvs-doc.shift-date  = ub.rvs-doc.shift-date
      728           and rvs-shift-rvs-doc.shift-num   = ub.rvs-doc.shift-num
      729           and rvs-shift-rvs-doc.status_     = 'факт':U
      730           and rvs-shift-rvs-doc.rvs-type    = 'смена':U
      731           and recid( rvs-shift-rvs-doc )   <> recid( ub.rvs-doc )
      732         no-error.
      733       if available rvs-shift-rvs-doc then do:
      734         undo tr, return error substitute( "Уже есть сверка по смене: &1 Смена: &2 &3 Формирование иных сверок невозможно.",
      735                                           rvs-shift-rvs-doc.rvs-code,
      736                                           rvs-shift-rvs-doc.shift-date,
      737                                           (if rvs-shift-rvs-doc.shift-name = string(rvs-shift-rvs-doc.shift-num) then rvs-shift-rvs-doc.shift-name else rvs-shift-rvs-doc.shift-name + "(" + string(rvs-shift-rvs-doc.shift-num) + ")") ).
      738       end.
      739     end.
      740     if ub.rvs-doc.status_ <> 'новый':U then do:
      741       if ub.rvs-doc.rvs-type = 'после_док':U then do:
      742         find first broser-rvs-doc no-lock where
      743              broser-rvs-doc.out-code = ub.rvs-doc.out-code and
      744              broser-rvs-doc.rvs-type = 'перед_док':U   no-error.
      745         if not available broser-rvs-doc then do:
      746           undo tr, return error "Для сверки " + 'после_док':U + " должна существовать сверка " + 'перед_док':U.
      747         end.
      748       end.
      749     end.
      750     if ub.rvs-doc.status_ = 'факт':U then do:
      751       for each ub.rvs-line no-lock where ub.rvs-line.rvs-code = ub.rvs-doc.rvs-code :
      752         if is-gas(ub.rvs-line.gds-code) then next.
      753         define variable is-vir as logical no-undo.
      754         define variable v-value as character no-undo.
      755         define variable v-ok as logical no-undo.
      756         run placelib_get-attr(input "place-virtual"
      757                              ,input rvs-line.obj-code
      758                              ,input rvs-line.obj-type
      759                              ,input rvs-line.pl-code
      760                              ,output v-value
      761                              ,output v-ok) no-error.
      762         is-vir = if (v-ok and logical(v-value)) then true else false.
      763         if is-vir then next.
      764         if ub.rvs-line.state-measure-qnty = ? or
      765            ub.rvs-line.state-density      = ? or
      766            ub.rvs-line.state-density      = 0 then do:
      767            find ub.goods no-lock where ub.goods.gds-code = ub.rvs-line.gds-code.
      768            undo tr, return error
      769              substitute( "Вы не сделали сверку товара(не установлено кол-во или плотность): &1 &2 &3 &4 по месту хранения: &5",
      770                          ub.goods.artic, ub.goods.prod-type, ub.goods.prod-code, ub.goods.gds-name, ub.rvs-line.pl-code ).
      771         end.
      772       end.
      773       for each ub.rvs-line-pump no-lock where ub.rvs-line-pump.rvs-code = ub.rvs-doc.rvs-code :
      774         if ub.rvs-line-pump.state-el-cnt  = ? or
      775            ub.rvs-line-pump.state-mh-cnt  = ? then do:
      776           undo tr, return error substitute( "Вы не сделали сверку по ТРК &1 пистолету &2",
      777                                             ub.rvs-line-pump.pump-code, ub.rvs-line-pump.nozzle-code ).
      778         end.
      779       end.
      780       run gbl/chk-date.p
      781         ( input ub.rvs-doc.obj-type
      782         , input ub.rvs-doc.obj-code
      783         , input ub.rvs-doc.fact-date
      784         , input ub.rvs-doc.fact-time
      785         , input ub.rvs-doc.shift-date
      786         , input ub.rvs-doc.shift-num
      787         , input yes
      788         ) no-error.
      789       if error-status :error then do:
      790         undo tr, return error
      791           substitute( "Неверная дата и время в документе сверки  fact-date &1 fact-time &2 shift-date &3 shift-num &4 ",
      792                       ub.rvs-doc.fact-date, ub.rvs-doc.fact-time, ub.rvs-doc.shift-date, ub.rvs-doc.shift-num ).
      793       end.
      794     end.
      795     if ub.rvs-doc.rvs-type = 'смена':U then do:
      796       find first ub.icnt-doc no-lock where
      797                  ub.icnt-doc.obj-type = ub.rvs-doc.obj-type and
      798                  ub.icnt-doc.obj-code = ub.rvs-doc.obj-code and
      799                  ub.icnt-doc.status_  > 'факт':U             no-error.
      800       if available ub.icnt-doc then do:
      801         undo tr, return error
      802           substitute( 'Есть открытый документ инвентаризации счетчиков ТРК "&1". Создание сверки по смене недопустимо.',
      803                       ub.icnt-doc.doc-code ).
      804       end.
      805       find first ub.icnt-doc no-lock where
      806                  ub.icnt-doc.obj-type = ub.rvs-doc.obj-type and
      807                  ub.icnt-doc.obj-code = ub.rvs-doc.obj-code and
      808                  ub.icnt-doc.status_  < 'факт':U             no-error.
      809       if available ub.icnt-doc then do:
      810         undo tr, return error
      811           substitute( 'Есть открытый документ инвентаризации счетчиков ТРК "&1". Создание сверки по смене недопустимо.',
      812                       ub.icnt-doc.doc-code ).
      813       end.
      814       find first ub.wth-doc no-lock where
      815                  ub.wth-doc.obj-type = ub.rvs-doc.obj-type and
      816                  ub.wth-doc.obj-code = ub.rvs-doc.obj-code and
      817                  ub.wth-doc.status_  > 'факт':U             no-error.
      818       if available ub.wth-doc then do:
      819         undo tr, return error
      820           substitute( 'Есть открытый документ мат. ценностей "&1". Создание сверки по смене недопустимо.',
      821                       ub.wth-doc.doc-code ).
      822       end.
      823       find first ub.wth-doc no-lock where
      824                  ub.wth-doc.obj-type = ub.rvs-doc.obj-type and
      825                  ub.wth-doc.obj-code = ub.rvs-doc.obj-code and
      826                  ub.wth-doc.status_  < 'факт':U             no-error.
      827       if available ub.wth-doc then do:
      828         undo tr, return error
      829           substitute( 'Есть открытый документ мат. ценностей "&1". Создание сверки по смене недопустимо.',
      830                       ub.wth-doc.doc-code ).
      831       end.
      832       find first open_rvs-doc no-lock where
      833                  open_rvs-doc.obj-type  = ub.rvs-doc.obj-type and
      834                  open_rvs-doc.obj-code  = ub.rvs-doc.obj-code and
      835                  open_rvs-doc.status_   > 'факт':U             and
      836                  recid( open_rvs-doc ) <> recid( ub.rvs-doc ) and
      837                  open_rvs-doc.rvs-type <> 'проверка':U         no-error.
      838       if available open_rvs-doc then do:
      839         undo tr, return error
      840           substitute( 'Есть открытый документ сверки "&1". Создание сверки по смене недопустимо.', open_rvs-doc.rvs-code ).
      841       end.
      842       find first open_rvs-doc no-lock where
      843                  open_rvs-doc.obj-type =  ub.rvs-doc.obj-type and
      844                  open_rvs-doc.obj-code =  ub.rvs-doc.obj-code and
      845                  open_rvs-doc.status_  <  'факт':U             and
      846                  recid( open_rvs-doc ) <> recid( ub.rvs-doc ) and
      847                  open_rvs-doc.rvs-type <> 'проверка':U         no-error.
      848       if available open_rvs-doc then do:
      849         undo tr, return error
      850           substitute( 'Есть открытый документ сверки "&1". Создание сверки по смене недопустимо.', open_rvs-doc.rvs-code ).
      851       end.
      852       find first ub.inkas no-lock where
      853                  ub.inkas.obj-type = ub.rvs-doc.obj-type and
      854                  ub.inkas.obj-code = ub.rvs-doc.obj-code and
      855                  ub.inkas.status_  > 'факт':U             no-error.
      856       if available ub.inkas then do:
      857         undo tr, return error
      858           substitute( 'Есть незакрытая продажа "&1". Создание сверки по смене недопустимо.', ub.inkas.inkas-code ).
      859       end.
      860       find first ub.inkas no-lock where
      861                  ub.inkas.obj-type = ub.rvs-doc.obj-type and
      862                  ub.inkas.obj-code = ub.rvs-doc.obj-code and
      863                  ub.inkas.status_  < 'факт':U             no-error.
      864       if available ub.inkas then do:
      865         undo tr, return error
      866           substitute( 'Есть незакрытая продажа "&1". Создание сверки по смене недопустимо.', ub.inkas.inkas-code ).
      867       end.
      868     end.
      869   end.
