     5443                   ).
     5444               end.
     5445               undo, return error substitute("&1 &2 &3&4Не удалось зарезервировать товар по документу пр-ва &5 при перемещении со склада.&4&6&4&7"
     5446                                             ,vss-workfile
     5447                                             ,vss-revision
     5448                                             ,vss-description
     5449                                             ,chr(10)
     5450                                             , buf_fbr-doc.doc-code
     5451                                             , error-status:get-message(1)
     5452                                             , return-value ) .
     5453           end.
     5454           run writelog in this-procedure (
     5455                 input log-file-name
     5456               , input 0
     5457               , input "=====*** Перемещение товаров со склада завершено. ***============================="
     5458           ).
     5459           for each temp_fbrrep-goods
     5460           on error undo, return error
     5461           :
     5462               run set-price-sale in this-procedure (
     5463                     input buf_fbr-doc.doc-code
     5464                   , input temp_fbrrep-goods.artic
     5465                   , input temp_fbrrep-goods.prod-type
     5466                   , input temp_fbrrep-goods.prod-code
     5467                   , input temp_fbrrep-goods.gds-code
     5468               ) no-error.
     5469               if error-status :error
     5470               then do:
     5471                 undo, return error substitute("&1 &2 &3&4Ошибка при определении в документе пр-ва &5&4" +
     5472                                               "продажной цены ингредиента, перемещенного со склада на кухню ресторана.&4Товар &6 &7&4&8&4&9"
     5473                                               ,vss-workfile
     5474                                               ,vss-revision
     5475                                               ,vss-description
     5476                                               ,chr(10)
     5477                                               ,buf_fbr-doc.doc-code
     5478                                               ,temp_fbrrep-goods.artic
     5479                                               ,temp_fbrrep-goods.gds-name
     5480                                               ,error-status:get-message(1)
     5481                                               ,return-value) .
     5482               end.
     5483           end.
     5484       end.
     5485       assign
     5486           p-reserved = no
     5487       .
     5488       if buf_fbr-doc.is-free = no
     5489       then do:
     5490           run fbrlib-put-in-order-recipe in this-procedure (
     5491               input buf_fbr-doc.doc-code
     5492           ) no-error.
     5493           if error-status :error
     5494           then do:
     5495              undo, return error substitute("&1 &2 &3&4Не удалось вычислить последовательность рецептов в документе производства &5&4&6&4&7"
     5496                                           ,vss-workfile
     5497                                           ,vss-revision
     5498                                           ,vss-description
     5499                                           ,chr(10)
     5500                                           , buf_fbr-doc.doc-code
     5501                                           , error-status:get-message(1)
     5502                                           , return-value ) .
     5503           end.
     5504           if p-autofbr = yes
     5505           then do:
     5506               assign
     5507                   v-del-zero-lines = yes
     5508               .
     5509           end.
     5510           reserv-fbr-line:
     5511           for each temp_recipe-order no-lock
     5512           on error undo, return error
     5513           :
     5514               run check-recipe in this-procedure (
     5515                     input buf_fbr-doc.doc-code
     5516                   , input temp_recipe-order.recipe-code
     5517                   , input v-del-zero-lines
     5518                   , output v-del-zero-lines
     5519                   , output v-ok
     5520               ) no-error.
     5521               if error-status :error
     5522               then do:
     5523                 undo, return error substitute("&1 &2 &3&4Ошибка проверки рецепта документа &5 Номер рецепта &6.&4&7&4&8"
     5524                                               ,vss-workfile
     5525                                               ,vss-revision
     5526                                               ,vss-description
     5527                                               ,chr(10)
     5528                                               , buf_fbr-doc.doc-code
     5529                                               , temp_recipe-order.recipe-code
     5530                                               , error-status:get-message(1)
     5531                                               , return-value ) .
     5532               end.
     5533               if v-ok = no
     5534               then do:
     5535                   run writelog in this-procedure (
     5536                         input log-file-name
     5537                       , input 0
     5538                       , input "=====*** fbr-rsrv.p ***========= ошибка при проверке рецепта  ========"
     5539                   ).
     5540                   assign
