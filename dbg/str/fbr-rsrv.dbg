     5399                                               , string( temp_fbrrep-goods.artic, "X(17)" )
     5400                                               , string( temp_fbrrep-goods.write-off-qnty - temp_fbrrep-goods.income-qnty - v-kitchen-free-qnty, ">>>,>>>,>>>.999" )
     5401                                               , string( ( if v-store-free-qnty - ( temp_fbrrep-goods.write-off-qnty - temp_fbrrep-goods.income-qnty - v-kitchen-free-qnty ) < 0
     5402                                                           then ( temp_fbrrep-goods.write-off-qnty - temp_fbrrep-goods.income-qnty - v-kitchen-free-qnty ) - v-store-free-qnty
     5403                                                           else 0 ), ">>>,>>>,>>>.999" )
     5404                                               , string( temp_fbrrep-goods.gds-name, "X(60)" )
     5405                                         )
     5406                   ).
     5407               end.
     5408           end.
     5409           run writelog in this-procedure (
     5410                 input log-file-name
     5411               , input 5
     5412               , input substitute( "Товары, которые надо переместить на кухню ( &1 &2 ) со склада ( &3 &4 )"
     5413                                   , buf_fbr-doc.obj-type
     5414                                   , buf_fbr-doc.obj-code
