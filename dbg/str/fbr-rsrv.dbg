     1249                                   , chr(10)
     1250                                   , error-status:get-message(1)
     1251                                   , return-value ).
     1252   end.
     1253   create buf_fbr-doc.
     1254   assign
     1255   buf_fbr-doc.doc-code  = v-doc-code
     1256   buf_fbr-doc.creid     = p-userid
     1257   buf_fbr-doc.doc-date  = v-today
     1258   buf_fbr-doc.doc-type  = 'производство':U
