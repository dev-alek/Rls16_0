     1192     )  .
     1193   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1194   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1195     (output v-db-num
     1196     )  .
     1197   if v-obj-db-num <> v-db-num then do:
     1198     return error substitute("Запрещено создание документа производства в чужой БД:&1БД &2&3 - &4&1текущая БД - &5"
     1199                             , chr(10)
     1200                             , p-obj-type
     1201                             , p-obj-code
     1202                             , v-obj-db-num
     1203                             , v-db-num).
     1204   end.
     1205   run cur-time in this-procedure ( output v-today, output v-time).
     1206   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1207   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1208     (input  p-obj-type
     1209     ,input  p-obj-code
     1210     ,output v-today
     1211     )  .
