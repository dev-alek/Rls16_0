     3157       ).
     3158       find first buf_trn-doc no-lock
     3159            where buf_trn-doc.doc-code = v-doc-code
     3160       no-error.
     3161       if not available buf_trn-doc
     3162       then do:
     3163           if p-doc-type <> 'спи':U
     3164           then do:
     3165               message
     3166                   "Не найден документ '" p-doc-type "'"
     3167                   "по документу производства " p-fbr-doc-code
     3168               view-as alert-box.
     3169               undo, return error.
     3170           end.
     3171           else do:
     3172           end.
     3173       end.
     3174       else do:
     3175           assign
     3176               v-trn-doc-recid = recid( buf_trn-doc )
     3177               v-ext-doc-type  = buf_trn-doc.ext-doc-type
     3178           .
     3179           if v-ext-doc-type = 'ev':U
     3180           then do:
     3181               find first buf_pri_trn-doc no-lock
     3182                    where buf_pri_trn-doc.out-code     = v-doc-code
     3183                      and buf_pri_trn-doc.ext-doc-type = 'iv':U
     3184               no-error.
     3185               if available buf_pri_trn-doc
     3186               then do:
     3187                   run str/del-doc.p (
     3188                         input parparentproc
     3189                       , input buf_pri_trn-doc.doc-code
     3190                       , input v-cntxt-db-num
     3191                       , input "delfbr.err"
     3192                       , input ?
     3193                       , input p-fbr-doc-code
     3194                       , input v-cntxt-userid
     3195                       , input 0
     3196                       , input (if p-ph-chip-num <> ?
     3197                               then p-ph-chip-num
     3198                               else (if varchip-code <> 0
     3199                                   then varchip-code
     3200                                   else ?)
     3201                               )
     3202                       , output varchip-code2
     3203                   ) no-error.
     3204                   if error-status :error
     3205                   then do:
     3206                     undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     3207                                                   ,buf_pri_trn-doc.doc-code
     3208                                                   ,p-fbr-doc-code
     3209                                                   , chr(10)
     3210                                                   , error-status:get-message(1)
     3211                                                   , return-value ).
     3212                   end.
     3213               end.
     3214           end.
     3215           define buffer buf_out_trn-doc       for ub.trn-doc.
     3216           if p-doc-type = 'при':U
     3217           then do:
     3218               assign
     3219                   v-chip-counter = 0
     3220               .
     3221               for each buf_out_trn-doc exclusive-lock
     3222                  where buf_out_trn-doc.out-code = buf_trn-doc.doc-code
     3223               on error undo, return error
     3224               :
     3225                   assign
     3226                       v-chip-counter = v-chip-counter + 1
     3227                   .
     3228                   if v-chip-counter > 1
     3229                   then do:
     3230                       assign
     3231                           varchip-code = varchip-code2
     3232                       .
     3233                   end.
     3234                   run str/del-doc.p (
     3235                         input parparentproc
     3236                       , input buf_out_trn-doc.doc-code
     3237                       , input v-cntxt-db-num
     3238                       , input "delfbr.err"
     3239                       , input ?
     3240                       , input p-fbr-doc-code
     3241                       , input v-cntxt-userid
     3242                       , input 0
     3243                       , input (if p-ph-chip-num <> ?
     3244                               then p-ph-chip-num
     3245                               else (if varchip-code <> 0
     3246                                   then varchip-code
     3247                                   else ?)
     3248                               )
     3249                       , output varchip-code2
     3250                   ) no-error.
     3251                   if error-status :error
     3252                   then do:
     3253                     undo, return error substitute("Ошибка при удалении складского документа &1, связанного со складским документов прихода &2, созданный по документу производства &3.&4&5&4&6"
     3254                                                   ,buf_out_trn-doc.doc-code
     3255                                                   ,buf_trn-doc.doc-code
     3256                                                   ,p-fbr-doc-code
     3257                                                   , chr(10)
     3258                                                   , error-status:get-message(1)
     3259                                                   , return-value ).
     3260                   end.
     3261               end.
     3262           end.
     3263           run str/del-doc.p (
     3264                 input parparentproc
     3265               , input buf_trn-doc.doc-code
     3266               , input v-cntxt-db-num
     3267               , input "delfbr.err"
     3268               , input ?
     3269               , input p-fbr-doc-code
     3270               , input v-cntxt-userid
     3271               , input 0
     3272               , input (if p-ph-chip-num <> ?
     3273                        then p-ph-chip-num
     3274                        else (if varchip-code <> 0
     3275                              then varchip-code
     3276                              else ?)
     3277                        )
     3278               , output varchip-code2
     3279           ) no-error.
     3280           if error-status :error
     3281           then do:
     3282               undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     3283                                             ,buf_trn-doc.doc-code
     3284                                             ,p-fbr-doc-code
     3285                                             , chr(10)
     3286                                             , error-status:get-message(1)
     3287                                             , return-value ).
     3288           end.
     3289           if p-doc-type = 'рас':U
     3290           or p-doc-type = 'спи':U
     3291           then do:
     3292               assign
     3293                   v-chip-counter = 0
     3294               .
     3295               for each buf_cons_trn-doc no-lock
     3296                  where buf_cons_trn-doc.out-code      = v-doc-code
     3297                    and buf_cons_trn-doc.ext-doc-type  = 'pc':U
     3298               :
     3299                   assign
     3300                       v-trn-doc-recid = recid( buf_cons_trn-doc )
     3301                       v-chip-counter = v-chip-counter + 1
     3302                   .
     3303                   assign
     3304                   varchip-code = if v-chip-counter = 2
     3305                                  then varchip-code2
     3306                                  else varchip-code.
     3307                   run str/del-doc.p (
     3308                         input parparentproc
     3309                       , input buf_cons_trn-doc.doc-code
     3310                       , input v-cntxt-db-num
     3311                       , input "delfbr.err"
     3312                       , input ?
     3313                       , input ?
     3314                       , input v-cntxt-userid
     3315                       , input 0
     3316                       , input (if p-ph-chip-num <> ?
     3317                                then p-ph-chip-num
     3318                                else ( if v-chip-counter = 1
     3319                                       then ?
     3320                                       else varchip-code )
     3321                                )
     3322                       , output varchip-code2
     3323                   ) no-error.
     3324                   if error-status :error
     3325                   then do:
     3326                       undo, return error substitute("Ошибка при удалении складского документа смены типа приобретения &1, созданный по документу производства &2.&3&4&3&5"
     3327                                                     ,buf_cons_trn-doc.doc-code
     3328                                                     ,p-fbr-doc-code
     3329                                                     , chr(10)
     3330                                                     , error-status:get-message(1)
     3331                                                     , return-value ).
     3332                   end.
     3333                   assign
     3334                       p-chip-num = varchip-code2
     3335                   .
     3336               end.
     3337           end.
     3338           assign
     3339               p-chip-num = varchip-code2
     3340           .
     3341       end.
     3342   end.
     3343   END PROCEDURE.
     3344   PROCEDURE fbrlib-print-del-error-message :
     3345   do
     3346   on error undo, return error
     3347   :
     3348       define variable v-user-action   as character    no-undo.
     3349       define variable v-printed       as logical      no-undo.
     3350       message
     3351           vss-workfile vss-revision vss-description
     3352           skip "Ошибка при удалении документа."
     3353           skip return-value
     3354           skip trim(error-status :get-message(1))
     3355           skip trim(error-status :get-message(2))
     3356           skip trim(error-status :get-message(3))
     3357       view-as alert-box error.
     3358       if search ("delfbr.err") <> ?
     3359       then do:
     3360         run gbl/prnfilen.w
     3361           (input  "Ошибки при удалении документа производства"
     3362           ,input  0
     3363           ,input  "delfbr.err"
     3364           ,input  7
     3365           ,output v-user-action
     3366           ,output v-printed
     3367           ).
     3368       end.
     3369   end.
     3370   END PROCEDURE.
     3371   procedure fbrlib-calc-brutto :
     3372   define input parameter p-recipe-type        as character        no-undo.
     3373   define input parameter p-netto              as decimal          no-undo.
     3374   define input parameter p-coeff-value        as decimal          no-undo.
     3375   define input parameter p-coeff-waste        as decimal          no-undo.
     3376   define input parameter p-brutto             as decimal          no-undo.
     3377   define input parameter p-calc-method        as integer          no-undo.
     3378   define output parameter p-new-netto         as decimal          no-undo.
     3379   define output parameter p-new-coeff-waste   as decimal          no-undo.
     3380   define output parameter p-new-brutto        as decimal          no-undo.
     3381   define output parameter p-new-calc-method   as integer          no-undo.
     3382   do
     3383   on error undo, return error
     3384   :
     3385       if p-recipe-type <> 'производство':U
     3386       then do:
     3387           assign
     3388               p-new-coeff-waste = 0
     3389               p-new-calc-method = 1
     3390               p-new-netto       = ( if p-calc-method = 1 then p-brutto else p-netto )
     3391               p-new-brutto      = ( if p-calc-method = 1 then p-brutto else p-netto )
     3392           .
     3393       end.
     3394       else do:
     3395           assign
     3396               p-new-calc-method = p-calc-method
     3397           .
     3398           if p-coeff-waste = 0
     3399           then do:
     3400               assign
     3401                   p-coeff-value = 0
     3402               .
     3403           end.
     3404           case p-calc-method
     3405           :
     3406               when 1
     3407               then do:
     3408                   assign
     3409                       p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     3410                       p-new-coeff-waste   = p-coeff-waste
     3411                       p-new-brutto        = p-brutto
     3412                   .
     3413               end.
     3414               when 2
     3415               then do:
     3416                   assign
     3417                       p-new-netto         = p-netto
     3418                       p-new-coeff-waste   = 100 - p-coeff-value - ( 100 * p-netto / p-brutto )
     3419                       p-new-brutto        = p-brutto
     3420                   .
     3421               end.
     3422               when 3
     3423               then do:
     3424                   assign
     3425                       p-new-netto         = p-netto
     3426                       p-new-coeff-waste   = p-coeff-waste
     3427                       p-new-brutto        = 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste )
     3428                   .
     3429               end.
     3430               otherwise do:
     3431                   define variable v-yesno    as logical      no-undo.
     3432                   assign
     3433                       v-yesno = yes
     3434                   .
     3435                   message
     3436                       "Неверный метод для расчета брутто, нетто и процента потерь."
     3437                       skip "Значение метода должно быть 1, 2 или 3."
     3438                       skip(1)
     3439                       skip "Заданное значение:" p-calc-method
     3440                       skip(1)
     3441                       skip "Установить значение метода расчета 1"
     3442                       skip "(расчет нетто по брутто и проценту потерь)?"
     3443                   view-as alert-box warning
     3444                   buttons yes-no
     3445                   title "Неверное значение метода пересчета в строках документа-производства"
     3446                   update v-yesno
     3447                   .
     3448                   if v-yesno = yes
     3449                   then do:
     3450                       assign
     3451                           p-new-calc-method   = 1
     3452                           p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     3453                           p-new-coeff-waste   = p-coeff-waste
     3454                           p-new-brutto        = p-brutto
     3455                       .
     3456                   end.
     3457                   else do:
     3458                       message
     3459                               vss-workfile vss-revision vss-description
     3460                           skip(1)
     3461                           skip "Ошибка расчета брутто, нетто и процента потерь."
     3462                           skip return-value
     3463                           skip trim(error-status :get-message(1))
     3464                               trim(error-status :get-message(2))
     3465                               trim(error-status :get-message(3))
     3466                       view-as alert-box error
     3467                       title "Неверное значение метода расчета"
     3468                       .
     3469                       undo, return error .
     3470                   end.
     3471               end.
     3472           end case.
     3473       end.
     3474   end.
     3475   end procedure.
     3476   procedure fbrlib-check-brutto :
     3477   define input parameter p-recipe-type        as character        no-undo.
     3478   define input parameter p-netto              as decimal          no-undo.
     3479   define input parameter p-coeff-value        as decimal          no-undo.
     3480   define input parameter p-coeff-waste        as decimal          no-undo.
     3481   define input parameter p-brutto             as decimal          no-undo.
     3482   define input parameter p-calc-method        as integer          no-undo.
     3483   define output parameter p-error-message     as character        no-undo.
     3484   define output parameter p-not-good          as logical          no-undo.
     3485   do
     3486   on error undo, return error
     3487   :
     3488       if p-recipe-type <> 'производство':U
     3489       then do:
     3490           if p-netto <> p-brutto
     3491           or p-coeff-waste <> 0
     3492           then do:
     3493               assign
     3494                   p-not-good      = yes
     3495                   p-error-message = substitute( "Во всех рецептах кроме рецепта производства должно выполняться:&1брутто = нетто и процент потерь = 0.&1&1Тип рецепта: &2&1Брутто: &3&1Нетто: &4&1Процент потерь: &5"
     3496                                           , chr(10), p-recipe-type, p-brutto, p-netto, p-coeff-waste )
     3497               .
     3498           end.
     3499       end.
     3500       else do:
     3501           if p-coeff-waste = 0
     3502           then do:
     3503               assign
     3504                   p-coeff-value = 0
     3505               .
     3506           end.
     3507           case p-calc-method
     3508           :
     3509               when 1
     3510               then do:
     3511                   if round( p-netto, 9 ) <> round( p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100, 9 )
     3512                   then do:
     3513                       assign
     3514                           p-not-good      = yes
     3515                           p-error-message = substitute( "Ошибка расчета нетто ( &2 ) &1 по брутто ( &3 ) &1 и процентам потерь ( &4, &5 )."
     3516                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     3517                       .
     3518                   end.
     3519               end.
     3520               when 2
     3521               then do:
     3522                   if round( p-coeff-waste, 9 ) <> round( 100 - p-coeff-value - ( 100 * p-netto / p-brutto ), 9 )
     3523                   then do:
     3524                       assign
     3525                           p-not-good      = yes
     3526                           p-error-message =  substitute( "Ошибка расчета процента потерь ( &2 ) &1 по нетто ( &3 ) &1 брутто ( &4 ) &1 и cезонному проценту ( &5 )."
     3527                                                   , chr(10), p-coeff-waste, p-netto, p-brutto, p-coeff-value )
     3528                       .
     3529                   end.
     3530               end.
     3531               when 3
     3532               then do:
     3533                   if round( p-brutto, 9 ) <> round( 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste ), 9 )
     3534                   then do:
     3535                       assign
     3536                           p-not-good      = yes
     3537                           p-error-message = substitute( "Ошибка расчета брутто ( &3 ) &1 по нетто ( &2 ) &1 и процентам потерь ( &4, &5 )."
     3538                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     3539                       .
     3540                   end.
     3541               end.
     3542               otherwise do:
     3543                   assign
     3544                       p-not-good      = yes
     3545                       p-error-message = substitute( "Ошибка ввода метода расчета ( &1 ).", p-calc-method )
     3546                   .
     3547               end.
     3548           end case.
     3549       end.
     3550   end.
     3551   end procedure.
     3552   procedure fbrlib-check-fbr-recipe :
     3553   define input parameter p-doc-code       as character        no-undo.
     3554   define input parameter p-recipe-code    as character        no-undo.
     3555   define output parameter p-is-correct    as logical          no-undo.
     3556       define variable v-comp-factor    as decimal      no-undo.
     3557       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     3558       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3559       define buffer buf_fbr-line          for ub.fbr-line.
     3560   do
     3561   for buf_fbr-recipe
     3562     , buf_fbr-recipe-gds
     3563     , buf_fbr-line
     3564   on error undo, return error
     3565   :
     3566       assign
     3567           p-is-correct = yes
     3568       .
     3569       find first buf_fbr-recipe no-lock
     3570            where buf_fbr-recipe.doc-code    = p-doc-code
     3571              and buf_fbr-recipe.recipe-code = p-recipe-code no-error
     3572       .
     3573       if not available buf_fbr-recipe then do:
     3574         undo, return error substitute("Не найден рецепт (fbr-recipe) с кодом &1 для  документа пр-ва &2", p-recipe-code, p-doc-code).
     3575       end.
     3576       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     3577       then do:
     3578       end.
     3579       else do:
     3580           find first buf_fbr-line no-lock
     3581                where buf_fbr-line.doc-code    = buf_fbr-recipe.doc-code
     3582                  and buf_fbr-line.is-comp     = yes
     3583                  and buf_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     3584                  and buf_fbr-line.artic       = buf_fbr-recipe.artic
     3585                  and buf_fbr-line.prod-type   = buf_fbr-recipe.prod-type
     3586                  and buf_fbr-line.prod-code   = buf_fbr-recipe.prod-code
     3587           .
     3588           assign
     3589               v-comp-factor = buf_fbr-line.fact-qnty / buf_fbr-recipe.qnty
     3590           .
     3591           recipe-line-cycle:
     3592           for each buf_fbr-recipe-gds no-lock
     3593              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     3594                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     3595           on error undo, return error
     3596           :
     3597               find first buf_fbr-line no-lock
     3598                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     3599                      and buf_fbr-line.is-comp     = no
     3600                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     3601                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3602                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3603                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3604               .
     3605               if absolute( buf_fbr-line.fact-qnty / buf_fbr-recipe-gds.brutto-qnty - v-comp-factor ) > 0.000000001
     3606               then do:
     3607                   assign
     3608                       p-is-correct = no
     3609                   .
     3610                   leave recipe-line-cycle.
     3611               end.
     3612           end.
     3613       end.
     3614   end.
     3615   end procedure.
     3616   procedure fbrlib-get-recipe-type :
     3617   define input parameter p-fbr-doc-code   as character        no-undo.
     3618   define input parameter p-recipe-code    as character        no-undo.
     3619   define output parameter p-recipe-type   as character        no-undo.
     3620       define buffer buf_recipe        for ub.recipe.
     3621       define buffer buf_fbr-recipe    for ub.fbr-recipe.
     3622   do
     3623   for buf_recipe
     3624     , buf_fbr-recipe
     3625   on error undo, return error
     3626   :
     3627       if p-fbr-doc-code = ""
     3628       then do:
     3629           find first buf_recipe no-lock
     3630                where buf_recipe.recipe-code = p-recipe-code
     3631           no-error.
     3632           if available buf_recipe
     3633           then do:
     3634               assign
     3635                   p-recipe-type = buf_recipe.recipe-type
     3636               .
     3637           end.
     3638           else do:
     3639               assign
     3640                   p-recipe-type = "":U
     3641               .
     3642           end.
     3643       end.
     3644       else do:
     3645           find first buf_fbr-recipe no-lock
     3646                where buf_fbr-recipe.doc-code      = p-fbr-doc-code
     3647                  and buf_fbr-recipe.recipe-code   = p-recipe-code
     3648           no-error.
     3649           if available buf_fbr-recipe
     3650           then do:
     3651               assign
     3652                   p-recipe-type = buf_fbr-recipe.recipe-type
     3653               .
     3654           end.
     3655           else do:
     3656               assign
     3657                   p-recipe-type = "":U
     3658               .
     3659           end.
     3660       end.
     3661   end.
     3662   end procedure.
     3663   PROCEDURE calc-comp-from-ingr :
     3664   define input parameter p-fbr-v-fbr-doc-line-recid           as recid        no-undo.
     3665   define input parameter p-fact-qnty                          as decimal      no-undo.
     3666   define output parameter p-comp-fbr-v-fbr-doc-line-recid     as recid        no-undo.
     3667   define output parameter p-comp-qnty                         as decimal      no-undo.
     3668       define variable v-ingr-qnty     as decimal       no-undo.
     3669       define buffer buf_i_fbr-line    for ub.fbr-line.
     3670       define buffer buf_fbr-line      for ub.fbr-line.
     3671       define buffer buf_recipe        for ub.fbr-recipe.
     3672       define buffer buf_recipe-gds    for ub.fbr-recipe-gds.
     3673   do
     3674   for buf_i_fbr-line
     3675     , buf_fbr-line
     3676     , buf_recipe
     3677     , buf_recipe-gds
     3678   on error undo, return error
     3679   :
     3680       find first buf_i_fbr-line no-lock
     3681            where recid( buf_i_fbr-line ) = p-fbr-v-fbr-doc-line-recid
     3682       .
     3683       find first buf_recipe no-lock
     3684            where buf_recipe.doc-code      = buf_i_fbr-line.doc-code
     3685              and buf_recipe.recipe-code   = buf_i_fbr-line.recipe-code
     3686       no-error.
     3687       if not available buf_recipe
     3688       then do:
     3689           message
     3690                   vss-workfile vss-revision vss-description
     3691               skip "В строке производства не указан рецепт."
     3692               skip "Невозможно рассчитать количество составного товара."
     3693               skip return-value
     3694               skip trim(error-status :get-message(1))
     3695                   trim(error-status :get-message(2))
     3696                   trim(error-status :get-message(3))
     3697           view-as alert-box error.
     3698           undo, return error .
     3699       end.
     3700       if buf_recipe.recipe-type = 'альтернатива':U
     3701       then do:
     3702           for each buf_fbr-line no-lock
     3703              where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     3704                and buf_fbr-line.trn-type    = buf_i_fbr-line.trn-type
     3705                and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     3706           on error undo, return error
     3707           :
     3708               find first buf_recipe-gds no-lock
     3709                    where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     3710                      and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     3711                      and buf_recipe-gds.artic       = buf_fbr-line.artic
     3712                      and buf_recipe-gds.prod-type   = buf_fbr-line.prod-type
     3713                      and buf_recipe-gds.prod-code   = buf_fbr-line.prod-code
     3714               .
     3715               assign
     3716                   p-comp-qnty         = p-comp-qnty       + ( buf_fbr-line.fact-qnty * buf_recipe-gds.brutto-qnty )
     3717               .
     3718           end.
     3719           assign
     3720               p-comp-qnty         = p-comp-qnty       / buf_recipe.qnty
     3721           .
     3722       end.
     3723       else do:
     3724           find first buf_recipe-gds no-lock
     3725                where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     3726                  and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     3727                  and buf_recipe-gds.artic       = buf_i_fbr-line.artic
     3728                  and buf_recipe-gds.prod-type   = buf_i_fbr-line.prod-type
     3729                  and buf_recipe-gds.prod-code   = buf_i_fbr-line.prod-code
     3730           .
     3731           assign
     3732               p-comp-qnty = p-fact-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
     3733           .
     3734       end.
     3735       find first buf_fbr-line no-lock
     3736            where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     3737              and buf_fbr-line.is-comp     = yes
     3738              and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     3739       .
     3740       assign
     3741           p-comp-fbr-v-fbr-doc-line-recid = recid( buf_fbr-line )
     3742       .
     3743   end.
     3744   END PROCEDURE.
     3745   PROCEDURE get-temp_dressing-ingr-used-qnty :
     3746   define input parameter p-recipe-code    as character    no-undo.
     3747   define input parameter p-gds-code       as integer      no-undo.
     3748   define output parameter p-line-qnty     as decimal      no-undo.
     3749   define output parameter p-used-qnty     as decimal      no-undo.
     3750   define output parameter p-recipe-qnty   as decimal      no-undo.
     3751       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     3752   do
     3753   for buf_temp_dressing-ingr
     3754   on error undo, return error
     3755   :
     3756       find first buf_temp_dressing-ingr no-lock
     3757            where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     3758              and buf_temp_dressing-ingr.gds-code    = p-gds-code
     3759       no-error.
     3760       if available buf_temp_dressing-ingr
     3761       then do:
     3762           assign
     3763               p-line-qnty     = buf_temp_dressing-ingr.line-qnty
     3764               p-used-qnty     = buf_temp_dressing-ingr.used-qnty
     3765               p-recipe-qnty   = buf_temp_dressing-ingr.recipe-qnty
     3766           .
     3767       end.
     3768       else do:
     3769           assign
     3770               p-line-qnty     = 0
     3771               p-used-qnty     = 0
     3772               p-recipe-qnty   = 0
     3773           .
     3774       end.
     3775   end.
     3776   END PROCEDURE.
     3777   PROCEDURE fbrlib_adjust-recipe :
     3778   do
     3779   on error undo, return error
     3780   :
     3781   define input parameter parparentproc as widget-handle no-undo .
     3782   define input parameter p-fbrhist-handle as handle no-undo .
     3783   define input parameter p-doc-code       as character    no-undo.
     3784   define input parameter p-recipe-code    as character    no-undo.
     3785   define input parameter p-price-sale-obj-type as character no-undo .
     3786   define input parameter p-price-sale-obj-code as integer no-undo .
     3787       define variable v-recipe-qnty       as decimal      no-undo.
     3788       define variable v-comp-qnty         as decimal      no-undo.
     3789       define variable v-recipe-gds-qnty   as decimal      no-undo.
     3790       define variable v-ingr-qnty         as decimal      no-undo.
     3791       define variable v-qnty              as decimal      no-undo.
     3792       define variable v-coeff-waste       as decimal      no-undo.
     3793       define variable v-brutto-qnty       as decimal      no-undo.
     3794       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     3795       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3796       define buffer buf_fbr-line          for ub.fbr-line.
     3797       define buffer buf_el_fbr-recipe-gds for ub.fbr-recipe-gds.
     3798       find first buf_fbr-recipe no-lock
     3799            where buf_fbr-recipe.doc-code      = p-doc-code
     3800              and buf_fbr-recipe.recipe-code   = p-recipe-code
     3801       .
     3802       assign
     3803           v-recipe-qnty = buf_fbr-recipe.qnty
     3804       .
     3805       find first buf_fbr-line no-lock
     3806            where buf_fbr-line.doc-code    = p-doc-code
     3807              and buf_fbr-line.is-comp     = yes
     3808              and buf_fbr-line.recipe-code = p-recipe-code
     3809       .
     3810       assign
     3811           v-comp-qnty = buf_fbr-line.fact-qnty
     3812       .
     3813       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     3814       then do:
     3815       end.
     3816       else do:
     3817           for each buf_fbr-recipe-gds no-lock
     3818              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     3819                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     3820           on error undo, return error
     3821           :
     3822               find first buf_fbr-line no-lock
     3823                    where buf_fbr-line.doc-code    = p-doc-code
     3824                      and buf_fbr-line.is-comp     = no
     3825                      and buf_fbr-line.recipe-code = p-recipe-code
     3826                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3827                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3828                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3829               .
     3830               if buf_fbr-line.fact-qnty / v-comp-qnty <> buf_fbr-recipe-gds.brutto-qnty / v-recipe-qnty
     3831               then do:
     3832                   do transaction
     3833                   on error undo, return error
     3834                   :
     3835                       find first buf_el_fbr-recipe-gds exclusive-lock
     3836                            where recid( buf_el_fbr-recipe-gds ) = recid( buf_fbr-recipe-gds )
     3837                       .
     3838                       assign
     3839                           buf_el_fbr-recipe-gds.calc-method   = 1
     3840                           buf_el_fbr-recipe-gds.brutto-qnty   = buf_fbr-line.fact-qnty * v-recipe-qnty / v-comp-qnty
     3841                       .
     3842                       run fbrlib-calc-brutto in this-procedure (
     3843                             input buf_fbr-recipe.recipe-type
     3844                           , input 0
     3845                           , input buf_el_fbr-recipe-gds.coeff-value
     3846                           , input buf_el_fbr-recipe-gds.coeff-waste
     3847                           , input buf_el_fbr-recipe-gds.brutto-qnty
     3848                           , input 1
     3849                           , output buf_el_fbr-recipe-gds.qnty
     3850                           , output buf_el_fbr-recipe-gds.coeff-waste
     3851                           , output buf_el_fbr-recipe-gds.brutto-qnty
     3852                           , output buf_el_fbr-recipe-gds.calc-method
     3853                       ).
     3854                   end.
     3855               end.
     3856           end.
     3857           run fbrlib_adjust-doc-lines in this-procedure (
     3858                 input parparentproc
     3859               , input p-fbrhist-handle
     3860               , input p-doc-code
     3861               , input p-recipe-code
     3862               , input p-price-sale-obj-type
     3863               , input p-price-sale-obj-code
     3864           ).
     3865       end.
     3866   end.
     3867   END PROCEDURE.
     3868   PROCEDURE fbrlib_adjust-doc-lines :
     3869   define input parameter parparentproc as widget-handle no-undo .
     3870   define input parameter p-fbrhist-handle as handle no-undo .
     3871   define input parameter p-doc-code       as character    no-undo.
     3872   define input parameter p-recipe-code    as character    no-undo.
     3873   define input parameter p-price-sale-obj-type as character no-undo .
     3874   define input parameter p-price-sale-obj-code as integer no-undo .
     3875   define variable v-comp-qnty         as decimal      no-undo.
     3876   define variable v-trn-type          as character    no-undo.
     3877   define variable v-ingr-qnty         as decimal      no-undo.
     3878   define variable v-recipe-qnty       as decimal      no-undo.
     3879   define variable v-fbr-v-fbr-doc-line-recid    as recid        no-undo.
     3880   define buffer buf_fbr-recipe        for ub.fbr-recipe.
     3881   define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3882   define buffer buf_fbr-line          for ub.fbr-line.
     3883   define buffer buf_coeff_fbr-line    for ub.fbr-line.
     3884   define buffer buf_goods             for ub.goods.
     3885   define buffer buf_fbr-doc           for ub.fbr-doc.
     3886   do
     3887   for buf_fbr-recipe
     3888     , buf_fbr-recipe-gds
     3889     , buf_fbr-line
     3890     , buf_coeff_fbr-line
     3891     , buf_goods
     3892     , buf_fbr-doc
     3893   on error undo, return error
     3894   :
     3895       find first buf_fbr-line no-lock
     3896            where buf_fbr-line.doc-code      = p-doc-code
     3897              and buf_fbr-line.is-comp       = yes
     3898              and buf_fbr-line.recipe-code   = p-recipe-code
     3899       .
     3900       find first buf_fbr-doc no-lock
     3901            where buf_fbr-doc.doc-code      = p-doc-code
     3902       .
     3903       assign
     3904           v-comp-qnty = buf_fbr-line.fact-qnty
     3905           v-trn-type  = buf_fbr-line.trn-type
     3906       .
     3907       find first buf_fbr-recipe no-lock
     3908            where buf_fbr-recipe.doc-code    = p-doc-code
     3909              and buf_fbr-recipe.recipe-code = p-recipe-code
     3910       .
     3911       assign
     3912       v-recipe-qnty = buf_fbr-recipe.qnty
     3913       .
     3914       do transaction
     3915       on error undo, return error
     3916       :
     3917           for each buf_fbr-recipe-gds no-lock
     3918              where buf_fbr-recipe-gds.doc-code      = p-doc-code
     3919                and buf_fbr-recipe-gds.recipe-code   = p-recipe-code
     3920           on error undo, return error
     3921           :
     3922               find first buf_fbr-line no-lock
     3923                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     3924                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     3925                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3926                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3927                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3928               no-error.
     3929               if not available buf_fbr-line
     3930               then do:
     3931                   find first buf_goods no-lock
     3932                        where buf_goods.artic      = buf_fbr-recipe-gds.artic
     3933                          and buf_goods.prod-type  = buf_fbr-recipe-gds.prod-type
     3934                          and buf_goods.prod-code  = buf_fbr-recipe-gds.prod-code
     3935                   .
     3936                   run str/fbr-crln.p (
     3937                         input parparentproc
     3938                       , input recid( buf_fbr-doc )
     3939                       , input recid( buf_goods )
     3940                       , input buf_fbr-recipe-gds.recipe-code
     3941                       , input v-trn-type
     3942                       , input no
     3943                       , input no
     3944                       , input buf_fbr-doc.obj-type
     3945                       , input buf_fbr-doc.obj-code
     3946                       , output v-fbr-v-fbr-doc-line-recid
     3947                   ).
     3948                   find first buf_fbr-line no-lock
     3949                        where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     3950                          and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     3951                          and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3952                          and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3953                          and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3954                   no-error.
     3955                   if not available buf_fbr-line
     3956                   then do:
     3957                       undo, return error substitute("Не удалось создать строку документа производства &1 &2&3&4"
     3958                                                      , p-doc-code
     3959                                                      , buf_fbr-recipe-gds.artic
     3960                                                      , buf_fbr-recipe-gds.prod-type
     3961                                                      , buf_fbr-recipe-gds.prod-code).
     3962                   end.
     3963               end.
     3964               find first buf_coeff_fbr-line exclusive-lock
     3965                    where recid( buf_coeff_fbr-line ) = recid( buf_fbr-line )
     3966               .
     3967               if buf_coeff_fbr-line.calc-method <> buf_fbr-recipe-gds.calc-method
     3968               or buf_coeff_fbr-line.coeff-value <> buf_fbr-recipe-gds.coeff-value
     3969               or buf_coeff_fbr-line.coeff-waste <> buf_fbr-recipe-gds.coeff-waste
     3970               then do:
     3971                   assign
     3972                       buf_coeff_fbr-line.calc-method = buf_fbr-recipe-gds.calc-method
     3973                       buf_coeff_fbr-line.coeff-value = buf_fbr-recipe-gds.coeff-value
     3974                       buf_coeff_fbr-line.coeff-waste = buf_fbr-recipe-gds.coeff-waste
     3975                   .
     3976               end.
     3977           end.
     3978       end.
     3979       define variable v-need-goods    as logical       no-undo.
     3980       define variable v-need-goods-list       as character     no-undo.
     3981       define variable v-need-goods-qnty-list  as character     no-undo.
     3982       find first buf_fbr-line no-lock
     3983            where buf_fbr-line.doc-code    = buf_fbr-doc.doc-code
     3984              and buf_fbr-line.is-comp     = yes
     3985              and buf_fbr-line.recipe-code = p-recipe-code
     3986       .
     3987       run str/fbr-qnty.p (
     3988             input parparentproc
     3989           , input p-fbrhist-handle
     3990           , input recid( buf_fbr-doc )
     3991           , input recid( buf_fbr-line )
     3992           , input no
     3993           , input "ingr"
     3994           , input no
     3995           , input p-price-sale-obj-type
     3996           , input p-price-sale-obj-code
     3997           , input no
     3998           , input no
     3999           , input no
     4000           , output v-need-goods
     4001           , output v-need-goods-list
     4002           , output v-need-goods-qnty-list
     4003       ).
     4004   end.
     4005   END PROCEDURE.
     4006   procedure fbrlib_check-before-close :
     4007   define input parameter p-doc-code as character no-undo .
     4008   define variable same-sale as decimal no-undo .
     4009   define variable is-waste as logical no-undo .
     4010   define variable fix-price as logical no-undo .
     4011   define buffer buf_fbr-doc for ub.fbr-doc.
     4012   define buffer buf_fbr-line for ub.fbr-line.
     4013   define buffer buf_goods for ub.goods.
     4014   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     4015   do
     4016   on error undo, return error
     4017   :
     4018     for each buf_fbr-line no-lock
     4019         where buf_fbr-line.doc-code = p-doc-code
     4020       , each buf_goods no-lock
     4021         where buf_goods.artic     = buf_fbr-line.artic
     4022           and buf_goods.prod-type = buf_fbr-line.prod-type
     4023           and buf_goods.prod-code = buf_fbr-line.prod-code
     4024     break by buf_fbr-line.prod-type
     4025           by buf_fbr-line.prod-code
     4026           by buf_fbr-line.artic
     4027     :
     4028       if first-of (buf_fbr-line.artic)
     4029       then do:
     4030         assign
     4031         same-sale = buf_fbr-line.price-sale
     4032         is-waste = (buf_fbr-line.rsrv-qnty = ?)
     4033         fix-price = buf_fbr-line.is-calc
     4034         .
     4035       end.
     4036       if same-sale <> buf_fbr-line.price-sale
     4037       then do:
     4038           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром должна быть указана одна и та же цена продажи."
     4039                                         ,p-doc-code
     4040                                         ,buf_goods.artic
     4041                                         ,buf_goods.gds-name
     4042                                         ,chr(10)).
     4043       end.
     4044       if fix-price <> buf_fbr-line.is-calc then do:
     4045           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром цена должна быть фиксирована или нет."
     4046                                         ,p-doc-code
     4047                                         ,buf_goods.artic
     4048                                         ,buf_goods.gds-name
     4049                                         ,chr(10)).
     4050       end.
     4051       if is-waste <> (buf_fbr-line.rsrv-qnty = ?)
     4052       then do:
     4053         undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа этот товар должен быть отходом либо не отходом."
     4054                                         ,p-doc-code
     4055                                         ,buf_goods.artic
     4056                                         ,buf_goods.gds-name
     4057                                         ,chr(10)).
     4058       end.
     4059       if buf_fbr-line.rsrv-qnty <> ?
     4060       and buf_goods.gds-type <> 'у':U
     4061       and ( buf_fbr-line.price-sale <= 0 or buf_fbr-line.price-sale = ?  )
     4062       and buf_fbr-line.fact-qnty <> 0
     4063       then do:
     4064         if buf_fbr-line.trn-type     = 'при':U  then for first buf_fbr-doc where buf_fbr-doc.doc-code =  p-doc-code no-lock:
     4065           if  can-find(first buf_fbr-gds-obj no-lock where
     4066                   buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     4067               AND buf_fbr-gds-obj.obj-type = buf_fbr-doc.obj-type
     4068               AND buf_fbr-gds-obj.obj-code = buf_fbr-doc.obj-code
     4069               and buf_fbr-gds-obj.is-null-price  )  then .
     4070                     else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4071                                         ,p-doc-code
     4072                                         ,buf_goods.artic
     4073                                         ,buf_goods.gds-name
     4074                                         ,chr(10)
     4075                                         ,buf_fbr-line.recipe-code
     4076                                         ).
     4077         end.
     4078         else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4079                                         ,p-doc-code
     4080                                         ,buf_goods.artic
     4081                                         ,buf_goods.gds-name
     4082                                         ,chr(10)
     4083                                         ,buf_fbr-line.recipe-code
     4084                                         ).
     4085       end.
     4086     end.
     4087   end.
     4088   end procedure.
     4089   define variable vss-include-info31 as character format "X(65)" no-undo
     4090   initial "@(#)$Workfile$ $Revision$".
     4091   define temp-table temp_fbrrep-goods no-undo
     4092       field gds-code                      as integer
     4093       field artic                         as character
     4094       field prod-type                     as character
     4095       field prod-code                     as integer
     4096       field gds-name                      as character
     4097       field is-not-office                 as logical
     4098       field is-waste                      as logical
     4099       field unit-base                     as character
     4100       field fact-qnty                     as decimal
     4101       field write-off-qnty                as decimal
     4102       field write-off-rsrv-qnty           as decimal
     4103       field sum-write-off-rsrv-rubl       as decimal
     4104       field sum-write-off-rsrv-base       as decimal
     4105       field sum-write-off-rsrv-vat-rubl   as decimal
     4106       field sum-write-off-rsrv-vat-base   as decimal
     4107       field cost-rubl                     as decimal
     4108       field cost-base                     as decimal
     4109       field sum-cost-rubl                 as decimal
     4110       field sum-cost-base                 as decimal
     4111       field sum-vat-cost-rubl             as decimal
     4112       field sum-vat-cost-base             as decimal
     4113       field vat-cost-rubl                 as decimal
     4114       field vat-cost-base                 as decimal
     4115       field income-qnty                   as decimal
     4116       field income-rsrv-qnty              as decimal
     4117       field cost-income-rubl              as decimal
     4118       field cost-income-base              as decimal
     4119       field sum-cost-income-rubl          as decimal
     4120       field sum-cost-income-base          as decimal
     4121       field sum-vat-cost-income-rubl      as decimal
     4122       field sum-vat-cost-income-base      as decimal
     4123       field vat-cost-income-rubl          as decimal
     4124       field vat-cost-income-base          as decimal
     4125       field price-sale                    as decimal
     4126       field deleted                       as logical
     4127       index pi is primary unique gds-code
     4128       index ar is unique artic prod-type prod-code
     4129       index dd deleted
     4130       index ws is-waste
     4131   .
     4132   define variable vss-include-info32 as character format "X(65)" no-undo
     4133   initial "@(#)$Workfile$ $Revision$".
     4134   def var vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4135   procedure r-cost :
     4136     define input  parameter v-doc-code       like ub.doc-line.doc-code          no-undo .
     4137     define input  parameter v-artic          like ub.doc-line.artic             no-undo .
     4138     define input  parameter v-prod-type      like ub.doc-line.prod-type         no-undo .
     4139     define input  parameter v-prod-code      like ub.doc-line.prod-code         no-undo .
     4140     define output parameter v-fact-qnty      like ub.ot-line.fact-qnty       no-undo .
     4141     define output parameter v-vat-pc         like ub.doc-line.vat-pc         no-undo .
     4142     define output parameter v-slt-pc         like ub.doc-line.slt-pc         no-undo .
     4143     define output parameter v-sum-base       like ub.ot-line.sum-base        no-undo .
     4144     define output parameter v-sum-rubl       like ub.ot-line.sum-rubl        no-undo .
     4145     define output parameter v-vat-base       like ub.ot-line.vat-base        no-undo .
     4146     define output parameter v-vat-rubl       like ub.ot-line.vat-rubl        no-undo .
     4147     define output parameter v-slt-base       like ub.ot-line.slt-base        no-undo .
     4148     define output parameter v-slt-rubl       like ub.ot-line.slt-rubl        no-undo .
     4149     define output parameter v-road-tax-base  like ub.ot-line.road-tax-base   no-undo .
     4150     define output parameter v-road-tax-rubl  like ub.ot-line.road-tax-rubl   no-undo .
     4151     define output parameter v-transport-base like ub.ot-line.transport-base  no-undo .
     4152     define output parameter v-transport-rubl like ub.ot-line.transport-rubl  no-undo .
     4153     define output parameter v-other-base     like ub.ot-line.other-base      no-undo .
     4154     define output parameter v-other-rubl     like ub.ot-line.other-rubl      no-undo .
     4155     define output parameter v-excise-base    like ub.ot-line.excise-base     no-undo .
     4156     define output parameter v-excise-rubl    like ub.ot-line.excise-rubl     no-undo .
     4157     do
     4158     on error undo, return error
     4159     :
     4160       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     4161       define buffer   in-vatp-parts    for ub.parts   .
     4162       define buffer   in-vatp-doc      for ub.trn-doc .
     4163       define buffer   in-vatp-goods    for ub.goods   .
     4164       define buffer   in-vatp-sysconf  for ub.sysconf .
     4165       define buffer   in-vatp_doc-attr for ub.doc-attr.
     4166       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     4167       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     4168       define variable varinvprb                  as   character              no-undo.
     4169       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     4170       define variable cli-base-rate              as   decimal                no-undo.
     4171       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     4172       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     4173       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     4174       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     4175       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     4176       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     4177       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     4178       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     4179       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     4180       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     4181       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     4182       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     4183       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     4184       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     4185       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     4186       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     4187       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     4188       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     4189       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     4190       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     4191       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     4192       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     4193       define variable varinvatp-envd             as   character              no-undo.
     4194       define variable varinvatp-type             as   character              no-undo.
     4195       def var v-parts-fact-qnty as decimal   no-undo .
     4196       define buffer buf_parts    for ub.parts    .
     4197       define buffer buf_goods    for ub.goods    .
     4198       define buffer buf_trn-doc  for ub.trn-doc  .
     4199       define buffer buf_doc-line for ub.doc-line .
     4200       find first buf_doc-line no-lock
     4201         where buf_doc-line.doc-code  = v-doc-code
     4202           and buf_doc-line.artic     = v-artic
     4203           and buf_doc-line.prod-type = v-prod-type
     4204           and buf_doc-line.prod-code = v-prod-code
     4205         no-error .
     4206       if not available buf_doc-line then do:
     4207         message
     4208           vss-workfile vss-revision vss-description skip
     4209           vss-include-info33 skip
     4210           "Ошибка задания входных параметров" skip
     4211           "Не найдена строка документа"  skip
     4212           "Документ" v-doc-code skip
     4213           "Артикул" v-artic v-prod-type v-prod-code skip
     4214           view-as alert-box error .
     4215         return error .
     4216       end.
     4217       find first buf_trn-doc no-lock
     4218         where buf_trn-doc.doc-code = v-doc-code
     4219         no-error .
     4220       if not available buf_trn-doc then do:
     4221         message
     4222           vss-workfile vss-revision vss-description skip
     4223           vss-include-info33 skip
     4224           "Ошибка задания входных параметров" skip
     4225           "Не найден документ" skip
     4226           "Документ" v-doc-code skip
     4227           "Артикул" v-artic v-prod-type v-prod-code skip
     4228           view-as alert-box error .
     4229         undo, return error .
     4230       end.
     4231       find first buf_goods no-lock
     4232         where buf_goods.artic     = buf_doc-line.artic
     4233           and buf_goods.prod-type = buf_doc-line.prod-type
     4234           and buf_goods.prod-code = buf_doc-line.prod-code
     4235         no-error .
     4236       if not available buf_goods then do:
     4237         message
     4238           vss-workfile vss-revision vss-description skip
     4239           vss-include-info33 skip
     4240           "Ошибка задания входных параметров" skip
     4241           "Не найден товар" skip
     4242           "Документ" v-doc-code skip
     4243           "Артикул" v-artic v-prod-type v-prod-code skip
     4244           view-as alert-box error .
     4245         undo, return error .
     4246       end.
     4247       if buf_goods.gds-type = 'т':U then do:
     4248             for each buf_parts no-lock
     4249               where buf_parts.out-code  = buf_trn-doc.doc-code
     4250                 and buf_parts.obj-type  = buf_trn-doc.obj-type
     4251                 and buf_parts.obj-code  = buf_trn-doc.obj-code
     4252                 and buf_parts.artic     = buf_doc-line.artic
     4253                 and buf_parts.prod-type = buf_doc-line.prod-type
     4254                 and buf_parts.prod-code = buf_doc-line.prod-code
     4255             on error undo, return error
     4256             :
     4257   assign
     4258     price-rubl-with-tax-loc = buf_parts.price-rubl
     4259     price-base-with-tax-loc = buf_parts.price-base
     4260   .
     4261   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4262   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4263     (output varinvprb
     4264     )  .
     4265     if buf_parts.out-code = 'free-zone':U     or
     4266        buf_parts.out-code = 'out-zone':U   or
     4267        buf_parts.doc-type = 'акт':U then do:
     4268       assign
     4269         in-vatp-have-vat-slt = yes.
     4270     end.
     4271     else do:
     4272       find first in-vatp_doc-attr no-lock
     4273         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
     4274           and in-vatp_doc-attr.attr-code = 'envd':U
     4275         no-error .
     4276       if not available in-vatp_doc-attr then do:
     4277         assign
     4278           in-vatp-have-vat-slt = yes.
     4279       end.
     4280       else do:
     4281            in-vatp-have-vat-slt = no.
     4282       end.
     4283     end.
     4284     assign
     4285      price-cli-with-tax-loc = buf_parts.price-cli
     4286      cli-base-rate          = buf_parts.cli-base-rate.
     4287     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
     4288              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
     4289     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
     4290             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
     4291             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
     4292             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
     4293             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
     4294             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
     4295             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     4296       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     4297     assign
     4298       exch-rate-cli-loc = (buf_parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_parts.price-cli .
     4299     assign
     4300       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     4301       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     4302       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     4303       transport-cli-loc  = 0
     4304       other-cli-loc      = 0
     4305     .
     4306   ASSIGN
     4307             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     4308       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     4309   .
     4310               assign
     4311                 v-parts-fact-qnty  = (if buf_trn-doc.doc-type = 'при':U
     4312                                       or buf_trn-doc.doc-type = 'возврат':U
     4313                                       or buf_trn-doc.doc-type = 'инв':U
     4314                                       then buf_parts.fact-qnty
     4315                                       else - buf_parts.fact-qnty
     4316                                      )
     4317               .
     4318               assign
     4319                 v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
     4320                 v-sum-base            = v-sum-base       +  ( price-base-with-tax-loc * v-parts-fact-qnty )
     4321                 v-sum-rubl            = v-sum-rubl       +  ( price-rubl-with-tax-loc * v-parts-fact-qnty )
     4322                 v-vat-base            = v-vat-base       +  ( vat-base-loc            * v-parts-fact-qnty )
     4323                 v-vat-rubl            = v-vat-rubl       +  ( vat-rubl-loc            * v-parts-fact-qnty )
     4324                 v-slt-base            = v-slt-base       +  ( slt-base-loc            * v-parts-fact-qnty )
     4325                 v-slt-rubl            = v-slt-rubl       +  ( slt-rubl-loc            * v-parts-fact-qnty )
     4326                 v-road-tax-base       = v-road-tax-base  +  ( road-tax-base-loc       * v-parts-fact-qnty )
     4327                 v-road-tax-rubl       = v-road-tax-rubl  +  ( road-tax-rubl-loc       * v-parts-fact-qnty )
     4328                 v-excise-base         =   0
     4329                 v-excise-rubl         =   0
     4330                 v-transport-base      = v-transport-base +   (transport-base-loc      * v-parts-fact-qnty )
     4331                 v-transport-rubl      = v-transport-rubl +   (transport-rubl-loc      * v-parts-fact-qnty )
     4332                 v-other-base          = v-other-base     +   (other-base-loc          * v-parts-fact-qnty )
     4333                 v-other-rubl          = v-other-rubl     +   (other-rubl-loc          * v-parts-fact-qnty )
     4334               .
     4335           end.
     4336   assign
     4337     price-rubl-with-tax-loc = buf_doc-line.price-rubl
     4338     price-base-with-tax-loc = buf_doc-line.price-base
     4339   .
     4340   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4341   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4342     (output varinvprb
     4343     )  .
     4344      find first in-vatp_doc-attr no-lock
     4345       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     4346         and in-vatp_doc-attr.attr-code = 'envd':U
     4347       no-error .
     4348       if available in-vatp_doc-attr
     4349          then do:
     4350          assign
     4351            in-vatp-have-vat-slt = no.
     4352      end.
     4353      else do:
     4354        assign
     4355          in-vatp-have-vat-slt = yes.
     4356      end.
     4357      find first in-vatp-goods where in-vatp-goods.artic     = buf_doc-line.artic     and
     4358                                        in-vatp-goods.prod-type = buf_doc-line.prod-type and
     4359                                        in-vatp-goods.prod-code = buf_doc-line.prod-code no-lock.
     4360      if (not buf_trn-doc.internal and
     4361              buf_trn-doc.doc-type = 'при':U) or
     4362         in-vatp-goods.gds-type = 'у':U then do:
     4363         if varinvprb = "base":u then do:
     4364           assign
     4365             road-tax-base-loc = buf_doc-line.road-tax
     4366             road-tax-rubl-loc = buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
     4367         end.
     4368         else do:
     4369           ASSIGN
     4370             road-tax-rubl-loc = buf_doc-line.road-tax
     4371             road-tax-base-loc = buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
     4372         end.
     4373         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     4374         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     4375         assign
     4376           road-tax-cli-loc = ?.
     4377         ASSIGN
     4378           transport-base-loc = (if buf_doc-line.transport-base = ? then 0 else buf_doc-line.transport-base)
     4379           transport-rubl-loc = (if buf_doc-line.transport-rubl = ? then 0 else buf_doc-line.transport-rubl)
     4380           transport-cli-loc  = 0
     4381           other-base-loc     = (if buf_doc-line.other-base     = ? then 0 else buf_doc-line.other-base)
     4382           other-rubl-loc     = (if buf_doc-line.other-rubl     = ? then 0 else buf_doc-line.other-rubl)
     4383           other-cli-loc      = 0
     4384           vat-pc-loc         = (if buf_doc-line.vat-pc         = ? then 0 else buf_doc-line.vat-pc)
     4385           slt-pc-loc         = (if buf_doc-line.slt-pc         = ? then 0 else buf_doc-line.slt-pc).
     4386                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     4387               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     4388         assign
     4389           vat-cli-loc            = ?
     4390           slt-cli-loc            = ?
     4391           price-cli-with-tax-loc = ?.
     4392      end.
     4393      else do:
     4394                                                   for each in-vatp-parts where in-vatp-parts.out-code  = buf_doc-line.doc-code  and
     4395                                         in-vatp-parts.obj-type  = buf_doc-line.obj-type  and
     4396                                         in-vatp-parts.obj-code  = buf_doc-line.obj-code  and
     4397                                         in-vatp-parts.artic     = buf_doc-line.artic     and
     4398                                         in-vatp-parts.prod-type = buf_doc-line.prod-type and
     4399                                         in-vatp-parts.prod-code = buf_doc-line.prod-code
     4400                            use-index out-code no-lock:
     4401             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     4402                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     4403                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     4404                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     4405                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
