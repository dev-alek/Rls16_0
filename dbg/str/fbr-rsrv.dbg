     1260   buf_fbr-doc.obj-code  = p-obj-code
     1261   buf_fbr-doc.obj-type  = p-obj-type
     1262   buf_fbr-doc.PS        = "@"
     1263   buf_fbr-doc.status_   = 'новый':U
     1264   buf_fbr-doc.user-db-num = v-obj-db-num
     1265   buf_fbr-doc.user-name   = p-userid
     1266   .
     1267   run fbrlib_get-default-pay-code in this-procedure (
     1268         input buf_fbr-doc.obj-type
     1269       , input buf_fbr-doc.obj-code
     1270       , output fi-pay-code
     1271   ).
     1272   buf_fbr-doc.pay-code = fi-pay-code.
     1273   p-recid = recid(buf_fbr-doc).
     1274   p-fbr-doc-code = buf_fbr-doc.doc-code.
     1275   end.
     1276   end procedure.
     1277   procedure fbrlib_get-default-pay-code :
     1278   define input parameter p-obj-type   as character        no-undo.
     1279   define input parameter p-obj-code   as integer          no-undo.
     1280   define output parameter p-pay-code  as integer          no-undo.
     1281   define variable v-host-code as integer no-undo .
     1282   define buffer buf_shop          for ub.shop.
     1283   define buffer buf_store         for ub.store.
     1284   define buffer buf_sysconf       for ub.sysconf.
     1285   do
     1286   for buf_shop
     1287     , buf_store
     1288     , buf_sysconf
     1289   on error undo, return error
     1290   :
     1291     case p-obj-type  :
     1292       when 'маг':U then do:
     1293           find first buf_shop no-lock
     1294                 where buf_shop.obj-code = p-obj-code
     1295           no-error.
     1296           if available buf_shop
     1297           then do:
     1298               assign
     1299                   p-pay-code = buf_shop.fbr-pay
     1300               .
     1301           end.
     1302       end.
     1303       when 'скл':U then do:
     1304           find first buf_store no-lock
     1305                 where buf_store.obj-code = p-obj-code
     1306           no-error.
     1307           if available buf_store
     1308           then do:
     1309               assign
     1310                   p-pay-code = buf_store.fbr-pay
     1311               .
     1312           end.
     1313       end.
     1314     end case.
     1315     if p-pay-code = ?
     1316     or p-pay-code = 0
     1317     then do:
     1318   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1319   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1320     (input  p-obj-type
     1321     ,input  p-obj-code
     1322     ,output v-host-code
     1323     )  .
     1324         find first buf_sysconf no-lock
     1325               where buf_sysconf.host-code = v-host-code
     1326         no-error.
     1327         if available buf_sysconf
     1328         then do:
     1329             assign
     1330                 p-pay-code = buf_sysconf.fbr-pay
     1331             .
     1332         end.
     1333     end.
     1334     if p-pay-code = ?
     1335     or p-pay-code = 0
     1336     then do:
     1337   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1338   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdnpay in g#library
     1339     (input  p-obj-type
     1340     ,input  p-obj-code
     1341     ,output p-pay-code
     1342     )  .
     1343     end.
     1344   end.
     1345   end procedure.
     1346   procedure fbrlib-fill-and-check-temp_fbrlib_recipe :
     1347   do
     1348   on error undo, return error
     1349   :
     1350   define input parameter p-fbr-doc-code as character    no-undo.
     1351       define variable vss-description as character    no-undo init "fbrlib-fill-and-check-temp_fbrlib_recipe: ".
     1352       define variable v-gds-name      as character    no-undo.
     1353       define buffer buf_fbr-doc               for ub.fbr-doc.
     1354       define buffer buf_fbr-line              for ub.fbr-line.
     1355       define buffer buf_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     1356       define buffer buf_out_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     1357       find first buf_fbr-doc no-lock
     1358            where buf_fbr-doc.doc-code = p-fbr-doc-code
     1359       .
     1360       for each buf_temp_fbrlib_recipe
     1361       :
     1362           delete buf_temp_fbrlib_recipe.
     1363       end.
     1364       for each buf_fbr-line no-lock
     1365          where buf_fbr-line.doc-code = p-fbr-doc-code
     1366       :
     1367           find first buf_temp_fbrlib_recipe
     1368                where buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     1369           no-error.
     1370           if not available buf_temp_fbrlib_recipe
     1371           then do:
     1372               create buf_temp_fbrlib_recipe.
     1373               assign
     1374                   buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     1375                   buf_temp_fbrlib_recipe.fbr-doc-code = buf_fbr-line.doc-code
     1376               .
     1377           end.
     1378       end.
     1379       for each buf_temp_fbrlib_recipe
     1380       :
     1381           assign
     1382               buf_temp_fbrlib_recipe.count-income                = 0
     1383               buf_temp_fbrlib_recipe.qnty-income                 = 0
     1384               buf_temp_fbrlib_recipe.sum-income-sale             = 0
     1385               buf_temp_fbrlib_recipe.sum-income-cost-base        = 0
     1386               buf_temp_fbrlib_recipe.sum-income-cost-rubl        = 0
     1387               buf_temp_fbrlib_recipe.sum-income-vat-cost-base    = 0
     1388               buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl    = 0
     1389               buf_temp_fbrlib_recipe.count-write-off             = 0
     1390               buf_temp_fbrlib_recipe.qnty-write-off              = 0
     1391               buf_temp_fbrlib_recipe.sum-write-off-sale          = 0
     1392               buf_temp_fbrlib_recipe.sum-write-off-cost-base     = 0
     1393               buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = 0
     1394               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = 0
     1395               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = 0
     1396           .
     1397           for each buf_fbr-line no-lock
     1398              where buf_fbr-line.doc-code     = p-fbr-doc-code
     1399                and buf_fbr-line.trn-type     = 'при':U
     1400                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     1401           :
     1402               if ( buf_fbr-line.price-base   = ?
     1403                   or buf_fbr-line.price-rubl = ?
     1404                   or buf_fbr-line.price-base <= 0
     1405                   or buf_fbr-line.price-rubl <= 0 )
     1406               and buf_fbr-line.fact-qnty <> 0
     1407               and buf_fbr-line.rsrv-qnty <> ?
     1408               and buf_fbr-doc.is-free    = no
     1409               then do:
     1410   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1411   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1412     (input  buf_fbr-line.artic
     1413     ,input  buf_fbr-line.prod-type
     1414     ,input  buf_fbr-line.prod-code
     1415     ,output v-gds-name
     1416     ) no-error .
     1417                   if error-status :error
     1418                   then do:
     1419                       assign
     1420                           v-gds-name = ""
     1421                       .
     1422                   end.
     1423                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     1424                                                 ,vss-description
     1425                                                 ,buf_fbr-doc.doc-code
     1426                                                 ,chr(10)
     1427                                                 ,buf_fbr-line.recipe-code
     1428                                                 ,buf_fbr-line.artic
     1429                                                 ,v-gds-name).
     1430               end.
     1431               assign
     1432                   buf_temp_fbrlib_recipe.count-income             = buf_temp_fbrlib_recipe.count-income + 1
     1433                   buf_temp_fbrlib_recipe.qnty-income              = buf_temp_fbrlib_recipe.qnty-income
     1434                                                                   + buf_fbr-line.fact-qnty
     1435                   buf_temp_fbrlib_recipe.sum-income-sale          = buf_temp_fbrlib_recipe.sum-income-sale
     1436                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     1437               .
     1438               if buf_fbr-line.is-waste = no
     1439               then do:
     1440                   assign
     1441                       buf_temp_fbrlib_recipe.sum-income-cost-base     = buf_temp_fbrlib_recipe.sum-income-cost-base
     1442                                                                       + buf_fbr-line.price-sum-base
     1443                       buf_temp_fbrlib_recipe.sum-income-cost-rubl     = buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1444                                                                       + buf_fbr-line.price-sum-rubl
     1445                       buf_temp_fbrlib_recipe.sum-income-vat-cost-base = buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1446                                                                       + buf_fbr-line.price-sum-vat-base
     1447                       buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1448                                                                       + buf_fbr-line.price-sum-vat-rubl
     1449                   .
     1450               end.
     1451           end.
     1452           for each buf_fbr-line no-lock
     1453              where buf_fbr-line.doc-code     = p-fbr-doc-code
     1454                and buf_fbr-line.trn-type     = 'спи':U
     1455                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     1456           :
     1457               if ( buf_fbr-line.price-base   = ?
     1458                   or buf_fbr-line.price-rubl = ?
     1459                   or buf_fbr-line.price-base <= 0
     1460                   or buf_fbr-line.price-rubl <= 0 )
     1461               and buf_fbr-line.fact-qnty <> 0
     1462               and buf_fbr-line.rsrv-qnty <> ?
     1463               and buf_fbr-doc.is-free    = no
     1464               and buf_fbr-doc.status_    = 'разрешен':U
     1465               then do:
     1466   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1467   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1468     (input  buf_fbr-line.artic
     1469     ,input  buf_fbr-line.prod-type
     1470     ,input  buf_fbr-line.prod-code
     1471     ,output v-gds-name
     1472     ) no-error .
     1473                   if error-status :error
     1474                   then do:
     1475                       assign
     1476                           v-gds-name = ""
     1477                       .
     1478                   end.
     1479                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     1480                                                 ,vss-description
     1481                                                 ,buf_fbr-doc.doc-code
     1482                                                 ,chr(10)
     1483                                                 ,buf_fbr-line.recipe-code
     1484                                                 ,buf_fbr-line.artic
     1485                                                 ,v-gds-name).
     1486               end.
     1487               assign
     1488                   buf_temp_fbrlib_recipe.count-write-off             = buf_temp_fbrlib_recipe.count-write-off + 1
     1489                   buf_temp_fbrlib_recipe.qnty-write-off              = buf_temp_fbrlib_recipe.qnty-write-off
     1490                                                                   + buf_fbr-line.fact-qnty
     1491                   buf_temp_fbrlib_recipe.sum-write-off-sale          = buf_temp_fbrlib_recipe.sum-write-off-sale
     1492                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     1493               .
     1494               if buf_fbr-line.is-waste = no
     1495               then do:
     1496                   assign
     1497                       buf_temp_fbrlib_recipe.sum-write-off-cost-base     = buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1498                                                                       + buf_fbr-line.price-sum-base
     1499                       buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1500                                                                       + buf_fbr-line.price-sum-rubl
     1501                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1502                                                                       + buf_fbr-line.price-sum-vat-base
     1503                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1504                                                                       + buf_fbr-line.price-sum-vat-rubl
     1505                   .
     1506               end.
     1507           end.
     1508           if buf_fbr-doc.status_    = 'разрешен':U
     1509           and ( abs( buf_temp_fbrlib_recipe.sum-write-off-cost-base     - buf_temp_fbrlib_recipe.sum-income-cost-base     ) > 0.01
     1510           or abs( buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     - buf_temp_fbrlib_recipe.sum-income-cost-rubl     ) > 0.01
     1511           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base - buf_temp_fbrlib_recipe.sum-income-vat-cost-base ) > 0.01
     1512           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl - buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl ) > 0.01
     1513               )
     1514           then do:
     1515            undo, return error
     1516               substitute("В документе пр-ва &1 Не совпадают суммы учетных цен для списанного и оприходованного по рецепту товара.&2" +
     1517                           "Рецепт: &3&2&4&4по списанному товару&4по оприходованному товару&2"  +
     1518                           "Сумма в баз.вал.&4&5&4&4&6&2" +
     1519                           "Сумма в &9.&4&7&4&4&8&2"
     1520                          , buf_fbr-doc.doc-code
     1521                          , chr(10)
     1522                          , buf_temp_fbrlib_recipe.recipe-code
     1523                          , chr(9)
     1524                          , buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1525                          , buf_temp_fbrlib_recipe.sum-income-cost-base
     1526                          , buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1527                          , buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1528                          , "руб"
     1529                          )
     1530              +
     1531              substitute("НДС в баз.вал.&1&2&1&1&3&4" +
     1532                         "НДС в &7.&1&5&1&1&6&4"
     1533                        ,  chr(9)
     1534                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1535                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1536                        ,chr(10)
     1537                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1538                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1539                        ,"руб"
     1540                        )       .
     1541           end.
     1542       end.
     1543   end.
     1544   end procedure.
     1545   procedure fbrlib-fill-sum-fbr-doc :
     1546   do
     1547   on error undo, return error
     1548   :
     1549   define input parameter p-fbr-doc-recid  as recid        no-undo.
     1550   define input parameter p-mode           as character    no-undo.
     1551       define variable vss-description as character init "fbrlib-fill-sum-fbr-doc: "  no-undo.
     1552       define buffer buf_fbr-doc           for ub.fbr-doc.
     1553       define buffer buf_fbr-line          for ub.fbr-line.
     1554       define buffer buf_temp_fbrlib_recipe   for temp_fbrlib_recipe.
     1555       define variable v-in-count          as integer       no-undo.
     1556       define variable v-out-count         as integer       no-undo.
     1557       find first buf_fbr-doc exclusive-lock
     1558            where recid ( buf_fbr-doc ) = p-fbr-doc-recid
     1559       .
     1560       find first buf_temp_fbrlib_recipe no-error.
     1561       if not available buf_temp_fbrlib_recipe
     1562       then do:
     1563           run fbrlib-fill-and-check-temp_fbrlib_recipe in this-procedure (
     1564               input buf_fbr-doc.doc-code
     1565           ) no-error.
     1566           if error-status :error
     1567           then do:
     1568               undo, return error substitute("&1 Ошибка расчета сумм при заполнении шапки документа производства.&2&3&2&4"
     1569                                              , vss-description
     1570                                              , chr(10)
     1571                                              , error-status:get-message(1)
     1572                                              , return-value ).
     1573           end.
     1574       end.
     1575       assign
     1576           v-in-count                  = 0
     1577           buf_fbr-doc.in-qnty         = 0
     1578           buf_fbr-doc.in-sale         = 0
     1579           buf_fbr-doc.in-base         = 0
     1580           buf_fbr-doc.in-rubl         = 0
     1581           buf_fbr-doc.in-vat-base     = 0
     1582           buf_fbr-doc.in-vat-rubl     = 0
     1583           v-out-count                 = 0
     1584           buf_fbr-doc.out-qnty        = 0
     1585           buf_fbr-doc.out-sale        = 0
     1586           buf_fbr-doc.out-base        = 0
     1587           buf_fbr-doc.out-rubl        = 0
     1588           buf_fbr-doc.out-vat-base    = 0
     1589           buf_fbr-doc.out-vat-rubl    = 0
     1590       .
     1591       for each buf_temp_fbrlib_recipe
     1592       :
     1593           assign
     1594               v-in-count                  = v-in-count                + buf_temp_fbrlib_recipe.count-income
     1595               buf_fbr-doc.in-qnty         = buf_fbr-doc.in-qnty       + buf_temp_fbrlib_recipe.qnty-income
     1596               buf_fbr-doc.in-sale         = buf_fbr-doc.in-sale       + buf_temp_fbrlib_recipe.sum-income-sale
     1597               buf_fbr-doc.in-base         = buf_fbr-doc.in-base       + buf_temp_fbrlib_recipe.sum-income-cost-base
     1598               buf_fbr-doc.in-rubl         = buf_fbr-doc.in-rubl       + buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1599               buf_fbr-doc.in-vat-base     = buf_fbr-doc.in-vat-base   + buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1600               buf_fbr-doc.in-vat-rubl     = buf_fbr-doc.in-vat-rubl   + buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1601               v-out-count                 = v-out-count               + buf_temp_fbrlib_recipe.count-write-off
     1602               buf_fbr-doc.out-qnty        = buf_fbr-doc.out-qnty      + buf_temp_fbrlib_recipe.qnty-write-off
     1603               buf_fbr-doc.out-sale        = buf_fbr-doc.out-sale      + buf_temp_fbrlib_recipe.sum-write-off-sale
     1604               buf_fbr-doc.out-base        = buf_fbr-doc.out-base      + buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1605               buf_fbr-doc.out-rubl        = buf_fbr-doc.out-rubl      + buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1606               buf_fbr-doc.out-vat-base    = buf_fbr-doc.out-vat-base  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1607               buf_fbr-doc.out-vat-rubl    = buf_fbr-doc.out-vat-rubl  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1608           .
     1609       end.
     1610       if ( abs (buf_fbr-doc.in-rubl - buf_fbr-doc.out-rubl) <= 0.01
     1611       and   abs (buf_fbr-doc.in-base - buf_fbr-doc.out-base) <= 0.01 )
     1612       or p-mode <> 'факт':U
     1613       then do:
     1614           if substring( buf_fbr-doc.PS, 1, 1 ) = "@"
     1615           then do:
     1616               assign
     1617                   buf_fbr-doc.PS = "@ Строк полученных товаров : "
     1618                                   + string( v-out-count, ">>>,>>9" )
     1619                                   + chr(10) + "Строк исходных товаров : "
     1620                                   + string( v-in-count, ">>>,>>9" )
     1621               .
     1622           end.
     1623       end.
     1624       else do:
     1625         undo, return error substitute("В док-те пр-ва &1 не совпадают суммы списанных и оприходованных товаров.&2" +
     1626                                       "Сумма списанных товаров в &3 - &4&2" +
     1627                                       "Сумма оприходованных товаров в &3 - &5&2" +
     1628                                       "Сумма оприходованных товаров в &3 - &6&2" +
     1629                                       "Сумма списанных товаров в баз.вал. - &7&2" +
     1630                                       "Сумма оприходованных товаров в баз.вал. - &8&2"
     1631                                       , buf_fbr-doc.doc-code
     1632                                       , chr(10)
     1633                                       , "рублях"
     1634                                       , round( buf_fbr-doc.out-rubl, 2 )
     1635                                       , round( buf_fbr-doc.in-rubl,  2 )
     1636                                       , round( buf_fbr-doc.in-rubl,  2 )
     1637                                       , round( buf_fbr-doc.out-base, 2 )
     1638                                       , round( buf_fbr-doc.in-base,  2 )).
     1639       end.
     1640   end.
     1641   end procedure.
     1642   procedure fbrlib-calc-prices :
     1643   do
     1644   on error undo, return error
     1645   :
     1646   define input parameter p-fbr-line-recid as recid        no-undo.
     1647   define input parameter p-price-obj-type as character    no-undo.
     1648   define input parameter p-price-obj-code as integer      no-undo.
     1649   define output parameter p-current-price as decimal      no-undo.
     1650       define variable v-void          as decimal       no-undo.
     1651       define variable v-void-char     as character     no-undo.
     1652       define variable v-gds-code      as integer       no-undo.
     1653       define variable v-b-code        as integer       no-undo.
     1654       define buffer buf_fbr-doc   for ub.fbr-doc.
     1655       define buffer buf_fbr-line  for ub.fbr-line.
     1656       define buffer buf_gds-prt   for ub.gds-prt.
     1657       define buffer buf_bar-code  for ub.bar-code.
     1658       find first buf_fbr-line no-lock
     1659           where recid( buf_fbr-line ) = p-fbr-line-recid
     1660       .
     1661   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1662   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1663     (input  buf_fbr-line.artic
     1664     ,input  buf_fbr-line.prod-type
     1665     ,input  buf_fbr-line.prod-code
     1666     ,output v-gds-code
     1667     ) no-error .
     1668       if error-status :error
     1669       then do:
     1670         undo, return error substitute("&1 &2 &3&4Ошибка определения кода товара (артикул &7).&4&5&4&6"
     1671                                         ,vss-workfile
     1672                                         ,vss-revision
     1673                                         ,vss-description
     1674                                         ,chr(10)
     1675                                         , error-status:get-message(1)
     1676                                         , return-value
     1677                                         , buf_fbr-line.artic
     1678                                         ).
     1679       end.
     1680   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1681     (input  v-gds-code
     1682     ,input  ?
     1683     ,output v-b-code
     1684     ) no-error .
     1685       if error-status :error
     1686       then do:
     1687         undo, return error substitute("&1 &2 &3&4Ошибка определения основного бар-кода товара (код товара) &7.&4&5&4&6"
     1688                                         ,vss-workfile
     1689                                         ,vss-revision
     1690                                         ,vss-description
     1691                                         ,chr(10)
     1692                                         , error-status:get-message(1)
     1693                                         , return-value
     1694                                         , v-gds-code
     1695                                         ).
     1696       end.
     1697       if buf_fbr-line.is-calc = no
     1698       then do:
     1699   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1700   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1701     (input  p-price-obj-type
     1702     ,input  p-price-obj-code
     1703     ,input  v-b-code
     1704     ,input  0
     1705     ,input  0
     1706     ,output v-void-char
     1707     ,output p-current-price
     1708     ,output v-void
     1709     ,output v-void
     1710     ) no-error .
     1711           if error-status :error
     1712           then do:
     1713             undo, return error substitute("&1 &2 &3&4Ошибка определения продажной цены основного бар-кода товара (код товара) &7.&4&5&4&6"
     1714                                             ,vss-workfile
     1715                                             ,vss-revision
     1716                                             ,vss-description
     1717                                             ,chr(10)
     1718                                             , error-status:get-message(1)
     1719                                             , return-value
     1720                                             , v-gds-code
     1721                                             ).
     1722           end.
     1723       end.
     1724       else do:
     1725           assign
     1726               p-current-price = buf_fbr-line.price-sale
     1727           .
     1728       end.
     1729   end.
     1730   end procedure.
     1731   procedure fbrlib-put-in-order-recipe :
     1732   do
     1733   on error undo, return error
     1734   :
     1735   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     1736       define variable v-recipe-counter    as integer          no-undo.
     1737       define variable v-recipe-amount     as integer init 0   no-undo.
     1738       define variable v-child-counter     as integer          no-undo.
     1739       define variable v-is-call-cycle     as logical          no-undo.
     1740       define variable v-str as character     no-undo.
     1741       define buffer buf_in_fbr-line       for ub.fbr-line.
     1742       define buffer buf_dress_fbr-line    for ub.fbr-line.
     1743       define buffer buf_fbr-line          for ub.fbr-line.
     1744       define buffer buf_recipe-gds        for ub.recipe-gds.
     1745       define buffer buf_recipe            for ub.recipe.
     1746       for each temp_recipe-childs-qnty
     1747       :
     1748           delete temp_recipe-childs-qnty.
     1749       end.
     1750       for each temp_recipe-childs
     1751       :
     1752           delete temp_recipe-childs.
     1753       end.
     1754       for each temp_recipe-order
     1755       :
     1756           delete temp_recipe-order.
     1757       end.
     1758       for each buf_fbr-line no-lock
     1759          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     1760       on error undo, return error
     1761       :
     1762           find first temp_recipe-childs-qnty
     1763                where temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     1764           no-error.
     1765           if not available temp_recipe-childs-qnty
     1766           then do:
     1767               create temp_recipe-childs-qnty.
     1768               assign
     1769                   v-recipe-amount                     = v-recipe-amount + 1
     1770                   temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     1771                   temp_recipe-childs-qnty.order       = v-recipe-amount
     1772                   temp_recipe-childs-qnty.childs-qnty = 0
     1773                   v-child-counter                     = 0
     1774               .
     1775           end.
     1776       end.
     1777       for each buf_in_fbr-line no-lock
     1778          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     1779            and buf_in_fbr-line.trn-type = 'спи':U
     1780       on error undo, return error
     1781       :
     1782           for each buf_dress_fbr-line no-lock
     1783              where buf_dress_fbr-line.doc-code    = p-fbr-doc-doc-code
     1784                and buf_dress_fbr-line.trn-type    = 'при':U
     1785                and buf_dress_fbr-line.artic       = buf_in_fbr-line.artic
     1786                and buf_dress_fbr-line.prod-type   = buf_in_fbr-line.prod-type
     1787                and buf_dress_fbr-line.prod-code   = buf_in_fbr-line.prod-code
     1788           on error undo, return error
     1789           :
     1790               find first buf_recipe no-lock
     1791                    where buf_recipe.recipe-code = buf_dress_fbr-line.recipe-code
     1792               .
     1793               if buf_in_fbr-line.is-comp = yes
     1794               then do:
     1795                   find last temp_recipe-childs-qnty
     1796                       where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     1797                   .
     1798                   assign
     1799                       temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     1800                   .
     1801                   create temp_recipe-childs.
     1802                   assign
     1803                       temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     1804                       temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     1805                       temp_recipe-childs.child-recipe-code    = buf_dress_fbr-line.recipe-code
     1806                   .
     1807               end.
     1808               else do:
     1809               end.
     1810           end.
     1811       end.
     1812       for each buf_in_fbr-line no-lock
     1813          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     1814            and buf_in_fbr-line.trn-type = 'при':U
     1815       on error undo, return error
     1816       :
     1817           find first buf_recipe no-lock
     1818                where buf_recipe.recipe-code = buf_in_fbr-line.recipe-code
     1819           no-error.
     1820           if buf_in_fbr-line.is-comp = no
     1821           then do:
     1822           end.
     1823           else do:
     1824               for each buf_recipe-gds no-lock
     1825               where buf_recipe-gds.recipe-code = buf_in_fbr-line.recipe-code
     1826               :
     1827                   for each buf_fbr-line no-lock
     1828                   where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     1829                       and buf_fbr-line.trn-type    = 'при':U
     1830                       and buf_fbr-line.artic       = buf_recipe-gds.artic
     1831                       and buf_fbr-line.prod-type   = buf_recipe-gds.prod-type
     1832                       and buf_fbr-line.prod-code   = buf_recipe-gds.prod-code
     1833                   on error undo, return error
     1834                   :
     1835                       find first buf_recipe no-lock
     1836                            where buf_recipe.recipe-code = buf_fbr-line.recipe-code
     1837                       .
     1838                       if buf_recipe.recipe-type = 'разделка':U
     1839                       then do:
     1840                       end.
     1841                       else do:
     1842                           find last temp_recipe-childs-qnty
     1843                               where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     1844                           .
     1845                           assign
     1846                               temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     1847                           .
     1848                           create temp_recipe-childs.
     1849                           assign
     1850                               temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     1851                               temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     1852                               temp_recipe-childs.child-recipe-code    = buf_fbr-line.recipe-code
     1853                           .
     1854                       end.
     1855                   end.
     1856               end.
     1857           end.
     1858       end.
     1859       for each temp_recipe-order
     1860       on error undo, return error
     1861       :
     1862           delete temp_recipe-order.
     1863       end.
     1864       assign
     1865           v-fbrlib-recipe-order = 0
     1866       .
     1867       do v-recipe-counter = 1 to v-recipe-amount
     1868       on error undo, return error
     1869       :
     1870           run fbrlib-add-recipe-in-tmp-order in this-procedure (
     1871                 input v-recipe-counter
     1872               , input 0
     1873               , output v-is-call-cycle
     1874           ).
     1875           if v-is-call-cycle = yes
     1876           then do:
     1877               message
     1878                       "Достигнут максимальный уровень вложенности рецептов."
     1879                   skip(1)
     1880                   skip "Невозможно упорядочить рецепты."
     1881                   skip(1)
     1882                   skip "Необходимо изменить структуру рецептов,"
     1883                   skip "используемых при формировании"
     1884                   skip "данного документа производства."
     1885               view-as alert-box error
     1886               title "Невозможно рассчитать документ производства".
     1887               for each temp_recipe-childs-qnty
     1888               :
     1889                   delete temp_recipe-childs-qnty.
     1890               end.
     1891               for each temp_recipe-childs
     1892               :
     1893                   delete temp_recipe-childs.
     1894               end.
     1895               for each temp_recipe-order
     1896               :
     1897                   delete temp_recipe-order.
     1898               end.
     1899               for each temp_recipe-order
     1900               on error undo, return error
     1901               :
     1902                   delete temp_recipe-order.
     1903               end.
     1904               for each temp_fbrlib_recipe
     1905               on error undo, return error
     1906               :
     1907                   delete temp_recipe-order.
     1908               end.
     1909               undo, return error.
     1910           end.
     1911       end.
     1912   end.
     1913   end procedure.
     1914   procedure fbrlib-add-recipe-in-tmp-order :
     1915   do
     1916   on error undo, return error
     1917   :
     1918   define input parameter p-order              as integer      no-undo.
     1919   define input parameter p-call-counter       as integer      no-undo.
     1920   define output parameter p-is-call-cycle     as logical      no-undo.
     1921       define variable v-nodes-counter     as integer       no-undo.
     1922       define buffer buf_c_temp_recipe-childs-qnty for temp_recipe-childs-qnty.
     1923       define buffer buf_temp_recipe-childs-qnty   for temp_recipe-childs-qnty.
     1924       define buffer buf_temp_recipe-childs        for temp_recipe-childs     .
     1925       define buffer buf_temp_recipe-order         for temp_recipe-order.
     1926       assign
     1927           p-call-counter = p-call-counter + 1
     1928       .
     1929       if p-call-counter > 50
     1930       then do:
     1931           assign
     1932               p-is-call-cycle = yes
     1933           .
     1934       end.
     1935       else do:
     1936           find first buf_temp_recipe-childs-qnty
     1937                where buf_temp_recipe-childs-qnty.order = p-order
     1938           .
     1939           find first buf_temp_recipe-order
     1940                where buf_temp_recipe-order.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     1941           no-error.
     1942           if not available buf_temp_recipe-order
     1943           then do:
     1944               do v-nodes-counter = 1 to buf_temp_recipe-childs-qnty.childs-qnty
     1945               :
     1946                   find first buf_temp_recipe-childs
     1947                        where buf_temp_recipe-childs.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     1948                          and buf_temp_recipe-childs.child-code  = v-nodes-counter
     1949                   .
     1950                   find first buf_c_temp_recipe-childs-qnty
     1951                        where buf_c_temp_recipe-childs-qnty.recipe-code = buf_temp_recipe-childs.child-recipe-code
     1952                   .
     1953                   run fbrlib-add-recipe-in-tmp-order in this-procedure (
     1954                         input buf_c_temp_recipe-childs-qnty.order
     1955                       , input p-call-counter
     1956                       , output p-is-call-cycle
     1957                   ).
     1958                   if p-is-call-cycle = yes
     1959                   then do:
     1960                       return.
     1961                   end.
     1962               end.
     1963               assign
     1964                   v-fbrlib-recipe-order = v-fbrlib-recipe-order + 1
     1965               .
     1966               create buf_temp_recipe-order.
     1967               assign
     1968                   buf_temp_recipe-order.recipe-code   = buf_temp_recipe-childs-qnty.recipe-code
     1969                   buf_temp_recipe-order.order         = v-fbrlib-recipe-order
     1970               .
     1971           end.
     1972       end.
     1973   end.
     1974   end procedure.
     1975   procedure fbrlib-get-trn-type :
     1976   define input parameter p-recipe-code    as character    no-undo.
     1977   define input parameter p-goods-recid    as recid        no-undo.
     1978   define input parameter p-is-integration as logical      no-undo.
     1979   define output parameter p-is-comp       as logical      no-undo.
     1980   define output parameter p-trn-type      as character    no-undo.
     1981   define buffer buf_recipe    for ub.recipe.
     1982   define buffer buf_goods     for ub.goods.
     1983   do
     1984   for buf_recipe
     1985     , buf_goods
     1986   on error undo, return error
     1987   :
     1988       find first buf_goods no-lock
     1989            where recid( buf_goods ) = p-goods-recid
     1990       .
     1991       find first buf_recipe no-lock
     1992            where buf_recipe.recipe-code = p-recipe-code
     1993       no-error.
     1994       if not available buf_recipe
     1995       then do:
     1996           assign
     1997               p-is-comp = no
     1998               p-trn-type = "":U
     1999           .
     2000           undo, return.
     2001       end.
     2002       if  buf_recipe.artic        = buf_goods.artic
     2003       and buf_recipe.prod-type    = buf_goods.prod-type
     2004       and buf_recipe.prod-code    = buf_goods.prod-code
     2005       then do:
     2006           assign
     2007               p-is-comp = yes
     2008           .
     2009       end.
     2010       else do:
     2011           assign
     2012               p-is-comp = no
     2013           .
     2014       end.
     2015       case buf_recipe.recipe-type
     2016       :
     2017           when 'производство':U
     2018           then do:
     2019               if p-is-comp = yes
     2020               then do:
     2021                   assign
     2022                       p-trn-type = 'при':U
     2023                   .
     2024               end.
     2025               else do:
     2026                   assign
     2027                       p-trn-type = 'спи':U
     2028                   .
     2029               end.
     2030           end.
     2031           when 'альтернатива':U
     2032           then do:
     2033               if p-is-comp = yes
     2034               then do:
     2035                   assign
     2036                       p-trn-type = 'при':U
     2037                   .
     2038               end.
     2039               else do:
     2040                   assign
     2041                       p-trn-type = 'спи':U
     2042                   .
     2043               end.
     2044           end.
     2045           when 'разделка':U
     2046           then do:
     2047               if p-is-comp = no
     2048               then do:
     2049                   assign
     2050                       p-trn-type = 'при':U
     2051                   .
     2052               end.
     2053               else do:
     2054                   assign
     2055                       p-trn-type = 'спи':U
     2056                   .
     2057               end.
     2058           end.
     2059           when 'комплектация':U
     2060           then do:
     2061               if p-is-integration = ?
     2062               then do:
     2063                   message
     2064                       "Выберите тип операции по рецепту комплектации:"
     2065                       skip (2) "YES - комплектация"
     2066                       skip     "NO - разукомплектация"
     2067                   view-as alert-box question
     2068                   buttons YES-NO
     2069                   update p-is-integration.
     2070               end.
     2071               if p-is-integration = yes
     2072               then do:
     2073                   if p-is-comp = yes
     2074                   then do:
     2075                       assign
     2076                           p-trn-type = 'при':U
     2077                       .
     2078                   end.
     2079                   else do:
     2080                       assign
     2081                           p-trn-type = 'спи':U
     2082                       .
     2083                   end.
     2084               end.
     2085               else do:
     2086                   if p-is-comp = yes
     2087                   then do:
     2088                       assign
     2089                           p-trn-type = 'спи':U
     2090                       .
     2091                   end.
     2092                   else do:
     2093                       assign
     2094                           p-trn-type = 'при':U
     2095                       .
     2096                   end.
     2097               end.
     2098           end.
     2099       end case.
     2100   end.
     2101   end procedure.
     2102   procedure fbrlib-get-mark :
     2103   define input parameter p-recipe-code    as character    no-undo.
     2104   define output parameter p-mark          as logical    no-undo.
     2105   define buffer buf_goods-attr     for ub.goods-attr.
     2106   define buffer buf_recipe-gds for ub.recipe-gds .
     2107       for each buf_recipe-gds no-lock where buf_recipe-gds.recipe-code = p-recipe-code,
     2108            first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_recipe-gds.gds-code and
     2109                                               buf_goods-attr.attr-code = 'mark-type':U:
     2110            if buf_goods-attr.attr-value <> "" and buf_goods-attr.attr-value <> "not-type" then do:
     2111               p-mark = true .
     2112               return .
     2113            end.
     2114       end.
     2115   end procedure.
     2116   procedure fbrlib-check-temp-tables :
     2117   do
     2118   on error undo, return error
     2119   :
     2120   define input parameter p-title  as character    no-undo.
     2121       define variable v-str               as character        no-undo.
     2122       assign
     2123           v-str = v-str + chr(10) + "temp_recipe-childs-qnty:" + chr(10)
     2124       .
     2125       for each temp_recipe-childs-qnty
     2126       on error undo, return error
     2127       :
     2128           assign
     2129               v-str   = v-str + string( temp_recipe-childs-qnty.recipe-code )
     2130                       + "   " + string( temp_recipe-childs-qnty.childs-qnty )
     2131                       + "   " + string( temp_recipe-childs-qnty.order )
     2132                       + chr(10)
     2133           .
     2134       end.
     2135       assign
     2136           v-str = v-str + "temp_recipe-childs:" + chr(10)
     2137       .
     2138       for each temp_recipe-childs
     2139       on error undo, return error
     2140       :
     2141           assign
     2142               v-str   = v-str + string( temp_recipe-childs.recipe-code )
     2143                       + "   " + string( temp_recipe-childs.child-code )
     2144                       + "   " + string( temp_recipe-childs.child-recipe-code )
     2145                       + chr(10)
     2146           .
     2147       end.
     2148       assign
     2149           v-str = v-str + chr(10) + "temp_recipe-order:" + chr(10)
     2150       .
     2151       for each temp_recipe-order
     2152       on error undo, return error
     2153       :
     2154           assign
     2155               v-str   = v-str + string( temp_recipe-order.recipe-code )
     2156                       + "   " + string( temp_recipe-order.order )
     2157                       + chr(10)
     2158           .
     2159       end.
     2160       assign
     2161           v-str = v-str + chr(10) + "temp_fbrlib_recipe:" + chr(10)
     2162       .
     2163       run writelog in this-procedure ( input "fbr.log", input 0, input p-title ).
     2164       run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     2165       for each temp_fbrlib_recipe
     2166       on error undo, return error
     2167       :
     2168           assign
     2169               v-str   = "recipe-code: "                   + string( temp_fbrlib_recipe.recipe-code                 )
     2170                       + "   " + "count-income: "                  + string( temp_fbrlib_recipe.count-income                )
     2171                       + "   " + "qnty-income: "                   + string( temp_fbrlib_recipe.qnty-income                 )
     2172                       + "   " + "sum-income-sale: "               + string( temp_fbrlib_recipe.sum-income-sale             )
     2173                       + "   " + "sum-income-cost-base: "          + string( temp_fbrlib_recipe.sum-income-cost-base        )
     2174                       + "   " + "sum-income-cost-rubl: "          + string( temp_fbrlib_recipe.sum-income-cost-rubl        )
     2175                       + "   " + "sum-income-vat-cost-base: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-base    )
     2176                       + "   " + "sum-income-vat-cost-rubl: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-rubl    )
     2177                       + "   " + "count-write-off: "               + string( temp_fbrlib_recipe.count-write-off             )
     2178                       + "   " + "qnty-write-off: "                + string( temp_fbrlib_recipe.qnty-write-off              )
     2179                       + "   " + "sum-write-off-sale: "            + string( temp_fbrlib_recipe.sum-write-off-sale          )
     2180                       + "   " + "sum-write-off-cost-base: "       + string( temp_fbrlib_recipe.sum-write-off-cost-base     )
     2181                       + "   " + "sum-write-off-cost-rubl: "       + string( temp_fbrlib_recipe.sum-write-off-cost-rubl     )
     2182                       + "   " + "sum-write-off-vat-cost-base: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-base )
     2183                       + "   " + "sum-write-off-vat-cost-rubl: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-rubl )
     2184                       + chr(10)
     2185           .
     2186           run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     2187       end.
     2188   end.
     2189   end procedure.
     2190   procedure fbrlib-s-coeff-value :
     2191   define input  parameter p-gds-code    as integer        no-undo.
     2192   define input  parameter p-date        as date           no-undo.
     2193   define input  parameter p-obj-type    as character      no-undo.
     2194   define input  parameter p-obj-code    as integer        no-undo.
     2195   define output parameter p-coeff-value as decimal        no-undo.
     2196   define variable vss-description as character init "fbrlib-s-coeff-value-01: определяет значение сезонного коэффициента" no-undo.
     2197       define variable v-date          as date         no-undo.
     2198       define variable v-host-code     as integer      no-undo.
     2199       define buffer buf_goods       for ub.goods.
     2200       define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     2201       define buffer buf_clients     for ub.clients.
     2202       define buffer buf_s-coeff     for ub.s-coeff.
     2203   do
     2204   for buf_goods
     2205     , buf_fbr-gds-obj
     2206     , buf_clients
     2207     , buf_s-coeff
     2208   on error undo, return error return-value
     2209   :
     2210       find first buf_goods no-lock
     2211            where buf_goods.gds-code = p-gds-code
     2212       no-error .
     2213       if not available buf_goods
     2214       then do:
     2215          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден товар с кодом &1", p-gds-code).
     2216       end.
     2217       find first buf_clients no-lock
     2218            where buf_clients.obj-type = p-obj-type
     2219              and buf_clients.obj-code = p-obj-code
     2220       no-error.
     2221       if not available buf_clients
     2222       then do:
     2223          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден объект &1&2", p-obj-type, p-obj-code).
     2224       end.
     2225       assign
     2226           v-date = date(month(p-date), day(p-date), Year(01/01/1996))
     2227       .
     2228       find first buf_fbr-gds-obj no-lock
     2229            where buf_fbr-gds-obj.gds-code = p-gds-code
     2230              and buf_fbr-gds-obj.obj-type = p-obj-type
     2231              and buf_fbr-gds-obj.obj-code = p-obj-code
     2232       no-error.
     2233       if not available buf_fbr-gds-obj
     2234       or buf_fbr-gds-obj.is-season = no
     2235       then do:
     2236           assign
     2237               p-coeff-value = 0
     2238           .
     2239           return.
     2240       end.
     2241   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2242   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2243     (input  p-obj-type
     2244     ,input  p-obj-code
     2245     ,output v-host-code
     2246     )  .
     2247       find last buf_s-coeff no-lock
     2248           where buf_s-coeff.gds-code = p-gds-code
     2249             and buf_s-coeff.host-code = v-host-code
     2250             and buf_s-coeff.obj-type = p-obj-type
     2251             and buf_s-coeff.obj-code = p-obj-code
     2252             and buf_s-coeff.s-date <= v-date
     2253       no-error.
     2254       if available buf_s-coeff
     2255       then do:
     2256           assign
     2257               p-coeff-value = buf_s-coeff.coeff-value
     2258           .
     2259           return.
     2260       end.
     2261       find last buf_s-coeff no-lock
     2262           where buf_s-coeff.gds-code = p-gds-code
     2263             and buf_s-coeff.host-code = v-host-code
     2264             and buf_s-coeff.obj-type = "":U
     2265             and buf_s-coeff.obj-code = 0
     2266             and buf_s-coeff.s-date <= v-date
     2267       no-error.
     2268       if available buf_s-coeff
     2269       then do:
     2270           assign
     2271               p-coeff-value = buf_s-coeff.coeff-value
     2272           .
     2273           return.
     2274       end.
     2275       find last buf_s-coeff no-lock
     2276           where buf_s-coeff.gds-code = p-gds-code
     2277             and buf_s-coeff.host-code = 0
     2278             and buf_s-coeff.obj-type = "":U
     2279             and buf_s-coeff.obj-code = 0
     2280             and buf_s-coeff.s-date <= v-date
     2281       no-error.
     2282       if available buf_s-coeff
     2283       then do:
     2284           assign
     2285               p-coeff-value = buf_s-coeff.coeff-value
     2286           .
     2287       end.
     2288       else do:
     2289           assign
     2290               p-coeff-value = 0
     2291           .
     2292       end.
     2293   end.
     2294   end procedure.
     2295   procedure fbrlib_create-fbr-recipe-gds :
     2296   define input parameter p-doc-code         as character      no-undo.
     2297   define input parameter p-recipe-code      as character      no-undo.
     2298   define input parameter p-prod-type        as character      no-undo.
     2299   define input parameter p-prod-code        as integer        no-undo.
     2300   define input parameter p-artic            as character      no-undo.
     2301   define input parameter p-gds-code         as integer        no-undo.
     2302   define input parameter p-is-waste         as logical        no-undo.
     2303   define input parameter p-proc-number      as integer        no-undo.
     2304   define input parameter p-obj-date         as date           no-undo.
     2305   define input parameter p-obj-type         as character      no-undo.
     2306   define input parameter p-obj-code         as integer        no-undo.
     2307   define input parameter p-calc-method      as decimal        no-undo.
     2308   define input parameter p-coeff-waste      as decimal        no-undo.
     2309   define input parameter p-orig-qnty        as decimal        no-undo.
     2310   define input parameter p-orig-brutto-qnty as decimal        no-undo.
     2311       define variable v-coeff-season  as decimal      no-undo.
     2312       define variable v-void-decimal  as decimal      no-undo.
     2313       define variable v-void-integer  as integer      no-undo.
     2314       define variable v-recipe-type   as character    no-undo.
     2315       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     2316       define buffer buf_goods             for ub.goods.
     2317       define buffer buf_recipe            for ub.recipe.
     2318   do
     2319   for buf_fbr-recipe-gds
     2320     , buf_recipe
     2321     , buf_goods
     2322   on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2323   :
     2324       find first buf_fbr-recipe-gds exclusive-lock
     2325            where buf_fbr-recipe-gds.doc-code    = p-doc-code
     2326              and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     2327              and buf_fbr-recipe-gds.prod-type   = p-prod-type
     2328              and buf_fbr-recipe-gds.prod-code   = p-prod-code
     2329              and buf_fbr-recipe-gds.artic       = p-artic
     2330       no-error.
     2331       if not available buf_fbr-recipe-gds
     2332       then do:
     2333           create buf_fbr-recipe-gds.
     2334           assign
     2335               buf_fbr-recipe-gds.doc-code           = p-doc-code
     2336               buf_fbr-recipe-gds.recipe-code        = p-recipe-code
     2337               buf_fbr-recipe-gds.prod-type          = p-prod-type
     2338               buf_fbr-recipe-gds.prod-code          = p-prod-code
     2339               buf_fbr-recipe-gds.artic              = p-artic
     2340               buf_fbr-recipe-gds.gds-code           = p-gds-code
     2341               buf_fbr-recipe-gds.is-waste           = p-is-waste
     2342               buf_fbr-recipe-gds.proc-number        = p-proc-number
     2343               buf_fbr-recipe-gds.recipe-qnty        = p-orig-qnty
     2344               buf_fbr-recipe-gds.recipe-brutto-qnty = p-orig-brutto-qnty
     2345           .
     2346           find first buf_goods no-lock
     2347                where buf_goods.prod-type = buf_fbr-recipe-gds.prod-type
     2348                  and buf_goods.prod-code = buf_fbr-recipe-gds.prod-code
     2349                  and buf_goods.artic     = buf_fbr-recipe-gds.artic
     2350           .
     2351           run fbrlib-s-coeff-value in this-procedure (
     2352                 input buf_goods.gds-code
     2353               , input p-obj-date
     2354               , input p-obj-type
     2355               , input p-obj-code
     2356               , output v-coeff-season
     2357           ) no-error.
     2358           if error-status:error
     2359           then do:
     2360               return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
     2361           end.
     2362           assign
     2363               buf_fbr-recipe-gds.qnty         = p-orig-qnty
     2364               buf_fbr-recipe-gds.coeff-value  = v-coeff-season
     2365               buf_fbr-recipe-gds.coeff-waste  = p-coeff-waste
     2366           .
     2367           run fbrlib-get-recipe-type in this-procedure (
     2368                 input buf_fbr-recipe-gds.doc-code
     2369               , input buf_fbr-recipe-gds.recipe-code
     2370               , output v-recipe-type
     2371           ).
     2372           if v-recipe-type <> 'производство':U
     2373           then do:
     2374               assign
     2375                   buf_fbr-recipe-gds.coeff-value  = 0
     2376                   buf_fbr-recipe-gds.coeff-waste  = 0
     2377                   buf_fbr-recipe-gds.calc-method  = 1
     2378                   buf_fbr-recipe-gds.brutto-qnty  = buf_fbr-recipe-gds.qnty
     2379               .
     2380           end.
     2381           else do:
     2382               run fbrlib-calc-brutto in this-procedure (
     2383                     input v-recipe-type
     2384                   , input buf_fbr-recipe-gds.qnty
     2385                   , input buf_fbr-recipe-gds.coeff-value
     2386                   , input buf_fbr-recipe-gds.coeff-waste
     2387                   , input 0
     2388                   , input 3
     2389                   , output v-void-decimal
     2390                   , output v-void-decimal
     2391                   , output buf_fbr-recipe-gds.brutto-qnty
     2392                   , output v-void-integer
     2393               ).
     2394               assign
     2395                   buf_fbr-recipe-gds.calc-method  = p-calc-method
     2396               .
     2397               run fbrlib-calc-brutto in this-procedure (
     2398                     input v-recipe-type
     2399                   , input buf_fbr-recipe-gds.qnty
     2400                   , input buf_fbr-recipe-gds.coeff-value
     2401                   , input buf_fbr-recipe-gds.coeff-waste
     2402                   , input buf_fbr-recipe-gds.brutto-qnty
     2403                   , input buf_fbr-recipe-gds.calc-method
     2404                   , output buf_fbr-recipe-gds.qnty
     2405                   , output v-void-decimal
     2406                   , output v-void-decimal
     2407                   , output v-void-integer
     2408               ).
     2409           end.
     2410       end.
     2411   end.
     2412   end procedure.
     2413   procedure fbrlib-set-default-recipe :
     2414   define input parameter p-obj-type   as character    no-undo.
     2415   define input parameter p-obj-code   as integer      no-undo.
     2416   define input parameter p-gds-code   as integer      no-undo.
     2417       define variable v-artic             as character    no-undo.
     2418       define variable v-prod-type         as character    no-undo.
     2419       define variable v-prod-code         as character    no-undo.
     2420       define variable v-recipe-code       as character    no-undo.
     2421       define variable v-fbr-gds-obj-recid as recid        no-undo.
     2422       define variable v-recipe-found      as logical      no-undo.
     2423       define buffer buf_recipe        for ub.recipe.
     2424       define buffer buf_other_recipe  for ub.recipe.
     2425       define buffer buf_goods         for ub.goods.
     2426       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     2427   do
     2428   for buf_recipe
     2429     , buf_goods
     2430     , buf_fbr-gds-obj
     2431   on error undo, return error
     2432   :
     2433       find first buf_goods no-lock
     2434            where buf_goods.gds-code = p-gds-code
     2435       .
     2436       run fbrlib-get-obj-recipe in this-procedure (
     2437             input p-obj-type
     2438           , input p-obj-code
     2439           , input p-gds-code
     2440           , output v-recipe-code
     2441       ).
     2442       if v-recipe-code <> ""
     2443       then do:
     2444           find first buf_recipe no-lock
     2445               where buf_recipe.recipe-code = v-recipe-code
     2446           no-error.
     2447           if not available buf_recipe
     2448           then do:
     2449               assign
     2450                   v-recipe-code = ""
     2451               .
     2452           end.
     2453       end.
     2454       if v-recipe-code = ""
     2455       then do:
     2456           find first buf_fbr-gds-obj exclusive-lock
     2457                where buf_fbr-gds-obj.obj-type = p-obj-type
     2458                  and buf_fbr-gds-obj.obj-code = p-obj-code
     2459                  and buf_fbr-gds-obj.gds-code = p-gds-code
     2460           no-error.
     2461           if not available buf_fbr-gds-obj
     2462           then do:
     2463               run ref/fgdsobj1.p (
     2464                     input-output v-fbr-gds-obj-recid
     2465                   , input 'ДОБАВЛЕНИЕ':U
     2466                   , input no
     2467                   , input p-gds-code
     2468                   , input p-obj-type
     2469                   , input p-obj-code
     2470                   , input 0
     2471                   , input ""
     2472                   , input 0
     2473                   , input no
     2474                   , input no
     2475                   , input no
     2476                   , input no
     2477                   , input no
     2478                   , input no
     2479               ) no-error.
     2480               if error-status:error
     2481               then do:
     2482                   message
     2483                           vss-workfile vss-revision vss-description
     2484                       skip "Ошибка изменения атрибутов товара на объекте"
     2485                       skip return-value
     2486                       skip trim(error-status :get-message(1))
     2487                               trim(error-status :get-message(2))
     2488                               trim(error-status :get-message(3))
     2489                   view-as alert-box error.
     2490                   undo, return error .
     2491               end.
     2492               find first buf_fbr-gds-obj exclusive-lock
     2493                    where recid( buf_fbr-gds-obj ) = v-fbr-gds-obj-recid
     2494               .
     2495           end.
     2496           assign
     2497               v-recipe-found = no
     2498           .
     2499           for first buf_recipe no-lock
     2500               where buf_recipe.obj-type    = p-obj-type
     2501                 and buf_recipe.obj-code    = p-obj-code
     2502                 and buf_recipe.artic       = buf_goods.artic
     2503                 and buf_recipe.prod-type   = buf_goods.prod-type
     2504                 and buf_recipe.prod-code   = buf_goods.prod-code
     2505                 and buf_recipe.recipe-type = 'производство':U
     2506                 or (
     2507                     buf_recipe.obj-type    = ""
     2508                 and buf_recipe.obj-code    = 0
     2509                 and buf_recipe.artic       = buf_goods.artic
     2510                 and buf_recipe.prod-type   = buf_goods.prod-type
     2511                 and buf_recipe.prod-code   = buf_goods.prod-code
     2512                 and buf_recipe.recipe-type = 'производство':U
     2513                     )
     2514           :
     2515               assign
     2516                   v-recipe-found = yes
     2517                   buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2518               .
     2519           end.
     2520           if v-recipe-found = no
     2521           then do:
     2522               for first buf_recipe no-lock
     2523                   where buf_recipe.obj-type    = p-obj-type
     2524                     and buf_recipe.obj-code    = p-obj-code
     2525                     and buf_recipe.artic       = buf_goods.artic
     2526                     and buf_recipe.prod-type   = buf_goods.prod-type
     2527                     and buf_recipe.prod-code   = buf_goods.prod-code
     2528                     and buf_recipe.recipe-type <> 'альтернатива':U
     2529                     or (
     2530                         buf_recipe.obj-type    = ""
     2531                     and buf_recipe.obj-code    = 0
     2532                     and buf_recipe.artic       = buf_goods.artic
     2533                     and buf_recipe.prod-type   = buf_goods.prod-type
     2534                     and buf_recipe.prod-code   = buf_goods.prod-code
     2535                     and buf_recipe.recipe-type <> 'альтернатива':U
     2536                         )
     2537               :
     2538                   assign
     2539                       v-recipe-found = yes
     2540                       buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2541                   .
     2542               end.
     2543               if v-recipe-found = no
     2544               then do:
     2545                   for first buf_recipe no-lock
     2546                       where buf_recipe.obj-type    = p-obj-type
     2547                         and buf_recipe.obj-code    = p-obj-code
     2548                         and buf_recipe.artic       = buf_goods.artic
     2549                         and buf_recipe.prod-type   = buf_goods.prod-type
     2550                         and buf_recipe.prod-code   = buf_goods.prod-code
     2551                         or (
     2552                             buf_recipe.obj-type    = ""
     2553                         and buf_recipe.obj-code    = 0
     2554                         and buf_recipe.artic       = buf_goods.artic
     2555                         and buf_recipe.prod-type   = buf_goods.prod-type
     2556                         and buf_recipe.prod-code   = buf_goods.prod-code
     2557                             )
     2558                   :
     2559                       assign
     2560                           v-recipe-found = yes
     2561                           buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2562                       .
     2563                   end.
     2564                   if v-recipe-found = no
     2565                   then do:
     2566                       assign
     2567                           buf_fbr-gds-obj.default-recipe-code = ""
     2568                       .
     2569                   end.
     2570               end.
     2571           end.
     2572       end.
     2573   end.
     2574   end procedure.
     2575   procedure fbrlib-get-obj-recipe :
     2576   define input parameter p-obj-type       as character    no-undo.
     2577   define input parameter p-obj-code       as integer      no-undo.
     2578   define input parameter p-gds-code       as integer      no-undo.
     2579   define output parameter p-recipe-code   as character    no-undo.
     2580       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     2581   do
     2582   for buf_fbr-gds-obj
     2583   on error undo, return error
     2584   :
     2585       find first buf_fbr-gds-obj no-lock
     2586            where buf_fbr-gds-obj.obj-type = p-obj-type
     2587              and buf_fbr-gds-obj.obj-code = p-obj-code
     2588              and buf_fbr-gds-obj.gds-code = p-gds-code
     2589       no-error.
     2590       if available buf_fbr-gds-obj
     2591       then do:
     2592           assign
     2593               p-recipe-code = buf_fbr-gds-obj.default-recipe-code
     2594           .
     2595       end.
     2596       else do:
     2597           assign
     2598               p-recipe-code = ""
     2599           .
     2600       end.
     2601   end.
     2602   end procedure.
     2603   procedure fbrlib-create-or-update-recipe-gds :
     2604   define input parameter p-recipe-code    as character        no-undo.
     2605   define input parameter p-gds-code       as integer          no-undo.
     2606   define input parameter p-is-waste       as logical          no-undo.
     2607   define input parameter p-qnty           as decimal          no-undo.
     2608   define input parameter p-proc-number    as integer          no-undo.
     2609   define input parameter p-nws-self       as logical          no-undo.
     2610       define variable v-max-proc-num  as integer      no-undo.
     2611       define variable v-recipe-type   as character    no-undo.
     2612       define buffer buf_goods             for ub.goods.
     2613       define buffer buf_recipe-gds        for ub.recipe-gds.
     2614       define buffer buf_recipe            for ub.recipe.
     2615       define buffer buf_proc_recipe-gds   for ub.recipe-gds.
     2616   do
     2617   for buf_goods
     2618     , buf_recipe-gds
     2619     , buf_recipe
     2620     , buf_proc_recipe-gds
     2621   on error undo, return error
     2622   :
     2623       find first buf_recipe no-lock
     2624            where buf_recipe.recipe-code = p-recipe-code
     2625       .
     2626       find first buf_goods no-lock
     2627            where buf_goods.gds-code = p-gds-code
     2628       .
     2629       find first buf_recipe-gds
     2630            where buf_recipe-gds.recipe-code = p-recipe-code
     2631              and buf_recipe-gds.prod-type   = buf_goods.prod-type
     2632              and buf_recipe-gds.prod-code   = buf_goods.prod-code
     2633              and buf_recipe-gds.artic       = buf_goods.artic
     2634       no-error.
     2635       if not available buf_recipe-gds
     2636       then do:
     2637           create buf_recipe-gds.
     2638           assign
     2639               buf_recipe-gds.recipe-code = p-recipe-code
     2640               buf_recipe-gds.gds-code    = p-gds-code
     2641               buf_recipe-gds.prod-type   = buf_goods.prod-type
     2642               buf_recipe-gds.prod-code   = buf_goods.prod-code
     2643               buf_recipe-gds.artic       = buf_goods.artic
     2644           .
     2645           assign
     2646               buf_recipe-gds.is-waste    = no
     2647               buf_recipe-gds.qnty        = 0
     2648               buf_recipe-gds.coeff-waste = 0
     2649               buf_recipe-gds.brutto-qnty = 0
     2650               buf_recipe-gds.proc-number = 0
     2651               buf_recipe-gds.nws-self    = no
     2652           .
     2653       end.
     2654       assign
     2655           buf_recipe-gds.is-waste    = p-is-waste
     2656       .
     2657       run fbrlib-get-recipe-type in this-procedure (
     2658             input "":U
     2659           , input buf_recipe-gds.recipe-code
     2660           , output v-recipe-type
     2661       ).
     2662       if v-recipe-type <> 'производство':U
     2663       then do:
     2664           assign
     2665               buf_recipe-gds.calc-method = 1
     2666               buf_recipe-gds.qnty        = p-qnty
     2667               buf_recipe-gds.brutto-qnty = p-qnty
     2668               buf_recipe-gds.coeff-waste = 0
     2669           .
     2670       end.
     2671       else do:
     2672           assign
     2673               buf_recipe-gds.calc-method = 1
     2674               buf_recipe-gds.brutto-qnty = p-qnty
     2675           .
     2676           run fbrlib-calc-brutto in this-procedure (
     2677                 input v-recipe-type
     2678               , input 0
     2679               , input 0
     2680               , input buf_recipe-gds.coeff-waste
     2681               , input buf_recipe-gds.brutto-qnty
     2682               , input 1
     2683               , output buf_recipe-gds.qnty
     2684               , output buf_recipe-gds.coeff-waste
     2685               , output buf_recipe-gds.brutto-qnty
     2686               , output buf_recipe-gds.calc-method
     2687           ).
     2688       end.
     2689       assign
     2690           buf_recipe-gds.nws-self    = p-nws-self
     2691       .
     2692       if buf_recipe.recipe-type = 'альтернатива':U
     2693       and buf_recipe-gds.proc-number <> 0
     2694       then do:
     2695       end.
     2696       else do:
     2697           if p-proc-number <> 0
     2698           then do:
     2699               assign
     2700                   buf_recipe-gds.proc-number = p-proc-number
     2701               .
     2702           end.
     2703           else do:
     2704               assign
     2705                   v-max-proc-num = 0
     2706               .
     2707               for each buf_proc_recipe-gds no-lock
     2708                  where buf_proc_recipe-gds.recipe-code = p-recipe-code
     2709               :
     2710                   if recid( buf_proc_recipe-gds ) <> recid( buf_recipe-gds )
     2711                   then do:
     2712                       assign
     2713                           v-max-proc-num = ( if v-max-proc-num < buf_proc_recipe-gds.proc-number then buf_proc_recipe-gds.proc-number else v-max-proc-num )
     2714                       .
     2715                   end.
     2716               end.
     2717               assign
     2718                   buf_recipe-gds.proc-number = v-max-proc-num + 1
     2719               .
     2720           end.
     2721       end.
     2722   end.
     2723   end procedure.
     2724   PROCEDURE fbrlib-create-or-update-recipe :
     2725   define input parameter p-mode               as character    no-undo.
     2726   define input parameter p-obj-type           as character    no-undo.
     2727   define input parameter p-obj-code           as integer      no-undo.
     2728   define input parameter p-recipe-code        as character    no-undo.
     2729   define input parameter p-recipe-type        as character    no-undo.
     2730   define input parameter p-gds-code           as integer      no-undo.
     2731   define input parameter p-name               as character    no-undo.
     2732   define input parameter p-design             as character    no-undo.
     2733   define input parameter p-order              as integer      no-undo.
     2734   define input parameter p-quality            as character    no-undo.
     2735   define input parameter p-ref-num            as character    no-undo.
     2736   define input parameter p-technique          as character    no-undo.
     2737   define input parameter p-template           as character    no-undo.
     2738   define input parameter p-qnty               as decimal      no-undo.
     2739   define input parameter p-portion-qnty       as integer      no-undo.
     2740   define input parameter p-portion-weight     as decimal      no-undo.
     2741   define output parameter p-new-recipe-code   as character    no-undo.
     2742       define variable v-host-code         as integer      no-undo.
     2743       define variable v-fbr-gds-obj-recid as recid        no-undo.
     2744       define buffer buf_recipe    for ub.recipe.
     2745       define buffer buf_goods     for ub.goods.
     2746   do
     2747   for buf_recipe
     2748     , buf_goods
     2749   on error undo, return error
     2750   :
     2751       if p-mode <> 'ДОБАВЛЕНИЕ':U
     2752       and p-mode <> 'ИЗМЕНЕНИЕ':U
     2753       then do:
     2754           message
     2755               skip "Ошибка задания типа операции для создания или измения рецепта."
     2756               skip (1)
     2757               skip "Задан тип операции:" p-mode
     2758           view-as alert-box error.
     2759           undo, return error .
     2760       end.
     2761       if p-recipe-code = ""
     2762       then do:
     2763   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2764   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2765     (input  p-obj-type
     2766     ,input  p-obj-code
     2767     ,output v-host-code
     2768     )  .
     2769           find first buf_goods no-lock
     2770                where buf_goods.gds-code = p-gds-code
     2771           .
     2772           create buf_recipe .
     2773           run fbrcode-gen-recipe-code in this-procedure (
     2774                 input p-obj-type
     2775               , input p-obj-code
     2776               , output buf_recipe.recipe-code
     2777           ).
     2778           assign
     2779               buf_recipe.artic               = buf_goods.artic
     2780               buf_recipe.prod-type           = buf_goods.prod-type
     2781               buf_recipe.prod-code           = buf_goods.prod-code
     2782               buf_recipe.recipe-type         = p-recipe-type
     2783               buf_recipe.recipe-name         = ( if p-name = "" then buf_goods.gds-name else p-name )
     2784               buf_recipe.gds-code            = p-gds-code
     2785               buf_recipe.host-code           = v-host-code
     2786               buf_recipe.obj-type            = p-obj-type
     2787               buf_recipe.obj-code            = p-obj-code
     2788               buf_recipe.recipe-design       = ""
     2789               buf_recipe.recipe-order        = 0
     2790               buf_recipe.recipe-quality      = ""
     2791               buf_recipe.recipe-ref-num      = ""
     2792               buf_recipe.recipe-technique    = ""
     2793               buf_recipe.recipe-template     = ""
     2794               buf_recipe.qnty                = 1.0
     2795               buf_recipe.portion-qnty        = 1
     2796               buf_recipe.portion-weight      = 0
     2797           .
     2798       end.
     2799       if p-name <> ""
     2800       then do:
     2801           assign
     2802               buf_recipe.recipe-name = p-name
     2803           .
     2804       end.
     2805       assign
     2806           buf_recipe.recipe-design       = p-design
     2807           buf_recipe.recipe-order        = p-order
     2808           buf_recipe.recipe-quality      = p-quality
     2809           buf_recipe.recipe-ref-num      = p-ref-num
     2810           buf_recipe.recipe-technique    = p-technique
     2811           buf_recipe.recipe-template     = p-template
     2812           buf_recipe.qnty                = p-qnty
     2813           buf_recipe.portion-qnty        = p-portion-qnty
     2814           buf_recipe.portion-weight      = p-portion-weight
     2815       .
     2816       assign
     2817           p-new-recipe-code = buf_recipe.recipe-code
     2818       .
     2819       run fbrlib-set-default-recipe in this-procedure (
     2820             input p-obj-type
     2821           , input p-obj-code
     2822           , input buf_goods.gds-code
     2823       ).
     2824   end.
     2825   END PROCEDURE.
     2826   PROCEDURE fbrlib-delete-fact-fbr-doc :
     2827   define input parameter parparentproc-handle as widget-handle no-undo .
     2828   define input parameter p-doc-code   as character no-undo.
     2829   define input parameter p-chip-num   like ub.c-trn-doc.chip-num no-undo .
     2830       define variable v-shift-on      as logical      no-undo.
     2831       define variable v-shift-date    as date         no-undo.
     2832       define variable v-shift-num     as integer      no-undo.
     2833       define variable v-shift-name    as character    no-undo.
     2834       define variable v-obj-date      as date         no-undo.
     2835       define variable v-chip-num      as integer      no-undo.
     2836       define buffer buf_fbr-doc       for ub.fbr-doc.
     2837       define buffer buf_fbr-line      for ub.fbr-line.
     2838       define buffer buf_c-fbr-doc     for ub.c-fbr-doc.
     2839       define buffer buf_fbr-recipe     for ub.fbr-recipe.
     2840       define buffer buf_fbr-recipe-gds for ub.fbr-recipe-gds.
     2841       define buffer buf_marking-lines for ub.marking-lines .
     2842       define buffer buf_marking       for ub.marking .
     2843       define buffer buf_goods         for ub.goods .
     2844   do
     2845   for buf_fbr-doc
     2846     , buf_fbr-line
     2847     , buf_c-fbr-doc
     2848     , buf_fbr-recipe
     2849     , buf_fbr-recipe-gds
     2850     , buf_goods
     2851     , buf_marking
     2852     , buf_marking-lines
     2853   on error undo, return error
     2854   :
     2855   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2856     define variable v-cntxt-db-num        as integer   no-undo .
     2857     define variable v-cntxt-userid        as character no-undo .
     2858     define variable v-cntxt-level         as character no-undo .
     2859     define variable v-cntxt-host-code-obj as integer   no-undo .
     2860     define variable v-cntxt-obj-type      as character no-undo .
     2861     define variable v-cntxt-obj-code      as integer   no-undo .
     2862     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2863     define variable v-cntxt-is-admin      as logical   no-undo .
     2864   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2865     run mainmenu_getcntxt in parparentproc-handle
     2866       (output v-cntxt-db-num
     2867       ,output v-cntxt-userid
     2868       ,output v-cntxt-level
     2869       ,output v-cntxt-host-code-obj
     2870       ,output v-cntxt-obj-type
     2871       ,output v-cntxt-obj-code
     2872       ,output v-cntxt-db-num-obj
     2873       ,output v-cntxt-is-admin
     2874       ) .
     2875       if search ("delfbr.err") <> ?
     2876       then do:
     2877           os-delete "delfbr.err".
     2878       end.
     2879     _del-block:
     2880       do transaction
     2881     on error undo _del-block, return error return-value
     2882     on endkey undo _del-block , return error return-value
     2883     on stop undo _del-block , return error return-value
     2884       :
     2885           find first buf_fbr-doc exclusive-lock
     2886                where buf_fbr-doc.doc-code = p-doc-code
     2887           no-error.
     2888           if not available buf_fbr-doc
     2889           then do:
     2890         undo _del-block, return error substitute("&1 &2 &3&4Не найден документ производства &5 для удаления."
     2891                                           ,vss-workfile
     2892                                           ,vss-revision
     2893                                           ,vss-description
     2894                                           ,chr(10)
     2895                                           , p-doc-code).
     2896           end.
     2897           run fbrlib-delete-fact-trn-doc in this-procedure (
     2898               input parparentproc-handle
     2899              ,input p-doc-code
     2900              ,input 'при':U
     2901              ,input p-chip-num
     2902              ,output v-chip-num
     2903           ) no-error.
     2904           if error-status :error
     2905           then do:
     2906               run fbrlib-print-del-error-message in this-procedure .
     2907         undo _del-block, return error.
     2908           end.
     2909           assign
     2910           p-chip-num = (if p-chip-num = ?
     2911                         then v-chip-num
     2912                         else p-chip-num).
     2913           run fbrlib-delete-fact-trn-doc in this-procedure (
     2914               input parparentproc-handle
     2915              ,input p-doc-code
     2916              ,input 'рас':U
     2917              ,input p-chip-num
     2918              ,output v-chip-num
     2919           ) no-error.
     2920           if error-status :error
     2921           then do:
     2922               run fbrlib-print-del-error-message in this-procedure .
     2923         undo _del-block, return error.
     2924           end.
     2925           run fbrlib-delete-fact-trn-doc in this-procedure (
     2926               input parparentproc-handle
     2927              ,input p-doc-code
     2928              ,input 'спи':U
     2929              ,input p-chip-num
     2930              ,output v-chip-num
     2931           ) no-error.
     2932           if error-status :error
     2933           then do:
     2934               run fbrlib-print-del-error-message in this-procedure .
     2935         undo _del-block, return error.
     2936           end.
     2937           create buf_c-fbr-doc.
     2938           buffer-copy buf_fbr-doc to buf_c-fbr-doc.
     2939   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2940   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     2941     (input  buf_fbr-doc.obj-type
     2942     ,input  buf_fbr-doc.obj-code
     2943     ,output v-obj-date
     2944     ) no-error .
     2945           if error-status :error
     2946           or v-obj-date = ?
     2947           then do:
     2948         undo _del-block, return error "Нет текущей даты на объекте документа.".
     2949           end.
     2950   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2951   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2952     (input  buf_fbr-doc.obj-type
     2953     ,input  buf_fbr-doc.obj-code
     2954     ,input  'shift-on=request'
     2955     ,output v-shift-on
     2956     )  .
     2957           if v-shift-on
     2958           then do:
     2959   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2960   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     2961     (input  buf_fbr-doc.obj-type
     2962     ,input  buf_fbr-doc.obj-code
     2963     ,output v-shift-date
     2964     ,output v-shift-num
     2965     ,output v-shift-name
     2966     ) no-error .
     2967               if error-status :error
     2968               then do:
     2969           undo _del-block, return error "Ошибка при поиске текущей смены на объекте".
     2970               end.
     2971           end.
     2972           else do:
     2973               assign
     2974                   v-shift-date = ?
     2975                   v-shift-num  = ?
     2976                   v-shift-name = ?
     2977               .
     2978           end.
     2979           define variable v-today       as date         no-undo.
     2980           define variable v-time        as integer      no-undo.
     2981           run cur-time in this-procedure (
     2982                 output v-today
     2983               , output v-time
     2984           ).
     2985           assign
     2986               buf_c-fbr-doc.chip-num         = (if p-chip-num <> ? then p-chip-num else next-value( s-corr-chip, ub  ))
     2987               buf_c-fbr-doc.corr-user-name   = v-cntxt-userid
     2988               buf_c-fbr-doc.corr-user-db-num = v-cntxt-db-num
     2989               buf_c-fbr-doc.corr-date        = v-today
     2990               buf_c-fbr-doc.corr-time        = v-time
     2991               buf_c-fbr-doc.corr-shift-date  = v-shift-date
     2992               buf_c-fbr-doc.corr-shift-num   = v-shift-num
     2993               buf_c-fbr-doc.corr-shift-name  = v-shift-name
     2994               buf_c-fbr-doc.is-del           = yes
     2995           .
     2996           assign
     2997               buf_fbr-doc.is-del = yes
     2998           .
     2999           for each buf_fbr-line exclusive-lock
     3000              where buf_fbr-line.doc-code = p-doc-code
     3001       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3002       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3003       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3004           :
     3005               for first buf_goods no-lock where buf_goods.artic      = buf_fbr-line.artic
     3006                                             and buf_goods.prod-type  = buf_fbr-line.prod-type
     3007                                             and buf_goods.prod-code  = buf_fbr-line.prod-code,
     3008               each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = buf_goods.gds-code
     3009                                                       and buf_marking-lines.obj-type = buf_fbr-doc.obj-type
     3010                                                       and buf_marking-lines.obj-code = buf_fbr-doc.obj-code
     3011                                                       and buf_marking-lines.in-code  = "manufacturing"
     3012                                                       and buf_marking-lines.out-code = buf_fbr-line.doc-code
     3013                                                       and buf_marking-lines.part-code = buf_fbr-line.recipe-code
     3014                                                       and buf_marking-lines.prt-code = 0
     3015               :
     3016                 for first buf_marking exclusive-lock where buf_marking.mark begins buf_marking-lines.mark :
     3017                   assign
     3018                     buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB when buf_fbr-line.is-comp
     3019                   .
     3020                 end .
     3021                 delete buf_marking-lines.
     3022               end .
     3023               delete buf_fbr-line.
     3024           end.
     3025           for each buf_fbr-recipe exclusive-lock
     3026              where buf_fbr-recipe.doc-code = p-doc-code
     3027       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3028       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3029       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3030           :
     3031               delete buf_fbr-recipe.
     3032           end.
     3033           for each buf_fbr-recipe-gds exclusive-lock
     3034              where buf_fbr-recipe-gds.doc-code = p-doc-code
     3035       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3036       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3037       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3038           :
     3039               delete buf_fbr-recipe-gds.
     3040           end.
     3041           delete buf_fbr-doc.
     3042       end.
     3043   end.
     3044   END PROCEDURE.
     3045   PROCEDURE fbrlib-del-trn-doc :
     3046   do
     3047   on error undo, return error
     3048   :
     3049   define input parameter parparentproc        as widget-handle no-undo .
     3050   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     3051   define input parameter p-trn-doc-type       as character    no-undo.
     3052   define input parameter p-phchip-num         like ub.c-trn-doc.chip-num no-undo .
     3053   define output parameter p-chip-num           like ub.c-trn-doc.chip-num no-undo .
     3054       define variable v-trn-doc-doc-code  as character     no-undo.
     3055       define buffer buf_trn-doc       for ub.trn-doc.
     3056   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3057     define variable v-cntxt-db-num        as integer   no-undo .
     3058     define variable v-cntxt-userid        as character no-undo .
     3059     define variable v-cntxt-level         as character no-undo .
     3060     define variable v-cntxt-host-code-obj as integer   no-undo .
     3061     define variable v-cntxt-obj-type      as character no-undo .
     3062     define variable v-cntxt-obj-code      as integer   no-undo .
     3063     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3064     define variable v-cntxt-is-admin      as logical   no-undo .
     3065   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3066     run mainmenu_getcntxt in parparentproc
     3067       (output v-cntxt-db-num
     3068       ,output v-cntxt-userid
     3069       ,output v-cntxt-level
     3070       ,output v-cntxt-host-code-obj
     3071       ,output v-cntxt-obj-type
     3072       ,output v-cntxt-obj-code
     3073       ,output v-cntxt-db-num-obj
     3074       ,output v-cntxt-is-admin
     3075       ) .
     3076       run fbrcode-trn-doc in this-procedure (
     3077             input 'производство':U
     3078           , input p-fbr-doc-doc-code
     3079           , input p-trn-doc-type
     3080           , output v-trn-doc-doc-code
     3081       ).
     3082       find first buf_trn-doc no-lock
     3083            where buf_trn-doc.doc-code = v-trn-doc-doc-code
     3084       no-error.
     3085       if available buf_trn-doc
     3086       then do:
     3087           run str/del-doc.p (
     3088                 input parparentproc
     3089               , input buf_trn-doc.doc-code
     3090               , input v-cntxt-db-num
     3091               , input "del-doc.err"
     3092               , input ?
     3093               , input p-fbr-doc-doc-code
     3094               , input v-cntxt-userid
     3095               , input 0
     3096               , input p-phchip-num
     3097               , output p-chip-num
     3098           ) no-error.
     3099           if error-status :error
     3100           then do:
     3101             undo, return error substitute("Не удалось удалить складской документ &1, созданный по документу производства &2.&3&4&3&5"
     3102                                           ,v-trn-doc-doc-code
     3103                                           ,p-fbr-doc-doc-code
     3104                                           , chr(10)
     3105                                           , error-status:get-message(1)
     3106                                           , return-value ).
     3107           end.
     3108       end.
     3109   end.
     3110   END PROCEDURE.
     3111   PROCEDURE fbrlib-delete-fact-trn-doc :
