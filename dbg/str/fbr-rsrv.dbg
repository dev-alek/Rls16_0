      936   procedure cur-time :
      937      define output parameter p-today as date      no-undo .
      938      define output parameter p-time  as integer   no-undo .
      939     do
      940     on error undo, return error
      941     :
      942       define variable v-date1 as date      no-undo .
      943       define variable v-date2 as date      no-undo .
      944       define variable v-time  as integer   no-undo .
      945       assign
      946         v-date1 = today
      947         v-time  = time
      948         v-date2 = today
      949       .
      950       if v-date1 <> v-date2
      951       then do:
      952         assign
      953           v-date1 = today
      954           v-time  = v-time
      955         .
      956       end.
      957       assign
      958         p-today = v-date1
      959         p-time  = v-time
      960       .
      961     end.
      962   end.
      963   function cur-time-date returns character
      964   :
      965     return string(today, '99/99/9999':U) .
      966   end.
      967   function cur-time-mjd returns decimal
      968   :
      969     define variable v-date as date      no-undo .
      970     define variable v-time as integer   no-undo .
      971     run cur-time in this-procedure
      972       (output v-date
      973       ,output v-time
      974       ) .
      975     return integer(v-date) - 2400002 + (v-time / 86400) .
      976   end.
      977   function cur-time-get-ending-index returns integer
      978   (input p-number as integer
      979   )
      980   :
      981     if p-number < 0
      982     or p-number = ?
      983     then do:
      984       return 1 .
      985     end.
      986     define variable v-rest as integer   no-undo .
      987     assign
      988       p-number = p-number modulo 100
      989     .
      990     if p-number < 20
      991     then do:
      992       assign
      993         v-rest = p-number
      994       .
      995     end.
      996     else do:
      997       assign
      998         v-rest = p-number modulo 10
      999       .
     1000     end.
     1001     case v-rest :
     1002       when 1
     1003       then do:
     1004         return 2 .
     1005       end.
     1006       when 2 or
     1007       when 3 or
     1008       when 4
     1009       then do:
     1010         return 3 .
     1011       end.
     1012       otherwise do:
     1013         return 1 .
     1014       end.
     1015     end case .
     1016   end.
     1017   procedure cur-time-mjd-to-date :
     1018      define input  parameter i-mjd-diff as decimal no-undo.
     1019      define output parameter o-Date     as date    no-undo.
     1020      define output parameter o-Time     as integer no-undo.
     1021      define variable v-day-number as integer   no-undo .
     1022      if    i-mjd-diff < 0
     1023         or i-mjd-diff = ?
     1024      then do:
     1025         return "?" .
     1026      end.
     1027      assign
     1028         v-day-number = truncate(i-mjd-diff,0).
     1029         o-Date = date(v-day-number + 2400002).
     1030         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1031     .
     1032   end.
     1033   function cur-time-mjd-to-string returns character
     1034   (input p-mjd-diff as decimal
     1035   )
     1036   :
     1037     define variable v-day-number as integer   no-undo .
     1038     define variable v-seconds    as integer   no-undo .
     1039     define variable v-hour       as integer   no-undo .
     1040     define variable v-min        as integer   no-undo .
     1041     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1042     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1043     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1044     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1045     if p-mjd-diff < 0
     1046     or p-mjd-diff = ?
     1047     then do:
     1048       return "?" .
     1049     end.
     1050     assign
     1051       v-day-number = integer(truncate(p-mjd-diff,0))
     1052       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1053     .
     1054     if v-seconds > 86400
     1055     then do:
     1056       assign
     1057         v-seconds = 86400 - 1
     1058       .
     1059     end.
     1060     if v-seconds < 0
     1061     then do:
     1062       assign
     1063         v-seconds = 0
     1064       .
     1065     end.
     1066     assign
     1067       v-hour = truncate(v-seconds / 3600, 0)
     1068     .
     1069     assign
     1070       v-seconds = v-seconds modulo 3600
     1071     .
     1072     assign
     1073       v-min = truncate(v-seconds / 60, 0)
     1074     .
     1075     assign
     1076       v-seconds = v-seconds modulo 60
     1077     .
     1078     return
     1079         (if v-day-number <> 0
     1080           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1081           else ""
     1082         )
     1083       + (if v-day-number <> 0 or v-hour <> 0
     1084           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1085           else ""
     1086         )
     1087       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1088           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1089           else ""
     1090         )
     1091       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1092       .
     1093   end.
     1094   function cur-time-string returns character
     1095   :
     1096     define variable v-date as date      no-undo .
     1097     define variable v-time as integer   no-undo .
     1098     run cur-time in this-procedure
     1099       (output v-date
     1100       ,output v-time
     1101       ) .
     1102     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1103   end.
     1104   function cur-time-string-sec returns character
     1105   :
     1106     define variable v-date as date      no-undo .
     1107     define variable v-time as integer   no-undo .
     1108     run cur-time in this-procedure
     1109       (output v-date
     1110       ,output v-time
     1111       ) .
     1112     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1113   end.
     1114   function cur-time-custom  returns character
     1115   (input p-prefix as character
     1116   ,input p-date-format as character
     1117   ,input p-delimiter as character
     1118   ,input p-time-format as character
     1119   ,input p-suffix as character
     1120   )
     1121   :
     1122     define variable v-date as date      no-undo .
     1123     define variable v-time as integer   no-undo .
     1124     run cur-time in this-procedure
     1125       (output v-date
     1126       ,output v-time
     1127       ) .
     1128     return
     1129       p-prefix
     1130       + string(v-date, p-date-format)
     1131       + p-delimiter
     1132       + string(v-time, p-time-format)
     1133       + p-suffix
     1134       .
     1135   end.
     1136   function cur-time-print  returns character
     1137   :
     1138     define variable v-date as date      no-undo .
     1139     define variable v-time as integer   no-undo .
     1140     run cur-time in this-procedure
     1141       (output v-date
     1142       ,output v-time
     1143       ) .
     1144     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1145   end.
     1146   function cur-time-datetime returns datetime
     1147   :
     1148     define variable v-char as character no-undo .
     1149     define variable v-datetime as datetime no-undo .
     1150     v-char = cur-time-string().
     1151     v-datetime = datetime(v-char).
     1152     return  v-datetime.
     1153   end.
     1154   function cur-time-string-msec returns character
     1155   :
     1156     define variable v-date as datetime  no-undo .
     1157     v-date = now.
     1158     return string(v-date) .
     1159   end.
     1160   procedure fbrlib_create-fbr-doc :
     1161   define input parameter p-obj-type as character no-undo .
