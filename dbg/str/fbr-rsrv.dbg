     5546               run str/fbr-rcp.p (
     5547                     input parparentproc
     5548                   , input p-fbrhist-handle
     5549                   , input p-fbr-doc-recid
     5550                   , input p-silent
     5551                   , input temp_recipe-order.recipe-code
     5552                   , input p-autofbr
     5553                   , input p-have-store
     5554               ) no-error.
     5555               if error-status:error
     5556               then do:
     5557                   if return-value = 'not-reserved' then do:
     5558                     v-not-reserved = true.
     5559                     next reserv-fbr-line.
     5560                   end.
     5561                   assign
     5562                       v-continue = no
     5563                   .
     5564                   run writelog in this-procedure (
     5565                         input log-file-name
     5566                       , input 0
     5567                       , input "=====*** fbr-rsrv.p ***========= ошибка fbr-rcp.p  ========"
     5568                   ).
     5569                   if p-autofbr = no
     5570                   then do:
     5571                       if error-status :get-message(1) <> ""
     5572                       or return-value <> "user-interrupt":U
     5573                       then do:
     5574                       if p-silent then do:
     5575                         undo, return error substitute("&1 &2 &3&4Ошибка резервирования по рецепту документа &5.&4Номер рецепта &6.&4&7&4&8"
     5576                                                         ,vss-workfile
     5577                                                         ,vss-revision
     5578                                                         ,vss-description
     5579                                                         ,chr(10)
     5580                                                         ,buf_fbr-doc.doc-code
     5581                                                         ,temp_recipe-order.recipe-code
     5582                                                         ,error-status:get-message(1)
     5583                                                         ,return-value ) .
     5584                        end.
     5585                        else do:
     5586                           message
     5587                                   vss-workfile vss-revision vss-description
     5588                               skip "Ошибка резервирования по рецепту."
     5589                               skip "Рецепт: " temp_recipe-order.recipe-code
     5590                               skip return-value
     5591                               skip trim(error-status :get-message(1))
     5592                                   trim(error-status :get-message(2))
     5593                                   trim(error-status :get-message(3))
     5594                               skip (2)
     5595                               skip "Продолжить расчет рецептов?"
     5596                           view-as alert-box question
     5597                           buttons yes-no
     5598                           title "Расчет рецептов по документу"
     5599                           update v-continue
     5600                           .
     5601                       end.
     5602                       end.
     5603                       else do:
     5604                         if p-silent then do:
     5605                           undo, return error substitute("&1 &2 &3&4Товар(ы) не был(и) зарезервирован(ы). Документ производства &5.&4Номер рецепта &6.&4&7&4&8"
     5606                                                           ,vss-workfile
     5607                                                           ,vss-revision
     5608                                                           ,vss-description
     5609                                                           ,chr(10)
     5610                                                           ,buf_fbr-doc.doc-code
     5611                                                           ,temp_recipe-order.recipe-code
     5612                                                           ,error-status:get-message(1)
     5613                                                           ,return-value ) .
     5614                         end.
     5615                       else do:
     5616                           message
     5617                               skip "Товар не был зарезервирован."
     5618                               skip "Рецепт: " temp_recipe-order.recipe-code
     5619                               skip (1)
     5620                               skip "Продолжить расчет рецептов?"
     5621                           view-as alert-box question
     5622                           buttons yes-no
     5623                           title "Расчет рецептов по документу"
     5624                           update v-continue
     5625                           .
     5626                       end.
     5627                       end.
     5628                       assign
     5629                           v-all-reserved = no
     5630                       .
     5631                       if v-continue = yes
     5632                       then do:
     5633                           run writelog in this-procedure (
     5634                               input log-file-name
     5635                               , input 0
     5636                               , input "Выбрано продолжение расчёта рецептов."
     5637                           ).
     5638                           next reserv-fbr-line.
     5639                       end.
     5640                       else do:
     5641                           leave reserv-fbr-line.
     5642                       end.
     5643                   end.
     5644                   else do:
     5645                       if error-status :get-message(1) <> ""
     5646                       or return-value <> "user-interrupt":U
     5647                       then do:
     5648                       if p-silent then do:
     5649                         undo, return error substitute("&1 &2 &3&4Ошибка резервирования по рецепту документа &5.&4Номер рецепта &6.&4&7&4&8"
     5650                                                     ,vss-workfile
     5651                                                     ,vss-revision
     5652                                                     ,vss-description
     5653                                                     ,chr(10)
     5654                                                     ,buf_fbr-doc.doc-code
     5655                                                     ,temp_recipe-order.recipe-code
     5656                                                     ,error-status:get-message(1)
     5657                                                     ,return-value ) .
     5658                       end.
     5659                       else do:
     5660                           message
     5661                                   vss-workfile vss-revision vss-description
     5662                               skip "Ошибка резервирования по рецепту."
     5663                               skip "Рецепт: " temp_recipe-order.recipe-code
     5664                               skip return-value
     5665                               skip trim(error-status :get-message(1))
     5666                                   trim(error-status :get-message(2))
     5667                                   trim(error-status :get-message(3))
     5668                           view-as alert-box error
     5669                           title "Расчет рецептов по документу"
     5670                           .
     5671                       end.
     5672                     end.
     5673                     if return-value <> 'not-reserved' then
     5674                       undo, return error return-value .
     5675                   end.
     5676               end.
     5677               else do:
     5678                   run writelog in this-procedure (
     5679                         input log-file-name
     5680                       , input 0
     5681                       , input "=====*** fbr-rsrv.p ***=========fbr-rcp.p отработала без ошибок ========"
     5682                   ).
     5683                   assign
     5684                       p-reserved = yes
     5685                   .
     5686               end.
     5687           end.
     5688           if v-not-reserved then return error 'not-reserved'.
     5689           if p-reserved = no
     5690           then do:
     5691             if p-silent then do:
     5692             end.
     5693             else do:
     5694               message
     5695                   "Ни по одному рецепту документа резервирование не было успешным. "
     5696                   + chr(10) + "Документ не может быть переведен в статус РАЗРЕШЕН."
     5697               view-as alert-box.
     5698           end.
     5699           end.
     5700       end.
     5701       else do:
     5702           assign
     5703               v-all-reserved = yes
     5704           .
     5705           transaction-rsrv-free:
     5706           do transaction
     5707           on error undo, return error
     5708           :
     5709               run delete-zero-lines in this-procedure (
     5710                     input buf_fbr-doc.doc-code
     5711                   , output v-continue
     5712               ) no-error.
     5713               if error-status :error
     5714               then do:
     5715                 undo, return error substitute("&1 &2 &3&4Ошибка поиска и удаления нулевых строк в свободном документе производства &5.&4&6&4&7"
     5716                                               ,vss-workfile
     5717                                               ,vss-revision
     5718                                               ,vss-description
     5719                                               ,chr(10)
     5720                                               ,buf_fbr-doc.doc-code
     5721                                               ,error-status:get-message(1)
     5722                                               ,return-value ) .
     5723               end.
     5724               if v-continue = no
     5725               then do:
     5726                   assign
     5727                       p-reserved      = no
     5728                       v-all-reserved  = no
     5729                   .
     5730                   undo transaction-rsrv-free, leave transaction-rsrv-free.
     5731               end.
     5732               rsrv-free:
     5733               for each buf_out_fbr-line exclusive-lock
     5734               where buf_out_fbr-line.doc-code = buf_fbr-doc.doc-code
     5735                   and buf_out_fbr-line.trn-type = 'спи':U
     5736               on error undo, return error
     5737               :
     5738                   find first buf_goods no-lock
     5739                        where buf_goods.artic     = buf_out_fbr-line.artic
     5740                          and buf_goods.prod-type = buf_out_fbr-line.prod-type
     5741                          and buf_goods.prod-code = buf_out_fbr-line.prod-code
     5742                   .
     5743                   run str/fbr-gds.p (
     5744                         input parparentproc
     5745                       , input p-fbrhist-handle
     5746                       , input p-fbr-doc-recid
     5747                       , input p-silent
     5748                       , input recid( buf_goods )
     5749                       , input p-autofbr
     5750                       , input p-have-store
     5751                   ) no-error.
     5752                   if error-status :error
     5753                   then do:
     5754                       assign
     5755                           v-all-reserved = no
     5756                       .
     5757                     if p-silent then do:
     5758                       undo, return error substitute("Не удалось зарезервировать товар &1 по док-ту пр-ва &2&3&4&3&5"
     5759                                                     , buf_goods.gds-code
     5760                                                     , buf_fbr-doc.doc-code
     5761                                                     , chr(10)
     5762                                                     , error-status:get-message(1)
     5763                                                     , return-value ).
     5764                     end.
     5765                     else do:
     5766                       next rsrv-free.
     5767                   end.
     5768                   end.
     5769                   else do:
     5770                       if buf_out_fbr-line.rsrv-qnty = buf_out_fbr-line.fact-qnty
     5771                       then do:
     5772                           assign
     5773                               p-reserved = yes
     5774                               v-write-off-sum-price-rubl     = v-write-off-sum-price-rubl     + buf_out_fbr-line.price-rubl * buf_out_fbr-line.fact-qnty
     5775                               v-write-off-sum-price-base     = v-write-off-sum-price-base     + buf_out_fbr-line.price-base * buf_out_fbr-line.fact-qnty
     5776                               v-write-off-sum-vat-price-rubl = v-write-off-sum-vat-price-rubl + buf_out_fbr-line.price-sum-vat-rubl
     5777                               v-write-off-sum-vat-price-base = v-write-off-sum-vat-price-base + buf_out_fbr-line.price-sum-vat-base
     5778                           .
     5779                       end.
     5780                       else do:
     5781                           assign
     5782                               v-all-reserved = no
     5783                           .
     5784                       end.
     5785                   end.
     5786               end.
     5787           end.
     5788           if p-reserved = no
     5789           then do:
     5790             if p-silent then do:
     5791             end.
     5792             else do:
     5793               message
     5794                   "Ни по одному товару документа резервирование не было успешным. "
     5795                   + chr(10) + "Документ не может быть переведен в статус РАЗРЕШЕН."
     5796               view-as alert-box.
     5797           end.
     5798           end.
     5799           else do:
     5800               if v-all-reserved = no
     5801               then do:
     5802                 if p-silent then do:
     5803                   p-reserved = no.
     5804                 end.
     5805                 else do:
     5806                   message
     5807                       "Не по всем товарам расхода резервирование было успешным. "
     5808                       skip "Учетные цены приходуемых товаров должны быть заданы вручную."
     5809                   view-as alert-box.
     5810               end.
     5811               end.
     5812               else do:
     5813                   run calc-free-doc-income-costs in this-procedure (
     5814                         input buf_fbr-doc.doc-code
     5815                       , input v-write-off-sum-price-rubl
     5816                       , input v-write-off-sum-price-base
     5817                       , input v-write-off-sum-vat-price-rubl
     5818                       , input v-write-off-sum-vat-price-base
     5819                   ).
     5820               end.
     5821           end.
     5822       end.
     5823       if v-all-reserved = yes
     5824       then do:
     5825           run fbrlib-fill-sum-fbr-doc in this-procedure (
     5826               input p-fbr-doc-recid
     5827               , input 'reserv':U
     5828           ) no-error .
     5829         if error-status:error then do:
     5830           undo, return error  substitute("Ошибка при расчете шапки документа пр-ва &4&1&2&1&3"
     5831                    , chr(10)
     5832                    , error-status:get-message(1)
     5833                    , return-value
     5834                    , buf_fbr-doc.doc-code
     5835           ).
     5836       end.
     5837   end.
     5838   end.
     5839   procedure calc-free-doc-income-costs :
     5840   do
     5841   on error undo, return error
     5842   :
     5843   define input parameter p-doc-code                       as character    no-undo.
     5844   define input parameter p-write-off-sum-price-rubl       as decimal      no-undo.
     5845   define input parameter p-write-off-sum-price-base       as decimal      no-undo.
     5846   define input parameter p-write-off-sum-vat-price-rubl   as decimal      no-undo.
     5847   define input parameter p-write-off-sum-vat-price-base   as decimal      no-undo.
     5848       define variable v-fbr-line-cost-coeff   as decimal       no-undo.
     5849       define variable v-income-sum-price-sale as decimal       no-undo.
     5850       define buffer buf_fbr-line      for fbr-line.
     5851       for each buf_fbr-line no-lock
     5852          where buf_fbr-line.doc-code = p-doc-code
     5853            and buf_fbr-line.trn-type = 'при':U
     5854       on error undo, return error
     5855       :
     5856           assign
     5857               v-income-sum-price-sale = v-income-sum-price-sale   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     5858           .
     5859       end.
     5860       for each buf_fbr-line exclusive-lock
     5861          where buf_fbr-line.doc-code = p-doc-code
     5862            and buf_fbr-line.trn-type = 'при':U
     5863       on error undo, return error
     5864       :
     5865           assign
     5866               buf_fbr-line.rsrv-qnty          = buf_fbr-line.fact-qnty
     5867               v-fbr-line-cost-coeff           = buf_fbr-line.price-sale * buf_fbr-line.fact-qnty / v-income-sum-price-sale
     5868               buf_fbr-line.price-sum-rubl     = p-write-off-sum-price-rubl     * v-fbr-line-cost-coeff
     5869               buf_fbr-line.price-sum-base     = p-write-off-sum-price-base     * v-fbr-line-cost-coeff
     5870               buf_fbr-line.price-sum-vat-rubl = p-write-off-sum-vat-price-rubl * v-fbr-line-cost-coeff
     5871               buf_fbr-line.price-sum-vat-base = p-write-off-sum-vat-price-base * v-fbr-line-cost-coeff
     5872               buf_fbr-line.price-rubl         = buf_fbr-line.price-sum-rubl / buf_fbr-line.fact-qnty
     5873               buf_fbr-line.price-base         = buf_fbr-line.price-sum-base / buf_fbr-line.fact-qnty
     5874           .
     5875       end.
     5876   end.
     5877   end procedure.
     5878   procedure delete-zero-lines :
     5879   define input parameter p-doc-code   as character    no-undo.
     5880   define output parameter p-continue  as logical      no-undo.
     5881       define variable v-yesno         as logical      no-undo.
     5882       define variable v-need-del-zero as logical      no-undo.
     5883       define buffer buf_fbr-doc       for fbr-doc.
     5884       define buffer buf_fbr-line      for fbr-line.
     5885   do
     5886   for buf_fbr-doc
     5887     , buf_fbr-line
     5888   on error undo, return error
     5889   :
     5890       find first buf_fbr-doc no-lock
     5891            where buf_fbr-doc.doc-code = p-doc-code
     5892       .
     5893       if buf_fbr-doc.is-free = no
     5894       then do:
     5895          undo, return error substitute("&1 &2 &3&4Документ производства &5 не является свободным.&4Удаление нулевых строк невозможно.&4&6&4&7"
     5896                                       ,vss-workfile
     5897                                       ,vss-revision
     5898                                       ,vss-description
     5899                                       ,chr(10)
     5900                                       ,buf_fbr-doc.doc-code
     5901                                       ,error-status:get-message(1)
     5902                                       ,return-value ) .
     5903       end.
     5904       assign
     5905           v-need-del-zero = no
     5906       .
     5907       for each buf_fbr-line no-lock
     5908          where buf_fbr-line.doc-code = p-doc-code
     5909       on error undo, return error
     5910       :
     5911           if buf_fbr-line.fact-qnty = 0
     5912           then do:
     5913             if p-silent then do:
     5914               assign
     5915               v-need-del-zero = yes
     5916               .
     5917             end.
     5918             else do:
     5919               message
     5920                   "В свободном документе производства"
     5921                   skip "есть строки с нулевым количеством."
     5922                   skip (1)
     5923                   skip "Вы можете удалить такие строки"
     5924                   skip "и продолжить закрытие документа"
     5925                   skip "или прервать процесс закрытия."
     5926                   skip (1)
     5927                   skip "Удалить нулевые строки?"
     5928               view-as alert-box question
     5929               buttons yes-no
     5930               title "Удаление нулевых строк документа"
     5931               update v-yesno.
     5932               if v-yesno = no
     5933               then do:
     5934                   assign
     5935                       p-continue = no
     5936                   .
     5937                   undo, return .
     5938               end.
     5939               else do:
     5940                   assign
     5941                       v-need-del-zero = yes
     5942                   .
     5943               end.
     5944           end.
     5945       end.
     5946       end.
     5947       if v-need-del-zero = yes
     5948       then do:
     5949           for each buf_fbr-line exclusive-lock
     5950              where buf_fbr-line.doc-code = p-doc-code
     5951           on error undo, return error
     5952           :
     5953               if buf_fbr-line.fact-qnty = 0
     5954               then do:
     5955                   delete buf_fbr-line.
     5956               end.
     5957           end.
     5958       end.
     5959       assign
     5960           p-continue = yes
     5961       .
     5962   end.
     5963   end procedure.
     5964   PROCEDURE check-recipe :
     5965   define input parameter p-doc-code               as character        no-undo.
     5966   define input parameter p-recipe-code            as character        no-undo.
     5967   define input parameter p-del-zero-lines         as logical          no-undo.
     5968   define output parameter p-always-del-zero-lines as logical          no-undo.
     5969   define output parameter p-ok                    as logical          no-undo.
     5970       define variable v-yesno    as logical      no-undo.
     5971       define buffer buf_recipe        for recipe.
     5972       define buffer buf_fbr-line      for fbr-line.
     5973   do
     5974   for buf_recipe
     5975     , buf_fbr-line
     5976   on error undo, return error
     5977   :
     5978       assign
     5979           p-always-del-zero-lines = p-del-zero-lines
     5980       .
     5981       find first buf_recipe no-lock
     5982            where buf_recipe.recipe-code = p-recipe-code
     5983       no-error.
     5984       if available buf_recipe
     5985       and buf_recipe.recipe-type = 'альтернатива':U
     5986       then do:
     5987           for each buf_fbr-line exclusive-lock
     5988              where buf_fbr-line.doc-code     = p-doc-code
     5989                and buf_fbr-line.is-comp      = no
     5990                and buf_fbr-line.recipe-code  = p-recipe-code
     5991                and buf_fbr-line.fact-qnty    = 0
     5992           on error undo, return error
     5993           :
     5994               if p-del-zero-lines = no
     5995               then do:
     5996                 if p-silent then do:
     5997                   assign
     5998                   p-del-zero-lines        = yes
     5999                   p-always-del-zero-lines = yes
     6000                  .
     6001                 end.
     6002                 else do:
     6003                   message
     6004                            "В рецепте альтернативы"
     6005                       skip "есть строки с количеством 0."
     6006                       skip "Необходимо либо удалить эти строки,"
     6007                       skip "либо продолжить редактирование документа."
     6008                       skip(1)
     6009                       skip "Документ:" buf_fbr-line.doc-code
     6010                       skip "Рецепт:  " buf_fbr-line.recipe-code
     6011                       skip(1)
     6012                       skip "Удалить строки всех рецептов альтернативы"
     6013                       skip "документа с количеством 0?"
     6014                   view-as alert-box information
     6015                   buttons yes-no
     6016                   title "Нулевые строки в рецепте альтернативы"
     6017                   update v-yesno .
     6018                   if v-yesno = no
     6019                   then do:
     6020                       assign
     6021                           p-always-del-zero-lines = no
     6022                           p-ok                    = no
     6023                       .
     6024                       undo, return.
     6025                   end.
     6026                   else do:
     6027                       assign
     6028                           p-del-zero-lines        = yes
     6029                           p-always-del-zero-lines = yes
     6030                       .
     6031                   end.
     6032                 end.
     6033               end.
     6034               delete buf_fbr-line.
     6035           end.
     6036       end.
     6037       assign
     6038           p-ok = yes
     6039       .
     6040   end.
     6041   END PROCEDURE.
     6042   procedure set-price-sale :
     6043   define input parameter p-fbr-doc-code   as character        no-undo.
     6044   define input parameter p-artic          as character        no-undo.
     6045   define input parameter p-prod-type      as character        no-undo.
     6046   define input parameter p-prod-code      as integer          no-undo.
     6047   define input parameter p-gds-code       as integer          no-undo.
     6048       define variable v-b-code            as integer      no-undo.
     6049       define variable v-void-character    as character    no-undo.
     6050       define variable v-void-decimal      as decimal      no-undo.
     6051       define variable v-price-sale        as decimal      no-undo.
     6052       define buffer buf_fbr-doc       for fbr-doc.
     6053       define buffer buf_fbr-line      for fbr-line.
     6054   do
     6055   for buf_fbr-line
     6056   on error undo, return error
     6057   :
     6058       find first buf_fbr-doc no-lock
     6059            where buf_fbr-doc.doc-code = p-fbr-doc-code
     6060       .
     6061   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6062     (input  p-gds-code
     6063     ,input  ?
     6064     ,output v-b-code
     6065     ) no-error .
     6066       if error-status :error
     6067       then do:
     6068          undo, return error substitute("&1 &2 &3&4Ошибка определения основного бар-кода товара с кодом &6 в документе производства &5.4&7&4&8"
     6069                                         ,vss-workfile
     6070                                         ,vss-revision
     6071                                         ,vss-description
     6072                                         ,chr(10)
     6073                                         ,buf_fbr-doc.doc-code
     6074                                         ,p-gds-code
     6075                                         ,error-status:get-message(1)
     6076                                         ,return-value ) .
     6077       end.
     6078   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6079   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     6080     (input  buf_fbr-doc.obj-type
     6081     ,input  buf_fbr-doc.obj-code
     6082     ,input  v-b-code
     6083     ,input  0
     6084     ,input  0
     6085     ,output v-void-character
     6086     ,output v-price-sale
     6087     ,output v-void-decimal
     6088     ,output v-void-decimal
     6089     ) no-error .
     6090       if error-status :error
     6091       then do:
     6092          undo, return error substitute("&1 &2 &3&4Ошибка определения продажной цены основного бар-кода товара &6.&4Документ производства &5.&4&7&4&8"
     6093                                         ,vss-workfile
     6094                                         ,vss-revision
     6095                                         ,vss-description
     6096                                         ,chr(10)
     6097                                         ,buf_fbr-doc.doc-code
     6098                                         , p-artic
     6099                                         ,error-status:get-message(1)
     6100                                         ,return-value ) .
     6101       end.
     6102       do transaction
     6103       on error undo, return error
     6104       :
     6105           for each buf_fbr-line exclusive-lock
     6106              where buf_fbr-line.doc-code  = p-fbr-doc-code
     6107                and buf_fbr-line.is-comp   = no
     6108                and buf_fbr-line.prod-type = p-prod-type
     6109                and buf_fbr-line.prod-code = p-prod-code
     6110                and buf_fbr-line.artic     = p-artic
     6111           on error undo, return error
     6112           :
     6113               if buf_fbr-line.is-calc = no
     6114               then do:
     6115                   if buf_fbr-line.price-sale <> v-price-sale
     6116                   then do:
     6117                       assign
     6118                           buf_fbr-line.price-sale = v-price-sale
     6119                       .
     6120                   end.
     6121               end.
     6122           end.
     6123       end.
     6124   end.
     6125   end procedure.
