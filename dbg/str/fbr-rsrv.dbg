        1   block-level on error undo, throw.
        2   define input parameter parparentproc    as widget-handle    no-undo.
        3   define input parameter p-fbrhist-handle as widget-handle    no-undo.
        4   define input parameter p-fbr-doc-recid  as recid            no-undo.
        5   define input parameter p-silent         as logical          no-undo .
        6   define input parameter p-autofbr        as logical          no-undo.
        7   define input parameter p-have-store     as logical          no-undo.
        8   define input parameter p-kitchen-rest   as logical          no-undo.
        9   define output parameter p-reserved      as logical          no-undo.
       10   define variable vss-revision    as character no-undo init "$Revision: d33fe82486ed, 142, rls $":U .
       11   define variable vss-author      as character no-undo init "$Author: ASMorozov $":U .
       12   define variable vss-date        as character no-undo init "$Date: Mon Feb 16 20:48:29 2015 +0400 $":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile: fbr-rsrv.p $":U .
       14   define variable vss-archive     as character no-undo init "$Archive: str/fbr-rsrv.p $":U .
       15   define variable vss-description as character no-undo init "Расчет учетных цен и резервирование (дорезервирование) по всему документу производства".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
       87   procedure partslib-clear-temp-parts :
       88     define buffer buf_temp-parts for temp-parts .
       89     do
       90     on error undo, return error
       91     :
       92       for each buf_temp-parts
       93       on error undo, return error
       94       :
       95         delete buf_temp-parts .
       96       end.
       97     end.
       98   end procedure.
       99   procedure partslib-create-temp-parts :
      100     define parameter buffer buf_parts       for ub.parts .
      101     define parameter buffer buf_temp-parts  for temp-parts .
      102     define input  parameter p-goods-twounit as logical   no-undo .
      103     define variable v-base-part-code as character no-undo .
      104     do
      105     on error undo, return error
      106     :
      107       if p-goods-twounit = true
      108       then do:
      109         assign
      110           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      111         .
      112       end.
      113       else do:
      114         assign
      115           v-base-part-code = buf_parts.part-code
      116         .
      117       end.
      118       find first buf_temp-parts exclusive-lock
      119         where buf_temp-parts.obj-type  = buf_parts.obj-type
      120           and buf_temp-parts.obj-code  = buf_parts.obj-code
      121           and buf_temp-parts.artic     = buf_parts.artic
      122           and buf_temp-parts.prod-type = buf_parts.prod-type
      123           and buf_temp-parts.prod-code = buf_parts.prod-code
      124           and buf_temp-parts.in-code   = buf_parts.in-code
      125           and buf_temp-parts.out-code  = 'free-zone':U
      126           and buf_temp-parts.part-code = v-base-part-code
      127         no-error.
      128       if not available buf_temp-parts
      129       then do:
      130         create buf_temp-parts .
      131         buffer-copy buf_parts to buf_temp-parts
      132         assign
      133           buf_temp-parts.out-code  = 'free-zone':U
      134           buf_temp-parts.part-code = v-base-part-code
      135           buf_temp-parts.rsrv-free = yes
      136           buf_temp-parts.status_   = no
      137           buf_temp-parts.qnty      = 0
      138           buf_temp-parts.fact-qnty = 0
      139           buf_temp-parts.real-qnty = 0
      140           buf_temp-parts.cli-qnty  = 0
      141         .
      142       end.
      143     end.
      144   end procedure.
      145   procedure partslib-init-temp-parts :
      146     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      147     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      148     define input parameter p-artic           like ub.parts.artic     no-undo .
      149     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      150     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      151     define buffer buf_parts      for ub.parts .
      152     define buffer buf_temp-parts for temp-parts .
      153     define variable v-goods-twounit    as logical   no-undo .
      154     do
      155     on error undo, return error
      156     :
      157   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      158   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      159     (input  p-artic
      160     ,input  p-prod-type
      161     ,input  p-prod-code
      162     ,input  'twounit=request':u
      163     ,output v-goods-twounit
      164     ) no-error .
      165       if error-status :error
      166       then do:
      167         message
      168           vss-workfile vss-revision vss-description skip
      169           vss-include-info0 skip
      170           "Ошибка при определении атрибута товара" skip
      171           "Артикул" p-artic p-prod-type p-prod-code skip
      172           "twounit=request" skip
      173           error-status :get-message(1) skip
      174           return-value skip
      175           view-as alert-box error .
      176         undo, return error return-value .
      177       end.
      178       run partslib-clear-temp-parts in this-procedure .
      179       for each buf_parts
      180         where buf_parts.obj-type  = p-obj-type
      181           and buf_parts.obj-code  = p-obj-code
      182           and buf_parts.artic     = p-artic
      183           and buf_parts.prod-type = p-prod-type
      184           and buf_parts.prod-code = p-prod-code
      185           and buf_parts.rsrv-free = yes
      186           and buf_parts.status_   = no
      187           and buf_parts.in-code   <> buf_parts.out-code
      188       on error undo, return error
      189       :
      190         run partslib-create-temp-parts in this-procedure
      191           (buffer buf_parts
      192           ,buffer buf_temp-parts
      193           ,input  v-goods-twounit
      194           ) .
      195         define variable v-parts-qnty          as decimal   no-undo .
      196         define variable v-parts-cli-qnty      as decimal   no-undo .
      197         define variable v-parts-free-qnty     as decimal   no-undo .
      198         define variable v-parts-free-cli-qnty as decimal   no-undo .
      199         if buf_parts.out-code = 'free-zone':U
      200         then do:
      201           assign
      202             v-parts-qnty          = buf_parts.qnty
      203             v-parts-cli-qnty      = buf_parts.cli-qnty
      204             v-parts-free-qnty     = buf_parts.qnty
      205             v-parts-free-cli-qnty = buf_parts.cli-qnty
      206           .
      207         end.
      208         else do:
      209           assign
      210             v-parts-qnty          = abs(buf_parts.qnty)
      211             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      212             v-parts-free-qnty     = 0
      213             v-parts-free-cli-qnty = 0
      214           .
      215         end.
      216         assign
      217           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      218           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      219           buf_temp-parts.real-qnty     = 0
      220           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      221           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      222           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      223         .
      224       end.
      225     end.
      226   end procedure.
      227   procedure partslib-init-temp-parts-by-factord :
      228     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      229     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      230     define input parameter p-artic              like ub.parts.artic     no-undo .
      231     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      232     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      233     define input parameter p-fact-order         as decimal   no-undo .
      234     define input parameter p-include-fact-order as logical   no-undo .
      235     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      236     define buffer buf_gds-obj  for ub.gds-obj .
      237     do
      238     on error undo, return error
      239     :
      240       do transaction
      241       on error undo, return error
      242       :
      243   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      244   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      245     (input  p-obj-type
      246     ,input  p-obj-code
      247     ,input  p-artic
      248     ,input  p-prod-type
      249     ,input  p-prod-code
      250     ,buffer buf_gds-obj
      251     ) no-error .
      252         if error-status :error
      253         then do:
      254           message
      255             vss-workfile vss-revision vss-description skip
      256             vss-include-info0 skip
      257             "Невозможно найти товар на объекте" skip
      258             "Объект" p-obj-type p-obj-code skip
      259             "Артикул" p-artic p-prod-type p-prod-code skip
      260             error-status :get-message(1) skip
      261             return-value skip
      262             view-as alert-box error .
      263           undo, return error .
      264         end.
      265         find current buf_gds-obj exclusive-lock .
      266       end.
      267       run partslib-init-temp-parts in this-procedure
      268         (input p-obj-type
      269         ,input p-obj-code
      270         ,input p-artic
      271         ,input p-prod-type
      272         ,input p-prod-code
      273         ) no-error .
      274       if error-status :error
      275       then do:
      276         message
      277           vss-workfile vss-revision vss-description skip
      278           vss-include-info0 skip
      279           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      280           "Объект" p-obj-type p-obj-code skip
      281           "Артикул" p-artic p-prod-type p-prod-code skip
      282           "p-fact-order" p-fact-order skip
      283           view-as alert-box error .
      284         undo, return error .
      285       end.
      286       if p-include-fact-order = true
      287       then do:
      288         assign
      289           p-fact-order = p-fact-order - 0.0000000001
      290         .
      291       end.
      292       define variable v-max-fact-order as character no-undo .
      293       run factord-max-fact-order in this-procedure
      294         (output v-max-fact-order
      295         ) no-error .
      296       if error-status :error
      297       then do:
      298         message
      299           vss-workfile vss-revision vss-description skip
      300           vss-include-info0 skip
      301           "Ошибка при вызове процедуры factord-max-fact-order" skip
      302           "Объект" p-obj-type p-obj-code skip
      303           "Артикул" p-artic p-prod-type p-prod-code skip
      304           "p-fact-order" p-fact-order skip
      305           view-as alert-box error .
      306         undo, return error .
      307       end.
      308       run partslib-update-by-factord in this-procedure
      309         (input p-obj-type
      310         ,input p-obj-code
      311         ,input p-artic
      312         ,input p-prod-type
      313         ,input p-prod-code
      314         ,input p-fact-order
      315         ,input v-max-fact-order
      316         ,input false
      317         ) no-error .
      318       if error-status :error
      319       then do:
      320         message
      321           vss-workfile vss-revision vss-description skip
      322           vss-include-info0 skip
      323           "Ошибка при вызове процедуры partslib-update-by-factord" skip
      324           "Объект" p-obj-type p-obj-code skip
      325           "Артикул" p-artic p-prod-type p-prod-code skip
      326           "p-fact-order" p-fact-order skip
      327           "v-max-fact-order" v-max-fact-order skip
      328           view-as alert-box error .
      329         undo, return error .
      330       end.
      331     end.
      332   end procedure.
      333   procedure partslib-update-by-factord :
      334     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      335     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      336     define input parameter p-artic              like ub.parts.artic     no-undo .
      337     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      338     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      339     define input parameter p-start-fact-order   as decimal   no-undo .
      340     define input parameter p-end-fact-order     as decimal   no-undo .
      341     define input parameter p-lock-gds-obj       as logical   no-undo .
      342     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      343     define buffer buf_gds-obj  for ub.gds-obj .
      344     define buffer buf_doc-line for ub.doc-line .
      345     define variable v-total-parts-qnty as decimal   no-undo .
      346     define variable v-goods-gds-goods  as logical   no-undo .
      347     define variable v-goods-twounit    as logical   no-undo .
      348     do
      349     on error undo, return error
      350     :
      351       if p-start-fact-order > p-end-fact-order
      352       then do:
      353         message
      354           vss-workfile vss-revision vss-description skip
      355           vss-include-info0 skip
      356           "Ошибка задания входных параметров" skip
      357           "Начало интервала превышает конец интервала" skip
      358           "Объект" p-obj-type p-obj-code skip
      359           "Артикул" p-artic p-prod-type p-prod-code skip
      360           "p-start-fact-order" p-start-fact-order skip
      361           "p-end-fact-order"   p-end-fact-order skip
      362           view-as alert-box error .
      363         undo, return error .
      364       end.
      365       if p-lock-gds-obj = true
      366       then do:
      367         do transaction
      368         on error undo, return error
      369         :
      370   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      371   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      372     (input  p-obj-type
      373     ,input  p-obj-code
      374     ,input  p-artic
      375     ,input  p-prod-type
      376     ,input  p-prod-code
      377     ,buffer buf_gds-obj
      378     ) no-error .
      379           if error-status :error
      380           then do:
      381             message
      382               vss-workfile vss-revision vss-description skip
      383               vss-include-info0 skip
      384               "Невозможно найти gds-obj" skip
      385               error-status :get-message(1) skip
      386               return-value skip
      387               view-as alert-box error .
      388             undo, return error .
      389           end.
      390           find current buf_gds-obj exclusive-lock .
      391         end.
      392       end.
      393   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      394   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      395     (input  p-artic
      396     ,input  p-prod-type
      397     ,input  p-prod-code
      398     ,input  'gds-goods=request':u
      399     ,output v-goods-gds-goods
      400     ) no-error .
      401       if error-status :error
      402       then do:
      403         message
      404           vss-workfile vss-revision vss-description skip
      405           vss-include-info0 skip
      406           "Ошибка при определении атрибута товара" skip
      407           "Артикул" p-artic p-prod-type p-prod-code skip
      408           "gds-goods=request" skip
      409           error-status :get-message(1) skip
      410           return-value skip
      411           view-as alert-box error .
      412         undo, return error return-value .
      413       end.
      414   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      415   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      416     (input  p-artic
      417     ,input  p-prod-type
      418     ,input  p-prod-code
      419     ,input  'twounit=request':u
      420     ,output v-goods-twounit
      421     ) no-error .
      422       if error-status :error
      423       then do:
      424         message
      425           vss-workfile vss-revision vss-description skip
      426           vss-include-info0 skip
      427           "Ошибка при определении атрибута товара" skip
      428           "Артикул" p-artic p-prod-type p-prod-code skip
      429           "twounit=request" skip
      430           error-status :get-message(1) skip
      431           return-value skip
      432           view-as alert-box error .
      433         undo, return error return-value .
      434       end.
      435       for each buf_doc-line no-lock
      436         where buf_doc-line.obj-type   = p-obj-type
      437           and buf_doc-line.obj-code   = p-obj-code
      438           and buf_doc-line.artic      = p-artic
      439           and buf_doc-line.prod-type  = p-prod-type
      440           and buf_doc-line.prod-code  = p-prod-code
      441           and buf_doc-line.status_    = 'факт':U
      442           and buf_doc-line.fact-order > p-start-fact-order
      443           and buf_doc-line.fact-order <= p-end-fact-order
      444       on error undo, return error
      445       :
      446         run partslib-process-document in this-procedure
      447           (input  buf_doc-line.doc-code
      448           ,input  p-obj-type
      449           ,input  p-obj-code
      450           ,input  p-artic
      451           ,input  p-prod-type
      452           ,input  p-prod-code
      453           ,input  v-goods-gds-goods
      454           ,input  v-goods-twounit
      455           ,output v-total-parts-qnty
      456           ) no-error .
      457         if error-status :error
      458         then do:
      459           message
      460             vss-workfile vss-revision vss-description skip
      461             vss-include-info0 skip
      462             "Ошибка при вызове процедуры partslib-process-document" skip
      463             "Документ" buf_doc-line.doc-code skip
      464             "Объект" p-obj-type p-obj-code skip
      465             "Артикул" p-artic p-prod-type p-prod-code skip
      466             "p-start-fact-order" p-start-fact-order skip
      467             "p-end-fact-order" p-end-fact-order skip
      468             error-status :get-message(1) skip
      469             return-value skip
      470             view-as alert-box error .
      471           undo, return error return-value .
      472         end.
      473       end.
      474     end.
      475   end procedure.
      476   procedure partslib-process-document :
      477     define input  parameter p-doc-code         as character no-undo .
      478     define input  parameter p-obj-type         as character no-undo .
      479     define input  parameter p-obj-code         as integer   no-undo .
      480     define input  parameter p-artic            as character no-undo .
      481     define input  parameter p-prod-type        as character no-undo .
      482     define input  parameter p-prod-code        as integer   no-undo .
      483     define input  parameter p-goods-gds-goods  as logical   no-undo .
      484     define input  parameter p-goods-twounit    as logical   no-undo .
      485     define output parameter p-total-parts-qnty as decimal   no-undo .
      486     define variable v-parts-sign as integer   no-undo .
      487     define buffer buf_trn-doc    for ub.trn-doc .
      488     define buffer buf_doc-line   for ub.doc-line .
      489     define buffer buf_parts      for ub.parts .
      490     define buffer buf_temp-parts for temp-parts .
      491     do
      492     on error undo, return error return-value
      493     :
      494       find first buf_trn-doc no-lock
      495         where buf_trn-doc.doc-code = p-doc-code
      496         no-error .
      497       if not available buf_trn-doc
      498       then do:
      499         undo, return error substitute("Ошибка при поиске документа. Документ &1"
      500                                      ,p-doc-code
      501                                      ) .
      502       end.
      503       case buf_trn-doc.doc-type
      504       :
      505         when 'при':U or
      506         when 'возврат':U or
      507         when 'инв':U
      508         then do:
      509           assign
      510             v-parts-sign = -1
      511           .
      512         end.
      513         when 'рас':U or
      514         when 'спи':U
      515         then do:
      516           assign
      517             v-parts-sign = 1
      518           .
      519         end.
      520         otherwise do:
      521           undo, return error substitute("Неизвестный тип документа &1"
      522                                       ,buf_trn-doc.doc-type
      523                                       ) .
      524         end.
      525       end.
      526       find first buf_doc-line no-lock
      527         where buf_doc-line.doc-code  = p-doc-code
      528           and buf_doc-line.artic     = p-artic
      529           and buf_doc-line.prod-type = p-prod-type
      530           and buf_doc-line.prod-code = p-prod-code
      531         no-error .
      532       if not available buf_doc-line
      533       then do:
      534         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
      535                                      ,p-doc-code
      536                                      ,artic
      537                                      ,prod-type
      538                                      ,prod-code
      539                                      ) .
      540       end.
      541       assign
      542         p-total-parts-qnty = 0
      543       .
      544       if p-goods-gds-goods = true
      545       then do:
      546         for each buf_parts no-lock
      547           where buf_parts.out-code  = p-doc-code
      548             and buf_parts.obj-type  = p-obj-type
      549             and buf_parts.obj-code  = p-obj-code
      550             and buf_parts.artic     = p-artic
      551             and buf_parts.prod-type = p-prod-type
      552             and buf_parts.prod-code = p-prod-code
      553         on error undo, return error
      554         :
      555           run partslib-create-temp-parts in this-procedure
      556             (buffer buf_parts
      557             ,buffer buf_temp-parts
      558             ,input  p-goods-twounit
      559             ) .
      560           assign
      561             p-total-parts-qnty        = p-total-parts-qnty
      562                                       + v-parts-sign * buf_parts.fact-qnty
      563             buf_temp-parts.qnty       = buf_temp-parts.qnty
      564                                       + v-parts-sign * buf_parts.fact-qnty
      565             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
      566                                       + v-parts-sign * buf_parts.fact-qnty
      567             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
      568                                       + v-parts-sign * buf_parts.cli-qnty
      569           .
      570           if buf_temp-parts.qnty = 0
      571           then do:
      572             delete buf_temp-parts .
      573           end.
      574         end.
      575       end.
      576       else do:
      577         assign
      578           p-total-parts-qnty = p-total-parts-qnty
      579                              + v-parts-sign * buf_doc-line.fact-qnty
      580         .
      581       end.
      582     end.
      583   end procedure.
      584   procedure partslib-init-temp-parts-by-date :
      585     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      586     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      587     define input parameter p-artic           like ub.parts.artic     no-undo .
      588     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      589     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      590     define input parameter p-fact-date       as date      no-undo .
      591     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
      592     do
      593     on error undo, return error
      594     :
      595       define variable v-fact-order                as decimal   no-undo .
      596       define variable v-shift-end-fact-order      as decimal   no-undo .
      597       define variable v-day-end-fact-order        as decimal   no-undo .
      598       run factord in this-procedure
      599         (input  p-fact-date
      600         ,input  1
      601         ,input  1
      602         ,input  ?
      603         ,input  0
      604         ,input  false
      605         ,output v-fact-order
      606         ,output v-shift-end-fact-order
      607         ,output v-day-end-fact-order
      608         ) no-error .
      609       if error-status :error
      610       then do:
      611         message
      612           vss-workfile vss-revision vss-description skip
      613           vss-include-info0 skip
      614           "Ошибка при определении момента времени, на который требуется остаток" skip
      615           "Объект" p-obj-type p-obj-code skip
      616           "Артикул" p-artic p-prod-type p-prod-code skip
      617           "Дата" p-fact-date skip
      618           view-as alert-box error .
      619         undo, return error .
      620       end.
      621       run partslib-init-temp-parts-by-factord in this-procedure
      622         (input p-obj-type
      623         ,input p-obj-code
      624         ,input p-artic
      625         ,input p-prod-type
      626         ,input p-prod-code
      627         ,input v-day-end-fact-order
      628         ,input false
      629         ) no-error .
      630       if error-status :error
      631       then do:
      632         message
      633           vss-workfile vss-revision vss-description skip
      634           vss-include-info0 skip
      635           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
      636           "Объект" p-obj-type p-obj-code skip
      637           "Артикул" p-artic p-prod-type p-prod-code skip
      638           "Дата" p-fact-date skip
      639           view-as alert-box error .
      640         undo, return error .
      641       end.
      642     end.
      643   end procedure.
      644   procedure partslib-calc-cost :
      645     define output parameter p-fact-qnty      as decimal   no-undo .
      646     define output parameter p-vat-pc         as decimal   no-undo .
      647     define output parameter p-slt-pc         as decimal   no-undo .
      648     define output parameter p-sum-base       as decimal   no-undo .
      649     define output parameter p-sum-rubl       as decimal   no-undo .
      650     define output parameter p-vat-base       as decimal   no-undo .
      651     define output parameter p-vat-rubl       as decimal   no-undo .
      652     define output parameter p-slt-base       as decimal   no-undo .
      653     define output parameter p-slt-rubl       as decimal   no-undo .
      654     define output parameter p-road-tax-base  as decimal   no-undo .
      655     define output parameter p-road-tax-rubl  as decimal   no-undo .
      656     define output parameter p-transport-base as decimal   no-undo .
      657     define output parameter p-transport-rubl as decimal   no-undo .
      658     define output parameter p-other-base     as decimal   no-undo .
      659     define output parameter p-other-rubl     as decimal   no-undo .
      660     define output parameter p-excise-base    as decimal   no-undo .
      661     define output parameter p-excise-rubl    as decimal   no-undo .
      662     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
      663     do
      664     on error undo, return error return-value
      665     :
      666       define buffer buf_temp-parts for temp-parts .
      667       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      668       define buffer   in-vatp-parts    for ub.parts   .
      669       define buffer   in-vatp-doc      for ub.trn-doc .
      670       define buffer   in-vatp-goods    for ub.goods   .
      671       define buffer   in-vatp-sysconf  for ub.sysconf .
      672       define buffer   in-vatp_doc-attr for ub.doc-attr.
      673       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      674       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      675       define variable varinvprb                  as   character              no-undo.
      676       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      677       define variable cli-base-rate              as   decimal                no-undo.
      678       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      679       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      680       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      681       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      682       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      683       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      684       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      685       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      686       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      687       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      688       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      689       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      690       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      691       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      692       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      693       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      694       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      695       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      696       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      697       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      698       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      699       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      700       define variable varinvatp-envd             as   character              no-undo.
      701       define variable varinvatp-type             as   character              no-undo.
      702       for each buf_temp-parts
      703       on error undo, return error
      704       :
      705   assign
      706     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
      707     price-base-with-tax-loc = buf_temp-parts.price-base
      708   .
      709   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      710   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      711     (output varinvprb
      712     )  .
      713     if buf_temp-parts.out-code = 'free-zone':U     or
      714        buf_temp-parts.out-code = 'out-zone':U   or
      715        buf_temp-parts.doc-type = 'акт':U then do:
      716       assign
      717         in-vatp-have-vat-slt = yes.
      718     end.
      719     else do:
      720       find first in-vatp_doc-attr no-lock
      721         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
      722           and in-vatp_doc-attr.attr-code = 'envd':U
      723         no-error .
      724       if not available in-vatp_doc-attr then do:
      725         assign
      726           in-vatp-have-vat-slt = yes.
      727       end.
      728       else do:
      729            in-vatp-have-vat-slt = no.
      730       end.
      731     end.
      732     assign
      733      price-cli-with-tax-loc = buf_temp-parts.price-cli
      734      cli-base-rate          = buf_temp-parts.cli-base-rate.
      735     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
      736              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
      737     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
      738             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
      739             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
      740             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
      741             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
      742             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
      743             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      744       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      745     assign
      746       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
      747     assign
      748       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
      749       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
      750       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
      751       transport-cli-loc  = 0
      752       other-cli-loc      = 0
      753     .
      754   ASSIGN
      755             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      756       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      757   .
      758         assign
      759           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
      760           p-vat-pc         = p-vat-pc         + vat-pc-loc
      761           p-slt-pc         = p-slt-pc         + slt-pc-loc
      762           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
      763           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
      764           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
      765           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
      766           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
      767           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
      768           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
      769           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
      770           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
      771           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
      772           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
      773           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
      774           p-excise-base    = p-excise-base    + 0
      775           p-excise-rubl    = p-excise-rubl    + 0
      776         .
      777       end.
      778       if p-fact-qnty      = ?
      779       or p-sum-base       = ?
      780       or p-sum-rubl       = ?
      781       or p-vat-base       = ?
      782       or p-vat-rubl       = ?
      783       or p-slt-base       = ?
      784       or p-slt-rubl       = ?
      785       or p-road-tax-base  = ?
      786       or p-road-tax-rubl  = ?
      787       or p-transport-base = ?
      788       or p-transport-rubl = ?
      789       or p-other-base     = ?
      790       or p-other-rubl     = ?
      791       or p-excise-base    = ?
      792       or p-excise-rubl    = ?
      793       then do:
      794         message
      795           vss-workfile vss-revision vss-description skip
      796           vss-include-info0 skip
      797           "Программа in-vatp.i вернула неопределенные значения" skip
      798           "p-fact-qnty"      p-fact-qnty      skip
      799           "p-sum-base"       p-sum-base       skip
      800           "p-sum-rubl"       p-sum-rubl       skip
      801           "p-vat-base"       p-vat-base       skip
      802           "p-vat-rubl"       p-vat-rubl       skip
      803           "p-slt-base"       p-slt-base       skip
      804           "p-slt-rubl"       p-slt-rubl       skip
      805           "p-road-tax-base"  p-road-tax-base  skip
      806           "p-road-tax-rubl"  p-road-tax-rubl  skip
      807           "p-transport-base" p-transport-base skip
      808           "p-transport-rubl" p-transport-rubl skip
      809           "p-other-base"     p-other-base     skip
      810           "p-other-rubl"     p-other-rubl     skip
      811           "p-excise-base"    p-excise-base    skip
      812           "p-excise-rubl"    p-excise-rubl    skip
      813           view-as alert-box error .
      814         undo, return error .
      815       end.
      816     end.
      817   end procedure.
      818   procedure fbrrest-get-free-qnty :
      819   do
      820   on error undo, return error
      821   :
      822   define input parameter p-obj-type       as character            no-undo.
      823   define input parameter p-obj-code       as integer              no-undo.
      824   define input parameter p-gds-code       as integer              no-undo.
      825   define input parameter p-autofbr        as logical              no-undo.
      826   define output parameter p-avail-qnty    as decimal              no-undo.
      827       define variable v-req-qnty  like ub.fbr-line.fact-qnty no-undo.
      828       define variable v-free-qnty as decimal       no-undo.
      829       define buffer buf_goods         for ub.goods.
      830       define buffer buf_gds-obj       for ub.gds-obj.
      831       define buffer buf_temp-parts    for temp-parts.
      832       find first buf_goods no-lock
      833            where buf_goods.gds-code = p-gds-code
      834       .
      835       assign
      836           p-avail-qnty = 0
      837       .
      838       run partslib-init-temp-parts in this-procedure (
      839             input p-obj-type
      840           , input p-obj-code
      841           , input buf_goods.artic
      842           , input buf_goods.prod-type
      843           , input buf_goods.prod-code
      844       ).
      845       assign
      846           v-free-qnty = 0
      847       .
      848       for each buf_temp-parts
      849       on error undo, return error
      850       :
      851           if buf_temp-parts.qnty > 0
      852           then do:
      853               assign
      854                   v-free-qnty = v-free-qnty + buf_temp-parts.free-qnty
      855               .
      856           end.
      857       end.
      858       assign
      859           p-avail-qnty = ( if v-free-qnty > 0 then v-free-qnty else 0 )
      860       .
      861   end.
      862   end procedure.
      863   procedure fbrrest-get-catering-object :
      864   do
      865   on error undo, return error
      866   :
      867   define input parameter p-obj-code            as integer      no-undo.
      868   define output parameter p-catering-obj-type  as character    no-undo.
      869   define output parameter p-catering-obj-code  as integer      no-undo.
      870       define buffer buf_shop              for ub.shop.
      871       find first buf_shop no-lock
      872            where buf_shop.obj-code = p-obj-code
      873       .
      874       assign
      875           p-catering-obj-type = buf_shop.kitchen-store-type
      876           p-catering-obj-code = buf_shop.kitchen-store-code
      877       .
      878   end.
