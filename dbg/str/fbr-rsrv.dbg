     4543         ASSIGN
     4544           road-tax-base-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     4545           road-tax-rubl-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     4546           transport-base-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     4547           transport-rubl-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     4548           other-base-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     4549           other-rubl-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     4550                                           vat-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     4551           slt-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     4552                   vat-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     4553           slt-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     4554           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     4555           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     4556         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     4557         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     4558         if transport-base-loc = ? then transport-base-loc = 0.
     4559         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     4560         if other-base-loc     = ? then other-base-loc     = 0.
     4561         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     4562         assign
     4563           transport-cli-loc      = 0
     4564           other-cli-loc          = 0
     4565           road-tax-cli-loc       = ?
     4566           vat-cli-loc            = ?
     4567           slt-cli-loc            = ?
     4568           price-cli-with-tax-loc = ?.
     4569      end.
     4570   ASSIGN
     4571             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     4572       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     4573   .
     4574             assign
     4575               v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
     4576               v-vat-pc              = vat-pc-loc
     4577               v-slt-pc              = slt-pc-loc
     4578               v-sum-base            = v-sum-base       + (price-base-with-tax-loc * v-parts-fact-qnty)
     4579               v-sum-rubl            = v-sum-rubl       + (price-rubl-with-tax-loc * v-parts-fact-qnty)
     4580               v-vat-base            = v-vat-base       + (vat-base-loc            * v-parts-fact-qnty)
     4581               v-vat-rubl            = v-vat-rubl       + (vat-rubl-loc            * v-parts-fact-qnty)
     4582               v-slt-base            = v-slt-base       + (slt-base-loc            * v-parts-fact-qnty)
     4583               v-slt-rubl            = v-slt-rubl       + (slt-rubl-loc            * v-parts-fact-qnty)
     4584               v-road-tax-base       =  0
     4585               v-road-tax-rubl       =  0
     4586               v-excise-base         =  0
     4587               v-excise-rubl         =  0
     4588               v-transport-base      =  0
     4589               v-transport-rubl      =  0
     4590               v-other-base          =  0
     4591               v-other-rubl          =  0
     4592             .
     4593       end.
     4594     end.
     4595   end procedure.
     4596   procedure fbrrep-fill-qnty-and-prices :
     4597   do
     4598   on error undo, return error
     4599   :
     4600   define input parameter p-fbr-doc-doc-code  as character    no-undo.
     4601       define variable v-gds-code  as integer       no-undo.
     4602       define variable v-gds-name  as character     no-undo.
     4603       define variable v-sign      as decimal       no-undo.
     4604       define buffer buf_fbr-line          for ub.fbr-line.
     4605       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     4606       for each buf_fbr-line no-lock
     4607          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     4608       on error undo, return error
     4609       :
     4610           find first buf_temp_fbrrep-goods
     4611                where buf_temp_fbrrep-goods.artic     = buf_fbr-line.artic
     4612                  and buf_temp_fbrrep-goods.prod-type = buf_fbr-line.prod-type
     4613                  and buf_temp_fbrrep-goods.prod-code = buf_fbr-line.prod-code
     4614           use-index ar
     4615           no-error.
     4616           if not available buf_temp_fbrrep-goods
     4617           then do:
     4618               create buf_temp_fbrrep-goods.
     4619   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4620   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     4621     (input  buf_fbr-line.artic
     4622     ,input  buf_fbr-line.prod-type
     4623     ,input  buf_fbr-line.prod-code
     4624     ,output v-gds-code
     4625     )  .
     4626   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4627   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     4628     (input  buf_fbr-line.artic
     4629     ,input  buf_fbr-line.prod-type
     4630     ,input  buf_fbr-line.prod-code
     4631     ,output v-gds-name
     4632     )  .
     4633   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4634   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     4635     (input  buf_fbr-line.artic
     4636     ,input  buf_fbr-line.prod-type
     4637     ,input  buf_fbr-line.prod-code
     4638     ,input  'gds-goods=request':u
     4639     ,output buf_temp_fbrrep-goods.is-not-office
     4640     )  .
     4641               assign
     4642                   buf_temp_fbrrep-goods.gds-code             = v-gds-code
     4643                   buf_temp_fbrrep-goods.artic                = buf_fbr-line.artic
     4644                   buf_temp_fbrrep-goods.prod-type            = buf_fbr-line.prod-type
     4645                   buf_temp_fbrrep-goods.prod-code            = buf_fbr-line.prod-code
     4646                   buf_temp_fbrrep-goods.gds-name             = v-gds-name
     4647                   buf_temp_fbrrep-goods.is-waste             = buf_fbr-line.is-waste
     4648                   buf_temp_fbrrep-goods.fact-qnty            = 0
     4649                   buf_temp_fbrrep-goods.write-off-rsrv-qnty  = 0
     4650                   buf_temp_fbrrep-goods.write-off-qnty       = 0
     4651                   buf_temp_fbrrep-goods.income-qnty          = 0
     4652                   buf_temp_fbrrep-goods.income-rsrv-qnty     = 0
     4653                   buf_temp_fbrrep-goods.cost-rubl            = 0
     4654                   buf_temp_fbrrep-goods.cost-base            = 0
     4655                   buf_temp_fbrrep-goods.sum-cost-rubl        = 0
     4656                   buf_temp_fbrrep-goods.sum-cost-base        = 0
     4657                   buf_temp_fbrrep-goods.vat-cost-rubl        = 0
     4658                   buf_temp_fbrrep-goods.vat-cost-base        = 0
     4659                   buf_temp_fbrrep-goods.sum-vat-cost-rubl    = 0
     4660                   buf_temp_fbrrep-goods.sum-vat-cost-base    = 0
     4661                   buf_temp_fbrrep-goods.price-sale           = buf_fbr-line.price-sale
     4662                   buf_temp_fbrrep-goods.deleted              = no
     4663               .
     4664   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4665   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     4666     (input  v-gds-code
     4667     ,output buf_temp_fbrrep-goods.unit-base
     4668     )  .
     4669           end.
     4670           case buf_fbr-line.trn-type
     4671           :
     4672               when 'при':U
     4673               then do:
     4674                   assign
     4675                       v-sign                                  = 1
     4676                       buf_temp_fbrrep-goods.income-qnty       = buf_temp_fbrrep-goods.income-qnty     + buf_fbr-line.fact-qnty
     4677                   .
     4678                   if buf_fbr-line.rsrv-qnty <> ?
     4679                   then do:
     4680                       assign
     4681                           buf_temp_fbrrep-goods.income-rsrv-qnty = buf_temp_fbrrep-goods.income-rsrv-qnty   + buf_fbr-line.rsrv-qnty
     4682                       .
     4683                   end.
     4684               end.
     4685               when 'спи':U
     4686               then do:
     4687                   assign
     4688                       v-sign                                  = -1
     4689                       buf_temp_fbrrep-goods.write-off-qnty    = buf_temp_fbrrep-goods.write-off-qnty  + buf_fbr-line.fact-qnty
     4690                   .
     4691                   if buf_fbr-line.rsrv-qnty <> ?
     4692                   then do:
     4693                       assign
     4694                           buf_temp_fbrrep-goods.write-off-rsrv-qnty = buf_temp_fbrrep-goods.write-off-rsrv-qnty   + buf_fbr-line.rsrv-qnty
     4695                       .
     4696                   end.
     4697               end.
     4698           end case.
     4699           assign
     4700               buf_temp_fbrrep-goods.sum-cost-rubl        = buf_temp_fbrrep-goods.sum-cost-rubl     + v-sign * buf_fbr-line.price-sum-rubl
     4701               buf_temp_fbrrep-goods.sum-cost-base        = buf_temp_fbrrep-goods.sum-cost-base     + v-sign * buf_fbr-line.price-sum-base
     4702               buf_temp_fbrrep-goods.sum-vat-cost-rubl    = buf_temp_fbrrep-goods.sum-vat-cost-rubl + v-sign * buf_fbr-line.price-sum-vat-rubl
     4703               buf_temp_fbrrep-goods.sum-vat-cost-base    = buf_temp_fbrrep-goods.sum-vat-cost-base + v-sign * buf_fbr-line.price-sum-vat-base
     4704           .
     4705       end.
     4706       run test-temp-tables in this-procedure .
     4707   end.
     4708   end procedure.
     4709   procedure fbrrep-fill-for-fbr-actp :
     4710   do
     4711   on error undo, return error
     4712   :
     4713   define input parameter p-fbr-doc-doc-code  as character    no-undo.
     4714       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     4715       define buffer buf_fbr-line          for ub.fbr-line.
     4716       run fbrrep-fill-qnty-and-prices in this-procedure (
     4717           input p-fbr-doc-doc-code
     4718       ).
     4719       for each buf_temp_fbrrep-goods
     4720       :
     4721           assign
     4722               buf_temp_fbrrep-goods.sum-cost-rubl     = 0
     4723               buf_temp_fbrrep-goods.sum-cost-base     = 0
     4724               buf_temp_fbrrep-goods.sum-vat-cost-rubl = 0
     4725               buf_temp_fbrrep-goods.sum-vat-cost-base = 0
     4726               buf_temp_fbrrep-goods.cost-rubl     = 0
     4727               buf_temp_fbrrep-goods.cost-base     = 0
     4728               buf_temp_fbrrep-goods.vat-cost-rubl = 0
     4729               buf_temp_fbrrep-goods.vat-cost-base = 0
     4730           .
     4731           if buf_temp_fbrrep-goods.income-qnty = 0
     4732           or buf_temp_fbrrep-goods.write-off-qnty = 0
     4733           then do:
     4734               assign
     4735                   buf_temp_fbrrep-goods.deleted   = yes
     4736                   buf_temp_fbrrep-goods.fact-qnty = 0
     4737               .
     4738           end.
     4739           else do:
     4740               if buf_temp_fbrrep-goods.income-qnty <= buf_temp_fbrrep-goods.write-off-qnty
     4741               then do:
     4742                   assign
     4743                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty
     4744                   .
     4745                   for each buf_fbr-line no-lock
     4746                      where buf_fbr-line.doc-code  = p-fbr-doc-doc-code
     4747                        and buf_fbr-line.artic     = buf_temp_fbrrep-goods.artic
     4748                        and buf_fbr-line.prod-type = buf_temp_fbrrep-goods.prod-type
     4749                        and buf_fbr-line.prod-code = buf_temp_fbrrep-goods.prod-code
     4750                        and buf_fbr-line.trn-type  = 'при':U
     4751                   :
     4752                       assign
     4753                           buf_temp_fbrrep-goods.sum-cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     + buf_fbr-line.price-sum-rubl
     4754                           buf_temp_fbrrep-goods.sum-cost-base     = buf_temp_fbrrep-goods.sum-cost-base     + buf_fbr-line.price-sum-base
     4755                           buf_temp_fbrrep-goods.sum-vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl + buf_fbr-line.price-sum-vat-rubl
     4756                           buf_temp_fbrrep-goods.sum-vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base + buf_fbr-line.price-sum-vat-base
     4757                       .
     4758                   end.
     4759                   assign
     4760                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / buf_temp_fbrrep-goods.fact-qnty
     4761                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / buf_temp_fbrrep-goods.fact-qnty
     4762                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / buf_temp_fbrrep-goods.fact-qnty
     4763                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / buf_temp_fbrrep-goods.fact-qnty
     4764                   .
     4765               end.
     4766               else do:
     4767                   assign
     4768                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty
     4769                   .
     4770                   for each buf_fbr-line no-lock
     4771                      where buf_fbr-line.doc-code  = p-fbr-doc-doc-code
     4772                        and buf_fbr-line.artic     = buf_temp_fbrrep-goods.artic
     4773                        and buf_fbr-line.prod-type = buf_temp_fbrrep-goods.prod-type
     4774                        and buf_fbr-line.prod-code = buf_temp_fbrrep-goods.prod-code
     4775                        and buf_fbr-line.trn-type  = 'спи':U
     4776                   :
     4777                       assign
     4778                           buf_temp_fbrrep-goods.sum-cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     + buf_fbr-line.price-sum-rubl
     4779                           buf_temp_fbrrep-goods.sum-cost-base     = buf_temp_fbrrep-goods.sum-cost-base     + buf_fbr-line.price-sum-base
     4780                           buf_temp_fbrrep-goods.sum-vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl + buf_fbr-line.price-sum-vat-rubl
     4781                           buf_temp_fbrrep-goods.sum-vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base + buf_fbr-line.price-sum-vat-base
     4782                       .
     4783                   end.
     4784                   assign
     4785                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / buf_temp_fbrrep-goods.fact-qnty
     4786                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / buf_temp_fbrrep-goods.fact-qnty
     4787                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / buf_temp_fbrrep-goods.fact-qnty
     4788                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / buf_temp_fbrrep-goods.fact-qnty
     4789                   .
     4790               end.
     4791           end.
     4792       end.
     4793       for each buf_temp_fbrrep-goods
     4794          where buf_temp_fbrrep-goods.deleted = yes
     4795       on error undo, return error
     4796       :
     4797           delete buf_temp_fbrrep-goods.
     4798       end.
     4799       run test-temp-tables in this-procedure .
     4800   end.
     4801   end procedure.
     4802   procedure fbrrep-fill-for-op-del :
     4803   do
     4804   on error undo, return error
     4805   :
     4806   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     4807   define input parameter p-db-remote          as logical          no-undo.
     4808       define variable v-serv-code as character    no-undo.
     4809       define variable v-in-code   as character    no-undo.
     4810       define variable v-out-code  as character    no-undo.
     4811       define variable v-trn-qnty  as decimal       no-undo.
     4812       define variable v-sign      as decimal       no-undo.
     4813       define variable v-qnty      as decimal       no-undo.
     4814       define buffer buf_fbr-doc           for ub.fbr-doc.
     4815       define buffer buf_fbr-line          for ub.fbr-line.
     4816       define buffer buf_goods             for ub.goods .
     4817       define buffer buf_doc-line          for ub.doc-line .
     4818       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods .
     4819       run fbrrep-fill-qnty-and-prices in this-procedure (
     4820           input p-fbr-doc-doc-code
     4821       ).
     4822       for each buf_temp_fbrrep-goods
     4823       on error undo, return error
     4824       :
     4825           if buf_temp_fbrrep-goods.income-qnty <> 0
     4826           or buf_temp_fbrrep-goods.write-off-qnty <> 0
     4827           then do:
     4828               assign
     4829                   v-qnty  = ( buf_temp_fbrrep-goods.write-off-qnty - buf_temp_fbrrep-goods.income-qnty )
     4830               .
     4831               if v-qnty = 0
     4832               then do:
     4833                   find first buf_fbr-line no-lock
     4834                        where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     4835                          and buf_fbr-line.artic       = buf_temp_fbrrep-goods.artic
     4836                          and buf_fbr-line.prod-type   = buf_temp_fbrrep-goods.prod-type
     4837                          and buf_fbr-line.prod-code   = buf_temp_fbrrep-goods.prod-code
     4838                          and buf_fbr-line.fact-qnty   <> 0
     4839                   no-error.
     4840                   if available buf_fbr-line
     4841                   then do:
     4842                       assign
     4843                           buf_temp_fbrrep-goods.cost-rubl     = buf_fbr-line.price-rubl
     4844                           buf_temp_fbrrep-goods.cost-base     = buf_fbr-line.price-base
     4845                           buf_temp_fbrrep-goods.vat-cost-rubl = buf_fbr-line.price-sum-vat-rubl / buf_fbr-line.fact-qnty
     4846                           buf_temp_fbrrep-goods.vat-cost-base = buf_fbr-line.price-sum-vat-base / buf_fbr-line.fact-qnty
     4847                       .
     4848                   end.
     4849                   else do:
     4850                       assign
     4851                           buf_temp_fbrrep-goods.cost-rubl     = 0
     4852                           buf_temp_fbrrep-goods.cost-base     = 0
     4853                           buf_temp_fbrrep-goods.vat-cost-rubl = 0
     4854                           buf_temp_fbrrep-goods.vat-cost-base = 0
     4855                       .
     4856                   end.
     4857               end.
     4858               else do:
     4859                   assign
     4860                       buf_temp_fbrrep-goods.cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl     / v-qnty
     4861                       buf_temp_fbrrep-goods.cost-base     = buf_temp_fbrrep-goods.sum-cost-base     / v-qnty
     4862                       buf_temp_fbrrep-goods.vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl / v-qnty
     4863                       buf_temp_fbrrep-goods.vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base / v-qnty
     4864                   .
     4865               end.
     4866           end.
     4867           else do:
     4868               assign
     4869                   buf_temp_fbrrep-goods.cost-rubl     = 0
     4870                   buf_temp_fbrrep-goods.cost-base     = 0
     4871                   buf_temp_fbrrep-goods.vat-cost-rubl = 0
     4872                   buf_temp_fbrrep-goods.vat-cost-base = 0
     4873               .
     4874           end.
     4875       end.
     4876       for each buf_temp_fbrrep-goods
     4877       :
     4878           if buf_temp_fbrrep-goods.is-waste = yes
     4879           then do:
     4880               assign
     4881                   buf_temp_fbrrep-goods.deleted = yes
     4882               .
     4883           end.
     4884           else do:
     4885               if buf_temp_fbrrep-goods.write-off-qnty <> 0
     4886               and buf_temp_fbrrep-goods.income-qnty <> 0
     4887               then do:
     4888                   if buf_temp_fbrrep-goods.write-off-qnty = buf_temp_fbrrep-goods.income-qnty
     4889                   then do:
     4890                       assign
     4891                           buf_temp_fbrrep-goods.deleted = yes
     4892                       .
     4893                   end.
     4894                   else do:
     4895                       if buf_temp_fbrrep-goods.write-off-qnty > buf_temp_fbrrep-goods.income-qnty
     4896                       then do:
     4897                           assign
     4898                               buf_temp_fbrrep-goods.write-off-qnty    = buf_temp_fbrrep-goods.write-off-qnty - buf_temp_fbrrep-goods.income-qnty
     4899                               buf_temp_fbrrep-goods.income-qnty       = 0
     4900                           .
     4901                       end.
     4902                       else do:
     4903                           assign
     4904                               buf_temp_fbrrep-goods.income-qnty       = buf_temp_fbrrep-goods.income-qnty - buf_temp_fbrrep-goods.write-off-qnty
     4905                               buf_temp_fbrrep-goods.write-off-qnty    = 0
     4906                           .
     4907                       end.
     4908                   end.
     4909               end.
     4910           end.
     4911       end.
     4912       for each buf_temp_fbrrep-goods
     4913          where buf_temp_fbrrep-goods.deleted = yes
     4914       on error undo, return error
     4915       :
     4916           delete buf_temp_fbrrep-goods.
     4917       end.
     4918       run test-temp-tables in this-procedure .
     4919       find first buf_fbr-doc no-lock
     4920            where buf_fbr-doc.doc-code = p-fbr-doc-doc-code
     4921       .
     4922       assign
     4923           v-out-code = p-fbr-doc-doc-code
     4924       .
     4925       run doc-code in this-procedure (
     4926             input  "pair"
     4927           , input  buf_fbr-doc.obj-type
     4928           , input  buf_fbr-doc.obj-code
     4929           , input  v-out-code
     4930           , output v-in-code
     4931       ) no-error.
     4932       if error-status:error
     4933       then do:
     4934           message
     4935                    vss-workfile vss-revision vss-description
     4936               skip "Ошибка вычисления номера приходной накладной."
     4937               skip return-value
     4938               skip trim(error-status :get-message(1))
     4939                    trim(error-status :get-message(2))
     4940                    trim(error-status :get-message(3))
     4941           view-as alert-box error.
     4942           undo, return error .
     4943       end.
     4944       run doc-code in this-procedure (
     4945             input  "trio"
     4946           , input  buf_fbr-doc.obj-type
     4947           , input  buf_fbr-doc.obj-code
     4948           , input  v-in-code
     4949           , output v-serv-code
     4950       ) no-error.
     4951       if error-status:error
     4952       then do:
     4953           message
     4954                    vss-workfile vss-revision vss-description
     4955               skip "Ошибка вычисления номера накладной расхода."
     4956               skip return-value
     4957               skip trim(error-status :get-message(1))
     4958                    trim(error-status :get-message(2))
     4959                    trim(error-status :get-message(3))
     4960           view-as alert-box error.
     4961           undo, return error .
     4962       end.
     4963       for each buf_temp_fbrrep-goods
     4964       on error undo, return error
     4965       :
     4966           if buf_temp_fbrrep-goods.income-qnty > buf_temp_fbrrep-goods.write-off-qnty
     4967           then do:
     4968               find first buf_doc-line no-lock
     4969                    where buf_doc-line.doc-code  = v-in-code
     4970                      and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     4971                      and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     4972                      and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     4973               no-error.
     4974               if available buf_doc-line
     4975               then do:
     4976                   assign
     4977                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty - buf_doc-line.doc-qnty
     4978                   .
     4979               end.
     4980               else do:
     4981                   assign
     4982                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.income-qnty
     4983                   .
     4984               end.
     4985           end.
     4986           else do:
     4987               if buf_temp_fbrrep-goods.is-not-office = no
     4988               then do:
     4989                   find first buf_doc-line no-lock
     4990                        where buf_doc-line.doc-code  = v-serv-code
     4991                          and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     4992                          and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     4993                          and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     4994                   no-error.
     4995               end.
     4996               else do:
     4997                   find first buf_doc-line no-lock
     4998                        where buf_doc-line.doc-code  = v-out-code
     4999                          and buf_doc-line.artic     = buf_temp_fbrrep-goods.artic
     5000                          and buf_doc-line.prod-type = buf_temp_fbrrep-goods.prod-type
     5001                          and buf_doc-line.prod-code = buf_temp_fbrrep-goods.prod-code
     5002                   no-error.
     5003               end.
     5004               if available buf_doc-line
     5005               then do:
     5006                   assign
     5007                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty - buf_doc-line.doc-qnty
     5008                   .
     5009               end.
     5010               else do:
     5011                   assign
     5012                       buf_temp_fbrrep-goods.fact-qnty = buf_temp_fbrrep-goods.write-off-qnty
     5013                   .
     5014               end.
     5015           end.
     5016           if available buf_doc-line
     5017           then do:
     5018               define variable v-void              as decimal       no-undo.
     5019               define variable v-fact-qnty         as decimal       no-undo.
     5020               define variable v-sum-base          as decimal       no-undo.
     5021               define variable v-sum-rubl          as decimal       no-undo.
     5022               define variable v-vat-base          as decimal       no-undo.
     5023               define variable v-vat-rubl          as decimal       no-undo.
     5024               define variable v-slt-base          as decimal       no-undo.
     5025               define variable v-slt-rubl          as decimal       no-undo.
     5026               define variable v-road-tax-base     as decimal       no-undo.
     5027               define variable v-road-tax-rubl     as decimal       no-undo.
     5028               define variable v-transport-base    as decimal       no-undo.
     5029               define variable v-transport-rubl    as decimal       no-undo.
     5030               define variable v-other-base        as decimal       no-undo.
     5031               define variable v-other-rubl        as decimal       no-undo.
     5032               define variable v-excise-base       as decimal       no-undo.
     5033               define variable v-excise-rubl       as decimal       no-undo.
     5034               run r-cost in this-procedure (
     5035                     input buf_doc-line.doc-code
     5036                   , input buf_doc-line.artic
     5037                   , input buf_doc-line.prod-type
     5038                   , input buf_doc-line.prod-code
     5039                   , output v-fact-qnty
     5040                   , output v-void
     5041                   , output v-void
     5042                   , output v-sum-base
     5043                   , output v-sum-rubl
     5044                   , output v-vat-base
     5045                   , output v-vat-rubl
     5046                   , output v-slt-base
     5047                   , output v-slt-rubl
     5048                   , output v-road-tax-base
     5049                   , output v-road-tax-rubl
     5050                   , output v-transport-base
     5051                   , output v-transport-rubl
     5052                   , output v-other-base
     5053                   , output v-other-rubl
     5054                   , output v-excise-base
     5055                   , output v-excise-rubl
     5056               ).
     5057               assign
     5058                   v-sign = ( if v-fact-qnty >= 0 then 1 else -1 )
     5059               .
     5060               assign
     5061                   v-sum-rubl = v-sum-rubl - v-vat-rubl - v-slt-rubl - v-road-tax-rubl - v-transport-rubl - v-other-rubl - v-excise-rubl
     5062                   v-sum-base = v-sum-base - v-vat-base - v-slt-base - v-road-tax-base - v-transport-base - v-other-base - v-excise-base
     5063                   v-sum-rubl = v-sum-rubl   * v-sign
     5064                   v-sum-base = v-sum-base   * v-sign
     5065                   v-vat-rubl = v-vat-rubl   * v-sign
     5066                   v-vat-base = v-vat-base   * v-sign
     5067                   v-fact-qnty = v-fact-qnty * v-sign
     5068               .
     5069               output to "fbrrep.txt" append .
     5070               put unformatted skip(1) v-fact-qnty "   " v-sum-rubl "    " v-vat-rubl.
     5071               output close.
     5072               assign
     5073                   buf_temp_fbrrep-goods.sum-cost-rubl     = absolute( buf_temp_fbrrep-goods.cost-rubl     * v-fact-qnty ) - absolute( v-sum-rubl )
     5074                   buf_temp_fbrrep-goods.sum-cost-base     = absolute( buf_temp_fbrrep-goods.cost-base     * v-fact-qnty ) - absolute( v-sum-base )
     5075                   buf_temp_fbrrep-goods.sum-vat-cost-rubl = absolute( buf_temp_fbrrep-goods.vat-cost-rubl * v-fact-qnty ) - absolute( v-vat-rubl )
     5076                   buf_temp_fbrrep-goods.sum-vat-cost-base = absolute( buf_temp_fbrrep-goods.vat-cost-base * v-fact-qnty ) - absolute( v-vat-base )
     5077               .
     5078               if buf_temp_fbrrep-goods.fact-qnty          = 0
     5079               and buf_temp_fbrrep-goods.sum-cost-rubl     = 0
     5080               and buf_temp_fbrrep-goods.sum-cost-base     = 0
     5081               and buf_temp_fbrrep-goods.sum-vat-cost-rubl = 0
     5082               and buf_temp_fbrrep-goods.sum-vat-cost-base = 0
     5083               then do:
     5084                   assign
     5085                       buf_temp_fbrrep-goods.deleted = yes
     5086                   .
     5087               end.
     5088           end.
     5089       end.
     5090       for each buf_temp_fbrrep-goods
     5091          where buf_temp_fbrrep-goods.deleted = yes
     5092       on error undo, return error
     5093       :
     5094           delete buf_temp_fbrrep-goods.
     5095       end.
     5096       run test-temp-tables in this-procedure .
     5097   end.
     5098   end procedure.
     5099   procedure test-temp-tables :
     5100   do
     5101   on error undo, return error
     5102   :
     5103       define variable v-str   as character     no-undo.
     5104       assign
     5105           v-str = ""
     5106       .
     5107       for each temp_fbrrep-goods
     5108       :
     5109           assign
     5110               v-str = v-str
     5111                   + chr(10) + temp_fbrrep-goods.artic
     5112                   + chr(9) + string( temp_fbrrep-goods.income-qnty )
     5113                   + chr(9) + string( temp_fbrrep-goods.write-off-qnty )
     5114                   + chr(9) + string( temp_fbrrep-goods.cost-rubl )
     5115                   + chr(9) + string( temp_fbrrep-goods.vat-cost-rubl )
     5116                   + chr(9) + string( temp_fbrrep-goods.sum-cost-rubl )
     5117                   + chr(9) + string( temp_fbrrep-goods.sum-vat-cost-rubl )
     5118                   + chr(9) + string( temp_fbrrep-goods.gds-name )
     5119           .
     5120       end.
     5121       output to "fbrrep.txt" append .
     5122       put unformatted skip(2) v-str.
     5123       output close.
     5124   end.
     5125   end procedure.
     5126   procedure fbrrep-test-fbrdoc-for-fact :
     5127   do
     5128   on error undo, return error
     5129   :
     5130   define output parameter p-have-error        as logical      no-undo.
     5131       define buffer buf_fbr-line          for ub.fbr-line.
     5132       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     5133       for each buf_temp_fbrrep-goods
     5134       on error undo, return error
     5135       :
     5136       end.
     5137   end.
     5138   end procedure.
     5139   procedure fbrrep-fill-qnty-and-prices-gds :
     5140   do
     5141   on error undo, return error
     5142   :
     5143   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     5144   define input parameter p-gds-code           as integer      no-undo.
     5145       define variable v-sign      as decimal       no-undo.
     5146       define buffer buf_fbr-line          for ub.fbr-line.
     5147       define buffer buf_goods             for ub.goods.
     5148       define buffer buf_temp_fbrrep-goods for temp_fbrrep-goods.
     5149       find first buf_goods no-lock
     5150            where buf_goods.gds-code = p-gds-code
     5151       .
     5152       find first buf_temp_fbrrep-goods
     5153            where buf_temp_fbrrep-goods.artic     = buf_goods.artic
     5154              and buf_temp_fbrrep-goods.prod-type = buf_goods.prod-type
     5155              and buf_temp_fbrrep-goods.prod-code = buf_goods.prod-code
     5156       use-index ar
     5157       no-error.
     5158       if available buf_temp_fbrrep-goods
     5159       then do:
     5160           delete buf_temp_fbrrep-goods.
     5161       end.
     5162       create buf_temp_fbrrep-goods.
     5163   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5164   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     5165     (input  buf_goods.artic
     5166     ,input  buf_goods.prod-type
     5167     ,input  buf_goods.prod-code
     5168     ,input  'gds-goods=request':u
     5169     ,output buf_temp_fbrrep-goods.is-not-office
     5170     )  .
     5171       assign
     5172           buf_temp_fbrrep-goods.gds-code             = p-gds-code
     5173           buf_temp_fbrrep-goods.artic                = buf_goods.artic
     5174           buf_temp_fbrrep-goods.prod-type            = buf_goods.prod-type
     5175           buf_temp_fbrrep-goods.prod-code            = buf_goods.prod-code
     5176           buf_temp_fbrrep-goods.gds-name             = buf_goods.gds-name
     5177           buf_temp_fbrrep-goods.is-waste             = no
     5178           buf_temp_fbrrep-goods.fact-qnty            = 0
     5179           buf_temp_fbrrep-goods.write-off-rsrv-qnty  = 0
     5180           buf_temp_fbrrep-goods.write-off-qnty       = 0
     5181           buf_temp_fbrrep-goods.income-qnty          = 0
     5182           buf_temp_fbrrep-goods.income-rsrv-qnty     = 0
     5183           buf_temp_fbrrep-goods.cost-rubl            = 0
     5184           buf_temp_fbrrep-goods.cost-base            = 0
     5185           buf_temp_fbrrep-goods.sum-cost-rubl        = 0
     5186           buf_temp_fbrrep-goods.sum-cost-base        = 0
     5187           buf_temp_fbrrep-goods.vat-cost-rubl        = 0
     5188           buf_temp_fbrrep-goods.vat-cost-base        = 0
     5189           buf_temp_fbrrep-goods.sum-vat-cost-rubl    = 0
     5190           buf_temp_fbrrep-goods.sum-vat-cost-base    = 0
     5191           buf_temp_fbrrep-goods.price-sale           = 0
     5192           buf_temp_fbrrep-goods.deleted              = no
     5193       .
     5194   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5195   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     5196     (input  p-gds-code
     5197     ,output buf_temp_fbrrep-goods.unit-base
     5198     )  .
     5199       for each buf_fbr-line no-lock
     5200          where buf_fbr-line.prod-type = buf_goods.prod-type
     5201            and buf_fbr-line.prod-code = buf_goods.prod-code
     5202            and buf_fbr-line.artic     = buf_goods.artic
     5203            and buf_fbr-line.doc-code  = p-fbr-doc-doc-code
     5204       on error undo, return error
     5205       :
     5206           case buf_fbr-line.trn-type
     5207           :
     5208               when 'при':U
     5209               then do:
     5210                   assign
     5211                       v-sign                                          = 1
     5212                       buf_temp_fbrrep-goods.income-qnty               = buf_temp_fbrrep-goods.income-qnty                 + buf_fbr-line.fact-qnty
     5213                       buf_temp_fbrrep-goods.sum-cost-income-rubl      = buf_temp_fbrrep-goods.sum-cost-income-rubl        + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-rubl        else 0 )
     5214                       buf_temp_fbrrep-goods.sum-cost-income-base      = buf_temp_fbrrep-goods.sum-cost-income-base        + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-base        else 0 )
     5215                       buf_temp_fbrrep-goods.sum-vat-cost-income-rubl  = buf_temp_fbrrep-goods.sum-vat-cost-income-rubl    + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-rubl    else 0 )
     5216                       buf_temp_fbrrep-goods.sum-vat-cost-income-base  = buf_temp_fbrrep-goods.sum-vat-cost-income-base    + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-base    else 0 )
     5217                   .
     5218                   if buf_fbr-line.rsrv-qnty <> ?
     5219                   then do:
     5220                       assign
     5221                           buf_temp_fbrrep-goods.income-rsrv-qnty = buf_temp_fbrrep-goods.income-rsrv-qnty   + buf_fbr-line.rsrv-qnty
     5222                       .
     5223                   end.
     5224               end.
     5225               when 'спи':U
     5226               then do:
     5227                   assign
     5228                       v-sign                                  = -1
     5229                       buf_temp_fbrrep-goods.write-off-qnty    = buf_temp_fbrrep-goods.write-off-qnty      + buf_fbr-line.fact-qnty
     5230                       buf_temp_fbrrep-goods.sum-cost-rubl     = buf_temp_fbrrep-goods.sum-cost-rubl       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-rubl        else 0 )
     5231                       buf_temp_fbrrep-goods.sum-cost-base     = buf_temp_fbrrep-goods.sum-cost-base       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-base        else 0 )
     5232                       buf_temp_fbrrep-goods.sum-vat-cost-rubl = buf_temp_fbrrep-goods.sum-vat-cost-rubl   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-rubl    else 0 )
     5233                       buf_temp_fbrrep-goods.sum-vat-cost-base = buf_temp_fbrrep-goods.sum-vat-cost-base   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-base    else 0 )
     5234                   .
     5235                   if buf_fbr-line.rsrv-qnty <> ?
     5236                   then do:
     5237                       assign
     5238                           buf_temp_fbrrep-goods.write-off-rsrv-qnty           = buf_temp_fbrrep-goods.write-off-rsrv-qnty           + buf_fbr-line.rsrv-qnty
     5239                           buf_temp_fbrrep-goods.sum-write-off-rsrv-rubl       = buf_temp_fbrrep-goods.sum-write-off-rsrv-rubl       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-rubl        else 0 )
     5240                           buf_temp_fbrrep-goods.sum-write-off-rsrv-base       = buf_temp_fbrrep-goods.sum-write-off-rsrv-base       + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-base        else 0 )
     5241                           buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-rubl   = buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-rubl   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-rubl    else 0 )
     5242                           buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-base   = buf_temp_fbrrep-goods.sum-write-off-rsrv-vat-base   + ( if buf_fbr-line.price-sum-rubl <> ? then buf_fbr-line.price-sum-vat-base    else 0 )
     5243                       .
     5244                   end.
     5245               end.
     5246           end case.
     5247           assign
     5248               buf_temp_fbrrep-goods.is-waste             = buf_fbr-line.is-waste
     5249               buf_temp_fbrrep-goods.price-sale           = buf_fbr-line.price-sale
     5250               buf_temp_fbrrep-goods.cost-income-rubl     = ( if buf_temp_fbrrep-goods.income-qnty     = 0 then 0 else buf_temp_fbrrep-goods.sum-cost-income-rubl      / buf_temp_fbrrep-goods.income-qnty    )
     5251               buf_temp_fbrrep-goods.cost-income-base     = ( if buf_temp_fbrrep-goods.income-qnty     = 0 then 0 else buf_temp_fbrrep-goods.sum-cost-income-base      / buf_temp_fbrrep-goods.income-qnty    )
     5252               buf_temp_fbrrep-goods.vat-cost-income-rubl = ( if buf_temp_fbrrep-goods.income-qnty     = 0 then 0 else buf_temp_fbrrep-goods.sum-vat-cost-income-rubl  / buf_temp_fbrrep-goods.income-qnty    )
     5253               buf_temp_fbrrep-goods.vat-cost-income-base = ( if buf_temp_fbrrep-goods.income-qnty     = 0 then 0 else buf_temp_fbrrep-goods.sum-vat-cost-income-base  / buf_temp_fbrrep-goods.income-qnty    )
     5254               buf_temp_fbrrep-goods.cost-rubl            = ( if buf_temp_fbrrep-goods.write-off-qnty  = 0 then 0 else buf_temp_fbrrep-goods.sum-cost-rubl             / buf_temp_fbrrep-goods.write-off-qnty )
     5255               buf_temp_fbrrep-goods.cost-base            = ( if buf_temp_fbrrep-goods.write-off-qnty  = 0 then 0 else buf_temp_fbrrep-goods.sum-cost-base             / buf_temp_fbrrep-goods.write-off-qnty )
     5256               buf_temp_fbrrep-goods.vat-cost-rubl        = ( if buf_temp_fbrrep-goods.write-off-qnty  = 0 then 0 else buf_temp_fbrrep-goods.sum-vat-cost-rubl         / buf_temp_fbrrep-goods.write-off-qnty )
     5257               buf_temp_fbrrep-goods.vat-cost-base        = ( if buf_temp_fbrrep-goods.write-off-qnty  = 0 then 0 else buf_temp_fbrrep-goods.sum-vat-cost-base         / buf_temp_fbrrep-goods.write-off-qnty )
     5258           .
     5259       end.
     5260       run test-temp-tables in this-procedure .
     5261   end.
     5262   end procedure.
     5263   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5264   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5265       def var log-file-name as char no-undo.
     5266       if search('fbr.log') = ?
     5267       then do:
     5268           assign
     5269               log-file-name = ""
     5270           .
     5271       end.
     5272       else do:
     5273           assign
     5274               log-file-name = 'fbr.log'
     5275           .
     5276       end.
     5277       DEF STREAM stm-log.
     5278       PROCEDURE writelog:
     5279       DEF INPUT PARAMETER p-file-name AS CHAR     NO-UNDO.
     5280       DEF INPUT PARAMETER p-log-level AS INTEGER  NO-UNDO.
     5281       DEF INPUT PARAMETER p-log-string  AS CHAR     NO-UNDO.
     5282       if p-file-name <> ""
     5283       then do:
     5284       OUTPUT STREAM stm-log TO VALUE(p-file-name) APPEND.
     5285           PUT STREAM stm-log UNFORMATTED chr(10).
     5286           PUT STREAM stm-log UNFORMATTED (IF (p-log-level = 0 OR p-log-string = "&DLine"
     5287                                           OR p-log-string = "&Line") THEN "" ELSE
     5288                                           cur-time-string-sec() + " ").
     5289           PUT STREAM stm-log UNFORMATTED
     5290                   (IF p-log-string = "&Line" THEN FILL("-", 80)
     5291                   ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
     5292                   ELSE fill(" ", p-log-level * 2) + p-log-string).
     5293       OUTPUT STREAM stm-log CLOSE.
     5294       end.
     5295       END PROCEDURE.
     5296       define variable v-all-reserved  as logical init yes      no-undo.
     5297       define variable v-write-off-sum-price-rubl      as decimal      no-undo.
     5298       define variable v-write-off-sum-price-base      as decimal      no-undo.
     5299       define variable v-write-off-sum-vat-price-rubl  as decimal      no-undo.
     5300       define variable v-write-off-sum-vat-price-base  as decimal      no-undo.
