     5350           ).
     5351           run writelog in this-procedure (
     5352                 input log-file-name
     5353               , input 2
     5354               , input substitute( "Товары, которые надо переместить на кухню ( &1 &2 ) со склада ( &3 &4 )"
     5355                                   , buf_fbr-doc.obj-type
     5356                                   , buf_fbr-doc.obj-code
     5357                                   , v-store-obj-type
     5358                                   , v-store-obj-code
