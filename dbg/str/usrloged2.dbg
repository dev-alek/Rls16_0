        1   define input  parameter parparentproc               as widget-handle no-undo .
        2   define input  parameter p-input-mode                as character no-undo .
        3   define input-output parameter p-db-num                    as integer   no-undo .
        4   define input  parameter p-user-id                   as character no-undo .
        5   define input  parameter p-user-login                as character no-undo .
        6   define input  parameter p-user-administrator        as logical   no-undo .
        7   define input  parameter p-max-discnt                as decimal   no-undo .
        8   define input  parameter p-quest-print               as logical   no-undo .
        9   define output parameter p-list-db                   as character  no-undo .
       10   define output parameter v-update-data               as logical   no-undo .
       11   define output parameter v-output-user-login         as character no-undo .
       12   define output parameter v-output-user-administrator as logical   no-undo .
       13   define output parameter v-output-max-discnt         as decimal   no-undo .
       14   define output parameter v-output-quest-print        as logical   no-undo .
       15   define variable vss-revision    as character no-undo init "$Revision$":U .
       16   define variable vss-author      as character no-undo init "$Author$":U .
       17   define variable vss-date        as character no-undo init "$Date$":U .
       18   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       19   define variable vss-archive     as character no-undo init "$Archive$":U .
       20   define variable vss-description as character no-undo init "Редактирование данных для логина пользователя".
       21   procedure vss-get-info :
       22     define output parameter p-vss-revision    like vss-revision    no-undo .
       23     define output parameter p-vss-author      like vss-author      no-undo .
       24     define output parameter p-vss-date        like vss-date        no-undo .
       25     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       26     define output parameter p-vss-archive     like vss-archive     no-undo .
       27     define output parameter p-vss-description like vss-description no-undo .
       28     assign
       29       p-vss-revision    = vss-revision
       30       p-vss-author      = vss-author
       31       p-vss-date        = vss-date
       32       p-vss-workfile    = vss-workfile
       33       p-vss-archive     = vss-archive
       34       p-vss-description = vss-description
       35     .
       36   end procedure.
       37   procedure vss-get-parameters :
       38     define output parameter p-vss-parameters as character no-undo .
       39   end procedure.
       40   define new global shared variable g#vssrevis-logger as handle    no-undo .
       41   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       42   define variable v-vssrevis-logger                   as handle    no-undo .
       43   procedure vss-logevent :
       44     define input  parameter p-extra-paramters as character no-undo .
       45     define variable v-vssrevis-parameters as character no-undo .
       46     do
       47     on error undo, return error return-value
       48     :
       49       if  valid-handle(v-vssrevis-logger)
       50       and v-vssrevis-logger :get-signature("logevent") <> ""
       51       then do:
       52         run vss-get-parameters in this-procedure
       53           (output v-vssrevis-parameters
       54           ).
       55         run logevent in v-vssrevis-logger
       56           (input vss-workfile
       57           ,input vss-revision
       58           ,input v-vssrevis-parameters
       59           ,input p-extra-paramters
       60           ).
       61       end.
       62     end.
       63   end procedure.
       64   assign
       65     v-vssrevis-logger = g#vssrevis-logger
       66   .
       67   if  valid-handle(v-vssrevis-logger)
       68   and v-vssrevis-logger :get-signature("logevent") <> ""
       69   then do:
       70     assign
       71       v-vssrevis-logevent = true
       72     .
       73     run vss-logevent in this-procedure (input vss-description) .
       74   end.
       75   procedure proc-alt-shift-f2:
       76     if not ibs.th.gbl.gbl-var:rcode
       77   then
       78     run gbl\inidebug.p .
       79   end.
       80   procedure proc-alt-shift-f3:
       81     run gbl/prvssinf.p
       82       ( input this-procedure
       83       ) .
       84   end.
       85   define variable v-inform-launched as logical no-undo initial false .
       86   procedure proc-alt-shift-f4:
       87     define variable v-action as character no-undo .
       88     if v-inform-launched = false then do:
       89       assign
       90         v-inform-launched = true
       91       .
       92       run gbl/d-inform.w
       93         (  input self
       94         ,  input this-procedure
       95         , output v-action
       96         ) no-error .
       97       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       98       assign
       99         v-inform-launched = false
      100       .
      101     end.
      102   end.
      103   procedure proc-alt-f1:
      104     run gbl/corrhelp.p
      105       (input this-procedure
      106       ) .
      107   end .
      108   on alt-shift-f2 anywhere do:
      109     run proc-alt-shift-f2.
      110   end.
      111   on alt-shift-f3 anywhere do:
      112     run proc-alt-shift-f3 in this-procedure .
      113   end.
      114   on alt-shift-f4 anywhere do:
      115     run proc-alt-shift-f4 in this-procedure.
      116   end.
      117   on alt-f1 anywhere do:
      118     run proc-alt-f1 in this-procedure .
      119   end.
      120   define new global shared variable g#language as character no-undo .
      121   if g#language <> '' and g#language <> 'rus':U then do:
      122     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      123   end.
      124   DEFINE BUTTON b-exit AUTO-GO
      125        LABEL "&Ввод"
      126        SIZE 10 BY 1
      127        BGCOLOR 8 .
      128   DEFINE BUTTON b-help
      129        LABEL "Помо&щь"
      130        SIZE 10 BY 1
      131        BGCOLOR 8 .
      132   DEFINE BUTTON b-quit AUTO-END-KEY
      133        LABEL "&Отмена"
      134        SIZE 10 BY 1
      135        BGCOLOR 8 .
      136   DEFINE VARIABLE fi-db-num LIKE user-login.db-num
      137        VIEW-AS FILL-IN
      138        SIZE 6 BY 1
      139        FGCOLOR 4  NO-UNDO.
      140   DEFINE VARIABLE fi-max-discnt LIKE user-login.max-discnt
      141        VIEW-AS FILL-IN
      142        SIZE 7 BY 1 NO-UNDO.
      143   DEFINE VARIABLE fi-user-id LIKE user-login.user-id
      144        VIEW-AS FILL-IN
      145        SIZE 16 BY 1
      146        FGCOLOR 4  NO-UNDO.
      147   DEFINE VARIABLE fi-user-login LIKE user-login.user-login
      148        VIEW-AS FILL-IN
      149        SIZE 13 BY 1 NO-UNDO.
      150   DEFINE VARIABLE sel-dbs AS CHARACTER
      151        VIEW-AS SELECTION-LIST MULTIPLE SCROLLBAR-VERTICAL
      152        SIZE 9.5 BY 7.5 NO-UNDO.
      153   DEFINE VARIABLE t-quest-print LIKE user-login.quest-print
      154        VIEW-AS TOGGLE-BOX
      155        SIZE 43.13 BY .83 NO-UNDO.
      156   DEFINE VARIABLE t-user-administrator LIKE user-login.user-administrator
      157        VIEW-AS TOGGLE-BOX
      158        SIZE 16.13 BY .83 NO-UNDO.
      159   DEFINE FRAME Dialog-Frame
      160        b-exit AT ROW 1 COL 1
      161        b-quit AT ROW 1 COL 11
      162        b-help AT ROW 1 COL 73
      163        sel-dbs AT ROW 2.5 COL 71.5 NO-LABEL WIDGET-ID 24
      164        fi-db-num AT ROW 2.75 COL 25.5 COLON-ALIGNED HELP
      165             "" WIDGET-ID 2
      166             FGCOLOR 4
      167        fi-user-id AT ROW 4 COL 25.5 COLON-ALIGNED HELP
      168             "" WIDGET-ID 4
      169             FGCOLOR 4
      170        fi-user-login AT ROW 6.75 COL 25.5 COLON-ALIGNED HELP
      171             "" WIDGET-ID 6
      172        t-user-administrator AT ROW 8 COL 27.5 HELP
      173             "" WIDGET-ID 14
      174        fi-max-discnt AT ROW 9 COL 25.5 COLON-ALIGNED HELP
      175             "" WIDGET-ID 10
      176        t-quest-print AT ROW 10.25 COL 27.5 HELP
      177             "" WIDGET-ID 16
      178        "БД для копирования:" VIEW-AS TEXT
      179             SIZE 20.5 BY 1 AT ROW 2.5 COL 50 WIDGET-ID 48
      180             FGCOLOR 4
      181        SPACE(13.62) SKIP(8.78)
      182       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      183            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      184            TITLE "Логин пользователя"
      185            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit WIDGET-ID 100.
      186   ASSIGN
      187          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      188          FRAME Dialog-Frame:HIDDEN           = TRUE.
      189   ASSIGN
      190          t-user-administrator:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      191   ON GO OF FRAME Dialog-Frame
      192   DO:
      193     p-list-db = sel-dbs .
      194     run update-record in this-procedure
      195       no-error .
      196     if error-status :error
      197     then do:
      198       return no-apply .
      199     end.
      200   END.
      201   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      202   DO:
      203     APPLY "END-ERROR":U TO SELF.
      204   END.
      205   ON LEAVE OF fi-db-num IN FRAME Dialog-Frame
      206   DO:
      207     define buffer buf_db for ub.db.
      208     if fi-db-num <> ? and
      209      not can-find (buf_db where buf_db.db-num = input frame Dialog-Frame fi-db-num no-lock ) then do:
      210       message "Нет БД с таким номером."
      211               view-as alert-box error.
      212       assign
      213         fi-db-num = ?
      214         p-db-num  = ?.
      215       display
      216       ? @ fi-db-num
      217       with frame Dialog-Frame.
      218     end.
      219   END.
      220   ON VALUE-CHANGED OF fi-db-num IN FRAME Dialog-Frame
      221   DO:
      222       assign
      223           fi-db-num
      224       .
      225   END.
      226   ON VALUE-CHANGED OF sel-dbs IN FRAME Dialog-Frame
      227   DO:
      228     assign
      229     sel-dbs
      230     .
      231   END.
      232   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      233   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      234   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      235   on help of frame Dialog-Frame
      236   do:
      237     run gbl/app_help.p
      238       (input this-procedure :file-name
      239       ,input ''
      240       ,input ?
      241       ) no-error.
      242     if error-status :error then do:
      243       message
      244         "Ошибка при вызове помощи"
      245         error-status :get-message(1)
      246         view-as alert-box .
      247     end.
      248   end.
      249   run minbtn-set in this-procedure .
      250   on choose of b-help in frame Dialog-Frame
      251   do:
      252     apply "help":u to frame Dialog-Frame .
      253   end.
      254   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      255   procedure minbtn-set :
      256       do
      257           on error undo, return error return-value
      258           :
      259           define variable ii              as integer       no-undo .
      260           define variable fh              as widget-handle no-undo .
      261           define variable hh              as widget-handle no-undo .
      262           define variable v-h             as handle        extent 4 no-undo .
      263           define variable v-name-button   as character     no-undo .
      264           define variable v-help-old-x    as decimal       no-undo .
      265           define variable v-help-old-y    as decimal       no-undo .
      266           define variable v-help-old-size as decimal       no-undo .
      267           define variable v-frame-width   as decimal       no-undo .
      268           define variable jj              as integer       no-undo .
      269           do
      270               on error undo, return error
      271               :
      272               assign
      273                   v-frame-width = frame Dialog-Frame:width - 0.3
      274                   fh            = frame Dialog-Frame:first-child
      275                   hh            = fh:first-child
      276                   ii            = 1
      277                   .
      278               do while valid-handle(hh):
      279                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      280                   do:
      281                       case lc(hh:name) :
      282                           when "b-help" then
      283                               do:
      284                                   hh:load-image-up("cmp/b-help.bmp":u) .
      285                                   hh:load-image-down("cmp/b-help.bmp":u) .
      286                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      287                                   hh:TOOLTIP = "Помощь" .
      288                                   v-help-old-x = hh:column .
      289                                   v-help-old-y = hh:row    .
      290                                   v-help-old-size = hh:width .
      291                                   hh:width-chars = 2.5 .
      292                               end.
      293                           when "b-print" then
      294                               do:
      295                                   hh:load-image("cmp/b-print.bmp":u) .
      296                                   hh:TOOLTIP = "Печать" .
      297                                   v-h[ii] = hh:handle .
      298                                   ii = ii + 1 .
      299                                   hh:width-chars = 3 .
      300                               end.
      301                           when "b-history" or
      302                           when "b-hist" then
      303                               do:
      304                                   hh:load-image("cmp/b-hist.bmp":u) .
      305                                   hh:TOOLTIP = "История" .
      306                                   v-h[ii] = hh:handle .
      307                                   ii = ii + 1 .
      308                                   hh:width-chars = 3 .
      309                               end.
      310                           when "b-sch" then
      311                               do:
      312                                   hh:load-image("cmp/b-sch.bmp":u) .
      313                                   hh:TOOLTIP = "Установка Фильтра" .
      314                                   v-h[ii] = hh:handle .
      315                                   ii = ii + 1 .
      316                                   hh:width-chars = 3 .
      317                               end.
      318                           when "b-hist-user" then
      319                               do:
      320                                   hh:load-image("cmp/b-hist.bmp":u) .
      321                                   hh:TOOLTIP = "История пользователя" .
      322                                   ii = ii + 1 .
      323                               end.
      324                       end case.
      325                   end.
      326                   hh = hh:next-sibling.
      327               end.
      328               b-help:column = v-frame-width - b-help:width-chars.
      329               jj = 0.
      330               repeat ii = 4 to 1 by -1 :
      331                   if valid-handle (v-h[ii] ) then
      332                   do:
      333                       jj  = jj + 1 .
      334                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      335                       v-h[ii]:row    = v-help-old-y .
      336                   end.
      337               end.
      338           end.
      339       end.
      340   end procedure.
      341   MAIN-BLOCK:
      342   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      343      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      344     run init-fields in this-procedure .
      345     RUN enable_UI.
      346     run display-data in this-procedure .
      347     run enable-fields in this-procedure .
      348     WAIT-FOR GO OF FRAME Dialog-Frame.
      349   END.
      350   RUN disable_UI.
      351   PROCEDURE disable_UI :
      352     HIDE FRAME Dialog-Frame.
      353   END PROCEDURE.
      354   PROCEDURE display-data :
      355     define buffer buf_user-account for ub.user-account .
      356     do
      357     on error undo, return error return-value
      358     :
      359       do with frame Dialog-Frame
      360       :
      361         assign
      362           fi-user-id            = p-user-id
      363           fi-user-login         = p-user-login
      364           t-user-administrator  = p-user-administrator
      365           fi-max-discnt         = p-max-discnt
      366           t-quest-print         = p-quest-print
      367         .
      368           fi-db-num = p-db-num .
      369         display
      370           fi-db-num
      371           fi-user-id
      372           fi-user-login
      373           fi-max-discnt
      374           t-quest-print
      375           with frame Dialog-Frame .
      376       end.
      377     end.
      378   END PROCEDURE.
      379   PROCEDURE enable-fields :
      380     do
      381     on error undo, return error return-value
      382     :
      383       do with frame Dialog-Frame
      384       :
      385         if p-input-mode = 'ИЗМЕНЕНИЕ':U
      386         then do:
      387           assign
      388             fi-user-login        :sensitive = true
      389             t-user-administrator :sensitive = true
      390             fi-max-discnt        :sensitive = true
      391             t-quest-print        :sensitive = true
      392           .
      393         end.
      394         else do:
      395           assign
      396             fi-user-login        :sensitive = false
      397             t-user-administrator :sensitive = false
      398             fi-max-discnt        :sensitive = false
      399             t-quest-print        :sensitive = false
      400           .
      401         end.
      402       end.
      403     end.
      404   END PROCEDURE.
      405   PROCEDURE enable_UI :
      406     DISPLAY sel-dbs fi-db-num fi-user-id fi-user-login fi-max-discnt t-quest-print
      407         WITH FRAME Dialog-Frame.
      408     ENABLE b-exit b-quit b-help sel-dbs
      409         WITH FRAME Dialog-Frame.
      410     VIEW FRAME Dialog-Frame.
      411   END PROCEDURE.
      412   PROCEDURE update-record :
      413     define buffer buf_user-login for ub.user-login .
      414     do
      415     on error undo, return error return-value
      416     :
      417       do with frame Dialog-Frame
      418       :
      419         assign
      420           fi-user-login
      421           t-user-administrator
      422           fi-max-discnt
      423           t-quest-print
      424         .
      425         if fi-user-login = ?
      426         or fi-user-login = '':U
      427         then do:
      428           message
      429             "Необходимо ввести логин пользователя" skip
      430             view-as alert-box error .
      431           apply 'entry':U to fi-user-login .
      432           undo, return error return-value .
      433         end.
      434         if fi-db-num = ?
      435         then do:
      436           message
      437             "Необходимо ввести номер базы данных" skip
      438             view-as alert-box error .
      439           apply 'entry':U to fi-db-num .
      440           undo, return error return-value .
      441         end.
      442         find first buf_user-login no-lock
      443           where buf_user-login.db-num = fi-db-num
      444             and buf_user-login.user-login = fi-user-login
      445             and buf_user-login.user-id <> p-user-id
      446           no-error .
      447         if available buf_user-login
      448         then do:
      449           message
      450             "У другого пользователя уже существует логин" fi-user-login skip
      451             "для БД" fi-db-num SKIP
      452             view-as alert-box error .
      453           apply 'entry':U to fi-user-login .
      454           undo, return error return-value .
      455         end.
      456         find first buf_user-login no-lock
      457           where buf_user-login.db-num = fi-db-num
      458             and buf_user-login.user-id = p-user-id
      459           no-error .
      460         if available buf_user-login and p-user-login =  "" or
      461            available buf_user-login and p-user-login <> ""  and p-db-num <> fi-db-num
      462         then do:
      463           message
      464             "У пользователя уже существует логин" buf_user-login.user-login skip
      465             "для БД" fi-db-num SKIP
      466             view-as alert-box error .
      467           apply 'entry':U to fi-user-login .
      468           undo, return error return-value .
      469         end.
      470         assign
      471           v-update-data               = true
      472           v-output-user-login         = fi-user-login
      473           v-output-user-administrator = t-user-administrator
      474           v-output-max-discnt         = fi-max-discnt
      475           v-output-quest-print        = t-quest-print
      476           p-db-num                    = fi-db-num
      477         .
      478       end.
      479     end.
      480   END PROCEDURE.
      481   PROCEDURE init-fields :
      482     define buffer buf_sys-ctrl for ub.sys-ctrl .
      483     define buffer buf_db       for db .
      484     define variable v-db-list as character no-undo .
      485     do
      486       with frame Dialog-Frame
      487       on error undo, return error
      488       :
      489         v-db-list = "ВСЕ" .
      490         For each buf_db where buf_db.db-num <> 0 no-LOCK:
      491           assign
      492             v-db-list = substitute( "&1&2&3", v-db-list, chr(44), buf_db.db-num )
      493             .
      494         end.
      495       assign
      496         sel-dbs :list-items in frame Dialog-Frame = v-db-list  .
      497       .
      498     end.
      499   END PROCEDURE.
