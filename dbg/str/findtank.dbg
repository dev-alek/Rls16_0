        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: 3e76a53baf4c, 1133, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: SMMolotkov $":U .
        4   define variable vss-date        as character no-undo init "$Date: Thu Dec 14 02:13:54 2017 +0300 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: findtank.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: str/findtank.p $":U .
        7   define variable vss-description as character no-undo init "Поиск резервуара и пистолета по марке топлива".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   define new global shared variable g#library  as handle no-undo .
       13   define new global shared variable g#library2 as handle no-undo .
       14   define   shared variable g#auto as logical no-undo.
       15   define   shared variable g#news as logical no-undo.
       16   define   shared variable g#oxml as logical no-undo.
       17   define   shared variable g#esys as logical no-undo.
       18   define   shared variable g#news-source-db as integer no-undo.
       19   define   shared variable g#esys-source-esys as integer no-undo.
       20   define   shared variable g#db-num as integer   no-undo .
       21   define   shared variable g#userid as character no-undo .
       22   define   shared variable g#passwd as character no-undo .
       23   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       24   procedure findtank:
       25     define input  parameter p-obj-type     as character no-undo.
       26     define input  parameter p-obj-code     as integer   no-undo.
       27     define input  parameter p-pump-code    as integer   no-undo.
       28     define input  parameter p-nozzle-code  as integer   no-undo .
       29     define input  parameter p-from-pl-code as integer   no-undo .
       30     define input  parameter p-gds-code     as integer   no-undo.
       31     define output parameter p-pl-code      as integer   no-undo .
       32     define variable v-pl-code            like ub.place.pl-code no-undo .
       33     define variable v-dopstr             as character no-undo .
       34     define buffer buf_place for ub.place.
       35     define buffer buf_pl-gds-pump for ub.pl-gds-pump.
       36     define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle.
       37     define buffer buf_pl-gds for ub.pl-gds.
       38     do
       39     on error undo, return error return-value
       40     :
       41       assign
       42         v-pl-code = 0
       43         p-pl-code = ?
       44       .
       45       if p-from-pl-code <> ?
       46         and p-from-pl-code <> 0
       47       then do:
       48         find first buf_pl-gds no-lock
       49           where buf_pl-gds.obj-type  = p-obj-type
       50             and buf_pl-gds.obj-code  = p-obj-code
       51             and buf_pl-gds.pl-code   = p-from-pl-code
       52             and buf_pl-gds.gds-code  = p-gds-code
       53           no-error.
       54         if available buf_pl-gds then do:
       55           assign
       56             v-pl-code = buf_pl-gds.pl-code
       57           .
       58         end.
       59       end.
       60       if v-pl-code <> 0
       61         and p-nozzle-code <> ?
       62         and p-nozzle-code <> 0
       63       then do:
       64         find first buf_pl-pump-nozzle no-lock
       65           where buf_pl-pump-nozzle.obj-type    = p-obj-type
       66             and buf_pl-pump-nozzle.obj-code    = p-obj-code
       67             and buf_pl-pump-nozzle.pl-code     = v-pl-code
       68             and buf_pl-pump-nozzle.pump-code   = p-pump-code
       69             and buf_pl-pump-nozzle.nozzle-code = p-nozzle-code
       70           no-error .
       71         if not available buf_pl-pump-nozzle then do:
       72           return.
       73         end.
       74       end.
       75       if v-pl-code = 0 then do:
       76         if p-nozzle-code = 0 then do:
       77           find first buf_pl-gds-pump no-lock
       78             where buf_pl-gds-pump.obj-type  = p-obj-type
       79               and buf_pl-gds-pump.obj-code  = p-obj-code
       80               and buf_pl-gds-pump.pump-code = p-pump-code
       81               and buf_pl-gds-pump.gds-code  = p-gds-code
       82               and buf_pl-gds-pump.status_   = 'тек':U
       83             no-error.
       84           if available buf_pl-gds-pump then do:
       85             assign
       86               v-pl-code = buf_pl-gds-pump.pl-code
       87             .
       88           end.
       89         end.
       90         else do:
       91           _ppnz:
       92           for each buf_pl-pump-nozzle no-lock
       93             where buf_pl-pump-nozzle.obj-type = p-obj-type
       94               and buf_pl-pump-nozzle.obj-code = p-obj-code
       95               and buf_pl-pump-nozzle.pump-code = p-pump-code
       96               and buf_pl-pump-nozzle.nozzle-code = p-nozzle-code
       97             ,first buf_pl-gds-pump no-lock
       98             where buf_pl-gds-pump.obj-type  = p-obj-type
       99               and buf_pl-gds-pump.obj-code  = p-obj-code
      100               and buf_pl-gds-pump.pump-code = p-pump-code
      101               and buf_pl-gds-pump.gds-code  = p-gds-code
      102               and buf_pl-gds-pump.status_   = 'тек':U
      103               and buf_pl-gds-pump.pl-code   = buf_pl-pump-nozzle.pl-code
      104           on error undo, return error return-value
      105           :
      106             assign
      107               v-pl-code = buf_pl-pump-nozzle.pl-code
      108             .
      109             leave _ppnz.
      110           end.
      111         end.
      112       end.
      113       if v-pl-code <> 0 then do:
      114         assign
      115           p-pl-code = v-pl-code
      116         .
      117       end.
      118     end.
      119   end procedure.
      120   procedure find-nzl:
      121   define input  parameter p-obj-type   as character no-undo.
      122   define input  parameter p-obj-code   as integer   no-undo.
      123   define input  parameter p-pump-code  as integer   no-undo.
      124   define input  parameter p-gds-code   as integer   no-undo.
      125   define input  parameter p-pl-code    as integer no-undo .
      126   define output parameter p-nozzle-code    as integer   no-undo.
      127   define variable v-nozzle-code        like ub.nozzle.nozzle-code no-undo .
      128   define variable v-pl-code            like ub.place.pl-code no-undo .
      129   define variable v-pump-code          like ub.pump.pump-code no-undo .
      130   define variable v-loc1-code          like ub.place.loc1 no-undo .
      131   define variable v-dopstr             as character no-undo .
      132   define buffer buf_place for ub.place.
      133   define buffer buf_pl-gds-pump for ub.pl-gds-pump.
      134   define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle.
      135   define buffer buf_pl-gds for ub.pl-gds.
      136   do on error undo, return error return-value :
      137     v-pump-code = p-pump-code.
      138     find first buf_pl-pump-nozzle no-lock where
      139                   buf_pl-pump-nozzle.obj-type = p-obj-type
      140               and buf_pl-pump-nozzle.obj-code = p-obj-code
      141               and buf_pl-pump-nozzle.pump-code = p-pump-code
      142               and buf_pl-pump-nozzle.pl-code = p-pl-code no-error.
      143     if not available buf_pl-pump-nozzle then do:
      144       assign
      145       p-nozzle-code = ?.
      146       return .
      147     end.
      148     assign
      149     p-nozzle-code = buf_pl-pump-nozzle.nozzle-code.
      150     return.
      151     .
      152   end.
      153   end procedure.
      154   procedure find-nzl-without-pl:
      155   define input  parameter p-obj-type   as character no-undo.
      156   define input  parameter p-obj-code   as integer   no-undo.
      157   define input  parameter p-pump-code  as integer   no-undo.
      158   define input  parameter p-gds-code   as integer   no-undo.
      159   define output parameter p-nozzle-code    as integer   no-undo.
      160   define buffer buf_pl-gds-pump for ub.pl-gds-pump.
      161   define buffer buf_pl-gds for ub.pl-gds.
      162   define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle.
      163   do on error undo, return error return-value :
      164     for each buf_pl-gds-pump no-lock where
      165               buf_pl-gds-pump.obj-type  = p-obj-type
      166           and buf_pl-gds-pump.obj-code  = p-obj-code
      167           and buf_pl-gds-pump.pump-code = p-pump-code
      168           and buf_pl-gds-pump.gds-code  = p-gds-code
      169           and buf_pl-gds-pump.status_   = 'тек':U,
      170         first buf_pl-gds no-lock where
      171                   buf_pl-gds.obj-type = p-obj-type
      172               AND buf_pl-gds.obj-code = p-obj-code
      173               AND buf_pl-gds.pl-code = buf_pl-gds-pump.pl-code
      174               AND buf_pl-gds.gds-code = p-gds-code
      175               AND buf_pl-gds.status_ = 'тек':U,
      176        first buf_pl-pump-nozzle no-lock where
      177                 buf_pl-pump-nozzle.obj-type = p-obj-type
      178             and buf_pl-pump-nozzle.obj-code = p-obj-code
      179             and buf_pl-pump-nozzle.pl-code = buf_pl-gds.pl-code
      180             and buf_pl-pump-nozzle.pump-code = p-pump-code:
      181       assign
      182       p-nozzle-code = buf_pl-pump-nozzle.nozzle-code.
      183       return .
      184     end.
      185     assign
      186     p-nozzle-code = ?.
      187     return.
      188     .
      189   end.
      190   end procedure.
