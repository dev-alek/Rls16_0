      358   define  stream PrnLibStream.
      359   procedure prn-lib-prn-file :
      360     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      361     define input parameter p-DIsabledoptions as integer no-undo .
      362     define variable v-report-name as character no-undo .
      363     define variable v-user-action as character no-undo .
      364     define variable v-printed     as logical   no-undo .
      365     define variable v-exist       as logical   no-undo .
      366     do
      367       on error undo, return error
      368       :
      369       run prn-lib-get-report-name  in this-procedure (
      370         input parParentProc
      371         ,output v-report-name
      372         ).
      373   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      374   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      375     (input  v-report-name
      376     ,input  2
      377     ,output v-exist
      378     )  .
      379       if NOT v-exist then
      380       DO:
      381         Message
      382           "Нет заданий на печать ! "
      383           view-as alert-box .
      384         Return  .
      385       End.
      386       run gbl/prnfilen.w
      387         (input  ""
      388         ,input  p-DisabledOptions
      389         ,input  string(v-report-name )
      390         ,input  7
      391         ,output v-user-action
      392         ,output v-printed
      393         ) .
      394       if v-printed then
      395       do:
      396         return "YES" .
      397       end.
      398       else
      399       do:
      400         return "NO" .
      401       end.
      402     end.
      403   end procedure.
      404   procedure prn-lib-open-stream :
      405     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      406     define input parameter p-page-size    as integer no-undo .
      407     define input parameter p-is-stream    as logical no-undo .
      408     define input parameter p-append       as logical no-undo .
      409     define variable v-report-name as character no-undo .
      410     do
      411       on error undo, return error
      412       :
      413       run prn-lib-get-report-name  in this-procedure (
      414         input parParentProc
      415         ,output v-report-name
      416         ).
      417       if p-is-stream then
      418       do:
      419         if p-append then
      420         do:
      421           output stream PrnLibStream to value( v-report-name )
      422             page-size value(p-page-size) append .
      423         end.
      424         if not p-append then
      425         do:
      426           output stream PrnLibStream to value( v-report-name )
      427             page-size value(p-page-size) .
      428         end.
      429       end.
      430       if not p-is-stream then
      431       do:
      432         if p-append then
      433         do:
      434           output to value( v-report-name )
      435             page-size value(p-page-size) append .
      436         end.
      437         if not p-append then
      438         do:
      439           output to value( v-report-name )
      440             page-size value(p-page-size) .
      441         end.
      442       end.
      443     end.
      444   end procedure.
      445   procedure prn-lib-open-exp :
      446     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      447     define input parameter p-is-stream    as logical no-undo .
      448     define input parameter p-is-append    as logical no-undo .
      449     define output parameter p-ReportFileName as char init "report" no-undo.
      450     define output parameter p-process as logical no-undo .
      451     define variable glog as logical no-undo .
      452     do
      453       on error undo, return error
      454       :
      455       SYSTEM-DIALOG GET-FILE p-ReportFileName
      456         TITLE      "Укажите путь"
      457         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      458         ASK-OVERWRITE
      459         CREATE-TEST-FILE
      460         SAVE-AS
      461         USE-FILENAME
      462         DEFAULT-EXTENSION "txt"
      463         UPDATE glog
      464         .
      465       if not glog then  return.
      466       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      467       if p-is-stream then
      468       do:
      469         if p-is-append then
      470         do:
      471           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      472         end.
      473         else
      474         do:
      475           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      476         end.
      477       end.
      478       else
      479       do:
      480         if p-is-append then
      481         do:
      482           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      483         end.
      484         else
      485         do:
      486           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      487         end.
      488       end.
      489       p-process = yes.
      490     end.
      491   end procedure.
      492   procedure prn-lib-get-report-name :
      493     define input parameter parParentProc  as widget-handle no-undo.
      494     define output parameter p-report-name as character no-undo .
      495     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      496   end procedure.
      497   procedure prn-lib-reportviewer-report-name :
      498     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      499     define input parameter p-report-name-html as character no-undo .
      500     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      501   end procedure.
      502   procedure prn-lib-reportviewer :
      503     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      504     define input parameter p-report-name-html as character no-undo .
      505     define input parameter p-param        as character no-undo .
      506     define variable v-excel           as character no-undo init 'TRUE' .
      507     define variable v-value-character as character no-undo .
      508     define variable v-value-integer   as character no-undo .
      509     define variable v-value-date      as date      no-undo .
      510     define variable v-value-decimal   as decimal   no-undo .
      511     define variable rep-excel         as logical   no-undo .
      512     define variable excel-string      as character no-undo .
      513     define variable v-param-type      as character no-undo .
      514     define variable v-tth             as handle    no-undo .
      515     run adm/shattri.p (
      516       input "get":U
      517       ,input  ""
      518       ,input  0
      519       ,input  'report-glob':U
      520       ,input  'rep-excel':U
      521       ,output v-value-character
      522       ,output v-value-date
      523       ,output v-value-decimal
      524       ,output v-value-integer
      525       ,output rep-excel
      526       ,output v-param-type
      527       ,INPUT-OUTPUT table-handle v-tth
      528       )  .
      529     if rep-excel then v-excel = "TRUE" .
      530     else v-excel = "FALSE" .
      531     if p-param eq ""
      532     then
      533        p-param = "EXCEL:" + v-excel.
      534     else
      535        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      536     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      537   end procedure.
      538   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      539   define variable v-waitfram-action01         as character   no-undo .
      540   define variable v-waitfram-action02         as character   no-undo .
      541   define variable v-waitfram-action03         as character   no-undo .
      542   define variable mWaitFramTextBeg            as character   no-undo.
      543   define variable mWaitFramTextEnd            as character   no-undo.
