     1071       define buffer buf_trn-doc for ub.trn-doc .
     1072       find first buf_trn-doc no-lock
     1073         where buf_trn-doc.doc-code = ub.inkas.inkas-code
     1074         no-error .
     1075       if not available buf_trn-doc then do:
     1076           message "Не найден документ " ub.inkas.inkas-code
     1077             view-as alert-box error .
     1078           return no-apply.
     1079       end.
     1080       define variable v-trn-doc-doc-code as character no-undo .
     1081       if X_chk-doc.netto > 0 then do:
     1082         assign
     1083           v-trn-doc-doc-code = buf_trn-doc.doc-code
     1084         .
     1085       end.
     1086       else do:
     1087         assign
     1088           v-trn-doc-doc-code = buf_trn-doc.out-code
     1089         .
     1090       end.
     1091       FIND FIRST ub.doc-line no-lock where
     1092                  ub.doc-line.doc-code  = v-trn-doc-doc-code AND
     1093                  ub.doc-line.artic     = partic AND
     1094                  ub.doc-line.prod-type = pprod-type AND
     1095                  ub.doc-line.prod-code = pprod-code No-ERROR.
     1096       IF NOT avail(ub.doc-line) then do:
     1097           message "Не найдена строка документа " v-trn-doc-doc-code " для товара "
     1098           gds-name
     1099           view-as alert-box ERROR.
     1100           return no-apply.
     1101       END.
     1102       run str/partsedt.p (input parparentproc,
     1103                      buffer ub.doc-line,
     1104                      input no ,
     1105                      input no ,
     1106                      input 0) no-error.
     1107   END.
     1108   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1109   DO:
     1110       if num-results( "br-parts" ) = 0 or num-results("br-parts")  = ?then do:
     1111          return no-apply.
     1112       end.
     1113       define variable sym1 as char init ":"   no-undo.
     1114       define variable sym2 as char init ":"   no-undo.
     1115       define variable sym3 as char init ":"   no-undo.
     1116       define variable sym4 as char init ":"   no-undo.
     1117       define variable sym5 as char init ":"   no-undo.
     1118       define variable sym6 as char init ":"   no-undo.
     1119       define variable sym7 as char init ":"   no-undo.
     1120       define variable sym8 as char init ":"   no-undo.
     1121       define variable sym9 as char init ":"   no-undo.
     1122       define variable Line as char no-undo.
     1123       define variable obj-attr as char no-undo.
     1124       define variable StartRecid as recid .
     1125       define variable ii as int no-undo .
     1126       def frame List
     1127       sym1 column-label ":" format "X(1)"
     1128       temp-inparts.part-code column-label "Партия" FORMAT "X(14)"
     1129       sym2 column-label ":" format "X(1)"
     1130       temp-inparts.b-code column-label "Бар-код  " FORMAT ">>>>>>>>>>>>9"
     1131       sym4 column-label ":" format "X(1)"
     1132       obj-attr COLUMN-LABEL "Объект" FORMAT "x(10)"
     1133       sym5 column-label ":" format "X(1)"
     1134       X_chk-doc.chk-date COLUMN-LABEL "Дата продажи" FORMAT "99/99/9999"
     1135       sym6 column-label ":" format "X(1)"
     1136       X_inkas.inkas-code COLUMN-LABEL "Накладная" FORMAT "X(12)"
     1137       sym7 column-label ":" format "X(1)"
     1138       X_chk-doc.doc-code column-label "Номер чека" FORMAT "X(12)"
     1139       sym8 column-label ":" format "X(1)"
     1140       X_chk-doc.chk-num COLUMN-LABEL "Чек по кассе" FORMAT ">>>>>>>>>>>9"
     1141       sym9 column-label ":" format "X(1)"
     1142       HEADER
     1143         cur-time-print() AT 5 format "X(35)"
     1144                           "Страница " AT 65 PAGE-NUMBER( PrnLibStream ) AT 75 FORMAT ">>9" SKIP
     1145                       Line format "X(124)" AT 1
     1146       with width 160 down stream-io use-text .
     1147       Line = fill( "-" , 140 ) .
     1148       run waitfram-show in this-procedure ('Подождите ...' ) .
     1149       StartRecid = recid( temp-inparts ) .
     1150       GET FIRST br-parts .
     1151       ii = 1 .
     1152       run prn-lib-open-stream  in this-procedure (
     1153                                                   input parParentProc
     1154                                                   ,input 62
     1155                                                   ,input yes
     1156                                                   ,input no
     1157                                                   ).
     1158       FORM HEADER
     1159                   Line format "X(124)" SKIP
     1160                   "Продолжение - на следующей странице" AT 30 SKIP
     1161                   with FRAME CliBottomFrame width 160 PAGE-BOTTOM NO-LABELS no-box.
     1162       VIEW stream PrnLibStream FRAME CliBottomFrame .
     1163       PUT stream PrnLibStream
     1164       space(30)
     1165       string( "С П И С О К   П А Р Т И Й   по серийному номеру  " + SerNum ) format "X(100)" SKIP
     1166       space(30) buf_goods.gds-name SKIP(2) .
     1167       FORM with frame List .
     1168       DO WHILE available temp-inparts :
     1169           DISPLAY stream PrnLibStream
     1170           sym1 temp-inparts.part-code
     1171           sym2 temp-inparts.b-code
     1172           sym4 ( X_chk-doc.obj-type + " " + STRING( X_chk-doc.obj-code ) ) @ obj-attr
     1173           sym5 X_chk-doc.chk-date
     1174           sym6 X_inkas.inkas-code
     1175           sym7 X_chk-doc.doc-code
     1176           sym8 X_chk-doc.chk-num
     1177           sym9     with frame List .
     1178           DOWN stream PrnLibStream 1 with frame List .
     1179               ii =  ii + 1 .
     1180               if ( ( ii modulo 10 ) = 0 ) AND ( ii >= 10 ) then
     1181                  run waitfram-show in this-procedure ( "Просмотрено строк : " + string( ii ) ) .
     1182               GET next br-parts .
     1183       END.
     1184       run waitfram-hide in this-procedure .
     1185       PUT stream PrnLibStream
     1186       Line format "X(124)" SKIP.
     1187       HIDE stream PrnLibStream
     1188       FRAME CliBottomFrame .
     1189       output stream PrnLibStream close .
     1190       run prn-lib-prn-file in this-procedure (
     1191                                                 input parParentProc
     1192                                                 ,input 0
     1193                                                 ).
     1194       reposition br-parts to recid StartRecid .
     1195   END.
     1196   ON RETURN OF SerNum IN FRAME Dialog-Frame
     1197   DO:
     1198     APPLY "CHOOSE" to b-exit.
     1199   END.
     1200   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1201   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1202   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1203   on help of frame Dialog-Frame
     1204   do:
     1205     run gbl/app_help.p
     1206       (input this-procedure :file-name
     1207       ,input ''
     1208       ,input ?
     1209       ) no-error.
     1210     if error-status :error then do:
     1211       message
     1212         "Ошибка при вызове помощи"
     1213         error-status :get-message(1)
     1214         view-as alert-box .
     1215     end.
     1216   end.
     1217   run minbtn-set in this-procedure .
     1218   on choose of b-help in frame Dialog-Frame
     1219   do:
     1220     apply "help":u to frame Dialog-Frame .
     1221   end.
     1222   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1223   procedure minbtn-set :
     1224       do
     1225           on error undo, return error return-value
     1226           :
     1227           define variable ii              as integer       no-undo .
     1228           define variable fh              as widget-handle no-undo .
     1229           define variable hh              as widget-handle no-undo .
     1230           define variable v-h             as handle        extent 4 no-undo .
     1231           define variable v-name-button   as character     no-undo .
     1232           define variable v-help-old-x    as decimal       no-undo .
     1233           define variable v-help-old-y    as decimal       no-undo .
     1234           define variable v-help-old-size as decimal       no-undo .
     1235           define variable v-frame-width   as decimal       no-undo .
     1236           define variable jj              as integer       no-undo .
     1237           do
     1238               on error undo, return error
     1239               :
     1240               assign
     1241                   v-frame-width = frame Dialog-Frame:width - 0.3
     1242                   fh            = frame Dialog-Frame:first-child
     1243                   hh            = fh:first-child
     1244                   ii            = 1
     1245                   .
     1246               do while valid-handle(hh):
     1247                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1248                   do:
     1249                       case lc(hh:name) :
     1250                           when "b-help" then
     1251                               do:
     1252                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1253                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1254                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1255                                   hh:TOOLTIP = "Помощь" .
     1256                                   v-help-old-x = hh:column .
     1257                                   v-help-old-y = hh:row    .
     1258                                   v-help-old-size = hh:width .
     1259                                   hh:width-chars = 2.5 .
     1260                               end.
     1261                           when "b-print" then
     1262                               do:
     1263                                   hh:load-image("cmp/b-print.bmp":u) .
     1264                                   hh:TOOLTIP = "Печать" .
     1265                                   v-h[ii] = hh:handle .
     1266                                   ii = ii + 1 .
     1267                                   hh:width-chars = 3 .
     1268                               end.
     1269                           when "b-history" or
     1270                           when "b-hist" then
     1271                               do:
     1272                                   hh:load-image("cmp/b-hist.bmp":u) .
     1273                                   hh:TOOLTIP = "История" .
     1274                                   v-h[ii] = hh:handle .
     1275                                   ii = ii + 1 .
     1276                                   hh:width-chars = 3 .
     1277                               end.
     1278                           when "b-sch" then
     1279                               do:
     1280                                   hh:load-image("cmp/b-sch.bmp":u) .
     1281                                   hh:TOOLTIP = "Установка Фильтра" .
     1282                                   v-h[ii] = hh:handle .
     1283                                   ii = ii + 1 .
     1284                                   hh:width-chars = 3 .
     1285                               end.
     1286                           when "b-hist-user" then
     1287                               do:
     1288                                   hh:load-image("cmp/b-hist.bmp":u) .
     1289                                   hh:TOOLTIP = "История пользователя" .
     1290                                   ii = ii + 1 .
     1291                               end.
     1292                       end case.
     1293                   end.
     1294                   hh = hh:next-sibling.
     1295               end.
     1296               b-help:column = v-frame-width - b-help:width-chars.
     1297               jj = 0.
     1298               repeat ii = 4 to 1 by -1 :
     1299                   if valid-handle (v-h[ii] ) then
     1300                   do:
     1301                       jj  = jj + 1 .
     1302                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1303                       v-h[ii]:row    = v-help-old-y .
     1304                   end.
     1305               end.
     1306           end.
     1307       end.
     1308   end procedure.
     1309   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1310   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1311   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1312   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1313   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1314   define variable v-diasize-current-frame-height as decimal   no-undo .
     1315   define variable v-diasize-change-size          as logical   no-undo .
     1316   define variable v-diasize-resize-button        as handle    no-undo .
     1317   define variable v-diasize-wndmax               as logical   no-undo .
     1318   define variable v-diasize-wndstore             as logical   no-undo .
     1319   define variable v-diasize-proc-name            as character no-undo .
     1320   define variable v-diasize-browse-handle        as handle    no-undo .
     1321   define variable v-diasize-browse-number        as integer   no-undo .
     1322   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1323   define temp-table temp-diasize-handle no-undo
     1324     field handle-value  as handle
     1325     field save-position as decimal
     1326     index xpk is primary unique handle-value
     1327     .
     1328   define temp-table temp-browse-handle no-undo
     1329     field browse-type   as character
     1330     field browse-number as integer
     1331     field browse-handle as handle
     1332     field original-size as decimal
     1333     index xpk is primary unique browse-type browse-number
     1334     index xie browse-type browse-handle
     1335   .
     1336   procedure diasize_change-height :
     1337     define input  parameter p-change-value  as decimal   no-undo .
     1338     define input  parameter p-move-resize   as logical   no-undo .
     1339     define variable v-field-group-handle    as handle    no-undo .
     1340     define variable v-object-handle         as handle    no-undo .
     1341     define variable v-frame-height          as decimal   no-undo .
     1342     define variable v-frame-virtual-height  as decimal   no-undo .
     1343     define variable v-browse-height         as decimal   no-undo .
     1344     define variable v-window-height         as decimal   no-undo .
     1345     define variable v-window-virtual-height as decimal   no-undo .
     1346     define variable v-change-sign           as integer   no-undo .
     1347     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1348     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1349     if p-change-value > 0
     1350     then do:
     1351       if frame Dialog-Frame :height + p-change-value
     1352           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1353       then do:
     1354         assign
     1355           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1356                           - (frame Dialog-Frame :height-chars)
     1357         .
     1358         if p-change-value <= 0
     1359         then do:
     1360           run diasize_position-resize-button in this-procedure .
     1361           return .
     1362         end.
     1363       end.
     1364     end.
     1365     if p-change-value < 0
     1366     then do:
     1367       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1368       then do:
     1369         assign
     1370           p-change-value = v-diasize-orig-frame-height
     1371                          - (frame Dialog-Frame :height-chars)
     1372         .
     1373         if p-change-value >= 0
     1374         then do:
     1375           run diasize_position-resize-button in this-procedure .
     1376           return .
     1377         end.
     1378       end.
     1379     end.
     1380     if p-change-value >= 0
     1381     then do:
     1382       assign
     1383         v-change-sign = 1
     1384       .
     1385     end.
     1386     else do:
     1387       assign
     1388         v-change-sign = -1
     1389       .
     1390     end.
     1391     assign
     1392       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1393     .
     1394     if p-change-value = 0
     1395     then do:
     1396       run diasize_position-resize-button in this-procedure .
     1397       return .
     1398     end.
     1399     move_block:
     1400     do
     1401     on error undo move_block, retry move_block
     1402     :
     1403       if retry
     1404       then do:
     1405         do
     1406         on error undo move_block, leave move_block
     1407         :
     1408           if p-change-value > 0
     1409           then do:
     1410             for each buf_temp-diasize-handle
     1411             on error undo, next
     1412             :
     1413               assign
     1414                 v-object-handle = buf_temp-diasize-handle.handle-value
     1415               .
     1416               if v-object-handle <> v-diasize-resize-button
     1417               then do:
     1418                 assign
     1419                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1420                 .
     1421               end.
     1422             end.
     1423             assign
     1424               v-diasize-browse-handle :height = v-browse-height
     1425             .
     1426             for each buf_temp-browse-handle
     1427               where buf_temp-browse-handle.browse-type = 'height':u
     1428             on error undo, next
     1429             :
     1430               assign
     1431                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1432               .
     1433             end.
     1434             assign
     1435               frame Dialog-Frame :height = v-frame-height
     1436             .
     1437             if frame Dialog-Frame :scrollable = true
     1438             then do:
     1439               assign
     1440                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1441               .
     1442             end.
     1443             run diasize_position-resize-button in this-procedure .
     1444           end.
     1445           else do:
     1446             if frame Dialog-Frame :scrollable = true
     1447             then do:
     1448               assign
     1449                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1450               .
     1451             end.
     1452             assign
     1453               frame Dialog-Frame :height = v-frame-height
     1454             .
     1455             assign
     1456               v-diasize-browse-handle :height = v-browse-height
     1457             .
     1458             for each buf_temp-browse-handle
     1459               where buf_temp-browse-handle.browse-type = 'height':u
     1460             on error undo, next
     1461             :
     1462               assign
     1463                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1464               .
     1465             end.
     1466             for each buf_temp-diasize-handle
     1467             on error undo, next
     1468             :
     1469               assign
     1470                 v-object-handle = buf_temp-diasize-handle.handle-value
     1471               .
     1472               if v-object-handle <> v-diasize-resize-button
     1473               then do:
     1474                 assign
     1475                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1476                 .
     1477               end.
     1478             end.
     1479             run diasize_position-resize-button in this-procedure .
     1480           end.
     1481           assign
     1482             v-diasize-change-size = false
     1483           .
     1484           leave move_block .
     1485         end.
     1486       end.
     1487       assign
     1488         v-diasize-need-full-display = true
     1489       .
     1490       if v-diasize-change-size = false
     1491       then do:
     1492         assign
     1493           v-diasize-change-size = true
     1494         .
     1495       end.
     1496       else do:
     1497         return .
     1498       end.
     1499       assign
     1500         v-frame-height = frame Dialog-Frame :height
     1501         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1502         v-browse-height = v-diasize-browse-handle :height
     1503       .
     1504       for each buf_temp-browse-handle
     1505         where buf_temp-browse-handle.browse-type = 'height':u
     1506       :
     1507         assign
     1508           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1509         .
     1510       end.
     1511       for each buf_temp-diasize-handle
     1512       :
     1513         delete buf_temp-diasize-handle .
     1514       end.
     1515       assign
     1516         v-field-group-handle = frame Dialog-Frame :first-child
     1517       .
     1518       do while valid-handle(v-field-group-handle)
     1519       :
     1520         assign
     1521           v-object-handle = v-field-group-handle :first-child
     1522         .
     1523         do while valid-handle(v-object-handle)
     1524         :
     1525           if  v-object-handle <> v-diasize-browse-handle :handle
     1526           and can-query(v-object-handle, "row")
     1527           and can-query(v-object-handle, "height")
     1528           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1529           then do:
     1530             find first buf_temp-browse-handle
     1531               where buf_temp-browse-handle.browse-type   = 'height':u
     1532                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1533               no-error .
     1534             if available buf_temp-browse-handle
     1535             then do:
     1536             end.
     1537             else do:
     1538               create buf_temp-diasize-handle .
     1539               assign
     1540                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1541                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1542               .
     1543             end.
     1544           end.
     1545           assign
     1546             v-object-handle = v-object-handle :next-sibling
     1547           .
     1548         end.
     1549         assign
     1550           v-field-group-handle = v-field-group-handle :next-sibling
     1551         .
     1552       end.
     1553       do with frame Dialog-Frame
     1554       :
     1555         hide v-diasize-resize-button .
     1556         assign
     1557           v-diasize-resize-button :row    = 1
     1558           v-diasize-resize-button :column = 1
     1559         .
     1560       end.
     1561       if p-change-value > 0
     1562       then do:
     1563         if frame Dialog-Frame :scrollable = true
     1564         then do:
     1565           assign
     1566             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1567             no-error .
     1568           if error-status :error
     1569           or error-status :get-message(1) <> ""
     1570           then do:
     1571             undo move_block, retry move_block .
     1572           end.
     1573         end.
     1574         assign
     1575           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1576           no-error .
     1577         if error-status :error
     1578         or error-status :get-message(1) <> ""
     1579         then do:
     1580           undo move_block, retry move_block .
     1581         end.
     1582         assign
     1583           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1584           no-error .
     1585         if error-status :error
     1586         or error-status :get-message(1) <> ""
     1587         then do:
     1588           undo move_block, retry move_block .
     1589         end.
     1590         for each buf_temp-browse-handle
     1591           where buf_temp-browse-handle.browse-type = 'height':u
     1592         on error undo move_block, retry move_block
     1593         :
     1594           assign
     1595             buf_temp-browse-handle.browse-handle :height
     1596               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1597             no-error .
     1598           if error-status :error
     1599           or error-status :get-message(1) <> ""
     1600           then do:
     1601             undo move_block, retry move_block .
     1602           end.
     1603         end.
     1604         for each buf_temp-diasize-handle
     1605         on error undo move_block, retry move_block
     1606         :
     1607           assign
     1608             v-object-handle = buf_temp-diasize-handle.handle-value
     1609           .
     1610           if v-object-handle <> v-diasize-resize-button
     1611           then do:
     1612             assign
     1613               v-object-handle :row = v-object-handle :row + p-change-value
     1614               no-error .
     1615             if error-status :error
     1616             or error-status :get-message(1) <> ""
     1617             then do:
     1618               undo move_block, retry move_block .
     1619             end.
     1620           end.
     1621         end.
     1622       end.
     1623       else do:
     1624         for each buf_temp-diasize-handle
     1625         on error undo move_block, retry move_block
     1626         :
     1627           assign
     1628             v-object-handle = buf_temp-diasize-handle.handle-value
     1629           .
     1630           if v-object-handle <> v-diasize-resize-button
     1631           then do:
     1632             assign
     1633               v-object-handle :row = v-object-handle :row + p-change-value
     1634               no-error .
     1635             if error-status :error
     1636             or error-status :get-message(1) <> ""
     1637             then do:
     1638               undo move_block, retry move_block .
     1639             end.
     1640           end.
     1641         end.
     1642         assign
     1643           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1644           no-error .
     1645         if error-status :error
     1646         or error-status :get-message(1) <> ""
     1647         then do:
     1648           undo move_block, retry move_block .
     1649         end.
     1650         for each buf_temp-browse-handle
     1651           where buf_temp-browse-handle.browse-type = 'height':u
     1652         on error undo move_block, retry move_block
     1653         :
     1654           assign
     1655             buf_temp-browse-handle.browse-handle :height
     1656               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1657             no-error .
     1658           if error-status :error
     1659           or error-status :get-message(1) <> ""
     1660           then do:
     1661             undo move_block, retry move_block .
     1662           end.
     1663         end.
     1664         assign
     1665           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1666           no-error .
     1667         if error-status :error
     1668         or error-status :get-message(1) <> ""
     1669         then do:
     1670           undo move_block, retry move_block .
     1671         end.
     1672         if frame Dialog-Frame :scrollable = true
     1673         then do:
     1674           assign
     1675             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1676             no-error .
     1677           if error-status :error
     1678           or error-status :get-message(1) <> ""
     1679           then do:
     1680             undo move_block, retry move_block .
     1681           end.
     1682         end.
     1683       end.
     1684       if p-move-resize = true
     1685       then do:
     1686         run diasize_position-resize-button in this-procedure .
     1687       end.
     1688       if v-diasize-wndstore = true
     1689       then do:
     1690         if connected("ub") = true
     1691         then do:
     1692           define variable v-cntxt-db-num        as integer   no-undo .
     1693           define variable v-cntxt-userid        as character no-undo .
     1694           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1695                                             , OUTPUT v-cntxt-userid
     1696                                             ) .
     1697           run gbl/wndsizew.p
     1698             (input  v-cntxt-db-num
     1699             ,input  v-cntxt-userid
     1700             ,input  v-diasize-proc-name
     1701             ,input  'height':u
     1702             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1703             ) .
     1704         end.
     1705       end.
     1706     end.
     1707     assign
     1708       v-diasize-change-size = false
     1709     .
     1710   end procedure.
     1711   procedure diasize_set-height :
     1712     define input  parameter p-new-height  as decimal   no-undo .
     1713     define input  parameter p-move-resize as logical   no-undo .
     1714     do
     1715     on error undo, return error return-value
     1716     :
     1717       run diasize_change-height in this-procedure
     1718         (input  (p-new-height - frame Dialog-Frame :height)
     1719         ,input  p-move-resize
     1720         ) .
     1721     end.
     1722   end procedure.
     1723   procedure diasize_change-width :
     1724     define input  parameter p-change-value as decimal   no-undo .
     1725     define input  parameter p-move-resize  as logical   no-undo .
     1726     define variable v-field-group-handle   as handle    no-undo .
     1727     define variable v-object-handle        as handle    no-undo .
     1728     define variable v-frame-width          as decimal   no-undo .
     1729     define variable v-frame-virtual-width  as decimal   no-undo .
     1730     define variable v-browse-width         as decimal   no-undo .
     1731     define variable v-window-width         as decimal   no-undo .
     1732     define variable v-window-virtual-width as decimal   no-undo .
     1733     define variable v-change-sign          as integer   no-undo .
     1734     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1735     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1736     if p-change-value > 0
     1737     then do:
     1738       if frame Dialog-Frame :width + p-change-value >
     1739           session :width-chars
     1740       then do:
     1741         assign
     1742           p-change-value = session :width-chars - frame Dialog-Frame :width
     1743         .
     1744         if p-change-value <= 0
     1745         then do:
     1746           run diasize_position-resize-button in this-procedure .
     1747           return .
     1748         end.
     1749       end.
     1750     end.
     1751     if p-change-value < 0
     1752     then do:
     1753       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1754       then do:
     1755         assign
     1756           p-change-value = v-diasize-orig-frame-width
     1757                          - frame Dialog-Frame :width
     1758         .
     1759         if p-change-value >= 0
     1760         then do:
     1761           run diasize_position-resize-button in this-procedure .
     1762           return .
     1763         end.
     1764       end.
     1765     end.
     1766     if p-change-value >= 0
     1767     then do:
     1768       assign
     1769         v-change-sign = 1
     1770       .
     1771     end.
     1772     else do:
     1773       assign
     1774         v-change-sign = -1
     1775       .
     1776     end.
     1777     assign
     1778       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1779     .
     1780     if p-change-value = 0
     1781     then do:
     1782       run diasize_position-resize-button in this-procedure .
     1783       return .
     1784     end.
     1785     move_block:
     1786     do
     1787     on error undo move_block, leave move_block
     1788     :
     1789       if retry
     1790       then do:
     1791         do
     1792         on error undo move_block, leave move_block
     1793         :
     1794           if p-change-value > 0
     1795           then do:
     1796             for each buf_temp-diasize-handle
     1797             on error undo, next
     1798             :
     1799               assign
     1800                 v-object-handle = buf_temp-diasize-handle.handle-value
     1801               .
     1802               if v-object-handle <> v-diasize-resize-button
     1803               then do:
     1804                 assign
     1805                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1806                 .
     1807               end.
     1808             end.
     1809             assign
     1810               v-diasize-browse-handle :width = v-browse-width
     1811             .
     1812             for each buf_temp-browse-handle
     1813               where buf_temp-browse-handle.browse-type = 'width':u
     1814             on error undo, next
     1815             :
     1816               assign
     1817                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1818               .
     1819             end.
     1820             assign
     1821               frame Dialog-Frame :width = v-frame-width
     1822             .
     1823             if frame Dialog-Frame :scrollable = true
     1824             then do:
     1825               assign
     1826                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1827               .
     1828             end.
     1829             run diasize_position-resize-button in this-procedure .
     1830           end.
     1831           else do:
     1832             if frame Dialog-Frame :scrollable = true
     1833             then do:
     1834               assign
     1835                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1836               .
     1837             end.
     1838             assign
     1839               frame Dialog-Frame :width = v-frame-width
     1840             .
     1841             for each buf_temp-browse-handle
     1842               where buf_temp-browse-handle.browse-type = 'width':u
     1843             on error undo, next
     1844             :
     1845               assign
     1846                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1847               .
     1848             end.
     1849             assign
     1850               v-diasize-browse-handle :width = v-browse-width
     1851             .
     1852             for each buf_temp-diasize-handle
     1853             on error undo, next
     1854             :
     1855               assign
     1856                 v-object-handle = buf_temp-diasize-handle.handle-value
     1857               .
     1858               if v-object-handle <> v-diasize-resize-button
     1859               then do:
     1860                 assign
     1861                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1862                 .
     1863               end.
     1864             end.
     1865             run diasize_position-resize-button in this-procedure .
     1866           end.
     1867           assign
     1868             v-diasize-change-size = false
     1869           .
     1870           leave move_block .
     1871         end.
     1872       end.
     1873       assign
     1874         v-diasize-need-full-display = true
     1875       .
     1876       if v-diasize-change-size = false
     1877       then do:
     1878         assign
     1879           v-diasize-change-size = true
     1880         .
     1881       end.
     1882       else do:
     1883         return .
     1884       end.
     1885       assign
     1886         v-frame-width = frame Dialog-Frame :width
     1887         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1888         v-browse-width = v-diasize-browse-handle :width
     1889       .
     1890       for each buf_temp-browse-handle
     1891         where buf_temp-browse-handle.browse-type = 'width':u
     1892       :
     1893         assign
     1894           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1895         .
     1896       end.
     1897       for each buf_temp-diasize-handle
     1898       :
     1899         delete buf_temp-diasize-handle .
     1900       end.
     1901       assign
     1902         v-field-group-handle = frame Dialog-Frame :first-child
     1903       .
     1904       do while valid-handle(v-field-group-handle)
     1905       :
     1906         assign
     1907           v-object-handle = v-field-group-handle :first-child
     1908         .
     1909         do while valid-handle(v-object-handle)
     1910         :
     1911           if  v-object-handle <> v-diasize-browse-handle :handle
     1912           and v-object-handle <> v-diasize-resize-button
     1913           and can-query(v-object-handle, "row")
     1914           and can-query(v-object-handle, "height")
     1915           and ( v-object-handle :col + v-object-handle :width
     1916                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1917               )
     1918           then do:
     1919             find first buf_temp-browse-handle
     1920               where buf_temp-browse-handle.browse-type   = 'width':u
     1921                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1922               no-error .
     1923             if available buf_temp-browse-handle
     1924             then do:
     1925             end.
     1926             else do:
     1927               create buf_temp-diasize-handle .
     1928               assign
     1929                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1930                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1931               .
     1932             end.
     1933           end.
     1934           assign
     1935             v-object-handle = v-object-handle :next-sibling
     1936           .
     1937         end.
     1938         assign
     1939           v-field-group-handle = v-field-group-handle :next-sibling
     1940         .
     1941       end.
     1942       do with frame Dialog-Frame
     1943       :
     1944         hide v-diasize-resize-button .
     1945         v-diasize-resize-button :row = 1.
     1946         v-diasize-resize-button :column = 1.
     1947       end.
     1948       if p-change-value > 0
     1949       then do:
     1950         if frame Dialog-Frame :scrollable = true
     1951         then do:
     1952           assign
     1953             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1954             no-error .
     1955           if error-status :error
     1956           or error-status :get-message(1) <> ""
     1957           then do:
     1958             undo move_block, retry move_block.
     1959           end.
     1960         end.
     1961         assign
     1962           frame Dialog-Frame :width = v-frame-width + p-change-value
     1963           no-error .
     1964         if error-status :error
     1965         or error-status :get-message(1) <> ""
     1966         then do:
     1967           undo move_block, retry move_block.
     1968         end.
     1969         assign
     1970           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1971         no-error .
     1972         if error-status :error
     1973         or error-status :get-message(1) <> ""
     1974         then do:
     1975           undo move_block, retry move_block.
     1976         end.
     1977         for each buf_temp-browse-handle
     1978           where buf_temp-browse-handle.browse-type = 'width':u
     1979         on error undo move_block, retry move_block
     1980         :
     1981           assign
     1982             buf_temp-browse-handle.browse-handle :width
     1983               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1984             no-error .
     1985           if error-status :error
     1986           or error-status :get-message(1) <> ""
     1987           then do:
     1988             undo move_block, retry move_block .
     1989           end.
     1990         end.
     1991         for each buf_temp-diasize-handle
     1992         on error undo move_block, retry move_block
     1993         :
     1994           assign
     1995             v-object-handle = buf_temp-diasize-handle.handle-value
     1996           .
     1997           if v-object-handle <> v-diasize-resize-button
     1998           then do:
     1999             assign
     2000               v-object-handle :col = v-object-handle :col + p-change-value
     2001               no-error .
     2002             if error-status :error
     2003             or error-status :get-message(1) <> ""
     2004             then do:
     2005               undo move_block, retry move_block .
     2006             end.
     2007           end.
     2008         end.
     2009       end.
     2010       else do:
     2011         for each buf_temp-diasize-handle
     2012         on error undo move_block, retry move_block
     2013         :
     2014           assign
     2015             v-object-handle = buf_temp-diasize-handle.handle-value
     2016           .
     2017           if v-object-handle <> v-diasize-resize-button
     2018           then do:
     2019             assign
     2020               v-object-handle :col = v-object-handle :col + p-change-value
     2021               no-error .
     2022             if error-status :error
     2023             or error-status :get-message(1) <> ""
     2024             then do:
     2025               undo move_block, retry move_block .
     2026             end.
     2027           end.
     2028         end.
     2029         for each buf_temp-browse-handle
     2030           where buf_temp-browse-handle.browse-type = 'width':u
     2031         on error undo move_block, retry move_block
     2032         :
     2033           assign
     2034             buf_temp-browse-handle.browse-handle :width
     2035               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2036             no-error .
     2037           if error-status :error
     2038           or error-status :get-message(1) <> ""
     2039           then do:
     2040             undo move_block, retry move_block .
     2041           end.
     2042         end.
     2043         assign
     2044           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2045           no-error .
     2046         if error-status :error
     2047         or error-status :get-message(1) <> ""
     2048         then do:
     2049           undo move_block, retry move_block.
     2050         end.
     2051         assign
     2052           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2053         no-error .
     2054         if error-status :error
     2055         or error-status :get-message(1) <> ""
     2056         then do:
     2057           undo move_block, retry move_block.
     2058         end.
     2059         if frame Dialog-Frame :scrollable = true
     2060         then do:
     2061           assign
     2062             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2063           no-error .
     2064           if error-status :error
     2065           or error-status :get-message(1) <> ""
     2066           then do:
     2067             undo move_block, retry move_block.
     2068           end.
     2069         end.
     2070       end.
     2071       if p-move-resize
     2072       then do:
     2073         run diasize_position-resize-button in this-procedure .
     2074       end.
     2075       if v-diasize-wndstore = true
     2076       then do:
     2077         if connected("ub") = true
     2078         then do:
     2079           define variable v-cntxt-db-num        as integer   no-undo .
     2080           define variable v-cntxt-userid        as character no-undo .
     2081           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2082                                             , OUTPUT v-cntxt-userid
     2083                                             ) .
     2084           run gbl/wndsizew.p
     2085             (input  v-cntxt-db-num
     2086             ,input  v-cntxt-userid
     2087             ,input  v-diasize-proc-name
     2088             ,input  'width':u
     2089             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2090             ) .
     2091         end.
     2092       end.
     2093     end.
     2094     assign
     2095       v-diasize-change-size = false
     2096     .
     2097   end procedure.
     2098   procedure diasize_set-width :
     2099     define input  parameter p-new-width  as decimal   no-undo .
     2100     define input  parameter p-move-resize as logical   no-undo .
     2101     do
     2102     on error undo, return error return-value
     2103     :
     2104       run diasize_change-width in this-procedure
     2105         (input  (p-new-width - frame Dialog-Frame :width)
     2106         ,input  p-move-resize
     2107         ) .
     2108     end.
     2109   end procedure.
     2110   procedure diasize_position-resize-button :
     2111     do with frame Dialog-Frame
     2112     :
     2113       hide v-diasize-resize-button .
     2114       assign
     2115         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2116                     - 1
     2117                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2118         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2119                     - 1
     2120                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2121       .
     2122       view v-diasize-resize-button .
     2123     end.
     2124   end procedure.
     2125   on alt-right anywhere
     2126   do:
     2127     run diasize_change-width in this-procedure
     2128       (input 1
     2129       ,input true
     2130       ) .
     2131     return no-apply .
     2132   end.
     2133   on alt-left anywhere
     2134   do:
     2135     run diasize_change-width in this-procedure
     2136       (input -1
     2137       ,input true
     2138       ) .
     2139     return no-apply .
     2140   end.
     2141   on alt-down anywhere
     2142   do:
     2143     run diasize_change-height in this-procedure
     2144       (input 1
     2145       ,input true
     2146       ) .
     2147     return no-apply .
     2148   end.
     2149   on alt-up anywhere
     2150   do:
     2151     run diasize_change-height in this-procedure
     2152       (input -1
     2153       ,input true
     2154       ) .
     2155     return no-apply .
     2156   end.
     2157   on alt-enter of frame Dialog-Frame
     2158   do:
     2159     run diasize_maximize in this-procedure
     2160       (input  ?
     2161       ).
     2162     return no-apply .
     2163   end.
     2164   procedure diasize_end-move :
     2165     do
     2166     on error undo, return error return-value
     2167     :
     2168       define variable v-row-delta as decimal   no-undo .
     2169       define variable v-col-delta as decimal   no-undo .
     2170       define variable v-new-row as decimal   no-undo .
     2171       define variable v-new-col as decimal   no-undo .
     2172       assign
     2173         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2174         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2175       .
     2176       assign
     2177         v-row-delta = v-new-row - frame Dialog-Frame :height
     2178         v-col-delta = v-new-col - frame Dialog-Frame :width
     2179       .
     2180       run diasize_change-height in this-procedure
     2181         (input v-row-delta
     2182         ,input true
     2183         ) .
     2184       run diasize_change-width in this-procedure
     2185         (input v-col-delta
     2186         ,input true
     2187         ) .
     2188     end.
     2189   end procedure.
     2190   procedure diasize_maximize :
     2191     define input  parameter p-action as logical   no-undo .
     2192     do
     2193     on error undo, return error return-value
     2194     :
     2195       if p-action = ?
     2196       then do:
     2197         if v-diasize-need-maximize = true
     2198         then do:
     2199           assign
     2200             p-action = true
     2201           .
     2202         end.
     2203         else do:
     2204           assign
     2205             p-action = false
     2206           .
     2207         end.
     2208       end.
     2209       if p-action = true
     2210       then do:
     2211         run diasize_change-height in this-procedure
     2212           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2213               - frame Dialog-Frame :height-chars
     2214           ,input true
     2215           ) .
     2216         run diasize_change-width in this-procedure
     2217           (input session :width-chars
     2218               - frame Dialog-Frame :width-chars
     2219           ,input true
     2220           ) .
     2221         assign
     2222           v-diasize-need-maximize = false
     2223         .
     2224       end.
     2225       else do:
     2226         run diasize_change-width in this-procedure
     2227           (input v-diasize-orig-frame-width
     2228               - frame Dialog-Frame :width-chars
     2229           ,input true
     2230           ) .
     2231         run diasize_change-height in this-procedure
     2232           (input v-diasize-orig-frame-height
     2233               - frame Dialog-Frame :height-chars
     2234           ,input true
     2235           ) .
     2236         assign
     2237           v-diasize-need-maximize = true
     2238         .
     2239       end.
     2240     end.
     2241   end procedure.
     2242   procedure diasize_restore-orig-size :
     2243     do
     2244     on error undo, return error return-value
     2245     :
     2246       assign
     2247         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2248         v-diasize-current-frame-height = frame Dialog-Frame :height
     2249       .
     2250       run diasize_set-height in this-procedure
     2251         (input  v-diasize-orig-frame-height
     2252         ,input  true
     2253         ) .
     2254       run diasize_set-width in this-procedure
     2255         (input  v-diasize-orig-frame-width
     2256         ,input  true
     2257         ) .
     2258     end.
     2259   end procedure.
     2260   procedure diasize_restore-current-size :
     2261     do
     2262     on error undo, return error return-value
     2263     :
     2264       run diasize_set-height in this-procedure
     2265         (input  v-diasize-current-frame-height
     2266         ,input  true
     2267         ) .
     2268       run diasize_set-width in this-procedure
     2269         (input  v-diasize-current-frame-width
     2270         ,input  true
     2271         ) .
     2272     end.
     2273   end procedure.
     2274   procedure diasize_set-browse-handle :
     2275     define input  parameter p-browse-handle as handle   no-undo .
     2276     define buffer buf_temp-browse-handle for temp-browse-handle .
     2277     do
     2278     on error undo, return error return-value
     2279     :
     2280       assign
     2281         v-diasize-browse-handle = p-browse-handle
     2282       .
     2283       for each buf_temp-browse-handle
     2284       on error undo, return error return-value
     2285       :
     2286         delete buf_temp-browse-handle .
     2287       end.
     2288     end.
     2289   end procedure.
     2290   procedure diasize_add_browse :
     2291     define input  parameter p-browse-type   as character no-undo .
     2292     define input  parameter p-browse-handle as handle    no-undo .
     2293     define buffer buf_temp-browse-handle for temp-browse-handle .
     2294     do
     2295     on error undo, return error return-value
     2296     :
     2297       assign
     2298         v-diasize-browse-number = v-diasize-browse-number + 1
     2299       .
     2300       create buf_temp-browse-handle .
     2301       assign
     2302         buf_temp-browse-handle.browse-type   = p-browse-type
     2303         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2304         buf_temp-browse-handle.browse-handle = p-browse-handle
     2305       .
     2306     end.
     2307   end procedure.
     2308   procedure diasize_init :
     2309     define variable v-default-value    as logical   no-undo .
     2310     define variable v-restore-saved    as logical   no-undo .
     2311     define variable v-resize-value-str as character no-undo .
     2312     do
     2313     on error undo, return error return-value
     2314     :
     2315       do with frame Dialog-Frame
     2316       :
     2317         assign
     2318           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2319           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2320           v-diasize-browse-handle     = browse BR-parts :handle
     2321         .
     2322         create button v-diasize-resize-button
     2323         assign
     2324           parent        = frame Dialog-Frame :first-child
     2325           label         = "s"
     2326           height-pixels = 16
     2327           width-pixels  = 16
     2328           visible       = true
     2329           sensitive     = true
     2330           movable       = true
     2331           triggers:
     2332             on end-move persistent run diasize_end-move in this-procedure .
     2333           end triggers.
     2334         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2335         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2336         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2337         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2338         assign
     2339           v-diasize-wndmax = false
     2340         .
     2341         if connected("ub") = true
     2342         then do:
     2343           define variable v-cntxt-db-num        as integer   no-undo .
     2344           define variable v-cntxt-userid        as character no-undo .
     2345           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2346                                             , OUTPUT v-cntxt-userid
     2347                                             ) .
     2348           run gbl/wndpar_r.p
     2349             (input  v-cntxt-db-num
     2350             ,input  v-cntxt-userid
     2351             ,input  'wndmax':U
     2352             ,output v-diasize-wndmax
     2353             ,output v-default-value
     2354             ) .
     2355         end.
     2356         assign
     2357           v-diasize-wndstore = false
     2358         .
     2359         if connected("ub") = true
     2360         then do:
     2361           run gbl/wndpar_r.p
     2362             (input  v-cntxt-db-num
     2363             ,input  v-cntxt-userid
     2364             ,input  'wndstore':U
     2365             ,output v-diasize-wndstore
     2366             ,output v-default-value
     2367             ) .
     2368         end.
     2369         assign
     2370           v-diasize-proc-name = entry(1, program-name(2), '.')
     2371         .
     2372         if v-diasize-wndstore = true
     2373         then do:
     2374           assign
     2375             v-restore-saved = false
     2376           .
     2377           if connected("ub") = true
     2378           then do:
     2379             run gbl/wndsizer.p
     2380               (input  v-cntxt-db-num
     2381               ,input  v-cntxt-userid
     2382               ,input  v-diasize-proc-name
     2383               ,input  'height':u
     2384               ,output v-resize-value-str
     2385               ) .
     2386             if v-resize-value-str <> '':U
     2387             then do:
     2388               run diasize_change-height in this-procedure
     2389                 (input  integer(v-resize-value-str)
     2390                 ,input  true
     2391                 ) .
     2392               assign
     2393                 v-restore-saved = true
     2394               .
     2395             end.
     2396           end.
     2397           if connected("ub") = true
     2398           then do:
     2399             run gbl/wndsizer.p
     2400               (input  v-cntxt-db-num
     2401               ,input  v-cntxt-userid
     2402               ,input  v-diasize-proc-name
     2403               ,input  'width':u
     2404               ,output v-resize-value-str
     2405               ) .
     2406             if v-resize-value-str <> '':U
     2407             then do:
     2408               run diasize_change-width in this-procedure
     2409                 (input  integer(v-resize-value-str)
     2410                 ,input  true
     2411                 ) .
     2412               assign
     2413                 v-restore-saved = true
     2414               .
     2415             end.
     2416           end.
     2417           if v-restore-saved <> true
     2418           then do:
     2419             if v-diasize-wndmax = true
     2420             then do:
     2421               run diasize_maximize in this-procedure
     2422                 (input  true
     2423                 ) .
     2424             end.
     2425           end.
     2426         end.
     2427         else do:
     2428           if v-diasize-wndmax = true
     2429           then do:
     2430             run diasize_maximize in this-procedure
     2431               (input  true
     2432               ) .
     2433           end.
     2434         end.
     2435       end.
     2436     end.
     2437   end procedure.
     2438   procedure diasize_need-full-display :
     2439     define output parameter p-need-full-display as logical   no-undo .
     2440     do
     2441     on error undo, return error return-value
     2442     :
     2443       assign
     2444         p-need-full-display = v-diasize-need-full-display
     2445       .
     2446       assign
     2447         v-diasize-need-full-display = false
     2448       .
     2449     end.
     2450   end procedure.
     2451   procedure get-context :
     2452      define output parameter p-db-num as integer          no-undo.
     2453      define output parameter p-user-id as character        no-undo.
     2454      define variable v-login               as character    no-undo.
     2455      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2456      define buffer buf_user-login  for ub.user-login .
     2457      do
     2458      on error undo, return error
     2459      :
     2460            FIND FIRST buf_sys-ctrl no-lock.
     2461            ASSIGN
     2462               v-login = USERID("ub")
     2463               p-db-num = buf_sys-ctrl.db-num
     2464            .
     2465            FIND FIRST buf_user-login
     2466                 WHERE buf_user-login.db-num = p-db-num
     2467                   AND buf_user-login.user-login = v-login
     2468                 no-lock
     2469                 no-error
     2470                 .
     2471            IF AVAILABLE buf_user-login
     2472            THEN DO:
     2473               assign
     2474                  p-user-id = buf_user-login.user-id
     2475               .
     2476            END.
     2477      end.
     2478   end procedure.
     2479       run diasize_init in this-procedure .
     2480   MAIN-BLOCK:
     2481   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2482      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2483   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2484     run mainmenu_getcntxt in parparentproc
     2485       (output v-cntxt-db-num
     2486       ,output v-cntxt-userid
     2487       ,output v-cntxt-level
     2488       ,output v-cntxt-host-code-obj
     2489       ,output v-cntxt-obj-type
     2490       ,output v-cntxt-obj-code
     2491       ,output v-cntxt-db-num-obj
     2492       ,output v-cntxt-is-admin
     2493       ) .
     2494     IF p-gds-rec <> ? then do:
     2495       FIND FIRST buf_goods No-LOCK where
     2496                  recid(buf_goods) = p-gds-rec NO-ERROR.
     2497       IF NOT AVAIL buf_goods then return error.
     2498       DISPLAY
     2499       gds-name
     2500       WITH FRAME Dialog-Frame.
     2501       run setGood in this-procedure no-error.
     2502       If error-status:error then return error.
     2503     END.
     2504     RUN MYenable in this-procedure .
     2505     WAIT-FOR GO OF FRAME Dialog-Frame.
     2506   END.
     2507   RUN disable_UI.
     2508   PROCEDURE disable_UI :
     2509     HIDE FRAME Dialog-Frame.
     2510   END PROCEDURE.
     2511   PROCEDURE enable_UI :
     2512     DISPLAY SerNum gds-name
     2513         WITH FRAME Dialog-Frame.
     2514     ENABLE b-quit B-exit b-gds B-parts B-chk B-doc B-cli B-print B-Help SerNum
     2515            BR-parts gds-name
     2516         WITH FRAME Dialog-Frame.
     2517     VIEW FRAME Dialog-Frame.
     2518   END PROCEDURE.
     2519   PROCEDURE MyEnable :
     2520     DISPLAY
     2521     SerNum
     2522     gds-name
     2523     WITH FRAME Dialog-Frame.
     2524     ENABLE
     2525     B-exit
     2526     b-quit
     2527     b-gds when p-gds-rec = ?
     2528     b-parts
     2529     b-chk
     2530     b-doc
     2531     B-print
     2532     B-Help
     2533     b-cli
     2534     SerNum
     2535     BR-parts gds-name
     2536     WITH FRAME Dialog-Frame.
     2537     VIEW FRAME Dialog-Frame.
     2538   END PROCEDURE.
     2539   PROCEDURE OpenBr :
     2540   run waitfram-show in this-procedure ( 'Подождите ...').
     2541     for each temp-inparts
     2542     :
     2543       delete temp-inparts .
     2544     end.
     2545     define buffer buf_parts for ub.parts .
     2546     FOR EACH buf_parts NO-LOCK WHERE
     2547             buf_parts.artic     = partic AND
     2548             buf_parts.prod-type = pprod-type AND
     2549             buf_parts.prod-code = pprod-code AND
     2550             buf_parts.obj-type  = p-obj-type AND
     2551             buf_parts.obj-code  = p-obj-code AND
     2552             buf_parts.out-code  <> 'free-zone':U AND
     2553             buf_parts.out-code  <> 'out-zone':U and
     2554             buf_parts.part-code = Sernum AND
     2555             buf_parts.status_   = yes AND
     2556             buf_parts.doc-type  <> 'акт':U AND
     2557             buf_parts.doc-type  <> 'при':U
     2558     :
     2559       find first temp-inparts
     2560         where temp-inparts.in-code   = buf_parts.in-code
     2561           and temp-inparts.part-code = buf_parts.part-code
     2562         no-error .
     2563       if not available temp-inparts then do:
     2564         create temp-inparts .
     2565         assign
     2566           temp-inparts.in-code   = buf_parts.in-code
     2567           temp-inparts.part-code = buf_parts.part-code
     2568         .
     2569         define buffer buf_bar-code for ub.bar-code .
     2570         find first buf_bar-code no-lock
     2571           where buf_bar-code.gds-code  = pgds-code
     2572             and buf_bar-code.unit-cli  = punit-base
     2573             and buf_bar-code.part-code = temp-inparts.part-code
     2574             and buf_bar-code.in-code   = temp-inparts.in-code
     2575             and buf_bar-code.node-code = pnode-code
     2576           no-error .
     2577         if available buf_bar-code then do:
     2578           assign
     2579             temp-inparts.b-code = buf_bar-code.b-code
     2580           .
     2581         end.
     2582       end.
     2583     end.
     2584     OPEN QUERY Br-parts
     2585         FOR EACH temp-inparts,
     2586             EACH X_chk-gds where
     2587                   X_chk-gds.b-code   = temp-inparts.b-code AND
     2588                   X_chk-gds.out-code <> ?,
     2589             FIRST X_inkas NO-LOCK WHERE
     2590                   X_inkas.inkas-code = X_chk-gds.out-code AND
     2591                   X_inkas.status_    = 'факт':U,
     2592             FIRST X_chk-doc No-LOCK WHERE
     2593                   X_chk-doc.doc-code = X_chk-gds.doc-code
     2594                           .
     2595   run waitfram-hide in this-procedure .
     2596   apply "entry" to br-parts in frame Dialog-Frame.
     2597   END PROCEDURE.
     2598   PROCEDURE reposition-chk-doc :
     2599   define input  parameter p-direction   as character no-undo .
     2600   define output parameter p-chk-doc-recid as recid no-undo .
     2601   define variable v-parts-recid as recid no-undo .
     2602     case p-direction :
     2603       when "first":U
     2604       then do:
     2605         get first br-parts.
     2606       end.
     2607       when "last":U
     2608       then do:
     2609         get last br-parts.
     2610       end.
     2611       when "prev":U
     2612       then do:
     2613         get prev br-parts.
     2614         if not available temp-inparts then do:
     2615           message
     2616           "Это первый документ списка"
     2617           view-as alert-box.
     2618         end.
     2619       end.
     2620       when "next":U
     2621       then do:
     2622         get next br-parts.
     2623         if not available temp-inparts then do:
     2624           message
     2625           "Это последний документ списка"
     2626           view-as alert-box.
     2627         end.
     2628       end.
     2629     end case .
     2630     assign
     2631     p-chk-doc-recid = recid(X_chk-doc)
     2632     v-parts-recid = recid(temp-inparts)
     2633     .
     2634     run reposition-query in this-procedure
     2635       (input v-parts-recid
     2636       ).
     2637   END PROCEDURE.
     2638   PROCEDURE reposition-inkas :
     2639   define input  parameter p-direction   as character no-undo .
     2640   define output parameter p-inkas-recid as recid no-undo .
     2641   define variable v-parts-recid as recid no-undo .
     2642     case p-direction :
     2643       when "first":U
     2644       then do:
     2645         get first br-parts.
     2646       end.
     2647       when "last":U
     2648       then do:
     2649         get last br-parts.
     2650       end.
     2651       when "prev":U
     2652       then do:
     2653         get prev br-parts.
     2654         if not available temp-inparts then do:
     2655           message
     2656           "Это первый документ списка"
     2657           view-as alert-box.
     2658         end.
     2659       end.
     2660       when "next":U
     2661       then do:
     2662         get next br-parts.
     2663         if not available temp-inparts then do:
     2664           message
     2665           "Это последний документ списка"
     2666           view-as alert-box.
     2667         end.
     2668       end.
     2669     end case .
     2670     assign
     2671     p-inkas-recid = recid(X_inkas)
     2672     v-parts-recid = recid(temp-inparts)
     2673     .
     2674     run reposition-query in this-procedure
     2675       (input v-parts-recid
     2676       ).
     2677   END PROCEDURE.
     2678   PROCEDURE reposition-query :
     2679   define input parameter p-recid as recid no-undo .
     2680     if p-recid <> ?
     2681     then do:
     2682       reposition br-parts to recid p-recid no-error.
     2683     end.
     2684     do with frame Dialog-Frame:
     2685       apply "entry":u to browse BR-parts .
     2686     end.
     2687   END PROCEDURE.
     2688   PROCEDURE SetGood :
     2689   define buffer buf_units for ub.units .
     2690   define buffer buf_gds-prt for ub.gds-prt.
     2691   FIND FIRST buf_units No-LOCK WHERE
     2692             buf_units.unit-name = buf_goods.unit-base No-ERROR.
     2693   IF NOT AVAIL buf_units then do:
     2694       RETURN ERROR.
     2695   END.
     2696   IF LOOKUP('сер':U, buf_units.type) = 0 then do:
     2697       message "Товар несерийный (неномерной)!"
     2698       view-as alert-box WARNING.
     2699       return error.
     2700   end.
     2701   ASSIGN
     2702   partic = buf_goods.artic
     2703   pprod-type = buf_goods.prod-type
     2704   pprod-code = buf_goods.prod-code
     2705   pgds-code = buf_goods.gds-code
     2706   punit-base = buf_goods.unit-base
     2707   .
     2708   FIND FIRST buf_gds-prt No-LOCK WHERE
     2709            buf_gds-prt.upper-code = buf_goods.prt-root No-ERROR.
     2710   IF not avail buf_gds-prt then do:
     2711       RETURN ERROR.
     2712   END.
     2713   assign
     2714   pnode-code = buf_gds-prt.node-code.
     2715   gds-name =  (buf_goods.artic + chr(32) + buf_goods.prod-type + string(buf_goods.prod-code) +
     2716                 chr(32) + buf_goods.gds-name).
     2717   DISPLAY
     2718   gds-name
     2719   WITH FRAME Dialog-Frame.
     2720   END PROCEDURE.
