      128   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      129   procedure cur-time :
      130      define output parameter p-today as date      no-undo .
      131      define output parameter p-time  as integer   no-undo .
      132     do
      133     on error undo, return error
      134     :
      135       define variable v-date1 as date      no-undo .
      136       define variable v-date2 as date      no-undo .
      137       define variable v-time  as integer   no-undo .
      138       assign
      139         v-date1 = today
      140         v-time  = time
      141         v-date2 = today
      142       .
      143       if v-date1 <> v-date2
      144       then do:
      145         assign
      146           v-date1 = today
      147           v-time  = v-time
      148         .
      149       end.
      150       assign
      151         p-today = v-date1
      152         p-time  = v-time
      153       .
      154     end.
      155   end.
      156   function cur-time-date returns character
      157   :
      158     return string(today, '99/99/9999':U) .
      159   end.
      160   function cur-time-mjd returns decimal
      161   :
      162     define variable v-date as date      no-undo .
      163     define variable v-time as integer   no-undo .
      164     run cur-time in this-procedure
      165       (output v-date
      166       ,output v-time
      167       ) .
      168     return integer(v-date) - 2400002 + (v-time / 86400) .
      169   end.
      170   function cur-time-get-ending-index returns integer
      171   (input p-number as integer
      172   )
      173   :
      174     if p-number < 0
      175     or p-number = ?
      176     then do:
      177       return 1 .
      178     end.
      179     define variable v-rest as integer   no-undo .
      180     assign
      181       p-number = p-number modulo 100
      182     .
      183     if p-number < 20
      184     then do:
      185       assign
      186         v-rest = p-number
      187       .
      188     end.
      189     else do:
      190       assign
      191         v-rest = p-number modulo 10
      192       .
      193     end.
      194     case v-rest :
      195       when 1
      196       then do:
      197         return 2 .
      198       end.
      199       when 2 or
      200       when 3 or
      201       when 4
      202       then do:
      203         return 3 .
      204       end.
      205       otherwise do:
      206         return 1 .
      207       end.
      208     end case .
      209   end.
      210   procedure cur-time-mjd-to-date :
      211      define input  parameter i-mjd-diff as decimal no-undo.
      212      define output parameter o-Date     as date    no-undo.
      213      define output parameter o-Time     as integer no-undo.
      214      define variable v-day-number as integer   no-undo .
      215      if    i-mjd-diff < 0
      216         or i-mjd-diff = ?
      217      then do:
      218         return "?" .
      219      end.
      220      assign
      221         v-day-number = truncate(i-mjd-diff,0).
      222         o-Date = date(v-day-number + 2400002).
      223         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      224     .
      225   end.
      226   function cur-time-mjd-to-string returns character
      227   (input p-mjd-diff as decimal
      228   )
      229   :
      230     define variable v-day-number as integer   no-undo .
      231     define variable v-seconds    as integer   no-undo .
      232     define variable v-hour       as integer   no-undo .
      233     define variable v-min        as integer   no-undo .
      234     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      235     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      236     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      237     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      238     if p-mjd-diff < 0
      239     or p-mjd-diff = ?
      240     then do:
      241       return "?" .
      242     end.
      243     assign
      244       v-day-number = integer(truncate(p-mjd-diff,0))
      245       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      246     .
      247     if v-seconds > 86400
      248     then do:
      249       assign
      250         v-seconds = 86400 - 1
      251       .
      252     end.
      253     if v-seconds < 0
      254     then do:
      255       assign
      256         v-seconds = 0
      257       .
      258     end.
      259     assign
      260       v-hour = truncate(v-seconds / 3600, 0)
      261     .
      262     assign
      263       v-seconds = v-seconds modulo 3600
      264     .
      265     assign
      266       v-min = truncate(v-seconds / 60, 0)
      267     .
      268     assign
      269       v-seconds = v-seconds modulo 60
      270     .
      271     return
      272         (if v-day-number <> 0
      273           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      274           else ""
      275         )
      276       + (if v-day-number <> 0 or v-hour <> 0
      277           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      278           else ""
      279         )
      280       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      281           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      282           else ""
      283         )
      284       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      285       .
      286   end.
      287   function cur-time-string returns character
      288   :
      289     define variable v-date as date      no-undo .
      290     define variable v-time as integer   no-undo .
      291     run cur-time in this-procedure
      292       (output v-date
      293       ,output v-time
      294       ) .
      295     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      296   end.
      297   function cur-time-string-sec returns character
      298   :
      299     define variable v-date as date      no-undo .
      300     define variable v-time as integer   no-undo .
      301     run cur-time in this-procedure
      302       (output v-date
      303       ,output v-time
      304       ) .
      305     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      306   end.
      307   function cur-time-custom  returns character
      308   (input p-prefix as character
      309   ,input p-date-format as character
      310   ,input p-delimiter as character
      311   ,input p-time-format as character
      312   ,input p-suffix as character
      313   )
      314   :
      315     define variable v-date as date      no-undo .
      316     define variable v-time as integer   no-undo .
      317     run cur-time in this-procedure
      318       (output v-date
      319       ,output v-time
      320       ) .
      321     return
      322       p-prefix
      323       + string(v-date, p-date-format)
      324       + p-delimiter
      325       + string(v-time, p-time-format)
      326       + p-suffix
      327       .
      328   end.
      329   function cur-time-print  returns character
      330   :
      331     define variable v-date as date      no-undo .
      332     define variable v-time as integer   no-undo .
      333     run cur-time in this-procedure
      334       (output v-date
      335       ,output v-time
      336       ) .
      337     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      338   end.
      339   function cur-time-datetime returns datetime
      340   :
      341     define variable v-char as character no-undo .
      342     define variable v-datetime as datetime no-undo .
      343     v-char = cur-time-string().
      344     v-datetime = datetime(v-char).
      345     return  v-datetime.
      346   end.
      347   function cur-time-string-msec returns character
      348   :
      349     define variable v-date as datetime  no-undo .
      350     v-date = now.
      351     return string(v-date) .
      352   end.
