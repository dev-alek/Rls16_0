      824        LABEL "&Список"
      825        SIZE 10 BY 1
      826        BGCOLOR 8 .
      827   DEFINE BUTTON b-print
      828        LABEL "Пе&чать"
      829        SIZE 10 BY 1
      830        BGCOLOR 8 .
      831   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      832        LABEL "&Выход "
      833        SIZE 10 BY 1
      834        BGCOLOR 8 FGCOLOR 0 .
      835   DEFINE VARIABLE FILL-INFO AS CHARACTER FORMAT "X(256)":U
      836         VIEW-AS TEXT
      837        SIZE 76.38 BY .67
      838        FGCOLOR 4  NO-UNDO.
      839   DEFINE VARIABLE prod-name AS CHARACTER FORMAT "X(40)"
      840         VIEW-AS TEXT
      841        SIZE 50 BY 1 NO-UNDO.
      842   DEFINE QUERY BR-badprts FOR
      843         buf_sale-doc,
      844         ub.doc-line,
      845         ub.parts,
      846         ub.goods,
      847         ub.gds-obj SCROLLING.
      848   DEFINE BROWSE BR-badprts
      849     QUERY BR-badprts NO-LOCK DISPLAY
      850         ub.goods.negative-rest COLUMN-LABEL "-ост." FORMAT "+/-":U
      851         ub.doc-line.artic FORMAT "X(16)":U
      852         ub.goods.gds-name FORMAT "X(48)":U
      853         ub.goods.unit-base COLUMN-LABEL "Изм." FORMAT "X(3)":U
      854         ub.doc-line.fact-qnty COLUMN-LABEL "Продано" FORMAT "->>,>>>,>>9.999":U
      855         ub.doc-line.doc-qnty COLUMN-LABEL "Зарезерв." FORMAT "->>,>>>,>>9.999":U
      856         ub.parts.fact-qnty COLUMN-LABEL "Из них в -ост." FORMAT "->>,>>>,>>9.999":U
      857         ub.gds-obj.fact-qnty FORMAT "->>,>>>,>>9.<<<":U
      858         ub.gds-obj.free-qnty COLUMN-LABEL "Свободно(кол-во)" FORMAT "->>,>>>,>>9.<<<":U
      859         ub.parts.out-code FORMAT "X(14)":U
      860         ub.parts.status_ FORMAT "yes/no":U
      861         ub.parts.rsrv-free FORMAT "yes/no":U
      862       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 12.25
      863            BGCOLOR 15  ROW-HEIGHT-CHARS .67.
      864   DEFINE FRAME Dialog-Frame
      865        Btn_Cancel AT ROW 1 COL 1
      866        b-print AT ROW 1 COL 21
      867        b-list AT ROW 1 COL 31
      868        b-help AT ROW 1 COL 85
      869        BR-badprts AT ROW 4.5 COL 1
      870        FILL-INFO AT ROW 2.5 COL 1.75 NO-LABEL
      871        prod-name AT ROW 3.5 COL 1 NO-LABEL
      872        SPACE(48.00) SKIP(12.25)
      873       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      874            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      875            BGCOLOR 8 FGCOLOR 0
      876            TITLE ""
      877            CANCEL-BUTTON Btn_Cancel.
      878   ASSIGN
      879          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      880          FRAME Dialog-Frame:HIDDEN           = TRUE.
      881   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      882   DO:
      883     APPLY "END-ERROR":U TO SELF.
      884   END.
      885   ON CHOOSE OF b-list IN FRAME Dialog-Frame
      886   DO:
      887         doc-line-rec = recid(ub.doc-line).
      888         DO WHILE available ub.doc-line :
      889               GET prev br-badprts.
      890         END.
      891         run PrintProc in this-procedure ( input "L" ).
      892         run str/gds-list.w ( input parparentproc
      893                            , input buf_inkas.host-code
      894                            , input buf_inkas.obj-type
      895                            , input buf_inkas.obj-code).
      896         reposition br-badprts to recid doc-line-rec no-error.
      897         apply "entry" to br-badprts in frame Dialog-Frame.
      898   END.
      899   ON CHOOSE OF b-print IN FRAME Dialog-Frame
      900   DO:
      901         doc-line-rec = recid(ub.doc-line).
      902         DO WHILE available doc-line :
      903               GET prev br-badprts.
      904         END.
      905         run PrintProc in this-procedure ( input "P").
      906         reposition br-badprts to recid doc-line-rec no-error.
      907         apply "entry" to br-badprts in frame Dialog-Frame.
      908   END.
      909   ON VALUE-CHANGED OF BR-badprts IN FRAME Dialog-Frame
      910   DO:
      911       if not available ub.goods then do:
      912           return no-apply.
      913       end.
      914       FIND FIRST ub.clients where ub.clients.obj-type = ub.goods.prod-type AND ub.clients.obj-code = goods.prod-code
      915       NO-LOCK NO-ERROR.
      916       IF avail ub.clients then assign prod-name = "Пр-ль: " + ub.clients.obj-name.
      917       else prod-name = "".
      918       display prod-name with frame Dialog-Frame.
      919   END.
      920   ON CHOOSE OF Btn_Cancel IN FRAME Dialog-Frame
      921   DO:
      922       FOR EACH gds-list:
      923           DELETE gds-list.
      924       END.
      925   END.
      926   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      927   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      928   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      929   on help of frame Dialog-Frame
      930   do:
      931     run gbl/app_help.p
      932       (input this-procedure :file-name
      933       ,input ''
      934       ,input ?
      935       ) no-error.
      936     if error-status :error then do:
      937       message
      938         "Ошибка при вызове помощи"
      939         error-status :get-message(1)
      940         view-as alert-box .
      941     end.
      942   end.
      943   run minbtn-set in this-procedure .
      944   on choose of b-help in frame Dialog-Frame
      945   do:
      946     apply "help":u to frame Dialog-Frame .
      947   end.
      948   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      949   procedure minbtn-set :
      950       do
      951           on error undo, return error return-value
      952           :
      953           define variable ii              as integer       no-undo .
      954           define variable fh              as widget-handle no-undo .
      955           define variable hh              as widget-handle no-undo .
      956           define variable v-h             as handle        extent 4 no-undo .
      957           define variable v-name-button   as character     no-undo .
      958           define variable v-help-old-x    as decimal       no-undo .
      959           define variable v-help-old-y    as decimal       no-undo .
      960           define variable v-help-old-size as decimal       no-undo .
      961           define variable v-frame-width   as decimal       no-undo .
      962           define variable jj              as integer       no-undo .
      963           do
      964               on error undo, return error
      965               :
      966               assign
      967                   v-frame-width = frame Dialog-Frame:width - 0.3
      968                   fh            = frame Dialog-Frame:first-child
      969                   hh            = fh:first-child
      970                   ii            = 1
      971                   .
      972               do while valid-handle(hh):
      973                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      974                   do:
      975                       case lc(hh:name) :
      976                           when "b-help" then
      977                               do:
      978                                   hh:load-image-up("cmp/b-help.bmp":u) .
      979                                   hh:load-image-down("cmp/b-help.bmp":u) .
      980                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      981                                   hh:TOOLTIP = "Помощь" .
      982                                   v-help-old-x = hh:column .
      983                                   v-help-old-y = hh:row    .
      984                                   v-help-old-size = hh:width .
      985                                   hh:width-chars = 2.5 .
      986                               end.
      987                           when "b-print" then
      988                               do:
      989                                   hh:load-image("cmp/b-print.bmp":u) .
      990                                   hh:TOOLTIP = "Печать" .
      991                                   v-h[ii] = hh:handle .
      992                                   ii = ii + 1 .
      993                                   hh:width-chars = 3 .
      994                               end.
      995                           when "b-history" or
      996                           when "b-hist" then
      997                               do:
      998                                   hh:load-image("cmp/b-hist.bmp":u) .
      999                                   hh:TOOLTIP = "История" .
     1000                                   v-h[ii] = hh:handle .
     1001                                   ii = ii + 1 .
     1002                                   hh:width-chars = 3 .
     1003                               end.
     1004                           when "b-sch" then
     1005                               do:
     1006                                   hh:load-image("cmp/b-sch.bmp":u) .
     1007                                   hh:TOOLTIP = "Установка Фильтра" .
     1008                                   v-h[ii] = hh:handle .
     1009                                   ii = ii + 1 .
     1010                                   hh:width-chars = 3 .
     1011                               end.
     1012                           when "b-hist-user" then
     1013                               do:
     1014                                   hh:load-image("cmp/b-hist.bmp":u) .
     1015                                   hh:TOOLTIP = "История пользователя" .
     1016                                   ii = ii + 1 .
     1017                               end.
     1018                       end case.
     1019                   end.
     1020                   hh = hh:next-sibling.
     1021               end.
     1022               b-help:column = v-frame-width - b-help:width-chars.
     1023               jj = 0.
     1024               repeat ii = 4 to 1 by -1 :
     1025                   if valid-handle (v-h[ii] ) then
     1026                   do:
     1027                       jj  = jj + 1 .
     1028                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1029                       v-h[ii]:row    = v-help-old-y .
     1030                   end.
     1031               end.
     1032           end.
     1033       end.
     1034   end procedure.
     1035   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1036   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1037   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1038   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1039   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1040   define variable v-diasize-current-frame-height as decimal   no-undo .
     1041   define variable v-diasize-change-size          as logical   no-undo .
     1042   define variable v-diasize-resize-button        as handle    no-undo .
     1043   define variable v-diasize-wndmax               as logical   no-undo .
     1044   define variable v-diasize-wndstore             as logical   no-undo .
     1045   define variable v-diasize-proc-name            as character no-undo .
     1046   define variable v-diasize-browse-handle        as handle    no-undo .
     1047   define variable v-diasize-browse-number        as integer   no-undo .
     1048   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1049   define temp-table temp-diasize-handle no-undo
     1050     field handle-value  as handle
     1051     field save-position as decimal
     1052     index xpk is primary unique handle-value
     1053     .
     1054   define temp-table temp-browse-handle no-undo
     1055     field browse-type   as character
     1056     field browse-number as integer
     1057     field browse-handle as handle
     1058     field original-size as decimal
     1059     index xpk is primary unique browse-type browse-number
     1060     index xie browse-type browse-handle
     1061   .
     1062   procedure diasize_change-height :
     1063     define input  parameter p-change-value  as decimal   no-undo .
     1064     define input  parameter p-move-resize   as logical   no-undo .
     1065     define variable v-field-group-handle    as handle    no-undo .
     1066     define variable v-object-handle         as handle    no-undo .
     1067     define variable v-frame-height          as decimal   no-undo .
     1068     define variable v-frame-virtual-height  as decimal   no-undo .
     1069     define variable v-browse-height         as decimal   no-undo .
     1070     define variable v-window-height         as decimal   no-undo .
     1071     define variable v-window-virtual-height as decimal   no-undo .
     1072     define variable v-change-sign           as integer   no-undo .
     1073     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1074     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1075     if p-change-value > 0
     1076     then do:
     1077       if frame Dialog-Frame :height + p-change-value
     1078           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1079       then do:
     1080         assign
     1081           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1082                           - (frame Dialog-Frame :height-chars)
     1083         .
     1084         if p-change-value <= 0
     1085         then do:
     1086           run diasize_position-resize-button in this-procedure .
     1087           return .
     1088         end.
     1089       end.
     1090     end.
     1091     if p-change-value < 0
     1092     then do:
     1093       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1094       then do:
     1095         assign
     1096           p-change-value = v-diasize-orig-frame-height
     1097                          - (frame Dialog-Frame :height-chars)
     1098         .
     1099         if p-change-value >= 0
     1100         then do:
     1101           run diasize_position-resize-button in this-procedure .
     1102           return .
     1103         end.
     1104       end.
     1105     end.
     1106     if p-change-value >= 0
     1107     then do:
     1108       assign
     1109         v-change-sign = 1
     1110       .
     1111     end.
     1112     else do:
     1113       assign
     1114         v-change-sign = -1
     1115       .
     1116     end.
     1117     assign
     1118       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1119     .
     1120     if p-change-value = 0
     1121     then do:
     1122       run diasize_position-resize-button in this-procedure .
