      585     B-viewProcInfo
      586     B-WaitFramStop at row 4 col 30
      587     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      588     .
      589   define new global shared variable mBatchMode as logical no-undo init ?.
      590   define variable mFramBachModHandle as handle no-undo.
      591   mFramBachModHandle = frame waitfram:handle.
      592   define variable mFameOldVis as logical no-undo.
      593   define variable mVisCUrentVin as logical no-undo.
      594   if session:batch-mode
      595   then
      596      mBatchMode = yes.
      597   if mBatchMode = ? then do:
      598     mVisCUrentVin = current-window:visible.
      599     mFameOldVis = mFramBachModHandle:visible.
      600     mFramBachModHandle:visible  = yes.
      601     mBatchMode = mFramBachModHandle:visible ne yes.
      602     mFramBachModHandle:visible = mFameOldVis.
      603     current-window:visible = mVisCUrentVin.
      604   end.
      605    if  log-manager:logfile-name ne ?
      606     then DO:
      607         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      608         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      609         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      610     end.
      611   on choose of B-WaitFramStop in frame waitfram
      612   do:
      613     mWaitFramStop = yes.
      614     mWaitFramStopUser = yes.
      615   end.
      616   function waitfram-check-timeout returns logical():
      617      define variable vtime as int64 no-undo.
      618      if mWaitFramStopTimeOut
      619      then
      620         return yes.
      621      vtime = ( now - mWaitFramStartProc ) / 1000 .
      622      if     mWaitFramTimeOut ne ?
      623         and mWaitFramTimeOut ne 0
      624         and mWaitFramTimeOut lt vtime
      625      then do:
      626         mWaitFramStopTimeOut = yes.
      627      end.
      628      return mWaitFramStopTimeOut.
      629   end.
      630   procedure waitfram-hide :
      631     if not session:batch-mode
      632     then do
      633     on error undo, return error return-value
      634     :
      635       pause 0 before-hide .
      636       if not mBatchMode then
      637         hide frame waitfram .
      638     if     not mWaitFramView
      639        and mWaitProcEvent
      640     then
      641       process events .
      642     end.
      643   end procedure.
      644   procedure waitfram-show :
      645     define input  parameter p-message as character no-undo .
      646     define variable v-left-margin as integer   no-undo .
      647     if not session:batch-mode
      648     then do
      649     on error undo, return error return-value
      650     :
      651       if length(p-message) <= 70 then do:
      652         assign
      653           v-left-margin = integer((70 - length(p-message)) / 2)
      654         .
      655         assign
      656           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      657         .
      658         assign
      659           v-waitfram-action01 = " "
      660           v-waitfram-action02 = " "
      661                                    + fill(" ", v-left-margin)
      662                                    + p-message
      663           v-waitfram-action03 = " "
      664         .
      665       end.
      666       else do:
      667         define variable vRindex1 as integer no-undo.
      668         define variable vRindex2 as integer no-undo.
      669         vRindex1 = r-index(p-message," ",70).
      670         if vRindex1 = 0
      671         then
      672            vRindex1 = 70.
      673         if length(p-message)  <= vRindex1 + 70 then do:
      674           assign
      675             v-waitfram-action01 = " "
      676             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      677             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      678           .
      679         end.
      680         else do:
      681           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      682           if vRindex2 <= vRindex1
      683           then
      684              vRindex2 = vRindex1 + 70.
      685           assign
      686             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      687             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      688             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      689           .
      690         end.
      691       end.
      692       B-viewProcInfo:visible   in frame waitfram = no.
      693       B-viewProcInfo:sensitive in frame waitfram = no.
      694       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      695       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      696       if  (   mWaitFramView
      697          or  mWaitProcEvent)
      698          and not mBatchMode
      699       then
      700          display
      701             v-waitfram-action01 skip
      702             v-waitfram-action02 skip
      703             v-waitfram-action03 skip
      704          with frame waitfram .
      705       if     mWaitFramView
      706          then do:
      707             if     mWaitFramInterval ne ?
      708                and not mBatchMode
      709             then
      710                wait-for go of frame waitfram pause mWaitFramInterval.
      711          end.
      712          else
      713             if     mWaitProcEvent
      714                and not mBatchMode
      715             then
      716                process events .
      717     end.
      718   end procedure.
      719      procedure waitfram-show-this:
      720         define input  parameter iInterval as int64 no-undo.
      721         define variable vtime as int64 no-undo.
      722         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      723         mWaitFramInterval = iInterval.
      724         run waitfram-show (substitute("&1&2 &3&4" ,
      725                                       mWaitFramTextBeg ,
      726                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      727                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      728                                       mWaitFramTextEnd
      729                                      )
      730                           ).
      731      end.
      732      procedure WaitFramRunPause:
      733         define input  parameter iInterval as dec no-undo.
      734         define variable vStart  as datetime-tz no-undo.
      735         define variable vend    as datetime-tz no-undo.
      736         define variable vint as int64 no-undo.
      737         define variable vOk as logical no-undo.
      738         vStart = now.
      739         vend   = vStart.
      740         publish "WaitFramPause" (iInterval,output vOk).
      741         vend   =  now.
      742         vint = vend - vStart.
      743         vint = iInterval - vint / 1000.
      744         if     not mWaitFramStop
      745            and (   vint > 0
      746                 or (    not vOk
      747                     and iInterval eq ?
      748                     )
      749                 )
      750         then
      751            run waitfram-show-this (iInterval).
      752         vend   =  now.
      753         vint = vend - vStart.
      754         vint = iInterval - vint / 1000.
      755         if     not mWaitFramStop
      756            and vint > 0
      757         then do:
      758            run gbl/pause.p (vint * 1000).
      759         end.
      760         if iInterval ne ?
      761         then
      762            publish "WaitFramStop".
      763         waitfram-check-timeout().
      764      end.
      765      procedure WaitFramWaitFor:
      766         define input  parameter iInterval as dec no-undo.
      767         assign
      768            mWaitFramStartProc   = now
      769            mWaitFramStopUser    = no
      770            mWaitFramStopTimeOut = no
      771         .
      772         block-wait:
      773         do while not mWaitFramStop:
      774            run WaitFramRunPause (iInterval).
      775            if  waitfram-check-timeout()
      776            then do:
      777               leave block-wait.
      778            end.
      779         end.
      780         run waitfram-hide.
      781      end.
      782   procedure waitfram-join :
      783     define input  parameter p-line-1  as character no-undo .
      784     define input  parameter p-line-2  as character no-undo .
      785     define input  parameter p-line-3  as character no-undo .
      786     define output parameter p-message as character no-undo .
      787     do
      788     on error undo, return error return-value
      789     :
      790       assign
      791         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      792                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      793                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      794       .
      795     end.
      796   end procedure.
      797   function waitfram-join-function returns character
      798     (input p-line-1 as character
      799     ,input p-line-2 as character
      800     ,input p-line-3 as character
      801     ).
      802     define variable v-message as character no-undo .
      803     run waitfram-join in this-procedure
      804       (input  p-line-1
      805       ,input  p-line-2
      806       ,input  p-line-3
      807       ,output v-message
      808       ) .
      809     return v-message .
      810   end function .
      811   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      812   define new global shared variable g#trdcalib as handle no-undo.
      813   DEFINE VARIABLE doc-line-rec as recid no-undo.
      814   define variable lns-cnt as integer no-undo .
      815   define variable line-rec as recid no-undo .
      816   define variable gds-rec as recid no-undo .
      817   DEFINE BUFFER buf_sale-doc FOR ub.sale-doc.
      818   define buffer buf_inkas for ub.inkas.
      819   DEFINE BUTTON b-help
      820        LABEL "Помо&щь"
      821        SIZE 10 BY 1
      822        BGCOLOR 8 .
