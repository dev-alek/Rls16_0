     1736       else do:
     1737         for each buf_temp-diasize-handle
     1738         on error undo move_block, retry move_block
     1739         :
     1740           assign
     1741             v-object-handle = buf_temp-diasize-handle.handle-value
     1742           .
     1743           if v-object-handle <> v-diasize-resize-button
     1744           then do:
     1745             assign
     1746               v-object-handle :col = v-object-handle :col + p-change-value
     1747               no-error .
     1748             if error-status :error
     1749             or error-status :get-message(1) <> ""
     1750             then do:
     1751               undo move_block, retry move_block .
     1752             end.
     1753           end.
     1754         end.
     1755         for each buf_temp-browse-handle
     1756           where buf_temp-browse-handle.browse-type = 'width':u
     1757         on error undo move_block, retry move_block
     1758         :
     1759           assign
     1760             buf_temp-browse-handle.browse-handle :width
     1761               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1762             no-error .
     1763           if error-status :error
     1764           or error-status :get-message(1) <> ""
     1765           then do:
     1766             undo move_block, retry move_block .
     1767           end.
     1768         end.
     1769         assign
     1770           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1771           no-error .
     1772         if error-status :error
     1773         or error-status :get-message(1) <> ""
     1774         then do:
     1775           undo move_block, retry move_block.
     1776         end.
     1777         assign
     1778           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1779         no-error .
     1780         if error-status :error
     1781         or error-status :get-message(1) <> ""
     1782         then do:
     1783           undo move_block, retry move_block.
     1784         end.
     1785         if frame Dialog-Frame :scrollable = true
     1786         then do:
     1787           assign
     1788             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1789           no-error .
     1790           if error-status :error
     1791           or error-status :get-message(1) <> ""
     1792           then do:
     1793             undo move_block, retry move_block.
     1794           end.
     1795         end.
     1796       end.
     1797       if p-move-resize
     1798       then do:
     1799         run diasize_position-resize-button in this-procedure .
     1800       end.
     1801       if v-diasize-wndstore = true
     1802       then do:
     1803         if connected("ub") = true
     1804         then do:
     1805           define variable v-cntxt-db-num        as integer   no-undo .
     1806           define variable v-cntxt-userid        as character no-undo .
     1807           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1808                                             , OUTPUT v-cntxt-userid
     1809                                             ) .
     1810           run gbl/wndsizew.p
     1811             (input  v-cntxt-db-num
     1812             ,input  v-cntxt-userid
     1813             ,input  v-diasize-proc-name
     1814             ,input  'width':u
     1815             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1816             ) .
     1817         end.
     1818       end.
     1819     end.
     1820     assign
     1821       v-diasize-change-size = false
     1822     .
     1823   end procedure.
     1824   procedure diasize_set-width :
     1825     define input  parameter p-new-width  as decimal   no-undo .
     1826     define input  parameter p-move-resize as logical   no-undo .
     1827     do
     1828     on error undo, return error return-value
     1829     :
     1830       run diasize_change-width in this-procedure
     1831         (input  (p-new-width - frame Dialog-Frame :width)
     1832         ,input  p-move-resize
     1833         ) .
     1834     end.
     1835   end procedure.
     1836   procedure diasize_position-resize-button :
     1837     do with frame Dialog-Frame
     1838     :
     1839       hide v-diasize-resize-button .
     1840       assign
     1841         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1842                     - 1
     1843                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1844         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1845                     - 1
     1846                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1847       .
     1848       view v-diasize-resize-button .
     1849     end.
     1850   end procedure.
     1851   on alt-right anywhere
     1852   do:
     1853     run diasize_change-width in this-procedure
     1854       (input 1
     1855       ,input true
     1856       ) .
     1857     return no-apply .
     1858   end.
     1859   on alt-left anywhere
     1860   do:
     1861     run diasize_change-width in this-procedure
     1862       (input -1
     1863       ,input true
     1864       ) .
     1865     return no-apply .
     1866   end.
     1867   on alt-down anywhere
     1868   do:
     1869     run diasize_change-height in this-procedure
     1870       (input 1
     1871       ,input true
     1872       ) .
     1873     return no-apply .
     1874   end.
     1875   on alt-up anywhere
     1876   do:
     1877     run diasize_change-height in this-procedure
     1878       (input -1
     1879       ,input true
     1880       ) .
     1881     return no-apply .
     1882   end.
     1883   on alt-enter of frame Dialog-Frame
     1884   do:
     1885     run diasize_maximize in this-procedure
     1886       (input  ?
     1887       ).
     1888     return no-apply .
     1889   end.
     1890   procedure diasize_end-move :
     1891     do
     1892     on error undo, return error return-value
     1893     :
     1894       define variable v-row-delta as decimal   no-undo .
     1895       define variable v-col-delta as decimal   no-undo .
     1896       define variable v-new-row as decimal   no-undo .
     1897       define variable v-new-col as decimal   no-undo .
     1898       assign
     1899         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1900         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1901       .
     1902       assign
     1903         v-row-delta = v-new-row - frame Dialog-Frame :height
     1904         v-col-delta = v-new-col - frame Dialog-Frame :width
     1905       .
     1906       run diasize_change-height in this-procedure
     1907         (input v-row-delta
     1908         ,input true
     1909         ) .
     1910       run diasize_change-width in this-procedure
     1911         (input v-col-delta
     1912         ,input true
     1913         ) .
     1914     end.
     1915   end procedure.
     1916   procedure diasize_maximize :
     1917     define input  parameter p-action as logical   no-undo .
     1918     do
     1919     on error undo, return error return-value
     1920     :
     1921       if p-action = ?
     1922       then do:
     1923         if v-diasize-need-maximize = true
     1924         then do:
     1925           assign
     1926             p-action = true
     1927           .
     1928         end.
     1929         else do:
     1930           assign
     1931             p-action = false
     1932           .
     1933         end.
     1934       end.
     1935       if p-action = true
     1936       then do:
     1937         run diasize_change-height in this-procedure
     1938           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1939               - frame Dialog-Frame :height-chars
     1940           ,input true
     1941           ) .
     1942         run diasize_change-width in this-procedure
     1943           (input session :width-chars
     1944               - frame Dialog-Frame :width-chars
     1945           ,input true
     1946           ) .
     1947         assign
     1948           v-diasize-need-maximize = false
     1949         .
     1950       end.
     1951       else do:
     1952         run diasize_change-width in this-procedure
     1953           (input v-diasize-orig-frame-width
     1954               - frame Dialog-Frame :width-chars
     1955           ,input true
     1956           ) .
     1957         run diasize_change-height in this-procedure
     1958           (input v-diasize-orig-frame-height
     1959               - frame Dialog-Frame :height-chars
     1960           ,input true
     1961           ) .
     1962         assign
     1963           v-diasize-need-maximize = true
     1964         .
     1965       end.
     1966     end.
     1967   end procedure.
     1968   procedure diasize_restore-orig-size :
     1969     do
     1970     on error undo, return error return-value
     1971     :
     1972       assign
     1973         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1974         v-diasize-current-frame-height = frame Dialog-Frame :height
     1975       .
     1976       run diasize_set-height in this-procedure
     1977         (input  v-diasize-orig-frame-height
     1978         ,input  true
     1979         ) .
     1980       run diasize_set-width in this-procedure
     1981         (input  v-diasize-orig-frame-width
     1982         ,input  true
     1983         ) .
     1984     end.
     1985   end procedure.
     1986   procedure diasize_restore-current-size :
     1987     do
     1988     on error undo, return error return-value
     1989     :
     1990       run diasize_set-height in this-procedure
     1991         (input  v-diasize-current-frame-height
     1992         ,input  true
     1993         ) .
     1994       run diasize_set-width in this-procedure
     1995         (input  v-diasize-current-frame-width
     1996         ,input  true
     1997         ) .
     1998     end.
     1999   end procedure.
     2000   procedure diasize_set-browse-handle :
     2001     define input  parameter p-browse-handle as handle   no-undo .
     2002     define buffer buf_temp-browse-handle for temp-browse-handle .
     2003     do
     2004     on error undo, return error return-value
     2005     :
     2006       assign
     2007         v-diasize-browse-handle = p-browse-handle
     2008       .
     2009       for each buf_temp-browse-handle
     2010       on error undo, return error return-value
     2011       :
     2012         delete buf_temp-browse-handle .
     2013       end.
     2014     end.
     2015   end procedure.
     2016   procedure diasize_add_browse :
     2017     define input  parameter p-browse-type   as character no-undo .
     2018     define input  parameter p-browse-handle as handle    no-undo .
     2019     define buffer buf_temp-browse-handle for temp-browse-handle .
     2020     do
     2021     on error undo, return error return-value
     2022     :
     2023       assign
     2024         v-diasize-browse-number = v-diasize-browse-number + 1
     2025       .
     2026       create buf_temp-browse-handle .
     2027       assign
     2028         buf_temp-browse-handle.browse-type   = p-browse-type
     2029         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2030         buf_temp-browse-handle.browse-handle = p-browse-handle
     2031       .
     2032     end.
     2033   end procedure.
     2034   procedure diasize_init :
     2035     define variable v-default-value    as logical   no-undo .
     2036     define variable v-restore-saved    as logical   no-undo .
     2037     define variable v-resize-value-str as character no-undo .
     2038     do
     2039     on error undo, return error return-value
     2040     :
     2041       do with frame Dialog-Frame
     2042       :
     2043         assign
     2044           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2045           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2046           v-diasize-browse-handle     = browse BR-badprts :handle
     2047         .
     2048         create button v-diasize-resize-button
     2049         assign
     2050           parent        = frame Dialog-Frame :first-child
     2051           label         = "s"
     2052           height-pixels = 16
     2053           width-pixels  = 16
     2054           visible       = true
     2055           sensitive     = true
     2056           movable       = true
     2057           triggers:
     2058             on end-move persistent run diasize_end-move in this-procedure .
     2059           end triggers.
     2060         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2061         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2062         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2063         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2064         assign
     2065           v-diasize-wndmax = false
     2066         .
     2067         if connected("ub") = true
     2068         then do:
     2069           define variable v-cntxt-db-num        as integer   no-undo .
     2070           define variable v-cntxt-userid        as character no-undo .
     2071           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2072                                             , OUTPUT v-cntxt-userid
     2073                                             ) .
     2074           run gbl/wndpar_r.p
     2075             (input  v-cntxt-db-num
     2076             ,input  v-cntxt-userid
     2077             ,input  'wndmax':U
     2078             ,output v-diasize-wndmax
     2079             ,output v-default-value
     2080             ) .
     2081         end.
     2082         assign
     2083           v-diasize-wndstore = false
     2084         .
     2085         if connected("ub") = true
     2086         then do:
     2087           run gbl/wndpar_r.p
     2088             (input  v-cntxt-db-num
     2089             ,input  v-cntxt-userid
     2090             ,input  'wndstore':U
     2091             ,output v-diasize-wndstore
     2092             ,output v-default-value
     2093             ) .
     2094         end.
     2095         assign
     2096           v-diasize-proc-name = entry(1, program-name(2), '.')
     2097         .
     2098         if v-diasize-wndstore = true
     2099         then do:
     2100           assign
     2101             v-restore-saved = false
     2102           .
     2103           if connected("ub") = true
     2104           then do:
     2105             run gbl/wndsizer.p
     2106               (input  v-cntxt-db-num
     2107               ,input  v-cntxt-userid
     2108               ,input  v-diasize-proc-name
     2109               ,input  'height':u
     2110               ,output v-resize-value-str
     2111               ) .
     2112             if v-resize-value-str <> '':U
     2113             then do:
     2114               run diasize_change-height in this-procedure
     2115                 (input  integer(v-resize-value-str)
     2116                 ,input  true
     2117                 ) .
     2118               assign
     2119                 v-restore-saved = true
     2120               .
     2121             end.
     2122           end.
     2123           if connected("ub") = true
     2124           then do:
     2125             run gbl/wndsizer.p
     2126               (input  v-cntxt-db-num
     2127               ,input  v-cntxt-userid
     2128               ,input  v-diasize-proc-name
     2129               ,input  'width':u
     2130               ,output v-resize-value-str
     2131               ) .
     2132             if v-resize-value-str <> '':U
     2133             then do:
     2134               run diasize_change-width in this-procedure
     2135                 (input  integer(v-resize-value-str)
     2136                 ,input  true
     2137                 ) .
     2138               assign
     2139                 v-restore-saved = true
     2140               .
     2141             end.
     2142           end.
     2143           if v-restore-saved <> true
     2144           then do:
     2145             if v-diasize-wndmax = true
     2146             then do:
     2147               run diasize_maximize in this-procedure
     2148                 (input  true
     2149                 ) .
     2150             end.
     2151           end.
     2152         end.
     2153         else do:
     2154           if v-diasize-wndmax = true
     2155           then do:
     2156             run diasize_maximize in this-procedure
     2157               (input  true
     2158               ) .
     2159           end.
     2160         end.
     2161       end.
     2162     end.
     2163   end procedure.
     2164   procedure diasize_need-full-display :
     2165     define output parameter p-need-full-display as logical   no-undo .
     2166     do
     2167     on error undo, return error return-value
     2168     :
     2169       assign
     2170         p-need-full-display = v-diasize-need-full-display
     2171       .
     2172       assign
     2173         v-diasize-need-full-display = false
     2174       .
     2175     end.
     2176   end procedure.
     2177   procedure get-context :
     2178      define output parameter p-db-num as integer          no-undo.
     2179      define output parameter p-user-id as character        no-undo.
     2180      define variable v-login               as character    no-undo.
     2181      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2182      define buffer buf_user-login  for ub.user-login .
     2183      do
     2184      on error undo, return error
     2185      :
     2186            FIND FIRST buf_sys-ctrl no-lock.
     2187            ASSIGN
     2188               v-login = USERID("ub")
     2189               p-db-num = buf_sys-ctrl.db-num
     2190            .
     2191            FIND FIRST buf_user-login
     2192                 WHERE buf_user-login.db-num = p-db-num
     2193                   AND buf_user-login.user-login = v-login
     2194                 no-lock
     2195                 no-error
     2196                 .
     2197            IF AVAILABLE buf_user-login
     2198            THEN DO:
     2199               assign
     2200                  p-user-id = buf_user-login.user-id
     2201               .
     2202            END.
     2203      end.
     2204   end procedure.
     2205       run diasize_init in this-procedure .
     2206   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2207   on F9 of frame Dialog-Frame anywhere do:
     2208     if not available ub.goods then
     2209       return no-apply.
     2210     gds-rec = recid (ub.goods).
     2211     run ref/gds-form.w ( input parparentproc
     2212                         ,input 'ПРОСМОТР':U
     2213                         ,input ?
     2214                         ,input ?
     2215                         ,input ?
     2216                         ,input-output gds-rec).
     2217     apply "entry" to br-badprts in frame Dialog-Frame.
     2218     return no-apply.
     2219   end.
     2220   MAIN-BLOCK:
     2221   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2222      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2223     find FIRST buf_inkas where recid (buf_inkas) = p-doc-rec no-lock no-error.
     2224     RUN enable_UI.
     2225     run waitfram-show in this-procedure ( input "Ждите...").
     2226     FOR EACH gds-list :
     2227         delete gds-list .
     2228     END .
     2229     for each buf_sale-doc where
     2230             buf_sale-doc.inkas-code = buf_inkas.inkas-code:
     2231        if buf_sale-doc.doc-kind = 'rwo':U then NEXT.
     2232         if CAN-FIND(First doc-line where doc-line.doc-code = buf_sale-doc.doc-code AND
     2233                                      doc-line.doc-qnty < doc-line.fact-qnty) then do:
     2234         run waitfram-hide in this-procedure .
     2235         FILL-INFO = "Данные неполные - не на весь проданный товар выделен резерв!!!".
     2236         DISPLAY FILL-INFO with frame Dialog-Frame.
     2237       end.
     2238     end.
     2239     run waitfram-hide in this-procedure .
     2240     WAIT-FOR GO OF FRAME Dialog-Frame.
     2241   END.
     2242   RUN disable_UI.
     2243   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2244   DEF VAR cur-clmn-numbr-badprts as INT EXTENT 10 no-undo.
     2245   DEF VAR varmvibr-badprts       as INT no-undo.
     2246   DEF VAR varmvjbr-badprts       as INT no-undo.
     2247   DEF VAR varmvkbr-badprts       as INT no-undo.
     2248   DEF VAR varmvlbr-badprts       as INT no-undo.
     2249   DEF VAR move-elementbr-badprts as INT no-undo.
     2250   def var jjbr-badprts           as int no-undo.
     2251   do varmvibr-badprts = 1 to EXTENT(cur-clmn-numbr-badprts):
     2252     ASSIGN cur-clmn-numbr-badprts[varmvibr-badprts] = varmvibr-badprts.
     2253   END.
     2254   RUN start-mv-clmnbr-badprts.
     2255   PROCEDURE start-mv-clmnbr-badprts:
     2256   def var old-session as logical no-undo.
     2257      old-session = SESSION:IMMEDIATE-DISPLAY.
     2258      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2259      SESSION:IMMEDIATE-DISPLAY = old-session.
     2260   END.
     2261   ON ctrl-cursor-right OF BROWSE br-badprts do:
     2262     RUN re-move-clmnbr-badprts ( 4, 10).
     2263   END.
     2264   ON ctrl-cursor-left OF BROWSE br-badprts do:
     2265     RUN re-move-clmnbr-badprts (10, 4).
     2266   END.
     2267   PROCEDURE re-move-clmnbr-badprts:
     2268     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2269     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2270     DO varmvibr-badprts = 1 TO EXTENT(cur-clmn-numbr-badprts):
     2271       if cur-clmn-numbr-badprts[varmvibr-badprts] = source-column THEN cur-clmn-numbr-badprts[varmvibr-badprts] = -1.
     2272     END.
     2273     if br-badprts:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2274     if source-column > target-column THEN
     2275     DO varmvjbr-badprts = source-column - 1 to target-column BY -1:
     2276       DO varmvibr-badprts = 1 TO EXTENT(cur-clmn-numbr-badprts):
     2277           if cur-clmn-numbr-badprts[varmvibr-badprts] = varmvjbr-badprts THEN DO:
     2278             cur-clmn-numbr-badprts[varmvibr-badprts] = cur-clmn-numbr-badprts[varmvibr-badprts] + 1.
     2279           END.
     2280       END.
     2281     END.
     2282     ELSE
     2283     DO varmvjbr-badprts = source-column + 1 to target-column:
     2284       DO varmvibr-badprts = 1 TO EXTENT(cur-clmn-numbr-badprts):
     2285         if cur-clmn-numbr-badprts[varmvibr-badprts] = varmvjbr-badprts THEN DO:
     2286           cur-clmn-numbr-badprts[varmvibr-badprts] = cur-clmn-numbr-badprts[varmvibr-badprts] - 1.
     2287         END.
     2288       END.
     2289     END.
     2290     DO varmvibr-badprts = 1 TO EXTENT(cur-clmn-numbr-badprts):
     2291       if cur-clmn-numbr-badprts[varmvibr-badprts] = -1 THEN cur-clmn-numbr-badprts[varmvibr-badprts] = target-column.
     2292     END.
     2293   END PROCEDURE.
     2294   PROCEDURE ch-clmnbr-badprts:
     2295     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2296     if cur-clmn-loc <= 4 then do:
     2297       return .
     2298     end.
     2299     DO varmvibr-badprts = 1 TO EXTENT(cur-clmn-numbr-badprts):
     2300       if cur-clmn-numbr-badprts[varmvibr-badprts] = cur-clmn-loc THEN move-elementbr-badprts = varmvibr-badprts.
     2301     END.
     2302     RUN re-move-clmnbr-badprts (cur-clmn-loc, 4).
     2303   END PROCEDURE.
     2304   PROCEDURE mv-brw-defaultbr-badprts:
     2305   def var old-session as logical no-undo.
     2306     old-session = SESSION:IMMEDIATE-DISPLAY.
     2307     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2308     do varmvlbr-badprts = 4 to EXTENT(cur-clmn-numbr-badprts):
     2309       RUN re-move-clmnbr-badprts (cur-clmn-numbr-badprts[varmvlbr-badprts], varmvlbr-badprts).
     2310     END.
     2311     RUN start-mv-clmnbr-badprts.
     2312     SESSION:IMMEDIATE-DISPLAY = old-session.
     2313   END PROCEDURE.
     2314   .
     2315   PROCEDURE disable_UI :
     2316     HIDE FRAME Dialog-Frame.
     2317   END PROCEDURE.
     2318   PROCEDURE enable_UI :
     2319     DISPLAY FILL-INFO prod-name
     2320         WITH FRAME Dialog-Frame.
     2321     ENABLE Btn_Cancel b-print b-list b-help BR-badprts FILL-INFO prod-name
     2322         WITH FRAME Dialog-Frame.
     2323     VIEW FRAME Dialog-Frame.
     2324     OPEN QUERY BR-badprts FOR EACH buf_sale-doc WHERE     buf_sale-doc.inkas-code = buf_inkas.inkas-code     AND buf_sale-doc.doc-kind <> 'rwo':U,                                    EACH ub.doc-line NO-LOCK       WHERE ub.doc-line.doc-code = buf_sale-doc.doc-code,              EACH ub.parts WHERE ub.parts.artic = ub.doc-line.artic   AND ub.parts.prod-type = ub.doc-line.prod-type  AND  ub.parts.prod-code = ub.doc-line.prod-code       AND parts.obj-type = buf_sale-doc.obj-type  AND parts.obj-code = buf_sale-doc.obj-code  AND ub.parts.out-code = buf_sale-doc.doc-code  AND ub.parts.out-code = parts.in-code NO-LOCK,              first ub.goods NO-LOCK WHERE           ub.goods.artic = ub.doc-line.artic      AND  ub.goods.prod-type = ub.doc-line.prod-type      AND  ub.goods.prod-code = ub.doc-line.prod-code,             FIRST ub.gds-obj NO-LOCK where           ub.gds-obj.obj-type = ub.doc-line.obj-type     AND ub.gds-obj.obj-code = ub.doc-line.obj-code     AND ub.gds-obj.artic = ub.doc-line.artic     AND  ub.gds-obj.prod-type = ub.doc-line.prod-type      AND  ub.gds-obj.prod-code = ub.doc-line.prod-code.
     2325   END PROCEDURE.
     2326   PROCEDURE MyEnable :
     2327   frame Dialog-Frame:title = substitute("&1&2 продажа &3: отрицательные партии в результате закрытия"
     2328                                , buf_inkas.obj-type, buf_inkas.obj-code, buf_inkas.inkas-code) .
     2329   br-badprts:NUM-LOCKED-COLUMNS = 3.
     2330   DISPLAY FILL-INFO prod-name
     2331   WITH FRAME Dialog-Frame.
     2332   ENABLE
     2333   Btn_Cancel
     2334   b-print
     2335   b-list
     2336   b-help
     2337   br-badprts
     2338   FILL-INFO
     2339   prod-name
     2340   WITH FRAME Dialog-Frame.
     2341   VIEW FRAME Dialog-Frame.
     2342   run waitfram-show in this-procedure ( input "Ждите...").
     2343   OPEN QUERY BR-badprts FOR EACH buf_sale-doc WHERE     buf_sale-doc.inkas-code = buf_inkas.inkas-code     AND buf_sale-doc.doc-kind <> 'rwo':U,                                    EACH ub.doc-line NO-LOCK       WHERE ub.doc-line.doc-code = buf_sale-doc.doc-code,              EACH ub.parts WHERE ub.parts.artic = ub.doc-line.artic   AND ub.parts.prod-type = ub.doc-line.prod-type  AND  ub.parts.prod-code = ub.doc-line.prod-code       AND parts.obj-type = buf_sale-doc.obj-type  AND parts.obj-code = buf_sale-doc.obj-code  AND ub.parts.out-code = buf_sale-doc.doc-code  AND ub.parts.out-code = parts.in-code NO-LOCK,              first ub.goods NO-LOCK WHERE           ub.goods.artic = ub.doc-line.artic      AND  ub.goods.prod-type = ub.doc-line.prod-type      AND  ub.goods.prod-code = ub.doc-line.prod-code,             FIRST ub.gds-obj NO-LOCK where           ub.gds-obj.obj-type = ub.doc-line.obj-type     AND ub.gds-obj.obj-code = ub.doc-line.obj-code     AND ub.gds-obj.artic = ub.doc-line.artic     AND  ub.gds-obj.prod-type = ub.doc-line.prod-type      AND  ub.gds-obj.prod-code = ub.doc-line.prod-code.
     2344   APPLY "ENTRY" TO br-badprts.
     2345   APPLY "VALUE-CHANGED" to br-badprts.
     2346   run waitfram-hide in this-procedure .
     2347   END PROCEDURE.
     2348   PROCEDURE PrintProc :
     2349   DEFINE INPUT PARAMETER pmode as character.
     2350   define variable sym1   as char format "X(1)" init ":".
     2351   define variable sym10 as char format "X(1)" init ":".
     2352   define variable date_string     as      char    no-undo.
     2353   define variable Line                as      char    no-undo.
     2354   define variable for-time as char.
     2355   define variable for-price-base as decimal.
     2356   define variable for-price-rubl as decimal.
     2357   define variable accum-count as integer.
     2358   define variable accum-qnty as decimal.
     2359   define variable accum-price-base as decimal.
     2360   define variable accum-price-rubl as decima.
     2361   define variable i as integer no-undo.
     2362   DEFINE FRAME Parts-List
     2363   sym1                     column-label ""                    format "X(1)" space(0)
     2364   ub.doc-line.artic         column-label "Артикул"
     2365   ub.goods.gds-name   column-label "Название товара" format "X(35)"
     2366   ub.goods.unit-base COLUMN-LABEL "Изм."
     2367   ub.parts.fact-qnty COLUMN-LABEL "По партии в -ост."
     2368   ub.parts.price-base COLUMn-LABEL "Учетн.цена!баз.вал."
     2369   for-price-base COLUMn-LABEL "Сумма в!учетн.ценах!баз.вал."   FORMAT "->>>,>>>,>>9.99"
     2370   ub.parts.price-rubl COLUMn-LABEL "Учетн.цена!руб."
     2371   for-price-rubl COLUMn-LABEL "Сумма в!учетн.ценах!руб."        FORMAT "->>>,>>>,>>9.99"
     2372   ub.parts.out-code COLUmn-LABEL "Документ"
     2373   sym10                    column-label " "                   format "X(1)"
     2374   HEADER  date_string AT 5 format "X(35)"
     2375               string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER AT 125 FORMAT ">>9" SKIP
     2376               Line format "X(177)" AT 1
     2377   with width 232 down stream-io use-text    .
     2378   Line = fill("-", 150).
     2379   date_string = cur-time-print() .
     2380   IF pmode = "P" then do:
     2381      run prn-lib-open-stream  in this-procedure (
     2382                                                input parParentProc
     2383                                               ,input 43
     2384                                               ,input yes
     2385                                               ,input no
     2386                                               ).
     2387       PUT  STREAM prnLibStream
     2388       SPACE(25) ( frame Dialog-Frame:title )
     2389       format "x(90)" SKIP(1) .
     2390       FORM HEADER
     2391               Line format "X(150)" AT 1 SKIP
     2392               "Продолжение - на следующей странице" AT 30 SKIP
     2393               with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     2394       VIEW  STREAM prnLibStream FRAME BottomFrame .
     2395       FORM with FRAME Parts-List  .
     2396   END.
     2397       run waitfram-show in this-procedure ( input "Ждите...").
     2398       GET next br-badprts.
     2399       i = 0 .
     2400       DO WHILE available doc-line :
     2401         IF pmode = "P" then do:
     2402           Display STREAM prnLibStream
     2403           sym1
     2404           doc-line.artic
     2405           goods.gds-name
     2406           goods.unit-base
     2407           parts.fact-qnty
     2408           parts.price-base
     2409           parts.price-base * parts.fact-qnty @ for-price-base
     2410           parts.price-rubl
     2411           parts.price-rubl * parts.fact-qnty @ for-price-rubl
     2412           parts.out-code
     2413           sym10
     2414           with FRAME Parts-List .
     2415           DOWN STREAM prnLibStream 1 with FRAME Parts-List  .
     2416           assign
     2417           accum-count = accum-count + 1
     2418           accum-qnty = accum-qnty + parts.fact-qnty
     2419           accum-price-base = accum-price-base + parts.price-base * parts.fact-qnty
     2420           accum-price-rubl = accum-price-rubl + parts.price-rubl * parts.fact-qnty.
     2421         END.
     2422         ELSE do:
     2423   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2424   find gds-list
     2425     where gds-list.prod-type = goods.prod-type
     2426       and gds-list.prod-code = goods.prod-code
     2427       and gds-list.artic     = goods.artic
     2428     no-error .
     2429   if available gds-list then do:
     2430     assign
     2431       gds-list.to-del = no
     2432     .
     2433   end.
     2434   else do:
     2435     define variable v-last13 as integer no-undo .
     2436     find last gds-list use-index oi no-error.
     2437     if available gds-list then do:
     2438       v-last13 = gds-list.order-num .
     2439     end.
     2440     else do:
     2441       v-last13 = 0 .
     2442     end.
     2443     create gds-list .
     2444     buffer-copy goods to gds-list
     2445     assign
     2446       gds-list.to-del = no
     2447       gds-list.order-num = v-last13 + 1
     2448     .
     2449     assign
     2450       lns-cnt = lns-cnt + 1
     2451       line-rec = recid (gds-list)
     2452     .
     2453   end.
     2454         END.
     2455           GET next br-badprts.
     2456       END.
     2457       IF pmode = "P" then do:
     2458         UNDERLINE  STREAM prnLibStream
     2459         sym1
     2460         doc-line.artic
     2461         goods.gds-name
     2462         goods.unit-base
     2463         parts.fact-qnty
     2464         parts.price-base
     2465         for-price-base
     2466         parts.price-rubl
     2467         for-price-rubl
     2468         parts.out-code
     2469         sym10
     2470         with FRAME Parts-List .
     2471       DISPLAY STREAM prnLibStream
     2472       "ИТОГО"  @ doc-line.artic
     2473       "-партий: " + string(accum-count) @ goods.gds-name
     2474       accum-qnty @ parts.fact-qnty
     2475       accum-price-base @ for-price-base
     2476       accum-price-rubl @ for-price-rubl
     2477       with frame Parts-List.
     2478       HIDE  STREAM prnLibStream FRAME BottomFrame .
     2479       HIDE  STREAM prnLibStream FRAME CheckList.
     2480       output  STREAM prnLibStream CLOSE.
     2481       END.
     2482       run waitfram-hide in this-procedure .
     2483       if pmode = "P" then
     2484       run prn-lib-prn-file in this-procedure (
     2485                                             input parParentProc
     2486                                             ,input 8
     2487                                             ).
     2488   END PROCEDURE.
