      345   define  stream PrnLibStream.
      346   procedure prn-lib-prn-file :
      347     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      348     define input parameter p-DIsabledoptions as integer no-undo .
      349     define variable v-report-name as character no-undo .
      350     define variable v-user-action as character no-undo .
      351     define variable v-printed     as logical   no-undo .
      352     define variable v-exist       as logical   no-undo .
      353     do
      354       on error undo, return error
      355       :
      356       run prn-lib-get-report-name  in this-procedure (
      357         input parParentProc
      358         ,output v-report-name
      359         ).
      360   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      361   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      362     (input  v-report-name
      363     ,input  2
      364     ,output v-exist
      365     )  .
      366       if NOT v-exist then
      367       DO:
      368         Message
      369           "Нет заданий на печать ! "
      370           view-as alert-box .
      371         Return  .
      372       End.
      373       run gbl/prnfilen.w
      374         (input  ""
      375         ,input  p-DisabledOptions
      376         ,input  string(v-report-name )
      377         ,input  7
      378         ,output v-user-action
      379         ,output v-printed
      380         ) .
      381       if v-printed then
      382       do:
      383         return "YES" .
      384       end.
      385       else
      386       do:
      387         return "NO" .
      388       end.
      389     end.
      390   end procedure.
      391   procedure prn-lib-open-stream :
      392     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      393     define input parameter p-page-size    as integer no-undo .
      394     define input parameter p-is-stream    as logical no-undo .
      395     define input parameter p-append       as logical no-undo .
      396     define variable v-report-name as character no-undo .
      397     do
      398       on error undo, return error
      399       :
      400       run prn-lib-get-report-name  in this-procedure (
      401         input parParentProc
      402         ,output v-report-name
      403         ).
      404       if p-is-stream then
      405       do:
      406         if p-append then
      407         do:
      408           output stream PrnLibStream to value( v-report-name )
      409             page-size value(p-page-size) append .
      410         end.
      411         if not p-append then
      412         do:
      413           output stream PrnLibStream to value( v-report-name )
      414             page-size value(p-page-size) .
      415         end.
      416       end.
      417       if not p-is-stream then
      418       do:
      419         if p-append then
      420         do:
      421           output to value( v-report-name )
      422             page-size value(p-page-size) append .
      423         end.
      424         if not p-append then
      425         do:
      426           output to value( v-report-name )
      427             page-size value(p-page-size) .
      428         end.
      429       end.
      430     end.
      431   end procedure.
      432   procedure prn-lib-open-exp :
      433     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      434     define input parameter p-is-stream    as logical no-undo .
      435     define input parameter p-is-append    as logical no-undo .
      436     define output parameter p-ReportFileName as char init "report" no-undo.
      437     define output parameter p-process as logical no-undo .
      438     define variable glog as logical no-undo .
      439     do
      440       on error undo, return error
      441       :
      442       SYSTEM-DIALOG GET-FILE p-ReportFileName
      443         TITLE      "Укажите путь"
      444         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      445         ASK-OVERWRITE
      446         CREATE-TEST-FILE
      447         SAVE-AS
      448         USE-FILENAME
      449         DEFAULT-EXTENSION "txt"
      450         UPDATE glog
      451         .
      452       if not glog then  return.
      453       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      454       if p-is-stream then
      455       do:
      456         if p-is-append then
      457         do:
      458           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      459         end.
      460         else
      461         do:
      462           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      463         end.
      464       end.
      465       else
      466       do:
      467         if p-is-append then
      468         do:
      469           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      470         end.
      471         else
      472         do:
      473           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      474         end.
      475       end.
      476       p-process = yes.
      477     end.
      478   end procedure.
      479   procedure prn-lib-get-report-name :
      480     define input parameter parParentProc  as widget-handle no-undo.
      481     define output parameter p-report-name as character no-undo .
      482     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      483   end procedure.
      484   procedure prn-lib-reportviewer-report-name :
      485     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      486     define input parameter p-report-name-html as character no-undo .
      487     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      488   end procedure.
      489   procedure prn-lib-reportviewer :
      490     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      491     define input parameter p-report-name-html as character no-undo .
      492     define input parameter p-param        as character no-undo .
      493     define variable v-excel           as character no-undo init 'TRUE' .
      494     define variable v-value-character as character no-undo .
      495     define variable v-value-integer   as character no-undo .
      496     define variable v-value-date      as date      no-undo .
      497     define variable v-value-decimal   as decimal   no-undo .
      498     define variable rep-excel         as logical   no-undo .
      499     define variable excel-string      as character no-undo .
      500     define variable v-param-type      as character no-undo .
      501     define variable v-tth             as handle    no-undo .
      502     run adm/shattri.p (
      503       input "get":U
      504       ,input  ""
      505       ,input  0
      506       ,input  'report-glob':U
      507       ,input  'rep-excel':U
      508       ,output v-value-character
      509       ,output v-value-date
      510       ,output v-value-decimal
      511       ,output v-value-integer
      512       ,output rep-excel
      513       ,output v-param-type
      514       ,INPUT-OUTPUT table-handle v-tth
      515       )  .
      516     if rep-excel then v-excel = "TRUE" .
      517     else v-excel = "FALSE" .
      518     if p-param eq ""
      519     then
      520        p-param = "EXCEL:" + v-excel.
      521     else
      522        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      523     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      524   end procedure.
