        1   define input  parameter p-root-node as integer   no-undo .
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Показать признаки шкалы".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   procedure proc-alt-shift-f2:
       67     if not ibs.th.gbl.gbl-var:rcode
       68   then
       69     run gbl\inidebug.p .
       70   end.
       71   procedure proc-alt-shift-f3:
       72     run gbl/prvssinf.p
       73       ( input this-procedure
       74       ) .
       75   end.
       76   define variable v-inform-launched as logical no-undo initial false .
       77   procedure proc-alt-shift-f4:
       78     define variable v-action as character no-undo .
       79     if v-inform-launched = false then do:
       80       assign
       81         v-inform-launched = true
       82       .
       83       run gbl/d-inform.w
       84         (  input self
       85         ,  input this-procedure
       86         , output v-action
       87         ) no-error .
       88       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       89       assign
       90         v-inform-launched = false
       91       .
       92     end.
       93   end.
       94   procedure proc-alt-f1:
       95     run gbl/corrhelp.p
       96       (input this-procedure
       97       ) .
       98   end .
       99   on alt-shift-f2 anywhere do:
      100     run proc-alt-shift-f2.
      101   end.
      102   on alt-shift-f3 anywhere do:
      103     run proc-alt-shift-f3 in this-procedure .
      104   end.
      105   on alt-shift-f4 anywhere do:
      106     run proc-alt-shift-f4 in this-procedure.
      107   end.
      108   on alt-f1 anywhere do:
      109     run proc-alt-f1 in this-procedure .
      110   end.
      111   define variable v-upper-code as integer   no-undo .
      112   DEFINE BUTTON b-exit AUTO-GO
      113        LABEL "&Выход"
      114        SIZE 10 BY 1
      115        BGCOLOR 8 .
      116   DEFINE BUTTON b-help
      117        LABEL "Помо&щь"
      118        SIZE 10 BY 1
      119        BGCOLOR 8 .
      120   DEFINE VARIABLE fi-scale-name AS CHARACTER FORMAT "X(256)":U
      121        LABEL "Название шкалы"
      122         VIEW-AS TEXT
      123        SIZE 68.5 BY .67 NO-UNDO.
      124   DEFINE QUERY BROWSE-level FOR
      125         ub.lvl-name SCROLLING.
      126   DEFINE QUERY BROWSE-prt FOR
      127         ub.gds-prt SCROLLING.
      128   DEFINE BROWSE BROWSE-level
      129     QUERY BROWSE-level DISPLAY
      130         ub.lvl-name.lvl-name
      131       WITH NO-ROW-MARKERS SEPARATORS SIZE 21.75 BY 11.92.
      132   DEFINE BROWSE BROWSE-prt
      133     QUERY BROWSE-prt DISPLAY
      134         node-name format "x(16)"
      135       WITH NO-ROW-MARKERS SEPARATORS SIZE 30 BY 11.83.
      136   DEFINE FRAME Dialog-Frame
      137        b-exit AT ROW 1 COL 1
      138        b-help AT ROW 1 COL 11
      139        BROWSE-level AT ROW 4 COL 9.13
      140        BROWSE-prt AT ROW 4 COL 41.75
      141        fi-scale-name AT ROW 2.38 COL 16 COLON-ALIGNED
      142        SPACE(2.74) SKIP(14.19)
      143       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      144            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      145            TITLE "Просмотр шкалы"
      146            DEFAULT-BUTTON b-exit.
      147   ASSIGN
      148          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      149          FRAME Dialog-Frame:HIDDEN           = TRUE.
      150   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      151   DO:
      152     APPLY "END-ERROR":U TO SELF.
      153   END.
      154   ON VALUE-CHANGED OF BROWSE-level IN FRAME Dialog-Frame
      155   DO:
      156     run open-query-gds-prt in this-procedure .
      157   END.
      158   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      159   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      160   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      161   on help of frame Dialog-Frame
      162   do:
      163     run gbl/app_help.p
      164       (input this-procedure :file-name
      165       ,input ''
      166       ,input ?
      167       ) no-error.
      168     if error-status :error then do:
      169       message
      170         "Ошибка при вызове помощи"
      171         error-status :get-message(1)
      172         view-as alert-box .
      173     end.
      174   end.
      175   run minbtn-set in this-procedure .
      176   on choose of b-help in frame Dialog-Frame
      177   do:
      178     apply "help":u to frame Dialog-Frame .
      179   end.
      180   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      181   procedure minbtn-set :
      182       do
      183           on error undo, return error return-value
      184           :
      185           define variable ii              as integer       no-undo .
      186           define variable fh              as widget-handle no-undo .
      187           define variable hh              as widget-handle no-undo .
      188           define variable v-h             as handle        extent 4 no-undo .
      189           define variable v-name-button   as character     no-undo .
      190           define variable v-help-old-x    as decimal       no-undo .
      191           define variable v-help-old-y    as decimal       no-undo .
      192           define variable v-help-old-size as decimal       no-undo .
      193           define variable v-frame-width   as decimal       no-undo .
      194           define variable jj              as integer       no-undo .
      195           do
      196               on error undo, return error
      197               :
      198               assign
      199                   v-frame-width = frame Dialog-Frame:width - 0.3
      200                   fh            = frame Dialog-Frame:first-child
      201                   hh            = fh:first-child
      202                   ii            = 1
      203                   .
      204               do while valid-handle(hh):
      205                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      206                   do:
      207                       case lc(hh:name) :
      208                           when "b-help" then
      209                               do:
      210                                   hh:load-image-up("cmp/b-help.bmp":u) .
      211                                   hh:load-image-down("cmp/b-help.bmp":u) .
      212                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      213                                   hh:TOOLTIP = "Помощь" .
      214                                   v-help-old-x = hh:column .
      215                                   v-help-old-y = hh:row    .
      216                                   v-help-old-size = hh:width .
      217                                   hh:width-chars = 2.5 .
      218                               end.
      219                           when "b-print" then
      220                               do:
      221                                   hh:load-image("cmp/b-print.bmp":u) .
      222                                   hh:TOOLTIP = "Печать" .
      223                                   v-h[ii] = hh:handle .
      224                                   ii = ii + 1 .
      225                                   hh:width-chars = 3 .
      226                               end.
      227                           when "b-history" or
      228                           when "b-hist" then
      229                               do:
      230                                   hh:load-image("cmp/b-hist.bmp":u) .
      231                                   hh:TOOLTIP = "История" .
      232                                   v-h[ii] = hh:handle .
      233                                   ii = ii + 1 .
      234                                   hh:width-chars = 3 .
      235                               end.
      236                           when "b-sch" then
      237                               do:
      238                                   hh:load-image("cmp/b-sch.bmp":u) .
      239                                   hh:TOOLTIP = "Установка Фильтра" .
      240                                   v-h[ii] = hh:handle .
      241                                   ii = ii + 1 .
      242                                   hh:width-chars = 3 .
      243                               end.
      244                           when "b-hist-user" then
      245                               do:
      246                                   hh:load-image("cmp/b-hist.bmp":u) .
      247                                   hh:TOOLTIP = "История пользователя" .
      248                                   ii = ii + 1 .
      249                               end.
      250                       end case.
      251                   end.
      252                   hh = hh:next-sibling.
      253               end.
      254               b-help:column = v-frame-width - b-help:width-chars.
      255               jj = 0.
      256               repeat ii = 4 to 1 by -1 :
      257                   if valid-handle (v-h[ii] ) then
      258                   do:
      259                       jj  = jj + 1 .
      260                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      261                       v-h[ii]:row    = v-help-old-y .
      262                   end.
      263               end.
      264           end.
      265       end.
      266   end procedure.
      267   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      268   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      269   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      270   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      271   define variable v-diasize-current-frame-width  as decimal   no-undo .
      272   define variable v-diasize-current-frame-height as decimal   no-undo .
      273   define variable v-diasize-change-size          as logical   no-undo .
      274   define variable v-diasize-resize-button        as handle    no-undo .
      275   define variable v-diasize-wndmax               as logical   no-undo .
      276   define variable v-diasize-wndstore             as logical   no-undo .
      277   define variable v-diasize-proc-name            as character no-undo .
      278   define variable v-diasize-browse-handle        as handle    no-undo .
      279   define variable v-diasize-browse-number        as integer   no-undo .
      280   define variable v-diasize-need-full-display    as logical   no-undo init false .
      281   define temp-table temp-diasize-handle no-undo
      282     field handle-value  as handle
      283     field save-position as decimal
      284     index xpk is primary unique handle-value
      285     .
      286   define temp-table temp-browse-handle no-undo
      287     field browse-type   as character
      288     field browse-number as integer
      289     field browse-handle as handle
      290     field original-size as decimal
      291     index xpk is primary unique browse-type browse-number
      292     index xie browse-type browse-handle
      293   .
      294   procedure diasize_change-height :
      295     define input  parameter p-change-value  as decimal   no-undo .
      296     define input  parameter p-move-resize   as logical   no-undo .
      297     define variable v-field-group-handle    as handle    no-undo .
      298     define variable v-object-handle         as handle    no-undo .
      299     define variable v-frame-height          as decimal   no-undo .
      300     define variable v-frame-virtual-height  as decimal   no-undo .
      301     define variable v-browse-height         as decimal   no-undo .
      302     define variable v-window-height         as decimal   no-undo .
      303     define variable v-window-virtual-height as decimal   no-undo .
      304     define variable v-change-sign           as integer   no-undo .
      305     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      306     define buffer buf_temp-browse-handle  for temp-browse-handle .
      307     if p-change-value > 0
      308     then do:
      309       if frame Dialog-Frame :height + p-change-value
      310           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      311       then do:
      312         assign
      313           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      314                           - (frame Dialog-Frame :height-chars)
      315         .
      316         if p-change-value <= 0
      317         then do:
      318           run diasize_position-resize-button in this-procedure .
      319           return .
      320         end.
      321       end.
      322     end.
      323     if p-change-value < 0
      324     then do:
      325       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      326       then do:
      327         assign
      328           p-change-value = v-diasize-orig-frame-height
      329                          - (frame Dialog-Frame :height-chars)
      330         .
      331         if p-change-value >= 0
      332         then do:
      333           run diasize_position-resize-button in this-procedure .
      334           return .
      335         end.
      336       end.
      337     end.
      338     if p-change-value >= 0
      339     then do:
      340       assign
      341         v-change-sign = 1
      342       .
      343     end.
      344     else do:
      345       assign
      346         v-change-sign = -1
      347       .
      348     end.
      349     assign
      350       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      351     .
      352     if p-change-value = 0
      353     then do:
      354       run diasize_position-resize-button in this-procedure .
      355       return .
      356     end.
      357     move_block:
      358     do
      359     on error undo move_block, retry move_block
      360     :
      361       if retry
      362       then do:
      363         do
      364         on error undo move_block, leave move_block
      365         :
      366           if p-change-value > 0
      367           then do:
      368             for each buf_temp-diasize-handle
      369             on error undo, next
      370             :
      371               assign
      372                 v-object-handle = buf_temp-diasize-handle.handle-value
      373               .
      374               if v-object-handle <> v-diasize-resize-button
      375               then do:
      376                 assign
      377                   v-object-handle :row = buf_temp-diasize-handle.save-position
      378                 .
      379               end.
      380             end.
      381             assign
      382               v-diasize-browse-handle :height = v-browse-height
      383             .
      384             for each buf_temp-browse-handle
      385               where buf_temp-browse-handle.browse-type = 'height':u
      386             on error undo, next
      387             :
      388               assign
      389                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      390               .
      391             end.
      392             assign
      393               frame Dialog-Frame :height = v-frame-height
      394             .
      395             if frame Dialog-Frame :scrollable = true
      396             then do:
      397               assign
      398                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      399               .
      400             end.
      401             run diasize_position-resize-button in this-procedure .
      402           end.
      403           else do:
      404             if frame Dialog-Frame :scrollable = true
      405             then do:
      406               assign
      407                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      408               .
      409             end.
      410             assign
      411               frame Dialog-Frame :height = v-frame-height
      412             .
      413             assign
      414               v-diasize-browse-handle :height = v-browse-height
      415             .
      416             for each buf_temp-browse-handle
      417               where buf_temp-browse-handle.browse-type = 'height':u
      418             on error undo, next
      419             :
      420               assign
      421                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      422               .
      423             end.
      424             for each buf_temp-diasize-handle
      425             on error undo, next
      426             :
      427               assign
      428                 v-object-handle = buf_temp-diasize-handle.handle-value
      429               .
      430               if v-object-handle <> v-diasize-resize-button
      431               then do:
      432                 assign
      433                   v-object-handle :row = buf_temp-diasize-handle.save-position
      434                 .
      435               end.
      436             end.
      437             run diasize_position-resize-button in this-procedure .
      438           end.
      439           assign
      440             v-diasize-change-size = false
      441           .
      442           leave move_block .
      443         end.
      444       end.
      445       assign
      446         v-diasize-need-full-display = true
      447       .
      448       if v-diasize-change-size = false
      449       then do:
      450         assign
      451           v-diasize-change-size = true
      452         .
      453       end.
      454       else do:
      455         return .
      456       end.
      457       assign
      458         v-frame-height = frame Dialog-Frame :height
      459         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      460         v-browse-height = v-diasize-browse-handle :height
      461       .
      462       for each buf_temp-browse-handle
      463         where buf_temp-browse-handle.browse-type = 'height':u
      464       :
      465         assign
      466           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      467         .
      468       end.
      469       for each buf_temp-diasize-handle
      470       :
      471         delete buf_temp-diasize-handle .
      472       end.
      473       assign
      474         v-field-group-handle = frame Dialog-Frame :first-child
      475       .
      476       do while valid-handle(v-field-group-handle)
      477       :
      478         assign
      479           v-object-handle = v-field-group-handle :first-child
      480         .
      481         do while valid-handle(v-object-handle)
      482         :
      483           if  v-object-handle <> v-diasize-browse-handle :handle
      484           and can-query(v-object-handle, "row")
      485           and can-query(v-object-handle, "height")
      486           and ( v-object-handle :row > v-diasize-browse-handle :row )
      487           then do:
      488             find first buf_temp-browse-handle
      489               where buf_temp-browse-handle.browse-type   = 'height':u
      490                 and buf_temp-browse-handle.browse-handle = v-object-handle
      491               no-error .
      492             if available buf_temp-browse-handle
      493             then do:
      494             end.
      495             else do:
      496               create buf_temp-diasize-handle .
      497               assign
      498                 buf_temp-diasize-handle.handle-value  = v-object-handle
      499                 buf_temp-diasize-handle.save-position = v-object-handle :row
      500               .
      501             end.
      502           end.
      503           assign
      504             v-object-handle = v-object-handle :next-sibling
      505           .
      506         end.
      507         assign
      508           v-field-group-handle = v-field-group-handle :next-sibling
      509         .
      510       end.
      511       do with frame Dialog-Frame
      512       :
      513         hide v-diasize-resize-button .
      514         assign
      515           v-diasize-resize-button :row    = 1
      516           v-diasize-resize-button :column = 1
      517         .
      518       end.
      519       if p-change-value > 0
      520       then do:
      521         if frame Dialog-Frame :scrollable = true
      522         then do:
      523           assign
      524             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      525             no-error .
      526           if error-status :error
      527           or error-status :get-message(1) <> ""
      528           then do:
      529             undo move_block, retry move_block .
      530           end.
      531         end.
      532         assign
      533           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      534           no-error .
      535         if error-status :error
      536         or error-status :get-message(1) <> ""
      537         then do:
      538           undo move_block, retry move_block .
      539         end.
      540         assign
      541           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      542           no-error .
      543         if error-status :error
      544         or error-status :get-message(1) <> ""
      545         then do:
      546           undo move_block, retry move_block .
      547         end.
      548         for each buf_temp-browse-handle
      549           where buf_temp-browse-handle.browse-type = 'height':u
      550         on error undo move_block, retry move_block
      551         :
      552           assign
      553             buf_temp-browse-handle.browse-handle :height
      554               = buf_temp-browse-handle.browse-handle :height + p-change-value
      555             no-error .
      556           if error-status :error
      557           or error-status :get-message(1) <> ""
      558           then do:
      559             undo move_block, retry move_block .
      560           end.
      561         end.
      562         for each buf_temp-diasize-handle
      563         on error undo move_block, retry move_block
      564         :
      565           assign
      566             v-object-handle = buf_temp-diasize-handle.handle-value
      567           .
      568           if v-object-handle <> v-diasize-resize-button
      569           then do:
      570             assign
      571               v-object-handle :row = v-object-handle :row + p-change-value
      572               no-error .
      573             if error-status :error
      574             or error-status :get-message(1) <> ""
      575             then do:
      576               undo move_block, retry move_block .
      577             end.
      578           end.
      579         end.
      580       end.
      581       else do:
      582         for each buf_temp-diasize-handle
      583         on error undo move_block, retry move_block
      584         :
      585           assign
      586             v-object-handle = buf_temp-diasize-handle.handle-value
      587           .
      588           if v-object-handle <> v-diasize-resize-button
      589           then do:
      590             assign
      591               v-object-handle :row = v-object-handle :row + p-change-value
      592               no-error .
      593             if error-status :error
      594             or error-status :get-message(1) <> ""
      595             then do:
      596               undo move_block, retry move_block .
      597             end.
      598           end.
      599         end.
      600         assign
      601           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      602           no-error .
      603         if error-status :error
      604         or error-status :get-message(1) <> ""
      605         then do:
      606           undo move_block, retry move_block .
      607         end.
      608         for each buf_temp-browse-handle
      609           where buf_temp-browse-handle.browse-type = 'height':u
      610         on error undo move_block, retry move_block
      611         :
      612           assign
      613             buf_temp-browse-handle.browse-handle :height
      614               = buf_temp-browse-handle.browse-handle :height + p-change-value
      615             no-error .
      616           if error-status :error
      617           or error-status :get-message(1) <> ""
      618           then do:
      619             undo move_block, retry move_block .
      620           end.
      621         end.
      622         assign
      623           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      624           no-error .
      625         if error-status :error
      626         or error-status :get-message(1) <> ""
      627         then do:
      628           undo move_block, retry move_block .
      629         end.
      630         if frame Dialog-Frame :scrollable = true
      631         then do:
      632           assign
      633             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      634             no-error .
      635           if error-status :error
      636           or error-status :get-message(1) <> ""
      637           then do:
      638             undo move_block, retry move_block .
      639           end.
      640         end.
      641       end.
      642       if p-move-resize = true
      643       then do:
      644         run diasize_position-resize-button in this-procedure .
      645       end.
      646       if v-diasize-wndstore = true
      647       then do:
      648         if connected("ub") = true
      649         then do:
      650           define variable v-cntxt-db-num        as integer   no-undo .
      651           define variable v-cntxt-userid        as character no-undo .
      652           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      653                                             , OUTPUT v-cntxt-userid
      654                                             ) .
      655           run gbl/wndsizew.p
      656             (input  v-cntxt-db-num
      657             ,input  v-cntxt-userid
      658             ,input  v-diasize-proc-name
      659             ,input  'height':u
      660             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      661             ) .
      662         end.
      663       end.
      664     end.
      665     assign
      666       v-diasize-change-size = false
      667     .
      668   end procedure.
      669   procedure diasize_set-height :
      670     define input  parameter p-new-height  as decimal   no-undo .
      671     define input  parameter p-move-resize as logical   no-undo .
      672     do
      673     on error undo, return error return-value
      674     :
      675       run diasize_change-height in this-procedure
      676         (input  (p-new-height - frame Dialog-Frame :height)
      677         ,input  p-move-resize
      678         ) .
      679     end.
      680   end procedure.
      681   procedure diasize_change-width :
      682     define input  parameter p-change-value as decimal   no-undo .
      683     define input  parameter p-move-resize  as logical   no-undo .
      684     define variable v-field-group-handle   as handle    no-undo .
      685     define variable v-object-handle        as handle    no-undo .
      686     define variable v-frame-width          as decimal   no-undo .
      687     define variable v-frame-virtual-width  as decimal   no-undo .
      688     define variable v-browse-width         as decimal   no-undo .
      689     define variable v-window-width         as decimal   no-undo .
      690     define variable v-window-virtual-width as decimal   no-undo .
      691     define variable v-change-sign          as integer   no-undo .
      692     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      693     define buffer buf_temp-browse-handle  for temp-browse-handle .
      694     if p-change-value > 0
      695     then do:
      696       if frame Dialog-Frame :width + p-change-value >
      697           session :width-chars
      698       then do:
      699         assign
      700           p-change-value = session :width-chars - frame Dialog-Frame :width
      701         .
      702         if p-change-value <= 0
      703         then do:
      704           run diasize_position-resize-button in this-procedure .
      705           return .
      706         end.
      707       end.
      708     end.
      709     if p-change-value < 0
      710     then do:
      711       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      712       then do:
      713         assign
      714           p-change-value = v-diasize-orig-frame-width
      715                          - frame Dialog-Frame :width
      716         .
      717         if p-change-value >= 0
      718         then do:
      719           run diasize_position-resize-button in this-procedure .
      720           return .
      721         end.
      722       end.
      723     end.
      724     if p-change-value >= 0
      725     then do:
      726       assign
      727         v-change-sign = 1
      728       .
      729     end.
      730     else do:
      731       assign
      732         v-change-sign = -1
      733       .
      734     end.
      735     assign
      736       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      737     .
      738     if p-change-value = 0
      739     then do:
      740       run diasize_position-resize-button in this-procedure .
      741       return .
      742     end.
      743     move_block:
      744     do
      745     on error undo move_block, leave move_block
      746     :
      747       if retry
      748       then do:
      749         do
      750         on error undo move_block, leave move_block
      751         :
      752           if p-change-value > 0
      753           then do:
      754             for each buf_temp-diasize-handle
      755             on error undo, next
      756             :
      757               assign
      758                 v-object-handle = buf_temp-diasize-handle.handle-value
      759               .
      760               if v-object-handle <> v-diasize-resize-button
      761               then do:
      762                 assign
      763                   v-object-handle :col = buf_temp-diasize-handle.save-position
      764                 .
      765               end.
      766             end.
      767             assign
      768               v-diasize-browse-handle :width = v-browse-width
      769             .
      770             for each buf_temp-browse-handle
      771               where buf_temp-browse-handle.browse-type = 'width':u
      772             on error undo, next
      773             :
      774               assign
      775                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      776               .
      777             end.
      778             assign
      779               frame Dialog-Frame :width = v-frame-width
      780             .
      781             if frame Dialog-Frame :scrollable = true
      782             then do:
      783               assign
      784                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      785               .
      786             end.
      787             run diasize_position-resize-button in this-procedure .
      788           end.
      789           else do:
      790             if frame Dialog-Frame :scrollable = true
      791             then do:
      792               assign
      793                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      794               .
      795             end.
      796             assign
      797               frame Dialog-Frame :width = v-frame-width
      798             .
      799             for each buf_temp-browse-handle
      800               where buf_temp-browse-handle.browse-type = 'width':u
      801             on error undo, next
      802             :
      803               assign
      804                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      805               .
      806             end.
      807             assign
      808               v-diasize-browse-handle :width = v-browse-width
      809             .
      810             for each buf_temp-diasize-handle
      811             on error undo, next
      812             :
      813               assign
      814                 v-object-handle = buf_temp-diasize-handle.handle-value
      815               .
      816               if v-object-handle <> v-diasize-resize-button
      817               then do:
      818                 assign
      819                   v-object-handle :col = buf_temp-diasize-handle.save-position
      820                 .
      821               end.
      822             end.
      823             run diasize_position-resize-button in this-procedure .
      824           end.
      825           assign
      826             v-diasize-change-size = false
      827           .
      828           leave move_block .
      829         end.
      830       end.
      831       assign
      832         v-diasize-need-full-display = true
      833       .
      834       if v-diasize-change-size = false
      835       then do:
      836         assign
      837           v-diasize-change-size = true
      838         .
      839       end.
      840       else do:
      841         return .
      842       end.
      843       assign
      844         v-frame-width = frame Dialog-Frame :width
      845         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      846         v-browse-width = v-diasize-browse-handle :width
      847       .
      848       for each buf_temp-browse-handle
      849         where buf_temp-browse-handle.browse-type = 'width':u
      850       :
      851         assign
      852           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      853         .
      854       end.
      855       for each buf_temp-diasize-handle
      856       :
      857         delete buf_temp-diasize-handle .
      858       end.
      859       assign
      860         v-field-group-handle = frame Dialog-Frame :first-child
      861       .
      862       do while valid-handle(v-field-group-handle)
      863       :
      864         assign
      865           v-object-handle = v-field-group-handle :first-child
      866         .
      867         do while valid-handle(v-object-handle)
      868         :
      869           if  v-object-handle <> v-diasize-browse-handle :handle
      870           and v-object-handle <> v-diasize-resize-button
      871           and can-query(v-object-handle, "row")
      872           and can-query(v-object-handle, "height")
      873           and ( v-object-handle :col + v-object-handle :width
      874                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      875               )
      876           then do:
      877             find first buf_temp-browse-handle
      878               where buf_temp-browse-handle.browse-type   = 'width':u
      879                 and buf_temp-browse-handle.browse-handle = v-object-handle
      880               no-error .
      881             if available buf_temp-browse-handle
      882             then do:
      883             end.
      884             else do:
      885               create buf_temp-diasize-handle .
      886               assign
      887                 buf_temp-diasize-handle.handle-value  = v-object-handle
      888                 buf_temp-diasize-handle.save-position = v-object-handle :col
      889               .
      890             end.
      891           end.
      892           assign
      893             v-object-handle = v-object-handle :next-sibling
      894           .
      895         end.
      896         assign
      897           v-field-group-handle = v-field-group-handle :next-sibling
      898         .
      899       end.
      900       do with frame Dialog-Frame
      901       :
      902         hide v-diasize-resize-button .
      903         v-diasize-resize-button :row = 1.
      904         v-diasize-resize-button :column = 1.
      905       end.
      906       if p-change-value > 0
      907       then do:
      908         if frame Dialog-Frame :scrollable = true
      909         then do:
      910           assign
      911             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      912             no-error .
      913           if error-status :error
      914           or error-status :get-message(1) <> ""
      915           then do:
      916             undo move_block, retry move_block.
      917           end.
      918         end.
      919         assign
      920           frame Dialog-Frame :width = v-frame-width + p-change-value
      921           no-error .
      922         if error-status :error
      923         or error-status :get-message(1) <> ""
      924         then do:
      925           undo move_block, retry move_block.
      926         end.
      927         assign
      928           v-diasize-browse-handle :width = v-browse-width + p-change-value
      929         no-error .
      930         if error-status :error
      931         or error-status :get-message(1) <> ""
      932         then do:
      933           undo move_block, retry move_block.
      934         end.
      935         for each buf_temp-browse-handle
      936           where buf_temp-browse-handle.browse-type = 'width':u
      937         on error undo move_block, retry move_block
      938         :
      939           assign
      940             buf_temp-browse-handle.browse-handle :width
      941               = buf_temp-browse-handle.browse-handle :width + p-change-value
      942             no-error .
      943           if error-status :error
      944           or error-status :get-message(1) <> ""
      945           then do:
      946             undo move_block, retry move_block .
      947           end.
      948         end.
      949         for each buf_temp-diasize-handle
      950         on error undo move_block, retry move_block
      951         :
      952           assign
      953             v-object-handle = buf_temp-diasize-handle.handle-value
      954           .
      955           if v-object-handle <> v-diasize-resize-button
      956           then do:
      957             assign
      958               v-object-handle :col = v-object-handle :col + p-change-value
      959               no-error .
      960             if error-status :error
      961             or error-status :get-message(1) <> ""
      962             then do:
      963               undo move_block, retry move_block .
      964             end.
      965           end.
      966         end.
      967       end.
      968       else do:
      969         for each buf_temp-diasize-handle
      970         on error undo move_block, retry move_block
      971         :
      972           assign
      973             v-object-handle = buf_temp-diasize-handle.handle-value
      974           .
      975           if v-object-handle <> v-diasize-resize-button
      976           then do:
      977             assign
      978               v-object-handle :col = v-object-handle :col + p-change-value
      979               no-error .
      980             if error-status :error
      981             or error-status :get-message(1) <> ""
      982             then do:
      983               undo move_block, retry move_block .
      984             end.
      985           end.
      986         end.
      987         for each buf_temp-browse-handle
      988           where buf_temp-browse-handle.browse-type = 'width':u
      989         on error undo move_block, retry move_block
      990         :
      991           assign
      992             buf_temp-browse-handle.browse-handle :width
      993               = buf_temp-browse-handle.browse-handle :width + p-change-value
      994             no-error .
      995           if error-status :error
      996           or error-status :get-message(1) <> ""
      997           then do:
      998             undo move_block, retry move_block .
      999           end.
     1000         end.
     1001         assign
     1002           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1003           no-error .
     1004         if error-status :error
     1005         or error-status :get-message(1) <> ""
     1006         then do:
     1007           undo move_block, retry move_block.
     1008         end.
     1009         assign
     1010           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1011         no-error .
     1012         if error-status :error
     1013         or error-status :get-message(1) <> ""
     1014         then do:
     1015           undo move_block, retry move_block.
     1016         end.
     1017         if frame Dialog-Frame :scrollable = true
     1018         then do:
     1019           assign
     1020             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1021           no-error .
     1022           if error-status :error
     1023           or error-status :get-message(1) <> ""
     1024           then do:
     1025             undo move_block, retry move_block.
     1026           end.
     1027         end.
     1028       end.
     1029       if p-move-resize
     1030       then do:
     1031         run diasize_position-resize-button in this-procedure .
     1032       end.
     1033       if v-diasize-wndstore = true
     1034       then do:
     1035         if connected("ub") = true
     1036         then do:
     1037           define variable v-cntxt-db-num        as integer   no-undo .
     1038           define variable v-cntxt-userid        as character no-undo .
     1039           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1040                                             , OUTPUT v-cntxt-userid
     1041                                             ) .
     1042           run gbl/wndsizew.p
     1043             (input  v-cntxt-db-num
     1044             ,input  v-cntxt-userid
     1045             ,input  v-diasize-proc-name
     1046             ,input  'width':u
     1047             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1048             ) .
     1049         end.
     1050       end.
     1051     end.
     1052     assign
     1053       v-diasize-change-size = false
     1054     .
     1055   end procedure.
     1056   procedure diasize_set-width :
     1057     define input  parameter p-new-width  as decimal   no-undo .
     1058     define input  parameter p-move-resize as logical   no-undo .
     1059     do
     1060     on error undo, return error return-value
     1061     :
     1062       run diasize_change-width in this-procedure
     1063         (input  (p-new-width - frame Dialog-Frame :width)
     1064         ,input  p-move-resize
     1065         ) .
     1066     end.
     1067   end procedure.
     1068   procedure diasize_position-resize-button :
     1069     do with frame Dialog-Frame
     1070     :
     1071       hide v-diasize-resize-button .
     1072       assign
     1073         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1074                     - 1
     1075                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1076         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1077                     - 1
     1078                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1079       .
     1080       view v-diasize-resize-button .
     1081     end.
     1082   end procedure.
     1083   on alt-right anywhere
     1084   do:
     1085     run diasize_change-width in this-procedure
     1086       (input 1
     1087       ,input true
     1088       ) .
     1089     return no-apply .
     1090   end.
     1091   on alt-left anywhere
     1092   do:
     1093     run diasize_change-width in this-procedure
     1094       (input -1
     1095       ,input true
     1096       ) .
     1097     return no-apply .
     1098   end.
     1099   on alt-down anywhere
     1100   do:
     1101     run diasize_change-height in this-procedure
     1102       (input 1
     1103       ,input true
     1104       ) .
     1105     return no-apply .
     1106   end.
     1107   on alt-up anywhere
     1108   do:
     1109     run diasize_change-height in this-procedure
     1110       (input -1
     1111       ,input true
     1112       ) .
     1113     return no-apply .
     1114   end.
     1115   on alt-enter of frame Dialog-Frame
     1116   do:
     1117     run diasize_maximize in this-procedure
     1118       (input  ?
     1119       ).
     1120     return no-apply .
     1121   end.
     1122   procedure diasize_end-move :
     1123     do
     1124     on error undo, return error return-value
     1125     :
     1126       define variable v-row-delta as decimal   no-undo .
     1127       define variable v-col-delta as decimal   no-undo .
     1128       define variable v-new-row as decimal   no-undo .
     1129       define variable v-new-col as decimal   no-undo .
     1130       assign
     1131         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1132         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1133       .
     1134       assign
     1135         v-row-delta = v-new-row - frame Dialog-Frame :height
     1136         v-col-delta = v-new-col - frame Dialog-Frame :width
     1137       .
     1138       run diasize_change-height in this-procedure
     1139         (input v-row-delta
     1140         ,input true
     1141         ) .
     1142       run diasize_change-width in this-procedure
     1143         (input v-col-delta
     1144         ,input true
     1145         ) .
     1146     end.
     1147   end procedure.
     1148   procedure diasize_maximize :
     1149     define input  parameter p-action as logical   no-undo .
     1150     do
     1151     on error undo, return error return-value
     1152     :
     1153       if p-action = ?
     1154       then do:
     1155         if v-diasize-need-maximize = true
     1156         then do:
     1157           assign
     1158             p-action = true
     1159           .
     1160         end.
     1161         else do:
     1162           assign
     1163             p-action = false
     1164           .
     1165         end.
     1166       end.
     1167       if p-action = true
     1168       then do:
     1169         run diasize_change-height in this-procedure
     1170           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1171               - frame Dialog-Frame :height-chars
     1172           ,input true
     1173           ) .
     1174         run diasize_change-width in this-procedure
     1175           (input session :width-chars
     1176               - frame Dialog-Frame :width-chars
     1177           ,input true
     1178           ) .
     1179         assign
     1180           v-diasize-need-maximize = false
     1181         .
     1182       end.
     1183       else do:
     1184         run diasize_change-width in this-procedure
     1185           (input v-diasize-orig-frame-width
     1186               - frame Dialog-Frame :width-chars
     1187           ,input true
     1188           ) .
     1189         run diasize_change-height in this-procedure
     1190           (input v-diasize-orig-frame-height
     1191               - frame Dialog-Frame :height-chars
     1192           ,input true
     1193           ) .
     1194         assign
     1195           v-diasize-need-maximize = true
     1196         .
     1197       end.
     1198     end.
     1199   end procedure.
     1200   procedure diasize_restore-orig-size :
     1201     do
     1202     on error undo, return error return-value
     1203     :
     1204       assign
     1205         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1206         v-diasize-current-frame-height = frame Dialog-Frame :height
     1207       .
     1208       run diasize_set-height in this-procedure
     1209         (input  v-diasize-orig-frame-height
     1210         ,input  true
     1211         ) .
     1212       run diasize_set-width in this-procedure
     1213         (input  v-diasize-orig-frame-width
     1214         ,input  true
     1215         ) .
     1216     end.
     1217   end procedure.
     1218   procedure diasize_restore-current-size :
     1219     do
     1220     on error undo, return error return-value
     1221     :
     1222       run diasize_set-height in this-procedure
     1223         (input  v-diasize-current-frame-height
     1224         ,input  true
     1225         ) .
     1226       run diasize_set-width in this-procedure
     1227         (input  v-diasize-current-frame-width
     1228         ,input  true
     1229         ) .
     1230     end.
     1231   end procedure.
     1232   procedure diasize_set-browse-handle :
     1233     define input  parameter p-browse-handle as handle   no-undo .
     1234     define buffer buf_temp-browse-handle for temp-browse-handle .
     1235     do
     1236     on error undo, return error return-value
     1237     :
     1238       assign
     1239         v-diasize-browse-handle = p-browse-handle
     1240       .
     1241       for each buf_temp-browse-handle
     1242       on error undo, return error return-value
     1243       :
     1244         delete buf_temp-browse-handle .
     1245       end.
     1246     end.
     1247   end procedure.
     1248   procedure diasize_add_browse :
     1249     define input  parameter p-browse-type   as character no-undo .
     1250     define input  parameter p-browse-handle as handle    no-undo .
     1251     define buffer buf_temp-browse-handle for temp-browse-handle .
     1252     do
     1253     on error undo, return error return-value
     1254     :
     1255       assign
     1256         v-diasize-browse-number = v-diasize-browse-number + 1
     1257       .
     1258       create buf_temp-browse-handle .
     1259       assign
     1260         buf_temp-browse-handle.browse-type   = p-browse-type
     1261         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1262         buf_temp-browse-handle.browse-handle = p-browse-handle
     1263       .
     1264     end.
     1265   end procedure.
     1266   procedure diasize_init :
     1267     define variable v-default-value    as logical   no-undo .
     1268     define variable v-restore-saved    as logical   no-undo .
     1269     define variable v-resize-value-str as character no-undo .
     1270     do
     1271     on error undo, return error return-value
     1272     :
     1273       do with frame Dialog-Frame
     1274       :
     1275         assign
     1276           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1277           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1278           v-diasize-browse-handle     = browse BROWSE-level :handle
     1279         .
     1280         create button v-diasize-resize-button
     1281         assign
     1282           parent        = frame Dialog-Frame :first-child
     1283           label         = "s"
     1284           height-pixels = 16
     1285           width-pixels  = 16
     1286           visible       = true
     1287           sensitive     = true
     1288           movable       = true
     1289           triggers:
     1290             on end-move persistent run diasize_end-move in this-procedure .
     1291           end triggers.
     1292         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1293         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1294         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1295         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1296         assign
     1297           v-diasize-wndmax = false
     1298         .
     1299         if connected("ub") = true
     1300         then do:
     1301           define variable v-cntxt-db-num        as integer   no-undo .
     1302           define variable v-cntxt-userid        as character no-undo .
     1303           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1304                                             , OUTPUT v-cntxt-userid
     1305                                             ) .
     1306           run gbl/wndpar_r.p
     1307             (input  v-cntxt-db-num
     1308             ,input  v-cntxt-userid
     1309             ,input  'wndmax':U
     1310             ,output v-diasize-wndmax
     1311             ,output v-default-value
     1312             ) .
     1313         end.
     1314         assign
     1315           v-diasize-wndstore = false
     1316         .
     1317         if connected("ub") = true
     1318         then do:
     1319           run gbl/wndpar_r.p
     1320             (input  v-cntxt-db-num
     1321             ,input  v-cntxt-userid
     1322             ,input  'wndstore':U
     1323             ,output v-diasize-wndstore
     1324             ,output v-default-value
     1325             ) .
     1326         end.
     1327         assign
     1328           v-diasize-proc-name = entry(1, program-name(2), '.')
     1329         .
     1330         if v-diasize-wndstore = true
     1331         then do:
     1332           assign
     1333             v-restore-saved = false
     1334           .
     1335           if connected("ub") = true
     1336           then do:
     1337             run gbl/wndsizer.p
     1338               (input  v-cntxt-db-num
     1339               ,input  v-cntxt-userid
     1340               ,input  v-diasize-proc-name
     1341               ,input  'height':u
     1342               ,output v-resize-value-str
     1343               ) .
     1344             if v-resize-value-str <> '':U
     1345             then do:
     1346               run diasize_change-height in this-procedure
     1347                 (input  integer(v-resize-value-str)
     1348                 ,input  true
     1349                 ) .
     1350               assign
     1351                 v-restore-saved = true
     1352               .
     1353             end.
     1354           end.
     1355           if connected("ub") = true
     1356           then do:
     1357             run gbl/wndsizer.p
     1358               (input  v-cntxt-db-num
     1359               ,input  v-cntxt-userid
     1360               ,input  v-diasize-proc-name
     1361               ,input  'width':u
     1362               ,output v-resize-value-str
     1363               ) .
     1364             if v-resize-value-str <> '':U
     1365             then do:
     1366               run diasize_change-width in this-procedure
     1367                 (input  integer(v-resize-value-str)
     1368                 ,input  true
     1369                 ) .
     1370               assign
     1371                 v-restore-saved = true
     1372               .
     1373             end.
     1374           end.
     1375           if v-restore-saved <> true
     1376           then do:
     1377             if v-diasize-wndmax = true
     1378             then do:
     1379               run diasize_maximize in this-procedure
     1380                 (input  true
     1381                 ) .
     1382             end.
     1383           end.
     1384         end.
     1385         else do:
     1386           if v-diasize-wndmax = true
     1387           then do:
     1388             run diasize_maximize in this-procedure
     1389               (input  true
     1390               ) .
     1391           end.
     1392         end.
     1393       end.
     1394     end.
     1395   end procedure.
     1396   procedure diasize_need-full-display :
     1397     define output parameter p-need-full-display as logical   no-undo .
     1398     do
     1399     on error undo, return error return-value
     1400     :
     1401       assign
     1402         p-need-full-display = v-diasize-need-full-display
     1403       .
     1404       assign
     1405         v-diasize-need-full-display = false
     1406       .
     1407     end.
     1408   end procedure.
     1409   procedure get-context :
     1410      define output parameter p-db-num as integer          no-undo.
     1411      define output parameter p-user-id as character        no-undo.
     1412      define variable v-login               as character    no-undo.
     1413      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1414      define buffer buf_user-login  for ub.user-login .
     1415      do
     1416      on error undo, return error
     1417      :
     1418            FIND FIRST buf_sys-ctrl no-lock.
     1419            ASSIGN
     1420               v-login = USERID("ub")
     1421               p-db-num = buf_sys-ctrl.db-num
     1422            .
     1423            FIND FIRST buf_user-login
     1424                 WHERE buf_user-login.db-num = p-db-num
     1425                   AND buf_user-login.user-login = v-login
     1426                 no-lock
     1427                 no-error
     1428                 .
     1429            IF AVAILABLE buf_user-login
     1430            THEN DO:
     1431               assign
     1432                  p-user-id = buf_user-login.user-id
     1433               .
     1434            END.
     1435      end.
     1436   end procedure.
     1437       run diasize_init in this-procedure .
     1438   define buffer buf_gds-prt for ub.gds-prt .
     1439   find first buf_gds-prt no-lock
     1440     where buf_gds-prt.node-code = p-root-node
     1441     .
     1442   assign
     1443     v-upper-code  = buf_gds-prt.upper-code
     1444     fi-scale-name = buf_gds-prt.node-name
     1445   .
     1446   MAIN-BLOCK:
     1447   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1448      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1449     RUN enable_UI.
     1450     WAIT-FOR GO OF FRAME Dialog-Frame.
     1451   END.
     1452   RUN disable_UI.
     1453   PROCEDURE disable_UI :
     1454     HIDE FRAME Dialog-Frame.
     1455   END PROCEDURE.
     1456   PROCEDURE enable_UI :
     1457     DISPLAY fi-scale-name
     1458         WITH FRAME Dialog-Frame.
     1459     ENABLE b-exit b-help BROWSE-level BROWSE-prt fi-scale-name
     1460         WITH FRAME Dialog-Frame.
     1461     VIEW FRAME Dialog-Frame.
     1462     OPEN QUERY BROWSE-level FOR EACH ub.lvl-name no-lock where ub.lvl-name.upper-code = v-upper-code by ub.lvl-name.level .    run open-query-gds-prt in this-procedure .
     1463   END PROCEDURE.
     1464   PROCEDURE open-query-gds-prt :
     1465     if available ub.lvl-name
     1466     then do:
     1467       define buffer buf_gds-prt for ub.gds-prt .
     1468       define variable v-node-code as integer   no-undo .
     1469       assign
     1470         v-node-code = p-root-node
     1471       .
     1472       define variable v-ind as integer   no-undo .
     1473       do v-ind = 1 to ub.lvl-name.level
     1474       :
     1475         find first buf_gds-prt no-lock
     1476           where buf_gds-prt.upper-code = v-node-code
     1477           .
     1478         assign
     1479           v-node-code = buf_gds-prt.node-code
     1480         .
     1481       end.
     1482       OPEN QUERY browse-prt FOR EACH ub.gds-prt no-lock
     1483         where gds-prt.upper-code = v-node-code
     1484         by gds-prt.prt-num .
     1485     end.
     1486   END PROCEDURE.
