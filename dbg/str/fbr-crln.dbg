     1115   define buffer buf_curr-accnt for ub.curr-accnt.
     1116   do
     1117   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1118   on stop   undo , return error substitute( "&1. stop", vss-workfile )
