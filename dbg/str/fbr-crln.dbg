        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle    as handle           no-undo.
        3   define input parameter p-fbr-doc-recid      as recid                    no-undo.
        4   define input parameter p-goods-recid        as recid                    no-undo.
        5   define input parameter p-recipe-code        like fbr-line.recipe-code   no-undo.
        6   define input parameter p-trn-type           like fbr-line.trn-type      no-undo.
        7   define input parameter p-is-comp            like fbr-line.is-comp       no-undo.
        8   define input parameter p-is-recursive       as logical                  no-undo.
        9   define input parameter p-price-obj-type     like clients.obj-type       no-undo.
       10   define input parameter p-price-obj-code     like clients.obj-code       no-undo.
       11   define output parameter p-fbr-line-recid    as recid                no-undo.
       12   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       13   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       14   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile: fbr-crln.p $":U .
       16   define variable vss-archive     as character no-undo init "$Archive: str/fbr-crln.p $":U .
       17   define variable vss-description as character no-undo init "создание и/или заполнение строки производства, в т.ч. цен".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
       89   procedure partslib-clear-temp-parts :
       90     define buffer buf_temp-parts for temp-parts .
       91     do
       92     on error undo, return error
       93     :
       94       for each buf_temp-parts
       95       on error undo, return error
       96       :
       97         delete buf_temp-parts .
       98       end.
       99     end.
      100   end procedure.
      101   procedure partslib-create-temp-parts :
      102     define parameter buffer buf_parts       for ub.parts .
      103     define parameter buffer buf_temp-parts  for temp-parts .
      104     define input  parameter p-goods-twounit as logical   no-undo .
      105     define variable v-base-part-code as character no-undo .
      106     do
      107     on error undo, return error
      108     :
      109       if p-goods-twounit = true
      110       then do:
      111         assign
      112           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      113         .
      114       end.
      115       else do:
      116         assign
      117           v-base-part-code = buf_parts.part-code
      118         .
      119       end.
      120       find first buf_temp-parts exclusive-lock
      121         where buf_temp-parts.obj-type  = buf_parts.obj-type
      122           and buf_temp-parts.obj-code  = buf_parts.obj-code
      123           and buf_temp-parts.artic     = buf_parts.artic
      124           and buf_temp-parts.prod-type = buf_parts.prod-type
      125           and buf_temp-parts.prod-code = buf_parts.prod-code
      126           and buf_temp-parts.in-code   = buf_parts.in-code
      127           and buf_temp-parts.out-code  = 'free-zone':U
      128           and buf_temp-parts.part-code = v-base-part-code
      129         no-error.
      130       if not available buf_temp-parts
      131       then do:
      132         create buf_temp-parts .
      133         buffer-copy buf_parts to buf_temp-parts
      134         assign
      135           buf_temp-parts.out-code  = 'free-zone':U
      136           buf_temp-parts.part-code = v-base-part-code
      137           buf_temp-parts.rsrv-free = yes
      138           buf_temp-parts.status_   = no
      139           buf_temp-parts.qnty      = 0
      140           buf_temp-parts.fact-qnty = 0
      141           buf_temp-parts.real-qnty = 0
      142           buf_temp-parts.cli-qnty  = 0
      143         .
      144       end.
      145     end.
      146   end procedure.
      147   procedure partslib-init-temp-parts :
      148     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      149     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      150     define input parameter p-artic           like ub.parts.artic     no-undo .
      151     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      152     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      153     define buffer buf_parts      for ub.parts .
      154     define buffer buf_temp-parts for temp-parts .
      155     define variable v-goods-twounit    as logical   no-undo .
      156     do
      157     on error undo, return error
      158     :
      159   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      160   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      161     (input  p-artic
      162     ,input  p-prod-type
      163     ,input  p-prod-code
      164     ,input  'twounit=request':u
      165     ,output v-goods-twounit
      166     ) no-error .
      167       if error-status :error
      168       then do:
      169         message
      170           vss-workfile vss-revision vss-description skip
      171           vss-include-info0 skip
      172           "Ошибка при определении атрибута товара" skip
      173           "Артикул" p-artic p-prod-type p-prod-code skip
      174           "twounit=request" skip
      175           error-status :get-message(1) skip
      176           return-value skip
      177           view-as alert-box error .
      178         undo, return error return-value .
      179       end.
      180       run partslib-clear-temp-parts in this-procedure .
      181       for each buf_parts
      182         where buf_parts.obj-type  = p-obj-type
      183           and buf_parts.obj-code  = p-obj-code
      184           and buf_parts.artic     = p-artic
      185           and buf_parts.prod-type = p-prod-type
      186           and buf_parts.prod-code = p-prod-code
      187           and buf_parts.rsrv-free = yes
      188           and buf_parts.status_   = no
      189           and buf_parts.in-code   <> buf_parts.out-code
      190       on error undo, return error
      191       :
      192         run partslib-create-temp-parts in this-procedure
      193           (buffer buf_parts
      194           ,buffer buf_temp-parts
      195           ,input  v-goods-twounit
      196           ) .
      197         define variable v-parts-qnty          as decimal   no-undo .
      198         define variable v-parts-cli-qnty      as decimal   no-undo .
      199         define variable v-parts-free-qnty     as decimal   no-undo .
      200         define variable v-parts-free-cli-qnty as decimal   no-undo .
      201         if buf_parts.out-code = 'free-zone':U
      202         then do:
      203           assign
      204             v-parts-qnty          = buf_parts.qnty
      205             v-parts-cli-qnty      = buf_parts.cli-qnty
      206             v-parts-free-qnty     = buf_parts.qnty
      207             v-parts-free-cli-qnty = buf_parts.cli-qnty
      208           .
      209         end.
      210         else do:
      211           assign
      212             v-parts-qnty          = abs(buf_parts.qnty)
      213             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      214             v-parts-free-qnty     = 0
      215             v-parts-free-cli-qnty = 0
      216           .
      217         end.
      218         assign
      219           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      220           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      221           buf_temp-parts.real-qnty     = 0
      222           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      223           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      224           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      225         .
      226       end.
      227     end.
      228   end procedure.
      229   procedure partslib-init-temp-parts-by-factord :
      230     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      231     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      232     define input parameter p-artic              like ub.parts.artic     no-undo .
      233     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      234     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      235     define input parameter p-fact-order         as decimal   no-undo .
      236     define input parameter p-include-fact-order as logical   no-undo .
      237     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      238     define buffer buf_gds-obj  for ub.gds-obj .
      239     do
      240     on error undo, return error
      241     :
      242       do transaction
      243       on error undo, return error
      244       :
      245   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      246   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      247     (input  p-obj-type
      248     ,input  p-obj-code
      249     ,input  p-artic
      250     ,input  p-prod-type
      251     ,input  p-prod-code
      252     ,buffer buf_gds-obj
      253     ) no-error .
      254         if error-status :error
      255         then do:
      256           message
      257             vss-workfile vss-revision vss-description skip
      258             vss-include-info0 skip
      259             "Невозможно найти товар на объекте" skip
      260             "Объект" p-obj-type p-obj-code skip
      261             "Артикул" p-artic p-prod-type p-prod-code skip
      262             error-status :get-message(1) skip
      263             return-value skip
      264             view-as alert-box error .
      265           undo, return error .
      266         end.
      267         find current buf_gds-obj exclusive-lock .
      268       end.
      269       run partslib-init-temp-parts in this-procedure
      270         (input p-obj-type
      271         ,input p-obj-code
      272         ,input p-artic
      273         ,input p-prod-type
      274         ,input p-prod-code
      275         ) no-error .
      276       if error-status :error
      277       then do:
      278         message
      279           vss-workfile vss-revision vss-description skip
      280           vss-include-info0 skip
      281           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      282           "Объект" p-obj-type p-obj-code skip
      283           "Артикул" p-artic p-prod-type p-prod-code skip
      284           "p-fact-order" p-fact-order skip
      285           view-as alert-box error .
      286         undo, return error .
      287       end.
      288       if p-include-fact-order = true
      289       then do:
      290         assign
      291           p-fact-order = p-fact-order - 0.0000000001
      292         .
      293       end.
      294       define variable v-max-fact-order as character no-undo .
      295       run factord-max-fact-order in this-procedure
      296         (output v-max-fact-order
      297         ) no-error .
      298       if error-status :error
      299       then do:
      300         message
      301           vss-workfile vss-revision vss-description skip
      302           vss-include-info0 skip
      303           "Ошибка при вызове процедуры factord-max-fact-order" skip
      304           "Объект" p-obj-type p-obj-code skip
      305           "Артикул" p-artic p-prod-type p-prod-code skip
      306           "p-fact-order" p-fact-order skip
      307           view-as alert-box error .
      308         undo, return error .
      309       end.
      310       run partslib-update-by-factord in this-procedure
      311         (input p-obj-type
      312         ,input p-obj-code
      313         ,input p-artic
      314         ,input p-prod-type
      315         ,input p-prod-code
      316         ,input p-fact-order
      317         ,input v-max-fact-order
      318         ,input false
      319         ) no-error .
      320       if error-status :error
      321       then do:
      322         message
      323           vss-workfile vss-revision vss-description skip
      324           vss-include-info0 skip
      325           "Ошибка при вызове процедуры partslib-update-by-factord" skip
      326           "Объект" p-obj-type p-obj-code skip
      327           "Артикул" p-artic p-prod-type p-prod-code skip
      328           "p-fact-order" p-fact-order skip
      329           "v-max-fact-order" v-max-fact-order skip
      330           view-as alert-box error .
      331         undo, return error .
      332       end.
      333     end.
      334   end procedure.
      335   procedure partslib-update-by-factord :
      336     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      337     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      338     define input parameter p-artic              like ub.parts.artic     no-undo .
      339     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      340     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      341     define input parameter p-start-fact-order   as decimal   no-undo .
      342     define input parameter p-end-fact-order     as decimal   no-undo .
      343     define input parameter p-lock-gds-obj       as logical   no-undo .
      344     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      345     define buffer buf_gds-obj  for ub.gds-obj .
      346     define buffer buf_doc-line for ub.doc-line .
      347     define variable v-total-parts-qnty as decimal   no-undo .
      348     define variable v-goods-gds-goods  as logical   no-undo .
      349     define variable v-goods-twounit    as logical   no-undo .
      350     do
      351     on error undo, return error
      352     :
      353       if p-start-fact-order > p-end-fact-order
      354       then do:
      355         message
      356           vss-workfile vss-revision vss-description skip
      357           vss-include-info0 skip
      358           "Ошибка задания входных параметров" skip
      359           "Начало интервала превышает конец интервала" skip
      360           "Объект" p-obj-type p-obj-code skip
      361           "Артикул" p-artic p-prod-type p-prod-code skip
      362           "p-start-fact-order" p-start-fact-order skip
      363           "p-end-fact-order"   p-end-fact-order skip
      364           view-as alert-box error .
      365         undo, return error .
      366       end.
      367       if p-lock-gds-obj = true
      368       then do:
      369         do transaction
      370         on error undo, return error
      371         :
      372   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      373   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      374     (input  p-obj-type
      375     ,input  p-obj-code
      376     ,input  p-artic
      377     ,input  p-prod-type
      378     ,input  p-prod-code
      379     ,buffer buf_gds-obj
      380     ) no-error .
      381           if error-status :error
      382           then do:
      383             message
      384               vss-workfile vss-revision vss-description skip
      385               vss-include-info0 skip
      386               "Невозможно найти gds-obj" skip
      387               error-status :get-message(1) skip
      388               return-value skip
      389               view-as alert-box error .
      390             undo, return error .
      391           end.
      392           find current buf_gds-obj exclusive-lock .
      393         end.
      394       end.
      395   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      396   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      397     (input  p-artic
      398     ,input  p-prod-type
      399     ,input  p-prod-code
      400     ,input  'gds-goods=request':u
      401     ,output v-goods-gds-goods
      402     ) no-error .
      403       if error-status :error
      404       then do:
      405         message
      406           vss-workfile vss-revision vss-description skip
      407           vss-include-info0 skip
      408           "Ошибка при определении атрибута товара" skip
      409           "Артикул" p-artic p-prod-type p-prod-code skip
      410           "gds-goods=request" skip
      411           error-status :get-message(1) skip
      412           return-value skip
      413           view-as alert-box error .
      414         undo, return error return-value .
      415       end.
      416   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      417   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      418     (input  p-artic
      419     ,input  p-prod-type
      420     ,input  p-prod-code
      421     ,input  'twounit=request':u
      422     ,output v-goods-twounit
      423     ) no-error .
      424       if error-status :error
      425       then do:
      426         message
      427           vss-workfile vss-revision vss-description skip
      428           vss-include-info0 skip
      429           "Ошибка при определении атрибута товара" skip
      430           "Артикул" p-artic p-prod-type p-prod-code skip
      431           "twounit=request" skip
      432           error-status :get-message(1) skip
      433           return-value skip
      434           view-as alert-box error .
      435         undo, return error return-value .
      436       end.
      437       for each buf_doc-line no-lock
      438         where buf_doc-line.obj-type   = p-obj-type
      439           and buf_doc-line.obj-code   = p-obj-code
      440           and buf_doc-line.artic      = p-artic
      441           and buf_doc-line.prod-type  = p-prod-type
      442           and buf_doc-line.prod-code  = p-prod-code
      443           and buf_doc-line.status_    = 'факт':U
      444           and buf_doc-line.fact-order > p-start-fact-order
      445           and buf_doc-line.fact-order <= p-end-fact-order
      446       on error undo, return error
      447       :
      448         run partslib-process-document in this-procedure
      449           (input  buf_doc-line.doc-code
      450           ,input  p-obj-type
      451           ,input  p-obj-code
      452           ,input  p-artic
      453           ,input  p-prod-type
      454           ,input  p-prod-code
      455           ,input  v-goods-gds-goods
      456           ,input  v-goods-twounit
      457           ,output v-total-parts-qnty
      458           ) no-error .
      459         if error-status :error
      460         then do:
      461           message
      462             vss-workfile vss-revision vss-description skip
      463             vss-include-info0 skip
      464             "Ошибка при вызове процедуры partslib-process-document" skip
      465             "Документ" buf_doc-line.doc-code skip
      466             "Объект" p-obj-type p-obj-code skip
      467             "Артикул" p-artic p-prod-type p-prod-code skip
      468             "p-start-fact-order" p-start-fact-order skip
      469             "p-end-fact-order" p-end-fact-order skip
      470             error-status :get-message(1) skip
      471             return-value skip
      472             view-as alert-box error .
      473           undo, return error return-value .
      474         end.
      475       end.
      476     end.
      477   end procedure.
      478   procedure partslib-process-document :
      479     define input  parameter p-doc-code         as character no-undo .
      480     define input  parameter p-obj-type         as character no-undo .
      481     define input  parameter p-obj-code         as integer   no-undo .
      482     define input  parameter p-artic            as character no-undo .
      483     define input  parameter p-prod-type        as character no-undo .
      484     define input  parameter p-prod-code        as integer   no-undo .
      485     define input  parameter p-goods-gds-goods  as logical   no-undo .
      486     define input  parameter p-goods-twounit    as logical   no-undo .
      487     define output parameter p-total-parts-qnty as decimal   no-undo .
      488     define variable v-parts-sign as integer   no-undo .
      489     define buffer buf_trn-doc    for ub.trn-doc .
      490     define buffer buf_doc-line   for ub.doc-line .
      491     define buffer buf_parts      for ub.parts .
      492     define buffer buf_temp-parts for temp-parts .
      493     do
      494     on error undo, return error return-value
      495     :
      496       find first buf_trn-doc no-lock
      497         where buf_trn-doc.doc-code = p-doc-code
      498         no-error .
      499       if not available buf_trn-doc
      500       then do:
      501         undo, return error substitute("Ошибка при поиске документа. Документ &1"
      502                                      ,p-doc-code
      503                                      ) .
      504       end.
      505       case buf_trn-doc.doc-type
      506       :
      507         when 'при':U or
      508         when 'возврат':U or
      509         when 'инв':U
      510         then do:
      511           assign
      512             v-parts-sign = -1
      513           .
      514         end.
      515         when 'рас':U or
      516         when 'спи':U
      517         then do:
      518           assign
      519             v-parts-sign = 1
      520           .
      521         end.
      522         otherwise do:
      523           undo, return error substitute("Неизвестный тип документа &1"
      524                                       ,buf_trn-doc.doc-type
      525                                       ) .
      526         end.
      527       end.
      528       find first buf_doc-line no-lock
      529         where buf_doc-line.doc-code  = p-doc-code
      530           and buf_doc-line.artic     = p-artic
      531           and buf_doc-line.prod-type = p-prod-type
      532           and buf_doc-line.prod-code = p-prod-code
      533         no-error .
      534       if not available buf_doc-line
      535       then do:
      536         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
      537                                      ,p-doc-code
      538                                      ,artic
      539                                      ,prod-type
      540                                      ,prod-code
      541                                      ) .
      542       end.
      543       assign
      544         p-total-parts-qnty = 0
      545       .
      546       if p-goods-gds-goods = true
      547       then do:
      548         for each buf_parts no-lock
      549           where buf_parts.out-code  = p-doc-code
      550             and buf_parts.obj-type  = p-obj-type
      551             and buf_parts.obj-code  = p-obj-code
      552             and buf_parts.artic     = p-artic
      553             and buf_parts.prod-type = p-prod-type
      554             and buf_parts.prod-code = p-prod-code
      555         on error undo, return error
      556         :
      557           run partslib-create-temp-parts in this-procedure
      558             (buffer buf_parts
      559             ,buffer buf_temp-parts
      560             ,input  p-goods-twounit
      561             ) .
      562           assign
      563             p-total-parts-qnty        = p-total-parts-qnty
      564                                       + v-parts-sign * buf_parts.fact-qnty
      565             buf_temp-parts.qnty       = buf_temp-parts.qnty
      566                                       + v-parts-sign * buf_parts.fact-qnty
      567             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
      568                                       + v-parts-sign * buf_parts.fact-qnty
      569             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
      570                                       + v-parts-sign * buf_parts.cli-qnty
      571           .
      572           if buf_temp-parts.qnty = 0
      573           then do:
      574             delete buf_temp-parts .
      575           end.
      576         end.
      577       end.
      578       else do:
      579         assign
      580           p-total-parts-qnty = p-total-parts-qnty
      581                              + v-parts-sign * buf_doc-line.fact-qnty
      582         .
      583       end.
      584     end.
      585   end procedure.
      586   procedure partslib-init-temp-parts-by-date :
      587     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      588     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      589     define input parameter p-artic           like ub.parts.artic     no-undo .
      590     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      591     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      592     define input parameter p-fact-date       as date      no-undo .
      593     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
      594     do
      595     on error undo, return error
      596     :
      597       define variable v-fact-order                as decimal   no-undo .
      598       define variable v-shift-end-fact-order      as decimal   no-undo .
      599       define variable v-day-end-fact-order        as decimal   no-undo .
      600       run factord in this-procedure
      601         (input  p-fact-date
      602         ,input  1
      603         ,input  1
      604         ,input  ?
      605         ,input  0
      606         ,input  false
      607         ,output v-fact-order
      608         ,output v-shift-end-fact-order
      609         ,output v-day-end-fact-order
      610         ) no-error .
      611       if error-status :error
      612       then do:
      613         message
      614           vss-workfile vss-revision vss-description skip
      615           vss-include-info0 skip
      616           "Ошибка при определении момента времени, на который требуется остаток" skip
      617           "Объект" p-obj-type p-obj-code skip
      618           "Артикул" p-artic p-prod-type p-prod-code skip
      619           "Дата" p-fact-date skip
      620           view-as alert-box error .
      621         undo, return error .
      622       end.
      623       run partslib-init-temp-parts-by-factord in this-procedure
      624         (input p-obj-type
      625         ,input p-obj-code
      626         ,input p-artic
      627         ,input p-prod-type
      628         ,input p-prod-code
      629         ,input v-day-end-fact-order
      630         ,input false
      631         ) no-error .
      632       if error-status :error
      633       then do:
      634         message
      635           vss-workfile vss-revision vss-description skip
      636           vss-include-info0 skip
      637           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
      638           "Объект" p-obj-type p-obj-code skip
      639           "Артикул" p-artic p-prod-type p-prod-code skip
      640           "Дата" p-fact-date skip
      641           view-as alert-box error .
      642         undo, return error .
      643       end.
      644     end.
      645   end procedure.
      646   procedure partslib-calc-cost :
      647     define output parameter p-fact-qnty      as decimal   no-undo .
      648     define output parameter p-vat-pc         as decimal   no-undo .
      649     define output parameter p-slt-pc         as decimal   no-undo .
      650     define output parameter p-sum-base       as decimal   no-undo .
      651     define output parameter p-sum-rubl       as decimal   no-undo .
      652     define output parameter p-vat-base       as decimal   no-undo .
      653     define output parameter p-vat-rubl       as decimal   no-undo .
      654     define output parameter p-slt-base       as decimal   no-undo .
      655     define output parameter p-slt-rubl       as decimal   no-undo .
      656     define output parameter p-road-tax-base  as decimal   no-undo .
      657     define output parameter p-road-tax-rubl  as decimal   no-undo .
      658     define output parameter p-transport-base as decimal   no-undo .
      659     define output parameter p-transport-rubl as decimal   no-undo .
      660     define output parameter p-other-base     as decimal   no-undo .
      661     define output parameter p-other-rubl     as decimal   no-undo .
      662     define output parameter p-excise-base    as decimal   no-undo .
      663     define output parameter p-excise-rubl    as decimal   no-undo .
      664     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
      665     do
      666     on error undo, return error return-value
      667     :
      668       define buffer buf_temp-parts for temp-parts .
      669       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      670       define buffer   in-vatp-parts    for ub.parts   .
      671       define buffer   in-vatp-doc      for ub.trn-doc .
      672       define buffer   in-vatp-goods    for ub.goods   .
      673       define buffer   in-vatp-sysconf  for ub.sysconf .
      674       define buffer   in-vatp_doc-attr for ub.doc-attr.
      675       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      676       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      677       define variable varinvprb                  as   character              no-undo.
      678       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      679       define variable cli-base-rate              as   decimal                no-undo.
      680       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      681       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      682       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      683       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      684       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      685       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      686       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      687       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      688       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      689       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      690       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      691       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      692       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      693       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      694       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      695       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      696       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      697       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      698       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      699       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      700       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      701       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      702       define variable varinvatp-envd             as   character              no-undo.
      703       define variable varinvatp-type             as   character              no-undo.
      704       for each buf_temp-parts
      705       on error undo, return error
      706       :
      707   assign
      708     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
      709     price-base-with-tax-loc = buf_temp-parts.price-base
      710   .
      711   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      712   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      713     (output varinvprb
      714     )  .
      715     if buf_temp-parts.out-code = 'free-zone':U     or
      716        buf_temp-parts.out-code = 'out-zone':U   or
      717        buf_temp-parts.doc-type = 'акт':U then do:
      718       assign
      719         in-vatp-have-vat-slt = yes.
      720     end.
      721     else do:
      722       find first in-vatp_doc-attr no-lock
      723         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
      724           and in-vatp_doc-attr.attr-code = 'envd':U
      725         no-error .
      726       if not available in-vatp_doc-attr then do:
      727         assign
      728           in-vatp-have-vat-slt = yes.
      729       end.
      730       else do:
      731            in-vatp-have-vat-slt = no.
      732       end.
      733     end.
      734     assign
      735      price-cli-with-tax-loc = buf_temp-parts.price-cli
      736      cli-base-rate          = buf_temp-parts.cli-base-rate.
      737     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
      738              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
      739     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
      740             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
      741             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
      742             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
      743             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
      744             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
      745             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      746       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      747     assign
      748       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
      749     assign
      750       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
      751       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
      752       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
      753       transport-cli-loc  = 0
      754       other-cli-loc      = 0
      755     .
      756   ASSIGN
      757             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      758       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      759   .
      760         assign
      761           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
      762           p-vat-pc         = p-vat-pc         + vat-pc-loc
      763           p-slt-pc         = p-slt-pc         + slt-pc-loc
      764           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
      765           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
      766           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
      767           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
      768           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
      769           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
      770           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
      771           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
      772           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
      773           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
      774           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
      775           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
      776           p-excise-base    = p-excise-base    + 0
      777           p-excise-rubl    = p-excise-rubl    + 0
      778         .
      779       end.
      780       if p-fact-qnty      = ?
      781       or p-sum-base       = ?
      782       or p-sum-rubl       = ?
      783       or p-vat-base       = ?
      784       or p-vat-rubl       = ?
      785       or p-slt-base       = ?
      786       or p-slt-rubl       = ?
      787       or p-road-tax-base  = ?
      788       or p-road-tax-rubl  = ?
      789       or p-transport-base = ?
      790       or p-transport-rubl = ?
      791       or p-other-base     = ?
      792       or p-other-rubl     = ?
      793       or p-excise-base    = ?
      794       or p-excise-rubl    = ?
      795       then do:
      796         message
      797           vss-workfile vss-revision vss-description skip
      798           vss-include-info0 skip
      799           "Программа in-vatp.i вернула неопределенные значения" skip
      800           "p-fact-qnty"      p-fact-qnty      skip
      801           "p-sum-base"       p-sum-base       skip
      802           "p-sum-rubl"       p-sum-rubl       skip
      803           "p-vat-base"       p-vat-base       skip
      804           "p-vat-rubl"       p-vat-rubl       skip
      805           "p-slt-base"       p-slt-base       skip
      806           "p-slt-rubl"       p-slt-rubl       skip
      807           "p-road-tax-base"  p-road-tax-base  skip
      808           "p-road-tax-rubl"  p-road-tax-rubl  skip
      809           "p-transport-base" p-transport-base skip
      810           "p-transport-rubl" p-transport-rubl skip
      811           "p-other-base"     p-other-base     skip
      812           "p-other-rubl"     p-other-rubl     skip
      813           "p-excise-base"    p-excise-base    skip
      814           "p-excise-rubl"    p-excise-rubl    skip
      815           view-as alert-box error .
      816         undo, return error .
      817       end.
      818     end.
      819   end procedure.
      820   define variable vss-include-info7 as character format "X(65)" no-undo
      821   initial "@(#)$Workfile$ $Revision$".
      822   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
      823   run gbl/getobjsrvhndl.p (input-output ObjSrv).
      824   define temp-table temp_fbrlib_recipe no-undo
      825       field recipe-code                   as character
      826       field fbr-doc-code                  as character
      827       field income-goods-doc-code         as character
      828       field count-income                  as integer
      829       field qnty-income                   as decimal
      830       field sum-income-sale               as decimal
      831       field sum-income-cost-base          as decimal
      832       field sum-income-cost-rubl          as decimal
      833       field sum-income-vat-cost-base      as decimal
      834       field sum-income-vat-cost-rubl      as decimal
      835       field write-off-goods-doc-code      as character
      836       field write-off-office-doc-code     as character
      837       field count-write-off               as integer
      838       field qnty-write-off                as decimal
      839       field sum-write-off-sale            as decimal
      840       field sum-write-off-cost-base       as decimal
      841       field sum-write-off-cost-rubl       as decimal
      842       field sum-write-off-vat-cost-base   as decimal
      843       field sum-write-off-vat-cost-rubl   as decimal
      844   index pi is primary unique recipe-code
      845   index income income-goods-doc-code
      846   index wogds write-off-goods-doc-code
      847   index wooff write-off-office-doc-code
      848   .
      849   define temp-table temp_dressing-ingr no-undo
      850       field recipe-code   as character
      851       field gds-code      as integer
      852       field line-qnty     as decimal
      853       field used-qnty     as decimal
      854       field recipe-qnty   as decimal
      855       index pi is primary unique recipe-code gds-code
      856   .
      857   define temp-table temp_recipe-order no-undo
      858       field recipe-code   as character
      859       field order         as integer
      860       index pi is primary unique order
      861   .
      862   define temp-table temp_recipe-childs-qnty no-undo
      863       field recipe-code   as character
      864       field childs-qnty   as integer
      865       field order         as integer
      866       index pi is primary unique recipe-code
      867   .
      868   define temp-table temp_recipe-childs no-undo
      869       field recipe-code       as character
      870       field child-code        as integer
      871       field child-recipe-code as character
      872       index pi is primary unique recipe-code child-code
      873   .
      874   define variable v-fbrlib-recipe-order               as integer  no-undo.
      875   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      876   procedure cur-time :
      877      define output parameter p-today as date      no-undo .
      878      define output parameter p-time  as integer   no-undo .
      879     do
      880     on error undo, return error
      881     :
      882       define variable v-date1 as date      no-undo .
      883       define variable v-date2 as date      no-undo .
      884       define variable v-time  as integer   no-undo .
      885       assign
      886         v-date1 = today
      887         v-time  = time
      888         v-date2 = today
      889       .
      890       if v-date1 <> v-date2
      891       then do:
      892         assign
      893           v-date1 = today
      894           v-time  = v-time
      895         .
      896       end.
      897       assign
      898         p-today = v-date1
      899         p-time  = v-time
      900       .
      901     end.
      902   end.
      903   function cur-time-date returns character
      904   :
      905     return string(today, '99/99/9999':U) .
      906   end.
      907   function cur-time-mjd returns decimal
      908   :
      909     define variable v-date as date      no-undo .
      910     define variable v-time as integer   no-undo .
      911     run cur-time in this-procedure
      912       (output v-date
      913       ,output v-time
      914       ) .
      915     return integer(v-date) - 2400002 + (v-time / 86400) .
      916   end.
      917   function cur-time-get-ending-index returns integer
      918   (input p-number as integer
      919   )
      920   :
      921     if p-number < 0
      922     or p-number = ?
      923     then do:
      924       return 1 .
      925     end.
      926     define variable v-rest as integer   no-undo .
      927     assign
      928       p-number = p-number modulo 100
      929     .
      930     if p-number < 20
      931     then do:
      932       assign
      933         v-rest = p-number
      934       .
      935     end.
      936     else do:
      937       assign
      938         v-rest = p-number modulo 10
      939       .
      940     end.
      941     case v-rest :
      942       when 1
      943       then do:
      944         return 2 .
      945       end.
      946       when 2 or
      947       when 3 or
      948       when 4
      949       then do:
      950         return 3 .
      951       end.
      952       otherwise do:
      953         return 1 .
      954       end.
      955     end case .
      956   end.
      957   procedure cur-time-mjd-to-date :
      958      define input  parameter i-mjd-diff as decimal no-undo.
      959      define output parameter o-Date     as date    no-undo.
      960      define output parameter o-Time     as integer no-undo.
      961      define variable v-day-number as integer   no-undo .
      962      if    i-mjd-diff < 0
      963         or i-mjd-diff = ?
      964      then do:
      965         return "?" .
      966      end.
      967      assign
      968         v-day-number = truncate(i-mjd-diff,0).
      969         o-Date = date(v-day-number + 2400002).
      970         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      971     .
      972   end.
      973   function cur-time-mjd-to-string returns character
      974   (input p-mjd-diff as decimal
      975   )
      976   :
      977     define variable v-day-number as integer   no-undo .
      978     define variable v-seconds    as integer   no-undo .
      979     define variable v-hour       as integer   no-undo .
      980     define variable v-min        as integer   no-undo .
      981     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      982     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      983     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      984     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      985     if p-mjd-diff < 0
      986     or p-mjd-diff = ?
      987     then do:
      988       return "?" .
      989     end.
      990     assign
      991       v-day-number = integer(truncate(p-mjd-diff,0))
      992       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      993     .
      994     if v-seconds > 86400
      995     then do:
      996       assign
      997         v-seconds = 86400 - 1
      998       .
      999     end.
     1000     if v-seconds < 0
     1001     then do:
     1002       assign
     1003         v-seconds = 0
     1004       .
     1005     end.
     1006     assign
     1007       v-hour = truncate(v-seconds / 3600, 0)
     1008     .
     1009     assign
     1010       v-seconds = v-seconds modulo 3600
     1011     .
     1012     assign
     1013       v-min = truncate(v-seconds / 60, 0)
     1014     .
     1015     assign
     1016       v-seconds = v-seconds modulo 60
     1017     .
     1018     return
     1019         (if v-day-number <> 0
     1020           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1021           else ""
     1022         )
     1023       + (if v-day-number <> 0 or v-hour <> 0
     1024           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1025           else ""
     1026         )
     1027       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1028           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1029           else ""
     1030         )
     1031       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1032       .
     1033   end.
     1034   function cur-time-string returns character
     1035   :
     1036     define variable v-date as date      no-undo .
     1037     define variable v-time as integer   no-undo .
     1038     run cur-time in this-procedure
     1039       (output v-date
     1040       ,output v-time
     1041       ) .
     1042     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1043   end.
     1044   function cur-time-string-sec returns character
     1045   :
     1046     define variable v-date as date      no-undo .
     1047     define variable v-time as integer   no-undo .
     1048     run cur-time in this-procedure
     1049       (output v-date
     1050       ,output v-time
     1051       ) .
     1052     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1053   end.
     1054   function cur-time-custom  returns character
     1055   (input p-prefix as character
     1056   ,input p-date-format as character
     1057   ,input p-delimiter as character
     1058   ,input p-time-format as character
     1059   ,input p-suffix as character
     1060   )
     1061   :
     1062     define variable v-date as date      no-undo .
     1063     define variable v-time as integer   no-undo .
     1064     run cur-time in this-procedure
     1065       (output v-date
     1066       ,output v-time
     1067       ) .
     1068     return
     1069       p-prefix
     1070       + string(v-date, p-date-format)
     1071       + p-delimiter
     1072       + string(v-time, p-time-format)
     1073       + p-suffix
     1074       .
     1075   end.
     1076   function cur-time-print  returns character
     1077   :
     1078     define variable v-date as date      no-undo .
     1079     define variable v-time as integer   no-undo .
     1080     run cur-time in this-procedure
     1081       (output v-date
     1082       ,output v-time
     1083       ) .
     1084     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1085   end.
     1086   function cur-time-datetime returns datetime
     1087   :
     1088     define variable v-char as character no-undo .
     1089     define variable v-datetime as datetime no-undo .
     1090     v-char = cur-time-string().
     1091     v-datetime = datetime(v-char).
     1092     return  v-datetime.
     1093   end.
     1094   function cur-time-string-msec returns character
     1095   :
     1096     define variable v-date as datetime  no-undo .
     1097     v-date = now.
     1098     return string(v-date) .
     1099   end.
     1100   procedure fbrlib_create-fbr-doc :
     1101   define input parameter p-obj-type as character no-undo .
     1102   define input parameter p-obj-code as integer no-undo .
     1103   define input parameter p-userid as character no-undo .
     1104   define output parameter p-fbr-doc-code as character no-undo .
     1105   define output parameter p-recid as recid no-undo .
     1106   define variable v-host-code as integer no-undo .
     1107   define variable v-base-code as integer no-undo .
     1108   define variable v-obj-db-num as integer no-undo .
     1109   define variable v-db-num as integer no-undo .
     1110   DEFINE VARIABLE v-today as date no-undo .
     1111   DEFINE VARIABLE v-time as integer no-undo .
     1112   define variable v-doc-code as character no-undo .
     1113   define variable fi-pay-code as integer no-undo .
