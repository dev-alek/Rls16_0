     1123     (input  p-obj-type
     1124     ,input  p-obj-code
     1125     ,output v-host-code
     1126     )  .
     1127   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1128   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1129     (input  p-obj-type
     1130     ,input  p-obj-code
     1131     ,output v-obj-db-num
     1132     )  .
     1133   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1134   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1135     (output v-db-num
     1136     )  .
     1137   if v-obj-db-num <> v-db-num then do:
     1138     return error substitute("Запрещено создание документа производства в чужой БД:&1БД &2&3 - &4&1текущая БД - &5"
     1139                             , chr(10)
     1140                             , p-obj-type
     1141                             , p-obj-code
     1142                             , v-obj-db-num
     1143                             , v-db-num).
     1144   end.
     1145   run cur-time in this-procedure ( output v-today, output v-time).
     1146   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1147   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1148     (input  p-obj-type
     1149     ,input  p-obj-code
     1150     ,output v-today
     1151     )  .
     1152   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1153   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1154     (input  v-host-code
     1155     ,output v-base-code
     1156     )  .
     1157   find last buf_curr-accnt no-lock
     1158       where buf_curr-accnt.curr-code = v-base-code
     1159         and buf_curr-accnt.exch-date <= v-today use-index pi
     1160   no-error.
     1161   if not available buf_curr-accnt
     1162   then do:
     1163     undo, return error substitute("На дату &1 неизвестен курс базовой валюты с кодом &2"
     1164                                     , string(v-today, "99/99/9999")
     1165                                     , v-base-code).
     1166   end.
     1167   run doc-code in this-procedure (
