     1176     undo, return error substitute("Ошибка при генерации номера документа производства&1&2&1&3"
     1177                                   , chr(10)
     1178                                   , error-status:get-message(1)
     1179                                   , return-value ).
     1180   end.
     1181   run trg/chkdocnm.p (
     1182         input v-doc-code
     1183       , input 'fbr-doc':U
     1184       , input ?
     1185   ) no-error.
     1186   if error-status:error
     1187   then do:
     1188     undo, return error substitute("Ошибка при проверке номера для нового документа производства&1&2&1&3"
     1189                                   , chr(10)
     1190                                   , error-status:get-message(1)
     1191                                   , return-value ).
     1192   end.
     1193   create buf_fbr-doc.
     1194   assign
     1195   buf_fbr-doc.doc-code  = v-doc-code
     1196   buf_fbr-doc.creid     = p-userid
     1197   buf_fbr-doc.doc-date  = v-today
     1198   buf_fbr-doc.doc-type  = 'производство':U
     1199   buf_fbr-doc.host-code = v-host-code
     1200   buf_fbr-doc.obj-code  = p-obj-code
     1201   buf_fbr-doc.obj-type  = p-obj-type
     1202   buf_fbr-doc.PS        = "@"
     1203   buf_fbr-doc.status_   = 'новый':U
     1204   buf_fbr-doc.user-db-num = v-obj-db-num
     1205   buf_fbr-doc.user-name   = p-userid
     1206   .
     1207   run fbrlib_get-default-pay-code in this-procedure (
     1208         input buf_fbr-doc.obj-type
     1209       , input buf_fbr-doc.obj-code
     1210       , output fi-pay-code
     1211   ).
     1212   buf_fbr-doc.pay-code = fi-pay-code.
     1213   p-recid = recid(buf_fbr-doc).
     1214   p-fbr-doc-code = buf_fbr-doc.doc-code.
     1215   end.
     1216   end procedure.
     1217   procedure fbrlib_get-default-pay-code :
     1218   define input parameter p-obj-type   as character        no-undo.
     1219   define input parameter p-obj-code   as integer          no-undo.
     1220   define output parameter p-pay-code  as integer          no-undo.
     1221   define variable v-host-code as integer no-undo .
     1222   define buffer buf_shop          for ub.shop.
     1223   define buffer buf_store         for ub.store.
     1224   define buffer buf_sysconf       for ub.sysconf.
     1225   do
     1226   for buf_shop
     1227     , buf_store
     1228     , buf_sysconf
     1229   on error undo, return error
     1230   :
     1231     case p-obj-type  :
     1232       when 'маг':U then do:
     1233           find first buf_shop no-lock
     1234                 where buf_shop.obj-code = p-obj-code
     1235           no-error.
     1236           if available buf_shop
     1237           then do:
     1238               assign
     1239                   p-pay-code = buf_shop.fbr-pay
     1240               .
     1241           end.
     1242       end.
     1243       when 'скл':U then do:
     1244           find first buf_store no-lock
     1245                 where buf_store.obj-code = p-obj-code
     1246           no-error.
     1247           if available buf_store
     1248           then do:
     1249               assign
     1250                   p-pay-code = buf_store.fbr-pay
     1251               .
     1252           end.
     1253       end.
     1254     end case.
     1255     if p-pay-code = ?
     1256     or p-pay-code = 0
     1257     then do:
     1258   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1259   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1260     (input  p-obj-type
     1261     ,input  p-obj-code
     1262     ,output v-host-code
     1263     )  .
     1264         find first buf_sysconf no-lock
     1265               where buf_sysconf.host-code = v-host-code
     1266         no-error.
     1267         if available buf_sysconf
     1268         then do:
     1269             assign
     1270                 p-pay-code = buf_sysconf.fbr-pay
     1271             .
     1272         end.
     1273     end.
     1274     if p-pay-code = ?
     1275     or p-pay-code = 0
     1276     then do:
     1277   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1278   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdnpay in g#library
     1279     (input  p-obj-type
     1280     ,input  p-obj-code
     1281     ,output p-pay-code
     1282     )  .
     1283     end.
     1284   end.
     1285   end procedure.
     1286   procedure fbrlib-fill-and-check-temp_fbrlib_recipe :
     1287   do
     1288   on error undo, return error
     1289   :
     1290   define input parameter p-fbr-doc-code as character    no-undo.
     1291       define variable vss-description as character    no-undo init "fbrlib-fill-and-check-temp_fbrlib_recipe: ".
     1292       define variable v-gds-name      as character    no-undo.
     1293       define buffer buf_fbr-doc               for ub.fbr-doc.
     1294       define buffer buf_fbr-line              for ub.fbr-line.
     1295       define buffer buf_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     1296       define buffer buf_out_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     1297       find first buf_fbr-doc no-lock
     1298            where buf_fbr-doc.doc-code = p-fbr-doc-code
     1299       .
     1300       for each buf_temp_fbrlib_recipe
     1301       :
     1302           delete buf_temp_fbrlib_recipe.
     1303       end.
     1304       for each buf_fbr-line no-lock
     1305          where buf_fbr-line.doc-code = p-fbr-doc-code
     1306       :
     1307           find first buf_temp_fbrlib_recipe
     1308                where buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     1309           no-error.
     1310           if not available buf_temp_fbrlib_recipe
     1311           then do:
     1312               create buf_temp_fbrlib_recipe.
     1313               assign
     1314                   buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     1315                   buf_temp_fbrlib_recipe.fbr-doc-code = buf_fbr-line.doc-code
     1316               .
     1317           end.
     1318       end.
     1319       for each buf_temp_fbrlib_recipe
     1320       :
     1321           assign
     1322               buf_temp_fbrlib_recipe.count-income                = 0
     1323               buf_temp_fbrlib_recipe.qnty-income                 = 0
     1324               buf_temp_fbrlib_recipe.sum-income-sale             = 0
     1325               buf_temp_fbrlib_recipe.sum-income-cost-base        = 0
     1326               buf_temp_fbrlib_recipe.sum-income-cost-rubl        = 0
     1327               buf_temp_fbrlib_recipe.sum-income-vat-cost-base    = 0
     1328               buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl    = 0
     1329               buf_temp_fbrlib_recipe.count-write-off             = 0
     1330               buf_temp_fbrlib_recipe.qnty-write-off              = 0
     1331               buf_temp_fbrlib_recipe.sum-write-off-sale          = 0
     1332               buf_temp_fbrlib_recipe.sum-write-off-cost-base     = 0
     1333               buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = 0
     1334               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = 0
     1335               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = 0
     1336           .
     1337           for each buf_fbr-line no-lock
     1338              where buf_fbr-line.doc-code     = p-fbr-doc-code
     1339                and buf_fbr-line.trn-type     = 'при':U
     1340                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     1341           :
     1342               if ( buf_fbr-line.price-base   = ?
     1343                   or buf_fbr-line.price-rubl = ?
     1344                   or buf_fbr-line.price-base <= 0
     1345                   or buf_fbr-line.price-rubl <= 0 )
     1346               and buf_fbr-line.fact-qnty <> 0
     1347               and buf_fbr-line.rsrv-qnty <> ?
     1348               and buf_fbr-doc.is-free    = no
     1349               then do:
     1350   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1351   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1352     (input  buf_fbr-line.artic
     1353     ,input  buf_fbr-line.prod-type
     1354     ,input  buf_fbr-line.prod-code
     1355     ,output v-gds-name
     1356     ) no-error .
     1357                   if error-status :error
     1358                   then do:
     1359                       assign
     1360                           v-gds-name = ""
     1361                       .
     1362                   end.
     1363                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     1364                                                 ,vss-description
     1365                                                 ,buf_fbr-doc.doc-code
     1366                                                 ,chr(10)
     1367                                                 ,buf_fbr-line.recipe-code
     1368                                                 ,buf_fbr-line.artic
     1369                                                 ,v-gds-name).
     1370               end.
     1371               assign
     1372                   buf_temp_fbrlib_recipe.count-income             = buf_temp_fbrlib_recipe.count-income + 1
     1373                   buf_temp_fbrlib_recipe.qnty-income              = buf_temp_fbrlib_recipe.qnty-income
     1374                                                                   + buf_fbr-line.fact-qnty
     1375                   buf_temp_fbrlib_recipe.sum-income-sale          = buf_temp_fbrlib_recipe.sum-income-sale
     1376                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     1377               .
     1378               if buf_fbr-line.is-waste = no
     1379               then do:
     1380                   assign
     1381                       buf_temp_fbrlib_recipe.sum-income-cost-base     = buf_temp_fbrlib_recipe.sum-income-cost-base
     1382                                                                       + buf_fbr-line.price-sum-base
     1383                       buf_temp_fbrlib_recipe.sum-income-cost-rubl     = buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1384                                                                       + buf_fbr-line.price-sum-rubl
     1385                       buf_temp_fbrlib_recipe.sum-income-vat-cost-base = buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1386                                                                       + buf_fbr-line.price-sum-vat-base
     1387                       buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1388                                                                       + buf_fbr-line.price-sum-vat-rubl
     1389                   .
     1390               end.
     1391           end.
     1392           for each buf_fbr-line no-lock
     1393              where buf_fbr-line.doc-code     = p-fbr-doc-code
     1394                and buf_fbr-line.trn-type     = 'спи':U
     1395                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     1396           :
     1397               if ( buf_fbr-line.price-base   = ?
     1398                   or buf_fbr-line.price-rubl = ?
     1399                   or buf_fbr-line.price-base <= 0
     1400                   or buf_fbr-line.price-rubl <= 0 )
     1401               and buf_fbr-line.fact-qnty <> 0
     1402               and buf_fbr-line.rsrv-qnty <> ?
     1403               and buf_fbr-doc.is-free    = no
     1404               and buf_fbr-doc.status_    = 'разрешен':U
     1405               then do:
     1406   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1407   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1408     (input  buf_fbr-line.artic
     1409     ,input  buf_fbr-line.prod-type
     1410     ,input  buf_fbr-line.prod-code
     1411     ,output v-gds-name
     1412     ) no-error .
     1413                   if error-status :error
     1414                   then do:
     1415                       assign
     1416                           v-gds-name = ""
     1417                       .
     1418                   end.
     1419                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     1420                                                 ,vss-description
     1421                                                 ,buf_fbr-doc.doc-code
     1422                                                 ,chr(10)
     1423                                                 ,buf_fbr-line.recipe-code
     1424                                                 ,buf_fbr-line.artic
     1425                                                 ,v-gds-name).
     1426               end.
     1427               assign
     1428                   buf_temp_fbrlib_recipe.count-write-off             = buf_temp_fbrlib_recipe.count-write-off + 1
     1429                   buf_temp_fbrlib_recipe.qnty-write-off              = buf_temp_fbrlib_recipe.qnty-write-off
     1430                                                                   + buf_fbr-line.fact-qnty
     1431                   buf_temp_fbrlib_recipe.sum-write-off-sale          = buf_temp_fbrlib_recipe.sum-write-off-sale
     1432                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     1433               .
     1434               if buf_fbr-line.is-waste = no
     1435               then do:
     1436                   assign
     1437                       buf_temp_fbrlib_recipe.sum-write-off-cost-base     = buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1438                                                                       + buf_fbr-line.price-sum-base
     1439                       buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1440                                                                       + buf_fbr-line.price-sum-rubl
     1441                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1442                                                                       + buf_fbr-line.price-sum-vat-base
     1443                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1444                                                                       + buf_fbr-line.price-sum-vat-rubl
     1445                   .
     1446               end.
     1447           end.
     1448           if buf_fbr-doc.status_    = 'разрешен':U
     1449           and ( abs( buf_temp_fbrlib_recipe.sum-write-off-cost-base     - buf_temp_fbrlib_recipe.sum-income-cost-base     ) > 0.01
     1450           or abs( buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     - buf_temp_fbrlib_recipe.sum-income-cost-rubl     ) > 0.01
     1451           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base - buf_temp_fbrlib_recipe.sum-income-vat-cost-base ) > 0.01
     1452           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl - buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl ) > 0.01
     1453               )
     1454           then do:
     1455            undo, return error
     1456               substitute("В документе пр-ва &1 Не совпадают суммы учетных цен для списанного и оприходованного по рецепту товара.&2" +
     1457                           "Рецепт: &3&2&4&4по списанному товару&4по оприходованному товару&2"  +
     1458                           "Сумма в баз.вал.&4&5&4&4&6&2" +
     1459                           "Сумма в &9.&4&7&4&4&8&2"
     1460                          , buf_fbr-doc.doc-code
     1461                          , chr(10)
     1462                          , buf_temp_fbrlib_recipe.recipe-code
     1463                          , chr(9)
     1464                          , buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1465                          , buf_temp_fbrlib_recipe.sum-income-cost-base
     1466                          , buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1467                          , buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1468                          , "руб"
     1469                          )
     1470              +
     1471              substitute("НДС в баз.вал.&1&2&1&1&3&4" +
     1472                         "НДС в &7.&1&5&1&1&6&4"
     1473                        ,  chr(9)
     1474                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1475                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1476                        ,chr(10)
     1477                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1478                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1479                        ,"руб"
     1480                        )       .
     1481           end.
     1482       end.
     1483   end.
     1484   end procedure.
     1485   procedure fbrlib-fill-sum-fbr-doc :
     1486   do
     1487   on error undo, return error
     1488   :
     1489   define input parameter p-fbr-doc-recid  as recid        no-undo.
     1490   define input parameter p-mode           as character    no-undo.
     1491       define variable vss-description as character init "fbrlib-fill-sum-fbr-doc: "  no-undo.
     1492       define buffer buf_fbr-doc           for ub.fbr-doc.
     1493       define buffer buf_fbr-line          for ub.fbr-line.
     1494       define buffer buf_temp_fbrlib_recipe   for temp_fbrlib_recipe.
     1495       define variable v-in-count          as integer       no-undo.
     1496       define variable v-out-count         as integer       no-undo.
     1497       find first buf_fbr-doc exclusive-lock
     1498            where recid ( buf_fbr-doc ) = p-fbr-doc-recid
     1499       .
     1500       find first buf_temp_fbrlib_recipe no-error.
     1501       if not available buf_temp_fbrlib_recipe
     1502       then do:
     1503           run fbrlib-fill-and-check-temp_fbrlib_recipe in this-procedure (
     1504               input buf_fbr-doc.doc-code
     1505           ) no-error.
     1506           if error-status :error
     1507           then do:
     1508               undo, return error substitute("&1 Ошибка расчета сумм при заполнении шапки документа производства.&2&3&2&4"
     1509                                              , vss-description
     1510                                              , chr(10)
     1511                                              , error-status:get-message(1)
     1512                                              , return-value ).
     1513           end.
     1514       end.
     1515       assign
     1516           v-in-count                  = 0
     1517           buf_fbr-doc.in-qnty         = 0
     1518           buf_fbr-doc.in-sale         = 0
     1519           buf_fbr-doc.in-base         = 0
     1520           buf_fbr-doc.in-rubl         = 0
     1521           buf_fbr-doc.in-vat-base     = 0
     1522           buf_fbr-doc.in-vat-rubl     = 0
     1523           v-out-count                 = 0
     1524           buf_fbr-doc.out-qnty        = 0
     1525           buf_fbr-doc.out-sale        = 0
     1526           buf_fbr-doc.out-base        = 0
     1527           buf_fbr-doc.out-rubl        = 0
     1528           buf_fbr-doc.out-vat-base    = 0
     1529           buf_fbr-doc.out-vat-rubl    = 0
     1530       .
     1531       for each buf_temp_fbrlib_recipe
     1532       :
     1533           assign
     1534               v-in-count                  = v-in-count                + buf_temp_fbrlib_recipe.count-income
     1535               buf_fbr-doc.in-qnty         = buf_fbr-doc.in-qnty       + buf_temp_fbrlib_recipe.qnty-income
     1536               buf_fbr-doc.in-sale         = buf_fbr-doc.in-sale       + buf_temp_fbrlib_recipe.sum-income-sale
     1537               buf_fbr-doc.in-base         = buf_fbr-doc.in-base       + buf_temp_fbrlib_recipe.sum-income-cost-base
     1538               buf_fbr-doc.in-rubl         = buf_fbr-doc.in-rubl       + buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1539               buf_fbr-doc.in-vat-base     = buf_fbr-doc.in-vat-base   + buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1540               buf_fbr-doc.in-vat-rubl     = buf_fbr-doc.in-vat-rubl   + buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1541               v-out-count                 = v-out-count               + buf_temp_fbrlib_recipe.count-write-off
     1542               buf_fbr-doc.out-qnty        = buf_fbr-doc.out-qnty      + buf_temp_fbrlib_recipe.qnty-write-off
     1543               buf_fbr-doc.out-sale        = buf_fbr-doc.out-sale      + buf_temp_fbrlib_recipe.sum-write-off-sale
     1544               buf_fbr-doc.out-base        = buf_fbr-doc.out-base      + buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1545               buf_fbr-doc.out-rubl        = buf_fbr-doc.out-rubl      + buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1546               buf_fbr-doc.out-vat-base    = buf_fbr-doc.out-vat-base  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1547               buf_fbr-doc.out-vat-rubl    = buf_fbr-doc.out-vat-rubl  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1548           .
     1549       end.
     1550       if ( abs (buf_fbr-doc.in-rubl - buf_fbr-doc.out-rubl) <= 0.01
     1551       and   abs (buf_fbr-doc.in-base - buf_fbr-doc.out-base) <= 0.01 )
     1552       or p-mode <> 'факт':U
     1553       then do:
     1554           if substring( buf_fbr-doc.PS, 1, 1 ) = "@"
     1555           then do:
     1556               assign
     1557                   buf_fbr-doc.PS = "@ Строк полученных товаров : "
     1558                                   + string( v-out-count, ">>>,>>9" )
     1559                                   + chr(10) + "Строк исходных товаров : "
     1560                                   + string( v-in-count, ">>>,>>9" )
     1561               .
     1562           end.
     1563       end.
     1564       else do:
     1565         undo, return error substitute("В док-те пр-ва &1 не совпадают суммы списанных и оприходованных товаров.&2" +
     1566                                       "Сумма списанных товаров в &3 - &4&2" +
     1567                                       "Сумма оприходованных товаров в &3 - &5&2" +
     1568                                       "Сумма оприходованных товаров в &3 - &6&2" +
     1569                                       "Сумма списанных товаров в баз.вал. - &7&2" +
     1570                                       "Сумма оприходованных товаров в баз.вал. - &8&2"
     1571                                       , buf_fbr-doc.doc-code
     1572                                       , chr(10)
     1573                                       , "рублях"
     1574                                       , round( buf_fbr-doc.out-rubl, 2 )
     1575                                       , round( buf_fbr-doc.in-rubl,  2 )
     1576                                       , round( buf_fbr-doc.in-rubl,  2 )
     1577                                       , round( buf_fbr-doc.out-base, 2 )
     1578                                       , round( buf_fbr-doc.in-base,  2 )).
     1579       end.
     1580   end.
     1581   end procedure.
     1582   procedure fbrlib-calc-prices :
     1583   do
     1584   on error undo, return error
     1585   :
     1586   define input parameter p-fbr-line-recid as recid        no-undo.
     1587   define input parameter p-price-obj-type as character    no-undo.
     1588   define input parameter p-price-obj-code as integer      no-undo.
     1589   define output parameter p-current-price as decimal      no-undo.
     1590       define variable v-void          as decimal       no-undo.
     1591       define variable v-void-char     as character     no-undo.
     1592       define variable v-gds-code      as integer       no-undo.
     1593       define variable v-b-code        as integer       no-undo.
     1594       define buffer buf_fbr-doc   for ub.fbr-doc.
     1595       define buffer buf_fbr-line  for ub.fbr-line.
     1596       define buffer buf_gds-prt   for ub.gds-prt.
     1597       define buffer buf_bar-code  for ub.bar-code.
     1598       find first buf_fbr-line no-lock
     1599           where recid( buf_fbr-line ) = p-fbr-line-recid
     1600       .
     1601   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1602   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1603     (input  buf_fbr-line.artic
     1604     ,input  buf_fbr-line.prod-type
     1605     ,input  buf_fbr-line.prod-code
     1606     ,output v-gds-code
     1607     ) no-error .
     1608       if error-status :error
     1609       then do:
     1610         undo, return error substitute("&1 &2 &3&4Ошибка определения кода товара (артикул &7).&4&5&4&6"
     1611                                         ,vss-workfile
     1612                                         ,vss-revision
     1613                                         ,vss-description
     1614                                         ,chr(10)
     1615                                         , error-status:get-message(1)
     1616                                         , return-value
     1617                                         , buf_fbr-line.artic
     1618                                         ).
     1619       end.
     1620   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1621     (input  v-gds-code
     1622     ,input  ?
     1623     ,output v-b-code
     1624     ) no-error .
     1625       if error-status :error
     1626       then do:
     1627         undo, return error substitute("&1 &2 &3&4Ошибка определения основного бар-кода товара (код товара) &7.&4&5&4&6"
     1628                                         ,vss-workfile
     1629                                         ,vss-revision
     1630                                         ,vss-description
     1631                                         ,chr(10)
     1632                                         , error-status:get-message(1)
     1633                                         , return-value
     1634                                         , v-gds-code
     1635                                         ).
     1636       end.
     1637       if buf_fbr-line.is-calc = no
     1638       then do:
     1639   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1640   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1641     (input  p-price-obj-type
     1642     ,input  p-price-obj-code
     1643     ,input  v-b-code
     1644     ,input  0
     1645     ,input  0
     1646     ,output v-void-char
     1647     ,output p-current-price
     1648     ,output v-void
     1649     ,output v-void
     1650     ) no-error .
     1651           if error-status :error
     1652           then do:
     1653             undo, return error substitute("&1 &2 &3&4Ошибка определения продажной цены основного бар-кода товара (код товара) &7.&4&5&4&6"
     1654                                             ,vss-workfile
     1655                                             ,vss-revision
     1656                                             ,vss-description
     1657                                             ,chr(10)
     1658                                             , error-status:get-message(1)
     1659                                             , return-value
     1660                                             , v-gds-code
     1661                                             ).
     1662           end.
     1663       end.
     1664       else do:
     1665           assign
     1666               p-current-price = buf_fbr-line.price-sale
     1667           .
     1668       end.
     1669   end.
     1670   end procedure.
     1671   procedure fbrlib-put-in-order-recipe :
     1672   do
     1673   on error undo, return error
     1674   :
     1675   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     1676       define variable v-recipe-counter    as integer          no-undo.
     1677       define variable v-recipe-amount     as integer init 0   no-undo.
     1678       define variable v-child-counter     as integer          no-undo.
     1679       define variable v-is-call-cycle     as logical          no-undo.
     1680       define variable v-str as character     no-undo.
     1681       define buffer buf_in_fbr-line       for ub.fbr-line.
     1682       define buffer buf_dress_fbr-line    for ub.fbr-line.
     1683       define buffer buf_fbr-line          for ub.fbr-line.
     1684       define buffer buf_recipe-gds        for ub.recipe-gds.
     1685       define buffer buf_recipe            for ub.recipe.
     1686       for each temp_recipe-childs-qnty
     1687       :
     1688           delete temp_recipe-childs-qnty.
     1689       end.
     1690       for each temp_recipe-childs
     1691       :
     1692           delete temp_recipe-childs.
     1693       end.
     1694       for each temp_recipe-order
     1695       :
     1696           delete temp_recipe-order.
     1697       end.
     1698       for each buf_fbr-line no-lock
     1699          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     1700       on error undo, return error
     1701       :
     1702           find first temp_recipe-childs-qnty
     1703                where temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     1704           no-error.
     1705           if not available temp_recipe-childs-qnty
     1706           then do:
     1707               create temp_recipe-childs-qnty.
     1708               assign
     1709                   v-recipe-amount                     = v-recipe-amount + 1
     1710                   temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     1711                   temp_recipe-childs-qnty.order       = v-recipe-amount
     1712                   temp_recipe-childs-qnty.childs-qnty = 0
     1713                   v-child-counter                     = 0
     1714               .
     1715           end.
     1716       end.
     1717       for each buf_in_fbr-line no-lock
     1718          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     1719            and buf_in_fbr-line.trn-type = 'спи':U
     1720       on error undo, return error
     1721       :
     1722           for each buf_dress_fbr-line no-lock
     1723              where buf_dress_fbr-line.doc-code    = p-fbr-doc-doc-code
     1724                and buf_dress_fbr-line.trn-type    = 'при':U
     1725                and buf_dress_fbr-line.artic       = buf_in_fbr-line.artic
     1726                and buf_dress_fbr-line.prod-type   = buf_in_fbr-line.prod-type
     1727                and buf_dress_fbr-line.prod-code   = buf_in_fbr-line.prod-code
     1728           on error undo, return error
     1729           :
     1730               find first buf_recipe no-lock
     1731                    where buf_recipe.recipe-code = buf_dress_fbr-line.recipe-code
     1732               .
     1733               if buf_in_fbr-line.is-comp = yes
     1734               then do:
     1735                   find last temp_recipe-childs-qnty
     1736                       where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     1737                   .
     1738                   assign
     1739                       temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     1740                   .
     1741                   create temp_recipe-childs.
     1742                   assign
     1743                       temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     1744                       temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     1745                       temp_recipe-childs.child-recipe-code    = buf_dress_fbr-line.recipe-code
     1746                   .
     1747               end.
     1748               else do:
     1749               end.
     1750           end.
     1751       end.
     1752       for each buf_in_fbr-line no-lock
     1753          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     1754            and buf_in_fbr-line.trn-type = 'при':U
     1755       on error undo, return error
     1756       :
     1757           find first buf_recipe no-lock
     1758                where buf_recipe.recipe-code = buf_in_fbr-line.recipe-code
     1759           no-error.
     1760           if buf_in_fbr-line.is-comp = no
     1761           then do:
     1762           end.
     1763           else do:
     1764               for each buf_recipe-gds no-lock
     1765               where buf_recipe-gds.recipe-code = buf_in_fbr-line.recipe-code
     1766               :
     1767                   for each buf_fbr-line no-lock
     1768                   where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     1769                       and buf_fbr-line.trn-type    = 'при':U
     1770                       and buf_fbr-line.artic       = buf_recipe-gds.artic
     1771                       and buf_fbr-line.prod-type   = buf_recipe-gds.prod-type
     1772                       and buf_fbr-line.prod-code   = buf_recipe-gds.prod-code
     1773                   on error undo, return error
     1774                   :
     1775                       find first buf_recipe no-lock
     1776                            where buf_recipe.recipe-code = buf_fbr-line.recipe-code
     1777                       .
     1778                       if buf_recipe.recipe-type = 'разделка':U
     1779                       then do:
     1780                       end.
     1781                       else do:
     1782                           find last temp_recipe-childs-qnty
     1783                               where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     1784                           .
     1785                           assign
     1786                               temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     1787                           .
     1788                           create temp_recipe-childs.
     1789                           assign
     1790                               temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     1791                               temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     1792                               temp_recipe-childs.child-recipe-code    = buf_fbr-line.recipe-code
     1793                           .
     1794                       end.
     1795                   end.
     1796               end.
     1797           end.
     1798       end.
     1799       for each temp_recipe-order
     1800       on error undo, return error
     1801       :
     1802           delete temp_recipe-order.
     1803       end.
     1804       assign
     1805           v-fbrlib-recipe-order = 0
     1806       .
     1807       do v-recipe-counter = 1 to v-recipe-amount
     1808       on error undo, return error
     1809       :
     1810           run fbrlib-add-recipe-in-tmp-order in this-procedure (
     1811                 input v-recipe-counter
     1812               , input 0
     1813               , output v-is-call-cycle
     1814           ).
     1815           if v-is-call-cycle = yes
     1816           then do:
     1817               message
     1818                       "Достигнут максимальный уровень вложенности рецептов."
     1819                   skip(1)
     1820                   skip "Невозможно упорядочить рецепты."
     1821                   skip(1)
     1822                   skip "Необходимо изменить структуру рецептов,"
     1823                   skip "используемых при формировании"
     1824                   skip "данного документа производства."
     1825               view-as alert-box error
     1826               title "Невозможно рассчитать документ производства".
     1827               for each temp_recipe-childs-qnty
     1828               :
     1829                   delete temp_recipe-childs-qnty.
     1830               end.
     1831               for each temp_recipe-childs
     1832               :
     1833                   delete temp_recipe-childs.
     1834               end.
     1835               for each temp_recipe-order
     1836               :
     1837                   delete temp_recipe-order.
     1838               end.
     1839               for each temp_recipe-order
     1840               on error undo, return error
     1841               :
     1842                   delete temp_recipe-order.
     1843               end.
     1844               for each temp_fbrlib_recipe
     1845               on error undo, return error
     1846               :
     1847                   delete temp_recipe-order.
     1848               end.
     1849               undo, return error.
     1850           end.
     1851       end.
     1852   end.
     1853   end procedure.
     1854   procedure fbrlib-add-recipe-in-tmp-order :
     1855   do
     1856   on error undo, return error
     1857   :
     1858   define input parameter p-order              as integer      no-undo.
     1859   define input parameter p-call-counter       as integer      no-undo.
     1860   define output parameter p-is-call-cycle     as logical      no-undo.
     1861       define variable v-nodes-counter     as integer       no-undo.
     1862       define buffer buf_c_temp_recipe-childs-qnty for temp_recipe-childs-qnty.
     1863       define buffer buf_temp_recipe-childs-qnty   for temp_recipe-childs-qnty.
     1864       define buffer buf_temp_recipe-childs        for temp_recipe-childs     .
     1865       define buffer buf_temp_recipe-order         for temp_recipe-order.
     1866       assign
     1867           p-call-counter = p-call-counter + 1
     1868       .
     1869       if p-call-counter > 50
     1870       then do:
     1871           assign
     1872               p-is-call-cycle = yes
     1873           .
     1874       end.
     1875       else do:
     1876           find first buf_temp_recipe-childs-qnty
     1877                where buf_temp_recipe-childs-qnty.order = p-order
     1878           .
     1879           find first buf_temp_recipe-order
     1880                where buf_temp_recipe-order.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     1881           no-error.
     1882           if not available buf_temp_recipe-order
     1883           then do:
     1884               do v-nodes-counter = 1 to buf_temp_recipe-childs-qnty.childs-qnty
     1885               :
     1886                   find first buf_temp_recipe-childs
     1887                        where buf_temp_recipe-childs.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     1888                          and buf_temp_recipe-childs.child-code  = v-nodes-counter
     1889                   .
     1890                   find first buf_c_temp_recipe-childs-qnty
     1891                        where buf_c_temp_recipe-childs-qnty.recipe-code = buf_temp_recipe-childs.child-recipe-code
     1892                   .
     1893                   run fbrlib-add-recipe-in-tmp-order in this-procedure (
     1894                         input buf_c_temp_recipe-childs-qnty.order
     1895                       , input p-call-counter
     1896                       , output p-is-call-cycle
     1897                   ).
     1898                   if p-is-call-cycle = yes
     1899                   then do:
     1900                       return.
     1901                   end.
     1902               end.
     1903               assign
     1904                   v-fbrlib-recipe-order = v-fbrlib-recipe-order + 1
     1905               .
     1906               create buf_temp_recipe-order.
     1907               assign
     1908                   buf_temp_recipe-order.recipe-code   = buf_temp_recipe-childs-qnty.recipe-code
     1909                   buf_temp_recipe-order.order         = v-fbrlib-recipe-order
     1910               .
     1911           end.
     1912       end.
     1913   end.
     1914   end procedure.
     1915   procedure fbrlib-get-trn-type :
     1916   define input parameter p-recipe-code    as character    no-undo.
     1917   define input parameter p-goods-recid    as recid        no-undo.
     1918   define input parameter p-is-integration as logical      no-undo.
     1919   define output parameter p-is-comp       as logical      no-undo.
     1920   define output parameter p-trn-type      as character    no-undo.
     1921   define buffer buf_recipe    for ub.recipe.
     1922   define buffer buf_goods     for ub.goods.
     1923   do
     1924   for buf_recipe
     1925     , buf_goods
     1926   on error undo, return error
     1927   :
     1928       find first buf_goods no-lock
     1929            where recid( buf_goods ) = p-goods-recid
     1930       .
     1931       find first buf_recipe no-lock
     1932            where buf_recipe.recipe-code = p-recipe-code
     1933       no-error.
     1934       if not available buf_recipe
     1935       then do:
     1936           assign
     1937               p-is-comp = no
     1938               p-trn-type = "":U
     1939           .
     1940           undo, return.
     1941       end.
     1942       if  buf_recipe.artic        = buf_goods.artic
     1943       and buf_recipe.prod-type    = buf_goods.prod-type
     1944       and buf_recipe.prod-code    = buf_goods.prod-code
     1945       then do:
     1946           assign
     1947               p-is-comp = yes
     1948           .
     1949       end.
     1950       else do:
     1951           assign
     1952               p-is-comp = no
     1953           .
     1954       end.
     1955       case buf_recipe.recipe-type
     1956       :
     1957           when 'производство':U
     1958           then do:
     1959               if p-is-comp = yes
     1960               then do:
     1961                   assign
     1962                       p-trn-type = 'при':U
     1963                   .
     1964               end.
     1965               else do:
     1966                   assign
     1967                       p-trn-type = 'спи':U
     1968                   .
     1969               end.
     1970           end.
     1971           when 'альтернатива':U
     1972           then do:
     1973               if p-is-comp = yes
     1974               then do:
     1975                   assign
     1976                       p-trn-type = 'при':U
     1977                   .
     1978               end.
     1979               else do:
     1980                   assign
     1981                       p-trn-type = 'спи':U
     1982                   .
     1983               end.
     1984           end.
     1985           when 'разделка':U
     1986           then do:
     1987               if p-is-comp = no
     1988               then do:
     1989                   assign
     1990                       p-trn-type = 'при':U
     1991                   .
     1992               end.
     1993               else do:
     1994                   assign
     1995                       p-trn-type = 'спи':U
     1996                   .
     1997               end.
     1998           end.
     1999           when 'комплектация':U
     2000           then do:
     2001               if p-is-integration = ?
     2002               then do:
     2003                   message
     2004                       "Выберите тип операции по рецепту комплектации:"
     2005                       skip (2) "YES - комплектация"
     2006                       skip     "NO - разукомплектация"
     2007                   view-as alert-box question
     2008                   buttons YES-NO
     2009                   update p-is-integration.
     2010               end.
     2011               if p-is-integration = yes
     2012               then do:
     2013                   if p-is-comp = yes
     2014                   then do:
     2015                       assign
     2016                           p-trn-type = 'при':U
     2017                       .
     2018                   end.
     2019                   else do:
     2020                       assign
     2021                           p-trn-type = 'спи':U
     2022                       .
     2023                   end.
     2024               end.
     2025               else do:
     2026                   if p-is-comp = yes
     2027                   then do:
     2028                       assign
     2029                           p-trn-type = 'спи':U
     2030                       .
     2031                   end.
     2032                   else do:
     2033                       assign
     2034                           p-trn-type = 'при':U
     2035                       .
     2036                   end.
     2037               end.
     2038           end.
     2039       end case.
     2040   end.
     2041   end procedure.
     2042   procedure fbrlib-get-mark :
     2043   define input parameter p-recipe-code    as character    no-undo.
     2044   define output parameter p-mark          as logical    no-undo.
     2045   define buffer buf_goods-attr     for ub.goods-attr.
     2046   define buffer buf_recipe-gds for ub.recipe-gds .
     2047       for each buf_recipe-gds no-lock where buf_recipe-gds.recipe-code = p-recipe-code,
     2048            first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_recipe-gds.gds-code and
     2049                                               buf_goods-attr.attr-code = 'mark-type':U:
     2050            if buf_goods-attr.attr-value <> "" and buf_goods-attr.attr-value <> "not-type" then do:
     2051               p-mark = true .
     2052               return .
     2053            end.
     2054       end.
     2055   end procedure.
     2056   procedure fbrlib-check-temp-tables :
     2057   do
     2058   on error undo, return error
     2059   :
     2060   define input parameter p-title  as character    no-undo.
     2061       define variable v-str               as character        no-undo.
     2062       assign
     2063           v-str = v-str + chr(10) + "temp_recipe-childs-qnty:" + chr(10)
     2064       .
     2065       for each temp_recipe-childs-qnty
     2066       on error undo, return error
     2067       :
     2068           assign
     2069               v-str   = v-str + string( temp_recipe-childs-qnty.recipe-code )
     2070                       + "   " + string( temp_recipe-childs-qnty.childs-qnty )
     2071                       + "   " + string( temp_recipe-childs-qnty.order )
     2072                       + chr(10)
     2073           .
     2074       end.
     2075       assign
     2076           v-str = v-str + "temp_recipe-childs:" + chr(10)
     2077       .
     2078       for each temp_recipe-childs
     2079       on error undo, return error
     2080       :
     2081           assign
     2082               v-str   = v-str + string( temp_recipe-childs.recipe-code )
     2083                       + "   " + string( temp_recipe-childs.child-code )
     2084                       + "   " + string( temp_recipe-childs.child-recipe-code )
     2085                       + chr(10)
     2086           .
     2087       end.
     2088       assign
     2089           v-str = v-str + chr(10) + "temp_recipe-order:" + chr(10)
     2090       .
     2091       for each temp_recipe-order
     2092       on error undo, return error
     2093       :
     2094           assign
     2095               v-str   = v-str + string( temp_recipe-order.recipe-code )
     2096                       + "   " + string( temp_recipe-order.order )
     2097                       + chr(10)
     2098           .
     2099       end.
     2100       assign
     2101           v-str = v-str + chr(10) + "temp_fbrlib_recipe:" + chr(10)
     2102       .
     2103       run writelog in this-procedure ( input "fbr.log", input 0, input p-title ).
     2104       run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     2105       for each temp_fbrlib_recipe
     2106       on error undo, return error
     2107       :
     2108           assign
     2109               v-str   = "recipe-code: "                   + string( temp_fbrlib_recipe.recipe-code                 )
     2110                       + "   " + "count-income: "                  + string( temp_fbrlib_recipe.count-income                )
     2111                       + "   " + "qnty-income: "                   + string( temp_fbrlib_recipe.qnty-income                 )
     2112                       + "   " + "sum-income-sale: "               + string( temp_fbrlib_recipe.sum-income-sale             )
     2113                       + "   " + "sum-income-cost-base: "          + string( temp_fbrlib_recipe.sum-income-cost-base        )
     2114                       + "   " + "sum-income-cost-rubl: "          + string( temp_fbrlib_recipe.sum-income-cost-rubl        )
     2115                       + "   " + "sum-income-vat-cost-base: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-base    )
     2116                       + "   " + "sum-income-vat-cost-rubl: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-rubl    )
     2117                       + "   " + "count-write-off: "               + string( temp_fbrlib_recipe.count-write-off             )
     2118                       + "   " + "qnty-write-off: "                + string( temp_fbrlib_recipe.qnty-write-off              )
     2119                       + "   " + "sum-write-off-sale: "            + string( temp_fbrlib_recipe.sum-write-off-sale          )
     2120                       + "   " + "sum-write-off-cost-base: "       + string( temp_fbrlib_recipe.sum-write-off-cost-base     )
     2121                       + "   " + "sum-write-off-cost-rubl: "       + string( temp_fbrlib_recipe.sum-write-off-cost-rubl     )
     2122                       + "   " + "sum-write-off-vat-cost-base: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-base )
     2123                       + "   " + "sum-write-off-vat-cost-rubl: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-rubl )
     2124                       + chr(10)
     2125           .
     2126           run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     2127       end.
     2128   end.
     2129   end procedure.
     2130   procedure fbrlib-s-coeff-value :
     2131   define input  parameter p-gds-code    as integer        no-undo.
     2132   define input  parameter p-date        as date           no-undo.
     2133   define input  parameter p-obj-type    as character      no-undo.
     2134   define input  parameter p-obj-code    as integer        no-undo.
     2135   define output parameter p-coeff-value as decimal        no-undo.
     2136   define variable vss-description as character init "fbrlib-s-coeff-value-01: определяет значение сезонного коэффициента" no-undo.
     2137       define variable v-date          as date         no-undo.
     2138       define variable v-host-code     as integer      no-undo.
     2139       define buffer buf_goods       for ub.goods.
     2140       define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     2141       define buffer buf_clients     for ub.clients.
     2142       define buffer buf_s-coeff     for ub.s-coeff.
     2143   do
     2144   for buf_goods
     2145     , buf_fbr-gds-obj
     2146     , buf_clients
     2147     , buf_s-coeff
     2148   on error undo, return error return-value
     2149   :
     2150       find first buf_goods no-lock
     2151            where buf_goods.gds-code = p-gds-code
     2152       no-error .
     2153       if not available buf_goods
     2154       then do:
     2155          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден товар с кодом &1", p-gds-code).
     2156       end.
     2157       find first buf_clients no-lock
     2158            where buf_clients.obj-type = p-obj-type
     2159              and buf_clients.obj-code = p-obj-code
     2160       no-error.
     2161       if not available buf_clients
     2162       then do:
     2163          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден объект &1&2", p-obj-type, p-obj-code).
     2164       end.
     2165       assign
     2166           v-date = date(month(p-date), day(p-date), Year(01/01/1996))
     2167       .
     2168       find first buf_fbr-gds-obj no-lock
     2169            where buf_fbr-gds-obj.gds-code = p-gds-code
     2170              and buf_fbr-gds-obj.obj-type = p-obj-type
     2171              and buf_fbr-gds-obj.obj-code = p-obj-code
     2172       no-error.
     2173       if not available buf_fbr-gds-obj
     2174       or buf_fbr-gds-obj.is-season = no
     2175       then do:
     2176           assign
     2177               p-coeff-value = 0
     2178           .
     2179           return.
     2180       end.
     2181   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2182   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2183     (input  p-obj-type
     2184     ,input  p-obj-code
     2185     ,output v-host-code
     2186     )  .
     2187       find last buf_s-coeff no-lock
     2188           where buf_s-coeff.gds-code = p-gds-code
     2189             and buf_s-coeff.host-code = v-host-code
     2190             and buf_s-coeff.obj-type = p-obj-type
     2191             and buf_s-coeff.obj-code = p-obj-code
     2192             and buf_s-coeff.s-date <= v-date
     2193       no-error.
     2194       if available buf_s-coeff
     2195       then do:
     2196           assign
     2197               p-coeff-value = buf_s-coeff.coeff-value
     2198           .
     2199           return.
     2200       end.
     2201       find last buf_s-coeff no-lock
     2202           where buf_s-coeff.gds-code = p-gds-code
     2203             and buf_s-coeff.host-code = v-host-code
     2204             and buf_s-coeff.obj-type = "":U
     2205             and buf_s-coeff.obj-code = 0
     2206             and buf_s-coeff.s-date <= v-date
     2207       no-error.
     2208       if available buf_s-coeff
     2209       then do:
     2210           assign
     2211               p-coeff-value = buf_s-coeff.coeff-value
     2212           .
     2213           return.
     2214       end.
     2215       find last buf_s-coeff no-lock
     2216           where buf_s-coeff.gds-code = p-gds-code
     2217             and buf_s-coeff.host-code = 0
     2218             and buf_s-coeff.obj-type = "":U
     2219             and buf_s-coeff.obj-code = 0
     2220             and buf_s-coeff.s-date <= v-date
     2221       no-error.
     2222       if available buf_s-coeff
     2223       then do:
     2224           assign
     2225               p-coeff-value = buf_s-coeff.coeff-value
     2226           .
     2227       end.
     2228       else do:
     2229           assign
     2230               p-coeff-value = 0
     2231           .
     2232       end.
     2233   end.
     2234   end procedure.
     2235   procedure fbrlib_create-fbr-recipe-gds :
     2236   define input parameter p-doc-code         as character      no-undo.
     2237   define input parameter p-recipe-code      as character      no-undo.
     2238   define input parameter p-prod-type        as character      no-undo.
     2239   define input parameter p-prod-code        as integer        no-undo.
     2240   define input parameter p-artic            as character      no-undo.
     2241   define input parameter p-gds-code         as integer        no-undo.
     2242   define input parameter p-is-waste         as logical        no-undo.
     2243   define input parameter p-proc-number      as integer        no-undo.
     2244   define input parameter p-obj-date         as date           no-undo.
     2245   define input parameter p-obj-type         as character      no-undo.
     2246   define input parameter p-obj-code         as integer        no-undo.
     2247   define input parameter p-calc-method      as decimal        no-undo.
     2248   define input parameter p-coeff-waste      as decimal        no-undo.
     2249   define input parameter p-orig-qnty        as decimal        no-undo.
     2250   define input parameter p-orig-brutto-qnty as decimal        no-undo.
     2251       define variable v-coeff-season  as decimal      no-undo.
     2252       define variable v-void-decimal  as decimal      no-undo.
     2253       define variable v-void-integer  as integer      no-undo.
     2254       define variable v-recipe-type   as character    no-undo.
     2255       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     2256       define buffer buf_goods             for ub.goods.
     2257       define buffer buf_recipe            for ub.recipe.
     2258   do
     2259   for buf_fbr-recipe-gds
     2260     , buf_recipe
     2261     , buf_goods
     2262   on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2263   :
     2264       find first buf_fbr-recipe-gds exclusive-lock
     2265            where buf_fbr-recipe-gds.doc-code    = p-doc-code
     2266              and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     2267              and buf_fbr-recipe-gds.prod-type   = p-prod-type
     2268              and buf_fbr-recipe-gds.prod-code   = p-prod-code
     2269              and buf_fbr-recipe-gds.artic       = p-artic
     2270       no-error.
     2271       if not available buf_fbr-recipe-gds
     2272       then do:
     2273           create buf_fbr-recipe-gds.
     2274           assign
     2275               buf_fbr-recipe-gds.doc-code           = p-doc-code
     2276               buf_fbr-recipe-gds.recipe-code        = p-recipe-code
     2277               buf_fbr-recipe-gds.prod-type          = p-prod-type
     2278               buf_fbr-recipe-gds.prod-code          = p-prod-code
     2279               buf_fbr-recipe-gds.artic              = p-artic
     2280               buf_fbr-recipe-gds.gds-code           = p-gds-code
     2281               buf_fbr-recipe-gds.is-waste           = p-is-waste
     2282               buf_fbr-recipe-gds.proc-number        = p-proc-number
     2283               buf_fbr-recipe-gds.recipe-qnty        = p-orig-qnty
     2284               buf_fbr-recipe-gds.recipe-brutto-qnty = p-orig-brutto-qnty
     2285           .
     2286           find first buf_goods no-lock
     2287                where buf_goods.prod-type = buf_fbr-recipe-gds.prod-type
     2288                  and buf_goods.prod-code = buf_fbr-recipe-gds.prod-code
     2289                  and buf_goods.artic     = buf_fbr-recipe-gds.artic
     2290           .
     2291           run fbrlib-s-coeff-value in this-procedure (
     2292                 input buf_goods.gds-code
     2293               , input p-obj-date
     2294               , input p-obj-type
     2295               , input p-obj-code
     2296               , output v-coeff-season
     2297           ) no-error.
     2298           if error-status:error
     2299           then do:
     2300               return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
     2301           end.
     2302           assign
     2303               buf_fbr-recipe-gds.qnty         = p-orig-qnty
     2304               buf_fbr-recipe-gds.coeff-value  = v-coeff-season
     2305               buf_fbr-recipe-gds.coeff-waste  = p-coeff-waste
     2306           .
     2307           run fbrlib-get-recipe-type in this-procedure (
     2308                 input buf_fbr-recipe-gds.doc-code
     2309               , input buf_fbr-recipe-gds.recipe-code
     2310               , output v-recipe-type
     2311           ).
     2312           if v-recipe-type <> 'производство':U
     2313           then do:
     2314               assign
     2315                   buf_fbr-recipe-gds.coeff-value  = 0
     2316                   buf_fbr-recipe-gds.coeff-waste  = 0
     2317                   buf_fbr-recipe-gds.calc-method  = 1
     2318                   buf_fbr-recipe-gds.brutto-qnty  = buf_fbr-recipe-gds.qnty
     2319               .
     2320           end.
     2321           else do:
     2322               run fbrlib-calc-brutto in this-procedure (
     2323                     input v-recipe-type
     2324                   , input buf_fbr-recipe-gds.qnty
     2325                   , input buf_fbr-recipe-gds.coeff-value
     2326                   , input buf_fbr-recipe-gds.coeff-waste
     2327                   , input 0
     2328                   , input 3
     2329                   , output v-void-decimal
     2330                   , output v-void-decimal
     2331                   , output buf_fbr-recipe-gds.brutto-qnty
     2332                   , output v-void-integer
     2333               ).
     2334               assign
     2335                   buf_fbr-recipe-gds.calc-method  = p-calc-method
     2336               .
     2337               run fbrlib-calc-brutto in this-procedure (
     2338                     input v-recipe-type
     2339                   , input buf_fbr-recipe-gds.qnty
     2340                   , input buf_fbr-recipe-gds.coeff-value
     2341                   , input buf_fbr-recipe-gds.coeff-waste
     2342                   , input buf_fbr-recipe-gds.brutto-qnty
     2343                   , input buf_fbr-recipe-gds.calc-method
     2344                   , output buf_fbr-recipe-gds.qnty
     2345                   , output v-void-decimal
     2346                   , output v-void-decimal
     2347                   , output v-void-integer
     2348               ).
     2349           end.
     2350       end.
     2351   end.
     2352   end procedure.
     2353   procedure fbrlib-set-default-recipe :
     2354   define input parameter p-obj-type   as character    no-undo.
     2355   define input parameter p-obj-code   as integer      no-undo.
     2356   define input parameter p-gds-code   as integer      no-undo.
     2357       define variable v-artic             as character    no-undo.
     2358       define variable v-prod-type         as character    no-undo.
     2359       define variable v-prod-code         as character    no-undo.
     2360       define variable v-recipe-code       as character    no-undo.
     2361       define variable v-fbr-gds-obj-recid as recid        no-undo.
     2362       define variable v-recipe-found      as logical      no-undo.
     2363       define buffer buf_recipe        for ub.recipe.
     2364       define buffer buf_other_recipe  for ub.recipe.
     2365       define buffer buf_goods         for ub.goods.
     2366       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     2367   do
     2368   for buf_recipe
     2369     , buf_goods
     2370     , buf_fbr-gds-obj
     2371   on error undo, return error
     2372   :
     2373       find first buf_goods no-lock
     2374            where buf_goods.gds-code = p-gds-code
     2375       .
     2376       run fbrlib-get-obj-recipe in this-procedure (
     2377             input p-obj-type
     2378           , input p-obj-code
     2379           , input p-gds-code
     2380           , output v-recipe-code
     2381       ).
     2382       if v-recipe-code <> ""
     2383       then do:
     2384           find first buf_recipe no-lock
     2385               where buf_recipe.recipe-code = v-recipe-code
     2386           no-error.
     2387           if not available buf_recipe
     2388           then do:
     2389               assign
     2390                   v-recipe-code = ""
     2391               .
     2392           end.
     2393       end.
     2394       if v-recipe-code = ""
     2395       then do:
     2396           find first buf_fbr-gds-obj exclusive-lock
     2397                where buf_fbr-gds-obj.obj-type = p-obj-type
     2398                  and buf_fbr-gds-obj.obj-code = p-obj-code
     2399                  and buf_fbr-gds-obj.gds-code = p-gds-code
     2400           no-error.
     2401           if not available buf_fbr-gds-obj
     2402           then do:
     2403               run ref/fgdsobj1.p (
     2404                     input-output v-fbr-gds-obj-recid
     2405                   , input 'ДОБАВЛЕНИЕ':U
     2406                   , input no
     2407                   , input p-gds-code
     2408                   , input p-obj-type
     2409                   , input p-obj-code
     2410                   , input 0
     2411                   , input ""
     2412                   , input 0
     2413                   , input no
     2414                   , input no
     2415                   , input no
     2416                   , input no
     2417                   , input no
     2418                   , input no
     2419               ) no-error.
     2420               if error-status:error
     2421               then do:
     2422                   message
     2423                           vss-workfile vss-revision vss-description
     2424                       skip "Ошибка изменения атрибутов товара на объекте"
     2425                       skip return-value
     2426                       skip trim(error-status :get-message(1))
     2427                               trim(error-status :get-message(2))
     2428                               trim(error-status :get-message(3))
     2429                   view-as alert-box error.
     2430                   undo, return error .
     2431               end.
     2432               find first buf_fbr-gds-obj exclusive-lock
     2433                    where recid( buf_fbr-gds-obj ) = v-fbr-gds-obj-recid
     2434               .
     2435           end.
     2436           assign
     2437               v-recipe-found = no
     2438           .
     2439           for first buf_recipe no-lock
     2440               where buf_recipe.obj-type    = p-obj-type
     2441                 and buf_recipe.obj-code    = p-obj-code
     2442                 and buf_recipe.artic       = buf_goods.artic
     2443                 and buf_recipe.prod-type   = buf_goods.prod-type
     2444                 and buf_recipe.prod-code   = buf_goods.prod-code
     2445                 and buf_recipe.recipe-type = 'производство':U
     2446                 or (
     2447                     buf_recipe.obj-type    = ""
     2448                 and buf_recipe.obj-code    = 0
     2449                 and buf_recipe.artic       = buf_goods.artic
     2450                 and buf_recipe.prod-type   = buf_goods.prod-type
     2451                 and buf_recipe.prod-code   = buf_goods.prod-code
     2452                 and buf_recipe.recipe-type = 'производство':U
     2453                     )
     2454           :
     2455               assign
     2456                   v-recipe-found = yes
     2457                   buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2458               .
     2459           end.
     2460           if v-recipe-found = no
     2461           then do:
     2462               for first buf_recipe no-lock
     2463                   where buf_recipe.obj-type    = p-obj-type
     2464                     and buf_recipe.obj-code    = p-obj-code
     2465                     and buf_recipe.artic       = buf_goods.artic
     2466                     and buf_recipe.prod-type   = buf_goods.prod-type
     2467                     and buf_recipe.prod-code   = buf_goods.prod-code
     2468                     and buf_recipe.recipe-type <> 'альтернатива':U
     2469                     or (
     2470                         buf_recipe.obj-type    = ""
     2471                     and buf_recipe.obj-code    = 0
     2472                     and buf_recipe.artic       = buf_goods.artic
     2473                     and buf_recipe.prod-type   = buf_goods.prod-type
     2474                     and buf_recipe.prod-code   = buf_goods.prod-code
     2475                     and buf_recipe.recipe-type <> 'альтернатива':U
     2476                         )
     2477               :
     2478                   assign
     2479                       v-recipe-found = yes
     2480                       buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2481                   .
     2482               end.
     2483               if v-recipe-found = no
     2484               then do:
     2485                   for first buf_recipe no-lock
     2486                       where buf_recipe.obj-type    = p-obj-type
     2487                         and buf_recipe.obj-code    = p-obj-code
     2488                         and buf_recipe.artic       = buf_goods.artic
     2489                         and buf_recipe.prod-type   = buf_goods.prod-type
     2490                         and buf_recipe.prod-code   = buf_goods.prod-code
     2491                         or (
     2492                             buf_recipe.obj-type    = ""
     2493                         and buf_recipe.obj-code    = 0
     2494                         and buf_recipe.artic       = buf_goods.artic
     2495                         and buf_recipe.prod-type   = buf_goods.prod-type
     2496                         and buf_recipe.prod-code   = buf_goods.prod-code
     2497                             )
     2498                   :
     2499                       assign
     2500                           v-recipe-found = yes
     2501                           buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2502                       .
     2503                   end.
     2504                   if v-recipe-found = no
     2505                   then do:
     2506                       assign
     2507                           buf_fbr-gds-obj.default-recipe-code = ""
     2508                       .
     2509                   end.
     2510               end.
     2511           end.
     2512       end.
     2513   end.
     2514   end procedure.
     2515   procedure fbrlib-get-obj-recipe :
     2516   define input parameter p-obj-type       as character    no-undo.
     2517   define input parameter p-obj-code       as integer      no-undo.
     2518   define input parameter p-gds-code       as integer      no-undo.
     2519   define output parameter p-recipe-code   as character    no-undo.
     2520       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     2521   do
     2522   for buf_fbr-gds-obj
     2523   on error undo, return error
     2524   :
     2525       find first buf_fbr-gds-obj no-lock
     2526            where buf_fbr-gds-obj.obj-type = p-obj-type
     2527              and buf_fbr-gds-obj.obj-code = p-obj-code
     2528              and buf_fbr-gds-obj.gds-code = p-gds-code
     2529       no-error.
     2530       if available buf_fbr-gds-obj
     2531       then do:
     2532           assign
     2533               p-recipe-code = buf_fbr-gds-obj.default-recipe-code
     2534           .
     2535       end.
     2536       else do:
     2537           assign
     2538               p-recipe-code = ""
     2539           .
     2540       end.
     2541   end.
     2542   end procedure.
     2543   procedure fbrlib-create-or-update-recipe-gds :
     2544   define input parameter p-recipe-code    as character        no-undo.
     2545   define input parameter p-gds-code       as integer          no-undo.
     2546   define input parameter p-is-waste       as logical          no-undo.
     2547   define input parameter p-qnty           as decimal          no-undo.
     2548   define input parameter p-proc-number    as integer          no-undo.
     2549   define input parameter p-nws-self       as logical          no-undo.
     2550       define variable v-max-proc-num  as integer      no-undo.
     2551       define variable v-recipe-type   as character    no-undo.
     2552       define buffer buf_goods             for ub.goods.
     2553       define buffer buf_recipe-gds        for ub.recipe-gds.
     2554       define buffer buf_recipe            for ub.recipe.
     2555       define buffer buf_proc_recipe-gds   for ub.recipe-gds.
     2556   do
     2557   for buf_goods
     2558     , buf_recipe-gds
     2559     , buf_recipe
     2560     , buf_proc_recipe-gds
     2561   on error undo, return error
     2562   :
     2563       find first buf_recipe no-lock
     2564            where buf_recipe.recipe-code = p-recipe-code
     2565       .
     2566       find first buf_goods no-lock
     2567            where buf_goods.gds-code = p-gds-code
     2568       .
     2569       find first buf_recipe-gds
     2570            where buf_recipe-gds.recipe-code = p-recipe-code
     2571              and buf_recipe-gds.prod-type   = buf_goods.prod-type
     2572              and buf_recipe-gds.prod-code   = buf_goods.prod-code
     2573              and buf_recipe-gds.artic       = buf_goods.artic
     2574       no-error.
     2575       if not available buf_recipe-gds
     2576       then do:
     2577           create buf_recipe-gds.
     2578           assign
     2579               buf_recipe-gds.recipe-code = p-recipe-code
     2580               buf_recipe-gds.gds-code    = p-gds-code
     2581               buf_recipe-gds.prod-type   = buf_goods.prod-type
     2582               buf_recipe-gds.prod-code   = buf_goods.prod-code
     2583               buf_recipe-gds.artic       = buf_goods.artic
     2584           .
     2585           assign
     2586               buf_recipe-gds.is-waste    = no
     2587               buf_recipe-gds.qnty        = 0
     2588               buf_recipe-gds.coeff-waste = 0
     2589               buf_recipe-gds.brutto-qnty = 0
     2590               buf_recipe-gds.proc-number = 0
     2591               buf_recipe-gds.nws-self    = no
     2592           .
     2593       end.
     2594       assign
     2595           buf_recipe-gds.is-waste    = p-is-waste
     2596       .
     2597       run fbrlib-get-recipe-type in this-procedure (
     2598             input "":U
     2599           , input buf_recipe-gds.recipe-code
     2600           , output v-recipe-type
     2601       ).
     2602       if v-recipe-type <> 'производство':U
     2603       then do:
     2604           assign
     2605               buf_recipe-gds.calc-method = 1
     2606               buf_recipe-gds.qnty        = p-qnty
     2607               buf_recipe-gds.brutto-qnty = p-qnty
     2608               buf_recipe-gds.coeff-waste = 0
     2609           .
     2610       end.
     2611       else do:
     2612           assign
     2613               buf_recipe-gds.calc-method = 1
     2614               buf_recipe-gds.brutto-qnty = p-qnty
     2615           .
     2616           run fbrlib-calc-brutto in this-procedure (
     2617                 input v-recipe-type
     2618               , input 0
     2619               , input 0
     2620               , input buf_recipe-gds.coeff-waste
     2621               , input buf_recipe-gds.brutto-qnty
     2622               , input 1
     2623               , output buf_recipe-gds.qnty
     2624               , output buf_recipe-gds.coeff-waste
     2625               , output buf_recipe-gds.brutto-qnty
     2626               , output buf_recipe-gds.calc-method
     2627           ).
     2628       end.
     2629       assign
     2630           buf_recipe-gds.nws-self    = p-nws-self
     2631       .
     2632       if buf_recipe.recipe-type = 'альтернатива':U
     2633       and buf_recipe-gds.proc-number <> 0
     2634       then do:
     2635       end.
     2636       else do:
     2637           if p-proc-number <> 0
     2638           then do:
     2639               assign
     2640                   buf_recipe-gds.proc-number = p-proc-number
     2641               .
     2642           end.
     2643           else do:
     2644               assign
     2645                   v-max-proc-num = 0
     2646               .
     2647               for each buf_proc_recipe-gds no-lock
     2648                  where buf_proc_recipe-gds.recipe-code = p-recipe-code
     2649               :
     2650                   if recid( buf_proc_recipe-gds ) <> recid( buf_recipe-gds )
     2651                   then do:
     2652                       assign
     2653                           v-max-proc-num = ( if v-max-proc-num < buf_proc_recipe-gds.proc-number then buf_proc_recipe-gds.proc-number else v-max-proc-num )
     2654                       .
     2655                   end.
     2656               end.
     2657               assign
     2658                   buf_recipe-gds.proc-number = v-max-proc-num + 1
     2659               .
     2660           end.
     2661       end.
     2662   end.
     2663   end procedure.
     2664   PROCEDURE fbrlib-create-or-update-recipe :
     2665   define input parameter p-mode               as character    no-undo.
     2666   define input parameter p-obj-type           as character    no-undo.
     2667   define input parameter p-obj-code           as integer      no-undo.
     2668   define input parameter p-recipe-code        as character    no-undo.
     2669   define input parameter p-recipe-type        as character    no-undo.
     2670   define input parameter p-gds-code           as integer      no-undo.
     2671   define input parameter p-name               as character    no-undo.
     2672   define input parameter p-design             as character    no-undo.
     2673   define input parameter p-order              as integer      no-undo.
     2674   define input parameter p-quality            as character    no-undo.
     2675   define input parameter p-ref-num            as character    no-undo.
     2676   define input parameter p-technique          as character    no-undo.
     2677   define input parameter p-template           as character    no-undo.
     2678   define input parameter p-qnty               as decimal      no-undo.
     2679   define input parameter p-portion-qnty       as integer      no-undo.
     2680   define input parameter p-portion-weight     as decimal      no-undo.
     2681   define output parameter p-new-recipe-code   as character    no-undo.
     2682       define variable v-host-code         as integer      no-undo.
     2683       define variable v-fbr-gds-obj-recid as recid        no-undo.
     2684       define buffer buf_recipe    for ub.recipe.
     2685       define buffer buf_goods     for ub.goods.
     2686   do
     2687   for buf_recipe
     2688     , buf_goods
     2689   on error undo, return error
     2690   :
     2691       if p-mode <> 'ДОБАВЛЕНИЕ':U
     2692       and p-mode <> 'ИЗМЕНЕНИЕ':U
     2693       then do:
     2694           message
     2695               skip "Ошибка задания типа операции для создания или измения рецепта."
     2696               skip (1)
     2697               skip "Задан тип операции:" p-mode
     2698           view-as alert-box error.
     2699           undo, return error .
     2700       end.
     2701       if p-recipe-code = ""
     2702       then do:
     2703   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2704   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2705     (input  p-obj-type
     2706     ,input  p-obj-code
     2707     ,output v-host-code
     2708     )  .
     2709           find first buf_goods no-lock
     2710                where buf_goods.gds-code = p-gds-code
     2711           .
     2712           create buf_recipe .
     2713           run fbrcode-gen-recipe-code in this-procedure (
     2714                 input p-obj-type
     2715               , input p-obj-code
     2716               , output buf_recipe.recipe-code
     2717           ).
     2718           assign
     2719               buf_recipe.artic               = buf_goods.artic
     2720               buf_recipe.prod-type           = buf_goods.prod-type
     2721               buf_recipe.prod-code           = buf_goods.prod-code
     2722               buf_recipe.recipe-type         = p-recipe-type
     2723               buf_recipe.recipe-name         = ( if p-name = "" then buf_goods.gds-name else p-name )
     2724               buf_recipe.gds-code            = p-gds-code
     2725               buf_recipe.host-code           = v-host-code
     2726               buf_recipe.obj-type            = p-obj-type
     2727               buf_recipe.obj-code            = p-obj-code
     2728               buf_recipe.recipe-design       = ""
     2729               buf_recipe.recipe-order        = 0
     2730               buf_recipe.recipe-quality      = ""
     2731               buf_recipe.recipe-ref-num      = ""
     2732               buf_recipe.recipe-technique    = ""
     2733               buf_recipe.recipe-template     = ""
     2734               buf_recipe.qnty                = 1.0
     2735               buf_recipe.portion-qnty        = 1
     2736               buf_recipe.portion-weight      = 0
     2737           .
     2738       end.
     2739       if p-name <> ""
     2740       then do:
     2741           assign
     2742               buf_recipe.recipe-name = p-name
     2743           .
     2744       end.
     2745       assign
     2746           buf_recipe.recipe-design       = p-design
     2747           buf_recipe.recipe-order        = p-order
     2748           buf_recipe.recipe-quality      = p-quality
     2749           buf_recipe.recipe-ref-num      = p-ref-num
     2750           buf_recipe.recipe-technique    = p-technique
     2751           buf_recipe.recipe-template     = p-template
     2752           buf_recipe.qnty                = p-qnty
     2753           buf_recipe.portion-qnty        = p-portion-qnty
     2754           buf_recipe.portion-weight      = p-portion-weight
     2755       .
     2756       assign
     2757           p-new-recipe-code = buf_recipe.recipe-code
     2758       .
     2759       run fbrlib-set-default-recipe in this-procedure (
     2760             input p-obj-type
     2761           , input p-obj-code
     2762           , input buf_goods.gds-code
     2763       ).
     2764   end.
     2765   END PROCEDURE.
     2766   PROCEDURE fbrlib-delete-fact-fbr-doc :
     2767   define input parameter parparentproc-handle as widget-handle no-undo .
     2768   define input parameter p-doc-code   as character no-undo.
     2769   define input parameter p-chip-num   like ub.c-trn-doc.chip-num no-undo .
     2770       define variable v-shift-on      as logical      no-undo.
     2771       define variable v-shift-date    as date         no-undo.
     2772       define variable v-shift-num     as integer      no-undo.
     2773       define variable v-shift-name    as character    no-undo.
     2774       define variable v-obj-date      as date         no-undo.
     2775       define variable v-chip-num      as integer      no-undo.
     2776       define buffer buf_fbr-doc       for ub.fbr-doc.
     2777       define buffer buf_fbr-line      for ub.fbr-line.
     2778       define buffer buf_c-fbr-doc     for ub.c-fbr-doc.
     2779       define buffer buf_fbr-recipe     for ub.fbr-recipe.
     2780       define buffer buf_fbr-recipe-gds for ub.fbr-recipe-gds.
     2781       define buffer buf_marking-lines for ub.marking-lines .
     2782       define buffer buf_marking       for ub.marking .
     2783       define buffer buf_goods         for ub.goods .
     2784   do
     2785   for buf_fbr-doc
     2786     , buf_fbr-line
     2787     , buf_c-fbr-doc
     2788     , buf_fbr-recipe
     2789     , buf_fbr-recipe-gds
     2790     , buf_goods
     2791     , buf_marking
     2792     , buf_marking-lines
     2793   on error undo, return error
     2794   :
     2795   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2796     define variable v-cntxt-db-num        as integer   no-undo .
     2797     define variable v-cntxt-userid        as character no-undo .
     2798     define variable v-cntxt-level         as character no-undo .
     2799     define variable v-cntxt-host-code-obj as integer   no-undo .
     2800     define variable v-cntxt-obj-type      as character no-undo .
     2801     define variable v-cntxt-obj-code      as integer   no-undo .
     2802     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2803     define variable v-cntxt-is-admin      as logical   no-undo .
     2804   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2805     run mainmenu_getcntxt in parparentproc-handle
     2806       (output v-cntxt-db-num
     2807       ,output v-cntxt-userid
     2808       ,output v-cntxt-level
     2809       ,output v-cntxt-host-code-obj
     2810       ,output v-cntxt-obj-type
     2811       ,output v-cntxt-obj-code
     2812       ,output v-cntxt-db-num-obj
     2813       ,output v-cntxt-is-admin
     2814       ) .
     2815       if search ("delfbr.err") <> ?
     2816       then do:
     2817           os-delete "delfbr.err".
     2818       end.
     2819     _del-block:
     2820       do transaction
     2821     on error undo _del-block, return error return-value
     2822     on endkey undo _del-block , return error return-value
     2823     on stop undo _del-block , return error return-value
     2824       :
     2825           find first buf_fbr-doc exclusive-lock
     2826                where buf_fbr-doc.doc-code = p-doc-code
     2827           no-error.
     2828           if not available buf_fbr-doc
     2829           then do:
     2830         undo _del-block, return error substitute("&1 &2 &3&4Не найден документ производства &5 для удаления."
     2831                                           ,vss-workfile
     2832                                           ,vss-revision
     2833                                           ,vss-description
     2834                                           ,chr(10)
     2835                                           , p-doc-code).
     2836           end.
     2837           run fbrlib-delete-fact-trn-doc in this-procedure (
     2838               input parparentproc-handle
     2839              ,input p-doc-code
     2840              ,input 'при':U
     2841              ,input p-chip-num
     2842              ,output v-chip-num
     2843           ) no-error.
     2844           if error-status :error
     2845           then do:
     2846               run fbrlib-print-del-error-message in this-procedure .
     2847         undo _del-block, return error.
     2848           end.
     2849           assign
     2850           p-chip-num = (if p-chip-num = ?
     2851                         then v-chip-num
     2852                         else p-chip-num).
     2853           run fbrlib-delete-fact-trn-doc in this-procedure (
     2854               input parparentproc-handle
     2855              ,input p-doc-code
     2856              ,input 'рас':U
     2857              ,input p-chip-num
     2858              ,output v-chip-num
     2859           ) no-error.
     2860           if error-status :error
     2861           then do:
     2862               run fbrlib-print-del-error-message in this-procedure .
     2863         undo _del-block, return error.
     2864           end.
     2865           run fbrlib-delete-fact-trn-doc in this-procedure (
     2866               input parparentproc-handle
     2867              ,input p-doc-code
     2868              ,input 'спи':U
     2869              ,input p-chip-num
     2870              ,output v-chip-num
     2871           ) no-error.
     2872           if error-status :error
     2873           then do:
     2874               run fbrlib-print-del-error-message in this-procedure .
     2875         undo _del-block, return error.
     2876           end.
     2877           create buf_c-fbr-doc.
     2878           buffer-copy buf_fbr-doc to buf_c-fbr-doc.
     2879   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2880   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     2881     (input  buf_fbr-doc.obj-type
     2882     ,input  buf_fbr-doc.obj-code
     2883     ,output v-obj-date
     2884     ) no-error .
     2885           if error-status :error
     2886           or v-obj-date = ?
     2887           then do:
     2888         undo _del-block, return error "Нет текущей даты на объекте документа.".
     2889           end.
     2890   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2891   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2892     (input  buf_fbr-doc.obj-type
     2893     ,input  buf_fbr-doc.obj-code
     2894     ,input  'shift-on=request'
     2895     ,output v-shift-on
     2896     )  .
     2897           if v-shift-on
     2898           then do:
     2899   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2900   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     2901     (input  buf_fbr-doc.obj-type
     2902     ,input  buf_fbr-doc.obj-code
     2903     ,output v-shift-date
     2904     ,output v-shift-num
     2905     ,output v-shift-name
     2906     ) no-error .
     2907               if error-status :error
     2908               then do:
     2909           undo _del-block, return error "Ошибка при поиске текущей смены на объекте".
     2910               end.
     2911           end.
     2912           else do:
     2913               assign
     2914                   v-shift-date = ?
     2915                   v-shift-num  = ?
     2916                   v-shift-name = ?
     2917               .
     2918           end.
     2919           define variable v-today       as date         no-undo.
     2920           define variable v-time        as integer      no-undo.
     2921           run cur-time in this-procedure (
     2922                 output v-today
     2923               , output v-time
     2924           ).
     2925           assign
     2926               buf_c-fbr-doc.chip-num         = (if p-chip-num <> ? then p-chip-num else next-value( s-corr-chip, ub  ))
     2927               buf_c-fbr-doc.corr-user-name   = v-cntxt-userid
     2928               buf_c-fbr-doc.corr-user-db-num = v-cntxt-db-num
     2929               buf_c-fbr-doc.corr-date        = v-today
     2930               buf_c-fbr-doc.corr-time        = v-time
     2931               buf_c-fbr-doc.corr-shift-date  = v-shift-date
     2932               buf_c-fbr-doc.corr-shift-num   = v-shift-num
     2933               buf_c-fbr-doc.corr-shift-name  = v-shift-name
     2934               buf_c-fbr-doc.is-del           = yes
     2935           .
     2936           assign
     2937               buf_fbr-doc.is-del = yes
     2938           .
     2939           for each buf_fbr-line exclusive-lock
     2940              where buf_fbr-line.doc-code = p-doc-code
     2941       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2942       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     2943       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     2944           :
     2945               for first buf_goods no-lock where buf_goods.artic      = buf_fbr-line.artic
     2946                                             and buf_goods.prod-type  = buf_fbr-line.prod-type
     2947                                             and buf_goods.prod-code  = buf_fbr-line.prod-code,
     2948               each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = buf_goods.gds-code
     2949                                                       and buf_marking-lines.obj-type = buf_fbr-doc.obj-type
     2950                                                       and buf_marking-lines.obj-code = buf_fbr-doc.obj-code
     2951                                                       and buf_marking-lines.in-code  = "manufacturing"
     2952                                                       and buf_marking-lines.out-code = buf_fbr-line.doc-code
     2953                                                       and buf_marking-lines.part-code = buf_fbr-line.recipe-code
     2954                                                       and buf_marking-lines.prt-code = 0
     2955               :
     2956                 for first buf_marking exclusive-lock where buf_marking.mark begins buf_marking-lines.mark :
     2957                   assign
     2958                     buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB when buf_fbr-line.is-comp
     2959                   .
     2960                 end .
     2961                 delete buf_marking-lines.
     2962               end .
     2963               delete buf_fbr-line.
     2964           end.
     2965           for each buf_fbr-recipe exclusive-lock
     2966              where buf_fbr-recipe.doc-code = p-doc-code
     2967       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2968       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     2969       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     2970           :
     2971               delete buf_fbr-recipe.
     2972           end.
     2973           for each buf_fbr-recipe-gds exclusive-lock
     2974              where buf_fbr-recipe-gds.doc-code = p-doc-code
     2975       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2976       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     2977       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     2978           :
     2979               delete buf_fbr-recipe-gds.
     2980           end.
     2981           delete buf_fbr-doc.
     2982       end.
     2983   end.
     2984   END PROCEDURE.
     2985   PROCEDURE fbrlib-del-trn-doc :
     2986   do
     2987   on error undo, return error
     2988   :
     2989   define input parameter parparentproc        as widget-handle no-undo .
     2990   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     2991   define input parameter p-trn-doc-type       as character    no-undo.
     2992   define input parameter p-phchip-num         like ub.c-trn-doc.chip-num no-undo .
     2993   define output parameter p-chip-num           like ub.c-trn-doc.chip-num no-undo .
     2994       define variable v-trn-doc-doc-code  as character     no-undo.
     2995       define buffer buf_trn-doc       for ub.trn-doc.
     2996   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2997     define variable v-cntxt-db-num        as integer   no-undo .
     2998     define variable v-cntxt-userid        as character no-undo .
     2999     define variable v-cntxt-level         as character no-undo .
     3000     define variable v-cntxt-host-code-obj as integer   no-undo .
     3001     define variable v-cntxt-obj-type      as character no-undo .
     3002     define variable v-cntxt-obj-code      as integer   no-undo .
     3003     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3004     define variable v-cntxt-is-admin      as logical   no-undo .
     3005   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3006     run mainmenu_getcntxt in parparentproc
     3007       (output v-cntxt-db-num
     3008       ,output v-cntxt-userid
     3009       ,output v-cntxt-level
     3010       ,output v-cntxt-host-code-obj
     3011       ,output v-cntxt-obj-type
     3012       ,output v-cntxt-obj-code
     3013       ,output v-cntxt-db-num-obj
     3014       ,output v-cntxt-is-admin
     3015       ) .
     3016       run fbrcode-trn-doc in this-procedure (
     3017             input 'производство':U
     3018           , input p-fbr-doc-doc-code
     3019           , input p-trn-doc-type
     3020           , output v-trn-doc-doc-code
     3021       ).
     3022       find first buf_trn-doc no-lock
     3023            where buf_trn-doc.doc-code = v-trn-doc-doc-code
     3024       no-error.
     3025       if available buf_trn-doc
     3026       then do:
     3027           run str/del-doc.p (
     3028                 input parparentproc
     3029               , input buf_trn-doc.doc-code
     3030               , input v-cntxt-db-num
     3031               , input "del-doc.err"
     3032               , input ?
     3033               , input p-fbr-doc-doc-code
     3034               , input v-cntxt-userid
     3035               , input 0
     3036               , input p-phchip-num
     3037               , output p-chip-num
     3038           ) no-error.
     3039           if error-status :error
     3040           then do:
     3041             undo, return error substitute("Не удалось удалить складской документ &1, созданный по документу производства &2.&3&4&3&5"
     3042                                           ,v-trn-doc-doc-code
     3043                                           ,p-fbr-doc-doc-code
     3044                                           , chr(10)
     3045                                           , error-status:get-message(1)
     3046                                           , return-value ).
     3047           end.
     3048       end.
     3049   end.
     3050   END PROCEDURE.
     3051   PROCEDURE fbrlib-delete-fact-trn-doc :
     3052   define input parameter parparentproc    as widget-handle    no-undo.
     3053   define input parameter p-fbr-doc-code   as character        no-undo.
     3054   define input parameter p-doc-type       as character    no-undo.
     3055   define input parameter p-ph-chip-num       like ub.c-trn-doc.chip-num no-undo .
     3056   define output parameter p-chip-num      like ub.c-trn-doc.chip-num no-undo .
     3057       define variable v-doc-code          as character        no-undo.
     3058       define variable v-ext-doc-type      as character        no-undo.
     3059       define variable v-trn-doc-recid     as recid            no-undo.
     3060       define variable varchip-code        as integer          no-undo.
     3061       define variable varchip-code2       as integer          no-undo.
     3062       define variable v-chip-counter      as integer          no-undo.
     3063       define buffer buf_trn-doc       for ub.trn-doc.
     3064       define buffer buf_pri_trn-doc   for ub.trn-doc.
     3065       define buffer buf_cons_trn-doc  for ub.trn-doc.
     3066   do
     3067   for buf_trn-doc
     3068     , buf_pri_trn-doc
     3069     , buf_cons_trn-doc
     3070   on error undo, return error
     3071   :
     3072   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3073     define variable v-cntxt-db-num        as integer   no-undo .
     3074     define variable v-cntxt-userid        as character no-undo .
     3075     define variable v-cntxt-level         as character no-undo .
     3076     define variable v-cntxt-host-code-obj as integer   no-undo .
     3077     define variable v-cntxt-obj-type      as character no-undo .
     3078     define variable v-cntxt-obj-code      as integer   no-undo .
     3079     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3080     define variable v-cntxt-is-admin      as logical   no-undo .
     3081   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3082     run mainmenu_getcntxt in parparentproc
     3083       (output v-cntxt-db-num
     3084       ,output v-cntxt-userid
     3085       ,output v-cntxt-level
     3086       ,output v-cntxt-host-code-obj
     3087       ,output v-cntxt-obj-type
     3088       ,output v-cntxt-obj-code
     3089       ,output v-cntxt-db-num-obj
     3090       ,output v-cntxt-is-admin
     3091       ) .
     3092       run fbrcode-trn-doc in this-procedure (
     3093             input 'производство':U
     3094           , input p-fbr-doc-code
     3095           , input p-doc-type
     3096           , output v-doc-code
     3097       ).
     3098       find first buf_trn-doc no-lock
     3099            where buf_trn-doc.doc-code = v-doc-code
     3100       no-error.
     3101       if not available buf_trn-doc
     3102       then do:
     3103           if p-doc-type <> 'спи':U
     3104           then do:
     3105               message
     3106                   "Не найден документ '" p-doc-type "'"
     3107                   "по документу производства " p-fbr-doc-code
     3108               view-as alert-box.
     3109               undo, return error.
     3110           end.
     3111           else do:
     3112           end.
     3113       end.
     3114       else do:
     3115           assign
     3116               v-trn-doc-recid = recid( buf_trn-doc )
     3117               v-ext-doc-type  = buf_trn-doc.ext-doc-type
     3118           .
     3119           if v-ext-doc-type = 'ev':U
     3120           then do:
     3121               find first buf_pri_trn-doc no-lock
     3122                    where buf_pri_trn-doc.out-code     = v-doc-code
     3123                      and buf_pri_trn-doc.ext-doc-type = 'iv':U
     3124               no-error.
     3125               if available buf_pri_trn-doc
     3126               then do:
     3127                   run str/del-doc.p (
     3128                         input parparentproc
     3129                       , input buf_pri_trn-doc.doc-code
     3130                       , input v-cntxt-db-num
     3131                       , input "delfbr.err"
     3132                       , input ?
     3133                       , input p-fbr-doc-code
     3134                       , input v-cntxt-userid
     3135                       , input 0
     3136                       , input (if p-ph-chip-num <> ?
     3137                               then p-ph-chip-num
     3138                               else (if varchip-code <> 0
     3139                                   then varchip-code
     3140                                   else ?)
     3141                               )
     3142                       , output varchip-code2
     3143                   ) no-error.
     3144                   if error-status :error
     3145                   then do:
     3146                     undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     3147                                                   ,buf_pri_trn-doc.doc-code
     3148                                                   ,p-fbr-doc-code
     3149                                                   , chr(10)
     3150                                                   , error-status:get-message(1)
     3151                                                   , return-value ).
     3152                   end.
     3153               end.
     3154           end.
     3155           define buffer buf_out_trn-doc       for ub.trn-doc.
     3156           if p-doc-type = 'при':U
     3157           then do:
     3158               assign
     3159                   v-chip-counter = 0
     3160               .
     3161               for each buf_out_trn-doc exclusive-lock
     3162                  where buf_out_trn-doc.out-code = buf_trn-doc.doc-code
     3163               on error undo, return error
     3164               :
     3165                   assign
     3166                       v-chip-counter = v-chip-counter + 1
     3167                   .
     3168                   if v-chip-counter > 1
     3169                   then do:
     3170                       assign
     3171                           varchip-code = varchip-code2
     3172                       .
     3173                   end.
     3174                   run str/del-doc.p (
     3175                         input parparentproc
     3176                       , input buf_out_trn-doc.doc-code
     3177                       , input v-cntxt-db-num
     3178                       , input "delfbr.err"
     3179                       , input ?
     3180                       , input p-fbr-doc-code
     3181                       , input v-cntxt-userid
     3182                       , input 0
     3183                       , input (if p-ph-chip-num <> ?
     3184                               then p-ph-chip-num
     3185                               else (if varchip-code <> 0
     3186                                   then varchip-code
     3187                                   else ?)
     3188                               )
     3189                       , output varchip-code2
     3190                   ) no-error.
     3191                   if error-status :error
     3192                   then do:
     3193                     undo, return error substitute("Ошибка при удалении складского документа &1, связанного со складским документов прихода &2, созданный по документу производства &3.&4&5&4&6"
     3194                                                   ,buf_out_trn-doc.doc-code
     3195                                                   ,buf_trn-doc.doc-code
     3196                                                   ,p-fbr-doc-code
     3197                                                   , chr(10)
     3198                                                   , error-status:get-message(1)
     3199                                                   , return-value ).
     3200                   end.
     3201               end.
     3202           end.
     3203           run str/del-doc.p (
     3204                 input parparentproc
     3205               , input buf_trn-doc.doc-code
     3206               , input v-cntxt-db-num
     3207               , input "delfbr.err"
     3208               , input ?
     3209               , input p-fbr-doc-code
     3210               , input v-cntxt-userid
     3211               , input 0
     3212               , input (if p-ph-chip-num <> ?
     3213                        then p-ph-chip-num
     3214                        else (if varchip-code <> 0
     3215                              then varchip-code
     3216                              else ?)
     3217                        )
     3218               , output varchip-code2
     3219           ) no-error.
     3220           if error-status :error
     3221           then do:
     3222               undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     3223                                             ,buf_trn-doc.doc-code
     3224                                             ,p-fbr-doc-code
     3225                                             , chr(10)
     3226                                             , error-status:get-message(1)
     3227                                             , return-value ).
     3228           end.
     3229           if p-doc-type = 'рас':U
     3230           or p-doc-type = 'спи':U
     3231           then do:
     3232               assign
     3233                   v-chip-counter = 0
     3234               .
     3235               for each buf_cons_trn-doc no-lock
     3236                  where buf_cons_trn-doc.out-code      = v-doc-code
     3237                    and buf_cons_trn-doc.ext-doc-type  = 'pc':U
     3238               :
     3239                   assign
     3240                       v-trn-doc-recid = recid( buf_cons_trn-doc )
     3241                       v-chip-counter = v-chip-counter + 1
     3242                   .
     3243                   assign
     3244                   varchip-code = if v-chip-counter = 2
     3245                                  then varchip-code2
     3246                                  else varchip-code.
     3247                   run str/del-doc.p (
     3248                         input parparentproc
     3249                       , input buf_cons_trn-doc.doc-code
     3250                       , input v-cntxt-db-num
     3251                       , input "delfbr.err"
     3252                       , input ?
     3253                       , input ?
     3254                       , input v-cntxt-userid
     3255                       , input 0
     3256                       , input (if p-ph-chip-num <> ?
     3257                                then p-ph-chip-num
     3258                                else ( if v-chip-counter = 1
     3259                                       then ?
     3260                                       else varchip-code )
     3261                                )
     3262                       , output varchip-code2
     3263                   ) no-error.
     3264                   if error-status :error
     3265                   then do:
     3266                       undo, return error substitute("Ошибка при удалении складского документа смены типа приобретения &1, созданный по документу производства &2.&3&4&3&5"
     3267                                                     ,buf_cons_trn-doc.doc-code
     3268                                                     ,p-fbr-doc-code
     3269                                                     , chr(10)
     3270                                                     , error-status:get-message(1)
     3271                                                     , return-value ).
     3272                   end.
     3273                   assign
     3274                       p-chip-num = varchip-code2
     3275                   .
     3276               end.
     3277           end.
     3278           assign
     3279               p-chip-num = varchip-code2
     3280           .
     3281       end.
     3282   end.
     3283   END PROCEDURE.
     3284   PROCEDURE fbrlib-print-del-error-message :
     3285   do
     3286   on error undo, return error
     3287   :
     3288       define variable v-user-action   as character    no-undo.
     3289       define variable v-printed       as logical      no-undo.
     3290       message
     3291           vss-workfile vss-revision vss-description
     3292           skip "Ошибка при удалении документа."
     3293           skip return-value
     3294           skip trim(error-status :get-message(1))
     3295           skip trim(error-status :get-message(2))
     3296           skip trim(error-status :get-message(3))
     3297       view-as alert-box error.
     3298       if search ("delfbr.err") <> ?
     3299       then do:
     3300         run gbl/prnfilen.w
     3301           (input  "Ошибки при удалении документа производства"
     3302           ,input  0
     3303           ,input  "delfbr.err"
     3304           ,input  7
     3305           ,output v-user-action
     3306           ,output v-printed
     3307           ).
     3308       end.
     3309   end.
     3310   END PROCEDURE.
     3311   procedure fbrlib-calc-brutto :
     3312   define input parameter p-recipe-type        as character        no-undo.
     3313   define input parameter p-netto              as decimal          no-undo.
     3314   define input parameter p-coeff-value        as decimal          no-undo.
     3315   define input parameter p-coeff-waste        as decimal          no-undo.
     3316   define input parameter p-brutto             as decimal          no-undo.
     3317   define input parameter p-calc-method        as integer          no-undo.
     3318   define output parameter p-new-netto         as decimal          no-undo.
     3319   define output parameter p-new-coeff-waste   as decimal          no-undo.
     3320   define output parameter p-new-brutto        as decimal          no-undo.
     3321   define output parameter p-new-calc-method   as integer          no-undo.
     3322   do
     3323   on error undo, return error
     3324   :
     3325       if p-recipe-type <> 'производство':U
     3326       then do:
     3327           assign
     3328               p-new-coeff-waste = 0
     3329               p-new-calc-method = 1
     3330               p-new-netto       = ( if p-calc-method = 1 then p-brutto else p-netto )
     3331               p-new-brutto      = ( if p-calc-method = 1 then p-brutto else p-netto )
     3332           .
     3333       end.
     3334       else do:
     3335           assign
     3336               p-new-calc-method = p-calc-method
     3337           .
     3338           if p-coeff-waste = 0
     3339           then do:
     3340               assign
     3341                   p-coeff-value = 0
     3342               .
     3343           end.
     3344           case p-calc-method
     3345           :
     3346               when 1
     3347               then do:
     3348                   assign
     3349                       p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     3350                       p-new-coeff-waste   = p-coeff-waste
     3351                       p-new-brutto        = p-brutto
     3352                   .
     3353               end.
     3354               when 2
     3355               then do:
     3356                   assign
     3357                       p-new-netto         = p-netto
     3358                       p-new-coeff-waste   = 100 - p-coeff-value - ( 100 * p-netto / p-brutto )
     3359                       p-new-brutto        = p-brutto
     3360                   .
     3361               end.
     3362               when 3
     3363               then do:
     3364                   assign
     3365                       p-new-netto         = p-netto
     3366                       p-new-coeff-waste   = p-coeff-waste
     3367                       p-new-brutto        = 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste )
     3368                   .
     3369               end.
     3370               otherwise do:
     3371                   define variable v-yesno    as logical      no-undo.
     3372                   assign
     3373                       v-yesno = yes
     3374                   .
     3375                   message
     3376                       "Неверный метод для расчета брутто, нетто и процента потерь."
     3377                       skip "Значение метода должно быть 1, 2 или 3."
     3378                       skip(1)
     3379                       skip "Заданное значение:" p-calc-method
     3380                       skip(1)
     3381                       skip "Установить значение метода расчета 1"
     3382                       skip "(расчет нетто по брутто и проценту потерь)?"
     3383                   view-as alert-box warning
     3384                   buttons yes-no
     3385                   title "Неверное значение метода пересчета в строках документа-производства"
     3386                   update v-yesno
     3387                   .
     3388                   if v-yesno = yes
     3389                   then do:
     3390                       assign
     3391                           p-new-calc-method   = 1
     3392                           p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     3393                           p-new-coeff-waste   = p-coeff-waste
     3394                           p-new-brutto        = p-brutto
     3395                       .
     3396                   end.
     3397                   else do:
     3398                       message
     3399                               vss-workfile vss-revision vss-description
     3400                           skip(1)
     3401                           skip "Ошибка расчета брутто, нетто и процента потерь."
     3402                           skip return-value
     3403                           skip trim(error-status :get-message(1))
     3404                               trim(error-status :get-message(2))
     3405                               trim(error-status :get-message(3))
     3406                       view-as alert-box error
     3407                       title "Неверное значение метода расчета"
     3408                       .
     3409                       undo, return error .
     3410                   end.
     3411               end.
     3412           end case.
     3413       end.
     3414   end.
     3415   end procedure.
     3416   procedure fbrlib-check-brutto :
     3417   define input parameter p-recipe-type        as character        no-undo.
     3418   define input parameter p-netto              as decimal          no-undo.
     3419   define input parameter p-coeff-value        as decimal          no-undo.
     3420   define input parameter p-coeff-waste        as decimal          no-undo.
     3421   define input parameter p-brutto             as decimal          no-undo.
     3422   define input parameter p-calc-method        as integer          no-undo.
     3423   define output parameter p-error-message     as character        no-undo.
     3424   define output parameter p-not-good          as logical          no-undo.
     3425   do
     3426   on error undo, return error
     3427   :
     3428       if p-recipe-type <> 'производство':U
     3429       then do:
     3430           if p-netto <> p-brutto
     3431           or p-coeff-waste <> 0
     3432           then do:
     3433               assign
     3434                   p-not-good      = yes
     3435                   p-error-message = substitute( "Во всех рецептах кроме рецепта производства должно выполняться:&1брутто = нетто и процент потерь = 0.&1&1Тип рецепта: &2&1Брутто: &3&1Нетто: &4&1Процент потерь: &5"
     3436                                           , chr(10), p-recipe-type, p-brutto, p-netto, p-coeff-waste )
     3437               .
     3438           end.
     3439       end.
     3440       else do:
     3441           if p-coeff-waste = 0
     3442           then do:
     3443               assign
     3444                   p-coeff-value = 0
     3445               .
     3446           end.
     3447           case p-calc-method
     3448           :
     3449               when 1
     3450               then do:
     3451                   if round( p-netto, 9 ) <> round( p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100, 9 )
     3452                   then do:
     3453                       assign
     3454                           p-not-good      = yes
     3455                           p-error-message = substitute( "Ошибка расчета нетто ( &2 ) &1 по брутто ( &3 ) &1 и процентам потерь ( &4, &5 )."
     3456                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     3457                       .
     3458                   end.
     3459               end.
     3460               when 2
     3461               then do:
     3462                   if round( p-coeff-waste, 9 ) <> round( 100 - p-coeff-value - ( 100 * p-netto / p-brutto ), 9 )
     3463                   then do:
     3464                       assign
     3465                           p-not-good      = yes
     3466                           p-error-message =  substitute( "Ошибка расчета процента потерь ( &2 ) &1 по нетто ( &3 ) &1 брутто ( &4 ) &1 и cезонному проценту ( &5 )."
     3467                                                   , chr(10), p-coeff-waste, p-netto, p-brutto, p-coeff-value )
     3468                       .
     3469                   end.
     3470               end.
     3471               when 3
     3472               then do:
     3473                   if round( p-brutto, 9 ) <> round( 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste ), 9 )
     3474                   then do:
     3475                       assign
     3476                           p-not-good      = yes
     3477                           p-error-message = substitute( "Ошибка расчета брутто ( &3 ) &1 по нетто ( &2 ) &1 и процентам потерь ( &4, &5 )."
     3478                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     3479                       .
     3480                   end.
     3481               end.
     3482               otherwise do:
     3483                   assign
     3484                       p-not-good      = yes
     3485                       p-error-message = substitute( "Ошибка ввода метода расчета ( &1 ).", p-calc-method )
     3486                   .
     3487               end.
     3488           end case.
     3489       end.
     3490   end.
     3491   end procedure.
     3492   procedure fbrlib-check-fbr-recipe :
     3493   define input parameter p-doc-code       as character        no-undo.
     3494   define input parameter p-recipe-code    as character        no-undo.
     3495   define output parameter p-is-correct    as logical          no-undo.
     3496       define variable v-comp-factor    as decimal      no-undo.
     3497       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     3498       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3499       define buffer buf_fbr-line          for ub.fbr-line.
     3500   do
     3501   for buf_fbr-recipe
     3502     , buf_fbr-recipe-gds
     3503     , buf_fbr-line
     3504   on error undo, return error
     3505   :
     3506       assign
     3507           p-is-correct = yes
     3508       .
     3509       find first buf_fbr-recipe no-lock
     3510            where buf_fbr-recipe.doc-code    = p-doc-code
     3511              and buf_fbr-recipe.recipe-code = p-recipe-code no-error
     3512       .
     3513       if not available buf_fbr-recipe then do:
     3514         undo, return error substitute("Не найден рецепт (fbr-recipe) с кодом &1 для  документа пр-ва &2", p-recipe-code, p-doc-code).
     3515       end.
     3516       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     3517       then do:
     3518       end.
     3519       else do:
     3520           find first buf_fbr-line no-lock
     3521                where buf_fbr-line.doc-code    = buf_fbr-recipe.doc-code
     3522                  and buf_fbr-line.is-comp     = yes
     3523                  and buf_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     3524                  and buf_fbr-line.artic       = buf_fbr-recipe.artic
     3525                  and buf_fbr-line.prod-type   = buf_fbr-recipe.prod-type
     3526                  and buf_fbr-line.prod-code   = buf_fbr-recipe.prod-code
     3527           .
     3528           assign
     3529               v-comp-factor = buf_fbr-line.fact-qnty / buf_fbr-recipe.qnty
     3530           .
     3531           recipe-line-cycle:
     3532           for each buf_fbr-recipe-gds no-lock
     3533              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     3534                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     3535           on error undo, return error
     3536           :
     3537               find first buf_fbr-line no-lock
     3538                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     3539                      and buf_fbr-line.is-comp     = no
     3540                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     3541                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3542                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3543                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3544               .
     3545               if absolute( buf_fbr-line.fact-qnty / buf_fbr-recipe-gds.brutto-qnty - v-comp-factor ) > 0.000000001
     3546               then do:
     3547                   assign
     3548                       p-is-correct = no
     3549                   .
     3550                   leave recipe-line-cycle.
     3551               end.
     3552           end.
     3553       end.
     3554   end.
     3555   end procedure.
     3556   procedure fbrlib-get-recipe-type :
     3557   define input parameter p-fbr-doc-code   as character        no-undo.
     3558   define input parameter p-recipe-code    as character        no-undo.
     3559   define output parameter p-recipe-type   as character        no-undo.
     3560       define buffer buf_recipe        for ub.recipe.
     3561       define buffer buf_fbr-recipe    for ub.fbr-recipe.
     3562   do
     3563   for buf_recipe
     3564     , buf_fbr-recipe
     3565   on error undo, return error
     3566   :
     3567       if p-fbr-doc-code = ""
     3568       then do:
     3569           find first buf_recipe no-lock
     3570                where buf_recipe.recipe-code = p-recipe-code
     3571           no-error.
     3572           if available buf_recipe
     3573           then do:
     3574               assign
     3575                   p-recipe-type = buf_recipe.recipe-type
     3576               .
     3577           end.
     3578           else do:
     3579               assign
     3580                   p-recipe-type = "":U
     3581               .
     3582           end.
     3583       end.
     3584       else do:
     3585           find first buf_fbr-recipe no-lock
     3586                where buf_fbr-recipe.doc-code      = p-fbr-doc-code
     3587                  and buf_fbr-recipe.recipe-code   = p-recipe-code
     3588           no-error.
     3589           if available buf_fbr-recipe
     3590           then do:
     3591               assign
     3592                   p-recipe-type = buf_fbr-recipe.recipe-type
     3593               .
     3594           end.
     3595           else do:
     3596               assign
     3597                   p-recipe-type = "":U
     3598               .
     3599           end.
     3600       end.
     3601   end.
     3602   end procedure.
     3603   PROCEDURE calc-comp-from-ingr :
     3604   define input parameter p-fbr-v-fbr-doc-line-recid           as recid        no-undo.
     3605   define input parameter p-fact-qnty                          as decimal      no-undo.
     3606   define output parameter p-comp-fbr-v-fbr-doc-line-recid     as recid        no-undo.
     3607   define output parameter p-comp-qnty                         as decimal      no-undo.
     3608       define variable v-ingr-qnty     as decimal       no-undo.
     3609       define buffer buf_i_fbr-line    for ub.fbr-line.
     3610       define buffer buf_fbr-line      for ub.fbr-line.
     3611       define buffer buf_recipe        for ub.fbr-recipe.
     3612       define buffer buf_recipe-gds    for ub.fbr-recipe-gds.
     3613   do
     3614   for buf_i_fbr-line
     3615     , buf_fbr-line
     3616     , buf_recipe
     3617     , buf_recipe-gds
     3618   on error undo, return error
     3619   :
     3620       find first buf_i_fbr-line no-lock
     3621            where recid( buf_i_fbr-line ) = p-fbr-v-fbr-doc-line-recid
     3622       .
     3623       find first buf_recipe no-lock
     3624            where buf_recipe.doc-code      = buf_i_fbr-line.doc-code
     3625              and buf_recipe.recipe-code   = buf_i_fbr-line.recipe-code
     3626       no-error.
     3627       if not available buf_recipe
     3628       then do:
     3629           message
     3630                   vss-workfile vss-revision vss-description
     3631               skip "В строке производства не указан рецепт."
     3632               skip "Невозможно рассчитать количество составного товара."
     3633               skip return-value
     3634               skip trim(error-status :get-message(1))
     3635                   trim(error-status :get-message(2))
     3636                   trim(error-status :get-message(3))
     3637           view-as alert-box error.
     3638           undo, return error .
     3639       end.
     3640       if buf_recipe.recipe-type = 'альтернатива':U
     3641       then do:
     3642           for each buf_fbr-line no-lock
     3643              where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     3644                and buf_fbr-line.trn-type    = buf_i_fbr-line.trn-type
     3645                and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     3646           on error undo, return error
     3647           :
     3648               find first buf_recipe-gds no-lock
     3649                    where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     3650                      and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     3651                      and buf_recipe-gds.artic       = buf_fbr-line.artic
     3652                      and buf_recipe-gds.prod-type   = buf_fbr-line.prod-type
     3653                      and buf_recipe-gds.prod-code   = buf_fbr-line.prod-code
     3654               .
     3655               assign
     3656                   p-comp-qnty         = p-comp-qnty       + ( buf_fbr-line.fact-qnty * buf_recipe-gds.brutto-qnty )
     3657               .
     3658           end.
     3659           assign
     3660               p-comp-qnty         = p-comp-qnty       / buf_recipe.qnty
     3661           .
     3662       end.
     3663       else do:
     3664           find first buf_recipe-gds no-lock
     3665                where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     3666                  and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     3667                  and buf_recipe-gds.artic       = buf_i_fbr-line.artic
     3668                  and buf_recipe-gds.prod-type   = buf_i_fbr-line.prod-type
     3669                  and buf_recipe-gds.prod-code   = buf_i_fbr-line.prod-code
     3670           .
     3671           assign
     3672               p-comp-qnty = p-fact-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
     3673           .
     3674       end.
     3675       find first buf_fbr-line no-lock
     3676            where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     3677              and buf_fbr-line.is-comp     = yes
     3678              and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     3679       .
     3680       assign
     3681           p-comp-fbr-v-fbr-doc-line-recid = recid( buf_fbr-line )
     3682       .
     3683   end.
     3684   END PROCEDURE.
     3685   PROCEDURE get-temp_dressing-ingr-used-qnty :
     3686   define input parameter p-recipe-code    as character    no-undo.
     3687   define input parameter p-gds-code       as integer      no-undo.
     3688   define output parameter p-line-qnty     as decimal      no-undo.
     3689   define output parameter p-used-qnty     as decimal      no-undo.
     3690   define output parameter p-recipe-qnty   as decimal      no-undo.
     3691       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     3692   do
     3693   for buf_temp_dressing-ingr
     3694   on error undo, return error
     3695   :
     3696       find first buf_temp_dressing-ingr no-lock
     3697            where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     3698              and buf_temp_dressing-ingr.gds-code    = p-gds-code
     3699       no-error.
     3700       if available buf_temp_dressing-ingr
     3701       then do:
     3702           assign
     3703               p-line-qnty     = buf_temp_dressing-ingr.line-qnty
     3704               p-used-qnty     = buf_temp_dressing-ingr.used-qnty
     3705               p-recipe-qnty   = buf_temp_dressing-ingr.recipe-qnty
     3706           .
     3707       end.
     3708       else do:
     3709           assign
     3710               p-line-qnty     = 0
     3711               p-used-qnty     = 0
     3712               p-recipe-qnty   = 0
     3713           .
     3714       end.
     3715   end.
     3716   END PROCEDURE.
     3717   PROCEDURE fbrlib_adjust-recipe :
     3718   do
     3719   on error undo, return error
     3720   :
     3721   define input parameter parparentproc as widget-handle no-undo .
     3722   define input parameter p-fbrhist-handle as handle no-undo .
     3723   define input parameter p-doc-code       as character    no-undo.
     3724   define input parameter p-recipe-code    as character    no-undo.
     3725   define input parameter p-price-sale-obj-type as character no-undo .
     3726   define input parameter p-price-sale-obj-code as integer no-undo .
     3727       define variable v-recipe-qnty       as decimal      no-undo.
     3728       define variable v-comp-qnty         as decimal      no-undo.
     3729       define variable v-recipe-gds-qnty   as decimal      no-undo.
     3730       define variable v-ingr-qnty         as decimal      no-undo.
     3731       define variable v-qnty              as decimal      no-undo.
     3732       define variable v-coeff-waste       as decimal      no-undo.
     3733       define variable v-brutto-qnty       as decimal      no-undo.
     3734       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     3735       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3736       define buffer buf_fbr-line          for ub.fbr-line.
     3737       define buffer buf_el_fbr-recipe-gds for ub.fbr-recipe-gds.
     3738       find first buf_fbr-recipe no-lock
     3739            where buf_fbr-recipe.doc-code      = p-doc-code
     3740              and buf_fbr-recipe.recipe-code   = p-recipe-code
     3741       .
     3742       assign
     3743           v-recipe-qnty = buf_fbr-recipe.qnty
     3744       .
     3745       find first buf_fbr-line no-lock
     3746            where buf_fbr-line.doc-code    = p-doc-code
     3747              and buf_fbr-line.is-comp     = yes
     3748              and buf_fbr-line.recipe-code = p-recipe-code
     3749       .
     3750       assign
     3751           v-comp-qnty = buf_fbr-line.fact-qnty
     3752       .
     3753       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     3754       then do:
     3755       end.
     3756       else do:
     3757           for each buf_fbr-recipe-gds no-lock
     3758              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     3759                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     3760           on error undo, return error
     3761           :
     3762               find first buf_fbr-line no-lock
     3763                    where buf_fbr-line.doc-code    = p-doc-code
     3764                      and buf_fbr-line.is-comp     = no
     3765                      and buf_fbr-line.recipe-code = p-recipe-code
     3766                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3767                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3768                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3769               .
     3770               if buf_fbr-line.fact-qnty / v-comp-qnty <> buf_fbr-recipe-gds.brutto-qnty / v-recipe-qnty
     3771               then do:
     3772                   do transaction
     3773                   on error undo, return error
     3774                   :
     3775                       find first buf_el_fbr-recipe-gds exclusive-lock
     3776                            where recid( buf_el_fbr-recipe-gds ) = recid( buf_fbr-recipe-gds )
     3777                       .
     3778                       assign
     3779                           buf_el_fbr-recipe-gds.calc-method   = 1
     3780                           buf_el_fbr-recipe-gds.brutto-qnty   = buf_fbr-line.fact-qnty * v-recipe-qnty / v-comp-qnty
     3781                       .
     3782                       run fbrlib-calc-brutto in this-procedure (
     3783                             input buf_fbr-recipe.recipe-type
     3784                           , input 0
     3785                           , input buf_el_fbr-recipe-gds.coeff-value
     3786                           , input buf_el_fbr-recipe-gds.coeff-waste
     3787                           , input buf_el_fbr-recipe-gds.brutto-qnty
     3788                           , input 1
     3789                           , output buf_el_fbr-recipe-gds.qnty
     3790                           , output buf_el_fbr-recipe-gds.coeff-waste
     3791                           , output buf_el_fbr-recipe-gds.brutto-qnty
     3792                           , output buf_el_fbr-recipe-gds.calc-method
     3793                       ).
     3794                   end.
     3795               end.
     3796           end.
     3797           run fbrlib_adjust-doc-lines in this-procedure (
     3798                 input parparentproc
     3799               , input p-fbrhist-handle
     3800               , input p-doc-code
     3801               , input p-recipe-code
     3802               , input p-price-sale-obj-type
     3803               , input p-price-sale-obj-code
     3804           ).
     3805       end.
     3806   end.
     3807   END PROCEDURE.
     3808   PROCEDURE fbrlib_adjust-doc-lines :
     3809   define input parameter parparentproc as widget-handle no-undo .
     3810   define input parameter p-fbrhist-handle as handle no-undo .
     3811   define input parameter p-doc-code       as character    no-undo.
     3812   define input parameter p-recipe-code    as character    no-undo.
     3813   define input parameter p-price-sale-obj-type as character no-undo .
     3814   define input parameter p-price-sale-obj-code as integer no-undo .
     3815   define variable v-comp-qnty         as decimal      no-undo.
     3816   define variable v-trn-type          as character    no-undo.
     3817   define variable v-ingr-qnty         as decimal      no-undo.
     3818   define variable v-recipe-qnty       as decimal      no-undo.
     3819   define variable v-fbr-v-fbr-doc-line-recid    as recid        no-undo.
     3820   define buffer buf_fbr-recipe        for ub.fbr-recipe.
     3821   define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3822   define buffer buf_fbr-line          for ub.fbr-line.
     3823   define buffer buf_coeff_fbr-line    for ub.fbr-line.
     3824   define buffer buf_goods             for ub.goods.
     3825   define buffer buf_fbr-doc           for ub.fbr-doc.
     3826   do
     3827   for buf_fbr-recipe
     3828     , buf_fbr-recipe-gds
     3829     , buf_fbr-line
     3830     , buf_coeff_fbr-line
     3831     , buf_goods
     3832     , buf_fbr-doc
     3833   on error undo, return error
     3834   :
     3835       find first buf_fbr-line no-lock
     3836            where buf_fbr-line.doc-code      = p-doc-code
     3837              and buf_fbr-line.is-comp       = yes
     3838              and buf_fbr-line.recipe-code   = p-recipe-code
     3839       .
     3840       find first buf_fbr-doc no-lock
     3841            where buf_fbr-doc.doc-code      = p-doc-code
     3842       .
     3843       assign
     3844           v-comp-qnty = buf_fbr-line.fact-qnty
     3845           v-trn-type  = buf_fbr-line.trn-type
     3846       .
     3847       find first buf_fbr-recipe no-lock
     3848            where buf_fbr-recipe.doc-code    = p-doc-code
     3849              and buf_fbr-recipe.recipe-code = p-recipe-code
     3850       .
     3851       assign
     3852       v-recipe-qnty = buf_fbr-recipe.qnty
     3853       .
     3854       do transaction
     3855       on error undo, return error
     3856       :
     3857           for each buf_fbr-recipe-gds no-lock
     3858              where buf_fbr-recipe-gds.doc-code      = p-doc-code
     3859                and buf_fbr-recipe-gds.recipe-code   = p-recipe-code
     3860           on error undo, return error
     3861           :
     3862               find first buf_fbr-line no-lock
     3863                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     3864                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     3865                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3866                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3867                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3868               no-error.
     3869               if not available buf_fbr-line
     3870               then do:
     3871                   find first buf_goods no-lock
     3872                        where buf_goods.artic      = buf_fbr-recipe-gds.artic
     3873                          and buf_goods.prod-type  = buf_fbr-recipe-gds.prod-type
     3874                          and buf_goods.prod-code  = buf_fbr-recipe-gds.prod-code
     3875                   .
     3876                   run str/fbr-crln.p (
     3877                         input parparentproc
     3878                       , input recid( buf_fbr-doc )
     3879                       , input recid( buf_goods )
     3880                       , input buf_fbr-recipe-gds.recipe-code
     3881                       , input v-trn-type
     3882                       , input no
     3883                       , input no
     3884                       , input buf_fbr-doc.obj-type
     3885                       , input buf_fbr-doc.obj-code
     3886                       , output v-fbr-v-fbr-doc-line-recid
     3887                   ).
     3888                   find first buf_fbr-line no-lock
     3889                        where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     3890                          and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     3891                          and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3892                          and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3893                          and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3894                   no-error.
     3895                   if not available buf_fbr-line
     3896                   then do:
     3897                       undo, return error substitute("Не удалось создать строку документа производства &1 &2&3&4"
     3898                                                      , p-doc-code
     3899                                                      , buf_fbr-recipe-gds.artic
     3900                                                      , buf_fbr-recipe-gds.prod-type
     3901                                                      , buf_fbr-recipe-gds.prod-code).
     3902                   end.
     3903               end.
     3904               find first buf_coeff_fbr-line exclusive-lock
     3905                    where recid( buf_coeff_fbr-line ) = recid( buf_fbr-line )
     3906               .
     3907               if buf_coeff_fbr-line.calc-method <> buf_fbr-recipe-gds.calc-method
     3908               or buf_coeff_fbr-line.coeff-value <> buf_fbr-recipe-gds.coeff-value
     3909               or buf_coeff_fbr-line.coeff-waste <> buf_fbr-recipe-gds.coeff-waste
     3910               then do:
     3911                   assign
     3912                       buf_coeff_fbr-line.calc-method = buf_fbr-recipe-gds.calc-method
     3913                       buf_coeff_fbr-line.coeff-value = buf_fbr-recipe-gds.coeff-value
     3914                       buf_coeff_fbr-line.coeff-waste = buf_fbr-recipe-gds.coeff-waste
     3915                   .
     3916               end.
     3917           end.
     3918       end.
     3919       define variable v-need-goods    as logical       no-undo.
     3920       define variable v-need-goods-list       as character     no-undo.
     3921       define variable v-need-goods-qnty-list  as character     no-undo.
     3922       find first buf_fbr-line no-lock
     3923            where buf_fbr-line.doc-code    = buf_fbr-doc.doc-code
     3924              and buf_fbr-line.is-comp     = yes
     3925              and buf_fbr-line.recipe-code = p-recipe-code
     3926       .
     3927       run str/fbr-qnty.p (
     3928             input parparentproc
     3929           , input p-fbrhist-handle
     3930           , input recid( buf_fbr-doc )
     3931           , input recid( buf_fbr-line )
     3932           , input no
     3933           , input "ingr"
     3934           , input no
     3935           , input p-price-sale-obj-type
     3936           , input p-price-sale-obj-code
     3937           , input no
     3938           , input no
     3939           , input no
     3940           , output v-need-goods
     3941           , output v-need-goods-list
     3942           , output v-need-goods-qnty-list
     3943       ).
     3944   end.
     3945   END PROCEDURE.
     3946   procedure fbrlib_check-before-close :
     3947   define input parameter p-doc-code as character no-undo .
     3948   define variable same-sale as decimal no-undo .
     3949   define variable is-waste as logical no-undo .
     3950   define variable fix-price as logical no-undo .
     3951   define buffer buf_fbr-doc for ub.fbr-doc.
     3952   define buffer buf_fbr-line for ub.fbr-line.
     3953   define buffer buf_goods for ub.goods.
     3954   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     3955   do
     3956   on error undo, return error
     3957   :
     3958     for each buf_fbr-line no-lock
     3959         where buf_fbr-line.doc-code = p-doc-code
     3960       , each buf_goods no-lock
     3961         where buf_goods.artic     = buf_fbr-line.artic
     3962           and buf_goods.prod-type = buf_fbr-line.prod-type
     3963           and buf_goods.prod-code = buf_fbr-line.prod-code
     3964     break by buf_fbr-line.prod-type
     3965           by buf_fbr-line.prod-code
     3966           by buf_fbr-line.artic
     3967     :
     3968       if first-of (buf_fbr-line.artic)
     3969       then do:
     3970         assign
     3971         same-sale = buf_fbr-line.price-sale
     3972         is-waste = (buf_fbr-line.rsrv-qnty = ?)
     3973         fix-price = buf_fbr-line.is-calc
     3974         .
     3975       end.
     3976       if same-sale <> buf_fbr-line.price-sale
     3977       then do:
     3978           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром должна быть указана одна и та же цена продажи."
     3979                                         ,p-doc-code
     3980                                         ,buf_goods.artic
     3981                                         ,buf_goods.gds-name
     3982                                         ,chr(10)).
     3983       end.
     3984       if fix-price <> buf_fbr-line.is-calc then do:
     3985           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром цена должна быть фиксирована или нет."
     3986                                         ,p-doc-code
     3987                                         ,buf_goods.artic
     3988                                         ,buf_goods.gds-name
     3989                                         ,chr(10)).
     3990       end.
     3991       if is-waste <> (buf_fbr-line.rsrv-qnty = ?)
     3992       then do:
     3993         undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа этот товар должен быть отходом либо не отходом."
     3994                                         ,p-doc-code
     3995                                         ,buf_goods.artic
     3996                                         ,buf_goods.gds-name
     3997                                         ,chr(10)).
     3998       end.
     3999       if buf_fbr-line.rsrv-qnty <> ?
     4000       and buf_goods.gds-type <> 'у':U
     4001       and ( buf_fbr-line.price-sale <= 0 or buf_fbr-line.price-sale = ?  )
     4002       and buf_fbr-line.fact-qnty <> 0
     4003       then do:
     4004         if buf_fbr-line.trn-type     = 'при':U  then for first buf_fbr-doc where buf_fbr-doc.doc-code =  p-doc-code no-lock:
     4005           if  can-find(first buf_fbr-gds-obj no-lock where
     4006                   buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     4007               AND buf_fbr-gds-obj.obj-type = buf_fbr-doc.obj-type
     4008               AND buf_fbr-gds-obj.obj-code = buf_fbr-doc.obj-code
     4009               and buf_fbr-gds-obj.is-null-price  )  then .
     4010                     else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4011                                         ,p-doc-code
     4012                                         ,buf_goods.artic
     4013                                         ,buf_goods.gds-name
     4014                                         ,chr(10)
     4015                                         ,buf_fbr-line.recipe-code
     4016                                         ).
     4017         end.
     4018         else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4019                                         ,p-doc-code
     4020                                         ,buf_goods.artic
     4021                                         ,buf_goods.gds-name
     4022                                         ,chr(10)
     4023                                         ,buf_fbr-line.recipe-code
     4024                                         ).
     4025       end.
     4026     end.
     4027   end.
     4028   end procedure.
     4029   do
     4030   on error undo, return error
     4031   :
     4032       define variable v-price-sale    as decimal       no-undo.
     4033       define variable v-yesno         as logical       no-undo.
     4034       define buffer buf_fbr-doc       for fbr-doc.
     4035       define buffer buf_fbr-line      for fbr-line.
     4036       define buffer buf_goods         for goods.
     4037       define buffer buf_fbr-recipe-gds    for fbr-recipe-gds.
     4038       find first buf_fbr-doc no-lock
     4039            where recid( buf_fbr-doc ) = p-fbr-doc-recid
     4040       .
     4041       find first buf_goods no-lock
     4042           where recid( buf_goods ) = p-goods-recid
     4043       .
     4044       find first buf_fbr-line
     4045            where buf_fbr-line.prod-code   = buf_goods.prod-code
     4046              and buf_fbr-line.prod-type   = buf_goods.prod-type
     4047              and buf_fbr-line.artic       = buf_goods.artic
     4048              and buf_fbr-line.doc-code    = buf_fbr-doc.doc-code
     4049              and buf_fbr-line.is-comp     = p-is-comp
     4050              and buf_fbr-line.recipe-code = p-recipe-code
     4051       no-error.
     4052       do on error undo, return error
     4053       :
     4054           if available buf_fbr-line
     4055           then do:
     4056               if not p-is-recursive
     4057               then do:
     4058                   assign
     4059                       v-yesno = no
     4060                   .
     4061                   message "Товар: " buf_goods.artic buf_goods.gds-name skip
     4062                           "Рецепт:" p-recipe-code skip
     4063                           "- УЖЕ ЕСТЬ в этом документе. Добавить в эти строки?"
     4064                           view-as alert-box question buttons YES-NO update v-yesno.
     4065                   if not v-yesno
     4066                   then do:
     4067                       return error.
     4068                   end.
     4069               end.
     4070           end.
     4071           else do:
     4072               find first buf_fbr-recipe-gds no-lock
     4073                    where buf_fbr-recipe-gds.doc-code    = buf_fbr-doc.doc-code
     4074                      and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     4075                      and buf_fbr-recipe-gds.prod-type   = buf_goods.prod-type
     4076                      and buf_fbr-recipe-gds.prod-code   = buf_goods.prod-code
     4077                      and buf_fbr-recipe-gds.artic       = buf_goods.artic
     4078               no-error.
     4079               create buf_fbr-line.
     4080               assign
     4081                   buf_fbr-line.recipe-code        = p-recipe-code
     4082                   buf_fbr-line.trn-type           = p-trn-type
     4083                   buf_fbr-line.doc-code           = buf_fbr-doc.doc-code
     4084                   buf_fbr-line.artic              = buf_goods.artic
     4085                   buf_fbr-line.prod-code          = buf_goods.prod-code
     4086                   buf_fbr-line.prod-type          = buf_goods.prod-type
     4087                   buf_fbr-line.is-calc            = no
     4088                   buf_fbr-line.is-comp            = p-is-comp
     4089                   buf_fbr-line.is-waste           = ( if available buf_fbr-recipe-gds and buf_fbr-recipe-gds.is-waste = yes then yes else no )
     4090                   buf_fbr-line.calc-method        = ( if available buf_fbr-recipe-gds then buf_fbr-recipe-gds.calc-method  else 1 )
     4091                   buf_fbr-line.coeff-value        = ( if available buf_fbr-recipe-gds then buf_fbr-recipe-gds.coeff-value  else 0 )
     4092                   buf_fbr-line.coeff-waste        = ( if available buf_fbr-recipe-gds then buf_fbr-recipe-gds.coeff-waste  else 0 )
     4093                   buf_fbr-line.price-base         = ?
     4094                   buf_fbr-line.price-rubl         = ?
     4095                   buf_fbr-line.price-sum-base     = ?
     4096                   buf_fbr-line.price-sum-rubl     = ?
     4097                   buf_fbr-line.price-sum-vat-base = ?
     4098                   buf_fbr-line.price-sum-vat-rubl = ?
     4099               .
     4100               run fbrlib-calc-prices in this-procedure (
     4101                     input recid( buf_fbr-line )
     4102                   , input p-price-obj-type
     4103                   , input p-price-obj-code
     4104                   , output v-price-sale
     4105               ) no-error.
     4106               if error-status:error then do:
     4107                 undo, return error substitute("Ошибка при расчете цен по док-ту пр-ва &4&1&2&1&3"
     4108                                     , chr(10)
     4109                                     , error-status:get-message(1)
     4110                                     , return-value
     4111                                     , buf_fbr-line.doc-code
     4112                                     ).
     4113               end.
     4114               if v-price-sale <> ?
     4115               then do:
     4116                   assign
     4117                       buf_fbr-line.price-sale = v-price-sale
     4118                   .
     4119                   if p-price-obj-type <> buf_fbr-doc.obj-type
     4120                   or p-price-obj-code <> buf_fbr-doc.obj-code
     4121                   then do:
     4122                       assign
     4123                           buf_fbr-line.is-calc = yes
     4124                       .
     4125                   end.
     4126               end.
     4127               else if buf_fbr-line.trn-type     = 'при':U then  buf_fbr-line.price-sale = 0.
     4128           end.
     4129       end.
     4130       assign
     4131           p-fbr-line-recid = recid (buf_fbr-line)
     4132       .
     4133   end.
