     6819           _maria-cash-desk:
     6820           FOR EACH for-cash-desk NO-LOCK WHERE
     6821                   for-cash-desk.db-num = g#db-num and
     6822                   for-cash-desk.pos-type = cash-desk.pos-type AND
     6823                   for-cash-desk.obj-code = p-obj-code AND
     6824                   for-cash-desk.cash-on = yes :
     6825             if for-cash-desk.autonomy = integer('2':U) then next _maria-cash-desk.
     6826             file = substring( string( next-value( s-spool, ub ), '99999999999999999999'), 13, 8 ).
     6827             if v-spec-command <> '':U then do:
     6828               do ii = 1 to num-entries(v-spec-command, ';'):
     6829                 v-entry = entry(ii, v-spec-command, ';') .
     6830                 if v-entry begins 'Report' then do:
     6831                   do jj = 1 to num-entries(left-trim(v-entry, 'report')):
     6832                     run maria-get in this-procedure (
     6833                                                     buffer for-cash-desk
     6834                                                   , input in_ + spl + chr(47)
     6835                                                   , input 'fl' + file
     6836                                                   , input no
     6837                                                   , input integer(entry(jj, left-trim(v-entry, 'report')))
     6838                                                   , input 0
     6839                                                   , input 0
     6840                                                   , input ?
     6841                                                   , input ?
     6842                                                   , input ?
     6843                                                   , input jj
     6844                                                         ).
     6845                   end.
     6846                 end.
     6847               end.
     6848             end.
     6849             else do:
     6850                define variable v-character as character no-undo.
     6851                define variable v-attr-date as date      no-undo.
     6852                define variable v-decimal   as decimal   no-undo.
     6853                define variable v-integer   as integer   no-undo.
     6854                define variable v-logical   as logical   no-undo.
     6855                v-character = ''.
     6856                run cd-attr-value in this-procedure (
     6857                                                    input for-cash-desk.db-num
     6858                                                   ,input for-cash-desk.obj-code
     6859                                                   ,input 'MARIA':U
     6860                                                   ,input for-cash-desk.cash-num
     6861                                                   ,input 'MARIA_operative':U
     6862                                                   ,input 'last-check-maria':U
     6863                                                   ,output v-character
     6864                                                   ,output v-attr-date
     6865                                                   ,output v-decimal
     6866                                                   ,output v-integer
     6867                                                   ,output v-logical
     6868                                                   ,output v-attr-type     ) no-error.
     6869               do shift-maria = (if entry(1, for-cash-desk.addr-path, chr(4)) = 'ftp' then 2 else 1) to 2:
     6870                 if shift-maria = 1 then do:
     6871                    assign
     6872                    v-p-spl = '30,31,32,33':U
     6873                    v-spl-doc = '17':U
     6874                    v-spl = '43':U
     6875                    .
     6876                 end.
     6877                 if shift-maria = 2 then do:
     6878                    assign
     6879                    v-p-spl = '26,27,28,29':U
     6880                    v-spl-doc = '16':U
     6881                    v-spl = '42':U
     6882                    .
     6883                 end.
     6884                 if loc-is-ptrl then do:
     6885                   do ii = 1 to num-entries(v-p-spl):
     6886                     imaria = imaria + 1.
     6887                     run maria-get in this-procedure (
     6888                                                     buffer for-cash-desk
     6889                                                   , input in_ + spl + chr(47)
     6890                                                   , input 'fl' + file
     6891                                                   , input yes
     6892                                                   , input integer(entry(ii, v-p-spl))
     6893                                                   , input 17
     6894                                                   , input 0
     6895                                                   , input ?
     6896                                                   , input ?
     6897                                                   , input v-character
     6898                                                   , input imaria
     6899                                                         ).
     6900                   end.
     6901                 end.
     6902                 do jj = 1 to num-entries(v-spl):
     6903                   imaria = imaria + 1.
     6904                   run maria-get in this-procedure (
     6905                                                   buffer for-cash-desk
     6906                                                 , input in_ + spl + chr(47)
     6907                                                 , input 'fl' + file
     6908                                                 , input yes
     6909                                                 , input integer(entry(jj, v-spl-doc))
     6910                                                 , input 11
     6911                                                 , input 0
     6912                                                 , input ?
     6913                                                 , input ?
     6914                                                 , input v-character
     6915                                                 , input imaria
     6916                                                       ).
     6917                   imaria = imaria + 1.
     6918                   run maria-get in this-procedure (
     6919                                                   buffer for-cash-desk
     6920                                                 , input in_ + spl + chr(47)
     6921                                                 , input 'fl' + file
     6922                                                 , input yes
     6923                                                 , input integer(entry(jj, v-spl))
     6924                                                 , input 7
     6925                                                 , input 0
     6926                                                 , input ?
     6927                                                 , input ?
     6928                                                 , input v-character
     6929                                                 , input imaria
     6930                                                       ).
     6931                 end.
     6932               end.
     6933             end.
     6934           end.
     6935           output stream DIrstream to VALUE(in_ + spl + chr(47) + file + '.tsk').
     6936           v-is-script = no.
     6937           for each temp-tekka-tsk
     6938           by temp-tekka-tsk.order-num
     6939           :
     6940             if temp-tekka-tsk.task-num = 'fl' + file then do:
     6941               export stream DIrStream temp-tekka-tsk.
     6942               if temp-tekka-tsk.is-script = yes then do:
     6943                 v-is-script = yes.
     6944               end.
     6945             end.
     6946             delete temp-tekka-tsk.
     6947           end.
     6948           output stream Dirstream close.
     6949           run str/runtekka.p (
     6950                               input parparentproc
     6951                               ,input p-parent-handle
     6952                               ,input p-log-handle
     6953                               ,input out
     6954                               ,input (in_ + spl + chr(47))
     6955                               ,input file
     6956                               ,input v-remote
     6957                               ,input v-is-script
     6958                               ) no-error .
     6959           if error-status:error
     6960           or return-value = "error" then do:
     6961             run write-log-and-file in p-log-handle (
     6962                   input 1
     6963                 , input log-file-name
     6964                 , input 1
     6965                 , input substitute( "!!!Касса &1 маг&2 не ответила:&3&4 &5"
     6966                                       , cash-desk.pos-type
     6967                                       , cash-desk.obj-code
     6968                                       , chr(10)
     6969                                       , error-status:get-message(1)
     6970                                       , return-value
     6971                                   )
     6972                                                   ).
     6973             assign
     6974             v-view-log = yes
     6975             .
     6976             return "error":U.
     6977           end.
     6978           run str/get-ibmf.p (
     6979                          input parparentproc
     6980                         ,input p-log-handle
     6981                         ,input p-obj-type
     6982                         ,input p-obj-code
     6983                         ,input v-host-code
     6984                         ,input cash-desk.pos-type
     6985                         ,input in_
     6986                         ,input spl
     6987                         ,input (in_ + sav)
     6988                         ,input v-spec-command
     6989                         ,input-output v-view-log
     6990                         ) no-error  .
     6991           if return-value = "error":U then do:
     6992             v-view-log = yes.
     6993             undo, return .
     6994           end.
     6995         end.
     6996       END CASE .
     6997     END.
     6998   END.
     6999   run str/get-ffd.p(parparentproc,
     7000                           p-parent-handle,
     7001                           p-log-handle,
     7002                           log-file-name,
     7003                           p-obj-type,
     7004                           p-obj-code,
     7005                           output v-value-logical) no-error.
     7006   if error-status:error then do:
     7007      run write-log-and-file in p-log-handle (
     7008                   input 1
     7009                 , input log-file-name
     7010                 , input 1
     7011                 , input return-value).
     7012   end.
     7013   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7014   define new global shared variable g#trdcalib as handle no-undo.
     7015   procedure proc-exp-1s:
     7016   FIND FIRST ub.chk-doc-attr WHERE ub.chk-doc-attr.attr-code  = "CHFlag1S"
     7017                                and ub.chk-doc-attr.attr-value = "no"
     7018                                NO-ERROR.
     7019   IF AVAILABLE ub.chk-doc-attr THEN DO:
     7020         FIND FIRST chk-doc WHERE ub.chk-doc-attr.doc-code = chk-doc.doc-code NO-ERROR.
     7021         IF AVAILABLE chk-doc THEN DO:
     7022   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rum-runa in g#library
     7023     (input parparentproc
     7024     ,input this-procedure:handle
     7025     ,input p-log-handle
     7026     ,input 'event_shift':U
     7027     ,input  buffer chk-doc:handle
     7028     ,input  buffer chk-doc:handle
     7029     ,input ''
     7030     ,input ''
     7031     ) no-error .
     7032             if error-status:error then  do :
     7033               message " Ошибка выгрузки чеков в 1С " skip return-value skip error-status:get-message(1) view-as alert-box.
     7034             end.
     7035        END.
     7036   END.
     7037   end procedure.
     7038   run proc-exp-1s in this-procedure  no-error.
     7039   run write-log-and-file in p-log-handle (
     7040         input 1
     7041       , input log-file-name
     7042       , input 1
     7043       , input substitute( "Обработка спул-файлов завершена, всего с касс принято &1 чеков/записей"
     7044                           , lll
     7045                         )
     7046                                     ).
     7047   define variable v-process-sale as logical no-undo .
     7048   run adm/shattri.p (
     7049       input "get":U
     7050       ,input  p-obj-type
     7051       ,input  p-obj-code
     7052       ,input  'cd-sending':U
     7053       ,input  'process-sale':U
     7054       ,output v-value-character
     7055       ,output v-value-date
     7056       ,output v-value-decimal
     7057       ,output v-value-integer
     7058       ,output v-process-sale
     7059       ,output v-param-type
     7060       ,INPUT-OUTPUT table-handle v-tth
     7061       ) no-error .
     7062   if v-process-sale then do:
     7063     run write-log-and-file in p-log-handle (
     7064           input 1
     7065         , input log-file-name
     7066         , input 1
     7067         , input substitute( "Согласно настроечным параметрам подкачиваем чеки в продажу и резервируем!!!"
     7068                           )
     7069                                       ).
     7070     run str/afgetchk.p (
     7071                           input parparentproc
     7072                          ,input p-parent-handle
     7073                          ,input p-log-handle
     7074                          ,input (p-obj-type + chr(4)  + string(p-obj-code) + chr(4) + '')
     7075                          ) no-error.
     7076   end.
     7077   catch exAppErrors as class Progress.Lang.AppError :
     7078     v-disp-msg = exAppErrors:ReturnValue .
     7079     if v-disp-msg > "" then . else do :
     7080       v-disp-msg = exAppErrors:GetMessage(1) .
     7081       if v-disp-msg > "" then . else v-disp-msg = "Ошибка A-chkf" .
     7082     end .
     7083     run write-log-and-file in p-log-handle (
     7084                   input 1
     7085                 , input log-file-name
     7086                 , input 1
     7087                 , input v-disp-msg
     7088     ).
     7089     v-view-log = yes .
     7090   end catch .
     7091   catch exProErrors as class Progress.Lang.ProError :
     7092     v-disp-msg = exAppErrors:GetMessage(1) .
     7093     if v-disp-msg > "" then . else v-disp-msg = "Ошибка P-chkf" .
     7094     run write-log-and-file in p-log-handle (
     7095                   input 1
     7096                 , input log-file-name
     7097                 , input 1
     7098                 , input v-disp-msg
     7099     ).
     7100     v-view-log = yes .
     7101   end catch .
     7102   catch exAnyErrors as class Progress.Lang.Error:
     7103     v-disp-msg = "Ошибка U-chkf" .
     7104     run write-log-and-file in p-log-handle (
     7105                   input 1
     7106                 , input log-file-name
     7107                 , input 1
     7108                 , input v-disp-msg
     7109     ).
     7110     v-view-log = yes .
     7111   end catch .
     7112   finally :
     7113     define variable v-save-file-name as character no-undo .
     7114     v-save-file-name = substitute("&1get-cd.log", ibs.th.gbl.gbl-inipar:logDir) .
     7115     if v-view-log and p-auto = 0 then do:
     7116       message
     7117     "!!!При получении данных с касс произвошли ошибки!!!" skip
     7118     "По завершении сообщения об ошибках будут сохранены в файле" skip
     7119       v-save-file-name
     7120       view-as alert-box error .
     7121     define variable v-user-action   as character no-undo .
     7122     define variable v-printed       as logical   no-undo .
     7123     run gbl/prnfilen.w
     7124       (input  "Ошибки, возникшие при получении данных с касс"
     7125       ,input  0
     7126       ,input  "./get-chkf.log":U
     7127       ,input  7
     7128       ,output v-user-action
     7129       ,output v-printed
     7130       ) .
     7131     end.
     7132       run write-log-and-file in p-log-handle (
     7133           input 1
     7134         , input log-file-name
     7135         , input 1
     7136         , input substitute("&1", chr(10))
     7137       ).
     7138     OS-APPEND value(log-file-name) value(v-save-file-name).
     7139     OS-DELETE value(log-file-name).
     7140     if index (log-file-name, "get-chkf.log") > 0 then . else do:
     7141       OS-APPEND value("get-chkf.log") value(v-save-file-name).
     7142       OS-DELETE value("get-chkf.log").
     7143     end.
     7144   end finally .
