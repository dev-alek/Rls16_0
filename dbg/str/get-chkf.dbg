     4846   end.
     4847   run writelog in p-log-handle (
     4848         input log-file-name
     4849       , input 0
     4850       , input  "&Dline"
     4851                                     ).
     4852   run adm/shattri.p (
     4853       input "get":U
     4854       ,input  p-obj-type
     4855       ,input  p-obj-code
     4856       ,input  'get-chk':U
     4857       ,input  'no-get-chk':U
     4858       ,output v-value-character
     4859       ,output v-value-date
     4860       ,output v-value-decimal
     4861       ,output v-value-integer
     4862       ,output v-value-logical
     4863       ,output v-param-type
     4864       ,INPUT-OUTPUT table-handle v-tth
     4865       ) no-error .
     4866   assign
     4867   v-no-get-chk = v-value-logical
     4868   no-error .
     4869   if v-no-get-chk then do:
     4870     run write-log-and-file in p-log-handle (
     4871           input 1
     4872         , input log-file-name
     4873         , input 1
     4874         , input substitute( "Согласно настроечным параметрам НЕТ приема чеков в &1&2!!!&3"
     4875                             , p-obj-type
     4876                             , p-obj-code
     4877                             , chr(10)
     4878                           )
     4879                                       ).
     4880      return.
     4881   end.
     4882   run write-log-and-file in p-log-handle (
     4883         input 1
     4884       , input log-file-name
     4885       , input 1
     4886       , input substitute( "&1 &2&3"
     4887                           , (if p-remote = 1 then "Запрос на удаленные кассы" else "Прием данных с касс")
     4888                           , p-obj-type
     4889                           , p-obj-code
     4890                         )
     4891                                     ).
     4892   define variable v-cd-prfx as character no-undo .
     4893   define variable v-spl-obj-cash-name as character no-undo .
     4894   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4895   define variable v-param-type22 as character no-undo .
     4896   define variable v-value-date22 as date no-undo .
     4897   define variable v-value-decimal22 as decimal no-undo .
     4898   define variable v-value-integer22 as INTEGER no-undo .
     4899   define variable v-value-logical22 AS LOGICAL no-undo .
     4900   define variable v-tth22 as handle no-undo .
     4901   run adm/shattri.p (
     4902       input "get":U
     4903       ,input  p-obj-type
     4904       ,input  p-obj-code
     4905       ,input  'cd-sending':U
     4906       ,input  'dflt-cd':U
     4907       ,output dflt-cd
     4908       ,output v-value-date22
     4909       ,output v-value-decimal22
     4910       ,output v-value-integer22
     4911       ,output v-value-logical22
     4912       ,output v-param-type22
     4913       ,INPUT-OUTPUT table-handle v-tth22
     4914       ) no-error .
     4915   delete object v-tth22 no-error.
     4916   _cash-desk:
     4917   FOR EACH ub.cash-desk NO-LOCK WHERE
     4918            ub.cash-desk.db-num = g#db-num and
     4919            ub.cash-desk.obj-code = p-obj-code AND
     4920            ub.cash-desk.cash-on
     4921   BREAK
     4922   By ub.cash-desk.pos-type
     4923   with frame a :
     4924     IF FIRST-OF(ub.cash-desk.pos-type) then do:
     4925       v-index = index(p-other, ub.cash-desk.pos-type + '=').
     4926       if v-index > 0 then do:
     4927         assign
     4928         v-spec-command  = substring(p-other, v-index)
     4929         v-index = index(v-spec-command , chr(4))
     4930         v-spec-command  = if v-index > 0
     4931                           then substring(v-spec-command , 1, v-index - 1)
     4932                           else v-spec-command
     4933         v-spec-command = replace(v-spec-command, cash-desk.pos-type + '=', '':U)
     4934         .
     4935       end.
     4936       else do:
     4937         v-spec-command = '':U.
     4938       end.
     4939       CASE cash-desk.pos-type:
     4940         when 'MAGIA-XML':U then do:
     4941           assign
     4942           v-cd-prfx = 'magia':U
     4943           .
     4944         end.
     4945         when 'IBM-XML':U then do:
     4946           assign
     4947           v-cd-prfx = 'IBM-XML':U
     4948           v-param-prfx = 'ibm':U
     4949           .
     4950         end.
     4951         when 'IBM':U then do:
     4952           assign
     4953           v-cd-prfx = 'IBM':U
     4954           v-param-prfx = 'ibm':U
     4955           .
     4956         end.
     4957         when 'Emulator-NKT-IBM':U then do:
     4958           assign
     4959           v-cd-prfx = 'NKT-IBM':U
     4960           v-param-prfx = 'ibm':U
     4961           .
     4962         end.
     4963         when 'NCR-GM':U then do:
     4964           assign
     4965           v-cd-prfx = 'ncr-gm':U
     4966           .
     4967         end.
     4968         when 'NCR-AS@R':U then do:
     4969           assign
     4970           v-cd-prfx = 'ncr-as-r':U
     4971           .
     4972         end.
     4973         when 'r-keeper':U then do:
     4974           assign
     4975           v-cd-prfx = 'r-keeper':U
     4976           .
     4977         end.
     4978         when 'MARIA':U then do:
     4979           assign
     4980           v-cd-prfx = 'maria':U
     4981           v-param-prfx = 'maria':U
     4982           .
     4983         end.
     4984         when 'Autotank':U then do:
     4985           assign
     4986           v-cd-prfx = 'autotank':U
     4987           v-param-prfx = 'autotank':U
     4988           .
     4989         end.
     4990       END CASE.
     4991       CASE cash-desk.pos-type :
     4992         when 'IBM':U
     4993         or
     4994         when 'IBM-XML':U
     4995         or
     4996         when 'MAGIA-XML':U
     4997         or
     4998         when 'Emulator-NKT-IBM':U
     4999         or
     5000         when 'Autotank':U
     5001         then  do:
     5002           run str/get-inis.p (
     5003                            input p-obj-type
     5004                          , input p-obj-code
     5005                          , input cash-desk.pos-type
     5006                          , input cash-desk.remote
     5007                          , input "get":U
     5008                          , output out
     5009                          , output out2
     5010                          , output in_
     5011                          , output spl
     5012                          , output sav
     5013                          , output v-remote
     5014                          )  no-error .
     5015           if error-status:error then do:
     5016             run write-log-and-file in p-log-handle (
     5017                   input 1
     5018                 , input log-file-name
     5019                 , input 1
     5020                 , input substitute(
     5021                                   "!!!Не удалось получить настройки для  POS типа &1 для маг&2 из ini-файла:&3&4 &5"
     5022                                   , cash-desk.pos-type
     5023                                   , p-obj-code
     5024                                   , chr(10)
     5025                                   , error-status:get-message(1)
     5026                                   , return-value
     5027                                   )).
     5028             assign
     5029             v-view-log = yes.
     5030             if p-auto = 0 then do:
     5031   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5032   if v-view-log
     5033   and not g#news
     5034   and not g#auto
     5035   then do:
     5036     message
     5037     substitute('!!!При приеме информации с касс &1&2 произошли ошибки!!!'                                   ,p-obj-type                                                                                 ,p-obj-code)  skip
     5038     "!!!Внимательно прочитайте Log-file!!"
     5039     view-as alert-box error .
     5040        define variable v-user-action24   as character no-undo .
     5041     define variable v-printed24       as logical   no-undo .
     5042     run gbl/prnfilen.w
     5043       (input  (substitute('!!!При приеме информации с касс &1&2 произошли ошибки!!!'                                   ,p-obj-type                                                                                 ,p-obj-code))
     5044       ,input  0
     5045       ,input  (string("./":U) + 'get-chkf.log')
     5046       ,input  7
     5047       ,output v-user-action24
     5048       ,output v-printed24
     5049       ) .
     5050   end.
     5051   if v-view-log = true
     5052   and (g#news
     5053   or g#auto)
     5054   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     5055   then do:
     5056      run cb_set-view-log in p-parent-handle ( input yes).
     5057   end.
     5058   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     5059     OS-DELETE value(string("./":U) + 'get-chkf.log').
     5060   end.
     5061                           return "error":U.                  end.
     5062             else undo,  return "error".
     5063           end.
     5064           if cash-desk.pos-type = 'MAGIA-XML':U then do:
     5065             assign
     5066             kassa-rub-code = 0
     5067             ibmgroup = no
     5068             ibmspool = "3"
     5069             .
     5070           end.
     5071           else do:
     5072             define variable v-effective-pos-type as character no-undo .
     5073             v-effective-pos-type =  (if (cash-desk.pos-type = 'IBM':U
     5074                                         or
     5075                                         cash-desk.pos-type = 'Emulator-NKT-IBM':U)
     5076                                     then 'cd-type-ibm':U
     5077                                     else 'cd-type-IBM-XML':U
     5078                                     ).
     5079             run adm/shattri.p (
     5080                 input "get":U
     5081                 ,input  p-obj-type
     5082                 ,input  p-obj-code
     5083                 ,input  v-effective-pos-type
     5084                 ,input  '':U
     5085                 ,output v-value-character
     5086                 ,output v-value-date
     5087                 ,output v-value-decimal
     5088                 ,output v-value-integer
     5089                 ,output v-value-logical
     5090                 ,output v-param-type
     5091                 ,INPUT-OUTPUT table-handle v-tth
     5092                 ) no-error .
     5093             IF error-status:error then do:
     5094               assign
     5095               v-mes =  substitute(
     5096                                     "Не удалось получить настройки для  POS типа &1 для маг&2"
     5097                                     , cash-desk.pos-type
     5098                                     , p-obj-code).
     5099               run write-log-and-file in p-log-handle (
     5100                 input 1
     5101               , input log-file-name
     5102               , input 1
     5103               , input v-mes).
     5104               v-view-log = yes.
     5105               undo, return error v-mes.
     5106             end.
     5107             for each thbjattr_thbj-attr where
     5108                     thbjattr_thbj-attr.obj-type = p-obj-type
     5109                 and thbjattr_thbj-attr.obj-code = p-obj-code
     5110                 and thbjattr_thbj-attr.upper-prop-code =  v-effective-pos-type
     5111             on error undo, return error :
     5112               case thbjattr_thbj-attr.prop-code :
     5113                 when 'ibmgroup':U then do:
     5114                   assign
     5115                   ibmgroup = thbjattr_thbj-attr.property-value-logical.
     5116                 end.
     5117                 when 'ibmrubc':U
     5118                 or when 'ibmrubc':U then do:
     5119                   kassa-rub-code = thbjattr_thbj-attr.property-value-integer.
     5120                 end.
     5121                 when 'specgrp':U
     5122                 or when 'specgrp':U then do:
     5123                   specgrp = thbjattr_thbj-attr.property-value-character.
     5124                 end.
     5125                 when 'ibmspool':U then do:
     5126                   if cash-desk.pos-type = 'IBM':U
     5127                   or cash-desk.pos-type = 'Emulator-NKT-IBM':U
     5128                   then do:
     5129                     assign
     5130                     ibmspool = string(thbjattr_thbj-attr.property-value-integer).
     5131                   end.
     5132                 end.
     5133                 when 'cash-pay-list':U then do:
     5134                 end.
     5135               end case.
     5136             end.
     5137             if cash-desk.pos-type = 'IBM-XML':U
     5138             and entry(1, v-spec-command) = "version" then do:
     5139               define variable v-field-list as character no-undo .
     5140               define variable v-value-list as character no-undo .
     5141               define variable v-pos-type as character no-undo .
     5142               define variable v-cash-num as integer no-undo init ?.
     5143               run gen-key-fv in this-procedure ( input replace(v-spec-command, "version" + chr(44), '')
     5144                                                 ,output v-field-list
     5145                                                 ,output v-value-list
     5146                                                 ).
     5147               assign
     5148               v-pos-type = entry(lookup("pos-type"
     5149                                         , v-field-list
     5150                                         , chr(3))
     5151                                   , v-value-list, chr(3))
     5152               v-cash-num = integer(entry(lookup("cash-num"
     5153                                                 , v-field-list
     5154                                                 , chr(3))
     5155                                           , v-value-list, chr(3))).
     5156             end.
     5157           end.
     5158           assign
     5159           var-found-not-remote = no
     5160           .
     5161           if entry(1, v-spec-command) ne "version"
     5162           then do:
     5163              run str/get-tran-fuel.p(parparentproc,
     5164                                      p-parent-handle,
     5165                                      p-log-handle,
     5166                                      log-file-name,
     5167                                      p-obj-type,
     5168                                      p-obj-code,
     5169                                      output v-value-logical) no-error.
     5170              if error-status:error then do:
     5171                 run write-log-and-file in p-log-handle (
     5172                              input 1
     5173                            , input log-file-name
     5174                            , input 1
     5175                            , input return-value).
     5176              end.
     5177           end.
     5178           run str/get-chk-slips.p(parparentproc,
     5179                                   p-parent-handle,
     5180                                   p-log-handle,
     5181                                   log-file-name,
     5182                                   p-obj-type,
     5183                                   p-obj-code,
     5184                                   output v-value-logical) no-error.
     5185           if error-status:error then do:
     5186              run write-log-and-file in p-log-handle (
     5187                           input 1
     5188                         , input log-file-name
     5189                         , input 1
     5190                         , input return-value).
     5191           end.
     5192           if p-shft-close = 1 then do:
     5193                       run str/get-chk-report.p(parparentproc,
     5194                           p-parent-handle,
     5195                           p-log-handle,
     5196                           log-file-name,
     5197                           p-obj-type,
     5198                           p-obj-code,
     5199                           output v-value-logical) no-error.
     5200                       if error-status:error then
     5201                       do:
     5202                           run write-log-and-file in p-log-handle (
     5203                               input 1
     5204                               , input log-file-name
     5205                               , input 1
     5206                               , input return-value).
     5207                       end.
     5208           end.
     5209           _ibm-cash-desk:
     5210           FOR EACH for-cash-desk NO-LOCK WHERE
     5211                   for-cash-desk.db-num = g#db-num and
     5212                   for-cash-desk.pos-type = cash-desk.pos-type AND
     5213                   for-cash-desk.obj-code = p-obj-code AND
     5214                   for-cash-desk.cash-on = yes :
     5215             if for-cash-desk.autonomy = integer('2':U)
     5216             and for-cash-desk.pos-type <> 'Autotank':U
     5217             then next _ibm-cash-desk.
     5218             if for-cash-desk.autonomy = integer('1':U)
     5219             and for-cash-desk.pos-type = 'Autotank':U
     5220             then next _ibm-cash-desk.
     5221             if v-cash-num <> ? and
     5222             not (for-cash-desk.cash-num = v-cash-num
     5223                  and for-cash-desk.pos-type = v-pos-type)
     5224             then next.
     5225             if for-cash-desk.remote = 1 then do:
     5226               if p-remote = 0 then NEXT _ibm-cash-desk.
     5227               assign
     5228               v-spl-obj-cash-name = string(for-cash-desk.obj-code, "99999") + "-":U +
     5229                                trim(string(for-cash-desk.cash-num, ">999"))
     5230               v-dir-remote-tmp = v-remote + "tmp":U
     5231               v-dir-remote =  v-remote + "out":U + v-spl-obj-cash-name
     5232               .
     5233               run gbl/dir-cre.p ( input v-dir-remote-tmp) no-error .
     5234               if error-status:error then do:
     5235                 run write-log-and-file in p-log-handle (
     5236                       input 1
     5237                     , input log-file-name
     5238                     , input 1
     5239                     , input substitute(
     5240                                       "!!!Каталог &1 для отсылки запроса на удаленную кассу &2 маг&3 не найден&4" +
     5241                                       "и/или попытка его создания не удалась:&4 &5 &6"
     5242                                       , v-dir-remote-tmp
     5243                                       , for-cash-desk.cash-num
     5244                                       , p-obj-code
     5245                                       , chr(10)
     5246                                       , error-status:get-message(1)
     5247                                       , return-value
     5248                                       )).
     5249                 assign
     5250                 v-view-log = yes.
     5251                 NEXT _ibm-cash-desk.
     5252               end.
     5253               assign
     5254               var-spl-suffix = v-dir-remote + chr(47) +
     5255                               "spl":U + v-spl-obj-cash-name
     5256               var-spl-suffix-tmp = v-dir-remote-tmp + chr(47) +
     5257                               "spl":U + v-spl-obj-cash-name
     5258               .
     5259             end.
     5260             else do:
     5261               if p-remote = 1  then NEXT _ibm-cash-desk.
     5262               assign
     5263               v-spl-obj-cash-name = string(for-cash-desk.obj-code, "99999") + "-":U + trim(string(for-cash-desk.cash-num, ">999"))
     5264               var-spl-suffix = "spl":U  + v-spl-obj-cash-name
     5265               var-spl-suffix-tmp = "spl":U  + v-spl-obj-cash-name
     5266               .
     5267             end.
     5268             if (p-remote = 0 and Not for-cash-desk.remote = 1) or
     5269                 (p-remote = 1 and for-cash-desk.remote = 1 )  then do:
     5270               if cash-desk.pos-type = 'IBM':U
     5271               or cash-desk.pos-type = 'Emulator-NKT-IBM':U
     5272               then do:
     5273                 if search( (if for-cash-desk.remote = 1 then "":U else out) + var-spl-suffix-tmp + '.dat':U ) = ? then  do:
     5274                   output to value( (if for-cash-desk.remote = 1 then "":U else out) + var-spl-suffix-tmp + '.dat':U ) convert target "ibm866".
     5275                   put unformatted '<' spl '>'.
     5276                   output close.
     5277                 end.
     5278                 else do:
     5279                   run write-log-and-file in p-log-handle (
     5280                         input 1
     5281                       , input log-file-name
     5282                       , input 1
     5283                       , input substitute(
     5284                                         "!!!Не могу отправить запрос на кассу &1 маг&2 по адресу &3&4" +
     5285                                         "Возможно, в каталоге &5&4" +
     5286                                         "остались файлы spl*.adr и spl*.dat&4" +
     5287                                         "предыдущего недошедшего до кассы запроса - УДАЛЯЮТСЯ..."
     5288                                         , for-cash-desk.cash-num
     5289                                         , p-obj-code
     5290                                         , for-cash-desk.addr-path
     5291                                         , chr(10)
     5292                                         , ( if for-cash-desk.remote = 1 then v-dir-remote-tmp else out)
     5293                                         )).
     5294                   assign
     5295                   v-view-log = yes.
     5296                   OS-DELETE value( (if for-cash-desk.remote = 1 then "":U else out) + var-spl-suffix-tmp + '.adr':U ) .
     5297                   OS-DELETE value( (if for-cash-desk.remote = 1 then "":U else out) + var-spl-suffix-tmp + '.ad0':U ) .
     5298                   OS-DELETE value( (if for-cash-desk.remote = 1 then "":U else out) + var-spl-suffix-tmp + '.dat':U ) .
     5299                   output to value( (if for-cash-desk.remote = 1 then "":U else out) + var-spl-suffix-tmp + '.dat':U ) convert target "ibm866".
     5300                   put unformatted '<' spl '>'.
     5301                   output close.
     5302                 end.
     5303                 output to value( (if for-cash-desk.remote = 1 then "":U else out) + var-spl-suffix-tmp + '.ad0':U ) convert target "ibm866".
     5304                 put ' ' skip(1).
     5305                 put unformatted '  ' for-cash-desk.addr-path ' spool' skip.
     5306                 output close.
     5307                 OS-RENAME
     5308                 VALUE((if for-cash-desk.remote = 1 then "":U else out) + var-spl-suffix-tmp + '.ad0':U)
     5309                 VALUE((if for-cash-desk.remote = 1 then "":U else out) + var-spl-suffix-tmp + '.adr':U).
     5310                 os-er = OS-ERROR.
     5311                 if os-er <> 0 then do:
     5312                   run write-log-and-file in p-log-handle (
     5313                         input 1
     5314                       , input log-file-name
     5315                       , input 1
     5316                       , input substitute(
     5317                                         "!!!Ошибки при записи файлов запроса на кассу &1 маг&2 по адресу &3&4" +
     5318                                         "Ошибки в работе локальной сети или нарушение прав доступа!"
     5319                                         , for-cash-desk.cash-num
     5320                                         , p-obj-code
     5321                                         , ((if for-cash-desk.remote = 1 then "":U else out) + var-spl-suffix-tmp + '.adr':U)
     5322                                         , chr(10)
     5323                                         )).
     5324                   assign
     5325                   v-view-log = yes.
     5326                   return error.
     5327                 end.
     5328                 if for-cash-desk.remote = 1 then do:
     5329                   run gbl/dir-cre.p ( input v-dir-remote) no-error .
     5330                   if error-status:error then do:
     5331                     run write-log-and-file in p-log-handle (
     5332                           input 1
     5333                         , input log-file-name
     5334                         , input 1
     5335                         , input substitute(
     5336                                           "!!!Каталог &1 для отсылки запроса на удаленную кассу &2 маг&3 не найден&4" +
     5337                                           "и/или попытка его создания не удалась:&4 &5 &6"
     5338                                           , v-dir-remote
     5339                                           , for-cash-desk.cash-num
     5340                                           , p-obj-code
     5341                                           , chr(10)
     5342                                           , error-status:get-message(1)
     5343                                           , return-value
     5344                                           )).
     5345                     assign
     5346                     v-view-log = yes.
     5347                     NEXT _ibm-cash-desk.
     5348                   end.
     5349                   OS-RENAME
     5350                   VALUE(var-spl-suffix-tmp + '.adr':U)
     5351                   VALUE(var-spl-suffix + '.adr':U).
     5352                   OS-RENAME
     5353                   VALUE(var-spl-suffix-tmp + '.dat':U)
