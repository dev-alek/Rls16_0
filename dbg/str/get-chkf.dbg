     4400   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4401   define stream dirstream .
     4402   procedure waitp :
     4403   define input parameter p-auto as logical no-undo .
     4404   define input parameter fname           as character no-undo .
     4405   define input parameter mess            as character no-undo .
     4406   define input parameter btn-mess-start  as character no-undo .
     4407   define input parameter mess-auto-end   as character no-undo .
     4408   define input parameter btn-mess-end    as character no-undo .
     4409   define input parameter p-waiting       as integer   no-undo .
     4410   define variable v-start-time as int64   no-undo .
     4411   define variable v-exec-time as integer no-undo .
     4412   define variable v-exec-time0 as integer no-undo .
     4413   define variable v-file-name-del as character no-undo .
     4414   define variable v-dir-name as character no-undo .
     4415   define variable v-fn-add-mask as character no-undo .
     4416   define variable v-elapsed-time as integer no-undo .
     4417   define variable v-start-dir-watch-time as int64   no-undo .
     4418   define variable v-appear as logical no-undo .
     4419     do
     4420     on error undo, return error
     4421     :
     4422       if p-auto then do:
     4423         assign
     4424         v-file-name-del = entry(1, fname, chr(4))
     4425         v-dir-name      = (if num-entries(fname, chr(4)) = 3
     4426                           and v-file-name-del = "":U
     4427                           then entry(2, fname, chr(4))
     4428                           else "":U)
     4429         v-fn-add-mask = (if num-entries(fname, chr(4)) = 3
     4430                         and v-file-name-del = "":U
     4431                         then entry(3, fname, chr(4))
     4432                         else "":U)
     4433         v-fn-add-mask = (if v-dir-name <> "":U and v-fn-add-mask = "":U
     4434                         then "*.*"
     4435                         else v-fn-add-mask)
     4436         .
     4437         assign
     4438           v-start-time = etime
     4439         .
     4440         run show-counter in p-log-handle.
     4441         run write-counter in p-log-handle ( input btn-mess-start ).
     4442         run write-log-and-file in p-log-handle (
     4443               input 1
     4444             , input log-file-name
     4445             , input 1
     4446             , input mess).
     4447         do while true
     4448         :
     4449           assign
     4450             v-exec-time = (etime - v-start-time) / 1000
     4451           .
     4452           run show-counter in p-log-handle .
     4453           if v-exec-time0 <> v-exec-time then
     4454           run write-counter in p-log-handle (substitute("Время ожидания &1", string(v-exec-time, "HH:MM:SS"))).
     4455           assign
     4456           v-exec-time0 =  v-exec-time.
     4457           if v-exec-time >= p-waiting then do:
     4458             if v-file-name-del  <> ""
     4459             or v-dir-name <> "":u
     4460             then do:
     4461               run write-log-and-file in p-log-handle (
     4462                     input 1
     4463                   , input log-file-name
     4464                   , input 1
     4465                   , input substitute("&1"
     4466                                     , mess-auto-end
     4467                                     )).
     4468               run hide-counter in p-log-handle .
     4469               return .
     4470             end.
     4471             if v-dir-name = "":U then do:
     4472               run hide-counter in p-log-handle .
     4473               return .
     4474             end.
     4475           end.
     4476           if v-file-name-del <> "" then do:
     4477             if search(v-file-name-del) = ?
     4478             then do:
     4479               run hide-counter in p-log-handle .
     4480               return .
     4481             end.
     4482           end.
     4483           if v-dir-name <> "":U
     4484           and v-exec-time > minimum(p-waiting / 4, 15)
     4485           and (v-start-dir-watch-time = 0
     4486               or
     4487               (etime  - v-start-dir-watch-time) > v-elapsed-time * 10
     4488               )
     4489           then do:
     4490             assign
     4491             v-start-dir-watch-time = etime.
     4492             run proc-read-dir in this-procedure (
     4493                                                 input v-dir-name
     4494                                                 ,input v-fn-add-mask
     4495                                                 ,output v-elapsed-time
     4496                                                 ,output v-appear
     4497                                                 ) no-error .
     4498             if error-status:error then do:
     4499               return.
     4500             end.
     4501             if v-appear then return.
     4502           end.
     4503         end.
     4504       end.
     4505       else do:
     4506         run str/waitp.w (
     4507                      input fname
     4508                    , input mess
     4509                    , input btn-mess-start
     4510                    , input btn-mess-end
     4511                    , input p-waiting
     4512                     ) no-error .
     4513         if error-status:error then return error .
     4514       end.
     4515     end.
     4516   end procedure.
     4517   procedure waitpxml :
     4518   define input parameter p-auto as logical no-undo .
     4519   define input parameter fname-out       as character no-undo .
     4520   define input parameter fname-in        as character no-undo .
     4521   define input parameter mess            as character no-undo .
     4522   define input parameter btn-mess-start  as character no-undo .
     4523   define input parameter btn-mess-end    as character no-undo .
     4524   define input parameter mess-continue-waiting as character no-undo .
     4525   define input parameter p-waiting       as integer   no-undo .
     4526     define variable v-start-time as int64     no-undo .
     4527     define variable v-exec-time as integer no-undo .
     4528     define variable v-exec-time0 as integer no-undo .
     4529     define variable v-continue-waiting as logical no-undo .
     4530     do
     4531     on error undo, return error
     4532     :
     4533       if p-auto then do:
     4534         assign
     4535           v-start-time = etime
     4536         .
     4537         run show-counter in p-log-handle.
     4538         run write-counter in p-log-handle ( input btn-mess-start ).
     4539         run write-log-and-file in p-log-handle (
     4540               input 1
     4541             , input log-file-name
     4542             , input 1
     4543             , input mess).
     4544         do while true
     4545         :
     4546           assign
     4547             v-exec-time = (etime - v-start-time) / 1000
     4548           .
     4549           run show-counter in p-log-handle .
     4550           if v-exec-time0 <> v-exec-time then
     4551           run write-counter in p-log-handle (substitute("Время ожидания &1", string(v-exec-time, "HH:MM:SS"))).
     4552           assign
     4553           v-exec-time0 =  v-exec-time.
     4554           if v-exec-time >= p-waiting
     4555           and not v-continue-waiting
     4556           then do:
     4557             if fname-out <> "" then do:
     4558               run write-log-and-file in p-log-handle (
     4559                     input 1
     4560                   , input log-file-name
     4561                   , input 1
     4562                   , input substitute("------------------------- &1&1------------------------- &2"
     4563                                     , chr(10)
     4564                                     , (if p-auto then 'Касса не ответила.' else btn-mess-end)
     4565                                     )).
     4566               return .
     4567             end.
     4568             else do:
     4569               run hide-counter in p-log-handle .
     4570               return .
     4571             end.
     4572           end.
     4573           if fname-out <> "" then do:
     4574             if search(fname-out) = ?
     4575             then do:
     4576               run hide-counter in p-log-handle .
     4577               return .
     4578             end.
     4579             else do:
     4580               if search(fname-in) <> ? then do:
     4581                   assign
     4582                   v-continue-waiting = yes
     4583                   .
     4584               end.
     4585             end.
     4586           end.
     4587         end.
     4588       end.
     4589       else do:
     4590         run str/waitpxml.w (
     4591                      input fname-out
     4592                    , input fname-in
     4593                    , input mess
     4594                    , input btn-mess-start
     4595                    , input btn-mess-end
     4596                    , input mess-continue-waiting
     4597                    , input p-waiting
     4598                     ) no-error .
     4599         if error-status:error then return error .
     4600       end.
     4601     end.
     4602   end procedure.
     4603   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4604   PROCEDURE proc-read-dir :
     4605   DEFINE INPUT PARAMETER p-dir-name AS CHARACTER NO-UNDO.
     4606   DEFINE INPUT PARAMETER p-fn-add-mask AS CHARACTER NO-UNDO.
     4607   DEFINE output PARAMETER p-elapsed-time AS INTEGER NO-UNDO.
     4608   DEFINE output PARAMETER p-appear AS logical NO-UNDO.
     4609   define variable v-start-time as int64   no-undo.
     4610   define variable file as character no-undo.
     4611   define variable path as character no-undo.
     4612   define variable atr  as character no-undo.
     4613   define variable v-ext-split as integer   no-undo .
     4614   define variable v-ext-split-mask as integer   no-undo .
     4615   define variable v-file-name-no-ext as character no-undo .
     4616   define variable v-file-name-ext as character no-undo .
     4617   define variable v-mask-no-ext as character no-undo .
     4618   define variable v-mask-ext as character no-undo .
     4619   assign
     4620   v-start-time = etime.
     4621   input stream DirStream from os-dir (p-dir-name) .
     4622   REPEAT :
     4623     import stream DirStream file path atr.
     4624     if can-do( "f", atr )    then do:
     4625       if file matches p-fn-add-mask then do:
     4626         p-appear = yes.
     4627         leave.
     4628       end.
     4629       assign
     4630       v-ext-split = r-index(file, '.':u)
     4631       v-ext-split-mask = r-index(p-fn-add-mask, '.':u)
     4632       .
     4633       if v-ext-split > 0 then do:
     4634         assign
     4635           v-file-name-no-ext = substring(file, 1, v-ext-split - 1)
     4636           v-file-name-ext    = substring(file, v-ext-split + 1)
     4637         .
     4638       end.
     4639       else do:
     4640         assign
     4641           v-file-name-no-ext = file
     4642           v-file-name-ext    = ""
     4643         .
     4644       end.
     4645       if v-ext-split-mask > 0 then do:
     4646         assign
     4647           v-mask-no-ext = substring(p-fn-add-mask, 1, v-ext-split-mask - 1)
     4648           v-mask-ext    = substring(p-fn-add-mask, v-ext-split-mask + 1)
     4649         .
     4650       end.
     4651       else do:
     4652         assign
     4653           v-mask-no-ext = p-fn-add-mask
     4654           v-mask-ext    = ""
     4655         .
     4656       end.
     4657       if v-file-name-no-ext matches v-mask-no-ext
     4658       and v-file-name-ext matches v-mask-ext
     4659       then do:
     4660         p-appear = yes.
     4661         leave.
     4662       end.
     4663     end.
     4664   END.
     4665   assign
     4666   p-elapsed-time = etime - v-start-time.
     4667   END PROCEDURE.
