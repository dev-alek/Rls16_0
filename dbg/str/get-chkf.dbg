     5831                                and chk-doc.obj-code eq p-obj-code
     5832                                and chk-doc.pay-desk eq cash-desk.cash-num
     5833                                and chk-doc.out-code  = ?):
     5834                if     (chk-doc.chk-date eq v-date
     5835                   and chk-doc.chk-time  ge v-time)
     5836                   or   chk-doc.chk-date gt v-date
     5837                then do:
     5838                   if chk-doc.office eq ?
     5839                   then do:
     5840                      delete chk-doc.
     5841                      next block-del.
     5842                   end.
     5843                   else do vi = 1 to num-entries(chk-doc.office):
     5844                      if can-do('0,сум-ош,сер-ош,при-ош,опл-ош,скидка-ош,тов-ош,кол-ош,прт-ош':U,entry(vi,chk-doc.office))
     5845                      then do:
     5846                         delete chk-doc.
     5847                         next block-del.
     5848                      end.
     5849                   end.
     5850                end.
     5851             end.
     5852             run str/getxibmf.p (
     5853                            input parparentproc
     5854                           ,input p-log-handle
     5855                           ,input p-obj-type
     5856                           ,input p-obj-code
     5857                           ,input v-host-code
     5858                           ,input in_
     5859                           ,input spl
     5860                           ,input (in_ + sav)
     5861                           ,input cash-desk.pos-type
     5862                           ,input (if (cash-desk.pos-type = 'IBM-XML':U
     5863                                   and cash-desk.autonomy = integer('0':U))
     5864                                   or (cash-desk.pos-type = 'Autotank':U
     5865                                   and cash-desk.autonomy = integer('2':U))
     5866                                   then "utf-8":U
     5867                                   else "windows-1251")
     5868                           ,input log-file-name
     5869                           ,input (if mReadBuffer then "readbuffer_" else "") +  "spool":U + (if p-other <> '':U then chr(4) + v-spec-command else '':U)
     5870                           ,input
     5871                             if mReadBuffer then mWebResp else
     5872                                   (if entry(1, v-spec-command) = "version"
     5873                                   and cash-desk.pos-type = 'IBM-XML':U
     5874                                   then v-xml-file-name-path
     5875                                   else "":U)
     5876                           ,input-output v-view-log
     5877                           ) no-error .
     5878             if return-value = "error":U then do:
     5879               assign
     5880               v-view-log = yes.
     5881               if p-auto = 0 then do:
     5882   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5883   if v-view-log
     5884   and not g#news
     5885   and not g#auto
     5886   then do:
     5887     message
     5888     substitute('!!!При приеме информации с касс &1&2 произошли ошибки!!!'                                   ,p-obj-type                                                                                 ,p-obj-code)  skip
     5889     "!!!Внимательно прочитайте Log-file!!"
     5890     view-as alert-box error .
     5891        define variable v-user-action30   as character no-undo .
     5892     define variable v-printed30       as logical   no-undo .
     5893     run gbl/prnfilen.w
     5894       (input  (substitute('!!!При приеме информации с касс &1&2 произошли ошибки!!!'                                   ,p-obj-type                                                                                 ,p-obj-code))
     5895       ,input  0
     5896       ,input  (string("./":U) + 'get-chkf.log')
     5897       ,input  7
     5898       ,output v-user-action30
     5899       ,output v-printed30
     5900       ) .
     5901   end.
     5902   if v-view-log = true
     5903   and (g#news
     5904   or g#auto)
     5905   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     5906   then do:
     5907      run cb_set-view-log in p-parent-handle ( input yes).
     5908   end.
     5909   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     5910     OS-DELETE value(string("./":U) + 'get-chkf.log').
     5911   end.
     5912                           return "error":U.                  end.
     5913             end.
     5914           end.
     5915           END .
     5916           _ibm-cash-desk-remote:
     5917           FOR EACH for-cash-desk NO-LOCK WHERE
     5918                   for-cash-desk.db-num = g#db-num and
     5919                   for-cash-desk.pos-type = cash-desk.pos-type AND
     5920                   for-cash-desk.obj-code = p-obj-code AND
     5921                   for-cash-desk.cash-on = yes :
     5922             if for-cash-desk.remote = 1 then do:
     5923               assign
     5924               v-dir-remote =  v-remote + "in":U +
     5925                               string(for-cash-desk.obj-code, "99999") + "-":U +
     5926                             trim(string(for-cash-desk.cash-num, ">999"))
     5927               .
     5928               run gbl/dir-cre.p ( input v-dir-remote) no-error .
     5929               if error-status:error then do:
     5930                 run write-log-and-file in p-log-handle (
     5931                       input 1
     5932                     , input log-file-name
     5933                     , input 1
     5934                     , input substitute(
     5935                                       "!!!Каталог &1 для отсылки запроса на удаленную кассу &2 маг&3 не найден&4" +
     5936                                       "и/или попытка его создания не удалась:&4 &5 &6"
     5937                                       , v-dir-remote
     5938                                       , for-cash-desk.cash-num
     5939                                       , p-obj-code
     5940                                       , chr(10)
     5941                                       , error-status:get-message(1)
     5942                                       , return-value
     5943                                       )).
     5944                 assign
     5945                 v-view-log = yes.
     5946                 NEXT _ibm-cash-desk-remote.
     5947               end.
     5948               if cash-desk.pos-type = 'IBM':U
     5949               or cash-desk.pos-type = 'Emulator-NKT-IBM':U
     5950               then do:
     5951                 run str/get-ibmf.p (
     5952                               input parparentproc
     5953                               ,input p-log-handle
     5954                               ,input p-obj-type
     5955                               ,input p-obj-code
     5956                               ,input v-host-code
     5957                               ,input cash-desk.pos-type
     5958                               ,input v-dir-remote + chr(47)
     5959                               ,input "":U
     5960                               ,input (in_ + sav)
     5961                               ,input v-spec-command
     5962                               ,input-output v-view-log
     5963                               ) no-error .
     5964                 if return-value = "error":U then do:
     5965                   v-view-log = yes.
     5966                   if p-auto = 0 then do:
     5967   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5968   if v-view-log
     5969   and not g#news
     5970   and not g#auto
     5971   then do:
     5972     message
     5973     substitute('!!!При приеме информации с касс &1&2 произошли ошибки!!!'                                   ,p-obj-type                                                                                 ,p-obj-code)  skip
     5974     "!!!Внимательно прочитайте Log-file!!"
     5975     view-as alert-box error .
     5976        define variable v-user-action32   as character no-undo .
     5977     define variable v-printed32       as logical   no-undo .
     5978     run gbl/prnfilen.w
     5979       (input  (substitute('!!!При приеме информации с касс &1&2 произошли ошибки!!!'                                   ,p-obj-type                                                                                 ,p-obj-code))
     5980       ,input  0
     5981       ,input  (string("./":U) + 'get-chkf.log')
     5982       ,input  7
     5983       ,output v-user-action32
     5984       ,output v-printed32
     5985       ) .
     5986   end.
     5987   if v-view-log = true
     5988   and (g#news
     5989   or g#auto)
     5990   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     5991   then do:
     5992      run cb_set-view-log in p-parent-handle ( input yes).
     5993   end.
     5994   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     5995     OS-DELETE value(string("./":U) + 'get-chkf.log').
     5996   end.
     5997                           return "error":U.                  end.
     5998                 end.
     5999               end.
     6000               else do:
     6001                 run str/getxibmf.p (
     6002                                input parparentproc
     6003                               ,input p-log-handle
     6004                               ,input p-obj-type
     6005                               ,input p-obj-code
     6006                               ,input v-host-code
     6007                               ,input v-dir-remote + chr(47)
     6008                               ,input "":U
     6009                               ,input (in_ + sav)
     6010                               ,input cash-desk.pos-type
     6011                               ,input (if (cash-desk.pos-type = 'IBM-XML':U
     6012                                       and cash-desk.autonomy = integer('0':U))
     6013                                       or (cash-desk.pos-type = 'Autotank':U
     6014                                       and cash-desk.autonomy = integer('2':U))
     6015                                       then "utf-8":U
     6016                                       else "windows-1251")
     6017                               ,input log-file-name
     6018                               ,input "spool":U + (if p-other <> '':U then chr(4) + v-spec-command else '':U)
     6019                               ,input (if entry(1, v-spec-command) = "version"
     6020                                       and cash-desk.pos-type = 'IBM-XML':U
     6021                                       then v-xml-file-name-path
     6022                                       else "":U)
     6023                               ,input-output v-view-log
     6024                               ) no-error .
     6025                 if return-value = "error":U then do:
     6026                   v-view-log = yes.
     6027                   if p-auto = 0 then do:
     6028   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6029   if v-view-log
     6030   and not g#news
     6031   and not g#auto
     6032   then do:
     6033     message
     6034     substitute('!!!При приеме информации с касс &1&2 произошли ошибки!!!'                                   ,p-obj-type                                                                                 ,p-obj-code)  skip
     6035     "!!!Внимательно прочитайте Log-file!!"
     6036     view-as alert-box error .
     6037        define variable v-user-action34   as character no-undo .
     6038     define variable v-printed34       as logical   no-undo .
     6039     run gbl/prnfilen.w
     6040       (input  (substitute('!!!При приеме информации с касс &1&2 произошли ошибки!!!'                                   ,p-obj-type                                                                                 ,p-obj-code))
     6041       ,input  0
