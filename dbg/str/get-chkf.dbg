     6722           os-append
     6723           value( IN_ + SPL + (if spl = "":U then "":U else "\":U) + "HOCIDC.001":U )
     6724           value( in_ + sav + (if sav = "":U then "":U else "\":U) + string( day( today ), "99" ) + "_" +
     6725           string( month( today ), "99" ) + "_" +
