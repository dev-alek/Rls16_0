     6810                                   , cash-desk.pos-type
     6811                                   , p-obj-code
     6812                                   , chr(10)
     6813                                   , error-status:get-message(1)
     6814                                   , return-value
     6815                                   )).
     6816             v-view-log = yes.
     6817             undo, return "error".
