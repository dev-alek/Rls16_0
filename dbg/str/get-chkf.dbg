     6062             else do:
     6063               NEXT _ibm-cash-desk-remote.
     6064             end.
     6065           END .
     6066         end.
     6067         when 'OMRON':U then do:
     6068           run str/get-inis.p (
     6069                            input p-obj-type
     6070                          , input p-obj-code
     6071                          , input 'OMRON':U
     6072                          , input cash-desk.remote
     6073                          , input "get":U
     6074                          , output out
     6075                          , output out2
     6076                          , output in_
     6077                          , output spl
     6078                          , output sav
     6079                          , output v-remote
     6080                          )  no-error .
     6081           if error-status:error then do:
     6082             run write-log-and-file in p-log-handle (
     6083                   input 1
     6084                 , input log-file-name
     6085                 , input 1
     6086                 , input substitute(
     6087                                   "!!!Не удалось получить настройки для  POS типа &1 для маг&2 из ini-файла:&3&4 &5"
     6088                                   , cash-desk.pos-type
     6089                                   , p-obj-code
     6090                                   , chr(10)
     6091                                   , error-status:get-message(1)
     6092                                   , return-value
     6093                                   )).
     6094             v-view-log = yes.
     6095             if p-auto = 0 then do:
     6096   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6097   if v-view-log
     6098   and not g#news
     6099   and not g#auto
     6100   then do:
     6101     message
     6102     substitute('!!!При приеме информации с касс &1&2 произошли ошибки!!!'                                   ,p-obj-type                                                                                 ,p-obj-code)  skip
     6103     "!!!Внимательно прочитайте Log-file!!"
     6104     view-as alert-box error .
     6105        define variable v-user-action36   as character no-undo .
     6106     define variable v-printed36       as logical   no-undo .
     6107     run gbl/prnfilen.w
     6108       (input  (substitute('!!!При приеме информации с касс &1&2 произошли ошибки!!!'                                   ,p-obj-type                                                                                 ,p-obj-code))
     6109       ,input  0
     6110       ,input  (string("./":U) + 'get-chkf.log')
     6111       ,input  7
     6112       ,output v-user-action36
     6113       ,output v-printed36
     6114       ) .
     6115   end.
     6116   if v-view-log = true
     6117   and (g#news
     6118   or g#auto)
     6119   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     6120   then do:
     6121      run cb_set-view-log in p-parent-handle ( input yes).
     6122   end.
     6123   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     6124     OS-DELETE value(string("./":U) + 'get-chkf.log').
     6125   end.
     6126                           return "error":U.                  end.
     6127             else undo,  return .
     6128           end.
     6129           for each thbjattr_thbj-attr:
     6130             delete thbjattr_thbj-attr.
     6131           end.
     6132           run adm/shattri.p (
     6133               input "get":U
     6134               ,input  p-obj-type
     6135               ,input  p-obj-code
     6136               ,input  'cd-type-omron':U
     6137               ,input  '':U
     6138               ,output v-value-character
     6139               ,output v-value-date
     6140               ,output v-value-decimal
     6141               ,output v-value-integer
     6142               ,output v-value-logical
     6143               ,output v-param-type
     6144               ,INPUT-OUTPUT table-handle v-tth
     6145               ) no-error .
     6146           IF error-status:error then do:
     6147             assign
     6148             v-mes =  substitute(
     6149                                   "Не удалось получить настройки для  POS типа &1 для маг&2"
     6150                                   , cash-desk.pos-type
     6151                                   , p-obj-code).
     6152             run write-log-and-file in p-log-handle (
     6153                   input 1
     6154                 , input log-file-name
     6155                 , input 1
     6156                 , input v-mes).
     6157             v-view-log = yes.
     6158             undo,  return error v-mes.
     6159           end.
     6160           for each thbjattr_thbj-attr where
     6161                   thbjattr_thbj-attr.obj-type = p-obj-type
     6162               and thbjattr_thbj-attr.obj-code = p-obj-code
     6163               and thbjattr_thbj-attr.upper-prop-code =  'cd-type-omron':U
     6164           on error undo, return error :
     6165             case thbjattr_thbj-attr.prop-code :
     6166               when 'omrbase':U then do:
     6167                 assign
     6168                 base-cass = thbjattr_thbj-attr.property-value-integer.
     6169               end.
     6170               when 'omrcurl':U then do:
     6171                 curr-list = thbjattr_thbj-attr.property-value-character.
     6172               end.
     6173               when 'omrpayl':U then do:
     6174                 pay-list = thbjattr_thbj-attr.property-value-character.
     6175               end.
     6176               when 'omrnal':U then do:
     6177                 nal = thbjattr_thbj-attr.property-value-integer.
     6178               end.
     6179               when 'omrntnl':U then do:
     6180                 not-nal = thbjattr_thbj-attr.property-value-integer.
     6181               end.
     6182             end case.
     6183           end.
     6184           assign
     6185           right-curs = ( if  base-cass = 0 then yes else no ) .
     6186           if search( out + 'spl.dat' ) = ? then do:
     6187                     output to value( out + 'spl.dat' ) convert target "ibm866".
     6188                     put unformatted '<' spl '>'.
     6189                     output close.
     6190             end.
     6191             else do:
     6192               v-mes = "Не могу отправить запрос на кассу" .
     6193               run write-log-and-file in p-log-handle (
     6194                   input 1
     6195                 , input log-file-name
     6196                 , input 1
     6197                 , input v-mes).
     6198               v-view-log = yes.
     6199                 message v-mes.
     6200                 return error.
     6201             end.
     6202             FOR EACH for-cash-desk NO-LOCK WHERE
     6203                     for-cash-desk.db-num = g#db-num and
     6204                     for-cash-desk.pos-type = cash-desk.pos-type AND
     6205                     for-cash-desk.obj-code = p-obj-code AND
     6206                     for-cash-desk.cash-on  = yes:
     6207               assign
     6208               v-versiond = decimal(for-cash-desk.version)
     6209               no-error .
     6210               if error-status:error
     6211               or v-versiond < 0 then do:
     6212                   assign
     6213                   v-mes = substitute("Неверное значение поля <ВЕРСИЯ> &1 для кассы № &2 типа &3 в справочнике касс&4" +
     6214                               "Значение версии может быть только десятичным числом > 0"
     6215                               ,for-cash-desk.version
     6216                               ,for-cash-desk.cash-num
     6217                               ,'OMRON-NEW':U
     6218                               ,chr(10)
     6219                               ).
     6220                 run write-log-and-file in p-log-handle (
     6221                   input 1
     6222                 , input log-file-name
     6223                 , input 1
     6224                 , input v-mes).
     6225                 v-view-log = yes.
     6226                   undo,  return error v-mes.
     6227               end.
     6228               output to value( out + 'spl.adr' ) convert target "ibm866".
     6229               put ' ' skip(1).
     6230               put unformatted '  ' for-cash-desk.addr-path ' spool' skip.
     6231               kass-list =   kass-list + entry( 4, for-cash-desk.addr-path, '.' ) + ','.
     6232               output close.
     6233               RUN waitp in this-procedure (
     6234                            input p-auto
     6235                           ,input(out + 'spl.dat')
     6236                           ,input ('Чтение данных с кассы ' + for-cash-desk.addr-path)
     6237                           ,input ' Подождите 15 сек '
     6238                           ,input 'Касса не ответила.'
     6239                           ,input 'Касса не ответила. Если Вы уверены, что с ней нет связи нажмите кнопку!'
     6240                           ,input 15
     6241                           ) NO-ERROR .
     6242              if error-stat:error then NEXT _CASH-DESK.
     6243             END .
     6244             run waitp in this-procedure (
     6245                          input p-auto
     6246                         ,input (chr(4) + (in_ + spl) + chr(4) + "fl*")
     6247                         ,input "Прием данных с кассы"
     6248                         ,input "Подождите 15 сек"
     6249                         ,input "Подождите 15 сек"
     6250                         ,input "Подождите 15 сек"
     6251                         ,input 15
     6252                         ) no-error .
     6253             if error-stat:error then NEXT _CASH-DESK.
     6254             run write-log-and-file in p-log-handle (
     6255                   input 1
     6256                 , input log-file-name
     6257                 , input 1
     6258                 , input substitute( "Данные касс &1 &2&3: спул-файлы: &4, архив: &5"
     6259                                     , cash-desk.pos-type
     6260                                     , p-obj-type
     6261                                     , p-obj-code
     6262                                     , (in_ + spl)
     6263                                     , (in_ + spl))
     6264                                               ).
     6265              input stream DirStream from os-dir ( in_ + spl ) .
     6266              REPEAT :
     6267                import stream DirStream file path atr.
     6268                if can-do( "f", atr ) AND substring( file, 1, 2 ) = "fl"
     6269                AND
     6270                can-do( kass-list, substring( file, 3, 1 ) ) then do:
     6271                 run write-log-and-file in p-log-handle (
     6272                       input 1
     6273                     , input log-file-name
     6274                     , input 1
     6275                     , input substitute( "Обработка спул-файла &1"
     6276                                         , path
     6277                                       )
     6278                                                   ).
     6279                 DO trans :
     6280                     if right-curs then
     6281                     run str/get-omrn.p (
     6282                                     input parparentproc
     6283                                   , input p-log-handle
     6284                                   , input p-obj-type
     6285                                   , input p-obj-code
     6286                                   , input v-host-code
     6287                                   , input for-cash-desk.version
     6288                                   , input path
     6289                                   ,input-output v-view-log
     6290                                   ) no-error .
     6291                     else
     6292                     run str/get-omr.p (
     6293                                   input parparentproc
     6294                                   , input p-log-handle
     6295                                   , input p-obj-type
     6296                                   , input p-obj-code
     6297                                   , input v-host-code
     6298                                   , input path
     6299                                   , input-output v-view-log
     6300                                   ) no-error .
     6301                 END .
     6302               end.
     6303             END .
     6304             input stream DirStream close.
     6305           end.
     6306           when 'OMRON-NEW':U then  do:
     6307             for each thbjattr_thbj-attr:
     6308               delete thbjattr_thbj-attr.
     6309             end.
     6310             run adm/shattri.p (
     6311                 input "get":U
     6312                 ,input  p-obj-type
     6313                 ,input  p-obj-code
     6314                 ,input  'cd-type-omron-new':U
     6315                 ,input  '':U
     6316                 ,output v-value-character
     6317                 ,output v-value-date
     6318                 ,output v-value-decimal
     6319                 ,output v-value-integer
     6320                 ,output v-value-logical
     6321                 ,output v-param-type
     6322                 ,INPUT-OUTPUT table-handle v-tth
     6323                 ) no-error .
     6324             IF error-status:error then do:
     6325               assign
     6326               v-mes =  substitute(
     6327                                     "Не удалось получить настройки для  POS типа &1 для маг&2"
     6328                                     , cash-desk.pos-type
     6329                                     , p-obj-code).
     6330                 run write-log-and-file in p-log-handle (
     6331                   input 1
     6332                 , input log-file-name
     6333                 , input 1
     6334                 , input v-mes).
     6335                 v-view-log = yes.
     6336               undo,  return error v-mes.
     6337             end.
     6338             for each thbjattr_thbj-attr where
     6339                     thbjattr_thbj-attr.obj-type = p-obj-type
     6340                 and thbjattr_thbj-attr.obj-code = p-obj-code
     6341                 and thbjattr_thbj-attr.upper-prop-code =  'cd-type-omron-new':U
     6342             on error undo, return error :
     6343               case thbjattr_thbj-attr.prop-code :
     6344                 when 'omrnbase':U then do:
     6345                   assign
     6346                   base-cass = thbjattr_thbj-attr.property-value-integer.
     6347                 end.
     6348                 when 'omrncurl':U then do:
     6349                   curr-list = thbjattr_thbj-attr.property-value-character.
     6350                 end.
     6351                 when 'omrnpayl':U then do:
     6352                   pay-list = thbjattr_thbj-attr.property-value-character.
     6353                 end.
     6354                 when 'omrnnal':U then do:
     6355                   nal = thbjattr_thbj-attr.property-value-integer.
     6356                 end.
     6357                 when 'omrnntnl':U then do:
     6358                   not-nal = thbjattr_thbj-attr.property-value-integer.
     6359                 end.
     6360               end case.
     6361             end.
     6362             _omron-cash-desk:
     6363             FOR EACH for-cash-desk NO-LOCK WHERE
     6364                       for-cash-desk.db-num = g#db-num and
     6365                       for-cash-desk.pos-type = cash-desk.pos-type AND
     6366                       for-cash-desk.obj-code = p-obj-code AND
     6367                       for-cash-desk.cash-on = yes:
     6368                  out = for-cash-desk.addr-path + "out\".
     6369                  output to value( out  + 'spool.adr' ) convert target "ibm866".
     6370                  output close.
     6371                  RUN waitp in this-procedure (
     6372                              input p-auto
     6373                             ,input (out + 'spool.adr')
     6374                             ,input ('Чтение данных с кассы ' + out)
     6375                             ,input ' Подождите 15 сек '
     6376                             ,input 'Касса не ответила.'
     6377                             ,input 'Касса не ответила. Если Вы уверены, что с ней нет связи нажмите кнопку!'
     6378                             ,input 15) NO-ERROR .
     6379                  if error-status:error then  NEXT _OMRON-CASH-DESK.
     6380             END .
     6381             run waitp in this-procedure (
     6382                             input p-auto
     6383                            ,input (chr(4) + in_ + chr(4) + "*")
     6384                            ,input "Прием данных с кассы"
     6385                            ,input "Подождите 15 сек"
     6386                            ,input "Подождите 15 сек"
     6387                            ,input "Подождите 15 сек"
     6388                            ,input 15) no-error .
     6389             if error-status:error then.
     6390             FOR EACH for-cash-desk NO-LOCK WHERE
     6391                     for-cash-desk.db-num = g#db-num and
     6392                     for-cash-desk.pos-type = cash-desk.pos-type AND
     6393                     for-cash-desk.obj-code = p-obj-code AND
     6394                     for-cash-desk.cash-on = yes:
     6395               in_ = for-cash-desk.addr-path + "in\".
     6396               run write-log-and-file in p-log-handle (
     6397                     input 1
     6398                   , input log-file-name
     6399                   , input 1
     6400                   , input substitute( "Чеки касс &1 &2&3: спул-файлы: &4, архив: &5"
     6401                                       , cash-desk.pos-type
     6402                                       , p-obj-type
     6403                                       , p-obj-code
     6404                                       , in_
     6405                                       , (in_ + "\sav\":U))
     6406                                                 ).
     6407               input stream DirStream from os-dir (in_).
     6408               REPEAT :
     6409                   import stream DirStream file path atr.
     6410                   if can-do( "f", atr ) then do:
     6411                       run write-log-and-file in p-log-handle (
     6412                             input 1
     6413                           , input log-file-name
     6414                           , input 1
     6415                           , input substitute( "Обработка спул-файла &1"
     6416                                               , path
     6417                                             )
     6418                                                         ).
     6419                       DO trans:
     6420                           run str/get-omrn.p (
     6421                                           input parparentproc
     6422                                         , input p-log-handle
     6423                                         , input p-obj-type
     6424                                         , input p-obj-code
     6425                                         , input v-host-code
     6426                                         , input for-cash-desk.version
     6427                                         , input path
     6428                                         ,input-output v-view-log
     6429                                         ) no-error .
     6430                       END .
     6431                   end.
     6432                END .
     6433                input stream DirStream close.
     6434             END .
     6435           end.
     6436           when 'IPC-Servis+':U then do:
     6437             for each thbjattr_thbj-attr:
     6438               delete thbjattr_thbj-attr.
     6439             end.
     6440             run adm/shattri.p (
     6441                 input "get":U
     6442                 ,input  p-obj-type
     6443                 ,input  p-obj-code
     6444                 ,input  'cd-type-ipc-servispl':U
     6445                 ,input  '':U
     6446                 ,output v-value-character
     6447                 ,output v-value-date
     6448                 ,output v-value-decimal
     6449                 ,output v-value-integer
     6450                 ,output v-value-logical
     6451                 ,output v-param-type
     6452                 ,INPUT-OUTPUT table-handle v-tth
     6453                 ) no-error .
     6454             IF error-status:error then do:
     6455               assign
     6456               v-mes =  substitute(
     6457                                     "Не удалось получить настройки для  POS типа &1 для маг&2"
     6458                                     , cash-desk.pos-type
     6459                                     , p-obj-code).
     6460                 run write-log-and-file in p-log-handle (
     6461                   input 1
     6462                 , input log-file-name
     6463                 , input 1
     6464                 , input v-mes).
     6465                 v-view-log = yes.
     6466               undo,  return error v-mes.
     6467             end.
     6468             for each thbjattr_thbj-attr where
     6469                     thbjattr_thbj-attr.obj-type = p-obj-type
     6470                 and thbjattr_thbj-attr.obj-code = p-obj-code
     6471                 and thbjattr_thbj-attr.upper-prop-code =  'cd-type-ipc-servispl':U
     6472             on error undo, return error :
     6473               case thbjattr_thbj-attr.prop-code :
     6474                 when 'ipcspayn':U then do:
     6475                   assign
     6476                   pay-nal = thbjattr_thbj-attr.property-value-integer.
     6477                 end.
     6478                 when 'ipcsbasc':U then do:
     6479                    base-cass = thbjattr_thbj-attr.property-value-integer.
     6480                 end.
     6481                 when 'ipcsccrd':U then do:
     6482                   cass-card = thbjattr_thbj-attr.property-value-character.
     6483                 end.
     6484                 when 'ipcstcrd':U then do:
     6485                   trade-card = thbjattr_thbj-attr.property-value-character.
     6486                 end.
     6487                 when 'ipcscurc':U then do:
     6488                   curr-card = thbjattr_thbj-attr.property-value-character.
     6489                 end.
     6490               end case.
     6491             end.
     6492             cycle = no.
     6493             FOR EACH for-cash-desk NO-LOCK WHERE
     6494                   for-cash-desk.db-num = g#db-num and
     6495                   for-cash-desk.pos-type = cash-desk.pos-type AND
     6496                   for-cash-desk.obj-code = p-obj-code AND
     6497                   for-cash-desk.cash-on = yes:
     6498               DO jj = 1 TO 2 :
     6499                 if jj = 1
     6500                 then in_ = for-cash-desk.addr-path + "out\tmp" .
     6501                 else do:
     6502                     FOR EACH chk_doc :
     6503                         delete chk_doc.
     6504                     END .
     6505                     in_ = for-cash-desk.addr-path + "out".
     6506                 end.
     6507                 run write-log-and-file in p-log-handle (
     6508                       input 1
     6509                     , input log-file-name
     6510                     , input 1
     6511                     , input substitute( "Чеки касс &1 &2&3: спул-файлы: &4, архив: &5"
     6512                                         , cash-desk.pos-type
     6513                                         , p-obj-type
     6514                                         , p-obj-code
     6515                                         , in_
     6516                                         , in_
     6517                                                   )).
     6518                 input stream DirStream from os-dir (in_).
     6519                 REPEAT :
     6520                   import stream DirStream file path atr.
     6521                   if can-do( "f", atr ) then  do:
     6522                     if num-entries(file, ".") < 2 THEN NEXT.
     6523                     IF NOT can-do("del,dat,ret":U, entry(2, file, ".")) then NEXT.
     6524                     if entry(1, file, ".") = "cashdcrd" or
     6525                         entry(1, file, ".") = "cashcmnt" then NEXT.
     6526                     if jj = 2 AND  entry(1, file, ".") <> "cashsail":U then  NEXT .
     6527                     run write-log-and-file in p-log-handle (
     6528                           input 1
     6529                         , input log-file-name
     6530                         , input 1
     6531                         , input substitute( "Обработка спул-файла &1"
     6532                                             , path
     6533                                           )
     6534                                                       ).
     6535                     DO TRANS :
     6536                       run str/get-ipcs.p (
     6537                                   input parparentproc
     6538                                 , input p-log-handle
     6539                                 , input p-obj-type
     6540                                 , input p-obj-code
     6541                                 , input v-host-code
     6542                                 , in_
     6543                                 , input path
     6544                                 , input file
     6545                                 , input-output v-view-log
     6546                                 ) no-error .
     6547                     END .
     6548                   end.
     6549                 END .
     6550                 input stream DirStream close.
     6551               END .
     6552             END .
     6553           end.
     6554         when 'NCR-GM':U
     6555         or when 'NCR-AS@R':U
     6556         then  do:
     6557           run str/get-inis.p (
     6558                            input p-obj-type
     6559                          , input p-obj-code
     6560                          , input cash-desk.pos-type
     6561                          , input cash-desk.remote
     6562                          , input "get":U
     6563                          , output out
     6564                          , output out2
     6565                          , output in_
     6566                          , output spl
     6567                          , output sav
     6568                          , output yestr
     6569                          )  no-error .
     6570           if error-status:error then do:
     6571             run write-log-and-file in p-log-handle (
     6572                   input 1
     6573                 , input log-file-name
     6574                 , input 1
     6575                 , input substitute(
     6576                                   "!!!Не удалось получить настройки для  POS типа &1 для маг&2 из ini-файла:&3&4 &5"
     6577                                   , cash-desk.pos-type
     6578                                   , p-obj-code
     6579                                   , chr(10)
     6580                                   , error-status:get-message(1)
     6581                                   , return-value
     6582                                   )).
     6583               v-view-log = yes.
     6584               undo, return.
     6585           end.
     6586           if yestr <> ? and search( yestr + 'hocidc.001' ) <> ? then do:
     6587             run write-log-and-file in p-log-handle (
     6588                   input 1
     6589                 , input log-file-name
     6590                 , input 1
     6591                 , input substitute( "Чеки касс &1 &2&3: спул-файлы: &4, архив: &5"
     6592                                     , cash-desk.pos-type
     6593                                     , p-obj-type
     6594                                     , p-obj-code
     6595                                     , yestr
     6596                                     , (in_ + sav + "\"))
     6597                                               ).
     6598             run write-log-and-file in p-log-handle (
     6599                   input 1
     6600                 , input log-file-name
     6601                 , input 1
     6602                 , input substitute( "Обработка спул-файла &1"
     6603                                     , (yestr + "HOCIDC.001":U)
     6604                                   )
     6605                                               ).
     6606             run str/get-ncr.p (
     6607                           input parparentproc
     6608                         , input p-log-handle
     6609                         , input p-obj-type
     6610                         , input p-obj-code
     6611                         , input v-host-code
     6612                         , input cash-desk.pos-type
     6613                         , input cash-desk.version
     6614                         , input (yestr + "HOCIDC.001":U)
     6615                         , input-output v-view-log
     6616                         ) no-error .
     6617             os-append
     6618             value( yestr + "HOCIDC.001":U )
     6619             value( in_ + sav + "\" + string( day( today ), "99" ) + "_" +
     6620             string( month( today ), "99" ) + "_" +
     6621             string( year( today ) modulo 100, "99" ) + ".spl" ) .
     6622             os-delete value( yestr + "HOCIDC.001":U ) .
     6623             next _cash-desk.
     6624           end.
     6625           if search( out + 'spl.dat' ) = ? then  do:
     6626             output to value( out + 'spl.da0' ) convert target "ibm866".
     6627             put unformatted '<' spl '>'.
     6628             output close.
     6629           end.
     6630           else do:
     6631             run write-log-and-file in p-log-handle (
     6632                   input 1
     6633                 , input log-file-name
     6634                 , input 1
     6635                 , input substitute(
     6636                                   "!!!Не могу отправить запрос на сервер NCR маг&1" +
     6637                                   "Возможно, в каталоге &2&3" +
     6638                                   "остался файл spl.dat&3" +
     6639                                   "предыдущего недошедшего до кассы запроса - УДАЛЯЕТСЯ..."
     6640                                   , p-obj-code
     6641                                   , out
     6642                                   , chr(10)
     6643                                   )).
     6644             assign
     6645             v-view-log = yes.
     6646             OS-DELETE value( out + 'spl.da0' ) .
     6647             OS-DELETE value( out + 'spl.dat' ) .
     6648             output to value( out + 'spl.da0' ) convert target "ibm866".
     6649             put unformatted '<' spl '>'.
     6650             output close.
     6651           end.
     6652           OS-RENAME VALUE(out + 'spl.da0') VALUE(out + 'spl.dat').
     6653           os-er = OS-ERROR.
     6654           if os-er <> 0 then do:
     6655             run write-log-and-file in p-log-handle (
     6656                   input 1
     6657                 , input log-file-name
     6658                 , input 1
     6659                 , input substitute(
     6660                                   "!!!Ошибки при записи файлов запроса на маг&1 по адресу &2&3" +
     6661                                   "Ошибки в работе локальной сети или нарушение прав доступа!"
     6662                                   , p-obj-code
     6663                                   , (out + 'spl.dat')
     6664                                   , chr(10)
     6665                                   )).
     6666             v-view-log = yes.
     6667             undo, return.
     6668           end.
     6669           RUN waitp in this-procedure (
     6670                input p-auto
     6671               ,input (out + 'spl.dat')
     6672               ,input 'Чтение данных с сервера NCR'
     6673               ,input ' Подождите 15 сек '
     6674               ,input 'Сервер не ответил.'
     6675               ,input 'Сервер не ответил. Если Вы уверены, что с сервером нет связи нажмите кнопку!'
     6676               ,input 15)
     6677               NO-ERROR .
     6678           if error-status:error then do:
     6679             next _cash-desk.
     6680           end.
     6681           run waitp in this-procedure (
     6682                        input p-auto
     6683                       ,input (chr(4) + IN_ + SPL + chr(4) + (if spl = "":U then "":U else "\":U) + "HOCIDC.001":U)
     6684                       ,input "Прием данных с кассы"
     6685                       ,input "Подождите 20 сек"
     6686                       ,input "Подождите 20 сек"
     6687                       ,input "Подождите 20 сек"
     6688                       ,input 20
     6689                       ) no-error .
     6690           if error-status:error then  NEXT _cASH-DESK.
     6691           run write-log-and-file in p-log-handle (
     6692                 input 1
     6693               , input log-file-name
     6694               , input 1
     6695               , input substitute( "Чеки касс &1 &2&3: спул-файлы: &4, архив: &5"
     6696                                   , cash-desk.pos-type
     6697                                   , p-obj-type
     6698                                   , p-obj-code
     6699                                   , (IN_ + SPL + (if spl = "":U then "":U else "\":U))
     6700                                   , (in_ + sav + "\"))
     6701                                             ).
     6702           if search( IN_ + SPL + (if spl = "":U then "":U else "\":U) + "HOCIDC.001":U ) = ? then NEXT _cash-desk.
     6703             run write-log-and-file in p-log-handle (
     6704                   input 1
     6705                 , input log-file-name
     6706                 , input 1
     6707                 , input substitute( "Обработка спул-файла &1"
     6708                                     , (IN_ + SPL + (if spl = "":U then "":U else "\":U) + "HOCIDC.001":U)
     6709                                   )
     6710                                               ).
     6711           run str/get-ncr.p (
     6712                          input parparentproc
     6713                         , input p-log-handle
     6714                         , input p-obj-type
     6715                         , input p-obj-code
     6716                         , input v-host-code
     6717                         , input cash-desk.pos-type
     6718                         , input cash-desk.version
     6719                         , input (IN_ + SPL + (if spl = "":U then "":U else "\":U) + "HOCIDC.001":U)
     6720                         , input-output v-view-log
