      146   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      147   define variable v-waitfram-action01         as character   no-undo .
      148   define variable v-waitfram-action02         as character   no-undo .
      149   define variable v-waitfram-action03         as character   no-undo .
      150   define variable mWaitFramTextBeg            as character   no-undo.
      151   define variable mWaitFramTextEnd            as character   no-undo.
      152   define variable mWaitFramView               as logical     no-undo.
      153   define variable mWaitProcEvent              as logical     no-undo init yes.
      154   define variable mWaitFramInterval           as integer     no-undo init 1 .
      155   define variable mWaitFramStop               as logical     no-undo.
      156   define variable mWaitFramStopUser           as logical     no-undo.
      157   define variable mWaitFramStopTimeOut        as logical     no-undo.
      158   define variable mWaitFramStartProc          as datetime-tz no-undo.
      159   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      160   define button B-WaitFramStop auto-end-key
      161        label "Стоп"
      162        size 10 by 1 tooltip "Остоновить процесс".
      163   define button B-viewProcInfo
      164        label "Информация"
      165        size 15 by 1 tooltip "Информация о процесс".
      166   define frame waitfram
      167     v-waitfram-action01 format "x(72)" no-label skip
      168     v-waitfram-action02 format "x(72)" no-label skip
      169     v-waitfram-action03 format "x(72)" no-label skip
      170     B-viewProcInfo
      171     B-WaitFramStop at row 4 col 30
      172     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      173     .
      174   define new global shared variable mBatchMode as logical no-undo init ?.
      175   define variable mFramBachModHandle as handle no-undo.
      176   mFramBachModHandle = frame waitfram:handle.
      177   define variable mFameOldVis as logical no-undo.
      178   define variable mVisCUrentVin as logical no-undo.
      179   if session:batch-mode
      180   then
      181      mBatchMode = yes.
      182   if mBatchMode = ? then do:
      183     mVisCUrentVin = current-window:visible.
      184     mFameOldVis = mFramBachModHandle:visible.
      185     mFramBachModHandle:visible  = yes.
      186     mBatchMode = mFramBachModHandle:visible ne yes.
      187     mFramBachModHandle:visible = mFameOldVis.
      188     current-window:visible = mVisCUrentVin.
      189   end.
      190    if  log-manager:logfile-name ne ?
      191     then DO:
      192         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      193         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      194         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      195     end.
      196   on choose of B-WaitFramStop in frame waitfram
      197   do:
      198     mWaitFramStop = yes.
      199     mWaitFramStopUser = yes.
      200   end.
      201   function waitfram-check-timeout returns logical():
      202      define variable vtime as int64 no-undo.
      203      if mWaitFramStopTimeOut
      204      then
      205         return yes.
      206      vtime = ( now - mWaitFramStartProc ) / 1000 .
      207      if     mWaitFramTimeOut ne ?
      208         and mWaitFramTimeOut ne 0
      209         and mWaitFramTimeOut lt vtime
      210      then do:
      211         mWaitFramStopTimeOut = yes.
      212      end.
      213      return mWaitFramStopTimeOut.
      214   end.
      215   procedure waitfram-hide :
      216     if not session:batch-mode
      217     then do
      218     on error undo, return error return-value
      219     :
      220       pause 0 before-hide .
      221       if not mBatchMode then
      222         hide frame waitfram .
      223     if     not mWaitFramView
      224        and mWaitProcEvent
      225     then
      226       process events .
      227     end.
      228   end procedure.
      229   procedure waitfram-show :
      230     define input  parameter p-message as character no-undo .
      231     define variable v-left-margin as integer   no-undo .
      232     if not session:batch-mode
      233     then do
      234     on error undo, return error return-value
      235     :
      236       if length(p-message) <= 70 then do:
      237         assign
      238           v-left-margin = integer((70 - length(p-message)) / 2)
      239         .
      240         assign
      241           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      242         .
      243         assign
      244           v-waitfram-action01 = " "
      245           v-waitfram-action02 = " "
      246                                    + fill(" ", v-left-margin)
      247                                    + p-message
      248           v-waitfram-action03 = " "
      249         .
      250       end.
      251       else do:
      252         define variable vRindex1 as integer no-undo.
      253         define variable vRindex2 as integer no-undo.
      254         vRindex1 = r-index(p-message," ",70).
      255         if vRindex1 = 0
      256         then
      257            vRindex1 = 70.
      258         if length(p-message)  <= vRindex1 + 70 then do:
      259           assign
      260             v-waitfram-action01 = " "
      261             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      262             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      263           .
      264         end.
      265         else do:
      266           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      267           if vRindex2 <= vRindex1
      268           then
      269              vRindex2 = vRindex1 + 70.
      270           assign
      271             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      272             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      273             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      274           .
      275         end.
      276       end.
      277       B-viewProcInfo:visible   in frame waitfram = no.
      278       B-viewProcInfo:sensitive in frame waitfram = no.
      279       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      280       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      281       if  (   mWaitFramView
      282          or  mWaitProcEvent)
      283          and not mBatchMode
      284       then
      285          display
      286             v-waitfram-action01 skip
      287             v-waitfram-action02 skip
      288             v-waitfram-action03 skip
      289          with frame waitfram .
      290       if     mWaitFramView
      291          then do:
      292             if     mWaitFramInterval ne ?
      293                and not mBatchMode
      294             then
      295                wait-for go of frame waitfram pause mWaitFramInterval.
      296          end.
      297          else
      298             if     mWaitProcEvent
      299                and not mBatchMode
      300             then
      301                process events .
      302     end.
      303   end procedure.
      304      procedure waitfram-show-this:
      305         define input  parameter iInterval as int64 no-undo.
      306         define variable vtime as int64 no-undo.
      307         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      308         mWaitFramInterval = iInterval.
      309         run waitfram-show (substitute("&1&2 &3&4" ,
      310                                       mWaitFramTextBeg ,
      311                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      312                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      313                                       mWaitFramTextEnd
      314                                      )
      315                           ).
      316      end.
      317      procedure WaitFramRunPause:
      318         define input  parameter iInterval as dec no-undo.
      319         define variable vStart  as datetime-tz no-undo.
      320         define variable vend    as datetime-tz no-undo.
      321         define variable vint as int64 no-undo.
      322         define variable vOk as logical no-undo.
      323         vStart = now.
      324         vend   = vStart.
      325         publish "WaitFramPause" (iInterval,output vOk).
      326         vend   =  now.
      327         vint = vend - vStart.
      328         vint = iInterval - vint / 1000.
      329         if     not mWaitFramStop
      330            and (   vint > 0
      331                 or (    not vOk
      332                     and iInterval eq ?
      333                     )
      334                 )
      335         then
      336            run waitfram-show-this (iInterval).
      337         vend   =  now.
      338         vint = vend - vStart.
      339         vint = iInterval - vint / 1000.
      340         if     not mWaitFramStop
      341            and vint > 0
      342         then do:
      343            run gbl/pause.p (vint * 1000).
      344         end.
      345         if iInterval ne ?
      346         then
      347            publish "WaitFramStop".
      348         waitfram-check-timeout().
      349      end.
      350      procedure WaitFramWaitFor:
      351         define input  parameter iInterval as dec no-undo.
      352         assign
      353            mWaitFramStartProc   = now
      354            mWaitFramStopUser    = no
      355            mWaitFramStopTimeOut = no
      356         .
      357         block-wait:
      358         do while not mWaitFramStop:
      359            run WaitFramRunPause (iInterval).
      360            if  waitfram-check-timeout()
      361            then do:
      362               leave block-wait.
      363            end.
      364         end.
      365         run waitfram-hide.
      366      end.
      367   procedure waitfram-join :
      368     define input  parameter p-line-1  as character no-undo .
      369     define input  parameter p-line-2  as character no-undo .
      370     define input  parameter p-line-3  as character no-undo .
      371     define output parameter p-message as character no-undo .
      372     do
      373     on error undo, return error return-value
      374     :
      375       assign
      376         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      377                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      378                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      379       .
      380     end.
      381   end procedure.
      382   function waitfram-join-function returns character
      383     (input p-line-1 as character
      384     ,input p-line-2 as character
      385     ,input p-line-3 as character
      386     ).
      387     define variable v-message as character no-undo .
      388     run waitfram-join in this-procedure
      389       (input  p-line-1
      390       ,input  p-line-2
      391       ,input  p-line-3
      392       ,output v-message
      393       ) .
      394     return v-message .
      395   end function .
      396   define variable mHSocket       as handle      no-undo.
      397   define variable mWebRespHead   as longchar    no-undo.
      398   define variable mWebResp       as longchar    no-undo.
      399   define variable mWebRespMptr   as memptr      no-undo.
      400   define variable OerrMsg        as character   no-undo.
      401   define variable mFileLogSocet  as character   no-undo.
      402   define variable mReturnHttp    as logical     no-undo.
      403   define variable mAddTimeOut    as logical     no-undo init yes.
      404   define variable mSocetBegTime  as datetime-tz no-undo.
      405   define variable mSocetEndTime  as dec         no-undo.
      406   define variable mWriteRespFile as character   no-undo.
      407   define variable mTypeResponse  as character   no-undo init "POST".
      408   publish "getSocetLog" (output mFileLogSocet).
      409   if
      410      (   mFileLogSocet eq ""
      411       or mFileLogSocet eq ?)
      412      and session:debug-alert
      413   then
      414      mFileLogSocet = "socet.log".
      415   procedure ConectSocet:
      416      define input  parameter iHost       as character no-undo.
      417      define input  parameter iPort       as character no-undo.
      418      define input  parameter iUrl        as character no-undo.
      419      define input  parameter iPostData   as longchar  no-undo.
      420      define input  parameter iReturnType as character no-undo.
      421      define input  parameter iTimeOut    as decimal   no-undo.
      422      define input  parameter iSilent     as logical   no-undo.
      423      define input  parameter iTextWait   as character no-undo.
      424      mWaitFramTextBeg = iTextWait.
      425      run SendReqSocet (iHost, iPort, iUrl, iPostData, iReturnType, 'getResponse').
      426      if OerrMsg eq ""
      427      then
      428         run waitrespsocet (iTimeOut, iSilent, iTextWait).
      429      mSocetEndTime = (now - mSocetBegTime) / 1000.
      430   end.
      431   procedure SendReqSocet:
      432      define input  parameter iHost            as character no-undo.
      433      define input  parameter iPort            as character no-undo.
      434      define input  parameter iUrl             as character no-undo.
      435      define input  parameter iPostData        as longchar  no-undo.
      436      define input  parameter iReturnType      as character no-undo.
      437      define input  parameter iProcGetResponse as character no-undo.
      438      mSocetBegTime = now.
      439      run writeLogSocet in this-procedure (substitute("Подключаемся к адресу &1 по порту &2",iHost,iPort )).
      440      assign
      441         mWebResp         = ""
      442         mWebResphead     = ""
      443         OerrMsg          = ""
      444         mReturnHttp      = iReturnType eq "xml" or iReturnType eq "http" or iReturnType eq "yes"
      445         iProcGetResponse = "getResponse"  when iProcGetResponse eq ? or iProcGetResponse eq ""
      446      .
      447      define variable vPostData as longchar                       no-undo.
      448      if    iHost eq ""
      449         or iHost eq ?
      450      then do:
      451         oErrMsg = substitute("Не задан host &1 или port &2.", ihost ,iport).
      452         run writeLogSocet in this-procedure (oErrMsg).
      453         return oErrMsg.
      454      end.
      455      run waitfram-show (substitute("Подключаемся к адресу &1 по порту &2",iHost,iPort )).
      456      create socket mHSocket.
      457      mHSocket:connect('-H ' + iHost + ' -S ' + iPort) no-error.
      458      if mHSocket:connected() = false
      459      then do:
      460         run waitfram-hide .
      461         oErrMsg = substitute( "Не удалось установить соединение: &1" , error-status:get-message(1)).
      462         run writeLogSocet in this-procedure (oErrMsg).
      463         delete object mHSocket.
      464         return oErrMsg.
      465      end.
      466      run waitfram-show ("Отправка данных").
      467      mHSocket:set-read-response-procedure(iProcGetResponse).
      468      run PostRequest (
      469       input iUrl,
      470       input iHost + ":" + iPort,
      471       input iPostData
      472       ).
      473       run waitfram-hide .
      474   end.
      475   procedure WaitRespSocet:
      476      define input  parameter iTimeOut   as decimal   no-undo.
      477      define input  parameter iSilent    as logical   no-undo.
      478      define input  parameter iTextWait  as character no-undo.
      479      if    not valid-handle (mHSocket )
      480      then do:
      481         run writeLogSocet in this-procedure (substitute("Потерян объект соединения")).
      482         return "End connected".
      483      end.
      484      if mHSocket:connected() = false
      485      then do:
      486         run writeLogSocet in this-procedure (substitute("Соединение было разорвано другой стороной WaitRespSocet")).
      487         oErrMsg = "Not connected".
      488         return oErrMsg.
      489      end.
      490      mWaitFramView = if iSilent ne yes then yes else no.
      491      mWaitFramTextBeg = iTextWait.
      492      mWaitFramTimeOut = iTimeOut.
      493      mWaitFramTextEnd = "".
      494      mWaitFramStop = no.
      495      if mAddTimeOut
      496      then do:
      497         mWaitFramTimeOut = 300.
      498         run writeLogSocet in this-procedure (substitute ("Таймаут увеличен до &1 при уcтановке соодинения",mWaitFramTimeOut)).
      499      end.
      500      run writeLogSocet in this-procedure (substitute("Ожидаем ответ TimeOut &1 сек.",iTimeOut )).
      501      subscribe   to "WaitFramStop" anywhere run-procedure "WaitRespTestStop".
      502      run WaitFramWaitFor(1).
      503      unsubscribe "WaitFramStop".
      504      if mWaitFramStopUser
      505      then do:
      506         OerrMsg = substitute("Операция прервана пользователем." ).
      507         run writeLogSocet in this-procedure (OerrMsg).
      508      end.
      509      else if mWaitFramStopTimeOut
      510      then do:
      511         OerrMsg = substitute("Привышено время ожидания &1 сек. Ответ не получен.",iTimeOut ).
      512         run writeLogSocet in this-procedure (OerrMsg).
      513      end.
      514      run waitfram-hide .
      515      mHSocket:disconnect() no-error.
      516      delete object mHSocket.
      517   end.
      518   procedure WaitRespTestStop:
      519      if mWaitFramStopTimeOut
      520      then
      521         return.
      522      if     (mWebResp ne ""
      523          and mWebResp ne ?)
      524      then do:
      525         mWaitFramStop = yes.
      526         return.
      527      end.
      528      else if mHSocket:connected() = false
      529      then do:
      530         mWaitFramStop = yes.
      531         run writeLogSocet in this-procedure (substitute("Соединение было разорвано другой стороной WaitRespTestStop")).
      532         oErrMsg = "Not connected".
      533         return oErrMsg.
      534      end.
      535      wait-for read-response of mHSocket pause 0.001.
      536   end.
      537   procedure PostRequest:
      538      define input parameter iPostUrl  as char.
      539      define input parameter iPostHost as char.
      540      define input parameter iPostData as longchar.
      541      define variable vCRequest      as longchar.
      542      define variable vMRequest       as memptr.
      543      if iPostUrl ne ?
      544      then do:
      545         vCRequest =substitute(
      546         '&5 /&2 HTTP/1.1&1'                                   +
      547         'Host: &4&1'                                           +
      548         'User-Agent: Apache-HttpClient/4.1.1 (java 1.5)&1'    +
      549         'Accept: */*&1' +
      550         'Content-Type: text/xml&1'               +
      551         'Content-Length: &3&1'                                  +
      552         '&1'
      553         ,
      554         chr(13) + chr(10),
      555         iPostUrl,
      556         length(iPostData),
      557         iPostHost,
      558         mTypeResponse) + iPostData.
      559      end.
      560      else
      561         vCRequest = iPostData.
      562      run writeLogSocet in this-procedure (substitute("Отправляем запрос &1.",chr(13) + chr(10) )).
      563      run writeLogSocet in this-procedure (vCRequest).
      564      SET-SIZE(vMRequest)            = 0.
      565      SET-SIZE(vMRequest)            = length(vCRequest) + 1.
      566      SET-BYTE-ORDER(vMRequest)      = big-endian.
      567      PUT-STRING(vMRequest,1)        = vCRequest .
      568      if mHSocket:connected() = false then
      569      do:
      570         run writeLogSocet in this-procedure ("Соединение было разорвано другой стороной getResponse").
      571         oErrMsg = "Not connected".
      572         delete object mHSocket no-error.
      573         return oErrMsg.
      574      end.
      575      mHSocket:write(vMRequest, 1, length(vCRequest)).
      576      run writeLogSocet in this-procedure ("Запрос отправлен.").
      577   end procedure.
      578   function hex-to-int returns integer (
      579     input p-hex-code  as character  ).
      580     define variable v-int-code as integer   no-undo .
      581     define variable v-ind      as integer   no-undo .
      582     define variable v-digit    as integer   no-undo .
      583     define variable v-letter   as character no-undo .
      584     do v-ind = 1 to length(p-hex-code)
      585     :
      586       assign
      587         v-letter = caps(substring(p-hex-code, v-ind, 1))
      588       .
      589       assign
      590         v-digit = index('123456789ABCDEF':u, v-letter)
      591       .
      592       assign
      593         v-int-code = v-int-code * 16 + v-digit
      594       .
      595     end.
      596     return v-int-code .
      597   end function .
      598   procedure getResponse:
      599      define variable vFlagTag     as logical          no-undo init no.
      600      define variable vResponse    as memptr           no-undo.
      601      define variable vCnt         as int64            no-undo.
      602      define variable vMessage     as longchar         no-undo.
      603      define variable v-cont-length as int64 no-undo.
      604      define variable vi           as integer no-undo.
      605      define variable v-hd-line    as character no-undo.
      606      define variable level        as integer no-undo initial 2.
      607      repeat while program-name(level) <> ?:
      608        if program-name(level) = program-name(1) then do:
      609          run writeLogSocet in this-procedure (substitute("Повторный вызов getResponse.")).
      610          return "".
      611        end.
      612        level = level + 1.
      613      end.
      614      if mHSocket:connected() = false then
      615      do:
      616         run writeLogSocet in this-procedure (substitute("Соединение было разорвано другой стороной getResponse")).
      617         oErrMsg = "Not connected".
      618         return oErrMsg.
      619      end.
      620      if mAddTimeOut
      621      then do:
      622         mWaitFramTimeOut = 1000.
      623         run writeLogSocet in this-procedure (substitute ("Таймаут увеличен до &1 при получении ответа",mWaitFramTimeOut)).
      624      end.
      625      run writeLogSocet in this-procedure (substitute("Получаем ответ")).
      626      mWaitFramTextEnd = "Получаем ответ".
      627      define variable vWaitProcEvent as logical no-undo.
      628      vWaitProcEvent = mWaitProcEvent.
      629      mWaitProcEvent = no.
      630      run WaitFramRunPause (?).
      631      define variable vByte as int64 no-undo.
      632      define variable vNextMese as int64 no-undo init 100000.
      633      define variable VFlag as logical no-undo init ? .
      634      mWaitFramStop = no.
      635      mWaitFramStopTimeOut = no.
      636      block-wait:
      637      do while mHSocket:get-bytes-available() > 0:
      638         VFlag = no.
      639         define variable vNumByte as integer no-undo.
      640         vNumByte =   mHSocket:get-bytes-available().
      641         if vNumByte > 30000 then vNumByte = 30000.
      642         SET-SIZE(vResponse) = vNumByte + 1.
      643         SET-BYTE-ORDER(vResponse) = big-endian.
      644         mHSocket:read(vResponse,1,vNumByte).
      645         vMessage = vMessage + GET-STRING(vResponse,1).
      646         if  mReturnHTTp
      647         then do:
      648            vCnt = index(vMessage,chr(13) + chr(10) + chr(13) + chr(10)).
      649            if vCnt > 0
      650            then do:
      651               mReturnHttp = no.
      652               mWebResphead = substring (vMessage,1,vCnt).
      653               vMessage     = substring (vMessage,vCnt + 4).
      654               mWebResphead = replace (mWebResphead,";",chr(13) + chr(10)).
      655               do vi = 1 to num-entries(mWebResphead,chr(13) + chr(10)):
      656                  v-hd-line = trim(entry(vi,mWebResphead,chr(13) + chr(10))).
      657                  if  v-hd-line  begins "Content-Length"  then  do:
      658                     v-cont-length = INT(trim(substring(v-hd-line,16,length(v-hd-line)))).
      659                  end.
      660                  else if v-hd-line  begins "Transfer-Encoding"
      661                  then do :
      662                     define variable vChunked as logical no-undo.
      663                     vchunked = index(v-hd-line,"chunked",19) > 0.
      664                  end.
      665               end.
      666            end.
      667         end.
      668         vByte = vByte + vNumByte.
      669         SET-SIZE(vResponse) = 0.
      670         if v-cont-length > 0 and length (vMessage) >= v-cont-length
      671         then
      672            leave block-wait.
      673         if not mHSocket:get-bytes-available() > 0
      674         then do:
      675            VFlag = yes.
      676            run WaitFramRunPause (?).
      677            run gbl/pause.p (1000) .
      678         end.
      679         else if vByte > vNextMese
      680         then do:
      681            vNextMese = vNextMese + 100000.
      682            mWaitFramTextEnd = substitute ("Получаем ответ прочитано &1 байт ",vByte) .
      683            run WaitFramRunPause (?).
      684         end.
      685         if mWaitFramStopTimeOut
      686         then do:
      687            mWebResp = "".
      688            leave block-wait.
      689         end.
      690      end.
      691      if VFlag ne false
      692      then
      693         run writeLogSocet in this-procedure (substitute ("Завершена обработка &1",If VFlag eq  yes then " 0 байт за последнию секунду" else " пустой ответ(((")).
      694      mWaitFramStop = yes.
      695      run writeLogSocet         in this-procedure ("Получен ответ").
      696      run writeLogSocetOnlyText in this-procedure (mWebResphead).
      697      run writeLogSocetOnlyText in this-procedure (substitute("&1&2&1&2",chr(13) , chr(10) )).
      698      run writeLogSocetOnlyText in this-procedure (vMessage).
      699      run writeLogSocetOnlyText in this-procedure (substitute("&1&2",chr(13) , chr(10) )).
      700      mHSocket:disconnect() no-error.
      701      if v-cont-length > 0
      702      then
      703         mWebResp = substring (vMessage,1,v-cont-length).
      704      else if vChunked
      705      then do:
      706         define variable vByteCopy as int64 no-undo init 1.
      707         Block-Copy:
      708         do while length(vMessage) > 0:
      709            vByteCopy = 1.
      710            vCnt = index (vMessage,chr(13) + chr(10)) - 1.
      711            vByteCopy = vByteCopy +  vCnt + 2.
      712            v-cont-length = hex-to-int(string(substring (vMessage,1,vCnt))).
      713            if v-cont-length eq 0
      714            then
      715               leave Block-copy.
      716            mWebResp = mWebResp + substring (vMessage,vByteCopy,  v-cont-length).
      717            vByteCopy = vByteCopy + v-cont-length + 2.
      718            vMessage = substring  (vMessage,vByteCopy).
      719         end.
      720         run writeLogSocet         in this-procedure ("Заголовок").
      721         run writeLogSocetOnlyText in this-procedure (mWebResphead).
      722         run writeLogSocet         in this-procedure ("Тело ответа").
      723         run writeLogSocetOnlyText in this-procedure (mWebResp).
      724        run writeLogSocetOnlyText in this-procedure (substitute("&1&2",chr(13) , chr(10) )).
      725      end.
      726      else
      727         mWebResp = vMessage.
      728      mWaitProcEvent = vWaitProcEvent.
      729      mSocetEndTime = (now - mSocetBegTime) / 1000.
      730      copy-lob mWebResp to mWebRespMptr.
      731      if     mWriteRespFile ne ""
      732         and mWriteRespFile ne ?
      733      then
      734           run gbl/fileapnd.p
      735                ( mWriteRespFile
      736                , mWebResp + chr(13) + chr(10)
      737                ,input 10
      738                ) no-error .
      739   end procedure.
      740   procedure writeLogSocet:
      741      define input  parameter itext as longchar no-undo.
      742      if mFileLogSocet eq "Async"
      743      then
      744         run PutMesAsunc(itext).
      745      else if     mFileLogSocet ne ?
      746              and mFileLogSocet ne ""
      747      then do:
      748         run gbl/fileapnd.p
      749             ( mFileLogSocet
      750             , substitute("&1 &2 ", string(today), string(time, "HH:MM:SS"))
      751             ,input 10
      752             ) no-error .
      753         run writeLogSocetOnlyText(itext).
      754         run gbl/fileapnd.p
      755             ( mFileLogSocet
      756             , substitute(" &1&2", chr(13) , chr(10))
      757             ,input 10
      758             ) no-error .
      759      end.
      760   end.
      761   procedure writeLogSocetOnlyText:
      762      define input  parameter itext as longchar no-undo.
      763      if mFileLogSocet eq "Async"
      764      then
      765         run PutMesAsunc(itext).
      766      else if     mFileLogSocet ne ?
      767              and mFileLogSocet ne ""
      768      then do:
      769         if length(itext) > 32000
      770         then
      771            copy-lob
      772      from object itext
      773      to file mFileLogSocet append
      774      no-error
      775      .
      776         else
      777         run gbl/fileapnd.p
      778             ( mFileLogSocet
      779             , string(itext)
      780             ,input 10
      781             ) no-error .
      782      end.
      783   end.
      784   procedure Disconect:
      785      mHSocket:disconnect() no-error.
      786      delete object mHSocket no-error.
      787   end.
      788   run get-view-log in p-log-handle(output v-view-log)  no-error.
      789   define variable i-obj-type as character no-undo .
      790   define variable i-obj-code as integer   no-undo .
      791   define variable i-action   as character no-undo init 'U':U.
      792   define variable i-type     as character no-undo .
      793   define variable i-title     as character no-undo .
      794   define variable i-value    as character no-undo .
      795   if num-entries (p-parameter,chr(4)) < 4
      796   then do:
      797      run write-log-and-file in p-log-handle (
      798           input 1
      799         , input log-file-name
      800         , input 1
      801         , input substitute( "!!!'Send-all' Список параметров должен состоять минимум из 4 элементов "
      802                           )
      803                           ).
      804      run set-view-log in p-log-handle(yes)  no-error.
      805      return.
      806   end.
      807   else do:
      808      define variable vi as integer no-undo.
      809      i-Type    = entry(4, p-parameter, chr(4)).
      810      vi = num-entries (i-Type).
      811      if vi eq 0
      812      then do:
      813         run write-log-and-file in p-log-handle (
      814              input 1
      815            , input log-file-name
      816            , input 1
      817            , input substitute( "!!!'Send-all' В список параметров 4 элемент не может быть пустым "
      818                              )
      819                                    ).
      820         run set-view-log in p-log-handle(yes)  no-error.
      821         return.
      822      end.
      823      else if vi > 1
      824      then do:
      825         do vi = 1 to num-entries (i-type):
      826            entry(4, p-parameter, chr(4)) = entry(vi,i-type).
      827            run str/send-all.p(parparentproc,
      828                               p-parent-handle,
      829                               p-log-handle,
      830                               p-parameter
      831            ).
      832         end.
      833         return.
      834      end.
      835   end.
      836   assign
      837   i-obj-type = entry(1, p-parameter, chr(4))
      838   i-obj-code = integer(entry(2, p-parameter, chr(4)))
      839   i-action     = entry(3, p-parameter, chr(4))
      840   i-Type    = entry(4, p-parameter, chr(4))
      841   i-Title    = entry(5, p-parameter, chr(4))
      842   i-value    = entry(6, p-parameter, chr(4))
      843   no-error
      844   .
      845   if i-Type eq "?"
      846   then
      847      return error "Не задан тип для send-all.p".
      848   define variable mValue   as character no-undo.
      849   define variable mNumPar  as integer no-undo.
      850   define variable mSendAll as logical no-undo.
      851   define variable mCashNum as integer no-undo init ?.
      852   define variable mCashAll as logical no-undo.
      853   define variable mNumCashAll as integer no-undo.
      854   mValue = replace(i-value,",","=").
      855   mNumPar = lookup("cash-send",mValue,"=").
      856   if mNumPar > 0
      857   then do:
      858      mSendAll = entry(mNumPar + 1,mValue,"=") eq "all" no-error.
      859      mCashNum = int(entry(mNumPar + 1,mValue,"=")) no-error.
      860      if mCashNum <> ? and not mSendAll then do:
      861         mNumCashAll = lookup("cash-all",mValue,"=").
      862         if mNumCashAll > 0 then do:
      863             mCashAll = entry(mNumCashAll + 1,mValue,"=") eq "all" no-error.
      864             if mCashNum <> ? and mCashNum <> 0 and mCashAll
      865             then mSendAll = yes.
      866         end.
      867      end.
      868   end.
      869   mNumPar = lookup("SocetLog",mValue,"=").
      870   if mNumPar > 0
      871   then
      872      mFileLogSocet = entry(mNumPar + 1,mValue,"=") no-error.
      873   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      874   procedure   for-cash-cycle:
      875      define variable v-cash-types as character no-undo init 'IBM-XML':U.
      876      define variable V-root-teg   as character no-undo init "data".
      877      define variable v-xml-encoding as character no-undo init "windows-1251".
      878      define variable v-tag-from   as character no-undo.
      879      define variable v-tag-to     as character no-undo.
      880      define variable v-work-handle as handle no-undo .
      881      if     search("str/send-all-work-" + i-type + ".p") eq ?
      882         and search("str/send-all-work-" + i-type + ".r") eq ?
      883      then do:
      884         run write-log-and-file in p-log-handle (
      885               input 1
      886             , input log-file-name
      887             , input 1
      888             , input substitute( "!!!Не найдена str/send-all-work-&1.r"
      889                                   ,i-type
      890                               )
      891                                               ).
      892         v-view-log = yes.
      893         return.
      894      end.
      895      run value ( "str/send-all-work-" + i-type + ".p") persistent set v-work-handle no-error .
      896      if error-status:error then do:
      897         run write-log-and-file in p-log-handle (
      898               input 1
      899             , input log-file-name
      900             , input 1
      901             , input substitute( "!!!Ошибка при выполнение процедуры str/send-all&1.r (&2) : &3 &4"
      902                                   ,i-type
      903                                   ,search("str/send-all" + i-type + ".p")
      904                                   ,return-value
      905                                   ,error-status:get-message (1)
      906                               )
      907                                               ).
      908         v-view-log = yes.
      909         return.
      910      end.
      911      if lookup("get-xml-encoding", v-work-handle:internal-entries) >  0
      912      then do:
      913         run get-xml-encoding  in v-work-handle (output v-xml-encoding) no-error.
      914         if error-status:error then do:
      915            run write-log-and-file in p-log-handle (
      916                  input 1
      917                , input log-file-name
      918                , input 1
      919                , input substitute( "!!!Ошибка при выполнение процедуры &1 (str/send-all&4.r) : &2 &3"
      920                                      ,"get-xml-encoding"
      921                                      ,return-value
      922                                      ,error-status:get-message (1)
      923                                      , i-type
      924                                  )
      925                                                  ).
      926            v-view-log = yes.
      927            return.
      928         end.
      929      end.
      930      if lookup("get-tag-from", v-work-handle:internal-entries) >  0
      931      then do:
      932         run get-tag-from in v-work-handle (output v-tag-from) no-error.
      933         if error-status:error then do:
      934            run write-log-and-file in p-log-handle (
      935                  input 1
      936                , input log-file-name
      937                , input 1
      938                , input substitute( "!!!Ошибка при выполнение процедуры &1 (str/send-all&4.r) : &2 &3"
      939                                      ,"get-teg-from"
      940                                      ,return-value
      941                                      ,error-status:get-message (1)
      942                                      , i-type
      943                                  )
      944                                                  ).
      945            v-view-log = yes.
      946            return.
      947         end.
      948      end.
      949      if lookup("get-tag-to", v-work-handle:internal-entries) >  0
      950      then do:
      951         run get-tag-to in v-work-handle (output v-tag-to) no-error.
      952         if error-status:error then do:
      953            run write-log-and-file in p-log-handle (
      954                  input 1
      955                , input log-file-name
      956                , input 1
      957                , input substitute( "!!!Ошибка при выполнение процедуры &1 (str/send-all&4.r) : &2 &3"
      958                                      ,"get-teg-to"
      959                                      ,return-value
      960                                      ,error-status:get-message (1)
      961                                      , i-type
      962                                  )
      963                                                  ).
      964            v-view-log = yes.
      965            return.
      966         end.
      967      end.
      968      if lookup("get-cash-types", v-work-handle:internal-entries) >  0
      969      then do:
      970         run get-cash-types  in v-work-handle (output v-cash-types) no-error.
      971         if error-status:error then do:
      972            run write-log-and-file in p-log-handle (
      973                  input 1
      974                , input log-file-name
      975                , input 1
      976                , input substitute( "!!!Ошибка при выполнение процедуры &1 (str/send-all&4.r) : &2 &3"
      977                                      ,"get-cash-types"
      978                                      ,return-value
      979                                      ,error-status:get-message (1)
      980                                      , i-type
      981                                  )
      982                                                  ).
      983            v-view-log = yes.
      984            return.
      985         end.
      986      end.
      987      if lookup(ub.cash-desk.pos-type,v-cash-types) ne 0
      988      then do:
      989         if lookup("get-root-teg", v-work-handle:internal-entries) >  0
      990         then do:
      991            run get-root-teg in v-work-handle (output V-root-teg) no-error.
      992            if error-status:error then do:
      993               run write-log-and-file in p-log-handle (
      994                     input 1
      995                   , input log-file-name
      996                   , input 1
      997                   , input substitute( "!!!Ошибка при выполнение процедуры &1 (str/send-all&4.r) : &2 &3"
      998                                         ,"get-roor-teg"
      999                                         ,return-value
     1000                                         ,error-status:get-message (1)
     1001                                         ,i-type
     1002                                     )
     1003                                                     ).
     1004               v-view-log = yes.
     1005               return.
     1006            end.
     1007         end.
     1008         define variable vProcInfo as character no-undo.
     1009         if lookup("set-context", v-work-handle:internal-entries) >  0
     1010         then do:
     1011            run set-context in v-work-handle (parparentproc,
     1012                                              p-log-handle,
     1013                                              log-file-name,
     1014                                              output vProcInfo) no-error.
     1015            if error-status:error then do:
     1016               run write-log-and-file in p-log-handle (
     1017                     input 1
     1018                   , input log-file-name
     1019                   , input 1
     1020                   , input substitute( "!!!Ошибка при выполнение процедуры &1 (str/send-all&4.r) : &2 &3"
     1021                                         ,"set-context"
     1022                                         ,return-value
     1023                                         ,error-status:get-message (1)
     1024                                         ,i-type
     1025                                     )
     1026                                                     ).
     1027               v-view-log = yes.
     1028               return.
     1029            end.
     1030         end.
     1031         run write-log-and-file in p-log-handle (
     1032                           input 1
     1033                         , input log-file-name
     1034                         , input 1
     1035                         , input substitute( 'Обработка запроса &1 на кассы магазина &2 начата'
     1036                                               ,if vProcInfo ne "" then '"' + vProcInfo + '"' else ""
     1037                                               ,i-obj-code
     1038                                           )
     1039                                                           ).
     1040         define buffer for-cash-desk for ub.cash-desk.
     1041         define variable mQuery as handle    no-undo.
     1042         define variable vqry   as character no-undo.
     1043         create query mQuery.
     1044         mQuery:set-buffers(buffer for-cash-desk:HANDLE).
     1045         vqry = substitute("for each for-cash-desk no-lock where
     1046                                     for-cash-desk.db-num   eq &1 
     1047                                 and for-cash-desk.pos-type eq '&2'      
     1048                                 and for-cash-desk.obj-code eq &3 "
     1049                              ,  g#db-num, ub.cash-desk.pos-type,i-obj-code).
     1050         if mCashNum ne ?
     1051         then
     1052            vqry = vqry + substitute(" and for-cash-desk.cash-num eq &1", mCashNum).
     1053         else
     1054            vqry = vqry + " and for-cash-desk.is-del   ne  true
     1055                            and for-cash-desk.autonomy ne 1".
     1056         if not mSendAll
     1057         then
     1058            vqry = vqry + " and for-cash-desk.cash-on  eq yes".
     1059         vqry = vqry + "   
     1060    by for-cash-desk.db-num
     1061    by for-cash-desk.obj-code
     1062    by for-cash-desk.pos-type
     1063    by for-cash-desk.cash-on ".
     1064         mQuery:query-prepare(vqry).
     1065         mQuery:query-open ().
     1066         mQuery:get-first ().
     1067         do while not mQuery:query-off-end:
     1068           if lookup("set-cash-info", v-work-handle:internal-entries) >  0
     1069           then do:
     1070               run set-cash-info in v-work-handle (for-cash-desk.db-num,
     1071                                                   'маг':U,
     1072                                                   for-cash-desk.obj-code,
     1073                                                   for-cash-desk.pos-type,
     1074                                                   for-cash-desk.cash-num) no-error.
     1075               if error-status:error then do:
     1076                  run write-log-and-file in p-log-handle (
     1077                        input 1
     1078                      , input log-file-name
     1079                      , input 1
     1080                      , input substitute( "!!!Ошибка при выполнение процедуры &1 (str/send-all&4.r) : &2 &3"
     1081                                            ,"set-cash-info"
     1082                                            ,return-value
     1083                                            ,error-status:get-message (1)
     1084                                            ,i-type
     1085                                        )
     1086                                                        ).
     1087                 v-view-log = yes.
     1088                 return.
     1089              end.
     1090           end.
     1091           run write-log-and-file in p-log-handle (
     1092                 input 1
     1093               , input log-file-name
     1094               , input 1
     1095               , input substitute( "Пересылка - касса &1", for-cash-desk.cash-num
     1096                                 )
     1097                                                 ).
     1098   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1099   define variable hSAXWriter as handle no-undo.
     1100   define variable Mreq as longchar no-undo.
     1101   define variable mData as memptr no-undo.
     1102   run xml-cd-filename in this-procedure (
     1103         input out
     1104       , output v-xml-file-name
     1105       , output v-xml-file-name-path
     1106       , output v-log-file-name
     1107       , output v-locked
     1108   ).
     1109   create sax-writer hSAXWriter.
     1110   hSAXWriter:set-output-destination("memptr", mData) no-error.
     1111   hSAXWriter:formatted = true.
     1112   hSAXWriter:encoding = v-xml-encoding.
     1113   hSAXWriter:start-document() no-error.
     1114   define variable OS-time as character  no-undo.
     1115   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" ).
     1116   hSAXWriter:start-element(V-root-teg) no-error.
     1117   hSAXWriter:insert-attribute("type",   "REQUEST")       no-error.
     1118   hSAXWriter:insert-attribute("id",     v-xml-file-name) no-error.
     1119   hSAXWriter:insert-attribute("from",   if v-tag-from <> "empty" then substitute ("маг&1", for-cash-desk.cash-num) else "")      no-error.
     1120   hSAXWriter:insert-attribute("to",     if v-tag-to = "" then substitute ("маг&1_касса", for-cash-desk.cash-num) else v-tag-to) no-error.
     1121   hSAXWriter:insert-attribute("tstamp", string(OS-time))     no-error.
     1122           define variable vOk as logical no-undo.
     1123           run putc in v-work-handle
     1124                        ( input hSAXWriter
     1125                         ,i-action
     1126                         ,input i-value
     1127                         ,output vOk
     1128                         ) no-error.
     1129           if error-status:error then do:
     1130                  run write-log-and-file in p-log-handle (
     1131                        input 1
     1132                      , input log-file-name
     1133                      , input 1
     1134                      , input substitute( "!!!Ошибка при выполнение процедуры &1 (str/send-all&4.r) : &2 &3"
     1135                                            ,"putc"
     1136                                            ,return-value
     1137                                            ,error-status:get-message (1)
     1138                                            ,i-type
     1139                                        )
     1140                                                        ).
     1141                 v-view-log = yes.
     1142                 return.
     1143           end.
     1144           if not vOk
     1145           then
     1146              run write-log-and-file in p-log-handle (
     1147                 input 1
     1148               , input log-file-name
     1149               , input 1
     1150               , input substitute( "Запрос данных с кассы не требуется - касса &1", for-cash-desk.cash-num
     1151                                 )
     1152                                                 ).
     1153   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1154   hSAXWriter:end-element(V-root-teg) no-error.
     1155   if error-status:num-messages > 0
     1156   then do:
     1157      define variable vnummes as integer no-undo.
     1158      do vnummes = 1 to error-status:num-messages:
     1159         run write-log-and-file in p-log-handle (
     1160                                     input 1
     1161                                   , input log-file-name
     1162                                   , input 1
     1163                                   , input substitute('Ошибка формироваания запроса &1:'
     1164                                                 ,error-status:get-message (vnummes)
     1165                                               )).
     1166      end.
     1167   end.
     1168   hSAXWriter:end-document() no-error.
     1169   if hSAXWriter:write-status = 7
     1170   then do:
     1171      delete object hSAXWriter no-error.
     1172      return error.
     1173   end.
     1174   delete object hSAXWriter no-error.
     1175   if v-xml-encoding = "Windows-1251" then
     1176      copy-lob from mData to mReq.
     1177   else
     1178      copy-lob from mData to mReq convert target codepage v-xml-encoding.
     1179   if session:debug-alert then
     1180       copy-lob from mReq to file i-Type + "2kassa.xml".
     1181   if
     1182      vOk
     1183   then do:
     1184     if (for-cash-desk.pos-type = 'IBM-XML':U
     1185     and for-cash-desk.autonomy = integer('0':U))
     1186     or (for-cash-desk.pos-type = 'Autotank':U
     1187     and for-cash-desk.autonomy = integer('2':U))
     1188     then do:
     1189        run write-log-and-file in p-log-handle (
     1190                                  input 1
     1191                                , input log-file-name
     1192                                , input 1
     1193                                , input substitute('Отправка данных на кассы &1 &2'
     1194                                              ,for-cash-desk.cash-num
     1195                                              ,for-cash-desk.obj-code
     1196                                            )).
     1197        run ConectSocet (entry(1,entry(2, for-cash-desk.addr-path, chr(4)),":"),
     1198                         entry(2,entry(2, for-cash-desk.addr-path, chr(4)),":"),
     1199                         "",
     1200                         Mreq,
     1201                         "xml",
     1202                         30,
     1203                         no,
     1204                         substitute ("Отправка данных на кассы &1. ",entry(2, for-cash-desk.addr-path, chr(4)))
     1205                                            ).
     1206        if mWebResp eq ""
     1207        then do:
     1208           run write-log-and-file in p-log-handle (
     1209                input 1
     1210              , input log-file-name
     1211              , input 1
     1212              , input substitute( "!!!Касса &1 маг&2 не ответила:&3&4 &5"
     1213                                    ,for-cash-desk.cash-num
     1214                                    ,for-cash-desk.obj-code
     1215                                    , chr(10)
     1216                                    , OerrMsg
     1217                                    , return-value
     1218                                )
     1219                                                ).
     1220           v-view-log = yes.
     1221        end.
     1222        else do:
     1223           run write-log-and-file in p-log-handle (
     1224                                  input 1
     1225                                , input log-file-name
     1226                                , input 1
     1227                                , input substitute('Время ожидания выполнения задания на кассе - &1 c',
     1228                                              mSocetEndTime
     1229                                            )
     1230                                                                  ).
     1231           if lookup("parse-result", v-work-handle:internal-entries) >  0
     1232           then do:
     1233              run parse-result in v-work-handle(
     1234                             input mWebRespMptr
     1235                            ,input-output v-view-log
     1236                            ) no-error .
     1237              if error-status:error then do:
     1238                 run write-log-and-file in p-log-handle (
     1239                     input 1
     1240                   , input log-file-name
     1241                   , input 1
     1242                   , input substitute( "!!!Не удалось получить ответ с маг&1 касса &2 об успешной доставке данных"
     1243                                         ,for-cash-desk.obj-code
     1244                                         ,for-cash-desk.cash-num
     1245                                     )
     1246                                                     ).
     1247                 v-view-log = yes.
     1248              end.
     1249           end.
     1250        end.
     1251     end.
     1252   end.
     1253            mQuery:get-next ().
     1254         end .
     1255         delete object mQuery.
     1256      end.
     1257      run write-log-and-file in p-log-handle (
     1258                        input 1
     1259                      , input log-file-name
     1260                      , input 1
     1261                      , input substitute( 'Обработка запроса &1 на кассы магазина &2 завершена'
     1262                                            ,'"' + vProcInfo + '"'
     1263                                            ,i-obj-code
     1264                                        )
     1265                                                        ).
     1266      if valid-handle(v-work-handle) then do:
     1267         delete procedure v-work-handle  .
     1268       end.
     1269   end procedure.
     1270   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1271   procedure SENDING:
     1272   _cash-desk:
     1273   for each ub.cash-desk no-lock where
     1274            ub.cash-desk.db-num = g#db-num and
     1275            ub.cash-desk.obj-code = i-obj-code and
     1276           (ub.cash-desk.cash-on  = yes or mSendAll)
     1277   break
     1278   by ub.cash-desk.pos-type :
     1279     if first-of(ub.cash-desk.pos-type) then do:
     1280       run for-cash-cycle no-error.
     1281       if error-status:error then do:
     1282         run write-log-and-file in p-log-handle (
     1283               input 1
     1284             , input log-file-name
     1285             , input 1
     1286             , input substitute("&1 &2", error-status:get-message(1), return-value)
     1287                                                 ).
     1288         assign
     1289         v-view-log = yes
     1290         .
     1291       end.
     1292     end.
     1293   end.
     1294   end procedure.
     1295   RUN SENDING no-error.
     1296   if error-status:error then do:
     1297     run write-log-and-file in p-log-handle (
     1298           input 1
     1299         , input log-file-name
     1300         , input 1
     1301         , input substitute( "!!!Ошибки при отсылке '&3' на кассы &1&2"
     1302                            , i-obj-type, i-obj-code, i-Title
     1303                           )
     1304                                           ).
     1305      v-view-log = yes.
     1306   end.
     1307   run set-view-log in p-log-handle(v-view-log) no-error.
