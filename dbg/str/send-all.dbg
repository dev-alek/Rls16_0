       10   define variable vss-archive     as character no-undo init "$Archive: str/send-all.p $":U .
       11   define variable vss-description as character no-undo init "Отсылка схемы интеграции ККТ".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
