        1   block-level on error undo, throw.
        2   define input parameter parparentproc as handle    no-undo .
        3   define input parameter par-type      as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: fibutrn.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: str/fibutrn.p $":U .
        9   define variable vss-description as character no-undo init "Список накладных ФО покупателей".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80     define variable v-cntxt-db-num        as integer   no-undo .
       81     define variable v-cntxt-userid        as character no-undo .
       82     define variable v-cntxt-level         as character no-undo .
       83     define variable v-cntxt-host-code-obj as integer   no-undo .
       84     define variable v-cntxt-obj-type      as character no-undo .
       85     define variable v-cntxt-obj-code      as integer   no-undo .
       86     define variable v-cntxt-db-num-obj    as integer   no-undo .
       87     define variable v-cntxt-is-admin      as logical   no-undo .
       88   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89   define temp-table userobjs_temp-user-obj no-undo
       90     field obj-type as character
       91     field obj-code as integer
       92     index xpk is primary unique obj-type obj-code
       93     .
       94   procedure userobjs_clear :
       95     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
       96     do
       97     on error undo, return error return-value
       98     :
       99       for each buf_userobjs_temp-user-obj
      100       on error undo, return error return-value
      101       :
      102         delete buf_userobjs_temp-user-obj .
      103       end.
      104     end.
      105   end .
      106   procedure userobjs_object-count :
      107     define output parameter p-total-count as integer   no-undo .
      108     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      109     do
      110     on error undo, return error return-value
      111     :
      112       assign
      113         p-total-count = 0
      114       .
      115       for each buf_userobjs_temp-user-obj
      116       on error undo, return error return-value
      117       :
      118         assign
      119           p-total-count = p-total-count + 1
      120         .
      121       end.
      122     end.
      123   end.
      124   procedure userobjs_append :
      125      define input  parameter p-obj-type as character no-undo .
      126      define input  parameter p-obj-code as integer   no-undo .
      127     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      128     do
      129     on error undo, return error return-value
      130     :
      131       find first buf_userobjs_temp-user-obj
      132         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      133           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      134         no-error .
      135       if not available buf_userobjs_temp-user-obj
      136       then do:
      137         create buf_userobjs_temp-user-obj .
      138         assign
      139           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      140           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      141         .
      142       end.
      143     end.
      144   end.
      145   procedure userobjs_object-exist :
      146     define output parameter p-object-exist as logical   no-undo .
      147     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      148     do
      149     on error undo, return error return-value
      150     :
      151       find first buf_userobjs_temp-user-obj
      152         no-error .
      153       if not available buf_userobjs_temp-user-obj
      154       then do:
      155         assign
      156           p-object-exist = false
      157         .
      158       end.
      159       else do:
      160         assign
      161           p-object-exist = true
      162         .
      163       end.
      164     end.
      165   end.
      166   procedure userobjs_transfer :
      167     define input  parameter p-callback-handle as handle no-undo .
      168     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      169     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      170     do
      171     on error undo, return error return-value
      172     :
      173       if valid-handle(p-callback-handle) <> true
      174       then do:
      175         message
      176           vss-workfile vss-revision vss-description skip
      177           "Ошибка задания входных параметров" skip
      178           "Неизвестный указатель на процедуру" skip
      179           view-as alert-box error .
      180         undo, return error return-value .
      181       end.
      182       if p-callback-handle :get-signature("userobjs_append") = ""
      183       then do:
      184         message
      185           vss-workfile vss-revision vss-description skip
      186           "Ошибка задания входных параметров" skip
      187           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      188                     ,p-callback-handle :file-name
      189                     ) skip
      190           view-as alert-box error .
      191         undo, return error return-value .
      192       end.
      193       for each buf_userobjs_temp-user-obj
      194       on error undo, return error return-value
      195       :
      196         run userobjs_append in p-callback-handle
      197           (input  buf_userobjs_temp-user-obj.obj-type
      198           ,input  buf_userobjs_temp-user-obj.obj-code
      199           ) .
      200       end.
      201     end.
      202   end procedure.
      203   procedure userobjs_select-one :
      204      define input  parameter parparentproc     as widget-handle no-undo .
      205      define input  parameter p-db-num          as integer   no-undo .
      206      define input  parameter p-user-id         as character no-undo .
      207      define input  parameter p-host-code-obj   as integer   no-undo .
      208      define input  parameter p-obj-type        as character no-undo .
      209      define input  parameter p-obj-code        as integer   no-undo .
      210      define output parameter p-user-select     as logical   no-undo .
      211      define output parameter p-select-obj-type as character no-undo .
      212      define output parameter p-select-obj-code as character no-undo .
      213     do
      214     on error undo, return error return-value
      215     :
      216       run gbl/userobjs.w
      217         (input  parparentproc
      218         ,input  this-procedure :handle
      219         ,input  p-db-num
      220         ,input  p-user-id
      221         ,input  p-host-code-obj
      222         ,input  p-obj-type
      223         ,input  p-obj-code
      224         ,INPUT  "b-sel"
      225         ,output p-user-select
      226         ,output p-select-obj-type
      227         ,output p-select-obj-code
      228         ) .
      229     end.
      230   end.
      231   procedure userobjs_select-many :
      232     define input  parameter parparentproc   as widget-handle no-undo .
      233     define input  parameter p-db-num        as integer   no-undo .
      234     define input  parameter p-user-id       as character no-undo .
      235     define input  parameter p-host-code-obj as integer   no-undo .
      236     define input  parameter p-obj-type      as character no-undo .
      237     define input  parameter p-obj-code      as integer   no-undo .
      238     define output parameter p-user-select   as logical   no-undo .
      239     define variable v-select-obj-type as character no-undo .
      240     define variable v-select-obj-code as integer   no-undo .
      241     do
      242     on error undo, return error return-value
      243     :
      244       run gbl/userobjs.w
      245         (input  parparentproc
      246         ,input  this-procedure :handle
      247         ,input  p-db-num
      248         ,input  p-user-id
      249         ,input  p-host-code-obj
      250         ,input  p-obj-type
      251         ,input  p-obj-code
      252         ,INPUT  "b-sel,b-mark"
      253         ,output p-user-select
      254         ,output v-select-obj-type
      255         ,output v-select-obj-code
      256         ) .
      257     end.
      258   end.
      259   procedure thobjs :
      260      define input        parameter parparentproc     as widget-handle no-undo .
      261      define input        parameter i-bttns           as character     no-undo .
      262      define input        parameter i-list-mode       as character     no-undo.
      263      define input        parameter i-obj-type        as character     no-undo.
      264      define input        parameter i-db-num          as integer       no-undo.
      265      define input        parameter i-host-code       as integer       no-undo.
      266      define input-output parameter p-rid-list        as character     no-undo .
      267   run ref/thobjs.p
      268           ( input parparentproc
      269            ,input  this-procedure :handle
      270           , input i-bttns
      271           , input i-list-mode
      272           , input i-obj-type
      273           , input i-db-num
      274           , input i-host-code
      275           , input-output p-rid-list ) no-error .
      276   end.
      277   define variable  par-host-code as integer   no-undo .
      278   define variable doc-t as character no-undo.
      279   DEFINE VARIABLE loc-ref-list as character no-undo.
      280   define variable v-input-output as character no-undo .
      281   define variable v-list-mode as character no-undo .
      282   def buffer b#clients for clients.
      283   define variable v-host-name as character no-undo .
      284   do
      285   on error undo, return error return-value
      286   :
      287   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      288     run mainmenu_getcntxt in parparentproc
      289       (output v-cntxt-db-num
      290       ,output v-cntxt-userid
      291       ,output v-cntxt-level
      292       ,output v-cntxt-host-code-obj
      293       ,output v-cntxt-obj-type
      294       ,output v-cntxt-obj-code
      295       ,output v-cntxt-db-num-obj
      296       ,output v-cntxt-is-admin
      297       ) .
      298   par-host-code = v-cntxt-host-code-obj .
      299     find first b#clients WHERE
      300           b#clients.obj-code = par-host-code and
      301           b#clients.obj-type = 'орг':U
      302           No-LOCK No-ERROR.
      303     v-host-name = b#clients.obj-name .
      304     case par-type :
      305       when "" then do:
      306           v-list-mode = 'фирма':U .
      307       end.
      308       when "1" then do:
      309           v-list-mode = "no-gen-buyer":U .
      310       end.
      311       when "2" then do:
      312           v-list-mode = "yes-gen-buyer":U .
      313       end.
      314     end case.
      315     define variable v-obj-type as character no-undo .
      316     define variable v-obj-code  as integer no-undo .
      317     assign
      318       v-obj-type = v-cntxt-obj-type
      319       v-obj-code = v-cntxt-obj-code
      320     .
      321     if v-obj-type = ""
      322     or v-obj-type = ?
      323     or v-obj-code = 0
      324     or v-obj-code = ?
      325     then do:
      326     end.
      327     run str/all-docs.w
      328                   (input parparentproc
      329                   ,input par-host-code
      330                   ,input v-cntxt-obj-type
      331                   ,input v-cntxt-obj-code
      332                   ,input v-list-mode
      333                   ,input ?
      334                   ,input ?
      335                   ,input ?
      336                   ,input ?
      337                   ,input 'b-mark':U
      338                   ,input '':U
      339                   ,input ?
      340                   ,input (if par-type = "" then recid(b#clients) else ?)
      341                   ,output loc-ref-list
      342                   ) no-error .
      343   end.
