        1   define input  parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
        2   define input  parameter p-mode  as character no-undo .
        3   define input  parameter p-gds   as integer no-undo .
        4   define input  parameter p-artic as character no-undo .
        5   define input  parameter p-prod  as character no-undo .
        6   define input  parameter p-NAME  as character no-undo .
        7   define input  parameter p-unit-base as character no-undo .
        8   define input-output parameter p-price as decimal   no-undo .
        9   define input-output parameter p-prc   as decimal   no-undo .
       10   define input-output parameter p-prc-2   as decimal   no-undo .
       11   define input-output parameter p-vat-type   as character   no-undo .
       12   define input-output parameter p-qnty   as decimal   no-undo .
       13   define input-output parameter p-cli-base-rate as decimal   no-undo .
       14   define input-output parameter p-vat-pc   as decimal   no-undo .
       15   define input-output parameter p-unit-cli  as character no-undo .
       16   define input-output parameter p-unit-cli-ord  as character no-undo .
       17   define input-output parameter p-cli-base-rate-ord as decimal   no-undo .
       18   define input-output parameter p-unit-cli-rcv  as character no-undo .
       19   define input-output parameter p-cli-base-rate-rcv as decimal   no-undo .
       20   define input-output parameter p-bonus        as decimal   no-undo .
       21   define input-output parameter p-retro-bonus   as character no-undo .
       22   define output parameter p-res   as logical   no-undo .
       23   define variable vss-revision    as character no-undo init "$Revision$":u .
       24   define variable vss-author      as character no-undo init "$Author$":u .
       25   define variable vss-date        as character no-undo init "$Date$":u .
       26   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       27   define variable vss-archive     as character no-undo init "$Archive$":u .
       28   define variable vss-description as character no-undo init "Изменение Товарной спецификации к договору" .
       29   procedure vss-get-info :
       30     define output parameter p-vss-revision    like vss-revision    no-undo .
       31     define output parameter p-vss-author      like vss-author      no-undo .
       32     define output parameter p-vss-date        like vss-date        no-undo .
       33     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       34     define output parameter p-vss-archive     like vss-archive     no-undo .
       35     define output parameter p-vss-description like vss-description no-undo .
       36     assign
       37       p-vss-revision    = vss-revision
       38       p-vss-author      = vss-author
       39       p-vss-date        = vss-date
       40       p-vss-workfile    = vss-workfile
       41       p-vss-archive     = vss-archive
       42       p-vss-description = vss-description
       43     .
       44   end procedure.
       45   procedure vss-get-parameters :
       46     define output parameter p-vss-parameters as character no-undo .
       47   end procedure.
       48   define new global shared variable g#vssrevis-logger as handle    no-undo .
       49   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       50   define variable v-vssrevis-logger                   as handle    no-undo .
       51   procedure vss-logevent :
       52     define input  parameter p-extra-paramters as character no-undo .
       53     define variable v-vssrevis-parameters as character no-undo .
       54     do
       55     on error undo, return error return-value
       56     :
       57       if  valid-handle(v-vssrevis-logger)
       58       and v-vssrevis-logger :get-signature("logevent") <> ""
       59       then do:
       60         run vss-get-parameters in this-procedure
       61           (output v-vssrevis-parameters
       62           ).
       63         run logevent in v-vssrevis-logger
       64           (input vss-workfile
       65           ,input vss-revision
       66           ,input v-vssrevis-parameters
       67           ,input p-extra-paramters
       68           ).
       69       end.
       70     end.
       71   end procedure.
       72   assign
       73     v-vssrevis-logger = g#vssrevis-logger
       74   .
       75   if  valid-handle(v-vssrevis-logger)
       76   and v-vssrevis-logger :get-signature("logevent") <> ""
       77   then do:
       78     assign
       79       v-vssrevis-logevent = true
       80     .
       81     run vss-logevent in this-procedure (input vss-description) .
       82   end.
       83   procedure proc-alt-shift-f2:
       84     if not ibs.th.gbl.gbl-var:rcode
       85   then
       86     run gbl\inidebug.p .
       87   end.
       88   procedure proc-alt-shift-f3:
       89     run gbl/prvssinf.p
       90       ( input this-procedure
       91       ) .
       92   end.
       93   define variable v-inform-launched as logical no-undo initial false .
       94   procedure proc-alt-shift-f4:
       95     define variable v-action as character no-undo .
       96     if v-inform-launched = false then do:
       97       assign
       98         v-inform-launched = true
       99       .
      100       run gbl/d-inform.w
      101         (  input self
      102         ,  input this-procedure
      103         , output v-action
      104         ) no-error .
      105       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      106       assign
      107         v-inform-launched = false
      108       .
      109     end.
      110   end.
      111   procedure proc-alt-f1:
      112     run gbl/corrhelp.p
      113       (input this-procedure
      114       ) .
      115   end .
      116   on alt-shift-f2 anywhere do:
      117     run proc-alt-shift-f2.
      118   end.
      119   on alt-shift-f3 anywhere do:
      120     run proc-alt-shift-f3 in this-procedure .
      121   end.
      122   on alt-shift-f4 anywhere do:
      123     run proc-alt-shift-f4 in this-procedure.
      124   end.
      125   on alt-f1 anywhere do:
      126     run proc-alt-f1 in this-procedure .
      127   end.
      128   define new global shared variable g#language as character no-undo .
      129   if g#language <> '' and g#language <> 'rus':U then do:
      130     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      131   end.
      132   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133     define variable v-cntxt-db-num        as integer   no-undo .
      134     define variable v-cntxt-userid        as character no-undo .
      135     define variable v-cntxt-level         as character no-undo .
      136     define variable v-cntxt-host-code-obj as integer   no-undo .
      137     define variable v-cntxt-obj-type      as character no-undo .
      138     define variable v-cntxt-obj-code      as integer   no-undo .
      139     define variable v-cntxt-db-num-obj    as integer   no-undo .
      140     define variable v-cntxt-is-admin      as logical   no-undo .
      141   define new global shared variable g#library  as handle no-undo .
      142   define new global shared variable g#library2 as handle no-undo .
      143   define variable g-log      as logical   no-undo .
      144   define buffer buf_goods for ub.goods  .
      145   assign p-res = no .
      146   DEFINE BUTTON b-bonus
      147        LABEL "&Бонусы"
      148        SIZE 10 BY 1 TOOLTIP "Параметры расчета ретро-бонусов"
      149        BGCOLOR 8 .
      150   DEFINE BUTTON b-exit AUTO-GO
      151        LABEL "&Ввод"
      152        SIZE 10 BY 1
      153        BGCOLOR 8 .
      154   DEFINE BUTTON b-help
      155        LABEL "Помо&щь"
      156        SIZE 10 BY 1
      157        BGCOLOR 8 .
      158   DEFINE BUTTON b-quit AUTO-END-KEY
      159        LABEL "&Отмена"
      160        SIZE 10 BY 1
      161        BGCOLOR 8 .
      162   DEFINE BUTTON b-units
      163        IMAGE-UP FILE "btn-down-arrow":U
      164        IMAGE-DOWN FILE "btn-down-arrow":U
      165        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      166        LABEL "b-units"
      167        SIZE 3 BY 1.
      168   DEFINE BUTTON b-units-ord
      169        IMAGE-UP FILE "btn-down-arrow":U
      170        IMAGE-DOWN FILE "btn-down-arrow":U
      171        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      172        LABEL "b-units"
      173        SIZE 3 BY 1.
      174   DEFINE BUTTON b-units-rcv
      175        IMAGE-UP FILE "btn-down-arrow":U
      176        IMAGE-DOWN FILE "btn-down-arrow":U
      177        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      178        LABEL "b-units"
      179        SIZE 3 BY 1.
      180   DEFINE VARIABLE vat-type AS CHARACTER FORMAT "x(8)"
      181        VIEW-AS COMBO-BOX INNER-LINES 3
      182        LIST-ITEMS "нет НДС","с НДС","без НДС"
      183        DROP-DOWN-LIST
      184        SIZE 10 BY 1 NO-UNDO.
      185   DEFINE VARIABLE fi-cli-base-rate-ord LIKE ext-artic.cli-base-rate
      186        VIEW-AS FILL-IN
      187        SIZE 8 BY 1 NO-UNDO.
      188   DEFINE VARIABLE fi-cli-base-rate-rcv LIKE ext-artic.cli-base-rate
      189        VIEW-AS FILL-IN
      190        SIZE 8 BY 1 NO-UNDO.
      191   DEFINE VARIABLE fi-unit-cli AS CHARACTER FORMAT "X(3)"
      192        LABEL "Ед.изм в накладной"
      193        VIEW-AS FILL-IN
      194        SIZE 7 BY 1
      195        FGCOLOR 4 .
      196   DEFINE VARIABLE fi-unit-cli-ord AS CHARACTER FORMAT "X(3)"
      197        LABEL "Ед.изм в заказе"
      198        VIEW-AS FILL-IN
      199        SIZE 7 BY 1
      200        FGCOLOR 4 .
      201   DEFINE VARIABLE fi-unit-cli-rcv AS CHARACTER FORMAT "X(3)"
      202        LABEL "Ед.изм в поставке"
      203        VIEW-AS FILL-IN
      204        SIZE 7 BY 1
      205        FGCOLOR 4 .
      206   DEFINE VARIABLE FILL-1 AS CHARACTER FORMAT "X(256)":U
      207        LABEL "Артикул"
      208         VIEW-AS TEXT
      209        SIZE 15.5 BY .67 NO-UNDO.
      210   DEFINE VARIABLE FILL-2 AS CHARACTER FORMAT "X(256)":U
      211        LABEL "Производитель"
      212         VIEW-AS TEXT
      213        SIZE 40 BY .67 NO-UNDO.
      214   DEFINE VARIABLE FILL-3 AS CHARACTER FORMAT "X(256)":U
      215        LABEL "Наименование"
      216         VIEW-AS TEXT
      217        SIZE 65.38 BY .83 NO-UNDO.
      218   DEFINE VARIABLE FILL-bonus AS DECIMAL FORMAT "->>9.99":U INITIAL 0
      219        LABEL "Бонус %"
      220        VIEW-AS FILL-IN
      221        SIZE 13.25 BY 1 TOOLTIP "Бонус - для ценообразования по Контрагенту" NO-UNDO.
      222   DEFINE VARIABLE FILL-cli-base-rate AS DECIMAL FORMAT ">>,>>9.<<<<":U INITIAL 0
      223        VIEW-AS FILL-IN
      224        SIZE 8 BY 1 TOOLTIP "Коэффициент" NO-UNDO.
      225   DEFINE VARIABLE FILL-prc AS DECIMAL FORMAT "->>9.99":U INITIAL 0
      226        LABEL "Допустиммый % отклонения от спецификации в большую сторону"
      227        VIEW-AS FILL-IN
      228        SIZE 13.25 BY 1 TOOLTIP "Допустиммый % отклонения от суммы спецификации" NO-UNDO.
      229   DEFINE VARIABLE FILL-prc-2 AS DECIMAL FORMAT "->>9.99":U INITIAL 0
      230        LABEL "Допустиммый % отклонения от спецификации в меньшую сторону"
      231        VIEW-AS FILL-IN
      232        SIZE 13.25 BY 1 TOOLTIP "Допустиммый % отклонения от суммы спецификации" NO-UNDO.
      233   DEFINE VARIABLE FILL-price AS DECIMAL FORMAT ">,>>>,>>>,>>9.99":U INITIAL 0
      234        VIEW-AS FILL-IN
      235        SIZE 21 BY 1 TOOLTIP "Цена поставщика за ед.изм.накладной в валюте договора" NO-UNDO.
      236   DEFINE VARIABLE FILL-qnty AS DECIMAL FORMAT ">>>,>>>,>>9.<<<":U INITIAL 0
      237        VIEW-AS FILL-IN
      238        SIZE 18.5 BY 1 TOOLTIP "Количество по накладной в едизм Поставщика" NO-UNDO.
      239   DEFINE VARIABLE FILL-unit-base AS CHARACTER FORMAT "X(3)":U
      240        LABEL "Базовая"
      241         VIEW-AS TEXT
      242        SIZE 7 BY .67 TOOLTIP "Единица измерения из карточки товара"
      243        FGCOLOR 4  NO-UNDO.
      244   DEFINE VARIABLE FILL-VAT-pc AS DECIMAL FORMAT ">9.9":U INITIAL 0
      245        LABEL "НДС"
      246        VIEW-AS FILL-IN
      247        SIZE 7 BY 1 NO-UNDO.
      248   DEFINE VARIABLE v-price-cli-ord AS DECIMAL FORMAT ">,>>>,>>>,>>9.99":U INITIAL 0
      249         VIEW-AS TEXT
      250        SIZE 21 BY .67 TOOLTIP "Цена поставщика за ед.изм. в заказе в валюте договора" NO-UNDO.
      251   DEFINE VARIABLE v-price-cli-rcv AS DECIMAL FORMAT ">,>>>,>>>,>>9.99":U INITIAL 0
      252         VIEW-AS TEXT
      253        SIZE 21 BY .67 TOOLTIP "Цена поставщика за ед.изм. в поставке в валюте договора" NO-UNDO.
      254   DEFINE VARIABLE v-qnty-ord AS DECIMAL FORMAT ">>>,>>>,>>9.<<<":U INITIAL 0
      255         VIEW-AS TEXT
      256        SIZE 18.5 BY .67 TOOLTIP "Количество в заказе в едизм Поставщика" NO-UNDO.
      257   DEFINE VARIABLE v-qnty-rcv AS DECIMAL FORMAT ">>>,>>>,>>9.<<<":U INITIAL 0
      258         VIEW-AS TEXT
      259        SIZE 18.5 BY .67 TOOLTIP "Количество в поставке в едизм Поставщика" NO-UNDO.
      260   DEFINE QUERY Dialog-Frame FOR
      261         ext-artic SCROLLING.
      262   DEFINE FRAME Dialog-Frame
      263        b-exit AT ROW 1 COL 1
      264        b-quit AT ROW 1 COL 11
      265        b-bonus AT ROW 1 COL 21 WIDGET-ID 10
      266        b-help AT ROW 1 COL 73
      267        FILL-prc AT ROW 4.5 COL 1
      268        FILL-prc-2 AT ROW 6 COL 1 WIDGET-ID 74
      269        FILL-bonus AT ROW 7 COL 1.88 WIDGET-ID 72
      270        vat-type AT ROW 8.21 COL 14.88 COLON-ALIGNED NO-LABEL
      271        FILL-VAT-pc AT ROW 8.25 COL 5.13 COLON-ALIGNED
      272        fi-unit-cli AT ROW 11.92 COL 20.38 COLON-ALIGNED WIDGET-ID 32
      273        b-units AT ROW 11.92 COL 29.5 WIDGET-ID 30
      274        FILL-cli-base-rate AT ROW 11.92 COL 30.63 COLON-ALIGNED NO-LABEL
      275        FILL-price AT ROW 11.92 COL 39.13 COLON-ALIGNED NO-LABEL
      276        FILL-qnty AT ROW 11.92 COL 61.63 COLON-ALIGNED NO-LABEL
      277        fi-unit-cli-ord AT ROW 13.04 COL 20.38 COLON-ALIGNED WIDGET-ID 44
      278        b-units-ord AT ROW 13.04 COL 29.5 WIDGET-ID 40
      279        fi-cli-base-rate-ord AT ROW 13.04 COL 30.63 COLON-ALIGNED HELP
      280             "" NO-LABEL WIDGET-ID 42
      281        fi-unit-cli-rcv AT ROW 14.21 COL 20.38 COLON-ALIGNED WIDGET-ID 54
      282        b-units-rcv AT ROW 14.21 COL 29.5 WIDGET-ID 50
      283        fi-cli-base-rate-rcv AT ROW 14.21 COL 30.63 COLON-ALIGNED HELP
      284             "" NO-LABEL WIDGET-ID 52
      285        FILL-1 AT ROW 2.21 COL 8.88 COLON-ALIGNED
      286        FILL-2 AT ROW 2.21 COL 27
      287        FILL-3 AT ROW 3.42 COL 14.63 COLON-ALIGNED
      288        FILL-unit-base AT ROW 10.92 COL 20.38 COLON-ALIGNED WIDGET-ID 6
      289        v-qnty-ord AT ROW 13.13 COL 61.75 COLON-ALIGNED NO-LABEL WIDGET-ID 66
      290        v-price-cli-ord AT ROW 13.17 COL 39.25 COLON-ALIGNED NO-LABEL WIDGET-ID 64
      291        v-qnty-rcv AT ROW 14.25 COL 61.75 COLON-ALIGNED NO-LABEL WIDGET-ID 70
      292        v-price-cli-rcv AT ROW 14.29 COL 39.25 COLON-ALIGNED NO-LABEL WIDGET-ID 68
      293        "%" VIEW-AS TEXT
      294             SIZE 1.75 BY .67 AT ROW 8.38 COL 14.63
      295        "Единицы измерения                      Цена                  Количество" VIEW-AS TEXT
      296             SIZE 79 BY 1 AT ROW 9.58 COL 3 WIDGET-ID 4
      297             BGCOLOR 3 FGCOLOR 15
      298        SPACE(2.12) SKIP(7.54)
      299       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      300            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      301            TITLE "Изменение спецификации"
      302            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit.
      303   ASSIGN
      304          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      305          FRAME Dialog-Frame:HIDDEN           = TRUE.
      306   ASSIGN
      307          FILL-unit-base:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      308   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      309   DO:
      310     APPLY "END-ERROR":U TO SELF.
      311   END.
      312   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      313   DO:
      314     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      315       assign FILL-price FILL-prc FILL-prc-2 vat-type FILL-qnty FILL-vat-pc FILL-cli-base-rate fi-unit-cli  fi-unit-cli-ord fi-unit-cli-rcv fi-cli-base-rate-ord fi-cli-base-rate-rcv  FILL-bonus .
      316       assign
      317         p-res   = yes
      318         p-price = FILL-price
      319         p-prc   = FILL-prc
      320         p-prc-2   = FILL-prc-2
      321         p-vat-type = vat-type
      322         p-qnty     = FILL-qnty
      323         p-cli-base-rate = FILL-cli-base-rate
      324         p-vat-pc = FILL-vat-pc
      325         p-unit-cli = fi-unit-cli
      326         p-unit-cli-ord      = fi-unit-cli-ord
      327         p-unit-cli-rcv      = fi-unit-cli-rcv
      328         p-cli-base-rate-ord = fi-cli-base-rate-ord
      329         p-cli-base-rate-rcv = fi-cli-base-rate-rcv
      330         p-bonus = FILL-bonus
      331       .
      332     end.
      333   END.
      334   ON choose OF b-units IN FRAME Dialog-Frame
      335   do:
      336   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      337   if lookup(self :type
      338            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      339            ) = 0
      340   then do:
      341     message
      342       "$Workfile$"
      343       "Указанному интерфейсному элементу фокус не может быть передан" skip
      344       "Интерфейсный элемент" self :name  skip
      345       "Тип" self :type  skip
      346       "Процедура" this-procedure :file-name skip
      347       view-as alert-box .
      348   end.
      349   else do:
      350     apply "entry":u to self  .
      351     if focus :handle <> self :handle  then do:
      352       return no-apply .
      353     end.
      354   end.
      355     define buffer buf_units for ub.units.
      356     define variable v-ret-unit-name  as character no-undo .
      357     define variable v-ret-unit-coeff as decimal no-undo .
      358     run ref/alt-units.w (input parparentproc,
      359                          input 'ВЫБОР':U,
      360                          input p-gds,
      361                          input "",
      362                          output v-ret-unit-name,
      363                          output v-ret-unit-coeff) .
      364     if v-ret-unit-name > "" then do :
      365       if can-find (first buf_units where buf_units.unit-name = v-ret-unit-name) then do :
      366         assign
      367         fi-unit-cli        = v-ret-unit-name
      368         FILL-cli-base-rate = v-ret-unit-coeff
      369         .
      370         display fi-unit-cli FILL-cli-base-rate with FRAME Dialog-Frame.
      371         apply "entry":U to FILL-cli-base-rate .
      372       end .
      373     end .
      374     else return no-apply .
      375   end.
      376   ON choose OF b-units-ord IN FRAME Dialog-Frame
      377   do:
      378   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      379   if lookup(self :type
      380            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      381            ) = 0
      382   then do:
      383     message
      384       "$Workfile$"
      385       "Указанному интерфейсному элементу фокус не может быть передан" skip
      386       "Интерфейсный элемент" self :name  skip
      387       "Тип" self :type  skip
      388       "Процедура" this-procedure :file-name skip
      389       view-as alert-box .
      390   end.
      391   else do:
      392     apply "entry":u to self  .
      393     if focus :handle <> self :handle  then do:
      394       return no-apply .
      395     end.
      396   end.
      397     define buffer buf_units for ub.units.
      398     define variable ref-rec as recid no-undo.
      399     run ref/units.w (input parparentproc, input yes, output ref-rec).
      400     if ref-rec = ? then return no-apply.
      401     find buf_units where recid (buf_units) = ref-rec no-lock.
      402     assign fi-unit-cli-ord  = buf_units.unit-name.
      403     display fi-unit-cli-ord with FRAME Dialog-Frame.
      404     apply "entry":U to fi-cli-base-rate-ord .
      405   end.
      406   ON choose OF b-units-rcv IN FRAME Dialog-Frame
      407   do:
      408   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      409   if lookup(self :type
      410            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      411            ) = 0
      412   then do:
      413     message
      414       "$Workfile$"
      415       "Указанному интерфейсному элементу фокус не может быть передан" skip
      416       "Интерфейсный элемент" self :name  skip
      417       "Тип" self :type  skip
      418       "Процедура" this-procedure :file-name skip
      419       view-as alert-box .
      420   end.
      421   else do:
      422     apply "entry":u to self  .
      423     if focus :handle <> self :handle  then do:
      424       return no-apply .
      425     end.
      426   end.
      427     define buffer buf_units for ub.units.
      428     define variable ref-rec as recid no-undo.
      429     run ref/units.w (input parparentproc, input yes, output ref-rec).
      430     if ref-rec = ? then return no-apply.
      431     find buf_units where recid (buf_units) = ref-rec no-lock.
      432     assign fi-unit-cli-rcv  = buf_units.unit-name.
      433     display fi-unit-cli-rcv with FRAME Dialog-Frame.
      434     apply "entry":U to fi-cli-base-rate-rcv .
      435   end.
      436   ON leave OF fi-unit-cli IN FRAME Dialog-Frame
      437   do:
      438   find ub.units where ub.units.unit-name = input frame Dialog-Frame fi-unit-cli no-lock no-error.
      439     if not available ub.units then do:
      440       message "Неправильная единица измерения поставщика." view-as alert-box.
      441       display fi-unit-cli with FRAME Dialog-Frame.
      442       apply "choose" to b-units.
      443       return no-apply.
      444     end.
      445     assign frame Dialog-Frame fi-unit-cli.
      446   end.
      447   ON return OF fi-unit-cli IN FRAME Dialog-Frame
      448   do:
      449     apply "entry" to FILL-cli-base-rate in frame Dialog-Frame.
      450     return no-apply.
      451   end.
      452   ON leave OF fi-unit-cli-ord IN FRAME Dialog-Frame
      453   do:
      454     find ub.units where ub.units.unit-name = input frame Dialog-Frame fi-unit-cli-ord no-lock no-error.
      455     if not available ub.units then do:
      456       message "Неправильная единица измерения поставщика." view-as alert-box.
      457       display fi-unit-cli-ord with FRAME Dialog-Frame.
      458       apply "choose" to b-units-ord.
      459       return no-apply.
      460     end.
      461     assign frame Dialog-Frame fi-unit-cli-ord.
      462   end.
      463   ON return OF fi-unit-cli-ord IN FRAME Dialog-Frame
      464   do:
      465     apply "entry" to fi-cli-base-rate-ord in frame Dialog-Frame.
      466     return no-apply.
      467   end.
      468   ON CHOOSE OF b-bonus IN FRAME Dialog-Frame
      469   DO:
      470      run str\cont-bns.w
      471        ( input parParentProc,
      472          input 0,
      473          input 0,
      474          input 0,
      475          input-output p-retro-bonus
      476          ).
      477   END.
      478   ON leave OF fi-unit-cli-rcv IN FRAME Dialog-Frame
      479   do:
      480     find ub.units where ub.units.unit-name = input frame Dialog-Frame fi-unit-cli-rcv no-lock no-error.
      481     if not available ub.units then do:
      482       message "Неправильная единица измерения поставщика." view-as alert-box.
      483       display fi-unit-cli-rcv with FRAME Dialog-Frame.
      484       apply "choose" to b-units-rcv.
      485       return no-apply.
      486     end.
      487     assign frame Dialog-Frame fi-unit-cli-rcv.
      488   end.
      489   ON return OF fi-unit-cli-rcv IN FRAME Dialog-Frame
      490   do:
      491     apply "entry" to fi-cli-base-rate-rcv in frame Dialog-Frame.
      492     return no-apply.
      493   end.
      494   ON VALUE-CHANGED OF vat-type IN FRAME Dialog-Frame
      495   DO:
      496     assign vat-type .
      497     if vat-type = 'без':U then do:
      498       assign FILL-vat-pc = 0 .
      499       DISABLE FILL-VAT-pc WITH FRAME Dialog-Frame.
      500       display FILL-vat-pc WITH FRAME Dialog-Frame.
      501     end.
      502     else do:
      503       ENABLE FILL-VAT-pc WITH FRAME Dialog-Frame.
      504       display FILL-vat-pc WITH FRAME Dialog-Frame.
      505     end.
      506   END.
      507   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      508   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      509   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      510   on help of frame Dialog-Frame
      511   do:
      512     run gbl/app_help.p
      513       (input this-procedure :file-name
      514       ,input ''
      515       ,input ?
      516       ) no-error.
      517     if error-status :error then do:
      518       message
      519         "Ошибка при вызове помощи"
      520         error-status :get-message(1)
      521         view-as alert-box .
      522     end.
      523   end.
      524   run minbtn-set in this-procedure .
      525   on choose of b-help in frame Dialog-Frame
      526   do:
      527     apply "help":u to frame Dialog-Frame .
      528   end.
      529   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      530   procedure minbtn-set :
      531       do
      532           on error undo, return error return-value
      533           :
      534           define variable ii              as integer       no-undo .
      535           define variable fh              as widget-handle no-undo .
      536           define variable hh              as widget-handle no-undo .
      537           define variable v-h             as handle        extent 4 no-undo .
      538           define variable v-name-button   as character     no-undo .
      539           define variable v-help-old-x    as decimal       no-undo .
      540           define variable v-help-old-y    as decimal       no-undo .
      541           define variable v-help-old-size as decimal       no-undo .
      542           define variable v-frame-width   as decimal       no-undo .
      543           define variable jj              as integer       no-undo .
      544           do
      545               on error undo, return error
      546               :
      547               assign
      548                   v-frame-width = frame Dialog-Frame:width - 0.3
      549                   fh            = frame Dialog-Frame:first-child
      550                   hh            = fh:first-child
      551                   ii            = 1
      552                   .
      553               do while valid-handle(hh):
      554                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      555                   do:
      556                       case lc(hh:name) :
      557                           when "b-help" then
      558                               do:
      559                                   hh:load-image-up("cmp/b-help.bmp":u) .
      560                                   hh:load-image-down("cmp/b-help.bmp":u) .
      561                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      562                                   hh:TOOLTIP = "Помощь" .
      563                                   v-help-old-x = hh:column .
      564                                   v-help-old-y = hh:row    .
      565                                   v-help-old-size = hh:width .
      566                                   hh:width-chars = 2.5 .
      567                               end.
      568                           when "b-print" then
      569                               do:
      570                                   hh:load-image("cmp/b-print.bmp":u) .
      571                                   hh:TOOLTIP = "Печать" .
      572                                   v-h[ii] = hh:handle .
      573                                   ii = ii + 1 .
      574                                   hh:width-chars = 3 .
      575                               end.
      576                           when "b-history" or
      577                           when "b-hist" then
      578                               do:
      579                                   hh:load-image("cmp/b-hist.bmp":u) .
      580                                   hh:TOOLTIP = "История" .
      581                                   v-h[ii] = hh:handle .
      582                                   ii = ii + 1 .
      583                                   hh:width-chars = 3 .
      584                               end.
      585                           when "b-sch" then
      586                               do:
      587                                   hh:load-image("cmp/b-sch.bmp":u) .
      588                                   hh:TOOLTIP = "Установка Фильтра" .
      589                                   v-h[ii] = hh:handle .
      590                                   ii = ii + 1 .
      591                                   hh:width-chars = 3 .
      592                               end.
      593                           when "b-hist-user" then
      594                               do:
      595                                   hh:load-image("cmp/b-hist.bmp":u) .
      596                                   hh:TOOLTIP = "История пользователя" .
      597                                   ii = ii + 1 .
      598                               end.
      599                       end case.
      600                   end.
      601                   hh = hh:next-sibling.
      602               end.
      603               b-help:column = v-frame-width - b-help:width-chars.
      604               jj = 0.
      605               repeat ii = 4 to 1 by -1 :
      606                   if valid-handle (v-h[ii] ) then
      607                   do:
      608                       jj  = jj + 1 .
      609                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      610                       v-h[ii]:row    = v-help-old-y .
      611                   end.
      612               end.
      613           end.
      614       end.
      615   end procedure.
      616   MAIN-BLOCK:
      617   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      618      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      619      VAT-type:LIST-ITEMS in frame Dialog-Frame =  'нет':U + "," + 'в т. ч.':U + "," + 'без':U .
      620     assign
      621        FILL-price = p-price
      622        FILL-prc   = p-prc
      623        FILL-prc-2   = p-prc-2
      624        FILL-1     = p-artic
      625        FILL-2     = p-prod
      626        FILL-3     = p-NAME
      627        vat-type   = p-vat-type
      628        FILL-qnty  = p-qnty
      629        FILL-cli-base-rate = p-cli-base-rate
      630        FILL-vat-pc = p-vat-pc
      631        FILL-bonus = p-bonus
      632        fi-unit-cli = p-unit-cli
      633        FILL-unit-base = p-unit-base
      634        fi-unit-cli-ord = p-unit-cli-ord
      635        fi-unit-cli-rcv = p-unit-cli-rcv
      636        fi-cli-base-rate-ord = p-cli-base-rate-ord
      637        fi-cli-base-rate-rcv = p-cli-base-rate-rcv
      638     .
      639     RUN my_enable_UI.
      640     if vat-type = 'без':U then  DISABLE FILL-VAT-pc WITH FRAME Dialog-Frame.
      641     WAIT-FOR GO OF FRAME Dialog-Frame FOCUS FILL-price .
      642   END.
      643   RUN disable_UI.
      644   PROCEDURE disable_UI :
      645     HIDE FRAME Dialog-Frame.
      646   END PROCEDURE.
      647   PROCEDURE my_enable_UI :
      648   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      649     run mainmenu_getcntxt in parparentproc
      650       (output v-cntxt-db-num
      651       ,output v-cntxt-userid
      652       ,output v-cntxt-level
      653       ,output v-cntxt-host-code-obj
      654       ,output v-cntxt-obj-type
      655       ,output v-cntxt-obj-code
      656       ,output v-cntxt-db-num-obj
      657       ,output v-cntxt-is-admin
      658       ) .
      659   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      660   do:
      661     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      662       (input  v-cntxt-db-num
      663       ,input  v-cntxt-userid
      664       ,input  0
      665       ,input  'actn_fin-bonus_work':U
      666       ,input  'firm':U
      667       ,input  v-cntxt-host-code-obj
      668       ,input  '':U
      669       ,input  0
      670       ,input  0
      671       ,input  0
      672       ,input  0
      673       ,input  false
      674       ,output g-log
      675       )  .
      676   end.
      677     if g-log then enable b-bonus WITH FRAME Dialog-Frame.
      678     else hide b-bonus in FRAME Dialog-Frame.
      679     b-units:visible = (p-gds > 0) .
      680     OPEN QUERY Dialog-Frame FOR EACH ext-artic SHARE-LOCK.
      681     GET FIRST Dialog-Frame.
      682     DISPLAY FILL-prc FILL-prc-2 FILL-bonus vat-type FILL-VAT-pc fi-unit-cli
      683             FILL-cli-base-rate FILL-price FILL-qnty fi-unit-cli-ord
      684             fi-cli-base-rate-ord fi-unit-cli-rcv fi-cli-base-rate-rcv FILL-1
      685             FILL-2 FILL-3 FILL-unit-base v-qnty-ord v-price-cli-ord v-qnty-rcv
      686             v-price-cli-rcv
      687         WITH FRAME Dialog-Frame.
      688     ENABLE b-exit b-quit b-help FILL-prc FILL-prc-2 FILL-bonus vat-type
      689            FILL-VAT-pc FILL-cli-base-rate FILL-price
      690            FILL-qnty
      691            fi-unit-cli when b-units:visible
      692            b-units     when b-units:visible
      693            fi-unit-cli-ord b-units-ord fi-cli-base-rate-ord
      694            fi-unit-cli-rcv b-units-rcv fi-cli-base-rate-rcv FILL-1 FILL-2 FILL-3
      695            FILL-unit-base
      696         WITH FRAME Dialog-Frame.
      697     VIEW FRAME Dialog-Frame.
      698   END PROCEDURE.
      699   PROCEDURE PROC-DISP :
      700   END PROCEDURE.
