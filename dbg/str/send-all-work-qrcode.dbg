        1   block-level on error undo, throw.
        2   define variable vss-revision as character no-undo init "$Revision:$":U .
        3   define variable vss-author      as character no-undo init "$Author:$":U .
        4   define variable vss-date        as character no-undo init "$Date:$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile:$":U .
        6   define variable vss-archive     as character no-undo init "$Archive:$":U .
        7   define variable vss-description as character no-undo init "Отправка на кассу QR-код кассира".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define variable mdb-num   as integer   no-undo.
       67   define variable mObjType  as character no-undo.
       68   define variable mObjCode  as integer   no-undo.
       69   define variable mPostType as character no-undo.
       70   define variable mCashNum  as integer   no-undo.
       71   define stream finp.
       72   procedure putc :
       73     define input  parameter iSAXWriter as handle no-undo .
       74     define input  parameter i-action   as character  no-undo .
       75     define input  parameter i-value    as character  no-undo .
       76     define output parameter oOK       as logical no-undo.
       77     define variable ii             as integer   no-undo .
       78     define VARIABLE name-cash      as character no-undo.
       79     define VARIABLE name-cash1     as character no-undo.
       80     define VARIABLE name-cash2     as character no-undo.
       81     define variable enc-passwd     as character no-undo.
       82     define variable ufo-passwd as character no-undo.
       83     define variable ufo-enc20  as character format "x(20)" no-undo.
       84     define variable v-shadow-fname as character no-undo .
       85     define buffer buf_clients for ub.clients .
       86     do ii = 0 to num-entries(i-value,chr(44)):
       87       FIND FIRST ub.staff-attr No-LOCK WHERE
       88         recid(ub.staff-attr) = integer(entry(ii,i-value,chr(44))) No-ERROR.
       89       IF avail ub.staff-attr then
       90       do:
       91         v-shadow-fname = substitute( "pass&1.dat" , string(random(1, 80000), "99999") ) .
       92         find first ub.staff no-lock where ub.staff.staff-code = ub.staff-attr.staff-code and
       93           ub.staff.role-level = ub.staff-attr.role-level and
       94           ub.staff.role = ub.staff-attr.role no-error .
       95         find first ub.person where ub.person.psn-code = ub.staff.psn-code no-error.
       96         iSAXWriter:start-element ("Cashier").
       97         iSAXWriter:insert-attribute("ctrl",  "ADD") .
       98         iSAXWriter:insert-attribute("tms", string(time)) .
       99         iSAXWriter:insert-attribute("code", string (ub.staff.psn-code)) .
      100         if available ub.person
      101           then
      102         do:
      103           find FIRST buf_clients no-lock WHERE
      104             buf_clients.obj-type = 'чел':U
      105             AND buf_clients.obj-code = ub.person.psn-code no-error .
      106           name-cash1 = if ub.person.name1 <> "" then (substring(ub.person.name1,1,1) + '.') else ''.
      107           name-cash2 = if ub.person.name2 <> "" then (substring(ub.person.name2,1,1) + '.') else ''.
      108           name-cash = buf_clients.obj-name + ' ' + name-cash1 + ' ' + name-cash2 .
      109         end.
      110         enc-passwd = "".
      111         ufo-passwd = search('exe/ufo_passwd.exe':u).
      112         if ufo-passwd > "" then
      113         do:
      114           os-command silent value(ufo-passwd) value(ub.staff.password) > value(v-shadow-fname) .
      115           input stream finp from value(v-shadow-fname) .
      116           repeat:
      117             import stream finp unformatted ufo-enc20 no-error.
      118             enc-passwd = enc-passwd + ufo-enc20.
      119           end.
      120           input stream finp close.
      121           os-delete value(v-shadow-fname).
      122         end.
      123         iSAXWriter:write-data-element ( "CashierName", name-cash ).
      124         iSAXWriter:write-data-element ( "CashierParol", ub.staff.password ).
      125         iSAXWriter:write-data-element ( "CashierLock",  if staff.date-end < today then "1" else "0").
      126         iSAXWriter:write-data-element ( "CashierINN", if available person then string(person.inn) else "").
      127         iSAXWriter:write-data-element ( "CashierShadow", enc-passwd).
      128         iSAXWriter:write-data-element ( "CashierQRCode", ub.staff-attr.attr-value).
      129         iSAXWriter:end-element ( "Cashier").
      130       END.
      131     END.
      132     oOk = true .
      133   end procedure .
