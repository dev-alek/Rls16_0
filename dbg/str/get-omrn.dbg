     1234   FUNCTION convert-discount returns integer
     1235                                             ( input p-disc-reason as integer
     1236                                             , input p-disc-type  as integer
     1237                                             , input p-line-type as integer) :
     1238   define variable v-disc-type as integer no-undo .
     1239   if p-line-type = integer('1':U)
     1240   or p-line-type = integer('0':U)
     1241   then do:
     1242     if p-disc-type = 0
     1243     or p-disc-type = 1
     1244     or p-disc-type = 2
     1245     then do:
     1246       if p-disc-reason <> 0 then
     1247       p-disc-type = p-disc-reason
     1248       .
     1249     end.
     1250   end.
     1251   if p-line-type = integer('3':U)
     1252   or p-line-type = integer('2':U) then do:
     1253     if p-disc-type = 101
     1254     or p-disc-type = 102
     1255     then do:
     1256       if p-disc-reason <> 0 then
     1257       p-disc-type = p-disc-reason
     1258       .
     1259     end.
     1260   end.
     1261   if p-disc-reason <> 0 then do:
     1262     CASE p-disc-reason:
     1263       when 0 then do:
     1264         return integer('0':U).
     1265       end.
     1266       when 1 then do:
     1267         return integer('11':U).
     1268       end.
     1269       when 2 then do:
     1270         return integer('1':U).
     1271       end.
     1272       when 3 or when 15 then do:
     1273         return integer('7':U).
     1274       end.
     1275       when 4 then do:
     1276         return integer('4':U).
     1277       end.
     1278       when 5 then do:
     1279         return integer('12':U).
     1280       end.
     1281       when 6 then do:
     1282         return integer('3':U).
     1283       end.
     1284       when 7 then do:
     1285         return integer('13':U).
     1286       end.
     1287       when 8
     1288       or
     1289       when 9
     1290       or
     1291       when 10
     1292       then do:
     1293         return integer('20':U).
     1294       end.
     1295       when 11
     1296       then do:
     1297         return integer('21':U).
     1298       end.
     1299       when 13
     1300       then do:
     1301         return integer('22':U).
     1302       end.
     1303       when 16 then do:
     1304         return integer('23':U).
     1305       end.
     1306     END CASE.
     1307   end.
     1308   CASE p-disc-type:
     1309     when 0 then do:
     1310       return integer('0':U).
     1311     end.
     1312     when 1 then do:
     1313       return integer('13':U).
     1314     end.
     1315     when 2 then do:
     1316       return integer('2':U).
     1317     end.
     1318     when 3 then do:
     1319       return integer('4':U).
     1320     end.
     1321     when 4 then do:
     1322       return integer('12':U).
     1323     end.
     1324     when 5 then do:
     1325       return integer('1':U).
     1326     end.
     1327     when 6 then do:
     1328       return integer('3':U).
     1329     end.
     1330     when 7 then do:
     1331       return integer('14':U).
     1332     end.
     1333     when 8 then do:
     1334       return integer('15':U).
     1335     end.
     1336     when 9 then do:
     1337       return integer('16':U).
     1338     end.
     1339     when 101 then do:
     1340       return integer('13':U).
     1341     end.
     1342     when 102 then do:
     1343       return integer('5':U).
     1344     end.
     1345     when 103 then do:
     1346       return integer('1':U).
     1347     end.
     1348     when 104 then do:
     1349       return integer('5':U).
     1350     end.
     1351     when 105 then do:
     1352       return integer('1':U).
     1353     end.
     1354     when 106 then do:
     1355       return integer('1':U).
     1356     end.
     1357   END CASE.
     1358   END FUNCTION.
     1359   run get-general-parameters in this-procedure .
     1360   procedure get-general-parameters :
     1361   define buffer buf_get-chkc_context for get-chkc_context.
     1362   do
     1363   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1364   :
     1365     for each buf_get-chkc_context:
     1366       delete buf_get-chkc_context.
     1367     end.
     1368     create buf_get-chkc_context.
     1369   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1370   if (valid-handle(g#libchkvl) <> true) then do:   run str/libchkvl.p persistent no-error .   if error-status :error or (valid-handle(g#libchkvl) <> true) then do:     message       "Error starting nws/libchkvl.p" skip       g#libchkvl skip       g#libchkvl :type skip       g#libchkvl :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libchkvl_create-context in g#libchkvl
     1371     (input  p-obj-type
     1372     ,input  p-obj-code
     1373     ,input  buffer buf_get-chkc_context:handle
     1374     ) no-error .
     1375     if error-status:error then do:
     1376       undo, return error substitute("Ошибка при создании контекста&1&2&1&3"
     1377                                      , chr(10)
     1378                                      , error-status:get-message(1)
     1379                                      , return-value ).
     1380     end.
     1381     find first buf_get-chkc_context.
     1382     assign
     1383     buf_get-chkc_context.parparentproc = parparentproc
     1384     buf_get-chkc_context.p-log-handle = p-log-handle
     1385     buf_get-chkc_context.tt-wd-bh     = buffer tt-wd:handle
     1386     .
     1387     release buf_get-chkc_context.
     1388     find first get-chkc_context.
     1389   end.
     1390   end procedure.
     1391   get-chkc_context.pos-type = dflt-cd.
     1392   FIND FIRST ub.shop WHERE
     1393             ub.shop.obj-code = p-obj-code no-lock no-error.
     1394   find first bff_cash-pay no-lock where
     1395             bff_cash-pay.cdpay-code = not-nal
     1396         and bff_cash-pay.curr-code = base-cass no-error.
     1397   if available bff_cash-pay then do:
     1398     assign
     1399     not-nal-curr = bff_cash-pay.curr-code.
     1400   end.
     1401   input stream ChkStream from value(file_).
     1402   _repeat:
     1403   REPEAT :
     1404     import stream ChkStream unformatted ss.
     1405     assign
     1406     var-file-line-num = var-file-line-num + 1
     1407     .
     1408     if ss = "":U then next _repeat.
     1409     CASE substring( ss, 1, 2 ) :
     1410       when '99' then  do:
     1411         run proc-99 in this-procedure (input ss) no-error .
     1412       end.
     1413       when '01' then do:
     1414         run proc-end in this-procedure no-error .
     1415         assign
     1416         exist = yes
     1417         .
     1418         run proc-01 in this-procedure (input ss) no-error .
     1419       end.
     1420       when '03' then do:
     1421         run proc-03 in this-procedure (input ss) no-error .
     1422       end.
     1423       when '04' then do:
     1424         run proc-04 in this-procedure(input ss) no-error.
     1425       end.
     1426       when '11' OR when '12' then do:
     1427         run proc-11-12 in this-procedure (input ss) no-error .
     1428       end.
     1429     END CASE .
     1430   END .
     1431   DO TRANSACTION:
     1432     run proc-end in this-procedure no-error .
     1433   END.
     1434   error-status:error = false.
     1435   input stream ChkStream close.
     1436   run gbl/filename.p (
     1437                   input  file_
     1438                  ,output p-full-path
     1439                  ,output sav
     1440                  ,output filenamebo
     1441                  ,output p-file-name-no-ext
     1442                  ,output p-file-name-ext
     1443                   ).
     1444   if index(filenamebo, "ll":U) > 0 then
     1445   assign
     1446   filenamebo = REPLACE(FILENAMEbo, "ll":U, "zz":U) no-error.
     1447   else
     1448   assign
     1449   filenamebo = REPLACE(FILENAMEbo, "l":U, "z":U) no-error.
     1450   os-copy value(file_) value(sav + "\sav\":U + FILENAMEbo).
     1451   if os-error = 0 then
     1452   os-delete value(file_).
     1453   procedure proc-99 :
     1454   define input parameter p-ss as character no-undo .
     1455   DEFINE VARIABLE var-code-int as integer no-undo .
     1456   DEFINE VARIABLE var-code-chr as character no-undo .
     1457     do
     1458     on error undo, return error
     1459     :
     1460       assign
     1461       var-code-int = int( substring( p-ss, 3, 3 ) )
     1462       var-code-chr = TRIM(substring( p-ss, 3, 3 ), "0")
     1463       rate-por = exp( 10, int( substring( p-ss, 14, 1 ) ) )
     1464       cass-rate = dec( substring( p-ss, 6, 8 ) )
     1465       no-error .
     1466       if var-code-int <= num-entries( curr-list ) AND
     1467          var-code-int > 0 AND
     1468         lookup(var-code-chr, curr-list) > 0 then do:
     1469         FIND curr-cass WHERE
     1470               curr-cass.code = int( entry( var-code-int, curr-list ) ) NO-ERROR.
     1471         if NOT available curr-cass then
     1472         CREATE curr-cass.
     1473         assign
     1474         curr-cass.code = int( entry( var-code-int, curr-list ) )
     1475         curr-cass.scale = rate-por
     1476         curr-cass.rate = cass-rate
     1477         .
     1478         if curr-cass.code = get-chkc_context.base-code then do:
     1479           assign
     1480           v-base-rate = cass-rate
     1481           v-base-scale = rate-por
     1482           .
     1483         end.
     1484       end.
     1485     end.
     1486   end procedure.
     1487   procedure proc-01 :
     1488   define input parameter p-ss as character no-undo .
     1489   DEFINE VARIABLE yy as integer no-undo.
     1490     do
     1491     on error undo, return error
     1492     :
     1493       assign
     1494       yy = int( substr( p-ss, 31, 2 ) )
     1495       yy = int( truncate( year( today ) / 100, 0 ) ) * 100 + yy
     1496       chk-num_  = int(substr(p-ss, 3, 12))
     1497       chk-date_ = date(int(substr(p-ss, 29, 2)),int(substr(p-ss, 27, 2)), yy)
     1498       chk-time_ = int(substr(p-ss, 48, 2)) * 3600 + int(substr(p-ss, 51, 2)) * 60
     1499       sales-man_ = int(substr(p-ss, 33, 4))
     1500       pay-desk_ = int(substr(p-ss, 37, 3))
     1501       cashier_ =  int(substr(ss, 40, 4))
     1502       d-card_ = left-trim(trim(substr(ss, 15, 12)), '0')
     1503       z-num_ = integer(substr(ss, 92, 4))
     1504       chk-type_ =  (if substr(ss, 46, 2) = "00":U
     1505                     then integer('1':U)
     1506                     else integer('6':U)
     1507                     )
     1508       no-error
     1509       .
     1510       if error-status:error then do:
     1511         if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     1512       end.
     1513       FIND  ub.chk-doc where
     1514             ub.chk-doc.obj-type = p-obj-type and
     1515             ub.chk-doc.obj-code = p-obj-code and
     1516             ub.chk-doc.chk-num = chk-num_ and
     1517             ub.chk-doc.chk-date = chk-date_ and
     1518             ub.chk-doc.chk-time = chk-time_ and
     1519             ub.chk-doc.sales-man = sales-man_ and
     1520             ub.chk-doc.pay-desk = pay-desk_ NO-WAIT NO-ERROR.
     1521       IF NOT AVAIL ub.chk-doc AND NOT LOCKED ub.chk-doc  AND NOT AMBIGUOUS ub.chk-doc then do:
     1522         assign
     1523         exist = no
     1524         lll = lll + 1
     1525         .
     1526         CREATE ub.chk-doc.
     1527         assign
     1528         for-chk-type = ""
     1529         lnp = 0
     1530         lng = 0
     1531         var-discnt-id = 0
     1532         ub.chk-doc.obj-code = p-obj-code
     1533         ub.chk-doc.obj-type = p-obj-type
     1534         ub.chk-doc.doc-code = (if get-chkc_context.db-num = 0
     1535                             then string(next-value(s-chk, ub))
     1536                             else string(p-obj-code) + chr(47) + string(next-value(s-chk, ub)))
     1537         ub.chk-doc.chk-num = chk-num_
     1538         ub.chk-doc.chk-date = chk-date_
     1539         ub.chk-doc.shift-date = ub.chk-doc.chk-date
     1540         ub.chk-doc.src-shift-date =  ub.chk-doc.shift-date
     1541         ub.chk-doc.shift-num = 0
     1542         ub.chk-doc.shift-name = '':U
     1543         ub.chk-doc.src-shift-name = '':U
     1544         ub.chk-doc.chk-time = chk-time_
     1545         ub.chk-doc.sales-man = sales-man_
     1546         ub.chk-doc.pay-desk = pay-desk_
     1547         ub.chk-doc.cashier = cashier_
     1548         ub.chk-doc.src-d-card = d-card_
     1549         ub.chk-doc.z-number = z-num_
     1550         ub.chk-doc.chk-type = chk-type_
     1551         ub.chk-doc.src-d-pcnt = 0
     1552         ub.chk-doc.d-pcnt = 0
     1553         ub.chk-doc.correct = yes
     1554         for-chk-type = ""
     1555         prev-code = ub.chk-doc.doc-code
     1556         .
     1557         if v-versiond >= 33.0 then do:
     1558           assign
     1559           ub.chk-doc.cash-rate = ( if (get-chkc_context.r-b = 'base':U and get-chkc_context.base-code = 0) or get-chkc_context.r-b = 'rubl':U then 1 else v-base-rate )
     1560           ub.chk-doc.cash-scale = ( if (get-chkc_context.r-b = 'base':U and get-chkc_context.base-code = 0) or get-chkc_context.r-b = 'rubl':U then 1 else v-base-scale )
     1561           .
     1562         end.
     1563         else do:
     1564           assign
     1565           ub.chk-doc.cash-rate = if avail curr-cass
     1566                         then curr-cass.rate / curr-cass.scale
     1567                         else 1
     1568           ub.chk-doc.cash-scale = 1
     1569           .
     1570         end.
     1571       end.
     1572     end.
     1573   end procedure.
     1574   procedure proc-03 :
     1575   define input parameter p-ss as character no-undo .
     1576   DEFINE VARIABLE var-sub-d as decimal no-undo .
     1577     do
     1578     on error undo, return error
     1579     :
     1580       if exist then return.
     1581       if v-versiond >= 33.0 then do:
     1582         assign
     1583         var-sub-d  = ((DEC(substr(p-ss, 20, 12)) - DEC(substr(p-ss, 51,11))) / 100)/
     1584                     ( if (get-chkc_context.r-b = 'base':U and get-chkc_context.base-code = 0) or get-chkc_context.r-b = 'rubl':U then 1 else (ub.chk-doc.cash-rate / ub.chk-doc.cash-scale))
     1585         no-error .
     1586       end.
     1587       else do:
     1588         assign
     1589         var-sub-d  = (DEC(substr(p-ss, 20, 12)) - DEC(substr(p-ss, 51,11))) / 100
     1590         no-error
     1591         .
     1592       end.
     1593       if error-status:error then do:
     1594         if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     1595       end.
     1596       if var-sub-d = 0 then return.
     1597       create ub.chk-discnt.
     1598       assign
     1599       ub.chk-discnt.doc-code = ub.chk-doc.doc-code
     1600       ub.chk-discnt.record-type = 0
     1601       ub.chk-discnt.discnt-id = (var-discnt-id + 1)
     1602       ub.chk-discnt.line-num = ub.chk-gds.line-num
     1603       ub.chk-discnt.time-oper = ub.chk-doc.chk-time
     1604       ub.chk-discnt.line-type = integer('2':U)
     1605       ub.chk-discnt.line-sign = yes
     1606       ub.chk-discnt.pass-discnt = integer('0':U)
     1607       ub.chk-discnt.value-type = integer('2':U)
     1608       ub.chk-discnt.discnt-type = if ub.chk-doc.src-d-card <> ""
     1609                                 then integer('1':U)
     1610                                 else integer('5':U)
     1611       ub.chk-discnt.src-d-card = ub.chk-doc.src-d-card
     1612       ub.chk-discnt.discnt-value-abs = var-sub-d
     1613       ub.chk-discnt.discnt-value-pcnt = if netto-for-sub-d = 0
     1614                                       then 0
     1615                                       else var-sub-d * 100 / netto-for-sub-d
     1616       ub.chk-discnt.object-line-num = 0
     1617       ub.chk-discnt.object-sum = netto-for-sub-d
     1618       ub.chk-discnt.pay-desk = ub.chk-doc.pay-desk
     1619       ub.chk-discnt.obj-code = ub.chk-doc.obj-code
     1620       ub.chk-discnt.obj-type = ub.chk-doc.obj-type
     1621       ub.chk-discnt.chk-date = ub.chk-doc.chk-date
     1622       ub.chk-discnt.chk-time = ub.chk-doc.chk-time
     1623       var-discnt-id = var-discnt-id + 1
     1624       sub-d = sub-d + var-sub-d
     1625       netto-for-sub-d = netto-for-sub-d - sub-d
     1626       .
     1627       release ub.chk-discnt.
     1628     end.
     1629   end procedure.
     1630   procedure proc-04 :
     1631   define input parameter p-ss as character no-undo .
     1632   DEFINE VARIABLE dop-code as integer no-undo .
     1633     do
     1634     on error undo, return error
     1635     :
     1636       if exist then return.
     1637       assign
     1638       pay_code = int( substr( p-ss, 3, 2 ) )
     1639       curr_code = if v-versiond >= 33.0
     1640                   then
     1641                   (if pay_code < 13 or (pay_code >= 54 and pay_code  <= 93)
     1642                   then
     1643                        integer(substr(p-ss, 5, 2))
     1644                   else ( if pay_code = 13 then base-cass else int( entry( pay_code - 13, curr-list ) ) ))
     1645                   else
     1646                   (if pay_code < 13
     1647                   then ( if not-nal-curr = 0 then 0 else get-chkc_context.base-code )
     1648                   else ( if pay_code = 13 then base-cass else int( entry( pay_code - 13, curr-list ) ) )
     1649                   )
     1650       cass-rate = decimal(substr( p-ss, 41, 10)) / 10000 / exp(10, int(substr( p-ss, 40, 1 )))
     1651       pay-card_ = trim(substr(p-ss, 53, 20))
     1652       pass-pay_ = (if substr(p-ss, 83, 1) = "A":U
     1653                    then 0
     1654                    else 1)
     1655       tot_sum = dec( substr( p-ss, 20, 12 ) ) / 100
     1656       no-error .
     1657       if error-status:error then do:
     1658         if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     1659       end.
     1660       create ub.chk-pay.
     1661       assign
     1662       lnp = lnp + 1
     1663       ub.chk-pay.doc-code = ub.chk-doc.doc-code
     1664       ub.chk-pay.pay-code = pay_code
     1665       ub.chk-pay.curr-code = curr_code
     1666       ub.chk-pay.line-num = lnp
     1667       ub.chk-pay.chk-date = ub.chk-doc.chk-date
     1668       ub.chk-pay.tot-sum = tot_sum
     1669       ub.chk-pay.obj-code = p-obj-code
     1670       ub.chk-pay.obj-type = p-obj-type
     1671       ub.chk-pay.time-oper = ub.chk-doc.chk-time
     1672       ub.chk-pay.cash-rate = cass-rate / ub.chk-doc.cash-rate
     1673       ub.chk-pay.bank-rate = 1
     1674       ub.chk-pay.bank-scale = 1
     1675       ub.chk-pay.pass-pay = pass-pay_
     1676       ub.chk-pay.pay-card = pay-card
     1677       ub.chk-pay.line-type = "":U
     1678       ub.chk-pay.line-sign = (if ub.chk-doc.chk-type = integer('1':U)
     1679                           then (chk-pay.tot-sum >= 0)
     1680                           else (chk-pay.tot-sum <= 0)
     1681                           )
     1682       ub.chk-pay.is-error = no
     1683       .
     1684     end.
     1685   end procedure.
     1686   procedure proc-11-12 :
     1687   define input parameter p-ss as character no-undo .
     1688   DEFINE VARIABLE discnt-sale as integer no-undo .
     1689   DEFINE VARIABLE discnt-value as decimal no-undo .
     1690   define variable m-sign as character no-undo .
     1691     do
     1692     on error undo, return error
     1693     :
     1694       if exist then return.
     1695       if v-versiond >= 33.0 then do:
     1696         assign
     1697         price-from-check = (dec( substr( p-ss, 65, 12 ) ) / 100 )
     1698         curr-string-qnty = dec( substr( p-ss, 32, 8 ) ) / 100
     1699         bc-buf = trim(substr( p-ss, 5, 16 ))
     1700         discnt-sale = integer(substr( p-ss, 3, 2 ))
     1701         discnt-value = - dec( substr(p-ss, 40, 11 ) ) / 100
     1702         sales-man_ = integer(substr(p-ss, 123, 4))
     1703         no-error.
     1704       end.
     1705       else do:
     1706         assign
     1707         m-sign           = substr(p-ss, 32, 1)
     1708         price-from-check = dec( substr( p-ss, 21, 11 ) ) / 100
     1709         curr-string-qnty = dec( substr( p-ss, 32, 8 ) ) / 100
     1710         bc-buf = trim(substr( p-ss, 5, 16 ))
     1711         discnt-sale = integer(substr( p-ss, 3, 2 ))
     1712         discnt-value = dec( substr(p-ss, 40, 11 ) ) / 100
     1713         no-error.
     1714       end.
     1715       if error-status:error then do:
     1716         if file_ begins "<?xml" then                                                   v-error-message = "!!!Неверный формат спула файла: " +  substring(error-status:get-message(1),1,300).   else                                                                           v-error-message = "!!!Неверный формат спула файла " + substring(file_, 1, 150) +       ": строка " + string(var-file-line-num) + ": " + substring(error-status:get-message(1),1,300).   if v-error-message = ? then v-error-message = "!!!Неверный формат спула файла ".   run write-log-and-file in p-log-handle (                                           input 1                                                                    , input log-file-name                                                        , input 1                                                                    , input v-error-message                                                                                      ).                                            assign                                                                       p-view-log = yes                                                            exist = yes                                                                  mc-exist = yes                                                               .                                                                            return.
     1717       end.
     1718       if not v-versiond >= 33.0 then do:
     1719         if m-sign = '-' and lng = 0 then do:
     1720           assign
     1721           ub.chk-doc.chk-type = integer('6':U).
     1722         end.
     1723       end.
     1724       if unq-artc then  do:
     1725         FIND first ub.goods where
     1726                     ub.goods.artic = bc-buf no-lock NO-ERROR.
     1727         if available ub.goods then do:
     1728           FIND FIRST ub.gds-prt where
     1729                       ub.gds-prt.upper-code = ub.goods.prt-root      no-lock.
     1730           FIND FIRST ub.bar-code where
     1731                       ub.bar-code.gds-code = ub.goods.gds-code and
     1732                       ub.BAR-CODE.UNIT-CLI = ub.GOODS.UNIT-BASE and
     1733                       ub.BAR-CODE.IN-CODE = "" and
     1734                       ub.BAR-CODE.PART-CODE = "" No-LOCK.
     1735           assign
     1736           bc-buf = if avail ub.bar-code
     1737                   then string(ub.bar-code.b-code)
     1738                   else "":U
     1739           .
     1740         end.
     1741       end.
     1742       if curr-string-qnty <> 0 then  do:
     1743         CREATE ub.chk-gds.
     1744         assign
     1745         lng = lng + 1
     1746         ub.chk-gds.doc-code = ub.chk-doc.doc-code
     1747         ub.chk-gds.line-num = lng
     1748         ub.chk-gds.chk-date = ub.chk-doc.chk-date
     1749         ub.chk-gds.b-code =  0
     1750         ub.chk-gds.grp-code = 0
     1751         ub.chk-gds.src-code = bc-buf
     1752         ub.chk-gds.is-error = no
     1753         ub.chk-gds.price-base = price-from-check
     1754         ub.chk-gds.src-qnty = curr-string-qnty
     1755         ub.chk-gds.doc-qnty = 0
     1756         ub.chk-gds.src-price = price-from-check
     1757         ub.chk-gds.src-sum   =  ub.chk-gds.src-qnty * ub.chk-gds.src-price
     1758         ub.chk-gds.src-discnt = 0
     1759         ub.chk-gds.pass-gds = 0
     1760         ub.chk-gds.line-type =  "":U
     1761         ub.chk-gds.time-oper = ub.chk-doc.chk-time
     1762         ub.chk-gds.line-sign = (if ub.chk-doc.chk-type = integer('1':U)
     1763                             then (chk-gds.src-qnty >= 0)
     1764                             else (chk-gds.src-qnty <= 0)
     1765                             )
     1766         ub.chk-gds.src-discnt = if v-versiond >= 33.0
     1767                              then
     1768                              (if discnt-sale = 41
     1769                               then ub.chk-gds.src-price * discnt-value / 100
     1770                               else (  if discnt-sale = 42
     1771                                       then discnt-value / ub.chk-gds.src-qnty / (ub.chk-doc.cash-rate / ub.chk-doc.cash-scale)
     1772                                       else  ub.chk-gds.src-discnt
     1773                                   ))
     1774                              else
     1775                              (if discnt-sale = 41
     1776                               then ub.chk-gds.src-price * discnt-value / 100
     1777                               else (  if discnt-sale = 42
     1778                                       then discnt-value / ub.chk-gds.src-qnty
     1779                                       else  ub.chk-gds.src-discnt
     1780                                   )
     1781                              )
     1782         netto-for-sub-d = netto-for-sub-d + ub.chk-gds.src-sum - ub.chk-gds.src-discnt * ub.chk-gds.src-qnty
     1783         .
     1784         if ub.chk-gds.src-discnt <> 0 then do:
     1785           create ub.chk-discnt.
     1786           assign
     1787           ub.chk-discnt.doc-code = ub.chk-doc.doc-code
     1788           ub.chk-discnt.record-type = 0
     1789           ub.chk-discnt.discnt-id = (var-discnt-id + 1)
     1790           ub.chk-discnt.line-num = ub.chk-gds.line-num
     1791           ub.chk-discnt.time-oper = ub.chk-doc.chk-time
     1792           ub.chk-discnt.line-type = integer('1':U)
     1793           ub.chk-discnt.line-sign =  (chk-gds.src-qnty >= 0 ) NE (chk-gds.src-discnt > 0 )
     1794           ub.chk-discnt.pass-discnt = integer('0':U)
     1795           ub.chk-discnt.value-type = integer('0':U)
     1796           ub.chk-discnt.discnt-type = integer('0':U)
     1797           ub.chk-discnt.src-d-card = ub.chk-doc.src-d-card
     1798           ub.chk-discnt.discnt-value-abs = ub.chk-gds.src-discnt
     1799           ub.chk-discnt.object-qnty = ub.chk-gds.src-qnty
     1800           ub.chk-discnt.object-sum = ub.chk-gds.src-sum
     1801           ub.chk-discnt.discnt-value-pcnt = if ub.chk-gds.src-sum <> 0 then
     1802                                           ub.chk-gds.src-discnt * ub.chk-gds.src-qnty / ub.chk-gds.src-sum * 100
     1803                                           else 0
     1804           ub.chk-discnt.object-line-num = ub.chk-gds.line-num
     1805           ub.chk-discnt.pay-desk = ub.chk-doc.pay-desk
     1806           ub.chk-discnt.obj-code = ub.chk-doc.obj-code
     1807           ub.chk-discnt.obj-type = ub.chk-doc.obj-type
     1808           ub.chk-discnt.chk-date = ub.chk-doc.chk-date
     1809           ub.chk-discnt.chk-time = ub.chk-doc.chk-time
     1810           var-discnt-id = var-discnt-id + 1
     1811           .
     1812         end.
     1813       end.
     1814     end.
     1815   end procedure.
     1816   procedure proc-end :
     1817     do
     1818     on error undo, return error
     1819     :
     1820        get-chkc_context.ll = lll.
     1821   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1822   if (valid-handle(g#libchkvl) <> true) then do:   run str/libchkvl.p persistent no-error .   if error-status :error or (valid-handle(g#libchkvl) <> true) then do:     message       "Error starting nws/libchkvl.p" skip       g#libchkvl skip       g#libchkvl :type skip       g#libchkvl :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libchkvl_getcheck in g#libchkvl
     1823     (input  buffer get-chkc_context:handle
     1824     ,input  'ДОБАВЛЕНИЕ':U
     1825     ,input  ''
     1826     ,input  yes
     1827     ,input  yes
     1828     ,input  ?
     1829     ,input  lng-sub-d
     1830     ,input  sub-d
     1831     ,input  var-discnt-id
     1832     ,input-output prev-code
     1833       ) no-error .
     1834        assign
     1835        prev-code = "":U
     1836        mc-prev-code = "":U
     1837        p-view-log = (p-view-log or get-chkc_context.view-log)
     1838        lll = get-chkc_context.ll
     1839        .
     1840     end.
     1841   end procedure.
