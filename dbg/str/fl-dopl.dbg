      717         VIEW-AS TEXT
      718        SIZE 15 BY .67
      719        FGCOLOR 12  NO-UNDO.
      720   DEFINE VARIABLE v-bef-date AS CHARACTER FORMAT "X(256)":U
      721        LABEL "Дата чека"
      722         VIEW-AS TEXT
      723        SIZE 14 BY .67 NO-UNDO.
