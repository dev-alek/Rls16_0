      824        v-bef-n AT ROW 13 COL 41.5 COLON-ALIGNED
      825        v-bef-date AT ROW 13 COL 70 COLON-ALIGNED
      826        f-4 AT ROW 15 COL 2 NO-LABEL
      827        v-sum-new-rubl AT ROW 19 COL 73 COLON-ALIGNED
      828        f-5 AT ROW 15 COL 47.5 NO-LABEL
      829        v-sum-new-base AT ROW 18.25 COL 73 COLON-ALIGNED
      830        v-pr-new AT ROW 21.5 COL 73 COLON-ALIGNED
      831        F-6 AT ROW 17.25 COL 21 COLON-ALIGNED
      832        SPACE(53.12) SKIP(4.70)
      833       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      834            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      835            TITLE "Доплата по документу"
      836            CANCEL-BUTTON B-exit.
      837   ASSIGN
      838          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      839          FRAME Dialog-Frame:HIDDEN           = TRUE.
      840   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      841   DO:
      842     APPLY "END-ERROR":U TO SELF.
      843   END.
      844   ON CHOOSE OF B-calc IN FRAME Dialog-Frame
      845   DO:
      846     run proc-recalc.
      847     DISPLAY v-pr-new v-sum-new-base v-sum-new-rubl f-6 WITH FRAME Dialog-Frame .
      848   END.
      849   ON CHOOSE OF B-ok IN FRAME Dialog-Frame
      850   DO:
      851     ASSIGN
      852         v-date
      853         v-n
      854         v-sum
      855         .
      856        if v-date <> ? then do:
