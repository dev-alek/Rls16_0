      582   procedure proc-alt-shift-f2:
      583     if not ibs.th.gbl.gbl-var:rcode
      584   then
      585     run gbl\inidebug.p .
      586   end.
      587   procedure proc-alt-shift-f3:
      588     run gbl/prvssinf.p
      589       ( input this-procedure
      590       ) .
      591   end.
      592   define variable v-inform-launched as logical no-undo initial false .
      593   procedure proc-alt-shift-f4:
      594     define variable v-action as character no-undo .
      595     if v-inform-launched = false then do:
      596       assign
      597         v-inform-launched = true
      598       .
      599       run gbl/d-inform.w
      600         (  input self
      601         ,  input this-procedure
      602         , output v-action
      603         ) no-error .
      604       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      605       assign
      606         v-inform-launched = false
      607       .
      608     end.
      609   end.
      610   procedure proc-alt-f1:
      611     run gbl/corrhelp.p
      612       (input this-procedure
      613       ) .
      614   end .
      615   on alt-shift-f2 anywhere do:
      616     run proc-alt-shift-f2.
      617   end.
      618   on alt-shift-f3 anywhere do:
      619     run proc-alt-shift-f3 in this-procedure .
      620   end.
      621   on alt-shift-f4 anywhere do:
      622     run proc-alt-shift-f4 in this-procedure.
      623   end.
      624   on alt-f1 anywhere do:
      625     run proc-alt-f1 in this-procedure .
      626   end.
