        1   DEFINE TEMP-TABLE tt-doc-line-attr NO-UNDO LIKE doc-line-attr
        2          field node-code as int
        3          field price-rubl as dec
        4          field price-base as dec.
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Доплата по документу (флористы)".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define new global shared variable g#lib-trn  as handle no-undo .
       72   define new global shared variable g#lib-trn2 as handle no-undo .
       73   define new global shared variable g#lib-trn3 as handle no-undo .
       74   define new global shared variable g#lib-trn4 as handle no-undo .
       75   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   procedure lineattr-value :
       77     do
       78     on error undo, return error return-value
       79     :
       80       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
       81       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
       82       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
       83       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
       84       define output parameter p-type     as character no-undo .
       85       define buffer buf_doc-line-attr for ub.doc-line-attr .
       86       def var v-format         as character no-undo .
       87       def var v-fillin_width   as integer   no-undo .
       88       def var v-fillin_height  as integer   no-undo .
       89       def var v-label          as character no-undo .
       90       def var v-user-can-edit  as logical   no-undo .
       91       def var v-output-display as logical   no-undo .
       92       def var v-other          as character no-undo .
       93       run lineattr-code in this-procedure
       94         (input  p-code
       95         ,output p-type
       96         ,output v-format
       97         ,output v-fillin_width
       98         ,output v-fillin_height
       99         ,output v-label
      100         ,output v-user-can-edit
      101         ,output v-output-display
      102         ,output v-other
      103         ) no-error .
      104       if error-status :error then do:
      105         undo, return error return-value .
      106       end.
      107       find first buf_doc-line-attr no-lock
      108         where buf_doc-line-attr.doc-code  = p-doc-code
      109           and buf_doc-line-attr.gds-code  = p-gds-code
      110           and buf_doc-line-attr.attr-code = p-code
      111         no-error .
      112       if avail buf_doc-line-attr then do:
      113         assign
      114           p-value =  buf_doc-line-attr.attr-value
      115         .
      116       end.
      117       else do:
      118         assign
      119           p-value = if p-type = 'L':U then "no":U else ""
      120         .
      121       end.
      122     end.
      123   end procedure.
      124   procedure lineattr-write :
      125     do
      126     on error undo, return error return-value
      127     :
      128       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      129       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      130       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      131       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
      132       define buffer buf_doc-line-attr for ub.doc-line-attr .
      133       def var v-type           as character no-undo .
      134       def var v-format         as character no-undo .
      135       def var v-fillin_width   as integer   no-undo .
      136       def var v-fillin_height  as integer   no-undo .
      137       def var v-label          as character no-undo .
      138       def var v-user-can-edit  as logical   no-undo .
      139       def var v-output-display as logical   no-undo .
      140       def var v-other          as character no-undo .
      141       run lineattr-code in this-procedure
      142         (input  p-code
      143         ,output v-type
      144         ,output v-format
      145         ,output v-fillin_width
      146         ,output v-fillin_height
      147         ,output v-label
      148         ,output v-user-can-edit
      149         ,output v-output-display
      150         ,output v-other
      151         ) no-error .
      152       if error-status :error then do:
      153         undo, return error return-value .
      154       end.
      155       find first buf_doc-line-attr exclusive-lock
      156         where buf_doc-line-attr.doc-code  = p-doc-code
      157           and buf_doc-line-attr.gds-code  = p-gds-code
      158           and buf_doc-line-attr.attr-code = p-code
      159         no-error .
      160       if not available buf_doc-line-attr then do:
      161         create buf_doc-line-attr .
      162         assign
      163           buf_doc-line-attr.doc-code  = p-doc-code
      164           buf_doc-line-attr.gds-code = p-gds-code
      165           buf_doc-line-attr.attr-code = p-code
      166         .
      167       end.
      168       assign
      169         buf_doc-line-attr.attr-value = p-value
      170       .
      171        release buf_doc-line-attr.
      172     end.
      173   end procedure.
      174   procedure lineattr-exist :
      175     do
      176     on error undo, return error return-value
      177     :
      178       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      179       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      180       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      181       define output parameter p-exist   as logical  no-undo .
      182       define buffer buf_doc-line-attr for ub.doc-line-attr .
      183       def var v-type           as character no-undo .
      184       def var v-format         as character no-undo .
      185       def var v-fillin_width   as integer   no-undo .
      186       def var v-fillin_height  as integer   no-undo .
      187       def var v-label          as character no-undo .
      188       def var v-user-can-edit  as logical   no-undo .
      189       def var v-output-display as logical   no-undo .
      190       def var v-other          as character no-undo .
      191       run lineattr-code in this-procedure
      192         (input  p-code
      193         ,output v-type
      194         ,output v-format
      195         ,output v-fillin_width
      196         ,output v-fillin_height
      197         ,output v-label
      198         ,output v-user-can-edit
      199         ,output v-output-display
      200         ,output v-other
      201         ) no-error .
      202       if error-status :error then do:
      203         undo, return error return-value .
      204       end.
      205       find first buf_doc-line-attr no-lock
      206         where buf_doc-line-attr.doc-code  = p-doc-code
      207           and buf_doc-line-attr.gds-code = p-gds-code
      208           and buf_doc-line-attr.attr-code = p-code
      209         no-error .
      210       if  available buf_doc-line-attr then do:
      211         p-exist = yes.
      212       end.
      213     end.
      214   end procedure.
      215   procedure lineattr-delete :
      216     do
      217     on error undo, return error return-value
      218     :
      219       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      220       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      221       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      222       define output parameter p-deleted  as logical no-undo.
      223       define buffer buf_doc-line-attr for ub.doc-line-attr .
      224       def var v-type           as character no-undo .
      225       def var v-format         as character no-undo .
      226       def var v-fillin_width   as integer   no-undo .
      227       def var v-fillin_height  as integer   no-undo .
      228       def var v-label          as character no-undo .
      229       def var v-user-can-edit  as logical   no-undo .
      230       def var v-output-display as logical   no-undo .
      231       def var v-other          as character no-undo .
      232       run lineattr-code in this-procedure
      233         (input  p-code
      234         ,output v-type
      235         ,output v-format
      236         ,output v-fillin_width
      237         ,output v-fillin_height
      238         ,output v-label
      239         ,output v-user-can-edit
      240         ,output v-output-display
      241         ,output v-other
      242         ) no-error .
      243       if error-status :error then do:
      244         undo, return error return-value .
      245       end.
      246       find first buf_doc-line-attr exclusive-lock
      247         where buf_doc-line-attr.doc-code  = p-doc-code
      248           and buf_doc-line-attr.gds-code  = p-gds-code
      249           and buf_doc-line-attr.attr-code = p-code
      250         no-error NO-WAIT.
      251       if not available buf_doc-line-attr then do:
      252         p-deleted = no.
      253       end.
      254       else do:
      255         delete buf_doc-line-attr.
      256         p-deleted = yes.
      257       end.
      258     end.
      259   end procedure.
      260   procedure lineattr-code :
      261     do on error undo, return error return-value
      262     :
      263       define input  parameter p-code           as character no-undo .
      264       define output parameter p-type           as character no-undo .
      265       define output parameter p-format         as character no-undo .
      266       define output parameter p-fillin_width   as integer   no-undo .
      267       define output parameter p-fillin_height  as integer   no-undo .
      268       define output parameter p-label          as character no-undo .
      269       define output parameter p-user-can-edit  as logical   no-undo .
      270       define output parameter p-output-display as logical   no-undo .
      271       define output parameter p-other          as character no-undo .
      272       case p-code :
      273               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      274               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      275               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      276               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      277               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      278               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      279               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      280               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
      281               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      282               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      283               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
      284         otherwise do:
      285           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
      286         end.
      287       end.
      288     end.
      289   end procedure.
      290   procedure lineattr-value-flora-gds :
      291     do
      292     on error undo, return error return-value
      293     :
      294       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      295       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      296       define input  parameter p-prt-code    as integer   no-undo .
      297       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      298       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      299       define output parameter p-value       as    decimal   no-undo .
      300       define buffer buf_doc-line-attr for ub.doc-line-attr .
      301       find first buf_doc-line-attr no-lock
      302         where buf_doc-line-attr.doc-code  = p-doc-code
      303           and buf_doc-line-attr.gds-code  = p-gds-code
      304           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      305         no-error .
      306       if avail buf_doc-line-attr then do:
      307         assign
      308           p-value = decimal( buf_doc-line-attr.attr-value)
      309         .
      310       end.
      311       else do:
      312         assign
      313           p-value = 0
      314         .
      315       end.
      316     end.
      317   end procedure.
      318   procedure lineattr-write-flora-gds :
      319     do
      320     on error undo, return error return-value
      321     :
      322       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      323       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      324       define input parameter p-prt-code    as integer   no-undo .
      325       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      326       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      327       define input parameter p-value    as decimal   no-undo .
      328       define buffer buf_doc-line-attr for ub.doc-line-attr .
      329       find first buf_doc-line-attr exclusive-lock
      330         where buf_doc-line-attr.doc-code  = p-doc-code
      331           and buf_doc-line-attr.gds-code  = p-gds-code
      332           and buf_doc-line-attr.attr-code = p-code + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      333         no-error .
      334       if not available buf_doc-line-attr then do:
      335         create buf_doc-line-attr .
      336         assign
      337           buf_doc-line-attr.doc-code  = p-doc-code
      338           buf_doc-line-attr.gds-code  = p-gds-code
      339           buf_doc-line-attr.attr-code = p-code  + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      340         .
      341       end.
      342       assign
      343         buf_doc-line-attr.attr-value = string( p-value )
      344       .
      345     end.
      346   end procedure.
      347   procedure lineattr-delete-flora-gds :
      348     do
      349     on error undo, return error return-value
      350     :
      351       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      352       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      353       define input  parameter p-prt-code    as integer   no-undo .
      354       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
      355       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
      356       define output parameter p-deleted  as logical no-undo.
      357       define buffer buf_doc-line-attr for ub.doc-line-attr .
      358       find first buf_doc-line-attr exclusive-lock
      359         where buf_doc-line-attr.doc-code  = p-doc-code
      360           and buf_doc-line-attr.gds-code  = p-gds-code
      361           and buf_doc-line-attr.attr-code = p-code + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      362         no-error NO-WAIT.
      363       if not available buf_doc-line-attr then do:
      364         p-deleted = no.
      365       end.
      366       else do:
      367         delete buf_doc-line-attr.
      368         p-deleted = yes.
      369       end.
      370     end.
      371   end procedure.
      372   procedure lineattr-delete-flora-all :
      373     do
      374     on error undo, return error return-value
      375     :
      376       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      377       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      378       define input  parameter p-prt-code    as integer   no-undo .
      379       define buffer buf_doc-line-attr for ub.doc-line-attr .
      380       for each buf_doc-line-attr exclusive-lock
      381         where buf_doc-line-attr.doc-code  = p-doc-code
      382           and buf_doc-line-attr.gds-code  = p-gds-code
      383           and buf_doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(p-prt-code)  + chr(44)
      384        :
      385         delete buf_doc-line-attr.
      386       end.
      387    end.
      388   end procedure.
      389   procedure lineattr-exist-flora-gds :
      390     do
      391     on error undo, return error return-value
      392     :
      393       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      394       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      395       define input  parameter p-prt-code    as integer   no-undo .
      396       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
      397       define output parameter p-exist as logical   no-undo .
      398       define buffer buf_doc-line-attr for ub.doc-line-attr .
      399       p-exist = false .
      400       find first buf_doc-line-attr no-lock
      401         where buf_doc-line-attr.doc-code  = p-doc-code
      402           and buf_doc-line-attr.gds-code  = p-gds-code
      403           and buf_doc-line-attr.attr-code = 'fl_gds-code':U  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
      404         no-error .
      405       if avail buf_doc-line-attr then do:
      406         assign
      407          p-exist = true
      408         .
      409       end.
      410     end.
      411   end procedure.
      412   procedure lineattr-write-add-line-cli :
      413   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      414   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      415   define input  parameter p-cli-type      as character no-undo .
      416   define input  parameter p-cli-code      as integer   no-undo .
      417   define input  parameter p-contract-code as integer   no-undo .
      418   define input  parameter p-host-code     as integer   no-undo .
      419   define input  parameter p-exch-code     as integer   no-undo .
      420   define input  parameter p-exch-rate     as decimal   no-undo .
      421   define input  parameter p-exch-scale    as integer   no-undo .
      422   define input  parameter p-sum-cli       as decimal   no-undo .
      423   define input  parameter p-sum-vat       as decimal   no-undo .
      424   define buffer buf_doc-line-attr for ub.doc-line-attr .
      425     do
      426     on error undo, return error return-value
      427     :
      428       find first buf_doc-line-attr exclusive-lock
      429         where buf_doc-line-attr.doc-code  = p-doc-code
      430           and buf_doc-line-attr.gds-code  = p-gds-code
      431           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      432                                             chr(4) + p-cli-type +
      433                                             chr(4) + string(p-cli-code) +
      434                                             chr(4) + string(p-contract-code) +
      435                                             chr(4) + string(p-host-code)
      436         no-error .
      437       if not available buf_doc-line-attr then do:
      438         create buf_doc-line-attr .
      439         assign
      440           buf_doc-line-attr.doc-code  = p-doc-code
      441           buf_doc-line-attr.gds-code  = p-gds-code
      442           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
      443                                         chr(4) + p-cli-type +
      444                                         chr(4) + string(p-cli-code) +
      445                                         chr(4) + string(p-contract-code) +
      446                                         chr(4) + string(p-host-code)
      447         .
      448       end.
      449       assign
      450         buf_doc-line-attr.attr-value =
      451         string(p-exch-code)  + chr(4) +
      452         string(p-exch-rate)  + chr(4) +
      453         string(p-exch-scale) + chr(4) +
      454         string(p-sum-cli)    + chr(4) +
      455         string(p-sum-vat)
      456         .
      457     end.
      458   end procedure.
      459   procedure lineattr-value-add-line-cli :
      460   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
      461   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
      462   define input   parameter p-cli-type      as character no-undo .
      463   define input   parameter p-cli-code      as integer   no-undo .
      464   define input   parameter p-contract-code as integer   no-undo .
      465   define input   parameter p-host-code     as integer   no-undo .
      466   define output  parameter p-exch-code     as integer   no-undo .
      467   define output  parameter p-exch-rate     as decimal   no-undo .
      468   define output  parameter p-exch-scale    as integer   no-undo .
      469   define output  parameter p-sum-cli       as decimal   no-undo .
      470   define output  parameter p-sum-vat       as decimal   no-undo .
      471   define buffer buf_doc-line-attr for ub.doc-line-attr .
      472     do
      473     on error undo, return error return-value
      474     :
      475       find first buf_doc-line-attr exclusive-lock
      476         where buf_doc-line-attr.doc-code  = p-doc-code
      477           and buf_doc-line-attr.gds-code  = p-gds-code
      478           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
      479                                             chr(4) + p-cli-type +
      480                                             chr(4) + string(p-cli-code) +
      481                                             chr(4) + string(p-contract-code) +
      482                                             chr(4) + string(p-host-code)
      483         no-error .
      484       if available buf_doc-line-attr then do:
      485        assign
      486           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
      487           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
      488           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
      489           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
      490           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
      491          .
      492        end.
      493     end.
      494   end procedure.
      495   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
      496     define variable v-code as character no-undo .
      497     define variable v-type as character no-undo .
      498     define variable v-gds-code as integer   no-undo .
      499   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      500   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      501     (input  local-doc-line.artic
      502     ,input  local-doc-line.prod-type
      503     ,input  local-doc-line.prod-code
      504     ,output v-gds-code
      505     )  .
      506     run lineattr-value (
      507         input   local-doc-line.doc-code ,
      508         input   v-gds-code              ,
      509         input   'reason-code':U ,
      510         output  v-code                  ,
      511         output  v-type ) .
      512     find first ub.trn-reason no-lock where
      513                ub.trn-reason.reason-code = integer ( v-code ) no-error.
      514     if not available ub.trn-reason then do:
      515        return "" .
      516     end.
      517     else do:
      518        return ub.trn-reason.reason-name .
      519     end.
      520   end function.
      521   procedure lineattr-value-parts :
      522     do
      523     on error undo, return error return-value
      524     :
      525       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
      526       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
      527       define input  parameter p-part-code   as character no-undo .
      528       define input  parameter p_in-code     as character no-undo .
      529       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
      530       define output parameter p-value       as    decimal   no-undo .
      531       define buffer buf_doc-line-attr for ub.doc-line-attr .
      532       find first buf_doc-line-attr no-lock
      533         where buf_doc-line-attr.doc-code  = p-doc-code
      534           and buf_doc-line-attr.gds-code  = p-gds-code
      535           and buf_doc-line-attr.attr-code = p-code  + chr(4) + trim(p-part-code)  + chr(4) + trim(p_in-code)
      536         no-error .
      537       if avail buf_doc-line-attr then do:
      538         assign
      539           p-value = decimal( buf_doc-line-attr.attr-value)
      540         .
      541       end.
      542       else do:
      543         assign
      544           p-value = 0
      545         .
      546       end.
      547     end.
      548   end procedure.
      549   procedure lineattr-write-parts :
      550     do
      551     on error undo, return error return-value
      552     :
      553       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
      554       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
      555       define input parameter p-part-code  as character no-undo .
      556       define input parameter p_in-code    as character no-undo .
      557       define input parameter p-code       like ub.doc-line-attr.attr-code  no-undo .
      558       define input parameter p-value      as decimal   no-undo .
      559       define buffer buf_doc-line-attr for ub.doc-line-attr .
      560       find first buf_doc-line-attr exclusive-lock
      561         where buf_doc-line-attr.doc-code  = p-doc-code
      562           and buf_doc-line-attr.gds-code  = p-gds-code
      563           and buf_doc-line-attr.attr-code = p-code + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
      564         no-error .
      565       if not available buf_doc-line-attr then do:
      566         create buf_doc-line-attr .
      567         assign
      568           buf_doc-line-attr.doc-code  = p-doc-code
      569           buf_doc-line-attr.gds-code  = p-gds-code
      570           buf_doc-line-attr.attr-code = p-code  + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
      571         .
      572       end.
      573       assign
      574         buf_doc-line-attr.attr-value = string( p-value )
      575       .
      576     end.
      577   end procedure.
      578   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      579   define new global shared variable g#trdcalib as handle no-undo.
      580   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
