      902   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      903   on help of frame Dialog-Frame
      904   do:
      905     run gbl/app_help.p
      906       (input this-procedure :file-name
      907       ,input ''
      908       ,input ?
      909       ) no-error.
      910     if error-status :error then do:
      911       message
      912         "Ошибка при вызове помощи"
      913         error-status :get-message(1)
      914         view-as alert-box .
      915     end.
      916   end.
      917   run minbtn-set in this-procedure .
      918   on choose of b-help in frame Dialog-Frame
      919   do:
      920     apply "help":u to frame Dialog-Frame .
      921   end.
      922   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      923   procedure minbtn-set :
      924       do
      925           on error undo, return error return-value
      926           :
      927           define variable ii              as integer       no-undo .
      928           define variable fh              as widget-handle no-undo .
      929           define variable hh              as widget-handle no-undo .
      930           define variable v-h             as handle        extent 4 no-undo .
      931           define variable v-name-button   as character     no-undo .
      932           define variable v-help-old-x    as decimal       no-undo .
      933           define variable v-help-old-y    as decimal       no-undo .
      934           define variable v-help-old-size as decimal       no-undo .
      935           define variable v-frame-width   as decimal       no-undo .
      936           define variable jj              as integer       no-undo .
      937           do
      938               on error undo, return error
      939               :
      940               assign
      941                   v-frame-width = frame Dialog-Frame:width - 0.3
      942                   fh            = frame Dialog-Frame:first-child
      943                   hh            = fh:first-child
      944                   ii            = 1
      945                   .
      946               do while valid-handle(hh):
      947                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      948                   do:
      949                       case lc(hh:name) :
      950                           when "b-help" then
      951                               do:
      952                                   hh:load-image-up("cmp/b-help.bmp":u) .
      953                                   hh:load-image-down("cmp/b-help.bmp":u) .
      954                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      955                                   hh:TOOLTIP = "Помощь" .
      956                                   v-help-old-x = hh:column .
      957                                   v-help-old-y = hh:row    .
      958                                   v-help-old-size = hh:width .
      959                                   hh:width-chars = 2.5 .
      960                               end.
      961                           when "b-print" then
      962                               do:
      963                                   hh:load-image("cmp/b-print.bmp":u) .
      964                                   hh:TOOLTIP = "Печать" .
      965                                   v-h[ii] = hh:handle .
      966                                   ii = ii + 1 .
      967                                   hh:width-chars = 3 .
      968                               end.
      969                           when "b-history" or
      970                           when "b-hist" then
      971                               do:
      972                                   hh:load-image("cmp/b-hist.bmp":u) .
      973                                   hh:TOOLTIP = "История" .
      974                                   v-h[ii] = hh:handle .
      975                                   ii = ii + 1 .
      976                                   hh:width-chars = 3 .
      977                               end.
      978                           when "b-sch" then
      979                               do:
      980                                   hh:load-image("cmp/b-sch.bmp":u) .
      981                                   hh:TOOLTIP = "Установка Фильтра" .
      982                                   v-h[ii] = hh:handle .
      983                                   ii = ii + 1 .
      984                                   hh:width-chars = 3 .
      985                               end.
      986                           when "b-hist-user" then
      987                               do:
      988                                   hh:load-image("cmp/b-hist.bmp":u) .
      989                                   hh:TOOLTIP = "История пользователя" .
      990                                   ii = ii + 1 .
      991                               end.
      992                       end case.
      993                   end.
      994                   hh = hh:next-sibling.
      995               end.
      996               b-help:column = v-frame-width - b-help:width-chars.
      997               jj = 0.
      998               repeat ii = 4 to 1 by -1 :
      999                   if valid-handle (v-h[ii] ) then
     1000                   do:
     1001                       jj  = jj + 1 .
     1002                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1003                       v-h[ii]:row    = v-help-old-y .
     1004                   end.
     1005               end.
     1006           end.
     1007       end.
     1008   end procedure.
     1009   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1010   on ' ' of v-date in frame Dialog-Frame
     1011   do:
     1012     if (can-query (self, "sensitive")
     1013        and
     1014        self :sensitive = true
     1015        )
     1016     or (can-query (self, "read-only")
     1017        and
     1018        self :read-only = false
     1019        )
     1020     then do:
     1021       assign
     1022         self :screen-value = ?
     1023       .
     1024     end.
     1025     return no-apply.
     1026   end.
     1027   on delete-character of v-date in frame Dialog-Frame
     1028   do:
     1029     if (can-query (self, "sensitive")
     1030        and
     1031        self :sensitive = true
     1032        )
     1033     or (can-query (self, "read-only")
     1034        and
     1035        self :read-only = false
     1036        )
     1037     then do:
     1038       assign
     1039         self :screen-value = ?
     1040       .
     1041     end.
     1042     return no-apply.
     1043   end.
     1044   on ctrl-d of v-date in frame Dialog-Frame
     1045   do:
     1046     define variable v-curr-sv-date as date no-undo .
     1047     if (can-query (self, "sensitive")
     1048        and
     1049        self :sensitive = true
     1050        )
     1051     or (can-query (self, "read-only")
     1052        and
     1053        self :read-only = false
     1054        )
     1055     then do:
     1056       if self :handle <> focus :handle
     1057       then do:
     1058         apply "entry":u to self .
     1059       end.
     1060       run gbl/getcurdt.p
     1061         (output v-curr-sv-date
     1062         ) .
     1063       assign
     1064         self :screen-value = string(v-curr-sv-date) .
     1065       .
     1066     end.
     1067     return no-apply.
     1068   end.
     1069   on ctrl-b of v-date in frame Dialog-Frame
     1070   do:
     1071     if (can-query (self, "sensitive")
     1072        and
     1073        self :sensitive = true
     1074        )
     1075     or (can-query (self, "read-only")
     1076        and
     1077        self :read-only = false
     1078        )
     1079     then do:
     1080       if self :handle <> focus :handle
     1081       then do:
     1082         apply "entry":u to self .
     1083       end.
     1084       define variable v-curr-sv-date as date no-undo .
     1085       define variable v-new-sv-date  as date no-undo .
     1086       assign
     1087         v-curr-sv-date = date(self :screen-value) no-error
     1088       .
     1089       if v-curr-sv-date = ?
     1090       then do:
     1091         run gbl/getcurdt.p
     1092           (output v-curr-sv-date
     1093           ) .
     1094       end.
     1095       if v-curr-sv-date <> ?
     1096       then do:
     1097         assign
     1098           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1099         .
     1100         assign
     1101           self :screen-value = string(v-new-sv-date) .
     1102         .
     1103       end.
     1104     end.
     1105     return no-apply .
     1106   end.
     1107   on ctrl-e of v-date in frame Dialog-Frame
     1108   do:
     1109     if (can-query (self, "sensitive")
     1110        and
     1111        self :sensitive = true
     1112        )
     1113     or (can-query (self, "read-only")
     1114        and
     1115        self :read-only = false
     1116        )
     1117     then do:
     1118       if self :handle <> focus :handle
     1119       then do:
     1120         apply "entry":u to self .
     1121       end.
     1122       define variable v-curr-sv-date as date no-undo .
     1123       define variable v-new-sv-date  as date no-undo .
     1124       assign
     1125         v-curr-sv-date = date(self :screen-value) no-error
     1126       .
     1127       if v-curr-sv-date = ?
     1128       then do:
     1129         run gbl/getcurdt.p
     1130           (output v-curr-sv-date
     1131           ) .
     1132       end.
     1133       if v-curr-sv-date <> ?
     1134       then do:
     1135         run gbl/lastdate.p
     1136           (input  v-curr-sv-date
     1137           ,output v-new-sv-date
     1138           ).
     1139         assign
     1140           self :screen-value = string(v-new-sv-date) .
     1141         .
     1142       end.
     1143     end.
     1144     return no-apply .
     1145   end.
     1146   on ctrl-f of v-date in frame Dialog-Frame
     1147   do:
     1148     if (can-query (self, "sensitive")
     1149        and
     1150        self :sensitive = true
     1151        )
     1152     or (can-query (self, "read-only")
     1153        and
     1154        self :read-only = false
     1155        )
     1156     then do:
     1157       if self :handle <> focus :handle
     1158       then do:
     1159         apply "entry":u to self .
     1160       end.
     1161       define variable v-ok            as logical   no-undo .
     1162       define variable v-curr-sv-date  as date      no-undo .
     1163       define variable v-description   as character no-undo .
     1164       assign
     1165         v-curr-sv-date = date(self :screen-value) no-error
     1166       .
     1167       if v-curr-sv-date = ?
     1168       then do:
     1169         run gbl/getcurdt.p
     1170           (output v-curr-sv-date
     1171           ) .
     1172       end.
     1173       if v-curr-sv-date <> ?
     1174       then do:
     1175         run gbl/d-inpday.w
     1176           (input ?
     1177           ,input "Выбор даты"
     1178           ,input v-description
     1179           ,input ""
     1180           ,input-output v-curr-sv-date
     1181           ,output v-ok
     1182           ).
     1183         if v-ok = true
     1184         then do:
     1185           assign
     1186             self :screen-value = string(v-curr-sv-date) .
     1187           .
     1188         end.
     1189       end.
     1190     end.
     1191     return no-apply .
     1192   end.
     1193     define MENU m-ed-date10
     1194       MENU-ITEM m-ed-date10-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1195       MENU-ITEM m-ed-date10-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1196       MENU-ITEM m-ed-date10-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1197       MENU-ITEM m-ed-date10-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1198       .
     1199     if v-date :POPUP-MENU in frame Dialog-Frame = ?
     1200     then do:
     1201       ASSIGN
     1202         v-date :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date10 :HANDLE
     1203         v-date :MENU-MOUSE in frame Dialog-Frame = 3
     1204       .
     1205     end.
     1206     define variable v-label-handle10 as handle no-undo .
     1207     assign
     1208       v-label-handle10 = v-date :side-label-handle in frame Dialog-Frame
     1209     .
     1210     if valid-handle (v-label-handle10)
     1211     then do:
     1212       if v-label-handle10 :tooltip = ""
     1213       or v-label-handle10 :tooltip = ?
     1214       then do:
     1215         assign
     1216           v-label-handle10 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1217         .
     1218       end.
     1219     end.
     1220     ON CHOOSE OF MENU-ITEM m-ed-date10-1 in menu m-ed-date10 DO:
     1221       apply "ctrl-b":U to v-date in frame Dialog-Frame .
     1222     END.
     1223     ON CHOOSE OF MENU-ITEM m-ed-date10-2 in menu m-ed-date10 DO:
     1224       apply "ctrl-d":U to v-date in frame Dialog-Frame .
     1225     END.
     1226     ON CHOOSE OF MENU-ITEM m-ed-date10-3 in menu m-ed-date10 DO:
     1227       apply "ctrl-e":U to v-date in frame Dialog-Frame .
     1228     END.
     1229     ON CHOOSE OF MENU-ITEM m-ed-date10-4 in menu m-ed-date10 DO:
     1230       apply "ctrl-f":U to v-date in frame Dialog-Frame .
     1231     END.
     1232   MAIN-BLOCK:
     1233   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1234      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1235     run init-proc.
     1236     v-itogo-rubl:label = "По накл (руб)".
     1237     v-sum-new-rubl:label = "Сумма к оплате (руб)".
     1238     v-sum-with-disc-rubl:label = "Итого (руб)".
     1239     run enable_ui.
     1240     hide v-pr-srk in frame Dialog-Frame .
     1241     if p-doc-mode =  'ПРОСМОТР':U then do:
     1242        hide b-ok  in frame Dialog-Frame .
     1243        disable B-calc
     1244                v-sum
     1245                v-n
     1246                v-date
     1247                with frame Dialog-Frame .
     1248        B-exit:label = "Вы&ход".
     1249        B-exit:COLUMN = 1.
     1250     end.
     1251   IF nakl_trn-doc.status_ = 'факт':U THEN do:
     1252       HIDE
     1253       F- F-6 v-sum-new-base v-sum-new-rubl
     1254       B-calc
     1255       v-itogo-base
     1256       v-itogo-rubl
     1257       IN FRAME Dialog-Frame.
     1258   end.
     1259     WAIT-FOR GO OF FRAME Dialog-Frame.
     1260   END.
     1261   run disable_ui.
     1262   PROCEDURE disable_UI :
     1263     HIDE FRAME Dialog-Frame.
     1264   END PROCEDURE.
     1265   PROCEDURE enable_UI :
     1266     DISPLAY F- v-sum v-n v-date f-1 v-pr-wrk v-itogo-base v-pr-srk v-itogo-rubl
     1267             v-dis v-sum-with-disc-base v-sum-with-disc-rubl f-2 v-dost v-dost-sum
     1268             f-3 v-bef-sum v-bef-n v-bef-date f-4 v-sum-new-rubl f-5 v-sum-new-base
     1269             v-pr-new F-6
     1270         WITH FRAME Dialog-Frame.
     1271     ENABLE B-calc F- B-ok v-sum v-n v-date B-exit B-Help f-1 v-pr-wrk
     1272            v-itogo-base v-pr-srk v-itogo-rubl v-dis v-sum-with-disc-base
     1273            v-sum-with-disc-rubl f-2 v-dost v-dost-sum f-3 v-bef-sum v-bef-n
     1274            v-bef-date f-4 v-sum-new-rubl f-5 v-sum-new-base v-pr-new F-6
     1275         WITH FRAME Dialog-Frame.
     1276     VIEW FRAME Dialog-Frame.
     1277   END PROCEDURE.
     1278   PROCEDURE init-proc :
     1279   define variable  v-type       as character no-undo .
     1280   define variable  v-postdchek as character no-undo .
     1281   define variable  v-postpay   as character no-undo .
     1282   define variable  v-postNchek as character no-undo .
     1283   v-bef-date = "" . run attr-read in this-procedure (  input p-doc-code                                  ,  input '4dchek':U                                    , output v-bef-date                                    , output v-type ).
     1284   v-bef-sum = "" . run attr-read in this-procedure (  input p-doc-code                                  ,  input '2befpay':U                                    , output v-bef-sum                                    , output v-type ).
     1285   v-bef-n = "" . run attr-read in this-procedure (  input p-doc-code                                  ,  input '3ord_Nchek':U                                    , output v-bef-n                                    , output v-type ).
     1286   v-dost-sum = "" . run attr-read in this-procedure (  input p-doc-code                                  ,  input '5deliv':U                                    , output v-dost-sum                                    , output v-type ).
     1287   v-dost = "" . run attr-read in this-procedure (  input p-doc-code                                  ,  input '4ord_dl':U                                    , output v-dost                                    , output v-type ).
     1288   v-pr-wrk = "" . run attr-read in this-procedure (  input p-doc-code                                  ,  input '6sumwrk':U                                    , output v-pr-wrk                                    , output v-type ).
     1289   v-postdchek = "" . run attr-read in this-procedure (  input p-doc-code                                  ,  input '3postdchek':U                                    , output v-postdchek                                    , output v-type ).
     1290   v-postpay = "" . run attr-read in this-procedure (  input p-doc-code                                  ,  input '1postpay':U                                    , output v-postpay                                    , output v-type ).
     1291   v-postNchek = "" . run attr-read in this-procedure (  input p-doc-code                                  ,  input '2postNchek':U                                    , output v-postNchek                                    , output v-type ).
     1292     ASSIGN
     1293         v-date = date(v-postdchek)
     1294         v-n    = v-postNchek
     1295         v-sum  = dec(v-postpay)
     1296         v-dis =  nakl_trn-doc.discnt-pc
     1297         .
     1298     v-pr-1 = decimal (v-pr-wrk)  .
     1299     if v-dost = "yes" then v-dost = "Да"   .
     1300                       else  v-dost = "Нет" .
     1301   assign
     1302     v-itogo-base = 0
     1303     v-itogo-rubl = 0
     1304     .
     1305    define buffer buf_goods for goods.
     1306    define variable  v-nab as logical   no-undo .
     1307      for each gds-dtl no-lock where gds-dtl.doc-code = p-doc-code :
     1308           find first buf_goods no-lock
     1309               where buf_goods.artic      = gds-dtl.artic
     1310                 and buf_goods.prod-type  = gds-dtl.prod-type
     1311                 and buf_goods.prod-code  = gds-dtl.prod-code .
     1312   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1313   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_grp-nabor in g#lib-trn3
     1314   ( input  buf_goods.gds-code ,
     1315     output v-nab
     1316   )
     1317   .
     1318         if v-nab = false then do:
     1319             assign
     1320               v-itogo-base = (gds-dtl.price-base * gds-dtl.fact-qnty)  + v-itogo-base
     1321               v-itogo-rubl = (gds-dtl.price-rubl * gds-dtl.fact-qnty)  + v-itogo-rubl
     1322           .
     1323         end.
     1324      end.
     1325     v-itogo-base2 = 0 .
     1326     v-itogo-rubl2 = 0 .
     1327     if LOOKUP ( nakl_trn-doc.status_ , 'факт':U ) > 0  then do:
     1328       v-itogo-base2 =   nakl_trn-doc.tot-fact -  nakl_trn-doc.tot-calc   .
     1329       v-itogo-rubl2 =   nakl_trn-doc.tot-sale -  nakl_trn-doc.discnt-rubl.
     1330     END.
     1331     ELSE DO:
     1332       IF  nakl_trn-doc.status_ = 'разрешен':U THEN DO:
     1333           for each gds-dtl no-lock where gds-dtl.doc-code = p-doc-code :
     1334                 v-itogo-base2 = v-itogo-base2 +  ((gds-dtl.price-base - gds-dtl.discnt-base) * gds-dtl.fact-qnty) .
     1335                 v-itogo-rubl2 = v-itogo-rubl2 +  ((gds-dtl.price-rubl - gds-dtl.discnt-rubl) * gds-dtl.fact-qnty) .
     1336           end.
     1337       end.
     1338       else do:
     1339           v-itogo-base2 =  nakl_trn-doc.tot-doc  -  nakl_trn-doc.tot-calc     .
     1340           v-itogo-rubl2 =  nakl_trn-doc.tot-rubl -  nakl_trn-doc.discnt-rubl  .
     1341       end.
     1342     END.
     1343   IF  nakl_trn-doc.status_ <> 'факт':U THEN DO:
     1344       v-sum-with-disc-base = v-itogo-base2  +  (v-pr-1) * v-itogo-base2 / 100 .
     1345       v-sum-with-disc-rubl = v-itogo-rubl2  +  (v-pr-1) * v-itogo-rubl2 / 100 .
     1346   END.
     1347   ELSE DO:
     1348       v-sum-with-disc-base = v-itogo-base2   .
     1349       v-sum-with-disc-rubl = v-itogo-rubl2   .
     1350   END.
     1351   if   nakl_trn-doc.status_ = 'факт':U then
     1352   assign
     1353    v-pr-new  = decimal(v-pr-wrk)
     1354    v-sum-new-rubl = v-sum-with-disc-rubl
     1355    v-sum-new-base = v-sum-with-disc-base
     1356   .
     1357   else
     1358   assign
     1359    v-pr-new  = decimal(v-pr-wrk)
     1360    v-sum-new-rubl = v-sum-with-disc-rubl + DEC(v-dost-sum)
     1361    v-sum-new-base = v-sum-with-disc-base + ( DEC(v-dost-sum)  * nakl_trn-doc.base-scale / nakl_trn-doc.base-rate )
     1362   .
     1363    v-pr-dl  =  v-pr-new .
     1364    F- =   DEC(v-bef-sum)  + v-sum .
     1365    f-6 = v-sum-new-rubl  - DEC(v-bef-sum) .
     1366   display
     1367     f-6
     1368     v-pr-wrk
     1369     v-date
     1370     v-n
     1371     v-sum
     1372     v-sum-with-disc-rubl
     1373     v-sum-with-disc-base
     1374     v-itogo-base
     1375     v-itogo-rubl
     1376     v-dis
     1377     F-
     1378     v-dis
     1379     with frame Dialog-Frame .
     1380   END PROCEDURE.
     1381   PROCEDURE proc-recalc :
     1382   define variable v-sum-rubl-1 as decimal   no-undo .
     1383   define variable v-pr2 as decimal   no-undo .
     1384   define variable v-dos as decimal   no-undo .
     1385   assign
     1386     v-dos = DECimal(v-dost-sum)
     1387     v-sum-rubl-1   = f-
     1388     v-sum-new-rubl = v-sum-rubl-1
     1389     v-sum-new-base = v-sum-new-rubl * nakl_trn-doc.base-scale / nakl_trn-doc.base-rate
     1390     v-pr-new = (( v-sum-rubl-1  - ( v-itogo-rubl2 + v-dos) ) * 100 / v-itogo-rubl2 )
     1391   .
     1392     define variable v1 as decimal   no-undo .
     1393     define variable v2 as decimal   no-undo .
     1394     v-itogo-rubl2 =  v-itogo-rubl * (1 - (nakl_trn-doc.discnt-pc / 100) )    .
     1395     v-pr-new = 100 * ((( v-sum-new-rubl - v-dos ) / ( v-itogo-rubl2) ) - 1) .
     1396     v-pr-dl  = 100 * ((( v-sum-new-rubl - v-dos ) / ( v-itogo-rubl2) ) - 1) .
     1397   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input nakl_trn-doc.doc-code ,
     1398                          input 'discnt-stop':U ,
     1399                          input string(v-sum-new-rubl) )  .
     1400   END PROCEDURE.
     1401   procedure attr-read :
     1402     define  input parameter p-doc-code like ub.doc-attr.doc-code   no-undo.
     1403     define  input parameter p-code     like ub.doc-attr.attr-code  no-undo.
     1404     define output parameter p-value    like ub.doc-attr.attr-value no-undo.
     1405     define output parameter p-type     as   character              no-undo.
     1406     do on error undo, return error return-value :
     1407   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
     1408                           input p-code ,
     1409                          output p-value ,
     1410                          output p-type )  .
     1411     end.
     1412   end procedure.
