      361   field was-res as decimal
      362   field to-res as decimal
      363   field is-res as decimal
      364   field o-was-res as decimal
      365   field o-to-res as decimal
      366   field o-is-res as decimal
      367   index pi is unique primary
      368   obj-type
      369   obj-code
