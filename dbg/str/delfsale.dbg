     2064             if g#news                                                                                                             then .                          else run write-log-and-file in p-log-handle (                                                                                    input 1                                                                                                             , input log-file-name                                                                                                 , input 1                                                                                                             , input substitute("&1 &2 &3&4!!!Ошибка при удалении документа &5&4&6&4&7"                           ,vss-workfile                                                                       ,vss-revision                                                                       ,vss-description                                                                    , chr(10)                                                                     , tpsi_sale-doc.doc-code                                                            , error-status:get-message(1)                                                       , return-value                                                                      )).
     2065             undo _main, return error.
     2066           end.
     2067         end.
     2068         delete tpsi_sale-doc.
     2069       end.
     2070       if (v-auto-fbr = yes
     2071       or v-auto-fbr = ? )
     2072       and not g#news
     2073       then do:
     2074   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2075   do:
     2076     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2077       (input  v-cntxt-db-num
     2078       ,input  v-cntxt-userid
     2079       ,input  0
     2080       ,input  'actn_manufacturing_del-manuf-fact':U
     2081       ,input  'object':U
     2082       ,input  v-host-code
     2083       ,input  v-obj-type
     2084       ,input  v-obj-code
     2085       ,input  0
     2086       ,input  0
     2087       ,input  0
     2088       ,input  false
     2089       ,output v-can-del-fbr-doc
     2090       ) no-error .
     2091   end.
     2092         if error-status :error
     2093         then do:
     2094                   if g#news                                                                                                             then .                          else run write-log-and-file in p-log-handle (                                                                                    input 1                                                                                                             , input log-file-name                                                                                                 , input 1                                                                                                             , input substitute("&1 &2 &3&4!!!Ошибка проверки права на удаление документа производства закрытого на факт"                                ,vss-workfile                                                                                                         ,vss-revision                                                                                                         ,vss-description                                                                                                      ,chr(10)                                                                                                        ,error-status:get-message(1)                                                                                          , return-value                                                                                                        )).
     2095                 run read-write-log in this-procedure .
     2096             undo _main, return error .
     2097         end.
     2098         if v-can-del-fbr-doc = no
     2099         then do:
     2100             if g#news                                                                                                             then .                          else run write-log-and-file in p-log-handle (                                                                                    input 1                                                                                                             , input log-file-name                                                                                                 , input 1                                                                                                             , input "Нет права на удаление документа производства, закрытого на факт.").
     2101           undo _main, return error .
     2102         end.
     2103         if g#news                                                                                                             then .                          else run write-log-and-file in p-log-handle (                                                                                    input 1                                                                                                             , input log-file-name                                                                                                 , input 1                                                                                                             , input substitute("Удаление порожденных документов производства по продаже &1", parinkas-code)).
     2104         run str/fbrdel.p (
     2105               input parparentproc
     2106             , input parinkas-code
     2107             , input varchip-code
     2108         ) no-error .
     2109         if error-status:error
     2110         then do:
     2111             if g#news                                                                                                             then .                          else run write-log-and-file in p-log-handle (                                                                                    input 1                                                                                                             , input log-file-name                                                                                                 , input 1                                                                                                             , input substitute("&1 &2 &3&4!!!Ошибка при удалении порожденных документов производства по продаже &5&4&6&4&7"                      ,vss-workfile                                                                                                             ,vss-revision                                                                                                             ,vss-description                                                                                                          , chr(10)                                                                                                           , parinkas-code                                                                                                           , error-status:get-message(1)                                                                                             , return-value                                                                                                            )).
     2112           undo _main, return error.
     2113         end.
     2114       end.
     2115     end.
     2116    if g#news
     2117    and g#db-num = 0
     2118    and v-need-saledc
     2119    then do:
     2120   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-del in g#trdcalib (  input parinkas-code ,
     2121                           input 'need-saledc':U ,
     2122                          output v-deleted ) no-error .
     2123     end.
     2124       if g#news                                                                                                             then .                          else run write-log-and-file in p-log-handle (                                                                                    input 1                                                                                                             , input log-file-name                                                                                                 , input 1                                                                                                             , input substitute("Документ продажи &1 удален", parinkas-code)).
     2125   end.
     2126   procedure hstc-inkas :
     2127   define input parameter parrec-inkas   as   recid                   no-undo.
     2128   define input parameter parobj-date    as   date                    no-undo.
     2129   define input parameter parshift-date  like ub.shift-obj.shift-date no-undo.
     2130   define input parameter parshift-num   like ub.shift-obj.shift-num  no-undo.
     2131   define input parameter parshift-name  like ub.shift-obj.shift-name  no-undo.
     2132   define input parameter paruserid      as   character               no-undo.
     2133   define output parameter parchip-code    like ub.c-trn-doc.chip-num   no-undo.
     2134   DEFINE VARIABLE v-date as date no-undo .
     2135   DEFINE VARIABLE v-time as integer no-undo .
     2136   define buffer hstc_inkas          for ub.inkas.
     2137   define buffer hstc_inkas-pay      for ub.inkas-pay.
     2138   define buffer hstc_inkas-pay-desk for ub.inkas-pay-desk.
     2139   define buffer hstc_inkas-pay-wth  for ub.inkas-pay-wth.
     2140   define buffer hstc_sale-doc for ub.sale-doc.
     2141   define buffer hstc_c-inkas           for ub.c-inkas.
     2142   define buffer hstc_c-inkas-pay      for ub.c-inkas-pay.
     2143   define buffer hstc_c-inkas-pay-desk for ub.c-inkas-pay-desk.
     2144   define buffer hstc_c-inkas-pay-wth for ub.c-inkas-pay-wth.
     2145   define buffer hstc_c-sale-doc for ub.c-sale-doc.
     2146   do
     2147   on error undo, return error return-value
     2148   :
     2149   find first hstc_inkas where recid (hstc_inkas) = parrec-inkas.
     2150   run cur-time in this-procedure(output v-date, output v-time).
     2151   create hstc_c-inkas.
     2152   buffer-copy hstc_inkas to hstc_c-inkas.
     2153   assign
     2154     parchip-code                 = next-value (s-corr-chip, ub)
     2155     hstc_c-inkas.chip-num        = parchip-code
     2156     hstc_c-inkas.CORR-TIME       = v-time
     2157     hstc_c-inkas.real-corr-date  = v-date
     2158     hstc_c-inkas.corr-date       = parobj-date
     2159     hstc_c-inkas.corr-shift-date = parshift-date
     2160     hstc_c-inkas.corr-shift-num  = parshift-num
     2161     hstc_c-inkas.corr-shift-name  = parshift-name
     2162     hstc_c-inkas.corr-user-name        = paruserid
     2163     hstc_c-inkas.corr-user-db-num   = g#db-num
     2164     .
     2165   for each hstc_inkas-pay where
     2166            hstc_inkas-pay.inkas-code = hstc_inkas.inkas-code
     2167   on error undo, return error
     2168   :
     2169     create hstc_c-inkas-pay.
     2170     buffer-copy hstc_inkas-pay to hstc_c-inkas-pay.
     2171     assign
     2172       hstc_c-inkas-pay.chip-num = hstc_c-inkas.chip-num
     2173       hstc_c-inkas-pay.corr-user-db-num = hstc_c-inkas.corr-user-db-num.
     2174   end.
     2175   for each hstc_inkas-pay-desk where
     2176            hstc_inkas-pay-desk.inkas-code = hstc_inkas.inkas-code
     2177   on error undo, return error
     2178            :
     2179     create hstc_c-inkas-pay-desk.
     2180     buffer-copy hstc_inkas-pay-desk to hstc_c-inkas-pay-desk.
     2181     assign
     2182       hstc_c-inkas-pay-desk.chip-num = hstc_c-inkas.chip-num
     2183       hstc_c-inkas-pay-desk.corr-user-db-num = hstc_c-inkas.corr-user-db-num
     2184       .
     2185   end.
     2186   for each hstc_inkas-pay-wth where
     2187            hstc_inkas-pay-wth.inkas-code = hstc_inkas.inkas-code
     2188   on error undo, return error
     2189            :
     2190     create hstc_c-inkas-pay-wth.
     2191     buffer-copy hstc_inkas-pay-wth to hstc_c-inkas-pay-wth.
     2192     assign
     2193       hstc_c-inkas-pay-wth.chip-num = hstc_c-inkas.chip-num
     2194       hstc_c-inkas-pay-wth.corr-user-db-num = hstc_c-inkas.corr-user-db-num
     2195       .
     2196   end.
     2197   for each hstc_sale-doc where
     2198            hstc_sale-doc.inkas-code = hstc_inkas.inkas-code
     2199   on error undo, return error
     2200   :
     2201     create hstc_c-sale-doc.
     2202     buffer-copy hstc_sale-doc to hstc_c-sale-doc.
     2203     assign
     2204     hstc_c-sale-doc.chip-num = hstc_c-inkas.chip-num
     2205     hstc_c-sale-doc.corr-user-db-num = hstc_c-inkas.corr-user-db-num
     2206     hstc_c-inkas.corr-date       = parobj-date
     2207     hstc_c-inkas.corr-shift-date = parshift-date
     2208     hstc_c-inkas.corr-shift-num  = parshift-num
     2209     hstc_c-inkas.corr-shift-name  = parshift-name
     2210     .
     2211   end.
     2212   end.
     2213   end procedure.
     2214   procedure read-write-log :
     2215   define variable ss as character no-undo .
     2216     do
     2217     on error undo, return error
     2218     :
     2219       if not g#news
     2220       then do:
     2221         input stream LogStream from value("del-doc.err").
     2222         REPEAT:
     2223           import stream LogStream  unformatted ss.
     2224             if g#news                                                                                                             then .                          else run write-log-and-file in p-log-handle (                                                                                    input 1                                                                                                             , input log-file-name                                                                                                 , input 1                                                                                                             , input ss).
     2225         END.
     2226         input stream LogStream close.
     2227       end.
     2228     end.
     2229   end procedure.
