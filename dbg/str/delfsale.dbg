      378   define   temp-table tt0-doc-line no-undo like lib-trn_ret-line.
      379   define   temp-table tt0-gds-dtl  no-undo like ub.gds-dtl.
      380   define   temp-table tt0-parts    no-undo like ub.parts.
      381   define   temp-table temp-tpsi-clients  no-undo like ub.clients.
      382   FUNCTION set-tpsi-doc-PS returns character( buffer buf_sale-doc for ub.sale-doc):
      383   define variable v-ps as character no-undo .
      384   assign
      385   v-PS = substitute('@&1 для закрытия продажи &2 на &3&4&5товаров &6&5признаков &7'
      386                     , entry (lookup (buf_sale-doc.ext-doc-type, 'ee,ev,ie,es,iv':U), 'Межфирм.расход по ТПСИ,Внутр.расход по ТПСИ,Межфирм.приход по ТПСИ,Внутр.приход по ТПСИ':U)
      387                     , buf_sale-doc.out-code
      388                     , buf_sale-doc.obj-type
      389                     , buf_sale-doc.obj-code
      390                     , chr(4)
      391                     , buf_sale-doc.tot-lines
      392                     , buf_sale-doc.tot-dtl
      393                     ).
      394   return v-Ps.
      395   END FUNCTION.
      396   procedure create-tt0-doc-line-gds-dtl :
      397   define input parameter p-proprietor-obj-type like ub.trn-doc.obj-type no-undo .
      398   define input parameter p-proprietor-obj-code like ub.trn-doc.obj-code no-undo .
      399   define input parameter p-ext-doc-type        as character no-undo .
      400   define input parameter p-doc-code            like ub.trn-doc.doc-code no-undo .
      401   define input parameter p-artic               like ub.gds-dtl.artic no-undo .
      402   define input parameter p-prod-type           like ub.gds-dtl.prod-type no-undo .
      403   define input parameter p-prod-code           like ub.gds-dtl.prod-code no-undo .
      404   define input parameter p-prt-code            like ub.gds-dtl.prt-code  no-undo .
      405   define input parameter p-fact-qnty           like ub.gds-dtl.fact-qnty no-undo .
      406   define output parameter p-was-gds-dtl-doc-qnty  like ub.gds-dtl.fact-qnty no-undo .
      407   define output parameter p-gds-dtl-fact-qnty  like ub.gds-dtl.fact-qnty no-undo .
      408   define parameter buffer b-doc-line           for ub.doc-line.
      409   define parameter buffer b-gds-dtl            for ub.gds-dtl.
      410   define parameter buffer buf_sale-doc for ub.sale-doc.
      411   define variable old-qnty like ub.doc-line.fact-qnty no-undo .
      412   define buffer other_doc-line for ub.doc-line.
      413   define buffer other_gds-dtl for ub.gds-dtl.
      414     do
      415     on error undo, return error return-value
      416     :
      417       find first tt0-doc-line where
      418                 tt0-doc-line.obj-type = p-proprietor-obj-type
      419             AND tt0-doc-line.obj-code = p-proprietor-obj-code
      420             AND tt0-doc-line.prod-type = p-prod-type
      421             AND tt0-doc-line.prod-code = p-prod-code
      422             AND tt0-doc-line.artic     = p-artic
      423             AND tt0-doc-line.ext-doc-type = p-ext-doc-type
      424             AND tt0-doc-line.status_      = 'нередакт':U no-error .
      425       if not available tt0-doc-line then do:
      426         create tt0-doc-line.
      427         buffer-copy b-doc-line
      428         except
      429         obj-type obj-code doc-code status_ ext-doc-type doc-qnty fact-qnty
      430         to tt0-doc-line
      431         assign
      432         tt0-doc-line.status_ = 'нередакт':U
      433         tt0-doc-line.ext-doc-type = p-ext-doc-type
      434         tt0-doc-line.obj-type = p-proprietor-obj-type
      435         tt0-doc-line.obj-code = p-proprietor-obj-code
      436         tt0-doc-line.doc-code = p-doc-code
      437         .
      438       end.
      439       if p-doc-code <> "":U then do:
      440         find first other_doc-line no-lock where
      441                 other_doc-line.doc-code = p-doc-code
      442             AND  other_doc-line.artic    = p-artic
      443             AND  other_doc-line.prod-type = p-prod-type
      444             AND  other_doc-line.prod-code = p-prod-code no-error .
      445         if available other_doc-line then do:
      446           find first buf_sale-doc where buf_sale-doc.doc-code = other_doc-line.doc-code.
      447           assign
      448           tt0-doc-line.doc-qnty = other_doc-line.doc-qnty
      449           .
      450         end.
      451         else do:
      452           assign
      453           tt0-doc-line.doc-code = '':U
      454           .
      455         end.
      456       end.
      457       find first tt0-gds-dtl where
      458               tt0-gds-dtl.obj-type = p-proprietor-obj-type
      459           AND tt0-gds-dtl.obj-code = p-proprietor-obj-code
      460           AND tt0-gds-dtl.prod-type = p-prod-type
      461           AND tt0-gds-dtl.prod-code = p-prod-code
      462           AND tt0-gds-dtl.artic     = p-artic
      463           AND tt0-gds-dtl.prt-code  = p-prt-code  no-error .
      464       if not available tt0-gds-dtl then do:
      465         create tt0-gds-dtl.
      466         buffer-copy b-gds-dtl
      467         except
      468         obj-type obj-code doc-code doc-qnty fact-qnty
      469         to tt0-gds-dtl
      470         assign
      471         tt0-gds-dtl.obj-type = p-proprietor-obj-type
      472         tt0-gds-dtl.obj-code = p-proprietor-obj-code
      473         tt0-gds-dtl.doc-code = p-doc-code
      474         .
      475       end.
      476       if p-doc-code <> "":U then do:
      477           find first other_gds-dtl no-lock where
      478                   other_gds-dtl.doc-code = p-doc-code
      479               AND  other_gds-dtl.artic    = p-artic
      480               AND  other_gds-dtl.prod-type    = p-prod-type
      481               AND  other_gds-dtl.prod-code    = p-prod-code
      482               AND  other_gds-dtl.prt-code    = p-prt-code no-error .
      483           if available other_gds-dtl then do:
      484             assign
      485             tt0-gds-dtl.doc-qnty = other_gds-dtl.doc-qnty
      486             .
      487           end.
      488           else do:
      489             assign
      490             tt0-gds-dtl.doc-code = '':U
      491             .
      492           end.
      493       end.
      494       assign
      495       old-qnty = tt0-gds-dtl.doc-qnty
      496       tt0-gds-dtl.fact-qnty = (if p-fact-qnty = ? then (- old-qnty) else (p-fact-qnty - tt0-gds-dtl.doc-qnty))
      497       tt0-doc-line.fact-qnty = tt0-doc-line.fact-qnty + (if p-fact-qnty = ? then (- old-qnty) else p-fact-qnty)
      498       p-gds-dtl-fact-qnty = tt0-gds-dtl.fact-qnty
      499       p-was-gds-dtl-doc-qnty = tt0-gds-dtl.doc-qnty
      500       .
      501     end.
      502   end procedure.
      503   procedure fill-tt-tpsi-table :
      504   define input parameter p-doc-code  like ub.trn-doc.doc-code  no-undo .
      505   define input parameter p-host-code like ub.trn-doc.host-code no-undo .
      506   define input parameter p-obj-type  like ub.trn-doc.obj-type  no-undo .
      507   define input parameter p-obj-code  like ub.trn-doc.obj-code  no-undo .
      508   define variable v-proprietor-host-code      like ub.clients.host-code no-undo .
      509   define variable v-proprietor-obj-type       like ub.clients.obj-type no-undo .
      510   define variable v-proprietor-obj-code       like ub.clients.obj-code no-undo .
      511   define variable v-ext-doc-type              like ub.trn-doc.ext-doc-type no-undo .
      512   define variable v-gds-dtl-fact-qnty         like ub.gds-dtl.fact-qnty no-undo .
      513   define variable v-was-gds-dtl-fact-qnty     like ub.gds-dtl.fact-qnty no-undo .
      514   define buffer buf_goods for ub.goods.
      515   define buffer buf_doc-line for ub.doc-line.
      516   define buffer buf_gds-dtl for ub.gds-dtl.
      517   define buffer buf_sale-doc for ub.sale-doc.
      518     do
      519     on error undo, return error
      520     :
      521       _doc-line:
      522       for each buf_Doc-line no-lock where
      523             buf_doc-line.doc-code = p-doc-code,
      524         first buf_goods no-lock where
      525             buf_goods.artic = buf_doc-line.artic
      526        AND  buf_goods.prod-type  = buf_doc-line.prod-type
      527        AND  buf_goods.prod-code  = buf_doc-line.prod-code,
      528           each buf_gds-dtl no-lock where
      529             buf_gds-dtl.doc-code = buf_doc-line.doc-code
      530         AND  buf_gds-dtl.artic    = buf_doc-line.artic
      531         AND  buf_gds-dtl.prod-type = buf_doc-line.prod-type
      532         AND  buf_gds-dtl.prod-code = buf_doc-line.prod-code:
      533         assign
      534         v-ext-doc-type = "":U.
      535         run tpsi-preselect-gds-proprietor in this-procedure (
      536                                                     input buf_goods.gds-code
      537                                                   ,input g#db-num
      538                                                   ,output v-proprietor-host-code
      539                                                   ,output v-proprietor-obj-type
      540                                                   ,output v-proprietor-obj-code ) no-error .
      541         if v-proprietor-host-code = p-host-code then do:
      542           assign
      543           v-ext-doc-type = 'ev':U .
      544         end.
      545         else do:
      546           assign
      547           v-ext-doc-type =  'ee':U .
      548         end.
      549         if  (v-proprietor-obj-type = p-obj-type
      550         AND v-proprietor-obj-code = p-obj-code)
      551         OR (v-proprietor-obj-type = "":U
      552         AND v-proprietor-obj-code = 0)
      553         OR v-proprietor-obj-code = ?
      554         then next _doc-line.
      555         find first buf_sale-doc no-lock where
      556                   buf_sale-doc.inkas-code = p-doc-code
      557              AND buf_sale-doc.obj-type = v-proprietor-obj-type
      558              AND buf_sale-doc.obj-code = v-proprietor-obj-code
      559              AND buf_sale-doc.ext-doc-type = v-ext-doc-type
      560              no-error .
      561         run create-tt0-doc-line-gds-dtl  in this-procedure (
      562                                                              input v-proprietor-obj-type
      563                                                             ,input v-proprietor-obj-code
      564                                                             ,input v-ext-doc-type
      565                                                             ,input (if available buf_sale-doc then buf_sale-doc.doc-code else "":U)
      566                                                             ,input buf_doc-line.artic
      567                                                             ,input buf_Doc-line.prod-type
      568                                                             ,input buf_doc-line.prod-code
      569                                                             ,input buf_gds-dtl.prt-code
      570                                                             ,input 0
      571                                                             ,output v-was-gds-dtl-fact-qnty
      572                                                             ,output v-gds-dtl-fact-qnty
      573                                                             ,buffer buf_doc-line
      574                                                             ,buffer buf_gds-dtl
      575                                                             ,buffer buf_sale-doc
      576                                                           ).
      577       end.
      578     end.
      579   end procedure.
      580   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      581   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      582   procedure get-alias-type-price-obj :
      583   define input parameter p-host-code like ub.sysconf.host-code no-undo .
      584   define input parameter p-obj-type  like ub.clients.obj-type no-undo .
      585   define input parameter p-obj-code  like ub.clients.obj-code no-undo .
      586   define input parameter p-prop-host-code like ub.sysconf.host-code no-undo .
      587   define input parameter p-prop-obj-type  like ub.clients.obj-type no-undo .
      588   define input parameter p-prop-obj-code  like ub.clients.obj-code no-undo .
      589   define output parameter p-ext-doc-type like ub.trn-doc.ext-doc-type no-undo .
      590   define output parameter p-alias-type-price as character no-undo .
      591   define output parameter p-price-obj-type like ub.clients.obj-type no-undo .
      592   define output parameter p-price-obj-code like ub.clients.obj-code no-undo .
      593   define variable v-mediat-obj-type           like ub.trn-doc.obj-type no-undo .
      594   define variable v-mediat-obj-code           like ub.trn-doc.obj-code no-undo .
      595   define variable v-mediat-objf               as character no-undo .
      596   define variable v-param-type as character no-undo .
      597   define variable v-value-character as character no-undo .
      598   define variable v-value-date as date no-undo .
      599   define variable v-value-decimal as decimal no-undo .
      600   define variable v-value-integer as INTEGER no-undo .
      601   define variable v-value-logical AS LOGICAL no-undo .
      602   define variable v-tth as handle no-undo .
      603   assign
      604   v-tth = buffer thbjattr_thbj-attr:table-handle .
      605   define buffer buf_trn-doc for ub.trn-doc.
      606     _main:
      607     do
      608     on error undo, return error return-value
      609     :
      610       run adm/shattri.p (
      611         input "get":U
      612         ,input  p-prop-obj-type
      613         ,input  p-prop-obj-code
      614         ,input  'alias-tpsi':U
      615         ,input  '':U
      616         ,output v-value-character
      617         ,output v-value-date
      618         ,output v-value-decimal
      619         ,output v-value-integer
      620         ,output v-value-logical
      621         ,output v-param-type
      622         ,INPUT-OUTPUT table-handle v-tth
      623         ) no-error .
      624       if error-status:error
      625       then do:
      626         undo _main, return error substitute("Не удалось определить настройки МЕЖФИРМЕННОГО ИЛИ ВНУТРЕННЕГО ПЕРЕМЕЩЕНИЯ ЧУЖИХ ТОВАРОВ для &1&2"
      627                                 , p-prop-obj-type
      628                                 , p-prop-obj-code).
      629       end.
      630       find first thbjattr_thbj-attr where
      631                 thbjattr_thbj-attr.obj-type = p-prop-obj-type
      632             and thbjattr_thbj-attr.obj-code = p-prop-obj-code
      633             and thbjattr_thbj-attr.upper-prop-code = 'alias-tpsi':U
      634             and thbjattr_thbj-attr.prop-code = 'alias-type-price':U no-error.
      635       if not available thbjattr_thbj-attr
      636       or thbjattr_thbj-attr.property-value-integer = 0 then do:
      637         undo _main, return error substitute("Не задано значение атрибута ТИП ЦЕНЫ МЕЖФИРМЕННОГО ИЛИ ВНУТРЕННЕГО ПЕРЕМЕЩЕНИЯ ЧУЖИХ ТОВАРОВ для &1&2"
      638                                 , p-prop-obj-type
      639                                 , p-prop-obj-code).
      640       end.
      641       assign
      642       p-alias-type-price = string(thbjattr_thbj-attr.property-value-integer).
      643       if p-prop-host-code = p-host-code
      644       and (p-alias-type-price = '':U
      645       or   p-alias-type-price <> '5':U)
      646       then  do:
      647         assign
      648         p-ext-doc-type = 'ev':U
      649         p-price-obj-type = p-obj-type
      650         p-price-obj-code = p-obj-code
      651         p-alias-type-price = '3':U
      652         .
      653       end.
      654       else do:
      655         if p-prop-host-code = p-host-code  then do:
      656           assign
      657           p-ext-doc-type = 'ev':U
      658           p-price-obj-type = p-obj-type
      659           p-price-obj-code = p-obj-code
      660           .
      661         end.
      662         else do:
      663           assign
      664           p-ext-doc-type = 'ee':U.
      665           assign
      666           v-mediat-obj-type = "":U
      667           v-mediat-obj-code = 0
      668           v-mediat-objf = "":U
      669           .
      670           if p-alias-type-price = '4':U then do:
      671             find first thbjattr_thbj-attr where
      672                       thbjattr_thbj-attr.obj-type = p-prop-obj-type
      673                   and thbjattr_thbj-attr.obj-code = p-prop-obj-code
      674                   and thbjattr_thbj-attr.upper-prop-code = 'alias-tpsi':U
      675                   and thbjattr_thbj-attr.prop-code = 'alias-object-price':U no-error.
      676             if not available thbjattr_thbj-attr
      677             or thbjattr_thbj-attr.property-value-character = "":U then do:
      678               undo _main, return error substitute("Не найден объект-посредник для межфирменного перемещения ЧУЖИХ товаров с &1&2"
      679                                       , p-prop-obj-type
      680                                       , p-prop-obj-code).
      681             end.
      682             assign
      683             v-mediat-objf     = thbjattr_thbj-attr.property-value-character
      684             v-mediat-obj-type = entry(1, v-mediat-objf)
      685             v-mediat-obj-code = integer(entry(2, v-mediat-objf))
      686             no-error
      687             .
      688             if error-status:error then do:
      689               undo _main, return error substitute("Неверный формат атрибута ОБЪЕКТ-ПОСРЕДНИК для межфирменного перемещения ЧУЖИХ товаров для &1&2"
      690                                       , p-prop-obj-type
      691                                       , p-prop-obj-code).
      692             end.
      693           end.
      694           CASE p-alias-type-price:
      695             when '1':U then do:
      696               assign
      697               p-price-obj-type = p-prop-obj-type
      698               p-price-obj-code = p-prop-obj-code
      699               .
      700             end.
      701             when '2':U then do:
      702               assign
      703               p-price-obj-type = p-prop-obj-type
      704               p-price-obj-code = p-prop-obj-code
      705               .
      706             end.
      707             when '3':U
      708             or
      709             when '5':U
      710             then do:
      711               assign
      712               p-price-obj-type = p-obj-type
      713               p-price-obj-code = p-obj-code
      714               .
      715             end.
      716             when '4':U then do:
      717               assign
      718               p-price-obj-type = v-mediat-obj-type
      719               p-price-obj-code = v-mediat-obj-code
      720               .
      721             end.
      722           END CASE.
      723         end.
      724       end.
      725     end.
      726   end procedure.
      727   procedure write-tt0-info:
      728   define input parameter p-artic as character no-undo .
      729   define input parameter p-prod-type as character no-undo .
      730   define input parameter p-prod-code as integer no-undo .
      731   define input parameter p-prt-code as integer no-undo .
      732   define input parameter p-obj-type as character no-undo .
      733   define input parameter p-obj-code as integer no-undo .
      734   define input parameter p-doc-code as character no-undo .
      735   define input parameter p-from-tpsi as logical no-undo .
      736   define input parameter p-all-qnty as decimal no-undo .
      737   define input parameter p-was-res as decimal no-undo .
      738   define input parameter p-to-res as decimal no-undo .
      739   define input parameter p-is-res as decimal no-undo .
      740   define input parameter p-o-was-res as decimal no-undo .
      741   define input parameter p-o-to-res as decimal no-undo .
      742   define input parameter p-o-is-res as decimal no-undo .
      743   define input parameter p-mess   as character no-undo .
      744   define buffer buf_tt0-info for tt0-info.
      745     do
      746     on error undo, return error return-value
      747     :
      748       find first buf_tt0-info where
      749                buf_tt0-info.artic = p-artic
      750            and buf_tt0-info.prod-type = p-prod-type
      751            and buf_tt0-info.prod-code = p-prod-code
      752            and buf_tt0-info.prt-code = p-prt-code
      753            no-error .
      754       if not available buf_tt0-info then do:
      755         create buf_tt0-info.
      756         assign
      757         buf_tt0-info.artic = p-artic
      758         buf_tt0-info.prod-type = p-prod-type
      759         buf_tt0-info.prod-code = p-prod-code
      760         buf_tt0-info.prt-code  = p-prt-code
      761         buf_tt0-info.obj-type  = p-obj-type
      762         buf_tt0-info.obj-code  = p-obj-code
      763         buf_tt0-info.a-to-res  = ?
      764         buf_tt0-info.to-res    = ?
      765         buf_tt0-info.was-res   = ?
      766         buf_tt0-info.o-was-res = ?
      767         buf_tt0-info.o-to-res  = ?
      768         buf_tt0-info.o-is-res  = ?
      769         buf_tt0-info.is-res    = ?
      770         .
      771       end.
      772       assign
      773       buf_tt0-info.a-to-res  =
      774                                 (if buf_tt0-info.a-to-res <> ?
      775                                 and p-all-qnty = ?
      776                                 then buf_tt0-info.a-to-res
      777                                 else p-all-qnty)
      778       buf_tt0-info.was-res   = (if buf_tt0-info.was-res <> ?
      779                                 and p-was-res = ?
      780                                 then buf_tt0-info.was-res
      781                                 else p-was-res)
      782       buf_tt0-info.to-res    = (if buf_tt0-info.to-res <> ?
      783                                 and p-to-res = ?
      784                                 then buf_tt0-info.to-res
      785                                 else p-to-res)
      786       buf_tt0-info.is-res    = (if buf_tt0-info.is-res <> ?
      787                                 and p-is-res = ?
      788                                 then buf_tt0-info.is-res
      789                                 else p-is-res)
      790       buf_tt0-info.o-was-res   = (if buf_tt0-info.o-was-res <> ?
      791                                 and p-o-was-res = ?
      792                                 then buf_tt0-info.o-was-res
      793                                 else p-o-was-res)
      794       buf_tt0-info.o-to-res    = (if buf_tt0-info.o-to-res <> ?
      795                                 and p-o-to-res = ?
      796                                 then buf_tt0-info.o-to-res
      797                                 else p-o-to-res)
      798       buf_tt0-info.o-is-res    = (if buf_tt0-info.o-is-res <> ?
      799                                 and p-o-is-res = ?
      800                                 then buf_tt0-info.o-is-res
      801                                 else p-o-is-res)
      802       .
      803       assign
      804       buf_tt0-info.doc-code  = p-doc-code
      805       buf_tt0-info.error-message   = p-mess
      806       .
      807     end.
      808   end procedure.
      809   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      810   procedure cur-time :
      811      define output parameter p-today as date      no-undo .
      812      define output parameter p-time  as integer   no-undo .
      813     do
      814     on error undo, return error
      815     :
      816       define variable v-date1 as date      no-undo .
      817       define variable v-date2 as date      no-undo .
      818       define variable v-time  as integer   no-undo .
      819       assign
      820         v-date1 = today
      821         v-time  = time
      822         v-date2 = today
      823       .
      824       if v-date1 <> v-date2
      825       then do:
      826         assign
      827           v-date1 = today
      828           v-time  = v-time
      829         .
      830       end.
      831       assign
      832         p-today = v-date1
      833         p-time  = v-time
      834       .
      835     end.
      836   end.
      837   function cur-time-date returns character
      838   :
      839     return string(today, '99/99/9999':U) .
      840   end.
      841   function cur-time-mjd returns decimal
      842   :
      843     define variable v-date as date      no-undo .
      844     define variable v-time as integer   no-undo .
      845     run cur-time in this-procedure
      846       (output v-date
      847       ,output v-time
      848       ) .
      849     return integer(v-date) - 2400002 + (v-time / 86400) .
      850   end.
      851   function cur-time-get-ending-index returns integer
      852   (input p-number as integer
      853   )
      854   :
      855     if p-number < 0
      856     or p-number = ?
      857     then do:
      858       return 1 .
      859     end.
      860     define variable v-rest as integer   no-undo .
      861     assign
      862       p-number = p-number modulo 100
      863     .
      864     if p-number < 20
      865     then do:
      866       assign
      867         v-rest = p-number
      868       .
      869     end.
      870     else do:
      871       assign
      872         v-rest = p-number modulo 10
      873       .
      874     end.
      875     case v-rest :
      876       when 1
      877       then do:
      878         return 2 .
      879       end.
      880       when 2 or
      881       when 3 or
      882       when 4
      883       then do:
      884         return 3 .
      885       end.
      886       otherwise do:
      887         return 1 .
      888       end.
      889     end case .
      890   end.
      891   procedure cur-time-mjd-to-date :
      892      define input  parameter i-mjd-diff as decimal no-undo.
      893      define output parameter o-Date     as date    no-undo.
      894      define output parameter o-Time     as integer no-undo.
      895      define variable v-day-number as integer   no-undo .
      896      if    i-mjd-diff < 0
      897         or i-mjd-diff = ?
      898      then do:
      899         return "?" .
      900      end.
      901      assign
      902         v-day-number = truncate(i-mjd-diff,0).
      903         o-Date = date(v-day-number + 2400002).
      904         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      905     .
      906   end.
      907   function cur-time-mjd-to-string returns character
      908   (input p-mjd-diff as decimal
      909   )
      910   :
      911     define variable v-day-number as integer   no-undo .
      912     define variable v-seconds    as integer   no-undo .
      913     define variable v-hour       as integer   no-undo .
      914     define variable v-min        as integer   no-undo .
      915     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      916     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      917     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      918     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      919     if p-mjd-diff < 0
      920     or p-mjd-diff = ?
      921     then do:
      922       return "?" .
      923     end.
      924     assign
      925       v-day-number = integer(truncate(p-mjd-diff,0))
      926       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      927     .
      928     if v-seconds > 86400
      929     then do:
      930       assign
      931         v-seconds = 86400 - 1
      932       .
      933     end.
      934     if v-seconds < 0
      935     then do:
      936       assign
      937         v-seconds = 0
      938       .
      939     end.
      940     assign
      941       v-hour = truncate(v-seconds / 3600, 0)
      942     .
      943     assign
      944       v-seconds = v-seconds modulo 3600
      945     .
      946     assign
      947       v-min = truncate(v-seconds / 60, 0)
      948     .
      949     assign
      950       v-seconds = v-seconds modulo 60
      951     .
      952     return
      953         (if v-day-number <> 0
      954           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      955           else ""
      956         )
      957       + (if v-day-number <> 0 or v-hour <> 0
      958           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      959           else ""
      960         )
      961       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      962           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      963           else ""
      964         )
      965       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      966       .
      967   end.
      968   function cur-time-string returns character
      969   :
      970     define variable v-date as date      no-undo .
      971     define variable v-time as integer   no-undo .
      972     run cur-time in this-procedure
      973       (output v-date
      974       ,output v-time
      975       ) .
      976     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      977   end.
      978   function cur-time-string-sec returns character
      979   :
      980     define variable v-date as date      no-undo .
      981     define variable v-time as integer   no-undo .
      982     run cur-time in this-procedure
      983       (output v-date
      984       ,output v-time
      985       ) .
      986     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      987   end.
      988   function cur-time-custom  returns character
      989   (input p-prefix as character
      990   ,input p-date-format as character
      991   ,input p-delimiter as character
      992   ,input p-time-format as character
      993   ,input p-suffix as character
      994   )
      995   :
      996     define variable v-date as date      no-undo .
      997     define variable v-time as integer   no-undo .
      998     run cur-time in this-procedure
      999       (output v-date
     1000       ,output v-time
     1001       ) .
     1002     return
     1003       p-prefix
     1004       + string(v-date, p-date-format)
     1005       + p-delimiter
     1006       + string(v-time, p-time-format)
     1007       + p-suffix
     1008       .
     1009   end.
     1010   function cur-time-print  returns character
     1011   :
     1012     define variable v-date as date      no-undo .
     1013     define variable v-time as integer   no-undo .
     1014     run cur-time in this-procedure
     1015       (output v-date
     1016       ,output v-time
     1017       ) .
     1018     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1019   end.
