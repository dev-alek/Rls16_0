     1316   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1317     define variable v-cntxt-db-num        as integer   no-undo .
     1318     define variable v-cntxt-userid        as character no-undo .
     1319     define variable v-cntxt-level         as character no-undo .
