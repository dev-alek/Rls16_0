     1332   define variable cre-pay           like ub.cash-pay.cdpay-code no-undo .
     1333   define variable varobj-date       as date      no-undo .
     1334   define variable varshift-date     like ub.shift-obj.shift-date no-undo .
     1335   define variable varshift-num      like ub.shift-obj.shift-num  no-undo .
     1336   define variable varshift-name     as character no-undo.
     1337   define variable l-shift-on        as logical   no-undo .
     1338   define variable varmin-fact-order as decimal   no-undo .
     1339   define variable v-err-mes         as character no-undo .
     1340   define variable conf-par          as character no-undo .
     1341   define variable par-type          as character no-undo .
     1342   define variable varchip-code      as integer   no-undo .
     1343   define variable varchip-code2     as integer   no-undo .
     1344   define variable wth-ii            as integer   no-undo .
     1345   define variable v-can-del-fbr-doc as logical   no-undo.
     1346   define variable v-supp-doc-code   as character no-undo initial '0'.
     1347   define variable log-file-name     as character no-undo initial 'delfsale.log'.
     1348   define variable v-need-saledc     as logical no-undo .
     1349   define buffer buf_inkas for ub.inkas .
     1350   define buffer buf_obj for ub.clients.
     1351   define buffer sale_trn-doc for ub.trn-doc .
     1352   define buffer buf_wth-doc for ub.wth-doc .
     1353   define buffer buf_cash-pay for ub.cash-pay.
     1354   define buffer bf-pri_trn-doc for ub.trn-doc.
     1355   define buffer bf_clients for ub.clients.
     1356   define buffer supp_trn-doc for ub.trn-doc .
     1357   define buffer neg_trn-doc for ub.trn-doc .
     1358   define buffer buf_sale-doc for ub.sale-doc.
     1359   define buffer buf_trn-doc for ub.trn-doc.
     1360   define buffer locked_trn-doc for ub.trn-doc.
     1361   define buffer tpsi_sale-doc for ub.sale-doc.
     1362   define stream LogStream.
     1363   _main:
     1364   do transaction
     1365   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1366   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     1367   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     1368   :
     1369     if not g#news then do:
     1370   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1371     run mainmenu_getcntxt in parparentproc
     1372       (output v-cntxt-db-num
     1373       ,output v-cntxt-userid
     1374       ,output v-cntxt-level
     1375       ,output v-cntxt-host-code-obj
     1376       ,output v-cntxt-obj-type
     1377       ,output v-cntxt-obj-code
     1378       ,output v-cntxt-db-num-obj
     1379       ,output v-cntxt-is-admin
     1380       ) .
     1381     end.
     1382     else do:
     1383       run get-db-num in parparentproc ( output v-cntxt-db-num).
     1384       run get-userid in parparentproc ( output v-cntxt-userid).
     1385     end.
     1386     if search ("del-doc.err") <> ?
     1387     then do:
     1388       os-delete "del-doc.err".
     1389     end.
     1390     assign
     1391     parinkas-code = p-parameter
     1392     .
     1393     find first buf_inkas exclusive-lock
     1394       where buf_inkas.inkas-code = parinkas-code
     1395       no-error .
     1396     if not available buf_inkas
     1397     then do:
     1398        if g#news                                                                                                             then .                          else run write-log-and-file in p-log-handle (                                                                                    input 1                                                                                                             , input log-file-name                                                                                                 , input 1                                                                                                             , input substitute("&1 &2 &3&4!!!Ошибка задания входных параметров: не найдена продажа &5"                  ,vss-workfile                                                                             ,vss-revision                                                                             ,vss-description                                                                          , chr(10)                                                                           , parinkas-code)).
