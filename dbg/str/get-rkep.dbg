     2096   function get-rkgTH-price returns decimal(input p-obj-type as character
     2097                                          , input p-obj-code as integer
     2098                                          , input p-b-code as integer
     2099                                          , output p-doc-num as character):
     2100   define variable v-price-sale as decimal   no-undo init ?.
     2101   define variable v-road-tax   as decimal   no-undo .
     2102   define variable v-excise     as decimal   no-undo .
     2103   define variable v-vat-pc     as decimal   no-undo .
     2104   define variable v-slt-pc     as decimal   no-undo .
     2105   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2106   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcprcex in g#library
     2107     (input  p-obj-type
     2108     ,input  p-obj-code
     2109     ,input  p-b-code
     2110     ,input  0
     2111     ,input  0
     2112     ,output p-doc-num
     2113     ,output v-price-sale
     2114     ,output v-road-tax
     2115     ,output v-excise
     2116     ,output v-vat-pc
     2117     ,output v-slt-pc
     2118     ) no-error .
     2119   if not error-status:error then return v-price-sale.
     2120   END FUNCTION.
     2121   function get-rkgTH-name returns character(input p-obj-type as character
     2122                                             ,input p-obj-code as integer
     2123                                             ,input p-b-code as integer
     2124                                             , buffer buf_goods for ub.goods):
     2125   define variable v-gds-name as character no-undo .
     2126   define VARIABLE varresult   as character                no-undo.
     2127   define VARIABLE vartype-bc  as character                no-undo.
     2128   define VARIABLE varweight   as decimal                  no-undo.
     2129   DEFINE VARIABLE v-unit-cli AS CHARACTER NO-UNDO.
     2130   DEFINE VARIABLE v-f-name AS CHARACTER NO-UNDO.
     2131   DEFINE BUFFER buf_bar-code FOR ub.bar-code.
     2132   DEFINE BUFFER buf_prod-bc FOR ub.prod-bc.
     2133   DEFINE BUFFER buf_place FOR ub.place.
     2134   DEFINE BUFFER buf_gds-prt FOR ub.gds-prt.
     2135   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     2136   (
     2137    input  parparentproc
     2138   ,input  STRING(p-b-code)
     2139   ,input  0
     2140   ,input  p-obj-type
     2141   ,input  p-obj-code
     2142   ,input  NO
     2143   ,input  YES
     2144   ,input  varscales-pref14
     2145   ,input  varpgscales-pref14
     2146   ,output varresult
     2147   ,output vartype-bc
     2148   ,output varweight
     2149   ,buffer buf_bar-code
     2150   ,buffer buf_prod-bc
     2151   ,buffer buf_place
     2152   ) no-error.
     2153   if not available buf_bar-code then
     2154   return "!!!НЕИЗВЕСТНЫЙ ТОВАР".
     2155   FIND FIRST buf_goods NO-LOCK WHERE
     2156             buf_goods.gds-code = buf_bar-code.gds-code NO-ERROR.
     2157   IF NOT AVAILABLE buf_goods THEN DO:
     2158     return "!!!НЕИЗВЕСТНЫЙ ТОВАР".
     2159   END.
     2160   else do:
     2161     assign
     2162     v-gds-name = buf_goods.chk-name
     2163     .
     2164   end.
     2165   IF buf_bar-code.unit-cli <> buf_goods.unit-base THEN DO:
     2166     ASSIGN
     2167     v-unit-cli = "*" + string(buf_bar-code.cli-base-rate).
     2168   END.
     2169   FIND FIRST buf_gds-prt NO-LOCK WHERE
     2170             buf_gds-prt.upper-code = buf_goods.prt-root NO-ERROR.
     2171   if buf_gds-prt.node-name <>  '_Пустая шкала':U THEN DO:
     2172       FIND FIRST buf_gds-prt NO-LOCK WHERE
     2173                 buf_gds-prt.node-code = buf_bar-code.node-code NO-ERROR.
     2174   END.
     2175   ASSIGN
     2176   v-f-name = (IF AVAILABLE buf_gds-prt THEN buf_gds-prt.f-name ELSE "":U).
     2177   ASSIGN
     2178   v-gds-name = v-gds-name + chr(32) + v-f-name + v-unit-cli.
     2179   return v-gds-name.
     2180   END FUNCTION.
     2181   function get-rkgTH-group returns integer(input p-obj-type as character
     2182                                           , input p-obj-code  as integer
     2183                                           , input p-gds-code as integer
     2184                                           , output p-grp-name as character
     2185                                           ):
     2186   DEFINE BUFFER buf_fbr-gds-obj FOR ub.fbr-gds-obj.
     2187   DEFINE BUFFER buf_fbr-gds-grp FOR ub.fbr-gds-grp.
     2188   FIND FIRST buf_fbr-gds-obj NO-LOCK WHERE
     2189           buf_fbr-gds-obj.obj-type = p-obj-type
     2190       AND buf_fbr-gds-obj.obj-code = p-obj-code
     2191       AND buf_fbr-gds-obj.gds-code = p-gds-code NO-ERROR.
     2192   IF AVAILABLE buf_fbr-gds-obj THEN DO:
     2193     RUN fbrglib-get-full-name IN THIS-PROCEDURE(
     2194                                                 input p-obj-type
     2195                                                 ,INPUT p-obj-code
     2196                                                 ,INPUT buf_fbr-gds-obj.fbr-grp-code
     2197                                                 ,OUTPUT p-grp-name) NO-ERROR.
     2198     return buf_fbr-gds-obj.fbr-grp-code.
     2199   END.
     2200   return ?.
     2201   END FUNCTION.
     2202   function get-rkgTH-modificator returns logical(input p-obj-type as character
     2203                                           , input p-obj-code  as integer
     2204                                           , input p-gds-code as integer
     2205                                           , output p-is-null-price as logical
     2206                                           ):
     2207   DEFINE BUFFER buf_fbr-gds-obj FOR ub.fbr-gds-obj.
     2208   FIND FIRST buf_fbr-gds-obj NO-LOCK WHERE
     2209           buf_fbr-gds-obj.obj-type = p-obj-type
     2210       AND buf_fbr-gds-obj.obj-code = p-obj-code
     2211       AND buf_fbr-gds-obj.gds-code = p-gds-code NO-ERROR.
     2212   IF AVAILABLE buf_fbr-gds-obj THEN DO:
     2213     assign
     2214     p-is-null-price = buf_fbr-gds-obj.is-null-price
     2215     .
     2216     return buf_fbr-gds-obj.is-modificator.
     2217   END.
     2218   assign
     2219   p-is-null-price = no.
     2220   return no.
     2221   END FUNCTION.
     2222   function get-rkgTH-group-name returns character(input p-obj-type as character
     2223                                                 , input p-obj-code  as integer
     2224                                                 , input p-out-code as integer):
     2225   DEFINE BUFFER buf_fbr-gds-grp FOR ub.fbr-gds-grp.
     2226   find first buf_fbr-gds-grp no-lock where
     2227             buf_fbr-gds-grp.obj-type = p-obj-type
     2228         AND buf_fbr-gds-grp.obj-code = p-obj-code
     2229         and buf_fbr-gds-grp.out-code = p-out-code no-error .
     2230   if not available buf_fbr-gds-grp then return ?.
     2231   return buf_fbr-gds-grp.node-name.
     2232   END FUNCTION.
     2233   function get-rkgTH-parent returns integer(input p-obj-type as character
     2234                                             , input p-obj-code  as integer
     2235                                             , input p-out-code as integer):
     2236   DEFINE BUFFER buf_fbr-gds-grp FOR ub.fbr-gds-grp.
     2237   DEFINE BUFFER upper_fbr-gds-grp FOR ub.fbr-gds-grp.
     2238   find first buf_fbr-gds-grp no-lock where
     2239             buf_fbr-gds-grp.obj-type = p-obj-type
     2240         AND buf_fbr-gds-grp.obj-code = p-obj-code
     2241         and buf_fbr-gds-grp.out-code = p-out-code no-error .
     2242   if not available buf_fbr-gds-grp then return ?.
     2243   find first upper_fbr-gds-grp no-lock where
     2244             upper_fbr-gds-grp.obj-type = p-obj-type
     2245         AND upper_fbr-gds-grp.obj-code = p-obj-code
     2246         and upper_fbr-gds-grp.out-code = buf_fbr-gds-grp.upper-code no-error .
     2247   if not available upper_fbr-gds-grp then return ?.
     2248   return upper_fbr-gds-grp.out-code.
     2249   END FUNCTION.
     2250   procedure get-rkep-full-grp-name :
     2251   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     2252   DEFINE INPUT PARAMETER p-grp-code LIKE ub.cd-grp.grp-code NO-UNDO.
     2253   define output parameter p-full-name as character    no-undo.
     2254   define variable v-upper-code    as integer  no-undo.
     2255   define buffer buf_cd-grp       for ub.cd-grp.
     2256   define buffer buf_upper_cd-grp for ub.cd-grp.
     2257   do
     2258   on error undo, return error
     2259   :
     2260       if P-grp-code = 0
     2261       then do:
     2262           assign
     2263               p-full-name = ""
     2264           .
     2265       end.
     2266       else do:
     2267           find first buf_cd-grp no-lock where
     2268                  buf_cd-grp.obj-type = 'маг':U
     2269              and buf_cd-grp.obj-code = p-obj-code
     2270              and buf_cd-grp.pos-type = 'r-keeper':U
     2271              and buf_cd-grp.grp-type = '':U
     2272              and buf_cd-grp.grp-code = p-grp-code
     2273           no-error.
     2274           if not available buf_cd-grp
     2275           then do:
     2276               undo, return error substitute("get-rkep-grp-name: Не найдена группа меню на кассе R-KEEPER с кодом &1", p-grp-code).
     2277           end.
     2278           assign
     2279               p-full-name  = ""
     2280               v-upper-code = 0
     2281           .
     2282           do while true
     2283           on error undo, return error "get-rkep-grp-name: Ошибка составления полного имени группы"
     2284           :
     2285               assign
     2286               p-full-name  = buf_cd-grp.grp-name
     2287                           + (if p-full-name <> "" then chr(47) else "")
     2288                           + p-full-name
     2289               v-upper-code = buf_cd-grp.upper-grp-code
     2290               .
     2291               if buf_cd-grp.grp-code = 0
     2292               then do:
     2293                   leave.
     2294               end.
     2295               find first buf_cd-grp no-lock where
     2296                         buf_cd-grp.obj-type = 'маг':U
     2297                     and buf_cd-grp.obj-code = p-obj-code
     2298                     and buf_cd-grp.pos-type = 'r-keeper':U
     2299                     and buf_cd-grp.grp-type = '':U
     2300                     and buf_cd-grp.grp-code = v-upper-code no-error.
     2301               if not available buf_cd-grp
     2302               then do:
     2303                   undo, return error "get-rkep-grp-name: Не найдена группа товаров с кодом "
     2304                                       + string( v-upper-code )
     2305                                       + ". Ошибка ссылки в дереве товаров для узла p-id".
     2306               end.
     2307           end.
     2308           assign
     2309               p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     2310           .
     2311       end.
     2312   end.
     2313   end procedure.
     2314   function get-price-id-from-int returns character ( input p-file-num as integer):
     2315     return ('price-list':U + chr(32) +  string(p-file-num)).
     2316   end function.
     2317   define variable vss-include-info16 as character format "X(65)" no-undo
     2318   initial "@(#)$Workfile$ $Revision$".
     2319   define temp-table temp_fbrglib_grp no-undo
     2320       field sel           as character
     2321       field full-name     as character
     2322       field out-code      as integer
     2323       field sort-name     as character
     2324       field node-code     as integer
     2325       field upper-code    as integer
     2326       field name          as character
     2327       field level         as integer
     2328       field mark          as character
     2329       field obj-type      as character
     2330       field obj-code      as integer
     2331       field global-code   as integer
     2332       index pi is primary unique obj-type obj-code sort-name
     2333       index fn obj-type obj-code full-name
     2334       index nc is unique obj-type obj-code node-code
     2335       index sl obj-type obj-code sel
     2336       index uc obj-type obj-code upper-code
     2337   .
     2338   define temp-table temp_fbrglib_found-grp no-undo
     2339       field full-name   as character
     2340       field sort-name   as character
     2341       field node-code   as integer
     2342       field level       as integer
     2343       field is-terminal as logical
     2344       field obj-type      as character
     2345       field obj-code      as integer
     2346       index pi is primary unique obj-type obj-code sort-name
     2347       index fn obj-type obj-code full-name
     2348       index lv obj-type obj-code level
     2349       index it obj-type obj-code is-terminal
     2350   .
     2351   define temp-table temp_found-result-nodelist no-undo
     2352       field node-code     as integer
     2353       field processed     as logical
     2354       field sort-name     as character
     2355       field full-name     as character
     2356       index pi is primary unique node-code
     2357       index ps processed
     2358   .
     2359   procedure fbrglib-get-sort-name :
     2360   do
     2361   on error undo, return error
     2362   :
     2363   define input parameter p-obj-type   as character    no-undo.
     2364   define input parameter p-obj-code   as integer      no-undo.
     2365   define input parameter p-node-code  as integer      no-undo.
     2366   define output parameter p-sort-name as character    no-undo.
     2367       define variable v-upper-code    as integer           no-undo.
     2368       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     2369       define buffer buf_upper_fbr-gds-grp for ub.fbr-gds-grp.
     2370       find first buf_fbr-gds-grp no-lock
     2371            where buf_fbr-gds-grp.obj-type  = p-obj-type
     2372              and buf_fbr-gds-grp.obj-code  = p-obj-code
     2373              and buf_fbr-gds-grp.node-code = p-node-code
     2374       no-error.
     2375       if not available buf_fbr-gds-grp
     2376       then do:
     2377           undo, return error "fbrglib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     2378       end.
     2379       assign
     2380           p-sort-name  = ""
     2381           v-upper-code = 1
     2382       .
     2383       do while true
     2384       on error undo, return error "fbrglib-get-sort-name: Ошибка составления полного имени группы"
     2385       :
     2386           assign
     2387               p-sort-name  = buf_fbr-gds-grp.node-name
     2388                            + (if p-sort-name <> "" then chr(2) else "")
     2389                            + p-sort-name
     2390               v-upper-code = buf_fbr-gds-grp.upper-code
     2391           .
     2392           if buf_fbr-gds-grp.upper-code = 1
     2393           then do:
     2394               leave.
     2395           end.
     2396           find first buf_fbr-gds-grp no-lock
     2397                where buf_fbr-gds-grp.obj-type  = p-obj-type
     2398                  and buf_fbr-gds-grp.obj-code  = p-obj-code
     2399                  and buf_fbr-gds-grp.node-code = v-upper-code
     2400           no-error.
     2401           if not available buf_fbr-gds-grp
     2402           then do:
     2403               undo, return error "fbrglib-get-sort-name: Не найдена группа товаров с кодом "
     2404                                   + string( v-upper-code )
     2405                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2406           end.
     2407       end.
     2408   end.
     2409   end procedure.
     2410   procedure fbrglib-get-full-name :
     2411   do
     2412   on error undo, return error
     2413   :
     2414   define input parameter p-obj-type   as character    no-undo.
     2415   define input parameter p-obj-code   as integer      no-undo.
     2416   define input parameter p-node-code  as integer      no-undo.
     2417   define output parameter p-full-name as character    no-undo.
     2418       define variable v-upper-code    as integer           no-undo.
     2419       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     2420       define buffer buf_upper_fbr-gds-grp for ub.fbr-gds-grp.
     2421       if p-node-code = 1
     2422       then do:
     2423           assign
     2424               p-full-name = ""
     2425           .
     2426       end.
     2427       else do:
     2428           find first buf_fbr-gds-grp no-lock
     2429                where buf_fbr-gds-grp.obj-type  = p-obj-type
     2430                  and buf_fbr-gds-grp.obj-code  = p-obj-code
     2431                  and buf_fbr-gds-grp.node-code = p-node-code
     2432           no-error.
     2433           if not available buf_fbr-gds-grp
     2434           then do:
     2435               undo, return error "fbrglib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     2436           end.
     2437           assign
     2438               p-full-name  = ""
     2439               v-upper-code = 1
     2440           .
     2441           do while true
     2442           on error undo, return error "fbrglib-get-full-name: Ошибка составления полного имени группы"
     2443           :
     2444               assign
     2445                   p-full-name  = buf_fbr-gds-grp.node-name
     2446                               + (if p-full-name <> "" then chr(47) else "")
     2447                               + p-full-name
     2448                   v-upper-code = buf_fbr-gds-grp.upper-code
     2449               .
     2450               if buf_fbr-gds-grp.upper-code = 1
     2451               then do:
     2452                   leave.
     2453               end.
     2454               find first buf_fbr-gds-grp no-lock
     2455                    where buf_fbr-gds-grp.obj-type  = p-obj-type
     2456                      and buf_fbr-gds-grp.obj-code  = p-obj-code
     2457                      and buf_fbr-gds-grp.node-code = v-upper-code
     2458               no-error.
     2459               if not available buf_fbr-gds-grp
     2460               then do:
     2461                   undo, return error "fbrglib-get-full-name: Не найдена группа товаров с кодом "
     2462                                       + string( v-upper-code )
     2463                                       + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2464               end.
     2465           end.
     2466           assign
     2467               p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     2468           .
     2469       end.
     2470   end.
     2471   end procedure.
     2472   procedure fbrglib-get-root-code :
     2473   do
     2474   on error undo, return error
     2475   :
     2476   define output parameter p-root-code as integer      no-undo.
     2477       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     2478       find first buf_fbr-gds-grp no-lock
     2479            where buf_fbr-gds-grp.upper-code = 0
     2480       no-error .
     2481       if not available buf_fbr-gds-grp
     2482       then do:
     2483           undo, return error .
     2484       end.
     2485       else do:
     2486           assign
     2487               p-root-code = buf_fbr-gds-grp.node-code
     2488           .
     2489       end.
     2490   end.
     2491   end procedure.
     2492   procedure fbrglib-find-grp-by-full-name :
     2493   do
     2494   on error undo, return error
     2495   :
     2496   define input parameter p-obj-type     as character    no-undo.
     2497   define input parameter p-obj-code     as integer      no-undo.
     2498   define input parameter p-search-name  as character    no-undo.
     2499   define input parameter p-fill-path    as logical      no-undo.
     2500       define variable v-upper-code    as integer          no-undo.
     2501       define variable v-not-found     as logical init yes no-undo.
     2502       define variable v-counter       as integer           no-undo.
     2503       define variable v-level         as integer           no-undo.
     2504       define variable v-full-name     as character         no-undo.
     2505       define variable v-sort-name     as character         no-undo.
     2506       define variable v-node-name     as character      no-undo.
     2507       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     2508       assign
     2509           p-search-name = replace( p-search-name, chr(47), chr(2) )
     2510       .
     2511       run fbrglib-get-root-code ( output v-upper-code ) no-error .
     2512       if error-status :error
     2513       then do:
     2514           undo, return error "fbrglib-find-grp-by-full-name: Ошибка при поиске корневого узла".
     2515       end.
     2516       assign
     2517           v-full-name  = ""
     2518           v-level      = num-entries( p-search-name, chr(2) )
     2519       .
     2520       for each temp_fbrglib_found-grp
     2521       :
     2522           delete temp_fbrglib_found-grp.
     2523       end.
     2524       start-name-analyze:
     2525       do v-counter = 1 to v-level
     2526       :
     2527           if v-counter < v-level
     2528           then do:
     2529               assign
     2530                   v-node-name = entry( v-counter, p-search-name, chr(2) )
     2531               .
     2532               find first buf_fbr-gds-grp no-lock
     2533                    where buf_fbr-gds-grp.obj-type   = p-obj-type
     2534                      and buf_fbr-gds-grp.obj-code   = p-obj-code
     2535                      and buf_fbr-gds-grp.upper-code = v-upper-code
     2536                      and buf_fbr-gds-grp.node-name  = v-node-name
     2537               no-error .
     2538               if not available buf_fbr-gds-grp
     2539               then do:
     2540                   assign
     2541                       v-full-name  = p-search-name
     2542                       v-sort-name  = p-search-name
     2543                   .
     2544                   return error "fbrglib-find-grp-by-full-name: не найдена группа " + entry( v-level, p-search-name, chr(47) ).
     2545               end.
     2546               else do:
     2547                   assign
     2548                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_fbr-gds-grp.node-name
     2549                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_fbr-gds-grp.node-name
     2550                       v-upper-code = buf_fbr-gds-grp.node-code
     2551                   .
     2552                   if p-fill-path = yes
     2553                   then do:
     2554                       create temp_fbrglib_found-grp.
     2555                       assign
     2556                           temp_fbrglib_found-grp.full-name = v-full-name + chr(47)
     2557                           temp_fbrglib_found-grp.sort-name = v-sort-name
     2558                           temp_fbrglib_found-grp.node-code = v-upper-code
     2559                           temp_fbrglib_found-grp.level     = v-counter
     2560                           temp_fbrglib_found-grp.obj-type  = p-obj-type
     2561                           temp_fbrglib_found-grp.obj-code  = p-obj-code
     2562                       .
     2563                   end.
     2564               end.
     2565           end.
     2566           else do:
     2567               for each buf_fbr-gds-grp no-lock
     2568                  where buf_fbr-gds-grp.obj-type   = p-obj-type
     2569                    and buf_fbr-gds-grp.obj-code   = p-obj-code
     2570                    and buf_fbr-gds-grp.upper-code = v-upper-code
     2571                    and buf_fbr-gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     2572               :
     2573                   assign
     2574                       v-not-found = no
     2575                   .
     2576                   create temp_fbrglib_found-grp.
     2577                   assign
     2578                       temp_fbrglib_found-grp.full-name = v-full-name
     2579                                                           + (if v-full-name = "" then "" else chr(47) )
     2580                                                           + buf_fbr-gds-grp.node-name + chr(47)
     2581                       temp_fbrglib_found-grp.sort-name = v-sort-name
     2582                                                           + ( if v-sort-name = "" then "" else chr(2) )
     2583                                                           + buf_fbr-gds-grp.node-name
     2584                       temp_fbrglib_found-grp.node-code = buf_fbr-gds-grp.node-code
     2585                       temp_fbrglib_found-grp.level     = v-level
     2586                       temp_fbrglib_found-grp.obj-type  = p-obj-type
     2587                       temp_fbrglib_found-grp.obj-code  = p-obj-code
     2588                   .
     2589               end.
     2590               if v-not-found = yes
     2591               then do:
     2592                   assign
     2593                       v-full-name  = p-search-name
     2594                       v-sort-name  = p-search-name
     2595                   .
     2596                   for each temp_fbrglib_found-grp
     2597                   :
     2598                       delete temp_fbrglib_found-grp.
     2599                   end.
     2600                   return error "fbrglib-find-grp-by-full-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     2601               end.
     2602           end.
     2603       end.
     2604   end.
     2605   end procedure.
     2606   procedure fbrglib-find-all-subgroup :
     2607   do
     2608   on error undo, return error
     2609   :
     2610   define input parameter p-start-obj-type     as character    no-undo.
     2611   define input parameter p-start-obj-code     as integer      no-undo.
     2612   define input parameter p-start-node-code    as integer      no-undo.
     2613   define input parameter p-terminal-only      as logical      no-undo.
     2614       define variable v-start-full-name   as character     no-undo.
     2615       define variable v-start-sort-name   as character     no-undo.
     2616       define variable v-not-found         as logical       no-undo.
     2617       define variable v-is-terminal       as logical       no-undo.
     2618       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
     2619       create temp_found-result-nodelist.
     2620       assign
     2621           temp_found-result-nodelist.node-code = p-start-node-code
     2622           temp_found-result-nodelist.processed = no
     2623       .
     2624       run fbrglib-get-full-name in this-procedure (
     2625             input p-start-obj-type
     2626           , input p-start-obj-code
     2627           , input p-start-node-code
     2628           , output v-start-full-name
     2629       ).
     2630       run fbrglib-get-full-name in this-procedure (
     2631             input p-start-obj-type
     2632           , input p-start-obj-code
     2633           , input p-start-node-code
     2634           , output v-start-sort-name
     2635       ).
     2636       process-nodes:
     2637       do while yes
     2638       :
     2639           find first temp_found-result-nodelist
     2640                where temp_found-result-nodelist.node-code = p-start-node-code
     2641           .
     2642           assign
     2643               temp_found-result-nodelist.processed = yes
     2644           .
     2645           for each buf_fbr-gds-grp no-lock
     2646              where buf_fbr-gds-grp.obj-type   = p-start-obj-type
     2647                and buf_fbr-gds-grp.obj-code   = p-start-obj-code
     2648                and buf_fbr-gds-grp.upper-code = p-start-node-code
     2649           on error undo, return error
     2650           :
     2651               run fbrglib-is-terminal in this-procedure (
     2652                     input buf_fbr-gds-grp.obj-type
     2653                   , input buf_fbr-gds-grp.obj-code
     2654                   , input buf_fbr-gds-grp.node-code
     2655                   , output v-is-terminal
     2656               ).
     2657               if v-is-terminal = yes
     2658               then do:
     2659                   create temp_fbrglib_found-grp.
     2660                   assign
     2661                       temp_fbrglib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     2662                                                           chr(47) + buf_fbr-gds-grp.node-name + chr(47)
     2663                       temp_fbrglib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     2664                                                           chr(2) + buf_fbr-gds-grp.node-name + chr(2)
     2665                       temp_fbrglib_found-grp.node-code   = buf_fbr-gds-grp.node-code
     2666                       temp_fbrglib_found-grp.is-terminal = yes
     2667                       temp_fbrglib_found-grp.obj-type  = p-start-obj-type
     2668                       temp_fbrglib_found-grp.obj-code  = p-start-obj-code
     2669                   .
     2670               end.
     2671               else do:
     2672                   create temp_found-result-nodelist.
     2673                   assign
     2674                       temp_found-result-nodelist.node-code = buf_fbr-gds-grp.node-code
     2675                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     2676                                                              chr(47) + buf_fbr-gds-grp.node-name + chr(47)
     2677                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     2678                                                              chr(2) + buf_fbr-gds-grp.node-name + chr(2)
     2679                       temp_found-result-nodelist.processed = no
     2680                   .
     2681                   if p-terminal-only = no
     2682                   then do:
     2683                       create temp_fbrglib_found-grp.
     2684                       assign
     2685                           temp_fbrglib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     2686                                                               chr(47) + buf_fbr-gds-grp.node-name + chr(47)
     2687                           temp_fbrglib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     2688                                                               chr(2) + buf_fbr-gds-grp.node-name + chr(2)
     2689                           temp_fbrglib_found-grp.node-code   = buf_fbr-gds-grp.node-code
     2690                           temp_fbrglib_found-grp.is-terminal = no
     2691                           temp_fbrglib_found-grp.obj-type  = p-start-obj-type
     2692                           temp_fbrglib_found-grp.obj-code  = p-start-obj-code
     2693                       .
     2694                   end.
     2695               end.
     2696           end.
     2697           find first temp_found-result-nodelist
     2698                where temp_found-result-nodelist.processed = no
     2699           no-error.
     2700           if not available temp_found-result-nodelist
     2701           then do:
     2702               leave process-nodes.
     2703           end.
     2704           else do:
     2705               assign
     2706                   p-start-node-code = temp_found-result-nodelist.node-code
     2707                   v-start-full-name = temp_found-result-nodelist.full-name
     2708                   v-start-sort-name = temp_found-result-nodelist.sort-name
     2709               .
     2710           end.
     2711       end.
     2712   end.
     2713   end procedure.
     2714   procedure fbrglib-expand-name :
     2715   do
     2716   on error undo, return error
     2717   :
     2718   define input parameter p-obj-type   as character    no-undo.
     2719   define input parameter p-obj-code   as integer      no-undo.
     2720   define input parameter p-start-name as character    no-undo.
     2721   define output parameter p-end-name  as character    no-undo.
     2722       define variable v-is-terminal     as logical           no-undo.
     2723       define buffer buf_temp_fbrglib_found-grp     for temp_fbrglib_found-grp.
     2724       run fbrglib-find-grp-by-full-name in this-procedure (
     2725             input p-obj-type
     2726           , input p-obj-code
     2727           , input p-start-name
     2728           , input no
     2729       ) no-error.
     2730       run fbrglib-get-max-substring in this-procedure (
     2731              input p-obj-type
     2732           ,  input p-obj-code
     2733           ,  input length( p-start-name )
     2734           , output p-end-name
     2735       ) no-error .
     2736       if error-status :error
     2737       then do:
     2738           assign
     2739               p-end-name = ""
     2740           .
     2741       end.
     2742       else do:
     2743           find first temp_fbrglib_found-grp
     2744                where temp_fbrglib_found-grp.full-name = p-end-name
     2745                   AND temp_fbrglib_found-grp.obj-type  = p-obj-type
     2746                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     2747                        no-error.
     2748           if available temp_fbrglib_found-grp
     2749           then do:
     2750               find first buf_temp_fbrglib_found-grp
     2751                    where buf_temp_fbrglib_found-grp.full-name begins p-end-name
     2752                      and recid( buf_temp_fbrglib_found-grp ) <> recid( temp_fbrglib_found-grp )
     2753                   AND temp_fbrglib_found-grp.obj-type  = p-obj-type
     2754                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     2755               no-error.
     2756               if not available buf_temp_fbrglib_found-grp
     2757               then do:
     2758                   run fbrglib-is-terminal in this-procedure (
     2759                         input p-obj-type
     2760                       , input p-obj-code
     2761                       , input temp_fbrglib_found-grp.node-code
     2762                       , output v-is-terminal
     2763                   ).
     2764               end.
     2765           end.
     2766       end.
     2767   end.
     2768   end procedure.
     2769   procedure fbrglib-get-max-substring :
     2770   do
     2771   on error undo, return error
     2772   :
     2773   define input parameter p-obj-type as character no-undo .
     2774   define input parameter p-obj-code as integer no-undo .
     2775   define input parameter p-min-substring-length   as integer      no-undo.
     2776   define output parameter p-substring             as character    no-undo.
     2777           define variable v-char-counter  as integer           no-undo.
     2778           define variable v-current-char  as character         no-undo.
     2779           define variable v-names-counter  as integer           no-undo.
     2780           define variable v-base-string   as character         no-undo.
     2781           assign
     2782               v-char-counter  = p-min-substring-length
     2783           .
     2784           find first temp_fbrglib_found-grp  where
     2785                      temp_fbrglib_found-grp.obj-type  = p-obj-type
     2786                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     2787           no-error.
     2788           if not available temp_fbrglib_found-grp
     2789           then do:
     2790               undo, return error "fbrglib-get-max-substring: Нет строк для вычисления общей подстроки".
     2791           end.
     2792           else do:
     2793               assign
     2794                   v-base-string = temp_fbrglib_found-grp.full-name
     2795               .
     2796               counter-block:
     2797               do while yes
     2798               on error undo, return error "fbrglib-get-max-substring: Ошибка вычисления продолжения имени группы."
     2799               :
     2800                   assign
     2801                       v-char-counter  = v-char-counter + 1
     2802                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     2803                       v-names-counter = 0
     2804                   .
     2805                   compare-block:
     2806                   for each temp_fbrglib_found-grp
     2807                   where temp_fbrglib_found-grp.obj-type  = p-obj-type
     2808                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     2809                   :
     2810                       assign
     2811                           v-names-counter = v-names-counter + 1
     2812                       .
     2813                       if v-names-counter = 1
     2814                       then do:
     2815                           next compare-block.
     2816                       end.
     2817                       if substring( temp_fbrglib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     2818                       then do:
     2819                           leave counter-block.
     2820                       end.
     2821                   end.
     2822                   if v-names-counter = 1
     2823                   then do:
     2824                       assign
     2825                           p-substring = v-base-string
     2826                       .
     2827                       return.
     2828                   end.
     2829               end.
     2830               assign
     2831                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     2832               .
     2833           end.
     2834   end.
     2835   end procedure.
     2836   procedure fbrglib-is-terminal :
     2837   do
     2838   on error undo, return error "Ошибка процедуры fbrglib-is-terminal"
     2839   :
     2840   define input parameter p-obj-type       as character    no-undo.
     2841   define input parameter p-obj-code       as integer      no-undo.
     2842   define input parameter p-node-code      as integer      no-undo.
     2843   define output parameter p-is-terminal   as logical      no-undo.
     2844       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     2845       find first buf_fbr-gds-grp no-lock
     2846            where buf_fbr-gds-grp.obj-type   = p-obj-type
     2847              and buf_fbr-gds-grp.obj-code   = p-obj-code
     2848              and buf_fbr-gds-grp.upper-code = p-node-code
     2849       no-error .
     2850       if not available buf_fbr-gds-grp
     2851       then do:
     2852           assign
     2853               p-is-terminal = yes
     2854           .
     2855       end.
     2856       else do:
     2857           assign
     2858               p-is-terminal = no
     2859           .
     2860       end.
     2861   end.
     2862   end procedure.
     2863   procedure fbrglib-have-goods :
     2864   do
     2865   on error undo, return error
     2866   :
     2867   define input parameter p-obj-type           as character    no-undo.
     2868   define input parameter p-obj-code           as integer      no-undo.
     2869   define input parameter p-node-code          as integer      no-undo.
     2870   define output parameter p-have-fbr-gds-obj  as logical      no-undo.
     2871       define buffer buf_fbr-gds-obj         for ub.fbr-gds-obj.
     2872       find first buf_fbr-gds-obj no-lock
     2873            where buf_fbr-gds-obj.obj-type     = p-obj-type
     2874              and buf_fbr-gds-obj.obj-code     = p-obj-code
     2875              and buf_fbr-gds-obj.fbr-grp-code = p-node-code
     2876       no-error .
     2877       if available buf_fbr-gds-obj
     2878       then do:
     2879           assign
     2880               p-have-fbr-gds-obj = yes
     2881           .
     2882       end.
     2883       else do:
     2884           assign
     2885               p-have-fbr-gds-obj = no
     2886           .
     2887       end.
     2888   end.
     2889   end procedure.
     2890   procedure fbrglib-find-by-substring :
     2891   do
     2892   on error undo, return error
     2893   :
     2894   define input parameter p-start-obj-type     as character    no-undo.
     2895   define input parameter p-start-obj-code     as integer      no-undo.
     2896   define input parameter p-start-code         as integer      no-undo.
     2897   define input parameter p-full-search-string as character    no-undo.
     2898   define output parameter p-found-code        as integer      no-undo.
     2899   define output parameter p-full-name         as character    no-undo.
     2900       define variable v-start-code     as integer           no-undo.
     2901       define variable v-found          as logical  init no  no-undo.
     2902       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     2903       search-grp:
     2904       for each buf_fbr-gds-grp no-lock
     2905           where buf_fbr-gds-grp.obj-type  = p-start-obj-type
     2906             and buf_fbr-gds-grp.obj-code  = p-start-obj-code
     2907             and buf_fbr-gds-grp.node-code > p-start-code
     2908       :
     2909           if index( buf_fbr-gds-grp.node-name, p-full-search-string ) <> 0
     2910           then do:
     2911               assign
     2912                   p-found-code = buf_fbr-gds-grp.node-code
     2913                   v-found      = yes
     2914               .
     2915               run fbrglib-get-full-name in this-procedure (
     2916                     input p-start-obj-type
     2917                   , input p-start-obj-code
     2918                   , input p-found-code
     2919                   , output p-full-name
     2920               ) no-error .
     2921               if error-status :error
     2922               then do:
     2923                   undo, return error "fbrglib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     2924               end.
     2925               leave search-grp.
     2926           end.
     2927       end.
     2928       if v-found = yes
     2929       then do:
     2930       end.
     2931       else do:
     2932           assign
     2933               p-full-name  = ""
     2934               p-found-code = 0
     2935           .
     2936       end.
     2937   end.
     2938   end procedure.
     2939   procedure fbrglib-analyze-grp-name :
     2940   do
     2941   on error undo, return error
     2942   :
     2943   define input parameter p-grp-name       as character            no-undo.
     2944   define input parameter p-obj-type       as character            no-undo.
     2945   define input parameter p-obj-code       as integer              no-undo.
     2946   define input parameter p-upper-code     as integer              no-undo.
     2947   define output parameter p-error-message as character init ""    no-undo.
     2948       define variable v-char-list     as character    no-undo.
     2949       define variable v-char-counter  as integer      no-undo.
     2950       define variable v-full-name     as character    no-undo.
     2951       if p-grp-name = "" then do:
     2952           assign
     2953               p-error-message = "Название группы не может быть пустым.".
     2954           .
     2955       end.
     2956       else do:
     2957           assign
     2958               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     2959           .
     2960           do v-char-counter = 1 to num-entries( v-char-list )
     2961           :
     2962               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     2963               then do:
     2964                   assign
     2965                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     2966                   .
     2967                   return.
     2968               end.
     2969           end.
     2970           run fbrglib-get-full-name in this-procedure (
     2971                 input p-obj-type
     2972               , input p-obj-code
     2973               , input p-upper-code
     2974               , output v-full-name
     2975           ) no-error .
     2976           if error-status :error
     2977           then do:
     2978               undo, return error "fbrglib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     2979           end.
     2980           if length( v-full-name ) + 1 + length( p-grp-name ) > 120
     2981           then do:
     2982               assign
     2983                   p-error-message = 'Полное название группы не может содержать более 120 символов.'
     2984               .
     2985           end.
     2986       end.
     2987   end.
     2988   end procedure.
     2989   procedure fbrglib-delete-grp :
     2990   do
     2991   on error undo, return error
     2992   :
     2993   define input parameter p-obj-type   as character    no-undo.
     2994   define input parameter p-obj-code   as integer      no-undo.
     2995   define input parameter p-node-code  as integer      no-undo.
     2996   define output parameter p-deleted   as logical      no-undo.
     2997       define variable v-have-goods    as logical        no-undo.
     2998       define variable v-yesno         as logical        no-undo.
     2999       define variable v-upper-code    as integer        no-undo.
     3000       define variable v-root-code     as integer        no-undo.
     3001       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
     3002       define buffer buf_fbr-gds-obj           for ub.fbr-gds-obj.
     3003       define buffer buf_second_fbr-gds-grp    for ub.fbr-gds-grp.
     3004       run fbrglib-get-root-code in this-procedure (
     3005           output v-root-code
     3006       ) no-error.
     3007       if error-status :error
     3008       then do:
     3009           undo, return error "Не найден корневой узел." + chr(10) + return-value.
     3010       end.
     3011       if p-node-code = v-root-code
     3012       then do:
     3013           message
     3014               "Корневую группу удалить невозможно."
     3015           view-as alert-box error.
     3016           assign
     3017               p-deleted = no
     3018           .
     3019           undo, return.
     3020       end.
     3021       find first buf_fbr-gds-grp no-lock
     3022            where buf_fbr-gds-grp.obj-type     = p-obj-type
     3023              and buf_fbr-gds-grp.obj-code     = p-obj-code
     3024              and buf_fbr-gds-grp.upper-code   = p-node-code
     3025       no-error.
     3026       if available buf_fbr-gds-grp
     3027       then do:
     3028           message
     3029               "Не терминальную группу удалить невозможно."
     3030           view-as alert-box error.
     3031           assign
     3032               p-deleted = no
     3033           .
     3034           undo, return.
     3035       end.
     3036       find first buf_fbr-gds-grp no-lock
     3037            where buf_fbr-gds-grp.obj-type     = p-obj-type
     3038              and buf_fbr-gds-grp.obj-code     = p-obj-code
     3039              and buf_fbr-gds-grp.node-code    = p-node-code
     3040       .
     3041       assign
     3042           v-upper-code = buf_fbr-gds-grp.upper-code
     3043       .
     3044       run fbrglib-have-goods in this-procedure (
     3045             input p-obj-type
     3046           , input p-obj-code
     3047           , input p-node-code
     3048           , output v-have-goods
     3049       ).
     3050       if v-have-goods = yes
     3051       then do:
     3052           find first buf_second_fbr-gds-grp no-lock
     3053                where buf_second_fbr-gds-grp.obj-type      = buf_fbr-gds-grp.obj-type
     3054                  and buf_second_fbr-gds-grp.obj-code      = buf_fbr-gds-grp.obj-code
     3055                  and buf_second_fbr-gds-grp.upper-code    = buf_fbr-gds-grp.upper-code
     3056                  and recid( buf_second_fbr-gds-grp )      <> recid( buf_fbr-gds-grp )
     3057           no-error.
     3058           if available buf_second_fbr-gds-grp
     3059           then do:
     3060               message
     3061                   "В группе есть товары,"
     3062                   skip "которые нельзя перенести в родительскую группу,"
     3063                   skip "потому что у родительской группы есть еще одна подгруппа."
     3064                   skip(1)
     3065                   skip "Перенесите товары в другую группу"
     3066                   skip "или удалите все остальные подгруппы родительской группы."
     3067               view-as alert-box error.
     3068               assign
     3069                   p-deleted = no
     3070               .
     3071               undo, return.
     3072           end.
     3073           message
     3074               "В группе есть товары."
     3075               skip "После удаления группы"
     3076               skip "все ее товары будут привязаны"
     3077               skip "к ее родительской группе."
     3078               skip(1)
     3079               skip "Удалить группу?"
     3080           view-as alert-box warning
     3081           buttons yes-no
     3082           title "Удаление группы"
     3083           update v-yesno
     3084           .
     3085           if v-yesno = yes
     3086           then do:
     3087               do transaction
     3088               on error undo, return error
     3089               :
     3090                   for each buf_fbr-gds-obj exclusive-lock
     3091                      where buf_fbr-gds-obj.obj-type     = p-obj-type
     3092                        and buf_fbr-gds-obj.obj-code     = p-obj-code
     3093                        and buf_fbr-gds-obj.fbr-grp-code = p-node-code
     3094                   on error undo, return error
     3095                   :
     3096                       assign
     3097                           buf_fbr-gds-obj.fbr-grp-code = v-upper-code
     3098                       .
     3099                   end.
     3100               end.
     3101               do transaction
     3102               on error undo, return error
     3103               :
     3104                   find current buf_fbr-gds-grp exclusive-lock .
     3105                   delete buf_fbr-gds-grp no-error .
     3106                   if error-status:error then do:
     3107                     undo, return error return-value .
     3108                   end.
     3109               end.
     3110           end.
     3111       end.
     3112       else do:
     3113           message
     3114               "Имя группы: " buf_fbr-gds-grp.node-name
     3115               "Код группы: " buf_fbr-gds-grp.node-code
     3116               skip(1)
     3117               skip "Удалить группу?"
     3118           view-as alert-box warning
     3119           buttons yes-no
     3120           title "Удаление группы"
     3121           update v-yesno
     3122           .
     3123           if v-yesno = yes
     3124           then do:
     3125               do transaction
     3126               on error undo, return error
     3127               :
     3128                   find current buf_fbr-gds-grp exclusive-lock .
     3129                   delete buf_fbr-gds-grp no-error.
     3130                   if error-status:error then do:
     3131                     undo, return error return-value .
     3132                   end.
     3133               end.
     3134           end.
     3135       end.
     3136   end.
     3137   end procedure.
     3138   procedure fbrglib-add-grp :
     3139   do
     3140   on error undo, return error
     3141   :
     3142   define input parameter p-obj-type       as character    no-undo.
     3143   define input parameter p-obj-code       as integer      no-undo.
     3144   define input parameter p-node-code      as integer      no-undo.
     3145   define input parameter p-interface      as logical      no-undo.
     3146   define input parameter p-node-name      as character    no-undo.
     3147   define input parameter p-out-code       as integer      no-undo.
     3148   define input parameter p-global-code    as integer      no-undo.
     3149   define output parameter p-new-node-code as integer      no-undo.
     3150   define output parameter p-cancel        as logical      no-undo.
     3151       define variable v-have-goods    as logical  no-undo.
     3152       define variable v-host-code     as integer        no-undo.
     3153       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     3154       define buffer bf_fbr-gds-grp        for ub.fbr-gds-grp.
     3155       define buffer buf_fbr-gds-obj       for ub.fbr-gds-obj.
     3156       run fbrglib-have-goods in this-procedure (
     3157             input p-obj-type
     3158           , input p-obj-code
     3159           , input p-node-code
     3160           , output v-have-goods
     3161       ) no-error .
     3162       if error-status :error
     3163       then do:
     3164           message
     3165                    vss-workfile vss-revision vss-description
     3166               skip "Ошибка определения наличия товаров в группе."
     3167               skip return-value
     3168               skip trim(error-status :get-message(1))
     3169                    trim(error-status :get-message(2))
     3170                    trim(error-status :get-message(3))
     3171           view-as alert-box error.
     3172           undo, return error .
     3173       end.
     3174   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3175   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3176     (input  p-obj-type
     3177     ,input  p-obj-code
     3178     ,output v-host-code
     3179     )  .
     3180       find first buf_fbr-gds-grp no-lock where
     3181                 buf_fbr-gds-grp.upper-code = p-node-code
     3182             AND buf_fbr-gds-grp.obj-type   = p-obj-type
     3183             AND buf_fbr-gds-grp.obj-code   = p-obj-code
     3184             AND buf_fbr-gds-grp.node-name  = p-node-name no-error .
     3185       if available buf_fbr-gds-grp then do:
     3186           if p-node-code <> 1 then do:
     3187             find first buf_fbr-gds-grp no-lock where
     3188                       buf_fbr-gds-grp.node-code = p-node-code
     3189                   AND buf_fbr-gds-grp.obj-type   = p-obj-type
     3190                   AND buf_fbr-gds-grp.obj-code   = p-obj-code  .
     3191           end.
     3192                   message
     3193           "Для объекта" p-obj-type p-obj-code
     3194           "уже есть группа блюд" p-node-name "в подгруппе" (if p-node-code = 1 then "БЛЮДА" else buf_Fbr-gds-grp.node-name)
     3195           view-as alert-box error .
     3196           undo, return error .
     3197       end.
     3198       do transaction
     3199       on error undo, return error
     3200       :
     3201           create buf_fbr-gds-grp.
     3202           assign
     3203               buf_fbr-gds-grp.node-code   = next-value( s-gds-grp, ub )
     3204               p-new-node-code             = buf_fbr-gds-grp.node-code
     3205               buf_fbr-gds-grp.upper-code  = p-node-code
     3206               buf_fbr-gds-grp.host-code   = v-host-code
     3207               buf_fbr-gds-grp.obj-type    = p-obj-type
     3208               buf_fbr-gds-grp.obj-code    = p-obj-code
     3209               buf_fbr-gds-grp.node-name    = ""
     3210               buf_fbr-gds-grp.out-code    = 0
     3211           .
     3212           if p-interface then do:
     3213             run ref/fbrggrpd.w (
     3214                   input parparentproc
     3215                 , input 'ИЗМЕНЕНИЕ':U
     3216                 , input p-obj-type
     3217                 , input p-obj-code
     3218                 , input buf_fbr-gds-grp.node-code
     3219                 , input buf_fbr-gds-grp.upper-code
     3220                 , input buf_fbr-gds-grp.node-name
     3221                 , input buf_fbr-gds-grp.out-code
     3222                 , output buf_fbr-gds-grp.node-name
     3223                 , output buf_fbr-gds-grp.out-code
     3224                 , output p-cancel
     3225             ).
     3226             if p-cancel = yes
     3227             then do:
     3228                 delete buf_fbr-gds-grp.
     3229                 undo, return.
     3230             end.
     3231           end.
     3232           else do:
     3233             find first bf_fbr-gds-grp no-lock
     3234                 where bf_fbr-gds-grp.obj-type   = p-obj-type
     3235                   and bf_fbr-gds-grp.obj-code   = p-obj-code
     3236                   and bf_fbr-gds-grp.out-code   = p-out-code
     3237             no-error.
     3238             assign
     3239             buf_fbr-gds-grp.node-name    = p-node-name
     3240             buf_fbr-gds-grp.global-code  = p-global-code
     3241             buf_fbr-gds-grp.out-code     = (if available bf_fbr-gds-grp then 0 else p-out-code)
     3242             .
     3243           end.
     3244           if v-have-goods = yes
     3245           then do:
     3246               for each buf_fbr-gds-obj exclusive-lock
     3247                  where buf_fbr-gds-obj.obj-type      = p-obj-type
     3248                    and buf_fbr-gds-obj.obj-code      = p-obj-code
     3249                    and buf_fbr-gds-obj.fbr-grp-code  = p-node-code
     3250               on error undo, return error
     3251               :
     3252                   assign
     3253                       buf_fbr-gds-obj.fbr-grp-code = p-new-node-code
     3254                   .
     3255               end.
     3256           end.
     3257       end.
     3258   end.
     3259   end procedure.
     3260   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3261   define variable v-session-status_ as character no-undo .
     3262   DEFINE TEMP-TABLE tt-cash-pay-r-keeper NO-UNDO LIKE ub.cash-pay
     3263          field r-keeper-cdpay-code like ub.cash-pay.cdpay-code
     3264          index pi is unique primary r-keeper-cdpay-code.
     3265   DEFINE TEMP-TABLE tt-dis-rule-r-keeper NO-UNDO LIKE ub.dis-rule
     3266          field r-keeper-rule-num like ub.dis-rule.rule-num
     3267          index pi is unique primary r-keeper-rule-num.
     3268   FUNCTION convert-cash-pay returns integer
     3269                                             ( input p-cdpay-code-r-keeper as integer
     3270                                              ,output p-curr-code as integer
     3271                                             ) :
     3272   find first tt-cash-pay-r-keeper no-lock where
     3273             tt-cash-pay-r-keeper.r-keeper-cdpay-code = p-cdpay-code-r-keeper    no-error .
     3274   if available tt-cash-pay-r-keeper then do:
     3275     assign
     3276     p-curr-code = tt-cash-pay-r-keeper.curr-code.
     3277     return tt-cash-pay-r-keeper.cdpay-code.
     3278   end.
     3279   assign
     3280   p-curr-code = 0.
     3281   return p-cdpay-code-r-keeper.
     3282   END FUNCTION.
     3283   FUNCTION get-sales-man returns integer
     3284                                             ( input p-r-keeper-sifr as integer
     3285                                              ,input p-date as date
     3286                                             ) :
     3287   define variable v-seller-code as integer no-undo .
     3288   define variable v-s-password as character no-undo .
     3289   define buffer buf_cd-clu for ub.cd-clu.
     3290   find first buf_cd-clu no-lock where
     3291             buf_cd-clu.obj-type = p-obj-type
     3292         and buf_cd-clu.obj-code = p-obj-code
     3293         and buf_cd-clu.pos-type = 'r-keeper':U
     3294         and buf_cd-clu.clu-type = 'W'
     3295         and buf_cd-clu.clu-code = p-r-keeper-sifr no-error .
     3296   if not available buf_cd-clu then do :
     3297     find first buf_cd-clu no-lock where
     3298               buf_cd-clu.obj-type = p-obj-type
     3299           and buf_cd-clu.obj-code = p-obj-code
     3300           and buf_cd-clu.pos-type = 'r-keeper':U
     3301           and buf_cd-clu.clu-type = 'M'
     3302           and buf_cd-clu.clu-code = p-r-keeper-sifr no-error .
     3303   end.
     3304   if available buf_cd-clu and
     3305               buf_cd-clu.cli-code <> ?
     3306           and buf_cd-clu.cli-code <> 0 then do:
     3307     assign
     3308     v-seller-code = gbclcode-get-db-role (  input 'S':U
     3309                                            ,input g#db-num
     3310                                            ,input buf_cd-clu.cli-code
     3311                                            ,input p-date
     3312                                            ,output v-s-password ) no-error .
     3313     if error-status:error
     3314     then do:
     3315        return ?.
     3316     end.
     3317     if buf_cd-clu.clu-type = 'M' and ( v-seller-code = ? or v-seller-code = 0 ) then do :
     3318        v-seller-code = gbclcode-get-db-role (  input 'C':U
     3319                                               ,input g#db-num
     3320                                               ,input buf_cd-clu.cli-code
     3321                                               ,input p-date
     3322                                               ,output v-s-password ) no-error .
     3323        if error-status:error
     3324        then do:
     3325          return ?.
     3326        end.
     3327     end.
     3328     return v-seller-code.
     3329   end.
     3330   return 0.
     3331   END FUNCTION.
     3332   FUNCTION get-cashier returns integer
