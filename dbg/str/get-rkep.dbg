     3873         end.
     3874       END CASE.
     3875       assign
     3876       var-file-line-num = var-file-line-num + 1
     3877       .
     3878       if var-file-line-num modulo 100 = 0 then do:
     3879         run show-counter in p-log-handle .
     3880         run write-counter in p-log-handle (substitute("Файл &1: прочитано строк &2", filename, var-file-line-num)).
     3881       end.
     3882     END.
     3883   END.
     3884   session:date-format = "dmy":U.
     3885   error-status:error = false.
     3886   input stream ChkStream close.
     3887   END PROCEDURE.
     3888   PROCEDURE get-r-keeper-parameters:
     3889   define variable v-cash-pay-list AS CHARACTER NO-UNDO.
     3890   DEFINE VARIABLE v-cdpay-code-r-keeper LIKE ub.cash-pay.cdpay-code NO-UNDO.
     3891   define variable v-dis-rule-list AS CHARACTER NO-UNDO.
     3892   DEFINE VARIABLE v-rule-num-r-keeper LIKE ub.dis-rule.rule-num NO-UNDO.
     3893   define variable ii as integer no-undo .
     3894   define variable v-entry as character no-undo .
     3895   DEFINE VARIABLE v-cdpay-code LIKE ub.cash-pay.cdpay-code NO-UNDO.
     3896   DEFINE VARIABLE v-curr-code LIKE ub.cash-pay.curr-code NO-UNDO.
     3897   DEFINE VARIABLE v-rule-num LIKE ub.dis-rule.rule-num NO-UNDO.
     3898   define variable v-param-type as character no-undo .
     3899   define variable v-value-character as character no-undo .
     3900   define variable v-value-date as date no-undo .
     3901   define variable v-value-decimal as decimal no-undo .
     3902   define variable v-value-integer as INTEGER no-undo .
     3903   define variable v-value-logical AS LOGICAL no-undo .
     3904   define variable v-tth as handle no-undo .
     3905   assign
     3906   v-tth = buffer thbjattr_thbj-attr:table-handle .
     3907   define buffer buf_cash-pay for ub.cash-pay.
     3908   define buffer buf_dis-rule for ub.dis-rule.
     3909   if get-chkc_context.shift-on and not get-chkc_context.cas-shft then do:
     3910     run write-log-and-file in p-log-handle (
     3911           input 1
     3912         , input log-file-name
     3913         , input 1
     3914         , input substitute("!!!Внимание! На объекте &1&2 требуется использование смен, а настройка СМЕНЫ НА КАССЕ выключена - это недопустимо."
     3915                            , get-chkc_context.obj-type
     3916                            , get-chkc_context.obj-code
     3917                             )).
     3918     assign
     3919     p-view-log = yes
     3920     .
     3921     undo, return .
     3922   end.
     3923   if get-chkc_context.t-shft > 0 and get-chkc_context.shift-on = yes then do:
     3924     run write-log-and-file in p-log-handle (
     3925           input 1
     3926         , input log-file-name
     3927         , input 1
     3928         , input substitute("!!!Внимание! На объекте &1&2 требуется использование смен,&3" +
     3929                             "а настройка СМЕЩЕННЫЕ СМЕНЫ НА КАССЕ&3" +
     3930                             "(АРМ Администратор - Справочники - Магазины - Параметры - время начала пересменки)&3" +
     3931                             "включена - это недопустимо."
     3932                            , get-chkc_context.obj-type
     3933                            , get-chkc_context.obj-code
     3934                            , chr(10)
     3935                             )).
     3936     assign
     3937     p-view-log = yes
     3938     .
     3939     undo, return .
     3940   end.
     3941   for each thbjattr_thbj-attr:
     3942     delete thbjattr_thbj-attr.
     3943   end.
     3944   run adm/shattri.p (
     3945       input "get":U
     3946       ,input  p-obj-type
     3947       ,input  p-obj-code
     3948       ,input  'cd-type-r-keeper':U
     3949       ,input  '':U
     3950       ,output v-value-character
     3951       ,output v-value-date
     3952       ,output v-value-decimal
     3953       ,output v-value-integer
     3954       ,output v-value-logical
     3955       ,output v-param-type
     3956       ,INPUT-OUTPUT table-handle v-tth
     3957       ) no-error .
     3958   IF error-status:error then do:
     3959     run write-log-and-file in p-log-handle (
     3960           input 1
     3961         , input log-file-name
     3962         , input 1
     3963         , input  substitute(
     3964                           "Не удалось получить настройки для  POS типа &1 для маг&2"
     3965                           , 'r-keeper':U
     3966                           , p-obj-code)
     3967                                           ).
     3968       assign
     3969       p-view-log = yes
     3970       .
     3971       undo, return .
     3972   end.
     3973   for each thbjattr_thbj-attr where
     3974           thbjattr_thbj-attr.obj-type = p-obj-type
     3975       and thbjattr_thbj-attr.obj-code = p-obj-code
     3976       and thbjattr_thbj-attr.upper-prop-code =  'cd-type-r-keeper':U
     3977   on error undo, return error :
     3978     case thbjattr_thbj-attr.prop-code :
     3979       when 'cash-pay-list':U then do:
     3980         assign
     3981         v-cash-pay-list = thbjattr_thbj-attr.property-value-character.
     3982       end.
     3983       when 'dis-rule-list':U then do:
     3984         assign
     3985         v-dis-rule-list = thbjattr_thbj-attr.property-value-character.
     3986       end.
     3987     end case.
     3988   end.
     3989   if v-cash-pay-list <> "":U then do:
     3990   _ii:
     3991   DO ii = 1 TO  NUM-ENTRIES(v-cash-pay-list, ";"):
     3992      ASSIGN
     3993      v-entry = entry(ii, v-cash-pay-list, ";":U)
     3994      v-cdpay-code-r-keeper = integer(entry(1, entry(1, v-entry, chr(47)), chr(44)))
     3995      v-cdpay-code = integer(entry(1, entry(2, v-entry, chr(47)), chr(44)))
     3996      v-curr-code = integer(entry(2, entry(2, v-entry, chr(47)), chr(44)))
     3997      .
     3998      FIND FIRST buf_cash-pay NO-LOCK WHERE
     3999                   buf_cash-pay.cdpay-code = v-cdpay-code
     4000           AND buf_cash-pay.curr-code = v-curr-code  NO-ERROR.
     4001      IF NOT AVAILABLE buf_cash-pay THEN NEXT _ii.
     4002       CREATE tt-cash-pay-r-keeper.
     4003       BUFFER-COPY buf_cash-pay TO tt-cash-pay-r-keeper
     4004       ASSIGN
     4005       tt-cash-pay-r-keeper.r-keeper-cdpay-code = v-cdpay-code-r-keeper
     4006       .
     4007   END.
     4008   end.
     4009   if v-dis-rule-list <> "":U then do:
     4010     _ii:
     4011     DO ii = 1 TO  NUM-ENTRIES(v-dis-rule-list, ";"):
     4012       ASSIGN
     4013       v-entry = entry(ii, v-dis-rule-list, ";":U)
     4014       v-rule-num-r-keeper = integer(entry(1, entry(1, v-entry, chr(47)), chr(44)))
     4015       v-rule-num = integer(entry(1, entry(2, v-entry, chr(47)), chr(44)))
     4016       .
     4017       FIND FIRST buf_dis-rule NO-LOCK WHERE
     4018                   buf_dis-rule.rule-num = v-rule-num  NO-ERROR.
     4019       IF NOT AVAILABLE buf_dis-rule THEN NEXT _ii.
     4020       CREATE tt-dis-rule-r-keeper.
     4021       BUFFER-COPY buf_dis-rule TO tt-dis-rule-r-keeper
     4022       ASSIGN
     4023       tt-dis-rule-r-keeper.r-keeper-rule-num = v-rule-num-r-keeper
     4024       .
     4025     END.
     4026   end.
     4027   END PROCEDURE.
     4028   procedure check-records-num :
     4029   define variable v-return-value as character no-undo .
     4030   define buffer buf_temp-control for temp-control.
     4031     do
     4032     on error undo, return error return-value
     4033     :
     4034       for each temp-control no-lock:
     4035         if  temp-control.file_ begins chr(4) then NEXT.
     4036         if LOOKUP(temp-control.file, "control,menu,modify,money,personal,reasons,charges,acheck,adcheck,apcheck,archeck,avcheck":U) = 0  then NEXT.
     4037         if p-file-num < 0 and LOOKUP(temp-control.file, "control,menu,reasons,acheck,adcheck,apcheck,archeck,avcheck":U) = 0   then NEXT.
     4038         find first buf_temp-control no-lock where
     4039                   buf_temp-control.file_ begins (chr(4) + temp-control.file_) no-error .
     4040         if (not available buf_temp-control and temp-control.records <> 0)
     4041         or (available buf_temp-control and temp-control.records <> buf_temp-control.records)
     4042         then do:
     4043           assign
     4044           v-return-value = v-return-value + chr(10) +
     4045                            substitute("Файл &1: ожидалось &2 записей - получено &3"
     4046                                       , temp-control.file_
     4047                                       , temp-control.records
     4048                                       , (if available buf_temp-control then buf_temp-control.records else 0)
     4049                                       ).
     4050         end.
     4051       end.
     4052       if v-return-value <> "":u then do:
     4053         return error v-return-value.
     4054       end.
     4055     end.
     4056   end procedure.
     4057   procedure save-r-keeper-data :
     4058   define buffer buf_cd-doc for ub.cd-doc.
     4059     do
     4060     on error undo, return error return-value
     4061     :
     4062         run save-goods in this-procedure no-error .
     4063         if error-status:error then do:
     4064           return error return-value .
     4065         end.
     4066         run save-modifiers in this-procedure no-error .
     4067         if error-status:error then do:
     4068           return error return-value .
     4069         end.
     4070         run save-clients in this-procedure no-error .
     4071         if error-status:error then do:
     4072           return error return-value .
     4073         end.
     4074       find first buf_cd-doc exclusive-lock where
     4075               buf_cd-doc.obj-type = p-obj-type
     4076           and buf_cd-doc.obj-code = p-obj-code
     4077           and buf_cd-doc.pos-type = 'r-keeper':U
     4078           and buf_cd-doc.doc-type = '':U
     4079           and buf_cd-doc.doc-code = string((abs(p-file-num))) no-wait no-error.
     4080       if not available buf_cd-doc then do:
     4081         return error substitute("!!!Не найдена запись сессии чтения чеков с касс R-KEEPER для маг&1", p-obj-code).
     4082       end.
     4083       assign
     4084       buf_cd-doc.to-send = yes
     4085       buf_cd-doc.charkey_one = '':U
     4086       .
     4087       run get-checks in this-procedure no-error .
     4088       assign
     4089       buf_cd-doc.charkey_one = v-session-status_
     4090       buf_cd-doc.to-send = (v-session-status_ = 'U')
     4091       .
     4092       if error-status:error then do:
     4093          return error return-value .
     4094       end.
     4095     end.
     4096   end procedure.
     4097   procedure save-goods :
     4098   define variable v-mode as character no-undo .
     4099   define variable v-update-price as logical no-undo .
     4100   define variable v-update-name as logical no-undo .
     4101   define variable v-update-group as logical no-undo .
     4102   define variable v-update-modificator as logical no-undo .
     4103   define variable v-update-parent as logical no-undo .
     4104   define variable v-deleted    as logical   no-undo .
     4105   define variable v-price      as decimal  no-undo .
     4106   define variable v-price-sale as decimal no-undo .
     4107   define variable v-doc-num    as character no-undo .
     4108   define variable v-gds-name   as character no-undo .
     4109   define variable v-grp-code   as integer no-undo .
     4110   define variable v-grp-name   as character no-undo .
     4111   define variable v-modif      as logical no-undo .
     4112   define variable v-null-price as logical no-undo .
     4113   define variable v-parent     as integer no-undo .
     4114   define variable v-dop-code-int as integer no-undo .
     4115   define variable v-lvl-num as integer no-undo .
     4116   define variable v-upper-num as integer no-undo .
     4117   define buffer buf_cd-plu for ub.cd-plu.
     4118   define buffer buf_cd-grp for ub.cd-grp.
     4119   define buffer buf_cd-doc-line for ub.cd-doc-line.
     4120   define buffer ucs_cd-grp for ub.cd-grp.
     4121   define buffer buf_fbr-gds-grp for ub.fbr-gds-grp.
     4122   define buffer buf_gds-obj-attr for ub.gds-obj-attr.
     4123   define buffer buf_clients for ub.clients.
     4124   define buffer buf_goods for ub.goods.
     4125   define buffer upper_temp-menu for temp-menu.
     4126     _main:
     4127     do
     4128     on error undo, return error return-value
     4129     :
     4130       _temp-menu:
     4131       for each temp-menu:
     4132         run show-counter in p-log-handle .
     4133         run write-counter in p-log-handle (substitute("Сохранение полученных данных: обработано записей &1", ll-loc)).
     4134         assign
     4135         v-dop-code-int = integer(temp-menu.code-chr)
     4136         no-error
     4137         .
     4138         if error-status:error then do:
     4139           run write-log-and-file in p-log-handle (
     4140                   input 1
     4141                 , input log-file-name
     4142                 , input 1
     4143                 , input substitute( "!!!Ошибка при обработке записи блюда с id &1 код меню &2 &3:&4&5 &6"
     4144                                     , temp-menu.sifr
     4145                                     , temp-menu.code-chr
     4146                                     , temp-menu.name
     4147                                     , chr(10)
     4148                                     , error-status:get-message(1)
     4149                                     , return-value
     4150                                   )
     4151                                                   ).
     4152         end.
     4153         assign
     4154         v-mode = "":U
     4155         v-update-name = no
     4156         v-update-price = no
     4157         v-update-group = no
     4158         v-update-modificator = no
     4159         v-price-sale = ?
     4160         v-gds-name  = "":U
     4161         v-grp-code  = 0
     4162         v-modif = no
     4163         v-null-price = no
     4164         .
     4165         if temp-menu.treetype = "F":U
     4166         or temp-menu.treetype = "L":U then do:
     4167           find first buf_cd-plu where
     4168                     buf_cd-plu.obj-type = p-obj-type
     4169                and  buf_cd-plu.obj-code = p-obj-code
     4170                and buf_cd-plu.pos-type = 'r-keeper':U
     4171                and buf_cd-plu.plu-type = '':U
     4172                and buf_cd-plu.plu-code = temp-menu.sifr no-error.
     4173           if not available buf_cd-plu then do:
     4174             assign
     4175             v-mode = 'ДОБАВЛЕНИЕ':U.
     4176           end.
     4177           else do:
     4178             find last buf_cd-doc-line where
     4179                      buf_cd-doc-line.obj-type = p-obj-type
     4180                  and buf_cd-doc-line.obj-code = p-obj-code
     4181                  and buf_cd-doc-line.pos-type = 'r-keeper':U
     4182                  and buf_cd-doc-line.doc-type = 'переоценка':U
     4183                  and buf_cd-doc-line.doc-code < string(p-file-num)
     4184                  AND buf_cd-doc-line.plu-type = '':U
     4185                  AND buf_cd-doc-line.plu-code = temp-menu.sifr no-error .
     4186             if not available buf_cd-doc-line then do:
     4187               assign
     4188               v-price = ?
     4189               v-update-price = yes
     4190               v-update-name =  yes
     4191               v-update-group = yes
     4192               v-update-modificator = yes
     4193               .
     4194             end.
     4195             else do:
     4196               assign
     4197               v-price = buf_cd-doc-line.deckey_one
     4198               .
     4199             end.
     4200             if buf_cd-plu.b-code <> 0 then do:
     4201               assign
     4202               v-price-sale = get-rkgTH-price(shop-type, shop-code, buf_cd-plu.b-code, output v-doc-num)
     4203               v-gds-name   = get-rkgTH-name(shop-type, shop-code, buf_cd-plu.b-code, buffer buf_goods)
     4204               v-grp-code   = get-rkgTH-group(shop-type, shop-code, buf_cd-plu.b-code
     4205                             , output v-grp-name)
     4206               v-modif      = get-rkgTH-modificator(shop-type, shop-code, buf_cd-plu.b-code, output v-null-price)
     4207               .
     4208               assign
     4209               v-update-price = (temp-menu.price <> v-price-sale) or v-price-sale = ?
     4210               v-update-name =  (temp-menu.name <> v-gds-name)
     4211               v-update-group  =  (temp-menu.parent <> v-grp-code)
     4212               v-update-modificator =  ((temp-menu.price = 0 and not v-null-price)
     4213                                        or
     4214                                      (temp-menu.price <> 0 and v-null-price))
     4215               .
     4216             end.
     4217             if (buf_cd-plu.key#_two <> temp-menu.parent)
     4218             or (buf_cd-plu.charkey_one <> temp-menu.name)
     4219             or v-update-name
     4220             or (buf_cd-plu.to-del <>  (not temp-menu.del))
     4221             or (buf_cd-plu.to-send <> temp-menu.del)
     4222             or (buf_cd-plu.b-code > 0 and (v-price = ? or (temp-menu.price <> v-price) or v-update-price or v-price-sale = ? ))
     4223             or (buf_cd-plu.key#_one <> v-dop-code-int)
     4224             or v-update-group
     4225             or v-update-modificator
     4226             then do:
     4227               assign
     4228               v-mode = 'ИЗМЕНЕНИЕ':U
     4229               .
     4230             end.
     4231           end.
     4232           if v-mode <> "":U then do:
     4233             run update-product in this-procedure (
     4234                                                      input v-mode
     4235                                                     ,input v-update-name
     4236                                                     ,input v-update-price
     4237                                                     ,input v-update-group
     4238                                                     ,input v-update-modificator
     4239                                                     ,input temp-menu.sifr
     4240                                                     ,input temp-menu.code-chr
     4241                                                     ,input temp-menu.name
     4242                                                     ,input temp-menu.treetype
     4243                                                     ,input temp-menu.price
     4244                                                     ,input temp-menu.parent
     4245                                                     ,input temp-menu.del
     4246                                                     )
     4247             no-error .
     4248             if error-status:error then do:
     4249               run write-log-and-file in p-log-handle (
     4250                       input 1
     4251                     , input log-file-name
     4252                     , input 1
     4253                     , input substitute( "!!!Ошибка при сохранении записи блюда меню с id &1 код меню &2 &3:&4&5 &6"
     4254                                         , temp-menu.sifr
     4255                                         , temp-menu.code-chr
     4256                                         , temp-menu.name
     4257                                         , chr(10)
     4258                                         , error-status:get-message(1)
     4259                                         , return-value
     4260                                       )
     4261                                                       ).
     4262               assign
     4263               p-view-log = yes
     4264               .
     4265               undo _temp-menu, next _temp-menu.
     4266             end.
     4267           end.
     4268         end.
     4269         if temp-menu.treetype = "T":U then do:
     4270           assign
     4271           v-update-name = no
     4272           v-update-parent = no
     4273           v-grp-name = "":U
     4274           v-parent = 0
     4275           .
     4276           if temp-menu.parent = 0 then v-lvl-num = 0.
     4277           else do:
     4278             assign
     4279             v-upper-num = temp-menu.parent
     4280             .
     4281             v-lvl-num = - 1.
     4282             do while available  upper_temp-menu or v-lvl-num = - 1:
     4283               find first upper_temp-menu no-lock where
     4284                         upper_temp-menu.sifr = v-upper-num
     4285                           no-error.
     4286               assign
     4287               v-lvl-num = (if v-lvl-num = - 1 then 0 else v-lvl-num )
     4288               v-lvl-num = (if available upper_temp-menu then v-lvl-num + 1 else v-lvl-num)
     4289               v-upper-num = (if available upper_temp-menu then upper_temp-menu.parent else v-upper-num)
     4290               .
     4291             end.
     4292             if v-lvl-num = 0 then do:
     4293               run write-log-and-file in p-log-handle (
     4294                       input 1
     4295                     , input log-file-name
     4296                     , input 1
     4297                     , input substitute( "!!!Ошибка при сохранении записи группы блюд меню с id &1 &2:&3не удалось определить уровень грппы"
     4298                                         , temp-menu.sifr
     4299                                         , temp-menu.name
     4300                                         , chr(10)
     4301                                       )
     4302                                                       ).
     4303               assign
     4304               p-view-log = yes
     4305               .
     4306               undo _temp-menu, next _temp-menu.
     4307             end.
     4308             assign
     4309             temp-menu.lvl-num = v-lvl-num.
     4310           end.
     4311           find first buf_cd-grp no-lock where
     4312                    buf_cd-grp.obj-type = p-obj-type
     4313               and buf_cd-grp.obj-code = p-obj-code
     4314               and buf_cd-grp.pos-type = 'r-keeper':U
     4315               and buf_cd-grp.grp-type = '':U
     4316               and buf_cd-grp.grp-code = temp-menu.sifr no-error .
     4317           if not available buf_cd-grp then do:
     4318             assign
     4319             v-mode = 'ДОБАВЛЕНИЕ':U
     4320             v-update-name =  yes
     4321             v-update-parent = yes
     4322             .
     4323           end.
     4324           else do:
     4325             assign
     4326             v-grp-name   = get-rkgTH-group-name(shop-type, shop-code, temp-menu.sifr)
     4327             v-parent    = get-rkgTH-parent(shop-type, shop-code, temp-menu.sifr)
     4328             .
     4329             assign
     4330             v-update-name =  v-grp-name = ? or v-grp-name <> temp-menu.name
     4331             v-update-parent = v-parent = ? or v-parent <> temp-menu.parent
     4332             .
     4333             if buf_cd-grp.grp-name <> temp-menu.name
     4334             OR buf_cd-grp.upper-grp-code <> temp-menu.parent
     4335             or buf_cd-grp.key#_one <> temp-menu.lvl-num
     4336             or v-update-name
     4337             or v-update-parent
     4338             then do:
     4339               assign
     4340               v-mode = 'ИЗМЕНЕНИЕ':U
     4341               .
     4342             end.
     4343           end.
     4344           if v-mode <> "":U then do:
     4345             run update-country in this-procedure (
     4346                                                      input v-mode
     4347                                                     ,input v-update-name
     4348                                                     ,input v-update-parent
     4349                                                     ,input temp-menu.sifr
     4350                                                     ,input temp-menu.name
     4351                                                     ,input temp-menu.parent
     4352                                                     ,input temp-menu.del
     4353                                                     ,input temp-menu.lvl-num
     4354                                                     )
     4355             no-error .
     4356             if error-status:error then do:
     4357               run write-log-and-file in p-log-handle (
     4358                       input 1
     4359                     , input log-file-name
     4360                     , input 1
     4361                     , input substitute( "!!!Ошибка при обработке сохранении записи группы меню с id &1 &2:&3&4 &5"
     4362                                         , temp-menu.sifr
     4363                                         , temp-menu.name
     4364                                         , chr(10)
     4365                                         , error-status:get-message(1)
     4366                                         , return-value
     4367                                       )
     4368                                                       ).
     4369               assign
     4370               p-view-log = yes
     4371               .
     4372               undo _temp-menu, next _temp-menu.
     4373             end.
     4374           end.
     4375         end.
     4376       end.
     4377       for each buf_cd-plu :
     4378         if buf_cd-plu.charkey_two= "M" then next.
     4379         if not can-find(first temp-menu no-lock where
     4380                              temp-menu.sifr = buf_cd-plu.plu-code
     4381                          AND (temp-menu.treetype = "F":U or
     4382                               temp-menu.treetype = "L":U )) then do:
     4383           delete buf_cd-plu .
     4384         end.
     4385       end.
     4386       for each buf_cd-grp where
     4387               buf_cd-grp.obj-type = p-obj-type
     4388           and buf_cd-grp.obj-code = p-obj-code
     4389           and buf_cd-grp.pos-type = 'r-keeper':U
     4390           and buf_cd-grp.grp-type = '':U  :
     4391         if not can-find(first temp-menu no-lock where
     4392                              temp-menu.sifr = buf_cd-grp.grp-code
     4393                          AND temp-menu.treetype = "T":U)  then do:
     4394           for each buf_fbr-gds-grp where
     4395                   buf_fbr-gds-grp.obj-type = p-obj-type
     4396               AND buf_fbr-gds-grp.obj-code = p-obj-code
     4397               and buf_fbr-gds-grp.out-code = buf_cd-grp.grp-code
     4398           on error undo _main, return error return-value :
     4399             assign
     4400             buf_fbr-gds-grp.out-code = 0
     4401             .
     4402           end.
     4403           delete buf_cd-grp .
     4404         end.
     4405       end.
     4406     end.
     4407   end procedure.
     4408   procedure save-modifiers :
     4409   define variable v-mode as character no-undo .
     4410   define variable v-update-name as logical no-undo .
     4411   define variable v-update-modificator as logical no-undo .
     4412   define variable v-deleted    as logical   no-undo .
     4413   define variable v-price      as decimal  no-undo .
     4414   define variable v-price-sale as decimal   no-undo .
     4415   define variable v-gds-name   as character no-undo .
     4416   define variable v-doc-num    as character no-undo .
     4417   define variable v-modif      as logical no-undo .
     4418   define variable v-null-price as logical no-undo .
     4419   define buffer buf_cd-plu for ub.cd-plu.
     4420   define buffer buf_cd-doc-line for ub.cd-plu.
     4421   define buffer buf_goods for ub.goods.
     4422     _main:
     4423     do
     4424     on error undo, return error return-value
     4425     :
     4426       _temp-modify:
     4427       for each temp-modify no-lock:
     4428         if temp-modify.parent = 0 then next _temp-modify.
     4429         run show-counter in p-log-handle .
     4430         run write-counter in p-log-handle (substitute("Сохранение полученных данных: обработано записей &1", ll-loc)).
     4431         assign
     4432         v-mode = "":U.
     4433         find first buf_cd-plu where
     4434                   buf_cd-plu.obj-type = p-obj-type
     4435               and buf_cd-plu.obj-code = p-obj-code
     4436               and buf_cd-plu.pos-type = 'r-keeper':U
     4437               and buf_cd-plu.plu-type = 'modifier':U
     4438               and buf_cd-plu.plu-code = temp-modify.sifr no-error.
     4439         if not available buf_cd-plu then do:
     4440           assign
     4441           v-mode = 'ДОБАВЛЕНИЕ':U
     4442           v-update-name = no
     4443           v-update-modificator = no
     4444           .
     4445         end.
     4446         else do:
     4447           if buf_cd-plu.b-code <> 0 then do:
     4448             assign
     4449             v-gds-name   = get-rkgTH-name(shop-type, shop-code, buf_cd-plu.b-code, buffer buf_goods)
     4450             v-modif      = get-rkgTH-modificator(shop-type, shop-code, buf_cd-plu.b-code, output v-null-price)
     4451             .
     4452             assign
     4453             v-update-name =  (temp-modify.name <> v-gds-name)
     4454             v-update-modificator  =  ( not v-modif OR not v-null-price)
     4455             .
     4456           end.
     4457           if (buf_cd-plu.charkey_one <> temp-modify.name)
     4458           or (buf_cd-plu.to-send <>  temp-modify.del)
     4459           or (buf_cd-plu.to-del <>  (not temp-modify.del))
     4460           or v-update-name
     4461           or v-update-modificator
     4462           then do:
     4463             assign
     4464             v-mode = 'ИЗМЕНЕНИЕ':U
     4465             .
     4466           end.
     4467         end.
     4468         if v-mode <> "":U then do:
     4469           run update-product in this-procedure (
     4470                                                    input v-mode
     4471                                                   ,input v-update-name
     4472                                                   ,input no
     4473                                                   ,input no
     4474                                                   ,input v-update-modificator
     4475                                                   ,input - temp-modify.sifr
     4476                                                   ,input 0
     4477                                                   ,input temp-modify.name
     4478                                                   ,input "M":U
     4479                                                   ,input temp-modify.realprice
     4480                                                   ,input 0
     4481                                                   ,input temp-modify.del
     4482                                                   )
     4483           no-error .
     4484           if error-status:error then do:
     4485             run write-log-and-file in p-log-handle (
     4486                     input 1
     4487                   , input log-file-name
     4488                   , input 1
     4489                   , input substitute( "!!!Ошибка при сохранении записи модификатора с id&1 &2:&3&4 &5"
     4490                                       , temp-modify.sifr
     4491                                       , temp-modify.name
     4492                                       , chr(10)
     4493                                       , error-status:get-message(1)
     4494                                       , return-value
     4495                                     )
     4496                                                     ).
     4497             assign
     4498             p-view-log = yes
     4499             .
     4500             undo _temp-modify, next _temp-modify.
     4501           end.
     4502         end.
     4503       end.
     4504       for each buf_cd-plu :
     4505         if not buf_cd-plu.charkey_two= "M":U then next.
     4506         if not can-find(first temp-modify no-lock where
     4507                              temp-modify.sifr = buf_cd-plu.plu-code
     4508                                                      ) then do:
     4509           delete buf_cd-plu .
     4510         end.
     4511       end.
     4512     end.
     4513   end procedure.
     4514   procedure save-clients :
     4515   define variable v-mode as character no-undo .
     4516   define variable v-deleted    as logical   no-undo .
     4517   define buffer buf_cd-clu for ub.cd-clu.
     4518     _main:
     4519     do
     4520     on error undo, return error return-value
     4521     :
     4522       _temp-personal:
     4523       for each temp-personal no-lock:
     4524         run show-counter in p-log-handle .
     4525         run write-counter in p-log-handle (substitute("Сохранение полученных данных: обработано записей &1", ll-loc)).
     4526         assign
     4527         v-mode = "":U.
     4528           find first buf_cd-clu no-lock where
     4529                     buf_cd-clu.obj-type = p-obj-type
     4530                 and buf_cd-clu.obj-code = p-obj-code
     4531                 and buf_cd-clu.pos-type = 'r-keeper':U
     4532                 and buf_cd-clu.clu-type = temp-personal.type
     4533                 and buf_cd-clu.clu-code = temp-personal.sifr no-error.
     4534         if not available buf_cd-clu then do:
     4535           assign
     4536           v-mode = 'ДОБАВЛЕНИЕ':U.
     4537         end.
     4538         else do:
     4539           if (buf_cd-clu.charkey_one <> temp-personal.name)
     4540           or buf_cd-clu.to-send <>  temp-personal.del
     4541           or buf_cd-clu.to-del <>  (not temp-personal.del)
     4542           then do:
     4543             assign
     4544             v-mode = 'ИЗМЕНЕНИЕ':U.
     4545           end.
     4546         end.
     4547         if v-mode <> "":U then do:
     4548           run update-clients in this-procedure (
     4549                                                    input v-mode
     4550                                                   ,input temp-personal.sifr
     4551                                                   ,input temp-personal.name
     4552                                                   ,input temp-personal.type
     4553                                                   ,input temp-personal.del
     4554                                                   )
     4555           no-error .
     4556           if error-status:error then do:
     4557             run write-log-and-file in p-log-handle (
     4558                     input 1
     4559                   , input log-file-name
     4560                   , input 1
     4561                   , input substitute( "!!!Ошибка при сохранении записи персонала с id &1 &2:&3&4 &5"
     4562                                       , temp-personal.sifr
     4563                                       , temp-personal.name
     4564                                       , chr(10)
     4565                                       , error-status:get-message(1)
     4566                                       , return-value
     4567                                     )
     4568                                                     ).
     4569             assign
     4570             p-view-log = yes
     4571             .
     4572             undo _temp-personal, next _temp-personal.
     4573           end.
     4574         end.
     4575       end.
     4576       for each buf_cd-clu :
     4577         if not can-find(first temp-personal no-lock where
     4578                              temp-personal.sifr = buf_cd-clu.clu-code) then do:
     4579           delete buf_cd-clu .
     4580         end.
     4581       end.
     4582     end.
     4583   end procedure.
     4584   procedure update-product :
     4585   define input parameter p-mode     as character no-undo .
     4586   define input parameter p-update-name as logical no-undo .
     4587   define input parameter p-update-price as logical no-undo .
     4588   define input parameter p-update-group as logical no-undo .
     4589   define input parameter p-update-modificator as logical no-undo .
     4590   define input parameter p-sifr     as integer no-undo .
     4591   define input parameter p-code-chr as character no-undo .
     4592   define input parameter p-name     as character no-undo .
     4593   define input parameter p-treetype as character no-undo .
     4594   define input parameter p-price    as decimal no-undo .
     4595   define input parameter p-parent   as integer no-undo .
     4596   define input parameter p-del      as logical no-undo .
     4597   define variable v-old-treetype as character no-undo .
     4598   define variable v-old-parent   as character no-undo .
     4599   DEFINE VARIABLE v-today as date no-undo .
     4600   DEFINE VARIABLE v-time as integer no-undo .
     4601   define variable v-b-code     as integer   no-undo .
     4602   define variable v-doc-num    as character no-undo .
     4603   define variable v-price-sale as decimal   no-undo .
     4604   define variable v-road-tax   as decimal   no-undo .
     4605   define variable v-excise     as decimal   no-undo .
     4606   define variable v-vat-pc     as decimal   no-undo .
     4607   define variable v-slt-pc     as decimal   no-undo .
     4608   define variable v-line-num as integer no-undo .
     4609   define buffer buf_cd-plu for ub.cd-plu.
     4610   define buffer buf_cd-doc-line for ub.cd-doc-line.
     4611   define buffer buf_cd-doc for ub.cd-doc.
     4612   define buffer buf_goods for ub.goods.
     4613   define buffer buf_cd-grp        for ub.cd-grp.
     4614     _main:
     4615     do
     4616     on error undo, return error return-value
     4617     :
     4618       if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     4619         create buf_cd-plu.
     4620         assign
     4621         buf_cd-plu.obj-type    = p-obj-type
     4622         buf_cd-plu.obj-code    = p-obj-code
     4623         buf_cd-plu.pos-type    = 'r-keeper':U
     4624         buf_cd-plu.plu-type    = (if p-sifr > 0 then '':U else 'modifier')
     4625         buf_cd-plu.plu-code    = abs(p-sifr)
     4626         .
     4627       end.
     4628       else do:
     4629         find first buf_cd-plu exclusive-lock where
     4630                 buf_cd-plu.obj-type    = p-obj-type
     4631             and buf_cd-plu.obj-code    = p-obj-code
     4632             and buf_cd-plu.pos-type    = 'r-keeper':U
     4633             and buf_cd-plu.plu-type    = (if p-sifr > 0 then '':U else 'modifier')
     4634             and buf_cd-plu.plu-code = abs(p-sifr) no-error.
     4635         if not available buf_cd-plu then do:
     4636           return error substitute("не найдена или занята запись товара/группы для кассы R-KEEPER с id = &1"
     4637                                 ,p-sifr).
     4638         end.
     4639       end.
     4640       run cur-time in this-procedure(output v-today, output v-time).
     4641       assign
     4642       buf_cd-plu.charkey_one = p-name
     4643       buf_cd-plu.key#_one = integer(p-code-chr)
     4644       buf_cd-plu.to-del   =  not p-del
     4645       buf_cd-plu.to-send   =  p-del
     4646       buf_cd-plu.key#_two = p-parent
     4647       buf_cd-plu.charkey_two = p-treetype
     4648       buf_cd-plu.logkey_one = p-update-name
     4649       buf_cd-plu.logkey_two = p-update-price
     4650       buf_cd-plu.logkey_three = p-update-group
     4651       buf_cd-plu.logkey_four = p-update-modificator
     4652       .
     4653       if not (p-treetype = "M":U and p-price = 0) then do:
     4654         find first buf_cd-doc no-lock where
     4655                   buf_cd-doc.obj-type = p-obj-type
     4656               and buf_cd-doc.obj-code = p-obj-code
     4657               and buf_cd-doc.pos-type = 'r-keeper':U
     4658               and buf_cd-doc.doc-type = 'переоценка':U
     4659               and buf_cd-doc.doc-code = string(p-file-num)   no-error .
     4660         if not available buf_cd-doc then do:
     4661           run cur-time in this-procedure( output v-today, output v-time).
     4662           create buf_cd-doc.
     4663           assign
     4664           buf_cd-doc.doc-type = 'переоценка':U
     4665           buf_cd-doc.pos-type = 'r-keeper':U
     4666           buf_cd-doc.doc-code = string(p-file-num)
     4667           buf_cd-doc.obj-type = p-obj-type
     4668           buf_cd-doc.obj-code = p-obj-code
     4669           buf_cd-doc.datekey_one = v-today
     4670           .
     4671         end.
     4672         find first buf_cd-doc-line no-lock where
     4673                 buf_cd-doc-line.obj-type = p-obj-type
     4674             and buf_cd-doc-line.obj-code = p-obj-code
     4675             and buf_cd-doc-line.pos-type = 'r-keeper':U
     4676             and buf_cd-doc-line.doc-type = 'переоценка':U
     4677             and buf_cd-doc-line.doc-code = string(p-file-num)
     4678             and buf_cd-doc-line.plu-type = '':U
     4679             and buf_cd-doc-line.plu-code = p-sifr no-error.
     4680         if not available buf_cd-doc-line then do:
     4681           find last buf_cd-doc-line no-lock where
     4682                   buf_cd-doc-line.obj-type = p-obj-type
     4683               and buf_cd-doc-line.obj-code = p-obj-code
     4684               and buf_cd-doc-line.pos-type = 'r-keeper':U
     4685               and buf_cd-doc-line.doc-type = 'переоценка':U
     4686               and buf_cd-doc-line.doc-code = string(p-file-num)
     4687               and buf_cd-doc-line.plu-type = '':U no-error.
     4688           if not available buf_cd-doc-line then do:
     4689             v-line-num = 1.
     4690           end.
     4691           else do:
     4692             assign
     4693             v-line-num = buf_cd-doc-line.line-num  + 1.
     4694           end.
     4695           define variable v-price-id as character no-undo .
     4696           create buf_cd-doc-line.
     4697           assign
     4698           buf_cd-doc-line.obj-type = p-obj-type
     4699           buf_cd-doc-line.obj-code = p-obj-code
     4700           buf_cd-doc-line.pos-type = 'r-keeper':U
     4701           buf_cd-doc-line.plu-code = p-sifr
     4702           buf_cd-doc-line.plu-type = '':U
     4703           buf_cd-doc-line.deckey_one = p-price
     4704           buf_cd-doc-line.doc-type = 'переоценка':U
     4705           buf_cd-doc-line.doc-code = string(p-file-num)
     4706           buf_cd-doc-line.to-del  = (not p-del)
     4707           buf_cd-doc-line.to-send  = p-del
     4708           buf_cd-doc-line.line-num = v-line-num
     4709           .
     4710         end.
     4711       end.
     4712       if p-mode = 'ДОБАВЛЕНИЕ':U
     4713       or buf_cd-plu.b-code  = 0 then do:
     4714         run write-log-and-file in p-log-handle (
     4715                 input 1
     4716               , input log-file-name
     4717               , input 1
     4718               , input substitute( "!!!Блюдо меню/модификатор на кассе R-KEEPER с id &1 код в меню &2 <&3> - не сопоставлен товар в системе IBS TH"
     4719                                   , p-sifr
     4720                                   , p-code-chr
     4721                                   , p-name
     4722                                 )
     4723                                                 ).
     4724         assign
     4725         p-view-log = yes
     4726         .
     4727       end.
     4728       if buf_cd-plu.b-code > 0 then do:
     4729   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     4730     (input  buf_cd-plu.b-code
     4731     ,input  ?
     4732     ,output v-b-code
     4733     )  .
     4734   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4735   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcprcex in g#library
     4736     (input  p-obj-type
     4737     ,input  p-obj-code
     4738     ,input  v-b-code
     4739     ,input  0
     4740     ,input  0
     4741     ,output v-doc-num
     4742     ,output v-price-sale
     4743     ,output v-road-tax
     4744     ,output v-excise
     4745     ,output v-vat-pc
     4746     ,output v-slt-pc
     4747     )  .
     4748       end.
     4749       lll = lll + 1 .
     4750       ll-loc = ll-loc + 1.
     4751       release buf_cd-plu no-error .
     4752       if error-status:error then undo _main, return error return-value .
     4753       release buf_cd-doc-line no-error .
     4754       if error-status:error then undo _main, return error return-value .
     4755     end.
     4756   end procedure.
     4757   procedure update-country :
     4758   define input parameter p-mode as character no-undo .
     4759   define input parameter p-update-name as logical no-undo .
     4760   define input parameter p-update-parent as logical no-undo .
     4761   define input parameter p-sifr as integer no-undo .
     4762   define input parameter p-name  as character no-undo .
     4763   define input parameter p-parent as integer no-undo .
     4764   define input parameter p-del   as logical no-undo .
     4765   define input parameter p-lvl-num as integer no-undo .
     4766   define buffer buf_cd-grp for ub.cd-grp.
     4767   define buffer buf_fbr-gds-grp for ub.fbr-gds-grp.
     4768     _main:
     4769     do
     4770     on error undo, return error return-value
     4771     :
     4772       if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     4773         create buf_cd-grp.
     4774         assign
     4775         buf_cd-grp.obj-type = p-obj-type
     4776         buf_cd-grp.obj-code = p-obj-code
     4777         buf_cd-grp.pos-type = 'r-keeper':U
     4778         buf_cd-grp.grp-type = '':U
     4779         .
     4780       end.
     4781       else do:
     4782         find first buf_cd-grp exclusive-lock where
     4783                   buf_cd-grp.obj-type = p-obj-type
     4784               and buf_cd-grp.obj-code = p-obj-code
     4785               and buf_cd-grp.pos-type = 'r-keeper':U
     4786               and buf_cd-grp.grp-type = '':U
     4787               and buf_cd-grp.grp-code = p-sifr no-error.
     4788         if not available buf_cd-grp then do:
     4789           return error substitute("не найдена или занята запись группы для кассы R-KEEPER с id &1"
     4790                                 ,p-sifr
     4791                                 ).
     4792         end.
     4793       end.
     4794       assign
     4795       buf_cd-grp.grp-code = p-sifr
     4796       buf_cd-grp.upper-grp-code = p-parent
     4797       buf_cd-grp.grp-name = p-name
     4798       buf_cd-grp.to-del = not p-del
     4799       buf_cd-grp.to-send = p-del
     4800       buf_cd-grp.logkey_one = p-update-name
     4801       buf_cd-grp.logkey_two = p-update-parent
     4802       buf_cd-grp.key#_one = p-lvl-num
     4803       .
     4804       lll = lll + 1 .
     4805       ll-loc = ll-loc + 1.
     4806       if p-mode = 'ДОБАВЛЕНИЕ':U
     4807       or not can-find(first buf_fbr-gds-grp no-lock where
     4808                            buf_fbr-gds-grp.obj-type = p-obj-type
     4809                        AND buf_fbr-gds-grp.obj-code = p-obj-code
     4810                        AND buf_fbr-gds-grp.out-code = p-sifr ) then do:
     4811         run write-log-and-file in p-log-handle (
     4812                 input 1
     4813               , input log-file-name
     4814               , input 1
     4815               , input substitute( "!!!Группа блюд меню кассе R-KEEPER с id &1 <&2> - не сопоставлена группа блюд на &3&4 в системе IBS TH"
     4816                                   , p-sifr
     4817                                   , p-name
     4818                                   , p-obj-type
     4819                                   , p-obj-code
     4820                                 )    ).
     4821         assign
     4822         p-view-log = yes
     4823         .
     4824       end.
     4825       release buf_cd-grp no-error .
     4826       if error-status:error then undo _main, return error return-value .
     4827    end.
     4828   end procedure.
     4829   procedure update-clients :
     4830   define input parameter p-mode as character no-undo .
     4831   define input parameter p-sifr as integer no-undo .
     4832   define input parameter p-name  as character no-undo .
     4833   define input parameter p-type  as character no-undo .
     4834   define input parameter p-del   as logical no-undo .
     4835   define buffer buf_cd-clu        for ub.cd-clu.
     4836     _main:
     4837     do
     4838     on error undo, return error return-value
     4839     :
     4840       if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     4841         create buf_cd-clu.
     4842         assign
     4843         buf_cd-clu.obj-type = p-obj-type
     4844         buf_cd-clu.obj-code = p-obj-code
     4845         buf_cd-clu.pos-type = 'r-keeper':U
     4846         buf_cd-clu.clu-type = p-type
     4847         buf_cd-clu.clu-code = p-sifr
     4848         .
     4849       end.
     4850       else do:
     4851         find first buf_cd-clu exclusive-lock where
     4852                   buf_cd-clu.obj-type = p-obj-type
     4853               and buf_cd-clu.obj-code = p-obj-code
     4854               and buf_cd-clu.pos-type = 'r-keeper':U
     4855               and buf_cd-clu.clu-type = p-type
     4856               and buf_cd-clu.clu-code = p-sifr no-error.
     4857         if not available buf_cd-clu then do:
     4858           return error substitute("не найдена или занята запись персонала с id = &1 для кассы R-KEEPER "
     4859                                 ,p-sifr).
     4860         end.
     4861       end.
     4862       assign
     4863       buf_cd-clu.cli-type = 'чел':U
     4864       buf_cd-clu.charkey_one = p-name
     4865       buf_cd-clu.to-send = (p-del = yes)
     4866       buf_cd-clu.to-del = (p-del = no)
     4867       .
     4868       if buf_cd-clu.cli-code = ? then do:
     4869         run write-log-and-file in p-log-handle (
     4870                 input 1
     4871               , input log-file-name
     4872               , input 1
     4873               , input substitute( "!!!на кассе R-KEEPER &3 с id &1 <&2> - не сопоставлен сотрудник в системе IBS TH"
     4874                                   , p-sifr
     4875                                   , p-name
     4876                                   , entry(lookup(p-type, "W,M,K,B":U), "Официант,Менеджер,Кассир,Бармен")
     4877                                 )    ).
     4878         assign
     4879         p-view-log = yes
     4880         .
     4881       end.
     4882       lll = lll + 1 .
     4883       ll-loc = ll-loc + 1.
     4884       release buf_cd-clu no-error .
     4885       if error-status:error then undo _main, return error return-value .
     4886    end.
     4887   end procedure.
     4888   procedure get-checks :
     4889   define variable v-create-write-off as logical no-undo .
     4890   define variable v-create-return as logical no-undo .
     4891   define variable v-gds-create-write-off as logical no-undo .
     4892   define variable v-gds-create-return as logical no-undo .
     4893   define variable chk-type2 as integer no-undo .
     4894   define variable chk-sign as integer no-undo .
     4895   define variable chk-sign2 as integer no-undo .
     4896   define variable gds-sign as integer no-undo .
     4897   define variable gds-sign2 as integer no-undo .
     4898   define variable gds-wo-type as integer no-undo .
     4899   define variable gds-wo-type2 as integer no-undo .
     4900   define variable ii as integer no-undo .
     4901   define variable jj as integer no-undo .
     4902   define variable prev-code2 as character no-undo .
     4903   define buffer buf_cd-plu for ub.cd-plu.
     4904     do
     4905     on error undo, return error
     4906     :
     4907       for each temp-acheck no-lock,
     4908           each temp-avcheck where
     4909               temp-avcheck.unit = temp-acheck.unit
     4910           AND temp-avcheck.depart = temp-acheck.depart
     4911           AND temp-avcheck.logicdate = temp-acheck.logicdate
     4912             and temp-avcheck.del-time >= temp-acheck.start-time
     4913             AND temp-avcheck.del-time <= temp-acheck.end-time
     4914             AND temp-avcheck.sys_num = 0 :
     4915         assign
     4916         temp-avcheck.sys_num = temp-acheck.sys_num.
     4917       end.
     4918        _temp-acheck:
     4919       for each temp-acheck no-lock:
     4920         assign
     4921         chk-date_ = 01/01/1990
     4922         chk-time_ = 0
     4923         shift-date_ = chk-date_
     4924         shift-num_ = 0
     4925         shift-name_ = '':U
     4926         shop-code = 0
     4927         shop-type = "":U
     4928         sales-man_ = 0
     4929         v-flag-salesman  = no
     4930         v-flag-card = no
     4931         cashier_ = 0
     4932         pay-desk_ = 0
     4933         z-num_ = 0
     4934         cash-rate_ = 0
     4935         d-card_ = "":U
     4936         d-mask_ = "":U
     4937         cli-type_ = "":U
     4938         cli-code_ = 0
     4939         tot-d-pcnt = 0
     4940         doc-num_ = "":U
     4941         v-end-of-check = no
     4942         for-chk-type = ""
     4943         prev-code = "":U
     4944         prev-code2 = "":U
     4945         v-create-write-off = no
     4946         v-create-return = no
     4947         .
     4948         assign
     4949         shop-code = ( if get-chkc_context.hnum
     4950                       then integer(temp-acheck.depart)
     4951                       else p-obj-code )
     4952         shop-type = ( if get-chkc_context.hnum then 'маг':U else p-obj-type )
     4953         no-error
     4954         .
     4955         if error-status:error then do:
     4956           run write-log-and-file in p-log-handle (
     4957                   input 1
     4958                 , input log-file-name
     4959                 , input 1
     4960                 , input substitute( "!!!Для чека &1 неверный(нецифровой) номер магазина &2" +
     4961                                     "чек не будет сохранен и обработан"
     4962                                     , temp-acheck.cnum
     4963                                     , temp-acheck.depart
     4964                                     , chr(10)
     4965                                   )    ).
     4966           assign
     4967           p-view-log = yes
     4968           .
     4969           run save-for-future in this-procedure .
     4970           next _temp-acheck.
     4971         end.
     4972         assign
     4973         pay-desk_ =  integer(temp-acheck.unit)
     4974         no-error
     4975         .
     4976         if error-status:error then do:
     4977           run write-log-and-file in p-log-handle (
     4978                   input 1
     4979                 , input log-file-name
     4980                 , input 1
     4981                 , input substitute( "!!!Для чека &1 неверный(нецифровой) номер кассы &2" +
     4982                                     "чек не будет сохранен и обработан"
     4983                                     , temp-acheck.cnum
     4984                                     , temp-acheck.unit
     4985                                     , chr(10)
     4986                                   )    ).
     4987           assign
     4988           p-view-log = yes
     4989           .
     4990           run save-for-future in this-procedure .
     4991           next _temp-acheck.
     4992         end.
     4993         if temp-achecK.deleted  <> 0 then do:
     4994           find first temp-reasons no-lock where
     4995                     temp-reasons.sifr = temp-acheck.deleted no-error.
     4996           if not available temp-reasons then do:
     4997             run write-log-and-file in p-log-handle (
     4998                     input 1
     4999                   , input log-file-name
     5000                   , input 1
     5001                   , input substitute( "!!!Для чека &1 кассы &2 не найдена причина отмены с идентификатором &3&4" +
     5002                                       "чек не будет сохранен и обработан"
     5003                                       , temp-acheck.cnum
     5004                                       , temp-acheck.unit
     5005                                       , temp-acheck.deleted
     5006                                       , chr(10)
     5007                                     )    ).
     5008             assign
     5009             p-view-log = yes
     5010             .
     5011             run save-for-future in this-procedure .
     5012             next _temp-acheck.
     5013           end.
     5014           if temp-reasons.used then do:
     5015             assign
     5016             chk-type_ = integer('1':U)
     5017             chk-sign  = 1
     5018             v-create-write-off = yes
     5019             chk-type2 = integer('96':U)
     5020             chk-sign2  = - 1
     5021             .
     5022           end.
     5023           else do:
     5024             assign
     5025             chk-type_ = integer('1':U)
     5026             chk-sign  = 1
     5027             v-create-return = yes
     5028             chk-type2 = integer('6':U)
     5029             chk-sign2  = - 1
     5030             .
     5031           end.
     5032         end.
     5033         else do:
     5034           assign
     5035           chk-type_ = integer('1':U)
     5036           chk-sign  = 1
     5037           .
     5038         end.
     5039         assign
     5040         sales-man_ = get-sales-man(temp-acheck.waiter, chk-date_)
     5041         cashier_  = get-cashier(temp-acheck.cashier, chk-date_)
     5042         no-error .
     5043         _do:
     5044         do ii = 1 to 2:
     5045           FIND  ub.chk-doc where
     5046                 ub.chk-doc.obj-type = shop-type and
     5047                 ub.chk-doc.obj-code = shop-code and
     5048                 ub.chk-doc.chk-date = temp-acheck.realdate and
     5049                 ub.chk-doc.pay-desk = integer(temp-acheck.unit) and
     5050                 ub.chk-doc.chk-time = integer(entry(1, temp-acheck.closetime, ":":U)) * 3600 + integer (entry(2, temp-acheck.closetime, ":":U)) * 60 and
     5051                 ub.chk-doc.chk-num = temp-acheck.cnum and
     5052                 ub.chk-doc.sales-man = sales-man_
     5053                 NO-ERROR NO-WAIT.
     5054           if (avail ub.chk-doc and ub.chk-doc.chk-type = (if ii = 1 then chk-type_ else chk-type2))
     5055           or locked ub.chk-doc then do:
     5056             if not v-create-return and not v-create-write-off then leave _do.
     5057             else next _do.
     5058           end.
     5059           if ambiguous ub.chk-doc then do:
     5060             FIND  ub.chk-doc where
     5061                   ub.chk-doc.obj-type = shop-type and
     5062                   ub.chk-doc.obj-code = shop-code and
     5063                   ub.chk-doc.chk-date = temp-acheck.realdate and
     5064                   ub.chk-doc.pay-desk = integer(temp-acheck.unit) and
     5065                   ub.chk-doc.chk-time = integer(entry(1, temp-acheck.closetime, ":":U)) * 3600 + integer (entry(2, temp-acheck.closetime, ":":U)) * 60 and
     5066                   ub.chk-doc.chk-num = temp-acheck.cnum and
     5067                   ub.chk-doc.sales-man = sales-man_ and
     5068                   ub.chk-doc.chk-type = (if ii = 1 then chk-type_ else chk-type2)
     5069                   NO-ERROR NO-WAIT.
     5070             if (avail ub.chk-doc and ub.chk-doc.chk-type = (if ii = 1 then chk-type_ else chk-type2))
     5071             or locked ub.chk-doc
     5072             or ambiguous ub.chk-doc then do:
     5073               if not v-create-return and not v-create-write-off then leave _do.
     5074               else next _do.
     5075             end.
     5076           end.
     5077           assign
     5078           exist = no
     5079           cr = 0
     5080           lll = lll + 1
     5081           .
     5082           create ub.chk-doc.
     5083           assign
     5084           lng = 0
     5085           lnp = 0
     5086           sub-d = 0
     5087           var-discnt-id = 0
     5088           lng-sub-d = 0
     5089           netto-for-sub-d = 0
     5090           ub.chk-doc.obj-code = shop-code
     5091           ub.chk-doc.obj-type = shop-type
     5092           ub.chk-doc.office = ?
     5093           ub.chk-doc.doc-code = (if get-chkc_context.db-num = 0
     5094                                 then string(next-value(s-chk, ub ))
     5095                                 else string( shop-code ) + chr(47) + string( next-value( s-chk, ub ) ))
     5096           ub.chk-doc.chk-num = temp-acheck.cnum
     5097           ub.chk-doc.chk-date = temp-acheck.realdate
     5098           ub.chk-doc.chk-time = integer(entry(1, temp-acheck.closetime, ":":U)) * 3600 + integer (entry(2, temp-acheck.closetime, ":":U)) * 60
     5099           ub.chk-doc.pay-desk = pay-desk_
     5100           ub.chk-doc.sales-man = sales-man_
     5101           ub.chk-doc.cashier = cashier_
     5102           ub.chk-doc.discnt = 0
     5103           ub.chk-doc.src-d-card = "":U
     5104           ub.chk-doc.src-d-pcnt = 0
     5105           ub.chk-doc.src-shift-date = temp-acheck.logicdate
     5106           ub.chk-doc.shift-num = 0
     5107           ub.chk-doc.shift-name = '':U
     5108           ub.chk-doc.src-shift-name = '':U
     5109           ub.chk-doc.cash-rate = temp-acheck.basekurs
     5110           ub.chk-doc.cash-scale = 1
     5111           ub.chk-doc.z-number = 0
     5112           ub.chk-doc.doc-num = "Стол-" + string(temp-acheck.table_) + chr(32) + "Персон-" + string(temp-acheck.cover)
     5113           ub.chk-doc.chk-type = (if ii = 1 then chk-type_ else chk-type2)
     5114           ub.chk-doc.correct = yes
     5115           brutto-sum_ = (if ii = 1 then chk-sign else chk-sign2) * temp-acheck.total
     5116           no-error
     5117           .
     5118           if error-status:error then do:
     5119             ub.chk-doc.correct = no.
     5120           end.
     5121           if ii = 1
     5122           then
     5123           prev-code = ub.chk-doc.doc-code.
     5124           if ii = 2
     5125           then
     5126           prev-code2 = ub.chk-doc.doc-code.
     5127           for each temp-archeck no-lock where
     5128                   temp-archeck.sys_num = temp-acheck.sys_num:
     5129   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5130   assign
     5131   v-gds-create-write-off = no
     5132   v-gds-create-return = no
     5133   gds-sign = 1
     5134   gds-wo-type = chk-type_
     5135   .
     5136   find first buf_cd-plu no-lock where
     5137             buf_cd-plu.obj-type = p-obj-type
     5138         and buf_cd-plu.obj-code = p-obj-code
     5139         and buf_cd-plu.pos-type = 'r-keeper':U
     5140         and buf_cd-plu.plu-type = (if temp-archeck.component then 'modifier':U else '':U)
     5141         and buf_cd-plu.plu-code = ( temp-archeck.sifr) no-error.
     5142   if available buf_cd-plu then do:
     5143     if buf_cd-plu.b-code > 0 then do:
     5144       assign
     5145       bc-buf = string(buf_cd-plu.b-code)
     5146       .
     5147     end.
     5148     else do:
     5149       run write-log-and-file in p-log-handle (
     5150               input 1
     5151             , input log-file-name
     5152             , input 1
     5153             , input substitute( "!!!Для строки чека &1 кассы &2 блюдo/модификатор с идентификатором &3&4" +
     5154                                 "не привязано к товару в IBS TH&4" +
     5155                                 "чек не будет сохранен и обработан"
     5156                                 , temp-acheck.cnum
     5157                                 , temp-acheck.unit
     5158                                 , temp-archeck.sifr
     5159                                 , chr(10)
     5160                               )    ).
     5161       assign
     5162       p-view-log = yes
     5163       .
     5164       run save-for-future in this-procedure .
     5165       undo  _temp-acheck, next _temp-acheck.
     5166     end.
     5167   end.
     5168   else do:
     5169     run write-log-and-file in p-log-handle (
     5170             input 1
     5171           , input log-file-name
     5172           , input 1
     5173           , input substitute( "!!!Для строки чека &1 кассы &2 не найдено блюдo с идентификатором &3&4" +
     5174                               "чек не будет сохранен и обработан"
     5175                               , temp-acheck.cnum
     5176                               , temp-acheck.unit
     5177                               , temp-archeck.sifr
     5178                               , chr(10)
     5179                             )    ).
     5180     assign
     5181     p-view-log = yes
     5182     .
     5183     run save-for-future in this-procedure .
     5184     undo  _temp-acheck, next _temp-acheck.
     5185   end.
     5186   _do-gds:
     5187   do jj = 1 to 2:
     5188     CREATE ub.chk-gds.
     5189     assign
     5190     lng = lng + 1
     5191     ub.chk-gds.doc-code = chk-doc.doc-code
     5192     ub.chk-gds.line-num = lng
     5193     ub.chk-gds.grp-code = 0
     5194     ub.chk-gds.chk-date = chk-doc.chk-date
     5195     ub.chk-gds.b-code = 0
     5196     ub.chk-gds.src-code  = bc-buf
     5197     ub.chk-gds.src-price = temp-archeck.price
     5198     ub.chk-gds.src-sum   = temp-archeck.price * temp-archeck.qnt
     5199     ub.chk-gds.src-qnty = (if jj = 1 then gds-sign else gds-sign2) * (if ii = 1 then chk-sign else chk-sign2) * temp-archeck.qnt
     5200     ub.chk-gds.doc-qnty = (if jj = 1 then gds-sign else gds-sign2) * (if ii = 1 then chk-sign else chk-sign2) * temp-archeck.qnt
     5201     ub.chk-gds.price-service = 0
     5202     ub.chk-gds.time-oper = chk-doc.chk-time
     5203     ub.chk-gds.src-discnt = 0
     5204     ub.chk-gds.pass-gds = ?
     5205     ub.chk-gds.is-error = no
     5206     ub.chk-gds.pump = 0
     5207     ub.chk-gds.road-tax = 0
     5208     ub.chk-gds.depart-id = p-obj-code
     5209     ub.chk-gds.write-off-code = if v-create-write-off and ii = 2
     5210                              then (if not temp-archeck.component
     5211                                    then integer('-9':U)
     5212                                    else integer('-4':U)
     5213                                    )
     5214                              else  (if not temp-archeck.component
     5215                                    then 0
     5216                                    else (if chk-doc.chk-type =  integer('1':U)
     5217                                          then  integer('2':U)
     5218                                          else  integer('-2':U)
     5219                                         )
     5220                                    )
     5221     ub.chk-gds.sales-man = chk-doc.sales-man
     5222     ub.chk-gds.line-sign = (if chk-doc.chk-type = integer('1':U)
     5223                         then (chk-gds.src-qnty >= 0)
     5224                         else (chk-gds.src-qnty <= 0)
     5225                         )
     5226     ub.chk-gds.line-type = '':U
     5227     netto-for-sub-d = netto-for-sub-d +
     5228     (if ub.chk-gds.write-off-code = ?
     5229     or ub.chk-gds.write-off-code <= 0
     5230     then
     5231     ((chk-gds.src-price - ub.chk-gds.src-discnt) * (if jj = 1 then gds-sign else gds-sign2) * (if ii = 1 then chk-sign else chk-sign2) * ub.chk-gds.src-qnty)
     5232     else 0)
     5233     .
     5234     if not v-gds-create-return then leave _do-gds.
     5235   end.
     5236           end.
     5237           for each temp-avcheck where
     5238                   temp-avcheck.sys_num = temp-acheck.sys_num:
     5239   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5240   assign
     5241   v-gds-create-write-off = no
     5242   v-gds-create-return = no
     5243   gds-sign = 1
     5244   gds-wo-type = chk-type_
     5245   .
     5246   find first buf_cd-plu no-lock where
     5247             buf_cd-plu.obj-type = p-obj-type
     5248         and buf_cd-plu.obj-code = p-obj-code
     5249         and buf_cd-plu.pos-type = 'r-keeper':U
     5250         and buf_cd-plu.plu-type = '':U
     5251         and buf_cd-plu.plu-code = ((if temp-avcheck.comp > 0 then - 1 else 1 ) * temp-avcheck.sifr) no-error.
     5252   if available buf_cd-plu then do:
     5253     if buf_cd-plu.b-code > 0 then do:
     5254       assign
     5255       bc-buf = string(buf_cd-plu.b-code)
     5256       .
     5257     end.
     5258     else do:
     5259       run write-log-and-file in p-log-handle (
     5260               input 1
     5261             , input log-file-name
     5262             , input 1
     5263             , input substitute( "!!!Для строки чека &1 кассы &2 блюдo/модификатор с идентификатором &3&4" +
     5264                                 "не привязано к товару в IBS TH&4" +
     5265                                 "чек не будет сохранен и обработан"
     5266                                 , temp-acheck.cnum
     5267                                 , temp-acheck.unit
     5268                                 , temp-avcheck.sifr
     5269                                 , chr(10)
     5270                               )    ).
     5271       assign
     5272       p-view-log = yes
     5273       .
     5274       run save-for-future in this-procedure .
     5275       undo  _temp-acheck, next _temp-acheck.
     5276     end.
     5277   end.
     5278   else do:
     5279     run write-log-and-file in p-log-handle (
     5280             input 1
     5281           , input log-file-name
     5282           , input 1
     5283           , input substitute( "!!!Для строки чека &1 кассы &2 не найдено блюдo с идентификатором &3&4" +
     5284                               "чек не будет сохранен и обработан"
     5285                               , temp-acheck.cnum
     5286                               , temp-acheck.unit
     5287                               , temp-avcheck.sifr
     5288                               , chr(10)
     5289                             )    ).
     5290     assign
     5291     p-view-log = yes
     5292     .
     5293     run save-for-future in this-procedure .
     5294     undo  _temp-acheck, next _temp-acheck.
     5295   end.
     5296   find first temp-reasons no-lock where
     5297             temp-reasons.sifr = temp-avcheck.reason no-error.
     5298   if not available temp-reasons then do:
     5299     run write-log-and-file in p-log-handle (
     5300             input 1
     5301           , input log-file-name
     5302           , input 1
     5303           , input substitute( "!!!Для удаленной строки (товар с идентификатором & 5) чека &1 кассы &2 не найдена причина отмены с идентификатором &3&4" +
     5304                               "чек не будет сохранен и обработан"
     5305                               , temp-acheck.cnum
     5306                               , temp-acheck.unit
     5307                               , temp-acheck.deleted
     5308                               , temp-avcheck.sifr
     5309                               , chr(10)
     5310                             )    ).
     5311     assign
     5312     p-view-log = yes
     5313     .
     5314     run save-for-future in this-procedure .
     5315     undo _temp-acheck, next _temp-acheck.
     5316   end.
     5317   if temp-reasons.used then do:
     5318     assign
     5319     v-gds-create-write-off = yes
     5320     gds-wo-type2 = integer('96':U)
     5321     gds-sign2  = - 1
     5322     .
     5323   end.
     5324   else do:
     5325     assign
     5326     v-gds-create-return = yes
     5327     gds-wo-type2 = integer('6':U)
     5328     gds-sign2  = - 1
     5329     .
     5330   end.
     5331   _do-gds:
     5332   do jj = 1 to 2:
     5333     CREATE ub.chk-gds.
     5334     assign
     5335     lng = lng + 1
     5336     ub.chk-gds.doc-code = chk-doc.doc-code
     5337     ub.chk-gds.line-num = lng
     5338     ub.chk-gds.grp-code = 0
     5339     ub.chk-gds.chk-date = chk-doc.chk-date
     5340     ub.chk-gds.b-code = 0
     5341     ub.chk-gds.src-code  = bc-buf
     5342     ub.chk-gds.src-price = temp-avcheck.price
     5343     ub.chk-gds.src-sum   = temp-avcheck.price * temp-avcheck.qnt
     5344     ub.chk-gds.src-qnty = (if jj = 1 then gds-sign else gds-sign2) * (if ii = 1 then chk-sign else chk-sign2) * temp-avcheck.qnt
     5345     ub.chk-gds.doc-qnty = (if jj = 1 then gds-sign else gds-sign2) * (if ii = 1 then chk-sign else chk-sign2) * temp-avcheck.qnt
     5346     ub.chk-gds.price-service = 0
     5347     ub.chk-gds.time-oper = (temp-avcheck.del-time - integer(temp-avcheck.realdate) ) * 10000
     5348     ub.chk-gds.src-discnt = 0
     5349     ub.chk-gds.pass-gds = ?
     5350     ub.chk-gds.is-error = no
     5351     ub.chk-gds.pump = 0
     5352     ub.chk-gds.road-tax = 0
     5353     ub.chk-gds.depart-id = p-obj-code
     5354     ub.chk-gds.write-off-code = if v-gds-create-write-off
     5355                              then (if temp-avcheck.comp = 0
     5356                                    then  integer('1':U)
     5357                                    else (if chk-doc.chk-type =  integer('1':U)
     5358                                          then  integer('3':U)
     5359                                          else  integer('-3':U)
     5360                                         )
     5361                                    )
     5362                              else (if temp-avcheck.comp = 0
     5363                                    then 0
     5364                                    else (if chk-doc.chk-type =  integer('1':U)
     5365                                          then  integer('2':U)
     5366                                          else  integer('-2':U)
     5367                                         )
     5368                                   )
     5369     ub.chk-gds.sales-man = chk-doc.sales-man
     5370     ub.chk-gds.line-sign = (if chk-doc.chk-type = integer('1':U)
     5371                         then (chk-gds.src-qnty >= 0)
     5372                         else (chk-gds.src-qnty <= 0)
     5373                         )
     5374     ub.chk-gds.line-type = '':U
     5375     netto-for-sub-d = netto-for-sub-d +
     5376     (if ub.chk-gds.write-off-code = ?
     5377     or ub.chk-gds.write-off-code <= 0
     5378     then
     5379     ((chk-gds.src-price - ub.chk-gds.src-discnt) * (if jj = 1 then gds-sign else gds-sign2) * (if ii = 1 then chk-sign else chk-sign2) * ub.chk-gds.src-qnty)
     5380     else 0)
     5381     .
     5382     if not v-gds-create-return then leave _do-gds.
     5383   end.
     5384           end.
     5385           for each temp-adcheck no-lock where
     5386               temp-adcheck.sys_num = temp-acheck.sys_num:
     5387             find first tt-dis-rule-r-keeper no-lock where
     5388                       tt-dis-rule-r-keeper.r-keeper-rule-num = temp-adcheck.sifr no-error.
     5389             if not available tt-dis-rule-r-keeper then  do:
     5390               run write-log-and-file in p-log-handle (
     5391                       input 1
     5392                     , input log-file-name
     5393                     , input 1
     5394                     , input substitute( "!!!Для чека &1 кассы &2 не найдено соответствующее правило скидки для скидки с идентификатором &3&4" +
     5395                                         "чек не будет сохранен и обработан"
     5396                                         , temp-acheck.cnum
     5397                                         , temp-acheck.unit
     5398                                         , temp-adcheck.sifr
     5399                                         , chr(10)
     5400                                       )    ).
     5401               assign
     5402               p-view-log = yes
     5403               .
     5404               run save-for-future in this-procedure .
     5405               undo _temp-acheck,  next _temp-acheck.
     5406             end.
     5407             if tt-dis-rule-r-keeper.discnt-type = integer('2':U)
     5408             or tt-dis-rule-r-keeper.discnt-type = integer('3':U)
     5409             or tt-dis-rule-r-keeper.discnt-type = integer('4':U)
     5410             or tt-dis-rule-r-keeper.discnt-type = integer('5':U) then do:
     5411               sub-d = sub-d + (if ii = 1 then chk-sign else chk-sign2) * (- temp-adcheck.sum).
     5412             end.
     5413             create ub.chk-discnt.
     5414             assign
     5415             ub.chk-discnt.doc-code = ub.chk-doc.doc-code
     5416             ub.chk-discnt.record-type = 0
     5417             ub.chk-discnt.discnt-id = (var-discnt-id + 1)
     5418             ub.chk-discnt.line-num = lng
     5419             ub.chk-discnt.time-oper = ub.chk-doc.chk-time
     5420             ub.chk-discnt.line-type = tt-dis-rule-r-keeper.subject-type
     5421             ub.chk-discnt.line-sign =  (if temp-adcheck.sum <= 0 then  yes else no)
     5422             ub.chk-discnt.pass-discnt = if temp-adcheck.person = 0 then integer('0':U) else integer('1':U)
     5423             ub.chk-discnt.value-type = tt-dis-rule-r-keeper.value-type
     5424             ub.chk-discnt.discnt-type = tt-dis-rule-r-keeper.discnt-type
     5425             ub.chk-discnt.src-d-card = string(temp-adcheck.CARDCOD)
     5426             ub.chk-discnt.d-card = "":U
     5427             ub.chk-doc.src-d-card = (if temp-adcheck.cardcod <> 0 then string(temp-adcheck.CARDCOD) else ub.chk-doc.src-d-card)
     5428             ub.chk-discnt.discnt-value-abs = (if ii = 1 then chk-sign else chk-sign2) * - temp-adcheck.sum
     5429             ub.chk-discnt.object-qnty = (if ii = 1 then chk-sign else chk-sign2) * ub.chk-doc.doc-qnty
     5430             ub.chk-discnt.object-sum = (if ii = 1 then chk-sign else chk-sign2) * netto-for-sub-d
     5431             ub.chk-discnt.discnt-value-pcnt = (if ub.chk-discnt.object-sum = 0 then 0 else (if ii = 1 then chk-sign else chk-sign2) * (- temp-adcheck.sum)  / ub.chk-discnt.object-sum  * 100)
     5432             ub.chk-discnt.object-line-num = 0
     5433             ub.chk-discnt.pay-desk = ub.chk-doc.pay-desk
     5434             ub.chk-discnt.obj-code = ub.chk-doc.obj-code
     5435             ub.chk-discnt.obj-type = ub.chk-doc.obj-type
     5436             ub.chk-discnt.chk-date = ub.chk-doc.chk-date
     5437             ub.chk-discnt.chk-time = ub.chk-doc.chk-time
     5438             var-discnt-id = var-discnt-id + 1
     5439             netto-for-sub-d = netto-for-sub-d - (- temp-adcheck.sum)
     5440             .
     5441           END.
     5442           for each temp-apcheck no-lock where
     5443                   temp-apcheck.sys_num = temp-acheck.sys_num:
     5444             assign
     5445             curr_code = 0
     5446             pay_code = convert-cash-pay ( input temp-apcheck.currency, output curr_code)
     5447             .
     5448             CREATE ub.chk-pay .
     5449             assign
     5450             lnp = lnp + 1
     5451             ub.chk-pay.doc-code = ub.chk-doc.doc-code
     5452             ub.chk-pay.line-num = lnp
     5453             ub.chk-pay.chk-date = ub.chk-doc.chk-date
     5454             ub.chk-pay.obj-type = ub.chk-doc.obj-type
     5455             ub.chk-pay.obj-code = ub.chk-doc.obj-code
     5456             ub.chk-pay.tot-rubl = 0
     5457             ub.chk-pay.tot-sum = (if ii = 1 then chk-sign else chk-sign2) * temp-apcheck.origsum
     5458             ub.chk-pay.tot-base = 0
     5459             ub.chk-pay.pay-code = pay_code
     5460             ub.chk-pay.curr-code = curr_code
     5461             ub.chk-pay.time-oper = ub.chk-doc.chk-time
     5462             ub.chk-pay.cash-rate = temp-apcheck.kurs
     5463             ub.chk-pay.line-type = "":U
     5464             ub.chk-pay.line-sign = (if ub.chk-doc.chk-type = integer('1':U)
     5465                                 then (chk-pay.tot-sum >= 0)
     5466                                 else (chk-pay.tot-sum <= 0)
     5467                                 )
     5468             ub.chk-pay.is-error = no
     5469             .
     5470             if temp-apcheck.discount <> 0 then do:
     5471               create ub.chk-discnt.
     5472               assign
     5473               ub.chk-discnt.doc-code = ub.chk-doc.doc-code
     5474               ub.chk-discnt.record-type = 0
     5475               ub.chk-discnt.discnt-id = (var-discnt-id + 1)
     5476               ub.chk-discnt.line-num = lng
     5477               ub.chk-discnt.time-oper = ub.chk-doc.chk-time
     5478               ub.chk-discnt.line-type = integer('5':U)
     5479               ub.chk-discnt.pass-discnt = integer('0':U)
     5480               ub.chk-discnt.value-type = integer('1':U)
     5481               ub.chk-discnt.discnt-type = integer('0':U)
     5482               ub.chk-discnt.src-d-card = chk-gds.src-d-card
     5483               ub.chk-discnt.d-card = chk-gds.d-card
     5484               ub.chk-discnt.discnt-value-pcnt = temp-apcheck.discount  * 100
     5485               ub.chk-discnt.discnt-value-abs = (if ii = 1 then chk-sign else chk-sign2) * (temp-apcheck.basesumeqw  * temp-apcheck.discount) / (1 - temp-apcheck.discount)
     5486               ub.chk-discnt.line-sign =  (if temp-apcheck.discount >= 0 then  yes else no)
     5487               ub.chk-discnt.object-qnty = (if ii = 1 then chk-sign else chk-sign2) * ub.chk-doc.doc-qnty
     5488               ub.chk-discnt.object-sum = (if ii = 1 then chk-sign else chk-sign2) * netto-for-sub-d
     5489               ub.chk-discnt.object-line-num = 0
     5490               ub.chk-discnt.pay-desk = ub.chk-doc.pay-desk
     5491               ub.chk-discnt.obj-code = ub.chk-doc.obj-code
     5492               ub.chk-discnt.obj-type = ub.chk-doc.obj-type
     5493               ub.chk-discnt.chk-date = ub.chk-doc.chk-date
     5494               ub.chk-discnt.chk-time = ub.chk-doc.chk-time
     5495               var-discnt-id = var-discnt-id + 1
     5496               sub-d = sub-d + (if ii = 1 then chk-sign else chk-sign2) * ub.chk-discnt.discnt-value-abs
     5497               netto-for-sub-d = netto-for-sub-d - (if ii = 1 then chk-sign else chk-sign2) * ub.chk-discnt.discnt-value-abs
     5498               ub.chk-pay.tot-sum = ub.chk-pay.tot-sum - ub.chk-discnt.discnt-value-abs
     5499               .
     5500             end.
     5501           end.
     5502           if ii = 1 then do:
     5503             get-chkc_context.ll = lll.
     5504   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5505   if (valid-handle(g#libchkvl) <> true) then do:   run str/libchkvl.p persistent no-error .   if error-status :error or (valid-handle(g#libchkvl) <> true) then do:     message       "Error starting nws/libchkvl.p" skip       g#libchkvl skip       g#libchkvl :type skip       g#libchkvl :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libchkvl_getcheck in g#libchkvl
     5506     (input  buffer get-chkc_context:handle
     5507     ,input  'ДОБАВЛЕНИЕ':U
     5508     ,input  ''
     5509     ,input  yes
     5510     ,input  yes
     5511     ,input  ?
     5512     ,input  lng-sub-d
     5513     ,input  sub-d
     5514     ,input  var-discnt-id
     5515     ,input-output prev-code
     5516       ) no-error .
     5517             assign
     5518             p-view-log = (p-view-log or get-chkc_context.view-log)
     5519             lll = get-chkc_context.ll
     5520             .
     5521           end.
     5522           if not v-create-return and not v-create-write-off then leave _do.
     5523           if ii = 2 then do:
     5524             get-chkc_context.ll = lll.
     5525   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5526   if (valid-handle(g#libchkvl) <> true) then do:   run str/libchkvl.p persistent no-error .   if error-status :error or (valid-handle(g#libchkvl) <> true) then do:     message       "Error starting nws/libchkvl.p" skip       g#libchkvl skip       g#libchkvl :type skip       g#libchkvl :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libchkvl_getcheck in g#libchkvl
     5527     (input  buffer get-chkc_context:handle
     5528     ,input  'ДОБАВЛЕНИЕ':U
     5529     ,input  ''
     5530     ,input  yes
     5531     ,input  yes
     5532     ,input  ?
     5533     ,input  lng-sub-d
     5534     ,input  sub-d
     5535     ,input  var-discnt-id
     5536     ,input-output prev-code2
     5537       ) no-error .
     5538             assign
     5539             p-view-log = (p-view-log or get-chkc_context.view-log)
     5540             lll = get-chkc_context.ll
     5541             .
     5542           end.
     5543         end.
     5544        end.
     5545     end.
     5546   end procedure.
     5547   procedure save-for-future :
     5548     do
     5549     on error undo, return error
     5550     :
     5551       assign
     5552       v-session-status_ = "U".
     5553     end.
     5554   end procedure.
