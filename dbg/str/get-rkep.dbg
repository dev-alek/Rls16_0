     3833             buffer-copy temp-i-modify to temp-modify.
     3834             find first buf_temp-control where                 buf_temp-control.file_ = chr(4) + p-table  no-error .        if not available buf_temp-control then do:                                     create buf_temp-control.                                                      assign                                                                        buf_temp-control.file_ = chr(4) + p-table                             .                                                                             error-status:error = no.                                                    end.                                                                          assign                                                                        buf_temp-control.records = buf_temp-control.records + 1.
     3835           end.
     3836           if error-status:error then do:                                                  run write-log-and-file in p-log-handle (                                            input 1                                                                     , input log-file-name                                                         , input 1                                                                     , input substitute("!!!При чтении данных из файла &1 в строке &2 произошла ошибка:&3&4"                                , filename                                                                                           , var-file-line-num                                                                                  , chr(10)                                                                                      , error-status:get-message(1)                                                                          )).                                                                          assign                                                                                               p-view-log = yes                                                                                     .                                                                                                  end.
     3837         end.
     3838         when "MONEY":u then do:
     3839           if available temp-i-money then delete temp-i-money.
     3840           create temp-i-money.
     3841           import stream ChkStream temp-i-money no-error .
     3842           if not error-status:error then do:
     3843             create temp-money.
     3844             buffer-copy temp-i-money to temp-money.
     3845             find first buf_temp-control where                 buf_temp-control.file_ = chr(4) + p-table  no-error .        if not available buf_temp-control then do:                                     create buf_temp-control.                                                      assign                                                                        buf_temp-control.file_ = chr(4) + p-table                             .                                                                             error-status:error = no.                                                    end.                                                                          assign                                                                        buf_temp-control.records = buf_temp-control.records + 1.
     3846           end.
     3847           if error-status:error then do:                                                  run write-log-and-file in p-log-handle (                                            input 1                                                                     , input log-file-name                                                         , input 1                                                                     , input substitute("!!!При чтении данных из файла &1 в строке &2 произошла ошибка:&3&4"                                , filename                                                                                           , var-file-line-num                                                                                  , chr(10)                                                                                      , error-status:get-message(1)                                                                          )).                                                                          assign                                                                                               p-view-log = yes                                                                                     .                                                                                                  end.
     3848         end.
     3849         when "PERSONAL":u then do:
     3850           if available temp-i-personal then delete temp-i-personal.
     3851           create temp-i-personal.
     3852           import stream ChkStream temp-i-personal no-error .
     3853           if not error-status:error then do:
