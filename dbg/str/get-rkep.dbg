     1211   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1212   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
     1213                                                       ,input p-range-type as character
     1214                                                       ,input p-code as integer):
     1215   define variable v-seq-val as integer no-undo .
     1216   define buffer buf_code-range for ub.code-range.
     1217   find first buf_code-range no-lock where
     1218             buf_code-range.db-num = p-db-num
     1219       and  buf_code-range.range-type = p-range-type
     1220       and  buf_code-range.stts = 'u'
     1221       and buf_code-range.first-code <= p-code
     1222       and buf_code-range.last-code >= p-code no-error .
     1223   if available buf_code-range then return yes.
     1224   CASE p-range-type:
     1225     when 'pngb':U then do:
     1226       v-seq-val = current-value(s-pngb-code, ub).
     1227     end.
     1228     when 'fmgb':U then do:
     1229       v-seq-val = current-value(s-fmgb-code, ub).
     1230     end.
     1231   END CASE.
     1232   if p-code <= v-seq-val then do:
     1233     find first buf_code-range no-lock where
     1234               buf_code-range.db-num = p-db-num
     1235         and  buf_code-range.range-type = p-range-type
     1236         and  buf_code-range.stts = 'a'
     1237         and buf_code-range.first-code <= p-code
     1238         no-error .
     1239    if available buf_code-range then return yes.
     1240   end.
     1241   find first buf_code-range no-lock where
     1242             buf_code-range.db-num = p-db-num
     1243       and  buf_code-range.range-type = p-range-type
     1244       and  buf_code-range.stts = 'f'
     1245       and buf_code-range.first-code <= p-code
     1246       and buf_code-range.last-code >= p-code
     1247       no-error .
     1248   if available buf_code-range then return yes.
     1249   return no.
     1250   END FUNCTION.
     1251   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
     1252                                                       ,input p-range-type as character
     1253                                                       ,input p-code as integer):
     1254   define variable v-seq-val as integer no-undo .
     1255   define buffer buf_code-range for ub.code-range.
     1256   CASE p-range-type:
     1257     when 'pngb':U then do:
     1258       v-seq-val = current-value(s-pngb-code, ub).
     1259     end.
     1260     when 'fmgb':U then do:
     1261       v-seq-val = current-value(s-fmgb-code, ub).
     1262     end.
     1263   END CASE.
     1264   if p-code <= v-seq-val then do:
     1265     find first buf_code-range no-lock where
     1266               buf_code-range.db-num = p-db-num
     1267         and  buf_code-range.range-type = p-range-type
     1268         and buf_code-range.first-code <= p-code
     1269         and buf_code-range.last-code >= p-code no-error .
     1270     if available buf_code-range then return yes.
     1271   end.
     1272   return no.
     1273   END FUNCTION.
     1274   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
     1275                                                       ,input p-db-num as integer
     1276                                                       ,input p-staff-code as integer
     1277                                                       ,input p-date as date
     1278                                                        ):
     1279   define buffer buf_staff for ub.staff.
     1280   if p-date = ? then do:
     1281     p-date = today .
     1282   end.
     1283   find first buf_staff no-lock where
     1284             buf_staff.role = p-role
     1285         and buf_staff.role-level = 'db':U
     1286         and buf_staff.db-num = p-db-num
     1287         and buf_staff.staff-code = p-staff-code
     1288         and buf_staff.date-end >= p-date use-index pi  no-error .
     1289   if available buf_staff then do:
     1290     return buf_staff.psn-code.
     1291   end.
     1292   return 0.
     1293   end FUNCTION.
     1294   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
     1295                                                             ,input p-db-num as integer
     1296                                                             ,input p-date as date
     1297                                                                 ):
     1298   define buffer buf_staff for ub.staff.
     1299   define buffer buf2_staff for ub.staff.
     1300   if p-date = ? then do:
     1301     p-date = today .
     1302   end.
     1303   for each  buf_staff no-lock where
     1304             buf_staff.role = p-role
     1305         and buf_staff.db-num = p-db-num,
     1306   first buf2_staff no-lock where
     1307         buf2_staff.role = p-role
     1308     and buf2_staff.role-level = 'db':U
     1309     and buf2_staff.staff-code = buf_staff.staff-code
     1310     and buf2_staff.date-start <= p-date
     1311     and buf2_staff.date-end >= p-date
     1312   by buf_staff.staff-code
     1313   by date-start descending:
     1314     return buf_staff.staff-code.
     1315   end.
     1316   end FUNCTION.
     1317   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
     1318                                                  ,input p-db-num as integer
     1319                                                  ,input p-psn-code as integer
     1320                                                  ,input p-date as date
     1321                                                  ,output p-c-password as character
     1322                                                        ):
     1323   define buffer buf_staff for ub.staff.
     1324   if p-date = ? then do:
     1325     p-date = today .
     1326   end.
     1327   find first buf_staff no-lock where
     1328             buf_staff.role = p-role
     1329         and buf_staff.role-level = 'db':U
     1330         and buf_staff.db-num = p-db-num
     1331        and buf_staff.date-end >= p-date
     1332        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
     1333   if available buf_staff
     1334   then do:
     1335     assign
     1336     p-c-password = buf_staff.password.
     1337     return buf_staff.staff-code.
     1338   end.
     1339   p-c-password = ''.
     1340   return 0.
     1341   end FUNCTION.
     1342   FUNCTION gbclcode-is-psn-role returns integer (
     1343                                                 input p-role as character
     1344                                                 ,input p-psn-code as integer
     1345                                                 ,input p-date as date
     1346                                                     ):
     1347   define buffer buf_staff for ub.staff.
     1348   if p-date = ? then do:
     1349     p-date = today .
     1350   end.
     1351   for each buf_staff no-lock where
     1352             buf_staff.psn-code = p-psn-code
     1353        and  buf_staff.role = p-role
     1354   by buf_staff.role-level
     1355   by buf_staff.date-start
     1356        :
     1357     if  buf_staff.date-start <= p-date and
     1358     buf_staff.date-end >= p-date  then do:
     1359       return buf_staff.staff-code.
     1360     end.
     1361   end.
     1362   return 0.
     1363   end FUNCTION.
     1364   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
     1365   define variable v-role-name as character no-undo .
     1366   assign
     1367   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
     1368   no-error .
     1369   return v-role-name.
     1370   END.
     1371   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1372   FUNCTION gbclcode-get-position returns character ( input p-role as character
     1373                                                     ,input p-role-level as character
     1374                                                     ,input p-work-place as character
     1375                                                     ,input p-staff-code as integer
     1376                                                                ):
     1377   define variable v-role-name as character no-undo .
     1378   define variable v-role-level as character no-undo .
     1379   define variable v-staff-code as integer no-undo .
     1380   assign
     1381   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
     1382   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
     1383   v-staff-code = p-staff-code
     1384   no-error .
     1385   return substitute("&1, &2, Код &3"
     1386                   ,v-role-name
     1387                   ,v-role-level
     1388                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
     1389   END.
     1390   FUNCTION gbclcode-get-work-place returns character (
     1391                                                   input p-role as character
     1392                                                  ,input p-role-level as character
     1393                                                  ,input p-db-num as integer
     1394                                                  ,input p-host-code as integer
     1395                                                  ,input p-obj-type as character
     1396                                                  ,input p-obj-code as integer
     1397                                                  ) :
     1398   define variable v-work-place as character no-undo .
     1399   define variable v-obj-type as character no-undo .
     1400     case p-role-level:
     1401       when 'db':U then do:
     1402         v-work-place = string(p-db-num, "99999").
     1403       end.
     1404       when 'firm':U then do:
     1405         v-work-place = string(p-host-code, "99999").
     1406       end.
     1407       when 'object':U then do:
     1408         assign
     1409         v-work-place = p-obj-type + string(p-obj-code, "999999999")
     1410         .
     1411       end.
     1412     END CASE.
     1413     return v-work-place.
     1414   END FUNCTION.
     1415   FUNCTION gbclcode-get-level-last-code returns integer (
     1416                                                           input p-role as character
     1417                                                         , input p-role-level as character
     1418                                                         , input p-work-place as character
     1419                                                         , input p-date-start as date
     1420                                                         ):
     1421   DEFINE VARIABLE v-today as date no-undo .
     1422   define buffer buf_staff for ub.staff.
     1423   if p-work-place = chr(63) then return ?.
     1424   if p-date-start = ? then do:
     1425     v-today = today .
     1426   end.
     1427   else do:
     1428     v-today = p-date-start.
     1429   end.
     1430   find last buf_staff no-lock where
     1431             buf_staff.role = p-role
     1432        and  buf_staff.role-level = p-role-level
     1433        and  buf_staff.work-place = p-work-place
     1434        and  buf_staff.date-start <= v-today + 1
     1435        and  buf_staff.date-end >= v-today + 1
     1436        use-index pi  no-error .
     1437   if available buf_staff
     1438   then return buf_staff.staff-code.
     1439   return 0.
     1440   end FUNCTION.
     1441   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1442   procedure cur-time :
     1443      define output parameter p-today as date      no-undo .
     1444      define output parameter p-time  as integer   no-undo .
     1445     do
     1446     on error undo, return error
     1447     :
     1448       define variable v-date1 as date      no-undo .
     1449       define variable v-date2 as date      no-undo .
     1450       define variable v-time  as integer   no-undo .
     1451       assign
     1452         v-date1 = today
     1453         v-time  = time
     1454         v-date2 = today
     1455       .
     1456       if v-date1 <> v-date2
     1457       then do:
     1458         assign
     1459           v-date1 = today
     1460           v-time  = v-time
     1461         .
     1462       end.
     1463       assign
     1464         p-today = v-date1
     1465         p-time  = v-time
     1466       .
     1467     end.
     1468   end.
     1469   function cur-time-date returns character
     1470   :
     1471     return string(today, '99/99/9999':U) .
     1472   end.
     1473   function cur-time-mjd returns decimal
     1474   :
     1475     define variable v-date as date      no-undo .
     1476     define variable v-time as integer   no-undo .
     1477     run cur-time in this-procedure
     1478       (output v-date
     1479       ,output v-time
     1480       ) .
     1481     return integer(v-date) - 2400002 + (v-time / 86400) .
     1482   end.
     1483   function cur-time-get-ending-index returns integer
     1484   (input p-number as integer
     1485   )
     1486   :
     1487     if p-number < 0
     1488     or p-number = ?
     1489     then do:
     1490       return 1 .
     1491     end.
     1492     define variable v-rest as integer   no-undo .
     1493     assign
     1494       p-number = p-number modulo 100
     1495     .
     1496     if p-number < 20
     1497     then do:
     1498       assign
     1499         v-rest = p-number
     1500       .
     1501     end.
     1502     else do:
     1503       assign
     1504         v-rest = p-number modulo 10
     1505       .
     1506     end.
     1507     case v-rest :
     1508       when 1
     1509       then do:
     1510         return 2 .
     1511       end.
     1512       when 2 or
     1513       when 3 or
     1514       when 4
     1515       then do:
     1516         return 3 .
     1517       end.
     1518       otherwise do:
     1519         return 1 .
     1520       end.
     1521     end case .
     1522   end.
     1523   procedure cur-time-mjd-to-date :
     1524      define input  parameter i-mjd-diff as decimal no-undo.
     1525      define output parameter o-Date     as date    no-undo.
     1526      define output parameter o-Time     as integer no-undo.
     1527      define variable v-day-number as integer   no-undo .
     1528      if    i-mjd-diff < 0
     1529         or i-mjd-diff = ?
     1530      then do:
     1531         return "?" .
     1532      end.
     1533      assign
     1534         v-day-number = truncate(i-mjd-diff,0).
     1535         o-Date = date(v-day-number + 2400002).
     1536         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1537     .
     1538   end.
     1539   function cur-time-mjd-to-string returns character
     1540   (input p-mjd-diff as decimal
     1541   )
     1542   :
     1543     define variable v-day-number as integer   no-undo .
     1544     define variable v-seconds    as integer   no-undo .
     1545     define variable v-hour       as integer   no-undo .
     1546     define variable v-min        as integer   no-undo .
     1547     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1548     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1549     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1550     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1551     if p-mjd-diff < 0
     1552     or p-mjd-diff = ?
     1553     then do:
     1554       return "?" .
     1555     end.
     1556     assign
     1557       v-day-number = integer(truncate(p-mjd-diff,0))
     1558       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1559     .
     1560     if v-seconds > 86400
     1561     then do:
     1562       assign
     1563         v-seconds = 86400 - 1
     1564       .
     1565     end.
     1566     if v-seconds < 0
     1567     then do:
     1568       assign
     1569         v-seconds = 0
     1570       .
     1571     end.
     1572     assign
     1573       v-hour = truncate(v-seconds / 3600, 0)
     1574     .
     1575     assign
     1576       v-seconds = v-seconds modulo 3600
     1577     .
     1578     assign
     1579       v-min = truncate(v-seconds / 60, 0)
     1580     .
     1581     assign
     1582       v-seconds = v-seconds modulo 60
     1583     .
     1584     return
     1585         (if v-day-number <> 0
     1586           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1587           else ""
     1588         )
     1589       + (if v-day-number <> 0 or v-hour <> 0
     1590           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1591           else ""
     1592         )
     1593       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1594           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1595           else ""
     1596         )
     1597       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1598       .
     1599   end.
     1600   function cur-time-string returns character
     1601   :
     1602     define variable v-date as date      no-undo .
     1603     define variable v-time as integer   no-undo .
     1604     run cur-time in this-procedure
     1605       (output v-date
     1606       ,output v-time
     1607       ) .
     1608     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1609   end.
     1610   function cur-time-string-sec returns character
     1611   :
     1612     define variable v-date as date      no-undo .
     1613     define variable v-time as integer   no-undo .
     1614     run cur-time in this-procedure
     1615       (output v-date
     1616       ,output v-time
     1617       ) .
     1618     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1619   end.
     1620   function cur-time-custom  returns character
     1621   (input p-prefix as character
     1622   ,input p-date-format as character
     1623   ,input p-delimiter as character
     1624   ,input p-time-format as character
     1625   ,input p-suffix as character
     1626   )
     1627   :
     1628     define variable v-date as date      no-undo .
     1629     define variable v-time as integer   no-undo .
     1630     run cur-time in this-procedure
     1631       (output v-date
     1632       ,output v-time
     1633       ) .
     1634     return
     1635       p-prefix
     1636       + string(v-date, p-date-format)
     1637       + p-delimiter
     1638       + string(v-time, p-time-format)
     1639       + p-suffix
     1640       .
     1641   end.
     1642   function cur-time-print  returns character
     1643   :
     1644     define variable v-date as date      no-undo .
     1645     define variable v-time as integer   no-undo .
     1646     run cur-time in this-procedure
     1647       (output v-date
     1648       ,output v-time
     1649       ) .
     1650     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1651   end.
     1652   function cur-time-datetime returns datetime
     1653   :
     1654     define variable v-char as character no-undo .
     1655     define variable v-datetime as datetime no-undo .
     1656     v-char = cur-time-string().
     1657     v-datetime = datetime(v-char).
     1658     return  v-datetime.
     1659   end.
     1660   function cur-time-string-msec returns character
     1661   :
     1662     define variable v-date as datetime  no-undo .
     1663     v-date = now.
     1664     return string(v-date) .
     1665   end.
     1666   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1667   FUNCTION CIntBinS RETURNS CHARACTER(input vl_int as integer):
     1668   def var vl_bin as char no-undo init "".
     1669   if vl_int < 0 OR vl_int = ? then return ?.
     1670   do while vl_int > 0:
     1671     assign
     1672     vl_bin = (if vl_int modulo 2 = 0
     1673                 then "0":U
     1674                 else "1":U) + vl_bin
     1675     vl_int = truncate(vl_int / 2,0).
     1676   end.
     1677   return fill( "0":U, 32 - length(vl_bin)) + vl_bin .
     1678   END FUNCTION.
     1679   FUNCTION BinMask RETURNS LOGICAL(input vl_int as integer,
     1680                                    input vl_binm as character):
     1681   DEFINE VARIABLE vl_bin as character no-undo.
     1682   DEFINE VARIABLE ii as integer no-undo.
     1683   DEFINE VARIABLE ii-len as integer no-undo.
     1684   DEFINE VARIABLE ii-lenm as integer no-undo.
     1685   DEFINE VARIABLE mchar as character no-undo.
     1686   DEFINE VARIABLE ichar as character no-undo.
     1687   if vl_binm = ? then return ?.
     1688   vl_bin = CIntBinS(vl_int).
     1689   if vl_bin = ? then return ?.
     1690   assign
     1691   vl_binm = LEFT-TRIM(vl_binm, "X":U)
     1692   ii-lenm = LENGTH(vl_binm)
     1693   ii-len = LENGTH(vl_bin) - ii-lenm
     1694   .
     1695   if II-LENM > 32 THEN RETURN ?.
     1696   DO II = 1 to II-LENm:
     1697     assign
     1698     mchar = SUBSTR(vl_binm, ii, 1)
     1699     ichar = SUBSTR(vl_bin, ii + ii-len, 1)
     1700     .
     1701     IF not (MCHAR = "0":u or MCHAR = "1":u or MCHAR = "X":u) then return ?.
     1702     IF ichar <> mchar AND mchar <> "X":U then return no.
     1703   END.
     1704   return yes.
     1705   END FUNCTION.
