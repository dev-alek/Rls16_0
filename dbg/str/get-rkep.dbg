     3431   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3432   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3433   FUNCTION convert-discount returns integer
     3434                                             ( input p-disc-reason as integer
     3435                                             , input p-disc-type  as integer
     3436                                             , input p-line-type as integer) :
     3437   define variable v-disc-type as integer no-undo .
     3438   if p-line-type = integer('1':U)
     3439   or p-line-type = integer('0':U)
     3440   then do:
     3441     if p-disc-type = 0
     3442     or p-disc-type = 1
     3443     or p-disc-type = 2
     3444     then do:
     3445       if p-disc-reason <> 0 then
     3446       p-disc-type = p-disc-reason
     3447       .
     3448     end.
     3449   end.
     3450   if p-line-type = integer('3':U)
     3451   or p-line-type = integer('2':U) then do:
     3452     if p-disc-type = 101
     3453     or p-disc-type = 102
     3454     then do:
     3455       if p-disc-reason <> 0 then
     3456       p-disc-type = p-disc-reason
     3457       .
     3458     end.
     3459   end.
     3460   if p-disc-reason <> 0 then do:
     3461     CASE p-disc-reason:
     3462       when 0 then do:
     3463         return integer('0':U).
     3464       end.
     3465       when 1 then do:
     3466         return integer('11':U).
     3467       end.
     3468       when 2 then do:
     3469         return integer('1':U).
     3470       end.
     3471       when 3 or when 15 then do:
     3472         return integer('7':U).
     3473       end.
     3474       when 4 then do:
     3475         return integer('4':U).
     3476       end.
     3477       when 5 then do:
     3478         return integer('12':U).
     3479       end.
     3480       when 6 then do:
     3481         return integer('3':U).
     3482       end.
     3483       when 7 then do:
     3484         return integer('13':U).
     3485       end.
     3486       when 8
     3487       or
     3488       when 9
     3489       or
     3490       when 10
     3491       then do:
     3492         return integer('20':U).
     3493       end.
     3494       when 11
     3495       then do:
     3496         return integer('21':U).
     3497       end.
     3498       when 13
     3499       then do:
     3500         return integer('22':U).
     3501       end.
     3502       when 16 then do:
     3503         return integer('23':U).
     3504       end.
     3505     END CASE.
     3506   end.
     3507   CASE p-disc-type:
     3508     when 0 then do:
     3509       return integer('0':U).
     3510     end.
     3511     when 1 then do:
     3512       return integer('13':U).
     3513     end.
     3514     when 2 then do:
     3515       return integer('2':U).
     3516     end.
     3517     when 3 then do:
     3518       return integer('4':U).
     3519     end.
     3520     when 4 then do:
     3521       return integer('12':U).
     3522     end.
     3523     when 5 then do:
     3524       return integer('1':U).
     3525     end.
     3526     when 6 then do:
     3527       return integer('3':U).
     3528     end.
     3529     when 7 then do:
     3530       return integer('14':U).
     3531     end.
     3532     when 8 then do:
     3533       return integer('15':U).
     3534     end.
     3535     when 9 then do:
     3536       return integer('16':U).
     3537     end.
     3538     when 101 then do:
     3539       return integer('13':U).
     3540     end.
     3541     when 102 then do:
     3542       return integer('5':U).
     3543     end.
     3544     when 103 then do:
     3545       return integer('1':U).
     3546     end.
     3547     when 104 then do:
     3548       return integer('5':U).
     3549     end.
     3550     when 105 then do:
     3551       return integer('1':U).
     3552     end.
     3553     when 106 then do:
     3554       return integer('1':U).
     3555     end.
     3556   END CASE.
     3557   END FUNCTION.
