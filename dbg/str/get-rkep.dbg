     3611     if error-status:error then do:
     3612       assign
     3613       p-view-log = yes
     3614       .
     3615       run write-log-and-file in p-log-handle (
     3616             input 1
     3617           , input log-file-name
     3618           , input 1
     3619           , input substitute( "!!!При обработке данных с кассы &1 &2&3 произошла ошибка при сохранении данных в БД:&4&5"
     3620                               , p-pos-type
     3621                               , p-obj-type
     3622                               , p-obj-code
     3623                               , chr(10)
     3624                               , return-value
     3625                             )
     3626                                             ).
     3627       undo, return.
     3628     end.
     3629   end.
     3630   PROCEDURE get-r-keeper-c.
     3631   def input parameter filename as char no-undo.
     3632   define variable v-file-size as integer no-undo .
     3633   define variable v-sys_num as integer no-undo .
     3634   define variable v-line-num as integer no-undo .
     3635   define buffer buf_temp-control for temp-control.
     3636   run gbl/filename.p (
     3637                   input filename
     3638                  ,output v-full-path
     3639                  ,output v-path
     3640                  ,output v-file-name
     3641                  ,output v-file-name-no-ext
     3642                  ,output v-file-name-ext
     3643                  ) no-error .
     3644   if error-status:error then do:
     3645     assign
     3646     p-view-log = yes
     3647     .
     3648     run write-log-and-file in p-log-handle (
     3649           input 1
     3650         , input log-file-name
     3651         , input 1
     3652         , input substitute( "!!!При обработке файла &1 произошла ошибка при получении полного пути файлу: &2"
     3653                             , filename
     3654                             , return-value
     3655                           )
     3656                                     ).
     3657     return.
     3658   end.
     3659   error-status:error = FALSE.
     3660   run gbl/filesize.p (
     3661                   input v-full-path
     3662                  ,output v-file-size)
     3663                  no-error .
     3664   if error-status:error then do:
     3665     assign
     3666     p-view-log = yes
     3667     .
     3668     run write-log-and-file in p-log-handle (
     3669           input 1
     3670         , input log-file-name
     3671         , input 1
     3672         , input substitute( "!!!При обработке файла &1 произошла ошибка при получении длины файла: &2"
     3673                             , filename
     3674                             , return-value
     3675                           )
     3676                                     ).
     3677     return.
     3678   end.
     3679   input stream ChkStream from value( filename ) convert source "ibm866".
     3680   if Lookup(p-table, "acheck,avcheck,control") > 0 then session:date-format = "mdy":U.
     3681   else session:date-format = "dmy":U.
     3682   _repeat:
     3683   REPEAT :
     3684   _line:
     3685     DO TRANSACTION:
     3686       v-seek  = seek(CHkstream).
     3687       if (v-seek = ?) or (v-file-size - v-seek <= 2) then do:
     3688         return.
     3689       end.
     3690       CASE p-table:
     3691         when "ACHECK":U then do:
     3692           if available temp-i-acheck then delete temp-i-acheck.
     3693           create temp-i-acheck.
     3694           import stream ChkStream temp-i-acheck no-error .
     3695           if not error-status:error then do:
     3696             create temp-acheck.
     3697             buffer-copy temp-i-acheck to temp-acheck
     3698             assign
     3699             temp-acheck.start-time = integer(temp-acheck.opendate) +
     3700                                      0.00001 * (integer(entry(1, temp-acheck.opentime, ":":U)) * 3600 + integer (entry(2, temp-acheck.opentime, ":":U)) * 60 )
     3701             temp-acheck.end-time = integer(temp-acheck.realdate) +
     3702                                      0.00001 * (integer(entry(1, temp-acheck.closetime, ":":U)) * 3600 + integer (entry(2, temp-acheck.closetime, ":":U)) * 60 )
     3703             .
     3704             find first buf_temp-control where                 buf_temp-control.file_ = chr(4) + p-table  no-error .        if not available buf_temp-control then do:                                     create buf_temp-control.                                                      assign                                                                        buf_temp-control.file_ = chr(4) + p-table                             .                                                                             error-status:error = no.                                                    end.                                                                          assign                                                                        buf_temp-control.records = buf_temp-control.records + 1.
     3705           end.
     3706           if error-status:error then do:                                                  run write-log-and-file in p-log-handle (                                            input 1                                                                     , input log-file-name                                                         , input 1                                                                     , input substitute("!!!При чтении данных из файла &1 в строке &2 произошла ошибка:&3&4"                                , filename                                                                                           , var-file-line-num                                                                                  , chr(10)                                                                                      , error-status:get-message(1)                                                                          )).                                                                          assign                                                                                               p-view-log = yes                                                                                     .                                                                                                  end.
     3707         end.
     3708         when "ADCHECK":U then do:
     3709           if available temp-i-adcheck then delete temp-i-adcheck.
     3710           create temp-i-adcheck.
     3711           import stream ChkStream temp-i-adcheck no-error .
     3712           if not error-status:error then do:
     3713             create temp-adcheck.
     3714             buffer-copy temp-i-adcheck to temp-adcheck
     3715             assign
     3716             v-line-num = (if v-sys_num = temp-i-adcheck.sys_num
     3717                           then v-line-num
     3718                           else 0)
     3719             temp-adcheck.line-num = v-line-num + 1
     3720             v-line-num = v-line-num + 1
     3721             v-sys_num = temp-i-adcheck.sys_num
     3722             .
     3723             find first buf_temp-control where                 buf_temp-control.file_ = chr(4) + p-table  no-error .        if not available buf_temp-control then do:                                     create buf_temp-control.                                                      assign                                                                        buf_temp-control.file_ = chr(4) + p-table                             .                                                                             error-status:error = no.                                                    end.                                                                          assign                                                                        buf_temp-control.records = buf_temp-control.records + 1.
     3724           end.
     3725           if error-status:error then do:                                                  run write-log-and-file in p-log-handle (                                            input 1                                                                     , input log-file-name                                                         , input 1                                                                     , input substitute("!!!При чтении данных из файла &1 в строке &2 произошла ошибка:&3&4"                                , filename                                                                                           , var-file-line-num                                                                                  , chr(10)                                                                                      , error-status:get-message(1)                                                                          )).                                                                          assign                                                                                               p-view-log = yes                                                                                     .                                                                                                  end.
     3726         end.
     3727         when "APCHECK":U then do:
