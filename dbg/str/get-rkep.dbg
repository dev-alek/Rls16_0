     3743           end.
     3744           if error-status:error then do:                                                  run write-log-and-file in p-log-handle (                                            input 1                                                                     , input log-file-name                                                         , input 1                                                                     , input substitute("!!!При чтении данных из файла &1 в строке &2 произошла ошибка:&3&4"                                , filename                                                                                           , var-file-line-num                                                                                  , chr(10)                                                                                      , error-status:get-message(1)                                                                          )).                                                                          assign                                                                                               p-view-log = yes                                                                                     .                                                                                                  end.
     3745         end.
     3746         when "ARCHECK":U then do:
     3747           if available temp-i-archeck then delete temp-i-archeck.
     3748           create temp-i-archeck.
     3749           import stream ChkStream temp-i-archeck no-error .
     3750           if not error-status:error then do:
     3751             create temp-archeck.
     3752             buffer-copy temp-i-archeck to temp-archeck
     3753             assign
     3754             v-line-num = (if v-sys_num = temp-i-archeck.sys_num
     3755                           then v-line-num
     3756                           else 0)
     3757             temp-archeck.line-num = v-line-num + 1
     3758             v-sys_num = temp-i-archeck.sys_num
     3759             v-line-num = v-line-num + 1
     3760             .
     3761             find first buf_temp-control where                 buf_temp-control.file_ = chr(4) + p-table  no-error .        if not available buf_temp-control then do:                                     create buf_temp-control.                                                      assign                                                                        buf_temp-control.file_ = chr(4) + p-table                             .                                                                             error-status:error = no.                                                    end.                                                                          assign                                                                        buf_temp-control.records = buf_temp-control.records + 1.
     3762           end.
     3763           if error-status:error then do:                                                  run write-log-and-file in p-log-handle (                                            input 1                                                                     , input log-file-name                                                         , input 1                                                                     , input substitute("!!!При чтении данных из файла &1 в строке &2 произошла ошибка:&3&4"                                , filename                                                                                           , var-file-line-num                                                                                  , chr(10)                                                                                      , error-status:get-message(1)                                                                          )).                                                                          assign                                                                                               p-view-log = yes                                                                                     .                                                                                                  end.
     3764         end.
     3765         when "AVCHECK":U then do:
     3766           if available temp-i-avcheck then delete temp-i-avcheck.
     3767           create temp-i-avcheck.
     3768           import stream ChkStream temp-i-avcheck no-error .
     3769           if not error-status:error then do:
     3770             create temp-avcheck.
     3771             buffer-copy temp-i-avcheck to temp-avcheck
     3772             assign
     3773             temp-avcheck.del-time = integer(temp-avcheck.realdate) +
     3774                                     0.00001 * (integer(entry(1, temp-avcheck.f_time, ":":U)) * 3600 + integer (entry(2, temp-avcheck.f_time, ":":U)) * 60 )
     3775             temp-avcheck.line-num = v-line-num + 1
     3776             v-line-num = v-line-num + 1
     3777             temp-avcheck.sys_num = 0
     3778             .
     3779             find first buf_temp-control where                 buf_temp-control.file_ = chr(4) + p-table  no-error .        if not available buf_temp-control then do:                                     create buf_temp-control.                                                      assign                                                                        buf_temp-control.file_ = chr(4) + p-table                             .                                                                             error-status:error = no.                                                    end.                                                                          assign                                                                        buf_temp-control.records = buf_temp-control.records + 1.
     3780           end.
     3781           if error-status:error then do:                                                  run write-log-and-file in p-log-handle (                                            input 1                                                                     , input log-file-name                                                         , input 1                                                                     , input substitute("!!!При чтении данных из файла &1 в строке &2 произошла ошибка:&3&4"                                , filename                                                                                           , var-file-line-num                                                                                  , chr(10)                                                                                      , error-status:get-message(1)                                                                          )).                                                                          assign                                                                                               p-view-log = yes                                                                                     .                                                                                                  end.
     3782         end.
     3783         when "CATEG":U then do:
     3784           if available temp-i-categ then delete temp-i-categ.
     3785           create temp-i-categ.
     3786           import stream ChkStream temp-i-categ no-error .
     3787           if not error-status:error then do:
     3788             create temp-categ.
     3789             buffer-copy temp-i-categ to temp-categ.
     3790             find first buf_temp-control where                 buf_temp-control.file_ = chr(4) + p-table  no-error .        if not available buf_temp-control then do:                                     create buf_temp-control.                                                      assign                                                                        buf_temp-control.file_ = chr(4) + p-table                             .                                                                             error-status:error = no.                                                    end.                                                                          assign                                                                        buf_temp-control.records = buf_temp-control.records + 1.
     3791           end.
     3792           if error-status:error then do:                                                  run write-log-and-file in p-log-handle (                                            input 1                                                                     , input log-file-name                                                         , input 1                                                                     , input substitute("!!!При чтении данных из файла &1 в строке &2 произошла ошибка:&3&4"                                , filename                                                                                           , var-file-line-num                                                                                  , chr(10)                                                                                      , error-status:get-message(1)                                                                          )).                                                                          assign                                                                                               p-view-log = yes                                                                                     .                                                                                                  end.
     3793         end.
     3794         when "CHARGES":U then do:
     3795           if available temp-i-charges then delete temp-i-charges.
     3796           create temp-i-charges.
     3797           import stream ChkStream temp-i-charges no-error .
     3798           if not error-status:error then do:
     3799             create temp-charges.
     3800             buffer-copy temp-i-charges to temp-charges.
     3801             find first buf_temp-control where                 buf_temp-control.file_ = chr(4) + p-table  no-error .        if not available buf_temp-control then do:                                     create buf_temp-control.                                                      assign                                                                        buf_temp-control.file_ = chr(4) + p-table                             .                                                                             error-status:error = no.                                                    end.                                                                          assign                                                                        buf_temp-control.records = buf_temp-control.records + 1.
     3802           end.
     3803           if error-status:error then do:                                                  run write-log-and-file in p-log-handle (                                            input 1                                                                     , input log-file-name                                                         , input 1                                                                     , input substitute("!!!При чтении данных из файла &1 в строке &2 произошла ошибка:&3&4"                                , filename                                                                                           , var-file-line-num                                                                                  , chr(10)                                                                                      , error-status:get-message(1)                                                                          )).                                                                          assign                                                                                               p-view-log = yes                                                                                     .                                                                                                  end.
     3804         end.
     3805         when "CONTROL":U then do:
     3806           if available temp-i-control then delete temp-i-control.
     3807           create temp-i-control.
     3808           import stream ChkStream temp-i-control no-error .
     3809           if not error-status:error then do:
     3810             create temp-control.
     3811             buffer-copy temp-i-control to temp-control.
     3812             find first buf_temp-control where                 buf_temp-control.file_ = chr(4) + p-table  no-error .        if not available buf_temp-control then do:                                     create buf_temp-control.                                                      assign                                                                        buf_temp-control.file_ = chr(4) + p-table                             .                                                                             error-status:error = no.                                                    end.                                                                          assign                                                                        buf_temp-control.records = buf_temp-control.records + 1.
     3813           end.
     3814           if error-status:error then do:                                                  run write-log-and-file in p-log-handle (                                            input 1                                                                     , input log-file-name                                                         , input 1                                                                     , input substitute("!!!При чтении данных из файла &1 в строке &2 произошла ошибка:&3&4"                                , filename                                                                                           , var-file-line-num                                                                                  , chr(10)                                                                                      , error-status:get-message(1)                                                                          )).                                                                          assign                                                                                               p-view-log = yes                                                                                     .                                                                                                  end.
     3815         end.
     3816         when "MENU":U then do:
     3817           if available temp-i-menu then delete temp-i-menu.
     3818           create temp-i-menu.
     3819           import stream ChkStream temp-i-menu no-error .
     3820           if not error-status:error then do:
     3821             create temp-menu.
     3822             buffer-copy temp-i-menu to temp-menu.
     3823             find first buf_temp-control where                 buf_temp-control.file_ = chr(4) + p-table  no-error .        if not available buf_temp-control then do:                                     create buf_temp-control.                                                      assign                                                                        buf_temp-control.file_ = chr(4) + p-table                             .                                                                             error-status:error = no.                                                    end.                                                                          assign                                                                        buf_temp-control.records = buf_temp-control.records + 1.
     3824           end.
     3825           if error-status:error then do:                                                  run write-log-and-file in p-log-handle (                                            input 1                                                                     , input log-file-name                                                         , input 1                                                                     , input substitute("!!!При чтении данных из файла &1 в строке &2 произошла ошибка:&3&4"                                , filename                                                                                           , var-file-line-num                                                                                  , chr(10)                                                                                      , error-status:get-message(1)                                                                          )).                                                                          assign                                                                                               p-view-log = yes                                                                                     .                                                                                                  end.
     3826         end.
     3827         when "MODIFY":u then do:
     3828           if available temp-i-modify then delete temp-i-modify.
     3829           create temp-i-modify.
     3830           import stream ChkStream temp-i-modify no-error .
     3831           if not error-status:error then do:
