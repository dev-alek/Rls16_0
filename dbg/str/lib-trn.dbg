     4392     define buffer ca_gds-dtl  for ub.gds-dtl.
     4393     define buffer ca_parts    for ub.parts.
     4394     define buffer ca_goods    for ub.goods.
     4395     define buffer ca_units    for ub.units.
     4396     define buffer ca_gds-prt  for ub.gds-prt.
     4397     define buffer ca_shop     for ub.shop.
     4398     define buffer ca_store    for ub.store.
     4399     define buffer ca_doc-pl   for ub.doc-pl.
     4400     define buffer bf_parts    for ub.parts.
     4401     define buffer ca_clients  for ub.clients.
     4402     define buffer bf_trn-doc  for ub.trn-doc.
     4403   do
     4404   on error undo, return error return-value
     4405   :
     4406     if not can-do ("cr-upd,copy", parmode) then do:
     4407       return error "Некорректный параметр parmode передан процедуре lib-trn_copy-inh.".
     4408     end.
     4409   find first ca_trn-doc where recid(ca_trn-doc) = parrec-doc.
     4410   find first ca_clients where ca_clients.obj-type = ca_trn-doc.obj-type and
     4411                               ca_clients.obj-code = ca_trn-doc.obj-code no-lock no-error.
     4412   if ca_trn-doc.out-code <> "" and ca_trn-doc.out-code <> ? then do:
     4413     find first bf_trn-doc where bf_trn-doc.doc-code = ca_trn-doc.out-code no-lock no-error.
     4414   end.
     4415   find ca_lib-trn_ret-doc.
     4416   find ca_lib-trn_ret-line.
     4417   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4418   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hold-doc in g#library
     4419     (input  ca_lib-trn_ret-doc.doc-code
     4420     ,output is-doc-hold
     4421     ) no-error .
     4422   if error-status :error or is-doc-hold = ? then do: assign is-doc-hold = no. end.
     4423   find ca_goods where ca_goods.artic        = ca_lib-trn_ret-line.artic
     4424                   and ca_goods.prod-type    = ca_lib-trn_ret-line.prod-type
     4425                   and ca_goods.prod-code    = ca_lib-trn_ret-line.prod-code no-lock.
     4426   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     4427     (
     4428        input ca_goods.artic
     4429     ,  input ca_goods.prod-type
     4430     ,  input ca_goods.prod-code
     4431     , output var_is-petrol
     4432     , output var_is-pieces
     4433     ) no-error.
     4434   if error-status :error then do:
     4435     return error substitute( 'Ошибка при определении атрибута товара "топливо".&1'
     4436                            + 'Артикул &2 &3 &4&1&7&1&8'
     4437                            , chr(10)
     4438                            , ca_goods.artic
     4439                            , ca_goods.prod-type
     4440                            , ca_goods.prod-code
     4441                            , return-value
     4442                            , error-status :get-message(1)
     4443                            ).
     4444   end.
     4445   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4446   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     4447     (input  ca_trn-doc.obj-type
     4448     ,input  ca_trn-doc.obj-code
     4449     ,input  ca_goods.artic
     4450     ,input  ca_goods.prod-type
     4451     ,input  ca_goods.prod-code
     4452     ,input  'place-rsrv=request':U
     4453     ,output l_place-rsrv
     4454     ) no-error .
     4455   if error-status :error then do:
     4456     return error substitute( 'Ошибка при определении атрибута товара на объекте.&1'
     4457                            + 'Атрибут &2&1Документ &3&1Артикул &4 &5 &6&1&7&1&8'
     4458                            , chr(10)
     4459                            , "'place-rsrv=request':U"
     4460                            , ca_lib-trn_ret-doc.doc-code
     4461                            , ca_goods.artic
     4462                            , ca_goods.prod-type
     4463                            , ca_goods.prod-code
     4464                            , return-value
     4465                            , error-status :get-message(1)
     4466                            ).
     4467   end.
     4468   RUN gds-attr-value (
     4469                       INPUT ca_goods.gds-code,
     4470                       INPUT 'mark-type':U,
     4471                       OUTPUT v-gds-attr-value,
     4472                       OUTPUT v-gds-attr-type
     4473                       ).
     4474   if v-gds-attr-value > ""
     4475   and ObjSrv:Env:ParametrsOfSection:GetSectionEDO(ca_trn-doc.obj-type, ca_trn-doc.obj-code):GetIsMarkingForType(v-gds-attr-value)
     4476   then
     4477     v-gds-mark = true .
     4478   else
     4479     v-gds-mark = false .
     4480   assign v-level = 2 .
     4481   repeat while program-name( v-level ) <> ? :
     4482     v-program-name = program-name( v-level ) .
     4483     v-is-in-doc = index(v-program-name, "in-doc.") > 0 .
     4484     if v-is-in-doc then leave .
     4485     assign
     4486       v-level = v-level + 1
     4487     .
     4488   end.
     4489   if v-gds-attr-value > ""
     4490   and v-is-in-doc
     4491   and ca_trn-doc.ext-doc-type = 'ie':U
     4492   and ObjSrv:Env:ParametrsOfSection:GetSectionEDO(ca_trn-doc.obj-type, ca_trn-doc.obj-code):IsEDO
     4493   and (ObjSrv:Env:ParametrsOfSection:GetSectionEDO(ca_trn-doc.obj-type, ca_trn-doc.obj-code):GetIsArticForType(v-gds-attr-value)
     4494     or ObjSrv:Env:ParametrsOfSection:GetSectionEDO(ca_trn-doc.obj-type, ca_trn-doc.obj-code):GetIsEdoForType(v-gds-attr-value))
     4495   then do :
     4496     return error ("Товар:" + ca_goods.artic + " " + ca_goods.prod-type + " " + string(ca_goods.prod-code) + " " + ca_goods.gds-name + " " + chr(10) +
     4497                   "нельзя добавлять в ручном режиме, так как он подлежит маркировке.") .
     4498   end .
     4499   if l_place-rsrv = yes then do:
     4500     if ca_lib-trn_ret-doc.obj-type = ca_trn-doc.obj-type
     4501       and ca_lib-trn_ret-doc.obj-code = ca_trn-doc.obj-code
     4502     then do:
     4503       assign
     4504         is_doc-pl_rsrv = yes
     4505       .
     4506     end.
     4507     else do:
     4508       assign
