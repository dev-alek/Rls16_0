     6951                                  del_trn-doc.status_, string( del_trn-doc.flag_, "+/-":U ), del_trn-doc.doc-code ).
     6952       end.
     6953         define variable is-addcharges as logical   no-undo .
     6954         define variable v-kol-rel as integer   no-undo .
     6955         define buffer buf_add-trn  for ub.add-trn  .
