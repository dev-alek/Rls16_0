     1354   define variable ptrlprop-trn-reas-sug as logical no-undo init true.
     1355   define variable ptrlprop-rvd-own-nb as logical no-undo init false.
     1356   define variable ptrlprop-qr-scan-time as integer no-undo init 5000 .
     1357   define variable ptrlprop-block-nozzle as logical no-undo init false.
     1358   define variable ptrlprop-timeout-block-nozzle as integer no-undo init 5 .
     1359   define variable ptrlprop-autopump-skip-time as integer no-undo init 0 .
     1360   procedure get-ptrl-prop :
     1361     define input  parameter p-obj-type as character no-undo .
     1362     define input  parameter p-obj-code as integer   no-undo .
     1363     do
     1364     on error  undo, return error substitute( "&1 (get-ptrl-prop). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1365     on stop   undo, return error substitute( "&1 (get-ptrl-prop). stop", vss-workfile )
     1366     on endkey undo, return error substitute( "&1 (get-ptrl-prop). endkey", vss-workfile )
     1367     :
     1368       define variable par-type          as character no-undo.
     1369       define variable v-value-character as character no-undo .
     1370       define variable v-value-date      as date      no-undo .
     1371       define variable v-value-decimal   as decimal   no-undo .
     1372       define variable v-value-integer   as integer   no-undo .
     1373       define variable v-value-logical   as logical   no-undo .
     1374       for each thbjattr_thbj-attr
     1375       :
     1376         delete thbjattr_thbj-attr .
     1377       end.
     1378       run adm/shattri.p
     1379         ( input "get":U
     1380         , input p-obj-type
     1381         , input p-obj-code
     1382         , input 'petrol':U
     1383         , input  ""
     1384         , output v-value-character
     1385         , output v-value-date
     1386         , output v-value-decimal
     1387         , output v-value-integer
     1388         , output v-value-logical
     1389         , output par-type
     1390         , input-output table thbjattr_thbj-attr
     1391         ) no-error .
     1392       for each thbjattr_thbj-attr
     1393       on error undo, return error return-value
     1394       :
     1395         case thbjattr_thbj-attr.prop-code :
     1396           when 'denstclc':U then do:
     1397             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
     1398               assign
     1399                 ptrlprop-denstclc = thbjattr_thbj-attr.property-value-character
     1400               .
     1401             end.
     1402           end.
     1403           when 'expptrl':U then do:
     1404             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
     1405               and thbjattr_thbj-attr.prop-value-type = 'character':U
     1406             then do:
     1407               assign
     1408                 ptrlprop-expptrl = thbjattr_thbj-attr.property-value-character
     1409               .
     1410             end.
     1411           end.
     1412           when 'inpptrl':U then do:
     1413             if lookup( thbjattr_thbj-attr.property-value-character, 'volume,weight,volume+,weight+':U ) > 0
     1414               and thbjattr_thbj-attr.prop-value-type = 'character':U
     1415             then do:
     1416               assign
     1417                 ptrlprop-inpptrl = thbjattr_thbj-attr.property-value-character
     1418               .
     1419             end.
     1420           end.
     1421           when 'autopump':U then do:
     1422             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1423               assign
     1424                 ptrlprop-autopump = thbjattr_thbj-attr.property-value-logical
     1425               .
     1426             end.
     1427           end.
     1428           when 'rvsnmter':U then do:
     1429             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1430               assign
     1431                 ptrlprop-rvsnmter = thbjattr_thbj-attr.property-value-logical
     1432               .
     1433             end.
     1434           end.
     1435           when 'avtinvpm':U then do:
     1436             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1437               assign
     1438                 ptrlprop-avtinvpm = thbjattr_thbj-attr.property-value-logical
     1439               .
     1440             end.
     1441           end.
     1442           when 'invclipt':U then do:
     1443             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1444               assign
     1445                 ptrlprop-invclipt = thbjattr_thbj-attr.property-value-integer
     1446               .
     1447             end.
     1448           end.
     1449           when 'olddens':U then do:
     1450             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1451               assign
     1452                 ptrlprop-olddens = thbjattr_thbj-attr.property-value-logical
     1453               .
     1454             end.
     1455           end.
     1456           when 'algrvspt':U then do:
     1457             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1458               assign
     1459                 ptrlprop-algrvspt = thbjattr_thbj-attr.property-value-integer
     1460               .
     1461             end.
     1462           end.
     1463           when 'temp-for-pomi':U then do:
     1464             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1465               assign
     1466                 ptrlprop-temp-for-pomi = thbjattr_thbj-attr.property-value-integer
     1467               .
     1468             end.
     1469           end.
     1470           when 'algoincome':U then do:
     1471             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1472               assign
     1473                 ptrlprop-algoincome = thbjattr_thbj-attr.property-value-integer
     1474               .
     1475             end.
     1476           end.
     1477           when 'mand-choice-autocar':U then do:
     1478             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1479               assign
     1480                 ptrlprop-mand-choice-autocar = thbjattr_thbj-attr.property-value-logical
     1481               .
     1482             end.
     1483           end.
     1484           when 'block-nozzle':U then do:
     1485             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1486               assign
     1487                 ptrlprop-block-nozzle = thbjattr_thbj-attr.property-value-logical
     1488               .
     1489             end.
     1490           end.
     1491           when 'timeout-block-nozzle':U then do:
     1492             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1493               assign
     1494                 ptrlprop-timeout-block-nozzle = thbjattr_thbj-attr.property-value-integer
     1495               .
     1496             end.
     1497           end.
     1498           when 'Delta-mass-horiz':U then do:
     1499             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
     1500               assign
     1501                 ptrlprop-Delta-mass-horiz = thbjattr_thbj-attr.property-value-character
     1502               .
     1503             end.
     1504           end.
     1505           when 'Delta-mass-vert':U then do:
     1506             if thbjattr_thbj-attr.prop-value-type = 'character':U then do:
     1507               assign
     1508                 ptrlprop-Delta-mass-vert = thbjattr_thbj-attr.property-value-character
     1509               .
     1510             end.
     1511           end.
     1512           when 'calc-free-vol':U then do:
     1513             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1514               assign
     1515                 ptrlprop-calc-free-vol = thbjattr_thbj-attr.property-value-logical
     1516               .
     1517             end.
     1518           end.
     1519           when 'calc-free-vol-sug':U then do:
     1520             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1521               assign
     1522                 ptrlprop-calc-free-vol-sug = thbjattr_thbj-attr.property-value-logical
     1523               .
     1524             end.
     1525           end.
     1526           when 'trn-reas-sug':U then do:
     1527             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1528               assign
     1529                 ptrlprop-trn-reas-sug = thbjattr_thbj-attr.property-value-logical
     1530               .
     1531             end.
     1532           end.
     1533                 when 'rvd-own-nb':U then do:
     1534             if thbjattr_thbj-attr.prop-value-type = 'logical':U then do:
     1535               assign
     1536                 ptrlprop-rvd-own-nb = thbjattr_thbj-attr.property-value-logical
     1537               .
     1538             end.
     1539           end.
     1540           when 'qr-scan-time':U then do:
     1541             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1542               assign
     1543                 ptrlprop-qr-scan-time = thbjattr_thbj-attr.property-value-integer
     1544               .
     1545             end.
     1546           end.
     1547           when 'autopump-skip-time':U then do:
     1548             if thbjattr_thbj-attr.prop-value-type = 'integer':U then do:
     1549               assign
     1550                 ptrlprop-autopump-skip-time = thbjattr_thbj-attr.property-value-integer
     1551               .
     1552             end.
     1553           end.
     1554         end case.
     1555         delete thbjattr_thbj-attr .
     1556       end.
     1557     end.
     1558     return .
     1559   end procedure.
     1560   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1561   procedure gds-attr-name :
     1562     define input  parameter p-code           as character no-undo .
     1563     define output parameter p-type           as character no-undo .
     1564     define output parameter p-format         as character no-undo .
     1565     define output parameter p-label          as character no-undo .
     1566     define output parameter p-user-can-edit  as logical   no-undo .
     1567     define output parameter p-output-display as logical   no-undo .
     1568     define output parameter p-other          as character no-undo .
     1569     do
     1570     on error undo, return error
     1571     :
     1572           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-name in g#attr-lib
     1573         (input  p-code
     1574         ,output p-type
     1575         ,output p-format
     1576         ,output p-label
     1577         ,output p-user-can-edit
     1578         ,output p-output-display
     1579         ,output p-other
     1580         ) no-error .
     1581       if error-status :error
     1582       then do:
     1583         undo, return error return-value .
     1584       end.
     1585     end.
     1586   end procedure.
