     6640   end.
     6641   end procedure.
     6642   procedure lib-trn_crdoclin:
     6643     define input parameter pardoc-code      like ub.doc-line.doc-code     no-undo.
     6644     define input parameter parartic         like ub.doc-line.artic        no-undo.
     6645     define input parameter parprod-type     like ub.doc-line.prod-type    no-undo.
     6646     define input parameter parprod-code     like ub.doc-line.prod-code    no-undo.
     6647     define input parameter parobj-type      like ub.doc-line.obj-type     no-undo.
     6648     define input parameter parobj-code      like ub.doc-line.obj-code     no-undo.
     6649     define input parameter parstatus_       like ub.doc-line.status_      no-undo.
     6650     define input parameter parext-doc-type  like ub.doc-line.ext-doc-type no-undo.
     6651     define input parameter parprt-root      like ub.doc-line.prt-root     no-undo.
     6652     define input parameter parvat-pc        like ub.doc-line.vat-pc       no-undo.
     6653     define input parameter parslt-pc        like ub.doc-line.slt-pc       no-undo.
     6654     define input parameter parcons-vat-pc   like ub.doc-line.cons-vat-pc  no-undo.
     6655     do transaction
     6656     on error undo, return error return-value
     6657     :
     6658       define variable varis-petrolium as logical no-undo.
     6659       define variable varis-pieces    as logical no-undo.
     6660       define buffer cr_doc-line for ub.doc-line.
     6661       define buffer last_doc-line for ub.doc-line.
     6662       define variable varline-num as integer no-undo.
     6663       define variable rec-inv-line as recid no-undo.
     6664       find last last_doc-line where last_doc-line.doc-code = pardoc-code use-index line-num no-lock no-error.
     6665       if not available last_doc-line then do:
     6666         assign varline-num = 1.
     6667       end.
     6668       else do:
     6669         assign varline-num = last_doc-line.line-num + 1.
     6670       end.
     6671       find first cr_doc-line where cr_doc-line.doc-code  = pardoc-code  and
     6672                                   cr_doc-line.artic     = parartic     and
     6673                                   cr_doc-line.prod-type = parprod-type and
     6674                                   cr_doc-line.prod-code = parprod-code no-error.
     6675       if not available cr_doc-line then do:
     6676         run check-use-artic in this-procedure ( input "doc-line":U,
     6677                                                 input parartic,
     6678                                                 input parprod-type,
     6679                                                 input parprod-code  ) no-error.
     6680         if error-status :error then do:
     6681           undo, return error substitute( 'lib-trn_crdoclin: &1', return-value ).
     6682         end.
     6683         create cr_doc-line.
     6684         assign
     6685           cr_doc-line.doc-code      =  pardoc-code
     6686           cr_doc-line.artic         =  parartic
     6687           cr_doc-line.prod-type     =  parprod-type
     6688           cr_doc-line.prod-code     =  parprod-code
     6689           cr_doc-line.obj-type      =  parobj-type
     6690           cr_doc-line.obj-code      =  parobj-code
     6691           cr_doc-line.status_       =  parstatus_
     6692           cr_doc-line.ext-doc-type  =  parext-doc-type
     6693           cr_doc-line.prt-root      =  parprt-root
     6694           cr_doc-line.vat-pc        =  parvat-pc
     6695           cr_doc-line.slt-pc        =  parslt-pc
     6696           cr_doc-line.cons-vat-pc   =  parcons-vat-pc
     6697           cr_doc-line.line-num      =  varline-num
     6698           .
     6699         if ( cr_doc-line.cli-base-rate = 0 or cr_doc-line.cli-base-rate = ? )
     6700           then
     6701           cr_doc-line.cli-base-rate = 1 .
     6702       end.
     6703   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_corinvln in g#lib-trn3
     6704   ( input  pardoc-code
     6705    ,input  parartic
     6706    ,input  parprod-type
     6707    ,input  parprod-code
     6708    ,input  ?
     6709    ,input  ?
     6710    ,input  ?
     6711    ,input  ?
     6712    ,input  ?
     6713    ,input  ?
     6714    ,output rec-inv-line
     6715    ) no-error.
