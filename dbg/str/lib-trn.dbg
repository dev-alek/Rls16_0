     3683       find tc_sysconf where tc_sysconf.host-code = tc_store.host-code no-lock.
     3684     end.
     3685     else do:
     3686       find tc_shop where tc_shop.obj-code = tc_trn-doc.obj-code no-lock.
     3687       assign
     3688         v-inout-price = tc_shop.inout-price.
     3689       find tc_sysconf where tc_sysconf.host-code = tc_shop.host-code no-lock.
     3690     end.
     3691     assign
     3692            v-cash-pay  = tc_sysconf.cash-pay.
