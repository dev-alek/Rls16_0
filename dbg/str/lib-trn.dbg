     7864           v-kol-trn-fo = 0.
     7865           for each del_fin-ob-trn where del_fin-ob-trn.trn-doc-code = del_trn-doc.doc-code  and
     7866                                         del_fin-ob-trn.host-code    = del_trn-doc.host-code exclusive-lock,
