      356   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      357   define new global shared variable g#trdcalib as handle no-undo.
      358   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      359   function octal-to-char return character
      360   ( p-string as character ) :
      361     def var v-asc     as integer no-undo .
      362     def var v-new-asc as integer no-undo .
      363     def var ind       as integer no-undo .
      364     if length(p-string) <> 3 then do:
      365       return ? .
      366     end.
      367     assign
      368       v-asc = 0
      369     .
      370     do ind = 1 to length(p-string)
      371     :
      372       assign
      373         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      374       .
      375       if v-new-asc < 0 or v-new-asc >= 8 then do:
      376         return ? .
      377       end.
      378       assign
      379         v-asc = v-asc * 8 + v-new-asc
      380       .
      381     end.
      382     return chr(v-asc) .
      383   end function .
      384   function char-to-octal return character
      385   ( p-chr as character ) :
      386     def var v-asc    as integer   no-undo .
      387     def var ind      as integer   no-undo .
      388     def var v-string as character no-undo .
      389     if length(p-chr) <> 1 then do:
      390       return ? .
      391     end.
      392     assign
      393       v-asc    = asc(p-chr)
      394       v-string = ""
      395     .
      396     do ind = 1 to 3
      397     :
      398       assign
      399         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      400       .
      401       assign
      402         v-asc = truncate(v-asc / 8, 0)
      403       .
      404     end.
      405     return v-string .
      406   end.
      407   function str-encode return character
      408   (   p-init-string       as character
      409     , p-encode-char       as character
      410     , p-special-char-list as character
      411   ) :
      412     def var p-encode-string as character no-undo .
      413     def var ind                as integer no-undo .
      414     def var v-num-special-char as integer no-undo .
      415     def var v-special-char     as character no-undo .
      416     if p-encode-char = ?
      417     or p-encode-char = "" then do:
      418       assign
      419         p-encode-char = "~~"
      420       .
      421     end.
      422     if p-init-string = ? then do:
      423       return "?" .
      424     end.
      425     if p-init-string = "?" then do:
      426       return p-encode-char + char-to-octal("?") .
      427     end.
      428     assign
      429       v-num-special-char = length(p-special-char-list)
      430       p-encode-string    = replace(p-init-string
      431                                   ,p-encode-char
      432                                   ,p-encode-char + char-to-octal(p-encode-char)
      433                                   )
      434     .
      435     do ind = 1 to v-num-special-char
      436     :
      437       assign
      438         v-special-char = substring(p-special-char-list, ind, 1)
      439       .
      440       if v-special-char <> p-encode-char then do:
      441         assign
      442           p-encode-string = replace (p-encode-string
      443                                     ,v-special-char
      444                                     ,p-encode-char + char-to-octal(v-special-char)
      445                                     )
      446         .
      447       end.
      448     end.
      449     return p-encode-string .
      450   end.
      451   function str-decode returns character
      452     (p-init-string   as character
      453     ,p-encode-char   as character
      454     ) :
      455     def var p-decode-string as character no-undo .
      456     def var ind                       as integer no-undo .
      457     def var v-num-entries-init-string as integer no-undo .
      458     def var v-sub-phrase              as character no-undo .
      459     def var v-special-char            as character no-undo .
      460     if p-encode-char = ?
      461     or p-encode-char = "" then do:
      462       assign
      463         p-encode-char = "~~"
      464       .
      465     end.
      466     if p-init-string = "?" then do:
      467       return ? .
      468     end.
      469     assign
      470       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      471     .
      472     if v-num-entries-init-string > 1 then do:
      473       assign
      474         p-decode-string = entry(1, p-init-string, p-encode-char)
      475       .
      476       do ind = 2 to v-num-entries-init-string
      477       :
      478         assign
      479           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      480         .
      481         assign
      482           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      483         .
      484         if v-special-char <> ? then do:
      485           assign
      486             p-decode-string = p-decode-string
      487                             + v-special-char
      488                             + substring(v-sub-phrase, 4)
      489           .
      490         end.
      491         else do:
      492           assign
      493             p-decode-string = p-decode-string
      494                             + p-encode-char
      495                             + v-sub-phrase
      496           .
      497         end.
      498       end.
      499     end.
      500     else do:
      501       assign
      502         p-decode-string = p-init-string
      503       .
      504     end.
      505     return p-decode-string .
      506   end.
      507   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      508   define temp-table lib-trn_ret-doc       no-undo like ub.trn-doc.
      509   define temp-table lib-trn_ret-line      no-undo like ub.doc-line
      510     field cst-code                like ub.trn-doc.cst-code
      511     field part-code               like ub.parts.part-code
      512     .
      513   define temp-table lib-trn_ret-line-attr no-undo like ub.doc-line-attr.
      514   define temp-table lib-trn_ret-dtl       no-undo like ub.gds-dtl.
      515   define temp-table lib-trn_ret-parts     no-undo like ub.parts.
      516   function hvrdtax return logical (input parrecid as recid):
      517   define variable varresult as logical no-undo.
      518   run hvrdtax-proc (input parrecid, output varresult).
      519   return varresult.
      520   end function.
      521   procedure hvrdtax-proc:
      522   define input  parameter parrecid  as recid   no-undo.
      523   define output parameter parresult as logical no-undo.
      524   define buffer bf_goods for ub.goods.
      525   define buffer bf_units for ub.units.
      526   define buffer rt_tax   for ub.tax.
      527   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      528   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      529   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      530   if available rt_tax and
      531       can-find(first ub.tax-units No-LOCK WHERE
      532                      ub.tax-units.tax-code = rt_tax.tax-code AND
      533                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      534                                                       else assign parresult = no.
      535   end procedure.
      536   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      537   define new global shared variable g#lib-calc as handle no-undo .
      538   procedure plgdsfnd :
      539     define input  parameter p-chk-and-chs    as logical               no-undo .
      540     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
      541     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
      542     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
      543     define output parameter p-reserv-pl-code as   logical             no-undo .
      544     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
      545     define buffer buf_goods         for ub.goods .
      546     define buffer buf_pl-gds        for ub.pl-gds .
      547     define buffer buf_second_pl-gds for ub.pl-gds .
      548     find first buf_goods no-lock where
      549                buf_goods.gds-code = p-gds-code no-error .
      550     if not available buf_goods
      551     then do:
      552       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
      553     end.
      554   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      555   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
      556     (input  p-obj-type
      557     ,input  p-obj-code
      558     ,input  buf_goods.artic
      559     ,input  buf_goods.prod-type
      560     ,input  buf_goods.prod-code
      561     ,input  'place-rsrv=request'
      562     ,output p-reserv-pl-code
      563     ) no-error .
      564     if error-status :error
      565     then do:
      566       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
      567     end.
      568     if p-reserv-pl-code = no
      569     then do:
      570       return .
      571     end.
      572     if p-chk-and-chs <> yes
      573     then do:
      574       return .
      575     end.
      576     find first buf_pl-gds no-lock where
      577                buf_pl-gds.obj-type = p-obj-type and
      578                buf_pl-gds.obj-code = p-obj-code and
      579                buf_pl-gds.gds-code = p-gds-code no-error .
      580     if not available buf_pl-gds
      581     then do:
      582       return error "К товару не привязано ни одного места хранения" .
      583     end.
      584     find first buf_second_pl-gds no-lock where
      585                buf_second_pl-gds.obj-type  = p-obj-type          and
      586                buf_second_pl-gds.obj-code  = p-obj-code          and
      587                buf_second_pl-gds.gds-code  = p-gds-code          and
      588                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
      589     if not available buf_second_pl-gds
      590     then do:
      591       assign
      592         p-pl-code = buf_pl-gds.pl-code
      593       .
      594     end.
      595     else do:
      596       return error "Не выбрано место хранения " + chr(10) .
      597     end.
      598   end procedure.
      599   define variable vss-include-info6 as character format "X(65)":U no-undo initial "@(#)$Workfile$ $Revision$".
      600   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      601   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
      602   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
      603   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
      604   ASSIGN
      605      v-S_CONTRACT                = "Contract":U
      606      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
      607      v-DELIM_CHR_3               = ","
      608      .
      609   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
      610   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
      611   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
      612   FUNCTION Can-Find-Spec RETURN LOGICAL (
      613      INPUT iHost-Code    AS INTEGER,
      614      INPUT iContract-Num AS INTEGER,
      615      INPUT iGds-Code     AS INTEGER ):
      616      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
      617      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
      618      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
      619      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
      620      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
      621      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
      622          INPUT  iHost-Code,
      623          INPUT  iContract-Num,
      624          OUTPUT iTmp-Extent3
      625          ).
      626      IF iTmp-Extent3[1] = 2 THEN DO:
      627         ASSIGN
      628            iTmp-Host-Code      = iTmp-Extent3[2]
      629            iTmp-Contract-Num   = iTmp-Extent3[3]
      630            .
      631      END. ELSE DO:
      632         ASSIGN
      633            iTmp-Host-Code      = iHost-Code
      634            iTmp-Contract-Num   = iContract-Num
      635            .
      636      END.
      637      IF iGds-Code = ? THEN DO:
      638         ASSIGN
      639            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
      640                                  buf_Spec.Host-Code     = iTmp-Host-Code
      641                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
      642                           ).
      643      END. ELSE DO:
      644            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
      645                                  buf_Spec.Host-Code     = iTmp-Host-Code
      646                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
      647                              AND buf_Spec.Gds-Code      = iGds-Code
      648                            ).
      649      END.
      650      RETURN (lRet).
      651   END FUNCTION.
      652   PROCEDURE MS-Contract-EXTENT-3:
      653      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
      654      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
      655      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
      656      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
      657      DEFINE BUFFER buf_Cont        FOR ub.Contract.
      658      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
      659      FIND FIRST buf_Cont-2 WHERE
      660                 buf_Cont-2.Host-Code      = i-Host-Code
      661             AND buf_Cont-2.Contract-Code  = i-Contract-Code
      662           NO-LOCK NO-ERROR.
      663      IF NOT AVAILABLE buf_Cont-2 THEN DO:
      664         RETURN.
      665      END.
      666      FOR FIRST buf_Ext-Classif WHERE
      667                buf_Ext-Classif.Classif-name = v-S_CONTRACT
      668           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
      669                                               STRING(i-Contract-code)
      670           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
      671          NO-LOCK,
      672          EACH buf_Cont WHERE
      673               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
      674           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
      675          NO-LOCK:
      676          ASSIGN
      677             i-Ret[1] = 1
      678             i-Ret[2] = buf_Cont.Host-code
      679             i-Ret[3] = buf_Cont.Contract-code
      680             .
      681          LEAVE.
      682      END.
      683      IF i-Ret[1] <> 1 THEN DO:
      684         FOR FIRST buf_Ext-Classif WHERE
      685                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
      686              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
      687                                                  STRING(i-Contract-code)
      688              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
      689             NO-LOCK,
      690             EACH buf_Cont WHERE
      691                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
      692              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
      693             NO-LOCK:
      694             ASSIGN
      695                i-Ret[1] = 2
      696                i-Ret[2] = buf_Cont.Host-code
      697                i-Ret[3] = buf_Cont.Contract-code
      698                .
      699             LEAVE.
      700         END.
      701      END.
      702      RETURN.
      703   END PROCEDURE.
      704   procedure cpprclig :
      705     define input        parameter pardoc-code       as   character                  no-undo.
      706     define input        parameter parcli-code       like ub.trn-doc.cli-code        no-undo.
      707     define input        parameter parcli-type       like ub.trn-doc.cli-type        no-undo.
      708     define input        parameter parhost-code      like ub.trn-doc.host-code       no-undo.
      709     define input        parameter parbase-rate      like ub.trn-doc.base-rate       no-undo.
      710     define input        parameter parbase-scale     like ub.trn-doc.base-scale      no-undo.
      711     define input        parameter parexch-rate      like ub.trn-doc.exch-rate       no-undo.
      712     define input        parameter parexch-scale     like ub.trn-doc.exch-scale      no-undo.
      713     define input        parameter parvat-type       like ub.trn-doc.vat-type        no-undo.
      714     define input        parameter parslt-type       like ub.trn-doc.slt-type        no-undo.
      715     define input        parameter parartic          like ub.doc-line.artic          no-undo.
      716     define input        parameter parprod-type      like ub.doc-line.prod-type      no-undo.
      717     define input        parameter parprod-code      like ub.doc-line.prod-code      no-undo.
      718     define input        parameter paris-cli-tax     as   logical                    no-undo.
      719     define input        parameter parcli-base-rate  like ub.doc-line.cli-base-rate  no-undo.
      720     define input        parameter partransport-rubl like ub.doc-line.transport-rubl no-undo.
      721     define input        parameter parother-rubl     like ub.doc-line.other-rubl     no-undo.
      722     define output       parameter parprice-cli      like ub.doc-line.price-cli      no-undo.
      723     define output       parameter parprice-base     like ub.doc-line.price-base     no-undo.
      724     define output       parameter parprice-rubl     like ub.doc-line.price-rubl     no-undo.
      725     define input-output parameter parvat-pc         like ub.doc-line.vat-pc         no-undo.
      726     define input-output parameter parslt-pc         like ub.doc-line.slt-pc         no-undo.
      727     define input-output parameter parroad-tax       like ub.doc-line.road-tax       no-undo.
      728     define input-output parameter parexcise         like ub.doc-line.excise         no-undo.
      729     define variable varprice-cli                like ub.doc-line.price-rubl no-undo.
      730     define variable varprice-cli-unit-base      like ub.doc-line.price-rubl no-undo.
      731     define variable varprice-road-tax           like ub.doc-line.price-rubl no-undo.
      732     define variable varprice-other-exp          like ub.doc-line.price-rubl no-undo.
      733     define variable varprice-transport-exp      like ub.doc-line.price-rubl no-undo.
      734     define variable varprice-without-abs        like ub.doc-line.price-rubl no-undo.
      735     define variable varprice-slt                like ub.doc-line.price-rubl no-undo.
      736     define variable varprice-no-slt             like ub.doc-line.price-rubl no-undo.
      737     define variable varprice-vat                like ub.doc-line.price-rubl no-undo.
      738     define variable varprice-no-vat-slt         like ub.doc-line.price-rubl no-undo.
      739     define variable varprice-rubl               like ub.doc-line.price-rubl no-undo.
      740     define variable varprice-road-tax-rubl      like ub.doc-line.price-rubl no-undo.
      741     define variable varprice-other-exp-rubl     like ub.doc-line.price-rubl no-undo.
      742     define variable varprice-transport-exp-rubl like ub.doc-line.price-rubl no-undo.
      743     define variable varprice-without-abs-rubl   like ub.doc-line.price-rubl no-undo.
      744     define variable varprice-slt-rubl           like ub.doc-line.price-rubl no-undo.
      745     define variable varprice-no-slt-rubl        like ub.doc-line.price-rubl no-undo.
      746     define variable varprice-vat-rubl           like ub.doc-line.price-rubl no-undo.
      747     define variable varprice-no-vat-slt-rubl    like ub.doc-line.price-rubl no-undo.
      748     define variable varprice-base               like ub.doc-line.price-base no-undo.
      749     define variable varprice-road-tax-base      like ub.doc-line.price-base no-undo.
      750     define variable varprice-other-exp-base     like ub.doc-line.price-base no-undo.
      751     define variable varprice-transport-exp-base like ub.doc-line.price-base no-undo.
      752     define variable varprice-without-abs-base   like ub.doc-line.price-base no-undo.
      753     define variable varprice-slt-base           like ub.doc-line.price-base no-undo.
      754     define variable varprice-no-slt-base        like ub.doc-line.price-base no-undo.
      755     define variable varprice-vat-base           like ub.doc-line.price-base no-undo.
      756     define variable varprice-no-vat-slt-base    like ub.doc-line.price-base no-undo.
      757     define variable v-specif-found              as   logical                no-undo.
      758     define variable v-rcv-found                 as   logical                no-undo .
      759     define buffer bf_cli-gds         for ub.cli-gds .
      760     define buffer bf_doc-line        for ub.doc-line.
      761     define buffer bf_trn-doc         for ub.trn-doc.
      762     define buffer bf_goods           for ub.goods.
      763     define buffer bf_contract-specif for ub.contract-specif.
      764     define buffer buf_ord-chain      for ub.ord-chain .
      765     define buffer buf_ord-doc-rcv    for ub.ord-doc-rcv .
      766     define buffer buf_ord-line-rcv   for ub.ord-line-rcv .
      767     do
      768     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info6, return-value, chr(10), error-status :get-message ( 1 ) )
      769     on stop   undo, return error substitute( "&1. stop", vss-include-info6 )
      770     on endkey undo, return error substitute( "&1. endkey", vss-include-info6 )
      771     :
      772       assign
      773         v-rcv-found    = false
      774         v-specif-found = false
      775       .
      776       find first buf_ord-chain no-lock
      777         where buf_ord-chain.rel-doc-code =  pardoc-code
      778           and buf_ord-chain.rel-doc-type = 'trn':u
      779         no-error .
      780       if available buf_ord-chain then do:
      781         find first buf_ord-doc-rcv no-lock
      782           where buf_ord-doc-rcv.rcv-code = buf_ord-chain.doc-code
      783         no-error .
      784         if available buf_ord-doc-rcv then do:
      785           find first buf_ord-line-rcv no-lock
      786             where buf_ord-line-rcv.doc-code  = buf_ord-doc-rcv.doc-code
      787               and buf_ord-line-rcv.artic     = parartic
      788               and buf_ord-line-rcv.prod-type = parprod-type
      789               and buf_ord-line-rcv.prod-code = parprod-code
      790             no-error .
      791           if available buf_ord-line-rcv then do:
      792             find first bf_trn-doc  no-lock
      793               where bf_trn-doc.doc-code = pardoc-code
      794             .
      795             assign
      796               parprice-cli = buf_ord-line-rcv.price-cli
      797               parroad-tax  = buf_ord-line-rcv.road-tax
      798               parexcise    = buf_ord-line-rcv.excise
      799               v-rcv-found  = true
      800               .
      801             if parslt-type <> 'без':U then do:
      802               if bf_trn-doc.slt-type <> 'без':U then do:
      803                 assign
      804                   parslt-pc = buf_ord-line-rcv.slt-pc
      805                 .
      806               end.
      807             end.
      808             else do:
      809               assign
      810                 parslt-pc = 0
      811               .
      812             end.
      813             if parvat-type <> 'без':U then do:
      814               if bf_trn-doc.vat-type <> 'без':U then do:
      815                 assign
      816                   parvat-pc = buf_ord-line-rcv.vat-pc
      817                 .
      818               end.
      819             end.
      820             else do:
      821               assign
      822                 parvat-pc = 0
      823               .
      824             end.
      825           end.
      826         end.
      827       end.
      828       if v-rcv-found = false then do:
      829         find first bf_trn-doc no-lock
      830           where bf_trn-doc.doc-code = pardoc-code
      831           no-error.
      832         if available bf_trn-doc
      833           and bf_trn-doc.contract-code <> 0
      834         then do:
      835           find first bf_goods no-lock
      836             where bf_goods.artic     = parartic
      837               and bf_goods.prod-code = parprod-code
      838               and bf_goods.prod-type = parprod-type
      839             no-error.
      840           if available bf_goods then do:
      841   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      842   ASSIGN
      843      i-gl-Host-Code      = 0
      844      i-gl-Contract-Code  = 0
      845      i-gl-Extent3        = 0
      846      .
      847   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
      848       INPUT  bf_trn-doc.host-code,
      849       INPUT  bf_trn-doc.contract-code,
      850       OUTPUT i-gl-Extent3
      851      ).
      852   IF i-gl-Extent3[1] = 2 THEN DO:
      853      ASSIGN
      854         i-gl-Host-Code      = i-gl-Extent3[2]
      855         i-gl-Contract-Code  = i-gl-Extent3[3]
      856         .
      857   END. ELSE DO:
      858      ASSIGN
      859         i-gl-Host-Code      = bf_trn-doc.host-code
      860         i-gl-Contract-Code  = bf_trn-doc.contract-code
      861         .
      862   END.
      863       FIND FIRST bf_contract-specif
      864              NO-LOCK
      865              WHERE
      866                  bf_contract-specif.Host-code    = i-gl-Host-Code
      867              AND bf_contract-specif.Contract-num = i-gl-Contract-Code
      868              AND bf_contract-specif.Gds-code     = bf_goods.gds-code
      869              NO-ERROR
      870              .
      871             if available bf_contract-specif then do:
      872               assign
      873                 parprice-cli   = (bf_contract-specif.price-cli / bf_contract-specif.cli-base-rate)  * parcli-base-rate
      874                 parvat-type    = bf_contract-specif.vat-type
      875                 parvat-pc      = bf_contract-specif.vat-pc
      876                 v-specif-found = yes
      877               .
      878             end.
      879           end.
      880         end.
      881         find first bf_cli-gds no-lock
      882           where bf_cli-gds.cli-code  = parcli-code
      883             and bf_cli-gds.cli-type  = parcli-type
      884             and bf_cli-gds.host-code = parhost-code
      885             and bf_cli-gds.artic     = parartic
      886             and bf_cli-gds.prod-code = parprod-code
      887             and bf_cli-gds.prod-type = parprod-type
      888           no-error.
      889         if available bf_cli-gds then do:
      890           if v-specif-found = false then do:
      891             assign
      892               parprice-cli = bf_cli-gds.price-cli
      893             .
      894           end.
      895           if paris-cli-tax then do:
      896             find first bf_doc-line no-lock
      897               where bf_doc-line.doc-code  = bf_cli-gds.in-code
      898                 and bf_doc-line.artic     = bf_cli-gds.artic
      899                 and bf_doc-line.prod-type = bf_cli-gds.prod-type
      900                 and bf_doc-line.prod-code = bf_cli-gds.prod-code
      901               no-error.
      902             if available bf_doc-line then do:
      903               find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
      904               assign
      905                 parroad-tax = bf_doc-line.road-tax
      906                 parexcise   = bf_doc-line.excise
      907               .
      908               if parslt-type <> 'без':U then do:
      909                 if bf_trn-doc.slt-type <> 'без':U then do:
      910                   assign
      911                     parslt-pc = bf_doc-line.slt-pc
      912                   .
      913                 end.
      914               end.
      915               else do:
      916                 assign
      917                   parslt-pc = 0
      918                 .
      919               end.
      920               if parvat-type <> 'без':U then do:
      921                 if bf_trn-doc.vat-type <> 'без':U then do:
      922                   if v-specif-found = false then do:
      923                     assign
      924                       parvat-pc = bf_doc-line.vat-pc
      925                     .
      926                   end.
      927                 end.
      928               end.
      929               else do:
      930                 assign
      931                   parvat-pc = 0
      932                 .
      933               end.
      934             end.
      935           end.
      936         end.
      937       end.
      938   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_in-vat in g#lib-trn
      939     (
