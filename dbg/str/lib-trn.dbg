     2187   procedure lib-trn_acc-cost:
     2188   define input  parameter parobj-type                      like ub.doc-line.obj-type      no-undo.
     2189   define input  parameter parobj-code                      like ub.doc-line.obj-code      no-undo.
     2190   define input  parameter pardoc-code                      like ub.doc-line.doc-code      no-undo.
     2191   define input  parameter parartic                         like ub.doc-line.artic         no-undo.
     2192   define input  parameter parprod-type                     like ub.doc-line.prod-type     no-undo.
     2193   define input  parameter parprod-code                     like ub.doc-line.prod-code     no-undo.
     2194   define input  parameter parcli-qnty                      like ub.doc-line.cli-qnty      no-undo.
     2195   define input  parameter pardoc-qnty                      like ub.doc-line.doc-qnty      no-undo.
     2196   define input  parameter parfact-qnty                     like ub.doc-line.fact-qnty     no-undo.
     2197   define input  parameter parprice-base                    like ub.doc-line.price-base    no-undo.
     2198   define input  parameter parprice-rubl                    like ub.doc-line.price-rubl    no-undo.
     2199   define input  parameter parmode                          as   character                 no-undo.
     2200   define output parameter partotal-doc-line_tot-ov         like ub.trn-doc.tot-ov         no-undo.
     2201   define output parameter partotal-doc-line_fact-rubl      like ub.trn-doc.fact-rubl      no-undo.
     2202   define output parameter partotal-doc-line_fact-base      like ub.trn-doc.fact-base      no-undo.
     2203   define output parameter partotal-doc-line_fact-qnty      like ub.trn-doc.fact-qnty      no-undo.
     2204   define output parameter partotal-doc-line_doc-qnty       like ub.trn-doc.doc-qnty       no-undo.
     2205   define output parameter partotal-doc-line_cli-qnty       like ub.trn-doc.cli-qnty       no-undo.
     2206   define variable vartotal-parts_fact-base like ub.parts.price-base no-undo.
     2207   define variable vartotal-parts_fact-rubl like ub.parts.price-rubl no-undo.
     2208   define variable vartotal-parts_fact-qnty like ub.parts.fact-qnty  no-undo.
     2209   define variable rec-inv-lin              as   recid               no-undo.
     2210   define variable varfact-qnty-kg          as   decimal             no-undo.
     2211   define variable varis-petrolium as logical no-undo.
     2212   define variable varis-pieces    as logical no-undo.
     2213   define buffer inv-line-ch for ub.inv-line.
     2214   define buffer gds-dtl-ch  for ub.gds-dtl.
     2215   define buffer doc-line-ch for ub.doc-line.
     2216   define buffer parts-ch    for ub.parts.
     2217   define buffer trn-doc-ch  for ub.trn-doc.
     2218   do on error undo, return error return-value :
     2219     find first trn-doc-ch  where trn-doc-ch.doc-code = pardoc-code.
     2220     if trn-doc-ch.doc-type <> 'инв':U then do:
     2221       assign
     2222         partotal-doc-line_fact-base = parfact-qnty * parprice-base
     2223         partotal-doc-line_fact-rubl = parfact-qnty * parprice-rubl
     2224       .
     2225     end.
     2226     else do:
     2227       assign
     2228         vartotal-parts_fact-base = 0
     2229         vartotal-parts_fact-rubl = 0
     2230         vartotal-parts_fact-qnty = 0
     2231       .
     2232       for each parts-ch
     2233         where parts-ch.obj-type  = parobj-type
     2234           and parts-ch.obj-code  = parobj-code
     2235           and parts-ch.artic     = parartic
     2236           and parts-ch.prod-type = parprod-type
     2237           and parts-ch.prod-code = parprod-code
     2238           and parts-ch.out-code  = pardoc-code
     2239       :
     2240         assign
     2241           vartotal-parts_fact-base  = vartotal-parts_fact-base
     2242                                       + parts-ch.fact-qnty * parts-ch.price-base
     2243           vartotal-parts_fact-rubl  = vartotal-parts_fact-rubl
     2244                                       + parts-ch.fact-qnty * parts-ch.price-rubl
     2245           vartotal-parts_fact-qnty  = vartotal-parts_fact-qnty
     2246                                       + parts-ch.fact-qnty
     2247         .
     2248       end.
     2249       assign
     2250         partotal-doc-line_fact-base = vartotal-parts_fact-base
     2251         partotal-doc-line_fact-rubl = vartotal-parts_fact-rubl
     2252       .
     2253     end.
     2254     assign
     2255       partotal-doc-line_fact-qnty = parfact-qnty
     2256       partotal-doc-line_doc-qnty  = pardoc-qnty
     2257       partotal-doc-line_cli-qnty  = parcli-qnty
     2258     .
     2259     ASSIGN partotal-doc-line_tot-ov = 0.
     2260     for each gds-dtl-ch where gds-dtl-ch.doc-code  = pardoc-code  and
     2261                               gds-dtl-ch.artic     = parartic     and
     2262                               gds-dtl-ch.prod-type = parprod-type and
     2263                               gds-dtl-ch.prod-code = parprod-code no-lock :
     2264        if g-varr-b = "rubl":U then do:
     2265         assign
     2266          partotal-doc-line_tot-ov = partotal-doc-line_tot-ov
     2267                                   + (gds-dtl-ch.cur-base - gds-dtl-ch.price-rubl) * gds-dtl-ch.fact-qnty.
     2268       end.
     2269       else do:
     2270         assign
     2271          partotal-doc-line_tot-ov = partotal-doc-line_tot-ov
     2272                                   + (gds-dtl-ch.cur-base - gds-dtl-ch.price-base) * gds-dtl-ch.fact-qnty.
     2273       end.
     2274     end.
     2275     find first doc-line-ch no-lock where
     2276                doc-line-ch.doc-code  = pardoc-code  and
     2277                doc-line-ch.artic     = parartic     and
     2278                doc-line-ch.prod-type = parprod-type and
     2279                doc-line-ch.prod-code = parprod-code .
     2280   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     2281     (
     2282        input doc-line-ch.artic
     2283     ,  input doc-line-ch.prod-type
     2284     ,  input doc-line-ch.prod-code
     2285     , output varis-petrolium
     2286     , output varis-pieces
     2287     ) no-error.
     2288     if varis-petrolium and
     2289        not varis-pieces then do:
     2290       find first inv-line-ch no-lock where
     2291                  inv-line-ch.doc-code  = pardoc-code  and
     2292                  inv-line-ch.artic     = parartic     and
     2293                  inv-line-ch.prod-type = parprod-type and
     2294                  inv-line-ch.prod-code = parprod-code no-error.
     2295       if available inv-line-ch then do:
     2296         assign
     2297           varfact-qnty-kg = inv-line-ch.wast-cli-qnty.
     2298       end.
     2299       else do:
     2300         assign
     2301           varfact-qnty-kg = ?.
     2302       end.
     2303   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_chkinvln in g#lib-trn3 (  input  pardoc-code ,
     2304                           input  parartic ,
     2305                           input  parprod-type ,
     2306                           input  parprod-code ,
     2307                           input  ? ,
     2308                           input  ? ,
     2309                           input  ? ,
     2310                           input  ? ,
     2311                           input  varfact-qnty-kg ,
     2312                           input doc-line-ch.fact-density ,
     2313                          output rec-inv-lin ) no-error.
     2314       if error-status :error then do:
     2315         return error return-value.
     2316       end.
     2317     end.
     2318   end.
     2319   end procedure.
     2320   procedure lib-trn_ass-cost:
     2321   define input parameter parrecid-doc              as recid                       no-undo.
     2322   define input parameter parinc_tot-ovnew          like ub.trn-doc.tot-ov         no-undo.
     2323   define input parameter parinc_fact-rublnew       like ub.trn-doc.fact-rubl      no-undo.
     2324   define input parameter parinc_fact-basenew       like ub.trn-doc.fact-base      no-undo.
     2325   define input parameter parinc_fact-qntynew       like ub.trn-doc.fact-qnty      no-undo.
     2326   define input parameter parinc_doc-qntynew        like ub.trn-doc.doc-qnty       no-undo.
     2327   define input parameter parinc_cli-qntynew        like ub.trn-doc.cli-qnty       no-undo.
     2328   define input parameter parinc_tot-ovold          like ub.trn-doc.tot-ov         no-undo.
     2329   define input parameter parinc_fact-rublold       like ub.trn-doc.fact-rubl      no-undo.
     2330   define input parameter parinc_fact-baseold       like ub.trn-doc.fact-base      no-undo.
     2331   define input parameter parinc_fact-qntyold       like ub.trn-doc.fact-qnty      no-undo.
     2332   define input parameter parinc_doc-qntyold        like ub.trn-doc.doc-qnty       no-undo.
     2333   define input parameter parinc_cli-qntyold        like ub.trn-doc.cli-qnty       no-undo.
     2334   define buffer ass_trn-doc for ub.trn-doc.
     2335   do on error undo, return error return-value :
     2336     find first ass_trn-doc where recid(ass_trn-doc) = parrecid-doc.
     2337     assign
     2338       ass_trn-doc.fact-qnty = ass_trn-doc.fact-qnty + parinc_fact-qntynew - parinc_fact-qntyold
     2339       ass_trn-doc.cli-qnty  = ass_trn-doc.cli-qnty  + parinc_cli-qntynew  - parinc_cli-qntyold
     2340       ass_trn-doc.fact-base = ass_trn-doc.fact-base + parinc_fact-basenew - parinc_fact-baseold
     2341       ass_trn-doc.fact-rubl = ass_trn-doc.fact-rubl + parinc_fact-rublnew - parinc_fact-rublold
     2342       ass_trn-doc.tot-ov    = ass_trn-doc.tot-ov    + parinc_tot-ovnew    - parinc_tot-ovold.
     2343     if ass_trn-doc.doc-type <> 'инв':U then do:
     2344       assign
     2345       ass_trn-doc.doc-qnty  = ass_trn-doc.doc-qnty  + parinc_doc-qntynew  - parinc_doc-qntyold.
     2346     end.
     2347   end.
     2348   end procedure.
     2349   procedure lib-trn_calc-in:
     2350   define input parameter parparentproc AS WIDGET-HANDLE NO-UNDO.
     2351   define input parameter parrec-doc as recid  no-undo.
     2352   define input parameter parhandle  as handle no-undo.
     2353   define variable varcount   as integer   no-undo.
     2354   define variable vartime    as integer   no-undo.
     2355   define variable varmessage as character no-undo.
     2356   define buffer   rc_trn-doc  for ub.trn-doc.
     2357   define buffer   d-l-b       for ub.doc-line.
     2358   do on error undo, return error return-value :
     2359   assign
     2360     vartime = time.
     2361   find first rc_trn-doc where recid(rc_trn-doc) = parrec-doc.
     2362   assign
     2363     rc_trn-doc.VAT-rubl   = 0
     2364     rc_trn-doc.VAT-base   = 0
     2365     rc_trn-doc.SLT-rubl   = 0
     2366     rc_trn-doc.SLT-base   = 0
     2367     rc_trn-doc.doc-qnty   = 0
     2368     rc_trn-doc.fact-qnty  = 0
     2369     rc_trn-doc.tot-calc   = 0
     2370     rc_trn-doc.cli-qnty   = 0
     2371     rc_trn-doc.tot-doc    = 0
     2372     rc_trn-doc.tot-fact   = 0
     2373     rc_trn-doc.tot-sale   = 0
     2374     rc_trn-doc.tot-rubl   = 0
     2375     rc_trn-doc.fact-base  = 0
     2376     rc_trn-doc.fact-rubl  = 0
     2377     rc_trn-doc.tot-lines  = 0
     2378     rc_trn-doc.tot-ov     = 0
     2379     rc_trn-doc.road-tax   = 0
     2380     .
     2381   if rc_trn-doc.status_ = 'факт':U then do:
     2382     assign
     2383       rc_trn-doc.tot-other  = 0
     2384       rc_trn-doc.tot-transp = 0.
     2385   end.
     2386   assign
     2387     varcount = 0.
     2388   for each d-l-b where d-l-b.doc-code = rc_trn-doc.doc-code on error undo, return error return-value :
     2389     run waitfram-join in parhandle (substitute ("Пересчет шапки документа &1.", rc_trn-doc.doc-code),
     2390                                     substitute ("Товар &1 &2 &3. ", d-l-b.artic, d-l-b.prod-type, d-l-b.prod-code),
     2391                                     substitute (" Всего обработано строк: &1", varcount) +
     2392                                     substitute (" Время: &1.", string(time - vartime, "hh:mm:ss")),
     2393                                     output varmessage
     2394                                     ) no-error.
     2395     run waitfram-show in parhandle (varmessage) no-error.
     2396     assign
     2397       varcount = varcount + 1.
     2398   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_clcintrn in g#lib-trn
     2399     (
     2400      input parparentproc
     2401     ,input recid(d-l-b)
     2402     ,input d-l-b.doc-code
     2403     ,input d-l-b.artic
     2404     ,input d-l-b.prod-type
     2405     ,input d-l-b.prod-code
     2406     ,input 0
     2407     ,input 0
     2408     ,input 0
     2409     ,input 0
     2410     ,input 0
     2411     ,input 0
     2412     ,input 0
     2413     ,input 0
     2414     ,input 0
     2415     ,input 0
     2416     ,input 0
     2417     ,input 0
     2418     ,input 0
     2419     ,input 'create':U
     2420     ,input '':U
     2421     ) .
     2422   end.
     2423   end.
     2424   end procedure.
     2425   procedure lib-trn_calc-inv:
     2426   define input parameter parrec-doc as recid  no-undo.
     2427   define input parameter parhandle  as handle no-undo.
     2428   define buffer fc_trn-doc  for ub.trn-doc.
     2429   define buffer fc_doc-line for ub.doc-line.
     2430   define variable vartot-doc        like ub.trn-doc.tot-doc  no-undo.
     2431   define variable vartot-rubl       like ub.trn-doc.tot-rubl no-undo.
     2432   define variable vartotal-tot-doc  like ub.trn-doc.tot-doc  no-undo.
     2433   define variable vartotal-tot-rubl like ub.trn-doc.tot-rubl no-undo.
     2434   define variable varcount   as integer   no-undo.
     2435   define variable vartime    as integer   no-undo.
     2436   define variable varmessage as character no-undo.
     2437   define variable vartotal-doc-qnty as decimal   no-undo .
     2438   do transaction on error undo, return error return-value :
     2439   assign
     2440     vartime  = time
     2441     varcount = 0
     2442     vartotal-doc-qnty = 0 .
     2443   find first fc_trn-doc where recid(fc_trn-doc) = parrec-doc.
     2444   for each fc_doc-line
     2445     where fc_doc-line.doc-code = fc_trn-doc.doc-code
     2446   on error undo, return error
     2447   :
     2448     run waitfram-join in parhandle (substitute ("Пересчет шапки документа &1.", fc_trn-doc.doc-code),
     2449                                     substitute ("Товар &1 &2 &3. ", fc_doc-line.artic, fc_doc-line.prod-type, fc_doc-line.prod-code),
     2450                                     substitute (" Всего обработано строк: &1", varcount) +
     2451                                     substitute (" Время: &1.", string(time - vartime, "hh:mm:ss")),
     2452                                     output varmessage
     2453                                     ) no-error.
     2454     run waitfram-show in parhandle (varmessage) no-error.
     2455     assign
     2456       varcount = varcount + 1.
     2457   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_clclninv in g#lib-trn
     2458   (
     2459    input  recid(fc_doc-line)
     2460   ,input  yes
     2461   ,input  '':U
     2462   ,output vartot-doc
     2463   ,output vartot-rubl
     2464   )
     2465   no-error.
     2466     if error-status :error then do:
     2467        return error return-value.
     2468     end.
     2469     assign
     2470       vartotal-doc-qnty   =  vartotal-doc-qnty + fc_doc-line.doc-qnty - fc_doc-line.fact-qnty
     2471       vartotal-tot-doc    =  vartotal-tot-doc  + vartot-doc
     2472       vartotal-tot-rubl   =  vartotal-tot-rubl + vartot-rubl
     2473     .
     2474   end.
     2475   fc_trn-doc.doc-qnty = vartotal-doc-qnty .
     2476   if g-varr-b = "rubl":u then do:
     2477     assign
     2478       fc_trn-doc.tot-rubl = vartotal-tot-rubl
     2479       fc_trn-doc.tot-doc  = fc_trn-doc.tot-rubl / fc_trn-doc.base-rate * fc_trn-doc.base-scale
     2480    .
     2481   end.
     2482   else do:
     2483     assign
     2484       fc_trn-doc.tot-doc  = vartotal-tot-doc
     2485       fc_trn-doc.tot-rubl = fc_trn-doc.tot-doc * fc_trn-doc.base-rate / fc_trn-doc.base-scale
     2486    .
     2487   end.
     2488   run str/calc-hd.p (INPUT fc_trn-doc.doc-code) no-error.
     2489       if error-status :error then do:
     2490         return error return-value.
     2491       end.
     2492   end.
     2493   end procedure.
     2494   procedure lib-trn_clclninv:
     2495   define input  parameter parrec-line            as   recid               no-undo.
     2496   define input  parameter parstate-price         as   logical             no-undo.
     2497   define input  parameter parmode                as   character           no-undo.
     2498   define output parameter partot-doc             like ub.trn-doc.tot-doc            no-undo.
     2499   define output parameter partot-rubl            like ub.trn-doc.tot-rubl           no-undo.
     2500   define buffer cdl_doc-line for ub.doc-line.
     2501   define buffer cdl_goods    for ub.goods.
     2502   define buffer cdl_inv-line for ub.inv-line.
     2503   define buffer cdl_gds-dtl  for ub.gds-dtl.
     2504   define buffer cdl_trn-doc  for ub.trn-doc.
     2505   define variable varsum-sale like ub.gds-dtl.price-rubl no-undo.
     2506   define variable rec-inv-lin as   recid                 no-undo.
     2507   define variable varis-petrolium as logical no-undo.
     2508   define variable varis-pieces    as logical no-undo.
     2509   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2510   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
     2511   define variable gp-price-sale like ub.price-list.price-sale no-undo.
     2512   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
     2513   define variable gp-excise     like ub.price-list.excise     no-undo.
     2514   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
     2515   define variable gp-fact-order as decimal   no-undo .
     2516   define variable gp-price-sale-parts as decimal   no-undo .
     2517   do on error undo, return error return-value :
     2518   find first cdl_doc-line where recid(cdl_doc-line)  = parrec-line.
     2519   find first cdl_inv-line
     2520     where cdl_inv-line.doc-code  = cdl_doc-line.doc-code
     2521       and cdl_inv-line.artic     = cdl_doc-line.artic
     2522       and cdl_inv-line.prod-type = cdl_doc-line.prod-type
     2523       and cdl_inv-line.prod-code = cdl_doc-line.prod-code
     2524     no-error.
     2525   find first cdl_trn-doc  where cdl_trn-doc.doc-code = cdl_doc-line.doc-code no-error.
     2526   if not available cdl_trn-doc then do:
     2527     return error substitute ("Не найден документ с номером &1.", cdl_doc-line.doc-code).
     2528   end.
     2529   find first cdl_goods where cdl_goods.artic     = cdl_doc-line.artic and
     2530                              cdl_goods.prod-type = cdl_doc-line.prod-type and
     2531                              cdl_goods.prod-code = cdl_doc-line.prod-code no-lock.
     2532   for each cdl_gds-dtl where cdl_gds-dtl.doc-code  = cdl_doc-line.doc-code
     2533                          and cdl_gds-dtl.prod-code = cdl_doc-line.prod-code
     2534                          and cdl_gds-dtl.prod-type = cdl_doc-line.prod-type
     2535                          and cdl_gds-dtl.artic     = cdl_doc-line.artic on error undo, return error :
     2536      if parstate-price then do:
     2537   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2538    gp-fact-order = cdl_trn-doc.fact-order .
