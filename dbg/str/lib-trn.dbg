     2595              cdl_doc-line.road-tax    = gp-road-tax
     2596              cdl_gds-dtl.price-base   = gp-price-sale-parts.
     2597          end.
     2598        end.
     2599        else do:
     2600          if g-varr-b = "rubl":u then do:
     2601            assign
     2602              cdl_gds-dtl.price-rubl = 0.
     2603          end.
     2604          else do:
     2605            assign
     2606              cdl_gds-dtl.price-base = 0.
     2607          end.
     2608        end.
     2609       if g-varr-b = "base":u then do:
     2610         assign
     2611           cdl_gds-dtl.price-rubl = cdl_gds-dtl.price-base * cdl_trn-doc.base-rate / cdl_trn-doc.base-scale.
     2612       end.
     2613       else do:
     2614         assign
     2615           cdl_gds-dtl.price-base = cdl_gds-dtl.price-rubl / cdl_trn-doc.base-rate * cdl_trn-doc.base-scale.
     2616       end.
     2617      end.
     2618      if g-varr-b = "base":u then do:
     2619        assign varsum-sale = varsum-sale + cdl_gds-dtl.price-base * cdl_gds-dtl.doc-qnty.
     2620      end.
     2621      else do:
