     2927      end.
     2928   end.
     2929   if cd_trn-doc.discnt-type <> 'сумма':U then do:
     2930       assign
     2931         cd_trn-doc.tot-calc    = 0
     2932         cd_trn-doc.discnt-rubl = 0
     2933         .
     2934   end.
     2935   assign varcount = 0.
     2936   for each cd_doc-line where cd_doc-line.doc-code = cd_trn-doc.doc-code:
     2937     run waitfram-join in parhandle (substitute ("Вычисление НДС &1.", cd_trn-doc.doc-code),
     2938                                     substitute ("Товар &1 &2 &3. ", cd_doc-line.artic, cd_doc-line.prod-type, cd_doc-line.prod-code),
     2939                                     substitute (" Всего обработано строк: &1", varcount) +
