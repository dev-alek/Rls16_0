     5567          ca_lib-trn_ret-doc.status_      = 'запрос':U and
     5568          ca_trn-doc.ord-num  = ca_lib-trn_ret-doc.doc-code then do:
     5569         if ca_gds-prt.node-name = '_Пустая шкала':U then do:
     5570            assign
     5571            v-accum-cli-qnty = 0.
     5572            for each old-doc no-lock where
     5573                     old-doc.ord-num = ca_lib-trn_ret-doc.doc-code :
     5574             find old-line where old-line.doc-code  = old-doc.doc-code
     5575                             and old-line.artic     = ca_doc-line.artic
     5576                             and old-line.prod-type = ca_doc-line.prod-type
     5577                             and old-line.prod-code = ca_doc-line.prod-code no-error.
     5578             if available old-line then do:
     5579               if old-line.obj-type = ca_doc-line.obj-type
     5580                 and old-line.obj-code = ca_doc-line.obj-code
     5581               then do:
     5582                 assign v-accum-cli-qnty = v-accum-cli-qnty + old-line.fact-qnty / old-line.cli-base-rate.
     5583               end.
     5584               else do:
     5585                 message "На объекте " old-line.obj-type " " old-line.obj-code skip
     5586                         " был заведен документ " old-line.doc-code " связанный с данным заказом " skip
     5587                         " в нем есть признак товара " old-line.artic " " old-line.prod-type " " old-line.prod-code skip
     5588                         " с количеством " old-line.doc-qnty " ." skip
     5589                         "Данное количество не будет учтено при расчете накладной."
     5590                 view-as alert-box.
     5591               end.
     5592             end.
     5593           end.
     5594           if ca_lib-trn_ret-line.cli-qnty - v-accum-cli-qnty   < 0 then do:
     5595             find ca_gds-dtl where ca_gds-dtl.doc-code  = ca_trn-doc.doc-code
     5596                               and ca_gds-dtl.artic     = ca_doc-line.artic
     5597                               and ca_gds-dtl.prod-code = ca_doc-line.prod-code
     5598                               and ca_gds-dtl.prod-type = ca_doc-line.prod-type
     5599                               and ca_gds-dtl.prt-code  = ca_gds-prt.node-code.
     5600             assign
     5601               chg-qnty = (- v-accum-cli-qnty + ca_lib-trn_ret-line.cli-qnty) * ca_doc-line.cli-base-rate.
     5602             if chg-qnty <> 0 then do:
     5603               run trg/rsrv-dtl.p (input parparentproc,
     5604                               'reserv':U + varcst-rsrv + varlast-date-rsrv + varpart-code-rsrv,
     5605                               buffer ca_gds-dtl, input-output chg-qnty,
     5606                               input-output ca_doc-line.price-base, input-output ca_doc-line.price-rubl,-1, "") no-error.
     5607               if error-status :error then do:
     5608                 undo, return error return-value.
     5609               end.
     5610               assign
     5611                 ca_doc-line.cli-qnty  = ca_doc-line.cli-qnty + chg-qnty / ca_doc-line.cli-base-rate
     5612                 ca_doc-line.doc-qnty  = ca_doc-line.cli-qnty * ca_doc-line.cli-base-rate
     5613                 ca_doc-line.fact-qnty = ca_doc-line.doc-qnty
     5614                 ca_gds-dtl.doc-qnty   = ca_doc-line.doc-qnty
     5615                 ca_gds-dtl.fact-qnty  = ca_doc-line.doc-qnty.
     5616             end.
     5617           end.
     5618         end.
     5619         else do:
     5620           if ca_doc-line.doc-qnty <> (accum total ca_gds-dtl.doc-qnty) then do:
     5621             assign
     5622               ca_doc-line.doc-qnty = (accum total ca_gds-dtl.doc-qnty)
     5623               ca_doc-line.fact-qnty = ca_doc-line.doc-qnty.
     5624             if ca_doc-line.unit-cli = ca_goods.unit-base then do:
     5625               assign
     5626                ca_doc-line.cli-qnty = ca_doc-line.doc-qnty.
     5627             end.
     5628             else do:
     5629               assign
     5630                ca_doc-line.cli-qnty = ca_doc-line.doc-qnty / ca_doc-line.cli-base-rate.
     5631             end.
     5632           end.
     5633         end.
     5634       end.
     5635     end.
     5636     if ca_doc-line.cli-qnty <= 0 or
     5637        ca_doc-line.doc-qnty <= 0 then do:
     5638        delete ca_doc-line.
     5639     end.
     5640     if available ca_doc-line then do:
     5641   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_chkwhole in g#lib-trn
     5642     ( input ca_doc-line.doc-code
     5643      ,input ca_doc-line.artic
     5644      ,input ca_doc-line.prod-type
     5645      ,input ca_doc-line.prod-code
     5646      ,input ca_doc-line.cli-qnty
     5647      ,input ca_doc-line.doc-qnty
     5648      ,input ca_doc-line.fact-qnty
     5649      ,input parrecalc
     5650     ) no-error .
     5651       if error-status :error then do:
     5652         undo, return error return-value.
     5653       end.
     5654   if (valid-handle(g#lib-calc) <> true) then do:   run str/lib-calc.p persistent no-error .   if error-status :error or (valid-handle(g#lib-calc) <> true) then do:     message       "Error starting lib-calc.p" skip       g#lib-calc skip       g#lib-calc :type skip       g#lib-calc :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-calc_lnfactqt in g#lib-calc
     5655   (
     5656    input parparentproc
     5657   ,input recid(ca_doc-line)
     5658   ,input no
     5659   ,input ca_trn-doc.status_
     5660   ,input ca_trn-doc.flag_       )
     5661   no-error.
     5662       if error-status :error then do:
     5663         undo, return error return-value .
     5664       end.
     5665     end.
     5666   end.
     5667   end.
     5668   end procedure.
     5669   procedure lib-trn_copy-scn:
     5670   define input  parameter parparentproc AS WIDGET-HANDLE           NO-UNDO.
     5671   define input  parameter parrec-doc    as   recid                 no-undo.
     5672   define input  parameter parb-code     like ub.bar-code.b-code    no-undo.
     5673   define input  parameter b-qnty        like ub.gds-dtl.doc-qnty   no-undo.
     5674   define input  parameter paris-all     as   logical               no-undo.
     5675   define input  parameter paradd-sens   as   logical               no-undo.
     5676   define input  parameter parline-mode  as character no-undo.
     5677   define output parameter parmes        as character no-undo.
     5678   define output parameter parok         as character no-undo.
     5679   define variable v-is-zam as logical   no-undo .
     5680   define variable parts-qnty like ub.parts.fact-qnty     no-undo.
     5681   define variable parts-qnty-doc like ub.parts.fact-qnty no-undo.
     5682   define variable parts-scan as decimal   no-undo .
     5683   define variable prt-qnty like ub.prt-obj.fact-qnty     no-undo.
     5684   define variable gds-qnty like ub.gds-obj.fact-qnty     no-undo.
     5685   define variable b-c      as   integer                  no-undo.
     5686   define variable inv-qnty    like ub.gds-dtl.fact-qnty     no-undo.
     5687   define variable memexp-qnty like ub.gds-dtl.doc-qnty      no-undo.
     5688   define variable g-doc-prt as logical no-undo.
     5689   define buffer cs_trn-doc  for ub.trn-doc.
     5690   define buffer cs_doc-line for ub.doc-line.
     5691   define buffer cs_gds-dtl  for ub.gds-dtl.
     5692   define buffer cs_parts    for ub.parts.
     5693   define buffer cs_goods    for ub.goods.
     5694   define buffer cs_units    for ub.units.
     5695   define buffer cs_gds-prt  for ub.gds-prt.
     5696   define buffer cs_bar-code for ub.bar-code.
     5697   define buffer cs_shop     for ub.shop.
     5698   define buffer cs_store    for ub.store.
     5699   define buffer cs_prt-obj  for ub.prt-obj.
     5700   define buffer cs_gds-obj  for ub.gds-obj.
     5701   define buffer cli-gds-cs for ub.cli-gds.
     5702   define variable v-insalepr                     as   logical      initial ? no-undo.
     5703   define variable parsale-price                  like ub.price-list.price-sale initial ? no-undo.
     5704   define variable varcst-rsrv                    as   character              no-undo.
     5705   define variable varprice-cli-cs                like ub.doc-line.price-rubl no-undo.
     5706   define variable varprice-cli-unit-base-cs      like ub.doc-line.price-rubl no-undo.
     5707   define variable varprice-road-tax-cs           like ub.doc-line.price-rubl no-undo.
     5708   define variable varprice-other-exp-cs          like ub.doc-line.price-rubl no-undo.
     5709   define variable varprice-transport-exp-cs      like ub.doc-line.price-rubl no-undo.
     5710   define variable varprice-without-abs-cs        like ub.doc-line.price-rubl no-undo.
     5711   define variable varprice-slt-cs                like ub.doc-line.price-rubl no-undo.
     5712   define variable varprice-no-slt-cs             like ub.doc-line.price-rubl no-undo.
     5713   define variable varprice-vat-cs                like ub.doc-line.price-rubl no-undo.
     5714   define variable varprice-no-vat-slt-cs         like ub.doc-line.price-rubl no-undo.
     5715   define variable varprice-rubl-cs               like ub.doc-line.price-rubl no-undo.
     5716   define variable varprice-road-tax-rubl-cs      like ub.doc-line.price-rubl no-undo.
     5717   define variable varprice-other-exp-rubl-cs     like ub.doc-line.price-rubl no-undo.
     5718   define variable varprice-transport-exp-rubl-cs like ub.doc-line.price-rubl no-undo.
     5719   define variable varprice-without-abs-rubl-cs   like ub.doc-line.price-rubl no-undo.
     5720   define variable varprice-slt-rubl-cs           like ub.doc-line.price-rubl no-undo.
     5721   define variable varprice-no-slt-rubl-cs        like ub.doc-line.price-rubl no-undo.
     5722   define variable varprice-vat-rubl-cs           like ub.doc-line.price-rubl no-undo.
     5723   define variable varprice-no-vat-slt-rubl-cs    like ub.doc-line.price-rubl no-undo.
     5724   define variable varprice-base-cs               like ub.doc-line.price-base no-undo.
     5725   define variable varprice-road-tax-base-cs      like ub.doc-line.price-base no-undo.
     5726   define variable varprice-other-exp-base-cs     like ub.doc-line.price-base no-undo.
     5727   define variable varprice-transport-exp-base-cs like ub.doc-line.price-base no-undo.
     5728   define variable varprice-without-abs-base-cs   like ub.doc-line.price-base no-undo.
     5729   define variable varprice-slt-base-cs           like ub.doc-line.price-base no-undo.
     5730   define variable varprice-no-slt-base-cs        like ub.doc-line.price-base no-undo.
     5731   define variable varprice-vat-base-cs           like ub.doc-line.price-base no-undo.
     5732   define variable varprice-no-vat-slt-base-cs    like ub.doc-line.price-base no-undo.
     5733   define variable varlegal-node like ub.gds-prt.node-code no-undo.
     5734   define variable varis-petrolium as logical no-undo.
     5735   define variable varis-pieces    as logical no-undo.
     5736   define variable varis-term as logical no-undo.
     5737   define variable varr-b-type as character no-undo.
     5738   define variable conf-par  as char    no-undo.
     5739   define variable par-type  as char    no-undo.
     5740   define variable g-log as logical no-undo.
     5741   define variable chg-qnty                       like ub.gds-dtl.doc-qnty       no-undo.
     5742   define variable fix-qnty                       like ub.gds-dtl.doc-qnty       no-undo.
     5743   define variable mem-qnty                       like ub.gds-dtl.doc-qnty       no-undo.
     5744   define variable rec-inv-line as recid no-undo.
     5745   parts-scan = b-qnty .
     5746   v-is-zam = paris-all .
     5747   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5748   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
     5749   define variable gp-price-sale like ub.price-list.price-sale no-undo.
     5750   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
     5751   define variable gp-excise     like ub.price-list.excise     no-undo.
     5752   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
     5753   define variable gp-fact-order as decimal   no-undo .
     5754   define variable gp-price-sale-parts as decimal   no-undo .
     5755   do transaction on error undo, return error return-value :
     5756   find first cs_trn-doc where recid(cs_trn-doc) = parrec-doc.
     5757   find first cs_bar-code where cs_bar-code.b-code = parb-code.
     5758   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     5759     (input  'is-prt':u
     5760     ,input  0
     5761     ,input  '':u
     5762     ,input  0
     5763     ,input  '':u
     5764     ,input  '':u
     5765     ,input  '':u
     5766     ,input  yes
     5767     ,output conf-par
     5768     ,output par-type
     5769     ) no-error .
     5770   if cs_trn-doc.obj-type = 'маг':U then do:
     5771      find first cs_shop where cs_shop.obj-code = cs_trn-doc.obj-code no-lock.
     5772      if conf-par = "yes" and
     5773         cs_shop.doc-prt  then do:
     5774        assign
     5775        g-doc-prt = yes.
     5776      end.
     5777      else do:
     5778        assign
     5779        g-doc-prt = no.
     5780      end.
     5781   end.
     5782   else do:
     5783     find first cs_store where cs_store.obj-code = cs_trn-doc.obj-code no-lock.
     5784     if conf-par = "yes" and
     5785        cs_store.doc-prt  then do:
     5786       assign
     5787       g-doc-prt = yes.
     5788     end.
     5789     else do:
     5790       assign
     5791       g-doc-prt = no.
     5792     end.
     5793   end.
     5794   find first cs_goods   where cs_goods.gds-code     = cs_bar-code.gds-code no-lock.
     5795   find first cs_gds-prt where cs_gds-prt.upper-code = cs_goods.prt-root  no-lock.
     5796   find first cs_units   where cs_units.unit-name    = cs_goods.unit-base no-lock.
     5797   find cs_doc-line where cs_doc-line.doc-code  = cs_trn-doc.doc-code
     5798                      and cs_doc-line.artic     = cs_goods.artic
     5799                      and cs_doc-line.prod-code = cs_goods.prod-code
     5800                      and cs_doc-line.prod-type = cs_goods.prod-type no-error.
     5801   if not available cs_doc-line and
     5802      (paradd-sens = no  or
     5803       cs_trn-doc.doc-type = 'инв':U ) then do:
     5804      return error substitute("&1 Нельзя добавить строку документа : &2 .", parmes, cs_goods.artic).
     5805   end.
     5806   if not available cs_doc-line then do:
     5807     run lib-trn_create-doc-line in this-procedure (input cs_goods.artic,
     5808                                                    input cs_goods.prod-type,
     5809                                                    input cs_goods.prod-code,
     5810                                                    recid(cs_trn-doc)) no-error.
     5811     if error-status :error then do:
     5812       return error substitute("&1 &2", parmes, return-value).
     5813     end.
     5814     find first cs_doc-line where cs_doc-line.doc-code  = cs_trn-doc.doc-code and
     5815                                  cs_doc-line.artic     = cs_goods.artic      and
     5816                                  cs_doc-line.prod-type = cs_goods.prod-type  and
     5817                                  cs_doc-line.prod-code = cs_goods.prod-code .
     5818     assign
     5819       cs_doc-line.unit-cli      = cs_goods.unit-cli
     5820       cs_doc-line.cli-base-rate = cs_goods.cli-base-rate.
     5821   end.
     5822   if cs_trn-doc.doc-type = 'инв':U then do:
     5823   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     5824     (input  cs_bar-code.node-code
     5825     ,input  'terminal-prt=request':u
     5826     ,output varis-term
     5827     )  .
     5828      if varis-term <> yes and
     5829         g-doc-prt         then do:
     5830         return error substitute("&1 Бар-код &2 не является бар-кодом терминального признака.", parmes, cs_bar-code.b-code).
     5831      end.
     5832   end.
     5833   find cs_gds-dtl where cs_gds-dtl.doc-code   = cs_trn-doc.doc-code
     5834                     and cs_gds-dtl.artic      = cs_goods.artic
     5835                     and cs_gds-dtl.prod-code  = cs_goods.prod-code
     5836                     and cs_gds-dtl.prod-type  = cs_goods.prod-type
     5837                     and cs_gds-dtl.prt-code   = cs_bar-code.node-code no-error.
     5838   if not available cs_gds-dtl then do:
     5839      if not paradd-sens and cs_trn-doc.doc-type <> 'инв':U then do:
     5840        return error substitute("Нельзя добавить признак по товару &1 &2 &3 с бар-кодом &4.", cs_goods.artic, cs_goods.prod-type, cs_goods.prod-code, cs_bar-code.b-code).
     5841      end.
     5842   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crgdsdtl in g#lib-trn
     5843     ( input cs_trn-doc.obj-code
     5844      ,input cs_trn-doc.obj-type
     5845      ,input cs_trn-doc.doc-code
     5846      ,input cs_goods.artic
     5847      ,input cs_goods.prod-code
     5848      ,input cs_goods.prod-type
     5849      ,input cs_bar-code.node-code
     5850      ,input yes
     5851     ) no-error .
     5852      if error-status :error then do:
     5853         return error substitute("&1 &2", parmes, return-value).
     5854      end.
     5855      find first cs_gds-dtl where cs_gds-dtl.doc-code  = cs_trn-doc.doc-code and
     5856                                  cs_gds-dtl.artic     = cs_goods.artic      and
     5857                                  cs_gds-dtl.prod-code = cs_goods.prod-code  and
     5858                                  cs_gds-dtl.prod-type = cs_goods.prod-type  and
     5859                                  cs_gds-dtl.prt-code  = cs_bar-code.node-code.
     5860   end.
     5861   parts-qnty-doc = 0 .
     5862   if cs_bar-code.in-code <> "" THEN DO:
     5863     find first cs_parts WHERE cs_parts.obj-code    = cs_trn-doc.obj-code
     5864                           and cs_parts.obj-type    = cs_trn-doc.obj-type
     5865                           and cs_parts.artic       = cs_doc-line.artic
     5866                           and cs_parts.prod-type   = cs_doc-line.prod-type
     5867                           and cs_parts.prod-code   = cs_doc-line.prod-code
     5868                           and cs_parts.in-code     = cs_bar-code.in-code
     5869                           and cs_parts.part-code   = cs_bar-code.part-code no-error.
     5870      if not available cs_parts and
     5871         cs_bar-code.in-code <> "" then do:
     5872           undo, return error substitute("&1 Ссылка на несуществующую партию: &2.", parmes, cs_bar-code.part-code).
     5873      end.
     5874      find first cs_parts where cs_parts.out-code    = cs_trn-doc.doc-code
     5875                            and cs_parts.obj-code    = cs_trn-doc.obj-code
     5876                            and cs_parts.obj-type    = cs_trn-doc.obj-type
     5877                            and cs_parts.artic       = cs_doc-line.artic
     5878                            and cs_parts.prod-type   = cs_doc-line.prod-type
     5879                            and cs_parts.prod-code   = cs_doc-line.prod-code
     5880                            and cs_parts.in-code     = cs_bar-code.in-code
     5881                            and cs_parts.part-code   = cs_bar-code.part-code no-error.
     5882      if not available cs_parts    and
     5883         cs_bar-code.in-code <> "" and
     5884         paris-all = yes  then do:
     5885      end.
     5886      if available cs_parts then do:
     5887         parts-qnty-doc = cs_parts.fact-qnty .
     5888      end.
     5889   end.
     5890   if cs_bar-code.in-code <> ""                                                             and
     5891      ((can-do ('рас,спи,возврат':U, cs_trn-doc.doc-type) and not cs_trn-doc.flag_) or
     5892       (cs_trn-doc.doc-type = 'инв':U and
     5893        cs_trn-doc.status_ = 'разрешен':U)) then do:
     5894         assign
     5895           parmes = parmes + " Партия: " + cs_bar-code.part-code + " ".
     5896         if paris-all = ? then do:
     5897            g-log = no.
     5898            if available cs_parts then do:
     5899               message "Товар :" cs_goods.artic cs_goods.gds-name skip
     5900                       "Партия :" cs_parts.part-code "-  количество не 0 !" skip (2)
     5901                       "yes - переписать количество со сканера в партию :" b-qnty skip (2)
     5902                       "no  - прибавить количество со сканера к партии :"  cs_parts.qnty "+" b-qnty
     5903                       view-as alert-box question buttons yes-no update g-log.
     5904                       v-is-zam = g-log .
     5905            end.
     5906            else do:
     5907               message "Товар :" cs_goods.artic cs_goods.gds-name skip
     5908                       "Партия :" cs_bar-code.part-code skip(2)
     5909                       "Режим замены осуществить невозможно. Только добавление." skip
     5910                       "yes - Пропустить партию." skip
     5911                       "no  - прибавить количество со сканера к партии :" b-qnty
     5912               view-as alert-box question buttons yes-no update g-log.
     5913               if g-log = yes then do:
     5914                  undo, return error substitute ("&1 Невозможно осуществить режим замены. Партия: &2 не привязана к данному документу.", parmes, cs_bar-code.part-code).
     5915               end.
     5916               v-is-zam = g-log .
     5917            end.
     5918         end.
     5919         else g-log = paris-all.
     5920         if g-log then do:
     5921         assign
     5922           parmes  = parmes + " Количество заменено на: " + string (b-qnty) + " "
     5923           b-qnty = b-qnty - parts-qnty-doc
     5924           .
     5925         end.
     5926         if b-qnty = 0 then return.
     5927         assign
     5928           b-c = cs_bar-code.b-code.
     5929   end.
     5930   else do:
     5931     if cs_trn-doc.doc-type = 'инв':U then do:
     5932        find cs_prt-obj where cs_prt-obj.obj-type  = cs_trn-doc.obj-type
     5933                          and cs_prt-obj.obj-code  = cs_trn-doc.obj-code
     5934                          and cs_prt-obj.artic     = cs_gds-dtl.artic
     5935                          and cs_prt-obj.prod-code = cs_gds-dtl.prod-code
     5936                          and cs_prt-obj.prod-type = cs_gds-dtl.prod-type
     5937                          and cs_prt-obj.prt-code  = cs_gds-dtl.prt-code no-lock no-error.
     5938        if available cs_prt-obj then do:
     5939           assign
     5940           prt-qnty   = cs_prt-obj.fact-qnty.
     5941        end.
     5942        else do:
     5943          assign
     5944          prt-qnty = 0.
     5945        end.
     5946        if paris-all = ? then do:
     5947         g-log = no.
     5948         message "Товар :" cs_goods.artic cs_goods.gds-name
     5949                 " Было  количество " prt-qnty + cs_gds-dtl.doc-qnty skip (2)
     5950                 "yes - переписать количество со сканера в документ :" b-qnty skip (2)
     5951                 "no - прибавить количество со сканера к документу :"  prt-qnty + cs_gds-dtl.doc-qnty "+" b-qnty
     5952                 view-as alert-box question buttons yes-no update g-log.
     5953        end.
     5954        else g-log = paris-all.
     5955        if g-log then do:
     5956          assign
     5957           parmes = parmes + " Количество заменено на: " + string (b-qnty).
     5958        end.
     5959        else do:
     5960          assign
     5961            b-qnty = prt-qnty + cs_gds-dtl.doc-qnty + b-qnty.
     5962        end.
     5963     end.
     5964     else do:
     5965       if cs_gds-dtl.fact-qnty <> 0 then do:
     5966         if paris-all = ? then do:
     5967           g-log = no.
     5968           message "Товар :" cs_goods.artic cs_goods.gds-name
     5969                   " -  количество не 0 !" skip (2)
     5970                   "yes - переписать количество со сканера в документ :" b-qnty skip (2)
     5971                   "no - прибавить количество со сканера к документу :" cs_doc-line.fact-qnty "+" b-qnty
     5972                   view-as alert-box question buttons yes-no update g-log.
     5973         end.
     5974         else g-log = paris-all.
     5975         if g-log then do:
     5976            assign
