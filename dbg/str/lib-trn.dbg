     7709     (input  '-'
     7710     ,input  del_trn-doc.doc-code
     7711     ,output v-mess
     7712     ) no-error .
     7713           if error-status :error
     7714           then do:
     7715             undo, return error return-value .
     7716           end.
     7717         end.
     7718         if del_trn-doc.status_ <> 'факт':U    and
     7719            del_trn-doc.status_ <> 'запрос':U then do:
     7720           assign
     7721             del_trn-doc.flag_ = no.
     7722           assign
     7723             vardel-line = 0.
     7724           for each del_doc-line where
     7725                    del_doc-line.doc-code = del_trn-doc.doc-code
     7726           on error undo, return error return-value :
     7727             run waitfram-join in parhandle (
     7728                input substitute( "Разрезервирование строк документа &1 перед удалением.", pardoc-code ),
     7729                input substitute( " Товар &1 &2 &3.", del_doc-line.artic, del_doc-line.prod-type, del_doc-line.prod-code ),
     7730                input substitute( " Всего удалено строк: &1", vardel-line ) +
     7731                      substitute( " Время: &1.", string( time - vartime, "hh:mm:ss":U ) ),
     7732               output varmessage            ) no-error.
     7733             run waitfram-show in parhandle ( input varmessage ) no-error.
     7734             assign
     7735               vardel-line = vardel-line + 1.
     7736             if del_trn-doc.ext-doc-type = 'vp':U then do:
     7737   define variable vss-include-info75 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
