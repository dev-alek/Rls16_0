     3859       output varprice-cliold                              ,
     3860       output varprice-cli-unit-baseold                    ,
     3861       output varprice-road-taxold                         ,
     3862       output varprice-other-expold                        ,
     3863       output varprice-transport-expold                    ,
     3864       output varprice-without-absold                      ,
     3865       output varprice-sltold                              ,
     3866       output varprice-no-sltold                           ,
     3867       output varprice-vatold                              ,
     3868       output varprice-no-vat-sltold                       ,
     3869       output varprice-rublold                             ,
     3870       output varprice-road-tax-rublold                    ,
     3871       output varprice-other-exp-rublold                   ,
     3872       output varprice-transport-exp-rublold               ,
     3873       output varprice-without-abs-rublold                 ,
     3874       output varprice-slt-rublold                         ,
     3875       output varprice-no-slt-rublold                      ,
     3876       output varprice-vat-rublold                         ,
     3877       output varprice-no-vat-slt-rublold                  ,
     3878       output varprice-baseold                             ,
     3879       output varprice-road-tax-baseold                    ,
     3880       output varprice-other-exp-baseold                   ,
     3881       output varprice-transport-exp-baseold               ,
     3882       output varprice-without-abs-baseold                 ,
     3883       output varprice-slt-baseold                         ,
     3884       output varprice-no-slt-baseold                      ,
     3885       output varprice-vat-baseold                         ,
     3886       output varprice-no-vat-slt-baseold                  ) no-error.
     3887     if error-status :error then do:
     3888        return error substitute ("Ошибка при вычисление компонентов линии документа &1.", return-value).
     3889     end.
     3890     ASSIGN delta-line-VAT =  delta-line-vat -
     3891                              parfact-qnty * varprice-vatold / parcli-base-rate
     3892            delta-line-SLT =  delta-line-slt -
     3893                              parfact-qnty * varprice-sltold / parcli-base-rate.
     3894   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_acc-cost in g#lib-trn
     3895   (
     3896    input  tc_trn-doc.obj-type
     3897   ,input  tc_trn-doc.obj-code
     3898   ,input  pardoc-code
     3899   ,input  parartic
     3900   ,input  parprod-type
     3901   ,input  parprod-code
     3902   ,input  parcli-qnty
     3903   ,input  pardoc-qnty
     3904   ,input  parfact-qnty
     3905   ,input  parprice-base
     3906   ,input  parprice-rubl
     3907   ,input  'old':U
     3908   ,output v-total-doc-line_tot-ovold
     3909   ,output v-total-doc-line_fact-rublold
     3910   ,output v-total-doc-line_fact-baseold
     3911   ,output v-total-doc-line_fact-qntyold
     3912   ,output v-total-doc-line_doc-qntyold
     3913   ,output v-total-doc-line_cli-qntyold
     3914   )
     3915   no-error.
     3916     if error-status :error then do:
     3917       return error return-value.
     3918     end.
     3919   end.
     3920   else do:
     3921     assign
     3922     v-total-doc-line_tot-ovold       = 0
     3923     v-total-doc-line_fact-rublold    = 0
     3924     v-total-doc-line_fact-baseold    = 0
     3925     v-total-doc-line_fact-qntyold    = 0
     3926     v-total-doc-line_doc-qntyold     = 0
     3927     v-total-doc-line_cli-qntyold     = 0
     3928     .
     3929   end.
     3930   if tc_trn-doc.doc-qnty = ? then tc_trn-doc.doc-qnty = 0.
     3931   if delta-line-vat      = ? then delta-line-vat      = 0.
     3932   if delta-line-slt      = ? then delta-line-slt      = 0.
     3933   if parmode <> "delete" then do:
     3934      if tc_doc-line-new.fact-qnty = ? then do:
     3935        assign
     3936         tc_doc-line-new.fact-qnty = 0.
     3937      end.
     3938   end.
     3939   assign
     3940     tc_trn-doc.vat-rubl = tc_trn-doc.vat-rubl + delta-line-vat * tc_trn-doc.exch-rate / tc_trn-doc.exch-scale
     3941     tc_trn-doc.vat-base = tc_trn-doc.vat-rubl / tc_trn-doc.base-rate * tc_trn-doc.base-scale
     3942     tc_trn-doc.slt-rubl = tc_trn-doc.slt-rubl + delta-line-slt * tc_trn-doc.exch-rate / tc_trn-doc.exch-scale
     3943     tc_trn-doc.slt-base = tc_trn-doc.slt-rubl / tc_trn-doc.base-rate * tc_trn-doc.base-scale
     3944     tc_trn-doc.tot-calc = tc_trn-doc.tot-calc +
     3945                     (if parmode <> "delete" then (tc_doc-line-new.cli-qnty * tc_doc-line-new.price-cli) else 0) -
     3946                     (if parmode <> "create" then (parcli-qnty * parprice-cli) else 0)
     3947     tc_trn-doc.tot-doc  = tc_trn-doc.tot-doc +
     3948                     (if parmode <> "delete" then (tc_doc-line-new.doc-qnty * tc_doc-line-new.price-base) else 0) -
     3949                     (if parmode <> "create" then (pardoc-qnty * parprice-base) else 0)
     3950     tc_trn-doc.tot-fact = tc_trn-doc.tot-fact +
     3951                     (if parmode <> "delete" then (tc_doc-line-new.fact-qnty * tc_doc-line-new.price-base) else 0)  -
     3952                     (if parmode <> "create" then (parfact-qnty * parprice-base) else 0)
     3953     tc_trn-doc.road-tax = tc_trn-doc.road-tax  +
     3954                     (if parmode <> "delete" then (tc_doc-line-new.fact-qnty * tc_doc-line-new.road-tax) else 0) -
     3955                     (if parmode <> "create" then (parfact-qnty * parroad-tax) else 0)
     3956     tc_trn-doc.excise = tc_trn-doc.excise +
     3957                     (if parmode <> "delete" then (tc_doc-line-new.fact-qnty * tc_doc-line-new.excise) else 0) -
     3958                     (if parmode <> "create" then (parfact-qnty * parexcise) else 0)
     3959     tc_trn-doc.tot-sale = tc_trn-doc.tot-sale +
     3960                     (if parmode <> "delete" then (tc_doc-line-new.fact-qnty * tc_doc-line-new.price-rubl) else 0) -
     3961                     (if parmode <> "create" then (parfact-qnty * parprice-rubl) else 0)
     3962     tc_trn-doc.tot-rubl = tc_trn-doc.tot-rubl +
     3963                     (if parmode <> "delete" then (tc_doc-line-new.doc-qnty * tc_doc-line-new.price-rubl) else 0) -
     3964                     (if parmode <> "create" then (pardoc-qnty * parprice-rubl) else 0)
     3965                     .
     3966   if tc_trn-doc.status_ = 'факт':U then do:
     3967     assign
     3968         tc_trn-doc.tot-transp = tc_trn-doc.tot-transp +
     3969                     (if parmode <> "delete" then (tc_doc-line-new.fact-qnty * tc_doc-line-new.transport-rubl) else 0) -
     3970                     (if parmode <> "create" then (parfact-qnty * partransport-rubl) else 0)
     3971         tc_trn-doc.tot-other = tc_trn-doc.tot-other +
     3972                     (if parmode <> "delete" then (tc_doc-line-new.fact-qnty * tc_doc-line-new.other-rubl) else 0) -
     3973                     (if parmode <> "create" then (parfact-qnty * parother-rubl) else 0).
     3974   end.
     3975   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_ass-cost in g#lib-trn
     3976   (
     3977    input recid(tc_trn-doc)
     3978   ,input v-total-doc-line_tot-ovnew
     3979   ,input v-total-doc-line_fact-rublnew
     3980   ,input v-total-doc-line_fact-basenew
     3981   ,input v-total-doc-line_fact-qntynew
     3982   ,input v-total-doc-line_doc-qntynew
     3983   ,input v-total-doc-line_cli-qntynew
     3984   ,input v-total-doc-line_tot-ovold
     3985   ,input v-total-doc-line_fact-rublold
     3986   ,input v-total-doc-line_fact-baseold
     3987   ,input v-total-doc-line_fact-qntyold
     3988   ,input v-total-doc-line_doc-qntyold
     3989   ,input v-total-doc-line_cli-qntyold
     3990   )
     3991   no-error.
     3992     if error-status :error then undo, return error.
     3993   if parmode = "delete" then do:
     3994     assign tc_trn-doc.tot-lines = tc_trn-doc.tot-lines - 1.
     3995   end.
     3996   if parmode = "create" then do:
     3997     assign tc_trn-doc.tot-lines = tc_trn-doc.tot-lines + 1.
     3998   end.
     3999   if substr (tc_trn-doc.PS, 1, 1) = "@" then
     4000           tc_trn-doc.PS = "@  Строк в документе : " + string (tc_trn-doc.tot-lines).
     4001   end.
     4002   end procedure.
     4003   procedure lib-trn_chkwhole:
     4004   define input parameter pardoc-code  like ub.trn-doc.doc-code   no-undo.
     4005   define input parameter parartic     like ub.doc-line.artic     no-undo.
     4006   define input parameter parprod-type like ub.doc-line.prod-type no-undo.
     4007   define input parameter parprod-code like ub.doc-line.prod-code no-undo.
     4008   define input parameter parcli-qnty  like ub.doc-line.cli-qnty  no-undo.
     4009   define input parameter pardoc-qnty  like ub.doc-line.doc-qnty  no-undo.
     4010   define input parameter parfact-qnty like ub.doc-line.fact-qnty no-undo.
     4011   define input parameter parrecalc    as   logical               no-undo.
     4012   define variable is-unit-error as logical no-undo.
     4013   define variable g-log as logical no-undo.
     4014   define buffer cw-cli-units  for ub.units.
     4015   define buffer cw-base-units for ub.units.
     4016   define buffer cw-goods      for ub.goods.
     4017   define buffer cw-doc-line   for ub.doc-line.
     4018   define buffer cw-trn-doc    for ub.trn-doc.
     4019   find first cw-goods      where cw-goods.artic     = parartic                  and
     4020                                  cw-goods.prod-type = parprod-type              and
     4021                                  cw-goods.prod-code = parprod-code              no-lock.
     4022   find first cw-doc-line   where cw-doc-line.doc-code    = pardoc-code          and
     4023                                  cw-doc-line.artic       = cw-goods.artic       and
     4024                                  cw-doc-line.prod-type   = cw-goods.prod-type   and
     4025                                  cw-doc-line.prod-code   = cw-goods.prod-code   .
     4026   find first cw-base-units where cw-base-units.unit-name = cw-goods.unit-base   no-lock.
     4027   find first cw-trn-doc    where cw-trn-doc.doc-code     = pardoc-code          no-lock.
     4028   if cw-doc-line.unit-cli <> "" then do:
     4029      find first cw-cli-units  where cw-cli-units.unit-name  = cw-doc-line.unit-cli no-lock.
     4030      if lookup('шту':U, cw-cli-units.type) > 0 and
     4031         trunc(parcli-qnty, 0) <> parcli-qnty     then do:
     4032         run str/ck-uncli.p (input cw-goods.unit-base,
     4033                         input cw-goods.gds-code,
     4034                         input cw-trn-doc.obj-type,
     4035                         input cw-trn-doc.obj-code,
     4036                         input cw-trn-doc.hold-doc-code-parent,
     4037                         input cw-trn-doc.hold-doc-code-child,
     4038                         output is-unit-error) no-error.
     4039         if error-status :error then return error return-value.
     4040         if is-unit-error or
     4041            not (cw-trn-doc.doc-type = 'при':U and
     4042                 not cw-trn-doc.internal) then do:
     4043            return error substitute ("Товар : &1 &2 имеет штучную единицу измерения поставщика &3 Количество в единицах поставщика &4.",
     4044                   cw-goods.artic,
     4045                   cw-goods.gds-name,
     4046                   cw-doc-line.unit-cli,
     4047                   parcli-qnty).
     4048         end.
     4049         else do:
     4050           if not parrecalc then do:
     4051             return error substitute ("Товар : &1 &2 имеет штучную единицу измерения поставщика &3 Количество в единицах поставщика &4",
     4052                           cw-goods.artic,
     4053                           cw-goods.gds-name,
     4054                           cw-doc-line.unit-cli,
     4055                           parcli-qnty).
     4056           end.
     4057           else do:
     4058               assign cw-doc-line.unit-cli      =  cw-goods.unit-base
     4059                      cw-doc-line.cli-qnty      =  cw-doc-line.cli-qnty * cw-doc-line.cli-base-rate
     4060                      cw-doc-line.price-cli     =  cw-doc-line.price-cli / cw-doc-line.cli-base-rate
     4061                      cw-doc-line.cli-base-rate = 1.
     4062               run str/rc-price.p (input recid(cw-doc-line)) no-error.
     4063               return  " Изменены единицы измерения поставщика на: " + string (cw-doc-line.unit-cli) + " ".
     4064           end.
     4065         end.
     4066      end.
     4067   end.
     4068   if lookup('шту':U, cw-base-units.type) > 0  and
     4069      trunc (pardoc-qnty, 0) <> pardoc-qnty
     4070   then do:
     4071       return error substitute("Базовая единица товара &1  - штучная. Кол-во по документу должно быть целым.",
     4072                               cw-goods.unit-base).
     4073   end.
     4074   if lookup('шту':U, cw-base-units.type) > 0  and
     4075      trunc(parfact-qnty, 0) <> parfact-qnty
     4076   then do:
     4077       return error substitute ("Базовая единица товара &1 - штучная. Кол-во по факту должно быть целым.", cw-goods.unit-base).
     4078   end.
     4079   end procedure.
     4080   procedure lib-trn_crgdsdtl:
     4081   define input parameter parobj-code  like ub.clients.obj-code  no-undo.
     4082   define input parameter parobj-type  like ub.clients.obj-type  no-undo.
     4083   define input parameter pardoc-code  like ub.trn-doc.doc-code  no-undo.
     4084   define input parameter parartic     like ub.goods.artic       no-undo.
     4085   define input parameter parprod-code like ub.goods.prod-code   no-undo.
     4086   define input parameter parprod-type like ub.goods.prod-type   no-undo.
     4087   define input parameter parprt-code  like ub.gds-dtl.prt-code  no-undo.
     4088   define input parameter parcheck     as   logical              no-undo.
     4089   define variable        varis-new    as   logical              no-undo.
     4090   define buffer bf_gds-dtl  for ub.gds-dtl.
     4091   define buffer bf_clients  for ub.clients.
     4092   define buffer bf_trn-doc  for ub.trn-doc.
     4093   define buffer bf_goods    for ub.goods.
     4094   define buffer bf_bar-code for ub.bar-code.
     4095   do on error undo, return error return-value :
     4096   find first bf_gds-dtl where bf_gds-dtl.doc-code   = pardoc-code
     4097                           and bf_gds-dtl.artic      = parartic
     4098                           and bf_gds-dtl.prod-code  = parprod-code
     4099                           and bf_gds-dtl.prod-type  = parprod-type
     4100                           and bf_gds-dtl.prt-code   = parprt-code   no-error.
     4101   if not available bf_gds-dtl then do:
     4102      if parcheck = yes then do:
     4103         find first bf_clients where bf_clients.obj-type = parobj-type and
     4104                                     bf_clients.obj-code = parobj-code no-lock no-error.
     4105         if not available bf_clients then do:
     4106            return error subst("Создание признака невозможно. Не найден объект &1 &2.", parobj-type, parobj-code) .
     4107         end.
     4108         find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code no-lock no-error.
     4109         if not available bf_trn-doc then do:
     4110            return error subst("Создание признака невозможно. Не найден документ &1.", pardoc-code) .
     4111         end.
     4112         if bf_trn-doc.obj-type <> bf_clients.obj-type or
     4113            bf_trn-doc.obj-code <> bf_clients.obj-code then do:
     4114            return error subst("Создание признака невозможно. Документ &1 "
     4115                             + " не принадлежит объекту &2 &3 . ", bf_trn-doc.doc-code, bf_clients.obj-type, bf_clients.obj-code).
     4116         end.
     4117      end.
     4118      find first bf_goods where bf_goods.artic     = parartic     and
     4119                                bf_goods.prod-type = parprod-type and
     4120                                bf_goods.prod-code = parprod-code no-lock no-error.
     4121      if not available bf_goods then do:
     4122         return error subst("Создание признака невозможно. Не найден товар &1 &2 &3.", parartic, parprod-code, parprod-code).
     4123      end.
     4124      tr:
     4125      do transaction on error undo tr, return error return-value :
     4126   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4127   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run barcodcr in g#library
     4128     (input  bf_goods.gds-code
     4129     ,input  parprt-code
     4130     ,input  ''
     4131     ,input  ''
     4132     ,input  bf_goods.unit-base
     4133     ,input  ?
     4134     ,output varis-new
     4135     ,buffer bf_bar-code
     4136     )  .
     4137        run check-use-artic in this-procedure ( input "gds-dtl":U,
     4138                                                input parartic,
     4139                                                input parprod-type,
     4140                                                input parprod-code  ) no-error.
     4141        if error-status :error then do:
     4142          undo tr, return error substitute( 'lib-trn_crgdsdtl: &1', return-value ).
     4143        end.
     4144        create bf_gds-dtl.
     4145        assign
     4146          bf_gds-dtl.obj-code      = parobj-code
     4147          bf_gds-dtl.obj-type      = parobj-type
     4148          bf_gds-dtl.doc-code      = pardoc-code
     4149          bf_gds-dtl.artic         = parartic
     4150          bf_gds-dtl.prod-code     = parprod-code
     4151          bf_gds-dtl.prod-type     = parprod-type
     4152          bf_gds-dtl.prt-code      = parprt-code.
     4153      end.
     4154   end.
     4155   end.
     4156   end procedure.
     4157   procedure lib-trn_create-doc-line:
     4158   define input parameter parartic     like ub.doc-line.artic     no-undo.
     4159   define input parameter parprod-type like ub.doc-line.prod-type no-undo.
     4160   define input parameter parprod-code like ub.doc-line.prod-code no-undo.
     4161   define input parameter parrec-doc as recid no-undo.
     4162   define buffer cd_trn-doc  for ub.trn-doc.
     4163   define buffer cd_doc-line for ub.doc-line.
     4164   define buffer cd_goods    for ub.goods.
     4165   define buffer cd_sysconf  for ub.sysconf.
     4166   define buffer cd_gds-obj  for ub.gds-obj.
     4167   define variable v-host-code like ub.sysconf.host-code no-undo.
     4168   define variable v-cash-pay  like ub.sysconf.cash-pay  no-undo.
     4169   define variable varslt-pc   like ub.doc-line.slt-pc   no-undo.
     4170   define variable varvat-pc   like ub.doc-line.vat-pc   no-undo.
     4171   do on error undo, return error return-value :
     4172   find first cd_trn-doc where recid(cd_trn-doc) = parrec-doc.
     4173   find first cd_goods where cd_goods.artic     = parartic     and
     4174                             cd_goods.prod-type = parprod-type and
     4175                             cd_goods.prod-code = parprod-code no-lock.
     4176   find cd_doc-line where cd_doc-line.doc-code  = cd_trn-doc.doc-code
     4177                      and cd_doc-line.artic     = cd_goods.artic
     4178                      and cd_doc-line.prod-code = cd_goods.prod-code
     4179                      and cd_doc-line.prod-type = cd_goods.prod-type no-error.
     4180   if not available cd_doc-line then do:
     4181   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4182   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4183     (input  cd_trn-doc.obj-type
     4184     ,input  cd_trn-doc.obj-code
     4185     ,output v-host-code
     4186     )  .
     4187     find first cd_sysconf where cd_sysconf.host-code = v-host-code no-lock.
     4188     assign
     4189       v-cash-pay = cd_sysconf.cash-pay.
     4190     if cd_sysconf.cons-vat-pc = ? then do:
     4191       return error "У Вас не установлен НДС для консигнационного товара по фирме.".
     4192     end.
     4193   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
