     6040               + ",":U + 'rsrv-in-code':U   + "=":U + str-encode ( cs_bar-code.in-code  ,  "", ",=":U )
     6041               + ",":U + 'rsrv-part-code':U + "=":U + str-encode ( cs_bar-code.part-code,  "", ",=":U )
     6042               .
