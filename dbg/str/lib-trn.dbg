     7877                       end.
     7878                   if del_fin-ob.status_ <> 'факт':U or (del_fin-ob.status_ = 'факт':U and del_fin-ob.con-stat = 0) and v-del-fo then do :
     7879                     assign
     7880                       del_fin-ob.is-doc-del = yes.
     7881                       del_fin-ob-trn.is-doc-del = yes.
     7882                     delete del_fin-ob.
