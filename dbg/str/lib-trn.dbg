     1000   procedure valid-ren-art-tbl-list :
     1001     do
     1002     on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1003     on stop   undo, return error substitute( "&1. stop", vss-workfile )
     1004     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     1005     :
     1006       define variable v-std-list        as character no-undo .
     1007       define variable v-ignore-list     as character no-undo .
     1008       define variable v-special-list    as character no-undo .
     1009       assign
