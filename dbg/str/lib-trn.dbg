     6721   procedure lib-trn_crdocpl:
     6722     define input parameter  p-doc-code like ub.doc-line.doc-code no-undo .
     6723     define input parameter  p-gds-code like ub.goods.gds-code    no-undo .
     6724     define input parameter  p-pl-code  like ub.pl-gds.pl-code    no-undo .
     6725     define input parameter  p-obj-type like ub.doc-line.obj-type no-undo .
     6726     define input parameter  p-obj-code like ub.doc-line.obj-code no-undo .
     6727     define output parameter p-rowid    as   rowid                no-undo .
     6728     do transaction
     6729     on error undo, return error return-value
     6730     :
     6731       define buffer buf_doc-pl for ub.doc-pl .
     6732       find first buf_doc-pl share-lock
     6733         where buf_doc-pl.obj-type = p-obj-type
     6734           and buf_doc-pl.obj-code = p-obj-code
     6735           and buf_doc-pl.pl-code  = p-pl-code
     6736           and buf_doc-pl.out-code = p-doc-code
     6737           and buf_doc-pl.gds-code = p-gds-code
     6738         no-error.
     6739       if not available buf_doc-pl then do:
     6740         create buf_doc-pl.
     6741         assign
     6742           buf_doc-pl.obj-type         = p-obj-type
     6743           buf_doc-pl.obj-code         = p-obj-code
     6744           buf_doc-pl.pl-code          = p-pl-code
     6745           buf_doc-pl.out-code         = p-doc-code
     6746           buf_doc-pl.gds-code         = p-gds-code
     6747           buf_doc-pl.cli-qnty         = 0.0
     6748           buf_doc-pl.doc-qnty         = 0.0
     6749           buf_doc-pl.cli-doc-qnty     = 0.0
     6750           buf_doc-pl.fact-qnty        = 0.0
     6751           buf_doc-pl.cli-fact-qnty    = 0.0
     6752           buf_doc-pl.rest-af-qnty     = ?
     6753           buf_doc-pl.rest-bf-qnty     = ?
     6754           buf_doc-pl.cli-rest-af-qnty = ?
     6755           buf_doc-pl.cli-rest-bf-qnty = ?
     6756         .
     6757       end.
     6758       assign
     6759         p-rowid = rowid( buf_doc-pl )
     6760       .
     6761     end.
     6762   end procedure.
