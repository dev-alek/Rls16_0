     2666   procedure lib-trn_chpsltpc :
     2667   define input  parameter parinternal     like ub.trn-doc.internal     no-undo.
     2668   define input  parameter pardoc-type     like ub.trn-doc.doc-type     no-undo.
     2669   define input  parameter parpay-code     like ub.trn-doc.pay-code     no-undo.
     2670   define input  parameter parcash-pay     as   integer                 no-undo.
     2671   define input  parameter parslt-type     like ub.parts.slt-type       no-undo.
     2672   define input  parameter parext-doc-type like ub.trn-doc.ext-doc-type no-undo.
     2673   define output parameter parslt-yes      as   logical                 no-undo.
     2674   if not parinternal
     2675      and (    ( parpay-code = parcash-pay and can-do ('рас,возврат':U, pardoc-type) )
     2676            or ( pardoc-type = 'при':U   and parslt-type <> 'без':U           )
     2677            or parext-doc-type = 'ap':U
     2678          )
     2679   then do:
     2680     assign
     2681       parslt-yes = yes.
     2682   end.
     2683   else do:
     2684     assign
     2685       parslt-yes = no.
     2686   end.
     2687   end procedure.
     2688   procedure lib-trn_st-sltpc :
