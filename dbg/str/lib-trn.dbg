     7959                              , input recid (del_trn-doc)
     7960                              ) no-error .
     7961           if error-status :error then do:
     7962              run waitfram-hide in parhandle no-error.
     7963              undo, return error return-value .
     7964           end.
     7965         end.
     7966         if del_trn-doc.status_ = 'факт':U then do:
     7967           v-flag-del = false .
     7968           for each   del_turnover-buyer exclusive-lock where
     7969                      del_turnover-buyer.doc-code = del_trn-doc.doc-code :
     7970               delete del_turnover-buyer .
     7971               v-flag-del = true  .
     7972           end.
     7973           if v-flag-del = true then
     7974               run ref/calctur1.p ( input del_trn-doc.cli-type,
     7975                                   input del_trn-doc.cli-code,
     7976                                   input del_trn-doc.obj-type,
     7977                                   input del_trn-doc.obj-code,
     7978                                   input del_trn-doc.fact-order - 0.0000000001
     7979                                   ).
     7980         end.
     7981         run waitfram-hide in parhandle no-error.
     7982         delete del_trn-doc.
     7983       end.
     7984     end.
     7985   end procedure.
     7986   procedure lib-trn_chkaddln :
     7987   define input  parameter pardb-num       as integer   no-undo .
