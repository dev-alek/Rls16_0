     3044   end procedure.
     3045   procedure lib-trn_clcdocpr :
     3046   define input parameter parrec-doc               as recid                   no-undo.
     3047   define input parameter parargsum-base-doc-new   like ub.gds-dtl.price-base no-undo.
     3048   define input parameter parargsum-rubl-doc-new   like ub.gds-dtl.price-rubl no-undo.
     3049   define input parameter parargsum-base-fact-new  like ub.gds-dtl.price-base no-undo.
     3050   define input parameter parargsum-rubl-fact-new  like ub.gds-dtl.price-rubl no-undo.
     3051   define input parameter parargcount-new          as integer                 no-undo.
     3052   define input parameter parargsum-base-doc-old   like ub.gds-dtl.price-base no-undo.
     3053   define input parameter parargsum-rubl-doc-old   like ub.gds-dtl.price-rubl no-undo.
     3054   define input parameter parargsum-base-fact-old  like ub.gds-dtl.price-base no-undo.
     3055   define input parameter parargsum-rubl-fact-old  like ub.gds-dtl.price-rubl no-undo.
     3056   define input parameter parargcount-old          as integer                 no-undo.
     3057   define buffer ct_trn-doc for ub.trn-doc.
     3058   do on error undo, return error return-value :
     3059   find first ct_trn-doc where recid(ct_trn-doc) = parrec-doc.
     3060   assign
     3061       ct_trn-doc.tot-doc   = ct_trn-doc.tot-doc   + parargsum-base-doc-new   - parargsum-base-doc-old
     3062       ct_trn-doc.tot-rubl  = ct_trn-doc.tot-rubl  + parargsum-rubl-doc-new   - parargsum-rubl-doc-old
     3063       ct_trn-doc.tot-fact  = ct_trn-doc.tot-fact  + parargsum-base-fact-new  - parargsum-base-fact-old
     3064       ct_trn-doc.tot-sale  = ct_trn-doc.tot-sale  + parargsum-rubl-fact-new  - parargsum-rubl-fact-old
     3065       ct_trn-doc.tot-lines = ct_trn-doc.tot-lines + parargcount-new          - parargcount-old
     3066       .
     3067   if not can-do ('процент,карта,группа,сумма,строка,прайс-лист':U, ct_trn-doc.discnt-type) and
     3068      ct_trn-doc.discnt-type <> 'касс':U              and
     3069      ct_trn-doc.discnt-type <> 'прво':U           and
     3070      ct_trn-doc.internal    =  no                        then
     3071     assign
     3072       ct_trn-doc.discnt-type = 'процент':U
     3073       ct_trn-doc.discnt-pc = 0.
     3074   if ct_trn-doc.discnt-type = 'сумма':U then do:
     3075     if ct_trn-doc.print-rubl then do:
     3076       assign
     3077         ct_trn-doc.discnt-pc = ct_trn-doc.discnt-rubl * 100 / ct_trn-doc.tot-rubl
     3078         ct_trn-doc.tot-calc  = ct_trn-doc.discnt-rubl * ct_trn-doc.base-scale / ct_trn-doc.base-rate.
     3079     end.
     3080     else do:
     3081       assign
     3082         ct_trn-doc.discnt-pc   = ct_trn-doc.tot-calc * 100 / ct_trn-doc.tot-doc
     3083         ct_trn-doc.discnt-rubl = ct_trn-doc.tot-calc * ct_trn-doc.base-rate / ct_trn-doc.base-scale.
     3084     end.
     3085   if ct_trn-doc.discnt-pc = ? then do:
     3086     assign
     3087       ct_trn-doc.discnt-pc = 0.
     3088   end.
     3089   end.
     3090   end.
     3091   end procedure.
     3092   procedure lib-trn_clcpttrn:
     3093   define input parameter parrec-doc                 as   recid               no-undo.
     3094   define input parameter pardiscnt-base-fact-new  like ub.trn-doc.tot-calc no-undo.
     3095   define input parameter pardiscnt-rubl-fact-new  like ub.trn-doc.tot-calc no-undo.
     3096   define input parameter parroad-tax-fact-new     like ub.trn-doc.tot-calc no-undo.
     3097   define input parameter parexcise-fact-new       like ub.trn-doc.tot-calc no-undo.
     3098   define input parameter parslt-fact-base-new     like ub.trn-doc.tot-calc no-undo.
     3099   define input parameter parvat-fact-base-new     like ub.trn-doc.tot-calc no-undo.
     3100   define input parameter parslt-fact-rubl-new     like ub.trn-doc.tot-calc no-undo.
     3101   define input parameter parvat-fact-rubl-new     like ub.trn-doc.tot-calc no-undo.
     3102   define input parameter pardiscnt-base-fact-old  like ub.trn-doc.tot-calc no-undo.
     3103   define input parameter pardiscnt-rubl-fact-old  like ub.trn-doc.tot-calc no-undo.
     3104   define input parameter parroad-tax-fact-old     like ub.trn-doc.tot-calc no-undo.
     3105   define input parameter parexcise-fact-old       like ub.trn-doc.tot-calc no-undo.
     3106   define input parameter parslt-fact-base-old     like ub.trn-doc.tot-calc no-undo.
     3107   define input parameter parvat-fact-base-old     like ub.trn-doc.tot-calc no-undo.
     3108   define input parameter parslt-fact-rubl-old     like ub.trn-doc.tot-calc no-undo.
     3109   define input parameter parvat-fact-rubl-old     like ub.trn-doc.tot-calc no-undo.
     3110   define buffer ct_trn-doc for ub.trn-doc.
     3111   do on error undo, return error return-value :
     3112   find first ct_trn-doc where recid(ct_trn-doc) = parrec-doc.
     3113   if ct_trn-doc.discnt-type <> 'сумма':U then do:
     3114       assign
     3115         ct_trn-doc.tot-calc    = ct_trn-doc.tot-calc    + pardiscnt-base-fact-new - pardiscnt-base-fact-old
     3116         ct_trn-doc.discnt-rubl = ct_trn-doc.discnt-rubl + pardiscnt-rubl-fact-new - pardiscnt-rubl-fact-old .
     3117   end.
     3118   if not can-do ('процент,карта,группа':U, ct_trn-doc.discnt-type) then do:
     3119     assign
     3120       ct_trn-doc.discnt-pc   = ( if ct_trn-doc.print-rubl then ( if ct_trn-doc.tot-sale = 0 then 0 else ct_trn-doc.discnt-rubl * 100 / ct_trn-doc.tot-sale )
     3121                                                           else ( if ct_trn-doc.tot-fact = 0 then 0 else ct_trn-doc.tot-calc    * 100 / ct_trn-doc.tot-fact ) ).
     3122     if ct_trn-doc.discnt-pc = ? then do:
     3123       assign
     3124         ct_trn-doc.discnt-pc = 0.
     3125     end.
     3126   end.
     3127   assign ct_trn-doc.tot-cli = ct_trn-doc.tot-doc - ct_trn-doc.tot-calc.
     3128   ASSIGN
     3129      ct_trn-doc.road-tax = ct_trn-doc.road-tax + parroad-tax-fact-new - parroad-tax-fact-old
     3130      ct_trn-doc.excise   = ct_trn-doc.excise   + parexcise-fact-new   - parexcise-fact-old
     3131      ct_trn-doc.slt-base = ct_trn-doc.slt-base + parslt-fact-base-new - parslt-fact-base-old
     3132      ct_trn-doc.vat-base = ct_trn-doc.vat-base + parvat-fact-base-new - parvat-fact-base-old
     3133      ct_trn-doc.slt-rubl = ct_trn-doc.slt-rubl + parslt-fact-rubl-new - parslt-fact-rubl-old
     3134      ct_trn-doc.vat-rubl = ct_trn-doc.vat-rubl + parvat-fact-rubl-new - parvat-fact-rubl-old
     3135      .
     3136   END.
     3137   end procedure.
     3138   procedure lib-trn_fill-ext-inc:
     3139   define input parameter parparentproc    AS WIDGET-HANDLE               NO-UNDO.
     3140   define input parameter pardoc-code      like ub.trn-doc.doc-code       no-undo.
     3141   define input parameter parartic         like ub.doc-line.artic         no-undo.
     3142   define input parameter parprod-type     like ub.doc-line.prod-type     no-undo.
     3143   define input parameter parprod-code     like ub.doc-line.prod-code     no-undo.
     3144   define input parameter parprice-base    like ub.doc-line.price-base    no-undo.
     3145   define input parameter parprice-rubl    like ub.doc-line.price-rubl    no-undo.
     3146   define input parameter parcli-base-rate like ub.doc-line.cli-base-rate no-undo.
     3147   define input parameter parprice-vat     like ub.doc-line.price-base no-undo.
     3148   define input parameter paradd-param     as   character              no-undo.
     3149   define buffer ei_trn-doc  for ub.trn-doc.
     3150   define buffer ei_gds-dtl  for ub.gds-dtl.
     3151   do on error undo, return error return-value :
     3152   find first ei_trn-doc where ei_trn-doc.doc-code = pardoc-code.
     3153   if ei_trn-doc.doc-type = 'при':U and
     3154      ei_trn-doc.internal = no        then do:
     3155       for each ei_gds-dtl where ei_gds-dtl.doc-code  = ei_trn-doc.doc-code   and
     3156                                 ei_gds-dtl.artic     = parartic     and
     3157                                 ei_gds-dtl.prod-code = parprod-code and
     3158                                 ei_gds-dtl.prod-type = parprod-type :
     3159          assign ei_gds-dtl.price-base = parprice-base
     3160                 ei_gds-dtl.price-rubl = parprice-rubl.
     3161       end.
     3162       run trg/partsupd.p
     3163         (input parparentproc
     3164         ,input ei_trn-doc.doc-code
     3165         ,input ei_trn-doc.obj-type
     3166         ,input ei_trn-doc.obj-code
     3167         ,input parartic
     3168         ,input parprod-type
     3169         ,input parprod-code
     3170         ,input true
     3171         ,input paradd-param
     3172         ) no-error.
     3173      if error-status :error then do:
     3174         undo, return error.
     3175      end.
     3176   end.
     3177   end.
     3178   end procedure.
     3179   procedure lib-trn_have-vat-slt:
     3180   define input  parameter pardoc-code     like ub.trn-doc.doc-code no-undo.
     3181   define output parameter parhave-vat-slt as   logical             no-undo.
     3182   define buffer bf_trn-doc for ub.trn-doc.
     3183   define buffer bf_sysconf for ub.sysconf.
     3184   define variable varenvd as character no-undo.
     3185   define variable vartype as character no-undo.
     3186   do on error undo, return error return-value :
     3187   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input pardoc-code ,
     3188                           input 'envd':U ,
     3189                          output varenvd ,
     3190                          output vartype )  .
     3191   if varenvd <> "yes":u then do:
     3192     assign
     3193       parhave-vat-slt = yes.
     3194   end.
     3195   else do:
     3196   find first bf_trn-doc where bf_trn-doc.doc-code  = pardoc-code          no-lock.
     3197   find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     3198     if ( bf_trn-doc.ext-doc-type = 'es':U                                               or
     3199          bf_trn-doc.ext-doc-type = 'rs':U                                           or
     3200         (bf_trn-doc.ext-doc-type = 'ee':U     and bf_sysconf.cash-pay = bf_trn-doc.pay-code) or
     3201         (bf_trn-doc.ext-doc-type = 're':U and bf_sysconf.cash-pay = bf_trn-doc.pay-code)
     3202        ) then do:
     3203       assign
     3204         parhave-vat-slt = no.
     3205     end.
     3206     else do:
     3207       assign
     3208         parhave-vat-slt = yes.
     3209     end.
     3210     end.
     3211   end.
     3212   end procedure.
     3213   procedure lib-trn_in-vat:
     3214   define input  parameter pardoc-code-or-zone         as   character               no-undo.
     3215   define input  parameter parbase-rate                like ub.trn-doc.base-rate    no-undo.
     3216   define input  parameter parbase-scale               like ub.trn-doc.base-scale   no-undo.
     3217   define input  parameter parexch-rate                like ub.trn-doc.exch-rate    no-undo.
     3218   define input  parameter parexch-scale               like ub.trn-doc.exch-scale   no-undo.
     3219   define input  parameter parvat-type                 like ub.parts.vat-type       no-undo.
     3220   define input  parameter parslt-type                 like ub.parts.slt-type       no-undo.
     3221   define input  parameter parartic                    like ub.parts.artic          no-undo.
     3222   define input  parameter parprod-type                like ub.parts.prod-type      no-undo.
     3223   define input  parameter parprod-code                like ub.parts.prod-code      no-undo.
     3224   define input  parameter parpr-cli                   like ub.parts.price-cli      no-undo.
     3225   define input  parameter parcli-base-rate            like ub.parts.cli-base-rate  no-undo.
     3226   define input  parameter parpr-rubl                  like ub.parts.price-rubl     no-undo.
     3227   define input  parameter parvat-pc                   like ub.parts.slt-pc         no-undo.
     3228   define input  parameter parslt-pc                   like ub.parts.slt-pc         no-undo.
     3229   define input  parameter parroad-tax                 like ub.parts.road-tax-rubl  no-undo.
     3230   define input  parameter partransport-rubl           like ub.parts.transport-rubl no-undo.
     3231   define input  parameter parother-rubl               like ub.parts.other-rubl     no-undo.
     3232   define output parameter parprice-cli                like ub.doc-line.price-rubl no-undo.
     3233   define output parameter parprice-cli-unit-base      like ub.doc-line.price-rubl no-undo.
     3234   define output parameter parprice-road-tax           like ub.doc-line.price-rubl no-undo.
     3235   define output parameter parprice-other-exp          like ub.doc-line.price-rubl no-undo.
     3236   define output parameter parprice-transport-exp      like ub.doc-line.price-rubl no-undo.
     3237   define output parameter parprice-without-abs        like ub.doc-line.price-rubl no-undo.
     3238   define output parameter parprice-slt                like ub.doc-line.price-rubl no-undo.
     3239   define output parameter parprice-no-slt             like ub.doc-line.price-rubl no-undo.
     3240   define output parameter parprice-vat                like ub.doc-line.price-rubl no-undo.
     3241   define output parameter parprice-no-vat-slt         like ub.doc-line.price-rubl no-undo.
     3242   define output parameter parprice-rubl               like ub.doc-line.price-rubl no-undo.
     3243   define output parameter parprice-road-tax-rubl      like ub.doc-line.price-rubl no-undo.
     3244   define output parameter parprice-other-exp-rubl     like ub.doc-line.price-rubl no-undo.
     3245   define output parameter parprice-transport-exp-rubl like ub.doc-line.price-rubl no-undo.
     3246   define output parameter parprice-without-abs-rubl   like ub.doc-line.price-rubl no-undo.
     3247   define output parameter parprice-slt-rubl           like ub.doc-line.price-rubl no-undo.
     3248   define output parameter parprice-no-slt-rubl        like ub.doc-line.price-rubl no-undo.
     3249   define output parameter parprice-vat-rubl           like ub.doc-line.price-rubl no-undo.
     3250   define output parameter parprice-no-vat-slt-rubl    like ub.doc-line.price-rubl no-undo.
     3251   define output parameter parprice-base               like ub.doc-line.price-base no-undo.
     3252   define output parameter parprice-road-tax-base      like ub.doc-line.price-base no-undo.
     3253   define output parameter parprice-other-exp-base     like ub.doc-line.price-base no-undo.
     3254   define output parameter parprice-transport-exp-base like ub.doc-line.price-base no-undo.
     3255   define output parameter parprice-without-abs-base   like ub.doc-line.price-base no-undo.
     3256   define output parameter parprice-slt-base           like ub.doc-line.price-base no-undo.
     3257   define output parameter parprice-no-slt-base        like ub.doc-line.price-base no-undo.
     3258   define output parameter parprice-vat-base           like ub.doc-line.price-base no-undo.
     3259   define output parameter parprice-no-vat-slt-base    like ub.doc-line.price-base no-undo.
     3260   define buffer iv-goods    for ub.goods.
     3261   define buffer iv-units    for ub.units.
     3262   define variable vartype   as character no-undo.
     3263   define variable varpetrol as logical   no-undo.
     3264   define variable varpieces as logical   no-undo.
     3265   define variable varhave-vat-slt as logical no-undo.
     3266   define buffer buf_trn-doc for ub.trn-doc .
     3267   do
     3268   on error undo, return error return-value
     3269   :
     3270   if pardoc-code-or-zone = "zakaz":u then do:
     3271     assign
     3272       varhave-vat-slt  = yes
     3273       ptrlprop-expptrl = 'weight':U
     3274     .
     3275   end.
     3276   else do:
     3277     run lib-trn_have-vat-slt in this-procedure
     3278       (input  pardoc-code-or-zone,
     3279        output varhave-vat-slt).
     3280     find first buf_trn-doc no-lock
     3281       where buf_trn-doc.doc-code = pardoc-code-or-zone
     3282       no-error .
     3283     if available buf_trn-doc then do:
     3284   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3285   run get-ptrl-prop in this-procedure
     3286     ( input buf_trn-doc.obj-type
     3287     , input buf_trn-doc.obj-code
     3288     ) .
     3289       def var varvalue as character no-undo.
     3290       find first ub.goods no-lock where
     3291               ub.goods.artic = parartic
     3292           and ub.goods.prod-type = parprod-type
     3293           and ub.goods.prod-code = parprod-code.
     3294       run gds-attr-value in this-procedure
     3295         (  input ub.goods.gds-code
     3296         ,  input 'fuel-type':U
     3297         , output varvalue
     3298         , output vartype
     3299         ) no-error .
     3300       if varvalue = 'lgas' then
     3301       do:
     3302         ptrlprop-expptrl = 'weight':U.
     3303       end.
     3304       find first ub.goods no-lock where
     3305               ub.goods.artic = parartic
     3306           and ub.goods.prod-type = parprod-type
     3307           and ub.goods.prod-code = parprod-code.
     3308       run gds-attr-value in this-procedure
     3309         (  input ub.goods.gds-code
     3310         ,  input 'fuel-type':U
     3311         , output varvalue
     3312         , output vartype
     3313         ) no-error .
     3314       if varvalue = 'lgas' then
     3315       do:
     3316         ptrlprop-expptrl = 'weight':U.
     3317       end.
     3318     end.
     3319   end.
     3320   find first iv-goods where iv-goods.artic     = parartic       and
     3321                             iv-goods.prod-type = parprod-type   and
     3322                             iv-goods.prod-code = parprod-code   no-lock.
     3323   find first iv-units where iv-units.unit-name = iv-goods.unit-base no-lock.
     3324   if lookup('2ед':U, iv-units.type) = 0
     3325     and not ( lookup('топ':U,  iv-units.type) > 0
     3326               and lookup('шту':U, iv-units.type) > 0
     3327             )
     3328     and not ( lookup('топ':U,  iv-units.type) > 0
     3329               and lookup('шту':U, iv-units.type) = 0
     3330               and lookup( ptrlprop-inpptrl, "volume,volume+" ) > 0
     3331             )
     3332   then do:
     3333     assign vartype = "cli".
     3334   end.
     3335   else do:
     3336     assign vartype = "rubl".
     3337   end.
     3338   if vartype = "rubl" then do:
     3339     assign parprice-rubl = parpr-rubl.
     3340     run lib-trn_in-vat-incl in this-procedure (input  parother-rubl                  ,
     3341                              input  partransport-rubl              ,
     3342                              input  parroad-tax                    ,
     3343                              input  parprice-rubl                  ,
     3344                              input  parvat-pc                      ,
     3345                              input  parslt-pc                      ,
     3346                              input  parbase-rate                   ,
     3347                              input  parbase-scale                  ,
     3348                              input  varhave-vat-slt                ,
     3349                              output parprice-other-exp-rubl        ,
     3350                              output parprice-transport-exp-rubl    ,
     3351                              output parprice-road-tax-rubl         ,
     3352                              output parprice-without-abs-rubl      ,
     3353                              output parprice-SLT-rubl              ,
     3354                              output parprice-no-slt-rubl           ,
     3355                              output parprice-VAT-rubl              ,
     3356                              output parprice-no-VAT-slt-rubl    ) no-error.
     3357     if error-status :error then do:
     3358        return error return-value.
     3359     end.
     3360     assign parprice-cli-unit-base = (parprice-no-vat-slt-rubl +
     3361                            (if parvat-type =  'в т. ч.':U then parprice-vat-rubl else 0) +
     3362                            (if parslt-type =  'в т. ч.':U then parprice-slt-rubl else 0) )
     3363                            / parexch-rate  * parexch-scale
     3364            parprice-cli = parprice-cli-unit-base * parcli-base-rate.
     3365   end.
     3366   else do:
     3367     assign parprice-cli           = parpr-cli
     3368            parprice-cli-unit-base = parprice-cli / parcli-base-rate.
     3369   end.
     3370   ASSIGN
     3371   parprice-other-exp     = (if parother-rubl     <> ? then parother-rubl     else 0)
     3372                            / parexch-rate * parexch-scale
     3373                            * parcli-base-rate
     3374   parprice-transport-exp = (if partransport-rubl <> ? then partransport-rubl else 0)
     3375                            / parexch-rate * parexch-scale
     3376                            * parcli-base-rate
     3377   .
     3378   if g-varr-b = "rubl":u then do:
     3379     assign
     3380       parprice-road-tax      = parroad-tax
     3381                                / parexch-rate * parexch-scale
     3382                                * parcli-base-rate
     3383     .
     3384   end.
     3385   else do:
     3386     assign
     3387       parprice-road-tax      = parroad-tax
     3388                                * parbase-rate / parbase-scale
     3389                                / parexch-rate * parexch-scale
     3390                                * parcli-base-rate
     3391     .
     3392   end.
     3393   case parvat-type:
     3394   when 'без':U then do:
     3395     if parvat-pc <> 0 then do:
     3396       return error substitute(" В документе установлен тип НДС - без, а ставка НДС отлична от 0.( = &1 )" ,parvat-pc ) .
     3397     end.
     3398     if parslt-type = 'нет':U      or
     3399        parslt-Type = 'без':U then do:
     3400       assign
     3401         parprice-VAT        = 0
     3402         parprice-slt        = (if varhave-vat-slt <> yes then 0 else parprice-cli * parslt-pc / 100)
     3403         parprice-no-vat-slt = parprice-cli.
     3404     end.
     3405     else do:
     3406       assign
     3407         parprice-VAT        = 0
     3408         parprice-slt        = (if varhave-vat-slt <> yes then 0 else parprice-cli * parslt-pc / (100 + parslt-pc))
     3409         parprice-no-vat-slt = parprice-cli - parprice-slt.
     3410     end.
     3411   end.
     3412   when 'нет':U then do:
     3413     if parslt-type = 'нет':U      or
     3414        parslt-Type = 'без':U then do:
     3415       assign
     3416         parprice-VAT        = (if varhave-vat-slt <> yes then 0 else parprice-cli                         * parvat-pc / 100)
     3417         parprice-slt        = (if varhave-vat-slt <> yes then 0 else parprice-cli * (1 + parvat-pc / 100) * parslt-pc / 100)
     3418         parprice-no-vat-slt = parprice-cli.
     3419     end.
     3420     else do:
     3421       assign
     3422         parprice-VAT        = (if varhave-vat-slt <> yes then 0 else parprice-cli / ((100 / parvat-pc) * (1 + parslt-pc / 100) + parslt-pc / 100))
     3423         parprice-slt        = (if varhave-vat-slt <> yes then 0 else parprice-cli * ( 1 - 1 / (1 + parslt-pc / 100 + parslt-pc / 100 * parvat-pc / 100 )))
     3424         parprice-no-vat-slt = parprice-cli - parprice-slt.
     3425     end.
     3426   end.
     3427   when 'в т. ч.':U then do:
     3428     if parslt-type = 'нет':U      or
     3429        parslt-Type = 'без':U then do:
     3430       assign
     3431         parprice-VAT        = (if varhave-vat-slt <> yes then 0 else parprice-cli   * parvat-pc / (100 + parvat-pc))
     3432         parprice-slt        = (if varhave-vat-slt <> yes then 0 else parprice-cli   * parslt-pc / 100)
     3433         parprice-no-vat-slt = parprice-cli - parprice-VAT.
     3434     end.
     3435     else do:
     3436       assign
     3437         parprice-VAT        = (if varhave-vat-slt <> yes then 0 else parprice-cli * (100 / ( 100 + parslt-pc)) * parvat-pc / (100 + parvat-pc))
     3438         parprice-slt        = (if varhave-vat-slt <> yes then 0 else parprice-cli                              * parslt-pc / (100 + parslt-pc))
     3439         parprice-no-vat-slt = parprice-cli - parprice-VAT - parprice-SLT.
     3440     end.
     3441   end.
     3442   end case.
     3443   assign parprice-without-abs = parprice-no-vat-slt + parprice-VAT + parprice-slt.
     3444   if vartype = "cli" then do:
     3445     assign
     3446     parprice-rubl  = (parprice-without-abs
     3447                       * parexch-rate / parexch-scale
     3448                       / parcli-base-rate
     3449                       +
     3450                       parroad-tax * (if g-varr-b = "base":u then parbase-rate  /  parbase-scale else 1) +
     3451                       (if partransport-rubl <> ? then partransport-rubl else 0)  +
     3452                       (if parother-rubl     <> ? then parother-rubl     else 0)
     3453                       ).
     3454     run lib-trn_in-vat-incl in this-procedure (input  parother-rubl                  ,
     3455                              input  partransport-rubl              ,
     3456                              input  parroad-tax                    ,
     3457                              input  parprice-rubl                  ,
     3458                              input  parvat-pc                      ,
     3459                              input  parslt-pc                      ,
     3460                              input  parbase-rate                   ,
     3461                              input  parbase-scale                  ,
     3462                              input  varhave-vat-slt                ,
     3463                              output parprice-other-exp-rubl        ,
     3464                              output parprice-transport-exp-rubl    ,
     3465                              output parprice-road-tax-rubl         ,
     3466                              output parprice-without-abs-rubl      ,
     3467                              output parprice-SLT-rubl              ,
     3468                              output parprice-no-slt-rubl           ,
     3469                              output parprice-VAT-rubl              ,
     3470                              output parprice-no-VAT-slt-rubl    ) no-error.
     3471     if error-status :error then do:
     3472        return error return-value.
     3473     end.
     3474   end.
     3475   assign
     3476   parprice-base               = parprice-rubl               / parbase-rate * parbase-scale
     3477   parprice-road-tax-base      = parprice-road-tax-rubl      / parbase-rate * parbase-scale
     3478   parprice-other-exp-base     = parprice-other-exp-rubl     / parbase-rate * parbase-scale
     3479   parprice-transport-exp-base = parprice-transport-exp-rubl / parbase-rate * parbase-scale
     3480   parprice-without-abs-base   = parprice-without-abs-rubl   / parbase-rate * parbase-scale
     3481   parprice-slt-base           = parprice-slt-rubl           / parbase-rate * parbase-scale
     3482   parprice-no-slt-base        = parprice-no-slt-rubl        / parbase-rate * parbase-scale
     3483   parprice-vat-base           = parprice-vat-rubl           / parbase-rate * parbase-scale
     3484   parprice-no-vat-slt-base    = parprice-no-vat-slt-rubl    / parbase-rate * parbase-scale
     3485   .
     3486   end.
     3487   end procedure.
     3488   procedure lib-trn_in-vat-incl:
     3489   define input  parameter parother-rubl                like ub.parts.other-rubl     no-undo.
     3490   define input  parameter partransport-rubl            like ub.parts.transport-rubl no-undo.
     3491   define input  parameter parroad-tax                  like ub.parts.road-tax-base  no-undo.
     3492   define input  parameter parpr-rubl                   like ub.parts.price-rubl     no-undo.
     3493   define input  parameter parvat-pc                    like ub.parts.vat-pc         no-undo.
     3494   define input  parameter parslt-pc                    like ub.parts.slt-pc         no-undo.
     3495   define input  parameter parbase-rate                 like ub.trn-doc.base-rate    no-undo.
     3496   define input  parameter parbase-scale                like ub.trn-doc.base-scale   no-undo.
     3497   define input  parameter parhave-vat-slt              as   logical                 no-undo.
     3498   define output parameter parprice-other-exp-rubl      like ub.parts.other-rubl     no-undo.
     3499   define output parameter parprice-transport-exp-rubl  like ub.parts.transport-rubl no-undo.
     3500   define output parameter parprice-road-tax-rubl       like ub.parts.road-tax-rubl  no-undo.
     3501   define output parameter parprice-without-abs-rubl    like ub.parts.price-rubl     no-undo.
     3502   define output parameter parprice-SLT-rubl            like ub.parts.price-rubl     no-undo.
     3503   define output parameter parprice-no-slt-rubl         like ub.parts.price-rubl     no-undo.
     3504   define output parameter parprice-VAT-rubl            like ub.parts.price-rubl     no-undo.
     3505   define output parameter parprice-no-VAT-slt-rubl     like ub.parts.price-rubl     no-undo.
     3506   define variable varr-b as character no-undo.
     3507   do on error undo, return error return-value :
     3508     ASSIGN
     3509     parprice-other-exp-rubl     = (if parother-rubl     <> ? then parother-rubl     else 0)
     3510     parprice-transport-exp-rubl = (if partransport-rubl <> ? then partransport-rubl else 0)
     3511     parprice-road-tax-rubl      = parroad-tax *  (if varr-b = "base":u THEN parbase-rate / parbase-scale else 1 )
     3512     parprice-without-abs-rubl   = parpr-rubl                  -
     3513                                   parprice-other-exp-rubl     -
     3514                                   parprice-transport-exp-rubl -
     3515                                   parprice-road-tax-rubl.
     3516     assign parprice-SLT-rubl    = (if parhave-vat-slt <> yes then 0 else parprice-without-abs-rubl * parslt-pc / (parslt-pc + 100))
     3517            parprice-no-slt-rubl = parprice-without-abs-rubl - parprice-slt-rubl.
     3518     assign
     3519         parprice-VAT-rubl        = (if parhave-vat-slt <> yes then 0 else parprice-no-slt-rubl * parvat-pc / (parvat-pc + 100))
     3520         parprice-no-VAT-slt-rubl = parprice-no-slt-rubl - parprice-VAT-rubl.
     3521   end.
     3522   end procedure.
     3523   procedure lib-trn_is-petrl :
     3524     define  input parameter parartic        like ub.goods.artic     no-undo.
     3525     define  input parameter parprod-type    like ub.goods.prod-type no-undo.
     3526     define  input parameter parprod-code    like ub.goods.prod-code no-undo.
     3527     define output parameter paris-petrolium as   logical            no-undo.
     3528     define output parameter paris-pieces    as   logical            no-undo.
     3529     define buffer bf_goods for ub.goods.
     3530     define buffer bf_units for ub.units.
     3531     do on error undo, return error
     3532                 substitute( 'lib-trn_is-petrl: ошибка определения товара на топливо: товар &1 ' + if parprod-type eq ? then '(код &3).' else '(производитель &2 &3).',
     3533                             parartic, parprod-type, parprod-code ) :
     3534       if parprod-type ne ?
     3535       then
     3536          find first bf_goods no-lock where
     3537                     bf_goods.artic     = parartic     and
     3538                     bf_goods.prod-type = parprod-type and
     3539                     bf_goods.prod-code = parprod-code no-error.
     3540       else
     3541          find first bf_goods no-lock where
     3542                     bf_goods.gds-code     = parprod-code no-error.
     3543       if not available bf_goods then do:
     3544         undo, return error substitute( "lib-trn_is-petrl: не найден товар &1 " + if parprod-type eq ? then '(код &3).' else '(производитель &2 &3).',
     3545                                        parartic, parprod-type, parprod-code ).
     3546       end.
     3547       find first bf_units no-lock where bf_units.unit-name = bf_goods.unit-base no-error.
     3548       if not available bf_units then do:
     3549         return error substitute( 'lib-trn_is-petrl: не найдена базовая ед.изм. "&1" в товаре &2 ' + if parprod-type eq ? then '(код &4).' else '(производитель &3 &4).',
     3550                                  bf_goods.unit-base, parartic, parprod-type, parprod-code ).
     3551           end.
     3552       assign paris-petrolium = ( if lookup( 'топ':U, bf_units.type ) > 0 then yes else no ).
     3553       if lookup( 'шту':U, bf_units.type ) = 0 then do:
     3554         if paris-petrolium = yes and lookup( 'дро':U, bf_units.type ) = 0 then do:
     3555           undo, return error substitute( 'lib-trn_is-petrl: Неверная связка типов единиц измерения для топлива: "&1" .',
     3556                                          bf_units.type ).
     3557         end.
     3558         assign paris-pieces = no.
     3559       end.
     3560       else do:
     3561         assign paris-pieces = yes.
     3562       end.
     3563     end.
     3564   end procedure.
