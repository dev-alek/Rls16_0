     7868                   :
     7869                   for each bf_fin-ob-trn where bf_fin-ob-trn.doc-code = del_fin-ob.doc-code and
     7870                                                    bf_fin-ob-trn.trn-doc-code <> del_trn-doc.doc-code      no-lock:
     7871                         v-kol-trn-fo = v-kol-trn-fo + 1.
     7872                   end.
     7873                       if v-kol-trn-fo > 0 then do :
     7874                         assign
