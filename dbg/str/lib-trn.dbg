     9148         crt_gds-dtl.price-rubl   = tt-gds-dtl.price-rubl.
     9149       if can-do ('процент,карта,группа,сумма,строка,прайс-лист':U, pardiscnt-type) then do:
     9150         assign
     9151           crt_gds-dtl.discnt-base  = tt-gds-dtl.discnt-base
     9152           crt_gds-dtl.discnt-rubl  = tt-gds-dtl.discnt-rubl
     9153           crt_gds-dtl.discnt-pc    = tt-gds-dtl.discnt-pc
     9154           crt_gds-dtl.discnt-type  = tt-gds-dtl.discnt-type.
     9155       end.
     9156       if crt_trn-doc.ext-doc-type = 'ep':U  and
     9157          pardoc-type = 'при':U                           and
     9158          parinternal = no                                  and
     9159          crt_trn-doc.cli-type = parcli-type                and
     9160          crt_trn-doc.cli-code = parcli-code                then do:
     9161         if parexch-code = 0         and
     9162            parvat-type = 'в т. ч.':U then do:
     9163            assign
     9164              crt_gds-dtl.price-rubl = tt-doc-line.price-rubl - tt-doc-line.transport-rubl - tt-doc-line.other-rubl
     9165              crt_gds-dtl.price-base = crt_gds-dtl.price-rubl / crt_trn-doc.base-rate * crt_trn-doc.base-scale
     9166              crt_gds-dtl.ov         = yes.
     9167         end.
     9168         if parexch-code = parglob-base-code and
     9169            parvat-type = 'в т. ч.':U then do:
     9170            assign
     9171              crt_gds-dtl.price-base = tt-doc-line.price-base - tt-doc-line.transport-base - tt-doc-line.other-base
     9172              crt_gds-dtl.price-rubl = crt_gds-dtl.price-base * crt_trn-doc.base-rate / crt_trn-doc.base-scale
     9173              crt_gds-dtl.ov         = yes
     9174            .
     9175         end.
     9176       end.
     9177       if end-price then do:
     9178         assign
     9179           crt_gds-dtl.ov             = yes
     9180           crt_gds-dtl.price-base     = tt-gds-dtl.price-base
     9181           crt_gds-dtl.discnt-base    = tt-gds-dtl.discnt-base
     9182           crt_gds-dtl.price-rubl     = tt-gds-dtl.price-rubl
     9183           crt_gds-dtl.discnt-rubl    = tt-gds-dtl.discnt-rubl
     9184           crt_gds-dtl.discnt-pc      = tt-gds-dtl.discnt-pc
     9185           crt_gds-dtl.discnt-type    = (if crt_trn-doc.discnt-type = 'процент':U then yes else no).
     9186       end.
     9187   define variable vss-include-info90 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9188   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_set-pr in g#lib-trn3
     9189     ( input recid(crt_gds-dtl)
     9190     , input no
     9191     , input ?
     9192     ) no-error.
     9193       if error-status :error then do:
     9194         undo c-l, return error return-value.
     9195       end.
     9196       if (crt_gds-dtl.price-rubl = ? or crt_gds-dtl.price-base = ?) and
     9197          crt_gds-dtl.ov then do:
     9198         undo c-l, return error substitute ("При добавлении с фиксацией взятых из документа - источника цен требуется, чтобы ни одна из цен источника не была '?'. Добавляйте с текущими ценами продажи или выберите другой источник. Товар &1 &2 &3", crt_gds-dtl.artic, crt_gds-dtl.prod-type, crt_gds-dtl.prod-code).
     9199       end.
     9200       if paruse-parts = true
     9201       then do:
     9202         if first-of (tt-gds-dtl.prod-code) then do:
     9203           _tt-parts:
     9204           for each tt-parts
     9205             where tt-parts.out-code  = pardoc-code
     9206               and tt-parts.artic     = tt-gds-dtl.artic
     9207               and tt-parts.prod-type = tt-gds-dtl.prod-type
     9208               and tt-parts.prod-code = tt-gds-dtl.prod-code
     9209           on error undo, return error return-value
     9210           :
     9211             if tt-parts.fact-qnty = 0 then NEXT _tt-parts.
     9212             assign
     9213               chg-qnty = tt-parts.fact-qnty
     9214               mem-qnty = chg-qnty
     9215             .
     9216             if v-is-hold = true then do:
     9217               run trg/rsrv-dtl.p
     9218                 ( input parparentproc
     9219                  ,input 'reserv':U
     9220                         + "," + 'hold-date':U + "=" + str-encode( string (tt-parts.hold-date), "", ",=":u)
     9221                         + "," + 'hold-code-parent':U + "=" + str-encode(tt-parts.in-code, "", ",=":u)
     9222                         + "," + 'part-code-parent':U + "=" + str-encode(tt-parts.part-code, "", ",=":u)
     9223                         + "," + 'cst-code':U + "=" + str-encode(tt-parts.cst-code, "", ",=":u)
     9224                  ,buffer crt_gds-dtl
     9225                  ,input-output chg-qnty
     9226                  ,input-output crt_doc-line.price-base
     9227                  ,input-output crt_doc-line.price-rubl
     9228                  ,input -1
     9229                  ,input if v-gds-mark then ("copy-ret" + chr(4) + pardoc-code) else ""
     9230                 ) no-error.
     9231               if error-status :error then do:
     9232                 undo c-l, return error return-value.
     9233               end.
     9234             end.
     9235             else do:
     9236               assign
     9237                 v-add-par = ( if tt-parts.pl-code <> 0 and tt-parts.pl-code <> ?
     9238                               then ",":U + 'plcode':U + "=":U + string(tt-parts.pl-code)
     9239                               else "":U
     9240                              )
     9241               .
     9242               run trg/rsrv-dtl.p
     9243                 ( input parparentproc
     9244                  ,input 'reserv':U
     9245                         + "," + 'rsrv-single-part':U
     9246                         + "," + 'rsrv-in-code':U + "=" + str-encode(tt-parts.in-code, "", ",=":u)
     9247                         + "," + 'rsrv-part-code':U + "=" + str-encode(tt-parts.part-code, "", ",=":u)
     9248                         + "," + 'cst-code':U + "=" + str-encode(tt-parts.cst-code, "", ",=":u)
     9249                         + v-add-par
     9250                  ,buffer crt_gds-dtl
     9251                  ,input-output chg-qnty
     9252                  ,input-output crt_doc-line.price-base
     9253                  ,input-output crt_doc-line.price-rubl
     9254                  ,input -1
     9255                  ,input if v-gds-mark then ("copy-ret" + chr(4) + pardoc-code) else ""
     9256                 ) no-error.
     9257               if error-status :error then do:
     9258                 undo c-l, return error return-value.
     9259               end.
     9260             end.
     9261             if chg-qnty <> mem-qnty then do:
     9262               undo c-l, return error substitute("Не удалось зарезервировать все количество по товару &1 &2 &3 партия &4 &5.", crt_doc-line.artic, crt_doc-line.prod-type, crt_doc-line.prod-code, tt-parts.in-code, tt-parts.part-code).
     9263             end.
     9264             assign
     9265               crt_doc-line.doc-qnty  = crt_doc-line.doc-qnty + chg-qnty
     9266               crt_doc-line.fact-qnty = crt_doc-line.doc-qnty
     9267               crt_doc-line.cli-qnty  = crt_doc-line.doc-qnty / crt_doc-line.cli-base-rate
     9268               crt_gds-dtl.doc-qnty   = crt_gds-dtl.doc-qnty  + chg-qnty
     9269               crt_gds-dtl.fact-qnty  = crt_gds-dtl.doc-qnty
     9270               varchg-qnty            = varchg-qnty           + chg-qnty
     9271               varcheck-qnty          = varcheck-qnty         + chg-qnty
     9272               tt-parts.fact-qnty     = 0
     9273               tt-parts.qnty          = tt-parts.qnty         + chg-qnty
     9274             .
     9275           end.
     9276           assign
     9277             tt-gds-dtl.fact-qnty     = 0
     9278             tt-gds-dtl.doc-qnty      = crt_gds-dtl.doc-qnty
     9279           .
     9280         end.
     9281       end.
     9282       else do:
     9283         if parrsrv-fact-qnty = yes then do:
     9284           if tt-gds-dtl.fact-qnty = 0 then NEXT _tt-gds-dtl.
     9285           assign
     9286             chg-qnty = tt-gds-dtl.fact-qnty
     9287             mem-qnty = chg-qnty
     9288           .
     9289         end.
     9290         else do:
     9291           if tt-gds-dtl.doc-qnty = 0 then NEXT _tt-gds-dtl.
     9292           assign
     9293             chg-qnty = tt-gds-dtl.doc-qnty
     9294             mem-qnty = chg-qnty
     9295           .
     9296         end.
     9297         find first bf-cas_trn-doc no-lock
     9298           where bf-cas_trn-doc.doc-code = crt_trn-doc.out-code
     9299           no-error.
     9300         if available bf-cas_trn-doc
     9301           and bf-cas_trn-doc.ext-doc-type = 'es':U
     9302         then do:
     9303           assign
     9304             v-add-par = ',':U + 'negative-check':U + "=2":U
     9305           .
     9306         end.
     9307         else do:
     9308           assign
     9309             v-add-par = "":U
     9310           .
     9311         end.
     9312         run trg/rsrv-dtl.p
     9313           ( input parparentproc
     9314            ,input 'reserv':U + v-add-par
     9315            ,buffer crt_gds-dtl
     9316            ,input-output chg-qnty
     9317            ,input-output crt_doc-line.price-base
     9318            ,input-output crt_doc-line.price-rubl
     9319            ,input -1
     9320            ,input if v-gds-mark then ("copy-ret" + chr(4) + pardoc-code) else ""
     9321           ) no-error.
     9322         if error-status :error then do:
     9323           undo c-l, return error return-value.
     9324         end.
     9325         if parall-qnty
     9326           and chg-qnty <> mem-qnty
     9327         then do:
     9328            undo c-l, return error substitute("Не удалось зарезервировать все количество по товару &1 &2 &3.", crt_doc-line.artic, crt_doc-line.prod-type, crt_doc-line.prod-code).
     9329         end.
     9330         assign
     9331           crt_doc-line.doc-qnty  = crt_doc-line.doc-qnty + chg-qnty
     9332           crt_gds-dtl.doc-qnty   = crt_gds-dtl.doc-qnty  + chg-qnty
     9333           crt_gds-dtl.fact-qnty  = crt_gds-dtl.doc-qnty
     9334           crt_doc-line.fact-qnty = crt_doc-line.doc-qnty
     9335           crt_doc-line.cli-qnty  = crt_doc-line.doc-qnty / crt_doc-line.cli-base-rate
     9336         .
     9337         assign
     9338           varchg-qnty   = varchg-qnty   + chg-qnty
     9339           varcheck-qnty = varcheck-qnty + (if parrsrv-fact-qnty = yes then tt-gds-dtl.fact-qnty else tt-gds-dtl.doc-qnty)
     9340           tt-gds-dtl.fact-qnty     = (if parrsrv-fact-qnty
     9341                                       then (tt-gds-dtl.fact-qnty - chg-qnty)
     9342                                       else crt_gds-dtl.fact-qnty)
     9343           tt-gds-dtl.doc-qnty      = (if parrsrv-fact-qnty
     9344                                       then crt_gds-dtl.doc-qnty
     9345                                       else (tt-gds-dtl.doc-qnty - chg-qnty))
     9346           tt-doc-line.fact-qnty     = (if parrsrv-fact-qnty
     9347                                         then (tt-doc-line.fact-qnty - chg-qnty)
     9348                                         else crt_doc-line.fact-qnty)
     9349           tt-doc-line.doc-qnty      = (if parrsrv-fact-qnty
     9350                                         then crt_doc-line.doc-qnty
     9351                                         else (tt-doc-line.doc-qnty - chg-qnty))
     9352         .
     9353       end.
     9354       if crt_gds-dtl.doc-qnty = 0 then do:
     9355         delete crt_gds-dtl.
     9356       end.
     9357     end.
     9358     if crt_doc-line.doc-qnty = 0 then do:
     9359       delete crt_doc-line.
     9360     end.
     9361   end.
     9362   if varcheck-qnty <> varchg-qnty and
     9363      not (available bf-cas_trn-doc and bf-cas_trn-doc.ext-doc-type = 'es':U) then do:
     9364     message
     9365     substitute(("Внимание !!!&1&1" +
     9366                "НЕ ВСЕ количество из документа &2 - источника УДАЛОСЬ добавить в заполняемый документ &3!&1&1" +
     9367                "Общее количество в документе - источнике : &4&1"  +
     9368                "Удалось добавить в документ : &5")
     9369                 , chr(10)
     9370                 , pardoc-code
     9371                 , pardstdoc-code
     9372                 , varcheck-qnty
     9373                 , varchg-qnty)
     9374    view-as alert-box .
     9375   end.
     9376   end.
     9377   end procedure.
