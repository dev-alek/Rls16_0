     8035   define variable v-back-date as logical   no-undo .
     8036   define variable v-back-date-type as character no-undo .
     8037         delete object v-tth no-error.
     8038         run adm/shattri.p (
     8039              input "get":U
     8040             ,input parobj-type
     8041             ,input parobj-code
     8042             ,input 'nakl_par':U
