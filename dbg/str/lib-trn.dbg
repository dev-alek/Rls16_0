     6539   define input parameter parobj-type     like ub.trn-doc.obj-type     no-undo.
     6540   define input parameter paroffice       like ub.trn-doc.office       no-undo.
     6541   define input parameter parpay-code     like ub.trn-doc.pay-code     no-undo.
     6542   define input parameter parps           like ub.trn-doc.ps           no-undo.
     6543   define input parameter parret-supp     like ub.trn-doc.ret-supp     no-undo.
     6544   define input parameter parslt-type     like ub.trn-doc.slt-type     no-undo.
     6545   define input parameter parstatus_      like ub.trn-doc.status_      no-undo.
     6546   define input parameter parvat-type     like ub.trn-doc.vat-type     no-undo.
     6547   define input parameter parext-doc-type like ub.trn-doc.ext-doc-type no-undo.
     6548   define input parameter parpurch-code   like ub.trn-doc.purch-code   no-undo.
     6549   define buffer cr_trn-doc for ub.trn-doc.
     6550   define variable varenvd as character no-undo.
     6551   define variable vartype as character no-undo.
     6552   define variable v-type       as character no-undo .
     6553   define variable varstfactdt      as logical   no-undo .
     6554   define variable varstfactdt-type as character no-undo .
     6555   define variable v-value-character as character no-undo .
     6556   define variable v-value-date      as date      no-undo .
     6557   define variable v-value-decimal   as decimal   no-undo .
     6558   define variable v-value-integer   as integer   no-undo .
     6559   do for cr_trn-doc transaction on error undo, return error return-value :
     6560   find first cr_trn-doc where cr_trn-doc.doc-code = pardoc-code no-error.
     6561   if not available cr_trn-doc then do:
     6562     create cr_trn-doc.
     6563     assign
     6564       cr_trn-doc.acc-date     = paracc-date
     6565       cr_trn-doc.bge-date     = parbge-date
     6566       cr_trn-doc.base-rate    = parbase-rate
     6567       cr_trn-doc.base-scale   = parbase-scale
     6568       cr_trn-doc.cli-code     = parcli-code
     6569       cr_trn-doc.cli-type     = parcli-type
     6570       cr_trn-doc.cli-name     = parcli-name
     6571       cr_trn-doc.cr-db-num    = parcr-db-num
     6572       cr_trn-doc.creid        = parcreid
     6573       cr_trn-doc.discnt-type  = pardiscnt-type
     6574       cr_trn-doc.doc-code     = pardoc-code
     6575       cr_trn-doc.doc-date     = pardoc-date
     6576       cr_trn-doc.doc-type     = pardoc-type
     6577       cr_trn-doc.flag_        = parflag_
     6578       cr_trn-doc.host-code    = parhost-code
     6579       cr_trn-doc.internal     = parinternal
     6580       cr_trn-doc.obj-code     = parobj-code
     6581       cr_trn-doc.obj-type     = parobj-type
     6582       cr_trn-doc.office       = paroffice
     6583       cr_trn-doc.pay-code     = parpay-code
     6584       cr_trn-doc.ps           = parps
     6585       cr_trn-doc.ret-supp     = parret-supp
     6586       cr_trn-doc.slt-type     = parslt-type
     6587       cr_trn-doc.status_      = parstatus_
     6588       cr_trn-doc.vat-type     = parvat-type
     6589       cr_trn-doc.ext-doc-type = parext-doc-type
     6590       cr_trn-doc.purch-code   = parpurch-code
     6591       .
     6592     run clntattr-value in this-procedure (
     6593         cr_trn-doc.obj-type,
     6594         cr_trn-doc.obj-code,
     6595         'envd':U,
     6596         output varenvd,
     6597         output vartype).
     6598     if varenvd = "yes":u then do:
     6599   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input cr_trn-doc.doc-code ,
     6600                          input 'envd':U ,
