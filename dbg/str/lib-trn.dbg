     7752             run trg/rsrv-del.p ( input del_doc-line.doc-code,
     7753                              input del_doc-line.artic,
     7754                              input del_doc-line.prod-type,
     7755                              input del_doc-line.prod-code ) no-error.
     7756             if error-status :error then do:
     7757               run waitfram-hide in parhandle no-error.
     7758               undo, return error "Ошибка при разрезервировании.".
     7759             end.
     7760           end.
     7761         end.
     7762         if del_trn-doc.status_ = 'факт':U then do:
     7763           if parphchip-num <> ? then do:
     7764             assign
     7765               varchip-num-main = parphchip-num.
     7766           end.
     7767           else do:
     7768             assign
     7769               varchip-num-main = next-value( s-corr-chip, ub )
     7770             .
     7771           end.
     7772           assign
     7773             parchip-num = varchip-num-main
     7774           .
     7775           for each del_rvs-doc exclusive-lock
     7776             where del_rvs-doc.out-code = del_trn-doc.doc-code
     7777           on error undo, return error return-value
     7778           :
     7779             run waitfram-join in parhandle (
     7780                input substitute( "Создание истории по сверкам документа &1 и их удаление.", pardoc-code ),
     7781                input '':U,
     7782                input substitute( " Время: &1.", string( time - vartime, "hh:mm:ss":U ) ),
     7783               output varmessage            ) no-error.
     7784             run waitfram-show in parhandle ( input varmessage ) no-error.
