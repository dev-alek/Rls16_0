     2955     ,output varsum-fact-out-dsv-base
     2956     ,output varroad-tax-fact-rubl
     2957     ,output varexcise-fact-rubl
     2958     ,output varslt-fact-rubl
     2959     ,output varvat-fact-rubl
     2960     ,output varslt-doc-rubl
     2961     ,output varvat-doc-rubl
     2962     ,output varsum-fact-out-dsv-rubl
     2963     ,output varsum-fact-out-dsc-base
     2964     ,output varsum-fact-out-dsc-rubl
     2965     ,output varsum-fact-cur
     2966     ,output varov-fact-base
     2967     ,output varov-vat-fact-base
     2968     ,output varsum-doc-cur
     2969     ,output varov-doc-base
     2970     ,output varov-vat-doc-base
     2971     ,output varsum-doc-base
     2972     ,output varsum-doc-rubl
     2973     ,output varroad-tax-fact
     2974     ,output varexcise-fact
     2975     ,output varroad-tax-doc
     2976     ,output varexcise-doc
     2977     ,output vardiscnt-base-doc
     2978     ,output vardiscnt-rubl-doc
     2979     ,output vardiscnt-base-fact
     2980     ,output vardiscnt-rubl-fact
     2981     ) no-error.
     2982    if error-status :error then do:
     2983      return error return-value.
     2984    end.
     2985    assign
     2986      vartotal-road-tax-fact-base              = vartotal-road-tax-fact-base               + varroad-tax-fact-base
     2987      vartotal-excise-fact-base                = vartotal-excise-fact-base                 + varexcise-fact-base
     2988      vartotal-slt-fact-base                   = vartotal-slt-fact-base                    + varslt-fact-base
     2989      vartotal-vat-fact-base                   = vartotal-vat-fact-base                    + varvat-fact-base
     2990      vartotal-slt-doc-base                    = vartotal-slt-doc-base                     + varslt-doc-base
     2991      vartotal-vat-doc-base                    = vartotal-vat-doc-base                     + varvat-doc-base
     2992      vartotal-sum-fact-out-dsv-base           = vartotal-sum-fact-out-dsv-base            + varsum-fact-out-dsv-base
     2993      vartotal-road-tax-fact-rubl              = vartotal-road-tax-fact-rubl               + varroad-tax-fact-rubl
     2994      vartotal-excise-fact-rubl                = vartotal-excise-fact-rubl                 + varexcise-fact-rubl
     2995      vartotal-slt-fact-rubl                   = vartotal-slt-fact-rubl                    + varslt-fact-rubl
     2996      vartotal-vat-fact-rubl                   = vartotal-vat-fact-rubl                    + varvat-fact-rubl
     2997      vartotal-slt-doc-rubl                    = vartotal-slt-doc-rubl                     + varslt-doc-rubl
     2998      vartotal-vat-doc-rubl                    = vartotal-vat-doc-rubl                     + varvat-doc-rubl
     2999      vartotal-sum-fact-out-dsv-rubl           = vartotal-sum-fact-out-dsv-rubl            + varsum-fact-out-dsv-rubl
     3000      vartotal-sum-fact-out-dsc-base           = vartotal-sum-fact-out-dsc-base            + varsum-fact-out-dsc-base
     3001      vartotal-sum-fact-out-dsc-rubl           = vartotal-sum-fact-out-dsc-rubl            + varsum-fact-out-dsc-rubl
     3002      vartotal-sum-fact-cur                    = vartotal-sum-fact-cur                     + varsum-fact-cur
     3003      vartotal-ov-fact-base                    = vartotal-ov-fact-base                     + varov-fact-base
     3004      vartotal-ov-vat-fact-base                = vartotal-ov-vat-fact-base                 + varov-vat-fact-base
     3005      vartotal-sum-doc-cur                     = vartotal-sum-doc-cur                      + varsum-doc-cur
     3006      vartotal-ov-doc-base                     = vartotal-ov-doc-base                      + varov-doc-base
     3007      vartotal-ov-vat-doc-base                 = vartotal-ov-vat-doc-base                  + varov-vat-doc-base
     3008      vartotal-sum-doc-base                    = vartotal-sum-doc-base                     + varsum-doc-base
     3009      vartotal-sum-doc-rubl                    = vartotal-sum-doc-rubl                     + varsum-doc-rubl
     3010      vartotal-road-tax-fact                   = vartotal-road-tax-fact                    + varroad-tax-fact
     3011      vartotal-excise-fact                     = vartotal-excise-fact                      + varexcise-fact
     3012      vartotal-road-tax-doc                    = vartotal-road-tax-doc                     + varroad-tax-doc
     3013      vartotal-excise-doc                      = vartotal-excise-doc                       + varexcise-doc
     3014      vartotal-discnt-base-doc                 = vartotal-discnt-base-doc                  + vardiscnt-base-doc
     3015      vartotal-discnt-rubl-doc                 = vartotal-discnt-rubl-doc                  + vardiscnt-rubl-doc
     3016      vartotal-discnt-base-fact                = vartotal-discnt-base-fact                 + vardiscnt-base-fact
     3017      vartotal-discnt-rubl-fact                = vartotal-discnt-rubl-fact                 + vardiscnt-rubl-fact              .
     3018   end.
     3019   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_clcpttrn in g#lib-trn
     3020     (
     3021      input recid(cd_trn-doc)
     3022     ,input vartotal-discnt-base-fact
     3023     ,input vartotal-discnt-rubl-fact
     3024     ,input vartotal-road-tax-fact
     3025     ,input vartotal-excise-fact
     3026     ,input vartotal-slt-fact-base
     3027     ,input vartotal-vat-fact-base
     3028     ,input vartotal-slt-fact-rubl
     3029     ,input vartotal-vat-fact-rubl
     3030     ,input 0
     3031     ,input 0
