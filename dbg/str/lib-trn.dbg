     5986       find cs_gds-obj where cs_gds-obj.obj-type  = cs_trn-doc.obj-type
     5987                         and cs_gds-obj.obj-code  = cs_trn-doc.obj-code
     5988                         and cs_gds-obj.artic     = cs_gds-dtl.artic
     5989                         and cs_gds-obj.prod-code = cs_gds-dtl.prod-code
     5990                         and cs_gds-obj.prod-type = cs_gds-dtl.prod-type   no-lock no-error.
     5991       if available cs_gds-obj then do:
     5992         assign
     5993          gds-qnty = cs_gds-obj.fact-qnty.
     5994       end.
     5995       else do:
     5996         assign
     5997         gds-qnty = 0.
     5998       end.
     5999       define buffer cs_doc-prts for ub.doc-prts  .
     6000       find first cs_doc-prts no-lock where
     6001                  cs_doc-prts.b-code    = cs_bar-code.b-code and
