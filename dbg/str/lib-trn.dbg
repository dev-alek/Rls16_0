     5978            b-qnty = b-qnty - cs_gds-dtl.fact-qnty.
     5979         end.
     5980       end.
     5981     end.
     5982     b-c = -1.
     5983   end.
     5984   if cs_trn-doc.doc-type = 'инв':U and
