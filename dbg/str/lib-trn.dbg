     7739     (input  del_doc-line.obj-type
     7740     ,input  del_doc-line.obj-code
     7741     ,input  del_doc-line.artic
     7742     ,input  del_doc-line.prod-type
     7743     ,input  del_doc-line.prod-code
     7744     ,input  'inv-on=false'
     7745     ,output l-inv-on
     7746     ) no-error .
     7747               if error-status :error then do:
     7748                 undo, return error SUBSTITUTE ("Ошибка установки атрибута товара на объекте. Документ &1. Объект &2 &3. Артикул &4 &5 &6. Признак товара в инвентаризации &7.",
     7749                                               del_doc-line.doc-code, del_doc-line.obj-type, del_doc-line.obj-code, del_doc-line.artic, del_doc-line.prod-type, del_doc-line.prod-code, l-inv-on).
     7750               end.
