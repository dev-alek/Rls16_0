     8195           end.
     8196         end case.
     8197   define variable vss-include-info80 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8198   do:
     8199     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8200       (input  pardb-num
     8201       ,input  paruserid
     8202       ,input  0
     8203       ,input  v-action
     8204       ,input  'object':U
     8205       ,input  v-chk-act-host-code
     8206       ,input  parobj-type
     8207       ,input  parobj-code
     8208       ,input  0
     8209       ,input  0
     8210       ,input  0
     8211       ,input  true
     8212       ,output g-log
     8213       )  .
     8214   end.
     8215         if not g-log then do:
     8216           output stream str-err to value(parfile-name-err) append.
     8217           put stream str-err unformatted substitute ("Товар &1 &2 &3 &4 - топливо. Вы не имеете прав на создание документов по топливу в предыдущих сменах. Документы можно добавлять только в текущей смене."
     8218                                   , parartic
     8219                                   , parprod-type
     8220                                   , parprod-code
     8221                                   , cad_goods.gds-name).
     8222           output stream str-err close.
     8223           return error "CRITICAL".
     8224         end.
     8225       end.
     8226     end.
     8227         for each cad_rvs-doc where cad_rvs-doc.obj-type = parobj-type and                                              cad_rvs-doc.obj-code = parobj-code and                                              cad_rvs-doc.status_  > 'факт':U and                                           cad_rvs-doc.rvs-type ne 'проверка':U and                                            cad_rvs-doc.out-code <> pardoc-code no-lock ,                first cad_rvs-line where cad_rvs-line.gds-code = cad_goods.gds-code   and                                    cad_rvs-line.rvs-code = cad_rvs-doc.rvs-code and                                    cad_rvs-line.obj-type = parobj-type          and                                    cad_rvs-line.obj-code = parobj-code          no-lock   on error undo, return error return-value                                        :                                                                                 output stream str-err to value(parfile-name-err) append.                        put stream str-err unformatted substitute ("По товару &1 &2 &3 &4 есть незакрытая сверка &5",                                                       parartic,                                                                      parprod-type,                                                                  parprod-code,                                                                  cad_goods.gds-name,                                                            cad_rvs-line.rvs-code) skip.     output stream str-err close.                                                  assign varflag-err = yes.     end.
     8228       for each cad_rvs-doc where cad_rvs-doc.obj-type = parobj-type and                                              cad_rvs-doc.obj-code = parobj-code and                                              cad_rvs-doc.status_  < 'факт':U and                                           cad_rvs-doc.rvs-type ne 'проверка':U and                                            cad_rvs-doc.out-code <> pardoc-code no-lock ,                first cad_rvs-line where cad_rvs-line.gds-code = cad_goods.gds-code   and                                    cad_rvs-line.rvs-code = cad_rvs-doc.rvs-code and                                    cad_rvs-line.obj-type = parobj-type          and                                    cad_rvs-line.obj-code = parobj-code          no-lock   on error undo, return error return-value                                        :                                                                                 output stream str-err to value(parfile-name-err) append.                        put stream str-err unformatted substitute ("По товару &1 &2 &3 &4 есть незакрытая сверка &5",                                                       parartic,                                                                      parprod-type,                                                                  parprod-code,                                                                  cad_goods.gds-name,                                                            cad_rvs-line.rvs-code) skip.     output stream str-err close.                                                  assign varflag-err = yes.     end.
     8229   end.
     8230   for each cad_doc-line where cad_doc-line.obj-type  = parobj-type   and                                     cad_doc-line.obj-code  = parobj-code   and                                     cad_doc-line.prod-type = parprod-type  and                                     cad_doc-line.prod-code = parprod-code  and                                     cad_doc-line.artic     = parartic      and                                     cad_doc-line.ext-doc-type = 'vt':U and                                   cad_doc-line.status_   > 'факт':U and                                   cad_doc-line.doc-code  <> pardoc-code  no-lock    on error undo, return error return-value                                      :                                                                                  output stream str-err to value(parfile-name-err) append.                      put stream str-err unformatted  substitute ("По товару &1 &2 &3 &4 есть открытый документ &5.",                                                  parartic,                                                                     parprod-type,                                                                 parprod-code,                                                                 cad_goods.gds-name,                                                           cad_doc-line.doc-code) skip.     output stream str-err close.                                                  assign varflag-err = yes.   end.
     8231   for each cad_doc-line where cad_doc-line.obj-type  = parobj-type   and                                     cad_doc-line.obj-code  = parobj-code   and                                     cad_doc-line.prod-type = parprod-type  and                                     cad_doc-line.prod-code = parprod-code  and                                     cad_doc-line.artic     = parartic      and                                     cad_doc-line.ext-doc-type = 'vt':U and                                   cad_doc-line.status_   < 'факт':U and                                   cad_doc-line.doc-code  <> pardoc-code  no-lock    on error undo, return error return-value                                      :                                                                                  output stream str-err to value(parfile-name-err) append.                      put stream str-err unformatted  substitute ("По товару &1 &2 &3 &4 есть открытый документ &5.",                                                  parartic,                                                                     parprod-type,                                                                 parprod-code,                                                                 cad_goods.gds-name,                                                           cad_doc-line.doc-code) skip.     output stream str-err close.                                                  assign varflag-err = yes.   end.
     8232   for each cad_doc-line where cad_doc-line.obj-type  = parobj-type   and                                     cad_doc-line.obj-code  = parobj-code   and                                     cad_doc-line.prod-type = parprod-type  and                                     cad_doc-line.prod-code = parprod-code  and                                     cad_doc-line.artic     = parartic      and                                     cad_doc-line.ext-doc-type = 'vp':U and                                   cad_doc-line.status_   > 'факт':U and                                    cad_doc-line.doc-code  <> pardoc-code  no-lock    on error undo, return error return-value                                      :                                                                                  output stream str-err to value(parfile-name-err) append.                      put stream str-err unformatted  substitute ("По товару &1 &2 &3 &4 есть открытый документ &5.",                                                  parartic,                                                                     parprod-type,                                                                 parprod-code,                                                                 cad_goods.gds-name,                                                           cad_doc-line.doc-code) skip.     output stream str-err close.                                                  assign varflag-err = yes.   end.
     8233   for each cad_doc-line where cad_doc-line.obj-type  = parobj-type   and                                     cad_doc-line.obj-code  = parobj-code   and                                     cad_doc-line.prod-type = parprod-type  and                                     cad_doc-line.prod-code = parprod-code  and                                     cad_doc-line.artic     = parartic      and                                     cad_doc-line.ext-doc-type = 'vp':U and                                   cad_doc-line.status_   < 'факт':U and                                    cad_doc-line.doc-code  <> pardoc-code  no-lock    on error undo, return error return-value                                      :                                                                                  output stream str-err to value(parfile-name-err) append.                      put stream str-err unformatted  substitute ("По товару &1 &2 &3 &4 есть открытый документ &5.",                                                  parartic,                                                                     parprod-type,                                                                 parprod-code,                                                                 cad_goods.gds-name,                                                           cad_doc-line.doc-code) skip.     output stream str-err close.                                                  assign varflag-err = yes.   end.
     8234   if varflag-err = yes then do:
     8235     return error.
     8236   end.
     8237   end.
     8238   end procedure.
     8239   procedure lib-trn_hstc-trn :
     8240     define input parameter parrec-trn-doc     as   recid                        no-undo.
     8241     define input parameter parobj-date        as   date                         no-undo.
     8242     define input parameter parshift-date      like ub.shift-obj.shift-date      no-undo.
     8243     define input parameter parshift-num       like ub.shift-obj.shift-num       no-undo.
     8244     define input parameter parshift-name      like ub.shift-obj.shift-name      no-undo.
     8245     define input parameter parcorr-incas-code like ub.c-trn-doc.corr-inkas-code no-undo.
     8246     define input parameter parcorr-fbr-code   like ub.c-trn-doc.corr-fbr-code   no-undo.
     8247     define input parameter paruserid          as   character                    no-undo.
     8248     define input parameter parcurdb-num       as   integer                      no-undo.
     8249     define input parameter parchip-num        as   integer                      no-undo.
     8250     define buffer hstc_trn-doc         for ub.trn-doc.
     8251     define buffer hstc_trn-doc-sum     for ub.trn-doc-sum.
     8252     define buffer hstc_doc-line        for ub.doc-line.
     8253     define buffer hstc_doc-line-attr   for ub.doc-line-attr.
     8254     define buffer hstc_doc-line-sum    for ub.doc-line-sum.
     8255     define buffer hstc_gds-dtl         for ub.gds-dtl.
     8256     define buffer hstc_parts           for ub.parts.
     8257     define buffer hstc_parts-root      for ub.parts-root.
     8258     define buffer hstc_parts-attr      for ub.parts-attr.
     8259     define buffer hstc_doc-prts        for ub.doc-prts.
     8260     define buffer hstc_doc-pl          for ub.doc-pl.
     8261     define buffer hstc_doc-pl-pump     for ub.doc-pl-pump.
     8262     define buffer hstc_doc-attr        for ub.doc-attr.
     8263     define buffer hstc_doc-fbr-gds     for ub.doc-fbr-gds.
     8264     define buffer hstc_c-trn-doc       for ub.c-trn-doc.
     8265     define buffer hstc_c-trn-doc-sum   for ub.c-trn-doc-sum.
     8266     define buffer hstc_c-doc-line      for ub.c-doc-line.
     8267     define buffer hstc_c-doc-line-attr for ub.c-doc-line-attr.
     8268     define buffer hstc_c-doc-line-sum  for ub.c-doc-line-sum.
     8269     define buffer hstc_c-gds-dtl       for ub.c-gds-dtl.
     8270     define buffer hstc_c-parts         for ub.c-parts.
     8271     define buffer hstc_c-parts-root    for ub.c-parts-root.
     8272     define buffer hstc_c-parts-attr    for ub.c-parts-attr.
     8273     define buffer hstc_c-doc-prts      for ub.c-doc-prts.
     8274     define buffer hstc_c-doc-pl        for ub.c-doc-pl.
     8275     define buffer hstc_c-doc-pl-pump   for ub.c-doc-pl-pump.
     8276     define buffer hstc_c-doc-attr      for ub.c-doc-attr.
     8277     define buffer hstc_c-doc-fbr-gds   for ub.c-doc-fbr-gds.
     8278     do on error undo, return error return-value :
     8279       find first hstc_trn-doc where recid( hstc_trn-doc ) = parrec-trn-doc.
     8280       create hstc_c-trn-doc.
     8281       buffer-copy hstc_trn-doc to hstc_c-trn-doc.
     8282       assign
     8283         hstc_c-trn-doc.chip-num        = parchip-num
     8284         hstc_c-trn-doc.corr-user-name  = paruserid
     8285         hstc_c-trn-doc.corr-user-db-num = parcurdb-num
     8286         hstc_c-trn-doc.corr-inkas-code = parcorr-incas-code
     8287         hstc_c-trn-doc.corr-fbr-code   = parcorr-fbr-code
     8288         hstc_c-trn-doc.corr-date       = parobj-date
     8289         hstc_c-trn-doc.corr-shift-date = parshift-date
     8290         hstc_c-trn-doc.corr-shift-num  = parshift-num
     8291         hstc_c-trn-doc.corr-shift-name = parshift-name
     8292         hstc_c-trn-doc.bge-date        = ?
     8293         hstc_c-trn-doc.scf-date        = ?
     8294       .
     8295       for each hstc_trn-doc-sum where hstc_trn-doc-sum.doc-code = hstc_trn-doc.doc-code on error undo, return error return-value :
     8296         create hstc_c-trn-doc-sum.
     8297         buffer-copy hstc_trn-doc-sum to hstc_c-trn-doc-sum.
     8298         assign hstc_c-trn-doc-sum.chip-num         = hstc_c-trn-doc.chip-num
     8299                hstc_c-trn-doc-sum.corr-user-db-num = hstc_c-trn-doc.user-db-num
     8300         .
     8301       end.
     8302       for each hstc_doc-attr where hstc_doc-attr.doc-code = hstc_trn-doc.doc-code on error undo, return error return-value :
     8303         create hstc_c-doc-attr.
     8304         buffer-copy hstc_doc-attr to hstc_c-doc-attr.
     8305         assign hstc_c-doc-attr.chip-num = hstc_c-trn-doc.chip-num.
     8306       end.
     8307       for each hstc_doc-line where hstc_doc-line.doc-code = hstc_trn-doc.doc-code on error undo, return error return-value :
     8308           create hstc_c-doc-line.
     8309           buffer-copy hstc_doc-line to hstc_c-doc-line.
     8310           assign hstc_c-doc-line.chip-num = hstc_c-trn-doc.chip-num.
     8311       end.
     8312       for each hstc_doc-line-attr where hstc_doc-line-attr.doc-code = hstc_trn-doc.doc-code on error undo, return error return-value :
     8313         create hstc_c-doc-line-attr.
     8314         buffer-copy hstc_doc-line-attr to hstc_c-doc-line-attr.
     8315         assign hstc_c-doc-line-attr.chip-num = hstc_c-trn-doc.chip-num.
     8316       end.
     8317       for each hstc_doc-line-sum where hstc_doc-line-sum.doc-code = hstc_trn-doc.doc-code on error undo, return error return-value :
     8318         create hstc_c-doc-line-sum.
     8319         buffer-copy hstc_doc-line-sum to hstc_c-doc-line-sum.
     8320         assign hstc_c-doc-line-sum.chip-num         = hstc_c-trn-doc.chip-num
     8321                hstc_c-doc-line-sum.corr-user-db-num = hstc_c-trn-doc.user-db-num
     8322         .
     8323       end.
     8324       for each hstc_gds-dtl where hstc_gds-dtl.doc-code = hstc_trn-doc.doc-code on error undo, return error return-value :
     8325           create hstc_c-gds-dtl.
     8326           buffer-copy hstc_gds-dtl to hstc_c-gds-dtl.
     8327           assign hstc_c-gds-dtl.chip-num = hstc_c-trn-doc.chip-num.
     8328       end.
     8329       for each hstc_parts where hstc_parts.out-code = hstc_trn-doc.doc-code on error undo, return error return-value :
     8330           create hstc_c-parts.
     8331           buffer-copy hstc_parts to hstc_c-parts.
     8332           assign hstc_c-parts.chip-num = hstc_c-trn-doc.chip-num.
     8333       end.
     8334       for each hstc_parts-root where hstc_parts-root.doc-code = hstc_trn-doc.doc-code on error undo, return error return-value :
     8335         create hstc_c-parts-root.
     8336         buffer-copy hstc_parts-root to hstc_c-parts-root.
     8337         assign hstc_c-parts-root.chip-num = hstc_c-trn-doc.chip-num.
     8338       end.
     8339       for each hstc_parts-attr where hstc_parts-attr.in-code = hstc_trn-doc.doc-code on error undo, return error return-value :
     8340         create hstc_c-parts-attr.
     8341         buffer-copy hstc_parts-attr to hstc_c-parts-attr.
     8342         assign hstc_c-parts-attr.chip-num = hstc_c-trn-doc.chip-num.
     8343       end.
     8344       for each hstc_doc-prts where hstc_doc-prts.out-code = hstc_trn-doc.doc-code on error undo, return error return-value :
     8345         create hstc_c-doc-prts.
     8346         buffer-copy hstc_doc-prts to hstc_c-doc-prts.
     8347         assign hstc_c-doc-prts.chip-num = hstc_c-trn-doc.chip-num.
     8348       end.
     8349       for each hstc_doc-pl where hstc_doc-pl.out-code = hstc_trn-doc.doc-code on error undo, return error return-value :
     8350         create hstc_c-doc-pl.
     8351         buffer-copy hstc_doc-pl to hstc_c-doc-pl.
     8352         assign hstc_c-doc-pl.chip-num = hstc_c-trn-doc.chip-num.
     8353       end.
     8354       for each hstc_doc-pl-pump where hstc_doc-pl-pump.out-code = hstc_trn-doc.doc-code on error undo, return error return-value :
     8355         create hstc_c-doc-pl-pump.
     8356         buffer-copy hstc_doc-pl-pump to hstc_c-doc-pl-pump.
     8357         assign hstc_c-doc-pl-pump.chip-num = hstc_c-trn-doc.chip-num.
     8358       end.
     8359       for each hstc_doc-fbr-gds where hstc_doc-fbr-gds.out-code = hstc_trn-doc.doc-code on error undo, return error return-value :
     8360         create hstc_c-doc-fbr-gds.
     8361         buffer-copy hstc_doc-fbr-gds to hstc_c-doc-fbr-gds.
     8362         assign hstc_c-doc-fbr-gds.chip-num = hstc_c-trn-doc.chip-num.
     8363       end.
     8364     if hstc_c-trn-doc.need-buyer = 1   and
     8365        hstc_c-trn-doc.cr-fo-buyer   = yes then do:
     8366       assign
     8367         hstc_c-trn-doc.cr-fo-buyer      = no
     8368         hstc_c-trn-doc.buyer-fo-date    = 01/01/1990.
     8369     end.
     8370     else do:
     8371       assign
     8372         hstc_c-trn-doc.need-buyer = 0
     8373         hstc_c-trn-doc.cr-fo-buyer   = no
     8374         hstc_c-trn-doc.buyer-fo-date = 01/01/1990.
     8375     end.
     8376     if hstc_c-trn-doc.need-incfo = 1   and
     8377        hstc_c-trn-doc.cr-incfo   = yes then do:
     8378       assign
     8379         hstc_c-trn-doc.cr-incfo      = no
     8380         hstc_c-trn-doc.incfo-date    = 01/01/1990.
     8381     end.
     8382     else do:
     8383       assign
     8384         hstc_c-trn-doc.need-incfo = 0
     8385         hstc_c-trn-doc.cr-incfo   = no
     8386         hstc_c-trn-doc.incfo-date = 01/01/1990.
     8387     end.
     8388     if hstc_c-trn-doc.need-expfo = 1   and
     8389        hstc_c-trn-doc.cr-expfo   = yes then do:
     8390       assign
     8391         hstc_c-trn-doc.cr-expfo      = no
     8392         hstc_c-trn-doc.expfo-date    = 01/01/1990.
     8393     end.
     8394     else do:
     8395       assign
     8396         hstc_c-trn-doc.need-expfo = 0
     8397         hstc_c-trn-doc.cr-expfo   = no
     8398         hstc_c-trn-doc.incfo-date = 01/01/1990.
     8399     end.
     8400     if hstc_c-trn-doc.need-incfo = 1 or
     8401        hstc_c-trn-doc.need-expfo = 1 then do:
     8402       assign
     8403         hstc_c-trn-doc.need-incorexpfo = 1.
     8404     end.
     8405     if hstc_c-trn-doc.cr-incfo = yes or
     8406        hstc_c-trn-doc.cr-expfo = yes then do:
     8407       assign
     8408         hstc_c-trn-doc.cr-incorexpfo = yes.
     8409     end.
     8410     end.
     8411   end procedure.
     8412   procedure lib-trn_hstd-trn :
     8413     define input parameter p-doc-code like ub.trn-doc.doc-code   no-undo.
     8414     define input parameter p-chip-num like ub.c-trn-doc.chip-num no-undo.
     8415     define buffer bf_goods       for ub.goods.
     8416     define buffer bf_pl-gds-pump for ub.pl-gds-pump.
     8417     define buffer bf_place       for ub.place.
     8418     define buffer bf_rvs-doc     for ub.rvs-doc.
     8419     do on error   undo, return error return-value
     8420        on end-key undo, return error return-value
     8421        on stop    undo, return error return-value :
     8422       for each ub.c-trn-doc where
     8423                ub.c-trn-doc.doc-code  = p-doc-code and
     8424                ub.c-trn-doc.chip-num <> p-chip-num :
     8425         delete ub.c-trn-doc.
     8426       end.
     8427       for each ub.c-trn-doc-sum where
     8428                ub.c-trn-doc-sum.doc-code  = p-doc-code and
     8429                ub.c-trn-doc-sum.chip-num <> p-chip-num :
     8430         delete ub.c-trn-doc-sum.
     8431       end.
     8432       for each ub.c-doc-attr where
     8433                ub.c-doc-attr.doc-code  = p-doc-code and
     8434                ub.c-doc-attr.chip-num <> p-chip-num :
     8435         delete ub.c-doc-attr.
     8436       end.
     8437       for each bf_rvs-doc no-lock where bf_rvs-doc.out-code = p-doc-code :
     8438         for each ub.c-rvs-doc where
     8439                  ub.c-rvs-doc.rvs-code =  bf_rvs-doc.rvs-code and
     8440                  ub.c-rvs-doc.chip-num <> p-chip-num          :
     8441           delete ub.c-rvs-doc.
     8442         end.
     8443       end.
     8444       for each ub.c-doc-line where
     8445                ub.c-doc-line.doc-code =  p-doc-code and
     8446                ub.c-doc-line.chip-num <> p-chip-num :
     8447         find first bf_goods no-lock where
     8448                    bf_goods.artic     = ub.c-doc-line.artic     and
     8449                    bf_goods.prod-type = ub.c-doc-line.prod-type and
     8450                    bf_goods.prod-code = ub.c-doc-line.prod-code .
     8451         for each ub.c-parts where
     8452                  ub.c-parts.out-code  =  ub.c-doc-line.doc-code  and
     8453                  ub.c-parts.obj-type  =  ub.c-doc-line.obj-type  and
     8454                  ub.c-parts.obj-code  =  ub.c-doc-line.obj-code  and
     8455                  ub.c-parts.artic     =  ub.c-doc-line.artic     and
     8456                  ub.c-parts.prod-type =  ub.c-doc-line.prod-type and
     8457                  ub.c-parts.prod-code =  ub.c-doc-line.prod-code and
     8458                  ub.c-parts.chip-num  <> p-chip-num              :
     8459           for each ub.c-parts-root where
     8460                    ub.c-parts-root.doc-code       =  ub.c-parts.out-code  and
     8461                    ub.c-parts-root.orig-in-code   =  ub.c-parts.in-code   and
     8462                    ub.c-parts-root.orig-gds-code  =  ub.c-goods.gds-code  and
     8463                    ub.c-parts-root.orig-part-code =  ub.c-parts.part-code and
     8464                    ub.c-parts-root.chip-num       <> p-chip-num           :
     8465             delete ub.c-parts-root.
     8466           end.
     8467           delete ub.c-parts.
     8468         end.
     8469         for each ub.c-parts-attr where
     8470                  ub.c-parts-attr.in-code  =  ub.c-doc-line.doc-code and
     8471                  ub.c-parts-attr.gds-code =  ub.c-goods.gds-code    and
     8472                  ub.c-parts-attr.chip-num <> p-chip-num             :
     8473           delete ub.c-parts-attr.
     8474         end.
     8475         for each ub.c-gds-dtl where
     8476                  ub.c-gds-dtl.doc-code  =  ub.c-doc-line.doc-code  and
     8477                  ub.c-gds-dtl.artic     =  ub.c-doc-line.artic     and
     8478                  ub.c-gds-dtl.prod-type =  ub.c-doc-line.prod-type and
     8479                  ub.c-gds-dtl.prod-code =  ub.c-doc-line.prod-code and
     8480                  ub.c-gds-dtl.chip-num  <> p-chip-num              :
     8481           delete ub.c-gds-dtl.
     8482         end.
     8483         for each ub.c-doc-prts where
     8484                  ub.c-doc-prts.out-code =  ub.c-doc-line.doc-code and
     8485                  ub.c-doc-prts.gds-code =  ub.c-goods.gds-code    and
     8486                  ub.c-doc-prts.chip-num <> p-chip-num             :
     8487           delete ub.c-doc-prts.
     8488         end.
     8489         for each ub.c-doc-pl where
     8490                  ub.c-doc-pl.out-code =  ub.c-doc-line.doc-code and
     8491                  ub.c-doc-pl.gds-code =  ub.c-goods.gds-code    and
     8492                  ub.c-doc-pl.chip-num <> p-chip-num             :
     8493           delete ub.c-doc-pl.
     8494         end.
     8495         find first ub.c-doc-pl-pump where ub.c-doc-pl-pump.gds-code = bf_goods.gds-code no-error.
     8496         if available ub.c-doc-pl-pump then do:
     8497           for each bf_place       no-lock where
     8498                    bf_place.obj-type       = ub.c-doc-line.obj-type and
     8499                    bf_place.obj-code       = ub.c-doc-line.obj-code
     8500             , each bf_pl-gds-pump no-lock where
     8501                    bf_pl-gds-pump.obj-type = bf_place.obj-type      and
     8502                    bf_pl-gds-pump.obj-code = bf_place.obj-code      and
     8503                    bf_pl-gds-pump.pl-code  = bf_place.pl-code       and
     8504                    bf_pl-gds-pump.gds-code = bf_goods.gds-code      :
     8505             for each ub.c-doc-pl-pump where
     8506                      ub.c-doc-pl-pump.obj-type  =  bf_pl-gds-pump.obj-type  and
     8507                      ub.c-doc-pl-pump.obj-code  =  bf_pl-gds-pump.obj-code  and
     8508                      ub.c-doc-pl-pump.pl-code   =  bf_pl-gds-pump.pl-code   and
     8509                      ub.c-doc-pl-pump.pump-code =  bf_pl-gds-pump.pump-code and
     8510                      ub.c-doc-pl-pump.out-code  =  ub.c-doc-line.doc-code   and
     8511                      ub.c-doc-pl-pump.gds-code  =  bf_goods.gds-code        and
     8512                      ub.c-doc-pl-pump.chip-num  <> p-chip-num               :
     8513               delete ub.c-doc-pl-pump.
     8514             end.
     8515           end.
     8516         end.
     8517         for each ub.c-doc-line-attr where
     8518                  ub.c-doc-line-attr.doc-code =  ub.c-doc-line.doc-code and
     8519                  ub.c-doc-line-attr.gds-code =  bf_goods.gds-code      and
     8520                  ub.c-doc-line-attr.chip-num <> p-chip-num             :
     8521           delete ub.c-doc-line-attr.
     8522         end.
     8523         for each ub.c-doc-line-sum where
     8524                  ub.c-doc-line-sum.doc-code =  ub.c-doc-line.doc-code and
     8525                  ub.c-doc-line-sum.gds-code =  bf_goods.gds-code      and
     8526                  ub.c-doc-line-sum.chip-num <> p-chip-num             :
     8527           delete ub.c-doc-line-sum.
     8528         end.
     8529         for each ub.c-doc-fbr-gds where
     8530                  ub.c-doc-fbr-gds.out-code =  ub.c-doc-line.doc-code and
     8531                  ub.c-doc-fbr-gds.gds-code =  bf_goods.gds-code      and
     8532                  ub.c-doc-fbr-gds.chip-num <> p-chip-num             :
     8533           delete ub.c-doc-fbr-gds.
     8534         end.
     8535         delete ub.c-doc-line.
     8536       end.
     8537     end.
     8538   end procedure.
     8539   procedure lib-trn_crdoclno :
     8540     define input parameter pardoc-code    like ub.trn-doc.doc-code     no-undo.
     8541     define input parameter parobj-type    like ub.trn-doc.obj-type     no-undo.
     8542     define input parameter parobj-code    like ub.trn-doc.obj-code     no-undo.
     8543     define input parameter parartic       like ub.goods.artic          no-undo.
     8544     define input parameter parprod-type   like ub.goods.prod-type      no-undo.
     8545     define input parameter parprod-code   like ub.goods.prod-code      no-undo.
     8546     define input parameter pargds-name    like ub.goods.gds-name       no-undo.
     8547     define input parameter parprt-root    like ub.goods.prt-root       no-undo.
     8548     define input parameter parvat-pc      like ub.doc-line.vat-pc      no-undo.
     8549     define input parameter parcons-vat-pc like ub.doc-line.cons-vat-pc no-undo.
     8550     define input parameter parcash-pay    like ub.sysconf.cash-pay     no-undo.
     8551     define variable l-inv-on           as logical             no-undo .
     8552     define variable v-clcdoc-host-code like ub.sysconf.host-code no-undo .
     8553     define variable v-clcdoc-vat-pc    like ub.doc-line.vat-pc   no-undo .
     8554     define variable v-clcdoc-slt-pc    like ub.doc-line.slt-pc   no-undo .
     8555     define variable g-log              as logical             no-undo .
     8556     define buffer crd_doc-line for ub.doc-line.
     8557     define buffer crd_trn-doc  for ub.trn-doc.
     8558     define buffer crd_goods    for ub.goods.
     8559     define buffer crd_sysconf  for ub.sysconf.
     8560     do on error undo, return error return-value :
     8561   define variable vss-include-info81 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8562   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     8563     (input  parobj-type
     8564     ,input  parobj-code
     8565     ,input  parartic
     8566     ,input  parprod-type
     8567     ,input  parprod-code
     8568     ,input  'inv-on=request'
     8569     ,output l-inv-on
     8570     ) no-error .
     8571       if error-status :error then do:
     8572         undo, return error substitute( "Ошибка получения признака товара на объекте &1 &2.",
     8573                                        error-status :get-message( 1 ), return-value ).
     8574       end.
     8575       if l-inv-on = yes then do:
     8576         assign g-log = yes.
     8577         message "Артикул :" parartic pargds-name "- товар в инвентаризации." skip (2)
     8578                 "Добавление невозможно." skip (2)
     8579                 "OK - пропустить товар, Cancel - отменить копирование"
     8580         view-as alert-box question buttons OK-Cancel update g-log.
     8581         if g-log = true then do:
     8582           return "next".
     8583         end.
     8584         else do:
     8585           undo, return error.
     8586         end.
     8587       end.
     8588       find crd_doc-line where crd_doc-line.doc-code  = pardoc-code
     8589                           and crd_doc-line.artic     = parartic
     8590                           and crd_doc-line.prod-code = parprod-code
     8591                           and crd_doc-line.prod-type = parprod-type no-error.
     8592       if not available crd_doc-line then do:
     8593         find first crd_trn-doc where crd_trn-doc.doc-code = pardoc-code.
     8594         find first crd_goods where crd_goods.artic     = parartic     and
     8595                                    crd_goods.prod-type = parprod-type and
     8596                                    crd_goods.prod-code = parprod-code no-lock no-error.
     8597         if error-status :error then do:
     8598           return error substitute( "Нет товара &1 &2 &3.", crd_doc-line.artic, crd_doc-line.prod-type, crd_doc-line.prod-code ).
     8599         end.
     8600         if parvat-pc = ? then do:
     8601   define variable vss-include-info82 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8602   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     8603     (input  parobj-type
     8604     ,input  parobj-code
     8605     ,output v-clcdoc-host-code
     8606     )  .
     8607   define variable vss-include-info83 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8608   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     8609     (input  crd_goods.gds-code
     8610     ,input  '1':U
     8611     ,input  ?
     8612     ,input  v-clcdoc-host-code
     8613     ,input  parobj-type
     8614     ,input  parobj-code
     8615     ,output v-clcdoc-vat-pc
     8616     ) no-error .
     8617         end.
     8618         find first crd_sysconf where crd_sysconf.host-code = crd_trn-doc.host-code.
     8619         if crd_sysconf.cons-vat-pc = ? then do:
     8620           return error "У Вас не установлен НДС для консигнационного товара по фирме.".
     8621         end.
     8622   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_st-sltpc in g#lib-trn
     8623   (
     8624    input  recid(crd_goods)
     8625   ,input  recid(crd_trn-doc)
     8626   ,input  parcash-pay
     8627   ,output v-clcdoc-slt-pc
     8628   )
     8629   no-error.
     8630         if error-status :error then do:
     8631           return error return-value.
     8632         end.
     8633   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_crdoclin in g#lib-trn
     8634   (input pardoc-code
     8635   ,input parartic
     8636   ,input parprod-type
     8637   ,input parprod-code
     8638   ,input parobj-type
     8639   ,input parobj-code
     8640   ,input crd_trn-doc.status_
     8641   ,input crd_trn-doc.ext-doc-type
     8642   ,input parprt-root
     8643   ,input (if parvat-pc = ? then v-clcdoc-vat-pc else parvat-pc)
     8644   ,input v-clcdoc-slt-pc
     8645   ,input crd_sysconf.cons-vat-pc
     8646   ) no-error
     8647   .
     8648         if error-status :error then do:
     8649           return error return-value.
     8650         end.
     8651         find first crd_doc-line where crd_doc-line.doc-code  = pardoc-code  and
     8652                                       crd_doc-line.artic     = parartic     and
     8653                                       crd_doc-line.prod-type = parprod-type and
     8654                                       crd_doc-line.prod-code = parprod-code exclusive-lock.
     8655         if crd_doc-line.cli-base-rate = 0 or crd_doc-line.cli-base-rate = ? then
     8656            crd_doc-line.cli-base-rate = 1 .
     8657         assign
     8658           crd_doc-line.prt-OK     = yes
     8659           crd_doc-line.doc-qnty   = 0.
     8660       end.
     8661     end.
     8662   end procedure.
     8663   define temp-table tt-doc-line no-undo like lib-trn_ret-line.
     8664   define temp-table tt-gds-dtl  no-undo like ub.gds-dtl.
     8665   define temp-table tt-parts    no-undo like ub.parts.
     8666   procedure lib-trn_copy-ret :
     8667   define input parameter parparentproc  AS WIDGET-HANDLE            NO-UNDO.
     8668   define input parameter pardoc-code    like ub.trn-doc.doc-code    no-undo.
     8669   define input parameter pardoc-type    like ub.trn-doc.doc-type    no-undo.
     8670   define input parameter parstatus_     like ub.trn-doc.status_     no-undo.
     8671   define input parameter parinternal    like ub.trn-doc.internal    no-undo.
     8672   define input parameter parcli-type    like ub.trn-doc.cli-type    no-undo.
     8673   define input parameter parcli-code    like ub.trn-doc.cli-code    no-undo.
     8674   define input parameter pardiscnt-type like ub.trn-doc.discnt-type no-undo.
     8675   define input parameter partot-calc    like ub.trn-doc.tot-calc    no-undo.
     8676   define input parameter pardiscnt-pc   like ub.trn-doc.discnt-pc   no-undo.
     8677   define input parameter paragnt        like ub.trn-doc.agnt        no-undo.
     8678   define input parameter parboss        like ub.trn-doc.boss        no-undo.
     8679   define input parameter parwrkr        like ub.trn-doc.wrkr        no-undo.
     8680   define input parameter parbase-rate   like ub.trn-doc.base-rate   no-undo.
     8681   define input parameter parbase-scale  like ub.trn-doc.base-scale  no-undo.
     8682   define input parameter parexch-code   like ub.trn-doc.exch-code   no-undo.
     8683   define input parameter parvat-type    like ub.trn-doc.vat-type    no-undo.
     8684   define input parameter pardstdoc-code     like ub.trn-doc.doc-code    no-undo.
     8685   define input parameter parinp-discnt-type as   logical                no-undo.
     8686   define input parameter parinp-discnt-pc   like ub.trn-doc.discnt-pc   no-undo.
     8687   define input parameter parinp-agnt        like ub.trn-doc.agnt        no-undo.
     8688   define input parameter parinp-boss        like ub.trn-doc.boss        no-undo.
     8689   define input parameter parinp-wrkr        like ub.trn-doc.wrkr        no-undo.
     8690   define input parameter parinp-base-rate   like ub.trn-doc.base-rate   no-undo.
     8691   define input parameter parinp-base-scale  like ub.trn-doc.base-scale  no-undo.
     8692   define input parameter parcash-pay        like ub.sysconf.cash-pay    no-undo.
     8693   define input parameter parglob-base-code  like ub.sysconf.base-code   no-undo.
     8694   define input-output parameter table for tt-doc-line.
     8695   define input-output parameter table for tt-gds-dtl.
     8696   define input-output parameter table for tt-parts.
     8697   define input parameter paruse-parts       as   logical                no-undo.
     8698   define input parameter parall-qnty        as   logical                no-undo.
     8699   define input parameter parfix-price       as   logical                no-undo.
     8700   define input parameter parrsrv-fact-qnty  as   logical                no-undo.
     8701   define buffer crt_trn-doc    for ub.trn-doc.
     8702   define buffer crt_goods      for ub.goods.
     8703   define buffer crt_doc-line   for ub.doc-line.
     8704   define buffer crt_gds-dtl    for ub.gds-dtl.
     8705   define buffer bf-cas_trn-doc for ub.trn-doc.
     8706   define buffer crt_doc-pl     for ub.doc-pl.
     8707   define buffer crt_lib-trn_ret-doc       for ub.trn-doc.
     8708   define buffer crt_lib-trn_ret-parts     for ub.parts.
     8709   define variable fix-price        as   logical              no-undo.
     8710   define variable end-price        as   logical              no-undo.
     8711   define variable real-type        like ub.goods.gds-type    no-undo.
     8712   define variable legal-node       like ub.gds-prt.node-code no-undo.
     8713   define variable chg-qnty         like ub.gds-dtl.fact-qnty no-undo.
     8714   define variable mem-qnty         like ub.gds-dtl.fact-qnty no-undo.
     8715   define variable fix-qnty         like ub.gds-dtl.doc-qnty  no-undo.
     8716   define variable varchg-qnty      like ub.gds-dtl.fact-qnty no-undo.
     8717   define variable varcheck-qnty    like ub.gds-dtl.fact-qnty no-undo.
     8718   define variable g-log            as   logical              no-undo.
     8719   define variable v-is-hold        as   logical              no-undo.
     8720   define variable v-add-par        as   character            no-undo.
     8721   define variable v-reserv-pl-code as   logical              no-undo.
     8722   define variable var_is-petrol    as   logical              no-undo.
     8723   define variable var_is-pieces    as   logical              no-undo.
     8724   define variable l_place-rsrv     as   logical              no-undo.
     8725   define variable is_doc-pl_rsrv   as   logical              no-undo initial no.
     8726   define variable full-rsrv-qnty   like ub.gds-dtl.fact-qnty no-undo.
     8727   define variable v-doc-pl-rowid   as   rowid                no-undo.
     8728   define variable v-density        like ub.doc-line.fact-density no-undo.
     8729   define variable v-gds-mark       as   logical              no-undo.
     8730   define variable v-gds-attr-value as   character            no-undo.
     8731   define variable v-gds-attr-type  as   character            no-undo.
     8732   define variable vIsExemplarGoods  as   logical              no-undo.
     8733   define variable vIsVolumArticGoods as   logical              no-undo.
     8734   define variable vss-include-info84 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8735     define variable v-cntxt-db-num        as integer   no-undo .
     8736     define variable v-cntxt-userid        as character no-undo .
     8737     define variable v-cntxt-level         as character no-undo .
     8738     define variable v-cntxt-host-code-obj as integer   no-undo .
     8739     define variable v-cntxt-obj-type      as character no-undo .
     8740     define variable v-cntxt-obj-code      as integer   no-undo .
     8741     define variable v-cntxt-db-num-obj    as integer   no-undo .
     8742     define variable v-cntxt-is-admin      as logical   no-undo .
     8743   c-l:
     8744   do
     8745   on error undo c-l, return error return-value
     8746   on stop  undo c-l, return error "(copy-ret) stop"
     8747   :
     8748   define variable vss-include-info85 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8749     run mainmenu_getcntxt in parparentproc
     8750       (output v-cntxt-db-num
     8751       ,output v-cntxt-userid
     8752       ,output v-cntxt-level
     8753       ,output v-cntxt-host-code-obj
     8754       ,output v-cntxt-obj-type
     8755       ,output v-cntxt-obj-code
     8756       ,output v-cntxt-db-num-obj
     8757       ,output v-cntxt-is-admin
     8758       ) .
     8759   find first crt_trn-doc where crt_trn-doc.doc-code = pardstdoc-code.
     8760   find first crt_lib-trn_ret-doc where crt_lib-trn_ret-doc.doc-code = pardoc-code.
     8761   if paruse-parts      =  yes and
     8762      parrsrv-fact-qnty <> yes then do:
     8763     return error "Неверно установлены параметры для процедуры copy-ret. Резервирование по партиям можно проводить только по фактическому количеству.".
     8764   end.
     8765   if paruse-parts = yes and
     8766      parall-qnty  <> yes then do:
     8767     return error "Неверно установлены параметры для процедуры copy-ret. Резервирование по партиям можно проводить только по всему количеству.".
     8768   end.
     8769   assign
     8770     fix-price = parfix-price.
     8771   if fix-price <> yes then do:
     8772     if crt_trn-doc.internal and
     8773        crt_trn-doc.doc-type <> 'при':U                  or
     8774        crt_trn-doc.ext-doc-type = 'ep':U and
     8775        crt_trn-doc.status_ <> 'запрос':U      then do:
     8776       assign
     8777        fix-price = no.
     8778     end.
     8779     else do:
     8780       fix-price = no.
     8781       message "Зафиксировать исходные цены ?" skip (2)
     8782               "Цены в добавляемых строках будут :" skip
     8783               "YES - равны ценам документа - источника;" skip
     8784               "NO - подставлены текущие цены продажи."
     8785               view-as alert-box question buttons YES-NO update fix-price.
     8786       assign
     8787         g-log = yes.
     8788       if fix-price and can-do
     8789         ('рас':U, crt_trn-doc.doc-type)
     8790       then do:
     8791   define variable vss-include-info86 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8792   do:
     8793     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8794       (input  v-cntxt-db-num
     8795       ,input  v-cntxt-userid
     8796       ,input  0
     8797       ,input  'actn_expense_price':U
