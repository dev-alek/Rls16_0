     1011         v-ignore-list  = "c-goods,c-order-line":U
     1012         v-special-list = "goods,ot-line,stk-line,order-line":U
     1013       .
     1014   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1015       define variable v-ind         as integer   no-undo .
     1016       define variable v-num-entries as integer   no-undo .
     1017       define variable v-inform      as character no-undo .
     1018       define variable bh_tbl-name   as handle    no-undo .
     1019       define variable v-tbl-not-idx as character no-undo .
     1020       define variable v-idx-avail   as logical   no-undo .
     1021       define variable new-tbl-list  as character no-undo .
     1022       define variable old-tbl-list  as character no-undo .
     1023       define variable old-tbl-avail as logical   no-undo .
     1024       define variable v-double-tbl  as character no-undo .
     1025       define variable v-tbl-name    as character no-undo .
     1026       define variable v-msg         as character no-undo .
     1027       assign
     1028         v-msg         = "":U
     1029         v-tbl-not-idx = "":U
     1030         new-tbl-list  = "":U
     1031       .
     1032       for each ub._Field no-lock
     1033         where ub._Field._Field-Name = 'artic':U
     1034       ,first ub._File of ub._Field
     1035       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1036       :
     1037         if  lookup( ub._File._File-Name, v-std-list     ) = 0
     1038         and lookup( ub._File._File-Name, v-ignore-list  ) = 0
     1039         and lookup( ub._File._File-Name, v-special-list ) = 0
     1040         then do:
     1041           assign
     1042             new-tbl-list = new-tbl-list + chr(10) + ub._File._File-Name
     1043           .
     1044         end.
     1045         if lookup( ub._File._File-Name, v-std-list ) <> 0
     1046           or lookup( ub._File._File-Name, new-tbl-list, chr(10) ) <> 0
     1047         then do:
     1048           create buffer bh_tbl-name for table substitute( "ub.&1":U, ub._File._File-Name ) .
     1049           assign
     1050             v-idx-avail = false
     1051             v-inform    = bh_tbl-name:index-information(1)
     1052             v-ind       = 2
     1053           .
     1054           block_chk-idx:
     1055           do while v-inform <> ?
     1056           on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1057           :
     1058             if v-inform <> ?
     1059                 and lookup( entry( 5, v-inform, ",":U ), "artic,prod-type,prod-code":U ) > 0
     1060                 and lookup( entry( 7, v-inform, ",":U ), "artic,prod-type,prod-code":U ) > 0
     1061                 and lookup( entry( 9, v-inform, ",":U ), "artic,prod-type,prod-code":U ) > 0
     1062             then do:
     1063               assign
     1064                 v-idx-avail = true
     1065               .
     1066               leave block_chk-idx.
     1067             end.
     1068             assign
     1069               v-inform = bh_tbl-name:index-information( v-ind )
     1070               v-ind    = v-ind + 1
     1071             .
     1072           end.
     1073           if v-idx-avail = false then do:
     1074             if lookup( ub._File._File-Name, new-tbl-list, chr(10) ) <> 0 then do:
     1075               assign
     1076                 new-tbl-list = new-tbl-list + " (индекса нет)"
     1077               .
     1078             end.
     1079             else do:
     1080               assign
     1081                 v-tbl-not-idx = v-tbl-not-idx + chr(10) + ub._File._File-Name
     1082               .
     1083             end.
     1084           end.
     1085           delete object bh_tbl-name.
     1086         end.
     1087       end.
     1088       assign
     1089         old-tbl-list  = "":U
     1090         v-double-tbl  = "":U
     1091         v-num-entries = num-entries( v-std-list )
     1092       .
     1093       do v-ind = 1 to v-num-entries
     1094       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1095       :
     1096         assign
     1097           v-tbl-name    = entry( v-ind, v-std-list )
     1098           old-tbl-avail = false
     1099         .
     1100         find first ub._File no-lock
     1101           where ub._File._File-Name = v-tbl-name
     1102           no-error .
     1103         if not available ub._File then do:
     1104           assign
     1105             old-tbl-avail = true
     1106           .
     1107         end.
     1108         else do:
     1109           find first ub._Field no-lock
     1110             where ub._Field._File-recid = recid( ub._File )
     1111               and ub._Field._Field-Name = 'artic':U
     1112             no-error .
     1113           if not available ub._Field then do:
     1114             assign
     1115               old-tbl-avail = true
     1116             .
     1117           end.
     1118             find first ub._Field no-lock
     1119               where ub._Field._File-recid = recid( ub._File )
     1120                 and ub._Field._Field-Name = "prod-type"
     1121               no-error .
     1122             if not available ub._Field then do:
     1123               assign
     1124                 old-tbl-avail = true
     1125               .
     1126             end.
     1127             find first ub._Field no-lock
     1128               where ub._Field._File-recid = recid( ub._File )
     1129                 and ub._Field._Field-Name = "prod-code"
     1130               no-error .
     1131             if not available ub._Field then do:
     1132               assign
     1133                 old-tbl-avail = true
     1134               .
     1135             end.
     1136         end.
     1137         if old-tbl-avail = true then do:
     1138           assign
     1139             old-tbl-list = old-tbl-list + chr(10) + v-tbl-name
     1140           .
     1141         end.
     1142         if ( lookup( v-tbl-name, v-std-list ) > v-ind
     1143              or lookup( v-tbl-name, v-ignore-list ) > 0
     1144              or lookup( v-tbl-name, v-special-list ) > 0
     1145            )
     1146           and lookup( v-tbl-name, v-double-tbl, chr(10) ) = 0
     1147         then do:
     1148           assign
     1149             v-double-tbl = v-double-tbl + chr(10) + v-tbl-name
     1150           .
     1151         end.
     1152       end.
     1153       assign
     1154         v-num-entries = num-entries( v-ignore-list )
     1155       .
     1156       do v-ind = 1 to v-num-entries
     1157       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1158       :
     1159         assign
     1160           v-tbl-name = entry( v-ind, v-ignore-list )
     1161           old-tbl-avail = false
     1162         .
     1163         find first ub._File no-lock
     1164           where ub._File._File-Name = v-tbl-name
     1165           no-error .
     1166         if not available ub._File then do:
     1167           assign
     1168             old-tbl-avail = true
     1169           .
     1170         end.
     1171         else do:
     1172           find first ub._Field no-lock
     1173             where ub._Field._File-recid = recid( ub._File )
     1174               and ub._Field._Field-Name = 'artic':U
     1175             no-error .
     1176           if not available ub._Field then do:
     1177             assign
     1178               old-tbl-avail = true
     1179             .
     1180           end.
     1181             find first ub._Field no-lock
     1182               where ub._Field._File-recid = recid( ub._File )
     1183                 and ub._Field._Field-Name = "prod-type"
     1184               no-error .
     1185             if not available ub._Field then do:
     1186               assign
     1187                 old-tbl-avail = true
     1188               .
     1189             end.
     1190             find first ub._Field no-lock
     1191               where ub._Field._File-recid = recid( ub._File )
     1192                 and ub._Field._Field-Name = "prod-code"
     1193               no-error .
     1194             if not available ub._Field then do:
     1195               assign
     1196                 old-tbl-avail = true
     1197               .
     1198             end.
     1199         end.
     1200         if old-tbl-avail = true then do:
     1201           assign
     1202             old-tbl-list = old-tbl-list + chr(10) + v-tbl-name
     1203           .
     1204         end.
     1205         if ( lookup( v-tbl-name, v-std-list ) > 0
     1206              or lookup( v-tbl-name, v-ignore-list ) > v-ind
     1207              or lookup( v-tbl-name, v-special-list ) > 0
     1208            )
     1209           and lookup( v-tbl-name, v-double-tbl, chr(10) ) = 0
     1210         then do:
     1211           assign
     1212             v-double-tbl = v-double-tbl + chr(10) + v-tbl-name
     1213           .
     1214         end.
     1215       end.
     1216       assign
     1217         v-num-entries = num-entries( v-special-list )
     1218       .
     1219       do v-ind = 1 to v-num-entries
     1220       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1221       :
     1222         assign
     1223           v-tbl-name = entry( v-ind, v-special-list )
     1224         .
     1225         find first ub._File no-lock
     1226           where ub._File._File-Name = v-tbl-name
     1227           no-error .
     1228         if available ub._File then do:
     1229           find first ub._Field no-lock
     1230             where ub._Field._File-recid = recid( ub._File )
     1231               and ub._Field._Field-Name = 'artic':U
     1232             no-error .
     1233         end.
     1234         if not available ub._File
     1235           or ( available ub._File
     1236                and not available ub._Field
     1237              )
     1238         then do:
     1239           assign
     1240             old-tbl-list = old-tbl-list + chr(10) + v-tbl-name
     1241           .
     1242         end.
     1243         if ( lookup( v-tbl-name, v-std-list ) > 0
     1244              or lookup( v-tbl-name, v-ignore-list ) > 0
     1245              or lookup( v-tbl-name, v-special-list ) > v-ind
     1246            )
     1247           and lookup( v-tbl-name, v-double-tbl, chr(10) ) = 0
     1248         then do:
     1249           assign
     1250             v-double-tbl = v-double-tbl + chr(10) + v-tbl-name
     1251           .
     1252         end.
     1253       end.
     1254       if v-tbl-not-idx <> "" then do:
     1255         assign
     1256           v-msg = v-msg + substitute( "Таблицы не имеют индекса с полями &3 на первом месте и нет спецобработки: &2&1&1", chr(10), v-tbl-not-idx, 'artic, prod-type, prod-code':U )
     1257         .
     1258       end.
     1259       if new-tbl-list <> "":U then do:
     1260         assign
     1261           v-msg = v-msg + substitute( "Нет обработки таблиц: &2&1&1", chr(10), new-tbl-list )
     1262         .
     1263       end.
     1264       if v-double-tbl <> "":U then do:
     1265         assign
     1266           v-msg = v-msg + substitute( "В списках есть задублированные таблицы: &2&1&1", chr(10), v-double-tbl )
     1267         .
     1268       end.
     1269       if old-tbl-list <> "":U then do:
     1270         assign
     1271           v-msg = v-msg + substitute( "В списках есть несуществующие таблицы или таблицы в которых отсутствуют переименовываемые поля: &2&1&1", chr(10), old-tbl-list )
     1272         .
     1273       end.
     1274       if v-msg <> "":U then do:
     1275         return error substitute( "Утилита переименования &3 не корректна.&1&1&2", chr(10), v-msg, 'artic, prod-type, prod-code':U ) .
     1276       end.
     1277     end.
     1278   end procedure.
     1279   procedure check-use-artic :
     1280     define input  parameter p-tbl-name  as   character                      no-undo .
     1281     define input  parameter p-artic     like ub.goods.artic     no-undo .
     1282     define input  parameter p-prod-type like ub.goods.prod-type no-undo .
     1283     define input  parameter p-prod-code like ub.goods.prod-code no-undo .
     1284     do
     1285     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info9, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1286     on stop   undo, return error substitute( "&1. stop",   vss-include-info9 )
     1287     on endkey undo, return error substitute( "&1. endkey", vss-include-info9 )
     1288     :
     1289       define buffer buf_goods for ub.goods .
     1290       if lookup( p-tbl-name, "c-goods,c-order-line":U ) = 0 then do:
     1291         find first buf_goods no-lock
     1292           where buf_goods.artic     = p-artic
     1293             and buf_goods.prod-type = p-prod-type
     1294             and buf_goods.prod-code = p-prod-code
     1295           no-error .
     1296         if not available buf_goods then do:
     1297           return error substitute( "&1 (check-use-artic). Не найден товар с артикулом &2 и производителем &3 &4", vss-include-info9, p-artic, p-prod-type, p-prod-code ) .
     1298         end.
     1299         if buf_goods.stts = integer('51':U) then do:
     1300           return error substitute( "&1 (check-use-artic). Нельзя использовать товар с артикулом &2 и производителем &3 &4&5"
     1301                                   + "Выполняется переименование артикула и(или) производителя"
     1302                                   ,vss-include-info9
     1303                                   ,p-artic
     1304                                   ,p-prod-type
     1305                                   ,p-prod-code
     1306                                   ,chr(10)
     1307                                 ) .
     1308         end.
     1309       end.
     1310       return .
     1311     end.
     1312   end procedure.
     1313     function valid-density returns logical ( input p-density as decimal, input p-unit-base-cli-eq as logical ) :
     1314       define variable v-answ as logical no-undo .
     1315       if ( p-unit-base-cli-eq = true
     1316            and p-density = 1.0
     1317          )
     1318         or ( p-unit-base-cli-eq = false
     1319              and p-density <> ?
     1320              and p-density > 0.0
     1321              and p-density < 1.0
     1322            )
     1323       then do:
     1324         assign
     1325           v-answ = true
     1326         .
     1327       end.
     1328       else do:
     1329         assign
     1330           v-answ = false
     1331         .
     1332       end.
     1333       return v-answ.
     1334     end function.
