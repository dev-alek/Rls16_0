        1   define input        parameter parParentProc  as widget-handle no-undo.
        2   define input        parameter p-bttns        as character     no-undo.
        3   define input        parameter p-mode         as character     no-undo.
        4   define input        parameter p-obj-type     as character     no-undo.
        5   define input        parameter p-obj-code     as integer       no-undo.
        6   define input        parameter p-ext-doc-type as character     no-undo.
        7   define input        parameter p-hold-doc     as logical       no-undo.
        8   define input-output parameter p-rid-list     as character     no-undo.
        9   define variable vss-revision    as character no-undo initial "$Revision$":U.
       10   define variable vss-author      as character no-undo initial "$Author$":U.
       11   define variable vss-date        as character no-undo initial "$Date$":U.
       12   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
       13   define variable vss-archive     as character no-undo initial "$Archive$":U.
       14   define variable vss-description as character no-undo initial "История оснований (причин) создания документа по объекту":U.
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   procedure proc-alt-shift-f2:
       76     if not ibs.th.gbl.gbl-var:rcode
       77   then
       78     run gbl\inidebug.p .
       79   end.
       80   procedure proc-alt-shift-f3:
       81     run gbl/prvssinf.p
       82       ( input this-procedure
       83       ) .
       84   end.
       85   define variable v-inform-launched as logical no-undo initial false .
       86   procedure proc-alt-shift-f4:
       87     define variable v-action as character no-undo .
       88     if v-inform-launched = false then do:
       89       assign
       90         v-inform-launched = true
       91       .
       92       run gbl/d-inform.w
       93         (  input self
       94         ,  input this-procedure
       95         , output v-action
       96         ) no-error .
       97       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       98       assign
       99         v-inform-launched = false
      100       .
      101     end.
      102   end.
      103   procedure proc-alt-f1:
      104     run gbl/corrhelp.p
      105       (input this-procedure
      106       ) .
      107   end .
      108   on alt-shift-f2 anywhere do:
      109     run proc-alt-shift-f2.
      110   end.
      111   on alt-shift-f3 anywhere do:
      112     run proc-alt-shift-f3 in this-procedure .
      113   end.
      114   on alt-shift-f4 anywhere do:
      115     run proc-alt-shift-f4 in this-procedure.
      116   end.
      117   on alt-f1 anywhere do:
      118     run proc-alt-f1 in this-procedure .
      119   end.
      120   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      121   define variable c-point  as character no-undo .
      122   define variable tbl      as character no-undo .
      123   define variable join-tbl as character no-undo .
      124   define variable fld      as character no-undo .
      125   define variable lab      as character no-undo .
      126   define variable spr      as character no-undo .
      127   define variable dim      as character no-undo .
      128   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      129   define variable v-waitfram-action01         as character   no-undo .
      130   define variable v-waitfram-action02         as character   no-undo .
      131   define variable v-waitfram-action03         as character   no-undo .
      132   define variable mWaitFramTextBeg            as character   no-undo.
      133   define variable mWaitFramTextEnd            as character   no-undo.
      134   define variable mWaitFramView               as logical     no-undo.
      135   define variable mWaitProcEvent              as logical     no-undo init yes.
      136   define variable mWaitFramInterval           as integer     no-undo init 1 .
      137   define variable mWaitFramStop               as logical     no-undo.
      138   define variable mWaitFramStopUser           as logical     no-undo.
      139   define variable mWaitFramStopTimeOut        as logical     no-undo.
      140   define variable mWaitFramStartProc          as datetime-tz no-undo.
      141   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      142   define button B-WaitFramStop auto-end-key
      143        label "Стоп"
      144        size 10 by 1 tooltip "Остоновить процесс".
      145   define button B-viewProcInfo
      146        label "Информация"
      147        size 15 by 1 tooltip "Информация о процесс".
      148   define frame waitfram
      149     v-waitfram-action01 format "x(72)" no-label skip
      150     v-waitfram-action02 format "x(72)" no-label skip
      151     v-waitfram-action03 format "x(72)" no-label skip
      152     B-viewProcInfo
      153     B-WaitFramStop at row 4 col 30
      154     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      155     .
      156   define new global shared variable mBatchMode as logical no-undo init ?.
      157   define variable mFramBachModHandle as handle no-undo.
      158   mFramBachModHandle = frame waitfram:handle.
      159   define variable mFameOldVis as logical no-undo.
      160   define variable mVisCUrentVin as logical no-undo.
      161   if session:batch-mode
      162   then
      163      mBatchMode = yes.
      164   if mBatchMode = ? then do:
      165     mVisCUrentVin = current-window:visible.
      166     mFameOldVis = mFramBachModHandle:visible.
      167     mFramBachModHandle:visible  = yes.
      168     mBatchMode = mFramBachModHandle:visible ne yes.
      169     mFramBachModHandle:visible = mFameOldVis.
      170     current-window:visible = mVisCUrentVin.
      171   end.
      172    if  log-manager:logfile-name ne ?
      173     then DO:
      174         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      175         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      176         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      177     end.
      178   on choose of B-WaitFramStop in frame waitfram
      179   do:
      180     mWaitFramStop = yes.
      181     mWaitFramStopUser = yes.
      182   end.
      183   function waitfram-check-timeout returns logical():
      184      define variable vtime as int64 no-undo.
      185      if mWaitFramStopTimeOut
      186      then
      187         return yes.
      188      vtime = ( now - mWaitFramStartProc ) / 1000 .
      189      if     mWaitFramTimeOut ne ?
      190         and mWaitFramTimeOut ne 0
      191         and mWaitFramTimeOut lt vtime
      192      then do:
      193         mWaitFramStopTimeOut = yes.
      194      end.
      195      return mWaitFramStopTimeOut.
      196   end.
      197   procedure waitfram-hide :
      198     if not session:batch-mode
      199     then do
      200     on error undo, return error return-value
      201     :
      202       pause 0 before-hide .
      203       if not mBatchMode then
      204         hide frame waitfram .
      205     if     not mWaitFramView
      206        and mWaitProcEvent
      207     then
      208       process events .
      209     end.
      210   end procedure.
      211   procedure waitfram-show :
      212     define input  parameter p-message as character no-undo .
      213     define variable v-left-margin as integer   no-undo .
      214     if not session:batch-mode
      215     then do
      216     on error undo, return error return-value
      217     :
      218       if length(p-message) <= 70 then do:
      219         assign
      220           v-left-margin = integer((70 - length(p-message)) / 2)
      221         .
      222         assign
      223           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      224         .
      225         assign
      226           v-waitfram-action01 = " "
      227           v-waitfram-action02 = " "
      228                                    + fill(" ", v-left-margin)
      229                                    + p-message
      230           v-waitfram-action03 = " "
      231         .
      232       end.
      233       else do:
      234         define variable vRindex1 as integer no-undo.
      235         define variable vRindex2 as integer no-undo.
      236         vRindex1 = r-index(p-message," ",70).
      237         if vRindex1 = 0
      238         then
      239            vRindex1 = 70.
      240         if length(p-message)  <= vRindex1 + 70 then do:
      241           assign
      242             v-waitfram-action01 = " "
      243             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      244             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      245           .
      246         end.
      247         else do:
      248           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      249           if vRindex2 <= vRindex1
      250           then
      251              vRindex2 = vRindex1 + 70.
      252           assign
      253             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      254             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      255             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      256           .
      257         end.
      258       end.
      259       B-viewProcInfo:visible   in frame waitfram = no.
      260       B-viewProcInfo:sensitive in frame waitfram = no.
      261       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      262       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      263       if  (   mWaitFramView
      264          or  mWaitProcEvent)
      265          and not mBatchMode
      266       then
      267          display
      268             v-waitfram-action01 skip
      269             v-waitfram-action02 skip
      270             v-waitfram-action03 skip
      271          with frame waitfram .
      272       if     mWaitFramView
      273          then do:
      274             if     mWaitFramInterval ne ?
      275                and not mBatchMode
      276             then
      277                wait-for go of frame waitfram pause mWaitFramInterval.
      278          end.
      279          else
      280             if     mWaitProcEvent
      281                and not mBatchMode
      282             then
      283                process events .
      284     end.
      285   end procedure.
      286      procedure waitfram-show-this:
      287         define input  parameter iInterval as int64 no-undo.
      288         define variable vtime as int64 no-undo.
      289         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      290         mWaitFramInterval = iInterval.
      291         run waitfram-show (substitute("&1&2 &3&4" ,
      292                                       mWaitFramTextBeg ,
      293                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      294                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      295                                       mWaitFramTextEnd
      296                                      )
      297                           ).
      298      end.
      299      procedure WaitFramRunPause:
      300         define input  parameter iInterval as dec no-undo.
      301         define variable vStart  as datetime-tz no-undo.
      302         define variable vend    as datetime-tz no-undo.
      303         define variable vint as int64 no-undo.
      304         define variable vOk as logical no-undo.
      305         vStart = now.
      306         vend   = vStart.
      307         publish "WaitFramPause" (iInterval,output vOk).
      308         vend   =  now.
      309         vint = vend - vStart.
      310         vint = iInterval - vint / 1000.
      311         if     not mWaitFramStop
      312            and (   vint > 0
      313                 or (    not vOk
      314                     and iInterval eq ?
      315                     )
      316                 )
      317         then
      318            run waitfram-show-this (iInterval).
      319         vend   =  now.
      320         vint = vend - vStart.
      321         vint = iInterval - vint / 1000.
      322         if     not mWaitFramStop
      323            and vint > 0
      324         then do:
      325            run gbl/pause.p (vint * 1000).
      326         end.
      327         if iInterval ne ?
      328         then
      329            publish "WaitFramStop".
      330         waitfram-check-timeout().
      331      end.
      332      procedure WaitFramWaitFor:
      333         define input  parameter iInterval as dec no-undo.
      334         assign
      335            mWaitFramStartProc   = now
      336            mWaitFramStopUser    = no
      337            mWaitFramStopTimeOut = no
      338         .
      339         block-wait:
      340         do while not mWaitFramStop:
      341            run WaitFramRunPause (iInterval).
      342            if  waitfram-check-timeout()
      343            then do:
      344               leave block-wait.
      345            end.
      346         end.
      347         run waitfram-hide.
      348      end.
      349   procedure waitfram-join :
      350     define input  parameter p-line-1  as character no-undo .
      351     define input  parameter p-line-2  as character no-undo .
      352     define input  parameter p-line-3  as character no-undo .
      353     define output parameter p-message as character no-undo .
      354     do
      355     on error undo, return error return-value
      356     :
      357       assign
      358         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      359                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      360                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      361       .
      362     end.
      363   end procedure.
      364   function waitfram-join-function returns character
      365     (input p-line-1 as character
      366     ,input p-line-2 as character
      367     ,input p-line-3 as character
      368     ).
      369     define variable v-message as character no-undo .
      370     run waitfram-join in this-procedure
      371       (input  p-line-1
      372       ,input  p-line-2
      373       ,input  p-line-3
      374       ,output v-message
      375       ) .
      376     return v-message .
      377   end function .
      378   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      379   procedure fltfield-clear :
      380     define output parameter loc-fld as character no-undo.
      381     define output parameter loc-lab as character no-undo .
      382     define output parameter loc-spr as character no-undo .
      383     define output parameter loc-dim as character no-undo .
      384     assign
      385       loc-fld = ""
      386       loc-lab = ""
      387       loc-spr = ""
      388       loc-dim = "0"
      389     .
      390   end procedure .
      391   procedure fltfield-add :
      392     define input        parameter par-fld as character no-undo.
      393     define input        parameter par-lab as character no-undo .
      394     define input        parameter par-spr as character no-undo .
      395     define input-output parameter loc-fld as character no-undo.
      396     define input-output parameter loc-lab as character no-undo .
      397     define input-output parameter loc-spr as character no-undo .
      398     define input-output parameter loc-dim as character no-undo .
      399     do
      400     on error undo, return error
      401     :
      402       assign
      403       loc-fld = if loc-dim = '0'
      404                 then par-fld
      405                 else (loc-fld + chr(44) + par-fld)
      406       loc-lab = if loc-dim = '0'
      407                 then par-lab
      408                 else (loc-lab + chr(44) + par-lab)
      409       loc-spr = if loc-dim = '0'
      410                 then par-spr
      411                 else (loc-spr + chr(44) + par-spr)
      412       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      413                 string(integer(if num-entries(loc-dim) > 1
      414                               then entry(2, loc-dim)
      415                               else entry(1, loc-dim)
      416                               ) + 1)
      417       no-error
      418       .
      419     end.
      420   end procedure.
      421   FUNCTION Int2Char RETURNS CHARACTER ( INPUT i-num AS INTEGER ) :   DEFINE VARIABLE v-str AS CHARACTER NO-UNDO.   RUN conv-int-to-char IN THIS-PROCEDURE ( INPUT i-num, OUTPUT v-str ) NO-ERROR.   RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-str ). END FUNCTION.      PROCEDURE conv-int-to-char :   DEFINE  INPUT PARAMETER p-num AS INTEGER   NO-UNDO.   DEFINE OUTPUT PARAMETER p-str AS CHARACTER NO-UNDO.   DO ON ERROR UNDO, RETURN ERROR :     ASSIGN p-str = TRIM( STRING( p-num, "->>>>>>>>>>>>":U ) ).   END.  END PROCEDURE.
      422   FUNCTION Rec2Char RETURNS CHARACTER ( INPUT i-rec AS RECID ) :
      423     DEFINE VARIABLE v-str AS CHARACTER NO-UNDO.
      424     RUN conv-rec-to-char IN THIS-PROCEDURE ( INPUT i-rec, OUTPUT v-str ) NO-ERROR.
      425     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-str ).
      426   END FUNCTION.
      427   PROCEDURE conv-rec-to-char :
      428     DEFINE  INPUT PARAMETER p-rec AS RECID     NO-UNDO.
      429     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      430     DO ON ERROR UNDO, RETURN ERROR :
      431       ASSIGN p-res = TRIM( STRING( p-rec, "->>>>>>>>>>>9":U ) ).
      432     END.
      433   END PROCEDURE.
      434   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      435   define   temp-table temp-changes no-undo
      436   field f_name as character
      437   field l_name as character
      438   field v_old as character
      439   field v_new as character
      440   field t_name as character
      441   field num_ as integer
      442   field uniq-key-rec as character
      443   field action as integer
      444   field fNotChange as logical
      445   index pi is unique primary
      446   num_
      447   t_name
      448   f_name
      449   index
      450   Chan
      451   fnotChange
      452   t_name
      453   f_name
      454   index imain uniq-key-rec
      455   .
      456   FUNCTION get-all-fields returns character (p-file-name as character ):
      457   define variable v-dop as character no-undo .
      458     find first _file no-lock where _file._file-name = p-file-name no-error .
      459     if not available _file then return "":U.
      460     for each _field no-lock where
      461              _field._file-recid = recid(_file) :
      462       assign
      463       v-dop = v-dop + _field._field-name + chr(44)
      464       .
      465     end.
      466     return trim(v-dop).
      467   END FUNCTION.
      468   PROCEDURE proc-full-temp-changes :
      469     define input  parameter p-act-create as logical   no-undo .
      470     define input  parameter p-act-delete as logical   no-undo .
      471     define input  parameter p-hst-handle as handle    no-undo .
      472     define input  parameter p-main-table as character no-undo .
      473     define input  parameter p-field-list as character no-undo .
      474     define input  parameter p-label-form as character no-undo .
      475     define variable h-new-buf         as handle    no-undo .
      476     define variable h-main-buf        as handle    no-undo .
      477     define variable h-for-comp        as handle    no-undo .
      478     define variable v-inform          as character no-undo .
      479     define variable v-ind             as integer   no-undo .
      480     define variable v-idx-field-qnty  as integer   no-undo .
      481     define variable v-num-entries     as integer   no-undo .
      482     define variable fh                as handle    no-undo .
      483     define variable fh-main           as handle    no-undo .
      484     define variable fh-old            as handle    no-undo .
      485     define variable fh-new            as handle    no-undo .
      486     define variable v-field-name      as character no-undo .
      487     define variable v-field-lvl       as character no-undo .
      488     define variable v-field-form      as character no-undo .
      489     define variable v-search-exp      as character no-undo .
      490     define variable v-srch-main       as character no-undo .
      491     define variable v-word-link       as character no-undo .
      492     define variable v-av-chip-num     as logical   no-undo .
      493     define variable v-main-pi-fld-lst as character no-undo .
      494     define variable v-main-fld-lst    as character no-undo .
      495     define variable v-delim-list      as character no-undo .
      496     define variable v-label           as character no-undo .
      497     define variable v-old-value       as character no-undo case-sensitive.
      498     define variable v-new-value       as character no-undo case-sensitive.
      499     define variable v-chg-fields as character no-undo.
      500     for each temp-changes:
      501       delete temp-changes.
      502     end.
      503     if not p-hst-handle:available then do:
      504       return .
      505     end.
      506     create buffer h-new-buf  for table p-hst-handle .
      507     create buffer h-main-buf for table p-main-table .
      508     assign
      509       v-inform = h-main-buf:index-information(1)
      510       v-ind    = 2
      511     .
      512     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      513     on error undo, return error
      514     :
      515       assign
      516         v-inform = h-main-buf:index-information( v-ind )
      517         v-ind    = v-ind + 1
      518       .
      519     end.
      520     if v-inform = ?
      521       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      522       or entry( 3, v-inform, ",":U ) <> "1":U
      523     then do:
      524       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      525     end.
      526     assign
      527       v-idx-field-qnty = num-entries( v-inform ) - 4
      528     .
      529     if v-idx-field-qnty < 2 then do:
      530       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      531     end.
      532     assign
      533       v-srch-main   = "where":U
      534       v-word-link   = "":U
      535       v-av-chip-num = false
      536       v-delim-list  = "":U
      537     .
      538     do v-ind = 1 to v-idx-field-qnty by 2
      539     on error undo, return error
      540     :
      541       assign
      542         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      543         fh                = p-hst-handle:buffer-field( v-field-name )
      544         fh-main           = h-main-buf:buffer-field( v-field-name )
      545         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      546         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      547       .
      548       if fh:data-type ="character":U then do:
      549         assign
      550           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      551         .
      552       end.
      553       else do:
      554         assign
      555           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      556         .
      557       end.
      558       if v-delim-list = "":U then do:
      559         assign
      560           v-delim-list = ",":U
      561         .
      562       end.
      563       if v-word-link = "":U then do:
      564         assign
      565           v-word-link = "and":U
      566         .
      567       end.
      568     end.
      569     assign
      570       v-delim-list  = "":U
      571     .
      572     do v-ind = 1 to h-main-buf:num-fields
      573     on error undo, return error
      574     :
      575       assign
      576         fh-main      = h-main-buf:buffer-field( v-ind )
      577         v-field-name = fh-main:name
      578       .
      579         assign
      580           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      581         .
      582         if v-delim-list = "":U then do:
      583           assign
      584             v-delim-list = ",":U
      585           .
      586         end.
      587     end.
      588     assign
      589       v-inform = p-hst-handle:index-information(1)
      590       v-ind    = 2
      591     .
      592     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      593     on error undo, return error
      594     :
      595       assign
      596         v-inform = p-hst-handle:index-information( v-ind )
      597         v-ind    = v-ind + 1
      598       .
      599     end.
      600     if v-inform = ?
      601       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      602       or entry( 3, v-inform, ",":U ) <> "1":U
      603     then do:
      604       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      605     end.
      606     assign
      607       v-idx-field-qnty = num-entries( v-inform ) - 4
      608     .
      609     if v-idx-field-qnty < 2 then do:
      610       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      611     end.
      612     assign
      613       v-search-exp  = "where":U
      614       v-word-link   = "":U
      615       v-av-chip-num = false
      616     .
      617     do v-ind = 1 to v-idx-field-qnty by 2
      618     on error undo, return error
      619     :
      620       assign
      621         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      622         fh           = p-hst-handle:buffer-field( v-field-name )
      623         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      624       .
      625       if v-field-name = "chip-num":U then do:
      626         assign
      627           v-search-exp  = substitute( "&1 >", v-search-exp )
      628           v-av-chip-num = true
      629         .
      630       end.
      631       else do:
      632         assign
      633           v-search-exp = substitute( "&1 =", v-search-exp )
      634         .
      635       end.
      636       if fh:data-type ="character":U then do:
      637         assign
      638           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      639         .
      640       end.
      641       else do:
      642         assign
      643           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
      644         .
      645       end.
      646       if v-word-link = "":U then do:
      647         assign
      648           v-word-link = "and":U
      649         .
      650       end.
      651     end.
      652     if v-av-chip-num = false then do:
      653       message
      654         vss-workfile vss-revision vss-description skip
      655         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
      656         "Использование данной процедуры невозможно!" skip
      657         view-as alert-box error .
      658       return error .
      659     end.
      660     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
      661     if not h-new-buf:available then do:
      662       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
      663       if not h-main-buf:available then do:
      664         assign
      665           h-for-comp = ?
      666         .
      667       end.
      668       else do:
      669         assign
      670           h-for-comp = h-main-buf
      671         .
      672       end.
      673     end.
      674     else do:
      675       assign
      676         h-for-comp = h-new-buf
      677       .
      678     end.
      679     assign
      680       v-num-entries = num-entries( v-main-fld-lst, ",":U )
      681     .
      682     do v-ind = 1 to v-num-entries
      683     on error undo, return error return-value
      684     :
      685       assign
      686         v-field-name = entry( v-ind, v-main-fld-lst )
      687         fh-old       = p-hst-handle:buffer-field( v-field-name )
      688         v-old-value  = fh-old:buffer-value()
      689         v-label      = trim( fh-old:label )
      690       .
      691       if ( trim( p-field-list ) <> "":U
      692            and lookup( v-field-name, p-field-list ) > 0
      693          )
      694          or trim( p-field-list ) = "":U
      695       then do:
      696         if h-for-comp <> ? then do:
      697           assign
      698             fh-new      = h-for-comp:buffer-field( v-field-name )
      699             v-new-value = fh-new:buffer-value()
      700           .
      701         end.
      702         else do:
      703           assign
      704             v-new-value = "":U
      705           .
      706         end.
      707           if p-act-create = true then do:
      708             assign
      709               v-old-value = "":U
      710             .
      711           end.
      712           if p-act-delete = true then do:
      713             assign
      714               v-new-value = "":U
      715             .
      716           end.
      717         if v-old-value <> v-new-value
      718         then do:
      719           create temp-changes.
      720           assign
      721             temp-changes.t_name = p-main-table
      722             temp-changes.f_name = v-field-name
      723             temp-changes.l_name = replace( v-label, "&":U, "":U )
      724             temp-changes.v_old  = trim( v-old-value )
      725             temp-changes.v_new  = trim( v-new-value )
      726             temp-changes.num_   = 0
      727             temp-changes.fNotChange = v-old-value eq v-new-value
      728           .
      729         end.
      730       end.
      731     end.
      732     assign
      733       v-num-entries = num-entries( p-label-form, chr(8) )
      734     .
      735     do v-ind = 1 to v-num-entries
      736     on error undo, return error return-value
      737     :
      738       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
      739         assign
      740           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      741           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      742           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      743         .
      744         find first temp-changes
      745           where temp-changes.f_name = v-field-name
      746           no-error .
      747         if available temp-changes then do:
      748           if trim( v-field-lvl ) <> "":U then do:
      749             assign
      750               temp-changes.l_name = v-field-lvl
      751             .
      752           end.
      753           if trim( v-field-form ) <> "":U then do:
      754             assign
      755               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
      756             .
      757             if h-for-comp <> ? then do:
      758               assign
      759                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
      760               .
      761             end.
      762           end.
      763         end.
      764       end.
      765       else do:
      766         message
      767           vss-workfile vss-revision vss-description skip
      768           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
      769           substitute( "список для поля '&1': '&2'"
      770                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      771                       ,entry( v-ind, p-label-form, chr(8) )
      772                     ) skip
      773           substitute( "полный список: &2", p-label-form ) skip
      774           view-as alert-box error .
      775       end.
      776     end.
      777     delete object h-new-buf .
      778     delete object h-main-buf .
      779   END PROCEDURE.
      780   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      781   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      782   procedure fltopend_fltopend :
      783   define input parameter p-parent-handle as handle no-undo .
      784   define input parameter p-qh as handle no-undo .
      785   define input parameter p-flt-open-open-query  as character no-undo .
      786   define input parameter p-where-cond as character no-undo .
      787   define input parameter p-use-indFIRST-query-tail as character no-undo .
      788   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      789   define input parameter p-indexed-reposition as character no-undo .
      790     do
      791     on error undo, return error
      792     :
      793   define variable v-prepare-string as character no-undo .
      794   define variable glog as logical no-undo .
      795   assign
      796   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      797                      p-where-cond + chr(32)  +
      798                      p-use-indFIRST-query-tail + chr(32) +
      799                      p-use-ind-sort-clmn-by + chr(32) +
      800                      p-indexed-reposition
      801   .
      802   assign
      803   glog = p-qh:query-prepare(v-prepare-string) no-error .
      804   if not glog
      805   or error-status:error then do:
      806     message error-status:get-message(1) view-as alert-box .
      807     undo, return error .
      808   end.
      809   assign
      810   glog = p-qh:query-open no-error .
      811   if not glog
      812   or error-status:error then do:
      813     message error-status:get-message(1) view-as alert-box .
      814     undo, return error .
      815   end.
      816     end.
      817   end procedure.
      818   procedure fltopend_fltfindd :
      819   define input parameter p-parent-handle as handle no-undo .
      820   define input parameter p-qh as handle no-undo .
      821   define input parameter p-rowid as rowid no-undo .
      822   define input parameter p-next as logical no-undo .
      823   define input parameter p-lock as integer no-undo .
      824   define input parameter p-bh as handle no-undo .
      825   define input parameter p-where-cond as character no-undo .
      826   define input parameter p-use-index-phrase as character no-undo .
      827   define variable glog as logical no-undo .
      828   define variable v-qh as handle no-undo .
      829   define variable v-bh as handle no-undo .
      830   define variable v-recid as recid no-undo .
      831   define variable v-prepare-string as character no-undo .
      832   do
      833   on error undo, return error
      834   on stop undo, return error
      835   :
      836     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      837     create buffer v-bh for table p-bh buffer-name p-bh:name.
      838     create query v-qh.
      839     v-qh:set-buffers(v-bh).
      840     v-prepare-string = substitute("for each &1 &2 &3"
      841                                     ,v-bh:name
      842                                     ,p-where-cond
      843                                     ,p-use-index-phrase).
      844     glog = v-qh:query-prepare(v-prepare-string) no-error.
      845     if not glog then do:
      846       delete object v-qh.
      847       delete object v-bh.
      848       undo, return error .
      849     end.
      850     glog = v-qh:query-open no-error .
      851     if not glog then do:
      852       delete object v-qh.
      853       delete object v-bh.
      854       undo, return error .
      855     end.
      856     if p-next then do:
      857       v-qh:reposition-to-rowid(p-rowid) no-error .
      858       glog = v-qh:get-next( p-lock) no-error .
      859       glog = v-qh:get-next( p-lock) no-error .
      860       if not glog or v-qh:query-off-end = yes then do:
      861         glog = v-qh:get-first( p-lock) no-error .
      862       end.
      863     end.
      864     else do:
      865       glog = v-qh:get-first( p-lock) no-error .
      866     end.
      867     v-recid = v-bh:recid no-error .
      868     delete object v-qh.
      869     delete object v-bh.
      870     return string(v-recid) .
      871   end.
      872   end procedure.
      873   procedure fltopend_fltfindq :
      874   define input parameter p-parent-handle as handle no-undo .
      875   define input parameter p-qh as handle no-undo .
      876   define input parameter p-next as logical no-undo .
      877   define input parameter p-lock as integer no-undo .
      878   define input parameter p-flt-open-open-query  as character no-undo .
      879   define input parameter p-where-cond as character no-undo .
      880   define input parameter p-use-indFIRST-query-tail as character no-undo .
      881   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      882   define input parameter p-indexed-reposition as character no-undo .
      883   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      884   define variable glog as logical no-undo .
      885   define variable v-qh as handle no-undo .
      886   define variable v-bh as handle no-undo extent 18.
      887   define variable v-rowid as rowid no-undo extent 18.
      888   define variable v-ii as integer no-undo .
      889   define variable v-prepare-string as character no-undo .
      890   do
      891   on error undo, return error
      892   on stop undo, return error
      893   :
      894     create query v-qh.
      895     do v-ii = 1 to p-qh:num-buffers:
      896       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      897       assign
      898       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      899       no-error.
      900       v-qh:add-buffer(v-bh[v-ii]).
      901     end.
      902     assign
      903     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      904                       p-where-cond + chr(32)  +
      905                       p-use-indFIRST-query-tail + chr(32) +
      906                       p-use-ind-sort-clmn-by + chr(32) +
      907                       p-indexed-reposition
      908     .
      909     glog = v-qh:query-prepare( v-prepare-string) no-error .
      910     if not glog then do:
      911       delete object v-qh.
      912       do v-ii = 1 to p-qh:num-buffers:
      913         delete object v-bh[v-ii].
      914       end.
      915       undo, return error .
      916     end.
      917     glog = v-qh:query-open no-error .
      918     if not glog then do:
      919       delete object v-qh.
      920       do v-ii = 1 to p-qh:num-buffers:
      921         delete object v-bh[v-ii].
      922       end.
      923       undo, return error .
      924     end.
      925     if p-next then do:
      926       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      927       glog = v-qh:get-next( p-lock) no-error .
      928       glog = v-qh:get-next( p-lock) no-error .
      929       if not glog or v-qh:query-off-end = yes then do:
      930         glog = v-qh:get-first( p-lock) no-error .
      931       end.
      932     end.
      933     else do:
      934       glog = v-qh:get-first( p-lock) no-error .
      935     end.
      936     do v-ii = 1 to p-qh:num-buffers:
      937       assign
      938       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      939       no-error.
      940     end.
      941     delete object v-qh.
      942     do v-ii = 1 to p-qh:num-buffers:
      943       delete object v-bh[v-ii].
      944     end.
      945   end.
      946   end procedure.
      947   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      948   function usrfulnf returns character ( input p-user-id as character):
      949   define variable v-user-name as character no-undo .
      950   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      951   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      952     (input  p-user-id
      953     ,output v-user-name
      954     ) no-error .
      955   if error-status:error
      956   or v-user-name = ""
      957   then do:
      958     return p-user-id.
      959   end.
      960   else do:
      961     return v-user-name.
      962   end.
      963   end function.
      964   define buffer buf_changes  for temp-changes.
      965   define buffer buf_c-trn-reason-obj  for ub.c-trn-reason-obj.
      966   define buffer sch_c-trn-reason-obj for ub.c-trn-reason-obj.
      967   define variable filter-point     as character no-undo initial 'c-trn-reason-obj':U.
      968   define variable filter-point0    as character no-undo initial 'c-trn-reason-obj':U.
      969   define variable filter-label     as character no-undo initial 'История оснований (причин) создания документа по объекту':U.
      970   define variable filter-label0    as character no-undo initial 'История оснований (причин) создания документа по объекту':U.
      971   define variable sort-change-name as character no-undo.
      972   define variable sort-column-name as character no-undo.
      973   define variable sch-field        as character no-undo.
      974   define variable FoundRec         as recid     no-undo.
      975   define variable p-act-codes      as character no-undo initial '99,1,2,3,4,9,51,79':U.
      976   define variable p-act-names      as character no-undo initial 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U.
      977   define variable v-doc-rec          as recid     no-undo.
      978   function mark-string returns character ( buffer loc-buf for ub.c-trn-reason-obj ) :
      979     define variable v_mark-sign as character no-undo.
      980     run get-mark-string in this-procedure ( buffer loc-buf, output v_mark-sign ).
      981     return ( v_mark-sign ).
      982   end function.
      983   function ShowAction returns character ( input i-act as integer ) :
      984     define variable v_act as character no-undo.
      985     run get-action-name in this-procedure ( input i-act, output v_act ).
      986     return ( v_act ).
      987   end function.
      988   function obj-name returns character ( buffer loc-buf for ub.c-trn-reason-obj ) :
      989     define variable v_obj-name as character no-undo.
      990     run get-obj-name in this-procedure ( buffer loc-buf, input "name", output v_obj-name ).
      991     return ( v_obj-name ).
      992   end function.
      993   function obj-short returns character ( buffer loc-buf for ub.c-trn-reason-obj ) :
      994     define variable v_obj-name as character no-undo.
      995     run get-obj-name in this-procedure ( buffer loc-buf, input "code", output v_obj-name ).
      996     return ( v_obj-name ).
      997   end function.
      998   function ext-name returns character ( input i-code as character ) :
      999     define variable v_ext-name as character no-undo.
     1000     run get-ext-name in this-procedure ( input i-code, output v_ext-name ).
     1001     return ( v_ext-name ).
     1002   end function.
     1003   define button b-help   label "Помо&щь"   size-chars 10.00 by 1.00 default.
     1004   define button b-mark   label "&*"        size-chars  3.00 by 1.00 default.
     1005   define button   b-quit    label "Вы&ход"    size-chars 10.00 by 1.00 default auto-end-key.
     1006   define button b-sch label "&Фильтр"   size-chars 10.00 by 1.00 default.
     1007   define button b-sel label "Вы&бор"    size-chars 10.00 by 1.00 default auto-go.
     1008   define variable mark-num as integer   no-undo view-as fill-in size-chars  8.00 by 1.00 format "->>>,>>>":U.
     1009   define variable sch-rsn  as integer   no-undo view-as fill-in size-chars 15.50 by 1.00 format "->,>>>,>>>,>>>":U.
     1010   define variable sch-obj  as integer   no-undo view-as fill-in size-chars 10.50 by 1.00 format ">>>>>>>>>":U.
     1011   define variable sch-ext  as character no-undo view-as fill-in size-chars  9.50 by 1.00 format "x(8)":U.
     1012   define variable sch-num  as integer   no-undo view-as fill-in size-chars  4.50 by 1.00 format ">>>":U.
     1013   define query br-rsn-objs for buf_c-trn-reason-obj scrolling.
     1014   define query br-changes for buf_changes scrolling.
     1015   define browse br-rsn-objs query br-rsn-objs display
     1016     mark-string( buffer buf_c-trn-reason-obj )  column-label '*'  format 'x(1)':U
