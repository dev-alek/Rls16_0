     1350   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1351   procedure minbtn-set :
     1352       do
     1353           on error undo, return error return-value
     1354           :
     1355           define variable ii              as integer       no-undo .
     1356           define variable fh              as widget-handle no-undo .
     1357           define variable hh              as widget-handle no-undo .
     1358           define variable v-h             as handle        extent 4 no-undo .
     1359           define variable v-name-button   as character     no-undo .
     1360           define variable v-help-old-x    as decimal       no-undo .
     1361           define variable v-help-old-y    as decimal       no-undo .
     1362           define variable v-help-old-size as decimal       no-undo .
     1363           define variable v-frame-width   as decimal       no-undo .
     1364           define variable jj              as integer       no-undo .
     1365           do
     1366               on error undo, return error
     1367               :
     1368               assign
     1369                   v-frame-width = frame fr-D-rsn-obj-0:width - 0.3
     1370                   fh            = frame fr-D-rsn-obj-0:first-child
     1371                   hh            = fh:first-child
     1372                   ii            = 1
     1373                   .
     1374               do while valid-handle(hh):
     1375                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1376                   do:
     1377                       case lc(hh:name) :
     1378                           when "b-help" then
     1379                               do:
     1380                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1381                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1382                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1383                                   hh:TOOLTIP = "Помощь" .
     1384                                   v-help-old-x = hh:column .
     1385                                   v-help-old-y = hh:row    .
     1386                                   v-help-old-size = hh:width .
     1387                                   hh:width-chars = 2.5 .
     1388                               end.
     1389                           when "b-print" then
     1390                               do:
     1391                                   hh:load-image("cmp/b-print.bmp":u) .
     1392                                   hh:TOOLTIP = "Печать" .
     1393                                   v-h[ii] = hh:handle .
     1394                                   ii = ii + 1 .
     1395                                   hh:width-chars = 3 .
     1396                               end.
     1397                           when "b-history" or
     1398                           when "b-hist" then
     1399                               do:
     1400                                   hh:load-image("cmp/b-hist.bmp":u) .
     1401                                   hh:TOOLTIP = "История" .
     1402                                   v-h[ii] = hh:handle .
     1403                                   ii = ii + 1 .
     1404                                   hh:width-chars = 3 .
     1405                               end.
     1406                           when "b-sch" then
     1407                               do:
     1408                                   hh:load-image("cmp/b-sch.bmp":u) .
     1409                                   hh:TOOLTIP = "Установка Фильтра" .
     1410                                   v-h[ii] = hh:handle .
     1411                                   ii = ii + 1 .
     1412                                   hh:width-chars = 3 .
     1413                               end.
     1414                           when "b-hist-user" then
     1415                               do:
     1416                                   hh:load-image("cmp/b-hist.bmp":u) .
     1417                                   hh:TOOLTIP = "История пользователя" .
     1418                                   ii = ii + 1 .
     1419                               end.
     1420                       end case.
     1421                   end.
     1422                   hh = hh:next-sibling.
     1423               end.
     1424               b-help:column = v-frame-width - b-help:width-chars.
     1425               jj = 0.
     1426               repeat ii = 4 to 1 by -1 :
     1427                   if valid-handle (v-h[ii] ) then
     1428                   do:
     1429                       jj  = jj + 1 .
     1430                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1431                       v-h[ii]:row    = v-help-old-y .
     1432                   end.
     1433               end.
     1434           end.
     1435       end.
     1436   end procedure.
     1437   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1438   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1439   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1440   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1441   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1442   define variable v-diasize-current-frame-height as decimal   no-undo .
     1443   define variable v-diasize-change-size          as logical   no-undo .
     1444   define variable v-diasize-resize-button        as handle    no-undo .
     1445   define variable v-diasize-wndmax               as logical   no-undo .
     1446   define variable v-diasize-wndstore             as logical   no-undo .
     1447   define variable v-diasize-proc-name            as character no-undo .
     1448   define variable v-diasize-browse-handle        as handle    no-undo .
     1449   define variable v-diasize-browse-number        as integer   no-undo .
     1450   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1451   define temp-table temp-diasize-handle no-undo
     1452     field handle-value  as handle
     1453     field save-position as decimal
     1454     index xpk is primary unique handle-value
     1455     .
     1456   define temp-table temp-browse-handle no-undo
     1457     field browse-type   as character
     1458     field browse-number as integer
     1459     field browse-handle as handle
     1460     field original-size as decimal
     1461     index xpk is primary unique browse-type browse-number
     1462     index xie browse-type browse-handle
     1463   .
     1464   procedure diasize_change-height :
     1465     define input  parameter p-change-value  as decimal   no-undo .
     1466     define input  parameter p-move-resize   as logical   no-undo .
     1467     define variable v-field-group-handle    as handle    no-undo .
     1468     define variable v-object-handle         as handle    no-undo .
     1469     define variable v-frame-height          as decimal   no-undo .
     1470     define variable v-frame-virtual-height  as decimal   no-undo .
     1471     define variable v-browse-height         as decimal   no-undo .
     1472     define variable v-window-height         as decimal   no-undo .
     1473     define variable v-window-virtual-height as decimal   no-undo .
     1474     define variable v-change-sign           as integer   no-undo .
     1475     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1476     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1477     if p-change-value > 0
     1478     then do:
     1479       if frame fr-D-rsn-obj-0 :height + p-change-value
     1480           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1481       then do:
     1482         assign
     1483           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1484                           - (frame fr-D-rsn-obj-0 :height-chars)
     1485         .
     1486         if p-change-value <= 0
     1487         then do:
     1488           run diasize_position-resize-button in this-procedure .
     1489           return .
     1490         end.
     1491       end.
     1492     end.
     1493     if p-change-value < 0
     1494     then do:
     1495       if frame fr-D-rsn-obj-0 :height + p-change-value < v-diasize-orig-frame-height
     1496       then do:
     1497         assign
     1498           p-change-value = v-diasize-orig-frame-height
     1499                          - (frame fr-D-rsn-obj-0 :height-chars)
     1500         .
     1501         if p-change-value >= 0
     1502         then do:
     1503           run diasize_position-resize-button in this-procedure .
     1504           return .
     1505         end.
     1506       end.
     1507     end.
     1508     if p-change-value >= 0
     1509     then do:
     1510       assign
     1511         v-change-sign = 1
     1512       .
     1513     end.
     1514     else do:
     1515       assign
     1516         v-change-sign = -1
     1517       .
     1518     end.
     1519     assign
     1520       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1521     .
     1522     if p-change-value = 0
     1523     then do:
     1524       run diasize_position-resize-button in this-procedure .
     1525       return .
     1526     end.
     1527     move_block:
     1528     do
     1529     on error undo move_block, retry move_block
     1530     :
     1531       if retry
     1532       then do:
     1533         do
     1534         on error undo move_block, leave move_block
     1535         :
     1536           if p-change-value > 0
     1537           then do:
     1538             for each buf_temp-diasize-handle
     1539             on error undo, next
     1540             :
     1541               assign
     1542                 v-object-handle = buf_temp-diasize-handle.handle-value
     1543               .
     1544               if v-object-handle <> v-diasize-resize-button
     1545               then do:
     1546                 assign
     1547                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1548                 .
     1549               end.
     1550             end.
     1551             assign
     1552               v-diasize-browse-handle :height = v-browse-height
     1553             .
     1554             for each buf_temp-browse-handle
     1555               where buf_temp-browse-handle.browse-type = 'height':u
     1556             on error undo, next
     1557             :
     1558               assign
     1559                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1560               .
     1561             end.
     1562             assign
     1563               frame fr-D-rsn-obj-0 :height = v-frame-height
     1564             .
     1565             if frame fr-D-rsn-obj-0 :scrollable = true
     1566             then do:
     1567               assign
     1568                 frame fr-D-rsn-obj-0 :virtual-height = v-frame-virtual-height
     1569               .
     1570             end.
     1571             run diasize_position-resize-button in this-procedure .
     1572           end.
     1573           else do:
     1574             if frame fr-D-rsn-obj-0 :scrollable = true
     1575             then do:
     1576               assign
     1577                 frame fr-D-rsn-obj-0 :virtual-height = v-frame-virtual-height
     1578               .
     1579             end.
     1580             assign
     1581               frame fr-D-rsn-obj-0 :height = v-frame-height
     1582             .
     1583             assign
     1584               v-diasize-browse-handle :height = v-browse-height
     1585             .
     1586             for each buf_temp-browse-handle
     1587               where buf_temp-browse-handle.browse-type = 'height':u
     1588             on error undo, next
     1589             :
     1590               assign
     1591                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1592               .
     1593             end.
     1594             for each buf_temp-diasize-handle
     1595             on error undo, next
     1596             :
     1597               assign
     1598                 v-object-handle = buf_temp-diasize-handle.handle-value
     1599               .
     1600               if v-object-handle <> v-diasize-resize-button
     1601               then do:
     1602                 assign
     1603                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1604                 .
     1605               end.
     1606             end.
     1607             run diasize_position-resize-button in this-procedure .
     1608           end.
     1609           assign
     1610             v-diasize-change-size = false
     1611           .
     1612           leave move_block .
     1613         end.
     1614       end.
     1615       assign
     1616         v-diasize-need-full-display = true
     1617       .
     1618       if v-diasize-change-size = false
     1619       then do:
     1620         assign
     1621           v-diasize-change-size = true
     1622         .
     1623       end.
     1624       else do:
     1625         return .
     1626       end.
     1627       assign
     1628         v-frame-height = frame fr-D-rsn-obj-0 :height
     1629         v-frame-virtual-height = frame fr-D-rsn-obj-0 :virtual-height
     1630         v-browse-height = v-diasize-browse-handle :height
     1631       .
     1632       for each buf_temp-browse-handle
     1633         where buf_temp-browse-handle.browse-type = 'height':u
     1634       :
     1635         assign
     1636           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1637         .
     1638       end.
     1639       for each buf_temp-diasize-handle
     1640       :
     1641         delete buf_temp-diasize-handle .
     1642       end.
     1643       assign
     1644         v-field-group-handle = frame fr-D-rsn-obj-0 :first-child
     1645       .
     1646       do while valid-handle(v-field-group-handle)
     1647       :
     1648         assign
     1649           v-object-handle = v-field-group-handle :first-child
     1650         .
     1651         do while valid-handle(v-object-handle)
     1652         :
     1653           if  v-object-handle <> v-diasize-browse-handle :handle
     1654           and can-query(v-object-handle, "row")
     1655           and can-query(v-object-handle, "height")
     1656           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1657           then do:
     1658             find first buf_temp-browse-handle
     1659               where buf_temp-browse-handle.browse-type   = 'height':u
     1660                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1661               no-error .
     1662             if available buf_temp-browse-handle
     1663             then do:
     1664             end.
     1665             else do:
     1666               create buf_temp-diasize-handle .
     1667               assign
     1668                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1669                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1670               .
     1671             end.
     1672           end.
     1673           assign
     1674             v-object-handle = v-object-handle :next-sibling
     1675           .
     1676         end.
     1677         assign
     1678           v-field-group-handle = v-field-group-handle :next-sibling
     1679         .
     1680       end.
     1681       do with frame fr-D-rsn-obj-0
     1682       :
     1683         hide v-diasize-resize-button .
     1684         assign
     1685           v-diasize-resize-button :row    = 1
     1686           v-diasize-resize-button :column = 1
     1687         .
     1688       end.
     1689       if p-change-value > 0
     1690       then do:
     1691         if frame fr-D-rsn-obj-0 :scrollable = true
     1692         then do:
     1693           assign
     1694             frame fr-D-rsn-obj-0 :virtual-height = frame fr-D-rsn-obj-0 :virtual-height + p-change-value
     1695             no-error .
     1696           if error-status :error
     1697           or error-status :get-message(1) <> ""
     1698           then do:
     1699             undo move_block, retry move_block .
     1700           end.
     1701         end.
     1702         assign
     1703           frame fr-D-rsn-obj-0 :height = frame fr-D-rsn-obj-0 :height + p-change-value
     1704           no-error .
     1705         if error-status :error
     1706         or error-status :get-message(1) <> ""
     1707         then do:
     1708           undo move_block, retry move_block .
     1709         end.
     1710         assign
     1711           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1712           no-error .
     1713         if error-status :error
     1714         or error-status :get-message(1) <> ""
     1715         then do:
     1716           undo move_block, retry move_block .
     1717         end.
     1718         for each buf_temp-browse-handle
     1719           where buf_temp-browse-handle.browse-type = 'height':u
     1720         on error undo move_block, retry move_block
     1721         :
     1722           assign
     1723             buf_temp-browse-handle.browse-handle :height
     1724               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1725             no-error .
     1726           if error-status :error
     1727           or error-status :get-message(1) <> ""
     1728           then do:
     1729             undo move_block, retry move_block .
     1730           end.
     1731         end.
     1732         for each buf_temp-diasize-handle
     1733         on error undo move_block, retry move_block
     1734         :
     1735           assign
     1736             v-object-handle = buf_temp-diasize-handle.handle-value
     1737           .
     1738           if v-object-handle <> v-diasize-resize-button
     1739           then do:
     1740             assign
     1741               v-object-handle :row = v-object-handle :row + p-change-value
     1742               no-error .
     1743             if error-status :error
     1744             or error-status :get-message(1) <> ""
     1745             then do:
     1746               undo move_block, retry move_block .
     1747             end.
     1748           end.
     1749         end.
     1750       end.
     1751       else do:
     1752         for each buf_temp-diasize-handle
     1753         on error undo move_block, retry move_block
     1754         :
     1755           assign
     1756             v-object-handle = buf_temp-diasize-handle.handle-value
     1757           .
     1758           if v-object-handle <> v-diasize-resize-button
     1759           then do:
     1760             assign
     1761               v-object-handle :row = v-object-handle :row + p-change-value
     1762               no-error .
     1763             if error-status :error
     1764             or error-status :get-message(1) <> ""
     1765             then do:
     1766               undo move_block, retry move_block .
     1767             end.
     1768           end.
     1769         end.
     1770         assign
     1771           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1772           no-error .
     1773         if error-status :error
     1774         or error-status :get-message(1) <> ""
     1775         then do:
     1776           undo move_block, retry move_block .
     1777         end.
     1778         for each buf_temp-browse-handle
     1779           where buf_temp-browse-handle.browse-type = 'height':u
     1780         on error undo move_block, retry move_block
     1781         :
     1782           assign
     1783             buf_temp-browse-handle.browse-handle :height
     1784               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1785             no-error .
     1786           if error-status :error
     1787           or error-status :get-message(1) <> ""
     1788           then do:
     1789             undo move_block, retry move_block .
     1790           end.
     1791         end.
     1792         assign
     1793           frame fr-D-rsn-obj-0 :height = frame fr-D-rsn-obj-0 :height + p-change-value
     1794           no-error .
     1795         if error-status :error
     1796         or error-status :get-message(1) <> ""
     1797         then do:
     1798           undo move_block, retry move_block .
     1799         end.
     1800         if frame fr-D-rsn-obj-0 :scrollable = true
     1801         then do:
     1802           assign
     1803             frame fr-D-rsn-obj-0 :virtual-height = frame fr-D-rsn-obj-0 :virtual-height + p-change-value
     1804             no-error .
     1805           if error-status :error
     1806           or error-status :get-message(1) <> ""
     1807           then do:
     1808             undo move_block, retry move_block .
     1809           end.
     1810         end.
     1811       end.
     1812       if p-move-resize = true
     1813       then do:
     1814         run diasize_position-resize-button in this-procedure .
     1815       end.
     1816       if v-diasize-wndstore = true
     1817       then do:
     1818         if connected("ub") = true
     1819         then do:
     1820           define variable v-cntxt-db-num        as integer   no-undo .
     1821           define variable v-cntxt-userid        as character no-undo .
     1822           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1823                                             , OUTPUT v-cntxt-userid
     1824                                             ) .
     1825           run gbl/wndsizew.p
     1826             (input  v-cntxt-db-num
     1827             ,input  v-cntxt-userid
     1828             ,input  v-diasize-proc-name
     1829             ,input  'height':u
     1830             ,input  string(frame fr-D-rsn-obj-0 :height - v-diasize-orig-frame-height)
     1831             ) .
     1832         end.
     1833       end.
     1834     end.
     1835     assign
     1836       v-diasize-change-size = false
     1837     .
     1838   end procedure.
     1839   procedure diasize_set-height :
     1840     define input  parameter p-new-height  as decimal   no-undo .
     1841     define input  parameter p-move-resize as logical   no-undo .
     1842     do
     1843     on error undo, return error return-value
     1844     :
     1845       run diasize_change-height in this-procedure
     1846         (input  (p-new-height - frame fr-D-rsn-obj-0 :height)
     1847         ,input  p-move-resize
     1848         ) .
     1849     end.
     1850   end procedure.
     1851   procedure diasize_change-width :
     1852     define input  parameter p-change-value as decimal   no-undo .
     1853     define input  parameter p-move-resize  as logical   no-undo .
     1854     define variable v-field-group-handle   as handle    no-undo .
     1855     define variable v-object-handle        as handle    no-undo .
     1856     define variable v-frame-width          as decimal   no-undo .
     1857     define variable v-frame-virtual-width  as decimal   no-undo .
     1858     define variable v-browse-width         as decimal   no-undo .
     1859     define variable v-window-width         as decimal   no-undo .
     1860     define variable v-window-virtual-width as decimal   no-undo .
     1861     define variable v-change-sign          as integer   no-undo .
     1862     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1863     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1864     if p-change-value > 0
     1865     then do:
     1866       if frame fr-D-rsn-obj-0 :width + p-change-value >
     1867           session :width-chars
     1868       then do:
     1869         assign
     1870           p-change-value = session :width-chars - frame fr-D-rsn-obj-0 :width
     1871         .
     1872         if p-change-value <= 0
     1873         then do:
     1874           run diasize_position-resize-button in this-procedure .
     1875           return .
     1876         end.
     1877       end.
     1878     end.
     1879     if p-change-value < 0
     1880     then do:
     1881       if frame fr-D-rsn-obj-0 :width + p-change-value < v-diasize-orig-frame-width
     1882       then do:
     1883         assign
     1884           p-change-value = v-diasize-orig-frame-width
     1885                          - frame fr-D-rsn-obj-0 :width
     1886         .
     1887         if p-change-value >= 0
     1888         then do:
     1889           run diasize_position-resize-button in this-procedure .
     1890           return .
     1891         end.
     1892       end.
     1893     end.
     1894     if p-change-value >= 0
     1895     then do:
     1896       assign
     1897         v-change-sign = 1
     1898       .
     1899     end.
     1900     else do:
     1901       assign
     1902         v-change-sign = -1
     1903       .
     1904     end.
     1905     assign
     1906       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1907     .
     1908     if p-change-value = 0
     1909     then do:
     1910       run diasize_position-resize-button in this-procedure .
     1911       return .
     1912     end.
     1913     move_block:
     1914     do
     1915     on error undo move_block, leave move_block
     1916     :
     1917       if retry
     1918       then do:
     1919         do
     1920         on error undo move_block, leave move_block
     1921         :
     1922           if p-change-value > 0
     1923           then do:
     1924             for each buf_temp-diasize-handle
     1925             on error undo, next
     1926             :
     1927               assign
     1928                 v-object-handle = buf_temp-diasize-handle.handle-value
     1929               .
     1930               if v-object-handle <> v-diasize-resize-button
     1931               then do:
     1932                 assign
     1933                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1934                 .
     1935               end.
     1936             end.
     1937             assign
     1938               v-diasize-browse-handle :width = v-browse-width
     1939             .
     1940             for each buf_temp-browse-handle
     1941               where buf_temp-browse-handle.browse-type = 'width':u
     1942             on error undo, next
     1943             :
     1944               assign
     1945                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1946               .
     1947             end.
     1948             assign
     1949               frame fr-D-rsn-obj-0 :width = v-frame-width
     1950             .
     1951             if frame fr-D-rsn-obj-0 :scrollable = true
     1952             then do:
     1953               assign
     1954                 frame fr-D-rsn-obj-0 :virtual-width = v-frame-virtual-width
     1955               .
     1956             end.
     1957             run diasize_position-resize-button in this-procedure .
     1958           end.
     1959           else do:
     1960             if frame fr-D-rsn-obj-0 :scrollable = true
     1961             then do:
     1962               assign
     1963                 frame fr-D-rsn-obj-0 :virtual-width = v-frame-virtual-width
     1964               .
     1965             end.
     1966             assign
     1967               frame fr-D-rsn-obj-0 :width = v-frame-width
     1968             .
     1969             for each buf_temp-browse-handle
     1970               where buf_temp-browse-handle.browse-type = 'width':u
     1971             on error undo, next
     1972             :
     1973               assign
     1974                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1975               .
     1976             end.
     1977             assign
     1978               v-diasize-browse-handle :width = v-browse-width
     1979             .
     1980             for each buf_temp-diasize-handle
     1981             on error undo, next
     1982             :
     1983               assign
     1984                 v-object-handle = buf_temp-diasize-handle.handle-value
     1985               .
     1986               if v-object-handle <> v-diasize-resize-button
     1987               then do:
     1988                 assign
     1989                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1990                 .
     1991               end.
     1992             end.
     1993             run diasize_position-resize-button in this-procedure .
     1994           end.
     1995           assign
     1996             v-diasize-change-size = false
     1997           .
     1998           leave move_block .
     1999         end.
     2000       end.
     2001       assign
     2002         v-diasize-need-full-display = true
     2003       .
     2004       if v-diasize-change-size = false
     2005       then do:
     2006         assign
     2007           v-diasize-change-size = true
     2008         .
     2009       end.
     2010       else do:
     2011         return .
     2012       end.
     2013       assign
     2014         v-frame-width = frame fr-D-rsn-obj-0 :width
     2015         v-frame-virtual-width = frame fr-D-rsn-obj-0 :virtual-width
     2016         v-browse-width = v-diasize-browse-handle :width
     2017       .
     2018       for each buf_temp-browse-handle
     2019         where buf_temp-browse-handle.browse-type = 'width':u
     2020       :
     2021         assign
     2022           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2023         .
     2024       end.
     2025       for each buf_temp-diasize-handle
     2026       :
     2027         delete buf_temp-diasize-handle .
     2028       end.
     2029       assign
     2030         v-field-group-handle = frame fr-D-rsn-obj-0 :first-child
     2031       .
     2032       do while valid-handle(v-field-group-handle)
     2033       :
     2034         assign
     2035           v-object-handle = v-field-group-handle :first-child
     2036         .
     2037         do while valid-handle(v-object-handle)
     2038         :
     2039           if  v-object-handle <> v-diasize-browse-handle :handle
     2040           and v-object-handle <> v-diasize-resize-button
     2041           and can-query(v-object-handle, "row")
     2042           and can-query(v-object-handle, "height")
     2043           and ( v-object-handle :col + v-object-handle :width
     2044                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2045               )
     2046           then do:
     2047             find first buf_temp-browse-handle
     2048               where buf_temp-browse-handle.browse-type   = 'width':u
     2049                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2050               no-error .
     2051             if available buf_temp-browse-handle
     2052             then do:
     2053             end.
     2054             else do:
     2055               create buf_temp-diasize-handle .
     2056               assign
     2057                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2058                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2059               .
     2060             end.
     2061           end.
     2062           assign
     2063             v-object-handle = v-object-handle :next-sibling
     2064           .
     2065         end.
     2066         assign
     2067           v-field-group-handle = v-field-group-handle :next-sibling
     2068         .
     2069       end.
     2070       do with frame fr-D-rsn-obj-0
     2071       :
     2072         hide v-diasize-resize-button .
     2073         v-diasize-resize-button :row = 1.
     2074         v-diasize-resize-button :column = 1.
     2075       end.
     2076       if p-change-value > 0
     2077       then do:
     2078         if frame fr-D-rsn-obj-0 :scrollable = true
     2079         then do:
     2080           assign
     2081             frame fr-D-rsn-obj-0 :virtual-width = frame fr-D-rsn-obj-0 :virtual-width + p-change-value
     2082             no-error .
     2083           if error-status :error
     2084           or error-status :get-message(1) <> ""
     2085           then do:
     2086             undo move_block, retry move_block.
     2087           end.
     2088         end.
     2089         assign
     2090           frame fr-D-rsn-obj-0 :width = v-frame-width + p-change-value
     2091           no-error .
     2092         if error-status :error
     2093         or error-status :get-message(1) <> ""
     2094         then do:
     2095           undo move_block, retry move_block.
     2096         end.
     2097         assign
     2098           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2099         no-error .
     2100         if error-status :error
     2101         or error-status :get-message(1) <> ""
     2102         then do:
     2103           undo move_block, retry move_block.
     2104         end.
     2105         for each buf_temp-browse-handle
     2106           where buf_temp-browse-handle.browse-type = 'width':u
     2107         on error undo move_block, retry move_block
     2108         :
     2109           assign
     2110             buf_temp-browse-handle.browse-handle :width
     2111               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2112             no-error .
     2113           if error-status :error
     2114           or error-status :get-message(1) <> ""
     2115           then do:
     2116             undo move_block, retry move_block .
     2117           end.
     2118         end.
     2119         for each buf_temp-diasize-handle
     2120         on error undo move_block, retry move_block
     2121         :
     2122           assign
     2123             v-object-handle = buf_temp-diasize-handle.handle-value
     2124           .
     2125           if v-object-handle <> v-diasize-resize-button
     2126           then do:
     2127             assign
     2128               v-object-handle :col = v-object-handle :col + p-change-value
     2129               no-error .
     2130             if error-status :error
     2131             or error-status :get-message(1) <> ""
     2132             then do:
     2133               undo move_block, retry move_block .
     2134             end.
     2135           end.
     2136         end.
     2137       end.
     2138       else do:
     2139         for each buf_temp-diasize-handle
     2140         on error undo move_block, retry move_block
     2141         :
     2142           assign
     2143             v-object-handle = buf_temp-diasize-handle.handle-value
     2144           .
     2145           if v-object-handle <> v-diasize-resize-button
     2146           then do:
     2147             assign
     2148               v-object-handle :col = v-object-handle :col + p-change-value
     2149               no-error .
     2150             if error-status :error
     2151             or error-status :get-message(1) <> ""
     2152             then do:
     2153               undo move_block, retry move_block .
     2154             end.
     2155           end.
     2156         end.
     2157         for each buf_temp-browse-handle
     2158           where buf_temp-browse-handle.browse-type = 'width':u
     2159         on error undo move_block, retry move_block
     2160         :
     2161           assign
     2162             buf_temp-browse-handle.browse-handle :width
     2163               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2164             no-error .
     2165           if error-status :error
     2166           or error-status :get-message(1) <> ""
     2167           then do:
     2168             undo move_block, retry move_block .
     2169           end.
     2170         end.
     2171         assign
     2172           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2173           no-error .
     2174         if error-status :error
     2175         or error-status :get-message(1) <> ""
     2176         then do:
     2177           undo move_block, retry move_block.
     2178         end.
     2179         assign
     2180           frame fr-D-rsn-obj-0 :width = frame fr-D-rsn-obj-0 :width + p-change-value
     2181         no-error .
     2182         if error-status :error
     2183         or error-status :get-message(1) <> ""
     2184         then do:
     2185           undo move_block, retry move_block.
     2186         end.
     2187         if frame fr-D-rsn-obj-0 :scrollable = true
     2188         then do:
     2189           assign
     2190             frame fr-D-rsn-obj-0 :virtual-width = frame fr-D-rsn-obj-0 :virtual-width + p-change-value
     2191           no-error .
     2192           if error-status :error
     2193           or error-status :get-message(1) <> ""
     2194           then do:
     2195             undo move_block, retry move_block.
     2196           end.
     2197         end.
     2198       end.
     2199       if p-move-resize
     2200       then do:
     2201         run diasize_position-resize-button in this-procedure .
     2202       end.
     2203       if v-diasize-wndstore = true
     2204       then do:
     2205         if connected("ub") = true
     2206         then do:
     2207           define variable v-cntxt-db-num        as integer   no-undo .
     2208           define variable v-cntxt-userid        as character no-undo .
     2209           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2210                                             , OUTPUT v-cntxt-userid
     2211                                             ) .
     2212           run gbl/wndsizew.p
     2213             (input  v-cntxt-db-num
     2214             ,input  v-cntxt-userid
     2215             ,input  v-diasize-proc-name
     2216             ,input  'width':u
     2217             ,input  string(frame fr-D-rsn-obj-0 :width - v-diasize-orig-frame-width)
     2218             ) .
     2219         end.
     2220       end.
     2221     end.
     2222     assign
     2223       v-diasize-change-size = false
     2224     .
     2225   end procedure.
     2226   procedure diasize_set-width :
     2227     define input  parameter p-new-width  as decimal   no-undo .
     2228     define input  parameter p-move-resize as logical   no-undo .
     2229     do
     2230     on error undo, return error return-value
     2231     :
     2232       run diasize_change-width in this-procedure
     2233         (input  (p-new-width - frame fr-D-rsn-obj-0 :width)
     2234         ,input  p-move-resize
     2235         ) .
     2236     end.
     2237   end procedure.
     2238   procedure diasize_position-resize-button :
     2239     do with frame fr-D-rsn-obj-0
     2240     :
     2241       hide v-diasize-resize-button .
     2242       assign
     2243         v-diasize-resize-button :row = frame fr-D-rsn-obj-0 :height - v-diasize-resize-button :height
     2244                     - 1
     2245                     - (frame fr-D-rsn-obj-0 :border-bottom-pixels / session :pixels-per-row)
     2246         v-diasize-resize-button :col = frame fr-D-rsn-obj-0 :width - v-diasize-resize-button :width
     2247                     - 1
     2248                     - (frame fr-D-rsn-obj-0 :border-right-pixels / session :pixels-per-column)
     2249       .
     2250       view v-diasize-resize-button .
     2251     end.
     2252   end procedure.
     2253   on alt-right anywhere
     2254   do:
     2255     run diasize_change-width in this-procedure
     2256       (input 1
     2257       ,input true
     2258       ) .
     2259     return no-apply .
     2260   end.
     2261   on alt-left anywhere
     2262   do:
     2263     run diasize_change-width in this-procedure
     2264       (input -1
     2265       ,input true
     2266       ) .
     2267     return no-apply .
     2268   end.
     2269   on alt-down anywhere
     2270   do:
     2271     run diasize_change-height in this-procedure
     2272       (input 1
     2273       ,input true
     2274       ) .
     2275     return no-apply .
     2276   end.
     2277   on alt-up anywhere
     2278   do:
     2279     run diasize_change-height in this-procedure
     2280       (input -1
     2281       ,input true
     2282       ) .
     2283     return no-apply .
     2284   end.
     2285   on alt-enter of frame fr-D-rsn-obj-0
     2286   do:
     2287     run diasize_maximize in this-procedure
     2288       (input  ?
     2289       ).
     2290     return no-apply .
     2291   end.
     2292   procedure diasize_end-move :
     2293     do
     2294     on error undo, return error return-value
     2295     :
     2296       define variable v-row-delta as decimal   no-undo .
     2297       define variable v-col-delta as decimal   no-undo .
     2298       define variable v-new-row as decimal   no-undo .
     2299       define variable v-new-col as decimal   no-undo .
     2300       assign
     2301         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2302         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2303       .
     2304       assign
     2305         v-row-delta = v-new-row - frame fr-D-rsn-obj-0 :height
     2306         v-col-delta = v-new-col - frame fr-D-rsn-obj-0 :width
     2307       .
     2308       run diasize_change-height in this-procedure
     2309         (input v-row-delta
     2310         ,input true
     2311         ) .
     2312       run diasize_change-width in this-procedure
     2313         (input v-col-delta
     2314         ,input true
     2315         ) .
     2316     end.
     2317   end procedure.
     2318   procedure diasize_maximize :
     2319     define input  parameter p-action as logical   no-undo .
     2320     do
     2321     on error undo, return error return-value
     2322     :
     2323       if p-action = ?
     2324       then do:
     2325         if v-diasize-need-maximize = true
     2326         then do:
     2327           assign
     2328             p-action = true
     2329           .
     2330         end.
     2331         else do:
     2332           assign
     2333             p-action = false
     2334           .
     2335         end.
     2336       end.
     2337       if p-action = true
     2338       then do:
     2339         run diasize_change-height in this-procedure
     2340           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2341               - frame fr-D-rsn-obj-0 :height-chars
     2342           ,input true
     2343           ) .
     2344         run diasize_change-width in this-procedure
     2345           (input session :width-chars
     2346               - frame fr-D-rsn-obj-0 :width-chars
     2347           ,input true
     2348           ) .
     2349         assign
     2350           v-diasize-need-maximize = false
     2351         .
     2352       end.
     2353       else do:
     2354         run diasize_change-width in this-procedure
     2355           (input v-diasize-orig-frame-width
     2356               - frame fr-D-rsn-obj-0 :width-chars
     2357           ,input true
     2358           ) .
     2359         run diasize_change-height in this-procedure
     2360           (input v-diasize-orig-frame-height
     2361               - frame fr-D-rsn-obj-0 :height-chars
     2362           ,input true
     2363           ) .
     2364         assign
     2365           v-diasize-need-maximize = true
     2366         .
     2367       end.
     2368     end.
     2369   end procedure.
     2370   procedure diasize_restore-orig-size :
     2371     do
     2372     on error undo, return error return-value
     2373     :
     2374       assign
     2375         v-diasize-current-frame-width  = frame fr-D-rsn-obj-0 :width
     2376         v-diasize-current-frame-height = frame fr-D-rsn-obj-0 :height
     2377       .
     2378       run diasize_set-height in this-procedure
     2379         (input  v-diasize-orig-frame-height
     2380         ,input  true
     2381         ) .
     2382       run diasize_set-width in this-procedure
     2383         (input  v-diasize-orig-frame-width
     2384         ,input  true
     2385         ) .
     2386     end.
     2387   end procedure.
     2388   procedure diasize_restore-current-size :
     2389     do
     2390     on error undo, return error return-value
     2391     :
     2392       run diasize_set-height in this-procedure
     2393         (input  v-diasize-current-frame-height
     2394         ,input  true
     2395         ) .
     2396       run diasize_set-width in this-procedure
     2397         (input  v-diasize-current-frame-width
     2398         ,input  true
     2399         ) .
     2400     end.
     2401   end procedure.
     2402   procedure diasize_set-browse-handle :
     2403     define input  parameter p-browse-handle as handle   no-undo .
     2404     define buffer buf_temp-browse-handle for temp-browse-handle .
     2405     do
     2406     on error undo, return error return-value
     2407     :
     2408       assign
     2409         v-diasize-browse-handle = p-browse-handle
     2410       .
     2411       for each buf_temp-browse-handle
     2412       on error undo, return error return-value
     2413       :
     2414         delete buf_temp-browse-handle .
     2415       end.
     2416     end.
     2417   end procedure.
     2418   procedure diasize_add_browse :
     2419     define input  parameter p-browse-type   as character no-undo .
     2420     define input  parameter p-browse-handle as handle    no-undo .
     2421     define buffer buf_temp-browse-handle for temp-browse-handle .
     2422     do
     2423     on error undo, return error return-value
     2424     :
     2425       assign
     2426         v-diasize-browse-number = v-diasize-browse-number + 1
     2427       .
     2428       create buf_temp-browse-handle .
     2429       assign
     2430         buf_temp-browse-handle.browse-type   = p-browse-type
     2431         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2432         buf_temp-browse-handle.browse-handle = p-browse-handle
     2433       .
     2434     end.
     2435   end procedure.
     2436   procedure diasize_init :
     2437     define variable v-default-value    as logical   no-undo .
     2438     define variable v-restore-saved    as logical   no-undo .
     2439     define variable v-resize-value-str as character no-undo .
     2440     do
     2441     on error undo, return error return-value
     2442     :
     2443       do with frame fr-D-rsn-obj-0
     2444       :
     2445         assign
     2446           v-diasize-orig-frame-height = frame fr-D-rsn-obj-0 :height
     2447           v-diasize-orig-frame-width  = frame fr-D-rsn-obj-0 :width
     2448           v-diasize-browse-handle     = browse br-rsn-objs :handle
     2449         .
     2450         create button v-diasize-resize-button
     2451         assign
     2452           parent        = frame fr-D-rsn-obj-0 :first-child
     2453           label         = "s"
     2454           height-pixels = 16
     2455           width-pixels  = 16
     2456           visible       = true
     2457           sensitive     = true
     2458           movable       = true
     2459           triggers:
     2460             on end-move persistent run diasize_end-move in this-procedure .
     2461           end triggers.
     2462         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2463         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2464         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2465         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2466         assign
     2467           v-diasize-wndmax = false
     2468         .
     2469         if connected("ub") = true
     2470         then do:
     2471           define variable v-cntxt-db-num        as integer   no-undo .
     2472           define variable v-cntxt-userid        as character no-undo .
     2473           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2474                                             , OUTPUT v-cntxt-userid
     2475                                             ) .
     2476           run gbl/wndpar_r.p
     2477             (input  v-cntxt-db-num
     2478             ,input  v-cntxt-userid
     2479             ,input  'wndmax':U
     2480             ,output v-diasize-wndmax
     2481             ,output v-default-value
     2482             ) .
     2483         end.
     2484         assign
     2485           v-diasize-wndstore = false
     2486         .
     2487         if connected("ub") = true
     2488         then do:
     2489           run gbl/wndpar_r.p
     2490             (input  v-cntxt-db-num
     2491             ,input  v-cntxt-userid
     2492             ,input  'wndstore':U
     2493             ,output v-diasize-wndstore
     2494             ,output v-default-value
     2495             ) .
     2496         end.
     2497         assign
     2498           v-diasize-proc-name = entry(1, program-name(2), '.')
     2499         .
     2500         if v-diasize-wndstore = true
     2501         then do:
     2502           assign
     2503             v-restore-saved = false
     2504           .
     2505           if connected("ub") = true
     2506           then do:
     2507             run gbl/wndsizer.p
     2508               (input  v-cntxt-db-num
     2509               ,input  v-cntxt-userid
     2510               ,input  v-diasize-proc-name
     2511               ,input  'height':u
     2512               ,output v-resize-value-str
     2513               ) .
     2514             if v-resize-value-str <> '':U
     2515             then do:
     2516               run diasize_change-height in this-procedure
     2517                 (input  integer(v-resize-value-str)
     2518                 ,input  true
     2519                 ) .
     2520               assign
     2521                 v-restore-saved = true
     2522               .
     2523             end.
     2524           end.
     2525           if connected("ub") = true
     2526           then do:
     2527             run gbl/wndsizer.p
     2528               (input  v-cntxt-db-num
     2529               ,input  v-cntxt-userid
     2530               ,input  v-diasize-proc-name
     2531               ,input  'width':u
     2532               ,output v-resize-value-str
     2533               ) .
     2534             if v-resize-value-str <> '':U
     2535             then do:
     2536               run diasize_change-width in this-procedure
     2537                 (input  integer(v-resize-value-str)
     2538                 ,input  true
     2539                 ) .
     2540               assign
     2541                 v-restore-saved = true
     2542               .
     2543             end.
     2544           end.
     2545           if v-restore-saved <> true
     2546           then do:
     2547             if v-diasize-wndmax = true
     2548             then do:
     2549               run diasize_maximize in this-procedure
     2550                 (input  true
     2551                 ) .
     2552             end.
     2553           end.
     2554         end.
     2555         else do:
     2556           if v-diasize-wndmax = true
     2557           then do:
     2558             run diasize_maximize in this-procedure
     2559               (input  true
     2560               ) .
     2561           end.
     2562         end.
     2563       end.
     2564     end.
     2565   end procedure.
     2566   procedure diasize_need-full-display :
     2567     define output parameter p-need-full-display as logical   no-undo .
     2568     do
     2569     on error undo, return error return-value
     2570     :
     2571       assign
     2572         p-need-full-display = v-diasize-need-full-display
     2573       .
     2574       assign
     2575         v-diasize-need-full-display = false
     2576       .
     2577     end.
     2578   end procedure.
     2579   procedure get-context :
     2580      define output parameter p-db-num as integer          no-undo.
     2581      define output parameter p-user-id as character        no-undo.
     2582      define variable v-login               as character    no-undo.
     2583      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2584      define buffer buf_user-login  for ub.user-login .
     2585      do
     2586      on error undo, return error
     2587      :
     2588            FIND FIRST buf_sys-ctrl no-lock.
     2589            ASSIGN
     2590               v-login = USERID("ub")
     2591               p-db-num = buf_sys-ctrl.db-num
     2592            .
     2593            FIND FIRST buf_user-login
     2594                 WHERE buf_user-login.db-num = p-db-num
     2595                   AND buf_user-login.user-login = v-login
     2596                 no-lock
     2597                 no-error
     2598                 .
     2599            IF AVAILABLE buf_user-login
     2600            THEN DO:
     2601               assign
     2602                  p-user-id = buf_user-login.user-id
     2603               .
     2604            END.
     2605      end.
     2606   end procedure.
     2607       run diasize_init in this-procedure .
     2608   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2609   DEF VAR cur-clmn-numbr-rsn-objs as INT EXTENT 13 no-undo.
     2610   DEF VAR varmvibr-rsn-objs       as INT no-undo.
     2611   DEF VAR varmvjbr-rsn-objs       as INT no-undo.
     2612   DEF VAR varmvkbr-rsn-objs       as INT no-undo.
     2613   DEF VAR varmvlbr-rsn-objs       as INT no-undo.
     2614   DEF VAR move-elementbr-rsn-objs as INT no-undo.
     2615   def var jjbr-rsn-objs           as int no-undo.
     2616   do varmvibr-rsn-objs = 1 to EXTENT(cur-clmn-numbr-rsn-objs):
     2617     ASSIGN cur-clmn-numbr-rsn-objs[varmvibr-rsn-objs] = varmvibr-rsn-objs.
     2618   END.
     2619   RUN start-mv-clmnbr-rsn-objs.
     2620   PROCEDURE start-mv-clmnbr-rsn-objs:
     2621   def var old-session as logical no-undo.
     2622      old-session = SESSION:IMMEDIATE-DISPLAY.
     2623      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2624      SESSION:IMMEDIATE-DISPLAY = old-session.
     2625   END.
     2626   ON ctrl-cursor-right OF BROWSE br-rsn-objs do:
     2627     RUN re-move-clmnbr-rsn-objs ( 2, 13).
     2628   END.
     2629   ON ctrl-cursor-left OF BROWSE br-rsn-objs do:
     2630     RUN re-move-clmnbr-rsn-objs (13, 2).
     2631   END.
     2632   PROCEDURE re-move-clmnbr-rsn-objs:
     2633     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2634     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2635     DO varmvibr-rsn-objs = 1 TO EXTENT(cur-clmn-numbr-rsn-objs):
     2636       if cur-clmn-numbr-rsn-objs[varmvibr-rsn-objs] = source-column THEN cur-clmn-numbr-rsn-objs[varmvibr-rsn-objs] = -1.
     2637     END.
     2638     if br-rsn-objs:MOVE-COLUMN(source-column, target-column) IN FRAME fr-D-rsn-obj-0 then.
     2639     if source-column > target-column THEN
     2640     DO varmvjbr-rsn-objs = source-column - 1 to target-column BY -1:
     2641       DO varmvibr-rsn-objs = 1 TO EXTENT(cur-clmn-numbr-rsn-objs):
     2642           if cur-clmn-numbr-rsn-objs[varmvibr-rsn-objs] = varmvjbr-rsn-objs THEN DO:
     2643             cur-clmn-numbr-rsn-objs[varmvibr-rsn-objs] = cur-clmn-numbr-rsn-objs[varmvibr-rsn-objs] + 1.
     2644           END.
     2645       END.
     2646     END.
     2647     ELSE
     2648     DO varmvjbr-rsn-objs = source-column + 1 to target-column:
     2649       DO varmvibr-rsn-objs = 1 TO EXTENT(cur-clmn-numbr-rsn-objs):
     2650         if cur-clmn-numbr-rsn-objs[varmvibr-rsn-objs] = varmvjbr-rsn-objs THEN DO:
     2651           cur-clmn-numbr-rsn-objs[varmvibr-rsn-objs] = cur-clmn-numbr-rsn-objs[varmvibr-rsn-objs] - 1.
     2652         END.
     2653       END.
     2654     END.
     2655     DO varmvibr-rsn-objs = 1 TO EXTENT(cur-clmn-numbr-rsn-objs):
     2656       if cur-clmn-numbr-rsn-objs[varmvibr-rsn-objs] = -1 THEN cur-clmn-numbr-rsn-objs[varmvibr-rsn-objs] = target-column.
     2657     END.
     2658   END PROCEDURE.
     2659   PROCEDURE ch-clmnbr-rsn-objs:
     2660     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2661     if cur-clmn-loc <= 2 then do:
     2662       return .
     2663     end.
     2664     DO varmvibr-rsn-objs = 1 TO EXTENT(cur-clmn-numbr-rsn-objs):
     2665       if cur-clmn-numbr-rsn-objs[varmvibr-rsn-objs] = cur-clmn-loc THEN move-elementbr-rsn-objs = varmvibr-rsn-objs.
     2666     END.
     2667     RUN re-move-clmnbr-rsn-objs (cur-clmn-loc, 2).
     2668   END PROCEDURE.
     2669   PROCEDURE mv-brw-defaultbr-rsn-objs:
     2670   def var old-session as logical no-undo.
     2671     old-session = SESSION:IMMEDIATE-DISPLAY.
     2672     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2673     do varmvlbr-rsn-objs = 2 to EXTENT(cur-clmn-numbr-rsn-objs):
     2674       RUN re-move-clmnbr-rsn-objs (cur-clmn-numbr-rsn-objs[varmvlbr-rsn-objs], varmvlbr-rsn-objs).
     2675     END.
     2676     RUN start-mv-clmnbr-rsn-objs.
     2677     SESSION:IMMEDIATE-DISPLAY = old-session.
     2678   END PROCEDURE.
     2679   .
     2680   def var sort-labelbr-rsn-objs   as character no-undo .
     2681   def var sort-clmnbr-rsn-objs    as handle    no-undo .
     2682   def var cur-clmnbr-rsn-objs     as handle    no-undo .
     2683   def var cur-clmn-locbr-rsn-objs as integer   no-undo .
     2684   def var re-querybr-rsn-objs     as logical   initial no no-undo .
     2685   on start-search, ctrl-o of br-rsn-objs in frame fr-D-rsn-obj-0 do:
     2686      run sort-brbr-rsn-objs
     2687        (input (if available buf_c-trn-reason-obj
     2688                then recid(buf_c-trn-reason-obj)
     2689                else ?
     2690               )
     2691        ).
     2692   end.
     2693   PROCEDURE sort-brbr-rsn-objs :
     2694     define input parameter p-recid as recid no-undo .
     2695     if re-querybr-rsn-objs = no then do:
     2696       assign
     2697          cur-clmnbr-rsn-objs = br-rsn-objs:current-column in frame fr-D-rsn-obj-0
     2698       .
     2699       if sort-clmnbr-rsn-objs <> ? then sort-clmnbr-rsn-objs:column-fgcolor = 0.
     2700       if cur-clmnbr-rsn-objs = sort-clmnbr-rsn-objs then do:
     2701         assign
     2702            sort-labelbr-rsn-objs = ""
     2703            sort-clmnbr-rsn-objs = ?
     2704         .
     2705        end.
     2706        else do:
     2707          assign
     2708            sort-labelbr-rsn-objs = cur-clmnbr-rsn-objs:label
     2709            sort-clmnbr-rsn-objs  = cur-clmnbr-rsn-objs
     2710            sort-clmnbr-rsn-objs:column-fgcolor = 4
     2711          .
     2712        end.
     2713      end.
     2714     assign
     2715       cur-clmn-locbr-rsn-objs = 1
     2716     .
     2717     def var column-handle as handle no-undo .
     2718     column-handle = br-rsn-objs:first-column.
     2719     do while valid-handle(column-handle) :
     2720       if column-handle = cur-clmnbr-rsn-objs then do:
     2721         leave .
     2722       end.
     2723       column-handle = column-handle:NEXT-COLUMN.
     2724       assign
     2725         cur-clmn-locbr-rsn-objs = cur-clmn-locbr-rsn-objs + 1
     2726       .
     2727     end.
     2728     case sort-labelbr-rsn-objs:
     2729           when 'Объект'  then DO:    assign       sort-column-name = "obj-short( buffer buf_c-trn-reason-obj )"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2730           when 'ТД'  then DO:    assign       sort-column-name = "buf_c-trn-reason-obj.ext-doc-type"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2731           when 'М'  then DO:    assign       sort-column-name = "buf_c-trn-reason-obj.hold-doc"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2732           when 'Код основания'  then DO:    assign       sort-column-name = "buf_c-trn-reason-obj.reason-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2733           when 'Расширенный тип документа'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1ext-name&1, buf_c-trn-reason-obj.ext-doc-type)', chr(34))     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2734           when 'Изменил'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1usrfulnf&1, buf_c-trn-reason-obj.corr-user-name)', chr(34))     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2735           when 'Действие'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1ShowAction&1, buf_c-trn-reason-obj.action)', chr(34))     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2736           when 'Дата корр.'  then DO:    assign       sort-column-name = "buf_c-trn-reason-obj.corr-date"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2737           when 'Время'  then DO:    assign       sort-column-name = "STRING( buf_c-trn-reason-obj.corr-time, 'HH:MM:SS':U )"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2738           when 'Щепка'  then DO:    assign       sort-column-name = "buf_c-trn-reason-obj.chip-num"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2739           when 'БД'  then DO:    assign       sort-column-name = "buf_c-trn-reason-obj.corr-user-db-num"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2740       otherwise do:
     2741         assign
     2742           sort-column-name = ""
     2743         .
     2744         run OpenBr in this-procedure ( input yes, input no, input '':U ).
     2745           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-rsn-objs') then do:
     2746             run mv-brw-defaultbr-rsn-objs.
     2747           end.
     2748         if sort-labelbr-rsn-objs <> "" then do:
     2749           assign
     2750             cur-clmnbr-rsn-objs:column-fgcolor = 0
     2751           .
     2752         end.
     2753         assign
     2754           cur-clmn-locbr-rsn-objs = ?
     2755         .
     2756       end.
     2757     end case.
     2758     if p-recid <> ? then do:
     2759       reposition br-rsn-objs to recid p-recid no-error.
     2760       apply "value-changed" to br-rsn-objs in frame fr-D-rsn-obj-0.
     2761     end.
     2762     apply "entry" to br-rsn-objs in frame fr-D-rsn-obj-0.
     2763   END PROCEDURE.
     2764   procedure re-open-query-srt-clmnbr-rsn-objs:
     2765   if cur-clmnbr-rsn-objs = ? then do:
     2766      run OpenBr in this-procedure ( input yes, input no, input '':U ).
     2767   end.
     2768   else do:
     2769      assign re-querybr-rsn-objs = yes.
     2770      run sort-brbr-rsn-objs
     2771        (input (if available buf_c-trn-reason-obj
     2772                then recid(buf_c-trn-reason-obj)
     2773                else ?
     2774               )
     2775        ).
     2776      assign re-querybr-rsn-objs = no.
     2777   end.
     2778   end.
     2779   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2780   DEF VAR cur-clmn-numbr-changes as INT EXTENT 3 no-undo.
     2781   DEF VAR varmvibr-changes       as INT no-undo.
     2782   DEF VAR varmvjbr-changes       as INT no-undo.
     2783   DEF VAR varmvkbr-changes       as INT no-undo.
     2784   DEF VAR varmvlbr-changes       as INT no-undo.
     2785   DEF VAR move-elementbr-changes as INT no-undo.
     2786   def var jjbr-changes           as int no-undo.
     2787   do varmvibr-changes = 1 to EXTENT(cur-clmn-numbr-changes):
     2788     ASSIGN cur-clmn-numbr-changes[varmvibr-changes] = varmvibr-changes.
     2789   END.
     2790   RUN start-mv-clmnbr-changes.
     2791   PROCEDURE start-mv-clmnbr-changes:
     2792   def var old-session as logical no-undo.
     2793      old-session = SESSION:IMMEDIATE-DISPLAY.
     2794      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2795      SESSION:IMMEDIATE-DISPLAY = old-session.
     2796   END.
     2797   ON ctrl-cursor-right OF BROWSE br-changes do:
     2798     RUN re-move-clmnbr-changes ( 1, 3).
     2799   END.
     2800   ON ctrl-cursor-left OF BROWSE br-changes do:
     2801     RUN re-move-clmnbr-changes (3, 1).
     2802   END.
     2803   PROCEDURE re-move-clmnbr-changes:
     2804     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2805     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2806     DO varmvibr-changes = 1 TO EXTENT(cur-clmn-numbr-changes):
     2807       if cur-clmn-numbr-changes[varmvibr-changes] = source-column THEN cur-clmn-numbr-changes[varmvibr-changes] = -1.
     2808     END.
     2809     if br-changes:MOVE-COLUMN(source-column, target-column) IN FRAME fr-D-rsn-obj-0 then.
     2810     if source-column > target-column THEN
     2811     DO varmvjbr-changes = source-column - 1 to target-column BY -1:
     2812       DO varmvibr-changes = 1 TO EXTENT(cur-clmn-numbr-changes):
     2813           if cur-clmn-numbr-changes[varmvibr-changes] = varmvjbr-changes THEN DO:
     2814             cur-clmn-numbr-changes[varmvibr-changes] = cur-clmn-numbr-changes[varmvibr-changes] + 1.
     2815           END.
     2816       END.
     2817     END.
     2818     ELSE
     2819     DO varmvjbr-changes = source-column + 1 to target-column:
     2820       DO varmvibr-changes = 1 TO EXTENT(cur-clmn-numbr-changes):
     2821         if cur-clmn-numbr-changes[varmvibr-changes] = varmvjbr-changes THEN DO:
     2822           cur-clmn-numbr-changes[varmvibr-changes] = cur-clmn-numbr-changes[varmvibr-changes] - 1.
     2823         END.
     2824       END.
     2825     END.
     2826     DO varmvibr-changes = 1 TO EXTENT(cur-clmn-numbr-changes):
     2827       if cur-clmn-numbr-changes[varmvibr-changes] = -1 THEN cur-clmn-numbr-changes[varmvibr-changes] = target-column.
     2828     END.
     2829   END PROCEDURE.
     2830   PROCEDURE ch-clmnbr-changes:
     2831     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2832     if cur-clmn-loc <= 1 then do:
     2833       return .
     2834     end.
     2835     DO varmvibr-changes = 1 TO EXTENT(cur-clmn-numbr-changes):
     2836       if cur-clmn-numbr-changes[varmvibr-changes] = cur-clmn-loc THEN move-elementbr-changes = varmvibr-changes.
     2837     END.
     2838     RUN re-move-clmnbr-changes (cur-clmn-loc, 1).
     2839   END PROCEDURE.
     2840   PROCEDURE mv-brw-defaultbr-changes:
     2841   def var old-session as logical no-undo.
     2842     old-session = SESSION:IMMEDIATE-DISPLAY.
     2843     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2844     do varmvlbr-changes = 1 to EXTENT(cur-clmn-numbr-changes):
     2845       RUN re-move-clmnbr-changes (cur-clmn-numbr-changes[varmvlbr-changes], varmvlbr-changes).
     2846     END.
     2847     RUN start-mv-clmnbr-changes.
     2848     SESSION:IMMEDIATE-DISPLAY = old-session.
     2849   END PROCEDURE.
     2850   .
     2851   Main-Block:
     2852   do on error   undo Main-Block, leave Main-Block
     2853      on end-key undo Main-Block, leave Main-Block :
     2854     if lookup( p-mode, 'все,obj,one':U ) = 0 then do:
     2855       message vss-workfile skip vss-revision skip vss-date skip( 1 ) vss-description skip( 1 )
     2856               "Неверное значение параметра вызова p-mode:" p-mode
     2857       view-as alert-box error.
     2858       return.
     2859     end.
     2860     if p-mode = 'obj':U
     2861     then do:
     2862       find first sch_c-trn-reason-obj no-lock where
     2863                  sch_c-trn-reason-obj.obj-type = p-obj-type and
     2864                  sch_c-trn-reason-obj.obj-code = p-obj-code no-error.
     2865       if not available sch_c-trn-reason-obj then do:
     2866       end.
     2867     end.
     2868     if p-mode = 'one':U then do:
     2869       find first sch_c-trn-reason-obj no-lock where
     2870                  sch_c-trn-reason-obj.obj-type     = p-obj-type     and
     2871                  sch_c-trn-reason-obj.obj-code     = p-obj-code     and
     2872                  sch_c-trn-reason-obj.ext-doc-type = p-ext-doc-type and
     2873                  sch_c-trn-reason-obj.hold-doc     = p-hold-doc     no-error.
     2874       if not available sch_c-trn-reason-obj then do:
     2875       end.
     2876     end.
     2877     if p-rid-list <> "":U then do:
     2878       find first sch_c-trn-reason-obj no-lock where
     2879           recid( sch_c-trn-reason-obj ) = integer( entry( 1, p-rid-list ) ) no-error.
     2880       if not available sch_c-trn-reason-obj then do:
     2881       end.
     2882       else do:
     2883         assign v-doc-rec = recid( sch_c-trn-reason-obj ).
     2884       end.
     2885     end.
     2886     enable
     2887     b-mark   when lookup( "b-mark":U,   p-bttns ) > 0 or p-bttns = "*"
     2888     b-sel when lookup( "b-sel":U, p-bttns ) > 0 or p-bttns = "*"
     2889     b-sch b-help b-quit  br-rsn-objs br-changes sch-rsn sch-obj sch-ext
     2890     with frame fr-D-rsn-obj-0.
     2891     run OpenBr in this-procedure ( input yes, input no, input '':U ).
     2892     hide mark-num in frame fr-D-rsn-obj-0.
     2893     hide  sch-num in frame fr-D-rsn-obj-0.
     2894     if p-rid-list <> "":U then do:
     2895        reposition br-rsn-objs to recid v-doc-rec no-error.
     2896     end.
     2897     br-rsn-objs :set-repositioned-row( 5, "CONDITIONAL":U ).
     2898     wait-for go of frame fr-D-rsn-obj-0.
     2899   end.
     2900   hide frame fr-D-rsn-obj-0 no-pause.
     2901   procedure OpenBr :
     2902   define input parameter p-open-query     as logical   no-undo.
     2903   define input parameter p-find-next      as logical   no-undo.
     2904   define input parameter p-find-condition as character no-undo.
     2905   define variable l-query-was-opened as logical   no-undo.
     2906   define variable sort-column-phrase as character no-undo.
     2907   define variable l-open-query       as logical   no-undo.
     2908   case sort-column-name :
     2909     when "obj-short( buffer buf_c-trn-reason-obj )" then do:
     2910       assign sort-column-phrase = "by buf_c-trn-reason-obj.obj-type by buf_c-trn-reason-obj.obj-code".
     2911     end.
     2912     when "":U then do:
     2913       assign sort-column-phrase = "":U.
     2914     end.
     2915     otherwise      do:
     2916       assign sort-column-phrase = "by " + sort-column-name.
     2917     end.
     2918   end case.
     2919   assign
     2920   filter-point = substitute('&1 - &2', filter-point0, p-mode)
     2921   filter-label = substitute('&1 - &2', filter-label0, p-mode)
     2922   .
     2923   case p-mode :
     2924     when 'все':U  then do:
     2925       assign frame fr-D-rsn-obj-0 :title = "История оснований (причин) создания документов по объектам".
     2926   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2927   define variable  l-disable-where-19  as logical   no-undo .
     2928   define variable  l-filter-open-19    as logical   .
     2929   define variable  flt-rec-19       as recid     no-undo .
     2930   define variable  filter-name-19      as character no-undo .
     2931   define variable  where-phrase-19     as character no-undo .
     2932   define variable  sort-phrase-19      as character no-undo .
     2933   define variable  where-phrase-rus-19 as character no-undo .
     2934   define variable  sort-phrase-rus-19  as character no-undo .
     2935     run waitfram-show in this-procedure
     2936       (input "ЖДИТЕ ..."
     2937       ).
     2938   run gbl/flt-get.p
     2939     (input filter-point
     2940     ,output flt-rec-19
     2941     ,output filter-name-19
     2942     ,output where-phrase-19
     2943     ,output sort-phrase-19
     2944     ,output where-phrase-rus-19
     2945     ,output sort-phrase-rus-19
     2946     ).
     2947   if p-open-query then do:
     2948       run set-filter-name in this-procedure
     2949         (INPUT filter-name-19
     2950         ) no-error .
     2951     assign
     2952       l-filter-open-19 = false
     2953     .
     2954     if flt-rec-19 <> ?
     2955       or sort-column-phrase > ""
     2956     then do:
     2957       define variable  parameter-2-19 as character no-undo .
     2958       define variable  parameter-3-19 as character no-undo .
     2959       define variable  parameter-4-19 as character no-undo .
     2960       define variable  parameter-5-19 as character no-undo .
     2961       define variable  parameter-6-19 as character no-undo .
     2962       define variable  parameter-7-19 as character no-undo .
     2963         assign
     2964         parameter-3-19 =
     2965                                 "for each buf_c-trn-reason-obj"
     2966         parameter-4-19 =
     2967           (
     2968             if (" yes                       " + " " + where-phrase-19) <> ""
     2969             then " yes                       " + " " + where-phrase-19
     2970             else "true"
     2971           )
     2972         parameter-5-19 = (" " + "" + " " + "")
     2973         parameter-6-19 = if sort-phrase-19 = ''
     2974                              then
     2975           (
     2976           " " + "  " +
     2977             " " + sort-column-phrase +
     2978           " " + "  "
     2979           )
     2980                              else
     2981           (
     2982           " " + "  " +
     2983             " " + sort-column-phrase +
     2984           " " + sort-phrase-19
     2985           )
     2986         parameter-7-19 =
     2987           " indexed-reposition  "
     2988       .
     2989       do
     2990       on stop undo, leave
     2991       on error undo, leave
     2992       :
     2993         assign
     2994           l-disable-where-19 =
     2995             (" yes                       " + " " + where-phrase-19 = "")
     2996         .
