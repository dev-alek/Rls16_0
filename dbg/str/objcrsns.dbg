     3483                             ) no-error.
     3484         .
     3485         v-doc-rec = ?.
     3486       end.
     3487       assign
     3488         l-query-was-opened = true
     3489       .
     3490     end.
     3491   end.
     3492     run waitfram-hide in this-procedure .
     3493     end.
     3494   end case.
     3495   if p-open-query <> yes and v-doc-rec <> ? then
     3496   reposition br-rsn-objs to recid v-doc-rec no-error.
     3497   if not p-open-query and v-fltopend-rowid[1] <> ? then
     3498   query br-rsn-objs:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     3499   apply "VALUE-CHANGED":U to br-rsn-objs in frame fr-D-rsn-obj-0.
     3500   apply "ENTRY":U         to br-rsn-objs in frame fr-D-rsn-obj-0.
     3501   end procedure.
     3502   procedure proc-filter :
     3503         assign tbl      = 'c-trn-reason-obj'
     3504            join-tbl = 'buf_c-trn-reason-obj'
     3505            fld      = '':U
     3506            lab      = '':U
     3507            spr      = '':U
     3508            dim      = '0'.
     3509     run fltfield-add in this-procedure ( input 'obj-type',     input 'Тип объекта',    input '':U,  input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3510     run fltfield-add in this-procedure ( input 'obj-code',     input 'Код объекта',    input '':U,  input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3511     run fltfield-add in this-procedure ( input 'obj-type*obj-code',         input 'Объект',         input 'cli', input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3512     run fltfield-add in this-procedure ( input 'ext-doc-type', input 'Расширенн. тип', input '':U,  input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3513     run fltfield-add in this-procedure ( input 'hold-doc',     input 'Межфирменный',   input '':U,  input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3514     run fltfield-add in this-procedure ( input 'reason-code',  input 'Код причины',    input '':U,  input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3515     run fltfield-add in this-procedure ( input 'chip-num',     input 'Щепка',          input '':U,  input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3516     run fltfield-add in this-procedure ( input 'corr-user-db-num',  input 'Номер БД',       input '':U,  input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3517     run fltfield-add in this-procedure ( input 'corr-user-name',    input 'Имя',            input '':U,  input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3518     run fltfield-add in this-procedure ( input 'corr-date',    input 'Дата коррекции', input '':U,  input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3519     run fltfield-add in this-procedure ( input 'corr-time',    input 'Время в сек.',   input '':U,  input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3520     run fltfield-add in this-procedure ( input 'action',       input 'Действие',       input '':U,  input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3521     Filter-Block:
     3522     do on error   undo Filter-Block, leave Filter-Block
     3523        on end-key undo Filter-Block, leave Filter-Block :
     3524       run gbl/filter.w ( input parParentProc
     3525                      ,input filter-point + chr(4) + filter-label
     3526                      ,input tbl
     3527                      ,input join-tbl
     3528                      ,input fld
     3529                      ,input lab
     3530                      ,input spr
     3531                      ,input dim            ).
     3532       if return-value = 'undo':U then do:
     3533         apply "ENTRY":U to browse br-rsn-objs.
     3534         return no-apply.
     3535       end.
     3536       assign mark-num = 0
     3537              sch-num  = 0.
     3538       hide   mark-num in frame fr-D-rsn-obj-0.
     3539       hide   sch-num  in frame fr-D-rsn-obj-0.
     3540       run OpenBr in this-procedure ( input yes, input no, input '':U ).
     3541     end.
     3542   end procedure.
     3543   procedure proc-view-changes :
     3544   for each temp-changes :
     3545     delete temp-changes.
     3546   end.
     3547   if not available buf_c-trn-reason-obj then do:
     3548     run OpenChanges in this-procedure .
     3549     return.
     3550   end.
     3551   define variable v-label-param as character no-undo .
     3552   v-label-param =
     3553     "obj-type" + chr(4) + "Тип объекта" + chr(4) + "" + chr(8)
     3554    + "obj-code" + chr(4) + "Код объекта" + chr(4) + "" + chr(8)
     3555    + "ext-doc-type" + chr(4) + "Расш.тип док-та" + chr(4) + "" + chr(8)
     3556    + "hold-doc" + chr(4) + "Межфирменный." + chr(4) + "" + chr(8)
     3557    + "reason-code" + chr(4) + "Код основания" + chr(4).
     3558    run proc-full-temp-changes in this-procedure (
     3559                                                input  (buf_c-trn-reason-obj.action = integer('1':U))
     3560                                               ,input  (buf_c-trn-reason-obj.action = integer('99':U))
     3561                                               ,input  buffer  buf_c-trn-reason-obj:handle
     3562                                               ,input  'c-trn-reason-obj':U
     3563                                               ,input  "obj-tye,obj-code,host-code,ext-doc-type,hold-doc,reason-code"
     3564                                               ,input  v-label-param).
     3565   run OpenChanges in this-procedure .
     3566   end procedure.
     3567   procedure OpenChanges :
     3568   open query br-changes for each buf_changes.
     3569   end procedure.
     3570   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3571   procedure set-filter-name :
     3572   define input parameter p-filter-name as character no-undo .
     3573     do with frame fr-D-rsn-obj-0:
     3574       if p-filter-name > "" then do:
     3575         assign
     3576           frame fr-D-rsn-obj-0:title
     3577             = frame fr-D-rsn-obj-0:title + "   ФИЛЬТР: " + p-filter-name.
     3578         .
     3579         assign
     3580           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3581         .
     3582       end.
     3583       else do:
     3584         assign
     3585           b-sch :tooltip = ""
     3586         .
     3587       end.
     3588     end.
     3589   end procedure.
     3590   procedure get-mark-string :
     3591     define        parameter buffer loc-buf for ub.c-trn-reason-obj.
     3592     define output parameter        p-sign  as  character no-undo.
     3593     assign p-sign = ( if lookup( Rec2Char( recid( loc-buf ) ), p-rid-list ) > 0 then chr( 42 ) else chr( 32 ) ).
     3594   end procedure.
     3595   procedure get-action-name :
     3596     define  input parameter p-code as integer   no-undo.
     3597     define output parameter p-name as character no-undo.
     3598     define variable v_code  as character no-undo.
     3599     define variable j_entry as integer   no-undo.
     3600     if p-code = ? or p-code = 0 then do: assign p-name = "":U. end.
     3601     assign v_code  = Int2Char( p-code ).
     3602     assign j_entry = lookup(   v_code, p-act-codes ).
     3603     assign p-name  = ( if j_entry = 0 then "":U else entry( j_entry, p-act-names ) ).
     3604   end procedure.
     3605   procedure get-obj-name :
     3606     define        parameter buffer loc-buf for ub.c-trn-reason-obj.
     3607     define  input parameter        p-mode  as  character no-undo.
     3608     define output parameter        p-name  as  character no-undo.
     3609     define buffer buf_cli for ub.clients.
     3610     if p-mode = "name" then do:
     3611       find first buf_cli no-lock where
     3612                  buf_cli.obj-type = loc-buf.obj-type and
     3613                  buf_cli.obj-code = loc-buf.obj-code no-error.
     3614       assign p-name = ( if available buf_cli then buf_cli.obj-name else "":U ).
     3615     end.               else do:
     3616       assign p-name = loc-buf.obj-type + " ":U + Int2Char( loc-buf.obj-code ).
     3617     end.
     3618   end procedure.
     3619   procedure get-ext-name :
     3620     define  input parameter p-code as character no-undo.
     3621     define output parameter p-name as character no-undo.
     3622     define variable v_code  as character no-undo.
     3623     define variable j_entry as integer   no-undo.
     3624     assign j_entry = lookup( p-code, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ).
     3625     assign p-name  = ( if j_entry > 0 then entry( j_entry, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) else "":U ).
     3626   end procedure.
     3627   procedure proc-find-rsn :
     3628     define input parameter p-next as logical no-undo.
     3629     define input parameter p-code as integer no-undo.
     3630     run OpenBr in this-procedure ( input no,
     3631                                    input p-next,
     3632                                    input substitute( " and buf_c-trn-reason-obj.reason-code = &1 ", p-code ) ).
     3633     if v-doc-rec <> ? then do:
     3634       if FoundRec = ? then do:
     3635         assign FoundRec = v-doc-rec.
     3636       end.
     3637       if FoundRec = v-doc-rec then do:
     3638         assign sch-num = 0.
     3639       end.
     3640       assign  sch-num = sch-num + 1.
     3641       display
     3642       sch-num with frame fr-D-rsn-obj-0.
     3643     end.
     3644     else do:
     3645       assign  sch-num = 0.
     3646       hide
     3647       sch-num
     3648       in frame fr-D-rsn-obj-0.
     3649     end.
     3650     apply "ENTRY":U to sch-rsn in frame fr-D-rsn-obj-0.
     3651   end procedure.
     3652   procedure proc-find-obj :
     3653     define input parameter p-next as logical no-undo.
     3654     define input parameter p-code as integer no-undo.
     3655     run OpenBr in this-procedure ( input no,
     3656                                    input p-next,
     3657                                    input substitute( " and buf_c-trn-reason-obj.obj-code = &1 ", p-code ) ).
     3658     if v-doc-rec <> ? then do:
     3659       if FoundRec = ? then do: assign FoundRec = v-doc-rec. end.
     3660       if FoundRec = v-doc-rec then do: assign sch-num = 0. end.
     3661       assign  sch-num = sch-num + 1.
     3662       display
     3663       sch-num with frame fr-D-rsn-obj-0.
     3664     end.
     3665     else do:
     3666       assign  sch-num = 0.
     3667       hide
     3668       sch-num
     3669       in frame fr-D-rsn-obj-0.
     3670     end.
     3671     apply "ENTRY":U to sch-obj in frame fr-D-rsn-obj-0.
     3672   end procedure.
     3673   procedure proc-find-ext :
     3674     define input parameter p-next as logical   no-undo.
     3675     define input parameter p-name as character no-undo.
     3676     assign p-name = replace( p-name, chr(34), chr(34) + chr(34) )
     3677            p-name = replace( p-name, chr(39), chr(39) + chr(39) )
     3678            p-name = chr(34) + p-name + chr(34).
     3679     run OpenBr in this-procedure ( input no,
     3680                                    input p-next,
     3681                                    input substitute( " and buf_c-trn-reason-obj.ext-doc-type = &1 ", p-name ) ).
     3682     if v-doc-rec <> ? then do:
     3683       if FoundRec = ? then do: assign FoundRec = v-doc-rec. end.
     3684       if FoundRec = v-doc-rec then do: assign sch-num = 0. end.
     3685       assign  sch-num = sch-num + 1.
     3686       display
     3687       sch-num with frame fr-D-rsn-obj-0.
     3688     end.
     3689     else do:
     3690       assign  sch-num = 0.
     3691       hide
     3692       sch-num in frame fr-D-rsn-obj-0.
     3693     end.
     3694     apply "ENTRY":U to sch-ext in frame fr-D-rsn-obj-0.
     3695   end procedure.
