     8325       libthpos_chk-context.to-pay-base = libthpos_chk-context.to-pay-base + buf_libthpos_chk-pay.brutto-base +
     8326                                         (if buf_libthpos_chk-pay.inversed then buf_libthpos_chk-pay.discnt-base else 0)
     8327       libthpos_chk-context.has-pay-base = libthpos_chk-context.has-pay-base - buf_libthpos_chk-pay.tot-base
     8328       libthpos_chk-context.all-pay-base = libthpos_chk-context.all-pay-base + buf_libthpos_chk-pay.discnt-base
     8329       libthpos_chk-context.pay-r = libthpos_chk-context.pay-r - buf_libthpos_chk-pay.r-sum
     8330       .
