      431   procedure thbjattr_code_reg :
      432   define input  parameter p-upper-code     as character no-undo .
      433   define input  parameter p-code           as character no-undo .
      434   define output parameter p-label          as character no-undo .
      435   define output parameter p-user-can-edit  as logical   no-undo .
