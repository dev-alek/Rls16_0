     7988                   v-err-mess = substitute("Ошибка при получении курса валюты &1 на &2", p-curr-code, string(v-today, "99/99/9999")).
     7989                   undo main-block, retry main-block.
     7990                 end.
     7991                 assign
     7992                 v-tot-rubl = v-tot-sum * buf_curr-shop.exch-rate / buf_curr-shop.exch-scale
     7993                 v-tot-base = v-tot-rubl / libthpos_chk-context.cash-rate * libthpos_chk-context.cash-scale
     7994                 .
     7995               end.
     7996             end.
     7997             if v-atr1 = no
     7998             and (v-has-overpay = 0
     7999                 or
     8000                 lookup(string(libthpos_chk-context.chk-type), '1,69,14,15,16,36':U) = 0
     8001                 )
     8002             and (
     8003                   ( libthpos_context.r-b = 'rubl':U
     8004                   and
     8005                   abs(v-tot-rubl) > abs(libthpos_chk-context.to-pay-rubl))
     8006                   or
     8007                   ( libthpos_context.r-b = 'base':U
     8008                   and
     8009                   abs(v-tot-rubl) > abs(libthpos_chk-context.to-pay-base))
     8010                 ) then do:
