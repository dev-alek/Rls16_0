     4033     run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-pay:table-handle)
     4034                                                     , input no).
     4035     run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-gds:table-handle)
     4036                                                     , input no).
     4037     run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-discnt:table-handle)
     4038                                                     , input no).
     4039     for each libthpos_cash-desk-attr:
     4040       delete libthpos_cash-desk-attr.
     4041     end.
     4042     for each libthpos_context:
     4043       delete libthpos_context.
     4044     end.
     4045     for each libthpos_chk-context:
     4046       delete libthpos_chk-context.
     4047     end.
     4048     for each libthpos_dis-card-mask:
     4049       delete libthpos_dis-card-mask.
     4050     end.
     4051     dataset libthpos_params:empty-dataset().
     4052     dataset libthpos_receipt:empty-dataset().
     4053     for each buf_libthpos_rp-by-call:
     4054       if  valid-handle(buf_libthpos_rp-by-call.rph) then do:
     4055         delete procedure(buf_libthpos_rp-by-call.rph).
     4056       end.
     4057       delete buf_libthpos_rp-by-call.
     4058     end.
     4059     assign
     4060       g#libthpos = ?
     4061     .
     4062   end.
     4063   procedure libthpos_clear-cda:
     4064   define buffer buf_libthpos_cash-desk-attr for libthpos_cash-desk-attr.
     4065     do
     4066     on error undo, return error return-value
     4067     :
     4068       for each buf_libthpos_cash-desk-attr
     4069       on error undo, return error :
     4070         delete buf_libthpos_cash-desk-attr.
     4071       end.
     4072     end.
     4073   end procedure.
     4074   function libthpos_rmethod returns decimal ( input p-rmethod-type as character
     4075                                               ,input p-rmethod-coeff as decimal
     4076                                               ,input p-sum as decimal ):
     4077   define variable  mround-sum as decimal no-undo.
     4078   case p-rmethod-type:
     4079     when "MROUND" then do:
     4080       if p-rmethod-coeff > 0 then do:
     4081         mround-sum = truncate(p-sum, integer(p-rmethod-coeff)).
     4082       end.
     4083       else do:
     4084         mround-sum = truncate(p-sum / exp(10, abs(p-rmethod-coeff)), 0) * EXP(10, abs(p-rmethod-coeff)).
     4085       end.
     4086     end.
     4087     when "NO-COINS" then do:
     4088       mround-sum = truncate( p-sum / p-rmethod-coeff, 0) * p-rmethod-coeff.
     4089     end.
     4090   end case.
     4091   return mround-sum.
     4092   end function.
     4093   procedure libthpos_clear-context:
     4094   define buffer buf_libthpos_context for libthpos_context.
     4095   define buffer buf_libthpos_dis-card-mask for libthpos_dis-card-mask.
     4096   define buffer buf_libthpos_rp-by-call for libthpos_rp-by-call.
     4097   define buffer buf_libthpos_flddf for libthpos_flddf.
     4098   define buffer buf_libthpos_cash-counter for libthpos_cash-counter.
     4099     do
     4100     on error undo, return error return-value
     4101     :
     4102       for each buf_libthpos_flddf
     4103       on error undo, return error :
     4104         delete buf_libthpos_flddf.
     4105       end.
     4106       for each buf_libthpos_context
     4107       on error undo, return error :
     4108         delete buf_libthpos_context.
     4109       end.
     4110       for each buf_libthpos_dis-card-mask
     4111       on error undo, return error :
     4112         delete buf_libthpos_dis-card-mask.
     4113       end.
     4114       for each buf_libthpos_cash-counter:
     4115         delete buf_libthpos_cash-counter.
     4116       end.
     4117       for each buf_libthpos_rp-by-call:
     4118         if  valid-handle(buf_libthpos_rp-by-call.rph) then do:
     4119           delete procedure(buf_libthpos_rp-by-call.rph).
     4120         end.
     4121         delete buf_libthpos_rp-by-call.
     4122       end.
     4123     end.
     4124   end procedure.
     4125   procedure libthpos_fill-cda:
     4126   define input parameter p-db-num as integer no-undo .
     4127   define input parameter p-obj-code as integer no-undo .
     4128   define input parameter p-pos-type as character no-undo .
     4129   define input parameter p-cash-num as integer no-undo .
     4130   do
     4131   on error undo, return error return-value
     4132   :
     4133   define buffer buf_libthpos_cash-desk-attr for libthpos_cash-desk-attr.
     4134   define buffer buf_cash-desk-attr for ub.cash-desk-attr.
     4135     do
     4136     on error undo, return error return-value
     4137     :
     4138       run libthpos_clear-cda in this-procedure.
     4139       for each buf_cash-desk-attr no-lock where
     4140                buf_cash-desk-attr.db-num = p-db-num
     4141            and buf_cash-desk-attr.obj-code = p-obj-code
     4142            and buf_cash-desk-attr.pos-type = p-pos-type
     4143            and buf_cash-desk-attr.cash-num = p-cash-num
     4144       on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4145       :
     4146         create buf_libthpos_cash-desk-attr.
     4147         buffer-copy buf_cash-desk-attr to buf_libthpos_cash-desk-attr.
     4148       end.
     4149     end.
     4150   end.
     4151   end procedure.
     4152   procedure libthpos_get-cda :
     4153   define input parameter p-db-num as integer no-undo .
     4154   define input parameter p-obj-code as integer no-undo .
     4155   define input parameter p-pos-type as character no-undo .
     4156   define input parameter p-cash-num as integer no-undo .
     4157   define input parameter p-upper-attr-code as character no-undo .
     4158   define input parameter p-attr-code as character no-undo .
     4159   define output parameter p-attr-value-character as character no-undo .
     4160   define output parameter p-attr-value-date as date no-undo .
     4161   define output parameter p-attr-value-decimal as decimal no-undo .
     4162   define output parameter p-attr-value-integer as integer no-undo .
     4163   define output parameter p-attr-value-logical as logical no-undo .
     4164   define output parameter p-attr-value-type as character no-undo .
     4165   define buffer buf_libthpos_cash-desk-attr for libthpos_cash-desk-attr.
     4166   main-block:
     4167   do
     4168   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4169   :
     4170     find first libthpos_context no-error.
     4171     if not available libthpos_context then do:
     4172       undo main-block, return error substitute("Не выставлен контекст работы").
     4173     end.
     4174     if not (libthpos_context.db-num = p-db-num
     4175             or
     4176             libthpos_context.obj-code = p-obj-code
     4177             or
     4178             libthpos_context.pos-type = p-pos-type
     4179             or
     4180             libthpos_context.cash-num = p-cash-num) then do:
     4181       undo main-block, return error substitute("Неверный контекст").
     4182     end.
     4183     find first buf_libthpos_cash-desk-attr where
     4184               buf_libthpos_cash-desk-attr.upper-attr-code = p-upper-attr-code
     4185           and buf_libthpos_cash-desk-attr.attr-code = p-attr-code
     4186           and buf_libthpos_cash-desk-attr.db-num = libthpos_context.db-num
     4187           and buf_libthpos_cash-desk-attr.obj-code = libthpos_context.obj-code
     4188           and buf_libthpos_cash-desk-attr.pos-type = libthpos_context.pos-type
     4189           and buf_libthpos_cash-desk-attr.cash-num = libthpos_context.cash-num no-error .
     4190     if not available buf_libthpos_cash-desk-attr then do:
     4191       undo  main-block, return error substitute("Не найден параметр кассы &1 (секция &2)", p-attr-code, p-upper-attr-code).
     4192     end.
     4193     assign
     4194     p-attr-value-character = buf_libthpos_cash-desk-attr.attr-value-character
     4195     p-attr-value-date = buf_libthpos_cash-desk-attr.attr-value-date
     4196     p-attr-value-decimal = buf_libthpos_cash-desk-attr.attr-value-decimal
     4197     p-attr-value-integer = buf_libthpos_cash-desk-attr.attr-value-integer
     4198     p-attr-value-logical = buf_libthpos_cash-desk-attr.attr-value-logical
     4199     p-attr-value-type = buf_libthpos_cash-desk-attr.attr-value-type
     4200     .
     4201   end.
     4202   end procedure.
     4203   procedure libthpos_get-all-cda :
     4204   define input parameter p-db-num as integer no-undo .
     4205   define input parameter p-obj-code as integer no-undo .
     4206   define input parameter p-pos-type as character no-undo .
     4207   define input parameter p-cash-num as integer no-undo .
     4208   define output parameter dataset FOR libthpos_params .
     4209   define buffer buf_libthpos_cash-desk-attr for libthpos_cash-desk-attr.
     4210   main-block:
     4211   do
     4212   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4213   :
     4214     find first libthpos_context no-error.
     4215     if not available libthpos_context then do:
     4216       undo main-block, return error substitute("Не выставлен контекст работы").
     4217     end.
     4218     if not (libthpos_context.db-num = p-db-num
     4219             or
     4220             libthpos_context.obj-code = p-obj-code
     4221             or
     4222             libthpos_context.pos-type = p-pos-type
     4223             or
     4224             libthpos_context.cash-num = p-cash-num) then do:
     4225       undo main-block, return error substitute("Неверный контекст").
     4226     end.
     4227   end.
     4228   end procedure.
     4229   procedure libthpos_create-context :
     4230   define input parameter p-parparentproc as widget-handle no-undo .
     4231   define input parameter p-log-handle as handle no-undo .
     4232   define input parameter p-db-num   as integer no-undo .
     4233   define input parameter p-obj-code as integer no-undo .
     4234   define input parameter p-pos-type as character no-undo .
     4235   define input parameter p-cash-num as integer no-undo .
     4236   define output parameter p-serial-code as character no-undo .
     4237   define output parameter p-r-b as character no-undo .
     4238   define output parameter p-base-code as integer no-undo .
     4239   define variable v-type as character no-undo .
     4240   define variable v-tth as handle no-undo .
     4241   define variable v-process-sale as logical no-undo .
     4242   define variable v-nam-artc as logical no-undo .
     4243   define variable v-cod-pcod as logical no-undo .
     4244   define variable v-nam-2str as logical no-undo .
     4245   define variable v-name-2cd as character no-undo .
     4246   define variable v-how-temp-disc as character no-undo .
     4247   define variable v-nalc as integer no-undo .
     4248   define variable v-rmethod-type as character no-undo .
     4249   define variable v-rmethod-coeff as decimal no-undo .
     4250   define variable v-cash-counter as decimal no-undo .
     4251   define variable v-manual-discnt as integer no-undo .
     4252   define variable v-salesman-mandatory as integer no-undo .
     4253   define variable v-log-level as integer   no-undo .
     4254   define variable v-qnty-change as logical   no-undo .
     4255   define variable v-pos-type-for-discnt as character no-undo .
     4256   define variable v-value-character as character no-undo .
     4257   define variable v-value-date as date no-undo .
     4258   define variable v-value-decimal as decimal no-undo .
     4259   define variable v-value-integer as integer no-undo .
     4260   define variable v-value-logical as logical no-undo .
     4261   define variable v-param-type as character no-undo .
     4262   define variable v-call-id as character no-undo .
     4263   define variable v-prop-code as character no-undo .
     4264   DEFINE VARIABLE v-today as date no-undo .
     4265   DEFINE VARIABLE v-time as integer no-undo .
     4266   define buffer buf_cash-desk for ub.cash-desk.
     4267   define buffer buf_libthpos_context for libthpos_context.
     4268   define buffer buf_dis-card-mask for ub.dis-card-mask.
     4269   define buffer buf_libthpos_dis-card-mask for libthpos_dis-card-mask.
     4270   define buffer buf_libthpos_cash-desk-attr for libthpos_cash-desk-attr.
     4271   define buffer buf_rp-by-call for ub.rp-by-call.
     4272   define buffer buf_libthpos_rp-by-call for libthpos_rp-by-call.
     4273   define buffer buf_thbj-attr for ub.thbj-attr.
     4274   define buffer buf_libthpos_cash-counter for libthpos_cash-counter.
     4275   define buffer buf_curr-shop for ub.curr-shop.
     4276   define buffer buf_inkas-pay-wth for ub.inkas-pay-wth.
     4277   define buffer buf_cash-pay for ub.cash-pay.
     4278   main-block:
     4279   do
     4280   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4281   :
     4282     if p-pos-type <> 'IBS-TH':U
     4283     and p-pos-type <> 'IBS-TH-MOB':U
     4284     then do:
     4285       undo main-block, return error substitute("Неверный тип POS = &1", p-pos-type).
     4286     end.
     4287     find first buf_cash-desk no-lock where
     4288             buf_cash-desk.db-num = p-db-num
     4289         and buf_cash-desk.obj-code = p-obj-code
     4290         and buf_cash-desk.pos-type = p-pos-type
     4291         and buf_cash-desk.cash-num = p-cash-num no-error.
     4292     if not available buf_cash-desk then do:
     4293       undo main-block, return error substitute("Нет POS &1 №&2 на маг&3 БД &4"
     4294                                     , p-pos-type
     4295                                     , p-cash-num
     4296                                     , p-obj-code
     4297                                     , p-db-num
     4298                                     ).
     4299     end.
     4300     if buf_cash-desk.cash-on = no then do:
     4301       undo main-block, return error substitute("POS &1 №&2 на маг&3 БД &4 ВЫКЛЮЧЕН"
     4302                                     , p-pos-type
     4303                                     , p-cash-num
     4304                                     , p-obj-code
     4305                                     , p-db-num
     4306                                     ).
     4307     end.
     4308     for each libthpos_chk-context:
     4309       delete libthpos_chk-context.
     4310     end.
     4311     run libthpos_clear-context in this-procedure .
     4312      run libthpos_create-flddf in this-procedure no-error .
     4313      if error-status:error then do:
     4314        undo, return error substitute("&1&2&3", error-status:get-message(1) , chr(10), return-value ).
     4315      end.
     4316   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4317   if (valid-handle(g#libchkvl) <> true) then do:   run str/libchkvl.p persistent no-error .   if error-status :error or (valid-handle(g#libchkvl) <> true) then do:     message       "Error starting nws/libchkvl.p" skip       g#libchkvl skip       g#libchkvl :type skip       g#libchkvl :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libchkvl_create-context in g#libchkvl
     4318     (input  'маг':U
     4319     ,input  p-obj-code
     4320     ,input  buffer buf_libthpos_context:handle
     4321     ) no-error .
     4322     if error-status:error then do:
     4323       undo, return error substitute("Ошибка при создании контекста&1&2&1&3"
     4324                                      , chr(10)
     4325                                      , error-status:get-message(1)
     4326                                      , return-value ).
     4327     end.
     4328     find first buf_libthpos_context.
     4329     for each buf_libthpos_dis-card-mask:
     4330       delete buf_libthpos_dis-card-mask.
     4331     end.
     4332     _maska:
     4333     for each buf_dis-card-mask no-lock where
     4334         buf_Dis-card-mask.stts              = integer('0':U)
     4335     by buf_Dis-card-mask.host-code
     4336     by buf_Dis-card-mask.obj-type
     4337     by buf_Dis-card-mask.obj-code
     4338     by buf_Dis-card-mask.rank
     4339     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4340     :
     4341       if buf_dis-card-mask.host-code <> 0
     4342       And buf_dis-card-mask.host-code <> buf_libthpos_context.host-code then next _maska.
     4343       if (buf_dis-card-mask.obj-type <> "":U
     4344       AND buf_dis-card-mask.obj-type <> 'маг':U)
     4345       or (buf_dis-card-mask.obj-code <> 0
     4346       and buf_dis-card-mask.obj-code <> p-obj-code)
     4347       then NEXT _maska.
     4348       if buf_dis-card-mask.use-on = integer('2':U) then NEXT _Maska.
     4349       create buf_libthpos_dis-card-mask.
     4350       buffer-copy buf_dis-card-mask to
     4351       buf_libthpos_dis-card-mask.
     4352     end.
     4353     run libthpos_fill-cda in this-procedure (
     4354                                                 input p-db-num
     4355                                                 ,input p-obj-code
     4356                                                 ,input p-pos-type
     4357                                                 ,input p-cash-num ) no-error.
     4358     if error-status:error then do:
     4359       undo main-block, return error substitute("Ошибка при поиске заполнении массива значений параметров кассы&1:&2&1&3"
     4360                                      , chr(10)
     4361                                      , error-status:get-message(1)
     4362                                      , return-value ).
     4363     end.
     4364     for each thbjattr_thbj-attr:
     4365       delete thbjattr_thbj-attr.
     4366     end.
     4367     assign
     4368     v-tth = buffer thbjattr_thbj-attr:table-handle .
     4369     run adm/shattri.p (
     4370         input "get":U
     4371         ,input  'маг':U
     4372         ,input  p-obj-code
     4373         ,input  'cd-inf-send':U
     4374         ,input  '':U
     4375         ,output v-value-character
     4376         ,output v-value-date
     4377         ,output v-value-decimal
     4378         ,output v-value-integer
     4379         ,output v-value-logical
     4380         ,output v-param-type
     4381         ,INPUT-OUTPUT table-handle v-tth
     4382         ) no-error .
     4383     if error-status:error then return error .
     4384     for each thbjattr_thbj-attr where
     4385             thbjattr_thbj-attr.obj-type = 'маг':U
     4386         and thbjattr_thbj-attr.obj-code = buf_libthpos_context.obj-code
     4387         and thbjattr_thbj-attr.upper-prop-code = 'cd-inf-send':U
     4388     on error undo, return error :
     4389       case thbjattr_thbj-attr.prop-code:
     4390         when 'nam-artc':U then do:
     4391           v-nam-artc = thbjattr_thbj-attr.property-value-logical.
     4392         end.
     4393         when 'cod-pcod':U then do:
     4394           v-cod-pcod = thbjattr_thbj-attr.property-value-logical.
     4395         end.
     4396         when 'nam-2str':U then do:
     4397           v-nam-2str = thbjattr_thbj-attr.property-value-logical.
     4398         end.
     4399         when 'name-2cd':U then do:
     4400           v-name-2cd = thbjattr_thbj-attr.property-value-character.
     4401         end.
     4402         when 'how-temp-disc':U then do:
     4403           v-how-temp-disc = thbjattr_thbj-attr.property-value-character.
     4404         end.
     4405       end case.
     4406     end.
     4407     v-tth = buffer thbjattr_thbj-attr:table-handle .
     4408     run adm/shattri.p (
     4409         input "get":U
     4410         ,input  'маг':U
     4411         ,input  p-obj-code
     4412         ,input  'cd-sending':U
     4413         ,input  'process-sale':U
     4414         ,output v-value-character
     4415         ,output v-value-date
     4416         ,output v-value-decimal
     4417         ,output v-value-integer
     4418         ,output v-process-sale
     4419         ,output v-param-type
     4420         ,INPUT-OUTPUT table-handle v-tth
     4421         ) no-error .
     4422     if error-status:error then return error .
     4423     if p-pos-type = 'IBS-TH':U then do:
     4424       find first buf_libthpos_cash-desk-attr no-lock where
     4425                 buf_libthpos_cash-desk-attr.db-num = p-db-num
     4426             and buf_libthpos_cash-desk-attr.obj-code = p-obj-code
     4427             and buf_libthpos_cash-desk-attr.pos-type = p-pos-type
     4428             and buf_libthpos_cash-desk-attr.cash-num = p-cash-num
     4429             and buf_libthpos_cash-desk-attr.upper-attr-code = 'IBS-TH_fisreg':U
     4430             and buf_libthpos_cash-desk-attr.attr-code = 'cash-pay-list':U no-error.
     4431         .
     4432       run libthpos_get-cash-pay-list in this-procedure (
     4433                                                         input  (if available buf_libthpos_cash-desk-attr
     4434                                                         then buf_libthpos_cash-desk-attr.attr-value-character
     4435                                                         else '') ) no-error .
     4436       find first buf_libthpos_cash-desk-attr no-lock where
     4437                 buf_libthpos_cash-desk-attr.db-num = p-db-num
     4438             and buf_libthpos_cash-desk-attr.obj-code = p-obj-code
     4439             and buf_libthpos_cash-desk-attr.pos-type = p-pos-type
     4440             and buf_libthpos_cash-desk-attr.cash-num = p-cash-num
     4441             and buf_libthpos_cash-desk-attr.upper-attr-code = 'IBS-TH_fisreg':U
     4442             and buf_libthpos_cash-desk-attr.attr-code = 'pay-names':U no-error.
     4443       run libthpos_get-pay-names in this-procedure ( input  (if available buf_libthpos_cash-desk-attr
     4444                                                       then buf_libthpos_cash-desk-attr.attr-value-character
     4445                                                       else '') ) no-error .
     4446       find first buf_libthpos_cash-desk-attr no-lock where
     4447                 buf_libthpos_cash-desk-attr.db-num = p-db-num
     4448             and buf_libthpos_cash-desk-attr.obj-code = p-obj-code
     4449             and buf_libthpos_cash-desk-attr.pos-type = p-pos-type
     4450             and buf_libthpos_cash-desk-attr.cash-num = p-cash-num
     4451             and buf_libthpos_cash-desk-attr.upper-attr-code = 'IBS-TH_main':U
     4452             and buf_libthpos_cash-desk-attr.attr-code = 'nalc':U no-error.
     4453         .
     4454       assign
     4455       v-nalc = (if available buf_libthpos_cash-desk-attr
     4456                 then buf_libthpos_cash-desk-attr.attr-value-integer
     4457                 else 0)
     4458       .
     4459       find first buf_libthpos_cash-desk-attr no-lock where
     4460                 buf_libthpos_cash-desk-attr.db-num = p-db-num
     4461             and buf_libthpos_cash-desk-attr.obj-code = p-obj-code
     4462             and buf_libthpos_cash-desk-attr.pos-type = p-pos-type
     4463             and buf_libthpos_cash-desk-attr.cash-num = p-cash-num
     4464             and buf_libthpos_cash-desk-attr.upper-attr-code = 'IBS-TH_main':U
     4465             and buf_libthpos_cash-desk-attr.attr-code = 'rmethod-type':U no-error.
     4466         .
     4467       assign
     4468       v-rmethod-type = (if available buf_libthpos_cash-desk-attr
     4469                         then buf_libthpos_cash-desk-attr.attr-value-character
     4470                         else "MROUND")
     4471       v-rmethod-coeff = (if not available buf_libthpos_cash-desk-attr
     4472                         then 2.0
     4473                         else v-rmethod-coeff)
     4474       .
     4475       if available buf_libthpos_cash-desk-attr then do:
     4476         find first buf_libthpos_cash-desk-attr no-lock where
     4477                   buf_libthpos_cash-desk-attr.db-num = p-db-num
     4478               and buf_libthpos_cash-desk-attr.obj-code = p-obj-code
     4479               and buf_libthpos_cash-desk-attr.pos-type = p-pos-type
     4480               and buf_libthpos_cash-desk-attr.cash-num = p-cash-num
     4481               and buf_libthpos_cash-desk-attr.upper-attr-code = 'IBS-TH_main':U
     4482               and buf_libthpos_cash-desk-attr.attr-code = 'rmethod-coeff':U no-error.
     4483         assign
     4484         v-rmethod-coeff = (if available buf_libthpos_cash-desk-attr
     4485                           then buf_libthpos_cash-desk-attr.attr-value-decimal
     4486                           else (if v-rmethod-type = "MROUND"
     4487                                 then 2.0
     4488                                 else 0.0
     4489                                 )
     4490                           )
     4491         .
     4492       end.
     4493       run cur-time in this-procedure ( output v-today, output v-time).
     4494       for each buf_inkas-pay-wth no-lock where
     4495               buf_inkas-pay-wth.obj-code = p-obj-code
     4496           and buf_inkas-pay-wth.obj-code = p-obj-code
     4497           and buf_inkas-pay-wth.pay-desk = p-cash-num
     4498           and buf_inkas-pay-wth.inkas-code = ''
     4499           and buf_inkas-pay-wth.chk-type = 0
     4500           and buf_inkas-pay-wth.cashier = 0
     4501       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4502       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     4503       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     4504       :
     4505         if buf_inkas-pay-wth.pay-code = 0
     4506         and buf_inkas-pay-wth.curr-code = 0 then next.
     4507         create buf_libthpos_cash-counter.
     4508         buffer-copy buf_inkas-pay-wth to buf_libthpos_cash-counter
     4509         .
     4510         find first buf_cash-pay no-lock where
     4511                 buf_cash-pay.cdpay-code = buf_inkas-pay-wth.pay-code
     4512             and buf_cash-pay.curr-code = buf_inkas-pay-wth.curr-code .
     4513         if buf_cash-pay.is-cash then do:
     4514           assign
     4515           v-cash-counter = v-cash-counter + ( if buf_libthpos_context.r-b = 'rubl':U
     4516                             then buf_inkas-pay-wth.tot-rubl
     4517                             else buf_inkas-pay-wth.tot-base)
     4518           buf_libthpos_cash-counter.is-cash = yes
     4519           .
     4520         end.
     4521       end.
     4522       find first buf_libthpos_cash-desk-attr no-lock where
     4523                 buf_libthpos_cash-desk-attr.db-num = p-db-num
     4524             and buf_libthpos_cash-desk-attr.obj-code = p-obj-code
     4525             and buf_libthpos_cash-desk-attr.pos-type = p-pos-type
     4526             and buf_libthpos_cash-desk-attr.cash-num = p-cash-num
     4527             and buf_libthpos_cash-desk-attr.upper-attr-code = 'IBS-TH_main':U
     4528             and buf_libthpos_cash-desk-attr.attr-code = 'manual-discnt':U no-error.
     4529         .
     4530       assign
     4531       v-manual-discnt = (if available buf_libthpos_cash-desk-attr
     4532                 then buf_libthpos_cash-desk-attr.attr-value-integer
     4533                 else 0)
     4534       .
     4535       v-pos-type-for-discnt = 'IBS-TH':U.
     4536     end.
     4537     find first buf_libthpos_cash-desk-attr no-lock where
     4538               buf_libthpos_cash-desk-attr.db-num = p-db-num
     4539           and buf_libthpos_cash-desk-attr.obj-code = p-obj-code
     4540           and buf_libthpos_cash-desk-attr.pos-type = p-pos-type
     4541           and buf_libthpos_cash-desk-attr.cash-num = p-cash-num
     4542           and buf_libthpos_cash-desk-attr.upper-attr-code = (if p-pos-type = 'IBS-TH':U
     4543                                                              then 'IBS-TH_main':U
     4544                                                              else 'IBS-TH-MOB_main':U)
     4545           and buf_libthpos_cash-desk-attr.attr-code = (if p-pos-type = 'IBS-TH':U
     4546                                                       then 'salesman-mandatory':U
     4547                                                       else 'salesman-mandatory':U)  no-error.
     4548        .
     4549     assign
     4550     v-salesman-mandatory = (if available buf_libthpos_cash-desk-attr
     4551               then buf_libthpos_cash-desk-attr.attr-value-integer
     4552               else 0)
     4553     .
     4554     if p-pos-type = 'IBS-TH-MOB':U then do:
     4555       find first buf_libthpos_cash-desk-attr no-lock where
     4556                 buf_libthpos_cash-desk-attr.db-num = p-db-num
     4557             and buf_libthpos_cash-desk-attr.obj-code = p-obj-code
     4558             and buf_libthpos_cash-desk-attr.pos-type = p-pos-type
     4559             and buf_libthpos_cash-desk-attr.cash-num = p-cash-num
     4560             and buf_libthpos_cash-desk-attr.upper-attr-code = 'IBS-TH-MOB_main':U
     4561             and buf_libthpos_cash-desk-attr.attr-code = 'pos-type-for-discnt':U  no-error.
     4562       assign
     4563       v-pos-type-for-discnt = (if available buf_libthpos_cash-desk-attr
     4564                 then buf_libthpos_cash-desk-attr.attr-value-character
     4565                 else 'IBS-TH-MOB':U)
     4566       .
     4567     end.
     4568     find first buf_libthpos_cash-desk-attr no-lock where
     4569               buf_libthpos_cash-desk-attr.db-num = p-db-num
     4570           and buf_libthpos_cash-desk-attr.obj-code = p-obj-code
     4571           and buf_libthpos_cash-desk-attr.pos-type = p-pos-type
     4572           and buf_libthpos_cash-desk-attr.cash-num = p-cash-num
     4573           and buf_libthpos_cash-desk-attr.upper-attr-code = 'IBS-TH_main':U
     4574           and buf_libthpos_cash-desk-attr.attr-code = 'log-level':U no-error.
     4575      assign
     4576      v-log-level = (if available buf_libthpos_cash-desk-attr
     4577                    then buf_libthpos_cash-desk-attr.attr-value-integer
     4578                    else 0).
     4579     find first buf_libthpos_cash-desk-attr no-lock where
     4580               buf_libthpos_cash-desk-attr.db-num = p-db-num
     4581           and buf_libthpos_cash-desk-attr.obj-code = p-obj-code
     4582           and buf_libthpos_cash-desk-attr.pos-type = p-pos-type
     4583           and buf_libthpos_cash-desk-attr.cash-num = p-cash-num
     4584           and buf_libthpos_cash-desk-attr.upper-attr-code = 'IBS-TH_main':U
     4585           and buf_libthpos_cash-desk-attr.attr-code = 'qnty-change':U no-error.
     4586      assign
     4587      v-qnty-change = (if available buf_libthpos_cash-desk-attr
     4588                    then logical(buf_libthpos_cash-desk-attr.attr-value-integer)
     4589                    else no).
     4590     if p-pos-type = 'IBS-TH':U then do:
     4591       assign
     4592       v-prop-code = 'chk-doc_ibs-th':U
     4593       .
     4594     end.
     4595     if p-pos-type = 'IBS-TH-MOB':U then do:
     4596       assign
     4597       v-prop-code = 'chk-doc_ibs-th-mob':U
     4598       .
     4599     end.
     4600     find first buf_thbj-attr share-lock where
     4601               buf_thbj-attr.obj-type = 'маг':U
     4602           and buf_thbj-attr.obj-code = p-obj-code
     4603           and buf_thbj-attr.upper-prop-code = 'rum_obj':U
     4604           and buf_thbj-attr.prop-code = v-prop-code
     4605           and buf_thbj-attr.property-value-logical = yes
     4606           no-error.
     4607     if not available buf_thbj-attr then do:
     4608       find first buf_thbj-attr share-lock where
     4609                 buf_thbj-attr.obj-type = ''
     4610             and buf_thbj-attr.obj-code = 0
     4611             and buf_thbj-attr.upper-prop-code = 'rum':U
     4612             and buf_thbj-attr.prop-code = v-prop-code
     4613             no-error.
     4614     end.
     4615     if available buf_thbj-attr then do:
     4616       run gen-key-rec in this-procedure (
     4617                                             input  'thbj-attr':U
     4618                                            ,input (buffer buf_thbj-attr:handle)
     4619                                            ,output v-call-id) .
     4620       for each buf_rp-by-call no-lock where
     4621               buf_rp-by-call.call_id = v-call-id
     4622       break
     4623       by buf_rp-by-call.profile_id
     4624       by buf_rp-by-call.once-more
     4625       on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4626       on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     4627       on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     4628       :
     4629         create buf_libthpos_rp-by-call.
     4630         assign
     4631         buf_libthpos_rp-by-call.profile_id = buf_rp-by-call.profile_id
     4632         buf_libthpos_rp-by-call.once-more = buf_rp-by-call.once-more
     4633         buf_libthpos_rp-by-call.call_id = buf_rp-by-call.call_id
     4634         v-bh[1] = (buffer buf_libthpos_context:handle)
     4635         .
     4636         run value( substitute("rul/rp-&1.p"
     4637                               , buf_libthpos_rp-by-call.profile_id))
     4638               persistent set buf_libthpos_rp-by-call.rph
     4639                   (
     4640                     input p-parparentproc
     4641                     ,input this-procedure:handle
     4642                     ,input p-log-handle
     4643                     ,input ?
     4644                     ,input v-call-id
     4645                     ,input buf_libthpos_rp-by-call.profile_id
     4646                     ,input buf_libthpos_rp-by-call.once-more
     4647                     ,input buf_libthpos_context.host-code
     4648                     ,input buf_libthpos_context.obj-type
     4649                     ,input buf_libthpos_context.obj-code
     4650                     ,input p-pos-type
     4651                     ,input v-pos-type-for-discnt
     4652                     ,input buf_libthpos_context.p-log-file-name
     4653                     ,input (buffer libthpos_flddf:handle)
     4654                     ,input v-bh
     4655                   ) no-error
     4656                   .
     4657         if error-status :error then do:
     4658           run libthpos_clear-context in this-procedure no-error.
     4659           undo main-block, return error substitute("Ошибка при загрузке процедуры расчета скидок/бонусов для профайла &1", buf_rp-by-call.profile_id).
     4660         end.
     4661       end.
     4662     end.
     4663     assign
     4664     buf_libthpos_context.parparentproc = p-parparentproc
     4665     buf_libthpos_context.p-log-handle = p-log-handle
     4666     buf_libthpos_context.tt-wd-bh = (buffer libthpos_chk-discnt:handle)
     4667     buf_libthpos_context.process-sale = v-process-sale
     4668     buf_libthpos_context.pos-type = p-pos-type
     4669     buf_libthpos_context.cash-num = p-cash-num
     4670     buf_libthpos_context.nalc = v-nalc
     4671     buf_libthpos_context.rmethod-type = v-rmethod-type
     4672     buf_libthpos_context.rmethod-coeff = v-rmethod-coeff
     4673     buf_libthpos_context.nam-artc   = v-nam-artc
     4674     buf_libthpos_context.nam-2str   = v-nam-2str
     4675     buf_libthpos_context.cod-pcod   = v-cod-pcod
     4676     buf_libthpos_context.name-2cd   = v-name-2cd
     4677     buf_libthpos_context.cash-counter = v-cash-counter
     4678     buf_libthpos_context.salesman-mandatory = v-salesman-mandatory
     4679     buf_libthpos_context.manual-discnt = v-manual-discnt
     4680     buf_libthpos_context.log-level = v-log-level
     4681     buf_libthpos_context.qnty-change = v-qnty-change
     4682     buf_libthpos_context.pos-type-for-discnt = v-pos-type-for-discnt
     4683     buf_libthpos_context.chk-discnt-table = (buffer libthpos_chk-discnt:handle:table-handle)
     4684     buf_libthpos_context.chk-gds-table = (buffer libthpos_chk-gds:handle:table-handle)
     4685     buf_libthpos_context.chk-pay-table = (buffer libthpos_chk-pay:handle:table-handle)
     4686     p-r-b = buf_libthpos_context.r-b
     4687     p-base-code = buf_libthpos_context.base-code
     4688     buf_libthpos_context.serial-code = buf_cash-desk.serial-code
     4689     p-serial-code = buf_cash-desk.serial-code
     4690     .
     4691   end.
     4692   end procedure.
     4693   procedure libthpos_get-context-property :
     4694   define input parameter p-what-context as integer no-undo .
     4695   define input parameter p-property as character no-undo .
     4696   define output parameter p-character as character no-undo .
     4697   define output parameter p-date as date no-undo .
     4698   define output parameter p-decimal as decimal no-undo .
     4699   define output parameter p-integer as integer no-undo .
     4700   define output parameter p-logical as logical no-undo .
     4701   define output parameter p-handle as handle no-undo .
     4702   define output parameter p-data-type as character no-undo .
     4703   define output parameter p-setted as logical no-undo .
     4704   define variable v-fh as handle no-undo .
     4705   main-block:
     4706   do
     4707   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4708   :
     4709     find first libthpos_context no-error.
     4710     if not available libthpos_context then do:
     4711       undo main-block, return error substitute("Не выставлен контекст работы").
     4712     end.
     4713     if p-what-context = 2 then do:
     4714       if not available libthpos_chk-context then do:
     4715         find first libthpos_chk-context no-error.
     4716       end.
     4717       if not available libthpos_chk-context then do:
     4718         undo main-block, return error substitute("Не выставлен контекст чека").
     4719       end.
     4720     end.
     4721     case p-what-context:
     4722       when 1 then do:
     4723         assign
     4724         v-fh = buffer libthpos_context:buffer-field(p-property) no-error.
     4725         if error-status:error then do:
     4726           undo main-block , return error substitute("Неверное запрошенное свойство контекста работы =&1", p-property).
     4727         end.
     4728       end.
     4729       when 2 then do:
     4730         assign
     4731         v-fh = buffer libthpos_chk-context:buffer-field(p-property) no-error.
     4732         if error-status:error then do:
     4733           undo main-block , return error substitute("Неверное запрошенное свойство контекста чека =&1", p-property).
     4734         end.
     4735       end.
     4736     end case.
     4737     assign
     4738     p-data-type = v-fh:data-type.
     4739     case p-data-type:
     4740       when 'character':U then do:
     4741         assign
     4742         p-character = v-fh:buffer-value
     4743         .
     4744       end.
     4745       when 'date':U then do:
     4746         assign
     4747         p-date = v-fh:buffer-value
     4748         .
     4749       end.
     4750       when 'decimal':U then do:
     4751         assign
     4752         p-decimal = v-fh:buffer-value
     4753         .
     4754       end.
     4755       when 'integer':U then do:
     4756         assign
     4757         p-integer = v-fh:buffer-value
     4758         .
     4759       end.
     4760       when 'logical':U then do:
     4761         assign
     4762         p-logical = v-fh:buffer-value
     4763         .
     4764       end.
     4765       when 'handle':U then do:
     4766         assign
     4767         p-handle = v-fh:buffer-value
     4768         .
     4769       end.
     4770       otherwise do:
     4771         undo main-block, return error substitute("Неверный или неизвестный тип данных для свойства &1 = &2"
     4772                                                  , v-fh:data-type
     4773                                                  , p-property).
     4774       end.
     4775     end case.
     4776     p-setted = yes.
     4777   end.
     4778   end procedure.
     4779   procedure libthpos_set-context-property :
     4780   define input parameter p-what-context as integer no-undo .
     4781   define input parameter p-property as character no-undo .
     4782   define input parameter p-character as character no-undo .
     4783   define input parameter p-date as date no-undo .
     4784   define input parameter p-decimal as decimal no-undo .
     4785   define input parameter p-integer as integer no-undo .
     4786   define input parameter p-logical as logical no-undo .
     4787   define input parameter p-handle as handle no-undo .
     4788   define output parameter p-setted as logical no-undo .
     4789   define variable v-fh as handle no-undo .
     4790   define variable v-data-type as character no-undo .
     4791   main-block:
     4792   do
     4793   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4794   :
     4795     find first libthpos_context no-error.
     4796     if not available libthpos_context then do:
     4797       undo main-block, return error substitute("Не выставлен контекст работы").
     4798     end.
     4799     if p-what-context = 2 then do:
     4800       if not available libthpos_chk-context then do:
     4801         find first libthpos_chk-context no-error.
     4802       end.
     4803       if not available libthpos_chk-context then do:
     4804         undo main-block, return error substitute("Не выставлен контекст чека").
     4805       end.
     4806     end.
     4807     case p-what-context:
     4808       when 1 then do:
     4809         assign
     4810         v-fh = buffer libthpos_context:buffer-field(p-property) no-error.
     4811         if error-status:error then do:
     4812           undo main-block , return error substitute("Неверное запрошенное свойство контекста работы =&1", p-property).
     4813         end.
     4814         if lookup(p-property, "p-log-handle,p-log-file-name,z-number,emulator-mode") = 0 then do:
     4815            undo main-block , return error substitute("Запрошенное свойство контекста работы =&1 является READ-ONLY", p-property).
     4816         end.
     4817       end.
     4818       when 2 then do:
     4819         assign
     4820         v-fh = buffer libthpos_chk-context:buffer-field(p-property) no-error.
     4821         if error-status:error then do:
     4822           undo main-block , return error substitute("Неверное запрошенное свойство контекста чека =&1", p-property).
     4823         end.
     4824         if lookup(p-property, "xxx") = 0 then do:
     4825           undo main-block , return error substitute("Запрошенное свойство контекста чека =&1 является READ-ONLY", p-property).
     4826         end.
     4827       end.
     4828     end case.
     4829     assign
     4830     v-data-type = v-fh:data-type.
     4831     case v-data-type:
     4832       when 'character':U then do:
     4833         assign
     4834         v-fh:buffer-value = p-character
     4835         .
     4836       end.
     4837       when 'date':U then do:
     4838         assign
     4839         v-fh:buffer-value = p-date
     4840         .
     4841       end.
     4842       when 'decimal':U then do:
     4843         assign
     4844         v-fh:buffer-value = p-decimal
     4845         .
     4846       end.
     4847       when 'integer':U then do:
     4848         assign
     4849         v-fh:buffer-value = p-integer
     4850         .
     4851       end.
     4852       when 'logical':U then do:
     4853         assign
     4854         v-fh:buffer-value =  p-logical
     4855         .
     4856       end.
     4857       when 'handle':U then do:
     4858         assign
     4859         v-fh:buffer-value = p-handle
     4860         .
     4861       end.
     4862       otherwise do:
     4863         undo main-block, return error substitute("Неверный или неизвестный тип данных для свойства &1 = &2"
     4864                                                  , v-fh:data-type
     4865                                                  , p-property).
     4866       end.
     4867     end case.
     4868     p-setted = yes.
     4869   end.
     4870   end procedure.
     4871   procedure libthpos_set-log :
     4872   define input parameter p-log-handle as handle no-undo .
     4873   define buffer buf_libthpos_rp-by-call for libthpos_rp-by-call.
     4874   main-block:
     4875   do
     4876   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4877   :
     4878     find first libthpos_context no-error.
     4879     if not available libthpos_context then do:
     4880       undo main-block, return error substitute("Не выставлен контекст работы").
     4881     end.
     4882     if not valid-handle(p-log-handle) then do:
     4883       undo main-block, return error substitute("Неверный указатель на процедуру логирования").
     4884     end.
     4885     for each buf_libthpos_rp-by-call
     4886     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4887     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
     4888     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
     4889     :
     4890       run rp-chk-doc_set-log in buf_libthpos_rp-by-call.rph no-error.
     4891     end.
     4892     assign
     4893     libthpos_context.p-log-handle = p-log-handle
     4894     .
     4895   end.
     4896   end procedure.
     4897   procedure libthpos_create-chk-doc :
     4898   define input parameter p-db-num   as integer no-undo .
     4899   define input parameter p-obj-code as integer no-undo .
     4900   define input parameter p-pos-type as character no-undo .
     4901   define input parameter p-cash-num as integer no-undo .
     4902   define input parameter p-chk-type as integer no-undo .
     4903   define input parameter p-cashier  as integer no-undo .
     4904   define input parameter p-cashier-psn-code as integer no-undo .
     4905   define output parameter p-doc-code as character no-undo .
     4906   define output parameter p-bank-rate as decimal no-undo .
     4907   define output parameter p-bank-scale as decimal no-undo .
     4908   define output parameter p-cash-rate as decimal no-undo .
     4909   define output parameter p-cash-scale as integer no-undo .
     4910   DEFINE VARIABLE v-today as date no-undo .
     4911   DEFINE VARIABLE v-time as integer no-undo .
     4912   define variable v-bank-rate as decimal no-undo .
     4913   define variable v-bank-scale as integer no-undo .
     4914   define variable v-bank-abbr as character no-undo .
     4915   define variable v-base-rate as decimal no-undo .
     4916   define variable v-cash-rate as decimal no-undo .
     4917   define variable v-cash-scale as integer no-undo .
     4918   define variable v-sale-in-out as logical no-undo .
     4919   define variable v-err-mess as character no-undo .
     4920   define buffer buf_staff for ub.staff.
     4921   define buffer buf_curr-shop for ub.curr-shop.
     4922   define buffer buf_chk-doc for ub.chk-doc.
     4923   main-block:
     4924   do
     4925   on error undo main-block, retry main-block
     4926   on stop undo main-block, retry main-block
     4927   on endkey undo main-block, retry main-block
     4928   :
     4929     if retry then do:
     4930       if v-err-mess = '' then do:
     4931         v-err-mess = substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     4932       end.
     4933       dataset libthpos_receipt:reject-changes.
     4934       return error v-err-mess.
     4935     end.
     4936     else do:
     4937       if (lookup(string(p-chk-type), '1,6,8,69,96,14,15,16,36,17,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,43,44':U) = 0 and lookup(string(p-chk-type), '201,206,208,301,306':U) = 0)
     4938       or lookup(string(p-chk-type), '14,15,16,17,36':U) > 0
     4939       or lookup(string(p-chk-type), '101,106,108,169,196,114,115,116,136,117,111,112,113':U) > 0
     4940       or lookup(string(p-chk-type), '8':U) > 0
     4941       then do:
     4942         v-err-mess = substitute("Неверный тип чека = &1", p-chk-type).
     4943         undo main-block, retry main-block .
     4944       end.
     4945       if lookup(string(p-chk-type), '201,206,208,301,306':U) = 0
     4946       and p-pos-type = 'IBS-TH-MOB':U then do:
     4947         v-err-mess = substitute("Неверный тип чека = &1 для кассы типа &2", p-chk-type, p-pos-type).
     4948         undo main-block, retry main-block .
     4949       end.
     4950       if lookup(string(p-chk-type), '201,206,208,301,306':U) > 0
     4951       and p-pos-type <> 'IBS-TH-MOB':U then do:
     4952         v-err-mess = substitute("Неверный тип чека = &1 для кассы типа &2", p-chk-type, p-pos-type).
     4953         undo main-block, retry main-block .
     4954       end.
     4955       find first libthpos_context no-error.
     4956       if not available libthpos_context then do:
     4957         v-err-mess = substitute("Не выставлен контекст работы").
     4958         undo main-block, retry main-block .
     4959       end.
     4960       if libthpos_context.pos-type = 'IBS-TH':U
     4961       and lookup(string(p-chk-type), '201,206,208,301,306':U) = 0
     4962       and (libthpos_context.z-number <= 0
     4963       or libthpos_context.z-number = ?)
     4964       and libthpos_context.emulator-mode = 0
     4965       then do:
     4966         v-err-mess = substitute("Не выставлен № z-отчета").
     4967         undo main-block, retry main-block .
     4968       end.
     4969       if not (libthpos_context.db-num = p-db-num
     4970               and
     4971               libthpos_context.obj-code = p-obj-code
     4972               and
     4973               libthpos_context.pos-type = p-pos-type
     4974               and
     4975               libthpos_context.cash-num = p-cash-num) then do:
     4976         v-err-mess = substitute("Неверный контекст").
     4977         undo main-block, retry main-block .
     4978       end.
     4979       if not is-cdinv and p-chk-type = integer('11':U) then do:
     4980         v-err-mess = substitute("В данной конфигурации запрещено делать инвентаризацию на кассах").
     4981         undo main-block, retry main-block .
     4982       end.
     4983       if not is-ptrl and lookup(string(p-chk-type), '14,15,16,17,36':U) > 0
     4984       then do:
     4985         v-err-mess = substitute("В данной конфигурации запрещено делать специфические чеки топлива").
     4986         undo main-block, retry main-block .
     4987       end .
     4988       if buffer libthpos_chk-context:table-handle:tracking-changes then
     4989       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-context:table-handle)
     4990                                                       , input no).
     4991       if buffer libthpos_chk-pay:table-handle:tracking-changes then
     4992       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-pay:table-handle)
     4993                                                       , input no).
     4994       if buffer libthpos_chk-gds:table-handle:tracking-changes then
     4995       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-gds:table-handle)
     4996                                                       , input no).
     4997       if buffer libthpos_chk-discnt:table-handle:tracking-changes then
     4998       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-discnt:table-handle)
     4999                                                       , input no).
     5000       dataset libthpos_receipt:empty-dataset().
     5001       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-context:table-handle)
     5002                                                       , input yes).
     5003       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-pay:table-handle)
     5004                                                       , input yes).
     5005       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-gds:table-handle)
     5006                                                       , input yes).
     5007       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-discnt:table-handle)
     5008                                                       , input yes).
     5009       run cur-time in this-procedure ( output v-today, output v-time).
     5010       find first buf_staff no-lock where
     5011                 buf_staff.role = 'C':U
     5012           and buf_staff.role-level = 'db':U
     5013           and buf_staff.db-num = p-db-num
     5014           and buf_staff.staff-code = p-cashier
     5015           and buf_staff.date-start <= v-today
     5016           and buf_staff.date-end >= v-today
     5017           and buf_staff.psn-code = p-cashier-psn-code no-error.
     5018       if not available buf_staff then do:
     5019         v-err-mess =  substitute("На текущий момент нет кассира с кодом &1 БД &2 и кодом физ.лица &3"
     5020                                     , p-cashier
     5021                                     , p-db-num
     5022                                     , p-cashier-psn-code
     5023                                     ).
     5024         undo main-block, retry main-block.
     5025       end.
     5026       assign
     5027       v-base-rate = 1
     5028       v-cash-rate = 1
     5029       v-cash-scale = 1
     5030       v-bank-rate = 1
     5031       v-bank-scale = 1
     5032       .
     5033       if libthpos_context.r-b = 'base':U
     5034       and libthpos_context.base-code <> 0 then do:
     5035         find  LAST buf_curr-shop NO-LOCK WHERE
     5036                       buf_curr-shop.obj-type = 'маг':U
     5037                   AND buf_curr-shop.obj-code = p-obj-code
     5038                   AND buf_curr-shop.curr-code = libthpos_context.base-code
     5039                   AND ( ( buf_curr-shop.exch-date = v-today
     5040                         AND
     5041                         buf_curr-shop.exch-time <= v-time ) OR
     5042                         buf_curr-shop.exch-date < v-today ) NO-ERROR .
     5043         if available buf_curr-shop then do:
     5044           assign
     5045           v-cash-rate = buf_curr-shop.exch-rate
     5046           v-cash-scale = buf_curr-shop.exch-scale
     5047           v-base-rate = buf_curr-shop.exch-rate / buf_curr-shop.exch-scale
     5048           .
     5049         end.
     5050         else do:
     5051           v-err-mess =  substitute(
     5052                                         "Нет магазинного курса базовой валюты для &1&2 на дату &3"
     5053                                         , 'маг':U
     5054                                         , p-obj-code
     5055                                         , v-today
     5056                                       ).
     5057           undo main-block, retry main-block.
     5058         end.
     5059   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5060   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     5061     (input  libthpos_context.base-code
     5062     ,input  v-today
     5063     ,output v-bank-rate
     5064     ,output v-bank-scale
     5065     ,output v-bank-abbr
     5066     )  .
     5067       end.
     5068       if libthpos_context.r-b = 'rubl':U
     5069       and libthpos_context.base-code <> 0 then do:
     5070         FIND LAST buf_curr-shop NO-LOCK WHERE
     5071                   buf_curr-shop.obj-type = 'маг':U
     5072               AND buf_curr-shop.obj-code = p-obj-code
     5073               AND buf_curr-shop.curr-code = libthpos_context.base-code
     5074               AND ( ( buf_curr-shop.exch-date = v-today
     5075                       AND
     5076                       buf_curr-shop.exch-time <= v-time ) OR
     5077                       buf_curr-shop.exch-date < v-today ) NO-ERROR .
     5078         if available buf_curr-shop then do:
     5079           assign
     5080           v-base-rate = buf_curr-shop.exch-rate / buf_curr-shop.exch-scale
     5081           .
     5082         end.
     5083         else do:
     5084           v-err-mess =  substitute(
     5085                                         "Нет магазинного курса базовой валюты для &1&2 на дату &3"
     5086                                         , 'маг':U
     5087                                         , p-obj-code
     5088                                         , v-today
     5089                                       ).
     5090           undo main-block, retry main-block.
     5091         end.
     5092   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5093   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     5094     (input  libthpos_context.base-code
     5095     ,input  v-today
     5096     ,output v-bank-rate
     5097     ,output v-bank-scale
     5098     ,output v-bank-abbr
     5099     )  .
     5100       end.
     5101       if lookup(string(p-chk-type), '6,96':U) > 0
     5102       or  lookup(string(p-chk-type), '1,69,14,15,16,36':U) > 0 then do:
     5103         assign
     5104         v-sale-in-out = yes
     5105         .
     5106       end.
     5107       create buf_chk-doc.
     5108       create libthpos_chk-context.
     5109       assign
     5110       buf_chk-doc.obj-type = 'маг':U
     5111       buf_chk-doc.obj-code = p-obj-code
     5112       buf_chk-doc.office = ?
     5113       buf_chk-doc.doc-code = (if p-db-num = 0
     5114                               then string(next-value(s-chk, ub ))
     5115                               else string( p-obj-code ) + chr(47) + string( next-value( s-chk, ub ) ))
     5116       loc-print-doc-code = buf_chk-doc.doc-code
     5117       buf_chk-doc.chk-id = buf_chk-doc.doc-code
     5118       buf_chk-doc.chk-date = v-today
     5119       buf_chk-doc.chk-time = v-time
     5120       buf_chk-doc.pay-desk = p-cash-num
     5121       buf_chk-doc.cashier  = p-cashier
     5122       buf_chk-doc.cashier-psn-code  = p-cashier-psn-code
     5123       buf_chk-doc.src-d-card =  ''
     5124       buf_chk-doc.d-card =  ''
     5125       buf_chk-doc.src-d-pcnt =  0
     5126       buf_chk-doc.src-cli-type = ?
     5127       buf_chk-doc.src-cli-code = 0
     5128       buf_chk-doc.src-shift-date = v-today
     5129       buf_chk-doc.src-shift-name = ''
     5130       buf_chk-doc.shift-name = ''
     5131       buf_chk-doc.shift-num = 0
     5132       buf_chk-doc.cash-rate = v-cash-rate
     5133       buf_chk-doc.cash-scale = v-cash-scale
     5134       buf_chk-doc.base-rate = v-base-rate
     5135       buf_chk-doc.z-number = libthpos_context.z-number
     5136       buf_chk-doc.chk-type = p-chk-type
     5137       buf_chk-doc.correct = yes
     5138       buf_chk-doc.discnt = 0
     5139       buf_chk-doc.sales-man = libthpos_context.sales-man
     5140       buf_chk-doc.salesman-psn-code = libthpos_context.salesman-psn-code
     5141       buf_chk-doc.src-tot-doc = 0
     5142       buf_chk-doc.netto = 0
     5143       buf_chk-doc.tot-doc = 0
     5144       buf_chk-doc.discnt = 0
     5145       buf_chk-doc.sub-discnt = 0
     5146       buf_chk-doc.doc-qnty = 0
     5147       libthpos_chk-context.doc-code = buf_chk-doc.doc-code
     5148       libthpos_chk-context.obj-code = buf_chk-doc.obj-code
     5149       libthpos_chk-context.chk-type = buf_chk-doc.chk-type
     5150       libthpos_chk-context.lng = 0
     5151       libthpos_chk-context.recalc-gline-num = libthpos_chk-context.lng + 1
     5152       libthpos_chk-context.lnp = 0
     5153       libthpos_chk-context.recalc-pline-num = libthpos_chk-context.lnp + 1
     5154       libthpos_chk-context.lnd = 0
     5155       libthpos_chk-context.chk-date = v-today
     5156       libthpos_chk-context.chk-time = v-time
     5157       libthpos_chk-context.base-rate = v-base-rate
     5158       libthpos_chk-context.cash-rate = v-cash-rate
     5159       libthpos_chk-context.cash-scale = v-cash-scale
     5160       libthpos_chk-context.bank-rate = v-bank-rate
     5161       libthpos_chk-context.bank-scale = v-bank-scale
     5162       libthpos_chk-context.a-chk-date = v-today
     5163       libthpos_chk-context.a-chk-time = v-time
     5164       libthpos_chk-context.a-base-rate = v-base-rate
     5165       libthpos_chk-context.a-cash-rate = v-cash-rate
     5166       libthpos_chk-context.a-cash-scale = v-cash-scale
     5167       libthpos_chk-context.a-bank-rate = v-bank-rate
     5168       libthpos_chk-context.a-bank-scale = v-bank-scale
     5169       libthpos_chk-context.is-petrol-check = lookup(string(p-chk-type), '14,15,16,17,36':U) > 0
     5170       libthpos_chk-context.rowid_ = rowid(buf_chk-doc)
     5171       libthpos_chk-context.sale-in-out = v-sale-in-out
     5172       p-doc-code = buf_chk-doc.doc-code
     5173       p-bank-rate = v-bank-rate
     5174       p-bank-scale = v-bank-scale
     5175       p-cash-rate = v-cash-rate
     5176       p-cash-scale = v-cash-scale
     5177       .
     5178   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5179   if (valid-handle(g#libchkvl) <> true) then do:   run str/libchkvl.p persistent no-error .   if error-status :error or (valid-handle(g#libchkvl) <> true) then do:     message       "Error starting nws/libchkvl.p" skip       g#libchkvl skip       g#libchkvl :type skip       g#libchkvl :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     5180     libthpos_chk-context.direction = libchkvl_right-netto-sign (
     5181                                     input  libthpos_chk-context.chk-type
     5182                                     )
     5183    .
     5184       create libthpos_chk-doc.
     5185       buffer-copy buf_Chk-doc to libthpos_chk-doc.
     5186       find first locked_chk-doc share-lock where
     5187                 rowid(locked_chk-doc) = rowid(buf_chk-doc).
     5188       libthpos_context.ll = libthpos_context.ll + 1.
     5189       dataset libthpos_receipt:accept-changes.
     5190     end.
     5191   end.
     5192   end procedure.
     5193   procedure libthpos_create-chk-title :
     5194   define input parameter p-db-num   as integer no-undo .
     5195   define input parameter p-obj-code as integer no-undo .
     5196   define input parameter p-pos-type as character no-undo .
     5197   define input parameter p-cash-num as integer no-undo .
     5198   define input parameter p-chk-type as integer no-undo .
     5199   define input parameter p-cashier  as integer no-undo .
     5200   define input parameter p-cashier-psn-code as integer no-undo .
     5201   define output parameter p-doc-code as character no-undo .
     5202   define output parameter p-bank-rate as decimal no-undo .
     5203   define output parameter p-bank-scale as decimal no-undo .
     5204   define output parameter p-cash-rate as decimal no-undo .
     5205   define output parameter p-cash-scale as integer no-undo .
     5206   DEFINE VARIABLE v-today as date no-undo .
     5207   DEFINE VARIABLE v-time as integer no-undo .
     5208   define variable v-bank-rate as decimal no-undo .
     5209   define variable v-bank-scale as integer no-undo .
     5210   define variable v-bank-abbr as character no-undo .
     5211   define variable v-base-rate as decimal no-undo .
     5212   define variable v-cash-rate as decimal no-undo .
     5213   define variable v-cash-scale as integer no-undo .
     5214   define variable v-sale-in-out as logical no-undo .
     5215   define variable v-err-mess as character no-undo .
     5216   define buffer buf_staff for ub.staff.
     5217   define buffer buf_curr-shop for ub.curr-shop.
     5218   define buffer buf_chk-doc for ub.chk-doc.
     5219   main-block:
     5220   do
     5221   on error undo main-block, retry main-block
     5222   on stop undo main-block, retry main-block
     5223   on endkey undo main-block, retry main-block
     5224   :
     5225     if retry then do:
     5226       if v-err-mess = '' then do:
     5227         v-err-mess = substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     5228       end.
     5229       dataset libthpos_receipt:reject-changes.
     5230       return error v-err-mess.
     5231     end.
     5232     else do:
     5233       if lookup(string(p-chk-type), '2,3,4,5,7':U) = 0
     5234       then do:
     5235         v-err-mess = substitute("Неверный тип чека МЦ = &1", p-chk-type).
     5236         undo main-block, retry main-block.
     5237       end.
     5238       if p-pos-type = 'IBS-TH-MOB':U then do:
     5239         v-err-mess = substitute("Неверный тип кассы = &2", p-pos-type).
     5240         undo main-block, retry main-block.
     5241       end.
     5242       find first libthpos_context no-error.
     5243       if not available libthpos_context then do:
     5244         v-err-mess = substitute("Не выставлен контекст работы").
     5245         undo main-block, retry main-block.
     5246       end.
     5247       if not (libthpos_context.db-num = p-db-num
     5248               and
     5249               libthpos_context.obj-code = p-obj-code
     5250               and
     5251               libthpos_context.pos-type = p-pos-type
     5252               and
     5253               libthpos_context.cash-num = p-cash-num) then do:
     5254         v-err-mess = substitute("Неверный контекст").
     5255         undo main-block, retry main-block.
     5256       end.
     5257       if buffer libthpos_chk-context:table-handle:tracking-changes then
     5258       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-context:table-handle)
     5259                                                       , input no).
     5260       if buffer libthpos_chk-pay:table-handle:tracking-changes then
     5261       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-pay:table-handle)
     5262                                                       , input no).
     5263       if buffer libthpos_chk-gds:table-handle:tracking-changes then
     5264       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-gds:table-handle)
     5265                                                       , input no).
     5266       if buffer libthpos_chk-discnt:table-handle:tracking-changes then
     5267       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-discnt:table-handle)
     5268                                                       , input no).
     5269       dataset libthpos_receipt:empty-dataset().
     5270       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-context:table-handle)
     5271                                                       , input yes).
     5272       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-pay:table-handle)
     5273                                                       , input yes).
     5274       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-gds:table-handle)
     5275                                                       ,  input yes).
     5276       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-discnt:table-handle)
     5277                                                       , input yes).
     5278       run cur-time in this-procedure ( output v-today, output v-time).
     5279       find first buf_staff no-lock where
     5280                 buf_staff.role = 'C':U
     5281           and buf_staff.role-level = 'db':U
     5282           and buf_staff.db-num = p-db-num
     5283           and buf_staff.staff-code = p-cashier
     5284           and buf_staff.date-start <= v-today
     5285           and buf_staff.date-end >= v-today
     5286           and buf_staff.psn-code = p-cashier-psn-code no-error.
     5287       if not available buf_staff then do:
     5288         v-err-mess = substitute("На текущий момент нет кассира с кодом &1 БД &2 и кодом физ.лица &3"
     5289                                     , p-cashier
     5290                                     , p-db-num
     5291                                     , p-cashier-psn-code
     5292                                     ).
     5293         undo main-block, retry main-block.
     5294       end.
     5295       assign
     5296       v-base-rate = 1
     5297       v-cash-rate = 1
     5298       v-cash-scale = 1
     5299       v-bank-rate = 1
     5300       v-bank-scale = 1
     5301       .
     5302       if libthpos_context.r-b = 'base':U
     5303       and libthpos_context.base-code <> 0 then do:
     5304         find  LAST buf_curr-shop NO-LOCK WHERE
     5305                       buf_curr-shop.obj-type = 'маг':U
     5306                   AND buf_curr-shop.obj-code = p-obj-code
     5307                   AND buf_curr-shop.curr-code = libthpos_context.base-code
     5308                   AND ( ( buf_curr-shop.exch-date = v-today
     5309                         AND
     5310                         buf_curr-shop.exch-time <= v-time ) OR
     5311                         buf_curr-shop.exch-date < v-today ) NO-ERROR .
     5312         if available buf_curr-shop then do:
     5313           assign
     5314           v-cash-rate = buf_curr-shop.exch-rate
     5315           v-cash-scale = buf_curr-shop.exch-scale
     5316           v-base-rate = buf_curr-shop.exch-rate / buf_curr-shop.exch-scale
     5317           .
     5318         end.
     5319         else do:
     5320           v-err-mess = substitute(
     5321                                         "Нет магазинного курса базовой валюты для &1&2 на дату &3"
     5322                                         , 'маг':U
     5323                                         , p-obj-code
     5324                                         , v-today
     5325                                       ).
     5326           undo main-block, retry main-block.
     5327         end.
     5328   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5329   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     5330     (input  libthpos_context.base-code
     5331     ,input  v-today
     5332     ,output v-bank-rate
     5333     ,output v-bank-scale
     5334     ,output v-bank-abbr
     5335     )  .
     5336       end.
     5337       if libthpos_context.r-b = 'rubl':U
     5338       and libthpos_context.base-code <> 0 then do:
     5339         FIND LAST buf_curr-shop NO-LOCK WHERE
     5340                   buf_curr-shop.obj-type = 'маг':U
     5341               AND buf_curr-shop.obj-code = p-obj-code
     5342               AND buf_curr-shop.curr-code = libthpos_context.base-code
     5343               AND ( ( buf_curr-shop.exch-date = v-today
     5344                       AND
     5345                       buf_curr-shop.exch-time <= v-time ) OR
     5346                       buf_curr-shop.exch-date < v-today ) NO-ERROR .
     5347         if available buf_curr-shop then do:
     5348           assign
     5349           v-base-rate = buf_curr-shop.exch-rate / buf_curr-shop.exch-scale
     5350           .
     5351         end.
     5352         else do:
     5353           v-err-mess = substitute(
     5354                                         "Нет магазинного курса базовой валюты для &1&2 на дату &3"
     5355                                         , 'маг':U
     5356                                         , p-obj-code
     5357                                         , v-today
     5358                                       ).
     5359           undo main-block, retry main-block.
     5360         end.
     5361   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5362   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     5363     (input  libthpos_context.base-code
     5364     ,input  v-today
     5365     ,output v-bank-rate
     5366     ,output v-bank-scale
     5367     ,output v-bank-abbr
     5368     )  .
     5369       end.
     5370       create buf_chk-doc.
     5371       create libthpos_chk-context.
     5372       assign
     5373       buf_chk-doc.obj-type = 'маг':U
     5374       buf_chk-doc.obj-code = p-obj-code
     5375       buf_chk-doc.office = ?
     5376       buf_chk-doc.doc-code = (if p-db-num = 0
     5377                               then string(next-value(s-chk, ub ))
     5378                               else string( p-obj-code ) + chr(47) + string( next-value( s-chk, ub ) ))
     5379       loc-print-doc-code = buf_chk-doc.doc-code
     5380       buf_chk-doc.chk-date = v-today
     5381       buf_chk-doc.chk-time = v-time
     5382       buf_chk-doc.pay-desk = p-cash-num
     5383       buf_chk-doc.cashier  = p-cashier
     5384       buf_chk-doc.cashier-psn-code  = p-cashier-psn-code
     5385       buf_chk-doc.d-card =  ''
     5386       buf_chk-doc.src-shift-date = v-today
     5387       buf_chk-doc.src-shift-name = ''
     5388       buf_chk-doc.shift-name = ''
     5389       buf_chk-doc.shift-num = 0
     5390       buf_chk-doc.cash-rate = v-cash-rate
     5391       buf_chk-doc.cash-scale = v-cash-scale
     5392       buf_chk-doc.base-rate = v-base-rate
     5393       buf_chk-doc.z-number = libthpos_context.z-number
     5394       buf_chk-doc.chk-type = p-chk-type
     5395       buf_chk-doc.correct = yes
     5396       buf_chk-doc.discnt = 0
     5397       buf_chk-doc.sales-man = libthpos_context.sales-man
     5398       buf_chk-doc.salesman-psn-code = libthpos_context.salesman-psn-code
     5399       libthpos_chk-context.doc-code = buf_chk-doc.doc-code
     5400       libthpos_chk-context.obj-code = buf_chk-doc.obj-code
     5401       libthpos_chk-context.chk-type = buf_chk-doc.chk-type
     5402       libthpos_chk-context.lnp = 0
     5403       libthpos_chk-context.chk-date = v-today
     5404       libthpos_chk-context.chk-time = v-time
     5405       libthpos_chk-context.base-rate = v-base-rate
     5406       libthpos_chk-context.cash-rate = v-cash-rate
     5407       libthpos_chk-context.cash-scale = v-cash-scale
     5408       libthpos_chk-context.bank-rate = v-bank-rate
     5409       libthpos_chk-context.bank-scale = v-bank-scale
     5410       libthpos_chk-context.a-chk-date = v-today
     5411       libthpos_chk-context.a-chk-time = v-time
     5412       libthpos_chk-context.a-base-rate = v-base-rate
     5413       libthpos_chk-context.a-cash-rate = v-cash-rate
     5414       libthpos_chk-context.a-cash-scale = v-cash-scale
     5415       libthpos_chk-context.a-bank-rate = v-bank-rate
     5416       libthpos_chk-context.a-bank-scale = v-bank-scale
     5417       libthpos_chk-context.rowid_ = rowid(buf_chk-doc)
     5418       p-doc-code = buf_chk-doc.doc-code
     5419       p-bank-rate = v-bank-rate
     5420       p-bank-scale = v-bank-scale
     5421       p-cash-rate = v-cash-rate
     5422       p-cash-scale = v-cash-scale
     5423       .
     5424   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5425   if (valid-handle(g#libchkvl) <> true) then do:   run str/libchkvl.p persistent no-error .   if error-status :error or (valid-handle(g#libchkvl) <> true) then do:     message       "Error starting nws/libchkvl.p" skip       g#libchkvl skip       g#libchkvl :type skip       g#libchkvl :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end.
     5426     libthpos_chk-context.direction = libchkvl_right-netto-sign (
     5427                                     input  libthpos_chk-context.chk-type
     5428                                     )
     5429    .
     5430       create libthpos_chk-doc.
     5431       buffer-copy buf_chk-doc to libthpos_chk-doc.
     5432       find first locked_chk-doc share-lock where
     5433                 rowid(locked_chk-doc) = rowid(buf_chk-doc).
     5434       libthpos_context.ll = libthpos_context.ll + 1.
     5435       dataset libthpos_receipt:accept-changes.
     5436     end.
     5437   end.
     5438   end procedure.
     5439   procedure libthpos_set-salesman :
     5440   define input parameter p-doc-code as character no-undo .
     5441   define input parameter p-line-num as integer no-undo .
     5442   define input parameter p-sales-man as integer no-undo .
     5443   define input parameter p-salesman-psn-code as integer no-undo .
     5444   define output parameter p-setted as logical no-undo .
     5445   DEFINE VARIABLE v-today as date no-undo .
     5446   DEFINE VARIABLE v-time as integer no-undo .
     5447   define variable v-err-mess as character no-undo .
     5448   define buffer buf_staff for ub.staff.
     5449   define buffer buf_chk-doc for ub.chk-doc.
     5450   define buffer buf_Chk-gds for ub.chk-gds.
     5451   define buffer buf_libthpos_chk-gds for libthpos_chk-gds.
     5452   main-block:
     5453   do
     5454   on error undo main-block, retry main-block
     5455   on stop undo main-block, retry main-block
     5456   on endkey undo main-block, retry main-block
     5457   :
     5458     if retry then do:
     5459       if v-err-mess = '' then do:
     5460         v-err-mess = substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     5461       end.
     5462       dataset libthpos_receipt:reject-changes.
     5463       return error v-err-mess.
     5464     end.
     5465     else do:
     5466       if p-doc-code <> "" then do:
     5467         if not available libthpos_chk-context then do:
     5468           find first libthpos_chk-context no-error.
     5469         end.
     5470         if not available libthpos_chk-context then do:
     5471           v-err-mess = substitute("Не выставлен контекст чека").
     5472           undo main-block, retry main-block.
     5473         end.
     5474         if libthpos_chk-context.doc-code <> p-doc-code then do:
     5475           v-err-mess = substitute("Неверный номер чека = &1", p-doc-code).
     5476           undo main-block, retry main-block.
     5477         end.
     5478         if lookup(string(libthpos_chk-context.chk-type), '2,3,4,5,7':U) > 0
     5479         or lookup(string(libthpos_chk-context.chk-type), '112':U) > 0
     5480         or lookup(string(libthpos_chk-context.chk-type), '12':U) > 0
     5481         or lookup(string(libthpos_chk-context.chk-type), '111':U) > 0
     5482         or lookup(string(libthpos_chk-context.chk-type), '11':U) > 0
     5483         then do:
     5484           v-err-mess = substitute("В чеке &1 с типом &2 продавца быть не может", p-doc-code, libthpos_chk-context.chk-type).
     5485           undo main-block, retry main-block.
     5486         end.
     5487       end.
     5488       if p-line-num <> 0  then do:
     5489         if p-doc-code = ""
     5490         then do:
     5491           v-err-mess = substitute("Задана строк чека (=&1) для установки продавца, но не задан номер чека", p-line-num).
     5492           undo main-block, retry main-block.
     5493         end.
     5494         if libthpos_chk-context.lng < p-line-num then do:
     5495           v-err-mess = substitute("В чеке &1 на строки &2"
     5496                                         , p-doc-code
     5497                                         , p-line-num).
     5498           undo main-block, retry main-block.
     5499         end.
     5500       end.
     5501       if p-sales-man <> 0 then do:
     5502         run cur-time in this-procedure ( output v-today, output v-time).
     5503         find first buf_staff no-lock where
     5504                   buf_staff.role = 'S':U
     5505             and buf_staff.role-level = 'db':U
     5506             and buf_staff.db-num = libthpos_context.db-num
     5507             and buf_staff.staff-code = p-sales-man
     5508             and buf_staff.date-start <= v-today
     5509             and buf_staff.date-end >= v-today
     5510             and buf_staff.psn-code = p-salesman-psn-code no-error.
     5511         if not available buf_staff then do:
     5512           v-err-mess = substitute("На текущий момент нет продавца с кодом &1 БД &2 и кодом физ.лица &3"
     5513                                       , p-sales-man
     5514                                       , libthpos_context.db-num
     5515                                       , p-salesman-psn-code
     5516                                       ).
     5517           undo main-block, retry main-block.
     5518         end.
     5519       end.
     5520       if p-doc-code = "" then do:
     5521         assign
     5522         libthpos_context.sales-man = p-sales-man
     5523         libthpos_context.salesman-psn-code = (if p-sales-man = 0 then 0 else p-salesman-psn-code)
     5524         .
     5525       end.
     5526       else do:
     5527         assign
     5528         libthpos_chk-context.sales-man = p-sales-man
     5529         libthpos_chk-context.salesman-psn-code = (if p-sales-man = 0 then 0 else p-salesman-psn-code)
     5530         .
     5531         find first buf_chk-doc where
     5532                   buf_chk-doc.doc-code = p-doc-code.
     5533         assign
     5534         buf_chk-doc.sales-man = p-sales-man
     5535         buf_chk-doc.salesman-psn-code = p-salesman-psn-code
     5536         .
     5537         if p-line-num > 0 then do:
     5538           for first buf_chk-gds share-lock where
     5539                   buf_chk-gds.doc-code = p-doc-code
     5540               and buf_chk-gds.line-num = p-line-num,
     5541               first buf_libthpos_chk-gds where
     5542                     buf_libthpos_chk-gds.doc-code = p-doc-code
     5543                 and buf_libthpos_chk-gds.line-num = p-line-num
     5544           on error  undo main-block, retry main-block
     5545           on stop   undo main-block, retry main-block
     5546           :
     5547             assign
     5548             buf_chk-gds.sales-man = p-sales-man
     5549             buf_chk-gds.salesman-psn-code = p-salesman-psn-code
     5550             buf_libthpos_chk-gds.sales-man = p-sales-man
     5551             buf_libthpos_chk-gds.salesman-psn-code = p-salesman-psn-code
     5552             .
     5553           end.
     5554         end.
     5555       end.
     5556       dataset libthpos_receipt:accept-changes.
     5557       p-setted = yes.
     5558     end.
     5559   end.
     5560   end procedure.
     5561   procedure libthpos_set-card :
     5562   define input parameter p-doc-code as character no-undo .
     5563   define input parameter p-src-d-card as character no-undo .
     5564   define output parameter p-d-card as character no-undo .
     5565   define output parameter p-cli-type as character no-undo .
     5566   define output parameter p-cli-code as integer no-undo .
     5567   define output parameter p-obj-name as character no-undo .
     5568   define variable v-found as logical no-undo .
     5569   define variable v-descr as character no-undo .
     5570   define variable v-short-number as character no-undo .
     5571   define variable v-is-correct as logical no-undo .
     5572   define variable v-d-mask as character no-undo .
     5573   define variable v-d-card as character no-undo .
     5574   define variable v-th-mask as logical no-undo .
     5575   DEFINE VARIABLE v-today as date no-undo .
     5576   DEFINE VARIABLE v-time as integer no-undo .
     5577   define variable v-err-mess as character no-undo .
     5578   define buffer buf_dis-card for ub.dis-card.
     5579   define buffer buf_dis-card-type for ub.dis-card-type.
     5580   define buffer buf_libthpos_dis-card-mask for libthpos_dis-card-mask.
     5581   define buffer buf_chk-doc for ub.chk-doc.
     5582   define buffer buf_chk-gds for ub.chk-gds.
     5583   define buffer buf_chk-pay for ub.chk-pay.
     5584   main-block:
     5585   do
     5586   on error undo main-block, retry main-block
     5587   on stop undo main-block, retry main-block
     5588   on endkey undo main-block, retry main-block
     5589   :
     5590     if retry then do:
     5591       if v-err-mess = '' then do:
     5592         v-err-mess = substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     5593       end.
     5594       dataset libthpos_receipt:reject-changes.
     5595       return error v-err-mess.
     5596     end.
     5597     else do:
     5598       if not available libthpos_chk-context then do:
     5599         find first libthpos_chk-context no-error.
     5600       end.
     5601       if not available libthpos_chk-context then do:
     5602         v-err-mess = substitute("Не выставлен контекст чека").
     5603         undo main-block, retry main-block.
     5604       end.
     5605       find first libthpos_chk-doc.
     5606       if libthpos_chk-context.doc-code <> p-doc-code then do:
     5607         v-err-mess = substitute("Неверный номер чека = &1", p-doc-code).
     5608         undo main-block, retry main-block.
     5609       end.
     5610       if lookup(string(libthpos_chk-context.chk-type), '14,15,16,36,17,8,11,12,13,40,69,101,106,108,169,196,114,115,116,117,111,112,136,113,101,106,108,208,2,3,4,5,7,43,44':U) > 0
     5611       or lookup(string(libthpos_chk-context.chk-type), '2,3,4,5,7':U) > 0
     5612       then do:
     5613         v-err-mess = substitute("В чеке &1 с типом &2 карты быть не может", p-doc-code, libthpos_chk-context.chk-type).
     5614         undo main-block, retry main-block.
     5615       end.
     5616       if libthpos_chk-context.step >= 3 then do:
     5617         v-err-mess = substitute("Уже есть строки оплаты, нельзя зарегистрировать ДК").
     5618         undo main-block, retry main-block.
     5619       end.
     5620       find first buf_Dis-card no-lock where
     5621                 buf_Dis-card.d-card = p-src-d-card no-error.
     5622       if not available buf_dis-card then do:
     5623         if (libthpos_context.dc-mask or libthpos_context.card-by-mask) then do:
     5624           _maska:
     5625           for each buf_libthpos_dis-card-mask no-lock
     5626           by buf_libthpos_dis-card-mask.rank
     5627           on error undo main-block, retry main-block
     5628           :
     5629             assign
     5630             v-found = yes
     5631             v-descr = "":U
     5632             v-short-number = '':U
     5633             v-is-correct = no
     5634             .
     5635             if libthpos_context.card-by-mask then do:
     5636               assign
     5637               v-short-number = card-by-mask (buf_libthpos_dis-card-mask.cli-mask, buf_libthpos_dis-card-mask.cc-run, p-src-d-card)
     5638               no-error
     5639               .
     5640               if error-status:error then do:
     5641                 v-err-mess = substitute("Не удается определить короткий номер ДК по маске (полный номер &1):&2&3"
     5642                                               , p-src-d-card
     5643                                               , chr(10)
     5644                                               , return-value ).
     5645                 undo main-block, retry main-block.
     5646               end.
     5647               v-d-mask = buf_libthpos_dis-card-mask.cli-mask.
     5648             end.
     5649             if v-short-number = '':U then do:
     5650               if libthpos_context.dc-mask then do:
     5651                 assign
     5652                 v-is-correct = check-by-mask (buf_libthpos_dis-card-mask.mask, p-src-d-card, output v-descr)
     5653                 no-error
     5654                 .
     5655                 if error-status:error then do:
     5656                   v-err-mess = substitute("Не удается сопоставить карту (полный номер &1) маске:&2&3"
     5657                                                 , p-src-d-card
     5658                                                 , chr(10)
     5659                                                 , return-value ).
     5660                   undo main-block, retry main-block.
     5661                 end.
     5662                 v-d-mask = buf_libthpos_dis-card-mask.mask.
     5663               end.
     5664             end.
     5665             if v-is-correct or v-short-number <> '':U then do:
     5666               find first buf_dis-card no-lock where
     5667                         buf_dis-card.d-card = (if v-short-number <> '':U
     5668                                               then v-short-number
     5669                                               else buf_libthpos_dis-card-mask.mask) no-error .
     5670               if available buf_dis-card
     5671               and buf_dis-card.type = buf_libthpos_dis-card-mask.type
     5672               and buf_dis-card.emitent-host-code = buf_libthpos_dis-card-mask.emitent-host-code
     5673               then do:
     5674                 assign
     5675                 v-d-card = buf_Dis-card.d-card
     5676                 v-th-mask = yes
     5677                 .
     5678                 LEAVE _maska.
     5679               end.
     5680             end.
     5681           end.
     5682           if not available buf_dis-card then do:
     5683             v-err-mess =  (if not v-found
     5684                               then substitute("Для карты &1 не определено ни одной действующей маски", v-d-card)
     5685                               else substitute("Карта &1 не соответствует ни одной действующей маске", v-d-card)
     5686                             ) .
     5687             undo main-block, retry main-block.
     5688           end.
     5689         end.
     5690       end.
     5691       if avail buf_dis-card
     5692       then find first buf_dis-card-type No-LOCK WHERE
     5693                       buf_dis-card-type.type = buf_dis-card.type AND
     5694                       buf_dis-card-type.emitent-host-code = buf_dis-card.emitent-host-code AND
     5695                       buf_dis-card-type.host-code = 0 AND
     5696                       buf_dis-card-type.obj-type = "":U AND
     5697                       buf_dis-card-type.obj-code = 0
     5698                       NO-ERROR.
     5699       else release buf_dis-card-type.
     5700       IF NOT avail buf_dis-card
     5701       or NOT avail buf_dis-card-type
     5702       OR (buf_dis-card.emitent-host-code <> libthpos_context.host-code and buf_dis-card.emitent-host-code <> 0)
     5703       or (lookup(string(libthpos_context.obj-code), buf_dis-card-type.DCBYSHOP) > 0
     5704           and
     5705           buf_dis-card.issue-code <> libthpos_context.obj-code)
     5706       then do:
     5707         v-err-mess = substitute("Нет сведений о карте клиента &1 или карта выдана другим магазином"
     5708                                 , p-src-d-card
     5709                               ) .
     5710         undo main-block, retry main-block.
     5711       end.
     5712       if avail buf_dis-card
     5713       and buf_dis-card.emitent-host-code = 0
     5714       and buf_dis-card.credit-card then do:
     5715         v-err-mess = substitute(
     5716                                 "Глобальная карта &1 (&2) не может быть кредитной"
     5717                                 , p-src-d-card
     5718                                 , v-d-card
     5719                               ) .
     5720         undo main-block, retry main-block.
     5721       end.
     5722       if avail buf_dis-card
     5723       and buf_dis-card.status_ = 'неисп':U then do:
     5724         v-err-mess = substitute("Карта &2 имеет статус &3&1" +
     5725                                 "карта НЕ МОЖЕТ БЫТЬ ИСПОЛЬЗОВАНА и подлежит ПОЛНОМУ И ОКОНЧАТЕЛЬНОМУ УДАЛЕНИЮ&1"
     5726                                 , chr(10)
     5727                                 , buf_dis-card.d-card
     5728                                 , buf_dis-card.status_
     5729                               )                  .
     5730         undo main-block, retry main-block.
     5731       end.
     5732       if available buf_Dis-card
     5733       and buf_dis-card.status_ =  'удал':U then do:
     5734         v-err-mess = substitute("Карта &2 имеет статус &3&1" +
     5735                                 "карта НЕ МОЖЕТ БЫТЬ ИСПОЛЬЗОВАНА&1"
     5736                                 , chr(10)
     5737                                 , buf_dis-card.d-card
     5738                                 , buf_dis-card.status_
     5739                               )                  .
     5740         undo main-block, retry main-block.
     5741       end.
     5742       if available buf_dis-card
     5743       and buf_Dis-card.valid-from <> ? then do:
     5744         run cur-time in this-procedure ( output v-today, output v-time).
     5745         if buf_dis-card.valid-from > v-today then do:
     5746           v-err-mess = substitute("Дата начала действия карты &1 = &2&3" +
     5747                                   "карта НЕ МОЖЕТ БЫТЬ ИСПОЛЬЗОВАНА&1"
     5748                                   , buf_dis-card.d-card
     5749                                   , string(buf_dis-card.valid-from, "99/99/9999")
     5750                                   , chr(10)
     5751                                 )                  .
     5752           undo main-block, retry main-block.
     5753         end.
     5754       end.
     5755       if available buf_dis-card
     5756       and buf_Dis-card.valid-date <> ? then do:
     5757         if v-today = ? then do:
     5758           run cur-time in this-procedure ( output v-today, output v-time).
     5759         end.
     5760         if buf_dis-card.valid-date < v-today then do:
     5761           v-err-mess = substitute("Карта &1 просрочена (&2)&3" +
     5762                                   "и НЕ МОЖЕТ БЫТЬ ИСПОЛЬЗОВАНА&1"
     5763                                   , buf_dis-card.d-card
     5764                                   , string(buf_dis-card.valid-from, "99/99/9999")
     5765                                   , chr(10)
     5766                                 )                  .
     5767           undo main-block, retry main-block.
     5768         end.
     5769       end.
     5770       find first buf_chk-doc share-lock where
     5771                 rowid(buf_chk-doc) = libthpos_chk-context.rowid_.
     5772       assign
     5773       p-d-card   = buf_Dis-card.d-card
     5774       p-cli-type = buf_Dis-card.cli-type
     5775       p-cli-code = buf_Dis-card.cli-code
     5776       buf_chk-doc.src-d-card = p-src-d-card
     5777       buf_chk-doc.src-d-mask = v-d-mask
     5778       buf_chk-doc.src-cli-type = buf_dis-card.cli-type
     5779       buf_chk-doc.src-cli-code = buf_dis-card.cli-code
     5780       libthpos_chk-doc.src-d-card = p-src-d-card
     5781       libthpos_chk-doc.src-d-mask = v-d-mask
     5782       libthpos_chk-doc.src-cli-type = buf_dis-card.cli-type
     5783       libthpos_chk-doc.src-cli-code = buf_dis-card.cli-code
     5784       libthpos_chk-context.src-d-card = p-src-d-card
     5785       libthpos_chk-context.src-d-mask = v-d-mask
     5786       libthpos_chk-context.src-cli-type = buf_dis-card.cli-type
     5787       libthpos_chk-context.src-cli-code = buf_dis-card.cli-code
     5788        libthpos_chk-context.d-pcnt = (if buf_dis-card.d-pcnt-method = integer('1':U)
     5789                                     or buf_dis-card.d-pcnt-method  = integer('3':U)
     5790                                     then buf_dis-card.d-pcnt
     5791                                     else 0)
     5792       libthpos_chk-context.cash-d-pcnt = (if buf_dis-card.d-pcnt-method = integer('2':U)
     5793                                           or buf_dis-card.d-pcnt-method  = integer('3':U)
     5794                                           then  buf_dis-card.cash-d-pcnt
     5795                                           else 0)
     5796       libthpos_chk-context.category = buf_dis-card.category
     5797       .
     5798       if buf_dis-card-type.d-pcnt-byshop then do:
     5799   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5800   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     5801     (
     5802      input  buf_dis-card-type.type
     5803     ,input  buf_dis-card-type.emitent-host-code
     5804     ,input  libthpos_context.host-code
     5805     ,input  libthpos_context.obj-type
     5806     ,input  libthpos_context.obj-code
     5807     ,input  'def-pcnt':U
     5808     ,output libthpos_chk-context.d-pcnt
     5809     ) no-error .
     5810   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5811   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     5812     (
     5813      input  buf_dis-card-type.type
     5814     ,input  buf_dis-card-type.emitent-host-code
     5815     ,input  libthpos_context.host-code
     5816     ,input  libthpos_context.obj-type
     5817     ,input  libthpos_context.obj-code
     5818     ,input  'def-cash-pcnt':U
     5819     ,output libthpos_chk-context.cash-d-pcnt
     5820     ) no-error .
     5821   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5822   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     5823     (
     5824      input  buf_dis-card-type.type
     5825     ,input  buf_dis-card-type.emitent-host-code
     5826     ,input  libthpos_context.host-code
     5827     ,input  libthpos_context.obj-type
     5828     ,input  libthpos_context.obj-code
     5829     ,input  'def-categ':U
     5830     ,output libthpos_chk-context.category
     5831     ) no-error .
     5832       end.
     5833       if libthpos_chk-context.step > 0 then do:
     5834         for each buf_chk-gds share-lock where
     5835                 buf_chk-gds.doc-code = p-doc-code,
     5836           first libthpos_chk-gds where
     5837               libthpos_chk-gds.doc-code = p-doc-code
     5838             and libthpos_chk-gds.line-num = buf_chk-gds.line-num
     5839         on error undo main-block, retry main-block:
     5840           assign
     5841           buf_chk-gds.src-d-card = p-src-d-card
     5842           buf_chk-gds.src-d-mask = v-d-mask
     5843           buf_chk-gds.src-cli-type = buf_dis-card.cli-type
     5844           buf_chk-gds.src-cli-code = buf_dis-card.cli-code
     5845           libthpos_chk-gds.src-d-card = p-src-d-card
     5846           libthpos_chk-gds.src-d-mask = v-d-mask
     5847           libthpos_chk-gds.src-cli-type = buf_dis-card.cli-type
     5848           libthpos_chk-gds.src-cli-code = buf_dis-card.cli-code
     5849           libthpos_chk-context.recalc-gline-num = 1
     5850           .
     5851         end.
     5852         run libthpos_recalc-discnt in this-procedure no-error.
     5853         if error-status:error then do:
     5854           v-err-mess = substitute("Ош-ка при пересчете: &1 &2", return-value , error-status:get-message(1) ).
     5855           undo main-block, retry main-block.
     5856         end.
     5857       end.
     5858       dataset libthpos_receipt:accept-changes.
     5859     end.
     5860   end.
     5861   end procedure.
     5862   procedure libthpos_gds-line :
     5863   define input  parameter p-doc-code as character no-undo .
     5864   define input  parameter p-line-num as integer no-undo .
     5865   define input  parameter p-mode as character no-undo .
     5866   define input  parameter p-line-direction as integer no-undo .
     5867   define input  parameter p-src-code as character no-undo .
     5868   define input-output  parameter p-src-qnty as decimal no-undo .
     5869   define input  parameter p-pump as integer no-undo .
     5870   define input  parameter p-nozzle-code as integer no-undo .
     5871   define input  parameter p-pl-code    as integer no-undo .
     5872   define input  parameter p-pass-gds   as integer no-undo .
     5873   define input  parameter p-write-off-code as integer no-undo .
     5874   define input  parameter p-depart-id  as integer no-undo .
     5875   define output parameter p-setted as logical no-undo .
     5876   define output parameter p-next as character no-undo .
     5877   define output parameter p-b-code as integer no-undo .
     5878   define output parameter p-gds-code as integer no-undo .
     5879   define output parameter p-chk-name as character no-undo .
     5880   define output parameter p-second-name as character no-undo .
     5881   define input-output parameter p-src-price as decimal no-undo .
     5882   define output parameter p-src-price-rubl as decimal no-undo .
     5883   define output parameter p-src-discnt-sum as decimal no-undo .
     5884   define output parameter p-src-discnt-sum-rubl as decimal no-undo .
     5885   define output parameter p-src-sum as decimal no-undo .
     5886   define output parameter p-src-sum-rubl as decimal no-undo .
     5887   define output parameter p-src-sum-netto as decimal no-undo .
     5888   define output parameter p-src-sum-netto-rubl as decimal no-undo .
     5889   define output parameter p-unit-base as character no-undo .
     5890   define variable v-doc-qnty as decimal no-undo .
     5891   define variable v-cli-base-rate as decimal no-undo .
     5892   define variable v-line-direction as integer no-undo .
     5893   define variable v-result   as character         no-undo.
     5894   define variable v-type-bc  as character         no-undo.
     5895   define variable v-weight   as decimal           no-undo.
     5896   define variable v-empty-scale as logical no-undo .
     5897   define variable v-gds-name as character no-undo .
     5898   define variable v-gds-name1 as character no-undo .
     5899   define variable v-second-name as character no-undo .
     5900   define variable v-f-name as character no-undo .
     5901   define variable v-b-code as integer no-undo .
     5902   define variable v-main-bar-code as integer no-undo .
     5903   define variable v-is-weight-pbc as logical no-undo .
     5904   define variable v-is-pgweight-pbc as logical no-undo .
     5905   define variable v-gds-code as integer no-undo .
     5906   define variable v-unit-base as character no-undo .
     5907   define variable v-unit-base-type as character no-undo .
     5908   define variable v-unit-cli as character no-undo .
     5909   define variable v-unit-cli-type as character no-undo .
     5910   define variable v-prt-root as integer no-undo .
     5911   define variable v-root-node-code as integer no-undo .
     5912   define variable v-min-rate as decimal no-undo .
     5913   define variable v-max-rate as decimal no-undo .
     5914   define variable v-node-code as integer no-undo .
     5915   define variable v-in-code as character no-undo .
     5916   define variable v-part-code as character no-undo .
     5917   define variable v-chk-name as character no-undo .
     5918   define variable v-cash-parts as logical no-undo .
     5919   define variable v-gtd as character no-undo .
     5920   define variable v-valid as logical no-undo .
     5921   define variable v-mess as character no-undo .
     5922   define variable v-chr-err as character no-undo .
     5923   define variable v-plt-id          as integer   no-undo .
     5924   define variable v-plt-db-num      as integer   no-undo .
     5925   define variable v-pdf-id          as integer   no-undo .
     5926   define variable v-pdf-db-num      as integer   no-undo .
     5927   define variable v-sale-price-base as decimal   no-undo .
     5928   define variable v-sale-price-rubl as decimal   no-undo .
     5929   define variable v-sale-price-r-b as decimal   no-undo .
     5930   define variable v-depart-type as character no-undo .
     5931   define variable v-depart-code as integer no-undo .
     5932   define variable v-is-null-price as logical no-undo .
     5933   define variable v-road-tax-base as decimal   no-undo .
     5934   define variable v-road-tax-rubl as decimal   no-undo .
     5935   define variable v-excise-base   as decimal   no-undo .
     5936   define variable v-excise-rubl   as decimal   no-undo .
     5937   define variable v-free-price as logical no-undo .
     5938   define variable v-sum-grp-code as integer no-undo .
     5939   DEFINE VARIABLE v-today as date no-undo .
     5940   DEFINE VARIABLE v-time as integer no-undo .
     5941   define variable v-no-add-price as logical no-undo .
     5942   define variable v-discnt as decimal no-undo .
     5943   define variable v-m-discnt as decimal no-undo .
     5944   define variable v-src-price as decimal no-undo .
     5945   define variable v-src-discnt as decimal no-undo .
     5946   define variable v-start-src-price as decimal no-undo .
     5947   define variable v-start-src-discnt as decimal no-undo .
     5948   define variable v-new-src-price as decimal no-undo .
     5949   define variable v-new-src-discnt as decimal no-undo .
     5950   define variable v-dopchr as character no-undo .
     5951   define variable v-attr-value as character no-undo .
     5952   define variable v-attr-type as character no-undo .
     5953   define variable v-is-recalc as logical no-undo .
     5954   define variable v-scpg-format as character no-undo .
     5955   define variable v-err-mess as character no-undo .
     5956   define variable v-accept-changes as logical no-undo .
     5957   define variable v-in-ov as logical no-undo .
     5958   define buffer buf_chk-gds for ub.chk-gds.
     5959   define buffer buf_libthpos_chk-gds for libthpos_chk-gds.
     5960   define buffer buf_bar-code for ub.bar-code.
     5961   define buffer buf_prod-bc for ub.prod-bc.
     5962   define buffer buf_place for ub.place.
     5963   define buffer buf_goods for ub.goods.
     5964   define buffer buf_chk-discnt for ub.chk-discnt.
     5965   define buffer buf_libthpos_chk-discnt for libthpos_chk-discnt.
     5966   define buffer buf_units for ub.units.
     5967   define buffer root_gds-prt for ub.gds-prt.
     5968   define buffer term_gds-prt for ub.gds-prt.
     5969   define buffer cli_units for ub.units.
     5970   define buffer buf_libthpos_rp-by-call for libthpos_rp-by-call.
     5971   define buffer buf2_libthpos_chk-gds for libthpos_chk-gds.
     5972   main-block:
     5973   do
     5974   on error undo main-block, retry main-block
     5975   on stop undo main-block, retry main-block
     5976   on endkey undo main-block, retry main-block
     5977   :
     5978     if retry then do:
     5979       if v-err-mess = '' then do:
     5980         v-err-mess = substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     5981       end.
     5982       dataset libthpos_receipt:reject-changes.
     5983       return error v-err-mess.
     5984     end.
     5985     else do:
     5986       if not available libthpos_chk-context then do:
     5987         find first libthpos_chk-context no-error.
     5988       end.
     5989       if not available libthpos_chk-context then do:
     5990         v-err-mess = substitute("Не выставлен контекст чека").
     5991         undo main-block, retry main-block.
     5992       end.
     5993       find first libthpos_chk-doc.
     5994       if libthpos_chk-context.doc-code <> p-doc-code then do:
     5995         v-err-mess = substitute("Неверный номер чека = &1", p-doc-code).
     5996         undo main-block, retry main-block.
     5997       end.
     5998       if p-line-num <= 0 then do:
     5999         v-err-mess = substitute("Неверный номер товарной строки = &1", p-line-num).
     6000         undo main-block, retry main-block.
     6001       end.
     6002       if not (p-mode = 'ДОБАВЛЕНИЕ':U
     6003               or
     6004               p-mode = 'ИЗМЕНЕНИЕ':U
     6005               or
     6006               p-mode = 'удаление':U
     6007               or
     6008               p-mode = 'ИЗМЕНЕНИЕ':U  + chr(44) + "recalc"
     6009               or
     6010               p-mode = 'ИЗМЕНЕНИЕ':U  + chr(44) + "recalc" + chr(44) + "no-changes"
     6011               or
     6012               p-mode = 'ПРОСМОТР':U
     6013               ) then do:
     6014         v-err-mess = substitute("Неверное действие над товарной строкой чека = &1", p-mode).
     6015         undo main-block, retry main-block.
     6016       end.
     6017       assign
     6018       v-accept-changes = yes.
     6019       if (p-mode = 'ИЗМЕНЕНИЕ':U  + chr(44) + "recalc" + chr(44) + "no-changes") then do:
     6020         v-accept-changes = no.
     6021       end.
     6022       if (p-mode = 'ИЗМЕНЕНИЕ':U  + chr(44) + "recalc")
     6023       or (p-mode = 'ИЗМЕНЕНИЕ':U  + chr(44) + "recalc" + chr(44) + "no-changes")
     6024       then do:
     6025         assign
     6026         v-is-recalc = yes
     6027         p-mode = 'ИЗМЕНЕНИЕ':U
     6028         .
     6029       end.
     6030       if p-mode = 'ПРОСМОТР':U then do:
     6031         find first buf_libthpos_chk-gds where
     6032                   buf_libthpos_chk-gds.doc-code = p-doc-code
     6033              and  buf_libthpos_chk-gds.line-num = p-line-num no-error.
     6034         if not available buf_libthpos_chk-gds then do:
     6035           v-err-mess = substitute("Не найдена строка &1 в чеке &2", p-line-num, p-doc-code).
     6036           undo main-block, retry main-block.
     6037         end.
     6038         assign
     6039         p-b-code = buf_libthpos_chk-gds.b-code
     6040         p-gds-code = buf_libthpos_chk-gds.gds-code
     6041         p-second-name = buf_libthpos_chk-gds.second-name
     6042         p-src-price = buf_libthpos_chk-gds.src-price
     6043         p-src-price-rubl = buf_libthpos_chk-gds.src-price-rubl
     6044         p-src-discnt-sum = buf_libthpos_chk-gds.src-discnt-sum
     6045         p-src-discnt-sum-rubl = buf_libthpos_chk-gds.src-discnt-sum-rubl
     6046         p-src-sum = buf_libthpos_chk-gds.src-sum
     6047         p-src-sum-rubl = buf_libthpos_chk-gds.src-sum-rubl
     6048         p-src-sum-netto = p-src-sum - p-src-discnt-sum
     6049         p-src-sum-netto-rubl = p-src-sum-rubl - p-src-discnt-sum-rubl
     6050         p-unit-base = buf_libthpos_chk-gds.unit-base
     6051         p-setted = yes
     6052         p-next = (if (libthpos_chk-context.recalc-gline-num < libthpos_chk-context.lng + 1
     6053                   or libthpos_chk-context.step >  1)
     6054                     and not v-is-recalc
     6055                     then substitute("recalc=&1,&2,&3"
     6056                                     ,min(libthpos_chk-context.recalc-gline-num, libthpos_chk-context.lng)
     6057                                     ,(if libthpos_chk-context.step > 1 or p-mode = 'удаление':U then 1 else 0)
     6058                                     ,(if libthpos_chk-context.step > 2 or p-mode = 'удаление':U then 1 else 0)
     6059                                   )
     6060                     else "")
     6061         .
     6062         return ''.
     6063       end.
     6064       if p-mode = 'удаление':U
     6065       and p-src-qnty <> 0 then do:
     6066         v-err-mess = substitute("Для удаления товарной строки чека количество должно = 0").
     6067         undo main-block, retry main-block.
     6068       end.
     6069       if p-mode = 'ИЗМЕНЕНИЕ':U
     6070       and p-src-qnty = 0
     6071       or p-src-qnty = ?
     6072       then do:
     6073         v-err-mess = substitute("Для изменения товарной строки чека количество должно быть задано").
     6074         undo main-block, retry main-block.
     6075       end.
     6076       if libthpos_chk-context.direction > 0
     6077       and p-line-direction > 0
     6078       and p-src-qnty  < 0 then do:
     6079         v-err-mess = substitute("Неверный знак количества товарной строки чека с кодом &1", p-src-code).
     6080         undo main-block, retry main-block.
     6081       end.
     6082       if libthpos_chk-context.direction > 0
