     8665         run printbuffer in this-procedure ( input (buffer libthpos_chk-context:handle)).
     8666       end.
     8667       if available buf_libthpos_chk-pay then do:
     8668         assign
     8669         buf_libthpos_chk-pay.b-exch-date = v-exch-date
     8670         buf_libthpos_chk-pay.b-exch-time = v-exch-time
     8671         buf_libthpos_chk-pay.b-exch-rate = v-exch-rate
     8672         buf_libthpos_chk-pay.b-exch-scale = v-exch-scale
     8673         buf_libthpos_chk-pay.b-calc-rate = v-calc-rate
     8674         .
     8675       end.
     8676       if p-mode = 'ДОБАВЛЕНИЕ':U
     8677       and v-atr1 = yes then do:
     8678         assign
     8679         p-2-cdpay-code = p-cdpay-code
     8680         p-2-curr-code = p-curr-code
     8681         p-frpay-code = v-frpay-code
     8682         .
     8683       end.
     8684       else do:
     8685         assign
     8686         p-2-cdpay-code = 1
     8687         p-2-curr-code = libthpos_context.nalc
     8688         p-2-frpay-code = 1
     8689         .
     8690       end.
     8691       assign
     8692       p-frpay-code = v-frpay-code
     8693       p-tot-sum = v-netto-sum
     8694       p-tot-rubl = v-netto-rubl
     8695       p-tot-base = v-netto-base
     8696       p-2-tot-sum  = (if p-2-curr-code = 0
     8697                       then libthpos_chk-context.to-pay-rubl
     8698                       else (if p-2-curr-code = libthpos_context.base-code
     8699                             then libthpos_chk-context.to-pay-base
     8700                             else (if libthpos_context.r-b = 'rubl':U
     8701                                   then  libthpos_chk-context.to-pay-rubl / v-nalc-exch-rate * v-nalc-exch-scale
     8702                                   else libthpos_chk-context.to-pay-base / libthpos_chk-context.a-cash-rate * libthpos_chk-context.a-cash-scale
     8703                                   * v-nalc-exch-rate / v-nalc-exch-scale
     8704                                   )
     8705                             )
     8706                       )
     8707       p-2-tot-rubl = libthpos_chk-context.to-pay-rubl
     8708       p-2-tot-base = libthpos_chk-context.to-pay-base
     8709       p-2-tot-sum  =  (if v-atr1 = no and v-has-overpay = 1 then 0 else p-2-tot-sum)
     8710       p-2-tot-rubl =  (if v-atr1 = no and v-has-overpay = 1 then 0 else p-2-tot-rubl)
     8711       p-2-tot-base =  (if v-atr1 = no and v-has-overpay = 1 then 0 else p-2-tot-base)
     8712       p-get-qnty-method = v-get-qnty-method
     8713       p-src-discnt-sum = (if p-mode = 'удаление':U then 0 else (if buf_libthpos_chk-pay.inversed then buf_libthpos_chk-pay.discnt-sum else 0))
     8714       p-src-discnt-rubl = (if p-mode = 'удаление':U then 0 else (if buf_libthpos_chk-pay.inversed then buf_libthpos_chk-pay.discnt-rubl else 0))
     8715       p-for-discnt-doc =  (if p-mode = 'удаление':U then 0 else buf_libthpos_chk-pay.for-discnt-doc)
     8716       p-for-discnt-rubl = (if p-mode = 'удаление':U then 0 else buf_libthpos_chk-pay.for-discnt-rubl)
     8717       p-for-discnt-r-b = (if p-mode = 'удаление':U then 0 else buf_libthpos_chk-pay.for-discnt-r-b)
     8718       p-setted = yes
     8719       .
     8720       if available buf_libthpos_chk-pay then do:
     8721         run printbuffer in this-procedure ( input (buffer buf_chk-pay:handle)).
     8722         run printbuffer in this-procedure ( input (buffer buf_libthpos_chk-pay:handle)).
     8723       end.
     8724       run printbuffer in this-procedure ( input (buffer libthpos_chk-context:handle)).
     8725       if not v-inversed then do:
     8726         dataset libthpos_receipt:reject-changes.
     8727         undo main-block, return ''.
     8728       end.
     8729       else do:
     8730         dataset libthpos_receipt:accept-changes.
     8731       end.
     8732       find first libthpos_chk-context.
     8733       run printbuffer in this-procedure ( input (buffer libthpos_chk-context:handle)).
     8734     end.
     8735   end.
     8736   end procedure.
     8737   procedure libthpos_inst-line :
     8738   define input  parameter p-doc-code as character no-undo .
     8739   define input  parameter p-line-num as integer no-undo .
     8740   define input  parameter p-mode as character no-undo .
     8741   define input-output parameter p-cdpay-code as integer no-undo .
     8742   define input-output parameter p-curr-code as integer   no-undo .
     8743   define input  parameter p-par-code as integer no-undo .
     8744   define input  parameter p-src-qnty as decimal no-undo .
     8745   define output parameter p-frpay-code as integer no-undo .
     8746   define input  parameter p-pass-pay   as integer no-undo .
     8747   define input  parameter p-pay-card as character no-undo .
     8748   define input-output parameter p-tot-sum as decimal no-undo .
     8749   define input-output parameter p-tot-rubl as decimal no-undo .
     8750   define input-output parameter p-tot-base as decimal no-undo .
     8751   define output parameter p-get-qnty-method as character no-undo .
     8752   define output parameter p-setted as logical no-undo .
     8753   DEFINE VARIABLE v-today as date no-undo .
     8754   DEFINE VARIABLE v-time as integer no-undo .
     8755   define variable v-tot-sum as decimal no-undo .
     8756   define variable v-tot-base as decimal no-undo .
     8757   define variable v-tot-rubl as decimal no-undo .
     8758   define variable v-exch-rate as decimal no-undo .
     8759   define variable v-exch-scale as integer no-undo .
     8760   define variable v-exch-abbr as character no-undo .
     8761   define variable v-exch-date as date no-undo .
     8762   define variable v-exch-time as integer no-undo .
     8763   define variable v-bank-rate as decimal no-undo .
     8764   define variable v-bank-scale as integer no-undo .
     8765   define variable v-bank-abbr as character no-undo .
     8766   define variable v-cash-rate as decimal no-undo .
     8767   define variable v-calc-rate as integer no-undo .
     8768   define variable v-is-cash as logical no-undo .
     8769   define variable v-wth-code as integer   no-undo .
     8770   define variable v-src-val as integer   no-undo .
     8771   define variable v-get-qnty-method as character no-undo .
     8772   define variable v-par-rate as decimal no-undo .
     8773   define variable v-frpay-code as integer no-undo .
     8774   define variable v-inversed as logical no-undo .
     8775   define variable v-err-mess as character no-undo .
     8776   define buffer buf_cash-pay for ub.cash-pay.
     8777   define buffer buf_chk-pay for ub.chk-pay.
     8778   define buffer buf_wealth for ub.wealth.
     8779   define buffer buf_wth-par for ub.wth-par.
     8780   define buffer buf_libthpos_chk-pay for libthpos_chk-pay.
     8781   define buffer buf_chk-discnt for ub.chk-discnt.
     8782   define buffer buf_libthpos_chk-discnt for libthpos_chk-discnt.
     8783   define buffer buf_libthpos_cash-desk-attr for libthpos_cash-desk-attr.
     8784   define buffer buf_curr-shop for ub.curr-shop.
     8785   define buffer buf_libthpos_cash-counter for libthpos_cash-counter.
     8786   define buffer buf2_libthpos_chk-pay for libthpos_chk-pay.
     8787   define buffer buf_libthpos_temp-cash-pay-list for libthpos_temp-cash-pay-list.
     8788   main-block:
     8789   do
     8790   on error undo main-block, retry main-block
     8791   on stop undo main-block, retry main-block
     8792   on endkey undo main-block, retry main-block
     8793   :
     8794     if retry then do:
     8795       if v-err-mess = '' then do:
     8796         v-err-mess = substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     8797       end.
     8798       dataset libthpos_receipt:reject-changes.
     8799       return error v-err-mess.
     8800     end.
     8801     else do:
     8802       if not available libthpos_chk-context then do:
     8803         find first libthpos_chk-context no-error.
     8804       end.
     8805       if not available libthpos_chk-context then do:
     8806         v-err-mess = substitute("Не выставлен контекст чека").
     8807         undo main-block, retry main-block.
     8808       end.
     8809       if libthpos_chk-context.doc-code <> p-doc-code then do:
     8810         v-err-mess = substitute("Неверный номер чека = &1", p-doc-code).
     8811         undo main-block, retry main-block.
     8812       end.
     8813       if not (p-mode = 'ДОБАВЛЕНИЕ':U
     8814               or
     8815               p-mode = 'ИЗМЕНЕНИЕ':U
     8816               or
     8817               p-mode = 'удаление':U
     8818               ) then do:
     8819         v-err-mess = substitute("Неверное действие над строкой оплат чека = &1", p-mode).
     8820         undo main-block, retry main-block.
     8821       end.
     8822       if p-mode = 'удаление':U
     8823       and (p-tot-sum = ?
     8824       or p-tot-sum <> 0 ) then do:
     8825         v-err-mess = substitute("Для удаления строки оплат чека сумма должна = 0").
     8826         undo main-block, retry main-block.
     8827       end.
     8828       if p-mode = 'ИЗМЕНЕНИЕ':U
     8829       and (p-tot-sum = ?
     8830       or p-tot-sum = 0)
     8831       and not libthpos_chk-context.chk-type = integer('7':U)
     8832       then do:
     8833         v-err-mess = substitute("Для изменения строки оплат чека сумма не должна = 0 или ?").
     8834         undo main-block, retry main-block.
     8835       end.
     8836       if libthpos_chk-context.chk-type = integer('7':U)
     8837       and p-tot-sum <> 0
     8838       then do:
     8839         v-err-mess = substitute("Для строки оплат в чеке типа ДЕКЛАРАЦИЯ сумма должна = 0").
     8840         undo main-block, retry main-block.
     8841       end.
     8842       if lookup(string(libthpos_chk-context.chk-type), '2,3,4,5,7':U) = 0
     8843       then do:
     8844         v-err-mess = substitute("В чеке &1 с типом &2 строки оплат быть не может", p-doc-code, libthpos_chk-context.chk-type).
     8845         undo main-block, retry main-block.
     8846       end.
     8847       if p-tot-sum = ?
     8848       and not (libthpos_chk-context.chk-type = integer('2':U)
     8849               or
     8850               libthpos_chk-context.chk-type = integer('рас':U)
     8851               or
     8852               (libthpos_chk-context.chk-type = integer('4':U)  and p-line-num = 2)
     8853               ) then do:
     8854         v-err-mess = substitute("В чеке &1 с типом &2 должна быть задана сумма", p-doc-code, libthpos_chk-context.chk-type).
     8855         undo main-block, retry main-block.
     8856       end.
     8857       if p-line-num > 2
     8858       and libthpos_chk-context.chk-type = integer('4':U) then do:
     8859         v-err-mess = substitute("В чеке &1 с типом &2 может быть только 2 строки", p-doc-code, libthpos_chk-context.chk-type).
     8860         undo main-block, retry main-block.
     8861       end.
     8862       case p-mode:
     8863         when 'ДОБАВЛЕНИЕ':U then do:
     8864           if libthpos_chk-context.lnp + 1 <> p-line-num then do:
     8865             v-err-mess = substitute("Неверный № строки оплат чека = &1&2должен быть &3"
     8866                                         , p-line-num
     8867                                         , chr(10)
     8868                                         , libthpos_chk-context.lnp + 1).
     8869             undo main-block, retry main-block.
     8870           end.
     8871           if p-cdpay-code = ? then do:
     8872             assign
     8873             p-cdpay-code = 1
     8874             p-curr-code = libthpos_context.nalc
     8875             v-is-cash = yes
     8876             .
     8877           end.
     8878           else do:
     8879           end.
     8880             find first buf_cash-pay no-lock where
     8881                       buf_cash-pay.cdpay-code = p-cdpay-code
     8882                   and buf_cash-pay.curr-code = p-curr-code no-error.
     8883             if not available buf_cash-pay then do:
     8884               v-err-mess = substitute("Не найден тип кассового платежа с кодом &1 и валютой &2"
     8885                                                       , p-cdpay-code
     8886                                                       , p-curr-code).
     8887               undo main-block, retry main-block.
     8888             end.
     8889             assign
     8890             v-is-cash = buf_cash-pay.is-cash
     8891             .
     8892           if buf_cash-pay.wth-code > 0 then do:
     8893             find first buf_wealth no-lock where
     8894                       buf_wealth.wth-code = buf_cash-pay.wth-code no-error.
     8895             if not available buf_wealth then do:
     8896               v-err-mess = substitute("Не найдена МЦ с кодом &1 для типа кассового платежа с кодом &2 и валютой &3"
     8897                                                       , buf_cash-pay.wth-code
     8898                                                       , p-cdpay-code
     8899                                                       , p-curr-code).
     8900               undo main-block, retry main-block.
     8901             end.
     8902             assign
     8903             v-get-qnty-method = buf_wealth.get-qnty-method
     8904             v-wth-code = buf_wealth.wth-code
     8905             .
     8906           end.
     8907           if p-par-code <> 0 then do:
     8908             find first buf_wth-par no-lock where
     8909                       buf_wth-par.par-code = p-par-code
     8910                   and buf_wth-par.wth-code = buf_cash-pay.wth-code no-error.
     8911             if not available buf_wth-par then do:
     8912               v-err-mess = substitute("Не найден номинал с кодом &1 для МЦ с кодом &2 для типа кассового платежа с кодом &3 и валютой &4"
     8913                                                       , p-par-code
     8914                                                       , buf_cash-pay.wth-code
     8915                                                       , p-cdpay-code
     8916                                                       , p-curr-code).
     8917               undo main-block, retry main-block.
     8918             end.
     8919             assign
     8920             v-src-val = buf_wth-par.par-val
     8921             v-par-rate = buf_wth-par.par-rate
     8922             .
     8923           end.
     8924           if p-cdpay-code = 1 then do:
     8925             v-frpay-code = 1.
     8926           end.
     8927           else do:
     8928             find first buf_libthpos_temp-cash-pay-list where
     8929                     buf_libthpos_temp-cash-pay-list.cdpay-code = p-cdpay-code
     8930                 and  buf_libthpos_temp-cash-pay-list.curr-code = p-curr-code no-error .
     8931             if not available  buf_libthpos_temp-cash-pay-list then do:
     8932               v-err-mess = substitute("Для типа кассового платежа с кодом &1 и валютой &2 не удалось найти соответствующий код оплаты на ФР"
     8933                                                       , p-cdpay-code
     8934                                                       , p-curr-code).
     8935               undo main-block, retry main-block.
     8936             end.
     8937             v-frpay-code = buf_libthpos_temp-cash-pay-list.frpay-code.
     8938           end.
     8939           assign
     8940           v-tot-sum = p-tot-sum
     8941           .
     8942           if p-curr-code = 0 then do:
     8943               assign
     8944               v-cash-rate = 1
     8945               v-calc-rate = 1
     8946               v-bank-rate = 1
     8947               v-bank-scale = 1
     8948               v-exch-rate = 1
     8949               v-exch-scale = 1
     8950               v-exch-date = libthpos_chk-context.chk-date
     8951               v-exch-time = libthpos_chk-context.chk-time
     8952               v-tot-rubl = p-tot-sum
     8953               v-tot-base = (if libthpos_context.base-code = 0
     8954                             then v-tot-rubl
     8955                             else  v-tot-rubl / libthpos_chk-context.a-cash-rate *  libthpos_chk-context.a-cash-scale)
     8956               .
     8957           end.
     8958           else do:
     8959             if p-curr-code = libthpos_context.base-code then do:
     8960               assign
     8961               v-cash-rate = libthpos_chk-context.a-cash-rate / libthpos_chk-context.a-cash-scale
     8962               v-calc-rate = 1
     8963               v-bank-rate = libthpos_chk-context.a-bank-rate
     8964               v-bank-scale = libthpos_chk-context.a-bank-scale
     8965               v-exch-rate = libthpos_chk-context.a-bank-rate
     8966               v-exch-scale = libthpos_chk-context.a-bank-scale
     8967               v-exch-date = libthpos_chk-context.chk-date
     8968               v-exch-time = libthpos_chk-context.chk-time
     8969               v-tot-base = p-tot-sum
     8970               v-tot-rubl = v-tot-base * libthpos_chk-context.a-cash-rate / libthpos_chk-context.a-cash-scale
     8971               .
     8972             end.
     8973             else do:
     8974               find  LAST buf_curr-shop NO-LOCK WHERE
     8975                             buf_curr-shop.obj-type = libthpos_context.obj-type
     8976                         AND buf_curr-shop.obj-code = libthpos_context.obj-code
     8977                         AND buf_curr-shop.curr-code = p-curr-code
     8978                         AND ( ( buf_curr-shop.exch-date = v-today
     8979                               AND
     8980                               buf_curr-shop.exch-time <= v-time ) OR
     8981                               buf_curr-shop.exch-date < v-today ) NO-ERROR .
     8982               if available buf_curr-shop then do:
     8983                 assign
     8984                 v-exch-rate = buf_curr-shop.exch-rate
     8985                 v-exch-scale = buf_curr-shop.exch-scale
     8986                 v-exch-date  = buf_curr-shop.exch-date
     8987                 v-exch-time  = buf_curr-shop.exch-time
     8988                 .
     8989               end.
     8990               else do:
     8991                 v-err-mess = substitute("Не найден курс валюты с кодом &1 для &2&3 на &4 &5"
     8992                           , p-curr-code
     8993                           , libthpos_context.obj-type
     8994                           , libthpos_context.obj-code
     8995                           , string(v-today, "99/99/9999")
     8996                           , string(v-time, "HH:MM:SS")
     8997                         ).
     8998                 undo main-block, retry main-block.
     8999               end.
     9000   define variable vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9001   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     9002     (input  p-curr-code
     9003     ,input  v-today
     9004     ,output v-bank-rate
     9005     ,output v-bank-scale
     9006     ,output v-bank-abbr
     9007     ) no-error .
     9008               if error-status:error then do:
     9009                 v-err-mess = substitute("Ошибка при определении курса валюты с кодом &1 на &2", p-curr-code, string(v-today, "99/99/9999")).
     9010                 undo main-block, retry main-block.
     9011               end.
     9012               assign
     9013               v-tot-rubl = v-tot-sum * buf_curr-shop.exch-rate / buf_curr-shop.exch-scale
     9014               v-tot-base = v-tot-rubl / libthpos_chk-context.cash-rate * libthpos_chk-context.cash-scale
     9015               .
     9016             end.
     9017           end.
     9018         end.
     9019         when 'ИЗМЕНЕНИЕ':U
     9020         or
     9021         when 'удаление':U then do:
     9022           for first buf_chk-pay share-lock where
     9023                   buf_chk-pay.doc-code = p-doc-code
     9024               and buf_chk-pay.line-num = p-line-num,
     9025               first buf_libthpos_chk-pay where
     9026                   buf_libthpos_chk-pay.doc-code = p-doc-code
     9027               and buf_libthpos_chk-pay.line-num = p-line-num
     9028           on error  undo main-block, retry main-block
     9029           on stop   undo main-block, retry main-block
     9030           on endkey undo main-block, retry main-block
     9031           :
     9032             leave.
     9033           end.
     9034           if not available buf_chk-pay then do:
     9035             v-err-mess = substitute("Неверный № строки оплат чека = &1"
     9036                                         , p-line-num
     9037                                         ).
     9038             undo main-block, retry main-block.
     9039           end.
     9040           if p-cdpay-code <> buf_chk-pay.pay-code
     9041           or p-curr-code <> buf_chk-pay.curr-code
     9042           then do:
     9043             v-err-mess = substitute("Для уже имеющейся строки оплат чека (&1) нельзя изменить код типа касс. платеж и код валюты - были &2 &3"
     9044                                         , p-line-num
     9045                                         , buf_chk-pay.pay-code
     9046                                         , buf_chk-pay.curr-code
     9047                                         ).
     9048                     undo main-block, retry main-block.
     9049           end.
     9050           if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     9051             if p-par-code <> 0 then do:
     9052               find first buf_wth-par no-lock where
     9053                         buf_wth-par.par-code = p-par-code
     9054                     and buf_wth-par.wth-code = buf_libthpos_chk-pay.wth-code no-error.
     9055               if not available buf_wth-par then do:
     9056                 v-err-mess = substitute("Не найден номинал с кодом &1 для МЦ с кодом &2 для типа кассового платежа с кодом &3 и валютой &4"
     9057                                                         , p-par-code
     9058                                                         , buf_cash-pay.wth-code
     9059                                                         , p-cdpay-code
     9060                                                         , p-curr-code).
     9061                 undo main-block, retry main-block.
     9062               end.
     9063               assign
     9064               v-src-val = buf_wth-par.par-val
     9065               v-par-rate = buf_wth-par.par-rate
     9066               .
     9067             end.
     9068           end.
     9069           assign
     9070           v-tot-sum  = p-tot-sum
     9071           .
     9072           if buf_libthpos_chk-pay.curr-code = 0 then do:
     9073             assign
     9074             v-tot-rubl = p-tot-sum
     9075             v-tot-base = (if libthpos_context.base-code = 0
     9076                           then v-tot-rubl
     9077                           else  v-tot-rubl / libthpos_chk-context.a-cash-rate *  libthpos_chk-context.a-cash-scale)
     9078               .
     9079           end.
     9080           else do:
     9081             if p-curr-code = libthpos_context.base-code then do:
     9082               assign
     9083               v-tot-base = p-tot-sum
     9084               v-tot-rubl = v-tot-base * libthpos_chk-context.a-cash-rate / libthpos_chk-context.a-cash-scale
     9085               .
     9086             end.
     9087             else do:
     9088               assign
     9089               v-tot-rubl = v-tot-sum * buf_curr-shop.exch-rate / buf_curr-shop.exch-scale
     9090               v-tot-base = v-tot-rubl / libthpos_chk-context.cash-rate * libthpos_chk-context.cash-scale
     9091               .
     9092             end.
     9093           end.
     9094           assign
     9095           v-bank-rate = buf_libthpos_chk-pay.bank-rate
     9096           v-bank-scale = buf_libthpos_chk-pay.bank-scale
     9097           v-cash-rate = buf_libthpos_chk-pay.cash-rate
     9098           v-exch-date = buf_libthpos_chk-pay.b-exch-date
     9099           v-exch-time = buf_libthpos_chk-pay.b-exch-time
     9100           v-exch-rate = buf_libthpos_chk-pay.b-exch-rate
     9101           v-exch-scale =  buf_libthpos_chk-pay.b-exch-scale
     9102           v-calc-rate = buf_libthpos_chk-pay.b-calc-rate
     9103           v-is-cash = buf_libthpos_chk-pay.is-cash
     9104           v-frpay-code = buf_libthpos_chk-pay.frpay-code
     9105           v-get-qnty-method = buf_libthpos_chk-pay.get-qnty-method
     9106           v-wth-code = buf_libthpos_chk-pay.wth-code
     9107           v-src-val = buf_libthpos_chk-pay.src-val
     9108           .
     9109         end.
     9110       end case.
     9111       if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     9112         create buf_chk-pay.
     9113         create buf_libthpos_chk-pay.
     9114         assign
     9115         buf_chk-pay.doc-code = p-doc-code
     9116         libthpos_chk-context.lnp = libthpos_chk-context.lnp + 1
     9117         libthpos_chk-context.recalc-pline-num = libthpos_chk-context.lnp + 1
     9118         buf_chk-pay.line-num = libthpos_chk-context.lnp
     9119         buf_libthpos_chk-pay.recalc-line-num = buf_chk-pay.line-num
     9120         buf_chk-pay.time-oper = v-time
     9121         buf_chk-pay.pay-code = p-cdpay-code
     9122         buf_chk-pay.curr-code = p-curr-code
     9123         buf_chk-pay.pass-pay = 0
     9124         buf_chk-pay.line-type  = ''
     9125         buf_chk-pay.pay-card = ""
     9126         buf_chk-pay.obj-type = libthpos_context.obj-type
     9127         buf_chk-pay.obj-code = libthpos_context.obj-code
     9128         buf_chk-pay.bank-rate = 1
     9129         buf_chk-pay.bank-scale = 1
     9130         buf_chk-pay.cash-rate = 1
     9131         buf_chk-pay.is-error = no
     9132         buf_chk-pay.line-sign = ((v-tot-sum > 0 ) = (libthpos_chk-context.direction > 0))
     9133         buf_chk-pay.line-type = ""
     9134         buf_chk-pay.out-code = ?
     9135         buf_chk-pay.tot-sum = 0
     9136         buf_chk-pay.pass-pay = p-pass-pay
     9137         buf_chk-pay.par-code = p-par-code
     9138         buf_chk-pay.src-val = v-src-val
     9139         buf_chk-pay.wth-code = v-wth-code
     9140         buf_libthpos_chk-pay.par-rate = v-par-rate
     9141         .
     9142         buffer-copy buf_chk-pay to buf_libthpos_chk-pay.
     9143       end.
     9144       find first buf_libthpos_cash-counter where
     9145                 buf_libthpos_cash-counter.curr-code = buf_chk-pay.curr-code
     9146             and buf_libthpos_cash-counter.pay-code = buf_chk-pay.pay-code
     9147             and buf_libthpos_cash-counter.wth-code = buf_chk-pay.wth-code
     9148             and buf_libthpos_cash-counter.par-code = buf_chk-pay.par-code
     9149                 no-error.
     9150       if not available buf_libthpos_cash-counter then do:
     9151         create buf_libthpos_cash-counter.
     9152         assign
     9153         buf_libthpos_cash-counter.curr-code = buf_chk-pay.curr-code
     9154         buf_libthpos_cash-counter.pay-code = buf_chk-pay.pay-code
     9155         buf_libthpos_cash-counter.wth-code = buf_chk-pay.wth-code
     9156         buf_libthpos_cash-counter.par-code = buf_chk-pay.par-code
     9157         .
     9158       end.
     9159       assign
     9160       buf_libthpos_cash-counter.pre-tot-sum = buf_libthpos_cash-counter.pre-tot-sum - buf_chk-pay.tot-sum
     9161       buf_libthpos_cash-counter.pre-tot-base = buf_libthpos_cash-counter.pre-tot-base - buf_libthpos_chk-pay.tot-base
     9162       buf_libthpos_cash-counter.pre-tot-rubl = buf_libthpos_cash-counter.pre-tot-rubl - buf_libthpos_chk-pay.tot-rubl
     9163       buf_libthpos_cash-counter.pre-doc-qnty = buf_libthpos_cash-counter.pre-doc-qnty - buf_chk-pay.src-qnty
     9164       buf_libthpos_cash-counter.pre-tot-lines = buf_libthpos_cash-counter.pre-tot-lines - 1
     9165       libthpos_context.pre-cash-counter = (if buf_libthpos_cash-counter.is-cash
     9166                                           then (libthpos_context.pre-cash-counter -
     9167                                                   (if libthpos_context.r-b = 'rubl':U
     9168                                                   then buf_libthpos_chk-pay.tot-rubl
     9169                                                   else buf_libthpos_chk-pay.tot-base)
     9170                                                 )
     9171                                                 else libthpos_context.pre-cash-counter)
     9172       .
     9173       assign
     9174       libthpos_chk-context.netto = libthpos_chk-context.netto - buf_libthpos_chk-pay.tot-sum * buf_libthpos_chk-pay.cash-rate
     9175       .
     9176       assign
     9177       buf_libthpos_chk-pay.is-cash = v-is-cash
     9178       buf_libthpos_chk-pay.get-qnty-method = v-get-qnty-method
     9179       buf_libthpos_chk-pay.par-rate = v-par-rate
     9180       buf_libthpos_chk-pay.wth-code = v-wth-code
     9181       buf_libthpos_chk-pay.frpay-code = v-frpay-code
     9182       buf_libthpos_chk-pay.tot-base = v-tot-base
     9183       buf_libthpos_chk-pay.tot-rubl = v-tot-rubl
     9184       buf_libthpos_chk-pay.tot-sum = v-tot-sum
     9185       buf_libthpos_chk-pay.bank-rate = v-bank-rate
     9186       buf_libthpos_chk-pay.bank-scale = v-bank-scale
     9187       buf_libthpos_chk-pay.cash-rate = v-cash-rate
     9188       buf_libthpos_chk-pay.b-exch-date = v-exch-date
     9189       buf_libthpos_chk-pay.b-exch-time = v-exch-time
     9190       buf_libthpos_chk-pay.b-exch-rate = v-exch-rate
     9191       buf_libthpos_chk-pay.b-exch-scale = v-exch-scale
     9192       buf_libthpos_chk-pay.b-calc-rate = v-calc-rate
     9193       buf_chk-pay.tot-sum = v-tot-sum
     9194       buf_chk-pay.src-qnty = p-src-qnty
     9195       buf_chk-pay.bank-rate = v-bank-rate
     9196       buf_chk-pay.bank-scale = v-bank-scale
     9197       buf_chk-pay.cash-rate = v-cash-rate
     9198       buf_chk-pay.pass-pay = p-pass-pay
     9199       buf_libthpos_chk-pay.pass-pay = p-pass-pay
     9200       buf_chk-pay.time-oper = v-time
     9201       buf_chk-pay.line-sign = (if libthpos_chk-context.chk-type = integer('1':U)
     9202                                 then (buf_chk-pay.tot-sum >= 0)
     9203                                 else (buf_chk-pay.tot-sum <= 0)
     9204                           )
     9205       .
     9206       assign
     9207       libthpos_chk-context.netto = libthpos_chk-context.netto + buf_libthpos_chk-pay.tot-sum * buf_libthpos_chk-pay.cash-rate
     9208       .
     9209       assign
     9210       buf_libthpos_cash-counter.pre-tot-sum = buf_libthpos_cash-counter.pre-tot-sum + buf_chk-pay.tot-sum
     9211       buf_libthpos_cash-counter.pre-tot-base = buf_libthpos_cash-counter.pre-tot-base + buf_libthpos_chk-pay.tot-base
     9212       buf_libthpos_cash-counter.pre-tot-rubl = buf_libthpos_cash-counter.pre-tot-rubl + buf_libthpos_chk-pay.tot-rubl
     9213       buf_libthpos_cash-counter.pre-tot-lines = buf_libthpos_cash-counter.pre-tot-lines + 1
     9214       buf_libthpos_cash-counter.pre-doc-qnty = buf_libthpos_cash-counter.pre-doc-qnty + buf_chk-pay.src-qnty
     9215       libthpos_context.pre-cash-counter = (if buf_libthpos_chk-pay.is-cash
     9216                                           then  (libthpos_context.pre-cash-counter +
     9217                                               (if libthpos_context.r-b = 'rubl':U
     9218                                               then buf_libthpos_chk-pay.tot-rubl
     9219                                               else buf_libthpos_chk-pay.tot-base)
     9220                                               )
     9221                                               else libthpos_context.pre-cash-counter)
     9222       .
     9223       assign
     9224       libthpos_chk-context.step =  if libthpos_chk-context.step = 0
     9225                                   then 3
     9226                                   else libthpos_chk-context.step
     9227       .
     9228       if p-mode = 'удаление':U
     9229       and buf_chk-pay.tot-sum = 0 then do:
     9230         delete buf_chk-pay.
     9231         delete buf_libthpos_chk-pay.
     9232         find last buf2_libthpos_chk-pay where
     9233                 buf2_libthpos_chk-pay.doc-code = libthpos_chk-context.doc-code use-index ln no-error.
     9234         assign
     9235         libthpos_chk-context.lnp = (if available buf_libthpos_chk-pay
     9236                                     then buf_libthpos_chk-pay.line-num
     9237                                     else 0)
     9238         libthpos_chk-context.recalc-pline-num = libthpos_chk-context.lnp + 1
     9239         .
     9240         if libthpos_chk-context.lnp = 0 then do:
     9241           libthpos_chk-context.step =  if libthpos_chk-context.step = 3
     9242                                       then 0
     9243                                       else libthpos_chk-context.step.
     9244         end.
     9245         run printbuffer in this-procedure ( input (buffer libthpos_chk-context:handle)).
     9246       end.
     9247       if available buf_libthpos_chk-pay then do:
     9248         assign
     9249         buf_libthpos_chk-pay.b-exch-date = v-exch-date
     9250         buf_libthpos_chk-pay.b-exch-time = v-exch-time
     9251         buf_libthpos_chk-pay.b-exch-rate = v-exch-rate
     9252         buf_libthpos_chk-pay.b-exch-scale = v-exch-scale
     9253         buf_libthpos_chk-pay.b-calc-rate = v-calc-rate
     9254         .
     9255       end.
     9256       assign
     9257       p-frpay-code = v-frpay-code
     9258       p-tot-sum = v-tot-sum
     9259       p-tot-rubl = v-tot-rubl
     9260       p-tot-base = v-tot-base
     9261       p-get-qnty-method = v-get-qnty-method
     9262       p-setted = yes
     9263       .
     9264       if available buf_libthpos_chk-pay then do:
     9265         run printbuffer in this-procedure ( input (buffer buf_chk-pay:handle)).
     9266         run printbuffer in this-procedure ( input (buffer buf_libthpos_chk-pay:handle)).
     9267       end.
     9268       run printbuffer in this-procedure ( input (buffer libthpos_chk-context:handle)).
     9269       dataset libthpos_receipt:accept-changes.
     9270     end.
     9271   end.
     9272   end procedure.
     9273   procedure libthpos_getcheck :
     9274   define input  parameter p-doc-code as character no-undo .
     9275   define input  parameter p-close-check as logical no-undo .
     9276   define buffer buf_libthpos_cash-counter for libthpos_cash-counter.
     9277   define buffer buf_libthpos_chk-gds for libthpos_chk-gds.
     9278   define variable v-doc-code as character no-undo .
     9279   define variable v-err-mess as character no-undo .
     9280   define variable v-chk-type as integer no-undo .
     9281   define buffer buf_chk-doc for ub.chk-doc.
     9282   main-block:
     9283   do
     9284   on error undo main-block, retry main-block
     9285   on stop undo main-block, retry main-block
     9286   on endkey undo main-block, retry main-block
     9287   :
     9288     if retry then do:
     9289       if v-err-mess = '' then do:
     9290         v-err-mess = substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     9291       end.
     9292       session:set-wait-state("").
     9293       dataset libthpos_receipt:reject-changes.
     9294       return error v-err-mess.
     9295     end.
     9296     else do:
     9297       session:set-wait-state("GENERAL").
     9298       if not available libthpos_chk-context then do:
     9299         find first libthpos_chk-context no-error.
     9300       end.
     9301       if not available libthpos_chk-context then do:
     9302         v-err-mess = substitute("Не выставлен контекст чека").
     9303         undo main-block, retry main-block.
     9304       end.
     9305       if libthpos_chk-context.doc-code <> p-doc-code then do:
     9306         v-err-mess = substitute("Неверный номер чека = &1", p-doc-code).
     9307         undo main-block, retry main-block.
     9308       end.
     9309       if libthpos_chk-context.with-atr1-sum < libthpos_chk-context.change-sum
     9310       and libthpos_chk-context.direction > 0
     9311       and lookup(string(libthpos_chk-context.chk-type), '2,3,4,5,7':U) = 0
     9312       and lookup(string(libthpos_chk-context.chk-type), '8,108,208':U) = 0
     9313       and lookup(string(libthpos_chk-context.chk-type), '201,206,208,301,306':U) = 0
     9314       and lookup(string(libthpos_chk-context.chk-type), '14,15,16,17,36':U) = 0
     9315       and lookup(string(libthpos_chk-context.chk-type), '14,15,16,17,36':U) = 0
     9316       and lookup(string(libthpos_chk-context.chk-type), '12,13,40,112,113':U) = 0
     9317       then do:
     9318         v-err-mess = substitute("Нельзя закрыть чек &1 - Сумма сдачи (&2) в чеке превышает сумму платежей (&3), на которые сдача разрешена"
     9319                                               , libthpos_chk-context.change-sum
     9320                                               , libthpos_chk-context.with-atr1-sum
     9321                                               , p-doc-code).
     9322         undo main-block, retry main-block.
     9323       end.
     9324       if libthpos_chk-context.manual-discnt-sum >= libthpos_chk-context.src-tot-doc
     9325       and lookup(string(libthpos_chk-context.chk-type), '14,15,16,36,,17,11,12,13,40,114,115,116,117,111,112,136,,113,8,108,208,2,3,4,5,7':U) = 0
     9326       and lookup(string(libthpos_chk-context.chk-type), '6,69,96,106,169,196,206':U) = 0
     9327       then do:
     9328         v-err-mess = substitute("Нельзя закрыть чек &1 - сумма всех ручных скидок &2 >= суммы брутто &3"
     9329                                                   , p-doc-code
     9330                                                   , libthpos_chk-context.manual-discnt-sum
     9331                                                   , libthpos_chk-context.src-tot-doc
     9332                                                   ).
     9333         undo main-block, retry main-block.
     9334       end.
     9335       if libthpos_chk-context.discnt >= libthpos_chk-context.src-tot-doc
     9336       and lookup(string(libthpos_chk-context.chk-type), '14,15,16,36,,17,11,12,13,40,114,115,116,117,111,112,136,,113,8,108,208,2,3,4,5,7':U) = 0
     9337       and lookup(string(libthpos_chk-context.chk-type), '6,69,96,106,169,196,206':U) = 0
     9338       then do:
     9339         v-err-mess = substitute("Нельзя закрыть чек &1 - сумма скидок &2 >= суммы брутто &3"
     9340                                                   , p-doc-code
     9341                                                   , libthpos_chk-context.discnt
     9342                                                   , libthpos_chk-context.src-tot-doc
     9343                                                   ).
     9344             undo main-block, retry main-block.
     9345       end.
     9346       if libthpos_context.salesman-mandatory > 0
     9347       and lookup(string(libthpos_chk-context.chk-type), '2,3,4,5,7':U) = 0
     9348       and lookup(string(libthpos_chk-context.chk-type), '8,108,208':U) = 0
     9349       and lookup(string(libthpos_chk-context.chk-type), '201,206,208,301,306':U) = 0
     9350       and lookup(string(libthpos_chk-context.chk-type), '14,15,16,17,36':U) = 0
     9351       and lookup(string(libthpos_chk-context.chk-type), '12,13,40,112,113':U) = 0
     9352       then do:
     9353         for each buf_libthpos_chk-gds where
     9354                 buf_libthpos_chk-gds.doc-code = libthpos_chk-context.doc-code:
     9355           if buf_libthpos_chk-gds.salesman = 0
     9356           or buf_libthpos_chk-gds.salesman = ? then do:
     9357             v-err-mess = substitute("Нельзя закрыть чек &1 - в одной или нескольких строках чека НЕ УКАЗАН ПРОДАВЕЦ").
     9358             undo main-block, retry main-block.
     9359           end.
     9360         end.
     9361       end.
     9362       if libthpos_chk-context.getcheck > 0 then do:
     9363         run libthpos_prepare-getcheck in this-procedure ( input p-doc-code) no-error.
     9364         if error-status:error then do:
     9365           v-err-mess = substitute("Ошибки при постобработке чека = &1&2&3&2&4"
     9366                                                   , p-doc-code
     9367                                                   , chr(10)
     9368                                                   , error-status:get-message(1)
     9369                                                   , return-value
     9370                                                   ).
     9371           undo main-block, retry main-block.
     9372         end.
     9373       end.
     9374       libthpos_chk-context.getcheck = libthpos_chk-context.getcheck + 1.
     9375       if libthpos_chk-context.step < 3
     9376       and lookup(string(libthpos_chk-context.chk-type), '14,15,16,17,11,13,40,114,115,116,136,,117,111,113,201,206,208,301,306':U) = 0
     9377       and lookup(string(libthpos_chk-context.chk-type), '8,108,208':U) = 0
     9378       and lookup(string(libthpos_chk-context.chk-type), '201,206,208,301,306':U) = 0
     9379       and lookup(string(libthpos_chk-context.chk-type), '2,3,4,5,7':U) = 0
     9380       and lookup(string(libthpos_chk-context.chk-type), '14,15,16,17,36':U) = 0
     9381       and libthpos_chk-context.chk-type  <> integer('12':U)
     9382       and libthpos_chk-context.chk-type  <> integer('112':U)
     9383       then do:
     9384         v-err-mess = substitute("Чек &1 еще не закончен", p-doc-code).
     9385         undo main-block, retry main-block.
     9386       end.
     9387       v-doc-code = libthpos_chk-context.doc-code.
     9388       v-chk-type = libthpos_chk-context.chk-type.
     9389       if lookup(string(libthpos_chk-context.chk-type), '2,3,4,5,7':U) > 0 then do:
     9390   define variable vss-include-info58 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9391   if (valid-handle(g#libchkvl) <> true) then do:   run str/libchkvl.p persistent no-error .   if error-status :error or (valid-handle(g#libchkvl) <> true) then do:     message       "Error starting nws/libchkvl.p" skip       g#libchkvl skip       g#libchkvl :type skip       g#libchkvl :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libchkvl_getwcheck in g#libchkvl
     9392     (input  buffer libthpos_context:handle
     9393     ,input  'ДОБАВЛЕНИЕ':U
     9394     ,input  ''
     9395     ,input  p-close-check
     9396     ,input  yes
     9397     ,input  libthpos_chk-context.netto
     9398     ,input-output v-doc-code
     9399       ) no-error .
     9400       end.
     9401       else do:
     9402   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9403   if (valid-handle(g#libchkvl) <> true) then do:   run str/libchkvl.p persistent no-error .   if error-status :error or (valid-handle(g#libchkvl) <> true) then do:     message       "Error starting nws/libchkvl.p" skip       g#libchkvl skip       g#libchkvl :type skip       g#libchkvl :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libchkvl_getcheck in g#libchkvl
     9404     (input  buffer libthpos_context:handle
     9405     ,input  'ДОБАВЛЕНИЕ':U
     9406     ,input  ''
     9407     ,input  p-close-check
     9408     ,input  yes
     9409     ,input  libthpos_chk-context.netto
     9410     ,input  libthpos_chk-context.lng
     9411     ,input  libthpos_chk-context.tot-discnt + libthpos_chk-context.pay-discnt
     9412     ,input  libthpos_chk-context.discnt-id
     9413     ,input-output v-doc-code
     9414       ) no-error .
     9415       end.
     9416       if error-status:error then do:
     9417         v-err-mess = substitute("Ошибка при валидации чека &1&2&3&2&4"
     9418                                                 , p-doc-code
     9419                                                 , chr(10)
     9420                                                 , error-status:get-message(1)
     9421                                                 , return-value ).
     9422         undo main-block, retry main-block.
     9423       end.
     9424       if p-close-check then do:
     9425         run libthpos_write-cash-counter in this-procedure no-error.
     9426         if error-status:error then do:
     9427           v-err-mess = substitute("&1&2&3", error-status:get-message(1), chr(10), return-value ).
     9428           undo main-block, retry main-block.
     9429         end.
     9430         release locked_chk-doc no-error.
     9431         if not available libthpos_chk-context then do:
     9432           find first libthpos_chk-context.
     9433         end.
     9434         if not available libthpos_chk-context then do:
     9435           find first libthpos_chk-context.
     9436           if available libthpos_chk-context then do:
     9437             run libthpos_print-dataset in this-procedure ( input no).
     9438             delete libthpos_chk-context.
     9439           end.
     9440         end.
     9441       end.
     9442       else do:
     9443       end.
     9444       dataset libthpos_receipt:accept-changes.
     9445       if p-close-check = yes then do:
     9446         run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-context:table-handle)
     9447                                                         , input no).
     9448         run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-pay:table-handle)
     9449                                                         , input no).
     9450         run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-gds:table-handle)
     9451                                                         , input no).
     9452         run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-discnt:table-handle)
     9453                                                         , input no).
     9454       end.
     9455       session:set-wait-state("").
     9456     end.
     9457   end.
     9458   if p-close-check then do:
     9459     run libthpos_process-sale in this-procedure ( input v-chk-type
     9460                                                 ,input v-doc-code) no-error.
     9461   end.
     9462   end procedure.
     9463   procedure libthpos_close-check :
     9464   define input  parameter p-doc-code as character no-undo .
     9465   define input  parameter p-chk-num as integer no-undo .
     9466   define variable v-err-mess as character no-undo .
     9467   define variable v-chk-type as integer no-undo .
     9468   define variable v-doc-code as character no-undo .
     9469   define buffer buf_chk-doc for ub.chk-doc.
     9470   define buffer buf_libthpos_cash-counter for libthpos_cash-counter.
     9471   main-block:
     9472   do
     9473   on error undo main-block, retry main-block
     9474   on stop undo main-block, retry main-block
     9475   on endkey undo main-block, retry main-block
     9476   :
     9477     if retry then do:
     9478       session:set-wait-state("").
     9479       if v-err-mess = '' then do:
     9480         v-err-mess = substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     9481       end.
     9482       dataset libthpos_receipt:reject-changes.
     9483       return error v-err-mess.
     9484     end.
     9485     else do:
     9486       session:set-wait-state("GENERAL").
     9487       if not available libthpos_chk-context then do:
     9488         find first libthpos_chk-context no-error.
     9489       end.
     9490       if not available libthpos_chk-context then do:
     9491         v-err-mess = substitute("Не выставлен контекст чека").
     9492         undo main-block, retry main-block.
     9493       end.
     9494       if libthpos_chk-context.doc-code <> p-doc-code then do:
     9495         v-err-mess = substitute("Неверный номер чека = &1", p-doc-code).
     9496         undo main-block, retry main-block.
     9497       end.
     9498       find first buf_chk-doc share-lock where
     9499               buf_chk-doc.doc-code = p-doc-code.
     9500       assign
     9501       buf_chk-doc.office = trim(replace(replace(buf_chk-doc.office, 'готов':U, ''), chr(44) + chr(44), chr(44)), chr(44))
     9502       buf_chk-doc.chk-num  = p-chk-num
     9503       v-chk-type = buf_chk-doc.chk-type
     9504       v-doc-code = buf_chk-doc.doc-code
     9505       .
     9506       run libthpos_write-cash-counter in this-procedure no-error.
     9507       if error-status:error then do:
     9508         v-err-mess = substitute("&1&2&3", error-status:get-message(1), chr(10), return-value ).
     9509         undo main-block, retry main-block.
     9510       end.
     9511       release buf_chk-doc no-error.
     9512       release locked_chk-doc no-error.
     9513       if not available libthpos_chk-context then do:
     9514         find first libthpos_chk-context.
     9515         if available libthpos_chk-context then do:
     9516           run libthpos_print-dataset in this-procedure ( input no).
     9517           delete libthpos_chk-context.
     9518         end.
     9519       end.
     9520       dataset libthpos_receipt:accept-changes.
     9521       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-context:table-handle)
     9522                                                       , input no).
     9523       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-pay:table-handle)
     9524                                                       , input no).
     9525       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-gds:table-handle)
     9526                                                       , input no).
     9527       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-discnt:table-handle)
     9528                                                       , input no).
     9529       session:set-wait-state("").
     9530     end.
     9531   end.
     9532   run libthpos_process-sale in this-procedure ( input v-chk-type
     9533                                                ,input v-doc-code) no-error.
     9534   end procedure.
     9535   procedure libthpos_annulate :
     9536   define input  parameter p-doc-code as character no-undo .
     9537   define input  parameter p-chk-num as integer no-undo .
     9538   define variable v-err-mess as character no-undo .
     9539   define variable v-chk-type as integer no-undo .
     9540   define variable v-doc-code as character no-undo .
     9541   main-block:
     9542   do
     9543   on error undo main-block, retry main-block
     9544   on stop undo main-block, retry main-block
     9545   on endkey undo main-block, retry main-block
     9546   :
     9547     if retry then do:
     9548       session:set-wait-state("").
     9549       if v-err-mess = '' then do:
     9550         v-err-mess = substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     9551       end.
     9552       dataset libthpos_receipt:reject-changes.
     9553       return error v-err-mess.
     9554     end.
     9555     else do:
