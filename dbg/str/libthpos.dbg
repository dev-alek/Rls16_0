     3389   procedure print-xml:
     3390   define input parameter p-dsh as handle no-undo .
     3391   define input parameter p-file-name-without-ext as character no-undo .
     3392   define variable glog as logical no-undo .
     3393   define variable v-rowid as rowid no-undo.
     3394   define variable v-rowid-list as character no-undo .
     3395   define variable v-rowid-list2 as character no-undo .
     3396   define variable v-ii as integer no-undo .
     3397   define variable v-th as handle no-undo .
     3398   define variable v-bh as handle no-undo .
     3399   define variable v-dsh  as handle no-undo .
     3400   do
     3401   on error undo, return error
     3402   :
     3403     case p-dsh:type:
     3404       when "DATASET" then do:
     3405         do v-ii = 1 to p-dsh:num-buffers:
     3406           v-rowid-list = v-rowid-list +
     3407                           (if v-ii = 1 then '' else chr(44)) +
     3408                           (if p-dsh:get-buffer-handle(v-ii):available
     3409                           then string(p-dsh:get-buffer-handle(v-ii):rowid)
     3410                           else '').
     3411         end .
     3412         v-dsh = p-dsh.
     3413       end.
     3414       when "temp-table" then do:
     3415         if p-dsh:default-buffer-handle:available then do:
     3416           v-rowid-list = string(p-dsh:default-buffer-handle:rowid).
     3417         end.
     3418         v-dsh = p-dsh.
     3419       end.
     3420       when "buffer" then do:
     3421         if not valid-handle(p-dsh:table-handle) then do:
     3422           if p-dsh:available then do:
     3423             create temp-table v-th  .
     3424             v-th:create-like(p-dsh).
     3425             v-th:temp-table-prepare(p-dsh:table).
     3426             create buffer v-bh for table v-th.
     3427             v-bh:buffer-create().
     3428             v-bh:buffer-copy(p-dsh).
     3429             v-bh:buffer-release().
     3430             v-dsh = v-bh.
     3431           end.
     3432         end.
     3433         else do:
     3434           v-dsh = p-dsh.
     3435         end.
     3436       end.
     3437     end case.
     3438     glog = v-dsh:WRITE-XML("FILE"
     3439                           , substitute("&1.xml", p-file-name-without-ext)
     3440                           , yes
     3441                           , "windows-1251"
     3442                           , ''
     3443                           , no
     3444                           , no  ) no-error.
     3445     case p-dsh:type:
     3446       when "DATASET" then do:
     3447         do v-ii = 1 to p-dsh:num-buffers:
     3448           if entry(v-ii,v-rowid-list) <> '' then do:
     3449              glog = p-dsh:get-buffer-handle(v-ii):find-by-rowid(TO-ROWID(entry(v-ii,v-rowid-list)))  .
     3450           end.
     3451           v-rowid-list2 = v-rowid-list2 +
     3452                           (if v-ii = 1 then '' else chr(44)) +
     3453                           (if p-dsh:get-buffer-handle(v-ii):available
     3454                           then string(p-dsh:get-buffer-handle(v-ii):rowid)
     3455                           else '').
     3456         end .
     3457       end.
     3458       when "temp-table" then do:
     3459         if v-rowid-list <> '' then do:
     3460           p-dsh:default-buffer-handle:find-by-rowid(to-rowid(v-rowid-list)).
     3461         end.
     3462       end.
     3463       when "buffer" then do:
     3464         if not valid-handle(p-dsh:table-handle) then do:
     3465           delete object v-bh.
     3466           delete object v-th.
     3467         end.
     3468       end.
     3469     end case.
     3470   end.
     3471   end procedure.
     3472   define new global shared variable g#lib-log as handle no-undo .
     3473   if valid-handle (g#libthpos)
     3474   and g#libthpos <> this-procedure :handle
     3475   and g#libthpos :get-signature('libthpos_clear-cda':u) <> ""
     3476   then do:
     3477     message
     3478       vss-workfile vss-revision vss-description skip
     3479       "Попытка повторной загрузки библиотеки для работы с POS IBS TH" skip
     3480       g#libthpos skip
     3481       g#libthpos :type skip
     3482       g#libthpos :file-name skip
     3483       valid-handle(g#libthpos) skip
     3484       this-procedure :handle skip
     3485       this-procedure :type skip
     3486       this-procedure :file-name skip
     3487       valid-handle(this-procedure) skip
     3488       view-as alert-box error .
     3489     undo, return error .
     3490   end.
     3491   else do:
     3492     assign
     3493       g#libthpos = this-procedure :handle
     3494     .
     3495   end.
     3496   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3497   define  temp-table libthpos_context  no-undo
     3498   field parparentproc       as widget-handle
     3499   field p-log-handle        as handle
     3500   field p-log-file-name     as character
     3501   field view-log            as logical
     3502   field ll                  as integer
     3503   field tt-wd-bh            as handle
     3504   field pos-type            as character
     3505   field cash-num            as integer
     3506   field obj-type            as character init 'маг':U
     3507   field obj-code            as integer
     3508   field db-num              as integer
     3509   field r-b                 as character
     3510   field host-code           as integer
     3511   field base-code           as integer
     3512   field cre-pay             as integer
     3513   field is-catering         as logical
     3514   field is-cdinv            as logical
     3515   field is-ptrl             as logical
     3516   field is-wth              as logical
     3517   field process-sale        as logical
