     8012                                                         , p-cdpay-code
     8013                                                         , p-curr-code).
     8014               undo main-block, retry main-block.
     8015             end.
     8016           end.
     8017         end.
     8018         when 'ИЗМЕНЕНИЕ':U
     8019         or
