     3687   DEFINE TEMP-TABLE libthpos_temp-cash-pay-list
     3688   FIELD cdpay-code AS INTEGER
     3689   FIELD curr-code AS INTEGER
     3690   FIELD frpay-code AS INTEGER
     3691   INDEX pi IS UNIQUE PRIMARY
     3692   cdpay-code curr-code
     3693   INDEX ifr frpay-code
     3694       .
     3695   DEFINE TEMP-TABLE libthpos_temp-pay-names
     3696   FIELD frpay-code AS INTEGER
     3697   FIELD frpay-name AS CHARACTER
     3698   INDEX pi IS UNIQUE PRIMARY frpay-code.
     3699   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3700   procedure libthpos_get-cash-pay-list :
     3701   define input parameter p-cp-list as character no-undo .
     3702   define variable v-ii as integer no-undo .
     3703   define variable v-jj as integer no-undo .
     3704   define variable v-dop1 as character no-undo .
     3705   define variable v-fr-code as integer no-undo .
     3706   define variable v-cp-list as character no-undo .
     3707   define buffer buf_temp-cash-pay-list for libthpos_temp-cash-pay-list.
     3708   do
     3709   on error undo, return error
     3710   :
     3711     DO v-ii = 1 TO num-entries(p-cp-list, chr(4)):
     3712       v-dop1 = ENTRY(v-ii, p-cp-list, chr(4)).
     3713       ASSIGN
     3714       v-fr-code = INTEGER(ENTRY(1, v-dop1, "="))
     3715       v-cp-list = ENTRY(2, v-dop1, "=")
     3716       NO-ERROR.
     3717       IF v-fr-code >= 2
     3718       AND v-fr-code <= 4 THEN DO:
     3719         DO v-jj = 1 TO num-entries(v-cp-list, ";"):
     3720           FIND FIRST buf_temp-cash-pay-list WHERE
     3721                     buf_temp-cash-pay-list.cdpay-code = integer(ENTRY(1, ENTRY(v-jj, v-cp-list, ";"), chr(58)))
     3722               AND buf_temp-cash-pay-list.curr-code = integer(ENTRY(2, ENTRY(v-jj, v-cp-list, ";"), chr(58))) NO-ERROR.
     3723           IF NOT AVAILABLE buf_temp-cash-pay-list THEN DO:
     3724             CREATE buf_temp-cash-pay-list.
     3725             ASSIGN
     3726             buf_temp-cash-pay-list.cdpay-code = integer(ENTRY(1, ENTRY(v-jj, v-cp-list, ";"), chr(58)))
     3727             buf_temp-cash-pay-list.curr-code = integer(ENTRY(2, ENTRY(v-jj, v-cp-list, ";"), chr(58)))
     3728             buf_temp-cash-pay-list.frpay-code = v-fr-code
     3729             .
     3730           END.
     3731         end.
     3732       end.
     3733     end.
     3734   END.
     3735   end procedure.
     3736   procedure libthpos_get-pay-names :
     3737   define input parameter p-pay-names-list as character no-undo .
     3738   define variable v-ii as integer no-undo .
     3739   define variable v-fr-code as integer no-undo .
     3740   define variable v-name as character no-undo .
     3741   define buffer buf_temp-pay-names for libthpos_temp-pay-names.
     3742   do
     3743   on error undo, return error
     3744   :
     3745     DO v-ii = 1 TO num-entries(p-pay-names-list, chr(4)):
     3746       ASSIGN
     3747       v-fr-code = v-ii + 1
     3748       v-name = ENTRY(v-ii, p-pay-names-list, chr(4))
     3749       NO-ERROR.
     3750       IF v-fr-code >= 2
     3751       AND v-fr-code <= 4 THEN DO:
     3752         FIND FIRST buf_temp-pay-names WHERE
     3753                   buf_temp-pay-names.frpay-code = v-fr-code NO-ERROR.
     3754         IF NOT AVAILABLE buf_temp-pay-names THEN DO:
     3755           CREATE buf_temp-pay-names.
     3756           ASSIGN
     3757           buf_temp-pay-names.frpay-code = v-fr-code
     3758           buf_temp-pay-names.frpay-name = v-name
     3759           .
     3760         END.
     3761       END.
     3762     END.
     3763   end.
     3764   end procedure.
     3765   procedure libthpos_set-cash-pay-list :
     3766   define output parameter p-cash-pay-list as character no-undo .
     3767   define buffer buf_temp-cash-pay-list for libthpos_temp-cash-pay-list.
     3768   do
     3769   on error undo, return error
     3770   :
     3771     FOR EACH buf_temp-cash-pay-list
     3772     BREAK BY
     3773     buf_temp-cash-pay-list.frpay-code:
     3774       IF not(buf_temp-cash-pay-list.frpay-code  >= 2
     3775            AND
     3776            buf_temp-cash-pay-list.frpay-code  <= 4) THEN DO:
     3777       undo, return error  substitute("Неверно заполнено соответствие для типа кассового платежа TH с кодом &1 и валютой &2"
     3778                  , buf_temp-cash-pay-list.cdpay-code
     3779                  , buf_temp-cash-pay-list.curr-code).
     3780       END.
     3781       IF FIRST-OF(buf_temp-cash-pay-list.frpay-code) THEN DO:
     3782         ASSIGN
     3783         p-cash-pay-list = substitute("&1&2&3="
     3784                                     ,p-cash-pay-list
     3785                                     ,chr(4)
     3786                                       ,buf_temp-cash-pay-list.frpay-code) .
     3787       END.
     3788       ASSIGN
     3789       p-cash-pay-list = substitute("&1&2:&3;"
     3790                                   ,p-cash-pay-list
     3791                                     ,buf_temp-cash-pay-list.cdpay-code
     3792                                     ,buf_temp-cash-pay-list.curr-code
     3793                                     ) .
     3794       IF last-OF(buf_temp-cash-pay-list.frpay-code) THEN DO:
     3795         ASSIGN
     3796         p-cash-pay-list = right-trim(p-cash-pay-list, ";").
     3797       END.
     3798     END.
     3799     assign
     3800     p-cash-pay-list = LEFT-TRIM(p-cash-pay-list, chr(4))
     3801     p-cash-pay-list = right-TRIM(p-cash-pay-list, ";")
     3802     .
     3803   end.
     3804   end procedure.
     3805   procedure libthpos_set-pay-names :
     3806   define output parameter p-pay-names as character no-undo .
     3807   define buffer buf_temp-pay-names for libthpos_temp-pay-names.
     3808   do
     3809   on error undo, return error
     3810   :
     3811     FOR EACH buf_temp-pay-names
     3812     BY buf_temp-pay-names.frpay-code
     3813         :
     3814       IF buf_temp-pay-names.frpay-code >= 2
     3815       OR buf_temp-pay-names.frpay-code <= 2
     3816       THEN
     3817       ASSIGN
     3818       p-pay-names = substitute("&1&2&3"
     3819                                     ,p-pay-names
     3820                                     ,chr(4)
     3821                                     ,buf_temp-pay-names.frpay-name) .
     3822     END.
     3823     ASSIGN
     3824     p-pay-names = left-trim(p-pay-names, chr(4))
     3825     .
     3826   end.
     3827   end procedure.
