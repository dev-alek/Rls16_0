     6840                                             else 0)
     6841       libthpos_chk-context.gds-netto = libthpos_chk-context.gds-netto + (if (buf_chk-gds.write-off-code = ?
     6842                                             or buf_chk-gds.write-off-code <= 0)
     6843                                             and not libthpos_chk-context.is-petrol-check
     6844                                             then
     6845                                             ( - (buf_chk-gds.src-sum - buf_libthpos_chk-gds.src-discnt-sum))
     6846                                             else 0)
     6847       libthpos_chk-context.sub-netto = libthpos_chk-context.sub-netto + (if (buf_chk-gds.write-off-code = ?
     6848                                             or buf_chk-gds.write-off-code <= 0)
     6849                                             and not libthpos_chk-context.is-petrol-check
     6850                                             then
     6851                                             ( - (buf_chk-gds.src-sum - buf_libthpos_chk-gds.src-discnt-sum))
     6852                                             else 0)
     6853       libthpos_chk-context.gds-discnt = libthpos_chk-context.gds-discnt - buf_libthpos_chk-gds.src-discnt-sum
     6854       libthpos_chk-context.discnt = libthpos_chk-context.discnt - buf_libthpos_chk-gds.src-discnt-sum
     6855       libthpos_chk-context.gds-r = libthpos_chk-context.gds-r - buf_libthpos_chk-gds.r-sum
     6856       .
     6857       assign
     6858       buf_chk-gds.src-price = truncate(v-sale-price-r-b, 2)
     6859       buf_libthpos_chk-gds.src-price-rubl = truncate(v-sale-price-rubl, 2)
     6860       buf_chk-gds.src-qnty = p-src-qnty
     6861       buf_chk-gds.pass-gds = p-pass-gds
     6862       buf_chk-gds.pump = p-pump
     6863       buf_chk-gds.nozzle-code = p-nozzle-code
     6864       buf_chk-gds.src-pl-code = p-pl-code
     6865       buf_chk-gds.write-off-code = p-write-off-code
     6866       buf_chk-gds.depart-id = p-depart-id
     6867       buf_chk-gds.doc-qnty = 0
     6868       buf_chk-gds.price-service = 0
     6869       buf_chk-gds.time-oper = v-time
     6870       buf_chk-gds.road-tax = (if libthpos_context.r-b = 'rubl':U
     6871                               then v-road-tax-rubl
     6872                               else v-road-tax-base)
     6873       buf_chk-gds.line-sign = (if libthpos_chk-context.chk-type = integer('1':U)
     6874                                 then (buf_chk-gds.src-qnty >= 0)
     6875                                 else (buf_chk-gds.src-qnty <= 0)
     6876                           )
     6877       buf_chk-gds.src-sum   = truncate(buf_chk-gds.src-price * buf_chk-gds.src-qnty, 2)
     6878       buf_libthpos_chk-gds.src-sum-rubl = truncate(buf_libthpos_chk-gds.src-price-rubl * buf_chk-gds.src-qnty, 2)
     6879       buf_chk-gds.src-discnt = 0
     6880       buf_libthpos_chk-gds.src-discnt = 0
     6881       buf_libthpos_chk-gds.src-discnt-rubl = 0
     6882       buf_libthpos_chk-gds.src-discnt-sum = 0
     6883       buf_libthpos_chk-gds.src-discnt-sum-rubl = 0
     6884       buf_libthpos_chk-gds.src-price-netto = buf_libthpos_chk-gds.src-price
     6885       buf_libthpos_chk-gds.price-base-netto = buf_libthpos_chk-gds.src-price-netto * v-cli-base-rate
     6886       buf_libthpos_chk-gds.will-doc-qnty = p-src-qnty * v-cli-base-rate
     6887       .
     6888       if libthpos_chk-context.chk-type = integer('17':U) then do:
     6889         assign
     6890         buf_chk-gds.write-off-code =  integer('17':U)
     6891         .
     6892       end.
     6893       else  do:
     6894         assign
     6895         buf_chk-gds.write-off-code = (if v-no-add-price
     6896                                       then (if lookup(string(libthpos_chk-context.chk-type), '1,69,14,15,16,36':U) > 0
     6897                                           then integer('1':U)
     6898                                           else integer('-6':U)
     6899                                         )
     6900                                         else 0
     6901                                       )
     6902         .
     6903       end.
     6904       buffer-copy buf_chk-gds to buf_libthpos_chk-gds.
     6905       if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     6906         assign
     6907         buf_libthpos_chk-gds.start-src-price = truncate(v-sale-price-r-b, 2)
     6908         buf_libthpos_chk-gds.src-price-netto = buf_chk-gds.src-price
     6909         buf_libthpos_chk-gds.price-base-netto = buf_libthpos_chk-gds.src-price-netto * v-cli-base-rate
     6910         buf_libthpos_chk-gds.will-price-base  = buf_libthpos_chk-gds.start-src-price * v-cli-base-rate
     6911         buf_libthpos_chk-gds.main-bar-code = v-main-bar-code
     6912         buf_libthpos_chk-gds.gds-code = v-gds-code
     6913         buf_libthpos_Chk-gds.unit-base  = v-unit-base
     6914         buf_libthpos_chk-gds.unit-cli   = v-unit-cli
     6915         buf_libthpos_chk-gds.unit-base-type        = v-unit-base-type
     6916         buf_libthpos_chk-gds.unit-cli-type    = v-unit-cli-type
     6917         buf_libthpos_chk-gds.min-rate = v-min-rate
     6918         buf_libthpos_chk-gds.max-rate = v-max-rate
     6919         buf_libthpos_chk-gds.in-code  = v-in-code
     6920         buf_libthpos_chk-gds.part-code  = v-part-code
     6921         buf_libthpos_chk-gds.cash-parts  = v-cash-parts
     6922         buf_libthpos_chk-gds.node-code = v-node-code
     6923         buf_libthpos_chk-gds.root-node-code = root_gds-prt.node-code
     6924         buf_libthpos_chk-gds.prt-root = buf_goods.prt-root
     6925         buf_libthpos_chk-gds.empty-scale = v-empty-scale
     6926         buf_libthpos_chk-gds.chk-name = v-chk-name
     6927         buf_libthpos_chk-gds.second-name =   v-second-name
     6928         buf_libthpos_chk-gds.is-weight-pbc = v-is-weight-pbc
     6929         buf_libthpos_chk-gds.is-pgweight-pbc = v-is-pgweight-pbc
     6930         buf_libthpos_chk-gds.will-doc-qnty = v-doc-qnty
     6931         buf_libthpos_chk-gds.cli-base-rate = v-cli-base-rate
     6932         buf_libthpos_chk-gds.sum-grp-code = v-sum-grp-code
     6933         buf_libthpos_chk-gds.free-price = v-free-price
     6934         buf_libthpos_chk-gds.line-direction = v-line-direction
     6935         .
     6936       end.
     6937       assign
     6938       libthpos_chk-context.src-qnty = libthpos_chk-context.src-qnty + buf_libthpos_chk-gds.src-qnty
     6939       libthpos_chk-context.src-tot-doc = libthpos_chk-context.src-tot-doc + buf_chk-gds.src-sum
     6940       libthpos_chk-context.src-tot-rubl =  (if libthpos_context.r-b = 'rubl':U
     6941                                                 or (libthpos_context.r-b = 'base':U
     6942                                                   and
     6943                                                   libthpos_context.base-code  = 0)
     6944                                               then libthpos_chk-context.src-tot-doc
     6945                                               else libthpos_chk-context.src-tot-doc * libthpos_chk-context.cash-rate / libthpos_chk-context.cash-scale)
     6946       libthpos_chk-context.src-tot-base =  (if libthpos_context.r-b = 'base':U
     6947                                                 or (libthpos_context.r-b = 'rubl':U
     6948                                                   and
     6949                                                   libthpos_context.base-code  = 0)
     6950                                               then libthpos_chk-context.src-tot-doc
     6951                                               else libthpos_chk-context.src-tot-doc / libthpos_chk-context.cash-rate * libthpos_chk-context.cash-scale)
     6952       .
     6953       if lookup(string(libthpos_chk-context.chk-type), '14,15,16,36,,17,11,12,13,40,114,115,116,117,111,112,136,,113,8,108,208,2,3,4,5,7':U) = 0
     6954       and lookup(string(libthpos_chk-context.chk-type), '6,69,96,106,169,196,206':U) = 0
     6955       and libthpos_chk-context.direction > 0
     6956       then do:
     6957         run cur-time in this-procedure ( output v-today, output v-time).
     6958         assign
     6959         v-start-src-price = v-sale-price-r-b
     6960         v-src-price = v-sale-price-r-b
     6961         v-start-src-discnt = 0
     6962         v-src-discnt = 0
     6963         .
     6964         assign
     6965         v-bh[1] = (buffer libthpos_context:handle)
     6966         v-bh[4] = (buffer buf_libthpos_chk-gds:handle)
     6967         v-bh[5] = (buffer libthpos_chk-pay:handle)
     6968         v-bh[6] = (buffer libthpos_chk-discnt:handle)
     6969         .
     6970         for each buf_libthpos_rp-by-call
     6971         on error  undo main-block, retry main-block
     6972         on stop   undo main-block, retry main-block
     6973         on endkey undo main-block, retry main-block
     6974         :
     6975           run rs_15_1 in buf_libthpos_rp-by-call.rph (
     6976                     input '':U
     6977                   ,input p-line-num
     6978                   ,input v-b-code
     6979                   ,input v-gds-code
     6980                   ,input v-sum-grp-code
     6981                   ,input v-node-code
     6982                   ,input p-src-qnty
     6983                   ,input v-doc-qnty
     6984                   ,input v-start-src-price
     6985                   ,input v-src-price
     6986                   ,input v-start-src-discnt
     6987                   ,input v-src-discnt
     6988                   ,input v-unit-base
     6989                   ,input v-unit-base-type
     6990                   ,input v-unit-cli
     6991                   ,input v-unit-cli-type
     6992                   ,input v-bh
     6993                   ,output v-new-src-price
     6994                   ,output v-new-src-discnt
     6995                       ) no-error.
     6996           if not error-status :error then do:
     6997             assign
     6998             v-src-price = v-new-src-price
     6999             v-src-discnt = v-new-src-discnt
     7000             .
     7001           end.
     7002           else do:
     7003             message
     7004             error-status:get-message(1)
     7005             return-value view-as alert-box .
     7006           end.
     7007         end.
     7008         assign
     7009         v-discnt = v-new-src-discnt
     7010         .
     7011       end.
     7012       if buf_libthpos_chk-gds.manual-discnt-id > 0
     7013       then do:
     7014         for first buf_libthpos_chk-discnt where
     7015                 buf_libthpos_chk-discnt.doc-code = p-doc-code
     7016           and  buf_libthpos_chk-discnt.record-type = 0
     7017           and  buf_libthpos_chk-discnt.line-num = p-line-num
     7018           and  buf_libthpos_chk-discnt.discnt-id = buf_libthpos_chk-gds.manual-discnt-id,
     7019           first buf_chk-discnt share-lock where
     7020                 buf_chk-discnt.doc-code = p-doc-code
     7021           and  buf_chk-discnt.record-type = 0
     7022           and  buf_chk-discnt.line-num = p-line-num
     7023           and  buf_chk-discnt.discnt-id = buf_libthpos_chk-gds.manual-discnt-id:
     7024           leave.
     7025         end.
     7026         if p-mode = 'удаление':U then do:
     7027           v-m-discnt = 0.
     7028           libthpos_chk-context.manual-discnt-sum = libthpos_chk-context.manual-discnt-sum - buf_libthpos_chk-gds.manual-discnt-sum.
     7029         end.
     7030         else do:
     7031           case buf_libthpos_chk-discnt.value-type:
     7032             when integer('1':U) then do:
     7033               assign
     7034               buf_libthpos_chk-discnt.src-price-netto = buf_libthpos_chk-gds.src-price - v-discnt
     7035               v-m-discnt = buf_libthpos_chk-discnt.src-price-netto * buf_libthpos_chk-discnt.discnt-value-pcnt / 100
     7036               buf_libthpos_chk-discnt.object-sum = buf_libthpos_chk-discnt.src-price-netto * buf_libthpos_chk-gds.src-qnty
     7037               buf_libthpos_chk-discnt.object-qnty = buf_libthpos_chk-gds.src-qnty
     7038               buf_libthpos_chk-discnt.discnt-value-abs = buf_libthpos_chk-gds.src-qnty * v-m-discnt
     7039               libthpos_chk-context.manual-discnt-sum = libthpos_chk-context.manual-discnt-sum - buf_libthpos_chk-gds.manual-discnt-sum
     7040               buf_libthpos_chk-gds.manual-discnt-sum = buf_libthpos_chk-discnt.discnt-value-abs
     7041               libthpos_chk-context.manual-discnt-sum = libthpos_chk-context.manual-discnt-sum + buf_libthpos_chk-gds.manual-discnt-sum
     7042               .
     7043             end.
     7044             when integer('10':U) then do:
     7045               assign
     7046               buf_libthpos_chk-discnt.src-price-netto = buf_libthpos_chk-gds.src-price - v-discnt
     7047               v-m-discnt = buf_libthpos_chk-discnt.discnt-value-abs / buf_libthpos_chk-gds.src-qnty
     7048               buf_libthpos_chk-discnt.object-sum = buf_libthpos_chk-discnt.src-price-netto * buf_libthpos_chk-gds.src-qnty
     7049               buf_libthpos_chk-discnt.object-qnty = buf_libthpos_chk-gds.src-qnty
     7050               buf_libthpos_chk-discnt.discnt-value-pcnt = v-m-discnt / buf_libthpos_chk-discnt.src-price-netto * 100
     7051               .
     7052             end.
     7053           end case.
     7054           buffer-copy buf_libthpos_chk-discnt to buf_chk-discnt.
     7055         end.
     7056         v-discnt = v-discnt + v-m-discnt.
     7057         if p-mode = 'удаление':U then do:
     7058           delete buf_libthpos_chk-discnt.
     7059           delete buf_chk-discnt.
     7060         end.
     7061       end.
     7062       assign
     7063       buf_chk-gds.src-discnt = truncate(v-discnt, 2)
     7064       buf_libthpos_chk-gds.src-discnt = truncate(v-discnt, 2)
     7065       buf_libthpos_chk-gds.src-price-netto = buf_libthpos_chk-gds.src-price - buf_libthpos_chk-gds.src-discnt
     7066       buf_libthpos_chk-gds.price-base-netto = buf_libthpos_chk-gds.src-price-netto * v-cli-base-rate
     7067       buf_libthpos_chk-gds.will-price-base  = buf_libthpos_chk-gds.start-src-price * v-cli-base-rate
     7068       buf_libthpos_chk-gds.src-discnt-rubl = (if libthpos_context.r-b = 'rubl':U
     7069                                               then buf_libthpos_chk-gds.src-discnt
     7070                                               else truncate(v-discnt * libthpos_chk-context.base-rate, 2 ))
     7071       .
     7072       assign
     7073       buf_libthpos_chk-gds.src-discnt-sum = truncate(buf_libthpos_chk-gds.src-qnty * buf_libthpos_chk-gds.src-discnt, 2)
     7074       buf_libthpos_chk-gds.src-discnt-sum-rubl = truncate(buf_libthpos_chk-gds.src-qnty * buf_libthpos_chk-gds.src-discnt-rubl, 2)
     7075       buf_libthpos_chk-gds.r-sum = (buf_libthpos_chk-gds.src-qnty * (v-sale-price-r-b - v-discnt)) -
     7076                                   (buf_libthpos_chk-gds.src-sum -  buf_libthpos_chk-gds.src-discnt-sum)
     7077       libthpos_chk-context.netto = libthpos_chk-context.netto + (if (p-write-off-code = ?
     7078                                             or p-write-off-code <= 0)
     7079                                             and not libthpos_chk-context.is-petrol-check
     7080                                             then (buf_chk-gds.src-sum - buf_libthpos_chk-gds.src-discnt-sum)
     7081                                             else 0)
     7082       libthpos_chk-context.gds-netto = libthpos_chk-context.gds-netto + (if (p-write-off-code = ?
     7083                                             or p-write-off-code <= 0)
     7084                                             and not libthpos_chk-context.is-petrol-check
     7085                                             then (buf_chk-gds.src-sum - buf_libthpos_chk-gds.src-discnt-sum)
     7086                                             else 0)
     7087       libthpos_chk-context.sub-netto = libthpos_chk-context.sub-netto + (if (p-write-off-code = ?
     7088                                             or p-write-off-code <= 0)
     7089                                             and not libthpos_chk-context.is-petrol-check
     7090                                             then (buf_chk-gds.src-sum - buf_libthpos_chk-gds.src-discnt-sum)
     7091                                             else 0)
     7092       libthpos_chk-context.gds-discnt = libthpos_chk-context.gds-discnt + buf_libthpos_chk-gds.src-discnt-sum
     7093       libthpos_chk-context.discnt = libthpos_chk-context.discnt + buf_libthpos_chk-gds.src-discnt-sum
     7094       libthpos_chk-context.gds-r = libthpos_chk-context.gds-r + buf_libthpos_chk-gds.r-sum
     7095       libthpos_chk-context.step =  if libthpos_chk-context.step = 0
     7096                                   then 1
     7097                                   else libthpos_chk-context.step
     7098       .
     7099       if buf_chk-gds.src-sum <= buf_libthpos_chk-gds.src-discnt-sum
     7100       and libthpos_chk-context.direction > 0
     7101       and buf_libthpos_chk-gds.src-discnt-sum > 0
     7102       and p-mode <> 'удаление':U
     7103       then do:
     7104         v-err-mess = substitute("Нельзя удалить/изменить строку &1 чека &2 - общая скидка по строке (&3) превысит сумму строки брутто (&4)"
     7105                                                 ,p-line-num
     7106                                                 ,p-doc-code
     7107                                                 ,buf_libthpos_chk-gds.src-discnt-sum
     7108                                                 ,buf_chk-gds.src-sum
     7109                                                 ).
     7110         undo main-block, retry main-block.
     7111       end.
     7112       if p-mode = 'удаление':U
     7113       and buf_chk-gds.src-qnty = 0 then do:
     7114         define variable v-recalc-line-num as integer no-undo .
     7115         v-recalc-line-num = buf_libthpos_chk-gds.recalc-line-num.
     7116         delete buf_chk-gds.
     7117         delete buf_libthpos_chk-gds.
     7118         find last buf2_libthpos_chk-gds where
     7119                 buf2_libthpos_chk-gds.doc-code = libthpos_chk-context.doc-code use-index ln no-error.
     7120         assign
     7121         libthpos_chk-context.lng = (if available buf2_libthpos_chk-gds
     7122                                   then buf2_libthpos_chk-gds.line-num
     7123                                   else 0)
     7124         libthpos_chk-context.recalc-gline-num = (if v-recalc-line-num = p-line-num
     7125                                                   then libthpos_chk-context.lng + 1
     7126                                                   else v-recalc-line-num)
     7127         .
     7128         if libthpos_chk-context.lng = 0 then do:
     7129           libthpos_chk-context.step =  if libthpos_chk-context.step = 1
     7130                                       then 0
     7131                                       else libthpos_chk-context.step.
     7132         end.
     7133         assign
     7134         p-setted = yes
     7135         p-next = (if (libthpos_chk-context.recalc-gline-num < libthpos_chk-context.lng + 1
     7136                   or libthpos_chk-context.step >  1)
     7137                     and not v-is-recalc
     7138                     then substitute("recalc=&1,&2,&3"
     7139                                     ,min(libthpos_chk-context.recalc-gline-num, libthpos_chk-context.lng)
     7140                                     ,(if libthpos_chk-context.step > 1 or p-mode = 'удаление':U then 1 else 0)
     7141                                     ,(if libthpos_chk-context.step > 2 or p-mode = 'удаление':U then 1 else 0)
     7142                                   )
     7143                     else "")
     7144         .
     7145         run printbuffer in this-procedure ( input (buffer libthpos_chk-context:handle)).
     7146       end.
     7147       else do:
     7148         assign
     7149         p-b-code = v-b-code
     7150         p-gds-code = v-gds-code
     7151         p-second-name = v-second-name
     7152         p-src-price = buf_chk-gds.src-price
     7153         p-src-price-rubl = buf_libthpos_chk-gds.src-price-rubl
     7154         p-src-discnt-sum = buf_libthpos_chk-gds.src-discnt-sum
     7155         p-src-discnt-sum-rubl = buf_libthpos_chk-gds.src-discnt-sum-rubl
     7156         p-src-sum = buf_chk-gds.src-sum
     7157         p-src-sum-rubl = buf_libthpos_chk-gds.src-sum-rubl
     7158         p-src-sum-netto = p-src-sum - p-src-discnt-sum
     7159         p-src-sum-netto-rubl = p-src-sum-rubl - p-src-discnt-sum-rubl
     7160         p-unit-base = buf_libthpos_chk-gds.unit-base
     7161         p-setted = yes
     7162         p-next = (if (libthpos_chk-context.recalc-gline-num < libthpos_chk-context.lng + 1
     7163                   or libthpos_chk-context.step >  1)
     7164                     and not v-is-recalc
     7165                     then substitute("recalc=&1,&2,&3"
     7166                                     ,min(libthpos_chk-context.recalc-gline-num, libthpos_chk-context.lng)
     7167                                     ,(if libthpos_chk-context.step > 1 or p-mode = 'удаление':U then 1 else 0)
     7168                                     ,(if libthpos_chk-context.step > 2 or p-mode = 'удаление':U then 1 else 0)
     7169                                   )
     7170                     else "")
     7171         .
     7172         run printbuffer in this-procedure ( input (buffer libthpos_chk-context:handle)).
     7173         run printbuffer in this-procedure ( input (buffer buf_chk-gds:handle)).
     7174         run printbuffer in this-procedure ( input (buffer buf_libthpos_chk-gds:handle)).
     7175       end.
     7176       if v-accept-changes then do:
     7177         dataset libthpos_receipt:accept-changes.
     7178       end.
     7179     end.
     7180   end.
     7181   end procedure.
     7182   procedure libthpos_sub-total :
     7183   define input  parameter p-doc-code as character no-undo .
     7184   define input  parameter p-mode as character no-undo .
     7185   define output parameter p-setted as logical   no-undo .
     7186   define input-output parameter p-st-r-b as decimal no-undo .
     7187   define input-output parameter p-st-rubl as decimal no-undo .
     7188   define input-output parameter p-st-base as decimal no-undo .
     7189   define input-output parameter p-tot-doc as decimal no-undo .
     7190   define input-output parameter p-st-discnt as decimal no-undo .
     7191   define output parameter p-netto as decimal no-undo .
     7192   define output parameter p-netto-rubl as decimal no-undo .
     7193   define output parameter p-netto-base as decimal no-undo .
     7194   define output parameter p-all-discnt as decimal no-undo .
     7195   define output parameter p-all-discnt-rubl as decimal no-undo .
     7196   define output parameter p-all-discnt-base as decimal no-undo .
     7197   define variable v-today as date      no-undo.
     7198   define variable v-time  as integer   no-undo.
     7199   define variable v-bank-rate as decimal no-undo .
     7200   define variable v-bank-scale as integer no-undo .
     7201   define variable v-bank-abbr as character no-undo .
     7202   define variable v-base-rate as decimal no-undo .
     7203   define variable v-cash-rate as decimal no-undo .
     7204   define variable v-cash-scale as integer no-undo .
     7205   define variable v-tot-r-b as decimal no-undo .
     7206   define variable v-tot-discnt as decimal no-undo .
     7207   define variable v-err-mess as character no-undo .
     7208   define buffer buf_curr-shop for ub.curr-shop.
     7209   define buffer buf_chk-doc for ub.chk-doc.
     7210   define buffer buf_libthpos_rp-by-call for libthpos_rp-by-call.
     7211   define buffer buf_libthpos_chk-discnt for libthpos_chk-discnt.
     7212   define buffer buf_chk-discnt for ub.chk-discnt.
     7213   main-block:
     7214   do
     7215   on error undo main-block, retry main-block
     7216   on stop undo main-block, retry main-block
     7217   on endkey undo main-block, retry main-block
     7218   :
     7219     if retry then do:
     7220       if v-err-mess = '' then do:
     7221         v-err-mess = substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     7222       end.
     7223       dataset libthpos_receipt:reject-changes.
     7224       return error v-err-mess.
     7225     end.
     7226     else do:
     7227       if not (p-mode = ''
     7228               or
     7229               p-mode = "no-changes") then do:
     7230         v-err-mess = substitute("Неверное действие над подитогом чека = &1", p-mode).
     7231         undo main-block, retry main-block.
     7232       end.
     7233       if not available libthpos_chk-context then do:
     7234         find first libthpos_chk-context no-error.
     7235       end.
     7236       if not available libthpos_chk-context then do:
     7237         v-err-mess = substitute("Не выставлен контекст чека").
     7238         undo main-block, retry main-block.
     7239       end.
     7240       find first libthpos_chk-doc.
     7241       if libthpos_chk-context.doc-code <> p-doc-code then do:
     7242         v-err-mess = substitute("Неверный номер чека = &1", p-doc-code).
     7243         undo main-block, retry main-block.
     7244       end.
     7245       run cur-time in this-procedure(output v-today, output v-time).
     7246       assign
     7247       v-base-rate = 1
     7248       v-cash-rate = 1
     7249       v-cash-scale = 1
     7250       v-bank-rate = 1
     7251       v-bank-scale = 1
     7252       .
     7253       if libthpos_context.r-b = 'base':U
     7254       and libthpos_context.base-code <> 0 then do:
     7255         find  LAST buf_curr-shop NO-LOCK WHERE
     7256                       buf_curr-shop.obj-type = libthpos_context.obj-type
     7257                   AND buf_curr-shop.obj-code = libthpos_context.obj-code
     7258                   AND buf_curr-shop.curr-code = libthpos_context.base-code
     7259                   AND ( ( buf_curr-shop.exch-date = v-today
     7260                         AND
     7261                         buf_curr-shop.exch-time <= v-time ) OR
     7262                         buf_curr-shop.exch-date < v-today ) NO-ERROR .
     7263         if available buf_curr-shop then do:
     7264           assign
     7265           v-cash-rate = buf_curr-shop.exch-rate
     7266           v-cash-scale = buf_curr-shop.exch-scale
     7267           v-base-rate = buf_curr-shop.exch-rate / buf_curr-shop.exch-scale
     7268           .
     7269         end.
     7270         else do:
     7271           v-err-mess = substitute(
     7272                                         "Нет магазинного курса базовой валюты для &1&2 на дату &3"
     7273                                         , 'маг':U
     7274                                         , libthpos_context.obj-code
     7275                                         , v-today
     7276                                       ).
     7277           undo main-block, retry main-block.
     7278         end.
     7279         if v-today <> libthpos_chk-context.chk-date then do:
     7280   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7281   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     7282     (input  libthpos_context.base-code
     7283     ,input  v-today
     7284     ,output v-bank-rate
     7285     ,output v-bank-scale
     7286     ,output v-bank-abbr
     7287     )  .
     7288         end.
     7289         else do:
     7290           assign
     7291           v-bank-rate = libthpos_chk-context.bank-rate
     7292           v-bank-scale = libthpos_chk-context.bank-scale
     7293           .
     7294         end.
     7295       end.
     7296       if libthpos_context.r-b = 'rubl':U
     7297       and libthpos_context.base-code <> 0
     7298       then do:
     7299         FIND LAST buf_curr-shop NO-LOCK WHERE
     7300                   buf_curr-shop.obj-type = libthpos_context.obj-type
     7301               AND buf_curr-shop.obj-code = libthpos_context.obj-code
     7302               AND buf_curr-shop.curr-code = libthpos_context.base-code
     7303               AND ( ( buf_curr-shop.exch-date = v-today
     7304                       AND
     7305                       buf_curr-shop.exch-time <= v-time ) OR
     7306                       buf_curr-shop.exch-date < v-today ) NO-ERROR .
     7307         if available buf_curr-shop then do:
     7308           assign
     7309           v-base-rate = buf_curr-shop.exch-rate / buf_curr-shop.exch-scale
     7310           .
     7311         end.
     7312         else do:
     7313           v-err-mess = substitute(
     7314                                         "Нет магазинного курса базовой валюты для &1&2 на дату &3"
     7315                                         , 'маг':U
     7316                                         , libthpos_context.obj-code
     7317                                         , v-today
     7318                                       ).
     7319           undo main-block, retry main-block.
     7320         end.
     7321         if libthpos_chk-context.chk-date <> v-today then do:
     7322   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7323   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     7324     (input  libthpos_context.base-code
     7325     ,input  v-today
     7326     ,output v-bank-rate
     7327     ,output v-bank-scale
     7328     ,output v-bank-abbr
     7329     )  .
     7330         end.
     7331         else do:
     7332           assign
     7333           v-bank-rate = libthpos_chk-context.bank-rate
     7334           v-bank-scale = libthpos_chk-context.bank-scale
     7335           .
     7336         end.
     7337       end.
     7338       assign
     7339       libthpos_chk-context.a-chk-date = v-today
     7340       libthpos_chk-context.a-chk-time = v-time
     7341       libthpos_chk-context.a-base-rate = v-base-rate
     7342       libthpos_chk-context.a-cash-rate = v-cash-rate
     7343       libthpos_chk-context.a-cash-scale = v-cash-scale
     7344       libthpos_chk-context.a-bank-rate = v-bank-rate
     7345       libthpos_chk-context.a-bank-scale = v-bank-scale
     7346       .
     7347       assign
     7348       libthpos_chk-context.sub-netto = libthpos_chk-context.sub-netto + libthpos_chk-context.tot-discnt
     7349       libthpos_chk-context.netto = libthpos_chk-context.netto + libthpos_chk-context.tot-discnt
     7350       .
     7351       define variable v-start-sum-brutto-r-b as decimal no-undo .
     7352       define variable v-sum-brutto-r-b as decimal no-undo .
     7353       define variable v-st-discnt-r-b as decimal no-undo .
     7354       define variable v-st-r-b as decimal no-undo .
     7355       define variable v-new-st-discnt-r-b as decimal no-undo .
     7356       define variable v-sum-for-discnt-r-b as decimal no-undo .
     7357       define variable v-new-sum-for-discnt-r-b as decimal no-undo .
     7358       assign
     7359       v-start-sum-brutto-r-b = libthpos_chk-context.sub-netto
     7360       v-sum-brutto-r-b = libthpos_chk-context.sub-netto
     7361       libthpos_chk-context.st-for-discnt-r-b = libthpos_chk-context.sub-netto
     7362       v-sum-for-discnt-r-b = libthpos_chk-context.st-for-discnt-r-b
     7363       v-st-discnt-r-b = 0.0
     7364       v-new-st-discnt-r-b = 0.0
     7365       v-new-sum-for-discnt-r-b = 0.0
     7366       .
     7367       assign
     7368       v-bh[2] = buffer libthpos_chk-context:handle
     7369       v-bh[4] = buffer libthpos_chk-gds:handle
     7370       v-bh[1] = buffer libthpos_context:handle
     7371       v-bh[5] = buffer libthpos_chk-pay:handle
     7372       .
     7373       if lookup(string(libthpos_chk-context.chk-type), '14,15,16,36,,17,11,12,13,40,114,115,116,117,111,112,136,,113,8,108,208,2,3,4,5,7':U) = 0
     7374       and lookup(string(libthpos_chk-context.chk-type), '6,69,96,106,169,196,206':U) = 0
     7375       and libthpos_chk-context.direction > 0
     7376       then do:
     7377         _chk-discnt:
     7378         for each buf_libthpos_chk-discnt share-lock where
     7379                 buf_libthpos_chk-discnt.line-type = integer('2':U)
     7380                 or
     7381                 buf_libthpos_chk-discnt.line-type = integer('7':U)
     7382                 ,
     7383             first buf_chk-discnt where
     7384                   buf_chk-discnt.doc-code = p-doc-code
     7385             and buf_chk-discnt.line-num = buf_libthpos_chk-discnt.line-num
     7386             and buf_chk-discnt.record-type = buf_libthpos_chk-discnt.record-type
     7387             and buf_chk-discnt.discnt-id = buf_libthpos_chk-discnt.discnt-id
     7388             and buf_chk-discnt.object-line-num = buf_libthpos_chk-discnt.object-line-num
     7389         on error  undo main-block, retry main-block
     7390         on stop   undo main-block, retry main-block
     7391         on endkey undo main-block, retry main-block
     7392         :
     7393           if buf_libthpos_chk-discnt.discnt-type = integer('13':U) then do:
     7394             next _chk-discnt.
     7395           end.
     7396           delete buf_chk-discnt.
     7397           delete buf_libthpos_chk-discnt.
     7398         end.
     7399         run cur-time in this-procedure ( output libthpos_chk-context.current-date, output libthpos_chk-context.current-time).
     7400         for each buf_libthpos_rp-by-call
     7401         on error  undo main-block, retry main-block
     7402         on stop   undo main-block, retry main-block
     7403         on endkey undo main-block, retry main-block
     7404         :
     7405         run rs_16_1 in buf_libthpos_rp-by-call.rph (
     7406                     input '':U
     7407                   ,input libthpos_chk-context.lng
     7408                   ,input v-start-sum-brutto-r-b
     7409                   ,input v-sum-brutto-r-b
     7410                   ,input v-sum-for-discnt-r-b
     7411                   ,input v-st-discnt-r-b
     7412                   ,input v-bh
     7413                   ,output v-st-r-b
     7414                   ,output v-new-st-discnt-r-b
     7415                   ,output v-new-sum-for-discnt-r-b
     7416                       ) no-error.
     7417           if not error-status :error then do:
     7418             assign
     7419             v-sum-brutto-r-b = v-st-r-b
     7420             v-st-discnt-r-b = v-new-st-discnt-r-b
     7421             v-sum-for-discnt-r-b = v-new-sum-for-discnt-r-b
     7422             .
     7423           end.
     7424         end.
     7425         assign
     7426         v-tot-discnt = v-new-st-discnt-r-b
     7427         .
     7428       end.
     7429       if libthpos_chk-context.manual-discnt-id <> 0 then do:
     7430         for first buf_libthpos_chk-discnt where
     7431                 buf_libthpos_chk-discnt.doc-code = p-doc-code
     7432           and  buf_libthpos_chk-discnt.record-type = 0
     7433           and  buf_libthpos_chk-discnt.line-num = libthpos_chk-context.manual-discnt-ln
     7434           and  buf_libthpos_chk-discnt.discnt-id = libthpos_chk-context.manual-discnt-id,
     7435           first buf_chk-discnt share-lock where
     7436                 buf_chk-discnt.doc-code = p-doc-code
     7437           and  buf_chk-discnt.record-type = 0
     7438           and  buf_chk-discnt.line-num = libthpos_chk-context.manual-discnt-ln
     7439           and  buf_chk-discnt.discnt-id = libthpos_chk-context.manual-discnt-id:
     7440           assign
     7441           libthpos_chk-context.manual-tot-discnt = libthpos_chk-context.manual-tot-discnt - buf_libthpos_chk-discnt.discnt-value-abs
     7442           libthpos_chk-context.manual-discnt-sum = libthpos_chk-context.manual-discnt-sum - buf_libthpos_chk-discnt.discnt-value-abs
     7443           libthpos_chk-context.tot-discnt = libthpos_chk-context.tot-discnt - buf_libthpos_chk-discnt.discnt-value-abs
     7444           libthpos_chk-context.discnt = libthpos_chk-context.discnt - buf_libthpos_chk-discnt.discnt-value-abs
     7445           .
     7446           leave.
     7447         end.
     7448         case buf_libthpos_chk-discnt.value-type:
     7449           when integer('1':U) then do:
     7450             assign
     7451             buf_libthpos_chk-discnt.discnt-value-abs = libthpos_chk-context.st-for-discnt-r-b *  buf_libthpos_chk-discnt.discnt-value-pcnt / 100
     7452             buf_libthpos_chk-discnt.object-sum  = libthpos_chk-context.st-for-discnt-r-b
     7453             buf_libthpos_chk-discnt.object-qnty = libthpos_chk-context.src-qnty
     7454             .
     7455           end.
     7456           when integer('10':U) then do:
     7457             assign
     7458             buf_libthpos_chk-discnt.discnt-value-pcnt = buf_libthpos_chk-discnt.discnt-value-abs / libthpos_chk-context.st-for-discnt-r-b * 100
     7459             buf_libthpos_chk-discnt.object-sum  = libthpos_chk-context.st-for-discnt-r-b
     7460             buf_libthpos_chk-discnt.object-qnty = libthpos_chk-context.src-qnty
     7461             .
     7462           end.
     7463         end case.
     7464         buffer-copy buf_libthpos_chk-discnt to buf_chk-discnt.
     7465         assign
     7466         libthpos_chk-context.manual-tot-discnt = libthpos_chk-context.manual-tot-discnt + buf_libthpos_chk-discnt.discnt-value-abs
     7467         libthpos_chk-context.manual-discnt-sum = libthpos_chk-context.manual-discnt-sum + buf_libthpos_chk-discnt.discnt-value-abs
     7468         libthpos_chk-context.tot-discnt = libthpos_chk-context.tot-discnt + buf_libthpos_chk-discnt.discnt-value-abs
     7469         libthpos_chk-context.discnt = libthpos_chk-context.discnt + buf_libthpos_chk-discnt.discnt-value-abs
     7470         .
     7471       end.
     7472       assign
     7473       libthpos_chk-context.step =  if libthpos_chk-context.step = 1
     7474                                   then 2
     7475                                   else libthpos_chk-context.step
     7476       libthpos_chk-context.tot-discnt = libthpos_chk-context.manual-tot-discnt + v-tot-discnt
     7477       libthpos_chk-context.tot-r = v-tot-discnt - (libthpos_chk-context.tot-discnt - libthpos_chk-context.manual-tot-discnt )
     7478       libthpos_chk-context.sub-netto = libthpos_chk-context.sub-netto - libthpos_chk-context.tot-discnt
     7479       libthpos_chk-context.st-for-discnt-r-b = libthpos_chk-context.st-for-discnt-r-b - libthpos_chk-context.tot-discnt
     7480       libthpos_chk-context.netto = libthpos_rmethod(libthpos_context.rmethod-type
     7481                                                   , libthpos_context.rmethod-coeff
     7482                                                   ,libthpos_chk-context.netto - libthpos_chk-context.tot-discnt)
     7483       libthpos_chk-context.st-r-b = libthpos_rmethod(libthpos_context.rmethod-type
     7484                                                       , libthpos_context.rmethod-coeff
     7485                                                       , libthpos_chk-context.sub-netto)
     7486       p-st-r-b = libthpos_chk-context.st-r-b
     7487       libthpos_chk-context.st-rubl =  (if libthpos_context.r-b = 'rubl':U
     7488                                       or (libthpos_context.r-b = 'base':U
     7489                                           and
     7490                                           libthpos_context.base-code = 0)
     7491                                         then libthpos_chk-context.st-r-b
     7492                                         else libthpos_chk-context.st-r-b * libthpos_chk-context.a-base-rate)
     7493       p-st-rubl = libthpos_chk-context.st-rubl
     7494       libthpos_chk-context.st-base = (if libthpos_context.r-b = 'base':U
     7495                                       or (libthpos_context.r-b = 'rubl':U
     7496                                           and
     7497                                           libthpos_context.base-code = 0)
     7498                                       then libthpos_chk-context.st-r-b
     7499                                       else libthpos_chk-context.st-r-b / libthpos_chk-context.a-base-rate)
     7500       libthpos_chk-context.to-pay-r-b   = libthpos_chk-context.st-r-b - libthpos_chk-context.has-pay-r-b - libthpos_chk-context.pay-discnt
     7501       libthpos_chk-context.to-pay-rubl  = (if libthpos_context.r-b = 'rubl':U
     7502                                               or (libthpos_context.r-b = 'base':U
     7503                                                   and
     7504                                                   libthpos_context.base-code  = 0)
     7505                                               then libthpos_chk-context.st-r-b
     7506                                               else libthpos_chk-context.st-r-b * libthpos_chk-context.cash-rate / libthpos_chk-context.cash-scale)
     7507                                               - libthpos_chk-context.has-pay-rubl - libthpos_chk-context.pay-discnt-rubl
     7508       libthpos_chk-context.all-pay-rubl =  libthpos_chk-context.st-rubl - libthpos_chk-context.pay-discnt-rubl
     7509       libthpos_chk-context.to-pay-base  = (if libthpos_context.r-b = 'base':U
     7510                                               or (libthpos_context.r-b = 'rubl':U
     7511                                                   and
     7512                                                   libthpos_context.base-code  = 0)
     7513                                               then libthpos_chk-context.st-r-b
     7514                                               else libthpos_chk-context.st-r-b / libthpos_chk-context.cash-rate * libthpos_chk-context.cash-scale)
     7515                                           - libthpos_chk-context.has-pay-base - libthpos_chk-context.pay-discnt-base
     7516       libthpos_chk-context.all-pay-base =  libthpos_chk-context.st-base - libthpos_chk-context.pay-discnt-base
     7517       p-st-base = libthpos_chk-context.st-base
     7518       p-tot-doc = libthpos_chk-context.src-tot-doc
     7519       libthpos_chk-context.tot-r = libthpos_chk-context.sub-netto - libthpos_chk-context.st-r-b
     7520       p-st-discnt  = libthpos_chk-context.gds-discnt + libthpos_chk-context.tot-discnt
     7521       p-netto = libthpos_chk-context.netto
     7522       p-netto-rubl = libthpos_chk-context.all-pay-rubl
     7523       p-netto-base = libthpos_chk-context.all-pay-base
     7524       p-all-discnt = libthpos_chk-context.src-tot-doc - libthpos_chk-context.netto
     7525       p-all-discnt-rubl = libthpos_chk-context.src-tot-rubl - libthpos_chk-context.all-pay-rubl
     7526       p-all-discnt-base = libthpos_chk-context.src-tot-base - libthpos_chk-context.all-pay-base
     7527       p-setted = yes
     7528       .
     7529       if libthpos_chk-context.discnt >= libthpos_chk-context.src-tot-doc
     7530       and libthpos_chk-context.direction > 0
     7531       then do:
     7532         v-err-mess = substitute("Недопустимая величина скидки для чека &1, общая скидка по чеку (&1) больше товарной суммы (&2) Возможно не стоит применять ручную скидку"
     7533                                 , libthpos_chk-context.discnt
     7534                                 , libthpos_chk-context.src-tot-doc
     7535                                 ).
     7536         undo main-block, retry main-block.
     7537       end.
     7538       run printbuffer in this-procedure ( input (buffer libthpos_chk-context:handle)).
     7539       if p-mode <> "no-changes" then do:
     7540         dataset libthpos_receipt:accept-changes.
     7541       end.
     7542     end.
     7543   end.
     7544   end procedure.
     7545   procedure libthpos_pay-line :
     7546   define input  parameter p-doc-code as character no-undo .
     7547   define input  parameter p-line-num as integer no-undo .
     7548   define input  parameter p-mode as character no-undo .
     7549   define input-output parameter p-cdpay-code as integer no-undo .
     7550   define input-output parameter p-curr-code as integer   no-undo .
     7551   define input  parameter p-par-code as integer no-undo .
     7552   define input  parameter p-src-qnty as decimal no-undo .
     7553   define output parameter p-frpay-code as integer no-undo .
     7554   define input  parameter p-pass-pay   as integer no-undo .
     7555   define input  parameter p-pay-card as character no-undo .
     7556   define input-output parameter p-tot-sum as decimal no-undo .
     7557   define input-output parameter p-tot-rubl as decimal no-undo .
     7558   define input-output parameter p-tot-base as decimal no-undo .
     7559   define output parameter p-get-qnty-method as character no-undo .
     7560   define output parameter p-2-cdpay-code as integer no-undo .
     7561   define output parameter p-2-curr-code as integer   no-undo .
     7562   define output parameter p-2-frpay-code as integer no-undo .
     7563   define output parameter p-2-tot-sum as decimal no-undo .
     7564   define output parameter p-2-tot-rubl as decimal no-undo .
     7565   define output parameter p-2-tot-base as decimal no-undo .
     7566   define output parameter p-src-discnt-sum as decimal no-undo .
     7567   define output parameter p-src-discnt-rubl as decimal no-undo .
     7568   define output parameter p-for-discnt-doc as decimal no-undo .
     7569   define output parameter p-for-discnt-rubl as decimal no-undo .
     7570   define output parameter p-for-discnt-r-b as decimal no-undo .
     7571   define output parameter p-setted as logical no-undo .
     7572   DEFINE VARIABLE v-today as date no-undo .
     7573   DEFINE VARIABLE v-time as integer no-undo .
     7574   define variable v-tot-sum as decimal no-undo .
     7575   define variable v-tot-base as decimal no-undo .
     7576   define variable v-tot-rubl as decimal no-undo .
     7577   define variable v-netto-sum as decimal no-undo .
     7578   define variable v-netto-base as decimal no-undo .
     7579   define variable v-netto-rubl as decimal no-undo .
     7580   define variable v-discnt as decimal no-undo .
     7581   define variable v-exch-rate as decimal no-undo .
     7582   define variable v-exch-scale as integer no-undo .
     7583   define variable v-exch-abbr as character no-undo .
     7584   define variable v-exch-date as date no-undo .
     7585   define variable v-exch-time as integer no-undo .
     7586   define variable v-nalc-exch-rate as decimal no-undo .
     7587   define variable v-nalc-exch-scale as integer no-undo .
     7588   define variable v-nalc-exch-date as date no-undo .
     7589   define variable v-nalc-exch-time as integer no-undo .
     7590   define variable v-bank-rate as decimal no-undo .
     7591   define variable v-bank-scale as integer no-undo .
     7592   define variable v-bank-abbr as character no-undo .
     7593   define variable v-cash-rate as decimal no-undo .
     7594   define variable v-calc-rate as integer no-undo .
     7595   define variable v-pay-discnt-sum as decimal no-undo .
     7596   define variable v-pay-discnt-rubl as decimal no-undo .
     7597   define variable v-pay-discnt-base as decimal no-undo .
     7598   define variable v-is-cash as logical no-undo .
     7599   define variable v-frpay-code as integer no-undo .
     7600   define variable v-2-frpay-code as integer no-undo .
     7601   define variable v-has-overpay as integer no-undo .
     7602   define variable v-atr1  as logical no-undo .
     7603   define variable v-has-return as integer no-undo .
     7604   define variable v-can-mix  as integer no-undo .
     7605   define variable v-is-credit-card as logical no-undo .
     7606   define variable v-is-debet-card  as logical no-undo .
     7607   define variable v-atr128 as logical no-undo .
     7608   define variable v-atr16 as logical no-undo .
     7609   define variable v-atr32 as logical no-undo .
     7610   define variable v-wth-code as integer   no-undo .
     7611   define variable v-get-qnty-method as character no-undo .
     7612   define variable v-src-val as integer   no-undo .
     7613   define variable v-par-rate as decimal no-undo .
     7614   define variable v-inversed as logical no-undo .
     7615   define variable v-err-mess as character no-undo .
     7616   define buffer buf_cash-pay for ub.cash-pay.
     7617   define buffer buf_chk-pay for ub.chk-pay.
     7618   define buffer buf_libthpos_chk-pay for libthpos_chk-pay.
     7619   define buffer buf_chk-discnt for ub.chk-discnt.
     7620   define buffer buf_libthpos_chk-discnt for libthpos_chk-discnt.
     7621   define buffer buf_libthpos_cash-desk-attr for libthpos_cash-desk-attr.
     7622   define buffer buf_curr-shop for ub.curr-shop.
     7623   define buffer buf_libthpos_cash-counter for libthpos_cash-counter.
     7624   define buffer buf_libthpos_rp-by-call for libthpos_rp-by-call.
     7625   define buffer buf_libthpos_temp-cash-pay-list for libthpos_temp-cash-pay-list.
     7626   define buffer buf2_libthpos_chk-pay for libthpos_chk-pay.
     7627   define buffer buf2_cash-pay for ub.cash-pay.
     7628   define buffer buf_wealth for ub.wealth.
     7629   define buffer buf_wth-par for ub.wth-par.
     7630   define buffer undo_libthpos_chk-context for libthpos_chk-context.
     7631   main-block:
     7632   do
     7633   on error undo main-block, retry main-block
     7634   on stop undo main-block, retry main-block
     7635   on endkey undo main-block, retry main-block
     7636   :
     7637     if retry then do:
     7638       if v-err-mess = '' then do:
     7639         v-err-mess = substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     7640       end.
     7641       dataset libthpos_receipt:reject-changes.
     7642       return error v-err-mess.
     7643     end.
     7644     else do:
     7645       if not available libthpos_chk-context then do:
     7646         find first libthpos_chk-context no-error.
     7647       end.
     7648       if not available libthpos_chk-context then do:
     7649         v-err-mess = substitute("Не выставлен контекст чека").
     7650         undo main-block, retry main-block.
     7651       end.
     7652       find first libthpos_chk-doc.
     7653       if libthpos_chk-context.doc-code <> p-doc-code then do:
     7654         v-err-mess = substitute("Неверный номер чека = &1", p-doc-code).
     7655         undo main-block, retry main-block.
     7656       end.
     7657       if libthpos_chk-context.step < 2 then do:
     7658         v-err-mess = substitute("Не подведены итоги по чеку &1", p-doc-code).
     7659         undo main-block, retry main-block.
     7660       end.
     7661       if p-line-num <= 0 then do:
     7662         v-err-mess = substitute("Неверный номер строки оплат = &1", p-line-num).
     7663         undo main-block, retry main-block.
     7664       end.
     7665       if not (
     7666               (
     7667                 (p-mode = 'ДОБАВЛЕНИЕ':U
     7668                 or
     7669                 p-mode = 'ИЗМЕНЕНИЕ':U
     7670                 or
     7671                 p-mode = 'удаление':U
     7672                 )
     7673                 and p-tot-sum <> ?
     7674                 )
     7675               or
     7676               (p-mode = 'check'
     7677               and p-tot-sum = ?)
     7678               ) then do:
     7679         v-err-mess = substitute("Неверное действие над строкой оплат чека = &1", p-mode).
     7680         undo main-block, retry main-block.
     7681       end.
     7682       if p-mode = 'удаление':U
     7683       and (p-tot-sum = ?
     7684       or p-tot-sum <> 0 ) then do:
     7685         v-err-mess = substitute("Для удаления строки оплат чека сумма должна = 0").
     7686         undo main-block, retry main-block.
     7687       end.
     7688       if p-mode = 'ИЗМЕНЕНИЕ':U
     7689       and (p-tot-sum = ?
     7690       or p-tot-sum = 0) then do:
     7691         v-err-mess = substitute("Для изменения строки оплат чека сумма не должна = 0 или ?").
     7692         undo main-block, retry main-block.
     7693       end.
     7694       if p-tot-sum <> ? then do:
     7695         v-inversed = yes.
     7696       end.
     7697       if p-tot-sum = ?
     7698       and p-mode = "check"
     7699       then do:
     7700         p-mode = 'ДОБАВЛЕНИЕ':U.
     7701       end.
     7702       define variable v-na-vhode as decimal no-undo .
     7703       v-na-vhode = p-tot-sum.
     7704       if lookup(string(libthpos_chk-context.chk-type), '2,3,4,5,7':U) > 0
     7705       or lookup(string(libthpos_chk-context.chk-type), '14,15,16,17,11,13,40,114,115,116,136,,117,111,113,201,206,208,301,306':U) > 0
     7706       then do:
     7707         v-err-mess = substitute("В чеке &1 с типом &2 строки оплат быть не может", p-doc-code, libthpos_chk-context.chk-type).
     7708         undo main-block, retry main-block.
     7709       end.
     7710       case p-mode:
     7711         when 'ДОБАВЛЕНИЕ':U then do:
     7712           if libthpos_chk-context.lnp + 1 <> p-line-num then do:
     7713             v-err-mess = substitute("Неверный № строки оплат чека = &1&2должен быть &3"
     7714                                         , p-line-num
     7715                                         , chr(10)
     7716                                         , libthpos_chk-context.lnp + 1).
     7717             undo main-block, retry main-block.
     7718           end.
     7719           if p-cdpay-code = ? then do:
     7720             assign
     7721             p-cdpay-code = 1
     7722             p-curr-code = libthpos_context.nalc
     7723             v-is-cash = yes
     7724             v-has-overpay = 0
     7725             v-atr1  = yes
     7726             v-has-return = 1
     7727             v-can-mix  = 1
     7728             v-src-val = 0
     7729             p-par-code = 0
     7730             .
     7731           end.
     7732           else do:
     7733             find first buf_cash-pay no-lock where
     7734                       buf_cash-pay.cdpay-code = p-cdpay-code
     7735                   and buf_cash-pay.curr-code = p-curr-code no-error.
     7736             if not available buf_cash-pay then do:
     7737               v-err-mess = substitute("Не найден тип кассового платежа с кодом &1 и валютой &2"
     7738                                                       , p-cdpay-code
     7739                                                       , p-curr-code).
     7740               undo main-block, retry main-block.
     7741             end.
     7742             if buf_cash-pay.wth-code > 0 then do:
     7743               find first buf_wealth no-lock where
     7744                         buf_wealth.wth-code = buf_cash-pay.wth-code no-error.
     7745               if not available buf_wealth then do:
     7746                 v-err-mess = substitute("Не найдена МЦ с кодом &1 для типа кассового платежа с кодом &2 и валютой &3"
     7747                                                         , buf_cash-pay.wth-code
     7748                                                         , p-cdpay-code
     7749                                                         , p-curr-code).
     7750                 undo main-block, retry main-block.
     7751               end.
     7752               v-get-qnty-method = buf_wealth.get-qnty-method.
     7753                     end.
     7754             if p-par-code <> 0 then do:
     7755               find first buf_wth-par no-lock where
     7756                         buf_wth-par.par-code = p-par-code
     7757                     and buf_wth-par.wth-code = buf_cash-pay.wth-code no-error.
     7758               if not available buf_wth-par then do:
     7759                 v-err-mess = substitute("Не найден номинал с кодом &1 для МЦ с кодом &2 для типа кассового платежа с кодом &3 и валютой &4"
     7760                                                         , p-par-code
     7761                                                         , buf_cash-pay.wth-code
     7762                                                         , p-cdpay-code
     7763                                                         , p-curr-code).
     7764                 undo main-block, retry main-block.
     7765               end.
     7766               assign
     7767               v-src-val = buf_wth-par.par-val
     7768               v-par-rate = buf_wth-par.par-rate
     7769               .
     7770             end.
     7771             assign
     7772             v-has-overpay = buf_cash-pay.has-overpay
     7773             v-atr1  = buf_cash-pay.atr1
     7774             v-has-return = buf_cash-pay.has-return
     7775             v-can-mix  = buf_cash-pay.can-mix
     7776             v-is-credit-card = buf_cash-pay.is-credit-card
     7777             v-is-debet-card  = buf_cash-pay.is-debet-card
     7778             v-atr128 = buf_Cash-pay.atr128
     7779             v-atr16 = buf_Cash-pay.atr16
     7780             v-atr32 = buf_Cash-pay.atr32
     7781             v-wth-code = buf_cash-pay.wth-code
     7782             .
     7783             if v-has-return = 0
     7784             and lookup(string(libthpos_chk-context.chk-type), '6,96':U) > 0 then do:
     7785               v-err-mess = substitute("Для типа касс платежа с кодом &1 и валютой &2 возврат ЗАПРЕЩЕН"
     7786                                                       , p-cdpay-code
     7787                                                       , p-curr-code).
     7788               undo main-block, retry main-block.
     7789             end.
     7790             if p-line-num > 1 then do:
     7791               for each buf2_libthpos_chk-pay where
     7792                       buf2_libthpos_chk-pay.doc-code = libthpos_chk-context.doc-code,
     7793                   first buf2_cash-pay no-lock where
     7794                       buf2_cash-pay.cdpay-code = buf2_libthpos_chk-pay.pay-code
     7795                 and  buf2_cash-pay.curr-code = buf2_libthpos_chk-pay.curr-code:
     7796                 if buf2_cash-pay.can-mix = 0
     7797                 and not (buf2_cash-pay.cdpay-code = buf_cash-pay.cdpay-code
     7798                         and
     7799                         buf2_cash-pay.curr-code = buf_cash-pay.curr-code)
     7800                 then do:
     7801                   v-err-mess = substitute("В чеке есть строка оплаты с № &1, для которой запрещена СМЕШАННАЯ ОПЛАТА"
     7802                                                           , buf2_libthpos_chk-pay.line-num
     7803                                                           ).
     7804                   undo main-block, retry main-block.
     7805                 end.
     7806               end.
     7807             end.
     7808             assign
     7809             v-is-cash = buf_cash-pay.is-cash
     7810             .
     7811             if p-pay-card <> "0"
     7812             and p-pay-card <> ""
     7813             and buf_cash-pay.is-cash then do:
     7814               v-err-mess = substitute("Для типа кассового платежа с кодом &1 и валютой &2 с признаком НАЛИЧНЫЕ не может быть № карты"
     7815                                                       , p-cdpay-code
     7816                                                       , p-curr-code).
     7817               undo main-block, retry main-block.
     7818             end.
     7819           end.
     7820           if p-cdpay-code = 1 then do:
     7821             v-frpay-code = 1.
     7822           end.
     7823           else do:
     7824             find first buf_libthpos_temp-cash-pay-list where
     7825                     buf_libthpos_temp-cash-pay-list.cdpay-code = p-cdpay-code
     7826                 and  buf_libthpos_temp-cash-pay-list.curr-code = p-curr-code no-error .
     7827             if not available  buf_libthpos_temp-cash-pay-list then do:
     7828               v-err-mess = substitute("Для типа кассового платежа с кодом &1 и валютой &2 не удалось найти соответствующий код оплаты на ФР"
     7829                                                       , p-cdpay-code
     7830                                                       , p-curr-code).
     7831               undo main-block, retry main-block.
     7832             end.
     7833             v-frpay-code = buf_libthpos_temp-cash-pay-list.frpay-code.
     7834           end.
     7835           if p-tot-sum = ? then do:
     7836             assign
     7837             v-tot-rubl = libthpos_chk-context.to-pay-rubl
     7838             v-tot-base = libthpos_chk-context.to-pay-base
     7839             .
     7840             if p-curr-code = 0 then do:
     7841               assign
     7842               v-cash-rate = 1
     7843               v-calc-rate = 1
     7844               v-bank-rate = 1
     7845               v-bank-scale = 1
     7846               v-exch-rate = 1
     7847               v-exch-scale = 1
     7848               v-exch-date = libthpos_chk-context.chk-date
     7849               v-exch-time = libthpos_chk-context.chk-time
     7850               v-tot-sum = v-tot-rubl
     7851               .
     7852             end.
     7853             else do:
     7854               if p-curr-code = libthpos_context.base-code then do:
     7855                 assign
     7856                 v-cash-rate = libthpos_chk-context.a-cash-rate / libthpos_chk-context.a-cash-scale
     7857                 v-calc-rate = 1
     7858                 v-bank-rate = libthpos_chk-context.a-bank-rate
     7859                 v-bank-scale = libthpos_chk-context.a-bank-scale
     7860                 v-exch-rate = libthpos_chk-context.a-bank-rate
     7861                 v-exch-scale = libthpos_chk-context.a-bank-scale
     7862                 v-exch-date = libthpos_chk-context.chk-date
     7863                 v-exch-time = libthpos_chk-context.chk-time
     7864                 v-tot-sum = v-tot-base
     7865                 .
     7866               end.
     7867               else do:
     7868                 run cur-time in this-procedure ( output v-today, output v-time).
     7869                 find  LAST buf_curr-shop NO-LOCK WHERE
     7870                               buf_curr-shop.obj-type = libthpos_context.obj-type
     7871                           AND buf_curr-shop.obj-code = libthpos_context.obj-code
     7872                           AND buf_curr-shop.curr-code = p-curr-code
     7873                           AND ( ( buf_curr-shop.exch-date = v-today
     7874                                 AND
     7875                                 buf_curr-shop.exch-time <= v-time ) OR
     7876                                 buf_curr-shop.exch-date < v-today ) NO-ERROR .
     7877                 if available buf_curr-shop then do:
     7878                   assign
     7879                   v-exch-rate = buf_curr-shop.exch-rate
     7880                   v-exch-scale = buf_curr-shop.exch-scale
     7881                   v-exch-date  = buf_curr-shop.exch-date
     7882                   v-exch-time  = buf_curr-shop.exch-time
     7883                   .
     7884                 end.
     7885                 else do:
     7886                   v-err-mess =  substitute("Не найден курс валюты с кодом &1 для &2&3 на &4 &5"
     7887                             , p-curr-code
     7888                             , libthpos_context.obj-type
     7889                             , libthpos_context.obj-code
     7890                             , string(v-today, "99/99/9999")
     7891                             , string(v-time, "HH:MM:SS")
     7892                         ).
     7893                   undo main-block, retry main-block.
     7894                 end.
     7895   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7896   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     7897     (input  p-curr-code
     7898     ,input  v-today
     7899     ,output v-bank-rate
     7900     ,output v-bank-scale
     7901     ,output v-bank-abbr
     7902     ) no-error .
     7903                 if error-status:error then do:
     7904                   v-err-mess = substitute("Ошибка при определении курса валюты с кодом &1 на &2", p-curr-code, string(v-today, "99/99/999")).
     7905                   undo main-block, retry main-block.
     7906                 end.
     7907                 assign
     7908                 v-tot-sum = (if libthpos_context.r-b = 'rubl':U
     7909                             then p-tot-rubl / v-exch-rate * v-exch-scale
     7910                             else p-tot-base * libthpos_chk-context.cash-rate / libthpos_chk-context.cash-scale / v-exch-rate * v-exch-scale
     7911                               )
     7912                 .
     7913               end.
     7914             end.
     7915           end.
     7916           else do:
     7917             assign
     7918             v-tot-sum = p-tot-sum
     7919             .
     7920             if p-curr-code = 0 then do:
     7921               assign
     7922                 v-cash-rate = 1
     7923                 v-calc-rate = 1
     7924                 v-bank-rate = 1
     7925                 v-bank-scale = 1
     7926                 v-exch-rate = 1
     7927                 v-exch-scale = 1
     7928                 v-exch-date = libthpos_chk-context.chk-date
     7929                 v-exch-time = libthpos_chk-context.chk-time
     7930               v-tot-rubl = p-tot-sum
     7931               v-tot-base = (if libthpos_context.base-code = 0
     7932                             then v-tot-rubl
     7933                             else  v-tot-rubl / libthpos_chk-context.a-cash-rate *  libthpos_chk-context.a-cash-scale)
     7934               .
     7935             end.
     7936             else do:
     7937               if p-curr-code = libthpos_context.base-code then do:
     7938                 assign
     7939                 v-cash-rate = libthpos_chk-context.a-cash-rate / libthpos_chk-context.a-cash-scale
     7940                 v-calc-rate = 1
     7941                 v-bank-rate = libthpos_chk-context.a-bank-rate
     7942                 v-bank-scale = libthpos_chk-context.a-bank-scale
     7943                 v-exch-rate = libthpos_chk-context.a-bank-rate
     7944                 v-exch-scale = libthpos_chk-context.a-bank-scale
     7945                 v-exch-date = libthpos_chk-context.chk-date
     7946                 v-exch-time = libthpos_chk-context.chk-time
     7947                 v-tot-base = p-tot-sum
     7948                 v-tot-rubl = v-tot-base * libthpos_chk-context.a-cash-rate / libthpos_chk-context.a-cash-scale
     7949                 .
     7950               end.
     7951               else do:
     7952                 run cur-time in this-procedure ( output v-today, output v-time).
     7953                 find  LAST buf_curr-shop NO-LOCK WHERE
     7954                               buf_curr-shop.obj-type = libthpos_context.obj-type
     7955                           AND buf_curr-shop.obj-code = libthpos_context.obj-code
     7956                           AND buf_curr-shop.curr-code = p-curr-code
     7957                           AND ( ( buf_curr-shop.exch-date = v-today
     7958                                 AND
     7959                                 buf_curr-shop.exch-time <= v-time ) OR
     7960                                 buf_curr-shop.exch-date < v-today ) NO-ERROR .
     7961                 if available buf_curr-shop then do:
     7962                   assign
     7963                   v-exch-rate = buf_curr-shop.exch-rate
     7964                   v-exch-scale = buf_curr-shop.exch-scale
     7965                   v-exch-date  = buf_curr-shop.exch-date
     7966                   v-exch-time  = buf_curr-shop.exch-time
     7967                   .
     7968                 end.
     7969                 else do:
     7970                   v-err-mess = substitute("Не найден курс валюты с кодом &1 для &2&3 на &4 &5"
     7971                             , p-curr-code
     7972                             , libthpos_context.obj-type
     7973                             , libthpos_context.obj-code
     7974                             , string(v-today, "99/99/9999")
     7975                             , string(v-time, "HH:MM:SS")
     7976                         ).
     7977                   undo main-block, retry main-block.
     7978                 end.
     7979   define variable vss-include-info56 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7980   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     7981     (input  p-curr-code
     7982     ,input  v-today
     7983     ,output v-bank-rate
     7984     ,output v-bank-scale
     7985     ,output v-bank-abbr
     7986     ) no-error .
