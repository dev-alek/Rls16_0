     2538   def var vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2539   procedure gen-key-rec :
     2540     define input  parameter p-tbl-name    as character no-undo.
     2541     define input  parameter p-bh_tbl-name as handle    no-undo.
     2542     define output parameter p-key-rec     as character no-undo.
     2543     do
     2544     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2545     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     2546     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     2547     :
     2548       define variable fh               as handle    no-undo .
     2549       define variable v-ok             as logical   no-undo .
     2550       define variable v-inform         as character no-undo .
     2551       define variable v-ind            as integer   no-undo .
     2552       define variable v-idx-field-qnty as integer   no-undo .
     2553       if p-tbl-name = ?
     2554         or p-tbl-name = "":U
     2555       then do:
     2556         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info22 ).
     2557       end.
     2558       if not p-bh_tbl-name:available then do:
     2559         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info22, p-tbl-name ).
     2560       end.
     2561       assign
     2562         p-key-rec = p-tbl-name
     2563         v-inform  = p-bh_tbl-name:index-information(1)
     2564         v-ind     = 2
     2565       .
     2566       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2567       on error undo, return error
     2568       :
     2569         assign
     2570           v-inform = p-bh_tbl-name:index-information( v-ind )
     2571           v-ind    = v-ind + 1
     2572         .
     2573       end.
     2574       if v-inform = ?
     2575         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2576         or entry( 3, v-inform, ",":U ) <> "1":U
     2577       then do:
     2578         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info22, p-tbl-name ).
     2579       end.
     2580       else do:
     2581         assign
     2582           v-idx-field-qnty = num-entries( v-inform ) - 4
     2583         .
     2584         if v-idx-field-qnty < 2 then do:
     2585           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info22, v-inform, p-tbl-name ).
     2586         end.
     2587         do v-ind = 1 to v-idx-field-qnty by 2
     2588         on error undo, return error
     2589         :
     2590           assign
     2591             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     2592             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     2593           .
     2594         end.
     2595       end.
     2596       if p-key-rec = ? then do:
     2597         assign
     2598           p-key-rec = "":U
     2599         .
     2600         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info22, p-tbl-name ).
     2601       end.
     2602     end.
     2603     return.
     2604   end procedure.
     2605   procedure gen-where-keyr-tab :
     2606     define input  parameter i-tableSerach as character no-undo.
     2607     define input  parameter i-tablekey   as character  no-undo.
     2608     define input  parameter p-key-rec    as character  no-undo.
     2609     define input  parameter p-key-handle as handle     no-undo .
     2610     define input  parameter p-db-name    as character  no-undo .
     2611     define input  parameter p-tt-handle  as handle     no-undo .
     2612     define output parameter o-Where      as character  no-undo.
     2613     do
     2614     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2615     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2616     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     2617     :
     2618       define variable v-full-tbl-name  as character no-undo .
     2619       define variable bh_tbl-name      as handle    no-undo .
     2620       define variable fh_key           as handle    no-undo .
     2621       define variable fh_search        as handle    no-undo .
     2622       define variable v-field-num      as integer   no-undo .
     2623       define variable v-count-fld      as integer   no-undo .
     2624       define variable v-inform         as character no-undo .
     2625       define variable v-ind            as integer   no-undo .
     2626       define variable v-idx-field-qnty as integer   no-undo .
     2627       define variable v-field-name     as character no-undo .
     2628       define variable v-field-val      as character no-undo .
     2629       define variable v-word-link      as character no-undo .
     2630       define variable vTable           as character no-undo.
     2631       define variable bh_tbl-key       as handle    no-undo .
     2632       assign
     2633         p-key-rec = trim( p-key-rec )
     2634       .
     2635       if p-key-handle <> ? then do:
     2636         if not valid-handle(p-key-handle)
     2637            or p-key-handle:type <> "buffer"
     2638         then do:
     2639           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info22 ).
     2640         end.
     2641         if num-entries( p-key-rec, chr(3) ) > 1
     2642           or p-key-rec = ?
     2643           or p-key-rec = "":U
     2644         then do:
     2645           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info22, p-key-rec ).
     2646         end.
     2647       end.
     2648       else do:
     2649         if p-key-rec = ?
     2650           or p-key-rec = "":U
     2651         then do:
     2652           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info22 ).
     2653         end.
     2654       end.
     2655       assign
     2656         vTable = entry( 1 , p-key-rec, chr(3) )
     2657       .
     2658       if p-tt-handle <> ?
     2659         and ( not valid-handle(p-tt-handle)
     2660               or p-tt-handle:type <> "buffer"
     2661             )
     2662       then do:
     2663         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info22, vTable, chr(10) ).
     2664       end.
     2665       if p-tt-handle = ? then do:
     2666         assign
     2667           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     2668         .
     2669         create buffer bh_tbl-name for table v-full-tbl-name .
     2670       end.
     2671       else do:
     2672         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2673       end.
     2674       assign
     2675         v-inform = bh_tbl-name:index-information(1)
     2676         v-ind    = 2
     2677       .
     2678       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2679       on error undo, return error
     2680       :
     2681         assign
     2682           v-inform = bh_tbl-name:index-information( v-ind )
     2683           v-ind    = v-ind + 1
     2684         .
     2685       end.
     2686       if v-inform = ?
     2687         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2688         or entry( 3, v-inform, ",":U ) <> "1":U
     2689       then do:
     2690         delete object bh_tbl-name no-error.
     2691         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info22, vTable ).
     2692       end.
     2693       assign
     2694         v-idx-field-qnty = num-entries( v-inform ) - 4
     2695       .
     2696       if v-idx-field-qnty < 2 then do:
     2697         delete object bh_tbl-name no-error.
     2698         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info22, v-inform, vTable ).
     2699       end.
     2700       assign
     2701         o-where     = "where":U
     2702         v-word-link = "":U
     2703         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     2704         v-count-fld = 0
     2705       .
     2706       if i-tablekey ne "" and i-tablekey ne ?
     2707       then do:
     2708         assign
     2709           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     2710         .
     2711         create buffer bh_tbl-key for table v-full-tbl-name .
     2712       end.
     2713       if i-tableSerach ne "" and i-tableSerach ne ?
     2714       then do:
     2715         delete object bh_tbl-name no-error.
     2716         assign
     2717           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     2718         .
     2719         create buffer bh_tbl-name for table v-full-tbl-name .
     2720       end.
     2721       block_where:
     2722       do v-ind = 1 to v-idx-field-qnty by 2
     2723       on error undo, return error
     2724       :
     2725         assign
     2726           v-count-fld = v-count-fld + 1
     2727         .
     2728         if p-key-handle = ?
     2729           and v-count-fld > v-field-num
     2730         then do:
     2731           leave block_where.
     2732         end.
     2733         define variable VfieldKeyTable as handle no-undo.
     2734         assign
     2735           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     2736           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     2737         .
     2738         if     bh_tbl-key ne ?
     2739         then do:
     2740            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     2741            if VfieldKeyTable eq ?
     2742            then next block_where.
     2743         end.
     2744         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     2745         then
     2746            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     2747         else
     2748            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     2749         if p-key-handle = ? then do:
     2750           assign
     2751             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     2752           .
     2753         end.
     2754         else do:
     2755           assign
     2756             fh_key = p-key-handle:buffer-field( v-field-name )
     2757           .
     2758           if fh_key = ?
     2759             or not valid-handle( fh_key )
     2760           then do:
     2761             delete object bh_tbl-name.
     2762             if     bh_tbl-key ne ?
     2763             then
     2764                delete object bh_tbl-key.
     2765             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info22, p-key-handle:name, v-field-name ).
     2766           end.
     2767           assign
     2768             v-field-val = fh_key:buffer-value
     2769           .
     2770         end.
     2771         if fh_search:data-type ="character":U then do:
     2772           assign
     2773             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     2774             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     2775             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     2776             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     2777             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     2778             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     2779             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     2780             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     2781             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     2782             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     2783             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     2784             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     2785             v-field-val = substitute( '"&1"', v-field-val )
     2786           .
     2787         end.
     2788         assign
     2789           o-where = substitute( "&1 &2", o-where, v-field-val )
     2790         .
     2791         if v-word-link = "":U then do:
     2792           assign
     2793             v-word-link = "and":U
     2794           .
     2795         end.
     2796       end.
     2797       delete object bh_tbl-name.
     2798       if     bh_tbl-key ne ?
     2799       then
     2800          delete object bh_tbl-key.
     2801       if p-key-handle = ?
     2802         and v-count-fld <> v-field-num
     2803       then do:
     2804         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info22, vTable ).
     2805       end.
     2806     end.
     2807   end procedure.
     2808   procedure gen-hn-keyr-tab :
     2809     define input  parameter i-tableSerach as character no-undo.
     2810     define input  parameter i-tablekey   as character no-undo.
     2811     define input  parameter p-key-rec    as character no-undo.
     2812     define input  parameter p-key-handle as handle    no-undo .
     2813     define input  parameter p-db-name    as character no-undo .
     2814     define input  parameter p-tt-handle  as handle    no-undo .
     2815     define input  parameter p-stts-lock  as integer   no-undo .
     2816     define output parameter o-hn         as handle    no-undo.
     2817     define variable v-full-tbl-name as character no-undo.
     2818     define variable v-where         as character no-undo.
     2819     define variable bh_tbl-name     as handle    no-undo.
     2820     define variable vTable          as character no-undo.
     2821     do
     2822     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2823     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2824     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     2825         run gen-where-keyr-tab(i-tableSerach,
     2826                                i-tablekey,
     2827                                p-key-rec,
     2828                                p-key-handle,
     2829                                p-db-name,
     2830                                p-tt-handle,
     2831                                output v-where).
     2832         if i-tableSerach ne "" and i-tableSerach ne ?
     2833         then do:
     2834            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     2835            create buffer bh_tbl-name for table v-full-tbl-name .
     2836         end.
     2837         else do:
     2838            if p-tt-handle = ? then do:
     2839               assign
     2840                  vTable = entry( 1 , p-key-rec, chr(3) )
     2841               .
     2842               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     2843               create buffer bh_tbl-name for table v-full-tbl-name .
     2844            end.
     2845            else do:
     2846               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2847            end.
     2848         end.
     2849         if p-tt-handle = ? then do:
     2850            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     2851         end.
     2852         else do:
     2853            bh_tbl-name:find-first( v-where ) no-error .
     2854         end.
     2855         o-hn = bh_tbl-name.
     2856      end.
     2857   end procedure.
     2858   procedure gen-hn-keyr :
     2859     define input  parameter p-key-rec    as character no-undo.
     2860     define input  parameter p-key-handle as handle    no-undo .
     2861     define input  parameter p-db-name    as character no-undo .
     2862     define input  parameter p-tt-handle  as handle    no-undo .
     2863     define input  parameter p-stts-lock  as integer   no-undo .
     2864     define output parameter o-hn         as handle    no-undo.
     2865     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     2866   end.
     2867   procedure gen-row-keyr :
     2868     define input  parameter p-key-rec    as character no-undo.
     2869     define input  parameter p-key-handle as handle    no-undo .
     2870     define input  parameter p-db-name    as character no-undo .
     2871     define input  parameter p-tt-handle  as handle    no-undo .
     2872     define input  parameter p-stts-lock  as integer   no-undo .
     2873     define output parameter p-tbl-row    as rowid     no-undo.
     2874     define output parameter p-tbl-name   as character no-undo.
     2875     define variable vHn as handle no-undo.
     2876       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     2877       p-tbl-row = if vHn:available then vHn:rowid else ?.
     2878       p-tbl-name =  vHn:table.
     2879       delete object vHn no-error.
     2880     if p-tbl-row = ? then do:
     2881       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info22, p-tbl-name, p-key-rec ).
     2882     end.
     2883     else do:
     2884       return.
     2885     end.
     2886   end procedure.
     2887   procedure gen-key-fv :
     2888     define input  parameter p-key-rec    as character no-undo .
     2889     define output parameter p-field-list as character no-undo .
     2890     define output parameter p-value-list as character no-undo.
     2891     do
     2892     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2893     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2894     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2895     :
     2896       define variable v-full-tbl-name  as character no-undo .
     2897       define variable bh_tbl-name      as handle    no-undo .
     2898       define variable v-tbl-name       as character no-undo .
     2899       define variable v-field-num      as integer   no-undo .
     2900       define variable v-count-fld      as integer   no-undo .
     2901       define variable v-inform         as character no-undo .
     2902       define variable v-ind            as integer   no-undo .
     2903       define variable v-idx-field-qnty as integer   no-undo .
     2904       define variable v-delim-key      as character no-undo .
     2905       if p-key-rec = ?
     2906         or p-key-rec = "":U
     2907       then do:
     2908         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info22 ).
     2909       end.
     2910       assign
     2911         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     2912         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2913       .
     2914       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2915       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info22 ).
     2916       assign
     2917         v-inform = bh_tbl-name:index-information(1)
     2918         v-ind    = 2
     2919       .
     2920       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2921       on error undo, return error
     2922       :
     2923         assign
     2924           v-inform = bh_tbl-name:index-information( v-ind )
     2925           v-ind    = v-ind + 1
     2926         .
     2927       end.
     2928       if v-inform = ?
     2929         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2930         or entry( 3, v-inform, ",":U ) <> "1":U
     2931       then do:
     2932         delete object bh_tbl-name no-error.
     2933         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info22, v-tbl-name ).
     2934       end.
     2935       assign
     2936         v-idx-field-qnty = num-entries( v-inform ) - 4
     2937       .
     2938       if v-idx-field-qnty < 2 then do:
     2939         delete object bh_tbl-name no-error.
     2940         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info22, v-inform, v-tbl-name ).
     2941       end.
     2942       assign
     2943         p-field-list = "":U
     2944         p-value-list = "":U
     2945         v-delim-key  = "":U
     2946         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     2947         v-count-fld  = 0
     2948       .
     2949       block_where:
     2950       do v-ind = 1 to v-idx-field-qnty by 2
     2951       on error undo, return error
     2952       :
     2953         assign
     2954           v-count-fld = v-count-fld + 1
     2955         .
     2956         if v-count-fld > v-field-num then do:
     2957           leave block_where.
     2958         end.
     2959         assign
     2960           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     2961           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     2962         .
     2963         if v-ind = 1 then do:
     2964           assign
     2965             v-delim-key = chr(3)
     2966           .
     2967         end.
     2968       end.
     2969       delete object bh_tbl-name.
     2970       if v-count-fld <> v-field-num then do:
     2971         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info22, v-tbl-name ).
     2972       end.
     2973     end.
     2974   end procedure.
     2975   procedure gen-key-field :
     2976     define input  parameter p-table      as character no-undo .
     2977     define output parameter p-field-list as character no-undo .
     2978     do
     2979     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2980     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2981     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2982     :
     2983       define variable v-full-tbl-name  as character no-undo .
     2984       define variable bh_tbl-name      as handle    no-undo .
     2985       define variable v-tbl-name       as character no-undo .
     2986       define variable v-field-num      as integer   no-undo .
     2987       define variable v-count-fld      as integer   no-undo .
     2988       define variable v-inform         as character no-undo .
     2989       define variable v-ind            as integer   no-undo .
     2990       define variable v-idx-field-qnty as integer   no-undo .
     2991       define variable v-delim-key      as character no-undo .
     2992       if p-table = ?
     2993         or p-table = "":U
     2994       then do:
     2995         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info22 ).
     2996       end.
     2997       assign
     2998         v-tbl-name      = p-table
     2999         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     3000       .
     3001       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     3002       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info22 ).
     3003       assign
     3004         v-inform = bh_tbl-name:index-information(1)
     3005         v-ind    = 2
     3006       .
     3007       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3008       on error undo, return error
     3009       :
     3010         assign
     3011           v-inform = bh_tbl-name:index-information( v-ind )
     3012           v-ind    = v-ind + 1
     3013         .
     3014       end.
     3015       if v-inform = ?
     3016         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3017         or entry( 3, v-inform, ",":U ) <> "1":U
     3018       then do:
     3019         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info22, v-tbl-name ).
     3020       end.
     3021       assign
     3022         v-idx-field-qnty = num-entries( v-inform ) - 4
     3023       .
     3024       if v-idx-field-qnty < 2 then do:
     3025         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info22, v-inform, v-tbl-name ).
     3026       end.
     3027       assign
     3028         p-field-list = "":U
     3029         v-delim-key  = "":U
     3030         v-count-fld  = 0
     3031       .
     3032       block_where:
     3033       do v-ind = 1 to v-idx-field-qnty by 2
     3034       on error undo, return error
     3035       :
     3036         assign
     3037           v-count-fld = v-count-fld + 1
     3038         .
     3039         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     3040         if v-ind = 1 then do:
     3041           assign
     3042             v-delim-key = chr(3)
     3043           .
     3044         end.
     3045       end.
     3046       delete object bh_tbl-name.
     3047     end.
     3048   end procedure.
     3049   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3050   procedure gdsoattr-name :
     3051     define input  parameter p-code           as character no-undo .
     3052     define output parameter p-type           as character no-undo .
     3053     define output parameter p-format         as character no-undo .
     3054     define output parameter p-label          as character no-undo .
     3055     define output parameter p-user-can-edit  as logical   no-undo .
     3056     define output parameter p-output-display as logical   no-undo .
     3057     define output parameter p-other          as character no-undo .
     3058     do
     3059     on error undo, return error
     3060     :
     3061           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsoattr-name in g#attr-lib
     3062         (input  p-code
     3063         ,output p-type
     3064         ,output p-format
     3065         ,output p-label
     3066         ,output p-user-can-edit
     3067         ,output p-output-display
     3068         ,output p-other
     3069         ) no-error .
     3070       if error-status :error
     3071       then do:
     3072         undo, return error return-value .
     3073       end.
     3074     end.
     3075   end.
     3076   procedure gdsoattr-tooltip :
     3077     define input  parameter p-code    as character no-undo .
     3078     define output parameter p-tooltip as character no-undo .
     3079     define output parameter p-label   as character no-undo .
     3080     do
     3081     on error undo, return error
     3082     :
     3083           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsoattr-tooltip in g#attr-lib
     3084         (input  p-code
     3085         ,output p-tooltip
     3086         ,output p-label
     3087         ) no-error .
     3088       if error-status :error
     3089       then do:
     3090         undo, return error return-value .
     3091       end.
     3092     end.
     3093   end.
     3094   procedure gdsoattr-value :
     3095     define input  parameter p-code     like ub.gds-obj-attr.attr-code  no-undo .
     3096     define input  parameter p-gds-code like ub.gds-obj-attr.gds-code   no-undo .
     3097     define input  parameter p-obj-type like ub.gds-obj-attr.obj-type   no-undo .
     3098     define input  parameter p-obj-code like ub.gds-obj-attr.obj-code   no-undo .
     3099     define output parameter p-value    like ub.gds-obj-attr.attr-value no-undo .
     3100     define output parameter p-type     as character no-undo .
     3101     do
