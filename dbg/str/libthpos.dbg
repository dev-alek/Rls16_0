      683   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      684   FUNCTION name-2cdf returns character
      685                      (  input p-name-2cd as character
      686                       , input p-mode as logical
      687                       , input p-cod-pcod as logical
      688                       , input p-b-code  as integer
      689                       , input p-gds-code as integer
      690                       , input p-artic   as character
      691                       , input p-engl-name  as character
      692                       , input p-in-code as character
      693                       , input p-part-code as character
      694                       , input p-obj-type as character
      695                       , input p-obj-code as integer
      696                       , input p-alpha1 as character
      697                       , output p-gtd as character
      698                       ) :
      699   define variable v-name-2cd as character no-undo .
      700   define variable v-dop-alt-name as character no-undo.
      701   define variable v-type as character no-undo.
      702   define buffer buf_parts for ub.parts.
      703   define buffer buf_code for ub.code.
      704   if not p-mode and p-name-2cd = "PLU":U then do:
      705     return "PLU кассы":U.
      706   end.
      707   if not p-mode then do:
      708     if p-name-2cd <> "GTD":U
      709     and  p-name-2cd <> "alpha1|gtd":U
      710     then do:
      711     assign
      712     p-name-2cd = p-name-2cd + "-":U + "GTD":U.
      713   end.
      714   end.
      715   if p-part-code = "":U or p-cod-pcod = no then do:
      716     run gdsoattr-value in this-procedure (
      717       'dt-seasons':U,
      718       p-gds-code,
      719       p-obj-type,
      720       p-obj-code,
      721       output v-dop-alt-name,
      722       output v-type
      723     ) no-error.
      724     if v-dop-alt-name <> "" then do:
      725       find first buf_code where
      726                  buf_code.parent = "DTSeasons"
      727              and buf_code.code   = v-dop-alt-name
      728            no-lock no-error.
      729       if available buf_code then
      730         assign
      731           p-engl-name = ""
      732           v-dop-alt-name =  buf_code.misc1
      733         .
      734     end.
      735     else do:
      736       run gdsoattr-value in this-procedure
      737                           ( input  'dop-alt-name-o':U
      738                            ,input  p-gds-code
      739                            ,input  p-obj-type
      740                            ,input  p-obj-code
      741                            ,output v-dop-alt-name
      742                            ,output v-type
      743                           ) no-error .
      744     end.
      745     CASE p-name-2cd:
      746       when "name" then do:
      747         if p-mode then return p-engl-name + v-dop-alt-name.
      748         return "Англ. название".
      749       end.
      750       when "code":U then do:
      751         if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
      752         return "Лок. код товара"  .
      753       end.
      754       when "GTD":U
      755       or
      756       when "name-GTD":U
      757       or
      758       when "code-GTD":U
      759       or
      760       when "alpha1|gtd":U
      761       or
      762       when "name-alpha1|gtd":U
      763       or
      764       when "code-alpha1|gtd":U
      765       then do:
      766         if p-mode then do:
      767           run gdcstcod_cst-code  in this-procedure (
      768                                                       input  p-obj-type
      769                                                       ,input  p-obj-code
      770                                                       ,input  p-gds-code
      771                                                       ,input  p-in-code
      772                                                       ,input  p-part-code
      773                                                       ,output p-gtd
      774                                                       ) no-error .
      775         end.
      776         if p-name-2cd = "name-gtd":U then do:
      777           if p-mode then return p-engl-name  + v-dop-alt-name.
      778           return "Англ. название".
      779         end.
      780         if p-name-2cd = "name-alpha1|gtd":U then do:
      781           if p-mode then return p-engl-name  + v-dop-alt-name.
      782           return "Англ. название".
      783         end.
      784         if p-name-2cd = "code-GTD":U then do:
      785           if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
      786           return "Лок. код товара"  .
      787         end.
      788         if p-name-2cd = "code-alpha1|gtd":U then do:
      789           if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
      790           return "Лок. код товара"  .
      791         end.
      792         if p-mode then do:
      793           if p-name-2cd = "GTD" then  return p-gtd.
      794           if p-name-2cd = "alpha1|gtd" then  return (p-alpha1 + "|" + p-gtd).
      795         end.
      796         if p-name-2cd = "GTD" then  return "Код ГТД".
      797         if p-name-2cd = "alpha1|gtd" then  return "Страна|Код ГТД".
      798       end.
      799     END CASE.
      800   end.
      801   else do:
      802     if p-name-2cd = "name-gtd":U
      803     or p-name-2cd = "code-GTD":U
      804     or p-name-2cd = "name-alpha1|GTD":U
      805     or p-name-2cd = "code-alpha1|GTD":U
      806     or p-name-2cd = "alpha1|GTD":U
      807     then do:
      808       if p-mode then do:
      809         run gdcstcod_cst-code  in this-procedure (
      810                                                      input  p-obj-type
      811                                                     ,input  p-obj-code
      812                                                     ,input  p-gds-code
      813                                                     ,input  p-in-code
      814                                                     ,input  p-part-code
      815                                                     ,output p-gtd
      816                                                     ) no-error .
      817       end.
      818       else do:
      819         if p-name-2cd = "gtd":U then
      820         p-gtd = "Код ГТД".
      821         if p-name-2cd = "alpha1|Gtd":U then
      822         p-gtd = "Страна|Код ГТД".
      823       end.
      824     end.
      825     if p-mode then  return p-part-code.
      826     return "Код партии".
      827   end.
      828   END FUNCTION.
      829   function chk-name_ibm_maria_ibm-xml_infokiosk_ibs-th returns character ( input p-pos-type as character
      830                                            ,input p-nam-2str as logical
      831                                            ,input p-nam-artc as logical
      832                                            ,input p-unit-cli-type as character
      833                                            ,input p-unit-base as character
      834                                            ,input p-unit-cli as character
      835                                            ,input p-cli-base-rate as decimal
      836                                            ,input p-artic as character
      837                                            ,input p-f-name as character
      838                                            ,input p-gds-name as character
      839                                            ,input p-gds-name1 as character
      840                                            ,output p-second-name as character):
      841   define variable v-length as integer no-undo .
      842   define variable nam-2str-shift as integer no-undo .
      843   define variable chk_name as character no-undo .
      844   assign
      845   v-length = (if p-pos-type = 'IBM':U then 25 else 40 )
      846   v-length = (if p-pos-type = 'MARIA':U then 24 else v-length)
      847   v-length = (if p-pos-type = 'MARIA':U and lookup('топ':U, p-unit-cli-type) > 0
      848               then 5
      849               else v-length)
      850   v-length = (if p-pos-type = 'IBM-XML':U then 128 else v-length )
      851   nam-2str-shift = (if p-nam-2str then v-length else 0)
      852   .
      853   if p-nam-artc then do:
      854     assign
      855     chk_name = substitute("&1 &2", p-artic, p-f-name)
      856       .
      857   end.
      858   else  do:
      859     assign
      860     chk_name = replace(p-gds-name, chr(34), "":U) + p-f-name
      861     .
      862   end.
      863   if p-unit-base <> p-unit-cli then do:
      864     if length (chk_name) > 109 then chk_name = substring (chk_name,1,109) .
      865     assign
      866     chk_name = string(substr(chk_name
      867                               ,1
      868                               ,max(14, v-length + nam-2str-shift - 1 - length(trim(string(p-cli-base-rate), chr(32)))) +  nam-2str-shift ) +
      869                       "*":U +
      870                       trim(string(p-cli-base-rate), chr(32)), "x(":U + string(v-length + nam-2str-shift) + ")":U ).
      871   end.
      872   else do:
      873     chk_name = string(chk_name, "X(":U + string(v-length + nam-2str-shift) + ")":U).
      874   end.
      875   if p-nam-2str then do:
      876     assign
      877     p-second-name = chr(34) + trim(substr(chk_name, v-length)," ") + chr(34)
      878     chk_name = substr(chk_name, 1, v-length)
      879     .
      880   end.
      881   else do:
      882     assign
      883     p-second-name = replace(p-gds-name1, chr(39), "":U)
      884     p-second-name =   (chr(34) +
      885                       TRIM(string( replace(p-second-name, chr(34), "":U), "X(":U + string(v-length) + ")":U ))
      886                       + chr(34) )
      887     .
      888   end.
      889   return chk_name.
      890   end function.
      891   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      892   define new global shared variable g#libchkvl as handle no-undo .
      893   function libchkvl_right-netto-sign returns integer ( input p-chk-type as integer) in G#libchkvl.
      894   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      895   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      896   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      897   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      898   procedure factord :
      899     define input  parameter p-fact-date            as date    no-undo .
      900     define input  parameter p-fact-time            as integer no-undo .
      901     define input  parameter p-fact-num             as integer no-undo .
      902     define input  parameter p-shift-date           as date    no-undo .
      903     define input  parameter p-shift-num            as integer no-undo .
      904     define input  parameter p-shift-on             as logical no-undo .
      905     define output parameter p-fact-order           as decimal no-undo .
      906     define output parameter p-shift-end-fact-order as decimal no-undo .
      907     define output parameter p-day-end-fact-order   as decimal no-undo .
      908     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      909     if p-fact-date = ?
      910     then do:
      911       return error "Не указана фактическая дата" .
      912     end.
      913     define variable v-fact-date-num as integer no-undo .
      914     assign
      915       v-fact-date-num = integer(p-fact-date)
      916     .
      917     if p-fact-num = ?
      918     or p-fact-num = 0
      919     then do:
      920       return error "Не задан p-fact-num " + string(p-fact-num) .
      921     end.
      922     if p-fact-num < 0
      923     then do:
      924       return error "Отрицательный fact-num " + string(p-fact-num) .
      925     end.
      926     if p-fact-num >= 100000000
      927     then do:
      928       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      929     end.
      930     if p-shift-on = true
      931     then do:
      932       if p-shift-date = ?
      933       then do:
      934         return error "Не задана дата смены" .
      935       end.
      936       if p-shift-num = ?
      937       or p-shift-num = 0
      938       then do:
      939         return error "Не задан номер смены" .
      940       end.
      941     end.
      942     else do:
      943       assign
      944         p-shift-date = p-fact-date
      945         p-shift-num  = 24
      946       .
      947     end.
      948     define variable v-shift-offset as integer no-undo .
      949     if p-shift-date = p-fact-date
      950     then do:
      951       assign
      952         v-shift-offset = 1
      953       .
      954     end.
      955     if p-shift-date < p-fact-date
      956     then do:
      957       assign
      958         v-shift-offset = 0
      959       .
      960     end.
      961     if p-shift-date > p-fact-date
      962     then do:
      963       message
      964         vss-workfile vss-revision vss-description skip
      965         "Неправильная дата закрытия смены" skip
      966         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      967         view-as alert-box error .
      968       undo, return error
      969         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      970           ,string(p-fact-date, '99/99/9999':U)
      971           ,string(p-shift-date, '99/99/9999':U)
      972           )
      973       .
      974     end.
      975     if p-shift-num < 1
      976     or p-shift-num > 24
      977     then do:
      978       message
      979         vss-workfile vss-revision vss-description skip
      980         "Неправильный номер смены" skip
      981         "p-shift-num" p-shift-num skip
      982         view-as alert-box error .
      983       undo, return error return-value .
      984     end.
      985     assign
      986       p-fact-order           = v-fact-date-num
      987                              + v-shift-offset * 0.5
      988                              + p-shift-num    * 0.02 - 0.01
      989                              + p-fact-num     * 0.0000000001
      990       p-shift-end-fact-order = v-fact-date-num
      991                              + v-shift-offset * 0.5
      992                              + p-shift-num    * 0.02
      993       p-day-end-fact-order   = v-fact-date-num
      994                              + 0.99
      995     .
      996     if p-fact-order           <= v-fact-date-num
      997     or p-shift-end-fact-order <= v-fact-date-num
      998     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      999     or p-shift-end-fact-order >= p-day-end-fact-order
     1000     then do:
     1001       message
     1002         vss-workfile vss-revision vss-description skip
     1003         "Внутренняя ошибка при генерации фактического номера" skip
     1004         "p-fact-date"            p-fact-date            skip
     1005         "p-fact-time"            p-fact-time            skip
     1006         "p-fact-num"             p-fact-num             skip
     1007         "p-shift-date"           p-shift-date           skip
     1008         "p-shift-num"            p-shift-num            skip
     1009         "p-shift-on"             p-shift-on             skip
     1010         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1011         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1012         "v-fact-date-num"        v-fact-date-num        skip
     1013         view-as alert-box error .
     1014       undo, return error return-value .
     1015     end.
     1016   end procedure.
     1017   procedure day-begin-fact-order :
     1018     define input  parameter p-fact-date            as date    no-undo .
     1019     define output parameter p-day-begin-fact-order as decimal no-undo .
     1020     do
     1021     on error undo, return error return-value
     1022     :
     1023       if p-fact-date = ?
     1024       then do:
     1025         assign
     1026           p-day-begin-fact-order = 0
     1027         .
     1028       end.
     1029       else do:
     1030         assign
     1031           p-day-begin-fact-order = integer(p-fact-date)
     1032         .
     1033       end.
     1034     end.
     1035   end procedure.
     1036   procedure factord-max-fact-order :
     1037     define output parameter p-max-fact-order as decimal   no-undo .
     1038     do
     1039     on error undo, return error return-value
     1040     :
     1041       run day-begin-fact-order in this-procedure
     1042         (input  date(1, 1, 5000)
     1043         ,output p-max-fact-order
     1044         ) .
     1045     end.
     1046   end procedure.
     1047   procedure factord-cut-archive :
     1048     define input  parameter p-obj-type             as character no-undo .
     1049     define input  parameter p-obj-code             as integer   no-undo .
     1050     define input  parameter p-fact-date            as date      no-undo .
     1051     define output parameter p-shift-on             as logical   no-undo .
     1052     define output parameter p-shift-date           as date      no-undo .
     1053     define output parameter p-shift-num            as integer   no-undo .
     1054     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1055     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1056     define variable v-fact-order as decimal   no-undo .
     1057     define buffer buf_shift-obj for ub.shift-obj .
     1058     do
     1059     on error undo, return error return-value
     1060     :
     1061   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1062   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1063     (input  p-obj-type
     1064     ,input  p-obj-code
     1065     ,input  'shift-on=request'
     1066     ,output p-shift-on
     1067     ) no-error .
     1068       if error-status :error
     1069       then do:
     1070         message
     1071           vss-workfile vss-revision vss-description skip
     1072           "Ошибка при определении атрибута объекта" skip
     1073           "Объект" p-obj-type p-obj-code skip
     1074           error-status :get-message(1) skip
     1075           return-value skip
     1076           view-as alert-box error .
     1077         undo, return error return-value .
     1078       end.
     1079       if p-shift-on = false
     1080       then do:
     1081         assign
     1082           p-shift-date               = ?
     1083           p-shift-num                = 0
     1084         .
     1085       end.
     1086       else do:
     1087         find first buf_shift-obj share-lock
     1088           where buf_shift-obj.obj-type   = p-obj-type
     1089             and buf_shift-obj.obj-code   = p-obj-code
     1090             and buf_shift-obj.shift-date > p-fact-date
     1091           use-index pi
     1092           no-error .
     1093         if not available buf_shift-obj
     1094         or buf_shift-obj.status_ <> 'зкр':U
     1095         then do:
     1096           message
     1097             vss-workfile vss-revision vss-description skip
     1098             "Невозможно вычислить последнюю смену" skip
     1099             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1100             "Объект" p-obj-type p-obj-code skip
     1101             "Дата" p-fact-date skip
     1102             view-as alert-box error .
     1103           undo, return error return-value .
     1104         end.
     1105         find last buf_shift-obj share-lock
     1106           where buf_shift-obj.obj-type = p-obj-type
     1107             and buf_shift-obj.obj-code = p-obj-code
     1108             and buf_shift-obj.shift-date <= p-fact-date
     1109           use-index pi
     1110           no-error .
     1111         if available buf_shift-obj
     1112         then do:
     1113           if  buf_shift-obj.status_ = 'зкр':U
     1114           then do:
     1115             assign
     1116               p-shift-date = buf_shift-obj.shift-date
     1117               p-shift-num  = buf_shift-obj.shift-num
     1118             .
     1119           end.
     1120           else do:
     1121             message
     1122               vss-workfile vss-revision vss-description skip
     1123               "Невозможно вычислить последнюю смену" skip
     1124               "Статус смены отличен от статуса" 'зкр':U skip
     1125               "Объект" p-obj-type p-obj-code skip
     1126               "Дата" p-fact-date skip
     1127               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1128               view-as alert-box error .
     1129             undo, return error return-value .
     1130           end.
     1131         end.
     1132         else do:
     1133           assign
     1134             p-shift-date = p-fact-date - 1
     1135             p-shift-num  = 1
     1136           .
     1137         end.
     1138       end.
     1139       run factord in this-procedure
     1140         (input  p-fact-date
     1141         ,input  1
     1142         ,input  1
     1143         ,input  p-shift-date
     1144         ,input  p-shift-num
     1145         ,input  p-shift-on
     1146         ,output v-fact-order
     1147         ,output p-shift-end-fact-order
     1148         ,output p-day-end-fact-order
     1149         ) no-error .
     1150       if error-status :error
     1151       then do:
     1152         message
     1153           vss-workfile vss-revision vss-description skip
     1154           "Ошибка при вызове процедуры factord"
     1155           error-status :get-message(1) skip
     1156           return-value skip
     1157           view-as alert-box error .
     1158         undo, return error return-value .
     1159       end.
     1160     end.
     1161   end procedure.
     1162   procedure factord-lock-shift :
     1163     define input  parameter p-obj-type  as character no-undo .
     1164     define input  parameter p-obj-code  as integer   no-undo .
     1165     define input  parameter p-fact-date as date      no-undo .
     1166     define parameter buffer buf_shift-obj for ub.shift-obj .
     1167     define variable v-shift-on      as logical   no-undo .
     1168     define variable v-extra-message as character no-undo .
     1169     define variable v-error as character no-undo .
     1170     do
     1171     on error undo, return error return-value
     1172     :
     1173   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1174   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1175     (input  p-obj-type
     1176     ,input  p-obj-code
     1177     ,input  'shift-on=request'
     1178     ,output v-shift-on
     1179     ) no-error .
     1180       if error-status :error
     1181       then do:
     1182         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1183         undo, return error v-error .
     1184       end.
     1185       if v-shift-on = true
     1186       then do:
     1187         find first buf_shift-obj share-lock
     1188           where buf_shift-obj.obj-type   = p-obj-type
     1189             and buf_shift-obj.obj-code   = p-obj-code
     1190             and buf_shift-obj.shift-date > p-fact-date
     1191           use-index pi
     1192           no-error .
     1193         if not available buf_shift-obj
     1194         or buf_shift-obj.status_ <> 'зкр':U
     1195         then do:
     1196           find last buf_shift-obj
     1197             where buf_shift-obj.obj-type = p-obj-type
     1198               and buf_shift-obj.obj-code = p-obj-code
     1199               and buf_shift-obj.status_  = 'зкр':U
     1200             use-index stts
     1201             no-error .
     1202           if available buf_shift-obj
     1203           then do:
     1204             assign
     1205               v-extra-message =
     1206                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1207                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1208                               )
     1209             .
     1210           end.
     1211           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1212           undo, return error v-error .
     1213         end.
     1214       end.
     1215     end.
     1216   end procedure.
     1217   procedure factord-end-day :
     1218     define input  parameter p-fact-date            as date    no-undo .
     1219     define output parameter p-day-end-fact-order   as decimal no-undo .
     1220     do
     1221     on error undo, return error return-value
     1222     :
     1223       if p-fact-date = ?
     1224       then do:
     1225         return error "Не указана фактическая дата" .
     1226       end.
     1227       assign
     1228         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1229       .
     1230     end.
     1231   end procedure.
     1232   procedure factord-to-date :
     1233     define input  parameter p-fact-order as decimal no-undo .
     1234     define output parameter p-fact-date  as date    no-undo .
     1235     define variable v-ref-date  as date      no-undo .
     1236     define variable v-ref-delta as integer   no-undo .
     1237     do
     1238     on error undo, return error return-value
     1239     :
     1240       if p-fact-order = ?
     1241       or p-fact-order = 0
     1242       then do:
     1243         return error "Не указан fact-order" .
     1244       end.
     1245       assign
     1246         v-ref-date  = date(1, 1, 2000)
     1247       .
     1248       assign
     1249         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1250       .
     1251       assign
     1252         p-fact-date = v-ref-date + v-ref-delta
     1253       .
     1254     end.
     1255   end procedure.
     1256   procedure factord-to-fact-num :
     1257     define input  parameter p-fact-order as decimal no-undo .
     1258     define output parameter p-fact-num   as integer no-undo .
     1259     define variable v-fact-order-trunc as decimal no-undo .
     1260     do
     1261     on error undo, return error return-value
     1262     :
     1263       if p-fact-order = ?
     1264       or p-fact-order = 0
     1265       then do:
     1266         return error "Не указан fact-order" .
     1267       end.
     1268       assign
     1269        v-fact-order-trunc = truncate(p-fact-order, 2)
     1270       .
     1271       assign
     1272         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1273       .
     1274     end.
     1275   end procedure.
     1276   procedure factord-to-shift-num :
     1277     define input  parameter p-fact-order as decimal no-undo .
     1278     define output parameter p-shift-num   as integer no-undo .
     1279     define variable  p-shift-numd  as decimal   no-undo .
     1280     define variable v-fact-order-trunc as decimal no-undo .
     1281     do
     1282     on error undo, return error return-value
     1283     :
     1284       if p-fact-order = ?
     1285       or p-fact-order = 0
     1286       then do:
     1287         return error "Не указан fact-order" .
     1288       end.
     1289       assign
     1290        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1291       .
     1292       if v-fact-order-trunc < 0.5 then do:
     1293         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1294       end.
     1295       assign
     1296         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1297         .
     1298        assign
     1299         p-shift-num = truncate (p-shift-numd , 0)
     1300       .
     1301     end.
     1302   end procedure.
     1303   procedure fact-order-mpl :
     1304     do
     1305     on error undo, return error return-value
     1306     :
     1307   define input  parameter p-doc-date as date     no-undo .
     1308   define input  parameter p-obj-type as character no-undo .
     1309   define input  parameter p-obj-code as integer   no-undo .
     1310   define output parameter p-fact-order as decimal   no-undo .
     1311   define variable v-fact-date            as date    no-undo .
     1312   define variable v-fact-time            as integer no-undo .
     1313   define variable v-fact-order           as decimal no-undo .
     1314   define variable v-shift-end-fact-order as decimal no-undo .
     1315   define variable v-day-end-fact-order   as decimal no-undo .
     1316   define variable l-shift-on as logical no-undo .
     1317   define variable l-date as date      no-undo .
     1318   define variable l-time as integer   no-undo .
     1319   define variable shift-date as date      no-undo .
     1320   define variable shift-num  as integer   no-undo .
     1321   define variable shift-name as character no-undo .
     1322   define variable max-fact-order as decimal   no-undo .
     1323   define buffer buf_global-state for ub.global-state  .
     1324   find first buf_global-state no-lock no-error .
     1325   if not available buf_global-state then do:
     1326      message
     1327        "Не заданы параметры ценообразования!"
     1328        view-as alert-box error
     1329      .
     1330      return error return-value .
     1331   end.
     1332     run cur-time in this-procedure
     1333     ( output v-fact-date ,
     1334       output v-fact-time  ).
     1335   if p-doc-date = ? then do:
     1336   if buf_global-state.pl-use-sys-date-time  = true then do:
     1337         run factord in this-procedure
     1338           (input  v-fact-date
     1339           ,input  v-fact-time
     1340           ,input  v-fact-time
     1341           ,input  ?
     1342           ,input  ?
     1343           ,input  false
     1344           ,output v-fact-order
     1345           ,output v-shift-end-fact-order
     1346           ,output v-day-end-fact-order
     1347           ) no-error .
     1348         if error-status :error
     1349         or v-fact-order = ?
     1350         or v-fact-order = 0 then do:
     1351           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1352         end.
     1353         p-fact-order = v-fact-order .
     1354   end.
     1355   else do:
     1356   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1357   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1358     (input  p-obj-type
     1359     ,input  p-obj-code
     1360     ,input  'shift-on=request'
     1361     ,output l-shift-on
     1362     ) no-error .
     1363         if error-status :error then return error "Неопределена дата на объекте " + return-value .
     1364         if p-doc-date <> ? then do:
     1365         end.
     1366          run gbl/factdate.p
     1367          ( input        p-obj-type  ,
     1368            input        p-obj-code  ,
     1369            input-output v-fact-date ,
     1370            input-output v-fact-time ,
     1371            input-output shift-date      ,
     1372            input-output shift-num       ,
     1373            input-output shift-name      ,
     1374            input        yes
     1375            ) no-error .
     1376         if error-status :error then return error substitute(" Ошибка из factdate.p: &1 &2"  , return-value , error-status :get-message(1)   ) .
     1377         run factord in this-procedure
     1378           (input  v-fact-date
     1379           ,input  v-fact-time
     1380           ,input  v-fact-time
     1381           ,input  shift-date
     1382           ,input  shift-num
     1383           ,input  l-shift-on
     1384           ,output v-fact-order
     1385           ,output v-shift-end-fact-order
     1386           ,output v-day-end-fact-order
     1387           ) no-error .
     1388         if error-status :error
     1389         or v-fact-order = ?
     1390         or v-fact-order = 0 then do:
     1391           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1392         end.
     1393         p-fact-order = v-fact-order .
     1394   end.
     1395   end.
     1396   else do:
     1397          run gbl/factdate.p
     1398          ( input        p-obj-type  ,
     1399            input        p-obj-code  ,
     1400            input-output v-fact-date ,
     1401            input-output v-fact-time ,
     1402            input-output shift-date      ,
     1403            input-output shift-num       ,
     1404            input-output shift-name      ,
     1405            input        yes
     1406            ) no-error .
     1407         if error-status :error then return error "Ошибка factdate.p " + return-value .
     1408         v-fact-date = p-doc-date .
     1409         run factord in this-procedure
     1410           (input  v-fact-date
     1411           ,input  v-fact-time
     1412           ,input  v-fact-time
     1413           ,input  shift-date
     1414           ,input  shift-num
     1415           ,input  l-shift-on
     1416           ,output v-fact-order
     1417           ,output v-shift-end-fact-order
     1418           ,output v-day-end-fact-order
     1419           ) no-error .
     1420         if error-status :error
     1421         or v-fact-order = ?
     1422         or v-fact-order = 0 then do:
     1423           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     1424         end.
     1425         p-fact-order = v-fact-order .
     1426   end.
     1427     end.
     1428   end procedure.
     1429   DEFINE TEMP-TABLE tt_price-all NO-UNDO LIKE ub.price-all
     1430   field sale-qnty as decimal
     1431   field sale-sum  as decimal
     1432   field sale-tnv  as decimal
     1433   field price-sale-base as decimal
     1434   field price-sale-rubl as decimal
     1435   field road-tax-base   as decimal
     1436   field road-tax-rubl   as decimal
     1437   field excise-base as decimal
     1438   field excise-rubl as decimal
     1439   field date-1 as date
     1440   field date-2 as date
     1441   field shift-1 as int
     1442   field shift-2 as int
     1443   field time-1 as int
     1444   field time-2 as int
     1445   field grp-name as char
     1446   field interv-name as char
     1447   field pay-name as char
     1448   field unit-cli as char
     1449   index pi
     1450   plt-priority DESCENDING
     1451   fact-order DESCENDING
     1452   qnty-from asc
     1453   sum-from asc
     1454   turnover-from asc
     1455   date-1 DESCENDING
     1456   time-1 DESCENDING
     1457   date-2 DESCENDING
     1458   time-2 DESCENDING
     1459   type-price DESCENDING
     1460   .
     1461   procedure mpl-autoprice :
     1462   define input  parameter p-only-b-code as logical   no-undo .
     1463   define input  parameter p-cli-type    as character no-undo .
     1464   define input  parameter p-cli-code    as integer   no-undo .
     1465   define input  parameter p-main-b-code as integer   no-undo .
     1466   define input  parameter p-b-code      as integer   no-undo .
     1467   define input  parameter p-obj-type    as character no-undo .
     1468   define input  parameter p-obj-code    as integer   no-undo .
     1469   define input  parameter p-qnty-doc    as decimal   no-undo .
     1470   define input  parameter p-sum-doc     as decimal   no-undo .
     1471   define input  parameter p-vid-pay        as character no-undo .
     1472   define input  parameter p-cash-pay-type  as character no-undo .
     1473   define input  parameter p-fact-order  as decimal   no-undo .
     1474   define output parameter p-plt-id          as integer   no-undo .
     1475   define output parameter p-plt-db-num      as integer   no-undo .
     1476   define output parameter p-pdf-id          as integer   no-undo .
     1477   define output parameter p-pdf-db-num      as integer   no-undo .
     1478   define output parameter p-sale-price-base as decimal   no-undo .
     1479   define output parameter p-sale-price-rubl as decimal   no-undo .
     1480   define output parameter p-road-tax-base as decimal   no-undo .
     1481   define output parameter p-road-tax-rubl as decimal   no-undo .
     1482   define output parameter p-excise-base   as decimal   no-undo .
     1483   define output parameter p-excise-rubl   as decimal   no-undo .
     1484   define variable v-cli-oborot-ALL as decimal   no-undo .
     1485   define buffer buf_buyer-in-buyer-group   for ub.buyer-in-buyer-group  .
     1486   define buffer buf_turnover-buyer-main    for ub.turnover-buyer-main  .
     1487   define buffer buf1_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     1488   define buffer buf2_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     1489   define buffer buf_price-all              for ub.price-all  .
     1490   define buffer buf_goods                  for ub.goods      .
     1491   define buffer buf_global-state           for ub.global-state  .
     1492   define buffer buf_buyer-group            for ub.buyer-group  .
     1493   define buffer buf_turnover-group         for ub.turnover-group  .
     1494   define buffer buf_main-code              for ub.bar-code  .
     1495   define buffer buf_bar-code               for ub.bar-code  .
     1496   define buffer buf_pay-type               for ub.pay-type  .
     1497   define buffer buf_cash-pay               for ub.cash-pay  .
     1498   define variable to-day          as date      no-undo .
     1499   define variable v-base-rate0    as decimal   no-undo .
     1500   define variable v-base-scale0   as decimal   no-undo .
     1501   define variable v-exch-rate0    as decimal   no-undo .
     1502   define variable v-exch-scale0   as decimal   no-undo .
     1503   define variable v-base-rate     as decimal   no-undo .
     1504   define variable v-base-scale    as decimal   no-undo .
     1505   define variable v-exch-rate     as decimal   no-undo .
     1506   define variable v-exch-scale    as decimal   no-undo .
     1507   define variable v-host-code     as integer   no-undo .
     1508   define variable v-curr-abbr     as character no-undo .
     1509   define variable v-grp-name      as character no-undo .
     1510   define variable v-date-1        as date      no-undo .
     1511   define variable v-date-2        as date      no-undo .
     1512   define variable v-interv        as character no-undo .
     1513   define variable v-pay-name      as character no-undo .
     1514   define variable v-cli-oborot    as decimal   no-undo .
     1515   define variable v-trn-pay-code  as integer   no-undo .
     1516   define variable v-cash-pay-curr as integer   no-undo .
     1517   define variable v-cash-pay-code as integer   no-undo .
     1518   do
     1519   on error undo, return error return-value
     1520   :
     1521   find first buf_main-code no-lock where buf_main-code.b-code = p-main-b-code .
     1522   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
     1523   if p-fact-order = ? then do:
     1524     run fact-order-mpl (
     1525         input   today       ,
     1526         input   p-obj-type  ,
     1527         input   p-obj-code  ,
     1528         output  p-fact-order ).
     1529   end.
     1530   if p-vid-pay <> "" then do:
     1531      find first buf_pay-type no-lock where  buf_pay-type.obj-code = integer(p-vid-pay) no-error .
     1532      if available buf_pay-type
     1533         then v-trn-pay-code = buf_pay-type.obj-code.
     1534         else v-trn-pay-code =  0.
     1535   end.
     1536   else v-trn-pay-code = 0 .
     1537   if p-cash-pay-type <> "" then do:
     1538      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
     1539      if available buf_pay-type
     1540         then
     1541           assign
     1542             v-cash-pay-curr = buf_cash-pay.curr-code
     1543             v-cash-pay-code = buf_cash-pay.cdpay-code
     1544           .
     1545         else
     1546           assign
     1547             v-cash-pay-curr = 0
     1548             v-cash-pay-code = 0
     1549             .
     1550   end.
     1551   else
     1552     assign
     1553       v-cash-pay-curr = 0
     1554       v-cash-pay-code = 0
     1555       .
     1556   for each tt_price-all  : delete tt_price-all . end.
     1557   assign
     1558     p-plt-id             = ?
     1559     p-plt-db-num         = ?
     1560     p-pdf-id             = ?
     1561     p-pdf-db-num         = ?
     1562     p-sale-price-base    = ?
     1563     p-sale-price-rubl    = ?
     1564     v-cli-oborot         = 0
     1565   .
     1566   find first buf_global-state no-lock no-error .
     1567   if not available buf_global-state then do:
     1568      message
     1569        "Не заданы параметры ценообразования!"
     1570        view-as alert-box error
     1571      .
     1572      return error return-value .
     1573   end.
     1574   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1575   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1576     (input  p-obj-type
     1577     ,input  p-obj-code
     1578     ,output to-day
     1579     )  .
     1580   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1581   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1582     (input  p-obj-type
     1583     ,input  p-obj-code
     1584     ,output v-host-code
     1585     )  .
     1586   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1587   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     1588     (input  v-host-code
     1589     ,input  to-day
     1590     ,output v-base-rate0
     1591     ,output v-base-scale0
     1592     )  .
     1593     v-cli-oborot-ALL  = 0 .
     1594     for each buf_turnover-buyer-main no-lock  where
     1595              buf_turnover-buyer-main.cli-type = p-cli-type  and
     1596              buf_turnover-buyer-main.cli-code = p-cli-code
     1597              :
     1598              v-cli-oborot-ALL = v-cli-oborot-ALL + buf_turnover-buyer-main.sum-doc-rubl-itog .
     1599     end.
     1600   for each buf_price-all no-lock where
     1601            buf_price-all.obj-type = p-obj-type and
     1602            buf_price-all.obj-code = p-obj-code and
     1603            buf_price-all.gds-code = buf_goods.gds-code and
     1604            buf_price-all.status_  = 'акт':U  and
     1605          ( p-only-b-code = false   or
     1606          ( buf_price-all.b-code = p-main-b-code or
     1607            buf_price-all.b-code = p-b-code))    and
     1608           ( p-only-b-code = true  or
     1609             buf_price-all.b-code = p-b-code)
     1610             and
     1611             buf_price-all.fact-order-sys-from  <= p-fact-order  and
     1612           ( buf_price-all.fact-order-sys-to = ? or
     1613             buf_price-all.fact-order-sys-to    >= p-fact-order)
     1614           :
     1615            v-interv   = "" .
     1616            v-grp-name = "" .
     1617            v-pay-name = "" .
     1618            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     1619            if buf_price-all.bgr-id > 0 then do:
     1620               find first buf_buyer-group no-lock where
     1621                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     1622                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     1623               if available buf_buyer-group then do:
     1624                  if p-cli-type <> "" and p-cli-type <> ? then do:
     1625                  find first buf_buyer-in-buyer-group no-lock where
     1626                             buf_buyer-in-buyer-group.stts         = 0 and
     1627                             buf_buyer-in-buyer-group.bgr-id       = buf_buyer-group.bgr-id     and
     1628                             buf_buyer-in-buyer-group.bgr-db-num   = buf_buyer-group.bgr-db-num  and
     1629                             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
     1630                             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code
     1631                             no-error .
     1632                             if not available buf_buyer-in-buyer-group then do:
     1633                                v-grp-name = "".
     1634                                next.
     1635                             end.
     1636                             v-grp-name = buf_buyer-group.name .
     1637                  end.
     1638               end.
     1639               else do:
     1640                    v-grp-name = "".
     1641                    next.
     1642               end.
     1643            end.
     1644            if buf_price-all.tog-id > 0 then do:
     1645               find first buf_turnover-group no-lock where
     1646                          buf_turnover-group.tog-id     = buf_price-all.tog-id      and
     1647                          buf_turnover-group.tog-db-num = buf_price-all.tog-db-num  no-error .
     1648               if available buf_turnover-group then do:
     1649                  if p-cli-type <> "" and p-cli-type <> ? then do:
     1650                     v-cli-oborot = v-cli-oborot-all  .
     1651                     find first buf1_tnv-in-turnover-group no-lock where
     1652                                buf1_tnv-in-turnover-group.stts       =  0     and
     1653                                buf1_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     1654                                buf1_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     1655                                buf1_tnv-in-turnover-group.ttg-summa  <=  v-cli-oborot no-error .
     1656                     find first buf2_tnv-in-turnover-group no-lock where
     1657                                buf2_tnv-in-turnover-group.stts       =  0     and
     1658                                buf2_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     1659                                buf2_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     1660                                buf2_tnv-in-turnover-group.ttg-summa  >=  v-cli-oborot no-error .
     1661                     if not (available buf1_tnv-in-turnover-group and
     1662                             available buf2_tnv-in-turnover-group ) then do:
     1663                             v-grp-name = "".
     1664                             next .
     1665                     end.
     1666                     v-grp-name = buf_turnover-group.name.
     1667                  end.
     1668               end.
     1669               else do:
     1670                    v-grp-name = "".
     1671                    next.
     1672               end.
     1673            end.
     1674            if buf_price-all.plt-fix-cource-crc-base = true then
     1675               assign
     1676                 v-base-rate  = buf_price-all.pdf-base-rate
     1677                 v-base-scale = buf_price-all.pdf-base-scale
     1678               .
     1679               else
     1680               assign
     1681                 v-base-rate  = v-base-rate0
     1682                 v-base-scale = v-base-scale0
     1683               .
     1684            if buf_price-all.plt-fix-cource-crc-doc = true then
     1685               assign
     1686                 v-exch-rate  = buf_price-all.pdf-exch-rate
     1687                 v-exch-scale = buf_price-all.pdf-exch-scale
     1688               .
     1689               else do:
     1690   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1691   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     1692     (input  buf_price-all.curr-code
     1693     ,input  to-day
     1694     ,output v-exch-rate0
     1695     ,output v-exch-scale0
     1696     ,output v-curr-abbr
     1697     )  .
     1698               assign
     1699                 v-exch-rate  = v-exch-rate0
     1700                 v-exch-scale = v-exch-scale0
     1701                 .
     1702              end.
     1703              v-date-1 = date ( "" )  .
     1704              if buf_price-all.fact-order-sys-from > 0 then do:
     1705                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     1706                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     1707                 if buf_price-all.start-date <> ?       then  v-date-1 = buf_price-all.start-date.
     1708              end.
     1709              v-date-2 =  date ( "" )  .
     1710              if buf_price-all.fact-order-sys-to > 0 then do:
     1711                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     1712                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     1713                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     1714              end.
     1715              if buf_price-all.qnty-from <> ? then do :
     1716                 if not (
     1717                 ( p-qnty-doc  >= buf_price-all.qnty-from and buf_price-all.qnty-to = ? ) or
     1718                 ( p-qnty-doc  >= buf_price-all.qnty-from and p-qnty-doc <= buf_price-all.qnty-to and buf_price-all.qnty-to <> ?)
     1719                 ) then do:
     1720                        v-interv = "".
     1721                        next.
     1722                 end.
     1723                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     1724              end.
     1725              if buf_price-all.sum-from <> ? then do :
     1726                 if not (
     1727                 ( p-sum-doc  >= buf_price-all.sum-from and buf_price-all.sum-to = ? ) or
     1728                 ( p-sum-doc  >= buf_price-all.sum-from and p-sum-doc <= buf_price-all.sum-to and buf_price-all.sum-to <> ?)
     1729                 ) then do:
     1730                    v-interv = "".
     1731                    next.
     1732                 end.
     1733                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     1734              end.
     1735              if buf_price-all.turnover-from <> ? then do :
     1736                 if not (
     1737                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and buf_price-all.turnover-to = ? ) or
     1738                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and v-cli-oborot-ALL <= buf_price-all.turnover-to and buf_price-all.turnover-to <> ?)
     1739                 ) then do:
     1740                    v-interv = "".
     1741                    next.
     1742                 end.
     1743                 v-interv = "O: " +  string(buf_price-all.turnover-from) + " - " + ( if buf_price-all.turnover-to = ? then "и более" else string(buf_price-all.turnover-to)) .
     1744              end.
     1745              if buf_price-all.use-pay-type = 1 then do :
     1746                 if buf_price-all.pay-code <> v-trn-pay-code then do:
     1747                    v-pay-name = "" .
     1748                    next.
     1749                  end.
     1750                  v-pay-name = 'Оплата':U +  ":" + string(buf_price-all.pay-code) .
     1751              end.
     1752              if buf_price-all.use-cash-pay = 1 then do :
     1753                 if v-cash-pay-code <> 0 and  not ( buf_price-all.curr-pay-code = v-cash-pay-curr and
     1754                                                    buf_price-all.cdpay-code    = v-cash-pay-code ) then do:
     1755                   v-pay-name = "" .
     1756                   next.
     1757                 end.
     1758                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     1759              end.
     1760             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     1761             create tt_price-all .
     1762             buffer-copy buf_price-all to tt_price-all
     1763             assign
     1764               tt_price-all.price-sale-rubl = buf_price-all.price-sale  * v-exch-rate / v-exch-scale
     1765               tt_price-all.road-tax-rubl   = buf_price-all.road-tax    * v-exch-rate / v-exch-scale
     1766               tt_price-all.excise-rubl     = buf_price-all.excise      * v-exch-rate / v-exch-scale
     1767               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     1768               tt_price-all.road-tax-base   = tt_price-all.road-tax-rubl    / v-base-rate * v-base-scale
     1769               tt_price-all.excise-base     = tt_price-all.excise-rubl      / v-base-rate * v-base-scale
     1770               tt_price-all.price-sale     = buf_price-all.price-sale
     1771               tt_price-all.road-tax       = buf_price-all.road-tax
     1772               tt_price-all.excise         = buf_price-all.excise
     1773               tt_price-all.pdf-exch-rate   = v-exch-rate
     1774               tt_price-all.pdf-exch-scale  = v-exch-scale
     1775               tt_price-all.pdf-base-rate   = v-base-rate
     1776               tt_price-all.pdf-base-scale  = v-base-scale
     1777               tt_price-all.grp-name        = v-grp-name
     1778               tt_price-all.date-1          = v-date-1
     1779               tt_price-all.shift-1         = buf_price-all.start-shift-num
     1780               tt_price-all.time-1          = buf_price-all.start-sys-time
     1781               tt_price-all.date-2          = v-date-2
     1782               tt_price-all.shift-2         = buf_price-all.end-shift-num
     1783               tt_price-all.time-2          = buf_price-all.end-sys-time
     1784               tt_price-all.interv-name     = v-interv
     1785               tt_price-all.pay-name        = v-pay-name
     1786               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     1787             .
     1788   end.
     1789   define variable vt-plt-id as integer   no-undo .
     1790   define variable vt-plt-db as integer   no-undo .
     1791   define variable vt-pdf-id as integer   no-undo .
     1792   define variable vt-pdf-db as integer   no-undo .
     1793   define buffer neos_price-all for tt_price-all  .
     1794   find first tt_price-all where tt_price-all.b-code = p-main-b-code use-index pi no-error .
     1795       if available tt_price-all then do:
     1796        assign
     1797          vt-plt-id = tt_price-all.plt-id
     1798          vt-plt-db = tt_price-all.plt-db-num
     1799          vt-pdf-id = tt_price-all.pdf-id
     1800          vt-pdf-db = tt_price-all.pdf-db
     1801        .
     1802        if tt_price-all.b-code = p-b-code then do:
     1803             assign
     1804               p-plt-id           = tt_price-all.plt-id
     1805               p-plt-db-num       = tt_price-all.plt-db-num
     1806               p-pdf-id           = tt_price-all.pdf-id
     1807               p-pdf-db-num       = tt_price-all.pdf-db
     1808               p-sale-price-base  = tt_price-all.price-sale-base
     1809               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     1810               p-road-tax-base    = tt_price-all.road-tax-base
     1811               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     1812               p-excise-base      = tt_price-all.excise-base
     1813               p-excise-rubl      = tt_price-all.excise-rubl
     1814               .
     1815        end.
     1816        else do:
     1817          find first neos_price-all where
     1818                     neos_price-all.b-code     = p-b-code  and
     1819                     neos_price-all.plt-id     = vt-plt-id and
     1820                     neos_price-all.plt-db-num = vt-plt-db and
     1821                     neos_price-all.pdf-id     = vt-pdf-id and
     1822                     neos_price-all.pdf-db     = vt-pdf-db
     1823                     use-index pi no-error .
     1824            if available neos_price-all then do:
     1825             assign
     1826               p-plt-id           = tt_price-all.plt-id
     1827               p-plt-db-num       = tt_price-all.plt-db-num
     1828               p-pdf-id           = tt_price-all.pdf-id
     1829               p-pdf-db-num       = tt_price-all.pdf-db
     1830               p-sale-price-base  = neos_price-all.price-sale-base
     1831               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     1832               p-road-tax-base    = neos_price-all.road-tax-base
     1833               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     1834               p-excise-base      = neos_price-all.excise-base
     1835               p-excise-rubl      = neos_price-all.excise-rubl
     1836               .
     1837            end.
     1838            else do:
     1839                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     1840                 if error-status :error    then do:
     1841                   message "Не найден бар-код" p-b-code view-as alert-box error .
     1842                   return error return-value .
     1843                 end.
     1844             assign
     1845               p-plt-id           = tt_price-all.plt-id
     1846               p-plt-db-num       = tt_price-all.plt-db-num
     1847               p-pdf-id           = tt_price-all.pdf-id
     1848               p-pdf-db-num       = tt_price-all.pdf-db
     1849               p-sale-price-base  = tt_price-all.price-sale-base
     1850               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     1851               p-road-tax-base    = tt_price-all.road-tax-base
     1852               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     1853               p-excise-base      = tt_price-all.excise-base
     1854               p-excise-rubl      = tt_price-all.excise-rubl * buf_bar-code.cli-base-rate
     1855               .
     1856            end.
     1857        end.
     1858     end.
     1859   end.
     1860   end procedure.
     1861   procedure mpl-tpl-auto :
     1862   define input  parameter p-b-code     as integer   no-undo .
     1863   define input  parameter p-obj-type   as character no-undo .
     1864   define input  parameter p-obj-code   as integer   no-undo .
     1865   define input  parameter p-plt-id     as integer   no-undo .
     1866   define input  parameter p-plt-db-num as integer   no-undo .
     1867   define input  parameter p-fact-order as decimal   no-undo .
     1868   define output parameter p-sale-price as decimal   no-undo .
     1869   define output parameter p-pdf-id     as integer   no-undo .
     1870   define output parameter p-pdf-db-num as integer   no-undo .
     1871     do
     1872     on error undo, return error return-value
     1873     :
     1874   if p-fact-order = ? then do:
     1875     run fact-order-mpl (
     1876         input   today       ,
     1877         input   p-obj-type  ,
     1878         input   p-obj-code  ,
     1879         output  p-fact-order ) .
     1880   end.
     1881   assign
     1882     p-pdf-id      = ?
     1883     p-pdf-db-num  = ?
     1884     p-sale-price  = ?
     1885   .
     1886   define buffer buf_bar-code for ub.bar-code  .
     1887   define buffer buf_goods for ub.goods  .
     1888   find first buf_bar-code no-lock where
     1889              buf_bar-code.b-code = p-b-code
     1890              no-error .
     1891   if error-status :error then return error return-value .
     1892   find first buf_goods no-lock where
     1893              buf_goods.gds-code = buf_bar-code.gds-code
     1894              no-error .
     1895   if error-status :error then return error return-value .
     1896   define variable v-main-b-code as integer   no-undo .
     1897   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1898     (input  buf_goods.gds-code
     1899     ,input  ?
     1900     ,output v-main-b-code
     1901     )  .
     1902   define buffer buf_price-all for ub.price-all  .
     1903   for each tt_price-all : delete tt_price-all. end.
     1904       for each buf_price-all no-lock where
     1905               buf_price-all.plt-id     = p-plt-id                 and
     1906               buf_price-all.plt-db-num = p-plt-db-num             and
     1907               buf_price-all.obj-type   = p-obj-type               and
     1908               buf_price-all.obj-code   = p-obj-code               and
     1909               buf_price-all.gds-code   = buf_goods.gds-code       and
     1910             ( buf_price-all.b-code = v-main-b-code or
     1911               buf_price-all.b-code = p-b-code)    and
     1912               buf_price-all.status_    = 'акт':U         and
     1913               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     1914             ( buf_price-all.fact-order-sys-to = ? or
     1915               buf_price-all.fact-order-sys-to >=  p-fact-order)
     1916               :
     1917                 create tt_price-all .
     1918                 buffer-copy buf_price-all to tt_price-all
     1919                 assign
     1920                   tt_price-all.price-sale  = buf_price-all.price-sale
     1921                 .
     1922       end.
     1923   define variable vt-plt-id as integer   no-undo .
     1924   define variable vt-plt-db as integer   no-undo .
     1925   define variable vt-pdf-id as integer   no-undo .
     1926   define variable vt-pdf-db as integer   no-undo .
     1927   define buffer neos_price-all for tt_price-all  .
     1928   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     1929       if available tt_price-all then do:
     1930        assign
     1931          vt-plt-id = tt_price-all.plt-id
     1932          vt-plt-db = tt_price-all.plt-db-num
     1933          vt-pdf-id = tt_price-all.pdf-id
     1934          vt-pdf-db = tt_price-all.pdf-db
     1935        .
     1936        if tt_price-all.b-code = p-b-code then do:
     1937             assign
     1938               p-plt-id           = tt_price-all.plt-id
     1939               p-plt-db-num       = tt_price-all.plt-db-num
     1940               p-pdf-id           = tt_price-all.pdf-id
     1941               p-pdf-db-num       = tt_price-all.pdf-db
     1942               p-sale-price       = tt_price-all.price-sale
     1943               .
     1944        end.
     1945        else do:
     1946          find first neos_price-all where
     1947                     neos_price-all.b-code     = p-b-code  and
     1948                     neos_price-all.plt-id     = vt-plt-id and
     1949                     neos_price-all.plt-db-num = vt-plt-db and
     1950                     neos_price-all.pdf-id     = vt-pdf-id and
     1951                     neos_price-all.pdf-db     = vt-pdf-db
     1952                     use-index pi no-error .
     1953            if available neos_price-all then do:
     1954             assign
     1955               p-plt-id           = tt_price-all.plt-id
     1956               p-plt-db-num       = tt_price-all.plt-db-num
     1957               p-pdf-id           = tt_price-all.pdf-id
     1958               p-pdf-db-num       = tt_price-all.pdf-db
     1959               p-sale-price       = neos_price-all.price-sale
     1960               .
     1961            end.
     1962            else do:
     1963           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     1964           if error-status :error    then do:
     1965              message "Не найден бар-код" p-b-code view-as alert-box error .
     1966              return error return-value .
     1967           end.
     1968             assign
     1969               p-plt-id           = tt_price-all.plt-id
     1970               p-plt-db-num       = tt_price-all.plt-db-num
     1971               p-pdf-id           = tt_price-all.pdf-id
     1972               p-pdf-db-num       = tt_price-all.pdf-db
     1973               p-sale-price       = tt_price-all.price-sale * buf_bar-code.cli-base-rate
     1974               .
     1975            end.
     1976        end.
     1977     end.
     1978     end.
     1979   end procedure.
     1980   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1981   procedure printbuffer private:
     1982   define input parameter p-bh as handle no-undo .
     1983   define variable v-ii as integer no-undo .
     1984   if search("printbuffer.fld") <> ? then do:
     1985     output to value( substitute("&1.txt", p-bh:name)) append.
     1986     put unformatted today chr(32) string(time, "HH:MM:SS")
     1987     this-procedure :name skip
     1988     skip.
     1989     do v-ii = 1 to p-bh:num-fields:
     1990       if p-bh:buffer-field(v-ii):data-type = 'rowid':U then do:
     1991         put unformatted fill( chr(32), 10) p-bh:buffer-field(v-ii):name string(p-bh:buffer-field(v-ii):buffer-value) at 35 skip.
     1992       end.
     1993       else do:
     1994         put unformatted fill( chr(32), 10) p-bh:buffer-field(v-ii):name p-bh:buffer-field(v-ii):buffer-value at 35 skip.
     1995       end.
     1996     end.
     1997   end.
     1998   output close.
     1999   end procedure.
