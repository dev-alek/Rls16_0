      513   procedure thbjattr_value :
      514   define input  parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
      515   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
      516   define input  parameter p-upper-code like ub.thbj-attr.upper-prop-code  no-undo .
      517   define input  parameter p-code     like ub.thbj-attr.prop-code  no-undo .
      518   define output parameter p-value-character like ub.thbj-attr.property-value-character no-undo .
      519   define output parameter p-value-date    like ub.thbj-attr.property-value-date no-undo .
      520   define output parameter p-value-decimal like ub.thbj-attr.property-value-decimal no-undo .
      521   define output parameter p-value-integer like ub.thbj-attr.property-value-integer no-undo .
      522   define output parameter p-value-logical like ub.thbj-attr.property-value-logical no-undo .
      523   define output parameter p-type     as character no-undo .
      524   define output parameter p-found as decimal no-undo .
