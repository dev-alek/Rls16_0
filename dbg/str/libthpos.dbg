     9563       end.
     9564       assign
     9565       v-chk-type = (if lookup(string(libthpos_chk-context.chk-type), '201,206,208,301,306':U) > 0
     9566                     then integer('208':U)
     9567                     else integer('8':U)
     9568                     )
     9569       libthpos_chk-context.prev-chk-type = libthpos_chk-context.chk-type
     9570       locked_chk-doc.prev-chk-type = locked_chk-doc.chk-type
     9571       libthpos_chk-context.chk-type = v-chk-type
     9572       locked_chk-doc.chk-type = v-chk-type
     9573       locked_chk-doc.chk-num  = p-chk-num
     9574       v-doc-code = locked_chk-doc.doc-code
     9575       .
     9576       run libthpos_getcheck in this-procedure ( input p-doc-code
     9577                                                 , input yes
     9578                                                 ) no-error.
     9579       if error-status:error then do:
     9580         v-err-mess = substitute("&1&2&3"
     9581                                                 , error-status:get-message(1)
     9582                                                 , chr(10)
     9583                                                 , return-value ).
     9584         undo main-block, retry main-block.
     9585       end.
     9586       dataset libthpos_receipt:accept-changes.
     9587       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-context:table-handle)
     9588                                                       , input no).
     9589       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-pay:table-handle)
     9590                                                       , input no).
     9591       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-gds:table-handle)
     9592                                                       , input no).
     9593       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-discnt:table-handle)
     9594                                                       , input no).
     9595       session:set-wait-state("").
     9596     end.
     9597   end.
     9598   run libthpos_process-sale in this-procedure ( input v-chk-type
     9599                                                ,input v-doc-code) no-error.
     9600   end procedure.
     9601   procedure libthpos_delete-chk-doc :
     9602   define input  parameter p-doc-code as character no-undo .
     9603   define variable v-chk-type as integer no-undo .
     9604   define variable v-err-mess as character no-undo .
     9605   define buffer buf_chk-doc for ub.chk-doc.
     9606   main-block:
     9607   do
     9608   on error undo main-block, retry main-block
     9609   on stop undo main-block, retry main-block
     9610   on endkey undo main-block, retry main-block
     9611   :
     9612     if retry then do:
     9613       session:set-wait-state("").
     9614       if v-err-mess = '' then do:
     9615         v-err-mess = substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     9616       end.
     9617       dataset libthpos_receipt:reject-changes.
     9618       return error v-err-mess.
     9619     end.
     9620     else do:
     9621       session:set-wait-state("GENERAL").
     9622       if not available libthpos_chk-context then do:
     9623         find first libthpos_chk-context no-error.
     9624       end.
     9625       if not available libthpos_chk-context then do:
     9626         v-err-mess = substitute("Не выставлен контекст чека").
     9627         undo main-block, retry main-block.
     9628       end.
     9629       if lookup(string(libthpos_chk-context.chk-type), '2,3,4,5,7':U) > 0 then do:
     9630         v-err-mess = substitute("Нельзя удалить чек МЦ").
     9631         undo main-block, retry main-block.
     9632       end.
     9633       if lookup(string(libthpos_chk-context.chk-type), '201,206,208,301,306':U) > 0 then do:
     9634         v-err-mess = substitute("Нельзя удалить чек с типом &1", libthpos_chk-context.chk-type).
     9635         undo main-block, retry main-block.
     9636       end.
     9637       find first buf_chk-doc where
     9638                 buf_chk-doc.doc-code = p-doc-code.
     9639       delete buf_chk-doc no-error.
     9640       if error-status:error then do:
     9641         release buf_chk-doc.
     9642       end.
     9643       if not available libthpos_chk-context then do:
     9644         find first libthpos_chk-context.
     9645         if available libthpos_chk-context then do:
     9646           run libthpos_print-dataset in this-procedure ( input no).
     9647           delete libthpos_chk-context.
     9648         end.
     9649       end.
     9650       dataset libthpos_receipt:accept-changes.
     9651       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-context:table-handle)
     9652                                                       , input no).
     9653       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-pay:table-handle)
     9654                                                       , input no).
     9655       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-gds:table-handle)
     9656                                                       , input no).
     9657       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-discnt:table-handle)
     9658                                                       , input no).
     9659       session:set-wait-state("").
     9660     end.
     9661   end.
     9662   end procedure.
     9663   procedure libthpos_postpone :
     9664   define input  parameter p-doc-code as character no-undo .
     9665   define variable v-chk-type as integer no-undo .
     9666   define variable v-err-mess as character no-undo .
     9667   main-block:
     9668   do
     9669   on error undo main-block, retry main-block
     9670   on stop undo main-block, retry main-block
     9671   on endkey undo main-block, retry main-block
     9672   :
     9673     if retry then do:
     9674       session:set-wait-state("").
     9675       if v-err-mess = '' then do:
     9676         v-err-mess = substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     9677       end.
     9678       dataset libthpos_receipt:reject-changes.
     9679       return error v-err-mess.
     9680     end.
     9681     else do:
     9682       session:set-wait-state("GENERAL").
     9683       if not available libthpos_chk-context then do:
     9684         find first libthpos_chk-context no-error.
     9685       end.
     9686       if not available libthpos_chk-context then do:
     9687         v-err-mess = substitute("Не выставлен контекст чека").
     9688         undo main-block, retry main-block.
     9689       end.
     9690       if not (libthpos_chk-context.chk-type = integer('1':U)
     9691               or
     9692               libthpos_chk-context.chk-type = integer('6':U)) then do:
     9693         v-err-mess = substitute("Нельзя отложить чеки с типом &1", libthpos_chk-context.chk-type ).
     9694         undo main-block, retry main-block.
     9695       end.
     9696       assign
     9697       v-chk-type = (if libthpos_chk-context.chk-type = integer('1':U)
     9698                     then integer('201':U)
     9699                     else integer('206':U)
     9700                     )
     9701       libthpos_chk-context.chk-type = v-chk-type
     9702       locked_chk-doc.chk-type = v-chk-type
     9703       .
     9704       if not can-find(first libthpos_chk-gds where
     9705                             libthpos_chk-gds.doc-code = libthpos_chk-context.doc-code)
     9706       then do:
     9707         v-err-mess = substitute("Нельзя отложить чек &1 - в чеке нет ни одной строки"
     9708                                , p-doc-code).
     9709         undo main-block, retry main-block.
     9710       end.
     9711       run libthpos_getcheck in this-procedure ( input p-doc-code
     9712                                               , input yes
     9713                                               ) no-error.
     9714       if error-status:error then do:
     9715         v-err-mess = substitute("&1&2&3"
     9716                                                 , error-status:get-message(1)
     9717                                                 , chr(10)
     9718                                                 , return-value ).
     9719         undo main-block, retry main-block.
     9720       end.
     9721       dataset libthpos_receipt:accept-changes.
     9722       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-context:table-handle)
     9723                                                       , input no).
     9724       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-pay:table-handle)
     9725                                                       , input no).
     9726       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-gds:table-handle)
     9727                                                       , input no).
     9728       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-discnt:table-handle)
     9729                                                       , input no).
     9730       session:set-wait-state("").
     9731     end.
     9732   end.
     9733   end procedure.
     9734   procedure libthpos_close-postpone :
     9735   define input parameter p-doc-code as character no-undo .
     9736   define input parameter p-postpone-doc-code as character no-undo .
     9737   define input parameter p-close-mode as integer no-undo .
     9738   define variable v-err-mess as character no-undo .
     9739   define variable v-chk-type as integer no-undo .
     9740   define variable v-doc-code as character no-undo .
     9741   define buffer buf_chk-doc for ub.chk-doc.
     9742   define buffer bufp_chk-doc for ub.chk-doc.
     9743   main-block:
     9744   do
     9745   on error undo main-block, retry main-block
     9746   on stop undo main-block, retry main-block
     9747   on endkey undo main-block, retry main-block
     9748   :
     9749     if retry then do:
     9750       session:set-wait-state("").
     9751       if v-err-mess = '' then do:
     9752         v-err-mess = substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     9753       end.
     9754       dataset libthpos_receipt:reject-changes.
     9755       return error v-err-mess.
     9756     end.
     9757     else do:
     9758       session:set-wait-state("GENERAL").
     9759       find first bufp_chk-doc exclusive-lock where
     9760               bufp_chk-doc.doc-code = p-postpone-doc-code no-error no-wait.
     9761       if not available bufp_chk-doc
     9762       and not locked(bufp_chk-doc)
     9763       then do:
     9764         v-err-mess = substitute("Не найден чек &1", p-postpone-doc-code).
     9765         undo main-block, retry main-block.
     9766       end.
     9767       if locked(bufp_chk-doc) then do:
     9768         v-err-mess = substitute("Занят чек &1", p-postpone-doc-code).
     9769         undo main-block, retry main-block.
     9770       end.
     9771       if lookup(string(bufp_chk-doc.chk-type), '201,206,208,301,306':U) = 0 then do:
     9772         v-err-mess = substitute("Чек &1 не является отложенным чеком, операция неприменима", p-postpone-doc-code).
     9773         undo main-block, retry main-block.
     9774       end.
     9775       if bufp_chk-doc.chk-type = integer('208':U) then do:
     9776         v-err-mess = substitute("Чек &1 аннулирован, операция неприменима", p-postpone-doc-code).
     9777         undo main-block, retry main-block.
     9778       end.
     9779       v-chk-type = bufp_chk-doc.chk-type.
     9780       v-doc-code = bufp_chk-doc.doc-code.
     9781       case p-close-mode:
     9782         when 1 then do:
     9783           assign
     9784           bufp_chk-doc.chk-type = bufp_chk-doc.chk-type + 100
     9785           bufp_chk-doc.tot-doc = 0
     9786           bufp_chk-doc.netto = 0
     9787           bufp_chk-doc.discnt = 0
     9788           bufp_chk-doc.sub-discnt = 0
     9789           bufp_chk-doc.doc-qnty = 0
     9790           bufp_chk-doc.ps = substitute(">>&1", p-doc-code)
     9791           .
     9792         end.
     9793         when 0 then do:
     9794           assign
     9795           bufp_chk-doc.chk-type = integer('208':U)
     9796           bufp_chk-doc.tot-doc = 0
     9797           bufp_chk-doc.netto = 0
     9798           bufp_chk-doc.discnt = 0
     9799           bufp_chk-doc.sub-discnt = 0
     9800           bufp_chk-doc.doc-qnty = 0
     9801           .
     9802         end.
     9803       end case.
     9804       dataset libthpos_receipt:accept-changes.
     9805       run libthpos_print-dataset in this-procedure ( input no).
     9806       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-context:table-handle)
     9807                                                       , input no).
     9808       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-pay:table-handle)
     9809                                                       , input no).
     9810       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-gds:table-handle)
     9811                                                       , input no).
     9812       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-discnt:table-handle)
     9813                                                       , input no).
     9814       session:set-wait-state("").
     9815     end.
     9816   end.
     9817   run libthpos_process-sale in this-procedure ( input v-chk-type
     9818                                                ,input v-doc-code) no-error.
     9819   end procedure.
     9820   procedure libthpos_annu-lost-check :
     9821   define input parameter p-doc-code as character no-undo .
     9822   define variable v-lng as integer no-undo .
     9823   define variable v-discnt-id as integer no-undo .
     9824   define variable v-doc-code as character no-undo .
     9825   define variable v-err-mess as character no-undo .
     9826   define buffer buf_chk-doc for ub.chk-doc.
     9827   define buffer buf_chk-gds for ub.chk-gds.
     9828   define buffer buf_chk-discnt for ub.chk-discnt.
     9829   main-block:
     9830   do
     9831   on error undo main-block, retry main-block
     9832   on stop undo main-block, retry main-block
     9833   on endkey undo main-block, retry main-block
     9834   :
     9835     if retry then do:
     9836       session:set-wait-state("").
     9837       if v-err-mess = '' then do:
     9838         v-err-mess = substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     9839       end.
     9840       dataset libthpos_receipt:reject-changes.
     9841       return error v-err-mess.
     9842     end.
     9843     else do:
     9844       session:set-wait-state("GENERAL").
     9845       if not available libthpos_chk-context then do:
     9846         find first libthpos_chk-context no-error.
     9847       end.
     9848       if available libthpos_chk-context
     9849       and libthpos_chk-context.doc-code = p-doc-code
     9850       then do:
     9851         v-err-mess = substitute("В данный момент Вы работаете с чеком &1, операция аннуляции сбойного чека неприменима").
     9852         undo main-block, retry main-block.
     9853       end.
     9854       find first buf_chk-doc exclusive-lock where
     9855               buf_chk-doc.doc-code = p-doc-code no-error no-wait.
     9856       if not available buf_chk-doc
     9857       and not locked(buf_chk-doc)
     9858       then do:
     9859         v-err-mess = substitute("Не найден чек &1", p-doc-code).
     9860         undo main-block, retry main-block.
     9861       end.
     9862       if locked(buf_chk-doc) then do:
     9863         v-err-mess = substitute("Занят чек &1", p-doc-code).
     9864         undo main-block, retry main-block.
     9865       end.
     9866       if buf_chk-doc.chk-type = integer('208':U)
     9867       or buf_chk-doc.chk-type = integer('8':U)
     9868       then do:
     9869         v-err-mess = substitute("Чек &1 уже аннулирован, операция неприменима", p-doc-code).
     9870         undo main-block, retry main-block.
     9871       end.
     9872       if trim(replace(replace(buf_chk-doc.office, 'у':U, ''), 'т':U, ''), chr(44)) = ''
     9873       and buf_chk-doc.correct = yes then do:
     9874         v-err-mess = substitute("Чек &1 уже прошел валидацию, операция неприменима", p-doc-code).
     9875         undo main-block, retry main-block.
     9876       end.
     9877       find last buf_chk-gds no-lock where
     9878               buf_chk-gds.doc-code = buf_chk-doc.doc-code no-error.
     9879       find last buf_chk-discnt no-lock where
     9880               buf_chk-discnt.doc-code = buf_chk-doc.doc-code
     9881           and buf_chk-discnt.record-type = 0  no-error.
     9882       assign
     9883       v-lng = (if available buf_chk-gds
     9884               then buf_chk-gds.line-num
     9885               else 0)
     9886       v-discnt-id = (if available buf_chk-discnt
     9887                     then buf_chk-discnt.discnt-id
     9888                     else 0)
     9889       .
     9890       if lookup(string(buf_chk-doc.chk-type), '201,206,208,301,306':U) > 0 then do:
     9891         assign
     9892         buf_chk-doc.chk-type = integer('208':U)
     9893         .
     9894       end.
     9895       else do:
     9896         assign
     9897         buf_chk-doc.chk-type = integer('8':U)
     9898         .
     9899       end.
     9900       v-doc-code = buf_chk-doc.doc-code.
     9901   define variable vss-include-info60 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9902   if (valid-handle(g#libchkvl) <> true) then do:   run str/libchkvl.p persistent no-error .   if error-status :error or (valid-handle(g#libchkvl) <> true) then do:     message       "Error starting nws/libchkvl.p" skip       g#libchkvl skip       g#libchkvl :type skip       g#libchkvl :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libchkvl_getcheck in g#libchkvl
     9903     (input  buffer libthpos_context:handle
     9904     ,input  'ИЗМЕНЕНИЕ':U
     9905     ,input  'ИЗМЕНЕНИЕ':U
     9906     ,input  yes
     9907     ,input  yes
     9908     ,input  0
     9909     ,input  v-lng
     9910     ,input  0
     9911     ,input  v-discnt-id
     9912     ,input-output v-doc-code
     9913       ) no-error .
     9914       if error-status:error then do:
     9915         v-err-mess = substitute("Ошибка при валидации чека &1&2&3&2&4"
     9916                                                 , p-doc-code
     9917                                                 , chr(10)
     9918                                                 , error-status:get-message(1)
     9919                                                 , return-value ).
     9920         undo main-block, retry main-block.
     9921       end.
     9922       dataset libthpos_receipt:accept-changes.
     9923       run libthpos_print-dataset in this-procedure ( input no).
     9924       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-context:table-handle)
     9925                                                       , input no).
     9926       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-pay:table-handle)
     9927                                                       , input no).
     9928       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-gds:table-handle)
     9929                                                       , input no).
     9930       run libthpos_tracking-changes in this-procedure ( input (buffer libthpos_chk-discnt:table-handle)
     9931                                                       , input no).
     9932       session:set-wait-state("").
     9933     end.
     9934   end.
     9935   end procedure.
     9936   procedure libthpos_write-cash-counter private:
     9937   define buffer buf_libthpos_cash-counter for libthpos_cash-counter.
     9938   define buffer buf_inkas-pay-wth for ub.inkas-pay-wth.
     9939   define variable v-err-mess as character no-undo .
     9940   define variable v-all-counter-base as decimal no-undo .
     9941   define variable v-all-counter-rubl as decimal no-undo .
     9942   main-block:
     9943   do
     9944   on error undo main-block, retry main-block
     9945   on stop undo main-block, retry main-block
     9946   on endkey undo main-block, retry main-block
     9947   :
     9948     if retry then do:
     9949       if v-err-mess = '' then do:
     9950         v-err-mess = substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     9951       end.
     9952       dataset libthpos_receipt:reject-changes.
     9953       return error v-err-mess.
     9954     end.
     9955     else do:
     9956       if not available libthpos_chk-context then do:
     9957         find first libthpos_chk-context no-error.
     9958       end.
     9959       if not available libthpos_chk-context then do:
     9960         v-err-mess = substitute("Не выставлен контекст чека").
     9961         undo main-block, retry main-block.
     9962       end.
     9963       for each buf_libthpos_cash-counter
     9964       on error  undo main-block, retry main-block
     9965       on stop   undo main-block, retry main-block
     9966       on endkey undo main-block, retry main-block
     9967       :
     9968         if lookup(string(libthpos_chk-context.chk-type), '8,108,208':U) > 0 then do:
     9969           assign
     9970           buf_libthpos_cash-counter.pre-tot-sum = 0
     9971           buf_libthpos_cash-counter.pre-tot-rubl = 0
     9972           buf_libthpos_cash-counter.pre-tot-base = 0
     9973           buf_libthpos_cash-counter.pre-tot-lines = 0
     9974           buf_libthpos_cash-counter.pre-doc-qnty = 0
     9975           .
     9976         end.
     9977         else do:
     9978           assign
     9979           buf_libthpos_cash-counter.tot-sum = buf_libthpos_cash-counter.tot-sum + buf_libthpos_cash-counter.pre-tot-sum
     9980           buf_libthpos_cash-counter.pre-tot-sum = 0
     9981           buf_libthpos_cash-counter.tot-rubl = buf_libthpos_cash-counter.tot-rubl + buf_libthpos_cash-counter.pre-tot-rubl
     9982           buf_libthpos_cash-counter.pre-tot-rubl = 0
     9983           buf_libthpos_cash-counter.tot-base = buf_libthpos_cash-counter.tot-base + buf_libthpos_cash-counter.pre-tot-base
     9984           buf_libthpos_cash-counter.pre-tot-base = 0
     9985           buf_libthpos_cash-counter.tot-lines = buf_libthpos_cash-counter.tot-lines + buf_libthpos_cash-counter.pre-tot-lines
     9986           buf_libthpos_cash-counter.pre-tot-lines = 0
     9987           buf_libthpos_cash-counter.doc-qnty = buf_libthpos_cash-counter.doc-qnty + buf_libthpos_cash-counter.pre-doc-qnty
     9988           buf_libthpos_cash-counter.pre-doc-qnty = 0
     9989           .
     9990         end.
     9991         find first buf_inkas-pay-wth where
     9992                   buf_inkas-pay-wth.inkas-code = ''
     9993               and buf_inkas-pay-wth.obj-type = libthpos_context.obj-type
     9994               and buf_inkas-pay-wth.obj-code = libthpos_context.obj-code
     9995               and buf_inkas-pay-wth.pay-desk = libthpos_context.cash-num
     9996               and buf_inkas-pay-wth.pay-code = buf_libthpos_cash-counter.pay-code
     9997               and buf_inkas-pay-wth.curr-code = buf_libthpos_cash-counter.curr-code
     9998               and buf_inkas-pay-wth.wth-code = buf_libthpos_cash-counter.wth-code
     9999               and buf_inkas-pay-wth.par-code = buf_libthpos_cash-counter.par-code
    10000               and buf_inkas-pay-wth.cashier = 0
    10001               and buf_inkas-pay-wth.chk-type = 0
    10002               no-error.
    10003         if not available buf_inkas-pay-wth then do:
    10004           create buf_inkas-pay-wth.
    10005           assign
    10006           buf_inkas-pay-wth.inkas-code = ''
    10007           buf_inkas-pay-wth.obj-type = libthpos_context.obj-type
    10008           buf_inkas-pay-wth.obj-code = libthpos_context.obj-code
    10009           buf_inkas-pay-wth.pay-desk = libthpos_context.cash-num
    10010           buf_inkas-pay-wth.pay-code = buf_libthpos_cash-counter.pay-code
    10011           buf_inkas-pay-wth.curr-code = buf_libthpos_cash-counter.curr-code
    10012           buf_inkas-pay-wth.wth-code = buf_libthpos_cash-counter.wth-code
    10013           buf_inkas-pay-wth.par-code = buf_libthpos_cash-counter.par-code
    10014           buf_inkas-pay-wth.par-val = buf_libthpos_cash-counter.par-val
    10015           buf_inkas-pay-wth.cashier = 0
    10016           buf_inkas-pay-wth.chk-type = 0
    10017           buf_inkas-pay-wth.doc-qnty = 0
    10018           .
    10019         end.
    10020         assign
    10021         buf_inkas-pay-wth.tot-sum = buf_libthpos_cash-counter.tot-sum
    10022         buf_inkas-pay-wth.tot-base = buf_libthpos_cash-counter.tot-base
    10023         buf_inkas-pay-wth.tot-rubl = buf_libthpos_cash-counter.tot-rubl
    10024         buf_inkas-pay-wth.tot-lines = buf_libthpos_cash-counter.tot-lines
    10025         buf_inkas-pay-wth.doc-qnty = buf_libthpos_cash-counter.doc-qnty
    10026         v-all-counter-base = v-all-counter-base + buf_inkas-pay-wth.tot-base
    10027         v-all-counter-rubl = v-all-counter-rubl + buf_inkas-pay-wth.tot-rubl
    10028         .
    10029       end .
    10030       assign
    10031       libthpos_context.cash-counter = libthpos_context.cash-counter + libthpos_context.pre-cash-counter
    10032       libthpos_context.pre-cash-counter = 0
    10033       .
    10034       find first buf_inkas-pay-wth where
    10035                 buf_inkas-pay-wth.inkas-code = ''
    10036             and buf_inkas-pay-wth.obj-type = libthpos_context.obj-type
    10037             and buf_inkas-pay-wth.obj-code = libthpos_context.obj-code
    10038             and buf_inkas-pay-wth.pay-desk = libthpos_context.cash-num
    10039             and buf_inkas-pay-wth.pay-code = 0
    10040             and buf_inkas-pay-wth.curr-code = 0
    10041             and buf_inkas-pay-wth.wth-code = 0
    10042             and buf_inkas-pay-wth.par-code = 0
    10043             and buf_inkas-pay-wth.cashier = 0
    10044             and buf_inkas-pay-wth.chk-type = 0
    10045             no-error.
    10046       if not available buf_inkas-pay-wth then do:
    10047         create buf_inkas-pay-wth.
    10048         assign
    10049         buf_inkas-pay-wth.inkas-code = ''
    10050         buf_inkas-pay-wth.obj-type = libthpos_context.obj-type
    10051         buf_inkas-pay-wth.obj-code = libthpos_context.obj-code
    10052         buf_inkas-pay-wth.pay-desk = libthpos_context.cash-num
    10053         buf_inkas-pay-wth.pay-code = 0
    10054         buf_inkas-pay-wth.curr-code = 0
    10055         buf_inkas-pay-wth.wth-code = 0
    10056         buf_inkas-pay-wth.par-code = 0
    10057         buf_inkas-pay-wth.par-val = 0
    10058         buf_inkas-pay-wth.cashier = 0
    10059         buf_inkas-pay-wth.chk-type = 0
    10060         .
    10061       end.
    10062       assign
    10063       buf_inkas-pay-wth.tot-rubl = v-all-counter-rubl
    10064       buf_inkas-pay-wth.tot-base = v-all-counter-base
    10065       .
    10066       dataset libthpos_receipt:accept-changes.
    10067     end.
    10068   end.
    10069   end procedure.
    10070   procedure libthpos_clear-cash-counter:
    10071   define buffer buf_libthpos_cash-counter for libthpos_cash-counter.
    10072   define buffer buf_inkas-pay-wth for ub.inkas-pay-wth.
    10073   define variable v-all-counter-base as decimal no-undo .
    10074   define variable v-all-counter-rubl as decimal no-undo .
    10075   define variable v-err-mess as character no-undo .
    10076   main-block:
    10077   do
    10078   on error undo main-block, retry main-block
    10079   on stop undo main-block, retry main-block
    10080   on endkey undo main-block, retry main-block
    10081   :
    10082     if retry then do:
    10083       if v-err-mess = '' then do:
    10084         v-err-mess = substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
    10085       end.
    10086       dataset libthpos_receipt:reject-changes.
    10087       return error v-err-mess.
    10088     end.
    10089     else do:
    10090       if not available libthpos_chk-context then do:
    10091         find first libthpos_chk-context no-error.
    10092       end.
    10093       if available libthpos_chk-context then do:
    10094         v-err-mess = substitute("Выставлен контекст чека - операция обнуления невозможна").
    10095         undo main-block, retry main-block.
    10096       end.
    10097       for each buf_libthpos_cash-counter
    10098       on error  undo main-block, retry main-block
    10099       on stop   undo main-block, retry main-block
    10100       on endkey undo main-block, retry main-block
    10101       :
    10102         if buf_libthpos_cash-counter.is-cash then
    10103         assign
    10104         buf_libthpos_cash-counter.tot-sum = 0
    10105         buf_libthpos_cash-counter.pre-tot-sum = 0
    10106         buf_libthpos_cash-counter.tot-rubl = 0
    10107         buf_libthpos_cash-counter.pre-tot-rubl = 0
    10108         buf_libthpos_cash-counter.tot-base = 0
    10109         buf_libthpos_cash-counter.pre-tot-base = 0
    10110         buf_libthpos_cash-counter.tot-lines = 0
    10111         buf_libthpos_cash-counter.pre-tot-lines = 0
    10112         buf_libthpos_cash-counter.doc-qnty = 0
    10113         buf_libthpos_cash-counter.pre-doc-qnty = 0
    10114         .
    10115         find first buf_inkas-pay-wth where
    10116                   buf_inkas-pay-wth.inkas-code = ''
    10117               and buf_inkas-pay-wth.obj-type = libthpos_context.obj-type
    10118               and buf_inkas-pay-wth.obj-code = libthpos_context.obj-code
    10119               and buf_inkas-pay-wth.pay-desk = libthpos_context.cash-num
    10120               and buf_inkas-pay-wth.pay-code = buf_libthpos_cash-counter.pay-code
    10121               and buf_inkas-pay-wth.curr-code = buf_libthpos_cash-counter.curr-code
    10122               and buf_inkas-pay-wth.wth-code = buf_libthpos_cash-counter.wth-code
    10123               and buf_inkas-pay-wth.par-code = buf_libthpos_cash-counter.par-code
    10124               and buf_inkas-pay-wth.cashier = 0
    10125               and buf_inkas-pay-wth.chk-type = 0
    10126               no-error.
    10127         if not available buf_inkas-pay-wth then do:
    10128           create buf_inkas-pay-wth.
    10129           assign
    10130           buf_inkas-pay-wth.inkas-code = ''
    10131           buf_inkas-pay-wth.obj-type = libthpos_context.obj-type
    10132           buf_inkas-pay-wth.obj-code = libthpos_context.obj-code
    10133           buf_inkas-pay-wth.pay-desk = libthpos_context.cash-num
    10134           buf_inkas-pay-wth.pay-code = buf_libthpos_cash-counter.pay-code
    10135           buf_inkas-pay-wth.curr-code = buf_libthpos_cash-counter.curr-code
    10136           buf_inkas-pay-wth.wth-code = buf_libthpos_cash-counter.wth-code
    10137           buf_inkas-pay-wth.par-code = buf_libthpos_cash-counter.par-code
    10138           buf_inkas-pay-wth.par-val = buf_libthpos_cash-counter.par-val
    10139           buf_inkas-pay-wth.cashier = 0
    10140           buf_inkas-pay-wth.chk-type = 0
    10141           buf_inkas-pay-wth.doc-qnty = 0
    10142           .
    10143         end.
    10144         assign
    10145         buf_inkas-pay-wth.tot-sum = buf_libthpos_cash-counter.tot-sum
    10146         buf_inkas-pay-wth.tot-base = buf_libthpos_cash-counter.tot-base
    10147         buf_inkas-pay-wth.tot-rubl = buf_libthpos_cash-counter.tot-rubl
    10148         buf_inkas-pay-wth.tot-lines = buf_libthpos_cash-counter.tot-lines
    10149         buf_inkas-pay-wth.doc-qnty = buf_libthpos_cash-counter.doc-qnty
    10150         v-all-counter-base = v-all-counter-base + buf_inkas-pay-wth.tot-base
    10151         v-all-counter-rubl = v-all-counter-rubl + buf_inkas-pay-wth.tot-rubl
    10152         .
    10153       end .
    10154       assign
    10155       libthpos_context.cash-counter = 0
    10156       libthpos_context.pre-cash-counter = 0
    10157       .
    10158       find first buf_inkas-pay-wth where
    10159                 buf_inkas-pay-wth.inkas-code = ''
    10160             and buf_inkas-pay-wth.obj-type = libthpos_context.obj-type
    10161             and buf_inkas-pay-wth.obj-code = libthpos_context.obj-code
    10162             and buf_inkas-pay-wth.pay-desk = libthpos_context.cash-num
    10163             and buf_inkas-pay-wth.pay-code = 0
    10164             and buf_inkas-pay-wth.curr-code = 0
    10165             and buf_inkas-pay-wth.wth-code = 0
    10166             and buf_inkas-pay-wth.par-code = 0
    10167             and buf_inkas-pay-wth.cashier = 0
    10168             and buf_inkas-pay-wth.chk-type = 0
    10169             no-error.
    10170       if not available buf_inkas-pay-wth then do:
    10171         create buf_inkas-pay-wth.
    10172         assign
    10173         buf_inkas-pay-wth.inkas-code = ''
    10174         buf_inkas-pay-wth.obj-type = libthpos_context.obj-type
    10175         buf_inkas-pay-wth.obj-code = libthpos_context.obj-code
    10176         buf_inkas-pay-wth.pay-desk = libthpos_context.cash-num
    10177         buf_inkas-pay-wth.pay-code = 0
    10178         buf_inkas-pay-wth.curr-code = 0
    10179         buf_inkas-pay-wth.wth-code = 0
    10180         buf_inkas-pay-wth.par-code = 0
    10181         buf_inkas-pay-wth.par-val = 0
    10182         buf_inkas-pay-wth.cashier = 0
    10183         buf_inkas-pay-wth.chk-type = 0
    10184         .
    10185       end.
    10186       assign
    10187       buf_inkas-pay-wth.tot-rubl = v-all-counter-rubl
    10188       buf_inkas-pay-wth.tot-base = v-all-counter-base
    10189       .
    10190     end.
    10191   end.
    10192   end procedure.
    10193   procedure libthpos_create-flddf :
    10194   define variable v-ii as integer no-undo .
    10195   define variable v-jj as integer no-undo .
    10196   define buffer buf_libthpos_flddf for  libthpos_flddf .
    10197   define variable v-err-mess as character no-undo .
    10198   main-block:
    10199   do
    10200   on error undo main-block, retry main-block
    10201   on stop undo main-block, retry main-block
    10202   on endkey undo main-block, retry main-block
    10203   :
    10204     if retry then do:
    10205       if v-err-mess = '' then do:
    10206         v-err-mess = substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
    10207       end.
    10208       dataset libthpos_receipt:reject-changes.
    10209       return error v-err-mess.
    10210     end.
    10211     else do:
    10212       assign
    10213       v-bh0[1] = (buffer libthpos_context:handle)
    10214       v-bh[1] = v-bh0[1]
    10215       v-bh0[2] = (buffer libthpos_chk-context:handle)
    10216       v-bh[2] = v-bh0[2]
    10217       v-bh0[3] = (buffer libthpos_chk-doc:handle)
    10218       v-bh[3] = v-bh0[3]
    10219       v-bh0[4] = (buffer libthpos_chk-gds:handle)
    10220       v-bh[4] = v-bh0[4]
    10221       v-bh0[5] = (buffer libthpos_chk-pay:handle)
    10222       v-bh[5] = v-bh0[5]
    10223       v-bh0[6] = (buffer libthpos_chk-discnt:handle)
    10224       v-bh[6] = v-bh0[6]
    10225       .
    10226       assign
    10227       buffer libthpos_chk-context:handle:buffer-field("chk-date"):help = 'doc_chk-date':U
    10228       buffer libthpos_chk-context:handle:buffer-field("chk-time"):help = 'doc_chk-time':U
    10229       buffer libthpos_chk-gds:handle:buffer-field("line-num"):help = 'gline_line-num':U
    10230       buffer libthpos_chk-pay:handle:buffer-field("line-num"):help = 'pline_line-num':U
    10231       buffer libthpos_chk-pay:handle:buffer-field("tot-sum"):help = 'pline_tot-sum':U
    10232       buffer libthpos_chk-gds:handle:buffer-field("src-qnty"):help = 'gline_src-qnty':U
    10233       buffer libthpos_chk-gds:handle:buffer-field("src-price"):help = 'gline_src-price':U
    10234       buffer libthpos_chk-gds:handle:buffer-field("src-code"):help = 'gline_src-code':U
    10235       buffer libthpos_chk-gds:handle:buffer-field("b-code"):help = 'gline_b-code':U
    10236       buffer libthpos_chk-gds:handle:buffer-field("src-sum"):help = 'gline_src-base':U
    10237       buffer libthpos_chk-gds:handle:buffer-field("src-discnt"):help = 'gline_src-discnt':U
    10238       buffer libthpos_chk-discnt:handle:buffer-field("discnt-value-pcnt"):help = 'dline_discnt-value-pcnt':U
    10239       buffer libthpos_chk-discnt:handle:buffer-field("discnt-value-abs"):help = 'dline_discnt-value-abs':U
    10240       buffer libthpos_chk-discnt:handle:buffer-field("value-type"):help = 'dline_value-type':U
    10241       buffer libthpos_chk-discnt:handle:buffer-field("templ-rl-root"):help = 'dline_templ-rl-root':U
    10242       buffer libthpos_chk-discnt:handle:buffer-field("object-sum"):help = 'dline_object-sum':U
    10243       buffer libthpos_chk-discnt:handle:buffer-field("rule-num"):help = 'dline_rule-num':U
    10244       .
    10245       do v-ii = 1 to 6:
    10246         do v-jj = 1 to v-bh[v-ii]:num-fields:
    10247           v-bh[v-ii]:buffer-field(v-jj):private-data  = v-bh[v-ii]:buffer-field(v-jj):help.
    10248           if v-bh[v-ii]:buffer-field(v-jj):private-data <> ?
    10249           and v-bh[v-ii]:buffer-field(v-jj):private-data <> '' then do:
    10250             find first buf_libthpos_flddf where
    10251                       buf_libthpos_flddf.fld-df = v-bh[v-ii]:buffer-field(v-jj):private-data no-error.
    10252             if not available buf_libthpos_flddf then do:
    10253               create buf_libthpos_flddf.
    10254               assign
    10255               buf_libthpos_flddf.fld-df = v-bh[v-ii]:buffer-field(v-jj):private-data
    10256               buf_libthpos_flddf.table-name_ = v-bh[v-ii]:table
    10257               buf_libthpos_flddf.name_ = v-bh[v-ii]:name
    10258               buf_libthpos_flddf.buffer_ = v-bh[v-ii]
    10259               buf_libthpos_flddf.field-name_ = v-bh[v-ii]:buffer-field(v-jj):name
    10260               buf_libthpos_flddf.buffer-field_ = v-bh[v-ii]:buffer-field(v-jj)
    10261               buf_libthpos_flddf.table-no = v-ii
    10262               .
    10263             end.
    10264             else do:
    10265               message
    10266               substitute("Неверно настроены регистры значений для расчета скидок и бонусов&1"  +
    10267                           "регистр &2 для расчета скидок определен дважды&1" +
    10268                           "обратитесь к администратору"
    10269                           , chr(10)
    10270                           , v-bh[v-ii]:buffer-field(v-jj):private-data
    10271                         )
    10272               view-as alert-box error.
    10273               return error.
    10274             end.
    10275           end.
    10276         end.
    10277       end.
    10278     end.
    10279   end.
    10280   end procedure.
    10281   procedure libthpos_set-gds-manual-discnt :
    10282   define input  parameter p-doc-code as character no-undo .
    10283   define input  parameter p-line-num as integer no-undo .
    10284   define input  parameter p-value-type as integer no-undo .
    10285   define input  parameter p-discnt-value as decimal no-undo .
    10286   define output parameter p-setted as logical no-undo .
    10287   define output parameter p-next as character no-undo .
    10288   define input-output parameter p-src-discnt-sum as decimal no-undo .
    10289   define input-output parameter p-src-sum as decimal no-undo .
    10290   define input-output parameter p-src-sum-netto as decimal no-undo .
    10291   define variable v-discnt as decimal no-undo .
    10292   define variable v-pcnt as decimal no-undo .
    10293   define variable v-discnt-sum as decimal no-undo .
    10294   define variable v-err-mess as character no-undo .
    10295   define buffer buf_chk-gds for ub.chk-gds.
    10296   define buffer buf_libthpos_chk-gds for libthpos_chk-gds.
    10297   define buffer buf_chk-discnt  for ub.chk-discnt.
    10298   define buffer buf_libthpos_chk-discnt for libthpos_chk-discnt.
    10299   main-block:
    10300   do
    10301   on error undo main-block, retry main-block
    10302   on stop undo main-block, retry main-block
    10303   on endkey undo main-block, retry main-block
    10304   :
    10305     if retry then do:
    10306       if v-err-mess = '' then do:
    10307         v-err-mess = substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
    10308       end.
    10309       find first buf_libthpos_chk-gds where buf_libthpos_chk-gds.line-num = p-line-num.
    10310       dataset libthpos_receipt:reject-changes.
    10311       return error v-err-mess.
    10312     end.
    10313     else do:
    10314       if not available libthpos_chk-context then do:
    10315         find first libthpos_chk-context no-error.
    10316       end.
    10317       if not available libthpos_chk-context then do:
    10318         v-err-mess = substitute("Не выставлен контекст чека").
    10319         undo main-block, retry main-block.
    10320       end.
    10321       if libthpos_chk-context.doc-code <> p-doc-code then do:
    10322         v-err-mess = substitute("Неверный номер чека = &1", p-doc-code).
    10323         undo main-block, retry main-block.
    10324       end.
    10325       if lookup(string(libthpos_chk-context.chk-type), '14,15,16,36,,17,11,12,13,40,114,115,116,117,111,112,136,,113,8,108,208,2,3,4,5,7':U) > 0
    10326       or lookup(string(libthpos_chk-context.chk-type), '6,69,96,106,169,196,206':U) > 0
    10327       then do:
    10328         v-err-mess = substitute("Неверный тип чека для задания скидки = &1", libthpos_chk-context.chk-type).
    10329         undo main-block, retry main-block.
    10330       end.
    10331       if libthpos_chk-context.lng < p-line-num
    10332       or not can-find(first libthpos_chk-gds where
    10333                             libthpos_chk-gds.doc-code = p-doc-code
    10334                         and libthpos_chk-gds.line-num = p-line-num) then do:
    10335         v-err-mess = substitute("Неверный номер товарной строки для начисления скидки = &1", p-line-num).
    10336         undo main-block, retry main-block.
    10337       end.
    10338       if not ( p-value-type = integer('1':U)
    10339               or
    10340               p-value-type = integer('10':U)) then do:
    10341         v-err-mess = substitute("Неверный тип значения скидки = &1", p-value-type).
    10342         undo main-block, retry main-block.
    10343       end.
    10344       if libthpos_context.manual-discnt = 0 then do:
    10345         v-err-mess = substitute("Запрещены ручные скидки на данной кассе/магазине").
    10346         undo main-block, retry main-block.
    10347       end.
    10348       if libthpos_chk-context.step >= 3 then do:
    10349         v-err-mess = substitute("Уже есть строки оплаты").
    10350         undo main-block, retry main-block.
    10351       end.
    10352       for first buf_chk-gds share-lock where
    10353               buf_chk-gds.doc-code = p-doc-code
    10354           and buf_chk-gds.line-num = p-line-num,
    10355           first buf_libthpos_chk-gds where
    10356                 buf_libthpos_chk-gds.doc-code = p-doc-code
    10357           and  buf_libthpos_chk-gds.line-num = p-line-num :
    10358         leave.
    10359       end.
    10360       if buf_libthpos_chk-gds.without-gds-discnt > 0 then do:
    10361         v-err-mess = substitute("На товаре стоит флаг запрета товарных скидок").
    10362         undo main-block, retry main-block.
    10363       end.
    10364       case p-value-type:
    10365         when integer('1':U) then do:
    10366           if p-discnt-value > 100 then do:
    10367             v-err-mess = substitute("Недопустимая величина скидки = &1 (>= 100%)"
    10368                                                     , p-discnt-value
    10369                                                     ).
    10370             undo main-block, retry main-block.
    10371           end.
    10372           assign
    10373           v-discnt = buf_libthpos_chk-gds.src-price-netto *  p-discnt-value / 100
    10374           v-pcnt = p-discnt-value
    10375           v-discnt-sum = v-discnt *  buf_libthpos_chk-gds.src-qnty
    10376           .
    10377         end.
    10378         when integer('10':U) then do:
    10379           if buf_libthpos_chk-gds.src-qnty * buf_libthpos_chk-gds.src-price-netto - p-discnt-value  <= 0 then do:
    10380             v-err-mess = substitute("Недопустимая величина скидки = &1&2Сумма по строке без этой скидки =&3"
    10381                                                       , p-discnt-value
    10382                                                       , chr(10)
    10383                                                       ,(buf_libthpos_chk-gds.src-qnty * buf_libthpos_chk-gds.src-price-netto)
    10384                                                       ).
    10385             undo main-block, retry main-block.
    10386           end.
    10387           assign
    10388           v-discnt = p-discnt-value / buf_libthpos_chk-gds.src-qnty
    10389           v-pcnt = p-discnt-value / buf_libthpos_chk-gds.src-price-netto * 100  / buf_libthpos_chk-gds.src-qnty
    10390           v-discnt-sum = p-discnt-value
    10391           .
    10392         end.
    10393       end case.
    10394       if buf_libthpos_chk-gds.manual-discnt-id = 0 then do:
    10395         create buf_libthpos_chk-discnt.
    10396         assign
    10397         buf_libthpos_chk-discnt.doc-code = p-doc-code
    10398         buf_libthpos_chk-discnt.record-type = 0
    10399         buf_libthpos_chk-discnt.line-type = integer('1':U)
    10400         buf_libthpos_chk-discnt.discnt-id = libthpos_chk-context.discnt-id + 1
    10401         libthpos_chk-context.discnt-id = libthpos_chk-context.discnt-id + 1
    10402         buf_libthpos_chk-discnt.line-num = p-line-num
    10403         libthpos_chk-context.lnd = libthpos_chk-context.lnd + 1
    10404         buf_libthpos_chk-discnt.pay-desk = libthpos_context.cash-num
    10405         buf_libthpos_chk-discnt.obj-type = libthpos_context.obj-type
    10406         buf_libthpos_chk-discnt.obj-code = libthpos_context.obj-code
    10407         buf_libthpos_chk-discnt.chk-date = libthpos_chk-context.chk-date
    10408         buf_libthpos_chk-discnt.chk-time = libthpos_chk-context.chk-time
    10409         buf_libthpos_chk-discnt.time-oper = buf_libthpos_chk-gds.time-oper
    10410         buf_libthpos_chk-discnt.src-d-card = buf_libthpos_chk-gds.src-d-card
    10411         buf_libthpos_chk-discnt.kateg = libthpos_chk-context.category
    10412         buf_libthpos_chk-discnt.rank = 999999999
    10413         buf_libthpos_chk-discnt.pass-discnt = integer('1':U)
    10414         buf_libthpos_chk-discnt.rule-num = 0
    10415         buf_libthpos_chk-discnt.templ-rl-root = 0
    10416         buf_libthpos_chk-discnt.discnt-type = integer('13':U)
    10417         buf_libthpos_chk-discnt.discnt-role = ''
    10418         buf_libthpos_chk-discnt.object-line-num =  p-line-num
    10419         buf_libthpos_chk-discnt.src-price-netto = buf_libthpos_chk-gds.src-price-netto
    10420         buf_libthpos_chk-gds.manual-discnt-id = buf_libthpos_chk-discnt.discnt-id
    10421         .
    10422       end.
    10423       else do:
    10424         for first buf_libthpos_chk-discnt where
    10425                 buf_libthpos_chk-discnt.doc-code = p-doc-code
    10426           and  buf_libthpos_chk-discnt.record-type = 0
    10427           and  buf_libthpos_chk-discnt.line-num = p-line-num
    10428           and  buf_libthpos_chk-discnt.discnt-id = buf_libthpos_chk-gds.manual-discnt-id,
    10429           first buf_chk-discnt share-lock where
    10430                 buf_chk-discnt.doc-code = p-doc-code
    10431           and  buf_chk-discnt.record-type = 0
    10432           and  buf_chk-discnt.line-num = p-line-num
    10433           and  buf_chk-discnt.discnt-id = buf_libthpos_chk-gds.manual-discnt-id:
    10434           leave.
    10435         end.
    10436       end.
    10437       assign
    10438       libthpos_chk-context.manual-discnt-sum = libthpos_chk-context.manual-discnt-sum - buf_libthpos_chk-gds.manual-discnt-sum
    10439       libthpos_chk-context.netto = libthpos_chk-context.netto + (if (buf_chk-gds.write-off-code = ?
    10440                                             or buf_chk-gds.write-off-code <= 0)
    10441                                             and not libthpos_chk-context.is-petrol-check
    10442                                             then
    10443                                             ( - (buf_chk-gds.src-sum - buf_libthpos_chk-gds.src-discnt-sum))
    10444                                             else 0)
    10445       libthpos_chk-context.gds-netto = libthpos_chk-context.gds-netto + (if (buf_chk-gds.write-off-code = ?
    10446                                             or buf_chk-gds.write-off-code <= 0)
    10447                                             and not libthpos_chk-context.is-petrol-check
    10448                                             then
    10449                                             ( - (buf_chk-gds.src-sum - buf_libthpos_chk-gds.src-discnt-sum))
    10450                                             else 0)
    10451       libthpos_chk-context.sub-netto = libthpos_chk-context.sub-netto + (if (buf_chk-gds.write-off-code = ?
    10452                                             or buf_chk-gds.write-off-code <= 0)
    10453                                             and not libthpos_chk-context.is-petrol-check
    10454                                             then
    10455                                             ( - (buf_chk-gds.src-sum - buf_libthpos_chk-gds.src-discnt-sum))
    10456                                             else 0)
    10457       libthpos_chk-context.gds-discnt = libthpos_chk-context.gds-discnt - buf_libthpos_chk-gds.src-discnt-sum
    10458       libthpos_chk-context.discnt = libthpos_chk-context.discnt - buf_libthpos_chk-gds.src-discnt-sum
    10459       libthpos_chk-context.gds-r = libthpos_chk-context.gds-r - buf_libthpos_chk-gds.r-sum
    10460       buf_chk-gds.src-discnt = buf_chk-gds.src-discnt - buf_libthpos_chk-discnt.delta-discnt
    10461       buf_libthpos_chk-gds.src-discnt = buf_libthpos_chk-gds.src-discnt - buf_libthpos_chk-discnt.delta-discnt
    10462       buf_libthpos_chk-gds.src-price-netto = buf_libthpos_chk-gds.src-price-netto + buf_libthpos_chk-discnt.delta-discnt
    10463       buf_libthpos_chk-discnt.object-qnty =  buf_libthpos_chk-gds.src-qnty
    10464       buf_libthpos_chk-discnt.object-sum =  buf_libthpos_chk-gds.src-qnty * buf_libthpos_chk-gds.src-price-netto
    10465       buf_libthpos_chk-discnt.discnt-value-abs =  v-discnt-sum
    10466       buf_libthpos_chk-discnt.discnt-value-pcnt =  v-pcnt
    10467       buf_libthpos_chk-discnt.delta-discnt  =  v-discnt
    10468       buf_libthpos_chk-discnt.value-type = p-value-type
    10469       .
    10470       buffer-copy buf_libthpos_chk-discnt to buf_chk-discnt.
    10471       assign
    10472       buf_chk-gds.src-discnt = buf_chk-gds.src-discnt + v-discnt
    10473       buf_libthpos_chk-gds.src-discnt = buf_libthpos_chk-gds.src-discnt + v-discnt
    10474       buf_libthpos_chk-gds.src-price-netto = buf_libthpos_chk-gds.src-price-netto - v-discnt
    10475       buf_libthpos_chk-gds.price-base-netto = buf_libthpos_chk-gds.src-price-netto * buf_libthpos_chk-gds.cli-base-rate
    10476       buf_libthpos_chk-gds.will-price-base  = buf_libthpos_chk-gds.start-src-price * buf_libthpos_chk-gds.cli-base-rate
    10477       .
    10478       assign
    10479       buf_libthpos_chk-gds.src-discnt-sum = truncate(buf_libthpos_chk-gds.src-qnty * buf_libthpos_chk-gds.src-discnt, 2)
    10480       buf_libthpos_chk-gds.r-sum = (buf_libthpos_chk-gds.src-qnty * (buf_libthpos_chk-gds.start-src-price - v-discnt)) -
    10481                                   (buf_libthpos_chk-gds.src-sum -  buf_libthpos_chk-gds.src-discnt-sum)
    10482       buf_libthpos_chk-gds.manual-discnt-sum = buf_libthpos_chk-discnt.discnt-value-abs
    10483       libthpos_chk-context.manual-discnt-sum = libthpos_chk-context.manual-discnt-sum + buf_libthpos_chk-gds.manual-discnt-sum
    10484       libthpos_chk-context.netto = libthpos_chk-context.netto + (if (buf_libthpos_chk-gds.write-off-code = ?
    10485                                             or buf_libthpos_chk-gds.write-off-code <= 0)
    10486                                             and not libthpos_chk-context.is-petrol-check
    10487                                             then (buf_chk-gds.src-sum - buf_libthpos_chk-gds.src-discnt-sum)
    10488                                             else 0)
    10489       libthpos_chk-context.gds-netto = libthpos_chk-context.gds-netto + (if (buf_libthpos_chk-gds.write-off-code = ?
    10490                                             or buf_libthpos_chk-gds.write-off-code <= 0)
    10491                                             and not libthpos_chk-context.is-petrol-check
    10492                                             then (buf_chk-gds.src-sum - buf_libthpos_chk-gds.src-discnt-sum)
    10493                                             else 0)
    10494       libthpos_chk-context.sub-netto = libthpos_chk-context.sub-netto + (if (buf_libthpos_chk-gds.write-off-code = ?
    10495                                             or buf_libthpos_chk-gds.write-off-code <= 0)
    10496                                             and not libthpos_chk-context.is-petrol-check
    10497                                             then (buf_chk-gds.src-sum - buf_libthpos_chk-gds.src-discnt-sum)
    10498                                             else 0)
    10499       libthpos_chk-context.gds-discnt = libthpos_chk-context.gds-discnt + buf_libthpos_chk-gds.src-discnt-sum
    10500       libthpos_chk-context.discnt = libthpos_chk-context.discnt + buf_libthpos_chk-gds.src-discnt-sum
    10501       libthpos_chk-context.gds-r = libthpos_chk-context.gds-r + buf_libthpos_chk-gds.r-sum
    10502       .
    10503       if libthpos_chk-context.discnt >= libthpos_chk-context.src-tot-doc
    10504       and libthpos_chk-context.direction > 0
    10505       then do:
    10506         v-err-mess = substitute("Недопустимая величина скидки для чека &1, общая скидка по чеку (&1) больше товарной суммы (&2) Возможно не стоит применять ручную скидку"
    10507                                 , libthpos_chk-context.discnt
    10508                                 , libthpos_chk-context.src-tot-doc
    10509                                 ).
    10510         undo main-block, retry main-block.
    10511       end.
    10512       if (buf_libthpos_chk-discnt.discnt-value-abs = 0.0 and buf_libthpos_chk-discnt.value-type = integer('10':U))
    10513       or (buf_libthpos_chk-discnt.discnt-value-pcnt = 0.0 and buf_libthpos_chk-discnt.value-type = integer('1':U))
    10514       then do:
    10515         delete buf_libthpos_chk-discnt.
    10516         delete buf_chk-discnt.
    10517         buf_libthpos_chk-gds.manual-discnt-id = 0.
    10518       end.
    10519       assign
    10520       libthpos_chk-context.recalc-gline-num = (if p-line-num <= libthpos_chk-context.lng
    10521                                                 then buf_libthpos_chk-gds.recalc-line-num
    10522                                                 else libthpos_chk-context.recalc-gline-num)
    10523       p-src-discnt-sum = buf_libthpos_chk-gds.src-discnt-sum
    10524       p-src-sum = buf_chk-gds.src-sum
    10525       p-src-sum-netto = p-src-sum - p-src-discnt-sum
    10526       p-setted = yes
    10527       p-next = ''
    10528       .
    10529       run libthpos_recalc-discnt in this-procedure no-error.
    10530       if error-status:error then do:
    10531         v-err-mess = substitute("Ош-ка при пересчете: &1 &2", return-value , error-status:get-message(1) ).
    10532         undo main-block, retry main-block.
    10533       end.
    10534       dataset libthpos_receipt:accept-changes.
    10535     end.
    10536   end.
    10537   end procedure.
    10538   procedure libthpos_set-subtotal-manual-discnt :
    10539   define input  parameter p-doc-code as character no-undo .
    10540   define input  parameter p-value-type as integer no-undo .
    10541   define input  parameter p-discnt-value as decimal no-undo .
    10542   define output parameter p-setted as logical no-undo .
    10543   define output parameter p-next as character no-undo .
    10544   define input-output parameter p-st-r-b as decimal no-undo .
    10545   define input-output parameter p-st-rubl as decimal no-undo .
    10546   define input-output parameter p-st-base as decimal no-undo .
    10547   define input-output parameter p-tot-doc as decimal no-undo .
    10548   define input-output parameter p-discnt as decimal no-undo .
    10549   define variable v-discnt as decimal no-undo .
    10550   define variable v-pcnt as decimal no-undo .
    10551   DEFINE VARIABLE v-today as date no-undo .
    10552   DEFINE VARIABLE v-time as integer no-undo .
    10553   define variable v-err-mess as character no-undo .
    10554   define buffer buf_chk-gds for ub.chk-gds.
    10555   define buffer buf_libthpos_chk-gds for libthpos_chk-gds.
    10556   define buffer buf_chk-discnt  for ub.chk-discnt.
    10557   define buffer buf_libthpos_chk-discnt for libthpos_chk-discnt.
    10558   main-block:
    10559   do
    10560   on error undo main-block, retry main-block
    10561   on stop undo main-block, retry main-block
    10562   on endkey undo main-block, retry main-block
    10563   :
    10564     if retry then do:
    10565       if v-err-mess = '' then do:
    10566         v-err-mess = substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
    10567       end.
    10568       dataset libthpos_receipt:reject-changes.
    10569       return error v-err-mess.
    10570     end.
    10571     else do:
    10572       if not available libthpos_chk-context then do:
    10573         find first libthpos_chk-context no-error.
    10574       end.
    10575       if not available libthpos_chk-context then do:
    10576         v-err-mess = substitute("Не выставлен контекст чека").
    10577         undo main-block, retry main-block.
    10578       end.
    10579       if libthpos_chk-context.doc-code <> p-doc-code then do:
    10580         v-err-mess = substitute("Неверный номер чека = &1", p-doc-code).
    10581         undo main-block, retry main-block.
    10582       end.
    10583       if lookup(string(libthpos_chk-context.chk-type), '14,15,16,36,,17,11,12,13,40,114,115,116,117,111,112,136,,113,8,108,208,2,3,4,5,7':U) > 0
    10584       or lookup(string(libthpos_chk-context.chk-type), '6,69,96,106,169,196,206':U) > 0
    10585       then do:
    10586         v-err-mess = substitute("Неверный тип чека для задания скидки = &1", libthpos_chk-context.chk-type).
    10587         undo main-block, retry main-block.
    10588       end.
    10589       if libthpos_chk-context.lng = 0
    10590       or not can-find(first libthpos_chk-gds where
    10591                             libthpos_chk-gds.doc-code = p-doc-code
    10592                         ) then do:
    10593         v-err-mess = substitute("Нет строк в чеке").
    10594         undo main-block, retry main-block.
    10595       end.
    10596       if libthpos_chk-context.step < 2 then do:
    10597         v-err-mess = substitute("Не был подведен итог в чеке").
    10598         undo main-block, retry main-block.
    10599       end.
    10600       if libthpos_chk-context.step >= 3 then do:
    10601         v-err-mess = substitute("Уже есть строки оплаты").
    10602         undo main-block, retry main-block.
    10603       end.
    10604       if not ( p-value-type = integer('1':U)
    10605               or
    10606               p-value-type = integer('10':U)) then do:
    10607         v-err-mess = substitute("Неверный тип значения скидки = &1", p-value-type).
    10608         undo main-block, retry main-block.
    10609       end.
    10610       if libthpos_context.manual-discnt = 0 then do:
    10611         v-err-mess = substitute("Запрещены ручные скидки на данной кассе/магазине").
    10612         undo main-block, retry main-block.
    10613       end.
    10614       case p-value-type:
    10615         when integer('1':U) then do:
    10616           if  p-discnt-value >= 100 then do:
    10617             v-err-mess = substitute("Недопустимая величина скидки = &1 (>= 100%)"
    10618                                                       , p-discnt-value
    10619                                                       ).
    10620             undo main-block, retry main-block.
    10621           end.
    10622         end.
    10623         when integer('10':U) then do:
    10624           if libthpos_chk-context.st-for-discnt-r-b - p-discnt-value  <= 0 then do:
    10625             v-err-mess = substitute("Недопустимая величина скидки = &1&2Сумма по чеку без этой скидки =&3"
    10626                                                       , p-discnt-value
    10627                                                       , chr(10)
    10628                                                       ,libthpos_chk-context.st-for-discnt-r-b
    10629                                                       ).
    10630             undo main-block, retry main-block.
    10631           end.
    10632         end.
    10633       end.
    10634       if libthpos_chk-context.manual-discnt-id <> 0 then do:
    10635         for first buf_libthpos_chk-discnt where
    10636                 buf_libthpos_chk-discnt.doc-code = p-doc-code
    10637           and  buf_libthpos_chk-discnt.record-type = 0
    10638           and  buf_libthpos_chk-discnt.line-num = libthpos_chk-context.manual-discnt-ln
    10639           and  buf_libthpos_chk-discnt.discnt-id = libthpos_chk-context.manual-discnt-id,
    10640           first buf_chk-discnt share-lock where
    10641                 buf_chk-discnt.doc-code = p-doc-code
    10642           and  buf_chk-discnt.record-type = 0
    10643           and  buf_chk-discnt.line-num = libthpos_chk-context.manual-discnt-ln
    10644           and  buf_chk-discnt.discnt-id = libthpos_chk-context.manual-discnt-id:
    10645           assign
    10646           libthpos_chk-context.st-for-discnt-r-b = libthpos_chk-context.st-for-discnt-r-b + buf_libthpos_chk-discnt.discnt-value-abs
    10647           .
    10648           leave.
    10649         end.
    10650       end.
    10651       case p-value-type:
    10652         when integer('1':U) then do:
    10653           assign
    10654           v-discnt = libthpos_chk-context.st-for-discnt-r-b *  p-discnt-value / 100
    10655           v-pcnt = p-discnt-value
    10656           .
    10657         end.
    10658         when integer('10':U) then do:
    10659           assign
    10660           v-discnt = p-discnt-value
    10661           v-pcnt = p-discnt-value / libthpos_chk-context.st-for-discnt-r-b * 100
    10662           .
    10663         end.
    10664       end case.
    10665       if libthpos_chk-context.manual-discnt-id = 0 then do:
    10666         run cur-time in this-procedure ( output v-today, output v-time).
    10667         create buf_libthpos_chk-discnt.
    10668         assign
    10669         buf_libthpos_chk-discnt.doc-code = p-doc-code
    10670         buf_libthpos_chk-discnt.record-type = 0
    10671         buf_libthpos_chk-discnt.line-type = integer('4':U)
    10672         buf_libthpos_chk-discnt.discnt-id = libthpos_chk-context.discnt-id + 1
    10673         libthpos_chk-context.discnt-id = libthpos_chk-context.discnt-id + 1
    10674         buf_libthpos_chk-discnt.line-num = libthpos_chk-context.lng
    10675         libthpos_chk-context.lnd = libthpos_chk-context.lnd + 1
    10676         buf_libthpos_chk-discnt.pay-desk = libthpos_context.cash-num
    10677         buf_libthpos_chk-discnt.obj-type = libthpos_context.obj-type
    10678         buf_libthpos_chk-discnt.obj-code = libthpos_context.obj-code
    10679         buf_libthpos_chk-discnt.chk-date = libthpos_chk-context.chk-date
    10680         buf_libthpos_chk-discnt.chk-time = libthpos_chk-context.chk-time
    10681         buf_libthpos_chk-discnt.time-oper = v-time
    10682         buf_libthpos_chk-discnt.src-d-card = libthpos_chk-context.src-d-card
    10683         buf_libthpos_chk-discnt.kateg = libthpos_chk-context.category
    10684         buf_libthpos_chk-discnt.rank = 999999999
    10685         buf_libthpos_chk-discnt.pass-discnt = integer('1':U)
    10686         buf_libthpos_chk-discnt.rule-num = 0
    10687         buf_libthpos_chk-discnt.templ-rl-root = 0
    10688         buf_libthpos_chk-discnt.discnt-type = integer('13':U)
    10689         buf_libthpos_chk-discnt.discnt-role = ''
    10690         buf_libthpos_chk-discnt.object-line-num =  libthpos_chk-context.lnd
    10691         libthpos_chk-context.manual-discnt-id = buf_libthpos_chk-discnt.discnt-id
    10692         libthpos_chk-context.manual-discnt-ln = libthpos_chk-context.lng
    10693         .
    10694       end.
    10695       else do:
    10696         assign
    10697         buf_libthpos_chk-discnt.line-num = libthpos_chk-context.lng
    10698         buf_chk-discnt.line-num = libthpos_chk-context.lng
    10699         libthpos_chk-context.manual-discnt-ln = libthpos_chk-context.lng
    10700         .
    10701       end.
    10702       assign
    10703       libthpos_chk-context.manual-discnt-sum = libthpos_chk-context.manual-discnt-sum - buf_libthpos_chk-discnt.discnt-value-abs
    10704       libthpos_chk-context.netto = libthpos_chk-context.netto + buf_libthpos_chk-discnt.discnt-value-abs
    10705       libthpos_chk-context.sub-netto = libthpos_chk-context.sub-netto +  buf_libthpos_chk-discnt.discnt-value-abs
    10706       libthpos_chk-context.tot-discnt = libthpos_chk-context.tot-discnt - buf_libthpos_chk-discnt.discnt-value-abs
    10707       libthpos_chk-context.discnt = libthpos_chk-context.discnt - buf_libthpos_chk-discnt.discnt-value-abs
    10708       buf_libthpos_chk-discnt.discnt-value-abs = truncate(v-discnt, 2)
    10709       buf_libthpos_chk-discnt.discnt-value-pcnt = v-pcnt
    10710       buf_libthpos_chk-discnt.delta-discnt  =  v-discnt
    10711       buf_libthpos_chk-discnt.object-qnty =  libthpos_chk-context.src-qnty
    10712       buf_libthpos_chk-discnt.object-sum =  libthpos_chk-context.st-for-discnt-r-b
    10713       buf_libthpos_chk-discnt.value-type = p-value-type
    10714       .
    10715       buffer-copy buf_libthpos_chk-discnt to buf_chk-discnt.
    10716       assign
    10717       libthpos_chk-context.manual-discnt-sum = libthpos_chk-context.manual-discnt-sum + buf_libthpos_chk-discnt.discnt-value-abs
    10718       libthpos_chk-context.netto = libthpos_chk-context.netto - buf_libthpos_chk-discnt.discnt-value-abs
    10719       libthpos_chk-context.sub-netto = libthpos_chk-context.sub-netto  - buf_libthpos_chk-discnt.discnt-value-abs
    10720       libthpos_chk-context.tot-discnt = libthpos_chk-context.tot-discnt + buf_libthpos_chk-discnt.discnt-value-abs
    10721       libthpos_chk-context.discnt = libthpos_chk-context.discnt + buf_libthpos_chk-discnt.discnt-value-abs
    10722       libthpos_chk-context.manual-tot-discnt = buf_libthpos_chk-discnt.discnt-value-abs
    10723       libthpos_chk-context.manual-tot-dis-type = buf_libthpos_chk-discnt.value-type
    10724       libthpos_chk-context.st-r-b = libthpos_rmethod(libthpos_context.rmethod-type
    10725                                                       , libthpos_context.rmethod-coeff
    10726                                                       , libthpos_chk-context.sub-netto)
    10727       .
    10728       if libthpos_chk-context.discnt >= libthpos_chk-context.src-tot-doc then do:
    10729         v-err-mess = substitute("Недопустимая величина скидки для чека &1, общая скидка по чеку (&1) больше товарной суммы (&2)"
    10730                                 , libthpos_chk-context.discnt
    10731                                 , libthpos_chk-context.src-tot-doc
    10732                                 ).
    10733         undo main-block, retry main-block.
    10734       end.
    10735       if (buf_libthpos_chk-discnt.discnt-value-abs = 0.0 and buf_libthpos_chk-discnt.value-type = integer('10':U))
    10736       or (buf_libthpos_chk-discnt.discnt-value-pcnt = 0.0 and buf_libthpos_chk-discnt.value-type = integer('1':U))
    10737       then do:
    10738         delete buf_libthpos_chk-discnt.
    10739         delete buf_chk-discnt.
    10740         libthpos_chk-context.manual-discnt-id = 0.
    10741       end.
    10742       assign
    10743       p-st-r-b = libthpos_chk-context.st-r-b
    10744       libthpos_chk-context.st-rubl =  (if libthpos_context.r-b = 'rubl':U
    10745                                       or (libthpos_context.r-b = 'base':U
    10746                                           and
    10747                                           libthpos_context.base-code = 0)
    10748                                         then libthpos_chk-context.st-r-b
    10749                                         else libthpos_chk-context.st-r-b * libthpos_chk-context.a-base-rate)
    10750       p-st-rubl = libthpos_chk-context.st-rubl
    10751       libthpos_chk-context.st-base = (if libthpos_context.r-b = 'base':U
    10752                                       or (libthpos_context.r-b = 'rubl':U
    10753                                           and
    10754                                           libthpos_context.base-code = 0)
    10755                                       then libthpos_chk-context.st-r-b
    10756                                       else libthpos_chk-context.st-r-b / libthpos_chk-context.a-base-rate)
    10757       p-st-base = libthpos_chk-context.st-base
    10758       p-tot-doc = libthpos_chk-context.src-tot-doc
    10759       libthpos_chk-context.tot-r = libthpos_chk-context.sub-netto - libthpos_chk-context.st-r-b
    10760       p-discnt  = libthpos_chk-context.gds-discnt + libthpos_chk-context.tot-discnt
    10761       libthpos_chk-context.to-pay-r-b   = libthpos_chk-context.st-r-b - libthpos_chk-context.has-pay-r-b
    10762       libthpos_chk-context.to-pay-rubl  = (if libthpos_context.r-b = 'rubl':U
    10763                                               or (libthpos_context.r-b = 'base':U
    10764                                                   and
    10765                                                   libthpos_context.base-code  = 0)
    10766                                               then libthpos_chk-context.st-r-b
    10767                                               else libthpos_chk-context.st-r-b * libthpos_chk-context.cash-rate / libthpos_chk-context.cash-scale)
    10768                                           - libthpos_chk-context.has-pay-rubl
    10769       libthpos_chk-context.all-pay-rubl =  libthpos_chk-context.st-rubl - libthpos_chk-context.pay-discnt-rubl
    10770       libthpos_chk-context.to-pay-base  = (if libthpos_context.r-b = 'base':U
    10771                                               or (libthpos_context.r-b = 'rubl':U
    10772                                                   and
    10773                                                   libthpos_context.base-code  = 0)
    10774                                               then libthpos_chk-context.st-r-b
    10775                                               else libthpos_chk-context.st-r-b / libthpos_chk-context.cash-rate * libthpos_chk-context.cash-scale)
    10776                                               - libthpos_chk-context.has-pay-base
    10777       libthpos_chk-context.all-pay-base =  libthpos_chk-context.st-base - libthpos_chk-context.pay-discnt-base
    10778       p-setted = yes
    10779       p-next =
    10780                 ''
    10781       .
    10782       run libthpos_recalc-discnt in this-procedure no-error.
    10783       if error-status:error then do:
    10784         v-err-mess = substitute("Ош-ка при пересчете: &1 &2", return-value , error-status:get-message(1) ).
    10785         undo main-block, retry main-block.
    10786       end.
    10787       dataset libthpos_receipt:accept-changes.
    10788     end.
    10789   end.
    10790   end procedure.
    10791   procedure libthpos_cfr :
    10792   define input  parameter p-doc-code as character no-undo .
    10793   define input parameter p-trans-type as integer no-undo .
    10794   define input parameter p-charkey_one as character no-undo .
    10795   define input parameter p-deckey_one as decimal no-undo .
    10796   define input parameter p-key#_one as integer no-undo .
    10797   define variable v-err-mess as character no-undo .
    10798   define buffer buf_cd-trans for ub.cd-trans.
    10799   main-block:
    10800   do
    10801   on error undo main-block, retry main-block
    10802   on stop undo main-block, retry main-block
    10803   on endkey undo main-block, retry main-block
    10804   :
    10805     if retry then do:
    10806       if v-err-mess = '' then do:
    10807         v-err-mess = substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
    10808       end.
    10809       dataset libthpos_receipt:reject-changes.
    10810       return error v-err-mess.
    10811     end.
    10812     else do:
    10813       if not available libthpos_chk-context then do:
    10814         find first libthpos_chk-context no-error.
    10815         if not available libthpos_chk-context then do:
    10816           v-err-mess = substitute("Не выставлен контекст чека").
    10817           undo main-block, retry main-block.
    10818         end.
    10819       end.
    10820       if libthpos_chk-context.doc-code <> p-doc-code then do:
    10821         v-err-mess = substitute("Неверный номер чека = &1", p-doc-code).
    10822         undo main-block, retry main-block.
    10823       end.
    10824       if libthpos_chk-context.chk-type <> integer('12':U)  then do:
    10825         v-err-mess = substitute("Запись фискальных регистров возможна только внутри чека z-отчета").
    10826         undo main-block, retry main-block.
    10827       end.
    10828       find first buf_cd-trans share-lock where
    10829             buf_cd-trans.trans-type = p-trans-type
    10830           and buf_cd-trans.obj-type = libthpos_context.obj-type
    10831           and buf_cd-trans.obj-code = libthpos_context.obj-code
    10832           and buf_cd-trans.pay-desk = libthpos_context.cash-num
    10833           and buf_cd-trans.chk-id = libthpos_chk-context.doc-code
    10834           and buf_cd-trans.charkey_one = p-charkey_one
    10835       no-error.
    10836       if not available buf_cd-trans then do:
    10837         create buf_cd-trans.
    10838         assign
    10839         buf_cd-trans.db-num   = g#db-num
    10840         buf_cd-trans.trans-id = next-value(s-cd-trans, ub)
    10841         buf_cd-trans.trans-type = p-trans-type
    10842         buf_cd-trans.obj-type = libthpos_context.obj-type
    10843         buf_cd-trans.obj-code = libthpos_context.obj-code
    10844         buf_cd-trans.chk-date = libthpos_chk-context.chk-date
    10845         buf_cd-trans.chk-time = libthpos_chk-context.chk-time
    10846         buf_cd-trans.chk-id = libthpos_chk-context.doc-code
    10847         buf_cd-trans.z-number = libthpos_context.z-number
    10848         buf_cd-trans.doc-code = libthpos_chk-context.doc-code
    10849         buf_cd-trans.src-shift-date = libthpos_context.shift-date
    10850         buf_cd-trans.src-shift-name = libthpos_context.shift-name
    10851         buf_cd-trans.shift-name = libthpos_context.shift-name
    10852         buf_cd-trans.shift-date = libthpos_context.shift-date
    10853         buf_cd-trans.shift-num = libthpos_context.shift-num
    10854         buf_cd-trans.pay-desk = libthpos_context.cash-num
    10855         buf_cd-trans.charkey_one = p-charkey_one
    10856         buf_cd-trans.deckey_one = p-deckey_one
    10857         buf_cd-trans.key#_one = p-key#_one
    10858         .
    10859       end.
    10860     end.
    10861   end.
    10862   end procedure.
    10863   procedure libthpos_recalc-discnt private:
    10864   define variable v-setted as logical no-undo .
    10865   define variable v-b-code as integer no-undo .
    10866   define variable v-gds-code as integer no-undo .
    10867   define variable v-chk-name as character no-undo .
    10868   define variable v-second-name as character no-undo .
    10869   define variable v-src-price as decimal no-undo .
    10870   define variable v-src-discnt-sum as decimal no-undo .
    10871   define variable v-src-sum as decimal no-undo .
    10872   define variable v-src-sum-netto as decimal no-undo .
    10873   define variable v-next as character no-undo .
    10874   define variable  v-src-price-rubl as decimal no-undo .
    10875   define variable  v-src-discnt-sum-rubl as decimal no-undo .
    10876   define variable  v-src-sum-rubl as decimal no-undo .
    10877   define variable  v-src-sum-netto-rubl as decimal no-undo .
    10878   define variable v-err-mess as character no-undo .
    10879   define variable v-mode as character no-undo .
    10880   define variable v-ii as integer no-undo .
    10881   define variable v-st-rb as decimal no-undo .
    10882   define variable v-st-rubl as decimal no-undo .
    10883   define variable v-st-base as decimal no-undo .
    10884   define variable v-tot-doc as decimal no-undo .
    10885   define variable v-st-discnt as decimal no-undo .
    10886   define variable v-netto as decimal no-undo .
    10887   define variable v-netto-rubl as decimal no-undo .
    10888   define variable v-netto-base as decimal no-undo .
    10889   define variable v-all-discnt as decimal no-undo .
    10890   define variable v-all-discnt-rubl as decimal no-undo .
    10891   define variable v-all-discnt-base as decimal no-undo .
    10892   define variable v-unit-base as character no-undo .
    10893   define variable v-step as integer no-undo .
    10894   define buffer buf_libthpos_chk-discnt for libthpos_chk-discnt.
    10895   define buffer buf_libthpos_chk-gds for libthpos_chk-gds.
    10896   define buffer buf2_libthpos_chk-gds for libthpos_chk-gds.
    10897   define buffer buf_libthpos_chk-pay for libthpos_chk-pay.
    10898   main-block:
    10899   do
    10900   on error undo main-block, retry main-block
    10901   on stop undo main-block, retry main-block
    10902   on endkey undo main-block, retry main-block
    10903   :
    10904     if retry then do:
    10905       if v-err-mess = '' then do:
    10906         v-err-mess = substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
    10907       end.
    10908       dataset libthpos_receipt:reject-changes.
    10909       return error v-err-mess.
    10910     end.
    10911     else do:
    10912       v-step = libthpos_chk-context.step.
    10913       if v-step >= 1 then do:
    10914         for each buf_libthpos_chk-gds where
    10915                 buf_libthpos_chk-gds.doc-code = libthpos_chk-context.doc-code
    10916             and buf_libthpos_chk-gds.line-num >= libthpos_chk-context.recalc-gline-num
    10917         on error  undo main-block, retry main-block
    10918         on stop   undo main-block, retry main-block
    10919         on endkey undo main-block, retry main-block
    10920         :
    10921           v-ii = v-ii + 1.
    10922           assign
    10923           v-setted = no.
    10924           if (libthpos_chk-context.chk-type = integer('6':U)
    10925           or libthpos_chk-context.chk-type = integer('96':U)
    10926           or libthpos_chk-context.chk-type = integer('206':U)
    10927             ) then do:
    10928             v-src-price = buf_libthpos_chk-gds.src-price.
    10929           end.
    10930           else v-src-price = ?.
    10931           assign
    10932           v-mode = 'ИЗМЕНЕНИЕ':U + chr(44) + "recalc" + chr(44) + "no-changes".
    10933           run libthpos_gds-line  in this-procedure (
    10934                                                       input libthpos_chk-context.doc-code
    10935                                                     ,input buf_libthpos_chk-gds.line-num
    10936                                                     ,input v-mode
    10937                                                     ,input buf_libthpos_chk-gds.line-direction
    10938                                                     ,input buf_libthpos_chk-gds.src-code
    10939                                                     ,input-output buf_libthpos_chk-gds.src-qnty
    10940                                                     ,input buf_libthpos_chk-gds.pump
    10941                                                     ,input buf_libthpos_chk-gds.nozzle-code
    10942                                                     ,input buf_libthpos_chk-gds.pl-code
    10943                                                     ,input buf_libthpos_chk-gds.pass-gds
    10944                                                     ,input buf_libthpos_chk-gds.write-off-code
    10945                                                     ,input buf_libthpos_chk-gds.depart-id
    10946                                                     ,output v-setted
    10947                                                     ,output v-next
    10948                                                     ,output v-b-code
    10949                                                     ,output v-gds-code
    10950                                                     ,output v-chk-name
    10951                                                     ,output v-second-name
    10952                                                     ,input-output v-src-price
    10953                                                     ,output v-src-price-rubl
    10954                                                     ,output v-src-discnt-sum
    10955                                                     ,output v-src-discnt-sum-rubl
    10956                                                     ,output v-src-sum
    10957                                                     ,output v-src-sum-rubl
    10958                                                     ,output v-src-sum-netto
    10959                                                     ,output v-src-sum-netto-rubl
    10960                                                     ,output v-unit-base
    10961                                                     ) no-error.
    10962           if not error-status:error
    10963           and v-setted
    10964           then do:
    10965             assign
    10966             libthpos_chk-context.recalc-gline-num  = min(libthpos_chk-context.recalc-gline-num  + 1, libthpos_chk-context.lng)
    10967             .
    10968           end.
    10969           else do:
    10970             v-err-mess = substitute("Строка &1: &2 &3"
    10971                                     , buf_libthpos_chk-gds.line-num
    10972                                     , return-value
    10973                                     , error-status:get-message(1)
    10974                                     ).
    10975             undo main-block, retry main-block.
    10976           end.
    10977           find first buf2_libthpos_chk-gds no-lock where
    10978                     buf2_libthpos_chk-gds.doc-code = libthpos_chk-context.doc-code
    10979                 and buf2_libthpos_chk-gds.line-num > buf_libthpos_chk-gds.line-num no-error.
    10980           if available buf2_libthpos_chk-gds then do:
    10981             v-mode = "no-changes".
    10982           end.
    10983           else do:
    10984             v-mode = ''.
    10985           end.
    10986           run libthpos_sub-total  in this-procedure (
    10987                                                       input libthpos_chk-context.doc-code
    10988                                                       ,input v-mode
    10989                                                       ,output v-setted
    10990                                                       ,input-output v-st-rb
    10991                                                       ,input-output v-st-rubl
    10992                                                       ,input-output v-st-base
    10993                                                       ,input-output v-tot-doc
    10994                                                       ,input-output v-st-discnt
    10995                                                       ,output v-netto
    10996                                                       ,output v-netto-rubl
    10997                                                       ,output v-netto-base
    10998                                                       ,output v-all-discnt
    10999                                                       ,output v-all-discnt-rubl
    11000                                                       ,output v-all-discnt-base
    11001                                                       ) no-error.
    11002           if error-status:error
    11003           or not v-setted
    11004           then do:
    11005             v-err-mess = substitute("Ошибка в Подитоге после строки &1: &2 &3"
    11006                                     , buf_libthpos_chk-gds.line-num
    11007                                     , return-value
    11008                                     , error-status:get-message(1)
    11009                                     ).
    11010             undo main-block, retry main-block.
    11011           end.
    11012         end.
    11013       end.
    11014       if v-step >= 3 then do:
    11015       end.
    11016       dataset libthpos_receipt:accept-changes.
    11017     end.
    11018   end.
    11019   end procedure.
    11020   procedure libthpos_prepare-getcheck private:
    11021   define input parameter p-doc-code as character no-undo .
    11022   define variable v-err-mess as character no-undo .
    11023   define buffer buf_chk-doc for ub.chk-doc.
    11024   define buffer buf_chk-discnt for ub.chk-discnt.
    11025   define buffer buf_chk-gds-pay for ub.chk-gds-pay.
    11026   main-block:
    11027   do
    11028   on error undo main-block, retry main-block
    11029   on stop undo main-block, retry main-block
    11030   on endkey undo main-block, retry main-block
    11031   :
    11032     if retry then do:
    11033       if v-err-mess = '' then do:
    11034         v-err-mess = substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
    11035       end.
    11036       dataset libthpos_receipt:reject-changes.
    11037       return error v-err-mess.
    11038     end.
    11039     else do:
    11040       find first buf_chk-doc exclusive-lock where buf_chk-doc.doc-code = p-doc-code.
    11041       assign
    11042       buf_chk-doc.netto = 0
    11043       buf_chk-doc.tot-doc = 0
    11044       buf_chk-doc.discnt = 0
    11045       buf_chk-doc.sub-discnt = 0
    11046       buf_chk-doc.correct = yes
    11047       buf_chk-doc.doc-qnty = 0
    11048       buf_chk-doc.office = ''
    11049       .
    11050       for each buf_chk-discnt where
    11051                 buf_chk-discnt.doc-code = p-doc-code
    11052       on error  undo main-block, retry main-block
    11053       on stop   undo main-block, retry main-block
    11054       on endkey undo main-block, retry main-block
    11055       :
    11056         if buf_chk-discnt.record-type = 0 then NEXT.
    11057         if buf_chk-discnt.record-type = 4  then NEXT.
    11058         delete buf_chk-discnt.
    11059       end.
    11060       for each buf_chk-gds-pay where buf_chk-gds-pay.doc-code = p-doc-code
    11061       on error  undo main-block, retry main-block
    11062       on stop   undo main-block, retry main-block
    11063       on endkey undo main-block, retry main-block
    11064       :
    11065         delete buf_chk-gds-pay.
    11066       end.
    11067     end.
    11068   end.
    11069   end procedure.
    11070   procedure libthpos_tracking-changes private :
    11071   define input  parameter p-tbl-handle as handle no-undo .
    11072   define input  parameter p-on-off as logical   no-undo .
    11073   p-tbl-handle:tracking-changes = p-on-off.
    11074   end procedure.
    11075   procedure libthpos_undo :
    11076   define buffer buf_libthpos_chk-doc for libthpos_chk-doc.
    11077   define buffer buf_libthpos_chk-gds for libthpos_chk-gds.
    11078   define buffer buf_libthpos_chk-pay for libthpos_chk-pay.
    11079   define buffer buf_libthpos_chk-discnt for libthpos_chk-discnt.
    11080   do
    11081   on error undo, return error return-value
    11082   :
    11083     for each undo_libthpos_chk-doc:
    11084       case buffer undo_libthpos_chk-doc:handle:row-state:
    11085         when row-deleted then do:
    11086         end.
    11087         when row-modified then do:
    11088           buffer-copy undo_libthpos_chk-doc to libthpos_chk-context.
    11089         end.
    11090         when row-created then do:
    11091         end.
    11092       end.
    11093     end.
    11094     for each undo_libthpos_chk-context:
    11095       case buffer undo_libthpos_chk-context:handle:row-state:
    11096         when row-deleted then do:
    11097         end.
    11098         when row-modified then do:
    11099           buffer-copy undo_libthpos_chk-context to libthpos_chk-context.
    11100         end.
    11101         when row-created then do:
    11102         end.
    11103       end.
    11104     end.
    11105     for each undo_libthpos_chk-gds:
    11106       case buffer undo_libthpos_chk-gds:handle:row-state:
    11107         when row-deleted then do:
    11108            create buf_libthpos_chk-gds.
    11109            buffer-copy undo_libthpos_chk-gds to buf_libthpos_chk-gds.
    11110         end.
    11111         when row-modified then do:
    11112           find first buf_libthpos_chk-gds where
    11113                     buf_libthpos_chk-gds.doc-code = undo_libthpos_chk-gds.doc-code
    11114                 and buf_libthpos_chk-gds.line-num = undo_libthpos_chk-gds.line-num.
    11115           buffer-copy undo_libthpos_chk-context to libthpos_chk-context.
    11116         end.
    11117         when row-created then do:
    11118           find first buf_libthpos_chk-gds where
    11119                     buf_libthpos_chk-gds.doc-code = undo_libthpos_chk-gds.doc-code
    11120                 and buf_libthpos_chk-gds.line-num = undo_libthpos_chk-gds.line-num.
    11121            delete buf_libthpos_chk-gds.
    11122         end.
    11123       end.
    11124     end.
    11125     for each undo_libthpos_chk-pay:
    11126       case buffer undo_libthpos_chk-pay:handle:row-state:
    11127         when row-deleted then do:
    11128            create buf_libthpos_chk-pay.
    11129            buffer-copy undo_libthpos_chk-pay to buf_libthpos_chk-pay.
    11130         end.
    11131         when row-modified then do:
    11132           find first buf_libthpos_chk-pay where
    11133                     buf_libthpos_chk-pay.doc-code = undo_libthpos_chk-pay.doc-code
    11134                 and buf_libthpos_chk-pay.line-num = undo_libthpos_chk-pay.line-num.
    11135           buffer-copy undo_libthpos_chk-context to libthpos_chk-context.
    11136         end.
    11137         when row-created then do:
    11138           find first buf_libthpos_chk-pay where
    11139                     buf_libthpos_chk-pay.doc-code = undo_libthpos_chk-pay.doc-code
    11140                 and buf_libthpos_chk-pay.line-num = undo_libthpos_chk-pay.line-num.
    11141            delete buf_libthpos_chk-pay.
    11142         end.
    11143       end.
    11144     end.
    11145     for each undo_libthpos_chk-discnt:
    11146       case buffer undo_libthpos_chk-discnt:handle:row-state:
    11147         when row-deleted then do:
    11148            create buf_libthpos_chk-discnt.
    11149            buffer-copy undo_libthpos_chk-discnt to buf_libthpos_chk-discnt.
    11150         end.
    11151         when row-modified then do:
    11152           find first buf_libthpos_chk-discnt where
    11153                     buf_libthpos_chk-discnt.doc-code = undo_libthpos_chk-discnt.doc-code
    11154                 and buf_libthpos_chk-discnt.line-num = undo_libthpos_chk-discnt.line-num.
    11155           buffer-copy undo_libthpos_chk-context to libthpos_chk-context.
    11156         end.
    11157         when row-created then do:
    11158           find first buf_libthpos_chk-discnt where
    11159                     buf_libthpos_chk-discnt.doc-code = undo_libthpos_chk-discnt.doc-code
    11160                 and buf_libthpos_chk-discnt.line-num = undo_libthpos_chk-discnt.line-num.
    11161            delete buf_libthpos_chk-discnt.
    11162         end.
    11163       end.
    11164     end.
    11165   end.
    11166   end procedure.
    11167   procedure libthpos_print-dataset :
    11168   define input parameter p-forced as logical no-undo .
    11169   DEFINE VARIABLE v-today as date no-undo .
    11170   DEFINE VARIABLE v-time as integer no-undo .
    11171   do
    11172   on error undo, return error
    11173   :
    11174     if search("print-xml.xml") <> ?
    11175     or p-forced
    11176     then do:
    11177       if not available libthpos_chk-context then do:
    11178         find first libthpos_chk-context no-error.
    11179       end.
    11180       if available libthpos_chk-context then do:
    11181         libthpos_chk-context.print-copy-num = libthpos_chk-context.print-copy-num + 1.
    11182         run print-xml in this-procedure ( input (dataset libthpos_receipt:handle)
    11183                                             ,input substitute("&1_&2"
    11184                                                               ,libthpos_chk-context.doc-code
    11185                                                               ,libthpos_chk-context.print-copy-num)).
    11186        find first libthpos_chk-context.
    11187       end.
    11188       else do:
    11189         loc-print-copy-num = loc-print-copy-num + 1.
    11190         run print-xml in this-procedure ( input (dataset libthpos_receipt:handle)
    11191                                             ,input substitute("&1_&2"
    11192                                                               ,loc-print-doc-code
    11193                                                               ,loc-print-copy-num)).
    11194       end.
    11195       find first libthpos_chk-doc no-error.
    11196       run cur-time in this-procedure ( output v-today, output v-time).
    11197        run print-xml in this-procedure ( input (dataset libthpos_context:handle)
    11198                                           ,input substitute("thpos_context_&1-&2-&3_&4"
    11199                                                             , string(year(v-today), "9999")
    11200                                                             , string(month(v-today), "99")
    11201                                                             , string(day(v-today), "99")
    11202                                                             , replace(string(v-time, "HH:MM:SS"), ":", "-")
    11203                                                              )
    11204                                           ).
    11205        run print-xml in this-procedure ( input (dataset libthpos_params:handle)
    11206                                           ,input substitute("thpos_params_&1-&2-&3_&4"
    11207                                                             , string(year(v-today), "9999")
    11208                                                             , string(month(v-today), "99")
    11209                                                             , string(day(v-today), "99")
    11210                                                             , replace(string(v-time, "HH:MM:SS"), ":", "-")
    11211                                                              )
    11212                                           ).
    11213     end.
    11214   end.
    11215   end procedure.
    11216   procedure libthpos_process-sale :
    11217   define input parameter p-chk-type as integer no-undo .
    11218   define input parameter p-doc-code as character no-undo .
    11219   define variable v-log-handle as handle no-undo .
    11220   if  libthpos_context.process-sale
    11221   and lookup(string(p-chk-type), '11,111,201,206':U) = 0
    11222   and lookup(string(p-chk-type), '2,3,4,5,7':U) = 0
    11223   then do:
    11224     if not valid-handle(libthpos_context.p-log-handle) then do:
    11225   if (valid-handle(g#lib-log) <> true) then do:   run gbl/lib-log.p persistent no-error .   if error-status :error or (valid-handle(g#lib-log) <> true) then do:     message       "Error starting gbl/lib-log.p" skip       g#lib-log skip       g#lib-log :type skip       g#lib-log :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-log_get-log-handle in g#lib-log
    11226     (output  v-log-handle
    11227     ) no-error .
    11228     end.
    11229     else do:
    11230       v-log-handle = libthpos_context.p-log-handle.
    11231     end.
    11232     run str/afgetchk.p (
    11233                          input libthpos_context.parparentproc
    11234                         ,input this-procedure:handle
    11235                         ,input v-log-handle
    11236                         ,input (libthpos_context.obj-type + chr(4)  +
    11237                                string(libthpos_context.obj-code) + chr(4) +
    11238                                p-doc-code )
    11239                         ) no-error.
    11240   end.
    11241   end procedure.
