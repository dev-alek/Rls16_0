        1   block-level on error undo, throw.
        2   define input  parameter p-inkas-code          like ub.inkas.inkas-code     no-undo .
        3   define input  parameter p-mode                as character                 no-undo .
        4   define input  parameter p-status-current      like ub.inkas.status_        no-undo .
        5   define input  parameter p-flag-current        like ub.trn-doc.flag_        no-undo .
        6   define output parameter p-status_             like ub.inkas.status_        no-undo .
        7   define output parameter p-flag_               like ub.trn-doc.flag_        no-undo .
        8   define output parameter p-ask-message         as character                 no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       11   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: salegraf.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: str/salegraf.p $":U .
       14   define variable vss-description as character no-undo init "Стандартный граф переходов продаж".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define variable v-db-num like ub.db.db-num no-undo .
       76   define variable v-obj-db-num like ub.db.db-num no-undo .
       77   define variable v-host-code like ub.sysconf.host-code no-undo .
       78   define buffer buf_sysconf for ub.sysconf.
       79   define buffer buf_inkas for ub.inkas.
       80   define buffer buf_trn-doc for ub.trn-doc.
       81   define buffer buf_clients for ub.clients.
       82   define buffer bf_db for ub.db .
       83   do on error undo, return error
       84   substitute ("Ошибка при вызове программы salegraf.p:&1&2&1&3&1&4 при работе с документом &4."
       85   , chr(10)
       86   , error-status:get-message(1)
       87   , error-status:get-message(2)
       88   , return-value
       89   , p-inkas-code):
       90     if p-mode <> '<закрытие документа>':U
       91     AND p-mode <> '<открытие документа>':U
       92     AND p-mode <> '<закрытие документа на факт>':U
       93        then do:
       94        return error substitute ("Неверный режим обработки документа &1.", p-mode).
       95     end.
       96     find first buf_inkas where
       97               buf_inkas.inkas-code = p-inkas-code no-lock no-error.
       98     if not available buf_inkas then do:
       99        return error substitute ("Не найдена продажа с номером &1.", p-inkas-code).
      100     end.
      101     find first buf_trn-doc where
      102               buf_trn-doc.doc-code = p-inkas-code no-lock no-error .
      103     if not available buf_trn-doc then do:
      104       return error substitute("Не найдена накладная расхода по продаже &1", p-inkas-code).
      105     end.
      106   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      107   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      108     (output v-db-num
      109     ) no-error .
      110     if error-status:error then do:
      111       return error "Ошибка при определении номер текущей БД".
      112     end.
      113   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      115     (input  buf_inkas.obj-type
      116     ,input  buf_inkas.obj-code
      117     ,output v-obj-db-num
      118     )  .
      119     if v-db-num <> v-obj-db-num then do:
      120      return error  substitute("Нельзя изменять запись ПРОДАЖИ в БД, отличной от БД объекта продажи:&1" +
      121                               "номер продажи &6" +
      122                               "номер текущей БД &2, номер БД объекта &3&4 - &5"
      123                                , chr(10)
      124                                , v-db-num
      125                                , buf_inkas.obj-type
      126                                , buf_inkas.obj-code
      127                                , v-obj-db-num
      128                                , buf_inkas.inkas-code
      129                                ).
      130     end.
      131     find first buf_clients where buf_clients.obj-type = buf_trn-doc.cli-type and
      132                                 buf_clients.obj-code = buf_trn-doc.cli-code no-lock no-error.
      133     if not available buf_clients then do:
      134        return error substitute ("Не найден КОНТРАГЕНТ-РЕАЛИЗАЦИЯ В МАГАЗИНЕ &1 &2 для продажи &3.", buf_trn-doc.cli-type, buf_trn-doc.cli-code, buf_inkas.inkas-code).
      135     end.
      136   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      137   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      138     (input  buf_inkas.obj-type
      139     ,input  buf_inkas.obj-code
      140     ,output v-host-code
      141     )  .
      142     find first buf_sysconf where
      143                buf_sysconf.host-code = v-host-code no-error.
      144     if not available buf_sysconf then do:
      145        return error substitute ("Не найдена фирма с номером &1 для продажи &2", v-host-code, p-inkas-code).
      146     end.
      147     if not (buf_clients.obj-type = buf_sysconf.sale-type AND
      148            buf_clients.obj-code = buf_sysconf.sale-code ) then do:
      149       return error substitute ("КОНТРАГЕНТ для накладных продажи &1 = &2&3 а настройки для фирмы &4 КОНТРАГЕНТ-РЕАЛИЗАЦИЯ В МАГАЗИНЕ = &5&6."
      150                               , buf_inkas.inkas-code
      151                               , buf_trn-doc.cli-type
      152                               , buf_trn-doc.cli-code
      153                               , buf_sysconf.host-code
      154                               , buf_sysconf.sale-type
      155                               , buf_sysconf.sale-code
      156                               ).
      157     end.
      158     if buf_inkas.status_ = 'факт':U
      159     or buf_inkas.status_ = 'запрос':U
      160     then do:
      161       return error substitute ("Продажа &1 для &2&3 закрыта до статуса. &4&5" +
      162                                   "Операции с ней недопустимы."
      163                                   , buf_inkas.inkas-code
      164                                   , buf_inkas.obj-type
      165                                   , buf_inkas.obj-code
      166                                   , buf_inkas.status_
      167                                   , chr(10)
      168                                   ).
      169     end.
      170     run str/salegrfp.p (
      171                      input  buf_inkas.status_
      172                     ,input  buf_inkas.flag_
      173                     ,input  buf_trn-doc.status_
      174                     ,input  p-mode
      175                     ,output p-status_
      176                     ,output p-flag_
      177                     ,output p-ask-message
      178                     ) no-error.
      179     if error-status:error then do:
      180        return error substitute ("Ошибка:  &1"          + chr(10)
      181                                 + "по операции: &2"    + chr(10)
      182                                 + "номер документа &3" + chr(10)
      183                                 + "статус &4&5"
      184                                 ,
      185                                 return-value,
      186                                 p-mode,
      187                                 buf_inkas.inkas-code,
      188                                 buf_inkas.status_,
      189                                 string(buf_inkas.flag_, "+/")
      190                                 ).
      191     end.
      192     return ''.
      193   end.
