      255               when 'ctrasm':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val =       p-label = "Контроль ассортиментной матрицы"     p-tooltip = "Контроль ассортиментной матрицы"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      256               when 'e-eslg-e':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Оперативный балансовый отчет движения нефтепродуктов"     p-tooltip = "Оперативный балансовый отчет движения нефтепродуктов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      257               when 'prphoto':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(2256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(2256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Прайс-лист с фото товаров"     p-tooltip = "Прайс-лист с фото товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      258               when 'chkgdsfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Товарная строка чека - доп поля"     p-tooltip = "Товарная строка чека - доп поля "     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      259               when 'chkdocfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Чек - доп поля"     p-tooltip = "Чек - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      260               when 'barcodfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Бар-код - доп поля"     p-tooltip = "Бар-код - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      261                when 'UPD':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника Электронного документоборота"     p-tooltip = "Настройки справочника Электронного документоборота"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      262               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      263         otherwise do:
      264           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
      265         end.
      266       end CASE.
      267     end.
      268   end procedure.
      269   procedure uf-get :
      270     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      271     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      272     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      273     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      274     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      275     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      276     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      277     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      278     do
      279     on error undo, return error
      280     :
      281       define buffer buf_usr-flt for ubflt.usr-flt .
      282       define variable v-use-List_     as logical   no-undo .
      283       define variable v-type-List_     as character no-undo .
      284       define variable v-format-List_   as character no-undo .
      285       define variable v-use-Naim      as logical   no-undo .
      286       define variable v-type-Naim      as character no-undo .
      287       define variable v-format-Naim    as character no-undo .
      288       define variable v-use-print-graft as logical   no-undo .
      289       define variable v-use-sort-gr     as logical   no-undo .
      290       define variable v-use-type-price  as logical   no-undo .
      291       define variable v-use-type-val    as logical   no-undo .
      292       define variable v-label          as character no-undo .
      293       define variable v-tooltip        as character no-undo .
      294       define variable v-user-can-edit  as logical   no-undo .
      295       define variable v-output-display as logical   no-undo .
      296       define variable v-other          as character no-undo .
      297       run uf-name in this-procedure
      298          (input  entry(1, p-code, chr(4))
      299         ,output v-use-List_
      300         ,output v-type-List_
      301         ,output v-format-List_
      302         ,output v-use-Naim
      303         ,output v-type-Naim
      304         ,output v-format-Naim
      305         ,output v-use-print-graft
      306         ,output v-use-sort-gr
      307         ,output v-use-type-price
      308         ,output v-use-type-val
      309         ,output v-label
      310         ,output v-tooltip
      311         ,output v-user-can-edit
      312         ,output v-output-display
      313         ,output v-other
      314         ) no-error .
      315       if error-status :error then do:
      316         undo, return error return-value .
      317       end.
      318       find first buf_usr-flt no-lock where
      319                  buf_usr-flt.Call-point     = p-code AND
      320                  buf_usr-flt.user-name       = p-user-name
      321         no-error .
      322       if avail buf_usr-flt then do:
      323         assign
      324         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      325         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      326         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      327         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      328         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      329         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      330         .
      331       end.
      332       else do:
      333         assign
      334         p-List_        = (if v-use-List_       then "":U                    else ?)
      335         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      336         p-print-graft  = (if v-use-print-graft then no                      else ?)
      337         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      338         p-type-price   = (if v-use-type-price  then no                      else ?)
      339         p-type-val     = (if v-use-List_       then no                      else ?)
      340         .
      341       end.
      342     end.
      343   end procedure.
      344   procedure uf-set :
      345     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      346     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      347     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      348     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      349     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      350     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      351     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      352     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      353     do
      354     on error undo, return error
      355     :
      356       define buffer buf_usr-flt for ubflt.usr-flt .
      357       define variable v-use-List_     as logical   no-undo .
      358       define variable v-type-List_     as character no-undo .
      359       define variable v-format-List_   as character no-undo .
      360       define variable v-use-Naim      as logical   no-undo .
      361       define variable v-type-Naim      as character no-undo .
      362       define variable v-format-Naim    as character no-undo .
      363       define variable v-use-print-graft as logical   no-undo .
      364       define variable v-use-sort-gr   as logical   no-undo .
      365       define variable v-use-type-price as logical   no-undo .
      366       define variable v-use-type-val  as logical   no-undo .
      367       define variable v-tooltip        as character no-undo .
      368       define variable v-label          as character no-undo .
      369       define variable v-user-can-edit  as logical   no-undo .
      370       define variable v-output-display as logical   no-undo .
      371       define variable v-other          as character no-undo .
      372       run uf-name in this-procedure
      373         (input  entry(1, p-code, chr(4))
      374         ,output v-use-List_
      375         ,output v-type-List_
      376         ,output v-format-List_
      377         ,output v-use-Naim
      378         ,output v-type-Naim
      379         ,output v-format-Naim
      380         ,output v-use-print-graft
      381         ,output v-use-sort-gr
      382         ,output v-use-type-price
      383         ,output v-use-type-val
      384         ,output v-label
      385         ,output v-tooltip
      386         ,output v-user-can-edit
      387         ,output v-output-display
      388         ,output v-other
      389         ) no-error .
      390       if error-status :error then do:
      391         undo, return error return-value .
      392       end.
      393       find first buf_usr-flt where
      394                  buf_usr-flt.Call-point     = p-code AND
      395                  buf_usr-flt.user-name       = p-user-name
      396         no-error .
      397       if not avail buf_usr-flt then do:
      398           create buf_usr-flt .
      399           assign
      400           buf_usr-flt.call-point = p-code
      401           buf_usr-flt.user-name  = p-user-name
      402           .
      403       end.
      404       if avail buf_usr-flt then do:
      405        assign
      406        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      407        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      408        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      409        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      410        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      411        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      412       .
      413       release buf_usr-flt.
      414       end.
      415       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      416     end.
      417   end procedure.
      418   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      419   procedure grp-attr-name :
      420   do
      421     on error undo, return error
      422     :
      423     define input  parameter p-code           as character no-undo .
      424     define output parameter p-type           as character no-undo .
      425     define output parameter p-format         as character no-undo .
      426     define output parameter p-label          as character no-undo .
      427     define output parameter p-user-can-edit  as logical   no-undo .
      428     define output parameter p-output-display as logical   no-undo .
      429     define output parameter p-other          as character no-undo .
      430       case p-code :
      431               when 'gds-grp-nabor':U then do:     assign     p-label = "Набор"     p-type = 'L':U      p-format = "yes/no"     p-label = "Набор"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      432         otherwise do:
      433           undo, return error "Неизвестный атрибут группы товаров на фирме" + " " + p-code .
      434         end.
      435       end.
      436     end.
      437   end procedure.
      438   procedure grp-attr-tooltip :
      439   do
      440     on error undo, return error
      441     :
      442       define input  parameter p-code    as character no-undo .
      443       define output parameter p-tooltip as character no-undo .
      444       define output parameter p-label   as character no-undo .
      445       case p-code :
      446               when 'gds-grp-nabor':U then do:     assign     p-tooltip = "Набор - не товарные позиции"     p-label = "Набор" .   end.
      447         otherwise do:
      448               undo, return error "Неизвестный атрибут группы товаров на фирме" + " " + p-code .
      449         end.
      450       end.
      451     end.
      452   end procedure.
      453   procedure grp-attr-value :
      454   do
      455   on error undo, return error
      456   :
      457   define input  parameter p-node-code   as integer    no-undo.
      458   define input  parameter p-code        as character  no-undo.
      459   define input  parameter p-host-code   as integer    no-undo.
      460   define input  parameter p-obj-type    as character  no-undo.
      461   define input  parameter p-obj-code    as integer    no-undo.
      462   define output parameter p-value       as character  no-undo.
      463   define output parameter p-type        as character  no-undo.
      464       define variable v-format         as character no-undo .
      465       define variable v-label          as character no-undo .
      466       define variable v-user-can-edit  as logical   no-undo .
      467       define variable v-output-display as logical   no-undo .
      468       define variable v-other          as character no-undo .
      469       define buffer buf_gds-grp-attr for ub.gds-grp-attr.
      470       run grp-attr-name in this-procedure (
      471             input  p-code
      472           , output p-type
      473           , output v-format
      474           , output v-label
      475           , output v-user-can-edit
      476           , output v-output-display
      477           , output v-other
      478       ) no-error .
      479       if error-status :error
      480       then do:
      481           undo, return error return-value .
      482       end.
      483       find first buf_gds-grp-attr no-lock
      484            where buf_gds-grp-attr.node-code = p-node-code
      485              and buf_gds-grp-attr.attr-code = p-code
      486              and buf_gds-grp-attr.host-code = p-host-code
      487              and buf_gds-grp-attr.obj-type  = p-obj-type
      488              and buf_gds-grp-attr.obj-code  = p-obj-code
      489       no-error .
      490       if available buf_gds-grp-attr
      491       then do:
      492           assign
      493               p-value = buf_gds-grp-attr.attr-value
      494           .
      495       end.
      496       else do:
      497           assign
      498               p-value = if p-type = 'L':U then "no":U else ""
      499           .
      500       end.
      501   end.
      502   end procedure.
      503   procedure grp-attr-write :
      504   do
      505   on error undo, return error
      506   :
      507   define input parameter p-node-code  like ub.gds-grp-attr.node-code      no-undo.
      508   define input parameter p-code       like ub.gds-grp-attr.attr-code      no-undo.
      509   define input parameter p-host-code  as integer                          no-undo.
      510   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
      511   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
      512   define input parameter p-value      like ub.gds-grp-attr.attr-value     no-undo.
      513       define variable v-type              as character                no-undo.
      514       define variable v-format            as character                no-undo.
      515       define variable v-label             as character                no-undo.
      516       define variable v-user-can-edit     as logical                  no-undo.
      517       define variable v-output-display    as logical                  no-undo.
      518       define variable v-other             as character                no-undo.
      519       define buffer buf_gds-grp-attr for ub.gds-grp-attr .
      520       run grp-attr-name in this-procedure (
      521                         input  p-code
      522                       , output v-type
      523                       , output v-format
      524                       , output v-label
      525                       , output v-user-can-edit
      526                       , output v-output-display
      527                       , output v-other
      528       ) no-error.
      529       if error-status :error
      530       then do:
      531           undo, return error return-value.
      532       end.
      533       find first buf_gds-grp-attr exclusive-lock
      534            where buf_gds-grp-attr.node-code  = p-node-code
      535              and buf_gds-grp-attr.attr-code  = p-code
      536              and buf_gds-grp-attr.host-code  = p-host-code
      537              and buf_gds-grp-attr.obj-type   = p-obj-type
      538              and buf_gds-grp-attr.obj-code   = p-obj-code
      539       no-error.
      540       if not available buf_gds-grp-attr
      541       then do:
      542           create buf_gds-grp-attr.
      543           assign
      544                   buf_gds-grp-attr.node-code  = p-node-code
      545                   buf_gds-grp-attr.attr-code  = p-code
      546                   buf_gds-grp-attr.host-code  = p-host-code
      547                   buf_gds-grp-attr.obj-type   = p-obj-type
      548                   buf_gds-grp-attr.obj-code   = p-obj-code
      549                   buf_gds-grp-attr.attr-value = p-value
      550           .
      551       end.
      552       else do:
      553           assign
      554               buf_gds-grp-attr.attr-value = p-value
      555           .
      556       end.
      557   end.
      558   end procedure.
      559   procedure grp-attr-delete :
      560   do
      561   on error undo, return error
      562   :
      563   define input parameter p-node-code  like ub.gds-grp-attr.node-code  no-undo.
      564   define input parameter p-code       like ub.gds-grp-attr.attr-code  no-undo.
      565   define input parameter p-host-code  as integer                      no-undo.
      566   define input parameter p-obj-type   like ub.clients.obj-type        no-undo.
      567   define input parameter p-obj-code   like ub.clients.obj-code        no-undo.
      568   define output parameter p-deleted   as logical                      no-undo.
      569       define buffer buf_gds-grp-attr for ub.gds-grp-attr .
      570       define variable v-type              as character                no-undo.
      571       define variable v-format            as character                no-undo.
      572       define variable v-label             as character                no-undo.
      573       define variable v-user-can-edit     as logical                  no-undo.
      574       define variable v-output-display    as logical                  no-undo.
      575       define variable v-other             as character                no-undo.
      576       run grp-attr-name in this-procedure
      577       ( input  p-code
      578       , output v-type
      579       , output v-format
      580       , output v-label
      581       , output v-user-can-edit
      582       , output v-output-display
      583       , output v-other
      584       ) no-error .
      585       if error-status :error then do:
      586           undo, return error return-value .
      587       end.
      588       find first buf_gds-grp-attr exclusive-lock
      589            where buf_gds-grp-attr.node-code  = p-node-code
      590              and buf_gds-grp-attr.attr-code  = p-code
      591              and buf_gds-grp-attr.host-code  = p-host-code
      592              and buf_gds-grp-attr.obj-type   = p-obj-type
      593              and buf_gds-grp-attr.obj-code   = p-obj-code
      594       no-error.
      595       if not available buf_gds-grp-attr
      596       then do:
      597           assign
      598               p-deleted = no
      599           .
      600       end.
      601       else do:
      602          delete buf_gds-grp-attr.
      603          assign
      604               p-deleted = yes
      605           .
      606       end.
      607   end.
      608   end procedure.
      609   procedure grp-attr-news :
      610   do
      611   on error undo, return error
      612   :
      613       define input  parameter p-code           as character no-undo .
      614       define output parameter p-news           as logical   no-undo .
      615       case p-code :
      616               when 'gds-grp-nabor':U then do:     assign     p-news = true.   end.
      617         otherwise do:
      618           undo, return error "неизвестный атрибут товара на фирме" + " " + p-code .
      619         end.
      620       end.
      621   end.
      622   end procedure.
      623   procedure grp-attr-obj-value :
      624   do
      625   on error undo, return error
      626   :
      627   define input parameter p-node-code as integer      no-undo.
      628   define input parameter p-obj-type  as character    no-undo.
      629   define input parameter p-obj-code  as integer      no-undo.
      630   define input parameter p-attr-code as character    no-undo .
      631   define output parameter p-attr-value     as character   no-undo.
      632   define output parameter p-range     as integer      no-undo.
      633   define output parameter p-exists    as logical      no-undo.
      634   define variable v-host-code as integer      no-undo.
      635   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      636   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      637     (input  p-obj-type
      638     ,input  p-obj-code
      639     ,output v-host-code
      640     ) no-error .
      641   if error-status :error
      642   then do:
      643       message
      644         vss-workfile vss-revision vss-description
      645         skip "Не удалось найти фирму объекта"
      646         skip p-obj-type p-obj-code
      647         skip return-value
      648         skip trim(error-status :get-message(1))
      649              trim(error-status :get-message(2))
      650              trim(error-status :get-message(3))
      651              trim(error-status :get-message(4))
      652              trim(error-status :get-message(5))
      653       view-as alert-box error.
      654       undo, return error .
      655   end.
      656   define buffer buf_gds-grp-attr      for ub.gds-grp-attr.
      657   find first buf_gds-grp-attr no-lock
      658        where buf_gds-grp-attr.node-code = p-node-code
      659          and buf_gds-grp-attr.attr-code = p-attr-code
      660          and buf_gds-grp-attr.host-code = v-host-code
      661          and buf_gds-grp-attr.obj-type  = p-obj-type
      662          and buf_gds-grp-attr.obj-code  = p-obj-code
      663   no-error .
      664   if not available buf_gds-grp-attr
      665   then do:
      666       find first buf_gds-grp-attr no-lock
      667            where buf_gds-grp-attr.node-code = p-node-code
      668              and buf_gds-grp-attr.attr-code = p-attr-code
      669              and buf_gds-grp-attr.host-code = v-host-code
      670              and buf_gds-grp-attr.obj-type  = ""
      671              and buf_gds-grp-attr.obj-code  = 0
      672       no-error .
      673       if not available buf_gds-grp-attr
      674       then do:
      675           find first buf_gds-grp-attr no-lock
      676               where buf_gds-grp-attr.node-code = p-node-code
      677               and buf_gds-grp-attr.attr-code = p-attr-code
      678               and buf_gds-grp-attr.host-code = 0
      679               and buf_gds-grp-attr.obj-type  = ""
      680               and buf_gds-grp-attr.obj-code  = 0
      681           no-error .
      682           if not available buf_gds-grp-attr
      683           then do:
      684               assign
      685                   p-exists = no
      686               .
      687           end.
      688           else do:
      689               assign
      690                   p-exists = yes
      691                   p-range  = 1
      692               .
      693           end.
      694       end.
      695       else do:
      696           assign
      697               p-exists = yes
      698               p-range  = 2
      699           .
      700       end.
      701   end.
      702   else do:
      703       assign
      704           p-exists = yes
      705           p-range  = 3
      706       .
      707   end.
      708   if available buf_gds-grp-attr
      709   then do:
      710     assign
      711     p-attr-value = buf_gds-grp-attr.attr-value
      712     .
      713   end.
      714   end.
      715   end procedure.
      716   procedure ver-gds-grp-nabor :
      717   do
      718   on error undo, return error return-value
      719   :
      720   define input  parameter p-gds-code as integer   no-undo .
      721   define output parameter p-nabor as logical   no-undo .
      722   define buffer buf_goods for ub.goods.
      723   p-nabor = false .
      724   find first  buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
      725   if error-status :error then return error .
      726   define variable v-value       as character  no-undo.
      727   define variable v-type        as character  no-undo.
      728     run grp-attr-value (
      729        input   buf_goods.grp-code
      730       ,input   'gds-grp-nabor':U
      731       ,input   0
      732       ,input   ""
      733       ,input   0
      734       ,output  v-value
      735       ,output  v-type       ) no-error .
      736       if error-status :error then return error .
      737     if v-value = "yes" then p-nabor = true  .
      738   end.
      739   end procedure.
      740   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      741     define variable v-cntxt-db-num        as integer   no-undo .
      742     define variable v-cntxt-userid        as character no-undo .
      743     define variable v-cntxt-level         as character no-undo .
      744     define variable v-cntxt-host-code-obj as integer   no-undo .
      745     define variable v-cntxt-obj-type      as character no-undo .
      746     define variable v-cntxt-obj-code      as integer   no-undo .
      747     define variable v-cntxt-db-num-obj    as integer   no-undo .
      748     define variable v-cntxt-is-admin      as logical   no-undo .
      749   define temp-table temp-err no-undo  LIKE ub.rep-line
      750     field str as character
      751     field gds-code as integer
      752   index pi is primary unique  gds-code
      753   .
      754   procedure view-exept-gds :
      755   define input  parameter p-str as character no-undo .
      756   define variable loc-ok as logical   no-undo .
      757     do
      758     on error undo, return error return-value
      759     :
      760     message p-str
      761              view-as alert-box question
      762              buttons yes-no
      763              update loc-ok
      764               .
      765   if loc-ok then
      766       run gbl/tt-view.w
      767       ( input table  temp-err ).
      768     end.
      769   end procedure.
      770   procedure creat-tt :
      771     do
      772     on error undo, return error return-value
      773     :
      774       define input  parameter p-gds-code as integer   no-undo .
      775       define input  parameter p-str as character no-undo .
      776       find first temp-err where
      777                  temp-err.gds-code = p-gds-code no-error .
      778                  if available temp-err then return .
      779       if p-str  <> "" then do:
      780          create temp-err.
      781          assign
      782            temp-err.gds-code = p-gds-code
      783            temp-err.str = p-str
      784        .
      785       end.
      786     end.
      787   end procedure.
      788   define variable conf-par as character no-undo.
      789   define variable par-type as character no-undo.
      790   define buffer g-producer for ub.clients.
      791   define variable v-erase as logical   no-undo .
      792   define variable v-event-code as character no-undo .
      793   DEFINE BUTTON b-exit
      794        LABEL "&Ввод ":L
      795        SIZE 10 BY 1.
      796   DEFINE BUTTON b-quit AUTO-END-KEY
      797        LABEL "&Отмена":L
      798        SIZE 10 BY 1.
      799   DEFINE BUTTON b-help
      800        LABEL "Помо&щь":L
      801        SIZE 10 BY 1.
      802   DEFINE BUTTON r-goods
      803        IMAGE-UP FILE "btn-down-arrow"
      804        IMAGE-DOWN FILE "btn-down-arrow"
      805        IMAGE-INSENSITIVE FILE "btn-down-arrow"
      806        SIZE 3 BY .88.
      807   DEFINE BUTTON r-list
      808        IMAGE-UP FILE "btn-down-arrow"
      809        IMAGE-DOWN FILE "btn-down-arrow"
      810        IMAGE-INSENSITIVE FILE "btn-down-arrow"
      811        SIZE 3 BY .88.
      812   DEFINE BUTTON r-ext-artic
      813        IMAGE-UP FILE "btn-down-arrow"
      814        IMAGE-DOWN FILE "btn-down-arrow"
      815        IMAGE-INSENSITIVE FILE "btn-down-arrow"
      816        SIZE 3 BY .88.
      817   DEFINE FRAME d-chs-gds
      818     goods.artic AT ROW 1.5 COL 20 COLON-ALIGNED LABEL "&Артикул" VIEW-AS FILL-IN SIZE 17 BY 1
      819     r-goods AT ROW 1.5 COL 40 NO-LABEL
      820     r-list AT ROW 1.5 COL 43 NO-LABEL
      821     goods.prod-code AT ROW 2.5 COL 20 COLON-ALIGNED LABEL "&Производитель"
      822     goods.prod-type FORMAT "x(3)" AT ROW 2.5 COL 33 COLON-ALIGNED NO-LABEL VIEW-AS FILL-IN SIZE 4 BY 1
      823     ext-artic.ext-artic AT ROW 3.5 COL 20 COLON-ALIGNED LABEL "Внешний артикул" VIEW-AS FILL-IN SIZE 17 BY 1
      824     b-exit AT ROW 6 COL 12
      825     b-quit AT ROW 6 COL 26
      826     b-help AT ROW 6 COL 28
      827     SKIP(0.38)
      828     WITH VIEW-AS DIALOG-BOX
      829            SIDE-LABELS THREE-D SCROLLABLE KEEP-TAB-ORDER
      830            TITLE "Строка":L
      831            DEFAULT-BUTTON b-quit.
      832   ASSIGN FRAME d-chs-gds:SCROLLABLE = FALSE.
      833   ON CHOOSE OF b-quit IN FRAME d-chs-gds  DO:
      834   ref-list = "".
      835   END.
      836   on end-error, stop of frame d-chs-gds do:
      837   apply "choose" to b-quit in frame d-chs-gds.
      838   return no-apply.
      839   end.
      840   ON return, MOUSE-SELECT-DBLCLICK OF goods.artic, goods.prod-type, goods.prod-code, ext-artic.ext-artic  IN FRAME d-chs-gds DO:
      841   apply "choose" to b-exit in frame d-chs-gds.
      842   return no-apply.
      843   END.
      844   ON CHOOSE OF b-exit IN FRAME d-chs-gds DO:
      845   run check-goods no-error.
      846   if error-status:error then RUN run-ref.
      847   if ref-list = '' then do:   apply "entry" to goods.artic in frame d-chs-gds.   return no-apply. end. if  ref-list <> 'cb_create_gds-list_from-chs-gds' then do:   find goods where recid (goods) = integer (entry (1, ref-list)) no-lock.   assign  parartic     = goods.artic.   disp goods.prod-type goods.prod-code goods.artic with frame d-chs-gds. end. apply "go" to frame d-chs-gds.
      848   END.
      849   ON CHOOSE OF r-goods IN FRAME d-chs-gds DO:
      850   RUN run-ref.
      851   if ref-list = '' then do:   apply "entry" to goods.artic in frame d-chs-gds.   return no-apply. end. if  ref-list <> 'cb_create_gds-list_from-chs-gds' then do:   find goods where recid (goods) = integer (entry (1, ref-list)) no-lock.   assign  parartic     = goods.artic.   disp goods.prod-type goods.prod-code goods.artic with frame d-chs-gds. end. apply "go" to frame d-chs-gds.
      852   END.
      853   ON CHOOSE OF r-list IN FRAME d-chs-gds DO:
      854   RUN run-list.
      855   if ref-list = '' then do:   apply "entry" to goods.artic in frame d-chs-gds.   return no-apply. end. if  ref-list <> 'cb_create_gds-list_from-chs-gds' then do:   find goods where recid (goods) = integer (entry (1, ref-list)) no-lock.   assign  parartic     = goods.artic.   disp goods.prod-type goods.prod-code goods.artic with frame d-chs-gds. end. apply "go" to frame d-chs-gds.
      856   END.
      857   ON ctrl-cursor-down OF goods.artic, goods.prod-type, goods.prod-code IN FRAME d-chs-gds DO:
      858      RUN run-ref.
      859      if ref-list = '' then do:   apply "entry" to goods.artic in frame d-chs-gds.   return no-apply. end. if  ref-list <> 'cb_create_gds-list_from-chs-gds' then do:   find goods where recid (goods) = integer (entry (1, ref-list)) no-lock.   assign  parartic     = goods.artic.   disp goods.prod-type goods.prod-code goods.artic with frame d-chs-gds. end. apply "go" to frame d-chs-gds.
      860   END.
      861   ON alt-cursor-down OF goods.artic, goods.prod-type, goods.prod-code IN FRAME d-chs-gds DO:
      862      RUN run-list.
      863      if ref-list = '' then do:   apply "entry" to goods.artic in frame d-chs-gds.   return no-apply. end. if  ref-list <> 'cb_create_gds-list_from-chs-gds' then do:   find goods where recid (goods) = integer (entry (1, ref-list)) no-lock.   assign  parartic     = goods.artic.   disp goods.prod-type goods.prod-code goods.artic with frame d-chs-gds. end. apply "go" to frame d-chs-gds.
      864   END.
      865   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-chs-gds:PARENT eq ?
      866   THEN FRAME d-chs-gds:PARENT = ACTIVE-WINDOW.
      867   ON WINDOW-CLOSE OF FRAME d-chs-gds APPLY "END-ERROR":U TO SELF.
      868   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      869   on help of frame d-chs-gds
      870   do:
      871     run gbl/app_help.p
      872       (input this-procedure :file-name
      873       ,input ''
      874       ,input ?
      875       ) no-error.
      876     if error-status :error then do:
      877       message
      878         "Ошибка при вызове помощи"
      879         error-status :get-message(1)
      880         view-as alert-box .
      881     end.
      882   end.
      883   run minbtn-set in this-procedure .
      884   on choose of b-help in frame d-chs-gds
      885   do:
      886     apply "help":u to frame d-chs-gds .
      887   end.
      888   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      889   procedure minbtn-set :
      890       do
      891           on error undo, return error return-value
      892           :
      893           define variable ii              as integer       no-undo .
      894           define variable fh              as widget-handle no-undo .
      895           define variable hh              as widget-handle no-undo .
      896           define variable v-h             as handle        extent 4 no-undo .
      897           define variable v-name-button   as character     no-undo .
      898           define variable v-help-old-x    as decimal       no-undo .
      899           define variable v-help-old-y    as decimal       no-undo .
      900           define variable v-help-old-size as decimal       no-undo .
      901           define variable v-frame-width   as decimal       no-undo .
      902           define variable jj              as integer       no-undo .
      903           do
      904               on error undo, return error
      905               :
      906               assign
      907                   v-frame-width = frame d-chs-gds:width - 0.3
      908                   fh            = frame d-chs-gds:first-child
      909                   hh            = fh:first-child
      910                   ii            = 1
      911                   .
      912               do while valid-handle(hh):
      913                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      914                   do:
      915                       case lc(hh:name) :
      916                           when "b-help" then
      917                               do:
      918                                   hh:load-image-up("cmp/b-help.bmp":u) .
      919                                   hh:load-image-down("cmp/b-help.bmp":u) .
      920                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      921                                   hh:TOOLTIP = "Помощь" .
      922                                   v-help-old-x = hh:column .
      923                                   v-help-old-y = hh:row    .
      924                                   v-help-old-size = hh:width .
      925                                   hh:width-chars = 2.5 .
      926                               end.
      927                           when "b-print" then
      928                               do:
      929                                   hh:load-image("cmp/b-print.bmp":u) .
      930                                   hh:TOOLTIP = "Печать" .
      931                                   v-h[ii] = hh:handle .
      932                                   ii = ii + 1 .
      933                                   hh:width-chars = 3 .
      934                               end.
      935                           when "b-history" or
      936                           when "b-hist" then
      937                               do:
      938                                   hh:load-image("cmp/b-hist.bmp":u) .
      939                                   hh:TOOLTIP = "История" .
      940                                   v-h[ii] = hh:handle .
      941                                   ii = ii + 1 .
      942                                   hh:width-chars = 3 .
      943                               end.
      944                           when "b-sch" then
      945                               do:
      946                                   hh:load-image("cmp/b-sch.bmp":u) .
      947                                   hh:TOOLTIP = "Установка Фильтра" .
      948                                   v-h[ii] = hh:handle .
      949                                   ii = ii + 1 .
      950                                   hh:width-chars = 3 .
      951                               end.
      952                           when "b-hist-user" then
      953                               do:
      954                                   hh:load-image("cmp/b-hist.bmp":u) .
      955                                   hh:TOOLTIP = "История пользователя" .
      956                                   ii = ii + 1 .
      957                               end.
      958                       end case.
      959                   end.
      960                   hh = hh:next-sibling.
      961               end.
      962               b-help:column = v-frame-width - b-help:width-chars.
      963               jj = 0.
      964               repeat ii = 4 to 1 by -1 :
      965                   if valid-handle (v-h[ii] ) then
      966                   do:
      967                       jj  = jj + 1 .
      968                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      969                       v-h[ii]:row    = v-help-old-y .
      970                   end.
      971               end.
      972           end.
      973       end.
      974   end procedure.
      975   MAIN-BLOCK:
      976   DO ON ERROR   UNDO MAIN-BLOCK, return
      977      ON END-KEY UNDO MAIN-BLOCK, return:
      978   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      979     run mainmenu_getcntxt in parparentproc
      980       (output v-cntxt-db-num
      981       ,output v-cntxt-userid
      982       ,output v-cntxt-level
      983       ,output v-cntxt-host-code-obj
      984       ,output v-cntxt-obj-type
      985       ,output v-cntxt-obj-code
      986       ,output v-cntxt-db-num-obj
      987       ,output v-cntxt-is-admin
      988       ) .
      989   frame d-chs-gds:title = f-title + " -  " + 'ДОБАВЛЕНИЕ':U.
      990   empty temp-table temp-err.
      991   ENABLE
      992     goods.artic
      993     goods.prod-code
      994     goods.prod-type
      995     ext-artic.ext-artic
      996     r-goods
      997     r-list
      998     b-exit
      999     b-quit
     1000     b-help
     1001   WITH FRAME d-chs-gds.
     1002   find first clients where clients.obj-type = parcli-type and
     1003                            clients.obj-code = parcli-code no-lock no-error.
     1004   if available clients then enable ext-artic.ext-artic with frame d-chs-gds.
     1005                        else ext-artic.ext-artic:visible in frame d-chs-gds = no.
     1006   disp parartic     @ goods.artic
     1007   with frame d-chs-gds.
     1008   if input frame d-chs-gds goods.prod-type = "" or
     1009      input frame d-chs-gds goods.prod-type = ?  or
     1010      input frame d-chs-gds goods.prod-type = "?"
     1011      then
     1012      disp 'орг':U @ goods.prod-type with frame d-chs-gds.
     1013   WAIT-FOR GO OF FRAME d-chs-gds focus goods.artic.
     1014   END.
     1015   RUN disable_UI.
     1016   PROCEDURE disable_UI :
     1017     HIDE FRAME d-chs-gds.
     1018   END PROCEDURE.
     1019   PROCEDURE run-ref:
     1020   define variable v-stat as character no-undo init ?.
     1021   define variable v-list as character no-undo init ?.
     1022   define variable v-prod-type like ub.clients.obj-type no-undo .
     1023   define variable v-prod-code like ub.clients.obj-code no-undo .
     1024   if can-find (clients where clients.obj-type = input frame d-chs-gds goods.prod-type
     1025                                    and clients.obj-code = input frame d-chs-gds goods.prod-code no-lock) then do:
     1026     find g-producer where
     1027          g-producer.obj-type = input frame d-chs-gds goods.prod-type
     1028      and g-producer.obj-code = input frame d-chs-gds goods.prod-code no-lock.
     1029     v-list = "производитель".
     1030   end.
     1031   else
     1032   v-list = 'все':U.
     1033   v-stat = 'текущие':U.
     1034   run ref/gds-ref.p
     1035     ( input parparentproc
     1036       ,input "b-sel,b-mark,b-add"
     1037       ,input v-stat
     1038       ,input v-list
     1039       ,input p-cond
     1040     ,input ?
     1041     ,input ?
     1042     ,input (if available g-producer then g-producer.obj-type else ?)
     1043     ,input (if available g-producer then g-producer.obj-code else ?)
     1044     ,input p-curr-obj-type
     1045     ,input p-curr-obj-code
     1046     ,input ?
     1047     ,output ref-list).
     1048   define variable new-ref-list as character no-undo init "" .
     1049   define variable i as integer   no-undo .
     1050   define variable v-erase-ass as logical   no-undo .
     1051   repeat i = 1 to num-entries (ref-list) :
     1052     find first goods where recid (goods) = integer (entry (i, ref-list)) no-lock  .
     1053       run ver-gds (goods.gds-code, output v-erase) .
     1054       run creat-tt (goods.gds-code , (if v-erase = true then return-value else "") ) .
     1055       run ver-assort-polit (INPUT goods.gds-code, output v-erase-ass)  .
     1056       run creat-tt (goods.gds-code , (if v-erase-ass = true then return-value else "")) .
     1057       if v-erase = false and v-erase-ass = false then do:
     1058          new-ref-list = new-ref-list + min (",", new-ref-list) + string (recid (goods)).
     1059       end.
     1060   end.
     1061   if num-entries (ref-list) <> num-entries (new-ref-list) then
     1062   run view-exept-gds ( substitute("Не все отмеченные позиции вошли в список !&1Просмотреть товары не вошедшие в список ?", chr(10))) .
     1063   ref-list = new-ref-list .
     1064   run uf-get in this-procedure(
     1065       input  'gds-ref-p':U
     1066       ,input  v-cntxt-userid
     1067       ,output v-uf-List_
     1068       ,output v-uf-Naim
     1069       ,output v-uf-print-graft
     1070       ,output v-uf-sort-gr
     1071       ,output v-uf-type-price
     1072       ,output v-uf-type-val
     1073   )  no-error.
     1074   if not error-status:error
     1075   and num-entries(v-uf-List_, chr(4)) = 8
     1076   then do:
     1077     assign
     1078     v-list       = entry(2, v-uf-List_, chr(4))
     1079     v-prod-type  = entry(6, v-uf-List_, chr(4))
     1080     v-prod-code  = integer(entry(7, v-uf-List_, chr(4)))
     1081     no-error
     1082     .
     1083     if not error-status:error and v-list = 'Производитель':U then do:
     1084       find first g-producer no-lock where
     1085                 g-producer.obj-type = v-prod-type
     1086             AND g-producer.obj-code = v-prod-code no-error .
     1087     end.
     1088   end.
     1089   END PROCEDURE.
     1090   PROCEDURE run-list:
     1091   define variable v-f as logical   no-undo init false .
     1092   define variable v-erase-ass as logical   no-undo .
     1093   define variable v-host-code like ub.sysconf.host-code no-undo .
     1094   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1095   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1096     (input  p-curr-obj-type
     1097     ,input  p-curr-obj-code
     1098     ,output v-host-code
     1099     )  .
     1100   run str/gds-list.w (
     1101                        input parparentproc
     1102                      , input v-host-code
     1103                      , input p-curr-obj-type
     1104                      , input p-curr-obj-code).
     1105   ref-list = ''.
     1106   v-f = false  .
     1107   FOR EACH gds-list NO-LOCK:
     1108       run ver-gds (gds-list.gds-code, output v-erase) .
     1109       run creat-tt (gds-list.gds-code , (if v-erase = true then return-value  else "")) .
     1110       find first goods where goods.artic     = gds-list.artic     and
     1111                              goods.prod-code = gds-list.prod-code and
     1112                              goods.prod-type = gds-list.prod-type
     1113                              no-lock.
     1114       run ver-assort-polit (gds-list.gds-code, output v-erase-ass)  .
     1115       run creat-tt (gds-list.gds-code , (if v-erase-ass = true then return-value else "")) .
     1116       if v-erase = false and v-erase-ass = false  then do:
     1117          if this-procedure:instantiating-procedure:get-signature("cb_create_gds-list_from-chs-gds") <> "" then do:
     1118            run cb_create_gds-list_from-chs-gds in (this-procedure:instantiating-procedure) ( input (buffer gds-list:handle)).
     1119            ref-list = "cb_create_gds-list_from-chs-gds":U.
     1120          end.
     1121          else do:
     1122            ref-list = ref-list + min (",", ref-list) + string (recid (goods)).
     1123          end.
     1124       end.
     1125       else do:
     1126         v-f = true .
     1127         DELETE gds-list.
     1128       end.
     1129   END.
     1130   if v-f = true then do:
     1131     run view-exept-gds ( substitute("Не все отмеченные позиции вошли в список !&1Просмотреть товары не вошедшие в список ?", chr(10))) .
     1132   end.
     1133   END PROCEDURE.
     1134   PROCEDURE check-goods :
     1135   def buffer gds-b for goods.
     1136   def buffer buf_ext-artic for ub.ext-artic.
     1137   ref-list = ''.
     1138   if ext-artic.ext-artic:sensitive in frame d-chs-gds = yes and
     1139      input frame d-chs-gds ext-artic.ext-artic <> ""        and
     1140      input frame d-chs-gds ext-artic.ext-artic <> "?"       and
     1141      input frame d-chs-gds ext-artic.ext-artic <> ?         then do:
     1142      find first ext-artic where ext-artic.cli-type    = parcli-type
     1143                             and ext-artic.cli-code    = parcli-code
     1144                             and ext-artic.ext-artic   = input frame d-chs-gds ext-artic.ext-artic
     1145                             and ext-artic.status_    <> 'удаленные':U
     1146                             no-lock no-error.
     1147      if available ext-artic then do:
     1148         find first buf_ext-artic where buf_ext-artic.cli-type  =  parcli-type
     1149                                    and buf_ext-artic.cli-code  =  parcli-code
     1150                                    and buf_ext-artic.ext-artic =  ext-artic.ext-artic
     1151                                    and buf_ext-artic.status_   <> 'удаленные':U
     1152                                    and buf_ext-artic.gds-code  <> ext-artic.gds-code
     1153         no-lock no-error .
     1154         if available ( buf_ext-artic ) then do:
     1155           message "С внешним артикулом :" input frame d-chs-gds ext-artic.ext-artic
     1156                           "связано несколько товаров." skip (2)
     1157                           "Укажите Производителя или выберите товар из справочника.".
     1158           apply "entry" to goods.prod-code in frame d-chs-gds.
     1159           return.
     1160         end.
     1161         find first gds-b where gds-b.gds-code = ext-artic.gds-code no-lock no-error .
     1162         if not available gds-b then do:
     1163           message "Не могу найти товар связанный с внешним артикулом " ext-artic.ext-artic view-as alert-box information .
     1164           apply "entry" to goods.prod-code in frame d-chs-gds.
     1165           return.
     1166         end.
     1167         display gds-b.artic     @ goods.artic
     1168                 gds-b.prod-type @ goods.prod-type
     1169                 gds-b.prod-code @ goods.prod-code
     1170                 with frame d-chs-gds.
     1171      end.
     1172      else do:
     1173         message "Неправильный внешний артикул!" view-as alert-box information.
     1174         display "" @ ext-artic.ext-artic with frame d-chs-gds.
     1175         apply "entry" to goods.prod-code in frame d-chs-gds.
     1176         return .
     1177      end.
     1178   end.
     1179   if input frame d-chs-gds goods.artic = '' then return error.
     1180   find first goods where goods.artic  = input frame d-chs-gds goods.artic no-lock no-error.
     1181   if not available goods then do:
     1182     message "Неправильный Артикул - такого товара нет.".
     1183     apply "entry" to goods.artic in frame d-chs-gds.
     1184     return.
     1185   end.
     1186   find first gds-b where gds-b.artic  = input frame d-chs-gds goods.artic
     1187                      and recid (gds-b) <> recid (goods)
     1188                      and gds-b.stts = 0 no-lock no-error.
     1189   if input frame d-chs-gds goods.prod-code <> 0 then do:
     1190     find first goods where goods.prod-code   = input frame d-chs-gds goods.prod-code
     1191                        and  goods.artic      = input frame d-chs-gds goods.artic no-lock no-error.
     1192     if not available goods then do:
     1193       message "Неправильный Код производителя - такого товара нет.".
     1194       apply "entry" to goods.prod-code in frame d-chs-gds.
     1195       return.
     1196     end.
     1197     find first gds-b where gds-b.artic     = input frame d-chs-gds goods.artic
     1198                        and gds-b.prod-code = input frame d-chs-gds goods.prod-code
     1199                        and recid (gds-b) <> recid (goods)
     1200                        and gds-b.stts = 0 no-lock no-error.
     1201   end.
     1202   else do:
     1203     if available gds-b then do:
     1204       if available g-producer then
     1205         find goods where goods.prod-type = g-producer.obj-type
     1206                              and  goods.prod-code = g-producer.obj-code
     1207                              and  goods.artic          = input frame d-chs-gds goods.artic no-lock no-error.
     1208       if not available g-producer or (available g-producer and not available goods) then do:
     1209         message "С артикулом :" input frame d-chs-gds goods.artic
     1210                         "несколько товаров." skip (2)
     1211                         "Укажите Производителя или выберите товар из справочника.".
     1212         apply "entry" to goods.prod-code in frame d-chs-gds.
     1213         return.
     1214       end.
     1215     end.
     1216   end.
     1217   if input frame d-chs-gds goods.prod-code <> 0  and
     1218      input frame d-chs-gds goods.prod-type <> "" then do:
     1219      find goods where goods.prod-type = input frame d-chs-gds goods.prod-type and
     1220                      goods.prod-code = input frame d-chs-gds goods.prod-code and
     1221                      goods.artic     = input frame d-chs-gds goods.artic no-lock no-error.
     1222      if not available goods then do:
     1223       message "Неправильный Тип производителя - такого товара нет.".
     1224       apply "entry" to goods.prod-type in frame d-chs-gds.
     1225       return.
     1226      end.
     1227   end.
     1228   else do:
     1229     if available gds-b then do:
     1230       if available g-producer then
     1231         find goods where goods.prod-type = g-producer.obj-type and
     1232                          goods.prod-code = g-producer.obj-code and
     1233                          goods.artic     = input frame d-chs-gds goods.artic no-lock no-error.
     1234       if not available g-producer or (available g-producer and not available goods) then do:
     1235         message "С артикулом :" input frame d-chs-gds goods.artic
     1236                         "несколько товаров." skip (2)
     1237                         "Укажите Производителя или выберите товар из справочника.".
     1238         apply "entry" to goods.prod-type in frame d-chs-gds.
     1239         return.
     1240       end.
     1241     end.
     1242   end.
     1243   run ver-gds ( goods.gds-code, output v-erase) no-error .
     1244   if v-erase = true then do:
     1245         message "Это не товарная позиция - имеет атрибут НАБОР !!!"
     1246         view-as alert-box error .
     1247         apply "entry" to goods.artic in frame d-chs-gds.
     1248         return.
     1249   end.
     1250   run ver-assort-polit (goods.gds-code, output v-erase).
     1251   if v-erase = true then do:
     1252         message return-value view-as alert-box error .
     1253         apply "entry" to goods.artic in frame d-chs-gds.
     1254         return.
     1255   end.
     1256   ref-list = string (recid (goods)).
     1257   END PROCEDURE.
     1258   procedure ver-gds :
     1259    do
     1260    on error undo, return error return-value
     1261    :
     1262   define input  parameter p-gds-code as integer   no-undo .
     1263   define output parameter  v-nabor   as logical   no-undo .
     1264   v-nabor = false .
     1265     if not ( p-list-mode begins 'is-flor':U ) then do:
     1266       run ver-gds-grp-nabor( input p-gds-code, output v-nabor) .
     1267     end.
     1268     else do:
     1269       if  p-stat <> 'запрос':U then run ver-gds-grp-nabor( input p-gds-code, output v-nabor) .
     1270     end.
     1271      if v-nabor then return "Это не товарная позиция - имеет атрибут НАБОР !!!" .
     1272   end.
     1273   end procedure.
     1274   procedure ver-assort-polit :
     1275   define input  parameter p-gds-code as integer   no-undo .
     1276   define output parameter  v-del   as logical   no-undo .
     1277   define variable v-ok as logical   no-undo .
     1278   define variable v-mess as character no-undo .
     1279     do
     1280     on error undo, return error return-value
     1281     :
     1282   v-del = false .
     1283   if lookup (parext-doc-type ,
     1284             'vt':U              + "," +
     1285             'ap':U   + "," +
     1286             'pc':U + ","  +
     1287             'mp':U + ","  +
     1288             'vp':U         + "," +
     1289             'we':U        + "," +
     1290             'wm':U         + "," +
     1291             'es':U   + "," +
     1292             're':U    + "," +
     1293             'ep':U + "," +
     1294             'rv':U  + "," +
     1295             'eo':U + "," +
     1296             'io':U ) > 0  then return .
     1297   if parext-doc-type = ? then return .
     1298   if p-stat = 'запрос':U and
     1299      parext-doc-type = 'ee':U and
     1300      ( p-list-mode begins 'is-flor':U )
     1301      then return .
     1302       if p-curr-obj-type = 'маг':U or p-curr-obj-type = 'скл':U then do:
     1303        v-event-code = substitute("&1-" , parext-doc-type ) .
     1304        if parcli-type = 'маг':U or parcli-type = 'скл':U then do:
     1305        define variable v-c-host-code as integer   no-undo .
     1306   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1307   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1308     (input  parcli-type
     1309     ,input  parcli-code
     1310     ,output v-c-host-code
     1311     )  .
     1312       if parhost-code <> v-c-host-code then v-event-code = substitute("mf_&1-" , parext-doc-type ) .
     1313          else v-event-code = substitute("&1-" , parext-doc-type ) .
     1314       end.
     1315   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1316   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run goassizt in g#library2
     1317     (input  v-event-code
     1318     ,input  p-gds-code
     1319     ,input  p-curr-obj-type
     1320     ,input  p-curr-obj-code
     1321     ,input  true
     1322     ,output v-ok
     1323     ,output v-mess
     1324     ) .
     1325         if v-ok = false then do:
     1326           v-del = true .
     1327           return v-mess .
     1328         end.
     1329       end.
     1330     if parext-doc-type <> 'ie':U and
     1331        parext-doc-type <> 'iv':U and
     1332       ( parcli-type = 'маг':U or parcli-type = 'скл':U) then do:
     1333        define variable v-ot-host-code as integer   no-undo .
     1334   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1335   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1336     (input  parcli-type
     1337     ,input  parcli-code
     1338     ,output v-ot-host-code
     1339     )  .
     1340       if parhost-code <> v-ot-host-code
     1341          then v-event-code = substitute("cli_mf_&1-" , parext-doc-type ) .
     1342          else v-event-code = substitute("cli_&1-" , parext-doc-type ) .
     1343   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1344   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run goassizt in g#library2
     1345     (input  v-event-code
     1346     ,input  p-gds-code
     1347     ,input  parcli-type
     1348     ,input  parcli-code
     1349     ,input  true
     1350     ,output v-ok
     1351     ,output v-mess
     1352     ) .
     1353       if v-ok = false then do:
     1354          v-del = true .
     1355          return v-mess .
     1356       end.
     1357     end.
     1358     end.
     1359   end procedure.
