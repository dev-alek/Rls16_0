        1   define input        parameter parparentproc as widget-handle no-undo .
        2   define input        parameter p-curr-obj-type like ub.clients.obj-type no-undo .
        3   define input        parameter p-curr-obj-code like ub.clients.obj-code no-undo .
        4   define input        parameter p-list-mode  as character no-undo .
        5   define input        parameter p-stat       as character no-undo .
        6   define input        parameter f-title      as   character no-undo.
        7   define input        parameter p-cond       as   character no-undo .
        8   define input        parameter parcli-type  like trn-doc.cli-type   no-undo.
        9   define input        parameter parcli-code  like trn-doc.cli-code   no-undo.
       10   define input        parameter parhost-code like trn-doc.host-code  no-undo.
       11   define input        parameter parext-doc-type as character no-undo .
       12   define input-output parameter parartic     like doc-line.artic     no-undo.
       13   define output       parameter ref-list as character no-undo.
       14   define variable vss-revision    as character no-undo init "$Revision$":u .
       15   define variable vss-author      as character no-undo init "$Author$":u .
       16   define variable vss-date        as character no-undo init "$Date$":u .
       17   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       18   define variable vss-archive     as character no-undo init "$Archive$":u .
       19   define variable vss-description as character no-undo init "Окно выбора товара" .
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38       assign
       39         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6':u,f-title,p-cond,parcli-type,parcli-code,parhost-code,parartic)
       40       .
       41   end procedure.
       42   define new global shared variable g#vssrevis-logger as handle    no-undo .
       43   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       44   define variable v-vssrevis-logger                   as handle    no-undo .
       45   procedure vss-logevent :
       46     define input  parameter p-extra-paramters as character no-undo .
       47     define variable v-vssrevis-parameters as character no-undo .
       48     do
       49     on error undo, return error return-value
       50     :
       51       if  valid-handle(v-vssrevis-logger)
       52       and v-vssrevis-logger :get-signature("logevent") <> ""
       53       then do:
       54         run vss-get-parameters in this-procedure
       55           (output v-vssrevis-parameters
       56           ).
       57         run logevent in v-vssrevis-logger
       58           (input vss-workfile
       59           ,input vss-revision
       60           ,input v-vssrevis-parameters
       61           ,input p-extra-paramters
       62           ).
       63       end.
       64     end.
       65   end procedure.
       66   assign
       67     v-vssrevis-logger = g#vssrevis-logger
       68   .
       69   if  valid-handle(v-vssrevis-logger)
       70   and v-vssrevis-logger :get-signature("logevent") <> ""
       71   then do:
       72     assign
       73       v-vssrevis-logevent = true
       74     .
       75     run vss-logevent in this-procedure (input vss-description) .
       76   end.
       77   define new global shared variable g#language as character no-undo .
       78   if g#language <> '' and g#language <> 'rus':U then do:
       79     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       80   end.
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   define new shared temp-table gds-list no-undo like ub.goods
       83     field qnty   as decimal
       84     field to-del as logical
       85     field order-num as integer
       86     field to-sel as logical
       87     field promo-code as character
       88     field ActionId  as int64
       89     field db-num as integer
       90     index art  is primary unique artic prod-type prod-code
       91     index code is         unique gds-code
       92     index oi order-num
       93     index isel to-sel
       94     .
       95   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       96   define  new shared  temp-table gds-list-hist no-undo
       97   field list-table as character
       98   field id as integer
       99   field line as integer
      100   field hist-mode as character
      101   field des as character
      102   field num-recs as integer
      103   field option_ as character
      104   field item_ as character
      105   field status_ as character
      106   field num-add as integer
      107   field num-ignored as integer
      108   field done as logical
      109   field err_ as logical
      110   field err-mes as character
      111   index pi is primary
      112   id
      113   line
      114   index isdone
      115   done
      116   .
      117   define new global shared variable g#library  as handle no-undo .
      118   define new global shared variable g#library2 as handle no-undo .
      119   procedure proc-alt-shift-f2:
      120     if not ibs.th.gbl.gbl-var:rcode
      121   then
      122     run gbl\inidebug.p .
      123   end.
      124   procedure proc-alt-shift-f3:
      125     run gbl/prvssinf.p
      126       ( input this-procedure
      127       ) .
      128   end.
      129   define variable v-inform-launched as logical no-undo initial false .
      130   procedure proc-alt-shift-f4:
      131     define variable v-action as character no-undo .
      132     if v-inform-launched = false then do:
      133       assign
      134         v-inform-launched = true
      135       .
      136       run gbl/d-inform.w
      137         (  input self
      138         ,  input this-procedure
      139         , output v-action
      140         ) no-error .
      141       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      142       assign
      143         v-inform-launched = false
      144       .
      145     end.
      146   end.
      147   procedure proc-alt-f1:
      148     run gbl/corrhelp.p
      149       (input this-procedure
      150       ) .
      151   end .
      152   on alt-shift-f2 anywhere do:
      153     run proc-alt-shift-f2.
      154   end.
      155   on alt-shift-f3 anywhere do:
      156     run proc-alt-shift-f3 in this-procedure .
      157   end.
      158   on alt-shift-f4 anywhere do:
      159     run proc-alt-shift-f4 in this-procedure.
      160   end.
      161   on alt-f1 anywhere do:
      162     run proc-alt-f1 in this-procedure .
      163   end.
      164   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      165   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
      166   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
      167   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      168   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      169   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
      170   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
      171   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
      172   procedure uf-name :
      173     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      174     define output parameter p-use-List_     as logical   no-undo .
      175     define output parameter p-type-List_     as character no-undo .
      176     define output parameter p-format-List_   as character no-undo .
      177     define output parameter p-use-Naim      as logical   no-undo .
      178     define output parameter p-type-Naim      as character no-undo .
      179     define output parameter p-format-Naim    as character no-undo .
      180     define output parameter p-use-print-graft as logical   no-undo .
      181     define output parameter p-use-sort-gr   as logical   no-undo .
      182     define output parameter p-use-type-price as logical   no-undo .
      183     define output parameter p-use-type-val  as logical   no-undo .
      184     define output parameter p-label          as character no-undo .
      185     define output parameter p-tooltip        as character no-undo .
      186     define output parameter p-user-can-edit  as logical   no-undo .
      187     define output parameter p-output-display as logical   no-undo .
      188     define output parameter p-other          as character no-undo .
      189     do
      190     on error undo, return error
      191     :
      192       case p-code :
      193               when 'cli-all-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника клиентов"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника клиентов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      194               when 'oldscode':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника неиспользуемых весовых кодов"     p-tooltip = "Настройки справочника неиспользуемых весовых кодов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      195               when 'gds-ref-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(8)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = yes      p-label = "Параметры вызова справочника товаров"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      196               when 'gds-grp-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника групп товаров"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника групп товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      197               when 'fbr-gds-grp-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника групп блюд"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника групп блюд"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      198               when 'cli-grp-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника групп клиентов"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника групп клиентов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      199               when 'findoci-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова карточки платежа"     p-tooltip = "Параметры по умолчанию, используемые для вызова карточки платежа"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
