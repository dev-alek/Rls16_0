        1   DEFINE BUFFER buf_c-wth-line FOR ub.c-wth-line.
        2   DEFINE BUFFER buf_wealth FOR ub.wealth.
        3   DEFINE TEMP-TABLE tt-c-wth-line NO-UNDO LIKE ub.c-wth-line.
        4   define input parameter parparentproc as widget-handle no-undo .
        5   DEFINE TEMP-TABLE tt-par-dtl NO-UNDO LIKE ub.wth-par
        6   FIELD q-ty-doc     AS   DEC FORM     ">,>>>,>>>,>>>":U    COLUMN-LABEL "Кол-во по!документу"
        7   FIELD q-ty-fact    AS   DEC FORM     ">,>>>,>>>,>>>":U    COLUMN-LABEL "Количество!факт"
        8   FIELD doc-sum      like ub.wth-line.doc-sum FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по!документу"
        9   FIELD fact-sum     like ub.wth-line.doc-sum FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма!факт"
       10   FIELD sum-gds-rubl like ub.wth-line.sum-gds-rubl  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по связ.!товарам ()"
       11   FIELD sum-gds-base like ub.wth-line.sum-gds-base  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по связ.!товарам (баз.вал.)"
       12   FIELD price-rubl   like ub.wth-line.price-rubl  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Цена товара!()"
       13   FIELD price-base   like ub.wth-line.price-base  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Цена товара!(баз.вал.)"
       14   FIELD w-p-code     like ub.wth-dtl.w-p-code
       15   FIELD doc-code     like ub.wth-dtl.doc-code
       16   FIELD gds-code     like ub.wth-gds.gds-code
       17   INDEX tt-pi    IS   PRIMARY UNIQUE par-code  w-p-code doc-code  wth-code
       18   INDEX tt-i1                        par-feat par-unit par-val
       19   INDEX tt-i2                        doc-sum  q-ty-doc
       20    .
       21   define input parameter par-mode as character no-undo .
       22   define input parameter pardoc-rec as recid no-undo.
       23   define input parameter par-current-w-p-code like ub.c-wth-line.w-p-code no-undo.
       24   define input parameter par-out-w-p-code like ub.c-wth-line.out-code no-undo.
       25   define input-output parameter parline-rec as recid no-undo.
       26   define input parameter pardoc-type like ub.c-wth-doc.doc-type no-undo .
       27   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       28   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       29   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       30   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       31   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
       32   define variable vss-description AS CHAR NO-UNDO INIT "Добавление, изменение, просмотр истории строки документа МЦ (не инвентаризация)":U.
       33   procedure vss-get-info :
       34     define output parameter p-vss-revision    like vss-revision    no-undo .
       35     define output parameter p-vss-author      like vss-author      no-undo .
       36     define output parameter p-vss-date        like vss-date        no-undo .
       37     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       38     define output parameter p-vss-archive     like vss-archive     no-undo .
       39     define output parameter p-vss-description like vss-description no-undo .
       40     assign
       41       p-vss-revision    = vss-revision
       42       p-vss-author      = vss-author
       43       p-vss-date        = vss-date
       44       p-vss-workfile    = vss-workfile
       45       p-vss-archive     = vss-archive
       46       p-vss-description = vss-description
       47     .
       48   end procedure.
       49   procedure vss-get-parameters :
       50     define output parameter p-vss-parameters as character no-undo .
       51   end procedure.
       52   define new global shared variable g#vssrevis-logger as handle    no-undo .
       53   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       54   define variable v-vssrevis-logger                   as handle    no-undo .
       55   procedure vss-logevent :
       56     define input  parameter p-extra-paramters as character no-undo .
       57     define variable v-vssrevis-parameters as character no-undo .
       58     do
       59     on error undo, return error return-value
       60     :
       61       if  valid-handle(v-vssrevis-logger)
       62       and v-vssrevis-logger :get-signature("logevent") <> ""
       63       then do:
       64         run vss-get-parameters in this-procedure
       65           (output v-vssrevis-parameters
       66           ).
       67         run logevent in v-vssrevis-logger
       68           (input vss-workfile
       69           ,input vss-revision
       70           ,input v-vssrevis-parameters
       71           ,input p-extra-paramters
       72           ).
       73       end.
       74     end.
       75   end procedure.
       76   assign
       77     v-vssrevis-logger = g#vssrevis-logger
       78   .
       79   if  valid-handle(v-vssrevis-logger)
       80   and v-vssrevis-logger :get-signature("logevent") <> ""
       81   then do:
       82     assign
       83       v-vssrevis-logevent = true
       84     .
       85     run vss-logevent in this-procedure (input vss-description) .
       86   end.
       87   define new global shared variable g#language as character no-undo .
       88   if g#language <> '' and g#language <> 'rus':U then do:
       89     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       90   end.
       91   procedure proc-alt-shift-f2:
       92     if not ibs.th.gbl.gbl-var:rcode
       93   then
       94     run gbl\inidebug.p .
       95   end.
       96   procedure proc-alt-shift-f3:
       97     run gbl/prvssinf.p
       98       ( input this-procedure
       99       ) .
      100   end.
      101   define variable v-inform-launched as logical no-undo initial false .
      102   procedure proc-alt-shift-f4:
      103     define variable v-action as character no-undo .
      104     if v-inform-launched = false then do:
      105       assign
      106         v-inform-launched = true
      107       .
      108       run gbl/d-inform.w
      109         (  input self
      110         ,  input this-procedure
      111         , output v-action
      112         ) no-error .
      113       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      114       assign
      115         v-inform-launched = false
      116       .
      117     end.
      118   end.
      119   procedure proc-alt-f1:
      120     run gbl/corrhelp.p
      121       (input this-procedure
      122       ) .
      123   end .
      124   on alt-shift-f2 anywhere do:
      125     run proc-alt-shift-f2.
      126   end.
      127   on alt-shift-f3 anywhere do:
      128     run proc-alt-shift-f3 in this-procedure .
      129   end.
      130   on alt-shift-f4 anywhere do:
      131     run proc-alt-shift-f4 in this-procedure.
      132   end.
      133   on alt-f1 anywhere do:
      134     run proc-alt-f1 in this-procedure .
      135   end.
      136   define variable vardoc-code like ub.c-wth-doc.doc-code no-undo.
      137   define variable varchip-num like ub.c-wth-doc.chip-num no-undo.
      138   define variable varcorr-user-db-num like ub.c-wth-doc.corr-user-db-num no-undo.
      139   define variable lock-line as logical no-undo.
      140   define variable locked-wth as logical no-undo .
      141   DEFINE BUTTON B-dtl
      142        LABEL "&Номиналы"
      143        SIZE 10 BY 1.
      144   DEFINE BUTTON B-Help
      145        LABEL "Помо&щь"
      146        SIZE 10 BY 1
      147        BGCOLOR 8 .
      148   DEFINE BUTTON B-next
      149        LABEL "&>>"
      150        SIZE 4 BY 1.
      151   DEFINE BUTTON B-prev
      152        LABEL "&<<"
      153        SIZE 4 BY 1.
      154   DEFINE BUTTON b-quit AUTO-END-KEY
      155        LABEL "&Выход"
      156        SIZE 10 BY 1
      157        BGCOLOR 8 .
      158   DEFINE VARIABLE T-dtl AS LOGICAL INITIAL no
      159        LABEL "Расшифровка суммы"
      160        VIEW-AS TOGGLE-BOX
      161        SIZE 21.5 BY 1 NO-UNDO.
      162   DEFINE QUERY QUERY-lines FOR
      163         buf_c-wth-line SCROLLING.
      164   DEFINE FRAME Dialog-Frame
      165        b-quit AT ROW 1 COL 1
      166        B-dtl AT ROW 1 COL 11.5
      167        B-prev AT ROW 1 COL 37
      168        B-next AT ROW 1 COL 41
      169        B-Help AT ROW 1 COL 54.9
      170        T-dtl AT ROW 6.27 COL 1.5
      171        ub.wealth.wth-name AT ROW 2.77 COL 35 COLON-ALIGNED NO-LABEL
      172              VIEW-AS TEXT
      173             SIZE 32 BY 1
      174             FGCOLOR 4
      175        tt-c-wth-line.wth-code AT ROW 3 COL 22.3 COLON-ALIGNED
      176             LABEL "Материальная ценность"
      177              VIEW-AS TEXT
      178             SIZE 12 BY .67
      179        tt-c-wth-line.doc-sum AT ROW 4.27 COL 22 COLON-ALIGNED
      180             LABEL "Кол-во движения"
      181              VIEW-AS TEXT
      182             SIZE 13.5 BY .67
      183             FGCOLOR 4
      184        tt-c-wth-line.sum-gds-rubl AT ROW 4.27 COL 68 COLON-ALIGNED WIDGET-ID 264
      185             LABEL "Сумма по тов. (abbr_rubl)" FORMAT "->,>>>,>>>,>>9.99"
      186              VIEW-AS TEXT
      187             SIZE 16 BY .67
      188             FGCOLOR 4
      189        tt-c-wth-line.fact-sum AT ROW 5.5 COL 22 COLON-ALIGNED
      190             LABEL "Количество факт"
      191              VIEW-AS TEXT
      192             SIZE 13.5 BY .67
      193             FGCOLOR 4
      194        tt-c-wth-line.sum-gds-base AT ROW 5.5 COL 68 COLON-ALIGNED WIDGET-ID 262
      195             LABEL "Сумма по тов. (баз.вал.)" FORMAT "->,>>>,>>>,>>9.99"
      196              VIEW-AS TEXT
      197             SIZE 14 BY .67
      198             FGCOLOR 4
      199        SPACE(8.74) SKIP(1.20)
      200       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      201            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      202            TITLE "Строка удаленного документа движения МЦ"
      203            CANCEL-BUTTON b-quit.
      204   ASSIGN
      205          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      206          FRAME Dialog-Frame:HIDDEN           = TRUE.
      207   ASSIGN
      208          tt-c-wth-line.sum-gds-base:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      209   ASSIGN
      210          tt-c-wth-line.sum-gds-rubl:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      211   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      212   DO:
      213     APPLY "END-ERROR":U TO SELF.
      214   END.
      215   ON CHOOSE OF B-dtl IN FRAME Dialog-Frame
      216   DO:
      217     assign
      218     tt-c-wth-line.doc-sum
      219     tt-c-wth-line.fact-sum
      220     tt-c-wth-line.wth-code
      221     .
      222     run str/wthcdtlc.w (
      223                     input parparentproc
      224                     ,INPUT par-mode
      225                     ,INPUT parline-rec
      226                     ,INPUT tt-c-wth-line.doc-code
      227                     ,INPUT tt-c-wth-line.wth-code
      228                     ,INPUT tt-c-wth-line.w-p-code
      229                     ,INPUT tt-c-wth-line.corr-user-db-num
      230                     ,INPUT tt-c-wth-line.chip-num
      231                     ,INPUT tt-c-wth-line.doc-sum
      232                     ,INPUT tt-c-wth-line.fact-sum
      233                     ,INPUT tt-c-wth-line.bef-sum
      234                     ,INPUT tt-c-wth-line.aft-sum
      235                     ,INPUT ub.c-wth-doc.doc-type
      236                     ,input-output table tt-par-dtl ).
      237     run control-dtl in this-procedure(output lock-line).
      238     run lock-proc in this-procedure(input lock-line).
      239   END.
      240   ON CHOOSE OF B-next IN FRAME Dialog-Frame
      241   DO:
      242     run proc-b-move(input self:name) no-error.
      243     if error-status:error then return no-apply.
      244   END.
      245   ON CHOOSE OF B-prev IN FRAME Dialog-Frame
      246   DO:
      247         run proc-b-move(input self:name) no-error.
      248     if error-status:error then return no-apply.
      249   END.
      250   ON LEAVE OF tt-c-wth-line.wth-code IN FRAME Dialog-Frame
      251   DO:
      252     FIND FIRST buf_wealth NO-LOCK WHERE
      253                      buf_wealth.wth-code = INPUT FRAME Dialog-Frame tt-c-wth-line.wth-code NO-ERROR.
      254     IF AVAIL buf_wealth THEN DO:
      255       DISPLAY buf_wealth.wth-name @ ub.wealth.wth-name
      256       WITH FRAME Dialog-Frame.
      257     END.
      258   END.
      259   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      260   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      261   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      262   on help of frame Dialog-Frame
      263   do:
      264     run gbl/app_help.p
      265       (input this-procedure :file-name
      266       ,input ''
      267       ,input ?
      268       ) no-error.
      269     if error-status :error then do:
      270       message
      271         "Ошибка при вызове помощи"
      272         error-status :get-message(1)
      273         view-as alert-box .
      274     end.
      275   end.
      276   run minbtn-set in this-procedure .
      277   on choose of b-help in frame Dialog-Frame
      278   do:
      279     apply "help":u to frame Dialog-Frame .
      280   end.
      281   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      282   procedure minbtn-set :
      283       do
      284           on error undo, return error return-value
      285           :
      286           define variable ii              as integer       no-undo .
      287           define variable fh              as widget-handle no-undo .
      288           define variable hh              as widget-handle no-undo .
      289           define variable v-h             as handle        extent 4 no-undo .
      290           define variable v-name-button   as character     no-undo .
      291           define variable v-help-old-x    as decimal       no-undo .
      292           define variable v-help-old-y    as decimal       no-undo .
      293           define variable v-help-old-size as decimal       no-undo .
      294           define variable v-frame-width   as decimal       no-undo .
      295           define variable jj              as integer       no-undo .
      296           do
      297               on error undo, return error
      298               :
      299               assign
      300                   v-frame-width = frame Dialog-Frame:width - 0.3
      301                   fh            = frame Dialog-Frame:first-child
      302                   hh            = fh:first-child
      303                   ii            = 1
      304                   .
      305               do while valid-handle(hh):
      306                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      307                   do:
      308                       case lc(hh:name) :
      309                           when "b-help" then
      310                               do:
      311                                   hh:load-image-up("cmp/b-help.bmp":u) .
      312                                   hh:load-image-down("cmp/b-help.bmp":u) .
      313                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      314                                   hh:TOOLTIP = "Помощь" .
      315                                   v-help-old-x = hh:column .
      316                                   v-help-old-y = hh:row    .
      317                                   v-help-old-size = hh:width .
      318                                   hh:width-chars = 2.5 .
      319                               end.
      320                           when "b-print" then
      321                               do:
      322                                   hh:load-image("cmp/b-print.bmp":u) .
      323                                   hh:TOOLTIP = "Печать" .
      324                                   v-h[ii] = hh:handle .
      325                                   ii = ii + 1 .
      326                                   hh:width-chars = 3 .
      327                               end.
      328                           when "b-history" or
      329                           when "b-hist" then
      330                               do:
      331                                   hh:load-image("cmp/b-hist.bmp":u) .
      332                                   hh:TOOLTIP = "История" .
      333                                   v-h[ii] = hh:handle .
      334                                   ii = ii + 1 .
      335                                   hh:width-chars = 3 .
      336                               end.
      337                           when "b-sch" then
      338                               do:
      339                                   hh:load-image("cmp/b-sch.bmp":u) .
      340                                   hh:TOOLTIP = "Установка Фильтра" .
      341                                   v-h[ii] = hh:handle .
      342                                   ii = ii + 1 .
      343                                   hh:width-chars = 3 .
      344                               end.
      345                           when "b-hist-user" then
      346                               do:
      347                                   hh:load-image("cmp/b-hist.bmp":u) .
      348                                   hh:TOOLTIP = "История пользователя" .
      349                                   ii = ii + 1 .
      350                               end.
      351                       end case.
      352                   end.
      353                   hh = hh:next-sibling.
      354               end.
      355               b-help:column = v-frame-width - b-help:width-chars.
      356               jj = 0.
      357               repeat ii = 4 to 1 by -1 :
      358                   if valid-handle (v-h[ii] ) then
      359                   do:
      360                       jj  = jj + 1 .
      361                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      362                       v-h[ii]:row    = v-help-old-y .
      363                   end.
      364               end.
      365           end.
      366       end.
      367   end procedure.
      368   MAIN-BLOCK:
      369   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      370      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      371     if par-mode <> 'ПРОСМОТР':U then do:
      372         message vss-workfile vss-revision vss-description skip
      373                     "Неверный параметр вызова par-mode"
      374         view-as alert-box ERROR.
      375         return error.
      376     end.
      377     if par-mode = 'ПРОСМОТР':U then do:
      378       FIND FIRST ub.c-wth-doc No-LOCK WHERE
      379                  recid(ub.c-wth-doc) = pardoc-rec No-ERROR.
      380     end.
      381     IF NOT avail ub.c-wth-doc then do:
      382       message
      383       vss-workfile vss-revision vss-description skip
      384       "Не найден документ движения МЦ"
      385       view-as alert-box.
      386       return error.
      387     end.
      388     assign
      389     vardoc-code = ub.c-wth-doc.doc-code
      390     varcorr-user-db-num = ub.c-wth-doc.corr-user-db-num
      391     varchip-num = ub.c-wth-doc.chip-num
      392     .
      393     OPEN QUERY QUERY-lines
      394     FOR EACH buf_c-wth-line WHERE
      395               buf_c-wth-line.doc-code = vardoc-code
      396          AND  buf_c-wth-line.corr-user-db-num = varcorr-user-db-num
      397          AND  buf_c-wth-line.chip-num = varchip-num NO-LOCK INDEXED-REPOSITION.
      398       if par-mode = 'ПРОСМОТР':U then do:
      399         get first QUERY-lines.
      400         repeat while parline-rec <> recid(buf_c-wth-line):
      401           get next QUERY-lines.
      402         end.
      403       end.
      404       IF error-status:error then do:
      405         message
      406         vss-workfile vss-revision vss-description skip
      407         "Не найдена строка по документу движения МЦ"
      408         view-as alert-box.
      409         return error.
      410       end.
      411       run fill-tables in this-procedure.
      412     RUN Myenable in this-procedure.
      413     WAIT-FOR GO OF FRAME Dialog-Frame.
      414   END.
      415   RUN disable_UI.
      416   PROCEDURE control-dtl :
      417   define output parameter lock-line as logical no-undo.
      418   if not avail tt-c-wth-line then return error.
      419   if can-find(first tt-par-dtl) then dO:
      420        find first tt-par-dtl No-LOCK  where
      421                   tt-par-dtl.doc-sum > 0 No-ERROR .
      422        t-dtl:screen-value in frame Dialog-Frame = (if available tt-par-dtl then "yes" else "no").
      423   end.
      424   else do:
      425          find first ub.c-wth-dtl No-LOCK  where
      426                       ub.c-wth-dtl.doc-code = tt-c-wth-line.doc-code AND
      427                       ub.c-wth-dtl.wth-code = tt-c-wth-line.wth-code AND
      428                       ub.c-wth-dtl.w-p-code = tt-c-wth-line.w-p-code No-ERROR .
      429        t-dtl:screen-value in frame Dialog-Frame = (if available ub.c-wth-dtl then "yes" else "no").
      430   end.
      431   if t-dtl:screen-value in frame Dialog-Frame = "yes" or
      432   par-mode = 'ПРОСМОТР':U
      433   then lock-line = yes.
      434   END PROCEDURE.
      435   PROCEDURE disable_UI :
      436     HIDE FRAME Dialog-Frame.
      437   END PROCEDURE.
      438   PROCEDURE enable_UI :
      439     DISPLAY T-dtl
      440         WITH FRAME Dialog-Frame.
      441     IF AVAILABLE tt-c-wth-line THEN
      442       DISPLAY tt-c-wth-line.wth-code tt-c-wth-line.doc-sum
      443             tt-c-wth-line.sum-gds-rubl tt-c-wth-line.fact-sum
      444             tt-c-wth-line.sum-gds-base
      445         WITH FRAME Dialog-Frame.
      446     IF AVAILABLE ub.wealth THEN
      447       DISPLAY ub.wealth.wth-name
      448         WITH FRAME Dialog-Frame.
      449     ENABLE b-quit B-dtl B-prev B-next B-Help T-dtl ub.wealth.wth-name
      450            tt-c-wth-line.wth-code tt-c-wth-line.doc-sum tt-c-wth-line.fact-sum
      451         WITH FRAME Dialog-Frame.
      452     VIEW FRAME Dialog-Frame.
      453   END PROCEDURE.
      454   PROCEDURE fill-tables :
      455     for each tt-c-wth-line:
      456       delete tt-c-wth-line.
      457     end.
      458   for each tt-par-dtl:
      459       delete tt-par-dtl.
      460   end.
      461       create tt-c-wth-line.
      462       buffer-copy buf_c-wth-line to tt-c-wth-line.
      463       FIND FIRST buf_wealth No-LOCK WHERE
      464                  buf_wealth.wth-code = tt-c-wth-line.wth-code No-error.
      465       find first ub.c-wth-dtl No-LOCK WHERE
      466                     ub.c-wth-dtl.wth-code = tt-c-wth-line.wth-code
      467                 AND ub.c-wth-dtl.doc-code = tt-c-wth-line.doc-code
      468                 AND ub.c-wth-dtl.w-p-code = tt-c-wth-line.w-p-code
      469                 AND ub.c-wth-dtl.corr-user-db-num = tt-c-wth-line.corr-user-db-num
      470                 AND ub.c-wth-dtl.chip-num = tt-c-wth-line.chip-num No-ERROR.
      471   END PROCEDURE.
      472   PROCEDURE lock-proc :
      473   DEFINE INPUT PARAMETER lock-line as logical no-undo.
      474     if lock-line then
      475     DISABLE
      476     tt-c-wth-line.wth-code
      477     with frame Dialog-Frame
      478     .
      479   END PROCEDURE.
      480   PROCEDURE MyEnable :
      481   assign
      482   tt-c-wth-line.sum-gds-rubl:label in frame Dialog-Frame = "Сумма по тов. (рубл)".
      483   IF AVAILABLE tt-c-wth-line THEN
      484       DISPLAY
      485       tt-c-wth-line.wth-code
      486       tt-c-wth-line.doc-sum
      487       tt-c-wth-line.fact-sum
      488     WITH FRAME Dialog-Frame.
      489     IF AVAILABLE buf_wealth THEN DO:
      490       DISPLAY
      491       buf_wealth.wth-name @ ub.wealth.wth-name
      492       WITH FRAME Dialog-Frame.
      493       if buf_wealth.is-ser = 1 then do:
      494         view
      495         tt-c-wth-line.sum-gds-base
      496         tt-c-wth-line.sum-gds-rubl
      497         in frame Dialog-Frame.
      498         DISPLAY
      499         tt-c-wth-line.sum-gds-base
      500         tt-c-wth-line.sum-gds-rubl
      501         WITH FRAME Dialog-Frame.
      502       end.
      503     END.
      504     ELSE
      505     DISPLAY
      506     '':u @ WEALTH.WTH-NAME
      507     WITH FRAME Dialog-Frame.
      508   CASE par-mode:
      509       when 'ПРОСМОТР':U  THEN DO:
      510         IF ub.c-wth-doc.status_ <> 'накл':U THEN DO:
      511           DISPLAY
      512           tt-c-wth-line.fact-sum WITH FRAME Dialog-Frame.
      513         END.
      514         ENABLE
      515         B-Next
      516         B-Prev
      517         b-quit
      518         b-dtl when avail ub.c-wth-dtl
      519         WITH FRAME Dialog-Frame.
      520         locked-wth = yes.
      521       END.
      522     END CASE.
      523     run control-dtl in this-procedure (output lock-line).
      524     run lock-proc in this-procedure(input lock-line).
      525     ENABLE
      526     b-help
      527     WITH FRAME Dialog-Frame.
      528     FRAME Dialog-Frame:TITLE =
      529         "Удаленный документ № " + c-wth-doc.doc-code + " (" + TRIM(
      530         ( IF c-wth-doc.doc-type = 'при':U     THEN "ПРИХОД"         ELSE
      531         ( IF c-wth-doc.doc-type = 'рас':U    THEN "РАСХОД"         ELSE
      532         ( IF c-wth-doc.doc-type = 'спи':U  THEN "СПИСАНИЕ"       ELSE
      533         ( IF c-wth-doc.doc-type = 'инв':U  THEN "ИНВЕНТАРИЗАЦИЯ" ELSE c-wth-doc.doc-type ) ) ) ) +
      534         STRING( c-wth-doc.inter_, "ВНУТ/":U ) + STRING( c-wth-doc.exter_, "ВНЕШ/":U ) ) + ")" +
      535         "  - " + CAPS( par-mode ) + " матценности".
      536     VIEW FRAME Dialog-Frame.
      537   END PROCEDURE.
      538   PROCEDURE proc-b-move :
      539   DEFINE INPUT PARAMETER par-action as character No-UNDO.
      540   define variable is-updated as logical no-undo.
      541   define variable loc#log as logical no-undo.
      542   define variable v-line-rec as recid no-undo .
      543     ASSIGN v-line-rec = RECID( buf_c-wth-line ).
      544     CASE par-action:
      545       when "b-next":U then do:
      546           GET NEXT QUERY-lines NO-LOCK.
      547       end.
      548       when "b-prev":U then do:
      549           GET PREV QUERY-lines NO-LOCK.
      550       end.
      551     END CASE.
      552     IF AVAIL buf_c-wth-line THEN DO:
      553       ASSIGN v-line-rec = RECID( buf_c-wth-line ).
      554       run fill-tables in this-procedure.
      555       run MyEnable in this-procedure.
      556     END.
      557     ELSE DO:
      558       CASE par-action:
      559           when "b-next":U then do:
      560               GET PREV QUERY-lines NO-LOCK.
      561           end.
      562           when "b-prev":U then do:
      563               GET NEXT QUERY-lines NO-LOCK.
      564           end.
      565       END CASE.
      566       FIND FIRST buf_c-wth-line NO-LOCK WHERE
      567                       RECID( buf_c-wth-line ) = v-line-rec NO-ERROR.
      568       MESSAGE
      569         "Это" ( IF par-action = "B-Next":U THEN "последняя" ELSE "первая" )
      570         "строка в документе!"
      571       VIEW-AS ALERT-BOX INFORMATION.
      572       RETURN NO-APPLY.
      573     END.
      574   END PROCEDURE.
