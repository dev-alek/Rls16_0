        1   define variable vss-revision    as character no-undo init "$Revision$":U .
        2   define variable vss-author      as character no-undo init "$Author$":U .
        3   define variable vss-date        as character no-undo init "$Date$":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5   define variable vss-archive     as character no-undo init "$Archive$":U .
        6   define variable vss-description as character no-undo init "Редактирование группы прав".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define new global shared variable g#language as character no-undo .
       62   if g#language <> '' and g#language <> 'rus':U then do:
       63     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       64   end.
       65   define new global shared variable g#library  as handle no-undo .
       66   define new global shared variable g#library2 as handle no-undo .
       67   define input        parameter parparentproc as widget-handle no-undo .
       68   DEFINE INPUT        PARAMETER p-edit-mode   AS LOGICAL       NO-UNDO.
       69   DEFINE INPUT-OUTPUT PARAMETER p-recid       AS RECID         NO-UNDO.
       70   DEFINE VARIABLE v-context           AS CHARACTER NO-UNDO .
       71   DEFINE VARIABLE v-context-name      AS CHARACTER NO-UNDO .
       72   DEFINE VARIABLE v-context-list      AS CHARACTER NO-UNDO .
       73   DEFINE VARIABLE v-context-list-name AS CHARACTER NO-UNDO INITIAL "Без привязки,Фирма,Объект" .
       74   DEFINE VARIABLE v-db-num            AS INTEGER   NO-UNDO.
       75   DEFINE BUFFER buf_sys-ctrl          FOR sys-ctrl.
       76   DEFINE BUTTON b-exit AUTO-GO
       77        LABEL "&Ввод"
       78        SIZE 10 BY 1
       79        BGCOLOR 8 .
       80   DEFINE BUTTON b-help
       81        LABEL "&Помощь"
       82        SIZE 10 BY 1
       83        BGCOLOR 8 .
       84   DEFINE BUTTON b-quit AUTO-END-KEY
       85        LABEL "&Отмена"
       86        SIZE 10 BY 1
       87        BGCOLOR 8 .
       88   DEFINE VARIABLE c-context AS CHARACTER FORMAT "X(12)":U INITIAL "Без привязки"
       89        LABEL "Привязка"
       90        VIEW-AS COMBO-BOX INNER-LINES 5
       91        LIST-ITEMS "Без привязки","Фирма","Объект"
       92        DROP-DOWN-LIST
       93        SIZE 16 BY 1 NO-UNDO.
       94   DEFINE VARIABLE v-description AS CHARACTER FORMAT "X(256)":U
       95        LABEL "Описание"
       96        VIEW-AS FILL-IN
       97        SIZE 45 BY 1 NO-UNDO.
       98   DEFINE VARIABLE v-name AS CHARACTER FORMAT "X(40)":U
       99        LABEL "Название"
      100        VIEW-AS FILL-IN
      101        SIZE 25 BY 1 NO-UNDO.
      102   DEFINE FRAME Dialog-Frame
      103        b-exit AT ROW 1 COL 1
      104        b-quit AT ROW 1 COL 11
      105        b-help AT ROW 1 COL 50.57
      106        v-name AT ROW 2.88 COL 11 COLON-ALIGNED WIDGET-ID 2
      107        v-description AT ROW 4.19 COL 11 COLON-ALIGNED WIDGET-ID 4
      108        c-context AT ROW 5.54 COL 11 COLON-ALIGNED WIDGET-ID 8
      109        SPACE(31.60) SKIP(2.56)
      110       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      111            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      112            TITLE "<insert dialog title>"
      113            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit WIDGET-ID 100.
      114   ASSIGN
      115          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      116          FRAME Dialog-Frame:HIDDEN           = TRUE.
      117   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      118   DO:
      119     APPLY "END-ERROR":U TO SELF.
      120   END.
      121   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      122   DO:
      123      ASSIGN
      124         v-name
      125         v-description
      126         c-context
      127      .
      128      RUN name-to-cntxt IN THIS-PROCEDURE ( INPUT  entry(1, c-context)
      129                                         , OUTPUT v-context
      130                                         ) NO-ERROR.
      131      RUN check-role IN THIS-PROCEDURE ( v-name:SCREEN-VALUE ) NO-ERROR.
      132      IF p-edit-mode THEN DO:
      133         RUN update-role IN THIS-PROCEDURE NO-ERROR.
      134      END.
      135      ELSE DO:
      136         RUN create-role IN THIS-PROCEDURE NO-ERROR.
      137      END.
      138      IF ERROR-STATUS:ERROR THEN DO:
      139         MESSAGE RETURN-VALUE SKIP
      140                 ERROR-STATUS:GET-MESSAGE(1)
      141         VIEW-AS ALERT-BOX.
      142         UNDO, RETURN NO-APPLY.
      143      END.
      144   END.
      145   ON VALUE-CHANGED OF c-context IN FRAME Dialog-Frame
      146   DO:
      147     RUN name-to-cntxt IN THIS-PROCEDURE ( INPUT  entry(1, c-context)
      148                                         , OUTPUT v-context
      149                                         ) NO-ERROR.
      150     IF ERROR-STATUS:ERROR THEN DO:
      151        MESSAGE RETURN-VALUE SKIP
      152                ERROR-STATUS:GET-MESSAGE(1)
      153        VIEW-AS ALERT-BOX.
      154        UNDO, RETURN NO-APPLY.
      155     END.
      156   END.
      157   ON LEAVE OF v-name IN FRAME Dialog-Frame
      158   DO:
      159       apply "VALUE-CHANGED" TO c-context.
      160       IF ERROR-STATUS:ERROR THEN DO:
      161          MESSAGE RETURN-VALUE SKIP
      162                  ERROR-STATUS:GET-MESSAGE(1)
      163          VIEW-AS ALERT-BOX.
      164          UNDO, RETURN NO-APPLY.
      165       END.
      166   END.
      167   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      168   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      169   MAIN-BLOCK:
      170   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      171      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      172   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      173   on help of frame Dialog-Frame
      174   do:
      175     run gbl/app_help.p
      176       (input this-procedure :file-name
      177       ,input ''
      178       ,input ?
      179       ) no-error.
      180     if error-status :error then do:
      181       message
      182         "Ошибка при вызове помощи"
      183         error-status :get-message(1)
      184         view-as alert-box .
      185     end.
      186   end.
      187   run minbtn-set in this-procedure .
      188   on choose of b-help in frame Dialog-Frame
      189   do:
      190     apply "help":u to frame Dialog-Frame .
      191   end.
      192   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      193   procedure minbtn-set :
      194       do
      195           on error undo, return error return-value
      196           :
      197           define variable ii              as integer       no-undo .
      198           define variable fh              as widget-handle no-undo .
      199           define variable hh              as widget-handle no-undo .
      200           define variable v-h             as handle        extent 4 no-undo .
      201           define variable v-name-button   as character     no-undo .
      202           define variable v-help-old-x    as decimal       no-undo .
      203           define variable v-help-old-y    as decimal       no-undo .
      204           define variable v-help-old-size as decimal       no-undo .
      205           define variable v-frame-width   as decimal       no-undo .
      206           define variable jj              as integer       no-undo .
      207           do
      208               on error undo, return error
      209               :
      210               assign
      211                   v-frame-width = frame Dialog-Frame:width - 0.3
      212                   fh            = frame Dialog-Frame:first-child
      213                   hh            = fh:first-child
      214                   ii            = 1
      215                   .
      216               do while valid-handle(hh):
      217                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      218                   do:
      219                       case lc(hh:name) :
      220                           when "b-help" then
      221                               do:
      222                                   hh:load-image-up("cmp/b-help.bmp":u) .
      223                                   hh:load-image-down("cmp/b-help.bmp":u) .
      224                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      225                                   hh:TOOLTIP = "Помощь" .
      226                                   v-help-old-x = hh:column .
      227                                   v-help-old-y = hh:row    .
      228                                   v-help-old-size = hh:width .
      229                                   hh:width-chars = 2.5 .
      230                               end.
      231                           when "b-print" then
      232                               do:
      233                                   hh:load-image("cmp/b-print.bmp":u) .
      234                                   hh:TOOLTIP = "Печать" .
      235                                   v-h[ii] = hh:handle .
      236                                   ii = ii + 1 .
      237                                   hh:width-chars = 3 .
      238                               end.
      239                           when "b-history" or
      240                           when "b-hist" then
      241                               do:
      242                                   hh:load-image("cmp/b-hist.bmp":u) .
      243                                   hh:TOOLTIP = "История" .
      244                                   v-h[ii] = hh:handle .
      245                                   ii = ii + 1 .
      246                                   hh:width-chars = 3 .
      247                               end.
      248                           when "b-sch" then
      249                               do:
      250                                   hh:load-image("cmp/b-sch.bmp":u) .
      251                                   hh:TOOLTIP = "Установка Фильтра" .
      252                                   v-h[ii] = hh:handle .
      253                                   ii = ii + 1 .
      254                                   hh:width-chars = 3 .
      255                               end.
      256                           when "b-hist-user" then
      257                               do:
      258                                   hh:load-image("cmp/b-hist.bmp":u) .
      259                                   hh:TOOLTIP = "История пользователя" .
      260                                   ii = ii + 1 .
      261                               end.
      262                       end case.
      263                   end.
      264                   hh = hh:next-sibling.
      265               end.
      266               b-help:column = v-frame-width - b-help:width-chars.
      267               jj = 0.
      268               repeat ii = 4 to 1 by -1 :
      269                   if valid-handle (v-h[ii] ) then
      270                   do:
      271                       jj  = jj + 1 .
      272                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      273                       v-h[ii]:row    = v-help-old-y .
      274                   end.
      275               end.
      276           end.
      277       end.
      278   end procedure.
      279     v-context-list = 'global':U + ',' + 'firm':U + ',' + 'object':U.
      280     FIND FIRST buf_sys-ctrl NO-LOCK NO-ERROR.
      281     IF NOT AVAILABLE buf_sys-ctrl THEN DO:
      282        RETURN ERROR ERROR-STATUS:GET-MESSAGE(1).
      283     END.
      284     ASSIGN
      285       v-db-num = buf_sys-ctrl.db-num
      286     .
      287     RELEASE buf_sys-ctrl.
      288     IF p-edit-mode THEN DO:
      289        FIND FIRST action-role WHERE RECID(action-role) = p-recid
      290                               NO-ERROR
      291                               NO-WAIT.
      292        IF LOCKED action-role THEN DO:
      293           RETURN ERROR "Группа прав сейчас недоступна для правки, попробуйте позже".
      294        END.
      295        IF NOT AVAILABLE action-role THEN DO:
      296           RETURN ERROR SUBSTITUTE("Не найдена группа прав RECID: &1", p-recid ).
      297        END.
      298        ASSIGN
      299           v-name        = action-role.action-role-name
      300           v-description = action-role.action-role-description
      301           v-context     = action-role.action-role-context
      302        .
      303        RUN cntxt-to-name ( INPUT  v-context
      304                          , OUTPUT v-context-name
      305                          ) .
      306        ASSIGN
      307           c-context = v-context-name
      308           FRAME Dialog-Frame:TITLE = "Редактирование группы прав"
      309        .
      310     END.
      311     ELSE DO:
      312        ASSIGN
      313           FRAME Dialog-Frame:TITLE = "Создание группы прав"
      314        .
      315     END.
      316     RUN enable_UI.
      317     IF p-edit-mode THEN DO:
      318         RUN post_enable_UI.
      319     END.
      320     APPLY "ENTRY" TO v-name.
      321     WAIT-FOR GO OF FRAME Dialog-Frame.
      322   END.
      323   RUN disable_UI.
      324   PROCEDURE check-role :
      325   DEFINE INPUT PARAMETER p-name AS CHARACTER NO-UNDO.
      326   DEFINE BUFFER buf_action-role FOR action-role.
      327   IF p-name = "" THEN DO:
      328      RETURN ERROR "Заполните имя для группы прав" .
      329   END.
      330   IF NOT p-edit-mode THEN DO:
      331      IF CAN-FIND( FIRST buf_action-role WHERE buf_action-role.db-num              = v-db-num
      332                                       AND buf_action-role.action-head-code    = 0
      333                                       AND buf_action-role.action-role-name    = p-name
      334                                       AND buf_action-role.action-role-context = v-context
      335                                    NO-LOCK
      336            ) THEN DO:
      337      RETURN ERROR "Группа прав с таким именем уже существует".
      338      END.
      339   END.
      340   else do:
      341      IF CAN-FIND( FIRST buf_action-role WHERE buf_action-role.db-num              = v-db-num
      342                                       AND buf_action-role.action-head-code    = 0
      343                                       AND buf_action-role.action-role-name    = p-name
      344                                       AND buf_action-role.action-role-context = v-context
      345                                       AND RECID(buf_action-role) <> RECID(action-role)
      346                                    NO-LOCK
      347            ) THEN DO:
      348      RETURN ERROR "Группа прав с таким именем уже существует".
      349      END.
      350   end.
      351   END PROCEDURE.
      352   PROCEDURE cntxt-to-name :
      353   DEFINE INPUT  PARAMETER p-context AS CHARACTER NO-UNDO.
      354   DEFINE OUTPUT PARAMETER p-name    AS CHARACTER NO-UNDO.
      355   DEFINE VARIABLE         v-i       AS INTEGER   NO-UNDO.
      356       DO
      357       ON ERROR UNDO, RETURN ERROR return-value
      358       :
      359          v-i = lookup( p-context, v-context-list, ",":U ) .
      360          IF v-i <= 0
      361          OR v-i > NUM-ENTRIES( v-context-list-name )
      362          THEN DO:
      363              RETURN ERROR "Неизвестный контекст" .
      364          END.
      365          p-name = ENTRY( v-i, v-context-list-name ) .
      366       END.
      367   END PROCEDURE.
      368   PROCEDURE create-role :
      369       DEFINE VARIABLE v-action-role-code AS INTEGER NO-UNDO.
      370       DO TRANSACTION
      371       ON ERROR UNDO, RETURN ERROR RETURN-VALUE
      372       :
      373           RUN check-role IN THIS-PROCEDURE ( INPUT v-name ).
      374           RUN name-to-cntxt IN THIS-PROCEDURE ( INPUT  entry(1, c-context)
      375                                               , OUTPUT v-context
      376                                               ).
      377           ASSIGN
      378              v-action-role-code = NEXT-VALUE(s-action-role)
      379           .
      380           CREATE action-role.
      381           ASSIGN
      382              action-role.db-num                   = v-db-num
      383              action-role.action-head-code         = 0
      384              action-role.action-role-code         = v-action-role-code
      385              action-role.action-role-context      = v-context
      386              action-role.action-role-name         = v-name
      387              action-role.action-role-description  = v-description
      388           NO-ERROR.
      389           IF ERROR-STATUS:ERROR THEN DO:
      390              UNDO, RETURN ERROR SUBSTITUTE("&1, &2", ERROR-STATUS:GET-MESSAGE(1), RETURN-VALUE).
      391           END.
      392           p-recid = RECID(action-role).
      393       END.
      394   END PROCEDURE.
      395   PROCEDURE disable_UI :
      396     HIDE FRAME Dialog-Frame.
      397   END PROCEDURE.
      398   PROCEDURE enable_UI :
      399     DISPLAY v-name v-description c-context
      400         WITH FRAME Dialog-Frame.
      401     ENABLE b-quit b-exit b-help v-name v-description c-context
      402         WITH FRAME Dialog-Frame.
      403     VIEW FRAME Dialog-Frame.
      404   END PROCEDURE.
      405   PROCEDURE name-to-cntxt :
      406   DEFINE INPUT  PARAMETER p-name    AS CHARACTER NO-UNDO.
      407   DEFINE OUTPUT PARAMETER p-context AS CHARACTER NO-UNDO.
      408   DEFINE VARIABLE         v-i       AS INTEGER   NO-UNDO.
      409       DO
      410       ON ERROR UNDO, RETURN ERROR RETURN-VALUE
      411       :
      412          v-i = lookup( p-name, v-context-list-name, ",":U ) .
      413          IF v-i <= 0
      414          OR v-i > NUM-ENTRIES( v-context-list )
      415          THEN DO:
      416              RETURN ERROR "Неизвестный контекст" .
      417          END.
      418          p-context = ENTRY( v-i, v-context-list ) .
      419       END.
      420   END PROCEDURE.
      421   PROCEDURE post_enable_UI :
      422     DISABLE c-context
      423         WITH FRAME Dialog-Frame.
      424     VIEW FRAME Dialog-Frame.
      425   END PROCEDURE.
      426   PROCEDURE update-role :
      427       DEFINE VARIABLE v-action-role-code AS INTEGER NO-UNDO.
      428       DO TRANSACTION
      429       ON ERROR UNDO, RETURN ERROR RETURN-VALUE
      430       :
      431           RUN check-role IN THIS-PROCEDURE ( INPUT v-name ).
      432           FIND CURRENT action-role EXCLUSIVE-LOCK .
      433           ASSIGN
      434              action-role.action-role-name         = v-name
      435              action-role.action-role-description  = v-description
      436           NO-ERROR.
      437           IF ERROR-STATUS:ERROR THEN DO:
      438              UNDO, RETURN ERROR SUBSTITUTE("&1, &2", ERROR-STATUS:GET-MESSAGE(1), RETURN-VALUE).
      439           END.
      440       END.
      441   END PROCEDURE.
