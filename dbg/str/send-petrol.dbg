      604   procedure xmlchar-decode :
      605   define input parameter p-in-string      as character        no-undo.
      606   define output parameter p-out-string    as character        no-undo.
      607       define variable v-position      as integer      no-undo.
      608       define variable v-last-position as integer      no-undo.
      609       define variable v-temp-integer  as integer      no-undo.
      610       define variable v-current-char  as character    no-undo.
      611       define variable v-next-char     as character    no-undo.
      612       define variable v-success       as logical      no-undo.
      613   do
      614   on error undo, return error
      615   :
      616       assign
      617           p-out-string = "":U
      618           v-position   = 0
      619       .
      620       replace-cycle:
      621       do while yes
      622       on error undo, return error
      623       :
      624           assign
      625               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      626           .
      627           if v-last-position <= v-position
      628           then do:
      629               if v-position = 0
      630               then do:
      631                   assign
      632                       p-out-string = p-in-string
      633                   .
      634               end.
      635               else do:
      636                   assign
      637                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      638                   .
      639               end.
      640               leave replace-cycle.
      641           end.
      642           else do:
      643               assign
      644                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      645                   v-position      = v-last-position
      646                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      647               .
      648               if v-current-char = "#":U
      649               then do:
      650                   assign
      651                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      652                   .
      653                   if v-last-position > 0
      654                   then do:
      655                       run xmlchar-read-integer in this-procedure
      656                        (
      657                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      658                           , output v-temp-integer
      659                           , output v-success
      660                       ).
      661                       if v-success = yes
      662                       and v-temp-integer >= 1
      663                       and v-temp-integer <= 255
      664                       then do:
      665                           assign
      666                               p-out-string = p-out-string + chr( v-temp-integer )
      667                               v-position   = v-last-position + 1
      668                           .
      669                       end.
      670                       else do:
      671                           assign
      672                               p-out-string = p-out-string + "&":U
      673                               v-position   = v-position   + 1
      674                           .
      675                       end.
      676                   end.
      677                   else do:
      678                       assign
      679                           p-out-string = p-out-string + "&":U
      680                           v-position   = v-position   + 1
      681                       .
      682                   end.
      683               end.
      684               else do:
      685                   case substring( p-in-string, v-position + 1, 3 )
      686                   :
      687                       when "lt;":U
      688                       then do:
      689                           assign
      690                               p-out-string = p-out-string + "<":U
      691                               v-position   = v-position   + 3
      692                           .
      693                       end.
      694                       when "gt;":U
      695                       then do:
      696                           assign
      697                               p-out-string = p-out-string + ">":U
      698                               v-position   = v-position   + 3
      699                           .
      700                       end.
      701                       otherwise do:
      702                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      703                           then do:
      704                               assign
      705                                   p-out-string = p-out-string + "&":U
      706                                   v-position   = v-position   + 4
      707                               .
      708                           end.
      709                           else do:
      710                               case substring( p-in-string, v-position + 1, 5 )
      711                               :
      712                                   when "quot;":U
      713                                   then do:
      714                                       assign
      715                                           p-out-string = p-out-string + '"':U
      716                                           v-position   = v-position   + 5
      717                                       .
      718                                   end.
      719                                   when "apos;":U
      720                                   then do:
      721                                       assign
      722                                           p-out-string = p-out-string + "'":U
      723                                           v-position   = v-position   + 5
      724                                       .
      725                                   end.
      726                                   otherwise do:
      727                                       assign
      728                                           p-out-string = p-out-string + "&":U
      729                                       .
      730                                   end.
      731                               end case.
      732                           end.
      733                       end.
      734                   end case.
      735               end.
      736           end.
      737       end.
      738   end.
      739   end .
      740   procedure xmlchar-read-integer :
      741   define input parameter p-input-string      as character        no-undo.
      742   define output parameter p-output-integer   as integer          no-undo.
      743   define output parameter p-success       as logical          no-undo.
      744   do
      745   on error undo, return error
      746   :
      747       assign
      748           p-output-integer = integer( p-input-string )
      749       no-error.
      750       if error-status :error
      751       then do:
      752           assign
      753               p-success           = no
      754               p-output-integer    = 0
      755           .
      756       end.
      757       else do:
      758           assign
      759               p-success           = yes
      760           .
      761       end.
      762   end.
      763   end.
      764   define variable v-bgelib-bgeclall           as logical      no-undo.
      765   define variable v-bgelib-bgedict            as logical      no-undo.
      766   define temp-table temp_ext-doc-type no-undo
      767       field edt-key               as integer
      768       field ext-doc-type          as character
      769       field ext-doc-type-label    as character
      770       index pi is primary unique
      771           edt-key
      772   .
      773   define temp-table temp_bgelib_goods no-undo
      774       field gds-code as integer
      775       index pi is primary unique
      776           gds-code
      777   .
      778   define temp-table temp_bgelib_clients no-undo
      779       field obj-type as character
      780       field obj-code as integer
      781       index pi is primary unique
      782           obj-type
      783           obj-code
      784   .
      785   define temp-table temp_bgelib_dis-card no-undo
      786       field d-card as character
      787       index pi is primary unique
      788           d-card
      789   .
      790   define temp-table temp_bgelib_trn-doc no-undo
      791       field doc-code as integer
      792   .
      793   procedure bgelib-tag-open:
      794   do
      795   on error undo, return error
      796   :
      797   define input parameter v-tag-level  as integer      no-undo.
      798   define input parameter v-tag-name   as character    no-undo.
      799   define input parameter v-tag-value  as character    no-undo.
      800       put stream stmXMLOut unformatted
      801           chr(10)
      802           + fill(" ", 4 * v-tag-level)
      803           + "<" + v-tag-name
      804           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
      805           + v-tag-value + ">"
      806       .
      807   end.
      808   end procedure.
      809   procedure bgelib-tag-put:
      810   do
      811   on error undo, return error
      812   :
      813   define input parameter v-tag-level      as integer      no-undo.
      814   define input parameter v-tag-name       as character    no-undo.
      815   define input parameter v-tag-value      as character    no-undo.
      816   define input parameter v-empty-mode     as integer      no-undo.
      817       v-tag-name = trim(v-tag-name).
      818       if  v-empty-mode = 1
      819       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
      820       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
      821       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
      822       then do:
      823           run xmlchar-encode in this-procedure (
      824                 input v-tag-value
      825               , output v-tag-value
      826           ).
      827           put stream stmXMLOut unformatted
      828               chr(10) + fill(" ", 4 * v-tag-level)
      829                           + '<' + v-tag-name + '>'
      830                           + v-tag-value
      831                           + '</' + v-tag-name + '>'
      832           .
      833       end.
      834   end.
      835   end procedure.
      836   procedure bgelib-tag-close:
      837   do
      838   on error undo, return error
      839   :
      840   define input parameter v-tag-level as integer      no-undo.
      841   define input parameter v-tag-name  as character    no-undo.
      842       put stream stmXMLOut unformatted
      843           chr(10)
      844           + fill( " ", 4 * v-tag-level)
      845           + '</' + v-tag-name + '>'
      846       .
      847   end.
      848   end procedure.
      849   procedure bgelib-write-log:
      850   do
      851   on error undo, return error
      852   :
      853   define input parameter v-filename   as character    no-undo.
      854   define input parameter v-log-level  as integer      no-undo.
      855   define input parameter v-out-string as character    no-undo.
      856       output stream stmXMLLog to value( v-filename ) append.
      857       put stream stmXMLLog unformatted
      858           chr(10)
      859       .
      860       put stream stmXMLLog unformatted
      861           ( if v-log-level = 0
      862             or v-out-string = "&DLine"
      863             or v-out-string = "&Line"
      864             then ""
      865             else cur-time-string-sec() + " " )
      866       .
      867       put stream stmXMLLog unformatted
      868           ( if v-out-string = "&Line"
      869             then fill( "-", 80 )
      870             else if v-out-string = "&DLine"
      871                  then fill( "=", 80 )
      872                  else v-out-string )
      873       .
      874       output stream stmXMLLog close.
      875   end.
      876   end procedure.
      877   procedure bgelib-write-edt:
      878   do
      879   on error undo, return error
      880   :
      881   define input parameter v-editor-handle    as handle       no-undo.
      882   define input parameter v-log-level        as integer      no-undo.
      883   define input parameter v-out-string       as character    no-undo.
      884       if valid-handle ( v-editor-handle )
      885       then do:
      886           v-editor-handle :move-to-eof().
      887           v-editor-handle :insert-string( ( if v-log-level = 0
      888                                             or v-out-string = "&DLine"
      889                                             or v-out-string = "&Line"
      890                                             then ""
      891                                             else cur-time-string-sec() + " "
      892                                         ) ).
      893           v-editor-handle :insert-string( ( if v-out-string = "&Line"
      894                                             then fill( "-", 80 )
      895                                             else if v-out-string = "&DLine" then fill("=", 80)
      896                                             else fill( " ", v-log-level) + v-out-string
      897                                         ) ).
      898           v-editor-handle :insert-string( chr(10) ).
      899       end.
      900       process events.
      901       output to 'bgescn.txt' append.
      902           put unformatted
      903               chr(10)
      904               string( ( if v-log-level = 0
      905                         or v-out-string = "&DLine"
      906                         or v-out-string = "&Line"
      907                         then ""
      908                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
      909                     ) )
      910               string( ( if v-out-string = "&Line"
      911                         then fill( "-", 80 )
      912                         else if v-out-string = "&DLine"
      913                              then fill( "=", 80 )
      914                              else fill( " ", v-log-level ) + v-out-string
      915                     ) )
      916           .
      917       output close.
      918   end.
      919   end procedure.
      920   procedure bgelib-show-cnt:
      921   do
      922   on error undo, return error
      923   :
      924   define input parameter v-fillin-handle     as handle   no-undo.
      925       if valid-handle( v-fillin-handle )
      926       then do:
      927           assign
      928               v-fillin-handle :visible = true
      929           .
      930       end.
      931   end.
      932   end procedure.
      933   procedure bgelib-hide-cnt:
      934   do
      935   on error undo, return error
      936   :
      937   define input parameter v-fillin-handle     as handle   no-undo.
      938       if valid-handle( v-fillin-handle )
      939       then do:
      940           assign v-fillin-handle :visible = false.
      941       end.
      942   end.
      943   end procedure.
      944   procedure bgelib-write-cnt:
      945   do
      946   on error undo, return error
      947   :
      948   define input parameter v-fillin-handle    as handle       no-undo.
      949   define input parameter v-fillin-string    as character    no-undo.
      950       if valid-handle( v-fillin-handle )
      951       then do:
      952           assign
      953               v-fillin-handle :SCREEN-value = v-fillin-string
      954           .
      955       end.
      956   end.
      957   end procedure.
      958   procedure bgelib-write-header:
      959   do
      960   on error undo, return error
      961   :
      962   define input parameter p-first-file     as logical      no-undo.
      963   define input parameter p-xml-file-name  as character    no-undo.
      964   define input parameter p-list-file-name as character    no-undo.
      965   define input parameter p-file-number    as integer      no-undo.
      966   define input parameter p-have-prev      as logical      no-undo.
      967   define input parameter p-prev-filename  as character    no-undo.
      968   define input parameter p-obj-list       as character    no-undo.
      969   define input parameter p-doc-type-list  as character    no-undo.
      970   define input parameter p-parameter-list as character    no-undo.
      971       define variable v-counter    as integer        no-undo.
      972       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
      973       put stream stmXMLOut unformatted
      974           "<?xml version='1.0' encoding='windows-1251'?>"
      975       .
      976       run bgelib-tag-open( input 0, input "root"  , input "" ).
      977       run bgelib-tag-open( input 0, input "header", input "" ).
      978       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
      979       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
      980       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
      981       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
      982       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
      983       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
      984       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
      985       :
      986           run bgelib-tag-put(
      987                 input 1
      988               , input entry( 2 * v-counter, p-parameter-list )
      989               , input entry( 2 * v-counter + 1, p-parameter-list )
      990               , input 0
      991           ).
      992       end.
      993       run bgelib-tag-close( input 0, input "header" ).
      994       output stream stmXMLOut close.
      995       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
      996       if p-first-file = yes
      997       then do:
      998           put stream stmXMLOut unformatted
      999               "<?xml version='1.0' encoding='windows-1251'?>"
     1000           .
     1001           run bgelib-tag-open( input 0, input "export", input "" ).
     1002       end.
     1003       run bgelib-tag-open( input 1, input "file", input "" ).
     1004       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     1005       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     1006       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     1007       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     1008       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     1009       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     1010       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     1011       :
     1012           run bgelib-tag-put(
     1013                 input 2
     1014               , input trim(entry( 2 * v-counter, p-parameter-list ))
     1015               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     1016               , input 0
     1017           ).
     1018       end.
     1019       run bgelib-tag-close( input 1, input "file" ).
     1020       output stream stmXMLOut close.
     1021   end.
     1022   end procedure.
     1023   procedure bgelib-write-footer:
     1024   do
     1025   on error undo, return error
     1026   :
     1027   define input parameter p-last-file      as logical      no-undo.
     1028   define input parameter p-xml-file-name  as character    no-undo.
     1029   define input parameter p-list-file-name as character    no-undo.
     1030   define input parameter p-have-next      as logical      no-undo.
     1031   define input parameter p-next-file-name as character    no-undo.
     1032       define variable v-error-num     as integer           no-undo.
     1033       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     1034       if p-have-next = yes
     1035       then do:
     1036           run bgelib-tag-open( input 0, input "footer", "" ).
     1037           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     1038           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     1039           run bgelib-tag-close( input 0, input "footer" ).
     1040       end.
     1041       run bgelib-tag-close( input 0, input "root" ).
     1042       output stream stmXMLOut close.
     1043       run bge/os_copy.p (
     1044             input "M"
     1045           , input p-xml-file-name + "tmp"
     1046           , input p-xml-file-name + "xml"
     1047           , output v-error-num
     1048       ).
     1049       if p-last-file = yes
     1050       then do:
     1051           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     1052               run bgelib-tag-close( input 0, input "export" ).
     1053           output stream stmXMLOut close.
     1054           run bge/os_copy.p (
     1055                 input "M"
     1056               , input p-list-file-name + "tmp"
     1057               , input p-list-file-name + "xml"
     1058               , output v-error-num
     1059           ).
     1060       end.
     1061   end.
     1062   end procedure.
     1063   procedure bgelib-filename :
     1064   do
     1065   on error undo, return error
     1066   :
     1067   define input parameter p-prefix             as character    no-undo.
     1068   define output parameter p-xml-file-name     as character    no-undo.
     1069   define output parameter p-log-file-name     as character    no-undo.
     1070   define output parameter p-list-file-name    as character    no-undo.
     1071       define variable v-home-dir  as character    no-undo.
     1072       define variable v-error-num as integer      no-undo.
     1073       get-key-value section "BGE" key "outdir" value v-home-dir.
     1074       if v-home-dir = ?
     1075       then do:
     1076           message
     1077             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     1078             skip(1)
     1079             skip "Обратитесь к администратору."
     1080           view-as alert-box error.
     1081           undo, return error .
     1082       end.
     1083       run gbl/dir-cre.p (
     1084           input v-home-dir
     1085       ) no-error.
     1086       if error-status :error
     1087       then do:
     1088           message
     1089             skip "Неверно задан каталог экспорта."
     1090             skip(1)
     1091             skip "Обратитесь к администратору."
     1092           view-as alert-box error.
     1093           undo, return error .
     1094       end.
     1095       run bge/genfname.p (
     1096             input v-home-dir
     1097           , input p-prefix
     1098           , input ""
     1099           , input "xml"
     1100           , input "tmp"
     1101           , output p-xml-file-name
     1102       ).
     1103       assign
     1104           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     1105           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     1106           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     1107       .
     1108   end.
     1109   end procedure.
     1110   procedure bgelib-read-config :
     1111   do
     1112   on error undo, return error
     1113   :
     1114   define variable v-par-type as character     no-undo.
     1115     define variable v-param-type      as character  no-undo .
     1116     define variable v-value-character as character  no-undo .
     1117     define variable v-value-date      as date       no-undo .
     1118     define variable v-value-decimal   as decimal    no-undo .
     1119     define variable v-value-integer   as integer    no-undo .
     1120     define variable v-value-logical   as logical    no-undo .
     1121     define variable v-tth             as handle     no-undo .
     1122       assign
     1123           v-bgelib-bgeclall = no
     1124           v-bgelib-bgedict  = no
     1125       .
     1126       run adm/shattri.p ( input "get":U
     1127                         , input  '':u
     1128                         , input  0
     1129                         , input  'bge-export':U
     1130                         , input  'bgeclall':U
     1131                         , output v-value-character
     1132                         , output v-value-date
     1133                         , output v-value-decimal
     1134                         , output v-value-integer
     1135                         , output v-value-logical
     1136                         , output v-param-type
     1137                         , input-output table-handle v-tth
     1138                         ) no-error .
     1139       if error-status :error
     1140       then do:
     1141         assign
     1142           v-bgelib-bgeclall = no
     1143         .
     1144       end.
     1145       else do:
     1146         assign
     1147           v-bgelib-bgeclall = v-value-logical
     1148         .
     1149       end.
     1150       delete object v-tth.
     1151       run adm/shattri.p ( input "get":U
     1152                         , input  '':u
     1153                         , input  0
     1154                         , input  'bge-export':U
     1155                         , input  'bgedict':U
     1156                         , output v-value-character
     1157                         , output v-value-date
     1158                         , output v-value-decimal
     1159                         , output v-value-integer
     1160                         , output v-value-logical
     1161                         , output v-param-type
     1162                         , input-output table-handle v-tth
     1163                         ) no-error .
     1164       if error-status :error
     1165       then do:
     1166         assign
     1167           v-bgelib-bgedict = no
     1168         .
     1169       end.
     1170       else do:
     1171         assign
     1172           v-bgelib-bgedict = v-value-logical
     1173         .
     1174       end.
     1175       delete object v-tth.
     1176       run adm/shattri.p ( input "get":U
     1177                         , input  '':u
     1178                         , input  0
     1179                         , input  'bge-export':U
     1180                         , input  'bgefmt':U
     1181                         , output v-value-character
     1182                         , output v-value-date
     1183                         , output v-value-decimal
     1184                         , output v-value-integer
     1185                         , output v-value-logical
     1186                         , output v-param-type
     1187                         , input-output table-handle v-tth
     1188                         ) no-error .
     1189       if error-status :error
     1190       then do:
     1191         assign
     1192           v-bgelib-bgefmt  = "xml":U
     1193         .
     1194       end.
     1195       else do:
     1196         assign
     1197           v-bgelib-bgefmt  = v-value-character
     1198         .
     1199       end.
     1200       delete object v-tth.
     1201       run adm/shattri.p ( input "get":U
     1202                         , input  '':u
     1203                         , input  0
     1204                         , input  'bge-export':U
     1205                         , input  'bgeflold':U
     1206                         , output v-value-character
     1207                         , output v-value-date
     1208                         , output v-value-decimal
     1209                         , output v-value-integer
     1210                         , output v-value-logical
     1211                         , output v-param-type
     1212                         , input-output table-handle v-tth
     1213                         ) no-error .
     1214       if error-status :error
     1215       then do:
     1216         assign
     1217           v-bgelib-bgeflold  = "old":U
     1218         .
     1219       end.
     1220       else do:
     1221         assign
     1222           v-bgelib-bgeflold  = v-value-character
     1223         .
     1224       end.
     1225       delete object v-tth.
     1226   end.
     1227   end procedure.
     1228   procedure bgelib-check-file-size :
     1229   do
     1230   on error undo, return error
     1231   :
     1232   define input parameter p-out-filename   as character    no-undo.
     1233   define output parameter p-is-big        as logical      no-undo.
     1234       define variable v-current-position    as integer        no-undo.
     1235       assign
     1236           v-current-position = seek( stmXMLOut )
     1237       .
     1238       if v-current-position / 1024 / 1024  >= 100
     1239       then do:
     1240           assign
     1241               p-is-big = yes
     1242           .
     1243       end.
     1244   end.
     1245   end procedure.
     1246   procedure bgelib-init-ext-doc-type :
     1247       define variable v-counter    as integer      no-undo.
     1248       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     1249   do
     1250   for buf_temp_ext-doc-type
     1251   on error undo, return error
     1252   :
     1253       empty temp-table buf_temp_ext-doc-type.
     1254       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1255       :
     1256           create buf_temp_ext-doc-type.
     1257           assign
     1258               buf_temp_ext-doc-type.edt-key               = v-counter
     1259               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     1260               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     1261           .
     1262       end.
     1263   end.
     1264   end procedure.
