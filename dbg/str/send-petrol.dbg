     2198   define variable v-cd-subject-code as character no-undo .
     2199   define variable v-cd-disc-string as character no-undo .
     2200   define variable v-versiond as decimal no-undo .
     2201   define buffer for-cash-desk for ub.cash-desk.
     2202   _for:
     2203   FOR EACH for-cash-desk NO-LOCK WHERE
     2204           for-cash-desk.db-num = g#db-num AND
     2205           for-cash-desk.pos-type = ub.cash-desk.pos-type AND
     2206           for-cash-desk.obj-code = i-obj-code AND
     2207           for-cash-desk.cash-on  = yes
     2208       BREAK
     2209       BY for-cash-desk.db-num
     2210       BY for-cash-desk.obj-code
     2211       BY for-cash-desk.pos-type
     2212       BY for-cash-desk.cash-on
     2213       :
     2214     if LOOKUP(ub.cash-desk.pos-type,
     2215               ('NCR-GM':U + chr(44) +
     2216                'IBM-XML':U + chr(44) +
     2217                'MAGIA-XML':U + chr(44) +
     2218                'NCR-AS@R':U + chr(44)
     2219                  )) > 0
     2220     and for-cash-desk.autonomy = integer('1':U) then NEXT.
     2221     assign
     2222     v-versiond = decimal(for-cash-desk.version)
     2223     no-error .
     2224     if error-status:error
     2225     or v-versiond < 1.11
     2226     or for-cash-desk.pos-type <> 'IBM-XML':U
     2227     then do:
     2228       run write-log-and-file in p-log-handle (
     2229             input 1
     2230           , input log-file-name
     2231           , input 1
     2232           , input substitute( "Невозможно передать на кассу &1 &2&3&4" +
     2233                               "Данный функционал доступен только для POS &5 с версии ПО кассы 1.11 или POS &6"
     2234                             ,  for-cash-desk.cash-num
     2235                             , 'маг':U
     2236                             , for-cash-desk.obj-code
     2237                             , chr(10)
     2238                             , 'IBM':U
     2239                             , 'IBM-XML':U
     2240                             )
     2241                                             ).
     2242        next _for.
     2243     end.
     2244     run write-log-and-file in p-log-handle (
     2245           input 1
     2246         , input log-file-name
     2247         , input 1
     2248         , input substitute( "Пересылка - касса &1", for-cash-desk.cash-num
     2249                           )
     2250                                           ).
     2251   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2252   case for-cash-desk.pos-type:
