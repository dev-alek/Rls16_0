     2553     run write-log-and-file in p-log-handle (
     2554           input 1
     2555         , input log-file-name
     2556         , input 1
     2557         , input substitute( "Данные выгружены в файл &1",
     2558                               (v-dir-remote  + chr(47) + "fl":U + fname + '.dat')
     2559                           )
     2560                                           ).
     2561   end.
     2562   else do:
     2563     if not g#news
     2564     and not g#auto
     2565     and not g#esys
     2566     then do:
     2567     end.
     2568   end.
     2569     end.
     2570   END CASE.
     2571   END .
     2572   END PROCEDURE.
     2573   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2574   PROCEDURE SENDING:
     2575   _cash-desk:
     2576   FOR EACH ub.cash-desk NO-LOCK WHERE
     2577            ub.cash-desk.db-num = g#db-num AND
     2578            ub.cash-desk.obj-code = i-obj-code AND
     2579           ub.cash-desk.cash-on
     2580   BREAK
     2581   By ub.cash-desk.pos-type :
     2582     IF FIRST-OF(ub.cash-desk.pos-type) then do:
     2583   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2584   define variable dflt-cd19 as character no-undo .
     2585   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2586   define variable v-param-type20 as character no-undo .
     2587   define variable v-value-date20 as date no-undo .
     2588   define variable v-value-decimal20 as decimal no-undo .
     2589   define variable v-value-integer20 as INTEGER no-undo .
     2590   define variable v-value-logical20 AS LOGICAL no-undo .
     2591   define variable v-tth20 as handle no-undo .
     2592   run adm/shattri.p (
     2593       input "get":U
     2594       ,input  'маг':U
     2595       ,input  ub.cash-desk.obj-code
     2596       ,input  'cd-sending':U
     2597       ,input  'dflt-cd':U
     2598       ,output dflt-cd19
     2599       ,output v-value-date20
     2600       ,output v-value-decimal20
     2601       ,output v-value-integer20
     2602       ,output v-value-logical20
     2603       ,output v-param-type20
     2604       ,INPUT-OUTPUT table-handle v-tth20
     2605       ) no-error .
     2606   delete object v-tth20 no-error.
     2607   case ub.cash-desk.pos-type:
     2608       when 'IBM-XML':U or when 'Autotank':U
     2609     then do:
     2610   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2611   run str/get-inis.p (
     2612                   input 'маг':U
     2613                 , input ub.cash-desk.obj-code
     2614                 , input ub.cash-desk.pos-type
     2615                 , input cash-desk.remote
     2616                 , input "send":U
     2617                 , output out
     2618                 , output out2
     2619                 , output in_
     2620                 , output spl
     2621                 , output sav
     2622                 , output v-remote
     2623                 )  no-error .
     2624   if error-status:error then do:
     2625     run write-log-and-file in p-log-handle (
     2626           input 1
     2627         , input log-file-name
     2628         , input 1
     2629         , input substitute("!!!Не удалось получить настройки для  POS типа &1 для маг&2 из ini-файла:&3&4 &5"
     2630                             , ub.cash-desk.pos-type
     2631                             , ub.cash-desk.obj-code
     2632                             , chr(10)
     2633                             , error-status:get-message(1)
     2634                             , return-value )).
     2635     assign
     2636     v-view-log = yes.
     2637     return error.
     2638   end.
     2639   if ub.cash-desk.pos-type = 'IBM-XML':U
     2640   or ub.cash-desk.pos-type = 'Autotank':U
     2641   then do:
     2642     file-info:file-name = (out  + "undelivered").
     2643     if file-info:FULL-PATHNAME <> ? then do:
     2644       run str/rsndxibm.p ( input parparentproc
     2645                           ,input p-parent-handle
     2646                           ,input p-log-handle
     2647                           ,input out  + "undelivered" ) no-error.
     2648     end.
     2649   end.
     2650     end.
     2651     when 'IBM':U
     2652     then do:
     2653   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2654   run str/get-inis.p (
     2655                   input 'маг':U
     2656                 , input ub.cash-desk.obj-code
     2657                 , input ub.cash-desk.pos-type
     2658                 , input cash-desk.remote
     2659                 , input "send":U
     2660                 , output out
     2661                 , output out2
     2662                 , output in_
     2663                 , output spl
     2664                 , output sav
     2665                 , output v-remote
     2666                 )  no-error .
     2667   if error-status:error then do:
     2668     run write-log-and-file in p-log-handle (
     2669           input 1
     2670         , input log-file-name
     2671         , input 1
     2672         , input substitute("!!!Не удалось получить настройки для  POS типа &1 для маг&2 из ini-файла:&3&4 &5"
     2673                             , ub.cash-desk.pos-type
     2674                             , ub.cash-desk.obj-code
     2675                             , chr(10)
     2676                             , error-status:get-message(1)
     2677                             , return-value )).
     2678     assign
     2679     v-view-log = yes.
     2680     return error.
     2681   end.
     2682     end.
     2683   END CASE.
     2684       RUN for-cash-cycle no-error.
     2685       if error-status:error then do:
     2686         run write-log-and-file in p-log-handle (
     2687               input 1
     2688             , input log-file-name
     2689             , input 1
     2690             , input substitute("&1 &2", error-status:get-message(1), return-value)
     2691                                                 ).
     2692         assign
     2693         v-view-log = yes
     2694         .
     2695       end.
     2696     END.
     2697     IF LAST-OF(ub.cash-desk.pos-type) then do:
     2698   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2699   case ub.cash-desk.pos-type:
     2700   END CASE.
     2701     END.
     2702   END.
     2703   END PROCEDURE.
     2704   RUN SENDING no-error.
     2705   if error-status:error then do:
     2706     run write-log-and-file in p-log-handle (
     2707           input 1
     2708         , input log-file-name
     2709         , input 1
     2710         , input substitute( "!!!Ошибки при отсылке данных по соответствию товаров/кошельков &1&2"
     2711                            , p-obj-type, i-obj-code
     2712                           )
     2713                                           ).
     2714   end.
