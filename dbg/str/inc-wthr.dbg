      128   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      129   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
      130                                                       ,input p-range-type as character
      131                                                       ,input p-code as integer):
      132   define variable v-seq-val as integer no-undo .
      133   define buffer buf_code-range for ub.code-range.
      134   find first buf_code-range no-lock where
      135             buf_code-range.db-num = p-db-num
      136       and  buf_code-range.range-type = p-range-type
      137       and  buf_code-range.stts = 'u'
      138       and buf_code-range.first-code <= p-code
      139       and buf_code-range.last-code >= p-code no-error .
      140   if available buf_code-range then return yes.
      141   CASE p-range-type:
      142     when 'pngb':U then do:
      143       v-seq-val = current-value(s-pngb-code, ub).
      144     end.
      145     when 'fmgb':U then do:
      146       v-seq-val = current-value(s-fmgb-code, ub).
      147     end.
      148   END CASE.
      149   if p-code <= v-seq-val then do:
      150     find first buf_code-range no-lock where
      151               buf_code-range.db-num = p-db-num
      152         and  buf_code-range.range-type = p-range-type
      153         and  buf_code-range.stts = 'a'
      154         and buf_code-range.first-code <= p-code
      155         no-error .
      156    if available buf_code-range then return yes.
      157   end.
      158   find first buf_code-range no-lock where
      159             buf_code-range.db-num = p-db-num
      160       and  buf_code-range.range-type = p-range-type
      161       and  buf_code-range.stts = 'f'
      162       and buf_code-range.first-code <= p-code
      163       and buf_code-range.last-code >= p-code
      164       no-error .
      165   if available buf_code-range then return yes.
      166   return no.
      167   END FUNCTION.
      168   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
      169                                                       ,input p-range-type as character
      170                                                       ,input p-code as integer):
      171   define variable v-seq-val as integer no-undo .
      172   define buffer buf_code-range for ub.code-range.
      173   CASE p-range-type:
      174     when 'pngb':U then do:
      175       v-seq-val = current-value(s-pngb-code, ub).
      176     end.
      177     when 'fmgb':U then do:
      178       v-seq-val = current-value(s-fmgb-code, ub).
      179     end.
      180   END CASE.
      181   if p-code <= v-seq-val then do:
      182     find first buf_code-range no-lock where
      183               buf_code-range.db-num = p-db-num
      184         and  buf_code-range.range-type = p-range-type
      185         and buf_code-range.first-code <= p-code
      186         and buf_code-range.last-code >= p-code no-error .
      187     if available buf_code-range then return yes.
      188   end.
      189   return no.
      190   END FUNCTION.
      191   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
      192                                                       ,input p-db-num as integer
      193                                                       ,input p-staff-code as integer
      194                                                       ,input p-date as date
      195                                                        ):
      196   define buffer buf_staff for ub.staff.
      197   if p-date = ? then do:
      198     p-date = today .
      199   end.
      200   find first buf_staff no-lock where
      201             buf_staff.role = p-role
      202         and buf_staff.role-level = 'db':U
      203         and buf_staff.db-num = p-db-num
      204         and buf_staff.staff-code = p-staff-code
      205         and buf_staff.date-end >= p-date use-index pi  no-error .
      206   if available buf_staff then do:
      207     return buf_staff.psn-code.
      208   end.
      209   return 0.
      210   end FUNCTION.
      211   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
      212                                                             ,input p-db-num as integer
      213                                                             ,input p-date as date
      214                                                                 ):
      215   define buffer buf_staff for ub.staff.
      216   define buffer buf2_staff for ub.staff.
      217   if p-date = ? then do:
      218     p-date = today .
      219   end.
      220   for each  buf_staff no-lock where
      221             buf_staff.role = p-role
      222         and buf_staff.db-num = p-db-num,
      223   first buf2_staff no-lock where
      224         buf2_staff.role = p-role
      225     and buf2_staff.role-level = 'db':U
      226     and buf2_staff.staff-code = buf_staff.staff-code
      227     and buf2_staff.date-start <= p-date
      228     and buf2_staff.date-end >= p-date
      229   by buf_staff.staff-code
      230   by date-start descending:
      231     return buf_staff.staff-code.
      232   end.
      233   end FUNCTION.
      234   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
      235                                                  ,input p-db-num as integer
      236                                                  ,input p-psn-code as integer
      237                                                  ,input p-date as date
      238                                                  ,output p-c-password as character
      239                                                        ):
      240   define buffer buf_staff for ub.staff.
      241   if p-date = ? then do:
      242     p-date = today .
      243   end.
      244   find first buf_staff no-lock where
      245             buf_staff.role = p-role
      246         and buf_staff.role-level = 'db':U
      247         and buf_staff.db-num = p-db-num
      248        and buf_staff.date-end >= p-date
      249        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
      250   if available buf_staff
      251   then do:
      252     assign
      253     p-c-password = buf_staff.password.
      254     return buf_staff.staff-code.
      255   end.
      256   p-c-password = ''.
      257   return 0.
      258   end FUNCTION.
      259   FUNCTION gbclcode-is-psn-role returns integer (
      260                                                 input p-role as character
      261                                                 ,input p-psn-code as integer
      262                                                 ,input p-date as date
      263                                                     ):
      264   define buffer buf_staff for ub.staff.
      265   if p-date = ? then do:
      266     p-date = today .
      267   end.
      268   for each buf_staff no-lock where
      269             buf_staff.psn-code = p-psn-code
      270        and  buf_staff.role = p-role
      271   by buf_staff.role-level
      272   by buf_staff.date-start
      273        :
      274     if  buf_staff.date-start <= p-date and
      275     buf_staff.date-end >= p-date  then do:
      276       return buf_staff.staff-code.
      277     end.
      278   end.
      279   return 0.
      280   end FUNCTION.
      281   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
      282   define variable v-role-name as character no-undo .
      283   assign
      284   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      285   no-error .
      286   return v-role-name.
      287   END.
      288   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      289   FUNCTION gbclcode-get-position returns character ( input p-role as character
      290                                                     ,input p-role-level as character
      291                                                     ,input p-work-place as character
      292                                                     ,input p-staff-code as integer
      293                                                                ):
      294   define variable v-role-name as character no-undo .
      295   define variable v-role-level as character no-undo .
      296   define variable v-staff-code as integer no-undo .
      297   assign
      298   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      299   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
      300   v-staff-code = p-staff-code
      301   no-error .
      302   return substitute("&1, &2, Код &3"
      303                   ,v-role-name
      304                   ,v-role-level
      305                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
      306   END.
      307   FUNCTION gbclcode-get-work-place returns character (
      308                                                   input p-role as character
      309                                                  ,input p-role-level as character
      310                                                  ,input p-db-num as integer
      311                                                  ,input p-host-code as integer
      312                                                  ,input p-obj-type as character
      313                                                  ,input p-obj-code as integer
      314                                                  ) :
      315   define variable v-work-place as character no-undo .
      316   define variable v-obj-type as character no-undo .
      317     case p-role-level:
      318       when 'db':U then do:
      319         v-work-place = string(p-db-num, "99999").
      320       end.
      321       when 'firm':U then do:
      322         v-work-place = string(p-host-code, "99999").
      323       end.
      324       when 'object':U then do:
      325         assign
      326         v-work-place = p-obj-type + string(p-obj-code, "999999999")
      327         .
      328       end.
      329     END CASE.
      330     return v-work-place.
      331   END FUNCTION.
      332   FUNCTION gbclcode-get-level-last-code returns integer (
      333                                                           input p-role as character
      334                                                         , input p-role-level as character
      335                                                         , input p-work-place as character
      336                                                         , input p-date-start as date
      337                                                         ):
      338   DEFINE VARIABLE v-today as date no-undo .
      339   define buffer buf_staff for ub.staff.
      340   if p-work-place = chr(63) then return ?.
      341   if p-date-start = ? then do:
      342     v-today = today .
      343   end.
      344   else do:
      345     v-today = p-date-start.
      346   end.
      347   find last buf_staff no-lock where
      348             buf_staff.role = p-role
      349        and  buf_staff.role-level = p-role-level
      350        and  buf_staff.work-place = p-work-place
      351        and  buf_staff.date-start <= v-today + 1
      352        and  buf_staff.date-end >= v-today + 1
      353        use-index pi  no-error .
      354   if available buf_staff
      355   then return buf_staff.staff-code.
      356   return 0.
      357   end FUNCTION.
      358   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      359   procedure cur-time :
      360      define output parameter p-today as date      no-undo .
      361      define output parameter p-time  as integer   no-undo .
      362     do
      363     on error undo, return error
      364     :
      365       define variable v-date1 as date      no-undo .
      366       define variable v-date2 as date      no-undo .
      367       define variable v-time  as integer   no-undo .
      368       assign
      369         v-date1 = today
      370         v-time  = time
      371         v-date2 = today
      372       .
      373       if v-date1 <> v-date2
      374       then do:
      375         assign
      376           v-date1 = today
      377           v-time  = v-time
      378         .
      379       end.
      380       assign
      381         p-today = v-date1
      382         p-time  = v-time
      383       .
      384     end.
      385   end.
      386   function cur-time-date returns character
      387   :
      388     return string(today, '99/99/9999':U) .
      389   end.
      390   function cur-time-mjd returns decimal
      391   :
      392     define variable v-date as date      no-undo .
      393     define variable v-time as integer   no-undo .
      394     run cur-time in this-procedure
      395       (output v-date
      396       ,output v-time
      397       ) .
      398     return integer(v-date) - 2400002 + (v-time / 86400) .
      399   end.
      400   function cur-time-get-ending-index returns integer
      401   (input p-number as integer
      402   )
      403   :
      404     if p-number < 0
      405     or p-number = ?
      406     then do:
      407       return 1 .
      408     end.
      409     define variable v-rest as integer   no-undo .
      410     assign
      411       p-number = p-number modulo 100
      412     .
      413     if p-number < 20
      414     then do:
      415       assign
      416         v-rest = p-number
      417       .
      418     end.
      419     else do:
      420       assign
      421         v-rest = p-number modulo 10
      422       .
      423     end.
      424     case v-rest :
      425       when 1
      426       then do:
      427         return 2 .
      428       end.
      429       when 2 or
      430       when 3 or
      431       when 4
      432       then do:
      433         return 3 .
      434       end.
      435       otherwise do:
      436         return 1 .
      437       end.
      438     end case .
      439   end.
      440   procedure cur-time-mjd-to-date :
      441      define input  parameter i-mjd-diff as decimal no-undo.
      442      define output parameter o-Date     as date    no-undo.
      443      define output parameter o-Time     as integer no-undo.
      444      define variable v-day-number as integer   no-undo .
      445      if    i-mjd-diff < 0
      446         or i-mjd-diff = ?
      447      then do:
      448         return "?" .
      449      end.
      450      assign
      451         v-day-number = truncate(i-mjd-diff,0).
      452         o-Date = date(v-day-number + 2400002).
      453         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      454     .
      455   end.
      456   function cur-time-mjd-to-string returns character
      457   (input p-mjd-diff as decimal
      458   )
      459   :
      460     define variable v-day-number as integer   no-undo .
      461     define variable v-seconds    as integer   no-undo .
      462     define variable v-hour       as integer   no-undo .
      463     define variable v-min        as integer   no-undo .
      464     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      465     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      466     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      467     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      468     if p-mjd-diff < 0
      469     or p-mjd-diff = ?
      470     then do:
      471       return "?" .
      472     end.
      473     assign
      474       v-day-number = integer(truncate(p-mjd-diff,0))
      475       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      476     .
      477     if v-seconds > 86400
      478     then do:
      479       assign
      480         v-seconds = 86400 - 1
      481       .
      482     end.
      483     if v-seconds < 0
      484     then do:
      485       assign
      486         v-seconds = 0
      487       .
      488     end.
      489     assign
      490       v-hour = truncate(v-seconds / 3600, 0)
      491     .
      492     assign
      493       v-seconds = v-seconds modulo 3600
      494     .
      495     assign
      496       v-min = truncate(v-seconds / 60, 0)
      497     .
      498     assign
      499       v-seconds = v-seconds modulo 60
      500     .
      501     return
      502         (if v-day-number <> 0
      503           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      504           else ""
      505         )
      506       + (if v-day-number <> 0 or v-hour <> 0
      507           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      508           else ""
      509         )
      510       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      511           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      512           else ""
      513         )
      514       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      515       .
      516   end.
      517   function cur-time-string returns character
      518   :
      519     define variable v-date as date      no-undo .
      520     define variable v-time as integer   no-undo .
      521     run cur-time in this-procedure
      522       (output v-date
      523       ,output v-time
      524       ) .
      525     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      526   end.
      527   function cur-time-string-sec returns character
      528   :
      529     define variable v-date as date      no-undo .
      530     define variable v-time as integer   no-undo .
      531     run cur-time in this-procedure
      532       (output v-date
      533       ,output v-time
      534       ) .
      535     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      536   end.
      537   function cur-time-custom  returns character
      538   (input p-prefix as character
      539   ,input p-date-format as character
      540   ,input p-delimiter as character
      541   ,input p-time-format as character
      542   ,input p-suffix as character
      543   )
      544   :
      545     define variable v-date as date      no-undo .
      546     define variable v-time as integer   no-undo .
      547     run cur-time in this-procedure
      548       (output v-date
      549       ,output v-time
      550       ) .
      551     return
      552       p-prefix
      553       + string(v-date, p-date-format)
      554       + p-delimiter
      555       + string(v-time, p-time-format)
      556       + p-suffix
      557       .
      558   end.
      559   function cur-time-print  returns character
      560   :
      561     define variable v-date as date      no-undo .
      562     define variable v-time as integer   no-undo .
      563     run cur-time in this-procedure
      564       (output v-date
      565       ,output v-time
      566       ) .
      567     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      568   end.
      569   function cur-time-datetime returns datetime
      570   :
      571     define variable v-char as character no-undo .
      572     define variable v-datetime as datetime no-undo .
      573     v-char = cur-time-string().
      574     v-datetime = datetime(v-char).
      575     return  v-datetime.
      576   end.
      577   function cur-time-string-msec returns character
      578   :
      579     define variable v-date as datetime  no-undo .
      580     v-date = now.
      581     return string(v-date) .
      582   end.
      583   DEFINE VARIABLE v-err-count as integer no-undo .
      584   DEFINE VARIABLE v-all-count as integer no-undo .
      585   define variable v-ok-count as integer no-undo .
      586   DEFINE VARIABLE vardb-num like ub.db.db-num no-undo.
      587   define variable v-view-log as logical no-undo .
      588   define variable v-esm as character no-undo .
      589   define variable v-input-error as logical no-undo .
      590   define variable log-file-name as character no-undo init "inc-wth.log".
      591   define variable v-closed as integer no-undo .
      592   define buffer buf_obj for ub.clients.
      593   define buffer buf_wth-doc for ub.wth-doc.
      594   define buffer auto-wth-doc-lock_batchprocess for ub.batchprocess .
      595   define buffer buf_temp-cre-doc for temp-cre-doc .
      596   define buffer buf_chk-doc for ub.chk-doc.
      597   define temp-table tt-par-dtl  no-undo like ub.wth-par
      598   FIELD q-ty-doc     AS   DEC FORM     ">,>>>,>>>,>>>":U    COLUMN-LABEL "Кол-во по!документу"
      599   FIELD q-ty-fact    AS   DEC FORM     ">,>>>,>>>,>>>":U    COLUMN-LABEL "Количество!факт"
      600   FIELD doc-sum      like ub.wth-line.doc-sum FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по!документу"
      601   FIELD fact-sum     like ub.wth-line.doc-sum FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма!факт"
      602   FIELD sum-gds-rubl like ub.wth-line.sum-gds-rubl  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по связ.!товарам (рубл)"
      603   FIELD sum-gds-base like ub.wth-line.sum-gds-base  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма по связ.!товарам (баз.вал.)"
      604   FIELD price-rubl   like ub.wth-line.price-rubl  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Цена товара!(рубл)"
      605   FIELD price-base   like ub.wth-line.price-base  FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Цена товара!(баз.вал.)"
      606   FIELD w-p-code     like ub.wth-dtl.w-p-code
      607   FIELD doc-code     like ub.wth-dtl.doc-code
      608   FIELD gds-code     like ub.wth-gds.gds-code
      609   INDEX tt-pi    IS   PRIMARY UNIQUE par-code  w-p-code doc-code  wth-code
      610   INDEX tt-i1                        par-feat par-unit par-val
      611   INDEX tt-i2                        doc-sum  q-ty-doc
      612   .
      613   define temp-table tt-par-dtl-inv  no-undo like ub.wth-par
      614   FIELD q-ty-bef     AS   DEC FORM     ">,>>>,>>>,>>>":U    COLUMN-LABEL "Кол-во план"
      615   FIELD q-ty-aft     AS   DEC FORM     ">,>>>,>>>,>>>":U    COLUMN-LABEL "Кол-во факт"
      616   FIELD sum-bef  like ub.wth-line.bef-sum FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма план"
      617   FIELD sum-aft  like ub.wth-line.aft-sum FORM ">,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Сумма факт"
      618   FIELD sum-fact  like ub.wth-line.fact-sum FORM "->,>>>,>>>,>>>,>>>.<<":U COLUMN-LABEL "Расхождение"
      619   INDEX tt-pi    IS   PRIMARY UNIQUE par-code
      620   INDEX tt-i1                        par-feat par-unit par-val
      621   INDEX tt-i2                        sum-bef  q-ty-bef
      622   .
      623   if num-entries(p-parameter, chr(4)) <> 4
      624   then do:
      625     assign
      626     v-input-error = yes
      627     v-esm         = substitute("Неверное количество ENTRY в составном параметре - &1, должно быть 4"
      628                                , num-entries(p-parameter, chr(4))).
      629     .
      630   end.
      631   else do:
      632     assign
      633     parhost-code         = integer(entry(1, p-parameter, chr(4)))
      634     parobj-type          = entry(2, p-parameter, chr(4))
      635     parobj-code          = integer(entry(3, p-parameter, chr(4)))
      636     p-auto               = integer(entry(4, p-parameter, chr(4)))
      637     no-error .
      638     if error-status:error then do:
      639       assign
      640       v-esm = error-status:get-message(1)
      641       v-input-error = yes
      642       .
      643     end.
      644   end.
      645   if v-input-error = yes then do:
      646     run write-log-and-file in p-log-handle (
      647           input 1
      648         , input log-file-name
      649         , input 1
      650         , input substitute("Ошибка входных параметров &1:&2&3&4"
      651                            , p-parameter
      652                            , chr(10)
      653                            , v-esm
      654                            , return-value
      655                            )).
      656     assign
      657     v-view-log = yes.
      658     if p-auto = 0 then do:
      659   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      660   if v-view-log
      661   and not g#news
      662   and not g#auto
      663   then do:
      664     message
      665     substitute('!!!В процессе Обработки документов МЦ произошли ошибки!!!')  skip
      666     "!!!Внимательно прочитайте Log-file!!"
      667     view-as alert-box error .
      668        define variable v-user-action5   as character no-undo .
      669     define variable v-printed5       as logical   no-undo .
      670     run gbl/prnfilen.w
      671       (input  (substitute('!!!В процессе Обработки документов МЦ произошли ошибки!!!'))
      672       ,input  0
      673       ,input  (string("./":U) + 'inc-wth.log')
      674       ,input  7
      675       ,output v-user-action5
      676       ,output v-printed5
      677       ) .
      678   end.
      679   if v-view-log = true
      680   and (g#news
      681   or g#auto)
      682   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
      683   then do:
      684      run cb_set-view-log in p-parent-handle ( input yes).
      685   end.
      686   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
      687     OS-DELETE value(string("./":U) + 'inc-wth.log').
      688   end.
      689                           return "error":U.                  end.
      690   end.
      691   define variable v-param-type as character no-undo .
      692   define variable v-value-character as character no-undo .
      693   define variable v-value-date as date no-undo .
      694   define variable v-value-decimal as decimal no-undo .
      695   define variable v-value-integer as INTEGER no-undo .
      696   define variable v-clsfact AS LOGICAL no-undo .
      697   define variable v-tth as handle no-undo .
      698   run adm/shattri.p (
      699       input "get":U
      700       ,input  parobj-type
      701       ,input  parobj-code
      702       ,input  'wthdoc':U
      703       ,input  'clsfact':U
      704       ,output v-value-character
      705       ,output v-value-date
      706       ,output v-value-decimal
      707       ,output v-value-integer
      708       ,output v-clsfact
      709       ,output v-param-type
      710       ,INPUT-OUTPUT table-handle v-tth
      711       ) no-error .
      712   delete object v-tth no-error.
      713   FIND FIRST buf_obj No-LOCK WHERE
      714                   buf_obj.obj-type = parobj-type and
      715                   buf_obj.obj-code = parobj-code No-ERROR.
      716   if not avail buf_obj or parobj-type <> 'маг':U then do:
      717       message vss-workfile vss-revision vss-description skip
      718       "Неверный параметр вызова parobj-type и/или parobj-code" parobj-type parobj-code
      719       view-as alert-box ERROR.
      720       return.
      721   end.
      722   vardb-num = buf_obj.db-num.
      723   for each temp-cash-doc:
      724     delete temp-cash-doc.
      725   end.
      726   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      727   run gbl/lock-prc.p
      728       (input 'awth':U
      729       ,input parobj-code
      730       ,input 0
      731       ,input 0
      732       ,input parobj-type
      733       ,input ""
      734       ,input ""
      735       ,input (
      736                "Код объекта" + ",,," +
      737                "Тип объекта" +  ",,,Формирование автоматических документов МЦ"
      738              )
      739       ,input true
      740       ,buffer auto-wth-doc-lock_batchprocess
      741       ) no-error .
      742     if error-status :error then do:
      743       message
      744         vss-workfile vss-revision vss-description skip
      745         "В данный момент уже производится формирование автоматических документов МЦ" skip
      746         view-as alert-box error .
      747       undo, return error .
      748     end.
      749   _chk-doc:
      750   for each  buf_temp-cre-doc NO-LOCK,
      751       each buf_chk-doc EXCLUSIVE-LOCK where
      752            buf_chk-doc.obj-type = parobj-type and
      753            buf_chk-doc.obj-code = parobj-code and
      754            buf_chk-doc.out-code = ? and
      755            buf_chk-doc.chk-type = buf_temp-cre-doc.chk-type
      756            :
      757     v-all-count = v-all-count + 1.
      758     if not buf_chk-doc.correct then NEXT _chk-doc.
      759     if buf_temp-cre-doc.shift-date = ? then do:
      760       if buf_chk-doc.shift-date <> buf_temp-cre-doc.doc-date then NEXT _chk-doc.
      761     end.
      762     else do:
      763       if NOT (buf_chk-doc.shift-date = buf_temp-cre-doc.shift-date AND
      764               buf_chk-doc.shift-num = buf_temp-cre-doc.shift-num) then NEXT _chk-doc.
      765     end.
      766     if buf_chk-doc.chk-type = integer('7':U) then do:
      767       FIND FIRST temp-cash-doc where
      768                 temp-cash-doc.chk-type = buf_chk-doc.chk-type
      769             AND temp-cash-doc.pay-desk = buf_chk-doc.pay-desk
      770             AND temp-cash-doc.cashier = buf_chk-doc.cashier
      771             and temp-cash-doc.chk-doc-code = buf_chk-doc.doc-code No-ERROR.
      772     end.
      773     else do:
      774       FIND FIRST temp-cash-doc where
      775                 temp-cash-doc.chk-type = buf_chk-doc.chk-type
      776             AND temp-cash-doc.pay-desk = buf_chk-doc.pay-desk
      777             AND temp-cash-doc.cashier = buf_chk-doc.cashier  No-ERROR.
      778     end.
      779     if not available temp-cash-doc then do:
      780       run create-new-wth-doc in this-procedure (
      781                                                  input vardb-num
      782                                                 ,input parobj-type
      783                                                 ,input parobj-code
      784                                                 ,input buf_chk-doc.chk-type
      785                                                 ,input buf_chk-doc.pay-desk
      786                                                 ,input buf_chk-doc.cashier
      787                                                 ,input buf_chk-doc.chk-date
      788                                                 ,buffer temp-cash-doc
      789                                                 )no-error .
      790       if error-status:error then do:
      791         NEXT _chk-doc.
      792       end.
      793     end.
      794     run str/inc-wth1.p (
      795                       buffer buf_chk-doc
      796                     ,input 1
      797                     ,input temp-cash-doc.doc-code
      798                     ,INPUT temp-cash-doc.w-p-code
      799                     ,input temp-cash-doc.out-w-p-code
      800                     ,input temp-cash-doc.ext-doc-type
      801                     ,input temp-cash-doc.chk-type
      802                     ,input yes
      803                     ) no-error .
      804     if error-status:error then do:
      805         run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Ошибка при включении чека &1 в документ МЦ &2&3&4&3&5"                               , buf_chk-doc.doc-code                               , temp-cash-doc.doc-code                               , chr(10)                               , error-status:get-message(1)                               , return-value )                                       ).
      806       v-err-count = v-err-count + 1.
      807       NEXT _chk-doc.
      808     end.
      809     else do:
      810       v-ok-count = v-ok-count + 1.
      811     end.
      812     run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Формирование автоматических документов МЦ: просмотрено чеков &1&2обработано &3&2"  +                                "из них успешно &4"                              ,v-all-count                               ,chr(10)                               ,v-ok-count + v-err-count                              ,v-ok-count)                                       ).
      813   END.
      814   _temp-cash-doc:
      815   for each temp-cash-doc No-LOCK:
      816     FIND FIRST buf_wth-doc Exclusive-lock WHERE
      817                buf_wth-doc.doc-code = temp-cash-doc.doc-code No-ERROR.
      818     if avail buf_wth-doc
      819     and not can-find(first ub.wth-line where ub.wth-line.doc-code = buf_wth-doc.doc-code) then do:
      820        delete buf_wth-doc.
      821        next _temp-cash-doc.
      822     end.
      823     if v-clsfact then do:
      824       do while
      825       buf_wth-doc.status_ <> 'факт':U :
      826         run str/wth-stts.p (
      827                      input parparentproc
      828                     ,BUFFER buf_wth-doc
      829                     ,INPUT "+":U
      830                     ,INPUT no
      831                     ,INPUT buf_wth-doc.obj-type
      832                     ,INPUT buf_wth-doc.oBJ-code
      833                     ,input log-file-name ) NO-ERROR.
      834         if error-status:error THEN DO:
      835           v-view-log = yes.
      836           next _temp-cash-doc.
      837         END.
      838         find first buf_wth-doc exclusive-lock where
      839                  buf_wth-doc.doc-code = temp-cash-doc.doc-code .
      840         if buf_wth-doc.status_ = 'факт':U then do:
      841           v-closed = v-closed + 1.
      842           next _temp-cash-doc.
      843         end.
      844       end.
      845     end.
      846   end.
      847   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Просмотрено чеков МЦ:&1&2" +             "В автодокументы МЦ удалось включить чеков: &3&2"  +           (if v-clsfact then substitute("до статуса &1 удалось закрыть док-тов: &2", 'факт':U, v-closed) else '')         , v-all-count                                       , chr(10)                                     , v-ok-count)                                       ).
      848   procedure create-new-wth-doc :
      849   define input parameter pardb-num like ub.db.db-num no-undo .
      850   define input parameter parobj-type like ub.clients.obj-type no-undo .
      851   define input parameter parobj-code like ub.clients.obj-code no-undo .
      852   define input parameter parchk-type like ub.chk-doc.chk-type no-undo .
      853   define input parameter parpay-desk like ub.chk-doc.pay-desk no-undo .
      854   define input parameter par-cashier like ub.chk-doc.cashier no-undo .
      855   define input parameter p-chk-date  like ub.chk-doc.chk-date no-undo .
      856   define parameter buffer loc-temp-cash-doc for temp-cash-doc.
      857   DEFINE VARIABLE vardoc-rec as recid no-undo.
      858   DEFINE VARIABLE vardoc-code like ub.wth-doc.doc-code no-undo .
      859   define variable v-cashier-psn-code as integer no-undo .
      860   define buffer buf_wth-doc for ub.wth-doc.
      861   define buffer buf_wth-line for ub.wth-line.
      862   define buffer cashier for ub.person.
      863   define buffer cash_wth-place for ub.wth-place.
      864   DEFINE VARIABLE dops as character no-undo .
      865     do
      866     on error undo, return error
      867     :
      868       assign dops = entry (lookup (string(parchk-type),  '2,3,4,5,7':U) + 1, ',' + 'Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ':U) no-error.
      869           run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Создание автоматического документа МЦ - &1" +                                  "Касса: &2&1" +                                   "Кассир: &3&1" +                                  "Тип чека МЦ: &4"                                   , chr(10)                                   , parpay-desk                                   , par-cashier                                   , dops)                                       ).
      870       v-cashier-psn-code = 0.
      871       assign
      872       v-cashier-psn-code = gbclcode-is-this-db-role ( input 'C':U, input vardb-num, input par-cashier, input p-chk-date)
      873       no-error
      874       .
      875       if v-cashier-psn-code = 0 then do:
      876               v-view-log = yes.
      877         run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("!!!ОШИБКА: В справочнике нет кассира &1",  par-cashier)                                       ).
      878         return error.
      879       end.
      880       find first CASH_WTh-PLACE no-lock where
      881                  CASH_wth-place.obj-type = parobj-type AND
      882                  CASH_wth-place.obj-code = parobj-code AND
      883                  cash_wth-place.cash-desk = parpay-desk No-ERROR.
      884       if not available cash_wth-place then do:
      885               v-view-log = yes.
      886         run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("!!!ОШИБКА: Не определено МХ для кассы &1",  parpay-desk)                                       ).
      887         return error.
      888       end.
      889       FIND FIRST temp-cre-doc No-LOCK WHERE
      890                  temp-cre-doc.chk-type = parchk-type No-ERROR.
      891       if not available temp-cre-doc then return error.
      892       vardoc-rec = ?.
      893       _buf_wth-doc:
      894       FOR EACH buf_wth-doc No-LOCK WHERE
      895                 buf_wth-doc.obj-type = parobj-type AND
      896                 buf_wth-doc.obj-code = parobj-code AND
      897                 buf_wth-doc.auto-fill = yes AND
      898                 buf_wth-doc.status_ = 'накл':U AND
      899                 buf_wth-doc.exter_ = temp-cre-doc.exter_ AND
      900                 buf_wth-doc.inter_ = temp-cre-doc.inter_ AND
      901                 buf_wth-doc.doc-type = temp-cre-doc.doc-type AND
      902                 buf_wth-doc.cli-type = temp-cre-doc.cli-type AND
      903                 buf_wth-doc.cli-code = temp-cre-doc.cli-code AND
      904                 buf_wth-doc.doc-date = temp-cre-doc.doc-date AND
      905                 buf_wth-doc.shift-date = temp-cre-doc.shift-date AND
      906                 buf_wth-doc.shift-num = temp-cre-doc.shift-num:
      907         FIND FIRST buf_wth-line No-LOCK WHERE
      908                    buf_wth-line.doc-code = buf_wth-doc.doc-code No-ERROR.
      909         if temp-cre-doc.chk-type = integer('7':U) then do:
      910           if not avail buf_wth-line then do:
      911             vardoc-rec = recid(buf_wth-doc).
      912             LEAVE _buf_wth-doc.
      913           end.
      914         end.
      915         else do:
      916           if not avail buf_wth-line or
      917             ((buf_wth-line.out-code = temp-cre-doc.out-w-p-code
      918               OR
      919               buf_wth-doc.doc-type = 'инв':U)
      920               AND
      921             buf_wth-line.w-p-code = cash_wth-place.w-p-code)
      922             then do:
      923             vardoc-rec = recid(buf_wth-doc).
      924             LEAVE _buf_wth-doc.
      925           end.
      926         end.
      927       END.
      928       if vardoc-rec <> ? then do:
      929         create loc-temp-cash-doc.
      930         assign
      931         loc-temp-cash-doc.chk-type = parchk-type
      932         loc-temp-cash-doc.inter_ =  temp-cre-doc.inter_
      933         loc-temp-cash-doc.exter_  =  temp-cre-doc.exter_
      934         loc-temp-cash-doc.doc-type  =  temp-cre-doc.doc-type
      935         loc-temp-cash-doc.cli-type  =  temp-cre-doc.cli-type
      936         loc-temp-cash-doc.cli-code  =  temp-cre-doc.cli-code
      937         loc-temp-cash-doc.out-w-p-code = temp-cre-doc.out-w-p-code
      938         loc-temp-cash-doc.w-p-code = cash_wth-place.w-p-code
      939         loc-temp-cash-doc.pay-desk = parpay-desk
      940         loc-temp-cash-doc.cashier = par-cashier
      941         loc-temp-cash-doc.doc-code =  buf_wth-doc.doc-code
      942         loc-temp-cash-doc.shift-date = buf_wth-doc.shift-date
      943         loc-temp-cash-doc.shift-num = buf_wth-doc.shift-num
      944         loc-temp-cash-doc.shift-name = buf_wth-doc.shift-name
      945         loc-temp-cash-doc.doc-date = buf_wth-doc.doc-date
      946         loc-temp-cash-doc.fact-date = buf_wth-doc.fact-date
      947         .
      948         return.
      949       end.
      950       else do:
      951        _cre-block:
      952         DO ON ERROR undo _cre-block, return error   :
      953           vardoc-code = '':U.
      954           CASE temp-cre-doc.doc-type:
      955             when 'инв':U then do:
      956               run str/wth-inv1.p (
      957                                 input yes
      958                               ,input-output vardoc-rec
      959                               ,input 'ДОБАВЛЕНИЕ':U
      960                               ,input vardoc-code
      961                               ,input parhost-code
      962                               ,input parobj-type
      963                               ,input parobj-code
      964                               ,input temp-cre-doc.doc-date
      965                               ,input temp-cre-doc.fact-date
      966                               ,input temp-cre-doc.shift-date
      967                               ,input temp-cre-doc.shift-num
      968                               ,input temp-cre-doc.shift-name
      969                               ,input v-cashier-psn-code
      970                               ,input v-cashier-psn-code
      971                               ,input v-cashier-psn-code
      972                               ,input v-cashier-psn-code
      973                               ,input v-cashier-psn-code
      974                               ,input yes
      975                               ,input 0
      976                               ,input 0
      977                               ,input '':U
      978                               ,input 'накл':U
      979                               ,input no
      980                                 ) no-error .
      981             end.
      982             otherwise do:
      983               run str/wth-inc1.p (
      984                                 input yes
      985                               ,input-output vardoc-rec
      986                               ,input 'ДОБАВЛЕНИЕ':U
      987                               ,input vardoc-code
      988                               ,input parhost-code
      989                               ,input parobj-type
      990                               ,input parobj-code
      991                               ,input temp-cre-doc.cli-type
      992                               ,input temp-cre-doc.cli-code
      993                               ,input temp-cre-doc.doc-date
      994                               ,input temp-cre-doc.fact-date
      995                               ,input temp-cre-doc.shift-date
      996                               ,input temp-cre-doc.shift-num
      997                               ,input temp-cre-doc.shift-name
      998                               ,input v-cashier-psn-code
      999                               ,input v-cashier-psn-code
     1000                               ,input v-cashier-psn-code
     1001                               ,input temp-cre-doc.doc-type
     1002                               ,input yes
     1003                               ,input temp-cre-doc.exter_
     1004                               ,input temp-cre-doc.inter_
     1005                               ,input ''
     1006                               ,input '':U
     1007                               ,input no
     1008                               ,input 0
     1009                               ,input 0
     1010                               ,input '':U
     1011                               ,input 'накл':U
     1012                               ,input no
     1013                               ,input temp-cre-doc.ext-doc-type
     1014                                 ) no-error .
     1015             end.
     1016           end CASE.
     1017           if error-status:error then do:
     1018             run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("!!!Ошибка при создании док-та МЦ:&1&2&1&3"                                                     , chr(10)                                                         , error-status:get-message(1)                                                     , return-value )                                       ).
     1019             undo _cre-block, return error ''.
     1020           end.
     1021           FIND FIRST buf_wth-doc No-LOCK WHERE
     1022                       recid(buf_wth-doc) = vardoc-rec No-ERROR.
     1023           if error-status:error then do:
     1024             undo _cre-block, return error return-value.
     1025           end.
     1026           create loc-temp-cash-doc.
     1027           assign
     1028           loc-temp-cash-doc.chk-type = parchk-type
     1029           loc-temp-cash-doc.inter_ =  temp-cre-doc.inter_
     1030           loc-temp-cash-doc.exter_  =  temp-cre-doc.exter_
     1031           loc-temp-cash-doc.doc-type  =  temp-cre-doc.doc-type
     1032           loc-temp-cash-doc.cli-type  =  temp-cre-doc.cli-type
     1033           loc-temp-cash-doc.cli-code  =  temp-cre-doc.cli-code
     1034           loc-temp-cash-doc.out-w-p-code  =  temp-cre-doc.out-w-p-code
     1035           loc-temp-cash-doc.w-p-code  =  cash_wth-place.w-p-code
     1036           loc-temp-cash-doc.pay-desk  =  parpay-desk
     1037           loc-temp-cash-doc.cashier = par-cashier
     1038           loc-temp-cash-doc.doc-code =  buf_wth-doc.doc-code
     1039           loc-temp-cash-doc.shift-date = buf_wth-doc.shift-date
     1040           loc-temp-cash-doc.shift-num = buf_wth-doc.shift-num
     1041           loc-temp-cash-doc.shift-name = buf_wth-doc.shift-name
     1042           loc-temp-cash-doc.doc-date = buf_wth-doc.doc-date
     1043           loc-temp-cash-doc.fact-date = buf_wth-doc.fact-date
     1044           loc-temp-cash-doc.ext-doc-type = buf_wth-doc.ext-doc-type
     1045           .
     1046           if buf_chk-doc.chk-type = integer('7':U) then do:
     1047             loc-temp-cash-doc.chk-doc-code = buf_chk-doc.doc-code.
     1048           end.
     1049           return.
     1050         END.
     1051       end.
     1052     end.
     1053   end procedure.
