     3070           view-as alert-box .
     3071       end.
     3072       else do:
     3073           assign
     3074             l-query-was-opened = true
     3075           .
     3076       end.
     3077     end.
     3078     if l-filter-open-21 = false then do:
     3079       open query br-rattrs for each buf_c-trn-rsn-attr
     3080         where  buf_c-trn-rsn-attr.reason-code = p-reason-code and                         buf_c-trn-rsn-attr.chip-num    <= p-chip-num
     3081         indexed-reposition
     3082     .
     3083         assign
