     1828                 frame fr-D-rattr-0 :virtual-width = v-frame-virtual-width
     1829               .
     1830             end.
     1831             run diasize_position-resize-button in this-procedure .
     1832           end.
     1833           else do:
     1834             if frame fr-D-rattr-0 :scrollable = true
     1835             then do:
     1836               assign
     1837                 frame fr-D-rattr-0 :virtual-width = v-frame-virtual-width
     1838               .
     1839             end.
