     1143     end.
     1144     hide
     1145     sch-num
     1146     in frame fr-D-rattr-0.
     1147   end.
     1148   on CTRL-J of sch-code in frame fr-D-rattr-0 do:
     1149     if input frame fr-D-rattr-0 sch-code <> sch-code then do:
     1150       assign sch-code.
     1151       assign FoundRec = ?
     1152              sch-num  = 0.
     1153       hide
     1154       sch-num
     1155       in frame fr-D-rattr-0.
     1156     end.
     1157     run proc-find-code in this-procedure ( input yes, input sch-code ) no-error.
     1158     if error-status :error then do:
     1159       return no-apply.
     1160     end.
     1161   end.
     1162   on return of sch-code in frame fr-D-rattr-0 do:
     1163     assign sch-code.
     1164     assign FoundRec = ?
     1165            sch-num  = 0.
     1166     hide   sch-num  in frame fr-D-rattr-0.
     1167     run proc-find-code in this-procedure ( input no,  input sch-code ) no-error.
     1168     if error-status :error then do:
     1169       return no-apply.
     1170     end.
     1171   end.
     1172   on mouse-select-dblclick of sch-code in frame fr-D-rattr-0 do:
     1173     if input frame fr-D-rattr-0 sch-code <> sch-code then do:
     1174       assign sch-code.
     1175       assign FoundRec = ?
     1176              sch-num  = 0.
     1177       hide
     1178       sch-num
     1179       in frame fr-D-rattr-0.
     1180     end.
     1181     run proc-find-code in this-procedure ( input yes, input sch-code ) no-error.
     1182     if error-status :error then do:
     1183       return no-apply.
     1184     end.
     1185   end.
     1186   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1187   on F1 of frame fr-D-rattr-0 anywhere do:
     1188     if b-help :sensitive then DO: apply "CHOOSE":U to b-help in frame fr-D-rattr-0. END.
     1189     return no-apply.
     1190   end.
     1191   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1192   on INS of frame fr-D-rattr-0 anywhere do:
     1193     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame fr-D-rattr-0. END.
     1194     return no-apply.
