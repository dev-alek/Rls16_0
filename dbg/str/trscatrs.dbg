     3430   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3431   procedure set-filter-name :
     3432   define input parameter p-filter-name as character no-undo .
     3433     do with frame fr-D-rattr-0:
     3434       if p-filter-name > "" then do:
     3435         assign
     3436           frame fr-D-rattr-0:title
     3437             = frame fr-D-rattr-0:title + "   ФИЛЬТР: " + p-filter-name.
     3438         .
     3439         assign
     3440           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3441         .
     3442       end.
     3443       else do:
     3444         assign
     3445           b-sch :tooltip = ""
     3446         .
     3447       end.
     3448     end.
     3449   end procedure.
     3450   procedure get-mark-string :
     3451     define        parameter buffer loc-buf for ub.c-trn-rsn-attr.
     3452     define output parameter        p-sign  as  character no-undo.
     3453     assign p-sign = ( if lookup( Rec2Char( recid( loc-buf ) ), p-rid-list ) > 0 then chr( 42 ) else chr( 32 ) ).
     3454   end procedure.
     3455   procedure get-action-name :
     3456     define  input parameter p-code as integer   no-undo.
     3457     define output parameter p-name as character no-undo.
     3458     define variable v_code  as character no-undo.
     3459     define variable j_entry as integer   no-undo.
     3460     if p-code = ? or p-code = 0 then do: assign p-name = "":U. end.
     3461     assign v_code  = Int2Char( p-code ).
     3462     assign j_entry = lookup(   v_code, p-act-codes ).
     3463     assign p-name  = ( if j_entry = 0 then "":U else entry( j_entry, p-act-names ) ).
     3464   end procedure.
     3465   procedure proc-find-code :
     3466     define input parameter p-next as logical   no-undo.
     3467     define input parameter p-code as character no-undo.
     3468     assign p-code = replace( p-code, chr(34), chr(34) + chr(34) )
     3469            p-code = replace( p-code, chr(39), chr(39) + chr(39) )
     3470            p-code = chr(34) + p-code + chr(34).
     3471     run OpenBr in this-procedure ( input no,
     3472                                    input p-next,
     3473                                    input substitute( " and buf_c-trn-rsn-attr.attr-code begins &1 ", p-code ) ).
     3474     if v-doc-rec <> ? then do:
     3475       if FoundRec = ? then do: assign FoundRec = v-doc-rec. end.
     3476       if FoundRec = v-doc-rec then do: assign sch-num = 0. end.
     3477       assign  sch-num = sch-num + 1.
     3478       display sch-num with frame fr-D-rattr-0.
     3479     end.
     3480     else do:
     3481       assign  sch-num = 0.
     3482       hide    sch-num in frame fr-D-rattr-0.
     3483     end.
     3484     apply "ENTRY":U to sch-code in frame fr-D-rattr-0.
     3485   end procedure.
