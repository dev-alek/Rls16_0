     1648         or error-status :get-message(1) <> ""
     1649         then do:
     1650           undo move_block, retry move_block .
     1651         end.
     1652         for each buf_temp-browse-handle
     1653           where buf_temp-browse-handle.browse-type = 'height':u
     1654         on error undo move_block, retry move_block
     1655         :
     1656           assign
     1657             buf_temp-browse-handle.browse-handle :height
     1658               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1659             no-error .
     1660           if error-status :error
     1661           or error-status :get-message(1) <> ""
     1662           then do:
     1663             undo move_block, retry move_block .
     1664           end.
     1665         end.
     1666         assign
     1667           frame fr-D-rattr-0 :height = frame fr-D-rattr-0 :height + p-change-value
     1668           no-error .
