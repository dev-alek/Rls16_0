     2008             end.
     2009           end.
     2010         end.
     2011       end.
     2012       else do:
     2013         for each buf_temp-diasize-handle
     2014         on error undo move_block, retry move_block
     2015         :
     2016           assign
     2017             v-object-handle = buf_temp-diasize-handle.handle-value
     2018           .
     2019           if v-object-handle <> v-diasize-resize-button
     2020           then do:
     2021             assign
     2022               v-object-handle :col = v-object-handle :col + p-change-value
     2023               no-error .
     2024             if error-status :error
     2025             or error-status :get-message(1) <> ""
     2026             then do:
     2027               undo move_block, retry move_block .
     2028             end.
     2029           end.
     2030         end.
     2031         for each buf_temp-browse-handle
     2032           where buf_temp-browse-handle.browse-type = 'width':u
     2033         on error undo move_block, retry move_block
     2034         :
     2035           assign
     2036             buf_temp-browse-handle.browse-handle :width
     2037               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2038             no-error .
     2039           if error-status :error
     2040           or error-status :get-message(1) <> ""
     2041           then do:
     2042             undo move_block, retry move_block .
     2043           end.
     2044         end.
     2045         assign
