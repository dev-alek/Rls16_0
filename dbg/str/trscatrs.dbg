        1   define input        parameter parParentProc as widget-handle no-undo.
        2   define input        parameter p-bttns       as character     no-undo.
        3   define input        parameter p-mode        as character     no-undo.
        4   define input        parameter p-reason-code as integer       no-undo.
        5   define input        parameter p-attr-code   as character     no-undo.
        6   define input        parameter p-chip-num    as integer       no-undo.
        7   define input-output parameter p-rid-list    as character     no-undo.
        8   define variable vss-revision    as character no-undo initial "$Revision$":U.
        9   define variable vss-author      as character no-undo initial "$Author$":U.
       10   define variable vss-date        as character no-undo initial "$Date$":U.
       11   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
       12   define variable vss-archive     as character no-undo initial "$Archive$":U.
       13   define variable vss-description as character no-undo initial "История атрибутов оснований (причин) создания документа":U.
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   procedure proc-alt-shift-f2:
       73     if not ibs.th.gbl.gbl-var:rcode
       74   then
       75     run gbl\inidebug.p .
       76   end.
       77   procedure proc-alt-shift-f3:
       78     run gbl/prvssinf.p
       79       ( input this-procedure
       80       ) .
       81   end.
       82   define variable v-inform-launched as logical no-undo initial false .
       83   procedure proc-alt-shift-f4:
       84     define variable v-action as character no-undo .
       85     if v-inform-launched = false then do:
       86       assign
       87         v-inform-launched = true
       88       .
       89       run gbl/d-inform.w
       90         (  input self
       91         ,  input this-procedure
       92         , output v-action
       93         ) no-error .
       94       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       95       assign
       96         v-inform-launched = false
       97       .
       98     end.
       99   end.
      100   procedure proc-alt-f1:
      101     run gbl/corrhelp.p
      102       (input this-procedure
      103       ) .
      104   end .
      105   on alt-shift-f2 anywhere do:
      106     run proc-alt-shift-f2.
      107   end.
      108   on alt-shift-f3 anywhere do:
      109     run proc-alt-shift-f3 in this-procedure .
      110   end.
      111   on alt-shift-f4 anywhere do:
      112     run proc-alt-shift-f4 in this-procedure.
      113   end.
      114   on alt-f1 anywhere do:
      115     run proc-alt-f1 in this-procedure .
      116   end.
      117   define new global shared variable g#library  as handle no-undo .
      118   define new global shared variable g#library2 as handle no-undo .
      119   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      120   define variable c-point  as character no-undo .
      121   define variable tbl      as character no-undo .
      122   define variable join-tbl as character no-undo .
      123   define variable fld      as character no-undo .
      124   define variable lab      as character no-undo .
      125   define variable spr      as character no-undo .
      126   define variable dim      as character no-undo .
      127   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      128   define variable v-waitfram-action01         as character   no-undo .
      129   define variable v-waitfram-action02         as character   no-undo .
      130   define variable v-waitfram-action03         as character   no-undo .
      131   define variable mWaitFramTextBeg            as character   no-undo.
      132   define variable mWaitFramTextEnd            as character   no-undo.
      133   define variable mWaitFramView               as logical     no-undo.
      134   define variable mWaitProcEvent              as logical     no-undo init yes.
      135   define variable mWaitFramInterval           as integer     no-undo init 1 .
      136   define variable mWaitFramStop               as logical     no-undo.
      137   define variable mWaitFramStopUser           as logical     no-undo.
      138   define variable mWaitFramStopTimeOut        as logical     no-undo.
      139   define variable mWaitFramStartProc          as datetime-tz no-undo.
      140   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      141   define button B-WaitFramStop auto-end-key
      142        label "Стоп"
      143        size 10 by 1 tooltip "Остоновить процесс".
      144   define button B-viewProcInfo
      145        label "Информация"
      146        size 15 by 1 tooltip "Информация о процесс".
      147   define frame waitfram
      148     v-waitfram-action01 format "x(72)" no-label skip
      149     v-waitfram-action02 format "x(72)" no-label skip
      150     v-waitfram-action03 format "x(72)" no-label skip
      151     B-viewProcInfo
      152     B-WaitFramStop at row 4 col 30
      153     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      154     .
      155   define new global shared variable mBatchMode as logical no-undo init ?.
      156   define variable mFramBachModHandle as handle no-undo.
      157   mFramBachModHandle = frame waitfram:handle.
      158   define variable mFameOldVis as logical no-undo.
      159   define variable mVisCUrentVin as logical no-undo.
      160   if session:batch-mode
      161   then
      162      mBatchMode = yes.
      163   if mBatchMode = ? then do:
      164     mVisCUrentVin = current-window:visible.
      165     mFameOldVis = mFramBachModHandle:visible.
      166     mFramBachModHandle:visible  = yes.
      167     mBatchMode = mFramBachModHandle:visible ne yes.
      168     mFramBachModHandle:visible = mFameOldVis.
      169     current-window:visible = mVisCUrentVin.
      170   end.
      171    if  log-manager:logfile-name ne ?
      172     then DO:
      173         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      174         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      175         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      176     end.
      177   on choose of B-WaitFramStop in frame waitfram
      178   do:
      179     mWaitFramStop = yes.
      180     mWaitFramStopUser = yes.
      181   end.
      182   function waitfram-check-timeout returns logical():
      183      define variable vtime as int64 no-undo.
      184      if mWaitFramStopTimeOut
      185      then
      186         return yes.
      187      vtime = ( now - mWaitFramStartProc ) / 1000 .
      188      if     mWaitFramTimeOut ne ?
      189         and mWaitFramTimeOut ne 0
      190         and mWaitFramTimeOut lt vtime
      191      then do:
      192         mWaitFramStopTimeOut = yes.
      193      end.
      194      return mWaitFramStopTimeOut.
      195   end.
      196   procedure waitfram-hide :
      197     if not session:batch-mode
      198     then do
      199     on error undo, return error return-value
      200     :
      201       pause 0 before-hide .
      202       if not mBatchMode then
      203         hide frame waitfram .
      204     if     not mWaitFramView
      205        and mWaitProcEvent
      206     then
      207       process events .
      208     end.
      209   end procedure.
      210   procedure waitfram-show :
      211     define input  parameter p-message as character no-undo .
      212     define variable v-left-margin as integer   no-undo .
      213     if not session:batch-mode
      214     then do
      215     on error undo, return error return-value
      216     :
      217       if length(p-message) <= 70 then do:
      218         assign
      219           v-left-margin = integer((70 - length(p-message)) / 2)
      220         .
      221         assign
      222           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      223         .
      224         assign
      225           v-waitfram-action01 = " "
      226           v-waitfram-action02 = " "
      227                                    + fill(" ", v-left-margin)
      228                                    + p-message
      229           v-waitfram-action03 = " "
      230         .
      231       end.
      232       else do:
      233         define variable vRindex1 as integer no-undo.
      234         define variable vRindex2 as integer no-undo.
      235         vRindex1 = r-index(p-message," ",70).
      236         if vRindex1 = 0
      237         then
      238            vRindex1 = 70.
      239         if length(p-message)  <= vRindex1 + 70 then do:
      240           assign
      241             v-waitfram-action01 = " "
      242             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      243             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      244           .
      245         end.
      246         else do:
      247           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      248           if vRindex2 <= vRindex1
      249           then
      250              vRindex2 = vRindex1 + 70.
      251           assign
      252             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      253             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      254             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      255           .
      256         end.
      257       end.
      258       B-viewProcInfo:visible   in frame waitfram = no.
      259       B-viewProcInfo:sensitive in frame waitfram = no.
      260       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      261       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      262       if  (   mWaitFramView
      263          or  mWaitProcEvent)
      264          and not mBatchMode
      265       then
      266          display
      267             v-waitfram-action01 skip
      268             v-waitfram-action02 skip
      269             v-waitfram-action03 skip
      270          with frame waitfram .
      271       if     mWaitFramView
      272          then do:
      273             if     mWaitFramInterval ne ?
      274                and not mBatchMode
      275             then
      276                wait-for go of frame waitfram pause mWaitFramInterval.
      277          end.
      278          else
      279             if     mWaitProcEvent
      280                and not mBatchMode
      281             then
      282                process events .
      283     end.
      284   end procedure.
      285      procedure waitfram-show-this:
      286         define input  parameter iInterval as int64 no-undo.
      287         define variable vtime as int64 no-undo.
      288         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      289         mWaitFramInterval = iInterval.
      290         run waitfram-show (substitute("&1&2 &3&4" ,
      291                                       mWaitFramTextBeg ,
      292                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      293                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      294                                       mWaitFramTextEnd
      295                                      )
      296                           ).
      297      end.
      298      procedure WaitFramRunPause:
      299         define input  parameter iInterval as dec no-undo.
      300         define variable vStart  as datetime-tz no-undo.
      301         define variable vend    as datetime-tz no-undo.
      302         define variable vint as int64 no-undo.
      303         define variable vOk as logical no-undo.
      304         vStart = now.
      305         vend   = vStart.
      306         publish "WaitFramPause" (iInterval,output vOk).
      307         vend   =  now.
      308         vint = vend - vStart.
      309         vint = iInterval - vint / 1000.
      310         if     not mWaitFramStop
      311            and (   vint > 0
      312                 or (    not vOk
      313                     and iInterval eq ?
      314                     )
      315                 )
      316         then
      317            run waitfram-show-this (iInterval).
      318         vend   =  now.
      319         vint = vend - vStart.
      320         vint = iInterval - vint / 1000.
      321         if     not mWaitFramStop
      322            and vint > 0
      323         then do:
      324            run gbl/pause.p (vint * 1000).
      325         end.
      326         if iInterval ne ?
      327         then
      328            publish "WaitFramStop".
      329         waitfram-check-timeout().
      330      end.
      331      procedure WaitFramWaitFor:
      332         define input  parameter iInterval as dec no-undo.
      333         assign
      334            mWaitFramStartProc   = now
      335            mWaitFramStopUser    = no
      336            mWaitFramStopTimeOut = no
      337         .
      338         block-wait:
      339         do while not mWaitFramStop:
      340            run WaitFramRunPause (iInterval).
      341            if  waitfram-check-timeout()
      342            then do:
      343               leave block-wait.
      344            end.
      345         end.
      346         run waitfram-hide.
      347      end.
      348   procedure waitfram-join :
      349     define input  parameter p-line-1  as character no-undo .
      350     define input  parameter p-line-2  as character no-undo .
      351     define input  parameter p-line-3  as character no-undo .
      352     define output parameter p-message as character no-undo .
      353     do
      354     on error undo, return error return-value
      355     :
      356       assign
      357         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      358                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      359                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      360       .
      361     end.
      362   end procedure.
      363   function waitfram-join-function returns character
      364     (input p-line-1 as character
      365     ,input p-line-2 as character
      366     ,input p-line-3 as character
      367     ).
      368     define variable v-message as character no-undo .
      369     run waitfram-join in this-procedure
      370       (input  p-line-1
      371       ,input  p-line-2
      372       ,input  p-line-3
      373       ,output v-message
      374       ) .
      375     return v-message .
      376   end function .
      377   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      378   procedure fltfield-clear :
      379     define output parameter loc-fld as character no-undo.
      380     define output parameter loc-lab as character no-undo .
      381     define output parameter loc-spr as character no-undo .
      382     define output parameter loc-dim as character no-undo .
      383     assign
      384       loc-fld = ""
      385       loc-lab = ""
      386       loc-spr = ""
      387       loc-dim = "0"
      388     .
      389   end procedure .
      390   procedure fltfield-add :
      391     define input        parameter par-fld as character no-undo.
      392     define input        parameter par-lab as character no-undo .
      393     define input        parameter par-spr as character no-undo .
      394     define input-output parameter loc-fld as character no-undo.
      395     define input-output parameter loc-lab as character no-undo .
      396     define input-output parameter loc-spr as character no-undo .
      397     define input-output parameter loc-dim as character no-undo .
      398     do
      399     on error undo, return error
      400     :
      401       assign
      402       loc-fld = if loc-dim = '0'
      403                 then par-fld
      404                 else (loc-fld + chr(44) + par-fld)
      405       loc-lab = if loc-dim = '0'
      406                 then par-lab
      407                 else (loc-lab + chr(44) + par-lab)
      408       loc-spr = if loc-dim = '0'
      409                 then par-spr
      410                 else (loc-spr + chr(44) + par-spr)
      411       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      412                 string(integer(if num-entries(loc-dim) > 1
      413                               then entry(2, loc-dim)
      414                               else entry(1, loc-dim)
      415                               ) + 1)
      416       no-error
      417       .
      418     end.
      419   end procedure.
      420   FUNCTION Int2Char RETURNS CHARACTER ( INPUT i-num AS INTEGER ) :   DEFINE VARIABLE v-str AS CHARACTER NO-UNDO.   RUN conv-int-to-char IN THIS-PROCEDURE ( INPUT i-num, OUTPUT v-str ) NO-ERROR.   RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-str ). END FUNCTION.      PROCEDURE conv-int-to-char :   DEFINE  INPUT PARAMETER p-num AS INTEGER   NO-UNDO.   DEFINE OUTPUT PARAMETER p-str AS CHARACTER NO-UNDO.   DO ON ERROR UNDO, RETURN ERROR :     ASSIGN p-str = TRIM( STRING( p-num, "->>>>>>>>>>>>":U ) ).   END.  END PROCEDURE.
      421   FUNCTION Rec2Char RETURNS CHARACTER ( INPUT i-rec AS RECID ) :
      422     DEFINE VARIABLE v-str AS CHARACTER NO-UNDO.
      423     RUN conv-rec-to-char IN THIS-PROCEDURE ( INPUT i-rec, OUTPUT v-str ) NO-ERROR.
      424     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-str ).
      425   END FUNCTION.
      426   PROCEDURE conv-rec-to-char :
      427     DEFINE  INPUT PARAMETER p-rec AS RECID     NO-UNDO.
      428     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      429     DO ON ERROR UNDO, RETURN ERROR :
      430       ASSIGN p-res = TRIM( STRING( p-rec, "->>>>>>>>>>>9":U ) ).
      431     END.
      432   END PROCEDURE.
      433   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      434   define   temp-table temp-changes no-undo
      435   field f_name as character
      436   field l_name as character
      437   field v_old as character
      438   field v_new as character
      439   field t_name as character
      440   field num_ as integer
      441   field uniq-key-rec as character
      442   field action as integer
      443   field fNotChange as logical
      444   index pi is unique primary
      445   num_
      446   t_name
      447   f_name
      448   index
      449   Chan
      450   fnotChange
      451   t_name
      452   f_name
      453   index imain uniq-key-rec
      454   .
      455   FUNCTION get-all-fields returns character (p-file-name as character ):
      456   define variable v-dop as character no-undo .
      457     find first _file no-lock where _file._file-name = p-file-name no-error .
      458     if not available _file then return "":U.
      459     for each _field no-lock where
      460              _field._file-recid = recid(_file) :
      461       assign
      462       v-dop = v-dop + _field._field-name + chr(44)
      463       .
      464     end.
      465     return trim(v-dop).
      466   END FUNCTION.
      467   PROCEDURE proc-full-temp-changes :
      468     define input  parameter p-act-create as logical   no-undo .
      469     define input  parameter p-act-delete as logical   no-undo .
      470     define input  parameter p-hst-handle as handle    no-undo .
      471     define input  parameter p-main-table as character no-undo .
      472     define input  parameter p-field-list as character no-undo .
      473     define input  parameter p-label-form as character no-undo .
      474     define variable h-new-buf         as handle    no-undo .
      475     define variable h-main-buf        as handle    no-undo .
      476     define variable h-for-comp        as handle    no-undo .
      477     define variable v-inform          as character no-undo .
      478     define variable v-ind             as integer   no-undo .
      479     define variable v-idx-field-qnty  as integer   no-undo .
      480     define variable v-num-entries     as integer   no-undo .
      481     define variable fh                as handle    no-undo .
      482     define variable fh-main           as handle    no-undo .
      483     define variable fh-old            as handle    no-undo .
      484     define variable fh-new            as handle    no-undo .
      485     define variable v-field-name      as character no-undo .
      486     define variable v-field-lvl       as character no-undo .
      487     define variable v-field-form      as character no-undo .
      488     define variable v-search-exp      as character no-undo .
      489     define variable v-srch-main       as character no-undo .
      490     define variable v-word-link       as character no-undo .
      491     define variable v-av-chip-num     as logical   no-undo .
      492     define variable v-main-pi-fld-lst as character no-undo .
      493     define variable v-main-fld-lst    as character no-undo .
      494     define variable v-delim-list      as character no-undo .
      495     define variable v-label           as character no-undo .
      496     define variable v-old-value       as character no-undo case-sensitive.
      497     define variable v-new-value       as character no-undo case-sensitive.
      498     define variable v-chg-fields as character no-undo.
      499     for each temp-changes:
      500       delete temp-changes.
      501     end.
      502     if not p-hst-handle:available then do:
      503       return .
      504     end.
      505     create buffer h-new-buf  for table p-hst-handle .
      506     create buffer h-main-buf for table p-main-table .
      507     assign
      508       v-inform = h-main-buf:index-information(1)
      509       v-ind    = 2
      510     .
      511     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      512     on error undo, return error
      513     :
      514       assign
      515         v-inform = h-main-buf:index-information( v-ind )
      516         v-ind    = v-ind + 1
      517       .
      518     end.
      519     if v-inform = ?
      520       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      521       or entry( 3, v-inform, ",":U ) <> "1":U
      522     then do:
      523       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      524     end.
      525     assign
      526       v-idx-field-qnty = num-entries( v-inform ) - 4
      527     .
      528     if v-idx-field-qnty < 2 then do:
      529       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      530     end.
      531     assign
      532       v-srch-main   = "where":U
      533       v-word-link   = "":U
      534       v-av-chip-num = false
      535       v-delim-list  = "":U
      536     .
      537     do v-ind = 1 to v-idx-field-qnty by 2
      538     on error undo, return error
      539     :
      540       assign
      541         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      542         fh                = p-hst-handle:buffer-field( v-field-name )
      543         fh-main           = h-main-buf:buffer-field( v-field-name )
      544         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      545         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      546       .
      547       if fh:data-type ="character":U then do:
      548         assign
      549           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      550         .
      551       end.
      552       else do:
      553         assign
      554           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      555         .
      556       end.
      557       if v-delim-list = "":U then do:
      558         assign
      559           v-delim-list = ",":U
      560         .
      561       end.
      562       if v-word-link = "":U then do:
      563         assign
      564           v-word-link = "and":U
      565         .
      566       end.
      567     end.
      568     assign
      569       v-delim-list  = "":U
      570     .
      571     do v-ind = 1 to h-main-buf:num-fields
      572     on error undo, return error
      573     :
      574       assign
      575         fh-main      = h-main-buf:buffer-field( v-ind )
      576         v-field-name = fh-main:name
      577       .
      578         assign
      579           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      580         .
      581         if v-delim-list = "":U then do:
      582           assign
      583             v-delim-list = ",":U
      584           .
      585         end.
      586     end.
      587     assign
      588       v-inform = p-hst-handle:index-information(1)
      589       v-ind    = 2
      590     .
      591     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      592     on error undo, return error
      593     :
      594       assign
      595         v-inform = p-hst-handle:index-information( v-ind )
      596         v-ind    = v-ind + 1
      597       .
      598     end.
      599     if v-inform = ?
      600       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      601       or entry( 3, v-inform, ",":U ) <> "1":U
      602     then do:
      603       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      604     end.
      605     assign
      606       v-idx-field-qnty = num-entries( v-inform ) - 4
      607     .
      608     if v-idx-field-qnty < 2 then do:
      609       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      610     end.
      611     assign
      612       v-search-exp  = "where":U
      613       v-word-link   = "":U
      614       v-av-chip-num = false
      615     .
      616     do v-ind = 1 to v-idx-field-qnty by 2
      617     on error undo, return error
      618     :
      619       assign
      620         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      621         fh           = p-hst-handle:buffer-field( v-field-name )
      622         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      623       .
      624       if v-field-name = "chip-num":U then do:
      625         assign
      626           v-search-exp  = substitute( "&1 >", v-search-exp )
      627           v-av-chip-num = true
      628         .
      629       end.
      630       else do:
      631         assign
      632           v-search-exp = substitute( "&1 =", v-search-exp )
      633         .
      634       end.
      635       if fh:data-type ="character":U then do:
      636         assign
      637           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      638         .
      639       end.
      640       else do:
      641         assign
      642           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
      643         .
      644       end.
      645       if v-word-link = "":U then do:
      646         assign
      647           v-word-link = "and":U
      648         .
      649       end.
      650     end.
      651     if v-av-chip-num = false then do:
      652       message
      653         vss-workfile vss-revision vss-description skip
      654         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
      655         "Использование данной процедуры невозможно!" skip
      656         view-as alert-box error .
      657       return error .
      658     end.
      659     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
      660     if not h-new-buf:available then do:
      661       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
      662       if not h-main-buf:available then do:
      663         assign
      664           h-for-comp = ?
      665         .
      666       end.
      667       else do:
      668         assign
      669           h-for-comp = h-main-buf
      670         .
      671       end.
      672     end.
      673     else do:
      674       assign
      675         h-for-comp = h-new-buf
      676       .
      677     end.
      678     assign
      679       v-num-entries = num-entries( v-main-fld-lst, ",":U )
      680     .
      681     do v-ind = 1 to v-num-entries
      682     on error undo, return error return-value
      683     :
      684       assign
      685         v-field-name = entry( v-ind, v-main-fld-lst )
      686         fh-old       = p-hst-handle:buffer-field( v-field-name )
      687         v-old-value  = fh-old:buffer-value()
      688         v-label      = trim( fh-old:label )
      689       .
      690       if ( trim( p-field-list ) <> "":U
      691            and lookup( v-field-name, p-field-list ) > 0
      692          )
      693          or trim( p-field-list ) = "":U
      694       then do:
      695         if h-for-comp <> ? then do:
      696           assign
      697             fh-new      = h-for-comp:buffer-field( v-field-name )
      698             v-new-value = fh-new:buffer-value()
      699           .
      700         end.
      701         else do:
      702           assign
      703             v-new-value = "":U
      704           .
      705         end.
      706           if p-act-create = true then do:
      707             assign
      708               v-old-value = "":U
      709             .
      710           end.
      711           if p-act-delete = true then do:
      712             assign
      713               v-new-value = "":U
      714             .
      715           end.
      716         if v-old-value <> v-new-value
      717         then do:
      718           create temp-changes.
      719           assign
      720             temp-changes.t_name = p-main-table
      721             temp-changes.f_name = v-field-name
      722             temp-changes.l_name = replace( v-label, "&":U, "":U )
      723             temp-changes.v_old  = trim( v-old-value )
      724             temp-changes.v_new  = trim( v-new-value )
      725             temp-changes.num_   = 0
      726             temp-changes.fNotChange = v-old-value eq v-new-value
      727           .
      728         end.
      729       end.
      730     end.
      731     assign
      732       v-num-entries = num-entries( p-label-form, chr(8) )
      733     .
      734     do v-ind = 1 to v-num-entries
      735     on error undo, return error return-value
      736     :
      737       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
      738         assign
      739           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      740           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      741           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      742         .
      743         find first temp-changes
      744           where temp-changes.f_name = v-field-name
      745           no-error .
      746         if available temp-changes then do:
      747           if trim( v-field-lvl ) <> "":U then do:
      748             assign
      749               temp-changes.l_name = v-field-lvl
      750             .
      751           end.
      752           if trim( v-field-form ) <> "":U then do:
      753             assign
      754               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
      755             .
      756             if h-for-comp <> ? then do:
      757               assign
      758                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
      759               .
      760             end.
      761           end.
      762         end.
      763       end.
      764       else do:
      765         message
      766           vss-workfile vss-revision vss-description skip
      767           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
      768           substitute( "список для поля '&1': '&2'"
      769                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      770                       ,entry( v-ind, p-label-form, chr(8) )
      771                     ) skip
      772           substitute( "полный список: &2", p-label-form ) skip
      773           view-as alert-box error .
      774       end.
      775     end.
      776     delete object h-new-buf .
      777     delete object h-main-buf .
      778   END PROCEDURE.
      779   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      780   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      781   procedure fltopend_fltopend :
      782   define input parameter p-parent-handle as handle no-undo .
      783   define input parameter p-qh as handle no-undo .
      784   define input parameter p-flt-open-open-query  as character no-undo .
      785   define input parameter p-where-cond as character no-undo .
      786   define input parameter p-use-indFIRST-query-tail as character no-undo .
      787   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      788   define input parameter p-indexed-reposition as character no-undo .
      789     do
      790     on error undo, return error
      791     :
      792   define variable v-prepare-string as character no-undo .
      793   define variable glog as logical no-undo .
      794   assign
      795   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      796                      p-where-cond + chr(32)  +
      797                      p-use-indFIRST-query-tail + chr(32) +
      798                      p-use-ind-sort-clmn-by + chr(32) +
      799                      p-indexed-reposition
      800   .
      801   assign
      802   glog = p-qh:query-prepare(v-prepare-string) no-error .
      803   if not glog
      804   or error-status:error then do:
      805     message error-status:get-message(1) view-as alert-box .
      806     undo, return error .
      807   end.
      808   assign
      809   glog = p-qh:query-open no-error .
      810   if not glog
      811   or error-status:error then do:
      812     message error-status:get-message(1) view-as alert-box .
      813     undo, return error .
      814   end.
      815     end.
      816   end procedure.
      817   procedure fltopend_fltfindd :
      818   define input parameter p-parent-handle as handle no-undo .
      819   define input parameter p-qh as handle no-undo .
      820   define input parameter p-rowid as rowid no-undo .
      821   define input parameter p-next as logical no-undo .
      822   define input parameter p-lock as integer no-undo .
      823   define input parameter p-bh as handle no-undo .
      824   define input parameter p-where-cond as character no-undo .
      825   define input parameter p-use-index-phrase as character no-undo .
      826   define variable glog as logical no-undo .
      827   define variable v-qh as handle no-undo .
      828   define variable v-bh as handle no-undo .
      829   define variable v-recid as recid no-undo .
      830   define variable v-prepare-string as character no-undo .
      831   do
      832   on error undo, return error
      833   on stop undo, return error
      834   :
      835     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      836     create buffer v-bh for table p-bh buffer-name p-bh:name.
      837     create query v-qh.
      838     v-qh:set-buffers(v-bh).
      839     v-prepare-string = substitute("for each &1 &2 &3"
      840                                     ,v-bh:name
      841                                     ,p-where-cond
      842                                     ,p-use-index-phrase).
      843     glog = v-qh:query-prepare(v-prepare-string) no-error.
      844     if not glog then do:
      845       delete object v-qh.
      846       delete object v-bh.
      847       undo, return error .
      848     end.
      849     glog = v-qh:query-open no-error .
      850     if not glog then do:
      851       delete object v-qh.
      852       delete object v-bh.
      853       undo, return error .
      854     end.
      855     if p-next then do:
      856       v-qh:reposition-to-rowid(p-rowid) no-error .
      857       glog = v-qh:get-next( p-lock) no-error .
      858       glog = v-qh:get-next( p-lock) no-error .
      859       if not glog or v-qh:query-off-end = yes then do:
      860         glog = v-qh:get-first( p-lock) no-error .
      861       end.
      862     end.
      863     else do:
      864       glog = v-qh:get-first( p-lock) no-error .
      865     end.
      866     v-recid = v-bh:recid no-error .
      867     delete object v-qh.
      868     delete object v-bh.
      869     return string(v-recid) .
      870   end.
      871   end procedure.
      872   procedure fltopend_fltfindq :
      873   define input parameter p-parent-handle as handle no-undo .
      874   define input parameter p-qh as handle no-undo .
      875   define input parameter p-next as logical no-undo .
      876   define input parameter p-lock as integer no-undo .
      877   define input parameter p-flt-open-open-query  as character no-undo .
      878   define input parameter p-where-cond as character no-undo .
      879   define input parameter p-use-indFIRST-query-tail as character no-undo .
      880   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      881   define input parameter p-indexed-reposition as character no-undo .
      882   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      883   define variable glog as logical no-undo .
      884   define variable v-qh as handle no-undo .
      885   define variable v-bh as handle no-undo extent 18.
      886   define variable v-rowid as rowid no-undo extent 18.
      887   define variable v-ii as integer no-undo .
      888   define variable v-prepare-string as character no-undo .
      889   do
      890   on error undo, return error
      891   on stop undo, return error
      892   :
      893     create query v-qh.
      894     do v-ii = 1 to p-qh:num-buffers:
      895       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      896       assign
      897       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      898       no-error.
      899       v-qh:add-buffer(v-bh[v-ii]).
      900     end.
      901     assign
      902     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      903                       p-where-cond + chr(32)  +
      904                       p-use-indFIRST-query-tail + chr(32) +
      905                       p-use-ind-sort-clmn-by + chr(32) +
      906                       p-indexed-reposition
      907     .
      908     glog = v-qh:query-prepare( v-prepare-string) no-error .
      909     if not glog then do:
      910       delete object v-qh.
      911       do v-ii = 1 to p-qh:num-buffers:
      912         delete object v-bh[v-ii].
      913       end.
      914       undo, return error .
      915     end.
      916     glog = v-qh:query-open no-error .
      917     if not glog then do:
      918       delete object v-qh.
      919       do v-ii = 1 to p-qh:num-buffers:
      920         delete object v-bh[v-ii].
      921       end.
      922       undo, return error .
      923     end.
      924     if p-next then do:
      925       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      926       glog = v-qh:get-next( p-lock) no-error .
      927       glog = v-qh:get-next( p-lock) no-error .
      928       if not glog or v-qh:query-off-end = yes then do:
      929         glog = v-qh:get-first( p-lock) no-error .
      930       end.
      931     end.
      932     else do:
      933       glog = v-qh:get-first( p-lock) no-error .
      934     end.
      935     do v-ii = 1 to p-qh:num-buffers:
      936       assign
      937       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      938       no-error.
      939     end.
      940     delete object v-qh.
      941     do v-ii = 1 to p-qh:num-buffers:
      942       delete object v-bh[v-ii].
      943     end.
      944   end.
      945   end procedure.
      946   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      947   function usrfulnf returns character ( input p-user-id as character):
      948   define variable v-user-name as character no-undo .
      949   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      950   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      951     (input  p-user-id
      952     ,output v-user-name
      953     ) no-error .
      954   if error-status:error
      955   or v-user-name = ""
      956   then do:
      957     return p-user-id.
      958   end.
      959   else do:
      960     return v-user-name.
      961   end.
      962   end function.
      963   define buffer buf_changes  for temp-changes.
      964   define buffer buf_c-trn-rsn-attr  for ub.c-trn-rsn-attr.
      965   define buffer sch_c-trn-rsn-attr for ub.c-trn-rsn-attr.
      966   define variable filter-point     as character no-undo initial 'c-trn-rsn-attr':U.
      967   define variable filter-point0    as character no-undo initial 'c-trn-rsn-attr':U.
      968   define variable filter-label     as character no-undo initial 'История атрибутов оснований (причин) создания документа':U.
      969   define variable filter-label0    as character no-undo initial 'История атрибутов оснований (причин) создания документа':U.
      970   define variable sort-change-name as character no-undo.
      971   define variable sort-column-name as character no-undo.
      972   define variable sch-field        as character no-undo.
      973   define variable FoundRec         as recid     no-undo.
      974   define variable p-act-codes      as character no-undo initial '99,1,2,3,4,9,51,79':U.
      975   define variable p-act-names      as character no-undo initial 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U.
      976   define variable v-doc-rec          as recid     no-undo.
      977   function mark-string returns character ( buffer loc-buf for ub.c-trn-rsn-attr ) :
      978     define variable v_mark-sign as character no-undo.
      979     run get-mark-string in this-procedure ( buffer loc-buf, output v_mark-sign ).
      980     return ( v_mark-sign ).
      981   end function.
      982   function ShowAction returns character ( input i-act as integer ) :
      983     define variable v_act as character no-undo.
      984     run get-action-name in this-procedure ( input i-act, output v_act ).
      985     return ( v_act ).
      986   end function.
      987   define button b-help   label "Помо&щь"   size-chars 10.00 by 1.00 default.
      988   define button b-mark   label "&*"        size-chars  3.00 by 1.00 default.
      989   define button b-quit    label "Вы&ход"    size-chars 10.00 by 1.00 default auto-end-key.
      990   define button b-sch label "&Фильтр"   size-chars 10.00 by 1.00 default.
      991   define button b-sel label "Вы&бор"    size-chars 10.00 by 1.00 default auto-go.
      992   define variable mark-num as integer   no-undo view-as fill-in size-chars  8.00 by 1.00 format "->>>,>>>":U.
      993   define variable sch-code as character no-undo view-as fill-in size-chars 25.50 by 1.00 format "x(24)":U.
      994   define variable sch-num  as integer   no-undo view-as fill-in size-chars  4.50 by 1.00 format ">>>":U.
      995   define query br-rattrs for buf_c-trn-rsn-attr scrolling.
      996   define query br-changes for buf_changes scrolling.
      997   define browse br-rattrs query br-rattrs display
      998     mark-string( buffer buf_c-trn-rsn-attr ) column-label '*' format 'x(1)':U
      999     buf_c-trn-rsn-attr.attr-code column-label 'Код' format "x(24)":U
     1000     buf_c-trn-rsn-attr.attr-value column-label 'Значение' format "x(69)":U
     1001     usrfulnf(buf_c-trn-rsn-attr.corr-user-name) column-label 'Изменил' format "x(8)":U
     1002     ShowAction( buf_c-trn-rsn-attr.action ) column-label 'Действие' format "x(10)":U
     1003     buf_c-trn-rsn-attr.corr-date column-label 'Дата корр.' format "99/99/9999":U
     1004     STRING( buf_c-trn-rsn-attr.corr-time, 'HH:MM:SS':U ) column-label 'Время' format "x(8)":U
     1005     buf_c-trn-rsn-attr.chip-num column-label 'Щепка' format "->,>>>,>>>,>>9":U
     1006     buf_c-trn-rsn-attr.corr-user-db-num column-label 'БД' format ">>>>9":U
     1007     enable
     1008     buf_c-trn-rsn-attr.attr-value
     1009   with no-row-markers separators size-chars 98.25 by 13.13.
     1010   define browse br-changes query br-changes display
     1011     buf_changes.l_name  column-label 'Изменилось'  format 'x(15)':U
     1012     buf_changes.v_old  column-label 'Было'  format 'x(48)':U
     1013     buf_changes.v_new  column-label 'Стало'  format 'x(48)':U
     1014     enable
     1015     buf_changes.l_name
