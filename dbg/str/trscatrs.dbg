     1201   if valid-handle( active-window ) and frame fr-D-rattr-0 :parent = ? then frame fr-D-rattr-0 :parent = active-window.
     1202   if current-window :window-state = window-minimized then do: current-window :window-state = window-normal. end.
     1203   on window-close of frame fr-D-rattr-0 do: apply "END-ERROR":U to self. end.
     1204   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1205   on help of frame fr-D-rattr-0
     1206   do:
     1207     run gbl/app_help.p
     1208       (input this-procedure :file-name
     1209       ,input ''
     1210       ,input ?
     1211       ) no-error.
     1212     if error-status :error then do:
     1213       message
     1214         "Ошибка при вызове помощи"
     1215         error-status :get-message(1)
     1216         view-as alert-box .
     1217     end.
     1218   end.
     1219   run minbtn-set in this-procedure .
     1220   on choose of b-help in frame fr-D-rattr-0
     1221   do:
     1222     apply "help":u to frame fr-D-rattr-0 .
     1223   end.
     1224   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1225   procedure minbtn-set :
     1226       do
     1227           on error undo, return error return-value
     1228           :
     1229           define variable ii              as integer       no-undo .
     1230           define variable fh              as widget-handle no-undo .
     1231           define variable hh              as widget-handle no-undo .
     1232           define variable v-h             as handle        extent 4 no-undo .
     1233           define variable v-name-button   as character     no-undo .
     1234           define variable v-help-old-x    as decimal       no-undo .
     1235           define variable v-help-old-y    as decimal       no-undo .
     1236           define variable v-help-old-size as decimal       no-undo .
     1237           define variable v-frame-width   as decimal       no-undo .
     1238           define variable jj              as integer       no-undo .
     1239           do
     1240               on error undo, return error
     1241               :
     1242               assign
     1243                   v-frame-width = frame fr-D-rattr-0:width - 0.3
     1244                   fh            = frame fr-D-rattr-0:first-child
     1245                   hh            = fh:first-child
     1246                   ii            = 1
     1247                   .
     1248               do while valid-handle(hh):
     1249                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1250                   do:
     1251                       case lc(hh:name) :
     1252                           when "b-help" then
     1253                               do:
     1254                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1255                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1256                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1257                                   hh:TOOLTIP = "Помощь" .
     1258                                   v-help-old-x = hh:column .
     1259                                   v-help-old-y = hh:row    .
     1260                                   v-help-old-size = hh:width .
     1261                                   hh:width-chars = 2.5 .
     1262                               end.
     1263                           when "b-print" then
     1264                               do:
     1265                                   hh:load-image("cmp/b-print.bmp":u) .
     1266                                   hh:TOOLTIP = "Печать" .
     1267                                   v-h[ii] = hh:handle .
     1268                                   ii = ii + 1 .
     1269                                   hh:width-chars = 3 .
     1270                               end.
     1271                           when "b-history" or
     1272                           when "b-hist" then
     1273                               do:
     1274                                   hh:load-image("cmp/b-hist.bmp":u) .
     1275                                   hh:TOOLTIP = "История" .
     1276                                   v-h[ii] = hh:handle .
     1277                                   ii = ii + 1 .
     1278                                   hh:width-chars = 3 .
     1279                               end.
     1280                           when "b-sch" then
     1281                               do:
     1282                                   hh:load-image("cmp/b-sch.bmp":u) .
     1283                                   hh:TOOLTIP = "Установка Фильтра" .
     1284                                   v-h[ii] = hh:handle .
     1285                                   ii = ii + 1 .
     1286                                   hh:width-chars = 3 .
     1287                               end.
     1288                           when "b-hist-user" then
     1289                               do:
     1290                                   hh:load-image("cmp/b-hist.bmp":u) .
     1291                                   hh:TOOLTIP = "История пользователя" .
     1292                                   ii = ii + 1 .
     1293                               end.
     1294                       end case.
     1295                   end.
     1296                   hh = hh:next-sibling.
     1297               end.
     1298               b-help:column = v-frame-width - b-help:width-chars.
     1299               jj = 0.
     1300               repeat ii = 4 to 1 by -1 :
     1301                   if valid-handle (v-h[ii] ) then
     1302                   do:
     1303                       jj  = jj + 1 .
     1304                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1305                       v-h[ii]:row    = v-help-old-y .
     1306                   end.
     1307               end.
     1308           end.
     1309       end.
     1310   end procedure.
     1311   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1312   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1313   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1314   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1315   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1316   define variable v-diasize-current-frame-height as decimal   no-undo .
     1317   define variable v-diasize-change-size          as logical   no-undo .
     1318   define variable v-diasize-resize-button        as handle    no-undo .
     1319   define variable v-diasize-wndmax               as logical   no-undo .
     1320   define variable v-diasize-wndstore             as logical   no-undo .
     1321   define variable v-diasize-proc-name            as character no-undo .
     1322   define variable v-diasize-browse-handle        as handle    no-undo .
     1323   define variable v-diasize-browse-number        as integer   no-undo .
     1324   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1325   define temp-table temp-diasize-handle no-undo
     1326     field handle-value  as handle
     1327     field save-position as decimal
     1328     index xpk is primary unique handle-value
     1329     .
     1330   define temp-table temp-browse-handle no-undo
     1331     field browse-type   as character
     1332     field browse-number as integer
     1333     field browse-handle as handle
     1334     field original-size as decimal
     1335     index xpk is primary unique browse-type browse-number
     1336     index xie browse-type browse-handle
     1337   .
     1338   procedure diasize_change-height :
     1339     define input  parameter p-change-value  as decimal   no-undo .
     1340     define input  parameter p-move-resize   as logical   no-undo .
     1341     define variable v-field-group-handle    as handle    no-undo .
     1342     define variable v-object-handle         as handle    no-undo .
     1343     define variable v-frame-height          as decimal   no-undo .
     1344     define variable v-frame-virtual-height  as decimal   no-undo .
     1345     define variable v-browse-height         as decimal   no-undo .
     1346     define variable v-window-height         as decimal   no-undo .
     1347     define variable v-window-virtual-height as decimal   no-undo .
     1348     define variable v-change-sign           as integer   no-undo .
     1349     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1350     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1351     if p-change-value > 0
     1352     then do:
     1353       if frame fr-D-rattr-0 :height + p-change-value
     1354           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1355       then do:
     1356         assign
     1357           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1358                           - (frame fr-D-rattr-0 :height-chars)
     1359         .
     1360         if p-change-value <= 0
     1361         then do:
     1362           run diasize_position-resize-button in this-procedure .
     1363           return .
     1364         end.
     1365       end.
     1366     end.
     1367     if p-change-value < 0
     1368     then do:
     1369       if frame fr-D-rattr-0 :height + p-change-value < v-diasize-orig-frame-height
     1370       then do:
     1371         assign
     1372           p-change-value = v-diasize-orig-frame-height
     1373                          - (frame fr-D-rattr-0 :height-chars)
     1374         .
     1375         if p-change-value >= 0
     1376         then do:
     1377           run diasize_position-resize-button in this-procedure .
     1378           return .
     1379         end.
     1380       end.
     1381     end.
     1382     if p-change-value >= 0
     1383     then do:
     1384       assign
     1385         v-change-sign = 1
     1386       .
     1387     end.
     1388     else do:
     1389       assign
     1390         v-change-sign = -1
     1391       .
     1392     end.
     1393     assign
     1394       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1395     .
     1396     if p-change-value = 0
     1397     then do:
     1398       run diasize_position-resize-button in this-procedure .
     1399       return .
     1400     end.
     1401     move_block:
     1402     do
     1403     on error undo move_block, retry move_block
     1404     :
     1405       if retry
     1406       then do:
     1407         do
     1408         on error undo move_block, leave move_block
     1409         :
     1410           if p-change-value > 0
     1411           then do:
     1412             for each buf_temp-diasize-handle
     1413             on error undo, next
     1414             :
     1415               assign
     1416                 v-object-handle = buf_temp-diasize-handle.handle-value
     1417               .
     1418               if v-object-handle <> v-diasize-resize-button
     1419               then do:
     1420                 assign
     1421                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1422                 .
     1423               end.
     1424             end.
     1425             assign
     1426               v-diasize-browse-handle :height = v-browse-height
     1427             .
     1428             for each buf_temp-browse-handle
     1429               where buf_temp-browse-handle.browse-type = 'height':u
     1430             on error undo, next
     1431             :
     1432               assign
     1433                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1434               .
     1435             end.
     1436             assign
     1437               frame fr-D-rattr-0 :height = v-frame-height
     1438             .
     1439             if frame fr-D-rattr-0 :scrollable = true
     1440             then do:
     1441               assign
     1442                 frame fr-D-rattr-0 :virtual-height = v-frame-virtual-height
     1443               .
     1444             end.
     1445             run diasize_position-resize-button in this-procedure .
     1446           end.
     1447           else do:
     1448             if frame fr-D-rattr-0 :scrollable = true
     1449             then do:
     1450               assign
     1451                 frame fr-D-rattr-0 :virtual-height = v-frame-virtual-height
     1452               .
     1453             end.
     1454             assign
     1455               frame fr-D-rattr-0 :height = v-frame-height
     1456             .
     1457             assign
     1458               v-diasize-browse-handle :height = v-browse-height
     1459             .
     1460             for each buf_temp-browse-handle
     1461               where buf_temp-browse-handle.browse-type = 'height':u
     1462             on error undo, next
     1463             :
     1464               assign
     1465                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1466               .
     1467             end.
     1468             for each buf_temp-diasize-handle
     1469             on error undo, next
     1470             :
     1471               assign
     1472                 v-object-handle = buf_temp-diasize-handle.handle-value
     1473               .
     1474               if v-object-handle <> v-diasize-resize-button
     1475               then do:
     1476                 assign
     1477                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1478                 .
     1479               end.
     1480             end.
     1481             run diasize_position-resize-button in this-procedure .
     1482           end.
     1483           assign
     1484             v-diasize-change-size = false
     1485           .
     1486           leave move_block .
     1487         end.
     1488       end.
     1489       assign
     1490         v-diasize-need-full-display = true
     1491       .
     1492       if v-diasize-change-size = false
     1493       then do:
     1494         assign
     1495           v-diasize-change-size = true
     1496         .
     1497       end.
     1498       else do:
     1499         return .
     1500       end.
     1501       assign
     1502         v-frame-height = frame fr-D-rattr-0 :height
     1503         v-frame-virtual-height = frame fr-D-rattr-0 :virtual-height
     1504         v-browse-height = v-diasize-browse-handle :height
     1505       .
     1506       for each buf_temp-browse-handle
     1507         where buf_temp-browse-handle.browse-type = 'height':u
     1508       :
     1509         assign
     1510           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1511         .
     1512       end.
     1513       for each buf_temp-diasize-handle
     1514       :
     1515         delete buf_temp-diasize-handle .
     1516       end.
     1517       assign
     1518         v-field-group-handle = frame fr-D-rattr-0 :first-child
     1519       .
     1520       do while valid-handle(v-field-group-handle)
     1521       :
     1522         assign
     1523           v-object-handle = v-field-group-handle :first-child
     1524         .
     1525         do while valid-handle(v-object-handle)
     1526         :
     1527           if  v-object-handle <> v-diasize-browse-handle :handle
     1528           and can-query(v-object-handle, "row")
     1529           and can-query(v-object-handle, "height")
     1530           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1531           then do:
     1532             find first buf_temp-browse-handle
     1533               where buf_temp-browse-handle.browse-type   = 'height':u
     1534                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1535               no-error .
     1536             if available buf_temp-browse-handle
     1537             then do:
     1538             end.
     1539             else do:
     1540               create buf_temp-diasize-handle .
     1541               assign
     1542                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1543                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1544               .
     1545             end.
     1546           end.
     1547           assign
     1548             v-object-handle = v-object-handle :next-sibling
     1549           .
     1550         end.
     1551         assign
     1552           v-field-group-handle = v-field-group-handle :next-sibling
     1553         .
     1554       end.
     1555       do with frame fr-D-rattr-0
     1556       :
     1557         hide v-diasize-resize-button .
     1558         assign
     1559           v-diasize-resize-button :row    = 1
     1560           v-diasize-resize-button :column = 1
     1561         .
     1562       end.
     1563       if p-change-value > 0
     1564       then do:
     1565         if frame fr-D-rattr-0 :scrollable = true
     1566         then do:
     1567           assign
     1568             frame fr-D-rattr-0 :virtual-height = frame fr-D-rattr-0 :virtual-height + p-change-value
     1569             no-error .
     1570           if error-status :error
     1571           or error-status :get-message(1) <> ""
     1572           then do:
     1573             undo move_block, retry move_block .
     1574           end.
     1575         end.
     1576         assign
     1577           frame fr-D-rattr-0 :height = frame fr-D-rattr-0 :height + p-change-value
     1578           no-error .
     1579         if error-status :error
     1580         or error-status :get-message(1) <> ""
     1581         then do:
     1582           undo move_block, retry move_block .
     1583         end.
     1584         assign
     1585           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1586           no-error .
     1587         if error-status :error
     1588         or error-status :get-message(1) <> ""
     1589         then do:
     1590           undo move_block, retry move_block .
     1591         end.
     1592         for each buf_temp-browse-handle
     1593           where buf_temp-browse-handle.browse-type = 'height':u
     1594         on error undo move_block, retry move_block
     1595         :
     1596           assign
     1597             buf_temp-browse-handle.browse-handle :height
     1598               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1599             no-error .
     1600           if error-status :error
     1601           or error-status :get-message(1) <> ""
     1602           then do:
     1603             undo move_block, retry move_block .
     1604           end.
     1605         end.
