     1078     .
     1079   end.
     1080       br-rattrs :refresh( ) in frame fr-D-rattr-0.
     1081       if last-event :function <> "MOUSE-SELECT-DBLCLICK" then do:
     1082         br-rattrs :select-next-row( ) in frame fr-D-rattr-0.
     1083       end.
     1084       apply "VALUE-CHANGED":U to br-rattrs in frame fr-D-rattr-0.
     1085       if num-entries( p-rid-list ) = 0 then do:
