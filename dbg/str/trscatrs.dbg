     2987   define variable  where-phrase-21     as character no-undo .
     2988   define variable  sort-phrase-21      as character no-undo .
     2989   define variable  where-phrase-rus-21 as character no-undo .
     2990   define variable  sort-phrase-rus-21  as character no-undo .
     2991     run waitfram-show in this-procedure
     2992       (input "ЖДИТЕ ..."
     2993       ).
     2994   run gbl/flt-get.p
