     3051             (" buf_c-trn-rsn-attr.reason-code = p-reason-code and                         buf_c-trn-rsn-attr.chip-num    <= p-chip-num  " + " " + where-phrase-21 = "")
     3052         .
     3053         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3054                             ,input query br-rattrs:handle
     3055                             ,input parameter-3-21
     3056                             ,input parameter-4-21
     3057                             ,input parameter-5-21
     3058                             ,input parameter-6-21
