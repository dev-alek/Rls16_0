     1087         mark-num   in frame fr-D-rattr-0.
     1088       end.
     1089       else do:
     1090         display
     1091         num-entries( p-rid-list ) @ mark-num
     1092         with frame fr-D-rattr-0.
     1093       end.
     1094     END.
     1095     apply "ENTRY":U to br-rattrs in frame fr-D-rattr-0.
     1096   end.
