     3379     run fltfield-add in this-procedure ( input 'corr-user-db-num', input 'Номер БД',            input '':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3380     run fltfield-add in this-procedure ( input 'corr-user-name',   input 'Имя',                 input '':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3381     run fltfield-add in this-procedure ( input 'corr-date',   input 'Дата коррекции',      input '':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3382     run fltfield-add in this-procedure ( input 'corr-time',   input 'Время в секундах',    input '':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3383     run fltfield-add in this-procedure ( input 'action',      input 'Описание действия',   input '':U, input-output fld, input-output lab, input-output spr, input-output dim ) no-error.
     3384     Filter-Block:
     3385     do on error   undo Filter-Block, leave Filter-Block
     3386        on end-key undo Filter-Block, leave Filter-Block :
     3387       run gbl/filter.w ( input parParentProc
     3388                      ,input filter-point + chr(4) + filter-label
     3389                      ,input tbl
     3390                      ,input join-tbl
     3391                      ,input fld
     3392                      ,input lab
     3393                      ,input spr
     3394                      ,input dim            ).
     3395       if return-value = 'undo':U then do:
