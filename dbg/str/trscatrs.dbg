     3025             then  substitute('buf_c-trn-rsn-attr.reason-code = &1 and                         buf_c-trn-rsn-attr.chip-num    <= &2 ', p-reason-code, p-chip-num ) + " " + where-phrase-21
     3026             else "true"
     3027           )
     3028         parameter-5-21 = (" " + "" + " " + "")
     3029         parameter-6-21 = if sort-phrase-21 = ''
