     1613           then do:
     1614             assign
     1615               v-object-handle :row = v-object-handle :row + p-change-value
     1616               no-error .
     1617             if error-status :error
     1618             or error-status :get-message(1) <> ""
     1619             then do:
     1620               undo move_block, retry move_block .
     1621             end.
     1622           end.
     1623         end.
     1624       end.
     1625       else do:
     1626         for each buf_temp-diasize-handle
     1627         on error undo move_block, retry move_block
     1628         :
     1629           assign
     1630             v-object-handle = buf_temp-diasize-handle.handle-value
     1631           .
     1632           if v-object-handle <> v-diasize-resize-button
     1633           then do:
     1634             assign
     1635               v-object-handle :row = v-object-handle :row + p-change-value
     1636               no-error .
     1637             if error-status :error
     1638             or error-status :get-message(1) <> ""
     1639             then do:
     1640               undo move_block, retry move_block .
     1641             end.
     1642           end.
     1643         end.
     1644         assign
     1645           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1646           no-error .
