     3369   procedure proc-filter :
     3370       assign tbl      = 'c-trn-rsn-attr'
     3371            join-tbl = 'buf_c-trn-rsn-attr'
     3372            fld      = '':U
     3373            lab      = '':U
     3374            spr      = '':U
     3375            dim      = '0'.
