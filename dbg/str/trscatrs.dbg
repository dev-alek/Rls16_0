     1879       then do:
     1880         assign
     1881           v-diasize-change-size = true
     1882         .
     1883       end.
     1884       else do:
     1885         return .
     1886       end.
     1887       assign
     1888         v-frame-width = frame fr-D-rattr-0 :width
     1889         v-frame-virtual-width = frame fr-D-rattr-0 :virtual-width
     1890         v-browse-width = v-diasize-browse-handle :width
     1891       .
     1892       for each buf_temp-browse-handle
     1893         where buf_temp-browse-handle.browse-type = 'width':u
