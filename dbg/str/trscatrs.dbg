     2047           no-error .
     2048         if error-status :error
     2049         or error-status :get-message(1) <> ""
     2050         then do:
     2051           undo move_block, retry move_block.
     2052         end.
     2053         assign
     2054           frame fr-D-rattr-0 :width = frame fr-D-rattr-0 :width + p-change-value
     2055         no-error .
     2056         if error-status :error
     2057         or error-status :get-message(1) <> ""
     2058         then do:
     2059           undo move_block, retry move_block.
     2060         end.
     2061         if frame fr-D-rattr-0 :scrollable = true
     2062         then do:
     2063           assign
     2064             frame fr-D-rattr-0 :virtual-width = frame fr-D-rattr-0 :virtual-width + p-change-value
     2065           no-error .
     2066           if error-status :error
     2067           or error-status :get-message(1) <> ""
     2068           then do:
     2069             undo move_block, retry move_block.
     2070           end.
     2071         end.
     2072       end.
     2073       if p-move-resize
     2074       then do:
     2075         run diasize_position-resize-button in this-procedure .
     2076       end.
     2077       if v-diasize-wndstore = true
     2078       then do:
     2079         if connected("ub") = true
     2080         then do:
     2081           define variable v-cntxt-db-num        as integer   no-undo .
     2082           define variable v-cntxt-userid        as character no-undo .
     2083           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2084                                             , OUTPUT v-cntxt-userid
     2085                                             ) .
     2086           run gbl/wndsizew.p
     2087             (input  v-cntxt-db-num
     2088             ,input  v-cntxt-userid
     2089             ,input  v-diasize-proc-name
     2090             ,input  'width':u
     2091             ,input  string(frame fr-D-rattr-0 :width - v-diasize-orig-frame-width)
     2092             ) .
     2093         end.
     2094       end.
     2095     end.
     2096     assign
     2097       v-diasize-change-size = false
     2098     .
     2099   end procedure.
     2100   procedure diasize_set-width :
     2101     define input  parameter p-new-width  as decimal   no-undo .
     2102     define input  parameter p-move-resize as logical   no-undo .
     2103     do
     2104     on error undo, return error return-value
     2105     :
     2106       run diasize_change-width in this-procedure
     2107         (input  (p-new-width - frame fr-D-rattr-0 :width)
     2108         ,input  p-move-resize
     2109         ) .
     2110     end.
     2111   end procedure.
     2112   procedure diasize_position-resize-button :
     2113     do with frame fr-D-rattr-0
     2114     :
     2115       hide v-diasize-resize-button .
     2116       assign
     2117         v-diasize-resize-button :row = frame fr-D-rattr-0 :height - v-diasize-resize-button :height
     2118                     - 1
     2119                     - (frame fr-D-rattr-0 :border-bottom-pixels / session :pixels-per-row)
     2120         v-diasize-resize-button :col = frame fr-D-rattr-0 :width - v-diasize-resize-button :width
     2121                     - 1
     2122                     - (frame fr-D-rattr-0 :border-right-pixels / session :pixels-per-column)
     2123       .
     2124       view v-diasize-resize-button .
     2125     end.
     2126   end procedure.
     2127   on alt-right anywhere
     2128   do:
     2129     run diasize_change-width in this-procedure
     2130       (input 1
     2131       ,input true
     2132       ) .
     2133     return no-apply .
     2134   end.
     2135   on alt-left anywhere
     2136   do:
     2137     run diasize_change-width in this-procedure
     2138       (input -1
     2139       ,input true
     2140       ) .
     2141     return no-apply .
     2142   end.
     2143   on alt-down anywhere
     2144   do:
     2145     run diasize_change-height in this-procedure
     2146       (input 1
     2147       ,input true
     2148       ) .
     2149     return no-apply .
     2150   end.
     2151   on alt-up anywhere
     2152   do:
     2153     run diasize_change-height in this-procedure
     2154       (input -1
     2155       ,input true
     2156       ) .
     2157     return no-apply .
     2158   end.
     2159   on alt-enter of frame fr-D-rattr-0
     2160   do:
     2161     run diasize_maximize in this-procedure
     2162       (input  ?
     2163       ).
     2164     return no-apply .
     2165   end.
     2166   procedure diasize_end-move :
     2167     do
     2168     on error undo, return error return-value
     2169     :
     2170       define variable v-row-delta as decimal   no-undo .
     2171       define variable v-col-delta as decimal   no-undo .
     2172       define variable v-new-row as decimal   no-undo .
     2173       define variable v-new-col as decimal   no-undo .
     2174       assign
     2175         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2176         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2177       .
     2178       assign
     2179         v-row-delta = v-new-row - frame fr-D-rattr-0 :height
     2180         v-col-delta = v-new-col - frame fr-D-rattr-0 :width
     2181       .
     2182       run diasize_change-height in this-procedure
     2183         (input v-row-delta
     2184         ,input true
     2185         ) .
     2186       run diasize_change-width in this-procedure
     2187         (input v-col-delta
     2188         ,input true
     2189         ) .
     2190     end.
     2191   end procedure.
     2192   procedure diasize_maximize :
     2193     define input  parameter p-action as logical   no-undo .
     2194     do
     2195     on error undo, return error return-value
     2196     :
     2197       if p-action = ?
     2198       then do:
     2199         if v-diasize-need-maximize = true
     2200         then do:
     2201           assign
     2202             p-action = true
     2203           .
     2204         end.
     2205         else do:
     2206           assign
     2207             p-action = false
     2208           .
     2209         end.
     2210       end.
     2211       if p-action = true
     2212       then do:
     2213         run diasize_change-height in this-procedure
     2214           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2215               - frame fr-D-rattr-0 :height-chars
     2216           ,input true
     2217           ) .
     2218         run diasize_change-width in this-procedure
     2219           (input session :width-chars
     2220               - frame fr-D-rattr-0 :width-chars
     2221           ,input true
     2222           ) .
     2223         assign
     2224           v-diasize-need-maximize = false
     2225         .
     2226       end.
     2227       else do:
     2228         run diasize_change-width in this-procedure
     2229           (input v-diasize-orig-frame-width
     2230               - frame fr-D-rattr-0 :width-chars
     2231           ,input true
     2232           ) .
     2233         run diasize_change-height in this-procedure
     2234           (input v-diasize-orig-frame-height
     2235               - frame fr-D-rattr-0 :height-chars
     2236           ,input true
     2237           ) .
     2238         assign
     2239           v-diasize-need-maximize = true
     2240         .
     2241       end.
     2242     end.
     2243   end procedure.
     2244   procedure diasize_restore-orig-size :
     2245     do
     2246     on error undo, return error return-value
     2247     :
     2248       assign
     2249         v-diasize-current-frame-width  = frame fr-D-rattr-0 :width
     2250         v-diasize-current-frame-height = frame fr-D-rattr-0 :height
     2251       .
     2252       run diasize_set-height in this-procedure
     2253         (input  v-diasize-orig-frame-height
     2254         ,input  true
     2255         ) .
     2256       run diasize_set-width in this-procedure
     2257         (input  v-diasize-orig-frame-width
     2258         ,input  true
     2259         ) .
     2260     end.
     2261   end procedure.
     2262   procedure diasize_restore-current-size :
     2263     do
     2264     on error undo, return error return-value
     2265     :
     2266       run diasize_set-height in this-procedure
     2267         (input  v-diasize-current-frame-height
     2268         ,input  true
     2269         ) .
     2270       run diasize_set-width in this-procedure
     2271         (input  v-diasize-current-frame-width
     2272         ,input  true
     2273         ) .
     2274     end.
     2275   end procedure.
     2276   procedure diasize_set-browse-handle :
     2277     define input  parameter p-browse-handle as handle   no-undo .
     2278     define buffer buf_temp-browse-handle for temp-browse-handle .
     2279     do
     2280     on error undo, return error return-value
     2281     :
     2282       assign
     2283         v-diasize-browse-handle = p-browse-handle
     2284       .
     2285       for each buf_temp-browse-handle
     2286       on error undo, return error return-value
     2287       :
     2288         delete buf_temp-browse-handle .
     2289       end.
     2290     end.
     2291   end procedure.
     2292   procedure diasize_add_browse :
     2293     define input  parameter p-browse-type   as character no-undo .
     2294     define input  parameter p-browse-handle as handle    no-undo .
     2295     define buffer buf_temp-browse-handle for temp-browse-handle .
     2296     do
     2297     on error undo, return error return-value
     2298     :
     2299       assign
     2300         v-diasize-browse-number = v-diasize-browse-number + 1
     2301       .
     2302       create buf_temp-browse-handle .
     2303       assign
     2304         buf_temp-browse-handle.browse-type   = p-browse-type
     2305         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2306         buf_temp-browse-handle.browse-handle = p-browse-handle
     2307       .
     2308     end.
     2309   end procedure.
     2310   procedure diasize_init :
     2311     define variable v-default-value    as logical   no-undo .
     2312     define variable v-restore-saved    as logical   no-undo .
     2313     define variable v-resize-value-str as character no-undo .
     2314     do
     2315     on error undo, return error return-value
     2316     :
     2317       do with frame fr-D-rattr-0
     2318       :
     2319         assign
     2320           v-diasize-orig-frame-height = frame fr-D-rattr-0 :height
     2321           v-diasize-orig-frame-width  = frame fr-D-rattr-0 :width
     2322           v-diasize-browse-handle     = browse br-rattrs :handle
     2323         .
     2324         create button v-diasize-resize-button
     2325         assign
     2326           parent        = frame fr-D-rattr-0 :first-child
     2327           label         = "s"
     2328           height-pixels = 16
     2329           width-pixels  = 16
     2330           visible       = true
     2331           sensitive     = true
     2332           movable       = true
     2333           triggers:
     2334             on end-move persistent run diasize_end-move in this-procedure .
     2335           end triggers.
     2336         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2337         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2338         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2339         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2340         assign
     2341           v-diasize-wndmax = false
     2342         .
     2343         if connected("ub") = true
     2344         then do:
     2345           define variable v-cntxt-db-num        as integer   no-undo .
     2346           define variable v-cntxt-userid        as character no-undo .
     2347           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2348                                             , OUTPUT v-cntxt-userid
     2349                                             ) .
     2350           run gbl/wndpar_r.p
     2351             (input  v-cntxt-db-num
     2352             ,input  v-cntxt-userid
     2353             ,input  'wndmax':U
     2354             ,output v-diasize-wndmax
     2355             ,output v-default-value
     2356             ) .
     2357         end.
     2358         assign
     2359           v-diasize-wndstore = false
     2360         .
     2361         if connected("ub") = true
     2362         then do:
     2363           run gbl/wndpar_r.p
     2364             (input  v-cntxt-db-num
     2365             ,input  v-cntxt-userid
     2366             ,input  'wndstore':U
     2367             ,output v-diasize-wndstore
     2368             ,output v-default-value
     2369             ) .
     2370         end.
     2371         assign
     2372           v-diasize-proc-name = entry(1, program-name(2), '.')
     2373         .
     2374         if v-diasize-wndstore = true
     2375         then do:
     2376           assign
     2377             v-restore-saved = false
     2378           .
     2379           if connected("ub") = true
     2380           then do:
     2381             run gbl/wndsizer.p
     2382               (input  v-cntxt-db-num
     2383               ,input  v-cntxt-userid
     2384               ,input  v-diasize-proc-name
     2385               ,input  'height':u
     2386               ,output v-resize-value-str
     2387               ) .
     2388             if v-resize-value-str <> '':U
     2389             then do:
     2390               run diasize_change-height in this-procedure
     2391                 (input  integer(v-resize-value-str)
     2392                 ,input  true
     2393                 ) .
     2394               assign
     2395                 v-restore-saved = true
     2396               .
     2397             end.
     2398           end.
     2399           if connected("ub") = true
     2400           then do:
     2401             run gbl/wndsizer.p
     2402               (input  v-cntxt-db-num
     2403               ,input  v-cntxt-userid
     2404               ,input  v-diasize-proc-name
     2405               ,input  'width':u
     2406               ,output v-resize-value-str
     2407               ) .
     2408             if v-resize-value-str <> '':U
     2409             then do:
     2410               run diasize_change-width in this-procedure
     2411                 (input  integer(v-resize-value-str)
     2412                 ,input  true
     2413                 ) .
     2414               assign
     2415                 v-restore-saved = true
     2416               .
     2417             end.
     2418           end.
     2419           if v-restore-saved <> true
     2420           then do:
     2421             if v-diasize-wndmax = true
     2422             then do:
     2423               run diasize_maximize in this-procedure
     2424                 (input  true
     2425                 ) .
     2426             end.
     2427           end.
     2428         end.
     2429         else do:
     2430           if v-diasize-wndmax = true
     2431           then do:
     2432             run diasize_maximize in this-procedure
     2433               (input  true
     2434               ) .
     2435           end.
     2436         end.
     2437       end.
     2438     end.
     2439   end procedure.
     2440   procedure diasize_need-full-display :
     2441     define output parameter p-need-full-display as logical   no-undo .
     2442     do
     2443     on error undo, return error return-value
     2444     :
     2445       assign
     2446         p-need-full-display = v-diasize-need-full-display
     2447       .
     2448       assign
     2449         v-diasize-need-full-display = false
     2450       .
     2451     end.
     2452   end procedure.
     2453   procedure get-context :
     2454      define output parameter p-db-num as integer          no-undo.
     2455      define output parameter p-user-id as character        no-undo.
     2456      define variable v-login               as character    no-undo.
     2457      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2458      define buffer buf_user-login  for ub.user-login .
     2459      do
     2460      on error undo, return error
     2461      :
     2462            FIND FIRST buf_sys-ctrl no-lock.
     2463            ASSIGN
     2464               v-login = USERID("ub")
     2465               p-db-num = buf_sys-ctrl.db-num
     2466            .
     2467            FIND FIRST buf_user-login
     2468                 WHERE buf_user-login.db-num = p-db-num
     2469                   AND buf_user-login.user-login = v-login
     2470                 no-lock
     2471                 no-error
     2472                 .
     2473            IF AVAILABLE buf_user-login
     2474            THEN DO:
     2475               assign
     2476                  p-user-id = buf_user-login.user-id
     2477               .
     2478            END.
     2479      end.
     2480   end procedure.
     2481       run diasize_init in this-procedure .
     2482   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2483   DEF VAR cur-clmn-numbr-rattrs as INT EXTENT 9 no-undo.
     2484   DEF VAR varmvibr-rattrs       as INT no-undo.
     2485   DEF VAR varmvjbr-rattrs       as INT no-undo.
     2486   DEF VAR varmvkbr-rattrs       as INT no-undo.
     2487   DEF VAR varmvlbr-rattrs       as INT no-undo.
     2488   DEF VAR move-elementbr-rattrs as INT no-undo.
     2489   def var jjbr-rattrs           as int no-undo.
     2490   do varmvibr-rattrs = 1 to EXTENT(cur-clmn-numbr-rattrs):
     2491     ASSIGN cur-clmn-numbr-rattrs[varmvibr-rattrs] = varmvibr-rattrs.
     2492   END.
     2493   RUN start-mv-clmnbr-rattrs.
     2494   PROCEDURE start-mv-clmnbr-rattrs:
     2495   def var old-session as logical no-undo.
     2496      old-session = SESSION:IMMEDIATE-DISPLAY.
     2497      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2498      SESSION:IMMEDIATE-DISPLAY = old-session.
     2499   END.
     2500   ON ctrl-cursor-right OF BROWSE br-rattrs do:
     2501     RUN re-move-clmnbr-rattrs ( 2, 9).
     2502   END.
     2503   ON ctrl-cursor-left OF BROWSE br-rattrs do:
     2504     RUN re-move-clmnbr-rattrs (9, 2).
     2505   END.
     2506   PROCEDURE re-move-clmnbr-rattrs:
     2507     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2508     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2509     DO varmvibr-rattrs = 1 TO EXTENT(cur-clmn-numbr-rattrs):
     2510       if cur-clmn-numbr-rattrs[varmvibr-rattrs] = source-column THEN cur-clmn-numbr-rattrs[varmvibr-rattrs] = -1.
     2511     END.
     2512     if br-rattrs:MOVE-COLUMN(source-column, target-column) IN FRAME fr-D-rattr-0 then.
     2513     if source-column > target-column THEN
     2514     DO varmvjbr-rattrs = source-column - 1 to target-column BY -1:
     2515       DO varmvibr-rattrs = 1 TO EXTENT(cur-clmn-numbr-rattrs):
     2516           if cur-clmn-numbr-rattrs[varmvibr-rattrs] = varmvjbr-rattrs THEN DO:
     2517             cur-clmn-numbr-rattrs[varmvibr-rattrs] = cur-clmn-numbr-rattrs[varmvibr-rattrs] + 1.
     2518           END.
     2519       END.
     2520     END.
     2521     ELSE
     2522     DO varmvjbr-rattrs = source-column + 1 to target-column:
     2523       DO varmvibr-rattrs = 1 TO EXTENT(cur-clmn-numbr-rattrs):
     2524         if cur-clmn-numbr-rattrs[varmvibr-rattrs] = varmvjbr-rattrs THEN DO:
     2525           cur-clmn-numbr-rattrs[varmvibr-rattrs] = cur-clmn-numbr-rattrs[varmvibr-rattrs] - 1.
     2526         END.
     2527       END.
     2528     END.
     2529     DO varmvibr-rattrs = 1 TO EXTENT(cur-clmn-numbr-rattrs):
     2530       if cur-clmn-numbr-rattrs[varmvibr-rattrs] = -1 THEN cur-clmn-numbr-rattrs[varmvibr-rattrs] = target-column.
     2531     END.
     2532   END PROCEDURE.
     2533   PROCEDURE ch-clmnbr-rattrs:
     2534     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2535     if cur-clmn-loc <= 2 then do:
     2536       return .
     2537     end.
     2538     DO varmvibr-rattrs = 1 TO EXTENT(cur-clmn-numbr-rattrs):
     2539       if cur-clmn-numbr-rattrs[varmvibr-rattrs] = cur-clmn-loc THEN move-elementbr-rattrs = varmvibr-rattrs.
     2540     END.
     2541     RUN re-move-clmnbr-rattrs (cur-clmn-loc, 2).
     2542   END PROCEDURE.
     2543   PROCEDURE mv-brw-defaultbr-rattrs:
     2544   def var old-session as logical no-undo.
     2545     old-session = SESSION:IMMEDIATE-DISPLAY.
     2546     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2547     do varmvlbr-rattrs = 2 to EXTENT(cur-clmn-numbr-rattrs):
     2548       RUN re-move-clmnbr-rattrs (cur-clmn-numbr-rattrs[varmvlbr-rattrs], varmvlbr-rattrs).
     2549     END.
     2550     RUN start-mv-clmnbr-rattrs.
     2551     SESSION:IMMEDIATE-DISPLAY = old-session.
     2552   END PROCEDURE.
     2553   .
     2554   def var sort-labelbr-rattrs   as character no-undo .
     2555   def var sort-clmnbr-rattrs    as handle    no-undo .
     2556   def var cur-clmnbr-rattrs     as handle    no-undo .
     2557   def var cur-clmn-locbr-rattrs as integer   no-undo .
     2558   def var re-querybr-rattrs     as logical   initial no no-undo .
     2559   on start-search, ctrl-o of br-rattrs in frame fr-D-rattr-0 do:
     2560      run sort-brbr-rattrs
     2561        (input (if available buf_c-trn-rsn-attr
     2562                then recid(buf_c-trn-rsn-attr)
     2563                else ?
     2564               )
     2565        ).
     2566   end.
     2567   PROCEDURE sort-brbr-rattrs :
     2568     define input parameter p-recid as recid no-undo .
     2569     if re-querybr-rattrs = no then do:
     2570       assign
     2571          cur-clmnbr-rattrs = br-rattrs:current-column in frame fr-D-rattr-0
     2572       .
     2573       if sort-clmnbr-rattrs <> ? then sort-clmnbr-rattrs:column-fgcolor = 0.
     2574       if cur-clmnbr-rattrs = sort-clmnbr-rattrs then do:
     2575         assign
     2576            sort-labelbr-rattrs = ""
     2577            sort-clmnbr-rattrs = ?
     2578         .
     2579        end.
     2580        else do:
     2581          assign
     2582            sort-labelbr-rattrs = cur-clmnbr-rattrs:label
     2583            sort-clmnbr-rattrs  = cur-clmnbr-rattrs
     2584            sort-clmnbr-rattrs:column-fgcolor = 4
     2585          .
     2586        end.
     2587      end.
     2588     assign
     2589       cur-clmn-locbr-rattrs = 1
     2590     .
     2591     def var column-handle as handle no-undo .
     2592     column-handle = br-rattrs:first-column.
     2593     do while valid-handle(column-handle) :
     2594       if column-handle = cur-clmnbr-rattrs then do:
     2595         leave .
     2596       end.
     2597       column-handle = column-handle:NEXT-COLUMN.
     2598       assign
     2599         cur-clmn-locbr-rattrs = cur-clmn-locbr-rattrs + 1
     2600       .
     2601     end.
     2602     case sort-labelbr-rattrs:
     2603           when 'Код'  then DO:    assign       sort-column-name = "buf_c-trn-rsn-attr.attr-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2604           when 'Значение'  then DO:    assign       sort-column-name = "buf_c-trn-rsn-attr.attr-value"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2605           when 'Изменил'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1usrfulnf&1, buf_c-trn-rsn-attr.corr-user-name)', chr(34))     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2606           when 'Действие'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1ShowAction&1, buf_c-trn-rsn-attr.action)', chr(34))     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2607           when 'Дата корр.'  then DO:    assign       sort-column-name = "buf_c-trn-rsn-attr.corr-date"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2608           when 'Время'  then DO:    assign       sort-column-name = "STRING( buf_c-trn-rsn-attr.corr-time, 'HH:MM:SS':U )"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2609           when 'Щепка'  then DO:    assign       sort-column-name = "buf_c-trn-rsn-attr.chip-num"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2610           when 'БД'  then DO:    assign       sort-column-name = "buf_c-trn-rsn-attr.corr-user-db-num"     .     run OpenBr in this-procedure ( input yes, input no, input '':U ).   . END.
     2611       otherwise do:
     2612         assign
     2613           sort-column-name = ""
     2614         .
     2615         run OpenBr in this-procedure ( input yes, input no, input '':U ).
     2616           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-rattrs') then do:
     2617             run mv-brw-defaultbr-rattrs.
     2618           end.
     2619         if sort-labelbr-rattrs <> "" then do:
     2620           assign
     2621             cur-clmnbr-rattrs:column-fgcolor = 0
     2622           .
     2623         end.
     2624         assign
     2625           cur-clmn-locbr-rattrs = ?
     2626         .
     2627       end.
     2628     end case.
     2629     if p-recid <> ? then do:
     2630       reposition br-rattrs to recid p-recid no-error.
     2631       apply "value-changed" to br-rattrs in frame fr-D-rattr-0.
     2632     end.
     2633     apply "entry" to br-rattrs in frame fr-D-rattr-0.
     2634   END PROCEDURE.
     2635   procedure re-open-query-srt-clmnbr-rattrs:
     2636   if cur-clmnbr-rattrs = ? then do:
     2637      run OpenBr in this-procedure ( input yes, input no, input '':U ).
     2638   end.
     2639   else do:
     2640      assign re-querybr-rattrs = yes.
     2641      run sort-brbr-rattrs
     2642        (input (if available buf_c-trn-rsn-attr
     2643                then recid(buf_c-trn-rsn-attr)
     2644                else ?
     2645               )
     2646        ).
     2647      assign re-querybr-rattrs = no.
     2648   end.
     2649   end.
     2650   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2651   DEF VAR cur-clmn-numbr-changes as INT EXTENT 3 no-undo.
     2652   DEF VAR varmvibr-changes       as INT no-undo.
     2653   DEF VAR varmvjbr-changes       as INT no-undo.
     2654   DEF VAR varmvkbr-changes       as INT no-undo.
     2655   DEF VAR varmvlbr-changes       as INT no-undo.
     2656   DEF VAR move-elementbr-changes as INT no-undo.
     2657   def var jjbr-changes           as int no-undo.
     2658   do varmvibr-changes = 1 to EXTENT(cur-clmn-numbr-changes):
     2659     ASSIGN cur-clmn-numbr-changes[varmvibr-changes] = varmvibr-changes.
     2660   END.
     2661   RUN start-mv-clmnbr-changes.
     2662   PROCEDURE start-mv-clmnbr-changes:
     2663   def var old-session as logical no-undo.
     2664      old-session = SESSION:IMMEDIATE-DISPLAY.
     2665      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2666      SESSION:IMMEDIATE-DISPLAY = old-session.
     2667   END.
     2668   ON ctrl-cursor-right OF BROWSE br-changes do:
     2669     RUN re-move-clmnbr-changes ( 1, 3).
     2670   END.
     2671   ON ctrl-cursor-left OF BROWSE br-changes do:
     2672     RUN re-move-clmnbr-changes (3, 1).
     2673   END.
     2674   PROCEDURE re-move-clmnbr-changes:
     2675     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2676     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2677     DO varmvibr-changes = 1 TO EXTENT(cur-clmn-numbr-changes):
     2678       if cur-clmn-numbr-changes[varmvibr-changes] = source-column THEN cur-clmn-numbr-changes[varmvibr-changes] = -1.
     2679     END.
     2680     if br-changes:MOVE-COLUMN(source-column, target-column) IN FRAME fr-D-rattr-0 then.
     2681     if source-column > target-column THEN
     2682     DO varmvjbr-changes = source-column - 1 to target-column BY -1:
     2683       DO varmvibr-changes = 1 TO EXTENT(cur-clmn-numbr-changes):
     2684           if cur-clmn-numbr-changes[varmvibr-changes] = varmvjbr-changes THEN DO:
     2685             cur-clmn-numbr-changes[varmvibr-changes] = cur-clmn-numbr-changes[varmvibr-changes] + 1.
     2686           END.
     2687       END.
     2688     END.
     2689     ELSE
     2690     DO varmvjbr-changes = source-column + 1 to target-column:
     2691       DO varmvibr-changes = 1 TO EXTENT(cur-clmn-numbr-changes):
     2692         if cur-clmn-numbr-changes[varmvibr-changes] = varmvjbr-changes THEN DO:
     2693           cur-clmn-numbr-changes[varmvibr-changes] = cur-clmn-numbr-changes[varmvibr-changes] - 1.
     2694         END.
     2695       END.
     2696     END.
     2697     DO varmvibr-changes = 1 TO EXTENT(cur-clmn-numbr-changes):
     2698       if cur-clmn-numbr-changes[varmvibr-changes] = -1 THEN cur-clmn-numbr-changes[varmvibr-changes] = target-column.
     2699     END.
     2700   END PROCEDURE.
     2701   PROCEDURE ch-clmnbr-changes:
     2702     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2703     if cur-clmn-loc <= 1 then do:
     2704       return .
     2705     end.
     2706     DO varmvibr-changes = 1 TO EXTENT(cur-clmn-numbr-changes):
     2707       if cur-clmn-numbr-changes[varmvibr-changes] = cur-clmn-loc THEN move-elementbr-changes = varmvibr-changes.
     2708     END.
     2709     RUN re-move-clmnbr-changes (cur-clmn-loc, 1).
     2710   END PROCEDURE.
     2711   PROCEDURE mv-brw-defaultbr-changes:
     2712   def var old-session as logical no-undo.
     2713     old-session = SESSION:IMMEDIATE-DISPLAY.
     2714     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2715     do varmvlbr-changes = 1 to EXTENT(cur-clmn-numbr-changes):
     2716       RUN re-move-clmnbr-changes (cur-clmn-numbr-changes[varmvlbr-changes], varmvlbr-changes).
     2717     END.
     2718     RUN start-mv-clmnbr-changes.
     2719     SESSION:IMMEDIATE-DISPLAY = old-session.
     2720   END PROCEDURE.
     2721   .
     2722   Main-Block:
     2723   do on error   undo Main-Block, leave Main-Block
     2724      on end-key undo Main-Block, leave Main-Block :
     2725     if lookup( p-mode, 'все,code,one':U ) = 0 then do:
     2726       message vss-workfile skip vss-revision skip vss-date skip( 1 ) vss-description skip( 1 )
     2727               "Неверное значение параметра вызова p-mode:" p-mode
     2728       view-as alert-box error.
     2729       return.
     2730     end.
     2731     if p-mode = 'code':U then do:
     2732       find first sch_c-trn-rsn-attr no-lock where
     2733                  sch_c-trn-rsn-attr.reason-code = p-reason-code and
     2734                  sch_c-trn-rsn-attr.chip-num    = p-chip-num    no-error.
     2735       if not available sch_c-trn-rsn-attr then do:
     2736       end.
     2737     end.
     2738     if p-mode = 'one':U then do:
     2739       find first sch_c-trn-rsn-attr no-lock where
     2740                  sch_c-trn-rsn-attr.reason-code = p-reason-code and
     2741                  sch_c-trn-rsn-attr.attr-code   = p-attr-code   and
     2742                  sch_c-trn-rsn-attr.chip-num    = p-chip-num    no-error.
     2743       if not available sch_c-trn-rsn-attr then do:
     2744       end.
     2745     end.
     2746     if p-rid-list <> "":U then do:
     2747       find first sch_c-trn-rsn-attr no-lock where
     2748           recid( sch_c-trn-rsn-attr ) = integer( entry( 1, p-rid-list ) ) no-error.
     2749       if not available sch_c-trn-rsn-attr then do:
     2750       end.
     2751       assign v-doc-rec = recid( sch_c-trn-rsn-attr ).
     2752     end.
     2753     enable  b-mark when lookup( "b-mark":U,   p-bttns ) > 0 or p-bttns = "*"
     2754             b-sel  when lookup( "b-sel":U, p-bttns ) > 0 or p-bttns = "*"
     2755             b-sch b-help b-quit  br-rattrs br-changes sch-code
     2756     with frame fr-D-rattr-0.
     2757     run OpenBr in this-procedure ( input yes, input no, input '':U ).
     2758     hide mark-num in frame fr-D-rattr-0.
     2759     hide  sch-num in frame fr-D-rattr-0.
     2760     if p-rid-list <> "":U then do: reposition br-rattrs to recid v-doc-rec no-error. end.
     2761     br-rattrs :set-repositioned-row( 5, "CONDITIONAL":U ).
     2762     wait-for go of frame fr-D-rattr-0.
     2763   end.
     2764   hide frame fr-D-rattr-0 no-pause.
     2765   procedure OpenBr :
     2766   define input parameter p-open-query     as logical   no-undo.
     2767   define input parameter p-find-next      as logical   no-undo.
     2768   define input parameter p-find-condition as character no-undo.
     2769   define variable l-query-was-opened as logical   no-undo.
     2770   define variable title0             as character no-undo.
     2771   define variable sort-column-phrase as character no-undo.
     2772   define variable l-open-query       as logical   no-undo.
     2773   define buffer buf_trn-reason for ub.trn-reason.
     2774   case sort-column-name :
     2775     when "":U then do:
     2776       assign sort-column-phrase = "":U.
     2777     end.
     2778     otherwise      do:
     2779      assign sort-column-phrase = "by " + sort-column-name.
     2780     end.
     2781   end case.
     2782   assign
     2783   filter-point = substitute('&1 - &2', filter-point0 , p-mode)
     2784   filter-label = substitute('&1 - &2', filter-label0 , p-mode)
     2785   .
     2786   case p-mode :
     2787     when 'все':U   then do:
     2788       assign
     2789       frame fr-D-rattr-0 :title = "История атрибутов оснований (причин) создания документа".
     2790   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2791   define variable  l-disable-where-19  as logical   no-undo .
     2792   define variable  l-filter-open-19    as logical   .
     2793   define variable  flt-rec-19       as recid     no-undo .
     2794   define variable  filter-name-19      as character no-undo .
     2795   define variable  where-phrase-19     as character no-undo .
     2796   define variable  sort-phrase-19      as character no-undo .
     2797   define variable  where-phrase-rus-19 as character no-undo .
     2798   define variable  sort-phrase-rus-19  as character no-undo .
     2799     run waitfram-show in this-procedure
     2800       (input "ЖДИТЕ ..."
     2801       ).
     2802   run gbl/flt-get.p
     2803     (input filter-point
     2804     ,output flt-rec-19
     2805     ,output filter-name-19
     2806     ,output where-phrase-19
     2807     ,output sort-phrase-19
     2808     ,output where-phrase-rus-19
     2809     ,output sort-phrase-rus-19
     2810     ).
     2811   if p-open-query then do:
     2812       run set-filter-name in this-procedure
     2813         (INPUT filter-name-19
     2814         ) no-error .
     2815     assign
     2816       l-filter-open-19 = false
     2817     .
     2818     if flt-rec-19 <> ?
     2819       or sort-column-phrase > ""
     2820     then do:
     2821       define variable  parameter-2-19 as character no-undo .
     2822       define variable  parameter-3-19 as character no-undo .
     2823       define variable  parameter-4-19 as character no-undo .
     2824       define variable  parameter-5-19 as character no-undo .
     2825       define variable  parameter-6-19 as character no-undo .
     2826       define variable  parameter-7-19 as character no-undo .
     2827         assign
     2828         parameter-3-19 =
     2829                                 "for each buf_c-trn-rsn-attr"
     2830         parameter-4-19 =
     2831           (
     2832             if (" yes " + " " + where-phrase-19) <> ""
     2833             then " yes " + " " + where-phrase-19
     2834             else "true"
     2835           )
     2836         parameter-5-19 = (" " + "" + " " + "")
     2837         parameter-6-19 = if sort-phrase-19 = ''
     2838                              then
     2839           (
     2840           " " + "  " +
     2841             " " + sort-column-phrase +
     2842           " " + "  "
     2843           )
     2844                              else
     2845           (
     2846           " " + "  " +
     2847             " " + sort-column-phrase +
     2848           " " + sort-phrase-19
     2849           )
     2850         parameter-7-19 =
     2851           " indexed-reposition  "
     2852       .
     2853       do
     2854       on stop undo, leave
     2855       on error undo, leave
     2856       :
     2857         assign
     2858           l-disable-where-19 =
     2859             (" yes " + " " + where-phrase-19 = "")
     2860         .
     2861         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2862                             ,input query br-rattrs:handle
     2863                             ,input parameter-3-19
     2864                             ,input parameter-4-19
     2865                             ,input parameter-5-19
     2866                             ,input parameter-6-19
     2867                             ,input parameter-7-19
     2868                             )
     2869         .
     2870         assign
     2871           l-filter-open-19 = true
     2872         .
     2873       end.
     2874       if l-filter-open-19 = false then do:
     2875         message
     2876           "Ошибка при фильтрации / сортировке" skip
     2877           "Будут показаны записи без учета фильтра" skip
     2878           view-as alert-box .
     2879       end.
     2880       else do:
     2881           assign
     2882             l-query-was-opened = true
     2883           .
     2884       end.
     2885     end.
     2886     if l-filter-open-19 = false then do:
     2887       open query br-rattrs for each buf_c-trn-rsn-attr
     2888         where  yes
     2889         indexed-reposition
     2890     .
     2891         assign
     2892           l-query-was-opened = true
     2893         .
     2894     end.
     2895   end.
     2896   else do:
     2897     assign
     2898       v-doc-rec = recid( buf_c-trn-rsn-attr )
     2899     .
     2900     do
     2901     on stop undo, leave
     2902     on error undo, leave
     2903     :
     2904       if query br-rattrs:handle:get-buffer-handle(1) = (buffer buf_c-trn-rsn-attr:handle) then do:
     2905         assign
     2906         parameter-2-19 = (if p-find-next then "true":u else "false":u )
     2907         parameter-4-19 =
     2908           "where ":u + " yes " + " ":u + where-phrase-19 + " ":u + p-find-condition + " " + ""
     2909         parameter-5-19 = "  "
     2910       .
     2911         run fltopend_fltfindd in this-procedure  (
     2912                             input this-procedure:handle
     2913                             ,input query br-rattrs:handle
     2914                             ,input rowid(buf_c-trn-rsn-attr)
     2915                             ,input logical(parameter-2-19)
     2916                             ,input no-lock
     2917                             ,input (buffer buf_c-trn-rsn-attr:handle)
     2918                             ,input parameter-4-19
     2919                             ,input parameter-5-19
     2920                             ) no-error.
     2921         .
     2922         assign
     2923           v-doc-rec = integer(return-value)
     2924           v-fltopend-rowid[1] = ?
     2925         .
     2926       end.
     2927       else do:
     2928         assign
     2929         parameter-2-19 = (if p-find-next then "true":u else "false":u )
     2930         parameter-3-19 =  "for each buf_c-trn-rsn-attr"
     2931         parameter-4-19 =
     2932           (
     2933             if (" yes " + " " + where-phrase-19) <> ""
     2934             then " yes " + " " + where-phrase-19
     2935             else "true"
     2936           )
     2937         parameter-5-19 = (" " + "" + " " + "" + " " + p-find-condition)
     2938         parameter-6-19 = if sort-phrase-19 = ''
     2939                              then
     2940           (
     2941           " " + "  " +
     2942             " " + sort-column-phrase +
     2943           " " + "  "
     2944           )
     2945                              else
     2946           (
     2947           " " + "  " +
     2948             " " + sort-column-phrase +
     2949           " " + sort-phrase-19
     2950           )
     2951         parameter-7-19 =
     2952           " indexed-reposition  "
     2953       .
     2954         run fltopend_fltfindq in this-procedure  (
     2955                             input this-procedure:handle
     2956                             ,input query br-rattrs:handle
     2957                             ,input logical(parameter-2-19)
     2958                             ,input no-lock
     2959                             ,input parameter-3-19
     2960                             ,input parameter-4-19
     2961                             ,input parameter-5-19
     2962                             ,input parameter-6-19
     2963                             ,input parameter-7-19
     2964                             ,output v-fltopend-rowid
     2965                             ) no-error.
     2966         .
     2967         v-doc-rec = ?.
     2968       end.
     2969       assign
     2970         l-query-was-opened = true
     2971       .
     2972     end.
     2973   end.
     2974     run waitfram-hide in this-procedure .
     2975     end.
     2976     when 'code':U then do:
     2977       find first buf_trn-reason no-lock where
     2978                   buf_trn-reason.reason-code = p-reason-code no-error.
     2979       assign frame fr-D-rattr-0 :title =
     2980         substitute( 'История атрибутов основания (причины) "&1" создания документа',
     2981                     ( if available buf_trn-reason then buf_trn-reason.reason-name else Int2Char( p-reason-code ) ) ).
     2982   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2983   define variable  l-disable-where-21  as logical   no-undo .
