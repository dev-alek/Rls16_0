     1691       then do:
     1692         if connected("ub") = true
     1693         then do:
     1694           define variable v-cntxt-db-num        as integer   no-undo .
     1695           define variable v-cntxt-userid        as character no-undo .
     1696           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1697                                             , OUTPUT v-cntxt-userid
     1698                                             ) .
     1699           run gbl/wndsizew.p
     1700             (input  v-cntxt-db-num
     1701             ,input  v-cntxt-userid
     1702             ,input  v-diasize-proc-name
     1703             ,input  'height':u
     1704             ,input  string(frame fr-D-rattr-0 :height - v-diasize-orig-frame-height)
     1705             ) .
     1706         end.
     1707       end.
     1708     end.
     1709     assign
     1710       v-diasize-change-size = false
     1711     .
     1712   end procedure.
     1713   procedure diasize_set-height :
     1714     define input  parameter p-new-height  as decimal   no-undo .
     1715     define input  parameter p-move-resize as logical   no-undo .
     1716     do
     1717     on error undo, return error return-value
     1718     :
     1719       run diasize_change-height in this-procedure
     1720         (input  (p-new-height - frame fr-D-rattr-0 :height)
     1721         ,input  p-move-resize
     1722         ) .
     1723     end.
     1724   end procedure.
     1725   procedure diasize_change-width :
     1726     define input  parameter p-change-value as decimal   no-undo .
     1727     define input  parameter p-move-resize  as logical   no-undo .
     1728     define variable v-field-group-handle   as handle    no-undo .
     1729     define variable v-object-handle        as handle    no-undo .
     1730     define variable v-frame-width          as decimal   no-undo .
     1731     define variable v-frame-virtual-width  as decimal   no-undo .
     1732     define variable v-browse-width         as decimal   no-undo .
     1733     define variable v-window-width         as decimal   no-undo .
     1734     define variable v-window-virtual-width as decimal   no-undo .
     1735     define variable v-change-sign          as integer   no-undo .
     1736     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1737     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1738     if p-change-value > 0
     1739     then do:
     1740       if frame fr-D-rattr-0 :width + p-change-value >
     1741           session :width-chars
     1742       then do:
     1743         assign
     1744           p-change-value = session :width-chars - frame fr-D-rattr-0 :width
     1745         .
     1746         if p-change-value <= 0
     1747         then do:
     1748           run diasize_position-resize-button in this-procedure .
     1749           return .
     1750         end.
     1751       end.
     1752     end.
     1753     if p-change-value < 0
     1754     then do:
     1755       if frame fr-D-rattr-0 :width + p-change-value < v-diasize-orig-frame-width
     1756       then do:
     1757         assign
     1758           p-change-value = v-diasize-orig-frame-width
     1759                          - frame fr-D-rattr-0 :width
     1760         .
     1761         if p-change-value >= 0
     1762         then do:
     1763           run diasize_position-resize-button in this-procedure .
     1764           return .
     1765         end.
     1766       end.
     1767     end.
     1768     if p-change-value >= 0
     1769     then do:
     1770       assign
     1771         v-change-sign = 1
     1772       .
     1773     end.
     1774     else do:
     1775       assign
     1776         v-change-sign = -1
     1777       .
     1778     end.
     1779     assign
     1780       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1781     .
     1782     if p-change-value = 0
     1783     then do:
     1784       run diasize_position-resize-button in this-procedure .
     1785       return .
     1786     end.
     1787     move_block:
     1788     do
     1789     on error undo move_block, leave move_block
     1790     :
     1791       if retry
     1792       then do:
     1793         do
     1794         on error undo move_block, leave move_block
     1795         :
     1796           if p-change-value > 0
     1797           then do:
     1798             for each buf_temp-diasize-handle
     1799             on error undo, next
     1800             :
     1801               assign
     1802                 v-object-handle = buf_temp-diasize-handle.handle-value
     1803               .
     1804               if v-object-handle <> v-diasize-resize-button
     1805               then do:
     1806                 assign
     1807                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1808                 .
     1809               end.
     1810             end.
     1811             assign
     1812               v-diasize-browse-handle :width = v-browse-width
     1813             .
     1814             for each buf_temp-browse-handle
     1815               where buf_temp-browse-handle.browse-type = 'width':u
     1816             on error undo, next
     1817             :
     1818               assign
     1819                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1820               .
     1821             end.
     1822             assign
     1823               frame fr-D-rattr-0 :width = v-frame-width
     1824             .
     1825             if frame fr-D-rattr-0 :scrollable = true
     1826             then do:
