     1122     else IF b-sel :sensitive in frame fr-D-rattr-0 then do:
     1123         apply "CHOOSE":U to b-sel in frame fr-D-rattr-0.
     1124     end.
     1125   end.
     1126   on value-changed of br-rattrs in frame fr-D-rattr-0 do:
     1127     run proc-view-changes in this-procedure no-error.
     1128   end.
     1129   on entry of sch-code in frame fr-D-rattr-0 do:
     1130     if sch-field <> self :name then do:
