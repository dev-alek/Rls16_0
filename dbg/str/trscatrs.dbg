     1915           and can-query(v-object-handle, "row")
     1916           and can-query(v-object-handle, "height")
     1917           and ( v-object-handle :col + v-object-handle :width
     1918                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1919               )
     1920           then do:
     1921             find first buf_temp-browse-handle
     1922               where buf_temp-browse-handle.browse-type   = 'width':u
     1923                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1924               no-error .
     1925             if available buf_temp-browse-handle
     1926             then do:
     1927             end.
     1928             else do:
     1929               create buf_temp-diasize-handle .
     1930               assign
     1931                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1932                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1933               .
     1934             end.
     1935           end.
     1936           assign
     1937             v-object-handle = v-object-handle :next-sibling
     1938           .
     1939         end.
     1940         assign
     1941           v-field-group-handle = v-field-group-handle :next-sibling
     1942         .
     1943       end.
     1944       do with frame fr-D-rattr-0
     1945       :
     1946         hide v-diasize-resize-button .
     1947         v-diasize-resize-button :row = 1.
     1948         v-diasize-resize-button :column = 1.
     1949       end.
     1950       if p-change-value > 0
     1951       then do:
     1952         if frame fr-D-rattr-0 :scrollable = true
     1953         then do:
     1954           assign
     1955             frame fr-D-rattr-0 :virtual-width = frame fr-D-rattr-0 :virtual-width + p-change-value
     1956             no-error .
