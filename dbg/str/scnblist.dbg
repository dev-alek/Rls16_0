     4526   end.
     4527   run create-scnblist-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     4528                                       , input-output v-seq
     4529                                       , input 0
     4530                                       , input '~~':U
     4531                                       , input substitute('Оптимизация списка &1 - &2'
     4532                                                     , stat-line(rs-status)
     4533                                                     , optimize-label)
     4534                                       , input tot-lns
     4535                                       , input 'optimize'
     4536                                       , input rs-status
     4537                                       , input optimize-option
     4538                                       , input '':U
     4539                                       , input ?
     4540                                       ).
     4541   run rs-do in this-procedure ( input no, input no, input 'optimize', input rs-status, input 'ДОБАВЛЕНИЕ':U, input (v-seq - 1)) no-error .
     4542   if error-status:error then do:
     4543     optimize-option = "".
     4544     optimize-label = '':U.
     4545     return no-apply.
