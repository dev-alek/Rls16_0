     4181   PROCEDURE proc-valchg-a-n-c:
     4182     case input frame Dialog-Frame a-n-c :
     4183       when "art" then do:
     4184         apply "entry" to br-list in frame Dialog-Frame.
     4185         hide loc-name loc-code
     4186        loc-b-str
     4187         in frame Dialog-Frame.
     4188         loc-art = "".
     4189       end.
     4190       when "name" then do:
     4191         enable loc-name with frame Dialog-Frame.
     4192         disp loc-name with frame Dialog-Frame.
     4193         hide loc-art loc-code
     4194        loc-b-str
     4195         in frame Dialog-Frame.
     4196         apply "entry" to loc-name in frame Dialog-Frame.
     4197       end.
     4198       when "code"
     4199    or when "DataMatrix" then
     4200       do:
     4201         enable loc-code with frame Dialog-Frame.
     4202         disp loc-code with frame Dialog-Frame.
     4203         hide loc-art loc-name
     4204        loc-b-str
     4205         in frame Dialog-Frame.
     4206         apply "entry" to loc-code in frame Dialog-Frame.
     4207       end.
     4208       when "b-str" then do:
     4209         enable loc-b-str with frame Dialog-Frame.
     4210         disp loc-b-str with frame Dialog-Frame.
     4211         hide loc-art loc-name loc-code in frame Dialog-Frame.
     4212         apply "entry" to loc-b-str in frame Dialog-Frame.
     4213       end.
     4214     end CASE.
     4215   END PROCEDURE.
     4216   PROCEDURE proc-any-printable-br-list :
     4217     if input frame Dialog-Frame a-n-c = "art" then do:
     4218       if last-event:label = " " and
     4219          loc-art = "" then
     4220       return error.
     4221       find first l-scnblist where
     4222                   l-scnblist.artic begins (loc-art + last-event:label)
     4223                  no-lock no-error.
     4224       if available l-scnblist then do:
     4225         loc-art = loc-art + last-event:label.
     4226         disp loc-art with frame Dialog-Frame.
     4227         line-rec = recid (l-scnblist).
     4228         reposition br-list to recid line-rec no-error.
     4229         apply "value-changed" to br-list in frame Dialog-Frame.
     4230       end.
     4231     end.
     4232   END PROCEDURE.
     4233   PROCEDURE proc-backspace-br-list:
     4234     if input frame Dialog-Frame a-n-c = "art" then do:
     4235       if loc-art = "" then
     4236         return error.
     4237       loc-art = substr (loc-art, 1, length (loc-art) - 1).
     4238       find first l-scnblist where
     4239                   l-scnblist.artic begins loc-art
     4240                  no-lock.
     4241       disp loc-art with frame Dialog-Frame.
     4242       line-rec = recid (l-scnblist).
     4243       reposition br-list to recid line-rec no-error.
     4244       apply "value-changed" to br-list in frame Dialog-Frame.
     4245     end.
     4246   END PROCEDURE.
     4247   PROCEDURE proc-mouse-dbl-click-loc-code:
     4248   def var str-code as integer no-undo.
     4249   define variable varresult   as character         no-undo.
     4250   define variable vartype-bc  as character         no-undo.
     4251   define variable varweight   as decimal           no-undo.
     4252   define buffer l-goods for ub.goods.
     4253   define buffer l-bar-code for ub.bar-code.
     4254   define buffer buf_bar-code for ub.bar-code .
     4255   define buffer buf_prod-bc for ub.prod-bc.
     4256   define buffer buf_place for ub.place.
     4257     if
     4258     frame Dialog-Frame
     4259     loc-code <> loc-code:screen-value OR
     4260        last-event:label = "Ctrl-J" then
     4261       contin = no.
     4262     assign
     4263     frame Dialog-Frame
     4264     loc-code
     4265     a-n-c.
     4266       find first l-bar-code no-lock where
     4267             l-bar-code.b-code = integer(loc-code) no-error.
     4268     if available l-bar-code then do:
     4269         if last-event:label = "Ctrl-J" then
     4270           find next l-scnblist where
     4271                    l-scnblist.gds-code = l-bar-code.gds-code
     4272                             and l-scnblist.b-code   = l-bar-code.b-code
     4273                   no-lock no-error.
     4274         else
     4275           find first l-scnblist where
     4276                    l-scnblist.gds-code = l-bar-code.gds-code
     4277                             and l-scnblist.b-code   = l-bar-code.b-code
     4278                   no-lock no-error.
     4279       if available l-scnblist then do:
     4280         line-rec = recid (l-scnblist).
     4281         reposition br-list to recid line-rec no-error.
     4282         apply "value-changed" to br-list in frame Dialog-Frame.
     4283       end.
     4284       else do:
     4285         message "Строка не найдена."
     4286                 view-as alert-box error.
     4287       end.
     4288     end.
     4289     else
     4290       message "Бар-код не найден."
     4291               view-as alert-box error.
     4292     apply "entry" to loc-code in frame Dialog-Frame.
     4293   END PROCEDURE.
     4294   PROCEDURE proc-mouse-dbl-click-loc-b-str:
     4295   def var str-code as integer no-undo.
     4296   define variable varresult   as character         no-undo.
     4297   define variable vartype-bc  as character         no-undo.
     4298   define variable varweight   as decimal           no-undo.
     4299   define buffer l-prod-bc for ub.prod-bc.
     4300   define buffer l-bar-code for ub.bar-code.
     4301   define buffer buf_bar-code for ub.bar-code .
     4302   define buffer buf_prod-bc for ub.prod-bc.
     4303   define buffer buf_place for ub.place.
     4304     assign
     4305     frame Dialog-Frame
     4306     loc-b-str.
     4307   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     4308   (
     4309    input  parparentproc
     4310   ,input  loc-b-str
     4311   ,input  ?
     4312   ,input  p-curr-obj-type
     4313   ,input  p-curr-obj-code
     4314   ,input  yes
     4315   ,input  no
     4316   ,input  varscales-pref45
     4317   ,input  varpgscales-pref45
     4318   ,output varresult
     4319   ,output vartype-bc
     4320   ,output varweight
     4321   ,buffer buf_bar-code
     4322   ,buffer buf_prod-bc
     4323   ,buffer buf_place
     4324   ) no-error.
     4325     if available buf_prod-bc then do:
     4326       find first l-prod-bc where
     4327                   l-prod-bc.b-str = buf_prod-bc.b-str
     4328               AND l-prod-bc.b-code = buf_bar-code.b-code No-LOCK.
     4329       find first l-scnblist where
     4330                   l-scnblist.gds-code = buf_bar-code.gds-code AND
     4331                   l-scnblist.b-code = buf_bar-code.b-code AND
     4332                   l-scnblist.b-str = buf_prod-bc.b-str no-lock no-error.
     4333       if available l-scnblist then do:
     4334         line-rec = recid (l-scnblist).
     4335         reposition br-list to recid line-rec no-error.
     4336         apply "value-changed" to br-list in frame Dialog-Frame.
     4337       end.
     4338       else
     4339         message "Строка не найдена."
     4340                 view-as alert-box error.
     4341     end.
     4342     else do:
     4343       if available buf_bar-code then do:
     4344         find first l-bar-code where
     4345                     l-bar-code.b-code = buf_bar-code.b-code No-LOCK.
     4346         find first l-scnblist where
     4347                     l-scnblist.gds-code = buf_bar-code.gds-code AND
     4348                     l-scnblist.b-code = buf_bar-code.b-code AND
     4349                     l-scnblist.b-str = loc-b-str no-lock no-error.
     4350         if available l-scnblist then do:
     4351           line-rec = recid (l-scnblist).
     4352           reposition br-list to recid line-rec no-error.
     4353           apply "value-changed" to br-list in frame Dialog-Frame.
     4354         end.
     4355         else
     4356           message "Строка не найдена."
     4357                   view-as alert-box error.
     4358       end.
     4359       else
     4360         message "ДопБК не найден."
     4361                 view-as alert-box error.
     4362     end.
     4363     apply "entry" to loc-b-str in frame Dialog-Frame.
     4364   END PROCEDURE.
     4365   PROCEDURE  proc-mouse-dbl-click-loc-name:
     4366     assign
     4367     frame Dialog-Frame
     4368     loc-name.
     4369       if last-event:label = "Ctrl-J" then
     4370         find next l-scnblist where
     4371                   can-find (ub.goods where ub.goods.artic = l-scnblist.artic and
     4372                   ub.goods.prod-type = l-scnblist.prod-type and
     4373                   ub.goods.prod-code = l-scnblist.prod-code and
     4374                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     4375       else
     4376         find first l-scnblist where
     4377                   can-find (ub.goods where ub.goods.artic = l-scnblist.artic and
     4378                   ub.goods.prod-type = l-scnblist.prod-type and
     4379                   ub.goods.prod-code = l-scnblist.prod-code and
     4380                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     4381       if available l-scnblist then do:
     4382         line-rec = recid (l-scnblist).
     4383         reposition br-list to recid line-rec no-error.
     4384            apply "value-changed" to br-list in frame Dialog-Frame.
     4385       end.
     4386       else do:
     4387         message "Строка не найдена."
     4388                 view-as alert-box error.
     4389       end.
     4390     apply "entry" to loc-name in frame Dialog-Frame.
     4391   END PROCEDURE.
     4392   on value-changed of br-list in frame Dialog-Frame do:
     4393   if not available scnblist or recid (scnblist) <> line-rec then do:
     4394       hide loc-art in frame Dialog-Frame.
     4395       loc-art = "".
     4396   end.
     4397   if available scnblist then do:     find ub.clients where ub.clients.obj-type = scnblist.prod-type                    and ub.clients.obj-code = scnblist.prod-code no-lock.     find ub.gds-prt where ub.gds-prt.upper-code = scnblist.prt-root no-lock.     find ub.bar-code where ub.bar-code.gds-code  = scnblist.gds-code                     and ub.bar-code.node-code = ub.gds-prt.node-code                     and ub.bar-code.unit-cli  = scnblist.unit-base                     and ub.bar-code.in-code   = ""                     and ub.bar-code.part-code = "" no-lock.     disp ub.clients.obj-name ub.gds-prt.node-name ub.bar-code.b-code tot-lns @ f-tot-lns with frame Dialog-Frame.   end.   disp tot-lns @ f-tot-lns with frame Dialog-Frame.
     4398   end.
     4399   ON CHOOSE OF b-print IN FRAME Dialog-Frame DO:
     4400   run rep/pri-lst.w (
     4401                  input parparentproc
     4402                , input p-curr-obj-type
     4403                , input p-curr-obj-code
     4404                , input "LIST"
     4405                , input "bb-list").
     4406   apply "entry" to br-list in frame Dialog-Frame.
     4407   END.
     4408   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame DO:
     4409   if not available scnblist then do:
     4410     message "Неправильно выбран товар."
     4411             view-as alert-box error.
     4412     return no-apply.
     4413   end.
     4414   find ub.goods where scnblist.artic = ub.goods.artic
     4415               and scnblist.prod-type = ub.goods.prod-type
     4416               and scnblist.prod-code = ub.goods.prod-code no-lock.
     4417   run str/showgds.p ( input parparentproc
     4418                      ,input this-procedure:handle
     4419                      ,input  goods.gds-code
     4420                      ,input 'ПРОСМОТР':U).
     4421   apply "entry" to br-list in frame Dialog-Frame.
     4422   END.
     4423   ON CHOOSE OF b-hist IN FRAME Dialog-Frame DO:
     4424   define buffer buf_scnblist-hist for scnblist-hist.
     4425   run prn-lib-open-stream  in this-procedure (
     4426                                                input parParentProc
     4427                                               ,input 43
     4428                                               ,input yes
     4429                                               ,input no
     4430                                               ).
     4431   find first buf_scnblist-hist no-lock where buf_scnblist-hist.id = 0 no-error .
     4432   PUT  STREAM PrnLibStream unformatted
     4433   SPACE(25) "История создания списка кодов "
     4434   (if available buf_scnblist-hist
     4435   then buf_scnblist-hist.des
     4436   else "БЕЗЫМЯННЫЙ") skip(0)
     4437   space(25) cur-time-print() skip(1)
     4438   .
     4439   put stream PrnLibStream unformatted
     4440   string("№", "X(9)") chr(32)
     4441   string("Действие", "X(9)") chr(32)
     4442   string("записей", "X(10)") chr(32)
     4443   string(" = итого", "X(12)") chr(32)
     4444   string("Множество", "X(155)")
     4445   skip(0)
     4446   fill('-':U, 9) chr(32)
     4447   fill('-':U, 9) chr(32)
     4448   fill('-':U, 9) chr(32)
     4449   fill('-':U, 12) chr(32)
     4450   fill('-':U, 155)
     4451   skip(0)
     4452   .
     4453   for each buf_scnblist-hist where buf_scnblist-hist.id > 0
     4454   by buf_scnblist-hist.id
     4455   :
     4456     put stream PrnLibStream unformatted
     4457     (if buf_scnblist-hist.line = 0
     4458      then string(buf_scnblist-hist.id, ">>>>>>>>9")
     4459      else fill(chr(32) , 9)
     4460     )  chr(32)
     4461     (if buf_scnblist-hist.item_ <> '':U
     4462      then string(buf_scnblist-hist.hist-mode, "X(8)")
     4463      else fill( chr(32), 8)) chr(32)
     4464     string(buf_scnblist-hist.num-add, "->>>>>>>>9") chr(32) chr(32) chr(32) chr(32)
     4465     string(buf_scnblist-hist.num-recs, ">>>>>>>>9")  chr(32)
     4466     string(buf_scnblist-hist.des, "X(155)") skip.
     4467   end.
     4468   output stream prnlibstream close.
     4469     run prn-lib-prn-file in this-procedure (
     4470                                               input parParentProc
     4471                                               ,input 8
     4472                                               ).
     4473     apply "entry" to br-list in frame Dialog-Frame.
     4474   END.
     4475   ON CHOOSE OF b-clr IN FRAME Dialog-Frame  DO:
     4476   define variable glog as logical no-undo .
     4477   define buffer buf-scnblist-hist for scnblist-hist.
     4478   glog = no.
     4479   message "Удаление всех строк списка. Вы уверены ?"
     4480           view-as alert-box question buttons OK-Cancel update glog.
     4481   if not glog then return no-apply.
     4482   if session:set-wait-state( "COMPILER" )  then .
     4483   for each scnblist:
     4484     delete scnblist.
     4485   end.
