    10686                      ,input-output v-from-date
    10687                      ,input-output v-to-date
    10688                      ) no-error.
    10689   CASE rs-list-method:
    10690     when "parts-end-date-obj":U then do:
    10691       assign
    10692       dsp-rs = substitute("Лок.коды закончившихся партий на &1&2 &3", v-sel-obj-type, v-sel-obj-code, stat-line(rs-status))
    10693       v-item = v-sel-obj-type + chr(3) +
    10694                string(v-sel-obj-code) + chr(3) +
    10695                string(v-from-date, "99/99/9999") + chr(3) +
    10696                string(v-to-date, "99/99/9999")
    10697       .
    10698     end.
    10699     when "parts-ean-end-date-obj":U then do:
    10700       assign
    10701       dsp-rs = substitute("Лок.коды (EAN) закончившихся партий на &1&2 &3", v-sel-obj-type, v-sel-obj-code, stat-line(rs-status))
    10702       v-item = v-sel-obj-type + chr(3) +
    10703                string(v-sel-obj-code) + chr(3) +
    10704                string(v-from-date, "99/99/9999") + chr(3) +
    10705                string(v-to-date, "99/99/9999")
    10706       .
    10707     end.
    10708   END CASE.
    10709   v-no-hist = 0.
    10710   run create-scnblist-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
    10711                                       , input-output v-seq
    10712                                       , input 0
    10713                                       , input '':U
    10714                                       , input dsp-rs
    10715                                       , input tot-lns
    10716                                       , input rs-list-method
    10717                                       , input rs-status
    10718                                       , input v-item
    10719                                       , input '':U
    10720                                       , input ?
    10721                                       ).
    10722   END PROCEDURE.
