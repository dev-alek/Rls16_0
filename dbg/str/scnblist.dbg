     9061                v-rid = recid(buf_db).
     9062             end.
     9063             define variable choice as integer no-undo .
     9064             run gbl/d-askw.w (input "Вопрос",
     9065                                   input  ("На каждом объекте весовые товары взвешиваются" + chr(10)
     9066                                           + "с ипользованием определенного кода" + chr(10)
     9067                                           + "(Атрибут товара на объекте ВЕСОВОЙ КОД)" + chr(10)
     9068                                           + "Определите какие коды включать в выборку"
     9069                                           ),
     9070                                   input "|",
     9071                                   input "Все|Используемые|НЕиспользуемые|Отменить",
     9072                                   input "Все|Взвешиваются c этим кодом|НЕ взвешиваются c этим кодом|Отменить",
     9073                                   input 1,
     9074                                   input 4,
     9075                                   output choice).
     9076             if choice = 4
     9077             then do:
     9078               run UI-on.
     9079               return error.
     9080             end.
     9081             v-recs = num-entries (string(v-rid)).
     9082             do num-rec = 0 to v-recs:
     9083               if num-rec > 0
     9084               then do:
     9085                 v-ref-rec = integer (entry (num-rec, string(v-rid))).
     9086                 find buf_db where recid (buf_db) = integer(entry(num-rec, string(v-rid))) no-lock.
     9087               end.
     9088               if num-rec = 0 then do:
     9089                 case choice:
     9090                   when 1 then do:
     9091                     assign
     9092                     dsp-rs = dsp-rs-option
     9093                     .
     9094                   end.
     9095                   when 2 then do:
     9096                     assign
     9097                     dsp-rs = substitute("&1 используемые для взвешивания", dsp-rs-option)
     9098                     .
     9099                   end.
     9100                   when 3 then do:
     9101                     assign
     9102                     v-item_    = substitute("&1 НЕиспользуемые для взвешивания", dsp-rs-option)
     9103                     .
     9104                   end.
     9105                 end case.
