     9131                     .
     9132                   end.
     9133                 end case.
     9134                 assign
     9135                 v-temp-seq = v-seq - 1
     9136                 v-line     = num-rec
     9137                 dsp-rs =  substitute("     БД &1", buf_db.db-num)
     9138                 v-tbl-name =  ''
     9139                 v-bh       = ?
     9140                 v-tot-lns = tot-lns + num-rec
     9141                 .
     9142               end.
     9143               v-no-hist = num-rec.
