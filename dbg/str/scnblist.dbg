     3856           SIDE-LABELS NO-UNDERLINE THREE-D SCROLLABLE
     3857           TITLE "СПИСОК  КОДОВ":L
     3858           DEFAULT-BUTTON b-exit.
     3859   ASSIGN
     3860     b-save:POPUP-MENU IN FRAME Dialog-Frame = MENU m-save:HANDLE
     3861     FRAME Dialog-Frame:SCROLLABLE = FALSE
     3862     b-save:MENU-MOUSE = 1
     3863     b-optimize:POPUP-MENU IN FRAME Dialog-Frame = MENU m-optimize:HANDLE
     3864     b-optimize:MENU-MOUSE = 1
     3865     .
     3866   on
