     9235           c-point = "bb-list" + chr(4) + "Список кодов" + chr(4) + "no"
     9236           .
     9237           define variable v-flt-rec as recid no-undo .
     9238           define variable v-filter-name as character no-undo .
     9239           define variable where-phrase as character no-undo .
     9240           define variable sort-phrase as character no-undo .
     9241           define variable where-phrase-rus as character no-undo .
     9242           define variable sort-phrase-rus as character no-undo .
     9243           run fltfield-add in this-procedure('part-code', '№ партии', '',
     9244           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9245           run fltfield-add in this-procedure('in-code', '№ ПН', '',
     9246           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9247           run fltfield-add in this-procedure('cli-base-rate', 'Коэфф', '',
     9248           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9249           run fltfield-add in this-procedure('unit-cli', 'Ед.изм.', 'unit',
     9250           input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     9251           run gbl/filter.w ( input parparentproc
     9252                             ,input c-point
     9253                             ,input tbl
     9254                             ,input join-tbl
     9255                             ,input fld
     9256                             ,input lab
     9257                             ,input spr
     9258                             ,input dim).
     9259           run gbl/flt-get.p (
     9260                            input  c-point
     9261                           ,output v-flt-rec
     9262                           ,output v-filter-name
     9263                           ,output where-phrase
     9264                           ,output sort-phrase
     9265                           ,output where-phrase-rus
     9266                           ,output sort-phrase-rus  ).
     9267           if v-flt-rec = ? then do:
     9268             run UI-on in this-procedure.
     9269             return error.
     9270           end.
     9271           else do:
     9272             find ubflt.filter where recid (ubflt.filter) = v-flt-rec no-lock.
     9273             run create-scnblist-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     9274                                                 , input-output v-seq
     9275                                                 , input 0
     9276                                                 , input '':U
     9277                                                 , input substitute("Фильтр : &1 &2 &3", ubflt.filter.naim, ubflt.filter.where-ysl-rus, stat-line(rs-status))
     9278                                                 , input tot-lns
     9279                                                 , input rs-list-method
     9280                                                 , input rs-status
     9281                                                 , input ubflt.filter.where-ysl
     9282                                                 , input '':U
     9283                                                 , input ?
     9284                                                 ).
     9285           end.
     9286         end.
     9287         otherwise do:
     9288           message "Неизвестный" rs-list-method view-as alert-box .
     9289         end.
     9290        end CASE.
     9291       if tot-lns <> 0 then do:
     9292         run get-operation in this-procedure (input dsp-rs, output v-operation) no-error .
     9293         CASE v-operation:
     9294           when 1 then do:
     9295             run proc-b-add in this-procedure(no, ?, rs-list-method, rs-status) no-error  .
     9296           end.
     9297           when 2 then do:
     9298             run proc-b-del in this-procedure(no, ?, rs-list-method, rs-status ) no-error  .
     9299           end.
     9300           when 3 then do:
     9301             run proc-b-rest in this-procedure(no, ?, rs-list-method, rs-status) no-error  .
     9302           end.
     9303           otherwise do:
     9304             assign
     9305             dsp-rs = "":U.
     9306             run UI-on.
     9307             return error.
     9308           end.
     9309         END CASE.
     9310         if error-status:error then do:
     9311           run UI-on.
     9312           return error return-value .
     9313         end.
     9314       end.
     9315       assign
     9316       rs-list-method = temp-list.fvalue
     9317       .
     9318       find last buf_scnblist-hist no-lock where
     9319                 buf_scnblist-hist.id = (v-seq - 1)
     9320           and  buf_scnblist-hist.line = 0 no-error .
     9321       DISPLAY
     9322       (if available buf_scnblist-hist
     9323       then buf_scnblist-hist.des
     9324       else '') @ dsp-rs
     9325       with frame Dialog-Frame.
     9326       if tot-lns = 0
     9327       then do:
     9328         run proc-b-add in this-procedure(no, ?, rs-list-method, rs-status)  .
     9329       end.
     9330     end.
     9331   end.
     9332   end procedure.
     9333   procedure proc-scn-tsd :
     9334     do
     9335     on error undo, return error
     9336     :
     9337     assign
     9338       f-name = "default.inv"
     9339       glog = yes
     9340       .
     9341     system-dialog get-file f-name
     9342       filters "Инвентаризация касса *.inv" "*.inv"
     9343       ask-overwrite
     9344       save-as
     9345       use-filename
     9346       update glog
     9347       default-extension "inv".
     9348     if not glog then do:
     9349       apply "entry" to br-list in frame Dialog-Frame.
     9350       return no-apply.
     9351     end.
     9352     run waitfram-show in this-procedure ("Сохранение в формате мобильного сканера.    ЖДИТЕ...").
     9353     output to value (f-name).
     9354     for each scnblist:
     9355       if scnblist.in-code = ""
     9356       and ub.bar-code.part-code = "" then do:
     9357         if scnblist.qnty <> 0 then
     9358         put unformatted string (ub.bar-code.b-code) + "," + string (scnblist.qnty) skip.
     9359       end.
     9360     end.
     9361     output close.
     9362     run waitfram-hide in this-procedure .
     9363     end.
     9364   end procedure.
     9365   procedure proc-b-add :
     9366   define input parameter p-from-macro as logical no-undo .
     9367   define input parameter p-rowid as rowid no-undo .
     9368   define input parameter rs-list-method as character no-undo .
     9369   define input parameter rs-status as character no-undo .
     9370     do
     9371     on error undo, return error
     9372     :
     9373     line-mode = 'ДОБАВЛЕНИЕ':U.
     9374     if rs-list-method = "single" then do:
     9375        v-no-hist = - 1.
     9376       if p-from-macro then do:
     9377       end.
     9378       else do:
     9379         assign
     9380         frame Dialog-Frame
     9381         T-all-prt
     9382         T-bc-alt
     9383         T-bc-base
     9384         T-loc-alt
     9385         T-loc-base
     9386         T-parts-all
     9387         T-parts-not-blank
     9388         T-parts-ser
     9389         T-pb-alt
     9390         T-pb-base
     9391         T-sc-base
     9392         .
     9393         if (
     9394         T-all-prt or
     9395         T-bc-alt  or
     9396         T-bc-base or
     9397         T-loc-alt or
     9398         T-loc-base  or
     9399         T-parts-all  or
     9400         T-parts-not-blank or
     9401         T-parts-ser or
     9402         T-pb-alt    or
     9403         T-pb-base   or
     9404         T-sc-base) = no then do:
     9405           message
     9406           "Не выбран ни один тип кодов!"
     9407           view-as alert-box error .
     9408           undo, return error .
     9409         end.
     9410         assign
     9411         temp-shop.obj-code = p-curr-obj-code
     9412         temp-shop.all-prt = T-all-prt
     9413         temp-shop.cd-bc-alt = T-bc-alt
     9414         temp-shop.cd-bc-base = T-bc-base
     9415         temp-shop.cd-loc-alt = T-loc-alt
     9416         temp-shop.cd-loc-base = T-loc-base
     9417         temp-shop.cd-parts-all = T-parts-all
     9418         temp-shop.cd-parts-not-blank = T-parts-not-blank
     9419         temp-shop.cd-parts-ser = T-parts-ser
     9420         temp-shop.cd-pb-alt = T-pb-alt
     9421         temp-shop.cd-pb-base = T-pb-base
     9422         temp-shop.cd-sc-base = T-sc-base
     9423         .
     9424       end.
     9425       if p-from-macro then do:
     9426         find ub.goods where rowid(ub.goods) = p-rowid no-lock no-error .
     9427       end.
     9428       else do:
     9429         run ref/gds-ref.p ( input parparentproc
     9430                         ,input "b-sel,b-add"
     9431                         ,input ?
     9432                         ,input ?
     9433                         ,input ?
     9434                         ,input ?
     9435                         ,input ?
     9436                         ,input ?
     9437                         ,input ?
     9438                         ,input p-curr-obj-type
     9439                         ,input p-curr-obj-code
     9440                         ,input ?
     9441                         ,output ref-list).
     9442         apply "entry" to br-list in frame Dialog-Frame.
     9443         if ref-list = "" then
     9444           return no-apply.
     9445         find goods where recid (goods) = integer (ref-list) no-lock no-error.
     9446       end.
     9447       if available goods then do:
     9448         run process-one-good in this-procedure (input rs-list-method, input rs-status, input line-mode ,buffer goods) no-error .
     9449         tot-lns = tot-lns + lns-cnt.
     9450         run write-hist(p-from-macro, rs-list-method, rs-status, line-mode, buffer goods).
     9451       end.
     9452       else do:
     9453         return error "Нет в БД такого товара".
     9454       end.
     9455       run UI-on.
     9456     end.
     9457     else
     9458       run rs-do(no, no, rs-list-method, rs-status, line-mode, v-seq - 1).
     9459     end.
     9460   end procedure.
     9461   procedure proc-b-del :
     9462   define input parameter p-from-macro as logical no-undo .
     9463   define input parameter p-rowid as rowid no-undo .
     9464   define input parameter rs-list-method as character no-undo .
     9465   define input parameter rs-status as character no-undo .
     9466   define variable v-rep-rec as recid no-undo .
     9467   define buffer buf_prod-bc for ub.prod-bc.
     9468   define buffer buf_bar-code for ub.bar-code.
     9469     do
     9470     on error undo, return error
     9471     :
     9472       line-mode = 'удаление':U.
     9473       if rs-list-method begins "single" then do:
     9474        v-no-hist = - 1.
     9475         if p-from-macro then do:
     9476           CASE entry(2, rs-list-method, chr(4) ):
     9477             when 'prod-bc':U then do:
     9478               find first buf_prod-bc where rowid(buf_prod-bc) = p-rowid no-error.
     9479               if not available buf_prod-bc then return error "Нет в БД такого ДопБК".
     9480               find first scnblist where
     9481                          scnblist.b-code = buf_prod-bc.b-code
     9482                      AND scnblist.b-str = buf_prod-bc.b-str no-error.
     9483             end.
     9484             when 'bar-code':U
     9485             or
     9486             when 'loc-ean':U then do:
     9487               find first buf_bar-code where rowid(buf_bar-code) = p-rowid no-error.
     9488               if not available buf_bar-code then return error "Нет в БД такого кода".
     9489               find first scnblist where
     9490                          scnblist.b-code = buf_bar-code.b-code
     9491                      AND scnblist.loc-ean = (if entry(2, rs-list-method, chr(4)) = 'bar-code':U then no else yes) no-error.
     9492             end.
     9493           END CASE.
     9494         end.
     9495         if available scnblist then do:
     9496           line-rec = recid (scnblist).
     9497           get next br-list.
     9498           if available scnblist then v-rep-rec = recid (scnblist).
     9499           else do:
     9500             reposition br-list to recid line-rec no-error.
     9501             get prev br-list.
     9502             if available scnblist then v-rep-rec = recid (scnblist).
     9503           end.
     9504           reposition br-list to recid line-rec no-error.
     9505           tot-lns = tot-lns - 1.
     9506           run write-hist(p-from-macro, rs-list-method, rs-status, line-mode, buffer ub.goods).
     9507           delete scnblist.
     9508           line-rec = v-rep-rec.
     9509           run UI-on.
     9510         end.
     9511         else do:
     9512           return error "Нет в списке кодов такого кода".
     9513         end.
     9514       end.
     9515       else do:
     9516         glog = no.
     9517         message "Удалить коды ПО заданному УСЛОВИЮ ?   Вы уверены ?"
     9518                 view-as alert-box question buttons OK-Cancel update glog.
     9519         if not glog then  return error.
     9520         run rs-do(no, no, rs-list-method, rs-status, line-mode, v-seq - 1).
     9521       end.
     9522     end.
     9523   end procedure.
     9524   procedure proc-b-rest :
     9525   define input parameter p-from-macro as logical no-undo .
     9526   define input parameter p-rowid as rowid no-undo .
     9527   define input parameter rs-list-method as character no-undo .
     9528   define input parameter rs-status as character no-undo .
     9529   define buffer buf_scnblist-hist for scnblist-hist.
     9530   define buffer buf_prod-bc for ub.prod-bc.
     9531   define buffer buf_bar-code for ub.bar-code.
     9532     do
     9533     on error undo, return error
     9534     :
     9535       line-mode = 'ОСТАВИТЬ':U.
     9536       if rs-list-method begins "single" then do:
     9537         v-no-hist = - 1.
     9538         if p-from-macro then do:
     9539           CASE entry(2, rs-list-method, chr(4) ):
     9540             when 'prod-bc':U then do:
     9541               find first buf_prod-bc where rowid(buf_prod-bc) = p-rowid no-error.
     9542               if not available buf_prod-bc then return error "Нет в БД такого ДопБК".
     9543               find first scnblist where
     9544                          scnblist.b-code = buf_prod-bc.b-code
     9545                      AND scnblist.b-str = buf_prod-bc.b-str no-error.
     9546             end.
     9547             when 'bar-code':U
     9548             or
     9549             when 'loc-ean':U  then do:
     9550               find first buf_bar-code where rowid(buf_bar-code) = p-rowid no-error.
     9551               if not available buf_bar-code then return error "Нет в БД такого кода".
     9552               find first scnblist where
     9553                          scnblist.b-code = buf_bar-code.b-code
     9554                      AND scnblist.loc-ean = (if entry(2, rs-list-method, chr(4)) = 'bar-code':U then no else yes) no-error.
     9555             end.
     9556           END CASE.
     9557         end.
     9558         if available scnblist then do:
     9559         if p-from-macro then do:
     9560             glog = yes.
     9561           end.
     9562           else do:
     9563             glog = no.
     9564             message "Оставить отмеченную строку и УДАЛИТЬ ВСЕ ОСТАЛЬНЫЕ ?   Вы уверены ?"
     9565                     view-as alert-box question buttons OK-Cancel update glog.
     9566             if not glog then return error.
     9567           end.
     9568           line-rec = recid (scnblist).
     9569           v-seq = 1.
     9570           for each buf_scnblist-hist:
     9571             delete buf_scnblist-hist.
     9572           end.
     9573           run write-hist(p-from-macro, rs-list-method, rs-status, line-mode, buffer ub.goods).
     9574           for each scnblist:
     9575             if line-rec <> recid (scnblist) then delete scnblist.
     9576           end.
     9577           tot-lns = 1.
     9578           run UI-on.
     9579         end.
     9580       end.
     9581       else do:
     9582         glog = no.
     9583         if not p-from-macro then do:
     9584         message "Оставить коды ПО заданному УСЛОВИЮ и УДАЛИТЬ ВСЕ ОСТАЛЬНЫЕ ?   Вы уверены ?"
     9585                 view-as alert-box question buttons OK-Cancel update glog.
     9586           if not glog then
     9587           return no-apply.
     9588         end.
     9589         assign
     9590         lns-cnt = 0
     9591         lns-ignore = 0
     9592         .
     9593         run rs-do(no, no, rs-list-method, rs-status, line-mode, v-seq - 1).
     9594         for each scnblist:
     9595           if scnblist.to-del = ? then do:
     9596             assign
     9597             scnblist.to-del = no
     9598             .
     9599           end.
     9600           else do:
     9601             delete scnblist.
     9602           end.
     9603         end.
     9604         tot-lns = lns-cnt.
     9605         run UI-on.
     9606         message
     9607         "Оставлено строк :" lns-cnt skip(0)
     9608         string(if lns-ignore <> 0
     9609         then ("Проигнорировано строк :" + string(lns-ignore))
     9610         else "":U)
     9611         .
     9612       end.
     9613     end.
     9614   end procedure.
     9615   procedure process-one-good :
     9616   define input  parameter rs-list-method as character no-undo .
     9617   define input  parameter rs-status as character no-undo .
     9618   define input  parameter line-mode as character no-undo .
     9619   define parameter buffer goods for ub.goods.
     9620     do
     9621     on error undo, return error
     9622     :
     9623         assign                 new-good = yes                 petrol-trk = no                 cashparts = no                 main-b-code = 0                 .
     9624         run get-prt-and-unit in this-procedure (
     9625                                                  input ub.goods.prt-root
     9626                                                 ,input ub.goods.unit-base
     9627                                                 ,output l-empty-scale
     9628                                                 ) .
     9629         FIND FIRST ub.gds-obj WHERE
     9630                   ub.gds-obj.obj-type = p-curr-obj-type AND
     9631                   ub.gds-obj.obj-code = p-curr-obj-code AND
     9632                   ub.gds-obj.artic = ub.goods.artic AND
     9633                   ub.gds-obj.prod-type = ub.goods.prod-type AND
     9634                   ub.gds-obj.prod-code = ub.goods.prod-code nO-LOCK NO-ERROR.
     9635         if v-is-restaurant then do:
     9636           find first buf_fbr-gds-obj no-lock where
     9637                     buf_fbr-gds-obj.obj-type = p-curr-obj-type
     9638                 AND buf_fbr-gds-obj.obj-code = p-curr-obj-code
     9639                 AND buf_fbr-gds-obj.gds-code = ub.goods.gds-code no-error .
     9640           if    available buf_fbr-gds-obj
     9641             and not buf_fbr-gds-obj.is-cd
     9642           then
     9643              NEXT.
     9644         end.
     9645         run get-gds-obj-fields in this-procedure(
     9646                                                    buffer ub.gds-obj
     9647                                                   ,input no
     9648                                                   ,input ub.goods.gds-code
     9649                                                   ,input p-curr-obj-code
     9650                                                   ,input p-curr-obj-type
     9651                                                   ,output for-fact-qnty
     9652                                                   ,output cashparts
     9653                                                   ,output v-is-null-price
     9654                                                   ) no-error .
     9655       RUN term-prt in this-procedure (
     9656                     input rs-list-method
     9657                   , input rs-status
     9658                   , input line-mode
     9659                   , input ub.gds-prt.prt-root
     9660                   , input ?) no-error.
     9661     end.
     9662   end procedure.
     9663   procedure get-gds-obj-fields :
     9664   define parameter buffer buf_gds-obj for ub.gds-obj .
     9665   define input parameter par-find-buffer as logical no-undo .
     9666   define input parameter par-gds-code like ub.goods.gds-code no-undo .
     9667   define input parameter par-obj-code like ub.clients.obj-code no-undo .
     9668   define input parameter par-obj-type like ub.clients.obj-type no-undo .
     9669   define output parameter par-fact-qnty like ub.gds-obj.fact-qnty no-undo .
     9670   define output parameter par-cash-parts as logical no-undo .
     9671   define output parameter p-is-null-price like ub.fbr-gds-obj.is-null-price  no-undo .
     9672     do
     9673     on error undo, return error
     9674     :
     9675       if par-find-buffer then do:
     9676         find first buf_gds-obj no-lock where
     9677                   buf_gds-obj.gds-code = par-gds-code AND
     9678                   buf_gds-obj.obj-type = par-obj-type AND
     9679                   buf_gds-obj.obj-code = par-obj-code no-error .
     9680       end.
     9681       if not avail buf_gds-obj
     9682       and (p-curr-obj-type = 'маг':U and ub.shop.is-catering = no)
     9683       then do:
     9684         return.
     9685       end.
     9686       assign
     9687       par-fact-qnty = (if available buf_gds-obj
     9688                        then buf_gds-obj.fact-qnty
     9689                        else 0)
     9690       .
     9691       assign
     9692       par-cash-parts = (if available buf_gds-obj
     9693                         then buf_gds-obj.cash-parts
     9694                         else no)
     9695       .
     9696       if available buf_fbr-gds-obj then do:
     9697         assign
     9698         p-is-null-price     =  buf_fbr-gds-obj.is-null-price
     9699         .
     9700       end.
     9701     end.
     9702   end procedure.
     9703   procedure get-prt-and-unit :
     9704   define input parameter par-prt-root like ub.goods.prt-root no-undo .
     9705   define input parameter par-unit-base like ub.goods.unit-base no-undo .
     9706   define output parameter par-empty-scale as logical no-undo .
     9707     do
     9708     on error undo, return error
     9709     :
     9710       FIND FIRST ub.gds-prt where
     9711                  ub.gds-prt.upper-code = par-prt-root NO-LOCK .
     9712       assign
     9713       par-empty-scale =  NOT (v-doc-prt AND ( ub.gds-prt.node-name <> '_Пустая шкала':U))
     9714       .
     9715       FIND FIRST ub.units WHERE
     9716                  ub.units.unit-name = par-unit-base NO-LOCK .
     9717     end.
     9718   end procedure.
     9719   procedure proc-b-cd :
     9720   define input parameter p-fill-temp-shop as logical no-undo .
     9721     do
     9722     on error undo, return error
     9723     :
     9724     if available ub.shop then do:
     9725       assign
     9726       temp-shop.obj-code =    ub.shop.obj-code
     9727       t-all-prt         =    ub.shop.all-prt
     9728       t-bc-alt          =    ub.shop.cd-bc-alt
     9729       t-bc-base         =    ub.shop.cd-bc-base
     9730       t-loc-alt         =    ub.shop.cd-loc-alt
     9731       t-loc-base        =    ub.shop.cd-loc-base
     9732       t-parts-all       =    ub.shop.cd-parts-all
     9733       t-parts-not-blank =    ub.shop.cd-parts-not-blank
     9734       t-parts-ser       =    ub.shop.cd-parts-ser
     9735       t-pb-alt          =    ub.shop.cd-pb-alt
     9736       t-pb-base         =    ub.shop.cd-pb-base
     9737       t-sc-base         =    ub.shop.cd-sc-base
     9738       .
     9739       if (t-all-prt or
     9740       t-bc-alt     or
     9741       t-bc-base    or
     9742       t-loc-alt    or
     9743       t-loc-base   or
     9744       t-parts-all  or
     9745       t-parts-not-blank or
     9746       t-parts-ser       or
     9747       t-pb-alt          or
     9748       t-pb-base         or
     9749       t-sc-base ) = no then do:
     9750         message
     9751         substitute("Для магазина &1 не выбран ни один тип кодов, выбираем основные локальные&2"  +
     9752                    "Иначе список формировать бесполезно"
     9753                    , shop.obj-code
     9754                    , chr(10))
     9755         view-as alert-box warning.
     9756         t-loc-base = yes.
     9757       end.
     9758       if p-fill-temp-shop then do:
     9759         assign
     9760         temp-shop.obj-code = p-curr-obj-code
     9761         temp-shop.all-prt = T-all-prt
     9762         temp-shop.cd-bc-alt = T-bc-alt
     9763         temp-shop.cd-bc-base = T-bc-base
     9764         temp-shop.cd-loc-alt = T-loc-alt
     9765         temp-shop.cd-loc-base = T-loc-base
     9766         temp-shop.cd-parts-all = T-parts-all
     9767         temp-shop.cd-parts-not-blank = T-parts-not-blank
     9768         temp-shop.cd-parts-ser = T-parts-ser
     9769         temp-shop.cd-pb-alt = T-pb-alt
     9770         temp-shop.cd-pb-base = T-pb-base
     9771         temp-shop.cd-sc-base = T-sc-base
     9772         .
     9773       end.
     9774     end.
     9775     else do:
     9776       assign
     9777       temp-shop.obj-code =  ub.store.obj-code
     9778       t-loc-base         =   yes
     9779       t-all-prt          = no
     9780       t-bc-alt           = no
     9781       t-bc-base          = no
     9782       t-loc-alt          = no
     9783       t-parts-all        = no
     9784       t-parts-not-blank  = no
     9785       t-parts-ser        = no
     9786       t-pb-alt           = no
     9787       t-pb-base          = no
     9788       t-sc-base          = no
     9789       .
     9790       if p-fill-temp-shop then do:
     9791         assign
     9792         temp-shop.obj-code = p-curr-obj-code
     9793         temp-shop.all-prt = T-all-prt
     9794         temp-shop.cd-bc-alt = T-bc-alt
     9795         temp-shop.cd-bc-base = T-bc-base
     9796         temp-shop.cd-loc-alt = T-loc-alt
     9797         temp-shop.cd-loc-base = T-loc-base
     9798         temp-shop.cd-parts-all = T-parts-all
     9799         temp-shop.cd-parts-not-blank = T-parts-not-blank
     9800         temp-shop.cd-parts-ser = T-parts-ser
     9801         temp-shop.cd-pb-alt = T-pb-alt
     9802         temp-shop.cd-pb-base = T-pb-base
     9803         temp-shop.cd-sc-base = T-sc-base
     9804         .
     9805       end.
     9806     end.
     9807       display
     9808       T-loc-base
     9809       T-pb-base
     9810       T-loc-alt
     9811       T-pb-alt
     9812       T-bc-base
     9813       T-sc-base
     9814       T-bc-alt
     9815       T-all-prt
     9816       T-parts-ser
     9817       T-parts-not-blank
     9818       T-parts-all
     9819       with frame Dialog-Frame.
     9820     run proc-cd2 in this-procedure .
     9821     end.
     9822   end procedure.
     9823   procedure proc-cd2 :
     9824   define variable v-fvalue as character no-undo .
     9825     do
     9826     on error undo, return error
     9827     :
     9828       if available temp-list then v-fvalue = temp-list.fvalue.
     9829       CASE v-fvalue:
     9830         when "all"
     9831         or
     9832         when "goods"
     9833         or
     9834         when "gds-list"
     9835         or
     9836         when "file-gds" then do:
     9837           ENABLE
     9838           T-loc-base
     9839           T-loc-alt
     9840           T-bc-base
     9841           T-bc-alt
     9842           T-all-prt
     9843           T-parts-ser
     9844           T-parts-not-blank
     9845           T-parts-all
     9846           T-pb-base
     9847           T-pb-alt
     9848           T-sc-base
     9849           WITH FRAME Dialog-Frame.
     9850         end.
     9851         otherwise do:
     9852           disable
     9853           T-loc-base
     9854           T-loc-alt
     9855           T-bc-base
     9856           T-bc-alt
     9857           T-all-prt
     9858           T-parts-ser
     9859           T-parts-not-blank
     9860           T-parts-all
     9861           T-pb-base
     9862           T-pb-alt
     9863           T-sc-base
     9864           WITH FRAME Dialog-Frame.
     9865         end.
     9866       END CASE.
     9867     end.
     9868   end procedure.
     9869   procedure proc-b-optimize :
     9870   define input  parameter p-from-macro as logical   no-undo .
     9871   define input parameter rs-list-method as character no-undo .
     9872   define input parameter rs-status as character no-undo .
     9873   define input parameter p-option as character no-undo .
     9874   define variable v-cnt as integer   no-undo .
     9875   define variable v-temp-seq as integer   no-undo .
     9876   define variable l-prod-bc-petrolium as logical no-undo .
     9877   define variable l-prod-bc-weight as logical no-undo .
     9878   define buffer b-str_bb-list for scnblist.
     9879   define buffer b-code_bb-list for scnblist.
     9880   define buffer buf_prod-bc for ub.prod-bc.
     9881   define buffer buf_bar-code for ub.bar-code.
     9882   define buffer buf_goods for ub.goods.
     9883   define buffer buf_scnblist-hist for scnblist-hist.
     9884     do
     9885     on error undo, return error
     9886     :
     9887       case p-option:
     9888         when "delnprod-bc" then  do:
     9889           for each b-str_bb-list no-lock :
     9890             if b-str_bb-list.b-str <> "":U
     9891             and b-str_bb-list.loc-ean  = no
     9892             then do:
     9893               for each b-code_bb-list where
     9894                          b-code_bb-list.b-code = b-str_bb-list.b-code
     9895                     AND  (b-code_bb-list.b-str = "":U
     9896                           or
     9897                           b-code_bb-list.loc-ean = yes)
     9898                     :
     9899                 delete b-code_bb-list.
     9900                 v-cnt = v-cnt + 1.
     9901               end.
     9902             end.
     9903           end.
     9904         end.
     9905         when "repnprod-bc" then  do:
     9906           for each b-code_bb-list :
     9907             if b-code_bb-list.b-str =  '':U
     9908             or b-code_bb-list.loc-ean = yes then do:
     9909               find first buf_prod-bc no-lock where
     9910                         buf_prod-bc.b-code = b-code_bb-list.b-code
     9911                     AND buf_prod-bc.bc-on = yes no-error.
     9912               if available buf_prod-bc then do:
     9913                 find first b-str_bb-list no-lock where
     9914                            b-str_bb-list.b-code = buf_prod-bc.b-code
     9915                       AND  b-str_bb-list.b-str = buf_prod-bc.b-str no-error .
     9916                 if available b-str_bb-list then next.
     9917                 assign
     9918                 l-prod-bc-petrolium = no
     9919                 l-prod-bc-weight = no
     9920                 .
     9921   define variable vss-include-info71 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9922   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     9923     (buffer buf_prod-bc
     9924     ,input  'weight=request':u
     9925     ,output l-prod-bc-weight
     9926     ) no-error .
     9927                 if error-status:error
     9928                 or l-prod-bc-weight then next.
     9929   define variable vss-include-info72 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9930   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     9931     (buffer buf_prod-bc
     9932     ,input  'petrolium=request':u
     9933     ,output l-prod-bc-petrolium
     9934     ) no-error .
     9935                 if error-status:error
     9936                 or l-prod-bc-petrolium then next.
     9937                 find first buf_bar-code no-lock where
     9938                             buf_bar-code.b-code = buf_prod-bc.b-code no-error.
     9939                 if available buf_bar-code then do:
     9940                   find first ub.goods no-lock where
     9941                             ub.goods.gds-code = buf_bar-code.gds-code no-error.
     9942                   if available goods then do:
     9943                     run get-prt-and-unit in this-procedure (
     9944                                                             input ub.goods.prt-root
     9945                                                             ,input ub.goods.unit-base
     9946                                                             ,output l-empty-scale
     9947                                                             ) .
     9948                     delete b-code_bb-list.
     9949                     v-cnt = v-cnt + 1.
     9950                     run ex-bbc in this-procedure (input rs-list-method, input rs-status, input line-mode , input no, input "":U, input no, buffer buf_bar-code, buffer buf_prod-bc).
     9951                   end.
     9952                 end.
     9953               end.
     9954             end.
     9955           end.
     9956         end.
     9957       end case.
     9958       lns-cnt = lns-cnt - v-cnt.
     9959     end.
     9960   end procedure.
     9961   procedure proc-b-obj :
     9962     define input parameter p-mode as character no-undo .
     9963     define variable v-rid-list as character no-undo .
     9964     define buffer buf_clients  for ub.clients.
     9965     define buffer buf_user-obj for ub.user-obj.
     9966     do
     9967     on error undo, return error
     9968     :
     9969       find first buf_user-obj no-lock where
     9970                  buf_user-obj.user-id = v-cntxt-userid
     9971              and buf_user-obj.db-num = v-cntxt-db-num
     9972              and buf_user-obj.obj-type  = p-curr-obj-type
     9973              and buf_user-obj.obj-code  = p-curr-obj-code no-error .
     9974       assign
     9975         v-rid-list = ( if available buf_user-obj then string( recid( buf_user-obj ) ) else "":U )
     9976       .
     9977       if p-mode = "change":U then do:
     9978   define variable vss-include-info73 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9979   run userobjs_select-one in this-procedure
     9980     (input  parparentproc
     9981     ,input  v-cntxt-db-num
     9982     ,input  v-cntxt-userid
     9983     ,input  v-cntxt-host-code-obj
     9984     ,input  v-cntxt-obj-type
     9985     ,input  v-cntxt-obj-code
     9986     ,output v-user-select
     9987     ,output v-sel-obj-type
     9988     ,output v-sel-obj-code
     9989     )  .
     9990         if v-user-select then do:
     9991           FIND FIRST buf_user-obj NO-LOCK WHERE
     9992                     buf_user-obj.obj-type = buf_user-obj.obj-type
     9993               and buf_user-obj.obj-code = buf_user-obj.obj-code
     9994               and buf_user-obj.db-num = v-cntxt-db-num
     9995               and buf_user-obj.user-id = v-cntxt-userid    NO-ERROR.
     9996           if not available buf_user-obj then do: return no-apply. end.
     9997           find first buf_clients no-lock where
     9998                     buf_clients.obj-type = buf_user-obj.obj-type
     9999                 and buf_clients.obj-code = buf_user-obj.obj-code no-error.
    10000           if not available buf_clients then do: return error. end.
    10001           assign
    10002             p-curr-obj-type = buf_clients.obj-type
    10003             p-curr-obj-code = buf_clients.obj-code
    10004             v-host-code = buf_clients.host-code
    10005             v-obj-type = buf_clients.obj-type
    10006             v-obj-code = buf_clients.obj-code
    10007             v-obj-name = buf_clients.obj-name
    10008           .
    10009           display
    10010           v-obj-name
    10011           v-obj-type
    10012           v-obj-code
    10013           with frame Dialog-Frame.
    10014         end.
    10015       end.
    10016     end.
    10017   end procedure.
    10018   procedure restore-codes :
    10019   define input  parameter p-codes as character no-undo .
    10020   define input  parameter p-obj-type like ub.clients.obj-type no-undo .
    10021   define input  parameter p-obj-code like ub.clients.obj-code no-undo .
    10022     do
    10023     on error undo, return error return-value
    10024     :
    10025       if p-obj-type = 'маг':U then do:
    10026       assign
    10027       temp-shop.obj-code =   p-obj-code
    10028       t-all-prt         =    lookup('all-prt':U, p-codes, chr(32) ) > 0
    10029       t-bc-alt          =    lookup('bc-alt':U, p-codes, chr(32) ) > 0
    10030       t-bc-base         =    lookup('bc-base':U, p-codes, chr(32) ) > 0
    10031       t-loc-alt         =    lookup('loc-alt':U, p-codes, chr(32) ) > 0
    10032       t-loc-base        =    lookup('loc-base':U, p-codes, chr(32) ) > 0
    10033       t-parts-all       =    lookup('parts-all':U, p-codes, chr(32) ) > 0
    10034       t-parts-not-blank =    lookup('parts-not-blank':U, p-codes, chr(32) ) > 0
    10035       t-parts-ser       =    lookup('parts-ser':U, p-codes, chr(32) ) > 0
    10036       t-pb-alt          =    lookup('pb-alt':U, p-codes, chr(32) ) > 0
    10037       t-pb-base         =    lookup('pb-base':U, p-codes, chr(32) ) > 0
    10038       t-sc-base         =    lookup('sc-base':U, p-codes, chr(32) ) > 0
    10039       temp-shop.all-prt         =    lookup('all-prt':U, p-codes, chr(32) ) > 0
    10040       temp-shop.cd-bc-alt          =    lookup('bc-alt':U, p-codes, chr(32) ) > 0
    10041       temp-shop.cd-bc-base         =    lookup('bc-base':U, p-codes, chr(32) ) > 0
    10042       temp-shop.cd-loc-alt         =    lookup('loc-alt':U, p-codes, chr(32) ) > 0
    10043       temp-shop.cd-loc-base        =    lookup('loc-base':U, p-codes, chr(32) ) > 0
    10044       temp-shop.cd-parts-all       =    lookup('parts-all':U, p-codes, chr(32) ) > 0
    10045       temp-shop.cd-parts-not-blank =    lookup('parts-not-blank':U, p-codes, chr(32) ) > 0
    10046       temp-shop.cd-parts-ser       =    lookup('parts-ser':U, p-codes, chr(32) ) > 0
    10047       temp-shop.cd-pb-alt          =    lookup('pb-alt':U, p-codes, chr(32) ) > 0
    10048       temp-shop.cd-pb-base         =    lookup('pb-base':U, p-codes, chr(32) ) > 0
    10049       temp-shop.cd-sc-base         =    lookup('sc-base':U, p-codes, chr(32) ) > 0
    10050       .
    10051       display
    10052       T-loc-base
    10053       T-pb-base
    10054       T-loc-alt
    10055       T-pb-alt
    10056       T-bc-base
    10057       T-sc-base
    10058       T-bc-alt
    10059       T-all-prt
    10060       T-parts-ser
    10061       T-parts-not-blank
    10062       T-parts-all
    10063       with frame Dialog-Frame.
    10064     end.
    10065     run proc-cd2 in this-procedure .
    10066     end.
    10067   end procedure.
    10068   procedure proc-macros :
    10069   define variable glog as logical no-undo .
    10070   define variable v-option as integer no-undo .
    10071   define buffer buf_scnblist-hist for scnblist-hist.
    10072   define buffer buf_macro-list-hist for macro-list-hist.
    10073   if can-find(first macro-list-hist) then do:
    10074     run gbl/d-askw.w ( input "Сохранение макроса"
    10075                   ,input "Выберите какие действия по формированию списка Вы хотите сохранить"
    10076                   ,input "|"
    10077                   ,input "Посл.ЗАПИСЬ|Все|Отказ"
    10078                   ,input "Действия при нажатой кнопке ЗАПИСЬ|ВСЯ последовательность действий|Отказ"
    10079                   ,input 1
    10080                   ,input 3
    10081                   ,output v-option).
    10082     if v-option = 3 then return no-apply.
    10083     v-option = 1.
    10084   end.
    10085   else do:
    10086     message
    10087     "Будет сохранена в файл ВСЯ последовательность действий по формированию списка" skip
    10088     view-as alert-box question buttons yes-no update glog.
    10089     v-option = 2.
    10090     if not glog then do:
    10091       return no-apply.
    10092     end.
    10093   end.
    10094     do
    10095     on error undo, return error
    10096     :
    10097     assign
    10098       f-name = "default.bbm"
    10099       glog = yes
    10100       .
    10101     system-dialog get-file f-name
    10102       filters "Макрос создания списка кодов *.bbm" "*.bbm"
    10103       ask-overwrite
    10104       save-as
    10105       use-filename
    10106       update glog
    10107       default-extension "bbm".
    10108     if not glog then do:
    10109       apply "entry" to br-list in frame Dialog-Frame.
    10110       return no-apply.
    10111     end.
    10112     run waitfram-show in this-procedure ("Сохранение макроса формирования списка кодов.    ЖДИТЕ...").
    10113     output stream PrnLibStream to value (f-name).
    10114     case v-option:
    10115       when 1 then do:
    10116         for each buf_macro-list-hist:
    10117           export stream PrnLibStream
    10118           buf_macro-list-hist.
    10119         end.
    10120       end.
    10121       when 2 then do:
    10122     for each buf_scnblist-hist:
    10123         export stream PrnLibStream
    10124         buf_scnblist-hist.
    10125     end.
    10126       end.
    10127     end case.
    10128     output stream PrnLibStream close.
    10129     run waitfram-hide in this-procedure .
    10130     end.
    10131   end procedure.
    10132   PROCEDURE reposition-goods :
    10133   define input  parameter p-direction   as character no-undo .
    10134   define output parameter p-recid as recid no-undo .
    10135   define buffer buf_goods for ub.goods.
    10136   case p-direction :
    10137     when "first":U
    10138     then do:
    10139       get first br-list.
    10140     end.
    10141     when "last":U
    10142     then do:
    10143       get last br-list.
    10144     end.
    10145     when "prev":U
    10146     then do:
    10147       get prev br-list.
    10148       if not available scnblist then do:
    10149         message
    10150         "Это первый товар списка"
    10151         view-as alert-box.
    10152       end.
    10153     end.
    10154     when "next":U
    10155     then do:
    10156       get next br-list.
    10157       if not available scnblist then do:
    10158         message
    10159         "Это последний товар списка"
    10160         view-as alert-box.
    10161       end.
    10162     end.
    10163   end case .
    10164   find first buf_goods no-lock where
    10165           buf_goods.gds-code = scnblist.gds-code no-error.
    10166   if available scnblist then do:
    10167     assign
    10168     p-recid = recid(buf_goods)
    10169     .
    10170   end.
    10171   run reposition-query in this-procedure
    10172     (input recid(scnblist)
    10173     ).
    10174   END PROCEDURE.
    10175   PROCEDURE reposition-query :
    10176   define input parameter p-recid as recid no-undo .
    10177   if p-recid <> ?
    10178   then do:
    10179     reposition br-list to recid p-recid no-error.
    10180   end.
    10181   do with frame Dialog-Frame:
    10182     apply "entry":u to browse br-list .
    10183     apply "VALUE-CHANGED":u to browse br-list .
    10184   end.
    10185   END PROCEDURE.
    10186   procedure proc-cd :
    10187   define variable v-num as integer no-undo .
    10188   define variable v-action as character no-undo .
    10189   define buffer buf_bb-list for scnblist.
    10190   if p-curr-obj-type <> 'маг':U then return.
    10191   run gbl/d-askw.w (
    10192                     input "Отослать на кассы"
    10193                    ,input "Передача/удаление списка кодов на кассу/с кассы"
    10194                    ,input "|"
    10195                    ,input "Передача|Удаление|Отмена"
    10196                    ,input "Передача на кассу|Удаление с кассы|Отмена"
    10197                    ,input 1
    10198                    ,input 3
    10199                    ,output v-num).
    10200   if v-num = 3 then return.
    10201   v-action = (if v-num = 1 then "U":U else "D").
    10202   define variable v-chk-act-host-code as integer   no-undo .
    10203   define variable v-ok as logical no-undo .
    10204   define variable vss-include-info74 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10205   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
    10206     (input  'маг':U
    10207     ,input  abs(p-curr-obj-code)
    10208     ,output v-chk-act-host-code
    10209     )  .
    10210   if v-action = "U" then do:
    10211   define variable vss-include-info75 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10212   do:
    10213     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    10214       (input  v-cntxt-db-num
    10215       ,input  v-cntxt-userid
    10216       ,input  0
    10217       ,input  'actn_cashdesk-goods_add-def':U
    10218       ,input  'object':U
    10219       ,input  v-chk-act-host-code
    10220       ,input  'маг':U
    10221       ,input  abs(p-curr-obj-code)
    10222       ,input  0
    10223       ,input  0
    10224       ,input  0
    10225       ,input  true
    10226       ,output v-ok
    10227       )  .
    10228   end.
    10229   end.
    10230   else do:
    10231   define variable vss-include-info76 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10232   do:
    10233     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    10234       (input  v-cntxt-db-num
    10235       ,input  v-cntxt-userid
    10236       ,input  0
    10237       ,input  'actn_cashdesk-goods_deletion':U
    10238       ,input  'object':U
    10239       ,input  v-chk-act-host-code
    10240       ,input  'маг':U
    10241       ,input  abs(p-curr-obj-code)
    10242       ,input  0
    10243       ,input  0
    10244       ,input  0
    10245       ,input  true
    10246       ,output v-ok
    10247       )  .
    10248   end.
    10249   end.
    10250   if NOT v-ok then return .
    10251   for each bc-list:
    10252     delete bc-list.
    10253   end.
    10254   for each pbc-list:
    10255     delete pbc-list.
    10256   end.
    10257   for each buf_bb-list:
    10258     if buf_bb-list.b-str <> ""
    10259     and buf_bb-list.loc-ean = no
    10260     then do:
    10261       create pbc-list.
    10262       buffer-copy buf_bb-list to pbc-list.
    10263       if v-action = "D" then do:
    10264         assign
    10265         pbc-list.del = yes.
    10266       end.
    10267       release pbc-list.
    10268     end.
    10269     else do:
    10270       find first bc-list where
    10271                 bc-list.b-code = buf_bb-list.b-code no-error.
    10272       if not available bc-list then do:
    10273       create bc-list.
    10274       buffer-copy buf_bb-list to bc-list.
    10275         if v-action = "D" then do:
    10276           assign
    10277           bc-list.del = yes.
    10278         end.
    10279       release bc-list.
    10280       end.
    10281     end.
    10282   end.
    10283   if can-find(first bc-list no-lock) then do:
    10284       run str/diallog.w ( input parparentproc
    10285                     , input this-procedure
    10286                     , input 'str/send-bcn.p':U
    10287                     , input (string(p-curr-obj-code) + chr(4) + v-action)
    10288                     , input (if can-find(first pbc-list no-lock)
    10289                              then yes
    10290                              else no)
    10291                     , input 'Прервать'
    10292                     , input (if v-action = "U"
    10293                              then 'Отсылка бар-кодов на кассу'
    10294                              else 'Удаление бар-кодов c кассы'
    10295                              )) no-error .
    10296   end.
    10297   if can-find(first pbc-list no-lock) then do:
    10298       run str/diallog.w ( input parparentproc
    10299                     , input this-procedure
    10300                     , input 'str/s-prdbcn.p':U
    10301                     , input (string(p-curr-obj-code) + chr(4) + v-action)
    10302                     , input no
    10303                     , input 'Прервать'
    10304                     , input (if v-action = "U"
    10305                              then 'Отсылка ДопБК на кассу'
    10306                              else 'Удаление ДопБК с кассы'
    10307                              )) no-error .
    10308   end.
    10309   end procedure.
