     3725   END PROCEDURE .
     3726   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3727   procedure asc-gds :
     3728   define input parameter rs-list-method as character no-undo .
     3729   define input parameter rs-status as character no-undo .
     3730   define input parameter line-mode as character no-undo .
     3731   DEFINE parameter buffer loc-goods for ub.goods.
     3732   DEFINE parameter buffer loc-bar-code for ub.bar-code.
     3733   DEFINE parameter buffer loc-gds-prt-root for ub.gds-prt.
     3734   DEFINE parameter buffer loc-gds-obj for ub.gds-obj.
     3735   DEFINE parameter buffer loc-price-list for ub.price-list.
     3736   DEFINE parameter buffer loc-units for ub.units.
     3737   DEFINE parameter buffer loc-gds-prt-term for ub.gds-prt.
     3738   DEFINE input parameter loc-prod-bc like ub.prod-bc.b-str.
     3739   DEFINE input parameter loc-bc-on-type like ub.prod-bc.bc-on-type.
     3740   DEFINE input parameter loc-bc-units-cli-type like ub.units.type.
     3741   DEFINE input parameter loc-bc-units-okei like ub.units.okei.
     3742   define input parameter parhost-code like ub.sysconf.host-code no-undo .
     3743   define input parameter parobj-type like ub.clients.obj-type no-undo .
     3744   define input parameter parobj-code like ub.clients.obj-code no-undo .
     3745   define variable IBM-good-code as character no-undo .
     3746   define variable bar_code as character no-undo .
     3747   define buffer buf_prod-bc for ub.prod-bc.
     3748     do
     3749     on error undo, return error
     3750     :
     3751       if loc-prod-bc <> "":U and loc-prod-bc <> ? then do:
     3752         find first buf_prod-bc no-lock where
     3753                   buf_prod-bc.b-code = loc-bar-code.b-code
     3754              and  buf_prod-bc.b-str = loc-prod-bc no-error.
     3755         run ex-bbc in this-procedure ( input rs-list-method
     3756                                       ,input rs-status
     3757                                       ,input line-mode
     3758                                       ,input l-empty-scale
     3759                                       ,input loc-prod-bc
     3760                                       ,input no
     3761                                       ,buffer loc-bar-code
     3762                                       ,buffer buf_prod-bc).
     3763       end.
     3764       else do:
     3765         if  (LOOKUP( 'вес':U, loc-units.type ) = 0 or v-notcd)
     3766         or loc-goods.unit-base <> loc-bar-code.unit-cli then do:
     3767           if (temp-shop.cd-loc-base and loc-bar-code.unit-cli = loc-goods.unit-base)
     3768           or (temp-shop.cd-loc-alt  and loc-bar-code.unit-cli <> loc-goods.unit-base)
     3769           then
     3770           run ex-bbc in this-procedure ( input rs-list-method
     3771                                         ,input rs-status
     3772                                         ,input line-mode
     3773                                         ,input l-empty-scale
     3774                                         ,input "":U
     3775                                         ,input no
     3776                                         ,buffer loc-bar-code
     3777                                         ,buffer buf_prod-bc).
     3778           if temp-shop.cd-bc-base
     3779           and loc-bar-code.unit-cli = loc-goods.unit-base then do:
     3780             RUN gen-bc( input loc-bar-code.b-code, output bar_code ).
     3781             IBM-good-code  = trim( bar_code ) .
     3782             run ex-bbc in this-procedure ( input rs-list-method
     3783                                           ,input rs-status
     3784                                           ,input line-mode
     3785                                           ,input l-empty-scale
     3786                                           ,input IBM-good-code
     3787                                           ,input yes
     3788                                           ,buffer loc-bar-code
     3789                                           ,buffer buf_prod-bc).
     3790           end.
     3791           if temp-shop.cd-bc-alt
     3792           and loc-bar-code.unit-cli <> loc-goods.unit-base
     3793           then  do:
     3794             RUN gen-bc( input loc-bar-code.b-code, output bar_code ).
     3795             IBM-good-code  = trim( bar_code ) .
     3796             run ex-bbc in this-procedure ( input rs-list-method
     3797                                           ,input rs-status
     3798                                           ,input line-mode
     3799                                           ,input l-empty-scale
     3800                                           ,input IBM-good-code
     3801                                           ,input yes
     3802                                           ,buffer loc-bar-code
     3803                                           ,buffer buf_prod-bc).
     3804           end.
     3805         end.
     3806       end.
     3807     end.
     3808   end procedure.
     3809   DEFINE FRAME Dialog-Frame
     3810       dsp-rs  AT ROW 1 COL 1 NO-LABEL
     3811       b-exit  AT ROW 2 COL 1
     3812       b-save  AT ROW 2 COL 11
     3813       b-print AT ROW 2 COL 21
