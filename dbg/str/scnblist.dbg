     9113                 v-tot-lns = tot-lns
     9114                 .
     9115               end.
     9116               else do:
     9117                 case choice:
     9118                   when 1 then do:
     9119                     assign
     9120                     v-item_    = string(buf_db.db-num) + chr(3) + "all"
     9121                     .
     9122                   end.
     9123                   when 2 then do:
     9124                     assign
