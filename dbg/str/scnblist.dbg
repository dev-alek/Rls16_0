    10624   define buffer buf_rp-by-call for ub.rp-by-call.
    10625   find first buf_rp-by-call no-lock where
    10626             buf_rp-by-call.profile_id = 62 no-error.
    10627   if not available buf_rp-by-call then do:
    10628     message
    10629     "В вашей системе НЕ ВКЛЮЧЕН профайл установки флагов на закончившиеся партии" skip
    10630     "Отбор невозможен"
