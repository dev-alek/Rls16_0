     3942   else do:
     3943     apply "entry":u to b-save in frame Dialog-Frame .
     3944     if focus :handle <> b-save :handle in frame Dialog-Frame then do:
     3945       return no-apply .
     3946     end.
     3947   end.
     3948     assign
     3949       f-gds-name = "default.gds"
     3950       glog = yes
     3951       .
     3952     system-dialog get-file f-gds-name
     3953       filters "Списки товаров *.gds" "*.gds"
     3954       ask-overwrite
     3955       save-as
     3956       use-filename
     3957       update glog
     3958       default-extension "gds".
     3959     if not glog then do:
     3960       apply "entry" to br-list in frame Dialog-Frame.
     3961       return no-apply.
     3962     end.
     3963     output to value (f-gds-name).
     3964     for each scnblist
     3965     break by scnblist.gds-code
     3966     :
     3967       if first-of(scnblist.gds-code) then
     3968       export scnblist.prod-type
     3969             scnblist.prod-code
     3970             scnblist.artic
     3971             .
     3972     end.
     3973     output close.
     3974   END.
