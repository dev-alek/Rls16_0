     4574   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     4575   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     4576   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     4577   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     4578   define variable v-diasize-current-frame-width  as decimal   no-undo .
     4579   define variable v-diasize-current-frame-height as decimal   no-undo .
     4580   define variable v-diasize-change-size          as logical   no-undo .
     4581   define variable v-diasize-resize-button        as handle    no-undo .
     4582   define variable v-diasize-wndmax               as logical   no-undo .
     4583   define variable v-diasize-wndstore             as logical   no-undo .
     4584   define variable v-diasize-proc-name            as character no-undo .
     4585   define variable v-diasize-browse-handle        as handle    no-undo .
     4586   define variable v-diasize-browse-number        as integer   no-undo .
     4587   define variable v-diasize-need-full-display    as logical   no-undo init false .
     4588   define temp-table temp-diasize-handle no-undo
     4589     field handle-value  as handle
     4590     field save-position as decimal
     4591     index xpk is primary unique handle-value
     4592     .
     4593   define temp-table temp-browse-handle no-undo
     4594     field browse-type   as character
     4595     field browse-number as integer
     4596     field browse-handle as handle
     4597     field original-size as decimal
     4598     index xpk is primary unique browse-type browse-number
     4599     index xie browse-type browse-handle
     4600   .
     4601   procedure diasize_change-height :
     4602     define input  parameter p-change-value  as decimal   no-undo .
     4603     define input  parameter p-move-resize   as logical   no-undo .
     4604     define variable v-field-group-handle    as handle    no-undo .
     4605     define variable v-object-handle         as handle    no-undo .
     4606     define variable v-frame-height          as decimal   no-undo .
     4607     define variable v-frame-virtual-height  as decimal   no-undo .
     4608     define variable v-browse-height         as decimal   no-undo .
     4609     define variable v-window-height         as decimal   no-undo .
     4610     define variable v-window-virtual-height as decimal   no-undo .
     4611     define variable v-change-sign           as integer   no-undo .
     4612     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     4613     define buffer buf_temp-browse-handle  for temp-browse-handle .
     4614     if p-change-value > 0
     4615     then do:
     4616       if frame Dialog-Frame :height + p-change-value
     4617           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     4618       then do:
     4619         assign
     4620           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     4621                           - (frame Dialog-Frame :height-chars)
     4622         .
     4623         if p-change-value <= 0
     4624         then do:
     4625           run diasize_position-resize-button in this-procedure .
     4626           return .
     4627         end.
     4628       end.
     4629     end.
     4630     if p-change-value < 0
     4631     then do:
     4632       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     4633       then do:
     4634         assign
     4635           p-change-value = v-diasize-orig-frame-height
     4636                          - (frame Dialog-Frame :height-chars)
     4637         .
     4638         if p-change-value >= 0
     4639         then do:
     4640           run diasize_position-resize-button in this-procedure .
     4641           return .
     4642         end.
     4643       end.
     4644     end.
     4645     if p-change-value >= 0
     4646     then do:
     4647       assign
     4648         v-change-sign = 1
     4649       .
     4650     end.
     4651     else do:
     4652       assign
     4653         v-change-sign = -1
     4654       .
     4655     end.
     4656     assign
     4657       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     4658     .
     4659     if p-change-value = 0
     4660     then do:
     4661       run diasize_position-resize-button in this-procedure .
     4662       return .
     4663     end.
     4664     move_block:
     4665     do
     4666     on error undo move_block, retry move_block
     4667     :
     4668       if retry
     4669       then do:
     4670         do
     4671         on error undo move_block, leave move_block
     4672         :
     4673           if p-change-value > 0
     4674           then do:
     4675             for each buf_temp-diasize-handle
     4676             on error undo, next
     4677             :
     4678               assign
     4679                 v-object-handle = buf_temp-diasize-handle.handle-value
     4680               .
     4681               if v-object-handle <> v-diasize-resize-button
     4682               then do:
     4683                 assign
     4684                   v-object-handle :row = buf_temp-diasize-handle.save-position
     4685                 .
     4686               end.
     4687             end.
     4688             assign
     4689               v-diasize-browse-handle :height = v-browse-height
     4690             .
     4691             for each buf_temp-browse-handle
     4692               where buf_temp-browse-handle.browse-type = 'height':u
     4693             on error undo, next
     4694             :
     4695               assign
     4696                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     4697               .
     4698             end.
     4699             assign
     4700               frame Dialog-Frame :height = v-frame-height
     4701             .
     4702             if frame Dialog-Frame :scrollable = true
     4703             then do:
     4704               assign
     4705                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     4706               .
     4707             end.
     4708             run diasize_position-resize-button in this-procedure .
     4709           end.
     4710           else do:
     4711             if frame Dialog-Frame :scrollable = true
     4712             then do:
     4713               assign
     4714                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     4715               .
     4716             end.
     4717             assign
     4718               frame Dialog-Frame :height = v-frame-height
     4719             .
     4720             assign
     4721               v-diasize-browse-handle :height = v-browse-height
     4722             .
     4723             for each buf_temp-browse-handle
     4724               where buf_temp-browse-handle.browse-type = 'height':u
     4725             on error undo, next
     4726             :
     4727               assign
     4728                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     4729               .
     4730             end.
     4731             for each buf_temp-diasize-handle
     4732             on error undo, next
     4733             :
     4734               assign
     4735                 v-object-handle = buf_temp-diasize-handle.handle-value
     4736               .
     4737               if v-object-handle <> v-diasize-resize-button
     4738               then do:
     4739                 assign
     4740                   v-object-handle :row = buf_temp-diasize-handle.save-position
     4741                 .
     4742               end.
     4743             end.
     4744             run diasize_position-resize-button in this-procedure .
     4745           end.
     4746           assign
     4747             v-diasize-change-size = false
     4748           .
     4749           leave move_block .
     4750         end.
     4751       end.
     4752       assign
     4753         v-diasize-need-full-display = true
     4754       .
     4755       if v-diasize-change-size = false
     4756       then do:
     4757         assign
     4758           v-diasize-change-size = true
     4759         .
     4760       end.
     4761       else do:
     4762         return .
     4763       end.
     4764       assign
     4765         v-frame-height = frame Dialog-Frame :height
     4766         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     4767         v-browse-height = v-diasize-browse-handle :height
     4768       .
     4769       for each buf_temp-browse-handle
     4770         where buf_temp-browse-handle.browse-type = 'height':u
     4771       :
     4772         assign
     4773           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     4774         .
     4775       end.
     4776       for each buf_temp-diasize-handle
     4777       :
     4778         delete buf_temp-diasize-handle .
     4779       end.
     4780       assign
     4781         v-field-group-handle = frame Dialog-Frame :first-child
     4782       .
     4783       do while valid-handle(v-field-group-handle)
     4784       :
     4785         assign
     4786           v-object-handle = v-field-group-handle :first-child
     4787         .
     4788         do while valid-handle(v-object-handle)
     4789         :
     4790           if  v-object-handle <> v-diasize-browse-handle :handle
     4791           and can-query(v-object-handle, "row")
     4792           and can-query(v-object-handle, "height")
     4793           and ( v-object-handle :row > v-diasize-browse-handle :row )
     4794           then do:
     4795             find first buf_temp-browse-handle
     4796               where buf_temp-browse-handle.browse-type   = 'height':u
     4797                 and buf_temp-browse-handle.browse-handle = v-object-handle
     4798               no-error .
     4799             if available buf_temp-browse-handle
     4800             then do:
     4801             end.
     4802             else do:
     4803               create buf_temp-diasize-handle .
     4804               assign
     4805                 buf_temp-diasize-handle.handle-value  = v-object-handle
     4806                 buf_temp-diasize-handle.save-position = v-object-handle :row
     4807               .
     4808             end.
     4809           end.
     4810           assign
     4811             v-object-handle = v-object-handle :next-sibling
     4812           .
     4813         end.
     4814         assign
     4815           v-field-group-handle = v-field-group-handle :next-sibling
     4816         .
     4817       end.
     4818       do with frame Dialog-Frame
     4819       :
     4820         hide v-diasize-resize-button .
     4821         assign
     4822           v-diasize-resize-button :row    = 1
     4823           v-diasize-resize-button :column = 1
     4824         .
     4825       end.
     4826       if p-change-value > 0
     4827       then do:
     4828         if frame Dialog-Frame :scrollable = true
     4829         then do:
     4830           assign
     4831             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     4832             no-error .
     4833           if error-status :error
     4834           or error-status :get-message(1) <> ""
     4835           then do:
     4836             undo move_block, retry move_block .
     4837           end.
     4838         end.
     4839         assign
     4840           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     4841           no-error .
     4842         if error-status :error
     4843         or error-status :get-message(1) <> ""
     4844         then do:
     4845           undo move_block, retry move_block .
     4846         end.
     4847         assign
     4848           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     4849           no-error .
     4850         if error-status :error
     4851         or error-status :get-message(1) <> ""
     4852         then do:
     4853           undo move_block, retry move_block .
     4854         end.
     4855         for each buf_temp-browse-handle
     4856           where buf_temp-browse-handle.browse-type = 'height':u
     4857         on error undo move_block, retry move_block
     4858         :
     4859           assign
     4860             buf_temp-browse-handle.browse-handle :height
     4861               = buf_temp-browse-handle.browse-handle :height + p-change-value
     4862             no-error .
     4863           if error-status :error
     4864           or error-status :get-message(1) <> ""
     4865           then do:
     4866             undo move_block, retry move_block .
     4867           end.
     4868         end.
     4869         for each buf_temp-diasize-handle
     4870         on error undo move_block, retry move_block
     4871         :
     4872           assign
     4873             v-object-handle = buf_temp-diasize-handle.handle-value
     4874           .
     4875           if v-object-handle <> v-diasize-resize-button
     4876           then do:
     4877             assign
     4878               v-object-handle :row = v-object-handle :row + p-change-value
     4879               no-error .
     4880             if error-status :error
     4881             or error-status :get-message(1) <> ""
     4882             then do:
     4883               undo move_block, retry move_block .
     4884             end.
     4885           end.
     4886         end.
     4887       end.
     4888       else do:
     4889         for each buf_temp-diasize-handle
     4890         on error undo move_block, retry move_block
     4891         :
     4892           assign
     4893             v-object-handle = buf_temp-diasize-handle.handle-value
     4894           .
     4895           if v-object-handle <> v-diasize-resize-button
     4896           then do:
     4897             assign
     4898               v-object-handle :row = v-object-handle :row + p-change-value
     4899               no-error .
     4900             if error-status :error
     4901             or error-status :get-message(1) <> ""
     4902             then do:
     4903               undo move_block, retry move_block .
     4904             end.
     4905           end.
     4906         end.
     4907         assign
     4908           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     4909           no-error .
     4910         if error-status :error
     4911         or error-status :get-message(1) <> ""
     4912         then do:
     4913           undo move_block, retry move_block .
     4914         end.
     4915         for each buf_temp-browse-handle
     4916           where buf_temp-browse-handle.browse-type = 'height':u
     4917         on error undo move_block, retry move_block
     4918         :
     4919           assign
     4920             buf_temp-browse-handle.browse-handle :height
     4921               = buf_temp-browse-handle.browse-handle :height + p-change-value
     4922             no-error .
     4923           if error-status :error
     4924           or error-status :get-message(1) <> ""
     4925           then do:
     4926             undo move_block, retry move_block .
     4927           end.
     4928         end.
     4929         assign
     4930           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     4931           no-error .
     4932         if error-status :error
     4933         or error-status :get-message(1) <> ""
     4934         then do:
     4935           undo move_block, retry move_block .
     4936         end.
     4937         if frame Dialog-Frame :scrollable = true
     4938         then do:
     4939           assign
     4940             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     4941             no-error .
     4942           if error-status :error
     4943           or error-status :get-message(1) <> ""
     4944           then do:
     4945             undo move_block, retry move_block .
     4946           end.
     4947         end.
     4948       end.
     4949       if p-move-resize = true
     4950       then do:
     4951         run diasize_position-resize-button in this-procedure .
     4952       end.
     4953       if v-diasize-wndstore = true
     4954       then do:
     4955         if connected("ub") = true
     4956         then do:
     4957           define variable v-cntxt-db-num        as integer   no-undo .
     4958           define variable v-cntxt-userid        as character no-undo .
     4959           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4960                                             , OUTPUT v-cntxt-userid
     4961                                             ) .
     4962           run gbl/wndsizew.p
     4963             (input  v-cntxt-db-num
     4964             ,input  v-cntxt-userid
     4965             ,input  v-diasize-proc-name
     4966             ,input  'height':u
     4967             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     4968             ) .
     4969         end.
     4970       end.
     4971     end.
     4972     assign
     4973       v-diasize-change-size = false
     4974     .
     4975   end procedure.
     4976   procedure diasize_set-height :
     4977     define input  parameter p-new-height  as decimal   no-undo .
     4978     define input  parameter p-move-resize as logical   no-undo .
     4979     do
     4980     on error undo, return error return-value
     4981     :
     4982       run diasize_change-height in this-procedure
     4983         (input  (p-new-height - frame Dialog-Frame :height)
     4984         ,input  p-move-resize
     4985         ) .
     4986     end.
     4987   end procedure.
     4988   procedure diasize_change-width :
     4989     define input  parameter p-change-value as decimal   no-undo .
     4990     define input  parameter p-move-resize  as logical   no-undo .
     4991     define variable v-field-group-handle   as handle    no-undo .
     4992     define variable v-object-handle        as handle    no-undo .
     4993     define variable v-frame-width          as decimal   no-undo .
     4994     define variable v-frame-virtual-width  as decimal   no-undo .
     4995     define variable v-browse-width         as decimal   no-undo .
     4996     define variable v-window-width         as decimal   no-undo .
     4997     define variable v-window-virtual-width as decimal   no-undo .
     4998     define variable v-change-sign          as integer   no-undo .
     4999     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     5000     define buffer buf_temp-browse-handle  for temp-browse-handle .
     5001     if p-change-value > 0
     5002     then do:
     5003       if frame Dialog-Frame :width + p-change-value >
     5004           session :width-chars
     5005       then do:
     5006         assign
     5007           p-change-value = session :width-chars - frame Dialog-Frame :width
     5008         .
     5009         if p-change-value <= 0
     5010         then do:
     5011           run diasize_position-resize-button in this-procedure .
     5012           return .
     5013         end.
     5014       end.
     5015     end.
     5016     if p-change-value < 0
     5017     then do:
     5018       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     5019       then do:
     5020         assign
     5021           p-change-value = v-diasize-orig-frame-width
     5022                          - frame Dialog-Frame :width
     5023         .
     5024         if p-change-value >= 0
     5025         then do:
     5026           run diasize_position-resize-button in this-procedure .
     5027           return .
     5028         end.
     5029       end.
     5030     end.
     5031     if p-change-value >= 0
     5032     then do:
     5033       assign
     5034         v-change-sign = 1
     5035       .
     5036     end.
     5037     else do:
     5038       assign
     5039         v-change-sign = -1
     5040       .
     5041     end.
     5042     assign
     5043       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     5044     .
     5045     if p-change-value = 0
     5046     then do:
     5047       run diasize_position-resize-button in this-procedure .
     5048       return .
     5049     end.
     5050     move_block:
     5051     do
     5052     on error undo move_block, leave move_block
     5053     :
     5054       if retry
     5055       then do:
     5056         do
     5057         on error undo move_block, leave move_block
     5058         :
     5059           if p-change-value > 0
     5060           then do:
     5061             for each buf_temp-diasize-handle
     5062             on error undo, next
     5063             :
     5064               assign
     5065                 v-object-handle = buf_temp-diasize-handle.handle-value
     5066               .
     5067               if v-object-handle <> v-diasize-resize-button
     5068               then do:
     5069                 assign
     5070                   v-object-handle :col = buf_temp-diasize-handle.save-position
     5071                 .
     5072               end.
     5073             end.
     5074             assign
     5075               v-diasize-browse-handle :width = v-browse-width
     5076             .
     5077             for each buf_temp-browse-handle
     5078               where buf_temp-browse-handle.browse-type = 'width':u
     5079             on error undo, next
     5080             :
     5081               assign
     5082                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     5083               .
     5084             end.
     5085             assign
     5086               frame Dialog-Frame :width = v-frame-width
     5087             .
     5088             if frame Dialog-Frame :scrollable = true
     5089             then do:
     5090               assign
     5091                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     5092               .
     5093             end.
     5094             run diasize_position-resize-button in this-procedure .
     5095           end.
     5096           else do:
     5097             if frame Dialog-Frame :scrollable = true
     5098             then do:
     5099               assign
     5100                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     5101               .
     5102             end.
     5103             assign
     5104               frame Dialog-Frame :width = v-frame-width
     5105             .
     5106             for each buf_temp-browse-handle
     5107               where buf_temp-browse-handle.browse-type = 'width':u
     5108             on error undo, next
     5109             :
     5110               assign
     5111                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     5112               .
     5113             end.
     5114             assign
     5115               v-diasize-browse-handle :width = v-browse-width
     5116             .
     5117             for each buf_temp-diasize-handle
     5118             on error undo, next
     5119             :
     5120               assign
     5121                 v-object-handle = buf_temp-diasize-handle.handle-value
     5122               .
     5123               if v-object-handle <> v-diasize-resize-button
     5124               then do:
     5125                 assign
     5126                   v-object-handle :col = buf_temp-diasize-handle.save-position
     5127                 .
     5128               end.
     5129             end.
     5130             run diasize_position-resize-button in this-procedure .
     5131           end.
     5132           assign
     5133             v-diasize-change-size = false
     5134           .
     5135           leave move_block .
     5136         end.
     5137       end.
     5138       assign
     5139         v-diasize-need-full-display = true
     5140       .
     5141       if v-diasize-change-size = false
     5142       then do:
     5143         assign
     5144           v-diasize-change-size = true
     5145         .
     5146       end.
     5147       else do:
     5148         return .
     5149       end.
     5150       assign
     5151         v-frame-width = frame Dialog-Frame :width
     5152         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     5153         v-browse-width = v-diasize-browse-handle :width
     5154       .
     5155       for each buf_temp-browse-handle
     5156         where buf_temp-browse-handle.browse-type = 'width':u
     5157       :
     5158         assign
     5159           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     5160         .
     5161       end.
     5162       for each buf_temp-diasize-handle
     5163       :
     5164         delete buf_temp-diasize-handle .
     5165       end.
     5166       assign
     5167         v-field-group-handle = frame Dialog-Frame :first-child
     5168       .
     5169       do while valid-handle(v-field-group-handle)
     5170       :
     5171         assign
     5172           v-object-handle = v-field-group-handle :first-child
     5173         .
     5174         do while valid-handle(v-object-handle)
     5175         :
     5176           if  v-object-handle <> v-diasize-browse-handle :handle
     5177           and v-object-handle <> v-diasize-resize-button
     5178           and can-query(v-object-handle, "row")
     5179           and can-query(v-object-handle, "height")
     5180           and ( v-object-handle :col + v-object-handle :width
     5181                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     5182               )
     5183           then do:
     5184             find first buf_temp-browse-handle
     5185               where buf_temp-browse-handle.browse-type   = 'width':u
     5186                 and buf_temp-browse-handle.browse-handle = v-object-handle
     5187               no-error .
     5188             if available buf_temp-browse-handle
     5189             then do:
     5190             end.
     5191             else do:
     5192               create buf_temp-diasize-handle .
     5193               assign
     5194                 buf_temp-diasize-handle.handle-value  = v-object-handle
     5195                 buf_temp-diasize-handle.save-position = v-object-handle :col
     5196               .
     5197             end.
     5198           end.
     5199           assign
     5200             v-object-handle = v-object-handle :next-sibling
     5201           .
     5202         end.
     5203         assign
     5204           v-field-group-handle = v-field-group-handle :next-sibling
     5205         .
     5206       end.
     5207       do with frame Dialog-Frame
     5208       :
     5209         hide v-diasize-resize-button .
     5210         v-diasize-resize-button :row = 1.
     5211         v-diasize-resize-button :column = 1.
     5212       end.
     5213       if p-change-value > 0
     5214       then do:
     5215         if frame Dialog-Frame :scrollable = true
     5216         then do:
     5217           assign
     5218             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     5219             no-error .
     5220           if error-status :error
     5221           or error-status :get-message(1) <> ""
     5222           then do:
     5223             undo move_block, retry move_block.
     5224           end.
     5225         end.
     5226         assign
     5227           frame Dialog-Frame :width = v-frame-width + p-change-value
     5228           no-error .
     5229         if error-status :error
     5230         or error-status :get-message(1) <> ""
     5231         then do:
     5232           undo move_block, retry move_block.
     5233         end.
     5234         assign
     5235           v-diasize-browse-handle :width = v-browse-width + p-change-value
     5236         no-error .
     5237         if error-status :error
     5238         or error-status :get-message(1) <> ""
     5239         then do:
     5240           undo move_block, retry move_block.
     5241         end.
     5242         for each buf_temp-browse-handle
     5243           where buf_temp-browse-handle.browse-type = 'width':u
     5244         on error undo move_block, retry move_block
     5245         :
     5246           assign
     5247             buf_temp-browse-handle.browse-handle :width
     5248               = buf_temp-browse-handle.browse-handle :width + p-change-value
     5249             no-error .
     5250           if error-status :error
     5251           or error-status :get-message(1) <> ""
     5252           then do:
     5253             undo move_block, retry move_block .
     5254           end.
     5255         end.
     5256         for each buf_temp-diasize-handle
     5257         on error undo move_block, retry move_block
     5258         :
     5259           assign
     5260             v-object-handle = buf_temp-diasize-handle.handle-value
     5261           .
     5262           if v-object-handle <> v-diasize-resize-button
     5263           then do:
     5264             assign
     5265               v-object-handle :col = v-object-handle :col + p-change-value
     5266               no-error .
     5267             if error-status :error
     5268             or error-status :get-message(1) <> ""
     5269             then do:
     5270               undo move_block, retry move_block .
     5271             end.
     5272           end.
     5273         end.
     5274       end.
     5275       else do:
     5276         for each buf_temp-diasize-handle
     5277         on error undo move_block, retry move_block
     5278         :
     5279           assign
     5280             v-object-handle = buf_temp-diasize-handle.handle-value
     5281           .
     5282           if v-object-handle <> v-diasize-resize-button
     5283           then do:
     5284             assign
     5285               v-object-handle :col = v-object-handle :col + p-change-value
     5286               no-error .
     5287             if error-status :error
     5288             or error-status :get-message(1) <> ""
     5289             then do:
     5290               undo move_block, retry move_block .
     5291             end.
     5292           end.
     5293         end.
     5294         for each buf_temp-browse-handle
     5295           where buf_temp-browse-handle.browse-type = 'width':u
     5296         on error undo move_block, retry move_block
     5297         :
     5298           assign
     5299             buf_temp-browse-handle.browse-handle :width
     5300               = buf_temp-browse-handle.browse-handle :width + p-change-value
     5301             no-error .
     5302           if error-status :error
     5303           or error-status :get-message(1) <> ""
     5304           then do:
     5305             undo move_block, retry move_block .
     5306           end.
     5307         end.
     5308         assign
     5309           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     5310           no-error .
     5311         if error-status :error
     5312         or error-status :get-message(1) <> ""
     5313         then do:
     5314           undo move_block, retry move_block.
     5315         end.
     5316         assign
     5317           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     5318         no-error .
     5319         if error-status :error
     5320         or error-status :get-message(1) <> ""
     5321         then do:
     5322           undo move_block, retry move_block.
     5323         end.
     5324         if frame Dialog-Frame :scrollable = true
     5325         then do:
     5326           assign
     5327             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     5328           no-error .
     5329           if error-status :error
     5330           or error-status :get-message(1) <> ""
     5331           then do:
     5332             undo move_block, retry move_block.
     5333           end.
     5334         end.
     5335       end.
     5336       if p-move-resize
     5337       then do:
     5338         run diasize_position-resize-button in this-procedure .
     5339       end.
     5340       if v-diasize-wndstore = true
     5341       then do:
     5342         if connected("ub") = true
     5343         then do:
     5344           define variable v-cntxt-db-num        as integer   no-undo .
     5345           define variable v-cntxt-userid        as character no-undo .
     5346           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     5347                                             , OUTPUT v-cntxt-userid
     5348                                             ) .
     5349           run gbl/wndsizew.p
     5350             (input  v-cntxt-db-num
     5351             ,input  v-cntxt-userid
     5352             ,input  v-diasize-proc-name
     5353             ,input  'width':u
     5354             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     5355             ) .
     5356         end.
     5357       end.
     5358     end.
     5359     assign
     5360       v-diasize-change-size = false
     5361     .
     5362   end procedure.
     5363   procedure diasize_set-width :
     5364     define input  parameter p-new-width  as decimal   no-undo .
     5365     define input  parameter p-move-resize as logical   no-undo .
     5366     do
     5367     on error undo, return error return-value
     5368     :
     5369       run diasize_change-width in this-procedure
     5370         (input  (p-new-width - frame Dialog-Frame :width)
     5371         ,input  p-move-resize
     5372         ) .
     5373     end.
     5374   end procedure.
     5375   procedure diasize_position-resize-button :
     5376     do with frame Dialog-Frame
     5377     :
     5378       hide v-diasize-resize-button .
     5379       assign
     5380         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     5381                     - 1
     5382                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     5383         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     5384                     - 1
     5385                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     5386       .
     5387       view v-diasize-resize-button .
     5388     end.
     5389   end procedure.
     5390   on alt-right anywhere
     5391   do:
     5392     run diasize_change-width in this-procedure
     5393       (input 1
     5394       ,input true
     5395       ) .
     5396     return no-apply .
     5397   end.
     5398   on alt-left anywhere
     5399   do:
     5400     run diasize_change-width in this-procedure
     5401       (input -1
     5402       ,input true
     5403       ) .
     5404     return no-apply .
     5405   end.
     5406   on alt-down anywhere
     5407   do:
     5408     run diasize_change-height in this-procedure
     5409       (input 1
     5410       ,input true
     5411       ) .
     5412     return no-apply .
     5413   end.
     5414   on alt-up anywhere
     5415   do:
     5416     run diasize_change-height in this-procedure
     5417       (input -1
     5418       ,input true
     5419       ) .
     5420     return no-apply .
     5421   end.
     5422   on alt-enter of frame Dialog-Frame
     5423   do:
     5424     run diasize_maximize in this-procedure
     5425       (input  ?
     5426       ).
     5427     return no-apply .
     5428   end.
     5429   procedure diasize_end-move :
     5430     do
     5431     on error undo, return error return-value
     5432     :
     5433       define variable v-row-delta as decimal   no-undo .
     5434       define variable v-col-delta as decimal   no-undo .
     5435       define variable v-new-row as decimal   no-undo .
     5436       define variable v-new-col as decimal   no-undo .
     5437       assign
     5438         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     5439         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     5440       .
     5441       assign
     5442         v-row-delta = v-new-row - frame Dialog-Frame :height
     5443         v-col-delta = v-new-col - frame Dialog-Frame :width
     5444       .
     5445       run diasize_change-height in this-procedure
     5446         (input v-row-delta
     5447         ,input true
     5448         ) .
     5449       run diasize_change-width in this-procedure
     5450         (input v-col-delta
     5451         ,input true
     5452         ) .
     5453     end.
     5454   end procedure.
     5455   procedure diasize_maximize :
     5456     define input  parameter p-action as logical   no-undo .
     5457     do
     5458     on error undo, return error return-value
     5459     :
     5460       if p-action = ?
     5461       then do:
     5462         if v-diasize-need-maximize = true
     5463         then do:
     5464           assign
     5465             p-action = true
     5466           .
     5467         end.
     5468         else do:
     5469           assign
     5470             p-action = false
     5471           .
     5472         end.
     5473       end.
     5474       if p-action = true
     5475       then do:
     5476         run diasize_change-height in this-procedure
     5477           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     5478               - frame Dialog-Frame :height-chars
     5479           ,input true
     5480           ) .
     5481         run diasize_change-width in this-procedure
     5482           (input session :width-chars
     5483               - frame Dialog-Frame :width-chars
     5484           ,input true
     5485           ) .
     5486         assign
     5487           v-diasize-need-maximize = false
     5488         .
     5489       end.
     5490       else do:
     5491         run diasize_change-width in this-procedure
     5492           (input v-diasize-orig-frame-width
     5493               - frame Dialog-Frame :width-chars
     5494           ,input true
     5495           ) .
     5496         run diasize_change-height in this-procedure
     5497           (input v-diasize-orig-frame-height
     5498               - frame Dialog-Frame :height-chars
     5499           ,input true
     5500           ) .
     5501         assign
     5502           v-diasize-need-maximize = true
     5503         .
     5504       end.
     5505     end.
     5506   end procedure.
     5507   procedure diasize_restore-orig-size :
     5508     do
     5509     on error undo, return error return-value
     5510     :
     5511       assign
     5512         v-diasize-current-frame-width  = frame Dialog-Frame :width
     5513         v-diasize-current-frame-height = frame Dialog-Frame :height
     5514       .
     5515       run diasize_set-height in this-procedure
     5516         (input  v-diasize-orig-frame-height
     5517         ,input  true
     5518         ) .
     5519       run diasize_set-width in this-procedure
     5520         (input  v-diasize-orig-frame-width
     5521         ,input  true
     5522         ) .
     5523     end.
     5524   end procedure.
     5525   procedure diasize_restore-current-size :
     5526     do
     5527     on error undo, return error return-value
     5528     :
     5529       run diasize_set-height in this-procedure
     5530         (input  v-diasize-current-frame-height
     5531         ,input  true
     5532         ) .
     5533       run diasize_set-width in this-procedure
     5534         (input  v-diasize-current-frame-width
     5535         ,input  true
     5536         ) .
     5537     end.
     5538   end procedure.
     5539   procedure diasize_set-browse-handle :
     5540     define input  parameter p-browse-handle as handle   no-undo .
     5541     define buffer buf_temp-browse-handle for temp-browse-handle .
     5542     do
     5543     on error undo, return error return-value
     5544     :
     5545       assign
     5546         v-diasize-browse-handle = p-browse-handle
     5547       .
     5548       for each buf_temp-browse-handle
     5549       on error undo, return error return-value
     5550       :
     5551         delete buf_temp-browse-handle .
     5552       end.
     5553     end.
     5554   end procedure.
     5555   procedure diasize_add_browse :
     5556     define input  parameter p-browse-type   as character no-undo .
     5557     define input  parameter p-browse-handle as handle    no-undo .
     5558     define buffer buf_temp-browse-handle for temp-browse-handle .
     5559     do
     5560     on error undo, return error return-value
     5561     :
     5562       assign
     5563         v-diasize-browse-number = v-diasize-browse-number + 1
     5564       .
     5565       create buf_temp-browse-handle .
     5566       assign
     5567         buf_temp-browse-handle.browse-type   = p-browse-type
     5568         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     5569         buf_temp-browse-handle.browse-handle = p-browse-handle
     5570       .
     5571     end.
     5572   end procedure.
     5573   procedure diasize_init :
     5574     define variable v-default-value    as logical   no-undo .
     5575     define variable v-restore-saved    as logical   no-undo .
     5576     define variable v-resize-value-str as character no-undo .
     5577     do
     5578     on error undo, return error return-value
     5579     :
     5580       do with frame Dialog-Frame
     5581       :
     5582         assign
     5583           v-diasize-orig-frame-height = frame Dialog-Frame :height
     5584           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     5585           v-diasize-browse-handle     = browse br-list :handle
     5586         .
     5587         create button v-diasize-resize-button
     5588         assign
     5589           parent        = frame Dialog-Frame :first-child
     5590           label         = "s"
     5591           height-pixels = 16
     5592           width-pixels  = 16
     5593           visible       = true
     5594           sensitive     = true
     5595           movable       = true
     5596           triggers:
     5597             on end-move persistent run diasize_end-move in this-procedure .
     5598           end triggers.
     5599         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     5600         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     5601         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     5602         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     5603         assign
     5604           v-diasize-wndmax = false
     5605         .
     5606         if connected("ub") = true
     5607         then do:
     5608           define variable v-cntxt-db-num        as integer   no-undo .
     5609           define variable v-cntxt-userid        as character no-undo .
     5610           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     5611                                             , OUTPUT v-cntxt-userid
     5612                                             ) .
     5613           run gbl/wndpar_r.p
     5614             (input  v-cntxt-db-num
     5615             ,input  v-cntxt-userid
     5616             ,input  'wndmax':U
     5617             ,output v-diasize-wndmax
     5618             ,output v-default-value
     5619             ) .
     5620         end.
     5621         assign
     5622           v-diasize-wndstore = false
     5623         .
     5624         if connected("ub") = true
     5625         then do:
     5626           run gbl/wndpar_r.p
     5627             (input  v-cntxt-db-num
     5628             ,input  v-cntxt-userid
     5629             ,input  'wndstore':U
     5630             ,output v-diasize-wndstore
     5631             ,output v-default-value
     5632             ) .
     5633         end.
     5634         assign
     5635           v-diasize-proc-name = entry(1, program-name(2), '.')
     5636         .
     5637         if v-diasize-wndstore = true
     5638         then do:
     5639           assign
     5640             v-restore-saved = false
     5641           .
     5642           if connected("ub") = true
     5643           then do:
     5644             run gbl/wndsizer.p
     5645               (input  v-cntxt-db-num
     5646               ,input  v-cntxt-userid
     5647               ,input  v-diasize-proc-name
     5648               ,input  'height':u
     5649               ,output v-resize-value-str
     5650               ) .
     5651             if v-resize-value-str <> '':U
     5652             then do:
     5653               run diasize_change-height in this-procedure
     5654                 (input  integer(v-resize-value-str)
     5655                 ,input  true
     5656                 ) .
     5657               assign
     5658                 v-restore-saved = true
     5659               .
     5660             end.
     5661           end.
     5662           if connected("ub") = true
     5663           then do:
     5664             run gbl/wndsizer.p
     5665               (input  v-cntxt-db-num
     5666               ,input  v-cntxt-userid
     5667               ,input  v-diasize-proc-name
     5668               ,input  'width':u
     5669               ,output v-resize-value-str
     5670               ) .
     5671             if v-resize-value-str <> '':U
     5672             then do:
     5673               run diasize_change-width in this-procedure
     5674                 (input  integer(v-resize-value-str)
     5675                 ,input  true
     5676                 ) .
     5677               assign
     5678                 v-restore-saved = true
     5679               .
     5680             end.
     5681           end.
     5682           if v-restore-saved <> true
     5683           then do:
     5684             if v-diasize-wndmax = true
     5685             then do:
     5686               run diasize_maximize in this-procedure
     5687                 (input  true
     5688                 ) .
     5689             end.
     5690           end.
     5691         end.
     5692         else do:
     5693           if v-diasize-wndmax = true
     5694           then do:
     5695             run diasize_maximize in this-procedure
     5696               (input  true
     5697               ) .
     5698           end.
     5699         end.
     5700       end.
     5701     end.
     5702   end procedure.
     5703   procedure diasize_need-full-display :
     5704     define output parameter p-need-full-display as logical   no-undo .
     5705     do
     5706     on error undo, return error return-value
     5707     :
     5708       assign
     5709         p-need-full-display = v-diasize-need-full-display
     5710       .
     5711       assign
     5712         v-diasize-need-full-display = false
     5713       .
     5714     end.
     5715   end procedure.
     5716   procedure get-context :
     5717      define output parameter p-db-num as integer          no-undo.
     5718      define output parameter p-user-id as character        no-undo.
     5719      define variable v-login               as character    no-undo.
     5720      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     5721      define buffer buf_user-login  for ub.user-login .
     5722      do
     5723      on error undo, return error
     5724      :
     5725            FIND FIRST buf_sys-ctrl no-lock.
     5726            ASSIGN
     5727               v-login = USERID("ub")
     5728               p-db-num = buf_sys-ctrl.db-num
     5729            .
     5730            FIND FIRST buf_user-login
     5731                 WHERE buf_user-login.db-num = p-db-num
     5732                   AND buf_user-login.user-login = v-login
     5733                 no-lock
     5734                 no-error
     5735                 .
     5736            IF AVAILABLE buf_user-login
     5737            THEN DO:
     5738               assign
     5739                  p-user-id = buf_user-login.user-id
     5740               .
     5741            END.
     5742      end.
     5743   end procedure.
     5744   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5745   on help of frame Dialog-Frame
     5746   do:
     5747     run gbl/app_help.p
     5748       (input this-procedure :file-name
     5749       ,input ''
     5750       ,input ?
     5751       ) no-error.
     5752     if error-status :error then do:
     5753       message
     5754         "Ошибка при вызове помощи"
     5755         error-status :get-message(1)
     5756         view-as alert-box .
     5757     end.
     5758   end.
     5759   run minbtn-set in this-procedure .
     5760   on choose of b-help in frame Dialog-Frame
     5761   do:
     5762     apply "help":u to frame Dialog-Frame .
     5763   end.
     5764   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5765   procedure minbtn-set :
     5766       do
     5767           on error undo, return error return-value
     5768           :
     5769           define variable ii              as integer       no-undo .
     5770           define variable fh              as widget-handle no-undo .
     5771           define variable hh              as widget-handle no-undo .
     5772           define variable v-h             as handle        extent 4 no-undo .
     5773           define variable v-name-button   as character     no-undo .
     5774           define variable v-help-old-x    as decimal       no-undo .
     5775           define variable v-help-old-y    as decimal       no-undo .
     5776           define variable v-help-old-size as decimal       no-undo .
     5777           define variable v-frame-width   as decimal       no-undo .
     5778           define variable jj              as integer       no-undo .
     5779           do
     5780               on error undo, return error
     5781               :
     5782               assign
     5783                   v-frame-width = frame Dialog-Frame:width - 0.3
     5784                   fh            = frame Dialog-Frame:first-child
     5785                   hh            = fh:first-child
     5786                   ii            = 1
     5787                   .
     5788               do while valid-handle(hh):
     5789                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     5790                   do:
     5791                       case lc(hh:name) :
     5792                           when "b-help" then
     5793                               do:
     5794                                   hh:load-image-up("cmp/b-help.bmp":u) .
     5795                                   hh:load-image-down("cmp/b-help.bmp":u) .
     5796                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     5797                                   hh:TOOLTIP = "Помощь" .
     5798                                   v-help-old-x = hh:column .
     5799                                   v-help-old-y = hh:row    .
     5800                                   v-help-old-size = hh:width .
     5801                                   hh:width-chars = 2.5 .
     5802                               end.
     5803                           when "b-print" then
     5804                               do:
     5805                                   hh:load-image("cmp/b-print.bmp":u) .
     5806                                   hh:TOOLTIP = "Печать" .
     5807                                   v-h[ii] = hh:handle .
     5808                                   ii = ii + 1 .
     5809                                   hh:width-chars = 3 .
     5810                               end.
     5811                           when "b-history" or
     5812                           when "b-hist" then
     5813                               do:
     5814                                   hh:load-image("cmp/b-hist.bmp":u) .
     5815                                   hh:TOOLTIP = "История" .
     5816                                   v-h[ii] = hh:handle .
     5817                                   ii = ii + 1 .
     5818                                   hh:width-chars = 3 .
     5819                               end.
     5820                           when "b-sch" then
     5821                               do:
     5822                                   hh:load-image("cmp/b-sch.bmp":u) .
     5823                                   hh:TOOLTIP = "Установка Фильтра" .
     5824                                   v-h[ii] = hh:handle .
     5825                                   ii = ii + 1 .
     5826                                   hh:width-chars = 3 .
     5827                               end.
     5828                           when "b-hist-user" then
     5829                               do:
     5830                                   hh:load-image("cmp/b-hist.bmp":u) .
     5831                                   hh:TOOLTIP = "История пользователя" .
     5832                                   ii = ii + 1 .
     5833                               end.
     5834                       end case.
     5835                   end.
     5836                   hh = hh:next-sibling.
     5837               end.
     5838               b-help:column = v-frame-width - b-help:width-chars.
     5839               jj = 0.
     5840               repeat ii = 4 to 1 by -1 :
     5841                   if valid-handle (v-h[ii] ) then
     5842                   do:
     5843                       jj  = jj + 1 .
     5844                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     5845                       v-h[ii]:row    = v-help-old-y .
     5846                   end.
     5847               end.
     5848           end.
     5849       end.
     5850   end procedure.
     5851   run diasize_init in this-procedure .
     5852   def var vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5853   def var vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5854   define variable v-no-context as logical no-undo .
     5855   define variable v-user-obj-type as character no-undo .
     5856   define variable v-user-obj-code as integer no-undo .
     5857   FUNCTION prepare-rowid returns character ( input p-uniq-key-rec as character
     5858                                            , input p-no-context as logical ):
     5859   define variable v-uniq-key-rec as character no-undo .
     5860   if p-no-context and p-uniq-key-rec begins 'user-obj':U then do:
     5861     v-uniq-key-rec = 'clients':U + chr(3) +
     5862                     entry(4, p-uniq-key-rec, chr(3)) + chr(3) +
     5863                     entry(5, p-uniq-key-rec, chr(3)).
     5864   end.
     5865   else do:
     5866     v-uniq-key-rec = p-uniq-key-rec.
     5867     case entry(1, p-uniq-key-rec, chr(3)):
     5868        when 'user-obj':U then do:
     5869          entry(lookup("user-id", buffer ub.user-obj:handle:keys) + 1, v-uniq-key-rec, chr(3)) = v-cntxt-userid.
     5870          entry(lookup("db-num", buffer ub.user-obj:handle:keys) + 1, v-uniq-key-rec, chr(3)) = string(v-cntxt-db-num).
     5871        end.
     5872     end case.
     5873   end.
     5874   return v-uniq-key-rec.
     5875   end function.
     5876   procedure find-user-obj-rowid :
     5877   define input parameter p-rowid as rowid no-undo .
     5878   define input parameter p-no-context as logical no-undo .
     5879   define output parameter p-user-obj-type as character no-undo .
     5880   define output parameter p-user-obj-code as integer no-undo .
     5881   define buffer user-obj_clients for ub.clients.
     5882   define buffer user-obj_user-obj for ub.user-obj .
     5883   if p-no-context then do:
     5884     find first user-obj_clients no-lock where rowid(user-obj_clients) = p-rowid.
     5885     assign
     5886     p-user-obj-type = user-obj_clients.obj-type
     5887     p-user-obj-code = user-obj_clients.obj-code.
     5888   end.
     5889   else do:
     5890     find first user-obj_user-obj no-lock where rowid(user-obj_user-obj) = p-rowid no-error.
     5891     if not available user-obj_user-obj then do:
     5892       undo, return error substitute("Не удалось выполнить в данной БД записанные действия пользователя").
     5893     end.
     5894     assign
     5895     p-user-obj-type = user-obj_user-obj.obj-type
     5896     p-user-obj-code = user-obj_user-obj.obj-code.
     5897   end.
     5898   end procedure.
     5899   define variable an-listp-start-macro-id as integer no-undo init ?.
     5900   define variable an-listp-end-macro-id as integer no-undo  init ?.
     5901   define variable an-listp-macros-label-id as integer   no-undo .
     5902   define variable v-macro-is-running as logical no-undo .
     5903   define variable v-current-step as integer no-undo .
     5904   define variable v-expand as logical no-undo .
     5905   define variable v-downed as character no-undo .
     5906   define variable p-title as character no-undo .
     5907   define variable bttns as character no-undo .
     5908   define variable p-keep-query as logical no-undo .
     5909   define variable vss-include-info56 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5910   define     temp-table keep-macro-list-hist no-undo
     5911   field list-table as character
     5912   field id as integer
     5913   field line as integer
     5914   field hist-mode as character
     5915   field des as character
     5916   field num-recs as integer
     5917   field option_ as character
     5918   field item_ as character
     5919   field status_ as character
     5920   field num-add as integer
     5921   field num-ignored as integer
     5922   field done as logical
     5923   field err_ as logical
     5924   field err-mes as character
     5925   index pi is primary
     5926   id
     5927   line
     5928   index isdone
     5929   done
     5930   .
     5931   procedure assign-nums :
     5932   define input-output parameter p-num-add as integer no-undo .
     5933   define input-output parameter p-num-rec as integer no-undo .
     5934   define input-output parameter p-num-ignored as integer no-undo .
     5935   define input parameter p-line-mode as character no-undo .
     5936   assign
     5937   p-num-add  = lns-cnt - v-num-add
     5938   p-num-rec = (if line-mode = 'ОСТАВИТЬ':U
     5939                             then (tot-lns + p-num-add)
     5940                             else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))
     5941   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)
     5942   p-num-ignored = lns-ignore  - v-num-ignored
     5943   v-num-add             = lns-cnt
     5944   v-num-ignored         = lns-ignore
     5945   .
     5946   END PROCEDURE.
     5947   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     5948   or INSERT-MODE of br-list
     5949   DO:
     5950   define variable glog as logical no-undo .
     5951   define buffer buf-scnblist-hist for scnblist-hist.
     5952   define buffer buf_macro-list-hist for macro-list-hist.
     5953   define buffer buf_keep-macro-list-hist for keep-macro-list-hist.
     5954    if p-keep-query then do:
     5955       glog = no.
     5956       message "Реинициализация списка. Вы уверены ?"
     5957               view-as alert-box question buttons OK-Cancel update glog.
     5958       if not glog then return no-apply.
     5959       if session:set-wait-state( "COMPILER" )  then .
     5960       for each scnblist:
     5961         delete scnblist.
     5962       end.
     5963       if session:set-wait-state( "" )  then .
     5964       tot-lns = 0.
     5965       v-seq = 1.
     5966       for each buf-scnblist-hist:
     5967         delete buf-scnblist-hist.
     5968       end.
     5969      for each buf_keep-macro-list-hist:
     5970        create buf_macro-list-hist.
     5971      end.
     5972      run proc-macro-play in this-procedure ( input 0, input yes, input 0).
     5973      run create-scnblist-hist in this-procedure (
     5974                                             input 'ДОБАВЛЕНИЕ':U
     5975                                           , input-output v-seq
     5976                                           , input 0
     5977                                           , input '0':U
     5978                                           , input "# Реинициализация списка."
     5979                                           , input 0
     5980                                           , input "init"
     5981                                           , input '':U
     5982                                           , input '':U
     5983                                           , input '':U
     5984                                           , input ?
     5985                                           ).
     5986       display
     5987       tot-lns @ f-tot-lns
     5988       with frame Dialog-Frame.
     5989       run ui-on in this-procedure .
     5990    end.
     5991    else do:
     5992      assign rs-list-method = "single".
     5993      run proc-b-add in this-procedure(input no
     5994                                     ,input ?
     5995                                     ,input rs-list-method
     5996                                     ,input rs-status)  no-error .
     5997     if error-status:error then return no-apply.
     5998   end.
     5999   END.
     6000   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     6001   or DELETE-CHARACTER of br-list
     6002   DO:
     6003     if not available scnblist then return no-apply.
     6004     assign rs-list-method = "single".
     6005     run proc-b-del in this-procedure(no, ?, (rs-list-method + chr(4) +
     6006                                              (if scnblist.b-str <> '':U and not scnblist.loc-ean
     6007                                              then 'prod-bc':U
     6008                                              else (if scnblist.loc-ean
     6009                                                    then 'loc-ean':U
     6010                                                    else 'bar-code':U)
     6011                                              )
     6012                                              )
     6013     , rs-status) no-error.
     6014     if error-status:error then return no-apply.
     6015   END.
     6016   ON CHOOSE OF B-rest IN FRAME Dialog-Frame
     6017   DO:
     6018   if not available scnblist then return no-apply.
     6019     assign rs-list-method = "single".
     6020     run proc-b-rest in this-procedure(no, ?, (rs-list-method + chr(4) +
     6021                                              (if scnblist.b-str <> '':U and not scnblist.loc-ean
     6022                                              then 'prod-bc':U
     6023                                              else (if scnblist.loc-ean
     6024                                                    then 'loc-ean':U
     6025                                                    else 'bar-code':U)
     6026                                              )
     6027                                              )
     6028     , rs-status) no-error.
     6029     if error-status:error then return no-apply.
     6030   END.
     6031   ON CHOOSE OF B-macro IN FRAME Dialog-Frame
     6032   DO:
     6033   run proc-b-macro in this-procedure ( input 'file') no-error .
     6034   if error-status:error then return no-apply.
     6035   END.
     6036   ON CHOOSE OF B-record IN FRAME Dialog-Frame
     6037   DO:
     6038   define variable glog as logical no-undo .
     6039   message
     6040   "Начать запись макроса формирования списка?"
     6041   view-as alert-box QUESTION buttons yes-no update glog.
     6042   if not glog then return no-apply.
     6043   assign
     6044   an-listp-start-macro-id = v-seq
     6045   an-listp-end-macro-id = ?
     6046   .
     6047   disable
     6048   b-record with frame Dialog-Frame .
     6049   hide
     6050   b-record
     6051   b-macro
     6052   in frame Dialog-Frame .
     6053   enable
     6054   b-stop with frame Dialog-Frame .
     6055   run create-scnblist-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     6056                                       , input-output v-seq
     6057                                       , input 0
     6058                                       , input 'o':U
     6059                                       , input "Начата запись макроса формирования списка"
     6060                                       , input tot-lns
     6061                                       , input 'macro':U
     6062                                       , input '':U
     6063                                       , input '':U
     6064                                       , input '':U
     6065                                       , input ?
     6066                                       ).
     6067   END.
     6068   ON CHOOSE OF B-stop IN FRAME Dialog-Frame
     6069   DO:
     6070   define variable glog as logical no-undo .
     6071   define variable v-id as integer no-undo .
     6072   define buffer buf_scnblist-hist for scnblist-hist.
     6073   message
     6074   "Закончить запись макроса формирования списка?"
     6075   view-as alert-box QUESTION buttons yes-no update glog.
     6076   if not glog then return no-apply.
     6077   assign
     6078   an-listp-end-macro-id = v-seq.
     6079   disable
     6080   b-stop with frame Dialog-Frame .
     6081   hide
     6082   b-stop in frame Dialog-Frame .
     6083   enable
     6084   b-record
     6085   b-macro
     6086   with frame Dialog-Frame .
     6087   run create-scnblist-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     6088                                       , input-output v-seq
     6089                                       , input 0
     6090                                       , input '[]':U
     6091                                       , input "Закончена запись макроса формирования списка"
     6092                                       , input tot-lns
     6093                                       , input 'macro':U
     6094                                       , input '':U
     6095                                       , input '':U
     6096                                       , input '':U
     6097                                       , input ?
     6098                                       ).
     6099   for each macro-list-hist:
     6100     delete macro-list-hist.
     6101   end.
     6102   for each buf_scnblist-hist where
     6103           buf_scnblist-hist.id >=  an-listp-start-macro-id
     6104     and  buf_scnblist-hist.id <=  an-listp-end-macro-id:
     6105     create macro-list-hist.
     6106     buffer-copy buf_scnblist-hist
     6107     except id num-recs num-add num-ignored
     6108     to macro-list-hist
     6109     assign
     6110     macro-list-hist.id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6111     v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6112     .
     6113   end.
     6114   END.
     6115   ON CHOOSE OF b-clear-macro IN FRAME Dialog-Frame
     6116   DO:
     6117   disable
     6118   b-clear-macro with frame Dialog-Frame .
     6119   assign
     6120   an-listp-start-macro-id = ?
     6121   an-listp-end-macro-id = ?
     6122   an-listp-macros-label-id = 0
     6123   .
     6124   for each macro-list-hist:
     6125     delete macro-list-hist.
     6126   end.
     6127   hide
     6128   b-clear-macro in frame Dialog-Frame .
     6129   enable
     6130   b-record
     6131   b-macro
     6132   with frame Dialog-Frame .
     6133   END.
     6134   ON VALUE-CHANGED OF br-option IN FRAME Dialog-Frame
     6135   DO:
     6136     assign
     6137     Rs-list-method = temp-list.fvalue
     6138     .
     6139     run proc-cd2 in this-procedure.
     6140     run proc-vc-rs-list-method in this-procedure no-error .
     6141     if error-status:error then return no-apply.
     6142   END.
     6143   PROCEDURE get-operation :
     6144   define input parameter p-message as character no-undo .
     6145   define output parameter p-operation as integer no-undo .
     6146     do
     6147     on error undo, return error
     6148     :
     6149       run gbl/d-askw.w (
     6150                     input "Выбор операции над заданным списком"
     6151                    ,input (p-message + chr(10) +
     6152                            "Выберите операцию, которую Вы хотите применить к полученному списку" +  chr(10) )
     6153                    ,input "|"
     6154                   ,input  ("Добавить" + (if p-keep-query then "^disable" else '':U) + "|" +
     6155                            "Удалить" + "|" +
     6156                            "Оставить" + "|" +
     6157                            "Отказ")
     6158                    ,input ("Добавить полученный список к уже имеющемуся" + "|" +
     6159                           "Удалить полученный список из уже имеющегося" + "|" +
     6160                           "Оставить в уже имеющемся списке только элементы полученного списка" +  "|" +
     6161                           "Ничего не делать")
     6162                    ,input  (if p-keep-query then 2 else 1)
     6163                    ,input  4
     6164                    ,output p-operation).
     6165      if p-operation = 4 then do:
     6166         return error .
     6167      end.
     6168     end.
     6169   END PROCEDURE.
     6170   PROCEDURE proc-fill-temp-list :
     6171     define variable v-index               as integer   no-undo .
     6172     define variable v-num-entries-options as integer   no-undo .
     6173     do
     6174     on error undo, return error
     6175     :
     6176       assign
     6177         v-num-entries-options = num-entries("Текущая строка,single,                           Товары-коды по типам,goods,                       Товар-лок.код,goods-b-code,                       Товар-лок.код(EAN),goods-b-code-ean,              Товар-Доп.БК,goods-b-str,                         Бар-код в чеке-последний чек,last-check,           Все выключенные ДопБк,prod-bc-off,                Коды на кассе,cd-codes,                           Лок.коды просроч.партий своб.зоны,parts-last-date,         Лок.коды просроч.зарезерв. партий,parts-rsrv-last-date,    Лок.коды(EAN) просроч.партий своб.зоны,parts-ean-last-date,         Лок.коды(EAN) просроч.зарезерв. партий,parts-ean-rsrv-last-date,    Лок.коды ФиБ партий своб.зоны,parts-fib,         Лок.коды зарезерв ФиБ партий,parts-rsrv-fib,    Лок.коды(EAN) ФиБ партий своб.зоны,parts-ean-fib,         Лок.коды(EAN) зарезерв. ФиБ партий,parts-ean-rsrv-fib,    Лок.коды товаров с продажей по партиям,parts-cashparts,         Лок.коды (EAN)товаров с продажей по партиям,parts-ean-cashparts,         Лок.коды законч.на объ.партий,parts-end-date-obj,         Лок.коды(EAN) законч.на объ.партий,parts-ean-end-date-obj,         Лок.весовые коды в БД,loc-sc-codes,          Лок.штучные коды для весов в БД,loc-pg-codes,          Глоб.весовые коды,gbl-sc-codes,          Файл списка товаров,file-gds,                     Фильтр баркодов,filter,                           Все,all,                                          Список товаров,gds-list,                          Мобильн. сканер,scaner")
     6178       .
     6179       do v-index = 1 to v-num-entries-options by 2
     6180       :
     6181         create temp-list.
     6182         assign
     6183           temp-list.fname  = trim(entry(v-index
     6184                                        ,"Текущая строка,single,                           Товары-коды по типам,goods,                       Товар-лок.код,goods-b-code,                       Товар-лок.код(EAN),goods-b-code-ean,              Товар-Доп.БК,goods-b-str,                         Бар-код в чеке-последний чек,last-check,           Все выключенные ДопБк,prod-bc-off,                Коды на кассе,cd-codes,                           Лок.коды просроч.партий своб.зоны,parts-last-date,         Лок.коды просроч.зарезерв. партий,parts-rsrv-last-date,    Лок.коды(EAN) просроч.партий своб.зоны,parts-ean-last-date,         Лок.коды(EAN) просроч.зарезерв. партий,parts-ean-rsrv-last-date,    Лок.коды ФиБ партий своб.зоны,parts-fib,         Лок.коды зарезерв ФиБ партий,parts-rsrv-fib,    Лок.коды(EAN) ФиБ партий своб.зоны,parts-ean-fib,         Лок.коды(EAN) зарезерв. ФиБ партий,parts-ean-rsrv-fib,    Лок.коды товаров с продажей по партиям,parts-cashparts,         Лок.коды (EAN)товаров с продажей по партиям,parts-ean-cashparts,         Лок.коды законч.на объ.партий,parts-end-date-obj,         Лок.коды(EAN) законч.на объ.партий,parts-ean-end-date-obj,         Лок.весовые коды в БД,loc-sc-codes,          Лок.штучные коды для весов в БД,loc-pg-codes,          Глоб.весовые коды,gbl-sc-codes,          Файл списка товаров,file-gds,                     Фильтр баркодов,filter,                           Все,all,                                          Список товаров,gds-list,                          Мобильн. сканер,scaner"
     6185                                        )
     6186                                  ,chr(32)
     6187                                  )
     6188           temp-list.fvalue = trim(entry(v-index + 1
     6189                                        ,"Текущая строка,single,                           Товары-коды по типам,goods,                       Товар-лок.код,goods-b-code,                       Товар-лок.код(EAN),goods-b-code-ean,              Товар-Доп.БК,goods-b-str,                         Бар-код в чеке-последний чек,last-check,           Все выключенные ДопБк,prod-bc-off,                Коды на кассе,cd-codes,                           Лок.коды просроч.партий своб.зоны,parts-last-date,         Лок.коды просроч.зарезерв. партий,parts-rsrv-last-date,    Лок.коды(EAN) просроч.партий своб.зоны,parts-ean-last-date,         Лок.коды(EAN) просроч.зарезерв. партий,parts-ean-rsrv-last-date,    Лок.коды ФиБ партий своб.зоны,parts-fib,         Лок.коды зарезерв ФиБ партий,parts-rsrv-fib,    Лок.коды(EAN) ФиБ партий своб.зоны,parts-ean-fib,         Лок.коды(EAN) зарезерв. ФиБ партий,parts-ean-rsrv-fib,    Лок.коды товаров с продажей по партиям,parts-cashparts,         Лок.коды (EAN)товаров с продажей по партиям,parts-ean-cashparts,         Лок.коды законч.на объ.партий,parts-end-date-obj,         Лок.коды(EAN) законч.на объ.партий,parts-ean-end-date-obj,         Лок.весовые коды в БД,loc-sc-codes,          Лок.штучные коды для весов в БД,loc-pg-codes,          Глоб.весовые коды,gbl-sc-codes,          Файл списка товаров,file-gds,                     Фильтр баркодов,filter,                           Все,all,                                          Список товаров,gds-list,                          Мобильн. сканер,scaner"
     6190                                        )
     6191                                  ,chr(32)
     6192                                  )
     6193           temp-list.id     = v-index
     6194         .
     6195       end.
     6196     end.
     6197   END PROCEDURE.
     6198   procedure proc-b-macro :
     6199   define input parameter p-option as character no-undo .
     6200   define variable glog as logical no-undo .
     6201   define variable v-id as integer no-undo .
     6202   define variable v-result as character no-undo .
     6203   define variable v-des as character no-undo .
     6204   define variable v-hist-mode as character no-undo .
     6205   define variable v-file as logical no-undo .
     6206   define variable v-full-path        as character no-undo .
     6207   define variable v-path             as character no-undo .
     6208   define variable v-file-name        as character no-undo .
     6209   define variable v-file-name-no-ext as character no-undo .
     6210   define variable v-file-name-ext    as character no-undo .
     6211   define variable v-rid-list as character no-undo .
     6212   define variable v-ok as logical no-undo .
     6213   define buffer buf_scnblist-hist for scnblist-hist.
     6214   define buffer buf_clob-bind for ub.clob-bind.
     6215   define buffer buf_clob-data for ub.clob-data.
     6216   do
     6217   on error undo, return error
     6218   :
     6219     if v-macro-is-running then do:
     6220     end.
     6221     else do:
     6222       glog = yes.
     6223       if an-listp-start-macro-id >= 1 then do:
     6224         case p-option:
     6225           when "file" then do:
     6226         message
     6227         "Согласно командам формирования списка из записанного макроса"
     6228         view-as alert-box question buttons OK-Cancel update glog.
     6229           end.
     6230           when "lob" then do:
     6231             message
     6232             "Нелья!"
     6233             view-as alert-box question buttons OK-Cancel update glog.
     6234             run ui-on in this-procedure .
     6235             return error.
     6236           end.
     6237         end case.
     6238         if not glog then do:
     6239           run ui-on in this-procedure .
     6240           return error.
     6241         end.
     6242         if an-listp-end-macro-id = ? then do:
     6243           assign
     6244           an-listp-end-macro-id  = v-seq.
     6245           for each macro-list-hist:
     6246             delete macro-list-hist.
     6247           end.
     6248           for each buf_scnblist-hist where
     6249                   buf_scnblist-hist.id >=  an-listp-start-macro-id
     6250             and  buf_scnblist-hist.id <=  an-listp-end-macro-id:
     6251             create macro-list-hist.
     6252             buffer-copy buf_scnblist-hist
     6253             except id num-recs num-add num-ignored
     6254             to macro-list-hist
     6255             assign
     6256             macro-list-hist.id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6257             v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6258             macro-list-hist.done = no
     6259             .
     6260           end.
     6261         end.
     6262         else do:
     6263           find last macro-list-hist no-error.
     6264           if available macro-list-hist then do:
     6265             v-id = macro-list-hist.id.
     6266           end.
     6267         end.
     6268       end.
     6269       else do:
     6270         case p-option:
     6271           when "file" then do:
     6272         message
     6273         "Согласно командам формирования списка из ранее сохраненного в файле макроса"
     6274         view-as alert-box question buttons OK-Cancel update glog.
     6275         if not glog then do:
     6276           run ui-on in this-procedure .
     6277           return error.
     6278         end.
     6279         system-dialog get-file f-name
     6280           filters "Макрос формирования списка *.bbm" "*.bbm"
     6281           title "Выберите файл макроса"
     6282           INITIAL-DIR "."
     6283           return-to-start-dir
     6284           must-exist
     6285           update glog
     6286           default-extension "bbm".
     6287         if not glog then do:
     6288           run ui-on in this-procedure .
     6289           return error.
     6290         end.
     6291           end.
     6292           when "lob" then do:
     6293             message
     6294             "Согласно командам формирования списка из макроса, сохраненного в БД"
     6295             view-as alert-box question buttons OK-Cancel update glog.
     6296             if not glog then do:
     6297               run ui-on in this-procedure .
     6298               return error.
     6299             end.
     6300             run ref/clobbnds.w ( input parparentproc
     6301                                 ,input this-procedure:handle
     6302                                 ,input 'b-sel'
     6303                                 ,input "uniq-key-rec"
     6304                                 ,input ""
     6305                                 ,input 'list-macro':U
     6306                                 ,input 'bb-list'
     6307                                 ,input -1
     6308                                 ,input-output v-rid-list) no-error.
     6309             if v-rid-list = '' then do:
     6310               run ui-on in this-procedure.
     6311               return error.
     6312             end.
     6313             find first buf_clob-bind no-lock where
     6314                       recid(buf_clob-bind) = integer(v-rid-list) no-error.
     6315             if not available buf_clob-bind then do:
     6316               message
     6317               "Не найдена ссылка на макрос, сохраненный в БД!"
     6318               view-as alert-box error .
     6319               run ui-on in this-procedure .
     6320               return error.
     6321             end.
     6322             find first buf_clob-data no-lock where
     6323                       buf_clob-data.db-num = buf_clob-bind.db-num
     6324                   and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     6325             if not available buf_clob-data then do:
     6326               message
     6327               "Не найдена ссылка на макрос, сохраненный в БД!"
     6328               view-as alert-box error .
     6329               run ui-on in this-procedure .
     6330               return error.
     6331             end.
     6332             if buf_clob-data.db-num <> v-cntxt-db-num then do:
     6333               message
     6334               substitute("Возможно, не все действия пользователя БД &1 удастся воспроизвести!&2Продолжить?"
     6335                         , buf_clob-data.db-num
     6336                         , chr(10))
     6337              view-as alert-box question buttons yes-no update v-ok.
     6338              if not v-ok then do:
     6339                 run ui-on in this-procedure .
     6340                 return error.
     6341              end.
     6342             end.
     6343             run gbl/_tmpfile.p ( input ""
     6344                           ,input "tmp"
     6345                           ,output v-file-name) .
     6346             copy-lob from object buf_clob-data.cdata
     6347             to file f-name.
     6348             run gbl/filename.p
     6349               (input  v-file-name
     6350               ,output f-name
     6351               ,output v-path
     6352               ,output v-file-name
     6353               ,output v-file-name-no-ext
     6354               ,output v-file-name-ext
     6355               ) no-error .
     6356             if error-status:error then do:
     6357             end.
     6358           end.
     6359         end case.
     6360         for each macro-list-hist:
     6361           delete macro-list-hist.
     6362         end.
     6363         input stream sout from value (f-name).
     6364         _macro:
     6365         repeat:
     6366           create macro-list-hist.
     6367           import stream sout macro-list-hist no-error.
     6368           if error-status:error then do:
     6369               undo _macro, next _macro.
     6370           end.
     6371           assign
     6372           macro-list-hist.num-rec = 0
     6373           macro-list-hist.num-add = 0
     6374           macro-list-hist.num-ignored = 0
     6375           v-id = (if macro-list-hist.line = 0 then v-id + 1 else v-id)
     6376           macro-list-hist.done = no
     6377           .
     6378         end.
     6379         find first macro-list-hist where
     6380                 macro-list-hist.id = 0.
     6381         delete macro-list-hist.
     6382         input stream sout close.
     6383         If p-option = "lob" then do:
     6384          os-delete value(f-name).
     6385         end.
     6386         v-file = yes.
     6387       end.
     6388       an-listp-macros-label-id = v-seq.
     6389       run create-scnblist-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     6390                                           , input-output v-seq
     6391                                           , input 0
     6392                                           , input '>':U
     6393                                           , input (if v-file
     6394                                                   then substitute("Файл макроса : &1", f-name)
     6395                                                   else substitute("Записанный макрос")
     6396                                                   )
     6397                                           , input tot-lns
     6398                                           , input 'macro':U
     6399                                           , input '':U
     6400                                           , input (if v-file then f-name else '':U)
     6401                                           , input '':U
     6402                                           , input ?
     6403                                           ).
     6404     end.
     6405     disable
     6406     b-record
     6407     b-macro
     6408     with frame Dialog-Frame .
     6409     hide
     6410     b-record in frame Dialog-Frame .
     6411     enable
     6412     b-clear-macro with frame Dialog-Frame .
     6413     v-macro-is-running = yes.
     6414     run str/listmcro.w (input parparentproc
     6415                   ,input this-procedure:handle
     6416                  ,input "Макрос формирования списка кодов" + chr(4) + "bbm"
     6417                   ,input "b-play,b-step"
     6418                   ,input-output v-current-step
     6419                   ,input v-id
     6420                   ,output v-result) no-error .
     6421     if error-status:error
     6422     or v-result = "b-stop"
     6423     or v-result = 'end':U
     6424     then do:
     6425       for each macro-list-hist:
     6426         delete macro-list-hist.
     6427       end.
     6428       assign
     6429       an-listp-start-macro-id = ?
     6430       an-listp-end-macro-id = ?
     6431       an-listp-macros-label-id = 0
     6432       .
     6433       if v-result = 'b-stop' then do:
     6434         assign
     6435         v-hist-mode = '[]':U
     6436         v-des = "Выполнение макроса прекращено пользователем"
     6437         .
     6438         hide
     6439         b-clear-macro
     6440         b-stop
     6441         in frame Dialog-Frame .
     6442         enable
     6443         b-record
     6444         with frame Dialog-Frame .
     6445       end.
     6446       if v-result = 'end' then do:
     6447         assign
     6448         v-hist-mode = '<':U
     6449         v-des = "Выполнение макроса завершено"
     6450         .
     6451         hide
     6452         b-clear-macro
     6453         b-stop
     6454         in frame Dialog-Frame .
     6455         enable
     6456         b-record
     6457         with frame Dialog-Frame .
     6458       end.
     6459       if error-status:error then do:
     6460         assign
     6461         v-hist-mode = 'E':U
     6462         v-des = "Выполнение макроса прекращено из-за ошибки"
     6463         .
     6464       end.
     6465       run create-scnblist-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     6466                                           , input-output v-seq
     6467                                           , input 0
     6468                                           , input v-hist-mode
     6469                                           , input v-des
     6470                                           , input tot-lns
     6471                                           , input 'macro':U
     6472                                           , input '':U
     6473                                           , input f-name
     6474                                           , input '':U
     6475                                           , input ?
     6476                                           ) no-error .
     6477       assign
     6478       v-macro-is-running = no
     6479       v-current-step = 0
     6480       .
     6481     end.
     6482     enable
     6483     b-macro
     6484     with frame Dialog-Frame .
     6485   end.
     6486   end procedure.
     6487   procedure proc-create-macro-list-hist :
     6488   define input parameter p-list-table as character no-undo .
     6489   define input parameter p-id as integer           no-undo .
     6490   define input parameter p-line as integer         no-undo .
     6491   define input parameter p-hist-mode as character  no-undo .
     6492   define input parameter p-des as character        no-undo .
     6493   define input parameter p-option_ as character    no-undo .
     6494   define input parameter p-item_ as character      no-undo .
     6495   define input parameter p-status_ as character    no-undo .
     6496   define buffer buf_macro-list-hist for macro-list-hist.
     6497   define buffer buf_keep-macro-list-hist for keep-macro-list-hist.
     6498     do
     6499     on error undo, return error return-value
     6500     :
     6501       create buf_macro-list-hist.
     6502       assign
     6503       buf_macro-list-hist.list-table = p-list-table
     6504       buf_macro-list-hist.id         = p-id
     6505       buf_macro-list-hist.line       = p-line
     6506       buf_macro-list-hist.hist-mode  = p-hist-mode
     6507       buf_macro-list-hist.des        = p-des
     6508       buf_macro-list-hist.option_    = p-option_
     6509       buf_macro-list-hist.item_      = p-item_
     6510       buf_macro-list-hist.status_    = p-status_
     6511       .
     6512       if p-keep-query then do:
     6513         create buf_keep-macro-list-hist.
     6514         buffer-copy buf_macro-list-hist to buf_keep-macro-list-hist.
     6515       end.
     6516     end.
     6517   end procedure.
     6518   procedure proc-macro-play :
     6519   define input parameter p-id as integer no-undo .
     6520   define input parameter p-step as logical no-undo .
     6521   define input parameter p-max-id as integer no-undo .
     6522   define variable v-id as integer no-undo .
     6523   define variable v-rowid   as rowid no-undo .
     6524   define variable v-tbl-name as character no-undo .
     6525   define variable v-old-seq as integer no-undo .
     6526   define variable v-current-id as integer no-undo .
     6527   define variable v-temp-seq as integer no-undo .
     6528   define variable v-rs-do-error as logical no-undo .
     6529   define  buffer buf_macro-list-hist for macro-list-hist.
     6530   define  buffer buf_scnblist-hist for scnblist-hist.
     6531   do
     6532   on error undo, return error return-value
     6533   :
     6534     for each macro-list-hist where (p-id = 0 or macro-list-hist.id = p-id):
     6535       assign
     6536       v-current-id = v-current-id + 1
     6537       v-id = macro-list-hist.id.
     6538       CASE entry(1, macro-list-hist.option_, chr(4)):
     6539         when 'macro':U
     6540         or
     6541         when 'title':U
     6542         or
     6543         when 'start':U
     6544         then do:
     6545         end.
     6546         when 'clear':U then do:
     6547           for each scnblist:
     6548             delete scnblist.
     6549           end.
     6550           for each scnblist-hist where scnblist-hist.id > an-listp-macros-label-id:
     6551             delete scnblist-hist.
     6552           end.
     6553           tot-lns = 0.
     6554           v-seq = an-listp-macros-label-id + 1.
     6555           v-no-hist = 0.
     6556           create buf_scnblist-hist.
     6557           buffer-copy macro-list-hist
     6558           to buf_scnblist-hist
     6559           assign buf_scnblist-hist.id = v-seq
     6560           v-temp-seq = v-seq
     6561           v-seq = v-seq + 1
     6562           v-no-hist = v-no-hist + 1
     6563           .
     6564           run ui-on in this-procedure .
     6565         end.
     6566         when 'single' then do:
     6567            run gen-row-keyr  in this-procedure (  input  macro-list-hist.item_
     6568                                                 ,input ?
     6569                                                 ,input 'ub'
     6570                                                 ,input ?
     6571                                                 ,input no-lock
     6572                                                 ,output v-rowid
     6573                                                 ,output v-tbl-name) no-error .
     6574           if not error-status:error then do:
     6575             CASE macro-list-hist.hist-mode:
     6576               when '+':U then do:
     6577                 run proc-b-add in this-procedure(input yes
     6578                                                 ,input v-rowid
     6579                                                 ,input macro-list-hist.option_
     6580                                                 ,input macro-list-hist.status_) no-error .
     6581               end.
     6582               when '-':U then do:
     6583                 run proc-b-del in this-procedure(input yes
     6584                                                 ,input v-rowid
     6585                                                 ,input macro-list-hist.option_
     6586                                                 ,input macro-list-hist.status_) no-error .
     6587               end.
     6588               when '*':U then do:
     6589                 run proc-b-rest in this-procedure(input yes
     6590                                                  ,input v-rowid
     6591                                                  ,input macro-list-hist.option_
     6592                                                  ,input macro-list-hist.status_) no-error .
     6593               end.
     6594             END.
     6595             if error-status:error then do:
     6596                 return ("error" + chr(4) + return-value) .
     6597             end.
     6598             find first  buf_scnblist-hist where
     6599                     buf_scnblist-hist.id = v-seq - 1 no-error .
     6600             if available buf_scnblist-hist then
     6601             assign
     6602             macro-list-hist.num-recs = buf_scnblist-hist.num-recs
     6603             macro-list-hist.num-add = buf_scnblist-hist.num-add
     6604             macro-list-hist.num-ignored = buf_scnblist-hist.num-ignored
     6605             .
     6606           end.
     6607           else do:
     6608             return ("error" + chr(4) + return-value).
     6609           end.
     6610         end.
     6611         otherwise do:
     6612           if can-find(first temp-list where temp-list.fvalue = macro-list-hist.option_)
     6613           or lookup(macro-list-hist.option_, 'optimize':U) > 0
     6614           then do:
     6615             if macro-list-hist.line = 0 then do:
     6616               v-no-hist = 0.
     6617               for each buf_macro-list-hist where
     6618                       buf_macro-list-hist.id = v-id:
     6619                 create buf_scnblist-hist.
     6620                 buffer-copy buf_macro-list-hist
     6621                 except id  num-recs num-add num-ignored done
     6622                 to buf_scnblist-hist
     6623                 assign
     6624                 buf_scnblist-hist.id = (if buf_macro-list-hist.line =0 then v-seq else v-temp-seq)
     6625                 v-temp-seq = (if buf_macro-list-hist.line = 0 then v-seq else v-temp-seq )
     6626                 v-seq = (if buf_macro-list-hist.line = 0
     6627                         then (v-seq + 1)
     6628                         else v-seq)
     6629                 v-no-hist = v-no-hist + 1
     6630                 .
     6631               end.
     6632               if v-no-hist = 1 then v-no-hist = 0.
     6633               run rs-do in this-procedure (input yes
     6634                                         , input p-step
     6635                                         , input macro-list-hist.option_
     6636                                         , input macro-list-hist.status_
     6637                                         , input get-line-mode(macro-list-hist.hist-mode)
     6638                                         , input v-temp-seq
     6639                                         ) no-error .
     6640               if error-status:error then do:
     6641                 assign
     6642                 v-rs-do-error = yes.
     6643               end.
     6644               if get-line-mode(macro-list-hist.hist-mode) = 'ОСТАВИТЬ':U then do:
     6645                 run proc-b-rest-2 in this-procedure .
     6646                 run ui-on in this-procedure .
     6647               end.
     6648               for each buf_scnblist-hist where
     6649                       buf_scnblist-hist.id = v-temp-seq,
     6650                  first buf_macro-list-hist where
     6651                       buf_macro-list-hist.id = v-id
     6652                   AND buf_macro-list-hist.line = buf_scnblist-hist.line:
     6653                  assign
     6654                  buf_macro-list-hist.num-recs = buf_scnblist-hist.num-recs
     6655                  buf_macro-list-hist.num-add = buf_scnblist-hist.num-add
     6656                  buf_macro-list-hist.num-ignored = buf_scnblist-hist.num-ignored
     6657                  .
     6658               end.
     6659               if v-rs-do-error then do:
     6660                 run ui-on in this-procedure .
     6661                 return ("error" + chr(4) + return-value).
     6662               end.
     6663               v-id = macro-list-hist.id.
     6664             end.
     6665           end.
     6666         end.
     6667       END CASE.
     6668     end.
     6669   end.
     6670   end procedure.
     6671   procedure proc-b-rest-2 :
     6672     do
     6673     on error undo, return error
     6674     :
     6675       for each scnblist:
     6676         if scnblist.to-del = ? then do:
     6677           assign
     6678           scnblist.to-del = no
     6679           .
     6680         end.
     6681         else do:
     6682           delete scnblist.
     6683         end.
     6684       end.
     6685       tot-lns = lns-cnt.
     6686     end.
     6687   end procedure.
     6688   PROCEDURE proc-expand :
     6689   define input parameter p-shift as integer no-undo .
     6690   define input parameter p-from as integer no-undo .
     6691   define input parameter p-to as integer no-undo .
     6692   define input parameter p-forcer-name as character no-undo .
     6693   define variable fh as widget-handle no-undo .
     6694   define variable hh as widget-handle no-undo .
     6695   define variable lh as widget-handle no-undo .
     6696   define variable ii as INTEGER no-undo .
     6697   ASSIGN
     6698   fh = frame Dialog-Frame:first-child
     6699   hh = fh:first-child
     6700   .
     6701   CASE v-expand:
     6702     WHEN YES THEN DO:
     6703       ASSIGN
     6704       v-expand = NO.
     6705       DO ii = 1 TO NUM-ENTRIES(v-downed):
     6706         ASSIGN
     6707         hh              = WIDGET-HANDLE(ENTRY(ii, v-downed))
     6708         hh:ROW          = (hh:ROW - p-shift).
     6709         hh:height-chars = (if hh:type = "browse" then (hh:height-chars + p-shift) else hh:height-chars).
     6710       END.
     6711     END.
     6712     WHEN NO THEN DO:
     6713       v-expand = YES.
     6714       v-downed = ''.
     6715       _do:
     6716       do while valid-handle(hh):
     6717         IF lookup(hh:type, "radio-set,browse,button,fill-in,literal,text,rectangle") > 0
     6718          AND hh:ROW >= p-from
     6719          AND hh:ROW <= p-to
     6720          and lookup(hh:name, p-forcer-name) = 0
     6721          THEN DO:
     6722           hh:height-chars = (if hh:type = "browse" then (hh:height-chars - p-shift) else hh:height-chars).
     6723           hh:ROW          = (hh:ROW + p-shift).
     6724           ASSIGN
     6725           v-downed = v-downed + chr(44) + STRING(hh).
     6726           IF hh:TYPE = "fill-in"
     6727           AND valid-handle(hh:side-label-handle) THEN dO:
     6728             assign
     6729             lh = hh:SIDE-LABEL-HANDLE
     6730             lh:ROW = lh:ROW + p-shift
     6731             v-downed = v-downed + chr(44) + STRING(lh)
     6732             .
     6733            END.
     6734          END.
     6735          hh = hh:next-sibling.
     6736       END.
     6737       v-downed = trim(v-downed, chr(44)).
     6738     END.
     6739   END CASE.
     6740   END PROCEDURE.
     6741   define variable v-ok as logical   no-undo .
     6742   assign
     6743     v-ok = br-list :set-repositioned-row(5, 'conditional':u)
     6744   .
     6745   ON WINDOW-CLOSE OF FRAME Dialog-Frame APPLY "END-ERROR":U TO SELF.
