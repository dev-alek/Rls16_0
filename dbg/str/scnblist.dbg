     1749   procedure userobjs_clear :
     1750     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1751     do
     1752     on error undo, return error return-value
     1753     :
     1754       for each buf_userobjs_temp-user-obj
     1755       on error undo, return error return-value
     1756       :
     1757         delete buf_userobjs_temp-user-obj .
     1758       end.
     1759     end.
     1760   end .
     1761   procedure userobjs_object-count :
     1762     define output parameter p-total-count as integer   no-undo .
     1763     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1764     do
     1765     on error undo, return error return-value
     1766     :
     1767       assign
     1768         p-total-count = 0
     1769       .
     1770       for each buf_userobjs_temp-user-obj
     1771       on error undo, return error return-value
     1772       :
     1773         assign
     1774           p-total-count = p-total-count + 1
     1775         .
     1776       end.
     1777     end.
     1778   end.
     1779   procedure userobjs_append :
     1780      define input  parameter p-obj-type as character no-undo .
     1781      define input  parameter p-obj-code as integer   no-undo .
     1782     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1783     do
     1784     on error undo, return error return-value
     1785     :
     1786       find first buf_userobjs_temp-user-obj
     1787         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1788           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1789         no-error .
     1790       if not available buf_userobjs_temp-user-obj
     1791       then do:
     1792         create buf_userobjs_temp-user-obj .
     1793         assign
     1794           buf_userobjs_temp-user-obj.obj-type = p-obj-type
     1795           buf_userobjs_temp-user-obj.obj-code = p-obj-code
     1796         .
     1797       end.
     1798     end.
     1799   end.
     1800   procedure userobjs_object-exist :
     1801     define output parameter p-object-exist as logical   no-undo .
     1802     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1803     do
     1804     on error undo, return error return-value
     1805     :
     1806       find first buf_userobjs_temp-user-obj
     1807         no-error .
     1808       if not available buf_userobjs_temp-user-obj
     1809       then do:
     1810         assign
     1811           p-object-exist = false
     1812         .
     1813       end.
     1814       else do:
     1815         assign
     1816           p-object-exist = true
     1817         .
     1818       end.
     1819     end.
     1820   end.
     1821   procedure userobjs_transfer :
     1822     define input  parameter p-callback-handle as handle no-undo .
     1823     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
     1824     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     1825     do
     1826     on error undo, return error return-value
     1827     :
     1828       if valid-handle(p-callback-handle) <> true
     1829       then do:
     1830         message
     1831           vss-workfile vss-revision vss-description skip
     1832           "Ошибка задания входных параметров" skip
     1833           "Неизвестный указатель на процедуру" skip
     1834           view-as alert-box error .
     1835         undo, return error return-value .
     1836       end.
     1837       if p-callback-handle :get-signature("userobjs_append") = ""
     1838       then do:
     1839         message
     1840           vss-workfile vss-revision vss-description skip
     1841           "Ошибка задания входных параметров" skip
     1842           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
     1843                     ,p-callback-handle :file-name
     1844                     ) skip
     1845           view-as alert-box error .
     1846         undo, return error return-value .
     1847       end.
     1848       for each buf_userobjs_temp-user-obj
     1849       on error undo, return error return-value
     1850       :
     1851         run userobjs_append in p-callback-handle
     1852           (input  buf_userobjs_temp-user-obj.obj-type
     1853           ,input  buf_userobjs_temp-user-obj.obj-code
     1854           ) .
     1855       end.
     1856     end.
     1857   end procedure.
