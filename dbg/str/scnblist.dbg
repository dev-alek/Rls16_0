     3876   ON CHOOSE OF MENU-ITEM m-cd  DO:
     3877   define variable vss-include-info39 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3878   if lookup(b-save :type in frame Dialog-Frame
     3879            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3880            ) = 0
     3881   then do:
     3882     message
     3883       "$Workfile$"
     3884       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3885       "Интерфейсный элемент" self :name in frame Dialog-Frame skip
     3886       "Тип" self :type in frame Dialog-Frame skip
     3887       "Процедура" this-procedure :file-name skip
     3888       view-as alert-box .
     3889   end.
     3890   else do:
     3891     apply "entry":u to b-save in frame Dialog-Frame .
     3892     if focus :handle <> b-save :handle in frame Dialog-Frame then do:
     3893       return no-apply .
     3894     end.
     3895   end.
     3896   run proc-cd in this-procedure no-error.
     3897   end.
     3898   ON CHOOSE OF MENU-ITEM m-title-save  DO:
     3899   define variable v-value as character no-undo .
     3900     run gbl/d-prompt.w (
     3901         'title=':u + "Введите ИМЯ СПИСКА КОДОВ" + '\':u
     3902       + 'format=' + "X(60)" + '\':u
     3903       + 'type=' + 'C':U + '\':u
     3904       + 'fillin_row=2\':u
     3905       + 'fillin_col=4\':u
     3906       + 'fillin_width=60\':u
     3907       + 'fillin_height=1\':u
     3908       + 'max-chars=60\':u
     3909       + 'readonly=no\':u
     3910       , input-output v-value
     3911       ).
     3912   if return-value = 'false':u then return NO-apply.
     3913   run create-scnblist-hist in this-procedure (input 'title'
     3914                                        , input-output v-seq
     3915                                        , input 0
     3916                                        , input 'N':U
     3917                                        , input v-value
