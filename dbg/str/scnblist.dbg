     2299   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2300   PROCEDURE term-prt.
     2301   define input parameter rs-list-method as character no-undo .
     2302   define input parameter rs-status as character no-undo .
     2303   define input parameter line-mode as character no-undo .
     2304   define input parameter c-root like ub.gds-prt.prt-root no-undo.
     2305   define input parameter c-node like ub.gds-prt.node-code no-undo.
     2306   define buffer b-g-p for ub.gds-prt.
     2307   define buffer pr-bc for ub.bar-code .
     2308   define buffer b-bc for ub.bar-code .
     2309   define buffer p-bar-code for ub.bar-code .
     2310   define buffer b-units for ub.units.
     2311   define variable pusto as char init "" no-undo.
     2312   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2313   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2314     (input  ub.goods.gds-code
     2315     ,input  ?
     2316     ,output main-b-code
     2317     ) no-error .
     2318     if LOOKUP('топ':U, ub.units.type) > 0 and
     2319         LOOKUP('дро':U, ub.units.type) > 0 AND
     2320         ub.goods.gds-type = 'т':U
     2321     then do:
     2322           petrol-trk = yes.
     2323     end.
     2324     else petrol-trk = no.
     2325     _b-g-p:
     2326      FOR EACH ub.bar-code NO-LOCK where
     2327               ub.bar-code.gds-code = ub.goods.gds-code,
     2328         FIRST b-g-p NO-LOCK WHERE
     2329               b-g-p.node-code = ub.bar-code.node-code
     2330          AND  b-g-p.prt-root = c-root
     2331          AND  b-g-p.is-term = yes
     2332        :
     2333        if ub.bar-code.part-code <> ""
     2334        OR ub.bar-code.in-code <> ""
     2335        OR ub.bar-code.unit-cli <> ub.goods.unit-base then NEXT _b-g-p.
     2336   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2337   FIND FIRST ub.prt-obj WHERE
     2338           ub.prt-obj.obj-type = p-curr-obj-type AND
     2339           ub.prt-obj.obj-code = p-curr-obj-code AND
     2340           ub.prt-obj.prod-type = ub.goods.prod-type AND
     2341           ub.prt-obj.prod-code = ub.goods.prod-code AND
     2342           ub.prt-obj.artic = ub.goods.artic AND
     2343           ub.prt-obj.prt-code = b-g-p.node-code NO-LOCK NO-ERROR .
     2344   if v-is-restaurant and v-is-null-price then.
     2345   else do:
     2346   if (NOT temp-shop.all-prt )
     2347       AND  ub.goods.gds-type = 'т':U
     2348       AND  NOT l-empty-scale then do:
     2349     if not available ub.prt-obj then do:
     2350       if temp-shop.sub-store-on then do:
     2351         if NOT can-find( first ub.gds-dtl where
     2352                             ub.gds-dtl.artic = ub.goods.artic AND
     2353                             ub.gds-dtl.prod-type = ub.goods.prod-type AND
     2354                             ub.gds-dtl.prod-code = ub.goods.prod-code AND
     2355                             ub.gds-dtl.prt-code = b-g-p.node-code AND
     2356                             ub.gds-dtl.obj-type =  temp-shop.sub-store-type AND
     2357                             ub.gds-dtl.obj-code = temp-shop.sub-store-code) then
     2358                     NEXT _b-g-p.
     2359       end.
     2360       else do:
     2361                     NEXT _b-g-p.
     2362       end.
     2363     end.
     2364   end.
     2365   end.
     2366   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2367     if ((LOOKUP('сер':U, ub.units.type) = 0  and not cashparts) OR
     2368         (LOOKUP('сер':U, ub.units.type) > 0 and NOT temp-shop.cd-parts-ser)
     2369        )
     2370       then do:
     2371   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2372   FIND FIRST b-units No-LOCK WHERE
     2373              b-units.unit-name = ub.bar-code.unit-cli No-ERROR.
     2374   if (temp-shop.cd-bc-base or temp-shop.cd-loc-base) and (NOT petrol-trk
     2375   or v-notcd
     2376   )
     2377   then do:
     2378         run asc-gds in this-procedure (
     2379         input rs-list-method,
     2380         input rs-status,
     2381         input line-mode,
     2382         buffer ub.goods,
     2383         buffer ub.bar-code,
     2384         buffer ub.gds-prt,
     2385         buffer ub.gds-obj,
     2386         buffer ub.price-list,
     2387         buffer ub.units,
     2388         buffer b-g-p,
     2389         input ?,
     2390         input '',
     2391         input (if avail b-units then b-units.type else ub.units.type),
     2392         input (if avail b-units then b-units.okei else ub.units.okei),
     2393         input ub.sysconf.host-code,
     2394         input p-curr-obj-type,
     2395         input p-curr-obj-code
     2396         )  no-error .
     2397        if error-status:error then return error.
     2398   end.
     2399   if temp-shop.cd-pb-base or temp-shop.cd-pb-alt or temp-shop.cd-sc-base OR petrol-trk then do:
     2400     FOR EACH ub.prod-bc NO-LOCK WHERE
     2401              ub.prod-bc.b-code = ub.bar-code.b-code
     2402                 :
     2403         if  ub.prod-bc.b-str = string( ub.bar-code.b-code )
     2404             AND
     2405             (
     2406             (ub.goods.unit-base = ub.bar-code.unit-cli AND temp-shop.cd-loc-base) OR
     2407             (NOT ub.goods.unit-base = ub.bar-code.unit-cli AND temp-shop.cd-loc-alt)
     2408             ) AND
     2409             (NOT petrol-trk
     2410             or v-notcd
     2411             )
     2412             then NEXT.
     2413       if temp-shop.cd-sc-base AND
     2414       (LOOKUP('вес':U, ub.units.type) > 0
     2415       or
     2416       LOOKUP('топ':U, ub.units.type) > 0
     2417       or
     2418       ub.prod-bc.bc-on-type = 'pglc':U
     2419       )
     2420       and
     2421       ub.bar-code.unit-cli = ub.goods.unit-base then do:
     2422         if not ub.prod-bc.bc-on-type = 'pglc':U then do:
     2423   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2424   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     2425     (buffer ub.prod-bc
     2426     ,input  (if LOOKUP('вес':U, ub.units.type) > 0 then 'weight=request':U  else 'petrolium=request':U )
     2427     ,output g#log
     2428     ) no-error .
     2429           if error-status:error or not g#log then NEXT.
     2430         end.
     2431         run asc-gds in this-procedure (
     2432           input rs-list-method,
     2433           input rs-status,
     2434           input line-mode,
     2435           buffer ub.goods,
     2436           buffer ub.bar-code,
     2437           buffer ub.gds-prt,
     2438           buffer ub.gds-obj,
     2439           buffer ub.price-list,
     2440           buffer ub.units,
     2441           buffer b-g-p,
     2442           input ub.prod-bc.b-str,
     2443           input ub.prod-bc.bc-on-type,
     2444           input (if avail b-units then b-units.type else ub.units.type),
     2445           input (if avail b-units then b-units.okei else ub.units.okei),
     2446           input ub.sysconf.host-code,
     2447           input p-curr-obj-type,
     2448           input p-curr-obj-code
     2449           ) no-error.
     2450         if error-status:error then return error.
     2451         NEXT.
     2452       end.
     2453       if ((temp-shop.cd-pb-base AND ub.bar-code.unit-cli = ub.goods.unit-base
     2454       AND LOOKUP('вес':U, units.type) = 0
     2455       and ub.prod-bc.bc-on-type <> 'pglc':U
     2456       ) OR
     2457           (temp-shop.cd-pb-alt AND ub.bar-code.unit-cli <> ub.goods.unit-base)) then do:
     2458         run asc-gds in this-procedure (
     2459           input rs-list-method,
     2460           input rs-status,
     2461           input line-mode,
     2462           buffer ub.goods,
     2463           buffer ub.bar-code,
     2464           buffer ub.gds-prt,
     2465           buffer ub.gds-obj,
     2466           buffer ub.price-list,
     2467           buffer ub.units,
     2468           buffer b-g-p,
     2469           input ub.prod-bc.b-str,
     2470           input ub.prod-bc.bc-on-type,
     2471           input (if avail b-units then b-units.type else ub.units.type),
     2472           input (if avail b-units then b-units.okei else ub.units.okei),
     2473           input ub.sysconf.host-code,
     2474           input p-curr-obj-type,
     2475           input p-curr-obj-code
     2476           ) no-error.
     2477        if error-status:error then return error.
     2478       end.
     2479     END.
     2480   end.
     2481   if NOT petrol-trk
     2482   or v-notcd
     2483   then do:
     2484     FOR EACH b-bc WHERE
     2485               b-bc.gds-code = ub.goods.gds-code AND
     2486               b-bc.node-code = ub.bar-code.node-code AND
     2487               b-bc.part-code = pusto AND
