     6788     ) no-error .
     6789   if varpgscales-pref = ? then do:
     6790     assign
     6791     varpgscales-pref = '24IIIIIQQ000C,28IIIIIQQQ00C':U.
     6792   end.
     6793   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     6794     (input  'is-tsd'
     6795     ,input  0
     6796     ,input  '':U
     6797     ,input  0
     6798     ,input  ''
     6799     ,input  ''
     6800     ,input  ''
     6801     ,input  no
     6802     ,output conf-par
     6803     ,output par-type
     6804     ) no-error .
     6805     assign
     6806     is-tsd = (if conf-par = "yes" then yes else no)
     6807     .
     6808   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6809     run mainmenu_getcntxt in parparentproc
     6810       (output v-cntxt-db-num
     6811       ,output v-cntxt-userid
     6812       ,output v-cntxt-level
     6813       ,output v-cntxt-host-code-obj
     6814       ,output v-cntxt-obj-type
     6815       ,output v-cntxt-obj-code
     6816       ,output v-cntxt-db-num-obj
     6817       ,output v-cntxt-is-admin
     6818       ) .
     6819     if p-curr-obj-type = '':U
     6820     and p-curr-obj-code = 0 then do:
     6821   define variable vss-include-info60 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6822   run userobjs_select-one in this-procedure
     6823     (input  parparentproc
     6824     ,input  v-cntxt-db-num
     6825     ,input  v-cntxt-userid
     6826     ,input  v-cntxt-host-code-obj
     6827     ,input  v-cntxt-obj-type
     6828     ,input  v-cntxt-obj-code
     6829     ,output v-user-select
     6830     ,output v-sel-obj-type
     6831     ,output v-sel-obj-code
     6832     )  .
     6833       if v-user-select then do: ~
     6834         FIND FIRST buf_user-obj no-lock where
     6835                 buf_user-obj.obj-type = v-sel-obj-type
     6836             and buf_user-obj.obj-code = v-sel-obj-code  No-ERROR.
     6837         if not avail buf_user-obj then return no-apply.
     6838         find first buf_clients no-lock where
     6839                   buf_clients.obj-type = buf_user-obj.obj-type
     6840               and buf_clients.obj-code = buf_user-obj.obj-code no-error.
     6841         if not available buf_clients then return error.
     6842         assign
     6843         p-curr-obj-type = buf_clients.obj-type
     6844         p-curr-obj-code = buf_clients.obj-code
     6845         v-host-code = buf_clients.host-code
     6846         v-no-obj = yes
     6847         .
     6848       end.
     6849       else do:
     6850         message
     6851         "Текущий объект не может быть установлен" skip
     6852         view-as alert-box error .
     6853         undo, return error.
     6854       end.
     6855     end.
     6856     if not (p-curr-obj-type = '':U
     6857             and
     6858             p-curr-obj-code = 0) then do:
     6859       find first buf_clients no-lock
     6860           where buf_clients.obj-type = p-curr-obj-type
     6861           AND    buf_clients.obj-code = p-curr-obj-code no-error.
     6862       if not available buf_clients
     6863       or not (buf_clients.obj-type = 'маг':U
     6864         or
     6865         buf_clients.obj-type = 'скл':U
     6866         )
     6867       then do:
     6868         assign
     6869         p-curr-obj-type = '':U
     6870         p-curr-obj-code = 0
     6871         .
     6872         message
     6873         vss-workfile vss-revision vss-description skip
     6874         "Неверно заданы входные параметры p-curr-obj-type и/или p-curr-obj-code"
     6875         p-curr-obj-type p-curr-obj-code
     6876         view-as alert-box error .
     6877         undo main-block, return error.
     6878       end.
     6879     end.
     6880     assign
     6881     line-rec = ?
     6882     .
     6883     assign
     6884     br-option:column-scrolling in frame Dialog-Frame  = no
     6885     RS-status:radio-buttons = "Текущие&+" + chr(44) + 'текущие':U + chr(44) +
     6886                               "Все!" + chr(44) + 'все':U + chr(44) +
     6887                               "Неактивные-" + chr(44) + 'удаленные':U
     6888     RS-status = 'текущие':U
     6889     .
     6890     if v-no-obj
     6891     or v-cntxt-level <>  'object':U then do:
     6892       if v-obj-name = "":U then do:
     6893         run proc-b-obj in this-procedure ( input "":U ).
     6894       end.
     6895       display
     6896         b-obj
     6897         v-obj-type
     6898         v-obj-code
     6899         v-obj-name
     6900       with frame Dialog-Frame .
     6901       enable
     6902         b-obj
     6903       with frame Dialog-Frame .
     6904     end.
     6905     else do:
     6906       assign
     6907       v-obj-type  = p-curr-obj-type
     6908       v-obj-code  = p-curr-obj-code
     6909       .
     6910       if v-obj-type = 'маг':U then do:
     6911         find first ub.shop no-lock where
     6912                   ub.shop.obj-code = v-obj-code.
     6913         find first sysconf no-lock where
     6914                   sysconf.host-code = shop.host-code .
     6915         assign
     6916         v-is-restaurant = ub.shop.is-catering
     6917         v-doc-prt = ub.shop.doc-prt.
     6918         .
     6919       end.
     6920       else do:
     6921         find first ub.store no-lock where
     6922                   ub.store.obj-code = p-curr-obj-code.
     6923         find first sysconf no-lock where
     6924                   sysconf.host-code = store.host-code .
     6925         v-doc-prt = ub.store.doc-prt.
     6926       end.
     6927       run proc-fill-temp-list in this-procedure .
     6928       for each temp-shop:
     6929         delete temp-shop.
     6930       end.
     6931       create temp-shop.
     6932       run proc-b-cd in this-procedure  ( input yes).
     6933     end.
     6934     run UI-on.
     6935     WAIT-FOR GO OF FRAME Dialog-Frame focus br-list.
     6936   END.
     6937   HIDE FRAME Dialog-Frame.
     6938   PROCEDURE UI-on:
     6939   define variable v-recid0 as recid no-undo.
     6940   define variable v-start as logical no-undo .
     6941   define buffer buf_temp-list for temp-list.
     6942   define buffer buf_scnblist-hist for scnblist-hist.
     6943   scnblist.part-code:resizable in browse br-list = yes.
     6944   scnblist.in-code:resizable in browse br-list = yes.
     6945   if v-cntxt-level <> 'object':U
     6946   or v-cntxt-obj-type <> 'маг':U then do:
     6947     assign
     6948     MENU-ITEM m-cd:sensitive in menu m-save = no.
     6949   end.
     6950     find first buf_scnblist-hist where buf_scnblist-hist.id = 0 no-error.
     6951     if available buf_scnblist-hist then
     6952     assign
     6953     frame Dialog-Frame:title = substitute("СПИСОК  КОДОВ &1",  string(buf_scnblist-hist.des, "X(60)"))
     6954     .
     6955     if tot-lns = ? then do:
     6956       v-start = yes.
     6957       for each l-scnblist :
     6958         accumulate l-scnblist.artic (count).
     6959       end.
     6960       tot-lns = (accum count l-scnblist.artic).
     6961       if tot-lns > 0 then do:
     6962         find last  buf_scnblist-hist no-error .
     6963         if available buf_scnblist-hist and buf_scnblist-hist.id = 1 and v-start then delete buf_scnblist-hist.
     6964         v-seq = (if available buf_scnblist-hist then buf_scnblist-hist.id else 0)  + 1.
     6965         run create-scnblist-hist in this-procedure (input 'ДОБАВЛЕНИЕ':U
     6966                                              , input-output v-seq
     6967                                              , input 0
     6968                                              , input 'S':U
     6969                                              , input substitute("# Исходный список: &1 строк", tot-lns)
     6970                                              , input tot-lns
     6971                                              , input "start":U
     6972                                              , input '':U
     6973                                              , input '':U
     6974                                              , input '':U
     6975                                              , input ?
     6976                                              ).
     6977       end.
     6978       else do:
     6979         line-mode = 'ДОБАВЛЕНИЕ':U.
     6980         for each buf_scnblist-hist:
     6981           delete buf_scnblist-hist.
     6982         end.
     6983         v-seq = 1.
     6984         run create-scnblist-hist in this-procedure (input 'ДОБАВЛЕНИЕ':U
     6985                                              , input-output v-seq
     6986                                              , input 0
     6987                                              , input '':U
     6988                                              , input "# Исходный список кодов пуст."
     6989                                              , input tot-lns
     6990                                              , input 'start':U
     6991                                              , input '':U
     6992                                              , input '':U
     6993                                              , input '':U
     6994                                              , input ?
     6995                                              ).
     6996       end.
     6997     end.
     6998     hide loc-art in frame Dialog-Frame loc-name loc-code loc-b-str in frame Dialog-Frame.
     6999     assign
     7000       loc-art = ""
     7001       RS-list-method = "single"
     7002       dsp-rs = "Всего строк в списке кодов : " + string (tot-lns).
     7003     find first buf_temp-list no-lock where
     7004                buf_temp-list.fvalue = rs-list-method.
     7005     assign
     7006     v-recid0 = recid(buf_temp-list).
     7007     open query br-option for each temp-list no-lock .
     7008     DISPLAY br-option dsp-rs RS-Status WITH FRAME Dialog-Frame.
     7009     ENABLE
     7010     b-exit b-add b-hist b-help br-option br-list RS-Status b-cd
     7011     T-loc-base
     7012     T-loc-alt
     7013     T-bc-base
     7014     T-bc-alt
     7015     T-all-prt
     7016     T-parts-ser
     7017     T-parts-not-blank
     7018     T-parts-all
     7019     T-pb-base
     7020     T-pb-alt
     7021     T-sc-base
     7022     WITH FRAME Dialog-Frame.
     7023     reposition br-option to recid v-recid0.
     7024     if tot-lns > 0 then
     7025       ENABLE b-print b-rest b-save b-del b-lkp b-clr a-n-c b-optimize WITH FRAME Dialog-Frame.
     7026     else do:
     7027       DISABLE b-print b-rest b-save b-del b-lkp b-clr a-n-c b-optimize WITH FRAME Dialog-Frame.
     7028     end.
     7029     open query br-list for each scnblist no-lock indexed-reposition.
     7030    if v-seq > 1 then
     7031     find last buf_scnblist-hist no-lock where
     7032               buf_scnblist-hist.id = (v-seq - 1)
     7033          and  buf_scnblist-hist.line = 0 no-error .
     7034     DISPLAY br-option
     7035     (if available buf_scnblist-hist
     7036     then buf_scnblist-hist.des
     7037     else '') @ dsp-rs
     7038     RS-Status WITH FRAME Dialog-Frame.
     7039     ENABLE
     7040     b-macro  when v-start
     7041     b-record when v-start
     7042     b-exit b-add b-hist b-help br-option br-list RS-Status WITH FRAME Dialog-Frame.
     7043     if v-start then do:
     7044       hide
     7045       b-stop
     7046       b-clear-macro
     7047       in frame Dialog-Frame.
     7048     end.
     7049     v-start = no.
     7050     if line-rec <> ? then
     7051       reposition br-list to recid line-rec no-error.
     7052     if available scnblist then do:     find ub.clients where ub.clients.obj-type = scnblist.prod-type                    and ub.clients.obj-code = scnblist.prod-code no-lock.     find ub.gds-prt where ub.gds-prt.upper-code = scnblist.prt-root no-lock.     find ub.bar-code where ub.bar-code.gds-code  = scnblist.gds-code                     and ub.bar-code.node-code = ub.gds-prt.node-code                     and ub.bar-code.unit-cli  = scnblist.unit-base                     and ub.bar-code.in-code   = ""                     and ub.bar-code.part-code = "" no-lock.     disp ub.clients.obj-name ub.gds-prt.node-name ub.bar-code.b-code tot-lns @ f-tot-lns with frame Dialog-Frame.   end.   disp tot-lns @ f-tot-lns with frame Dialog-Frame.
     7053   END PROCEDURE.
     7054   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7055   PROCEDURE ex-bbc :
     7056   define input parameter rs-list-method as character no-undo .
     7057   define input parameter rs-status as character no-undo .
     7058   define input parameter line-mode as character no-undo .
     7059   define input parameter p-empty-scale as logical no-undo .
     7060   define input parameter p-b-str as character no-undo .
     7061   define input parameter p-is-loc-ean as logical no-undo .
     7062   define parameter buffer buf_bar-code for ub.bar-code.
     7063   define parameter buffer buf_prod-bc for ub.prod-bc.
     7064   define variable v-f-name like ub.gds-prt.f-name no-undo .
     7065   define buffer buf_gds-prt for ub.gds-prt.
     7066   if available buf_prod-bc then
     7067   p-b-str = buf_prod-bc.b-str.
     7068   if rs-list-method begins "single":U or
     7069     (ub.goods.stts = 0  and rs-status <> 'удаленные':U) or
     7070     (ub.goods.stts <> 0 and rs-status <> 'текущие':U) then do:
     7071     if line-mode = 'удаление':U or line-mode = 'ОСТАВИТЬ':U then do:
     7072       find first scnblist where scnblist.gds-code  = ub.goods.gds-code
     7073                        and scnblist.b-code    = buf_bar-code.b-code
     7074                        and scnblist.b-str     = p-b-str  no-error.
     7075       if available scnblist then do:
     7076         if line-mode = 'удаление':U then do:
     7077           lns-cnt = lns-cnt + 1.
     7078           delete scnblist.
     7079         end.
     7080         else do:
     7081           if scnblist.to-del = ? then.
     7082           else do:
     7083             lns-cnt = lns-cnt + 1.
     7084             scnblist.to-del = ?.
     7085           end.
     7086         end.
     7087       end.
     7088     end.
     7089     else
     7090       if line-mode = 'ДОБАВЛЕНИЕ':U then do:
     7091         if p-empty-scale then  do:
     7092         end.
     7093         else do:
     7094           find first buf_gds-prt no-lock where
     7095                     buf_gds-prt.node-code = buf_bar-code.node-code no-error.
     7096           if not available buf_gds-prt then v-f-name = "!!!Неизвестный признак шкалы".
     7097           else v-f-name = buf_gds-prt.f-name.
     7098         end.
     7099   define variable vss-include-info62 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7100   find first scnblist
     7101     where scnblist.gds-code = buf_bar-code.gds-code
     7102       and scnblist.b-code   = buf_bar-code.b-code
     7103       and scnblist.b-str    = p-b-str
     7104     no-error .
     7105   if available scnblist then do:
     7106     assign
     7107       scnblist.to-del = no
     7108     .
     7109   end.
     7110   else do:
     7111     define variable v-last62 as integer no-undo .
     7112     find last scnblist use-index oi no-error.
     7113     if available scnblist then do:
     7114       v-last62 = scnblist.order-num .
     7115     end.
     7116     else do:
     7117       v-last62 = 0 .
     7118     end.
     7119     create scnblist .
     7120     buffer-copy ub.goods to scnblist
     7121     assign
     7122       scnblist.to-del = no
     7123       scnblist.order-num = v-last62 + 1
     7124       scnblist.b-code = buf_bar-code.b-code
     7125       scnblist.bc-cli-base-rate = buf_bar-code.cli-base-rate
     7126       scnblist.bc-cr-db-num     = buf_bar-code.cr-db-num
     7127       scnblist.in-code       = buf_bar-code.in-code
     7128       scnblist.node-code     = buf_bar-code.node-code
     7129       scnblist.part-code     = buf_bar-code.part-code
     7130       scnblist.stts_         = buf_bar-code.stts_
     7131       scnblist.bc-unit-cli   = buf_bar-code.unit-cli
     7132       scnblist.b-str         = p-b-str
     7133       scnblist.f-name        = v-f-name
     7134       scnblist.loc-ean       = p-is-loc-ean
     7135       .
     7136       if available buf_prod-bc
     7137       then
     7138       assign
     7139       scnblist.bc-on-type    = buf_prod-bc.bc-on-type
     7140       scnblist.bc-on         = buf_prod-bc.bc-on
     7141       scnblist.pbc-cr-db-num = buf_prod-bc.cr-db-num
     7142       .
     7143     assign
     7144       lns-cnt = lns-cnt + 1
     7145       line-rec = recid (scnblist)
     7146     .
     7147   end.
     7148       end.
     7149     if lns-cnt modulo 25 = 0 then
     7150     disp "ЖДИТЕ...    Обработано кодов :" + string (lns-cnt) @ dsp-rs with frame Dialog-Frame.
     7151   end.
     7152   else
     7153   assign
     7154   lns-ignore = lns-ignore + 1
     7155   .
     7156   end.
     7157   PROCEDURE rs-do :
     7158   define input parameter p-from-macro as logical no-undo .
     7159   define input parameter p-step as logical no-undo .
     7160   define input parameter rs-list-method as character no-undo .
     7161   define input parameter rs-status as character no-undo .
     7162   define input parameter line-mode as character no-undo .
     7163   define input parameter p-id      as integer no-undo .
     7164   define variable v-rowid   as rowid no-undo .
     7165   define variable v-tbl-name as character no-undo .
     7166   define variable glog as logical no-undo .
     7167   define buffer buf_scnblist-hist for scnblist-hist.
     7168   define variable another-price like ub.price-list.price-sale no-undo.
     7169   define variable scan-qnty as dec no-undo.
     7170   define variable bc-qnty as dec no-undo.
     7171   define variable var-root-code like ub.gds-prt.node-code no-undo .
     7172   define variable varresult   as character         no-undo.
     7173   define variable vartype-bc  as character         no-undo.
     7174   define variable varweight   as decimal           no-undo.
     7175   define variable v-value-integer as integer   no-undo .
     7176   define variable v-db-num as integer no-undo .
     7177   define variable l-prod-bc-weight as logical no-undo .
     7178   define variable l-prod-bc-pgweight as logical no-undo .
     7179   define variable l-prod-bc-glob as logical no-undo .
     7180   define variable v-is-weight as logical no-undo .
     7181   define variable IBM-good-code as character no-undo .
     7182   define variable bar_code as character no-undo .
     7183   define variable v-prev-b-code as integer no-undo .
     7184   define variable v-b-code as integer   no-undo .
     7185   define variable v-from-date as date no-undo .
     7186   define variable v-to-date as date no-undo .
     7187   define variable v-from-date-str as character no-undo .
     7188   define variable v-to-date-str as character no-undo .
     7189   define variable v-using as character no-undo .
     7190   define buffer buf_prod-bc for ub.prod-bc.
     7191   define buffer buf_bar-code for ub.bar-code.
     7192   define buffer buf_cd-plu for ub.cd-plu.
     7193   define buffer buf_parts for ub.parts.
     7194   define buffer buf_gds-obj for ub.gds-obj.
     7195   define buffer buf_parts-obj-attr for ub.parts-obj-attr.
     7196   define buffer buf_code-range for ub.code-range.
     7197   define buffer buf_prod-bc-db for ub.prod-bc-db.
     7198   define buffer buf_gds-obj-attr for ub.gds-obj-attr.
     7199   define buffer buf_scales-gds for ub.scales-gds.
     7200   do
     7201   on error undo, return error return-value
     7202   :
     7203   if p-from-macro then do:
     7204   end.
     7205   else do:
     7206     assign
     7207     frame Dialog-Frame
     7208     T-all-prt
     7209     T-bc-alt
     7210     T-bc-base
     7211     T-loc-alt
     7212     T-loc-base
     7213     T-parts-all
     7214     T-parts-not-blank
     7215     T-parts-ser
     7216     T-pb-alt
     7217     T-pb-base
     7218     T-sc-base
     7219     .
     7220     if (
     7221     T-all-prt or
     7222     T-bc-alt  or
     7223     T-bc-base or
     7224     T-loc-alt or
     7225     T-loc-base  or
     7226     T-parts-all  or
     7227     T-parts-not-blank or
     7228     T-parts-ser or
     7229     T-pb-alt    or
     7230     T-pb-base   or
     7231     T-sc-base) = no then do:
     7232       message
     7233       "Не выбран ни один тип кодов!"
     7234       view-as alert-box error .
     7235       undo, return error .
     7236     end.
     7237     assign
     7238     temp-shop.obj-code = p-curr-obj-code
     7239     temp-shop.all-prt = T-all-prt
     7240     temp-shop.cd-bc-alt = T-bc-alt
     7241     temp-shop.cd-bc-base = T-bc-base
     7242     temp-shop.cd-loc-alt = T-loc-alt
     7243     temp-shop.cd-loc-base = T-loc-base
     7244     temp-shop.cd-parts-all = T-parts-all
     7245     temp-shop.cd-parts-not-blank = T-parts-not-blank
     7246     temp-shop.cd-parts-ser = T-parts-ser
     7247     temp-shop.cd-pb-alt = T-pb-alt
     7248     temp-shop.cd-pb-base = T-pb-base
     7249     temp-shop.cd-sc-base = T-sc-base
     7250     .
     7251   end.
     7252   assign
     7253   lns-cnt = 0
     7254   lns-ignore = 0
     7255   v-num-add  = 0
     7256   v-num-ignored = 0
     7257   tot-lns = (if line-mode = 'ОСТАВИТЬ':U then 0 else tot-lns)
     7258   .
     7259   run write-hist(p-from-macro, rs-list-method, rs-status, line-mode, buffer ub.goods).
     7260   if session:set-wait-state( "COMPILER" )  then .
     7261   dsp-rs:fgcolor in frame Dialog-Frame = 12.
     7262   case rs-list-method:
     7263     when "optimize"  then do:
     7264       find first buf_scnblist-hist where
     7265                  buf_scnblist-hist.id = p-id .
     7266       run proc-b-optimize(input p-from-macro
     7267                         , input rs-list-method
     7268                         , input rs-status
     7269                         , input buf_scnblist-hist.item_
     7270                         ) no-error .
     7271       assign                                                           buf_scnblist-hist.num-add  = lns-cnt - v-num-add                       buf_scnblist-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_scnblist-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_scnblist-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7272     end.
     7273     when "all" then do:
     7274       find first buf_scnblist-hist where
     7275                  buf_scnblist-hist.id = p-id .
     7276       if p-from-macro then run restore-codes in this-procedure (input buf_scnblist-hist.item_, p-curr-obj-type, p-curr-obj-code).
     7277       for each goods no-lock:
     7278         assign                 new-good = yes                 petrol-trk = no                 cashparts = no                 main-b-code = 0                 .
     7279         run process-one-good in this-procedure (input rs-list-method, input rs-status, input line-mode, buffer goods) no-error .
     7280       end.
     7281       assign                                                           buf_scnblist-hist.num-add  = lns-cnt - v-num-add                       buf_scnblist-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_scnblist-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_scnblist-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7282     end.
     7283     when "goods" then do:
     7284       for each buf_scnblist-hist where
     7285                buf_scnblist-hist.id = p-id:
     7286         if buf_scnblist-hist.line = 0
     7287         and p-from-macro then run restore-codes in this-procedure (input buf_scnblist-hist.item_, p-curr-obj-type, p-curr-obj-code).
     7288         if buf_scnblist-hist.line <> 0 then do:
     7289           run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_scnblist-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then next.
     7290           assign                 new-good = yes                 petrol-trk = no                 cashparts = no                 main-b-code = 0                 .
     7291           find goods where rowid (goods) = v-rowid no-lock.
     7292           run process-one-good in this-procedure (input rs-list-method, input rs-status, input line-mode ,buffer goods) no-error .
     7293           assign                                                           buf_scnblist-hist.num-add  = lns-cnt - v-num-add                       buf_scnblist-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_scnblist-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_scnblist-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7294         end.
     7295       end.
     7296     end.
     7297     when "goods-b-code"
     7298     or
     7299     when "goods-b-code-ean"
     7300     then do:
     7301       for each buf_scnblist-hist where
     7302                buf_scnblist-hist.id = p-id
     7303           and  buf_scnblist-hist.item_ <> '':U:
     7304         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_scnblist-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then next.
     7305         find first buf_bar-code no-lock where
     7306                   rowid(buf_bar-code) = v-rowid no-error.
     7307         if available buf_bar-code then do:
     7308           run get-prt-and-unit in this-procedure (
     7309                                                   input goods.prt-root
     7310                                                   ,input goods.unit-base
     7311                                                   ,output l-empty-scale
     7312                                                   ) .
     7313           if rs-list-method = "goods-b-code":U then
     7314           run ex-bbc in this-procedure (input rs-list-method, input rs-status, input line-mode , input no, input "":U, input no, buffer buf_bar-code, buffer buf_prod-bc).
     7315           if rs-list-method = "goods-b-code-ean":U then do:
     7316             RUN gen-bc( input buf_bar-code.b-code, output bar_code ).
     7317             IBM-good-code  = trim( bar_code ) .
     7318             run ex-bbc in this-procedure (input rs-list-method, input rs-status, input line-mode , input no, input IBM-good-code, input yes, buffer buf_bar-code, buffer buf_prod-bc).
     7319           end.
     7320           assign                                                           buf_scnblist-hist.num-add  = lns-cnt - v-num-add                       buf_scnblist-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_scnblist-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_scnblist-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     7321         end.
     7322       end.
     7323     end.
     7324     when "goods-b-str" then do:
     7325       for each buf_scnblist-hist where
     7326                buf_scnblist-hist.id = p-id
     7327           and  buf_scnblist-hist.item_ <> '':U:
     7328         run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_scnblist-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then next.
     7329         find first buf_prod-bc no-lock where
     7330                 rowid(buf_prod-bc) = v-rowid no-error.
     7331         if available buf_prod-bc then do:
     7332           find first buf_bar-code no-lock where
     7333                     buf_bar-code.b-code = buf_prod-bc.b-code no-error.
     7334           if available buf_prod-bc then do:
     7335             run get-prt-and-unit in this-procedure (
     7336                                                     input goods.prt-root
     7337                                                     ,input goods.unit-base
     7338                                                     ,output l-empty-scale
     7339                                                     ) .
     7340             run ex-bbc in this-procedure (input rs-list-method, input rs-status, input line-mode ,  input l-empty-scale, input "":U, input no, buffer buf_bar-code, buffer buf_prod-bc).
     7341           end.
     7342         end.
     7343       end.
     7344     end.
     7345     when "gds-list"  then do:
     7346       for each buf_scnblist-hist where
     7347                buf_scnblist-hist.id = p-id:
     7348         if buf_scnblist-hist.line = 0
     7349         and p-from-macro then run restore-codes in this-procedure (input buf_scnblist-hist.item_, p-curr-obj-type, p-curr-obj-code).
     7350         if buf_scnblist-hist.line <> 0 then do:
     7351           run gen-row-keyr  in this-procedure (  input prepare-rowid( buf_scnblist-hist.item_, v-no-context)                                                        ,input ?                                                                          ,input 'ub'                                                                       ,input ?                                                                          ,input no-lock                                                                    ,output v-rowid                                                                  ,output v-tbl-name) no-error .                  if error-status:error then next.
     7352           find first goods no-lock where rowid(goods) = v-rowid.
     7353           assign                 new-good = yes                 petrol-trk = no                 cashparts = no                 main-b-code = 0                 .
     7354           run process-one-good in this-procedure (input rs-list-method, input rs-status, input line-mode,buffer goods) no-error .
