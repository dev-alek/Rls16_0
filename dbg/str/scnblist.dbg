     8068               and buf_code-range.db-num = v-db-num     :
     8069             _prod-bc:
     8070             for each buf_prod-bc no-lock where
     8071                     buf_prod-bc.b-str >= string(buf_code-range.first-code, "99999")
     8072               and  buf_prod-bc.b-str <= string(buf_code-range.last-code, "99999")
     8073             on error undo, return error
     8074             :
     8075               if length( buf_prod-bc.b-str ) < 6 then do:
     8076                 assign
     8077                 l-prod-bc-weight   = no
     8078                 l-prod-bc-glob = no
     8079                 .
     8080   define variable vss-include-info67 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8081   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     8082     (buffer buf_prod-bc
     8083     ,input  'weight=request':u
     8084     ,output l-prod-bc-weight
     8085     ) no-error .
     8086                 if not l-prod-bc-weight then next _prod-bc.
     8087   define variable vss-include-info68 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8088   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     8089     (buffer buf_prod-bc
     8090     ,input  'global=request':u
     8091     ,output l-prod-bc-glob
     8092     ) no-error .
     8093                 if not l-prod-bc-glob then next _prod-bc.
     8094                 find first buf_bar-code no-lock
     8095                   where buf_bar-code.b-code = buf_prod-bc.b-code
     8096                 .
     8097                 if available buf_bar-code then do:
     8098                   find first ub.goods no-lock
     8099                     where ub.goods.gds-code = buf_bar-code.gds-code
     8100                     no-error
     8101                   .
     8102                   case v-using:
     8103                     when "all" then do:
     8104                     end.
     8105                     otherwise do:
     8106                       _gds-obj-attr:
     8107                       for each buf_clients no-lock where
     8108                               buf_clients.db-num = v-db-num,
     8109                           each buf_gds-obj-attr no-lock where
     8110                               buf_gds-obj-attr.obj-type = buf_clients.obj-type
     8111                           and  buf_gds-obj-attr.obj-code = buf_clients.obj-code
     8112                           and  buf_gds-obj-attr.gds-code = ub.goods.gds-code :
     8113                         if buf_gds-obj-attr.attr-value = buf_prod-bc.b-str
     8114                         and v-using = "nonusing" then do:
     8115                           find first buf_scales-gds no-lock where
     8116                                   buf_scales-gds.db-num = v-db-num
     8117                               and buf_scales-gds.obj-type = buf_clients.obj-type
     8118                               and buf_scales-gds.obj-code = buf_clients.obj-code
     8119                               and buf_scales-gds.b-code = buf_bar-code.b-code no-error.
     8120                           if available buf_scales-gds then do:
     8121                             next _prod-bc.
     8122                           end.
     8123                         end.
     8124                         if buf_gds-obj-attr.attr-value = buf_prod-bc.b-str
     8125                         and v-using = "using" then do:
     8126                           leave _gds-obj-attr.
     8127                         end.
     8128                       end.
     8129                       if v-using = "using"
     8130                       and not available buf_gds-obj-attr then next _prod-bc.
     8131                     end.
     8132                   end case.
     8133                   run get-prt-and-unit in this-procedure (
     8134                                                             input ub.goods.prt-root
     8135                                                           ,input ub.goods.unit-base
     8136                                                           ,output l-empty-scale
     8137                                                           ) .
     8138                   run ex-bbc in this-procedure (input rs-list-method, input rs-status, input line-mode ,  input l-empty-scale, input buf_prod-bc.b-str, input no, buffer buf_bar-code, buffer buf_prod-bc).
     8139                 end.
     8140               end.
     8141             end.
     8142           end.
     8143         end.
     8144         assign                                                           buf_scnblist-hist.num-add  = lns-cnt - v-num-add                       buf_scnblist-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_scnblist-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_scnblist-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8145       end.
     8146     end.
     8147     when "filter" then do:
     8148       define variable v-filter-var as character no-undo .
     8149       find first buf_scnblist-hist where
     8150               buf_scnblist-hist.id = p-id
     8151           AND buf_scnblist-hist.item_ <> '':U .
     8152       run proc-write-filter-expression-var in this-procedure ( input buf_scnblist-hist.item_, output v-filter-var ).
     8153       run gbl/scnbfill.p (
     8154                       input "Формирование списка по фильтру (без учета сортировки)"
     8155                     , input rs-list-method
     8156                     , input rs-status
     8157                     , input line-mode
     8158                     , input v-filter-var
     8159                     , output lns-cnt
     8160                     , output line-rec
     8161                     ) .
     8162       assign                                                           buf_scnblist-hist.num-add  = lns-cnt - v-num-add                       buf_scnblist-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_scnblist-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_scnblist-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8163     end.
     8164   end.
     8165   dsp-rs:fgcolor in frame Dialog-Frame = 4.
     8166   if session:set-wait-state( "" )  then .
     8167   case line-mode :
     8168     when 'ДОБАВЛЕНИЕ':U then do:
     8169       tot-lns = tot-lns + lns-cnt.
     8170       if not p-from-macro or p-step then
     8171       message
     8172       "Добавлено строк :" lns-cnt skip(0)
     8173       string(if lns-ignore <> 0
     8174       then ("Проигнорировано строк :" + string(lns-ignore))
     8175       else "":U)
     8176       .
     8177     end.
     8178     when 'удаление':U then do:
     8179       tot-lns = tot-lns - lns-cnt.
     8180       if not p-from-macro or p-step then
     8181       message
     8182       "Удалено строк :" lns-cnt skip(0)
     8183       string(if lns-ignore <> 0
     8184       then ("Проигнорировано строк :" + string(lns-ignore))
     8185       else "":U)
     8186       .
     8187     end.
     8188   end.
     8189   if line-mode <> 'ОСТАВИТЬ':U then  run UI-on.
     8190   end.
     8191   END PROCEDURE.
     8192   procedure proc-file-list-methods :
     8193   define input parameter p-from-macro as logical no-undo .
     8194   define input parameter rs-list-method as character no-undo .
     8195   define input parameter rs-status as character no-undo .
     8196   define input parameter line-mode as character no-undo .
     8197   define input parameter p-id      as integer no-undo .
     8198   define variable ss as character no-undo .
     8199   define variable b-c as integer no-undo.
     8200   define variable imp-type like ub.goods.prod-type no-undo.
     8201   define variable imp-code like ub.goods.prod-code no-undo.
     8202   define variable imp-art like ub.goods.artic no-undo.
     8203   define variable imp-doc-code like ub.trn-doc.doc-code no-undo.
     8204   define variable imp-doc-type as character no-undo.
     8205   define variable scan-qnty as dec no-undo.
     8206   define variable bc-qnty as dec no-undo.
     8207   define variable varresult   as character         no-undo.
     8208   define variable vartype-bc  as character         no-undo.
     8209   define variable varweight   as decimal           no-undo.
     8210   define variable v-full-path        as character no-undo .
     8211   define variable v-path             as character no-undo .
     8212   define variable v-file-name        as character no-undo .
     8213   define variable v-file-name-no-ext as character no-undo .
     8214   define variable v-file-name-ext    as character no-undo .
     8215   define buffer buf_scnblist-hist for scnblist-hist.
     8216   do
     8217   on error undo, return error
     8218   :
     8219   find first buf_scnblist-hist where
     8220             buf_scnblist-hist.id = p-id
     8221         AND buf_scnblist-hist.item_ <> '':U .
     8222   run gbl/filename.p
     8223     (input  entry(1, buf_scnblist-hist.item_, chr(4) )
     8224     ,output v-full-path
     8225     ,output v-path
     8226     ,output v-file-name
     8227     ,output v-file-name-no-ext
     8228     ,output v-file-name-ext
     8229     ) no-error .
     8230     if error-status:error then do: end. else do:
     8231     input stream sout from value (v-full-path).
     8232     CASE rs-list-method:
     8233       when "file-gds" then do:
     8234         if p-from-macro then
     8235         run restore-codes in this-procedure (input entry(2, buf_scnblist-hist.item, chr(4)), input p-curr-obj-type, input p-curr-obj-code).
     8236         repeat:
     8237             import stream sout imp-type imp-code imp-art scan-qnty no-error.
     8238             find ub.goods where ub.goods.prod-type = imp-type
     8239                         and ub.goods.prod-code = imp-code
     8240                         and ub.goods.artic     = imp-art no-lock no-error.
     8241             if available ub.goods then do:
     8242               assign                 new-good = yes                 petrol-trk = no                 cashparts = no                 main-b-code = 0                 .
     8243               run process-one-good in this-procedure (input rs-list-method, input rs-status, input line-mode ,buffer goods) no-error .
     8244             end.
     8245           end.
     8246       end.
     8247       when "scaner" then do:
     8248         message "При чтении из файла количеств они будут прибавлены к количествам в списке.".
     8249          repeat:
     8250           import stream sout unformatted ss.
     8251           ss = trim (ss).
     8252           if ss = "" then next.
     8253           if substr (ss, 1, 1) < "0" or substr (ss, 1, 1) > "9" then
     8254             if substr (ss, 1, 4) = "data" then ss = entry (2, ss, ":").
     8255             else next.
     8256             assign
     8257             scan-qnty = dec (entry (2, ss))
     8258             ss = trim (entry (1, ss)).
     8259   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     8260   (
     8261    input  parparentproc
     8262   ,input  ss
     8263   ,input  ?
     8264   ,input  p-curr-obj-type
     8265   ,input  p-curr-obj-type
     8266   ,input  yes
     8267   ,input  no
     8268   ,input  varscales-pref
     8269   ,input  varpgscales-pref
     8270   ,output varresult
     8271   ,output vartype-bc
     8272   ,output varweight
     8273   ,buffer ub.bar-code
     8274   ,buffer ub.prod-bc
     8275   ,buffer ub.place
     8276   ) no-error.
     8277           if not available ub.bar-code then next.
     8278           bc-qnty = ub.bar-code.cli-base-rate.
     8279           assign                 new-good = yes                 petrol-trk = no                 cashparts = no                 main-b-code = 0                 .
     8280           find ub.goods where ub.goods.gds-code = ub.bar-code.gds-code NO-LOCK no-error.
     8281           if available ub.goods then do:
     8282             run get-prt-and-unit in this-procedure (
     8283                                                     input ub.goods.prt-root
     8284                                                     ,input ub.goods.unit-base
     8285                                                     ,output l-empty-scale
     8286                                                     ) .
     8287             run ex-bbc in this-procedure (input rs-list-method, input rs-status, input line-mode , input no, input "":U, input (not available prod-bc), buffer bar-code, buffer prod-bc).
     8288             if available scnblist and
     8289               scnblist.artic = ub.goods.artic and
     8290               scnblist.prod-type = ub.goods.prod-type and
     8291               scnblist.prod-code = ub.goods.prod-code then
     8292               scnblist.qnty = scnblist.qnty + scan-qnty * bc-qnty.
     8293           end.
     8294         end.
     8295       end.
     8296     END CASE.
     8297     input stream sout close.
     8298     assign                                                           buf_scnblist-hist.num-add  = lns-cnt - v-num-add                       buf_scnblist-hist.num-recs = (if line-mode = 'ОСТАВИТЬ':U                                            then (tot-lns + buf_scnblist-hist.num-add)                                            else (tot-lns + (if line-mode = 'ДОБАВЛЕНИЕ':U then 1 else - 1) * lns-cnt))                   tot-lns               = (if line-mode = 'ОСТАВИТЬ':U then lns-cnt else tot-lns)                     buf_scnblist-hist.num-ignored = lns-ignore  - v-num-ignored                    v-num-add             = lns-cnt                                   v-num-ignored         = lns-ignore.
     8299     end.
     8300   end.
     8301   END PROCEDURE.
     8302   PROCEDURE write-hist :
     8303   define input parameter p-from-macro as logical no-undo .
     8304   define input parameter rs-list-method as character no-undo .
     8305   define input parameter rs-status as character no-undo .
     8306   define input parameter line-mode as character no-undo .
     8307   define parameter buffer buf_goods for ub.goods.
     8308   define variable v-ii as integer no-undo .
     8309   define variable v-temp-seq as integer no-undo .
     8310   if rs-list-method begins "single" then do:
     8311     if v-no-hist < 0 then do:
     8312       run create-scnblist-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8313                                           , input-output v-seq
     8314                                           , input 0
     8315                                           , input get-hist-mode(line-mode)
     8316                                           , input (if line-mode = 'ДОБАВЛЕНИЕ':U
     8317                                                   then (substitute("Коды по ТОВАРУ c гл.кодом &1 &2 &3&4 &5 -"
     8318                                                             , buf_goods.gds-code
     8319                                                             , buf_goods.artic
     8320                                                             , buf_goods.prod-type
     8321                                                             , buf_goods.prod-code
     8322                                                             , buf_goods.gds-name) +
     8323                                                          (if t-loc-base then 'основн.'  else '':U) + chr(32) +                           (if t-bc-base  then 'основн.EAN'  else '':U) + chr(32) +                        (if t-bc-alt then 'неосновн.EAN'  else '':U) + chr(32) +                           (if t-loc-alt  then 'неосновн.'  else '':U) + chr(32) +                      (if t-pb-base then 'ДопБК основн.'  else '':U) + chr(32) +                      (if t-pb-alt then 'ДопБК неосновн.'  else '':U) + chr(32) +                     (if t-sc-base then 'весов. и топл.'  else '':U) + chr(32) +                     (if t-all-prt then 'все признаки'  else '':U) + chr(32) +                       (if t-parts-ser then 'на сер. товар'  else '':U) + chr(32) +                    (if t-parts-not-blank then 'на непуст. № парт.'  else '':U) + chr(32) +         (if t-parts-all then 'все партии'  else '':U))
     8324                                                   else substitute("КОД &1 товар c гл.кодом &2 &3 &4&5 &6"
     8325                                                             , (if scnblist.b-str <> '':U then scnblist.b-str else string(scnblist.b-code))
     8326                                                             , scnblist.gds-code
     8327                                                             , scnblist.artic
     8328                                                             , scnblist.prod-type
     8329                                                             , scnblist.prod-code
     8330                                                             , scnblist.gds-name)
     8331                                                   )
     8332                                           , input tot-lns
     8333                                           , input (rs-list-method + (if line-mode = 'ДОБАВЛЕНИЕ':U
     8334                                                                     then '':U
     8335                                                                     else (chr(4) + (if scnblist.b-str <> '':U
     8336                                                                                           then 'prod-bc':U
     8337                                                                                           else (if scnblist.loc-ean
     8338                                                                                                 then 'loc-ean':U
     8339                                                                                                 else 'bar-code':U)
     8340                                                                                           )
     8341                                                                           )
     8342                                                                     )
     8343                                                   )
     8344                                           , input rs-status
     8345                                           , input (if line-mode = 'ДОБАВЛЕНИЕ':U
     8346                                                    then ('goods':U + chr(3) + string(buf_goods.gds-code) + chr(4) +
     8347                                                          (if t-loc-base then 'loc-base':U  else '':U) + chr(32) +                        (if t-bc-base  then 'bc-base':U  else '':U) + chr(32) +                         (if t-bc-alt then 'bc-alt':U  else '':U) + chr(32) +                            (if t-loc-alt  then 'loc-alt':U  else '':U) + chr(32) +                         (if t-pb-base then 'pb-base':U  else '':U) + chr(32) +                          (if t-pb-alt then 'pb-alt':U  else '':U) + chr(32) +                            (if t-sc-base then 'sc-base'  else '':U) + chr(32) +                            (if t-all-prt then 'all-prt'  else '':U) + chr(32) +                            (if t-parts-ser then 'parts-ser':U  else '':U) + chr(32) +                      (if t-parts-not-blank then 'parts-not-blank'  else '':U) + chr(32) +            (if t-parts-all then 'parts-all'  else '':U))
     8348                                                    else (if scnblist.b-str <> '':u and scnblist.loc-ean = no
     8349                                                         then ('prod-bc':U + chr(3) + scnblist.b-str)
     8350                                                         else ('bar-code':U + chr(3) + string(scnblist.b-code))
     8351                                                         )
     8352                                                    )
     8353                                           , input '':U
     8354                                           , input ?
     8355                                           ).
     8356     end.
     8357     else do:
     8358       v-temp-seq = v-seq - 1.
     8359       do v-ii = 0 to v-no-hist:
     8360         run create-scnblist-hist in this-procedure(input ('ИЗМЕНЕНИЕ':U + chr(4) + 'mode':U)
     8361                                             , input-output v-temp-seq
     8362                                             , input v-ii
     8363                                             , input get-hist-mode(line-mode)
     8364                                             , input (substitute("Коды по ТОВАРУ c гл.кодом &1 &2 &3&4 &5 -"
     8365                                                               , scnblist.gds-code
     8366                                                               , scnblist.artic
     8367                                                               , scnblist.prod-type
     8368                                                               , scnblist.prod-code
     8369                                                               , scnblist.gds-name) +
     8370                                                      (if t-loc-base then 'основн.'  else '':U) + chr(32) +                           (if t-bc-base  then 'основн.EAN'  else '':U) + chr(32) +                        (if t-bc-alt then 'неосновн.EAN'  else '':U) + chr(32) +                           (if t-loc-alt  then 'неосновн.'  else '':U) + chr(32) +                      (if t-pb-base then 'ДопБК основн.'  else '':U) + chr(32) +                      (if t-pb-alt then 'ДопБК неосновн.'  else '':U) + chr(32) +                     (if t-sc-base then 'весов. и топл.'  else '':U) + chr(32) +                     (if t-all-prt then 'все признаки'  else '':U) + chr(32) +                       (if t-parts-ser then 'на сер. товар'  else '':U) + chr(32) +                    (if t-parts-not-blank then 'на непуст. № парт.'  else '':U) + chr(32) +         (if t-parts-all then 'все партии'  else '':U))
     8371                                             , input tot-lns
     8372                                             , input '':U
     8373                                             , input '':U
     8374                                             , input ('goods':U + chr(3) + string(scnblist.gds-code) +
     8375                                                     (if t-loc-base then 'loc-base':U  else '':U) + chr(32) +                        (if t-bc-base  then 'bc-base':U  else '':U) + chr(32) +                         (if t-bc-alt then 'bc-alt':U  else '':U) + chr(32) +                            (if t-loc-alt  then 'loc-alt':U  else '':U) + chr(32) +                         (if t-pb-base then 'pb-base':U  else '':U) + chr(32) +                          (if t-pb-alt then 'pb-alt':U  else '':U) + chr(32) +                            (if t-sc-base then 'sc-base'  else '':U) + chr(32) +                            (if t-all-prt then 'all-prt'  else '':U) + chr(32) +                            (if t-parts-ser then 'parts-ser':U  else '':U) + chr(32) +                      (if t-parts-not-blank then 'parts-not-blank'  else '':U) + chr(32) +            (if t-parts-all then 'parts-all'  else '':U))
     8376                                             , input '':U
     8377                                             , input ?
     8378                                             ).
     8379       end.
     8380     end.
     8381   end.
     8382   else do:
     8383     v-temp-seq = v-seq - 1.
     8384     do v-ii = 0 to v-no-hist:
     8385       run create-scnblist-hist in this-procedure(input ('ИЗМЕНЕНИЕ':U + chr(4) + 'mode':U)
     8386                                           , input-output  v-temp-seq
     8387                                           , input v-ii
     8388                                           , input get-hist-mode(line-mode)
     8389                                           , input '':U
     8390                                           , input tot-lns
     8391                                           , input rs-list-method
     8392                                           , input '':U
     8393                                           , input '':U
     8394                                           , input '':U
     8395                                           , input ?
     8396                                           ).
     8397     end.
     8398   end.
     8399   END.
     8400   FUNCTION stat-line RETURNS CHARACTER(input p-status-chr as character):
     8401   DEFINE VARIABLE var-stat-line as character no-undo .
     8402   CASE p-status-chr:
     8403     when 'все':U then do:
     8404       assign
     8405       var-stat-line = "(текущие и удаленные товары)"
     8406       .
     8407     end.
     8408     when 'текущие':U then do:
     8409       assign
     8410       var-stat-line = "(текущие товары)"
     8411       .
     8412     end.
     8413     when 'удаленные':U then do:
     8414       assign
     8415       var-stat-line = "(неактивные товары)"
     8416       .
     8417     end.
     8418   END CASE.
     8419   return var-stat-line .
     8420   END.
     8421   procedure proc-vc-rs-list-method :
     8422   define variable v-operation as integer no-undo .
     8423   define variable main-code like ub.bar-code.b-code no-undo .
     8424   define variable v-chk-date-chr as character no-undo .
     8425   define variable dsp-rs-option as character no-undo .
     8426   define variable v-curr-host-code like ub.sysconf.host-code no-undo .
     8427   define variable v-item_ as character no-undo .
     8428   define variable v-tbl-name as character no-undo .
     8429   define variable v-bh as handle no-undo .
     8430   define variable v-recs as integer   no-undo .
     8431   define variable v-temp-seq as integer   no-undo .
     8432   define variable v-line as integer   no-undo .
     8433   define variable v-tot-lns as integer   no-undo .
     8434   define variable f-name as character no-undo .
     8435   define variable rid-list as character no-undo .
     8436   define variable bar_code as character no-undo .
     8437   define variable v-jj as integer no-undo .
     8438   define variable v-rid as recid no-undo .
     8439   define buffer buf_scnblist-hist for scnblist-hist.
     8440   define buffer buf_prod-bc for ub.prod-bc.
     8441   define buffer buf_bar-code for ub.bar-code.
     8442   define buffer buf_cash-desk for ub.cash-desk.
     8443   define buffer buf_db for ub.db.
     8444     do
     8445     on error undo, return error
     8446     :
     8447     assign
     8448     frame Dialog-Frame
     8449     T-all-prt
     8450     T-bc-alt
     8451     T-bc-base
     8452     T-loc-alt
     8453     T-loc-base
     8454     T-parts-all
     8455     T-parts-not-blank
     8456     T-parts-ser
     8457     T-pb-alt
     8458     T-pb-base
     8459     T-sc-base
     8460     .
     8461     if (
     8462     T-all-prt or
     8463     T-bc-alt  or
     8464     T-bc-base or
     8465     T-loc-alt or
     8466     T-loc-base  or
     8467     T-parts-all  or
     8468     T-parts-not-blank or
     8469     T-parts-ser or
     8470     T-pb-alt    or
     8471     T-pb-base   or
     8472     T-sc-base) = no then do:
     8473       message
     8474       "Не выбран ни один тип кодов!"
     8475       view-as alert-box error .
     8476       undo, return error .
     8477     end.
     8478     assign
     8479     temp-shop.obj-code = p-curr-obj-code
     8480     temp-shop.all-prt = T-all-prt
     8481     temp-shop.cd-bc-alt = T-bc-alt
     8482     temp-shop.cd-bc-base = T-bc-base
     8483     temp-shop.cd-loc-alt = T-loc-alt
     8484     temp-shop.cd-loc-base = T-loc-base
     8485     temp-shop.cd-parts-all = T-parts-all
     8486     temp-shop.cd-parts-not-blank = T-parts-not-blank
     8487     temp-shop.cd-parts-ser = T-parts-ser
     8488     temp-shop.cd-pb-alt = T-pb-alt
     8489     temp-shop.cd-pb-base = T-pb-base
     8490     temp-shop.cd-sc-base = T-sc-base
     8491     .
     8492       v-no-hist = - 1.
     8493       if temp-list.fvalue = "single" then
     8494         run UI-on.
     8495       else do:
     8496         v-no-hist = 0.
     8497         case rs-list-method:
     8498           when "all" then do:
     8499             glog = yes.
     8500             message "Коды выбранных типов для всех товаров из справочника товаров"
     8501             skip stat-line(rs-status)
     8502             view-as alert-box question buttons OK-Cancel update glog.
     8503             if not glog then do:
     8504               run UI-on.
     8505               return error .
     8506             end.
     8507             v-no-hist = 1.
     8508             run create-scnblist-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8509                                                 , input-output v-seq
     8510                                                 , input 0
     8511                                                 , input '':U
     8512                                                 , input (substitute('Коды всех товаров &1 - ', stat-line(rs-status)) +
     8513                                                        (if t-loc-base then 'основн.'  else '':U) + chr(32) +                           (if t-bc-base  then 'основн.EAN'  else '':U) + chr(32) +                        (if t-bc-alt then 'неосновн.EAN'  else '':U) + chr(32) +                           (if t-loc-alt  then 'неосновн.'  else '':U) + chr(32) +                      (if t-pb-base then 'ДопБК основн.'  else '':U) + chr(32) +                      (if t-pb-alt then 'ДопБК неосновн.'  else '':U) + chr(32) +                     (if t-sc-base then 'весов. и топл.'  else '':U) + chr(32) +                     (if t-all-prt then 'все признаки'  else '':U) + chr(32) +                       (if t-parts-ser then 'на сер. товар'  else '':U) + chr(32) +                    (if t-parts-not-blank then 'на непуст. № парт.'  else '':U) + chr(32) +         (if t-parts-all then 'все партии'  else '':U))
     8514                                                 , input tot-lns
     8515                                                 , input rs-list-method
     8516                                                 , input rs-status
     8517                                                 , input (if t-loc-base then 'loc-base':U  else '':U) + chr(32) +                        (if t-bc-base  then 'bc-base':U  else '':U) + chr(32) +                         (if t-bc-alt then 'bc-alt':U  else '':U) + chr(32) +                            (if t-loc-alt  then 'loc-alt':U  else '':U) + chr(32) +                         (if t-pb-base then 'pb-base':U  else '':U) + chr(32) +                          (if t-pb-alt then 'pb-alt':U  else '':U) + chr(32) +                            (if t-sc-base then 'sc-base'  else '':U) + chr(32) +                            (if t-all-prt then 'all-prt'  else '':U) + chr(32) +                            (if t-parts-ser then 'parts-ser':U  else '':U) + chr(32) +                      (if t-parts-not-blank then 'parts-not-blank'  else '':U) + chr(32) +            (if t-parts-all then 'parts-all'  else '':U)
     8518                                                 , input '':U
     8519                                                 , input ?
     8520                                                 ).
     8521           end.
     8522           when "goods"
     8523           or
     8524           when "goods-b-code"
     8525           or
     8526           when "goods-b-code-ean"
     8527           or
     8528           when "goods-b-str"
     8529           then do:
     8530             glog = yes.
     8531             case rs-list-method:
     8532               when "goods" then do:
     8533                 assign
     8534                 dsp-rs-option = substitute("Заданные типы кодов для товаров: &1", stat-line(rs-status)) +
     8535                                 (if t-loc-base then 'основн.'  else '':U) + chr(32) +                           (if t-bc-base  then 'основн.EAN'  else '':U) + chr(32) +                        (if t-bc-alt then 'неосновн.EAN'  else '':U) + chr(32) +                           (if t-loc-alt  then 'неосновн.'  else '':U) + chr(32) +                      (if t-pb-base then 'ДопБК основн.'  else '':U) + chr(32) +                      (if t-pb-alt then 'ДопБК неосновн.'  else '':U) + chr(32) +                     (if t-sc-base then 'весов. и топл.'  else '':U) + chr(32) +                     (if t-all-prt then 'все признаки'  else '':U) + chr(32) +                       (if t-parts-ser then 'на сер. товар'  else '':U) + chr(32) +                    (if t-parts-not-blank then 'на непуст. № парт.'  else '':U) + chr(32) +         (if t-parts-all then 'все партии'  else '':U)
     8536                 v-item_ = (if t-loc-base then 'loc-base':U  else '':U) + chr(32) +                        (if t-bc-base  then 'bc-base':U  else '':U) + chr(32) +                         (if t-bc-alt then 'bc-alt':U  else '':U) + chr(32) +                            (if t-loc-alt  then 'loc-alt':U  else '':U) + chr(32) +                         (if t-pb-base then 'pb-base':U  else '':U) + chr(32) +                          (if t-pb-alt then 'pb-alt':U  else '':U) + chr(32) +                            (if t-sc-base then 'sc-base'  else '':U) + chr(32) +                            (if t-all-prt then 'all-prt'  else '':U) + chr(32) +                            (if t-parts-ser then 'parts-ser':U  else '':U) + chr(32) +                      (if t-parts-not-blank then 'parts-not-blank'  else '':U) + chr(32) +            (if t-parts-all then 'parts-all'  else '':U)
     8537               .
     8538               end.
     8539               when "goods-b-code" then do:
     8540                 assign
     8541                 dsp-rs-option = substitute("Основн. и неосновн. лок.коды для товара: &1", stat-line(rs-status))
     8542                 v-tbl-name = 'bar-code':U
     8543                 v-bh       = buffer ub.goods:handle
     8544                .
     8545               end.
     8546               when "goods-b-code-ean" then do:
     8547                 assign
     8548                 dsp-rs-option = substitute("Основн. и неосновн. лок.коды EAN для товара: &1", stat-line(rs-status))
     8549                 v-tbl-name = 'bar-code':U
     8550                 v-bh       = buffer buf_bar-code:handle
     8551                .
     8552               end.
     8553               when "goods-b-str" then do:
     8554                 assign
     8555                 dsp-rs-option = substitute("Основн. и неосновн. Доп.БК для товара: &1", stat-line(rs-status))
     8556                 v-tbl-name = 'prod-bc':U
     8557                 v-bh       = buffer buf_prod-bc:handle
     8558                .
     8559               end.
     8560             END CASE.
     8561             if not glog then do:
     8562               run UI-on.
     8563               return error.
     8564             end.
     8565             run ref/gds-ref.p (  input parparentproc
     8566                             ,input (if rs-list-method = "goods":U
     8567                                     then "b-sel,b-mark,b-add"
     8568                                     else "b-sel,b-add")
     8569                             ,input ?
     8570                             ,input ?
     8571                             ,input  'объект':U
     8572                             ,input ?
     8573                             ,input ?
     8574                             ,input ?
     8575                             ,input ?
     8576                             ,input p-curr-obj-type
     8577                             ,input p-curr-obj-code
     8578                             ,input ?
     8579                             ,output ref-list).
     8580             if ref-list <> "" then do:
     8581               if rs-list-method = "goods-b-code":U
     8582               or rs-list-method = "goods-b-code-ean":U
     8583               then do:
     8584                 v-ref-rec = integer (entry (1, ref-list)).
     8585                 find ub.goods where recid (ub.goods) = v-ref-rec no-lock.
     8586   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     8587     (input  ub.goods.gds-code
     8588     ,input  ?
     8589     ,output main-code
     8590     ) no-error .
     8591                 if error-status:error then do:
     8592                   run UI-on.
     8593                   return error.
     8594                 end.
     8595                 run ref/alt-cds.w (input parparentproc
     8596                               ,input p-curr-obj-type
     8597                               ,input p-curr-obj-code
     8598                               ,input "all-no-part"
     8599                               ,input ub.goods.gds-code
     8600                               ,input main-code
     8601                               ,output rid-list) no-error .
     8602                 if error-status:error or rid-list = "" then do:
     8603                   run UI-on.
     8604                   return error.
     8605                 end.
     8606               end.
     8607               if rs-list-method = "goods-b-str":U
     8608               then do:
     8609                 v-ref-rec = integer (entry (1, ref-list)).
     8610                 find ub.goods where recid (ub.goods) = v-ref-rec no-lock.
     8611   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     8612     (input  ub.goods.gds-code
     8613     ,input  ?
     8614     ,output main-code
     8615     ) no-error .
     8616                 if error-status:error then do:
     8617                   run UI-on.
     8618                   return error.
     8619                 end.
     8620                 run ref/prod-cds.w (
     8621                                 input parparentproc
     8622                               , input p-curr-obj-type
     8623                               , input p-curr-obj-code
     8624                               , input "all-no-part"
     8625                               , input goods.gds-code
     8626                               , input main-code
     8627                               , output rid-list) no-error .
     8628                 if error-status:error or rid-list = "" then do:
     8629                   run UI-on.
     8630                   return error.
     8631                 end.
     8632               end.
     8633               v-recs = num-entries (ref-list).
     8634               if rs-list-method = 'goods' then do:
     8635                 do num-rec = 0 to v-recs:
     8636                   if num-rec > 0
     8637                   then do:
     8638                     v-ref-rec = integer (entry (num-rec, ref-list)).
     8639                     find goods where recid (goods) = v-ref-rec no-lock.
     8640                   end.
     8641                   if num-rec = 0 then do:
     8642                     assign
     8643                     v-temp-seq = v-seq
     8644                     v-line     = 0
     8645                     dsp-rs = dsp-rs-option
     8646                     v-item_     = (if t-loc-base then 'loc-base':U  else '':U) + chr(32) +                        (if t-bc-base  then 'bc-base':U  else '':U) + chr(32) +                         (if t-bc-alt then 'bc-alt':U  else '':U) + chr(32) +                            (if t-loc-alt  then 'loc-alt':U  else '':U) + chr(32) +                         (if t-pb-base then 'pb-base':U  else '':U) + chr(32) +                          (if t-pb-alt then 'pb-alt':U  else '':U) + chr(32) +                            (if t-sc-base then 'sc-base'  else '':U) + chr(32) +                            (if t-all-prt then 'all-prt'  else '':U) + chr(32) +                            (if t-parts-ser then 'parts-ser':U  else '':U) + chr(32) +                      (if t-parts-not-blank then 'parts-not-blank'  else '':U) + chr(32) +            (if t-parts-all then 'parts-all'  else '':U)
     8647                     v-tbl-name = '':U
     8648                     v-bh       = ?
     8649                     v-tot-lns = tot-lns
     8650                     .
     8651                   end.
     8652                   else do:
     8653                     assign
     8654                     v-temp-seq = v-seq - 1
     8655                     v-line     = num-rec
     8656                     dsp-rs =  substitute("     гл. код &1 &2 &3&4 &5", goods.gds-code, goods.artic, goods.prod-type, goods.prod-code, goods.gds-name)
     8657                     v-item_     = '':U
     8658                     v-tbl-name = 'goods':U
     8659                     v-bh       = buffer goods:handle
     8660                     v-tot-lns = tot-lns + num-rec
     8661                     .
     8662                   end.
     8663                   v-no-hist = num-rec.
     8664                   run create-scnblist-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8665                                                       , input-output v-temp-seq
     8666                                                       , input v-line
     8667                                                       , input '':U
     8668                                                       , input dsp-rs
     8669                                                       , input v-tot-lns
     8670                                                       , input rs-list-method
     8671                                                       , input rs-status
     8672                                                       , input v-item_
     8673                                                       , input v-tbl-name
     8674                                                       , input v-bh
     8675                                                       ).
     8676                   if num-rec = 0 then v-seq  = v-temp-seq.
     8677                 end.
     8678               end.
     8679               else do:
     8680                 do num-rec = 0 to v-recs:
     8681                   do v-jj = 1 to num-entries(rid-list):
     8682                     if num-rec = 0
     8683                     and v-jj = 1
     8684                     then do:
     8685                 v-ref-rec = integer (entry (1, ref-list)).
     8686                 find goods where recid (goods) = v-ref-rec no-lock.
     8687                 assign
     8688                     v-temp-seq = v-seq
     8689                     v-line     = 0
     8690                     dsp-rs = dsp-rs-option
     8691                     v-item_     = '':U
     8692                     v-tbl-name = '':U
     8693                     v-bh       = ?
     8694                     v-tot-lns = tot-lns
     8695                     .
     8696                   end.
     8697                   else do:
     8698                     if rs-list-method = "goods-b-code":U
     8699                     or rs-list-method = "goods-b-code-ean":U then do:
     8700                       find first buf_bar-code no-lock where
     8701                                 recid(buf_bar-code) = integer(entry(v-jj, rid-list)) no-error .
     8702                       if rs-list-method = "goods-b-code" then
     8703                       bar_code = string(buf_bar-code.b-code).
     8704                       else
     8705                       RUN gen-bc in this-procedure ( input main-b-code, output bar_code ).
     8706                     end.
     8707                     else do:
     8708                       find first buf_prod-bc no-lock where
     8709                                   recid(buf_prod-bc) = integer(entry(v-jj, rid-list)) no-error .
     8710                       bar_code = buf_prod-bc.b-str.
     8711                     end.
     8712                     assign
     8713                     v-temp-seq = v-seq - 1
     8714                     v-line     = num-rec
     8715                 dsp-rs = dsp-rs-option + chr(32) +
     8716                          substitute("Код &1 гл. код &2 &3 &4&5 &6"
     8717                                    , bar_code
     8718                                    , goods.gds-code
     8719                                    , goods.artic
     8720                                    , goods.prod-type
     8721                                    , goods.prod-code
     8722                                    , goods.gds-name)
     8723                     v-item_     = '':u
     8724                     v-tbl-name = if rs-list-method = "goods-b-code":U
     8725                                  or rs-list-method = "goods-b-code-ean":U
     8726                                  then 'bar-code':U
     8727                                  else 'prod-bc':U
     8728                     v-bh       = if rs-list-method = "goods-b-code":U
     8729                                  or rs-list-method = "goods-b-code-ean":U
     8730                                  then buffer buf_bar-code:handle
     8731                                  else buffer buf_prod-bc:handle
     8732                     v-tot-lns = tot-lns + num-rec
     8733                 .
     8734                   end.
     8735                   v-no-hist = num-rec.
     8736                 run create-scnblist-hist in this-procedure(input 'ДОБАВЛЕНИЕ':U
     8737                                                     , input-output v-temp-seq
     8738                                                     , input v-line
     8739                                                     , input '':U
     8740                                                     , input dsp-rs
     8741                                                     , input v-tot-lns
     8742                                                     , input rs-list-method
     8743                                                     , input rs-status
     8744                                                     , input v-item_
     8745                                                     , input v-tbl-name
     8746                                                     , input v-bh
     8747                                                     ).
     8748                   if num-rec = 0 then v-seq  = v-temp-seq.
     8749                   end.
     8750               end.
     8751               end.
     8752             end.
     8753             else do:
     8754               run UI-on.
     8755               return error.
     8756             end.
     8757           end.
     8758           when "gds-list":U then do:
     8759             glog = yes.
     8760             message "Коды выбранных типов для товаров, выбранных в список"
     8761             skip stat-line(rs-status)
     8762             view-as alert-box question buttons OK-Cancel update glog.
     8763             if not glog then do:
     8764               run UI-on.
     8765               return error.
     8766             end.
     8767             for each gds-list:
     8768               delete gds-list.
     8769             end.
     8770             v-recs = 0.
     8771             num-rec = 0.
     8772   define variable vss-include-info69 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8773   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     8774     (input  p-curr-obj-type
     8775     ,input  p-curr-obj-code
     8776     ,output v-curr-host-code
     8777     )  .
     8778             run str/gds-list.w (input parparentproc, input v-curr-host-code, input p-curr-obj-type, input p-curr-obj-code).
     8779             for each gds-list,
     8780               first goods no-lock where goods.gds-code = gds-list.gds-code:
     8781               if num-rec = 0 then do:
     8782                 assign
     8783                 v-temp-seq = v-seq
     8784                 v-line     = 0
     8785                 dsp-rs-option = substitute("Коды выбранных типов товаров по списку: &1 - &2", rs-status, (if t-loc-base then 'основн.'  else '':U) + chr(32) +                           (if t-bc-base  then 'основн.EAN'  else '':U) + chr(32) +                        (if t-bc-alt then 'неосновн.EAN'  else '':U) + chr(32) +                           (if t-loc-alt  then 'неосновн.'  else '':U) + chr(32) +                      (if t-pb-base then 'ДопБК основн.'  else '':U) + chr(32) +                      (if t-pb-alt then 'ДопБК неосновн.'  else '':U) + chr(32) +                     (if t-sc-base then 'весов. и топл.'  else '':U) + chr(32) +                     (if t-all-prt then 'все признаки'  else '':U) + chr(32) +                       (if t-parts-ser then 'на сер. товар'  else '':U) + chr(32) +                    (if t-parts-not-blank then 'на непуст. № парт.'  else '':U) + chr(32) +         (if t-parts-all then 'все партии'  else '':U))
