     3852       ub.gds-prt.node-name at row 22 col 45 colon-aligned label "Шкала" fgcolor 4
     3853       ub.bar-code.b-code   at row 22 col 67 colon-aligned label "Код" format "9999999999" fgcolor 4
     3854       SPACE(0) SKIP(0)
