     3928   ON CHOOSE OF MENU-ITEM m-gds-save  DO:
     3929   define variable vss-include-info40 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3930   if lookup(b-save :type in frame Dialog-Frame
     3931            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3932            ) = 0
     3933   then do:
     3934     message
     3935       "$Workfile$"
     3936       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3937       "Интерфейсный элемент" self :name in frame Dialog-Frame skip
     3938       "Тип" self :type in frame Dialog-Frame skip
     3939       "Процедура" this-procedure :file-name skip
