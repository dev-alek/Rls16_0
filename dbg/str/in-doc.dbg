    17180   PROCEDURE local-lockup :
    17181   define variable varext-cycle as logical no-undo.
    17182   if not available  ub.doc-line then do:
    17183     message "Неправильно выбрана строка.".
    17184     return error.
    17185   end.
    17186   find ub.goods where ub.goods.artic     =  ub.doc-line.artic and
    17187                    ub.goods.prod-type =  ub.doc-line.prod-type and
    17188                    ub.goods.prod-code =  ub.doc-line.prod-code no-lock.
    17189   gds-rec = RECID(ub.goods).
    17190   pardoc-rec = RECID(t-doc).
    17191   assign
    17192     line-rec = recid ( ub.doc-line)
    17193     varlns-cnt = 1.
    17194   run str/in-line.w ( input  parparentproc,
    17195                       input  'ПРОСМОТР':U,
    17196                       input  pardoc-rec,
    17197                       input-output  line-rec,
    17198                       input  gds-rec,
    17199                       input  varlns-cnt,
    17200                       output varext-cycle,
    17201                       input 0,
    17202                       input ?, input varinplnsum ) no-error.
    17203   FIND t-doc WHERE RECID(t-doc) = pardoc-rec.
    17204   apply "entry" to br-dtl in frame d-in-doc.
    17205   END PROCEDURE.
    17206   PROCEDURE local-m-outs-5 :
    17207   define buffer   bf_trn-doc for ub.trn-doc.
    17208     define variable vardoc-code like ub.trn-doc.doc-code no-undo.
    17209     if (t-doc.status_ = 'накл':U or t-doc.status_ = 'запрос':U) and
    17210         not t-doc.flag_
    17211     then do:
    17212   define variable vss-include-info128 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    17213   do:
    17214     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    17215       (input  v-cntxt-db-num
    17216       ,input  v-cntxt-userid
    17217       ,input  0
    17218       ,input  'actn_income_import':U
    17219       ,input  'object':U
    17220       ,input  t-doc.host-code
    17221       ,input  t-doc.obj-type
    17222       ,input  t-doc.obj-code
    17223       ,input  0
    17224       ,input  0
    17225       ,input  0
    17226       ,input  true
    17227       ,output varlog
    17228       )  .
    17229   end.
    17230       assign vardoc-code = "import-" + t-doc.doc-code.
    17231       run utl/imp-allc.p ( input parparentproc,
    17232                        input 2,
    17233                        input ?,
    17234                        input ?,
    17235                        input t-doc.exch-code,
    17236                        input vardoc-code,
    17237                        input t-doc.cli-type,
    17238                        input t-doc.cli-code,
