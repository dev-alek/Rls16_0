     8444          input "get":U
     8445          ,input  v-cntxt-obj-type
     8446          ,input  v-cntxt-obj-code
     8447          ,input  'petrol':U
     8448          ,input  'block-nozzle':U
     8449          ,output v-value-character
     8450          ,output v-value-date
     8451          ,output v-value-decimal
     8452          ,output v-value-integer
     8453          ,output v-value-logical
     8454          ,output v-param-type
     8455          ,INPUT-OUTPUT table-handle v-tth
     8456          ) no-error .
     8457       if v-value-logical then
     8458       do:
     8459         list-pl = "" .
     8460         for each ub.doc-pl where
     8461                  ub.doc-pl.obj-type = t-doc.obj-type
     8462              and ub.doc-pl.obj-code = t-doc.obj-code
     8463              and ub.doc-pl.out-code = t-doc.doc-code
     8464             no-lock,
     8465             each ub.pl-gds-pump where ub.pl-gds-pump.gds-code = ub.doc-pl.gds-code and
     8466            ub.pl-gds-pump.obj-code = ub.doc-pl.obj-code and
     8467            ub.pl-gds-pump.obj-type = ub.doc-pl.obj-type and
     8468            ub.pl-gds-pump.pl-code = ub.doc-pl.pl-code no-lock,
     8469            each ub.pl-pump-nozzle where ub.pl-pump-nozzle.obj-code = ub.pl-gds-pump.obj-code and
     8470            ub.pl-pump-nozzle.obj-type = ub.pl-gds-pump.obj-type and
     8471            ub.pl-pump-nozzle.pl-code = ub.pl-gds-pump.pl-code and
     8472            ub.pl-pump-nozzle.pump-code = ub.pl-gds-pump.pump-code no-lock:
     8473           list-pl = substitute("&1&2&3:&4:&5", list-pl,
     8474                      if list-pl = "" then "" else ";",
     8475                      ub.pl-pump-nozzle.nozzle-code,
     8476                      ub.pl-pump-nozzle.pump-code,
     8477                      ub.pl-pump-nozzle.pl-code).
     8478         end.
