     9774   define variable vss-include-info68 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9775   on F8 of frame d-in-doc anywhere do:
     9776     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame d-in-doc. END.
     9777     return no-apply.
     9778   end.
     9779   ON CHOOSE OF b-next IN FRAME d-in-doc
     9780   DO:
     9781     RUN step-next in this-procedure .
     9782   END.
     9783   procedure step-next:
     9784   define variable cur-form as char no-undo.
     9785   define variable new-form as char no-undo.
     9786   define buffer new_trn-doc for ub.trn-doc  .
     9787   case t-doc.doc-type:
     9788     when 'при':U then
     9789       cur-form = if t-doc.internal then 'рас':U else 'при':U.
     9790     when 'рас':U or when 'возврат':U or when 'спи':U then
     9791       cur-form = 'рас':U.
     9792     when 'инв':U then cur-form = 'инв':U.
     9793   end case.
     9794   if bf-handle = ? then return .
     9795   if valid-handle (br-handle) then do:
     9796     varlog = br-handle:select-next-row().
     9797     find first new_trn-doc no-lock where  recid( new_trn-doc ) = bf-handle:recid no-error .
     9798     if not varlog then message "Это последний документ списка.".
     9799   end.
     9800   case new_trn-doc.doc-type:
     9801     when 'при':U then
     9802       new-form = if new_trn-doc.internal then 'рас':U else 'при':U.
     9803     when 'рас':U or when 'возврат':U or when 'спи':U then
     9804       new-form = 'рас':U.
     9805     when 'инв':U then new-form = 'инв':U.
     9806   end case.
     9807   assign
     9808       pardoc-rec   = bf-handle:recid
     9809       parnext-prev = ( cur-form = new-form ) .
     9810   end procedure.
     9811   ON CHOOSE OF b-prev IN FRAME d-in-doc
     9812   DO:
     9813     run step-prev in this-procedure .
     9814   END.
     9815   procedure step-prev:
     9816   define variable cur-form as char no-undo.
     9817   define variable new-form as char no-undo.
     9818   define buffer new_trn-doc for ub.trn-doc  .
     9819   case t-doc.doc-type:
     9820     when 'при':U then if t-doc.internal then cur-form = 'рас':U. else cur-form = 'при':U.
     9821     when 'рас':U or when 'возврат':U or when 'спи':U then cur-form = 'рас':U.
     9822     when 'инв':U then cur-form = 'инв':U.
     9823   end case.
     9824   if bf-handle = ? then return .
     9825   if valid-handle (br-handle) then do:
     9826     varlog = br-handle:select-prev-row().
     9827     find first new_trn-doc no-lock where  recid( new_trn-doc ) = bf-handle:recid no-error .
     9828     if not varlog then message "Это первый документ списка.".
     9829   end.
     9830   case new_trn-doc.doc-type :
     9831     when 'при':U then if new_trn-doc.internal then new-form = 'рас':U. else new-form = 'при':U.
     9832     when 'рас':U or when 'возврат':U or when 'спи':U then  new-form = 'рас':U.
     9833     when 'инв':U then new-form = 'инв':U.
     9834   end case.
     9835   assign
     9836     pardoc-rec   = bf-handle:recid
     9837     parnext-prev = (cur-form = new-form)
     9838   .
     9839   end procedure.
     9840   define variable vss-include-info69 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9841   procedure ver-clients :
     9842   define input  parameter p-obj-type as character no-undo .
     9843   define input  parameter p-obj-code as integer   no-undo .
     9844   define output parameter p-error as logical   no-undo .
     9845   define variable v-veto-man-doc as character no-undo .
     9846   define variable v-type        as character no-undo .
     9847     do
     9848     on error undo, return error return-value
     9849     :
     9850     p-error = false .
     9851   run clntattr-value in this-procedure (
     9852    input p-obj-type ,
     9853    input p-obj-code ,
     9854    input 'veto-man-doc':U     ,
     9855    output v-veto-man-doc ,
     9856    output v-type        ) no-error .
     9857    if error-status :error then message
     9858      error-status :get-message(1) skip
     9859      return-value skip
     9860      "Ошибка clntattr-veto-man-doc"
     9861      view-as alert-box error
     9862    .
     9863     if v-veto-man-doc = 'ALL' then do:
     9864         message "Запрещено создание документа на этого контрагента оператору вручную." view-as alert-box error  .
     9865         p-error = true .
     9866     end.
     9867    end.
     9868   end procedure.
     9869   on end-error, stop of frame d-in-doc do:
     9870     apply "choose" to b-exit in frame d-in-doc.
     9871     return no-apply.
     9872   end.
     9873   on choose of b-notes in frame d-in-doc run notes-tr.
     9874   on choose of b-history   in frame d-in-doc do:
     9875     run proc-history in this-procedure no-error.
     9876     if error-status :error then do: return no-apply. end.
     9877   end.
     9878   on choose of b-exit  in frame d-in-doc
     9879   do:
     9880     run proc-exit no-error.
     9881     if error-status :error then do: return no-apply. end.
     9882   end.
     9883   define variable vss-include-info70 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9884   ON MOUSE-SELECT-DBLCLICK, return OF t-doc.agnt IN FRAME d-in-doc
     9885   DO:
     9886     run local-psn-chk ("agnt", "ret-mouse").
     9887     apply "entry" to t-doc.boss in frame d-in-doc.
     9888     return no-apply.
     9889   END.
     9890   ON MOUSE-SELECT-DBLCLICK, return OF t-doc.boss IN FRAME d-in-doc
     9891   DO:
     9892     RUN local-psn-chk ("boss", "ret-mouse").
     9893     apply "entry" to b-exit in frame d-in-doc.
     9894     return no-apply.
     9895   END.
     9896   ON MOUSE-SELECT-DBLCLICK, return OF t-doc.wrkr IN FRAME d-in-doc
     9897   DO:
     9898     RUN local-psn-chk ("wrkr", "ret-mouse").
     9899     apply "entry" to t-doc.agnt in frame d-in-doc.
     9900     return no-apply.
     9901   END.
     9902   ON CHOOSE OF r-agnt IN FRAME d-in-doc
     9903   DO:
     9904     RUN local-psn-chk ("agnt", "button").
     9905     apply "entry" to t-doc.boss in frame d-in-doc.
     9906     return no-apply.
     9907   END.
     9908   ON CHOOSE OF r-boss IN FRAME d-in-doc
     9909   DO:
     9910     RUN local-psn-chk ("boss", "button").
     9911     apply "entry" to b-exit in frame d-in-doc.
     9912     return no-apply.
     9913   END.
     9914   ON CHOOSE OF r-wrkr IN FRAME d-in-doc
     9915   DO:
     9916     run local-psn-chk ("wrkr", "button").
     9917     apply "entry" to t-doc.agnt in frame d-in-doc.
     9918     return no-apply.
     9919   END.
     9920   on leave of t-doc.agnt in frame d-in-doc  do:
     9921     if not available t-doc then return .
     9922     if input frame d-in-doc t-doc.agnt <> t-doc.agnt then do:
     9923       run local-psn-chk ("agnt", "leave").
     9924     end.
     9925   end.
     9926   on leave of t-doc.boss in frame d-in-doc   do:
     9927     if not available t-doc then return .
     9928     if input frame d-in-doc t-doc.boss <> t-doc.boss then do:
     9929       run local-psn-chk ("boss", "leave").
     9930     end.
     9931   end.
     9932   on leave of t-doc.wrkr in frame d-in-doc  do:
     9933     if not available t-doc then return .
     9934     if input frame d-in-doc t-doc.wrkr <> t-doc.wrkr then do:
     9935       run local-psn-chk ("wrkr", "leave").
     9936     end.
     9937   end.
     9938   procedure local-psn-chk :
     9939     define input parameter parman    as character no-undo.
     9940     define input parameter paraction as character no-undo.
     9941     if parman = "agnt" and paraction = "ret-mouse" then do:
     9942     define variable v-ref-rec71   as recid no-undo .
     9943     find cli-buf where cli-buf.obj-code = input frame d-in-doc t-doc.agnt
     9944                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     9945     if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:
     9946       if input frame d-in-doc t-doc.agnt <> ""
     9947          and input frame d-in-doc t-doc.agnt <> ? then
     9948         message "Из справочника клиентов Вы должны выбрать человека.".
     9949       run ref/cli-all.w (  input parparentproc
     9950                     ,  input "b-sel"
     9951                     ,  input 'чел':U
     9952                     ,  input ?
     9953                     ,  input ?
     9954                     ,  input ref-rec
     9955                     ,  input ",,,,,,NO"
     9956                     ,  input "lock-cli-type"
     9957                     , output ref-list ) .
     9958       assign v-ref-rec71 = integer( ref-list ).
     9959       ref-rec = integer( ref-list ) .
     9960       find cli-buf where recid (cli-buf) =
     9961          ref-rec
     9962          no-lock no-error.
     9963       if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then
     9964         find cli-buf where cli-buf.obj-code = input frame d-in-doc t-doc.agnt
