    13574       assign
    13575         is-copy = true
    13576         pardoc-mode = 'ДОБАВЛЕНИЕ':U
    13577         docrec-src = pardoc-rec
    13578         pardoc-rec = ?
    13579         .
    13580   define variable vss-include-info105 as character format "x(65)" no-undo initial "@(#)$Workfile$".
