     5662   procedure xmlchar-test :
     5663   define input parameter p-in-string          as character        no-undo.
     5664   define output parameter p-out-string-enc    as character        no-undo.
     5665   define output parameter p-out-string-dec    as character        no-undo.
     5666   do
     5667   on error undo, return error
     5668   :
     5669          run xmlchar-encode in this-procedure
     5670       (
     5671             input p-in-string
     5672           , output p-out-string-enc
     5673       ).
     5674          run xmlchar-decode in this-procedure
     5675       (
     5676             input p-out-string-enc
     5677           , output p-out-string-dec
     5678       ).
     5679   end.
     5680   end .
     5681   procedure xmlchar-encode :
     5682   define input parameter p-in-string      as character        no-undo.
     5683   define output parameter p-out-string    as character        no-undo.
     5684       define variable v-position      as integer      no-undo.
     5685       define variable v-current-char  as character    no-undo.
     5686   do
     5687   on error undo, return error
     5688   :
     5689       assign
     5690           p-out-string = "":U
     5691       .
     5692       case p-in-string
     5693       :
     5694           when ?
     5695           then do:
     5696               assign
     5697                   p-out-string = "?":U
     5698               .
     5699           end.
     5700           when "?":U
     5701           then do:
     5702               assign
     5703                   p-out-string = "&#63;":U
     5704               .
     5705           end.
     5706           otherwise do:
     5707               do v-position = 1 to length( p-in-string )
     5708               :
     5709                   assign
     5710                       v-current-char = substring( p-in-string, v-position, 1 )
     5711                   .
     5712                   case v-current-char
     5713                   :
     5714                       when "&":U
     5715                       then do:
     5716                           assign
     5717                               p-out-string = p-out-string + "&amp;":U
     5718                           .
     5719                       end.
     5720                       when ">":U
     5721                       then do:
     5722                           assign
     5723                               p-out-string = p-out-string + "&gt;":U
     5724                           .
     5725                       end.
     5726                       when "<":U
     5727                       then do:
     5728                           assign
     5729                               p-out-string = p-out-string + "&lt;":U
     5730                           .
     5731                       end.
     5732                       when "'":U
     5733                       then do:
     5734                           assign
     5735                               p-out-string = p-out-string + "&apos;":U
     5736                           .
     5737                       end.
     5738                       when '"':U
     5739                       then do:
     5740                           assign
     5741                               p-out-string = p-out-string + "&quot;":U
     5742                           .
     5743                       end.
     5744                       when chr(1)
     5745                       then do:
     5746                           assign
     5747                               p-out-string = p-out-string + "":U
     5748                           .
     5749                       end.
     5750                       when chr(2)
     5751                       then do:
     5752                           assign
     5753                               p-out-string = p-out-string + "":U
     5754                           .
     5755                       end.
     5756                       when chr(3)
     5757                       then do:
     5758                           assign
     5759                               p-out-string = p-out-string + "":U
     5760                           .
     5761                       end.
     5762                       when chr(4)
     5763                       then do:
     5764                           assign
     5765                               p-out-string = p-out-string + "":U
     5766                           .
     5767                       end.
     5768                       when chr(5)
     5769                       then do:
     5770                           assign
     5771                               p-out-string = p-out-string + "":U
     5772                           .
     5773                       end.
     5774                       when chr(6)
     5775                       then do:
     5776                           assign
     5777                               p-out-string = p-out-string + "":U
     5778                           .
     5779                       end.
     5780                       when chr(7)
     5781                       then do:
     5782                           assign
     5783                               p-out-string = p-out-string + "":U
     5784                           .
     5785                       end.
     5786                       when chr(8)
     5787                       then do:
     5788                           assign
     5789                               p-out-string = p-out-string + "":U
     5790                           .
     5791                       end.
     5792                       when chr(9)
     5793                       then do:
     5794                           assign
     5795                               p-out-string = p-out-string + "":U
     5796                           .
     5797                       end.
     5798                       when chr(29)
     5799                       then do:
     5800                           assign
     5801                               p-out-string = p-out-string + "":U
     5802                           .
     5803                       end.
     5804                       when chr(10)
     5805                       then do:
     5806                           assign
     5807                               p-out-string = p-out-string + "&#10;":U
     5808                           .
     5809                       end.
     5810                       when chr(13)
     5811                       then do:
     5812                           assign
     5813                               p-out-string = p-out-string + "&#13;":U
     5814                           .
     5815                       end.
     5816                       otherwise do:
     5817                           assign
     5818                               p-out-string = p-out-string + v-current-char
     5819                           .
     5820                       end.
     5821                   end case.
     5822               end.
     5823           end.
     5824       end case.
     5825   end.
     5826   end .
     5827   procedure xmlchar-encode-1c :
     5828   define input parameter p-in-string      as character        no-undo.
     5829   define output parameter p-out-string    as character        no-undo.
     5830       define variable v-position      as integer      no-undo.
     5831       define variable v-current-char  as character    no-undo.
     5832   do
     5833   on error undo, return error
     5834   :
     5835       assign
     5836           p-out-string = "":U
     5837       .
     5838       case p-in-string
     5839       :
     5840           when ?
     5841           then do:
     5842               assign
     5843                   p-out-string = "?":U
     5844               .
     5845           end.
     5846           otherwise do:
     5847               do v-position = 1 to length( p-in-string )
     5848               :
     5849                   assign
     5850                       v-current-char = substring( p-in-string, v-position, 1 )
     5851                   .
     5852                   case v-current-char
     5853                   :
     5854                       when chr(1)
