      333   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      334   procedure tax-name:
      335   define input  parameter pardef-tax  as character           no-undo.
      336   define output parameter parname-tax as character initial ? no-undo.
      337   define buffer bf_tax for ub.tax.
      338   do on error undo, return error :
      339      case pardef-tax:
      340         when 'vat':U then do:
      341                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
      342         end.
      343         when 'slt':U then do:
      344                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
      345         end.
      346         when 'rdt':U then do:
      347                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
      348         end.
      349         when 'exc':U then do:
      350                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
      351         end.
      352         otherwise do:
      353            return error "Задан неверный параметр " + pardef-tax + " .".
      354         end.
      355      end case.
      356   end.
      357   end procedure.
      358   define new global shared variable g#lib-trn  as handle no-undo .
      359   define new global shared variable g#lib-trn2 as handle no-undo .
      360   define new global shared variable g#lib-trn3 as handle no-undo .
      361   define new global shared variable g#lib-trn4 as handle no-undo .
      362   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      363   procedure cur-time :
      364      define output parameter p-today as date      no-undo .
      365      define output parameter p-time  as integer   no-undo .
      366     do
      367     on error undo, return error
      368     :
      369       define variable v-date1 as date      no-undo .
      370       define variable v-date2 as date      no-undo .
      371       define variable v-time  as integer   no-undo .
      372       assign
      373         v-date1 = today
      374         v-time  = time
      375         v-date2 = today
      376       .
      377       if v-date1 <> v-date2
      378       then do:
      379         assign
      380           v-date1 = today
      381           v-time  = v-time
      382         .
      383       end.
      384       assign
      385         p-today = v-date1
      386         p-time  = v-time
      387       .
      388     end.
      389   end.
      390   function cur-time-date returns character
      391   :
      392     return string(today, '99/99/9999':U) .
      393   end.
      394   function cur-time-mjd returns decimal
      395   :
      396     define variable v-date as date      no-undo .
      397     define variable v-time as integer   no-undo .
      398     run cur-time in this-procedure
      399       (output v-date
      400       ,output v-time
      401       ) .
      402     return integer(v-date) - 2400002 + (v-time / 86400) .
      403   end.
      404   function cur-time-get-ending-index returns integer
      405   (input p-number as integer
      406   )
      407   :
      408     if p-number < 0
      409     or p-number = ?
      410     then do:
      411       return 1 .
      412     end.
      413     define variable v-rest as integer   no-undo .
      414     assign
      415       p-number = p-number modulo 100
      416     .
      417     if p-number < 20
      418     then do:
      419       assign
      420         v-rest = p-number
      421       .
      422     end.
      423     else do:
      424       assign
      425         v-rest = p-number modulo 10
      426       .
      427     end.
      428     case v-rest :
      429       when 1
      430       then do:
      431         return 2 .
      432       end.
      433       when 2 or
      434       when 3 or
      435       when 4
      436       then do:
      437         return 3 .
      438       end.
      439       otherwise do:
      440         return 1 .
      441       end.
      442     end case .
      443   end.
      444   procedure cur-time-mjd-to-date :
      445      define input  parameter i-mjd-diff as decimal no-undo.
      446      define output parameter o-Date     as date    no-undo.
      447      define output parameter o-Time     as integer no-undo.
      448      define variable v-day-number as integer   no-undo .
      449      if    i-mjd-diff < 0
      450         or i-mjd-diff = ?
      451      then do:
      452         return "?" .
      453      end.
      454      assign
      455         v-day-number = truncate(i-mjd-diff,0).
      456         o-Date = date(v-day-number + 2400002).
      457         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      458     .
      459   end.
      460   function cur-time-mjd-to-string returns character
      461   (input p-mjd-diff as decimal
      462   )
      463   :
      464     define variable v-day-number as integer   no-undo .
      465     define variable v-seconds    as integer   no-undo .
      466     define variable v-hour       as integer   no-undo .
      467     define variable v-min        as integer   no-undo .
      468     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      469     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      470     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      471     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      472     if p-mjd-diff < 0
      473     or p-mjd-diff = ?
      474     then do:
      475       return "?" .
      476     end.
      477     assign
      478       v-day-number = integer(truncate(p-mjd-diff,0))
      479       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      480     .
      481     if v-seconds > 86400
      482     then do:
      483       assign
      484         v-seconds = 86400 - 1
      485       .
      486     end.
      487     if v-seconds < 0
      488     then do:
      489       assign
      490         v-seconds = 0
      491       .
      492     end.
      493     assign
      494       v-hour = truncate(v-seconds / 3600, 0)
      495     .
      496     assign
      497       v-seconds = v-seconds modulo 3600
      498     .
      499     assign
      500       v-min = truncate(v-seconds / 60, 0)
      501     .
      502     assign
      503       v-seconds = v-seconds modulo 60
      504     .
      505     return
      506         (if v-day-number <> 0
      507           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      508           else ""
      509         )
      510       + (if v-day-number <> 0 or v-hour <> 0
      511           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      512           else ""
      513         )
      514       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      515           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      516           else ""
      517         )
      518       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      519       .
      520   end.
      521   function cur-time-string returns character
      522   :
      523     define variable v-date as date      no-undo .
      524     define variable v-time as integer   no-undo .
      525     run cur-time in this-procedure
      526       (output v-date
      527       ,output v-time
      528       ) .
      529     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      530   end.
      531   function cur-time-string-sec returns character
      532   :
      533     define variable v-date as date      no-undo .
      534     define variable v-time as integer   no-undo .
      535     run cur-time in this-procedure
      536       (output v-date
      537       ,output v-time
      538       ) .
      539     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      540   end.
      541   function cur-time-custom  returns character
      542   (input p-prefix as character
      543   ,input p-date-format as character
      544   ,input p-delimiter as character
      545   ,input p-time-format as character
      546   ,input p-suffix as character
      547   )
      548   :
      549     define variable v-date as date      no-undo .
      550     define variable v-time as integer   no-undo .
      551     run cur-time in this-procedure
      552       (output v-date
      553       ,output v-time
      554       ) .
      555     return
      556       p-prefix
      557       + string(v-date, p-date-format)
      558       + p-delimiter
      559       + string(v-time, p-time-format)
      560       + p-suffix
      561       .
      562   end.
      563   function cur-time-print  returns character
      564   :
      565     define variable v-date as date      no-undo .
      566     define variable v-time as integer   no-undo .
      567     run cur-time in this-procedure
      568       (output v-date
      569       ,output v-time
      570       ) .
      571     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      572   end.
      573   function cur-time-datetime returns datetime
      574   :
      575     define variable v-char as character no-undo .
      576     define variable v-datetime as datetime no-undo .
      577     v-char = cur-time-string().
      578     v-datetime = datetime(v-char).
      579     return  v-datetime.
      580   end.
      581   function cur-time-string-msec returns character
      582   :
      583     define variable v-date as datetime  no-undo .
      584     v-date = now.
      585     return string(v-date) .
      586   end.
      587   define temp-table  tt-tax no-undo
      588     field tax-code    like ub.tax.tax-code
      589     field individual  like ub.tax.individual
      590     field tax-name    like ub.tax.tax-name format "x(12)" column-label "Налог"
      591     field rate-code   like ub.tax-rate.rate-code
      592     field rate-name   like ub.tax-rate.rate-name format "x(12)"
      593     field tax-type    like ub.tax.tax-type
      594     field rate-value  like ub.tax-rate-value.rate-value
      595     field tax-rate-gds-rc  as recid
      596     field to-cashdesk like ub.tax.to-cashdesk
      597     index tax-code is unique primary tax-code
      598     .
      599   procedure tax-val :
      600     define input  parameter       parartic      like ub.doc-line.artic     no-undo.
      601     define input  parameter       parprod-type  like ub.doc-line.prod-type no-undo.
      602     define input  parameter       parprod-code  like ub.doc-line.prod-code no-undo.
      603     define input  parameter       parunit-base  like ub.goods.unit-base    no-undo.
      604     define input  parameter       parnode-code  like ub.gds-prt.node-code  no-undo.
      605     define input  parameter       parunits-type like ub.units.type         no-undo.
      606     define input  parameter       parrec-id     as recid                   no-undo.
      607     define input  parameter       paris-log     as logical                 no-undo.
      608     define input  parameter       rdtaxcdvalue  as integer                 no-undo.
      609     define input  parameter       vattaxcdvalue as integer                 no-undo.
      610     define input  parameter       exctaxcdvalue as integer                 no-undo.
      611     define input  parameter       only-check    as logical                 no-undo.
      612     define input  parameter       parhost-code  like ub.sysconf.host-code  no-undo.
      613     define input  parameter       parobj-type   like ub.clients.obj-type   no-undo.
      614     define input  parameter       parobj-code   like ub.clients.obj-code   no-undo.
      615     define input  parameter       parroad-tax   like ub.doc-line.road-tax  no-undo.
      616     define input  parameter       parexcise     like ub.doc-line.excise    no-undo.
      617     define output parameter       parerr-mes    as character               no-undo.
      618     define input-output parameter parprice-sale like ub.price-list.price-sale no-undo.
      619     do
      620     on error undo, return error return-value
      621     :
      622   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      623   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
      624   define variable gp-price-sale like ub.price-list.price-sale no-undo.
      625   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
      626   define variable gp-excise     like ub.price-list.excise     no-undo.
      627   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
      628   define variable gp-fact-order as decimal   no-undo .
      629   define variable gp-price-sale-parts as decimal   no-undo .
      630       define buffer buf_tax          for ub.tax .
      631       define buffer buf_tax-rate     for ub.tax-rate .
      632       define buffer buf_tax-units    for ub.tax-units .
      633       define buffer buf_tax-rate-gds for ub.tax-rate-gds .
      634       define buffer buf_goods        for ub.goods .
      635       define buffer buf_bar-code     for ub.bar-code .
      636       define buffer buf_prod-bc      for ub.prod-bc .
      637       define buffer buf_units        for ub.units .
      638       define buffer buf_shop         for ub.shop .
      639       define buffer buf_store        for ub.store .
      640       define buffer buf_gds-prt      for ub.gds-prt .
      641       define buffer buf_tt-tax       for tt-tax .
      642       define variable varrate-value    as decimal   initial ? no-undo.
      643       define variable pr-list-recid    as recid     initial ? no-undo.
      644       define variable varmes           as character no-undo.
      645       define variable varfactorrtvalue as char      initial ? no-undo.
      646       define variable varfactorrttype  as char      initial ? no-undo.
      647       define variable is-petrolium     as logical no-undo.
      648       define variable is-pieces        as logical no-undo.
      649       define variable vargds-code      like ub.goods.gds-code no-undo.
      650       define variable pargds-code      like ub.goods.gds-code no-undo.
      651       define variable var-fact-order   as decimal no-undo .
      652       define variable currate-code     like buf_tax-rate.rate-code no-undo .
      653       define variable currate-name     like buf_tax-rate.rate-name no-undo .
      654       define variable currate-gds-rc   as recid no-undo .
      655       define variable v-today          as date no-undo .
      656       define variable v-time           as integer no-undo .
      657       for each buf_tt-tax:
      658         delete buf_tt-tax.
      659       end.
      660       run cur-time in this-procedure(output v-today, output v-time).
      661       run factord-end-day in this-procedure (input v-today, output var-fact-order).
      662       if parartic     = ?
      663       or parprod-type = ?
      664       or parprod-code = ?
      665       or parunit-base = ?
      666       then do:
      667         find first buf_goods no-lock
      668           where recid(buf_goods) = parrec-id
      669           no-error .
      670       end.
      671       else do:
      672         find first buf_goods no-lock
      673           where buf_goods.artic = parartic
      674             and buf_goods.prod-type = parprod-type
      675             and buf_goods.prod-code = parprod-code
      676           no-error .
      677       end.
      678       if not available buf_goods then do:
      679         assign varmes = "Ошибка при поиске товара. Программа tax-val.i" + chr(10) .
      680         if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      681       end.
      682       assign
      683         parartic     = buf_goods.artic
      684         parprod-type = buf_goods.prod-type
      685         parprod-code = buf_goods.prod-code
      686         parunit-base = buf_goods.unit-base
      687         pargds-code  = buf_goods.gds-code
      688       .
      689       if parunits-type = ?
      690       then do:
      691         find buf_units no-lock
      692           where buf_units.unit-name = parunit-base
      693           no-error .
      694         if not available buf_units then do:
      695           assign
      696             varmes =  varmes + "Ошибка при поиске единицы измерения. Программа tax-val.i" + chr(10)
      697           .
      698           if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      699         end.
      700         assign
      701           parunits-type = buf_units.type
      702         .
      703       end.
      704       if parhost-code = ?
      705       or parhost-code = 0
      706       then do:
      707   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      708   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      709     (input  parobj-type
      710     ,input  abs(parobj-code)
      711     ,output parhost-code
      712     ) no-error .
      713         if error-status :error then do:
      714           assign
      715             varmes =  varmes + substitute("Ошибка при определении фирмы для объекта &1 &2. Программа tax-val.i"
      716               ,string(parobj-type)
      717               ,string(parobj-code)
      718               ) + chr(10)
      719           .
      720           if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      721         end.
      722       end.
      723       assign
      724         vargds-code = buf_goods.gds-code
      725       .
      726       for each buf_tax-units no-lock
      727         where LOOKUP(buf_tax-units.type, parunits-type) > 0
      728       ,first buf_tax no-lock
      729         where buf_tax.tax-code = buf_tax-units.tax-code
      730       :
      731         find first buf_tt-tax where
      732                    buf_tt-tax.tax-code = buf_tax.tax-code no-error .
      733         if not available buf_tt-tax then do:
      734           create buf_tt-tax .
      735         end.
      736         assign
      737           buf_tt-tax.tax-code = buf_tax.tax-code
      738         .
      739         if buf_tax.individual = false then do:
      740           assign
      741             currate-gds-rc = ?
      742           .
      743           _tax-rate-gds:
      744           for each buf_tax-rate-gds no-lock where
      745                   buf_tax-rate-gds.gds-code = pargds-code and
      746                   buf_tax-rate-gds.tax-code = buf_tax.tax-code,
      747           first buf_tax-rate where
      748                 buf_tax-rate.tax-code  = buf_tax-rate-gds.tax-code and
      749                 buf_tax-rate.rate-code = buf_tax-rate-gds.rate-code no-lock
      750           by buf_tax-rate-gds.host-code
      751           by buf_tax-rate-gds.obj-type
      752           by buf_tax-rate-gds.obj-code
      753           by buf_tax-rate-gds.fact-order
      754           :
      755             if buf_tax-rate-gds.fact-order > var-fact-order then do:
      756               next _tax-rate-gds.
      757             end.
      758             if buf_tax-rate-gds.host-code = 0 or
      759               ((buf_tax-rate-gds.host-code = parhost-code) or
      760               (buf_tax-rate-gds.obj-type = parobj-type AND
      761               buf_tax-rate-gds.obj-code = parobj-code))
      762             then do:
      763               assign
      764               currate-code = buf_tax-rate.rate-code
      765               currate-name = buf_tax-rate.rate-name
      766               currate-gds-rc = recid(buf_tax-rate)
      767               .
      768             end.
      769             else do:
      770               next _tax-rate-gds.
      771             end.
      772           end.
      773           if currate-gds-rc = ? then do:
      774             assign varmes = "Не найдена ставка налога: "  + string(buf_tt-tax.tax-code) + " " + buf_tt-tax.tax-name +
      775                             " к товару: " + parartic + " " + parprod-type + " " + string(parprod-code) +
      776                             chr(10).
      777             if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      778           end.
      779         end.
      780         assign
      781           buf_tt-tax.rate-code   = currate-code
      782           buf_tt-tax.individual  = buf_tax.individual
      783           buf_tt-tax.tax-name    = buf_tax.tax-name
      784           buf_tt-tax.rate-name   = currate-name
      785           buf_tt-tax.tax-type    = buf_tax.tax-type
      786           buf_tt-tax.to-cashdesk = buf_tax.to-cashdesk
      787           buf_tt-tax.tax-rate-gds-rc  = currate-gds-rc
      788         .
      789       end.
      790       if parprice-sale = ?
      791       or parexcise     = ?
      792       or parroad-tax   = ?
      793       then do:
      794         if parnode-code = ? then do:
      795             FIND buf_gds-prt WHERE buf_gds-prt.upper-code  = buf_goods.prt-root NO-LOCK.
      796             parnode-code = buf_gds-prt.node-code.
      797         end.
      798   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      799   gp-fact-order = 0 .
      800   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      801     (input  vargds-code
      802     ,input  parnode-code
      803     ,output gp-b-code
      804     ) no-error .
      805   if error-status:error then do:
      806     message
      807       error-status :get-message(1) skip
      808       return-value skip
      809       view-as alert-box error .
      810     return error.
      811   end.
      812   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      813   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
      814     (input  parobj-type
      815     ,input  parobj-code
      816     ,input  gp-b-code
      817     ,input  0
      818     ,input  gp-fact-order
      819     ,output gp-doc-num
      820     ,output gp-price-sale
      821     ,output gp-road-tax
      822     ,output gp-excise
      823     ) no-error .
      824   if error-status:error then do:
      825     return error.
      826   end.
      827   gp-price-sale-parts = gp-price-sale.
      828   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      829   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_avprpart in g#lib-trn3
      830     (input  parobj-type
      831     ,input  parobj-code
      832     ,input  gp-b-code
      833     ,input  0
      834     ,input  gp-fact-order
      835     ,output gp-doc-num
      836     ,output gp-price-sale-parts
      837     ,output gp-road-tax
      838     ,output gp-excise
      839     ) no-error .
      840   if error-status:error then do:
      841     return error.
      842   end.
      843   if gp-price-sale-parts <> 0 and gp-price-sale-parts <> ? then do:
      844       gp-price-sale = gp-price-sale-parts.
      845    end.
      846         assign
      847           parprice-sale = gp-price-sale
      848           parexcise     = gp-excise
      849           parroad-tax   = gp-road-tax
      850         .
      851       end.
      852       if only-check then do:
      853         return .
      854       end.
      855       for each buf_tt-tax no-lock
      856       on error undo, return error
      857       :
      858         if buf_tt-tax.tax-rate-gds-rc = ? then NEXT.
      859         if not buf_tt-tax.individual then do:
      860   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      861   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
      862     (input  ?
      863     ,input  buf_tt-tax.tax-code
      864     ,input  buf_tt-tax.rate-code
      865     ,input  ?
      866     ,input  parhost-code
      867     ,input  parobj-type
      868     ,input  parobj-code
      869     ,output varrate-value
      870     ) no-error .
      871           if error-status:error or varrate-value = ? then do:
      872             assign varmes = "Не найдена величина ставки налога: "  + string(buf_tt-tax.tax-code) + " " + buf_tt-tax.tax-name + " " + string(buf_tt-tax.rate-code) +
      873                             " к товару: " + parartic + " " + parprod-type + " " + string(parprod-code) +
      874                             " фирма: " + string(parhost-code) +
      875                             " объект: " + parobj-type + " " + string(parobj-code) + chr(10).
      876             if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      877           end.
      878           assign
      879           buf_tt-tax.rate-value  = varrate-value
      880           .
      881         end.
      882         else do:
      883           if not avail buf_gds-prt then
      884           FIND buf_gds-prt WHERE buf_gds-prt.upper-code  = buf_goods.prt-root NO-LOCK.
      885   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
      886     (
      887        input buf_goods.artic
      888     ,  input buf_goods.prod-type
      889     ,  input buf_goods.prod-code
      890     , output is-petrolium
      891     , output is-pieces
      892     ) no-error.
      893           if (is-petrolium  and not is-pieces) and buf_goods.gds-type = 'т':U then do:
      894             find FIRST buf_prod-bc where
      895                         buf_prod-bc.b-code     = buf_goods.gds-code     and
      896                         buf_prod-bc.bc-on = yes no-lock no-error.
      897             if not available buf_prod-bc then do:
      898               assign varmes = "Не найден ДОП.бар-код по товару: " + parartic + " " + parprod-type + " " + string(parprod-code) +
      899                               " " + string(buf_gds-prt.node-code) + " " + string(parunit-base) + "~n".
      900               if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      901             end.
      902           end.
      903           else do:
      904             find buf_bar-code where
      905                   buf_bar-code.gds-code  = vargds-code     and
      906                   buf_bar-code.node-code = buf_gds-prt.node-code and
      907                   buf_bar-code.part-code = ""           and
      908                   buf_bar-code.in-code   = ""           and
      909                   buf_bar-code.unit-cli  = parunit-base  no-lock no-error.
      910             if not available buf_bar-code then do:
      911               assign varmes = "Не найден бар-код по товару: " + parartic + " " + parprod-type + " " + string(parprod-code) +
      912                               " " + string(buf_gds-prt.node-code) + " " + string(parunit-base) + "~n".
      913               if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      914             end.
      915           end.
      916           if buf_tt-tax.tax-code = rdtaxcdvalue then do:
      917             ASSIGN
      918             buf_tt-tax.rate-code   = if (is-petrolium  and not is-pieces) and buf_goods.gds-type = 'т':U
      919                                   then integer(buf_prod-bc.b-str)
      920                                   else buf_bar-code.b-code
      921             buf_tt-tax.rate-value  = parroad-tax
      922             buf_tt-tax.tax-rate-gds-rc  = ?
      923             NO-ERROR.
      924           end.
      925           if buf_tt-tax.tax-code = exctaxcdvalue then do:
      926             ASSIGN
      927             buf_tt-tax.rate-code   = if (is-petrolium  and not is-pieces) and buf_goods.gds-type = 'т':U
      928                                   then integer(buf_prod-bc.b-str)
      929                                   else buf_bar-code.b-code
      930             buf_tt-tax.rate-value  = parexcise
      931             buf_tt-tax.tax-rate-gds-rc  = ?
      932             NO-ERROR.
      933           end.
      934         end.
      935       end.
      936     end.
      937   end procedure.
      938   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      939   define temp-table lib-trn_ret-doc       no-undo like ub.trn-doc.
      940   define temp-table lib-trn_ret-line      no-undo like ub.doc-line
      941     field cst-code                like ub.trn-doc.cst-code
      942     field part-code               like ub.parts.part-code
      943     .
      944   define temp-table lib-trn_ret-line-attr no-undo like ub.doc-line-attr.
      945   define temp-table lib-trn_ret-dtl       no-undo like ub.gds-dtl.
      946   define temp-table lib-trn_ret-parts     no-undo like ub.parts.
      947   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      948   procedure doc-code:
      949   define input  parameter parmode          as   character           no-undo.
      950   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
      951   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
      952   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
      953   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
      954   define buffer buf_sys-ctrl for ub.sys-ctrl  .
      955   define variable vardb-remote     as   logical             no-undo.
      956   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
      957   define variable v-delimiter as character no-undo .
      958   do
      959   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      960   :
      961   find first buf_sys-ctrl no-lock .
      962   vardb-remote = buf_sys-ctrl.db-num <> 0 .
      963     CASE parmode:
      964       when "main":u then do:
      965         if vardb-remote then do:
      966           assign
      967             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
      968         end.
      969         else do:
      970           assign
      971             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
      972         end.
      973       end.
      974       when "trio" then do:
      975         assign
      976           pardoc-code = replace (parroot-doc-code, "=", "*").
      977       end.
      978       otherwise do:
      979         assign
      980         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
      981         no-error
      982         .
      983         if error-status:error  then do:
      984           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
      985                                         ,chr(10)
      986                                         ,parmode
      987                                         ).
      988         end.
      989         if num-entries(parmode) = 1
      990         and parmode <> "chip":U
      991         and parmode <> "chip_s":U
      992         then do:
      993           assign
      994           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
      995         end.
      996         else if (lookup("chip":U, parmode) > 0
      997                  or
      998                  lookup("chip_s":U, parmode) > 0) then do:
      999           assign
     1000             vartemp-doc-code = parroot-doc-code.
     1001           do while true:
     1002             if index (vartemp-doc-code , ".") = 0 then
     1003               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
     1004             else
     1005               vartemp-doc-code  =
     1006               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
     1007               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
     1008               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
     1009             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
     1010           end.
     1011           assign
     1012             pardoc-code = vartemp-doc-code.
     1013         end.
     1014       end.
     1015     end CASE.
     1016     if pardoc-code = '':U
     1017     or (parroot-doc-code <> '':U
     1018     and pardoc-code = parroot-doc-code) then do:
     1019       undo, return error substitute("Ошибка при генерации номера документа&1"
     1020                                     ,chr(10)).
     1021     end.
     1022   end.
     1023   end. // procedure/method
     1024   function get-doc-code-int64 returns int64
     1025     ( input p-doc-code as character ) :
     1026     define variable v-ind              as integer   no-undo .
     1027     define variable v-num-entries      as integer   no-undo .
     1028     define variable v-doc-code-int64   as int64     no-undo .
     1029     define variable v-canonic-doc-code as character no-undo .
     1030     assign
     1031       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
     1032       v-canonic-doc-code = p-doc-code
     1033     .
     1034     do v-ind = 1 to v-num-entries
     1035     :
     1036       assign
     1037         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
     1038       .
     1039     end.
     1040     assign
     1041       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
     1042     .
     1043     return v-doc-code-int64 .
     1044   end. // function/method
     1045   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1046   define new global shared variable g#lib-calc as handle no-undo .
     1047   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1048   procedure prescan:
     1049   define input parameter parrec-doc as recid no-undo.
     1050   define buffer ps_trn-doc  for ub.trn-doc.
     1051   define buffer ps_doc-line for ub.doc-line.
     1052   define buffer ps_gds-dtl  for ub.gds-dtl.
     1053   define buffer ps_parts    for ub.parts.
     1054   define variable to-null as logical no-undo.
     1055   define variable g-log   as logical no-undo.
     1056   do on error undo, return error return-value :
     1057   find first ps_trn-doc where recid (ps_trn-doc) = parrec-doc.
     1058   if (ps_trn-doc.doc-type = 'при':U and
     1059       ps_trn-doc.status_  = 'накл':U   and
     1060       ps_trn-doc.flag_)                     or
     1061      (can-do ('рас,спи,возврат':U, ps_trn-doc.doc-type) and
     1062       ps_trn-doc.status_ = 'разрешен':U                            ) then do:
     1063     if can-find (first ps_doc-line where ps_doc-line.doc-code   = ps_trn-doc.doc-code and
     1064                                          ps_doc-line.fact-qnty <> 0 no-lock)          then do:
     1065       assign
     1066         to-null = yes.
     1067     end.
     1068     else do:
     1069       assign
     1070         to-null = no.
     1071     end.
     1072     assign
     1073       g-log = no.
     1074     if to-null then do:
     1075       message "Для приемки товара с использованием мобильного сканера"
     1076               "фактические количества товара в документе должны быть обнулены." skip
     1077               "При повторном использовании сканера для того же документа обнуление не требуется." skip (2)
     1078               "Обнулить ФАКТ количества в документе ?"
     1079       view-as alert-box question buttons yes-no update g-log.
     1080     end.
     1081     else do:
     1082       message "В документе все ФАКТ количества нулевые."
     1083                "Сделать их равными количествам товара по документу ?"
     1084       view-as alert-box question buttons yes-no update g-log.
     1085     end.
     1086     if g-log then do:
     1087       for each ps_doc-line where ps_doc-line.doc-code = ps_trn-doc.doc-code on error undo, return error return-value :
     1088         assign
     1089           ps_doc-line.fact-qnty = (if to-null then 0 else ps_doc-line.doc-qnty).
     1090   if (valid-handle(g#lib-calc) <> true) then do:   run str/lib-calc.p persistent no-error .   if error-status :error or (valid-handle(g#lib-calc) <> true) then do:     message       "Error starting lib-calc.p" skip       g#lib-calc skip       g#lib-calc :type skip       g#lib-calc :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-calc_lnfactqt in g#lib-calc
     1091   (
     1092    input parparentproc
     1093   ,input recid(ps_doc-line)
     1094   ,input no
     1095   ,input ps_trn-doc.status_
     1096   ,input ps_trn-doc.flag_       )
     1097   no-error.
     1098         if error-status:error then do:
     1099           undo, return error substitute("Ошибка при изменении &1 фактического количества по товару: &2 &3 &4 ",
     1100                                         return-value,
     1101                                         ps_doc-line.artic,
     1102                                         ps_doc-line.prod-type,
     1103                                         ps_doc-line.prod-code).
     1104         end.
     1105       end.
     1106       for each ps_gds-dtl where ps_gds-dtl.doc-code = ps_trn-doc.doc-code:
     1107         assign
     1108           ps_gds-dtl.fact-qnty  = (if to-null then 0 else ps_gds-dtl.doc-qnty).
     1109       end.
     1110       for each ps_parts where ps_parts.out-code = ps_trn-doc.doc-code:
     1111         assign
     1112           ps_parts.fact-qnty = if to-null then 0 else ps_parts.qnty.
     1113       end.
     1114     end.
     1115   end.
     1116   end.
     1117   end procedure.
     1118   procedure renum :
     1119   define input parameter pardoc-code like ub.trn-doc.doc-code no-undo.
     1120   define buffer bf_trn-doc  for ub.trn-doc.
     1121   define buffer bf_doc-line for ub.doc-line.
     1122   define variable varline-num as integer no-undo.
     1123   define query q-doc-line for bf_doc-line.
     1124   do on error undo, return error return-value :
     1125   find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code no-lock no-error.
     1126   if error-status:error then do:
     1127     return error substitute("Не найден документ с номером &1", pardoc-code).
     1128   end.
     1129   open query q-doc-line preselect each bf_doc-line where bf_doc-line.doc-code = bf_trn-doc.doc-code use-index line-num exclusive-lock.
     1130   get first q-doc-line.
     1131   assign varline-num = 0.
     1132   do while available(bf_doc-line):
     1133      assign varline-num = varline-num + 1.
     1134      assign
     1135        bf_doc-line.line-num = varline-num.
     1136      get next q-doc-line.
     1137   end.
     1138   end.
     1139   end procedure.
     1140   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1141   define variable v-waitfram-action01         as character   no-undo .
     1142   define variable v-waitfram-action02         as character   no-undo .
     1143   define variable v-waitfram-action03         as character   no-undo .
     1144   define variable mWaitFramTextBeg            as character   no-undo.
     1145   define variable mWaitFramTextEnd            as character   no-undo.
     1146   define variable mWaitFramView               as logical     no-undo.
     1147   define variable mWaitProcEvent              as logical     no-undo init yes.
     1148   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1149   define variable mWaitFramStop               as logical     no-undo.
     1150   define variable mWaitFramStopUser           as logical     no-undo.
     1151   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1152   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1153   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1154   define button B-WaitFramStop auto-end-key
     1155        label "Стоп"
     1156        size 10 by 1 tooltip "Остоновить процесс".
     1157   define button B-viewProcInfo
     1158        label "Информация"
     1159        size 15 by 1 tooltip "Информация о процесс".
     1160   define frame waitfram
     1161     v-waitfram-action01 format "x(72)" no-label skip
     1162     v-waitfram-action02 format "x(72)" no-label skip
     1163     v-waitfram-action03 format "x(72)" no-label skip
     1164     B-viewProcInfo
     1165     B-WaitFramStop at row 4 col 30
     1166     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1167     .
     1168   define new global shared variable mBatchMode as logical no-undo init ?.
     1169   define variable mFramBachModHandle as handle no-undo.
     1170   mFramBachModHandle = frame waitfram:handle.
     1171   define variable mFameOldVis as logical no-undo.
     1172   define variable mVisCUrentVin as logical no-undo.
     1173   if session:batch-mode
     1174   then
     1175      mBatchMode = yes.
     1176   if mBatchMode = ? then do:
     1177     mVisCUrentVin = current-window:visible.
     1178     mFameOldVis = mFramBachModHandle:visible.
     1179     mFramBachModHandle:visible  = yes.
     1180     mBatchMode = mFramBachModHandle:visible ne yes.
     1181     mFramBachModHandle:visible = mFameOldVis.
     1182     current-window:visible = mVisCUrentVin.
     1183   end.
     1184    if  log-manager:logfile-name ne ?
     1185     then DO:
     1186         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1187         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1188         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1189     end.
     1190   on choose of B-WaitFramStop in frame waitfram
     1191   do:
     1192     mWaitFramStop = yes.
     1193     mWaitFramStopUser = yes.
     1194   end.
     1195   function waitfram-check-timeout returns logical():
     1196      define variable vtime as int64 no-undo.
     1197      if mWaitFramStopTimeOut
     1198      then
     1199         return yes.
     1200      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1201      if     mWaitFramTimeOut ne ?
     1202         and mWaitFramTimeOut ne 0
     1203         and mWaitFramTimeOut lt vtime
     1204      then do:
     1205         mWaitFramStopTimeOut = yes.
     1206      end.
     1207      return mWaitFramStopTimeOut.
     1208   end.
     1209   procedure waitfram-hide :
     1210     if not session:batch-mode
     1211     then do
     1212     on error undo, return error return-value
     1213     :
     1214       pause 0 before-hide .
     1215       if not mBatchMode then
     1216         hide frame waitfram .
     1217     if     not mWaitFramView
     1218        and mWaitProcEvent
     1219     then
     1220       process events .
     1221     end.
     1222   end procedure.
     1223   procedure waitfram-show :
     1224     define input  parameter p-message as character no-undo .
     1225     define variable v-left-margin as integer   no-undo .
     1226     if not session:batch-mode
     1227     then do
     1228     on error undo, return error return-value
     1229     :
     1230       if length(p-message) <= 70 then do:
     1231         assign
     1232           v-left-margin = integer((70 - length(p-message)) / 2)
     1233         .
     1234         assign
     1235           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1236         .
     1237         assign
     1238           v-waitfram-action01 = " "
     1239           v-waitfram-action02 = " "
     1240                                    + fill(" ", v-left-margin)
     1241                                    + p-message
     1242           v-waitfram-action03 = " "
     1243         .
     1244       end.
     1245       else do:
     1246         define variable vRindex1 as integer no-undo.
     1247         define variable vRindex2 as integer no-undo.
     1248         vRindex1 = r-index(p-message," ",70).
     1249         if vRindex1 = 0
     1250         then
     1251            vRindex1 = 70.
     1252         if length(p-message)  <= vRindex1 + 70 then do:
     1253           assign
     1254             v-waitfram-action01 = " "
     1255             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1256             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1257           .
     1258         end.
     1259         else do:
     1260           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1261           if vRindex2 <= vRindex1
     1262           then
     1263              vRindex2 = vRindex1 + 70.
     1264           assign
     1265             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1266             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1267             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1268           .
     1269         end.
     1270       end.
     1271       B-viewProcInfo:visible   in frame waitfram = no.
     1272       B-viewProcInfo:sensitive in frame waitfram = no.
     1273       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1274       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1275       if  (   mWaitFramView
     1276          or  mWaitProcEvent)
     1277          and not mBatchMode
     1278       then
     1279          display
     1280             v-waitfram-action01 skip
     1281             v-waitfram-action02 skip
     1282             v-waitfram-action03 skip
     1283          with frame waitfram .
     1284       if     mWaitFramView
     1285          then do:
     1286             if     mWaitFramInterval ne ?
     1287                and not mBatchMode
     1288             then
     1289                wait-for go of frame waitfram pause mWaitFramInterval.
     1290          end.
     1291          else
     1292             if     mWaitProcEvent
     1293                and not mBatchMode
     1294             then
     1295                process events .
     1296     end.
     1297   end procedure.
     1298      procedure waitfram-show-this:
     1299         define input  parameter iInterval as int64 no-undo.
     1300         define variable vtime as int64 no-undo.
     1301         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1302         mWaitFramInterval = iInterval.
     1303         run waitfram-show (substitute("&1&2 &3&4" ,
     1304                                       mWaitFramTextBeg ,
     1305                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1306                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1307                                       mWaitFramTextEnd
     1308                                      )
     1309                           ).
     1310      end.
     1311      procedure WaitFramRunPause:
     1312         define input  parameter iInterval as dec no-undo.
     1313         define variable vStart  as datetime-tz no-undo.
     1314         define variable vend    as datetime-tz no-undo.
     1315         define variable vint as int64 no-undo.
     1316         define variable vOk as logical no-undo.
     1317         vStart = now.
     1318         vend   = vStart.
     1319         publish "WaitFramPause" (iInterval,output vOk).
     1320         vend   =  now.
     1321         vint = vend - vStart.
     1322         vint = iInterval - vint / 1000.
     1323         if     not mWaitFramStop
     1324            and (   vint > 0
     1325                 or (    not vOk
     1326                     and iInterval eq ?
     1327                     )
     1328                 )
     1329         then
     1330            run waitfram-show-this (iInterval).
     1331         vend   =  now.
     1332         vint = vend - vStart.
     1333         vint = iInterval - vint / 1000.
     1334         if     not mWaitFramStop
     1335            and vint > 0
     1336         then do:
     1337            run gbl/pause.p (vint * 1000).
     1338         end.
     1339         if iInterval ne ?
     1340         then
     1341            publish "WaitFramStop".
     1342         waitfram-check-timeout().
     1343      end.
     1344      procedure WaitFramWaitFor:
     1345         define input  parameter iInterval as dec no-undo.
     1346         assign
     1347            mWaitFramStartProc   = now
     1348            mWaitFramStopUser    = no
     1349            mWaitFramStopTimeOut = no
     1350         .
     1351         block-wait:
     1352         do while not mWaitFramStop:
     1353            run WaitFramRunPause (iInterval).
     1354            if  waitfram-check-timeout()
     1355            then do:
     1356               leave block-wait.
     1357            end.
     1358         end.
     1359         run waitfram-hide.
     1360      end.
     1361   procedure waitfram-join :
     1362     define input  parameter p-line-1  as character no-undo .
     1363     define input  parameter p-line-2  as character no-undo .
     1364     define input  parameter p-line-3  as character no-undo .
     1365     define output parameter p-message as character no-undo .
     1366     do
     1367     on error undo, return error return-value
     1368     :
     1369       assign
     1370         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1371                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1372                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1373       .
     1374     end.
     1375   end procedure.
     1376   function waitfram-join-function returns character
     1377     (input p-line-1 as character
     1378     ,input p-line-2 as character
     1379     ,input p-line-3 as character
     1380     ).
     1381     define variable v-message as character no-undo .
     1382     run waitfram-join in this-procedure
     1383       (input  p-line-1
     1384       ,input  p-line-2
     1385       ,input  p-line-3
     1386       ,output v-message
     1387       ) .
     1388     return v-message .
     1389   end function .
