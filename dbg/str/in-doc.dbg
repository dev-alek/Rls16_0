    19586     end.
    19587     else do:
    19588       return ?.
    19589     end.
    19590   end.
    19591   else do:
    19592     find last bf_doc-line where bf_doc-line.obj-type     = t-doc.obj-type            and
    19593                                 bf_doc-line.obj-code     = t-doc.obj-code            and
    19594                                 bf_doc-line.prod-type    = local-doc-line.prod-type  and
    19595                                 bf_doc-line.prod-code    = local-doc-line.prod-code  and
    19596                                 bf_doc-line.artic        = local-doc-line.artic      and
    19597                                 bf_doc-line.ext-doc-type = 'ie':U        and
    19598                                 bf_doc-line.status_      = 'факт':U                   and
