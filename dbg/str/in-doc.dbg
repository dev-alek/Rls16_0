     7930   ON CHOOSE OF b-live IN FRAME d-in-doc
     7931   DO:
     7932     if lookup( self :type in frame d-in-doc, 'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW' ) <> 0 then do:   apply "ENTRY":U to self in frame d-in-doc .   if focus :handle <> self :handle in frame d-in-doc then do:     return no-apply .   end. end.
