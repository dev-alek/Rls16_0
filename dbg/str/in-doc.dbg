     7021   function get-name returns character
     7022   (buffer buf_doc-line for ub.doc-line,
     7023    buffer buf_goods    for ub.goods,
     7024    buffer buf_gds-prt    for ub.gds-prt) :
     7025   define buffer buf_gds-dtl for ub.gds-dtl.
     7026   if buf_gds-prt.node-name = '_Пустая шкала':U then return '-' .
     7027   else do:
     7028     if can-find (first buf_gds-dtl where
     7029           buf_gds-dtl.artic     = buf_goods.artic
     7030       and buf_gds-dtl.prod-type = buf_goods.prod-type
     7031       and buf_gds-dtl.prod-code = buf_goods.prod-code
     7032       and buf_gds-dtl.prt-code  = buf_gds-prt.node-code
     7033       and buf_gds-dtl.doc-code  = buf_doc-line.doc-code no-lock)
     7034           then return '--------------------'.
     7035           else buf_gds-prt.node-name .
     7036   end.
     7037   end function.
     7038   assign
     7039     parext-doc-mode =
     7040       ( if num-entries( pardoc-mode, '*':U ) > 1 then entry( 2, pardoc-mode, '*':U ) else '':U )
     7041     pardoc-mode     = entry( 1, pardoc-mode, '*':U )
     7042   .
     7043   run cr-tt-upd in this-procedure no-error.
     7044   if error-status :error then do: return error. end.
     7045   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7046   FUNCTION title-mode RETURNS CHARACTER
     7047     ( INPUT pmode as character ) :
     7048   DEFINE VARIABLE ptitle-mode as character no-undo.
     7049   CASE ENTRY(1, pmode) :
     7050     when 'ДОБАВЛЕНИЕ':U then ptitle-mode = "ДОБАВЛЕНИЕ".
     7051     when 'ИЗМЕНЕНИЕ':U  then ptitle-mode = "ИЗМЕНЕНИЕ".
     7052     when 'ПРОСМОТР':U  then ptitle-mode = "ПРОСМОТР".
     7053   END CASE.
     7054     RETURN ptitle-mode.
     7055   END FUNCTION.
