    17523   PROCEDURE out-doc-rec :
    17524     run fnd-an-doc in this-procedure no-error.
    17525     if error-status :error then do:
    17526        run proc-m-outs-1 in this-procedure.
    17527     end.
    17528     else do:
    17529         run fill-tt in this-procedure ( input t-d-b.doc-code ) no-error.
    17530         if error-status :error then  return error return-value.
    17531         run ask-copy in this-procedure no-error .
    17532         if error-status :error then return error return-value .
    17533     end.
    17534   END PROCEDURE.
    17535   PROCEDURE ov-pc :
    17536   define buffer d-l-b for  ub.doc-line.
    17537   define buffer ov-goods for ub.goods.
    17538   define buffer ov-units for ub.units.
    17539   define variable v-ov-pc as decimal no-undo .
    17540   if input frame d-in-doc ov-pc <> 0 then do:
    17541      run check-update in this-procedure no-error.
    17542      if error-status :error then do: return error. end.
    17543    end.
    17544   assign
    17545     v-ov-pc = input frame d-in-doc ov-pc.
    17546   if v-ov-pc <> 0  then do:
    17547     if v-ov-pc <= -100 then do:
    17548       message
    17549         "Вы ввели недопустимый процент скидки" v-ov-pc skip
    17550         "Он не может быть меньше чем -100%" skip
    17551         view-as alert-box error .
    17552       return error .
    17553     end.
    17554     def var v-num             as integer no-undo .
    17555     def var l-selection-exist as logical no-undo .
    17556     assign
    17557      l-selection-exist = (del-list <> "")
    17558     .
    17559     run gbl/d-askw.w
    17560       (input "Вопрос"
    17561       ,input "Пересчитать накладную по наценке/скидке на цену поставщика?" + chr(10)
    17562           + (if v-ov-pc > 0
    17563              then "Наценка: "
    17564              else "Скидка: ")
    17565           + string(abs(v-ov-pc)) + chr(10)
    17566         + (if l-selection-exist then "Выбрано строк: " + string(num-entries(del-list)) + chr(10) else "" )
    17567         + "Расчет производится по формуле:" + chr(10)
    17568         + (if v-ov-pc > 0
    17569            then "Новая цена = Старая цена * (1 + Наценка/ 100)" + chr(10)
    17570            else "Новая цена = Старая цена * (1 - Скидка/ 100)" + chr(10)
    17571           )
    17572       ,input "|^"
    17573       ,input "Все|"
    17574            + "Выбранные" + (if l-selection-exist then "" else "^disable") + "|"
    17575            + "Не выбранные" + (if l-selection-exist then "" else "^disable") + "|"
    17576            + "Отмена"
    17577       ,input "Все строки документа.|"
    17578           + "Все отмеченные строки. Кнопка доступна при наличии выбранных строк.|"
    17579           + "Все неотмеченные строки. Кнопка доступна при наличии выбранных строк.|"
    17580           + "Ничего не пересчитывать."
    17581       ,input 1
    17582       ,input 4
    17583       ,output v-num
    17584       ).
    17585     if v-num = 4 then do:
    17586       return .
    17587     end.
    17588     tr:
    17589     do transaction
    17590     on error   undo tr, return error return-value
    17591     :
    17592       run waitfram-show in this-procedure ( input "Расчет новых цен. Ждите..." ).
    17593       for each d-l-b
    17594         where d-l-b.doc-code = t-doc.doc-code
    17595       on error undo tr, return error
    17596       :
    17597         if (v-num = 1)
    17598         or (v-num = 2
    17599             and     can-do(del-list, string(recid(d-l-b)))
    17600            )
    17601         or (v-num = 3
    17602             and not can-do(del-list, string(recid(d-l-b)))
    17603            )
    17604         then do:
    17605           find first ov-goods where ov-goods.artic     = d-l-b.artic     and
    17606                                     ov-goods.prod-type = d-l-b.prod-type and
    17607                                     ov-goods.prod-code = d-l-b.prod-code no-lock.
    17608           find ov-units where ov-units.unit-name    = ov-goods.unit-base no-lock.
    17609           if lookup('2ед':U, ov-units.type) = 0 then
    17610           assign
    17611             d-l-b.price-cli = d-l-b.price-cli * (1 + v-ov-pc / 100) no-error.
    17612           else
    17613           assign
    17614             d-l-b.price-rubl = d-l-b.price-rubl * (1 + v-ov-pc / 100) no-error.
    17615           if error-status :error then do:
    17616             run waitfram-hide in this-procedure .
    17617             undo tr, return error .
    17618           end.
    17619   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_in-vat in g#lib-trn
    17620     (
    17621      input   t-doc.doc-code
    17622     ,input   t-doc.base-rate
    17623     ,input   t-doc.base-scale
    17624     ,input   t-doc.exch-rate
    17625     ,input   t-doc.exch-scale
    17626     ,input   t-doc.vat-type
    17627     ,input   t-doc.slt-type
    17628     ,input   d-l-b.artic
    17629     ,input   d-l-b.prod-type
    17630     ,input   d-l-b.prod-code
    17631     ,input   d-l-b.price-cli
    17632     ,input   d-l-b.cli-base-rate
    17633     ,input   d-l-b.price-rubl
    17634     ,input   d-l-b.vat-pc
    17635     ,input   d-l-b.slt-pc
    17636     ,input   d-l-b.road-tax
    17637     ,input   d-l-b.transport-rubl
    17638     ,input   d-l-b.other-rubl
    17639     ,output  varprice-cli
    17640     ,output  varprice-cli-unit-base
    17641     ,output  varprice-road-tax
    17642     ,output  varprice-other-exp
    17643     ,output  varprice-transport-exp
    17644     ,output  varprice-without-abs
    17645     ,output  varprice-slt
    17646     ,output  varprice-no-slt
    17647     ,output  varprice-vat
    17648     ,output  varprice-no-vat-slt
    17649     ,output  varprice-rubl
    17650     ,output  varprice-road-tax-rubl
    17651     ,output  varprice-other-exp-rubl
    17652     ,output  varprice-transport-exp-rubl
    17653     ,output  varprice-without-abs-rubl
    17654     ,output  varprice-slt-rubl
    17655     ,output  varprice-no-slt-rubl
    17656     ,output  varprice-vat-rubl
    17657     ,output  varprice-no-vat-slt-rubl
    17658     ,output  varprice-base
    17659     ,output  varprice-road-tax-base
    17660     ,output  varprice-other-exp-base
    17661     ,output  varprice-transport-exp-base
    17662     ,output  varprice-without-abs-base
    17663     ,output  varprice-slt-base
    17664     ,output  varprice-no-slt-base
    17665     ,output  varprice-vat-base
    17666     ,output  varprice-no-vat-slt-base
    17667     ) no-error.
    17668           if error-status :error then do:
    17669             return error "Ошибка при пересчете линии документа".
    17670           end.
    17671           assign d-l-b.price-cli  = varprice-cli
    17672                  d-l-b.price-rubl = varprice-rubl
    17673                  d-l-b.price-base = varprice-base.
    17674         end.
    17675       end.
    17676       run waitfram-show in this-procedure ( input "Проверка документа. Ждите..." ).
    17677       run check-rate in this-procedure no-error .
    17678       if error-status :error then do:
    17679         run waitfram-hide in this-procedure .
    17680         undo tr, return error .
    17681       end.
    17682       run waitfram-show in this-procedure ( input "Перерасчет документа в соответствии с новыми ценами. Ждите..." ).
    17683       run gbl/calc-trn.p (input parparentproc, input recid( t-doc ) ) no-error.
    17684       if error-status :error then do:
    17685         message "Ошибка при пересчете документа." view-as alert-box error.
    17686         run waitfram-hide in this-procedure .
    17687         undo tr, return error .
    17688       end.
    17689     end.
    17690     run waitfram-hide in this-procedure .
    17691     run UI-on in this-procedure ( input "line" ).
    17692     return .
    17693   end.
    17694   END PROCEDURE.
    17695   PROCEDURE prev-cor-line :
    17696   define input  parameter parunits-type like ub.units.type no-undo.
    17697   define input  parameter p-obj-type    like ub.clients.obj-type no-undo .
    17698   define input  parameter p-obj-code    like ub.clients.obj-code no-undo .
    17699   define input  parameter p-artic       like ub.goods.artic no-undo .
    17700   define input  parameter p-prod-type   like ub.goods.prod-type no-undo .
    17701   define input  parameter p-prod-code   like ub.goods.prod-code no-undo .
    17702   define variable v-insalepr as logical   no-undo .
    17703   define variable vss-include-info132 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    17704   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
    17705     (input  p-obj-type
    17706     ,input  p-obj-code
    17707     ,input  p-artic
    17708     ,input  p-prod-type
    17709     ,input  p-prod-code
    17710     ,input  'insalepr=request':U
    17711     ,output v-insalepr
    17712     )  .
    17713   if v-insalepr = true then
    17714      return error "Товар принимается по продажной цене. Изменение кол-ва допустимо лишь по кнопке <<Изм>>.".
    17715   if lookup('2ед':U, parunits-type) > 0  then
    17716      return error "Товар c двумя единицами измерения. Изменение кол-ва допустимо лишь по кнопке <<Изм>>.".
    17717   END PROCEDURE.
    17718   PROCEDURE proc-m-outs-1 :
    17719   define variable loc-ref-list as character no-undo .
    17720   apply "row-leave" to browse br-dtl.
    17721   do on error undo, return error return-value :
    17722   if not ((t-doc.status_ = 'накл':U or t-doc.status_ = 'запрос':U) and not t-doc.flag_) then do:
    17723     return error "Данное действие недопустимо в этом статусе.".
    17724   end.
    17725   if not b-add:sensitive in frame d-in-doc then do:
    17726     message "Добавление строк из другого документа при этом статусе невозможно.".
    17727     return error.
    17728   end.
    17729   run str/all-docs.w
    17730     (  input parparentproc,
    17731         input t-doc.host-code ,
    17732         input t-doc.obj-type ,
    17733         input t-doc.obj-code ,
    17734         input 'выбор':U,
    17735         input ?,
    17736         input ?,
    17737         input ?,
    17738         input ?,
    17739         input "b-sel":U,
    17740         input ?,
    17741         input ?,
    17742         input ?,
    17743         output loc-ref-list ).
    17744   find t-d-b where recid (t-d-b) = integer (loc-ref-list) no-lock no-error.
    17745   if not available t-d-b then do:
    17746     display ? @ t-doc.out-code with frame d-in-doc.
    17747     apply "entry" to b-add in frame d-in-doc.
    17748     return error.
    17749   end.
    17750   display t-d-b.doc-code @ t-doc.out-code with frame d-in-doc.
    17751   run fill-tt in this-procedure ( input t-d-b.doc-code ) no-error.
    17752      if error-status :error then  return error return-value.
    17753   run ask-copy in this-procedure no-error .
    17754      if error-status :error then  return error return-value.
    17755   end.
    17756   END PROCEDURE.
    17757   PROCEDURE proc-m-outs-2 :
    17758   APPLY "row-leave" to BROWSE br-dtl.
    17759   do transaction on error   undo, return error:
    17760   if b-add:sensitive in frame d-in-doc then do:
    17761     run check-exch in this-procedure.
    17762     if not can-find (first  ub.doc-line where  ub.doc-line.doc-code = t-doc.doc-code no-lock) then do:
    17763       run check-rate in this-procedure.
    17764      end.
    17765   end.
    17766   if pardoc-mode = 'ИЗМЕНЕНИЕ':U then do:
    17767     run prescan in this-procedure ( input recid( t-doc ) ) no-error.
    17768     if error-status :error then do:
    17769       message "Ошибка при установке фактического количества перед сканированием." skip
    17770               return-value
    17771       view-as alert-box error.
    17772       undo, return error.
    17773     end.
    17774   end.
    17775   run str/scan.p ( parParentproc, input b-add :sensitive , input recid(t-doc) , input ? ).
    17776   run gbl/calc-trn.p ( input parparentproc, input recid( t-doc ) ) no-error.
    17777   if error-status :error then do:
    17778     return error return-value.
    17779   end.
    17780   run UI-on in this-procedure ( input "line" ).
    17781   end.
    17782   END PROCEDURE.
    17783   PROCEDURE proc-m-outs-4 :
    17784   define buffer bf_trn-doc for ub.trn-doc.
    17785   define variable vardoc-code like ub.trn-doc.doc-code no-undo.
    17786   define variable vss-include-info133 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    17787   do:
    17788     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    17789       (input  v-cntxt-db-num
    17790       ,input  v-cntxt-userid
    17791       ,input  0
    17792       ,input  'actn_income_import':U
    17793       ,input  'object':U
    17794       ,input  t-doc.host-code
    17795       ,input  t-doc.obj-type
    17796       ,input  t-doc.obj-code
    17797       ,input  0
    17798       ,input  0
    17799       ,input  0
    17800       ,input  true
    17801       ,output varlog
    17802       )  .
    17803   end.
    17804   assign vardoc-code = "import-" + t-doc.doc-code.
    17805   do transaction:
    17806   run utl/imp-all.p (parparentproc, 2, ?, ?, t-doc.exch-code, vardoc-code, t-doc.cli-type, t-doc.cli-code, t-doc.host-code) no-error .
    17807   if error-status :error then do:
    17808      message "Ошибка при формировании файла import." view-as alert-box error.
    17809      return error.
    17810   end.
    17811   run disp-import in this-procedure ( input vardoc-code ) no-error.
    17812   find first bf_trn-doc where bf_trn-doc.doc-code = vardoc-code.
    17813   if available bf_trn-doc then do:
    17814      for each ub.parts exclusive-lock where
    17815       ub.parts.out-code = bf_trn-doc.doc-code:
    17816       delete ub.parts.
    17817      end.
    17818     delete bf_trn-doc.
    17819   end.
    17820   end.
    17821   END PROCEDURE.
    17822   PROCEDURE proc-m-outs-6 :
    17823   define buffer bf_trn-doc for ub.trn-doc.
    17824   define variable vardoc-code like ub.trn-doc.doc-code no-undo.
    17825   define variable vss-include-info134 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    17826   do:
    17827     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    17828       (input  v-cntxt-db-num
    17829       ,input  v-cntxt-userid
    17830       ,input  0
    17831       ,input  'actn_income_import':U
    17832       ,input  'object':U
    17833       ,input  t-doc.host-code
    17834       ,input  t-doc.obj-type
    17835       ,input  t-doc.obj-code
    17836       ,input  0
    17837       ,input  0
    17838       ,input  0
    17839       ,input  true
    17840       ,output varlog
    17841       )  .
    17842   end.
    17843   assign vardoc-code = "import-" + t-doc.doc-code.
    17844   do transaction:
    17845   run str/imp-art.p (parparentproc, 2, ?, ?, t-doc.exch-code, vardoc-code, t-doc.cli-type, t-doc.cli-code, t-doc.host-code) no-error .
    17846   if error-status :error then do:
    17847      message "Ошибка при формировании файла import." view-as alert-box error.
    17848      return error.
    17849   end.
    17850   run disp-import in this-procedure (input vardoc-code) no-error.
    17851   find first bf_trn-doc where bf_trn-doc.doc-code = vardoc-code.
    17852   delete bf_trn-doc.
    17853   end.
    17854   END PROCEDURE.
    17855   PROCEDURE proc-m-outs-7 :
    17856   define buffer bf_trn-doc for ub.trn-doc.
    17857   define buffer bf_doc-line for ub.doc-line .
    17858   define buffer bf_goods for ub.goods .
    17859   define variable vardoc-code like ub.trn-doc.doc-code no-undo.
    17860   define variable par-alcohol as character no-undo .
    17861   define variable par-mark as character no-undo .
    17862   define variable par-type as character no-undo .
    17863   define variable v-is-alc as logical no-undo .
    17864   define variable v-mark-alchol     as logical no-undo .
    17865   define variable v-type as character no-undo .
    17866   delete object v-tth no-error.
    17867   run adm/shattri.p (
    17868      input "get":U
    17869     ,input t-doc.obj-type
    17870     ,input t-doc.obj-code
    17871     ,input 'nakl_par':U
    17872     ,input  "mark-alchol"
    17873     ,output v-value-character
    17874     ,output v-value-date
    17875     ,output v-value-decimal
    17876     ,output v-value-integer
    17877     ,output v-mark-alchol
    17878     ,output v-type
    17879     ,INPUT-OUTPUT table-handle v-tth
    17880     ) no-error .
    17881     delete object v-tth no-error.
    17882   if error-status:error then do:
    17883     message "Ошибка при получение параметра mark-alchol"
    17884     view-as alert-box.
    17885     return error.
    17886   end.
    17887   if not v-mark-alchol
    17888   then do :
    17889       message "В системе не включен помарочный учёт. Импорт акцизных марок невозможен." view-as alert-box .
    17890       return.
    17891   end.
    17892   v-is-alc = false .
    17893   for each bf_doc-line no-lock where bf_doc-line.doc-code = t-doc.doc-code :
    17894       find first bf_goods no-lock where bf_goods.artic     = bf_doc-line.artic
    17895                                     and bf_goods.prod-type = bf_doc-line.prod-type
    17896                                     and bf_goods.prod-code = bf_doc-line.prod-code
    17897                                     no-error .
    17898       run gds-attr-value(
    17899         bf_goods.gds-code,
    17900         'alcohol-prod':U,
    17901         output par-alcohol,
    17902         output par-type
    17903       ).
    17904       if par-alcohol = "" or par-alcohol = "no" then next .
    17905       run gds-attr-value(
    17906         bf_goods.gds-code,
    17907         'mark':U,
    17908         output par-mark,
    17909         output par-type
    17910       ).
    17911       if par-mark = "" or par-mark = "no" then next .
    17912       v-is-alc = true .
    17913   end.
    17914   if not v-is-alc
    17915   then do :
    17916       message "В накладной нет ни одного товара, подлежащего маркировке. Импорт акцизных марок не возможен" view-as alert-box.
    17917       return .
    17918   end.
    17919   do transaction:
    17920       run str/imp-marks.p (parparentproc, t-doc.doc-code, "in") .
    17921   end.
    17922   END PROCEDURE.
    17923   PROCEDURE proc-shift-num :
    17924   define buffer bf_shift-obj   for ub.shift-obj.
    17925     if input frame d-in-doc t-doc.shift-num <> t-doc.shift-num then do:
    17926       if input frame d-in-doc t-doc.shift-date <> ? then do:
    17927         find first bf_shift-obj where bf_shift-obj.obj-type   = t-doc.obj-type                             and
    17928                                       bf_shift-obj.obj-code   = t-doc.obj-code                             and
    17929                                       bf_shift-obj.shift-date = input frame d-in-doc t-doc.shift-date and
    17930                                       bf_shift-obj.shift-num  = input frame d-in-doc t-doc.shift-num  no-lock no-error.
    17931         if not available bf_shift-obj then do:
    17932           message "Не найдена смена: " t-doc.obj-type " " t-doc.obj-code
    17933                   " Дата " input frame d-in-doc t-doc.shift-date " Порядок смены " input frame d-in-doc t-doc.shift-num " ."
    17934           view-as alert-box error.
    17935           display t-doc.shift-num with frame d-in-doc.
    17936           run proc-sht no-error.
    17937           if error-status:error then do:
    17938             return error.
    17939           end.
    17940         end.
    17941         else do:
    17942           assign
    17943             t-doc.shift-date = bf_shift-obj.shift-date
    17944             t-doc.shift-num  = bf_shift-obj.shift-num
    17945             t-doc.shift-name = bf_shift-obj.shift-name.
    17946           display t-doc.shift-date t-doc.shift-num t-doc.shift-name with frame d-in-doc.
    17947           if t-doc.fact-date = ? then do:
    17948             t-doc.fact-time = ? .
    17949             if bf_shift-obj.status_ = 'зкр':U
    17950             then do :
    17951               assign
    17952                 t-doc.fact-date = t-doc.shift-date
    17953               .
    17954               if t-doc.fact-date <> today
    17955               then
    17956                 t-doc.fact-time = if (time < (12 * 60 * 60)) then time else (12 * 60 * 60) .
    17957               display t-doc.fact-date with frame d-in-doc.
    17958             end.
    17959           end.
    17960         end.
    17961       end.
    17962     end.
    17963   end procedure.
    17964   procedure proc-shift-name :
    17965     define buffer bf_shift-obj   for ub.shift-obj.
    17966     define variable varfind-shift as integer initial 0.
    17967     define variable varshift-date like ub.shift-obj.shift-date no-undo.
    17968     define variable varshift-num  like ub.shift-obj.shift-num  no-undo.
    17969     if input frame d-in-doc t-doc.shift-name <> t-doc.shift-name then do:
    17970       if input frame d-in-doc t-doc.shift-date <> ? then do:
    17971         for each  bf_shift-obj where bf_shift-obj.obj-type   = t-doc.obj-type                             and
    17972                                      bf_shift-obj.obj-code   = t-doc.obj-code                             and
    17973                                      bf_shift-obj.shift-date = input frame d-in-doc t-doc.shift-date and
    17974                                      bf_shift-obj.shift-name = input frame d-in-doc t-doc.shift-name no-lock on error undo, return error return-value :
    17975           assign
    17976             varfind-shift = varfind-shift + 1
    17977             varshift-date = bf_shift-obj.shift-date
    17978             varshift-num  = bf_shift-obj.shift-num.
    17979         end.
    17980         if varfind-shift = 0 or varfind-shift > 1 then do:
    17981           if varfind-shift = 0 then do:
    17982             message "Не найдена смена: " t-doc.obj-type " " t-doc.obj-code
    17983                     " Дата " input frame d-in-doc t-doc.shift-date " Номер смены " input frame d-in-doc t-doc.shift-name " ."
    17984             view-as alert-box error.
    17985           end.
    17986           else do:
    17987             message "Найдено более одной смены с одним номером в сменном дне. Объект: " t-doc.obj-type " " t-doc.obj-code
    17988                     " Дата " input frame d-in-doc t-doc.shift-date " Номер смены " input frame d-in-doc t-doc.shift-name " ."
    17989             view-as alert-box error.
    17990           end.
    17991           display t-doc.shift-name with frame d-in-doc.
    17992           run proc-sht no-error.
    17993           if error-status:error then do: return error. end.
    17994         end.
    17995         else do:
    17996           assign frame d-in-doc
    17997             t-doc.shift-name.
    17998           assign
    17999             t-doc.shift-date = varshift-date
    18000             t-doc.shift-num  = varshift-num.
    18001           display t-doc.shift-date t-doc.shift-num t-doc.shift-name with frame d-in-doc.
    18002           if t-doc.fact-date = ? then do:
    18003             t-doc.fact-time = ? .
    18004             if bf_shift-obj.status_ = 'зкр':U
    18005             then do :
    18006               assign
    18007                 t-doc.fact-date = t-doc.shift-date
    18008               .
    18009               if t-doc.fact-date <> today
    18010               then
    18011                 t-doc.fact-time = if (time < (12 * 60 * 60)) then time else (12 * 60 * 60) .
    18012               display t-doc.fact-date with frame d-in-doc.
    18013             end.
    18014           end.
    18015         end.
    18016       end.
    18017     end.
    18018   end procedure.
    18019   define variable vss-include-info135 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    18020   procedure fact-bc:
    18021   define input parameter pardoc-code like ub.trn-doc.doc-code no-undo.
    18022   define variable g-log       as logical              no-undo.
    18023   define variable varnum      as integer              no-undo.
    18024   define variable varbar-code like ub.bar-code.b-code no-undo.
    18025   define variable varrecid    as   recid              no-undo.
    18026   define variable is-petrolium as logical no-undo.
    18027   define variable is-pieces    as logical no-undo.
    18028   define variable v-part-code  as character no-undo.
    18029   define variable v-alcohol-prod as logical no-undo .
    18030   define buffer bf_trn-doc  for ub.trn-doc.
    18031   define buffer bf_doc-line for ub.doc-line.
    18032   define buffer bf_gds-dtl  for ub.gds-dtl.
    18033   define buffer bf_goods    for ub.goods.
    18034   define buffer bf_gds-prt  for ub.gds-prt.
    18035   define buffer bf_units    for ub.units.
    18036   define buffer bf_parts    for ub.parts.
    18037   do on error undo, return error return-value :
    18038   find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code.
    18039   for each tt-bar-code-ne:
    18040     delete tt-bar-code-ne.
    18041   end.
    18042   assign
    18043     g-log = yes.
    18044   if bf_trn-doc.doc-qnty <> bf_trn-doc.fact-qnty and
    18045      bf_trn-doc.fact-qnty <> 0 then do:
    18046     message "Начать заполнять фактическое количество с нуля?" view-as alert-box question
    18047     buttons yes-no update g-log.
    18048   end.
    18049   for each bf_doc-line where bf_doc-line.doc-code = bf_trn-doc.doc-code no-lock by bf_doc-line.line-num :
    18050     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
    18051                               bf_goods.prod-type = bf_doc-line.prod-type and
    18052                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
    18053     for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_trn-doc.doc-code     and
    18054                               bf_gds-dtl.artic     = bf_goods.artic     and
    18055                               bf_gds-dtl.prod-type = bf_goods.prod-type and
    18056                               bf_gds-dtl.prod-code = bf_goods.prod-code
    18057                               no-lock :
    18058       find first bf_gds-prt where bf_gds-prt.node-code = bf_gds-dtl.prt-code no-lock.
    18059   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
    18060     (input  bf_goods.gds-code
    18061     ,input  bf_gds-prt.node-code
    18062     ,output varbar-code
    18063     )  .
    18064       assign
    18065         varnum = varnum + 1.
    18066       create tt-bar-code-ne.
    18067       assign
    18068        tt-bar-code-ne.nm             = varnum
    18069        tt-bar-code-ne.mark           = (if bf_gds-dtl.fact-qnty < bf_gds-dtl.doc-qnty then "<" else "")
    18070        tt-bar-code-ne.b-c            = varbar-code
    18071        tt-bar-code-ne.scn-qnty-doc   = bf_gds-dtl.doc-qnty
    18072        tt-bar-code-ne.scn-qnty-file  = (if g-log = yes then 0 else bf_gds-dtl.fact-qnty)
    18073        tt-bar-code-ne.mem-qnty       = tt-bar-code-ne.scn-qnty-file
    18074        tt-bar-code-ne.bef-qnty       = bf_gds-dtl.fact-qnty
    18075        tt-bar-code-ne.artic          = bf_goods.artic
    18076        tt-bar-code-ne.prod-type      = bf_goods.prod-type
    18077        tt-bar-code-ne.prod-code      = bf_goods.prod-code
    18078        tt-bar-code-ne.gds-name       = bf_goods.gds-name
    18079        tt-bar-code-ne.node-name      = (if bf_gds-prt.node-name = '_Пустая шкала':U then "--------------------" else bf_gds-prt.node-name)
    18080        tt-bar-code-ne.part-code      = ''
    18081        tt-bar-code-ne.in-code        = ''.
    18082     end.
    18083   end.
    18084   run str/scr-neb.w (input parparentproc, input-output table tt-bar-code-ne, input "in-doc", input yes, input v-cntxt-obj-type, input v-cntxt-obj-code).
    18085   for each bf_doc-line where bf_doc-line.doc-code = bf_trn-doc.doc-code no-lock by bf_doc-line.line-num :
    18086     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
    18087                               bf_goods.prod-type = bf_doc-line.prod-type and
    18088                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
    18089     for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_trn-doc.doc-code     and
    18090                               bf_gds-dtl.artic     = bf_goods.artic     and
    18091                               bf_gds-dtl.prod-type = bf_goods.prod-type and
    18092                               bf_gds-dtl.prod-code = bf_goods.prod-code
    18093                               no-lock on error undo, return error return-value :
    18094       find first bf_gds-prt where bf_gds-prt.node-code = bf_gds-dtl.prt-code no-lock.
    18095   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
    18096     (input  bf_goods.gds-code
    18097     ,input  bf_gds-prt.node-code
    18098     ,output varbar-code
    18099     )  .
    18100       find first tt-bar-code-ne where tt-bar-code-ne.b-c = varbar-code.
    18101       if tt-bar-code-ne.scn-qnty-file <> bf_gds-dtl.fact-qnty then do :
    18102         find bf_units where bf_units.unit-name = bf_goods.unit-base no-lock.
    18103         if lookup('сер':U, bf_units.type) > 0 then do:
    18104            message "В серийном товаре нельзя редактировать количество. Пропускаем.".
    18105            next.
    18106         end.
    18107         if tt-bar-code-ne.scn-qnty-file > bf_gds-dtl.doc-qnty then do:
    18108           message "По признаку " bf_gds-dtl.artic " "
    18109                   bf_gds-dtl.prod-type " "
    18110                   bf_gds-dtl.prod-code " "
    18111                   bf_gds-prt.f-name " "
    18112                   "количество факт уже больше чем по документу. Устанавливаем по документу."
    18113           view-as alert-box.
    18114           assign
    18115             tt-bar-code-ne.scn-qnty-file = bf_gds-dtl.doc-qnty.
    18116         end.
    18117         assign varrecid = recid(bf_doc-line).
    18118         if bf_trn-doc.doc-type = 'при':U and
    18119            bf_trn-doc.internal = no        then do:
    18120   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
    18121     (
    18122        input bf_goods.artic
    18123     ,  input bf_goods.prod-type
    18124     ,  input bf_goods.prod-code
    18125     , output is-petrolium
    18126     , output is-pieces
    18127     ) no-error.
    18128           if is-petrolium and not is-pieces then do:
    18129             MESSAGE "В жидком топливе нельзя редактировать фактическое количество" view-as alert-box.
    18130             next.
    18131           end.
    18132           assign
    18133             v-part-code = ?
    18134           .
    18135   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscdat in g#library
    18136     (input  bf_goods.gds-code
    18137     ,input  'alcohol-prod=request':u
    18138     ,output v-alcohol-prod
    18139     )  .
    18140           if v-alcohol-prod then do:
    18141             find first bf_parts no-lock
    18142               where bf_parts.obj-type  = bf_doc-line.obj-type  and
    18143                     bf_parts.obj-code  = bf_doc-line.obj-code  and
    18144                     bf_parts.prod-type = bf_doc-line.prod-type and
    18145                     bf_parts.prod-code = bf_doc-line.prod-code and
    18146                     bf_parts.artic     = bf_doc-line.artic     and
    18147                     bf_parts.out-code  = bf_doc-line.doc-code
    18148               no-error.
    18149             if available bf_parts then do:
    18150               assign
    18151                 v-part-code = bf_parts.part-code
    18152               .
    18153             end.
    18154           end.
    18155           run str/cor-line.p
    18156             (input parparentproc
    18157             ,input-output varrecid
    18158             ,input bf_doc-line.doc-code
    18159             ,input bf_doc-line.prod-type
    18160             ,input bf_doc-line.prod-code
    18161             ,input bf_doc-line.artic
    18162             ,input bf_doc-line.cli-qnty
    18163             ,input bf_doc-line.cli-base-rate
    18164             ,input tt-bar-code-ne.scn-qnty-file
    18165             ,input bf_doc-line.doc-qnty
    18166             ,input bf_doc-line.unit-cli
    18167             ,input bf_doc-line.vat-pc
    18168             ,input bf_doc-line.slt-pc
    18169             ,input bf_doc-line.price-cli
    18170             ,input bf_doc-line.price-base
    18171             ,input bf_doc-line.price-rubl
    18172             ,input bf_doc-line.new-price-sale
    18173             ,input bf_doc-line.num-place
    18174             ,input bf_doc-line.wt-brutto
    18175             ,input bf_doc-line.road-tax
    18176             ,input bf_doc-line.excise
    18177             ,input bf_doc-line.doc-density
    18178             ,input bf_doc-line.temperature
    18179             ,input ?
    18180             ,input ?
    18181             ,input ?
    18182             ,input bf_doc-line.fact-density
    18183             ,input ?
    18184             ,input no
    18185             ,input v-part-code
    18186             ,input ?
    18187             ,input ?
    18188             ,input ?
    18189             ,input ?
    18190             ,input ?
    18191             ,input ?
    18192             ,input ?
    18193             ,input ?
    18194             ) no-error.
    18195           if error-status :error then do:
    18196             return error return-value.
    18197           end.
    18198         end.
    18199         else do:
    18200           run str/out-add.p (parparentproc,
    18201                          recid(bf_trn-doc),
    18202                          recid(bf_doc-line),
    18203                          recid(bf_gds-dtl),
    18204                          recid(bf_goods),
    18205                          "ch-fact-qnty",
    18206                          tt-bar-code-ne.scn-qnty-file) no-error.
    18207           if error-status :error then do:
    18208             return error return-value.
    18209           end.
    18210         end.
    18211       end.
    18212     end.
    18213   end.
    18214   end.
    18215   end procedure.
    18216   procedure checkTypeByBarCode:
    18217     define input parameter iBarCode    as integer no-undo.
    18218     define input parameter iExtDocType as character no-undo.
    18219     define variable vValue as character no-undo.
    18220     define variable vType  as character no-undo.
    18221     define buffer buf_bar-code for ub.bar-code.
    18222     define buffer buf_goods    for ub.goods.
    18223     if iExtDocType = ? or
    18224        iExtDocType = 'ee':U or
    18225        iExtDocType = 'ie':U or
    18226        iExtDocType = 'iv':U or
    18227        iExtDocType = 'ev':U or
    18228        iExtDocType = 'we':U then
    18229         find buf_bar-code where buf_bar-code.b-code = iBarCode no-lock.
    18230         find buf_goods where buf_goods.gds-code = buf_bar-code.gds-code no-lock.
    18231         RUN gds-attr-value (
    18232            INPUT buf_goods.gds-code,
    18233            INPUT 'mark-type':U,
    18234            OUTPUT vValue,
    18235            OUTPUT vType
    18236         ).
    18237         if vValue <> "" then
    18238         do:
    18239           message
    18240             substitute("Товар: &1 &2", b-c, buf_goods.gds-name) skip
    18241             "нельзя добавлять в ручном режиме, так как он подлежит маркировке."
    18242             view-as alert-box error buttons ok.
    18243           return error.
    18244         end.
    18245   end procedure.
    18246   PROCEDURE proc-sht :
    18247   define buffer bf_shift-obj   for ub.shift-obj.
    18248     define variable varrid-list as character no-undo.
    18249     define variable varrecid    as recid     no-undo.
    18250     assign
    18251       varrid-list = "".
    18252     run str/sht-all.w (parparentproc, v-cntxt-obj-type, v-cntxt-obj-code, 'b-sel', 'obj', t-doc.obj-type, t-doc.obj-code ,'':u, input-output varrid-list) no-error .
    18253     if error-status:error or varrid-list = "":u then do:
    18254       return error.
    18255     end.
    18256     else do:
    18257       assign
    18258         varrecid = integer (entry(1, varrid-list)).
    18259       find first bf_shift-obj where recid(bf_shift-obj) = varrecid no-lock no-error.
    18260       if available bf_shift-obj then do:
    18261         assign
    18262           t-doc.shift-date = bf_shift-obj.shift-date
    18263           t-doc.shift-num  = bf_shift-obj.shift-num
    18264           t-doc.shift-name = bf_shift-obj.shift-name.
    18265         display t-doc.shift-date t-doc.shift-num t-doc.shift-name with frame d-in-doc.
    18266         if t-doc.fact-date = ? then do:
    18267           t-doc.fact-time = ? .
    18268           if bf_shift-obj.status_ = 'зкр':U
    18269           then do :
    18270             assign
    18271               t-doc.fact-date = t-doc.shift-date
    18272             .
    18273             if t-doc.fact-date <> today
    18274             then
    18275               t-doc.fact-time = if (time < (12 * 60 * 60)) then time else (12 * 60 * 60) .
    18276             display t-doc.fact-date with frame d-in-doc.
    18277           end.
    18278         end.
    18279       end.
    18280     end.
    18281   END PROCEDURE.
    18282   PROCEDURE r-proc-currency :
    18283   run ref/currency.w ( input parparentproc, input "b-sel", input-output ref-rec ).
    18284     if ref-rec = ? then do: return no-apply. end.
    18285     find ub.currency no-lock where recid( ub.currency ) = ref-rec no-error.
    18286     if not available ub.currency then do: return no-apply. end.
    18287     if ub.currency.curr-code <> t-doc.exch-code then do:
    18288       run check-update in this-procedure no-error.
    18289       if error-status :error then do: return no-apply. end.
    18290     end.
    18291     RUN exch-rate    in this-procedure.
    18292     RUN full-recount in this-procedure.
    18293   END PROCEDURE.
    18294   PROCEDURE select-reason :
    18295   define variable j-rsn-code like ub.trn-reason.reason-code no-undo.
    18296   define variable vDeleted as logical no-undo.
    18297     assign j-rsn-code = ( input frame d-in-doc t-doc.reason-code ).
    18298     run str/trn-reas.w ( input ParParentProc, input 'выбор':U, input-output j-rsn-code ).
    18299     find first ub.trn-reason no-lock where ub.trn-reason.reason-code = j-rsn-code no-error.
    18300     if available ub.trn-reason then do:
    18301       assign  rsn-name          = ub.trn-reason.reason-name
    18302               t-doc.reason-code = ub.trn-reason.reason-code.
    18303       display t-doc.reason-code rsn-name with frame d-in-doc.
    18304       if trn-type = 2 and t-doc.reason-code <> 99 then
    18305       do:
    18306   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-del in g#trdcalib (  input t-doc.doc-code ,
    18307                           input 'sugtpattr-massa-sug':U ,
    18308                          output vDeleted ) no-error .
    18309   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-del in g#trdcalib (  input t-doc.doc-code ,
    18310                           input 'sugtpattr-teh-loss':U ,
    18311                          output vDeleted ) no-error .
    18312   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-del in g#trdcalib (  input t-doc.doc-code ,
    18313                           input 'sugtpattr-err-allow':U ,
    18314                          output vDeleted ) no-error .
    18315       end.
    18316     end.
    18317   END PROCEDURE.
    18318   PROCEDURE ui-on :
    18319   define input parameter fnc as character no-undo.
    18320   define buffer d-l-b for  ub.doc-line.
    18321   define variable v-vat-pc        like  ub.doc-line.vat-pc    no-undo.
    18322   define variable v-slt-pc        like  ub.doc-line.slt-pc    no-undo.
    18323   define variable v-have-slt-pc   as logical              no-undo.
    18324   define variable v-host-code     like ub.sysconf.host-code  no-undo.
    18325   define variable varadd-back-date        as   logical               no-undo.
    18326   define buffer bf_contract for ub.contract.
    18327   assign
    18328     del-list = ""
    18329     loc-art  = ""
    18330   .
    18331   if lookup( fnc, "enable" ) > 0 then do:
    18332     assign
    18333       frame d-in-doc:title = t-doc.obj-type + " " + string (t-doc.obj-code, ">>>>9") +
    18334       " :   ПРИХОД - " + t-doc.status_ + " № " + t-doc.doc-code + "      - ".
    18335     assign frame d-in-doc :title = frame d-in-doc :title +
    18336       ( if parext-doc-mode = ""            then title-mode( pardoc-mode ) else ( caps( 'редакт-факт':U ) +
    18337       ( if parext-doc-mode = "reason-code" then " кода основания"         else "":U ) ) ).
    18338     disable all with frame d-in-doc.
    18339     if not is-add-doc then hide b-add-doc in frame d-in-doc .
    18340     else enable b-add-doc with frame d-in-doc .
    18341     find first ub.add-trn no-lock where ub.add-trn.trn-doc-code =  t-doc.doc-code no-error .
    18342     if available ub.add-trn then do:
    18343       enable b-add-doc-yes with frame d-in-doc .
    18344       display b-add-doc-yes with frame d-in-doc .
    18345     end.
    18346     else do:
    18347        hide b-add-doc-yes in frame d-in-doc .
    18348     end.
    18349     enable b-print b-exit b-help b-lkp br-dtl b-history a-n-c b-notes b-attr b-arch b-live b-cnt b-contr-lkp with frame d-in-doc.
    18350     hide loc-art in frame d-in-doc loc-name loc-code in frame d-in-doc.
    18351     assign ub.goods.gds-name:resizable in browse br-dtl = yes
    18352            ub.goods.gds-name:width-chars in browse br-dtl = 30  .
    18353             if t-doc.status_ <> 'накл':U then do:
    18354               assign
    18355                  ub.doc-line.cli-qnty  :read-only in browse br-dtl = yes
    18356                  ub.doc-line.fact-qnty :read-only in browse br-dtl = yes
    18357                  ub.doc-line.wt-brutto :read-only in browse br-dtl = yes
    18358                  ub.doc-line.num-place :read-only in browse br-dtl = yes
    18359               .
    18360             end.
    18361             else do:
    18362               if t-doc.flag_ = yes then do: assign  ub.doc-line.cli-qnty  :read-only in browse br-dtl = yes. end.
    18363                                     else do: assign  ub.doc-line.fact-qnty :read-only in browse br-dtl = yes. end.
    18364               if v-edit-fact-wayb
    18365                 then assign doc-line.fact-qnty :read-only in browse br-dtl = no.
    18366             end.
    18367             if isEgais
    18368               then doc-line.cli-qnty  :read-only in browse br-dtl = yes.
    18369     case pardoc-mode :
    18370       when 'ДОБАВЛЕНИЕ':U then do:
    18371            enable t-doc.cli-code t-doc.cli-type r-clients with frame d-in-doc.
    18372            enable b-marks with frame d-in-doc.
    18373       end.
    18374       when 'ПРОСМОТР':U then do:
    18375         if parext-doc-mode = "":U then do:
    18376               if br-handle = ? then hide b-prev b-next in frame d-in-doc .
    18377                                else enable b-prev b-next with frame d-in-doc.
    18378         end.
    18379         if  parext-doc-mode = "reason-code" then do:
    18380             enable r-reas t-doc.reason-code with frame d-in-doc.
    18381         end.
    18382         if prtvalue   = "yes" and v-cntxp-doc-prt = yes then do:
    18383            enable b-prt   with frame d-in-doc.
    18384         end.
    18385         enable b-parts with frame d-in-doc.
    18386             enable b-marks with frame d-in-doc.
    18387         assign
    18388            ub.doc-line.cli-qnty  :read-only in browse br-dtl = yes
    18389            ub.doc-line.fact-qnty :read-only in browse br-dtl = yes
    18390            ub.doc-line.wt-brutto :read-only in browse br-dtl = yes
    18391            ub.doc-line.num-place :read-only in browse br-dtl = yes
    18392         .
    18393         if parext-doc-mode = "vsd_corr-parts"
    18394         or parext-doc-mode = "vsd"
    18395         or parext-doc-mode = "corr-parts"
    18396         then do :
    18397           enable t-doc.cst-code with frame d-in-doc.
    18398         end .
    18399       end.
    18400       when 'ИЗМЕНЕНИЕ':U then do:
    18401         if not v-cntxp-inout-price and
    18402            not t-doc.flag_ then do:
    18403           do transaction on error   undo, return error return-value :
    18404              for each old-doc-line:
    18405                  delete old-doc-line.
    18406              end.
    18407              for each d-l-b where d-l-b.doc-code = t-doc.doc-code on error undo, return error return-value :
    18408                  create old-doc-line.
    18409                  buffer-copy d-l-b to old-doc-line.
    18410                  find ub.goods where ub.goods.artic     = d-l-b.artic     and
    18411                                   ub.goods.prod-type = d-l-b.prod-type and
    18412                                   ub.goods.prod-code = d-l-b.prod-code no-lock.
