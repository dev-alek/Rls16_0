    10386     find ub.clients where ub.clients.obj-code = input frame d-in-doc t-doc.cli-code
    10387                  and ub.clients.obj-type = input frame d-in-doc t-doc.cli-type no-error.
    10388     if not available ub.clients then do:
    10389       if input frame d-in-doc t-doc.cli-code <> ? and input t-doc.cli-type <> ? then
    10390         message "Неправильный код или тип контрагента.".
    10391       apply "entry" to t-doc.cli-code in frame d-in-doc.
    10392       return no-apply .
    10393     end.
    10394     run adm/shattri.p (
    10395         input "get":U
    10396         ,input t-doc.obj-type
    10397         ,input t-doc.obj-code
    10398         ,input 'petrol':U
    10399         ,input  "rvd-own-nb"
    10400         ,output v-tmp-char
    10401         ,output v-tmp-date
    10402         ,output v-tmp-decimal
    10403         ,output v-tmp-integer
    10404         ,output v-rvd-own-nb
    10405         ,output v-rvd-own-nb-type
    10406         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
    10407         ) no-error .
    10408     if error-status :error then v-rvd-own-nb = false .
    10409     if v-rvd-own-nb = false
    10410     then do :
    10411       find first ub.clients-attr no-lock where ub.clients-attr.obj-type = ub.clients.obj-type
    10412                                            and ub.clients-attr.obj-code = ub.clients.obj-code
    10413                                            and ub.clients-attr.attr-code = 'owner-code':U
    10414                                            no-error .
    10415       if available ub.clients-attr
    10416       and ub.clients-attr.attr-value > ""
    10417       then do :
    10418         if ub.clients-attr.attr-value = "орг" + string(t-doc.host-code)
    10419         then do :
    10420           message "Для данного поставщика документ может быть заполнен только в автоматическом режиме путем сканирования 2D кода. Просканируйте код с ТТН, при возникновении проблемы обратитесь в тех. поддержку".
    10421           run str/trnscanqr.w (parparentproc, t-doc.doc-code, "", this-procedure).
    10422           return no-apply .
    10423         end .
    10424       end .
    10425     end .
    10426   end .
    10427   run check-cli no-error.
    10428   if error-status :error then return no-apply.
    10429   run fill-mol in this-procedure.
    10430   if error-status :error then return no-apply.
    10431   end.
    10432   procedure check-cli :
