     3460                       or (not tt-place-sec.own-rvs and num-entries(buf_rvs-doc.rvs-code, "-") = 2)
     3461                       then do :
     3462                         assign
     3463                           v-doc-pl-avail = true
     3464                         .
     3465   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_crrvslin in g#lib-rvs ( input buf_rvs-doc.obj-type ,
     3466                         input buf_rvs-doc.obj-code ,
