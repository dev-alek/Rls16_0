    16058   procedure err-status :
    16059      message "Данное действие недопустимо в статусе: "
    16060              t-doc.status_ string( t-doc.flag_, "+/-":U ) "."
    16061      view-as alert-box error.
    16062   end procedure.
    16063   PROCEDURE create-record :
    16064   define  input parameter p-doc-code   like ub.trn-doc.doc-code    no-undo.
    16065     define  input parameter p-attr-code  like ub.doc-attr.attr-code  no-undo.
    16066     define  input parameter p-attr-value like ub.doc-attr.attr-value no-undo.
    16067     define output parameter p-exist      as   logical                no-undo.
    16068   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-xst in g#trdcalib (  input p-doc-code ,
    16069                           input p-attr-code ,
    16070                          output p-exist )  .
    16071     if p-exist = no then do:
    16072   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input p-doc-code ,
    16073                          input p-attr-code ,
    16074                          input p-attr-value ) no-error .
    16075       if error-status :error then do:
    16076         message error-status :error error-status :get-message( 1 ) '"' + p-attr-code + '"'
    16077         view-as alert-box error.
    16078       end.
    16079     end.
    16080   END PROCEDURE.
    16081   procedure set-cli-cust :
    16082     def input parameter p-clitype as char no-undo.
    16083     def input parameter p-clicode as int  no-undo.
    16084     define variable v-tmp-char like ub.thbj-attr.property-value-character no-undo .
    16085     define variable v-tmp-date      like ub.thbj-attr.property-value-date    no-undo .
    16086     define variable v-tmp-decimal   like ub.thbj-attr.property-value-decimal no-undo .
    16087     define variable v-tmp-integer   like ub.thbj-attr.property-value-integer no-undo .
    16088     define variable v-rvd-own-nb as logical no-undo .
    16089     define variable v-rvd-own-nb-type as   character no-undo .
    16090     find first clients where clients.obj-type = p-clitype and clients.obj-code = p-clicode no-lock no-error.
    16091     if not available (clients)
    16092     then do:
    16093       return error "Не найден клиент - " + p-clitype + string(p-clicode).
    16094     end.
    16095     disp clients.obj-code @ t-doc.cli-code
    16096             clients.obj-name with frame d-in-doc.
    16097     disp clients.obj-type @ t-doc.cli-type with frame d-in-doc.
    16098     run adm/shattri.p (
    16099         input "get":U
    16100         ,input t-doc.obj-type
    16101         ,input t-doc.obj-code
    16102         ,input 'petrol':U
    16103         ,input  "rvd-own-nb"
    16104         ,output v-tmp-char
    16105         ,output v-tmp-date
    16106         ,output v-tmp-decimal
    16107         ,output v-tmp-integer
    16108         ,output v-rvd-own-nb
    16109         ,output v-rvd-own-nb-type
    16110         ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
    16111         ) no-error .
    16112     if error-status :error then v-rvd-own-nb = false .
    16113     if v-rvd-own-nb = false
    16114     and t-doc.cli-code > 0
    16115     then do :
    16116       find first ub.clients-attr no-lock where ub.clients-attr.obj-type = t-doc.cli-type
    16117                                            and ub.clients-attr.obj-code = t-doc.cli-code
    16118                                            and ub.clients-attr.attr-code = 'owner-code':U
    16119                                            no-error .
    16120       if available ub.clients-attr
    16121       and ub.clients-attr.attr-value > ""
    16122       then do :
    16123         if ub.clients-attr.attr-value = "орг" + string(t-doc.host-code)
    16124         then do :
    16125           v-can-edit = no .
    16126           disable b-add b-del with frame d-in-doc.
    16127         end .
    16128       end .
    16129     end .
    16130         run check-cli no-error.
    16131         if error-status :error then return no-apply.
    16132     run fill-mol in this-procedure no-error .
    16133   end.
    16134   procedure cycle-add-cust :
    16135     def input parameter p-recgds-list as character no-undo.
    16136     v-modeetc = ",autotrnqr2d".
    16137     varnotes = p-recgds-list.
    16138     run cycle-add in this-procedure.
    16139     run ui-on in this-procedure ( input "line" ).
    16140   end.
    16141   PROCEDURE cycle-add :
    16142   define buffer bf_goods  for ub.goods.
    16143   define buffer bf_pl-gds for ub.pl-gds.
    16144   define variable varis-petrolium as logical no-undo.
    16145   define variable varis-pieces    as logical no-undo.
    16146   define variable varext-cycle    as logical no-undo.
    16147   define variable v-is-petrol     as logical no-undo.
    16148   define variable v-is-pieces     as logical no-undo.
    16149   define variable v-log           as logical no-undo.
    16150   define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
    16151   assign
    16152     varlns-cnt = 1.
    16153   cycle:
    16154   do while varlns-cnt <= num-entries (varnotes):
    16155     def var varvalue as character no-undo.
    16156     def var vartype as character no-undo.
    16157     assign  gds-rec = integer (entry (varlns-cnt, varnotes)).
    16158     if t-doc.purch-code = 3 then do:
    16159       find first bf_goods where recid(bf_goods) = gds-rec no-lock.
    16160       find first bf_pl-gds where bf_pl-gds.gds-code = bf_goods.gds-code and
    16161                                  bf_pl-gds.obj-type = t-doc.obj-type    and
    16162                                  bf_pl-gds.obj-code = t-doc.obj-code    no-lock no-error.
    16163       if available bf_pl-gds then do:
    16164         message "Товар:" bf_goods.artic " " bf_goods.prod-type " " bf_goods.prod-code " " bf_goods.gds-name " резервируется по складским местам." skip
    16165                 "Его нельзя приходовать на ответственное хранение."
    16166         view-as alert-box error.
    16167         assign varlns-cnt = varlns-cnt + 1.
    16168         next.
    16169       end.
    16170     end.
    16171     if vartpsi = "yes":u then do:
    16172       find first bf_goods where recid(bf_goods) = gds-rec no-lock.
    16173   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_igdstpsi in g#lib-trn3
    16174   (input bf_goods.gds-code
    16175   ,input t-doc.obj-type
    16176   ,input t-doc.obj-code
    16177   ) no-error.
    16178       if error-status :error then do:
    16179         message return-value
    16180         view-as alert-box.
    16181         ASSIGN varlns-cnt = varlns-cnt + 1.
    16182         next.
    16183       end.
    16184     end.
    16185     varvalue = "" .
    16186     find first bf_goods where recid(bf_goods) = gds-rec no-lock.
    16187     run gds-attr-value in this-procedure
    16188       (  input bf_goods.gds-code
    16189       ,  input 'fuel-type':U
    16190       , output varvalue
    16191       , output vartype
    16192       ) no-error .
    16193     if varvalue = "metan"
    16194     then do:
    16195       message "Товар:" bf_goods.artic " " bf_goods.prod-type " " bf_goods.prod-code " " bf_goods.gds-name " " skip
    16196               "нельзя приходовать в ручном режиме."
    16197       view-as alert-box error.
    16198       assign varlns-cnt = varlns-cnt + 1.
    16199       next.
    16200     end.
    16201     if trn-type = 4
    16202     then do:
    16203       run gds-attr-value in this-procedure
    16204         (  input bf_goods.gds-code
    16205           ,input 'fuel-type':U
    16206           ,output varvalue
    16207           ,output vartype
    16208          ) .
    16209       if varvalue = "lgas" and not (trn-type = 2 or trn-type = 3)then
    16210       do:
    16211         message "Товар СУГ:" bf_goods.artic " " bf_goods.prod-type " " bf_goods.prod-code " " bf_goods.gds-name " " skip
    16212                 'нельзя приходовать в накладной типа "ТНП" или "Топливо".'
    16213         view-as alert-box error.
    16214         assign varlns-cnt = varlns-cnt + 1.
    16215         next.
    16216       end.
    16217       if varvalue = "petrol" and not (trn-type = 1)then
    16218       do:
    16219         message "Топливный товар:" bf_goods.artic " " bf_goods.prod-type " " bf_goods.prod-code " " bf_goods.gds-name " " skip
    16220                 'нельзя приходовать в накладной типа "ТНП" или "СУГ".'
    16221         view-as alert-box error.
    16222         assign varlns-cnt = varlns-cnt + 1.
    16223         next.
    16224       end.
    16225     end.
    16226     varvalue = "" .
    16227     EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(t-doc.obj-type, t-doc.obj-code).
    16228     RUN gds-attr-value (
    16229                         INPUT bf_goods.gds-code,
    16230                         INPUT 'mark-type':U,
    16231                         OUTPUT varvalue,
    16232                         OUTPUT vartype
    16233                         ).
    16234     if varvalue > "" then do:
    16235      if EDOParSec:GetIsMarkingForType(varvalue)
    16236     then do :
    16237         if  t-doc.ext-doc-type = 'ie':U then
    16238         do:
    16239             message "Товар:" bf_goods.artic " " bf_goods.prod-type " " bf_goods.prod-code " " bf_goods.gds-name " " skip
    16240                 "нельзя добавлять в ручном режиме, так как он подлежит маркировке."
    16241                 view-as alert-box error.
    16242             assign
    16243                 varlns-cnt = varlns-cnt + 1.
    16244             next.
    16245         end.
    16246         else
    16247         do:
    16248             message "Товар:" bf_goods.artic " " bf_goods.prod-type " " bf_goods.prod-code " " bf_goods.gds-name " " skip
    16249                 "нельзя добавлять в ручном режиме, так как он подлежит маркировке и должен добавляться помарочно."
    16250                 view-as alert-box error.
    16251             assign
    16252                 varlns-cnt = varlns-cnt + 1.
    16253             next.
    16254         end.
    16255     end .
    16256      if  EDOParSec:IsEdo
    16257      and (EDOParSec:GetIsArticForType(varvalue) or EDOParSec:GetIsEdoForType(varvalue))
    16258     then do :
    16259         if  t-doc.ext-doc-type = 'ie':U then
    16260         do:
    16261             message "Товар:" bf_goods.artic " " bf_goods.prod-type " " bf_goods.prod-code " " bf_goods.gds-name " " skip
    16262                 "нельзя добавлять в ручном режиме, так как он подлежит маркировке."
    16263                 view-as alert-box error.
    16264             assign
    16265                 varlns-cnt = varlns-cnt + 1.
    16266             next.
    16267         end.
    16268     end .
    16269     end.
    16270     if can-find (FIRST ub.clients-attr no-lock where (ub.clients-attr.attr-code = 'supp-np':U or ub.clients-attr.attr-code = 'supp-lgas':U)
    16271                                                  and ub.clients-attr.attr-value = "yes")
    16272     then do :
    16273   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
    16274     (
    16275        input bf_goods.artic
    16276     ,  input bf_goods.prod-type
    16277     ,  input bf_goods.prod-code
    16278     , output v-is-petrol
    16279     , output v-is-pieces
    16280     ) no-error.
    16281       if v-is-petrol then do :
    16282         if not can-find (FIRST ub.clients-attr no-lock where ub.clients-attr.obj-type   = t-doc.cli-type
    16283                                                           and ub.clients-attr.obj-code   = t-doc.cli-code
    16284                                                           and
    16285                                                             (ub.clients-attr.attr-code  = 'supp-np':U
    16286                                                             or ub.clients-attr.attr-code  = 'supp-lgas':U
    16287                                                             )
    16288                                                           and ub.clients-attr.attr-value = "yes")
    16289         then do :
    16290           message
    16291           "Контрагент документа не является поставщиком НП или СУГ." skip
    16292           "Продолжить ввод товара?"
    16293           view-as alert-box question buttons yes-no update v-log.
    16294           if not v-log then leave cycle.
    16295         end.
    16296       end.
    16297     end.
    16298     assign
    16299       pardoc-rec = recid(t-doc).
    16300     run str/in-line.w (input  parparentproc,
    16301                        input  ((if varlns-cnt > 1 then "ЦИКЛ":U else 'ДОБАВЛЕНИЕ':U) + v-modeetc),
    16302                        input  pardoc-rec,
    16303                        input-output line-rec,
    16304                        input  gds-rec,
    16305                        input  varlns-cnt,
    16306                        output varext-cycle,
    16307                        0,
    16308                        ?,
    16309                        varinplnsum) no-error.
    16310     if varext-cycle = yes then do:
    16311       leave cycle.
    16312     end.
    16313     find t-doc where recid(t-doc) = pardoc-rec.
    16314     ASSIGN varlns-cnt = varlns-cnt + 1.
    16315   end.
    16316   END PROCEDURE.
    16317   PROCEDURE del-doc-line :
    16318   define variable rep-rec as recid no-undo.
    16319   do transaction on error undo, return error return-value :
    16320   if del-list = "" then do:
    16321     if not available  ub.doc-line then do:
    16322       message "Неправильный выбор строки.".
    16323       return error.
    16324     end.
    16325     varlog = no.
    16326     message "Удалить строку накладной ?   Вы уверены ?"
    16327                   view-as alert-box question buttons OK-Cancel update varlog.
    16328     if NOT varlog then return error.
    16329     line-rec = recid ( ub.doc-line).
    16330     del-list = string (recid ( ub.doc-line)).
    16331     get next br-dtl.
    16332     if available  ub.doc-line then rep-rec = recid ( ub.doc-line).
    16333     else do:
    16334       reposition br-dtl to recid line-rec no-error.
    16335       get prev br-dtl.
    16336       rep-rec = recid ( ub.doc-line).
    16337     end.
    16338   end.
    16339   else do:
    16340     varlog = ?.
    16341     message "УДАЛЕНИЕ  ПО  ОТМЕТКАМ  строк накладной ?" skip (2)
    16342             "YES - удалить все отмеченные строки" skip
    16343             "NO - оставить только отмеченные строки и удалить все остальные" skip (2)
    16344             "CANCEL - ничего не удалять"
    16345     view-as alert-box question buttons yes-no-cancel update varlog.
    16346     if varlog = ? then return error.
    16347     rep-rec = ?.
    16348   end.
    16349   if varlog then do:
    16350     assign
    16351       varlns-cnt = 1.
    16352     do while varlns-cnt <= num-entries (del-list):
    16353       assign
    16354         line-rec   = integer (entry (varlns-cnt, del-list))
    16355         varlns-cnt = varlns-cnt + 1.
    16356       find  ub.doc-line where recid ( ub.doc-line) = line-rec exclusive.
    16357       if  ub.doc-line.doc-code <> t-doc.doc-code then undo, return error.
    16358       if t-doc.flag_ and  ub.doc-line.doc-qnty <> 0 then do:
    16359         message "Нельзя удалить строку, которая была добавлена в открытый документ.  Артикул:"  ub.doc-line.artic.
    16360         next.
    16361       end.
    16362   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_clcintrn in g#lib-trn
    16363     (
    16364      input parparentproc
    16365     ,input ?
    16366     ,input ub.doc-line.doc-code
    16367     ,input ub.doc-line.artic
    16368     ,input ub.doc-line.prod-type
    16369     ,input ub.doc-line.prod-code
    16370     ,input ub.doc-line.price-cli
    16371     ,input ub.doc-line.price-rubl
    16372     ,input ub.doc-line.price-base
    16373     ,input ub.doc-line.cli-qnty
    16374     ,input ub.doc-line.cli-base-rate
    16375     ,input ub.doc-line.fact-qnty
    16376     ,input ub.doc-line.doc-qnty
    16377     ,input ub.doc-line.vat-pc
    16378     ,input ub.doc-line.slt-pc
    16379     ,input ub.doc-line.road-tax
    16380     ,input ub.doc-line.excise
    16381     ,input ub.doc-line.transport-rubl
    16382     ,input ub.doc-line.other-rubl
    16383     ,input 'delete'
    16384     ,input ''
    16385     ) no-error.
    16386       if error-status :error then do:
    16387         undo, return error return-value.
    16388       end.
    16389       delete  ub.doc-line.
    16390     end.
    16391   end.
    16392   else do:
    16393     for each  ub.doc-line where  ub.doc-line.doc-code = t-doc.doc-code:
    16394       if can-do (del-list, string (recid ( ub.doc-line))) then next.
    16395       if t-doc.flag_ and  ub.doc-line.doc-qnty <> 0 then do:
    16396         message "Нельзя удалить строку, которая была добавлена в открытый документ.  Артикул:"  ub.doc-line.artic.
    16397         next.
    16398       end.
    16399   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_clcintrn in g#lib-trn
    16400     (
    16401      input parparentproc
    16402     ,input ?
    16403     ,input ub.doc-line.doc-code
    16404     ,input ub.doc-line.artic
    16405     ,input ub.doc-line.prod-type
    16406     ,input ub.doc-line.prod-code
    16407     ,input ub.doc-line.price-cli
    16408     ,input ub.doc-line.price-rubl
    16409     ,input ub.doc-line.price-base
    16410     ,input ub.doc-line.cli-qnty
    16411     ,input ub.doc-line.cli-base-rate
    16412     ,input ub.doc-line.fact-qnty
    16413     ,input ub.doc-line.doc-qnty
    16414     ,input ub.doc-line.vat-pc
    16415     ,input ub.doc-line.slt-pc
    16416     ,input ub.doc-line.road-tax
    16417     ,input ub.doc-line.excise
    16418     ,input ub.doc-line.transport-rubl
    16419     ,input ub.doc-line.other-rubl
    16420     ,input 'delete'
    16421     ,input ''
    16422     ) no-error.
    16423       if error-status :error then do:
    16424         undo, return error return-value.
    16425       end.
    16426       delete  ub.doc-line.
    16427     end.
    16428   end.
    16429   assign
    16430     line-rec = rep-rec.
    16431   if available t-doc
    16432   then do:
    16433     run gbl/calc-trn.p
    16434       ( input parparentproc
    16435       , input recid( t-doc )
    16436       ) no-error .
    16437     if error-status :error
    16438     then do:
    16439       message return-value skip
    16440               error-status :get-message( 1 )
    16441       view-as alert-box error .
    16442       undo, return error .
    16443     end.
    16444   end.
    16445   run ui-on in this-procedure ( input "line" ).
    16446   end.
    16447   END PROCEDURE.
    16448   PROCEDURE disable_UI :
    16449     HIDE FRAME d-in-doc.
    16450   END PROCEDURE.
    16451   PROCEDURE disp-exch :
    16452   display
    16453    t-doc.exch-rate
    16454    t-doc.exch-scale
    16455    t-doc.base-rate
    16456    t-doc.base-scale
    16457    with frame d-in-doc.
    16458   end procedure.
    16459   procedure fnd-an-doc :
    16460   find t-d-b where t-d-b.doc-code = input frame d-in-doc t-doc.out-code no-lock no-error.
    16461   if not available t-d-b then return error.
    16462   end procedure.
    16463   procedure disp-import :
    16464   define input parameter pardoc-code like ub.trn-doc.doc-code no-undo.
    16465   APPLY "row-leave" to BROWSE br-dtl.
    16466   DISPLAY pardoc-code @ t-doc.out-code WITH FRAME d-in-doc.
    16467   APPLY "RETURN" to t-doc.out-code IN FRAME d-in-doc.
    16468   end procedure.
    16469   PROCEDURE enable_UI :
    16470     DISPLAY varcontract-prn-code varpurch-code-name ov-pc m-inc a-n-c loc-art
    16471             loc-name loc-code varinplnsum wrkr-name agnt-name boss-name rsn-name
    16472         WITH FRAME d-in-doc.
