    19009            then do:
    19010              assign
    19011                buf_doc-line.cli-qnty = decimal(  ub.doc-line.cli-qnty :screen-value in browse br-dtl )
    19012              .
    19013            end.
    19014            find first buf_doc-line        no-lock where
    19015                recid( buf_doc-line ) = recid(  ub.doc-line ) .
    19016          end.
    19017          run ui-on in this-procedure
    19018            ( input "line"
    19019            ) .
    19020       end.
    19021     end.
    19022   end.
    19023   END PROCEDURE.
    19024   PROCEDURE update-rate-doc :
    19025   if input frame d-in-doc t-doc.exch-rate  <> t-doc.exch-rate  or
    19026      input frame d-in-doc t-doc.exch-scale <> t-doc.exch-scale or
    19027      input frame d-in-doc t-doc.base-rate  <> t-doc.base-rate  or
    19028      input frame d-in-doc t-doc.base-scale <> t-doc.base-scale then
    19029      do transaction on error undo, return error return-value :
    19030        run check-exch   in this-procedure no-error.
    19031        if error-status :error then do: return error return-value. end.
    19032        run check-update in this-procedure no-error.
    19033        if error-status :error then do: return error return-value. end.
    19034        run check-rate   in this-procedure no-error.
    19035        if error-status :error then do: return error return-value. end.
    19036       end.
    19037       run UI-on in this-procedure ( input "line" ).
    19038   END PROCEDURE.
    19039   PROCEDURE val-ch-slt-type :
    19040   define buffer d-l-b for  ub.doc-line.
    19041   define buffer bf-goods for ub.goods.
    19042   define variable old-slt         like ub.trn-doc.slt-type .
    19043   define variable v-slt-pc        like ub.doc-line.slt-pc    no-undo.
    19044   define variable v-host-code     like ub.sysconf.host-code  no-undo.
    19045   do transaction on error undo, return error return-value :
    19046     run check-update in this-procedure no-error.
    19047     if error-status :error then do: return error. end.
    19048   define variable vss-include-info144 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    19049   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
    19050     (input  t-doc.obj-type
    19051     ,input  t-doc.obj-code
    19052     ,output v-host-code
    19053     )  .
    19054     assign old-slt = t-doc.slt-type.
    19055     assign frame d-in-doc t-doc.SLT-type.
    19056     find first d-l-b where d-l-b.doc-code = t-doc.doc-code no-lock no-error.
    19057     if available d-l-b then do:
    19058        if t-doc.slt-type = 'без':U and
    19059           old-slt <> 'без':U then do:
    19060           message "Налог с продаж в строках устанавливаем в 0" view-as alert-box information.
    19061           for each d-l-b where d-l-b.doc-code = t-doc.doc-code:
    19062               assign d-l-b.slt-pc = 0.
    19063           end.
    19064        end.
    19065        else if t-doc.slt-type <> 'без':U and
    19066                old-slt = 'без':U then do:
    19067           message "Налог с продаж в строках устанавливаем из товара" view-as alert-box information.
    19068           for each d-l-b where d-l-b.doc-code = t-doc.doc-code,
    19069                    first bf-goods where bf-goods.artic     = d-l-b.artic and
    19070                                         bf-goods.prod-type = d-l-b.prod-type and
    19071                                         bf-goods.prod-code = d-l-b.prod-code:
    19072   define variable vss-include-info145 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    19073   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
    19074     (input  bf-goods.gds-code
    19075     ,input  '2':U
    19076     ,input  ?
    19077     ,input  v-host-code
    19078     ,input  t-doc.obj-type
    19079     ,input  t-doc.obj-code
    19080     ,output v-slt-pc
    19081     ) no-error .
    19082               assign d-l-b.slt-pc = v-slt-pc.
    19083           end.
    19084        end.
    19085        run check-rate   in this-procedure no-error.
    19086        if error-status :error then do: undo, return error. end.
    19087        run full-recount in this-procedure no-error.
    19088        if error-status :error then do: undo, return error. end.
    19089     end.
    19090   end.
    19091   run UI-on in this-procedure ( input "line" ).
    19092   END PROCEDURE.
    19093   PROCEDURE val-ch-type :
    19094   define input parameter parself-name as character no-undo.
    19095   if parself-name = "slt-type" then do: run val-ch-slt-type in this-procedure no-error. end.
    19096   else do:
    19097      if parself-name = "vat-type" then do: run val-ch-vat-type in this-procedure no-error. end.
    19098                                   else do:
    19099                                      message "Неверный self:name " parself-name
    19100                                              " при передаче в процедуру val-ch-type."
    19101                                      view-as alert-box error.
    19102                                      return error.
    19103                                   end.
    19104   end.
    19105   if error-status :error then do:
    19106         display t-doc.vat-type with frame d-in-doc.
    19107         display t-doc.slt-type with frame d-in-doc.
    19108         return no-apply.
    19109   end.
    19110   END PROCEDURE.
    19111   PROCEDURE val-ch-vat-type :
    19112   define buffer d-l-b for  ub.doc-line.
    19113   define variable old-vat as character no-undo.
    19114   define variable vd-price-cli   like ub.doc-line.price-cli  no-undo.
    19115   define variable vd-price-base  like ub.doc-line.price-base no-undo.
    19116   define variable vd-price-rubl  like ub.doc-line.price-rubl no-undo.
    19117   define variable vd-vat-pc      like ub.doc-line.vat-pc     no-undo.
    19118   define variable vd-slt-pc      like ub.doc-line.slt-pc     no-undo.
    19119   define variable vd-road-tax    like ub.doc-line.road-tax   no-undo.
    19120   define variable vd-excise      like ub.doc-line.excise     no-undo.
    19121   define buffer bf-goods for ub.goods.
    19122   run check-update in this-procedure no-error.
    19123    if error-status :error then do: return error. end.
    19124   do transaction on error   undo, return error
    19125                  on end-key undo, return error
    19126                  on stop    undo, return error :
    19127     assign
    19128       old-vat = t-doc.vat-type.
    19129     ASSIGN frame d-in-doc t-doc.VAT-type.
    19130     if t-doc.vat-type  = 'без':U and
    19131        old-vat        <> 'без':U then do:
    19132         message "НДС в строках устанавливаем в 0" view-as alert-box information.
    19133         for each d-l-b where d-l-b.doc-code = t-doc.doc-code:
    19134             assign d-l-b.vat-pc = 0.
    19135         end.
    19136     end.
    19137     else do:
    19138       if t-doc.vat-type <> 'без':U and
    19139              old-vat = 'без':U then do:
    19140         message "НДС в строках устанавливаем из последней поставки поставщика по данному товару. Если таковой не имеется, то из карточки товара." view-as alert-box information.
    19141         for each d-l-b where d-l-b.doc-code = t-doc.doc-code,
    19142                  first bf-goods where bf-goods.artic     = d-l-b.artic and
    19143                                       bf-goods.prod-type = d-l-b.prod-type and
    19144                                       bf-goods.prod-code = d-l-b.prod-code:
    19145           assign
    19146             vd-vat-pc = ?.
    19147           run cpprclig in this-procedure   (
    19148             input        t-doc.doc-code             ,
    19149             input        t-doc.cli-code             ,
    19150             input        t-doc.cli-type             ,
    19151             input        t-doc.host-code            ,
    19152             input        t-doc.base-rate            ,
    19153             input        t-doc.base-scale           ,
    19154             input        t-doc.exch-rate            ,
    19155             input        t-doc.exch-scale           ,
    19156             input        t-doc.vat-type             ,
    19157             input        t-doc.slt-type             ,
    19158             input        d-l-b.artic                ,
    19159             input        d-l-b.prod-type            ,
    19160             input        d-l-b.prod-code            ,
    19161             input        yes                        ,
    19162             input        d-l-b.cli-base-rate        ,
    19163             input        d-l-b.transport-rubl       ,
    19164             input        d-l-b.other-rubl           ,
    19165             output       vd-price-cli               ,
    19166             output       vd-price-base              ,
    19167             output       vd-price-rubl              ,
    19168             input-output vd-vat-pc                  ,
    19169             input-output vd-slt-pc                  ,
    19170             input-output vd-road-tax                ,
    19171             input-output vd-excise                  ) no-error.
    19172             if vd-vat-pc = ? then do:
    19173   define variable vss-include-info146 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    19174   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
    19175     (input  bf-goods.gds-code
    19176     ,input  '1':U
    19177     ,input  ?
    19178     ,input  t-doc.host-code
    19179     ,input  t-doc.obj-type
    19180     ,input  t-doc.obj-code
    19181     ,output vd-vat-pc
    19182     ) no-error .
    19183               if vd-vat-pc = ? then do:
    19184                 message "Нет НДС в карточке товара по товару: " d-l-b.artic " " d-l-b.prod-type " " d-l-b.prod-code "." skip
    19185                         "НДС остается равным 0." view-as alert-box.
    19186               end.
    19187             end.
    19188             assign d-l-b.vat-pc = vd-vat-pc.
    19189         end.
    19190       end.
    19191     end.
    19192     run check-rate in this-procedure no-error.
    19193     if error-status :error then do: undo, return error. end.
    19194     run full-recount in this-procedure no-error.
    19195     if error-status :error then do: undo, return error. end.
    19196   end.
    19197   run UI-on in this-procedure ( input "line" ).
    19198   END PROCEDURE.
    19199   PROCEDURE vc-purch-code :
    19200   define variable varpurch-int-code like ub.trn-doc.purch-code no-undo.
    19201     assign
    19202       varpurch-int-code = lookup( input frame d-in-doc varpurch-code-name, 'выкуп,консигнация,ответственное хранение,старая консигнация':U ).
    19203     if t-doc.purch-code <> varpurch-int-code then do:
    19204       run chg-purch-code in this-procedure ( input varpurch-int-code ) no-error.
    19205       if error-status :error then do:
    19206         message "Ошибка при смене кода приобретения." skip
    19207                 return-value skip
    19208                 error-status :get-message( 1 )
    19209                 error-status :get-message( 2 )
    19210         view-as alert-box error.
    19211         display varpurch-code-name with frame d-in-doc.
    19212       end.
    19213           assign
    19214         varpurch-code-name = entry (lookup (string(t-doc.purch-code), '1,2,3,4':U), 'выкуп,консигнация,ответственное хранение,старая консигнация':U).
    19215       display varpurch-code-name with frame d-in-doc.
    19216     end.
    19217   END PROCEDURE.
    19218   procedure chg-purch-contract :
    19219     define buffer bf_contract for ub.contract.
    19220     do on error undo, return error return-value :
    19221       define variable v-purch-code as character no-undo .
    19222   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_purchcon in g#lib-trn3
    19223   ( input t-doc.host-code
    19224   , input t-doc.contract-code
    19225   , output v-purch-code
    19226   , output varpurch-code-name
    19227   ) .
    19228       display varpurch-code-name with frame d-in-doc.
    19229       run vc-purch-code in this-procedure no-error.
    19230       if error-status :error then do:
    19231         return error return-value.
    19232       end.
    19233     end.
    19234   end procedure.
    19235   PROCEDURE wr-cst-code :
    19236   define variable v-num as integer no-undo.
    19237   define buffer cst-parts for ub.parts.
    19238   define buffer buf_doc-line for  ub.doc-line.
    19239   do on error undo, return error return-value :
    19240     if can-find(first cst-parts where cst-parts.out-code = t-doc.doc-code no-lock) then do:
    19241       run gbl/d-askw.w ("Замена номера ГТД в партиях документа",
    19242                     "Изменить номера ГТД в партиях документа?",
    19243                     "|^",
    19244                     "Все партии|Тот же № ГТД|Отмена",
    19245                     "Проходим по всем партиям документа и заменяем номер ГТД|Идем по партиям, где номер был "
    19246                     + "'" + t-doc.cst-code + "'" + "|Ничего не делаем",
    19247                     2,
    19248                     3,
    19249                     output v-num
    19250                    ).
    19251       case v-num:
    19252       when 3 then do:
    19253         display t-doc.cst-code with frame d-in-doc.
    19254         return.
    19255       end.
    19256       when 2 then do:
    19257         if v-is-gtd-part = "yes" then do:
    19258           for each cst-parts where cst-parts.obj-type = t-doc.obj-type and                                     cst-parts.obj-code = t-doc.obj-code and                                     cst-parts.out-code = t-doc.doc-code and                                     cst-parts.cst-code begins t-doc.cst-code:
    19259             if LENGTH( input frame d-in-doc t-doc.cst-code ) > 0 then do:
    19260               if SUBSTRING( cst-parts.cst-code, LENGTH( t-doc.cst-code ) + 1 ,1 ) = '/' or cst-parts.cst-code = t-doc.cst-code then
    19261                 assign cst-parts.cst-code = input frame d-in-doc t-doc.cst-code + SUBSTRING( cst-parts.cst-code, LENGTH( t-doc.cst-code ) + 1 )  .
    19262             end.
    19263             else assign cst-parts.cst-code = "" .
    19264           end.
    19265         end.
    19266         else do:
    19267           for each cst-parts where cst-parts.obj-type = t-doc.obj-type and                                     cst-parts.obj-code = t-doc.obj-code and                                     cst-parts.out-code = t-doc.doc-code and                                     cst-parts.cst-code = t-doc.cst-code:
    19268             assign cst-parts.cst-code = input frame d-in-doc t-doc.cst-code.
    19269           end.
    19270         end.
    19271       end.
    19272       when 1 then do:
    19273         for each cst-parts where cst-parts.obj-type = t-doc.obj-type and                                     cst-parts.obj-code = t-doc.obj-code and                                     cst-parts.out-code = t-doc.doc-code:
    19274            assign cst-parts.cst-code = input frame d-in-doc t-doc.cst-code.
    19275         end.
    19276       end.
    19277       end case.
    19278     end.
    19279     assign t-doc.cst-code = input frame d-in-doc t-doc.cst-code.
    19280   end.
    19281     if v-is-gtd-part = "yes" then run UI-on in this-procedure ( input "line" ) .
    19282   END PROCEDURE.
    19283   procedure check-contract-code :
    19284   define input  parameter parmode           as   character                     no-undo.
    19285   define input  parameter parhost-code      like ub.trn-doc.host-code          no-undo.
    19286   define input  parameter parcli-type       like ub.trn-doc.cli-type           no-undo.
    19287   define input  parameter parcli-code       like ub.trn-doc.cli-code           no-undo.
    19288   define input  parameter parframe-value    as   character                     no-undo.
    19289   define input  parameter parmenu-handle    as   handle                        no-undo.
    19290   define input  parameter parobj-date       as   date                          no-undo.
    19291   define input  parameter partype-contract  as   character                     no-undo .
    19292   define output parameter parcontract-code  like ub.contract.contract-code     no-undo.
    19293   define buffer bf_contract     for ub.contract.
    19294   define buffer bf-oth_contract for ub.contract.
    19295   define variable varrid-list as character no-undo.
    19296   define variable varrecid    as recid     no-undo.
    19297   define variable varlog      as logical   no-undo.
    19298   define variable var-args    as char      no-undo.
    19299   define variable var-ext-doc-type as char     no-undo.
    19300   do on error undo, return error return-value :
    19301   var-args = parmode.
    19302   parmode = entry(1, parmode).
    19303   run cntrcode-get-arg-val(var-args, "doc-type", output var-ext-doc-type).
    19304   if partype-contract = "" or partype-contract = ? then
    19305      partype-contract = 'при':U .
    19306   assign
    19307     parcontract-code = 0
    19308   .
    19309   if parmode = "input":u
    19310   then do:
    19311     if parframe-value = ""
    19312     then do:
    19313       assign
    19314         parcontract-code = 0
    19315       .
    19316     end.
    19317     else do:
    19318       find first bf_contract no-lock
    19319         where bf_contract.host-code         = parhost-code
    19320           and bf_contract.cli-type          = parcli-type
    19321           and bf_contract.cli-code          = parcli-code
    19322           and bf_contract.contract-prn-code = parframe-value
    19323         no-error.
    19324       if available bf_contract
    19325       then do:
    19326         find first bf-oth_contract no-lock
    19327           where bf-oth_contract.host-code          = parhost-code
    19328             and bf-oth_contract.contract-prn-code  = parframe-value
    19329             and bf-oth_contract.cli-type           = parcli-type
    19330             and bf-oth_contract.cli-code           = parcli-code
    19331             and rowid(bf_contract)                 <> rowid(bf-oth_contract)
    19332           no-error .
    19333         if available bf-oth_contract
    19334         then do:
    19335           message
    19336             "На фирме " parhost-code skip
    19337             "у контрагента" parcli-type parcli-code skip
    19338             "имеются два контракта с номером" parframe-value skip
    19339           view-as alert-box .
    19340         end.
    19341         else do:
    19342           assign
    19343             parcontract-code = bf_contract.contract-code
    19344           .
    19345         end.
    19346       end.
    19347     end.
    19348   end.
    19349   if parmode <> "input":u
    19350   or parcontract-code = 0
    19351   then do:
    19352     run str/cont-all.w (input parmenu-handle,
    19353                     input parhost-code,
    19354                     input "b-sel",
    19355                     input if var-ext-doc-type = 'ee':U then 'фирма':U else "firm-curr" ,
    19356                     input parcli-type,
    19357                     input parcli-code,
    19358                     input ?,
    19359                     input ?,
    19360                     input "current":u,
    19361                     input partype-contract,
    19362                     input-output varrid-list ) no-error.
    19363     if error-status:error then do:
    19364       message "Ошибка при вызове справочника договоров." skip
    19365               return-value                skip
    19366               error-status:get-message(1) skip
    19367               error-status:get-message(2)
    19368       view-as alert-box error.
    19369       return error.
    19370     end.
    19371     assign
    19372       varrecid = integer(entry(1, varrid-list)).
    19373     find first bf_contract where recid(bf_contract) = varrecid no-lock no-error.
    19374     if available bf_contract then do:
    19375       assign
    19376         parcontract-code = bf_contract.contract-code.
    19377     end.
    19378   end.
    19379   if parcontract-code <> 0
    19380   then do:
    19381     if (bf_contract.status_ = 'зкр':U or
    19382         (bf_contract.contract-date-end <> ? and bf_contract.contract-date-end < parobj-date)) then do:
    19383       if lookup(var-ext-doc-type, 'ep,re,rs,ee') = 0
    19384       then do:
    19385           assign
    19386             varlog = no.
    19387           message "Договор с номером " bf_contract.contract-prn-code " закрыт." skip
    19388           view-as alert-box.
    19389           assign
    19390             parcontract-code = 0
    19391           .
    19392       end.
    19393     end.
    19394     if bf_contract.contract-date-beg > parobj-date then do:
    19395       assign
    19396         varlog = no.
    19397       message "Дата открытия договора " bf_contract.contract-date-beg " . Договор с номером " bf_contract.contract-prn-code " еще не открыт." skip
    19398       view-as alert-box.
    19399       assign
    19400         parcontract-code = 0
    19401       .
    19402     end.
    19403     if parcontract-code <> 0
    19404     then do:
    19405       if bf_contract.cli-type <> parcli-type
    19406       or bf_contract.cli-code <> parcli-code
    19407       then do:
    19408          message "По договору " bf_contract.contract-code
    19409                  ( if bf_contract.doc-type =  'при':U
    19410                    then " поставщиком является "
    19411                    else " покупателем является " )
    19412                  bf_contract.cli-type " " bf_contract.cli-code " ." skip
    19413                  "По документу контрагент " parcli-type " " parcli-code " ." skip
    19414          view-as alert-box error.
    19415          assign
    19416            parcontract-code = 0.
    19417       end.
    19418       if parcontract-code <> ? then do:
    19419         if not ( bf_contract.doc-type =  'при':U or bf_contract.doc-type =  'рас':U ) then do:
    19420           message "Контракт имеет недопустимый тип." view-as alert-box.
    19421           assign
    19422             parcontract-code = 0.
    19423         end.
    19424       end.
    19425     end.
    19426   end.
    19427   end.
    19428   end procedure.
    19429   procedure cntrcode-get-arg-val:
    19430       def input param p-args as char no-undo.
    19431       def input param p-key as char no-undo.
    19432       def output param p-val as char no-undo.
    19433       def var i as int no-undo.
    19434       def var nums as int no-undo.
    19435       def var key-val as char no-undo.
    19436       nums = num-entries(p-args).
    19437       do i = 1 to nums:
    19438           key-val = entry(i, p-args).
    19439           if key-val begins (p-key + "=") then do:
    19440               p-val = entry(2, key-val, "=").
    19441               return.
    19442           end.
    19443       end.
    19444       p-val = "".
    19445   end.
    19446   procedure gtd-line :
    19447     do on error undo, return error return-value :
    19448       if pardoc-mode <> 'ДОБАВЛЕНИЕ':U and pardoc-mode <> 'ИЗМЕНЕНИЕ':U then return.
    19449       if not available  ub.doc-line then  return.
    19450       define variable v-res as logical   no-undo .
    19451       define buffer buf_doc-line for  ub.doc-line.
    19452       define buffer buf_parts for ub.parts.
    19453       find first buf_parts no-lock
    19454         where buf_parts.obj-type  =  ub.doc-line.obj-type
    19455           and buf_parts.obj-code  =  ub.doc-line.obj-code
    19456           and buf_parts.artic     =  ub.doc-line.artic
    19457           and buf_parts.prod-type =  ub.doc-line.prod-type
    19458           and buf_parts.prod-code =  ub.doc-line.prod-code
    19459           and buf_parts.out-code  =  ub.doc-line.doc-code
    19460       no-error .
    19461       if available buf_parts then do:
    19462         if buf_parts.cst-code  BEGINS t-doc.cst-code and (SUBSTRING( buf_parts.cst-code, LENGTH( t-doc.cst-code ) + 1 ,1 ) = '/' or buf_parts.cst-code = t-doc.cst-code) then do:
    19463           if LENGTH( t-doc.cst-code ) > 0 then assign d-gtd-add = SUBSTRING( buf_parts.cst-code, LENGTH( t-doc.cst-code ) + 2 ) .
    19464           else do:
    19465             message "ГТД документа не заполнен! Ввод дополнения невозможен."  view-as alert-box.
    19466             return.
    19467           end.
    19468         end.
    19469         else do:
    19470           message "Префикс ГТД строки не совпадает с ГТД документа! Ввод дополнения невозможен."  view-as alert-box.
    19471           return.
    19472         end.
    19473       end.
    19474       run str/gtd-add.w (input ub.goods.artic, input (ub.goods.prod-type + string(ub.goods.prod-code)),goods.gds-name, input t-doc.cst-code, input-output d-gtd-add, output v-res) .
    19475       if v-res then do:
    19476         for each buf_parts
    19477           where buf_parts.obj-type  = t-doc.obj-type
    19478             and buf_parts.obj-code  = t-doc.obj-code
    19479             and buf_parts.artic     =  ub.doc-line.artic
    19480             and buf_parts.prod-type =  ub.doc-line.prod-type
    19481             and buf_parts.prod-code =  ub.doc-line.prod-code
    19482             and buf_parts.out-code  = t-doc.doc-code
    19483           :
    19484           if d-gtd-add = "" then assign buf_parts.cst-code = t-doc.cst-code .
    19485           else assign buf_parts.cst-code = t-doc.cst-code + "/" + d-gtd-add .
    19486         end.
    19487         display d-gtd-add with browse br-dtl .
    19488       end.
    19489     end.
    19490   end procedure.
    19491   FUNCTION deviation-price RETURNS DECIMAL
    19492   (buffer local-doc-line for ub.doc-line) :
    19493   define buffer bf_doc-line for ub.doc-line.
    19494   define buffer bf_trn-doc  for ub.trn-doc.
    19495   if local-doc-line.fact-order = 0 then do:
    19496     find last bf_doc-line where bf_doc-line.obj-type     = t-doc.obj-type           and
    19497                                 bf_doc-line.obj-code     = t-doc.obj-code           and
    19498                                 bf_doc-line.prod-type    = local-doc-line.prod-type and
    19499                                 bf_doc-line.prod-code    = local-doc-line.prod-code and
    19500                                 bf_doc-line.artic        = local-doc-line.artic     and
    19501                                 bf_doc-line.ext-doc-type = 'ie':U       and
    19502                                 bf_doc-line.status_      = 'факт':U                  and
    19503                                 bf_doc-line.fact-order   > 0                        and
    19504                                 can-find(first bf_trn-doc where
    19505                                                bf_trn-doc.doc-code = bf_doc-line.doc-code
    19506                                            and bf_trn-doc.ext-doc-type = 'ie':U)
    19507                                 use-index dt-fo no-lock no-error.
    19508     if available bf_doc-line then do:
    19509       return (local-doc-line.price-rubl - bf_doc-line.price-rubl) / bf_doc-line.price-rubl * 100.
    19510     end.
    19511     else do:
    19512       return ?.
    19513     end.
    19514   end.
    19515   else do:
    19516     find last bf_doc-line where bf_doc-line.obj-type     = t-doc.obj-type            and
    19517                                 bf_doc-line.obj-code     = t-doc.obj-code            and
    19518                                 bf_doc-line.prod-type    = local-doc-line.prod-type  and
    19519                                 bf_doc-line.prod-code    = local-doc-line.prod-code  and
    19520                                 bf_doc-line.artic        = local-doc-line.artic      and
    19521                                 bf_doc-line.ext-doc-type = 'ie':U        and
    19522                                 bf_doc-line.status_      = 'факт':U                   and
    19523                                 bf_doc-line.fact-order   < local-doc-line.fact-order and
    19524                                 can-find(first bf_trn-doc where
    19525                                                bf_trn-doc.doc-code = bf_doc-line.doc-code
    19526                                            and bf_trn-doc.ext-doc-type = 'ie':U)
    19527                                 use-index dt-fo no-lock no-error.
    19528     if available bf_doc-line then do:
    19529       return (local-doc-line.price-rubl - bf_doc-line.price-rubl) / bf_doc-line.price-rubl * 100.
    19530     end.
    19531     else do:
    19532       return ?.
    19533     end.
    19534   end.
    19535   end function.
    19536   FUNCTION get-kg-after-qnty RETURNS DECIMAL
    19537   ( buffer local-doc-line for ub.doc-line ) :
    19538     define variable d_out-qnty-kg like ub.doc-line.fact-qnty no-undo.
    19539     run after_qnty in this-procedure    ( input recid( local-doc-line ),
    19540                                           output d_out-qnty-kg        )
    19541                                           no-error.
    19542     return ( if error-status :error then ? else d_out-qnty-kg ).
    19543   end function.
    19544   FUNCTION get-kg-fact-qnty RETURNS DECIMAL
    19545   ( buffer local-doc-line for ub.doc-line ) :
    19546     define variable d_out-qnty-kg like ub.doc-line.fact-qnty no-undo.
    19547     run inv-line_qnty in this-procedure ( input recid( local-doc-line ),             output d_out-qnty-kg       ) no-error.
    19548     return ( if error-status :error then ? else d_out-qnty-kg ).
    19549   end function.
    19550   FUNCTION get-kg-sale-base RETURNS DECIMAL
    19551   ( buffer local-doc-line for ub.doc-line ) :
    19552     define variable d_out-kg-sale-price like ub.doc-line.price-rubl no-undo.
    19553     run inv-line_price in this-procedure ( input recid( local-doc-line ), input  no, output d_out-kg-sale-price ) no-error.
    19554     return ( if error-status :error then ? else d_out-kg-sale-price ).
    19555   end function.
    19556   FUNCTION get-kg-sale-rubl returns decimal
    19557   ( buffer local-doc-line for ub.doc-line ) :
    19558   define variable d_out-kg-sale-price like ub.doc-line.price-rubl no-undo.
    19559   run inv-line_price in this-procedure ( input recid( local-doc-line ), input yes, output d_out-kg-sale-price ) no-error.
    19560   return ( if error-status :error then ? else d_out-kg-sale-price ).
    19561   end function.
    19562   FUNCTION get-mark RETURNS CHARACTER
    19563   (buffer local-doc-line for  ub.doc-line ):
    19564   if lookup (string (recid (local-doc-line)), del-list) > 0  then return "*".
    19565                                                              else return "".
    19566   end function.
    19567   FUNCTION last-price RETURNS DECIMAL
    19568   (buffer local-doc-line for ub.doc-line) :
    19569   define buffer bf_doc-line for ub.doc-line.
    19570   define buffer bf_trn-doc for ub.trn-doc.
    19571   if local-doc-line.fact-order = 0 then do:
    19572     find last bf_doc-line where bf_doc-line.obj-type     = t-doc.obj-type           and
    19573                                 bf_doc-line.obj-code     = t-doc.obj-code           and
    19574                                 bf_doc-line.prod-type    = local-doc-line.prod-type and
    19575                                 bf_doc-line.prod-code    = local-doc-line.prod-code and
    19576                                 bf_doc-line.artic        = local-doc-line.artic     and
    19577                                 bf_doc-line.ext-doc-type = 'ie':U       and
    19578                                 bf_doc-line.status_      = 'факт':U                  and
    19579                                 bf_doc-line.fact-order   > 0                        and
    19580                                 can-find(first bf_trn-doc where
    19581                                                bf_trn-doc.doc-code = bf_doc-line.doc-code
    19582                                            and bf_trn-doc.ext-doc-type = 'ie':U)
    19583                                 use-index dt-fo no-lock no-error.
    19584     if available bf_doc-line then do:
