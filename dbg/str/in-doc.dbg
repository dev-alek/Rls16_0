     7691   ON CHOOSE OF b-contr-lkp IN FRAME d-in-doc
     7692   DO:
     7693    define buffer buf_contract for ub.contract  .
     7694    if t-doc.contract-code <> 0 then do:
     7695    find first buf_contract no-lock where
     7696               buf_contract.host-code     = t-doc.host-code  and
     7697               buf_contract.contract-code = t-doc.contract-code no-error .
     7698         if available buf_contract then do:
     7699             run str/sh-contr.p
     7700                 ( input parParentProc ,
     7701                   input recid(buf_contract)
     7702                 ).
     7703         end.
     7704     end.
     7705   if pardoc-mode <> 'ПРОСМОТР':U then do:
     7706       define variable varrid-list as character no-undo.
     7707       define variable varrecid    as recid     no-undo.
     7708       find first buf_contract where buf_contract.host-code = t-doc.host-code no-lock no-error .
     7709       if available buf_contract then do:
     7710               run str/cont-all.w (input parParentProc,
     7711                         input t-doc.host-code,
     7712                         input "b-sel",
     7713                         input "firm-curr" ,
     7714                         input t-doc.cli-type,
     7715                         input t-doc.cli-code,
     7716                         input ?,
     7717                         input ?,
     7718                         input "current":u,
     7719                         input "all":u,
     7720                         input-output varrid-list ) no-error.
     7721         if error-status:error then do:
     7722           message "Ошибка при вызове справочника договоров." skip
     7723                   return-value                skip
     7724                   error-status:get-message(1) skip
     7725                   error-status:get-message(2)
     7726           view-as alert-box error.
     7727           return no-apply.
     7728         end.
     7729         assign
     7730           varrecid = integer(entry(1, varrid-list)).
     7731       find first buf_contract where recid(buf_contract) = varrecid no-lock no-error.
     7732       if available buf_contract then do:
     7733          assign
     7734       t-doc.contract-code = buf_contract.contract-code.
     7735       end.
     7736       for each bf_parts where bf_parts.out-code = t-doc.doc-code and bf_parts.contract-code <> t-doc.contract-code EXCLUSIVE-LOCK :
     7737                 bf_parts.contract-code = t-doc.contract-code .
     7738        end.
     7739       end.
     7740       end.
     7741       else do:
     7742       if t-doc.status_ <> 'накл':U or t-doc.flag_ then return.
