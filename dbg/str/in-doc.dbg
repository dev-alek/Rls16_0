    16497            t-doc.exch-code t-doc.exch-date t-doc.discnt-pc t-doc.cst-code
    16498            t-doc.exch-rate t-doc.exch-scale r-acc t-doc.tot-cli t-doc.base-rate
    16499            t-doc.base-scale t-doc.out-code r-outs t-doc.pay-code r-pay
    16500            varpurch-code-name t-doc.wrkr r-wrkr t-doc.ord-num t-doc.agnt r-agnt
    16501            t-doc.boss r-boss t-doc.doc-date t-doc.fact-date t-doc.shift-date
    16502            t-doc.shift-name t-doc.shift-num r-sht t-doc.SLT-type t-doc.VAT-type
    16503            ov-pc b-add-doc-yes t-doc.tot-transp t-doc.tot-other m-inc
    16504            t-doc.ship-num t-doc.ship-date r-reas a-n-c loc-art loc-name loc-code
    16505            b-mark b-add b-prt b-parts b-lkp b-chg b-del b-live b-renum b-marks
    16506            varinplnsum br-dtl ub.currency.curr-abbr t-doc.tot-calc t-doc.road-tax
