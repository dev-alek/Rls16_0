    12046     (input  'scpgpref':u
    12047     ,input  '':u
    12048     ,input  '':u
    12049     ,input  0
    12050     ,input  '':u
    12051     ,input  '':u
    12052     ,input  '':u
    12053     ,input  no
    12054     ,output varpgscales-pref99
    12055     ,output varpgscales-pref-type100
    12056     ) no-error .
    12057   if varpgscales-pref99 = ? then do:
    12058     assign
