    11359      input frame d-in-doc t-doc.exch-scale <> t-doc.exch-scale or
    11360      input frame d-in-doc t-doc.base-rate  <> t-doc.base-rate  or
    11361      input frame d-in-doc t-doc.base-scale <> t-doc.base-scale then flag-recount = yes.
    11362   if input frame d-in-doc t-doc.base-rate = ? or
    11363      input frame d-in-doc t-doc.base-rate = 0 then do:
    11364     message "Не задан курс базовой валюты.".
    11365     apply "entry" to t-doc.base-rate in frame d-in-doc.
    11366     return error.
    11367   end.
