        1   using ibs.th.gbl.storage.*.
        2   using ibs.th.str.*.
        3   DEFINE BUFFER t-doc FOR ub.trn-doc.
        4   DEFINE BUFFER src-doc FOR ub.trn-doc.
        5   define input        parameter parparentproc   as   handle                  no-undo.
        6   define input-output parameter pardoc-rec      as   recid                   no-undo.
        7   define input        parameter pardoc-mode     as   character               no-undo.
        8   define input        parameter partype         as   character               no-undo.
        9   define input        parameter parinternal     as   logical                 no-undo.
       10   define input-output parameter parnext-prev    as   logical                 no-undo.
       11   define input        parameter parext-doc-type like ub.trn-doc.ext-doc-type no-undo.
       12   define input        parameter paris-hold      as   logical                 no-undo.
       13   define input-output parameter line-rec        as   recid                   no-undo.
       14   define input        parameter br-handle       as   handle                  no-undo.
       15   define input        parameter bf-handle       as   handle                  no-undo.
       16   define input        parameter parstat         as   character               no-undo.
       17   define variable vss-revision    as character no-undo initial "$Revision$":U .
       18   define variable vss-author      as character no-undo initial "$Author$":U .
       19   define variable vss-date        as character no-undo initial "$Date$":U .
       20   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
       21   define variable vss-archive     as character no-undo initial "$Archive$":U .
       22   define variable vss-description as character no-undo initial "Обработка приходной накладной (заведение, редактирование)":U .
       23   define temp-table old-doc-line no-undo like ub.doc-line.
       24   define buffer doc-line for ub.doc-line  .
       25   procedure vss-get-info :
       26     define output parameter p-vss-revision    like vss-revision    no-undo .
       27     define output parameter p-vss-author      like vss-author      no-undo .
       28     define output parameter p-vss-date        like vss-date        no-undo .
       29     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       30     define output parameter p-vss-archive     like vss-archive     no-undo .
       31     define output parameter p-vss-description like vss-description no-undo .
       32     assign
       33       p-vss-revision    = vss-revision
       34       p-vss-author      = vss-author
       35       p-vss-date        = vss-date
       36       p-vss-workfile    = vss-workfile
       37       p-vss-archive     = vss-archive
       38       p-vss-description = vss-description
       39     .
       40   end procedure.
       41   procedure vss-get-parameters :
       42     define output parameter p-vss-parameters as character no-undo .
       43       assign
       44         p-vss-parameters = substitute('&1|&2':u,parext-doc-type,paris-hold)
       45       .
       46   end procedure.
       47   define new global shared variable g#vssrevis-logger as handle    no-undo .
       48   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       49   define variable v-vssrevis-logger                   as handle    no-undo .
       50   procedure vss-logevent :
       51     define input  parameter p-extra-paramters as character no-undo .
       52     define variable v-vssrevis-parameters as character no-undo .
       53     do
       54     on error undo, return error return-value
       55     :
       56       if  valid-handle(v-vssrevis-logger)
       57       and v-vssrevis-logger :get-signature("logevent") <> ""
       58       then do:
       59         run vss-get-parameters in this-procedure
       60           (output v-vssrevis-parameters
       61           ).
       62         run logevent in v-vssrevis-logger
       63           (input vss-workfile
       64           ,input vss-revision
       65           ,input v-vssrevis-parameters
       66           ,input p-extra-paramters
       67           ).
       68       end.
       69     end.
       70   end procedure.
       71   assign
       72     v-vssrevis-logger = g#vssrevis-logger
       73   .
       74   if  valid-handle(v-vssrevis-logger)
       75   and v-vssrevis-logger :get-signature("logevent") <> ""
       76   then do:
       77     assign
       78       v-vssrevis-logevent = true
       79     .
       80     run vss-logevent in this-procedure (input vss-description) .
       81   end.
       82   define variable trn-type as integer no-undo init 0.
       83   define new global shared variable g#language as character no-undo .
       84   if g#language <> '' and g#language <> 'rus':U then do:
       85     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       86   end.
       87   define new global shared variable g#library  as handle no-undo .
