     4413     ,input  local-doc-line.prod-code
     4414     ,output v-gds-code
     4415     )  .
     4416     run lineattr-value (
     4417         input   local-doc-line.doc-code ,
     4418         input   v-gds-code              ,
     4419         input   'reason-code':U ,
     4420         output  v-code                  ,
     4421         output  v-type ) .
     4422     find first ub.trn-reason no-lock where
     4423                ub.trn-reason.reason-code = integer ( v-code ) no-error.
     4424     if not available ub.trn-reason then do:
     4425        return "" .
     4426     end.
     4427     else do:
     4428        return ub.trn-reason.reason-name .
     4429     end.
     4430   end function.
     4431   procedure lineattr-value-parts :
