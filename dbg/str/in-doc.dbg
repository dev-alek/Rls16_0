    13974       INPUT  t-doc.host-code,
    13975       INPUT  t-doc.contract-code,
    13976       OUTPUT i-gl-Extent3
    13977      ).
    13978   IF i-gl-Extent3[1] = 2 THEN DO:
    13979      ASSIGN
    13980         i-gl-Host-Code      = i-gl-Extent3[2]
    13981         i-gl-Contract-Code  = i-gl-Extent3[3]
    13982         .
    13983   END. ELSE DO:
    13984      ASSIGN
    13985         i-gl-Host-Code      = t-doc.host-code
    13986         i-gl-Contract-Code  = t-doc.contract-code
    13987         .
    13988   END.
    13989       FIND FIRST bf_contract-specif
    13990              NO-LOCK
    13991              WHERE
    13992                  bf_contract-specif.Host-code    = i-gl-Host-Code
    13993              AND bf_contract-specif.Contract-num = i-gl-Contract-Code
    13994              NO-ERROR
    13995              .
    13996         if available bf_contract-specif then do:
    13997           run gbl/d-askw.w
    13998             (input "Добавление товаров"
    13999             ,input "Выберите один из пунктов для добавления в накладную" + chr(10)
    14000                  + "товаров по спецификации к договору" + chr(10)
    14001             ,input "|"
    14002             ,input "Все|Выборочно|По справочнику|Отказ"
    14003             ,input "Все недобавленные товары по спецификации|"
    14004                  + "Выборочно товары по спецификации|"
    14005                  + "Выбор товаров из справочника|"
    14006                  + "Отказ от выполнения операции"
    14007             ,input 1
    14008             ,input 4
    14009             ,output v-choice
    14010             ).
    14011           if v-choice = 4 then do:
    14012             run UI-on in this-procedure ( input "line" ).
    14013             return.
    14014           end.
    14015         end.
    14016       end.
    14017       if v-choice = 0 then
    14018         v-choice = 3.
    14019       assign
    14020         varnotes = '':u
    14021         varlns-cnt = 1.
    14022       case v-choice:
    14023         when 1 then do:
    14024   define variable vss-include-info108 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14025   ASSIGN
    14026      i-gl-Host-Code      = 0
    14027      i-gl-Contract-Code  = 0
    14028      i-gl-Extent3        = 0
    14029      .
    14030   RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
    14031       INPUT  t-doc.host-code,
    14032       INPUT  t-doc.contract-code,
    14033       OUTPUT i-gl-Extent3
    14034      ).
    14035   IF i-gl-Extent3[1] = 2 THEN DO:
    14036      ASSIGN
    14037         i-gl-Host-Code      = i-gl-Extent3[2]
    14038         i-gl-Contract-Code  = i-gl-Extent3[3]
    14039         .
    14040   END. ELSE DO:
    14041      ASSIGN
    14042         i-gl-Host-Code      = t-doc.host-code
    14043         i-gl-Contract-Code  = t-doc.contract-code
    14044         .
    14045   END.
    14046   FOR EACH
    14047       bf_contract-specif
    14048        NO-LOCK
    14049        WHERE
    14050            bf_contract-specif.Host-code    = i-gl-Host-Code
    14051        AND bf_contract-specif.Contract-num = i-gl-Contract-Code
    14052               on error undo, return error return-value :
    14053             find first bf_goods where bf_goods.gds-code = bf_contract-specif.gds-code no-lock.
    14054             find first bf-hv_doc-line where bf-hv_doc-line.doc-code  = t-doc.doc-code     and
    14055                                             bf-hv_doc-line.artic     = bf_goods.artic     and
    14056                                             bf-hv_doc-line.prod-type = bf_goods.prod-type and
    14057                                             bf-hv_doc-line.prod-code = bf_goods.prod-code no-lock no-error.
    14058             if not available bf-hv_doc-line then do:
    14059               assign
    14060                 varnotes = varnotes + (if varnotes = '':u then '':u else ',':u) + string(recid(bf_goods)).
    14061             end.
    14062           end.
    14063           if varnotes = '':u then do:
    14064             message "Вы добавили уже все товары по спецификации."
    14065             view-as alert-box.
    14066           end.
    14067         end.
    14068         when 2 then do:
    14069           run str/contspec.w (input parparentproc,
    14070                           input "b-sel,b-mark",
    14071                           input 'ПРОСМОТР':U,
    14072                           input t-doc.host-code,
    14073                           input t-doc.contract-code,
    14074                           output v-rid-list) .
    14075           if v-rid-list = '':u then do:
    14076             message "Нет выбранных товаров по спецификации."
    14077               view-as alert-box.
    14078           end.
    14079           do i = 1 to num-entries(v-rid-list):
    14080             v-rid = integer(entry(i, v-rid-list)).
    14081             find bf_contract-specif where recid(bf_contract-specif) = v-rid no-lock no-error.
    14082             if available bf_contract-specif then do:
    14083               find first bf_goods where bf_goods.gds-code = bf_contract-specif.gds-code no-lock.
    14084               assign
    14085                 varnotes = varnotes + (if varnotes = '':u then '':u else ',':u) + string(recid(bf_goods)).
    14086             end.
    14087           end.
    14088         end.
    14089         when 3 then do:
    14090           find first buf_assortment-matrix no-lock where
    14091                      buf_assortment-matrix.obj-code = v-cntxt-obj-code and
    14092                      buf_assortment-matrix.obj-type = v-cntxt-obj-type and
    14093                      buf_assortment-matrix.asmt-status = integer ('0':U) no-error .
    14094                       if available buf_assortment-matrix then do:
    14095                           v-type-mode-spr = 'объект':U .
    14096                       end.
    14097                       else do:
    14098                           v-type-mode-spr = 'все':U .
    14099                       end.
    14100           run str/chs-gds.w ( input parparentproc
    14101                         , input v-cntxt-obj-type
    14102                         , input v-cntxt-obj-code
    14103                         , input "":u
    14104                         , input t-doc.status_
    14105                         , input "Строка ПН № " + t-doc.doc-code + " " + t-doc.status_ + " " + string (t-doc.flag_, "+/-")
    14106                         , input v-type-mode-spr
    14107                         , input t-doc.cli-type
    14108                         , input t-doc.cli-code
    14109                         , input t-doc.host-code
    14110                         , input t-doc.ext-doc-type
    14111                         , input-output varschartic
    14112                         , output varnotes) no-error.
    14113         end.
    14114       end case.
    14115     end.
    14116     run cycle-add in this-procedure.
    14117     run UI-on     in this-procedure ( input "line" ).
    14118   end.
    14119   END PROCEDURE.
    14120   PROCEDURE after_qnty :
    14121   define  input parameter p-doc-line-rec as   recid                 no-undo.
    14122     define output parameter p-out-qnty-kg  like ub.doc-line.fact-qnty no-undo initial 0.0.
    14123     define variable p-inv-line-rec as recid   no-undo.
    14124     define variable is-petrol      as logical no-undo.
    14125     define variable is-pieces      as logical no-undo.
    14126     define buffer buf_inv-line for ub.inv-line.
    14127     define buffer buf_doc-line for ub.doc-line.
    14128     do on error undo, return error return-value :
    14129       find buf_doc-line       no-lock where recid( buf_doc-line ) = p-doc-line-rec no-error.
    14130       if not available buf_doc-line then do:
    14131         assign p-out-qnty-kg = ?.
    14132         undo, return error "after_qnty: не найдена строка накладной".
    14133       end.
    14134   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
    14135     (
    14136        input buf_doc-line.artic
    14137     ,  input buf_doc-line.prod-type
    14138     ,  input buf_doc-line.prod-code
    14139     , output is-petrol
    14140     , output is-pieces
    14141     ) no-error.
    14142       if error-status :error or v-is-ptrl <> "yes" or is-petrol <> yes or is-pieces <> no then do:
    14143         undo, return error substitute( 'inv-line_price: &1 (произв. &2 &3) не топливный товар',
    14144                                        buf_doc-line.artic, buf_doc-line.prod-type, buf_doc-line.prod-code ).
    14145       end.
    14146       find buf_inv-line          no-lock where
    14147            buf_inv-line.doc-code  = buf_doc-line.doc-code  and
    14148            buf_inv-line.artic     = buf_doc-line.artic     and
    14149            buf_inv-line.prod-code = buf_doc-line.prod-code and
    14150            buf_inv-line.prod-type = buf_doc-line.prod-type no-error.
    14151       if available buf_inv-line then do:
    14152         assign
    14153           p-inv-line-rec = recid( buf_inv-line )
    14154         .
    14155         find buf_doc-line exclusive-lock where recid( buf_doc-line ) = p-doc-line-rec.
    14156         find buf_inv-line exclusive-lock where recid( buf_inv-line ) = p-inv-line-rec.
    14157         assign
    14158           p-out-qnty-kg = buf_inv-line.after-cli-qnty
    14159         .
    14160         find buf_inv-line        no-lock where recid( buf_inv-line ) = p-inv-line-rec.
    14161         find buf_doc-line        no-lock where recid( buf_doc-line ) = p-doc-line-rec.
    14162         release buf_inv-line.
    14163         release buf_doc-line.
    14164       end.
    14165     end.
    14166   END PROCEDURE.
    14167   PROCEDURE apply-entry-next-field :
    14168   define input parameter parself-name as character no-undo.
    14169     case parself-name:
    14170     when "ship-num" then
    14171          if t-doc.ship-date:sensitive in frame d-in-doc then apply "entry" to t-doc.ship-date in frame d-in-doc.
    14172     when "ship-date" then
    14173          if t-doc.tot-cli:sensitive in frame d-in-doc then apply "entry" to t-doc.tot-cli in frame d-in-doc.
    14174     when "exch-date" then
    14175          if t-doc.exch-code:sensitive in frame d-in-doc then apply "entry" to t-doc.exch-code in frame d-in-doc.
    14176     when "tot-cli" then do:
    14177          if b-add:sensitive  in frame d-in-doc then apply "entry" to b-add in frame d-in-doc.
    14178     end.
    14179     end case.
    14180   END PROCEDURE.
    14181   PROCEDURE ask-copy :
    14182   define variable v-num as integer initial 1 no-undo.
    14183   run gbl/d-askw.w
    14184     (  input "Вопрос"
    14185     ,  input "По каким количествам будем производить копирование?"
    14186             + chr(10) + (if t-d-b.status_ <> 'запрос':U then "Внимание ! Если копировать из документарных количеств, то становится невозможным копирование с сохранением свойств партий документа источника." else "":U)
    14187     ,  input "|^"
    14188     ,  input "Фактическим|"
    14189            + "Документарным|"
    14190            + "Отмена"
    14191     ,  input "Исходя из фактических количеств в признаках.|"
    14192            + "Исходя из документарных количеств в признаках.|"
    14193            + "Отменить копирование."
    14194     ,  input 1
    14195     ,  input 3
    14196     , output v-num
    14197     ).
    14198     if v-num = 3 then do:
    14199       return no-apply.
    14200     end.
    14201   define variable vss-include-info109 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14202   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn4) <> true) then do:   run str/lib-trn4.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn4) <> true) then do:     message       "Error starting lib-trn4.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn4_copy-in in g#lib-trn4
    14203   ( input parparentproc
    14204    ,input recid(t-doc)
    14205    ,input table lib-trn_ret-doc
    14206    ,input table lib-trn_ret-line
    14207    ,input table lib-trn_ret-line-attr
    14208    ,input table lib-trn_ret-dtl
    14209    ,input table lib-trn_ret-parts
    14210    ,input yes
    14211    ,input yes
    14212    ,input no
    14213    ,input (if v-num = 1 then yes else no)
    14214    ,input this-procedure
    14215     ) no-error .
    14216   if error-status:error then do:
    14217   assign
    14218     pardoc-mode = 'ИЗМЕНЕНИЕ':U.
    14219     run UI-on in this-procedure ( input "line" ) no-error .
    14220     if error-status :error then message
    14221       vss-workfile vss-revision vss-description skip
    14222       error-status :get-message(1) skip
    14223       return-value skip
    14224       ""
    14225       view-as alert-box error
    14226     .
    14227     return error return-value.
    14228   end.
    14229   assign
    14230     pardoc-mode = 'ИЗМЕНЕНИЕ':U.
    14231     run UI-on in this-procedure ( input "line" ).
    14232   END PROCEDURE.
    14233   PROCEDURE ass-frame-light :
    14234   define input parameter parself-name as character no-undo.
    14235   case parself-name:
    14236     when "tot-cli"    then do: if input frame d-in-doc t-doc.tot-cli    <> t-doc.tot-cli    then assign frame d-in-doc t-doc.tot-cli    . end.
    14237     when "tot-transp" then do: if input frame d-in-doc t-doc.tot-transp <> t-doc.tot-transp then assign frame d-in-doc t-doc.tot-transp . end.
    14238     when "tot-other"  then do: if input frame d-in-doc t-doc.tot-other  <> t-doc.tot-other  then assign frame d-in-doc t-doc.tot-other  . end.
    14239     when "ord-num"    then do: if input frame d-in-doc t-doc.ord-num    <> t-doc.ord-num    then assign frame d-in-doc t-doc.ord-num    . end.
    14240     when "ship-num"   then do: if input frame d-in-doc t-doc.ship-num   <> t-doc.ship-num   then assign frame d-in-doc t-doc.ship-num   . end.
    14241     when "ship-date"  then do: if input frame d-in-doc t-doc.ship-date  <> t-doc.ship-date  then assign frame d-in-doc t-doc.ship-date  . end.
    14242   end case.
    14243   END PROCEDURE.
    14244   PROCEDURE check-exch :
    14245     if input frame d-in-doc t-doc.exch-date = ? then do:
    14246       message "Не задана дата растаможивания.".
    14247       apply "entry" to t-doc.exch-date in frame d-in-doc.
    14248       return error.
    14249     end.
    14250     find ub.currency where ub.currency.curr-code = input t-doc.exch-code no-lock no-error.
    14251     if not available ub.currency then do:
    14252       message "Неправильная валюта поставщика - такой валюты нет.".
    14253       apply "entry" to t-doc.exch-code in frame d-in-doc.
    14254       return error.
    14255     end.
    14256     if t-doc.exch-code <> ub.currency.curr-code then do:
    14257       if ub.currency.curr-code = 0 then do:
    14258         if (t-doc.exch-rate <> ? and t-doc.exch-scale <> ? and
    14259             (t-doc.exch-rate <> 1 or t-doc.exch-scale <> 1)) then do:
    14260           varlog = no.
    14261           message "Пересчитать цены поставщика в рубли по курсу поставщика ?"
    14262                           view-as alert-box question buttons YES-NO update varlog.
    14263           if varlog then do:
    14264             run waitfram-show in this-procedure ( input "Пересчет цен поставщика в рубли. Ждите..." ).
    14265             for each  ub.doc-line where  ub.doc-line.doc-code = t-doc.doc-code:
    14266                ub.doc-line.price-cli =  ub.doc-line.price-cli * t-doc.exch-rate / t-doc.exch-scale.
    14267             end.
    14268             run waitfram-hide in this-procedure .
    14269           end.
    14270         end.
    14271         t-doc.print-rubl = yes.
    14272         assign
    14273           t-doc.exch-rate = 1
    14274           t-doc.exch-scale = 1.
    14275         disable t-doc.exch-rate t-doc.exch-scale r-acc with frame d-in-doc.
    14276       end.
    14277       else do:
    14278         find last ub.curr-accnt where ub.curr-accnt.curr-code = ub.currency.curr-code
    14279                                and ub.curr-accnt.exch-date <= input t-doc.exch-date use-index pi no-lock no-error.
    14280         if available ub.curr-accnt then do:
    14281           assign
    14282             t-doc.exch-rate = ub.curr-accnt.exch-rate
    14283             t-doc.exch-scale = ub.curr-accnt.exch-scale.
    14284         end.
    14285         else do:
    14286           assign
    14287             t-doc.exch-rate = ?
    14288             t-doc.exch-scale = ?.
    14289         end.
    14290         if t-doc.exch-code = 0 and
    14291           (t-doc.exch-rate  <> ? and
    14292            t-doc.exch-scale <> ? and
    14293            (t-doc.exch-rate <> 1 or t-doc.exch-scale <> 1)
    14294           ) then do:
    14295           varlog = no.
    14296           message "Пересчитать цены поставщика в валюту ГТД по курсу ММВБ (справочника) ?"
    14297                           view-as alert-box question buttons YES-NO update varlog.
    14298           if varlog then do:
    14299             run waitfram-show in this-procedure ( input "Пересчет цен поставщика в валюту ГТД. Ждите..." ).
    14300               for each  ub.doc-line where  ub.doc-line.doc-code = t-doc.doc-code:
    14301                ub.doc-line.price-cli =  ub.doc-line.price-cli / t-doc.exch-rate * t-doc.exch-scale.
    14302             end.
    14303             run waitfram-hide in this-procedure  .
    14304           end.
    14305         end.
    14306         t-doc.print-rubl = no.
    14307         enable t-doc.exch-rate t-doc.exch-scale r-acc with frame d-in-doc.
    14308       end.
    14309       assign
    14310         t-doc.exch-code = ub.currency.curr-code.
    14311       display t-doc.exch-code ub.currency.curr-abbr
    14312               t-doc.exch-rate t-doc.exch-scale with frame d-in-doc.
    14313     end.
    14314   end procedure.
    14315   PROCEDURE check-reason :
    14316   define variable j_rsn-code like ub.trn-reason.reason-code no-undo.
    14317     assign j_rsn-code = ( input frame d-in-doc t-doc.reason-code ).
    14318     find first ub.trn-reason no-lock where
    14319                ub.trn-reason.reason-code = j_rsn-code no-error.
    14320     if not available ub.trn-reason then do:
    14321       if j_rsn-code <> ? and j_rsn-code <> 0 then do:
    14322         message "Неверно указано основание (причина) создания документа." view-as alert-box error.
    14323       end.
    14324       assign  rsn-name = "".
    14325       display rsn-name with frame d-in-doc.
    14326       if j_rsn-code = ? or j_rsn-code = 0 then do:
    14327         assign t-doc.reason-code = 0.
    14328         return.
    14329       end.
    14330       else do:
    14331         return error.
    14332       end.
    14333     end.
    14334     assign  rsn-name = ub.trn-reason.reason-name.
    14335     display rsn-name with frame d-in-doc.
    14336     assign frame d-in-doc t-doc.reason-code.
    14337   END PROCEDURE.
    14338   PROCEDURE check-update :
    14339   define buffer ch-doc-line for  ub.doc-line.
    14340     define buffer ch-goods    for ub.goods.
    14341     define variable p-same-price as logical   no-undo.
    14342     define variable v-insalepr   as logical   no-undo .
    14343     for each ch-doc-line where ch-doc-line.doc-code = t-doc.doc-code:
    14344         find first ch-goods where ch-goods.artic     = ch-doc-line.artic     and
    14345                                   ch-goods.prod-type = ch-doc-line.prod-type and
    14346                                   ch-goods.prod-code = ch-doc-line.prod-code no-lock.
    14347   define variable vss-include-info110 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14348   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
    14349     (input  ch-doc-line.obj-type
    14350     ,input  ch-doc-line.obj-code
    14351     ,input  ch-doc-line.artic
    14352     ,input  ch-doc-line.prod-type
    14353     ,input  ch-doc-line.prod-code
    14354     ,input  'insalepr=request':U
    14355     ,output v-insalepr
    14356     )  .
    14357         if v-insalepr = true then do:
    14358            message "Товар " ch-goods.artic " " ch-goods.prod-type " " ch-goods.prod-code
    14359                    " принимается по продажной цене. Смена цен в накладной недопустима."
    14360                    view-as alert-box error.
    14361            return error.
    14362         end.
    14363         run trg/doclnupd.p ( input  ch-doc-line.doc-code,
    14364                          input  t-doc.obj-type,
    14365                          input  t-doc.obj-code,
    14366                          input  ch-doc-line.artic,
    14367                          input  ch-doc-line.prod-type,
    14368                          input  ch-doc-line.prod-code,
    14369                          output p-same-price) no-error.
    14370         if error-status :error then do:
    14371            message "Ошибка при просмотре учетных цен в партиях." view-as alert-box error.
    14372            return error.
    14373         end.
    14374         if p-same-price = false then do:
    14375            message "Нельзя изменять цены в строках, т.к. имеются разные учетные цены в партиях." SKIP
    14376                    "Товар " ch-doc-line.artic SKIP
    14377                             ch-doc-line.prod-type SKIP
    14378                             ch-doc-line.prod-code
    14379            view-as alert-box error.
    14380            return error.
    14381        end.
    14382     end.
    14383   END PROCEDURE.
    14384   PROCEDURE chg-line :
    14385   define variable line-doc     as recid   no-undo.
    14386   define variable varext-cycle as logical no-undo.
    14387   define buffer chg-goods for ub.goods.
    14388   if not available  ub.doc-line then do:
    14389     message "Неправильный выбор строки.".
    14390     return error.
    14391   end.
    14392   do on error undo, return error return-value :
    14393   find chg-goods where chg-goods.prod-code =  ub.doc-line.prod-code  and
    14394                        chg-goods.prod-type =  ub.doc-line.prod-type  and
    14395                        chg-goods.artic     =  ub.doc-line.artic    no-lock.
    14396   line-rec  = recid(ub.doc-line).
    14397   line-doc  = RECID(t-doc).
    14398   gds-rec   = RECID(chg-goods).
    14399   varlns-cnt = 1.
    14400   run str/in-line.w ( input  parparentproc,
    14401                       input  'ИЗМЕНЕНИЕ':U,
    14402                       input  pardoc-rec,
    14403                       input-output line-rec,
    14404                       input  gds-rec,
    14405                       input  varlns-cnt,
    14406                       output varext-cycle,
    14407                       input  0,
    14408                       input  ?,
    14409                       input varinplnsum ) no-error.
    14410   FIND t-doc WHERE RECID(t-doc) = line-doc.
    14411   run UI-on in this-procedure ( input "line" ).
    14412   end.
    14413   END PROCEDURE.
    14414   PROCEDURE chg-purch-code :
    14415   define buffer bf_doc-line for ub.doc-line.
    14416   define buffer bf_goods    for ub.goods.
    14417   define buffer bf_pl-gds   for ub.pl-gds.
    14418   define input parameter parpurch-int-code like ub.trn-doc.purch-code no-undo.
    14419   do transaction on error undo, return error return-value :
    14420   if parpurch-int-code = 3 then do:
    14421     for each bf_doc-line where bf_doc-line.doc-code = t-doc.doc-code on error undo, return error return-value :
    14422       find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
    14423                                 bf_goods.prod-type = bf_doc-line.prod-type and
    14424                                 bf_goods.prod-code = bf_doc-line.prod-code no-lock.
    14425       find first bf_pl-gds where bf_pl-gds.gds-code = bf_goods.gds-code and
    14426                                  bf_pl-gds.obj-type = t-doc.obj-type    and
    14427                                  bf_pl-gds.obj-code = t-doc.obj-code    no-lock no-error.
    14428       if available bf_pl-gds then do:
    14429         message "Товар:" bf_goods.artic " " bf_goods.prod-type " " bf_goods.prod-code " " bf_goods.gds-name " резервируется по складским местам." skip
    14430                 "Его нельзя приходывать на ответственное хранение."
    14431         view-as alert-box error.
    14432         return error.
    14433       end.
    14434     end.
    14435   end.
    14436   assign
    14437     t-doc.purch-code = parpurch-int-code.
    14438   for each ub.parts where ub.parts.out-code = t-doc.doc-code on error undo, return error return-value :
    14439     assign ub.parts.purch-code = t-doc.purch-code.
    14440   end.
    14441   end.
    14442   END PROCEDURE.
    14443   PROCEDURE chk-upd-date :
    14444   define input parameter parself-name as character no-undo.
    14445   define variable v-today as date      no-undo.
    14446   define variable v-time  as integer   no-undo.
    14447   if input frame d-in-doc t-doc.fact-date  <> t-doc.fact-date  or
    14448      input frame d-in-doc t-doc.shift-date <> t-doc.shift-date or
    14449      input frame d-in-doc t-doc.shift-num  <> t-doc.shift-num then do:
    14450   if parself-name = "fact-date" then do:
    14451   define variable vss-include-info111 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14452   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
    14453     (input  v-cntxt-obj-type
    14454     ,input  v-cntxt-obj-code
    14455     ,output v-today
    14456     )  .
    14457     if input frame d-in-doc t-doc.fact-date > v-today then do:
    14458        message "Дата больше сегодняшней даты на объекте." view-as alert-box error.
    14459        display t-doc.fact-date with frame d-in-doc.
    14460        return error.
    14461     end.
    14462   if input frame d-in-doc t-doc.fact-date < v-today then do:
    14463   define variable v-value-character as character no-undo .
    14464   define variable v-value-date      as date no-undo .
    14465   define variable v-value-decimal   as decimal no-undo .
    14466   define variable v-value-integer   as integer no-undo .
    14467   define variable v-value-logical   as logical no-undo .
    14468   define variable v-tth             as handle no-undo .
    14469       if v-back-date <> true then do:
    14470         message "Запрещено работать задним числом !" view-as alert-box information .
    14471         display t-doc.fact-date with frame d-in-doc.
    14472         return error.
    14473       end.
    14474   end.
    14475     if input frame d-in-doc t-doc.fact-date < v-today - 7 then do:
    14476        varlog = yes.
    14477        message "Заведенная факт дата отличается более чем на 7 дней от сегодняшней даты на объекте."
    14478                "Отказаться от заведения даты?" view-as alert-box question
    14479                buttons yes-no update varlog.
    14480        if varlog then do:
    14481           display t-doc.fact-date with frame d-in-doc.
    14482           return error.
    14483        end.
    14484     end.
    14485     assign varlog = no.
    14486   define variable vss-include-info112 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14487   do:
    14488     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    14489       (input  v-cntxt-db-num
    14490       ,input  v-cntxt-userid
    14491       ,input  0
    14492       ,input  'actn_income_add-back-date':U
    14493       ,input  'object':U
    14494       ,input  t-doc.host-code
    14495       ,input  t-doc.obj-type
    14496       ,input  t-doc.obj-code
    14497       ,input  0
    14498       ,input  0
    14499       ,input  0
    14500       ,input  true
    14501       ,output varlog
    14502       )  .
    14503   end.
    14504     if varlog = no then do:
    14505        display t-doc.fact-date with frame d-in-doc.
    14506        return error.
    14507     end.
    14508     assign varlog = no.
    14509     message "Вы хотите изменить фактическую дату?" skip
    14510             "Если дату задать как '?' она при закрытии на факт проставится днем закрытия."
    14511     view-as alert-box question buttons yes-no update varlog.
    14512     if not varlog then do:
    14513        display t-doc.fact-date with frame d-in-doc.
    14514        return error.
    14515     end.
    14516   end.
    14517   assign frame d-in-doc
    14518     t-doc.fact-date
    14519     t-doc.shift-date
    14520     t-doc.shift-num
    14521     t-doc.shift-name.
    14522   if t-doc.fact-date <> today
    14523   then
    14524     t-doc.fact-time = if (time < (12 * 60 * 60)) then time else (12 * 60 * 60) .
    14525   if t-doc.fact-date = ? then t-doc.fact-time = ? .
    14526   end.
    14527   END PROCEDURE.
    14528   PROCEDURE choice-currency :
    14529   find ub.currency where ub.currency.curr-code = input frame d-in-doc t-doc.exch-code no-error.
    14530   if not available ub.currency then do:
    14531     run ref/currency.w ( input parparentproc, input "b-sel", input-output ref-rec ).
    14532     if ref-rec = ? then do: return error. end.
    14533     find ub.currency where recid ( ub.currency ) = ref-rec.
    14534   end.
    14535   RUN exch-rate in this-procedure.
    14536   END PROCEDURE.
    14537   PROCEDURE choose-b-parts :
    14538   define variable varline-mode      as character no-undo .
    14539   if not available  ub.doc-line then do:
    14540     message "Неправильный выбор строки - партии недоступны.".
    14541     return error.
    14542   end.
    14543   line-rec = recid ( ub.doc-line).
    14544   find ub.goods where ub.goods.prod-code =  ub.doc-line.prod-code
    14545                and ub.goods.prod-type =  ub.doc-line.prod-type
    14546                and ub.goods.artic     =  ub.doc-line.artic no-lock.
    14547   gds-rec = recid (ub.goods).
    14548   do transaction on error   undo, return error return-value :
    14549      if pardoc-mode = 'ИЗМЕНЕНИЕ':U then do:
    14550        find t-doc where recid (t-doc) = pardoc-rec exclusive.
    14551        find  ub.doc-line where recid ( ub.doc-line) = line-rec exclusive.
    14552        varline-mode = 'ИЗМЕНЕНИЕ':U.
    14553        FOR EACH old-doc-line: DELETE old-doc-line. END.
    14554        CREATE old-doc-line.
    14555        BUFFER-COPY  ub.doc-line to old-doc-line.
    14556      end.
    14557      else varline-mode = 'ПРОСМОТР':U.
    14558      if v-by-utd
    14559      then do :
    14560        parext-doc-mode = "vsd_corr-parts" .
    14561      end .
    14562      if parext-doc-mode = "vsd_corr-parts"
    14563      or parext-doc-mode = "vsd"
    14564      or  parext-doc-mode = "corr-parts"
    14565      then do :
    14566        find t-doc where recid (t-doc) = pardoc-rec exclusive.
    14567        find doc-line where recid (doc-line) = line-rec exclusive.
    14568        varline-mode = parext-doc-mode.
    14569      end .
    14570      run str/parts-l.w
    14571        (  input parparentproc
    14572        ,  input t-doc.obj-type
    14573        ,  input t-doc.obj-code
    14574        ,  input ub.goods.gds-code
    14575        ,  input t-doc.doc-code
    14576        ,  input varline-mode
    14577        ,  input 'документ':U
    14578        ,  input 'текущий':U
    14579        ,  input 'документ':U
    14580        , output prt-rec
    14581        ) .
    14582      run str/chk-prt.p ( input line-rec, input no, buffer t-doc ).
    14583   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_chkwhole in g#lib-trn
    14584     ( input ub.doc-line.doc-code
    14585      ,input ub.doc-line.artic
    14586      ,input ub.doc-line.prod-type
    14587      ,input ub.doc-line.prod-code
    14588      ,input ub.doc-line.cli-qnty
    14589      ,input ub.doc-line.doc-qnty
    14590      ,input ub.doc-line.fact-qnty
    14591      ,input yes
    14592     ) no-error .
    14593      if error-status :error then do: undo, return error return-value. end.
    14594      if pardoc-mode = 'ИЗМЕНЕНИЕ':U then DO:
    14595   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_clcintrn in g#lib-trn
    14596     (
    14597      input parparentproc
    14598     ,input recid(ub.doc-line)
    14599     ,input ub.doc-line.doc-code
    14600     ,input ub.doc-line.artic
    14601     ,input ub.doc-line.prod-type
    14602     ,input ub.doc-line.prod-code
    14603     ,input old-doc-line.price-cli
    14604     ,input old-doc-line.price-rubl
    14605     ,input old-doc-line.price-base
    14606     ,input old-doc-line.cli-qnty
    14607     ,input old-doc-line.cli-base-rate
    14608     ,input old-doc-line.fact-qnty
    14609     ,input old-doc-line.doc-qnty
    14610     ,input old-doc-line.vat-pc
    14611     ,input old-doc-line.slt-pc
    14612     ,input old-doc-line.road-tax
    14613     ,input old-doc-line.excise
    14614     ,input old-doc-line.transport-rubl
    14615     ,input old-doc-line.other-rubl
    14616     ,input 'update'
    14617     ,input ''
    14618     ) no-error.
    14619         if error-status :error then do: undo, return error return-value. end.
    14620         run full-recount in this-procedure no-error.
    14621         if error-status :error then do: undo, return error return-value. end.
    14622      END.
    14623   end.
    14624   END PROCEDURE.
    14625   PROCEDURE choose-b-prt :
    14626     define variable j_pl-code         as integer no-undo .
    14627     define variable is_reserv-pl-code as logical no-undo .
    14628     define variable is-petrol         as logical no-undo .
    14629     define variable is-pieces         as logical no-undo .
    14630   if not available  ub.doc-line then do:
    14631     message "Неправильный выбор строки.".
    14632     return error.
    14633   end.
    14634   define variable prt-mode as character no-undo.
    14635   line-rec = recid ( ub.doc-line).
    14636   find ub.goods where ub.goods.prod-code =  ub.doc-line.prod-code
    14637                and ub.goods.prod-type =  ub.doc-line.prod-type
    14638                and ub.goods.artic     =  ub.doc-line.artic no-lock.
    14639   gds-rec = recid (ub.goods).
    14640   find ub.gds-prt where ub.gds-prt.upper-code = ub.goods.prt-root no-lock.
    14641   if ub.gds-prt.node-name = '_Пустая шкала':U then do:
    14642     message "Товар :" ub.goods.artic ub.goods.gds-name
    14643                     "не делится на признаки - шкала недоступна.".
    14644     return error.
    14645   end.
    14646   do transaction on error undo, return error:
    14647      if pardoc-mode = 'ИЗМЕНЕНИЕ':U then do:
    14648        find t-doc    where recid (t-doc)    = pardoc-rec exclusive no-error.
    14649        if not available t-doc then do:
    14650          message "Документ не найден. Возможно удален." view-as alert-box error.
    14651          return error.
    14652        end.
    14653        find  ub.doc-line where recid ( ub.doc-line) = line-rec exclusive .
    14654        assign
    14655          prt-mode = 'ШКАЛА':U.
    14656        for each old-doc-line:
    14657          delete old-doc-line.
    14658        end.
    14659        create old-doc-line.
    14660        buffer-copy  ub.doc-line to old-doc-line.
    14661      end.
    14662      else do:
    14663        find t-doc    where recid (t-doc) = pardoc-rec no-lock no-error.
    14664        if not available t-doc then do:
    14665          message "Документ не найден. Возможно удален." view-as alert-box error.
    14666          return error.
    14667        end.
    14668        prt-mode = 'ПРОСМОТР':U.
    14669      end.
    14670      prt-rec = ?.
    14671      if (t-doc.status_ = 'накл':U and t-doc.flag_ = no) or t-doc.status_ = 'запрос':U then do:
    14672        run str/doc-p.p
    14673          ( input parparentproc
    14674          , input pardoc-rec
    14675          , input line-rec
    14676          , input gds-rec
    14677          , input prt-mode )
    14678          .
    14679      end.
    14680      else do:
    14681        run str/fac-p.p
    14682          ( input parparentproc
    14683          , input pardoc-rec
    14684          , input line-rec
    14685          , input gds-rec
    14686          , input prt-mode     )
    14687          .
    14688      end.
    14689      if line-rec <> ? then do:
    14690         run str/chk-prt.p ( input line-rec, input no, buffer t-doc ).
    14691      end.
    14692      if pardoc-mode = 'ИЗМЕНЕНИЕ':U then do:
    14693         if line-rec <> ? then do:
    14694           find first ub.goods no-lock
    14695             where ub.goods.artic     =  ub.doc-line.artic
    14696               and ub.goods.prod-type =  ub.doc-line.prod-type
    14697               and ub.goods.prod-code =  ub.doc-line.prod-code
    14698             .
    14699   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
    14700     (
    14701        input ub.goods.artic
    14702     ,  input ub.goods.prod-type
    14703     ,  input ub.goods.prod-code
    14704     , output is-petrol
    14705     , output is-pieces
    14706     ) no-error.
    14707           if not error-status :error
    14708             and v-is-ptrl = "yes"
    14709             and is-petrol = true
    14710             and is-pieces = false
    14711           then do:
    14712             message
    14713               vss-workfile vss-revision vss-description skip
    14714               "Топливный товар не разбивается по шкалам!!!!!" skip
    14715               error-status :get-message(1) skip
    14716               return-value skip
    14717               view-as alert-box error .
    14718             undo, return error .
    14719           end.
    14720           run plgdsfnd in this-procedure
    14721             (  input no
    14722             ,  input t-doc.obj-type
    14723             ,  input t-doc.obj-code
    14724             ,  input ub.goods.gds-code
    14725             , output is_reserv-pl-code
    14726             , output j_pl-code
    14727             ) no-error .
    14728           if error-status :error then do:
    14729             message
    14730               "Ошибка при выборе складского места." skip
    14731               return-value skip
    14732               view-as alert-box error .
    14733             undo, return error .
    14734           end.
    14735           if is_reserv-pl-code = yes then do:
    14736           end.
    14737         end.
    14738   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_clcintrn in g#lib-trn
    14739     (
    14740      input parparentproc
    14741     ,input recid(ub.doc-line)
    14742     ,input ub.doc-line.doc-code
    14743     ,input ub.doc-line.artic
    14744     ,input ub.doc-line.prod-type
    14745     ,input ub.doc-line.prod-code
    14746     ,input old-doc-line.price-cli
    14747     ,input old-doc-line.price-rubl
    14748     ,input old-doc-line.price-base
    14749     ,input old-doc-line.cli-qnty
    14750     ,input old-doc-line.cli-base-rate
    14751     ,input old-doc-line.fact-qnty
    14752     ,input old-doc-line.doc-qnty
    14753     ,input old-doc-line.vat-pc
    14754     ,input old-doc-line.slt-pc
    14755     ,input old-doc-line.road-tax
    14756     ,input old-doc-line.excise
    14757     ,input old-doc-line.transport-rubl
    14758     ,input old-doc-line.other-rubl
    14759     ,input 'update'
    14760     ,input ''
    14761     ) no-error.
    14762         if error-status :error then do: undo, return error. end.
    14763         run full-recount in this-procedure no-error.
    14764         if error-status :error then do: undo, return error return-value. end.
    14765      end.
    14766   end.
    14767   END PROCEDURE.
    14768   PROCEDURE choose-bc :
    14769   define variable vss-include-info113 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14770   define variable v-vat-pc        like ub.doc-line.vat-pc    no-undo.
    14771   define variable v-slt-pc        like ub.doc-line.slt-pc    no-undo.
    14772   define variable v-have-slt-pc   as logical                 no-undo.
    14773   define variable v-host-code     like ub.sysconf.host-code  no-undo.
    14774   define variable b-c             as integer                 no-undo.
