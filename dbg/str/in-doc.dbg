    16512     FRAME d-in-doc:SENSITIVE = NO.
    16513   END PROCEDURE.
    16514   PROCEDURE exch-rate :
    16515   display ub.currency.curr-code @ t-doc.exch-code with frame d-in-doc.
    16516   do transaction on error   undo, return error :
    16517      run check-exch   in this-procedure.
    16518      run check-rate   in this-procedure.
    16519      run full-recount in this-procedure.
    16520   end.
    16521   run UI-on in this-procedure ( input "line" ).
    16522   apply "entry" to t-doc.tot-cli.
    16523   END PROCEDURE.
    16524   PROCEDURE fill-tt private :
    16525   define input parameter pardoc-code like ub.trn-doc.doc-code no-undo.
    16526   define buffer bf_trn-doc       for ub.trn-doc.
    16527   define buffer bf_doc-line      for ub.doc-line.
    16528   define buffer bf_doc-line-attr for ub.doc-line-attr.
    16529   define buffer bf_gds-dtl       for ub.gds-dtl.
    16530   define buffer bf_parts         for ub.parts.
    16531   do on error undo, return error return-value :
    16532   find first bf_trn-doc where bf_trn-doc.doc-code = pardoc-code no-lock.
    16533   for each lib-trn_ret-doc:
    16534     delete lib-trn_ret-doc.
    16535   end.
    16536   create lib-trn_ret-doc.
    16537   buffer-copy bf_trn-doc to lib-trn_ret-doc.
    16538   for each lib-trn_ret-line:
    16539     delete lib-trn_ret-line.
    16540   end.
    16541   for each bf_doc-line where bf_doc-line.doc-code = bf_trn-doc.doc-code no-lock :
    16542     create lib-trn_ret-line.
    16543     buffer-copy bf_doc-line except road-tax to lib-trn_ret-line .
    16544     assign
    16545       lib-trn_ret-line.cst-code = bf_trn-doc.cst-code.
    16546   end.
    16547   for each lib-trn_ret-line-attr:
    16548     delete lib-trn_ret-line-attr.
    16549   end.
    16550   for each bf_doc-line-attr where bf_doc-line-attr.doc-code = bf_trn-doc.doc-code
    16551                               and bf_doc-line-attr.attr-code <> 'old_other-ras'
    16552   no-lock :
    16553     create lib-trn_ret-line-attr.
    16554     buffer-copy bf_doc-line-attr to lib-trn_ret-line-attr.
    16555   end.
    16556   for each lib-trn_ret-dtl :
    16557     delete lib-trn_ret-dtl.
    16558   end.
    16559   for each bf_gds-dtl where bf_gds-dtl.doc-code = bf_trn-doc.doc-code :
    16560     create lib-trn_ret-dtl.
    16561     buffer-copy bf_gds-dtl to lib-trn_ret-dtl.
    16562   end.
    16563   for each lib-trn_ret-parts :
    16564     delete lib-trn_ret-parts.
    16565   end.
    16566   for each bf_parts where bf_parts.out-code = bf_trn-doc.doc-code :
    16567     create lib-trn_ret-parts.
    16568     buffer-copy bf_parts to lib-trn_ret-parts.
    16569   end.
    16570   end.
    16571   END PROCEDURE.
    16572   PROCEDURE full-recount :
    16573   for each  ub.doc-line where  ub.doc-line.doc-code = t-doc.doc-code:
    16574   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_in-vat in g#lib-trn
    16575     (
    16576      input   t-doc.doc-code
    16577     ,input   t-doc.base-rate
    16578     ,input   t-doc.base-scale
    16579     ,input   t-doc.exch-rate
    16580     ,input   t-doc.exch-scale
    16581     ,input   t-doc.vat-type
    16582     ,input   t-doc.slt-type
    16583     ,input   ub.doc-line.artic
    16584     ,input   ub.doc-line.prod-type
    16585     ,input   ub.doc-line.prod-code
    16586     ,input   ub.doc-line.price-cli
    16587     ,input   ub.doc-line.cli-base-rate
    16588     ,input   ub.doc-line.price-rubl
    16589     ,input   ub.doc-line.vat-pc
    16590     ,input   ub.doc-line.slt-pc
    16591     ,input   ub.doc-line.road-tax
    16592     ,input   ub.doc-line.transport-rubl
    16593     ,input   ub.doc-line.other-rubl
    16594     ,output  varprice-cli
    16595     ,output  varprice-cli-unit-base
    16596     ,output  varprice-road-tax
    16597     ,output  varprice-other-exp
    16598     ,output  varprice-transport-exp
    16599     ,output  varprice-without-abs
    16600     ,output  varprice-slt
    16601     ,output  varprice-no-slt
    16602     ,output  varprice-vat
    16603     ,output  varprice-no-vat-slt
    16604     ,output  varprice-rubl
    16605     ,output  varprice-road-tax-rubl
    16606     ,output  varprice-other-exp-rubl
    16607     ,output  varprice-transport-exp-rubl
    16608     ,output  varprice-without-abs-rubl
    16609     ,output  varprice-slt-rubl
    16610     ,output  varprice-no-slt-rubl
    16611     ,output  varprice-vat-rubl
    16612     ,output  varprice-no-vat-slt-rubl
    16613     ,output  varprice-base
    16614     ,output  varprice-road-tax-base
    16615     ,output  varprice-other-exp-base
    16616     ,output  varprice-transport-exp-base
    16617     ,output  varprice-without-abs-base
    16618     ,output  varprice-slt-base
    16619     ,output  varprice-no-slt-base
    16620     ,output  varprice-vat-base
    16621     ,output  varprice-no-vat-slt-base
    16622     ) no-error.
    16623     if error-status :error then do:
    16624       return error "Ошибка при пересчете линии документа".
    16625     end.
    16626     assign  ub.doc-line.price-cli  = varprice-cli
    16627             ub.doc-line.price-rubl = varprice-rubl
    16628             ub.doc-line.price-base = varprice-base
    16629            .
    16630   define variable vss-include-info120 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    16631   run find-new-price-sale in this-procedure (
    16632      input  ?
    16633     ,input  ?
    16634     ,input  ub.doc-line.doc-code
    16635     ,input  ub.doc-line.artic
    16636     ,input  ub.doc-line.prod-type
    16637     ,input  ub.doc-line.prod-code
    16638     ,input  ub.doc-line.price-rubl
    16639     ,input  ub.doc-line.price-base
    16640     ,input  varprice-no-vat-slt-rubl
    16641     ,input  varprice-no-vat-slt-base
    16642     ,input-output ub.doc-line.new-price-sale
    16643       )
    16644       no-error .
    16645         if error-status :error then message
    16646           error-status :get-message(1) skip
    16647           return-value skip
    16648           "Нельзя рассчитать новую цену продажи"
    16649           view-as alert-box error
    16650         .
    16651   end.
    16652   run gbl/calc-trn.p ( input parparentproc, input recid( t-doc ) ) no-error.
    16653   if error-status :error then do:
    16654     return error return-value.
    16655   end.
    16656   END PROCEDURE.
    16657   PROCEDURE get-alc-part :
    16658   define input  parameter p-doc-line-recid as recid no-undo.
    16659     define output parameter op-part-code as character no-undo.
    16660     define variable v-gds-code       as integer no-undo.
    16661     define variable v-alcohol-prod   as logical no-undo .
    16662     define buffer bf_doc-line for ub.doc-line.
    16663     define buffer bf_parts    for ub.parts.
    16664     assign
    16665       op-part-code = ?
    16666     .
    16667     do on error undo, return error return-value :
    16668   define variable vss-include-info121 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    16669   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run doclicod in g#library
    16670     (input  p-doc-line-recid
    16671     ,output v-gds-code
    16672     )  .
    16673   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscdat in g#library
    16674     (input  v-gds-code
    16675     ,input  'alcohol-prod=request':u
    16676     ,output v-alcohol-prod
    16677     )  .
    16678       if v-alcohol-prod then do:
    16679         find bf_doc-line no-lock where recid(bf_doc-line) = p-doc-line-recid.
    16680         find first bf_parts no-lock
    16681           where bf_parts.obj-type  = bf_doc-line.obj-type  and
    16682                 bf_parts.obj-code  = bf_doc-line.obj-code  and
    16683                 bf_parts.prod-type = bf_doc-line.prod-type and
    16684                 bf_parts.prod-code = bf_doc-line.prod-code and
    16685                 bf_parts.artic     = bf_doc-line.artic     and
    16686                 bf_parts.out-code  = bf_doc-line.doc-code
    16687           no-error.
    16688         if available bf_parts then do:
    16689           assign
    16690             op-part-code = bf_parts.part-code
    16691           .
    16692         end.
    16693       end.
    16694     end.
    16695   END PROCEDURE.
    16696   PROCEDURE init-attr-general :
