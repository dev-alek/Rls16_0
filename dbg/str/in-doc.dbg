     4867   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4868   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4869   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
     4870   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
     4871   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
     4872   ASSIGN
     4873      v-S_CONTRACT                = "Contract":U
     4874      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
     4875      v-DELIM_CHR_3               = ","
     4876      .
     4877   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     4878   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     4879   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     4880   FUNCTION Can-Find-Spec RETURN LOGICAL (
     4881      INPUT iHost-Code    AS INTEGER,
     4882      INPUT iContract-Num AS INTEGER,
     4883      INPUT iGds-Code     AS INTEGER ):
     4884      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     4885      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     4886      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     4887      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     4888      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     4889      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     4890          INPUT  iHost-Code,
     4891          INPUT  iContract-Num,
     4892          OUTPUT iTmp-Extent3
     4893          ).
     4894      IF iTmp-Extent3[1] = 2 THEN DO:
     4895         ASSIGN
     4896            iTmp-Host-Code      = iTmp-Extent3[2]
     4897            iTmp-Contract-Num   = iTmp-Extent3[3]
     4898            .
     4899      END. ELSE DO:
     4900         ASSIGN
     4901            iTmp-Host-Code      = iHost-Code
     4902            iTmp-Contract-Num   = iContract-Num
     4903            .
     4904      END.
     4905      IF iGds-Code = ? THEN DO:
     4906         ASSIGN
     4907            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     4908                                  buf_Spec.Host-Code     = iTmp-Host-Code
     4909                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     4910                           ).
     4911      END. ELSE DO:
     4912            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     4913                                  buf_Spec.Host-Code     = iTmp-Host-Code
     4914                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     4915                              AND buf_Spec.Gds-Code      = iGds-Code
     4916                            ).
     4917      END.
     4918      RETURN (lRet).
     4919   END FUNCTION.
     4920   PROCEDURE MS-Contract-EXTENT-3:
     4921      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     4922      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     4923      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     4924      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     4925      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     4926      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     4927      FIND FIRST buf_Cont-2 WHERE
     4928                 buf_Cont-2.Host-Code      = i-Host-Code
     4929             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     4930           NO-LOCK NO-ERROR.
     4931      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     4932         RETURN.
     4933      END.
     4934      FOR FIRST buf_Ext-Classif WHERE
     4935                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     4936           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     4937                                               STRING(i-Contract-code)
     4938           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     4939          NO-LOCK,
     4940          EACH buf_Cont WHERE
     4941               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     4942           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     4943          NO-LOCK:
     4944          ASSIGN
     4945             i-Ret[1] = 1
     4946             i-Ret[2] = buf_Cont.Host-code
     4947             i-Ret[3] = buf_Cont.Contract-code
     4948             .
     4949          LEAVE.
     4950      END.
     4951      IF i-Ret[1] <> 1 THEN DO:
     4952         FOR FIRST buf_Ext-Classif WHERE
     4953                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     4954              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     4955                                                  STRING(i-Contract-code)
     4956              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     4957             NO-LOCK,
     4958             EACH buf_Cont WHERE
     4959                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     4960              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     4961             NO-LOCK:
     4962             ASSIGN
     4963                i-Ret[1] = 2
     4964                i-Ret[2] = buf_Cont.Host-code
     4965                i-Ret[3] = buf_Cont.Contract-code
     4966                .
     4967             LEAVE.
     4968         END.
     4969      END.
     4970      RETURN.
     4971   END PROCEDURE.
     4972   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4973   DEFINE VARIABLE v-gl-UVEDOMLENIE as CHARACTER NO-UNDO INITIAL "Uvedomlenie":U.
     4974   FUNCTION Get-Contract-Attr RETURN CHARACTER(
     4975            INPUT iHost-Code AS INTEGER,
     4976            INPUT iContract-Code  AS INTEGER,
     4977            INPUT cAttr-code      AS CHARACTER):
     4978      DEFINE BUFFER buf_Contract-Attr FOR ub.Contract-Attr.
     4979      FIND FIRST buf_Contract-Attr WHERE
     4980                 buf_Contract-Attr.Host-code     = iHost-Code
     4981             AND buf_Contract-Attr.Contract-code = iContract-Code
     4982             AND buf_Contract-Attr.Attr-code     = cAttr-code
     4983           NO-LOCK NO-ERROR.
     4984      RETURN (IF AVAILABLE buf_Contract-Attr THEN buf_Contract-Attr.Attr-value ELSE ?).
     4985   END FUNCTION.
     4986   PROCEDURE Modify-Contract-Attr:
     4987      DEFINE INPUT  PARAMETER iHost-Code      AS INTEGER   NO-UNDO.
     4988      DEFINE INPUT  PARAMETER iContract-Code  AS INTEGER   NO-UNDO.
     4989      DEFINE INPUT  PARAMETER cAttr-code      AS CHARACTER NO-UNDO.
     4990      DEFINE INPUT  PARAMETER cAttr-value     AS CHARACTER NO-UNDO.
     4991      DEFINE OUTPUT PARAMETER cError          AS CHARACTER NO-UNDO INITIAL "".
     4992      DEFINE BUFFER buf_Contract-Attr FOR  ub.Contract-Attr.
     4993      Tran:
     4994      DO TRANSACTION
     4995         ON ENDKEY UNDO Tran, RETRY Tran
     4996         ON ERROR  UNDO Tran, RETRY Tran
     4997         ON QUIT   UNDO Tran, RETRY Tran
     4998         ON STOP   UNDO Tran, RETRY Tran:
     4999         IF RETRY THEN DO:       cError = "Ошибка транзакции:":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     5000         FIND FIRST buf_Contract-Attr WHERE
     5001                    buf_Contract-Attr.Host-Code      = iHost-Code
     5002                AND buf_Contract-Attr.Contract-Code  = iContract-Code
     5003                AND buf_Contract-Attr.Attr-code      = cAttr-code
     5004              NO-LOCK NO-ERROR.
     5005         IF NOT AVAILABLE buf_Contract-Attr THEN DO:
     5006            CREATE buf_Contract-Attr NO-ERROR.
     5007            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     5008         END. ELSE DO:
     5009            FIND CURRENT buf_Contract-Attr EXCLUSIVE-LOCK NO-ERROR.
     5010            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     5011         END.
     5012         ASSIGN
     5013            buf_Contract-Attr.Host-Code      = iHost-Code
     5014            buf_Contract-Attr.Contract-Code  = iContract-Code
     5015            buf_Contract-Attr.Attr-code      = cAttr-code
     5016            buf_Contract-Attr.Attr-value     = cAttr-value
     5017            NO-ERROR.
     5018         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     5019         RELEASE buf_Contract-Attr NO-ERROR.
     5020         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     5021      END.
     5022      RETURN.
     5023   END PROCEDURE.
     5024   PROCEDURE Create-Contract-Attr:
     5025      DEFINE INPUT  PARAMETER iHost-Code      AS INTEGER   NO-UNDO.
     5026      DEFINE INPUT  PARAMETER iContract-Code  AS INTEGER   NO-UNDO.
     5027      DEFINE INPUT  PARAMETER cAttr-code      AS CHARACTER NO-UNDO.
     5028      DEFINE INPUT  PARAMETER cAttr-value     AS CHARACTER NO-UNDO.
     5029      DEFINE OUTPUT PARAMETER cError          AS CHARACTER NO-UNDO INITIAL "".
     5030      DEFINE BUFFER buf_Contract-Attr FOR  ub.Contract-Attr.
     5031      Tran:
     5032      DO TRANSACTION
     5033         ON ENDKEY UNDO Tran, RETRY Tran
     5034         ON ERROR  UNDO Tran, RETRY Tran
     5035         ON QUIT   UNDO Tran, RETRY Tran
     5036         ON STOP   UNDO Tran, RETRY Tran:
     5037         IF RETRY THEN DO:       cError = "Ошибка транзакции:":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     5038         CREATE buf_Contract-Attr NO-ERROR.
     5039         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     5040         ASSIGN
     5041            buf_Contract-Attr.Host-Code      = iHost-Code
     5042            buf_Contract-Attr.Contract-Code  = iContract-Code
     5043            buf_Contract-Attr.Attr-code      = cAttr-code
     5044            buf_Contract-Attr.Attr-value     = cAttr-value
     5045            NO-ERROR.
     5046         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     5047         RELEASE buf_Contract-Attr NO-ERROR.
     5048         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     5049      END.
     5050      RETURN.
     5051   END PROCEDURE.
     5052   FUNCTION Is-MS-Contract RETURN LOGICAL(BUFFER buf_Master FOR ub.Contract, BUFFER buf_Slave  FOR ub.Contract) FORWARD.
     5053   FUNCTION Is-Master-Slave-Contract RETURN CHARACTER( BUFFER buf_Contract FOR ub.Contract) FORWARD.
     5054   FUNCTION Is-MS-Contract-Int RETURN INTEGER (BUFFER buf_Contract FOR ub.Contract) FORWARD.
     5055   PROCEDURE Delete-Contract-Specif:
     5056      DEFINE PARAMETER BUFFER buf_Contract FOR ub.Contract.
     5057      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     5058      DEFINE BUFFER buf_Specif      FOR ub.Contract-Specif.
     5059      DEFINE BUFFER buf_Specif-Attr FOR ub.Contract-Specif-Attr.
     5060      Tran:
     5061      DO TRANSACTION
     5062         ON ENDKEY UNDO Tran, RETRY Tran
     5063         ON ERROR  UNDO Tran, RETRY Tran
     5064         ON QUIT   UNDO Tran, RETRY Tran
     5065         ON STOP   UNDO Tran, RETRY Tran:
     5066         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     5067         FOR EACH buf_Specif-Attr WHERE
     5068                  buf_Specif-Attr.Host-code     = buf_Contract.Host-code
     5069              AND buf_Specif-Attr.Contract-Num  = buf_Contract.Contract-code
     5070             EXCLUSIVE-LOCK:
     5071             DELETE buf_Specif-Attr NO-ERROR.
     5072             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     5073         END.
     5074         FOR EACH buf_Specif WHERE
     5075                  buf_Specif.Host-code     = buf_Contract.Host-code
     5076              AND buf_Specif.Contract-Num  = buf_Contract.Contract-code
     5077             EXCLUSIVE-LOCK:
     5078             DELETE buf_Specif NO-ERROR.
     5079            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     5080         END.
     5081      END.
     5082      RETURN.
     5083   END PROCEDURE.
     5084   PROCEDURE Modify-Slave-Contract:
     5085      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
     5086      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     5087      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     5088      DEFINE BUFFER buf_Slave FOR ub.Contract.
     5089      Tran:
     5090      DO TRANSACTION
     5091         ON ENDKEY UNDO Tran, RETRY Tran
     5092         ON ERROR  UNDO Tran, RETRY Tran
     5093         ON QUIT   UNDO Tran, RETRY Tran
     5094         ON STOP   UNDO Tran, RETRY Tran:
     5095         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     5096         FOR EACH buf_Ext-Classif WHERE
     5097                  buf_Ext-Classif.Classif-name = v-S_CONTRACT
     5098              AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     5099              AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     5100             NO-LOCK,
     5101             FIRST buf_Slave WHERE
     5102                   buf_Slave.Host-Code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     5103               AND buf_Slave.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     5104             EXCLUSIVE-LOCK:
     5105             BUFFER-COPY
     5106               buf_Master
     5107             EXCEPT
     5108               Host-code                               Contract-code                           Own-name                                an-uchet-code-out                       cel-nazn-code-out                       cor-acc-out                             cor-acc1-out                            an-uchet-code-in                        cel-nazn-code-in                        cor-acc-in                              cor-acc1-in                             an-uchet-code-out-cash                  cel-nazn-code-out-cash                  cor-acc-out-cash                        cor-acc1-out-cash                       an-uchet-code-in-cash                   cel-nazn-code-in-cash                   cor-acc-in-cash                         cor-acc1-in-cash                        an-uchet-code-out-payoff                cel-nazn-code-out-payoff                cor-acc-out-payoff                      cor-acc1-out-payoff                     an-uchet-code-in-payoff                 cel-nazn-code-in-payoff                 cor-acc-in-payoff                       cor-acc1-in-payoff                      transport-cli-type                      transport-cli-code                      transport-host                          transport-contract                      transport-uslov                         transport-value                         own-code-schet-start                    own-sign-post                           own-sign                                contract-city                           fin-VAT-pc                              srok-opl                                gen-factur-srok                         own-addres                              own-inn                                 own-kpp
     5109             TO buf_Slave
     5110             NO-ERROR.
     5111             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     5112             RELEASE buf_Slave NO-ERROR.
     5113             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     5114         END.
     5115      END.
     5116      RETURN.
     5117   END PROCEDURE.
     5118   PROCEDURE Change-Stat-Slave-Contract:
     5119      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
     5120      DEFINE INPUT PARAMETER cStatus  AS CHARACTER NO-UNDO.
     5121      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     5122      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     5123      DEFINE BUFFER buf_Slave FOR ub.Contract.
     5124      Tran:
     5125      DO TRANSACTION
     5126         ON ENDKEY UNDO Tran, RETRY Tran
     5127         ON ERROR  UNDO Tran, RETRY Tran
     5128         ON QUIT   UNDO Tran, RETRY Tran
     5129         ON STOP   UNDO Tran, RETRY Tran:
     5130         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     5131         FOR EACH buf_Ext-Classif WHERE
     5132                  buf_Ext-Classif.Classif-name = v-S_CONTRACT
     5133              AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     5134              AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     5135             NO-LOCK,
     5136             FIRST buf_Slave WHERE
     5137                   buf_Slave.Host-Code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     5138               AND buf_Slave.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     5139             EXCLUSIVE-LOCK:
     5140             ASSIGN
     5141                buf_Slave.Status_ = cStatus
     5142                NO-ERROR.
     5143             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     5144             RELEASE buf_Slave NO-ERROR.
     5145             IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     5146         END.
     5147      END.
     5148      RETURN.
     5149   END PROCEDURE.
     5150   PROCEDURE Delete-Ref-Master-Slave:
     5151      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
     5152      DEFINE PARAMETER BUFFER buf_Slave  FOR ub.Contract.
     5153      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     5154      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     5155      IF NOT Is-MS-Contract(BUFFER buf_Master, BUFFER buf_Slave) THEN DO:
     5156         cError = PROGRAM-NAME(1) + ":" + "Между договорами нет связи Master->Slave".
     5157         RETURN.
     5158      END.
     5159      Tran:
     5160      FOR FIRST buf_Ext-Classif WHERE
     5161                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     5162            AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     5163            AND buf_Ext-Classif.CharKey_Two  = STRING(buf_Slave.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Slave.Contract-code)
     5164            AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     5165          EXCLUSIVE-LOCK
     5166          TRANSACTION
     5167          ON ENDKEY UNDO Tran, RETRY Tran
     5168          ON ERROR  UNDO Tran, RETRY Tran
     5169          ON QUIT   UNDO Tran, RETRY Tran
     5170          ON STOP   UNDO Tran, RETRY Tran:
     5171          IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     5172          DELETE buf_Ext-Classif NO-ERROR.
     5173          IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     5174      END.
     5175      RETURN.
     5176   END PROCEDURE.
     5177   PROCEDURE Create-Ref-Master-Slave:
     5178      DEFINE PARAMETER BUFFER buf_Master FOR ub.Contract.
     5179      DEFINE PARAMETER BUFFER buf_Slave  FOR ub.Contract.
     5180      DEFINE OUTPUT PARAMETER cError AS CHARACTER NO-UNDO INITIAL "".
     5181      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     5182      DEFINE VARIABLE cKeyRec AS CHARACTER NO-UNDO INITIAL "".
     5183      IF Is-MS-Contract(BUFFER buf_Master, BUFFER buf_Slave) THEN DO:
     5184         cError = PROGRAM-NAME(1) + ":" + "Между договорами  уже есть связь Master->Slave".
     5185         RETURN.
     5186      END.
     5187      RUN gen-key-rec IN THIS-PROCEDURE(
     5188          INPUT  v-S_CONTRACT,
     5189          INPUT  BUFFER buf_Master:HANDLE,
     5190          OUTPUT cKeyRec
     5191          ) NO-ERROR.
     5192      IF ERROR-STATUS:ERROR THEN DO:
     5193         cError = PROGRAM-NAME(1) + ":" + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.
     5194         RETURN.
     5195      END.
     5196      Tran:
     5197      DO TRANSACTION
     5198         ON ENDKEY UNDO Tran, RETRY Tran
     5199         ON ERROR  UNDO Tran, RETRY Tran
     5200         ON QUIT   UNDO Tran, RETRY Tran
     5201         ON STOP   UNDO Tran, RETRY Tran:
     5202         IF RETRY THEN DO:       cError = "Ошибка транзакции ":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     5203         CREATE buf_Ext-Classif NO-ERROR.
     5204         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     5205         ASSIGN
     5206            buf_Ext-Classif.Classif-name    = v-S_CONTRACT
     5207            buf_Ext-Classif.Classif-subject = v-S_CONTRACT
     5208            buf_Ext-Classif.CharKey_One     = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     5209            buf_Ext-Classif.CharKey_Two     = STRING(buf_Slave.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Slave.Contract-code)
     5210            buf_Ext-Classif.DB-num          = buf_Master.Db-num
     5211            buf_Ext-Classif.Uniq-key-rec    = cKeyRec
     5212            NO-ERROR.
     5213         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     5214         RELEASE buf_Ext-Classif NO-ERROR.
     5215         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     5216      END.
     5217      RETURN.
     5218   END PROCEDURE.
     5219   FUNCTION Is-MS-Contract-Int-2 RETURN INTEGER (
     5220                                 i-Host-Code AS INTEGER,
     5221                                 i-Contract-Code AS INTEGER):
     5222      DEFINE BUFFER buf_Contract FOR ub.Contract.
     5223      DEFINE VARIABLE iRet AS INTEGER NO-UNDO INITIAL 0.
     5224      FIND FIRST buf_Contract WHERE
     5225                 buf_Contract.Host-Code      = i-Host-Code
     5226             AND buf_Contract.Contract-code  = i-Contract-Code
     5227           NO-LOCK NO-ERROR.
     5228      IF AVAILABLE buf_Contract THEN DO:
     5229         ASSIGN
     5230            iRet = Is-MS-Contract-Int(BUFFER buf_Contract).
     5231      END.
     5232      RETURN (iRet).
     5233   END FUNCTION.
     5234   FUNCTION Is-MS-Contract-Int RETURN INTEGER (BUFFER buf_Contract FOR ub.Contract):
     5235      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     5236      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     5237      DEFINE VARIABLE iRet AS INTEGER NO-UNDO INITIAL 0.
     5238      FOR FIRST buf_Ext-Classif WHERE
     5239                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     5240           AND  buf_Ext-Classif.CharKey_One  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
     5241                                               STRING(buf_Contract.contract-code)
     5242           AND  buf_Ext-classif.db-num       = buf_Contract.db-num
     5243          NO-LOCK,
     5244          EACH buf_Cont WHERE
     5245               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     5246           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     5247          NO-LOCK:
     5248          ASSIGN
     5249             iRet = 1.
     5250          LEAVE.
     5251      END.
     5252      IF iRet <> 1 THEN DO:
     5253         FOR FIRST buf_Ext-Classif WHERE
     5254                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     5255              AND  buf_Ext-Classif.CharKey_Two  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
     5256                                                  STRING(buf_Contract.contract-code)
     5257              AND  buf_Ext-classif.db-num       = buf_Contract.db-num
     5258             NO-LOCK,
     5259             EACH buf_Cont WHERE
     5260                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     5261              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     5262             NO-LOCK:
     5263             ASSIGN
     5264                iRet = 2.
     5265             LEAVE.
     5266         END.
     5267      END.
     5268      RETURN (iRet).
     5269   END FUNCTION.
     5270   FUNCTION Is-Master-Slave-Contract RETURN CHARACTER( BUFFER buf_Contract FOR ub.Contract):
     5271      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     5272      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     5273      DEFINE VARIABLE cRet AS CHARACTER NO-UNDO INITIAL "".
     5274      FOR FIRST buf_Ext-Classif WHERE
     5275                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     5276           AND  buf_Ext-Classif.CharKey_One  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
     5277                                               STRING(buf_Contract.contract-code)
     5278           AND  buf_Ext-classif.db-num       = buf_Contract.db-num
     5279          NO-LOCK,
     5280          EACH buf_Cont WHERE
     5281               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     5282           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     5283          NO-LOCK:
     5284          ASSIGN
     5285             cRet = "+".
     5286          LEAVE.
     5287      END.
     5288      IF cRet = "" THEN DO:
     5289         FOR FIRST buf_Ext-Classif WHERE
     5290                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     5291              AND  buf_Ext-Classif.CharKey_Two  = STRING(buf_Contract.Host-code) + v-DELIM_CHR_3 +
     5292                                                  STRING(buf_Contract.contract-code)
     5293              AND  buf_Ext-classif.db-num       = buf_Contract.db-num
     5294             NO-LOCK,
     5295             EACH buf_Cont WHERE
     5296                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     5297              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     5298             NO-LOCK:
     5299             ASSIGN
     5300                cRet = (IF buf_Cont.Contract-prn-code = "" THEN  STRING(buf_Cont.Contract-code) ELSE buf_Cont.Contract-prn-code).
     5301             LEAVE.
     5302         END.
     5303      END.
     5304      RETURN (cRet).
     5305   END FUNCTION.
     5306   FUNCTION Is-MS-Contract RETURN LOGICAL(
     5307            BUFFER buf_Master FOR ub.Contract,
     5308            BUFFER buf_Slave  FOR ub.Contract):
     5309      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     5310      RETURN CAN-FIND ( FIRST buf_Ext-Classif WHERE
     5311                          buf_Ext-Classif.Classif-name = v-S_CONTRACT
     5312                      AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code) + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     5313                      AND buf_Ext-Classif.CharKey_Two  = STRING(buf_Slave.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Slave.Contract-code)
     5314                      AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     5315                    NO-LOCK).
     5316   END FUNCTION.
     5317   FUNCTION Get-Num-Slave-Contract RETURN CHARACTER(
     5318            BUFFER buf_Master FOR ub.Contract,
     5319            INPUT iSlave-Host-Code AS INTEGER
     5320            ):
     5321      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-classif.
     5322      DEFINE BUFFER buf_Contract    FOR ub.Contract.
     5323      DEFINE VARIABLE cRet AS CHARACTER NO-UNDO INITIAL "".
     5324      FIND FIRST buf_Ext-Classif WHERE
     5325                 buf_Ext-Classif.Classif-name = v-S_CONTRACT
     5326             AND buf_Ext-Classif.CharKey_One  = STRING(buf_Master.Host-Code)  + v-DELIM_CHR_3 + STRING(buf_Master.Contract-code)
     5327             AND buf_Ext-Classif.CharKey_Two  BEGINS STRING(iSlave-Host-Code) + v-DELIM_CHR_3
     5328             AND buf_Ext-Classif.DB-num       = buf_Master.Db-num
     5329           NO-LOCK NO-ERROR.
     5330      IF AVAILABLE buf_Ext-Classif THEN DO:
     5331         IF CAN-FIND (FIRST buf_Contract WHERE
     5332                            buf_Contract.Host-Code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     5333                        AND buf_Contract.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     5334                       NO-LOCK) THEN DO:
     5335            ASSIGN
     5336               cRet = ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3).
     5337         END. ELSE DO:
     5338            ASSIGN
     5339               cRet = "ERROR:" + "Ошибка связи мастер договора " +
     5340                      STRING(buf_Master.Host-Code) + "," + STRING(buf_Master.Contract-code) + " " +
     5341                      "c Host-code=" + STRING(iSlave-Host-Code).
     5342         END.
     5343      END.
     5344      RETURN (cRet).
     5345   END FUNCTION.
     5346   DEFINE VARIABLE mImagePath     AS CHARACTER   NO-UNDO.
     5347   DEFINE VARIABLE mImageDir      AS CHARACTER   NO-UNDO.
     5348   DEFINE VARIABLE mImagePreDir   AS CHARACTER   NO-UNDO.
     5349   DEFINE VARIABLE mImageTrash    AS CHARACTER   NO-UNDO.
     5350   DEFINE VARIABLE mPhotomgd      AS LOGICAL     NO-UNDO.
     5351   DEFINE VARIABLE mImagePh       AS LOGICAL     NO-UNDO.
     5352   define variable v-param-types   as character  no-undo.
     5353   define variable v-value-char    as character  no-undo.
     5354   define variable v-val-date      as date       no-undo.
     5355   define variable v-val-decimal   as decimal    no-undo.
     5356   define variable v-val-integer   as integer    no-undo.
     5357   define variable v-val-logical   as logical    no-undo.
     5358   define variable v-tthd          as handle     no-undo.
     5359   RUN imagelist_loaddef IN THIS-PROCEDURE NO-ERROR.
     5360   PROCEDURE imagelist_loaddef:
     5361       DEFINE VARIABLE vPar-val       AS CHARACTER   NO-UNDO.
     5362       DEFINE VARIABLE vPar-type      AS CHARACTER   NO-UNDO.
     5363       ASSIGN
     5364           vPar-val  = "":U
     5365           vPar-type = "":U
     5366           .
     5367   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     5368     (input  'photo':u
     5369     ,input  '':u
     5370     ,input  '':u
     5371     ,input  0
     5372     ,input  '':u
     5373     ,input  '':u
     5374     ,input  '':u
     5375     ,input  no
     5376     ,output vPar-val
     5377     ,output vPar-type
     5378     ) no-error .
     5379           mImagePh = LOOKUP (vPar-val, "true,yes":U) > 0.
     5380       IF mImagePh THEN .
     5381       ELSE RETURN.
     5382       ASSIGN
     5383           vPar-val  = "":U
     5384           vPar-type = "":U
     5385           .
     5386   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     5387     (input  'ph-dir':u
     5388     ,input  '':u
     5389     ,input  '':u
     5390     ,input  0
     5391     ,input  '':u
     5392     ,input  '':u
     5393     ,input  '':u
     5394     ,input  NO
     5395     ,output vPar-val
     5396     ,output vPar-type
     5397     ) no-error .
     5398       IF LENGTH (vPar-val) = 0 THEN
     5399           RUN verify-ini-entry("ph-dir":U, "REP-SETS":U, "":U, YES, OUTPUT vPar-val) NO-ERROR.
     5400       IF LENGTH (vPar-val) = 0 THEN vPar-val = "c:\temp\":U.
     5401       ASSIGN
     5402           mImagePath   = RIGHT-TRIM (vPar-val, "~\~/":U)
     5403           mImagePath   = mImagePath + (IF LENGTH (mImagePath) > 0 THEN "\":U ELSE "":U)
     5404           mImagePreDir = mImagePath
     5405           mImageDir    = mImagePreDir
     5406           mImageTrash  = mImagePath + "trash\":U
     5407           .
     5408       ASSIGN
     5409           vPar-val  = "":U
     5410           vPar-type = "":U
     5411           .
     5412               run adm/shattri.p (
     5413           input "get":U
     5414           ,input  '':U
     5415           ,input  0
     5416           ,input  'gds-ref':U
     5417           ,input  'shema-foto':U
     5418           ,output v-value-char
     5419           ,output v-val-date
     5420           ,output v-val-decimal
     5421           ,output v-val-integer
     5422           ,output v-val-logical
     5423           ,output v-param-types
     5424           ,INPUT-OUTPUT table-handle v-tthd
     5425           ) no-error.
     5426           delete object v-tthd.
     5427           mPhotomgd = IF v-val-integer = 2 then yes else no.
     5428   END PROCEDURE.
     5429   PROCEDURE imagelist_decode:
     5430       DEFINE INPUT  PARAMETER iImageList AS LONGCHAR  NO-UNDO.
     5431       DEFINE INPUT  PARAMETER iImageGdsCode AS int    NO-UNDO.
     5432       DEFINE OUTPUT PARAMETER oImageList AS LONGCHAR  NO-UNDO.
     5433       DEFINE VARIABLE vCh                AS CHARACTER NO-UNDO.
     5434       DEFINE VARIABLE vInt               AS INTEGER   NO-UNDO.
     5435       ASSIGN
     5436           oImageList = iImageList
     5437           .
     5438       DO vInt = 1 TO NUM-ENTRIES (iImageList, ",":U):
     5439           vCh =ENTRY (vInt, iImageList, ",":U).
     5440           IF SUBSTRING (vCh, 1, 2) = "~\~\":U THEN .
     5441           ELSE
     5442           DO:
     5443               ASSIGN
     5444                   vCh = REPLACE (vCh, "~/":U, "\":U)
     5445                   vCh = REPLACE (vCh, "~\":U, "\":U)
     5446                   .
     5447               IF SUBSTRING (vCh, 2, 2) = ":\":U OR vCh BEGINS mImageDir THEN .
     5448               ELSE vCh = mImagePreDir + (if mPhotomgd then string(iImageGdsCode) + "\":U else '':U ) +  vCh.
     5449               ENTRY (vInt, oImageList, ",":U) = vCh.
     5450           END.
     5451       END.
     5452   END PROCEDURE.
     5453   PROCEDURE imagelist_encode:
     5454       DEFINE INPUT  PARAMETER iImageList AS LONGCHAR  NO-UNDO.
     5455       DEFINE OUTPUT PARAMETER oImageList AS LONGCHAR  NO-UNDO.
     5456       DEFINE VARIABLE vCh                AS CHARACTER NO-UNDO.
     5457       DEFINE VARIABLE vInt               AS INTEGER   NO-UNDO.
     5458       DEFINE VARIABLE vLen               AS INTEGER   NO-UNDO.
     5459       ASSIGN
     5460           oImageList = iImageList
     5461           vLen       = LENGTH (mImageDir)
     5462           .
     5463       DO vInt = 1 TO NUM-ENTRIES (iImageList, ",":U):
     5464           vCh =ENTRY (vInt, iImageList, ",":U).
     5465           IF LENGTH (vCh) > 0 AND vLen > 0 AND vCh BEGINS mImageDir THEN
     5466               ENTRY (vInt, oImageList, ",":U) =
     5467                   SUBSTRING (vCh, vLen + 1).
     5468       END.
     5469   END PROCEDURE.
