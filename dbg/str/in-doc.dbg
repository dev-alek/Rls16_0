    16725   PROCEDURE inv-line_price :
    16726   define  input parameter p-doc-line-rec as   recid                  no-undo.
    16727     define  input parameter p-print-rubl   as   logical                no-undo.
    16728     define output parameter p-out-price-kg like ub.doc-line.price-rubl no-undo initial 0.0.
    16729     define variable p-inv-line-rec as recid   no-undo.
    16730     define variable is-petrol      as logical no-undo.
    16731     define variable is-pieces      as logical no-undo.
    16732     define buffer buf_inv-line for ub.inv-line.
    16733     define buffer buf_doc-line for ub.doc-line.
    16734     do on error undo, return error return-value :
    16735       find buf_doc-line       no-lock where recid( buf_doc-line ) = p-doc-line-rec no-error.
    16736       if not available buf_doc-line then do:
    16737         assign p-out-price-kg = ?.
    16738         undo, return error "inv-line_price: не найдена строка накладной".
    16739       end.
    16740   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
    16741     (
    16742        input buf_doc-line.artic
    16743     ,  input buf_doc-line.prod-type
    16744     ,  input buf_doc-line.prod-code
    16745     , output is-petrol
    16746     , output is-pieces
    16747     ) no-error.
    16748       if error-status :error or v-is-ptrl <> "yes" or is-petrol <> yes or is-pieces <> no then do:
    16749         undo, return error substitute( 'inv-line_price: &1 (произв. &2 &3) не топливный товар',
    16750                                        buf_doc-line.artic, buf_doc-line.prod-type, buf_doc-line.prod-code ).
    16751       end.
    16752       find buf_inv-line no-lock where
    16753            buf_inv-line.doc-code  = buf_doc-line.doc-code  and
    16754            buf_inv-line.artic     = buf_doc-line.artic     and
    16755            buf_inv-line.prod-code = buf_doc-line.prod-code and
    16756            buf_inv-line.prod-type = buf_doc-line.prod-type no-error.
    16757       if available buf_inv-line then do:
    16758         assign
    16759           p-inv-line-rec = recid( buf_inv-line )
    16760         .
    16761         find buf_doc-line exclusive-lock where recid( buf_doc-line ) = p-doc-line-rec.
    16762         find buf_inv-line exclusive-lock where recid( buf_inv-line ) = p-inv-line-rec.
    16763         assign
    16764           p-out-price-kg = ( if p-print-rubl = yes then buf_inv-line.wast-rubl else buf_inv-line.wast-base )
    16765         .
    16766         find buf_inv-line        no-lock where recid( buf_inv-line ) = p-inv-line-rec.
    16767         find buf_doc-line        no-lock where recid( buf_doc-line ) = p-doc-line-rec.
    16768         release buf_inv-line.
    16769         release buf_doc-line.
    16770       end.
    16771     end.
    16772   END PROCEDURE.
    16773   PROCEDURE inv-line_qnty :
    16774   define  input parameter p-doc-line-rec as   recid                 no-undo.
    16775     define output parameter p-out-qnty-kg  like ub.doc-line.fact-qnty no-undo initial 0.0.
    16776     define variable is-petrol as logical no-undo.
    16777     define variable is-pieces as logical no-undo.
    16778     define buffer buf_inv-line for ub.inv-line.
    16779     define buffer buf_doc-line for ub.doc-line.
    16780     do on error undo, return error return-value :
    16781       find buf_doc-line no-lock where recid( buf_doc-line ) = p-doc-line-rec no-error.
    16782       if not available buf_doc-line then do:
    16783         assign p-out-qnty-kg = ?.
    16784         undo, return error "inv-line_qnty: не найдена строка накладной".
    16785       end.
    16786   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
    16787     (
    16788        input buf_doc-line.artic
    16789     ,  input buf_doc-line.prod-type
    16790     ,  input buf_doc-line.prod-code
    16791     , output is-petrol
    16792     , output is-pieces
    16793     ) no-error.
    16794       if error-status :error or v-is-ptrl <> "yes" or is-petrol <> yes or is-pieces <> no then do:
    16795         undo, return error substitute( 'inv-line_qnty: &1 (произв. &2 &3) не топливный товар',
    16796                                        buf_doc-line.artic, buf_doc-line.prod-type, buf_doc-line.prod-code ).
    16797       end.
    16798       find buf_inv-line no-lock where
    16799            buf_inv-line.doc-code  = buf_doc-line.doc-code  and
    16800            buf_inv-line.artic     = buf_doc-line.artic     and
    16801            buf_inv-line.prod-code = buf_doc-line.prod-code and
    16802            buf_inv-line.prod-type = buf_doc-line.prod-type no-error.
    16803       if available buf_inv-line then do: assign p-out-qnty-kg = buf_inv-line.wast-cli-qnty. end.
    16804     end.
    16805   END PROCEDURE.
    16806   PROCEDURE live-loc :
    16807   define variable to-date as date no-undo.
    16808   define variable vss-include-info122 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    16809   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdtget in g#library
    16810     (input  t-doc.obj-type
    16811     ,input  t-doc.obj-code
    16812     ,output to-date
    16813     ) no-error .
    16814     if error-status :error then do:
    16815       assign to-date = today.
    16816     end.
    16817     find first supplier no-lock where
    16818                supplier.obj-code = t-doc.cli-code and
    16819                supplier.obj-type = t-doc.cli-type no-error .
    16820     run rep/vs-part1.w (
    16821         input parparentproc,
    16822         input v-cntxt-obj-type,
    16823         input v-cntxt-obj-code,
    16824         input t-doc.doc-date,
    16825         input to-date,
    16826         input 'все':U,
    16827         input t-doc.doc-code)
    16828         .
    16829   END PROCEDURE.
    16830   PROCEDURE local-add-doc :
    16831   define buffer buf_add-doc for ub.add-doc .
    16832   define buffer buf_add-trn for ub.add-trn .
    16833   define variable v-recid as recid no-undo .
    16834   define variable v-mode as character no-undo .
    16835   define variable v-doc-code-add as character no-undo .
    16836   define variable v-today as date  no-undo .
    16837   define variable v-m as character no-undo .
    16838   define variable v-new as logical   no-undo .
    16839   v-m =  'ПРОСМОТР':U .
    16840   v-new = false  .
    16841   if pardoc-mode = 'ПРОСМОТР':U then v-mode = pardoc-mode .
    16842                              else v-mode = 'ИЗМЕНЕНИЕ':U .
    16843   find first buf_add-trn no-lock where buf_add-trn.trn-doc-code =  t-doc.doc-code no-error .
    16844   if not available buf_add-trn then do:
    16845      if v-mode = 'ПРОСМОТР':U then return .
    16846       define variable obj-db-num as integer   no-undo .
    16847   define variable vss-include-info123 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    16848   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
    16849     (input  v-cntxt-obj-type
    16850     ,input  v-cntxt-obj-code
    16851     ,output obj-db-num
    16852     )  .
    16853            if obj-db-num <> v-cntxt-db-num then do:
    16854               message 'Создание ДопРасхода  только на активной стороне' view-as alert-box information .
    16855               return .
    16856            end.
    16857      message 'Создавать новый документ дополнительных расходов ?'
    16858               view-as alert-box question
    16859               buttons yes-no
    16860               update v-ok as logical
    16861               .
    16862      if v-ok = false then return .
    16863   define variable vss-include-info124 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    16864   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
    16865     (input  v-cntxt-obj-type
    16866     ,input  v-cntxt-obj-code
    16867     ,output v-today
    16868     )  .
    16869      v-new = true .
    16870      run doc-code in this-procedure
    16871        ( input "main":U
    16872         ,input v-cntxt-obj-type
    16873         ,input v-cntxt-obj-code
    16874         ,input ?
    16875         ,output v-doc-code-add
    16876        ) no-error.
    16877     if error-status :error then do:
    16878       message
    16879         "Ошибка при генерации номера документа."
    16880         view-as alert-box error.
    16881       return error.
    16882     end.
    16883      create ub.add-doc.
    16884      assign
    16885        ub.add-doc.doc-code   = v-doc-code-add
    16886        ub.add-doc.base-rate  = t-doc.base-rate
    16887        ub.add-doc.base-scale = t-doc.base-scale
    16888        ub.add-doc.cr-db-num  = v-cntxt-db-num
    16889        ub.add-doc.doc-date   = v-today
    16890        ub.add-doc.exch-code  = if t-doc.exch-code = ?  then 0 else t-doc.exch-code
    16891        ub.add-doc.exch-date  = v-today
    16892        ub.add-doc.exch-rate  = if t-doc.exch-rate = ? or t-doc.exch-rate = 0 then 1 else t-doc.exch-rate
    16893        ub.add-doc.exch-scale = if t-doc.exch-scale = ? or t-doc.exch-scale = 0 then 1 else t-doc.exch-scale
    16894        ub.add-doc.host-code  = v-cntxt-host-code-obj
    16895        ub.add-doc.obj-code   = v-cntxt-obj-code
    16896        ub.add-doc.obj-type   = v-cntxt-obj-type
    16897        ub.add-doc.status_    = 'новый':U
    16898        ub.add-doc.VAT-type   = t-doc.VAT-type
    16899      .
    16900      create buf_add-trn .
    16901      assign
    16902        buf_add-trn.doc-code = v-doc-code-add
    16903        buf_add-trn.trn-doc-code = t-doc.doc-code
    16904      .
    16905   end.
    16906   else do:
    16907      v-doc-code-add = buf_add-trn.doc-code .
    16908   end.
    16909   find first buf_add-doc exclusive-lock where
    16910              buf_add-doc.doc-code = v-doc-code-add
    16911              no-error .
    16912   if available buf_add-doc then do:
    16913       v-recid = recid (buf_add-doc) .
    16914       v-m = if buf_add-doc.status_ <> 'новый':U then 'ПРОСМОТР':U else ( if pardoc-mode = 'ДОБАВЛЕНИЕ':U then 'ИЗМЕНЕНИЕ':U else pardoc-mode )  .
    16915       run str/add-docu.w
    16916         ( input parparentproc ,
    16917           input-output  v-recid ,
    16918           input v-m ,
    16919           input t-doc.doc-code
    16920           ).
    16921     if v-new = true and v-recid = ? then do:
    16922         find first buf_add-doc exclusive-lock where
    16923                   buf_add-doc.doc-code = v-doc-code-add no-error .
    16924        delete buf_add-doc .
    16925     end.
    16926   end.
    16927   release buf_add-doc .
    16928   if can-find (first ub.add-trn no-lock where
    16929                         ub.add-trn.doc-code      = v-doc-code-add  and
    16930                         ub.add-trn.trn-doc-code  = t-doc.doc-code )
    16931                         then do:
    16932       enable b-add-doc-yes with frame d-in-doc .
    16933       display b-add-doc-yes with frame d-in-doc .
    16934   end.
    16935   else hide b-add-doc-yes in frame d-in-doc .
    16936   if v-m = 'ПРОСМОТР':U then return .
    16937   find first buf_add-doc no-lock where
    16938              buf_add-doc.doc-code = v-doc-code-add no-error .
    16939   if not available buf_add-doc then return .
    16940   if buf_add-doc.status_  = 'новый':U
    16941   then do:
    16942      if can-find (first ub.add-line no-lock where
    16943                         ub.add-line.doc-code  = buf_add-doc.doc-code ) and
    16944         can-find (first ub.add-trn no-lock where
    16945                         ub.add-trn.doc-code      = buf_add-doc.doc-code  and
    16946                         ub.add-trn.trn-doc-code  = t-doc.doc-code )
    16947                         then do:
    16948        message
    16949         substitute("Закрыть  ДопРасх № &1 до статуса ЗАКРЫТО ? " ,buf_add-doc.doc-code  )
    16950         view-as alert-box question
    16951         buttons yes-no
    16952         update vok as log
    16953        .
    16954        if vok = false then return .
    16955           run str/addclos.p
    16956               ( input Parparentproc,
    16957                 recid(buf_add-doc)
    16958               ) .
    16959            end.
    16960   end.
    16961   END PROCEDURE.
    16962   PROCEDURE local-arh :
    16963     run str/docsuppn.w
    16964       (input  parparentproc
    16965       ,input  recid(t-doc)
    16966       ).
    16967   END PROCEDURE.
    16968   PROCEDURE local-bc :
    16969   if t-doc.status_ = 'накл':U and
    16970       t-doc.flag_   = no      then do:
    16971       run add-bc in this-procedure no-error.
    16972       if error-status :error then do: return no-apply. end.
    16973     end.
    16974     if t-doc.status_ = 'накл':U and
    16975       t-doc.flag_   = yes     then do:
    16976       run fact-bc in this-procedure ( input t-doc.doc-code ) no-error.
    16977       if error-status :error then do: return no-apply. end.
    16978       sort-default = yes. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK BY  ub.doc-line.line-num.
    16979       display t-doc.fact-qnty with frame d-in-doc.
    16980     end.
    16981   END PROCEDURE.
    16982   PROCEDURE local-conf-rd :
    16983   do on error undo, return error return-value :
    16984   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
    16985     (input  'is-custm'
    16986     ,input  0
    16987     ,input  ''
