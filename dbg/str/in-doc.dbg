    10529     t-doc.exch-scale    = 1
    10530     t-doc.print-rubl    = yes.
    10531   if input frame d-in-doc t-doc.cli-type = ? or input frame d-in-doc t-doc.cli-type = "" then do:
    10532     if t-doc.internal then do:
    10533       if can-find (ub.clients where ub.clients.obj-code = input frame d-in-doc t-doc.cli-code
    10534                                        and ub.clients.obj-type = 'скл':U no-lock) then do:
