     3515                 end.
     3516                 run placelib_get-attr  (
     3517                    input "place-com-tanks"
     3518                   ,input buf_doc-pl.obj-code
     3519                   ,input buf_doc-pl.obj-type
     3520                   ,input buf_doc-pl.pl-code
     3521                   ,output v-value
     3522                   ,output v-ok      )
     3523                 no-error.
     3524                 if v-ok
     3525                 and v-value > ""
     3526                 then do ii = 1 to num-entries(v-value) :
     3527                   find first buf_place no-lock where buf_place.obj-type = buf_doc-pl.obj-type
     3528                                                  and buf_place.obj-code = buf_doc-pl.obj-code
     3529                                                  and buf_place.loc1     = entry(ii, v-value)
     3530                                                  and buf_place.status_  = ""
     3531                                                  no-error .
     3532                   if available buf_place
     3533                   then do :
     3534                     for each buf_rvs-doc no-lock where buf_rvs-doc.out-code = buf_trn-doc.doc-code,
     3535                        first buf_rvs-line no-lock where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     3536                                                     and buf_rvs-line.gds-code = buf_doc-pl.gds-code
     3537                                                     and buf_rvs-line.pl-code <> buf_place.pl-code
     3538                     on error undo tr, return error return-value
     3539                     :
