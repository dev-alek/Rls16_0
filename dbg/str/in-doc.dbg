     4241           and buf_doc-line-attr.gds-code  = p-gds-code
     4242           and buf_doc-line-attr.attr-code = p-code + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     4243         no-error .
