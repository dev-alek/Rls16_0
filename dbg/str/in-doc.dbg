    12060   end.
    12061   on value-changed of a-n-c in frame d-in-doc do:
    12062     run proc-valchg-a-n-c in this-procedure  no-error.
    12063     return no-apply.
    12064   end.
    12065   on any-printable of br-dtl in frame d-in-doc do:
    12066     run proc-any-printable-br-dtl in this-procedure   no-error.
    12067     return no-apply.
    12068   end.
    12069   on backspace of br-dtl in frame d-in-doc do:
    12070     run proc-backspace-br-dtl in this-procedure   no-error.
    12071     return no-apply.
    12072   end.
    12073   ON return OF loc-code IN FRAME d-in-doc do:
    12074     run proc-mouse-dbl-click-loc-code in this-procedure   no-error.
    12075     return no-apply.
    12076   end.
    12077   ON return, Ctrl-J OF loc-name IN FRAME d-in-doc do:
    12078     run proc-mouse-dbl-click-loc-name in this-procedure   no-error.
    12079     return no-apply.
    12080   end.
    12081   PROCEDURE proc-valchg-a-n-c:
    12082     case input frame d-in-doc a-n-c :
    12083       when "art" then do:
    12084         apply "entry" to br-dtl in frame d-in-doc.
    12085         hide loc-name loc-code
    12086         in frame d-in-doc.
    12087         loc-art = "".
    12088       end.
    12089       when "name" then do:
    12090         enable loc-name with frame d-in-doc.
    12091         disp loc-name with frame d-in-doc.
    12092         hide loc-art loc-code
    12093         in frame d-in-doc.
    12094         apply "entry" to loc-name in frame d-in-doc.
    12095       end.
    12096       when "code"
    12097    or when "DataMatrix" then
    12098       do:
    12099         enable loc-code with frame d-in-doc.
    12100         disp loc-code with frame d-in-doc.
    12101         hide loc-art loc-name
    12102         in frame d-in-doc.
    12103         apply "entry" to loc-code in frame d-in-doc.
    12104       end.
    12105     end CASE.
    12106   END PROCEDURE.
    12107   PROCEDURE proc-any-printable-br-dtl :
    12108     if input frame d-in-doc a-n-c = "art" then do:
    12109       if last-event:label = " " and
    12110          loc-art = "" then
    12111       return error.
    12112       find first l-doc-line where
    12113                  l-doc-line.doc-code = t-doc.doc-code and l-doc-line.artic begins (loc-art + last-event:label)
    12114                  no-lock no-error.
    12115       if available l-doc-line then do:
    12116         loc-art = loc-art + last-event:label.
    12117         disp loc-art with frame d-in-doc.
    12118         line-rec = recid (l-doc-line).
    12119         reposition br-dtl to recid line-rec no-error.
    12120       end.
    12121     end.
    12122   END PROCEDURE.
    12123   PROCEDURE proc-backspace-br-dtl:
    12124     if input frame d-in-doc a-n-c = "art" then do:
    12125       if loc-art = "" then
    12126         return error.
    12127       loc-art = substr (loc-art, 1, length (loc-art) - 1).
    12128       find first l-doc-line where
    12129                  l-doc-line.doc-code = t-doc.doc-code and l-doc-line.artic begins loc-art
    12130                  no-lock.
    12131       disp loc-art with frame d-in-doc.
    12132       line-rec = recid (l-doc-line).
    12133       reposition br-dtl to recid line-rec no-error.
    12134     end.
    12135   END PROCEDURE.
    12136   PROCEDURE proc-mouse-dbl-click-loc-code:
    12137   def var str-code as integer no-undo.
    12138   define variable varresult   as character         no-undo.
    12139   define variable vartype-bc  as character         no-undo.
    12140   define variable varweight   as decimal           no-undo.
    12141   define buffer l-goods for ub.goods.
    12142   define buffer l-bar-code for ub.bar-code.
    12143   define buffer buf_bar-code for ub.bar-code .
    12144   define buffer buf_prod-bc for ub.prod-bc.
    12145   define buffer buf_place for ub.place.
    12146     assign
    12147     frame d-in-doc
    12148     loc-code
    12149     a-n-c.
    12150     if a-n-c = "datamatrix"
    12151     then do:
    12152   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_dm-rcnz in g#libbcrcn
    12153   (
    12154    input  parparentproc
    12155   ,input  loc-code
    12156   ,input  ?
    12157   ,input  v-cntxt-obj-type
    12158   ,input  v-cntxt-obj-code
    12159   ,input  yes
    12160   ,input  no
    12161   ,input  varscales-pref99
    12162   ,input  varpgscales-pref99
    12163   ,output varresult
    12164   ,output vartype-bc
    12165   ,output varweight
    12166   ,buffer buf_bar-code
    12167   ,buffer buf_prod-bc
    12168   ,buffer buf_place
    12169   ) no-error.
    12170        if varresult eq "prod-bc"
    12171        then
    12172           loc-code:screen-value in frame d-in-doc = buf_prod-bc.b-str.
    12173     end.
    12174     else do:
    12175   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
    12176   (
    12177    input  parparentproc
    12178   ,input  loc-code
    12179   ,input  ?
    12180   ,input  v-cntxt-obj-type
    12181   ,input  v-cntxt-obj-code
    12182   ,input  yes
    12183   ,input  no
    12184   ,input  varscales-pref99
    12185   ,input  varpgscales-pref99
    12186   ,output varresult
    12187   ,output vartype-bc
    12188   ,output varweight
    12189   ,buffer buf_bar-code
    12190   ,buffer buf_prod-bc
    12191   ,buffer buf_place
    12192   ) no-error.
    12193   end.
    12194     if available buf_bar-code then do:
    12195           find first l-goods where
    12196                     l-goods.gds-code =
    12197     buf_bar-code.gds-code No-LOCK.
    12198           find first l-doc-line where l-doc-line.doc-code = t-doc.doc-code and
    12199                     l-doc-line.artic = l-goods.artic AND
    12200                     l-doc-line.prod-type = l-goods.prod-type AND
    12201                     l-doc-line.prod-code = l-goods.prod-code no-lock no-error.
    12202       if available l-doc-line then do:
    12203         line-rec = recid (l-doc-line).
    12204         reposition br-dtl to recid line-rec no-error.
    12205       end.
    12206       else do:
    12207         message "Строка не найдена."
    12208                 view-as alert-box error.
    12209       end.
    12210     end.
    12211     else
    12212       message "Бар-код не найден."
    12213               view-as alert-box error.
    12214     apply "entry" to loc-code in frame d-in-doc.
    12215   END PROCEDURE.
    12216   PROCEDURE  proc-mouse-dbl-click-loc-name:
    12217     assign
    12218     frame d-in-doc
    12219     loc-name.
    12220       if last-event:label = "Ctrl-J" then
    12221         find next l-doc-line where l-doc-line.doc-code = t-doc.doc-code and
    12222                   can-find (ub.goods where ub.goods.artic = l-doc-line.artic and
    12223                   ub.goods.prod-type = l-doc-line.prod-type and
    12224                   ub.goods.prod-code = l-doc-line.prod-code and
    12225                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
    12226       else
    12227         find first l-doc-line where l-doc-line.doc-code = t-doc.doc-code and
    12228                   can-find (ub.goods where ub.goods.artic = l-doc-line.artic and
    12229                   ub.goods.prod-type = l-doc-line.prod-type and
    12230                   ub.goods.prod-code = l-doc-line.prod-code and
    12231                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
    12232       if available l-doc-line then do:
    12233         line-rec = recid (l-doc-line).
    12234         reposition br-dtl to recid line-rec no-error.
    12235       end.
    12236       else do:
    12237         message "Строка не найдена."
    12238                 view-as alert-box error.
    12239       end.
    12240     apply "entry" to loc-name in frame d-in-doc.
    12241   END PROCEDURE.
    12242   on value-changed of br-dtl in frame d-in-doc do:
    12243   if not available ub.doc-line or recid (ub.doc-line) <> line-rec then do:
    12244       hide loc-art in frame d-in-doc.
    12245       loc-art = "".
    12246   end.
    12247   IF mImagePh THEN
    12248   DO:
    12249       DEFINE VARIABLE vImageList AS LONGCHAR    NO-UNDO.
    12250       DEFINE VARIABLE vCh        AS CHARACTER   NO-UNDO.
    12251   if AVAILABLE goods then do:
    12252       RUN gds-attr-value ( goods.gds-code, "image-list":U, OUTPUT vImageList, OUTPUT vCh).
    12253       RUN imagelist_decode IN THIS-PROCEDURE (INPUT vImageList, goods.gds-code, OUTPUT vImageList).
    12254       vCh = ENTRY (1, vImageList, ",":U).
    12255       g-image:LOAD-IMAGE (ENTRY (1, vCh)) NO-ERROR.
    12256       ASSIGN
    12257           g-image:HIDDEN     = NO
    12258           g-image:VISIBLE    = YES
    12259           g-image:SENSITIVE  = YES
    12260           .
    12261   end.
    12262   END.
    12263   ELSE
    12264       ASSIGN
    12265           g-image:HIDDEN     = YES
    12266           g-image:VISIBLE    = NO
    12267           g-image:SENSITIVE  = NO
    12268           .
    12269   end.
    12270   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-in-doc:PARENT eq ?
    12271   THEN FRAME d-in-doc:PARENT = ACTIVE-WINDOW.
    12272   ON WINDOW-CLOSE OF FRAME d-in-doc APPLY "END-ERROR":U TO SELF.
    12273   define variable vss-include-info101 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12274   on help of frame d-in-doc
    12275   do:
    12276     run gbl/app_help.p
    12277       (input this-procedure :file-name
    12278       ,input ''
    12279       ,input ?
    12280       ) no-error.
    12281     if error-status :error then do:
    12282       message
    12283         "Ошибка при вызове помощи"
    12284         error-status :get-message(1)
    12285         view-as alert-box .
    12286     end.
    12287   end.
    12288   run minbtn-set in this-procedure .
    12289   on choose of b-help in frame d-in-doc
    12290   do:
    12291     apply "help":u to frame d-in-doc .
    12292   end.
    12293   define variable vss-include-info102 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12294   procedure minbtn-set :
    12295       do
    12296           on error undo, return error return-value
    12297           :
    12298           define variable ii              as integer       no-undo .
    12299           define variable fh              as widget-handle no-undo .
    12300           define variable hh              as widget-handle no-undo .
    12301           define variable v-h             as handle        extent 4 no-undo .
    12302           define variable v-name-button   as character     no-undo .
    12303           define variable v-help-old-x    as decimal       no-undo .
    12304           define variable v-help-old-y    as decimal       no-undo .
    12305           define variable v-help-old-size as decimal       no-undo .
    12306           define variable v-frame-width   as decimal       no-undo .
    12307           define variable jj              as integer       no-undo .
    12308           do
    12309               on error undo, return error
    12310               :
    12311               assign
    12312                   v-frame-width = frame d-in-doc:width - 0.3
    12313                   fh            = frame d-in-doc:first-child
    12314                   hh            = fh:first-child
    12315                   ii            = 1
    12316                   .
    12317               do while valid-handle(hh):
    12318                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
    12319                   do:
    12320                       case lc(hh:name) :
    12321                           when "b-help" then
    12322                               do:
    12323                                   hh:load-image-up("cmp/b-help.bmp":u) .
    12324                                   hh:load-image-down("cmp/b-help.bmp":u) .
    12325                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
    12326                                   hh:TOOLTIP = "Помощь" .
    12327                                   v-help-old-x = hh:column .
    12328                                   v-help-old-y = hh:row    .
    12329                                   v-help-old-size = hh:width .
    12330                                   hh:width-chars = 2.5 .
    12331                               end.
    12332                           when "b-print" then
    12333                               do:
    12334                                   hh:load-image("cmp/b-print.bmp":u) .
    12335                                   hh:TOOLTIP = "Печать" .
    12336                                   v-h[ii] = hh:handle .
    12337                                   ii = ii + 1 .
    12338                                   hh:width-chars = 3 .
    12339                               end.
    12340                           when "b-history" or
    12341                           when "b-hist" then
    12342                               do:
    12343                                   hh:load-image("cmp/b-hist.bmp":u) .
    12344                                   hh:TOOLTIP = "История" .
    12345                                   v-h[ii] = hh:handle .
    12346                                   ii = ii + 1 .
    12347                                   hh:width-chars = 3 .
    12348                               end.
    12349                           when "b-sch" then
    12350                               do:
    12351                                   hh:load-image("cmp/b-sch.bmp":u) .
    12352                                   hh:TOOLTIP = "Установка Фильтра" .
    12353                                   v-h[ii] = hh:handle .
    12354                                   ii = ii + 1 .
    12355                                   hh:width-chars = 3 .
    12356                               end.
    12357                           when "b-hist-user" then
    12358                               do:
    12359                                   hh:load-image("cmp/b-hist.bmp":u) .
    12360                                   hh:TOOLTIP = "История пользователя" .
    12361                                   ii = ii + 1 .
    12362                               end.
    12363                       end case.
    12364                   end.
    12365                   hh = hh:next-sibling.
    12366               end.
    12367               b-help:column = v-frame-width - b-help:width-chars.
    12368               jj = 0.
    12369               repeat ii = 4 to 1 by -1 :
    12370                   if valid-handle (v-h[ii] ) then
    12371                   do:
    12372                       jj  = jj + 1 .
    12373                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
    12374                       v-h[ii]:row    = v-help-old-y .
    12375                   end.
    12376               end.
    12377           end.
    12378       end.
    12379   end procedure.
    12380   define variable vss-include-info103 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
    12381   define variable v-diasize-need-maximize        as logical   no-undo init true  .
    12382   define variable v-diasize-orig-frame-height    as decimal   no-undo .
    12383   define variable v-diasize-orig-frame-width     as decimal   no-undo .
    12384   define variable v-diasize-current-frame-width  as decimal   no-undo .
    12385   define variable v-diasize-current-frame-height as decimal   no-undo .
    12386   define variable v-diasize-change-size          as logical   no-undo .
    12387   define variable v-diasize-resize-button        as handle    no-undo .
    12388   define variable v-diasize-wndmax               as logical   no-undo .
    12389   define variable v-diasize-wndstore             as logical   no-undo .
    12390   define variable v-diasize-proc-name            as character no-undo .
    12391   define variable v-diasize-browse-handle        as handle    no-undo .
    12392   define variable v-diasize-browse-number        as integer   no-undo .
    12393   define variable v-diasize-need-full-display    as logical   no-undo init false .
    12394   define temp-table temp-diasize-handle no-undo
    12395     field handle-value  as handle
    12396     field save-position as decimal
    12397     index xpk is primary unique handle-value
    12398     .
    12399   define temp-table temp-browse-handle no-undo
    12400     field browse-type   as character
    12401     field browse-number as integer
    12402     field browse-handle as handle
    12403     field original-size as decimal
    12404     index xpk is primary unique browse-type browse-number
    12405     index xie browse-type browse-handle
    12406   .
    12407   procedure diasize_change-height :
    12408     define input  parameter p-change-value  as decimal   no-undo .
    12409     define input  parameter p-move-resize   as logical   no-undo .
    12410     define variable v-field-group-handle    as handle    no-undo .
    12411     define variable v-object-handle         as handle    no-undo .
    12412     define variable v-frame-height          as decimal   no-undo .
    12413     define variable v-frame-virtual-height  as decimal   no-undo .
    12414     define variable v-browse-height         as decimal   no-undo .
    12415     define variable v-window-height         as decimal   no-undo .
    12416     define variable v-window-virtual-height as decimal   no-undo .
    12417     define variable v-change-sign           as integer   no-undo .
    12418     define buffer buf_temp-diasize-handle for temp-diasize-handle .
    12419     define buffer buf_temp-browse-handle  for temp-browse-handle .
    12420     if p-change-value > 0
    12421     then do:
    12422       if frame d-in-doc :height + p-change-value
    12423           > decimal(session :work-area-height-pixels) / session :pixels-per-row
    12424       then do:
    12425         assign
    12426           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
    12427                           - (frame d-in-doc :height-chars)
    12428         .
    12429         if p-change-value <= 0
    12430         then do:
    12431           run diasize_position-resize-button in this-procedure .
    12432           return .
    12433         end.
    12434       end.
    12435     end.
    12436     if p-change-value < 0
    12437     then do:
    12438       if frame d-in-doc :height + p-change-value < v-diasize-orig-frame-height
    12439       then do:
    12440         assign
    12441           p-change-value = v-diasize-orig-frame-height
    12442                          - (frame d-in-doc :height-chars)
    12443         .
    12444         if p-change-value >= 0
    12445         then do:
