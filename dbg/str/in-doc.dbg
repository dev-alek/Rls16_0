     7925   ON CHOOSE OF b-del IN FRAME d-in-doc
     7926   DO:
     7927       if lookup( self :type in frame d-in-doc, 'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW' ) <> 0 then do:   apply "ENTRY":U to self in frame d-in-doc .   if focus :handle <> self :handle in frame d-in-doc then do:     return no-apply .   end. end.
     7928     run del-doc-line in this-procedure no-error.
