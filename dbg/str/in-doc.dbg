    10586    apply "entry" to t-doc.cli-code in frame d-in-doc.
    10587    return error.
    10588   end.
    10589   define variable v-err as logical   no-undo .
    10590     run ver-clients  ( ub.clients.obj-type , ub.clients.obj-code , output v-err ) .
    10591     if  v-err then do:
    10592     apply "entry" to t-doc.cli-code in frame d-in-doc.
    10593     return error.
    10594     end.
    10595   if lookup(ub.clients.obj-type, 'скл':U + ',' + 'маг':U) > 0
    10596   then do:
    10597     if t-doc.internal then do:
    10598       if ub.clients.obj-type = 'скл':U then do:
    10599         find ub.store where ub.store.obj-code = ub.clients.obj-code no-lock.
    10600         if ub.store.host-code <> v-cntxt-host-code-obj then do:
    10601           release ub.clients no-error.
    10602           message "Выбран склад другой фирмы. Используйте внешний документ.".
    10603           apply "entry" to t-doc.cli-code in frame d-in-doc.
    10604           return error.
    10605         end.
    10606       end.
    10607       else do:
    10608         find ub.shop where ub.shop.obj-code = ub.clients.obj-code no-lock.
    10609         if ub.shop.host-code <> v-cntxt-host-code-obj then do:
    10610           release ub.clients no-error.
    10611           message "Выбран магазин другой фирмы. Используйте внешний документ.".
    10612           apply "entry" to t-doc.cli-code in frame d-in-doc.
    10613           return error.
    10614         end.
    10615       end.
    10616     end.
    10617     else do:
    10618       release ub.clients no-error.
    10619       message "Это не внутреннее перемещение. Выберите организацию или человека.".
    10620       apply "entry" to t-doc.cli-code in frame d-in-doc.
    10621       return error.
    10622     end.
    10623   end.
    10624   else do:
    10625     if t-doc.internal then do:
