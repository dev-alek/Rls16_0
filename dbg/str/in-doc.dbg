     4497   define input  parameter  p-doc-price-base as decimal   no-undo .
     4498   define input  parameter  p-doc-vat-pc     as decimal   no-undo .
     4499   define input  parameter  p-doc-slt-pc     as decimal   no-undo .
     4500   define input-output parameter  p-new-price-sale as decimal   no-undo .
     4501   define buffer buf_trn-doc for ub.trn-doc  .
     4502   define variable is-petrolium as logical   no-undo .
     4503   define variable is-pieces    as logical   no-undo .
     4504     do
     4505     on error undo, return error return-value
     4506     :
     4507    find first buf_trn-doc no-lock where buf_trn-doc.doc-code =  p-doc-code no-error .
     4508   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     4509     (
     4510        input p-artic
     4511     ,  input p-prod-type
     4512     ,  input p-prod-code
     4513     , output is-petrolium
     4514     , output is-pieces
     4515     ) .
     4516   if not (par-pr-nakl = yes and par-gm = 'before-margin':U and is-petrolium = false ) then return .
     4517     run str/in-prno.p (
     4518         input   parParentProc ,
