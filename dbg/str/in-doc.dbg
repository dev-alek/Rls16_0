     5866                       when chr(3)
     5867                       then do:
     5868                           assign
     5869                               p-out-string = p-out-string + " ":U
     5870                           .
     5871                       end.
     5872                       when chr(4)
     5873                       then do:
     5874                           assign
     5875                               p-out-string = p-out-string + " ":U
     5876                           .
     5877                       end.
     5878                       when chr(5)
     5879                       then do:
     5880                           assign
     5881                               p-out-string = p-out-string + " ":U
     5882                           .
     5883                       end.
     5884                       when chr(6)
     5885                       then do:
     5886                           assign
     5887                               p-out-string = p-out-string + " ":U
     5888                           .
     5889                       end.
     5890                       when chr(7)
     5891                       then do:
     5892                           assign
     5893                               p-out-string = p-out-string + " ":U
     5894                           .
     5895                       end.
     5896                       when chr(8)
     5897                       then do:
     5898                           assign
     5899                               p-out-string = p-out-string + " ":U
     5900                           .
     5901                       end.
     5902                       when chr(9)
     5903                       then do:
     5904                           assign
     5905                               p-out-string = p-out-string + " ":U
     5906                           .
     5907                       end.
     5908                       when chr(29)
     5909                       then do:
     5910                           assign
     5911                               p-out-string = p-out-string + " ":U
     5912                           .
     5913                       end.
     5914                       when chr(10)
     5915                       then do:
     5916                           assign
     5917                               p-out-string = p-out-string + " ":U
     5918                           .
     5919                       end.
     5920                       when chr(13)
     5921                       then do:
     5922                           assign
     5923                               p-out-string = p-out-string + " ":U
     5924                           .
     5925                       end.
     5926                       otherwise do:
     5927                           assign
     5928                               p-out-string = p-out-string + v-current-char
     5929                           .
     5930                       end.
     5931                   end case.
     5932               end.
     5933           end.
     5934       end case.
     5935   end.
     5936   end .
     5937   procedure xmlchar-decode :
     5938   define input parameter p-in-string      as character        no-undo.
     5939   define output parameter p-out-string    as character        no-undo.
     5940       define variable v-position      as integer      no-undo.
     5941       define variable v-last-position as integer      no-undo.
     5942       define variable v-temp-integer  as integer      no-undo.
     5943       define variable v-current-char  as character    no-undo.
     5944       define variable v-next-char     as character    no-undo.
     5945       define variable v-success       as logical      no-undo.
     5946   do
     5947   on error undo, return error
     5948   :
     5949       assign
     5950           p-out-string = "":U
     5951           v-position   = 0
     5952       .
     5953       replace-cycle:
     5954       do while yes
     5955       on error undo, return error
     5956       :
     5957           assign
     5958               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     5959           .
     5960           if v-last-position <= v-position
     5961           then do:
     5962               if v-position = 0
     5963               then do:
     5964                   assign
     5965                       p-out-string = p-in-string
     5966                   .
     5967               end.
     5968               else do:
     5969                   assign
     5970                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     5971                   .
     5972               end.
     5973               leave replace-cycle.
     5974           end.
     5975           else do:
     5976               assign
     5977                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     5978                   v-position      = v-last-position
     5979                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     5980               .
     5981               if v-current-char = "#":U
     5982               then do:
     5983                   assign
     5984                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     5985                   .
     5986                   if v-last-position > 0
     5987                   then do:
     5988                       run xmlchar-read-integer in this-procedure
     5989                        (
     5990                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     5991                           , output v-temp-integer
     5992                           , output v-success
     5993                       ).
     5994                       if v-success = yes
     5995                       and v-temp-integer >= 1
     5996                       and v-temp-integer <= 255
     5997                       then do:
     5998                           assign
     5999                               p-out-string = p-out-string + chr( v-temp-integer )
     6000                               v-position   = v-last-position + 1
     6001                           .
     6002                       end.
     6003                       else do:
     6004                           assign
     6005                               p-out-string = p-out-string + "&":U
     6006                               v-position   = v-position   + 1
     6007                           .
     6008                       end.
     6009                   end.
     6010                   else do:
     6011                       assign
     6012                           p-out-string = p-out-string + "&":U
     6013                           v-position   = v-position   + 1
     6014                       .
     6015                   end.
     6016               end.
     6017               else do:
     6018                   case substring( p-in-string, v-position + 1, 3 )
     6019                   :
     6020                       when "lt;":U
     6021                       then do:
     6022                           assign
     6023                               p-out-string = p-out-string + "<":U
     6024                               v-position   = v-position   + 3
     6025                           .
     6026                       end.
     6027                       when "gt;":U
     6028                       then do:
     6029                           assign
     6030                               p-out-string = p-out-string + ">":U
     6031                               v-position   = v-position   + 3
     6032                           .
     6033                       end.
     6034                       otherwise do:
     6035                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     6036                           then do:
     6037                               assign
     6038                                   p-out-string = p-out-string + "&":U
     6039                                   v-position   = v-position   + 4
     6040                               .
     6041                           end.
     6042                           else do:
     6043                               case substring( p-in-string, v-position + 1, 5 )
     6044                               :
     6045                                   when "quot;":U
     6046                                   then do:
     6047                                       assign
     6048                                           p-out-string = p-out-string + '"':U
     6049                                           v-position   = v-position   + 5
     6050                                       .
     6051                                   end.
     6052                                   when "apos;":U
     6053                                   then do:
     6054                                       assign
     6055                                           p-out-string = p-out-string + "'":U
     6056                                           v-position   = v-position   + 5
     6057                                       .
     6058                                   end.
     6059                                   otherwise do:
     6060                                       assign
     6061                                           p-out-string = p-out-string + "&":U
     6062                                       .
     6063                                   end.
     6064                               end case.
     6065                           end.
     6066                       end.
     6067                   end case.
     6068               end.
     6069           end.
     6070       end.
     6071   end.
     6072   end .
     6073   procedure xmlchar-read-integer :
     6074   define input parameter p-input-string      as character        no-undo.
     6075   define output parameter p-output-integer   as integer          no-undo.
     6076   define output parameter p-success       as logical          no-undo.
     6077   do
     6078   on error undo, return error
     6079   :
     6080       assign
     6081           p-output-integer = integer( p-input-string )
     6082       no-error.
     6083       if error-status :error
     6084       then do:
     6085           assign
     6086               p-success           = no
     6087               p-output-integer    = 0
     6088           .
     6089       end.
     6090       else do:
     6091           assign
     6092               p-success           = yes
     6093           .
     6094       end.
     6095   end.
     6096   end.
     6097   define variable mMRCCode  as logical    no-undo.
     6098   define variable mTypeMark as character  no-undo.
     6099   function IS-NeedMark returns logical
     6100   ( input ib-code as integer  ,
     6101     input ib-str as character ):
     6102      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     6103      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     6104                                    and buf_prod-bc-attr.b-str  eq ib-str
     6105                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     6106        no-lock no-error.
     6107      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     6108   end.
     6109   function repTegforDm return char
     6110   (iDM as char ):
     6111       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     6112       define variable vteg as character no-undo.
     6113       define variable oDM as character no-undo.
     6114       define variable vi as integer no-undo.
     6115       oDM = iDm.
     6116       do vi = 1 to num-entries(vTeglist):
     6117          vTeg = entry(vi,vTeglist).
     6118          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     6119       end.
     6120       return oDM.
     6121   end.
     6122   function repSpecSimbforDm return char
     6123   (iDM as char ):
     6124       define variable oDM as character no-undo.
     6125     run
     6126       xmlchar-decode(iDM, output oDM).
     6127     return repTegforDm (oDM).
     6128   end.
     6129   function CheckGtin return logical
     6130   (iGtin as char):
     6131      define variable bar_code as character no-undo.
     6132      define variable vGtin as logical no-undo init "yes".
     6133      if length(iGtin) eq 14
     6134      then do:
     6135         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     6136         run str/chk-sum.p
     6137          (input-output bar_code ) no-error .
     6138         if iGtin ne  bar_code
     6139         then
     6140            vGtin = no.
     6141      end.
     6142      else
     6143         vGtin = no.
     6144      return vgtin.
     6145   end.
     6146   function repSpecSimbforXlm return char
     6147   (iDM as char ):
     6148       iDM = replace(iDM,chr(29),"").
     6149       return iDM.
     6150   end.
     6151   function getGtinByDM return char
     6152   (IDM as char):
     6153      define variable VTXT as char no-undo.
     6154      define variable vGtin as char no-undo.
     6155      vTXt = IdM.
     6156      vGtin = IDM.
     6157      if    length(vtxt) > 14
     6158      then do:
     6159         if   vtxt begins "(01)"
     6160                or vtxt begins "(02)"
     6161         then
     6162            vGtin = substring(vtxt,5,14).
     6163         else if   (vtxt begins "01"
     6164                or vtxt begins "02" )
     6165                and (   (    substring(iDm,17,2) eq "21"
     6166                         and length(vtxt) >= 21)
     6167                     or substring(iDm,17,2) eq "37"
     6168                     or substring(iDm,17,4) eq "(37)" )
     6169         then do:
     6170            vGtin = substring(vtxt,3,14).
     6171            if not checkGtin(vGtin)
     6172            then
     6173               vGtin = substring(vtxt,1,14).
     6174         end.
     6175         else if     length(vtxt) eq 14 + 7 + 4 + 4
     6176             or length(vtxt) eq 14 + 7 + 4
     6177             or length(vtxt) eq 14 + 7
     6178         then
     6179            vGtin = substring(vtxt,1,14).
     6180      end.
     6181      if not checkGtin(vGtin)
     6182      then
     6183         vGtin = "".
     6184      return vgtin.
     6185   end.
     6186   function getGdsCodeByGtin return int
     6187   (iGtin as char):
     6188      define buffer prod-bc  for ub.prod-bc.
     6189      define buffer bar-code for ub.bar-code.
     6190      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     6191      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     6192      return if avail bar-code then bar-code.gds-code else ?.
     6193   end.
     6194   function getQntyCodeByGtin return decimal
     6195   (iGtin as char):
     6196      define buffer prod-bc  for ub.prod-bc.
     6197      define buffer bar-code for ub.bar-code.
     6198      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     6199      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     6200      return if avail bar-code then bar-code.cli-base-rate else ?.
     6201   end.
     6202   function getGdsCodeByDM return int
     6203   (iDm as char):
     6204      define variable vGtin as char no-undo.
     6205      define buffer prod-bc for ub.prod-bc.
     6206      vGtin  = getGtinByDM (IDM ).
     6207      return getGdsCodeByGtin (vGtin).
     6208   end.
     6209   function ChekTypeMarkByGds return logical
     6210   (iGds-code as integer ):
     6211      define buffer goods-attr for ub.goods-attr.
     6212      find first goods-attr where goods-attr.gds-code   = iGds-code
     6213                              and goods-attr.attr-code  = 'mark-type':U
     6214      no-lock no-error.
     6215      if available goods-attr
     6216      then do:
     6217         mTypeMark = goods-attr.attr-value.
     6218         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     6219           .
     6220      end.
     6221      else
     6222         return no.
     6223   end.
     6224   function ChekTypeMarkByDm return logical
     6225   (iDM as char ):
     6226      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     6227   end.
     6228   function ChekTypeMarkByGtin return logical
     6229   (iGtin as char ):
     6230      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     6231   end.
     6232   function GetNextElement return character
     6233     (input iAllTeg        as logical
     6234     ,output oteg          as character
     6235     ,output otegval       as character
     6236     ,input-output pstr    as character
     6237      ):
     6238        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     6239        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     6240        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     6241        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     6242        define variable vTeg as character no-undo.
     6243        define variable vLength as integer no-undo.
     6244        define variable vi as integer no-undo.
     6245        define variable vj as integer no-undo.
     6246        define buffer code for ub.code.
     6247        find first code where Code.parent eq "MarkType"
     6248                          and Code.CodeValue   eq mTypeMark
     6249                          no-lock no-error.
     6250        if     available code
     6251           and Code.misc1 ne ""
     6252           and Code.misc1 ne ?
     6253        then do:
     6254           integer (Code.misc1) no-error.
     6255           if not error-status:error
     6256           then
     6257             entry (4,vlistleng) = Code.misc1.
     6258        end.
     6259        if iAllTeg
     6260        then
     6261           assign
     6262              vlistElem     = vlistElem    + vlistElemDop
     6263              vlistleng     = vlistleng    + vlistlengDop
     6264           .
     6265        else if mMRCCode
     6266        then
     6267           assign
     6268              vlistElem     = vlistElem    + ",(8005),8005"
     6269              vlistleng     = vlistleng    + ",000006,0006"
     6270           .
     6271       block-elem:
     6272       do vi = 1 to num-entries(vlistElem):
     6273          vTeg = entry(vi,vlistElem).
     6274          if pstr begins vTeg
     6275          then do:
     6276             if    vTeg eq "21"
     6277             then
     6278                vLength = index(pstr,chr(29)) - 2 no-error.
     6279             if vLength  <= 0
     6280             then
     6281                vLength = int(entry(vi,vlistleng)).
     6282             otegval = substring (pstr,length(vteg) + 1, vLength).
     6283             oteg = replace(replace(vteg,")",""),"(","").
     6284             vTeg = vteg + otegval.
     6285             otegval = replace(otegval,chr(29),"").
     6286             oteg = replace(replace(oteg,")",""),"(","").
     6287             pstr = substring (pstr,length(vTeg)+ 1).
     6288             vTeg = replace(vTeg,chr(29),"").
     6289             leave block-elem.
     6290          end.
     6291          else
     6292             vTeg = "".
     6293       end.
     6294       return vteg.
     6295   end.
     6296   function GetCodeIdent return character
     6297   (iDm as char):
     6298      define variable Velement   as character no-undo init "first".
     6299      define variable oCodeIdent as character no-undo.
     6300      define variable vteg as character no-undo.
     6301      define variable vtegval as character no-undo.
     6302      define variable vGtin as character no-undo.
     6303      define buffer marking for ub.marking.
     6304      for first marking no-lock where
     6305                marking.mark eq iDm
     6306            and marking.unit-ext = "LEVEL2"
     6307      :
     6308        return iDm.
     6309      end.
     6310      vGtin  = getGtinByDM (iDm ).
     6311      ChekTypeMarkByDm(idm).
     6312      if iDm begins 'tech_':U
     6313      then
     6314         oCodeIdent = iDm.
     6315      else if length(iDm) < 21
     6316      then do:
     6317         find first marking where marking.mark eq idm
     6318         no-lock no-error.
     6319         oCodeIdent = if available marking then marking.mark else  ?.
     6320      end.
     6321      else if     length(iDm) eq 29
     6322         and not iDm begins "01"
     6323         and not iDm begins "02"
     6324      then
     6325         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     6326      else  if     length(iDm) >= 24
     6327               and (  iDm begins "01"
     6328                   or iDm begins "02")
     6329               and  substring(iDm,17,2) ne "21"
     6330      then do:
     6331         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     6332                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     6333         then
     6334            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     6335         else
     6336            oCodeIdent = iDM.
     6337      end.
     6338      else  if     (   length(iDm) eq 25
     6339                    or length(iDm) eq 21)
     6340               and (not iDm begins "01"
     6341               and  not iDm begins "02")
     6342      then
     6343         oCodeIdent = substring(iDm,1,21).
     6344      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     6345      then
     6346         oCodeIdent = substring(iDm,1,21).
     6347      else do while Velement ne "" and idm ne "":
     6348         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     6349         oCodeIdent = oCodeIdent + Velement.
     6350      end.
     6351      return oCodeIdent.
     6352   end.
     6353   function GetTegCod return character
     6354   (icodeIdent as char, iTeg as char):
     6355      define variable Velement   as character no-undo init "first".
     6356      define variable oTeg as character no-undo init ?.
     6357      define variable vteg as character no-undo.
     6358      define variable vtegval as character no-undo.
     6359      if     ((length(icodeIdent) eq 21
     6360         and not icodeIdent begins "01"
     6361         and not icodeIdent begins "02")
     6362         or
     6363             ( length(icodeIdent) eq 25
     6364               and not icodeIdent begins "01"
     6365               and not icodeIdent begins "02"))
     6366      then do:
     6367         if iTeg eq "01" or iTeg eq "02"
     6368         then
     6369            oTeg = substring(icodeIdent,1,21).
     6370         else  if  iTeg eq "21"
     6371         then
     6372            oTeg = substring(icodeIdent,15,7).
     6373      end.
     6374      else do:
     6375         ChekTypeMarkByDm(icodeIdent).
     6376         block-teg:
     6377            do while Velement ne "" and icodeIdent ne "":
     6378            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     6379            if    Velement begins iTeg
     6380               or Velement begins "(" + iTeg + ")"
     6381            then do:
     6382               oTeg = vtegval.
     6383               leave block-teg.
     6384            end.
     6385         end.
     6386      end.
     6387      return oTeg.
     6388   end.
     6389   function isOAD return logical
     6390   (icodeIdent as character):
     6391      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     6392   end.
     6393   function isMark return logical
     6394   (icodeIdent as character):
     6395      define buffer buf_marking for ub.marking.
     6396      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     6397             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     6398   end.
     6399   function addBracketForCode return character
     6400   (icodeIdent as char):
     6401      define variable Velement   as character no-undo init "first".
     6402      define variable oTeg as character no-undo.
     6403      define variable vteg as character no-undo.
     6404      define variable vtegval as character no-undo.
     6405      define buffer marking for ub.marking.
     6406      find first marking no-lock where
     6407                 marking.mark begins icodeIdent no-error.
     6408      if    not ChekTypeMarkByDm(icodeIdent)
     6409         or length(icodeIdent) le 24
     6410         or (avail marking and marking.unit-ext = "LEVEL2")
     6411      then
     6412         oTeg = icodeIdent.
     6413      else do:
     6414         if (  icodeIdent begins "01"
     6415            or icodeIdent begins "02"
     6416            ) and CheckGtin(substring (icodeIdent,3,14))
     6417            and substring (icodeIdent,17,2) eq "21"
     6418         then do:
     6419            mMRCCode = yes.
     6420            ChekTypeMarkByDm(icodeIdent).
     6421            block-teg:
     6422            do while Velement ne "" and icodeIdent ne "":
     6423               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     6424               if vteg ne ""
     6425               then
     6426                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     6427            end.
     6428            mMRCCode = no.
     6429         end.
     6430         else do:
     6431            oTeg = icodeIdent.
     6432         end.
     6433      end.
     6434      return oTeg.
     6435   end.
     6436   function getlevelByCodId return int
     6437   (iCode as char):
     6438      define variable vLength as int no-undo.
     6439      define variable vLevel  as int no-undo.
     6440      if not ChekTypeMarkByDM (icode) then return ?.
     6441      vLength = length(iCode).
     6442      if    vLength eq 18
     6443         or vLength eq 20
     6444      then
     6445         Vlevel = 4.
     6446      else if vLength eq 21
     6447      then
     6448         Vlevel = 1.
     6449      else if vLength eq 25
     6450      then do:
     6451         if  iCode begins "01"
     6452         then
     6453            Vlevel = 3.
     6454         else
     6455            Vlevel = 1.
     6456      end.
     6457      else if     vLength >= 26
     6458              and vLength <= 46
     6459      then do:
     6460         if    substring(iCode,17,2) eq "11"
     6461            or substring(iCode,17,2) eq "13"
     6462            or (    substring(iCode,17,2) eq "21"
     6463                and vLength >= 33
     6464                and substring(iCode,26,4) ne "8005")
     6465         then
     6466            Vlevel = 4.
     6467         else if    vLength eq 31
     6468                 or vLength eq 38
     6469                 or vLength eq 39
     6470                 or vLength eq 45
     6471         then
     6472            Vlevel = 1.
     6473         else if    vLength eq 35
     6474                 or vLength eq 43
     6475         then
     6476            Vlevel = 3.
     6477         else
     6478            Vlevel = ?.
     6479      end.
     6480      else
     6481         Vlevel = ?.
     6482      return Vlevel.
     6483   end.
     6484   function getLevelMotpBycodid return character
     6485   (iDm as char):
     6486      define variable vLevel as integer no-undo.
     6487      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     6488      vLevel = getlevelByCodId(iDm).
     6489      if    vLevel eq ?
     6490         or vLevel < 1
     6491         or vLevel > 6
     6492      then
     6493         return ?.
     6494      else
     6495         return entry(vlevel,vList).
     6496   end.
     6497   function getLevelUTDByLevelMotp return character
     6498   (iUnit as char):
     6499      define variable vLevel as integer no-undo.
     6500      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     6501      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     6502      vLevel = lookup(iUnit,vListMOTP).
     6503      if    vLevel eq ?
     6504         or vLevel < 1
     6505         or vLevel > 4
     6506      then
     6507         return ?.
     6508      else
     6509         return entry(vlevel,vListutd).
     6510   end.
     6511   function getLevelMotpByDM return character
     6512   (iDm as char):
     6513      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     6514   end.
     6515   function getLevelUTDByCodId return character
     6516   (iDm as char):
     6517      define variable vLevel as integer no-undo.
     6518      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     6519      vLevel = getlevelByCodId(iDm).
     6520      if    vLevel eq ?
     6521         or vLevel < 1
     6522         or vLevel > 4
     6523      then
     6524         return ?.
     6525      else
     6526         return entry(vlevel,vList).
     6527   end.
     6528   function getLevelUTDByDM return character
     6529   (iDm as char):
     6530      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     6531   end.
     6532   define variable mNotMarkQnty as logical no-undo.
     6533   function getQntyUTDByCodId return decimal
     6534   (iDM as char):
     6535      define variable vLevel as integer no-undo.
     6536      define variable vList as character no-undo init "1,5,10,500".
     6537      define variable vGtin as character no-undo.
     6538      define variable vqnty as decimal no-undo init ?.
     6539      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     6540      if vqnty eq ?
     6541      then do:
     6542         if not mNotMarkQnty
     6543         then do:
     6544            define buffer marking for ub.marking.
     6545            define variable vCodident as character no-undo.
     6546            vCodident = GetCodeIdent(idm).
     6547            find first marking where marking.mark begins vCodident no-lock no-error.
     6548            if     available marking
     6549               and marking.box-qnty ne ?
     6550            then
     6551               return marking.box-qnty.
     6552         end.
     6553         vGtin = getGtinByDm(iDM).
     6554         if ChekTypeMarkByGtin (vGtin)
     6555         then do:
     6556            vLevel = getlevelByCodId(iDM).
     6557            if     vLevel >= 1
     6558               and vLevel <= 4
     6559            then
     6560               vqnty = int(entry(vlevel,vList)).
     6561         end.
     6562         else
     6563            vqnty = getQntyCodeByGtin(vgtin).
     6564      end.
     6565      return vqnty.
     6566   end.
     6567   function getQntyUTDByDM return decimal
     6568   (iDm as char):
     6569      define variable vDM as character no-undo.
     6570      if     length (iDm) ne 25
     6571         and length (iDm) ne 29
     6572         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     6573      then
     6574         vDM = substring (iDm,1,length (iDm) - 6 ).
     6575      else
     6576         vDM = substring (iDm,1,length (iDm) - 4 ).
     6577      return getQntyUTDByCodId(vDM).
     6578   end.
     6579   function getMRC4 return decimal
     6580   (iMRC as char):
     6581      define variable oMrc     as decimal no-undo init ?.
     6582      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     6583      define variable vi       as integer no-undo.
     6584      define variable vfound   as integer no-undo.
     6585      define variable vposStart   as integer no-undo.
     6586      do:
     6587      OMRc = 0.
     6588      do vi = 1 to 4:
     6589         define variable vsimb as character no-undo.
     6590         vsimb = substring(iMRC,vi,1).
     6591         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     6592         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     6593         if vfound > 0
     6594         then
     6595            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     6596         end.
     6597         OMRc = OMRc / 100.
     6598      end.
     6599      return OMRc.
     6600   end.
     6601   function getMRCByDM return decimal
     6602   (iDm as char):
     6603      define variable vMRC     as character no-undo.
     6604      define variable oMrc     as decimal no-undo init ?.
     6605      define variable Velement as character no-undo init "empty".
     6606      define variable vteg as character no-undo.
     6607      define variable vtegval as character no-undo.
     6608      if    length(idm) eq 14 + 7 + 4 + 4
     6609         or length(idm) eq 14 + 7 + 4
     6610      then do:
     6611         vMRC = substring(idm,22,4).
     6612         omrc = getMRC4(vMRC).
     6613      end.
     6614      else do:
     6615          ChekTypeMarkByDm(iDm).
     6616          block-mrc:
     6617          do while Velement ne "" and idm ne "":
     6618             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     6619             if Velement begins "8005"
     6620             then do:
     6621                vMRC = substring(Velement,5,6).
     6622                leave block-mrc.
     6623             end.
     6624             else if Velement begins "(8005)"
     6625             then do:
     6626                vMRC = substring(Velement,7,6).
     6627                leave block-mrc.
     6628             end.
     6629          end.
     6630          if vMRC ne ""
     6631          then
     6632             OMRc = dec(vmrc) / 100 no-error.
     6633      end.
     6634      return OMRc.
     6635   end.
     6636   function MoveDate return Date
     6637   (idate as date,
     6638    iMonth as int64):
     6639      define variable vMonth   as int64 no-undo.
     6640      define variable vYear    as int64 no-undo.
     6641      define variable vDateNew as date  no-undo.
     6642       define variable vDay     as int64 no-undo.
     6643       vMonth = month(iDate) + iMonth.
     6644       vYear =  year(iDate).
     6645       if vMonth <= 0
     6646       then assign
     6647          vMonth = vMonth + 12
     6648           vYear  = vYear - 1
     6649       .
     6650       else if vMonth > 12
     6651       then assign
     6652          vMonth = vMonth - 12
     6653           vYear  = vYear + 1
     6654       .
     6655       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     6656       do while error-status:error eq yes:
     6657          VDay = vDay + 1.
     6658          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     6659       end.
     6660       if VDay > 0
     6661       then
     6662          vDateNew + 1.
     6663       return vDateNew.
     6664   end.
     6665   procedure checkEMRC:
     6666   define input  parameter iDm as character no-undo.
     6667   define output parameter vok as logical   no-undo init yes.
     6668      define variable v-value-emrc as character no-undo.
     6669      define variable v-type-emrc  as character no-undo.
     6670      define variable vDateIso     as character no-undo.
     6671      define variable vMRC         as decimal no-undo.
     6672      define variable vqnty        as decimal no-undo.
     6673      define variable vPrice       as decimal no-undo.
     6674      define variable vparent      as character no-undo.
     6675      define variable vgds-code    as integer no-undo.
     6676      define buffer code for ub.code.
     6677      vMRC = getMRCByDM(iDm).
     6678      if vMRC > 0
     6679      then do:
     6680         vgds-code = getGdsCodeByDM(iDm).
     6681         vqnty     = getQntyUTDByDM(iDm).
     6682               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     6683            (
     6684             input   vgds-code
     6685            ,input   'emrc-type':U
     6686            ,output   v-value-emrc
     6687            ,output   v-type-emrc
     6688          ) no-error.
     6689          if     v-value-emrc ne ""
     6690             and v-value-emrc ne ?
     6691          then do:
     6692             vDateIso = iso-date(today).
     6693             vPrice = vMRC / vqnty.
     6694             vparent ="emc" + chr(4) + v-value-emrc.
     6695             find last code where Code.parent      eq vparent
     6696                              and Code.code        le vDateIso
     6697                              and code.status_  eq 0
     6698             no-lock no-error.
     6699             if not available code or ( vPrice  >= dec(Code.CodeValue))
     6700             then
     6701                vOk = true .
     6702             else do:
     6703                 define variable vText      as character no-undo.
     6704                 define variable vDate      as date no-undo.
     6705                 define variable vDateLast  as character no-undo.
     6706                 define variable vDateFirst as character no-undo.
     6707                 define variable vDate3     as date no-undo.
     6708                 vdate = date(code.misc1).
     6709                 vDateLast = code.misc1.
     6710                 vDate3 = MoveDate(today, - 3 ).
     6711                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     6712                                      string(vDate3  , "99/99/9999"),
     6713                                      string(vDate   , "99/99/9999")
     6714                                      ).
     6715                 vdateIso = iso-date(vdate3).
     6716                 find last code  where Code.parent      eq vparent
     6717                                   and Code.code        le vDateIso
     6718                                   and code.status_  eq 0 no-lock no-error.
     6719                 if available code
     6720                 then
     6721                    vDateIso = code.code.
     6722                 vDateFirst = vDateIso.
     6723                 vDateLast = iso-date(vdate).
     6724                 define variable vGood as logical no-undo.
     6725                 define variable vDateSale as date no-undo.
     6726                 define buffer bcode for code.
     6727                 for last code where Code.parent   eq vparent
     6728                                 and code.status_  eq 0
     6729                                 and code.code     < vDateLast
     6730                                 and code.code     >= vDateFirst
     6731                 no-lock:
     6732                    find first bcode where bCode.parent   eq vparent
     6733                                       and bcode.status_  eq 0
     6734                                       and bcode.code     > code.code no-lock no-error.
     6735                    if available bcode
     6736                    then do:
     6737                       if vPrice < dec(Code.CodeValue)
     6738                       then
     6739                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     6740                                                     chr(10),
     6741                                                     string(    date( code.misc1)       ,"99/99/9999"),
     6742                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     6743                                                     ).
     6744                       else do:
     6745                          vGood = yes.
     6746                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     6747                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     6748                                                     chr(10),
     6749                                                     string(    date( code.misc1)         ,"99/99/9999"),
     6750                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     6751                                                     string(         vDateSale            ,"99/99/9999"),
     6752                                                     string(vDateSale - today)
     6753                                                     ).
     6754                       end.
     6755                    end.
     6756                 end.
     6757                 if vgood
     6758                 then do:
     6759                    define variable choice as integer no-undo .
     6760                    run gbl/d-askw.w (input "Уточнение"
     6761                           ,input  vText
     6762                           ,input "|"
     6763                           ,input "Принять|Вернуть"
     6764                           ,input "Принять данный товар|Вернуть товар постащику"
     6765                           ,input 1
     6766                           ,input 2
     6767                           ,output choice) no-error.
     6768                    vok = choice eq 1.
     6769                 end.
     6770                 else
     6771                    vok =false.
     6772             end.
     6773          end.
     6774      end.
     6775   end.
     6776   function addGs2Mark return character
     6777   (iMark as char):
     6778      define variable vDM   as character no-undo.
     6779      define variable vIdx  as integer   no-undo.
     6780      if index(iMark,chr(29),1) > 0
     6781      then return iMark.
     6782      if substring(iMark,26,4) = "8005" then
     6783      do:
     6784        vIdx = index(iMark,"93",26 + 4 + 5).
     6785        if vIdx > 1 then do:
     6786          vDM = substitute("&1&4&2&4&3",
     6787                           substring(iMark,1,25),
     6788                           substring(iMark,26,vIdx - 25 - 1),
     6789                           substring(iMark,vIdx),
     6790                           chr(29)) no-error.
     6791          vIdx = index(vDm,"240",vIdx + 4).
     6792          if vIdx > 0 then
     6793          do:
     6794            vDM = substitute("&1&3&2",
     6795                             substring(vDm,1,vIdx - 1),
     6796                             substring(vDm,vIdx),
     6797                             chr(29)) no-error.
     6798          end.
     6799        end.
     6800        else
     6801          vDM = substitute("&1&3&2",
     6802                           substring(iMark,1,25),
     6803                           substring(iMark,26),
     6804                           chr(29)) no-error.
     6805      end.
     6806      else if substring(iMark,32,2) = "91" then
     6807      do:
     6808        vIdx = index(iMark,"92",32).
     6809        if vIdx > 1 then
     6810          vDM = substitute("&1&4&2&4&3",
     6811                           substring(iMark,1,31),
     6812                           substring(iMark,32,vIdx - 31 - 1),
     6813                           substring(iMark,vIdx),
     6814                           chr(29)) no-error.
     6815        else
     6816          vDM = substitute("&1&3&2",
     6817                           substring(iMark,1,31),
     6818                           substring(iMark,32),
     6819                           chr(29)) no-error.
     6820      end.
     6821      else if substring(iMark,39,2) = "91" then
     6822      do:
     6823        vIdx = index(iMark,"92",38).
     6824        if vIdx > 1 then
     6825          vDM = substitute("&1&4&2&4&3",
     6826                           substring(iMark,1,38),
     6827                           substring(iMark,39,vIdx - 38 - 1),
     6828                           substring(iMark,vIdx),
     6829                           chr(29)) no-error.
     6830        else
     6831          vDM = substitute("&1&3&2",
     6832                           substring(iMark,1,38),
     6833                           substring(iMark,39),
     6834                           chr(29)) no-error.
     6835      end.
     6836      else if substring(iMark,25,2) = "93" then
     6837      do:
     6838        vIdx = index(iMark,"92",25).
     6839        if vIdx > 1 then
     6840          vDM = substitute("&1&4&2&4&3",
     6841                           substring(iMark,1,24),
     6842                           substring(iMark,25,vIdx - 24 - 1),
     6843                           substring(iMark,vIdx),
     6844                           chr(29)) no-error.
     6845        else
     6846          vIdx = index(iMark,"3103",25).
     6847          if vIdx > 0 then
     6848          vDM = substitute("&1&4&2&4&3",
     6849                           substring(iMark,1,24),
     6850                           substring(iMark,25,vIdx - 24 - 1),
     6851                           substring(iMark,vIdx),
     6852                           chr(29)) no-error.
     6853          else
     6854            vDM = substitute("&1&3&2",
     6855                             substring(iMark,1,24),
     6856                             substring(iMark,25),
     6857                             chr(29)) no-error.
     6858      end.
     6859      else if substring(iMark,32,2) = "93" then
     6860      do:
     6861        vDM = substitute("&1&3&2",
     6862              substring(iMark,1,31),
     6863              substring(iMark,32),
     6864              chr(29)) no-error.
     6865      end.
     6866      return if vDM <> "" then vDm else iMark.
     6867   end.
