    10577   if (ub.clients.obj-type = v-cntxt-obj-type and ub.clients.obj-code = v-cntxt-obj-code) or
    10578      (ub.clients.obj-type = 'орг':U and ub.clients.obj-code = v-cntxt-host-code-obj) then do:
    10579     release ub.clients no-error.
    10580     message "Запрещенный код и тип контрагента.".
    10581     apply "entry" to t-doc.cli-code in frame d-in-doc.
    10582     return error.
    10583   end.
