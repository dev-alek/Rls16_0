     9465   def var sort-labelbr-dtl   as character no-undo .
     9466   def var sort-clmnbr-dtl    as handle    no-undo .
     9467   def var cur-clmnbr-dtl     as handle    no-undo .
     9468   def var cur-clmn-locbr-dtl as integer   no-undo .
     9469   def var re-querybr-dtl     as logical   initial no no-undo .
     9470   on start-search, ctrl-o of br-dtl in frame d-in-doc do:
     9471      run sort-brbr-dtl
     9472        (input (if available doc-line
     9473                then recid(doc-line)
     9474                else ?
     9475               )
     9476        ).
     9477   end.
     9478   PROCEDURE sort-brbr-dtl :
     9479     define input parameter p-recid as recid no-undo .
     9480     if re-querybr-dtl = no then do:
     9481       assign
     9482          cur-clmnbr-dtl = br-dtl:current-column in frame d-in-doc
     9483       .
     9484       if sort-clmnbr-dtl <> ? then sort-clmnbr-dtl:column-fgcolor = 0.
     9485       if cur-clmnbr-dtl = sort-clmnbr-dtl then do:
     9486         assign
     9487            sort-labelbr-dtl = ""
     9488            sort-clmnbr-dtl = ?
     9489         .
     9490        end.
     9491        else do:
     9492          assign
     9493            sort-labelbr-dtl = cur-clmnbr-dtl:label
     9494            sort-clmnbr-dtl  = cur-clmnbr-dtl
     9495            sort-clmnbr-dtl:column-fgcolor = 4
     9496          .
     9497        end.
     9498      end.
     9499     assign
     9500       cur-clmn-locbr-dtl = 1
     9501     .
     9502     def var column-handle as handle no-undo .
     9503     column-handle = br-dtl:first-column.
     9504     do while valid-handle(column-handle) :
     9505       if column-handle = cur-clmnbr-dtl then do:
     9506         leave .
     9507       end.
     9508       column-handle = column-handle:NEXT-COLUMN.
     9509       assign
     9510         cur-clmn-locbr-dtl = cur-clmn-locbr-dtl + 1
     9511       .
     9512     end.
     9513     case sort-labelbr-dtl:
     9514           when '*'  then DO:   sort-default = no. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK by get-mark  (BUFFER  ub.doc-line) .   . END.
     9515           when 'П/П'  then DO:   sort-default = no. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK by ub.doc-line.line-num .   . END.
     9516           when 'Ш'  then DO:   sort-default = no. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK by ub.doc-line.prt-OK .   . END.
     9517           when 'Артикул'  then DO:   sort-default = no. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK by ub.doc-line.artic .   . END.
     9518           when 'Название'  then DO:   sort-default = no. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK by ub.goods.gds-name .   . END.
     9519           when 'По ТТН'  then DO:   sort-default = no. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK by ub.doc-line.cli-qnty .   . END.
     9520           when 'Изм'  then DO:   sort-default = no. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK by ub.doc-line.unit-cli .   . END.
     9521           when 'Цена пост.'  then DO:   sort-default = no. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK by ub.doc-line.price-cli .   . END.
     9522           when 'Сумма пост.'  then DO:   sort-default = no. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK by ( ub.doc-line.cli-qnty *  ub.doc-line.price-cli) .   . END.
     9523           when 'По док-ту'  then DO:   sort-default = no. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK by ub.doc-line.doc-qnty .   . END.
     9524           when 'Факт'  then DO:   sort-default = no. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK by ub.doc-line.fact-qnty .   . END.
     9525           when 'Изм.'  then DO:   sort-default = no. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK by ub.goods.unit-base .   . END.
     9526           when 'Цена учет(прод.)'  then DO:   sort-default = no. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK by (if varr-b = 'rubl':u then  ub.doc-line.price-rubl else  ub.doc-line.price-base) .   . END.
     9527           when 'Цена продажи'  then DO:   sort-default = no. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK by ub.gds-obj.price-sale .   . END.
     9528           when '%'  then DO:   sort-default = no. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK by (if varr-b = 'rubl':u then ((ub.gds-obj.price-sale -  ub.doc-line.price-rubl) /  ub.doc-line.price-rubl * 100) else ((ub.gds-obj.price-sale -  ub.doc-line.price-base) /  ub.doc-line.price-base * 100)) .   . END.
     9529           when 'Шкала'  then DO:   sort-default = no. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK by get-name (BUFFER  ub.doc-line, buffer ub.goods, buffer ub.gds-prt) .   . END.
     9530           when 'НДС'  then DO:   sort-default = no. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK by ub.doc-line.VAT-pc .   . END.
     9531           when 'Название англ.'  then DO:   sort-default = no. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK by ub.goods.engl-name .   . END.
     9532           when 'Кол-во мест'  then DO:   sort-default = no. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK by ub.doc-line.num-place .   . END.
     9533           when 'Вес брутто'  then DO:   sort-default = no. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK by ub.doc-line.wt-brutto .   . END.
     9534           when 'Кол в там. ед.'  then DO:   sort-default = no. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK by ub.doc-line.fact-qnty * ub.goods.cst-base-rate .   . END.
     9535           when 'Прих. цена'  then DO:   sort-default = no. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK by last-price (buffer  ub.doc-line) .   . END.
     9536           when '% откл прих. цены'  then DO:   sort-default = no. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK by deviation-price (buffer  ub.doc-line) .   . END.
     9537           when 'Факт, кг'  then DO:   sort-default = no. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK by get-kg-fact-qnty(  buffer  ub.doc-line ) .   . END.
     9538           when 'Цена за кг (вал.)'  then DO:   sort-default = no. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK by get-kg-sale-base(  buffer  ub.doc-line ) .   . END.
     9539           when 'Цена за кг (руб.)'  then DO:   sort-default = no. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK by get-kg-sale-rubl(  buffer  ub.doc-line ) .   . END.
     9540           when 'Итого, кг'  then DO:   sort-default = no. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK by get-kg-after-qnty( buffer  ub.doc-line ) .   . END.
     9541           when 'Доп. к ГТД'  then DO:   sort-default = no. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK by get-add-gtd( buffer ub.doc-line ) .   . END.
     9542           when 'Причина отклонения по РТ'  then DO:   sort-default = no. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK by lineattr-get-reason( buffer ub.doc-line ) .   . END.
     9543       otherwise do:
     9544         sort-default = yes. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK BY  ub.doc-line.line-num. .
     9545           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-dtl') then do:
     9546             run mv-brw-defaultbr-dtl.
     9547           end.
     9548         if sort-labelbr-dtl <> "" then do:
     9549           assign
     9550             cur-clmnbr-dtl:column-fgcolor = 0
     9551           .
     9552         end.
     9553         assign
     9554           cur-clmn-locbr-dtl = ?
     9555         .
     9556       end.
     9557     end case.
     9558       if cur-clmn-locbr-dtl <> ? then do:
     9559         if can-do( this-procedure:internal-entries, 'ch-clmnbr-dtl') then do:
     9560           run ch-clmnbr-dtl in this-procedure (cur-clmn-locbr-dtl).
     9561         end.
     9562       end.
     9563     if p-recid <> ? then do:
     9564       reposition br-dtl to recid p-recid no-error.
     9565       apply "value-changed" to br-dtl in frame d-in-doc.
     9566     end.
     9567     apply "entry" to br-dtl in frame d-in-doc.
     9568   END PROCEDURE.
     9569   procedure re-open-query-srt-clmnbr-dtl:
     9570   if cur-clmnbr-dtl = ? then do:
     9571      sort-default = yes. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK BY  ub.doc-line.line-num. .
     9572   end.
     9573   else do:
     9574      assign re-querybr-dtl = yes.
     9575      run sort-brbr-dtl
     9576        (input (if available doc-line
     9577                then recid(doc-line)
     9578                else ?
     9579               )
     9580        ).
     9581      assign re-querybr-dtl = no.
     9582   end.
     9583   end.
     9584   define variable vss-include-info60 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9585   define variable result as LOGICAL NO-UNDO.
     9586   ON ctrl-cursor-up OF browse br-dtl do:
     9587      RUN change-line-num("up", output result).
     9588      IF result THEN DO:
     9589         sort-default = yes. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK BY  ub.doc-line.line-num.
     9590         reposition br-dtl to recid line-rec no-error.
     9591      END.
     9592   END.
     9593   ON ctrl-cursor-down OF browse br-dtl do:
     9594      RUN change-line-num("down", output result).
     9595      IF result THEN DO:
     9596         sort-default = yes. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,            EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,            first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,            EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK BY  ub.doc-line.line-num.
     9597         reposition br-dtl to recid line-rec no-error.
     9598      END.
     9599   END.
     9600   PROCEDURE change-line-num:
     9601   define input parameter par-up-down as char no-undo.
     9602   define output parameter parresult as log initial no no-undo.
     9603   define variable source-doc-line-num as integer   no-undo .
     9604   define buffer   source-doc-line     for ub.doc-line.
     9605   define variable varlog as logical no-undo.
     9606   IF AVAILABLE doc-line THEN DO:
     9607      ASSIGN line-rec = RECID(doc-line).
     9608      if sort-default = NO THEN DO:
     9609           ASSIGN varlog = NO.
     9610           MESSAGE "Отсортировано не по порядку ввода в накладную."
     9611                   "Отмените сортировку!"
     9612           VIEW-AS ALERT-BOX ERROR TITLE "Ошибка при изменении порядка ввода в накладную".
     9613      END.
     9614      ASSIGN source-doc-line-num = doc-line.line-num.
     9615      FIND FIRST source-doc-line WHERE RECID(source-doc-line) = RECID(doc-line)
     9616      EXCLUSIVE-LOCK.
     9617      if par-up-down = "up" then GET PREV br-dtl EXCLUSIVE-LOCK.
     9618                            else GET NEXT br-dtl EXCLUSIVE-LOCK.
     9619      IF AVAILABLE doc-line THEN DO:
     9620         ASSIGN source-doc-line.line-num = doc-line.line-num
     9621                doc-line.line-num        = source-doc-line-num.
     9622         ASSIGN parresult = YES.
     9623      END.
     9624   END.
     9625   ELSE MESSAGE "Линия выбрана неправильно."
     9626        VIEW-AS ALERT-BOX INFO BUTTONS OK.
     9627   END PROCEDURE.
     9628   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9629   DEF VAR cur-clmn-numbr-dtl as INT EXTENT 29 no-undo.
     9630   DEF VAR varmvibr-dtl       as INT no-undo.
     9631   DEF VAR varmvjbr-dtl       as INT no-undo.
     9632   DEF VAR varmvkbr-dtl       as INT no-undo.
     9633   DEF VAR varmvlbr-dtl       as INT no-undo.
     9634   DEF VAR move-elementbr-dtl as INT no-undo.
     9635   def var jjbr-dtl           as int no-undo.
     9636   do varmvibr-dtl = 1 to EXTENT(cur-clmn-numbr-dtl):
     9637     ASSIGN cur-clmn-numbr-dtl[varmvibr-dtl] = varmvibr-dtl.
     9638   END.
     9639   RUN start-mv-clmnbr-dtl.
     9640   PROCEDURE start-mv-clmnbr-dtl:
     9641   def var old-session as logical no-undo.
     9642      old-session = SESSION:IMMEDIATE-DISPLAY.
     9643      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     9644      SESSION:IMMEDIATE-DISPLAY = old-session.
     9645   END.
     9646   ON ctrl-cursor-right OF BROWSE br-dtl do:
     9647     RUN re-move-clmnbr-dtl ( 5, 29).
     9648   END.
     9649   ON ctrl-cursor-left OF BROWSE br-dtl do:
     9650     RUN re-move-clmnbr-dtl (29, 5).
     9651   END.
     9652   PROCEDURE re-move-clmnbr-dtl:
     9653     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     9654     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     9655     DO varmvibr-dtl = 1 TO EXTENT(cur-clmn-numbr-dtl):
     9656       if cur-clmn-numbr-dtl[varmvibr-dtl] = source-column THEN cur-clmn-numbr-dtl[varmvibr-dtl] = -1.
     9657     END.
     9658     if br-dtl:MOVE-COLUMN(source-column, target-column) IN FRAME d-in-doc then.
     9659     if source-column > target-column THEN
     9660     DO varmvjbr-dtl = source-column - 1 to target-column BY -1:
     9661       DO varmvibr-dtl = 1 TO EXTENT(cur-clmn-numbr-dtl):
     9662           if cur-clmn-numbr-dtl[varmvibr-dtl] = varmvjbr-dtl THEN DO:
     9663             cur-clmn-numbr-dtl[varmvibr-dtl] = cur-clmn-numbr-dtl[varmvibr-dtl] + 1.
     9664           END.
     9665       END.
     9666     END.
     9667     ELSE
     9668     DO varmvjbr-dtl = source-column + 1 to target-column:
     9669       DO varmvibr-dtl = 1 TO EXTENT(cur-clmn-numbr-dtl):
     9670         if cur-clmn-numbr-dtl[varmvibr-dtl] = varmvjbr-dtl THEN DO:
     9671           cur-clmn-numbr-dtl[varmvibr-dtl] = cur-clmn-numbr-dtl[varmvibr-dtl] - 1.
     9672         END.
     9673       END.
     9674     END.
     9675     DO varmvibr-dtl = 1 TO EXTENT(cur-clmn-numbr-dtl):
     9676       if cur-clmn-numbr-dtl[varmvibr-dtl] = -1 THEN cur-clmn-numbr-dtl[varmvibr-dtl] = target-column.
     9677     END.
     9678   END PROCEDURE.
     9679   PROCEDURE ch-clmnbr-dtl:
     9680     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     9681     if cur-clmn-loc <= 5 then do:
     9682       return .
     9683     end.
     9684     DO varmvibr-dtl = 1 TO EXTENT(cur-clmn-numbr-dtl):
     9685       if cur-clmn-numbr-dtl[varmvibr-dtl] = cur-clmn-loc THEN move-elementbr-dtl = varmvibr-dtl.
     9686     END.
     9687     RUN re-move-clmnbr-dtl (cur-clmn-loc, 5).
     9688   END PROCEDURE.
     9689   PROCEDURE mv-brw-defaultbr-dtl:
     9690   def var old-session as logical no-undo.
     9691     old-session = SESSION:IMMEDIATE-DISPLAY.
     9692     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     9693     do varmvlbr-dtl = 5 to EXTENT(cur-clmn-numbr-dtl):
     9694       RUN re-move-clmnbr-dtl (cur-clmn-numbr-dtl[varmvlbr-dtl], varmvlbr-dtl).
     9695     END.
     9696     RUN start-mv-clmnbr-dtl.
     9697     SESSION:IMMEDIATE-DISPLAY = old-session.
     9698   END PROCEDURE.
     9699   .
     9700   define variable vss-include-info62 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9701   on F9 of frame d-in-doc anywhere do:
     9702     if not available ub.goods then
     9703       return no-apply.
     9704     gds-rec = recid (ub.goods).
     9705     run ref/gds-form.w ( input parparentproc
     9706                         ,input 'ПРОСМОТР':U
     9707                         ,input ?
     9708                         ,input ?
     9709                         ,input ?
     9710                         ,input-output gds-rec).
     9711     apply "entry" to br-dtl in frame d-in-doc.
     9712     return no-apply.
     9713   end.
     9714   on F12 of frame d-in-doc anywhere do:
     9715     if v-is-gtd-part = "yes" then run gtd-line in this-procedure .
     9716     return no-apply.
     9717   END.
     9718   define variable vss-include-info63 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9719   def var vss-include-info64 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9720   function func-get-name-from-ext-type   returns char
     9721     ( p-ext-type as character   ,
     9722       p-caps     as logical ).
     9723   define variable v-ext-name as character no-undo .
     9724   run get-name-from-ext-type in this-procedure (
     9725       input p-ext-type  ,
     9726       input p-caps  ,
     9727       output v-ext-name )
     9728       no-error .
     9729       if error-status :error then do:
     9730          assign
     9731            v-ext-name = p-ext-type
     9732          .
     9733       end.
     9734    return (v-ext-name) .
     9735   end.
     9736   procedure get-name-from-ext-type :
     9737    do
     9738    on error undo, return error return-value
     9739    :
     9740   define input  parameter p-ext-type as character no-undo .
     9741   define input  parameter p-caps     as logical no-undo   .
     9742   define output parameter p-ext-name as character no-undo .
     9743   define variable v-num as integer no-undo .
     9744     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
     9745       message
     9746         vss-include-info64 skip
     9747         "Неправильно задано значение входящего параметра! "
     9748         "Нет такого типа документов " p-ext-type
     9749         view-as alert-box error .
     9750         undo, return error .
     9751     end.
     9752     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
     9753     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
     9754     if p-caps  = true then do :
     9755        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
     9756     end .
     9757     end.
     9758   end procedure.
     9759   define variable vss-include-info65 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9760   on F3 of frame d-in-doc anywhere do:
     9761     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame d-in-doc. END.
     9762     return no-apply.
     9763   end.
     9764   define variable vss-include-info66 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9765   on CTRL-N, CTRL-Т of frame d-in-doc anywhere do:
     9766     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame d-in-doc. END.
     9767     return no-apply.
     9768   end.
     9769   define variable vss-include-info67 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9770   on F4 of frame d-in-doc anywhere do:
     9771     if b-chg :sensitive then DO: apply "CHOOSE":U to b-chg in frame d-in-doc. END.
     9772     return no-apply.
