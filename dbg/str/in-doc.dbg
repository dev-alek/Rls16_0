    11598   end.
    11599   end.
    11600   end procedure.
    11601   procedure notes-tr:
    11602   define variable notes as character no-undo.
    11603   assign
    11604     notes = t-doc.PS.
    11605   if pardoc-mode = 'ПРОСМОТР':U then do:
    11606     run gbl/d-prompt.w (
    11607         'title=Примечание\'
    11608       + 'type=editor\'
    11609       + 'fillin_width=96\'
    11610       + 'fillin_height=15\'
    11611       + 'readonly=yes\'
    11612       , input-output notes).
    11613   end.
    11614   else do:
    11615      run gbl/d-prompt.w (
    11616         'title=примечание\'
    11617       + 'type=editor\'
    11618       + 'fillin_width=96\'
    11619       + 'fillin_height=15\'
    11620       , input-output notes).
    11621       if return-value = 'false':u then return .
    11622     if t-doc.PS <> notes then do:
    11623     if pardoc-rec = ? then pardoc-rec = recid (t-doc).
    11624       do transaction on error undo, return error return-value :
    11625         find t-doc where recid (t-doc) = pardoc-rec exclusive.
    11626         assign
    11627           t-doc.PS = notes.
    11628       end.
    11629     end.
    11630   end.
    11631   end procedure.
    11632   procedure choose-cli:
    11633   define variable varfirm-code like ub.firm.firm-code no-undo.
    11634   define variable v-types as character no-undo .
    11635   define buffer bf_clients for ub.clients.
    11636   define variable ref-rec as recid no-undo.
    11637   define variable v-rid-list as character no-undo .
    11638   do on error undo, return error return-value :
    11639   run check-cli no-error.
    11640   if error-status :error then do:
    11641     if t-doc.internal then v-types = 'маг':U.
    11642                       else v-types = 'все':U.
    11643     if (t-doc.ext-doc-type = 'ee':U or t-doc.ext-doc-type = 'ep':U) and
    11644        varhold            = "yes"              and
    11645        paris-hold         = yes                then do:
    11646       assign
    11647         varfirm-code = ?.
    11648       run adm/sconfs.w ( input parparentproc
    11649                       , input "b-sel":U
    11650                       , input no
    11651                       , input ?
    11652                       , output varfirm-code
    11653                       , input-output v-rid-list) no-error.
    11654       if error-status :error or
    11655          varfirm-code = ?   then do:
    11656         return error.
    11657       end.
    11658       find first bf_clients where bf_clients.obj-type = 'орг':U       and
    11659                                   bf_clients.obj-code = varfirm-code no-lock.
    11660       assign ref-list = string(recid (bf_clients)).
    11661       run check-base-code in this-procedure (recid(bf_clients)).
    11662     end.
    11663     else do:
    11664       if transaction = yes then do:
    11665         message "Критическая ошибка." skip
    11666                 "Вы находитесь в транзакции." skip
    11667                 "Работа со справочником клиентов невозможна."
    11668         view-as alert-box error.
    11669         return error.
    11670       end.
    11671       run ref/cli-all.w ( parparentproc
    11672                      , "b-sel,b-add"
    11673                      , v-types
    11674                      , ?
    11675                      , ?
    11676                      , ?
    11677                      , ?
    11678                      , ?
    11679                     , output ref-list) .
    11680     end.
    11681     if ref-list <> "" then do:
    11682       ref-rec = integer (ref-list).
    11683       find ub.clients where recid ( ub.clients ) = ref-rec no-lock.
    11684       disp ub.clients.obj-code @ t-doc.cli-code
    11685               ub.clients.obj-name with frame d-in-doc.
    11686       disp ub.clients.obj-type @ t-doc.cli-type with frame d-in-doc.
    11687     end.
    11688     run check-cli no-error.
    11689     if error-status :error then do:
    11690       return error return-value.
    11691     end.
    11692   end.
    11693   end.
    11694   end procedure.
    11695   procedure state-pay-code:
    11696   do transaction on error undo, return error :
    11697      if input frame d-in-doc t-doc.pay-code = v-cntxp-ret-sup-pay then do:
    11698         message "Нельзя устанавливаться код возврата поставщику." skip
    11699                 "Возврат поставщику оформляется из отдельнего пункта меню."
    11700         view-as alert-box error.
    11701         undo, return error.
    11702      end.
    11703      assign t-doc.pay-code = input frame d-in-doc t-doc.pay-code no-error.
    11704      for each ub.parts where ub.parts.out-code = t-doc.doc-code:
    11705          assign ub.parts.pay-code = t-doc.pay-code.
    11706      end.
    11707   end.
    11708   end procedure.
    11709   procedure return-pay-code:
    11710   if input frame d-in-doc t-doc.pay-code <> t-doc.pay-code then do:
    11711      if input frame d-in-doc t-doc.pay-code = v-cntxp-ret-sup-pay then do:
    11712         message "Нельзя устанавливаться код возврата поставщику." skip
    11713                 "Возврат поставщику оформляется из отдельнего пункта меню."
    11714         view-as alert-box error.
    11715         display t-doc.pay-code with frame d-in-doc.
    11716         return error.
    11717      end.
    11718   end.
    11719   find ub.pay-type where ub.pay-type.obj-code = input frame d-in-doc t-doc.pay-code no-lock no-error.
    11720   if not available ub.pay-type then apply "choose" to r-pay.
    11721   end procedure.
    11722   procedure choose-r-pay:
    11723   define variable varrecid-pay as recid no-undo.
    11724   define variable v-rid-list as character no-undo .
    11725   run ref/paytype.w (input parparentproc, "b-sel", output v-rid-list ).
    11726   find ub.pay-type where recid ( ub.pay-type ) = integer(v-rid-list) no-lock no-error.
    11727   if not available ub.pay-type then return no-apply.
    11728   if ub.pay-type.obj-code = v-cntxp-ret-sup-pay then do:
    11729      message "Нельзя устанавливаться код возврата поставщику." skip
    11730              "Возврат поставщику оформляется из отдельнего пункта меню."
    11731      view-as alert-box error.
    11732      display t-doc.pay-code with frame d-in-doc.
    11733      return error.
    11734   end.
    11735   display ub.pay-type.obj-code @ t-doc.pay-code with frame d-in-doc.
    11736   assign varrecid-pay = recid(ub.pay-type).
    11737   run state-pay-code no-error.
    11738   if error-status :error then do:
    11739     display t-doc.pay-code with frame d-in-doc.
    11740     apply "entry" to t-doc.pay-code in frame d-in-doc.
    11741     return error.
    11742   end.
    11743   find ub.pay-type where recid(ub.pay-type) = varrecid-pay no-lock.
    11744   display t-doc.pay-code ub.pay-type.obj-name with frame d-in-doc.
    11745   end procedure.
    11746   procedure leave-pay-code:
    11747   define variable varrecid-pay as recid no-undo.
    11748   if input frame d-in-doc t-doc.pay-code = v-cntxp-ret-sup-pay then do:
    11749      message "Нельзя устанавливаться код возврата поставщику." skip
    11750              "Возврат поставщику оформляется из отдельнего пункта меню."
    11751      view-as alert-box error.
    11752      display t-doc.pay-code with frame d-in-doc.
    11753      return error.
    11754   end.
    11755   find ub.pay-type where ub.pay-type.obj-code = input frame d-in-doc t-doc.pay-code no-lock no-error.
    11756   if not available ub.pay-type then do:
    11757     message "Нет вида оплаты с таким кодом.".
    11758     display t-doc.pay-code with frame d-in-doc.
    11759     apply "entry" to t-doc.pay-code in frame d-in-doc.
    11760     return error.
    11761   end.
    11762   assign varrecid-pay = recid(ub.pay-type).
    11763   run state-pay-code no-error.
    11764   if error-status :error then do:
    11765     display t-doc.pay-code with frame d-in-doc.
    11766     apply "entry" to t-doc.pay-code in frame d-in-doc.
    11767     return error.
    11768   end.
    11769   find ub.pay-type where recid(ub.pay-type) = varrecid-pay no-lock.
    11770   display ub.pay-type.obj-name with frame d-in-doc.
    11771   end procedure.
    11772   procedure proc-exit :
    11773     define variable v-vat-pc   as decimal no-undo .
    11774     define variable v-slt-pc   as decimal no-undo .
    11775     define variable v-insalepr as logical no-undo .
    11776     assign parnext-prev = ?.
    11777     if lookup( pardoc-mode, 'ДОБАВЛЕНИЕ':U ) > 0 then do:
    11778       if not can-find (first ub.doc-line where ub.doc-line.doc-code = t-doc.doc-code no-lock) then do:
    11779         delete t-doc.
    11780         assign pardoc-rec = ?.
    11781       end.
    11782       return.
    11783     end.
    11784     if lookup( pardoc-mode, 'ИЗМЕНЕНИЕ':U ) > 0 then do:
    11785       if not can-find (first ub.doc-line where ub.doc-line.doc-code = t-doc.doc-code no-lock) and t-doc.is-flora = false then do:
    11786         assign varlog = true .
    11787         message "В документе нет строк, поэтому он удаляется." view-as alert-box question buttons OK-Cancel update varlog.
    11788         if varlog = yes then do:
    11789           if t-doc.is-flora = false then do:
    11790               define variable varchip-code as decimal   no-undo .
    11791                     run str/del-doc.p
    11792                         ( input  parparentproc,
    11793                           input  t-doc.doc-code,
    11794                           input  v-cntxt-db-num,
    11795                           input  "del-doc.err",
    11796                           input  ?,
    11797                           input  ?,
    11798                           input  v-cntxt-userid,
    11799                           input  t-doc.doc-code,
    11800                           input  ?,
    11801                           output varchip-code )
    11802                           .
    11803             assign pardoc-rec = ?.
    11804             return.
    11805           end.
    11806           else do:
    11807             assign varlog = false .
    11808             message "ВНИМАНИЕ !!! Документ удалится, так как в нем НЕТ ТОВАРОВ!!!"
    11809                        view-as alert-box  question buttons OK-Cancel update varlog .
    11810             if varlog = yes then do:
    11811               delete t-doc.
    11812               assign pardoc-rec = ?.
    11813               return.
    11814             end.
    11815             return error.
    11816           end.
    11817         end.
    11818         else do: return error. end.
    11819       end.
    11820       assign frame d-in-doc t-doc.wrkr t-doc.agnt t-doc.boss .
    11821       define variable v-err as logical   no-undo .
    11822       run str/ver-fl.p ( input pardoc-mode, input t-doc.doc-code , output v-err ) no-error .
    11823       if error-status :error then return error.
    11824       define buffer buff_doc-line for ub.doc-line  .
    11825       define variable v-mess as character no-undo .
    11826       for each buff_doc-line no-lock  where buff_doc-line.doc-code = t-doc.doc-code :
    11827       v-mess = "" .
    11828   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn4) <> true) then do:   run str/lib-trn4.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn4) <> true) then do:     message       "Error starting lib-trn4.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn4 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn4_linesprc in g#lib-trn4
    11829     (input  recid(buff_doc-line)
    11830     ,output v-mess
    11831     )  .
    11832         if v-mess <> "" then do:
    11833           message v-mess view-as alert-box error TITLE "Сверка количества со спецификацией".
    11834           return error.
    11835         end.
    11836         if not v-cntxp-inout-price and  not t-doc.flag_ then do:
    11837             find ub.goods where ub.goods.artic    = buff_doc-line.artic     and
    11838                              ub.goods.prod-type = buff_doc-line.prod-type and
    11839                              ub.goods.prod-code = buff_doc-line.prod-code no-lock.
    11840   define variable vss-include-info93 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11841   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
    11842     (input  ub.goods.gds-code
    11843     ,input  '1':U
    11844     ,input  ?
    11845     ,input  t-doc.host-code
    11846     ,input  t-doc.obj-type
    11847     ,input  t-doc.obj-code
    11848     ,output v-vat-pc
    11849     ) no-error .
    11850   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_st-sltpc in g#lib-trn
    11851   (
    11852    input  recid(ub.goods)
    11853   ,input  recid(t-doc)
    11854   ,input  bf_sysconf.cash-pay
    11855   ,output v-slt-pc
    11856   )
    11857   .
    11858               if  buff_doc-line.vat-pc <> v-vat-pc     or buff_doc-line.slt-pc <> v-slt-pc
    11859               then do:
    11860                 v-mess = substitute(" В карточке товара &1 &2 установлены другие налоги !&7 НДС &3% НСП &4% , а в документе &5% и &6%" , ub.goods.gds-code, ub.goods.gds-name, buff_doc-line.vat-pc , buff_doc-line.slt-pc , v-vat-pc , v-slt-pc , chr(10) ) .
    11861                 message v-mess view-as alert-box error TITLE "Запрет на изменение налогов при приеме у поставщика".
    11862                 return error.
    11863               end.
    11864         end.
    11865         find ub.goods where ub.goods.artic    = buff_doc-line.artic     and
    11866                          ub.goods.prod-type = buff_doc-line.prod-type and
    11867                          ub.goods.prod-code = buff_doc-line.prod-code no-lock.
    11868   define variable vss-include-info94 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11869   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
    11870     (input  buff_doc-line.obj-type
    11871     ,input  buff_doc-line.obj-code
    11872     ,input  buff_doc-line.artic
    11873     ,input  buff_doc-line.prod-type
    11874     ,input  buff_doc-line.prod-code
    11875     ,input  'insalepr=request':U
    11876     ,output v-insalepr
    11877     )  .
    11878         if v-insalepr <> ? and v-insalepr = true
    11879         then do:
    11880           t-doc.tot-cli = t-doc.tot-calc.
    11881         end.
    11882       end.
    11883     end.
    11884     if t-doc.ext-doc-type = 'ep':U  and pardoc-mode <> 'ПРОСМОТР':U then do:
    11885        run str/ep-corrp.p (input parparentproc , input t-doc.doc-code ) no-error.
    11886     end.
    11887     run fill-mol in this-procedure.
    11888   end procedure.
    11889   procedure check-base-code :
    11890   define input parameter parrec-id as recid no-undo.
    11891   define variable varmy-host-code  like ub.sysconf.host-code no-undo.
    11892   define variable varmy-base-code  like ub.sysconf.base-code no-undo.
    11893   define variable varcli-base-code like ub.sysconf.base-code no-undo.
    11894   define buffer bf-my_currency  for ub.currency.
    11895   define buffer bf-cli_currency for ub.currency.
    11896   define buffer bf_clients for ub.clients.
    11897   do on error undo, return error return-value :
    11898     find first bf_clients where recid(bf_clients) = parrec-id no-lock.
    11899   define variable vss-include-info95 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11900   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
    11901     (input  v-cntxt-obj-type
    11902     ,input  v-cntxt-obj-code
    11903     ,output varmy-host-code
    11904     ) no-error .
    11905     if error-status :error then do:
    11906       message "Ошибка при поиске фирмы для объекта " v-cntxt-obj-type " " v-cntxt-obj-code " ." skip
    11907               return-value skip
    11908               error-status :get-message( 1 )
    11909       view-as alert-box error.
    11910       return no-apply.
    11911     end.
    11912   define variable vss-include-info96 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11913   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
    11914     (input  varmy-host-code
    11915     ,output varmy-base-code
    11916     ) no-error .
    11917     if error-status :error then do:
    11918       message "Ошибка при поиске базовой валюты для фирмы " varmy-base-code " ." skip
    11919               return-value skip
    11920               error-status :get-message( 1 )
    11921       view-as alert-box error.
    11922       return no-apply.
    11923     end.
    11924   define variable vss-include-info97 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11925   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
    11926     (input  bf_clients.obj-code
    11927     ,output varcli-base-code
    11928     ) no-error .
    11929     if error-status :error then do:
    11930       message "Ошибка при поиске базовой валюты для фирмы " bf_clients.obj-code " ." skip
    11931               return-value skip
    11932               error-status :get-message( 1 )
    11933       view-as alert-box error.
    11934       return no-apply.
    11935     end.
    11936     if varmy-base-code <> varcli-base-code then do:
    11937       find first bf-my_currency  where bf-my_currency.curr-code  = varmy-base-code  no-lock.
    11938       find first bf-cli_currency where bf-cli_currency.curr-code = varcli-base-code no-lock.
    11939       message "Несоответствие базовых валют фирм при межфирменном перемещении." skip
    11940               "У нашей фирмы " varmy-host-code " базовая валюта " bf-my_currency.curr-abbr " " bf-my_currency.curr-name " с кодом " bf-my_currency.curr-code " ." skip
    11941               "У фирмы контрагента " bf_clients.obj-code " базовая валюта " bf-cli_currency.curr-abbr " " bf-cli_currency.curr-name " с кодом " bf-cli_currency.curr-code " ." skip
    11942               "Межфирменное перемещение невозможно."
    11943       view-as alert-box error.
    11944       return error.
    11945     end.
    11946   end.
    11947   end procedure.
    11948   procedure proc-history :
    11949     define variable loc-ref-list as character no-undo.
    11950     define variable loc-doc-save as recid     no-undo.
    11951     define variable loc-mode     as character no-undo.
    11952     define variable loc#stat     as character no-undo.
    11953     define variable loc#type     as character no-undo.
    11954     define variable loc#internal as logical   no-undo.
    11955     define buffer buffer_trn-doc for ub.trn-doc.
    11956     do on error undo, return error return-value :
    11957       if not available t-doc then do:
    11958         message "Неправильный выбор записи." view-as alert-box.
    11959         return error.
    11960       end.
    11961       find buffer_trn-doc no-lock where buffer_trn-doc.doc-code = t-doc.doc-code.
    11962       assign pardoc-rec      = recid( t-doc ).
    11963   define variable vss-include-info98 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11964   do:
    11965     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    11966       (input  v-cntxt-db-num
    11967       ,input  v-cntxt-userid
    11968       ,input  0
    11969       ,input  'actn_c-documents_all':U
    11970       ,input  'object':U
    11971       ,input  v-cntxt-host-code-obj
    11972       ,input  v-cntxt-obj-type
    11973       ,input  v-cntxt-obj-code
    11974       ,input  0
    11975       ,input  0
    11976       ,input  0
    11977       ,input  true
    11978       ,output varlog
    11979       )  .
    11980   end.
    11981       if varlog <> yes then do: return no-apply. end.
    11982       run str/calldocs.w (  input  parparentproc,
    11983                         input  'doc':U,
    11984                         input  buffer_trn-doc.status_,
    11985                         input  buffer_trn-doc.doc-type,
    11986                         input  buffer_trn-doc.flag_,
    11987                         input  buffer_trn-doc.internal,
    11988                         input  "":U,
    11989                         input  buffer_trn-doc.doc-code,
    11990                         input  paris-hold ,
    11991                         input  recid(buffer_trn-doc),
    11992                         input  t-doc.obj-type,
    11993                         input  t-doc.obj-code,
    11994                         output loc-ref-list ).
    11995       apply "ENTRY":U to br-dtl in frame d-in-doc.
    11996     end.
    11997     end procedure.
    11998   procedure fill-mol:
    11999     if pardoc-mode = 'ИЗМЕНЕНИЕ':U or pardoc-mode = 'ДОБАВЛЕНИЕ':U
    12000     then
    12001     do:
    12002       find first ub.user-account no-lock where ub.user-account.user-id = v-cntxt-userid.
    12003       if ub.user-account.psn-code <> 0 and ub.user-account.psn-code <> ?
    12004         then
    12005       do:
    12006         if t-doc.boss = ? then do:
    12007           t-doc.boss:screen-value in frame d-in-doc = string (ub.user-account.psn-code).
    12008           apply "leave" to t-doc.boss in frame d-in-doc.
    12009         end.
    12010         if t-doc.wrkr = ?
    12011         then do:
    12012           t-doc.wrkr:screen-value in frame d-in-doc = string (ub.user-account.psn-code).
    12013           apply "leave" to t-doc.wrkr in frame d-in-doc.
    12014         end.
    12015         t-doc.agnt:screen-value in frame d-in-doc = string (ub.user-account.psn-code).
    12016         apply "leave" to t-doc.agnt in frame d-in-doc.
    12017       end.
    12018       release ub.user-account.
    12019     end.
    12020   end.
    12021   define variable vss-include-info99 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12022   define variable varscales-pref99 as character no-undo .
    12023   define variable varpgscales-pref99 as character no-undo.
    12024   define variable vss-include-info100 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12025   define variable varscales-pref-type100 as character no-undo.
    12026   varscales-pref99  = ?.
    12027   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
    12028     (input  'sclspref':u
    12029     ,input  '':u
    12030     ,input  '':u
    12031     ,input  0
    12032     ,input  '':u
    12033     ,input  '':u
    12034     ,input  '':u
    12035     ,input  no
