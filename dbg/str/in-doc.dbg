     8526   end.
     8527   on ctrl-d of t-doc.ship-date in frame d-in-doc
     8528   do:
     8529     define variable v-curr-sv-date as date no-undo .
     8530     if (can-query (self, "sensitive")
     8531        and
     8532        self :sensitive = true
     8533        )
     8534     or (can-query (self, "read-only")
     8535        and
     8536        self :read-only = false
     8537        )
     8538     then do:
     8539       if self :handle <> focus :handle
     8540       then do:
     8541         apply "entry":u to self .
     8542       end.
     8543       run gbl/getcurdt.p
     8544         (output v-curr-sv-date
     8545         ) .
     8546       assign
     8547         self :screen-value = string(v-curr-sv-date) .
     8548       .
     8549     end.
     8550     return no-apply.
     8551   end.
     8552   on ctrl-b of t-doc.ship-date in frame d-in-doc
     8553   do:
     8554     if (can-query (self, "sensitive")
     8555        and
     8556        self :sensitive = true
     8557        )
     8558     or (can-query (self, "read-only")
     8559        and
     8560        self :read-only = false
     8561        )
     8562     then do:
     8563       if self :handle <> focus :handle
     8564       then do:
     8565         apply "entry":u to self .
     8566       end.
     8567       define variable v-curr-sv-date as date no-undo .
     8568       define variable v-new-sv-date  as date no-undo .
     8569       assign
     8570         v-curr-sv-date = date(self :screen-value) no-error
     8571       .
     8572       if v-curr-sv-date = ?
     8573       then do:
     8574         run gbl/getcurdt.p
     8575           (output v-curr-sv-date
     8576           ) .
     8577       end.
     8578       if v-curr-sv-date <> ?
     8579       then do:
     8580         assign
     8581           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     8582         .
     8583         assign
     8584           self :screen-value = string(v-new-sv-date) .
     8585         .
     8586       end.
     8587     end.
     8588     return no-apply .
     8589   end.
