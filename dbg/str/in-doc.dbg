    16483       DISPLAY t-doc.cli-code t-doc.cli-type t-doc.exch-code t-doc.exch-date
    16484             t-doc.discnt-pc t-doc.cst-code t-doc.exch-rate t-doc.exch-scale
    16485             t-doc.tot-cli t-doc.base-rate t-doc.base-scale t-doc.out-code
    16486             t-doc.pay-code t-doc.wrkr t-doc.ord-num t-doc.agnt t-doc.boss
    16487             t-doc.doc-date t-doc.fact-date t-doc.shift-date t-doc.shift-name
    16488             t-doc.shift-num t-doc.SLT-type t-doc.VAT-type t-doc.tot-transp
    16489             t-doc.tot-other t-doc.ship-num t-doc.ship-date t-doc.tot-calc
    16490             t-doc.road-tax t-doc.tot-sale t-doc.tot-fact t-doc.VAT-rubl
