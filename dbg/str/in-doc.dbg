     4322   procedure lineattr-write-add-line-cli :
     4323   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
     4324   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
     4325   define input  parameter p-cli-type      as character no-undo .
     4326   define input  parameter p-cli-code      as integer   no-undo .
     4327   define input  parameter p-contract-code as integer   no-undo .
     4328   define input  parameter p-host-code     as integer   no-undo .
     4329   define input  parameter p-exch-code     as integer   no-undo .
     4330   define input  parameter p-exch-rate     as decimal   no-undo .
     4331   define input  parameter p-exch-scale    as integer   no-undo .
     4332   define input  parameter p-sum-cli       as decimal   no-undo .
     4333   define input  parameter p-sum-vat       as decimal   no-undo .
     4334   define buffer buf_doc-line-attr for ub.doc-line-attr .
     4335     do
     4336     on error undo, return error return-value
     4337     :
     4338       find first buf_doc-line-attr exclusive-lock
     4339         where buf_doc-line-attr.doc-code  = p-doc-code
     4340           and buf_doc-line-attr.gds-code  = p-gds-code
     4341           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
     4342                                             chr(4) + p-cli-type +
     4343                                             chr(4) + string(p-cli-code) +
     4344                                             chr(4) + string(p-contract-code) +
     4345                                             chr(4) + string(p-host-code)
     4346         no-error .
     4347       if not available buf_doc-line-attr then do:
     4348         create buf_doc-line-attr .
     4349         assign
     4350           buf_doc-line-attr.doc-code  = p-doc-code
     4351           buf_doc-line-attr.gds-code  = p-gds-code
     4352           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
     4353                                         chr(4) + p-cli-type +
     4354                                         chr(4) + string(p-cli-code) +
     4355                                         chr(4) + string(p-contract-code) +
     4356                                         chr(4) + string(p-host-code)
     4357         .
     4358       end.
     4359       assign
     4360         buf_doc-line-attr.attr-value =
     4361         string(p-exch-code)  + chr(4) +
     4362         string(p-exch-rate)  + chr(4) +
     4363         string(p-exch-scale) + chr(4) +
     4364         string(p-sum-cli)    + chr(4) +
     4365         string(p-sum-vat)
     4366         .
     4367     end.
     4368   end procedure.
     4369   procedure lineattr-value-add-line-cli :
     4370   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
     4371   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
     4372   define input   parameter p-cli-type      as character no-undo .
     4373   define input   parameter p-cli-code      as integer   no-undo .
     4374   define input   parameter p-contract-code as integer   no-undo .
     4375   define input   parameter p-host-code     as integer   no-undo .
     4376   define output  parameter p-exch-code     as integer   no-undo .
     4377   define output  parameter p-exch-rate     as decimal   no-undo .
     4378   define output  parameter p-exch-scale    as integer   no-undo .
     4379   define output  parameter p-sum-cli       as decimal   no-undo .
     4380   define output  parameter p-sum-vat       as decimal   no-undo .
     4381   define buffer buf_doc-line-attr for ub.doc-line-attr .
     4382     do
     4383     on error undo, return error return-value
     4384     :
     4385       find first buf_doc-line-attr exclusive-lock
     4386         where buf_doc-line-attr.doc-code  = p-doc-code
     4387           and buf_doc-line-attr.gds-code  = p-gds-code
     4388           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
     4389                                             chr(4) + p-cli-type +
     4390                                             chr(4) + string(p-cli-code) +
     4391                                             chr(4) + string(p-contract-code) +
     4392                                             chr(4) + string(p-host-code)
     4393         no-error .
     4394       if available buf_doc-line-attr then do:
     4395        assign
     4396           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
     4397           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
     4398           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
     4399           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
     4400           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
     4401          .
     4402        end.
     4403     end.
     4404   end procedure.
     4405   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
     4406     define variable v-code as character no-undo .
