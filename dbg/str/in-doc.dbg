     7290   DEFINE QUERY br-dtl FOR
     7291         ub.doc-line,
     7292         ub.goods,
     7293         ub.gds-prt,
     7294         ub.gds-obj SCROLLING.
     7295   DEFINE BROWSE br-dtl
     7296     QUERY br-dtl DISPLAY
     7297         get-mark  (BUFFER  ub.doc-line)                    column-label '*'  format "x(1)":U
     7298         ub.doc-line.line-num                    column-label 'П/П'  format ">>>>9":U
     7299         ub.doc-line.prt-OK                    column-label 'Ш'  format "+/-":U
     7300         ub.doc-line.artic                    column-label 'Артикул'
     7301         ub.goods.gds-name                    column-label 'Название'  format "x(150)"
     7302         ub.doc-line.cli-qnty                    column-label 'По ТТН'
     7303         ub.doc-line.unit-cli                    column-label 'Изм'  format "x(3)":U
     7304         ub.doc-line.price-cli                    column-label 'Цена пост.'
     7305         ( ub.doc-line.cli-qnty *  ub.doc-line.price-cli)                    column-label 'Сумма пост.'  format ">>,>>>,>>>,>>>,>>9.99":U
     7306         ub.doc-line.doc-qnty                   column-label 'По док-ту' format ">,>>>,>>>,>>>,>>9.999":U
     7307         ub.doc-line.fact-qnty                   column-label 'Факт' format ">,>>>,>>>,>>>,>>9.999":U
     7308         ub.goods.unit-base                   column-label 'Изм.' format "x(3)":U
     7309         (if varr-b = 'rubl':u then  ub.doc-line.price-rubl else  ub.doc-line.price-base)                   column-label 'Цена учет(прод.)'
     7310         ub.gds-obj.price-sale                   column-label 'Цена продажи'
     7311         (if varr-b = 'rubl':u then ((ub.gds-obj.price-sale -  ub.doc-line.price-rubl) /  ub.doc-line.price-rubl * 100) else ((ub.gds-obj.price-sale -  ub.doc-line.price-base) /  ub.doc-line.price-base * 100))                   column-label '%' format "->>>,>>9.<<":U
     7312         get-name (BUFFER  ub.doc-line, buffer ub.goods, buffer ub.gds-prt)                   column-label 'Шкала' format "x(10)":U
     7313         ub.doc-line.VAT-pc                   column-label 'НДС' format ">9.9%":U
     7314         get-vat-sum( buffer ub.doc-line ) @ vat-sum         column-label 'Сумма НДС' format ">>,>>>,>>>,>>>,>>9.99"
     7315         ub.goods.engl-name                   column-label 'Название англ.'
     7316         ub.doc-line.num-place                   column-label 'Кол-во мест'
     7317         ub.doc-line.wt-brutto                   column-label 'Вес брутто'
     7318         ub.doc-line.fact-qnty * ub.goods.cst-base-rate                   column-label 'Кол в там. ед.'
     7319         last-price (buffer  ub.doc-line)                   column-label 'Прих. цена' format ">,>>>,>>>,>>>,>>9.999":U
     7320         deviation-price (buffer  ub.doc-line)                   column-label '% откл прих. цены'
     7321         get-kg-fact-qnty(  buffer  ub.doc-line ) @ d-kg-fact-qnty  column-label 'Факт, кг' format ">>>,>>>,>>9.999":U
     7322         get-kg-sale-base(  buffer  ub.doc-line ) @ d-kg-price-base column-label 'Цена за кг (вал.)' format "->>,>>>,>>>,>>9.999":U
     7323         get-kg-sale-rubl(  buffer  ub.doc-line ) @ d-kg-price-rubl column-label 'Цена за кг (руб.)' format "->,>>>,>>>,>>>,>>9.999":U
     7324         get-kg-after-qnty( buffer  ub.doc-line ) @ d-kg-after-qnty column-label 'Итого, кг' format "->,>>>,>>>,>>>,>>9.999":U
     7325         get-add-gtd( buffer ub.doc-line ) @ d-gtd-add       column-label 'Доп. к ГТД' format "x(15)"
     7326         lineattr-get-reason( buffer ub.doc-line ) @ d-reason        column-label 'Причина отклонения по РТ' format "x(25)"
     7327         get-vsdsts( buffer ub.doc-line ) @ ch-vsd          column-label 'ВСД' format "x(3)"
