    11529       find t-doc no-lock where recid( t-doc ) = pardoc-rec no-error.
    11530       if available t-doc then do:
    11531         if t-doc.internal = ? then do:
    11532           message "Документ был заведен неверно и удаляется!!!" view-as alert-box.
    11533           find t-doc exclusive-lock where recid( t-doc ) = pardoc-rec.
    11534           delete t-doc.
    11535           return.
    11536         end.
    11537         if parext-doc-mode <> "":U then do:
