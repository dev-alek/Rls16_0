      134   define new global shared variable g#libbcrcn as handle no-undo .
      135   procedure plgdsfnd :
      136     define input  parameter p-chk-and-chs    as logical               no-undo .
      137     define input  parameter p-obj-type       like ub.gds-obj.obj-type no-undo .
      138     define input  parameter p-obj-code       like ub.gds-obj.obj-code no-undo .
      139     define input  parameter p-gds-code       like ub.goods.gds-code   no-undo .
      140     define output parameter p-reserv-pl-code as   logical             no-undo .
      141     define output parameter p-pl-code        like ub.pl-gds.pl-code   no-undo .
      142     define buffer buf_goods         for ub.goods .
      143     define buffer buf_pl-gds        for ub.pl-gds .
      144     define buffer buf_second_pl-gds for ub.pl-gds .
      145     find first buf_goods no-lock where
      146                buf_goods.gds-code = p-gds-code no-error .
      147     if not available buf_goods
      148     then do:
      149       return error "Не найден товар. Первичный бар-код " + string( p-gds-code ) .
      150     end.
      151   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      152   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
      153     (input  p-obj-type
      154     ,input  p-obj-code
      155     ,input  buf_goods.artic
      156     ,input  buf_goods.prod-type
      157     ,input  buf_goods.prod-code
      158     ,input  'place-rsrv=request'
      159     ,output p-reserv-pl-code
      160     ) no-error .
      161     if error-status :error
      162     then do:
      163       return error substitute("Ошибка при запросе атрибута place-rsrv товара на объекте  &1 &2 " , error-status :get-message(1) , return-value  )  .
      164     end.
      165     if p-reserv-pl-code = no
      166     then do:
      167       return .
      168     end.
      169     if p-chk-and-chs <> yes
      170     then do:
      171       return .
      172     end.
      173     find first buf_pl-gds no-lock where
      174                buf_pl-gds.obj-type = p-obj-type and
      175                buf_pl-gds.obj-code = p-obj-code and
      176                buf_pl-gds.gds-code = p-gds-code no-error .
      177     if not available buf_pl-gds
      178     then do:
      179       return error "К товару не привязано ни одного места хранения" .
      180     end.
      181     find first buf_second_pl-gds no-lock where
      182                buf_second_pl-gds.obj-type  = p-obj-type          and
      183                buf_second_pl-gds.obj-code  = p-obj-code          and
      184                buf_second_pl-gds.gds-code  = p-gds-code          and
      185                recid( buf_second_pl-gds ) <> recid( buf_pl-gds ) no-error .
      186     if not available buf_second_pl-gds
      187     then do:
      188       assign
      189         p-pl-code = buf_pl-gds.pl-code
      190       .
      191     end.
      192     else do:
      193       if not valid-handle( parparentproc )
      194       then do:
      195         return error "Не выбрано место хранения " + chr(10) .
      196       end.
      197       run str/plgdssel.p
      198         (
      199            input parparentproc
      200         ,  input p-obj-type
      201         ,  input p-obj-code
      202         ,  input p-gds-code
      203         , output p-pl-code
      204         ) no-error .
      205       if error-status :error
      206       then do:
      207         return error substitute( 'Ошибка при вызове программы &1&2&3&2&4&2'
      208                                , 'plgdssel.p':U
      209                                , chr(10)
      210                                , error-status :get-message( 1 )
      211                                , return-value
      212                                ) .
      213       end.
      214       if p-pl-code = ? or
      215          p-pl-code = 0
      216       then do:
      217         return error "Не выбрано место хранения " + chr(10) .
      218       end.
      219     end.
      220   end procedure.
