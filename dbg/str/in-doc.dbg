    13061         end.
    13062         for each buf_temp-diasize-handle
    13063         on error undo move_block, retry move_block
    13064         :
    13065           assign
    13066             v-object-handle = buf_temp-diasize-handle.handle-value
    13067           .
    13068           if v-object-handle <> v-diasize-resize-button
    13069           then do:
    13070             assign
    13071               v-object-handle :col = v-object-handle :col + p-change-value
    13072               no-error .
    13073             if error-status :error
    13074             or error-status :get-message(1) <> ""
    13075             then do:
    13076               undo move_block, retry move_block .
    13077             end.
    13078           end.
    13079         end.
    13080       end.
    13081       else do:
    13082         for each buf_temp-diasize-handle
    13083         on error undo move_block, retry move_block
    13084         :
    13085           assign
    13086             v-object-handle = buf_temp-diasize-handle.handle-value
    13087           .
    13088           if v-object-handle <> v-diasize-resize-button
    13089           then do:
    13090             assign
    13091               v-object-handle :col = v-object-handle :col + p-change-value
    13092               no-error .
    13093             if error-status :error
    13094             or error-status :get-message(1) <> ""
    13095             then do:
    13096               undo move_block, retry move_block .
    13097             end.
    13098           end.
    13099         end.
    13100         for each buf_temp-browse-handle
    13101           where buf_temp-browse-handle.browse-type = 'width':u
    13102         on error undo move_block, retry move_block
    13103         :
    13104           assign
    13105             buf_temp-browse-handle.browse-handle :width
    13106               = buf_temp-browse-handle.browse-handle :width + p-change-value
    13107             no-error .
    13108           if error-status :error
    13109           or error-status :get-message(1) <> ""
    13110           then do:
    13111             undo move_block, retry move_block .
    13112           end.
    13113         end.
    13114         assign
    13115           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
    13116           no-error .
    13117         if error-status :error
    13118         or error-status :get-message(1) <> ""
    13119         then do:
    13120           undo move_block, retry move_block.
    13121         end.
    13122         assign
    13123           frame d-in-doc :width = frame d-in-doc :width + p-change-value
    13124         no-error .
    13125         if error-status :error
    13126         or error-status :get-message(1) <> ""
    13127         then do:
    13128           undo move_block, retry move_block.
    13129         end.
    13130         if frame d-in-doc :scrollable = true
    13131         then do:
    13132           assign
    13133             frame d-in-doc :virtual-width = frame d-in-doc :virtual-width + p-change-value
    13134           no-error .
    13135           if error-status :error
    13136           or error-status :get-message(1) <> ""
    13137           then do:
    13138             undo move_block, retry move_block.
    13139           end.
    13140         end.
    13141       end.
    13142       if p-move-resize
    13143       then do:
    13144         run diasize_position-resize-button in this-procedure .
    13145       end.
    13146       if v-diasize-wndstore = true
    13147       then do:
    13148         if connected("ub") = true
    13149         then do:
    13150           define variable v-cntxt-db-num        as integer   no-undo .
    13151           define variable v-cntxt-userid        as character no-undo .
    13152           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
    13153                                             , OUTPUT v-cntxt-userid
    13154                                             ) .
    13155           run gbl/wndsizew.p
    13156             (input  v-cntxt-db-num
    13157             ,input  v-cntxt-userid
    13158             ,input  v-diasize-proc-name
    13159             ,input  'width':u
    13160             ,input  string(frame d-in-doc :width - v-diasize-orig-frame-width)
    13161             ) .
    13162         end.
    13163       end.
    13164     end.
    13165     assign
    13166       v-diasize-change-size = false
    13167     .
    13168   end procedure.
    13169   procedure diasize_set-width :
    13170     define input  parameter p-new-width  as decimal   no-undo .
    13171     define input  parameter p-move-resize as logical   no-undo .
    13172     do
    13173     on error undo, return error return-value
    13174     :
    13175       run diasize_change-width in this-procedure
    13176         (input  (p-new-width - frame d-in-doc :width)
    13177         ,input  p-move-resize
    13178         ) .
    13179     end.
    13180   end procedure.
    13181   procedure diasize_position-resize-button :
    13182     do with frame d-in-doc
    13183     :
    13184       hide v-diasize-resize-button .
    13185       assign
    13186         v-diasize-resize-button :row = frame d-in-doc :height - v-diasize-resize-button :height
    13187                     - 1
    13188                     - (frame d-in-doc :border-bottom-pixels / session :pixels-per-row)
    13189         v-diasize-resize-button :col = frame d-in-doc :width - v-diasize-resize-button :width
    13190                     - 1
    13191                     - (frame d-in-doc :border-right-pixels / session :pixels-per-column)
    13192       .
    13193       view v-diasize-resize-button .
    13194     end.
    13195   end procedure.
    13196   on alt-right anywhere
    13197   do:
    13198     run diasize_change-width in this-procedure
    13199       (input 1
    13200       ,input true
    13201       ) .
    13202     return no-apply .
    13203   end.
    13204   on alt-left anywhere
    13205   do:
    13206     run diasize_change-width in this-procedure
    13207       (input -1
    13208       ,input true
    13209       ) .
    13210     return no-apply .
    13211   end.
    13212   on alt-down anywhere
    13213   do:
    13214     run diasize_change-height in this-procedure
    13215       (input 1
    13216       ,input true
    13217       ) .
    13218     return no-apply .
    13219   end.
    13220   on alt-up anywhere
    13221   do:
    13222     run diasize_change-height in this-procedure
    13223       (input -1
    13224       ,input true
    13225       ) .
    13226     return no-apply .
    13227   end.
    13228   on alt-enter of frame d-in-doc
    13229   do:
    13230     run diasize_maximize in this-procedure
    13231       (input  ?
    13232       ).
    13233     return no-apply .
    13234   end.
    13235   procedure diasize_end-move :
    13236     do
    13237     on error undo, return error return-value
    13238     :
    13239       define variable v-row-delta as decimal   no-undo .
    13240       define variable v-col-delta as decimal   no-undo .
    13241       define variable v-new-row as decimal   no-undo .
    13242       define variable v-new-col as decimal   no-undo .
    13243       assign
    13244         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
    13245         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
    13246       .
    13247       assign
    13248         v-row-delta = v-new-row - frame d-in-doc :height
    13249         v-col-delta = v-new-col - frame d-in-doc :width
    13250       .
    13251       run diasize_change-height in this-procedure
    13252         (input v-row-delta
    13253         ,input true
    13254         ) .
    13255       run diasize_change-width in this-procedure
    13256         (input v-col-delta
    13257         ,input true
    13258         ) .
    13259     end.
    13260   end procedure.
    13261   procedure diasize_maximize :
    13262     define input  parameter p-action as logical   no-undo .
    13263     do
    13264     on error undo, return error return-value
    13265     :
    13266       if p-action = ?
    13267       then do:
    13268         if v-diasize-need-maximize = true
    13269         then do:
    13270           assign
    13271             p-action = true
    13272           .
    13273         end.
    13274         else do:
    13275           assign
    13276             p-action = false
    13277           .
    13278         end.
    13279       end.
    13280       if p-action = true
    13281       then do:
    13282         run diasize_change-height in this-procedure
    13283           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
    13284               - frame d-in-doc :height-chars
    13285           ,input true
    13286           ) .
    13287         run diasize_change-width in this-procedure
    13288           (input session :width-chars
    13289               - frame d-in-doc :width-chars
    13290           ,input true
    13291           ) .
    13292         assign
    13293           v-diasize-need-maximize = false
    13294         .
    13295       end.
    13296       else do:
    13297         run diasize_change-width in this-procedure
    13298           (input v-diasize-orig-frame-width
    13299               - frame d-in-doc :width-chars
    13300           ,input true
    13301           ) .
    13302         run diasize_change-height in this-procedure
    13303           (input v-diasize-orig-frame-height
    13304               - frame d-in-doc :height-chars
    13305           ,input true
    13306           ) .
    13307         assign
    13308           v-diasize-need-maximize = true
    13309         .
    13310       end.
    13311     end.
    13312   end procedure.
    13313   procedure diasize_restore-orig-size :
    13314     do
    13315     on error undo, return error return-value
    13316     :
    13317       assign
    13318         v-diasize-current-frame-width  = frame d-in-doc :width
    13319         v-diasize-current-frame-height = frame d-in-doc :height
    13320       .
    13321       run diasize_set-height in this-procedure
    13322         (input  v-diasize-orig-frame-height
    13323         ,input  true
    13324         ) .
    13325       run diasize_set-width in this-procedure
    13326         (input  v-diasize-orig-frame-width
    13327         ,input  true
    13328         ) .
    13329     end.
    13330   end procedure.
    13331   procedure diasize_restore-current-size :
    13332     do
    13333     on error undo, return error return-value
    13334     :
    13335       run diasize_set-height in this-procedure
    13336         (input  v-diasize-current-frame-height
    13337         ,input  true
    13338         ) .
    13339       run diasize_set-width in this-procedure
    13340         (input  v-diasize-current-frame-width
    13341         ,input  true
    13342         ) .
    13343     end.
    13344   end procedure.
    13345   procedure diasize_set-browse-handle :
    13346     define input  parameter p-browse-handle as handle   no-undo .
    13347     define buffer buf_temp-browse-handle for temp-browse-handle .
    13348     do
    13349     on error undo, return error return-value
    13350     :
    13351       assign
    13352         v-diasize-browse-handle = p-browse-handle
    13353       .
    13354       for each buf_temp-browse-handle
    13355       on error undo, return error return-value
    13356       :
    13357         delete buf_temp-browse-handle .
    13358       end.
    13359     end.
    13360   end procedure.
    13361   procedure diasize_add_browse :
    13362     define input  parameter p-browse-type   as character no-undo .
    13363     define input  parameter p-browse-handle as handle    no-undo .
    13364     define buffer buf_temp-browse-handle for temp-browse-handle .
    13365     do
    13366     on error undo, return error return-value
    13367     :
    13368       assign
    13369         v-diasize-browse-number = v-diasize-browse-number + 1
    13370       .
    13371       create buf_temp-browse-handle .
    13372       assign
    13373         buf_temp-browse-handle.browse-type   = p-browse-type
    13374         buf_temp-browse-handle.browse-number = v-diasize-browse-number
    13375         buf_temp-browse-handle.browse-handle = p-browse-handle
    13376       .
    13377     end.
    13378   end procedure.
    13379   procedure diasize_init :
    13380     define variable v-default-value    as logical   no-undo .
    13381     define variable v-restore-saved    as logical   no-undo .
    13382     define variable v-resize-value-str as character no-undo .
    13383     do
    13384     on error undo, return error return-value
    13385     :
    13386       do with frame d-in-doc
    13387       :
    13388         assign
    13389           v-diasize-orig-frame-height = frame d-in-doc :height
    13390           v-diasize-orig-frame-width  = frame d-in-doc :width
    13391           v-diasize-browse-handle     = browse br-dtl :handle
    13392         .
    13393         create button v-diasize-resize-button
    13394         assign
    13395           parent        = frame d-in-doc :first-child
    13396           label         = "s"
    13397           height-pixels = 16
    13398           width-pixels  = 16
    13399           visible       = true
    13400           sensitive     = true
    13401           movable       = true
    13402           triggers:
    13403             on end-move persistent run diasize_end-move in this-procedure .
    13404           end triggers.
    13405         v-diasize-resize-button :load-mouse-pointer("SIZE") .
    13406         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
    13407         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
    13408         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
    13409         assign
    13410           v-diasize-wndmax = false
    13411         .
    13412         if connected("ub") = true
    13413         then do:
    13414           define variable v-cntxt-db-num        as integer   no-undo .
    13415           define variable v-cntxt-userid        as character no-undo .
    13416           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
    13417                                             , OUTPUT v-cntxt-userid
    13418                                             ) .
    13419           run gbl/wndpar_r.p
    13420             (input  v-cntxt-db-num
    13421             ,input  v-cntxt-userid
    13422             ,input  'wndmax':U
    13423             ,output v-diasize-wndmax
    13424             ,output v-default-value
    13425             ) .
    13426         end.
    13427         assign
    13428           v-diasize-wndstore = false
    13429         .
    13430         if connected("ub") = true
    13431         then do:
    13432           run gbl/wndpar_r.p
    13433             (input  v-cntxt-db-num
    13434             ,input  v-cntxt-userid
    13435             ,input  'wndstore':U
    13436             ,output v-diasize-wndstore
    13437             ,output v-default-value
    13438             ) .
    13439         end.
    13440         assign
    13441           v-diasize-proc-name = entry(1, program-name(2), '.')
    13442         .
    13443         if v-diasize-wndstore = true
    13444         then do:
    13445           assign
    13446             v-restore-saved = false
    13447           .
    13448           if connected("ub") = true
    13449           then do:
    13450             run gbl/wndsizer.p
    13451               (input  v-cntxt-db-num
    13452               ,input  v-cntxt-userid
    13453               ,input  v-diasize-proc-name
    13454               ,input  'height':u
    13455               ,output v-resize-value-str
    13456               ) .
    13457             if v-resize-value-str <> '':U
    13458             then do:
    13459               run diasize_change-height in this-procedure
    13460                 (input  integer(v-resize-value-str)
    13461                 ,input  true
    13462                 ) .
    13463               assign
    13464                 v-restore-saved = true
    13465               .
    13466             end.
    13467           end.
    13468           if connected("ub") = true
    13469           then do:
    13470             run gbl/wndsizer.p
    13471               (input  v-cntxt-db-num
    13472               ,input  v-cntxt-userid
    13473               ,input  v-diasize-proc-name
    13474               ,input  'width':u
    13475               ,output v-resize-value-str
    13476               ) .
    13477             if v-resize-value-str <> '':U
    13478             then do:
    13479               run diasize_change-width in this-procedure
    13480                 (input  integer(v-resize-value-str)
    13481                 ,input  true
    13482                 ) .
    13483               assign
    13484                 v-restore-saved = true
    13485               .
    13486             end.
    13487           end.
    13488           if v-restore-saved <> true
    13489           then do:
    13490             if v-diasize-wndmax = true
    13491             then do:
    13492               run diasize_maximize in this-procedure
    13493                 (input  true
    13494                 ) .
    13495             end.
    13496           end.
    13497         end.
    13498         else do:
    13499           if v-diasize-wndmax = true
    13500           then do:
    13501             run diasize_maximize in this-procedure
    13502               (input  true
    13503               ) .
    13504           end.
    13505         end.
    13506       end.
    13507     end.
    13508   end procedure.
    13509   procedure diasize_need-full-display :
    13510     define output parameter p-need-full-display as logical   no-undo .
    13511     do
    13512     on error undo, return error return-value
    13513     :
    13514       assign
    13515         p-need-full-display = v-diasize-need-full-display
    13516       .
    13517       assign
    13518         v-diasize-need-full-display = false
    13519       .
    13520     end.
    13521   end procedure.
    13522   procedure get-context :
    13523      define output parameter p-db-num as integer          no-undo.
    13524      define output parameter p-user-id as character        no-undo.
    13525      define variable v-login               as character    no-undo.
    13526      define buffer buf_sys-ctrl    for ub.sys-ctrl .
    13527      define buffer buf_user-login  for ub.user-login .
    13528      do
    13529      on error undo, return error
    13530      :
    13531            FIND FIRST buf_sys-ctrl no-lock.
    13532            ASSIGN
    13533               v-login = USERID("ub")
    13534               p-db-num = buf_sys-ctrl.db-num
    13535            .
    13536            FIND FIRST buf_user-login
    13537                 WHERE buf_user-login.db-num = p-db-num
    13538                   AND buf_user-login.user-login = v-login
    13539                 no-lock
    13540                 no-error
    13541                 .
    13542            IF AVAILABLE buf_user-login
    13543            THEN DO:
    13544               assign
    13545                  p-user-id = buf_user-login.user-id
    13546               .
    13547            END.
    13548      end.
    13549   end procedure.
    13550       run diasize_init in this-procedure .
