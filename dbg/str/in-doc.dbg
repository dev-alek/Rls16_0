     3656       END PROCEDURE.
     3657       PROCEDURE del-rvs-doc :
     3658         define input  parameter parparentproc as   handle              no-undo .
     3659         define input  parameter p-doc-code    like ub.trn-doc.doc-code no-undo .
     3660         tr:
     3661         do transaction
     3662         on error   undo tr, return error
     3663         on end-key undo tr, return error
     3664         on stop    undo tr, return error
     3665         :
     3666   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3667     define variable v-cntxt-db-num        as integer   no-undo .
     3668     define variable v-cntxt-userid        as character no-undo .
     3669     define variable v-cntxt-level         as character no-undo .
     3670     define variable v-cntxt-host-code-obj as integer   no-undo .
     3671     define variable v-cntxt-obj-type      as character no-undo .
     3672     define variable v-cntxt-obj-code      as integer   no-undo .
     3673     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3674     define variable v-cntxt-is-admin      as logical   no-undo .
     3675   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3676     run mainmenu_getcntxt in parparentproc
     3677       (output v-cntxt-db-num
     3678       ,output v-cntxt-userid
     3679       ,output v-cntxt-level
     3680       ,output v-cntxt-host-code-obj
     3681       ,output v-cntxt-obj-type
     3682       ,output v-cntxt-obj-code
     3683       ,output v-cntxt-db-num-obj
     3684       ,output v-cntxt-is-admin
     3685       ) .
     3686           define buffer buf_trn-doc for ub.trn-doc .
     3687           define buffer bef-rvs-doc for ub.rvs-doc.
     3688           define buffer aft-rvs-doc for ub.rvs-doc.
     3689           define buffer buf_doc-line-attr for ub.doc-line-attr .
     3690           define variable varlog           as logical   no-undo .
     3691           define variable ii               as integer   no-undo .
     3692           define variable infoSectionsTotal as class ibs.th.str.InfoSectionsTotal no-undo .
     3693           define variable infoSectionObj as class ibs.th.str.InfoSection no-undo .
     3694           find first buf_trn-doc
     3695             where buf_trn-doc.doc-code = p-doc-code
     3696             .
     3697   define variable vss-include-info34 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3698   do:
     3699     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3700       (input  v-cntxt-db-num
     3701       ,input  v-cntxt-userid
     3702       ,input  0
     3703       ,input  'actn_rvs-on-doc_deletion':U
     3704       ,input  'object':U
     3705       ,input  buf_trn-doc.host-code
     3706       ,input  buf_trn-doc.obj-type
     3707       ,input  buf_trn-doc.obj-code
     3708       ,input  0
     3709       ,input  0
     3710       ,input  0
     3711       ,input  true
     3712       ,output varlog
     3713       ) no-error .
     3714   end.
     3715           if varlog <> yes then do:
     3716             return error return-value .
     3717           end.
     3718           assign
     3719             varlog = no
     3720             .
     3721           message
     3722             "Вы хотите удалить документы сверки по приходу?"
     3723             view-as alert-box question buttons yes-no update varlog.
     3724           if varlog <> yes then do:
     3725             return .
     3726           end.
     3727           run waitfram-show in this-procedure (input "Удаляем документы сверки по приходной накладной").
     3728           for each buf_doc-line-attr no-lock where buf_doc-line-attr.doc-code = buf_trn-doc.doc-code
     3729                                                and buf_doc-line-attr.attr-code = "n"
     3730           :
     3731             infoSectionsTotal = new ibs.th.str.InfoSectionsTotal().
     3732             infoSectionsTotal:Initialization(buf_trn-doc.doc-code, buf_doc-line-attr.gds-code).
     3733             infoSectionsTotal:GetDBAllAttr().
     3734             do ii = 1 to infoSectionsTotal:SectionNum :
     3735               infoSectionObj = infoSectionsTotal:GetInfoSectionProp(ii) .
     3736               if infoSectionObj:AccMeth = 0
     3737               then do :
     3738                 infoSectionObj:TankDensityPomi = ? .
     3739                 infoSectionObj:TankVolPomi = ? .
     3740                 infoSectionObj:TankWeight = ? .
     3741                 infoSectionObj:AccPomi = ? .
     3742               end .
     3743               if infoSectionObj:AccMeth = 1
     3744               then do :
     3745                 infoSectionObj:TankVolPomiRvs = ? .
     3746                 infoSectionObj:TankWeightRvs = ? .
     3747               end .
     3748               infoSectionObj:AccMeth = ? .
     3749               infoSectionObj:DateStart = ? .
     3750               infoSectionObj:TimeStart = ? .
     3751               infoSectionObj:DateEnd = ? .
     3752               infoSectionObj:TimeEnd = ? .
     3753               if not (infoSectionObj:KPnoMeas or infoSectionObj:alarm-SGDKK) then infoSectionObj:IsKP = no .
     3754             end .
     3755             infoSectionsTotal:SaveDB().
     3756             delete object infoSectionsTotal.
     3757           end .
     3758           for each bef-rvs-doc
     3759             where bef-rvs-doc.out-code = buf_trn-doc.doc-code
     3760               and bef-rvs-doc.rvs-type = 'перед_док':U
     3761           :
     3762             run str/rvs-stat.p
     3763               ( input parparentproc
     3764               ,input recid(bef-rvs-doc)
     3765               ,input "unfroze":U
     3766               ) no-error.
     3767             if error-status :error then do:
     3768               run waitfram-hide in this-procedure .
     3769               message
     3770                 vss-workfile vss-revision vss-description skip
     3771                 substitute( 'Ошибка при изменении статуса документа сверки "&1" номер &2', 'перед_док':U, bef-rvs-doc.rvs-code ) skip
     3772                 error-status :get-message(1) skip
     3773                 return-value skip
     3774                 view-as alert-box error .
     3775               undo tr, return error.
     3776             end.
     3777             run str/rvs-stat.p
     3778               ( input parparentproc
     3779               ,input recid(bef-rvs-doc)
     3780               ,input "open":U
     3781               ) no-error.
     3782             if error-status :error then do:
     3783               run waitfram-hide in this-procedure .
     3784               message
     3785                 vss-workfile vss-revision vss-description skip
     3786                 substitute( 'Ошибка при открытии документа сверки "&1" номер &2', 'перед_док':U, bef-rvs-doc.rvs-code ) skip
     3787                 error-status :get-message(1) skip
     3788                 return-value skip
     3789                 view-as alert-box error .
     3790               undo tr, return error.
     3791             end.
     3792             release bef-rvs-doc no-error .
     3793             if error-status :error then do:
     3794               run waitfram-hide in this-procedure .
     3795               message
     3796                 vss-workfile vss-revision vss-description skip
     3797                 substitute( 'Ошибка при открытии документа сверки "&1" номер &2', 'перед_док':U, bef-rvs-doc.rvs-code ) skip
     3798                 error-status :get-message(1) skip
     3799                 return-value skip
     3800                 view-as alert-box error .
     3801               undo tr, return error.
     3802             end.
     3803           end.
     3804           for each bef-rvs-doc
     3805               where bef-rvs-doc.out-code = buf_trn-doc.doc-code
     3806                 and bef-rvs-doc.rvs-type = 'перед_док':U
     3807           :
     3808             delete bef-rvs-doc no-error .
     3809             if error-status :error then do:
     3810               message
     3811                 vss-workfile vss-revision vss-description skip
     3812                 substitute( 'Ошибка при удалении документа сверки "&1"', 'перед_док':U ) skip
     3813                 error-status :get-message(1) skip
     3814                 return-value skip
     3815                 view-as alert-box error .
     3816               undo tr, return error.
     3817             end.
     3818           end .
     3819           for each aft-rvs-doc
     3820             where aft-rvs-doc.out-code = buf_trn-doc.doc-code
     3821               and aft-rvs-doc.rvs-type = 'после_док':U
     3822           :
     3823             run str/rvs-stat.p
     3824               ( input parparentproc
     3825               ,input recid(aft-rvs-doc)
     3826               ,input "unfroze":U
     3827               ) no-error.
     3828             if error-status :error then do:
     3829               run waitfram-hide in this-procedure .
     3830               message
     3831                 vss-workfile vss-revision vss-description skip
     3832                 substitute( 'Ошибка при изменении статуса документа сверки "&1" номер &2', 'после_док':U, aft-rvs-doc.rvs-code ) skip
     3833                 error-status :get-message(1) skip
     3834                 return-value skip
     3835                 view-as alert-box error .
     3836               undo tr, return error.
     3837             end.
     3838             run str/rvs-stat.p
     3839               ( input parparentproc
     3840               ,input recid(aft-rvs-doc)
     3841               ,input "open":U
     3842               ) no-error.
     3843             if error-status :error then do:
     3844               run waitfram-hide in this-procedure .
     3845               message
     3846                 vss-workfile vss-revision vss-description skip
     3847                 substitute( 'Ошибка при открытии документа сверки "&1" номер &2', 'после_док':U, aft-rvs-doc.rvs-code ) skip
     3848                 error-status :get-message(1) skip
     3849                 return-value skip
     3850                 view-as alert-box error .
     3851               undo tr, return error.
     3852             end.
     3853             release aft-rvs-doc no-error .
     3854             if error-status :error then do:
     3855               run waitfram-hide in this-procedure .
     3856               message
     3857                 vss-workfile vss-revision vss-description skip
     3858                 substitute( 'Ошибка при открытии документа сверки "&1" номер &2', 'после_док':U, aft-rvs-doc.rvs-code ) skip
     3859                 error-status :get-message(1) skip
     3860                 return-value skip
     3861                 view-as alert-box error .
     3862               undo tr, return error.
     3863             end.
     3864           end.
     3865           for each aft-rvs-doc
     3866               where aft-rvs-doc.out-code = buf_trn-doc.doc-code
     3867                 and aft-rvs-doc.rvs-type = 'после_док':U
     3868           :
     3869             delete aft-rvs-doc no-error .
     3870             if error-status :error then do:
     3871               message
     3872                 vss-workfile vss-revision vss-description skip
     3873                 substitute( 'Ошибка при удалении документа сверки "&1"', 'после_док':U ) skip
     3874                 error-status :get-message(1) skip
     3875                 return-value skip
     3876                 view-as alert-box error .
     3877               undo tr, return error.
     3878             end.
     3879           end .
     3880         end.
     3881         run waitfram-hide in this-procedure .
     3882         return .
     3883       END PROCEDURE.
     3884       PROCEDURE block-nozzle:
     3885         define input parameter parparentproc  as handle    no-undo.
     3886         define input parameter obj-type       as character no-undo.
     3887         define input parameter obj-code       as integer   no-undo.
     3888         define input parameter list-pl        as character no-undo.
     3889         run str/diallog.w ( input parparentproc
     3890            ,input this-procedure
     3891            ,input 'str/get-block-nozzle.p':U
     3892            ,input (obj-type + chr(4) +
     3893            string(obj-code) + chr(4) +
     3894            string(0) + chr(4) +
     3895            string(0) + chr(4) +
     3896            chr(4) +
     3897            chr(4) +
     3898            chr(4) +
     3899            substitute("&1,&2"
     3900            ,"block"
     3901            ,list-pl))
     3902            ,input yes
     3903            ,input ''
     3904            ,input 'Блокировка пистолетов') .
     3905         if not error-status:error then
     3906         do:
     3907            if return-value begins "Для кассы" then
     3908            do:
     3909               message return-value
     3910                  view-as alert-box question buttons yes-no update v-ok as logical  .
     3911               if v-ok then run block-nozzle ( parparentproc, obj-type, obj-code, list-pl ).
     3912               else message "Сообщите в службу поддержки о неуспешной попытке блокировки пистолетов"
     3913                     view-as alert-box.
     3914            end.
     3915            else
     3916            do:
     3917               message "Блокировка пистолетов прошла успешно"
     3918                  view-as alert-box.
     3919            end.
     3920         end.
     3921         else
     3922         do:
     3923            message return-value
     3924               view-as alert-box question buttons yes-no update v-ok .
     3925            if v-ok then run block-nozzle .
     3926            else                   message "Сообщите в службу поддержки о неуспешной попытке разблокировки пистолетов"
     3927                  view-as alert-box.
     3928         end.
     3929       END PROCEDURE .
     3930       PROCEDURE unblock-nozzle:
     3931         define input parameter parparentproc  as handle    no-undo.
     3932         define input parameter obj-type       as character no-undo.
     3933         define input parameter obj-code       as integer   no-undo.
     3934         define input parameter list-pl        as character no-undo.
     3935         run str/diallog.w ( input parparentproc
     3936           ,input this-procedure
     3937           ,input 'str/get-block-nozzle.p':U
     3938           ,input (obj-type + chr(4) +
     3939           string(obj-code) + chr(4) +
     3940           string(0) + chr(4) +
     3941           string(0) + chr(4) +
     3942           chr(4) +
     3943           chr(4) +
     3944           chr(4) +
     3945           substitute("&1,&2"
     3946           ,"unblock"
     3947           ,list-pl))
     3948           ,input yes
     3949           ,input ''
     3950           ,input 'Разблокировка пистолетов') .
     3951         if not error-status:error then
     3952         do:
     3953            if return-value begins "Для кассы" then
     3954            do:
     3955               message return-value
     3956                  view-as alert-box question buttons yes-no update v-ok as logical  .
     3957               if v-ok then run unblock-nozzle( parparentproc, obj-type, obj-code, list-pl ).
     3958               else message "Сообщите в службу поддержки о неуспешной попытке разблокировки пистолетов"
     3959                     view-as alert-box.
     3960            end.
     3961            else
     3962            do:
     3963               message "Разблокировка пистолетов прошла успешно"
     3964                  view-as alert-box.
     3965            end.
     3966         end.
     3967         else
     3968         do:
     3969           message return-value
     3970              view-as alert-box question buttons yes-no update v-ok .
     3971           if v-ok then run unblock-nozzle .
     3972           else                   message "Сообщите в службу поддержки о неуспешной попытке разблокировки пистолетов"
     3973                 view-as alert-box.
     3974            end.
     3975       END PROCEDURE.
     3976   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3977   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3978   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     3979   define variable par-type          as character no-undo.
     3980   define variable v-value-character as character no-undo .
     3981   define variable v-value-date      as date      no-undo .
     3982   define variable v-value-decimal   as decimal   no-undo .
     3983   define variable v-value-integer   as integer   no-undo .
     3984   define variable v-value-logical   as logical   no-undo .
     3985   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3986   procedure lineattr-value :
     3987     do
     3988     on error undo, return error return-value
     3989     :
     3990       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     3991       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     3992       define input  parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     3993       define output parameter p-value    like ub.doc-line-attr.attr-value no-undo .
     3994       define output parameter p-type     as character no-undo .
     3995       define buffer buf_doc-line-attr for ub.doc-line-attr .
     3996       def var v-format         as character no-undo .
     3997       def var v-fillin_width   as integer   no-undo .
     3998       def var v-fillin_height  as integer   no-undo .
     3999       def var v-label          as character no-undo .
     4000       def var v-user-can-edit  as logical   no-undo .
     4001       def var v-output-display as logical   no-undo .
     4002       def var v-other          as character no-undo .
     4003       run lineattr-code in this-procedure
     4004         (input  p-code
     4005         ,output p-type
     4006         ,output v-format
     4007         ,output v-fillin_width
     4008         ,output v-fillin_height
     4009         ,output v-label
     4010         ,output v-user-can-edit
     4011         ,output v-output-display
     4012         ,output v-other
     4013         ) no-error .
     4014       if error-status :error then do:
     4015         undo, return error return-value .
     4016       end.
     4017       find first buf_doc-line-attr no-lock
     4018         where buf_doc-line-attr.doc-code  = p-doc-code
     4019           and buf_doc-line-attr.gds-code  = p-gds-code
     4020           and buf_doc-line-attr.attr-code = p-code
     4021         no-error .
     4022       if avail buf_doc-line-attr then do:
     4023         assign
     4024           p-value =  buf_doc-line-attr.attr-value
     4025         .
     4026       end.
     4027       else do:
     4028         assign
     4029           p-value = if p-type = 'L':U then "no":U else ""
     4030         .
     4031       end.
     4032     end.
     4033   end procedure.
     4034   procedure lineattr-write :
     4035     do
     4036     on error undo, return error return-value
     4037     :
     4038       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     4039       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     4040       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     4041       define input parameter p-value    like ub.doc-line-attr.attr-value no-undo .
     4042       define buffer buf_doc-line-attr for ub.doc-line-attr .
     4043       def var v-type           as character no-undo .
     4044       def var v-format         as character no-undo .
     4045       def var v-fillin_width   as integer   no-undo .
     4046       def var v-fillin_height  as integer   no-undo .
     4047       def var v-label          as character no-undo .
     4048       def var v-user-can-edit  as logical   no-undo .
     4049       def var v-output-display as logical   no-undo .
     4050       def var v-other          as character no-undo .
     4051       run lineattr-code in this-procedure
     4052         (input  p-code
     4053         ,output v-type
     4054         ,output v-format
     4055         ,output v-fillin_width
     4056         ,output v-fillin_height
     4057         ,output v-label
     4058         ,output v-user-can-edit
     4059         ,output v-output-display
     4060         ,output v-other
     4061         ) no-error .
     4062       if error-status :error then do:
     4063         undo, return error return-value .
     4064       end.
     4065       find first buf_doc-line-attr exclusive-lock
     4066         where buf_doc-line-attr.doc-code  = p-doc-code
     4067           and buf_doc-line-attr.gds-code  = p-gds-code
     4068           and buf_doc-line-attr.attr-code = p-code
     4069         no-error .
     4070       if not available buf_doc-line-attr then do:
     4071         create buf_doc-line-attr .
     4072         assign
     4073           buf_doc-line-attr.doc-code  = p-doc-code
     4074           buf_doc-line-attr.gds-code = p-gds-code
     4075           buf_doc-line-attr.attr-code = p-code
     4076         .
     4077       end.
     4078       assign
     4079         buf_doc-line-attr.attr-value = p-value
     4080       .
     4081        release buf_doc-line-attr.
     4082     end.
     4083   end procedure.
     4084   procedure lineattr-exist :
     4085     do
     4086     on error undo, return error return-value
     4087     :
     4088       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     4089       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     4090       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     4091       define output parameter p-exist   as logical  no-undo .
     4092       define buffer buf_doc-line-attr for ub.doc-line-attr .
     4093       def var v-type           as character no-undo .
     4094       def var v-format         as character no-undo .
     4095       def var v-fillin_width   as integer   no-undo .
     4096       def var v-fillin_height  as integer   no-undo .
     4097       def var v-label          as character no-undo .
     4098       def var v-user-can-edit  as logical   no-undo .
     4099       def var v-output-display as logical   no-undo .
     4100       def var v-other          as character no-undo .
     4101       run lineattr-code in this-procedure
     4102         (input  p-code
     4103         ,output v-type
     4104         ,output v-format
     4105         ,output v-fillin_width
     4106         ,output v-fillin_height
     4107         ,output v-label
     4108         ,output v-user-can-edit
     4109         ,output v-output-display
     4110         ,output v-other
     4111         ) no-error .
     4112       if error-status :error then do:
     4113         undo, return error return-value .
     4114       end.
     4115       find first buf_doc-line-attr no-lock
     4116         where buf_doc-line-attr.doc-code  = p-doc-code
     4117           and buf_doc-line-attr.gds-code = p-gds-code
     4118           and buf_doc-line-attr.attr-code = p-code
     4119         no-error .
     4120       if  available buf_doc-line-attr then do:
     4121         p-exist = yes.
     4122       end.
     4123     end.
     4124   end procedure.
     4125   procedure lineattr-delete :
     4126     do
     4127     on error undo, return error return-value
     4128     :
     4129       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     4130       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     4131       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     4132       define output parameter p-deleted  as logical no-undo.
     4133       define buffer buf_doc-line-attr for ub.doc-line-attr .
     4134       def var v-type           as character no-undo .
     4135       def var v-format         as character no-undo .
     4136       def var v-fillin_width   as integer   no-undo .
     4137       def var v-fillin_height  as integer   no-undo .
     4138       def var v-label          as character no-undo .
     4139       def var v-user-can-edit  as logical   no-undo .
     4140       def var v-output-display as logical   no-undo .
     4141       def var v-other          as character no-undo .
     4142       run lineattr-code in this-procedure
     4143         (input  p-code
     4144         ,output v-type
     4145         ,output v-format
     4146         ,output v-fillin_width
     4147         ,output v-fillin_height
     4148         ,output v-label
     4149         ,output v-user-can-edit
     4150         ,output v-output-display
     4151         ,output v-other
     4152         ) no-error .
     4153       if error-status :error then do:
     4154         undo, return error return-value .
     4155       end.
     4156       find first buf_doc-line-attr exclusive-lock
     4157         where buf_doc-line-attr.doc-code  = p-doc-code
     4158           and buf_doc-line-attr.gds-code  = p-gds-code
     4159           and buf_doc-line-attr.attr-code = p-code
     4160         no-error NO-WAIT.
     4161       if not available buf_doc-line-attr then do:
     4162         p-deleted = no.
     4163       end.
     4164       else do:
     4165         delete buf_doc-line-attr.
     4166         p-deleted = yes.
     4167       end.
     4168     end.
     4169   end procedure.
     4170   procedure lineattr-code :
     4171     do on error undo, return error return-value
     4172     :
     4173       define input  parameter p-code           as character no-undo .
     4174       define output parameter p-type           as character no-undo .
     4175       define output parameter p-format         as character no-undo .
     4176       define output parameter p-fillin_width   as integer   no-undo .
     4177       define output parameter p-fillin_height  as integer   no-undo .
     4178       define output parameter p-label          as character no-undo .
     4179       define output parameter p-user-can-edit  as logical   no-undo .
     4180       define output parameter p-output-display as logical   no-undo .
     4181       define output parameter p-other          as character no-undo .
     4182       case p-code :
     4183               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     4184               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     4185               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     4186               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     4187               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     4188               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     4189               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     4190               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     4191               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     4192               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     4193               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     4194         otherwise do:
     4195           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
     4196         end.
     4197       end.
     4198     end.
     4199   end procedure.
     4200   procedure lineattr-value-flora-gds :
     4201     do
     4202     on error undo, return error return-value
     4203     :
     4204       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
     4205       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
     4206       define input  parameter p-prt-code    as integer   no-undo .
     4207       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
     4208       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
     4209       define output parameter p-value       as    decimal   no-undo .
     4210       define buffer buf_doc-line-attr for ub.doc-line-attr .
     4211       find first buf_doc-line-attr no-lock
     4212         where buf_doc-line-attr.doc-code  = p-doc-code
     4213           and buf_doc-line-attr.gds-code  = p-gds-code
     4214           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     4215         no-error .
     4216       if avail buf_doc-line-attr then do:
     4217         assign
     4218           p-value = decimal( buf_doc-line-attr.attr-value)
     4219         .
     4220       end.
     4221       else do:
     4222         assign
     4223           p-value = 0
     4224         .
     4225       end.
     4226     end.
     4227   end procedure.
     4228   procedure lineattr-write-flora-gds :
     4229     do
     4230     on error undo, return error return-value
     4231     :
     4232       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     4233       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     4234       define input parameter p-prt-code    as integer   no-undo .
     4235       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
     4236       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
