     1774     define variable v-cntxp-chk-pay         like ub.store.chk-pay         no-undo.
     1775     define variable v-cntxp-retail          like ub.sysconf.ord-prt       no-undo.
     1776     define variable v-cntxp-osn-base        like ub.sysconf.osn-base      no-undo.
     1777     define variable v-cntxp-conf-par        as   character                no-undo.
     1778     define variable v-cntxp-par-type        as   character                no-undo.
     1779     define variable v-cntxp-curr-host-code  like ub.store.host-code       no-undo.
     1780     define variable v-cntxp-obj-type        like ub.clients.obj-type      no-undo.
     1781     define variable v-cntxp-obj-code        like ub.clients.obj-code      no-undo.
     1782     define variable v-cntxp-db-num          as integer   no-undo .
     1783     define variable v-cntxp-userid          as character no-undo .
     1784     define variable v-cntxp-level           as character no-undo .
     1785     define variable v-cntxp-db-num-obj      as integer   no-undo .
     1786     define variable v-cntxp-is-admin        as logical   no-undo .
     1787     define buffer bf-cntxp_store for ub.store.
     1788     define buffer bf-cntxp_shop  for ub.shop.
     1789     define buffer bf-cntxp_sysconf for ub.sysconf.
     1790   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1791     run mainmenu_getcntxt in parparentproc
     1792       (output v-cntxp-db-num
     1793       ,output v-cntxp-userid
     1794       ,output v-cntxp-level
     1795       ,output v-cntxp-curr-host-code
     1796       ,output v-cntxp-obj-type
     1797       ,output v-cntxp-obj-code
     1798       ,output v-cntxp-db-num-obj
     1799       ,output v-cntxp-is-admin
     1800       ) .
     1801     if (v-cntxp-obj-type = 'маг':U or v-cntxp-obj-type = 'скл':U) and
     1802        v-cntxp-obj-code <> 0 then do:
     1803   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1804     (input  'is-prt'
     1805     ,input  0
     1806     ,input  ''
     1807     ,input  0
     1808     ,input  ''
     1809     ,input  ''
     1810     ,input  ''
     1811     ,input  yes
     1812     ,output v-cntxp-conf-par
     1813     ,output v-cntxp-par-type
     1814     ) no-error .
     1815       case v-cntxp-obj-type :
     1816         when 'скл':U then do:
     1817           find first bf-cntxp_store where bf-cntxp_store.obj-code = v-cntxp-obj-code no-lock.
     1818           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_store.host-code no-lock.
     1819           assign
     1820             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_store.doc-prt
     1821             v-cntxp-price-calc      = bf-cntxp_store.price-calc
     1822             v-cntxp-inout-price     = bf-cntxp_store.inout-price
     1823             v-cntxp-unit-cli-perm   = bf-cntxp_store.unit-cli-perm
     1824             v-cntxp-out-rate        = bf-cntxp_store.out-rate
     1825             v-cntxp-out-line-discnt = bf-cntxp_store.out-line-discnt
     1826             v-cntxp-in-ov           = bf-cntxp_store.in-ov
     1827             v-cntxp-in-perm         = bf-cntxp_store.in-perm
     1828             v-cntxp-no-eq           = bf-cntxp_store.no-eq
     1829             v-cntxp-rsrv-time       = bf-cntxp_store.rsrv-time
     1830             v-cntxp-load-time       = bf-cntxp_store.load-time
     1831             v-cntxp-holidays        = bf-cntxp_store.holidays
     1832             v-cntxp-in-pay          = bf-cntxp_store.in-pay
     1833             v-cntxp-out-pay         = bf-cntxp_store.out-pay
     1834             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
     1835             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
     1836             v-cntxp-down-pay        = bf-cntxp_store.down-pay
     1837             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
     1838             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
     1839             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     1840             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     1841             .
     1842         end.
     1843         when 'маг':U then do:
     1844           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
     1845           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
     1846           assign
     1847             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_shop.doc-prt
     1848             v-cntxp-price-calc      = bf-cntxp_shop.price-calc
     1849             v-cntxp-inout-price     = bf-cntxp_shop.inout-price
     1850             v-cntxp-unit-cli-perm   = bf-cntxp_shop.unit-cli-perm
     1851             v-cntxp-out-rate        = bf-cntxp_shop.out-rate
     1852             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
     1853             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
     1854             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
     1855             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
     1856             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
     1857             v-cntxp-load-time       = bf-cntxp_shop.load-time
     1858             v-cntxp-holidays        = bf-cntxp_shop.holidays
     1859             v-cntxp-in-pay          = bf-cntxp_shop.in-pay
     1860             v-cntxp-out-pay         = bf-cntxp_shop.out-pay
     1861             v-cntxp-ret-pay         = bf-cntxp_shop.ret-pay
     1862             v-cntxp-ret-sup-pay     = bf-cntxp_shop.ret-sup-pay
     1863             v-cntxp-down-pay        = bf-cntxp_shop.down-pay
     1864             v-cntxp-inv-pay         = bf-cntxp_shop.inv-pay
     1865             v-cntxp-chk-pay         = bf-cntxp_shop.chk-pay
     1866             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     1867             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     1868             .
     1869         end.
     1870       end case.
     1871     end.
     1872     define new global shared variable g#lib-rvs as handle no-undo.
     1873   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1874   procedure factord :
     1875     define input  parameter p-fact-date            as date    no-undo .
     1876     define input  parameter p-fact-time            as integer no-undo .
     1877     define input  parameter p-fact-num             as integer no-undo .
     1878     define input  parameter p-shift-date           as date    no-undo .
     1879     define input  parameter p-shift-num            as integer no-undo .
     1880     define input  parameter p-shift-on             as logical no-undo .
     1881     define output parameter p-fact-order           as decimal no-undo .
     1882     define output parameter p-shift-end-fact-order as decimal no-undo .
     1883     define output parameter p-day-end-fact-order   as decimal no-undo .
     1884     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1885     if p-fact-date = ?
     1886     then do:
     1887       return error "Не указана фактическая дата" .
     1888     end.
     1889     define variable v-fact-date-num as integer no-undo .
     1890     assign
     1891       v-fact-date-num = integer(p-fact-date)
     1892     .
     1893     if p-fact-num = ?
     1894     or p-fact-num = 0
     1895     then do:
     1896       return error "Не задан p-fact-num " + string(p-fact-num) .
     1897     end.
     1898     if p-fact-num < 0
     1899     then do:
     1900       return error "Отрицательный fact-num " + string(p-fact-num) .
     1901     end.
     1902     if p-fact-num >= 100000000
     1903     then do:
     1904       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1905     end.
     1906     if p-shift-on = true
     1907     then do:
     1908       if p-shift-date = ?
     1909       then do:
     1910         return error "Не задана дата смены" .
     1911       end.
     1912       if p-shift-num = ?
     1913       or p-shift-num = 0
     1914       then do:
     1915         return error "Не задан номер смены" .
     1916       end.
     1917     end.
     1918     else do:
     1919       assign
     1920         p-shift-date = p-fact-date
     1921         p-shift-num  = 24
     1922       .
     1923     end.
     1924     define variable v-shift-offset as integer no-undo .
     1925     if p-shift-date = p-fact-date
     1926     then do:
     1927       assign
     1928         v-shift-offset = 1
     1929       .
     1930     end.
     1931     if p-shift-date < p-fact-date
     1932     then do:
     1933       assign
     1934         v-shift-offset = 0
     1935       .
     1936     end.
     1937     if p-shift-date > p-fact-date
     1938     then do:
     1939       message
     1940         vss-workfile vss-revision vss-description skip
     1941         "Неправильная дата закрытия смены" skip
     1942         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1943         view-as alert-box error .
     1944       undo, return error
     1945         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1946           ,string(p-fact-date, '99/99/9999':U)
     1947           ,string(p-shift-date, '99/99/9999':U)
     1948           )
     1949       .
     1950     end.
     1951     if p-shift-num < 1
     1952     or p-shift-num > 24
     1953     then do:
     1954       message
     1955         vss-workfile vss-revision vss-description skip
     1956         "Неправильный номер смены" skip
     1957         "p-shift-num" p-shift-num skip
     1958         view-as alert-box error .
     1959       undo, return error return-value .
     1960     end.
     1961     assign
     1962       p-fact-order           = v-fact-date-num
     1963                              + v-shift-offset * 0.5
     1964                              + p-shift-num    * 0.02 - 0.01
     1965                              + p-fact-num     * 0.0000000001
     1966       p-shift-end-fact-order = v-fact-date-num
     1967                              + v-shift-offset * 0.5
     1968                              + p-shift-num    * 0.02
     1969       p-day-end-fact-order   = v-fact-date-num
     1970                              + 0.99
     1971     .
     1972     if p-fact-order           <= v-fact-date-num
     1973     or p-shift-end-fact-order <= v-fact-date-num
     1974     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1975     or p-shift-end-fact-order >= p-day-end-fact-order
     1976     then do:
     1977       message
     1978         vss-workfile vss-revision vss-description skip
     1979         "Внутренняя ошибка при генерации фактического номера" skip
     1980         "p-fact-date"            p-fact-date            skip
     1981         "p-fact-time"            p-fact-time            skip
     1982         "p-fact-num"             p-fact-num             skip
     1983         "p-shift-date"           p-shift-date           skip
     1984         "p-shift-num"            p-shift-num            skip
     1985         "p-shift-on"             p-shift-on             skip
     1986         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1987         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1988         "v-fact-date-num"        v-fact-date-num        skip
     1989         view-as alert-box error .
     1990       undo, return error return-value .
     1991     end.
     1992   end procedure.
     1993   procedure day-begin-fact-order :
     1994     define input  parameter p-fact-date            as date    no-undo .
     1995     define output parameter p-day-begin-fact-order as decimal no-undo .
     1996     do
     1997     on error undo, return error return-value
     1998     :
     1999       if p-fact-date = ?
     2000       then do:
     2001         assign
     2002           p-day-begin-fact-order = 0
     2003         .
     2004       end.
     2005       else do:
     2006         assign
     2007           p-day-begin-fact-order = integer(p-fact-date)
     2008         .
     2009       end.
     2010     end.
     2011   end procedure.
     2012   procedure factord-max-fact-order :
     2013     define output parameter p-max-fact-order as decimal   no-undo .
     2014     do
     2015     on error undo, return error return-value
     2016     :
     2017       run day-begin-fact-order in this-procedure
     2018         (input  date(1, 1, 5000)
     2019         ,output p-max-fact-order
     2020         ) .
     2021     end.
     2022   end procedure.
     2023   procedure factord-cut-archive :
     2024     define input  parameter p-obj-type             as character no-undo .
     2025     define input  parameter p-obj-code             as integer   no-undo .
     2026     define input  parameter p-fact-date            as date      no-undo .
     2027     define output parameter p-shift-on             as logical   no-undo .
     2028     define output parameter p-shift-date           as date      no-undo .
     2029     define output parameter p-shift-num            as integer   no-undo .
     2030     define output parameter p-day-end-fact-order   as decimal   no-undo .
     2031     define output parameter p-shift-end-fact-order as decimal   no-undo .
     2032     define variable v-fact-order as decimal   no-undo .
     2033     define buffer buf_shift-obj for ub.shift-obj .
     2034     do
     2035     on error undo, return error return-value
     2036     :
     2037   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2038   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2039     (input  p-obj-type
     2040     ,input  p-obj-code
     2041     ,input  'shift-on=request'
     2042     ,output p-shift-on
     2043     ) no-error .
     2044       if error-status :error
     2045       then do:
     2046         message
     2047           vss-workfile vss-revision vss-description skip
     2048           "Ошибка при определении атрибута объекта" skip
     2049           "Объект" p-obj-type p-obj-code skip
     2050           error-status :get-message(1) skip
     2051           return-value skip
     2052           view-as alert-box error .
     2053         undo, return error return-value .
     2054       end.
     2055       if p-shift-on = false
     2056       then do:
     2057         assign
     2058           p-shift-date               = ?
     2059           p-shift-num                = 0
     2060         .
     2061       end.
     2062       else do:
     2063         find first buf_shift-obj share-lock
     2064           where buf_shift-obj.obj-type   = p-obj-type
     2065             and buf_shift-obj.obj-code   = p-obj-code
     2066             and buf_shift-obj.shift-date > p-fact-date
     2067           use-index pi
     2068           no-error .
     2069         if not available buf_shift-obj
     2070         or buf_shift-obj.status_ <> 'зкр':U
     2071         then do:
     2072           message
     2073             vss-workfile vss-revision vss-description skip
     2074             "Невозможно вычислить последнюю смену" skip
     2075             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     2076             "Объект" p-obj-type p-obj-code skip
     2077             "Дата" p-fact-date skip
     2078             view-as alert-box error .
     2079           undo, return error return-value .
     2080         end.
     2081         find last buf_shift-obj share-lock
     2082           where buf_shift-obj.obj-type = p-obj-type
     2083             and buf_shift-obj.obj-code = p-obj-code
     2084             and buf_shift-obj.shift-date <= p-fact-date
     2085           use-index pi
     2086           no-error .
     2087         if available buf_shift-obj
     2088         then do:
     2089           if  buf_shift-obj.status_ = 'зкр':U
     2090           then do:
     2091             assign
     2092               p-shift-date = buf_shift-obj.shift-date
     2093               p-shift-num  = buf_shift-obj.shift-num
     2094             .
     2095           end.
     2096           else do:
     2097             message
     2098               vss-workfile vss-revision vss-description skip
     2099               "Невозможно вычислить последнюю смену" skip
     2100               "Статус смены отличен от статуса" 'зкр':U skip
     2101               "Объект" p-obj-type p-obj-code skip
     2102               "Дата" p-fact-date skip
     2103               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     2104               view-as alert-box error .
     2105             undo, return error return-value .
     2106           end.
     2107         end.
     2108         else do:
     2109           assign
     2110             p-shift-date = p-fact-date - 1
     2111             p-shift-num  = 1
     2112           .
     2113         end.
     2114       end.
     2115       run factord in this-procedure
     2116         (input  p-fact-date
     2117         ,input  1
     2118         ,input  1
     2119         ,input  p-shift-date
     2120         ,input  p-shift-num
     2121         ,input  p-shift-on
     2122         ,output v-fact-order
     2123         ,output p-shift-end-fact-order
     2124         ,output p-day-end-fact-order
     2125         ) no-error .
     2126       if error-status :error
     2127       then do:
     2128         message
     2129           vss-workfile vss-revision vss-description skip
     2130           "Ошибка при вызове процедуры factord"
     2131           error-status :get-message(1) skip
     2132           return-value skip
     2133           view-as alert-box error .
     2134         undo, return error return-value .
     2135       end.
     2136     end.
     2137   end procedure.
     2138   procedure factord-lock-shift :
     2139     define input  parameter p-obj-type  as character no-undo .
     2140     define input  parameter p-obj-code  as integer   no-undo .
     2141     define input  parameter p-fact-date as date      no-undo .
     2142     define parameter buffer buf_shift-obj for ub.shift-obj .
     2143     define variable v-shift-on      as logical   no-undo .
     2144     define variable v-extra-message as character no-undo .
     2145     define variable v-error as character no-undo .
     2146     do
     2147     on error undo, return error return-value
     2148     :
     2149   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2150   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2151     (input  p-obj-type
     2152     ,input  p-obj-code
     2153     ,input  'shift-on=request'
     2154     ,output v-shift-on
     2155     ) no-error .
     2156       if error-status :error
     2157       then do:
     2158         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     2159         undo, return error v-error .
     2160       end.
     2161       if v-shift-on = true
     2162       then do:
     2163         find first buf_shift-obj share-lock
     2164           where buf_shift-obj.obj-type   = p-obj-type
     2165             and buf_shift-obj.obj-code   = p-obj-code
     2166             and buf_shift-obj.shift-date > p-fact-date
     2167           use-index pi
     2168           no-error .
     2169         if not available buf_shift-obj
     2170         or buf_shift-obj.status_ <> 'зкр':U
     2171         then do:
     2172           find last buf_shift-obj
     2173             where buf_shift-obj.obj-type = p-obj-type
     2174               and buf_shift-obj.obj-code = p-obj-code
     2175               and buf_shift-obj.status_  = 'зкр':U
     2176             use-index stts
     2177             no-error .
     2178           if available buf_shift-obj
     2179           then do:
     2180             assign
     2181               v-extra-message =
     2182                     substitute("Дата начала последеней закрытой смены на объекте &1"
     2183                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     2184                               )
     2185             .
     2186           end.
     2187           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     2188           undo, return error v-error .
     2189         end.
     2190       end.
     2191     end.
     2192   end procedure.
     2193   procedure factord-end-day :
     2194     define input  parameter p-fact-date            as date    no-undo .
     2195     define output parameter p-day-end-fact-order   as decimal no-undo .
     2196     do
     2197     on error undo, return error return-value
     2198     :
     2199       if p-fact-date = ?
     2200       then do:
     2201         return error "Не указана фактическая дата" .
     2202       end.
     2203       assign
     2204         p-day-end-fact-order = integer(p-fact-date) + 0.99
     2205       .
     2206     end.
     2207   end procedure.
     2208   procedure factord-to-date :
     2209     define input  parameter p-fact-order as decimal no-undo .
     2210     define output parameter p-fact-date  as date    no-undo .
     2211     define variable v-ref-date  as date      no-undo .
     2212     define variable v-ref-delta as integer   no-undo .
     2213     do
     2214     on error undo, return error return-value
     2215     :
     2216       if p-fact-order = ?
     2217       or p-fact-order = 0
     2218       then do:
     2219         return error "Не указан fact-order" .
     2220       end.
     2221       assign
     2222         v-ref-date  = date(1, 1, 2000)
     2223       .
     2224       assign
     2225         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     2226       .
     2227       assign
     2228         p-fact-date = v-ref-date + v-ref-delta
     2229       .
     2230     end.
     2231   end procedure.
     2232   procedure factord-to-fact-num :
     2233     define input  parameter p-fact-order as decimal no-undo .
     2234     define output parameter p-fact-num   as integer no-undo .
     2235     define variable v-fact-order-trunc as decimal no-undo .
     2236     do
     2237     on error undo, return error return-value
     2238     :
     2239       if p-fact-order = ?
     2240       or p-fact-order = 0
     2241       then do:
     2242         return error "Не указан fact-order" .
     2243       end.
     2244       assign
     2245        v-fact-order-trunc = truncate(p-fact-order, 2)
     2246       .
     2247       assign
     2248         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     2249       .
     2250     end.
     2251   end procedure.
     2252   procedure factord-to-shift-num :
     2253     define input  parameter p-fact-order as decimal no-undo .
     2254     define output parameter p-shift-num   as integer no-undo .
     2255     define variable  p-shift-numd  as decimal   no-undo .
     2256     define variable v-fact-order-trunc as decimal no-undo .
     2257     do
     2258     on error undo, return error return-value
     2259     :
     2260       if p-fact-order = ?
     2261       or p-fact-order = 0
     2262       then do:
     2263         return error "Не указан fact-order" .
     2264       end.
     2265       assign
     2266        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     2267       .
     2268       if v-fact-order-trunc < 0.5 then do:
     2269         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     2270       end.
     2271       assign
     2272         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     2273         .
     2274        assign
     2275         p-shift-num = truncate (p-shift-numd , 0)
     2276       .
     2277     end.
     2278   end procedure.
