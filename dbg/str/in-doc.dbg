    10213   end procedure.
    10214   on entry of t-doc.cli-code, r-clients in frame d-in-doc
    10215   DO:
    10216   if t-doc.ret-supp = yes and
    10217     can-find (first ub.doc-line where ub.doc-line.doc-code = t-doc.doc-code no-lock) then do:
    10218       message "Уже есть строки возврата. Изменение контрагента невозможно."
    10219       view-as alert-box error buttons ok.
    10220       apply "entry" to browse br-dtl.
    10221       return no-apply.
    10222   end.
    10223   if t-doc.cli-code <> ? then do:
    10224     pardoc-mode = 'ДОБАВЛЕНИЕ':U.
    10225     run UI-on ("enable").
    10226   end.
    10227   end.
    10228   on leave of t-doc.pay-code in frame d-in-doc
    10229   do:
    10230   if input frame d-in-doc t-doc.pay-code <> t-doc.pay-code then do:
    10231     run leave-pay-code no-error.
    10232     if error-status :error then return no-apply.
    10233   end.
    10234   end.
    10235   on leave of t-doc.doc-date in frame d-in-doc do:
    10236   if input frame d-in-doc t-doc.doc-date <> t-doc.doc-date then do:
    10237     assign
    10238       t-doc.doc-date = input frame d-in-doc t-doc.doc-date.
    10239   end.
    10240   end.
    10241   on mouse-select-dblclick, return of t-doc.pay-code in frame d-in-doc
    10242   do:
    10243   if input frame d-in-doc t-doc.pay-code <> t-doc.pay-code then do:
    10244     run return-pay-code no-error.
    10245     if error-status :error then return no-apply.
    10246   end.
    10247   apply "entry" to t-doc.wrkr in frame d-in-doc.
    10248   return no-apply.
    10249   end.
    10250   on choose of r-pay in frame d-in-doc
    10251   do:
    10252     run choose-r-pay no-error.
    10253     if error-status :error then return no-apply.
    10254   end.
    10255   on return, mouse-select-dblclick of br-dtl in frame d-in-doc
    10256   do:
    10257     if b-chg:sensitive then do:
    10258       apply "choose" to b-chg in frame d-in-doc.
    10259     end.
    10260     else do:
    10261       apply "choose" to b-lkp in frame d-in-doc.
    10262     end.
    10263   end.
    10264   on choose of r-acc in frame d-in-doc
    10265   do:
    10266     run choose-r-acc no-error.
    10267     if error-status :error then return no-apply.
    10268   end.
    10269   procedure choose-r-acc:
    10270   define variable v-today      as date    no-undo.
    10271   define variable varbase-code as integer no-undo.
    10272   run check-update no-error.
    10273   if error-status :error then return error.
    10274   run check-exch no-error.
    10275   if error-status :error then return error.
    10276   varlog = yes.
    10277   message "Подставить БИРЖЕВЫЕ курсы базовой валюты :" base-abbr "и валюты поставщика :"
    10278           ub.currency.curr-abbr "на дату растаможивания ?"
    10279   view-as alert-box question buttons OK-Cancel update varlog.
    10280   if varlog <> true then do:
    10281     return error.
    10282   end.
    10283   define variable vss-include-info80 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10284   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
    10285     (input  v-cntxt-host-code-obj
    10286     ,output varbase-code
    10287     )  .
    10288   find last ub.curr-accnt where ub.curr-accnt.curr-code = varbase-code and
    10289                            ub.curr-accnt.exch-date <= input frame d-in-doc t-doc.exch-date use-index pi no-lock no-error.
    10290   if not available ub.curr-accnt then do:
    10291     message "На эту дату неизвестен курс базовой валюты.".
    10292     apply "entry" to t-doc.base-rate in frame d-in-doc.
    10293     return error.
    10294   end.
    10295   disp ub.curr-accnt.exch-rate  @ t-doc.base-rate
    10296        ub.curr-accnt.exch-scale @ t-doc.base-scale with frame d-in-doc.
    10297   run check-rate.
    10298   find last ub.curr-accnt where ub.curr-accnt.curr-code = input t-doc.exch-code
    10299             and ub.curr-accnt.exch-date <= input t-doc.exch-date use-index pi no-lock no-error.
    10300   if not available ub.curr-accnt then do:
    10301     message "На дату " + input t-doc.exch-date + " неизвестен курс валюты поставщика.".
    10302     apply "entry" to t-doc.exch-rate.
    10303     return error.
    10304   end.
    10305   display ub.curr-accnt.exch-rate  @ t-doc.exch-rate
    10306           ub.curr-accnt.exch-scale @ t-doc.exch-scale with frame d-in-doc.
    10307   run check-rate.
    10308   run UI-on ("line").
    10309   end procedure.
    10310   on mouse-select-dblclick, return of t-doc.cli-code, t-doc.cli-type
    10311     in frame d-in-doc
    10312   do:
    10313     run choose-cli in this-procedure no-error.
    10314     if error-status :error then do:
    10315       display ? @ t-doc.cli-type ? @ t-doc.cli-code with frame d-in-doc.
    10316     end.
    10317     return no-apply.
    10318   end.
    10319   on choose of r-clients in frame d-in-doc
    10320   do:
    10321   define variable varfirm-code like ub.firm.firm-code no-undo.
    10322   define variable v-rid-list as character no-undo .
    10323   define variable v-types as character no-undo .
    10324   define buffer bf_clients for ub.clients.
    10325   if t-doc.internal then v-types = 'маг':U.
    10326                     else v-types = 'все':U.
    10327   if (t-doc.ext-doc-type = 'ee':U or t-doc.ext-doc-type = 'ep':U) and
    10328      varhold            = "yes"              and
    10329      paris-hold         = yes                then do:
    10330     assign
    10331       varfirm-code = ?.
    10332     run adm/sconfs.w ( input parparentproc
    10333                      , input "b-sel":U
    10334                      , input no
    10335                      , input ?
    10336                      , output varfirm-code
    10337                      , input-output v-rid-list) no-error.
    10338     if error-status :error or
    10339        varfirm-code = ?   then do:
    10340       return no-apply.
    10341     end.
    10342     find first bf_clients where bf_clients.obj-type = 'орг':U       and
    10343                                 bf_clients.obj-code = varfirm-code no-lock.
    10344     assign ref-list = string(recid (bf_clients)).
    10345     run check-base-code in this-procedure (recid(bf_clients)).
    10346   end.
    10347   else do:
    10348     if transaction = yes then do:
    10349       message "Критическая ошибка." skip
    10350               "Вы находитесь в транзакции." skip
    10351               "Работа со справочником клиентов невозможна."
    10352       view-as alert-box error.
    10353       return no-apply.
    10354     end.
    10355     def var supp-type as character no-undo.
    10356     case trn-type:
    10357       when 1 then supp-type = "supp-np".
    10358       when 2 then supp-type = "supp-lgas".
    10359       when 3 then supp-type = "supp-lgas".
    10360     end case.
    10361     run ref/cli-all.w (parparentproc
    10362                   , "b-sel,b-add"
    10363                   , v-types
    10364                   , ?
    10365                   , ?
    10366                   , ?
    10367                   , ?
    10368                   , supp-type
    10369                   , output ref-list) .
    10370   end.
    10371   if ref-list <> "" then do:
    10372     ref-rec = integer (ref-list).
    10373     find ub.clients where recid ( ub.clients ) = ref-rec no-lock.
    10374     disp ub.clients.obj-code @ t-doc.cli-code
    10375             ub.clients.obj-name with frame d-in-doc.
    10376     disp ub.clients.obj-type @ t-doc.cli-type with frame d-in-doc.
    10377   end.
    10378   if trn-type = 1
    10379   then do :
    10380     define variable v-tmp-char like ub.thbj-attr.property-value-character no-undo .
    10381     define variable v-tmp-date      like ub.thbj-attr.property-value-date    no-undo .
