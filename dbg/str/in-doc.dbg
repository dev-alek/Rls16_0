    19600                                 can-find(first bf_trn-doc where
    19601                                                bf_trn-doc.doc-code = bf_doc-line.doc-code
    19602                                            and bf_trn-doc.ext-doc-type = 'ie':U)
    19603                                 use-index dt-fo no-lock no-error.
    19604     if available bf_doc-line then do:
    19605       return bf_doc-line.price-rubl.
    19606     end.
    19607     else do:
    19608       return ?.
    19609     end.
    19610   end.
    19611   end function.
    19612   function get-add-gtd returns character ( buffer local-doc-line for ub.doc-line ) :
    19613     define variable d_out-gtd as character no-undo .
    19614     define buffer buf_parts for ub.parts.
    19615     if v-is-gtd-part = "yes" then do:
    19616       find first buf_parts no-lock
    19617         where buf_parts.obj-type  = local-doc-line.obj-type
    19618           and buf_parts.obj-code  = local-doc-line.obj-code
    19619           and buf_parts.artic     = local-doc-line.artic
    19620           and buf_parts.prod-type = local-doc-line.prod-type
    19621           and buf_parts.prod-code = local-doc-line.prod-code
    19622           and buf_parts.out-code  = local-doc-line.doc-code
    19623       no-error .
    19624       if available buf_parts then do:
    19625         if length(t-doc.cst-code) > 0 and (buf_parts.cst-code  BEGINS t-doc.cst-code) then do:
    19626           if SUBSTRING( buf_parts.cst-code, LENGTH( t-doc.cst-code ) + 1 ,1 ) = '/' then
    19627             assign d_out-gtd = SUBSTRING( buf_parts.cst-code, LENGTH( t-doc.cst-code ) + 2 ) .
    19628         end.
    19629       end.
    19630     end.
    19631     return d_out-gtd .
    19632   end function.
    19633   FUNCTION get-vsdsts RETURNS CHARACTER
    19634   (buffer local-doc-line for doc-line ):
    19635     def var v-mercury-prod as logical no-undo.
    19636     if v-is-mercury-value
    19637     then do:
    19638       def buffer bf_gds for ub.goods.
    19639       find first bf_gds where
    19640             local-doc-line.artic = bf_gds.artic
    19641         and local-doc-line.prod-type = bf_gds.prod-type
    19642         and local-doc-line.prod-code = bf_gds.prod-code.
    19643   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscdat in g#library
    19644     (input  bf_gds.gds-code
    19645     ,input  'mercur_FGIS=request':u
    19646     ,output v-mercury-prod
    19647     ) no-error .
    19648       if error-status :error
    19649       then do:
    19650         message
    19651           vss-workfile vss-revision vss-description skip
    19652           "Ошибка при определении атрибута товара" skip
    19653           "Код товара" bf_gds.gds-code skip
    19654           'mercur_FGIS=request':u skip
    19655           error-status :get-message(1) skip
    19656           return-value skip
    19657           view-as alert-box error .
    19658         undo, return error .
    19659       end.
    19660       if v-mercury-prod
    19661       then do:
    19662         if vsdstrObj:exsistvsd( buffer local-doc-line )
    19663         then do:
    19664           return "+".
    19665         end.
    19666         else do with frame d-in-doc:
    19667           return "-".
    19668         end.
    19669       end.
    19670     end.
    19671     return "".
    19672   end function.
    19673   FUNCTION get-vat-sum RETURNS decimal
    19674   (buffer local-doc-line for doc-line ):
    19675     def var v-vat-sum as decimal no-undo.
    19676     v-vat-sum = (ub.doc-line.cli-qnty *  ub.doc-line.price-cli * doc-line.VAT-pc) / (100 + doc-line.VAT-pc) .
    19677     return v-vat-sum.
    19678   end function.
    19679   procedure rowdisp :
    19680     def var v-vsdsts-fail as logical no-undo.
    19681     assign
    19682       v-vsdsts-fail = (get-vsdsts(buffer ub.doc-line) = "-").
    19683     if v-vsdsts-fail
    19684     then do ii = 1 to extent (bcol):
    19685       if valid-handle (bcol[ii])
    19686       then do:
    19687         assign
    19688           bcol[ii]:bgcolor = RED_COLOR.
    19689       end.
    19690     end.
    19691   end procedure.
    19692   procedure add-lgas-corr :
    19693     def var loc-ref-list as character no-undo.
    19694     def var v-gds-code as integer no-undo.
    19695     run str/all-docs.w
    19696       (  input parparentproc,
    19697           input t-doc.host-code ,
    19698           input t-doc.obj-type ,
    19699           input t-doc.obj-code ,
    19700           input 'статус':U,
    19701           input 'факт':U,
    19702           input 'при':U,
    19703           input ?,
    19704           input no,
    19705           input "b-sel,":U + 'is-lgas-corr':U,
    19706           input 'ie':U,
    19707           input false,
    19708           input ?,
    19709           output loc-ref-list ).
    19710       find t-d-b where recid (t-d-b) = integer (loc-ref-list) no-lock no-error.
    19711       if not available t-d-b then do:
    19712         message "Не выбран документ-источник для корр. СУГ." view-as alert-box.
    19713         return error.
    19714       end.
    19715       if not t-d-b.status_ = 'факт':U
    19716       then do:
    19717         message "Неверный выбор документа-источника для корр. СУГ."
    19718           skip "Документ не закрыт на факт." view-as alert-box.
    19719         return error.
    19720       end.
    19721       find clients where clients.obj-type = t-d-b.cli-type and clients.obj-code = t-d-b.cli-code no-lock.
    19722       disp clients.obj-code @ t-doc.cli-code
    19723               clients.obj-name with frame d-in-doc.
    19724       disp clients.obj-type @ t-doc.cli-type with frame d-in-doc.
    19725           run check-cli no-error.
    19726           if error-status :error then return no-apply.
    19727   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t-d-b.doc-code ,
    19728                           input 'is-lgas':U ,
    19729                          output varvalue ,
    19730                          output vartype ) no-error .
    19731        if not varvalue = "yes" then do:
    19732         message "Неверный выбор документа-источника для корр. СУГ."
    19733           skip "Документ не является приходной накладной СУГ." view-as alert-box.
    19734         return error.
    19735      end.
    19736   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input t-doc.doc-code ,
    19737                          input 'trn-lgas-corr':U ,
    19738                          input t-d-b.doc-code ) no-error .
    19739     find first ub.doc-line no-lock where ub.doc-line.doc-code = t-d-b.doc-code no-error.
    19740     if available (ub.doc-line)
    19741     then do:
    19742   define variable vss-include-info147 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    19743   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run doclicod in g#library
    19744     (input  recid(ub.doc-line)
    19745     ,output v-gds-code
    19746     )  .
    19747       find first ub.goods no-lock where ub.goods.gds-code = v-gds-code no-error.
    19748       if available (ub.goods)
    19749       then do:
    19750         varnotes = string (recid (ub.goods)).
    19751         run cycle-add in this-procedure.
    19752       end.
    19753     end.
    19754     def buffer buf_doc-attr for ub.doc-attr.
    19755     for each tt-upd-attr-fuel :
    19756       find first ub.doc-attr where ub.doc-attr.doc-code = t-d-b.doc-code and ub.doc-attr.attr-code = tt-upd-attr-fuel.code no-lock no-error.
    19757       if available (ub.doc-attr)
    19758       then do:
    19759         find first buf_doc-attr
    19760           where buf_doc-attr.doc-code = t-doc.doc-code
    19761             and buf_doc-attr.attr-code = tt-upd-attr-fuel.code no-error.
    19762         if not available (buf_doc-attr)
    19763         then do:
    19764           create buf_doc-attr.
    19765           buf_doc-attr.doc-code = t-doc.doc-code.
    19766         end.
    19767         buffer-copy ub.doc-attr except ub.doc-attr.doc-code
    19768         to buf_doc-attr.
    19769       end.
    19770     end.
    19771     find first ub.doc-attr where ub.doc-attr.doc-code = t-d-b.doc-code and ub.doc-attr.attr-code = 'nids':U no-lock no-error.
    19772     if available (ub.doc-attr)
    19773     then do:
    19774       find first buf_doc-attr
    19775         where buf_doc-attr.doc-code = t-doc.doc-code
    19776           and buf_doc-attr.attr-code = tt-upd-attr-fuel.code no-error.
    19777       if not available (buf_doc-attr)
    19778       then do:
    19779         create buf_doc-attr.
    19780         buf_doc-attr.doc-code = t-doc.doc-code.
    19781       end.
    19782       buffer-copy ub.doc-attr except ub.doc-attr.doc-code
    19783       to buf_doc-attr.
    19784     end.
    19785     find first ub.doc-attr where ub.doc-attr.doc-code = t-d-b.doc-code and ub.doc-attr.attr-code = 'dids':U no-lock no-error.
    19786     if available (ub.doc-attr)
    19787     then do:
    19788       find first buf_doc-attr
    19789         where buf_doc-attr.doc-code = t-doc.doc-code
    19790           and buf_doc-attr.attr-code = tt-upd-attr-fuel.code no-error.
    19791       if not available (buf_doc-attr)
    19792       then do:
    19793         create buf_doc-attr.
    19794         buf_doc-attr.doc-code = t-doc.doc-code.
    19795       end.
    19796       buffer-copy ub.doc-attr except ub.doc-attr.doc-code
    19797       to buf_doc-attr.
    19798     end.
    19799   end procedure.
