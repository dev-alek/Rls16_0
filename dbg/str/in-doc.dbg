    18589           if is-ovvalue <> "no" then enable ov-pc with frame d-in-doc.
    18590                                 else hide   ov-pc in   frame d-in-doc.
    18591           enable t-doc.tot-other t-doc.tot-transp with frame d-in-doc.
    18592           if multdtypvalue <> "no" then enable t-doc.VAT-type t-doc.slt-type with frame d-in-doc.
    18593                                    else disable t-doc.VAT-type t-doc.slt-type with frame d-in-doc.
    18594         end.
    18595         else do:
