     4489   procedure find-new-price-sale :
     4490   define input  parameter  par-gm           as character no-undo .
     4491   define input  parameter  par-pr-nakl      as logical   no-undo .
     4492   define input  parameter  p-doc-code       as character no-undo .
     4493   define input  parameter  p-artic          as character no-undo .
     4494   define input  parameter  p-prod-type      as character no-undo .
