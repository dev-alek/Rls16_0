     7759       define variable varcurr-abbr     as   character                       no-undo.
     7760       define variable v-master as character no-undo.
     7761       if trn-type = 4 then do:
     7762       run adm/shattri.p (
     7763         input "get":U
     7764         ,input t-doc.obj-type
     7765         ,input t-doc.obj-code
     7766         ,input 'contr-in':U
     7767         ,input ( if t-doc.ext-doc-type = 'ee':U  then  "contr-in-expense" else "contr-in-income" )
     7768         ,output v-value-character
