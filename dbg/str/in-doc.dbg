    13560   t-doc.VAT-rubl:label in frame d-in-doc = "НДС по УЧЕТ ценам(руб)"   .
    13561   b-print:popup-menu in frame d-in-doc   = menu m-print:handle .
    13562   b-print:menu-mouse                          = 1 .
    13563   assign
    13564     parnext-prev = yes
    13565   .
    13566   n-p:
