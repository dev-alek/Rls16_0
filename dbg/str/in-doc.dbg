    10638         if varvalue = "no" then do:
    10639         if can-find (FIRST ub.clients-attr no-lock where (ub.clients-attr.attr-code = 'supp-np':U or ub.clients-attr.attr-code = 'supp-lgas':U)
    10640                                                   and ub.clients-attr.attr-value = "yes") then varvalue = "no" . else varvalue = "yes" .
    10641         end.
    10642         end.
    10643      if varvalue = "yes" or varvalue = "" then
    10644      do:
    10645         run adm/shattri.p (
    10646            input "get":U
    10647            ,input t-doc.obj-type
    10648            ,input t-doc.obj-code
    10649            ,input 'contr-in':U
    10650            ,input ( if t-doc.ext-doc-type = 'ee':U  then  "contr-in-expense" else "contr-in-income" )
    10651            ,output v-value-character
    10652            ,output v-value-date
    10653            ,output v-value-decimal
    10654            ,output v-value-integer
    10655            ,output v-value-logical
    10656            ,output varcontract-type
    10657            ,INPUT-OUTPUT TABLE-handle v-tth1
    10658            ) no-error .
    10659         if error-status :error then
    10660            message
    10661               vss-workfile vss-revision vss-description skip
    10662               error-status :get-message(1) skip
    10663               return-value skip
    10664               "adm/shattri.p"
    10665               view-as alert-box error
    10666               .
    10667      end.
    10668      else
    10669      do:
    10670         run adm/shattri.p (
    10671            input "get":U
    10672            ,input t-doc.obj-type
    10673            ,input t-doc.obj-code
    10674            ,input 'contr-in':U
    10675            ,input ( if t-doc.ext-doc-type = 'ee':U  then  "contr-in-expense-NP" else "contr-in-income-NP" )
    10676            ,output v-value-character
    10677            ,output v-value-date
    10678            ,output v-value-decimal
    10679            ,output v-value-integer
    10680            ,output v-value-logical
    10681            ,output varcontract-type
    10682            ,INPUT-OUTPUT TABLE-handle v-tth1
    10683            ) no-error .
    10684         if error-status :error then
    10685            message
    10686               vss-workfile vss-revision vss-description skip
    10687               error-status :get-message(1) skip
    10688               return-value skip
    10689               "adm/shattri.p"
    10690               view-as alert-box error
    10691               .
    10692      end.
    10693         delete object v-tth1.
    10694         if v-value-logical = true then varcontract = "yes" .
    10695                                   else varcontract = "no" .
    10696   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t-doc.doc-code ,
    10697                           input 'is-return':U ,
    10698                          output varvalue ,
    10699                          output vartype ) no-error .
    10700   if varvalue = "yes"
    10701   then do :
    10702     trn-is-return = yes .
    10703   end .
    10704   if ( varis-fin = "yes":u
    10705    and ( t-doc.ext-doc-type = 'ie':U or
    10706          t-doc.ext-doc-type = 'ep':U or
    10707      ( t-doc.ext-doc-type = 'ee':U and (paris-hold = true or mode-erprn = true or trn-is-return = true) ) or
    10708        ( t-doc.ext-doc-type = 're':U and (paris-hold = true or mode-erprn = true)   )))
    10709     or ( varis-finby = "yes":u
    10710     and ( t-doc.ext-doc-type = 'ee':U      or
    10711           t-doc.ext-doc-type = 'ep':U or
    10712           t-doc.ext-doc-type = 're':U  or
    10713         ( t-doc.ext-doc-type = 'ee':U  and paris-hold = true )))
    10714     then do:
    10715       find first bf_contract where bf_contract.host-code = t-doc.host-code                          and
    10716                                    bf_contract.cli-type  = input frame d-in-doc t-doc.cli-type and
    10717                                    bf_contract.cli-code  = input frame d-in-doc t-doc.cli-code no-lock no-error.
    10718       if not available bf_contract then do:
    10719         if (varcontract <> "yes":u or trn-type = 1) and
    10720            not (t-doc.ext-doc-type = 'ee':U and trn-is-return)
    10721         then do:
    10722           assign
    10723             t-doc.contract-code  = 0.
    10724         end.
    10725         else do:
    10726           message "По клиенту " input frame d-in-doc t-doc.cli-code " " input frame d-in-doc t-doc.cli-type
    10727                   " на фирме " t-doc.host-code " нет ни одного договора. "
    10728                   func-get-name-from-ext-type ( t-doc.ext-doc-type , true ) " не может быть оформлен."
    10729           view-as alert-box error.
    10730           apply "entry" to t-doc.cli-code in frame d-in-doc.
    10731           return error.
    10732         end.
    10733       end.
    10734       else do:
    10735           run check-contract-code in this-procedure (input  substitute("&1,&2=&3", "choose":u, "doc-type", t-doc.ext-doc-type),
    10736                                                     input  t-doc.host-code,
    10737                                                     input  input frame d-in-doc t-doc.cli-type,
    10738                                                     input  input frame d-in-doc t-doc.cli-code,
    10739                                                     input  ?,
    10740                                                     input  parparentproc,
    10741                                                     input  t-doc.doc-date,
    10742                                                     input if paris-hold = yes then "all" else (if ( t-doc.ext-doc-type = 'ie':U or t-doc.ext-doc-type = 'ep':U or mode-erprn or (t-doc.ext-doc-type = 'ee':U and (logical(varcontract) or trn-is-return))) then 'при':U else 'рас':U) ,
    10743                                                     output varcontract-code) no-error.
    10744         if error-status :error    or
    10745            varcontract-code = ?  or
    10746            varcontract-code = 0  then do:
    10747           if trn-is-return
    10748           then do :
    10749             apply "entry" to t-doc.cli-code in frame d-in-doc.
    10750             return error.
    10751           end .
    10752           if varcontract <> "yes":u or trn-type = 1 then do:
    10753             message "Вы не выбрали договор. Вы хотите оформить "
    10754               func-get-name-from-ext-type ( t-doc.ext-doc-type , false ) " без договора?"
    10755             view-as alert-box question buttons yes-no update varlog.
    10756             if varlog = no then do:
    10757               apply "entry" to t-doc.cli-code in frame d-in-doc.
    10758               return error.
    10759             end.
    10760             else do:
    10761               assign
    10762                 t-doc.contract-code = 0.
    10763             end.
    10764           end.
    10765           else do:
    10766             message "Вы не выбрали договор. "
