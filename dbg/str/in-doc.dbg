    17317                           , ( if b-chg :sensitive in frame d-in-doc
    17318                               then substitute( '&1Воспользуйтесь кнопкой "&2".'
    17319                                              , chr(10)
    17320                                              , replace( b-chg :label in frame d-in-doc, "&", "":U )
    17321                                              )
    17322                               else '':U )
    17323                           )
