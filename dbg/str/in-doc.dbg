     7966   ON CHOOSE OF b-marks IN FRAME d-in-doc
     7967   DO:
     7968       define buffer buf_gen-attr for ub.gen-attr .
     7969       define variable v-parts-uniq-key-rec    as character    no-undo .
     7970       define buffer buf_tt-marks  for tt-marks .
     7971       define variable v-alcohol-prod   as logical no-undo .
     7972     if lookup( self :type in frame d-in-doc, 'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW' ) <> 0 then do:   apply "ENTRY":U to self in frame d-in-doc .   if focus :handle <> self :handle in frame d-in-doc then do:     return no-apply .   end. end.
     7973     if not available (ub.goods)
     7974       then return no-apply.
     7975     for each buf_tt-marks:
     7976       delete buf_tt-marks .
     7977     end.
     7978   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscdat in g#library
     7979     (input  ub.goods.gds-code
     7980     ,input  'alcohol-prod=request':u
     7981     ,output v-alcohol-prod
     7982     )  .
     7983     if error-status :error
     7984     then do:
     7985       message
     7986         vss-workfile vss-revision vss-description skip
     7987         "Ошибка при определении атрибута товара" skip
     7988         "Код товара" ub.goods.gds-code skip
     7989         'mercur_FGIS=request':u skip
     7990         error-status :get-message(1) skip
     7991         return-value skip
     7992         view-as alert-box error .
     7993       undo, return no-apply .
     7994     end.
     7995     case true:
     7996       when v-alcohol-prod then do:
     7997         message "Вывести марки по всем линиям?"
     7998           view-as alert-box question buttons YES-NO title "Вопрос" update varlog.
     7999         for each bf_parts where bf_parts.out-code = t-doc.doc-code and
     8000         (varlog or (bf_parts.artic = goods.artic and bf_parts.prod-code = goods.prod-code and bf_parts.prod-type = goods.prod-type)):
     8001         run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     8002           ,input (buffer bf_parts:handle)
     8003           ,output v-parts-uniq-key-rec).
     8004           for each buf_gen-attr no-lock where buf_gen-attr.table-name = 'excise-mark':U and buf_gen-attr.p-key = v-parts-uniq-key-rec:
     8005               find first buf_tt-marks where buf_tt-marks.mark = buf_gen-attr.attr-code no-error .
     8006               if not AVAILABLE buf_tt-marks then
     8007               do:
     8008                   create buf_tt-marks .
     8009                   ASSIGN
     8010                       buf_tt-marks.mark               = buf_gen-attr.attr-code
     8011                       buf_tt-marks.parts              = buf_gen-attr.p-key
     8012                       buf_tt-marks.reserv             = buf_gen-attr.whole-send-news
     8013                       buf_tt-marks.num                = ""
     8014                       buf_tt-marks.gds-part-position_ = ?
     8015                       buf_tt-marks.gds-code           =  goods.gds-code
     8016                       .
     8017               end.
     8018             end.
     8019           end.
     8020           run ref/egais-marks_exp.w (
     8021               input parparentproc,
     8022               input t-doc.doc-code,
     8023               input 'при':U  ,
     8024               input-output table tt-marks) no-error.
     8025         if error-status :error then do: return no-apply. end.
     8026       end.
     8027       when true then do:
     8028         for each bf_parts no-lock where bf_parts.out-code = t-doc.doc-code and
     8029         bf_parts.artic = goods.artic and bf_parts.prod-code = goods.prod-code and bf_parts.prod-type = goods.prod-type:
     8030           for each ub.marking-lines no-lock where
     8031                 ub.marking-lines.obj-type = bf_parts.obj-type
     8032             and ub.marking-lines.obj-code = bf_parts.obj-code
     8033             and ub.marking-lines.in-code = bf_parts.in-code
     8034             and ub.marking-lines.out-code = bf_parts.out-code
     8035             and ub.marking-lines.gds-code = ub.goods.gds-code
     8036             and ub.marking-lines.part-code = bf_parts.part-code
     8037             and ub.marking-lines.prt-code = bf_parts.prt-code:
     8038             create tt-marking-lines.
     8039             buffer-copy ub.marking-lines to tt-marking-lines.
     8040             find first ub.marking no-lock where ub.marking.mark = tt-marking-lines.mark no-error.
     8041             if available (ub.marking)
     8042             then do:
     8043               tt-marking-lines.sts = ub.marking.sts.
     8044               tt-marking-lines.stts = objSrv:Env:Marking:Sts:Mark:GetLabel(ub.marking.sts).
     8045               tt-marking-lines.box-qnty = ub.marking.box-qnty .
     8046               tt-marking-lines.unit = ub.marking.unit .
     8047               tt-marking-lines.unit-ext = ub.marking.unit-ext .
     8048               tt-marking-lines.doc-level = ub.marking-lines.doc-level.
     8049               tt-marking-lines.gds-name = ub.goods.gds-name.
     8050               tt-marking-lines.mark-parent = ub.marking.mark-parent.
     8051               if tt-marking-lines.doc-level = 2
     8052               then do:
     8053                 find first buf_marking-lines no-lock where ub.marking.mark-parent <> ""
     8054                   and buf_marking-lines.mark = ub.marking.mark-parent
     8055                   and buf_marking-lines.obj-type = bf_parts.obj-type
     8056                   and buf_marking-lines.obj-code = bf_parts.obj-code
     8057                   and buf_marking-lines.in-code = bf_parts.in-code
     8058                   and buf_marking-lines.out-code = bf_parts.out-code
     8059                   and buf_marking-lines.gds-code = ub.goods.gds-code
     8060                   and buf_marking-lines.part-code = bf_parts.part-code
     8061                   and buf_marking-lines.prt-code = bf_parts.prt-code no-error.
     8062                 if not available (buf_marking-lines)
     8063                 then do:
     8064                   find first tt-marking-lines no-lock where tt-marking-lines.mark = ub.marking.mark-parent
     8065                     no-error.
     8066                   if not available (tt-marking-lines )
     8067                   then do:
     8068                     find first buf_marking no-lock where buf_marking.mark = ub.marking.mark-parent.
     8069                     create tt-marking-lines.
     8070                     buffer-copy ub.marking-lines except ub.marking-lines.mark ub.marking-lines.sts to tt-marking-lines.
     8071                     tt-marking-lines.mark = buf_marking.mark.
     8072                     tt-marking-lines.sts = buf_marking.sts.
     8073                     tt-marking-lines.box-qnty = buf_marking.box-qnty .
     8074                     tt-marking-lines.unit = buf_marking.unit .
     8075                     tt-marking-lines.unit-ext = buf_marking.unit-ext .
     8076                     tt-marking-lines.doc-level = 1.
     8077                     tt-marking-lines.gds-name = ub.goods.gds-name.
     8078                     tt-marking-lines.mark-parent = buf_marking.mark-parent.
     8079                     tt-marking-lines.stts = objSrv:Env:Marking:Sts:Mark:GetLabel(buf_marking.sts).
     8080                   end.
     8081                 end.
     8082               end.
     8083             end.
     8084             else do:
     8085               if isMark(tt-marking-lines.mark) then
     8086                 message "Марка отсутсвует в справочнике марок - " + tt-marking-lines.mark view-as alert-box error.
     8087             end.
     8088           end.
     8089         end.
     8090         run str/mark_browse.w (input parparentproc, input-output table tt-marking-lines, input 'ПРОСМОТР':U, input "", input "", input "") .
     8091         for each tt-marking-lines:
     8092           delete tt-marking-lines.
     8093         end.
     8094       end.
     8095       otherwise do:
     8096         if not v-alcohol-prod
     8097         then do:
     8098           message "Товар не подлежит маркировке." view-as alert-box information title "Информация".
     8099           undo, return no-apply .
     8100         end.
     8101       end.
     8102     end case.
     8103     run ui-on in this-procedure ( input "line" ).
     8104   END.
     8105   ON CHOOSE OF b-renum IN FRAME d-in-doc
     8106   DO:
     8107     if lookup( self :type in frame d-in-doc, 'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW' ) <> 0 then do:   apply "ENTRY":U to self in frame d-in-doc .   if focus :handle <> self :handle in frame d-in-doc then do:     return no-apply .   end. end.
     8108     assign
     8109       line-rec = ( if available ub.doc-line then recid( ub.doc-line ) else ? )
     8110     .
     8111     run renum in this-procedure ( input t-doc.doc-code ).
     8112     sort-default = yes. OPEN QUERY br-dtl    FOR EACH  ub.doc-line WHERE  ub.doc-line.doc-code = t-doc.doc-code NO-LOCK,       EACH ub.goods WHERE ub.goods.artic =  ub.doc-line.artic                                       AND ub.goods.prod-code =  ub.doc-line.prod-code                                       AND ub.goods.prod-type =  ub.doc-line.prod-type NO-LOCK,       first ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK,       EACH ub.gds-obj outer-join WHERE ub.gds-obj.artic     =  ub.doc-line.artic                           AND ub.gds-obj.prod-code =  ub.doc-line.prod-code                           AND ub.gds-obj.prod-type =  ub.doc-line.prod-type                           AND ub.gds-obj.obj-type  = t-doc.obj-type                           AND ub.gds-obj.obj-code  = t-doc.obj-code NO-LOCK BY  ub.doc-line.line-num.
     8113     reposition br-dtl to recid line-rec no-error.
     8114   END.
