    17242         return error.
    17243       end.
    17244       run disp-import in this-procedure ( input vardoc-code ) no-error.
    17245       find first bf_trn-doc where bf_trn-doc.doc-code = vardoc-code.
    17246       delete bf_trn-doc.
    17247     end.
    17248     else do:
    17249       message "Данное действие недопустимо в статусе: "
    17250               t-doc.status_ string( t-doc.flag_, "+/-":U ) "."
    17251       view-as alert-box error.
    17252       return error.
    17253     end.
    17254   END PROCEDURE.
    17255   PROCEDURE local-mark :
    17256   if not available  ub.doc-line then do:
    17257       message "Неправильный выбор строки.".
    17258       return no-apply.
    17259     end.
    17260   define variable vss-include-info129 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    17261   define variable v-str-recid130 as character no-undo .
    17262   define variable v-num-entry130 as integer   no-undo .
    17263   assign
    17264     v-str-recid130 = trim( string( recid( ub.doc-line ) , "->>>>>>>>>>>9":U ) )
    17265     v-num-entry130 = lookup( v-str-recid130 , del-list )
    17266   .
    17267   if v-num-entry130 > 0 then do:
    17268     assign
    17269       entry( v-num-entry130, del-list ) = "":U
    17270       del-list = trim( replace( del-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
    17271     .
    17272   end.
    17273   else do:
    17274     assign
    17275       del-list = del-list + ( if del-list = "":U then "":U else chr(44) ) + v-str-recid130
    17276     .
    17277   end.
    17278     br-dtl:refresh() in frame d-in-doc .
    17279   END PROCEDURE.
    17280   PROCEDURE local-row-leave :
    17281   define variable var_is-petrol as logical no-undo .
    17282     define variable var_is-pieces as logical no-undo .
    17283   if available  ub.doc-line then do:
    17284   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
    17285     (
