    17433             message
    17434               vss-workfile vss-revision vss-description skip
    17435               "Ошибка при вызове процедуры doclinfq.p" skip
    17436               error-status :get-message(1) skip
    17437               return-value skip
    17438               view-as alert-box error .
    17439           end.
    17440           else do:
    17441             message
    17442               v-err-message
    17443               view-as alert-box information .
    17444           end.
    17445           display
    17446              ub.doc-line.fact-qnty
    17447             with browse br-dtl .
    17448           t-doc.flag_ = false.
    17449           return.
    17450         end.
    17451         t-doc.flag_ = false.
    17452       end.
    17453       do
    17454       on error undo, return error return-value
    17455       :
    17456         define buffer buf_doc-line for ub.doc-line .
    17457         find first buf_doc-line exclusive-lock where
    17458             recid( buf_doc-line ) = recid(  ub.doc-line ) .
    17459         assign
    17460           buf_doc-line.fact-qnty = decimal(  ub.doc-line.fact-qnty :screen-value in browse br-dtl )
    17461         .
    17462         find first buf_doc-line        no-lock where
    17463             recid( buf_doc-line ) = recid(  ub.doc-line ) .
    17464       end.
    17465       run ui-on in this-procedure
    17466         ( input "line"
    17467         ) .
    17468     end.
    17469   end.
    17470   END PROCEDURE.
    17471   PROCEDURE local-upd-inplnsum :
