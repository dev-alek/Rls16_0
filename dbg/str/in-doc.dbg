    10554   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
    10555     (input  'is-erpRN'
    10556     ,input  0
    10557     ,input  ''
    10558     ,input  0
    10559     ,input  ''
    10560     ,input  ''
    10561     ,input  ''
    10562     ,input  NO
    10563     ,output conf-par
    10564     ,output par-type
    10565     ) no-error .
    10566   if not error-status:error and conf-par = "yes":U then mode-erprn = yes.
    10567     else mode-erprn = no.
    10568   find ub.clients where ub.clients.obj-code = input frame d-in-doc t-doc.cli-code
    10569                  and ub.clients.obj-type = input frame d-in-doc t-doc.cli-type no-error.
    10570   if not available ub.clients then do:
    10571     if input frame d-in-doc t-doc.cli-code <> ? and input t-doc.cli-type <> ? then
    10572       message "Неправильный код или тип контрагента.".
    10573     apply "entry" to t-doc.cli-code in frame d-in-doc.
    10574     return error.
    10575   end.
