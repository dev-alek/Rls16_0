    17088     ) no-error .
    17089   varvat-type-int = 1 .
    17090   varslt-type-int = 3 .
    17091   v-not-ord = false .
    17092   v-back-date = false .
    17093   var-inp_sum  = false .
    17094   for each thbjattr_thbj-attr :
    17095       if thbjattr_thbj-attr.prop-code = 'type-vat' then varvat-type-int = thbjattr_thbj-attr.property-value-integer .
    17096       if thbjattr_thbj-attr.prop-code = 'type-slt' then varslt-type-int = thbjattr_thbj-attr.property-value-integer .
    17097       if thbjattr_thbj-attr.prop-code = 'inp_sum'  then var-inp_sum     = thbjattr_thbj-attr.property-value-logical .
    17098       if thbjattr_thbj-attr.prop-code = 'not-ord'  then v-not-ord       = thbjattr_thbj-attr.property-value-logical .
    17099       if thbjattr_thbj-attr.prop-code = 'back-date' then v-back-date    = thbjattr_thbj-attr.property-value-logical .
    17100       if thbjattr_thbj-attr.prop-code = 'inv-ship' then  inv-shipvalue  = thbjattr_thbj-attr.property-value-logical .
    17101   end.
