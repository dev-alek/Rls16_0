     2883   procedure placelib_write-attr:
     2884   define input  parameter p-code     like ub.place-attr.attr-code .
     2885   define input  parameter p-obj-code like ub.place-attr.obj-code .
     2886   define input  parameter p-obj-type like ub.place-attr.obj-type .
     2887   define input  parameter p-pl-code  like ub.place-attr.pl-code .
     2888   define input  parameter p-value    like ub.place-attr.attr-value .
     2889   define output parameter p-ok       as logical.
     2890   define buffer buf_place-attr for ub.place-attr .
     2891     do on error undo, return error return-value :
     2892        p-ok = false.
     2893        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     2894                                                   and buf_place-attr.obj-code    = p-obj-code
     2895                                                   and buf_place-attr.obj-type    = p-obj-type
     2896                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     2897        if not available buf_place-attr then do :
     2898           create buf_place-attr.
     2899           assign
     2900             buf_place-attr.attr-code   = p-code
     2901             buf_place-attr.attr-value  = p-value
     2902             buf_place-attr.obj-code    = p-obj-code
     2903             buf_place-attr.obj-type    = p-obj-type
     2904             buf_place-attr.pl-code     = p-pl-code
     2905           .
     2906           p-ok = true.
     2907        end.
     2908        else do:
     2909           buf_place-attr.attr-value  = p-value .
     2910           p-ok = true.
     2911        end.
     2912     end.
     2913   end.
     2914   procedure placelib_get-attr:
     2915   define input  parameter  p-code     like ub.place-attr.attr-code .
     2916   define input  parameter  p-obj-code like ub.place-attr.obj-code .
     2917   define input  parameter  p-obj-type like ub.place-attr.obj-type .
     2918   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
     2919   define output parameter  p-value    like ub.place-attr.attr-value .
     2920   define output parameter  p-ok       as logical.
     2921   define buffer buf_place-attr for ub.place-attr .
     2922     do on error undo, return error return-value :
     2923        p-ok = false.
     2924        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
     2925                                                   and buf_place-attr.obj-code    = p-obj-code
     2926                                                   and buf_place-attr.obj-type    = p-obj-type
     2927                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     2928        if available buf_place-attr then do :
     2929          p-value = buf_place-attr.attr-value.
     2930          p-ok = true.
     2931        end.
     2932        else do :
     2933          p-ok = false.
     2934        end.
     2935     end.
     2936   end.
     2937   procedure placelib_del-attr:
     2938   define input parameter  p-code     like ub.place-attr.attr-code .
     2939   define input parameter  p-obj-code like ub.place-attr.obj-code .
     2940   define input parameter  p-obj-type like ub.place-attr.obj-type .
     2941   define input parameter  p-pl-code  like ub.place-attr.pl-code .
     2942   define input parameter  p-value    like ub.place-attr.attr-value .
     2943   define output parameter p-ok       as logical.
     2944   define buffer buf_place-attr for ub.place-attr .
     2945     do on error undo, return error return-value :
     2946        p-ok = false.
     2947        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     2948                                                   and buf_place-attr.obj-code    = p-obj-code
     2949                                                   and buf_place-attr.obj-type    = p-obj-type
     2950                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     2951        if available buf_place-attr then do :
     2952           delete buf_place-attr.
     2953           p-ok = true.
     2954        end.
     2955     end.
     2956   end.
     2957       PROCEDURE cr-rvs-doc :
     2958         define input  parameter parparentproc as   handle              no-undo .
     2959         define input  parameter p-doc-code    like ub.trn-doc.doc-code no-undo .
     2960         tr:
     2961         do transaction
     2962         on error  undo, return error substitute( "&1 (cr-rvs-doc). &2&3&4", vss-include-info26, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2963         on stop   undo, return error substitute( "&1 (cr-rvs-doc). stop", vss-include-info26 )
     2964         on endkey undo, return error substitute( "&1 (cr-rvs-doc). endkey", vss-include-info26 )
     2965         :
     2966   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2967     define variable v-cntxt-db-num        as integer   no-undo .
     2968     define variable v-cntxt-userid        as character no-undo .
     2969     define variable v-cntxt-level         as character no-undo .
     2970     define variable v-cntxt-host-code-obj as integer   no-undo .
     2971     define variable v-cntxt-obj-type      as character no-undo .
     2972     define variable v-cntxt-obj-code      as integer   no-undo .
     2973     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2974     define variable v-cntxt-is-admin      as logical   no-undo .
     2975   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2976     run mainmenu_getcntxt in parparentproc
     2977       (output v-cntxt-db-num
     2978       ,output v-cntxt-userid
     2979       ,output v-cntxt-level
     2980       ,output v-cntxt-host-code-obj
     2981       ,output v-cntxt-obj-type
     2982       ,output v-cntxt-obj-code
     2983       ,output v-cntxt-db-num-obj
     2984       ,output v-cntxt-is-admin
     2985       ) .
     2986           define buffer buf_trn-doc    for ub.trn-doc .
     2987           define buffer buf_doc-line   for ub.doc-line .
     2988           define buffer buf_doc-line-attr for ub.doc-line-attr .
     2989           define buffer buf_goods      for ub.goods .
     2990           define buffer buf_place      for ub.place .
     2991           define buffer buf_rvs-doc    for ub.rvs-doc .
     2992           define buffer buf_rvs-line   for ub.rvs-line .
     2993           define buffer cur_shift-obj  for ub.shift-obj.
     2994           define buffer prev_shift-obj for ub.shift-obj.
     2995           define buffer prev_rvs-doc   for ub.rvs-doc.
     2996           define buffer prev_icnt-doc  for ub.icnt-doc.
     2997           define buffer buf_doc-pl     for ub.doc-pl.
     2998           define buffer sep_auto-tank-attr  for ub.auto-tank-attr.
     2999           define variable is-petrolium       as logical   no-undo .
     3000           define variable is-pieces          as logical   no-undo .
     3001           define variable v-ptrl-without-rvs as character no-undo .
     3002           define variable v-attr-type        as character no-undo .
     3003           define variable v-ptrl-avail       as logical   no-undo .
     3004           define variable v-doc-pl-avail     as logical   no-undo .
     3005           define variable v-today            as date      no-undo .
     3006           define variable v-value            as character no-undo .
     3007           define variable v-ok               as logical   no-undo .
     3008           define variable ii                 as integer   no-undo .
     3009           define variable v-kpsecs           as character no-undo .
     3010           define variable v-need-rvs-sec     as character no-undo .
     3011           define variable v-rvs-code         as character no-undo .
     3012           define variable v-no-need-main-rvs as logical   no-undo .
     3013           define variable choice             as integer   no-undo .
     3014           define variable varcar-num         as character no-undo .
     3015           define variable vartype            as character no-undo .
     3016           define variable varlog             as logical   no-undo .
     3017           define variable infoSectionsTotal as class ibs.th.str.InfoSectionsTotal no-undo .
     3018           define variable infoSecObj        as class ibs.th.str.InfoSection no-undo .
     3019           v-kpsecs = "" .
     3020           v-need-rvs-sec = "" .
     3021           find first buf_trn-doc
