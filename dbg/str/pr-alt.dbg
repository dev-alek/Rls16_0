     2810     run ref/gds-form.w ( input parParentProc
     2811                         ,input 'ПРОСМОТР':U
     2812                         ,input ?
     2813                         ,input ?
     2814                         ,input ?
     2815                         ,input-output gds-rec).
     2816     apply "entry" to br-alt in frame d-pr-alt.
     2817     return no-apply.
     2818   end.
     2819   on SHIFT-F9 of frame d-pr-alt anywhere do:
     2820     if not available goods then
     2821       return no-apply.
     2822     gds-rec = recid (goods).
     2823     run ref/gds-form.w ( input parParentProc
     2824                         ,input 'ПРОСМОТР':U
     2825                         ,input ?
     2826                         ,input ?
     2827                         ,input ?
     2828                         ,input-output gds-rec).
     2829     apply "entry" to br-alt in frame d-pr-alt.
     2830     return no-apply.
     2831   end.
