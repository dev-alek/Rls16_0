      217             v-cntxp-inout-price     = bf-cntxp_store.inout-price
      218             v-cntxp-unit-cli-perm   = bf-cntxp_store.unit-cli-perm
      219             v-cntxp-out-rate        = bf-cntxp_store.out-rate
      220             v-cntxp-out-line-discnt = bf-cntxp_store.out-line-discnt
      221             v-cntxp-in-ov           = bf-cntxp_store.in-ov
      222             v-cntxp-in-perm         = bf-cntxp_store.in-perm
      223             v-cntxp-no-eq           = bf-cntxp_store.no-eq
      224             v-cntxp-rsrv-time       = bf-cntxp_store.rsrv-time
      225             v-cntxp-load-time       = bf-cntxp_store.load-time
      226             v-cntxp-holidays        = bf-cntxp_store.holidays
      227             v-cntxp-in-pay          = bf-cntxp_store.in-pay
      228             v-cntxp-out-pay         = bf-cntxp_store.out-pay
      229             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
      230             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
      231             v-cntxp-down-pay        = bf-cntxp_store.down-pay
      232             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
      233             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
      234             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
      235             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
      236             .
      237         end.
      238         when 'маг':U then do:
      239           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
      240           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
      241           assign
      242             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_shop.doc-prt
      243             v-cntxp-price-calc      = bf-cntxp_shop.price-calc
      244             v-cntxp-inout-price     = bf-cntxp_shop.inout-price
      245             v-cntxp-unit-cli-perm   = bf-cntxp_shop.unit-cli-perm
      246             v-cntxp-out-rate        = bf-cntxp_shop.out-rate
      247             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
      248             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
      249             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
      250             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
      251             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
      252             v-cntxp-load-time       = bf-cntxp_shop.load-time
      253             v-cntxp-holidays        = bf-cntxp_shop.holidays
      254             v-cntxp-in-pay          = bf-cntxp_shop.in-pay
      255             v-cntxp-out-pay         = bf-cntxp_shop.out-pay
      256             v-cntxp-ret-pay         = bf-cntxp_shop.ret-pay
      257             v-cntxp-ret-sup-pay     = bf-cntxp_shop.ret-sup-pay
      258             v-cntxp-down-pay        = bf-cntxp_shop.down-pay
      259             v-cntxp-inv-pay         = bf-cntxp_shop.inv-pay
      260             v-cntxp-chk-pay         = bf-cntxp_shop.chk-pay
      261             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
      262             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
      263             .
      264         end.
      265       end case.
      266     end.
