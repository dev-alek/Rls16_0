     2871   end.
     2872   on value-changed of a-n-c in frame d-pr-alt do:
     2873     run proc-valchg-a-n-c in this-procedure  no-error.
     2874     return no-apply.
     2875   end.
     2876   on any-printable of br-alt in frame d-pr-alt do:
     2877     run proc-any-printable-br-alt in this-procedure   no-error.
     2878     return no-apply.
     2879   end.
     2880   on backspace of br-alt in frame d-pr-alt do:
     2881     run proc-backspace-br-alt in this-procedure   no-error.
     2882     return no-apply.
     2883   end.
     2884   ON return OF loc-code IN FRAME d-pr-alt do:
     2885     run proc-mouse-dbl-click-loc-code in this-procedure   no-error.
     2886     return no-apply.
     2887   end.
     2888   ON return, Ctrl-J OF loc-name IN FRAME d-pr-alt do:
     2889     run proc-mouse-dbl-click-loc-name in this-procedure   no-error.
     2890     return no-apply.
     2891   end.
     2892   PROCEDURE proc-valchg-a-n-c:
     2893     case input frame d-pr-alt a-n-c :
     2894       when "art" then do:
     2895         apply "entry" to br-alt in frame d-pr-alt.
     2896         hide loc-name loc-code
     2897         in frame d-pr-alt.
     2898         loc-art = "".
     2899       end.
     2900       when "name" then do:
     2901         enable loc-name with frame d-pr-alt.
     2902         disp loc-name with frame d-pr-alt.
     2903         hide loc-art loc-code
     2904         in frame d-pr-alt.
     2905         apply "entry" to loc-name in frame d-pr-alt.
     2906       end.
     2907       when "code"
     2908    or when "DataMatrix" then
     2909       do:
     2910         enable loc-code with frame d-pr-alt.
     2911         disp loc-code with frame d-pr-alt.
     2912         hide loc-art loc-name
     2913         in frame d-pr-alt.
     2914         apply "entry" to loc-code in frame d-pr-alt.
     2915       end.
     2916     end CASE.
     2917   END PROCEDURE.
     2918   PROCEDURE proc-any-printable-br-alt :
     2919     if input frame d-pr-alt a-n-c = "art" then do:
     2920       if last-event:label = " " and
     2921          loc-art = "" then
     2922       return error.
     2923       find first l-price-list where
     2924                  l-price-list.doc-num = price-doc.doc-num and l-price-list.artic begins (loc-art + last-event:label)
     2925                  no-lock no-error.
     2926       if available l-price-list then do:
     2927         loc-art = loc-art + last-event:label.
     2928         disp loc-art with frame d-pr-alt.
     2929         code-rec = recid (l-price-list).
     2930         reposition br-alt to recid code-rec no-error.
     2931       end.
     2932     end.
     2933   END PROCEDURE.
     2934   PROCEDURE proc-backspace-br-alt:
     2935     if input frame d-pr-alt a-n-c = "art" then do:
     2936       if loc-art = "" then
     2937         return error.
     2938       loc-art = substr (loc-art, 1, length (loc-art) - 1).
     2939       find first l-price-list where
     2940                  l-price-list.doc-num = price-doc.doc-num and l-price-list.artic begins loc-art
     2941                  no-lock.
     2942       disp loc-art with frame d-pr-alt.
     2943       code-rec = recid (l-price-list).
     2944       reposition br-alt to recid code-rec no-error.
     2945     end.
     2946   END PROCEDURE.
     2947   PROCEDURE proc-mouse-dbl-click-loc-code:
     2948   def var str-code as integer no-undo.
     2949   define variable varresult   as character         no-undo.
     2950   define variable vartype-bc  as character         no-undo.
     2951   define variable varweight   as decimal           no-undo.
     2952   define buffer l-goods for ub.goods.
     2953   define buffer l-bar-code for ub.bar-code.
     2954   define buffer buf_bar-code for ub.bar-code .
     2955   define buffer buf_prod-bc for ub.prod-bc.
     2956   define buffer buf_place for ub.place.
     2957     assign
     2958     frame d-pr-alt
     2959     loc-code
     2960     a-n-c.
     2961     if a-n-c = "datamatrix"
     2962     then do:
     2963   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_dm-rcnz in g#libbcrcn
     2964   (
     2965    input  parparentproc
     2966   ,input  loc-code
     2967   ,input  ?
     2968   ,input  price-list.obj-type
     2969   ,input  price-list.obj-code
     2970   ,input  yes
     2971   ,input  no
     2972   ,input  varscales-pref44
     2973   ,input  varpgscales-pref44
     2974   ,output varresult
     2975   ,output vartype-bc
     2976   ,output varweight
     2977   ,buffer buf_bar-code
     2978   ,buffer buf_prod-bc
     2979   ,buffer buf_place
     2980   ) no-error.
     2981        if varresult eq "prod-bc"
     2982        then
     2983           loc-code:screen-value in frame d-pr-alt = buf_prod-bc.b-str.
     2984     end.
     2985     else do:
     2986   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     2987   (
     2988    input  parparentproc
     2989   ,input  loc-code
     2990   ,input  ?
     2991   ,input  price-list.obj-type
     2992   ,input  price-list.obj-code
     2993   ,input  yes
     2994   ,input  no
     2995   ,input  varscales-pref44
     2996   ,input  varpgscales-pref44
     2997   ,output varresult
     2998   ,output vartype-bc
     2999   ,output varweight
     3000   ,buffer buf_bar-code
     3001   ,buffer buf_prod-bc
     3002   ,buffer buf_place
     3003   ) no-error.
     3004   end.
     3005     if available buf_bar-code then do:
     3006           find first l-goods where
     3007                     l-goods.gds-code =
     3008     buf_bar-code.gds-code No-LOCK.
     3009           find first l-price-list where l-price-list.doc-num = price-doc.doc-num and
     3010                     l-price-list.artic = l-goods.artic AND
     3011                     l-price-list.prod-type = l-goods.prod-type AND
     3012                     l-price-list.prod-code = l-goods.prod-code no-lock no-error.
     3013       if available l-price-list then do:
     3014         code-rec = recid (l-price-list).
     3015         reposition br-alt to recid code-rec no-error.
     3016       end.
     3017       else do:
     3018         message "Строка не найдена."
     3019                 view-as alert-box error.
     3020       end.
     3021     end.
     3022     else
     3023       message "Бар-код не найден."
     3024               view-as alert-box error.
     3025     apply "entry" to loc-code in frame d-pr-alt.
     3026   END PROCEDURE.
     3027   PROCEDURE  proc-mouse-dbl-click-loc-name:
     3028     assign
     3029     frame d-pr-alt
     3030     loc-name.
     3031       if last-event:label = "Ctrl-J" then
     3032         find next l-price-list where l-price-list.doc-num = price-doc.doc-num and
     3033                   can-find (ub.goods where ub.goods.artic = l-price-list.artic and
     3034                   ub.goods.prod-type = l-price-list.prod-type and
     3035                   ub.goods.prod-code = l-price-list.prod-code and
     3036                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     3037       else
     3038         find first l-price-list where l-price-list.doc-num = price-doc.doc-num and
     3039                   can-find (ub.goods where ub.goods.artic = l-price-list.artic and
     3040                   ub.goods.prod-type = l-price-list.prod-type and
     3041                   ub.goods.prod-code = l-price-list.prod-code and
     3042                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     3043       if available l-price-list then do:
     3044         code-rec = recid (l-price-list).
     3045         reposition br-alt to recid code-rec no-error.
     3046       end.
     3047       else do:
     3048         message "Строка не найдена."
     3049                 view-as alert-box error.
     3050       end.
     3051     apply "entry" to loc-name in frame d-pr-alt.
     3052   END PROCEDURE.
     3053   on value-changed of br-alt in frame d-pr-alt do:
     3054   if not available ub.price-list or recid (ub.price-list) <> code-rec then do:
     3055       hide loc-art in frame d-pr-alt.
     3056       loc-art = "".
     3057   end.
     3058   end.
     3059   ON find OF goods DO: END.
     3060   ON find OF gds-obj DO: END.
     3061   on end-error of price-list.price-sale, price-list.road-tax, price-list.excise in browse br-alt do:
     3062     disp fnc-mark (price-list.b-code)   @ mark                 COLUMN-LABEL '*'  FORMAT "x(1)" if gds-prt.upper-code = goods.prt-root then         if bar-code.in-code = '' then           'ТОВАР':U         else           'ПАРТИЯ':U       else         'ПРИЗНАК':U   @ calc-dtl             COLUMN-LABEL 'Тип'  FORMAT "x(3)" fnc-main-code (price-list.b-code)   @ main-bc-br           COLUMN-LABEL 'Глав. код'  fnc-base-code (price-list.b-code)   @ base-bc-br           COLUMN-LABEL 'Осн. код'  bar-code.b-code                          COLUMN-LABEL 'Код'  fnc-base-price (price-list.b-code, price-list.doc-num)   @ arg-base             COLUMN-LABEL 'Осн. цена'  goods.unit-base                          COLUMN-LABEL 'Изм'  FORMAT "x(3)"  bar-code.cli-base-rate                          COLUMN-LABEL 'Коэф'  price-list.d-pcnt                          COLUMN-LABEL 'Скидка'  price-list.price-sale                         COLUMN-LABEL 'Цена'  bar-code.unit-cli                         COLUMN-LABEL 'Изм' FORMAT "x(3)"  price-list.road-tax                          price-list.excise                         COLUMN-LABEL 'Акциз' with browse br-alt.
     3063     return no-apply.
     3064   end.
     3065   ON MOUSE-SELECT-DBLCLICK, return OF br-alt IN FRAME d-pr-alt DO:
     3066   apply "choose" to b-mark in frame d-pr-alt.
     3067   END.
     3068   ON CHOOSE OF b-mark IN FRAME d-pr-alt
     3069   DO:
     3070   define variable vss-include-info46 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3071   if lookup(self :type
     3072            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3073            ) = 0
     3074   then do:
     3075     message
     3076       "$Workfile$"
     3077       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3078       "Интерфейсный элемент" self :name  skip
     3079       "Тип" self :type  skip
     3080       "Процедура" this-procedure :file-name skip
     3081       view-as alert-box .
     3082   end.
     3083   else do:
     3084     apply "entry":u to self  .
     3085     if focus :handle <> self :handle  then do:
     3086       return no-apply .
     3087     end.
     3088   end.
     3089   if not available price-list then
     3090     return no-apply.
     3091   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3092   define variable v-str-recid48 as character no-undo .
     3093   define variable v-num-entry48 as integer   no-undo .
     3094   assign
     3095     v-str-recid48 = trim( string( recid( price-list ) , "->>>>>>>>>>>9":U ) )
     3096     v-num-entry48 = lookup( v-str-recid48 , mark-list )
     3097   .
     3098   if v-num-entry48 > 0 then do:
     3099     assign
     3100       entry( v-num-entry48, mark-list ) = "":U
     3101       mark-list = trim( replace( mark-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     3102     .
     3103   end.
     3104   else do:
     3105     assign
     3106       mark-list = mark-list + ( if mark-list = "":U then "":U else chr(44) ) + v-str-recid48
     3107     .
     3108   end.
     3109   br-alt :refresh ().
     3110   if last-event :function <> "mouse-select-dblclick" then
     3111     br-alt :select-next-row ().
     3112   apply "entry" to br-alt in frame d-pr-alt.
     3113   END.
     3114   on row-display of br-alt do:
     3115     if sort-column-name <> "calc-dtl"  then
     3116       if gds-prt.upper-code = goods.prt-root then
     3117         if bar-code.in-code = '' then
     3118           calc-dtl :fgcolor in browse br-alt = BLACK_COLOR.
     3119         else
     3120           calc-dtl :fgcolor in browse br-alt = BLUE_COLOR.
     3121       else
     3122         calc-dtl :fgcolor in browse br-alt = DARK_GREEN_COLOR.
     3123   end.
     3124   on value-changed of br-alt in frame d-pr-alt do:
     3125     if not available price-list then do:
     3126       hide calc-price
     3127            price-list.price-sale
     3128            goods.artic
     3129            goods.gds-name
     3130            goods.prod-type
     3131            goods.prod-code
     3132            clients.obj-name
     3133            gds-prt.f-name
     3134            bar-code.in-code
     3135            bar-code.part-code in frame d-pr-alt.
     3136       return no-apply.
     3137     end.
     3138     if doc-mode = 'ИЗМЕНЕНИЕ':U then do:
     3139       calc-price = fnc-base-price (bar-code.b-code, price-list.doc-num) *
     3140                   bar-code.cli-base-rate *
     3141                   (1 - price-list.d-pcnt / 100)
     3142                   .
     3143   case input frame d-pr-alt round-method :
     3144     when '9-окончание':U then do:
     3145       if calc-price < 29 then do:
     3146         if (calc-price - truncate (calc-price, 0)) <> 0 then do:
     3147           assign
     3148             calc-price = truncate (calc-price, 0) + 1
     3149           .
     3150         end.
     3151       end.
     3152       else do:
     3153         if (calc-price modulo 10) < 3 then do:
     3154           assign
     3155             calc-price = (calc-price - (calc-price modulo 100))
     3156                 + ( truncate (((calc-price modulo 100) / 10), 0)
     3157                   - 1 ) * 10
     3158                 + 9
     3159           .
     3160         end.
     3161         else do:
     3162           assign
     3163             calc-price = (calc-price - (calc-price modulo 100))
     3164                 + ( truncate (((calc-price modulo 100) / 10), 0)
     3165                   ) * 10
     3166                 + 9
     3167           .
     3168         end.
     3169         assign
     3170           calc-price = round (calc-price, 0)
     3171         .
     3172       end.
     3173     end.
     3174     when '9-99окончание':U then do:
     3175       if calc-price < input frame d-pr-alt round-base then do:
     3176         assign
     3177           calc-price = truncate (calc-price, 0) + 0.99
     3178         .
     3179       end.
     3180       else do:
     3181         assign
     3182           calc-price = truncate (calc-price / 10 , 0) * 10 + 9.99
     3183         .
     3184       end.
     3185     end.
     3186     when 'Без-дробных':U then do:
     3187       assign
     3188         calc-price = round (calc-price, 0)
     3189       .
     3190     end.
     3191     when 'Произвольно':U then do:
     3192       if input frame d-pr-alt round-base <> 0 then do:
     3193         assign
     3194           calc-price = round (calc-price / input frame d-pr-alt round-base, 0) * input frame d-pr-alt round-base
     3195         .
     3196         if calc-price = 0 then do:
     3197           assign
     3198             calc-price = input frame d-pr-alt round-base
     3199           .
     3200         end.
     3201       end.
     3202     end.
     3203     when 'Вверх':U then do:
     3204       if input frame d-pr-alt round-base <> 0 then do:
     3205         if truncate ( calc-price / input frame d-pr-alt round-base, 0 ) <> (calc-price / input frame d-pr-alt round-base) then do:
     3206           assign
     3207             calc-price = truncate (calc-price / input frame d-pr-alt round-base, 0) * input frame d-pr-alt round-base + input frame d-pr-alt round-base
     3208           .
     3209         end.
     3210       end.
     3211       if calc-price = 0 then do:
     3212         assign
     3213           calc-price = input frame d-pr-alt round-base
     3214         .
     3215       end.
     3216     end.
     3217     when 'Коэффициент':U then do:
     3218       if input frame d-pr-alt round-base <> 0 then do:
     3219         assign
     3220           calc-price = calc-price * input frame d-pr-alt round-base
     3221         .
     3222       end.
     3223     end.
     3224     when 'Отключено':U then do:
     3225     end.
     3226     otherwise do:
     3227       message
     3228         vss-workfile vss-revision vss-description skip
     3229         "Неизвестный метод округления продажной цены" skip
     3230         "round-method" input frame d-pr-alt round-method skip
     3231         "round-base"   input frame d-pr-alt round-base   skip
     3232         "price"        calc-price             skip
     3233         view-as alert-box error .
     3234     end.
     3235   end.
     3236       disp calc-price with frame d-pr-alt.
     3237     end.
     3238     else
     3239       hide calc-price in frame d-pr-alt.
     3240     find clients no-lock where
     3241          clients.obj-type = goods.prod-type and
     3242          clients.obj-code = goods.prod-code.
     3243     disp price-list.price-sale
     3244          goods.artic
     3245          goods.gds-name
     3246          goods.prod-type
     3247          goods.prod-code
     3248          clients.obj-name with frame d-pr-alt.
     3249     if gds-prt.upper-code = goods.prt-root then
     3250       hide gds-prt.f-name in frame d-pr-alt.
     3251     else
     3252       disp gds-prt.f-name with frame d-pr-alt.
     3253     if bar-code.in-code = "" then
     3254       hide bar-code.in-code bar-code.part-code in frame d-pr-alt.
     3255     else
     3256       disp bar-code.in-code bar-code.part-code with frame d-pr-alt.
     3257   end.
     3258   on leave of price-list.price-sale in browse br-alt or
     3259      leave of price-list.d-pcnt     in browse br-alt or
     3260      leave of price-list.road-tax   in browse br-alt or
     3261      leave of price-list.excise     in browse br-alt do:
     3262     if not available price-list then
     3263       return.
     3264     if decimal  (price-list.price-sale :screen-value in browse br-alt) <> price-list.price-sale or
     3265        decimal  (price-list.d-pcnt     :screen-value in browse br-alt) <> price-list.d-pcnt or
     3266        decimal  (price-list.road-tax   :screen-value in browse br-alt) <> price-list.road-tax or
     3267        decimal  (price-list.excise     :screen-value in browse br-alt) <> price-list.excise then do:
     3268       g#log = yes.
     3269       message "Строка изменена. Записать это изменение?"
     3270               view-as alert-box question buttons YES-NO update g#log.
     3271       if g#log then
     3272         run upd-br-field.
     3273     end.
     3274     disp fnc-mark (price-list.b-code)   @ mark                 COLUMN-LABEL '*'  FORMAT "x(1)" if gds-prt.upper-code = goods.prt-root then         if bar-code.in-code = '' then           'ТОВАР':U         else           'ПАРТИЯ':U       else         'ПРИЗНАК':U   @ calc-dtl             COLUMN-LABEL 'Тип'  FORMAT "x(3)" fnc-main-code (price-list.b-code)   @ main-bc-br           COLUMN-LABEL 'Глав. код'  fnc-base-code (price-list.b-code)   @ base-bc-br           COLUMN-LABEL 'Осн. код'  bar-code.b-code                          COLUMN-LABEL 'Код'  fnc-base-price (price-list.b-code, price-list.doc-num)   @ arg-base             COLUMN-LABEL 'Осн. цена'  goods.unit-base                          COLUMN-LABEL 'Изм'  FORMAT "x(3)"  bar-code.cli-base-rate                          COLUMN-LABEL 'Коэф'  price-list.d-pcnt                          COLUMN-LABEL 'Скидка'  price-list.price-sale                         COLUMN-LABEL 'Цена'  bar-code.unit-cli                         COLUMN-LABEL 'Изм' FORMAT "x(3)"  price-list.road-tax                          price-list.excise                         COLUMN-LABEL 'Акциз' with browse br-alt.
     3275     apply "value-changed" to br-alt in frame d-pr-alt.
     3276   end.
     3277   on return of price-list.price-sale in browse br-alt or
     3278      return of price-list.d-pcnt     in browse br-alt or
     3279      return of price-list.road-tax   in browse br-alt or
     3280      return of price-list.excise     in browse br-alt do:
     3281     if decimal  (price-list.price-sale :screen-value in browse br-alt) <> price-list.price-sale or
     3282        decimal  (price-list.d-pcnt     :screen-value in browse br-alt) <> price-list.d-pcnt or
     3283        decimal  (price-list.road-tax   :screen-value in browse br-alt) <> price-list.road-tax or
     3284        decimal  (price-list.excise     :screen-value in browse br-alt) <> price-list.excise then
     3285       run upd-br-field.
     3286     disp fnc-mark (price-list.b-code)   @ mark                 COLUMN-LABEL '*'  FORMAT "x(1)" if gds-prt.upper-code = goods.prt-root then         if bar-code.in-code = '' then           'ТОВАР':U         else           'ПАРТИЯ':U       else         'ПРИЗНАК':U   @ calc-dtl             COLUMN-LABEL 'Тип'  FORMAT "x(3)" fnc-main-code (price-list.b-code)   @ main-bc-br           COLUMN-LABEL 'Глав. код'  fnc-base-code (price-list.b-code)   @ base-bc-br           COLUMN-LABEL 'Осн. код'  bar-code.b-code                          COLUMN-LABEL 'Код'  fnc-base-price (price-list.b-code, price-list.doc-num)   @ arg-base             COLUMN-LABEL 'Осн. цена'  goods.unit-base                          COLUMN-LABEL 'Изм'  FORMAT "x(3)"  bar-code.cli-base-rate                          COLUMN-LABEL 'Коэф'  price-list.d-pcnt                          COLUMN-LABEL 'Скидка'  price-list.price-sale                         COLUMN-LABEL 'Цена'  bar-code.unit-cli                         COLUMN-LABEL 'Изм' FORMAT "x(3)"  price-list.road-tax                          price-list.excise                         COLUMN-LABEL 'Акциз' with browse br-alt.
     3287     apply "value-changed" to br-alt in frame d-pr-alt.
     3288   end.
