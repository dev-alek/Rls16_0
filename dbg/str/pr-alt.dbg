      285   define new global shared variable g#libbcrcn as handle no-undo .
      286   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      287   procedure check-use-bar-code :
      288     define input  parameter p-b-code    like ub.bar-code.b-code no-undo .
      289     do
      290     on error  undo, return error substitute( "&1. &2&3&4", vss-include-info5, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      291     on stop   undo, return error substitute( "&1. stop", vss-include-info5 )
      292     on endkey undo, return error substitute( "&1. endkey", vss-include-info5 )
      293     :
      294       define buffer buf_bar-code for ub.bar-code .
      295       find first buf_bar-code no-lock
      296         where buf_bar-code.b-code     = p-b-code
      297         no-error .
      298       if not available buf_bar-code then do:
      299         return error substitute( "&1 (check-use-bar-code). Не найден бар-код &2", vss-include-info5, p-b-code ) .
      300       end.
      301       if buf_bar-code.stts = integer('99':U) then do:
      302         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
      303                                 + "Выполняется удаление бар-кода"
      304                                 ,vss-include-info5
      305                                 ,p-b-code
      306                                 ,chr(10)
      307                               ) .
      308       end.
      309       if buf_bar-code.stts = integer('79':U) then do:
      310         return error substitute( "&1 (check-use-bar-code). Нельзя использовать бар-код &2&3"
      311                                 + "Бар-код выключен"
      312                                 ,vss-include-info5
      313                                 ,p-b-code
      314                                 ,chr(10)
      315                               ) .
      316       end.
      317       return .
      318     end.
      319   end procedure.
      320   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      321   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      322   procedure fltopend_fltopend :
      323   define input parameter p-parent-handle as handle no-undo .
      324   define input parameter p-qh as handle no-undo .
      325   define input parameter p-flt-open-open-query  as character no-undo .
      326   define input parameter p-where-cond as character no-undo .
      327   define input parameter p-use-indFIRST-query-tail as character no-undo .
      328   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      329   define input parameter p-indexed-reposition as character no-undo .
      330     do
      331     on error undo, return error
      332     :
      333   define variable v-prepare-string as character no-undo .
      334   define variable glog as logical no-undo .
      335   assign
      336   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      337                      p-where-cond + chr(32)  +
      338                      p-use-indFIRST-query-tail + chr(32) +
      339                      p-use-ind-sort-clmn-by + chr(32) +
      340                      p-indexed-reposition
      341   .
      342   assign
      343   glog = p-qh:query-prepare(v-prepare-string) no-error .
      344   if not glog
      345   or error-status:error then do:
      346     message error-status:get-message(1) view-as alert-box .
      347     undo, return error .
      348   end.
      349   assign
      350   glog = p-qh:query-open no-error .
      351   if not glog
      352   or error-status:error then do:
      353     message error-status:get-message(1) view-as alert-box .
      354     undo, return error .
      355   end.
      356     end.
      357   end procedure.
      358   procedure fltopend_fltfindd :
      359   define input parameter p-parent-handle as handle no-undo .
      360   define input parameter p-qh as handle no-undo .
      361   define input parameter p-rowid as rowid no-undo .
      362   define input parameter p-next as logical no-undo .
      363   define input parameter p-lock as integer no-undo .
      364   define input parameter p-bh as handle no-undo .
      365   define input parameter p-where-cond as character no-undo .
      366   define input parameter p-use-index-phrase as character no-undo .
      367   define variable glog as logical no-undo .
      368   define variable v-qh as handle no-undo .
      369   define variable v-bh as handle no-undo .
      370   define variable v-recid as recid no-undo .
      371   define variable v-prepare-string as character no-undo .
      372   do
      373   on error undo, return error
      374   on stop undo, return error
      375   :
      376     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      377     create buffer v-bh for table p-bh buffer-name p-bh:name.
      378     create query v-qh.
      379     v-qh:set-buffers(v-bh).
      380     v-prepare-string = substitute("for each &1 &2 &3"
      381                                     ,v-bh:name
      382                                     ,p-where-cond
      383                                     ,p-use-index-phrase).
      384     glog = v-qh:query-prepare(v-prepare-string) no-error.
      385     if not glog then do:
      386       delete object v-qh.
      387       delete object v-bh.
      388       undo, return error .
      389     end.
      390     glog = v-qh:query-open no-error .
      391     if not glog then do:
      392       delete object v-qh.
      393       delete object v-bh.
      394       undo, return error .
      395     end.
      396     if p-next then do:
      397       v-qh:reposition-to-rowid(p-rowid) no-error .
      398       glog = v-qh:get-next( p-lock) no-error .
      399       glog = v-qh:get-next( p-lock) no-error .
      400       if not glog or v-qh:query-off-end = yes then do:
      401         glog = v-qh:get-first( p-lock) no-error .
      402       end.
      403     end.
      404     else do:
      405       glog = v-qh:get-first( p-lock) no-error .
      406     end.
      407     v-recid = v-bh:recid no-error .
      408     delete object v-qh.
      409     delete object v-bh.
      410     return string(v-recid) .
      411   end.
      412   end procedure.
      413   procedure fltopend_fltfindq :
      414   define input parameter p-parent-handle as handle no-undo .
      415   define input parameter p-qh as handle no-undo .
      416   define input parameter p-next as logical no-undo .
      417   define input parameter p-lock as integer no-undo .
      418   define input parameter p-flt-open-open-query  as character no-undo .
      419   define input parameter p-where-cond as character no-undo .
      420   define input parameter p-use-indFIRST-query-tail as character no-undo .
      421   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      422   define input parameter p-indexed-reposition as character no-undo .
      423   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      424   define variable glog as logical no-undo .
      425   define variable v-qh as handle no-undo .
      426   define variable v-bh as handle no-undo extent 18.
      427   define variable v-rowid as rowid no-undo extent 18.
      428   define variable v-ii as integer no-undo .
      429   define variable v-prepare-string as character no-undo .
      430   do
      431   on error undo, return error
      432   on stop undo, return error
      433   :
      434     create query v-qh.
      435     do v-ii = 1 to p-qh:num-buffers:
      436       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      437       assign
      438       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      439       no-error.
      440       v-qh:add-buffer(v-bh[v-ii]).
      441     end.
      442     assign
      443     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      444                       p-where-cond + chr(32)  +
      445                       p-use-indFIRST-query-tail + chr(32) +
      446                       p-use-ind-sort-clmn-by + chr(32) +
      447                       p-indexed-reposition
      448     .
      449     glog = v-qh:query-prepare( v-prepare-string) no-error .
      450     if not glog then do:
      451       delete object v-qh.
      452       do v-ii = 1 to p-qh:num-buffers:
      453         delete object v-bh[v-ii].
      454       end.
      455       undo, return error .
      456     end.
      457     glog = v-qh:query-open no-error .
      458     if not glog then do:
      459       delete object v-qh.
      460       do v-ii = 1 to p-qh:num-buffers:
      461         delete object v-bh[v-ii].
      462       end.
      463       undo, return error .
      464     end.
      465     if p-next then do:
      466       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      467       glog = v-qh:get-next( p-lock) no-error .
      468       glog = v-qh:get-next( p-lock) no-error .
      469       if not glog or v-qh:query-off-end = yes then do:
      470         glog = v-qh:get-first( p-lock) no-error .
      471       end.
      472     end.
      473     else do:
      474       glog = v-qh:get-first( p-lock) no-error .
      475     end.
      476     do v-ii = 1 to p-qh:num-buffers:
      477       assign
      478       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      479       no-error.
      480     end.
      481     delete object v-qh.
      482     do v-ii = 1 to p-qh:num-buffers:
      483       delete object v-bh[v-ii].
      484     end.
      485   end.
      486   end procedure.
      487   define buffer l-price-list for price-list.
      488   define variable   rdtaxcdvalue  as character initial ? no-undo.
      489   define variable   rdtaxcdtype   as character initial ? no-undo.
      490   define buffer     rt_tax            for tax.
      491   define variable dor-nal as character no-undo .
      492   define variable g#log as logical   no-undo .
      493   define variable gds-rec as recid no-undo .
      494   define variable rep-rec as recid no-undo .
      495   define variable ref-rec as recid no-undo .
      496   define new shared buffer price-list for price-list.
      497   define new shared buffer bar-code   for bar-code.
      498   define new shared buffer goods      for goods.
      499   define new shared buffer gds-prt    for gds-prt.
      500   define new shared QUERY br-alt FOR price-list except, bar-code, goods, gds-prt SCROLLING.
      501   define variable sort-column-name as character no-undo .
      502   FUNCTION fnc-mark RETURN char (local-bc as integer).
      503   define buffer local-price-list for price-list.
      504     find local-price-list no-lock where
      505          local-price-list.b-code = local-bc and
      506          local-price-list.doc-num = price-doc.doc-num and
      507          local-price-list.price-type = "" no-error.
      508     if not available local-price-list then
      509       return (?).
      510     if lookup (string (recid (local-price-list)), mark-list) > 0 then
      511       return "*".
      512     else
      513       return "".
      514   END FUNCTION.
      515   FUNCTION fnc-main-code RETURN integer (local-bc as integer).
      516   define variable local-main-code like bar-code.b-code no-undo.
      517   run prc-main-code (input local-bc, output local-main-code).
      518   return (local-main-code).
      519   END FUNCTION.
      520   FUNCTION fnc-base-code RETURN integer (local-bc as integer).
      521   define variable local-base-code like bar-code.b-code no-undo.
      522   run prc-base-code (input local-bc, output local-base-code).
      523   return (local-base-code).
      524   END FUNCTION.
      525   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      526   FUNCTION fnc-base-price RETURN decimal (local-bc      as integer,
      527                                           local-doc-num as char).
      528   define buffer base-price        for ub.price-list.
      529   define variable local-main-code like ub.bar-code.b-code no-undo.
      530   define variable local-base-code like ub.bar-code.b-code no-undo.
      531     run prc-base-code (input local-bc, output local-base-code).
      532     find base-price no-lock where
      533          base-price.doc-num = local-doc-num and
      534          base-price.b-code  = local-base-code and
      535          base-price.price-type = "" no-error.
      536     if not available base-price then do:
      537       run prc-main-code (input local-bc, output local-main-code).
      538       find  base-price no-lock where
      539             base-price.doc-num = local-doc-num and
      540             base-price.b-code  = local-main-code and
      541             base-price.price-type = "" no-error.
      542     end.
      543     if available base-price then
      544       return (base-price.price-sale).
      545     else
      546       return (?).
      547   END FUNCTION.
      548   procedure prc-main-code:
      549   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
      550   define output parameter local-main-code like ub.bar-code.b-code no-undo.
      551   define buffer local-bar-code        for ub.bar-code.
      552   define buffer local-goods           for ub.goods.
      553   define buffer main-code             for ub.bar-code.
      554   define buffer main-prt              for ub.gds-prt.
      555     local-main-code = ?.
      556     find local-bar-code no-lock where
      557          local-bar-code.b-code = local-bc no-error.
      558     if not available local-bar-code then
      559       return.
      560     find local-goods no-lock where
      561          local-goods.gds-code = local-bar-code.gds-code.
      562     find first  main-prt no-lock where
      563                 main-prt.upper-code = local-goods.prt-root.
      564     find  main-code no-lock where
      565           main-code.gds-code  = local-bar-code.gds-code and
      566           main-code.in-code   = "" and
      567           main-code.part-code = "" and
      568           main-code.unit-cli  = local-goods.unit-base and
      569           main-code.node-code = main-prt.node-code.
      570     local-main-code = main-code.b-code.
      571   end procedure.
      572   procedure prc-base-code:
      573   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
      574   define output parameter local-base-code like ub.bar-code.b-code no-undo.
      575   define buffer local-bar-code for ub.bar-code.
      576   define buffer local-goods    for ub.goods.
      577   define buffer base-code      for ub.bar-code.
      578     local-base-code = ?.
      579     find local-bar-code no-lock where
      580          local-bar-code.b-code = local-bc no-error.
      581     if not available local-bar-code then
      582       return.
      583     find local-goods no-lock where
      584          local-goods.gds-code = local-bar-code.gds-code.
      585     find base-code no-lock where
      586          base-code.gds-code  = local-bar-code.gds-code and
      587          base-code.node-code = local-bar-code.node-code and
      588          base-code.in-code   = local-bar-code.in-code and
      589          base-code.part-code = local-bar-code.part-code and
      590          base-code.unit-cli  = local-goods.unit-base.
      591     local-base-code = base-code.b-code.
      592   end procedure.
      593   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      594   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      595   procedure prcreate-new-price-doc :
      596   do
      597   on error undo, return error return-value
      598   :
      599   define input  parameter p-curr-db-num  as integer   no-undo .
      600   define input  parameter p-obj-type     like ub.price-doc.obj-type no-undo.
      601   define input  parameter p-obj-code     like ub.price-doc.obj-code no-undo.
      602   define input  parameter p-plt-id       as integer   no-undo .
      603   define input  parameter p-plt-db-num   as integer   no-undo .
      604   define input  parameter p-pdf-id       as integer   no-undo .
      605   define input  parameter p-pdf-db-num   as integer   no-undo .
      606   define output parameter p-price-doc-recid  as recid                no-undo.
      607   define variable v-host-code         like ub.sysconf.host-code        no-undo.
      608   define variable v-obj-current-date  like ub.price-doc.doc-date      no-undo.
      609   define variable v-base-rate    like ub.price-doc-forming.base-rate   no-undo .
      610   define variable v-base-scale   like ub.price-doc-forming.base-scale  no-undo .
      611   define buffer buf_price-doc-forming for ub.price-doc-forming.
      612   define buffer buf_price-doc         for ub.price-doc.
      613   find first buf_price-doc-forming no-lock where
      614              buf_price-doc-forming.pdf-db     = p-pdf-db-num and
      615              buf_price-doc-forming.pdf-id     = p-pdf-id     and
      616              buf_price-doc-forming.plt-db-num = p-plt-db-num and
      617              buf_price-doc-forming.plt-id     = p-plt-id
      618              no-error .
      619   if not available buf_price-doc-forming and p-plt-id = ? then do:
      620      run create_new_price-doc-forming
      621           ( input p-obj-type ,
      622             input p-obj-code ,
      623             output p-pdf-db-num ,
      624             output p-pdf-id ,
      625             output p-plt-db-num ,
      626             output p-plt-id
      627             ).
      628       find first buf_price-doc-forming no-lock where
      629                 buf_price-doc-forming.pdf-db     = p-pdf-db-num and
      630                 buf_price-doc-forming.pdf-id     = p-pdf-id     and
      631                 buf_price-doc-forming.plt-db-num = p-plt-db-num and
      632                 buf_price-doc-forming.plt-id     = p-plt-id
      633                 no-error .
      634   end.
      635       create buf_price-doc .
      636       run doc-code in this-procedure
      637       (input  "main",
      638        input  p-obj-type  ,
      639        input  p-obj-code  ,
      640        input  ?,
      641        output buf_price-doc.doc-num) no-error.
      642       if error-status:error then do:
      643         message vss-workfile vss-revision vss-description skip
      644                error-status :get-message(1)
      645               "Ошибка при генерации номера документа." return-value view-as alert-box error.
      646         return error.
      647       end.
      648   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      649   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      650     (input  p-obj-type
      651     ,input  p-obj-code
      652     ,output v-host-code
      653     )  .
      654       v-obj-current-date  = today .
      655       if not (buf_price-doc-forming.base-rate = 0 or buf_price-doc-forming.base-rate = ?) then do:
      656           v-base-rate   =  buf_price-doc-forming.base-rate  .
      657           v-base-scale  =  buf_price-doc-forming.base-scale .
      658       end.
      659       else do:
      660   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      661   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
      662     (input  v-host-code
      663     ,input  v-obj-current-date
      664     ,output v-base-rate
      665     ,output v-base-scale
      666     )  .
      667       end.
      668      assign
      669       buf_price-doc.base-rate      = v-base-rate
      670       buf_price-doc.base-scale     = v-base-scale
      671       buf_price-doc.cr-db-num      = p-curr-db-num
      672       buf_price-doc.doc-date       = v-obj-current-date
      673       buf_price-doc.fact-num       = 0
      674       buf_price-doc.host-code      = v-host-code
      675       buf_price-doc.is-corr        = false
      676       buf_price-doc.is-del         = false
      677       buf_price-doc.obj-code       = p-obj-code
      678       buf_price-doc.obj-type       = p-obj-type
      679       buf_price-doc.out-code       = ""
      680       buf_price-doc.pdf-db         = p-pdf-db-num
      681       buf_price-doc.pdf-id         = p-pdf-id
      682       buf_price-doc.plt-db-num     = p-plt-db-num
      683       buf_price-doc.plt-id         = p-plt-id
      684       buf_price-doc.PS             = "@ "
      685       buf_price-doc.rest-base      = 0
      686       buf_price-doc.rest-last      = 0
      687       buf_price-doc.rest-qnty      = 0
      688       buf_price-doc.rest-sale      = 0
      689       buf_price-doc.sale-base      = 0
      690       buf_price-doc.status_        = 'новый':U
      691       .
      692       buf_price-doc.doc-num-es     = entry(1, buf_price-doc-forming.des, chr(4)) no-error.
      693       buf_price-doc.uid-es         = entry(2, buf_price-doc-forming.des, chr(4)) no-error.
      694       buf_price-doc.doc-date       = date(entry(3, buf_price-doc-forming.des, chr(4))) no-error.
      695       if buf_price-doc.uid-es = "_" then buf_price-doc.uid-es = "" .
      696       assign
      697           p-price-doc-recid = recid ( buf_price-doc )
      698       .
      699   end.
      700   end procedure.
      701   procedure prcreate-new-price-list :
      702   do
      703   on error undo, return error return-value
      704   :
      705   define input parameter p-price-doc-recid   as recid                    no-undo.
      706   define input parameter p-gds-code          like ub.goods.gds-code         no-undo.
      707   define input parameter p-price-sale        like ub.price-list.price-sale  no-undo.
      708   define output parameter p-update           as logical                  no-undo.
      709   define variable kk as integer no-undo .
      710   define var v-b-code    like ub.bar-code.b-code     no-undo.
      711   define variable p-hostcode as int no-undo .
      712   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
      713   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
      714   define buffer buf_price-doc        for ub.price-doc.
      715   define buffer buf_price-list       for ub.price-list.
      716   define buffer buf_bar-code         for ub.bar-code.
      717   define buffer buf_goods            for ub.goods.
      718   define buffer buf_root_gds-prt     for ub.gds-prt.
      719   define buffer buf_gds-prt          for ub.gds-prt.
      720   find first buf_price-doc no-lock
      721        where recid( buf_price-doc ) = p-price-doc-recid
      722   .
      723   find first buf_goods no-lock
      724        where buf_goods.gds-code = p-gds-code
      725   .
      726   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      727     (input  p-gds-code
      728     ,input  ?
      729     ,output v-b-code
      730     ) no-error .
      731   if error-status :error
      732   then do:
      733       message
      734           "Не найден основной бар-код"
      735           skip "для товара "
      736           skip string(buf_goods.artic)
      737           skip buf_goods.gds-name
      738       view-as alert-box
      739       title "Ошибка при выполнении prcreate.i".
      740       undo, return error .
      741   end.
      742   find first buf_bar-code no-lock
      743        where buf_bar-code.b-code = v-b-code
      744   no-error.
      745   if error-status :error
      746   then do:
      747       message
      748           "Не найдена запись bar-code"
      749           skip "для товара "
      750           skip string(buf_goods.artic)
      751           skip buf_goods.gds-name
      752           skip "С основным бар-кодом"
      753           skip string(v-b-code)
      754       view-as alert-box
      755       title "Ошибка при выполнении prcreate.i".
      756       undo, return error .
      757   end.
      758   find first buf_root_gds-prt no-lock
      759        where buf_root_gds-prt.upper-code = buf_goods.prt-root
      760   .
      761   if buf_root_gds-prt.node-name <> '_Пустая шкала':U
      762     and buf_bar-code.in-code <> ""
      763   then do:
      764       message
      765           "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
      766           "Артикул:" buf_goods.artic "Код:" buf_goods.gds-code buf_goods.gds-name
      767           view-as alert-box error.
      768       undo, return error.
      769   end.
      770   find first buf_gds-prt no-lock
      771        where buf_gds-prt.node-code = buf_bar-code.node-code
      772   .
      773   find first buf_price-list
      774        where buf_price-list.doc-num = buf_price-doc.doc-num
      775          and buf_price-list.b-code  = v-b-code
      776   no-error.
      777   if available buf_price-list
      778   then do:
      779       message "Строка с товаром арт." buf_price-list.artic " уже есть в данной переоценке."
      780          skip "  Цена:   " buf_price-list.price-sale
      781          skip "Цена будет изменена"
      782       view-as alert-box warning.
      783       assign
      784           p-update = yes
      785       .
      786   end.
      787   else do:
      788   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      789   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      790     (input  buf_price-doc.obj-type
      791     ,input  buf_price-doc.obj-code
      792     ,output p-hostcode
      793     ) no-error .
      794   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      795   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
      796     (input  buf_goods.gds-code
      797     ,input  '1':U
      798     ,input  ?
      799     ,input  p-hostcode
      800     ,input  buf_price-doc.obj-type
      801     ,input  buf_price-doc.obj-code
      802     ,output local_vat-pc
      803     ) no-error .
      804   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      805   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
      806     (input  buf_goods.gds-code
      807     ,input  '2':U
      808     ,input  ?
      809     ,input  p-hostcode
      810     ,input  buf_price-doc.obj-type
      811     ,input  buf_price-doc.obj-code
      812     ,output local_slt-pc
      813     ) no-error .
      814       kk = kk + 1.
      815   define variable v-main-bar-code as integer   no-undo .
      816   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      817     (input  buf_goods.gds-code
      818     ,input  ?
      819     ,output v-main-bar-code
      820     )  .
      821       create buf_price-list.
      822       assign
      823           buf_price-list.line-num    = kk
      824           buf_price-list.doc-num     = buf_price-doc.doc-num
      825           buf_price-list.b-code      = buf_bar-code.b-code
      826           buf_price-list.artic       = buf_goods.artic
      827           buf_price-list.prod-type   = buf_goods.prod-type
      828           buf_price-list.prod-code   = buf_goods.prod-code
      829           buf_price-list.main-price  = (buf_bar-code.b-code = v-main-bar-code )
      830           buf_price-list.calc-method = 'Отсутствует':U
      831           buf_price-list.obj-type    = buf_price-doc.obj-type
      832           buf_price-list.obj-code    = buf_price-doc.obj-code
      833           buf_price-list.price-sale  = p-price-sale
      834           buf_price-list.vat-pc      = local_vat-pc
      835           buf_price-list.slt-pc      = local_slt-pc
      836           p-update                   = no
      837       .
      838   end.
      839   end.
      840   end procedure.
      841   procedure create_new_price-doc-forming :
      842   define input  parameter p-obj-type   as character no-undo .
      843   define input  parameter p-obj-code   as integer   no-undo .
      844   define output parameter p-pdf-db-num as integer   no-undo .
      845   define output parameter p-pdf-id     as integer   no-undo .
      846   define output parameter p-plt-db-num as integer   no-undo .
      847   define output parameter p-plt-id     as integer   no-undo .
      848   define buffer buf_price-list-type for ub.price-list-type  .
      849   define variable v-host-code  as integer   no-undo .
