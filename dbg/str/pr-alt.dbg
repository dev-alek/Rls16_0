     2680            bgcolor grey_color.
     2681   ASSIGN
     2682     FRAME d-pr-alt:SCROLLABLE = FALSE
     2683     br-alt   :NUM-LOCKED-COLUMNS IN FRAME d-pr-alt = 1
     2684     b-add     :POPUP-MENU IN FRAME d-pr-alt         = MENU m-add  :HANDLE
     2685     b-add     :MENU-MOUSE                                = 1
     2686     .
     2687   def var sort-labelbr-alt   as character no-undo .
     2688   def var sort-clmnbr-alt    as handle    no-undo .
     2689   def var cur-clmnbr-alt     as handle    no-undo .
     2690   def var cur-clmn-locbr-alt as integer   no-undo .
     2691   def var re-querybr-alt     as logical   initial no no-undo .
     2692   on start-search, ctrl-o of br-alt in frame d-pr-alt do:
     2693      run sort-brbr-alt
     2694        (input (if available price-list
     2695                then recid(price-list)
     2696                else ?
     2697               )
     2698        ).
     2699   end.
     2700   PROCEDURE sort-brbr-alt :
     2701     define input parameter p-recid as recid no-undo .
     2702     if re-querybr-alt = no then do:
     2703       assign
     2704          cur-clmnbr-alt = br-alt:current-column in frame d-pr-alt
     2705       .
     2706       if sort-clmnbr-alt <> ? then sort-clmnbr-alt:column-fgcolor = 0.
     2707       if cur-clmnbr-alt = sort-clmnbr-alt then do:
     2708         assign
     2709            sort-labelbr-alt = ""
     2710            sort-clmnbr-alt = ?
     2711         .
     2712        end.
     2713        else do:
     2714          assign
     2715            sort-labelbr-alt = cur-clmnbr-alt:label
     2716            sort-clmnbr-alt  = cur-clmnbr-alt
     2717            sort-clmnbr-alt:column-fgcolor = 4
     2718          .
     2719        end.
     2720      end.
     2721     assign
     2722       cur-clmn-locbr-alt = 1
     2723     .
     2724     def var column-handle as handle no-undo .
     2725     column-handle = br-alt:first-column.
     2726     do while valid-handle(column-handle) :
     2727       if column-handle = cur-clmnbr-alt then do:
     2728         leave .
     2729       end.
     2730       column-handle = column-handle:NEXT-COLUMN.
     2731       assign
     2732         cur-clmn-locbr-alt = cur-clmn-locbr-alt + 1
     2733       .
     2734     end.
     2735     case sort-labelbr-alt:
     2736           when '*'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1fnc-mark&1,price-list.b-code )' , chr(34))     .     run open-br.   . END.
     2737           when 'Тип'  then DO:    assign       sort-column-name = "if gds-prt.upper-code = goods.prt-root then         if bar-code.in-code = '' then           'ТОВАР':U         else           'ПАРТИЯ':U       else         'ПРИЗНАК':U"     .     run open-br.   . END.
     2738           when 'Глав. код'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1fnc-main-code&1,price-list.b-code )' , chr(34))     .     run open-br.   . END.
     2739           when 'Осн. код'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1fnc-base-code&1,price-list.b-code )' , chr(34))     .     run open-br.   . END.
     2740           when 'Код'  then DO:    assign       sort-column-name = "bar-code.b-code"     .     run open-br.   . END.
     2741           when 'Осн. цена'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1fnc-base-price&1,price-list.b-code )' , chr(34))     .     run open-br.   . END.
     2742           when 'Изм'  then DO:    assign       sort-column-name = "goods.unit-base"     .     run open-br.   . END.
     2743           when 'Коэф'  then DO:    assign       sort-column-name = "bar-code.cli-base-rate"     .     run open-br.   . END.
     2744           when 'Скидка'  then DO:    assign       sort-column-name = "price-list.d-pcnt"     .     run open-br.   . END.
     2745           when 'Цена'  then DO:    assign       sort-column-name = "price-list.price-sale"     .     run open-br.   . END.
     2746           when 'Изм'  then DO:    assign       sort-column-name = "bar-code.unit-cli"     .     run open-br.   . END.
     2747           when dor-nal  then DO:    assign       sort-column-name = "price-list.road-tax"     .     run open-br.   . END.
     2748           when 'Акциз'  then DO:    assign       sort-column-name = "price-list.excise"     .     run open-br.   . END.
     2749       otherwise do:
     2750         assign
     2751           sort-column-name = ""
     2752         .
     2753         run open-br.
     2754         if sort-labelbr-alt <> "" then do:
     2755           assign
     2756             cur-clmnbr-alt:column-fgcolor = 0
     2757           .
     2758         end.
     2759         assign
     2760           cur-clmn-locbr-alt = ?
     2761         .
     2762       end.
     2763     end case.
     2764     if p-recid <> ? then do:
     2765       reposition br-alt to recid p-recid no-error.
     2766       apply "value-changed" to br-alt in frame d-pr-alt.
     2767     end.
     2768     apply "entry" to br-alt in frame d-pr-alt.
     2769   END PROCEDURE.
     2770   procedure re-open-query-srt-clmnbr-alt:
     2771   if cur-clmnbr-alt = ? then do:
     2772      run open-br.
     2773   end.
     2774   else do:
     2775      assign re-querybr-alt = yes.
     2776      run sort-brbr-alt
     2777        (input (if available price-list
     2778                then recid(price-list)
     2779                else ?
     2780               )
     2781        ).
     2782      assign re-querybr-alt = no.
     2783   end.
     2784   end.
     2785   define variable vss-include-info39 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
