     3353     return no-apply.
     3354   END.
     3355   on end-error, stop of frame d-pr-alt do:
     3356     apply "choose" to b-exit in frame d-pr-alt.
     3357     return no-apply.
     3358   end.
     3359   ON CHOOSE OF MENU-ITEM m-lst-add DO:
     3360   define variable vss-include-info51 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
