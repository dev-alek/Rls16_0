     1194   define variable par-pr-nakl-iv  as logical   no-undo .
     1195   define variable par-pr-nakl-im  as logical   no-undo .
     1196   define variable par-pr-nogds-long as longchar no-undo .
     1197   define temp-table tmp-proof-price no-undo
     1198     field node-code like ub.gds-grp.node-code
     1199     field proof as decimal
     1200     field price as decimal
     1201   index pi node-code proof descending .
     1202   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1203   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1204   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1205   DEFINE VARIABLE v-S_CONTRACT               AS CHARACTER NO-UNDO INITIAL "".
     1206   DEFINE VARIABLE v-S_CODE_LAST_MASTER_NUM   AS CHARACTER NO-UNDO INITIAL "".
     1207   DEFINE VARIABLE v-DELIM_CHR_3              AS CHARACTER NO-UNDO INITIAL "".
     1208   ASSIGN
     1209      v-S_CONTRACT                = "Contract":U
     1210      v-S_CODE_LAST_MASTER_NUM    = "LastMasterNum":U
     1211      v-DELIM_CHR_3               = ","
     1212      .
     1213   DEFINE VARIABLE i-gl-Host-Code      AS INTEGER NO-UNDO INITIAL 0.
     1214   DEFINE VARIABLE i-gl-Contract-Code  AS INTEGER NO-UNDO INITIAL 0.
     1215   DEFINE VARIABLE i-gl-Extent3        AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1216   FUNCTION Can-Find-Spec RETURN LOGICAL (
     1217      INPUT iHost-Code    AS INTEGER,
     1218      INPUT iContract-Num AS INTEGER,
     1219      INPUT iGds-Code     AS INTEGER ):
     1220      DEFINE BUFFER buf_Spec FOR ub.Contract-Specif.
     1221      DEFINE VARIABLE iTmp-Host-Code     AS INTEGER NO-UNDO INITIAL 0.
     1222      DEFINE VARIABLE iTmp-Contract-Num  AS INTEGER NO-UNDO INITIAL 0.
     1223      DEFINE VARIABLE iTmp-Extent3       AS INTEGER NO-UNDO INITIAL 0 EXTENT 3.
     1224      DEFINE VARIABLE lRet               AS LOGICAL NO-UNDO INITIAL FALSE.
     1225      RUN MS-Contract-EXTENT-3 IN THIS-PROCEDURE(
     1226          INPUT  iHost-Code,
     1227          INPUT  iContract-Num,
     1228          OUTPUT iTmp-Extent3
     1229          ).
     1230      IF iTmp-Extent3[1] = 2 THEN DO:
     1231         ASSIGN
     1232            iTmp-Host-Code      = iTmp-Extent3[2]
     1233            iTmp-Contract-Num   = iTmp-Extent3[3]
     1234            .
     1235      END. ELSE DO:
     1236         ASSIGN
     1237            iTmp-Host-Code      = iHost-Code
     1238            iTmp-Contract-Num   = iContract-Num
     1239            .
     1240      END.
     1241      IF iGds-Code = ? THEN DO:
     1242         ASSIGN
     1243            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1244                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1245                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1246                           ).
     1247      END. ELSE DO:
     1248            lRet = CAN-FIND(FIRST buf_Spec NO-LOCK WHERE
     1249                                  buf_Spec.Host-Code     = iTmp-Host-Code
     1250                              AND buf_Spec.Contract-Num  = iTmp-Contract-Num
     1251                              AND buf_Spec.Gds-Code      = iGds-Code
     1252                            ).
     1253      END.
     1254      RETURN (lRet).
     1255   END FUNCTION.
     1256   PROCEDURE MS-Contract-EXTENT-3:
     1257      DEFINE INPUT  PARAMETER i-Host-Code     AS INTEGER NO-UNDO.
     1258      DEFINE INPUT  PARAMETER i-Contract-Code AS INTEGER NO-UNDO.
     1259      DEFINE OUTPUT PARAMETER i-Ret           AS INTEGER NO-UNDO EXTENT 3 INITIAL 0.
     1260      DEFINE BUFFER buf_Ext-Classif FOR ub.Ext-Classif.
     1261      DEFINE BUFFER buf_Cont        FOR ub.Contract.
     1262      DEFINE BUFFER buf_Cont-2      FOR ub.Contract.
     1263      FIND FIRST buf_Cont-2 WHERE
     1264                 buf_Cont-2.Host-Code      = i-Host-Code
     1265             AND buf_Cont-2.Contract-Code  = i-Contract-Code
     1266           NO-LOCK NO-ERROR.
     1267      IF NOT AVAILABLE buf_Cont-2 THEN DO:
     1268         RETURN.
     1269      END.
     1270      FOR FIRST buf_Ext-Classif WHERE
     1271                buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1272           AND  buf_Ext-Classif.CharKey_One  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1273                                               STRING(i-Contract-code)
     1274           AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1275          NO-LOCK,
     1276          EACH buf_Cont WHERE
     1277               buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3 ))
     1278           AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_Two, v-DELIM_CHR_3))
     1279          NO-LOCK:
     1280          ASSIGN
     1281             i-Ret[1] = 1
     1282             i-Ret[2] = buf_Cont.Host-code
     1283             i-Ret[3] = buf_Cont.Contract-code
     1284             .
     1285          LEAVE.
     1286      END.
     1287      IF i-Ret[1] <> 1 THEN DO:
     1288         FOR FIRST buf_Ext-Classif WHERE
     1289                   buf_Ext-Classif.Classif-name = v-S_CONTRACT
     1290              AND  buf_Ext-Classif.CharKey_Two  = STRING(i-Host-code) + v-DELIM_CHR_3 +
     1291                                                  STRING(i-Contract-code)
     1292              AND  buf_Ext-classif.db-num       = buf_Cont-2.Db-num
     1293             NO-LOCK,
     1294             EACH buf_Cont WHERE
     1295                  buf_Cont.Host-code     = INTEGER(ENTRY(1, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1296              AND buf_Cont.Contract-code = INTEGER(ENTRY(2, buf_Ext-classif.charKey_One, v-DELIM_CHR_3))
     1297             NO-LOCK:
     1298             ASSIGN
     1299                i-Ret[1] = 2
     1300                i-Ret[2] = buf_Cont.Host-code
     1301                i-Ret[3] = buf_Cont.Contract-code
     1302                .
     1303             LEAVE.
     1304         END.
     1305      END.
     1306      RETURN.
     1307   END PROCEDURE.
