     1501   procedure grp-obj-notcorr-value :
     1502   do
     1503   on error undo, return error
     1504   :
     1505   define input parameter p-node-code             as integer      no-undo.
     1506   define input parameter p-obj-type              as character    no-undo.
     1507   define input parameter p-obj-code              as integer      no-undo.
     1508   define output parameter p-notcorr              as character    no-undo init ?.
     1509   define output parameter p-range-notcorr     as integer      no-undo.
     1510   define output parameter p-exists-notcorr    as logical      no-undo.
     1511   define variable v-host-code as integer      no-undo.
     1512   DEFINE VARIABLE v-found as logical no-undo .
     1513   DEFINE VARIABLE v-exists as logical no-undo .
     1514   DEFINE VARIABLE v-range as integer no-undo .
     1515   DEFINE VARIABLE jj as integer no-undo .
     1516   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     1517   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     1518   define buffer buf_gds-grp for ub.gds-grp.
     1519   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     1520   find first buf_gds-grp no-lock where
     1521              buf_gds-grp.node-code = p-node-code no-error .
     1522   if not avail buf_gds-grp and p-node-code <> 0 then do:
     1523     message
     1524       vss-workfile vss-revision vss-description
     1525       skip "Не удалось найти группу товаров с кодом" p-node-code
     1526       view-as alert-box error .
     1527     undo, return error .
     1528   end.
     1529   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1530   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1531     (input  p-obj-type
     1532     ,input  p-obj-code
     1533     ,output v-host-code
     1534     ) no-error .
     1535   if error-status :error
     1536   then do:
     1537       message
     1538         vss-workfile vss-revision vss-description
     1539         skip "Не удалось найти фирму объекта"
     1540         skip p-obj-type p-obj-code
     1541         skip return-value
     1542         skip trim(error-status :get-message(1))
     1543       view-as alert-box error.
     1544       undo, return error .
     1545   end.
     1546   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     1547   do while v-found = no and jj < 2:
     1548     if v-range <> 3 then do:
     1549       find first buf_gds-grp-obj no-lock
     1550           where buf_gds-grp-obj.node-code = p-node-code
     1551             and buf_gds-grp-obj.host-code = v-host-code
     1552             and buf_gds-grp-obj.obj-type  = p-obj-type
     1553             and buf_gds-grp-obj.obj-code  = p-obj-code
     1554       no-error .
     1555     end.
     1556     if v-range = 3 or not available buf_gds-grp-obj
     1557     then do:
     1558        if v-range <> 2 then do:
     1559           find first buf_gds-grp-obj no-lock
     1560               where buf_gds-grp-obj.node-code = p-node-code
     1561                 and buf_gds-grp-obj.host-code = v-host-code
     1562                 and buf_gds-grp-obj.obj-type  = ""
     1563                 and buf_gds-grp-obj.obj-code  = 0
     1564           no-error .
     1565         end.
     1566         if v-range = 2 or not available buf_gds-grp-obj
     1567         then do:
     1568             if v-range <> 1 then do:
     1569               find first buf_gds-grp-obj no-lock
     1570                   where buf_gds-grp-obj.node-code = p-node-code
     1571                   and buf_gds-grp-obj.host-code = 0
     1572                   and buf_gds-grp-obj.obj-type  = ""
     1573                   and buf_gds-grp-obj.obj-code  = 0
     1574               no-error .
     1575             end.
     1576             if v-range = 1 or not available buf_gds-grp-obj
     1577             then do:
     1578                 assign
     1579                     v-exists = no
     1580                 .
     1581             end.
     1582             else do:
     1583                 assign
     1584                     v-exists = yes
     1585                     v-range = 1
     1586                 .
     1587             end.
     1588         end.
     1589         else do:
     1590             assign
     1591                 v-exists = yes
     1592                 v-range  = 2
     1593             .
     1594         end.
     1595     end.
     1596     else do:
     1597         assign
     1598             v-exists = yes
     1599             v-range  = 3
     1600         .
     1601     end.
     1602     if available buf_gds-grp-obj
     1603     then do:
     1604       find first buf_gds-grp-obj-attr no-lock
     1605         where buf_gds-grp-obj-attr.node-code   = p-node-code
     1606           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     1607           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     1608           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     1609           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     1610         no-error .
     1611       if available buf_gds-grp-obj-attr then do:
     1612         assign
     1613           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     1614         .
     1615       end.
     1616       else do:
     1617         assign
     1618           v-notcorr-value = ?
     1619         .
     1620       end.
     1621       assign
     1622       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     1623                           then yes
     1624                           else p-exists-notcorr)
     1625       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     1626                         then v-range
     1627                         else p-range-notcorr
     1628       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     1629                         then v-notcorr-value
     1630                         else p-notcorr
     1631       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     1632       jj = jj + 1
     1633       .
     1634     end.
     1635     else do:
     1636       assign
     1637       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     1638       jj = jj + 1
     1639       .
     1640     end.
     1641   end.
     1642   end.
     1643   end procedure.
     1644   define variable vss-include-info26 as character format "X(65)" no-undo
     1645   initial "@(#)$Workfile$ $Revision$".
     1646   procedure grplib-get-full-name :
     1647      define input parameter p-node-code  as integer      no-undo.
     1648      define output parameter p-full-name as character    no-undo.
     1649      do
     1650   on error undo, return error
     1651   :
     1652       define variable v-upper-code    as integer           no-undo.
     1653       define buffer buf_gds-grp       for ub.gds-grp.
     1654       define buffer buf_upper_gds-grp for ub.gds-grp.
     1655       find first buf_gds-grp no-lock
     1656            where buf_gds-grp.node-code = p-node-code
     1657       no-error.
     1658       if not available buf_gds-grp
     1659       then do:
     1660           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1661       end.
     1662       assign
     1663           p-full-name  = ""
     1664           v-upper-code = 1
     1665       .
     1666       do while buf_gds-grp.upper-code <> 0
     1667       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1668       :
     1669           assign
     1670               p-full-name  = buf_gds-grp.node-name
     1671                            + (if p-full-name <> "" then chr(47) else "")
     1672                            + p-full-name
     1673               v-upper-code = buf_gds-grp.upper-code
     1674           .
     1675           find first buf_gds-grp no-lock
     1676                where buf_gds-grp.node-code = v-upper-code
     1677           no-error.
     1678           if not available buf_gds-grp
     1679           then do:
     1680               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1681                                   + string( v-upper-code )
     1682                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1683           end.
     1684       end.
     1685       assign
     1686       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1687       .
     1688   end.
     1689   end .
     1690   procedure grplib-get-node-from-full-name :
     1691   define input parameter p-full-name as character no-undo .
     1692   define output parameter p-node-code as integer no-undo .
     1693   define variable v-ii as integer no-undo .
     1694   define variable v-upper-code as integer no-undo .
     1695   define variable v-root-code as integer no-undo .
     1696   define variable v-entry as character no-undo .
     1697   define buffer buf_gds-grp       for ub.gds-grp.
     1698   do
     1699   on error undo, return error
     1700   :
     1701     find first buf_gds-grp no-lock
     1702         where buf_gds-grp.upper-code = 0
     1703     no-error .
     1704     if not available buf_gds-grp
     1705     then do:
     1706         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1707     end.
     1708     else do:
     1709       assign
     1710       v-root-code = buf_gds-grp.node-code
     1711       .
     1712     end.
     1713     v-upper-code = v-root-code.
     1714     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1715       assign
     1716       v-entry = entry(v-ii, p-full-name, chr(47)).
     1717       if v-entry = '' then leave.
     1718       find first buf_gds-grp no-lock where
     1719                 buf_gds-grp.node-name = v-entry
     1720             and buf_gds-grp.upper-code = v-upper-code
     1721             no-error.
     1722       if not available buf_gds-grp then do:
     1723         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1724       end.
     1725       else do:
     1726         p-node-code = buf_gds-grp.node-code.
     1727         v-upper-code = buf_gds-grp.node-code.
     1728       end.
     1729     end.
     1730   end.
     1731   end .
     1732   procedure  chec-par :
     1733   define output parameter l-par as logical no-undo .
     1734   define input parameter l-host like ub.clients.obj-code no-undo .
     1735   define input parameter l-type like ub.clients.obj-type no-undo .
     1736   define input parameter l-code like ub.clients.obj-code no-undo .
     1737   define variable par-type          as character no-undo.
     1738   define variable v-value-character as character no-undo .
     1739   define variable v-value-date      as date      no-undo .
     1740   define variable v-value-decimal   as decimal   no-undo .
     1741   define variable v-value-integer   as integer   no-undo .
     1742   define variable v-value-logical   as logical   no-undo .
     1743   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1744     (input  'alcohol'
     1745     ,input  l-host
     1746     ,input  l-type
     1747     ,input  l-code
     1748     ,input  ''
     1749     ,input  ''
     1750     ,input  ''
     1751     ,input  no
     1752     ,output par-alcohol
     1753     ,output par-type
     1754     ) no-error .
     1755    .
     1756   empty temp-table thbjattr_thbj-attr.
     1757   run adm/shattri.p (
     1758      input "get":U
     1759     ,input l-type
     1760     ,input l-code
     1761     ,input 'overval':U
     1762     ,input  ""
     1763     ,output v-value-character
     1764     ,output v-value-date
     1765     ,output v-value-decimal
     1766     ,output v-value-integer
     1767     ,output v-value-logical
     1768     ,output par-type
     1769     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1770     ) no-error .
     1771   for each thbjattr_thbj-attr :
     1772       if thbjattr_thbj-attr.prop-code = 'pr-clt-q':U then par-pr-clt-q = string ( thbjattr_thbj-attr.property-value-logical) .
     1773       if thbjattr_thbj-attr.prop-code = 'pr-dpl-q':U then par-pr-dpl-q = string ( thbjattr_thbj-attr.property-value-logical) .
     1774       if thbjattr_thbj-attr.prop-code = 'pr-rdc-q':U then par-pr-rdc-q = string ( thbjattr_thbj-attr.property-value-logical) .
     1775       if thbjattr_thbj-attr.prop-code = 'pr-equ-dq':U then par-pr-equ-dq = thbjattr_thbj-attr.property-value-integer .
     1776       if thbjattr_thbj-attr.prop-code = 'pr-abs-d':U then par-pr-abs-d = string ( thbjattr_thbj-attr.property-value-logical) .
     1777       if thbjattr_thbj-attr.prop-code = 'pr-altex':U then par-pr-altex = string ( thbjattr_thbj-attr.property-value-logical) .
     1778       if thbjattr_thbj-attr.prop-code = 'pr-parex':U then par-pr-parex = string ( thbjattr_thbj-attr.property-value-logical) .
     1779       if thbjattr_thbj-attr.prop-code = 'pr-sclex':U then par-pr-sclex = string ( thbjattr_thbj-attr.property-value-logical) .
     1780       if thbjattr_thbj-attr.prop-code = 'pr-discm':U then par-pr-discm =  thbjattr_thbj-attr.property-value-character .
     1781       if thbjattr_thbj-attr.prop-code = 'pr-dscnt':U then par-pr-dscnt  = string ( thbjattr_thbj-attr.property-value-logical) .
     1782       if thbjattr_thbj-attr.prop-code = 'pr-print':U then par-pr-print  = string ( thbjattr_thbj-attr.property-value-logical) .
     1783       if thbjattr_thbj-attr.prop-code = 'pr-sigma':U then par-pr-sigma  = string ( thbjattr_thbj-attr.property-value-decimal) .
     1784       if thbjattr_thbj-attr.prop-code = 'pr-incpc':U then par-pr-incpc  = string ( thbjattr_thbj-attr.property-value-decimal) .
     1785       if thbjattr_thbj-attr.prop-code = 'pr-rndmt':U then par-pr-rndmt  =  thbjattr_thbj-attr.property-value-character .
     1786       if thbjattr_thbj-attr.prop-code = 'pr-rndbs':U then par-pr-rndbs  = string ( thbjattr_thbj-attr.property-value-decimal) .
     1787       if thbjattr_thbj-attr.prop-code = 'pr-notls':U then par-pr-notls = string ( thbjattr_thbj-attr.property-value-logical) .
     1788       if v-cntxt-db-num = 0 then do:
     1789         if thbjattr_thbj-attr.prop-code = 'pr-nogds0':U then par-pr-nogds =  thbjattr_thbj-attr.property-value-character.
     1790         if thbjattr_thbj-attr.prop-code = 'pr-goods0':U then par-pr-goods =  thbjattr_thbj-attr.property-value-character.
     1791       end.
     1792       else do:
     1793         if thbjattr_thbj-attr.prop-code = 'pr-nogds':U then par-pr-nogds =  thbjattr_thbj-attr.property-value-character.
     1794         if thbjattr_thbj-attr.prop-code = 'pr-goods':U then par-pr-goods =  thbjattr_thbj-attr.property-value-character.
     1795       end.
     1796   end.
     1797   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1798   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplmrgn in g#library2
     1799     (input  ?
     1800     ,input  l-type
     1801     ,input  l-code
     1802     ,output par-gen-mrgn-ie
     1803     ,output par-gen-mrgn-iv
     1804     ,output par-gen-mrgn-im
     1805     ) no-error .
     1806      IF error-status :error THEN message
     1807        vss-workfile vss-revision vss-description skip
     1808        error-status :get-message(1) skip
     1809        return-value skip
     1810        "gbl/gtplmrgn.i"
     1811        view-as alert-box error
     1812      .
     1813   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1814   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gtplpnakl in g#library2
     1815     (input  ?
     1816     ,input  l-type
     1817     ,input  l-code
     1818     ,output par-pr-nakl-ie
     1819     ,output par-pr-nakl-iv
     1820     ,output par-pr-nakl-im
     1821     ) no-error .
     1822      define variable ii as integer   no-undo .
     1823      define variable nn as integer   no-undo .
     1824      define variable v-fullname as character no-undo .
     1825      nn = num-entries ( par-pr-nogds ).
     1826      par-pr-nogds-long = "".
     1827      if par-pr-nogds <> "0" and par-pr-nogds <> ""  then do:
     1828         repeat ii = 1 to nn :
     1829           run grplib-get-full-name  ( input integer(entry(ii,par-pr-nogds)) , output v-fullname ) .
     1830           par-pr-nogds-long = par-pr-nogds-long + v-fullname + chr(4) .
     1831         end.
     1832         par-pr-nogds-long = trim (par-pr-nogds-long,chr(4)) .
     1833      end.
     1834   l-par = true .
     1835   end procedure.
     1836   PROCEDURE cre-pr-list:
     1837   define input  parameter bc      like ub.price-list.b-code no-undo.
     1838   define input  parameter new-num like ub.price-doc.doc-num no-undo.
     1839   define output parameter new-rec as recid             no-undo.
     1840   define buffer buf-price-list for ub.price-list.
     1841   define buffer buf-price-doc  for ub.price-doc.
     1842   define buffer buf-bar-code   for ub.bar-code.
     1843   define buffer buf-goods      for ub.goods.
     1844   define buffer buf-gds-prt    for ub.gds-prt.
     1845   define buffer root-gds-prt   for ub.gds-prt.
     1846   define variable cur-pr like ub.price-list.price-sale no-undo.
     1847   define variable cur-rt like ub.price-list.road-tax   no-undo.
     1848   define variable cur-ex like ub.price-list.excise     no-undo.
     1849   define variable cur-dn like ub.price-list.doc-num    no-undo.
     1850   define variable local_vat-pc like ub.price-list.vat-pc    no-undo.
     1851   define variable local_slt-pc like ub.price-list.slt-pc    no-undo.
     1852   define variable cur-rt-base as decimal no-undo .
     1853   define variable cur-rt-rubl as decimal no-undo .
     1854   define variable p-hostcode as int no-undo .
     1855   define variable v-line-num as integer no-undo .
     1856   define variable v-skip-del-gds as logical no-undo initial no .
     1857   cre-pr:
     1858   do on error undo cre-pr, return error:
     1859     find  buf-bar-code no-lock where
     1860           buf-bar-code.b-code = bc.
     1861     run check-use-bar-code ( buf-bar-code.b-code ) no-error .
     1862     if error-status :error then do:
     1863       message
     1864         return-value skip
     1865         "Ошибка !"
     1866         view-as alert-box error
     1867       .
     1868       undo cre-pr, return.
     1869     end.
     1870     find  buf-goods no-lock where
     1871           buf-goods.gds-code = buf-bar-code.gds-code.
     1872     find first root-gds-prt no-lock where
     1873               root-gds-prt.upper-code = buf-goods.prt-root.
     1874     if root-gds-prt.node-name <> '_Пустая шкала':U and
     1875       buf-bar-code.in-code <> "" then do:
     1876       message
     1877         "Не допускается создавать спец. цены на партии для товаров с непустой шкалой!" skip (2)
     1878         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     1879         view-as alert-box error.
     1880       undo cre-pr, return.
     1881     end.
     1882     find  buf-gds-prt no-lock where
     1883           buf-gds-prt.node-code = buf-bar-code.node-code.
     1884     if buf-goods.stts <> 0 and not v-skip-del-gds then do:
     1885       message
     1886         "Не допускается создавать цены на удаленные товары!" skip (2)
     1887         "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     1888         view-as alert-box error.
     1889       undo cre-pr, return.
     1890     end.
     1891     find  buf-price-doc where
     1892           buf-price-doc.doc-num = new-num.
     1893   define variable v-ret as logical no-undo .
     1894      run ver-modificator-price-is-null (
     1895             input    buf-goods.artic        ,
     1896             input    buf-goods.prod-type    ,
     1897             input    buf-goods.prod-code    ,
     1898             input    buf-price-doc.obj-type   ,
     1899             input    buf-price-doc.obj-code   ,
     1900             output   v-ret ).
     1901         if v-ret = false then dO:
     1902             message
     1903               "Не допускается создавать цены на модификаторы с нулевой ценой !" skip (2)
     1904               "Артикул:" buf-goods.artic "Код:" buf-goods.gds-code buf-goods.gds-name
     1905               view-as alert-box error.
     1906             undo cre-pr, return.
     1907           end.
     1908   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1909   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1910     (input  buf-price-doc.obj-type
     1911     ,input  buf-price-doc.obj-code
     1912     ,output p-hostcode
     1913     ) no-error .
     1914   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1915   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1916     (input  buf-goods.gds-code
     1917     ,input  '1':U
     1918     ,input  ?
     1919     ,input  p-hostcode
     1920     ,input  buf-price-doc.obj-type
     1921     ,input  buf-price-doc.obj-code
     1922     ,output local_vat-pc
     1923     ) no-error .
     1924   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1925   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1926     (input  buf-goods.gds-code
     1927     ,input  '2':U
     1928     ,input  ?
     1929     ,input  p-hostcode
     1930     ,input  buf-price-doc.obj-type
     1931     ,input  buf-price-doc.obj-code
     1932     ,output local_slt-pc
     1933     ) no-error .
     1934   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1935   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1936     (input  buf-price-doc.obj-type
     1937     ,input  buf-price-doc.obj-code
     1938     ,input  bc
     1939     ,input  0
     1940     ,input  0
     1941     ,output cur-dn
     1942     ,output cur-pr
     1943     ,output cur-rt
     1944     ,output cur-ex
     1945     ) no-error .
     1946     find first buf-price-list where
     1947               buf-price-list.b-code  = buf-bar-code.b-code and
     1948               buf-price-list.doc-num = new-num  and
     1949               buf-price-list.price-type = ""    no-error .
     1950     if not available buf-price-list then do:
     1951       run calc-price-line-num (input  new-num , output v-line-num) .
     1952       create buf-price-list.
     1953       assign
     1954         buf-price-list.line-num  = v-line-num
     1955         buf-price-list.b-code    = buf-bar-code.b-code
     1956         buf-price-list.doc-num   = buf-price-doc.doc-num
     1957         buf-price-list.prod-type = buf-goods.prod-type
     1958         buf-price-list.prod-code = buf-goods.prod-code
     1959         buf-price-list.artic     = buf-goods.artic
     1960         buf-price-list.obj-type  = buf-price-doc.obj-type
     1961         buf-price-list.obj-code  = buf-price-doc.obj-code
     1962         buf-price-list.vat-pc    = local_vat-pc
     1963         buf-price-list.slt-pc    = local_slt-pc
     1964         buf-price-list.price-prev = cur-pr
     1965         .
     1966       if  buf-gds-prt.upper-code = buf-goods.prt-root and
     1967           buf-bar-code.in-code   = "" and
     1968           buf-bar-code.part-code = "" and
     1969           buf-bar-code.unit-cli  = buf-goods.unit-base then do:
     1970         buf-price-list.main-price = yes.
     1971         if cur-pr <> ? then do:
     1972           run exp-prt (input buf-goods.gds-code,
     1973                       input cur-dn,
     1974                       input new-num,
     1975                       output new-rec) no-error.
     1976           if error-status :error then do:
     1977             message
     1978               "Ошибка вызова процедуры разворота специальных и неосновных цен."
     1979               view-as alert-box error.
     1980             undo cre-pr, return error.
     1981           end.
     1982         end.
     1983       end.
     1984       else do:
     1985         if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     1986           buf-price-list.d-pcnt = ?.
     1987         end.
     1988         buf-price-list.main-price = no.
     1989       end.
     1990     end.
     1991   end.
     1992   new-rec = recid (buf-price-list).
     1993   END PROCEDURE.
     1994   procedure calc-price-line-num :
     1995    do
     1996    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     1997    :
     1998   define input parameter p-doc-num as character no-undo .
     1999   define output parameter p-num  as integer no-undo .
     2000   define variable v-fact as integer no-undo .
     2001   define buffer buf_1_price-list for ub.price-list .
     2002   p-num = 1 .
     2003   find last  buf_1_price-list no-lock where
     2004              buf_1_price-list.doc-num = p-doc-num use-index line-num no-error .
     2005              if available buf_1_price-list then
     2006                   assign
     2007                     v-fact = buf_1_price-list.line-num
     2008                   .
     2009   v-fact = v-fact + 1.
     2010   if v-fact <> ? then if p-num < v-fact then p-num = v-fact .
     2011    end.
     2012   end procedure.
     2013   PROCEDURE del-pr-list:
     2014   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2015   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2016   define input parameter round-method as character         no-undo.
     2017   define input parameter round-base   as decimal      no-undo.
     2018   define buffer buf-price-list for ub.price-list.
     2019   define buffer buf-bar-code   for ub.bar-code.
     2020   define buffer buf-goods      for ub.goods.
     2021   define variable l-ov-on as logical no-undo .
     2022   del-pr:
     2023   do on error undo del-pr, return error:
     2024     find first  buf-price-list no-lock where
     2025                 buf-price-list.doc-num    = d-num and
     2026                 buf-price-list.b-code     = bc and
     2027                 buf-price-list.price-type = "" no-error.
     2028     if not available buf-price-list then
     2029       undo del-pr, return error.
     2030     find  buf-goods no-lock where
     2031           buf-goods.prod-type = buf-price-list.prod-type and
     2032           buf-goods.prod-code = buf-price-list.prod-code and
     2033           buf-goods.artic     = buf-price-list.artic.
     2034     if buf-price-list.main-price then do:
     2035       for each  buf-price-list exclusive-lock where
     2036                 buf-price-list.doc-num   = d-num and
     2037                 buf-price-list.artic     = buf-goods.artic and
     2038                 buf-price-list.prod-type = buf-goods.prod-type and
     2039                 buf-price-list.prod-code = buf-goods.prod-code,
     2040           first buf-bar-code no-lock where
     2041                 buf-bar-code.b-code = buf-price-list.b-code
     2042       on error undo del-pr, return error:
     2043   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2044   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     2045     (input  ub.buf-price-list.obj-type
     2046     ,input  ub.buf-price-list.obj-code
     2047     ,input  ub.buf-price-list.artic
     2048     ,input  ub.buf-price-list.prod-type
     2049     ,input  ub.buf-price-list.prod-code
     2050     ,input  'ov-on=request:exclusive'
     2051     ,output l-ov-on
     2052     ) no-error .
     2053         if error-status:error then do:
     2054           message
     2055             vss-workfile vss-revision vss-description skip
     2056             "Ошибка получения признака товара на объекте" skip
     2057             error-status :get-message(1) skip
     2058             return-value skip
     2059             view-as alert-box error .
     2060         end.
     2061         if l-ov-on then do:
     2062   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2063   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     2064     (input  ub.buf-price-list.obj-type
     2065     ,input  ub.buf-price-list.obj-code
     2066     ,input  ub.buf-price-list.artic
     2067     ,input  ub.buf-price-list.prod-type
     2068     ,input  ub.buf-price-list.prod-code
     2069     ,input  'ov-on=false'
     2070     ,output l-ov-on
     2071     ) no-error .
     2072           if error-status :error then do:
     2073           end.
     2074          end.
     2075         delete buf-price-list.
     2076       end.
     2077     end.
     2078     else do:
     2079       find  buf-bar-code no-lock where
     2080             buf-bar-code.b-code = buf-price-list.b-code.
     2081       if buf-bar-code.unit-cli <> buf-goods.unit-base then do:
     2082         message
     2083           "Нельзя удалить неосновную цену." skip
     2084           "Неосновная цена (скидка) не может быть неопределенной." skip
     2085           "Код:" bc skip
     2086           "Переоценка:" d-num
     2087           view-as alert-box error.
     2088         undo del-pr, return error.
     2089       end.
     2090       find current buf-price-list exclusive-lock no-error .
     2091       delete buf-price-list.
     2092       run calc-base-upd (input buf-bar-code.b-code,
     2093                         input d-num,
     2094                         input round-method,
     2095                         input round-base) no-error.
     2096       if error-status :error then
     2097         undo del-pr, return error.
     2098     end.
     2099   end.
     2100   END PROCEDURE.
     2101   PROCEDURE calc-base-upd:
     2102   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2103   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2104   define input parameter round-method as character         no-undo.
     2105   define input parameter round-base   as decimal      no-undo.
     2106   define buffer alt-bar-code   for ub.bar-code.
     2107   define buffer alt-price-list for ub.price-list.
     2108   define buffer buf-bar-code   for ub.bar-code.
     2109   define buffer buf-goods      for ub.goods.
     2110   calc-base:
     2111   do on error undo calc-base, return error:
     2112     find  buf-bar-code no-lock where
     2113           buf-bar-code.b-code = bc.
     2114     find  buf-goods no-lock where
     2115           buf-goods.gds-code = buf-bar-code.gds-code.
     2116     for each  alt-bar-code no-lock where
     2117               alt-bar-code.gds-code  = buf-bar-code.gds-code and
     2118               alt-bar-code.node-code = buf-bar-code.node-code and
     2119               alt-bar-code.part-code = buf-bar-code.part-code and
     2120               alt-bar-code.in-code   = buf-bar-code.in-code and
     2121               alt-bar-code.unit-cli <> buf-goods.unit-base,
     2122         each  alt-price-list where
     2123               alt-price-list.doc-num    = d-num and
     2124               alt-price-list.b-code     = alt-bar-code.b-code and
     2125               alt-price-list.price-type = ""
     2126         on error undo calc-base, return error:
     2127       run calc-pr-alt (input d-num,
     2128                       input alt-bar-code.b-code,
     2129                       input round-method,
     2130                       input round-base) no-error.
     2131       if error-status:error then
     2132         undo calc-base, return error.
     2133     end.
     2134   end.
     2135   END PROCEDURE.
     2136   PROCEDURE calc-pr-alt:
     2137   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2138   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2139   define input parameter r-method as character             no-undo.
     2140   define input parameter r-base   as decimal              no-undo.
     2141   define buffer buf-price-doc  for ub.price-doc.
     2142   define buffer buf-price-list for ub.price-list.
     2143   define buffer buf-bar-code   for ub.bar-code.
     2144   define buffer buf-goods      for ub.goods.
     2145   define buffer old-price-list for ub.price-list.
     2146   define variable pr-rec   as   recid                  no-undo.
     2147   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     2148   pr-alt:
     2149   do on error undo pr-alt, return error:
     2150     if r-method = ? or
     2151        r-base = ? then do:
     2152       message
     2153         "Нельзя удалить основную цену." skip
     2154         "Не задан способ округления для расчета зависящих от нее неосновных цен." skip
     2155         "Код:" bc skip
     2156         "Переоценка:" d-num
     2157         view-as alert-box error.
     2158       undo pr-alt, return error.
     2159     end.
     2160     find  buf-price-doc where
     2161           buf-price-doc.doc-num = d-num.
     2162     find  buf-bar-code no-lock where
     2163           buf-bar-code.b-code = bc.
     2164     find  buf-goods no-lock where
     2165           buf-goods.gds-code = buf-bar-code.gds-code.
     2166     find  buf-price-list where
     2167           buf-price-list.doc-num = buf-price-doc.doc-num and
     2168           buf-price-list.b-code  = bc.
     2169     if buf-price-list.d-pcnt = ? then do:
     2170   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2171   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     2172     (input  buf-price-doc.obj-type
     2173     ,input  buf-price-doc.obj-code
     2174     ,input  bc
     2175     ,input  0
     2176     ,input  0
     2177     ,output pr-rec
     2178     ,output pr-c-b-r
     2179     )  .
     2180       find old-price-list no-lock where
     2181           recid (old-price-list) = pr-rec no-error.
     2182       if available old-price-list and
     2183         old-price-list.b-code = bc then
     2184         buf-price-list.d-pcnt = old-price-list.d-pcnt.
     2185       else
     2186         buf-price-list.d-pcnt = 0.
     2187     end.
     2188      if buf-price-list.d-pcnt = ? then do:
     2189         assign
     2190           buf-price-list.price-sale =   if available old-price-list then old-price-list.price-sale else 0
     2191           buf-price-list.calc-method =  'Не-считать':U + 'Основная':U
     2192           .
     2193     end.
     2194     else do:
     2195         assign
     2196           buf-price-list.price-sale =   fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) *
     2197                                         buf-bar-code.cli-base-rate *
     2198                                         (1 - buf-price-list.d-pcnt / 100)
     2199           buf-price-list.calc-method =  'Основная':U
     2200           .
     2201   case r-method :
     2202     when '9-окончание':U then do:
     2203       if buf-price-list.price-sale < 29 then do:
     2204         if (buf-price-list.price-sale - truncate (buf-price-list.price-sale, 0)) <> 0 then do:
     2205           assign
     2206             buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 1
     2207           .
     2208         end.
     2209       end.
     2210       else do:
     2211         if (buf-price-list.price-sale modulo 10) < 3 then do:
     2212           assign
     2213             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     2214                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     2215                   - 1 ) * 10
     2216                 + 9
     2217           .
     2218         end.
     2219         else do:
     2220           assign
     2221             buf-price-list.price-sale = (buf-price-list.price-sale - (buf-price-list.price-sale modulo 100))
     2222                 + ( truncate (((buf-price-list.price-sale modulo 100) / 10), 0)
     2223                   ) * 10
     2224                 + 9
     2225           .
     2226         end.
     2227         assign
     2228           buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     2229         .
     2230       end.
     2231     end.
     2232     when '9-99окончание':U then do:
     2233       if buf-price-list.price-sale < r-base then do:
     2234         assign
     2235           buf-price-list.price-sale = truncate (buf-price-list.price-sale, 0) + 0.99
     2236         .
     2237       end.
     2238       else do:
     2239         assign
     2240           buf-price-list.price-sale = truncate (buf-price-list.price-sale / 10 , 0) * 10 + 9.99
     2241         .
     2242       end.
     2243     end.
     2244     when 'Без-дробных':U then do:
     2245       assign
     2246         buf-price-list.price-sale = round (buf-price-list.price-sale, 0)
     2247       .
     2248     end.
     2249     when 'Произвольно':U then do:
     2250       if r-base <> 0 then do:
     2251         assign
     2252           buf-price-list.price-sale = round (buf-price-list.price-sale / r-base, 0) * r-base
     2253         .
     2254         if buf-price-list.price-sale = 0 then do:
     2255           assign
     2256             buf-price-list.price-sale = r-base
     2257           .
     2258         end.
     2259       end.
     2260     end.
     2261     when 'Вверх':U then do:
     2262       if r-base <> 0 then do:
     2263         if truncate ( buf-price-list.price-sale / r-base, 0 ) <> (buf-price-list.price-sale / r-base) then do:
     2264           assign
     2265             buf-price-list.price-sale = truncate (buf-price-list.price-sale / r-base, 0) * r-base + r-base
     2266           .
     2267         end.
     2268       end.
     2269       if buf-price-list.price-sale = 0 then do:
     2270         assign
     2271           buf-price-list.price-sale = r-base
     2272         .
     2273       end.
     2274     end.
     2275     when 'Коэффициент':U then do:
     2276       if r-base <> 0 then do:
     2277         assign
     2278           buf-price-list.price-sale = buf-price-list.price-sale * r-base
     2279         .
     2280       end.
     2281     end.
     2282     when 'Отключено':U then do:
     2283     end.
     2284     otherwise do:
     2285       message
     2286         vss-workfile vss-revision vss-description skip
     2287         "Неизвестный метод округления продажной цены" skip
     2288         "round-method" r-method skip
     2289         "round-base"   r-base   skip
     2290         "price"        buf-price-list.price-sale             skip
     2291         view-as alert-box error .
     2292     end.
     2293   end.
     2294     end.
     2295   end.
     2296   END PROCEDURE.
     2297   PROCEDURE calc-pr-discnt:
     2298   define input parameter d-num like ub.price-doc.doc-num no-undo.
     2299   define input parameter bc    like ub.bar-code.b-code   no-undo.
     2300   define buffer buf-price-doc  for ub.price-doc.
     2301   define buffer buf-price-list for ub.price-list.
     2302   define buffer buf-bar-code   for ub.bar-code.
     2303   define buffer buf-goods      for ub.goods.
     2304   define buffer old-price-list for ub.price-list.
     2305   define variable pr-rec   as   recid                  no-undo.
     2306   define variable pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     2307   pr-discnt:
     2308   do on error undo pr-discnt, return error:
     2309     find  buf-price-doc where
     2310           buf-price-doc.doc-num = d-num.
     2311     find  buf-bar-code no-lock where
     2312           buf-bar-code.b-code = bc.
     2313     find  buf-goods no-lock where
     2314           buf-goods.gds-code = buf-bar-code.gds-code.
     2315     find  buf-price-list where
     2316           buf-price-list.doc-num = buf-price-doc.doc-num and
     2317           buf-price-list.b-code  = bc.
     2318     buf-price-list.d-pcnt = (1 -
     2319                              buf-price-list.price-sale /
     2320                              fnc-base-price (buf-bar-code.b-code, buf-price-list.doc-num) /
     2321                              buf-bar-code.cli-base-rate) *
     2322                              100
     2323                              .
     2324   end.
     2325   END PROCEDURE.
     2326   PROCEDURE calc-pr-sub :
     2327   define  input  parameter bc             like ub.price-list.b-code no-undo.
     2328   define  input  parameter d-num          like ub.price-doc.doc-num no-undo.
     2329   define  input  parameter calc-method  as character    no-undo.
     2330   define  input  parameter increase-pc  as decimal      no-undo.
     2331   define  input  parameter round-method as character    no-undo.
     2332   define  input  parameter round-base   as decimal      no-undo.
     2333   define  output parameter calc-rec     as recid        no-undo.
     2334   define  buffer buf-price-list for ub.price-list.
     2335   define  buffer buf-bar-code   for ub.bar-code.
     2336   define  buffer buf-goods      for ub.goods.
     2337   define  buffer buf-gds-prt    for ub.gds-prt.
     2338   define  buffer buf-gds-grp    for ub.gds-grp.
     2339   define  buffer buf-price-doc  for ub.price-doc.
     2340   calc-sub:
     2341   do on error undo calc-sub, return error:
     2342     find  buf-bar-code no-lock where
     2343           buf-bar-code.b-code = bc.
     2344     find  buf-goods no-lock where
     2345           buf-goods.gds-code = buf-bar-code.gds-code.
     2346     find  buf-gds-prt no-lock where
     2347           buf-gds-prt.node-code = buf-bar-code.node-code.
     2348     find  buf-price-list where
     2349           buf-price-list.doc-num    = d-num and
     2350           buf-price-list.b-code     = bc and
     2351           buf-price-list.price-type = "".
     2352     find  buf-price-doc where
     2353           buf-price-doc.doc-num = d-num.
     2354     calc-rec = recid (buf-price-list).
     2355     if buf-price-list.main-price then do:
     2356       for each  buf-price-list where
     2357                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     2358                 buf-price-list.main-price = no and
     2359                 buf-price-list.artic      = buf-goods.artic and
     2360                 buf-price-list.prod-type  = buf-goods.prod-type and
     2361                 buf-price-list.prod-code  = buf-goods.prod-code,
     2362           first buf-bar-code no-lock where
     2363                 buf-bar-code.b-code   = buf-price-list.b-code and
     2364                 buf-bar-code.unit-cli = buf-goods.unit-base
     2365           on error undo calc-sub, return error:
     2366         run calc-pr-list (input  buf-bar-code.b-code,
     2367                           input  buf-price-list.doc-num,
     2368                           input  calc-method,
     2369                           input  increase-pc,
     2370                           input  round-method,
     2371                           input  round-base,
     2372                           input ? ,
     2373                           input ? ,
     2374                           input ? ,
     2375                           input ? ,
     2376                           output calc-rec) no-error.
     2377         if error-status :error then
     2378           undo calc-sub, return error.
     2379         calc-rec = recid (buf-price-list).
     2380       end.
     2381       for each  buf-price-list where
     2382                 buf-price-list.doc-num    = buf-price-doc.doc-num and
     2383                 buf-price-list.main-price = no and
     2384                 buf-price-list.artic      = buf-goods.artic and
     2385                 buf-price-list.prod-type  = buf-goods.prod-type and
     2386                 buf-price-list.prod-code  = buf-goods.prod-code,
     2387           first buf-bar-code no-lock where
     2388                 buf-bar-code.b-code    = buf-price-list.b-code and
     2389                 buf-bar-code.unit-cli <> buf-goods.unit-base
     2390           on error undo calc-sub, return error:
     2391         run calc-pr-alt (input buf-price-doc.doc-num,
     2392                         input buf-bar-code.b-code,
     2393                         input round-method,
     2394                         input round-base) no-error.
     2395         if error-status :error then
     2396           undo calc-sub, return error.
     2397       end.
     2398     end.
     2399     else do:
     2400       run calc-base-upd (input buf-bar-code.b-code,
     2401                         input buf-price-doc.doc-num,
     2402                         input round-method,
     2403                         input round-base) no-error.
     2404       if error-status :error then
     2405         undo calc-sub, return error.
     2406     end.
     2407   end.
     2408   END PROCEDURE.
     2409   procedure ver-pr-nogds :
     2410   define input  parameter p-gds-code      as integer   no-undo .
     2411   define input  parameter p-par-pr-nogds  as character no-undo .
     2412   define output parameter p-not           as logical   no-undo .
     2413   define output parameter p-str           as character no-undo .
     2414   define buffer buf_goods for ub.goods  .
     2415   define variable nn as integer   no-undo .
     2416   define variable ii as integer   no-undo .
     2417   define variable v-namegrp as character no-undo .
     2418     do
     2419     on error undo, return error return-value
     2420     :
     2421     if p-par-pr-nogds = "1" then do:
     2422        assign
     2423         p-not = true
     2424         p-str = ""
     2425        .
     2426        return .
     2427     end.
     2428     assign
     2429       p-not = false
     2430       p-str = ""
     2431     .
     2432     find first buf_goods no-lock where
     2433                buf_goods.gds-code = p-gds-code no-error .
     2434     nn = num-entries(par-pr-nogds-long,chr(4)) .
     2435     repeat ii = 1 to nn:
     2436        v-namegrp = entry(ii , par-pr-nogds-long , chr(4) ) no-error .
     2437        if buf_goods.grp-name  begins v-namegrp  then do:
     2438           assign
     2439             p-not = true
     2440             p-str = substitute ( "Товар &1 &2 &3  может быть включен в ДНЦ из-за исключения запрета по группе : &4"  , buf_goods.artic, buf_goods.gds-name , buf_goods.grp-name , v-namegrp )
     2441           .
     2442           leave .
     2443        end.
     2444     end.
     2445     end.
     2446   end procedure.
     2447   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2448   procedure ver-modificator-price-is-null :
     2449    do
     2450    on error undo, return error return-value
     2451    :
     2452   define input parameter p-artic     like ub.goods.artic no-undo.
     2453   define input parameter p-prod-type like ub.goods.prod-type no-undo.
     2454   define input parameter p-prod-code like ub.goods.prod-code no-undo.
     2455   define input parameter p-obj-type  like ub.clients.obj-type no-undo.
     2456   define input parameter p-obj-code  like ub.clients.obj-code no-undo.
     2457   define output parameter p-ret as logical no-undo .
     2458   define variable v-gds-code  like ub.goods.gds-code no-undo .
     2459   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     2460   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2461   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     2462     (input  p-artic
     2463     ,input  p-prod-type
     2464     ,input  p-prod-code
     2465     ,output v-gds-code
     2466     )  .
     2467   p-ret = true .
     2468   find first buf_fbr-gds-obj no-lock where
     2469               buf_fbr-gds-obj.gds-code = v-gds-code and
     2470               buf_fbr-gds-obj.obj-code = p-obj-code and
     2471               buf_fbr-gds-obj.obj-type = p-obj-type use-index pi no-error .
     2472    if available buf_fbr-gds-obj then
     2473                 if buf_fbr-gds-obj.is-modificator = true and
     2474                    buf_fbr-gds-obj.is-null-price = true
     2475                    then  p-ret = false .
     2476    end.
     2477   end procedure.
     2478   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2479   procedure doc-code:
     2480   define input  parameter parmode          as   character           no-undo.
     2481   define input  parameter parobj-type      like ub.clients.obj-type no-undo.
     2482   define input  parameter parobj-code      like ub.clients.obj-code no-undo.
     2483   define input  parameter parroot-doc-code like ub.trn-doc.doc-code no-undo.
     2484   define output parameter pardoc-code      like ub.trn-doc.doc-code no-undo.
     2485   define buffer buf_sys-ctrl for ub.sys-ctrl  .
     2486   define variable vardb-remote     as   logical             no-undo.
     2487   define variable vartemp-doc-code like ub.trn-doc.doc-code no-undo.
     2488   define variable v-delimiter as character no-undo .
     2489   do
     2490   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2491   :
     2492   find first buf_sys-ctrl no-lock .
     2493   vardb-remote = buf_sys-ctrl.db-num <> 0 .
     2494     CASE parmode:
     2495       when "main":u then do:
     2496         if vardb-remote then do:
     2497           assign
     2498             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-" + trim (string (parobj-code, ">>>>9")) + substring (parobj-type, (if g#language = "RUS" then 1 else 2), 1).
     2499         end.
     2500         else do:
     2501           assign
     2502             pardoc-code = trim (string (next-value (s-trn-doc, ub), ">>>>>>>>>9")) + "-".
     2503         end.
     2504       end.
     2505       when "trio" then do:
     2506         assign
     2507           pardoc-code = replace (parroot-doc-code, "=", "*").
     2508       end.
     2509       otherwise do:
     2510         assign
     2511         v-delimiter = entry(lookup(entry(1, parmode), "main,chip,pair,flora,trio-m,quadro,stock-up,stock-down,stock-fix," +                          "main_s,chip_s,pair_s,trio-m_s,quadro_s,stock-up_s,stock-down_s,stock-fix_s":U), ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)))
     2512         no-error
     2513         .
     2514         if error-status:error  then do:
     2515           undo, return error substitute("Ошибка при генерации номера документа&1Неверное значение параметра parmode &2"
     2516                                         ,chr(10)
     2517                                         ,parmode
     2518                                         ).
     2519         end.
     2520         if num-entries(parmode) = 1
     2521         and parmode <> "chip":U
     2522         and parmode <> "chip_s":U
     2523         then do:
     2524           assign
     2525           pardoc-code = replace (parroot-doc-code, "-", v-delimiter).
     2526         end.
     2527         else if (lookup("chip":U, parmode) > 0
     2528                  or
     2529                  lookup("chip_s":U, parmode) > 0) then do:
     2530           assign
     2531             vartemp-doc-code = parroot-doc-code.
     2532           do while true:
     2533             if index (vartemp-doc-code , ".") = 0 then
     2534               vartemp-doc-code  = replace (vartemp-doc-code , v-delimiter, v-delimiter + "1.").
     2535             else
     2536               vartemp-doc-code  =
     2537               substring (vartemp-doc-code , 1, index (vartemp-doc-code, v-delimiter)) +
     2538               string (integer (substring (vartemp-doc-code, index (vartemp-doc-code, v-delimiter) + 1, index (vartemp-doc-code, ".") - index (vartemp-doc-code, v-delimiter) - 1)) + 1) +
     2539               substring (vartemp-doc-code, index (vartemp-doc-code, ".")).
     2540             if not can-find (ub.trn-doc where ub.trn-doc.doc-code = vartemp-doc-code no-lock) then leave.
     2541           end.
     2542           assign
     2543             pardoc-code = vartemp-doc-code.
     2544         end.
     2545       end.
     2546     end CASE.
     2547     if pardoc-code = '':U
     2548     or (parroot-doc-code <> '':U
     2549     and pardoc-code = parroot-doc-code) then do:
     2550       undo, return error substitute("Ошибка при генерации номера документа&1"
     2551                                     ,chr(10)).
     2552     end.
     2553   end.
     2554   end. // procedure/method
     2555   function get-doc-code-int64 returns int64
     2556     ( input p-doc-code as character ) :
     2557     define variable v-ind              as integer   no-undo .
     2558     define variable v-num-entries      as integer   no-undo .
     2559     define variable v-doc-code-int64   as int64     no-undo .
     2560     define variable v-canonic-doc-code as character no-undo .
     2561     assign
     2562       v-num-entries      = num-entries( ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) )
     2563       v-canonic-doc-code = p-doc-code
     2564     .
     2565     do v-ind = 1 to v-num-entries
     2566     :
     2567       assign
     2568         v-canonic-doc-code = entry(1, v-canonic-doc-code, entry( v-ind, ("-,-,=,#,*,^,+,`,":U + chr(126) + ",у-,у-,у=,у*,у^,у+,у`,у" + chr(126)) ) )
     2569       .
     2570     end.
     2571     assign
     2572       v-doc-code-int64 = int64(v-canonic-doc-code) no-error
     2573     .
     2574     return v-doc-code-int64 .
     2575   end. // function/method
