      925   define variable v-sec as integer   no-undo .
      926     do
      927     on error undo, return error return-value
      928     :
      929   define variable v-cur-dn as character no-undo .
      930   define variable v-cur-pr as decimal   no-undo .
      931   define variable v-cur-rt as decimal   no-undo .
      932   define variable v-cur-ex as decimal   no-undo .
      933   find first buf_price-doc-forming no-lock where
      934              recid(buf_price-doc-forming) = p-price-doc-forming-recid  no-error .
      935              if error-status :error then return error .
      936   find first buf_goods no-lock where
      937              buf_goods.gds-code  = p-gds-code no-error .
      938              if error-status :error then return error .
      939   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      940     (input  buf_goods.gds-code
      941     ,input  ?
      942     ,output main-b-code
      943     ) no-error .
      944   run check-use-bar-code (main-b-code) no-error .
      945   if error-status :error then return .
      946   run create-line-pdf-mpl-lib (
      947        input buf_price-doc-forming.plt-db-num
      948       ,input buf_price-doc-forming.plt-id
      949       ,input buf_price-doc-forming.pdf-db
      950       ,input buf_price-doc-forming.pdf-id
      951       ,input p-line-num
      952       ,input main-b-code
      953       ,input buf_goods.artic
      954       ,input buf_goods.prod-type
      955       ,input buf_goods.prod-code
      956       ,input ""
      957       ,input 0
      958       ,input p-price-sale
      959       ,input ""
      960       ,input 0
      961      ,input-output v-sec ) no-error .
      962      if error-status :error  then do:
      963        message
      964          vss-workfile vss-revision vss-description skip
      965          error-status :get-message(1) skip
      966          return-value skip
      967          "2"
      968          view-as alert-box error
      969        .
      970      end.
      971   define buffer old_price-list for ub.price-list  .
      972   if par-pr-notls = "yes" then do:
      973   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      974   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
      975     (input  p-obj-type
      976     ,input  p-obj-code
      977     ,input  main-b-code
      978     ,input  0
      979     ,input  0
      980     ,output v-cur-dn
      981     ,output v-cur-pr
      982     ,output v-cur-rt
      983     ,output v-cur-ex
      984     )  .
      985   end.
      986   if par-pr-altex = "yes" and
      987      par-pr-notls = "yes" then do:
      988       if v-cur-dn <> "" then do:
      989           for each old_price-list no-lock where
      990                    old_price-list.doc-num = v-cur-dn and
      991                    old_price-list.artic      = buf_goods.artic and
      992                    old_price-list.prod-type  = buf_goods.prod-type and
      993                    old_price-list.prod-code  = buf_goods.prod-code and
      994                    old_price-list.main-price = no,
      995                   first buf_bar-code no-lock where
      996                         buf_bar-code.b-code   = old_price-list.b-code and
      997                         buf_bar-code.unit-cli <> buf_goods.unit-base
      998                         :
      999                          run check-use-bar-code (buf_bar-code.b-code) no-error .
     1000                          if error-status :error then next.
     1001                    run create-line-pdf-mpl-lib (
     1002                          input buf_price-doc-forming.plt-db-num
     1003                         ,input buf_price-doc-forming.plt-id
     1004                         ,input buf_price-doc-forming.pdf-db
     1005                         ,input buf_price-doc-forming.pdf-id
     1006                         ,input p-line-num
     1007                         ,input old_price-list.b-code
     1008                         ,input buf_goods.artic
     1009                         ,input buf_goods.prod-type
     1010                         ,input buf_goods.prod-code
     1011                         ,input ""
     1012                         ,input 0
     1013                         ,input old_price-list.price-sale
     1014                         ,input ""
     1015                         ,input 0
     1016                        ,input-output v-sec ) no-error .
     1017           end.
     1018       end.
     1019   end.
     1020   if par-pr-sclex = "yes" and
     1021      par-pr-notls = "yes" then do:
     1022       if v-cur-dn <> "" then do:
     1023           for each old_price-list no-lock where
     1024                    old_price-list.doc-num    = v-cur-dn and
     1025                    old_price-list.artic      = buf_goods.artic and
     1026                    old_price-list.prod-type  = buf_goods.prod-type and
     1027                    old_price-list.prod-code  = buf_goods.prod-code and
     1028                    old_price-list.main-price = no,
     1029                   first buf_bar-code no-lock where
     1030                         buf_bar-code.b-code   = old_price-list.b-code and
     1031                         buf_bar-code.in-code  = "" and
     1032                         buf_bar-code.unit-cli = buf_goods.unit-base
     1033                         :
     1034                          run check-use-bar-code (buf_bar-code.b-code) no-error .
     1035                          if error-status :error then next.
     1036                    run create-line-pdf-mpl-lib (
     1037                          input buf_price-doc-forming.plt-db-num
     1038                         ,input buf_price-doc-forming.plt-id
     1039                         ,input buf_price-doc-forming.pdf-db
     1040                         ,input buf_price-doc-forming.pdf-id
     1041                         ,input p-line-num
     1042                         ,input old_price-list.b-code
     1043                         ,input buf_goods.artic
     1044                         ,input buf_goods.prod-type
     1045                         ,input buf_goods.prod-code
     1046                         ,input ""
     1047                         ,input 0
     1048                         ,input old_price-list.price-sale
     1049                         ,input ""
     1050                         ,input 0
     1051                       ,input-output v-sec ) no-error .
     1052           end.
     1053       end.
     1054   end.
     1055   end.
     1056   end procedure.
     1057   procedure copy_new_price-doc-forming :
     1058   define input  parameter       p-recid      as recid no-undo .
     1059   define input-output parameter p-plt-db-num as integer   no-undo .
     1060   define input-output parameter p-plt-id     as integer   no-undo .
     1061   define output parameter       p-pdf-db-num as integer   no-undo .
     1062   define output parameter       p-pdf-id     as integer   no-undo .
     1063   define buffer buf_price-list-type        for ub.price-list-type  .
     1064   define buffer buf_price-doc-forming      for ub.price-doc-forming .
     1065   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr .
     1066   define buffer buf_price-doc-forming-gds  for ub.price-doc-forming-gds .
     1067   define buffer buf_pd-forming-gds-attr    for ub.price-doc-forming-gdsattr .
     1068   define variable v-host-code  as integer   no-undo .
     1069   define variable v-base-rate  as decimal   no-undo .
     1070   define variable v-base-scale as integer   no-undo .
     1071   define variable v-exch-rate  as decimal   no-undo .
     1072   define variable v-exch-scale as integer   no-undo .
     1073   define variable v-base as logical   no-undo .
     1074   define variable v-name as character no-undo .
     1075     do
     1076     on error undo, return error return-value
     1077     :
     1078   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1079   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     1080     (output v-base
     1081     )  .
     1082   find first buf_price-list-type no-lock where
     1083              buf_price-list-type.plt-db-num = p-plt-db-num and
     1084              buf_price-list-type.plt-id     = p-plt-id no-error .
     1085   if error-status :error then return error "Не найден ТПЛ".
     1086   if buf_price-list-type.stts <> 0 then return error "ТПЛ удален" .
     1087   find first buf_price-doc-forming  no-lock where recid(buf_price-doc-forming )  = p-recid no-error .
     1088       if available buf_price-doc-forming then do :
     1089           assign
     1090             v-base-rate  = buf_price-doc-forming.base-rate
     1091             v-base-scale = buf_price-doc-forming.base-scale
     1092             v-name       =  substitute("Скопировано с ДНЦ &1 &2",  buf_price-doc-forming.pdf-id , trim(buf_price-doc-forming.name)  )
     1093           .
     1094       end.
     1095       else do:
     1096           assign
     1097             v-base-rate  = 1
     1098             v-base-scale = 1
     1099             v-name       = "Автосоздание"
     1100           .
     1101       end.
     1102      create ub.price-doc-forming.
     1103      assign
     1104         ub.price-doc-forming.plt-id       = p-plt-id
     1105         ub.price-doc-forming.plt-db-num   = p-plt-db-num
     1106         ub.price-doc-forming.pdf-id       = next-value ( s-pdf , ub)
     1107         ub.price-doc-forming.pdf-db       = v-cntxt-db-num
     1108         ub.price-doc-forming.base-rate    = v-base-rate
     1109         ub.price-doc-forming.base-scale   = v-base-scale
     1110         ub.price-doc-forming.db-num-chg   = v-cntxt-db-num
     1111         ub.price-doc-forming.exch-rate    = if v-base then v-base-rate else 1
     1112         ub.price-doc-forming.exch-scale   = if v-base then v-base-scale else 1
     1113         ub.price-doc-forming.stts         = 0
     1114         ub.price-doc-forming.sys-date     = today
     1115         ub.price-doc-forming.sys-time     = time
     1116         ub.price-doc-forming.sys-time-chr = string ( ub.price-doc-forming.sys-time , "hh:mm" )
     1117         ub.price-doc-forming.who          = v-cntxt-userid
     1118         ub.price-doc-forming.name         = v-name
     1119      .
     1120      assign
     1121       p-pdf-db-num  = ub.price-doc-forming.pdf-db
     1122       p-pdf-id      = ub.price-doc-forming.pdf-id
     1123       p-plt-db-num  = ub.price-doc-forming.plt-db-num
     1124       p-plt-id      = ub.price-doc-forming.plt-id
     1125      .
     1126     end.
     1127     if not available buf_price-doc-forming then return .
     1128   for each buf_price-doc-forming-attr no-lock where
     1129            buf_price-doc-forming-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     1130            buf_price-doc-forming-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     1131            buf_price-doc-forming-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     1132            buf_price-doc-forming-attr.plt-id      = buf_price-doc-forming.plt-id       :
     1133       create ub.price-doc-forming-attr.
     1134       buffer-copy buf_price-doc-forming-attr to ub.price-doc-forming-attr
     1135       assign
     1136         ub.price-doc-forming-attr.plt-db-num  = p-plt-db-num
     1137         ub.price-doc-forming-attr.plt-id      = p-plt-id
     1138         ub.price-doc-forming-attr.pdf-db     = p-pdf-db-num
     1139         ub.price-doc-forming-attr.pdf-id      = p-pdf-id
     1140         .
     1141   end.
     1142   for each buf_price-doc-forming-gds no-lock where
     1143            buf_price-doc-forming-gds.pdf-db      = buf_price-doc-forming.pdf-db       and
     1144            buf_price-doc-forming-gds.pdf-id      = buf_price-doc-forming.pdf-id       and
     1145            buf_price-doc-forming-gds.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     1146            buf_price-doc-forming-gds.plt-id      = buf_price-doc-forming.plt-id       :
     1147       create ub.price-doc-forming-gds.
     1148       buffer-copy buf_price-doc-forming-gds to ub.price-doc-forming-gds
     1149       assign
     1150         ub.price-doc-forming-gds.plt-db-num  = p-plt-db-num
     1151         ub.price-doc-forming-gds.plt-id      = p-plt-id
     1152         ub.price-doc-forming-gds.pdf-db      = p-pdf-db-num
     1153         ub.price-doc-forming-gds.pdf-id      = p-pdf-id
     1154       .
     1155   end.
     1156   for each buf_pd-forming-gds-attr no-lock where
     1157            buf_pd-forming-gds-attr.pdf-db      = buf_price-doc-forming.pdf-db       and
     1158            buf_pd-forming-gds-attr.pdf-id      = buf_price-doc-forming.pdf-id       and
     1159            buf_pd-forming-gds-attr.plt-db-num  = buf_price-doc-forming.plt-db-num   and
     1160            buf_pd-forming-gds-attr.plt-id      = buf_price-doc-forming.plt-id       :
     1161       create ub.price-doc-forming-gdsattr.
     1162       buffer-copy buf_pd-forming-gds-attr to ub.price-doc-forming-gdsattr
     1163       assign
     1164         ub.price-doc-forming-gdsattr.plt-db-num  = p-plt-db-num
     1165         ub.price-doc-forming-gdsattr.plt-id      = p-plt-id
     1166         ub.price-doc-forming-gdsattr.pdf-db      = p-pdf-db-num
     1167         ub.price-doc-forming-gdsattr.pdf-id      = p-pdf-id
     1168       .
     1169   end.
     1170   end procedure.
