      915   define input  parameter par-pr-altex as character no-undo .
      916   define input  parameter par-pr-sclex as character no-undo .
      917   define input  parameter p-line-num    as integer   no-undo .
      918   define input  parameter p-gds-code    as integer   no-undo .
      919   define input  parameter p-price-sale  as decimal   no-undo .
      920   define buffer buf_price-doc-forming for ub.price-doc-forming  .
      921   define buffer buf_goods for ub.goods  .
      922   define buffer buf_bar-code for ub.bar-code  .
      923   define buffer main_bar-code for ub.bar-code  .
