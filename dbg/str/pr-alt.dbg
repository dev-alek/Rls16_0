     4399   PROCEDURE add-alt :
     4400   define input  parameter add-list as character  no-undo.
     4401   define variable rec-list as character     no-undo.
     4402   define variable num-rec  as integer no-undo.
     4403   run ref/alt-cds.w  ( parParentProc
     4404                   ,input price-doc.obj-type
     4405                   ,input price-doc.obj-code
     4406                   ,input (mode + "-" + add-list)
     4407                   ,input base-goods.gds-code
     4408                   ,input base-bc
     4409                   ,output rec-list).
     4410   apply "entry" to br-alt in frame d-pr-alt.
     4411   if rec-list = '' then
     4412     return no-apply.
     4413   code-rec = ?.
     4414   define variable v-1 as integer   no-undo .
     4415   v-1 = num-entries (rec-list) .
     4416   do num-rec = 1 to v-1 :
     4417     ref-rec = integer (entry (num-rec, rec-list)).
     4418     find bar-code no-lock where
     4419          recid (bar-code) = ref-rec.
     4420     run cre-pr-list (input  bar-code.b-code,
     4421                      input  price-doc.doc-num,
     4422                      output code-rec) no-error.
     4423     if error-status:error then do:
     4424       message
     4425         "Ошибка cre-pr-list." skip
     4426         "Код:" bar-code.b-code
     4427         view-as alert-box.
     4428       next.
     4429     end.
     4430     run calc-pr-alt (input price-doc.doc-num,
     4431                      input bar-code.b-code,
     4432                      input round-method,
     4433                      input round-base) no-error.
     4434     if error-status:error then
     4435       next.
     4436   end.
     4437   doc-mode = 'ИЗМЕНЕНИЕ':U.
     4438   run open-br.
     4439   END PROCEDURE.
     4440   procedure upd-br-field:
     4441     find current price-list.
     4442     if decimal  (price-list.price-sale :screen-value in browse br-alt) <> price-list.price-sale then do:
     4443       assign
     4444         price-list.calc-method = 'Отсутствует':U
     4445         price-list.price-calc = price-list.price-sale
     4446         price-list.price-sale = decimal  (price-list.price-sale :screen-value in browse br-alt)
     4447         .
     4448       if price-list.d-pcnt = ? then do:
     4449       end.
     4450     end.
     4451     else do:
     4452       if decimal  (price-list.d-pcnt     :screen-value in browse br-alt) <> price-list.d-pcnt then do:
     4453         price-list.d-pcnt     = decimal  (price-list.d-pcnt     :screen-value in browse br-alt).
     4454         if price-list.d-pcnt <> ? then do:
     4455             run calc-pr-alt (input price-doc.doc-num,
     4456                              input price-list.b-code,
     4457                              input round-method,
     4458                              input round-base) no-error.
     4459             if error-status:error then
     4460                return error.
     4461         end.
     4462       end.
     4463       else
     4464         assign
     4465           price-list.road-tax   = decimal  (price-list.road-tax   :screen-value in browse br-alt)
     4466           price-list.excise     = decimal  (price-list.excise     :screen-value in browse br-alt)
     4467           .
     4468     end.
     4469   end procedure.
     4470   procedure exp-prt:
     4471     define input  parameter  g-code  like ub.goods.gds-code    no-undo.
     4472     define input  parameter  old-num like ub.price-doc.doc-num no-undo.
     4473     define input  parameter  new-num like ub.price-doc.doc-num no-undo.
     4474     define output parameter  new-rec as recid               no-undo.
     4475     define buffer buf-bar-code   for ub.bar-code.
     4476     define buffer buf-goods      for ub.goods.
     4477     define buffer buf-price-list for ub.price-list.
     4478     find buf-goods no-lock where
     4479         buf-goods.gds-code = g-code.
     4480     if par-pr-altex = "yes" and
     4481        par-pr-notls = "yes" then do:
     4482   define variable vss-include-info70 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4483   for each  buf-price-list where
     4484             buf-price-list.doc-num    = old-num and
     4485             buf-price-list.artic      = buf-goods.artic and
     4486             buf-price-list.prod-type  = buf-goods.prod-type and
     4487             buf-price-list.prod-code  = buf-goods.prod-code and
     4488             buf-price-list.main-price = no,
     4489       first buf-bar-code no-lock where
     4490             buf-bar-code.b-code   = buf-price-list.b-code and
     4491             buf-bar-code.unit-cli <> buf-goods.unit-base:
     4492     run cre-pr-list (input  buf-bar-code.b-code,
     4493                      input  new-num,
     4494                      output new-rec) no-error.
     4495     if error-status:error then do:
     4496       message
     4497         "Ошибка cre-pr-list." skip
     4498         "Код:" buf-bar-code.b-code
     4499         view-as alert-box.
     4500       next.
     4501     end.
     4502   end.
     4503     end.
     4504     if par-pr-sclex = "yes" and
     4505       par-pr-notls = "yes" then do:
     4506   define variable vss-include-info71 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4507       define buffer buf_alt-calc_price-doc72 for ub.price-doc .
     4508     find first buf_alt-calc_price-doc72 no-lock
     4509       where buf_alt-calc_price-doc72.doc-num = old-num
     4510       .
     4511     define variable v-ok as logical   no-undo .
     4512   define variable vss-include-info73 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4513   do:
     4514     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4515       (input  v-cntxt-db-num
     4516       ,input  v-cntxt-userid
     4517       ,input  0
     4518       ,input  'actn_overvalue_properties':U
     4519       ,input  'object':U
     4520       ,input  buf_alt-calc_price-doc72.host-code
     4521       ,input  buf_alt-calc_price-doc72.obj-type
     4522       ,input  buf_alt-calc_price-doc72.obj-code
     4523       ,input  0
     4524       ,input  0
     4525       ,input  0
     4526       ,input  false
     4527       ,output v-ok
     4528       )  .
     4529   end.
     4530     if v-ok then do:
     4531   for each  buf-price-list where
     4532             buf-price-list.doc-num    = old-num and
     4533             buf-price-list.artic      = buf-goods.artic and
     4534             buf-price-list.prod-type  = buf-goods.prod-type and
     4535             buf-price-list.prod-code  = buf-goods.prod-code and
     4536             buf-price-list.main-price = no,
     4537       first buf-bar-code no-lock where
     4538             buf-bar-code.b-code   = buf-price-list.b-code and
     4539             buf-bar-code.in-code = "" and
     4540             buf-bar-code.unit-cli = buf-goods.unit-base:
     4541     run cre-pr-list (input  buf-bar-code.b-code,
     4542                      input  new-num,
     4543                      output new-rec) no-error.
     4544     if error-status:error then do:
     4545       message
     4546         "Ошибка cre-pr-list." skip
     4547         "Код:" buf-bar-code.b-code
     4548         view-as alert-box.
     4549       next.
     4550     end.
     4551   end.
     4552   end.
     4553     end.
     4554     end procedure.
     4555   def var vss-include-info74 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4556   procedure tax-name:
     4557   define input  parameter pardef-tax  as character           no-undo.
     4558   define output parameter parname-tax as character initial ? no-undo.
     4559   define buffer bf_tax for ub.tax.
     4560   do on error undo, return error :
     4561      case pardef-tax:
     4562         when 'vat':U then do:
     4563                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
     4564         end.
     4565         when 'slt':U then do:
     4566                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
     4567         end.
     4568         when 'rdt':U then do:
     4569                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
     4570         end.
     4571         when 'exc':U then do:
     4572                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
     4573         end.
     4574         otherwise do:
     4575            return error "Задан неверный параметр " + pardef-tax + " .".
     4576         end.
     4577      end case.
     4578   end.
     4579   end procedure.
