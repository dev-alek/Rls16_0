     3423   if not available price-list then do:
     3424     message "Неправильно выбрана строка."
     3425             view-as alert-box error.
     3426     return no-apply.
     3427   end.
     3428   assign
     3429     code-rec = recid (price-list)
     3430     g#log = no
     3431     .
     3432   message "Удалить строку документа?   Вы уверены?"
     3433           view-as alert-box question buttons OK-Cancel update g#log.
     3434   if not g#log then
     3435     return no-apply.
     3436   get next br-alt.
     3437   if available price-list then
     3438     rep-rec = recid (price-list).
     3439   else do:
     3440     reposition br-alt to recid code-rec no-error.
     3441     get prev br-alt.
     3442     if available price-list then
     3443       rep-rec = recid (price-list).
     3444   end.
     3445   reposition br-alt to recid code-rec no-error.
     3446   find price-list where recid (price-list) = code-rec.
     3447   delete price-list.
     3448   code-rec = rep-rec.
     3449   doc-mode = 'ИЗМЕНЕНИЕ':U.
     3450   run open-br.
     3451   END.
     3452   ON value-changed OF round-method IN FRAME d-pr-alt DO:
     3453   assign
     3454     round-method.
     3455   run UI-on.
     3456   END.
     3457   ON LEAVE OF round-base IN FRAME d-pr-alt DO:
     3458   if input frame d-pr-alt round-base = 0 then do:
     3459     if input frame d-pr-alt round-method = 'Произвольно':U then
     3460       message "Такое округление невозможно - деление на 0."
     3461               view-as alert-box error.
     3462     else
     3463       message "Пересчет по нулевому коэффициенту невозможен - получится 0."
     3464               view-as alert-box error.
     3465   end.
     3466   else
     3467     assign
     3468       round-base.
     3469   disp round-base with frame d-pr-alt.
     3470   END.
     3471   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-pr-alt:PARENT eq ? THEN
     3472     FRAME d-pr-alt:PARENT = ACTIVE-WINDOW.
     3473   ON WINDOW-CLOSE OF FRAME d-pr-alt APPLY "END-ERROR":U TO SELF.
     3474   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3475   on help of frame d-pr-alt
     3476   do:
     3477     run gbl/app_help.p
     3478       (input this-procedure :file-name
     3479       ,input ''
     3480       ,input ?
     3481       ) no-error.
     3482     if error-status :error then do:
     3483       message
     3484         "Ошибка при вызове помощи"
     3485         error-status :get-message(1)
     3486         view-as alert-box .
     3487     end.
     3488   end.
     3489   run minbtn-set in this-procedure .
     3490   on choose of b-help in frame d-pr-alt
     3491   do:
     3492     apply "help":u to frame d-pr-alt .
     3493   end.
     3494   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3495   procedure minbtn-set :
     3496       do
     3497           on error undo, return error return-value
     3498           :
     3499           define variable ii              as integer       no-undo .
     3500           define variable fh              as widget-handle no-undo .
     3501           define variable hh              as widget-handle no-undo .
     3502           define variable v-h             as handle        extent 4 no-undo .
     3503           define variable v-name-button   as character     no-undo .
     3504           define variable v-help-old-x    as decimal       no-undo .
     3505           define variable v-help-old-y    as decimal       no-undo .
     3506           define variable v-help-old-size as decimal       no-undo .
     3507           define variable v-frame-width   as decimal       no-undo .
     3508           define variable jj              as integer       no-undo .
     3509           do
     3510               on error undo, return error
     3511               :
     3512               assign
     3513                   v-frame-width = frame d-pr-alt:width - 0.3
     3514                   fh            = frame d-pr-alt:first-child
     3515                   hh            = fh:first-child
     3516                   ii            = 1
     3517                   .
     3518               do while valid-handle(hh):
     3519                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3520                   do:
     3521                       case lc(hh:name) :
     3522                           when "b-help" then
     3523                               do:
     3524                                   hh:load-image-up("cmp/b-help.bmp":u) .
     3525                                   hh:load-image-down("cmp/b-help.bmp":u) .
     3526                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     3527                                   hh:TOOLTIP = "Помощь" .
     3528                                   v-help-old-x = hh:column .
     3529                                   v-help-old-y = hh:row    .
     3530                                   v-help-old-size = hh:width .
     3531                                   hh:width-chars = 2.5 .
     3532                               end.
     3533                           when "b-print" then
     3534                               do:
     3535                                   hh:load-image("cmp/b-print.bmp":u) .
     3536                                   hh:TOOLTIP = "Печать" .
     3537                                   v-h[ii] = hh:handle .
     3538                                   ii = ii + 1 .
     3539                                   hh:width-chars = 3 .
     3540                               end.
     3541                           when "b-history" or
     3542                           when "b-hist" then
     3543                               do:
     3544                                   hh:load-image("cmp/b-hist.bmp":u) .
     3545                                   hh:TOOLTIP = "История" .
     3546                                   v-h[ii] = hh:handle .
     3547                                   ii = ii + 1 .
     3548                                   hh:width-chars = 3 .
     3549                               end.
     3550                           when "b-sch" then
     3551                               do:
     3552                                   hh:load-image("cmp/b-sch.bmp":u) .
     3553                                   hh:TOOLTIP = "Установка Фильтра" .
     3554                                   v-h[ii] = hh:handle .
     3555                                   ii = ii + 1 .
     3556                                   hh:width-chars = 3 .
     3557                               end.
     3558                           when "b-hist-user" then
     3559                               do:
     3560                                   hh:load-image("cmp/b-hist.bmp":u) .
     3561                                   hh:TOOLTIP = "История пользователя" .
     3562                                   ii = ii + 1 .
     3563                               end.
     3564                       end case.
     3565                   end.
     3566                   hh = hh:next-sibling.
     3567               end.
     3568               b-help:column = v-frame-width - b-help:width-chars.
     3569               jj = 0.
     3570               repeat ii = 4 to 1 by -1 :
     3571                   if valid-handle (v-h[ii] ) then
     3572                   do:
     3573                       jj  = jj + 1 .
     3574                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3575                       v-h[ii]:row    = v-help-old-y .
     3576                   end.
     3577               end.
     3578           end.
     3579       end.
     3580   end procedure.
     3581   MAIN-BLOCK:
     3582   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3583      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3584      run tax-name( input 'rdt':U, output  dor-nal) .
     3585      assign price-list.road-tax :label  = dor-nal.
     3586     if doc-mode <> 'ПРОСМОТР':U then
     3587       code-rec = ?.
     3588     find  price-doc no-lock where
     3589           recid (price-doc) = doc-rec.
     3590      define variable l-par as logical   no-undo .
     3591      run chec-par in this-procedure (
     3592            output l-par
     3593           ,input  price-doc.host-code
     3594           ,input  price-doc.obj-type
     3595           ,input  price-doc.obj-code
     3596         ) no-error .
     3597     find  base-bar-code no-lock where
     3598           base-bar-code.b-code = base-bc no-error.
     3599     if available base-bar-code then
     3600       find base-goods no-lock where
     3601            base-goods.gds-code = base-bar-code.gds-code.
     3602     case mode:
     3603       when "code" then do:
     3604       end.
     3605       when "scl-gds" then do:
     3606       end.
     3607       when "par-gds" then do:
     3608       end.
     3609       when "scl-doc" then do:
     3610       end.
     3611       when "par-doc" then do:
     3612       end.
     3613       when "doc" then do:
     3614       end.
     3615     end case.
     3616     run UI-on.
     3617     run open-br.
     3618     WAIT-FOR GO OF FRAME d-pr-alt focus br-alt.
     3619   END.
     3620   RUN disable_UI.
     3621   PROCEDURE disable_UI :
     3622     HIDE FRAME d-pr-alt.
     3623   END PROCEDURE.
     3624   PROCEDURE UI-on :
     3625   doc-rec = recid (price-doc).
     3626   disable all with frame d-pr-alt.
     3627   hide loc-art loc-name loc-code in frame d-pr-alt.
     3628   loc-art = "".
     3629   enable a-n-c b-exit b-help br-alt with frame d-pr-alt.
     3630   frame d-pr-alt:title = "Список неосновных цен переоценки № " + price-doc.doc-num.
     3631   case mode:
     3632     when "code"    then
     3633       frame d-pr-alt:title = frame d-pr-alt:title +
     3634                                   "      Код: " + string (base-bc, ">>>>>>>>9").
     3635     when "scl-gds" then
     3636       frame d-pr-alt:title = frame d-pr-alt:title +
     3637                                   "      Товар: " + base-goods.artic + "  " + base-goods.gds-name +
     3638                                   "      ПРИЗНАКИ".
     3639     when "par-gds" then
     3640       frame d-pr-alt:title = frame d-pr-alt:title +
     3641                                   "      Товар: " + base-goods.artic + "  " + base-goods.gds-name +
     3642                                   "      ПАРТИИ".
     3643     when "scl-doc" then
     3644       frame d-pr-alt:title = frame d-pr-alt:title +
     3645                                   "      ПРИЗНАКИ по переоценке".
     3646     when "par-doc" then
     3647       frame d-pr-alt:title = frame d-pr-alt:title +
     3648                                   "      ПАРТИИ по переоценке".
     3649     when "doc"     then
     3650       frame d-pr-alt:title = frame d-pr-alt:title +
     3651                                   "      Вся переоценка".
     3652   end.
     3653   frame d-pr-alt:title = frame d-pr-alt:title + "              " +
     3654                               doc-mode.
     3655   if doc-mode = 'ПРОСМОТР':U then do:
     3656     assign
     3657       price-list.d-pcnt :read-only in browse br-alt = yes price-list.price-sale :read-only in browse br-alt = yes price-list.road-tax :read-only in browse br-alt = yes price-list.excise :read-only in browse br-alt = yes
     3658       .
     3659     hide round-method in frame d-pr-alt.
     3660   end.
     3661   else do:
     3662     assign
     3663       price-list.d-pcnt :read-only in browse br-alt = no price-list.price-sale :read-only in browse br-alt = no price-list.road-tax :read-only in browse br-alt = no price-list.excise :read-only in browse br-alt = no
     3664       .
     3665     disp round-method round-base with frame d-pr-alt.
     3666     if lookup (mode, "code,scl-gds,par-gds") > 0 then
     3667       enable b-add with frame d-pr-alt.
     3668     enable b-mark b-discnt b-chg b-del round-method with frame d-pr-alt.
     3669     if lookup( input frame d-pr-alt round-method, 'Произвольно,Вверх,Коэффициент,9-99окончание':U ) > 0 then do:
     3670       enable round-base with frame d-pr-alt.
     3671       disp round-base with frame d-pr-alt.
     3672     end.
     3673     else
     3674       hide round-base in frame d-pr-alt.
     3675   end.
     3676   apply "entry" to br-alt in frame d-pr-alt.
     3677   END PROCEDURE.
     3678   PROCEDURE open-br :
     3679   define variable l-query-was-opened as logical no-undo .
     3680   define variable sort-column-phrase as character     no-undo .
     3681   define variable d-num like price-doc.doc-num  no-undo.
     3682   assign
     3683     l-query-was-opened = false
     3684     d-num = price-doc.doc-num
     3685     .
     3686   if sort-column-name = "" then
     3687      sort-column-phrase = "" .
     3688   else
     3689     sort-column-phrase = "by " + sort-column-name.
     3690   if available price-list then
