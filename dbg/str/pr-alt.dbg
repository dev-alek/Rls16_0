      185   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      186     run mainmenu_getcntxt in parparentproc
      187       (output v-cntxp-db-num
      188       ,output v-cntxp-userid
      189       ,output v-cntxp-level
      190       ,output v-cntxp-curr-host-code
      191       ,output v-cntxp-obj-type
      192       ,output v-cntxp-obj-code
      193       ,output v-cntxp-db-num-obj
      194       ,output v-cntxp-is-admin
      195       ) .
      196     if (v-cntxp-obj-type = 'маг':U or v-cntxp-obj-type = 'скл':U) and
      197        v-cntxp-obj-code <> 0 then do:
      198   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      199     (input  'is-prt'
      200     ,input  0
      201     ,input  ''
      202     ,input  0
      203     ,input  ''
      204     ,input  ''
      205     ,input  ''
      206     ,input  yes
      207     ,output v-cntxp-conf-par
      208     ,output v-cntxp-par-type
      209     ) no-error .
      210       case v-cntxp-obj-type :
      211         when 'скл':U then do:
      212           find first bf-cntxp_store where bf-cntxp_store.obj-code = v-cntxp-obj-code no-lock.
      213           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_store.host-code no-lock.
      214           assign
