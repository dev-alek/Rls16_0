        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input  parameter parobj-type like ub.clients.obj-type no-undo.
        3   define input  parameter parobj-code like ub.clients.obj-code no-undo.
        4   define output parameter parrec-id as recid initial ? no-undo.
        5   def var vss-revision    as character no-undo init "$Revision$":U .
        6   def var vss-author      as character no-undo init "$Author$":U .
        7   def var vss-date        as character no-undo init "$Date$":U .
        8   def var vss-workfile    as character no-undo init "$Workfile$":U .
        9   def var vss-archive     as character no-undo init "$Archive$":U .
       10   def var vss-description as character no-undo init "Диалог на добавление связки резервуар-ТРК".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   procedure proc-alt-shift-f2:
       81     if not ibs.th.gbl.gbl-var:rcode
       82   then
       83     run gbl\inidebug.p .
       84   end.
       85   procedure proc-alt-shift-f3:
       86     run gbl/prvssinf.p
       87       ( input this-procedure
       88       ) .
       89   end.
       90   define variable v-inform-launched as logical no-undo initial false .
       91   procedure proc-alt-shift-f4:
       92     define variable v-action as character no-undo .
       93     if v-inform-launched = false then do:
       94       assign
       95         v-inform-launched = true
       96       .
       97       run gbl/d-inform.w
       98         (  input self
       99         ,  input this-procedure
      100         , output v-action
      101         ) no-error .
      102       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      103       assign
      104         v-inform-launched = false
      105       .
      106     end.
      107   end.
      108   procedure proc-alt-f1:
      109     run gbl/corrhelp.p
      110       (input this-procedure
      111       ) .
      112   end .
      113   on alt-shift-f2 anywhere do:
      114     run proc-alt-shift-f2.
      115   end.
      116   on alt-shift-f3 anywhere do:
      117     run proc-alt-shift-f3 in this-procedure .
      118   end.
      119   on alt-shift-f4 anywhere do:
      120     run proc-alt-shift-f4 in this-procedure.
      121   end.
      122   on alt-f1 anywhere do:
      123     run proc-alt-f1 in this-procedure .
      124   end.
      125   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      126   function nzpl-spl returns logical
      127   (input p-obj-type as character
      128                                   , input p-obj-code as integer):
      129   define variable v-dopi    as integer no-undo .
      130   define variable v-param-type as character no-undo .
      131   define variable v-value-character as character no-undo .
      132   define variable v-value-date as date no-undo .
      133   define variable v-value-decimal as decimal no-undo .
      134   define variable v-value-integer as integer no-undo .
      135   define variable v-value-logical as logical no-undo .
      136   define variable v-tth as handle no-undo .
      137   define variable dflt-cd as character no-undo .
      138   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      139   define variable v-param-type1 as character no-undo .
      140   define variable v-value-date1 as date no-undo .
      141   define variable v-value-decimal1 as decimal no-undo .
      142   define variable v-value-integer1 as INTEGER no-undo .
      143   define variable v-value-logical1 AS LOGICAL no-undo .
      144   define variable v-tth1 as handle no-undo .
      145   run adm/shattri.p (
      146       input "get":U
      147       ,input  p-obj-type
      148       ,input  p-obj-code
      149       ,input  'cd-sending':U
      150       ,input  'dflt-cd':U
      151       ,output dflt-cd
      152       ,output v-value-date1
      153       ,output v-value-decimal1
      154       ,output v-value-integer1
      155       ,output v-value-logical1
      156       ,output v-param-type1
      157       ,INPUT-OUTPUT table-handle v-tth1
      158       ) no-error .
      159   delete object v-tth1 no-error.
      160   if dflt-cd <> 'IBM':U
      161   and dflt-cd <> 'IBM-XML':U then return no.
      162   if dflt-cd = 'IBM-XML':U then return yes.
      163   run adm/shattri.p (
      164       input "get":U
      165       ,input  p-obj-type
      166       ,input  p-obj-code
      167       ,input  'cd-type-ibm':U
      168       ,input  'ibmspool':U
      169       ,output v-value-character
      170       ,output v-value-date
      171       ,output v-value-decimal
      172       ,output v-value-integer
      173       ,output v-value-logical
      174       ,output v-param-type
      175       ,INPUT-OUTPUT table-handle v-tth
      176       ) no-error .
      177   if error-status:error then do:
      178     delete object v-tth.
      179     return no.
      180   end.
      181   delete object v-tth.
      182   assign
      183   v-dopi = v-value-integer no-error .
      184   if v-dopi >= 6 then return yes.
      185   end. // FUNCTION/method
      186   FUNCTION nzpl-two returns logical
      187                                    (input p-obj-type as character
      188                                     , input p-obj-code as integer):
      189     define variable v-nzpl-two as logical no-undo.
      190     run
      191     nzpl-two-proc (input p-obj-type, input p-obj-code, output v-nzpl-two).
      192     return v-nzpl-two.
      193   end. // FUNCTION/method
      194   procedure nzpl-two-proc :
      195   define input  parameter p-obj-type   as character no-undo.
      196   define input  parameter p-obj-code   as integer   no-undo.
      197   define output parameter varge-two-pl as logical   no-undo.
      198   define buffer bf_pl-gds-pump       for ub.pl-gds-pump.
      199   define buffer bf-other_pl-gds-pump for ub.pl-gds-pump.
      200   //do on error undo, return error return-value :
      201   assign
      202     varge-two-pl = no.
      203   for each bf_pl-gds-pump where bf_pl-gds-pump.obj-type = p-obj-type        and
      204                                 bf_pl-gds-pump.obj-code = p-obj-code        and
      205                                 bf_pl-gds-pump.status_  = 'тек':U no-lock on error undo, return error return-value :
      206     find first bf-other_pl-gds-pump where bf-other_pl-gds-pump.obj-type  =  bf_pl-gds-pump.obj-type  and
      207                                           bf-other_pl-gds-pump.obj-code  =  bf_pl-gds-pump.obj-code  and
      208                                           bf-other_pl-gds-pump.pump-code =  bf_pl-gds-pump.pump-code and
      209                                           bf-other_pl-gds-pump.gds-code  =  bf_pl-gds-pump.gds-code  and
      210                                           bf-other_pl-gds-pump.status_   =  'тек':U        and
      211                                           bf-other_pl-gds-pump.pl-code   <> bf_pl-gds-pump.pl-code   no-lock no-error.
      212     if available bf-other_pl-gds-pump then do:
      213       assign
      214         varge-two-pl = yes.
      215       leave.
      216     end.
      217   end.
      218   //end.
      219   end. // procedure/method .
      220   procedure cplgdspm :
      221     define input parameter parobj-type  like ub.pl-gds-pump.obj-type  no-undo.
      222     define input parameter parobj-code  like ub.pl-gds-pump.obj-code  no-undo.
      223     define input parameter parpl-code   like ub.pl-gds-pump.pl-code   no-undo.
      224     define input parameter pargds-code  like ub.pl-gds-pump.gds-code  no-undo.
      225     define input parameter parpump-code like ub.pl-gds-pump.pump-code no-undo.
      226     define input parameter parstatus    like ub.pl-gds-pump.status_   no-undo.
      227       define buffer bf_pl-gds-pump          for ub.pl-gds-pump.
      228       define buffer bf_pl-pump-nozzle       for ub.pl-pump-nozzle.
      229       define buffer bf-other_pl-pump-nozzle for ub.pl-pump-nozzle.
      230       define buffer bf-place                for ub.place.
      231       if parstatus = 'тек':U then do:
      232         for each bf_pl-gds-pump no-lock
      233           where bf_pl-gds-pump.obj-type  =  parobj-type
      234             and bf_pl-gds-pump.obj-code  =  parobj-code
      235             and bf_pl-gds-pump.gds-code  =  pargds-code
      236             and bf_pl-gds-pump.pump-code =  parpump-code
      237             and bf_pl-gds-pump.pl-code   <> parpl-code
      238             and bf_pl-gds-pump.status_   =  'тек':U
      239         on error undo, return error
      240         :
      241           find first place where
      242                      place.obj-type = parobj-type
      243                  and place.obj-code = parobj-code
      244                  and place.pl-code  = parpl-code
      245                no-lock no-error.
      246           find first bf-place where
      247                      bf-place.obj-type = parobj-type
      248                  and bf-place.obj-code = parobj-code
      249                  and bf-place.pl-code = bf_pl-gds-pump.pl-code
      250                no-lock no-error.
      251           if nzpl-spl(parobj-type, parobj-code) <> yes then do:
      252             return error substitute( "Попытка создать запись на объекте &1 &2 резервуар &3 товар с внутренним кодом &4 ТРК &5 статус &6.&7"
      253                                        ,parobj-type
      254                                        ,parobj-code
      255                                        ,if available place then place.loc1 else string(parpl-code)
      256                                        ,pargds-code
      257                                        ,parpump-code
      258                                        ,parstatus
      259                                        ,chr(10)
      260                                       )
      261                         + substitute( "КАССА не возвращает номер пистолета в чеке, а на объекте уже есть резервуар &1 с тем же товаром и связан он с этой же ТРК."
      262                                       ,if available bf-place then bf-place.loc1 else string(bf_pl-gds-pump.pl-code)
      263                                     ).
      264           end.
      265           else do:
      266             find first bf_pl-pump-nozzle no-lock
      267               where bf_pl-pump-nozzle.obj-type  = parobj-type
      268                 and bf_pl-pump-nozzle.obj-code  = parobj-code
      269                 and bf_pl-pump-nozzle.pump-code = parpump-code
      270                 and bf_pl-pump-nozzle.pl-code   = parpl-code
      271               no-error.
      272             if available bf_pl-pump-nozzle then do:
      273               find first bf-other_pl-pump-nozzle no-lock
      274                 where bf-other_pl-pump-nozzle.obj-type  = bf_pl-gds-pump.obj-type
      275                   and bf-other_pl-pump-nozzle.obj-code  = bf_pl-gds-pump.obj-code
      276                   and bf-other_pl-pump-nozzle.pump-code = bf_pl-gds-pump.pump-code
      277                   and bf-other_pl-pump-nozzle.pl-code   = bf_pl-gds-pump.pl-code
      278                 no-error.
      279               if available bf-other_pl-pump-nozzle
      280                 and bf-other_pl-pump-nozzle.nozzle-code = bf_pl-pump-nozzle.nozzle-code
      281               then do:
      282                 return error substitute( "Попытка создать запись на объекте &1 &2 резервуар &3 товар с внутренним кодом &4 ТРК &5 статус &6.&7"
      283                                          ,parobj-type
      284                                          ,parobj-code
      285                                          ,if available place then place.loc1 else string(parpl-code)
      286                                          ,pargds-code
      287                                          ,parpump-code
      288                                          ,parstatus
      289                                          ,chr(10)
      290                                        )
      291                             + substitute( "На объекте &1 &2 уже есть запись резервуар &3 в статусе &4, в котором находится этот же товар и он связан с этой же ТРК через этот же пистолет."
      292                                           ,bf_pl-gds-pump.obj-type
      293                                           ,bf_pl-gds-pump.obj-code
      294                                           ,if available bf-place then bf-place.loc1 else string(bf_pl-gds-pump.pl-code)
      295                                           ,bf_pl-gds-pump.status_
      296                                         ).
      297               end.
      298             end.
      299           end.
      300         end.
      301       end.
      302   end . // procedure/method
      303   define variable varmes-log as logical no-undo.
      304   define variable varobj-type like ub.clients.obj-type no-undo.
      305   define variable varobj-code like ub.clients.obj-code no-undo.
      306   define variable varbuttons  as   character        no-undo.
      307   define variable varps-upd   as   logical          no-undo.
      308   procedure plpumpav:
      309     define input parameter parobj-type  like ub.clients.obj-type no-undo.
      310     define input parameter parobj-code  like ub.clients.obj-code no-undo.
      311     define input parameter parpl-code   like ub.place.pl-code    no-undo.
      312     define input parameter parpump-code like ub.pump.pump-code   no-undo.
      313     define buffer bf_clients           for ub.clients.
      314     define buffer bf_pump              for ub.pump.
      315     define buffer bf_place             for ub.place.
      316     define buffer bf_pl-pump           for ub.pl-pump.
      317     define buffer bf_pl-gds            for ub.pl-gds.
      318     define buffer bf_goods             for ub.goods.
      319     define buffer bf_pl-gds-pump       for ub.pl-gds-pump.
      320     define buffer bf-other_pl-gds-pump for ub.pl-gds-pump.
      321     define variable varstatus as character no-undo.
      322   find first bf_clients where bf_clients.obj-type = parobj-type and
      323                               bf_clients.obj-code = parobj-code no-lock no-error.
      324   if not available bf_clients then
      325      return error SUBSTITUTE("Нет такого объекта &1 &2 .", parobj-type, parobj-code).
      326   find first bf_pump where bf_pump.obj-type  = parobj-type  and
      327                            bf_pump.obj-code  = parobj-code  and
      328                            bf_pump.pump-code = parpump-code no-lock no-error.
      329   if not available bf_pump then
      330      return error SUBSTITUTE("Нет ТРК с номером &1", parpump-code) + SUBSTITUTE(" на объекте &1 &2 .", parobj-type, parobj-code).
      331   find first bf_place where bf_place.obj-type = parobj-type and
      332                             bf_place.obj-code = parobj-code and
      333                             bf_place.pl-code  = parpl-code  no-lock no-error.
      334   if not available bf_place then return error SUBSTITUTE("Нет такого складского места &1", parpl-code) + SUBSTITUTE(" на объекте &1 &2 .", parobj-type, parobj-code).
      335     find first bf_pl-pump no-lock
      336       where bf_pl-pump.obj-type   = parobj-type
      337         and bf_pl-pump.obj-code   = parobj-code
      338         and bf_pl-pump.pl-code    = parpl-code
      339         and bf_pl-pump.pump-code  = parpump-code
      340       no-error.
      341     if available bf_pl-pump then do:
      342       return error SUBSTITUTE("Уже есть запись резервуар-ТРК с номером резервуара &1 и номером ТРК &2", parpl-code, parpump-code) + SUBSTITUTE(" на объекте &1 &2 .", parobj-type, parobj-code).
      343     end.
      344     find first bf_pl-gds no-lock
      345       where bf_pl-gds.obj-type = parobj-type
      346         and bf_pl-gds.obj-code = parobj-code
      347         and bf_pl-gds.pl-code  = parpl-code
      348       no-error.
      349     tr:
      350     do transaction
      351     on error undo tr, return error return-value
      352     :
      353       if available bf_pl-gds then do:
      354         find first bf_goods no-lock
      355           where bf_goods.gds-code = bf_pl-gds.gds-code
      356         .
      357         assign
      358           varstatus = 'тек':U
      359         .
      360         find first bf-other_pl-gds-pump no-lock
      361           where bf-other_pl-gds-pump.obj-type  = parobj-type
      362             and bf-other_pl-gds-pump.obj-code  = parobj-code
      363             and bf-other_pl-gds-pump.gds-code  = bf_goods.gds-code
      364             and bf-other_pl-gds-pump.pump-code = parpump-code
      365             and bf-other_pl-gds-pump.status_   = 'тек':U
      366           no-error.
      367         if available bf-other_pl-gds-pump
      368           and nzpl-spl(bf-other_pl-gds-pump.obj-type, bf-other_pl-gds-pump.obj-code) <> yes
      369         then do:
      370           message
      371             "Через ТРК с номером " parpump-code " уже продается топливо " bf_goods.artic " " bf_goods.prod-type " " bf_goods.prod-code " " bf_goods.gds-name
      372             " которое связано с резервуаром " bf-other_pl-gds-pump.pl-code "." skip
      373             "Данная привязка Резервуар-ТРК-Товар получит статус блокированный."
      374             view-as alert-box information.
      375           assign
      376             varstatus = 'блок':U
      377           .
      378         end.
      379         create bf_pl-gds-pump.
      380         assign
      381           bf_pl-gds-pump.obj-type  = parobj-type
      382           bf_pl-gds-pump.obj-code  = parobj-code
      383           bf_pl-gds-pump.pl-code   = parpl-code
      384           bf_pl-gds-pump.gds-code  = bf_goods.gds-code
      385           bf_pl-gds-pump.pump-code = parpump-code
      386           bf_pl-gds-pump.status_   = varstatus
      387         .
      388         run cplgdspm in this-procedure
      389           ( input bf_pl-gds-pump.obj-type
      390            ,input bf_pl-gds-pump.obj-code
      391            ,input bf_pl-gds-pump.pl-code
      392            ,input bf_pl-gds-pump.gds-code
      393            ,input bf_pl-gds-pump.pump-code
      394            ,input bf_pl-gds-pump.status_
      395           ) no-error.
      396         if error-status:error then do:
      397           undo tr, return error substitute ("Ошибка при смене статуса записи резервуар-ТРК-пистолет: &1 &2.", return-value, error-status:get-message(1)).
      398         end.
      399       end.
      400       create bf_pl-pump.
      401       assign
      402         bf_pl-pump.obj-type   = parobj-type
      403         bf_pl-pump.obj-code   = parobj-code
      404         bf_pl-pump.pl-code    = parpl-code
      405         bf_pl-pump.pump-code  = parpump-code
      406       .
      407     end.
      408   end procedure.
      409   define new shared variable list-mode as character no-undo.
      410   DEFINE BUTTON b-cancel AUTO-END-KEY
      411        LABEL "&Отмена"
      412        SIZE 10 BY 1
      413        BGCOLOR 8 .
      414   DEFINE BUTTON b-help
      415        LABEL "Помо&щь"
      416        SIZE 10 BY 1
      417        BGCOLOR 8 .
      418   DEFINE BUTTON b-place
      419        IMAGE-UP FILE "btn-down-arrow":U
      420        IMAGE-DOWN FILE "btn-down-arrow":U
      421        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      422        LABEL ""
      423        SIZE 3 BY .88.
      424   DEFINE BUTTON b-pump
      425        IMAGE-UP FILE "btn-down-arrow":U
      426        IMAGE-DOWN FILE "btn-down-arrow":U
      427        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      428        LABEL ""
      429        SIZE 3 BY .88.
      430   DEFINE BUTTON b-save AUTO-GO
      431        LABEL "&Ввод"
      432        SIZE 10 BY 1
      433        BGCOLOR 8 .
      434   DEFINE VARIABLE varpl-code AS INTEGER FORMAT "99999999999":U INITIAL 0
      435        LABEL "Бар-код резервуара"
      436        VIEW-AS FILL-IN
      437        SIZE 10.38 BY 1 NO-UNDO.
      438   DEFINE VARIABLE varpump-code AS INTEGER FORMAT ">9":U INITIAL 0
      439        LABEL "Номер ТРК"
      440        VIEW-AS FILL-IN
      441        SIZE 3 BY 1 NO-UNDO.
      442   DEFINE FRAME Dialog-Frame
      443        b-save AT ROW 1 COL 1
      444        b-cancel AT ROW 1 COL 11
      445        b-help AT ROW 1 COL 21
      446        varpl-code AT ROW 2.54 COL 2.88
      447        b-place AT ROW 2.67 COL 34
      448        varpump-code AT ROW 3.92 COL 20.88 COLON-ALIGNED
      449        b-pump AT ROW 4 COL 34
      450        SPACE(1.74) SKIP(0.24)
      451       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      452            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      453            TITLE "Добавление  резервуар-ТРК"
      454            DEFAULT-BUTTON b-save CANCEL-BUTTON b-cancel.
      455   ASSIGN
      456          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      457          FRAME Dialog-Frame:HIDDEN           = TRUE.
      458   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      459   DO:
      460     APPLY "END-ERROR":U TO SELF.
      461   END.
      462   ON CHOOSE OF b-place IN FRAME Dialog-Frame
      463   DO:
      464     define variable place-list as character no-undo.
      465     run ref/pl-list.w (
      466                    input parparentproc
      467                   ,input "b-sel"
      468                   ,input parobj-type
      469                   ,input parobj-code
      470                   ,input 'объект':U
      471                   ,input-output place-list).
      472     if place-list = "cancel"
      473     then do :
      474       return no-apply .
      475     end .
      476     if place-list <> '':U then do:
      477        FIND FIRST ub.place No-LOCK WHERE recid(ub.place) = integer(entry(1, place-list)) NO-ERROR.
      478        if available ub.place then display ub.place.pl-code @ varpl-code with frame Dialog-Frame.
      479     end.
      480   END.
      481   ON CHOOSE OF b-pump IN FRAME Dialog-Frame
      482   DO:
      483     define variable varrec-id_pump as recid initial ? no-undo.
      484     define buffer bf_pump for ub.pump.
      485     run str/pumprf.w
      486       ( input parparentproc
      487        ,input  parobj-type
      488        ,input  parobj-code
      489        ,output varrec-id_pump
      490       ).
      491     if varrec-id_pump <> ? then do:
      492        find first bf_pump where recid(bf_pump) = varrec-id_pump no-lock no-error.
      493        if available bf_pump then do:
      494           display bf_pump.pump-code @ varpump-code with frame Dialog-Frame.
      495        end.
      496     end.
      497   END.
      498   ON CHOOSE OF b-save IN FRAME Dialog-Frame
      499   DO:
      500   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      501   if lookup(self :type
      502            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      503            ) = 0
      504   then do:
      505     message
      506       "$Workfile$"
      507       "Указанному интерфейсному элементу фокус не может быть передан" skip
      508       "Интерфейсный элемент" self :name  skip
      509       "Тип" self :type  skip
      510       "Процедура" this-procedure :file-name skip
      511       view-as alert-box .
      512   end.
      513   else do:
      514     apply "entry":u to self  .
      515     if focus :handle <> self :handle  then do:
      516       return no-apply .
      517     end.
      518   end.
      519     assign frame Dialog-Frame varpl-code varpump-code .
      520     run plpumpav in this-procedure
      521                  (input parobj-type,
      522                   input parobj-code,
      523                   input varpl-code,
      524                   input varpump-code) no-error.
      525     if error-status:error then do:
      526   message
      527     vss-workfile vss-revision vss-description skip
      528     "Ошибка при создании записи резервуар-ТРК" skip
      529     "-----------Cистемная ошибка------------" skip
      530     return-value skip
      531     "------Ошибка исполнения программы------" skip
      532     trim(error-status :get-message(1)) +
      533     trim(error-status :get-message(2)) +
      534     trim(error-status :get-message(3)) +
      535     trim(error-status :get-message(4)) +
      536     trim(error-status :get-message(5)) skip
      537     view-as alert-box error .
      538        return no-apply.
      539     end.
      540     find first ub.pl-pump where ub.pl-pump.obj-type    = parobj-type  and
      541                              ub.pl-pump.obj-code    = parobj-code  and
      542                              ub.pl-pump.pl-code     = varpl-code   and
      543                              ub.pl-pump.pump-code   = varpump-code
      544                              no-lock.
      545     assign parrec-id = recid(ub.pl-pump).
      546   end.
      547   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      548   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      549   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      550   on help of frame Dialog-Frame
      551   do:
      552     run gbl/app_help.p
      553       (input this-procedure :file-name
      554       ,input ''
      555       ,input ?
      556       ) no-error.
      557     if error-status :error then do:
      558       message
      559         "Ошибка при вызове помощи"
      560         error-status :get-message(1)
      561         view-as alert-box .
      562     end.
      563   end.
      564   run minbtn-set in this-procedure .
      565   on choose of b-help in frame Dialog-Frame
      566   do:
      567     apply "help":u to frame Dialog-Frame .
      568   end.
      569   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      570   procedure minbtn-set :
      571       do
      572           on error undo, return error return-value
      573           :
      574           define variable ii              as integer       no-undo .
      575           define variable fh              as widget-handle no-undo .
      576           define variable hh              as widget-handle no-undo .
      577           define variable v-h             as handle        extent 4 no-undo .
      578           define variable v-name-button   as character     no-undo .
      579           define variable v-help-old-x    as decimal       no-undo .
      580           define variable v-help-old-y    as decimal       no-undo .
      581           define variable v-help-old-size as decimal       no-undo .
      582           define variable v-frame-width   as decimal       no-undo .
      583           define variable jj              as integer       no-undo .
      584           do
      585               on error undo, return error
      586               :
      587               assign
      588                   v-frame-width = frame Dialog-Frame:width - 0.3
      589                   fh            = frame Dialog-Frame:first-child
      590                   hh            = fh:first-child
      591                   ii            = 1
      592                   .
      593               do while valid-handle(hh):
      594                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      595                   do:
      596                       case lc(hh:name) :
      597                           when "b-help" then
      598                               do:
      599                                   hh:load-image-up("cmp/b-help.bmp":u) .
      600                                   hh:load-image-down("cmp/b-help.bmp":u) .
      601                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      602                                   hh:TOOLTIP = "Помощь" .
      603                                   v-help-old-x = hh:column .
      604                                   v-help-old-y = hh:row    .
      605                                   v-help-old-size = hh:width .
      606                                   hh:width-chars = 2.5 .
      607                               end.
      608                           when "b-print" then
      609                               do:
      610                                   hh:load-image("cmp/b-print.bmp":u) .
      611                                   hh:TOOLTIP = "Печать" .
      612                                   v-h[ii] = hh:handle .
      613                                   ii = ii + 1 .
      614                                   hh:width-chars = 3 .
      615                               end.
      616                           when "b-history" or
      617                           when "b-hist" then
      618                               do:
      619                                   hh:load-image("cmp/b-hist.bmp":u) .
      620                                   hh:TOOLTIP = "История" .
      621                                   v-h[ii] = hh:handle .
      622                                   ii = ii + 1 .
      623                                   hh:width-chars = 3 .
      624                               end.
      625                           when "b-sch" then
      626                               do:
      627                                   hh:load-image("cmp/b-sch.bmp":u) .
      628                                   hh:TOOLTIP = "Установка Фильтра" .
      629                                   v-h[ii] = hh:handle .
      630                                   ii = ii + 1 .
      631                                   hh:width-chars = 3 .
      632                               end.
      633                           when "b-hist-user" then
      634                               do:
      635                                   hh:load-image("cmp/b-hist.bmp":u) .
      636                                   hh:TOOLTIP = "История пользователя" .
      637                                   ii = ii + 1 .
      638                               end.
      639                       end case.
      640                   end.
      641                   hh = hh:next-sibling.
      642               end.
      643               b-help:column = v-frame-width - b-help:width-chars.
      644               jj = 0.
      645               repeat ii = 4 to 1 by -1 :
      646                   if valid-handle (v-h[ii] ) then
      647                   do:
      648                       jj  = jj + 1 .
      649                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      650                       v-h[ii]:row    = v-help-old-y .
      651                   end.
      652               end.
      653           end.
      654       end.
      655   end procedure.
      656   MAIN-BLOCK:
      657   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      658      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      659     RUN enable_UI.
      660     WAIT-FOR GO OF FRAME Dialog-Frame.
      661   END.
      662   RUN disable_UI.
      663   PROCEDURE disable_UI :
      664     HIDE FRAME Dialog-Frame.
      665   END PROCEDURE.
      666   PROCEDURE enable_UI :
      667     DISPLAY varpl-code varpump-code
      668         WITH FRAME Dialog-Frame.
      669     ENABLE b-save b-cancel b-help varpl-code b-place varpump-code b-pump
      670         WITH FRAME Dialog-Frame.
      671     VIEW FRAME Dialog-Frame.
      672   END PROCEDURE.
