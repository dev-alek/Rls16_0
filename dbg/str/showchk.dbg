       99   :
      100   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      101     run mainmenu_getcntxt in parparentproc
      102       (output v-cntxt-db-num
      103       ,output v-cntxt-userid
