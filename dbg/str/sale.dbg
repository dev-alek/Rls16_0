      715   function cross-list returns logical (
      716     input parfirst-stream  as character,
      717     input parsecond-stream as character,
      718     input pardelim         as character).
      719     if pardelim = ""
      720     or pardelim = ?
      721     then do:
      722       assign
      723         pardelim = ","
      724       .
      725     end.
      726     define variable vari            as integer no-undo .
      727     define variable varresult-cross as logical no-undo .
      728     assign
      729       varresult-cross = no
      730     .
      731     def var v-num-parfirst-stream as integer no-undo .
      732     assign
      733       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      734     .
      735     do vari = 1 to v-num-parfirst-stream
      736     :
      737       if lookup(entry(vari, parfirst-stream, pardelim)
      738                ,parsecond-stream
      739                ,pardelim
      740                ) > 0 then do:
      741         assign
      742           varresult-cross = yes
      743         .
      744         leave.
      745       end.
      746     end.
      747     return varresult-cross .
      748   end function.
      749   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      750   function octal-to-char return character
      751   ( p-string as character ) :
      752     def var v-asc     as integer no-undo .
      753     def var v-new-asc as integer no-undo .
      754     def var ind       as integer no-undo .
      755     if length(p-string) <> 3 then do:
      756       return ? .
      757     end.
      758     assign
      759       v-asc = 0
      760     .
      761     do ind = 1 to length(p-string)
      762     :
      763       assign
      764         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      765       .
      766       if v-new-asc < 0 or v-new-asc >= 8 then do:
      767         return ? .
      768       end.
      769       assign
      770         v-asc = v-asc * 8 + v-new-asc
      771       .
      772     end.
      773     return chr(v-asc) .
      774   end function .
      775   function char-to-octal return character
      776   ( p-chr as character ) :
      777     def var v-asc    as integer   no-undo .
      778     def var ind      as integer   no-undo .
      779     def var v-string as character no-undo .
      780     if length(p-chr) <> 1 then do:
      781       return ? .
      782     end.
      783     assign
      784       v-asc    = asc(p-chr)
      785       v-string = ""
      786     .
      787     do ind = 1 to 3
      788     :
      789       assign
      790         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      791       .
      792       assign
      793         v-asc = truncate(v-asc / 8, 0)
      794       .
      795     end.
      796     return v-string .
      797   end.
      798   function str-encode return character
      799   (   p-init-string       as character
      800     , p-encode-char       as character
      801     , p-special-char-list as character
      802   ) :
      803     def var p-encode-string as character no-undo .
      804     def var ind                as integer no-undo .
      805     def var v-num-special-char as integer no-undo .
      806     def var v-special-char     as character no-undo .
      807     if p-encode-char = ?
      808     or p-encode-char = "" then do:
      809       assign
      810         p-encode-char = "~~"
      811       .
      812     end.
      813     if p-init-string = ? then do:
      814       return "?" .
      815     end.
      816     if p-init-string = "?" then do:
      817       return p-encode-char + char-to-octal("?") .
      818     end.
      819     assign
      820       v-num-special-char = length(p-special-char-list)
      821       p-encode-string    = replace(p-init-string
      822                                   ,p-encode-char
      823                                   ,p-encode-char + char-to-octal(p-encode-char)
      824                                   )
      825     .
      826     do ind = 1 to v-num-special-char
      827     :
      828       assign
      829         v-special-char = substring(p-special-char-list, ind, 1)
      830       .
      831       if v-special-char <> p-encode-char then do:
      832         assign
      833           p-encode-string = replace (p-encode-string
      834                                     ,v-special-char
      835                                     ,p-encode-char + char-to-octal(v-special-char)
      836                                     )
      837         .
      838       end.
      839     end.
      840     return p-encode-string .
      841   end.
      842   function str-decode returns character
      843     (p-init-string   as character
      844     ,p-encode-char   as character
      845     ) :
      846     def var p-decode-string as character no-undo .
      847     def var ind                       as integer no-undo .
      848     def var v-num-entries-init-string as integer no-undo .
      849     def var v-sub-phrase              as character no-undo .
      850     def var v-special-char            as character no-undo .
      851     if p-encode-char = ?
      852     or p-encode-char = "" then do:
      853       assign
      854         p-encode-char = "~~"
      855       .
      856     end.
      857     if p-init-string = "?" then do:
      858       return ? .
      859     end.
      860     assign
      861       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      862     .
      863     if v-num-entries-init-string > 1 then do:
      864       assign
      865         p-decode-string = entry(1, p-init-string, p-encode-char)
      866       .
      867       do ind = 2 to v-num-entries-init-string
      868       :
      869         assign
      870           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      871         .
      872         assign
      873           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      874         .
      875         if v-special-char <> ? then do:
      876           assign
      877             p-decode-string = p-decode-string
      878                             + v-special-char
      879                             + substring(v-sub-phrase, 4)
      880           .
      881         end.
      882         else do:
      883           assign
      884             p-decode-string = p-decode-string
      885                             + p-encode-char
      886                             + v-sub-phrase
      887           .
      888         end.
      889       end.
      890     end.
      891     else do:
      892       assign
      893         p-decode-string = p-init-string
      894       .
      895     end.
      896     return p-decode-string .
      897   end.
      898   function is-gas returns logical
      899           (input p-gds-code as integer):
      900   define variable result as logical no-undo.
      901   define variable c-value as character no-undo.
      902   define variable c-type as character no-undo.
      903   do on error undo, return error:
      904           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
      905         (input  p-gds-code
      906         ,input  'fuel-type':U
      907         ,output c-value
      908         ,output c-type) no-error.
      909   end.
      910   result = logical(c-value = 'metan':U) no-error.
      911   return result.
      912   end function.
      913   define new global shared variable g#libbcrcn as handle no-undo .
      914   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      915   define variable v-waitfram-action01         as character   no-undo .
      916   define variable v-waitfram-action02         as character   no-undo .
      917   define variable v-waitfram-action03         as character   no-undo .
      918   define variable mWaitFramTextBeg            as character   no-undo.
      919   define variable mWaitFramTextEnd            as character   no-undo.
      920   define variable mWaitFramView               as logical     no-undo.
      921   define variable mWaitProcEvent              as logical     no-undo init yes.
      922   define variable mWaitFramInterval           as integer     no-undo init 1 .
      923   define variable mWaitFramStop               as logical     no-undo.
      924   define variable mWaitFramStopUser           as logical     no-undo.
      925   define variable mWaitFramStopTimeOut        as logical     no-undo.
      926   define variable mWaitFramStartProc          as datetime-tz no-undo.
      927   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      928   define button B-WaitFramStop auto-end-key
      929        label "Стоп"
      930        size 10 by 1 tooltip "Остоновить процесс".
      931   define button B-viewProcInfo
      932        label "Информация"
      933        size 15 by 1 tooltip "Информация о процесс".
      934   define frame waitfram
      935     v-waitfram-action01 format "x(72)" no-label skip
      936     v-waitfram-action02 format "x(72)" no-label skip
      937     v-waitfram-action03 format "x(72)" no-label skip
      938     B-viewProcInfo
      939     B-WaitFramStop at row 4 col 30
      940     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      941     .
      942   define new global shared variable mBatchMode as logical no-undo init ?.
      943   define variable mFramBachModHandle as handle no-undo.
      944   mFramBachModHandle = frame waitfram:handle.
      945   define variable mFameOldVis as logical no-undo.
      946   define variable mVisCUrentVin as logical no-undo.
      947   if session:batch-mode
      948   then
      949      mBatchMode = yes.
      950   if mBatchMode = ? then do:
      951     mVisCUrentVin = current-window:visible.
      952     mFameOldVis = mFramBachModHandle:visible.
      953     mFramBachModHandle:visible  = yes.
      954     mBatchMode = mFramBachModHandle:visible ne yes.
      955     mFramBachModHandle:visible = mFameOldVis.
      956     current-window:visible = mVisCUrentVin.
      957   end.
      958    if  log-manager:logfile-name ne ?
      959     then DO:
      960         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      961         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      962         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      963     end.
      964   on choose of B-WaitFramStop in frame waitfram
      965   do:
      966     mWaitFramStop = yes.
      967     mWaitFramStopUser = yes.
      968   end.
      969   function waitfram-check-timeout returns logical():
      970      define variable vtime as int64 no-undo.
      971      if mWaitFramStopTimeOut
      972      then
      973         return yes.
      974      vtime = ( now - mWaitFramStartProc ) / 1000 .
      975      if     mWaitFramTimeOut ne ?
      976         and mWaitFramTimeOut ne 0
      977         and mWaitFramTimeOut lt vtime
      978      then do:
      979         mWaitFramStopTimeOut = yes.
      980      end.
      981      return mWaitFramStopTimeOut.
      982   end.
      983   procedure waitfram-hide :
      984     if not session:batch-mode
      985     then do
      986     on error undo, return error return-value
      987     :
      988       pause 0 before-hide .
      989       if not mBatchMode then
      990         hide frame waitfram .
      991     if     not mWaitFramView
      992        and mWaitProcEvent
      993     then
      994       process events .
      995     end.
      996   end procedure.
      997   procedure waitfram-show :
      998     define input  parameter p-message as character no-undo .
      999     define variable v-left-margin as integer   no-undo .
     1000     if not session:batch-mode
     1001     then do
     1002     on error undo, return error return-value
     1003     :
     1004       if length(p-message) <= 70 then do:
     1005         assign
     1006           v-left-margin = integer((70 - length(p-message)) / 2)
     1007         .
     1008         assign
     1009           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1010         .
     1011         assign
     1012           v-waitfram-action01 = " "
     1013           v-waitfram-action02 = " "
     1014                                    + fill(" ", v-left-margin)
     1015                                    + p-message
     1016           v-waitfram-action03 = " "
     1017         .
     1018       end.
     1019       else do:
     1020         define variable vRindex1 as integer no-undo.
     1021         define variable vRindex2 as integer no-undo.
     1022         vRindex1 = r-index(p-message," ",70).
     1023         if vRindex1 = 0
     1024         then
     1025            vRindex1 = 70.
     1026         if length(p-message)  <= vRindex1 + 70 then do:
     1027           assign
     1028             v-waitfram-action01 = " "
     1029             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1030             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1031           .
     1032         end.
     1033         else do:
     1034           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1035           if vRindex2 <= vRindex1
     1036           then
     1037              vRindex2 = vRindex1 + 70.
     1038           assign
     1039             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1040             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1041             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1042           .
     1043         end.
     1044       end.
     1045       B-viewProcInfo:visible   in frame waitfram = no.
     1046       B-viewProcInfo:sensitive in frame waitfram = no.
     1047       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1048       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1049       if  (   mWaitFramView
     1050          or  mWaitProcEvent)
     1051          and not mBatchMode
     1052       then
     1053          display
     1054             v-waitfram-action01 skip
     1055             v-waitfram-action02 skip
     1056             v-waitfram-action03 skip
     1057          with frame waitfram .
     1058       if     mWaitFramView
     1059          then do:
     1060             if     mWaitFramInterval ne ?
     1061                and not mBatchMode
     1062             then
     1063                wait-for go of frame waitfram pause mWaitFramInterval.
     1064          end.
     1065          else
     1066             if     mWaitProcEvent
     1067                and not mBatchMode
     1068             then
     1069                process events .
     1070     end.
     1071   end procedure.
     1072      procedure waitfram-show-this:
     1073         define input  parameter iInterval as int64 no-undo.
     1074         define variable vtime as int64 no-undo.
     1075         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1076         mWaitFramInterval = iInterval.
     1077         run waitfram-show (substitute("&1&2 &3&4" ,
     1078                                       mWaitFramTextBeg ,
     1079                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1080                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1081                                       mWaitFramTextEnd
     1082                                      )
     1083                           ).
     1084      end.
     1085      procedure WaitFramRunPause:
     1086         define input  parameter iInterval as dec no-undo.
     1087         define variable vStart  as datetime-tz no-undo.
     1088         define variable vend    as datetime-tz no-undo.
     1089         define variable vint as int64 no-undo.
     1090         define variable vOk as logical no-undo.
     1091         vStart = now.
     1092         vend   = vStart.
     1093         publish "WaitFramPause" (iInterval,output vOk).
     1094         vend   =  now.
     1095         vint = vend - vStart.
     1096         vint = iInterval - vint / 1000.
     1097         if     not mWaitFramStop
     1098            and (   vint > 0
     1099                 or (    not vOk
     1100                     and iInterval eq ?
     1101                     )
     1102                 )
     1103         then
     1104            run waitfram-show-this (iInterval).
     1105         vend   =  now.
     1106         vint = vend - vStart.
     1107         vint = iInterval - vint / 1000.
     1108         if     not mWaitFramStop
     1109            and vint > 0
     1110         then do:
     1111            run gbl/pause.p (vint * 1000).
     1112         end.
     1113         if iInterval ne ?
     1114         then
     1115            publish "WaitFramStop".
     1116         waitfram-check-timeout().
     1117      end.
     1118      procedure WaitFramWaitFor:
     1119         define input  parameter iInterval as dec no-undo.
     1120         assign
     1121            mWaitFramStartProc   = now
     1122            mWaitFramStopUser    = no
     1123            mWaitFramStopTimeOut = no
     1124         .
     1125         block-wait:
     1126         do while not mWaitFramStop:
     1127            run WaitFramRunPause (iInterval).
     1128            if  waitfram-check-timeout()
     1129            then do:
     1130               leave block-wait.
     1131            end.
     1132         end.
     1133         run waitfram-hide.
     1134      end.
     1135   procedure waitfram-join :
     1136     define input  parameter p-line-1  as character no-undo .
     1137     define input  parameter p-line-2  as character no-undo .
     1138     define input  parameter p-line-3  as character no-undo .
     1139     define output parameter p-message as character no-undo .
     1140     do
     1141     on error undo, return error return-value
     1142     :
     1143       assign
     1144         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1145                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1146                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1147       .
     1148     end.
     1149   end procedure.
     1150   function waitfram-join-function returns character
     1151     (input p-line-1 as character
     1152     ,input p-line-2 as character
     1153     ,input p-line-3 as character
     1154     ).
     1155     define variable v-message as character no-undo .
     1156     run waitfram-join in this-procedure
     1157       (input  p-line-1
     1158       ,input  p-line-2
     1159       ,input  p-line-3
     1160       ,output v-message
     1161       ) .
     1162     return v-message .
     1163   end function .
     1164   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1165   procedure cur-time :
     1166      define output parameter p-today as date      no-undo .
     1167      define output parameter p-time  as integer   no-undo .
     1168     do
     1169     on error undo, return error
     1170     :
     1171       define variable v-date1 as date      no-undo .
     1172       define variable v-date2 as date      no-undo .
     1173       define variable v-time  as integer   no-undo .
     1174       assign
     1175         v-date1 = today
     1176         v-time  = time
     1177         v-date2 = today
     1178       .
     1179       if v-date1 <> v-date2
     1180       then do:
     1181         assign
     1182           v-date1 = today
     1183           v-time  = v-time
     1184         .
     1185       end.
     1186       assign
     1187         p-today = v-date1
     1188         p-time  = v-time
     1189       .
     1190     end.
     1191   end.
     1192   function cur-time-date returns character
     1193   :
     1194     return string(today, '99/99/9999':U) .
     1195   end.
     1196   function cur-time-mjd returns decimal
     1197   :
     1198     define variable v-date as date      no-undo .
     1199     define variable v-time as integer   no-undo .
     1200     run cur-time in this-procedure
     1201       (output v-date
     1202       ,output v-time
     1203       ) .
     1204     return integer(v-date) - 2400002 + (v-time / 86400) .
     1205   end.
     1206   function cur-time-get-ending-index returns integer
     1207   (input p-number as integer
     1208   )
     1209   :
     1210     if p-number < 0
     1211     or p-number = ?
     1212     then do:
     1213       return 1 .
     1214     end.
     1215     define variable v-rest as integer   no-undo .
     1216     assign
     1217       p-number = p-number modulo 100
     1218     .
     1219     if p-number < 20
     1220     then do:
     1221       assign
     1222         v-rest = p-number
     1223       .
     1224     end.
     1225     else do:
     1226       assign
     1227         v-rest = p-number modulo 10
     1228       .
     1229     end.
     1230     case v-rest :
     1231       when 1
     1232       then do:
     1233         return 2 .
     1234       end.
     1235       when 2 or
     1236       when 3 or
     1237       when 4
     1238       then do:
     1239         return 3 .
     1240       end.
     1241       otherwise do:
     1242         return 1 .
     1243       end.
     1244     end case .
     1245   end.
     1246   procedure cur-time-mjd-to-date :
     1247      define input  parameter i-mjd-diff as decimal no-undo.
     1248      define output parameter o-Date     as date    no-undo.
     1249      define output parameter o-Time     as integer no-undo.
     1250      define variable v-day-number as integer   no-undo .
     1251      if    i-mjd-diff < 0
     1252         or i-mjd-diff = ?
     1253      then do:
     1254         return "?" .
     1255      end.
     1256      assign
     1257         v-day-number = truncate(i-mjd-diff,0).
     1258         o-Date = date(v-day-number + 2400002).
     1259         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1260     .
     1261   end.
     1262   function cur-time-mjd-to-string returns character
     1263   (input p-mjd-diff as decimal
     1264   )
     1265   :
     1266     define variable v-day-number as integer   no-undo .
     1267     define variable v-seconds    as integer   no-undo .
     1268     define variable v-hour       as integer   no-undo .
     1269     define variable v-min        as integer   no-undo .
     1270     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1271     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1272     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1273     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1274     if p-mjd-diff < 0
     1275     or p-mjd-diff = ?
     1276     then do:
     1277       return "?" .
     1278     end.
     1279     assign
     1280       v-day-number = integer(truncate(p-mjd-diff,0))
     1281       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1282     .
     1283     if v-seconds > 86400
     1284     then do:
     1285       assign
     1286         v-seconds = 86400 - 1
     1287       .
     1288     end.
     1289     if v-seconds < 0
     1290     then do:
     1291       assign
     1292         v-seconds = 0
     1293       .
     1294     end.
     1295     assign
     1296       v-hour = truncate(v-seconds / 3600, 0)
     1297     .
     1298     assign
     1299       v-seconds = v-seconds modulo 3600
     1300     .
     1301     assign
     1302       v-min = truncate(v-seconds / 60, 0)
     1303     .
     1304     assign
     1305       v-seconds = v-seconds modulo 60
     1306     .
     1307     return
     1308         (if v-day-number <> 0
     1309           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1310           else ""
     1311         )
     1312       + (if v-day-number <> 0 or v-hour <> 0
     1313           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1314           else ""
     1315         )
     1316       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1317           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1318           else ""
     1319         )
     1320       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1321       .
     1322   end.
     1323   function cur-time-string returns character
     1324   :
     1325     define variable v-date as date      no-undo .
     1326     define variable v-time as integer   no-undo .
     1327     run cur-time in this-procedure
     1328       (output v-date
     1329       ,output v-time
     1330       ) .
     1331     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1332   end.
     1333   function cur-time-string-sec returns character
     1334   :
     1335     define variable v-date as date      no-undo .
     1336     define variable v-time as integer   no-undo .
     1337     run cur-time in this-procedure
     1338       (output v-date
     1339       ,output v-time
     1340       ) .
     1341     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1342   end.
     1343   function cur-time-custom  returns character
     1344   (input p-prefix as character
     1345   ,input p-date-format as character
     1346   ,input p-delimiter as character
     1347   ,input p-time-format as character
     1348   ,input p-suffix as character
     1349   )
     1350   :
     1351     define variable v-date as date      no-undo .
     1352     define variable v-time as integer   no-undo .
     1353     run cur-time in this-procedure
     1354       (output v-date
     1355       ,output v-time
     1356       ) .
     1357     return
     1358       p-prefix
     1359       + string(v-date, p-date-format)
     1360       + p-delimiter
     1361       + string(v-time, p-time-format)
     1362       + p-suffix
     1363       .
     1364   end.
     1365   function cur-time-print  returns character
     1366   :
     1367     define variable v-date as date      no-undo .
     1368     define variable v-time as integer   no-undo .
     1369     run cur-time in this-procedure
     1370       (output v-date
     1371       ,output v-time
     1372       ) .
     1373     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1374   end.
     1375   function cur-time-datetime returns datetime
     1376   :
     1377     define variable v-char as character no-undo .
     1378     define variable v-datetime as datetime no-undo .
     1379     v-char = cur-time-string().
     1380     v-datetime = datetime(v-char).
     1381     return  v-datetime.
     1382   end.
     1383   function cur-time-string-msec returns character
     1384   :
     1385     define variable v-date as datetime  no-undo .
     1386     v-date = now.
     1387     return string(v-date) .
     1388   end.
