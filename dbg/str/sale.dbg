     4127   function get-OK returns CHARACTER (input p-is-tpsi-obj as logical
     4128                                   ,input p-artic   as character
     4129                                   ,input p-prod-type as character
     4130                                   ,input p-prod-code  as integer
     4131                                   ,input p-prt-code   as integer
     4132                                   ,input p-doc-qnty as decimal
     4133                                   ,input p-fact-qnty as decimal
     4134                                   ):
     4135   define buffer buf_tt0-gds-dtl for tt0-gds-dtl.
     4136   CASE p-is-tpsi-obj:
     4137   when yes then do:
     4138     find first buf_tt0-gds-dtl no-lock where
     4139               buf_tt0-gds-dtl.artic     = p-artic
     4140           AND buf_tt0-gds-dtl.prod-type = p-prod-type
     4141           AND buf_tt0-gds-dtl.prod-code = p-prod-code
     4142           AND buf_tt0-gds-dtl.prt-code = p-prt-code no-error .
     4143     if p-fact-qnty = p-doc-qnty
     4144     or (available buf_tt0-gds-dtl and (buf_tt0-gds-dtl.doc-qnty + p-doc-qnty) = p-fact-qnty)
     4145     then do:
     4146       return "++":U.
     4147     end.
     4148     if available buf_tt0-gds-dtl   then do:
     4149       return "+-":U.
     4150     end.
     4151     else do:
     4152       return "--":U.
     4153     end.
     4154   end.
     4155   when no then do:
     4156     if p-fact-qnty = p-doc-qnty then do:
     4157       return "+":U.
     4158     end.
     4159     else return "-":U.
     4160   end.
     4161   END CASE.
     4162   END FUNCTION.
     4163   function get-name returns CHARACTER (
     4164                                         input p-node-name as character
     4165                                        ,input p-upper-code as integer
     4166                                        ,input p-prt-root as integer
     4167                                        ,input p-gds-name as character ) :
     4168   define variable v-name as character no-undo .
     4169   assign
     4170   v-name  =  if p-node-name <> '_Пустая шкала':U
     4171              and p-upper-code <> p-prt-root
     4172              then (p-gds-name + " - " + p-node-name)
     4173              else p-gds-name
     4174   no-error
     4175   .
     4176   return v-name.
     4177   END FUNCTION.
     4178   function get-prt-name returns character ( input p-node-name as character
     4179                                             ,input p-upper-code as integer
     4180                                             ,input p-prt-root as integer
     4181                                             ,input p-f-name as character  ):
     4182   define variable v-name as character no-undo .
     4183   assign
     4184   v-name = if p-node-name = '_Пустая шкала':U
     4185            then "-"
     4186            else (if p-upper-code = p-prt-root
     4187                  then "-------------------"
     4188                  else p-f-name).
     4189   return v-name.
     4190   END FUNCTION.
     4191   FUNCTION get-pcnt returns decimal ( input p-price-base as decimal
     4192                                      ,input p-price-rubl as decimal
     4193                                      ,input p-discnt-base as decimal
     4194                                      ,input p-discnt-rubl as decimal ) :
     4195   define variable v-pcnt as decimal no-undo .
     4196   assign
     4197   v-pcnt = (if v-curr-r-b = 'base':U
     4198            then (p-discnt-base / p-price-base * 100)
     4199            else (p-discnt-rubl / p-price-rubl * 100 ))
     4200   .
     4201   return v-pcnt.
     4202   END FUNCTION.
     4203   DEFINE VARIABLE mImagePath     AS CHARACTER   NO-UNDO.
     4204   DEFINE VARIABLE mImageDir      AS CHARACTER   NO-UNDO.
     4205   DEFINE VARIABLE mImagePreDir   AS CHARACTER   NO-UNDO.
     4206   DEFINE VARIABLE mImageTrash    AS CHARACTER   NO-UNDO.
     4207   DEFINE VARIABLE mPhotomgd      AS LOGICAL     NO-UNDO.
     4208   DEFINE VARIABLE mImagePh       AS LOGICAL     NO-UNDO.
     4209   define variable v-param-types   as character  no-undo.
     4210   define variable v-value-char    as character  no-undo.
     4211   define variable v-val-date      as date       no-undo.
     4212   define variable v-val-decimal   as decimal    no-undo.
     4213   define variable v-val-integer   as integer    no-undo.
     4214   define variable v-val-logical   as logical    no-undo.
     4215   define variable v-tthd          as handle     no-undo.
     4216   RUN imagelist_loaddef IN THIS-PROCEDURE NO-ERROR.
     4217   PROCEDURE imagelist_loaddef:
     4218       DEFINE VARIABLE vPar-val       AS CHARACTER   NO-UNDO.
     4219       DEFINE VARIABLE vPar-type      AS CHARACTER   NO-UNDO.
     4220       ASSIGN
     4221           vPar-val  = "":U
     4222           vPar-type = "":U
     4223           .
     4224   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     4225     (input  'photo':u
     4226     ,input  '':u
     4227     ,input  '':u
     4228     ,input  0
     4229     ,input  '':u
     4230     ,input  '':u
     4231     ,input  '':u
     4232     ,input  no
     4233     ,output vPar-val
     4234     ,output vPar-type
     4235     ) no-error .
     4236           mImagePh = LOOKUP (vPar-val, "true,yes":U) > 0.
     4237       IF mImagePh THEN .
     4238       ELSE RETURN.
     4239       ASSIGN
     4240           vPar-val  = "":U
     4241           vPar-type = "":U
     4242           .
     4243   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     4244     (input  'ph-dir':u
     4245     ,input  '':u
     4246     ,input  '':u
     4247     ,input  0
     4248     ,input  '':u
     4249     ,input  '':u
     4250     ,input  '':u
     4251     ,input  NO
     4252     ,output vPar-val
     4253     ,output vPar-type
     4254     ) no-error .
     4255       IF LENGTH (vPar-val) = 0 THEN
     4256           RUN verify-ini-entry("ph-dir":U, "REP-SETS":U, "":U, YES, OUTPUT vPar-val) NO-ERROR.
     4257       IF LENGTH (vPar-val) = 0 THEN vPar-val = "c:\temp\":U.
     4258       ASSIGN
     4259           mImagePath   = RIGHT-TRIM (vPar-val, "~\~/":U)
     4260           mImagePath   = mImagePath + (IF LENGTH (mImagePath) > 0 THEN "\":U ELSE "":U)
     4261           mImagePreDir = mImagePath
     4262           mImageDir    = mImagePreDir
     4263           mImageTrash  = mImagePath + "trash\":U
     4264           .
     4265       ASSIGN
     4266           vPar-val  = "":U
     4267           vPar-type = "":U
     4268           .
     4269               run adm/shattri.p (
     4270           input "get":U
     4271           ,input  '':U
     4272           ,input  0
     4273           ,input  'gds-ref':U
     4274           ,input  'shema-foto':U
     4275           ,output v-value-char
     4276           ,output v-val-date
     4277           ,output v-val-decimal
     4278           ,output v-val-integer
     4279           ,output v-val-logical
     4280           ,output v-param-types
     4281           ,INPUT-OUTPUT table-handle v-tthd
     4282           ) no-error.
     4283           delete object v-tthd.
     4284           mPhotomgd = IF v-val-integer = 2 then yes else no.
     4285   END PROCEDURE.
     4286   PROCEDURE imagelist_decode:
     4287       DEFINE INPUT  PARAMETER iImageList AS LONGCHAR  NO-UNDO.
     4288       DEFINE INPUT  PARAMETER iImageGdsCode AS int    NO-UNDO.
     4289       DEFINE OUTPUT PARAMETER oImageList AS LONGCHAR  NO-UNDO.
     4290       DEFINE VARIABLE vCh                AS CHARACTER NO-UNDO.
     4291       DEFINE VARIABLE vInt               AS INTEGER   NO-UNDO.
     4292       ASSIGN
     4293           oImageList = iImageList
     4294           .
     4295       DO vInt = 1 TO NUM-ENTRIES (iImageList, ",":U):
     4296           vCh =ENTRY (vInt, iImageList, ",":U).
     4297           IF SUBSTRING (vCh, 1, 2) = "~\~\":U THEN .
     4298           ELSE
     4299           DO:
     4300               ASSIGN
     4301                   vCh = REPLACE (vCh, "~/":U, "\":U)
     4302                   vCh = REPLACE (vCh, "~\":U, "\":U)
     4303                   .
     4304               IF SUBSTRING (vCh, 2, 2) = ":\":U OR vCh BEGINS mImageDir THEN .
     4305               ELSE vCh = mImagePreDir + (if mPhotomgd then string(iImageGdsCode) + "\":U else '':U ) +  vCh.
     4306               ENTRY (vInt, oImageList, ",":U) = vCh.
     4307           END.
     4308       END.
     4309   END PROCEDURE.
     4310   PROCEDURE imagelist_encode:
     4311       DEFINE INPUT  PARAMETER iImageList AS LONGCHAR  NO-UNDO.
     4312       DEFINE OUTPUT PARAMETER oImageList AS LONGCHAR  NO-UNDO.
     4313       DEFINE VARIABLE vCh                AS CHARACTER NO-UNDO.
     4314       DEFINE VARIABLE vInt               AS INTEGER   NO-UNDO.
     4315       DEFINE VARIABLE vLen               AS INTEGER   NO-UNDO.
     4316       ASSIGN
     4317           oImageList = iImageList
     4318           vLen       = LENGTH (mImageDir)
     4319           .
     4320       DO vInt = 1 TO NUM-ENTRIES (iImageList, ",":U):
     4321           vCh =ENTRY (vInt, iImageList, ",":U).
     4322           IF LENGTH (vCh) > 0 AND vLen > 0 AND vCh BEGINS mImageDir THEN
     4323               ENTRY (vInt, oImageList, ",":U) =
     4324                   SUBSTRING (vCh, vLen + 1).
     4325       END.
     4326   END PROCEDURE.
