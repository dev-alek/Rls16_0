    10548         then do:
    10549             FIND FIRST ub.gds-prt NO-LOCK WHERE
    10550                         ub.gds-prt.upper-code = ub.goods.prt-root NO-ERROR.
    10551             cashplace = yes.
    10552         end.
    10553         else cashplace = no.
    10554         IF NOT cashplace then do:
    10555             IF CAN-FIND(FIRST ub.doc-prts No-LOCK WHERE
    10556                               ub.doc-prts.out-code = ub.doc-line.doc-code AND
    10557                               ub.doc-prts.gds-code = ub.goods.gds-code)
    10558             then do:
    10559                 FIND FIRST ub.gds-prt NO-LOCK WHERE
    10560                             ub.gds-prt.upper-code = ub.goods.prt-root NO-ERROR.
    10561                 cashparts = yes.
    10562             end.
    10563             else cashparts = no.
    10564         end.
    10565         else cashparts = no.
    10566         FIND FIRST ub.units WHERE
    10567                     ub.units.unit-name = ub.goods.unit-base NO-LOCK .
    10568         if LOOKUP( 'сер':U, ub.units.type ) > 0 then  do:
    10569             assign
    10570             ser-good = yes.
    10571         end.
    10572         else do:
    10573             ser-good = no.
    10574         end.
    10575         IF CAN-FIND(FIRST ub.doc-fbr-gds No-LOCK WHERE
    10576                           ub.doc-fbr-gds.out-code = ub.doc-line.doc-code AND
    10577                           ub.doc-fbr-gds.gds-code = ub.goods.gds-code)
    10578         then do:
    10579   define variable vss-include-info72 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10580   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run fgdsobjt in g#library
    10581     (input  ub.doc-line.obj-type
    10582     ,input  ub.doc-line.obj-code
    10583     ,input  ub.goods.gds-code
    10584     ,input  'is-dish=request'
    10585     ,output v-is-dish
    10586     )  .
    10587           if not error-status:error
    10588           then assign
    10589           cashfbr = integer(v-is-dish) > 0
    10590           no-error .
    10591         end.
    10592         else cashfbr = no.
    10593         rsrv-title = substitute("Снятие резервов. &1. Строк ", entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )).
    10594         run RSRV-line(
    10595                       input buf_sale-doc.dir,
    10596                       input no,
    10597                       input no,
    10598                       input no,
    10599                       input no,
    10600                       input "":U,
    10601                       input p-is-tpsi-obj,
    10602                       input no,
    10603                       input no,
    10604                       input ub.goods.gds-code,
    10605                       input (if avail ub.gds-prt then ub.gds-prt.node-code else ?),
    10606                       output v-run-tpsi-line,
    10607                       buffer ub.doc-line,
    10608                       buffer buf_trn-doc,
    10609                       buffer buf_sale-doc
    10610                       ) no-error.
    10611         if error-status:error then do:
    10612           if rdoc-line <> ?
    10613           or v-msg-on
    10614           then do:
    10615             run waitfram-hide in this-procedure.
    10616             return error substitute("Ошибка при снятии резервов товаров:&1&2 &3"
    10617                                   , chr(10)
    10618                                   , error-status:get-message(1)
    10619                                   , return-value ).
    10620           end.
    10621           else next.
    10622         end.
    10623         assign
    10624         ub.doc-line.price-base = cost-base
    10625         ub.doc-line.price-rubl = cost-rubl .
    10626         assign
    10627         v-run-tpsi = v-run-tpsi-line or v-run-tpsi.
    10628     END.
    10629     if buf_sale-doc.doc-kind = 'es':U then do:
    10630       run waitfram-hide in this-procedure.
    10631       if p-is-tpsi-obj
    10632       and v-run-tpsi
    10633       then do:
    10634       run waitfram-show in this-procedure ("Ждите... Идет снятие резервов ЧУЖИХ товаров" ).
    10635         run str/tpsirsrv.p (
    10636                         input parparentproc
    10637                         ,input p-parent-handle
    10638                         ,input p-log-handle
    10639                         ,input p-auto
    10640                         ,input v-curr-r-b
    10641                         ,input buf_inkas.inkas-code
    10642                         ,input buf_trn-doc.host-code
    10643                         ,input buf_trn-doc.obj-type
    10644                         ,input buf_trn-doc.obj-code
    10645                         ,input r-artic
    10646                         ,input r-prod-type
    10647                         ,input r-prod-code
    10648                         ,input r-prt-code
    10649                         ,input no
    10650                         ,input "Снятие резеров ЧУЖИХ товаров. Расход. Строк "
    10651                         ,input-output num_rec_res
    10652                         ,output num_rec_other
    10653                         ,output num_rec_other_res
    10654                         ,buffer buf_trn-doc
    10655                       ) no-error .
    10656         if error-status:error then do:
    10657           run waitfram-hide in this-procedure.
    10658           if rdoc-line <> ? then do:
    10659           return error substitute("Ошибка при снятии резервов ЧУЖИХ товаров:&1&2 &3"
    10660                                   , chr(10)
    10661                                   , error-status:get-message(1)
    10662                                   , return-value ).
    10663           end.
    10664         end.
    10665         run waitfram-hide in this-procedure.
    10666       end.
    10667     end.
    10668     assign
    10669     num_resv = num_resv + num_rec
    10670     num_resv_res = num_resv_res + num_rec_res
    10671     num_rec = 0
    10672     num_rec_res = 0
    10673     .
    10674     run waitfram-hide in this-procedure.
    10675     release buf_trn-doc.
    10676   end.
    10677   if num_resv = 0 then.
    10678   else do:
    10679     if num_resv_res = num_resv and  num_resv > 0 and r-qnty = ? then do:
    10680   MESSAGE "Снятие резервов прошло успешно" view-as alert-box.
    10681     end.
    10682     else do:
    10683       if r-qnty = ? then do:
    10684   MESSAGE substitute("Из &1 позиций для снятия резервов,&2" +                         "успешно сняты резервы с &3"                                         , num_resv                                                           , chr(10)                                                        , num_resv_res) view-as alert-box.
    10685       end.
    10686     end.
    10687   end.
    10688   END PROCEDURE.
    10689   PROCEDURE get-gds-rec:
    10690     CASE CURRENT-BROWSER:
    10691         WHEN br-out:handle IN FRAME d-sale  then do:
    10692             IF AVAILABLE out-goods then
    10693             gds-rec = recid(out-goods).
    10694             ELSE IF AVAILABLE ret-goods then
    10695             gds-rec = recid(ret-goods).
    10696             ELSE BELL.
    10697         END.
    10698         WHEN br-ret:handle  IN FRAME d-sale then do:
    10699             IF AVAILABLE ret-goods then
    10700             gds-rec = recid(ret-goods).
    10701             ELSE IF AVAILABLE out-goods then
    10702             gds-rec = recid(out-goods).
    10703             ELSE BELL.
    10704         END.
    10705     END CASE.
    10706   END PROCEDURE.
    10707   PROCEDURE proc-places :
    10708       define variable v-is-petrol as logical no-undo.
    10709       define variable v-is-pieces as logical no-undo.
    10710       IF error-status:error then return no-apply.
    10711       IF (CURRENT-BROWSER = brwh-out-dtl
    10712       and bh-out-dtl:available )
    10713       or (CURRENT-BROWSER = brwh-ret-dtl
    10714       and bh-ret-dtl:available )
    10715       then do:
    10716       end.
    10717       else do:
    10718         case current-browser:
    10719           when brwh-out-dtl then do:
    10720             if bh-ret-dtl:available then
    10721             assign
    10722             current-browser = brwh-ret-dtl.
    10723             else  do:
    10724               bell.
    10725               APPLY "ENTRY" to brwh-out-dtl.
    10726               return error.
    10727             end.
    10728           end.
    10729           when brwh-ret-dtl then do:
    10730             if bh-out-dtl:available then
    10731             assign
    10732             current-browser = brwh-out-dtl.
    10733             else  do:
    10734               bell.
    10735               APPLY "ENTRY" to brwh-ret-dtl.
    10736               return error.
    10737             end.
    10738           end.
    10739         END CASE.
    10740       end.
    10741       assign
    10742           bhg = current-browser:query:get-buffer-handle(3)
    10743           bhb = current-browser:query:get-buffer-handle(4)
    10744       .
    10745       assign
    10746           v-gds-code  = bhg:buffer-field('gds-code':U):buffer-value
    10747           v-artic     = bhg:buffer-field('artic':U):buffer-value
    10748           v-prod-type = bhg:buffer-field('prod-type':U):buffer-value
    10749           v-prod-code = bhg:buffer-field('prod-code':U):buffer-value
    10750           v-b-code    = bhb:buffer-field('b-code':U):buffer-value
    10751       .
    10752   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
    10753     (
    10754        input v-artic
    10755     ,  input v-prod-type
    10756     ,  input v-prod-code
    10757     , output v-is-petrol
    10758     , output v-is-pieces
    10759     ) no-error.
    10760       if not v-is-petrol then do :
    10761           message "Выбран нетопливный товар!" view-as alert-box.
    10762           return no-apply.
    10763       end.
    10764       assign v-to-reserv = no .
    10765       DO TRANSACTION on ERROR undo, return no-apply
    10766                           on STOP undo, return no-apply :
    10767           run  str/sale-plc.w (input parparentproc,
    10768                                input v-gds-code,
    10769                                input v-b-code,
    10770                                buffer ink-doc,
    10771                                output v-to-reserv) .
    10772           if return-value = "cancell":U then undo, return no-apply .
    10773       END.
    10774   END PROCEDURE.
    10775   PROCEDURE proc-chek-tovar:
    10776   DEFINE VARIABLE rid-list as character no-undo .
    10777   IF (CURRENT-BROWSER = brwh-out-dtl
    10778   and bh-out-dtl:available )
    10779   or (CURRENT-BROWSER = brwh-ret-dtl
    10780   and bh-ret-dtl:available )
    10781   then do:
    10782   end.
    10783   else do:
    10784     case current-browser:
    10785       when brwh-out-dtl then do:
    10786         if bh-ret-dtl:available then
    10787         assign
    10788         current-browser = brwh-ret-dtl.
    10789         else  do:
    10790           bell.
    10791           APPLY "ENTRY" to brwh-out-dtl.
    10792           return error.
    10793         end.
    10794       end.
    10795       when brwh-ret-dtl then do:
    10796         if bh-out-dtl:available then
    10797         assign
    10798         current-browser = brwh-out-dtl.
    10799         else  do:
    10800           bell.
    10801           APPLY "ENTRY" to brwh-ret-dtl.
    10802           return error.
    10803         end.
    10804       end.
    10805     END CASE.
    10806   end.
    10807   assign
    10808   bh = current-browser:query:get-buffer-handle(1)
    10809   bhg = current-browser:query:get-buffer-handle(3)
    10810   bhb = current-browser:query:get-buffer-handle(4)
    10811   .
    10812   assign
    10813   v-doc-code = bh:buffer-field ('doc-code':U):buffer-value
    10814   v-gds-code = bhg:buffer-field('gds-code':U):buffer-value
    10815   v-recid = bhg:recid
    10816   v-b-code = bhb:buffer-field('b-code':U):buffer-value
    10817   .
    10818   FIND FIRST ub.doc-prts No-LOCK WHERE
    10819             ub.doc-prts.out-code = v-doc-code
    10820         AND ub.doc-prts.gds-code = v-gds-code No-ERROR.
    10821   IF AVAILABLE ub.doc-prts then cashparts = yes.
    10822   else cashparts = no.
    10823   if cashparts
    10824   then   run ref/gds-chks.w (
    10825                         input parparentproc
    10826                       ,input v-recid
    10827                       ,input (if p-mode = 'ПРОСМОТР':U then "":U else "b-del":U)
    10828                       ,input 'продажа':U
    10829                       ,input ?
    10830                       ,input ink-doc.obj-type
    10831                       ,input ink-doc.obj-code
    10832                       ,input ink-doc.inkas-code
    10833                       ,input "":U
    10834                       ,output rid-list
    10835                         ).
    10836   ELSE run ref/gds-chk.w (
    10837                         input parparentproc
    10838                       ,input v-b-code
    10839                       ,input (if p-mode = 'ПРОСМОТР':U then "":U else "b-del":U)
    10840                       ,input 'продажа':U
    10841                       ,input ?
    10842                       ,input ink-doc.obj-type
    10843                       ,input ink-doc.obj-code
    10844                       ,input ink-doc.inkas-code
    10845                       ,input "":U
    10846                       ,output rid-list
    10847                       ).
    10848   if return-value = "deleted" then run ui-on in this-procedure .
    10849   apply "entry" to current-browser .
    10850   END PROCEDURE.
    10851   PROCEDURE proc-parts-tovar:
    10852   define buffer b-doc-line for ub.doc-line.
    10853   define variable what-mode as logical no-undo initial yes.
    10854   define variable v-doc-qnty like ub.doc-line.doc-qnty no-undo .
    10855   define variable v-prt-rec as recid no-undo .
    10856   define variable rgds-dtl as rowid no-undo .
    10857   if v-is-inquiry then return .
    10858   IF (CURRENT-BROWSER = brwh-out-dtl
    10859   and bh-out-dtl:available )
    10860   or (CURRENT-BROWSER = brwh-ret-dtl
    10861   and bh-ret-dtl:available )
    10862   then do:
    10863   end.
    10864   else do:
    10865     case current-browser:
    10866       when brwh-out-dtl then do:
    10867         if bh-ret-dtl:available then
    10868         assign
    10869         current-browser = brwh-ret-dtl.
    10870         else  do:
    10871           bell.
    10872           APPLY "ENTRY" to brwh-out-dtl.
    10873           return error.
    10874         end.
    10875       end.
    10876       when brwh-ret-dtl then do:
    10877         if bh-out-dtl:available then
    10878         assign
    10879         current-browser = brwh-out-dtl.
    10880         else  do:
    10881           bell.
    10882           APPLY "ENTRY" to brwh-ret-dtl.
    10883           return error.
    10884         end.
    10885       end.
    10886     END CASE.
    10887   end.
    10888   bh = current-browser:query:get-buffer-handle(1).
    10889   bhg = current-browser:query:get-buffer-handle(3).
    10890   assign
    10891   rgds-dtl = bh:rowid
    10892   v-doc-code = bh:buffer-field('doc-code':U):buffer-value
    10893   v-artic = bh:buffer-field('artic':U):buffer-value
    10894   v-prod-type = bh:buffer-field('prod-type':U):buffer-value
    10895   v-prod-code = bh:buffer-field('prod-code':U):buffer-value
    10896   v-gds-code = bhg:buffer-field('gds-code':U):buffer-value
    10897   .
    10898   FIND FIRST b-doc-line No-LOCK WHERE
    10899               b-doc-line.doc-code = v-doc-code
    10900          AND  b-doc-line.artic = v-artic
    10901          AND  b-doc-line.prod-type = v-prod-type
    10902          AND  b-doc-line.prod-code = v-prod-code No-ERROR.
    10903   assign
    10904   v-doc-qnty = b-doc-line.doc-qnty
    10905   .
    10906   if can-find(first ub.doc-prts where
    10907                     ub.doc-prts.gds-code = v-gds-code
    10908                 AND ub.doc-prts.out-code = v-doc-code)
    10909   OR
    10910   can-find(first ub.doc-pl where
    10911                 ub.doc-pl.gds-code = v-gds-code
    10912            AND  ub.doc-pl.out-code = v-doc-code)
    10913   OR
    10914   can-find(first ub.doc-pl-pump where
    10915                 ub.doc-pl-pump.gds-code = v-gds-code
    10916           AND   ub.doc-pl-pump.out-code = v-doc-code)
    10917   or
    10918   can-find(first ub.doc-fbr-gds where
    10919                 ub.doc-fbr-gds.gds-code = v-gds-code
    10920             AND ub.doc-fbr-gds.out-code = v-doc-code)
    10921   then
    10922   what-mode = no.
    10923   apply "Value-CHAnged" to current-browser.
    10924   run str/parts-l.w (
    10925                 input parparentproc
    10926                 ,input ink-doc.obj-type
    10927                 ,input ink-doc.obj-code
    10928                 ,input v-gds-code
    10929                 ,input v-doc-code
    10930                 ,input (if  (p-mode = 'ИЗМЕНЕНИЕ':U
    10931                               and what-mode
    10932                               )
    10933                         then 'ИЗМЕНЕНИЕ':U
    10934                         else 'ПРОСМОТР':U
    10935                         )
    10936                 ,input (if ink-doc.status_ = 'факт':U
    10937                         then 'все':U
    10938                         else 'документ':U
    10939                         )
    10940                 ,input 'текущий':U
    10941                 ,input 'документ':U
    10942                 ,output v-prt-rec
    10943                 ).
    10944   apply "entry" to current-browser.
    10945   FIND FIRST b-doc-line No-LOCK WHERE
    10946             b-doc-line.doc-code = v-doc-code
    10947         AND b-doc-line.artic = v-artic
    10948         AND b-doc-line.prod-type = v-prod-type
    10949         AND b-doc-line.prod-code = v-prod-code No-ERROR.
    10950   if b-doc-line.doc-qnty <> v-doc-qnty then do:
    10951     run UI-on in this-procedure .
    10952     if rgds-dtl <> ? then qh:reposition-to-rowid( rgds-dtl) no-error.
    10953     apply "entry" to current-browser.
    10954   end.
    10955   END PROCEDURE.
    10956   procedure frame-title :
    10957     do
    10958     on error undo, return error
    10959     :
    10960       assign
    10961       frame d-sale:title = (if t-doc.status_ = 'запрос':U
    10962                                    then t-doc.status_
    10963                                    else '':U) + chr(32) +
    10964                                     substitute("&1 №&2  Дата: &3  Факт&4: &5 &6 &7"
    10965                                               , (t-doc.obj-type + string(t-doc.obj-code))
    10966                                               , t-doc.doc-code
    10967                                               , string (t-doc.doc-date, "99/99/9999")
    10968                                               , (if ink-doc.status_ <> 'факт':U
    10969                                                and
    10970                                                ink-doc.status_ <> 'запрос':U
    10971                                                then "(ожидается)" else "":U)
    10972                                               , string ( t-doc.fact-date, "99/99/9999" )
    10973                                               , (IF cas-shft then (" смена N " + shift-name-no-err(buffer ink-doc)) else "" )
    10974                                               , (IF one-curs then (" чеки по курсу " + string(t-doc.base-rate / t-doc.base-scale)) else "")
    10975                                             ).
    10976      browse br-out:title = substitute("Продажи &1 &2", 'т':U, t-doc.doc-code)
    10977     .
    10978     end.
    10979   end procedure.
    10980   procedure ui-2 :
    10981     do
    10982     on error undo, return error
    10983     :
    10984       apply "entry" to br-out in frame d-sale.
    10985       reposition br-out to row 1 no-error.
    10986     end.
    10987   end procedure.
    10988   procedure enable-menu-items :
    10989   define variable v-chr-office as character no-undo .
    10990   define variable v-doc-kind as character no-undo .
    10991   define buffer buf_sale-doc for ub.sale-doc.
    10992   do
    10993   on error undo, return error
    10994   :
    10995   assign
    10996   v-doc-kind = entry(1, br-2-mode, chr(4) )
    10997   v-chr-office = entry(2, br-2-mode, chr(4) )
    10998   .
    10999   for each wh:
    11000     if valid-handle(wh.mi-reserv) then do:
    11001       delete widget wh.mi-reserv.
    11002     end.
    11003     if valid-handle(wh.mi-unreserv) then do:
    11004       delete widget wh.mi-unreserv.
    11005     end.
    11006     if valid-handle(wh.mi-parts) then do:
    11007       delete widget wh.mi-parts.
    11008     end.
    11009     if valid-handle(wh.mi-arch) then do:
    11010       delete widget wh.mi-arch.
    11011     end.
    11012     delete wh.
    11013   end.
    11014   _sale-doc:
    11015   for each buf_sale-doc no-lock where
    11016           buf_Sale-doc.inkas-code = ink-doc.inkas-code:
    11017     create wh.
    11018     buffer-copy buf_sale-doc to wh
    11019     .
    11020     if buf_sale-doc.order <= 0 then next _sale-doc.
    11021     create menu-item wh.mi-reserv
    11022     assign
    11023     name = substitute("m-res-&1", buf_sale-doc.doc-kind, buf_sale-doc.chr-office)
    11024     label = substitute("&1 &2 - Выбранный товар", entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U ), buf_sale-doc.chr-office)
    11025     parent = menu m-recs:handle
    11026     triggers:
    11027       on choose
    11028         persistent run mi-res ( input  wh.doc-kind, input wh.chr-office) .
    11029     end triggers.
    11030     create menu-item wh.mi-unreserv
    11031     assign
    11032     name = substitute("m-unres-&1", buf_sale-doc.doc-kin, buf_sale-doc.chr-office)
    11033     label = substitute("&1 &2 - Выбранный товар", entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U ), buf_sale-doc.chr-office)
    11034     parent = menu m-unrecs:handle
    11035     triggers:
    11036       on choose
    11037         persistent run mi-unres ( input  wh.doc-kind, input wh.chr-office) .
    11038     end triggers.
    11039     create menu-item wh.mi-parts
    11040     assign
    11041     name = substitute("m-parts-&1", buf_sale-doc.doc-kin, buf_sale-doc.chr-office)
    11042     label = substitute("&1 &2", entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U ), buf_sale-doc.chr-office)
    11043     parent = menu m-parts:handle
    11044     triggers:
    11045       on choose
    11046         persistent run mi-parts ( input  wh.doc-kind, input wh.chr-office) .
    11047     end triggers.
    11048     create menu-item wh.mi-arch
    11049     assign
    11050     name = substitute("m-arch-&1", buf_sale-doc.doc-kin, buf_sale-doc.chr-office)
    11051     label = substitute("&1 &2", entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U ), buf_sale-doc.chr-office)
    11052     parent = menu m-arch:handle
    11053     triggers:
    11054       on choose
    11055         persistent run mi-arch ( input  wh.doc-kind, input wh.chr-office) .
    11056     end triggers.
    11057     assign
    11058     wh.mi-reserv:sensitive = (if wh.doc-kind = v-doc-kind
    11059                         and wh.chr-office = v-chr-office
    11060                         and wh.doc-kind = buf_sale-doc.doc-kind
    11061                         and wh.chr-office = buf_sale-doc.chr-office
    11062                         then yes
    11063                         else wh.mi-reserv:sensitive)
    11064     wh.mi-unreserv:sensitive = (if wh.doc-kind = v-doc-kind
    11065                         and wh.chr-office = v-chr-office
    11066                         and wh.doc-kind = buf_sale-doc.doc-kind
    11067                         and wh.chr-office = buf_sale-doc.chr-office
    11068                         then yes
    11069                         else wh.mi-unreserv:sensitive)
    11070     wh.mi-arch:sensitive = (if wh.doc-kind = buf_sale-doc.doc-kind
    11071                         and wh.chr-office = buf_sale-doc.chr-office
    11072                         then yes
    11073                         else wh.mi-arch:sensitive)
    11074     wh.mi-parts:sensitive = (if wh.doc-kind = buf_sale-doc.doc-kind
    11075                         and wh.chr-office = buf_sale-doc.chr-office
    11076                         then yes
    11077                         else wh.mi-arch:sensitive)
    11078    .
    11079    if wh.mi-parts:name =  "m-parts-rw" then do:
    11080      if buf_sale-doc.doc-kind = 'rwo':U
    11081      and (ink-doc.status_ = 'факт':U or ink-doc.status_ = 'запрос':U) then
    11082      wh.mi-parts:sensitive = yes.
    11083      else wh.mi-parts:sensitive = no.
    11084    end.
    11085   end.
    11086   end.
    11087   end procedure.
    11088   procedure reget-br-2 :
    11089   define variable v-found as logical no-undo .
    11090   define variable old-br-2-mode as character no-undo .
    11091   define buffer buf_sale-doc for ub.sale-doc.
    11092   define buffer buf2_sale-doc for ub.sale-doc.
    11093   do
    11094   on error undo, return error
    11095   :
    11096   assign
    11097   old-br-2-mode = br-2-mode
    11098   br-2-doc-code = '':U
    11099   br-2-mode = chr(4)
    11100   v-found = no
    11101   v-list-item-pairs = '':U
    11102   .
    11103   for each buf_sale-doc no-lock where
    11104           buf_sale-doc.inkas-code = ink-doc.inkas-code
    11105       and buf_sale-doc.order > 0:
    11106     if (buf_sale-doc.doc-kind = 'es':U
    11107         and buf_sale-doc.chr-office = 'т':U)
    11108     or buf_sale-doc.order <= 0
    11109     then next.
    11110     assign
    11111     br-2-mode = (if br-2-mode = chr(4)
    11112                  then (buf_sale-doc.doc-kind  + chr(4) + buf_sale-doc.chr-office)
    11113                  else br-2-mode)
    11114     br-2-doc-code  = (if entry(1, br-2-mode, chr(4)) = buf_sale-doc.doc-kind
    11115                       and entry(2, br-2-mode, chr(4)) = buf_sale-doc.chr-office
    11116                       then buf_sale-doc.doc-code
    11117                       else br-2-doc-code)
    11118     .
    11119     if buf_sale-doc.doc-kind = old-br-2-mode then do:
    11120       assign
    11121       v-found = yes
    11122       br-2-doc-code = buf_sale-doc.doc-code + chr(4) + buf_sale-doc.chr-office
    11123       .
    11124     end.
    11125     v-list-item-pairs = v-list-item-pairs + (if v-list-item-pairs = '':U then '':U else chr(44)) +
    11126                       entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U ) + chr(32) + buf_sale-doc.chr-office + chr(44) +
    11127                       buf_sale-doc.doc-kind  + chr(4) + buf_sale-doc.chr-office.
    11128   end.
    11129   br-2-mode = (if old-br-2-mode = chr(4)
    11130                 or not v-found
    11131                 then br-2-mode else old-br-2-mode)
    11132   .
    11133   end.
    11134   end procedure.
    11135   procedure set-compensed :
    11136   define input parameter p-compensed as logical no-undo .
    11137     do
    11138     on error undo, return error
    11139     :
    11140        assign
    11141        compensed = p-compensed.
    11142     end.
    11143   end procedure.
    11144   procedure reposition-inkas :
    11145   define input parameter p-direction as character no-undo .
    11146   define variable v-new-inkas-recid as recid no-undo .
    11147   do
    11148   on error undo, return error
    11149   :
    11150     if valid-handle(p-call-prog)
    11151     then do:
    11152       run reposition-inkas in p-call-prog
    11153         (input  p-direction
    11154         ,output v-new-inkas-recid
    11155         ).
    11156       if v-new-inkas-recid <> ?
    11157       then do:
    11158         define buffer buf_inkas for ub.inkas .
    11159         find first buf_inkas no-lock
    11160           where recid(buf_inkas) = v-new-inkas-recid
    11161           no-error .
    11162         assign
    11163         p-doc-rec = v-new-inkas-recid
    11164         p-next-prev = '':U
    11165         .
    11166       end.
    11167     end.
    11168     else do:
    11169       message "Список документов не определен." view-as alert-box INFORMATION .
    11170       return no-apply.
    11171     end.
    11172   end.
    11173   end procedure.
    11174   procedure mi-arch :
    11175   define input parameter p-doc-kind as character no-undo .
    11176   define input parameter p-chr-office as character no-undo .
    11177   define buffer buf_trn-doc for ub.trn-doc.
    11178   define buffer buf_sale-doc for ub.sale-doc.
    11179   do
    11180   on error undo, return error
    11181   :
    11182     find first buf_sale-doc where
    11183               buf_sale-doc.inkas-code = ink-doc.inkas-code
    11184           and buf_sale-doc.doc-kind = p-doc-kind
    11185           and buf_sale-doc.chr-office = p-chr-office  no-error .
    11186     if not available buf_sale-doc then return error.
    11187     find first buf_trn-doc no-lock where
    11188             buf_trn-doc.doc-code = buf_sale-doc.doc-code no-error.
    11189     if not available buf_trn-doc then do:
    11190         message
    11191       substitute("Не найдено: &1 &2", entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U ), buf_sale-doc.doc-code).
    11192     end.
    11193       run str/docisupp.p
    11194         (input  parparentproc
    11195         ,input  recid(buf_trn-doc)
    11196         ).
    11197   end.
    11198   end procedure.
    11199   procedure mi-parts :
    11200   define input parameter p-doc-kind as character no-undo .
    11201   define input parameter p-chr-office as character no-undo .
    11202   define buffer buf_sale-doc for ub.sale-doc.
    11203   define variable v-recid as recid no-undo .
    11204   define buffer buf_trn-doc for ub.trn-doc.
    11205   do
    11206   on error undo, return error
    11207   :
    11208     find first buf_sale-doc where
    11209               buf_sale-doc.inkas-code = ink-doc.inkas-code
    11210           and buf_sale-doc.doc-kind = p-doc-kind
    11211           and buf_sale-doc.chr-office = p-chr-office no-error .
    11212     if not available buf_sale-doc
    11213     then do:
    11214       return error.
    11215     end.
    11216     find first buf_trn-doc no-lock where
    11217             buf_trn-doc.doc-code = buf_sale-doc.doc-code no-error.
    11218     if not available buf_trn-doc then do:
    11219         message
    11220       substitute("Не найдено: &1 &2", entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U ), buf_sale-doc.doc-code).
    11221     end.
    11222       run str/partsneg.w (
    11223         input parParentProc
    11224         ,input buf_sale-doc.doc-code
    11225         ,input (if p-mode = 'ИЗМЕНЕНИЕ':U
    11226                 and ink-doc.status_ = 'новый':U
    11227                 then 'ИЗМЕНЕНИЕ':U
    11228                 else 'ПРОСМОТР':U)
    11229         ,input-output v-recid
    11230         ).
    11231   end.
    11232   end procedure.
    11233   procedure mi-res :
    11234   define input parameter p-doc-kind as character no-undo .
    11235   define input parameter p-chr-office as character no-undo .
    11236   define buffer buf_sale-doc for ub.sale-doc.
    11237   do
    11238   on error undo, return error
    11239   :
    11240     if p-doc-kind = 'es':U
    11241     and p-chr-office = 'т':U then do:
    11242       assign
    11243       bh = bh-out-dtl
    11244       brwh = brwh-out-dtl
    11245       .
    11246     end.
    11247     else do:
    11248       if entry(1, br-2-mode, chr(4)) = 'rwo':U  then return error.
    11249       assign
    11250       bh = bh-ret-dtl
    11251       brwh = brwh-ret-dtl
    11252       .
    11253     end.
    11254     if not bh:available then return no-apply.
    11255     assign
    11256     v-doc-code = (bh:buffer-field('doc-code':U):buffer-value)
    11257     v-artic = (bh:buffer-field('artic':U):buffer-value)
    11258     v-prod-type = (bh:buffer-field('prod-type':U):buffer-value)
    11259     v-prod-code = (bh:buffer-field('prod-code':U):buffer-value)
    11260     .
    11261     FIND FIRST ub.doc-line NO-LOCK WHERE
    11262             ub.doc-line.doc-code  =  v-doc-code
    11263         and ub.doc-line.artic     =  v-artic
    11264         and ub.doc-line.prod-type =  v-prod-type
    11265         and ub.doc-line.prod-code =  v-prod-code  No-ERROR.
    11266     IF NOT available ub.doc-line then return no-apply.
    11267     assign
    11268     rdoc-line = recid (ub.doc-line)
    11269     rgds-dtl = bh:recid
    11270     r-or-v = p-doc-kind
    11271     r-office = p-chr-office
    11272     r-qnty = ?
    11273     r-b-code = ?
    11274     r-pl-code = ?
    11275     r-doc-prts-qnty = ?
    11276     from-menu = yes.
    11277     run b-res-proc in this-procedure (
    11278                                         buffer ink-doc
    11279                                       , buffer t-doc
    11280                                       , buffer ret-doc
    11281                                       , input no
    11282                                       , input auto-close
    11283                                       , input no
    11284                                       , input rest-dish
    11285                                       , input "":U
    11286                                       , input v-is-tpsi-obj
    11287                                       , input rest-tpsi) no-error.
    11288     if error-status:error or return-value = "error" then do:
    11289       run waitfram-hide in this-procedure .
    11290       return no-apply.
    11291     end.
    11292     APPLY "ENTRY" to brwh  .
    11293   end.
    11294   end procedure.
    11295   procedure mi-unres :
    11296   define input parameter p-doc-kind as character no-undo .
    11297   define input parameter p-chr-office as character no-undo .
    11298   define buffer buf_sale-doc for ub.sale-doc.
    11299   do
    11300   on error undo, return error
    11301   :
    11302     if p-doc-kind = 'es':U
    11303     and p-chr-office = 'т':U
    11304     then do:
    11305       assign
    11306       bh = bh-out-dtl
    11307       brwh = brwh-out-dtl
    11308       .
    11309     end.
    11310     else do:
    11311       if entry(1, br-2-mode, chr(4)) = 'rwo':U then return error.
    11312       assign
    11313       bh = bh-ret-dtl
    11314       brwh = brwh-ret-dtl
    11315       .
    11316     end.
    11317     if not bh:available then return error.
    11318     assign
    11319     v-doc-code = (bh:buffer-field('doc-code':U):buffer-value)
    11320     v-artic = (bh:buffer-field('artic':U):buffer-value)
    11321     v-prod-type = (bh:buffer-field('prod-type':U):buffer-value)
    11322     v-prod-code = (bh:buffer-field('prod-code':U):buffer-value)
    11323     .
    11324     FIND FIRST ub.doc-line NO-LOCK WHERE
    11325             ub.doc-line.doc-code = v-doc-code
    11326         and ub.doc-line.artic    =  v-artic
    11327         and ub.doc-line.prod-type = v-prod-type
    11328         and ub.doc-line.prod-code = v-prod-code  No-ERROR.
    11329     IF NOT available ub.doc-line then return no-apply.
    11330     assign
    11331     rdoc-line = recid (ub.doc-line)
    11332     rgds-dtl = bh:recid
    11333     r-or-v = p-doc-kind
    11334     r-office = p-chr-office
    11335     r-qnty = ?
    11336     r-b-code = ?
    11337     r-pl-code = ?
    11338     r-doc-prts-qnty = ?
    11339     from-menu = yes
    11340     .
    11341     apply "choose" to b-unres in frame d-sale.
    11342     APPLY "ENTRY" to brwh.
    11343   end.
    11344   end procedure.
    11345   PROCEDURE write-log-and-file :
    11346   define input parameter p-tab-position as integer   no-undo.
    11347   define input parameter p-file-name    as character no-undo .
    11348   define input parameter p-log-level    as integer   no-undo .
    11349   define input parameter p-log-string   as character no-undo .
    11350       run writelog in this-procedure (
    11351             input log-file-name
    11352           , input p-log-level
    11353           , input p-log-string
    11354       ).
    11355   END PROCEDURE.
