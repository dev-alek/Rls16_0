     9433         or cashplace
     9434         or (chg-qnty = res-qnty
     9435           and  ((loc-gds-dtl.doc-qnty = loc-gds-dtl.fact-qnty) and (rz))
     9436             )
     9437         then do:
     9438           p-run-tpsi = no.
     9439         end.
     9440         else do:
     9441           run create-tt0-doc-line-gds-dtl(
     9442                                            input v-proprietor-obj-type
     9443                                           ,input v-proprietor-obj-code
     9444                                           ,input v-ext-doc-type
     9445                                           ,input (if available tpsi_sale-doc then tpsi_sale-doc.doc-code else "":U)
     9446                                           ,input  b-doc-line.artic
     9447                                           ,input  b-doc-line.prod-type
     9448                                           ,input  b-doc-line.prod-code
     9449                                           ,input  loc-gds-dtl.prt-code
     9450                                           ,input  (if rz
     9451                                                     then (loc-gds-dtl.fact-qnty - loc-gds-dtl.doc-qnty)
     9452                                                     else
     9453                                                     (if r-qnty = ?
     9454                                                     then ?
     9455                                                     else r-qnty
     9456                                                     )
     9457                                                    )
     9458                                           ,output v-was-gds-dtl-doc-qnty
     9459                                           ,output v-gds-dtl-fact-qnty
     9460                                           ,buffer b-doc-line
     9461                                           ,buffer loc-gds-dtl
     9462                                           ,buffer tpsi_sale-doc
     9463                                           ).
     9464           if not v-is-own and p-r-v > 0 and v-gds-dtl-fact-qnty <> 0 then do:
     9465             if not (is-gas(gdscode) and buf_sale-doc.doc-kind <> 'rs':U)
     9466             then do :
     9467               if recid(loc-gds-dtl) <> current-rgds-dtl then assign num_rec = num_rec + 1 current-rgds-dtl = recid(loc-gds-dtl).
     9468             end.
     9469             run write-tt0-info in this-procedure (
     9470                                                   input b-doc-line.artic
     9471                                                 ,input b-doc-line.prod-type
     9472                                                 ,input b-doc-line.prod-code
     9473                                                 ,input loc-gds-dtl.prt-code
     9474                                                 ,input v-proprietor-obj-type
     9475                                                 ,input v-proprietor-obj-code
     9476                                                 ,input (if available tpsi_sale-doc then tpsi_sale-doc.doc-code else "":U)
     9477                                                 ,input no
     9478                                                 ,input loc-gds-dtl.fact-qnty
     9479                                                 ,input loc-gds-dtl.doc-qnty
     9480                                                 ,input ?
     9481                                                 ,input loc-gds-dtl.fact-qnty
     9482                                                 ,input v-was-gds-dtl-doc-qnty
     9483                                                 ,input v-gds-dtl-fact-qnty
     9484                                                 ,input v-was-gds-dtl-doc-qnty
     9485                                                 ,input '':u).
     9486           end.
     9487           if v-gds-dtl-fact-qnty = 0 then do:
     9488               p-run-tpsi = no.
     9489           end.
     9490         end.
     9491       end.
     9492     END.
     9493   end.
     9494   END.
