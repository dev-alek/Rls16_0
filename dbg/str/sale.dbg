     7415       FIND FIRST ret-doc WHERE ret-doc.doc-code = t-doc.out-code NO-LOCK no-error.
     7416       assign
     7417       t-code = t-doc.doc-code
     7418       ret-code = (if available ret-doc then ret-doc.doc-code else '':U)
     7419       bh-out-dtl = buffer out-dtl:handle
     7420       bh-ret-dtl = buffer ret-dtl:handle
     7421       bh-out-goods = buffer out-goods:handle
     7422       bh-ret-goods = buffer ret-goods:handle
     7423       brwh-out-dtl = browse br-out:handle
     7424       brwh-ret-dtl = browse br-ret:handle
     7425       v-is-inquiry = (t-doc.status_ = 'запрос':U)
     7426       v-log-handle = this-procedure.
     7427       .
     7428       if available ret-doc and ret-doc.out-code <> t-doc.doc-code then   do:
     7429         message
     7430         "Данный расходный документ не является отчетом о продаже."
     7431         view-as alert-box INFORMATION .
     7432         p-next-prev = ?.
     7433         return error.
     7434       end.
     7435   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7436   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     7437     (input  v-host-code
     7438     ,output v-base-code
     7439     )  .
     7440   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7441   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     7442     (input  'маг':U
     7443     ,input  ub.shop.obj-code
     7444     ,output v-db-num
     7445     )  .
     7446       find first buf_currency no-lock where
     7447                 buf_currency.curr-code = v-base-code.
     7448       assign
     7449       v-base-type = buf_currency.curr-abbr
     7450       .
     7451       define variable v-h as handle no-undo .
     7452       define variable v-h-out as handle no-undo extent 30.
     7453       define variable v-ii as integer no-undo init 1.
     7454       v-h = br-out:FIRST-COLUMN IN FRAME d-sale.
     7455       v-ii = 1.
     7456       DO while valid-handle(v-h) :
     7457          v-h-out[v-ii] = v-h.
     7458          v-h = v-h:NEXT-COLUMN.
     7459          v-ii = v-ii + 1.
     7460       END.
     7461       if (can-do( 'ИЗМЕНЕНИЕ':U, p-mode )
     7462       or ink-doc.status_ = 'новый':U)
     7463       then do:
     7464         run gbl/tpsi-obj.p (
     7465                              input p-obj-type
     7466                            , input p-obj-code
     7467                            , output v-is-tpsi-obj) no-error .
     7468         if v-is-tpsi-obj then
     7469         br-out:num-locked-columns = 3.
     7470         else do:
     7471           assign
     7472           v-h-out[7]:visible = no
     7473           v-h-out[8]:visible = no
     7474           .
     7475         end.
     7476       end.
     7477       else do:
     7478         assign
     7479         v-h-out[7]:visible = no
     7480         v-h-out[8]:visible = no
     7481         .
     7482          assign
     7483          neg-tpsi-weight = no
     7484          neg-tpsi-qnty = 0
     7485          neg-tpsi-oper = no
     7486          resttpsi = no
     7487          .
     7488       end.
     7489       run reget-br-2 in this-procedure .
     7490       if can-find(first tpsi_sale-doc where
     7491                        tpsi_sale-doc.inkas-code = ink-doc.inkas-code
     7492                    and tpsi_sale-doc.tpsidoc = yes)
     7493       then v-is-tpsi-obj = yes.
     7494       if v-is-tpsi-obj then do:
     7495         run tpsi-gds-fill-tpsi-obj-table in this-procedure ( input v-db-num) no-error .
     7496         if error-status:error then do:
     7497           message
     7498           substitute("Ошибки при заполнении врем. таблицы объектов-членов ТПСИ на БД &1", v-db-num) skip
     7499           error-status:get-message(1) skip
     7500           return-value
     7501           view-as alert-box error .
     7502           undo main-block, return error .
     7503         end.
     7504       end.
     7505       if (v-is-tpsi-obj)
     7506       and can-do( 'ИЗМЕНЕНИЕ':U, p-mode )
     7507       or ink-doc.status_ = 'новый':U
     7508       then do:
     7509         if not v-is-inquiry then do:
     7510           run waitfram-show in this-procedure ("Ждите.. получение информации по резервированию ЧУЖИХ товаров" ).
     7511           run fill-tt-tpsi-table  in this-procedure ( input ink-doc.inkas-code
     7512                                                     , input ink-doc.host-code
     7513                                                     , input ink-doc.obj-type
     7514                                                     , input ink-doc.obj-code).
     7515           run waitfram-hide in this-procedure .
     7516         end.
     7517       end.
     7518   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7519   define variable v-param-type51 as character no-undo .
     7520   define variable v-value-character51 as character no-undo .
     7521   define variable v-value-date51 as date no-undo .
     7522   define variable v-value-decimal51 as decimal no-undo .
     7523   define variable v-value-integer51 as INTEGER no-undo .
     7524   define variable v-tth51 as handle no-undo .
     7525   run adm/shattri.p (
     7526       input "get":U
     7527       ,input  p-obj-type
     7528       ,input  p-obj-code
     7529       ,input  'get-chk':U
     7530       ,input  'cas-shft':U
     7531       ,output v-value-character51
     7532       ,output v-value-date51
     7533       ,output v-value-decimal51
     7534       ,output v-value-integer51
     7535       ,output cas-shft
     7536       ,output v-param-type51
     7537       ,INPUT-OUTPUT table-handle v-tth51
     7538       )  .
     7539   delete object v-tth51.
     7540       RUN UI-on in this-procedure .
     7541       APPLY "ENTRY" to br-out.
     7542       if can-do( 'ИЗМЕНЕНИЕ':U, p-mode ) and not auto-mail then do:
     7543           message "Докачка чеков в продажу осуществляется нажатием" skip
     7544           "              на кнопку ПРИЕМ ЧЕКОВ!"
     7545           view-as alert-box WARNING.
     7546       END.
     7547       if can-do( 'ИЗМЕНЕНИЕ':U, p-mode ) AND auto-mail then do:
     7548         run str/diallog.w (
     7549                       input parparentproc
     7550                     , input this-procedure
     7551                     , input 'str/get-chkf.p':U
     7552                     , input (p-obj-type + chr(4) + string(p-obj-code) + chr(4) + string(0))
     7553                     , input yes
     7554                     , input '':U
     7555                     , input 'Прием чеков с касс') no-error .
     7556         if error-status:error then return error.
     7557         p-doc-rec = recid (ink-doc).
     7558         DO TRANSACTION on ERROR undo, leave
     7559                               on STOP undo, leave:
     7560             run str/inc-sale.w (
     7561                             input parparentproc
     7562                           , input 'ИЗМЕНЕНИЕ':U
     7563                           , input ink-doc.host-code
     7564                           , input ink-doc.obj-type
     7565                           , input ink-doc.obj-code
     7566                           , input auto-get-res
     7567                           , input no
     7568                           , buffer ink-doc
     7569                           ) NO-ERROR.
     7570         END.
     7571         if (auto-get-res
     7572         or auto-mail)
     7573         and not return-value = "cancell":U
     7574         and not v-is-inquiry then do:
     7575           run reget-br-2 in this-procedure .
     7576           run openbr in this-procedure ( input ink-doc.inkas-code,  input br-2-doc-code, input yes, input no, input '':U, input '':U).
     7577         END.
     7578         if auto-get-res
     7579         and not return-value = "cancell":U then do:
     7580           assign
     7581           auto-close
     7582           auto-fbr
     7583           rest-dish
     7584           rest-ingr
     7585           rest-tpsi
     7586           .
     7587           if auto-close then do:
     7588               glog = no.
     7589               message
     7590               "ВНИМАНИЕ!!! Включен режим автоматического закрытия продажи по результатам резервирования!"
     7591               skip "Вы уверены, что хотите закрыть продажу?" view-as alert-box WARNING
     7592               buttons YES-NO update glog.
     7593               if not glog then return no-apply.
     7594           end.
     7595         FIND FIRST ret-doc WHERE ret-doc.doc-code = t-doc.out-code NO-LOCK no-error.
     7596         run b-res-proc in this-procedure (
     7597                                             buffer ink-doc
     7598                                           , buffer t-doc
     7599                                           , buffer ret-doc
     7600                                           , input no
     7601                                           , input auto-close
     7602                                           , input no
     7603                                           , input rest-dish
     7604                                           , input "":U
     7605                                           , input v-is-tpsi-obj
     7606                                           , input rest-tpsi) no-error.
     7607         if not error-status:error then do:
     7608           if auto-close and b-close:sensitive then do:
     7609           assign
     7610           v-parameter =     v-curr-r-b                     + chr(4) +
     7611                             ink-doc.inkas-code             + chr(4) +
     7612                           string(0)              + chr(4) +
     7613                           string(auto-close)               + chr(4) +
     7614                           string(b-mail-pressed)           + chr(4) +
     7615                           string(auto-comp)                + chr(4) +
     7616                           string(auto-fbr)                 + chr(4) +
     7617                           string(one-curs)                 + chr(4) +
     7618                           string(ub.shop.is-catering)      + chr(4) +
     7619                           string(v-is-tpsi-obj)            + chr(4) +
     7620                           string(rest-dish)                + chr(4) +
     7621                           string(rest-ingr)                + chr(4) +
     7622                           string(rest-tpsi)                + chr(4) +
     7623                           string(neg-tpsi-weight)          + chr(4) +
     7624                           string(neg-tpsi-qnty)            + chr(4) +
     7625                           string(neg-tpsi-oper)            + chr(4) +
     7626                           string(close-in-rfsl)            + chr(4) +
     7627                           pay-gds-algo
     7628           .
     7629           run str/diallog.w (
     7630                 input parParentProc
     7631               , input this-procedure
     7632               , input ("str/saleclos.p":U + chr(4) + "1":U +
     7633                       "1":U  + chr(4) +
     7634                       "1":U + chr(4) +
     7635                       "1":U)
     7636               , input v-parameter
     7637               , input no
     7638               , input "":U
     7639               , input substitute("Закрытие продажи &1", Ink-doc.inkas-code)
     7640           ) no-error.
     7641           if error-status:error
     7642           or return-value = "error":U
     7643           then do:
     7644               run close-error-processing in this-procedure.
     7645               return no-apply.
     7646           end.
     7647           else do:
     7648             assign
     7649             p-next-prev = ? .
     7650             leave n-p.
     7651           end.
     7652         end.
     7653       end.
     7654       else do:
     7655         run waitfram-hide in this-procedure .
     7656       end.
     7657     end.
     7658     RUN UI-on in this-procedure .
     7659     b-mail-pressed = yes.
     7660   end.
     7661   WAIT-FOR GO OF FRAME d-sale focus br-out.
     7662   END.
     7663   end.
     7664   RUN disable_UI.
     7665   PROCEDURE disable_UI :
     7666     HIDE FRAME d-sale.
     7667   END PROCEDURE.
     7668   PROCEDURE UI-on :
     7669   assign
     7670   v-prt-name:resizable in browse br-out = yes
     7671   v-prt-name:resizable in browse br-ret = yes
     7672   out-goods.engl-name:read-only in browse br-out = yes
     7673   ret-goods.engl-name:read-only in browse br-ret = yes
     7674   .
     7675   disable all with frame d-sale.
     7676   assign
     7677   auto-close
     7678   auto-fbr
     7679   rest-dish
     7680   rest-ingr
     7681   rest-tpsi
     7682   .
     7683   run enable-menu-items in this-procedure .
     7684   if v-list-item-pairs <> '':U then do:
     7685   assign
     7686   cb-doc-kind:list-item-pairs in frame d-sale =  trim(v-list-item-pairs).
     7687   cb-doc-kind = br-2-mode.
     7688   display
     7689   cb-doc-kind
     7690   with frame d-sale .
     7691   end.
     7692   run frame-title in this-procedure .
     7693   assign
     7694   s-pc = ink-doc.discnt / ink-doc.tot-doc * 100
     7695   loc-art = ""
     7696   auto-close = if just-entered then autoclose else auto-close
     7697   auto-fbr =  if just-entered and ub.shop.is-catering then autofbr else auto-fbr
     7698   rest-dish =  if just-entered and autofbr then restdish else rest-dish
     7699   rest-ingr =  if just-entered and autofbr then restingr else rest-ingr
     7700   rest-tpsi =  if just-entered and v-is-tpsi-obj then resttpsi else rest-tpsi
     7701   just-entered = no.
     7702   hide loc-art in frame d-sale loc-name loc-code in frame d-sale.
     7703   DISPLAY
     7704   auto-close
     7705   auto-fbr when shop.is-catering and can-do( 'ИЗМЕНЕНИЕ':U, p-mode )
     7706   rest-tpsi
     7707   with frame d-sale.
     7708   ENABLE b-exit
     7709                 b-prev WHEN NOT can-do( 'ИЗМЕНЕНИЕ':U, p-mode )
     7710                 b-next WHEN NOT can-do( 'ИЗМЕНЕНИЕ':U, p-mode )
     7711                 b-cash b-arch
     7712                 b-notes b-help a-n-c br-out br-ret
     7713                 b-chk r-trn
     7714                 b-troubl when (NOT t-doc.status_ = 'факт':U  and not v-is-inquiry)
     7715                 b-troublp  when not v-is-inquiry
     7716                 b-troublc
     7717                 b-places when (NOT t-doc.status_ = 'факт':U and can-do( 'ИЗМЕНЕНИЕ':U, p-mode ))
     7718                 b-parts when NOT v-is-inquiry
     7719                 prod-name-r
     7720                 cb-doc-kind when v-list-item-pairs <> '':U and num-entries(cb-doc-kind:list-item-pairs) > 2
     7721                 prod-name-v
     7722                 b-print
     7723                 with frame d-sale.
     7724     if can-do( 'ИЗМЕНЕНИЕ':U, p-mode ) then do:
     7725       disable b-close
     7726       with frame d-sale .
     7727       b-close-enabled = no.
     7728       RUN button-close in this-procedure (
     7729                                               buffer t-doc
     7730                                              ,buffer ret-doc
     7731                                              ,input v-is-tpsi-obj
     7732                                              ,input auto-fbr
     7733                                              ,input neg-tpsi-weight
     7734                                              ,input neg-tpsi-qnty
     7735                                              ,input neg-tpsi-oper
     7736                                              ,Output b-close-enabled).
     7737       ENABLE
     7738       b-close when ((auto-comp
     7739                   and can-find(first ub.sale-doc where
     7740                                     ub.sale-doc.inkas-code = ink-doc.inkas-code
     7741                                 and ub.sale-doc.doc-kind = 'rs':U)
     7742                   )
     7743                   OR b-close-enabled)
     7744       b-res when not v-is-inquiry
     7745       b-unres when not v-is-inquiry
     7746       b-mail
     7747       auto-close when not v-is-inquiry
     7748       auto-fbr when (shop.is-catering and not v-is-inquiry)
     7749       rest-tpsi when (v-is-tpsi-obj and not v-is-inquiry)
     7750       with frame d-sale.
     7751       if not shop.is-catering then do:
     7752         hide
     7753         auto-fbr
     7754         in frame d-sale .
     7755       end.
     7756       apply "VALUE-CHANGED" to auto-fbr.
     7757   end.
     7758   if can-do( 'ПРОСМОТР':U, p-mode ) then do:
     7759       ENABLE rs-sort with frame d-sale.
     7760       hide
     7761       auto-fbr rest-dish rest-ingr rest-tpsi
     7762       in frame d-sale .
     7763   end.
     7764   apply "VALUE-CHANGED" to br-out.
     7765   apply "VALUE-CHANGED" to br-ret.
     7766   IF NOT (t-doc.status_ = 'факт':U
     7767   or ink-doc.status_ = 'запрос':U)
     7768   then do:
     7769       assign
     7770       menu-item m-arch-i:label in menu m-arch = "Чеки-продажи"
     7771       b-arch:label = "Ин&фор."
     7772       .
     7773   end.
     7774   display
     7775   ink-doc.qnty ink-doc.num-chk rs-sort ink-doc.tot-doc ink-doc.discnt
     7776   ink-doc.netto @ s-netto
     7777   s-pc WHEN abs( s-pc ) < 1000
     7778   ink-doc.sub-discnt
     7779           with frame d-sale.
     7780   if s-pc = ? or s-pc > 1000 and s-pc:visible in frame d-sale then do:
     7781   hide s-pc.
     7782   end.
     7783   run shapka in this-procedure .
     7784   FIND FIRST t-doc WHERE t-doc.doc-code= ink-doc.inkas-code NO-LOCK.
     7785   FIND FIRST ret-doc WHERE ret-doc.doc-code = t-doc.out-code NO-LOCK no-error.
     7786   run openbr in this-procedure ( input t-doc.doc-code, input br-2-doc-code, input yes, input no, input '':U, input '':U).
     7787   APPLY "value-changed" to br-out.
     7788   APPLY "value-changed" to br-ret.
     7789   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     7790   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     7791     (output v-sys-key
     7792     ) no-error .
     7793   if v-sys-key begins "Rosneft-" or v-sys-key eq "ibs" or v-sys-key eq "yukos"  then hide b-places in frame d-sale.
     7794   run waitfram-hide in this-procedure .
     7795   END PROCEDURE.
     7796   procedure OpenBr :
     7797   define input parameter p-br1-doc-code like ub.trn-doc.doc-code no-undo .
     7798   define input parameter p-br2-doc-code like ub.trn-doc.doc-code no-undo .
     7799   define input  parameter p-open-query     as logical   no-undo .
     7800   define input  parameter p-find-next      as logical   no-undo .
     7801   define input  parameter p-find-condition as character no-undo .
     7802   define input parameter p-caller as character no-undo .
     7803   define variable sort-column-phrase as character no-undo .
     7804   define variable l-open-query as logical   no-undo .
     7805   define variable l-query-was-opened as logical no-undo .
     7806   define variable v-sort-phrase1 as character no-undo .
     7807   define variable v-sort-phrase2 as character no-undo .
     7808   if br-2-mode = chr(4) then browse br-ret:title  = "[Нет второго документа по продаже для просмотра]" no-error .
     7809   else
     7810   assign
     7811   browse br-ret:title  = substitute("&1 &2 &3", entry (lookup (entry(1, br-2-mode, chr(4)), 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U ), entry(2, br-2-mode, chr(4)), br-2-doc-code) no-error .
     7812   run waitfram-show in this-procedure ( input "Ждите...").
     7813   if lookup( 'ИЗМЕНЕНИЕ':U, p-mode ) > 0 then  do:
     7814     assign
     7815     v-sort-phrase1 = " by ( out-dtl.doc-qnty = out-dtl.fact-qnty ) "
     7816     v-sort-phrase2 = " by ( ret-dtl.doc-qnty = ret-dtl.fact-qnty ) "
     7817     .
     7818   end.
     7819   else do:
     7820     CASE rs-sort :
     7821       when "discount":U then  do:
     7822         assign
     7823         v-sort-phrase1 = " by ( out-dtl.discnt-base / out-dtl.price-base ) "
     7824         v-sort-phrase2 = " by ( ret-dtl.discnt-base / ret-dtl.price-base ) "
     7825         .
     7826       end.
     7827       when "quantity":U then do:
     7828         assign
     7829         v-sort-phrase1 = " by ( out-dtl.fact-qnty ) "
     7830         v-sort-phrase2 = " by ( ret-dtl.fact-qnty ) "
     7831         .
     7832       end.
     7833       when "price":U then do:
     7834         assign
     7835         v-sort-phrase1 = " by ( out-dtl.price-base ) "
     7836         v-sort-phrase2 = " by ( ret-dtl.price-base ) "
     7837         .
     7838       end.
     7839       when "summa":U then do:
     7840         assign
     7841         v-sort-phrase1 = " by ( out-dtl.fact-qnty * out-dtl.price-base ) "
     7842         v-sort-phrase2 = " by ( ret-dtl.fact-qnty * ret-dtl.price-base ) "
     7843         .
     7844       end.
     7845       when "off":U then do:
     7846         assign
     7847         v-sort-phrase1 = "  "
     7848         v-sort-phrase2 = "  "
     7849         .
     7850       end.
     7851     END CASE .
     7852   end.
     7853   case sort-column-name-out :
     7854     when "" then do:
     7855     assign
     7856       sort-column-phrase = v-sort-phrase1
     7857     .
     7858     end.
     7859     otherwise do:
     7860     assign
     7861       sort-column-phrase = " by " + sort-column-name-out
     7862     .
     7863     end.
     7864   end case.
