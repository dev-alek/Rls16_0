     4726   procedure re-open-query-srt-clmnbr-ret:
     4727   if cur-clmnbr-ret = ? then do:
     4728      run OpenBr in this-procedure (input ink-doc.inkas-code, input br-2-doc-code, input yes, input no, input '':U, input '':U).
     4729   end.
     4730   else do:
     4731      assign re-querybr-ret = yes.
     4732      run sort-brbr-ret
     4733        (input (if available ret-dtl
     4734                then recid(ret-dtl)
     4735                else ?
     4736               )
     4737        ).
     4738      assign re-querybr-ret = no.
     4739   end.
     4740   end.
     4741   ASSIGN FRAME d-sale:SCROLLABLE       = FALSE
     4742                br-out:NUM-LOCKED-COLUMNS IN FRAME d-sale = 2
     4743                br-ret:NUM-LOCKED-COLUMNS IN FRAME d-sale = 2.
     4744   ASSIGN b-res:POPUP-MENU IN FRAME d-sale = MENU m-recs:HANDLE.
     4745   ASSIGN b-res:MENU-MOUSE = 1.
     4746   ASSIGN b-unres:POPUP-MENU IN FRAME d-sale = MENU m-unrecs:HANDLE.
     4747   ASSIGN b-unres:MENU-MOUSE = 1.
     4748   ASSIGN b-arch:POPUP-MENU IN FRAME d-sale = MENU m-arch:HANDLE.
     4749   ASSIGN b-arch:MENU-MOUSE = 1.
     4750   ASSIGN b-troublp:POPUP-MENU IN FRAME d-sale = MENU m-parts:HANDLE.
     4751   ASSIGN b-troublp:MENU-MOUSE = 1.
     4752   ON MOUSE-SELECT-DBLCLICK OF g-image IN FRAME d-sale
     4753   DO:
     4754       RUN ref/imagelist.w (PARPARENTPROC, "":U, v-gds-code,'ПРОСМОТР':U).
     4755   END.
     4756   ON ENTRY OF
     4757   br-out,
     4758   BR-RET
     4759   IN FRAME d-sale DO:
     4760     assign
     4761     current-browser = self
     4762     qh = current-browser:query
     4763     bh = qh:get-buffer-handle(1)
     4764     brwh = self
     4765     .
     4766   END.
     4767   ON choose OF MENU-ITEM m-arch-i in menu m-arch DO:
     4768       apply "choose" to b-arch in frame d-sale.
     4769   END.
     4770   ON choose OF MENU-ITEM m-parts-i in menu m-parts DO:
     4771       apply "choose" to b-troublp in frame d-sale.
     4772   END.
     4773   ON choose OF MENU-ITEM m-recs-1 in menu m-recs DO:
     4774   assign
     4775   rdoc-line = ?
     4776   rgds-dtl = ?
     4777   r-or-v = ?
     4778   r-office = ?
     4779   r-qnty = ?
     4780   r-b-code = ?
     4781   r-pl-code = ?
     4782   r-doc-prts-qnty = ?
     4783   from-menu = yes.
     4784   assign
     4785   auto-close = input frame d-sale auto-close
     4786   auto-fbr
     4787   rest-dish
     4788   rest-ingr
     4789   rest-tpsi
     4790   .
     4791   if auto-close then do:
     4792     glog = no.
     4793     message
     4794     (IF not b-mail-pressed then "В течение данного сеанса работы с продажей вы не докачивали новые чеки!"
     4795                             else "")
     4796     "ВНИМАНИЕ!!! Включен режим автоматического закрытия продажи по результатам резервирования!"
     4797     skip "Вы уверены, что хотите закрыть продажу?" view-as alert-box WARNING
     4798     buttons YES-NO update glog.
     4799     if not glog then return no-apply.
     4800   end.
     4801       run b-res-proc in this-procedure (
     4802                                          buffer ink-doc
     4803                                        , buffer t-doc
     4804                                        , buffer ret-doc
     4805                                        , input no
     4806                                        , input auto-close
     4807                                        , input no
     4808                                        , input rest-dish
     4809                                        , input "":U
     4810                                        , input v-is-tpsi-obj
     4811                                        , input rest-tpsi) no-error .
     4812       if error-status:error  or return-value = "error" then do:
     4813         run waitfram-hide in this-procedure .
     4814         return no-apply.
     4815       end.
     4816       if auto-close and b-close:sensitive in frame d-sale then do:
     4817         assign
     4818         v-parameter =     v-curr-r-b                     + chr(4) +
     4819                           ink-doc.inkas-code             + chr(4) +
     4820                         string(0)              + chr(4) +
     4821                         string(auto-close)               + chr(4) +
     4822                         string(b-mail-pressed)           + chr(4) +
     4823                         string(auto-comp)                + chr(4) +
     4824                         string(auto-fbr)                 + chr(4) +
     4825                         string(one-curs)                 + chr(4) +
     4826                         string(ub.shop.is-catering)      + chr(4) +
     4827                         string(v-is-tpsi-obj)            + chr(4) +
     4828                         string(rest-dish)                + chr(4) +
     4829                         string(rest-ingr)                + chr(4) +
     4830                         string(rest-tpsi)                + chr(4) +
     4831                         string(neg-tpsi-weight)          + chr(4) +
     4832                         string(neg-tpsi-qnty)            + chr(4) +
     4833                         string(neg-tpsi-oper)            + chr(4) +
     4834                         string(close-in-rfsl)            + chr(4) +
     4835                         pay-gds-algo
     4836        .
     4837           run str/diallog.w (
     4838                 input parParentProc
     4839               , input this-procedure
     4840               , input ("str/saleclos.p":U + chr(4) + "1":U +
     4841                       "1":U  + chr(4) +
     4842                       "1":U + chr(4) +
     4843                       "1":U)
     4844               , input v-parameter
     4845               , input no
     4846               , input "":U
     4847               , input substitute("Закрытие продажи &1", Ink-doc.inkas-code)
     4848           ) no-error.
     4849           if error-status:error
     4850           or return-value = "error":U
     4851           then do:
     4852               run close-error-processing in this-procedure.
     4853               return no-apply.
     4854           end.
     4855           else do:
     4856             assign
     4857             p-next-prev = ?.
     4858             APPLY "CHOOSE" to b-exit.
     4859           end.
     4860       end.
     4861       APPLY "ENTRY" to br-out.
     4862   END.
     4863   ON choose OF MENU-ITEM m-unrecs-1 in menu m-unrecs DO:
     4864   assign
     4865   rdoc-line = ?
     4866   rgds-dtl = ?
     4867   r-or-v = ?
     4868   r-office = ?
     4869   r-qnty = ?
     4870   r-b-code = ?
     4871   r-pl-code = ?
     4872   r-doc-prts-qnty = ?
     4873   from-menu = yes.
     4874   apply "choose" to b-unres in frame d-sale.
     4875   APPLY "ENTRY" to br-out.
     4876   END.
     4877   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4878   define variable varscales-pref33 as character no-undo .
     4879   define variable varpgscales-pref33 as character no-undo.
     4880   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4881   define variable varscales-pref-type34 as character no-undo.
     4882   varscales-pref33  = ?.
     4883   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     4884     (input  'sclspref':u
     4885     ,input  '':u
     4886     ,input  '':u
     4887     ,input  0
     4888     ,input  '':u
     4889     ,input  '':u
     4890     ,input  '':u
     4891     ,input  no
     4892     ,output varscales-pref33
     4893     ,output varscales-pref-type34
     4894     ) no-error .
     4895   if varscales-pref33 = ? then do:
     4896     assign
     4897     varscales-pref33 = '21,23,25':U.
     4898   end.
     4899   define variable varpgscales-pref-type34 as character no-undo.
     4900   varpgscales-pref33  = ?.
     4901   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     4902     (input  'scpgpref':u
     4903     ,input  '':u
     4904     ,input  '':u
     4905     ,input  0
     4906     ,input  '':u
     4907     ,input  '':u
     4908     ,input  '':u
     4909     ,input  no
     4910     ,output varpgscales-pref33
     4911     ,output varpgscales-pref-type34
     4912     ) no-error .
     4913   if varpgscales-pref33 = ? then do:
     4914     assign
     4915     varpgscales-pref33 = '24IIIIIQQ000C,28IIIIIQQQ00C':U.
     4916   end.
     4917   on value-changed of a-n-c in frame d-sale do:
     4918     run proc-valchg-a-n-c in this-procedure  no-error.
     4919     return no-apply.
     4920   end.
     4921   on any-printable of br-out in frame d-sale do:
     4922     run proc-any-printable-br-out in this-procedure   no-error.
     4923     return no-apply.
     4924   end.
     4925   on backspace of br-out in frame d-sale do:
     4926     run proc-backspace-br-out in this-procedure   no-error.
     4927     return no-apply.
     4928   end.
     4929   ON return OF loc-code IN FRAME d-sale do:
     4930     run proc-mouse-dbl-click-loc-code in this-procedure   no-error.
     4931     return no-apply.
     4932   end.
     4933   ON return, Ctrl-J OF loc-name IN FRAME d-sale do:
     4934     run proc-mouse-dbl-click-loc-name in this-procedure   no-error.
     4935     return no-apply.
     4936   end.
     4937   PROCEDURE proc-valchg-a-n-c:
     4938     case input frame d-sale a-n-c :
     4939       when "art" then do:
     4940         apply "entry" to br-out in frame d-sale.
     4941         hide loc-name loc-code
     4942         in frame d-sale.
     4943         loc-art = "".
     4944       end.
     4945       when "name" then do:
     4946         enable loc-name with frame d-sale.
     4947         disp loc-name with frame d-sale.
     4948         hide loc-art loc-code
     4949         in frame d-sale.
     4950         apply "entry" to loc-name in frame d-sale.
     4951       end.
     4952       when "code"
     4953    or when "DataMatrix" then
     4954       do:
     4955         enable loc-code with frame d-sale.
     4956         disp loc-code with frame d-sale.
     4957         hide loc-art loc-name
     4958         in frame d-sale.
     4959         apply "entry" to loc-code in frame d-sale.
     4960       end.
     4961     end CASE.
     4962   END PROCEDURE.
     4963   PROCEDURE proc-any-printable-br-out :
     4964     if input frame d-sale a-n-c = "art" then do:
     4965       if last-event:label = " " and
     4966          loc-art = "" then
     4967       return error.
     4968       find first l-out-dtl where
     4969                  (l-out-dtl.doc-code = ink-doc.inkas-code) and l-out-dtl.artic begins (loc-art + last-event:label)
     4970                  no-lock no-error.
     4971       if available l-out-dtl then do:
     4972         loc-art = loc-art + last-event:label.
     4973         disp loc-art with frame d-sale.
     4974         line-rec = recid (l-out-dtl).
     4975         reposition br-out to recid line-rec no-error.
     4976       end.
     4977     end.
     4978   END PROCEDURE.
     4979   PROCEDURE proc-backspace-br-out:
     4980     if input frame d-sale a-n-c = "art" then do:
     4981       if loc-art = "" then
     4982         return error.
     4983       loc-art = substr (loc-art, 1, length (loc-art) - 1).
     4984       find first l-out-dtl where
     4985                  (l-out-dtl.doc-code = ink-doc.inkas-code) and l-out-dtl.artic begins loc-art
     4986                  no-lock.
     4987       disp loc-art with frame d-sale.
     4988       line-rec = recid (l-out-dtl).
     4989       reposition br-out to recid line-rec no-error.
     4990     end.
     4991   END PROCEDURE.
     4992   PROCEDURE proc-mouse-dbl-click-loc-code:
     4993   def var str-code as integer no-undo.
     4994   define variable varresult   as character         no-undo.
     4995   define variable vartype-bc  as character         no-undo.
     4996   define variable varweight   as decimal           no-undo.
     4997   define buffer l-goods for ub.goods.
     4998   define buffer l-bar-code for ub.bar-code.
     4999   define buffer buf_bar-code for ub.bar-code .
     5000   define buffer buf_prod-bc for ub.prod-bc.
     5001   define buffer buf_place for ub.place.
     5002     assign
     5003     frame d-sale
     5004     loc-code
     5005     a-n-c.
     5006     if a-n-c = "datamatrix"
     5007     then do:
     5008   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_dm-rcnz in g#libbcrcn
     5009   (
     5010    input  parparentproc
     5011   ,input  loc-code
     5012   ,input  ?
     5013   ,input  p-obj-type
     5014   ,input  p-obj-code
     5015   ,input  yes
     5016   ,input  no
     5017   ,input  varscales-pref33
     5018   ,input  varpgscales-pref33
     5019   ,output varresult
     5020   ,output vartype-bc
     5021   ,output varweight
     5022   ,buffer buf_bar-code
     5023   ,buffer buf_prod-bc
     5024   ,buffer buf_place
     5025   ) no-error.
     5026        if varresult eq "prod-bc"
     5027        then
     5028           loc-code:screen-value in frame d-sale = buf_prod-bc.b-str.
     5029     end.
     5030     else do:
     5031   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     5032   (
     5033    input  parparentproc
     5034   ,input  loc-code
     5035   ,input  ?
     5036   ,input  p-obj-type
     5037   ,input  p-obj-code
     5038   ,input  yes
     5039   ,input  no
     5040   ,input  varscales-pref33
     5041   ,input  varpgscales-pref33
     5042   ,output varresult
     5043   ,output vartype-bc
     5044   ,output varweight
     5045   ,buffer buf_bar-code
     5046   ,buffer buf_prod-bc
     5047   ,buffer buf_place
     5048   ) no-error.
     5049     end.
     5050     if available buf_bar-code then do:
     5051           find first l-goods where
     5052                     l-goods.gds-code =
     5053     buf_bar-code.gds-code No-LOCK.
     5054           find first l-out-dtl where (l-out-dtl.doc-code = ink-doc.inkas-code) and
     5055                     l-out-dtl.artic = l-goods.artic AND
     5056                     l-out-dtl.prod-type = l-goods.prod-type AND
     5057                     l-out-dtl.prod-code = l-goods.prod-code no-lock no-error.
     5058       if available l-out-dtl then do:
     5059         line-rec = recid (l-out-dtl).
     5060         reposition br-out to recid line-rec no-error.
     5061       end.
     5062       else do:
     5063         message "Строка не найдена."
     5064                 view-as alert-box error.
     5065       end.
     5066     end.
     5067     else
     5068       message "Бар-код не найден."
     5069               view-as alert-box error.
     5070     apply "entry" to loc-code in frame d-sale.
     5071   END PROCEDURE.
     5072   PROCEDURE  proc-mouse-dbl-click-loc-name:
     5073     assign
     5074     frame d-sale
     5075     loc-name.
     5076       if last-event:label = "Ctrl-J" then
     5077         find next l-out-dtl where (l-out-dtl.doc-code = ink-doc.inkas-code) and
     5078                   can-find (ub.goods where ub.goods.artic = l-out-dtl.artic and
     5079                   ub.goods.prod-type = l-out-dtl.prod-type and
     5080                   ub.goods.prod-code = l-out-dtl.prod-code and
     5081                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     5082       else
     5083         find first l-out-dtl where (l-out-dtl.doc-code = ink-doc.inkas-code) and
     5084                   can-find (ub.goods where ub.goods.artic = l-out-dtl.artic and
     5085                   ub.goods.prod-type = l-out-dtl.prod-type and
     5086                   ub.goods.prod-code = l-out-dtl.prod-code and
     5087                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     5088       if available l-out-dtl then do:
     5089         line-rec = recid (l-out-dtl).
     5090         reposition br-out to recid line-rec no-error.
     5091       end.
     5092       else do:
     5093         message "Строка не найдена."
     5094                 view-as alert-box error.
     5095       end.
     5096     apply "entry" to loc-name in frame d-sale.
     5097   END PROCEDURE.
     5098   on value-changed of br-out in frame d-sale do:
     5099   if not available out-dtl or recid (out-dtl) <> line-rec then do:
     5100       hide loc-art in frame d-sale.
     5101       loc-art = "".
     5102   end.
     5103   end.
     5104   on choose of b-cash in frame d-sale
     5105   do:
     5106       run str/ink-oth.w ( input parparentproc, ink-doc.inkas-code).
     5107       apply "entry" to br-out in frame d-sale.
     5108   end.
     5109   on choose of b-print in frame d-sale
     5110   do:
     5111   DEFINE VARIABLE v-frame-width as integer no-undo .
     5112   define buffer t-clients for ub.clients.
     5113       run rep/sale-prn.p (
     5114                        input parparentproc
     5115                       ,input recid(ink-doc)
     5116                       ,input yes).
     5117       apply "entry" to br-out in frame d-sale.
     5118   end.
     5119   ON RIGHT-MOUSE-CLICK OF br-out
     5120   or RIGHT-MOUSE-CLICK OF BR-ret
     5121   IN FRAME d-sale
     5122   DO:
     5123   define buffer buf_tt0-info for tt0-info.
     5124   assign
     5125   current-browser = self.
     5126   qh = current-browser:query.
     5127   bh = qh:get-buffer-handle(1).
     5128   brwh = self .
     5129   if not bh:available then return no-apply.
     5130   assign
     5131   v-artic    = bh:buffer-field('artic':U):buffer-value
     5132   v-prod-type  = bh:buffer-field('prod-type':U):buffer-value
     5133   v-node-code  = bh:buffer-field('prt-code':U):buffer-value
     5134   .
     5135   FIND FIRST buf_tt0-info WHERE
     5136             buf_tt0-info.artic = v-artic
     5137         and buf_tt0-info.prod-type = v-prod-type
     5138         and buf_tt0-info.prod-code = v-prod-code
     5139         and buf_tt0-info.prt-code = v-node-code no-error .
     5140    if available buf_tt0-info then do:
     5141      message
     5142      buf_tt0-info.error-message
     5143      view-as alert-box .
     5144    end.
     5145   END.
     5146   on choose of b-troubl in frame d-sale
     5147   do:
     5148   define buffer buf_tt0-gds-dtl for tt0-gds-dtl.
     5149   define buffer buf_tt0-doc-line for tt0-doc-line.
     5150       RUN neg-rests in this-procedure (
     5151                      input no
     5152                     , input ink-doc.status_
     5153                     , input ink-doc.inkas-code
     5154                     , input (if ink-doc.status_ = 'факт':U
     5155                             or ink-doc.status_ = 'запрос':U
     5156                             then 'ПРОСМОТР':U else 'ИЗМЕНЕНИЕ':U)
     5157                     , input ub.shop.is-catering
     5158                     , input v-is-tpsi-obj
     5159                     , input neg-tpsi-weight
     5160                     , input neg-tpsi-qnty
     5161                     , input neg-tpsi-oper
     5162                     ).
     5163       IF can-find (first dtl-rests) then do:
     5164           run str/badsale.w (
     5165                 input parparentproc
     5166               , input p-mode
     5167               , input ink-doc.inkas-code
     5168               , input shop.is-catering
     5169               , input v-is-tpsi-obj
     5170               , input neg-tpsi-oper
     5171             ).
     5172   apply "entry" to br-out in frame d-sale.
     5173   for each dtl-rests:
     5174       if t-doc.status_ <> 'факт':U
     5175       and t-doc.status_ <> 'запрос':U
     5176       and p-mode = 'ИЗМЕНЕНИЕ':U
     5177       and v-is-tpsi-obj
     5178       and dtl-rests.is-neg-tpsi-oper then do:
     5179         find first dtl-rests-mark where
     5180                   dtl-rests-mark.artic = dtl-rests.artic
     5181               and dtl-rests-mark.prod-type = dtl-rests.prod-type
     5182               and dtl-rests-mark.prod-code = dtl-rests.prod-code no-error .
     5183         if not available dtl-rests-mark then do:
     5184           create dtl-rests-mark.
     5185           buffer-copy dtl-rests to dtl-rests-mark.
     5186           release dtl-rests-mark.
     5187         end.
     5188       end.
     5189       delete dtl-rests.
     5190     end.
     5191     if can-do( 'ИЗМЕНЕНИЕ':U, p-mode ) then do:
     5192       disable b-close
     5193       with frame d-sale .
     5194       b-close-enabled = no.
     5195       RUN button-close in this-procedure (
     5196                                               buffer t-doc
     5197                                               ,buffer ret-doc
     5198                                               ,input v-is-tpsi-obj
     5199                                               ,input auto-fbr
     5200                                               ,input neg-tpsi-weight
     5201                                               ,input neg-tpsi-qnty
     5202                                               ,input neg-tpsi-oper
     5203                                               ,Output b-close-enabled).
     5204       ENABLE
     5205       b-close when ((auto-comp
     5206                     and can-find(first ub.sale-doc where
     5207                                       ub.sale-doc.inkas-code = ink-doc.inkas-code
     5208                                   and ub.sale-doc.doc-kind = 'rs':U)
     5209                     )
     5210                     OR b-close-enabled)
     5211       with frame d-sale .
     5212     end.
     5213   end.
     5214   else do:
     5215       message "Не найдено ошибок для товаров, по которым недопустимы отрицательные остатки!"
     5216       view-as alert-box.
     5217       apply "entry" to br-out in frame d-sale.
     5218   end.
     5219   end.
     5220   on choose of b-troublp in frame d-sale
     5221   do:
     5222   define buffer buf_sale-doc for ub.sale-doc.
     5223   for each buf_sale-doc where
     5224          buf_Sale-doc.inkas-code = ink-doc.inkas-code:
     5225     if buf_sale-doc.doc-kind = 'rwo':U then NEXT.
     5226     FIND FIRST ub.parts where
     5227             ub.parts.out-code = buf_sale-doc.doc-code
     5228         AND ub.parts.out-code = ub.parts.in-code NO-LOCK NO-ERROR.
     5229     if available parts then do:
     5230       LEAVE.
     5231     end.
     5232   end.
     5233   if not available parts then do:
     5234     message
     5235     "Нет отрицательных партий, порожденных данной продажей!"
     5236     view-as alert-box .
     5237     return no-apply.
     5238   end.
     5239   run str/badsalp.w ( input parparentproc
     5240                     , input recid(ink-doc)
     5241                     , input recid(ub.goods)).
     5242   apply "entry" to br-out in frame d-sale.
     5243   end.
     5244   on choose of b-parts in frame d-sale
     5245   do:
     5246       run proc-parts-tovar in this-procedure no-error.
     5247       if error-status:error then return no-apply.
     5248   end.
     5249   on choose of b-chk in frame d-sale do:
     5250   define variable r-rec as recid.
     5251   define variable v-rec as recid.
     5252   DEFINE VARIABLE varrid-list as character no-undo .
     5253   define buffer t-clients for ub.clients.
     5254   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5255   glog = yes.
     5256   FIND FIRST t-clients NO-LOCK WHERE
     5257                       t-clients.obj-code = ink-doc.obj-code AND
     5258                       t-clients.obj-type = ink-doc.obj-type
     5259       No-ERROR.
     5260   IF t-clients.db-num <> g#db-num and g#db-num <> 0 then do:
     5261       if YES then
     5262       message "Нельзя получить информацию по чекам объекта "  ink-doc.obj-code ink-doc.obj-type
     5263       "в базе данных N " g#db-num
     5264       view-as alert-box.
     5265       glog = no.
     5266   end.
     5267   else if g#db-num = 0 AND t-clients.db-num <> g#db-num then do:
     5268       FIND FIRST ub.db No-LOCK WHERE ub.db.db-num = t-clients.db-num No-ERROR.
     5269       if NOT ub.db.send-check then do:
     5270           if YES then
     5271           message "Нельзя получить информацию по чекам объекта "  ink-doc.obj-code ink-doc.obj-type
     5272           "в базе данных N " g#db-num
     5273           view-as alert-box.
     5274           glog = no.
     5275       end.
     5276   end.
     5277       if NOT glog then return no-apply.
     5278       assign
     5279       r-rec = bh-out-dtl:recid
     5280       v-rec = bh-ret-dtl:recid
     5281       .
     5282       run str/chk-docs.w (
     5283                        input parparentproc
     5284                       ,input  (if p-mode = 'ПРОСМОТР':U then '':U else "b-del":U)
     5285                       ,input 'продажа':U
     5286                       ,input ?
     5287                       ,input ink-doc.obj-type
     5288                       ,input ink-doc.obj-code
     5289                       ,input ink-doc.inkas-code
     5290                       ,input '':U
     5291                       ,input 0
     5292                       ,input  ?
     5293                       ,input  ?
     5294                       ,input 0
     5295                       ,output varrid-list) no-error.
     5296     if p-mode = 'ИЗМЕНЕНИЕ':U and return-value = "deleted" then do:
     5297       run reget-br-2 in this-procedure .
     5298       run UI-on in this-procedure .
     5299     end.
     5300     apply "entry" to br-out in frame d-sale.
     5301   end.
     5302   on end-error, stop of frame d-sale
     5303   do:
     5304     run waitfram-hide in this-procedure .
     5305     apply "CHOOSE" to b-exit in frame d-sale.
     5306     return no-apply.
     5307   end.
     5308   ON CHOOSE OF b-exit IN FRAME d-sale
     5309   DO:
     5310       p-next-prev = ?.
     5311   END.
     5312   ON CHOOSE OF b-close IN FRAME d-sale
     5313   DO:
     5314       assign
     5315       auto-close
     5316       auto-fbr
     5317       rest-dish
     5318       rest-ingr
     5319       rest-tpsi
     5320       .
