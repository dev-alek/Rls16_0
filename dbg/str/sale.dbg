       85   DEFINE TEMP-TABLE temp-pl NO-UNDO
       86   FIELD pl-code like ub.bar-code.b-code
       87   FIELD IS-OUT as integer
       88   FIELD Doc-qnty like ub.doc-prts.doc-qnty
       89   FIELD fact-qnty like ub.doc-prts.fact-qnty
       90   field new-fact-qnty like ub.doc-pl.fact-qnty
       91   INDEX pi is UNIQUE PRIMARY is-out
       92                              pl-code
       93   index qnty doc-qnty
       94   .
       95   DEFINE TEMP-TABLE temp-prts NO-UNDO
       96   FIELD b-code like ub.bar-code.b-code
       97   FIELD IS-OUT as integer
       98   FIELD Doc-qnty like ub.doc-prts.doc-qnty
       99   FIELD fact-qnty like ub.doc-prts.fact-qnty
      100   field new-fact-qnty like ub.doc-prts.fact-qnty
      101   FIELD RC as character
      102   FIELD twounit as logical
      103   FIELD compensed as logical
      104   INDEX pi is UNIQUE PRIMARY is-out
      105                              b-code
      106                              rc
      107   index qnty compensed
      108              doc-qnty
      109   .
