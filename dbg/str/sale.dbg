     3673   def
     3674   new shared
     3675   temp-table  obj-list no-undo
     3676     field obj-type like ub.clients.obj-type
     3677     field obj-code like ub.clients.obj-code
     3678     field obj-name like ub.clients.obj-name
     3679     field obj-id   as integer
