     6490     define variable v-change-sign          as integer   no-undo .
     6491     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     6492     define buffer buf_temp-browse-handle  for temp-browse-handle .
     6493     if p-change-value > 0
     6494     then do:
     6495       if frame d-sale :width + p-change-value >
     6496           session :width-chars
     6497       then do:
     6498         assign
     6499           p-change-value = session :width-chars - frame d-sale :width
     6500         .
     6501         if p-change-value <= 0
     6502         then do:
     6503           run diasize_position-resize-button in this-procedure .
     6504           return .
     6505         end.
     6506       end.
     6507     end.
     6508     if p-change-value < 0
     6509     then do:
     6510       if frame d-sale :width + p-change-value < v-diasize-orig-frame-width
     6511       then do:
     6512         assign
     6513           p-change-value = v-diasize-orig-frame-width
     6514                          - frame d-sale :width
     6515         .
     6516         if p-change-value >= 0
     6517         then do:
     6518           run diasize_position-resize-button in this-procedure .
     6519           return .
     6520         end.
     6521       end.
     6522     end.
     6523     if p-change-value >= 0
     6524     then do:
     6525       assign
     6526         v-change-sign = 1
     6527       .
     6528     end.
     6529     else do:
     6530       assign
     6531         v-change-sign = -1
     6532       .
     6533     end.
     6534     assign
     6535       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     6536     .
     6537     if p-change-value = 0
     6538     then do:
     6539       run diasize_position-resize-button in this-procedure .
     6540       return .
     6541     end.
     6542     move_block:
     6543     do
     6544     on error undo move_block, leave move_block
     6545     :
     6546       if retry
     6547       then do:
     6548         do
     6549         on error undo move_block, leave move_block
     6550         :
