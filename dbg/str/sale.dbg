     9496   PROCEDURE INV-CHK:
     9497   define input parameter p-inkas-code like ub.inkas.inkas-code no-undo .
     9498   define input parameter v-curr-r-b   as character no-undo .
     9499   define parameter buffer buf_inkas   for ub.inkas.
     9500   define parameter buffer buf_trn-doc for ub.trn-doc.
     9501   define input parameter r-or-v as character no-undo .
     9502   define input parameter r-office as character no-undo .
     9503   define input parameter rdoc-line as recid no-undo .
     9504   define variable accum-inkas-pay-tot-r-b as decimal no-undo.
     9505   define variable accum-inkas-pay-desk-tot-r-b as decimal no-undo.
     9506   define variable l-inv-on as logical no-undo .
     9507   define variable v-in-inv as logical no-undo .
     9508   define variable v-inkas-qnty-r as decimal no-undo .
     9509   define variable v-inkas-qnty-v as decimal no-undo .
