     5582   ON choose OF b-notes IN FRAME d-sale
     5583   DO:
     5584   define variable notes as character no-undo .
     5585   define variable v-recid as recid no-undo .
     5586   notes = substr(ink-doc.PS, index(ink-doc.PS, "@") + 1).
     5587   v-recid = recid(ink-doc).
     5588   run gbl/notes.w ( input p-mode, input-output notes ).
     5589   if ink-doc.PS <> notes then  do:
     5590       do on stop undo, return no-apply:
     5591           FIND FIRST ink-doc WHERE recid (ink-doc) = p-doc-rec exclusive.
     5592           ink-doc.PS = substr(ink-doc.PS, 1, index(ink-doc.PS, "@")) +  notes.
     5593       end.
     5594   end.
     5595   END.
