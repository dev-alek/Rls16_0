     2657   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_shiftnme in g#lib-trn3 ( input  loc-inkas.obj-type,
     2658                          input  loc-inkas.obj-code,
     2659                          input  loc-inkas.shift-date,
     2660                          input  loc-inkas.shift-num,
     2661                          input-output varshift-name,
     2662                          output varshift-name-num
     2663                          ) no-error .
     2664     if error-status:error then do:
     2665       return "":u.
     2666     end.
     2667     return varshift-name-num.
     2668   end function.
     2669   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2670     define variable v-cntxt-db-num        as integer   no-undo .
     2671     define variable v-cntxt-userid        as character no-undo .
     2672     define variable v-cntxt-level         as character no-undo .
     2673     define variable v-cntxt-host-code-obj as integer   no-undo .
     2674     define variable v-cntxt-obj-type      as character no-undo .
     2675     define variable v-cntxt-obj-code      as integer   no-undo .
     2676     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2677     define variable v-cntxt-is-admin      as logical   no-undo .
     2678   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2679   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     2680   procedure fltopend_fltopend :
     2681   define input parameter p-parent-handle as handle no-undo .
     2682   define input parameter p-qh as handle no-undo .
     2683   define input parameter p-flt-open-open-query  as character no-undo .
     2684   define input parameter p-where-cond as character no-undo .
     2685   define input parameter p-use-indFIRST-query-tail as character no-undo .
     2686   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     2687   define input parameter p-indexed-reposition as character no-undo .
     2688     do
     2689     on error undo, return error
     2690     :
     2691   define variable v-prepare-string as character no-undo .
     2692   define variable glog as logical no-undo .
     2693   assign
     2694   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     2695                      p-where-cond + chr(32)  +
     2696                      p-use-indFIRST-query-tail + chr(32) +
     2697                      p-use-ind-sort-clmn-by + chr(32) +
     2698                      p-indexed-reposition
     2699   .
     2700   assign
     2701   glog = p-qh:query-prepare(v-prepare-string) no-error .
     2702   if not glog
     2703   or error-status:error then do:
     2704     message error-status:get-message(1) view-as alert-box .
     2705     undo, return error .
     2706   end.
     2707   assign
     2708   glog = p-qh:query-open no-error .
     2709   if not glog
     2710   or error-status:error then do:
     2711     message error-status:get-message(1) view-as alert-box .
     2712     undo, return error .
     2713   end.
     2714     end.
     2715   end procedure.
     2716   procedure fltopend_fltfindd :
     2717   define input parameter p-parent-handle as handle no-undo .
     2718   define input parameter p-qh as handle no-undo .
     2719   define input parameter p-rowid as rowid no-undo .
     2720   define input parameter p-next as logical no-undo .
     2721   define input parameter p-lock as integer no-undo .
     2722   define input parameter p-bh as handle no-undo .
     2723   define input parameter p-where-cond as character no-undo .
     2724   define input parameter p-use-index-phrase as character no-undo .
     2725   define variable glog as logical no-undo .
     2726   define variable v-qh as handle no-undo .
     2727   define variable v-bh as handle no-undo .
     2728   define variable v-recid as recid no-undo .
     2729   define variable v-prepare-string as character no-undo .
     2730   do
     2731   on error undo, return error
     2732   on stop undo, return error
     2733   :
     2734     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     2735     create buffer v-bh for table p-bh buffer-name p-bh:name.
     2736     create query v-qh.
     2737     v-qh:set-buffers(v-bh).
     2738     v-prepare-string = substitute("for each &1 &2 &3"
     2739                                     ,v-bh:name
     2740                                     ,p-where-cond
     2741                                     ,p-use-index-phrase).
     2742     glog = v-qh:query-prepare(v-prepare-string) no-error.
     2743     if not glog then do:
     2744       delete object v-qh.
     2745       delete object v-bh.
     2746       undo, return error .
     2747     end.
     2748     glog = v-qh:query-open no-error .
     2749     if not glog then do:
     2750       delete object v-qh.
     2751       delete object v-bh.
     2752       undo, return error .
     2753     end.
     2754     if p-next then do:
     2755       v-qh:reposition-to-rowid(p-rowid) no-error .
     2756       glog = v-qh:get-next( p-lock) no-error .
     2757       glog = v-qh:get-next( p-lock) no-error .
     2758       if not glog or v-qh:query-off-end = yes then do:
     2759         glog = v-qh:get-first( p-lock) no-error .
     2760       end.
     2761     end.
     2762     else do:
     2763       glog = v-qh:get-first( p-lock) no-error .
     2764     end.
     2765     v-recid = v-bh:recid no-error .
     2766     delete object v-qh.
     2767     delete object v-bh.
     2768     return string(v-recid) .
     2769   end.
     2770   end procedure.
     2771   procedure fltopend_fltfindq :
     2772   define input parameter p-parent-handle as handle no-undo .
     2773   define input parameter p-qh as handle no-undo .
     2774   define input parameter p-next as logical no-undo .
     2775   define input parameter p-lock as integer no-undo .
     2776   define input parameter p-flt-open-open-query  as character no-undo .
     2777   define input parameter p-where-cond as character no-undo .
     2778   define input parameter p-use-indFIRST-query-tail as character no-undo .
     2779   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     2780   define input parameter p-indexed-reposition as character no-undo .
     2781   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     2782   define variable glog as logical no-undo .
     2783   define variable v-qh as handle no-undo .
     2784   define variable v-bh as handle no-undo extent 18.
     2785   define variable v-rowid as rowid no-undo extent 18.
     2786   define variable v-ii as integer no-undo .
     2787   define variable v-prepare-string as character no-undo .
     2788   do
     2789   on error undo, return error
     2790   on stop undo, return error
     2791   :
     2792     create query v-qh.
     2793     do v-ii = 1 to p-qh:num-buffers:
     2794       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     2795       assign
     2796       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     2797       no-error.
     2798       v-qh:add-buffer(v-bh[v-ii]).
     2799     end.
     2800     assign
     2801     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     2802                       p-where-cond + chr(32)  +
     2803                       p-use-indFIRST-query-tail + chr(32) +
     2804                       p-use-ind-sort-clmn-by + chr(32) +
     2805                       p-indexed-reposition
     2806     .
     2807     glog = v-qh:query-prepare( v-prepare-string) no-error .
     2808     if not glog then do:
     2809       delete object v-qh.
     2810       do v-ii = 1 to p-qh:num-buffers:
     2811         delete object v-bh[v-ii].
     2812       end.
     2813       undo, return error .
     2814     end.
     2815     glog = v-qh:query-open no-error .
     2816     if not glog then do:
     2817       delete object v-qh.
     2818       do v-ii = 1 to p-qh:num-buffers:
     2819         delete object v-bh[v-ii].
     2820       end.
     2821       undo, return error .
     2822     end.
     2823     if p-next then do:
     2824       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     2825       glog = v-qh:get-next( p-lock) no-error .
     2826       glog = v-qh:get-next( p-lock) no-error .
     2827       if not glog or v-qh:query-off-end = yes then do:
     2828         glog = v-qh:get-first( p-lock) no-error .
     2829       end.
     2830     end.
     2831     else do:
     2832       glog = v-qh:get-first( p-lock) no-error .
     2833     end.
     2834     do v-ii = 1 to p-qh:num-buffers:
     2835       assign
     2836       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     2837       no-error.
     2838     end.
     2839     delete object v-qh.
     2840     do v-ii = 1 to p-qh:num-buffers:
     2841       delete object v-bh[v-ii].
     2842     end.
     2843   end.
     2844   end procedure.
     2845   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2846       def var log-file-name as char no-undo.
     2847       assign
     2848           log-file-name = 'fbr-rsrv-errors-sale.txt'
     2849       .
     2850       if log-file-name <> "":U
     2851       then do:
     2852           if search( 'fbr-rsrv-errors-sale.txt' ) = ?
     2853           then do:
     2854               output to value( 'fbr-rsrv-errors-sale.txt' ).
     2855               output close.
     2856           end.
     2857       end.
     2858       DEF STREAM stm-log.
     2859       PROCEDURE writelog:
     2860       DEF INPUT PARAMETER p-file-name AS CHAR     NO-UNDO.
     2861       DEF INPUT PARAMETER p-log-level AS INTEGER  NO-UNDO.
     2862       DEF INPUT PARAMETER p-log-string  AS CHAR     NO-UNDO.
     2863       if p-file-name <> ""
     2864       then do:
     2865       OUTPUT STREAM stm-log TO VALUE(p-file-name) APPEND.
     2866           PUT STREAM stm-log UNFORMATTED chr(10).
     2867           PUT STREAM stm-log UNFORMATTED (IF (p-log-level = 0 OR p-log-string = "&DLine"
     2868                                           OR p-log-string = "&Line") THEN "" ELSE
     2869                                           cur-time-string-sec() + " ").
     2870           PUT STREAM stm-log UNFORMATTED
     2871                   (IF p-log-string = "&Line" THEN FILL("-", 80)
     2872                   ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
     2873                   ELSE fill(" ", p-log-level * 2) + p-log-string).
     2874       OUTPUT STREAM stm-log CLOSE.
     2875       end.
     2876       END PROCEDURE.
     2877   def var vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2878   procedure gen-key-rec :
     2879     define input  parameter p-tbl-name    as character no-undo.
     2880     define input  parameter p-bh_tbl-name as handle    no-undo.
     2881     define output parameter p-key-rec     as character no-undo.
     2882     do
     2883     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2884     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     2885     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     2886     :
     2887       define variable fh               as handle    no-undo .
     2888       define variable v-ok             as logical   no-undo .
     2889       define variable v-inform         as character no-undo .
     2890       define variable v-ind            as integer   no-undo .
     2891       define variable v-idx-field-qnty as integer   no-undo .
     2892       if p-tbl-name = ?
     2893         or p-tbl-name = "":U
     2894       then do:
     2895         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info20 ).
     2896       end.
     2897       if not p-bh_tbl-name:available then do:
     2898         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info20, p-tbl-name ).
     2899       end.
     2900       assign
     2901         p-key-rec = p-tbl-name
     2902         v-inform  = p-bh_tbl-name:index-information(1)
     2903         v-ind     = 2
     2904       .
     2905       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2906       on error undo, return error
     2907       :
     2908         assign
     2909           v-inform = p-bh_tbl-name:index-information( v-ind )
     2910           v-ind    = v-ind + 1
     2911         .
     2912       end.
     2913       if v-inform = ?
     2914         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2915         or entry( 3, v-inform, ",":U ) <> "1":U
     2916       then do:
     2917         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info20, p-tbl-name ).
     2918       end.
     2919       else do:
     2920         assign
     2921           v-idx-field-qnty = num-entries( v-inform ) - 4
     2922         .
     2923         if v-idx-field-qnty < 2 then do:
     2924           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info20, v-inform, p-tbl-name ).
     2925         end.
     2926         do v-ind = 1 to v-idx-field-qnty by 2
     2927         on error undo, return error
     2928         :
     2929           assign
     2930             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     2931             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     2932           .
     2933         end.
     2934       end.
     2935       if p-key-rec = ? then do:
     2936         assign
     2937           p-key-rec = "":U
     2938         .
     2939         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info20, p-tbl-name ).
     2940       end.
     2941     end.
     2942     return.
     2943   end procedure.
     2944   procedure gen-where-keyr-tab :
     2945     define input  parameter i-tableSerach as character no-undo.
     2946     define input  parameter i-tablekey   as character  no-undo.
     2947     define input  parameter p-key-rec    as character  no-undo.
     2948     define input  parameter p-key-handle as handle     no-undo .
     2949     define input  parameter p-db-name    as character  no-undo .
     2950     define input  parameter p-tt-handle  as handle     no-undo .
     2951     define output parameter o-Where      as character  no-undo.
     2952     do
     2953     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2954     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2955     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     2956     :
     2957       define variable v-full-tbl-name  as character no-undo .
     2958       define variable bh_tbl-name      as handle    no-undo .
     2959       define variable fh_key           as handle    no-undo .
     2960       define variable fh_search        as handle    no-undo .
     2961       define variable v-field-num      as integer   no-undo .
     2962       define variable v-count-fld      as integer   no-undo .
     2963       define variable v-inform         as character no-undo .
     2964       define variable v-ind            as integer   no-undo .
     2965       define variable v-idx-field-qnty as integer   no-undo .
     2966       define variable v-field-name     as character no-undo .
     2967       define variable v-field-val      as character no-undo .
     2968       define variable v-word-link      as character no-undo .
     2969       define variable vTable           as character no-undo.
     2970       define variable bh_tbl-key       as handle    no-undo .
     2971       assign
     2972         p-key-rec = trim( p-key-rec )
     2973       .
     2974       if p-key-handle <> ? then do:
     2975         if not valid-handle(p-key-handle)
     2976            or p-key-handle:type <> "buffer"
     2977         then do:
     2978           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info20 ).
     2979         end.
     2980         if num-entries( p-key-rec, chr(3) ) > 1
     2981           or p-key-rec = ?
     2982           or p-key-rec = "":U
     2983         then do:
     2984           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info20, p-key-rec ).
     2985         end.
     2986       end.
     2987       else do:
     2988         if p-key-rec = ?
     2989           or p-key-rec = "":U
     2990         then do:
     2991           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info20 ).
     2992         end.
     2993       end.
     2994       assign
     2995         vTable = entry( 1 , p-key-rec, chr(3) )
     2996       .
     2997       if p-tt-handle <> ?
     2998         and ( not valid-handle(p-tt-handle)
     2999               or p-tt-handle:type <> "buffer"
     3000             )
     3001       then do:
     3002         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info20, vTable, chr(10) ).
     3003       end.
     3004       if p-tt-handle = ? then do:
     3005         assign
     3006           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     3007         .
     3008         create buffer bh_tbl-name for table v-full-tbl-name .
     3009       end.
     3010       else do:
     3011         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     3012       end.
     3013       assign
     3014         v-inform = bh_tbl-name:index-information(1)
     3015         v-ind    = 2
     3016       .
     3017       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3018       on error undo, return error
     3019       :
     3020         assign
     3021           v-inform = bh_tbl-name:index-information( v-ind )
     3022           v-ind    = v-ind + 1
     3023         .
     3024       end.
     3025       if v-inform = ?
     3026         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3027         or entry( 3, v-inform, ",":U ) <> "1":U
     3028       then do:
     3029         delete object bh_tbl-name no-error.
     3030         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info20, vTable ).
     3031       end.
     3032       assign
     3033         v-idx-field-qnty = num-entries( v-inform ) - 4
     3034       .
     3035       if v-idx-field-qnty < 2 then do:
     3036         delete object bh_tbl-name no-error.
     3037         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info20, v-inform, vTable ).
     3038       end.
     3039       assign
     3040         o-where     = "where":U
     3041         v-word-link = "":U
     3042         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     3043         v-count-fld = 0
     3044       .
     3045       if i-tablekey ne "" and i-tablekey ne ?
     3046       then do:
     3047         assign
     3048           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     3049         .
     3050         create buffer bh_tbl-key for table v-full-tbl-name .
     3051       end.
     3052       if i-tableSerach ne "" and i-tableSerach ne ?
     3053       then do:
     3054         delete object bh_tbl-name no-error.
     3055         assign
     3056           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     3057         .
     3058         create buffer bh_tbl-name for table v-full-tbl-name .
     3059       end.
     3060       block_where:
     3061       do v-ind = 1 to v-idx-field-qnty by 2
     3062       on error undo, return error
     3063       :
     3064         assign
     3065           v-count-fld = v-count-fld + 1
     3066         .
     3067         if p-key-handle = ?
     3068           and v-count-fld > v-field-num
     3069         then do:
     3070           leave block_where.
     3071         end.
     3072         define variable VfieldKeyTable as handle no-undo.
     3073         assign
     3074           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     3075           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     3076         .
     3077         if     bh_tbl-key ne ?
     3078         then do:
     3079            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     3080            if VfieldKeyTable eq ?
     3081            then next block_where.
     3082         end.
     3083         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     3084         then
     3085            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     3086         else
     3087            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     3088         if p-key-handle = ? then do:
     3089           assign
     3090             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     3091           .
     3092         end.
     3093         else do:
     3094           assign
     3095             fh_key = p-key-handle:buffer-field( v-field-name )
     3096           .
     3097           if fh_key = ?
     3098             or not valid-handle( fh_key )
     3099           then do:
     3100             delete object bh_tbl-name.
     3101             if     bh_tbl-key ne ?
     3102             then
     3103                delete object bh_tbl-key.
     3104             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info20, p-key-handle:name, v-field-name ).
     3105           end.
     3106           assign
     3107             v-field-val = fh_key:buffer-value
     3108           .
     3109         end.
     3110         if fh_search:data-type ="character":U then do:
     3111           assign
     3112             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     3113             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     3114             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     3115             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     3116             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     3117             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     3118             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     3119             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     3120             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     3121             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     3122             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     3123             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     3124             v-field-val = substitute( '"&1"', v-field-val )
     3125           .
     3126         end.
     3127         assign
     3128           o-where = substitute( "&1 &2", o-where, v-field-val )
     3129         .
     3130         if v-word-link = "":U then do:
     3131           assign
     3132             v-word-link = "and":U
     3133           .
     3134         end.
     3135       end.
     3136       delete object bh_tbl-name.
     3137       if     bh_tbl-key ne ?
     3138       then
     3139          delete object bh_tbl-key.
     3140       if p-key-handle = ?
     3141         and v-count-fld <> v-field-num
     3142       then do:
     3143         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info20, vTable ).
     3144       end.
     3145     end.
     3146   end procedure.
     3147   procedure gen-hn-keyr-tab :
     3148     define input  parameter i-tableSerach as character no-undo.
     3149     define input  parameter i-tablekey   as character no-undo.
     3150     define input  parameter p-key-rec    as character no-undo.
     3151     define input  parameter p-key-handle as handle    no-undo .
     3152     define input  parameter p-db-name    as character no-undo .
     3153     define input  parameter p-tt-handle  as handle    no-undo .
     3154     define input  parameter p-stts-lock  as integer   no-undo .
     3155     define output parameter o-hn         as handle    no-undo.
     3156     define variable v-full-tbl-name as character no-undo.
     3157     define variable v-where         as character no-undo.
     3158     define variable bh_tbl-name     as handle    no-undo.
     3159     define variable vTable          as character no-undo.
     3160     do
     3161     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3162     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     3163     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     3164         run gen-where-keyr-tab(i-tableSerach,
     3165                                i-tablekey,
     3166                                p-key-rec,
     3167                                p-key-handle,
     3168                                p-db-name,
     3169                                p-tt-handle,
     3170                                output v-where).
     3171         if i-tableSerach ne "" and i-tableSerach ne ?
     3172         then do:
     3173            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     3174            create buffer bh_tbl-name for table v-full-tbl-name .
     3175         end.
     3176         else do:
     3177            if p-tt-handle = ? then do:
     3178               assign
     3179                  vTable = entry( 1 , p-key-rec, chr(3) )
     3180               .
     3181               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     3182               create buffer bh_tbl-name for table v-full-tbl-name .
     3183            end.
     3184            else do:
     3185               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     3186            end.
     3187         end.
     3188         if p-tt-handle = ? then do:
     3189            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     3190         end.
     3191         else do:
     3192            bh_tbl-name:find-first( v-where ) no-error .
     3193         end.
     3194         o-hn = bh_tbl-name.
     3195      end.
     3196   end procedure.
     3197   procedure gen-hn-keyr :
     3198     define input  parameter p-key-rec    as character no-undo.
     3199     define input  parameter p-key-handle as handle    no-undo .
     3200     define input  parameter p-db-name    as character no-undo .
     3201     define input  parameter p-tt-handle  as handle    no-undo .
     3202     define input  parameter p-stts-lock  as integer   no-undo .
     3203     define output parameter o-hn         as handle    no-undo.
     3204     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     3205   end.
     3206   procedure gen-row-keyr :
     3207     define input  parameter p-key-rec    as character no-undo.
     3208     define input  parameter p-key-handle as handle    no-undo .
     3209     define input  parameter p-db-name    as character no-undo .
     3210     define input  parameter p-tt-handle  as handle    no-undo .
     3211     define input  parameter p-stts-lock  as integer   no-undo .
     3212     define output parameter p-tbl-row    as rowid     no-undo.
     3213     define output parameter p-tbl-name   as character no-undo.
     3214     define variable vHn as handle no-undo.
     3215       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     3216       p-tbl-row = if vHn:available then vHn:rowid else ?.
     3217       p-tbl-name =  vHn:table.
     3218       delete object vHn no-error.
     3219     if p-tbl-row = ? then do:
     3220       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info20, p-tbl-name, p-key-rec ).
     3221     end.
     3222     else do:
     3223       return.
     3224     end.
     3225   end procedure.
     3226   procedure gen-key-fv :
     3227     define input  parameter p-key-rec    as character no-undo .
     3228     define output parameter p-field-list as character no-undo .
     3229     define output parameter p-value-list as character no-undo.
     3230     do
     3231     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3232     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     3233     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     3234     :
     3235       define variable v-full-tbl-name  as character no-undo .
     3236       define variable bh_tbl-name      as handle    no-undo .
     3237       define variable v-tbl-name       as character no-undo .
     3238       define variable v-field-num      as integer   no-undo .
     3239       define variable v-count-fld      as integer   no-undo .
     3240       define variable v-inform         as character no-undo .
     3241       define variable v-ind            as integer   no-undo .
     3242       define variable v-idx-field-qnty as integer   no-undo .
     3243       define variable v-delim-key      as character no-undo .
     3244       if p-key-rec = ?
     3245         or p-key-rec = "":U
     3246       then do:
     3247         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info20 ).
     3248       end.
     3249       assign
     3250         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     3251         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     3252       .
     3253       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     3254       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info20 ).
     3255       assign
     3256         v-inform = bh_tbl-name:index-information(1)
     3257         v-ind    = 2
     3258       .
     3259       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3260       on error undo, return error
     3261       :
     3262         assign
     3263           v-inform = bh_tbl-name:index-information( v-ind )
     3264           v-ind    = v-ind + 1
     3265         .
     3266       end.
     3267       if v-inform = ?
     3268         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3269         or entry( 3, v-inform, ",":U ) <> "1":U
     3270       then do:
     3271         delete object bh_tbl-name no-error.
     3272         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info20, v-tbl-name ).
     3273       end.
     3274       assign
     3275         v-idx-field-qnty = num-entries( v-inform ) - 4
     3276       .
     3277       if v-idx-field-qnty < 2 then do:
     3278         delete object bh_tbl-name no-error.
     3279         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info20, v-inform, v-tbl-name ).
     3280       end.
     3281       assign
     3282         p-field-list = "":U
     3283         p-value-list = "":U
     3284         v-delim-key  = "":U
     3285         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     3286         v-count-fld  = 0
     3287       .
     3288       block_where:
     3289       do v-ind = 1 to v-idx-field-qnty by 2
     3290       on error undo, return error
     3291       :
     3292         assign
     3293           v-count-fld = v-count-fld + 1
     3294         .
     3295         if v-count-fld > v-field-num then do:
     3296           leave block_where.
     3297         end.
     3298         assign
     3299           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     3300           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     3301         .
     3302         if v-ind = 1 then do:
     3303           assign
     3304             v-delim-key = chr(3)
     3305           .
     3306         end.
     3307       end.
     3308       delete object bh_tbl-name.
     3309       if v-count-fld <> v-field-num then do:
     3310         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info20, v-tbl-name ).
     3311       end.
     3312     end.
     3313   end procedure.
     3314   procedure gen-key-field :
     3315     define input  parameter p-table      as character no-undo .
     3316     define output parameter p-field-list as character no-undo .
     3317     do
     3318     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3319     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     3320     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     3321     :
     3322       define variable v-full-tbl-name  as character no-undo .
     3323       define variable bh_tbl-name      as handle    no-undo .
     3324       define variable v-tbl-name       as character no-undo .
     3325       define variable v-field-num      as integer   no-undo .
     3326       define variable v-count-fld      as integer   no-undo .
     3327       define variable v-inform         as character no-undo .
     3328       define variable v-ind            as integer   no-undo .
     3329       define variable v-idx-field-qnty as integer   no-undo .
     3330       define variable v-delim-key      as character no-undo .
     3331       if p-table = ?
     3332         or p-table = "":U
     3333       then do:
     3334         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info20 ).
     3335       end.
     3336       assign
     3337         v-tbl-name      = p-table
     3338         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     3339       .
     3340       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     3341       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info20 ).
     3342       assign
     3343         v-inform = bh_tbl-name:index-information(1)
     3344         v-ind    = 2
     3345       .
     3346       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3347       on error undo, return error
     3348       :
     3349         assign
     3350           v-inform = bh_tbl-name:index-information( v-ind )
     3351           v-ind    = v-ind + 1
     3352         .
     3353       end.
     3354       if v-inform = ?
     3355         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3356         or entry( 3, v-inform, ",":U ) <> "1":U
     3357       then do:
     3358         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info20, v-tbl-name ).
     3359       end.
     3360       assign
     3361         v-idx-field-qnty = num-entries( v-inform ) - 4
     3362       .
     3363       if v-idx-field-qnty < 2 then do:
     3364         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info20, v-inform, v-tbl-name ).
     3365       end.
     3366       assign
     3367         p-field-list = "":U
     3368         v-delim-key  = "":U
     3369         v-count-fld  = 0
     3370       .
     3371       block_where:
     3372       do v-ind = 1 to v-idx-field-qnty by 2
     3373       on error undo, return error
     3374       :
     3375         assign
     3376           v-count-fld = v-count-fld + 1
     3377         .
     3378         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     3379         if v-ind = 1 then do:
     3380           assign
     3381             v-delim-key = chr(3)
     3382           .
     3383         end.
     3384       end.
     3385       delete object bh_tbl-name.
     3386     end.
     3387   end procedure.
     3388   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3389   PROCEDURE verify-ini-entry:
     3390   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
     3391   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
     3392   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
     3393   DEFINE INPUT  PARAMETER silence          as logical no-undo.
     3394   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
     3395   define variable v-mess as character no-undo .
     3396   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
     3397   if ini-entry-value = ? and ini-key-name begins "spl"
     3398   then
     3399   get-key-value section ini-section-name key "splall" value ini-entry-value.
     3400   if ini-entry-value = ? and ini-key-name begins "sav"
     3401   then
     3402   get-key-value section ini-section-name key "savall" value ini-entry-value.
     3403   if ini-entry-value = ? then do:
     3404     assign
     3405     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
     3406                       , chr(10)
     3407                       , ini-section-name
     3408                       , ini-key-name
     3409                       , error-msg-text).
     3410       if not silence then do:
     3411         message
     3412         v-mess
     3413         view-as alert-box ERROR  .
     3414         return error.
     3415       end.
     3416       else do:
     3417         return error v-mess.
     3418       end.
     3419   end.
     3420   END PROCEDURE.
     3421   PROCEDURE verify-file:
     3422   DEFINE INPUT  PARAMETER filename       as character no-undo.
     3423   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
     3424   DEFINE INPUT  PARAMETER silence        as logical no-undo.
     3425   DEFINE OUTPUT PARAMETER found          as logical no-undo.
     3426   file-info:file-name = filename.
     3427   found = NOT (file-info:full-pathname = ?).
     3428   if NOT found  then do:
     3429     if not silence then do:
     3430       message error-msg-text
     3431       view-as alert-box ERROR.
     3432       return error.
     3433     end.
     3434     else return error error-msg-text.
     3435   end.
     3436   END PROCEDURE.
