     1400   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1401   procedure clntattr-code :
     1402     define input  parameter p-code           as character no-undo .
     1403     define output parameter p-type           as character no-undo .
     1404     define output parameter p-format         as character no-undo .
     1405     define output parameter p-label          as character no-undo .
     1406     define output parameter p-user-can-edit  as logical   no-undo .
     1407     define output parameter p-output-display as logical   no-undo .
     1408     define output parameter p-other          as character no-undo .
     1409     do
     1410     on error undo, return error return-value
     1411     :
     1412           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-code in g#attr-lib
     1413         (input  p-code
     1414         ,output p-type
     1415         ,output p-format
     1416         ,output p-label
     1417         ,output p-user-can-edit
     1418         ,output p-output-display
     1419         ,output p-other
     1420         ) no-error .
     1421       if error-status :error
     1422       then do:
     1423         undo, return error return-value .
     1424       end.
     1425     end.
     1426   end procedure.
     1427   procedure clntattr-tooltip :
     1428     define input  parameter p-code    as character no-undo .
     1429     define output parameter p-tooltip as character no-undo .
     1430     define output parameter p-label   as character no-undo .
     1431     do
