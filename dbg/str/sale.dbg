     5954     (input 'prev':U
     5955     ).
     5956   END.
     5957   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-sale:PARENT eq ? THEN
     5958   FRAME d-sale:PARENT = ACTIVE-WINDOW.
     5959   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5960   on help of frame d-sale
     5961   do:
     5962     run gbl/app_help.p
     5963       (input this-procedure :file-name
     5964       ,input ''
     5965       ,input ?
     5966       ) no-error.
     5967     if error-status :error then do:
     5968       message
     5969         "Ошибка при вызове помощи"
     5970         error-status :get-message(1)
     5971         view-as alert-box .
     5972     end.
     5973   end.
     5974   run minbtn-set in this-procedure .
     5975   on choose of b-help in frame d-sale
     5976   do:
     5977     apply "help":u to frame d-sale .
     5978   end.
     5979   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5980   procedure minbtn-set :
     5981       do
     5982           on error undo, return error return-value
     5983           :
     5984           define variable ii              as integer       no-undo .
     5985           define variable fh              as widget-handle no-undo .
     5986           define variable hh              as widget-handle no-undo .
     5987           define variable v-h             as handle        extent 4 no-undo .
     5988           define variable v-name-button   as character     no-undo .
     5989           define variable v-help-old-x    as decimal       no-undo .
     5990           define variable v-help-old-y    as decimal       no-undo .
     5991           define variable v-help-old-size as decimal       no-undo .
     5992           define variable v-frame-width   as decimal       no-undo .
     5993           define variable jj              as integer       no-undo .
     5994           do
     5995               on error undo, return error
     5996               :
     5997               assign
     5998                   v-frame-width = frame d-sale:width - 0.3
     5999                   fh            = frame d-sale:first-child
     6000                   hh            = fh:first-child
     6001                   ii            = 1
     6002                   .
     6003               do while valid-handle(hh):
     6004                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     6005                   do:
     6006                       case lc(hh:name) :
     6007                           when "b-help" then
     6008                               do:
     6009                                   hh:load-image-up("cmp/b-help.bmp":u) .
     6010                                   hh:load-image-down("cmp/b-help.bmp":u) .
     6011                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     6012                                   hh:TOOLTIP = "Помощь" .
     6013                                   v-help-old-x = hh:column .
     6014                                   v-help-old-y = hh:row    .
     6015                                   v-help-old-size = hh:width .
     6016                                   hh:width-chars = 2.5 .
     6017                               end.
     6018                           when "b-print" then
     6019                               do:
     6020                                   hh:load-image("cmp/b-print.bmp":u) .
     6021                                   hh:TOOLTIP = "Печать" .
     6022                                   v-h[ii] = hh:handle .
     6023                                   ii = ii + 1 .
     6024                                   hh:width-chars = 3 .
     6025                               end.
     6026                           when "b-history" or
     6027                           when "b-hist" then
     6028                               do:
     6029                                   hh:load-image("cmp/b-hist.bmp":u) .
     6030                                   hh:TOOLTIP = "История" .
     6031                                   v-h[ii] = hh:handle .
     6032                                   ii = ii + 1 .
     6033                                   hh:width-chars = 3 .
     6034                               end.
     6035                           when "b-sch" then
     6036                               do:
     6037                                   hh:load-image("cmp/b-sch.bmp":u) .
     6038                                   hh:TOOLTIP = "Установка Фильтра" .
     6039                                   v-h[ii] = hh:handle .
     6040                                   ii = ii + 1 .
     6041                                   hh:width-chars = 3 .
     6042                               end.
     6043                           when "b-hist-user" then
     6044                               do:
     6045                                   hh:load-image("cmp/b-hist.bmp":u) .
     6046                                   hh:TOOLTIP = "История пользователя" .
     6047                                   ii = ii + 1 .
     6048                               end.
     6049                       end case.
     6050                   end.
     6051                   hh = hh:next-sibling.
     6052               end.
     6053               b-help:column = v-frame-width - b-help:width-chars.
     6054               jj = 0.
     6055               repeat ii = 4 to 1 by -1 :
     6056                   if valid-handle (v-h[ii] ) then
     6057                   do:
     6058                       jj  = jj + 1 .
     6059                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     6060                       v-h[ii]:row    = v-help-old-y .
     6061                   end.
     6062               end.
     6063           end.
     6064       end.
     6065   end procedure.
     6066   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     6067   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     6068   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     6069   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     6070   define variable v-diasize-current-frame-width  as decimal   no-undo .
     6071   define variable v-diasize-current-frame-height as decimal   no-undo .
     6072   define variable v-diasize-change-size          as logical   no-undo .
     6073   define variable v-diasize-resize-button        as handle    no-undo .
     6074   define variable v-diasize-wndmax               as logical   no-undo .
     6075   define variable v-diasize-wndstore             as logical   no-undo .
     6076   define variable v-diasize-proc-name            as character no-undo .
     6077   define variable v-diasize-browse-handle        as handle    no-undo .
     6078   define variable v-diasize-browse-number        as integer   no-undo .
     6079   define variable v-diasize-need-full-display    as logical   no-undo init false .
     6080   define temp-table temp-diasize-handle no-undo
     6081     field handle-value  as handle
     6082     field save-position as decimal
     6083     index xpk is primary unique handle-value
     6084     .
     6085   define temp-table temp-browse-handle no-undo
     6086     field browse-type   as character
     6087     field browse-number as integer
     6088     field browse-handle as handle
     6089     field original-size as decimal
     6090     index xpk is primary unique browse-type browse-number
     6091     index xie browse-type browse-handle
     6092   .
     6093   procedure diasize_change-height :
     6094     define input  parameter p-change-value  as decimal   no-undo .
     6095     define input  parameter p-move-resize   as logical   no-undo .
     6096     define variable v-field-group-handle    as handle    no-undo .
     6097     define variable v-object-handle         as handle    no-undo .
     6098     define variable v-frame-height          as decimal   no-undo .
     6099     define variable v-frame-virtual-height  as decimal   no-undo .
     6100     define variable v-browse-height         as decimal   no-undo .
     6101     define variable v-window-height         as decimal   no-undo .
     6102     define variable v-window-virtual-height as decimal   no-undo .
     6103     define variable v-change-sign           as integer   no-undo .
     6104     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     6105     define buffer buf_temp-browse-handle  for temp-browse-handle .
     6106     if p-change-value > 0
     6107     then do:
     6108       if frame d-sale :height + p-change-value
     6109           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     6110       then do:
     6111         assign
     6112           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     6113                           - (frame d-sale :height-chars)
     6114         .
     6115         if p-change-value <= 0
     6116         then do:
     6117           run diasize_position-resize-button in this-procedure .
     6118           return .
     6119         end.
     6120       end.
     6121     end.
     6122     if p-change-value < 0
     6123     then do:
     6124       if frame d-sale :height + p-change-value < v-diasize-orig-frame-height
     6125       then do:
     6126         assign
     6127           p-change-value = v-diasize-orig-frame-height
     6128                          - (frame d-sale :height-chars)
     6129         .
     6130         if p-change-value >= 0
     6131         then do:
     6132           run diasize_position-resize-button in this-procedure .
     6133           return .
     6134         end.
     6135       end.
     6136     end.
     6137     if p-change-value >= 0
     6138     then do:
     6139       assign
     6140         v-change-sign = 1
     6141       .
     6142     end.
     6143     else do:
     6144       assign
     6145         v-change-sign = -1
     6146       .
     6147     end.
     6148     assign
     6149       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     6150     .
     6151     if p-change-value = 0
     6152     then do:
     6153       run diasize_position-resize-button in this-procedure .
     6154       return .
     6155     end.
     6156     move_block:
     6157     do
     6158     on error undo move_block, retry move_block
     6159     :
     6160       if retry
     6161       then do:
     6162         do
     6163         on error undo move_block, leave move_block
     6164         :
     6165           if p-change-value > 0
     6166           then do:
     6167             for each buf_temp-diasize-handle
     6168             on error undo, next
     6169             :
     6170               assign
     6171                 v-object-handle = buf_temp-diasize-handle.handle-value
     6172               .
     6173               if v-object-handle <> v-diasize-resize-button
     6174               then do:
     6175                 assign
     6176                   v-object-handle :row = buf_temp-diasize-handle.save-position
     6177                 .
     6178               end.
     6179             end.
     6180             assign
     6181               v-diasize-browse-handle :height = v-browse-height
     6182             .
     6183             for each buf_temp-browse-handle
     6184               where buf_temp-browse-handle.browse-type = 'height':u
     6185             on error undo, next
     6186             :
     6187               assign
     6188                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     6189               .
     6190             end.
     6191             assign
     6192               frame d-sale :height = v-frame-height
     6193             .
     6194             if frame d-sale :scrollable = true
     6195             then do:
     6196               assign
     6197                 frame d-sale :virtual-height = v-frame-virtual-height
     6198               .
     6199             end.
     6200             run diasize_position-resize-button in this-procedure .
     6201           end.
     6202           else do:
     6203             if frame d-sale :scrollable = true
     6204             then do:
     6205               assign
     6206                 frame d-sale :virtual-height = v-frame-virtual-height
     6207               .
     6208             end.
     6209             assign
     6210               frame d-sale :height = v-frame-height
     6211             .
     6212             assign
     6213               v-diasize-browse-handle :height = v-browse-height
     6214             .
     6215             for each buf_temp-browse-handle
     6216               where buf_temp-browse-handle.browse-type = 'height':u
     6217             on error undo, next
     6218             :
     6219               assign
     6220                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     6221               .
     6222             end.
     6223             for each buf_temp-diasize-handle
     6224             on error undo, next
     6225             :
     6226               assign
     6227                 v-object-handle = buf_temp-diasize-handle.handle-value
     6228               .
     6229               if v-object-handle <> v-diasize-resize-button
     6230               then do:
     6231                 assign
     6232                   v-object-handle :row = buf_temp-diasize-handle.save-position
     6233                 .
     6234               end.
     6235             end.
     6236             run diasize_position-resize-button in this-procedure .
     6237           end.
     6238           assign
     6239             v-diasize-change-size = false
     6240           .
     6241           leave move_block .
     6242         end.
     6243       end.
     6244       assign
     6245         v-diasize-need-full-display = true
     6246       .
     6247       if v-diasize-change-size = false
     6248       then do:
     6249         assign
     6250           v-diasize-change-size = true
     6251         .
     6252       end.
     6253       else do:
     6254         return .
     6255       end.
     6256       assign
     6257         v-frame-height = frame d-sale :height
     6258         v-frame-virtual-height = frame d-sale :virtual-height
     6259         v-browse-height = v-diasize-browse-handle :height
     6260       .
     6261       for each buf_temp-browse-handle
     6262         where buf_temp-browse-handle.browse-type = 'height':u
     6263       :
     6264         assign
     6265           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     6266         .
     6267       end.
