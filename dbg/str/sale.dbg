     8866                 loc-gds-dtl.prod-code = b-doc-line.prod-code AND
     8867                 loc-gds-dtl.prt-code = nodecode
     8868                 EXCLUSIVE-LOCK NO-ERROR.
     8869       IF rz  and loc-gds-dtl.fact-qnty <= loc-gds-dtl.doc-qnty then LEAVE.
     8870       IF NOT rz and loc-gds-dtl.doc-qnty = 0 then LEAVE.
     8871       IF NOT (rgds-dtl = ?) AND NOT recid(loc-gds-dtl) = rgds-dtl THEN LEAVE.
     8872     if ( num_rec modulo 10 ) = 0 then
     8873   run waitfram-show in this-procedure (input substitute("&1 - обработано &2, из них успешно - &3"                                                         , rsrv-title                                                                 , num_rec                                                                    , num_rec_res) ).
     8874       assign
     8875       chg-qnty = 0
     8876       res-qnty = 0
     8877       cost-base = 0
     8878       cost-rubl = 0
     8879       gds-dtl-res-qnty = if rz
     8880                           then (loc-gds-dtl.fact-qnty - loc-gds-dtl.doc-qnty)
     8881                           else (if r-qnty = ?
     8882                                 then (- loc-gds-dtl.doc-qnty)
     8883                                 else r-qnty)
     8884       .
     8885       _docprts:
     8886       FOR EACH loc-doc-prts where
     8887               loc-doc-prts.gds-code = gdscode AND
     8888               loc-doc-prts.out-code = b-doc-line.doc-code ON ERROR UNDO, NEXT:
     8889         if rz and loc-doc-prts.fact-qnty <= loc-doc-prts.doc-qnty then NEXT.
     8890         if not rz and loc-doc-prts.doc-qnty = 0 then NEXT.
     8891         if NOT r-b-code = ? AND r-b-code <> loc-doc-prts.b-code then NEXT.
     8892         if NOT r-doc-prts-qnty = ? AND r-doc-prts-qnty <> loc-doc-prts.fact-qnty then NEXT.
     8893         assign
     8894         res-parts = if rz
     8895                     then loc-doc-prts.doc-qnty
     8896                     else (if r-qnty = ?
     8897                           then (- loc-doc-prts.doc-qnty)
     8898                           else r-qnty)
     8899         ser-chg-qnty = if rz
     8900                         then loc-doc-prts.fact-qnty - res-parts
     8901                         else (if r-qnty = ?
     8902                               then (- loc-doc-prts.doc-qnty)
     8903                               else r-qnty)
     8904         res-qnty = res-qnty + ser-chg-qnty
     8905         no-partion-qnty = gds-dtl-res-qnty - res-qnty
     8906         cost-base = 0
     8907         cost-rubl = 0
     8908         .
     8909         if b-trn-doc.status_ = 'нередакт':U
     8910         or b-trn-doc.flag <> no
     8911         then do:
     8912           assign
     8913           v-return-status =  b-trn-doc.status_
     8914           v-return-flag = b-trn-doc.flag
     8915           b-trn-doc.status_ = 'накл':U
     8916           b-trn-doc.flag = no
     8917           v-return-st-fl = yes
     8918           .
     8919         end.
     8920         if not (is-gas(gdscode) and buf_sale-doc.doc-kind <> 'rs':U)
     8921         then do :
     8922           if recid(loc-gds-dtl) <> current-rgds-dtl then assign num_rec = num_rec + 1 current-rgds-dtl = recid(loc-gds-dtl).
     8923         end.
     8924         run trg/rsrv-dtl.p (
     8925                            input parparentproc
     8926                           ,input rsrv-option
     8927                           ,buffer loc-gds-dtl
     8928                           ,input-output ser-chg-qnty
     8929                           ,input-output cost-base
     8930                           ,input-output cost-rubl
     8931                           ,input (if loc-doc-prts.b-code < 0 then ? else loc-doc-prts.b-code)
     8932                           , "" ) no-error.
     8933         if error-status:error then  do:
     8934           v-return-st-fl = no.
     8935           undo _docprts, NEXT.
     8936         end.
     8937         if v-return-st-fl then do:
     8938           assign
     8939           b-trn-doc.status_ = v-return-status
     8940           b-trn-doc.flag = v-return-flag
     8941           v-return-st-fl = no
     8942           .
     8943         end.
     8944         assign
     8945         chg-qnty = chg-qnty + ser-chg-qnty
     8946         loc-doc-prts.doc-qnty = loc-doc-prts.doc-qnty + ser-chg-qnty
     8947         .
     8948         if r-doc-prts-qnty <> ? and r-b-code = ? then LEAVE.
     8949       END.
     8950       if chg-qnty <> 0 then  do:
     8951         assign
     8952         loc-gds-dtl.doc-qnty = loc-gds-dtl.doc-qnty + chg-qnty
     8953         b-doc-line.doc-qnty = b-doc-line.doc-qnty + chg-qnty
