     6283           and can-query(v-object-handle, "row")
     6284           and can-query(v-object-handle, "height")
     6285           and ( v-object-handle :row > v-diasize-browse-handle :row )
     6286           then do:
     6287             find first buf_temp-browse-handle
     6288               where buf_temp-browse-handle.browse-type   = 'height':u
     6289                 and buf_temp-browse-handle.browse-handle = v-object-handle
     6290               no-error .
     6291             if available buf_temp-browse-handle
     6292             then do:
     6293             end.
     6294             else do:
     6295               create buf_temp-diasize-handle .
     6296               assign
     6297                 buf_temp-diasize-handle.handle-value  = v-object-handle
     6298                 buf_temp-diasize-handle.save-position = v-object-handle :row
     6299               .
     6300             end.
     6301           end.
     6302           assign
     6303             v-object-handle = v-object-handle :next-sibling
     6304           .
     6305         end.
     6306         assign
     6307           v-field-group-handle = v-field-group-handle :next-sibling
     6308         .
     6309       end.
     6310       do with frame d-sale
     6311       :
     6312         hide v-diasize-resize-button .
     6313         assign
     6314           v-diasize-resize-button :row    = 1
     6315           v-diasize-resize-button :column = 1
     6316         .
     6317       end.
     6318       if p-change-value > 0
     6319       then do:
     6320         if frame d-sale :scrollable = true
     6321         then do:
     6322           assign
     6323             frame d-sale :virtual-height = frame d-sale :virtual-height + p-change-value
     6324             no-error .
     6325           if error-status :error
     6326           or error-status :get-message(1) <> ""
     6327           then do:
     6328             undo move_block, retry move_block .
     6329           end.
     6330         end.
     6331         assign
     6332           frame d-sale :height = frame d-sale :height + p-change-value
     6333           no-error .
