     6855   procedure diasize_set-width :
     6856     define input  parameter p-new-width  as decimal   no-undo .
     6857     define input  parameter p-move-resize as logical   no-undo .
     6858     do
     6859     on error undo, return error return-value
     6860     :
     6861       run diasize_change-width in this-procedure
     6862         (input  (p-new-width - frame d-sale :width)
     6863         ,input  p-move-resize
     6864         ) .
     6865     end.
     6866   end procedure.
     6867   procedure diasize_position-resize-button :
     6868     do with frame d-sale
     6869     :
     6870       hide v-diasize-resize-button .
     6871       assign
     6872         v-diasize-resize-button :row = frame d-sale :height - v-diasize-resize-button :height
     6873                     - 1
     6874                     - (frame d-sale :border-bottom-pixels / session :pixels-per-row)
     6875         v-diasize-resize-button :col = frame d-sale :width - v-diasize-resize-button :width
     6876                     - 1
     6877                     - (frame d-sale :border-right-pixels / session :pixels-per-column)
     6878       .
     6879       view v-diasize-resize-button .
     6880     end.
     6881   end procedure.
     6882   on alt-right anywhere
     6883   do:
     6884     run diasize_change-width in this-procedure
     6885       (input 1
     6886       ,input true
     6887       ) .
     6888     return no-apply .
     6889   end.
     6890   on alt-left anywhere
     6891   do:
     6892     run diasize_change-width in this-procedure
     6893       (input -1
     6894       ,input true
     6895       ) .
     6896     return no-apply .
     6897   end.
     6898   on alt-down anywhere
     6899   do:
     6900     run diasize_change-height in this-procedure
     6901       (input 1
     6902       ,input true
     6903       ) .
     6904     return no-apply .
     6905   end.
     6906   on alt-up anywhere
     6907   do:
     6908     run diasize_change-height in this-procedure
     6909       (input -1
     6910       ,input true
     6911       ) .
     6912     return no-apply .
     6913   end.
     6914   on alt-enter of frame d-sale
     6915   do:
     6916     run diasize_maximize in this-procedure
     6917       (input  ?
     6918       ).
     6919     return no-apply .
     6920   end.
     6921   procedure diasize_end-move :
     6922     do
     6923     on error undo, return error return-value
     6924     :
     6925       define variable v-row-delta as decimal   no-undo .
     6926       define variable v-col-delta as decimal   no-undo .
     6927       define variable v-new-row as decimal   no-undo .
     6928       define variable v-new-col as decimal   no-undo .
     6929       assign
     6930         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     6931         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     6932       .
     6933       assign
     6934         v-row-delta = v-new-row - frame d-sale :height
     6935         v-col-delta = v-new-col - frame d-sale :width
     6936       .
     6937       run diasize_change-height in this-procedure
     6938         (input v-row-delta
     6939         ,input true
     6940         ) .
     6941       run diasize_change-width in this-procedure
     6942         (input v-col-delta
     6943         ,input true
     6944         ) .
     6945     end.
     6946   end procedure.
     6947   procedure diasize_maximize :
     6948     define input  parameter p-action as logical   no-undo .
     6949     do
     6950     on error undo, return error return-value
     6951     :
     6952       if p-action = ?
     6953       then do:
     6954         if v-diasize-need-maximize = true
     6955         then do:
     6956           assign
     6957             p-action = true
     6958           .
     6959         end.
     6960         else do:
     6961           assign
     6962             p-action = false
     6963           .
     6964         end.
     6965       end.
     6966       if p-action = true
     6967       then do:
     6968         run diasize_change-height in this-procedure
     6969           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     6970               - frame d-sale :height-chars
     6971           ,input true
     6972           ) .
     6973         run diasize_change-width in this-procedure
     6974           (input session :width-chars
     6975               - frame d-sale :width-chars
     6976           ,input true
     6977           ) .
     6978         assign
     6979           v-diasize-need-maximize = false
     6980         .
     6981       end.
     6982       else do:
     6983         run diasize_change-width in this-procedure
     6984           (input v-diasize-orig-frame-width
     6985               - frame d-sale :width-chars
     6986           ,input true
     6987           ) .
     6988         run diasize_change-height in this-procedure
     6989           (input v-diasize-orig-frame-height
     6990               - frame d-sale :height-chars
     6991           ,input true
     6992           ) .
     6993         assign
     6994           v-diasize-need-maximize = true
     6995         .
     6996       end.
     6997     end.
     6998   end procedure.
     6999   procedure diasize_restore-orig-size :
     7000     do
     7001     on error undo, return error return-value
     7002     :
     7003       assign
     7004         v-diasize-current-frame-width  = frame d-sale :width
     7005         v-diasize-current-frame-height = frame d-sale :height
     7006       .
     7007       run diasize_set-height in this-procedure
     7008         (input  v-diasize-orig-frame-height
     7009         ,input  true
     7010         ) .
     7011       run diasize_set-width in this-procedure
     7012         (input  v-diasize-orig-frame-width
     7013         ,input  true
     7014         ) .
     7015     end.
     7016   end procedure.
     7017   procedure diasize_restore-current-size :
     7018     do
     7019     on error undo, return error return-value
     7020     :
     7021       run diasize_set-height in this-procedure
     7022         (input  v-diasize-current-frame-height
     7023         ,input  true
     7024         ) .
     7025       run diasize_set-width in this-procedure
     7026         (input  v-diasize-current-frame-width
     7027         ,input  true
     7028         ) .
     7029     end.
     7030   end procedure.
     7031   procedure diasize_set-browse-handle :
     7032     define input  parameter p-browse-handle as handle   no-undo .
     7033     define buffer buf_temp-browse-handle for temp-browse-handle .
     7034     do
     7035     on error undo, return error return-value
     7036     :
     7037       assign
     7038         v-diasize-browse-handle = p-browse-handle
     7039       .
     7040       for each buf_temp-browse-handle
     7041       on error undo, return error return-value
     7042       :
     7043         delete buf_temp-browse-handle .
     7044       end.
     7045     end.
     7046   end procedure.
     7047   procedure diasize_add_browse :
     7048     define input  parameter p-browse-type   as character no-undo .
     7049     define input  parameter p-browse-handle as handle    no-undo .
     7050     define buffer buf_temp-browse-handle for temp-browse-handle .
     7051     do
     7052     on error undo, return error return-value
     7053     :
     7054       assign
     7055         v-diasize-browse-number = v-diasize-browse-number + 1
     7056       .
     7057       create buf_temp-browse-handle .
     7058       assign
     7059         buf_temp-browse-handle.browse-type   = p-browse-type
     7060         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     7061         buf_temp-browse-handle.browse-handle = p-browse-handle
     7062       .
     7063     end.
     7064   end procedure.
     7065   procedure diasize_init :
     7066     define variable v-default-value    as logical   no-undo .
     7067     define variable v-restore-saved    as logical   no-undo .
     7068     define variable v-resize-value-str as character no-undo .
     7069     do
     7070     on error undo, return error return-value
     7071     :
     7072       do with frame d-sale
     7073       :
     7074         assign
     7075           v-diasize-orig-frame-height = frame d-sale :height
     7076           v-diasize-orig-frame-width  = frame d-sale :width
     7077           v-diasize-browse-handle     = browse br-out :handle
     7078         .
     7079         create button v-diasize-resize-button
     7080         assign
     7081           parent        = frame d-sale :first-child
     7082           label         = "s"
     7083           height-pixels = 16
     7084           width-pixels  = 16
     7085           visible       = true
     7086           sensitive     = true
     7087           movable       = true
     7088           triggers:
     7089             on end-move persistent run diasize_end-move in this-procedure .
     7090           end triggers.
     7091         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     7092         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     7093         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     7094         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     7095         assign
     7096           v-diasize-wndmax = false
     7097         .
     7098         if connected("ub") = true
     7099         then do:
     7100           define variable v-cntxt-db-num        as integer   no-undo .
     7101           define variable v-cntxt-userid        as character no-undo .
     7102           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     7103                                             , OUTPUT v-cntxt-userid
     7104                                             ) .
     7105           run gbl/wndpar_r.p
     7106             (input  v-cntxt-db-num
     7107             ,input  v-cntxt-userid
     7108             ,input  'wndmax':U
     7109             ,output v-diasize-wndmax
     7110             ,output v-default-value
     7111             ) .
     7112         end.
     7113         assign
     7114           v-diasize-wndstore = false
     7115         .
     7116         if connected("ub") = true
     7117         then do:
     7118           run gbl/wndpar_r.p
     7119             (input  v-cntxt-db-num
     7120             ,input  v-cntxt-userid
     7121             ,input  'wndstore':U
     7122             ,output v-diasize-wndstore
     7123             ,output v-default-value
     7124             ) .
     7125         end.
     7126         assign
     7127           v-diasize-proc-name = entry(1, program-name(2), '.')
     7128         .
     7129         if v-diasize-wndstore = true
     7130         then do:
     7131           assign
     7132             v-restore-saved = false
     7133           .
     7134           if connected("ub") = true
     7135           then do:
     7136             run gbl/wndsizer.p
     7137               (input  v-cntxt-db-num
     7138               ,input  v-cntxt-userid
     7139               ,input  v-diasize-proc-name
     7140               ,input  'height':u
     7141               ,output v-resize-value-str
     7142               ) .
     7143             if v-resize-value-str <> '':U
     7144             then do:
     7145               run diasize_change-height in this-procedure
     7146                 (input  integer(v-resize-value-str)
     7147                 ,input  true
     7148                 ) .
     7149               assign
     7150                 v-restore-saved = true
     7151               .
     7152             end.
     7153           end.
     7154           if connected("ub") = true
     7155           then do:
     7156             run gbl/wndsizer.p
     7157               (input  v-cntxt-db-num
     7158               ,input  v-cntxt-userid
     7159               ,input  v-diasize-proc-name
     7160               ,input  'width':u
     7161               ,output v-resize-value-str
     7162               ) .
     7163             if v-resize-value-str <> '':U
     7164             then do:
     7165               run diasize_change-width in this-procedure
     7166                 (input  integer(v-resize-value-str)
     7167                 ,input  true
     7168                 ) .
     7169               assign
     7170                 v-restore-saved = true
     7171               .
     7172             end.
     7173           end.
     7174           if v-restore-saved <> true
     7175           then do:
     7176             if v-diasize-wndmax = true
     7177             then do:
     7178               run diasize_maximize in this-procedure
     7179                 (input  true
     7180                 ) .
     7181             end.
     7182           end.
     7183         end.
     7184         else do:
     7185           if v-diasize-wndmax = true
     7186           then do:
     7187             run diasize_maximize in this-procedure
     7188               (input  true
     7189               ) .
     7190           end.
     7191         end.
     7192       end.
     7193     end.
     7194   end procedure.
     7195   procedure diasize_need-full-display :
     7196     define output parameter p-need-full-display as logical   no-undo .
     7197     do
     7198     on error undo, return error return-value
     7199     :
     7200       assign
     7201         p-need-full-display = v-diasize-need-full-display
     7202       .
     7203       assign
     7204         v-diasize-need-full-display = false
     7205       .
     7206     end.
     7207   end procedure.
     7208   procedure get-context :
     7209      define output parameter p-db-num as integer          no-undo.
     7210      define output parameter p-user-id as character        no-undo.
     7211      define variable v-login               as character    no-undo.
     7212      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     7213      define buffer buf_user-login  for ub.user-login .
     7214      do
     7215      on error undo, return error
     7216      :
     7217            FIND FIRST buf_sys-ctrl no-lock.
     7218            ASSIGN
     7219               v-login = USERID("ub")
     7220               p-db-num = buf_sys-ctrl.db-num
     7221            .
     7222            FIND FIRST buf_user-login
     7223                 WHERE buf_user-login.db-num = p-db-num
     7224                   AND buf_user-login.user-login = v-login
     7225                 no-lock
     7226                 no-error
     7227                 .
     7228            IF AVAILABLE buf_user-login
     7229            THEN DO:
     7230               assign
     7231                  p-user-id = buf_user-login.user-id
     7232               .
     7233            END.
     7234      end.
     7235   end procedure.
