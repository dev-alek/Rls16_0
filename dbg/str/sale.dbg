     5721                         string(rest-ingr)                + chr(4) +
     5722                         string(rest-tpsi)                + chr(4) +
     5723                         string(neg-tpsi-weight)          + chr(4) +
     5724                         string(neg-tpsi-qnty)            + chr(4) +
     5725                         string(neg-tpsi-oper)            + chr(4) +
     5726                         string(close-in-rfsl)            + chr(4) +
     5727                         pay-gds-algo
     5728         .
     5729         run str/diallog.w (
     5730               input parParentProc
     5731             , input this-procedure
     5732             , input ("str/saleclos.p":U + chr(4) + "1":U +
     5733                     "1":U  + chr(4) +
     5734                     "1":U + chr(4) +
     5735                     "1":U)
     5736             , input v-parameter
     5737             , input no
     5738             , input "":U
     5739             , input substitute("Закрытие продажи &1", Ink-doc.inkas-code)
     5740         ) no-error.
     5741         if error-status:error
     5742         or return-value = "error":U
     5743           then do:
     5744             run close-error-processing in this-procedure.
     5745             return no-apply.
     5746         end.
     5747         else do:
     5748           assign
     5749           p-next-prev = ?.
     5750           APPLY "CHOOSE" to b-exit.
     5751         end.
     5752       end.
     5753     end.
     5754   END.
     5755   ON VALUE-CHANGED OF Cb-doc-kind IN FRAME d-sale
     5756   DO:
     5757   define buffer buf_sale-doc for ub.sale-doc.
     5758   ASSIGN
     5759   CB-doc-kind
     5760   br-2-mode = CB-doc-kind
     5761   .
     5762   find first buf_sale-doc where
     5763             buf_sale-doc.inkas-code = ink-doc.inkas-code
     5764         and buf_sale-doc.doc-kind = entry(1, br-2-mode, chr(4))
     5765         and buf_sale-doc.chr-office = entry(2, br-2-mode, chr(4)).
     5766   br-2-doc-code = buf_sale-doc.doc-code.
     5767   run openbr in this-procedure ( input ink-doc.inkas-code,  input br-2-doc-code, input yes, input no, input '':U, input '':U).
     5768   APPLY "value-changed" to br-out.
     5769   APPLY "value-changed" to br-ret.
     5770   run enable-menu-items in this-procedure .
     5771   END.
     5772   ON value-changed OF rs-sort IN FRAME d-sale
     5773   DO:
     5774     rs-sort = input frame d-sale rs-sort.
     5775     assign
     5776     sort-column-name-out = '':U
     5777     sort-column-name-ret = '':U
     5778     .
     5779     RUN UI-on in this-procedure .
     5780   END.
     5781   ON value-changed OF auto-fbr IN FRAME d-sale
     5782   DO:
     5783     assign
     5784     auto-fbr.
     5785     case auto-fbr:
     5786       when yes then do:
     5787         display
     5788         rest-dish
     5789         rest-ingr
     5790         with frame d-sale .
     5791         enable
     5792         rest-dish
     5793         rest-ingr
     5794         with frame d-sale .
     5795       end.
     5796       when no then do:
     5797         disable
     5798         rest-dish
     5799         rest-ingr
     5800         with frame d-sale .
     5801         hide
     5802         rest-dish
     5803         rest-ingr
     5804         in frame d-sale .
     5805       end.
     5806     END.
     5807   END.
     5808   ON value-changed OF rest-tpsi IN FRAME d-sale
     5809   DO:
     5810       assign rest-tpsi.
     5811   END.
     5812   ON value-changed OF
     5813   br-out,
     5814   br-ret IN FRAME d-sale DO:
     5815   qh = self:query.
     5816   bhg = qh:get-buffer-handle(3).
     5817   gds-rec = bhg:recid.
     5818   if not bhg:available then return no-apply.
     5819   assign
     5820   v-prod-type = bhg:buffer-field('prod-type':U):buffer-value
     5821   v-prod-code = bhg:buffer-field('prod-code':U):buffer-value
     5822   v-gds-code = bhg:buffer-field('gds-code':U):buffer-value
     5823   .
     5824    FIND FIRST ub.clients where
     5825             ub.clients.obj-type = v-prod-type
     5826         AND ub.clients.obj-code = v-prod-code NO-LOCK NO-ERROR.
     5827   if self = brwh-out-dtl then do:
     5828       assign
     5829       prod-name-r = (if available ub.clients
     5830                      then substitute("Пр-ль: &1", ub.clients.obj-name)
     5831                      else '':U).
     5832   end.
     5833   if self = brwh-ret-dtl then do:
     5834       assign
     5835       prod-name-v = (if available ub.clients
     5836                      then substitute("Пр-ль: &1", ub.clients.obj-name)
     5837                      else '':U).
     5838   end.
     5839   display
     5840   prod-name-r
     5841   prod-name-v
     5842   with frame d-sale.
     5843   IF mImagePh THEN
     5844   DO:
     5845       DEFINE VARIABLE vImageList AS LONGCHAR    NO-UNDO.
     5846       DEFINE VARIABLE vCh        AS CHARACTER   NO-UNDO.
     5847       RUN gds-attr-value ( v-gds-code, "image-list":U, OUTPUT vImageList, OUTPUT vCh).
     5848       RUN imagelist_decode IN THIS-PROCEDURE (INPUT vImageList, v-gds-code, OUTPUT vImageList).
     5849       vCh = ENTRY (1, vImageList, ",":U).
     5850       g-image:LOAD-IMAGE (ENTRY (1, vCh)) NO-ERROR.
     5851       ASSIGN
     5852           g-image:HIDDEN     = NO
     5853           g-image:VISIBLE    = YES
     5854           g-image:SENSITIVE  = YES
     5855           .
     5856   END.
     5857   ELSE
     5858       ASSIGN
     5859           g-image:HIDDEN     = YES
     5860           g-image:VISIBLE    = NO
     5861           g-image:SENSITIVE  = NO
     5862           .
     5863   END.
     5864   ON CHOOSE OF b-arch IN FRAME d-sale
     5865   DO:
     5866   define variable v-notes as character no-undo .
     5867   define variable v-inkas-base as decimal no-undo .
     5868   define variable v-cost-sum as decimal no-undo .
     5869   define buffer buf_inkas-pay for ub.inkas-pay.
     5870   define buffer buf_sale-doc for ub.sale-doc.
     5871   define buffer buf_trn-doc for ub.trn-doc.
     5872   if t-doc.status_ = 'факт':U
     5873   or ink-doc.status_ = 'запрос':U
     5874   then do:
     5875   define variable vss-include-info38 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5876   do:
     5877     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5878       (input  v-cntxt-db-num
     5879       ,input  v-cntxt-userid
     5880       ,input  0
     5881       ,input  'actn_archive_cost':U
     5882       ,input  'object':U
     5883       ,input  ink-doc.host-code
     5884       ,input  ink-doc.obj-type
     5885       ,input  ink-doc.obj-code
     5886       ,input  0
     5887       ,input  0
     5888       ,input  0
     5889       ,input  true
     5890       ,output glog
     5891       )  .
     5892   end.
     5893   if NOT glog then return no-apply.
     5894   if v-curr-r-b = 'base':U then do:
     5895     assign
     5896     v-inkas-base = ink-doc.netto
     5897     .
     5898   end.
     5899   else do:
     5900     for each buf_inkas-pay no-lock where
     5901             buf_inkas-pay.inkas-code = ink-doc.inkas-code:
     5902       assign
     5903       v-inkas-base = v-inkas-base + buf_inkas-pay.tot-base
     5904       .
     5905     end.
     5906   end.
     5907    for each buf_sale-doc no-lock where
     5908             buf_sale-doc.inkas-code = ink-doc.inkas-code
     5909         and buf_sale-doc.in-inkas = yes,
     5910            first buf_trn-doc no-lock where
     5911                 buf_trn-doc.doc-code = buf_sale-doc.doc-code:
     5912       assign
     5913       v-cost-sum = v-cost-sum + buf_trn-doc.fact-base  * buf_sale-doc.dir
     5914       .
     5915     end.
     5916     message
     5917     "Оборот товара в учетных ценах:" skip
     5918     string(v-cost-sum , "->>,>>>,>>9.99") v-base-type skip (2)
     5919     "Оборот товара в продажных ценах с учетом скидки:" skip
     5920     string (v-inkas-base, "->>,>>>,>>9.99") v-base-type skip (2)
     5921     "Разница:" skip
     5922     string (v-inkas-base - v-cost-sum, "->>,>>>,>>9.99") v-base-type skip (2)
     5923     "Наценка:"
     5924     string ((v-inkas-base - v-cost-sum) / v-cost-sum * 100, "->>9.9<%")
     5925     view-as alert-box title "Док-т №: " + string (t-doc.doc-code) + "  от: " + string (t-doc.doc-date)
     5926       + (IF cas-shft then (" смена N " + shift-name-no-err(buffer ink-doc)) else "")
     5927       + (IF one-curs then (" чеки по курсу " + string(t-doc.base-rate / t-doc.base-scale)) else "") .
     5928   end.
     5929   else do:
     5930       run str/chk-inf.p (
     5931                         input parparentproc
     5932                       ,input v-host-code
     5933                       ,input ink-doc.obj-type
     5934                       ,input ink-doc.obj-code
     5935                       ,input yes
     5936                       ,input yes
     5937                       ,recid (ink-doc)
     5938                       ,output v-notes
     5939                       ,output not-all-saled-chk
     5940                       ,output not-all-normal-chk
     5941                       ,output not-all-inkas-closed
     5942                       ).
     5943     end.
     5944   END.
     5945   ON CHOOSE OF b-next IN FRAME d-sale
     5946   DO:
     5947   run reposition-inkas in this-procedure
     5948     (input 'next':U
     5949     ).
     5950   END.
     5951   ON CHOOSE OF b-prev IN FRAME d-sale
