     8835   .
     8836           assign
     8837           b-doc-line.road-tax = (if v-curr-r-b = 'rubl':U then road-tax-rubl-loc else road-tax-base-loc).
     8838         end.
     8839         if rz then do:
     8840           if b-trn-doc.print-rubl then
     8841           assign
     8842           loc-gds-dtl.price-base = loc-gds-dtl.price-rubl / b-trn-doc.base-rate * b-trn-doc.base-scale
     8843           loc-gds-dtl.discnt-base = loc-gds-dtl.discnt-rubl / b-trn-doc.base-rate * b-trn-doc.base-scale
     8844           loc-gds-dtl.discnt-pc = (if loc-gds-dtl.price-rubl = 0
     8845                                    then 0
     8846                                    else loc-gds-dtl.discnt-rubl * 100 / loc-gds-dtl.price-rubl) .
     8847           else
     8848           assign
     8849           loc-gds-dtl.price-rubl = loc-gds-dtl.price-base * b-trn-doc.base-rate / b-trn-doc.base-scale
     8850           loc-gds-dtl.discnt-rubl = loc-gds-dtl.discnt-base * b-trn-doc.base-rate / b-trn-doc.base-scale
     8851           loc-gds-dtl.discnt-pc = (if loc-gds-dtl.price-base = 0
     8852                                    then 0
     8853                                    else loc-gds-dtl.discnt-base * 100 / loc-gds-dtl.price-base) .
     8854         end.
     8855       end.
     8856       if chg-qnty = res-qnty then place-ok = yes.
     8857       else place-ok = no.
     8858       release loc-gds-dtl.
     8859       if no-place-qnty = 0 then return.
     8860     end.
     8861     if NOT cashplace AND cashparts then do:
     8862       FIND FIRST loc-gds-dtl WHERE
     8863                 loc-gds-dtl.doc-code = b-trn-doc.doc-code AND
     8864                 loc-gds-dtl.artic = b-doc-line.artic AND
