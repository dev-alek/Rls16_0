     8317   PROCEDURE RSRv-line:
     8318   define input parameter p-r-v                as integer no-undo .
     8319   define input parameter p-auto-fbr           as logical no-undo .
     8320   define input parameter p-rsrv-prop-goods    as logical no-undo .
     8321   define input parameter p-auto-fbr-on        as logical no-undo .
     8322   define input parameter p-rest-dish          as logical no-undo .
     8323   define input parameter p-fbr-income-doc-code like ub.trn-doc.doc-code no-undo .
     8324   define input parameter p-tpsi-obj           as logical no-undo .
     8325   define input parameter p-rest-tpsi          as logical no-undo .
     8326   DEFINE INPUT PARAMETER rz                   as logical no-undo.
     8327   DEFINE INPUT PARAMETER gdscode              like ub.goods.gds-code.
     8328   DEFINE INPUT PARAMETER nodecode             like ub.gds-prt.node-code.
     8329   define output parameter p-run-tpsi          as logical no-undo .
     8330   DEFINE parameter buffer b-doc-line for ub.doc-line.
     8331   DEFINE parameter buffer b-trn-doc for ub.trn-doc.
     8332   define parameter buffer buf_sale-doc for ub.sale-doc.
     8333   define buffer loc-doc-prts for ub.doc-prts.
     8334   define buffer loc-doc-pl for ub.doc-pl.
     8335   define buffer loc-doc-fbr-gds for ub.doc-fbr-gds.
     8336   DEFINE BUFFER loc-gds-dtl for ub.gds-dtl.
     8337   define buffer buf_parts for ub.parts .
     8338   define buffer other_doc-line for ub.doc-line.
     8339   define buffer other_gds-dtl  for ub.gds-dtl.
     8340   define buffer buf_doc-fbr-gds for ub.doc-fbr-gds .
     8341   define variable res-qnty                    as decimal no-undo.
     8342   define variable gds-dtl-res-qnty            as decimal no-undo.
     8343   define variable no-partion-qnty             as decimal no-undo.
     8344   define variable no-place-qnty               as decimal no-undo.
     8345   define variable res-parts                   as decimal no-undo.
     8346   define variable ser-chg-qnty                as decimal no-undo.
     8347   define variable pl-chg-qnty                 as decimal no-undo.
     8348   define variable pl-chg-cli-qnty             as decimal no-undo.
     8349   define variable old-pl-qnty                 as decimal no-undo.
     8350   define variable new-pl-qnty                 as decimal no-undo.
     8351   define variable chg-qnty                    as decimal no-undo.
     8352   define variable fbr-qnty                    as decimal no-undo .
     8353   define variable fbr-chg-qnty                as decimal no-undo .
     8354   define variable parts-OK                    as logical no-undo init yes.
     8355   define variable place-OK                    as logical no-undo init yes.
     8356   define variable rsrv-option                 as character no-undo.
     8357   define variable rsrv-option-place           as character no-undo.
     8358   define variable v-proprietor-host-code      like ub.clients.host-code no-undo .
     8359   define variable v-proprietor-obj-type       like ub.clients.obj-type no-undo .
     8360   define variable v-proprietor-obj-code       like ub.clients.obj-code no-undo .
     8361   define variable v-is-own                    as logical no-undo .
     8362   define variable v-to-reserv                 as logical no-undo .
     8363   define variable v-ext-doc-type              like ub.trn-doc.ext-doc-type no-undo .
     8364   define variable v-gds-dtl-fact-qnty         like ub.gds-dtl.fact-qnty no-undo .
     8365   define variable v-was-gds-dtl-doc-qnty      like ub.gds-dtl.fact-qnty no-undo .
     8366   define variable v-return-st-fl              as logical no-undo .
     8367   define variable v-return-status             like ub.trn-doc.status_ no-undo .
     8368   define variable v-return-flag               like ub.trn-doc.flag    no-undo .
     8369   define variable v-dop-sale-negative-check   as character no-undo .
     8370   define variable v-nc-option                 as character no-undo .
     8371   define variable current-rgds-dtl            as recid no-undo .
     8372   define variable v-qnty                      as decimal no-undo .
     8373   define variable v-cli-qnty                  as decimal no-undo .
     8374   define variable v-err-msg                   as character no-undo .
     8375   define buffer tpsi_sale-doc for ub.sale-doc.
     8376   define buffer buf_tt0-gds-dtl for tt0-gds-dtl.
     8377       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     8378       define buffer   in-vatp-parts    for ub.parts   .
     8379       define buffer   in-vatp-doc      for ub.trn-doc .
     8380       define buffer   in-vatp-goods    for ub.goods   .
     8381       define buffer   in-vatp-sysconf  for ub.sysconf .
     8382       define buffer   in-vatp_doc-attr for ub.doc-attr.
     8383       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     8384       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     8385       define variable varinvprb                  as   character              no-undo.
     8386       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     8387       define variable cli-base-rate              as   decimal                no-undo.
     8388       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     8389       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     8390       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     8391       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     8392       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     8393       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     8394       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     8395       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     8396       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     8397       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     8398       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     8399       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     8400       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     8401       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     8402       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     8403       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     8404       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     8405       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     8406       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     8407       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     8408       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     8409       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     8410       define variable varinvatp-envd             as   character              no-undo.
     8411       define variable varinvatp-type             as   character              no-undo.
     8412   define buffer buf_dtl-rests for dtl-rests.
     8413   if buf_sale-doc.in-inkas = no
     8414   and not can-find(first dtl-rests no-lock where dtl-rests.gds-code = gdscode) then do:
     8415      v-dop-sale-negative-check = ',' + 'negative-check':U + "=1".
     8416   end.
     8417   if not p-rsrv-prop-goods
     8418   AND (p-tpsi-obj
     8419   and p-r-v = 1
     8420   and not cashplace
     8421   and not cashparts
     8422   and not b-trn-doc.office)
     8423   then do:
     8424     run tpsi-gds-proprietor in this-procedure (
     8425                                                 input gdscode
     8426                                                ,input g#db-num
     8427                                                ,output v-proprietor-host-code
     8428                                                ,output v-proprietor-obj-type
     8429                                                ,output v-proprietor-obj-code ) no-error .
     8430     if error-status:error then do:
     8431       num_rec = num_rec + 1.
     8432       undo, return error substitute("Ошибки при проверке атрибута товара на объекте ПРИНАДЛЕЖНОСТЬ ТОВАРА для товара с кодом &1 на БД &2:&3&4 &5"
     8433                                     ,gdscode
     8434                                     ,g#db-num
     8435                                     , chr(10)
     8436                                     , error-status:get-message(1)
     8437                                     , return-value
     8438                                     ).
     8439     end.
     8440     if (v-proprietor-obj-type = "":U
     8441         and
     8442         v-proprietor-obj-code = 0)
     8443     or v-proprietor-obj-code = ?
     8444         then do:
     8445       num_rec = num_rec + 1.
     8446       undo, return error substitute("Не установлен атрибут товара на объекте ПРИНАДЛЕЖНОСТЬ ТОВАРА для товара с кодом &1 ни для одного объекта БД &2"
     8447                                     ,gdscode
     8448                                     ,g#db-num
     8449                                     ).
     8450     end.
     8451     if (v-proprietor-obj-type = b-trn-doc.obj-type
     8452     and v-proprietor-obj-code = b-trn-doc.obj-code)
     8453     then do:
     8454       assign
     8455       v-is-own = yes
     8456       .
     8457     end.
     8458     else do:
     8459       assign
     8460       p-run-tpsi = yes.
     8461       if v-proprietor-host-code = v-host-code then do:
     8462         assign
     8463         v-ext-doc-type = 'ev':U .
     8464       end.
     8465       else do:
     8466         assign
     8467         v-ext-doc-type =  'ee':U .
     8468       end.
     8469       find first tpsi_sale-doc no-lock where
     8470                 tpsi_sale-doc.inkas-code = buf_sale-doc.inkas-code
     8471             and tpsi_sale-doc.tpsidoc = yes
     8472             and tpsi_sale-doc.obj-type = v-proprietor-obj-type
     8473             AND tpsi_sale-doc.obj-code = v-proprietor-obj-code
     8474             AND tpsi_sale-doc.ext-doc-type = v-ext-doc-type  no-error .
     8475      end.
     8476   end.
     8477   else v-is-own = yes.
     8478   if v-is-own then do:
     8479     assign
     8480     v-to-reserv = yes
     8481     rsrv-option = (if (rgds-dtl = ?) and not p-auto-fbr
     8482                     then 'reserv':U  + ',' + 'no-message':U
     8483                     else 'reserv':U
     8484                     )
     8485     + v-dop-sale-negative-check
     8486     .
     8487     if cashfbr and p-auto-fbr-on and rz and not p-auto-fbr then return.
     8488     if p-tpsi-obj
     8489     and p-rsrv-prop-goods = yes then do:
     8490       find first buf_dtl-rests no-lock where
     8491                 buf_dtl-rests.gds-code = gdscode no-error .
     8492       if available buf_dtl-rests
     8493       and buf_dtl-rests.prop > 0
     8494       and buf_dtl-rests.ok-prop then do:
     8495         assign
     8496         v-nc-option = "=1":U.
     8497         assign
     8498         rsrv-option = rsrv-option + ',' + 'negative-check':U + v-nc-option
     8499         .
     8500       end.
     8501     end.
     8502   end.
     8503   else do:
     8504     assign
     8505     cashfbr = no.
     8506     if p-rest-tpsi or rz = no then do:
     8507       assign
     8508       v-nc-option = "=2":U.
     8509       assign
     8510       v-to-reserv = yes
     8511       rsrv-option = (if (rgds-dtl = ?) and not p-auto-fbr
     8512                       then 'reserv':U  + ',' + 'no-message':U + ',' + 'negative-check':U + v-nc-option
     8513                       else 'reserv':U  + ',' + 'negative-check':U + v-nc-option
     8514                       )
     8515       .
     8516       if p-rest-tpsi then do:
     8517         assign
     8518         rsrv-option = rsrv-option + ',' + 'sale-negative-check-on':u
     8519         .
     8520       end.
     8521     end.
     8522   end.
     8523   if cashfbr
     8524   and (not p-rest-dish)
     8525   and p-auto-fbr-on and rz
     8526   and p-fbr-income-doc-code <> "":U
     8527   then do:
     8528     _parts:
     8529     for each buf_parts no-lock
     8530         where buf_parts.obj-type  = b-trn-doc.obj-type
     8531           and buf_parts.obj-code  = b-trn-doc.obj-code
     8532           and buf_parts.prod-type = b-doc-line.prod-type
     8533           and buf_parts.prod-code = b-doc-line.prod-code
     8534           and buf_parts.artic     = b-doc-line.artic
     8535           and buf_parts.status_   = yes
     8536           and buf_parts.out-code  = p-fbr-income-doc-code
     8537     on error undo, return error return-value
     8538       :
     8539       assign
     8540       rsrv-option = 'reserv':U
     8541                       + "," + 'rsrv-single-part':U
     8542                       + "," + 'rsrv-in-code':U   + "=":u + str-encode ( buf_parts.in-code  ,  "", ",=":u )
     8543                       + "," + 'rsrv-part-code':U + "=":u + str-encode ( buf_parts.part-code,  "", ",=":u )
     8544       .
     8545       leave _parts.
     8546     end.
     8547   end.
     8548   if cashplace then do:
     8549     FIND FIRST loc-gds-dtl WHERE
     8550             loc-gds-dtl.doc-code = b-trn-doc.doc-code AND
     8551             loc-gds-dtl.artic = b-doc-line.artic AND
     8552             loc-gds-dtl.prod-type = b-doc-line.prod-type AND
     8553             loc-gds-dtl.prod-code = b-doc-line.prod-code AND
     8554             loc-gds-dtl.prt-code = nodecode
     8555             EXCLUSIVE-LOCK NO-ERROR.
     8556     IF rz  and loc-gds-dtl.fact-qnty <= loc-gds-dtl.doc-qnty then LEAVE.
     8557     IF NOT rz and loc-gds-dtl.doc-qnty = 0 then LEAVE.
     8558     IF NOT (rgds-dtl = ?) AND NOT recid(loc-gds-dtl) = rgds-dtl THEN LEAVE.
     8559     if ( num_rec modulo 10 ) = 0 then
     8560   run waitfram-show in this-procedure (input substitute("&1 - обработано &2, из них успешно - &3"                                                         , rsrv-title                                                                 , num_rec                                                                    , num_rec_res) ).
     8561     if rz then
     8562     find first buf_tt0-gds-dtl no-lock where
     8563               buf_tt0-gds-dtl.artic = loc-gds-dtl.artic
     8564          AND  buf_tt0-gds-dtl.prod-type = loc-gds-dtl.prod-type
     8565          AND  buf_tt0-gds-dtl.prod-code = loc-gds-dtl.prod-code
     8566          AND  buf_tt0-gds-dtl.prt-code  = loc-gds-dtl.prt-code no-error .
     8567     assign
     8568     chg-qnty   = 0.0
     8569     res-qnty   = 0.0
     8570     cost-base  = 0.0
     8571     cost-rubl  = 0.0
     8572     v-qnty     = 0.0
     8573     v-cli-qnty = 0.0
     8574     gds-dtl-res-qnty = if rz
     8575                       then ((loc-gds-dtl.fact-qnty - loc-gds-dtl.doc-qnty) + (if available buf_tt0-gds-dtl
     8576                                                                               then (buf_tt0-gds-dtl.fact-qnty - buf_tt0-gds-dtl.doc-qnty)
     8577                                                                               else 0))
     8578                       else (if r-qnty = ?
     8579                             then (- loc-gds-dtl.doc-qnty)
     8580                             else r-qnty)
     8581     .
     8582     _docpl:
     8583     FOR EACH loc-doc-pl where
     8584               loc-doc-pl.gds-code = gdscode AND
     8585               loc-doc-pl.out-code = b-doc-line.doc-code ON ERROR UNDO, NEXT:
     8586       assign
     8587       v-qnty                  = v-qnty + loc-doc-pl.doc-qnty
     8588       v-cli-qnty              = v-cli-qnty + loc-doc-pl.cli-doc-qnty
     8589       .
     8590       if rz and loc-doc-pl.fact-qnty <= loc-doc-pl.doc-qnty then NEXT.
     8591       if not rz and loc-doc-pl.doc-qnty = 0 then NEXT.
     8592       if NOT r-pl-code = ? AND r-pl-code <> loc-doc-pl.pl-code then NEXT.
     8593       assign
     8594       v-err-msg       = "":U
     8595       pl-chg-qnty     = (if rz then loc-doc-pl.fact-qnty     else 0.0 ) - loc-doc-pl.doc-qnty
     8596       pl-chg-cli-qnty = (if rz then loc-doc-pl.cli-fact-qnty else 0.0 ) - loc-doc-pl.cli-doc-qnty
     8597       res-qnty = res-qnty + pl-chg-qnty
     8598       no-partion-qnty = gds-dtl-res-qnty - res-qnty
     8599       cost-base = 0
     8600       cost-rubl = 0
     8601       rsrv-option-place = rsrv-option + "," + 'plcode':U + "=" + string(loc-doc-pl.pl-code)
     8602       .
     8603       if b-trn-doc.status_ = 'нередакт':U
     8604       or b-trn-doc.flag <> no
     8605       then do:
     8606         assign
     8607         v-return-status =  b-trn-doc.status_
     8608         v-return-flag = b-trn-doc.flag
     8609         b-trn-doc.status_ = 'накл':U
     8610         b-trn-doc.flag = no
     8611         v-return-st-fl = yes
     8612         .
     8613       end.
     8614       if not (is-gas(gdscode) and buf_sale-doc.doc-kind <> 'rs':U)
     8615       then do :
     8616         if recid(loc-gds-dtl) <> current-rgds-dtl then assign num_rec = num_rec + 1 current-rgds-dtl = recid(loc-gds-dtl).
     8617       end.
     8618       assign
     8619         old-pl-qnty = (- loc-doc-pl.doc-qnty)
     8620       .
     8621       if old-pl-qnty <> 0.0 then do:
     8622         run trg/rsrv-dtl.p (
     8623                         input parparentproc
     8624                         ,input rsrv-option-place
     8625                         ,buffer loc-gds-dtl
     8626                         ,input-output old-pl-qnty
     8627                         ,input-output cost-base
     8628                         ,input-output cost-rubl
     8629                         ,-1, "" ) no-error.
     8630         if error-status :error then do:
     8631           assign
     8632           v-err-msg = substitute( "Ошибка при разрезервировании.&1&2"
     8633                                  , chr(10)
     8634                                  , return-value
     8635                                 )
     8636           .
     8637         end.
     8638         else do:
     8639           if old-pl-qnty <> (- loc-doc-pl.doc-qnty) then do:
     8640             assign
     8641             v-err-msg = substitute( "Не удалось снять резервы по ранее зарезервированному количеству.&1Запрошено: &2&1Удалось разрезервировать: &3&1"
     8642                                   , chr(10)
     8643                                   , (- loc-doc-pl.doc-qnty)
     8644                                   , old-pl-qnty
     8645                                   )
     8646             .
     8647           end.
     8648         end.
     8649         if v-err-msg <> "":U then do:
     8650           v-return-st-fl = no.
     8651           undo _docpl, NEXT.
     8652         end.
     8653       end.
     8654       assign
     8655       loc-doc-pl.doc-qnty     = loc-doc-pl.doc-qnty     + pl-chg-qnty
     8656       loc-doc-pl.cli-doc-qnty = loc-doc-pl.cli-doc-qnty + pl-chg-cli-qnty
     8657       loc-doc-pl.cli-qnty     = loc-doc-pl.cli-doc-qnty
     8658       new-pl-qnty             = loc-doc-pl.doc-qnty
     8659       v-qnty                  = v-qnty + pl-chg-qnty
     8660       v-cli-qnty              = v-cli-qnty + pl-chg-cli-qnty
     8661       .
     8662       if new-pl-qnty <> 0.0 then do:
     8663         run trg/rsrv-dtl.p (
     8664                         input parparentproc
     8665                         ,input rsrv-option-place
     8666                         ,buffer loc-gds-dtl
     8667                         ,input-output new-pl-qnty
     8668                         ,input-output cost-base
     8669                         ,input-output cost-rubl
     8670                         ,-1
     8671                         ,"") no-error.
     8672         if error-status :error then do:
     8673           assign
     8674           v-err-msg = substitute( "Ошибка при резервировании.&1&2"
     8675                                 , chr(10)
     8676                                 , return-value
     8677                                 )
     8678           .
     8679         end.
     8680         else do:
     8681           if new-pl-qnty <> loc-doc-pl.doc-qnty then do:
     8682             assign
     8683             v-err-msg = substitute( "Не удалось зарезервировать все запрошенное количество.&1Запрошено: &2&1Удалось разрезервировать: &3&1"
     8684                                   , chr(10)
     8685                                   , loc-doc-pl.doc-qnty - old-pl-qnty
     8686                                   , new-pl-qnty - old-pl-qnty
     8687                                   )
     8688             .
     8689           end.
     8690         end.
     8691         if v-err-msg <> "":U then do:
     8692           v-return-st-fl = no.
     8693           undo _docpl, NEXT.
     8694         end.
     8695       end.
     8696       if v-return-st-fl then do:
     8697         assign
     8698         b-trn-doc.status_ = v-return-status
     8699         b-trn-doc.flag = v-return-flag
     8700         v-return-st-fl = no
     8701         .
     8702       end.
     8703       assign
     8704       chg-qnty = chg-qnty + pl-chg-qnty
     8705       .
     8706     END.
     8707     if v-qnty <> 0.0
     8708       and v-cli-qnty <> 0.0
     8709     then do:
     8710       assign
     8711       b-doc-line.doc-density = v-cli-qnty / v-qnty
     8712       .
     8713     end.
     8714     if chg-qnty <> 0 then  do:
     8715         assign
     8716         loc-gds-dtl.doc-qnty = loc-gds-dtl.doc-qnty + chg-qnty
     8717         b-doc-line.doc-qnty = b-doc-line.doc-qnty + chg-qnty
     8718         buf_sale-doc.doc-qnty = buf_sale-doc.doc-qnty  + chg-qnty
     8719         b-trn-doc.doc-qnty = b-trn-doc.doc-qnty  + chg-qnty
     8720         b-doc-line.cli-qnty = v-cli-qnty
     8721         .
     8722         if (loc-gds-dtl.doc-qnty = loc-gds-dtl.fact-qnty and rz) or                           (loc-gds-dtl.doc-qnty = 0 and not  rz)  then do: assign num_rec_res = num_rec_res + 1. end.
     8723         if bottle then do:
     8724   assign
     8725     price-rubl-with-tax-loc = b-doc-line.price-rubl
