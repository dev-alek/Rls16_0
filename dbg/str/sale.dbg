     3685   procedure create_obj-list :
     3686      define input parameter p-obj-type like ub.clients.obj-type no-undo .
     3687      define input parameter p-obj-code like ub.clients.obj-code no-undo .
     3688      do
     3689      on error undo, return error return-value
     3690      :
     3691         define buffer cli-obj for ub.clients .
     3692         define variable p-var as integer no-undo .
     3693         define buffer buf_obj-list for obj-list .
     3694         find last buf_obj-list  use-index pi no-error .
     3695         if available buf_obj-list
     3696         then
     3697            p-var = buf_obj-list.obj-id + 1.
     3698         else
     3699            p-var = 1.
     3700         find first cli-obj where
     3701                   cli-obj.obj-type = p-obj-type
     3702               and cli-obj.obj-code = p-obj-code
     3703         no-lock no-error.
     3704         if available cli-obj
     3705         then do:
     3706            create buf_obj-list.
     3707            assign
     3708               buf_obj-list.obj-id   = p-var
     3709               buf_obj-list.obj-code = cli-obj.obj-code
     3710               buf_obj-list.obj-type = cli-obj.obj-type
     3711               buf_obj-list.obj-name = cli-obj.obj-name
     3712               buf_obj-list.db-num   = cli-obj.db-num
     3713            .
     3714         end.
     3715      end.
     3716   end.
