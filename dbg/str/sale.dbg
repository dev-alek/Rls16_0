     6584               .
     6585             end.
     6586             run diasize_position-resize-button in this-procedure .
     6587           end.
     6588           else do:
     6589             if frame d-sale :scrollable = true
     6590             then do:
     6591               assign
     6592                 frame d-sale :virtual-width = v-frame-virtual-width
     6593               .
     6594             end.
     6595             assign
     6596               frame d-sale :width = v-frame-width
     6597             .
     6598             for each buf_temp-browse-handle
     6599               where buf_temp-browse-handle.browse-type = 'width':u
     6600             on error undo, next
     6601             :
     6602               assign
