     7309       end.
     7310       when 'autocomp':U then do:
     7311         auto-comp = thbjattr_thbj-attr.property-value-logical.
     7312       end.
     7313       when 'autofbr':U then do:
     7314         autofbr = thbjattr_thbj-attr.property-value-logical.
     7315       end.
     7316       when 'one-curs':U then do:
