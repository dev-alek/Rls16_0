     6468   procedure diasize_set-height :
     6469     define input  parameter p-new-height  as decimal   no-undo .
     6470     define input  parameter p-move-resize as logical   no-undo .
     6471     do
     6472     on error undo, return error return-value
     6473     :
     6474       run diasize_change-height in this-procedure
     6475         (input  (p-new-height - frame d-sale :height)
     6476         ,input  p-move-resize
     6477         ) .
     6478     end.
     6479   end procedure.
     6480   procedure diasize_change-width :
     6481     define input  parameter p-change-value as decimal   no-undo .
     6482     define input  parameter p-move-resize  as logical   no-undo .
     6483     define variable v-field-group-handle   as handle    no-undo .
     6484     define variable v-object-handle        as handle    no-undo .
