     8264   PROCEDURE shapka:
     8265   define variable for-discnt as  decimal no-undo.
     8266   if NOT (autocalc AND prcl-spl AND can-do( 'ИЗМЕНЕНИЕ':U, p-mode ) ) then return.
     8267   IF NOT (t-doc.status_ = 'факт':U
     8268   and ink-doc.status_ = 'запрос':U)
     8269   then do:
     8270       run waitfram-show in this-procedure ("Ждите...").
     8271       run gbl/calc-trn.p ( input parparentproc, input recid(t-doc)).
     8272       if available ret-doc then
     8273       run gbl/calc-trn.p ( input parparentproc, input recid(ret-doc)).
     8274       run waitfram-hide in this-procedure .
     8275   end.
     8276   for-discnt = (if v-curr-r-b = 'rubl':U
     8277                   then t-doc.discnt-rubl
     8278                   else t-doc.tot-calc
     8279                   - (if available ret-doc
     8280                       then (if v-curr-r-b = 'rubl':U
     8281                             then ret-doc.discnt-rubl
     8282                             else  ret-doc.tot-calc)
     8283                       ELSE 0)
     8284                   )
     8285       .
     8286   if ABS(for-discnt - ink-doc.discnt) > 0.015 then do:
     8287     assign
     8288     for-discnt-chr = "Скидка по док-там: " + string(for-discnt, "->>>,>>9.99")
     8289     for-discnt-chr:BGCOLOR IN FRAME d-sale = 10
     8290     .
     8291     DISPLAY
     8292     for-discnt-chr
     8293     WITH FRAME d-sale.
     8294   end.
     8295   else do:
     8296     assign
     8297     for-discnt-chr = ""
     8298     for-discnt-chr:BGCOLOR IN FRAME d-sale = ?
     8299     .
     8300     HIDE
     8301     for-discnt-chr
     8302     IN FRAME d-sale.
     8303   end.
     8304   END PROCEDURE.
     8305   PROCEDURE close-error-processing.
     8306   if NOT return-value = ""
     8307   and NOT return-value = "error"
     8308   then
     8309   message
     8310   return-value
     8311   view-as alert-box ERROR.
     8312   if compensed then  run UI-on in this-procedure .
     8313   run frame-title in this-procedure .
     8314   END PROCEDURE.
