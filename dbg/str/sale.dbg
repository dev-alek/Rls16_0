     9728       (input  v-cntxt-db-num
     9729       ,input  v-cntxt-userid
     9730       ,input  0
     9731       ,input  'actn_sale_fact':U
     9732       ,input  'object':U
     9733       ,input  buf_inkas.host-code
     9734       ,input  buf_inkas.obj-type
     9735       ,input  buf_inkas.obj-code
     9736       ,input  0
     9737       ,input  0
     9738       ,input  0
     9739       ,input  true
     9740       ,output glog
     9741       )  .
     9742   end.
     9743       if NOT glog then undo, return error.
     9744     if NOT can-find( first ub.chk-doc No-LOCK where ub.chk-doc.out-code = buf_inkas.inkas-code ) then do:
     9745       undo, return error substitute("&1 Отчет о продаже пуст. Резервирование невозможно.", vss-description).
     9746     end.
     9747     FIND FIRST locked_trn-doc WHERE
     9748             locked_trn-doc.doc-code = buf_inkas.inkas-code NO-LOCK .
     9749     glog = no.
     9750     RUN Inv-chk in this-procedure  (input buf_Inkas.inkas-code
     9751                                   , input v-curr-r-b
     9752                                   , buffer buf_inkas
     9753                                   , buffer buf_trn-doc
     9754                                   , input r-or-v
     9755                                   , input r-office
     9756                                   , input rdoc-line) no-error .
     9757     IF error-status:error  then do:
     9758       message
     9759       substitute("&1 Были ошибки при проверке документов на возможность резервирования:&2&3&2&4"
     9760                   , vss-description
     9761                   , chr(10)
     9762                   , error-status:get-message(1)
     9763                   , return-value)
     9764       view-as alert-box error .
     9765       undo, return "error".
     9766     end.
     9767     BadTrans = FALSE .
     9768     FIND FIRST locked_inkas WHERE recid( locked_inkas ) = recid( buf_Inkas ) .
     9769     FIND FIRST locked_trn-doc WHERE
     9770               locked_trn-doc.doc-code = buf_inkas.inkas-code .
     9771     assign
     9772     locked_inkas.is-auto-rsrv = no
     9773     .
     9774     RUN RESERV in this-procedure (
     9775                buffer locked_inkas
     9776               ,buffer locked_trn-doc
     9777               ,input p-auto-fbr
     9778               ,input p-rsrv-prop-goods
     9779               ,input p-rest-dish
     9780               ,input p-fbr-income-doc-code
     9781               ,input p-is-tpsi-obj
     9782               ,input p-rest-tpsi) no-error.
     9783     IF error-status:error  then do:
     9784       message
     9785       substitute("&1 Были ошибки при резервировании:&2&3 &4"
     9786                   , vss-description
     9787                   , chr(10)
     9788                   , error-status:get-message(1)
     9789                   , return-value)
     9790       view-as alert-box error .
     9791       if p-is-tpsi-obj then run UI-on in this-procedure .
     9792       return "error".
     9793     end.
     9794       if p-is-tpsi-obj then run UI-on in this-procedure .
     9795     IF num_resv = 0  then do:
     9796       if NOT auto-close
     9797       and not p-auto-fbr
     9798       then do:
     9799         message
     9800         "Не найдено товара для резервирования."
     9801         view-as alert-box INFORMATION .
     9802       end.
     9803     end.
     9804       p-next-prev = ?.
     9805       run UI-on in this-procedure .
     9806       if rgds-dtl <> ? then do:
     9807         if r-or-v = 'es':U
     9808         and r-office = 'т':U
     9809         then
     9810         reposition br-out to recid rgds-dtl no-error.
     9811         else
     9812         reposition br-ret to recid rgds-dtl no-error.
     9813       end.
     9814     if p-auto-fbr then do:
     9815       assign
     9816       error-status:error = no
     9817       .
     9818     end.
     9819   end.
     9820   END PROCEDURE.
     9821   PROCEDURE b-unres-proc:
     9822   define parameter buffer buf_inkas for ub.inkas.
     9823   define parameter buffer buf_trn-doc for ub.trn-doc.
     9824   define parameter buffer buf_ret-doc for ub.trn-doc.
     9825   define input parameter p-is-tpsi-obj  as logical no-undo .
     9826   define input parameter p-from-compense as logical no-undo .
     9827   define variable glog as logical no-undo .
     9828   define buffer locked_inkas for ub.inkas.
     9829   define buffer locked_trn-doc for ub.trn-doc.
     9830   if buf_trn-doc.status_ = 'запрос':U then return.
     9831   if not from-menu then
     9832   assign
     9833   rdoc-line = ?
     9834   rgds-dtl = ?
     9835   r-or-v = ?
     9836   r-office = ?
     9837   r-qnty = ?
     9838   .
     9839   assign
     9840   num_resv = 0
     9841   num_resv_res = 0
     9842   num_rec = 0
     9843   num_rec_res = 0
     9844   .
     9845   from-menu = no.
     9846   define variable vss-include-info65 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9847   do:
     9848     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     9849       (input  v-cntxt-db-num
     9850       ,input  v-cntxt-userid
     9851       ,input  0
     9852       ,input  'actn_sale_fact':U
     9853       ,input  'object':U
     9854       ,input  buf_inkas.host-code
     9855       ,input  buf_inkas.obj-type
     9856       ,input  buf_inkas.obj-code
     9857       ,input  0
     9858       ,input  0
     9859       ,input  0
     9860       ,input  true
     9861       ,output glog
     9862       )  .
     9863   end.
     9864   if NOT glog then undo, return error.
     9865   if NOT can-find( first ub.chk-doc No-LOCK where ub.chk-doc.out-code = buf_inkas.inkas-code ) then do:
     9866     undo, return error substitute("&1 Отчет о продаже пуст. Снять резервы невозможно.", vss-description).
     9867   end.
     9868   FIND FIRST locked_trn-doc WHERE
     9869            locked_trn-doc.doc-code = buf_trn-doc.doc-code NO-LOCK .
     9870   glog = no.
     9871   RUN Inv-chk  in this-procedure (  input buf_Inkas.inkas-code
     9872                 , input v-curr-r-b
     9873                 , buffer buf_inkas
     9874                 , buffer buf_trn-doc
     9875                 , input r-or-v
     9876                 , input r-office
     9877                 , input rdoc-line) no-error .
     9878   IF error-status:error  then do:
     9879    run waitfram-hide in this-procedure.
     9880     message
     9881     substitute("&1 Были ошибки при проверке документов на возможность разрезервирования:&2&3&2&4"
     9882                 , vss-description
     9883                 , chr(10)
     9884                 , error-status:get-message(1)
     9885                 , return-value)
     9886     view-as alert-box error .
     9887     undo, return "error".
     9888   end.
     9889   BadTrans = FALSE .
     9890   FIND FIRST locked_inkas WHERE recid( locked_inkas ) = recid( buf_Inkas ) .
     9891   FIND FIRST locked_trn-doc WHERE
     9892              locked_trn-doc.doc-code = buf_inkas.inkas-code .
     9893   RUN UNRESERV in this-procedure (input p-is-tpsi-obj
     9894                                 , buffer locked_inkas
     9895                                 ) no-error .
     9896   IF error-status:error  then do:
     9897    run waitfram-hide in this-procedure.
     9898     message
     9899     substitute("&1 Были ошибки при снятии резервов:&2&3 &4"
     9900                 , vss-description
     9901                 , chr(10)
     9902                 , error-status:get-message(1)
     9903                 , return-value)
     9904     view-as alert-box error .
     9905     undo, return error.
     9906   end.
     9907   IF num_resv = 0
     9908   and not p-from-compense
     9909   then do:
     9910     message
     9911     "Не найдено товара для снятия резервов."
     9912     view-as alert-box INFORMATION .
     9913   end.
     9914     p-next-prev = ?.
     9915     run UI-on in this-procedure .
     9916     if rgds-dtl <> ? then reposition br-out to recid rgds-dtl no-error.
     9917     if error-status:error then
     9918     reposition br-ret to recid rgds-dtl no-error.
     9919   END PROCEDURE.
     9920   PROCEDURE RESERV:
     9921   define parameter buffer buf_inkas for ub.inkas.
     9922   define parameter buffer buf_trn-doc for ub.trn-doc.
     9923   define input parameter p-auto-fbr as logical no-undo .
     9924   define input parameter p-rsrv-prop-goods as logical no-undo .
     9925   define input parameter p-rest-dish as logical no-undo .
     9926   define input parameter p-fbr-income-doc-code like ub.trn-doc.doc-code no-undo .
     9927   define input parameter p-is-tpsi-obj  as logical no-undo .
     9928   define input parameter p-rest-tpsi as logical no-undo .
     9929   DEFINE VARIABLE vat-value like ub.doc-line.vat-pc no-undo .
     9930   DEFINE VARIABLE slt-value like ub.doc-line.slt-pc no-undo .
     9931   define variable v-is-dish as character no-undo .
     9932   define variable v-is-modificator as character no-undo .
     9933   define variable v-run-tpsi-line as logical no-undo .
     9934   define variable v-run-tpsi as logical no-undo .
     9935   define buffer buf_sale-doc for ub.sale-doc.
     9936   define buffer dop_trn-doc for ub.trn-doc.
     9937   define variable v-user-action  as character no-undo .
     9938   define variable v-printed      as logical   no-undo .
     9939   define variable v-old-num_rec as integer no-undo .
     9940   define variable v-attr-value              as character no-undo .
     9941   define variable v-type                   as character no-undo .
     9942   if buf_trn-doc.status_ = 'запрос':U then return.
     9943   assign
     9944   num_rec = 0
     9945   num_rec_res = 0
     9946   num_resv = 0
     9947   num_resv_res = 0
     9948   num_rec_other = 0
     9949   num_rec_other_res = 0
     9950   r-artic =      "":U
     9951   r-prod-type = "":U
     9952   r-prod-code = 0
     9953   r-prt-code = 0
     9954   .
     9955   for each tt0-info:
     9956     delete tt0-info.
     9957   end.
     9958   _buf_sale-doc:
     9959   for each buf_sale-doc where
     9960          buf_sale-doc.inkas-code = buf_inkas.inkas-code
     9961      and buf_sale-doc.order > 0
     9962   by buf_sale-doc.order
     9963   on error undo _buf_sale-doc, next _buf_sale-doc:
     9964     if r-or-v <> ?
     9965     and  (buf_sale-doc.doc-kind <> r-or-v
     9966          or
     9967          buf_sale-doc.chr-office <> r-office
     9968          )
     9969     then NEXT _buf_sale-doc.
     9970     if not (buf_sale-doc.doc-kind = 'es':U
     9971            and
     9972            buf_sale-doc.chr-office = 'т':U) then do:
     9973       find first buf_trn-doc exclusive-lock where buf_trn-doc.doc-code = buf_sale-doc.doc-code.
     9974     end.
     9975     if buf_sale-doc.doc-kind = 'rwo':U
     9976     and r-or-v <> 'rwo':U then next _buf_sale-doc.
     9977   run waitfram-show in this-procedure (substitute("Резервирование товаров. &1", entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )) ).
     9978     _doc-line:
     9979     FOR EACH ub.doc-line EXCLUSIVE-LOCK WHERE
     9980               ub.doc-line.doc-code = buf_trn-doc.doc-code,
     9981         FIRST ub.goods WHERE
     9982                   ub.goods.artic = ub.doc-line.artic AND
     9983                   ub.goods.prod-type = ub.doc-line.prod-type AND
     9984                   ub.goods.prod-code = ub.doc-line.prod-code NO-LOCK
     9985      on error undo _doc-line, next _doc-line :
     9986       IF ub.doc-line.fact-qnty = ub.doc-line.doc-qnty then NEXT _doc-line.
     9987       if buf_sale-doc.doc-kind = 'rs':U
     9988       then do :
     9989         find first ub.doc-fbr-gds no-lock where ub.doc-fbr-gds.out-code = replace(ub.doc-line.doc-code, "=", "-")
     9990                                             and ub.doc-fbr-gds.gds-code = ub.goods.gds-code
     9991                                             no-error.
     9992         if available ub.doc-fbr-gds and ub.doc-fbr-gds.fact-qnty < 0
     9993         then do :
     9994           if ub.doc-line.doc-qnty = abs(ub.doc-fbr-gds.fact-qnty) then NEXT _doc-line.
     9995         end.
     9996       end.
     9997       IF NOT (rdoc-line = ?) then do:
     9998         if  NOT recid(ub.doc-line) = rdoc-line THEN NEXT _doc-line.
     9999         assign
    10000         r-artic = ub.doc-line.artic
    10001         r-prod-type = ub.doc-line.prod-type
    10002         r-prod-code = ub.doc-line.prod-code
    10003         .
    10004       end.
    10005   define variable vss-include-info66 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10006   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
    10007     (input  ub.goods.gds-code
    10008     ,input  '1':U
    10009     ,input  buf_inkas.shift-date
    10010     ,input  buf_inkas.host-code
    10011     ,input  buf_inkas.obj-type
    10012     ,input  buf_inkas.obj-code
    10013     ,output vat-value
    10014     ) no-error .
    10015       find first dop_trn-doc no-lock where
    10016                 dop_trn-doc.doc-code  = buf_sale-doc.doc-code.
    10017   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_st-sltpc in g#lib-trn
    10018   (
    10019    input  recid(ub.goods)
    10020   ,input  recid(dop_trn-doc)
    10021   ,input  buf_sale-doc.pay-code
    10022   ,output slt-value
    10023   )
    10024   .
    10025       assign
    10026       doc-line.VAT-pc = vat-value
    10027       doc-line.slt-pc = slt-value
    10028       .
    10029       IF CAN-FIND(FIRST ub.doc-pl No-LOCK WHERE
    10030                         ub.doc-pl.out-code = ub.doc-line.doc-code AND
    10031                         ub.doc-pl.gds-code = ub.goods.gds-code)
    10032       then do:
    10033           FIND FIRST ub.gds-prt NO-LOCK WHERE
    10034                       ub.gds-prt.upper-code = ub.goods.prt-root NO-ERROR.
    10035           cashplace = yes.
    10036       end.
    10037       else cashplace = no.
    10038       IF NOT cashplace then do:
    10039           IF CAN-FIND(FIRST ub.doc-prts No-LOCK WHERE
    10040                             ub.doc-prts.out-code = ub.doc-line.doc-code AND
    10041                             ub.doc-prts.gds-code = ub.goods.gds-code)
    10042           then do:
    10043               FIND FIRST ub.gds-prt NO-LOCK WHERE
    10044                           ub.gds-prt.upper-code = ub.goods.prt-root NO-ERROR.
    10045               cashparts = yes.
    10046           end.
    10047           else cashparts = no.
    10048       end.
    10049       else cashparts = no.
    10050       FIND FIRST ub.units WHERE
    10051                   ub.units.unit-name = ub.goods.unit-base NO-LOCK .
    10052       if can-find(first ub.tax-units where
    10053                         ub.tax-units.tax-code = btltaxcd AND
    10054                         LOOKUP(ub.tax-units.type, units.type) > 0) then  do:
    10055           assign
    10056           bottle = yes.
    10057       end.
    10058       else do:
    10059           bottle = no.
    10060       end.
    10061       IF CAN-FIND(FIRST ub.doc-fbr-gds No-LOCK WHERE
    10062                         ub.doc-fbr-gds.out-code = ub.doc-line.doc-code AND
    10063                         ub.doc-fbr-gds.gds-code = ub.goods.gds-code)
    10064       then do:
    10065   define variable vss-include-info67 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10066   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run fgdsobjt in g#library
    10067     (input  ub.doc-line.obj-type
    10068     ,input  ub.doc-line.obj-code
    10069     ,input  ub.goods.gds-code
    10070     ,input  'is-dish=request,is-modificator=request'
    10071     ,output v-is-dish
    10072     )  .
    10073         if not error-status:error
    10074         then assign
    10075         cashfbr = lookup('1':U, v-is-dish) > 0
    10076         no-error .
    10077       end.
    10078       else cashfbr = no.
    10079       rsrv-title = substitute("Резервирование. &1. Строк ", entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )).
    10080       if buf_sale-doc.dir = 1 then do:
    10081         assign
    10082           v-old-num_rec = num_rec.
    10083         run RSRV-line in this-procedure (
    10084                       input 1,
    10085                       input p-auto-fbr,
    10086                       input p-rsrv-prop-goods,
    10087                       input auto-fbr,
    10088                       input p-rest-dish,
    10089                       input p-fbr-income-doc-code,
    10090                       input p-is-tpsi-obj,
    10091                       input p-rest-tpsi,
    10092                       input yes,
    10093                       input ub.goods.gds-code,
    10094                       input (if available ub.gds-prt then ub.gds-prt.node-code else ?),
    10095                       output v-run-tpsi-line,
    10096                       buffer ub.doc-line,
    10097                       buffer buf_trn-doc,
    10098                       buffer buf_sale-doc
    10099                       ) no-error.
    10100         if ub.doc-line.fact-qnty <> ub.doc-line.doc-qnty and v-log-handle <> ?
    10101             and v-old-num_rec <> num_rec
    10102         then do:
    10103           run write-log-and-file in v-log-handle (
    10104                               input 1
    10105                             , input log-file-name
    10106                             , input 1
    10107                             , input substitute("Ошибка при резервировании товара артикул &1: требуемое кол-во &2 зарезервировано &3"
    10108                                           ,ub.doc-line.artic
    10109                                           ,ub.doc-line.fact-qnty
    10110                                           ,ub.doc-line.doc-qnty
    10111                                           )
    10112                             ).
    10113         end.
    10114       end.
    10115       else do:
    10116         RUN gds-attr-value (
    10117                             INPUT ub.goods.gds-code,
    10118                             INPUT 'mark-type':U,
    10119                             OUTPUT v-attr-value,
    10120                             OUTPUT v-type
    10121                             ).
    10122         if v-attr-value > ""
    10123         and ObjSrv:Env:ParametrsOfSection:GetSectionEDO(buf_trn-doc.obj-type, buf_trn-doc.obj-code):GetIsMarkingForType(v-attr-value)
    10124         then do :
    10125           next _doc-line .
    10126         end .
    10127         run RSRV-line in this-procedure (
    10128                       input -1,
    10129                       input no,
    10130                       input no ,
    10131                       input auto-fbr,
    10132                       input p-rest-dish,
    10133                       input p-fbr-income-doc-code,
    10134                       input p-is-tpsi-obj,
    10135                       input p-rest-tpsi,
    10136                       input yes,
    10137                       input ub.goods.gds-code,
    10138                       input (if available ub.gds-prt then ub.gds-prt.node-code else ?),
    10139                       output v-run-tpsi-line,
    10140                       buffer ub.doc-line,
    10141                       buffer buf_trn-doc,
    10142                       buffer buf_sale-doc
    10143                       ) no-error.
    10144       end.
    10145       if error-status:error then do:
    10146         if rdoc-line <> ? then do:
    10147           run waitfram-hide in this-procedure .
    10148           return error substitute("Ошибка при резервировании товаров:&1&2 &3"
    10149                                 , chr(10)
    10150                                 , error-status:get-message(1)
    10151                                 , return-value ).
    10152         end.
    10153         else next _doc-line.
    10154       end.
    10155       assign
    10156       doc-line.price-base = cost-base
    10157       doc-line.price-rubl = cost-rubl .
    10158       if buf_sale-doc.doc-kind = 'es':U
    10159       then do:
    10160         assign
    10161         v-run-tpsi = v-run-tpsi or v-run-tpsi-line.
    10162       end.
    10163     END.
    10164     if buf_sale-doc.doc-kind = 'es':U then do:
    10165       run waitfram-hide in this-procedure .
    10166       if not p-rsrv-prop-goods
    10167       and (p-is-tpsi-obj and v-run-tpsi)  then do:
    10168       run waitfram-show in this-procedure ("Ждите... Идет резервирование ЧУЖИХ товаров." ).
    10169         run str/tpsirsrv.p (
    10170                         input parparentproc
    10171                         ,input p-parent-handle
    10172                         ,input p-log-handle
    10173                         ,input p-auto
    10174                         ,INPUT V-CURR-R-B
    10175                         ,input buf_inkas.inkas-code
    10176                         ,input buf_trn-doc.host-code
    10177                         ,input buf_trn-doc.obj-type
    10178                         ,input buf_trn-doc.obj-code
    10179                         ,input r-artic
    10180                         ,input r-prod-type
    10181                         ,input r-prod-code
    10182                         ,input r-prt-code
    10183                         ,input yes
    10184                         ,input "Резервирование ЧУЖИХ товаров. Расход. Строк "
    10185                         ,input-output num_rec_res
    10186                         ,output num_rec_other
    10187                         ,output num_rec_other_res
    10188                         ,buffer buf_trn-doc
    10189                       ) no-error .
    10190         if error-status:error then do:
    10191           if p-rsrv-prop-goods
    10192           or rdoc-line <> ? then do:
    10193             run waitfram-hide in this-procedure .
    10194             return error substitute("Ошибка при резервировании ЧУЖИХ товаров:&1&2 &3"
    10195                                     , chr(10)
    10196                                     , error-status:get-message(1)
    10197                                     , return-value ).
    10198           end.
    10199           else do:
    10200           end.
    10201           run waitfram-hide in this-procedure .
    10202         end.
    10203       end.
    10204     end.
    10205     assign
    10206     num_resv = num_resv + num_rec
    10207     num_resv_res = num_resv_res + num_rec_res
    10208     num_rec = 0
    10209     num_rec_res = 0
    10210     .
    10211   END.
    10212   if num_resv = num_resv_res and num_resv > 0 then do:
    10213     if NOT auto-close and r-qnty = ? and not p-auto-fbr then do:
    10214   MESSAGE "Резервирование прошло успешно" view-as alert-box.
    10215     end.
    10216   end.
    10217   else do:
    10218     if auto-fbr then do:
    10219     end.
    10220     if  num_resv > 0 then do:
    10221   MESSAGE substitute("Из &1 позиций, подлежащих резервированию, успешно зарезервировано &2 (не зарезервировано &3)"                         , num_resv                                                                                      , num_resv_res                         , num_resv - num_resv_res) view-as alert-box.
    10222       if search (log-file-name) <> ? and not (auto-close or p-auto-fbr or g#auto) then do:
    10223         run gbl/prnfilen.w (
    10224               input "Список не зарезервированных товаров":U
    10225             , input 8
    10226             , input search (log-file-name)
    10227             , input 7
    10228             , output v-user-action
    10229             , output v-printed
    10230         ).
    10231         os-delete value(log-file-name) .
    10232       end.
    10233           if search ("alc-rsrv.log") <> ? and not (auto-close or p-auto-fbr or g#auto)  then do:
    10234               run gbl/prnfilen.w (
    10235                     input "Замечания по резервированию алкоголя":U
    10236                   , input 8
    10237                   , input search ("alc-rsrv.log")
    10238                   , input 7
    10239                   , output v-user-action
    10240                   , output v-printed
    10241               ).
    10242               os-delete value("alc-rsrv.log") .
    10243           end.
    10244     end.
    10245     if num_resv > 0
    10246     and (auto-close or p-auto-fbr) then return error "Не все товары, подлежащие резервированию, зарезервированы".
    10247   end.
    10248   END PROCEDURE.
    10249   PROCEDURE button-close:
    10250   define parameter buffer buf_trn-doc for ub.trn-doc.
    10251   define parameter buffer buf_ret-doc for ub.trn-doc.
    10252   define input parameter p-is-tpsi-obj as logical no-undo .
    10253   define input parameter auto-fbr as logical no-undo .
    10254   define input parameter p-neg-tpsi-weight as logical no-undo .
    10255   define input parameter p-neg-tpsi-qnty as decimal no-undo .
    10256   define input parameter p-neg-tpsi-oper as logical no-undo .
    10257   define output parameter b-close-enabled as logical no-undo .
    10258   define variable v-is-dish as character no-undo .
    10259   define variable v-doc-ii as integer no-undo .
    10260   define variable v-curr-doc-code like ub.trn-doc.doc-code no-undo .
    10261   define variable v-attr-value              as character no-undo .
    10262   define variable v-type                   as character no-undo .
    10263   define buffer buf_gds-dtl for ub.gds-dtl.
    10264   define buffer buf_goods for ub.goods.
    10265   define buffer buf_doc-line for ub.doc-line.
    10266   define buffer dop_trn-doc for ub.trn-doc.
    10267   define buffer buf_sale-doc for ub.sale-doc.
    10268   define buffer buf_units for ub.units.
    10269   if buf_trn-doc.status_ = 'запрос':U then do:
    10270       run waitfram-show in this-procedure ("Проверка отсутствия зарезервированного товара..." ).
    10271   end.
    10272   else do:
    10273       run waitfram-show in this-procedure ("Проверка количества зарезервированного товара..." ).
    10274     if auto-fbr then do:
    10275       _buf_sale-doc:
    10276       for each buf_sale-doc where
    10277               buf_sale-doc.inkas-code = buf_trn-doc.doc-code
    10278           and buf_sale-doc.order > 0
    10279       by buf_sale-doc.order:
    10280         if buf_sale-doc.doc-kind = 'es':U
    10281         or buf_sale-doc.doc-kind = 'rs':U then do:
    10282           for each buf_gds-dtl no-lock where
    10283                     buf_gds-dtl.doc-code = buf_sale-doc.doc-code
    10284               AND buf_gds-dtl.doc-qnty <> buf_gds-dtl.fact-qnty,
    10285             first buf_goods no-lock where
    10286                   buf_goods.artic = buf_gds-dtl.artic
    10287               AND buf_goods.prod-type = buf_gds-dtl.prod-type
    10288               AND buf_goods.prod-code = buf_gds-dtl.prod-code:
    10289             if is-gas(buf_goods.gds-code) then next.
    10290             RUN gds-attr-value (
    10291                                 INPUT buf_goods.gds-code,
    10292                                 INPUT 'mark-type':U,
    10293                                 OUTPUT v-attr-value,
    10294                                 OUTPUT v-type
    10295                                 ).
    10296             if v-attr-value > ""
    10297             and ObjSrv:Env:ParametrsOfSection:GetSectionEDO(buf_trn-doc.obj-type, buf_trn-doc.obj-code):GetIsMarkingForType(v-attr-value)
    10298             then do :
    10299               next .
    10300             end .
    10301   define variable vss-include-info68 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10302   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run fgdsobjt in g#library
    10303     (input  buf_gds-dtl.obj-type
    10304     ,input  buf_gds-dtl.obj-code
    10305     ,input  buf_goods.gds-code
    10306     ,input  'is-dish=request,is-modificator=request'
    10307     ,output v-is-dish
    10308     ) no-error .
    10309             if error-status:error or lookup('1':U, v-is-dish) = 0 then do:
    10310               assign
    10311               b-close-enabled = no
    10312               .
    10313               run waitfram-hide in this-procedure .
    10314               return.
    10315             end.
    10316           end.
    10317         end.
    10318         else do:
    10319           if buf_sale-doc.doc-kind = 'rwo':U then do:
    10320             NEXT _buf_sale-doc.
    10321           end.
    10322           if buf_sale-doc.doc-kind = 'trf':U then do:
    10323             find first buf_gds-dtl NO-LOCK where
    10324                             buf_gds-dtl.doc-code = buf_sale-doc.doc-code
    10325                         AND buf_gds-dtl.doc-qnty <> buf_gds-dtl.fact-qnty USE-INDEX pi no-error .
    10326             if available buf_gds-dtl
    10327             then do:
    10328               find first buf_goods no-lock where
    10329                     buf_goods.artic = buf_gds-dtl.artic
    10330                 AND buf_goods.prod-type = buf_gds-dtl.prod-type
    10331                 AND buf_goods.prod-code = buf_gds-dtl.prod-code .
    10332               RUN gds-attr-value (
    10333                                   INPUT buf_goods.gds-code,
    10334                                   INPUT 'mark-type':U,
    10335                                   OUTPUT v-attr-value,
    10336                                   OUTPUT v-type
    10337                                   ).
    10338               if v-attr-value > ""
    10339               and ObjSrv:Env:ParametrsOfSection:GetSectionEDO(buf_trn-doc.obj-type, buf_trn-doc.obj-code):GetIsMarkingForType(v-attr-value)
    10340               then do :
    10341               end .
    10342               else
    10343               if not is-gas(buf_goods.gds-code)
    10344               then do :
    10345                 assign
    10346                 b-close-enabled = no
    10347                 .
    10348                 run waitfram-hide in this-procedure .
    10349                 return.
    10350               end.
    10351             end.
    10352           end.
    10353         end.
    10354       end.
    10355     end.
    10356     else do:
    10357       _buf_sale-doc2:
    10358       for each buf_sale-doc where
    10359              buf_sale-doc.inkas-code = buf_trn-doc.doc-code
    10360          and buf_sale-doc.order > 0
    10361       by buf_sale-doc.order:
    10362         if buf_sale-doc.doc-kind = 'rwo':U then do:
    10363           next _buf_sale-doc2.
    10364         end.
    10365         if buf_sale-doc.doc-code = buf_trn-doc.doc-code
    10366         and p-is-tpsi-obj
    10367         then do:
    10368           _tt:
    10369           for each buf_Doc-line no-lock where
    10370                   buf_doc-line.doc-code = buf_trn-doc.doc-code:
    10371             find first tt0-doc-line no-lock where
    10372                   tt0-doc-line.artic     = buf_doc-line.artic
    10373               AND tt0-doc-line.prod-type = buf_doc-line.prod-type
    10374               AND tt0-doc-line.prod-code = buf_doc-line.prod-code no-error .
    10375             if p-neg-tpsi-oper
    10376             and available tt0-doc-line
    10377             and not (tt0-doc-line.obj-type = buf_doc-line.obj-type
    10378                 and tt0-doc-line.obj-code = buf_doc-line.obj-code)
    10379             and can-find(first dtl-rests-mark where
    10380                               dtl-rests-mark.artic = buf_doc-line.artic
    10381                           and dtl-rests-mark.prod-type = buf_doc-line.prod-type
    10382                           and dtl-rests-mark.prod-code = buf_doc-line.prod-code) then do:
    10383               next  _tt.
    10384             END.
    10385             if  buf_doc-line.fact-qnty <= buf_doc-line.doc-qnty + (if available tt0-doc-line
    10386                                                                   then (tt0-doc-line.doc-qnty +  p-neg-tpsi-qnty)
    10387                                                                   else 0)
    10388                                                                   then do:
    10389               next  _tt.
    10390             end.
    10391             if p-neg-tpsi-weight then do:
    10392               find first buf_goods no-lock where
    10393                       buf_goods.artic = buf_doc-line.artic
    10394                   AND buf_goods.prod-type = buf_doc-line.prod-type
    10395                   AND buf_goods.prod-code = buf_doc-line.prod-code .
    10396               find first buf_units no-lock where
    10397                           buf_units.unit-name = buf_goods.unit-base.
    10398               if lookup('вес':U, buf_units.type) > 0 then do:
    10399                 next _tt.
    10400               end.
    10401             end.
    10402             b-close-enabled = no.
    10403             run waitfram-hide in this-procedure .
    10404             return.
    10405           end.
    10406         end.
    10407         else do:
    10408           _gds-dtl:
    10409           for each buf_gds-dtl NO-LOCK where
    10410                       buf_gds-dtl.doc-code = buf_sale-doc.doc-code
    10411                   AND buf_gds-dtl.doc-qnty <> buf_gds-dtl.fact-qnty USE-INDEX pi :
    10412             find first goods no-lock where goods.artic = buf_gds-dtl.artic
    10413                                        and goods.prod-type = buf_gds-dtl.prod-type
    10414                                        and goods.prod-code = buf_gds-dtl.prod-code
    10415                                        .
    10416             RUN gds-attr-value (
    10417                                 INPUT goods.gds-code,
    10418                                 INPUT 'mark-type':U,
    10419                                 OUTPUT v-attr-value,
    10420                                 OUTPUT v-type
    10421                                 ).
    10422             if v-attr-value > ""
    10423             and ObjSrv:Env:ParametrsOfSection:GetSectionEDO(buf_trn-doc.obj-type, buf_trn-doc.obj-code):GetIsMarkingForType(v-attr-value)
    10424             then do :
    10425               next _gds-dtl .
    10426             end .
    10427             if buf_sale-doc.doc-kind = 'rs':U
    10428             then do :
    10429               find first doc-fbr-gds no-lock where doc-fbr-gds.out-code = replace(buf_gds-dtl.doc-code, "=", "-")
    10430                                                and doc-fbr-gds.gds-code = goods.gds-code
    10431                                                no-error .
    10432             end.
    10433             if buf_sale-doc.doc-kind = 'es':U
    10434             then do :
    10435               find first doc-fbr-gds no-lock where doc-fbr-gds.out-code = buf_gds-dtl.doc-code
    10436                                                and doc-fbr-gds.gds-code = goods.gds-code
    10437                                                no-error .
    10438             end.
    10439             if available doc-fbr-gds
    10440             then do :
    10441               next.
    10442             end.
    10443             assign
    10444             b-close-enabled = no
    10445             .
    10446             run waitfram-hide in this-procedure .
    10447             return.
    10448           end.
    10449         end.
    10450       END.
    10451     end.
    10452   end.
    10453   assign
    10454   b-close-enabled = yes.
    10455   run waitfram-hide in this-procedure .
    10456   END.
    10457   define variable vss-include-info69 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10458   PROCEDURE UNRESERV:
    10459   define input parameter p-is-tpsi-obj  as logical no-undo .
    10460   define parameter buffer buf_Inkas for ub.inkas.
    10461   DEFINE VARIABLE vat-value like ub.doc-line.vat-pc no-undo .
    10462   DEFINE VARIABLE slt-value like ub.doc-line.slt-pc no-undo .
    10463   define variable v-is-dish as character no-undo .
    10464   define variable v-run-tpsi-line as logical no-undo .
    10465   define variable v-run-tpsi      as logical no-undo .
    10466   define variable ser-good        as logical no-undo .
    10467   define variable v-msg-on as logical   no-undo .
    10468   define buffer buf_trn-doc for ub.trn-doc.
    10469   define buffer buf_sale-doc for ub.sale-doc.
    10470   assign
    10471   num_rec = 0
    10472   num_rec_res = 0
    10473   num_resv = 0
    10474   num_resv_res = 0
    10475   r-artic =      "":U
    10476   r-prod-type = "":U
    10477   r-prod-code = 0
    10478   r-prt-code = 0
    10479   .
    10480   for each tt0-info:
    10481     delete tt0-info.
    10482   end.
    10483   if rdoc-line = -1 then do:
    10484     assign
    10485     v-msg-on = yes
    10486     rdoc-line = ?.
    10487   end.
    10488   _buf_sale-doc:
    10489   for each buf_sale-doc where
    10490          buf_sale-doc.inkas-code = buf_inkas.inkas-code
    10491      and buf_sale-doc.order > 0
    10492   by buf_sale-doc.order:
    10493     if buf_sale-doc.doc-kind = 'rwo':U then NEXT _BUF_sale-doc.
    10494     if r-or-v <> ?
    10495     and buf_sale-doc.doc-kind <> r-or-v then NEXT _BUF_sale-doc.
    10496     FIND FIRST buf_trn-doc WHERE buf_trn-doc.doc-code = buf_sale-doc.doc-code .
    10497   run waitfram-show in this-procedure (substitute("Снятие резервов. &1.", entry (lookup (buf_sale-doc.doc-kind, 'es,rs,rwo,trf,swo,ngs,rgs,vir':U + ',' + 'itr':U) + 1, ',' + 'касса продажа,касса возврат,Списание-по-Возврату,ТехПролив,Списание,Приход-Природный-Газ,Возврат-Природный-Газ,Перемещение-Вирт-Рез':U + ',' + 'ПриТехПрол':U )) ).
    10498     _doc-line:
    10499     FOR EACH ub.doc-line WHERE
    10500               ub.doc-line.doc-code = buf_sale-doc.doc-code EXCLUSIVE-LOCK,
    10501       FIRST ub.goods WHERE
    10502             ub.goods.artic = ub.doc-line.artic AND
    10503             ub.goods.prod-type = ub.doc-line.prod-type AND
    10504             ub.goods.prod-code = ub.doc-line.prod-code NO-LOCK :
    10505         if buf_sale-doc.doc-kind = 'es':U then do:
    10506           IF ub.doc-line.doc-qnty = 0 and not p-is-tpsi-obj then NEXT _doc-line.
    10507           IF NOT (rdoc-line = ?) then do:
    10508             if NOT recid(ub.doc-line) = rdoc-line THEN NEXT _doc-line.
    10509             assign
    10510             r-artic = ub.doc-line.artic
    10511             r-prod-type = ub.doc-line.prod-type
    10512             r-prod-code = ub.doc-line.prod-code
    10513             .
    10514           end.
    10515         end.
    10516         else do:
    10517           IF ub.doc-line.doc-qnty = 0 then NEXT _doc-line.
    10518           IF NOT (rdoc-line = ?)
    10519           AND NOT recid(ub.doc-line) = rdoc-line THEN NEXT _doc-line.
    10520        end.
    10521   define variable vss-include-info70 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10522   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
    10523     (input  ub.goods.gds-code
    10524     ,input  '1':U
    10525     ,input  buf_inkas.shift-date
    10526     ,input  buf_inkas.host-code
    10527     ,input  buf_inkas.obj-type
    10528     ,input  buf_inkas.obj-code
    10529     ,output vat-value
    10530     ) no-error .
    10531   define variable vss-include-info71 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10532   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
    10533     (input  ub.goods.gds-code
    10534     ,input  '2':U
    10535     ,input  buf_inkas.shift-date
    10536     ,input  buf_inkas.host-code
    10537     ,input  buf_inkas.obj-type
    10538     ,input  buf_inkas.obj-code
    10539     ,output slt-value
    10540     ) no-error .
    10541         assign
    10542         ub.doc-line.vat-pc = vat-value
    10543         ub.doc-line.slt-pc = slt-value
    10544         .
    10545         IF CAN-FIND(FIRST ub.doc-pl No-LOCK WHERE
    10546                           ub.doc-pl.out-code = ub.doc-line.doc-code AND
