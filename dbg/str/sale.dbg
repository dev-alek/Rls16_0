     7296   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)):
     7297     case thbjattr_thbj-attr.prop-code:
     7298       when 'autoclos':U then do:
     7299         autoclose = thbjattr_thbj-attr.property-value-logical.
     7300       end.
     7301       when 'autocalc':U then do:
     7302         autocalc = thbjattr_thbj-attr.property-value-logical.
     7303       end.
     7304       when 'automail':U then do:
