     8955         b-trn-doc.doc-qnty = b-trn-doc.doc-qnty  + chg-qnty
     8956         .
     8957         if (loc-gds-dtl.doc-qnty = loc-gds-dtl.fact-qnty and rz) or                           (loc-gds-dtl.doc-qnty = 0 and not  rz)  then do: assign num_rec_res = num_rec_res + 1. end.
     8958         if bottle then do:
     8959   assign
     8960     price-rubl-with-tax-loc = b-doc-line.price-rubl
     8961     price-base-with-tax-loc = b-doc-line.price-base
     8962   .
     8963   define variable vss-include-info60 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     8964   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     8965     (output varinvprb
     8966     )  .
     8967      find first in-vatp_doc-attr no-lock
     8968       where in-vatp_doc-attr.doc-code  = b-trn-doc.doc-code
     8969         and in-vatp_doc-attr.attr-code = 'envd':U
     8970       no-error .
     8971       if available in-vatp_doc-attr
     8972          then do:
     8973          assign
     8974            in-vatp-have-vat-slt = no.
     8975      end.
     8976      else do:
     8977        assign
     8978          in-vatp-have-vat-slt = yes.
     8979      end.
     8980      find first in-vatp-goods where in-vatp-goods.artic     = b-doc-line.artic     and
     8981                                        in-vatp-goods.prod-type = b-doc-line.prod-type and
     8982                                        in-vatp-goods.prod-code = b-doc-line.prod-code no-lock.
     8983      if (not b-trn-doc.internal and
     8984              b-trn-doc.doc-type = 'при':U) or
     8985         in-vatp-goods.gds-type = 'у':U then do:
     8986         if varinvprb = "base":u then do:
     8987           assign
     8988             road-tax-base-loc = b-doc-line.road-tax
     8989             road-tax-rubl-loc = b-doc-line.road-tax * b-trn-doc.base-rate / b-trn-doc.base-scale.
     8990         end.
     8991         else do:
     8992           ASSIGN
     8993             road-tax-rubl-loc = b-doc-line.road-tax
     8994             road-tax-base-loc = b-doc-line.road-tax / b-trn-doc.base-rate * b-trn-doc.base-scale.
     8995         end.
     8996         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     8997         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     8998         assign
     8999           road-tax-cli-loc = ?.
     9000         ASSIGN
     9001           transport-base-loc = (if b-doc-line.transport-base = ? then 0 else b-doc-line.transport-base)
     9002           transport-rubl-loc = (if b-doc-line.transport-rubl = ? then 0 else b-doc-line.transport-rubl)
     9003           transport-cli-loc  = 0
