     4456   SIZE 12 BY 1 NO-UNDO.
     4457   DEFINE BROWSE br-out QUERY br-out NO-LOCK DISPLAY
     4458   get-ok(input v-is-tpsi-obj, out-dtl.artic, out-dtl.prod-type, out-dtl.prod-code, out-dtl.prt-code, out-dtl.doc-qnty, out-dtl.fact-qnty) column-label 'OK' format "X(2)"
     4459   out-bar.b-code column-label 'Бар-код' format ">>>>>>>>>9"
     4460   out-dtl.artic column-label 'Артикул'
     4461   ( get-name (input out-prt.node-name, input out-prt.upper-code, input out-goods.prt-root, input out-goods.gds-name)) column-label 'Название' format "x(35)"
     4462   out-dtl.fact-qnty column-label 'Продано' format "->>>,>>9.<<<"
     4463   out-dtl.doc-qnty column-label 'Зарезерв.' format "->>>,>>9.<<<"
     4464   out-tt0-dtl.doc-qnty column-label 'Чужих' format "->>>,>>9.<<<"
     4465   (out-tt0-dtl.obj-type + string(out-tt0-dtl.obj-code)) column-label 'Хозяин' format "X(8)"
     4466   (if v-curr-r-b = 'base':U then out-dtl.price-base else out-dtl.price-rubl) column-label 'Цена' format "->>>,>>>,>>9.<<"
     4467   (if v-curr-r-b = 'base':U then out-dtl.discnt-base else out-dtl.discnt-rubl) column-label 'Скидка'
     4468   (get-pcnt(input out-dtl.price-base,input out-dtl.price-rubl,input out-dtl.discnt-base,input out-dtl.discnt-rubl)) column-label '%' FORMAT "->>>>>9.<%"
     4469   out-goods.unit-base column-label 'Изм'
     4470   out-goods.grp-name @ v-prt-name column-label 'Название группы'
     4471   (get-prt-name (input out-prt.node-name, input out-prt.upper-code, input out-goods.prt-root, input out-prt.f-name )) column-label 'Признак' FORMAT "x(80)" width 10
     4472   out-goods.engl-name column-label 'Название англ.'
     4473   ENABLE out-goods.engl-name
     4474   WITH SIZE 98 BY 11 SEPARATORS TITLE "Продажи".
     4475   DEFINE BROWSE br-ret QUERY br-ret NO-LOCK DISPLAY
     4476   get-ok(input v-is-tpsi-obj, ret-dtl.artic, ret-dtl.prod-type, ret-dtl.prod-code, ret-dtl.prt-code, ret-dtl.doc-qnty, ret-dtl.fact-qnty) column-label 'OK' format "X(2)"
     4477   ret-bar.b-code column-label 'Бар-код' format ">>>>>>>>>9"
     4478   ret-dtl.artic column-label 'Артикул'
     4479   ( get-name ( input ret-prt.node-name, input ret-prt.upper-code, input ret-goods.prt-root, input ret-goods.gds-name )) column-label 'Название' format "x(35)"
     4480   ret-dtl.fact-qnty column-label 'По чекам' format "->>>,>>9.<<<"
     4481   ret-dtl.doc-qnty column-label 'Зарезерв.' format "->>>,>>9.<<<"
     4482   v-empty column-label 'Зарезерв.' format "X(12)"
     4483   (if v-curr-r-b = 'base':U then ret-dtl.price-base else ret-dtl.price-rubl) column-label 'Цена' format "->>>,>>>,>>9.<<"
     4484   (if v-curr-r-b = 'base':U then ret-dtl.discnt-base else ret-dtl.discnt-rubl) column-label 'Скидка'
     4485   ( get-pcnt(input ret-dtl.price-base,input ret-dtl.price-rubl,input ret-dtl.discnt-base,input ret-dtl.discnt-rubl)) column-label '%' FORMAT "->>>>>9.<%"
     4486   ret-goods.unit-base column-label 'Изм'
     4487   ret-goods.grp-name @ v-prt-name column-label 'Название группы'
     4488   (get-prt-name ( input ret-prt.node-name, input ret-prt.upper-code, input ret-goods.prt-root, input ret-prt.f-name )) column-label 'Признак' FORMAT "x(80)" width 10
     4489   ret-goods.engl-name column-label 'Название англ.'
     4490   ENABLE ret-goods.engl-name
     4491   WITH SIZE 98 BY 5.5 SEPARATORS TITLE "Возвраты".
     4492   DEFINE FRAME d-sale
     4493   b-exit at row 1 col 1
     4494   b-prev at row 1 col 11
     4495   b-next at row 1 col 14
     4496   b-mail at row 1 col 17
     4497   b-res     at row 1 col 29
     4498   b-unres     at row 1 col 39
     4499   b-close at row 1 col 49
     4500   b-chk at row 1 col 59
     4501   b-cash at row 1 col 69
     4502   b-print at row 1 col 79
     4503   b-help at row 1 col 89
     4504   "Поиск :" view-as text SIZE 8 BY 1 at row 2 col 2
     4505   a-n-c at row 2 col 10 no-label
     4506   auto-close AT ROW 2 COL 64  FGCOLOR 4
     4507   ink-doc.qnty AT ROW 2 COL 84 COLON-ALIGNED label "Кол-во"
     4508   ink-doc.num-chk AT ROW 3 COL 84 COLON-ALIGNED label "Чеков"
     4509   ink-doc.tot-doc AT ROW 3 COL 13 COLON-ALIGNED label "Сумма тов."
     4510   ink-doc.discnt AT ROW 3 COL 44 COLON-ALIGNED label "Общая скидка"
     4511   s-pc AT ROW 3 COL 65 COLON-ALIGNED no-label
     4512   g-image AT ROW 4 COL 88.1
     4513   for-discnt-chr AT ROW 4 COL 65 COLON-ALIGNED no-label
     4514   FGCOLOR 4
     4515   ink-doc.sub-discnt  AT ROW 4 COL 13 COLON-ALIGNED label "Списания"
     4516   s-netto AT ROW 4 COL 44 COLON-ALIGNED
     4517   rest-tpsi AT ROW 4 COL 64  FGCOLOR 4
     4518   auto-fbr AT ROW 5 COL 58  FGCOLOR 4
     4519   rest-dish AT ROW 5 COL 70  FGCOLOR 4
     4520   rest-ingr AT ROW 5 COL 84  FGCOLOR 4
     4521   br-out AT ROW 6 COL 1
     4522   b-places at row 17 col 56
     4523   r-trn at row 17 col 71
     4524   b-parts at row 17 col 85
     4525   prod-name-r AT ROW 5 COL 1  NO-LABEL
     4526   prod-name-v AT ROW 17 COL 1 NO-LABEL
     4527   cb-doc-kind at row 17 col 36 NO-LABEL
     4528   br-ret AT ROW 18 COL 1
     4529   rs-sort at row 23.5 col 1 label "Сортировка" fgcolor 4 bgcolor 8
     4530   b-troubl AT ROW 23.5 COL 55 COLON-ALIGNED
     4531   b-troublp AT ROW 23.5 COL 63.5 COLON-ALIGNED
     4532   b-troublc AT ROW 23.5 COL 72 COLON-ALIGNED
     4533   b-arch at row 23.5 col 82.5
     4534   b-notes at row 23.5 col 91
     4535   loc-art AT ROW 2 COL 37 COLON-ALIGNED label "Начало артикула"
     4536   loc-name AT ROW 2 COL 37 COLON-ALIGNED label "Начало названия" format "x(40)"
     4537   loc-code AT ROW 2 COL 37 COLON-ALIGNED label "Бар-код (весь)" format "x(13)"
     4538   SPACE(0) SKIP(0)
     4539   WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     4540   SIDE-LABELS NO-UNDERLINE THREE-D SCROLLABLE
     4541   TITLE "ПРОДАЖИ и ВОЗВРАТЫ".
     4542   def var sort-labelbr-out   as character no-undo .
     4543   def var sort-clmnbr-out    as handle    no-undo .
     4544   def var cur-clmnbr-out     as handle    no-undo .
     4545   def var cur-clmn-locbr-out as integer   no-undo .
     4546   def var re-querybr-out     as logical   initial no no-undo .
     4547   on start-search, ctrl-o of br-out in frame d-sale do:
     4548      run sort-brbr-out
     4549        (input (if available out-dtl
     4550                then recid(out-dtl)
     4551                else ?
     4552               )
     4553        ).
     4554   end.
     4555   PROCEDURE sort-brbr-out :
     4556     define input parameter p-recid as recid no-undo .
     4557     if re-querybr-out = no then do:
     4558       assign
     4559          cur-clmnbr-out = br-out:current-column in frame d-sale
     4560       .
     4561       if sort-clmnbr-out <> ? then sort-clmnbr-out:column-fgcolor = 0.
     4562       if cur-clmnbr-out = sort-clmnbr-out then do:
     4563         assign
     4564            sort-labelbr-out = ""
     4565            sort-clmnbr-out = ?
     4566         .
     4567        end.
     4568        else do:
     4569          assign
     4570            sort-labelbr-out = cur-clmnbr-out:label
     4571            sort-clmnbr-out  = cur-clmnbr-out
     4572            sort-clmnbr-out:column-fgcolor = 4
     4573          .
     4574        end.
     4575      end.
     4576     assign
     4577       cur-clmn-locbr-out = 1
     4578     .
     4579     def var column-handle as handle no-undo .
     4580     column-handle = br-out:first-column.
     4581     do while valid-handle(column-handle) :
     4582       if column-handle = cur-clmnbr-out then do:
     4583         leave .
     4584       end.
     4585       column-handle = column-handle:NEXT-COLUMN.
     4586       assign
     4587         cur-clmn-locbr-out = cur-clmn-locbr-out + 1
     4588       .
     4589     end.
     4590     case sort-labelbr-out:
     4591           when 'OK'  then DO:   assign       sort-column-name-out = substitute('dynamic-function(&1get-ok&1, &1&2&1, out-dtl.artic, out-dtl.prod-type, out-dtl.prod-code, out-dtl.prt-code, out-dtl.doc-qnty, out-dtl.fact-qnty)', chr(34), v-is-tpsi-obj)     .     run OpenBr in this-procedure (input ink-doc.inkas-code, input br-2-doc-code, input yes, input no, input '':U, input 'out').   . END.
     4592           when 'Бар-код'  then DO:    assign       sort-column-name-out = "out-bar.b-code"     .     run OpenBr in this-procedure (input ink-doc.inkas-code, input br-2-doc-code, input yes, input no, input '':U, input 'out').   . END.
     4593           when 'Артикул'  then DO:    assign       sort-column-name-out = "out-dtl.artic"     .     run OpenBr in this-procedure (input ink-doc.inkas-code, input br-2-doc-code, input yes, input no, input '':U, input 'out').   . END.
     4594           when 'Название'  then DO:   assign       sort-column-name-out = substitute('dynamic-function(&1GET-NAME&1, out-prt.node-name, out-prt.upper-code, out-goods.prt-root, out-goods.gds-name)', chr(34))     .     run OpenBr in this-procedure (input ink-doc.inkas-code, input br-2-doc-code, input yes, input no, input '':U, input 'out').   . END.
     4595           when 'Продано'  then DO:    assign       sort-column-name-out = "out-dtl.fact-qnty"     .     run OpenBr in this-procedure (input ink-doc.inkas-code, input br-2-doc-code, input yes, input no, input '':U, input 'out').   . END.
     4596           when 'Зарезерв.'  then DO:    assign       sort-column-name-out = "out-dtl.doc-qnty"     .     run OpenBr in this-procedure (input ink-doc.inkas-code, input br-2-doc-code, input yes, input no, input '':U, input 'out').   . END.
     4597           when 'Чужих'  then DO:    assign       sort-column-name-out = "out-tt0-dtl.doc-qnty"     .     run OpenBr in this-procedure (input ink-doc.inkas-code, input br-2-doc-code, input yes, input no, input '':U, input 'out').   . END.
     4598           when 'Хозяин'  then DO:    assign       sort-column-name-out = "(out-tt0-dtl.obj-type + string(out-tt0-dtl.obj-code))"     .     run OpenBr in this-procedure (input ink-doc.inkas-code, input br-2-doc-code, input yes, input no, input '':U, input 'out').   . END.
     4599           when 'Цена'  then DO:   assign       sort-column-name-out = substitute('(if &1&2&1 = &1&3&1 then out-dtl.price-base else out-dtl.price-rubl)', chr(34), v-curr-r-b,  'base':U)     .     run OpenBr in this-procedure (input ink-doc.inkas-code, input br-2-doc-code, input yes, input no, input '':U, input 'out').   . END.
     4600           when 'Скидка'  then DO:   assign       sort-column-name-out = substitute('(if &1&2&1 = &1&3&1 then out-dtl.discnt-base else out-dtl.discnt-rubl)', chr(34), v-curr-r-b, 'base':U)     .     run OpenBr in this-procedure (input ink-doc.inkas-code, input br-2-doc-code, input yes, input no, input '':U, input 'out').   . END.
     4601           when '%'  then DO:   assign       sort-column-name-out = substitute('dynamic-function(&1get-pcnt&1, out-dtl.price-base, out-dtl.price-rubl, out-dtl.discnt-base, out-dtl.discnt-rubl)', chr(34))     .     run OpenBr in this-procedure (input ink-doc.inkas-code, input br-2-doc-code, input yes, input no, input '':U, input 'out').   . END.
     4602           when 'Изм'  then DO:    assign       sort-column-name-out = "out-goods.unit-base"     .     run OpenBr in this-procedure (input ink-doc.inkas-code, input br-2-doc-code, input yes, input no, input '':U, input 'out').   . END.
     4603           when 'Название группы'  then DO:    assign       sort-column-name-out = "out-goods.grp-name"     .     run OpenBr in this-procedure (input ink-doc.inkas-code, input br-2-doc-code, input yes, input no, input '':U, input 'out').   . END.
     4604           when 'Признак'  then DO:   assign       sort-column-name-out = substitute('dynamic-function(&1get-prt-name&1, input out-prt.node-name, input out-prt.upper-code, input out-goods.prt-root, input out-prt.f-name)', chr(34))     .     run OpenBr in this-procedure (input ink-doc.inkas-code, input br-2-doc-code, input yes, input no, input '':U, input 'out').   . END.
     4605           when 'Название англ.'  then DO:    assign       sort-column-name-out = "out-goods.engl-name"     .     run OpenBr in this-procedure (input ink-doc.inkas-code, input br-2-doc-code, input yes, input no, input '':U, input 'out').   . END.
     4606       otherwise do:
     4607         assign
     4608           sort-column-name-out = ""
     4609         .
     4610         run OpenBr in this-procedure (input ink-doc.inkas-code, input br-2-doc-code, input yes, input no, input '':U, input '':U).
     4611         if sort-labelbr-out <> "" then do:
     4612           assign
     4613             cur-clmnbr-out:column-fgcolor = 0
     4614           .
     4615         end.
     4616         assign
     4617           cur-clmn-locbr-out = ?
     4618         .
     4619       end.
     4620     end case.
     4621     if p-recid <> ? then do:
     4622       reposition br-out to recid p-recid no-error.
     4623       apply "value-changed" to br-out in frame d-sale.
     4624     end.
     4625     apply "entry" to br-out in frame d-sale.
     4626   END PROCEDURE.
     4627   procedure re-open-query-srt-clmnbr-out:
     4628   if cur-clmnbr-out = ? then do:
     4629      run OpenBr in this-procedure (input ink-doc.inkas-code, input br-2-doc-code, input yes, input no, input '':U, input '':U).
     4630   end.
     4631   else do:
     4632      assign re-querybr-out = yes.
     4633      run sort-brbr-out
     4634        (input (if available out-dtl
     4635                then recid(out-dtl)
     4636                else ?
     4637               )
     4638        ).
     4639      assign re-querybr-out = no.
     4640   end.
     4641   end.
     4642   def var sort-labelbr-ret   as character no-undo .
     4643   def var sort-clmnbr-ret    as handle    no-undo .
     4644   def var cur-clmnbr-ret     as handle    no-undo .
     4645   def var cur-clmn-locbr-ret as integer   no-undo .
     4646   def var re-querybr-ret     as logical   initial no no-undo .
     4647   on start-search, ctrl-o of br-ret in frame d-sale do:
     4648      run sort-brbr-ret
     4649        (input (if available ret-dtl
     4650                then recid(ret-dtl)
     4651                else ?
     4652               )
     4653        ).
     4654   end.
     4655   PROCEDURE sort-brbr-ret :
     4656     define input parameter p-recid as recid no-undo .
     4657     if re-querybr-ret = no then do:
     4658       assign
     4659          cur-clmnbr-ret = br-ret:current-column in frame d-sale
     4660       .
     4661       if sort-clmnbr-ret <> ? then sort-clmnbr-ret:column-fgcolor = 0.
     4662       if cur-clmnbr-ret = sort-clmnbr-ret then do:
     4663         assign
     4664            sort-labelbr-ret = ""
     4665            sort-clmnbr-ret = ?
     4666         .
     4667        end.
     4668        else do:
     4669          assign
     4670            sort-labelbr-ret = cur-clmnbr-ret:label
     4671            sort-clmnbr-ret  = cur-clmnbr-ret
     4672            sort-clmnbr-ret:column-fgcolor = 4
     4673          .
     4674        end.
     4675      end.
     4676     assign
     4677       cur-clmn-locbr-ret = 1
     4678     .
     4679     def var column-handle as handle no-undo .
     4680     column-handle = br-ret:first-column.
     4681     do while valid-handle(column-handle) :
     4682       if column-handle = cur-clmnbr-ret then do:
     4683         leave .
     4684       end.
     4685       column-handle = column-handle:NEXT-COLUMN.
     4686       assign
     4687         cur-clmn-locbr-ret = cur-clmn-locbr-ret + 1
     4688       .
     4689     end.
     4690     case sort-labelbr-ret:
     4691           when 'OK'  then DO:   assign       sort-column-name-ret = substitute('dynamic-function(&1get-ok&1, &1&2&1, ret-dtl.artic, ret-dtl.prod-type, ret-dtl.prod-code, ret-dtl.prt-code, ret-dtl.doc-qnty, ret-dtl.fact-qnty)', chr(34), v-is-tpsi-obj)     .     run OpenBr in this-procedure (input ink-doc.inkas-code, input br-2-doc-code, input yes, input no, input '':U, input 'ret':U).   . END.
     4692           when 'Бар-код'  then DO:    assign       sort-column-name-ret = "ret-bar.b-code"     .     run OpenBr in this-procedure (input ink-doc.inkas-code, input br-2-doc-code, input yes, input no, input '':U, input 'ret':U).   . END.
     4693           when 'Артикул'  then DO:    assign       sort-column-name-ret = "ret-dtl.artic"     .     run OpenBr in this-procedure (input ink-doc.inkas-code, input br-2-doc-code, input yes, input no, input '':U, input 'ret':U).   . END.
     4694           when 'Название'  then DO:   assign       sort-column-name-ret = substitute('dynamic-function(&1get-name&1, ret-prt.node-name, ret-prt.upper-code, ret-goods.prt-root, ret-goods.gds-name)', chr(34))     .     run OpenBr in this-procedure (input ink-doc.inkas-code, input br-2-doc-code, input yes, input no, input '':U, input 'ret':U).   . END.
     4695           when 'По чекам'  then DO:    assign       sort-column-name-ret = "ret-dtl.fact-qnty"     .     run OpenBr in this-procedure (input ink-doc.inkas-code, input br-2-doc-code, input yes, input no, input '':U, input 'ret':U).   . END.
     4696           when 'Зарезерв.'  then DO:    assign       sort-column-name-ret = "ret-dtl.doc-qnty"     .     run OpenBr in this-procedure (input ink-doc.inkas-code, input br-2-doc-code, input yes, input no, input '':U, input 'ret':U).   . END.
     4697           when 'Зарезерв.'  then DO:    assign       sort-column-name-ret = "v-empty"     .     run OpenBr in this-procedure (input ink-doc.inkas-code, input br-2-doc-code, input yes, input no, input '':U, input 'ret':U).   . END.
     4698           when 'Цена'  then DO:   assign       sort-column-name-ret = substitute('(if &1&2&1 = &1&3&1 then ret-dtl.price-base else ret-dtl.price-rubl)',  chr(34), v-curr-r-b, 'base':U)     .     run OpenBr in this-procedure (input ink-doc.inkas-code, input br-2-doc-code, input yes, input no, input '':U, input 'ret':U).   . END.
     4699           when 'Скидка'  then DO:   assign       sort-column-name-ret = substitute('(if &1&2&1 = &1&3&1 then ret-dtl.discnt-base else ret-dtl.discnt-rubl)', chr(34), v-curr-r-b, 'base':U)     .     run OpenBr in this-procedure (input ink-doc.inkas-code, input br-2-doc-code, input yes, input no, input '':U, input 'ret':U).   . END.
     4700           when '%'  then DO:   assign       sort-column-name-ret = substitute('dynamic-function(&1get-pcnt&1, input ret-dtl.price-base, input ret-dtl.price-rubl, input ret-dtl.discnt-base, input ret-dtl.discnt-rubl)', chr(34))     .     run OpenBr in this-procedure (input ink-doc.inkas-code, input br-2-doc-code, input yes, input no, input '':U, input 'ret':U).   . END.
     4701           when 'Изм'  then DO:    assign       sort-column-name-ret = "ret-goods.unit-base"     .     run OpenBr in this-procedure (input ink-doc.inkas-code, input br-2-doc-code, input yes, input no, input '':U, input 'ret':U).   . END.
     4702           when 'Название группы'  then DO:    assign       sort-column-name-ret = "ret-goods.grp-name"     .     run OpenBr in this-procedure (input ink-doc.inkas-code, input br-2-doc-code, input yes, input no, input '':U, input 'ret':U).   . END.
     4703           when 'Признак'  then DO:   assign       sort-column-name-ret = substitute('dynamic-function(&1get-prt-name&1, ret-prt.node-name, ret-prt.upper-code, ret-goods.prt-root, ret-prt.f-name)', chr(34))     .     run OpenBr in this-procedure (input ink-doc.inkas-code, input br-2-doc-code, input yes, input no, input '':U, input 'ret':U).   . END.
     4704           when 'Название англ.'  then DO:    assign       sort-column-name-ret = "ret-goods.engl-name"     .     run OpenBr in this-procedure (input ink-doc.inkas-code, input br-2-doc-code, input yes, input no, input '':U, input 'ret':U).   . END.
     4705       otherwise do:
