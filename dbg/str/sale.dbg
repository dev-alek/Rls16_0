     5342             input parParentProc
     5343           , input this-procedure
     5344           , input ("str/saleclos.p":U + chr(4) + "1":U +
     5345                   "1":U  + chr(4) +
     5346                   "1":U + chr(4) +
     5347                   "1":U)
     5348           , input v-parameter
     5349           , input no
     5350           , input "":U
     5351           , input substitute("Закрытие продажи &1", Ink-doc.inkas-code)
     5352       ) no-error.
     5353       if error-status:error
     5354       or return-value = "error":U
     5355       then do:
     5356          run close-error-processing in this-procedure.
     5357          return no-apply.
     5358       end.
     5359       else do:
     5360         assign
     5361         p-next-prev = ?.
     5362       end.
     5363   END.
     5364   ON CHOOSE OF b-res IN FRAME d-sale
     5365   DO:
