     1680   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1681   define NEW SHARED temp-table tt0-info no-undo
     1682   field doc-code   like ub.trn-doc.doc-code
     1683   field artic      like ub.doc-line.artic
     1684   field prod-type  like ub.doc-line.prod-type
     1685   field prod-code  like ub.doc-line.prod-code
     1686   field prt-code  like ub.gds-dtl.prt-code
     1687   field obj-type   like ub.doc-line.obj-type
     1688   field obj-code   like ub.doc-line.obj-code
     1689   field error-message as character
     1690   field a-to-res as decimal
     1691   field was-res as decimal
     1692   field to-res as decimal
     1693   field is-res as decimal
     1694   field o-was-res as decimal
     1695   field o-to-res as decimal
     1696   field o-is-res as decimal
     1697   index pi is unique primary
     1698   obj-type
     1699   obj-code
     1700   artic
     1701   prod-type
     1702   prod-code
     1703   index iartic
     1704   artic
     1705   prod-type
     1706   prod-code
     1707   .
     1708   define NEW SHARED temp-table tt0-doc-line no-undo like lib-trn_ret-line.
     1709   define NEW SHARED temp-table tt0-gds-dtl  no-undo like ub.gds-dtl.
     1710   define NEW SHARED temp-table tt0-parts    no-undo like ub.parts.
     1711   define NEW SHARED temp-table temp-tpsi-clients  no-undo like ub.clients.
     1712   FUNCTION set-tpsi-doc-PS returns character( buffer buf_sale-doc for ub.sale-doc):
     1713   define variable v-ps as character no-undo .
     1714   assign
     1715   v-PS = substitute('@&1 для закрытия продажи &2 на &3&4&5товаров &6&5признаков &7'
     1716                     , entry (lookup (buf_sale-doc.ext-doc-type, 'ee,ev,ie,es,iv':U), 'Межфирм.расход по ТПСИ,Внутр.расход по ТПСИ,Межфирм.приход по ТПСИ,Внутр.приход по ТПСИ':U)
     1717                     , buf_sale-doc.out-code
     1718                     , buf_sale-doc.obj-type
     1719                     , buf_sale-doc.obj-code
     1720                     , chr(4)
     1721                     , buf_sale-doc.tot-lines
     1722                     , buf_sale-doc.tot-dtl
     1723                     ).
     1724   return v-Ps.
     1725   END FUNCTION.
     1726   procedure create-tt0-doc-line-gds-dtl :
     1727   define input parameter p-proprietor-obj-type like ub.trn-doc.obj-type no-undo .
     1728   define input parameter p-proprietor-obj-code like ub.trn-doc.obj-code no-undo .
     1729   define input parameter p-ext-doc-type        as character no-undo .
     1730   define input parameter p-doc-code            like ub.trn-doc.doc-code no-undo .
     1731   define input parameter p-artic               like ub.gds-dtl.artic no-undo .
     1732   define input parameter p-prod-type           like ub.gds-dtl.prod-type no-undo .
     1733   define input parameter p-prod-code           like ub.gds-dtl.prod-code no-undo .
     1734   define input parameter p-prt-code            like ub.gds-dtl.prt-code  no-undo .
     1735   define input parameter p-fact-qnty           like ub.gds-dtl.fact-qnty no-undo .
     1736   define output parameter p-was-gds-dtl-doc-qnty  like ub.gds-dtl.fact-qnty no-undo .
     1737   define output parameter p-gds-dtl-fact-qnty  like ub.gds-dtl.fact-qnty no-undo .
     1738   define parameter buffer b-doc-line           for ub.doc-line.
     1739   define parameter buffer b-gds-dtl            for ub.gds-dtl.
     1740   define parameter buffer buf_sale-doc for ub.sale-doc.
     1741   define variable old-qnty like ub.doc-line.fact-qnty no-undo .
     1742   define buffer other_doc-line for ub.doc-line.
     1743   define buffer other_gds-dtl for ub.gds-dtl.
     1744     do
     1745     on error undo, return error return-value
     1746     :
     1747       find first tt0-doc-line where
     1748                 tt0-doc-line.obj-type = p-proprietor-obj-type
     1749             AND tt0-doc-line.obj-code = p-proprietor-obj-code
     1750             AND tt0-doc-line.prod-type = p-prod-type
     1751             AND tt0-doc-line.prod-code = p-prod-code
     1752             AND tt0-doc-line.artic     = p-artic
     1753             AND tt0-doc-line.ext-doc-type = p-ext-doc-type
     1754             AND tt0-doc-line.status_      = 'нередакт':U no-error .
     1755       if not available tt0-doc-line then do:
     1756         create tt0-doc-line.
     1757         buffer-copy b-doc-line
     1758         except
     1759         obj-type obj-code doc-code status_ ext-doc-type doc-qnty fact-qnty
     1760         to tt0-doc-line
     1761         assign
     1762         tt0-doc-line.status_ = 'нередакт':U
     1763         tt0-doc-line.ext-doc-type = p-ext-doc-type
     1764         tt0-doc-line.obj-type = p-proprietor-obj-type
     1765         tt0-doc-line.obj-code = p-proprietor-obj-code
     1766         tt0-doc-line.doc-code = p-doc-code
     1767         .
     1768       end.
     1769       if p-doc-code <> "":U then do:
     1770         find first other_doc-line no-lock where
     1771                 other_doc-line.doc-code = p-doc-code
     1772             AND  other_doc-line.artic    = p-artic
     1773             AND  other_doc-line.prod-type = p-prod-type
     1774             AND  other_doc-line.prod-code = p-prod-code no-error .
     1775         if available other_doc-line then do:
     1776           find first buf_sale-doc where buf_sale-doc.doc-code = other_doc-line.doc-code.
     1777           assign
     1778           tt0-doc-line.doc-qnty = other_doc-line.doc-qnty
     1779           .
     1780         end.
     1781         else do:
     1782           assign
     1783           tt0-doc-line.doc-code = '':U
     1784           .
     1785         end.
     1786       end.
     1787       find first tt0-gds-dtl where
     1788               tt0-gds-dtl.obj-type = p-proprietor-obj-type
     1789           AND tt0-gds-dtl.obj-code = p-proprietor-obj-code
     1790           AND tt0-gds-dtl.prod-type = p-prod-type
     1791           AND tt0-gds-dtl.prod-code = p-prod-code
     1792           AND tt0-gds-dtl.artic     = p-artic
     1793           AND tt0-gds-dtl.prt-code  = p-prt-code  no-error .
     1794       if not available tt0-gds-dtl then do:
     1795         create tt0-gds-dtl.
     1796         buffer-copy b-gds-dtl
     1797         except
     1798         obj-type obj-code doc-code doc-qnty fact-qnty
     1799         to tt0-gds-dtl
     1800         assign
     1801         tt0-gds-dtl.obj-type = p-proprietor-obj-type
     1802         tt0-gds-dtl.obj-code = p-proprietor-obj-code
     1803         tt0-gds-dtl.doc-code = p-doc-code
     1804         .
     1805       end.
     1806       if p-doc-code <> "":U then do:
     1807           find first other_gds-dtl no-lock where
     1808                   other_gds-dtl.doc-code = p-doc-code
     1809               AND  other_gds-dtl.artic    = p-artic
     1810               AND  other_gds-dtl.prod-type    = p-prod-type
     1811               AND  other_gds-dtl.prod-code    = p-prod-code
     1812               AND  other_gds-dtl.prt-code    = p-prt-code no-error .
     1813           if available other_gds-dtl then do:
     1814             assign
     1815             tt0-gds-dtl.doc-qnty = other_gds-dtl.doc-qnty
     1816             .
     1817           end.
     1818           else do:
     1819             assign
     1820             tt0-gds-dtl.doc-code = '':U
     1821             .
     1822           end.
     1823       end.
     1824       assign
     1825       old-qnty = tt0-gds-dtl.doc-qnty
     1826       tt0-gds-dtl.fact-qnty = (if p-fact-qnty = ? then (- old-qnty) else (p-fact-qnty - tt0-gds-dtl.doc-qnty))
     1827       tt0-doc-line.fact-qnty = tt0-doc-line.fact-qnty + (if p-fact-qnty = ? then (- old-qnty) else p-fact-qnty)
     1828       p-gds-dtl-fact-qnty = tt0-gds-dtl.fact-qnty
     1829       p-was-gds-dtl-doc-qnty = tt0-gds-dtl.doc-qnty
     1830       .
     1831     end.
     1832   end procedure.
     1833   procedure fill-tt-tpsi-table :
     1834   define input parameter p-doc-code  like ub.trn-doc.doc-code  no-undo .
     1835   define input parameter p-host-code like ub.trn-doc.host-code no-undo .
     1836   define input parameter p-obj-type  like ub.trn-doc.obj-type  no-undo .
     1837   define input parameter p-obj-code  like ub.trn-doc.obj-code  no-undo .
     1838   define variable v-proprietor-host-code      like ub.clients.host-code no-undo .
     1839   define variable v-proprietor-obj-type       like ub.clients.obj-type no-undo .
     1840   define variable v-proprietor-obj-code       like ub.clients.obj-code no-undo .
     1841   define variable v-ext-doc-type              like ub.trn-doc.ext-doc-type no-undo .
     1842   define variable v-gds-dtl-fact-qnty         like ub.gds-dtl.fact-qnty no-undo .
     1843   define variable v-was-gds-dtl-fact-qnty     like ub.gds-dtl.fact-qnty no-undo .
     1844   define buffer buf_goods for ub.goods.
     1845   define buffer buf_doc-line for ub.doc-line.
     1846   define buffer buf_gds-dtl for ub.gds-dtl.
     1847   define buffer buf_sale-doc for ub.sale-doc.
     1848     do
     1849     on error undo, return error
     1850     :
     1851       _doc-line:
     1852       for each buf_Doc-line no-lock where
     1853             buf_doc-line.doc-code = p-doc-code,
     1854         first buf_goods no-lock where
     1855             buf_goods.artic = buf_doc-line.artic
     1856        AND  buf_goods.prod-type  = buf_doc-line.prod-type
     1857        AND  buf_goods.prod-code  = buf_doc-line.prod-code,
     1858           each buf_gds-dtl no-lock where
     1859             buf_gds-dtl.doc-code = buf_doc-line.doc-code
     1860         AND  buf_gds-dtl.artic    = buf_doc-line.artic
     1861         AND  buf_gds-dtl.prod-type = buf_doc-line.prod-type
     1862         AND  buf_gds-dtl.prod-code = buf_doc-line.prod-code:
     1863         assign
     1864         v-ext-doc-type = "":U.
     1865         run tpsi-preselect-gds-proprietor in this-procedure (
     1866                                                     input buf_goods.gds-code
     1867                                                   ,input g#db-num
     1868                                                   ,output v-proprietor-host-code
     1869                                                   ,output v-proprietor-obj-type
     1870                                                   ,output v-proprietor-obj-code ) no-error .
     1871         if v-proprietor-host-code = p-host-code then do:
     1872           assign
     1873           v-ext-doc-type = 'ev':U .
     1874         end.
     1875         else do:
     1876           assign
     1877           v-ext-doc-type =  'ee':U .
     1878         end.
     1879         if  (v-proprietor-obj-type = p-obj-type
     1880         AND v-proprietor-obj-code = p-obj-code)
     1881         OR (v-proprietor-obj-type = "":U
     1882         AND v-proprietor-obj-code = 0)
     1883         OR v-proprietor-obj-code = ?
     1884         then next _doc-line.
     1885         find first buf_sale-doc no-lock where
     1886                   buf_sale-doc.inkas-code = p-doc-code
     1887              AND buf_sale-doc.obj-type = v-proprietor-obj-type
     1888              AND buf_sale-doc.obj-code = v-proprietor-obj-code
     1889              AND buf_sale-doc.ext-doc-type = v-ext-doc-type
     1890              no-error .
     1891         run create-tt0-doc-line-gds-dtl  in this-procedure (
     1892                                                              input v-proprietor-obj-type
     1893                                                             ,input v-proprietor-obj-code
     1894                                                             ,input v-ext-doc-type
     1895                                                             ,input (if available buf_sale-doc then buf_sale-doc.doc-code else "":U)
     1896                                                             ,input buf_doc-line.artic
     1897                                                             ,input buf_Doc-line.prod-type
     1898                                                             ,input buf_doc-line.prod-code
     1899                                                             ,input buf_gds-dtl.prt-code
     1900                                                             ,input 0
     1901                                                             ,output v-was-gds-dtl-fact-qnty
     1902                                                             ,output v-gds-dtl-fact-qnty
     1903                                                             ,buffer buf_doc-line
     1904                                                             ,buffer buf_gds-dtl
     1905                                                             ,buffer buf_sale-doc
     1906                                                           ).
     1907       end.
     1908     end.
     1909   end procedure.
     1910   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1911   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1912   procedure get-alias-type-price-obj :
     1913   define input parameter p-host-code like ub.sysconf.host-code no-undo .
     1914   define input parameter p-obj-type  like ub.clients.obj-type no-undo .
     1915   define input parameter p-obj-code  like ub.clients.obj-code no-undo .
     1916   define input parameter p-prop-host-code like ub.sysconf.host-code no-undo .
     1917   define input parameter p-prop-obj-type  like ub.clients.obj-type no-undo .
     1918   define input parameter p-prop-obj-code  like ub.clients.obj-code no-undo .
     1919   define output parameter p-ext-doc-type like ub.trn-doc.ext-doc-type no-undo .
     1920   define output parameter p-alias-type-price as character no-undo .
     1921   define output parameter p-price-obj-type like ub.clients.obj-type no-undo .
     1922   define output parameter p-price-obj-code like ub.clients.obj-code no-undo .
     1923   define variable v-mediat-obj-type           like ub.trn-doc.obj-type no-undo .
     1924   define variable v-mediat-obj-code           like ub.trn-doc.obj-code no-undo .
     1925   define variable v-mediat-objf               as character no-undo .
     1926   define variable v-param-type as character no-undo .
     1927   define variable v-value-character as character no-undo .
     1928   define variable v-value-date as date no-undo .
     1929   define variable v-value-decimal as decimal no-undo .
     1930   define variable v-value-integer as INTEGER no-undo .
     1931   define variable v-value-logical AS LOGICAL no-undo .
     1932   define variable v-tth as handle no-undo .
     1933   assign
     1934   v-tth = buffer thbjattr_thbj-attr:table-handle .
     1935   define buffer buf_trn-doc for ub.trn-doc.
     1936     _main:
     1937     do
     1938     on error undo, return error return-value
     1939     :
     1940       run adm/shattri.p (
     1941         input "get":U
     1942         ,input  p-prop-obj-type
     1943         ,input  p-prop-obj-code
     1944         ,input  'alias-tpsi':U
     1945         ,input  '':U
     1946         ,output v-value-character
     1947         ,output v-value-date
     1948         ,output v-value-decimal
     1949         ,output v-value-integer
     1950         ,output v-value-logical
     1951         ,output v-param-type
     1952         ,INPUT-OUTPUT table-handle v-tth
     1953         ) no-error .
     1954       if error-status:error
     1955       then do:
     1956         undo _main, return error substitute("Не удалось определить настройки МЕЖФИРМЕННОГО ИЛИ ВНУТРЕННЕГО ПЕРЕМЕЩЕНИЯ ЧУЖИХ ТОВАРОВ для &1&2"
     1957                                 , p-prop-obj-type
     1958                                 , p-prop-obj-code).
     1959       end.
     1960       find first thbjattr_thbj-attr where
     1961                 thbjattr_thbj-attr.obj-type = p-prop-obj-type
     1962             and thbjattr_thbj-attr.obj-code = p-prop-obj-code
     1963             and thbjattr_thbj-attr.upper-prop-code = 'alias-tpsi':U
     1964             and thbjattr_thbj-attr.prop-code = 'alias-type-price':U no-error.
     1965       if not available thbjattr_thbj-attr
     1966       or thbjattr_thbj-attr.property-value-integer = 0 then do:
     1967         undo _main, return error substitute("Не задано значение атрибута ТИП ЦЕНЫ МЕЖФИРМЕННОГО ИЛИ ВНУТРЕННЕГО ПЕРЕМЕЩЕНИЯ ЧУЖИХ ТОВАРОВ для &1&2"
     1968                                 , p-prop-obj-type
     1969                                 , p-prop-obj-code).
     1970       end.
     1971       assign
     1972       p-alias-type-price = string(thbjattr_thbj-attr.property-value-integer).
     1973       if p-prop-host-code = p-host-code
     1974       and (p-alias-type-price = '':U
     1975       or   p-alias-type-price <> '5':U)
     1976       then  do:
     1977         assign
     1978         p-ext-doc-type = 'ev':U
     1979         p-price-obj-type = p-obj-type
     1980         p-price-obj-code = p-obj-code
     1981         p-alias-type-price = '3':U
     1982         .
     1983       end.
     1984       else do:
     1985         if p-prop-host-code = p-host-code  then do:
     1986           assign
     1987           p-ext-doc-type = 'ev':U
     1988           p-price-obj-type = p-obj-type
     1989           p-price-obj-code = p-obj-code
     1990           .
     1991         end.
     1992         else do:
     1993           assign
     1994           p-ext-doc-type = 'ee':U.
     1995           assign
     1996           v-mediat-obj-type = "":U
     1997           v-mediat-obj-code = 0
     1998           v-mediat-objf = "":U
     1999           .
     2000           if p-alias-type-price = '4':U then do:
     2001             find first thbjattr_thbj-attr where
     2002                       thbjattr_thbj-attr.obj-type = p-prop-obj-type
     2003                   and thbjattr_thbj-attr.obj-code = p-prop-obj-code
     2004                   and thbjattr_thbj-attr.upper-prop-code = 'alias-tpsi':U
     2005                   and thbjattr_thbj-attr.prop-code = 'alias-object-price':U no-error.
     2006             if not available thbjattr_thbj-attr
     2007             or thbjattr_thbj-attr.property-value-character = "":U then do:
     2008               undo _main, return error substitute("Не найден объект-посредник для межфирменного перемещения ЧУЖИХ товаров с &1&2"
     2009                                       , p-prop-obj-type
     2010                                       , p-prop-obj-code).
     2011             end.
     2012             assign
     2013             v-mediat-objf     = thbjattr_thbj-attr.property-value-character
     2014             v-mediat-obj-type = entry(1, v-mediat-objf)
     2015             v-mediat-obj-code = integer(entry(2, v-mediat-objf))
     2016             no-error
     2017             .
     2018             if error-status:error then do:
     2019               undo _main, return error substitute("Неверный формат атрибута ОБЪЕКТ-ПОСРЕДНИК для межфирменного перемещения ЧУЖИХ товаров для &1&2"
     2020                                       , p-prop-obj-type
     2021                                       , p-prop-obj-code).
     2022             end.
     2023           end.
     2024           CASE p-alias-type-price:
     2025             when '1':U then do:
     2026               assign
     2027               p-price-obj-type = p-prop-obj-type
     2028               p-price-obj-code = p-prop-obj-code
     2029               .
     2030             end.
     2031             when '2':U then do:
     2032               assign
     2033               p-price-obj-type = p-prop-obj-type
     2034               p-price-obj-code = p-prop-obj-code
     2035               .
     2036             end.
     2037             when '3':U
     2038             or
     2039             when '5':U
     2040             then do:
     2041               assign
     2042               p-price-obj-type = p-obj-type
     2043               p-price-obj-code = p-obj-code
     2044               .
     2045             end.
     2046             when '4':U then do:
     2047               assign
     2048               p-price-obj-type = v-mediat-obj-type
     2049               p-price-obj-code = v-mediat-obj-code
     2050               .
     2051             end.
     2052           END CASE.
     2053         end.
     2054       end.
     2055     end.
     2056   end procedure.
     2057   procedure write-tt0-info:
     2058   define input parameter p-artic as character no-undo .
     2059   define input parameter p-prod-type as character no-undo .
     2060   define input parameter p-prod-code as integer no-undo .
     2061   define input parameter p-prt-code as integer no-undo .
     2062   define input parameter p-obj-type as character no-undo .
     2063   define input parameter p-obj-code as integer no-undo .
     2064   define input parameter p-doc-code as character no-undo .
     2065   define input parameter p-from-tpsi as logical no-undo .
     2066   define input parameter p-all-qnty as decimal no-undo .
     2067   define input parameter p-was-res as decimal no-undo .
     2068   define input parameter p-to-res as decimal no-undo .
     2069   define input parameter p-is-res as decimal no-undo .
     2070   define input parameter p-o-was-res as decimal no-undo .
     2071   define input parameter p-o-to-res as decimal no-undo .
     2072   define input parameter p-o-is-res as decimal no-undo .
     2073   define input parameter p-mess   as character no-undo .
     2074   define buffer buf_tt0-info for tt0-info.
     2075     do
     2076     on error undo, return error return-value
     2077     :
     2078       find first buf_tt0-info where
     2079                buf_tt0-info.artic = p-artic
     2080            and buf_tt0-info.prod-type = p-prod-type
     2081            and buf_tt0-info.prod-code = p-prod-code
     2082            and buf_tt0-info.prt-code = p-prt-code
     2083            no-error .
     2084       if not available buf_tt0-info then do:
     2085         create buf_tt0-info.
     2086         assign
     2087         buf_tt0-info.artic = p-artic
     2088         buf_tt0-info.prod-type = p-prod-type
     2089         buf_tt0-info.prod-code = p-prod-code
     2090         buf_tt0-info.prt-code  = p-prt-code
     2091         buf_tt0-info.obj-type  = p-obj-type
     2092         buf_tt0-info.obj-code  = p-obj-code
     2093         buf_tt0-info.a-to-res  = ?
     2094         buf_tt0-info.to-res    = ?
     2095         buf_tt0-info.was-res   = ?
     2096         buf_tt0-info.o-was-res = ?
     2097         buf_tt0-info.o-to-res  = ?
     2098         buf_tt0-info.o-is-res  = ?
     2099         buf_tt0-info.is-res    = ?
     2100         .
     2101       end.
     2102       assign
     2103       buf_tt0-info.a-to-res  =
     2104                                 (if buf_tt0-info.a-to-res <> ?
     2105                                 and p-all-qnty = ?
     2106                                 then buf_tt0-info.a-to-res
     2107                                 else p-all-qnty)
     2108       buf_tt0-info.was-res   = (if buf_tt0-info.was-res <> ?
     2109                                 and p-was-res = ?
     2110                                 then buf_tt0-info.was-res
     2111                                 else p-was-res)
     2112       buf_tt0-info.to-res    = (if buf_tt0-info.to-res <> ?
     2113                                 and p-to-res = ?
     2114                                 then buf_tt0-info.to-res
     2115                                 else p-to-res)
     2116       buf_tt0-info.is-res    = (if buf_tt0-info.is-res <> ?
     2117                                 and p-is-res = ?
     2118                                 then buf_tt0-info.is-res
     2119                                 else p-is-res)
     2120       buf_tt0-info.o-was-res   = (if buf_tt0-info.o-was-res <> ?
     2121                                 and p-o-was-res = ?
     2122                                 then buf_tt0-info.o-was-res
     2123                                 else p-o-was-res)
     2124       buf_tt0-info.o-to-res    = (if buf_tt0-info.o-to-res <> ?
     2125                                 and p-o-to-res = ?
     2126                                 then buf_tt0-info.o-to-res
     2127                                 else p-o-to-res)
     2128       buf_tt0-info.o-is-res    = (if buf_tt0-info.o-is-res <> ?
     2129                                 and p-o-is-res = ?
     2130                                 then buf_tt0-info.o-is-res
     2131                                 else p-o-is-res)
     2132       .
     2133       assign
     2134       buf_tt0-info.doc-code  = p-doc-code
     2135       buf_tt0-info.error-message   = p-mess
     2136       .
     2137     end.
     2138   end procedure.
