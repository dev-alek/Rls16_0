     2477   procedure tpsi-gds-fill-tpsi-obj-table :
     2478   define input parameter p-db-num like ub.db.db-num no-undo .
     2479   define variable v-is-tpsi-obj as logical no-undo .
     2480   define buffer buf_clients for ub.clients.
     2481     do
     2482     on error undo, return error return-value
     2483     :
     2484       for each temp-tpsi-clients :
     2485         delete temp-tpsi-clients.
     2486       end.
     2487       _clients:
     2488       for each buf_clients no-lock where
     2489             buf_clients.db-num = p-db-num:
     2490         assign
     2491         v-is-tpsi-obj = no.
     2492         run gbl/tpsi-obj.p (
     2493                         input buf_clients.obj-type
     2494                       ,input buf_clients.obj-code
     2495                       ,output v-is-tpsi-obj) .
     2496         if not v-is-tpsi-obj then NEXT _clients.
     2497         create temp-tpsi-clients.
     2498         buffer-copy
     2499         buf_clients to
     2500         temp-tpsi-clients.
     2501       end.
     2502     end.
     2503   end procedure.
     2504   procedure tpsi-gds-proprietor :
     2505   define input parameter p-gds-code like ub.goods.gds-code no-undo .
     2506   define input parameter p-db-num   like ub.db.db-num      no-undo .
     2507   define output parameter p-proprietor-host-code like ub.clients.host-code no-undo .
     2508   define output parameter p-proprietor-obj-type like ub.clients.obj-type no-undo .
     2509   define output parameter p-proprietor-obj-code like ub.clients.obj-code no-undo .
     2510   define variable v-is-tpsi-obj as logical no-undo .
     2511   do
     2512   on error undo, return error return-value
     2513   :
     2514       define buffer buf_clients for ub.clients.
     2515       define buffer buf_gds-obj-attr for ub.gds-obj-attr.
     2516       assign
     2517       p-proprietor-obj-type = "":U
     2518       p-proprietor-obj-code = ?
     2519       p-proprietor-host-code = ?
     2520       .
     2521       _gds-obj-attr:
     2522       for each buf_clients no-lock where
     2523               buf_clients.db-num = p-db-num,
     2524         each buf_gds-obj-attr no-lock where
     2525             buf_gds-obj-attr.obj-type = buf_Clients.obj-type
     2526         AND buf_gds-obj-attr.obj-code = buf_clients.obj-code
     2527         AND buf_gds-obj-attr.gds-code = p-gds-code
     2528         AND buf_gds-obj-attr.attr-code = 'proprietor':U:
     2529         if logical(buf_gds-obj-attr.attr-value) = yes then do:
     2530           assign
     2531           v-is-tpsi-obj = no.
     2532           run gbl/tpsi-obj.p (
     2533                           input buf_gds-obj-attr.obj-type
     2534                         ,input buf_gds-obj-attr.obj-code
     2535                         ,output v-is-tpsi-obj) .
     2536           if not v-is-tpsi-obj then NEXT _gds-obj-attr.
     2537           assign
     2538           p-proprietor-obj-type = buf_gds-obj-attr.obj-type
     2539           p-proprietor-obj-code = buf_gds-obj-attr.obj-code
     2540           p-proprietor-host-code = buf_clients.host-code
     2541           .
     2542           LEAVE.
     2543         end.
     2544       end.
     2545   end.
     2546   end procedure.
     2547   procedure tpsi-preselect-gds-proprietor :
     2548   define input parameter p-gds-code like ub.goods.gds-code no-undo .
     2549   define input parameter p-db-num   like ub.db.db-num      no-undo .
     2550   define output parameter p-proprietor-host-code like ub.clients.host-code no-undo .
     2551   define output parameter p-proprietor-obj-type like ub.clients.obj-type no-undo .
     2552   define output parameter p-proprietor-obj-code like ub.clients.obj-code no-undo .
     2553   do
     2554   on error undo, return error return-value
     2555   :
     2556       define buffer buf_clients for ub.clients.
     2557       define buffer buf_gds-obj-attr for ub.gds-obj-attr.
     2558       assign
     2559       p-proprietor-obj-type = "":U
     2560       p-proprietor-obj-code = ?
     2561       p-proprietor-host-code = ?
     2562       .
     2563       _gds-obj-attr:
     2564       for each temp-tpsi-clients no-lock where
     2565               temp-tpsi-clients.db-num = p-db-num,
     2566         each buf_gds-obj-attr no-lock where
     2567             buf_gds-obj-attr.obj-type = temp-tpsi-clients.obj-type
     2568         AND buf_gds-obj-attr.obj-code = temp-tpsi-clients.obj-code
     2569         AND buf_gds-obj-attr.gds-code = p-gds-code
     2570         AND buf_gds-obj-attr.attr-code = 'proprietor':U:
     2571         if logical(buf_gds-obj-attr.attr-value) = yes then do:
     2572           assign
     2573           p-proprietor-obj-type = buf_gds-obj-attr.obj-type
     2574           p-proprietor-obj-code = buf_gds-obj-attr.obj-code
     2575           p-proprietor-host-code = temp-tpsi-clients.host-code
     2576           .
     2577           LEAVE.
     2578         end.
     2579       end.
     2580   end.
     2581   end procedure.
     2582   procedure proc-alt-shift-f2:
     2583     if not ibs.th.gbl.gbl-var:rcode
     2584   then
     2585     run gbl\inidebug.p .
     2586   end.
     2587   procedure proc-alt-shift-f3:
     2588     run gbl/prvssinf.p
     2589       ( input this-procedure
     2590       ) .
     2591   end.
     2592   define variable v-inform-launched as logical no-undo initial false .
     2593   procedure proc-alt-shift-f4:
     2594     define variable v-action as character no-undo .
     2595     if v-inform-launched = false then do:
     2596       assign
     2597         v-inform-launched = true
     2598       .
     2599       run gbl/d-inform.w
     2600         (  input self
     2601         ,  input this-procedure
     2602         , output v-action
     2603         ) no-error .
     2604       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     2605       assign
     2606         v-inform-launched = false
     2607       .
     2608     end.
     2609   end.
     2610   procedure proc-alt-f1:
     2611     run gbl/corrhelp.p
     2612       (input this-procedure
     2613       ) .
     2614   end .
     2615   on alt-shift-f2 anywhere do:
     2616     run proc-alt-shift-f2.
     2617   end.
     2618   on alt-shift-f3 anywhere do:
     2619     run proc-alt-shift-f3 in this-procedure .
     2620   end.
     2621   on alt-shift-f4 anywhere do:
     2622     run proc-alt-shift-f4 in this-procedure.
     2623   end.
     2624   on alt-f1 anywhere do:
     2625     run proc-alt-f1 in this-procedure .
     2626   end.
