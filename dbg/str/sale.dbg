     5323                         ink-doc.inkas-code             + chr(4) +
     5324                       string(0)              + chr(4) +
     5325                       string(auto-close)               + chr(4) +
     5326                       string(b-mail-pressed)           + chr(4) +
     5327                       string(auto-comp)                + chr(4) +
     5328                       string(auto-fbr)                 + chr(4) +
     5329                       string(one-curs)                 + chr(4) +
     5330                       string(ub.shop.is-catering)      + chr(4) +
     5331                       string(v-is-tpsi-obj)            + chr(4) +
     5332                       string(rest-dish)                + chr(4) +
     5333                       string(rest-ingr)                + chr(4) +
     5334                       string(rest-tpsi)                + chr(4) +
     5335                       string(neg-tpsi-weight)          + chr(4) +
