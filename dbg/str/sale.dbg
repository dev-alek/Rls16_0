     9511   define buffer buf_goods    for ub.goods.
     9512   define buffer buf_inkas-pay for ub.inkas-pay.
     9513   define buffer buf_inkas-pay-desk for ub.inkas-pay-desk.
     9514   define buffer buf_sale-doc for ub.sale-doc.
     9515   if buf_trn-doc.status_ = 'запрос':U then do:
     9516   end.
     9517   else do:
     9518       run waitfram-show in this-procedure ("Проверка товаров продажи на присутствие в незакрытой инвентаризации..." ).
     9519     _buf_sale-doc:
     9520     for each buf_sale-doc where
     9521             buf_sale-doc.inkas-code = p-inkas-code
     9522         and buf_sale-doc.order > 0
     9523       on error undo _buf_sale-doc, next _buf_sale-doc:
     9524       if buf_sale-doc.in-inkas = yes
     9525       and buf_sale-doc.dir = 1 then do:
     9526          assign
     9527          v-inkas-qnty-r = v-inkas-qnty-r + buf_sale-doc.fact-qnty.
     9528       end.
     9529       if buf_sale-doc.in-inkas = yes
     9530       and buf_sale-doc.dir = -1 then do:
     9531          assign
     9532          v-inkas-qnty-v = v-inkas-qnty-v + buf_sale-doc.fact-qnty.
     9533       end.
     9534       if buf_sale-doc.doc-kind = 'rwo':U then next _buf_sale-doc.
     9535       if r-or-v <> ?
     9536       and (buf_sale-doc.doc-kind <> r-or-v
     9537            or
     9538            buf_sale-doc.chr-office <> r-office
     9539             ) then NEXT _buf_sale-doc.
     9540       _buf_doc-line:
     9541       FOR EACH buf_doc-line WHERE
     9542               buf_doc-line.doc-code = buf_sale-doc.doc-code
     9543           AND (rdoc-line = ? or recid(buf_doc-line) = rdoc-line) NO-LOCK :
     9544   define variable vss-include-info63 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9545   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjat in g#library
     9546     (input  buf_doc-line.obj-type
     9547     ,input  buf_doc-line.obj-code
     9548     ,input  buf_doc-line.artic
     9549     ,input  buf_doc-line.prod-type
     9550     ,input  buf_doc-line.prod-code
     9551     ,input  'inv-on=request'
     9552     ,output l-inv-on
     9553     ) no-error .
     9554         if error-status :error then do:
     9555           undo, return error substitute("&1 &2 &3 Ошибка получения признака товара на объекте:&4&5 &6"
     9556                                         ,vss-workfile
     9557                                         ,vss-revision
     9558                                         ,vss-description
     9559                                         , chr(10)
     9560                                         , error-status:error
     9561                                         , return-value
     9562                                           ).
     9563         end.
     9564         if l-inv-on then do:
     9565           FIND FIRST buf_goods WHERE
     9566                     buf_doc-line.prod-type = buf_goods.prod-type
     9567                 and buf_doc-line.prod-code = buf_goods.prod-code
     9568                 and buf_doc-line.artic = buf_goods.artic NO-LOCK .
     9569           run waitfram-hide in this-procedure .
     9570             MESSAGE substitute("Артикул :&1 &2- товар в инвентаризации.&3&3" +                   (if p-auto = 0 then "Резервирование и/или закрытие отчета невозможно" else "":U)                                   ,buf_doc-line.artic                                                            ,buf_goods.gds-name                                                            , chr(10)) view-as alert-box.
     9571           if p-auto = 0 then do:
     9572             undo, return error.
     9573           end.
     9574           else do:
     9575             assign
     9576             v-in-inv = yes
     9577             .
     9578           end.
     9579         end.
     9580       END.
     9581     end.
     9582     if v-in-inv then do:
     9583           undo,  return error substitute("Имеются товары в инвентаризации.&2&2Закрытие отчета невозможно."
     9584                                   , chr(10)).
     9585     end.
     9586     run waitfram-hide in this-procedure .
     9587   end.
     9588   run waitfram-show in this-procedure ("Сравнение сумм по товарам и выручке......" ).
     9589   assign
     9590   accum-inkas-pay-tot-r-b = 0
     9591   .
     9592   FOR EACH buf_inkas-pay WHERE
     9593            buf_inkas-pay.inkas-code = buf_inkas.inkas-code NO-LOCK
     9594   :
     9595     accum-inkas-pay-tot-r-b = accum-inkas-pay-tot-r-b + (if v-curr-r-b = 'base':U
     9596                                                          then buf_inkas-pay.tot-base
     9597                                                          else buf_inkas-pay.tot-rubl)
     9598                                                          .
     9599     accum-inkas-pay-desk-tot-r-b = 0.
     9600     FOR EACH buf_inkas-pay-desk WHERE
     9601              buf_inkas-pay-desk.inkas-code = buf_inkas.inkas-code AND
     9602              buf_inkas-pay-desk.pay-code   = buf_inkas-pay.pay-code AND
     9603              buf_inkas-pay-desk.curr-code  = buf_inkas-pay.curr-code NO-LOCK
     9604     :
     9605         accum-inkas-pay-desk-tot-r-b = accum-inkas-pay-desk-tot-r-b +
     9606                                        (if v-curr-r-b = 'base':U
     9607                                         then buf_inkas-pay-desk.tot-base
     9608                                         else buf_inkas-pay-desk.tot-rubl).
     9609     END .
     9610     if (v-curr-r-b = 'base':U and abs( buf_inkas-pay.tot-base -  accum-inkas-pay-desk-tot-r-b ) > 0.015)
     9611     OR (v-curr-r-b = 'rubl':U and abs( buf_inkas-pay.tot-rubl -  accum-inkas-pay-desk-tot-r-b ) > 0.015)
     9612     then do:
     9613       run waitfram-hide in this-procedure .
     9614       undo, return error substitute("&1 Ошибка оплат по чекам&2По оплатам &3&2По оплатам по кассе &4"
     9615                               , vss-description
     9616                               , chr(10)
     9617                               , (if v-curr-r-b = 'base':U then buf_inkas-pay.tot-base else buf_inkas-pay.tot-rubl )
     9618                               , accum-inkas-pay-desk-tot-r-b).
     9619     end.
     9620   END .
     9621   if abs( buf_inkas.netto -  accum-inkas-pay-tot-r-b ) > 0.015 then do:
     9622     run waitfram-hide in this-procedure .
     9623     undo, return error substitute("&1 Ошибка оплат по чекам&2По отчету &3&2По оплатам &4"
     9624                             , vss-description
     9625                             , chr(10)
     9626                             , buf_inkas.netto
     9627                             , accum-inkas-pay-tot-r-b).
     9628   end.
     9629   if buf_inkas.qnty <> v-inkas-qnty-r - v-inkas-qnty-v then do:
     9630     run waitfram-hide in this-procedure .
     9631     undo, return error substitute("&1 Несоответствие накладных и документа продажи&2" +
     9632                              "Количество товара в продаже &3&2"  +
     9633                              "Количество товара в расходной накладной &4&2" +
     9634                              "Количество товара в возвратной накладной &5&2"
     9635                              ,vss-description
     9636                              , chr(10)
     9637                              , buf_inkas.qnty
     9638                              , v-inkas-qnty-r
     9639                              , v-inkas-qnty-v).
     9640   end.
     9641   run waitfram-hide in this-procedure .
     9642   END PROCEDURE.
     9643   PROCEDURE neg-rests:
     9644   define input parameter from-close as logical.
     9645   define input parameter p-status_ like ub.inkas.status_ no-undo .
     9646   define input parameter p-inkas-code like ub.inkas.inkas-code no-undo .
     9647   define input parameter p-mode       as character no-undo .
     9648   define input parameter p-is-catering as logical no-undo .
     9649   define input parameter p-is-tpsi-obj  as logical no-undo .
     9650   define input parameter p-neg-tpsi-weight as logical no-undo .
     9651   define input parameter p-neg-tpsi-qnty as decimal no-undo .
     9652   define input parameter p-neg-tpsi-oper as logical no-undo .
     9653   run waitfram-show in this-procedure ("Проверка возможности появления недопустимых отрицательных остатков..." ).
     9654   if not p-mode = 'ПРОСМОТР':U then do:
     9655     run str/dtlrests.p (
     9656                    input p-inkas-code
     9657                   ,input from-close
     9658                   ,input "all":U
     9659                   ,input no
     9660                   ,input p-is-catering
     9661                   ,input p-is-tpsi-obj
     9662                   ,input p-neg-tpsi-weight
     9663                   ,input p-neg-tpsi-qnty
     9664                   ,input p-neg-tpsi-oper
     9665                   ).
     9666     if not from-close then do:
     9667       for each dtl-rests :
     9668         if p-status_ <> 'факт':U
     9669         and p-mode = 'ИЗМЕНЕНИЕ':U
     9670         and p-is-tpsi-obj
     9671         and dtl-rests.is-neg-tpsi-oper then do:
     9672           find first dtl-rests-mark where
     9673                     dtl-rests-mark.artic = dtl-rests.artic
     9674                 and dtl-rests-mark.prod-type = dtl-rests.prod-type
     9675                 and dtl-rests-mark.prod-code = dtl-rests.prod-code no-error .
     9676           if not available dtl-rests-mark then do:
     9677             create dtl-rests-mark.
     9678             buffer-copy dtl-rests to dtl-rests-mark.
     9679             release dtl-rests-mark.
     9680           end.
     9681         end.
     9682         if dtl-rests.OK then delete dtl-rests.
     9683       end.
     9684     end.
     9685   end.
     9686   run waitfram-hide in this-procedure .
     9687   END PROCEDURE.
     9688   PROCEDURE b-res-proc:
     9689   define parameter buffer buf_inkas for ub.inkas.
