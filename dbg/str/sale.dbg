     9374           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     9375         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     9376         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     9377         if transport-base-loc = ? then transport-base-loc = 0.
     9378         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     9379         if other-base-loc     = ? then other-base-loc     = 0.
     9380         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     9381         assign
     9382           transport-cli-loc      = 0
     9383           other-cli-loc          = 0
     9384           road-tax-cli-loc       = ?
     9385           vat-cli-loc            = ?
     9386           slt-cli-loc            = ?
     9387           price-cli-with-tax-loc = ?.
     9388      end.
     9389   ASSIGN
     9390             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     9391       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     9392   .
     9393           assign
     9394           b-doc-line.road-tax = (if v-curr-r-b = 'rubl':U
     9395                                   then road-tax-rubl-loc
     9396                                   else road-tax-base-loc).
     9397         end.
     9398         if rz then do:
     9399           if b-trn-doc.print-rubl
     9400           then assign
     9401                 loc-gds-dtl.price-base = loc-gds-dtl.price-rubl / b-trn-doc.base-rate * b-trn-doc.base-scale
     9402                 loc-gds-dtl.discnt-base = loc-gds-dtl.discnt-rubl / b-trn-doc.base-rate * b-trn-doc.base-scale
     9403                 loc-gds-dtl.discnt-pc = (if loc-gds-dtl.price-rubl = 0
     9404                                          then 0
     9405                                          else loc-gds-dtl.discnt-rubl * 100 / loc-gds-dtl.price-rubl) .
     9406           else assign
     9407               loc-gds-dtl.price-rubl = loc-gds-dtl.price-base * b-trn-doc.base-rate / b-trn-doc.base-scale
     9408               loc-gds-dtl.discnt-rubl = loc-gds-dtl.discnt-base * b-trn-doc.base-rate / b-trn-doc.base-scale
     9409               loc-gds-dtl.discnt-pc = (if loc-gds-dtl.price-base = 0
     9410                                       then 0
     9411                                       else loc-gds-dtl.discnt-base * 100 / loc-gds-dtl.price-base) .
     9412         end.
     9413         if (not v-is-own and res-qnty = 0)
     9414         or (not rz and (loc-gds-dtl.doc-qnty = 0  and res-qnty = 0) and p-tpsi-obj)
     9415           then do:
     9416         end.
     9417         if chg-qnty = res-qnty and chg-qnty <> 0
     9418         AND parts-OK
     9419         AND (v-is-own
     9420             OR ((not v-is-own)
     9421                 and v-to-reserv
     9422                 and (
     9423                      ((loc-gds-dtl.doc-qnty = loc-gds-dtl.fact-qnty) and (rz))
     9424                      OR
