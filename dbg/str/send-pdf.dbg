     4743   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4744   PROCEDURE cd-mrkt_plu-marketer :
     4745   define input parameter p-silence as logical no-undo .
     4746   define parameter buffer buf_cash-desk for ub.cash-desk.
     4747   define input parameter p-id as character no-undo .
     4748   define input parameter p-b-code like ub.bar-code.b-code no-undo .
     4749   define input parameter p-b-str like ub.prod-bc.b-str no-undo .
     4750   define input parameter p-loc-ean as logical no-undo .
     4751   define input parameter p-is-petrolium as logical no-undo .
     4752   define input parameter p-extra as character no-undo .
     4753   define variable v-tot-gds as integer no-undo .
     4754   define variable v-max-gds as integer no-undo .
     4755   define variable v-petrol-start as integer no-undo .
     4756   define variable v-petrol-range as integer no-undo .
     4757   DEFINE VARIABLE v-today as date no-undo .
     4758   DEFINE VARIABLE v-time as integer no-undo .
     4759   define variable v-plu-type as character no-undo .
     4760   define variable v-int as integer no-undo .
     4761   define buffer  buf_cd-plu for ub.cd-plu.
     4762   define buffer  loc_cd-plu for ub.cd-plu.
     4763   define variable  ii as integer no-undo.
     4764   define variable v-mes as character no-undo .
     4765   _main:
     4766   DO ON ERROR undo, leave on stop undo, leave:
     4767     if buf_cash-desk.pos-type <> 'MARIA':U
     4768     or buf_cash-desk.cash-num <> 0 then do:
     4769       assign
     4770       v-mes =
     4771       substitute("Товары на кассах можно определять только для кассовых менеджеров (номер кассы = 0) для типов касс &1"
     4772                 , buf_cash-desk.pos-type).
     4773       if not p-silence then
     4774       message
     4775       v-mes
     4776       view-as alert-box error .
     4777       return error v-mes.
     4778     end.
     4779     v-tot-gds = cd-attr_get-attr-int(buffer buf_cash-desk
     4780                                     ,input 'MARIA_operative':U
     4781                                     ,input (if buf_cash-desk.pos-type = 'MARIA':U
     4782                                           and p-is-petrolium
     4783                                           then 'tot-petrol':U
     4784                                           else 'tot-gds':U)
     4785                                     , output v-mes).
     4786     if v-tot-gds = ? then undo _main, return error v-mes.
     4787     v-max-gds = cd-attr_get-attr-int(buffer buf_cash-desk
     4788                                     ,input 'MARIA_general':U
     4789                                     ,input 'max-gds':U
     4790                                     ,output v-mes).
     4791     if v-max-gds = ? then undo _main, return error v-mes.
     4792     v-petrol-range = cd-attr_get-attr-int(buffer buf_cash-desk
     4793                                          ,input 'petrolium-range':U
     4794                                          ,input 'petrolium-range':U
     4795                                          ,output v-mes).
     4796     if v-petrol-range = ? then undo _main, return error v-mes.
     4797     if buf_cash-desk.pos-type = 'MARIA':U then do:
     4798       assign
     4799       v-petrol-start = 1
     4800       v-max-gds = (if p-is-petrolium
     4801                    then v-petrol-range
     4802                    else v-max-gds)
     4803       v-plu-type = (if p-is-petrolium
     4804                  then 'топ':U
     4805                  else '':U)
     4806       .
     4807       if p-is-petrolium then do:
     4808         if p-id = '':U then do:
     4809           v-mes = substitute( "Топливо с кодом &1 не привязано к складскому месту&2" +
     4810                               "Невозможно привязать к кассе типа &3"
     4811                               , p-b-str
     4812                               , chr(10)
     4813                               , 'MARIA':U).
     4814           if not p-silence then
     4815           message
     4816           v-mes
     4817           view-as alert-box error .
     4818           return error v-mes.
     4819         end.
     4820         assign
     4821         v-int = integer(p-id)
     4822         no-error
     4823         .
     4824         if error-status:error
     4825         or v-int > v-petrol-range then do:
     4826           v-mes = substitute( "№ резервуара &1 для топлива с кодом &1 не укладывается&3" +
     4827                               "в диапазоны номеров резервуаров для кассы типа &4"
     4828                               , p-id
     4829                               , p-b-str
     4830                               , chr(10)
     4831                               , 'MARIA':U).
     4832           if not p-silence then
     4833           message
     4834           v-mes
     4835           view-as alert-box error .
     4836           return error v-mes.
     4837         end.
     4838       end.
     4839     end.
     4840     if buf_cash-desk.pos-type = 'MARIA':U
     4841     and p-is-petrolium then do:
     4842       find first loc_cd-plu where
     4843                loc_cd-plu.obj-type = 'маг':U
     4844            and loc_cd-plu.obj-code = buf_cash-desk.obj-code
     4845            and loc_cd-plu.pos-type = buf_cash-desk.pos-type
     4846            and loc_cd-plu.plu-type = 'топ':U
     4847      no-error .
     4848      if available loc_cd-plu then do:
     4849        if loc_cd-plu.b-code = p-b-code
     4850        and loc_cd-plu.b-str = p-b-str then do:
     4851           v-mes = substitute( "№ резервуара &1 на кассе УЖЕ привязан к топливу с кодом &1,&3"
     4852                               , p-id
     4853                               , p-b-str
     4854                               , chr(10)
     4855                               ).
     4856           if not p-silence then
     4857           message
     4858           v-mes
     4859           view-as alert-box WARNING .
     4860           return v-mes.
     4861        end.
     4862        else do:
     4863           v-mes = substitute( "№ резервуара &1 на кассе привязан к топливу с кодом &1,&3" +
     4864                               "нельзя его привязать к топливу &2&3"
     4865                               , p-id
     4866                               , loc_cd-plu.b-str
     4867                               , chr(10)
     4868                               , p-b-str).
     4869           if not p-silence then
     4870           message
     4871           v-mes
     4872           view-as alert-box error .
     4873           return error v-mes.
     4874        end.
     4875      end.
     4876      ii = v-int.
     4877     end.
     4878     else do:
     4879       DO ii = (if p-is-petrolium
     4880               then v-petrol-start
     4881               else (if buf_cash-desk.pos-type = 'MARIA':U
     4882                    then 1
     4883                    else (if v-petrol-start = 1
     4884                           then (v-petrol-range + 1)
     4885                           else 1)
     4886                   )
     4887               )
     4888         to v-max-gds :
     4889         if not can-find (loc_cd-plu where
     4890                         loc_cd-plu.obj-type = 'маг':U
     4891                      and loc_cd-plu.obj-code =  buf_Cash-desk.obj-code
     4892                      and loc_cd-plu.pos-type = buf_Cash-desk.pos-type
     4893                      and loc_cd-plu.plu-type = v-plu-type
     4894                      and loc_cd-plu.plu-code = ii
     4895                       )
     4896         then LEAVE .
     4897       END .
     4898     end.
     4899     if ii > v-max-gds then do:
     4900         if not p-silence then
     4901         message
     4902         substitute("Превышено максимально допустимое количество &5 &1" +
     4903                   "для касс &2 &3&4"
     4904                   , chr(10)
     4905                   , v-max-gds
     4906                   , 'маг':U
     4907                   , buf_cash-desk.obj-code
     4908                   , (if p-is-petrolium then "топлив" else "товаров")
     4909                   )
     4910         view-as alert-box ERROR .
     4911         undo, return error "max-gds":U.
     4912     end.
     4913     DO ii = (if p-is-petrolium
     4914              then v-petrol-start
     4915              else (if v-petrol-start = 1
     4916                    then (v-petrol-range + 1)
     4917                    else 1)
     4918              )
     4919        to v-max-gds :
     4920       if not can-find (loc_cd-plu where
     4921                         loc_cd-plu.obj-type = 'маг':U
     4922                      and loc_cd-plu.obj-code =  buf_Cash-desk.obj-code
     4923                      and loc_cd-plu.pos-type = buf_Cash-desk.pos-type
     4924                      and loc_cd-plu.plu-type = v-plu-type
     4925                      and loc_cd-plu.plu-code = ii
     4926                      )
     4927       then LEAVE .
     4928     END .
     4929     if ii > v-max-gds then do:
     4930         if not p-silence then
     4931         message
     4932         substitute("Превышено максимально допустимое количество &5 &1" +
     4933                   "для касс &2 &3&4"
     4934                   , chr(10)
     4935                   , v-max-gds
     4936                   , 'маг':U
     4937                   , buf_cash-desk.obj-code
     4938                   , (if p-is-petrolium then "топлив" else "товаров")
     4939                   )
     4940         view-as alert-box ERROR .
     4941         undo, return error "max-gds":U.
     4942     end.
     4943     run cur-time in this-procedure ( output v-today, output v-time).
     4944     create buf_cd-plu.
     4945     assign
     4946     buf_cd-plu.b-code = p-b-code
     4947     buf_cd-plu.b-str = p-b-str
     4948     buf_cd-plu.charkey_two = (if buf_cash-desk.pos-type = 'MARIA':U
     4949                                         then buf_cash-desk.addr-path
     4950                                         else "U":U)
     4951     buf_cd-plu.to-send = yes
     4952     buf_cd-plu.charkey_one = "":U
     4953     buf_cd-plu.to-del = no
     4954     buf_cd-plu.plu-code = ii
     4955     buf_cd-plu.obj-type = 'маг':U
     4956     buf_cd-plu.obj-code = buf_cash-desk.obj-code
     4957     buf_cd-plu.pos-type = buf_cash-desk.pos-type
     4958     buf_cd-plu.plu-type = v-plu-type
     4959     buf_cd-plu.logkey_one = p-loc-ean
     4960     buf_cd-plu.key#_one = integer(p-extra)
     4961     .
     4962     run cd-attr-write  in this-procedure (
     4963                                           input   buf_cash-desk.db-num
     4964                                           ,input  buf_cash-desk.obj-code
     4965                                           ,input  buf_cash-desk.pos-type
     4966                                           ,input  buf_cash-desk.cash-num
     4967                                           ,input  substitute("&1_operative", buf_cash-desk.pos-type)
     4968                                           ,input (if buf_cash-desk.pos-type = 'MARIA':U
     4969                                                 and p-is-petrolium
     4970                                                 then 'tot-petrol':U
     4971                                                 else 'tot-gds':U)
     4972                                           ,input ''
     4973                                           ,input ?
     4974                                           ,input 0.0
     4975                                           ,input  (v-tot-gds + 1)
     4976                                           ,input no
     4977                                          ) no-error .
     4978     if error-status:error then do:
     4979       v-mes = substitute("Ошибка при записи <текущее количество товаров на кассе> для кассы &1 &2&3:&4&5 &6"
     4980                          ,buf_cash-desk.cash-num
     4981                          , 'маг':U
     4982                          ,buf_cash-desk.obj-code
     4983                          , chr(10)
     4984                          , error-status:get-message(1)
     4985                          , return-value
     4986                          ).
     4987       if not p-silence then
     4988       message
     4989       v-mes
     4990       view-as alert-box error .
     4991       undo _main, return error v-mes.
     4992     end.
     4993     run cd-attr-write  in this-procedure (
     4994                                           input   buf_cash-desk.db-num
     4995                                           ,input  buf_cash-desk.obj-code
     4996                                           ,input  buf_cash-desk.pos-type
     4997                                           ,input  buf_cash-desk.cash-num
     4998                                           ,input  'MARIA_operative':U
     4999                                           ,input  'to-send':U
     5000                                           ,input ''
     5001                                           ,input ?
     5002                                           ,input 0.0
     5003                                           ,input 0
     5004                                           ,input yes
     5005                                          ) no-error .
     5006     if error-status:error then do:
     5007       v-mes = substitute("Ошибка при записи <Есть коды товаров, не отправленные на кассу> для кассы &1 &2&3:&4&5 &6"
     5008                          ,buf_cash-desk.cash-num
     5009                          , 'маг':U
     5010                          ,buf_cash-desk.obj-code
     5011                          , chr(10)
     5012                          , error-status:get-message(1)
     5013                          , return-value
     5014                          ).
     5015       if not p-silence then
     5016       message
     5017       v-mes
     5018       view-as alert-box error .
     5019       undo _main, return error v-mes.
     5020     end.
     5021     return "":U.
     5022   end.
     5023   END PROCEDURE.
     5024   procedure cd-mrkt_update-marketer :
     5025   define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     5026   define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     5027   define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     5028   define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     5029   define input parameter p-is-petrolium as logical no-undo .
     5030   define variable v-to-send as logical no-undo .
     5031   define variable v-tot-gds as integer no-undo .
     5032   define variable v-max-plu as integer no-undo .
     5033   define buffer buf_cd-plu for ub.cd-plu.
     5034   define variable v-plu-type as character no-undo .
     5035     do
     5036     on error undo, return error
     5037     :
     5038       v-to-send = no.
     5039       v-tot-gds = 0.
     5040       assign
     5041       v-plu-type = (if p-is-petrolium
     5042                     then  'топ':U
     5043                     else '':U
     5044                 )
     5045       .
     5046       FOR EACH buf_cd-plu WHERE
     5047              buf_cd-plu.obj-type = 'маг':U
     5048         and  buf_cd-plu.obj-code = p-obj-code
     5049         and  buf_cd-plu.pos-type = p-pos-type
     5050         and  buf_cd-plu.plu-type = v-plu-type
     5051             :
     5052         if  buf_cd-plu.to-del
     5053         or  buf_cd-plu.to-send then do:
     5054           assign
     5055           v-to-send = yes.
     5056         end.
     5057         assign
     5058         v-tot-gds = v-tot-gds + 1.
     5059       end.
     5060       run cd-attr-write  in this-procedure (
     5061                                               input   p-db-num
     5062                                               ,input  p-obj-code
     5063                                               ,input  p-pos-type
     5064                                               ,input  p-cash-num
     5065                                               ,input  'MARIA_operative':U
     5066                                               ,input  (if p-pos-type = 'MARIA':U
     5067                                                        and p-is-petrolium
     5068                                                        then  'tot-petrol':U
     5069                                                        else 'tot-gds':U)
     5070                                               ,input ''
     5071                                               ,input ?
     5072                                               ,input 0.0
     5073                                               ,input v-tot-gds
     5074                                               ,input no
     5075                                                                                           ) no-error .
     5076       if error-status:error then do:
     5077           UNDO, RETURN ERROR RETURN-VALUE.
     5078       END.
     5079       run cd-attr-write  in this-procedure (
     5080                                               input   p-db-num
     5081                                               ,input  p-obj-code
     5082                                               ,input  p-pos-type
     5083                                               ,input  p-cash-num
     5084                                               ,input  'MARIA_operative':U
     5085                                               ,input  (if p-pos-type = 'MARIA':U
     5086                                                        and p-is-petrolium
     5087                                                        then  'petrol-to-send':U
     5088                                                        else 'to-send':U)
     5089                                               ,input ''
     5090                                               ,input ?
     5091                                               ,input 0.0
     5092                                               ,input 0
     5093                                               ,input v-to-send
     5094                                               ) no-error .
     5095       if error-status:error then do:
     5096           UNDO, RETURN ERROR RETURN-VALUE.
     5097       END.
     5098       FIND LAST buf_cd-plu NO-LOCK  WHERE
     5099                buf_cd-plu.obj-type = 'маг':U
     5100            and buf_cd-plu.obj-code = p-obj-code
     5101            and buf_cd-plu.pos-type = p-pos-type
     5102            and buf_cd-plu.plu-type = v-plu-type  use-index pi no-error .
     5103       if available buf_cd-plu then do:
     5104         if v-max-plu < buf_cd-plu.plu-code
     5105         then
     5106         v-max-plu = buf_cd-plu.plu-code .
     5107       end.
     5108       else do:
     5109         v-max-plu = 0.
     5110       end.
     5111       run cd-attr-write  in this-procedure (
     5112                                             input   p-db-num
     5113                                             ,input  p-obj-code
     5114                                             ,input  p-pos-type
     5115                                             ,input  p-cash-num
     5116                                             ,input  'MARIA_operative':U
     5117                                             ,input  (if p-pos-type = 'MARIA':U
     5118                                                     and p-is-petrolium
     5119                                                     then 'max-petrol-plu':U
     5120                                                     else 'max-plu':U)
     5121                                               ,input ''
     5122                                               ,input ?
     5123                                               ,input 0.0
     5124                                               ,input v-max-plu
     5125                                               ,input no
     5126                                             ) no-error .
     5127       if error-status:error then do:
     5128           UNDO, RETURN ERROR RETURN-VALUE.
     5129       END.
     5130     end.
     5131   end procedure.
     5132   PROCEDURE cd-mrkt_clu-marketer :
     5133   define input parameter p-silence as logical no-undo .
     5134   define parameter buffer buf_cash-desk for ub.cash-desk.
     5135   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     5136   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     5137   define variable v-tot-cli as integer no-undo .
     5138   define variable v-max-cli as integer no-undo .
     5139   DEFINE VARIABLE v-today as date no-undo .
     5140   DEFINE VARIABLE v-time as integer no-undo .
     5141   define buffer  buf_cd-clu for ub.cd-clu.
     5142   define buffer  loc_cd-clu for ub.cd-clu.
     5143   define variable  ii as integer no-undo.
     5144   define variable v-mes as character no-undo .
     5145   _main:
     5146   DO ON ERROR undo, leave on stop undo, leave:
     5147     if buf_cash-desk.pos-type <> 'MARIA':U
     5148     or buf_cash-desk.cash-num <> 0 then do:
     5149       assign
     5150       v-mes =
     5151       substitute("Клиенты на кассах можно определять только для кассовых менеджеров (номер кассы = 0) для типов касс &1"
     5152                 , buf_cash-desk.pos-type).
     5153       if not p-silence then
     5154       message
     5155       v-mes
     5156       view-as alert-box error .
     5157       return error v-mes.
     5158     end.
     5159     v-tot-cli = cd-attr_get-attr-int(buffer buf_cash-desk
     5160                                     ,input 'MARIA_operative':U
     5161                                     ,input 'tot-cli':U
     5162                                     ,output v-mes).
     5163     if v-tot-cli = ? then undo _main, return error v-mes.
     5164     v-max-cli = cd-attr_get-attr-int(buffer buf_cash-desk
     5165                                     ,input 'MARIA_general':U
     5166                                     ,input 'max-cli':U
     5167                                     , output v-mes).
     5168     if v-max-cli = ? then undo _main, return error v-mes.
     5169     DO ii = 1
     5170        to v-max-cli :
     5171       if not can-find (loc_cd-clu where
     5172                       loc_cd-clu.obj-type = 'маг':U
     5173                   and loc_cd-clu.obj-code = buf_cash-desk.obj-code
     5174                   and loc_cd-clu.pos-type = buf_cash-desk.pos-type
     5175                   and loc_cd-clu.clu-type = '':U
     5176                   and loc_cd-clu.clu-code = ii
     5177                      )
     5178       then LEAVE .
     5179     END .
     5180     if ii > v-max-cli then do:
     5181         if not p-silence then
     5182         message
     5183         substitute("Превышено максимально допустимое количество клиентов &1" +
     5184                   "для касс &2 &3&4"
     5185                   , chr(10)
     5186                   , v-max-cli
     5187                   , 'маг':U
     5188                   , buf_cash-desk.obj-code
     5189                   )
     5190         view-as alert-box ERROR .
     5191         undo, return error "max-cli":U.
     5192     end.
     5193     run cur-time in this-procedure ( output v-today, output v-time).
     5194     create buf_cd-clu.
     5195     assign
     5196     buf_cd-clu.cli-code = p-obj-code
     5197     buf_cd-clu.cli-type = p-obj-type
     5198     buf_cd-clu.obj-type = 'маг':U
     5199     buf_cd-clu.obj-code = buf_Cash-desk.obj-code
     5200     buf_cd-clu.pos-type = buf_cash-desk.pos-type
     5201     buf_cd-clu.clu-type = '':U
     5202     buf_cd-clu.to-send = yes
     5203     buf_cd-clu.charkey_two = (if buf_cash-desk.pos-type = 'MARIA':U
     5204                               then buf_cash-desk.addr-path
     5205                               else "U":U)
     5206     buf_cd-clu.clu-code = ii
     5207     .
     5208     run cd-attr-write  in this-procedure (
     5209                                           input   buf_cash-desk.db-num
     5210                                           ,input  buf_cash-desk.obj-code
     5211                                           ,input  buf_cash-desk.pos-type
     5212                                           ,input  buf_cash-desk.cash-num
     5213                                           ,input  'MARIA_operative':U
     5214                                           ,input  'tot-cli':U
     5215                                           ,input ''
     5216                                           ,input ?
     5217                                           ,input 0.0
     5218                                           ,input  (v-tot-cli + 1)
     5219                                           ,input no
     5220                                          ) no-error .
     5221     if error-status:error then do:
     5222       v-mes = substitute("Ошибка при записи <текущее количество клиентов на кассе> для кассы &1 &2&3:&4&5 &6"
     5223                          ,buf_cash-desk.cash-num
     5224                          , 'маг':U
     5225                          ,buf_cash-desk.obj-code
     5226                          , chr(10)
     5227                          , error-status:get-message(1)
     5228                          , return-value
     5229                          ).
     5230       if not p-silence then
     5231       message
     5232       v-mes
     5233       view-as alert-box error .
     5234       undo _main, return error v-mes.
     5235     end.
     5236     run cd-attr-write  in this-procedure (
     5237                                           input   buf_cash-desk.db-num
     5238                                           ,input  buf_cash-desk.obj-code
     5239                                           ,input  buf_cash-desk.pos-type
     5240                                           ,input  buf_cash-desk.cash-num
     5241                                           ,input  'MARIA_operative':U
     5242                                           ,input  'cli-to-send':U
     5243                                           ,input ''
     5244                                           ,input ?
     5245                                           ,input 0.0
     5246                                           ,input 0
     5247                                           ,input yes
     5248                                          ) no-error .
     5249     if error-status:error then do:
     5250       v-mes = substitute("Ошибка при записи <Есть коды клиентов, не отправленные на кассу> для кассы &1 &2&3:&4&5 &6"
     5251                          ,buf_cash-desk.cash-num
     5252                          , 'маг':U
     5253                          ,buf_cash-desk.obj-code
     5254                          , chr(10)
     5255                          , error-status:get-message(1)
     5256                          , return-value
     5257                          ).
     5258       if not p-silence then
     5259       message
     5260       v-mes
     5261       view-as alert-box error .
     5262       undo _main, return error v-mes.
     5263     end.
     5264     return "":U.
     5265   end.
     5266   END PROCEDURE.
     5267   procedure cd-mrkt_update-marketer-cli :
     5268   define input parameter p-db-num   like ub.cash-desk-attr.db-num     no-undo .
     5269   define input parameter p-obj-code like ub.cash-desk-attr.obj-code   no-undo .
     5270   define input parameter p-pos-type like ub.cash-desk-attr.pos-type   no-undo .
     5271   define input parameter p-cash-num like ub.cash-desk-attr.cash-num   no-undo .
     5272   define variable v-cli-to-send as logical no-undo .
     5273   define variable v-tot-cli as integer no-undo .
     5274   define variable v-max-clu as integer no-undo .
     5275   define buffer buf_cd-clu for ub.cd-clu.
     5276   do
     5277   on error undo, return error return-value
     5278   :
     5279     v-cli-to-send = no.
     5280     v-tot-cli = 0.
     5281     FOR EACH buf_cd-clu WHERE
     5282           buf_cd-clu.obj-type = 'маг':U
     5283       and buf_cd-clu.obj-code =  p-obj-code
     5284       and buf_cd-clu.pos-type =  p-pos-type
     5285       and buf_cd-clu.clu-type =  '':U
     5286       :
     5287       if buf_cd-clu.to-del = yes then do:
     5288         assign
     5289         v-cli-to-send = yes.
     5290       end.
     5291       assign
     5292       v-tot-cli = v-tot-cli + 1.
     5293     end.
     5294     run cd-attr-write  in this-procedure (
     5295                                             input   p-db-num
     5296                                             ,input  p-obj-code
     5297                                             ,input  p-pos-type
     5298                                             ,input  p-cash-num
     5299                                             ,input  'MARIA_operative':U
     5300                                             ,input  'tot-cli':U
     5301                                             ,input ''
     5302                                             ,input ?
     5303                                             ,input 0.0
     5304                                             ,input v-tot-cli
     5305                                             ,input no
     5306                                             ) no-error .
     5307     if error-status:error then do:
     5308         UNDO, RETURN ERROR RETURN-VALUE.
     5309     END.
     5310     run cd-attr-write  in this-procedure (
     5311                                             input   p-db-num
     5312                                             ,input  p-obj-code
     5313                                             ,input  p-pos-type
     5314                                             ,input  p-cash-num
     5315                                             ,input  'MARIA_operative':U
     5316                                             ,input  'cli-to-send':U
     5317                                             ,input ''
     5318                                             ,input ?
     5319                                             ,input 0.0
     5320                                             ,input 0
     5321                                             ,input v-cli-to-send
     5322                                             ) no-error .
     5323     if error-status:error then do:
     5324         UNDO, RETURN ERROR RETURN-VALUE.
     5325     END.
     5326     FIND LAST buf_cd-clu WHERE
     5327             buf_cd-clu.obj-type = 'маг':U
     5328         and buf_cd-clu.obj-code = p-obj-code
     5329         and buf_cd-clu.pos-type = p-pos-type
     5330         and buf_cd-clu.clu-type = '':U
     5331         NO-LOCK use-index pi no-error .
     5332     if available buf_cd-clu then do:
     5333       if v-max-clu < buf_cd-clu.clu-code
     5334       then
     5335       v-max-clu = buf_cd-clu.clu-code.
     5336     end.
     5337     else do:
     5338       v-max-clu = 0.
     5339     end.
     5340     run cd-attr-write  in this-procedure (
     5341                                           input   p-db-num
     5342                                           ,input  p-obj-code
     5343                                           ,input  p-pos-type
     5344                                           ,input  p-cash-num
     5345                                           ,input  'MARIA_operative':U
     5346                                           ,input  'max-clu':U
     5347                                           ,input ''
     5348                                           ,input ?
     5349                                           ,input 0.0
     5350                                           ,input v-max-clu
     5351                                           ,input no
     5352                                           ) no-error .
     5353     if error-status:error then do:
     5354         UNDO, RETURN ERROR RETURN-VALUE.
     5355     END.
     5356   end.
     5357   end procedure.
