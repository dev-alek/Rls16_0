    12447       AND LOOKUP('дро':U, cash-gds.unit-cli-type) > 0)
    12448       then "2":U
    12449       else "0":U)
    12450       (if LOOKUP('дро':U, cash-gds.unit-cli-type) > 0
    12451        or LOOKUP('вес':U, cash-gds.unit-cli-type) > 0
    12452        or is-sc
    12453        then "1":U
    12454        else "0":U)
    12455         (if pos-type = 'NCR-GM':U or
    12456         wd-option = 0
    12457         then   ncrdsc
    12458         else '0':U)
    12459        (if cash-gds.vat-code = ? or
    12460        cash-gds.vat-code > 7 then
    12461        "0"
    12462        else string(cash-gds.vat-code, "9"))
    12463       (if (LOOKUP( 'вес':U, cash-gds.unit-cli-type ) > 0
    12464       or (is-sc
    12465       AND LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    12466       AND LOOKUP('дро':U, cash-gds.unit-cli-type) > 0))
    12467       and  (cash-gds.taracode  <> '':u
    12468            or taracode-bc <> '')
    12469       then (if taracode-bc <> ''
    12470             then taracode-bc
    12471             else cash-gds.taracode)
    12472       else '00'
    12473       )
    12474       (if cash-gds.unit-cli begins "№"
    12475        then substring(cash-gds.unit-cli, 2, 2)
    12476        else substring(cash-gds.unit-cli, 1, 2))  format "X(2)"
    12477       "0010":U
    12478       "0000":U
    12479       chk_name
    12480       fill(chr(32), 4)
    12481       (if pos-type = 'NCR-GM':U and wd-option > 0 then "1":U else chr(32))
    12482       fill(chr(32), 8)
    12483       conf-par
    12484       replace(string( cash-gds.price-sale, "999999.99")
    12485              , ".":U, "":U
    12486              )
    12487       chr(10)
    12488       .
    12489       if pos-type = 'NCR-AS@R':U
    12490       and ncrdsc <> '0':U
    12491       and wd-option > 0
    12492       and cash-gds.std-discnt-rule > 0
    12493       then do:
    12494         run create-ncr-kat-discnt in this-procedure (
    12495                                                     input string(cash-gds.gds-code)
    12496                                                     ,input (fill(chr(32), 2) + chr(32) + IBM-good-code)
    12497                                                     ,input chk_name
    12498                                                     ,input (if action = 'D':U then 0 else cash-gds.std-discnt-rule)
    12499                                                     ,input ?
    12500                                                     ,input 'time-rule-num':U
    12501                                                     ,input ?
    12502                                                     ) no-error .
    12503       end.
    12504       ncr-disc-string = '':U.
    12505       if conf-par = "T":U then do:
    12506         ncr-disc-string = ncr-temp-disc(cash-gds.temp-discnt-rule, cash-gds.price-sale, temp-disc-dec).
    12507         if ncr-disc-string <> '':U then
    12508         PUT stream IBMstream unformatted
    12509         chr(32)
    12510         "T":U
    12511         chr(32)
    12512         IBM-good-code
    12513         chr(32)
    12514         chr(32)
    12515         ncr-disc-string
    12516         chr(10)
    12517         .
    12518       end.
    12519       if conf-par = "D":U then do:
    12520         ncr-disc-string = ncr-date-disc(cash-gds.date-discnt-rule, cash-gds.price-sale).
    12521         if ncr-disc-string <> '':U then
    12522         PUT stream IBMstream unformatted
    12523         chr(32)
    12524         "D":U
    12525         chr(32)
    12526         IBM-good-code
    12527         chr(32)
    12528         chr(32)
    12529         ncr-disc-string
    12530         chr(10)
    12531         .
    12532       end.
    12533       if conf-par = "X":U then do:
    12534         ncr-disc-string = ncr-amnt-disc(cash-gds.qnty-discnt-rule, cash-gds.price-sale).
    12535         if ncr-disc-string <> '':U then
    12536         PUT stream IBMstream unformatted
    12537         chr(32)
    12538         "X":U
    12539         chr(32)
    12540         IBm-good-code
    12541         chr(32)
    12542         chr(32)
    12543         ncr-disc-string
    12544         chr(10)
    12545         .
    12546       end.
    12547     end.
    12548     if pos-type = 'NCR-AS@R':U
    12549     and cash-gds.kat-discnt-rule <> 0
    12550     then do:
    12551       case how-pcnt-kat :
    12552         when 'pcnt-kat-pdf':U then do:
    12553             v-kat-discnt = cash-gds.price-sale.
    12554           end.
    12555         otherwise do:
    12556           v-kat-discnt = ?.
    12557         end.
    12558       end case.
    12559       run create-ncr-kat-discnt in this-procedure (
    12560                                                    input string(cash-gds.gds-code)
    12561                                                   ,input (fill(chr(32), 2) + chr(32) + IBM-good-code)
    12562                                                   ,input chk_name
    12563                                                   ,input (if action = 'D':U then 0 else cash-gds.kat-discnt-rule)
    12564                                                   ,input (if how-pcnt-kat = 'pcnt-kat-pdf':U then 89 else 33)
    12565                                                   ,input 'time-rule-num':U
    12566                                                   ,input v-kat-discnt
    12567                                                   ) no-error .
    12568       if error-status:error then do:
    12569       end.
    12570     end.
    12571     if IBM-good-code = IBM-good-code-2 then leave do2.
    12572     assign
    12573     IBM-good-code = IBM-good-code-2
    12574     .
    12575   end.
    12576       end.
    12577     END CASE .
    12578   END PROCEDURE .
    12579   define variable vss-include-info94 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12580   PROCEDURE   for-cash-cycle:
    12581   DEFINE VARIABLE fname-list as character no-undo .
    12582   DEFINE VARIABLE out-list as character no-undo .
    12583   DEFINE VARIABLE var-file-num as integer no-undo .
