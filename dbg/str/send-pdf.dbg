     1849   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1850   procedure cur-time :
     1851      define output parameter p-today as date      no-undo .
     1852      define output parameter p-time  as integer   no-undo .
     1853     do
     1854     on error undo, return error
     1855     :
     1856       define variable v-date1 as date      no-undo .
     1857       define variable v-date2 as date      no-undo .
     1858       define variable v-time  as integer   no-undo .
     1859       assign
     1860         v-date1 = today
     1861         v-time  = time
     1862         v-date2 = today
     1863       .
     1864       if v-date1 <> v-date2
     1865       then do:
     1866         assign
     1867           v-date1 = today
     1868           v-time  = v-time
     1869         .
     1870       end.
     1871       assign
     1872         p-today = v-date1
     1873         p-time  = v-time
     1874       .
     1875     end.
     1876   end.
     1877   function cur-time-date returns character
     1878   :
     1879     return string(today, '99/99/9999':U) .
     1880   end.
     1881   function cur-time-mjd returns decimal
     1882   :
     1883     define variable v-date as date      no-undo .
     1884     define variable v-time as integer   no-undo .
     1885     run cur-time in this-procedure
     1886       (output v-date
     1887       ,output v-time
     1888       ) .
     1889     return integer(v-date) - 2400002 + (v-time / 86400) .
     1890   end.
     1891   function cur-time-get-ending-index returns integer
     1892   (input p-number as integer
     1893   )
     1894   :
     1895     if p-number < 0
     1896     or p-number = ?
     1897     then do:
     1898       return 1 .
     1899     end.
     1900     define variable v-rest as integer   no-undo .
     1901     assign
     1902       p-number = p-number modulo 100
     1903     .
     1904     if p-number < 20
     1905     then do:
     1906       assign
     1907         v-rest = p-number
     1908       .
     1909     end.
     1910     else do:
     1911       assign
     1912         v-rest = p-number modulo 10
     1913       .
     1914     end.
     1915     case v-rest :
     1916       when 1
     1917       then do:
     1918         return 2 .
     1919       end.
     1920       when 2 or
     1921       when 3 or
     1922       when 4
     1923       then do:
     1924         return 3 .
     1925       end.
     1926       otherwise do:
     1927         return 1 .
     1928       end.
     1929     end case .
     1930   end.
     1931   procedure cur-time-mjd-to-date :
     1932      define input  parameter i-mjd-diff as decimal no-undo.
     1933      define output parameter o-Date     as date    no-undo.
     1934      define output parameter o-Time     as integer no-undo.
     1935      define variable v-day-number as integer   no-undo .
     1936      if    i-mjd-diff < 0
     1937         or i-mjd-diff = ?
     1938      then do:
     1939         return "?" .
     1940      end.
     1941      assign
     1942         v-day-number = truncate(i-mjd-diff,0).
     1943         o-Date = date(v-day-number + 2400002).
     1944         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1945     .
     1946   end.
     1947   function cur-time-mjd-to-string returns character
     1948   (input p-mjd-diff as decimal
     1949   )
     1950   :
     1951     define variable v-day-number as integer   no-undo .
     1952     define variable v-seconds    as integer   no-undo .
     1953     define variable v-hour       as integer   no-undo .
     1954     define variable v-min        as integer   no-undo .
     1955     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1956     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1957     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1958     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1959     if p-mjd-diff < 0
     1960     or p-mjd-diff = ?
     1961     then do:
     1962       return "?" .
     1963     end.
     1964     assign
     1965       v-day-number = integer(truncate(p-mjd-diff,0))
     1966       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1967     .
     1968     if v-seconds > 86400
     1969     then do:
     1970       assign
     1971         v-seconds = 86400 - 1
     1972       .
     1973     end.
     1974     if v-seconds < 0
     1975     then do:
     1976       assign
     1977         v-seconds = 0
     1978       .
     1979     end.
     1980     assign
     1981       v-hour = truncate(v-seconds / 3600, 0)
     1982     .
     1983     assign
     1984       v-seconds = v-seconds modulo 3600
     1985     .
     1986     assign
     1987       v-min = truncate(v-seconds / 60, 0)
     1988     .
     1989     assign
     1990       v-seconds = v-seconds modulo 60
     1991     .
     1992     return
     1993         (if v-day-number <> 0
     1994           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1995           else ""
     1996         )
     1997       + (if v-day-number <> 0 or v-hour <> 0
     1998           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1999           else ""
     2000         )
     2001       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     2002           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     2003           else ""
     2004         )
     2005       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     2006       .
     2007   end.
     2008   function cur-time-string returns character
     2009   :
     2010     define variable v-date as date      no-undo .
     2011     define variable v-time as integer   no-undo .
     2012     run cur-time in this-procedure
     2013       (output v-date
     2014       ,output v-time
     2015       ) .
     2016     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     2017   end.
     2018   function cur-time-string-sec returns character
     2019   :
     2020     define variable v-date as date      no-undo .
     2021     define variable v-time as integer   no-undo .
     2022     run cur-time in this-procedure
     2023       (output v-date
     2024       ,output v-time
     2025       ) .
     2026     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     2027   end.
     2028   function cur-time-custom  returns character
     2029   (input p-prefix as character
     2030   ,input p-date-format as character
     2031   ,input p-delimiter as character
     2032   ,input p-time-format as character
     2033   ,input p-suffix as character
     2034   )
     2035   :
     2036     define variable v-date as date      no-undo .
     2037     define variable v-time as integer   no-undo .
     2038     run cur-time in this-procedure
     2039       (output v-date
     2040       ,output v-time
     2041       ) .
     2042     return
     2043       p-prefix
     2044       + string(v-date, p-date-format)
     2045       + p-delimiter
     2046       + string(v-time, p-time-format)
     2047       + p-suffix
     2048       .
     2049   end.
     2050   function cur-time-print  returns character
     2051   :
     2052     define variable v-date as date      no-undo .
     2053     define variable v-time as integer   no-undo .
     2054     run cur-time in this-procedure
     2055       (output v-date
     2056       ,output v-time
     2057       ) .
     2058     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     2059   end.
     2060   function cur-time-datetime returns datetime
     2061   :
     2062     define variable v-char as character no-undo .
     2063     define variable v-datetime as datetime no-undo .
     2064     v-char = cur-time-string().
     2065     v-datetime = datetime(v-char).
     2066     return  v-datetime.
     2067   end.
     2068   function cur-time-string-msec returns character
     2069   :
     2070     define variable v-date as datetime  no-undo .
     2071     v-date = now.
     2072     return string(v-date) .
     2073   end.
     2074   define variable vss-include-info23 as character format "X(65)" no-undo
     2075   initial "@(#)$Workfile$ $Revision$".
     2076   procedure xmlchar-test :
     2077   define input parameter p-in-string          as character        no-undo.
     2078   define output parameter p-out-string-enc    as character        no-undo.
     2079   define output parameter p-out-string-dec    as character        no-undo.
     2080   do
     2081   on error undo, return error
     2082   :
     2083          run xmlchar-encode in this-procedure
     2084       (
     2085             input p-in-string
     2086           , output p-out-string-enc
     2087       ).
     2088          run xmlchar-decode in this-procedure
     2089       (
     2090             input p-out-string-enc
     2091           , output p-out-string-dec
     2092       ).
