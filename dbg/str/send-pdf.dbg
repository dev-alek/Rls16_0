    14645   _do26:
    14646   do vdr-26 = 1 to 3:
    14647     CASE vdr-26:
    14648       when 1 then do:
    14649         assign
    14650         vc-obj-code = ub.shop.obj-code
    14651         vc-obj-type = 'маг':U
    14652         vc-host-code = ub.shop.host-code
    14653         vc-region    = substitute("&1&2", vc-obj-type, vc-obj-code)
    14654         .
    14655       end.
    14656       when 2 then do:
    14657         assign
    14658         vc-obj-code = 0
    14659         vc-obj-type = '':U
    14660         vc-host-code = ub.shop.host-code
    14661         vc-region    = substitute("Фирма &1&2", vc-host-code)
    14662         .
    14663       end.
    14664       when 3 then do:
    14665         assign
    14666         vc-obj-code = 0
    14667         vc-obj-type = '':U
    14668         vc-host-code = 0
    14669         vc-region    = "Глобально"
    14670         .
    14671       end.
    14672     END CASE.
    14673     find ub.dis-rule no-lock where
    14674                   ub.dis-rule.upper-rule-num = 26
    14675               and ub.dis-rule.host-code = vc-host-code
    14676               AND ub.dis-rule.obj-type = vc-obj-type
    14677               AND ub.dis-rule.obj-code = vc-obj-code no-error .
    14678     if available ub.dis-rule then LEAVE _do26.
    14679   end.
    14680   if available ub.dis-rule then do:
    14681     for each buf_dis-rule no-lock where
    14682             buf_dis-rule.upper-rule-num = ub.dis-rule.rule-num :
    14683       assign
    14684       ncrgmdsc = ncrgmdsc + (if ncrgmdsc = "":U then "":U else ";") +
    14685                   string(buf_dis-rule.dis-kat) + "=":U +
    14686                   string(buf_dis-rule.discnt-value).
    14687     end.
    14688   end.
