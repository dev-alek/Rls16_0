     6294   define buffer buf_turnover-buyer-main    for ub.turnover-buyer-main  .
     6295   define buffer buf1_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     6296   define buffer buf2_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     6297   define buffer buf_price-all              for ub.price-all  .
     6298   define buffer buf_goods                  for ub.goods      .
     6299   define buffer buf_global-state           for ub.global-state  .
     6300   define buffer buf_buyer-group            for ub.buyer-group  .
     6301   define buffer buf_turnover-group         for ub.turnover-group  .
     6302   define buffer buf_main-code              for ub.bar-code  .
     6303   define buffer buf_bar-code               for ub.bar-code  .
     6304   define buffer buf_pay-type               for ub.pay-type  .
     6305   define buffer buf_cash-pay               for ub.cash-pay  .
     6306   define variable to-day          as date      no-undo .
     6307   define variable v-base-rate0    as decimal   no-undo .
     6308   define variable v-base-scale0   as decimal   no-undo .
     6309   define variable v-exch-rate0    as decimal   no-undo .
     6310   define variable v-exch-scale0   as decimal   no-undo .
     6311   define variable v-base-rate     as decimal   no-undo .
     6312   define variable v-base-scale    as decimal   no-undo .
     6313   define variable v-exch-rate     as decimal   no-undo .
     6314   define variable v-exch-scale    as decimal   no-undo .
     6315   define variable v-host-code     as integer   no-undo .
     6316   define variable v-curr-abbr     as character no-undo .
     6317   define variable v-grp-name      as character no-undo .
     6318   define variable v-date-1        as date      no-undo .
     6319   define variable v-date-2        as date      no-undo .
     6320   define variable v-interv        as character no-undo .
     6321   define variable v-pay-name      as character no-undo .
     6322   define variable v-cli-oborot    as decimal   no-undo .
     6323   define variable v-trn-pay-code  as integer   no-undo .
     6324   define variable v-cash-pay-curr as integer   no-undo .
     6325   define variable v-cash-pay-code as integer   no-undo .
     6326   do
     6327   on error undo, return error return-value
     6328   :
     6329   find first buf_main-code no-lock where buf_main-code.b-code = p-main-b-code .
     6330   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
     6331   if p-fact-order = ? then do:
     6332     run fact-order-mpl (
     6333         input   today       ,
     6334         input   p-obj-type  ,
     6335         input   p-obj-code  ,
     6336         output  p-fact-order ).
     6337   end.
     6338   if p-vid-pay <> "" then do:
     6339      find first buf_pay-type no-lock where  buf_pay-type.obj-code = integer(p-vid-pay) no-error .
     6340      if available buf_pay-type
     6341         then v-trn-pay-code = buf_pay-type.obj-code.
     6342         else v-trn-pay-code =  0.
     6343   end.
     6344   else v-trn-pay-code = 0 .
     6345   if p-cash-pay-type <> "" then do:
     6346      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
     6347      if available buf_pay-type
     6348         then
     6349           assign
     6350             v-cash-pay-curr = buf_cash-pay.curr-code
     6351             v-cash-pay-code = buf_cash-pay.cdpay-code
     6352           .
     6353         else
     6354           assign
     6355             v-cash-pay-curr = 0
     6356             v-cash-pay-code = 0
     6357             .
     6358   end.
     6359   else
     6360     assign
     6361       v-cash-pay-curr = 0
     6362       v-cash-pay-code = 0
     6363       .
     6364   for each tt_price-all  : delete tt_price-all . end.
     6365   assign
     6366     p-plt-id             = ?
     6367     p-plt-db-num         = ?
     6368     p-pdf-id             = ?
     6369     p-pdf-db-num         = ?
     6370     p-sale-price-base    = ?
     6371     p-sale-price-rubl    = ?
     6372     v-cli-oborot         = 0
     6373   .
     6374   find first buf_global-state no-lock no-error .
     6375   if not available buf_global-state then do:
     6376      message
     6377        "Не заданы параметры ценообразования!"
     6378        view-as alert-box error
     6379      .
     6380      return error return-value .
     6381   end.
     6382   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6383   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     6384     (input  p-obj-type
     6385     ,input  p-obj-code
     6386     ,output to-day
     6387     )  .
     6388   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6389   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6390     (input  p-obj-type
     6391     ,input  p-obj-code
     6392     ,output v-host-code
     6393     )  .
     6394   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6395   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     6396     (input  v-host-code
     6397     ,input  to-day
     6398     ,output v-base-rate0
     6399     ,output v-base-scale0
     6400     )  .
     6401     v-cli-oborot-ALL  = 0 .
     6402     for each buf_turnover-buyer-main no-lock  where
     6403              buf_turnover-buyer-main.cli-type = p-cli-type  and
     6404              buf_turnover-buyer-main.cli-code = p-cli-code
     6405              :
     6406              v-cli-oborot-ALL = v-cli-oborot-ALL + buf_turnover-buyer-main.sum-doc-rubl-itog .
     6407     end.
     6408   for each buf_price-all no-lock where
     6409            buf_price-all.obj-type = p-obj-type and
     6410            buf_price-all.obj-code = p-obj-code and
     6411            buf_price-all.gds-code = buf_goods.gds-code and
     6412            buf_price-all.status_  = 'акт':U  and
     6413          ( p-only-b-code = false   or
     6414          ( buf_price-all.b-code = p-main-b-code or
     6415            buf_price-all.b-code = p-b-code))    and
     6416           ( p-only-b-code = true  or
     6417             buf_price-all.b-code = p-b-code)
     6418             and
     6419             buf_price-all.fact-order-sys-from  <= p-fact-order  and
     6420           ( buf_price-all.fact-order-sys-to = ? or
     6421             buf_price-all.fact-order-sys-to    >= p-fact-order)
     6422           :
     6423            v-interv   = "" .
     6424            v-grp-name = "" .
     6425            v-pay-name = "" .
     6426            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     6427            if buf_price-all.bgr-id > 0 then do:
     6428               find first buf_buyer-group no-lock where
     6429                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     6430                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     6431               if available buf_buyer-group then do:
     6432                  if p-cli-type <> "" and p-cli-type <> ? then do:
     6433                  find first buf_buyer-in-buyer-group no-lock where
     6434                             buf_buyer-in-buyer-group.stts         = 0 and
     6435                             buf_buyer-in-buyer-group.bgr-id       = buf_buyer-group.bgr-id     and
     6436                             buf_buyer-in-buyer-group.bgr-db-num   = buf_buyer-group.bgr-db-num  and
     6437                             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
     6438                             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code
     6439                             no-error .
     6440                             if not available buf_buyer-in-buyer-group then do:
     6441                                v-grp-name = "".
     6442                                next.
     6443                             end.
     6444                             v-grp-name = buf_buyer-group.name .
     6445                  end.
     6446               end.
     6447               else do:
     6448                    v-grp-name = "".
     6449                    next.
     6450               end.
     6451            end.
     6452            if buf_price-all.tog-id > 0 then do:
     6453               find first buf_turnover-group no-lock where
     6454                          buf_turnover-group.tog-id     = buf_price-all.tog-id      and
     6455                          buf_turnover-group.tog-db-num = buf_price-all.tog-db-num  no-error .
     6456               if available buf_turnover-group then do:
     6457                  if p-cli-type <> "" and p-cli-type <> ? then do:
     6458                     v-cli-oborot = v-cli-oborot-all  .
     6459                     find first buf1_tnv-in-turnover-group no-lock where
     6460                                buf1_tnv-in-turnover-group.stts       =  0     and
     6461                                buf1_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     6462                                buf1_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     6463                                buf1_tnv-in-turnover-group.ttg-summa  <=  v-cli-oborot no-error .
     6464                     find first buf2_tnv-in-turnover-group no-lock where
     6465                                buf2_tnv-in-turnover-group.stts       =  0     and
     6466                                buf2_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     6467                                buf2_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     6468                                buf2_tnv-in-turnover-group.ttg-summa  >=  v-cli-oborot no-error .
     6469                     if not (available buf1_tnv-in-turnover-group and
     6470                             available buf2_tnv-in-turnover-group ) then do:
     6471                             v-grp-name = "".
     6472                             next .
     6473                     end.
     6474                     v-grp-name = buf_turnover-group.name.
     6475                  end.
     6476               end.
     6477               else do:
     6478                    v-grp-name = "".
     6479                    next.
     6480               end.
     6481            end.
     6482            if buf_price-all.plt-fix-cource-crc-base = true then
     6483               assign
     6484                 v-base-rate  = buf_price-all.pdf-base-rate
     6485                 v-base-scale = buf_price-all.pdf-base-scale
     6486               .
     6487               else
     6488               assign
     6489                 v-base-rate  = v-base-rate0
     6490                 v-base-scale = v-base-scale0
     6491               .
     6492            if buf_price-all.plt-fix-cource-crc-doc = true then
     6493               assign
     6494                 v-exch-rate  = buf_price-all.pdf-exch-rate
     6495                 v-exch-scale = buf_price-all.pdf-exch-scale
     6496               .
     6497               else do:
     6498   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6499   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     6500     (input  buf_price-all.curr-code
     6501     ,input  to-day
     6502     ,output v-exch-rate0
     6503     ,output v-exch-scale0
     6504     ,output v-curr-abbr
     6505     )  .
     6506               assign
     6507                 v-exch-rate  = v-exch-rate0
     6508                 v-exch-scale = v-exch-scale0
     6509                 .
     6510              end.
     6511              v-date-1 = date ( "" )  .
     6512              if buf_price-all.fact-order-sys-from > 0 then do:
     6513                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     6514                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     6515                 if buf_price-all.start-date <> ?       then  v-date-1 = buf_price-all.start-date.
     6516              end.
     6517              v-date-2 =  date ( "" )  .
     6518              if buf_price-all.fact-order-sys-to > 0 then do:
     6519                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     6520                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     6521                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     6522              end.
     6523              if buf_price-all.qnty-from <> ? then do :
     6524                 if not (
     6525                 ( p-qnty-doc  >= buf_price-all.qnty-from and buf_price-all.qnty-to = ? ) or
     6526                 ( p-qnty-doc  >= buf_price-all.qnty-from and p-qnty-doc <= buf_price-all.qnty-to and buf_price-all.qnty-to <> ?)
     6527                 ) then do:
     6528                        v-interv = "".
     6529                        next.
     6530                 end.
     6531                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     6532              end.
     6533              if buf_price-all.sum-from <> ? then do :
     6534                 if not (
     6535                 ( p-sum-doc  >= buf_price-all.sum-from and buf_price-all.sum-to = ? ) or
     6536                 ( p-sum-doc  >= buf_price-all.sum-from and p-sum-doc <= buf_price-all.sum-to and buf_price-all.sum-to <> ?)
     6537                 ) then do:
     6538                    v-interv = "".
     6539                    next.
     6540                 end.
     6541                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     6542              end.
     6543              if buf_price-all.turnover-from <> ? then do :
     6544                 if not (
     6545                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and buf_price-all.turnover-to = ? ) or
     6546                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and v-cli-oborot-ALL <= buf_price-all.turnover-to and buf_price-all.turnover-to <> ?)
     6547                 ) then do:
     6548                    v-interv = "".
     6549                    next.
     6550                 end.
     6551                 v-interv = "O: " +  string(buf_price-all.turnover-from) + " - " + ( if buf_price-all.turnover-to = ? then "и более" else string(buf_price-all.turnover-to)) .
     6552              end.
     6553              if buf_price-all.use-pay-type = 1 then do :
     6554                 if buf_price-all.pay-code <> v-trn-pay-code then do:
     6555                    v-pay-name = "" .
     6556                    next.
     6557                  end.
     6558                  v-pay-name = 'Оплата':U +  ":" + string(buf_price-all.pay-code) .
     6559              end.
     6560              if buf_price-all.use-cash-pay = 1 then do :
     6561                 if v-cash-pay-code <> 0 and  not ( buf_price-all.curr-pay-code = v-cash-pay-curr and
     6562                                                    buf_price-all.cdpay-code    = v-cash-pay-code ) then do:
     6563                   v-pay-name = "" .
     6564                   next.
     6565                 end.
     6566                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     6567              end.
     6568             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     6569             create tt_price-all .
     6570             buffer-copy buf_price-all to tt_price-all
     6571             assign
     6572               tt_price-all.price-sale-rubl = buf_price-all.price-sale  * v-exch-rate / v-exch-scale
     6573               tt_price-all.road-tax-rubl   = buf_price-all.road-tax    * v-exch-rate / v-exch-scale
     6574               tt_price-all.excise-rubl     = buf_price-all.excise      * v-exch-rate / v-exch-scale
     6575               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     6576               tt_price-all.road-tax-base   = tt_price-all.road-tax-rubl    / v-base-rate * v-base-scale
     6577               tt_price-all.excise-base     = tt_price-all.excise-rubl      / v-base-rate * v-base-scale
     6578               tt_price-all.price-sale     = buf_price-all.price-sale
     6579               tt_price-all.road-tax       = buf_price-all.road-tax
     6580               tt_price-all.excise         = buf_price-all.excise
     6581               tt_price-all.pdf-exch-rate   = v-exch-rate
     6582               tt_price-all.pdf-exch-scale  = v-exch-scale
     6583               tt_price-all.pdf-base-rate   = v-base-rate
     6584               tt_price-all.pdf-base-scale  = v-base-scale
     6585               tt_price-all.grp-name        = v-grp-name
     6586               tt_price-all.date-1          = v-date-1
     6587               tt_price-all.shift-1         = buf_price-all.start-shift-num
     6588               tt_price-all.time-1          = buf_price-all.start-sys-time
     6589               tt_price-all.date-2          = v-date-2
     6590               tt_price-all.shift-2         = buf_price-all.end-shift-num
     6591               tt_price-all.time-2          = buf_price-all.end-sys-time
     6592               tt_price-all.interv-name     = v-interv
     6593               tt_price-all.pay-name        = v-pay-name
     6594               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     6595             .
     6596   end.
     6597   define variable vt-plt-id as integer   no-undo .
     6598   define variable vt-plt-db as integer   no-undo .
     6599   define variable vt-pdf-id as integer   no-undo .
     6600   define variable vt-pdf-db as integer   no-undo .
     6601   define buffer neos_price-all for tt_price-all  .
     6602   find first tt_price-all where tt_price-all.b-code = p-main-b-code use-index pi no-error .
     6603       if available tt_price-all then do:
     6604        assign
     6605          vt-plt-id = tt_price-all.plt-id
     6606          vt-plt-db = tt_price-all.plt-db-num
     6607          vt-pdf-id = tt_price-all.pdf-id
     6608          vt-pdf-db = tt_price-all.pdf-db
     6609        .
     6610        if tt_price-all.b-code = p-b-code then do:
     6611             assign
     6612               p-plt-id           = tt_price-all.plt-id
     6613               p-plt-db-num       = tt_price-all.plt-db-num
     6614               p-pdf-id           = tt_price-all.pdf-id
     6615               p-pdf-db-num       = tt_price-all.pdf-db
     6616               p-sale-price-base  = tt_price-all.price-sale-base
     6617               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     6618               p-road-tax-base    = tt_price-all.road-tax-base
     6619               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     6620               p-excise-base      = tt_price-all.excise-base
     6621               p-excise-rubl      = tt_price-all.excise-rubl
     6622               .
     6623        end.
     6624        else do:
     6625          find first neos_price-all where
     6626                     neos_price-all.b-code     = p-b-code  and
     6627                     neos_price-all.plt-id     = vt-plt-id and
     6628                     neos_price-all.plt-db-num = vt-plt-db and
     6629                     neos_price-all.pdf-id     = vt-pdf-id and
     6630                     neos_price-all.pdf-db     = vt-pdf-db
     6631                     use-index pi no-error .
     6632            if available neos_price-all then do:
     6633             assign
     6634               p-plt-id           = tt_price-all.plt-id
     6635               p-plt-db-num       = tt_price-all.plt-db-num
     6636               p-pdf-id           = tt_price-all.pdf-id
     6637               p-pdf-db-num       = tt_price-all.pdf-db
     6638               p-sale-price-base  = neos_price-all.price-sale-base
     6639               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     6640               p-road-tax-base    = neos_price-all.road-tax-base
     6641               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     6642               p-excise-base      = neos_price-all.excise-base
     6643               p-excise-rubl      = neos_price-all.excise-rubl
     6644               .
     6645            end.
     6646            else do:
     6647                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     6648                 if error-status :error    then do:
     6649                   message "Не найден бар-код" p-b-code view-as alert-box error .
     6650                   return error return-value .
     6651                 end.
     6652             assign
     6653               p-plt-id           = tt_price-all.plt-id
     6654               p-plt-db-num       = tt_price-all.plt-db-num
     6655               p-pdf-id           = tt_price-all.pdf-id
     6656               p-pdf-db-num       = tt_price-all.pdf-db
     6657               p-sale-price-base  = tt_price-all.price-sale-base
     6658               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     6659               p-road-tax-base    = tt_price-all.road-tax-base
     6660               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     6661               p-excise-base      = tt_price-all.excise-base
     6662               p-excise-rubl      = tt_price-all.excise-rubl * buf_bar-code.cli-base-rate
     6663               .
     6664            end.
     6665        end.
     6666     end.
     6667   end.
     6668   end procedure.
     6669   procedure mpl-tpl-auto :
     6670   define input  parameter p-b-code     as integer   no-undo .
     6671   define input  parameter p-obj-type   as character no-undo .
     6672   define input  parameter p-obj-code   as integer   no-undo .
     6673   define input  parameter p-plt-id     as integer   no-undo .
     6674   define input  parameter p-plt-db-num as integer   no-undo .
     6675   define input  parameter p-fact-order as decimal   no-undo .
     6676   define output parameter p-sale-price as decimal   no-undo .
     6677   define output parameter p-pdf-id     as integer   no-undo .
     6678   define output parameter p-pdf-db-num as integer   no-undo .
     6679     do
     6680     on error undo, return error return-value
     6681     :
     6682   if p-fact-order = ? then do:
     6683     run fact-order-mpl (
     6684         input   today       ,
     6685         input   p-obj-type  ,
     6686         input   p-obj-code  ,
     6687         output  p-fact-order ) .
     6688   end.
     6689   assign
     6690     p-pdf-id      = ?
     6691     p-pdf-db-num  = ?
     6692     p-sale-price  = ?
     6693   .
     6694   define buffer buf_bar-code for ub.bar-code  .
     6695   define buffer buf_goods for ub.goods  .
     6696   find first buf_bar-code no-lock where
     6697              buf_bar-code.b-code = p-b-code
     6698              no-error .
     6699   if error-status :error then return error return-value .
     6700   find first buf_goods no-lock where
     6701              buf_goods.gds-code = buf_bar-code.gds-code
     6702              no-error .
     6703   if error-status :error then return error return-value .
     6704   define variable v-main-b-code as integer   no-undo .
     6705   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6706     (input  buf_goods.gds-code
     6707     ,input  ?
     6708     ,output v-main-b-code
     6709     )  .
     6710   define buffer buf_price-all for ub.price-all  .
     6711   for each tt_price-all : delete tt_price-all. end.
     6712       for each buf_price-all no-lock where
     6713               buf_price-all.plt-id     = p-plt-id                 and
     6714               buf_price-all.plt-db-num = p-plt-db-num             and
     6715               buf_price-all.obj-type   = p-obj-type               and
     6716               buf_price-all.obj-code   = p-obj-code               and
     6717               buf_price-all.gds-code   = buf_goods.gds-code       and
     6718             ( buf_price-all.b-code = v-main-b-code or
     6719               buf_price-all.b-code = p-b-code)    and
     6720               buf_price-all.status_    = 'акт':U         and
     6721               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     6722             ( buf_price-all.fact-order-sys-to = ? or
     6723               buf_price-all.fact-order-sys-to >=  p-fact-order)
     6724               :
     6725                 create tt_price-all .
     6726                 buffer-copy buf_price-all to tt_price-all
     6727                 assign
     6728                   tt_price-all.price-sale  = buf_price-all.price-sale
     6729                 .
     6730       end.
     6731   define variable vt-plt-id as integer   no-undo .
     6732   define variable vt-plt-db as integer   no-undo .
     6733   define variable vt-pdf-id as integer   no-undo .
     6734   define variable vt-pdf-db as integer   no-undo .
     6735   define buffer neos_price-all for tt_price-all  .
     6736   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     6737       if available tt_price-all then do:
     6738        assign
     6739          vt-plt-id = tt_price-all.plt-id
     6740          vt-plt-db = tt_price-all.plt-db-num
     6741          vt-pdf-id = tt_price-all.pdf-id
     6742          vt-pdf-db = tt_price-all.pdf-db
     6743        .
     6744        if tt_price-all.b-code = p-b-code then do:
     6745             assign
     6746               p-plt-id           = tt_price-all.plt-id
     6747               p-plt-db-num       = tt_price-all.plt-db-num
     6748               p-pdf-id           = tt_price-all.pdf-id
     6749               p-pdf-db-num       = tt_price-all.pdf-db
     6750               p-sale-price       = tt_price-all.price-sale
     6751               .
     6752        end.
     6753        else do:
     6754          find first neos_price-all where
     6755                     neos_price-all.b-code     = p-b-code  and
     6756                     neos_price-all.plt-id     = vt-plt-id and
     6757                     neos_price-all.plt-db-num = vt-plt-db and
     6758                     neos_price-all.pdf-id     = vt-pdf-id and
     6759                     neos_price-all.pdf-db     = vt-pdf-db
     6760                     use-index pi no-error .
     6761            if available neos_price-all then do:
     6762             assign
     6763               p-plt-id           = tt_price-all.plt-id
     6764               p-plt-db-num       = tt_price-all.plt-db-num
     6765               p-pdf-id           = tt_price-all.pdf-id
     6766               p-pdf-db-num       = tt_price-all.pdf-db
     6767               p-sale-price       = neos_price-all.price-sale
     6768               .
     6769            end.
     6770            else do:
     6771           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     6772           if error-status :error    then do:
     6773              message "Не найден бар-код" p-b-code view-as alert-box error .
     6774              return error return-value .
     6775           end.
     6776             assign
     6777               p-plt-id           = tt_price-all.plt-id
     6778               p-plt-db-num       = tt_price-all.plt-db-num
     6779               p-pdf-id           = tt_price-all.pdf-id
     6780               p-pdf-db-num       = tt_price-all.pdf-db
     6781               p-sale-price       = tt_price-all.price-sale * buf_bar-code.cli-base-rate
     6782               .
     6783            end.
     6784        end.
     6785     end.
     6786     end.
     6787   end procedure.
