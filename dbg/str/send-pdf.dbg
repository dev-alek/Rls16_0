    15167     (input  'маг':U
    15168     ,input  i-obj-code
    15169     ,output i-host-code
    15170     )  .
    15171          for each cash-gds no-lock,
    15172              first ub.bar-code no-lock where ub.bar-code.b-code = cash-gds.b-code :
    15173             if can-find(first ub.dis-gds-rule-attr where
