     1489   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1490   def var vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1491   define temp-table temp-drt-prop no-undo like ub.drt-prop.
     1492   procedure disrules-fill-properties:
     1493   define input  parameter p-templ-rl-root as integer   no-undo .
     1494   define buffer buf_drt-prop for ub.drt-prop.
     1495   define buffer buf_temp-drt-prop for temp-drt-prop.
     1496   do
     1497   on error undo, return error return-value
     1498   :
     1499     for each buf_temp-drt-prop:
     1500       delete buf_temp-drt-prop.
     1501     end.
     1502     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
     1503       create buf_temp-drt-prop.
     1504       buffer-copy buf_drt-prop to buf_temp-drt-prop.
     1505     end.
     1506   end.
     1507   end procedure.
     1508   ~
     1509   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1510   procedure discfgru-check :
     1511   define input parameter p-table-name as character no-undo .
     1512   define input parameter p-templ-rl-root as integer no-undo .
     1513   define input parameter p-time-templ-rl-root as integer no-undo .
     1514   define input parameter p-pos-type as character no-undo .
     1515   define output parameter p-disnct-role as character no-undo .
     1516   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     1517     do
     1518     on error undo, return error return-value
     1519     :
     1520       find first buf_dis-cfg-rule no-lock where
     1521               buf_dis-cfg-rule.table-name = p-table-name
     1522           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
     1523           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
     1524           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
     1525       if not available buf_dis-cfg-rule
     1526       or p-pos-type = "":U
     1527       then do:
     1528          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
     1529                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
     1530                                  , p-templ-rl-root
     1531                                  , (if p-time-templ-rl-root = ?
     1532                                     then '':U
     1533                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
     1534                                     )
     1535                                  ).
     1536       end.
     1537       assign
     1538       p-disnct-role = buf_dis-cfg-rule.discnt-role
     1539       .
     1540     end.
     1541   end procedure.
     1542   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1543   FUNCTION get-region RETURNS CHARACTER
     1544     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1545     define variable par-region as character no-undo.
     1546     if parhost-code = 0 and
     1547          parobj-type = "":U and
     1548          parobj-code = 0 then do:
     1549          par-region = "Глобально".
     1550          return par-region.
     1551       end.
     1552       if parobj-type = 'орг':U then do:
     1553          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1554          return par-region.
     1555       end.
     1556       if parobj-type = 'регион':U
     1557       then do:
     1558          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1559          return par-region.
     1560       end.
     1561       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1562       return par-region.
     1563   END FUNCTION.
     1564   FUNCTION get-objregion RETURNS CHARACTER
     1565     (  input parobj-type as character, input parobj-code as integer ) :
     1566     define variable par-region as character no-undo.
     1567     if  parobj-type = "":U and
     1568         parobj-code = 0
     1569     then do:
     1570        par-region = "Глобально".
     1571     end.
     1572     else if parobj-type = 'орг':U
     1573     then do:
     1574        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1575     end.
     1576     else if parobj-type = 'регион':U
     1577     then do:
     1578        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1579     end.
     1580     else
     1581        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1582     return par-region.
     1583   END FUNCTION.
     1584   procedure disgdsru-name :
     1585   define buffer buf_dis-rule for ub.dis-rule.
     1586   do
     1587     on error undo, return error
     1588     :
     1589     define input  parameter p-templ-rl-root  as integer no-undo .
     1590     define output parameter p-label          as character no-undo .
     1591     find first buf_dis-rule no-lock where
     1592               buf_dis-rule.rule-num = p-templ-rl-root no-error.
     1593     if available buf_dis-rule
     1594     then do:
     1595       if buf_dis-rule.rule-num > 0 then
     1596       p-label = buf_dis-rule.des.
     1597     end.
     1598     else do:
     1599       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
     1600     end.
     1601   end.
     1602   end procedure.
     1603   function disgdsru-get-disc-label returns character ( input p-templ-rl-root as integer):
     1604   define variable v-rule-label as character no-undo .
     1605   run disgdsru-name in this-procedure ( input p-templ-rl-root
     1606                                        ,output v-rule-label) no-error.
     1607   return v-rule-label.
     1608   end function.
     1609   function disgdsru-get-disc-role-label returns character ( input p-discnt-role as character):
     1610   define variable v-rule-label as character no-undo .
     1611   return entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u).
     1612   end function.
     1613   procedure disgdsru-write :
     1614     do
     1615     on error undo, return error
     1616     :
     1617       define input parameter p-obj-type       like ub.dis-gds-rule.obj-type   no-undo .
     1618       define input parameter p-obj-code       like ub.dis-gds-rule.obj-code   no-undo .
     1619       define input parameter p-gds-code       like ub.dis-gds-rule.gds-code   no-undo .
     1620       define input parameter p-pos-type       like ub.dis-gds-rule.pos-type   no-undo .
     1621       define input parameter p-discnt-role    like ub.dis-gds-rule.discnt-role no-undo .
     1622       define input parameter p-templ-rl-root  like ub.dis-gds-rule.templ-rl-root  no-undo .
     1623       define input parameter p-time-templ-rl-root  like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     1624       define input parameter p-rule-num       like ub.dis-gds-rule.rule-num    no-undo .
     1625       define input parameter p-nonunique      like ub.dis-gds-rule.nonunique   no-undo .
     1626       define buffer buf_dis-gds-rule for ub.dis-gds-rule .
     1627       define buffer buf_dis-rule for ub.dis-rule.
     1628       define buffer lock_dis-gds-rule for ub.dis-gds-rule .
     1629       define variable v-label          as character no-undo .
     1630       define variable v-discnt-role as character no-undo .
     1631       run discfgru-check in this-procedure (
     1632                                             input 'dis-gds-rule':U
     1633                                            ,input p-templ-rl-root
     1634                                            ,input p-time-templ-rl-root
     1635                                            ,input p-pos-type
     1636                                            ,output v-discnt-role
     1637                                             ) no-error .
     1638       if error-status :error then do:
     1639         undo, return error return-value .
     1640       end.
     1641       if p-discnt-role = ? then do:
     1642         p-discnt-role = v-discnt-role.
     1643       end.
     1644       if p-discnt-role <> v-discnt-role then do:
     1645         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не может быть по шаблону &7 и расписанию &8"
     1646                                 ,p-gds-code
     1647                                 ,p-obj-type
     1648                                 ,p-obj-code
     1649                                 ,p-pos-type
     1650                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1651                                 ,chr(10)
     1652                                 ,p-templ-rl-root
     1653                                 ,p-rule-num).
     1654       end.
     1655       if p-pos-type = ? then do:
     1656   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1657   define variable v-param-type20 as character no-undo .
     1658   define variable v-value-date20 as date no-undo .
     1659   define variable v-value-decimal20 as decimal no-undo .
     1660   define variable v-value-integer20 as INTEGER no-undo .
     1661   define variable v-value-logical20 AS LOGICAL no-undo .
     1662   define variable v-tth20 as handle no-undo .
     1663   run adm/shattri.p (
     1664       input "get":U
     1665       ,input  p-obj-type
     1666       ,input  p-obj-code
     1667       ,input  'cd-sending':U
     1668       ,input  'dflt-cd':U
     1669       ,output p-pos-type
     1670       ,output v-value-date20
     1671       ,output v-value-decimal20
     1672       ,output v-value-integer20
     1673       ,output v-value-logical20
     1674       ,output v-param-type20
     1675       ,INPUT-OUTPUT table-handle v-tth20
     1676       )  .
     1677   delete object v-tth20 no-error.
     1678       end.
     1679       find first buf_dis-rule no-lock where
     1680                 buf_dis-rule.rule-num = p-rule-num no-error.
     1681       if not available buf_Dis-rule then do:
     1682         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не найдено правило скидки &7"
     1683                                 ,p-gds-code
     1684                                 ,p-obj-type
     1685                                 ,p-obj-code
     1686                                 ,p-pos-type
     1687                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1688                                 ,chr(10)
     1689                                 ,p-rule-num).
     1690       end.
     1691       if buf_dis-rule.root <> yes then do:
     1692         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6правило скидки &7 - некорневое"
     1693                                 ,p-gds-code
     1694                                 ,p-obj-type
     1695                                 ,p-obj-code
     1696                                 ,p-pos-type
     1697                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1698                                 ,chr(10)
     1699                                 ,p-rule-num).
     1700       end.
     1701       if not (p-obj-type = buf_dis-rule.obj-type
     1702           and p-obj-code = buf_dis-rule.obj-code)
     1703       and not ( (p-obj-type = 'маг':U or p-obj-type = 'скл':U )
     1704                and
     1705                (buf_dis-rule.obj-type = 'орг':U or buf_dis-rule.obj-type = ""))
     1706        then do:
     1707         undo, return error (substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6"
     1708                                 ,p-gds-code
     1709                                 ,p-obj-type
     1710                                 ,p-obj-code
     1711                                 ,p-pos-type
     1712                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1713                                 ,chr(10)
     1714                                 ) +
     1715                             substitute("Правило скидки &1 определено для &2&3" +
     1716                                        "а привязка к товару для &4"
     1717                                        ,buf_dis-rule.rule-num
     1718                                        ,get-objregion( buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
     1719                                        ,chr(10)
     1720                                        ,get-objregion( p-obj-type, p-obj-code)
     1721                                        ))
     1722                                 .
     1723       end.
     1724       find first buf_dis-gds-rule exclusive-lock where
     1725                  buf_dis-gds-rule.gds-code  = p-gds-code
     1726              AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1727              AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1728              AND buf_dis-gds-rule.pos-type  = p-pos-type
     1729              AND buf_dis-gds-rule.discnt-role = p-discnt-role
     1730              and buf_dis-gds-rule.nonunique = p-nonunique
     1731              no-error .
     1732       if not available buf_dis-gds-rule then do:
     1733         find first buf_dis-gds-rule exclusive-lock where
     1734                   buf_dis-gds-rule.gds-code  = p-gds-code
     1735               AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1736               AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1737               AND buf_dis-gds-rule.pos-type  = p-pos-type
     1738               AND buf_dis-gds-rule.discnt-role = p-discnt-role
     1739               no-error .
     1740         if available buf_Dis-gds-rule then do:
     1741           if p-nonunique = ''
     1742           and available buf_dis-gds-rule
     1743           then do:
     1744             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует (детализ. &3)"
     1745                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1746                                      , p-gds-code
     1747                                      , buf_Dis-rule.obj-type
     1748                                      , buf_Dis-rule.obj-code
     1749                                      , p-nonunique
     1750                                     ).
     1751           end.
     1752           if available buf_dis-gds-rule
     1753           and buf_dis-gds-rule.nonunique = ''
     1754           and p-nonunique <> ''then do:
     1755             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует"
     1756                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1757                                      , p-gds-code
     1758                                      , buf_Dis-rule.obj-type
     1759                                      , buf_Dis-rule.obj-code
     1760                                     ).
     1761           end.
     1762         end.
     1763         create buf_dis-gds-rule .
     1764         assign
     1765         buf_dis-gds-rule.gds-code  = p-gds-code
     1766         buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1767         buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1768         buf_dis-gds-rule.pos-type = p-pos-type
     1769         buf_dis-gds-rule.discnt-role = v-discnt-role
     1770         buf_dis-gds-rule.rule-num = p-rule-num
     1771         buf_dis-gds-rule.nonunique = p-nonunique
     1772         no-error
     1773         .
     1774       end.
     1775       ASSIGN
     1776       buf_dis-gds-rule.rule-num = p-rule-num
     1777       buf_dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     1778       buf_dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     1779       buf_dis-gds-rule.templ-rl-root = p-templ-rl-root
     1780       buf_dis-gds-rule.nonunique = p-nonunique
     1781       no-error.
     1782     end.
     1783   end procedure.
     1784   PROCEDURE cmp-disgdsru-write :
     1785   do
     1786   on error undo, return error
     1787   :
     1788     define input parameter p-gds-code like ub.dis-gds-rule.gds-code   no-undo .
     1789     define input parameter p-obj-type like ub.dis-gds-rule.obj-type   no-undo .
     1790     define input parameter p-obj-code like ub.dis-gds-rule.obj-code   no-undo .
     1791     define input parameter p-pos-type like ub.dis-gds-rule.pos-type   no-undo .
     1792     define input parameter p-templ-rl-root     like ub.dis-gds-rule.templ-rl-root  no-undo .
     1793     define input parameter p-time-templ-rl-root     like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     1794     define input parameter p-discnt-role like ub.dis-gds-rule.discnt-role no-undo .
     1795     define input parameter p-rule-num    like ub.dis-gds-rule.rule-num no-undo .
     1796     define input parameter p-nonunique like ub.dis-gds-rule.nonunique no-undo .
     1797     define variable v-rule-label          as character no-undo .
     1798     define buffer buf_tt0-dis-gds-rule for ub.dis-gds-rule .
     1799     define buffer buf_dis-rule     for ub.dis-rule.
     1800     run disgdsru-name in this-procedure (
     1801                                         input  p-templ-rl-root
     1802                                         ,output v-rule-label
     1803                                         ) no-error .
     1804     if error-status :error then do:
     1805       undo, return error return-value .
     1806     end.
     1807     find first buf_tt0-dis-gds-rule exclusive-lock where
     1808                 buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     1809             AND buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     1810             AND buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     1811             AND buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     1812             AND buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     1813             AND buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1814             no-error .
     1815     if not available buf_tt0-dis-gds-rule then do:
     1816       create buf_tt0-dis-gds-rule .
     1817       assign
     1818       buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     1819       buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     1820       buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     1821       buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     1822       buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1823       buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     1824       no-error
     1825       .
     1826     end.
     1827     find first buf_dis-rule no-lock where
     1828               buf_dis-rule.rule-num = p-rule-num.
     1829     ASSIGN
     1830     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     1831     buf_tt0-dis-gds-rule.rule-num = p-rule-num
     1832     buf_tt0-dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     1833     buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1834     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     1835     buf_tt0-dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     1836     no-error.
     1837     release buf_tt0-dis-gds-rule no-error .
     1838     if error-status:error then do:
     1839       undo, return error return-value .
     1840     end.
     1841   end.
     1842   END PROCEDURE.
     1843   define variable vss-include-info21 as character format "X(65)" no-undo
     1844   initial "@(#)$Workfile$ $Revision$".
     1845   define variable v-bgelib-bgefmt        as character         no-undo.
