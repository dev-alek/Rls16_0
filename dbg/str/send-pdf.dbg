    13643   run cd-mrkt_update-marketer in this-procedure (
    13644                                                   input for-cash-desk.db-num
    13645                                                   ,input for-cash-desk.obj-code
    13646                                                   ,input for-cash-desk.pos-type
    13647                                                   ,input for-cash-desk.cash-num
    13648                                                   ,input no
    13649                                                 )  .
    13650       if
    13651   v-del-mrkt-gds
    13652       then do:
    13653   define variable vss-include-info113 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    13654   define variable vss-include-info114 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    13655   fname = substring( string( next-value( s-spool, ub ), '99999999999999999999'), 13, 8 ).
    13656       v-record = fill( chr(63) + chr(4), 7).
    13657   define variable v-marketer-action as character no-undo .
