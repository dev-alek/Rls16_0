      379   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      380   FUNCTION round-m RETURNS DECIMAL(input  mysum as decimal,
      381                                                                     input  orders as integer):
      382   define variable  round-m-sum as decimal no-undo.
      383   if orders >= 0 then
      384   round-m-sum = round(mysum,orders).
      385   else
      386   round-m-sum = round(mysum / exp(10, abs(orders)), 0) * EXP(10, abs(orders)).
      387   return round-m-sum.
      388   END FUNCTION.
      389   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      390   procedure factord :
      391     define input  parameter p-fact-date            as date    no-undo .
      392     define input  parameter p-fact-time            as integer no-undo .
      393     define input  parameter p-fact-num             as integer no-undo .
      394     define input  parameter p-shift-date           as date    no-undo .
      395     define input  parameter p-shift-num            as integer no-undo .
      396     define input  parameter p-shift-on             as logical no-undo .
      397     define output parameter p-fact-order           as decimal no-undo .
      398     define output parameter p-shift-end-fact-order as decimal no-undo .
      399     define output parameter p-day-end-fact-order   as decimal no-undo .
      400     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      401     if p-fact-date = ?
      402     then do:
      403       return error "Не указана фактическая дата" .
      404     end.
      405     define variable v-fact-date-num as integer no-undo .
      406     assign
      407       v-fact-date-num = integer(p-fact-date)
      408     .
      409     if p-fact-num = ?
      410     or p-fact-num = 0
      411     then do:
      412       return error "Не задан p-fact-num " + string(p-fact-num) .
      413     end.
      414     if p-fact-num < 0
      415     then do:
      416       return error "Отрицательный fact-num " + string(p-fact-num) .
      417     end.
      418     if p-fact-num >= 100000000
      419     then do:
      420       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      421     end.
      422     if p-shift-on = true
      423     then do:
      424       if p-shift-date = ?
      425       then do:
      426         return error "Не задана дата смены" .
      427       end.
      428       if p-shift-num = ?
      429       or p-shift-num = 0
      430       then do:
      431         return error "Не задан номер смены" .
      432       end.
      433     end.
      434     else do:
      435       assign
      436         p-shift-date = p-fact-date
      437         p-shift-num  = 24
      438       .
      439     end.
      440     define variable v-shift-offset as integer no-undo .
      441     if p-shift-date = p-fact-date
      442     then do:
      443       assign
      444         v-shift-offset = 1
      445       .
      446     end.
      447     if p-shift-date < p-fact-date
      448     then do:
      449       assign
      450         v-shift-offset = 0
      451       .
      452     end.
      453     if p-shift-date > p-fact-date
      454     then do:
      455       message
      456         vss-workfile vss-revision vss-description skip
      457         "Неправильная дата закрытия смены" skip
      458         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      459         view-as alert-box error .
      460       undo, return error
      461         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      462           ,string(p-fact-date, '99/99/9999':U)
      463           ,string(p-shift-date, '99/99/9999':U)
      464           )
      465       .
      466     end.
      467     if p-shift-num < 1
      468     or p-shift-num > 24
      469     then do:
      470       message
      471         vss-workfile vss-revision vss-description skip
      472         "Неправильный номер смены" skip
      473         "p-shift-num" p-shift-num skip
      474         view-as alert-box error .
      475       undo, return error return-value .
      476     end.
      477     assign
      478       p-fact-order           = v-fact-date-num
      479                              + v-shift-offset * 0.5
      480                              + p-shift-num    * 0.02 - 0.01
      481                              + p-fact-num     * 0.0000000001
      482       p-shift-end-fact-order = v-fact-date-num
      483                              + v-shift-offset * 0.5
      484                              + p-shift-num    * 0.02
      485       p-day-end-fact-order   = v-fact-date-num
      486                              + 0.99
      487     .
      488     if p-fact-order           <= v-fact-date-num
      489     or p-shift-end-fact-order <= v-fact-date-num
      490     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      491     or p-shift-end-fact-order >= p-day-end-fact-order
      492     then do:
      493       message
      494         vss-workfile vss-revision vss-description skip
      495         "Внутренняя ошибка при генерации фактического номера" skip
      496         "p-fact-date"            p-fact-date            skip
      497         "p-fact-time"            p-fact-time            skip
      498         "p-fact-num"             p-fact-num             skip
      499         "p-shift-date"           p-shift-date           skip
      500         "p-shift-num"            p-shift-num            skip
      501         "p-shift-on"             p-shift-on             skip
      502         "p-shift-end-fact-order" p-shift-end-fact-order skip
      503         "p-day-end-fact-order"   p-day-end-fact-order   skip
      504         "v-fact-date-num"        v-fact-date-num        skip
      505         view-as alert-box error .
      506       undo, return error return-value .
      507     end.
      508   end procedure.
      509   procedure day-begin-fact-order :
      510     define input  parameter p-fact-date            as date    no-undo .
      511     define output parameter p-day-begin-fact-order as decimal no-undo .
      512     do
      513     on error undo, return error return-value
      514     :
      515       if p-fact-date = ?
      516       then do:
      517         assign
      518           p-day-begin-fact-order = 0
      519         .
      520       end.
      521       else do:
      522         assign
      523           p-day-begin-fact-order = integer(p-fact-date)
      524         .
      525       end.
      526     end.
      527   end procedure.
      528   procedure factord-max-fact-order :
      529     define output parameter p-max-fact-order as decimal   no-undo .
      530     do
      531     on error undo, return error return-value
      532     :
      533       run day-begin-fact-order in this-procedure
      534         (input  date(1, 1, 5000)
      535         ,output p-max-fact-order
      536         ) .
      537     end.
      538   end procedure.
      539   procedure factord-cut-archive :
      540     define input  parameter p-obj-type             as character no-undo .
      541     define input  parameter p-obj-code             as integer   no-undo .
      542     define input  parameter p-fact-date            as date      no-undo .
      543     define output parameter p-shift-on             as logical   no-undo .
      544     define output parameter p-shift-date           as date      no-undo .
      545     define output parameter p-shift-num            as integer   no-undo .
      546     define output parameter p-day-end-fact-order   as decimal   no-undo .
      547     define output parameter p-shift-end-fact-order as decimal   no-undo .
      548     define variable v-fact-order as decimal   no-undo .
      549     define buffer buf_shift-obj for ub.shift-obj .
      550     do
      551     on error undo, return error return-value
      552     :
      553   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      554   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      555     (input  p-obj-type
      556     ,input  p-obj-code
      557     ,input  'shift-on=request'
      558     ,output p-shift-on
      559     ) no-error .
      560       if error-status :error
      561       then do:
      562         message
      563           vss-workfile vss-revision vss-description skip
      564           "Ошибка при определении атрибута объекта" skip
      565           "Объект" p-obj-type p-obj-code skip
      566           error-status :get-message(1) skip
      567           return-value skip
      568           view-as alert-box error .
      569         undo, return error return-value .
      570       end.
      571       if p-shift-on = false
      572       then do:
      573         assign
      574           p-shift-date               = ?
      575           p-shift-num                = 0
      576         .
      577       end.
      578       else do:
      579         find first buf_shift-obj share-lock
      580           where buf_shift-obj.obj-type   = p-obj-type
      581             and buf_shift-obj.obj-code   = p-obj-code
      582             and buf_shift-obj.shift-date > p-fact-date
      583           use-index pi
      584           no-error .
      585         if not available buf_shift-obj
      586         or buf_shift-obj.status_ <> 'зкр':U
      587         then do:
      588           message
      589             vss-workfile vss-revision vss-description skip
      590             "Невозможно вычислить последнюю смену" skip
      591             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      592             "Объект" p-obj-type p-obj-code skip
      593             "Дата" p-fact-date skip
      594             view-as alert-box error .
      595           undo, return error return-value .
      596         end.
      597         find last buf_shift-obj share-lock
      598           where buf_shift-obj.obj-type = p-obj-type
      599             and buf_shift-obj.obj-code = p-obj-code
      600             and buf_shift-obj.shift-date <= p-fact-date
      601           use-index pi
      602           no-error .
      603         if available buf_shift-obj
      604         then do:
      605           if  buf_shift-obj.status_ = 'зкр':U
      606           then do:
      607             assign
      608               p-shift-date = buf_shift-obj.shift-date
      609               p-shift-num  = buf_shift-obj.shift-num
      610             .
      611           end.
      612           else do:
      613             message
      614               vss-workfile vss-revision vss-description skip
      615               "Невозможно вычислить последнюю смену" skip
      616               "Статус смены отличен от статуса" 'зкр':U skip
      617               "Объект" p-obj-type p-obj-code skip
      618               "Дата" p-fact-date skip
      619               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      620               view-as alert-box error .
      621             undo, return error return-value .
      622           end.
      623         end.
      624         else do:
      625           assign
      626             p-shift-date = p-fact-date - 1
      627             p-shift-num  = 1
      628           .
      629         end.
      630       end.
      631       run factord in this-procedure
      632         (input  p-fact-date
      633         ,input  1
      634         ,input  1
      635         ,input  p-shift-date
      636         ,input  p-shift-num
      637         ,input  p-shift-on
      638         ,output v-fact-order
      639         ,output p-shift-end-fact-order
      640         ,output p-day-end-fact-order
      641         ) no-error .
      642       if error-status :error
      643       then do:
      644         message
      645           vss-workfile vss-revision vss-description skip
      646           "Ошибка при вызове процедуры factord"
      647           error-status :get-message(1) skip
      648           return-value skip
      649           view-as alert-box error .
      650         undo, return error return-value .
      651       end.
      652     end.
      653   end procedure.
      654   procedure factord-lock-shift :
      655     define input  parameter p-obj-type  as character no-undo .
      656     define input  parameter p-obj-code  as integer   no-undo .
      657     define input  parameter p-fact-date as date      no-undo .
      658     define parameter buffer buf_shift-obj for ub.shift-obj .
      659     define variable v-shift-on      as logical   no-undo .
      660     define variable v-extra-message as character no-undo .
      661     define variable v-error as character no-undo .
      662     do
      663     on error undo, return error return-value
      664     :
      665   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      666   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      667     (input  p-obj-type
      668     ,input  p-obj-code
      669     ,input  'shift-on=request'
      670     ,output v-shift-on
      671     ) no-error .
      672       if error-status :error
      673       then do:
      674         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      675         undo, return error v-error .
      676       end.
      677       if v-shift-on = true
      678       then do:
      679         find first buf_shift-obj share-lock
      680           where buf_shift-obj.obj-type   = p-obj-type
      681             and buf_shift-obj.obj-code   = p-obj-code
      682             and buf_shift-obj.shift-date > p-fact-date
      683           use-index pi
      684           no-error .
      685         if not available buf_shift-obj
      686         or buf_shift-obj.status_ <> 'зкр':U
      687         then do:
      688           find last buf_shift-obj
      689             where buf_shift-obj.obj-type = p-obj-type
      690               and buf_shift-obj.obj-code = p-obj-code
      691               and buf_shift-obj.status_  = 'зкр':U
      692             use-index stts
      693             no-error .
      694           if available buf_shift-obj
      695           then do:
      696             assign
      697               v-extra-message =
      698                     substitute("Дата начала последеней закрытой смены на объекте &1"
      699                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      700                               )
      701             .
      702           end.
      703           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      704           undo, return error v-error .
      705         end.
      706       end.
      707     end.
      708   end procedure.
      709   procedure factord-end-day :
      710     define input  parameter p-fact-date            as date    no-undo .
      711     define output parameter p-day-end-fact-order   as decimal no-undo .
      712     do
      713     on error undo, return error return-value
      714     :
      715       if p-fact-date = ?
      716       then do:
      717         return error "Не указана фактическая дата" .
      718       end.
      719       assign
      720         p-day-end-fact-order = integer(p-fact-date) + 0.99
      721       .
      722     end.
      723   end procedure.
      724   procedure factord-to-date :
      725     define input  parameter p-fact-order as decimal no-undo .
      726     define output parameter p-fact-date  as date    no-undo .
      727     define variable v-ref-date  as date      no-undo .
      728     define variable v-ref-delta as integer   no-undo .
      729     do
      730     on error undo, return error return-value
      731     :
      732       if p-fact-order = ?
      733       or p-fact-order = 0
      734       then do:
      735         return error "Не указан fact-order" .
      736       end.
      737       assign
      738         v-ref-date  = date(1, 1, 2000)
      739       .
      740       assign
      741         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      742       .
      743       assign
      744         p-fact-date = v-ref-date + v-ref-delta
      745       .
      746     end.
      747   end procedure.
      748   procedure factord-to-fact-num :
      749     define input  parameter p-fact-order as decimal no-undo .
      750     define output parameter p-fact-num   as integer no-undo .
      751     define variable v-fact-order-trunc as decimal no-undo .
      752     do
      753     on error undo, return error return-value
      754     :
      755       if p-fact-order = ?
      756       or p-fact-order = 0
      757       then do:
      758         return error "Не указан fact-order" .
      759       end.
      760       assign
      761        v-fact-order-trunc = truncate(p-fact-order, 2)
      762       .
      763       assign
      764         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      765       .
      766     end.
      767   end procedure.
      768   procedure factord-to-shift-num :
      769     define input  parameter p-fact-order as decimal no-undo .
      770     define output parameter p-shift-num   as integer no-undo .
      771     define variable  p-shift-numd  as decimal   no-undo .
      772     define variable v-fact-order-trunc as decimal no-undo .
      773     do
      774     on error undo, return error return-value
      775     :
      776       if p-fact-order = ?
      777       or p-fact-order = 0
      778       then do:
      779         return error "Не указан fact-order" .
      780       end.
      781       assign
      782        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      783       .
      784       if v-fact-order-trunc < 0.5 then do:
      785         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      786       end.
      787       assign
      788         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      789         .
      790        assign
      791         p-shift-num = truncate (p-shift-numd , 0)
      792       .
      793     end.
      794   end procedure.
      795   define new global shared variable g#lib-trn  as handle no-undo .
      796   define new global shared variable g#lib-trn2 as handle no-undo .
      797   define new global shared variable g#lib-trn3 as handle no-undo .
      798   define new global shared variable g#lib-trn4 as handle no-undo .
      799   define temp-table  tt-tax no-undo
      800     field tax-code    like ub.tax.tax-code
      801     field individual  like ub.tax.individual
      802     field tax-name    like ub.tax.tax-name format "x(12)" column-label "Налог"
      803     field rate-code   like ub.tax-rate.rate-code
      804     field rate-name   like ub.tax-rate.rate-name format "x(12)"
      805     field tax-type    like ub.tax.tax-type
      806     field rate-value  like ub.tax-rate-value.rate-value
      807     field tax-rate-gds-rc  as recid
      808     field to-cashdesk like ub.tax.to-cashdesk
      809     index tax-code is unique primary tax-code
      810     .
      811   procedure tax-val :
      812     define input  parameter       parartic      like ub.doc-line.artic     no-undo.
      813     define input  parameter       parprod-type  like ub.doc-line.prod-type no-undo.
      814     define input  parameter       parprod-code  like ub.doc-line.prod-code no-undo.
      815     define input  parameter       parunit-base  like ub.goods.unit-base    no-undo.
      816     define input  parameter       parnode-code  like ub.gds-prt.node-code  no-undo.
      817     define input  parameter       parunits-type like ub.units.type         no-undo.
      818     define input  parameter       parrec-id     as recid                   no-undo.
      819     define input  parameter       paris-log     as logical                 no-undo.
      820     define input  parameter       rdtaxcdvalue  as integer                 no-undo.
      821     define input  parameter       vattaxcdvalue as integer                 no-undo.
      822     define input  parameter       exctaxcdvalue as integer                 no-undo.
      823     define input  parameter       only-check    as logical                 no-undo.
      824     define input  parameter       parhost-code  like ub.sysconf.host-code  no-undo.
      825     define input  parameter       parobj-type   like ub.clients.obj-type   no-undo.
      826     define input  parameter       parobj-code   like ub.clients.obj-code   no-undo.
      827     define input  parameter       parroad-tax   like ub.doc-line.road-tax  no-undo.
      828     define input  parameter       parexcise     like ub.doc-line.excise    no-undo.
      829     define output parameter       parerr-mes    as character               no-undo.
      830     define input-output parameter parprice-sale like ub.price-list.price-sale no-undo.
      831     do
      832     on error undo, return error return-value
      833     :
      834   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      835   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
      836   define variable gp-price-sale like ub.price-list.price-sale no-undo.
      837   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
      838   define variable gp-excise     like ub.price-list.excise     no-undo.
      839   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
      840   define variable gp-fact-order as decimal   no-undo .
      841   define variable gp-price-sale-parts as decimal   no-undo .
      842       define buffer buf_tax          for ub.tax .
      843       define buffer buf_tax-rate     for ub.tax-rate .
      844       define buffer buf_tax-units    for ub.tax-units .
      845       define buffer buf_tax-rate-gds for ub.tax-rate-gds .
      846       define buffer buf_goods        for ub.goods .
      847       define buffer buf_bar-code     for ub.bar-code .
      848       define buffer buf_prod-bc      for ub.prod-bc .
      849       define buffer buf_units        for ub.units .
      850       define buffer buf_shop         for ub.shop .
      851       define buffer buf_store        for ub.store .
      852       define buffer buf_gds-prt      for ub.gds-prt .
      853       define buffer buf_tt-tax       for tt-tax .
      854       define variable varrate-value    as decimal   initial ? no-undo.
      855       define variable pr-list-recid    as recid     initial ? no-undo.
      856       define variable varmes           as character no-undo.
      857       define variable varfactorrtvalue as char      initial ? no-undo.
      858       define variable varfactorrttype  as char      initial ? no-undo.
      859       define variable is-petrolium     as logical no-undo.
      860       define variable is-pieces        as logical no-undo.
      861       define variable vargds-code      like ub.goods.gds-code no-undo.
      862       define variable pargds-code      like ub.goods.gds-code no-undo.
      863       define variable var-fact-order   as decimal no-undo .
      864       define variable currate-code     like buf_tax-rate.rate-code no-undo .
      865       define variable currate-name     like buf_tax-rate.rate-name no-undo .
      866       define variable currate-gds-rc   as recid no-undo .
      867       define variable v-today          as date no-undo .
      868       define variable v-time           as integer no-undo .
      869       for each buf_tt-tax:
      870         delete buf_tt-tax.
      871       end.
      872       run cur-time in this-procedure(output v-today, output v-time).
      873       run factord-end-day in this-procedure (input v-today, output var-fact-order).
      874       if parartic     = ?
      875       or parprod-type = ?
      876       or parprod-code = ?
      877       or parunit-base = ?
      878       then do:
      879         find first buf_goods no-lock
      880           where recid(buf_goods) = parrec-id
      881           no-error .
      882       end.
      883       else do:
      884         find first buf_goods no-lock
      885           where buf_goods.artic = parartic
      886             and buf_goods.prod-type = parprod-type
      887             and buf_goods.prod-code = parprod-code
      888           no-error .
      889       end.
      890       if not available buf_goods then do:
      891         assign varmes = "Ошибка при поиске товара. Программа tax-val.i" + chr(10) .
      892         if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      893       end.
      894       assign
      895         parartic     = buf_goods.artic
      896         parprod-type = buf_goods.prod-type
      897         parprod-code = buf_goods.prod-code
      898         parunit-base = buf_goods.unit-base
      899         pargds-code  = buf_goods.gds-code
      900       .
      901       if parunits-type = ?
      902       then do:
      903         find buf_units no-lock
      904           where buf_units.unit-name = parunit-base
      905           no-error .
      906         if not available buf_units then do:
      907           assign
      908             varmes =  varmes + "Ошибка при поиске единицы измерения. Программа tax-val.i" + chr(10)
      909           .
      910           if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      911         end.
      912         assign
      913           parunits-type = buf_units.type
      914         .
      915       end.
      916       if parhost-code = ?
      917       or parhost-code = 0
      918       then do:
      919   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      920   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      921     (input  parobj-type
      922     ,input  abs(parobj-code)
      923     ,output parhost-code
      924     ) no-error .
      925         if error-status :error then do:
      926           assign
      927             varmes =  varmes + substitute("Ошибка при определении фирмы для объекта &1 &2. Программа tax-val.i"
      928               ,string(parobj-type)
      929               ,string(parobj-code)
      930               ) + chr(10)
      931           .
      932           if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      933         end.
      934       end.
      935       assign
      936         vargds-code = buf_goods.gds-code
      937       .
      938       for each buf_tax-units no-lock
      939         where LOOKUP(buf_tax-units.type, parunits-type) > 0
      940       ,first buf_tax no-lock
      941         where buf_tax.tax-code = buf_tax-units.tax-code
      942       :
      943         find first buf_tt-tax where
      944                    buf_tt-tax.tax-code = buf_tax.tax-code no-error .
      945         if not available buf_tt-tax then do:
      946           create buf_tt-tax .
      947         end.
      948         assign
      949           buf_tt-tax.tax-code = buf_tax.tax-code
      950         .
      951         if buf_tax.individual = false then do:
      952           assign
      953             currate-gds-rc = ?
      954           .
      955           _tax-rate-gds:
      956           for each buf_tax-rate-gds no-lock where
      957                   buf_tax-rate-gds.gds-code = pargds-code and
      958                   buf_tax-rate-gds.tax-code = buf_tax.tax-code,
      959           first buf_tax-rate where
      960                 buf_tax-rate.tax-code  = buf_tax-rate-gds.tax-code and
      961                 buf_tax-rate.rate-code = buf_tax-rate-gds.rate-code no-lock
      962           by buf_tax-rate-gds.host-code
      963           by buf_tax-rate-gds.obj-type
      964           by buf_tax-rate-gds.obj-code
      965           by buf_tax-rate-gds.fact-order
      966           :
      967             if buf_tax-rate-gds.fact-order > var-fact-order then do:
      968               next _tax-rate-gds.
      969             end.
      970             if buf_tax-rate-gds.host-code = 0 or
      971               ((buf_tax-rate-gds.host-code = parhost-code) or
      972               (buf_tax-rate-gds.obj-type = parobj-type AND
      973               buf_tax-rate-gds.obj-code = parobj-code))
      974             then do:
      975               assign
      976               currate-code = buf_tax-rate.rate-code
      977               currate-name = buf_tax-rate.rate-name
      978               currate-gds-rc = recid(buf_tax-rate)
      979               .
      980             end.
      981             else do:
      982               next _tax-rate-gds.
      983             end.
      984           end.
      985           if currate-gds-rc = ? then do:
      986             assign varmes = "Не найдена ставка налога: "  + string(buf_tt-tax.tax-code) + " " + buf_tt-tax.tax-name +
      987                             " к товару: " + parartic + " " + parprod-type + " " + string(parprod-code) +
      988                             chr(10).
      989             if paris-log then do:                       parerr-mes = parerr-mes + varmes.                       return "error".                   end.                   else do:                         message varmes view-as alert-box error.                         return error.                   end.
      990           end.
      991         end.
      992         assign
