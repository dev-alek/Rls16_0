    15175                           and ub.dis-gds-rule-attr.obj-type = ""
    15176                           and ub.dis-gds-rule-attr.obj-code = 0
    15177                           and ub.dis-gds-rule-attr.pos-type = 'NCR-AS@R':U) then
    15178             do:
