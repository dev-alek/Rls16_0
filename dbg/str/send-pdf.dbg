    16231                  assign v-tmpchar = "" .
    16232   define variable vss-include-info138 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    16233     define variable tmp-str138  as character no-undo.
    16234     define variable tmp-num138  as character no-undo.
    16235     define variable i138        as integer   no-undo.
    16236     define variable sum138      as integer   no-undo.
    16237     define variable len-code138 as integer   no-undo.
    16238     define variable varcont138  as logical   initial yes no-undo.
    16239     CASE ncrsc-frmt :
    16240       WHEN "EAN13" THEN do:
    16241         assign
    16242           tmp-str138 = string( decimal(string(integer( v-ean13 ), '99999':U) + '00000':U), "999999999999" )
    16243         .
    16244       end.
    16245       WHEN "EAN8" THEN do:
    16246         assign
    16247           tmp-str138 = string( decimal(string(integer( v-ean13 ), '99999':U) + '00000':U), "9999999" )
    16248         .
    16249       end.
    16250       OTHERWISE DO:
    16251           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " ncrsc-frmt " ."
    16252           view-as alert-box error.
    16253           return error.
    16254       END.
    16255     END CASE.
    16256     if varcont138 = yes then do:
    16257       if integer( substring( tmp-str138, 1, length( ncrsc-pfx ) ) ) <> 0
    16258       then do:
    16259         message
    16260           "Невозможно сформировать бар-код" SKIP
    16261           "для товара с кодом: " decimal(string(integer( v-ean13 ), '99999':U) + '00000':U)
    16262           view-as alert-box error title "подрезание кода".
    16263         return error.
    16264       end.
    16265       else do:
    16266         assign
    16267           v-tmpchar = ncrsc-pfx + substring( tmp-str138, length( ncrsc-pfx ) + 1, length( tmp-str138 ) - length( ncrsc-pfx ) )
    16268           len-code138    = length( v-tmpchar )
    16269         .
    16270         define variable v-sum-char138 as character no-undo .
    16271         assign
    16272           sum138 = 0
    16273         .
    16274         do i138 = 1 to len-code138 by 2
    16275         :
    16276           assign
    16277             v-sum-char138 = substr(v-tmpchar, len-code138 - i138 + 1, 1)
    16278           .
    16279           if v-sum-char138 < "0"
    16280           or v-sum-char138 > "9"
    16281           then do:
    16282             message
    16283               "Невозможно сформировать бар-код" skip
    16284               "для товара с кодом: " decimal(string(integer( v-ean13 ), '99999':U) + '00000':U) skip
    16285               view-as alert-box error title "подсчет контрольной суммы".
    16286             return error.
    16287           end.
    16288           assign
    16289             sum138 = sum138 + integer(v-sum-char138)
    16290           .
    16291         end.
    16292         if varcont138 = yes then do:
    16293           assign
    16294             sum138 = sum138 * 3
    16295           .
    16296           do i138 = 2 to len-code138 by 2
    16297           :
    16298             assign
    16299               v-sum-char138 = substr(v-tmpchar, len-code138 - i138 + 1, 1)
    16300             .
    16301             if v-sum-char138 < "0"
    16302             or v-sum-char138 > "9"
    16303             then do:
    16304               message
    16305                 "Невозможно сформировать бар-код" skip
    16306                 "для товара с кодом: " decimal(string(integer( v-ean13 ), '99999':U) + '00000':U) skip
    16307                 view-as alert-box error title "подсчет контрольной суммы".
    16308               return error.
    16309             end.
    16310             assign
    16311               sum138 = sum138 + integer(v-sum-char138)
    16312             .
    16313           end.
    16314           if varcont138 = yes then do:
    16315              if sum138 mod 10 = 0 then do:
    16316                assign
    16317                  v-tmpchar = v-tmpchar + '0'
    16318                .
    16319              end.
    16320              else do:
    16321                assign
    16322                  v-tmpchar = v-tmpchar + string(10 - sum138 mod 10)
    16323                .
    16324              end.
    16325           end.
    16326         end.
    16327       end.
    16328     end.
    16329                  if not v-tmpchar = "":U then assign v-ean13 = v-tmpchar .
    16330              end.
    16331              if v-ean13 begins "20" and length(v-ean13) = 13 then next _bdr-attr .
    16332        put stream IBMStream unformatted v-ver v-char-delim-1 v-upd v-char-delim-1
    16333         buf_dis-gds-rule-attr.attr-code v-char-delim-1
    16334         "3,MAPKA,"
    16335         entry(1,iso-date(buf_dis-time-rule.date-from),"-") + entry(2,iso-date(buf_dis-time-rule.date-from),"-") + entry(3,iso-date(buf_dis-time-rule.date-from),"-") v-char-delim-1
