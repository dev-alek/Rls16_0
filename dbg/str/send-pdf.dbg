    14799   _do26:
    14800   do vdr-26 = 1 to 3:
    14801     CASE vdr-26:
    14802       when 1 then do:
    14803         assign
    14804         vc-obj-code = ub.shop.obj-code
    14805         vc-obj-type = 'маг':U
    14806         vc-host-code = ub.shop.host-code
    14807         vc-region    = substitute("&1&2", vc-obj-type, vc-obj-code)
    14808         .
    14809       end.
    14810       when 2 then do:
    14811         assign
    14812         vc-obj-code = 0
    14813         vc-obj-type = '':U
    14814         vc-host-code = ub.shop.host-code
    14815         vc-region    = substitute("Фирма &1&2", vc-host-code)
    14816         .
    14817       end.
    14818       when 3 then do:
    14819         assign
    14820         vc-obj-code = 0
    14821         vc-obj-type = '':U
    14822         vc-host-code = 0
    14823         vc-region    = "Глобально"
    14824         .
    14825       end.
    14826     END CASE.
    14827     find ub.dis-rule no-lock where
    14828                   ub.dis-rule.upper-rule-num = 26
    14829               and ub.dis-rule.host-code = vc-host-code
    14830               AND ub.dis-rule.obj-type = vc-obj-type
    14831               AND ub.dis-rule.obj-code = vc-obj-code no-error .
    14832     if available ub.dis-rule then LEAVE _do26.
    14833   end.
    14834   if available ub.dis-rule then do:
    14835     for each buf_dis-rule no-lock where
    14836             buf_dis-rule.upper-rule-num = ub.dis-rule.rule-num :
    14837       assign
    14838       ncrgmdsc = ncrgmdsc + (if ncrgmdsc = "":U then "":U else ";") +
    14839                   string(buf_dis-rule.dis-kat) + "=":U +
    14840                   string(buf_dis-rule.discnt-value).
    14841     end.
    14842   end.
