    10056   define variable vss-include-info78 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10057   procedure ibm-gdsc :
    10058   define input  parameter p-zeros         as logical no-undo .
    10059   define output parameter IBM-good-code as character no-undo .
    10060   define output parameter IBM-good-code-2 as character no-undo .
    10061   define output parameter IBM2-short      as character no-undo .
    10062   define variable v-delim as character no-undo .
    10063   define variable v-format-str-16 as character no-undo .
    10064     do
    10065     on error undo, return error
    10066     :
    10067       if p-zeros then do:
    10068         assign
    10069         v-delim = '0'
    10070         v-format-str-16 =  "9999999999999999"
    10071         .
    10072       end.
    10073       else do:
    10074         assign
    10075         v-delim = chr(32)
    10076         v-format-str-16 =  ">>>>>>>>>>>>>>>9"
    10077         .
    10078       end.
    10079       if cash-gds.b-str = "" then do:
    10080         assign
    10081         b_code = string( cash-gds.b-code, v-format-str-16 ) .
    10082         if  LOOKUP( 'вес':U, cash-gds.unit-type ) = 0
    10083         or cash-gds.unit-base <> cash-gds.unit-cli
    10084         or (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0  and not ub.shop.cd-sc-base)
    10085         then
    10086         do:
    10087           if ((ub.shop.cd-bc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
    10088               (ub.shop.cd-bc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
    10089             RUN gen-bc( input cash-gds.b-code, output bar_code ).
    10090             iBM2-short = bar_code.
    10091             IBM-good-code  = string( fill( v-delim, 16 - length( trim( bar_code ) ) ) + trim( bar_code ), "9999999999999999" ) .
    10092           END.
    10093           if ((ub.shop.cd-loc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
    10094               (ub.shop.cd-loc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
    10095             IBM-good-code-2 = b_code.
    10096           end.
    10097         end.
    10098       end.
    10099       else do:
    10100         IBm-good-code =
    10101         ( if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
    10102           (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    10103            or
    10104            cash-gds.bc-on-type = 'pglc':U)
    10105         then string( decimal( cash-gds.b-str ), v-format-str-16)
    10106         else string( fill( v-delim, 16 - length( trim( cash-gds.b-str ) ) ) + trim( cash-gds.b-str ), "9999999999999999" ) ).
    10107       end.
    10108     end.
    10109   end procedure.
    10110   define variable vss-include-info79 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10111   procedure ncr-gdsc :
    10112   define output parameter IBM-good-code as character no-undo .
    10113   define output parameter IBM-good-code-2 as character no-undo .
    10114   define output parameter is-sc as logical no-undo .
    10115   define output parameter p-taracode-bc as character no-undo .
    10116   define variable v-taracode-bc as character no-undo .
    10117   define variable v-type as character no-undo .
    10118   define variable v-bc-buf as character no-undo .
    10119   define variable iii as integer no-undo .
    10120     do
    10121     on error undo, return error
    10122     :
    10123       if cash-gds.b-str = "" then do:
    10124         assign
    10125         b_code = string(cash-gds.b-code,'>>>>>>>>>>>>9').
    10126         if  LOOKUP( 'вес':U, cash-gds.unit-type ) = 0 or cash-gds.unit-base <> cash-gds.unit-cli then do:
    10127           if ((ub.shop.cd-bc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
    10128               (ub.shop.cd-bc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
    10129             RUN gen-bc( input cash-gds.b-code, output bar_code ).
    10130             IBM-good-code  = fill( " ", 13 - length( trim( bar_code ) ) ) + trim( bar_code ).
    10131           end.
    10132           if ((ub.shop.cd-loc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
    10133               (ub.shop.cd-loc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
    10134             IBM-good-code-2 = b_code.
    10135           end.
    10136         end.
    10137       end.
    10138       else do:
    10139         if cash-gds.b-str begins "*" then cash-gds.b-str = left-trim(cash-gds.b-str, "*").
    10140         IBm-good-code = ( if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
    10141                             (LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    10142                              or
    10143                              cash-gds.bc-on-type = 'pglc':U)
    10144                           then string( integer( cash-gds.b-str ), ">>>>>>>>>>>>9" )
    10145                           else string( fill( " ", 13 - length( trim( cash-gds.b-str ) ) ) +
    10146                                       trim( cash-gds.b-str ), "9999999999999" ) ).
    10147          if action <> "D":U then do:
    10148           is-sc = no.
    10149           find first request_prod-bc no-lock where
    10150                     request_prod-bc.b-str = cash-gds.b-str no-error .
    10151           if not avail request_prod-bc then do :
    10152             if mask_s-c <> "" then do :
    10153               iii_ :
    10154               do iii = 1 to num-entries(mask_s-c) :
    10155                 if length(cash-gds.b-str) = (num-entries(entry(iii, mask_s-c), '*') - 1) then do :
    10156                   v-bc-buf = trim(entry(1, entry(iii, mask_s-c), '*') + cash-gds.b-str).
    10157                   find first request_prod-bc no-lock where request_prod-bc.b-str = v-bc-buf no-error .
    10158                   if available request_prod-bc then leave iii_ .
    10159                 end.
    10160               end.
    10161             end.
    10162           end.
    10163           if avail request_prod-bc then do :
    10164             if LOOKUP( 'вес':U, cash-gds.unit-type ) > 0 then do:
    10165   define variable vss-include-info80 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10166   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
    10167     (buffer request_prod-bc
    10168     ,input  'scaleable=request'
    10169     ,output is-sc
    10170     ) no-error .
    10171             end.
    10172             if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
    10173                LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    10174                then do:
    10175   define variable vss-include-info81 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10176     define variable tmp-str81  as character no-undo.
    10177     define variable tmp-num81  as character no-undo.
    10178     define variable i81        as integer   no-undo.
    10179     define variable sum81      as integer   no-undo.
    10180     define variable len-code81 as integer   no-undo.
    10181     define variable varcont81  as logical   initial yes no-undo.
    10182     CASE ncrsc-frmt :
    10183       WHEN "EAN13" THEN do:
    10184         assign
    10185           tmp-str81 = string( decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U), "999999999999" )
    10186         .
    10187       end.
    10188       WHEN "EAN8" THEN do:
    10189         assign
    10190           tmp-str81 = string( decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U), "9999999" )
    10191         .
    10192       end.
    10193       OTHERWISE DO:
    10194           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " ncrsc-frmt " ."
    10195           view-as alert-box error.
    10196           return error.
    10197       END.
    10198     END CASE.
    10199     if varcont81 = yes then do:
    10200       if integer( substring( tmp-str81, 1, length( ncrsc-pfx ) ) ) <> 0
    10201       then do:
    10202         message
    10203           "Невозможно сформировать бар-код" SKIP
    10204           "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U)
    10205           view-as alert-box error title "подрезание кода".
    10206         return error.
    10207       end.
    10208       else do:
    10209         assign
    10210           IBm-good-code = ncrsc-pfx + substring( tmp-str81, length( ncrsc-pfx ) + 1, length( tmp-str81 ) - length( ncrsc-pfx ) )
    10211           len-code81    = length( IBm-good-code )
    10212         .
    10213         define variable v-sum-char81 as character no-undo .
    10214         assign
    10215           sum81 = 0
    10216         .
    10217         do i81 = 1 to len-code81 by 2
    10218         :
    10219           assign
    10220             v-sum-char81 = substr(IBm-good-code, len-code81 - i81 + 1, 1)
    10221           .
    10222           if v-sum-char81 < "0"
    10223           or v-sum-char81 > "9"
    10224           then do:
    10225             message
    10226               "Невозможно сформировать бар-код" skip
    10227               "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U) skip
    10228               view-as alert-box error title "подсчет контрольной суммы".
    10229             return error.
    10230           end.
    10231           assign
    10232             sum81 = sum81 + integer(v-sum-char81)
    10233           .
    10234         end.
    10235         if varcont81 = yes then do:
    10236           assign
    10237             sum81 = sum81 * 3
    10238           .
    10239           do i81 = 2 to len-code81 by 2
    10240           :
    10241             assign
    10242               v-sum-char81 = substr(IBm-good-code, len-code81 - i81 + 1, 1)
    10243             .
    10244             if v-sum-char81 < "0"
    10245             or v-sum-char81 > "9"
    10246             then do:
    10247               message
    10248                 "Невозможно сформировать бар-код" skip
    10249                 "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U) skip
    10250                 view-as alert-box error title "подсчет контрольной суммы".
    10251               return error.
    10252             end.
    10253             assign
    10254               sum81 = sum81 + integer(v-sum-char81)
    10255             .
    10256           end.
    10257           if varcont81 = yes then do:
    10258              if sum81 mod 10 = 0 then do:
    10259                assign
    10260                  IBm-good-code = IBm-good-code + '0'
    10261                .
    10262              end.
    10263              else do:
    10264                assign
    10265                  IBm-good-code = IBm-good-code + string(10 - sum81 mod 10)
    10266                .
    10267              end.
    10268           end.
    10269         end.
    10270       end.
    10271     end.
    10272             end.
    10273             if ( cash-gds.unit-cli = cash-gds.unit-base ) AND
    10274                cash-gds.bc-on-type = 'pglc':U
    10275                then do:
    10276   define variable vss-include-info82 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10277     define variable tmp-str82  as character no-undo.
    10278     define variable tmp-num82  as character no-undo.
    10279     define variable i82        as integer   no-undo.
    10280     define variable sum82      as integer   no-undo.
    10281     define variable len-code82 as integer   no-undo.
    10282     define variable varcont82  as logical   initial yes no-undo.
    10283     CASE ncrpg-frmt :
    10284       WHEN "EAN13" THEN do:
    10285         assign
    10286           tmp-str82 = string( decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U), "999999999999" )
    10287         .
    10288       end.
    10289       WHEN "EAN8" THEN do:
    10290         assign
    10291           tmp-str82 = string( decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U), "9999999" )
    10292         .
    10293       end.
    10294       OTHERWISE DO:
    10295           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " ncrpg-frmt " ."
    10296           view-as alert-box error.
    10297           return error.
    10298       END.
    10299     END CASE.
    10300     if varcont82 = yes then do:
    10301       if integer( substring( tmp-str82, 1, length( ncrpg-pfx ) ) ) <> 0
    10302       then do:
    10303         message
    10304           "Невозможно сформировать бар-код" SKIP
    10305           "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U)
    10306           view-as alert-box error title "подрезание кода".
    10307         return error.
    10308       end.
    10309       else do:
    10310         assign
    10311           IBm-good-code = ncrpg-pfx + substring( tmp-str82, length( ncrpg-pfx ) + 1, length( tmp-str82 ) - length( ncrpg-pfx ) )
    10312           len-code82    = length( IBm-good-code )
    10313         .
    10314         define variable v-sum-char82 as character no-undo .
    10315         assign
    10316           sum82 = 0
    10317         .
    10318         do i82 = 1 to len-code82 by 2
    10319         :
    10320           assign
    10321             v-sum-char82 = substr(IBm-good-code, len-code82 - i82 + 1, 1)
    10322           .
    10323           if v-sum-char82 < "0"
    10324           or v-sum-char82 > "9"
    10325           then do:
    10326             message
    10327               "Невозможно сформировать бар-код" skip
    10328               "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U) skip
    10329               view-as alert-box error title "подсчет контрольной суммы".
    10330             return error.
    10331           end.
    10332           assign
    10333             sum82 = sum82 + integer(v-sum-char82)
    10334           .
    10335         end.
    10336         if varcont82 = yes then do:
    10337           assign
    10338             sum82 = sum82 * 3
    10339           .
    10340           do i82 = 2 to len-code82 by 2
    10341           :
    10342             assign
    10343               v-sum-char82 = substr(IBm-good-code, len-code82 - i82 + 1, 1)
    10344             .
    10345             if v-sum-char82 < "0"
    10346             or v-sum-char82 > "9"
    10347             then do:
    10348               message
    10349                 "Невозможно сформировать бар-код" skip
    10350                 "для товара с кодом: " decimal(string(integer( cash-gds.b-str ), '99999':U) + '00000':U) skip
    10351                 view-as alert-box error title "подсчет контрольной суммы".
    10352               return error.
    10353             end.
    10354             assign
    10355               sum82 = sum82 + integer(v-sum-char82)
    10356             .
    10357           end.
    10358           if varcont82 = yes then do:
    10359              if sum82 mod 10 = 0 then do:
    10360                assign
    10361                  IBm-good-code = IBm-good-code + '0'
    10362                .
    10363              end.
    10364              else do:
    10365                assign
    10366                  IBm-good-code = IBm-good-code + string(10 - sum82 mod 10)
    10367                .
    10368              end.
    10369           end.
    10370         end.
    10371       end.
    10372     end.
    10373             end.
    10374           end.
    10375         end.
    10376       end.
    10377       if LOOKUP( 'вес':U, cash-gds.unit-type ) > 0
    10378       and (LOOKUP( 'дро':U, cash-gds.unit-cli-type ) > 0
    10379             or
    10380             LOOKUP( 'вес':U, cash-gds.unit-cli-type ) > 0)
    10381       then do:
    10382           run bc-oattr_value in this-procedure ( input cash-gds.b-code
    10383                                               ,input 'taracode-bc':U
    10384                                               ,input 'маг':U
    10385                                               ,input i-obj-code
    10386                                               ,output v-taracode-bc
    10387                                               ,output v-type) no-error.
    10388           if not error-status:error
    10389           and v-taracode-bc <> '' then do:
    10390             is-sc = yes.
    10391             p-taracode-bc = v-taracode-bc.
    10392           end.
    10393       end.
    10394     end.
    10395   end procedure.
    10396   procedure finish-send :
    10397     do
    10398     on error undo, return error
    10399     :
    10400   define variable vss-include-info83 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10401   if v-view-log
    10402   and not g#news
    10403   and not g#auto
    10404   then do:
    10405     message
    10406     '!!!При отсылке информации на кассы произошли ошибки!!!'  skip
    10407     "!!!Внимательно прочитайте Log-file!!"
    10408     view-as alert-box error .
    10409        define variable v-user-action84   as character no-undo .
    10410     define variable v-printed84       as logical   no-undo .
    10411     run gbl/prnfilen.w
    10412       (input  ('!!!При отсылке информации на кассы произошли ошибки!!!')
    10413       ,input  0
    10414       ,input  (string("./":U) + log-file-name)
    10415       ,input  7
    10416       ,output v-user-action84
    10417       ,output v-printed84
    10418       ) .
    10419   end.
    10420   if v-view-log = true
    10421   and (g#news
    10422   or g#auto)
    10423   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
    10424   then do:
    10425      run cb_set-view-log in p-parent-handle ( input yes).
    10426   end.
    10427       define variable v-save-file-name as character no-undo .
    10428       v-save-file-name = substitute("&1send-cd.log", ibs.th.gbl.gbl-inipar:logDir) .
    10429       OS-APPEND value(log-file-name) value(v-save-file-name).
    10430       OS-DELETE value(log-file-name).
    10431     end.
    10432   end procedure.
    10433   define variable vss-include-info85 as character format "x(65)" no-undo initial "@(#)$Workfile: putc-gds.i $ $Revision: b8cfd3560a3b, 3573, rls $".
    10434   PROCEDURE putc-gds.
    10435   define parameter buffer buf_cash-desk for ub.cash-desk.
    10436   define input parameter pos-type as char no-undo.
    10437   define input parameter p-version like ub.cash-desk.version no-undo .
    10438   define input parameter p-cash-os like ub.cash-desk.cash-os no-undo .
    10439   define variable ff  as  int     no-undo.
    10440   define variable gg  as  int     no-undo.
    10441   DEFINE VARIABLE second-name as character no-undo.
    10442   define variable nam-2str-shift as integer no-undo .
    10443   define variable v-length as integer no-undo .
    10444   DEFINE VARIABLE IBM-good-code-2 as character no-undo .
    10445   define variable std-disc-dec as decimal no-undo .
    10446   define variable std-disc-reason as integer no-undo .
    10447   define variable std-disc-lim as date no-undo .
    10448   define variable temp-disc-dec as decimal no-undo .
    10449   define variable temp-disc-reason as integer no-undo .
    10450   define variable temp-disc-start as date no-undo .
    10451   define variable temp-disc-end as date no-undo .
    10452   define variable temp-disc-time-start as integer no-undo .
    10453   define variable temp-disc-time-end as integer no-undo .
    10454   define variable temp-disc-weekday as integer no-undo .
    10455   define variable v-version-dec as decimal no-undo .
    10456   define variable v-kat-num as integer no-undo .
    10457   define variable v-kat-discnt as decimal no-undo .
    10458   define variable v-time-rule-num like ub.dis-rule.time-rule-num no-undo .
    10459   define variable IBM2-short as character no-undo .
    10460   define variable v-what-find as character no-undo .
    10461   define variable v-plu as character no-undo .
    10462   define variable v-pl-code as integer no-undo .
    10463   define variable v-marketer-action as character no-undo .
    10464   define variable v-versiond as decimal no-undo .
    10465   define variable v-b-code-to-find as logical no-undo .
    10466   define variable v-maria-discnt-value as character no-undo .
    10467   define variable v-ii as integer no-undo .
    10468   define variable v-dop as character no-undo .
    10469   define variable v-gds-rule-num as integer no-undo .
    10470   define variable v-maria-rule-num as integer no-undo .
    10471   define variable v-discreteness as character no-undo .
    10472   define variable wd-option as integer no-undo .
    10473   define variable wgd-option as integer no-undo .
    10474   define variable v-type as logical   no-undo .
    10475   define variable  s as char no-undo.
    10476   define variable articul as char no-undo.
    10477   define variable v-disc-price-sale as decimal no-undo .
    10478   define variable v-pdf-id as integer no-undo .
    10479   define variable v-pdf-db-num as integer no-undo .
    10480   define buffer buf_cash-dis-rule for cash-dis-rule .
    10481   define buffer buf_cd-plu for ub.cd-plu.
    10482   define buffer buf_dis-rule for ub.dis-rule.
    10483   define buffer buf_place for ub.place.
    10484   define buffer buf_pl-gds for ub.pl-gds.
    10485   define buffer bcash-gds for cash-gds.
    10486   define buffer buf_cash-desk-attr for cash-desk-attr.
    10487   define variable vcash-desk-stndart as logical no-undo init yes.
    10488   assign
    10489   v-version-dec = decimal(p-version)
    10490   no-error .
    10491   if buf_cash-desk.autonomy = integer('2':U)
    10492   then do:
    10493      vcash-desk-stndart = no.
    10494   end.
    10495     if buf_cash-desk.device-kind = 2 then vcash-desk-stndart = no.
    10496   define variable is-petrol   as logical   no-undo.
    10497   define variable is-pieces   as logical   no-undo.
    10498   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
    10499     (
    10500        input cash-gds.artic
    10501     ,  input ?
    10502     ,  input cash-gds.gds-code
    10503     , output is-petrol
    10504     , output is-pieces
    10505     ) NO-ERROR.
    10506   if     not vcash-desk-stndart
    10507      and not is-petrol
    10508   then
    10509      return.
    10510   if cash-gds.std-discnt-rule > 0 then do:
    10511     find first cash-dis-rule no-lock where
    10512               cash-dis-rule.rule-num =  cash-gds.std-discnt-rule no-error .
    10513     if available cash-dis-rule then do:
    10514       find first cash-dis-time-rule no-lock where
    10515                 cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num no-error .
    10516       assign
    10517       std-disc-dec = - cash-dis-rule.discnt-value
    10518       std-disc-reason = 0
    10519       no-error
    10520       .
    10521       if available cash-dis-time-rule then do:
    10522         assign
    10523         std-disc-lim = cash-dis-time-rule.date-to
    10524         .
    10525         if std-disc-lim <> 12/31/1989 and std-disc-lim < today then
    10526         assign
    10527         std-disc-dec = 0
    10528         std-disc-reason = 0
    10529         .
    10530         if cash-dis-time-rule.date-to <> 12/31/1989 and cash-dis-time-rule.date-from > today then
    10531         assign
    10532         std-disc-dec = 0
    10533         std-disc-reason = 0
    10534         .
    10535       end.
    10536     end.
    10537   end.
    10538   if cash-gds.wd > 1 then do:
    10539     find first cash-dis-rule no-lock where
    10540               cash-dis-rule.rule-num =  cash-gds.wd-rule no-error .
    10541     if available cash-dis-rule then  do:
    10542       assign
    10543       wd-option = integer(cash-dis-rule.discnt-value).
    10544     end.
    10545   end.
    10546   if cash-gds.wd = 1 then do:
    10547      wd-option = 1.
    10548   end.
    10549   if cash-gds.wgd > 0 then do:
    10550     find first cash-dis-rule no-lock where
    10551               cash-dis-rule.rule-num =  cash-gds.wgd-rule no-error .
    10552     if available cash-dis-rule then  do:
    10553       assign
    10554       wgd-option = integer(cash-dis-rule.discnt-value).
    10555     end.
    10556   end.
    10557   if cash-gds.temp-discnt-rule <> 0 then do:
    10558     assign
    10559     temp-disc-dec = 0
    10560     .
    10561     find first cash-dis-rule no-lock where
    10562               cash-dis-rule.rule-num = cash-gds.temp-discnt-rule no-error .
    10563     if available cash-dis-rule
    10564              and cash-dis-rule.is-term = yes then do:
    10565       if cash-dis-rule.time-rule-num > 0 then do:
    10566         find first cash-dis-time-rule no-lock where
    10567                     cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num no-error .
    10568         if available cash-dis-time-rule
    10569         and cash-dis-time-rule.templ-rl-root = 50001
    10570             or
    10571             (
    10572              (
    10573               (cash-dis-time-rule.date-from < today)
    10574               or
    10575               (cash-dis-time-rule.date-from = 12/31/1989)
    10576              )
    10577             and
    10578             (
    10579              (cash-dis-time-rule.date-to >= today)
    10580              or
    10581              (cash-dis-time-rule.date-to = 12/31/1989)
    10582             )
    10583            ) then do:
    10584            temp-disc-dec = ?.
    10585         end.
    10586         else do:
    10587           assign
    10588           temp-disc-dec = 0
    10589           .
    10590         end.
    10591       end.
    10592       else do:
    10593         temp-disc-dec = ?.
    10594       end.
    10595       if temp-disc-dec = ? then do:
    10596         case cash-dis-rule.value-type:
    10597           when integer('1':U) then do:
    10598         assign
    10599         temp-disc-dec = - cash-dis-rule.discnt-value
    10600         .
    10601       end.
    10602           when integer('11':U) then do:
    10603             find first cash-gds-discnt where
    10604                       cash-gds-discnt.b-code = cash-gds.b-code
    10605                   and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
    10606                   and cash-gds-discnt.obj-type = 'маг':U
    10607                   and cash-gds-discnt.obj-code = i-obj-code
    10608                   no-error.
    10609             if available cash-gds-discnt then do:
    10610               assign
    10611               temp-disc-dec = - (cash-gds.price-sale - cash-gds-discnt.discnt-value) / cash-gds.price-sale * 100
    10612               .
    10613             end.
    10614             else do:
    10615              assign
    10616               temp-disc-dec = 0.
    10617             end.
    10618           end.
    10619           otherwise do:
    10620             temp-disc-dec = 0.
    10621           end.
    10622         end case.
    10623       end.
    10624     end.
    10625   end.
    10626   CASE pos-type:
    10627     when 'MAGIA-XML':U
    10628     then do:
    10629       if cash-gds.b-str <> "":U then do:
    10630         return.
    10631       end.
    10632       assign
    10633       chk_name = replace(cash-gds.gds-name, chr(34), "":U) + cash-gds.f-name
    10634       .
    10635       if cash-gds.unit-base <> cash-gds.unit-cli then
    10636       assign
    10637       chk_name = string(substr(chk_name, 1, max(33, 50 - 1 - length(trim(string(cash-gds.cli-base-rate), chr(32))))) +
    10638                         "*":U +
    10639                         trim(string( cash-gds.cli-base-rate ), chr(32)), "x(50)":U ).
    10640       else
    10641       chk_name = string(chk_name, "X(50)":U).
    10642       assign
    10643       second-name = replace(cash-gds.gds-namelong, chr(39), "":U)
    10644       second-name =   (chr(34) +
    10645                         TRIM(CAPS(string( replace(second-name, chr(34), "":U), "X(40)":U )))
    10646                         + chr(34) )
    10647       .
    10648       if cash-gds.unit-base <> cash-gds.unit-cli then
    10649       assign
    10650       second-name = string(substr(second-name, 1, max(23, 40 - 1 - length(trim(string(cash-gds.cli-base-rate), chr(32))))  ) +
    10651                         "*":U +
    10652                         trim(string(cash-gds.cli-base-rate), chr(32)), "x(40)":U ).
    10653       else
    10654       second-name = string(second-name, "X(40)":U).
    10655       if tax-cass AND cash-gds.new-good then do:
    10656           for each cash-txr No-LOCK WHERE
    10657                     cash-txr.rc = cash-gds.rc AND
    10658                     cash-txr.host-code = ub.shop.host-code AND
    10659                     cash-txr.obj-type = 'маг':U AND
    10660                     cash-txr.obj-code = ub.shop.obj-code:
    10661             run putc-13(buffer buf_cash-desk
    10662                       , input pos-type
    10663                       , input p-cash-os
    10664                       , input yes
    10665                       ).
    10666           end.
    10667       end.
    10668   define variable vss-include-info86 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10669   define variable mi-entry as integer no-undo .
    10670   define variable v-out-code like ub.fbr-gds-grp.out-code no-undo .
    10671   define variable v-out-code-0 like ub.fbr-gds-grp.out-code no-undo .
    10672   define variable v-global-code like ub.fbr-gds-grp.global-code no-undo .
    10673   define variable v-xml-vat like ub.tax-rate-value.rate-value no-undo .
    10674   define variable v-xml-slt like ub.tax-rate-value.rate-value no-undo .
    10675   define buffer buf_fbr-gds-grp for ub.fbr-gds-grp.
    10676   define buffer buf_tax-rate for ub.tax-rate.
    10677   find first buf_fbr-gds-grp no-lock where
    10678              buf_fbr-gds-grp.obj-type = 'маг':U
    10679          AND buf_fbr-gds-grp.obj-code = i-obj-code
    10680         AND buf_fbr-gds-grp.node-code = cash-gds.fbr-grp-code no-error .
    10681   if avail buf_Fbr-gds-grp then do:
    10682     assign
    10683     v-out-code = buf_fbr-gds-grp.out-code
    10684     v-global-code = buf_fbr-gds-grp.global-code
    10685     .
    10686   end.
    10687   else do:
    10688     assign
    10689     v-global-code = cash-gds.fbr-grp-code-0
    10690     .
    10691   end.
    10692   if v-global-code  > 0
    10693   then do:
    10694     find first buf_fbr-gds-grp no-lock where
    10695               buf_fbr-gds-grp.obj-type = "":U
    10696           AND buf_fbr-gds-grp.obj-code = 0
    10697           AND buf_fbr-gds-grp.node-code = v-global-code no-error .
    10698     if avail buf_Fbr-gds-grp then do:
    10699       assign
    10700       v-out-code-0 = buf_fbr-gds-grp.out-code
    10701       .
    10702     end.
    10703     else do:
    10704       v-out-code-0 = 0.
    10705     end.
    10706   end.
    10707   if v-out-code = 0
    10708   and cash-gds.is-modificator = 0
    10709   then do:
    10710       run write-log-and-file in p-log-handle (
    10711             input 1
    10712           , input log-file-name
    10713           , input 1
    10714           , input substitute("!!!Ошибка при получении характеристик товара &1 &2 на объекте: &3"
    10715                               , cash-gds.gds-code
    10716                               , cash-gds.gds-name
    10717                               , "не указана группа меню на кассе"
    10718                               )
    10719                                 ).
    10720       assign
    10721       v-view-log = yes
    10722       .
    10723   end.
    10724   if v-out-code <> 0
    10725   or v-is-modificator
    10726   then do:
    10727     run bgelib-tag-open in this-procedure ( input 2, input "Item", input substitute("ctrl='&1' tms='&2' code='&3'", (if action = "U":U then "ADD" else "DEL":U), OS2-time, cash-gds.b-code)).
    10728     run bgelib-tag-put in this-procedure ( input 3, input "ItemName"       , input trim(second-name, chr(32)), input 1 ).
    10729     run bgelib-tag-put in this-procedure ( input 3, input "ItemAltName"    , input trim(chk_name, chr(34)), input 1 ).
    10730     run bgelib-tag-put in this-procedure ( input 3, input "ItemMainPrice"  , input string(0), input 1 ).
    10731     run bgelib-tag-put in this-procedure ( input 3, input "ItemPriceCurrency"  , input string(v-r-b-curr-magia), input 1 ).
    10732     run bgelib-tag-put in this-procedure ( input 3, input "ItemGroup"      , input string( if v-out-code-0 = 0 then 9998 else v-out-code-0), input 1 ).
    10733     run bgelib-tag-put in this-procedure ( input 3, input "ItemDepartId"   , input string( cash-gds.departid ), input 1 ).
    10734     run bgelib-tag-put in this-procedure ( input 3, input "ItemLock"       , input (if action = "U":U then string(0) else string(1)), input 1 ).
    10735     run bgelib-tag-open in this-procedure ( input 3, input "ItemStatus"        ,       input "" ).
