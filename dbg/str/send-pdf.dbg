    15180                leave.
    15181             end.
    15182             if can-find(first ub.dis-gds-rule-attr where
    15183                               ub.dis-gds-rule-attr.gds-code = ub.bar-code.gds-code
    15184                           and ub.dis-gds-rule-attr.obj-type = 'орг':U
    15185                           and ub.dis-gds-rule-attr.obj-code = i-host-code
    15186                           and ub.dis-gds-rule-attr.pos-type = 'NCR-AS@R':U) then
    15187             do:
    15188                v-found-good = yes.
    15189                leave.
