    12607   define buffer buf_dis-rule for ub.dis-rule.
    12608   define buffer buf_place for ub.place.
    12609   define buffer buf_pl-gds for ub.pl-gds.
    12610   FOR EACH for-cash-desk NO-LOCK WHERE
    12611           for-cash-desk.db-num = g#db-num AND
    12612           for-cash-desk.pos-type = ub.cash-desk.pos-type AND
    12613           for-cash-desk.obj-code = i-obj-code AND
    12614    for-cash-desk.cash-on  = yes
    12615       BREAK
    12616       BY for-cash-desk.db-num
    12617       BY for-cash-desk.obj-code
    12618       BY for-cash-desk.pos-type
    12619       BY for-cash-desk.cash-on
    12620       BY for-cash-desk.cash-num
    12621       :
    12622     if LOOKUP(ub.cash-desk.pos-type,
    12623               ('NCR-GM':U + chr(44) +
    12624                'IBM-XML':U + chr(44) +
    12625                'MAGIA-XML':U + chr(44) +
    12626                'NCR-AS@R':U  + chr(44) +
    12627                'Autotank':U
    12628                  )) > 0
    12629     and for-cash-desk.autonomy = integer('1':U) then NEXT.
    12630     if LOOKUP(ub.cash-desk.pos-type,
    12631               'MARIA':U
    12632                  ) > 0 then do:
    12633       if for-cash-desk.autonomy = integer('2':U) then do:
    12634         assign
    12635         v-cd-list-update = for-cash-desk.addr-path
    12636         v-cd-list-delete = for-cash-desk.addr-path
    12637         .
    12638         NEXT.
    12639       end.
    12640       else do:
    12641         if v-cd-list-update = '':U then nExt.
    12642       end.
    12643     end.
    12644     run write-log-and-file in p-log-handle (
    12645           input 1
