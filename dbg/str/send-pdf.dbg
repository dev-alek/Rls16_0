    13528      if can-find(temp-tekka-tsk where temp-tekka-tsk.task-num = fname and temp-tekka-tsk.obj-num = 6 )
    13529      or can-find(temp-tekka-tsk where temp-tekka-tsk.task-num = fname and temp-tekka-tsk.obj-num = 13 )
    13530      then do:
    13531        v-fields-shift112 = - 1.
