     8406           end.
     8407         end.
     8408         else do:
     8409           kat-discnt-rule_pdf = 0.
     8410         end.
     8411       end.
     8412     end case.
     8413   end.
     8414    run fill-temp-cd in this-procedure ( input g#db-num, input 'маг':U, input i-obj-code, input yes).
     8415    if can-find(first temp-cd where
     8416                     temp-cd.obj-code = i-obj-code
     8417                AND  (temp-cd.pos-type = 'IBM-XML':U
     8418                     or
     8419                     temp-cd.pos-type = 'Autotank':U
     8420                     )
     8421                AND  temp-cd.db-num = g#db-num
     8422                ) then do:
     8423     if index(name-2cd,"GTD":U) = 0 then
     8424     assign
     8425     name-2cd = name-2cd + "-":U + "GTD":U.
     8426   end.
     8427   run adm/shattri.p (
     8428     input "get":U
