     8333   assign
     8334   v-tth = buffer thbjattr_thbj-attr:table-handle .
     8335   run adm/shattri.p (
     8336       input "get":U
     8337       ,input  'маг':U
     8338       ,input  i-obj-code
     8339       ,input  'cd-inf-send':U
     8340       ,input  '':U
     8341       ,output v-value-character
     8342       ,output v-value-date
     8343       ,output v-value-decimal
     8344       ,output v-value-integer
     8345       ,output v-value-logical
     8346       ,output v-param-type
     8347       ,INPUT-OUTPUT table-handle v-tth
     8348       ) no-error .
     8349   if error-status:error then return error .
     8350   for each thbjattr_thbj-attr where
