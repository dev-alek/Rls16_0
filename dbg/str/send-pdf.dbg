    13590       delete temp-tekka-tsk.
    13591     end.
    13592     run write-log-and-file in p-log-handle (
    13593           input 1
    13594         , input log-file-name
    13595         , input 1
    13596         , input substitute( "!!!Прерван обмен информацией с кассой &1,&2&3&2на кассе осталась устаревшая информация"
    13597                              ,for-cash-desk.cash-num
    13598                              ,chr(10)
    13599                              ,return-value
    13600                           )
    13601                                           ).
