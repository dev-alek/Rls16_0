    14177      or can-find(temp-tekka-tsk where temp-tekka-tsk.task-num = fname and temp-tekka-tsk.obj-num = 13 )
    14178      then do:
    14179        v-fields-shift117 = - 1.
    14180   if v-record <> '':U then
    14181       run maria-put in this-procedure (
    14182                                       buffer for-cash-desk
    14183                                     , input out
    14184                                     , input fname
    14185                                     , input yes
    14186                                     , input v-fields-shift117
    14187                                     , input yes
    14188                                     , input 24
    14189                                     , input 1
    14190                                     , input string(1)
    14191                                     , input v-record
    14192                                       ).
    14193      end.
    14194   find first temp-tekka-tsk no-error.
    14195   if available temp-tekka-tsk then do:
    14196      v-found117 = yes.
    14197   end.
    14198   if v-found117 = yes then do:
    14199   output stream IBmSTREAM to VALUE(out + fname + '.tsk').
    14200   v-is-script117 = no.
    14201   for each temp-tekka-tsk:
    14202     if (temp-tekka-tsk.num-rec > 0
    14203     or temp-tekka-tsk.send-get = 'task')
    14204     and temp-tekka-tsk.task-num = fname then do:
    14205       export stream IBmSTREAM temp-tekka-tsk.
    14206       v-found117 = yes.
    14207     end.
    14208     if temp-tekka-tsk.is-script then do:
    14209       v-is-script117 = yes.
    14210     end.
    14211     delete temp-tekka-tsk.
    14212   end.
    14213   output stream IBMStream
    14214   close.
