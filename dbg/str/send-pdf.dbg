     8354   on error undo, return error :
     8355     case thbjattr_thbj-attr.prop-code:
     8356       when 'nam-artc':U then do:
     8357         nam-artc = thbjattr_thbj-attr.property-value-logical.
     8358       end.
     8359       when 'cod-pcod':U then do:
     8360         cod-pcod = thbjattr_thbj-attr.property-value-logical.
     8361       end.
     8362       when 'tax-cass':U then do:
     8363         tax-cass = thbjattr_thbj-attr.property-value-logical.
     8364       end.
     8365       when 'nam-2str':U then do:
     8366         nam-2str = thbjattr_thbj-attr.property-value-logical.
     8367       end.
     8368       when 'name-2cd':U then do:
     8369         name-2cd = thbjattr_thbj-attr.property-value-character.
     8370       end.
     8371       when 'amntdisc':U then do:
     8372         amntdisc = thbjattr_thbj-attr.property-value-integer.
     8373       end.
     8374       when 'how-temp-disc':U then do:
     8375         how-temp-disc = thbjattr_thbj-attr.property-value-character.
     8376         if how-temp-disc = 'temp-disc-pdf':U then do:
     8377           run get-thbj-rule in this-procedure ( input 'маг':U
