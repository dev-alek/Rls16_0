    15447   PROCEDURE putc-13.
    15448   define parameter buffer buf_cash-desk for ub.cash-desk.
    15449   define input parameter pos-type as char no-undo.
    15450   define input parameter p-cash-os like ub.cash-desk.cash-os no-undo .
    15451   define input parameter p-call-from-goods as logical no-undo .
    15452   define variable ii as integer no-undo .
    15453   define variable v-rate-code like ub.tax-rate.rate-code no-undo .
    15454   define variable v-envd as LOGICAL no-undo .
    15455   define variable v-plu as integer no-undo .
    15456   define buffer buf_tax-rate for ub.tax-rate.
    15457   define buffer buf_tax-rate-attr for ub.tax-rate-attr.
    15458   if cash-txr.rate-value = ?
    15459   and not (cash-txr.news-action OR cash-txr.status_ <> 'тек':U)
    15460   then do:
    15461       run write-log-and-file in p-log-handle (
    15462             input 1
    15463           , input log-file-name
    15464           , input 1
    15465           , input substitute( "!!!Для маг &1 ставка налога &2 НЕ ОПРЕДЕЛЕНА"
    15466                               ,buf_cash-desk.obj-code
    15467                               ,cash-txr.rate-code
    15468                             )
    15469                                             ).
    15470       v-view-log = yes.
    15471       return '':U .
    15472   end.
    15473   CASE pos-type:
    15474     when 'IBM':U then do:
    15475      if cd-vat = 0 or p-cash-os = "LINUX":U then do:
    15476         PUT stream IBMstream unformatted
    15477         '13 "'
    15478         if cash-txr.news-action OR cash-txr.status_ <> 'тек':U
    15479         then "D"
    15480         else string( action, "x(1)" )
    15481         '" '
    15482         cash-txr.tax-code format "9"
    15483         ' '
    15484         cash-txr.rate-code
    15485         ' '
    15486         (if cash-txr.tax-type = '%':U then 2 else 1) format "9"
    15487         (if cash-txr.rate-value = ?
    15488           then 0
    15489           else cash-txr.rate-value) format ">>>>>>>>>9.99"
    15490         chr(10).
    15491       end.
    15492       else do:
    15493         _do:
    15494         do ii = 1 to num-entries(cdtaxlst, ";":U):
    15495           assign
    15496           v-rate-code = integer(entry(1, entry(ii, cdtaxlst, ";":U), "-":U))
    15497           no-error .
    15498           if error-status:error then do:
    15499             message
    15500             "Неверное значение настроечного параметра cdtaxlst" cdtaxlst
    15501             view-as alert-box error .
    15502             return error .
    15503           end.
    15504           find first buf_tax-rate no-lock where
    15505                     buf_tax-rate.rate-code = v-rate-code no-error .
    15506           if not available buf_tax-rate then do:
    15507             run write-log-and-file in p-log-handle (
    15508                   input 1
    15509                 , input log-file-name
    15510                 , input 1
    15511                 , input substitute( "!!!Для маг &1 ставка налога &2 не входит в число действующих на кассе &2"
    15512                                     ,buf_cash-desk.obj-code
    15513                                     ,v-rate-code
    15514                                     ,buf_Cash-desk.pos-type
    15515                                   )
    15516                                                   ).
    15517             v-view-log = yes.
    15518             return error .
    15519           end.
    15520           if buf_tax-rate.rate-code = cash-txr.rate-code then do:
    15521             PUT stream IBMstream unformatted
    15522             '13 "'
    15523             if cash-txr.news-action OR cash-txr.status_ <> 'тек':U
    15524             then "D"
    15525             else string( action, "x(1)" )
    15526             '" '
    15527             convert-tax-code(buf_tax-rate.rate-code, cdtaxlst)  format "9"
    15528             ' '
    15529             cash-txr.rate-code
    15530             ' '
    15531             (if cash-txr.tax-type = '%':U then 2 else 1) format "9"
    15532             (if cash-txr.rate-value = ?
    15533             then 0
    15534             else cash-txr.rate-value) format ">>>>>>>>>9.99"
    15535             chr(10).
    15536           end.
    15537         end.
    15538       end.
    15539     end.
    15540     when 'IBM-XML':U then do:
    15541         find first buf_tax-rate-attr where buf_tax-rate-attr.rate-code = cash-txr.rate-code
    15542                                        and buf_tax-rate-attr.tax-code = cash-txr.tax-code
    15543                                        and buf_tax-rate-attr.attr-code = "envd" no-error .
    15544          if AVAILABLE buf_tax-rate-attr then do:
    15545              v-envd = yes .
    15546          end.
    15547          else v-envd = no .
    15548       run bgelib-tag-open in this-procedure ( input 3, input "TaxCodes"
    15549                                             , input "":U).
    15550       run bgelib-tag-put in this-procedure ( input 4, input "TCCode"
    15551                                             , input string(cash-txr.rate-code), input 1 ).
    15552       run bgelib-tag-put in this-procedure ( input 4, input "TCType"
    15553                                             , input string((if cash-txr.tax-type = '%':U then 2 else 1)), input 1 ).
    15554       if v-envd then do:
    15555       run bgelib-tag-put in this-procedure ( input 4, input "TCValue"
    15556                                             , input string(-1), input 1 ).
    15557       end.
    15558       else do:
    15559       run bgelib-tag-put in this-procedure ( input 4, input "TCValue"
    15560                                             , input string(if cash-txr.rate-value = ?
    15561                                                            then 0
    15562                                                            else cash-txr.rate-value), input 1 ).
    15563       end.
    15564       run bgelib-tag-put in this-procedure ( input 4, input "TCInclude"
    15565                                             , input string(1), input 1 ).
    15566       run bgelib-tag-close in this-procedure ( input 3, input "TaxCodes").
    15567     end.
    15568     when 'MAGIA-XML':U then do:
    15569       run bgelib-tag-open in this-procedure ( input 3, input "TaxCodes"
    15570                                             , input "":U).
    15571       run bgelib-tag-put in this-procedure ( input 4, input "TCCode"
    15572                                             , input string(cash-txr.rate-code), input 1 ).
    15573       run bgelib-tag-put in this-procedure ( input 4, input "TCType"
    15574                                             , input string((if cash-txr.tax-type = '%':U then 2 else 1)), input 1 ).
    15575       run bgelib-tag-put in this-procedure ( input 4, input "TCValue"
    15576                                             , input string(if cash-txr.rate-value = ?
    15577                                                            then 0
    15578                                                            else cash-txr.rate-value), input 1 ).
    15579       run bgelib-tag-put in this-procedure ( input 4, input "TCInclude"
    15580                                             , input string(1), input 1 ).
    15581       run bgelib-tag-put in this-procedure ( input 4, input "TCLock"
    15582                                             , input string(if cash-txr.news-action
    15583                                                            OR cash-txr.status_ <> 'тек':U
    15584                                                            then 1
    15585                                                            else 0), input 1 ).
    15586       run bgelib-tag-close in this-procedure ( input 3, input "TaxCodes").
    15587     end.
    15588     when 'MARIA':U then do:
    15589     end.
    15590   END CASE .
    15591   END PROCEDURE .
    15592   procedure get-o-attr :
    15593   define input parameter par-gds-code like ub.goods.gds-code no-undo .
    15594   define input parameter par-obj-code like ub.clients.obj-code no-undo .
    15595   define input parameter par-obj-type like ub.clients.obj-type no-undo .
    15596   define output parameter par-std-discnt-rule as integer no-undo .
    15597   define output parameter par-temp-disc-rule as integer no-undo .
    15598   define output parameter par-temp-disc-method as character no-undo .
    15599   define output parameter par-wd-rule as integer no-undo .
    15600   define output parameter par-fp as logical no-undo .
    15601   define output parameter par-grp-code as integer no-undo init 1.
    15602   define output parameter par-petrol-purse as logical no-undo .
    15603   define output parameter par-need-auth as logical no-undo .
    15604   define output parameter par-qnty-discnt-rule as integer no-undo .
    15605   define output parameter par-kat-discnt-rule as integer no-undo .
    15606   define output parameter par-kat-discnt-method as character no-undo .
    15607   define output parameter par-date-discnt-rule as integer no-undo .
    15608   define output parameter par-abs-discnt-rule as integer no-undo .
    15609   define output parameter par-tot-discnt-rule as integer no-undo .
    15610   define output parameter par-wgd-rule as integer no-undo .
    15611   define output parameter par-taracode as character no-undo .
    15612   define buffer loc-gds-obj-attr for ub.gds-obj-attr.
    15613   define buffer loc-dis-gds-rule for ub.dis-gds-rule.
    15614   define buffer buf_dis-rule for ub.dis-rule.
    15615   define buffer buf_temp-dis-gds-rule for temp-dis-gds-rule.
    15616   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
    15617     do
    15618     on error undo, return error
    15619     :
    15620       for each  loc-gds-obj-attr No-LOCK  where
    15621                 loc-gds-obj-attr.gds-code = par-gds-code AND
    15622                 loc-gds-obj-attr.obj-code = par-obj-code AND
    15623                 loc-gds-obj-attr.obj-type = par-obj-type :
    15624         CASE loc-gds-obj-attr.attr-code:
    15625           when 'free-price':U  then do:
    15626             assign
    15627             par-fp =  if loc-gds-obj-attr.attr-value = "yes"
    15628                       then yes
    15629                       else no
    15630             .
    15631           end.
    15632           when 'sum-grp':U then do:
    15633             assign
    15634             par-grp-code =  integer(loc-gds-obj-attr.attr-value) no-error
    15635             .
    15636           end.
    15637           when 'petrol-purse':U then do:
    15638             assign
    15639             par-petrol-purse =  if loc-gds-obj-attr.attr-value = "yes"
    15640                                 then yes
    15641                                 else no
    15642             .
    15643           end.
    15644           when 'need-auth':U then do:
    15645             assign
    15646             par-need-auth =  if loc-gds-obj-attr.attr-value = "yes"
    15647                                 then yes
    15648                                 else no
    15649             .
    15650           end.
    15651           when 'taracode':U  then do:
    15652             assign
    15653             par-taracode = loc-gds-obj-attr.attr-value no-error
    15654             .
    15655           end.
    15656         END CASE.
    15657       end.
    15658       define variable v-par-log as logical no-undo .
    15659      find first loc-dis-gds-rule where
    15660                 loc-dis-gds-rule.gds-code = par-gds-code
    15661             and loc-dis-gds-rule.pos-type = dflt-cd
    15662             and loc-dis-gds-rule.obj-type = ''
    15663             and loc-dis-gds-rule.obj-code = 0
    15664             and loc-dis-gds-rule.discnt-role = 'without-gds-disc':U no-error.
    15665       if available loc-dis-gds-rule then do:
    15666         par-wgd-rule = loc-dis-gds-rule.rule-num.
    15667       end.
    15668       find first loc-dis-gds-rule where
    15669                 loc-dis-gds-rule.gds-code = par-gds-code
    15670             and loc-dis-gds-rule.pos-type = dflt-cd
    15671             and loc-dis-gds-rule.obj-type = ''
    15672             and loc-dis-gds-rule.obj-code = 0
    15673             and loc-dis-gds-rule.discnt-role = 'without-disc':U no-error.
    15674       if available loc-dis-gds-rule then do:
    15675         par-wd-rule = loc-dis-gds-rule.rule-num.
    15676       end.
    15677       define variable loc-host-code as integer no-undo .
    15678   define variable vss-include-info135 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    15679   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
    15680     (input  par-obj-type
    15681     ,input  par-obj-code
    15682     ,output loc-host-code
    15683     )  .
    15684       find first loc-dis-gds-rule where
    15685                 loc-dis-gds-rule.gds-code = par-gds-code
    15686             and loc-dis-gds-rule.pos-type = dflt-cd
    15687             and loc-dis-gds-rule.obj-type = 'орг':U
    15688             and loc-dis-gds-rule.obj-code = loc-host-code
    15689             and loc-dis-gds-rule.discnt-role = 'without-gds-disc':U no-error.
    15690       if available loc-dis-gds-rule then do:
    15691         par-wgd-rule = loc-dis-gds-rule.rule-num.
    15692       end.
    15693       find first loc-dis-gds-rule where
    15694                 loc-dis-gds-rule.gds-code = par-gds-code
    15695             and loc-dis-gds-rule.pos-type = dflt-cd
    15696             and loc-dis-gds-rule.obj-type = 'орг':U
    15697             and loc-dis-gds-rule.obj-code = loc-host-code
    15698             and loc-dis-gds-rule.discnt-role = 'without-disc':U no-error.
    15699       if available loc-dis-gds-rule then do:
    15700         par-wd-rule = loc-dis-gds-rule.rule-num.
    15701       end.
    15702       if par-wd-rule > 0 then do:
    15703         find first buf_dis-rule no-lock where
    15704                   buf_Dis-rule.rule-num = par-wd-rule no-error.
    15705         if available buf_dis-rule then do:
    15706           run create-dis-rule in this-procedure ( input buf_dis-rule.rule-num
    15707                                                  , (buf_Dis-rule.time-rule-num >= 0)) no-error .
    15708         end.
    15709       end.
    15710       if par-wgd-rule > 0 then do:
    15711         find first buf_dis-rule no-lock where
    15712                   buf_Dis-rule.rule-num = par-wgd-rule no-error.
    15713         if available buf_dis-rule then do:
    15714           run create-dis-rule in this-procedure ( input buf_dis-rule.rule-num
    15715                                                  , (buf_Dis-rule.time-rule-num >= 0)) no-error .
    15716         end.
    15717       end.
    15718       for each  loc-dis-gds-rule No-LOCK  where
    15719                 loc-dis-gds-rule.gds-code = par-gds-code
    15720            AND  loc-dis-gds-rule.obj-code = par-obj-code
    15721            AND  loc-dis-gds-rule.obj-type = par-obj-type
    15722            and  loc-dis-gds-rule.pos-type = dflt-cd :
    15723         CASE loc-dis-gds-rule.discnt-role:
    15724           when 'std-disc':U then do:
    15725             assign
    15726             par-std-discnt-rule = loc-dis-gds-rule.rule-num
    15727             .
    15728           end.
    15729           when 'temp-disc':U then do:
    15730             if loc-dis-gds-rule.nonunique = ''
    15731             then do:
    15732             assign
    15733             par-temp-disc-rule = loc-dis-gds-rule.rule-num
    15734             .
    15735           end.
    15736             else do:
    15737               if par-temp-disc-method = '' then do:
    15738                 find first buf_dis-cfg-rule no-lock where
    15739                           buf_dis-cfg-rule.table-name = 'dis-gds-rule':U
    15740                       and buf_dis-cfg-rule.pos-type = dflt-cd
    15741                       and buf_dis-cfg-rule.templ-rl-root = loc-dis-gds-rule.templ-rl-root no-error.
    15742                 assign
    15743                 par-temp-disc-method = (if available buf_dis-cfg-rule
    15744                                         then buf_dis-cfg-rule.nonunique
    15745                                         else chr(63))
    15746                 .
    15747               end.
    15748               create buf_temp-dis-gds-rule.
    15749               buffer-copy
    15750               loc-dis-gds-rule
    15751               to
    15752               buf_temp-dis-gds-rule
    15753               .
    15754               release buf_temp-dis-gds-rule.
    15755             end.
    15756           end.
    15757           when 'pcnt-kat':U then do:
    15758             if loc-dis-gds-rule.nonunique = ''
    15759             then do:
    15760               assign
    15761               par-kat-discnt-rule = loc-dis-gds-rule.rule-num
    15762               .
    15763             end.
    15764             else do:
    15765               if par-kat-discnt-method = '' then do:
    15766                 find first buf_dis-cfg-rule no-lock where
    15767                           buf_dis-cfg-rule.table-name = 'dis-gds-rule':U
    15768                       and buf_dis-cfg-rule.pos-type = dflt-cd
    15769                       and buf_dis-cfg-rule.templ-rl-root = loc-dis-gds-rule.templ-rl-root no-error.
    15770                 assign
    15771                 par-kat-discnt-method = (if available buf_dis-cfg-rule
    15772                                         then buf_dis-cfg-rule.nonunique
    15773                                         else chr(63))
    15774                 .
    15775               end.
    15776               create buf_temp-dis-gds-rule.
    15777               buffer-copy
    15778               loc-dis-gds-rule
    15779               to
    15780               buf_temp-dis-gds-rule
    15781               .
    15782               release buf_temp-dis-gds-rule.
    15783             end.
    15784           end.
    15785           when 'pcnt-date':U then do:
    15786             assign
    15787             par-date-discnt-rule = loc-dis-gds-rule.rule-num
    15788             .
    15789           end.
    15790           when 'without-disc':U then do:
    15791             assign
    15792             par-wd-rule =  loc-dis-gds-rule.rule-num
    15793             .
    15794           end.
    15795           when 'without-gds-disc':U then do:
    15796             assign
    15797             par-wgd-rule =  loc-dis-gds-rule.rule-num
    15798             .
    15799           end.
    15800           when 'pcnt-qnty':U then do:
    15801             assign
    15802             par-qnty-discnt-rule = loc-dis-gds-rule.rule-num
    15803             .
    15804           end.
    15805           when 'pcnt-kat':U  then do:
    15806             assign
    15807             par-kat-discnt-rule = loc-dis-gds-rule.rule-num
    15808             .
    15809           end.
    15810           when 'abs-disc':U  then do:
    15811             assign
    15812             par-abs-discnt-rule = loc-dis-gds-rule.rule-num
    15813             .
    15814           end.
    15815           when 'pcnt-tot':U  then do:
    15816             assign
    15817             par-tot-discnt-rule = loc-dis-gds-rule.rule-num
    15818             .
    15819           end.
    15820         END CASE.
    15821         find first buf_dis-rule no-lock where
    15822                   buf_Dis-rule.rule-num = loc-dis-gds-rule.templ-rl-root no-error.
    15823         if available buf_dis-rule then do:
    15824           run create-dis-rule in this-procedure ( input loc-dis-gds-rule.rule-num
    15825                                                  , (buf_Dis-rule.time-rule-num >= 0)) no-error .
    15826         end.
    15827       end.
    15828     end.
    15829   end procedure.
    15830   procedure get-gds-obj-fields :
    15831   define parameter buffer buf_gds-obj for ub.gds-obj .
    15832   define input parameter par-find-buffer as logical no-undo .
    15833   define input parameter par-gds-code like ub.goods.gds-code no-undo .
    15834   define input parameter par-obj-code like ub.clients.obj-code no-undo .
    15835   define input parameter par-obj-type like ub.clients.obj-type no-undo .
    15836   define output parameter par-fact-qnty like ub.gds-obj.fact-qnty no-undo .
    15837   define output parameter par-cash-parts as logical no-undo .
    15838   define output parameter p-is-null-price              like ub.fbr-gds-obj.is-null-price  no-undo .
    15839   define output parameter p-is-menu                    like ub.fbr-gds-obj.is-menu no-undo .
    15840   define output parameter p-is-semi-finished           like ub.fbr-gds-obj.is-semi-finished no-undo .
    15841   define output parameter p-is-modificator             like ub.fbr-gds-obj.is-semi-finished no-undo .
    15842   define output parameter p-fbr-grp-code               like ub.fbr-gds-grp.node-code no-undo .
    15843   define output parameter p-fbr-obj-code               like ub.fbr-gds-obj.fbr-obj-code no-undo .
    15844     do
    15845     on error undo, return error
    15846     :
    15847       if par-find-buffer then do:
    15848         find first buf_gds-obj no-lock where
    15849                   buf_gds-obj.gds-code = par-gds-code AND
    15850                   buf_gds-obj.obj-type = par-obj-type AND
    15851                   buf_gds-obj.obj-code = par-obj-code no-error .
    15852       end.
    15853       if not avail buf_gds-obj
    15854       and ub.shop.is-catering = no
    15855       then do:
    15856         return.
    15857       end.
    15858       assign
    15859       par-fact-qnty = (if available buf_gds-obj
    15860                        then buf_gds-obj.fact-qnty
    15861                        else 0)
    15862       .
    15863       assign
    15864       par-cash-parts = (if available buf_gds-obj
    15865                         then buf_gds-obj.cash-parts
    15866                         else no)
    15867       .
    15868       if available buf_fbr-gds-obj then do:
    15869         assign
    15870         p-is-null-price     =  buf_fbr-gds-obj.is-null-price
    15871         p-is-menu           =  buf_fbr-gds-obj.is-menu
    15872         p-is-semi-finished  =  buf_fbr-gds-obj.is-semi-finished
    15873         p-is-modificator    =  buf_fbr-gds-obj.is-modificator
    15874         p-fbr-grp-code      =  buf_fbr-gds-obj.fbr-grp-code
    15875         p-fbr-obj-code      =  buf_fbr-gds-obj.fbr-obj-code
    15876         .
    15877       end.
    15878     end.
    15879   end procedure.
    15880   procedure get-prt-and-unit :
    15881   define input parameter par-prt-root like ub.goods.prt-root no-undo .
    15882   define input parameter par-unit-base like ub.goods.unit-base no-undo .
    15883   define output parameter par-empty-scale as logical no-undo .
    15884     do
    15885     on error undo, return error
    15886     :
    15887       FIND FIRST ub.gds-prt where
    15888                  ub.gds-prt.upper-code = par-prt-root NO-LOCK .
    15889       assign
    15890       par-empty-scale = NOT (ub.shop.doc-prt AND ( ub.gds-prt.node-name <> '_Пустая шкала':U))
    15891       .
    15892       FIND FIRST ub.units WHERE
    15893                  ub.units.unit-name = par-unit-base NO-LOCK .
    15894     end.
    15895   end procedure.
    15896   define variable vss-include-info136 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    15897   procedure create-ncr-kat-discnt :
    15898   define input parameter p-subject-code as character no-undo .
    15899   define input parameter p-cd-subject-code as character no-undo .
    15900   define input parameter p-subject-name as character no-undo .
    15901   define input parameter p-dis-rule-num like ub.dis-rule.rule-num no-undo .
    15902   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
    15903   define input parameter p-tree as character no-undo .
    15904   define input parameter p-discnt as decimal no-undo .
    15905   define variable v-dis-rule-num as integer no-undo .
    15906   define variable v-tree as logical no-undo init yes.
    15907   define variable v-discnt as decimal no-undo .
    15908   define variable v-dis-kat as integer   no-undo .
    15909   define buffer buf_cash-dis-rule for cash-dis-rule.
    15910   define buffer buf_cash-dis-time-rule for cash-dis-time-rule.
    15911   define buffer slave_cash-dis-rule for cash-dis-rule.
    15912     do
    15913     on error undo, return error
    15914     :
    15915       v-discnt = p-discnt.
    15916       if p-dis-rule-num > 0 then do:
    15917         find first buf_cash-dis-rule no-lock where
    15918                   buf_cash-dis-rule.rule-num = p-dis-rule-num no-error.
    15919         if not available buf_cash-dis-rule
    15920         or (buf_cash-dis-rule.templ-rl-root <> p-templ-rl-root
    15921            and
    15922            p-templ-rl-root <> ?)
    15923         then do:
    15924           return error .
    15925         end.
    15926         if p-templ-rl-root = ? then do:
    15927           p-templ-rl-root = buf_cash-dis-rule.templ-rl-root.
    15928         end.
    15929         if buf_cash-dis-rule.uniq-field = ''
    15930         or buf_cash-dis-rule.is-term
    15931         then do:
    15932           v-tree = no.
    15933           v-dis-rule-num = buf_cash-dis-rule.upper-rule-num.
    15934         end.
    15935         if buf_cash-dis-rule.time-rule-num > 0 then do:
    15936           find first buf_cash-dis-time-rule no-lock where
    15937                   buf_cash-dis-time-rule.time-rule-num = buf_cash-dis-rule.time-rule-num no-error.
    15938           if not available buf_cash-dis-time-rule then do:
    15939             return error .
    15940           end.
    15941           release buf_cash-dis-time-rule.
    15942         end.
    15943           _buf-cash-dis-rule:
    15944           for each buf_cash-dis-rule no-lock where
    15945                   buf_cash-dis-rule.upper-rule-num = (if v-tree then p-dis-rule-num else v-dis-rule-num):
    15946             if not v-tree then do:
    15947               find first slave_cash-dis-rule no-lock where
    15948                   slave_cash-dis-rule.rule-num = v-dis-rule-num .
    15949               assign v-dis-kat = slave_cash-dis-rule.dis-kat .
    15950               if buf_cash-dis-rule.rule-num <> p-dis-rule-num then next _buf-cash-dis-rule.
    15951             end.
    15952             else
    15953              do:
    15954                assign v-dis-kat = buf_cash-dis-rule.dis-kat .
    15955              end .
    15956             if buf_cash-dis-rule.time-rule-num > 0 then do:
    15957               find first buf_cash-dis-time-rule no-lock where
    15958                         buf_cash-dis-time-rule.time-rule-num = buf_cash-dis-rule.time-rule-num no-error.
    15959               if not available buf_cash-dis-time-rule then next _buf-cash-dis-rule.
    15960             end.
    15961             FIND FIRST cash-ncr-dis-kat where
    15962                     cash-ncr-dis-kat.crf = (cr-ncr-dis-kat + 1) No-ERROR.
    15963             if not avail cash-ncr-dis-kat then do:
    15964               create cash-ncr-dis-kat.
    15965               error-status:error = false.
    15966             end.
    15967             cash-ncr-dis-kat.crf = cr-ncr-dis-kat + 1.
    15968             cr-ncr-dis-kat = cr-ncr-dis-kat + 1.
    15969             if buf_cash-dis-rule.value-type = integer('12':U) then do:
    15970               find first cash-gds-discnt where
    15971                         cash-gds-discnt.b-code = integer(p-subject-code)
    15972                     and  cash-gds-discnt.rule-num = buf_cash-dis-rule.rule-num
    15973                     and cash-gds-discnt.obj-type = 'маг':U
    15974                     and cash-gds-discnt.obj-code = i-obj-code
    15975                     no-error.
    15976               if available cash-gds-discnt then do:
    15977                 assign
    15978                 v-discnt = cash-gds-discnt.discnt-value
    15979                 .
    15980               end.
    15981               else do:
    15982                 v-discnt = p-discnt.
    15983               end.
    15984             end.
    15985             assign
    15986             cash-ncr-dis-kat.subject-code  =  p-subject-code
    15987             cash-ncr-dis-kat.cd-subject-code  =  p-cd-subject-code
    15988             cash-ncr-dis-kat.cd-subject-name  =  SUBSTRING(p-subject-name, 1, 20)
    15989             cash-ncr-dis-kat.cd-subject-name  =  SUBSTRING(p-subject-name, 1, 20) +
    15990                                                ( if length(p-subject-name) < 20 then fill( chr(32) , 20 - length(p-subject-name) ) else '' )
    15991             cash-ncr-dis-kat.dis-kat =  (if v-dis-kat < 0 then 0 else v-dis-kat)
    15992             cash-ncr-dis-kat.rule-num = buf_cash-dis-rule.rule-num
    15993             cash-ncr-dis-kat.time-rule-num = buf_cash-dis-rule.time-rule-num
    15994             cash-ncr-dis-kat.cd-disc-string   = "****":U  +
    15995                                             (if buf_cash-dis-rule.templ-rl-root = 89
    15996                                              then '80'
    15997                                              else (if buf_cash-dis-rule.discnt-value > 0
    15998                                                    then '80':U
    15999                                                    else '00':U)
    16000                                              )
    16001             .
    16002             if p-tree = 'time-rule-num':U then do:
    16003               if available buf_cash-dis-time-rule
    16004               and buf_cash-dis-time-rule.value-type <> '0':U
    16005               then do:
    16006                 assign
    16007                 cash-ncr-dis-kat.cd-disc-string = cash-ncr-dis-kat.cd-disc-string +
    16008                                               (if buf_cash-dis-time-rule.value-type = '2':U
    16009                                                 then
    16010                                                 ("D":U + substring(string(buf_cash-dis-time-rule.date-from, "99/99/9999"), 9, 2) +
    16011                                                         substring(string(buf_cash-dis-time-rule.date-from, "99/99/9999"), 4, 2) +
    16012                                                         substring(string(buf_cash-dis-time-rule.date-from, "99/99/9999"), 1, 2) +
    16013                                                         "-":U +
    16014                                                         substring(string(buf_cash-dis-time-rule.date-to, "99/99/9999"), 9, 2) +
    16015                                                         substring(string(buf_cash-dis-time-rule.date-to, "99/99/9999"), 4, 2) +
    16016                                                         substring(string(buf_cash-dis-time-rule.date-to, "99/99/9999"), 1, 2)
    16017                                                 )
    16018                                                 else
    16019                                                 ("T00":U +
    16020                                                           (if buf_cash-dis-time-rule.week-day-0  then "0" else "":U) +
    16021                                                           (if buf_cash-dis-time-rule.week-day-1  then "2" else "":U) +
    16022                                                           (if buf_cash-dis-time-rule.week-day-2  then "3" else "":U) +
    16023                                                           (if buf_cash-dis-time-rule.week-day-3  then "4" else "":U) +
    16024                                                           (if buf_cash-dis-time-rule.week-day-4  then "5" else "":U) +
    16025                                                           (if buf_cash-dis-time-rule.week-day-5  then "6" else "":U) +
    16026                                                           (if buf_cash-dis-time-rule.week-day-6  then "7" else "":U) +
    16027                                                           (if buf_cash-dis-time-rule.week-day-7  then "1" else "":U) +
    16028                                                         chr(47) +
    16029                                                         replace(string(buf_cash-dis-time-rule.time-from, "HH:MM"), ':':U, '':U) + "-":U +
    16030                                                         replace(string(buf_cash-dis-time-rule.time-to, "HH:MM"), ':':U, '':U)
    16031                                                 )
    16032                                               )
    16033                 .
    16034               end.
    16035               else do:
    16036                 assign
    16037                 cash-ncr-dis-kat.cd-disc-string = cash-ncr-dis-kat.cd-disc-string + "D000101-991231":U
    16038                 .
    16039               end.
    16040             end.
    16041             if p-tree = 'tot-sum':U then do:
    16042               assign
    16043               cash-ncr-dis-kat.cd-disc-string = cash-ncr-dis-kat.cd-disc-string +
    16044               '>' + replace(string(round(buf_cash-dis-rule.tot-sum, 2), '99999999999.99'), '.':u , '':U)
    16045               .
    16046             end.
    16047             assign
    16048             cash-ncr-dis-kat.cd-other =   fill(chr(32), 10) +  "xx ":U +
    16049                                           (if buf_cash-dis-rule.value-type = integer('12':U)
    16050                                            or buf_cash-dis-rule.value-type = integer('3':U)
    16051                                           then "=":U
    16052                                           else "%":U) +
    16053                                           replace(string(abs(if v-discnt <> ? then v-discnt else buf_cash-dis-rule.discnt-value),"9999999.9"), '.':U, '':U)
    16054             .
    16055           end.
    16056       end.
    16057       else do:
    16058         FIND FIRST cash-ncr-dis-kat where
    16059                 cash-ncr-dis-kat.crf = (cr-ncr-dis-kat + 1) No-ERROR.
    16060         if not avail cash-ncr-dis-kat then do:
    16061         create cash-ncr-dis-kat.
    16062         error-status:error = false.
    16063         end.
    16064         cash-ncr-dis-kat.crf = cr-ncr-dis-kat + 1.
    16065         cr-ncr-dis-kat = cr-ncr-dis-kat + 1.
    16066         assign
    16067         cash-ncr-dis-kat.subject-code  = p-subject-code
    16068         cash-ncr-dis-kat.cd-subject-code  = p-cd-subject-code
    16069         cash-ncr-dis-kat.cd-subject-name  = p-subject-name
    16070         cash-ncr-dis-kat.dis-kat =  - 1
    16071         cash-ncr-dis-kat.rule-num = 0
    16072         cash-ncr-dis-kat.time-rule-num = 0
    16073         .
    16074       end.
    16075     end.
    16076   end procedure.
    16077   procedure output-ncr-bonus:
    16078   define input parameter i-host-code as integer no-undo .
    16079   define input parameter i-obj-code  as integer no-undo .
    16080   define input parameter out         as character no-undo .
    16081   define output parameter fname      as character no-undo .
    16082   def var v-found as log no-undo .
    16083   def var v-upd   as char no-undo .
    16084   def var v-ver   as char no-undo .
    16085   def var v-char-delim-1  as char initial ',' no-undo .
    16086   def var v-char-delim-2  as char initial ';' no-undo .
    16087   def var v-char-1        as char no-undo .
    16088   def var v-char-2        as char no-undo .
    16089   def var v-char-21       as char no-undo .
    16090   def var v-char-3        as char no-undo .
    16091   def var v-char-4        as char no-undo .
    16092   def var v-char-41       as char no-undo .
    16093   def var v-char-42       as char no-undo .
    16094   def var v-char-5        as char no-undo .
    16095   def var v-char-6        as char no-undo .
    16096   def var v-char-61       as char no-undo .
    16097   def var v-char-62       as char no-undo .
    16098   def var v-char-8        as char no-undo .
    16099   def var v-char-9        as char no-undo .
    16100   def var v-char-7        as char no-undo .
    16101   def var v-char-71       as char no-undo .
    16102   def var v-char-72       as char no-undo .
