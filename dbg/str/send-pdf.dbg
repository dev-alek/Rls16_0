     3024   procedure xml-cd-write-header:
     3025   do
     3026   on error undo, return error
     3027   :
     3028   define input parameter p-xml-file-name       as character    no-undo.
     3029   define input parameter p-xml-file-name-path  as character    no-undo.
     3030   define input parameter p-doc-name            as character    no-undo.
     3031   define input parameter p-version             as character    no-undo.
     3032   define input parameter p-obj-list            as character    no-undo.
     3033   define input parameter p-correspondent       as character    no-undo .
     3034   define input parameter p-write-header        as logical      no-undo .
     3035   define variable OS-time as character no-undo .
     3036   define variable id as character no-undo .
     3037   define buffer buf_db for ub.db.
     3038   output stream stmXMLOut to value( p-xml-file-name-path + "xm1":U ) convert target "1251" append.
     3039   put stream stmXMLOut unformatted "<?xml version='1.0' encoding='windows-1251'?>".
     3040   assign
     3041   OS-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9" )
     3042   .
     3043   run bgelib-tag-open in this-procedure (
     3044                                        1
     3045                                       ,p-doc-name
     3046                                       ,substitute("type='REQUEST' id='&1' from='&2' to='&3' tstamp='&4'", p-xml-file-name, p-obj-list, p-correspondent, OS-time )
     3047                                         ).
     3048   if p-write-header then do:
     3049     run bgelib-tag-open(2, "Header","").
     3050     run bgelib-tag-put( 3, "DocumentName", p-doc-name, 1).
     3051     run bgelib-tag-put( 3, "DateFormat", "DD.MM.YYYY":U, 1).
     3052     run bgelib-tag-put( 3, "DocumentVersion", "1.02":U, 1).
     3053     run bgelib-tag-put( 3, "DocumentVersionDate", "09.09.2004":U, 1).
     3054     run bgelib-tag-put( 3, "ExportDate", string(today, "99.99.9999":U), 1).
     3055     run bgelib-tag-put( 3, "ExportTime", string(time, "hh:mm:ss":U), 1).
     3056     run bgelib-tag-put( 3, "objList",             p-obj-list                    , 1).
     3057     find first buf_db where buf_db.db-num = g#db-num no-lock.
     3058     run bgelib-tag-put( 3, "dbEncKey",            buf_db.db-key-enc, 1).
     3059     run bgelib-tag-close( 2, "Header" ).
     3060   end.
     3061   output stream stmXMLOut close.
     3062   end.
     3063   end procedure.
     3064   procedure xml-cd-write-footer:
     3065   do
     3066   on error undo, return error
     3067   :
     3068   define input parameter p-pos-type      like ub.cash-desk.pos-type no-undo .
     3069   define input parameter p-xml-file-name as character    no-undo.
     3070   define input parameter p-doc-name      as character    no-undo .
     3071   define variable v-error-num     as integer           no-undo.
     3072   define variable v-md5-signature as character no-undo .
     3073   output stream stmXMLOut to value( p-xml-file-name + "xm1" ) convert target "1251" append.
     3074   run bgelib-tag-close( 0, p-doc-name ).
     3075   put stream stmXMLOut unformatted skip.
     3076   output stream stmXMLOut close.
     3077   run bge/os_copy.p ("M", p-xml-file-name + "xm1", p-xml-file-name + "xml", output v-error-num ).
     3078   if v-error-num > 0
     3079   then do:
     3080      return error.
     3081   end.
     3082   if opsys = "unix"
     3083   then do:
     3084       os-command silent chmod 666 value (p-xml-file-name + "xml") 2>/dev/null.
     3085   end.
     3086   end.
     3087   end procedure.
     3088   procedure xml-cd-filename :
     3089   do
     3090   on error undo, return error
     3091   :
     3092   define input parameter  p-out               as character no-undo .
     3093   define output parameter p-xml-file-name     as character    no-undo.
     3094   define output parameter p-xml-file-name-path   as character    no-undo.
     3095   define output parameter p-log-file-name     as character    no-undo.
     3096   define output parameter p-locked            as logical      no-undo.
     3097   define variable v-out as character     no-undo.
     3098   define variable loc#log as logical no-undo .
     3099   define variable BadFlag as logical no-undo .
     3100   define variable fq as integer no-undo .
     3101   define variable v-remote as character no-undo .
     3102   assign
     3103   p-xml-file-name = substring( string( next-value( s-spool, ub), '99999999999999999999'), 13, 8 )
     3104   p-xml-file-name-path = p-out + p-xml-file-name + ".":U
     3105   p-log-file-name = p-out + "actions.log"
     3106   p-locked = ( search ( p-xml-file-name-path + "lk" ) <> ? )
     3107   .
     3108   end.
     3109   end procedure.
     3110   FUNCTION Xml-CD-DatetoString returns character(input  p-date as date):
     3111   define variable v-date-str as character no-undo .
     3112   assign
     3113   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     3114                string(Month(p-date), "99":U) + "-":U +
     3115                string(DAY(p-date), "99":U).
     3116   return v-date-str.
     3117   END FUNCTION.
     3118   FUNCTION Xml-CD-DateTimetoString returns character (input  p-date as date, p-time as integer):
     3119   define variable v-date-str as character no-undo .
     3120   assign
     3121   v-date-str = string(YEAR(p-date), "9999":U) + "-":U +
     3122                string(Month(p-date), "99":U) + "-":U +
     3123                string(DAY(p-date), "99":U) + chr(32) +
     3124                string(p-time, "HH:MM:SS").
     3125   return v-date-str.
     3126   END FUNCTION.
     3127   function string-to-date returns date ( input p-string  as character):
     3128     define variable v-date as date no-undo .
     3129     assign
     3130     v-date = date(integer(substring(p-string, 4, 2))
     3131                   ,integer(substring(p-string, 1, 2))
     3132                   ,integer(substring(p-string, 7, 4))
     3133                  ) no-error .
     3134     if error-status:error then return ?.
     3135     return v-date.
     3136   END FUNCTION.
     3137   FUNCTION string-IS0-8601-to-sec returns integer (input p-string-iso-8601 as character ):
     3138   define variable v-time as integer no-undo init ?.
     3139   define variable v-dop1 as character no-undo .
     3140   define variable v-dop2 as character no-undo .
     3141   assign
     3142   v-dop1 = entry(1, p-string-iso-8601, chr(32) )
     3143   v-dop2 = entry(2, p-string-iso-8601, chr(32) )
     3144   no-error .
     3145   if error-status:error then return ?.
     3146   assign
     3147   v-time =  integer(entry(1, v-dop2, ";":U)) * 3600 +
     3148             integer(entry(2, v-dop2, ";":U)) * 60 +
     3149             integer(entry(3, v-dop2, ";":U)) no-error .
     3150   return v-time.
     3151   END FUNCTION.
     3152   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3153   procedure gdcstcod_cst-code :
     3154     define input  parameter p-obj-type  as character no-undo .
     3155     define input  parameter p-obj-code  as integer   no-undo .
     3156     define input  parameter p-gds-code  as integer   no-undo .
     3157     define input  parameter p-in-code   as character no-undo .
     3158     define input  parameter p-part-code as character no-undo .
     3159     define output parameter p-cst-code  as character no-undo .
     3160     define buffer buf_goods for ub.goods .
     3161     define buffer buf_parts for ub.parts .
     3162     do
     3163     on error undo, return error return-value
     3164     :
     3165       assign
     3166         p-cst-code = ''
     3167       .
     3168       find first buf_goods no-lock
     3169         where buf_goods.gds-code = p-gds-code
     3170         no-error .
     3171       if not available buf_goods
     3172       then do:
     3173         undo, return error substitute("Ошибка задания входных параметров. Не найден товар &1", p-gds-code) .
     3174       end.
     3175       if p-in-code = ?
     3176       then do:
     3177         undo, return error substitute("Ошибка задания входных параметров. Неизвестное значение номера накладной &1", p-in-code) .
     3178       end.
     3179       if p-part-code = ?
     3180       then do:
     3181         undo, return error substitute("Ошибка задания входных параметров. Неизвестное значение номера номера партии &1", p-part-code) .
     3182       end.
     3183       if p-in-code = '':u
     3184       then do:
     3185         find first buf_parts no-lock
     3186           where buf_parts.obj-type  = p-obj-type
     3187             and buf_parts.obj-code  = p-obj-code
     3188             and buf_parts.artic     = buf_goods.artic
     3189             and buf_parts.prod-type = buf_goods.prod-type
     3190             and buf_parts.prod-code = buf_goods.prod-code
     3191             and buf_parts.out-code  = 'free-zone':U
     3192             and buf_parts.status_   = false
     3193           no-error .
     3194         if available buf_parts
     3195         then do:
     3196           assign
     3197             p-cst-code = buf_parts.cst-code
     3198           .
     3199         end.
     3200       end.
     3201       else do:
     3202         find first buf_parts no-lock
     3203           where buf_parts.obj-type  = p-obj-type
     3204             and buf_parts.obj-code  = p-obj-code
     3205             and buf_parts.artic     = buf_goods.artic
     3206             and buf_parts.prod-type = buf_goods.prod-type
     3207             and buf_parts.prod-code = buf_goods.prod-code
     3208             and buf_parts.out-code  = 'free-zone':U
     3209             and buf_parts.in-code   = p-in-code
     3210             and buf_parts.part-code = p-part-code
     3211           no-error .
     3212         if available buf_parts
     3213         then do:
     3214           assign
     3215             p-cst-code = buf_parts.cst-code
     3216           .
     3217         end.
     3218       end.
     3219     end.
     3220   end procedure.
