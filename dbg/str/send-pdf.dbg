     8383                                                ,buffer buf_dis-thbj-rule
     8384                                                ) no-error.
     8385           if available buf_dis-thbj-rule then do:
     8386             temp-discnt-rule_pdf = buf_dis-thbj-rule.rule-num.
     8387           end.
     8388         end.
     8389         else do:
     8390           temp-discnt-rule_pdf = 0.
     8391         end.
     8392       end.
     8393       when 'how-pcnt-kat':U then do:
     8394         how-pcnt-kat = thbjattr_thbj-attr.property-value-character.
     8395         if how-pcnt-kat = 'pcnt-kat-pdf':U then do:
     8396           run get-thbj-rule in this-procedure ( input 'маг':U
     8397                                                ,input i-obj-code
     8398                                                ,input ub.shop.host-code
     8399                                                ,input 'pcnt-kat-pdf':U
     8400                                                ,input dflt-cd
