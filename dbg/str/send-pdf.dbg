    16370         buf_dis-rule.key#_one v-char-delim-1
    16371         "3,MAPKA,"
    16372         entry(1,iso-date(buf_dis-time-rule.date-from),"-") + entry(2,iso-date(buf_dis-time-rule.date-from),"-") + entry(3,iso-date(buf_dis-time-rule.date-from),"-") v-char-delim-1
    16373         "0" v-char-delim-1
