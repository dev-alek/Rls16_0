     8310   define variable v-tth56 as handle no-undo .
     8311   run adm/shattri.p (
     8312       input "get":U
     8313       ,input  'маг':U
     8314       ,input  abs(i-obj-code)
     8315       ,input  'cd-sending':U
     8316       ,input  'dflt-cd':U
