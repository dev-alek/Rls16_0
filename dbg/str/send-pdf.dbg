    16425   end procedure .
    16426   procedure get-thbj-rule :
    16427   define input  parameter p-obj-type as character no-undo .
    16428   define input  parameter p-obj-code as integer no-undo .
    16429   define input  parameter p-host-code as integer no-undo .
    16430   define input  parameter p-discnt-role as character no-undo .
    16431   define input  parameter p-pos-type as character   no-undo .
    16432   define input  parameter p-reg-list as character no-undo .
    16433   define parameter buffer  buf_dis-thbj-rule for ub.dis-thbj-rule.
    16434   define variable v-region-type as character no-undo .
    16435   define variable v-region-code as integer   no-undo .
    16436   define variable v-region-host as integer   no-undo .
    16437   define variable v-region-ii as integer   no-undo .
    16438   _v-region-ii:
    16439   do v-region-ii = 1 to 3:
    16440     if lookup(string(v-region-ii), p-reg-list) = 0 then next _v-region-ii.
    16441     case v-region-ii:
    16442       when 1 then do:
    16443         assign
    16444         v-region-type = p-obj-type
    16445         v-region-code = p-obj-code
    16446         v-region-host = p-host-code
    16447         .
    16448       end.
    16449       when 2 then do:
    16450         assign
    16451         v-region-type = ''
    16452         v-region-code = 0
    16453         v-region-host = p-host-code
    16454         .
    16455       end.
    16456       when 3 then do:
    16457         assign
    16458         v-region-type = ''
    16459         v-region-code = 0
    16460         v-region-host = 0
    16461         .
    16462       end.
    16463     end case.
    16464     find first buf_dis-thbj-rule no-lock where
    16465               buf_dis-thbj-rule.obj-type = v-region-type
    16466           and buf_dis-thbj-rule.obj-code = v-region-code
    16467           and buf_dis-thbj-rule.host-code = v-region-host
    16468           and buf_dis-thbj-rule.discnt-role = p-discnt-role
    16469           and buf_dis-thbj-rule.pos-type = p-pos-type no-error.
    16470     if available buf_dis-thbj-rule then do:
    16471       find first buf_dis-rule no-lock where
    16472                 buf_Dis-rule.rule-num = buf_dis-thbj-rule.templ-rl-root no-error.
    16473       if available buf_dis-rule then do:
    16474         run create-dis-rule in this-procedure ( input buf_dis-thbj-rule.rule-num
    16475                                               , (buf_Dis-rule.time-rule-num >= 0)) no-error .
    16476       end.
    16477       leave _v-region-ii.
    16478     end.
    16479   end.
    16480   END PROCEDURE.
