     7608   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7609   PROCEDURE asc-gds.
     7610   DEFINE parameter buffer loc-goods for ub.goods.
     7611   DEFINE parameter buffer loc-bar-code for ub.bar-code.
     7612   DEFINE parameter buffer loc-gds-prt-root for ub.gds-prt.
     7613   DEFINE parameter buffer loc-gds-obj for ub.gds-obj.
     7614   DEFINE parameter buffer loc-price-list for ub.price-list.
     7615   DEFINE parameter buffer loc-units for ub.units.
     7616   DEFINE parameter buffer loc-gds-prt-term for ub.gds-prt.
     7617   DEFINE input parameter loc-prod-bc like ub.prod-bc.b-str.
     7618   DEFINE input parameter loc-bc-on-type like ub.prod-bc.bc-on-type.
     7619   DEFINE input parameter loc-bc-units-cli-type like ub.units.type.
     7620   DEFINE input parameter loc-bc-units-okei like ub.units.okei.
     7621   define input parameter parhost-code like ub.sysconf.host-code no-undo .
     7622   define input parameter parobj-type like ub.clients.obj-type no-undo .
     7623   define input parameter parobj-code like ub.clients.obj-code no-undo .
     7624   define variable v-doc-num like ub.price-list.doc-num no-undo .
     7625   DEFINE VARIABLE vat-value like ub.doc-line.vat-pc no-undo .
     7626   DEFINE VARIABLE slt-value like ub.doc-line.slt-pc no-undo .
     7627   define variable v-disc-price-sale as decimal no-undo .
     7628   define variable v-pdf-id as integer no-undo .
     7629   define variable v-pdf-db-num as integer no-undo .
     7630   define variable v-oss as character no-undo.
     7631   define variable v-gtd as character no-undo .
     7632   define variable v-is-gas as character no-undo .
     7633   define variable v-ban-bonus as character no-undo .
     7634   define variable v-ptrl-as-good as character no-undo .
     7635   define variable v-type as character no-undo .
     7636   define variable disc-b-code as integer no-undo .
     7637   define variable v-main-prt-b-code as integer no-undo .
     7638   define variable IBM-good-code as character no-undo .
     7639   define variable IBM-good-code-2 as character no-undo .
     7640   define variable IBM2-short      as character no-undo .
     7641   define variable v-gds-null-price as character no-undo .
     7642   define variable iii as integer no-undo .
     7643   define variable v-mask-full as character no-undo .
     7644   define variable v-mask-short as character no-undo .
     7645   define variable vKKT as integer no-undo.
     7646   define variable attrValue as character no-undo.
     7647   define variable attrType  as character no-undo.
     7648   DEFine BUFFER BUF_BAR-CODE FOR UB.BAR-CODE.
     7649   define buffer buf_price-list for ub.price-list.
     7650   define buffer buf_price-doc-forming-gds FOR UB.PRICE-doc-forming-gds.
     7651   define buffer buf_temp-dis-gds-rule for temp-dis-gds-rule.
     7652   define buffer main-prt-bar-code  for ub.bar-code.
     7653   define buffer buf_goods-attr for goods-attr.
     7654   define buffer b-code for code.
     7655   if action = "U" then do:
     7656     if loc-bar-code.stts = Integer('79':U) then return.
     7657       for-price = ?.
     7658   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7659   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     7660     (input  'маг':U
     7661     ,input  ub.shop.obj-code
     7662     ,input  loc-bar-code.b-code
     7663     ,input  main-b-code
     7664     ,input  0
     7665     ,output v-doc-num
     7666     ,output for-price
     7667     ,output for-road
     7668     ,output for-excise
     7669     ) no-error .
     7670       if error-status:error then do:
     7671           if g#news
     7672           or g#auto
     7673           or g#esys
     7674           then return error.
     7675           else do:
     7676               error-status:error = no.
     7677               message "Ошибка при определении цены на товар "
     7678                       loc-goods.artic loc-goods.prod-type loc-goods.prod-code
     7679               view-as alert-box ERROR.
     7680               return.
     7681           end.
     7682       end.
     7683       if return-value = "error" then do:
     7684           if for-price = ? then do:
     7685             return.
     7686           end.
     7687           if not g#news
     7688           and not g#auto
     7689           and not g#esys
     7690           then
     7691           message prichina view-as alert-box ERROR.
     7692           return error.
     7693       end.
     7694       else if (for-price = ? or for-price = 0) then do:
     7695         if v-is-restaurant and v-is-null-price  then do:
     7696           assign
     7697           for-price = 0.
     7698         end.
     7699         else do:
     7700           run gds-attr-value in this-procedure  ( input loc-goods.gds-code
     7701                                                  ,input 'null-price':U
     7702                                                  ,output v-gds-null-price
     7703                                                  ,output v-type) no-error.
     7704           if (not logical(v-gds-null-price) and for-price = 0) or for-price = ? then
     7705           return "NEXT".
     7706         end.
     7707       end.
     7708     end.
     7709     else do:
     7710           for-price = 0.
     7711     end.
     7712   for-price = round-m( for-price , rnd-znak ).
     7713   FIND FIRST cash-gds where cash-gds.crf = (cr + 1) No-ERROR.
     7714   start-paket = no.
     7715   if not avail cash-gds then do:
     7716   create cash-gds.
     7717   error-status:error = false.
     7718   end.
     7719   cash-gds.crf = cr + 1.
     7720   cr = cr + 1.
     7721   if loc-bar-code.in-code <> ''
     7722   or loc-bar-code.part-code <> ''
     7723   then do:
     7724     find first main-prt-bar-code no-lock where
     7725               main-prt-bar-code.gds-code = loc-goods.gds-code
     7726           and main-prt-bar-code.node-code = loc-bar-code.node-code
     7727           and main-prt-bar-code.unit-cli = loc-bar-code.unit-cli
     7728           and main-prt-bar-code.part-code = ''
     7729           and main-prt-bar-code.in-code = '' no-error.
     7730     if available main-prt-bar-code then do:
     7731       v-main-prt-b-code = main-prt-bar-code.b-code.
     7732     end.
     7733   end.
     7734   else do:
     7735     v-main-prt-b-code = loc-bar-code.b-code.
     7736   end.
     7737   find first tt-tax no-lock where
     7738              tt-tax.tax-code = vattaxcd no-error .
     7739   do iii = 1 to num-entries(mask_s-c) :
     7740     assign
     7741       v-mask-full  = trim(entry(iii, mask_s-c))
     7742       v-mask-short = entry(1, v-mask-full, "*")
     7743       loc-prod-bc  = trim(loc-prod-bc)
     7744     .
     7745     if length(v-mask-full) = length(loc-prod-bc) and  substring(loc-prod-bc, 1, length(v-mask-short)) = v-mask-short then
     7746       loc-prod-bc = "*" + substring(loc-prod-bc, length(v-mask-short) + 1).
     7747   end.
     7748   define variable vBc-on as logical no-undo.
     7749   if loc-prod-bc ne ?
     7750   then do:
     7751       find first prod-bc where prod-bc.b-code eq loc-bar-code.b-code
     7752                            and prod-bc.b-str  eq loc-prod-bc
     7753                            no-lock no-error.
     7754       if available prod-bc
     7755       then
     7756          vBc-on = prod-bc.bc-on.
     7757       else
     7758          vBc-on = yes.
     7759   end.
     7760   else
     7761      vBc-on = yes.
     7762   run gdsoattr-value in this-procedure (
     7763     'dt-seasons':U,
     7764     loc-goods.gds-code,
     7765     parobj-type,
     7766     parobj-code,
     7767     output attrValue,
     7768     output attrType
     7769   ) no-error.
     7770   if attrValue <> "" then do:
     7771     find first b-code where
     7772                b-code.parent = "DTSeasons"
     7773            and b-code.code   = attrValue
     7774          no-lock no-error.
     7775     v-main-prt-b-code = integer(b-code.code).
     7776   end.
     7777   else release b-code.
     7778   assign
     7779   cash-gds.gds-code = loc-goods.gds-code
     7780   cash-gds.artic = loc-goods.artic
     7781   cash-gds.b-code = loc-bar-code.b-code
     7782   cash-gds.main-prt-b-code = v-main-prt-b-code
     7783   cash-gds.b-str = if loc-prod-bc = ? then "" else loc-prod-bc
     7784   cash-gds.bc-on-type = loc-bc-on-type
     7785   cash-gds.bc-on = vBc-on
     7786   cash-gds.unit-cli = loc-bar-code.unit-cli
     7787   cash-gds.cli-base-rate = loc-bar-code.cli-base-rate
     7788   cash-gds.std-discnt-rule = std-discnt-rule_
     7789   cash-gds.gds-namelong = loc-goods.gds-name
     7790   cash-gds.gds-name = IF nam-2str
     7791                       then if available b-code then b-code.codename else loc-goods.gds-name
     7792                       else (
     7793                             IF nam-artc
     7794                             then loc-goods.artic
     7795                             else if available b-code
     7796                                  then b-code.codename
     7797                                  else (if loc-goods.chk-name <> ""
     7798                                        then loc-goods.chk-name
     7799                                        else loc-goods.gds-name)
     7800                            )
     7801   cash-gds.f-name = if NOT l-empty-scale then loc-gds-prt-term.f-name else ""
     7802   cash-gds.unit-base = loc-goods.unit-base
     7803   cash-gds.grp-code = for-grp-code
     7804   cash-gds.fp = for-fp
     7805   cash-gds.ingredient = loc-goods.struct
     7806   cash-gds.producer = for-producer
     7807   cash-gds.producer-int = for-producer-int
     7808   cash-gds.alpha1     = loc-goods.alpha1.
     7809     run gds-attr-value in this-procedure  ( input cash-gds.gds-code
     7810                                            ,input 'office-type':U
     7811                                            ,output v-oss
     7812                                            ,output v-type) no-error.
     7813   cash-gds.office-type = v-oss.
     7814     run gds-attr-value in this-procedure  ( input cash-gds.gds-code
     7815                                            ,input 'type-method-calc':U
     7816                                            ,output v-oss
     7817                                            ,output v-type) no-error.
     7818   if v-oss <> "" then
     7819     assign
     7820       cash-gds.CalculationMethod = int(entry(1,v-oss,","))
     7821       cash-gds.CalculationMethodRestr = if num-entries(v-oss,",") > 1 then int(entry(2,v-oss,",")) else 0
     7822     .
     7823   else
     7824     assign
     7825       cash-gds.CalculationMethod = 0
     7826       cash-gds.CalculationMethodRestr = 0
     7827     .
     7828   assign
     7829   cash-gds.fact-qnty = for-fact-qnty
     7830   cash-gds.okei = loc-bc-units-okei
     7831   cash-gds.kat-discnt-method = kat-discnt-method_
     7832   cash-gds.temp-discnt-method = temp-discnt-method_
     7833   cash-gds.kat-discnt-rule = (if how-pcnt-kat = 'pcnt-kat-pdf':U
     7834                                then  kat-discnt-rule_pdf
     7835                                else  kat-discnt-rule_)
     7836   cash-gds.date-discnt-rule = date-discnt-rule_
     7837   cash-gds.abs-discnt-rule = abs-discnt-rule_
     7838   cash-gds.tot-discnt-rule = tot-discnt-rule_
     7839   cash-gds.wgd-rule = for-wgd
     7840   cash-gds.gds-stat = ( if lookup( 'вес':U, loc-bc-units-cli-type ) > 0 OR lookup('дро':U, loc-bc-units-cli-type) > 0
     7841                           then 1
     7842                           else 0)
     7843   cash-gds.gds-stat = (if (lookup('топ':U, loc-units.type) > 0 AND lookup('дро':U, loc-units.type) > 0)
     7844                        or for-petrol-purse
     7845                        then (cash-gds.gds-stat + 8)
     7846                        else cash-gds.gds-stat)
     7847   cash-gds.gds-stat = if (loc-goods.gds-type = 'у':U and (cash-gds.gds-stat < 8 or for-petrol-purse))
     7848                       then (cash-gds.gds-stat + 16)
     7849                       else cash-gds.gds-stat
     7850   cash-gds.gds-stat = if cash-gds.fp
     7851                       then (cash-gds.gds-stat + 2)
     7852                       else cash-gds.gds-stat
     7853   cash-gds.gds-stat = if cash-gds.wgd-rule > 0
     7854                       then (cash-gds.gds-stat + 128)
     7855                       else cash-gds.gds-stat
     7856   cash-gds.office = if loc-goods.gds-type = 'у':U then 1 else 0
     7857   cash-gds.temp-discnt-rule = (if how-temp-disc = 'temp-disc-pdf':U
     7858                                then temp-discnt-rule_pdf
     7859                                else temp-discnt-rule_)
     7860   cash-gds.wd-rule = for-wd
     7861   cash-gds.pp = (if for-petrol-purse then 1 else 0)
     7862   cash-gds.need-auth = (if need-auth then 1 else 0)
     7863   cash-gds.price-sale =  for-price
     7864   cash-gds.unit-type = loc-units.type
     7865   cash-gds.unit-cli-type = loc-bc-units-cli-type
     7866   cash-gds.tax-string = tax-string
     7867   cash-gds.new-good = new-good
     7868   cash-gds.rc = recid(loc-goods)
     7869   cash-gds.qnty-discnt-rule = qnty-discnt-rule_
     7870   cash-gds.vat-pc = (if avail tt-tax
     7871                      then tt-tax.rate-value
     7872                      else 0)
     7873   cash-gds.vat-code = (if avail tt-tax
     7874                        then tt-tax.rate-code
     7875                        else ?)
     7876   cash-gds.is-menu  = (if v-is-menu then 1 else 0)
     7877   cash-gds.is-semi-finished = (if v-is-semi-finished then 1 else 0)
     7878   cash-gds.is-modificator = (if v-is-modificator then 1 else 0)
     7879   cash-gds.fbr-grp-code = v-fbr-grp-code
     7880   cash-gds.fbr-grp-code-0 = loc-goods.fbr-grp-code
     7881   cash-gds.DepartID = v-fbr-obj-code
     7882   cash-gds.zp = (if v-is-null-price then 1 else 0)
     7883   cash-gds.node-code = loc-bar-code.node-code
     7884   cash-gds.taracode = for-taracode
     7885   cash-gds.is-main-code = (if cash-gds.b-str = ""
     7886                            and loc-bar-code.in-code = ""
     7887                            and loc-bar-code.part-code = ""
     7888                            and cash-gds.unit-base = cash-gds.unit-cli
     7889                            then yes
     7890                            else no)
     7891   cash-gds.obj-type = parobj-type
     7892   cash-gds.obj-code = parobj-code
     7893   .
     7894   assign
     7895   cash-gds.gds-name1 =   name-2cdf(
     7896                         input name-2cd
     7897                       , input yes
     7898                       , input cod-pcod
     7899                       , input cash-gds.b-code
     7900                       , input loc-goods.gds-code
     7901                       , input loc-goods.artic
     7902                       , input loc-goods.engl-name
     7903                       , input loc-bar-code.in-code
     7904                       , input loc-bar-code.part-code
     7905                       , input parobj-type
     7906                       , input parobj-code
     7907                       , input loc-goods.alpha1
     7908                       , output v-gtd
     7909                       )
     7910   cash-gds.gtd   = v-gtd
     7911   .
     7912   vKKT = 255.
     7913   find first b-code where
     7914              b-code.parent  = "okei-kkt"
     7915          and b-code.code    = string(cash-gds.okei)
     7916          and b-code.status_ = 0
     7917   no-lock no-error.
     7918   if avail b-code then
     7919      vKKT = integer(b-code.CodeName) no-error.
     7920   if error-status:error then vKKT = 255.
     7921   cash-gds.kkt = vKKT.
     7922   if (lookup('топ':U, loc-units.type) > 0 AND lookup('дро':U, loc-units.type) > 0) then do:
     7923      run gds-attr-value in this-procedure  (
     7924                                             input cash-gds.gds-code
     7925                                            ,input 'fuel-type':U
     7926                                            ,output v-is-gas
     7927                                            ,output v-type) no-error.
     7928      run gds-attr-value in this-procedure  (
     7929                                             input cash-gds.gds-code
     7930                                            ,input 'ptrl-as-good':U
     7931                                            ,output v-ptrl-as-good
     7932                                            ,output v-type) no-error.
     7933      assign
     7934      cash-gds.ptrl-as-good = logical(v-ptrl-as-good)
     7935      no-error .
     7936      assign
     7937      cash-gds.is-gas = (v-is-gas = 'metan':U)
     7938      no-error .
     7939      if cash-gds.is-gas then do:
     7940        cash-gds.gds-stat = cash-gds.gds-stat + 64.
     7941      end.
     7942   end.
     7943      run gds-attr-value in this-procedure  (
     7944                                             input cash-gds.gds-code
     7945                                            ,input 'ban-bonus':U
     7946                                            ,output v-ban-bonus
     7947                                            ,output v-type) no-error.
     7948     assign
     7949      cash-gds.wd = int(logical(v-ban-bonus))
     7950      no-error .
     7951   if how-temp-disc = 'temp-disc':U then do:
     7952     case temp-discnt-method_:
     7953       when "" then do:
     7954       end.
     7955       when "bar-code.b-code" then do:
     7956         if loc-bar-code.in-code <> ''
     7957         or loc-bar-code.part-code <> ''
     7958         then do:
     7959           disc-b-code = cash-gds.main-prt-b-code.
     7960         end.
     7961         else do:
     7962           disc-b-code = cash-gds.b-code.
     7963         end.
     7964         find first buf_temp-dis-gds-rule where
     7965                 buf_temp-dis-gds-rule.gds-code = cash-gds.gds-code
     7966             and buf_temp-dis-gds-rule.nonunique = string( disc-b-code) no-error.
     7967         if available buf_temp-dis-gds-rule then do:
     7968             cash-gds.temp-discnt-rule = buf_temp-dis-gds-rule.rule-num.
     7969         end.
     7970       end.
     7971       otherwise do:
     7972         cash-gds.temp-discnt-rule = 0.
     7973       end.
     7974     end.
     7975   end.
     7976   assign
     7977   cash-gds.gds-name1 =   name-2cdf(
     7978                         input name-2cd
     7979                       , input yes
     7980                       , input cod-pcod
     7981                       , input cash-gds.b-code
     7982                       , input loc-goods.gds-code
     7983                       , input loc-goods.artic
     7984                       , input loc-goods.engl-name
     7985                       , input loc-bar-code.in-code
     7986                       , input loc-bar-code.part-code
     7987                       , input parobj-type
     7988                       , input parobj-code
     7989                       , input loc-goods.alpha1
     7990                       , output v-gtd
     7991                       )
     7992   cash-gds.gtd   = v-gtd
     7993   .
     7994   assign
     7995   cash-gds.ean-lz = ''
     7996   cash-gds.ean-rz = ''
     7997   cash-gds.code-short = ''
     7998   .
     7999   run ibm-gdsc in this-procedure (input no
     8000                                 , output cash-gds.ean-lz
     8001                                 , output cash-gds.ean-rz
     8002                                 , output cash-gds.code-short
     8003                                 ) no-error .
     8004   if new-good then new-good = not new-good.
     8005   if action = "U" then do:
     8006     if cash-gds.kat-discnt-rule <> 0
     8007     and how-pcnt-kat = 'pcnt-kat-pdf':U
     8008     then do:
     8009       for each cash-dis-rule no-lock where
     8010             cash-dis-rule.upper-rule-num = cash-gds.kat-discnt-rule
     8011       :
     8012         run mpl-tpl-auto in this-procedure ( input cash-gds.b-code
     8013                                             ,input 'маг':U
     8014                                             ,input i-obj-code
     8015                                             ,input integer(entry(1, cash-dis-rule.charkey_one,"-"))
     8016                                             ,input integer(entry(2, cash-dis-rule.charkey_one,"-"))
     8017                                             ,input ?
     8018                                             ,output v-disc-price-sale
     8019                                             ,output v-pdf-id
     8020                                             ,output v-pdf-db-num ) no-error.
     8021         if error-status:error
     8022         or v-disc-price-sale = 0
     8023         or v-disc-price-sale = ?
     8024         then do:
     8025         end.
     8026         else do:
     8027           find first  cash-gds-discnt where
     8028                     cash-gds-discnt.b-code = cash-gds.b-code
     8029                   and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8030                   and cash-gds-discnt.obj-type = parobj-type
     8031                   and cash-gds-discnt.obj-code = parobj-code No-ERROR.
     8032           if not available cash-gds-discnt then do:
     8033             find first  cash-gds-discnt where
     8034                       cash-gds-discnt.crf = (crgd + 1) No-ERROR.
     8035             if not available cash-gds-discnt then do:
     8036               create cash-gds-discnt.
     8037               assign
     8038               cash-gds-discnt.crf = crgd + 1.
     8039             end.
     8040             crgd = crgd + 1.
     8041             assign
     8042             cash-gds-discnt.b-code = cash-gds.b-code
     8043             cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8044             cash-gds-discnt.obj-type = parobj-type
     8045             cash-gds-discnt.obj-code = parobj-code
     8046             cash-gds-discnt.discnt-value = v-disc-price-sale
     8047             .
     8048             release cash-gds-discnt.
     8049           end.
     8050         end.
     8051       end.
     8052     end.
     8053     if cash-gds.temp-discnt-rule <> 0
     8054     and how-temp-disc = 'temp-disc-pdf':U
     8055     then do:
     8056       for each cash-dis-rule no-lock where
     8057             (cash-dis-rule.upper-rule-num = cash-gds.temp-discnt-rule
     8058         or cash-dis-rule.rule-num = cash-gds.temp-discnt-rule)
     8059         and cash-dis-rule.is-term = yes
     8060       :
     8061         run mpl-tpl-auto in this-procedure ( input cash-gds.b-code
     8062                                             ,input 'маг':U
     8063                                             ,input i-obj-code
     8064                                             ,input integer(entry(1, cash-dis-rule.charkey_one,"-"))
     8065                                             ,input integer(entry(2, cash-dis-rule.charkey_one,"-"))
     8066                                             ,input ?
     8067                                             ,output v-disc-price-sale
     8068                                             ,output v-pdf-id
     8069                                             ,output v-pdf-db-num ) no-error.
     8070         if error-status:error
     8071         or v-disc-price-sale = 0
     8072         or v-disc-price-sale = ?
     8073         then do:
     8074         end.
     8075         else do:
     8076           find first  cash-gds-discnt where
     8077                     cash-gds-discnt.b-code = cash-gds.b-code
     8078                   and  cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8079                   and cash-gds-discnt.obj-type = parobj-type
     8080                   and cash-gds-discnt.obj-code = parobj-code No-ERROR.
     8081           if not available cash-gds-discnt then do:
     8082             find first  cash-gds-discnt where
     8083                       cash-gds-discnt.crf = (crgd + 1) No-ERROR.
     8084             if not available cash-gds-discnt then do:
     8085               create cash-gds-discnt.
     8086               assign
     8087               cash-gds-discnt.crf = crgd + 1.
     8088             end.
     8089             crgd = crgd + 1.
     8090             assign
     8091             cash-gds-discnt.b-code = cash-gds.b-code
     8092             cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     8093             cash-gds-discnt.obj-type = parobj-type
     8094             cash-gds-discnt.obj-code = parobj-code
     8095             cash-gds-discnt.discnt-value = v-disc-price-sale.
     8096             release cash-gds-discnt.
     8097           end.
     8098         end.
     8099       end.
     8100     end.
     8101   end.
     8102   END PROCEDURE.
