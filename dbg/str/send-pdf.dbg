    12307               put unformatted
    12308               ( fill(" " , 16 -  length(cash-gds.b-str)) + cash-gds.b-str )
    12309               '00101'
    12310               caps( string( chk_name, 'x(20)' ) )
    12311               string( ( cash-gds.price-sale * 100 ) ,'999999999999')
    12312               .
    12313               put unformatted
    12314               '000000000000000000000000000'
    12315               string(action, "X(1)")
    12316               fill('0':U , 12)
    12317               string(v-r-b-curr-magia, "9")
    12318               fill('0':U , 104)
    12319               .
    12320               put skip.
    12321             end.
    12322           end.
    12323           else do:
    12324             if cash-gds.b-str = "" then do:
    12325                 assign
    12326                 b_code = string(cash-gds.b-code,'>>>>>>>>>>>>>>>9').
    12327                 run gen-bc(input cash-gds.b-code, output bar_code) no-error.
    12328                 if ((ub.shop.cd-loc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
    12329                     (ub.shop.cd-loc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
    12330                     put unformatted b_code '00101' caps(string(chk_name,'x(20)'))
    12331                                           string( ( cash-gds.price-sale * 100 ) ,'99999999').
    12332                     put unformatted '0000000000000000000000000000000'
    12333                     string(action, "X(1)") '0000000000000'.
    12334                     put skip.
    12335                 end.
    12336                 if ((ub.shop.cd-bc-base and cash-gds.unit-base = cash-gds.unit-cli) OR
    12337                     (ub.shop.cd-bc-alt and cash-gds.unit-base <> cash-gds.unit-cli)) then do:
    12338                     put unformatted (fill(" " , 16 -  length(bar_code)) + bar_code) '00101'
    12339                                                   caps(string(chk_name,'x(20)'))
    12340                                                   string(( cash-gds.price-sale * 100 ) ,'99999999') .
    12341                     put unformatted '0000000000000000000000000000000'
    12342                     string(action, "X(1)") '0000000000000'.
    12343                     put skip.
    12344                 end.
    12345             end.
    12346             else do:
    12347               put unformatted ( fill(" " , 16 -  length(cash-gds.b-str)) + cash-gds.b-str )
    12348                                         '00101' caps( string( chk_name, 'x(20)' ) )
    12349                                       string( ( cash-gds.price-sale * 100 ) ,'99999999') .
    12350               put unformatted '0000000000000000000000000000000'
    12351               string(action, "X(1)") '0000000000000'.
    12352               put skip.
    12353             end.
    12354           end.
    12355         end.
    12356       when 'NCR-GM':U
    12357       or when 'NCR-AS@R':U
    12358       then do:
    12359   define variable vss-include-info93 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12360   define variable ncr-disc-string as character no-undo .
    12361   if nam-artc then
    12362   chk_name = string( cash-gds.artic ) + " " + cash-gds.f-name.
    12363   else  do:
    12364     chk_name = "" .
    12365     DO ff = 1 TO num-entries( cash-gds.gds-name, '"' ) :
    12366       chk_name = chk_name + entry( ff, cash-gds.gds-name, '"' ) .
    12367     END .
    12368     if chk_name = "" then
    12369     chk_name = cash-gds.gds-name .
    12370     chk_name = chk_name + cash-gds.f-name .
    12371   end.
    12372   if (cash-gds.unit-base <> cash-gds.unit-cli) and
    12373      cash-gds.cli-base-rate <> 1 then
    12374   assign
    12375   chk_name = string(substr(chk_name, 1, 19 - length(string(cash-gds.cli-base-rate))) + "*" + string( cash-gds.cli-base-rate ), "x(20)" ).
    12376   else
    12377   chk_name = string(chk_name, "X(20)").
    12378   assign
    12379   ncrdsc = "0":U
    12380   conf-par = "":U
    12381   par-type ="":U
    12382   .
    12383   if std-disc-dec <> 0
    12384   or pos-type = 'NCR-AS@R':U
    12385   then do:
    12386     do ff = 1 to num-entries(ncrgmdsc, ";":U):
    12387       assign
    12388       par-type = entry(ff, ncrgmdsc , ";":U)
    12389       conf-par = entry(2, par-type, "=":U)
    12390       no-error
    12391       .
    12392       if error-status:error then do:
    12393         LEAVE.
    12394       end.
    12395       if conf-par  = string( - std-disc-dec) then do:
    12396         ncrdsc =  entry(1, par-type, "=").
    12397         LEAVE.
    12398       end.
    12399     end.
    12400   end.
    12401   assign
    12402   IBM-good-code = "":U
    12403   is-sc = no
    12404   .
    12405   run ncr-gdsc in this-procedure (output IBM-good-code
    12406                                 , output IBM-good-code-2
    12407                                 , output is-sc
    12408                                 , output taracode-bc
    12409                                 ) no-error .
    12410   if IBM-good-code = "":U then
    12411   assign
    12412   IBM-good-code= IBM-good-code-2
    12413   .
    12414   assign
    12415   conf-par =  ncr-d-rank(ncrdrank, cash-gds.qnty-discnt-rule,  cash-gds.temp-discnt-rule, cash-gds.date-discnt-rule )
    12416   .
    12417   do2:
    12418   do while IBm-good-code <> "":U:
    12419     if action = "D":U then do:
    12420       put stream IBMStream unformatted
    12421       fill(chr(32), 3)
    12422       IBM-good-code
    12423       "-":U
    12424       fill(chr(32), 61)
    12425       chr(10)
    12426       .
    12427     end.
    12428     else do:
    12429       if conf-par = "T":U then do:
    12430         ncr-disc-string = ncr-temp-disc(cash-gds.temp-discnt-rule, cash-gds.price-sale, temp-disc-dec).
    12431       end.
