     6979   procedure grp-obj-notcorr-value :
     6980   do
     6981   on error undo, return error
     6982   :
     6983   define input parameter p-node-code             as integer      no-undo.
     6984   define input parameter p-obj-type              as character    no-undo.
     6985   define input parameter p-obj-code              as integer      no-undo.
     6986   define output parameter p-notcorr              as character    no-undo init ?.
     6987   define output parameter p-range-notcorr     as integer      no-undo.
     6988   define output parameter p-exists-notcorr    as logical      no-undo.
     6989   define variable v-host-code as integer      no-undo.
     6990   DEFINE VARIABLE v-found as logical no-undo .
     6991   DEFINE VARIABLE v-exists as logical no-undo .
     6992   DEFINE VARIABLE v-range as integer no-undo .
     6993   DEFINE VARIABLE jj as integer no-undo .
     6994   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     6995   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     6996   define buffer buf_gds-grp for ub.gds-grp.
     6997   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     6998   find first buf_gds-grp no-lock where
     6999              buf_gds-grp.node-code = p-node-code no-error .
     7000   if not avail buf_gds-grp and p-node-code <> 0 then do:
     7001     message
     7002       vss-workfile vss-revision vss-description
     7003       skip "Не удалось найти группу товаров с кодом" p-node-code
     7004       view-as alert-box error .
     7005     undo, return error .
     7006   end.
     7007   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7008   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     7009     (input  p-obj-type
     7010     ,input  p-obj-code
     7011     ,output v-host-code
     7012     ) no-error .
     7013   if error-status :error
     7014   then do:
     7015       message
     7016         vss-workfile vss-revision vss-description
     7017         skip "Не удалось найти фирму объекта"
     7018         skip p-obj-type p-obj-code
     7019         skip return-value
     7020         skip trim(error-status :get-message(1))
     7021       view-as alert-box error.
     7022       undo, return error .
     7023   end.
     7024   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     7025   do while v-found = no and jj < 2:
     7026     if v-range <> 3 then do:
     7027       find first buf_gds-grp-obj no-lock
     7028           where buf_gds-grp-obj.node-code = p-node-code
     7029             and buf_gds-grp-obj.host-code = v-host-code
     7030             and buf_gds-grp-obj.obj-type  = p-obj-type
     7031             and buf_gds-grp-obj.obj-code  = p-obj-code
     7032       no-error .
     7033     end.
     7034     if v-range = 3 or not available buf_gds-grp-obj
     7035     then do:
     7036        if v-range <> 2 then do:
     7037           find first buf_gds-grp-obj no-lock
     7038               where buf_gds-grp-obj.node-code = p-node-code
     7039                 and buf_gds-grp-obj.host-code = v-host-code
     7040                 and buf_gds-grp-obj.obj-type  = ""
     7041                 and buf_gds-grp-obj.obj-code  = 0
     7042           no-error .
     7043         end.
     7044         if v-range = 2 or not available buf_gds-grp-obj
     7045         then do:
     7046             if v-range <> 1 then do:
     7047               find first buf_gds-grp-obj no-lock
     7048                   where buf_gds-grp-obj.node-code = p-node-code
     7049                   and buf_gds-grp-obj.host-code = 0
     7050                   and buf_gds-grp-obj.obj-type  = ""
     7051                   and buf_gds-grp-obj.obj-code  = 0
     7052               no-error .
     7053             end.
     7054             if v-range = 1 or not available buf_gds-grp-obj
     7055             then do:
     7056                 assign
     7057                     v-exists = no
     7058                 .
     7059             end.
     7060             else do:
     7061                 assign
     7062                     v-exists = yes
     7063                     v-range = 1
     7064                 .
     7065             end.
     7066         end.
     7067         else do:
     7068             assign
     7069                 v-exists = yes
     7070                 v-range  = 2
     7071             .
     7072         end.
     7073     end.
     7074     else do:
     7075         assign
     7076             v-exists = yes
     7077             v-range  = 3
     7078         .
     7079     end.
     7080     if available buf_gds-grp-obj
     7081     then do:
     7082       find first buf_gds-grp-obj-attr no-lock
     7083         where buf_gds-grp-obj-attr.node-code   = p-node-code
     7084           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     7085           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     7086           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     7087           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     7088         no-error .
     7089       if available buf_gds-grp-obj-attr then do:
     7090         assign
     7091           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     7092         .
     7093       end.
     7094       else do:
     7095         assign
     7096           v-notcorr-value = ?
     7097         .
     7098       end.
     7099       assign
     7100       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     7101                           then yes
     7102                           else p-exists-notcorr)
     7103       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     7104                         then v-range
     7105                         else p-range-notcorr
     7106       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     7107                         then v-notcorr-value
     7108                         else p-notcorr
     7109       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     7110       jj = jj + 1
     7111       .
     7112     end.
     7113     else do:
     7114       assign
     7115       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     7116       jj = jj + 1
     7117       .
     7118     end.
     7119   end.
     7120   end.
     7121   end procedure.
