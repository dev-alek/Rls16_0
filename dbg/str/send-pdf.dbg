    12734       , input "14.0 " + replace( vss-revision + vss-date, "$", " " )
    12735       , input v-obj-list
    12736       , input (
    12737                 (IF for-cash-desk.pos-type = 'IBM-XML':U
    12738                   then (if for-cash-desk.autonomy = integer('0':U)
    12739                         then  ("маг" + string(for-cash-desk.obj-code) + "_касса" + string(for-cash-desk.cash-num))
