    15069                                 , 'маг':U
    15070                                 , abs(i-obj-code)).
    15071     end.
    15072     if index(dob-curr, ";":U) > 0  and can-do(entry(2,dob-curr,";"),string(i-obj-code)) then do:
    15073       FIND LAST ub.curr-shop WHERE ub.curr-shop.obj-code = i-obj-code
    15074                               and ub.curr-shop.obj-type = 'маг':U
    15075                               and ub.curr-shop.curr-code = int(entry(1,dob-curr,";"))
    15076                               use-index pi NO-ERROR.
    15077       if available ub.curr-shop then curr_cass = ub.curr-shop.exch-rate / curr-shop.exch-scale.
    15078       else do:
