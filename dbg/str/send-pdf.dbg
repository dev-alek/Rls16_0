        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-parent-handle  as widget-handle no-undo .
        4   define input parameter p-log-handle  as handle no-undo .
        5   define input parameter p-parameter   as character no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: send-pdf.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: str/send-pdf.p $":U .
       11   define variable vss-description as character no-undo init "Пересылка и удаление товаров из ДНЦ".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   define variable v-cntxt-db-num        as integer   no-undo .
       82   define variable v-cntxt-userid        as character no-undo .
       83   define variable action as character no-undo init "U".
       84   define variable pdf-action as character no-undo.
       85   define variable p-doc-num like ub.price-doc-forming.pdf-id no-undo .
       86   define variable p-pdf-db like ub.price-doc-forming.pdf-db no-undo .
       87   define variable p-plt-id like ub.price-doc-forming.plt-id no-undo .
       88   define variable p-plt-db-num like ub.price-doc-forming.plt-db-num no-undo .
       89   define variable i-obj-code like ub.clients.obj-code no-undo.
       90   define variable p-batch as logical no-undo .
       91   define variable p-other    as character no-undo .
       92   define buffer p-doc for ub.price-doc-forming .
       93   assign
       94   pdf-action = entry(1, p-parameter, chr(4))
       95   p-plt-id = integer(entry(2, p-parameter, chr(4)))
       96   p-plt-db-num = integer(entry(3, p-parameter, chr(4)))
       97   p-doc-num = integer(entry(4, p-parameter, chr(4)))
       98   p-pdf-db = integer(entry(5, p-parameter, chr(4)))
       99   i-obj-code = integer(entry(6, p-parameter, chr(4)))
      100   no-error
      101   .
      102   if  error-status:error then return error .
      103   find first p-doc no-lock where
      104            p-doc.plt-id = p-plt-id
      105        and p-doc.plt-db-num = p-plt-db-num
      106        and p-doc.pdf-id = p-doc-num
      107        and p-doc.pdf-db = p-pdf-db
      108            no-error .
      109   if not available p-doc then return error substitute("Не найден ДНЦ &1 по БД &2 (ТПЛ &3 от БД &4)"
      110                                                        ,p-doc-num
      111                                                        ,p-pdf-db
      112                                                        ,p-plt-id
      113                                                        ,p-plt-db-num).
      114   if not g#news
      115   and not g#auto then do:
      116   run get-userid in parparentproc ( output v-cntxt-userid) .
      117   run get-db-num in parparentproc ( output v-cntxt-db-num) .
      118   end.
      119   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      120   def new shared var bc-frmt as character no-undo .
      121   def new shared var bc-pfx  as character no-undo .
      122   def var bc-par-type as character no-undo .
      123       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
      124       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
      125           do:
      126               message "Не задан или не верно задан ТИП собственного бар-кода!"
      127                   view-as alert-box ERROR TITLE "".
      128               return error.
      129           end.
      130       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
      131       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
      132           do:
      133               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      134                   view-as alert-box ERROR TITLE "".
      135               return error.
      136           end.
      137   PROCEDURE gen-bc:
      138     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
      139     def output parameter full-b-code     as character init ""    no-undo .
      140   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      141     define variable tmp-str1  as character no-undo.
      142     define variable tmp-num1  as character no-undo.
      143     define variable i1        as integer   no-undo.
      144     define variable sum1      as integer   no-undo.
      145     define variable len-code1 as integer   no-undo.
      146     define variable varcont1  as logical   initial yes no-undo.
      147     CASE bc-frmt :
      148       WHEN "EAN13" THEN do:
      149         assign
      150           tmp-str1 = string( internal-b-code, "999999999999" )
      151         .
      152       end.
      153       WHEN "EAN8" THEN do:
      154         assign
      155           tmp-str1 = string( internal-b-code, "9999999" )
      156         .
      157       end.
      158       OTHERWISE DO:
      159           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
      160           view-as alert-box error.
      161           return error.
      162       END.
      163     END CASE.
      164     if varcont1 = yes then do:
      165       if integer( substring( tmp-str1, 1, length( bc-pfx ) ) ) <> 0
      166       then do:
      167         message
      168           "Невозможно сформировать бар-код" SKIP
      169           "для товара с кодом: " internal-b-code
      170           view-as alert-box error title "подрезание кода".
      171         return error.
      172       end.
      173       else do:
      174         assign
      175           full-b-code = bc-pfx + substring( tmp-str1, length( bc-pfx ) + 1, length( tmp-str1 ) - length( bc-pfx ) )
      176           len-code1    = length( full-b-code )
      177         .
      178         define variable v-sum-char1 as character no-undo .
      179         assign
      180           sum1 = 0
      181         .
      182         do i1 = 1 to len-code1 by 2
      183         :
      184           assign
      185             v-sum-char1 = substr(full-b-code, len-code1 - i1 + 1, 1)
      186           .
      187           if v-sum-char1 < "0"
      188           or v-sum-char1 > "9"
      189           then do:
      190             message
      191               "Невозможно сформировать бар-код" skip
      192               "для товара с кодом: " internal-b-code skip
      193               view-as alert-box error title "подсчет контрольной суммы".
      194             return error.
      195           end.
      196           assign
      197             sum1 = sum1 + integer(v-sum-char1)
      198           .
      199         end.
      200         if varcont1 = yes then do:
      201           assign
      202             sum1 = sum1 * 3
      203           .
      204           do i1 = 2 to len-code1 by 2
      205           :
      206             assign
      207               v-sum-char1 = substr(full-b-code, len-code1 - i1 + 1, 1)
      208             .
      209             if v-sum-char1 < "0"
      210             or v-sum-char1 > "9"
      211             then do:
      212               message
      213                 "Невозможно сформировать бар-код" skip
      214                 "для товара с кодом: " internal-b-code skip
      215                 view-as alert-box error title "подсчет контрольной суммы".
      216               return error.
      217             end.
      218             assign
      219               sum1 = sum1 + integer(v-sum-char1)
      220             .
      221           end.
      222           if varcont1 = yes then do:
      223              if sum1 mod 10 = 0 then do:
      224                assign
      225                  full-b-code = full-b-code + '0'
      226                .
      227              end.
      228              else do:
      229                assign
      230                  full-b-code = full-b-code + string(10 - sum1 mod 10)
      231                .
      232              end.
      233           end.
      234         end.
      235       end.
      236     end.
      237   END PROCEDURE.
      238   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile: defc-gds.i $ $Revision: 47e5c2a27e63, 2885, rls $".
