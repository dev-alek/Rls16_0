    12743                   )
    12744               )
    12745       , input (if for-cash-desk.autonomy = integer('0':U) then no else yes)
    12746   ).
    12747   output stream stmxmlout to value( v-xml-file-name-path + "xm1" ) convert target "1251" append.
    12748   OS2-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9").
    12749     end.
    12750     when 'IBM':U
    12751     then do:
    12752   define variable vss-include-info98 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    12753   if for-cash-desk.cash-os = ""
    12754   AND for-cash-desk.pos-type <> 'Emulator-NKT-IBM':U
