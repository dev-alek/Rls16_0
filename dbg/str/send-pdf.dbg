     7304   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7305   function ncr-amnt-disc returns character (
     7306     input p-pcnt-discnt-rule as integer, input p-price-sale as decimal).
     7307   define variable v-result as character no-undo .
     7308   define variable ii as integer no-undo .
     7309   define variable v-entry as character no-undo extent 3.
     7310   for each cash-dis-rule  no-lock where
     7311         cash-dis-rule.upper-rule-num = p-pcnt-discnt-rule:
     7312     assign
     7313     ii = ii + 1
     7314     v-entry[ii] = "000000":U + string(round(cash-dis-rule.doc-qnty / cash-gds.cli-base-rate, 0), "999999":U) +
     7315                   replace(string(p-price-sale * (1 - cash-dis-rule.discnt-value / 100), "999999.99"), ".":U, "":U)
     7316     .
     7317   end.
     7318   if v-entry[2] = "":U then
     7319   assign
     7320   v-entry[2] = v-entry[1]
     7321   .
     7322   if v-entry[3] = "":U then
     7323   assign
     7324   v-entry[3] = v-entry[2]
     7325   .
     7326   assign
     7327   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7328   .
     7329   return v-result.
     7330   END FUNCTION.
     7331   function ncr-date-disc returns character (
     7332     input p-date-discnt-rule  as integer, input p-price-sale as decimal).
     7333   define variable v-result as character no-undo .
     7334   define variable ii as integer no-undo .
     7335   define variable v-entry as character no-undo extent 3.
     7336   for each cash-dis-rule  no-lock where
     7337         cash-dis-rule.upper-rule-num = p-date-discnt-rule,
     7338       first cash-dis-time-rule no-lock where cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num :
     7339     assign
     7340     ii = ii + 1
     7341     v-entry[ii] =
     7342                   substring(string(year(cash-dis-time-rule.date-from), "9999":U), 3, 2)   +
     7343                   string(month(cash-dis-time-rule.date-from), "99":U) +
     7344                   string(day(cash-dis-time-rule.date-from), "99":U)  +
     7345                   substring(string(year(cash-dis-time-rule.date-to), "9999":U), 3, 2)   +
     7346                   string(month(cash-dis-time-rule.date-to), "99":U) +
     7347                   string(day(cash-dis-time-rule.date-to), "99":U) +
     7348                   replace(string(cash-gds.price-sale * (1 - cash-dis-rule.discnt-value / 100), "999999.99"), ".":U, "":U).
     7349   end.
     7350   if v-entry[2] = "":U then
     7351   assign
     7352   v-entry[2] = v-entry[1]
     7353   .
     7354   if v-entry[3] = "":U then
     7355   assign
     7356   v-entry[3] = v-entry[2]
     7357   .
     7358   assign
     7359   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7360   .
     7361   return v-result.
     7362   END FUNCTION.
     7363   function ncr-temp-disc returns character (
     7364     input p-temp-discnt-rule  as integer, input p-price-sale as decimal, p-temp-disc-dec as decimal).
     7365   define variable v-result as character no-undo .
     7366   define variable ii as integer no-undo .
     7367   define variable v-entry as character no-undo extent 3.
     7368   define variable v-dec as decimal no-undo .
     7369   define variable v-disc-price-sale as decimal no-undo .
     7370   define variable v-pdf-id as integer no-undo .
     7371   define variable v-pdf-db-num as integer no-undo .
     7372   define buffer buf_cash-dis-rule for cash-dis-rule.
     7373   find first buf_cash-dis-rule where
     7374            buf_cash-dis-rule.rule-num = p-temp-discnt-rule no-error .
     7375   if not available buf_cash-dis-rule then return "":U.
     7376   if buf_cash-dis-rule.templ-rl-root <> 29
     7377   and buf_cash-dis-rule.templ-rl-root <> 86
     7378   then do:
     7379     assign
     7380     v-entry[1] =
     7381     "000"                                                   +
     7382     "0"                                                     +
     7383     "0000"                                                  +
     7384     "2359"                                                     +
     7385      replace(string(cash-gds.price-sale * (1 + p-temp-disc-dec / 100), "999999.99"), ".":U, "":U)
     7386      .
     7387   end.
     7388   else do:
     7389     for each cash-dis-rule  no-lock where
     7390           cash-dis-rule.upper-rule-num = p-temp-discnt-rule ,
     7391         first cash-dis-time-rule no-lock where cash-dis-time-rule.time-rule-num = cash-dis-rule.time-rule-num :
     7392       case cash-dis-rule.value-type:
     7393         when integer('1':U) then do:
     7394           v-dec = cash-gds.price-sale * (1 - cash-dis-rule.discnt-value / 100).
     7395         end.
     7396         when integer('12':U) then do:
     7397           find first cash-gds-discnt where
     7398                     cash-gds-discnt.b-code = cash-gds.b-code
     7399                 and cash-gds-discnt.rule-num = cash-dis-rule.rule-num
     7400                 and cash-gds-discnt.obj-type = 'маг':U
     7401                 and cash-gds-discnt.obj-code = i-obj-code
     7402                 no-error.
     7403           if not available cash-gds-discnt then do:
     7404             v-dec = cash-gds.price-sale.
     7405           end.
     7406           else do:
     7407             assign
     7408             v-dec = cash-gds-discnt.discnt-value
     7409             .
     7410           end.
     7411         end.
     7412         otherwise do:
     7413           v-dec = cash-gds.price-sale.
     7414         end.
     7415       end case.
     7416       assign
     7417       ii = ii + 1
     7418       v-entry[ii] =
     7419                     "000"                                                   +
     7420                     (if cash-dis-time-rule.week-day-0 then "0" else "":U)   +
     7421                     (if cash-dis-time-rule.week-day-7 then "1" else "":U)   +
     7422                     (if cash-dis-time-rule.week-day-1 then "2" else "":U)   +
     7423                     (if cash-dis-time-rule.week-day-2 then "3" else "":U)   +
     7424                     (if cash-dis-time-rule.week-day-3 then "4" else "":U)   +
     7425                     (if cash-dis-time-rule.week-day-4 then "5" else "":U)   +
     7426                     (if cash-dis-time-rule.week-day-5 then "6" else "":U)   +
     7427                     (if cash-dis-time-rule.week-day-6 then "7" else "":U)   +
     7428                     replace(string(cash-dis-time-rule.time-from, "HH:MM"), ":":U, "":U) +
     7429                     replace(string(cash-dis-time-rule.time-to, "HH:MM"), ":":U, "":U) +
     7430                     replace(string(v-dec, "999999.99"), ".":U, "":U)
     7431       .
     7432   if ii = 3 then leave.
     7433     end.
     7434   end.
     7435   if v-entry[2] = "":U then
     7436   assign
     7437   v-entry[2] = v-entry[1]
     7438   .
     7439   if v-entry[3] = "":U then
     7440   assign
     7441   v-entry[3] = v-entry[2]
     7442   .
     7443   assign
     7444   v-result = v-entry[1] + v-entry[2] + v-entry[3]
     7445   .
     7446   return v-result.
     7447   END FUNCTION.
     7448   function ncr-d-rank returns character (
     7449     input p-d-rank as character, input p-pcnt-discnt-rule  as integer, input p-temp-discnt-rule as integer, input p-date-discnt-rule as integer).
     7450   define variable v-result as character no-undo .
     7451   define variable ii as integer no-undo .
     7452   do ii = 1 to length(p-d-rank):
     7453     CASE substr(p-d-rank, ii, 1):
     7454       when "X":U then do:
     7455         if p-pcnt-discnt-rule <> 0 then v-result = "X":U.
     7456       end.
     7457       when "T":U then do:
     7458         if p-temp-discnt-rule <> 0 then v-result = "T":U.
     7459       end.
     7460       when "D":U then do:
     7461         if p-date-discnt-rule <> 0 then v-result = "D":U.
     7462       end.
     7463     END CASE.
     7464     if v-result <> "":U then LEAVE.
     7465   end.
     7466   if v-result = "":U then v-result = chr(32).
     7467   return v-result.
     7468   END FUNCTION.
     7469   FUNCTION check-ban-sales-via-cd return logical ( input p-gds-code as integer ) :
     7470       define variable v-upper-code as int no-undo.
     7471       define variable v-value as character no-undo.
     7472       define variable v-type as character no-undo.
     7473       define buffer lc_gds-grp for ub.gds-grp.
     7474       define buffer lc_goods for ub.goods.
     7475      if p-gds-code <> 0 then do:
     7476       find first lc_goods where lc_goods.gds-code = p-gds-code.
     7477       v-upper-code = lc_goods.grp-code.
     7478       do while v-upper-code > 0 :
     7479           find first lc_gds-grp where lc_gds-grp.node-code = v-upper-code.
     7480           run ggoattr-value(
     7481             input lc_gds-grp.node-code,
     7482             input 0,
     7483             input "",
     7484             input 0,
     7485             input 'ban-sales-via-cd':U,
     7486             output v-value,
     7487             output v-type
     7488           ).
     7489          if v-value = "yes" then
     7490             return true.
     7491          else
     7492          do:
     7493             run ggoattr-value(
     7494                input lc_gds-grp.node-code,
     7495                input shop.host-code,
     7496                input "",
     7497                input 0,
     7498                input 'ban-sales-via-cd':U,
     7499                output v-value,
     7500                output v-type
     7501                ).
     7502             if v-value = "yes" then
     7503                return true.
     7504             else
     7505             do:
     7506                run ggoattr-value(
     7507                   input lc_gds-grp.node-code,
     7508                   input shop.host-code,
     7509                   input 'маг':U,
     7510                   input i-obj-code,
     7511                   input 'ban-sales-via-cd':U,
     7512                   output v-value,
     7513                   output v-type
     7514                   ).
     7515                if v-value = "yes" then
     7516                   return true.
     7517                else v-upper-code = lc_gds-grp.upper-code.
     7518             end .
     7519          end.
     7520         end.
     7521       end.
     7522   end.
     7523   FUNCTION convert-tax-code returns integer
     7524                                             ( input p-rate-code as integer
     7525                                              ,input p-cdtaxlst  as character
     7526                                             ) :
     7527   define variable jj as integer no-undo .
     7528     do jj = 1 to num-entries(p-cdtaxlst, ";"):
     7529       if entry(jj, p-cdtaxlst, ";") begins (string(p-rate-code) + "-") then do:
     7530         return integer(entry(2, entry(jj, p-cdtaxlst, ";"), "-":U)).
     7531       end.
     7532     end.
     7533   END FUNCTION.
     7534   FUNCTION convert-maria-tax-code returns character
     7535                                             ( input p-vat-rate-code as integer
     7536                                              ,input p-slt-rate-code as integer
     7537                                              ,input p-cdtaxlst  as character
     7538                                             ) :
     7539   define variable jj as integer no-undo .
     7540   define variable aa as character no-undo extent 8.
     7541   define variable v-return-value as character no-undo .
     7542     do jj = 1 to 8:
     7543       if jj <= num-entries(p-cdtaxlst, ";") then do:
     7544         if entry(jj, p-cdtaxlst, ";") begins (string(p-vat-rate-code) + "-") then do:
     7545           aa[jj] = '1'.
     7546         end.
     7547         if entry(jj, p-cdtaxlst, ";") begins (string(p-slt-rate-code) + "-") then do:
     7548           aa[jj] = '1'.
     7549         end.
     7550       end.
     7551       if aa[jj] = '':U then aa[jj] = '0'.
     7552       v-return-value = aa[jj] + v-return-value.
     7553     end.
     7554   return v-return-value.
     7555   END FUNCTION.
     7556   FUNCTION convert-maria-tax-code-2 returns integer
     7557                                             ( input p-rate-code as integer
     7558                                              ,input p-cdtaxlst  as character
     7559                                             ) :
     7560   define variable jj as integer no-undo .
     7561   define variable v-return-value as integer no-undo .
     7562     do jj = 1 to num-entries(p-cdtaxlst, ";"):
     7563       if entry(jj, p-cdtaxlst, ";") begins (string(p-rate-code) + "-") then do:
     7564         return jj.
     7565       end.
     7566     end.
     7567   return 0.
     7568   END FUNCTION.
     7569   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
