     6111   procedure fact-order-mpl :
     6112     do
     6113     on error undo, return error return-value
     6114     :
     6115   define input  parameter p-doc-date as date     no-undo .
     6116   define input  parameter p-obj-type as character no-undo .
     6117   define input  parameter p-obj-code as integer   no-undo .
     6118   define output parameter p-fact-order as decimal   no-undo .
     6119   define variable v-fact-date            as date    no-undo .
     6120   define variable v-fact-time            as integer no-undo .
     6121   define variable v-fact-order           as decimal no-undo .
     6122   define variable v-shift-end-fact-order as decimal no-undo .
     6123   define variable v-day-end-fact-order   as decimal no-undo .
     6124   define variable l-shift-on as logical no-undo .
     6125   define variable l-date as date      no-undo .
     6126   define variable l-time as integer   no-undo .
     6127   define variable shift-date as date      no-undo .
     6128   define variable shift-num  as integer   no-undo .
     6129   define variable shift-name as character no-undo .
     6130   define variable max-fact-order as decimal   no-undo .
     6131   define buffer buf_global-state for ub.global-state  .
     6132   find first buf_global-state no-lock no-error .
     6133   if not available buf_global-state then do:
     6134      message
     6135        "Не заданы параметры ценообразования!"
     6136        view-as alert-box error
     6137      .
     6138      return error return-value .
     6139   end.
     6140     run cur-time in this-procedure
     6141     ( output v-fact-date ,
     6142       output v-fact-time  ).
     6143   if p-doc-date = ? then do:
     6144   if buf_global-state.pl-use-sys-date-time  = true then do:
     6145         run factord in this-procedure
     6146           (input  v-fact-date
     6147           ,input  v-fact-time
     6148           ,input  v-fact-time
     6149           ,input  ?
     6150           ,input  ?
     6151           ,input  false
     6152           ,output v-fact-order
     6153           ,output v-shift-end-fact-order
     6154           ,output v-day-end-fact-order
     6155           ) no-error .
     6156         if error-status :error
     6157         or v-fact-order = ?
     6158         or v-fact-order = 0 then do:
     6159           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6160         end.
     6161         p-fact-order = v-fact-order .
     6162   end.
     6163   else do:
     6164   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6165   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     6166     (input  p-obj-type
     6167     ,input  p-obj-code
     6168     ,input  'shift-on=request'
     6169     ,output l-shift-on
     6170     ) no-error .
     6171         if error-status :error then return error "Неопределена дата на объекте " + return-value .
     6172         if p-doc-date <> ? then do:
     6173         end.
     6174          run gbl/factdate.p
     6175          ( input        p-obj-type  ,
     6176            input        p-obj-code  ,
     6177            input-output v-fact-date ,
     6178            input-output v-fact-time ,
     6179            input-output shift-date      ,
     6180            input-output shift-num       ,
     6181            input-output shift-name      ,
     6182            input        yes
     6183            ) no-error .
     6184         if error-status :error then return error substitute(" Ошибка из factdate.p: &1 &2"  , return-value , error-status :get-message(1)   ) .
     6185         run factord in this-procedure
     6186           (input  v-fact-date
     6187           ,input  v-fact-time
     6188           ,input  v-fact-time
     6189           ,input  shift-date
     6190           ,input  shift-num
     6191           ,input  l-shift-on
     6192           ,output v-fact-order
     6193           ,output v-shift-end-fact-order
     6194           ,output v-day-end-fact-order
     6195           ) no-error .
     6196         if error-status :error
     6197         or v-fact-order = ?
     6198         or v-fact-order = 0 then do:
     6199           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6200         end.
     6201         p-fact-order = v-fact-order .
     6202   end.
     6203   end.
     6204   else do:
     6205          run gbl/factdate.p
     6206          ( input        p-obj-type  ,
     6207            input        p-obj-code  ,
     6208            input-output v-fact-date ,
     6209            input-output v-fact-time ,
     6210            input-output shift-date      ,
     6211            input-output shift-num       ,
     6212            input-output shift-name      ,
     6213            input        yes
     6214            ) no-error .
     6215         if error-status :error then return error "Ошибка factdate.p " + return-value .
     6216         v-fact-date = p-doc-date .
     6217         run factord in this-procedure
     6218           (input  v-fact-date
     6219           ,input  v-fact-time
     6220           ,input  v-fact-time
     6221           ,input  shift-date
     6222           ,input  shift-num
     6223           ,input  l-shift-on
     6224           ,output v-fact-order
     6225           ,output v-shift-end-fact-order
     6226           ,output v-day-end-fact-order
     6227           ) no-error .
     6228         if error-status :error
     6229         or v-fact-order = ?
     6230         or v-fact-order = 0 then do:
     6231           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6232         end.
     6233         p-fact-order = v-fact-order .
     6234   end.
     6235     end.
     6236   end procedure.
