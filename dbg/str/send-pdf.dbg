    13491         for each  buf_cash-ncr-dis-kat no-lock where
    13492                   buf_cash-ncr-dis-kat.dis-kat = cash-ncr-dis-kat.dis-kat
    13493               AND buf_cash-ncr-dis-kat.cd-subject-code >= v-cd-subject-code
    13494               and crf <= cr-ncr-dis-kat
