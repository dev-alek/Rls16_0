    13502           find first  cash-ncr-save-param no-lock where
    13503                         cash-ncr-save-param.dis-kat = cash-ncr-dis-kat.dis-kat
    13504                     AND cash-ncr-save-param.cd-line = (buf_cash-ncr-dis-kat.cd-subject-code +
    13505                                                       substring(buf_cash-ncr-dis-kat.cd-disc-string , 1, 2)) no-error.
    13506           if available cash-ncr-save-param then do:
