     7234   def var vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7235   define temp-table cash-dis-rule no-undo like ub.dis-rule.
     7236   define temp-table cash-dis-time-rule no-undo like ub.dis-time-rule.
     7237   procedure create-dis-rule :
     7238   define input parameter p-rule-num like ub.dis-rule.rule-num no-undo .
     7239   define input parameter p-tree as logical no-undo .
     7240   define buffer buf_dis-rule for ub.dis-rule.
     7241   define buffer buf_dis-time-rule for ub.dis-time-rule.
     7242   define buffer term_dis-rule for ub.dis-rule.
     7243   define buffer term_dis-time-rule for ub.dis-time-rule.
     7244   define buffer root_cash-dis-rule for cash-dis-rule.
     7245   define buffer root_cash-dis-time-rule for cash-dis-time-rule.
     7246   define buffer term_cash-dis-rule for cash-dis-rule.
     7247   define buffer term_cash-dis-time-rule for cash-dis-time-rule.
     7248     do
     7249     on error undo, return error
     7250     :
     7251       find first root_cash-dis-rule no-lock where                                                         ~
     7252                 root_cash-dis-rule.rule-num = p-rule-num no-error.
     7253       if not available root_cash-dis-rule then do:
     7254         find first buf_dis-rule no-lock where
     7255                   buf_dis-rule.rule-num = p-rule-num no-error.
     7256         if available buf_dis-rule then do:
     7257           if buf_dis-rule.time-rule-num <> 0 then do:
     7258             find first buf_dis-time-rule no-lock where
     7259                       buf_dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     7260           end.
     7261           create root_cash-dis-rule.
     7262           buffer-copy buf_dis-rule to root_cash-dis-rule.
     7263           if available buf_dis-time-rule then do:
     7264             find first root_cash-dis-time-rule no-lock where
     7265                       root_cash-dis-time-rule.time-rule-num = buf_dis-rule.time-rule-num no-error.
     7266             if not available root_cash-dis-time-rule then do:
     7267               create root_cash-dis-time-rule.
     7268               buffer-copy buf_dis-time-rule to root_cash-dis-time-rule.
     7269             end.
     7270           end.
     7271           else do:
     7272             assign
     7273             root_cash-dis-rule.time-rule-num = 0.
     7274           end.
     7275           if buf_dis-rule.uniq-field <> "":U then do:
     7276             for each term_dis-rule no-lock where
     7277                     term_dis-rule.upper-rule-num =  buf_dis-rule.rule-num:
     7278               if term_dis-rule.time-rule-num <> 0 then do:
     7279                 find first term_dis-time-rule no-lock where
     7280                           term_dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     7281               end.
     7282               create term_cash-dis-rule.
     7283               buffer-copy term_dis-rule to term_cash-dis-rule.
     7284               if term_dis-rule.time-rule-num = 0
     7285               or available term_dis-time-rule
     7286               or root_cash-dis-rule.time-rule-num = 0
     7287               then do:
     7288                 if available term_dis-time-rule then do:
     7289                   find first term_cash-dis-time-rule no-lock where
     7290                             term_cash-dis-time-rule.time-rule-num = term_dis-rule.time-rule-num no-error.
     7291                   if not available term_cash-dis-time-rule then do:
     7292                     create term_cash-dis-time-rule.
     7293                     buffer-copy term_dis-time-rule to term_cash-dis-time-rule.
     7294                   end.
     7295                 end.
     7296               end.
     7297             end.
     7298           end.
     7299         end.
     7300       end.
     7301     end.
     7302   end procedure.
