    13438             end.
    13439             v-next = yes.
    13440           end.
    13441           _for_rr2:
    13442           for each  buf_cash-ncr-dis-kat no-lock where
    13443                     buf_cash-ncr-dis-kat.dis-kat = cash-ncr-dis-kat.dis-kat
    13444                 AND buf_cash-ncr-dis-kat.cd-subject-code <= v-cd-subject-code
    13445                 AND buf_cash-ncr-dis-kat.cd-subject-code > ss0
    13446                 and crf <= cr-ncr-dis-kat
    13447           by buf_cash-ncr-dis-kat.cd-subject-code
    13448           by buf_cash-ncr-dis-kat.cd-disc-string
    13449           :
    13450             if buf_cash-ncr-dis-kat.cd-subject-code = v-cd-subject-code
    13451             and SUBSTRING(buf_cash-ncr-dis-kat.cd-disc-string, 1, 7) > v-cd-disc-string then do:
    13452               leave  _for_rr2.
    13453             end.
    13454             if buf_cash-ncr-dis-kat.cd-subject-code = v-cd-subject-code then do:
    13455               v-updated-subject-dis-kat = yes.
    13456             end.
    13457             find first  cash-ncr-save-param no-lock where
    13458                             cash-ncr-save-param.dis-kat = cash-ncr-dis-kat.dis-kat
    13459                         AND cash-ncr-save-param.cd-line = (buf_cash-ncr-dis-kat.cd-subject-code +
    13460                                                           substring(buf_cash-ncr-dis-kat.cd-disc-string , 1, 2)) no-error.
    13461             if available cash-ncr-save-param then do:
