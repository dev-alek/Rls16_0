    13411         end.
    13412         input stream bar from value(v-kat-file) convert source "ibm866" .
    13413         assign
    13414         ss0 = ''
    13415         ss = '':U
    13416         v-cd-subject-code = '':U
    13417         v-cd-disc-string  = '':U
    13418         v-next = no
    13419         v-updated-subject-dis-kat = no
    13420         .
    13421         output stream plucash to value(v-temp-kat-file) convert target "ibm866".
    13422         _rr2:
    13423         repeat:
    13424           import stream bar unformatted ss.
    13425           assign
    13426           v-next = no
    13427           v-updated-subject-dis-kat = no
    13428           v-cd-subject-code = substring(ss, 1, 16)
    13429           v-cd-disc-string =  substring(ss, 17, 7)
    13430           .
    13431           if not ss begins fill(chr(32), 2 )
    13432           then do:
    13433             if substring(ss0, 1, 3) = substring(v-cd-subject-code, 1, 3) then do:
    13434               put stream plucash unformatted
