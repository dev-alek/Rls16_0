     2095   procedure xmlchar-encode :
     2096   define input parameter p-in-string      as character        no-undo.
     2097   define output parameter p-out-string    as character        no-undo.
     2098       define variable v-position      as integer      no-undo.
     2099       define variable v-current-char  as character    no-undo.
     2100   do
     2101   on error undo, return error
     2102   :
     2103       assign
     2104           p-out-string = "":U
     2105       .
     2106       case p-in-string
     2107       :
     2108           when ?
     2109           then do:
     2110               assign
     2111                   p-out-string = "?":U
     2112               .
     2113           end.
     2114           when "?":U
     2115           then do:
     2116               assign
     2117                   p-out-string = "&#63;":U
     2118               .
     2119           end.
     2120           otherwise do:
     2121               do v-position = 1 to length( p-in-string )
     2122               :
     2123                   assign
     2124                       v-current-char = substring( p-in-string, v-position, 1 )
     2125                   .
     2126                   case v-current-char
     2127                   :
     2128                       when "&":U
     2129                       then do:
     2130                           assign
     2131                               p-out-string = p-out-string + "&amp;":U
     2132                           .
     2133                       end.
     2134                       when ">":U
     2135                       then do:
     2136                           assign
     2137                               p-out-string = p-out-string + "&gt;":U
     2138                           .
     2139                       end.
     2140                       when "<":U
     2141                       then do:
     2142                           assign
     2143                               p-out-string = p-out-string + "&lt;":U
     2144                           .
     2145                       end.
     2146                       when "'":U
     2147                       then do:
     2148                           assign
     2149                               p-out-string = p-out-string + "&apos;":U
     2150                           .
     2151                       end.
     2152                       when '"':U
     2153                       then do:
     2154                           assign
     2155                               p-out-string = p-out-string + "&quot;":U
     2156                           .
     2157                       end.
     2158                       when chr(1)
     2159                       then do:
     2160                           assign
     2161                               p-out-string = p-out-string + "":U
     2162                           .
     2163                       end.
     2164                       when chr(2)
     2165                       then do:
     2166                           assign
     2167                               p-out-string = p-out-string + "":U
     2168                           .
     2169                       end.
     2170                       when chr(3)
     2171                       then do:
     2172                           assign
     2173                               p-out-string = p-out-string + "":U
     2174                           .
     2175                       end.
     2176                       when chr(4)
     2177                       then do:
     2178                           assign
     2179                               p-out-string = p-out-string + "":U
     2180                           .
     2181                       end.
     2182                       when chr(5)
     2183                       then do:
     2184                           assign
     2185                               p-out-string = p-out-string + "":U
     2186                           .
     2187                       end.
     2188                       when chr(6)
     2189                       then do:
     2190                           assign
     2191                               p-out-string = p-out-string + "":U
     2192                           .
     2193                       end.
     2194                       when chr(7)
     2195                       then do:
     2196                           assign
     2197                               p-out-string = p-out-string + "":U
     2198                           .
     2199                       end.
     2200                       when chr(8)
     2201                       then do:
     2202                           assign
     2203                               p-out-string = p-out-string + "":U
     2204                           .
     2205                       end.
     2206                       when chr(9)
     2207                       then do:
     2208                           assign
     2209                               p-out-string = p-out-string + "":U
     2210                           .
     2211                       end.
     2212                       when chr(29)
     2213                       then do:
     2214                           assign
     2215                               p-out-string = p-out-string + "":U
     2216                           .
     2217                       end.
     2218                       when chr(10)
     2219                       then do:
     2220                           assign
     2221                               p-out-string = p-out-string + "&#10;":U
     2222                           .
     2223                       end.
     2224                       when chr(13)
     2225                       then do:
     2226                           assign
     2227                               p-out-string = p-out-string + "&#13;":U
     2228                           .
     2229                       end.
     2230                       otherwise do:
     2231                           assign
     2232                               p-out-string = p-out-string + v-current-char
     2233                           .
     2234                       end.
     2235                   end case.
     2236               end.
     2237           end.
     2238       end case.
     2239   end.
     2240   end .
     2241   procedure xmlchar-encode-1c :
     2242   define input parameter p-in-string      as character        no-undo.
     2243   define output parameter p-out-string    as character        no-undo.
     2244       define variable v-position      as integer      no-undo.
     2245       define variable v-current-char  as character    no-undo.
     2246   do
     2247   on error undo, return error
     2248   :
     2249       assign
     2250           p-out-string = "":U
     2251       .
     2252       case p-in-string
     2253       :
     2254           when ?
     2255           then do:
     2256               assign
     2257                   p-out-string = "?":U
     2258               .
     2259           end.
     2260           otherwise do:
     2261               do v-position = 1 to length( p-in-string )
     2262               :
     2263                   assign
     2264                       v-current-char = substring( p-in-string, v-position, 1 )
     2265                   .
     2266                   case v-current-char
     2267                   :
     2268                       when chr(1)
     2269                       then do:
     2270                           assign
     2271                               p-out-string = p-out-string + " ":U
     2272                           .
     2273                       end.
     2274                       when chr(2)
     2275                       then do:
     2276                           assign
     2277                               p-out-string = p-out-string + " ":U
     2278                           .
     2279                       end.
     2280                       when chr(3)
     2281                       then do:
     2282                           assign
     2283                               p-out-string = p-out-string + " ":U
     2284                           .
     2285                       end.
     2286                       when chr(4)
     2287                       then do:
     2288                           assign
     2289                               p-out-string = p-out-string + " ":U
     2290                           .
     2291                       end.
     2292                       when chr(5)
     2293                       then do:
     2294                           assign
     2295                               p-out-string = p-out-string + " ":U
     2296                           .
     2297                       end.
     2298                       when chr(6)
     2299                       then do:
     2300                           assign
     2301                               p-out-string = p-out-string + " ":U
     2302                           .
     2303                       end.
     2304                       when chr(7)
     2305                       then do:
     2306                           assign
     2307                               p-out-string = p-out-string + " ":U
     2308                           .
     2309                       end.
     2310                       when chr(8)
     2311                       then do:
     2312                           assign
     2313                               p-out-string = p-out-string + " ":U
     2314                           .
     2315                       end.
     2316                       when chr(9)
     2317                       then do:
     2318                           assign
     2319                               p-out-string = p-out-string + " ":U
     2320                           .
     2321                       end.
     2322                       when chr(29)
     2323                       then do:
     2324                           assign
     2325                               p-out-string = p-out-string + " ":U
     2326                           .
     2327                       end.
     2328                       when chr(10)
     2329                       then do:
     2330                           assign
     2331                               p-out-string = p-out-string + " ":U
     2332                           .
     2333                       end.
     2334                       when chr(13)
     2335                       then do:
     2336                           assign
     2337                               p-out-string = p-out-string + " ":U
     2338                           .
     2339                       end.
     2340                       otherwise do:
     2341                           assign
     2342                               p-out-string = p-out-string + v-current-char
     2343                           .
     2344                       end.
     2345                   end case.
     2346               end.
     2347           end.
     2348       end case.
     2349   end.
     2350   end .
     2351   procedure xmlchar-decode :
     2352   define input parameter p-in-string      as character        no-undo.
     2353   define output parameter p-out-string    as character        no-undo.
     2354       define variable v-position      as integer      no-undo.
     2355       define variable v-last-position as integer      no-undo.
     2356       define variable v-temp-integer  as integer      no-undo.
     2357       define variable v-current-char  as character    no-undo.
     2358       define variable v-next-char     as character    no-undo.
     2359       define variable v-success       as logical      no-undo.
     2360   do
     2361   on error undo, return error
     2362   :
     2363       assign
     2364           p-out-string = "":U
     2365           v-position   = 0
     2366       .
     2367       replace-cycle:
     2368       do while yes
     2369       on error undo, return error
     2370       :
     2371           assign
     2372               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     2373           .
     2374           if v-last-position <= v-position
     2375           then do:
     2376               if v-position = 0
     2377               then do:
     2378                   assign
     2379                       p-out-string = p-in-string
     2380                   .
     2381               end.
     2382               else do:
     2383                   assign
     2384                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     2385                   .
     2386               end.
     2387               leave replace-cycle.
     2388           end.
     2389           else do:
     2390               assign
     2391                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     2392                   v-position      = v-last-position
     2393                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     2394               .
     2395               if v-current-char = "#":U
     2396               then do:
     2397                   assign
     2398                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     2399                   .
     2400                   if v-last-position > 0
     2401                   then do:
     2402                       run xmlchar-read-integer in this-procedure
     2403                        (
     2404                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     2405                           , output v-temp-integer
     2406                           , output v-success
     2407                       ).
     2408                       if v-success = yes
     2409                       and v-temp-integer >= 1
     2410                       and v-temp-integer <= 255
     2411                       then do:
     2412                           assign
     2413                               p-out-string = p-out-string + chr( v-temp-integer )
     2414                               v-position   = v-last-position + 1
     2415                           .
     2416                       end.
     2417                       else do:
     2418                           assign
     2419                               p-out-string = p-out-string + "&":U
     2420                               v-position   = v-position   + 1
     2421                           .
     2422                       end.
     2423                   end.
     2424                   else do:
     2425                       assign
     2426                           p-out-string = p-out-string + "&":U
     2427                           v-position   = v-position   + 1
     2428                       .
     2429                   end.
     2430               end.
     2431               else do:
     2432                   case substring( p-in-string, v-position + 1, 3 )
     2433                   :
     2434                       when "lt;":U
     2435                       then do:
     2436                           assign
     2437                               p-out-string = p-out-string + "<":U
     2438                               v-position   = v-position   + 3
     2439                           .
     2440                       end.
     2441                       when "gt;":U
     2442                       then do:
     2443                           assign
     2444                               p-out-string = p-out-string + ">":U
     2445                               v-position   = v-position   + 3
     2446                           .
     2447                       end.
     2448                       otherwise do:
     2449                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     2450                           then do:
     2451                               assign
     2452                                   p-out-string = p-out-string + "&":U
     2453                                   v-position   = v-position   + 4
     2454                               .
     2455                           end.
     2456                           else do:
     2457                               case substring( p-in-string, v-position + 1, 5 )
     2458                               :
     2459                                   when "quot;":U
     2460                                   then do:
     2461                                       assign
     2462                                           p-out-string = p-out-string + '"':U
     2463                                           v-position   = v-position   + 5
     2464                                       .
     2465                                   end.
     2466                                   when "apos;":U
     2467                                   then do:
     2468                                       assign
     2469                                           p-out-string = p-out-string + "'":U
     2470                                           v-position   = v-position   + 5
     2471                                       .
     2472                                   end.
     2473                                   otherwise do:
     2474                                       assign
     2475                                           p-out-string = p-out-string + "&":U
     2476                                       .
     2477                                   end.
     2478                               end case.
     2479                           end.
     2480                       end.
     2481                   end case.
     2482               end.
     2483           end.
     2484       end.
     2485   end.
     2486   end .
     2487   procedure xmlchar-read-integer :
     2488   define input parameter p-input-string      as character        no-undo.
     2489   define output parameter p-output-integer   as integer          no-undo.
     2490   define output parameter p-success       as logical          no-undo.
     2491   do
     2492   on error undo, return error
     2493   :
     2494       assign
     2495           p-output-integer = integer( p-input-string )
     2496       no-error.
     2497       if error-status :error
     2498       then do:
     2499           assign
     2500               p-success           = no
     2501               p-output-integer    = 0
     2502           .
     2503       end.
     2504       else do:
     2505           assign
     2506               p-success           = yes
     2507           .
     2508       end.
     2509   end.
     2510   end.
     2511   define variable v-bgelib-bgeclall           as logical      no-undo.
     2512   define variable v-bgelib-bgedict            as logical      no-undo.
     2513   define temp-table temp_ext-doc-type no-undo
     2514       field edt-key               as integer
     2515       field ext-doc-type          as character
     2516       field ext-doc-type-label    as character
     2517       index pi is primary unique
     2518           edt-key
     2519   .
     2520   define temp-table temp_bgelib_goods no-undo
     2521       field gds-code as integer
     2522       index pi is primary unique
     2523           gds-code
     2524   .
     2525   define temp-table temp_bgelib_clients no-undo
     2526       field obj-type as character
     2527       field obj-code as integer
     2528       index pi is primary unique
     2529           obj-type
     2530           obj-code
     2531   .
     2532   define temp-table temp_bgelib_dis-card no-undo
     2533       field d-card as character
     2534       index pi is primary unique
     2535           d-card
     2536   .
     2537   define temp-table temp_bgelib_trn-doc no-undo
     2538       field doc-code as integer
     2539   .
     2540   procedure bgelib-tag-open:
     2541   do
     2542   on error undo, return error
     2543   :
     2544   define input parameter v-tag-level  as integer      no-undo.
     2545   define input parameter v-tag-name   as character    no-undo.
     2546   define input parameter v-tag-value  as character    no-undo.
     2547       put stream stmXMLOut unformatted
     2548           chr(10)
     2549           + fill(" ", 4 * v-tag-level)
     2550           + "<" + v-tag-name
     2551           + ( if v-tag-value = "" or v-tag-value = ? then "" else " " )
     2552           + v-tag-value + ">"
     2553       .
     2554   end.
     2555   end procedure.
     2556   procedure bgelib-tag-put:
     2557   do
     2558   on error undo, return error
     2559   :
     2560   define input parameter v-tag-level      as integer      no-undo.
     2561   define input parameter v-tag-name       as character    no-undo.
     2562   define input parameter v-tag-value      as character    no-undo.
     2563   define input parameter v-empty-mode     as integer      no-undo.
     2564       v-tag-name = trim(v-tag-name).
     2565       if  v-empty-mode = 1
     2566       or (v-empty-mode = 0 and (v-tag-value <> "" and v-tag-value <> ?) )
     2567       or (v-empty-mode = 2 and (v-tag-value <> "" and v-tag-value <> ? and v-tag-value <> "0"))
     2568       or (v-empty-mode = 3 and (v-tag-value <> "" and v-tag-value <> ? and caps(v-tag-value) <> "no"))
     2569       then do:
     2570           run xmlchar-encode in this-procedure (
     2571                 input v-tag-value
     2572               , output v-tag-value
     2573           ).
     2574           put stream stmXMLOut unformatted
     2575               chr(10) + fill(" ", 4 * v-tag-level)
     2576                           + '<' + v-tag-name + '>'
     2577                           + v-tag-value
     2578                           + '</' + v-tag-name + '>'
     2579           .
     2580       end.
     2581   end.
     2582   end procedure.
     2583   procedure bgelib-tag-close:
     2584   do
     2585   on error undo, return error
     2586   :
     2587   define input parameter v-tag-level as integer      no-undo.
     2588   define input parameter v-tag-name  as character    no-undo.
     2589       put stream stmXMLOut unformatted
     2590           chr(10)
     2591           + fill( " ", 4 * v-tag-level)
     2592           + '</' + v-tag-name + '>'
     2593       .
     2594   end.
     2595   end procedure.
     2596   procedure bgelib-write-log:
     2597   do
     2598   on error undo, return error
     2599   :
     2600   define input parameter v-filename   as character    no-undo.
     2601   define input parameter v-log-level  as integer      no-undo.
     2602   define input parameter v-out-string as character    no-undo.
     2603       output stream stmXMLLog to value( v-filename ) append.
     2604       put stream stmXMLLog unformatted
     2605           chr(10)
     2606       .
     2607       put stream stmXMLLog unformatted
     2608           ( if v-log-level = 0
     2609             or v-out-string = "&DLine"
     2610             or v-out-string = "&Line"
     2611             then ""
     2612             else cur-time-string-sec() + " " )
     2613       .
     2614       put stream stmXMLLog unformatted
     2615           ( if v-out-string = "&Line"
     2616             then fill( "-", 80 )
     2617             else if v-out-string = "&DLine"
     2618                  then fill( "=", 80 )
     2619                  else v-out-string )
     2620       .
     2621       output stream stmXMLLog close.
     2622   end.
     2623   end procedure.
     2624   procedure bgelib-write-edt:
     2625   do
     2626   on error undo, return error
     2627   :
     2628   define input parameter v-editor-handle    as handle       no-undo.
     2629   define input parameter v-log-level        as integer      no-undo.
     2630   define input parameter v-out-string       as character    no-undo.
     2631       if valid-handle ( v-editor-handle )
     2632       then do:
     2633           v-editor-handle :move-to-eof().
     2634           v-editor-handle :insert-string( ( if v-log-level = 0
     2635                                             or v-out-string = "&DLine"
     2636                                             or v-out-string = "&Line"
     2637                                             then ""
     2638                                             else cur-time-string-sec() + " "
     2639                                         ) ).
     2640           v-editor-handle :insert-string( ( if v-out-string = "&Line"
     2641                                             then fill( "-", 80 )
     2642                                             else if v-out-string = "&DLine" then fill("=", 80)
     2643                                             else fill( " ", v-log-level) + v-out-string
     2644                                         ) ).
     2645           v-editor-handle :insert-string( chr(10) ).
     2646       end.
     2647       process events.
     2648       output to 'bgescn.txt' append.
     2649           put unformatted
     2650               chr(10)
     2651               string( ( if v-log-level = 0
     2652                         or v-out-string = "&DLine"
     2653                         or v-out-string = "&Line"
     2654                         then ""
     2655                         else string( today ) + " " + string( time, "hh:mm:ss" ) + " "
     2656                     ) )
     2657               string( ( if v-out-string = "&Line"
     2658                         then fill( "-", 80 )
     2659                         else if v-out-string = "&DLine"
     2660                              then fill( "=", 80 )
     2661                              else fill( " ", v-log-level ) + v-out-string
     2662                     ) )
     2663           .
     2664       output close.
     2665   end.
     2666   end procedure.
     2667   procedure bgelib-show-cnt:
     2668   do
     2669   on error undo, return error
     2670   :
     2671   define input parameter v-fillin-handle     as handle   no-undo.
     2672       if valid-handle( v-fillin-handle )
     2673       then do:
     2674           assign
     2675               v-fillin-handle :visible = true
     2676           .
     2677       end.
     2678   end.
     2679   end procedure.
     2680   procedure bgelib-hide-cnt:
     2681   do
     2682   on error undo, return error
     2683   :
     2684   define input parameter v-fillin-handle     as handle   no-undo.
     2685       if valid-handle( v-fillin-handle )
     2686       then do:
     2687           assign v-fillin-handle :visible = false.
     2688       end.
     2689   end.
     2690   end procedure.
     2691   procedure bgelib-write-cnt:
     2692   do
     2693   on error undo, return error
     2694   :
     2695   define input parameter v-fillin-handle    as handle       no-undo.
     2696   define input parameter v-fillin-string    as character    no-undo.
     2697       if valid-handle( v-fillin-handle )
     2698       then do:
     2699           assign
     2700               v-fillin-handle :SCREEN-value = v-fillin-string
     2701           .
     2702       end.
     2703   end.
     2704   end procedure.
     2705   procedure bgelib-write-header:
     2706   do
     2707   on error undo, return error
     2708   :
     2709   define input parameter p-first-file     as logical      no-undo.
     2710   define input parameter p-xml-file-name  as character    no-undo.
     2711   define input parameter p-list-file-name as character    no-undo.
     2712   define input parameter p-file-number    as integer      no-undo.
     2713   define input parameter p-have-prev      as logical      no-undo.
     2714   define input parameter p-prev-filename  as character    no-undo.
     2715   define input parameter p-obj-list       as character    no-undo.
     2716   define input parameter p-doc-type-list  as character    no-undo.
     2717   define input parameter p-parameter-list as character    no-undo.
     2718       define variable v-counter    as integer        no-undo.
     2719       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2720       put stream stmXMLOut unformatted
     2721           "<?xml version='1.0' encoding='windows-1251'?>"
     2722       .
     2723       run bgelib-tag-open( input 0, input "root"  , input "" ).
     2724       run bgelib-tag-open( input 0, input "header", input "" ).
     2725       run bgelib-tag-put( input 1, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2726       run bgelib-tag-put( input 1, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     2727       run bgelib-tag-put( input 1, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     2728       run bgelib-tag-put( input 1, input "prevFileName"   , input p-prev-filename            , input 0 ).
     2729       run bgelib-tag-put( input 1, input "objList"        , input p-obj-list                 , input 0 ).
     2730       run bgelib-tag-put( input 1, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     2731       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2732       :
     2733           run bgelib-tag-put(
     2734                 input 1
     2735               , input entry( 2 * v-counter, p-parameter-list )
     2736               , input entry( 2 * v-counter + 1, p-parameter-list )
     2737               , input 0
     2738           ).
     2739       end.
     2740       run bgelib-tag-close( input 0, input "header" ).
     2741       output stream stmXMLOut close.
     2742       output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2743       if p-first-file = yes
     2744       then do:
     2745           put stream stmXMLOut unformatted
     2746               "<?xml version='1.0' encoding='windows-1251'?>"
     2747           .
     2748           run bgelib-tag-open( input 0, input "export", input "" ).
     2749       end.
     2750       run bgelib-tag-open( input 1, input "file", input "" ).
     2751       run bgelib-tag-put( input 2, input "fileName"       , input p-xml-file-name + "xml":U  , input 0 ).
     2752       run bgelib-tag-put( input 2, input "fileNumber"     , input string( p-file-number     ), input 0 ).
     2753       run bgelib-tag-put( input 2, input "havePrev"       , input string( p-have-prev       ), input 3 ).
     2754       run bgelib-tag-put( input 2, input "prevFileName"   , input p-prev-filename            , input 0 ).
     2755       run bgelib-tag-put( input 2, input "objList"        , input p-obj-list                 , input 0 ).
     2756       run bgelib-tag-put( input 2, input "docTypeList"    , input p-doc-type-list            , input 0 ).
     2757       do v-counter = 1 to integer( entry( 1, p-parameter-list ) )
     2758       :
     2759           run bgelib-tag-put(
     2760                 input 2
     2761               , input trim(entry( 2 * v-counter, p-parameter-list ))
     2762               , input trim(entry( 2 * v-counter + 1, p-parameter-list ))
     2763               , input 0
     2764           ).
     2765       end.
     2766       run bgelib-tag-close( input 1, input "file" ).
     2767       output stream stmXMLOut close.
     2768   end.
     2769   end procedure.
     2770   procedure bgelib-write-footer:
     2771   do
     2772   on error undo, return error
     2773   :
     2774   define input parameter p-last-file      as logical      no-undo.
     2775   define input parameter p-xml-file-name  as character    no-undo.
     2776   define input parameter p-list-file-name as character    no-undo.
     2777   define input parameter p-have-next      as logical      no-undo.
     2778   define input parameter p-next-file-name as character    no-undo.
     2779       define variable v-error-num     as integer           no-undo.
     2780       output stream stmXMLOut to value( p-xml-file-name + "tmp" ) convert target "1251" append.
     2781       if p-have-next = yes
     2782       then do:
     2783           run bgelib-tag-open( input 0, input "footer", "" ).
     2784           run bgelib-tag-put( input 1, input "haveNext"       , string( p-have-next ) , 3 ).
     2785           run bgelib-tag-put( input 1, input "nextFileName"   , p-next-file-name      , 0 ).
     2786           run bgelib-tag-close( input 0, input "footer" ).
     2787       end.
     2788       run bgelib-tag-close( input 0, input "root" ).
     2789       output stream stmXMLOut close.
     2790       run bge/os_copy.p (
     2791             input "M"
     2792           , input p-xml-file-name + "tmp"
     2793           , input p-xml-file-name + "xml"
     2794           , output v-error-num
     2795       ).
     2796       if p-last-file = yes
     2797       then do:
     2798           output stream stmXMLOut to value( p-list-file-name + "tmp" ) convert target "1251" append.
     2799               run bgelib-tag-close( input 0, input "export" ).
     2800           output stream stmXMLOut close.
     2801           run bge/os_copy.p (
     2802                 input "M"
     2803               , input p-list-file-name + "tmp"
     2804               , input p-list-file-name + "xml"
     2805               , output v-error-num
     2806           ).
     2807       end.
     2808   end.
     2809   end procedure.
     2810   procedure bgelib-filename :
     2811   do
     2812   on error undo, return error
     2813   :
     2814   define input parameter p-prefix             as character    no-undo.
     2815   define output parameter p-xml-file-name     as character    no-undo.
     2816   define output parameter p-log-file-name     as character    no-undo.
     2817   define output parameter p-list-file-name    as character    no-undo.
     2818       define variable v-home-dir  as character    no-undo.
     2819       define variable v-error-num as integer      no-undo.
     2820       get-key-value section "BGE" key "outdir" value v-home-dir.
     2821       if v-home-dir = ?
     2822       then do:
     2823           message
     2824             skip "Не найден параметр ini-файла, определяющий каталог экспорта."
     2825             skip(1)
     2826             skip "Обратитесь к администратору."
     2827           view-as alert-box error.
     2828           undo, return error .
     2829       end.
     2830       run gbl/dir-cre.p (
     2831           input v-home-dir
     2832       ) no-error.
     2833       if error-status :error
     2834       then do:
     2835           message
     2836             skip "Неверно задан каталог экспорта."
     2837             skip(1)
     2838             skip "Обратитесь к администратору."
     2839           view-as alert-box error.
     2840           undo, return error .
     2841       end.
     2842       run bge/genfname.p (
     2843             input v-home-dir
     2844           , input p-prefix
     2845           , input ""
     2846           , input "xml"
     2847           , input "tmp"
     2848           , output p-xml-file-name
     2849       ).
     2850       assign
     2851           p-xml-file-name     = substring( p-xml-file-name, 1, length( p-xml-file-name ) - 3 )
     2852           p-log-file-name     = v-home-dir + chr(92) + "actions.log"
     2853           p-list-file-name    = v-home-dir + chr(92) + "lst":U + substring( p-xml-file-name, length( p-xml-file-name ) - 5, 5 ) + ".":U
     2854       .
     2855   end.
     2856   end procedure.
     2857   procedure bgelib-read-config :
     2858   do
     2859   on error undo, return error
     2860   :
     2861   define variable v-par-type as character     no-undo.
     2862     define variable v-param-type      as character  no-undo .
     2863     define variable v-value-character as character  no-undo .
     2864     define variable v-value-date      as date       no-undo .
     2865     define variable v-value-decimal   as decimal    no-undo .
     2866     define variable v-value-integer   as integer    no-undo .
     2867     define variable v-value-logical   as logical    no-undo .
     2868     define variable v-tth             as handle     no-undo .
     2869       assign
     2870           v-bgelib-bgeclall = no
     2871           v-bgelib-bgedict  = no
     2872       .
     2873       run adm/shattri.p ( input "get":U
     2874                         , input  '':u
     2875                         , input  0
     2876                         , input  'bge-export':U
     2877                         , input  'bgeclall':U
     2878                         , output v-value-character
     2879                         , output v-value-date
     2880                         , output v-value-decimal
     2881                         , output v-value-integer
     2882                         , output v-value-logical
     2883                         , output v-param-type
     2884                         , input-output table-handle v-tth
     2885                         ) no-error .
     2886       if error-status :error
     2887       then do:
     2888         assign
     2889           v-bgelib-bgeclall = no
     2890         .
     2891       end.
     2892       else do:
     2893         assign
     2894           v-bgelib-bgeclall = v-value-logical
     2895         .
     2896       end.
     2897       delete object v-tth.
     2898       run adm/shattri.p ( input "get":U
     2899                         , input  '':u
     2900                         , input  0
     2901                         , input  'bge-export':U
     2902                         , input  'bgedict':U
     2903                         , output v-value-character
     2904                         , output v-value-date
     2905                         , output v-value-decimal
     2906                         , output v-value-integer
     2907                         , output v-value-logical
     2908                         , output v-param-type
     2909                         , input-output table-handle v-tth
     2910                         ) no-error .
     2911       if error-status :error
     2912       then do:
     2913         assign
     2914           v-bgelib-bgedict = no
     2915         .
     2916       end.
     2917       else do:
     2918         assign
     2919           v-bgelib-bgedict = v-value-logical
     2920         .
     2921       end.
     2922       delete object v-tth.
     2923       run adm/shattri.p ( input "get":U
     2924                         , input  '':u
     2925                         , input  0
     2926                         , input  'bge-export':U
     2927                         , input  'bgefmt':U
     2928                         , output v-value-character
     2929                         , output v-value-date
     2930                         , output v-value-decimal
     2931                         , output v-value-integer
     2932                         , output v-value-logical
     2933                         , output v-param-type
     2934                         , input-output table-handle v-tth
     2935                         ) no-error .
     2936       if error-status :error
     2937       then do:
     2938         assign
     2939           v-bgelib-bgefmt  = "xml":U
     2940         .
     2941       end.
     2942       else do:
     2943         assign
     2944           v-bgelib-bgefmt  = v-value-character
     2945         .
     2946       end.
     2947       delete object v-tth.
     2948       run adm/shattri.p ( input "get":U
     2949                         , input  '':u
     2950                         , input  0
     2951                         , input  'bge-export':U
     2952                         , input  'bgeflold':U
     2953                         , output v-value-character
     2954                         , output v-value-date
     2955                         , output v-value-decimal
     2956                         , output v-value-integer
     2957                         , output v-value-logical
     2958                         , output v-param-type
     2959                         , input-output table-handle v-tth
     2960                         ) no-error .
     2961       if error-status :error
     2962       then do:
     2963         assign
     2964           v-bgelib-bgeflold  = "old":U
     2965         .
     2966       end.
     2967       else do:
     2968         assign
     2969           v-bgelib-bgeflold  = v-value-character
     2970         .
     2971       end.
     2972       delete object v-tth.
     2973   end.
     2974   end procedure.
     2975   procedure bgelib-check-file-size :
     2976   do
     2977   on error undo, return error
     2978   :
     2979   define input parameter p-out-filename   as character    no-undo.
     2980   define output parameter p-is-big        as logical      no-undo.
     2981       define variable v-current-position    as integer        no-undo.
     2982       assign
     2983           v-current-position = seek( stmXMLOut )
     2984       .
     2985       if v-current-position / 1024 / 1024  >= 100
     2986       then do:
     2987           assign
     2988               p-is-big = yes
     2989           .
     2990       end.
     2991   end.
     2992   end procedure.
     2993   procedure bgelib-init-ext-doc-type :
     2994       define variable v-counter    as integer      no-undo.
     2995       define buffer buf_temp_ext-doc-type     for temp_ext-doc-type.
     2996   do
     2997   for buf_temp_ext-doc-type
     2998   on error undo, return error
     2999   :
     3000       empty temp-table buf_temp_ext-doc-type.
     3001       do v-counter = 1 to num-entries( 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     3002       :
     3003           create buf_temp_ext-doc-type.
     3004           assign
     3005               buf_temp_ext-doc-type.edt-key               = v-counter
     3006               buf_temp_ext-doc-type.ext-doc-type          = entry( v-counter, 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U )
     3007               buf_temp_ext-doc-type.ext-doc-type-label    = entry( v-counter, 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U )
     3008           .
     3009       end.
     3010   end.
     3011   end procedure.
     3012   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3013   define variable v-xml-file-name     as character            no-undo.
     3014   define variable v-xml-file-name-path as character            no-undo.
     3015   define variable v-log-file-name     as character            no-undo.
     3016   define variable v-locked            as logical              no-undo.
     3017   define variable v-log-string        as character            no-undo.
     3018   define variable v-oper-num          as integer              no-undo.
     3019   define variable v-obj-list          as character            no-undo.
     3020   DEF VAR strDummy    AS CHAR view-as editor size 50 by 4 NO-UNDO.
     3021   DEF VAR intRep      AS INT NO-UNDO.
