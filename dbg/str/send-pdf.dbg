    14245                              ,for-cash-desk.cash-num
    14246                              ,chr(10)
    14247                              ,return-value
    14248                           )
    14249                                           ).
    14250     assign
    14251     v-view-log = yes
    14252     .
    14253       for each temp-cd-plu:
    14254         delete temp-cd-plu.
    14255       end.
    14256     return "error":U.
    14257   end.
    14258   else do:
    14259     for each temp-cd-plu,
    14260         first buf_cd-plu where
    14261                     buf_cd-plu.obj-type = temp-cd-plu.obj-type
    14262                 and buf_cd-plu.obj-code = temp-cd-plu.obj-code
    14263                 and buf_cd-plu.pos-type = temp-cd-plu.pos-type
    14264                 and buf_cd-plu.plu-type = temp-cd-plu.plu-type
    14265                 and buf_cd-plu.plu-code = temp-cd-plu.plu-code:
    14266       if temp-cd-plu.to-del = yes
    14267       and v-del-mrkt-gds
    14268       then do:
    14269         if lookup(string(for-cash-desk.cash-num), buf_cd-plu.charkey_one) > 0 then do:
    14270           entry(lookup(string(for-cash-desk.cash-num), buf_cd-plu.charkey_one)  ,  buf_cd-plu.charkey_one) = '':U.
    14271           assign
    14272           buf_cd-plu.charkey_one = replace(buf_cd-plu.charkey_one, chr(44) + chr(44), chr(44))
    14273           buf_cd-plu.to-del = (buf_cd-plu.charkey_one <> '':U)
    14274           .
    14275         end.
    14276         if buf_cd-plu.charkey_one = '':U then do:
    14277           delete buf_cd-plu.
    14278           NEXT.
    14279         end.
    14280       end.
    14281       if temp-cd-plu.charkey_two = "":U
    14282       then
    14283       assign
    14284       buf_cd-plu.charkey_two = "":U
    14285       buf_cd-plu.to-send = no
    14286       .
    14287       delete temp-cd-plu.
    14288     end.
    14289   end.
    14290   end.
