     3258   procedure alienini-getkey :
     3259   define input parameter i-filename as char.
     3260   define input parameter i-section as char.
     3261   define input parameter i-key as char.
     3262   define output parameter o-value as char.
     3263   define variable EntryPointer as integer no-undo.
     3264   define variable mem1 as memptr no-undo.
     3265   define variable mem2 as memptr no-undo.
     3266   define variable mem1size as integer no-undo.
     3267   define variable mem2size as integer no-undo.
     3268   define variable ii       as integer    no-undo.
     3269   define variable cbReturnSize  as integer    no-undo.
     3270   assign
     3271   set-size(mem1)  = 4000
     3272   mem1size = 4000.
     3273   if i-key = "" then EntryPointer = 0.
     3274   else do:
     3275     assign
     3276     set-size(mem2) = 128
     3277     mem2size = 128
     3278     EntryPointer = get-pointer-value(mem2)
     3279     put-string(mem2, 1) = i-key.
     3280   end.
     3281   run getprivateprofilestringA
     3282                                 (i-section,
     3283                                  EntryPointer,
     3284                                  "",
     3285                                  get-pointer-value(mem1),
     3286                                  input mem1size,
     3287                                  i-filename,
     3288                                  output cbReturnSize).
     3289   do ii = 1 to cbReturnSize:
     3290     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
     3291                  then o-value + ","
     3292                  else o-value + chr(get-byte(mem1, ii)).
     3293   end.
     3294     set-size(mem1) = 0.
     3295     set-size(mem2) = 0.
     3296   end procedure.
     3297   procedure alienini-putkey :
     3298   define input parameter i-filename as char.
     3299   define input parameter i-section as char.
     3300   define input parameter i-key as char.
     3301   define input parameter i-value as char.
     3302   define variable cbReturnSize as integer.
     3303   run writeprivateprofilestringA
     3304                                  (i-section,
     3305                                   i-key,
     3306                                   i-value,
     3307                                   i-filename,
     3308                                   output cbReturnSize ).
     3309   end procedure.
     3310   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
     3311     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
     3312     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
     3313     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
     3314     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
     3315     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
     3316     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
     3317     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
     3318   END PROCEDURE.
     3319   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
     3320     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
     3321     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
     3322     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
     3323     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
     3324     DEFINE RETURN PARAMETER lpszValue    AS LONG.
     3325   END PROCEDURE.
     3326   define   temp-table temp-tekka-tsk no-undo
     3327   field filename      as character
     3328   field obj-num       as integer
     3329   field obj-name      as character
     3330   field num-records   as integer
     3331   field max-records   as integer
     3332   field min-plu       as integer
     3333   field max-plu       as integer
     3334   field num-fields    as integer
     3335   field task-num      as character
     3336   field by-record     as logical
     3337   field send-get      as character
     3338   field cash-num      as integer
     3339   field cash-num-char as character
     3340   field port-num      as character
     3341   field way           as character
     3342   field is-script     as logical
     3343   field pswd          as character
     3344   field waiting-sek   as integer
     3345   field other-info    as character
     3346   field order-num     as integer
     3347   field secondary     as integer
     3348   field shift-fields  as integer
     3349   field binary        as logical
     3350   field range         as integer
     3351   index pi is unique primary
     3352   filename
     3353   range
     3354   index lpi
     3355   filename
     3356   min-plu
     3357   index gpi
     3358   filename
     3359   max-plu
     3360   index iorder
     3361   order-num
     3362   .
     3363   define   temp-table temp-tekka-schema no-undo
     3364   field obj-num as integer
     3365   field obj-name as character
     3366   field field-num as integer
     3367   field field-name as character
     3368   field num-records as integer
     3369   field size_ as integer
     3370   field host as character
     3371   field progress-type as character
     3372   field custom-type as character
     3373   field start-pos as integer
     3374   field end-pos as integer
     3375   field bin-group as character
     3376   index pi is unique primary
     3377   host obj-num field-num
     3378   .
     3379   define temp-table temp-tekka-record no-undo
     3380   field obj-num as integer
     3381   field plu as integer
     3382   field body as character
     3383   field shift as integer
     3384   index pi is unique primary obj-num plu.
     3385   FUNCTION tekka-is-closed-shift-journal returns integer ( input p-journal-num as integer ):
     3386   define variable v-is-closed-shift-journal as integer no-undo .
     3387   assign
     3388   v-is-closed-shift-journal = (if lookup( string( p-journal-num), '30,31,32,33':U) > 0 then 1 else 0)
     3389                               +
     3390                               (if lookup( string( p-journal-num),  '43':U) > 0 then 1 else 0)
     3391                               +
     3392                               (if lookup( string( p-journal-num),  '17':U) > 0 then 1 else 0)
     3393   .
     3394   return v-is-closed-shift-journal.
     3395   END FUNCTION.
     3396   FUNCTION tekka-is-first-journal returns logical ( input p-journal-num as integer ) :
     3397   define variable v-is-first-journal as logical no-undo .
     3398   assign
     3399   v-is-first-journal = (p-journal-num =  integer(entry(1, '30,31,32,33':U)))
     3400                     or (p-journal-num = integer(entry(1, '26,27,28,29':U)))
     3401                     or (p-journal-num =  integer(entry(1, '17':U)))
     3402                     or (p-journal-num = integer(entry(1, '16':U)))
     3403   .
     3404   return v-is-first-journal.
     3405   END FUNCTION.
     3406   FUNCTION tekka-is-petrol-journal returns logical ( input p-journal-num as integer ) :
     3407   define variable v-is-petrol-journal as logical no-undo .
     3408   assign
     3409   v-is-petrol-journal = lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0.
     3410   return v-is-petrol-journal.
     3411   END FUNCTION.
     3412   FUNCTION tekka-get-max-journal-record-num returns integer ( input p-journal-num as integer ) :
     3413   define variable v-max-record-num as integer no-undo .
     3414   assign
     3415   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     3416                       then 1489
     3417                       else 2340).
     3418   return v-max-record-num.
     3419   END FUNCTION.
     3420   FUNCTION tekka-get-max-record-num returns integer ( input p-journal-num as integer ) :
     3421   define variable v-max-record-num as integer no-undo .
     3422   assign
     3423   v-max-record-num = (if lookup(string(p-journal-num), '26,27,28,29,30,31,32,33':U) > 0
     3424                       then 1489 * num-entries('30,31,32,33':U)
     3425                       else 2340 * num-entries('17':U)).
     3426   return v-max-record-num.
     3427   END FUNCTION.
     3428   FUNCTION tekka-num-recs returns integer( input p-journal-num as integer
     3429                                           ,input p-rec-no as integer):
     3430   define variable v-num-recs as integer no-undo .
     3431   if tekka-is-petrol-journal (p-journal-num) then do:
     3432     if tekka-is-closed-shift-journal(p-journal-num) = 1 then do:
     3433       assign
     3434       v-num-recs = (p-journal-num - integer(entry(1, '30,31,32,33':U))) * 1489 + p-rec-no
     3435       .
     3436     end.
     3437     else do:
     3438       assign
     3439       v-num-recs = (p-journal-num - integer(entry(1, '26,27,28,29':U)) ) * 1489 + p-rec-no
     3440       .
     3441     end.
     3442   end.
     3443   else do:
     3444     if lookup(string(p-journal-num), '16,17':U) > 0 then do:
     3445       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     3446         assign
     3447         v-num-recs = (p-journal-num - integer(entry(1, '17':U))) * 2340 + p-rec-no
     3448         .
     3449       end.
     3450       else do:
     3451         assign
     3452         v-num-recs = (p-journal-num - integer(entry(1, '16':U)) ) * 2340 + p-rec-no
     3453         .
     3454       end.
     3455     end.
     3456     else do:
     3457       if tekka-is-closed-shift-journal(p-journal-num) > 0 then do:
     3458         assign
     3459         v-num-recs = (p-journal-num - integer(entry(1, '43':U))) * 2978 + p-rec-no
     3460         .
     3461       end.
     3462       else do:
     3463         assign
     3464         v-num-recs = (p-journal-num - integer(entry(1, '42':U)) ) * 2978 + p-rec-no
     3465         .
     3466       end.
     3467     end.
     3468   end.
     3469   return v-num-recs.
     3470   END FUNCTION.
     3471   FUNCTION tekka-get-obj-num returns integer( input p-num-recs as decimal
     3472                                              ,input p-is-petrol as logical
     3473                                              ,input p-is-current as logical
     3474                                              ,output p-rec-no as decimal
     3475                                              ):
     3476   define variable v-obj-num0 as integer no-undo .
     3477   define variable v-obj-num as integer no-undo .
     3478   define variable v-obj-num2 as integer no-undo .
     3479   define variable p-num-recs2 as integer no-undo .
     3480   define variable p-rec-no2 as integer no-undo .
     3481   if p-is-petrol then do:
     3482     assign
     3483     v-obj-num0 = trunc(p-num-recs / 1489, 0)
     3484     .
     3485     if p-is-current and num-entries('26,27,28,29':U) >= v-obj-num0 + 1
     3486     then
     3487     assign
     3488     v-obj-num = integer(entry(v-obj-num0 + 1, '26,27,28,29':U))
     3489     p-rec-no = p-num-recs modulo 1489
     3490     .
     3491     if not p-is-current and num-entries('30,31,32,33':U) >= v-obj-num0 + 1
     3492     then
     3493     assign
     3494     v-obj-num = integer(entry(v-obj-num0 + 1, '30,31,32,33':U))
     3495     p-rec-no = p-num-recs modulo 1489
     3496     .
     3497   end.
     3498   else do:
     3499     assign
     3500     p-num-recs2 = (p-num-recs - trunc(p-num-recs, 0)) * 10000
     3501     p-num-recs = trunc(p-num-recs, 0)
     3502     v-obj-num0 = trunc(p-num-recs / 2340, 0)
     3503     v-obj-num2 = trunc(p-num-recs2 / 2978, 0)
     3504     .
     3505     if p-is-current and num-entries('16':U) >= v-obj-num0 + 1
     3506     then
     3507     assign
     3508     v-obj-num = integer(entry(v-obj-num0 + 1, '16':U))
     3509     p-rec-no = p-num-recs modulo 2340
     3510     .
     3511     if not p-is-current and num-entries('17':U) >= v-obj-num0 + 1
     3512     then
     3513     assign
     3514     v-obj-num = integer(entry(v-obj-num0 + 1, '17':U))
     3515     p-rec-no = p-num-recs modulo 2340
     3516     .
     3517     if p-is-current and num-entries('42':U) >= v-obj-num2 + 1
     3518     then
     3519     assign
     3520     v-obj-num2 = integer(entry(v-obj-num2 + 1, '42':U))
     3521     p-rec-no2 = p-num-recs2 modulo 2978
     3522     .
     3523     if not p-is-current and num-entries('43':U) >= v-obj-num2 + 1
     3524     then
     3525     assign
     3526     v-obj-num2 = integer(entry(v-obj-num2 + 1, '43':U))
     3527     p-rec-no2 = p-num-recs2 modulo 2978
     3528     .
     3529     assign
     3530     p-rec-no = p-rec-no + p-rec-no2 / 10000
     3531     .
     3532   end.
     3533   if v-obj-num = 0 then v-obj-num = 100.
     3534   return v-obj-num.
     3535   END FUNCTION.
     3536   FUNCTION tekka-get-next-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical):
     3537   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '17':U)).
     3538   if lookup (string(p-obj-num), '17':U) > 0 then do:
     3539      if p-is-ptrl then
     3540      return integer(entry(1, '26,27,28,29':U)).
     3541      if not p-is-ptrl then
     3542      return integer(entry(1, '16':U)).
     3543   end.
     3544   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     3545   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     3546   return 0.
     3547   END FUNCTION.
     3548   FUNCTION tekka-get-next-current-obj-num returns integer ( input p-obj-num as integer, input p-is-ptrl as logical ):
     3549   if lookup (string(p-obj-num), '30,31,32,33':U) > 0 then return integer(entry(1, '26,27,28,29':U)).
     3550   if lookup (string(p-obj-num), '17':U) > 0 then do:
     3551     if p-is-ptrl then
     3552     return integer(entry(1, '26,27,28,29':U)).
     3553     if not p-is-ptrl then
     3554     return integer(entry(1, '16':U)).
     3555   end.
     3556   if lookup (string(p-obj-num), '26,27,28,29':U) > 0 then return integer(entry(1, '16':U)).
     3557   if lookup (string(p-obj-num), '16':U) > 0 then return 100.
     3558   return 0.
     3559   END FUNCTION.
     3560   PROCEDURE maria-put:
     3561   define parameter buffer buf_cash-desk for ub.cash-desk.
     3562   define input parameter p-out    as character no-undo .
     3563   define input parameter p-fname as character no-undo .
     3564   define input parameter p-by-record as logical no-undo .
     3565   define input parameter p-shift-fields as integer no-undo .
     3566   define input parameter p-binary as logical no-undo .
     3567   define input parameter p-obj-num as integer no-undo .
     3568   define input parameter p-max-records as integer no-undo .
     3569   define input parameter p-plu as integer no-undo .
     3570   define input parameter p-value as character no-undo .
     3571   define variable v-file-name as character no-undo .
     3572   define variable v-create as logical no-undo .
     3573   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3574   v-file-name =  p-out + p-fname + '.' + string(p-obj-num,  '999') .
     3575   output stream IBMSTREAM
     3576   to value(v-file-name) append .
     3577   Put  stream IBMSTREAM unformatted
     3578   p-plu
     3579   chr(3)
     3580   p-value
     3581   skip.
     3582   output stream IBMSTREAM
     3583   close.
     3584   if not p-by-record then do:
     3585     find first buf_temp-tekka-tsk where
     3586               buf_temp-tekka-tsk.filename  = v-file-name no-error .
     3587     if not available buf_temp-tekka-tsk then do:
     3588       v-create = yes.
     3589     end.
     3590   end.
     3591   else do:
     3592     find first buf_temp-tekka-tsk where
     3593               buf_temp-tekka-tsk.filename  = v-file-name
     3594           and buf_temp-tekka-tsk.max-plu = (p-plu - 1) use-index gpi no-error .
     3595     if not available buf_temp-tekka-tsk
     3596     then do:
     3597       find first buf_temp-tekka-tsk where
     3598                 buf_temp-tekka-tsk.filename  = v-file-name
     3599             and buf_temp-tekka-tsk.min-plu = (p-plu + 1) use-index lpi no-error .
     3600       if not available buf_temp-tekka-tsk
     3601       then do:
     3602         v-create = yes.
     3603       end.
     3604     end.
     3605   end.
     3606   if v-create then do:
     3607     create buf_temp-tekka-tsk.
     3608     assign
     3609     buf_temp-tekka-tsk.filename = v-file-name
     3610     buf_temp-tekka-tsk.range    = p-plu
     3611     buf_temp-tekka-tsk.obj-num = p-obj-num
     3612     buf_temp-tekka-tsk.obj-name = '':U
     3613     buf_temp-tekka-tsk.num-records = 0
     3614     buf_temp-tekka-tsk.max-records = p-max-records
     3615     buf_temp-tekka-tsk.num-fields = num-entries(p-value, chr(4) )
     3616     buf_temp-tekka-tsk.task-num = p-fname
     3617     buf_temp-tekka-tsk.by-record = p-by-record
     3618     buf_temp-tekka-tsk.shift-fields = p-shift-fields
     3619     buf_temp-tekka-tsk.binary = p-binary
     3620     buf_temp-tekka-tsk.send-get = 'send'
     3621     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3622     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3623     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3624     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3625                           then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3626                           else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3627                                 then 'local'
     3628                                 else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3629     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3630     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3631     buf_temp-tekka-tsk.waiting-sek = 30
     3632     buf_temp-tekka-tsk.min-plu     = p-plu
     3633     buf_temp-tekka-tsk.max-plu     = p-plu
     3634     .
     3635   end.
     3636   assign
     3637   buf_temp-tekka-tsk.num-records = buf_temp-tekka-tsk.num-records + 1
     3638   buf_temp-tekka-tsk.min-plu     = minimum(buf_temp-tekka-tsk.min-plu, p-plu)
     3639   buf_temp-tekka-tsk.max-plu     = maximum(buf_temp-tekka-tsk.max-plu, p-plu)
     3640   .
     3641   END PROCEDURE.
     3642   PROCEDURE maria-get:
     3643   define parameter buffer buf_cash-desk for ub.cash-desk.
     3644   define input parameter p-out    as character no-undo .
     3645   define input parameter p-fname as character no-undo .
     3646   define input parameter p-by-record as logical no-undo .
     3647   define input parameter p-obj-num as integer no-undo .
     3648   define input parameter p-num-fields as integer no-undo .
     3649   define input parameter p-max-records as integer no-undo .
     3650   define input parameter p-min-plu as integer no-undo .
     3651   define input parameter p-max-plu as integer no-undo .
     3652   define input parameter p-other as character no-undo .
     3653   define input parameter p-order-num as integer no-undo .
     3654   define variable v-file-name as character no-undo .
     3655   define variable v-secondary-obj-num as character no-undo .
     3656   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3657   if p-by-record then do:
     3658     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '.' + string(p-obj-num,  '999') .
     3659   end.
     3660   else do:
     3661     v-file-name =  p-out + p-fname + '-' + string(buf_cash-desk.cash-num) + '_html.' + string(p-obj-num,  '999').
     3662   end.
     3663   find first buf_temp-tekka-tsk where
     3664             buf_temp-tekka-tsk.filename  = v-file-name no-error .
     3665   if not available buf_temp-tekka-tsk then do:
     3666     create buf_temp-tekka-tsk.
     3667     assign
     3668     buf_temp-tekka-tsk.filename = v-file-name
     3669     buf_temp-tekka-tsk.obj-num = p-obj-num
     3670     buf_temp-tekka-tsk.obj-name = '':U
     3671     buf_temp-tekka-tsk.max-records = p-max-records
     3672     buf_temp-tekka-tsk.num-fields = p-num-fields
     3673     buf_temp-tekka-tsk.task-num = p-fname
     3674     buf_temp-tekka-tsk.by-record = p-by-record
     3675     buf_temp-tekka-tsk.send-get = 'get'
     3676     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3677     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3678     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3679     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3680                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3681                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3682                                   then 'local'
     3683                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3684     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3685     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3686     buf_temp-tekka-tsk.waiting-sek = 30
     3687     buf_temp-tekka-tsk.min-plu     = p-min-plu
     3688     buf_temp-tekka-tsk.max-plu     = p-max-plu
     3689     buf_temp-tekka-tsk.num-records = (if p-min-plu <> ?
     3690                                       and p-max-plu <> ?
     3691                                       then p-max-plu - p-min-plu + 1
     3692                                       else 0)
     3693     buf_temp-tekka-tsk.other-info = p-other
     3694     buf_temp-tekka-tsk.order-num = p-order-num
     3695     .
     3696     if index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-') > 0 then do:
     3697       assign
     3698       v-secondary-obj-num =  substring('16-42,17-43,':U, index('16-42,17-43,':U, string(buf_temp-tekka-tsk.obj-num) + '-'))
     3699       v-secondary-obj-num = entry(2, v-secondary-obj-num, '-':U)
     3700       v-secondary-obj-num = entry(1, v-secondary-obj-num)
     3701       no-error
     3702       .
     3703       buf_temp-tekka-tsk.secondary = integer(v-secondary-obj-num).
     3704     end.
     3705   end.
     3706   END PROCEDURE.
     3707   PROCEDURE maria-task:
     3708   define parameter buffer buf_cash-desk for ub.cash-desk.
     3709   define input parameter p-fname as character no-undo .
     3710   define input parameter p-obj-num-list as character no-undo .
     3711   define input parameter p-parameters as character no-undo .
     3712   define buffer buf_temp-tekka-tsk for temp-tekka-tsk.
     3713   find first buf_temp-tekka-tsk where
     3714             buf_temp-tekka-tsk.task-num  = p-fname no-error .
     3715   if not available buf_temp-tekka-tsk then do:
     3716     create buf_temp-tekka-tsk.
     3717     assign
     3718     buf_temp-tekka-tsk.filename = ''
     3719     buf_temp-tekka-tsk.range = 1
     3720     buf_temp-tekka-tsk.obj-num = 0
     3721     buf_temp-tekka-tsk.obj-name = p-obj-num-list
     3722     buf_temp-tekka-tsk.task-num = p-fname
     3723     buf_temp-tekka-tsk.by-record = no
     3724     buf_temp-tekka-tsk.send-get = 'task'
     3725     buf_temp-tekka-tsk.cash-num = BUF_CASH-DESK.cash-num
     3726     buf_temp-tekka-tsk.cash-num-char = entry(3, BUF_CASH-DESK.addr-path, chr(4))
     3727     buf_temp-tekka-tsk.port-num = entry(2, BUF_CASH-DESK.addr-path, chr(4))
     3728     buf_temp-tekka-tsk.way = if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'remote'
     3729                             then entry(2, entry(2, BUF_CASH-DESK.addr-path, chr(4)), '+')
     3730                             else (if entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared'
     3731                                   then 'local'
     3732                                   else entry(1, BUF_CASH-DESK.addr-path, chr(4)))
     3733     buf_temp-tekka-tsk.is-script = (entry(1, BUF_CASH-DESK.addr-path, chr(4)) = 'shared')
     3734     buf_temp-tekka-tsk.pswd = entry(4, BUF_CASH-DESK.addr-path, chr(4))
     3735     buf_temp-tekka-tsk.waiting-sek = 30
     3736     buf_temp-tekka-tsk.other-info = p-parameters
     3737     buf_temp-tekka-tsk.order-num = 0
     3738     .
     3739   end.
     3740   END PROCEDURE.
     3741   procedure tekkatsk-verify-schema :
     3742   define input parameter p-obj-list as character no-undo .
     3743   define input parameter p-dir-path as character no-undo .
     3744   define variable v-obj-num as integer no-undo .
     3745   define variable v-obj-name as character no-undo .
     3746   define variable v-num-records as integer no-undo .
     3747   define variable v-size_ as integer no-undo .
     3748   define variable v-value as character no-undo .
     3749   define variable ii as integer no-undo .
     3750   define variable jj as integer no-undo .
     3751   define variable ii-ibs as integer no-undo .
     3752   define variable ii-tekka as integer no-undo .
     3753   define variable v-result as character no-undo .
     3754   define buffer buf_temp-tekka-schema for temp-tekka-schema.
     3755   define buffer buf2_temp-tekka-schema for temp-tekka-schema.
     3756     do
     3757     on error undo, return error
     3758     :
     3759        for each buf_temp-tekka-schema:
     3760          delete buf_temp-tekka-schema.
     3761        end.
     3762        input from value('tekkasch.d').
     3763        repeat :
     3764          create buf_temp-tekka-schema.
     3765          import buf_temp-tekka-schema.
     3766          assign
     3767          buf_temp-tekka-schema.host = 'IBS'
     3768          ii = ii + 1.
     3769          .
     3770        end.
     3771        input close.
     3772        ii-ibs = ii.
     3773         _ii:
     3774         do ii = 1 to 256:
     3775           if p-obj-list = "ALL"
     3776           or lookup(string(ii), p-obj-list) > 0 then do:
     3777             assign
     3778             v-obj-num = 0
     3779             v-obj-name = ''
     3780             v-num-records = 0
     3781             v-size_ = 0
     3782             .
     3783             run alienini-getkey in this-procedure (
     3784                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3785                                                     ,input ('obj' + string(ii, '999'))
     3786                                                     ,input 'oname'
     3787                                                     ,output v-value) no-error .
     3788             if v-value = ? then next _ii.
     3789             assign
     3790             v-obj-num = ii
     3791             v-obj-name = v-value
     3792             .
     3793             run alienini-getkey in this-procedure (
     3794                                                      input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3795                                                     ,input ('obj' + string(ii, '999'))
     3796                                                     ,input 'size'
     3797                                                     ,output v-value) no-error .
     3798             assign
     3799             v-num-records = integer(v-value) no-error  .
     3800             if error-status:error
     3801             or v-num-records = 0 then next _ii.
     3802             run alienini-getkey in this-procedure (
     3803                                                      input  (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3804                                                     ,input 'obj' + string(ii, '999')
     3805                                                     ,input 'f000'
     3806                                                     ,output v-value) no-error .
     3807             assign
     3808             v-size_ = integer(v-value) no-error  .
     3809             if error-status:error
     3810             or v-size_ = 0 then next _ii.
     3811             _jj:
     3812             do jj = 1 to 256:
     3813               run alienini-getkey in this-procedure (
     3814                                                        input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3815                                                       ,input 'obj' + string(ii, '999')
     3816                                                       ,input 'f' + string(jj, '999')
     3817                                                       ,output v-value) no-error .
     3818               if v-value = ? then next _ii.
     3819               create buf_temp-tekka-schema.
     3820               assign
     3821               buf_temp-tekka-schema.host = 'tekka'
     3822               buf_temp-tekka-schema.obj-num = v-obj-num
     3823               buf_temp-tekka-schema.obj-name = v-obj-name
     3824               buf_temp-tekka-schema.num-records = v-num-records
     3825               buf_temp-tekka-schema.size_ = v-size_
     3826               buf_temp-tekka-schema.field-num = jj
     3827               buf_temp-tekka-schema.custom-type = entry(1, entry(2, v-value, '#'), ':')
     3828               buf_temp-tekka-schema.bin-group = (if num-entries(entry(2, v-value, '#'), ':') > 1
     3829                                                  then entry(2, entry(2, v-value, '#'), ':')
     3830                                                  else '':U)
     3831               buf_temp-tekka-schema.start-pos = integer(entry(1, entry(1, v-value, '#'), '-'))
     3832               buf_temp-tekka-schema.end-pos = integer(entry(2, entry(1, v-value, '#'), '-'))
     3833               buf_temp-tekka-schema.progress-type = entry( LOOKUP(buf_temp-tekka-schema.custom-type, 'Sx,B,BF,BN,UI,UL,FL,SL,VL':U)
     3834                                                           , 'C,I,I,I,D,D,D,D,D':U)
     3835               no-error
     3836               .
     3837               if error-status:error then do:
     3838                 delete buf_temp-tekka-schema.
     3839                 next _jj.
     3840               end.
     3841               run alienini-getkey in this-procedure (
     3842                                                       input (trim(p-dir-path, chr(92)) + chr(92) + 'datastru.ini')
     3843                                                       ,input 'obj' + string(ii, '999') + 'name'
     3844                                                       ,input 'n' + string(jj, '999')
     3845                                                       ,output v-value) no-error .
     3846               if v-value <> ? then
     3847               buf_temp-tekka-schema.field-name = v-value.
     3848             end.
     3849           end.
     3850         end.
     3851         ii-tekka = ii - 1.
     3852        if p-obj-list <> 'ALL' then do:
     3853         if ii-tekka <> ii-ibs then do:
     3854           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS &1 объектов&1по даным OLE-сервера &2"
     3855                                   , ii-ibs
     3856                                   , ii-tekka).
     3857         end.
     3858        end.
     3859        for each buf_temp-tekka-schema where
     3860               buf_temp-tekka-schema.host = 'tekka':
     3861          find first buf2_temp-tekka-schema where
     3862                    buf2_temp-tekka-schema.obj-num = buf_temp-tekka-schema.obj-num
     3863                AND buf2_temp-tekka-schema.host = 'ibs'
     3864                AND buf2_temp-tekka-schema.field-num = buf_temp-tekka-schema.field-num no-error .
     3865          if not available buf2_temp-tekka-schema then do:
     3866           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS нет поля &1 для объекта &2"
     3867                                   , buf_temp-tekka-schema.field-num
     3868                                   , buf_temp-tekka-schema.obj-num).
     3869          end.
     3870          buffer-compare buf_temp-tekka-schema
     3871          to buf2_temp-tekka-schema
     3872          save result in v-result.
     3873          if v-result <> '':U then do:
     3874           return error substitute("Несовпадание структур данных для ТЭККА:&1по данным IBS для поля &1 объекта &2"
     3875                                   , buf_temp-tekka-schema.field-num
     3876                                   , buf_temp-tekka-schema.obj-num).
     3877          end.
     3878        end.
     3879     end.
     3880   end procedure.
     3881   FUNCTION set-Sx returns character (input p-string as character):
     3882   return p-string.
     3883   END FUNCTION.
     3884   FUNCTION get-Sx returns character (input p-string  as character):
     3885   return p-string.
     3886   END FUNCTION.
     3887   FUNCTION set-B returns character (input p-string  as character):
     3888   return chr(integer(p-string)).
     3889   END FUNCTION.
     3890   FUNCTION get-B returns character (input p-string  as character):
     3891   return string(asc(p-string)).
     3892   END FUNCTION.
     3893   FUNCTION set-BF returns character (input p-string  as character):
     3894   define variable v-dopi as integer no-undo .
     3895   define variable ii as integer no-undo .
     3896   do ii = 1 to 8:
     3897     put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     3898   end.
     3899   return chr(v-dopi).
     3900   END FUNCTION.
     3901   FUNCTION get-BF returns character (input p-string  as character):
     3902   define variable v-dopi as integer no-undo .
     3903   define variable v-dops as character no-undo .
     3904   define variable ii as integer no-undo .
     3905   v-dopi = asc(p-string).
     3906   do ii = 8 to 1 BY -1:
     3907     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     3908   end.
     3909   return v-dops.
     3910   END FUNCTION.
     3911   FUNCTION set-BN returns character (input p-string  as character
     3912                                     ,input p-bin-group as character):
     3913   define variable v-dopi as integer no-undo .
     3914   define variable ii as integer no-undo .
     3915   define variable jj as integer no-undo .
     3916   define variable v-grp-nums as integer no-undo .
     3917   define variable v-dopi2 as integer no-undo .
     3918   v-grp-nums = num-entries(p-bin-group).
     3919   do jj = 0 to v-grp-nums - 1:
     3920     v-dopi2 = integer(substring(p-string, jj + 1, 3)).
     3921     do ii = 1 to 8:
     3922       put-bits(v-dopi, ii, 1) = integer(substring(p-string, 8 - ii + 1, 1)).
     3923     end.
     3924   end.
     3925   return chr(v-dopi).
     3926   END FUNCTION.
     3927   FUNCTION get-BN returns character (input p-string  as character
     3928                                     ,input p-bin-group as character):
     3929   define variable v-dopi as integer no-undo .
     3930   define variable v-dops as character no-undo .
     3931   define variable v-grp-nums as integer no-undo .
     3932   define variable ii as integer no-undo .
     3933   define variable jj as integer no-undo .
     3934   v-dopi = asc(p-string).
     3935   v-grp-nums = num-entries(p-bin-group).
     3936   do jj = 1 to v-grp-nums:
     3937   do ii = 8 to 1 BY -1:
     3938     v-dops = v-dops + string(get-bits(v-dopi, ii, 1) ).
     3939   end.
     3940   end.
     3941   return v-dops.
     3942   END FUNCTION.
     3943   procedure fill-temp-cd :
     3944   define input parameter p-db-num   like ub.cash-desk.db-num no-undo .
     3945   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     3946   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     3947   define input parameter p-clear-table as logical no-undo .
     3948   define buffer buf_temp-cd for temp-cd.
     3949   define buffer buf_cash-desk for ub.cash-desk.
     3950     do
     3951     on error undo, return error
     3952     :
     3953        if p-clear-table  then do:
     3954          for each buf_temp-cd:
     3955            delete buf_temp-cd.
     3956          end.
     3957        end.
     3958        for each buf_cash-desk no-lock where
     3959               buf_cash-desk.db-num = p-db-num
     3960           AND buf_cash-desk.obj-code = p-obj-code
     3961           and buf_cash-desk.cash-on  = yes
     3962        BREAK by buf_cash-desk.pos-type:
     3963          if first-of(buf_cash-desk.pos-type) then do:
     3964            create buf_temp-cd.
     3965            buffer-copy buf_cash-desk to buf_temp-cd.
     3966          end.
     3967        end.
     3968     end.
     3969   end procedure.
     3970   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3971   FUNCTION name-2cdf returns character
     3972                      (  input p-name-2cd as character
     3973                       , input p-mode as logical
     3974                       , input p-cod-pcod as logical
     3975                       , input p-b-code  as integer
     3976                       , input p-gds-code as integer
     3977                       , input p-artic   as character
     3978                       , input p-engl-name  as character
     3979                       , input p-in-code as character
     3980                       , input p-part-code as character
     3981                       , input p-obj-type as character
     3982                       , input p-obj-code as integer
     3983                       , input p-alpha1 as character
     3984                       , output p-gtd as character
     3985                       ) :
     3986   define variable v-name-2cd as character no-undo .
     3987   define variable v-dop-alt-name as character no-undo.
     3988   define variable v-type as character no-undo.
     3989   define buffer buf_parts for ub.parts.
     3990   define buffer buf_code for ub.code.
     3991   if not p-mode and p-name-2cd = "PLU":U then do:
     3992     return "PLU кассы":U.
     3993   end.
     3994   if not p-mode then do:
     3995     if p-name-2cd <> "GTD":U
     3996     and  p-name-2cd <> "alpha1|gtd":U
     3997     then do:
     3998     assign
     3999     p-name-2cd = p-name-2cd + "-":U + "GTD":U.
     4000   end.
     4001   end.
     4002   if p-part-code = "":U or p-cod-pcod = no then do:
     4003     run gdsoattr-value in this-procedure (
     4004       'dt-seasons':U,
     4005       p-gds-code,
     4006       p-obj-type,
     4007       p-obj-code,
     4008       output v-dop-alt-name,
     4009       output v-type
     4010     ) no-error.
     4011     if v-dop-alt-name <> "" then do:
     4012       find first buf_code where
     4013                  buf_code.parent = "DTSeasons"
     4014              and buf_code.code   = v-dop-alt-name
     4015            no-lock no-error.
     4016       if available buf_code then
     4017         assign
     4018           p-engl-name = ""
     4019           v-dop-alt-name =  buf_code.misc1
     4020         .
     4021     end.
     4022     else do:
     4023       run gdsoattr-value in this-procedure
     4024                           ( input  'dop-alt-name-o':U
     4025                            ,input  p-gds-code
     4026                            ,input  p-obj-type
     4027                            ,input  p-obj-code
     4028                            ,output v-dop-alt-name
     4029                            ,output v-type
     4030                           ) no-error .
     4031     end.
     4032     CASE p-name-2cd:
     4033       when "name" then do:
     4034         if p-mode then return p-engl-name + v-dop-alt-name.
     4035         return "Англ. название".
     4036       end.
     4037       when "code":U then do:
     4038         if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4039         return "Лок. код товара"  .
     4040       end.
     4041       when "GTD":U
     4042       or
     4043       when "name-GTD":U
     4044       or
     4045       when "code-GTD":U
     4046       or
     4047       when "alpha1|gtd":U
     4048       or
     4049       when "name-alpha1|gtd":U
     4050       or
     4051       when "code-alpha1|gtd":U
     4052       then do:
     4053         if p-mode then do:
     4054           run gdcstcod_cst-code  in this-procedure (
     4055                                                       input  p-obj-type
     4056                                                       ,input  p-obj-code
     4057                                                       ,input  p-gds-code
     4058                                                       ,input  p-in-code
     4059                                                       ,input  p-part-code
     4060                                                       ,output p-gtd
     4061                                                       ) no-error .
     4062         end.
     4063         if p-name-2cd = "name-gtd":U then do:
     4064           if p-mode then return p-engl-name  + v-dop-alt-name.
     4065           return "Англ. название".
     4066         end.
     4067         if p-name-2cd = "name-alpha1|gtd":U then do:
     4068           if p-mode then return p-engl-name  + v-dop-alt-name.
     4069           return "Англ. название".
     4070         end.
     4071         if p-name-2cd = "code-GTD":U then do:
     4072           if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4073           return "Лок. код товара"  .
     4074         end.
     4075         if p-name-2cd = "code-alpha1|gtd":U then do:
     4076           if p-mode then  return string( p-b-code, ">>>>>>>>>>>>>>>9" )  .
     4077           return "Лок. код товара"  .
     4078         end.
     4079         if p-mode then do:
     4080           if p-name-2cd = "GTD" then  return p-gtd.
     4081           if p-name-2cd = "alpha1|gtd" then  return (p-alpha1 + "|" + p-gtd).
     4082         end.
     4083         if p-name-2cd = "GTD" then  return "Код ГТД".
     4084         if p-name-2cd = "alpha1|gtd" then  return "Страна|Код ГТД".
     4085       end.
     4086     END CASE.
     4087   end.
     4088   else do:
     4089     if p-name-2cd = "name-gtd":U
     4090     or p-name-2cd = "code-GTD":U
     4091     or p-name-2cd = "name-alpha1|GTD":U
     4092     or p-name-2cd = "code-alpha1|GTD":U
     4093     or p-name-2cd = "alpha1|GTD":U
     4094     then do:
     4095       if p-mode then do:
     4096         run gdcstcod_cst-code  in this-procedure (
     4097                                                      input  p-obj-type
     4098                                                     ,input  p-obj-code
     4099                                                     ,input  p-gds-code
     4100                                                     ,input  p-in-code
     4101                                                     ,input  p-part-code
     4102                                                     ,output p-gtd
     4103                                                     ) no-error .
     4104       end.
     4105       else do:
     4106         if p-name-2cd = "gtd":U then
     4107         p-gtd = "Код ГТД".
     4108         if p-name-2cd = "alpha1|Gtd":U then
     4109         p-gtd = "Страна|Код ГТД".
     4110       end.
     4111     end.
     4112     if p-mode then  return p-part-code.
     4113     return "Код партии".
     4114   end.
     4115   END FUNCTION.
     4116   function chk-name_ibm_maria_ibm-xml_infokiosk_ibs-th returns character ( input p-pos-type as character
     4117                                            ,input p-nam-2str as logical
     4118                                            ,input p-nam-artc as logical
     4119                                            ,input p-unit-cli-type as character
     4120                                            ,input p-unit-base as character
     4121                                            ,input p-unit-cli as character
     4122                                            ,input p-cli-base-rate as decimal
     4123                                            ,input p-artic as character
     4124                                            ,input p-f-name as character
     4125                                            ,input p-gds-name as character
     4126                                            ,input p-gds-name1 as character
     4127                                            ,output p-second-name as character):
     4128   define variable v-length as integer no-undo .
     4129   define variable nam-2str-shift as integer no-undo .
     4130   define variable chk_name as character no-undo .
     4131   assign
     4132   v-length = (if p-pos-type = 'IBM':U then 25 else 40 )
     4133   v-length = (if p-pos-type = 'MARIA':U then 24 else v-length)
     4134   v-length = (if p-pos-type = 'MARIA':U and lookup('топ':U, p-unit-cli-type) > 0
     4135               then 5
     4136               else v-length)
     4137   v-length = (if p-pos-type = 'IBM-XML':U then 128 else v-length )
     4138   nam-2str-shift = (if p-nam-2str then v-length else 0)
     4139   .
     4140   if p-nam-artc then do:
     4141     assign
     4142     chk_name = substitute("&1 &2", p-artic, p-f-name)
     4143       .
     4144   end.
     4145   else  do:
     4146     assign
     4147     chk_name = replace(p-gds-name, chr(34), "":U) + p-f-name
     4148     .
     4149   end.
     4150   if p-unit-base <> p-unit-cli then do:
     4151     if length (chk_name) > 109 then chk_name = substring (chk_name,1,109) .
     4152     assign
     4153     chk_name = string(substr(chk_name
     4154                               ,1
     4155                               ,max(14, v-length + nam-2str-shift - 1 - length(trim(string(p-cli-base-rate), chr(32)))) +  nam-2str-shift ) +
     4156                       "*":U +
     4157                       trim(string(p-cli-base-rate), chr(32)), "x(":U + string(v-length + nam-2str-shift) + ")":U ).
     4158   end.
     4159   else do:
     4160     chk_name = string(chk_name, "X(":U + string(v-length + nam-2str-shift) + ")":U).
     4161   end.
     4162   if p-nam-2str then do:
     4163     assign
     4164     p-second-name = chr(34) + trim(substr(chk_name, v-length)," ") + chr(34)
     4165     chk_name = substr(chk_name, 1, v-length)
     4166     .
     4167   end.
     4168   else do:
     4169     assign
     4170     p-second-name = replace(p-gds-name1, chr(39), "":U)
     4171     p-second-name =   (chr(34) +
     4172                       TRIM(string( replace(p-second-name, chr(34), "":U), "X(":U + string(v-length) + ")":U ))
     4173                       + chr(34) )
     4174     .
     4175   end.
     4176   return chk_name.
     4177   end function.
     4178   def var vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4179   procedure disrules-get-interface-form :
     4180   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
     4181   define output parameter p-form-name as character no-undo .
     4182   define buffer buf_temp-drt-prop for temp-drt-prop.
     4183   define buffer buf_drt-prop for ub.drt-prop.
     4184   find first buf_temp-drt-prop where
     4185             buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
     4186         and buf_temp-drt-prop.upper-prop-code = "InputForm"
     4187         and buf_temp-drt-prop.prop-code = "FormName" no-error.
     4188   if not available buf_temp-drt-prop then do:
     4189     find first buf_drt-prop where
     4190               buf_drt-prop.templ-rl-root = p-templ-rl-root
     4191           and buf_drt-prop.upper-prop-code = "InputForm"
     4192           and buf_drt-prop.prop-code = "FormName" no-error.
     4193     if available buf_drt-prop then do:
     4194       p-form-name = buf_drt-prop.property-value.
     4195     end.
     4196     else do:
     4197       p-form-name = "ref/dis-ruli.w".
     4198     end.
     4199   end.
     4200   else do:
     4201     p-form-name = buf_temp-drt-prop.property-value.
     4202   end.
     4203   end procedure.
