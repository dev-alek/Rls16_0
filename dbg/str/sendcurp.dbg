     2454   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2455   define variable v-cashless-code as integer no-undo .
     2456   define variable v-no-pay-code as integer no-undo .
     2457   define variable v-VIP-pay-code as integer no-undo .
     2458   define variable v-mag-base-code like ub.cash-pay.cdpay-code no-undo .
