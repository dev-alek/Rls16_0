     2460   define variable v-r-b-code  like ub.sysconf.base-code no-undo .
     2461   define variable v-r-b        as character no-undo .
     2462   define variable conf-attr as character no-undo .
     2463   define variable conf-par as character no-undo .
     2464   define variable par-type as character no-undo .
     2465   define variable v-cp-is-use as logical no-undo .
     2466   define buffer base_currency for ub.currency.
     2467   assign
     2468   log-file-name = p-log-file-name
     2469   .
     2470   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2471   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2472     (input  'маг':U
     2473     ,input  p-obj-code
     2474     ,output v-host-code
     2475     )  .
     2476   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2477   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run r-b-curr in g#library
     2478     (input  v-host-code
     2479     ,output v-r-b-code
     2480     )  .
     2481   for each thbjattr_thbj-attr:
     2482     delete thbjattr_thbj-attr.
     2483   end.
     2484   assign
     2485   v-tth = buffer thbjattr_thbj-attr:table-handle .
     2486   run adm/shattri.p (
     2487         input "get":U
     2488         ,input  'маг':U
     2489         ,input  p-obj-code
     2490         ,input  'cd-type-magia-xml':U
     2491         ,input  '':U
     2492         ,output v-value-character
     2493         ,output v-value-date
     2494         ,output v-value-decimal
     2495         ,output v-value-integer
     2496         ,output v-value-logical
     2497         ,output v-param-type
     2498         ,INPUT-OUTPUT table-handle v-tth
     2499         ) no-error .
     2500   IF error-status:error then return error return-value .
     2501   for each thbjattr_thbj-attr where
     2502           thbjattr_thbj-attr.obj-type = 'маг':U
     2503       and thbjattr_thbj-attr.obj-code = p-obj-code
     2504       and thbjattr_thbj-attr.upper-prop-code = 'cd-type-magia-xml':U
     2505   on error undo, return error :
     2506     case thbjattr_thbj-attr.prop-code:
     2507        when 'mag-bnal':U then do:
     2508          v-cashless-code = thbjattr_thbj-attr.property-value-integer.
     2509        end.
     2510        when 'magnopay':U then do:
     2511          v-no-pay-code = thbjattr_thbj-attr.property-value-integer.
     2512        end.
     2513        when 'mag-vip':U then do:
     2514          v-vip-pay-code = thbjattr_thbj-attr.property-value-integer.
     2515        end.
     2516     end case.
     2517   end.
     2518   if action = 'D':U then do:
     2519     assign
     2520     v-cp-is-use = no.
     2521   end.
     2522   if action <> 'D':U then do:
     2523     run adm/shattri.p (
     2524         input "get":U
     2525         ,input  'маг':U
     2526         ,input  p-obj-code
     2527         ,input  'cd-inf-send':U
     2528         ,input  'cp-is-use':U
     2529         ,output v-value-character
     2530         ,output v-value-date
     2531         ,output v-value-decimal
     2532         ,output v-value-integer
     2533         ,output v-value-logical
     2534         ,output v-param-type
     2535         ,INPUT-OUTPUT table-handle v-tth
     2536         ) no-error .
     2537     IF not error-status:error
     2538     then v-cp-is-use = v-value-logical.
     2539     else return error return-value .
     2540   end.
     2541   find first base_currency no-lock where
     2542            base_currency.curr-code = v-r-b-code .
     2543   if base_currency.okv-code = 0 then do:
     2544       run write-log-and-file in p-log-handle (
     2545             input 1
     2546           , input log-file-name
     2547           , input 1
     2548           , input substitute( "!!!Для валюты &1 с кодом &2 не задан код ОКВ"
     2549                               , base_currency.curr-abbr
     2550                               , v-r-b-code
     2551                             )
     2552                                             ).
     2553     assign
     2554     p-view-log = yes
     2555     .
     2556     undo, return.
     2557   end.
     2558   assign
     2559   v-mag-base-code = (if base_currency.curr-code = 0
     2560                      then 1
     2561                      else base_currency.okv-code)
     2562   .
     2563   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2564   PROCEDURE putc-curp.
     2565   define input parameter p-cash-num like ub.cash-desk.cash-num no-undo .
     2566   define input parameter p-pos-type like ub.cash-desk.pos-type no-undo.
     2567   define buffer buf_clients for ub.clients.
     2568   define buffer buf_cash-pay for ub.cash-pay.
     2569   define buffer buf_currency for ub.currency.
     2570   define variable v-mag-code like ub.cash-pay.cdpay-code no-undo .
     2571   define variable v-rate as decimal no-undo .
     2572   define variable v-scale as integer no-undo .
     2573   define variable v-rate-rubl as decimal no-undo .
     2574   define variable v-scale-rubl as integer no-undo .
     2575   define variable v-rate-base as decimal no-undo .
     2576   define variable v-scale-base as integer no-undo .
     2577   define variable v-curr-abbr like ub.currency.curr-abbr no-undo .
     2578   define variable v-date as date no-undo .
     2579   define variable v-time as integer no-undo .
     2580   define variable v-value as character no-undo .
     2581   define variable v-type as character no-undo .
     2582   do
     2583   on error undo, return error
     2584   :
     2585   CASE p-pos-type:
     2586     when 'MAGIA-XML':U then do:
     2587       _for:
     2588       for each buf_cash-pay no-lock,
     2589           first buf_currency no-lock where
     2590                 buf_currency.curr-code = buf_Cash-pay.curr-code:
     2591          if p-selective and
     2592          LOOKUP(string(recid(buf_cash-pay)), p-rid-list) = 0 then NEXT.
     2593         if buf_cash-pay.status_ <> 'тек':U and action = 'U' and not p-selective then NEXT.
     2594         if v-cp-is-use then do:
     2595           run cp-attr-value  in this-procedure (
     2596                                                   input  buf_cash-pay.cdpay-code
     2597                                                   ,input  buf_cash-pay.curr-code
     2598                                                   ,input  v-host-code
     2599                                                   ,input  'маг':U
     2600                                                   ,input  p-obj-code
     2601                                                   ,input  'is-use':U
     2602                                                   ,output v-value
     2603                                                   ,output v-type) no-error .
     2604           if error-status:error
     2605           or v-value = '':u then do:
     2606             run cp-attr-value  in this-procedure (
     2607                                                       input buf_cash-pay.cdpay-code
     2608                                                     ,input  buf_cash-pay.curr-code
     2609                                                     ,input  v-host-code
     2610                                                     ,input  '':U
     2611                                                     ,input  0
     2612                                                     ,input  'is-use':U
     2613                                                     ,output v-value
     2614                                                     ,output v-type) no-error .
     2615             if error-status:error
     2616             or v-value = '':u then do:
     2617               run cp-attr-value  in this-procedure (
     2618                                                         input  buf_cash-pay.cdpay-code
     2619                                                       ,input  buf_cash-pay.curr-code
     2620                                                       ,input  0
     2621                                                       ,input  '':U
     2622                                                       ,input  0
     2623                                                       ,input  'is-use':U
     2624                                                       ,output v-value
     2625                                                       ,output v-type) no-error .
     2626             end.
     2627           end.
     2628           if v-value <> '*':U
     2629           and lookup(string(p-cash-num) + chr(44) + p-pos-type, chr(4)) = 0 then next _for.
     2630         end.
     2631         if buf_cash-pay.is-cash then do:
     2632           if buf_currency.okv-code = 0 then do:
     2633             run write-log-and-file in p-log-handle (
     2634                   input 1
     2635                 , input log-file-name
     2636                 , input 1
     2637                 , input substitute( "!!!Для валюты &1 с кодом &2 не задан код ОКВ"
     2638                                     , buf_currency.curr-abbr
     2639                                     , buf_currency.curr-code
     2640                                   )
     2641                                                   ).
     2642             assign
     2643             p-view-log = yes
     2644             .
     2645             NEXT _for.
     2646           end.
     2647         end.
     2648         else do:
     2649           if buf_cash-pay.cdpay-code > 10000 then  do:
     2650             run write-log-and-file in p-log-handle (
     2651                   input 1
     2652                 , input log-file-name
     2653                 , input 1
     2654                 , input substitute( "!!!Нельзя передать тип кассового платежа &1 с кодом большим 10000: &2"
     2655                                     , buf_cash-pay.obj-name
     2656                                     , buf_cash-pay.cdpay-code
     2657                                   )
     2658                                                   ).
     2659             assign
     2660             p-view-log = yes
     2661             .
     2662             NEXT _for.
     2663           end.
     2664         end.
     2665         assign
     2666         v-mag-code = (if buf_cash-pay.is-cash
     2667                   then (if buf_currency.curr-code = 0 then 1 else buf_currency.okv-code)
     2668                   else (10000 + buf_cash-pay.cdpay-code)
     2669                   )
     2670         .
     2671         if buf_cash-pay.curr-code = v-r-b-code then do:
     2672           assign
     2673           v-rate = 1
     2674           v-scale = 1
     2675           .
     2676         end.
     2677         else do:
     2678           run cur-time in this-procedure(output v-date, output v-time).
     2679   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2680   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     2681     (input  buf_cash-pay.curr-code
     2682     ,input  today
     2683     ,output v-rate-rubl
     2684     ,output v-scale-rubl
     2685     ,output v-curr-abbr
     2686     )  .
     2687           if v-r-b-code = 0 then  do:
     2688             assign
     2689             v-rate = v-rate-rubl
     2690             v-scale = v-scale-rubl
     2691             .
     2692           end.
     2693           else do:
     2694   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2695   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     2696     (input  v-r-b-code
     2697     ,input  today
     2698     ,output v-rate-base
     2699     ,output v-scale-base
     2700     ,output v-curr-abbr
     2701     )  .
     2702             assign
     2703             v-rate = v-rate-rubl / (v-rate-base / v-scale-base)
     2704             .
     2705           end.
     2706         end.
     2707         run bgelib-tag-open in this-procedure ( input 2, input "Payment"
     2708                                               , input substitute("ctrl='&1' tms='&2' code='&3'", (if action = "U"
     2709                                                                                                   then "ADD":U
     2710                                                                                                   else "DEL":U),
     2711                                               OS2-time, v-mag-code)).
     2712         run bgelib-tag-put in this-procedure ( input 3, input "PaymentBaseCode"
     2713                                              , input string(v-mag-base-code), input 1 ).
     2714         run bgelib-tag-put in this-procedure ( input 3, input "PaymentShort":U
     2715                                              , input (if buf_cash-pay.is-cash
     2716                                                       then string(buf_currency.curr-abbr)
     2717                                                       else substr(buf_cash-pay.obj-name, 1, 3)), input 1 ).
     2718         run bgelib-tag-put in this-procedure ( input 3, input "PaymentName":U
     2719                                              , input (if buf_cash-pay.is-cash
     2720                                                       then substr(buf_currency.curr-name, 1, 12)
     2721                                                       else substr(buf_cash-pay.obj-name, 1, 12)), input 1 ).
     2722         run bgelib-tag-put in this-procedure ( input 3, input "PaymentCurrencyRate":U
     2723                                              , input  string(v-rate), input 1 ).
     2724         run bgelib-tag-put in this-procedure ( input 3, input "PaymentCurrencyDecimal":U
     2725                                              , input string(v-scale), input 1 ).
     2726         run bgelib-tag-put in this-procedure ( input 3, input "PaymentCurrencyLock":U
     2727                                              , input (if action = "D":U
     2728                                                       then string(1)
     2729                                                       else string(0)), input 1 ).
     2730         run bgelib-tag-open in this-procedure ( input 3, input "PaymentStatus"
     2731                                               , input "":U).
     2732         run bgelib-tag-put in this-procedure ( input 4, input "PSCash":U
     2733                                              , input string(if buf_cash-pay.is-cash then 1 else 0), input 1 ).
     2734         run bgelib-tag-put in this-procedure ( input 4, input "PSCreditCard":U
     2735                                              , input string(if buf_cash-pay.is-credit-card  and not buf_cash-pay.atr16
     2736                                                            then 1
     2737                                                            else 0), input 1 ).
     2738         run bgelib-tag-put in this-procedure ( input 4, input "PSAuthorize":U
     2739                                              , input string(if buf_cash-pay.is-credit-card  and buf_cash-pay.atr16
     2740                                                            then 1
     2741                                                            else 0), input 1 ).
     2742         run bgelib-tag-put in this-procedure ( input 4, input "PSCard":U
     2743                                              , input string(if buf_cash-pay.is-debet-card
     2744                                                            then 1
     2745                                                            else 0), input 1 ).
     2746         run bgelib-tag-put in this-procedure ( input 4, input "PSCashless":U
     2747                                              , input string(if buf_cash-pay.cdpay-code = v-cashless-code
     2748                                                      then 1
     2749                                                      else 0), input 1 ).
     2750         run bgelib-tag-put in this-procedure ( input 4, input "PSNoPay":U
     2751                                              , input string(if buf_cash-pay.cdpay-code = v-no-pay-code
     2752                                                             then  1
     2753                                                             else 0), input 1 ).
     2754         run bgelib-tag-put in this-procedure ( input 4, input "PSVIPClient":U
     2755                                              , input string(if buf_cash-pay.cdpay-code = v-VIP-pay-code
     2756                                                             then 1
     2757                                                             else 0), input 1 ).
     2758         run bgelib-tag-close in this-procedure ( input 3, input "PaymentStatus").
     2759         run bgelib-tag-close in this-procedure ( input 2, input "Payment").
     2760       end.
     2761     end.
     2762   END CASE .
     2763   end.
     2764   END PROCEDURE .
     2765   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2766   PROCEDURE   for-cash-cycle:
     2767   define buffer for-cash-desk for ub.cash-desk.
     2768   define buffer buf_shop for ub.shop.
     2769   define variable v-first as logical no-undo .
     2770     FOR EACH for-cash-desk NO-LOCK WHERE
     2771             for-cash-desk.db-num = g#db-num AND
     2772             for-cash-desk.pos-type = ub.cash-desk.pos-type AND
     2773             for-cash-desk.cash-on  = yes,
     2774       FIRST buf_shop no-lock where
     2775             buf_shop.obj-code = ub.cash-desk.obj-code
     2776        AND  buf_shop.host-code = v-host-code
     2777       BREAK
     2778       BY for-cash-desk.db-num
     2779       BY for-cash-desk.pos-type
     2780       BY for-cash-desk.cash-on
     2781       :
     2782       if for-cash-desk.pos-type <> 'MAGIA-XML':U
     2783       OR (LOOKUP(ub.cash-desk.pos-type,
     2784                 ('NCR-GM':U + chr(44) +
     2785                  'IBM-XML':U + chr(44) +
     2786                  'MAGIA-XML':U + chr(44) +
     2787                  'NCR-AS@R':U
     2788                  )) > 0
     2789        and for-cash-desk.autonomy = integer('1':U))
     2790        or v-first then next.
     2791       assign
     2792       v-first = yes
     2793       .
     2794       run write-log-and-file in p-log-handle (
     2795             input 1
     2796           , input log-file-name
     2797           , input 1
     2798           , input substitute("Пересылка - касса &1", for-cash-desk.cash-num)
     2799                                                         ).
     2800   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2801   case for-cash-desk.pos-type:
     2802     when 'MAGIA-XML':U then do:
     2803   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2804   run xml-cd-filename in this-procedure (
     2805         input out
     2806       , output v-xml-file-name
     2807       , output v-xml-file-name-path
     2808       , output v-log-file-name
     2809       , output v-locked
     2810   ).
     2811   run write-log-and-file in p-log-handle (
     2812         input 1
     2813       , input log-file-name
     2814       , input 1
     2815       , input substitute( ("'Пересылка данных по валютам-оплатам'" + " &1")
     2816                               , replace( v-xml-file-name-path, "/", "\" ) + "xm1"
     2817                         )
     2818                                         ).
     2819   run write-log-and-file in p-log-handle (
     2820         input 1
     2821       , input log-file-name
     2822       , input 1
     2823       , input substitute( "................с параметрами: ... БД: &1", g#db-num )
     2824                                         ).
     2825   assign
     2826   v-obj-list = "БД" + string(g#db-num)
     2827   .
     2828   run xml-cd-write-header in this-procedure (
     2829         input v-xml-file-name
     2830       , input v-xml-file-name-path
     2831       , input "data"
     2832       , input "14.0 " + replace( vss-revision + vss-date, "$", " " )
     2833       , input v-obj-list
     2834       , input (
     2835                 (IF for-cash-desk.pos-type = 'IBM-XML':U
     2836                   then (if for-cash-desk.autonomy = integer('0':U)
     2837                         then  ("маг" + string(for-cash-desk.obj-code) + "_касса" + string(for-cash-desk.cash-num))
     2838                         else ("КМ"    )
     2839                         )
     2840                   else ("маг" + string(for-cash-desk.obj-code) + "_касса" + string(for-cash-desk.cash-num))
     2841                   )
     2842               )
     2843       , input yes
     2844   ).
     2845   output stream stmxmlout to value( v-xml-file-name-path + "xm1" ) convert target "1251" append.
     2846   OS2-time =  string( ( today - date( "01/01/1996" ) ) * 24 * 3600 + time, ">>>>>>>>9").
     2847     end.
     2848   END CASE.
     2849       RUN putc-curp( for-cash-desk.cash-num, for-cash-desk.pos-type ).
     2850   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2851   case for-cash-desk.pos-type:
     2852     when 'MAGIA-XML':U then do:
     2853   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2854   output stream stmxmlout close.
     2855   run xml-cd-write-footer in this-procedure ( input for-cash-desk.pos-type, input v-xml-file-name-path
     2856       , input 'data'
     2857   ).
     2858   run write-log-and-file in p-log-handle (
     2859         input 1
     2860       , input log-file-name
     2861       , input 1
     2862       , input substitute( "Данные выгружены в файл &1"
     2863                               , replace( v-xml-file-name-path, "/", "\" ) + "xml"
     2864                         )
     2865                                          ).
     2866   if (
     2867   not (g#news or g#auto or g#esys )
     2868   or
     2869   (
     2870   for-cash-desk.pos-type = 'MAGIA-XML':U
     2871   or
     2872     (for-cash-desk.pos-type = 'IBM-XML':U
     2873   or (for-cash-desk.pos-type = 'Autotank':U
     2874     and
     2875     for-cash-desk.autonomy = integer('2':U))
     2876     )))
     2877   then do:
     2878     if for-cash-desk.pos-type = 'MAGIA-XML':U then do:
     2879       run str/waitpxml.w ( replace( v-xml-file-name-path, "/", "\" ) + "xml",
     2880                   (replace(in_ + spl + "/" + v-xml-file-name, "/", "\" ) + ".xml"),
     2881                   ( if action = 'U'
     2882                     then ('Ждите - ' + 'добавление данных по валютам-оплатам')
     2883                     else ('Ждите - ' + 'удаление данных по валютам-оплатам') ) +
     2884                     substitute("Маг&1 касса&2", for-cash-desk.obj-code, for-cash-desk.cash-num),
     2885                     ' Подождите 15 сек ',
     2886                     'Касса не ответила. Если Вы уверены, что с ней нет связи нажмите кнопку!',
     2887                     'Подождите: касса обрабатывает запрос',
     2888                     15 ) no-error.
     2889       if error-status:error then do:
     2890         os-delete value( replace( v-xml-file-name-path, "/", "\" ) + "xml" ) .
     2891         run write-log-and-file in p-log-handle (
     2892               input 1
     2893             , input log-file-name
     2894             , input 1
     2895             , input substitute( "!!!Прерван обмен информацией с кассой &1, на кассе осталась устаревшая информация",
     2896                                   for-cash-desk.cash-num
     2897                               )
     2898                                               ).
     2899         assign
     2900         v-view-log = yes
     2901         .
     2902         return "error":U.
     2903       end.
     2904     end.
     2905     if (for-cash-desk.pos-type = 'IBM-XML':U
     2906     and for-cash-desk.autonomy = integer('0':U))
     2907     or (for-cash-desk.pos-type = 'Autotank':U
     2908     and for-cash-desk.autonomy = integer('2':U))
     2909     then do:
     2910       run str/post-xml.p
     2911         (
     2912          input parparentproc
     2913         ,input p-parent-handle
     2914         ,input p-log-handle
     2915         ,input g#news or g#esys
     2916         ,input g#auto
     2917         ,input 'send'
     2918         ,input log-file-name
     2919         ,input (entry(1, for-cash-desk.addr-path, chr(4)) + '://' + entry(2, for-cash-desk.addr-path, chr(4)))
     2920         ,input (replace( v-xml-file-name-path, "/", "\" ) + "xml")
     2921         ,input (replace(in_ + spl + "/" + v-xml-file-name, "/", "\" ) + ".xml")
     2922         ,input 30
     2923         ,input   ( if action = 'U'
     2924                     then ('Ждите - ' + 'добавление данных по валютам-оплатам')
     2925                     else ('Ждите - ' + 'удаление данных по валютам-оплатам') ) +
     2926                     substitute("Маг&1 касса&2", for-cash-desk.obj-code, for-cash-desk.cash-num)
     2927         ) no-error .
     2928       if error-status:error
     2929       or return-value = "error" then do:
     2930         run write-log-and-file in p-log-handle (
     2931               input 1
     2932             , input log-file-name
     2933             , input 1
     2934             , input substitute( "!!!Не удалось получить ответ с маг&1 касса &2 об успешной доставке данных:&3&4 &5"
     2935                                   ,for-cash-desk.obj-code
     2936                                   ,for-cash-desk.cash-num
     2937                                   , chr(10)
     2938                                   , error-status:get-message(1)
     2939                                   , return-value
     2940                               )
     2941                                               ).
     2942         assign
     2943         v-view-log = yes
     2944         .
     2945       end.
     2946     end.
     2947     if not available ub.shop then do:
     2948       find first ub.shop no-lock where
     2949                 ub.shop.obj-code = for-cash-desk.obj-code.
     2950     end.
     2951     if
     2952     not (g#news or g#esys)
     2953     then do:
     2954       run str/getxibmf.p (
     2955                       input parparentproc
     2956                     ,input p-log-handle
     2957                     ,input 'маг':U
     2958                     ,input for-cash-desk.obj-code
     2959                     ,input ub.shop.host-code
     2960                     ,input in_
     2961                     ,input spl
     2962                     ,input (in_ + sav)
     2963                     ,input for-cash-desk.pos-type
     2964                     ,input (if (for-cash-desk.pos-type = 'IBM-XML':U
     2965                             and for-cash-desk.autonomy = integer('0':U))
     2966                             or (for-cash-desk.pos-type = 'Autotank':U
     2967                             and for-cash-desk.autonomy = integer('2':U))
     2968                             then "utf-8":U
     2969                             else "windows-1251")
     2970                     ,input log-file-name
     2971                     ,input "data":U
     2972                     ,input v-xml-file-name
     2973                     ,input-output v-view-log
     2974                     ) no-error .
     2975       if error-status:error then do:
     2976         run write-log-and-file in p-log-handle (
     2977               input 1
     2978             , input log-file-name
     2979             , input 1
     2980             , input substitute( "!!!Не удалось получить ответ с маг&1 касса &2 об успешной доставке данных"
     2981                                   ,for-cash-desk.obj-code
     2982                                   ,for-cash-desk.cash-num
     2983                               )
     2984                                               ).
     2985         assign
     2986         v-view-log = yes
     2987         .
     2988       end.
     2989     end.
     2990   end.
     2991   if g#news
     2992   or g#auto
     2993   or g#esys
     2994   and for-cash-desk.pos-type = 'MAGIA-XML':U
     2995   then do:
     2996   end.
     2997     end.
     2998   END CASE.
     2999     END .
     3000   END PROCEDURE.
     3001   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3002   PROCEDURE SENDING:
     3003   DEFINE VARIABLE fq as integer no-undo .
     3004   FOR EACH ub.cash-desk NO-LOCK WHERE
     3005           ub.cash-desk.db-num = g#db-num AND
     3006           ub.cash-desk.cash-on
     3007   BREAK
     3008   By ub.cash-desk.pos-type :
     3009     IF FIRST-OF(ub.cash-desk.pos-type) then do:
     3010   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3011   define variable dflt-cd22 as character no-undo .
     3012   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3013   define variable v-param-type23 as character no-undo .
     3014   define variable v-value-date23 as date no-undo .
     3015   define variable v-value-decimal23 as decimal no-undo .
     3016   define variable v-value-integer23 as INTEGER no-undo .
     3017   define variable v-value-logical23 AS LOGICAL no-undo .
     3018   define variable v-tth23 as handle no-undo .
     3019   run adm/shattri.p (
     3020       input "get":U
     3021       ,input  'маг':U
     3022       ,input  ub.cash-desk.obj-code
     3023       ,input  'cd-sending':U
     3024       ,input  'dflt-cd':U
     3025       ,output dflt-cd22
     3026       ,output v-value-date23
     3027       ,output v-value-decimal23
     3028       ,output v-value-integer23
     3029       ,output v-value-logical23
     3030       ,output v-param-type23
     3031       ,INPUT-OUTPUT table-handle v-tth23
     3032       ) no-error .
     3033   delete object v-tth23 no-error.
     3034   case ub.cash-desk.pos-type:
     3035       when 'MAGIA-XML':U
     3036     then do:
     3037   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3038   run str/get-inis.p (
     3039                   input 'маг':U
     3040                 , input ub.cash-desk.obj-code
     3041                 , input ub.cash-desk.pos-type
     3042                 , input cash-desk.remote
     3043                 , input "send":U
     3044                 , output out
     3045                 , output out2
     3046                 , output in_
     3047                 , output spl
     3048                 , output sav
     3049                 , output v-remote
     3050                 )  no-error .
     3051   if error-status:error then do:
     3052     run write-log-and-file in p-log-handle (
     3053           input 1
     3054         , input log-file-name
     3055         , input 1
     3056         , input substitute("!!!Не удалось получить настройки для  POS типа &1 для маг&2 из ini-файла:&3&4 &5"
     3057                             , ub.cash-desk.pos-type
     3058                             , ub.cash-desk.obj-code
     3059                             , chr(10)
     3060                             , error-status:get-message(1)
     3061                             , return-value )).
     3062     assign
     3063     v-view-log = yes.
     3064     return error.
     3065   end.
     3066   if ub.cash-desk.pos-type = 'IBM-XML':U
     3067   or ub.cash-desk.pos-type = 'Autotank':U
     3068   then do:
     3069     file-info:file-name = (out  + "undelivered").
     3070     if file-info:FULL-PATHNAME <> ? then do:
     3071       run str/rsndxibm.p ( input parparentproc
     3072                           ,input p-parent-handle
     3073                           ,input p-log-handle
     3074                           ,input out  + "undelivered" ) no-error.
     3075     end.
     3076   end.
     3077     end.
     3078   END CASE.
     3079       RUN for-cash-cycle no-error.
     3080     END.
     3081     IF LAST-OF(ub.cash-desk.pos-type) then do:
     3082   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3083   case ub.cash-desk.pos-type:
     3084   END CASE.
     3085     END.
     3086   END.
     3087   END PROCEDURE.
     3088   if action = "D" then do:
     3089     message
     3090     "Вы действительно хотите удалить с кассы записи от типах кассовых платежей?"
     3091     view-as alert-box QUESTION buttons YES-NO update glog.
     3092     if not glog then return.
     3093   end.
     3094   RUN SENDING no-error.
     3095   if error-status:error then return error.
