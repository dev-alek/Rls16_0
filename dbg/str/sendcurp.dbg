     2389         undo, return error return-value .
     2390       end.
     2391       find first buf_cash-pay-attr exclusive-lock
     2392         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
     2393           and buf_cash-pay-attr.curr-code  = p-curr-code
     2394           and buf_cash-pay-attr.host-code  = p-host-code
     2395           and buf_cash-pay-attr.obj-type   = p-obj-type
     2396           and buf_cash-pay-attr.obj-code   = p-obj-code
     2397           and buf_cash-pay-attr.attr-code = p-code
     2398         no-error NO-WAIT.
     2399       if not available buf_cash-pay-attr then do:
     2400         p-deleted = no.
     2401       end.
     2402       else do:
     2403         delete buf_cash-pay-attr no-error .
     2404         if error-status:error then do:
     2405           undo, return error return-value .
     2406         end.
     2407         p-deleted = yes.
     2408       end.
     2409     end.
     2410   end procedure.
     2411   procedure cp-attr-news :
     2412     do
     2413     on error undo, return error
     2414     :
     2415       define input  parameter p-code           as character no-undo .
     2416       define output parameter p-news           as logical   no-undo .
     2417       case p-code :
     2418               when 'paycard-export-prefix':U then do:     assign     p-news = true.   end.
     2419               when 'grp-code':U then do:     assign     p-news = true.   end.
     2420               when 'is-use':U then do:     assign     p-news = true.   end.
     2421               when 'dop-doc':U then do:     assign     p-news = true.   end.
     2422               when 'paycard-all-prefix':U then do:     assign     p-news = true.   end.
     2423               when 'paycard-edit-prefix':U then do:     assign     p-news = true.   end.
     2424               when 'form_km3':U then do:     assign     p-news = false.   end.
     2425               when 'bal_malina':U then do:     assign     p-news = false.   end.
     2426               when 'max_proc_sum':U then do:     assign     p-news = true.   end.
     2427               when 'mask_card_kup':U then do:     assign     p-news = true.   end.
     2428         otherwise do:
     2429           p-news = no.
     2430         end.
     2431       end.
     2432     end.
     2433   end procedure.
