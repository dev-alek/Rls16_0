     1434   procedure alienini-getkey :
     1435   define input parameter i-filename as char.
     1436   define input parameter i-section as char.
     1437   define input parameter i-key as char.
     1438   define output parameter o-value as char.
     1439   define variable EntryPointer as integer no-undo.
     1440   define variable mem1 as memptr no-undo.
     1441   define variable mem2 as memptr no-undo.
     1442   define variable mem1size as integer no-undo.
     1443   define variable mem2size as integer no-undo.
     1444   define variable ii       as integer    no-undo.
     1445   define variable cbReturnSize  as integer    no-undo.
     1446   assign
     1447   set-size(mem1)  = 4000
     1448   mem1size = 4000.
     1449   if i-key = "" then EntryPointer = 0.
     1450   else do:
     1451     assign
     1452     set-size(mem2) = 128
     1453     mem2size = 128
     1454     EntryPointer = get-pointer-value(mem2)
     1455     put-string(mem2, 1) = i-key.
     1456   end.
     1457   run getprivateprofilestringA
     1458                                 (i-section,
     1459                                  EntryPointer,
     1460                                  "",
     1461                                  get-pointer-value(mem1),
     1462                                  input mem1size,
     1463                                  i-filename,
     1464                                  output cbReturnSize).
     1465   do ii = 1 to cbReturnSize:
     1466     o-value = if (get-byte(mem1, ii) = 0 and ii ne cbReturnSize)
     1467                  then o-value + ","
     1468                  else o-value + chr(get-byte(mem1, ii)).
     1469   end.
     1470     set-size(mem1) = 0.
     1471     set-size(mem2) = 0.
     1472   end procedure.
     1473   procedure alienini-putkey :
     1474   define input parameter i-filename as char.
     1475   define input parameter i-section as char.
     1476   define input parameter i-key as char.
     1477   define input parameter i-value as char.
     1478   define variable cbReturnSize as integer.
     1479   run writeprivateprofilestringA
     1480                                  (i-section,
     1481                                   i-key,
     1482                                   i-value,
     1483                                   i-filename,
     1484                                   output cbReturnSize ).
     1485   end procedure.
     1486   PROCEDURE GetPrivateProfileStringA EXTERNAL "kernel32" :
     1487     DEFINE INPUT  PARAMETER lpszSection     AS CHAR.
     1488     DEFINE INPUT  PARAMETER lpszEntry       AS LONG.
     1489     DEFINE INPUT  PARAMETER lpszDefault     AS CHAR.
     1490     DEFINE INPUT  PARAMETER memBuffer       AS LONG.
     1491     DEFINE INPUT  PARAMETER cbReturnBuffer  AS LONG.
     1492     DEFINE INPUT  PARAMETER lpszFilename    AS CHAR.
     1493     DEFINE RETURN PARAMETER cbReturnedChars AS LONG.
     1494   END PROCEDURE.
     1495   PROCEDURE WritePrivateProfileStringA EXTERNAL "kernel32" :
     1496     DEFINE INPUT  PARAMETER lpszSection  AS CHAR.
     1497     DEFINE INPUT  PARAMETER lpszEntry    AS CHAR.
     1498     DEFINE INPUT  PARAMETER lpszString   AS CHAR.
     1499     DEFINE INPUT  PARAMETER lpszFilename AS CHAR.
     1500     DEFINE RETURN PARAMETER lpszValue    AS LONG.
     1501   END PROCEDURE.
