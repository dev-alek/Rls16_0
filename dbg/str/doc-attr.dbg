     1721     OPEN QUERY b-doc-attr FOR EACH ub.doc-attr NO-LOCK       WHERE ub.doc-attr.doc-code = pardoc-code,              first tt-upd-attr where tt-upd-attr.code = ub.doc-attr.attr-code and                                        tt-upd-attr.output-display = yes  by tt-upd-attr.sort                                         .
     1722       apply "VALUE-CHANGED" to b-doc-attr.
