     1746     find first buf_trn-doc no-lock where buf_trn-doc.doc-code = pardoc-code .
     1747     def var is-fuel as logical no-undo.
     1748     def var v-value as character no-undo.
     1749     def var v-type as logical no-undo.
     1750   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     1751                           input 'is-fuel':U ,
     1752                          output v-value ,
     1753                          output v-type ) no-error .
     1754     assign
     1755       is-fuel = yes when v-value = "yes".
     1756     if not is-fuel then do:
     1757   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     1758                           input 'is-lgas':U ,
     1759                          output v-value ,
     1760                          output v-type ) no-error .
     1761       assign
     1762         is-fuel = yes when v-value = "yes".
     1763     end.
     1764     if not is-fuel
     1765     then do:
     1766   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     1767                           input 'is-lgas-corr':U ,
     1768                          output v-value ,
     1769                          output v-type ) no-error .
     1770       assign
     1771         is-fuel = yes when v-value = "yes".
     1772     end.
     1773     v-attr-mandat-wayb = "".
     1774   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1775   empty temp-table thbjattr_thbj-attr.
     1776   run adm/shattri.p (
     1777      input "get":U
     1778     ,input buf_trn-doc.obj-type
     1779     ,input buf_trn-doc.obj-code
     1780     ,input 'nakl_par':U
     1781     ,input  ""
     1782     ,output v-value-character
     1783     ,output v-value-date
     1784     ,output v-value-decimal
     1785     ,output v-value-integer
     1786     ,output v-value-logical
     1787     ,output par-type
     1788     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1789     ) no-error .
     1790     if buf_trn-doc.ext-doc-type = 'ie':U
     1791     then do:
     1792       if is-fuel
     1793       then
     1794         for each thbjattr_thbj-attr :
     1795           if thbjattr_thbj-attr.prop-code = 'attr-PN' then v-attr-mandat-wayb =  thbjattr_thbj-attr.property-value-character .
     1796         end.
     1797       else
     1798         for each thbjattr_thbj-attr :
     1799           if thbjattr_thbj-attr.prop-code = 'attr-mandatory-gds-in-wayb' then v-attr-mandat-wayb =  thbjattr_thbj-attr.property-value-character .
     1800         end.
     1801     end.
     1802     find first bf_doc-line no-lock where bf_doc-line.doc-code = buf_trn-doc.doc-code no-error.
     1803     if available (bf_doc-line)
     1804     then do:
     1805   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1806     (
     1807        input bf_doc-line.artic
     1808     ,  input bf_doc-line.prod-type
     1809     ,  input bf_doc-line.prod-code
     1810     , output varis-petrol
     1811     , output varis-pieces
     1812     ) no-error.
     1813       if error-status :error
     1814       then do:
     1815         undo, return error return-value.
     1816       end.
     1817     end.
     1818     if not (varis-petrol and
     1819       not varis-pieces)
     1820     then do:
     1821       case buf_trn-doc.ext-doc-type:
     1822       when 'ep':U then
     1823         for each thbjattr_thbj-attr :
     1824           if thbjattr_thbj-attr.prop-code = 'attr-mandatory-gds-ret-wayb' then v-attr-mandat-wayb =  thbjattr_thbj-attr.property-value-character .
