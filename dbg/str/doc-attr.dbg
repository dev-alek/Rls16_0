     1843   RUN disable_UI.
     1844   PROCEDURE disable_UI :
     1845     HIDE FRAME Dialog-Frame.
     1846   END PROCEDURE.
     1847   PROCEDURE enable_UI :
     1848     ENABLE b-exit b-help b-doc-attr
     1849         WITH FRAME Dialog-Frame.
     1850     VIEW FRAME Dialog-Frame.
     1851     OPEN QUERY b-doc-attr FOR EACH ub.doc-attr NO-LOCK       WHERE ub.doc-attr.doc-code = pardoc-code,              first tt-upd-attr where tt-upd-attr.code = ub.doc-attr.attr-code and                                        tt-upd-attr.output-display = yes  by tt-upd-attr.sort                                         .
     1852   END PROCEDURE.
     1853   PROCEDURE init-proc :
     1854   define variable v-func-name as character no-undo .
     1855   define variable v-proc-name as character no-undo .
     1856   define variable tt as character no-undo .
     1857   define variable i as integer   no-undo .
     1858    for each ub.doc-attr no-lock      where
     1859             ub.doc-attr.doc-code = pardoc-code,
     1860             first tt-upd-attr where tt-upd-attr.code = ub.doc-attr.attr-code and
     1861                   tt-upd-attr.output-display = yes  :
     1862         repeat i = 1 to 2 :
     1863           tt = entry(1,entry(i,tt-upd-attr.proc-attr) ,"=") no-error .
     1864           if error-status :error then tt = '' .
     1865          if  tt  = 'win'  then v-proc-name = entry(2,entry(i,tt-upd-attr.proc-attr) ,"=") no-error  .
     1866          if  tt  = 'func' then v-func-name = entry(2,entry(i,tt-upd-attr.proc-attr) ,"=") no-error .
     1867          if  tt  = ''     then assign
     1868                                 v-func-name = ''
     1869                                 v-proc-name = ''
     1870                                 tt-upd-attr.proc-attr = ''
     1871                                 .
     1872         end.
     1873         if v-proc-name = ? then v-proc-name = '' .
     1874         if v-func-name = ? then v-func-name = '' .
     1875         tt-upd-attr.proc-win   = v-proc-name .
     1876         tt-upd-attr.proc-func  = v-func-name .
     1877         if v-func-name <> "" then tt-upd-attr.full-screen-val  = dynamic-function ( tt-upd-attr.proc-func , ub.doc-attr.attr-code , ub.doc-attr.attr-value ) .
     1878                              else tt-upd-attr.full-screen-val  = "" .
     1879     end.
     1880   END PROCEDURE.
     1881   PROCEDURE rowdisp :
     1882   do ii = 1 to extent (bcol).
     1883       if valid-handle (bcol[ii])
     1884       then do:
     1885         assign
     1886           bcol[ii]:fgcolor = RED_COLOR when lookup (ub.doc-attr.attr-code, v-attr-mandat-wayb) > 0.
     1887       end.
     1888     end.
     1889   END PROCEDURE.
     1890   PROCEDURE st-attr :
     1891     define variable varattr-code like ub.doc-attr.attr-code no-undo.
     1892     define buffer bf_doc-attr for ub.doc-attr.
     1893     define variable vartemp-char as character no-undo.
     1894     define buffer buf_doc-attr for ub.doc-attr .
     1895     define buffer buf_tt-upd-attr for tt-upd-attr .
     1896     do
     1897     transaction on error undo, return error return-value
     1898     :
     1899       for each buf_tt-upd-attr
     1900       on error undo, return error return-value
     1901       :
     1902         find first buf_doc-attr no-lock
     1903           where buf_doc-attr.doc-code  = pardoc-code
     1904             and buf_doc-attr.attr-code = buf_tt-upd-attr.code
     1905           no-error .
     1906         if available buf_doc-attr
     1907         then do:
     1908           assign
     1909             buf_tt-upd-attr.can-select = false
     1910           .
     1911         end.
     1912         else do:
     1913           assign
     1914             buf_tt-upd-attr.can-select = true
     1915           .
     1916         end.
     1917       end.
     1918       run str/b-attr.w
     1919         (input table tt-upd-attr
     1920         ,output varattr-code
     1921         ) no-error .
     1922       if error-status :error
     1923       then do:
     1924         if return-value <> ""
     1925         then do:
     1926           message
     1927             "Ошибка при выборе добавляемого атрибута."
     1928             view-as alert-box error.
     1929         end.
     1930         undo, return error.
     1931       end.
     1932       find first tt-upd-attr where tt-upd-attr.code = varattr-code no-error.
     1933       if not available tt-upd-attr then do:
     1934         message "Не верно выбран атрибут для добавления." view-as alert-box error.
     1935         undo, return error.
     1936       end.
     1937       if tt-upd-attr.user-can-edit <> yes then do:
     1938         message "Атрибут нельзя добавить в данном интерфейсе." view-as alert-box.
     1939         undo, return error.
     1940       end.
     1941       find first bf_doc-attr where bf_doc-attr.doc-code   = pardoc-code and
     1942                                   bf_doc-attr.attr-code = varattr-code no-lock no-error.
     1943       if available bf_doc-attr then  do:
     1944         message "Атрибут " tt-upd-attr.label-attr " уже есть в документе " pardoc-code " ."
     1945         view-as alert-box error.
     1946         undo, return error.
     1947       end.
     1948       create ub.doc-attr.
     1949       assign
     1950         ub.doc-attr.doc-code   = pardoc-code
     1951         ub.doc-attr.attr-code = varattr-code.
     1952       run gbl/d-prompt.w (
     1953             'title=':u + 'Изменение атрибутов документа' + '\':u
     1954             + 'text1=':u + tt-upd-attr.label-attr + '\':u
     1955             + 'format=' + tt-upd-attr.format-attr + '\':u
     1956             + 'type=' + tt-upd-attr.type-attr + '\':u
     1957             + 'fillin_row=2\':u
     1958             + 'fillin_col=4\':u
     1959             + 'fillin_width=':u  + string(tt-upd-attr.fillin_width) + '\':u
     1960             + 'fillin_height=':u + string(tt-upd-attr.fillin_height) + '\':u
     1961             + 'max-chars=70\':u
     1962             + 'readonly=' + 'no':u + '\':u
     1963             , input-output vartemp-char
     1964             ) no-error.
     1965       if error-status:error then do:
     1966         message "Ошибка при изменении атрибута." skip
     1967                 return-value skip
     1968                 error-status:get-message(1) view-as alert-box error.
     1969         undo, return error.
     1970       end.
     1971       if return-value = 'false':u then do:
     1972         undo, return error.
     1973       end.
     1974   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-wrt in g#trdcalib ( input ub.doc-attr.doc-code ,
     1975                          input ub.doc-attr.attr-code ,
     1976                          input vartemp-char ) no-error .
     1977       if error-status :error then do:
     1978           message "Ошибка при сохранении атрибута." view-as alert-box.
     1979           undo, return error.
     1980         end.
     1981       assign
     1982         varrec-id = recid(ub.doc-attr)
     1983         .
     1984        if not v-no-news  then do:
     1985   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-oth in g#trdcalib ( input ub.doc-attr.doc-code ,
     1986                          input ub.doc-attr.attr-code ,
     1987                          input vartemp-char ) no-error .
     1988             if error-status :error then do:
     1989               message "Ошибка при обработке атрибута." view-as alert-box.
     1990               undo, return no-apply.
     1991             end.
     1992        end.
     1993     end.
     1994   END PROCEDURE.
