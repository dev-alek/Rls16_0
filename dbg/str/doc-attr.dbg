     1826       when 'ee':U then
     1827         for each thbjattr_thbj-attr :
     1828           if thbjattr_thbj-attr.prop-code = 'attr-mandatory-gds-exp-wayb' then v-attr-mandat-wayb =  thbjattr_thbj-attr.property-value-character .
     1829         end.
     1830       end case.
     1831     end.
     1832     run init-proc in this-procedure .
     1833     hbrowse = browse b-doc-attr:handle.
     1834     extent (bcol) = hbrowse:num-columns.
     1835     bcol[1] = hbrowse:first-column.
     1836     do ii = 1 to extent (bcol).
