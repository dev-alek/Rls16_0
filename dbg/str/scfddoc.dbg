        1   DEFINE INPUT PARAMETER pardoc-code LIKE ub.c-trn-doc.doc-code NO-UNDO.
        2   define input parameter parchip-num like ub.c-trn-doc.chip-num no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Экран просмотра платежей по складскому документу".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   DEFINE TEMP-TABLE tt-fo NO-UNDO LIKE ub.fin-ob
      113   FIELD sum-base-trn LIKE ub.fin-ob.sum-base
      114   FIELD sum-rubl-trn LIKE ub.fin-ob.sum-rubl.
      115   DEFINE TEMP-TABLE tt-fd NO-UNDO LIKE ub.fin-doc
      116   FIELD sum-base-fo LIKE ub.fin-doc.sum-base
      117   FIELD sum-rubl-fo LIKE ub.fin-doc.sum-rubl.
      118   define buffer bf_c-trn-doc    for ub.c-trn-doc.
      119   define buffer bf_fin-connect  for ub.fin-connect.
      120   define buffer bf_c-parts      for ub.c-parts.
      121   define buffer bf_fin-gds-part for ub.fin-gds-part.
      122   define buffer bf_goods        for ub.goods.
      123   DEFINE BUTTON b-exit AUTO-GO
      124        LABEL "&Выход"
      125        SIZE 10 BY 1
      126        BGCOLOR 8 .
      127   DEFINE BUTTON b-help
      128        LABEL "&Помощь"
      129        SIZE 10 BY 1
      130        BGCOLOR 8 .
      131   DEFINE QUERY b-fin-doc FOR
      132         tt-fd SCROLLING.
      133   DEFINE QUERY b-fin-ob FOR
      134         tt-fo,
      135         bf_fin-connect SCROLLING.
      136   DEFINE QUERY b-parts FOR
      137         bf_fin-gds-part,
      138         bf_goods,
      139         bf_c-parts SCROLLING.
      140   DEFINE BROWSE b-fin-doc
      141     QUERY b-fin-doc DISPLAY
      142         tt-fd.prn-doc-code  COLUMN-LABEL "Платеж"
      143    tt-fd.contract-code COLUMN-LABEL "Договор"
      144    tt-fd.sum-base FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма платежа (вал)"
      145    tt-fd.sum-base-fo FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма связей c ФО (вал)"
      146    tt-fd.sum-rubl FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма платежа (вал)"
      147    tt-fd.sum-rubl-fo FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма связей С ФО (abbr_rub)"
      148    tt-fd.fin-doc-code COLUMN-LABEL "Вн. код платежа"
      149       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.5 BY 6
      150            TITLE "Платежи".
      151   DEFINE BROWSE b-fin-ob
      152     QUERY b-fin-ob DISPLAY
      153         tt-fo.prn-doc-code COLUMN-LABEL "Фин. обяз."
      154    tt-fo.sum-base FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Общая сумма (вал)"
      155    bf_fin-connect.sum-base FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма связи (вал)"
      156    tt-fo.sum-base-trn FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма по док. (вал)"
      157    tt-fo.sum-rubl FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Общая сумма (abbr_rub)"
      158    bf_fin-connect.sum-rubl FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма связи (abbr_rub)"
      159    tt-fo.sum-rubl-trn FORMAT "->>>,>>>,>>>,>>9.99" COLUMN-LABEL "Сумма по док. (abbr_rub)"
      160    tt-fo.doc-code COLUMN-LABEL "Вн. код. фин. обяз."
      161       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.5 BY 6
      162            TITLE "Финансовые обязательства, связанные с платежом".
      163   DEFINE BROWSE b-parts
      164     QUERY b-parts DISPLAY
      165         bf_c-parts.in-code COLUMN-LABEL "Прих. накл."
      166    bf_c-parts.part-code  FORMAT "x(13)" COLUMN-LABEL "Код партии"
      167    bf_c-parts.fact-qnty  COLUMN-LABEL "Факт кол-во"
      168    bf_c-parts.price-base COLUMN-LABEL "Цена (вал)"
      169    bf_c-parts.price-rubl COLUMN-LABEL "Цена (abbr_rub)"
      170       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.5 BY 6
      171            TITLE "Партии по финансовому обязательству".
      172   DEFINE FRAME Dialog-Frame
      173        b-exit AT ROW 1 COL 1
      174        b-help AT ROW 1 COL 11
      175        b-fin-doc AT ROW 2.25 COL 1
      176        b-fin-ob AT ROW 8.54 COL 1
      177        b-parts AT ROW 14.83 COL 1
      178        SPACE(0.00) SKIP(0.16)
      179       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      180            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      181            TITLE "Платежи, связанные со складским документом"
      182            DEFAULT-BUTTON b-exit.
      183   ASSIGN
      184          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      185          FRAME Dialog-Frame:HIDDEN           = TRUE.
      186   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      187   DO:
      188     APPLY "END-ERROR":U TO SELF.
      189   END.
      190   ON VALUE-CHANGED OF b-fin-doc IN FRAME Dialog-Frame
      191   DO:
      192     RUN open-query-fo IN THIS-PROCEDURE.
      193     RUN open-parts-query IN THIS-PROCEDURE.
      194   END.
      195   ON VALUE-CHANGED OF b-fin-ob IN FRAME Dialog-Frame
      196   DO:
      197     RUN open-parts-query IN THIS-PROCEDURE.
      198   END.
      199   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      200   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      201   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      202   on help of frame Dialog-Frame
      203   do:
      204     run gbl/app_help.p
      205       (input this-procedure :file-name
      206       ,input ''
      207       ,input ?
      208       ) no-error.
      209     if error-status :error then do:
      210       message
      211         "Ошибка при вызове помощи"
      212         error-status :get-message(1)
      213         view-as alert-box .
      214     end.
      215   end.
      216   run minbtn-set in this-procedure .
      217   on choose of b-help in frame Dialog-Frame
      218   do:
      219     apply "help":u to frame Dialog-Frame .
      220   end.
      221   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      222   procedure minbtn-set :
      223       do
      224           on error undo, return error return-value
      225           :
      226           define variable ii              as integer       no-undo .
      227           define variable fh              as widget-handle no-undo .
      228           define variable hh              as widget-handle no-undo .
      229           define variable v-h             as handle        extent 4 no-undo .
      230           define variable v-name-button   as character     no-undo .
      231           define variable v-help-old-x    as decimal       no-undo .
      232           define variable v-help-old-y    as decimal       no-undo .
      233           define variable v-help-old-size as decimal       no-undo .
      234           define variable v-frame-width   as decimal       no-undo .
      235           define variable jj              as integer       no-undo .
      236           do
      237               on error undo, return error
      238               :
      239               assign
      240                   v-frame-width = frame Dialog-Frame:width - 0.3
      241                   fh            = frame Dialog-Frame:first-child
      242                   hh            = fh:first-child
      243                   ii            = 1
      244                   .
      245               do while valid-handle(hh):
      246                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      247                   do:
      248                       case lc(hh:name) :
      249                           when "b-help" then
      250                               do:
      251                                   hh:load-image-up("cmp/b-help.bmp":u) .
      252                                   hh:load-image-down("cmp/b-help.bmp":u) .
      253                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      254                                   hh:TOOLTIP = "Помощь" .
      255                                   v-help-old-x = hh:column .
      256                                   v-help-old-y = hh:row    .
      257                                   v-help-old-size = hh:width .
      258                                   hh:width-chars = 2.5 .
      259                               end.
      260                           when "b-print" then
      261                               do:
      262                                   hh:load-image("cmp/b-print.bmp":u) .
      263                                   hh:TOOLTIP = "Печать" .
      264                                   v-h[ii] = hh:handle .
      265                                   ii = ii + 1 .
      266                                   hh:width-chars = 3 .
      267                               end.
      268                           when "b-history" or
      269                           when "b-hist" then
      270                               do:
      271                                   hh:load-image("cmp/b-hist.bmp":u) .
      272                                   hh:TOOLTIP = "История" .
      273                                   v-h[ii] = hh:handle .
      274                                   ii = ii + 1 .
      275                                   hh:width-chars = 3 .
      276                               end.
      277                           when "b-sch" then
      278                               do:
      279                                   hh:load-image("cmp/b-sch.bmp":u) .
      280                                   hh:TOOLTIP = "Установка Фильтра" .
      281                                   v-h[ii] = hh:handle .
      282                                   ii = ii + 1 .
      283                                   hh:width-chars = 3 .
      284                               end.
      285                           when "b-hist-user" then
      286                               do:
      287                                   hh:load-image("cmp/b-hist.bmp":u) .
      288                                   hh:TOOLTIP = "История пользователя" .
      289                                   ii = ii + 1 .
      290                               end.
      291                       end case.
      292                   end.
      293                   hh = hh:next-sibling.
      294               end.
      295               b-help:column = v-frame-width - b-help:width-chars.
      296               jj = 0.
      297               repeat ii = 4 to 1 by -1 :
      298                   if valid-handle (v-h[ii] ) then
      299                   do:
      300                       jj  = jj + 1 .
      301                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      302                       v-h[ii]:row    = v-help-old-y .
      303                   end.
      304               end.
      305           end.
      306       end.
      307   end procedure.
      308   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      309   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      310   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      311   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      312   define variable v-diasize-current-frame-width  as decimal   no-undo .
      313   define variable v-diasize-current-frame-height as decimal   no-undo .
      314   define variable v-diasize-change-size          as logical   no-undo .
      315   define variable v-diasize-resize-button        as handle    no-undo .
      316   define variable v-diasize-wndmax               as logical   no-undo .
      317   define variable v-diasize-wndstore             as logical   no-undo .
      318   define variable v-diasize-proc-name            as character no-undo .
      319   define variable v-diasize-browse-handle        as handle    no-undo .
      320   define variable v-diasize-browse-number        as integer   no-undo .
      321   define variable v-diasize-need-full-display    as logical   no-undo init false .
      322   define temp-table temp-diasize-handle no-undo
      323     field handle-value  as handle
      324     field save-position as decimal
      325     index xpk is primary unique handle-value
      326     .
      327   define temp-table temp-browse-handle no-undo
      328     field browse-type   as character
      329     field browse-number as integer
      330     field browse-handle as handle
      331     field original-size as decimal
      332     index xpk is primary unique browse-type browse-number
      333     index xie browse-type browse-handle
      334   .
      335   procedure diasize_change-height :
      336     define input  parameter p-change-value  as decimal   no-undo .
      337     define input  parameter p-move-resize   as logical   no-undo .
      338     define variable v-field-group-handle    as handle    no-undo .
      339     define variable v-object-handle         as handle    no-undo .
      340     define variable v-frame-height          as decimal   no-undo .
      341     define variable v-frame-virtual-height  as decimal   no-undo .
      342     define variable v-browse-height         as decimal   no-undo .
      343     define variable v-window-height         as decimal   no-undo .
      344     define variable v-window-virtual-height as decimal   no-undo .
      345     define variable v-change-sign           as integer   no-undo .
      346     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      347     define buffer buf_temp-browse-handle  for temp-browse-handle .
      348     if p-change-value > 0
      349     then do:
      350       if frame Dialog-Frame :height + p-change-value
      351           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      352       then do:
      353         assign
      354           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      355                           - (frame Dialog-Frame :height-chars)
      356         .
      357         if p-change-value <= 0
      358         then do:
      359           run diasize_position-resize-button in this-procedure .
      360           return .
      361         end.
      362       end.
      363     end.
      364     if p-change-value < 0
      365     then do:
      366       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      367       then do:
      368         assign
      369           p-change-value = v-diasize-orig-frame-height
      370                          - (frame Dialog-Frame :height-chars)
      371         .
      372         if p-change-value >= 0
      373         then do:
      374           run diasize_position-resize-button in this-procedure .
      375           return .
      376         end.
      377       end.
      378     end.
      379     if p-change-value >= 0
      380     then do:
      381       assign
      382         v-change-sign = 1
      383       .
      384     end.
      385     else do:
      386       assign
      387         v-change-sign = -1
      388       .
      389     end.
      390     assign
      391       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      392     .
      393     if p-change-value = 0
      394     then do:
      395       run diasize_position-resize-button in this-procedure .
      396       return .
      397     end.
      398     move_block:
      399     do
      400     on error undo move_block, retry move_block
      401     :
      402       if retry
      403       then do:
      404         do
      405         on error undo move_block, leave move_block
      406         :
      407           if p-change-value > 0
      408           then do:
      409             for each buf_temp-diasize-handle
      410             on error undo, next
      411             :
      412               assign
      413                 v-object-handle = buf_temp-diasize-handle.handle-value
      414               .
      415               if v-object-handle <> v-diasize-resize-button
      416               then do:
      417                 assign
      418                   v-object-handle :row = buf_temp-diasize-handle.save-position
      419                 .
      420               end.
      421             end.
      422             assign
      423               v-diasize-browse-handle :height = v-browse-height
      424             .
      425             for each buf_temp-browse-handle
      426               where buf_temp-browse-handle.browse-type = 'height':u
      427             on error undo, next
      428             :
      429               assign
      430                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      431               .
      432             end.
      433             assign
      434               frame Dialog-Frame :height = v-frame-height
      435             .
      436             if frame Dialog-Frame :scrollable = true
      437             then do:
      438               assign
      439                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      440               .
      441             end.
      442             run diasize_position-resize-button in this-procedure .
      443           end.
      444           else do:
      445             if frame Dialog-Frame :scrollable = true
      446             then do:
      447               assign
      448                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      449               .
      450             end.
      451             assign
      452               frame Dialog-Frame :height = v-frame-height
      453             .
      454             assign
      455               v-diasize-browse-handle :height = v-browse-height
      456             .
      457             for each buf_temp-browse-handle
      458               where buf_temp-browse-handle.browse-type = 'height':u
      459             on error undo, next
      460             :
      461               assign
      462                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      463               .
      464             end.
      465             for each buf_temp-diasize-handle
      466             on error undo, next
      467             :
      468               assign
      469                 v-object-handle = buf_temp-diasize-handle.handle-value
      470               .
      471               if v-object-handle <> v-diasize-resize-button
      472               then do:
      473                 assign
      474                   v-object-handle :row = buf_temp-diasize-handle.save-position
      475                 .
      476               end.
      477             end.
      478             run diasize_position-resize-button in this-procedure .
      479           end.
      480           assign
      481             v-diasize-change-size = false
      482           .
      483           leave move_block .
      484         end.
      485       end.
      486       assign
      487         v-diasize-need-full-display = true
      488       .
      489       if v-diasize-change-size = false
      490       then do:
      491         assign
      492           v-diasize-change-size = true
      493         .
      494       end.
      495       else do:
      496         return .
      497       end.
      498       assign
      499         v-frame-height = frame Dialog-Frame :height
      500         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      501         v-browse-height = v-diasize-browse-handle :height
      502       .
      503       for each buf_temp-browse-handle
      504         where buf_temp-browse-handle.browse-type = 'height':u
      505       :
      506         assign
      507           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      508         .
      509       end.
      510       for each buf_temp-diasize-handle
      511       :
      512         delete buf_temp-diasize-handle .
      513       end.
      514       assign
      515         v-field-group-handle = frame Dialog-Frame :first-child
      516       .
      517       do while valid-handle(v-field-group-handle)
      518       :
      519         assign
      520           v-object-handle = v-field-group-handle :first-child
      521         .
      522         do while valid-handle(v-object-handle)
      523         :
      524           if  v-object-handle <> v-diasize-browse-handle :handle
      525           and can-query(v-object-handle, "row")
      526           and can-query(v-object-handle, "height")
      527           and ( v-object-handle :row > v-diasize-browse-handle :row )
      528           then do:
      529             find first buf_temp-browse-handle
      530               where buf_temp-browse-handle.browse-type   = 'height':u
      531                 and buf_temp-browse-handle.browse-handle = v-object-handle
      532               no-error .
      533             if available buf_temp-browse-handle
      534             then do:
      535             end.
      536             else do:
      537               create buf_temp-diasize-handle .
      538               assign
      539                 buf_temp-diasize-handle.handle-value  = v-object-handle
      540                 buf_temp-diasize-handle.save-position = v-object-handle :row
      541               .
      542             end.
      543           end.
      544           assign
      545             v-object-handle = v-object-handle :next-sibling
      546           .
      547         end.
      548         assign
      549           v-field-group-handle = v-field-group-handle :next-sibling
      550         .
      551       end.
      552       do with frame Dialog-Frame
      553       :
      554         hide v-diasize-resize-button .
      555         assign
      556           v-diasize-resize-button :row    = 1
      557           v-diasize-resize-button :column = 1
      558         .
      559       end.
      560       if p-change-value > 0
      561       then do:
      562         if frame Dialog-Frame :scrollable = true
      563         then do:
      564           assign
      565             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      566             no-error .
      567           if error-status :error
      568           or error-status :get-message(1) <> ""
      569           then do:
      570             undo move_block, retry move_block .
      571           end.
      572         end.
      573         assign
      574           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      575           no-error .
      576         if error-status :error
      577         or error-status :get-message(1) <> ""
      578         then do:
      579           undo move_block, retry move_block .
      580         end.
      581         assign
      582           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      583           no-error .
      584         if error-status :error
      585         or error-status :get-message(1) <> ""
      586         then do:
      587           undo move_block, retry move_block .
      588         end.
      589         for each buf_temp-browse-handle
      590           where buf_temp-browse-handle.browse-type = 'height':u
      591         on error undo move_block, retry move_block
      592         :
      593           assign
      594             buf_temp-browse-handle.browse-handle :height
      595               = buf_temp-browse-handle.browse-handle :height + p-change-value
      596             no-error .
      597           if error-status :error
      598           or error-status :get-message(1) <> ""
      599           then do:
      600             undo move_block, retry move_block .
      601           end.
      602         end.
      603         for each buf_temp-diasize-handle
      604         on error undo move_block, retry move_block
      605         :
      606           assign
      607             v-object-handle = buf_temp-diasize-handle.handle-value
      608           .
      609           if v-object-handle <> v-diasize-resize-button
      610           then do:
      611             assign
      612               v-object-handle :row = v-object-handle :row + p-change-value
      613               no-error .
      614             if error-status :error
      615             or error-status :get-message(1) <> ""
      616             then do:
      617               undo move_block, retry move_block .
      618             end.
      619           end.
      620         end.
      621       end.
      622       else do:
      623         for each buf_temp-diasize-handle
      624         on error undo move_block, retry move_block
      625         :
      626           assign
      627             v-object-handle = buf_temp-diasize-handle.handle-value
      628           .
      629           if v-object-handle <> v-diasize-resize-button
      630           then do:
      631             assign
      632               v-object-handle :row = v-object-handle :row + p-change-value
      633               no-error .
      634             if error-status :error
      635             or error-status :get-message(1) <> ""
      636             then do:
      637               undo move_block, retry move_block .
      638             end.
      639           end.
      640         end.
      641         assign
      642           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      643           no-error .
      644         if error-status :error
      645         or error-status :get-message(1) <> ""
      646         then do:
      647           undo move_block, retry move_block .
      648         end.
      649         for each buf_temp-browse-handle
      650           where buf_temp-browse-handle.browse-type = 'height':u
      651         on error undo move_block, retry move_block
      652         :
      653           assign
      654             buf_temp-browse-handle.browse-handle :height
      655               = buf_temp-browse-handle.browse-handle :height + p-change-value
      656             no-error .
      657           if error-status :error
      658           or error-status :get-message(1) <> ""
      659           then do:
      660             undo move_block, retry move_block .
      661           end.
      662         end.
      663         assign
      664           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      665           no-error .
      666         if error-status :error
      667         or error-status :get-message(1) <> ""
      668         then do:
      669           undo move_block, retry move_block .
      670         end.
      671         if frame Dialog-Frame :scrollable = true
      672         then do:
      673           assign
      674             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      675             no-error .
      676           if error-status :error
      677           or error-status :get-message(1) <> ""
      678           then do:
      679             undo move_block, retry move_block .
      680           end.
      681         end.
      682       end.
      683       if p-move-resize = true
      684       then do:
      685         run diasize_position-resize-button in this-procedure .
      686       end.
      687       if v-diasize-wndstore = true
      688       then do:
      689         if connected("ub") = true
      690         then do:
      691           define variable v-cntxt-db-num        as integer   no-undo .
      692           define variable v-cntxt-userid        as character no-undo .
      693           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      694                                             , OUTPUT v-cntxt-userid
      695                                             ) .
      696           run gbl/wndsizew.p
      697             (input  v-cntxt-db-num
      698             ,input  v-cntxt-userid
      699             ,input  v-diasize-proc-name
      700             ,input  'height':u
      701             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      702             ) .
      703         end.
      704       end.
      705     end.
      706     assign
      707       v-diasize-change-size = false
      708     .
      709   end procedure.
      710   procedure diasize_set-height :
      711     define input  parameter p-new-height  as decimal   no-undo .
      712     define input  parameter p-move-resize as logical   no-undo .
      713     do
      714     on error undo, return error return-value
      715     :
      716       run diasize_change-height in this-procedure
      717         (input  (p-new-height - frame Dialog-Frame :height)
      718         ,input  p-move-resize
      719         ) .
      720     end.
      721   end procedure.
      722   procedure diasize_change-width :
      723     define input  parameter p-change-value as decimal   no-undo .
      724     define input  parameter p-move-resize  as logical   no-undo .
      725     define variable v-field-group-handle   as handle    no-undo .
      726     define variable v-object-handle        as handle    no-undo .
      727     define variable v-frame-width          as decimal   no-undo .
      728     define variable v-frame-virtual-width  as decimal   no-undo .
      729     define variable v-browse-width         as decimal   no-undo .
      730     define variable v-window-width         as decimal   no-undo .
      731     define variable v-window-virtual-width as decimal   no-undo .
      732     define variable v-change-sign          as integer   no-undo .
      733     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      734     define buffer buf_temp-browse-handle  for temp-browse-handle .
      735     if p-change-value > 0
      736     then do:
      737       if frame Dialog-Frame :width + p-change-value >
      738           session :width-chars
      739       then do:
      740         assign
      741           p-change-value = session :width-chars - frame Dialog-Frame :width
      742         .
      743         if p-change-value <= 0
      744         then do:
      745           run diasize_position-resize-button in this-procedure .
      746           return .
      747         end.
      748       end.
      749     end.
      750     if p-change-value < 0
      751     then do:
      752       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      753       then do:
      754         assign
      755           p-change-value = v-diasize-orig-frame-width
      756                          - frame Dialog-Frame :width
      757         .
      758         if p-change-value >= 0
      759         then do:
      760           run diasize_position-resize-button in this-procedure .
      761           return .
      762         end.
      763       end.
      764     end.
      765     if p-change-value >= 0
      766     then do:
      767       assign
      768         v-change-sign = 1
      769       .
      770     end.
      771     else do:
      772       assign
      773         v-change-sign = -1
      774       .
      775     end.
      776     assign
      777       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      778     .
      779     if p-change-value = 0
      780     then do:
      781       run diasize_position-resize-button in this-procedure .
      782       return .
      783     end.
      784     move_block:
      785     do
      786     on error undo move_block, leave move_block
      787     :
      788       if retry
      789       then do:
      790         do
      791         on error undo move_block, leave move_block
      792         :
      793           if p-change-value > 0
      794           then do:
      795             for each buf_temp-diasize-handle
      796             on error undo, next
      797             :
      798               assign
      799                 v-object-handle = buf_temp-diasize-handle.handle-value
      800               .
      801               if v-object-handle <> v-diasize-resize-button
      802               then do:
      803                 assign
      804                   v-object-handle :col = buf_temp-diasize-handle.save-position
      805                 .
      806               end.
      807             end.
      808             assign
      809               v-diasize-browse-handle :width = v-browse-width
      810             .
      811             for each buf_temp-browse-handle
      812               where buf_temp-browse-handle.browse-type = 'width':u
      813             on error undo, next
      814             :
      815               assign
      816                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      817               .
      818             end.
      819             assign
      820               frame Dialog-Frame :width = v-frame-width
      821             .
      822             if frame Dialog-Frame :scrollable = true
      823             then do:
      824               assign
      825                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      826               .
      827             end.
      828             run diasize_position-resize-button in this-procedure .
      829           end.
      830           else do:
      831             if frame Dialog-Frame :scrollable = true
      832             then do:
      833               assign
      834                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
      835               .
      836             end.
      837             assign
      838               frame Dialog-Frame :width = v-frame-width
      839             .
      840             for each buf_temp-browse-handle
      841               where buf_temp-browse-handle.browse-type = 'width':u
      842             on error undo, next
      843             :
      844               assign
      845                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      846               .
      847             end.
      848             assign
      849               v-diasize-browse-handle :width = v-browse-width
      850             .
      851             for each buf_temp-diasize-handle
      852             on error undo, next
      853             :
      854               assign
      855                 v-object-handle = buf_temp-diasize-handle.handle-value
      856               .
      857               if v-object-handle <> v-diasize-resize-button
      858               then do:
      859                 assign
      860                   v-object-handle :col = buf_temp-diasize-handle.save-position
      861                 .
      862               end.
      863             end.
      864             run diasize_position-resize-button in this-procedure .
      865           end.
      866           assign
      867             v-diasize-change-size = false
      868           .
      869           leave move_block .
      870         end.
      871       end.
      872       assign
      873         v-diasize-need-full-display = true
      874       .
      875       if v-diasize-change-size = false
      876       then do:
      877         assign
      878           v-diasize-change-size = true
      879         .
      880       end.
      881       else do:
      882         return .
      883       end.
      884       assign
      885         v-frame-width = frame Dialog-Frame :width
      886         v-frame-virtual-width = frame Dialog-Frame :virtual-width
      887         v-browse-width = v-diasize-browse-handle :width
      888       .
      889       for each buf_temp-browse-handle
      890         where buf_temp-browse-handle.browse-type = 'width':u
      891       :
      892         assign
      893           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      894         .
      895       end.
      896       for each buf_temp-diasize-handle
      897       :
      898         delete buf_temp-diasize-handle .
      899       end.
      900       assign
      901         v-field-group-handle = frame Dialog-Frame :first-child
      902       .
      903       do while valid-handle(v-field-group-handle)
      904       :
      905         assign
      906           v-object-handle = v-field-group-handle :first-child
      907         .
      908         do while valid-handle(v-object-handle)
      909         :
      910           if  v-object-handle <> v-diasize-browse-handle :handle
      911           and v-object-handle <> v-diasize-resize-button
      912           and can-query(v-object-handle, "row")
      913           and can-query(v-object-handle, "height")
      914           and ( v-object-handle :col + v-object-handle :width
      915                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      916               )
      917           then do:
      918             find first buf_temp-browse-handle
      919               where buf_temp-browse-handle.browse-type   = 'width':u
      920                 and buf_temp-browse-handle.browse-handle = v-object-handle
      921               no-error .
      922             if available buf_temp-browse-handle
      923             then do:
      924             end.
      925             else do:
      926               create buf_temp-diasize-handle .
      927               assign
      928                 buf_temp-diasize-handle.handle-value  = v-object-handle
      929                 buf_temp-diasize-handle.save-position = v-object-handle :col
      930               .
      931             end.
      932           end.
      933           assign
      934             v-object-handle = v-object-handle :next-sibling
      935           .
      936         end.
      937         assign
      938           v-field-group-handle = v-field-group-handle :next-sibling
      939         .
      940       end.
      941       do with frame Dialog-Frame
      942       :
      943         hide v-diasize-resize-button .
      944         v-diasize-resize-button :row = 1.
      945         v-diasize-resize-button :column = 1.
      946       end.
      947       if p-change-value > 0
      948       then do:
      949         if frame Dialog-Frame :scrollable = true
      950         then do:
      951           assign
      952             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
      953             no-error .
      954           if error-status :error
      955           or error-status :get-message(1) <> ""
      956           then do:
      957             undo move_block, retry move_block.
      958           end.
      959         end.
      960         assign
      961           frame Dialog-Frame :width = v-frame-width + p-change-value
      962           no-error .
      963         if error-status :error
      964         or error-status :get-message(1) <> ""
      965         then do:
      966           undo move_block, retry move_block.
      967         end.
      968         assign
      969           v-diasize-browse-handle :width = v-browse-width + p-change-value
      970         no-error .
      971         if error-status :error
      972         or error-status :get-message(1) <> ""
      973         then do:
      974           undo move_block, retry move_block.
      975         end.
      976         for each buf_temp-browse-handle
      977           where buf_temp-browse-handle.browse-type = 'width':u
      978         on error undo move_block, retry move_block
      979         :
      980           assign
      981             buf_temp-browse-handle.browse-handle :width
      982               = buf_temp-browse-handle.browse-handle :width + p-change-value
      983             no-error .
      984           if error-status :error
      985           or error-status :get-message(1) <> ""
      986           then do:
      987             undo move_block, retry move_block .
      988           end.
      989         end.
      990         for each buf_temp-diasize-handle
      991         on error undo move_block, retry move_block
      992         :
      993           assign
      994             v-object-handle = buf_temp-diasize-handle.handle-value
      995           .
      996           if v-object-handle <> v-diasize-resize-button
      997           then do:
      998             assign
      999               v-object-handle :col = v-object-handle :col + p-change-value
     1000               no-error .
     1001             if error-status :error
     1002             or error-status :get-message(1) <> ""
     1003             then do:
     1004               undo move_block, retry move_block .
     1005             end.
     1006           end.
     1007         end.
     1008       end.
     1009       else do:
     1010         for each buf_temp-diasize-handle
     1011         on error undo move_block, retry move_block
     1012         :
     1013           assign
     1014             v-object-handle = buf_temp-diasize-handle.handle-value
     1015           .
     1016           if v-object-handle <> v-diasize-resize-button
     1017           then do:
     1018             assign
     1019               v-object-handle :col = v-object-handle :col + p-change-value
     1020               no-error .
     1021             if error-status :error
     1022             or error-status :get-message(1) <> ""
     1023             then do:
     1024               undo move_block, retry move_block .
     1025             end.
     1026           end.
     1027         end.
     1028         for each buf_temp-browse-handle
     1029           where buf_temp-browse-handle.browse-type = 'width':u
     1030         on error undo move_block, retry move_block
     1031         :
     1032           assign
     1033             buf_temp-browse-handle.browse-handle :width
     1034               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1035             no-error .
     1036           if error-status :error
     1037           or error-status :get-message(1) <> ""
     1038           then do:
     1039             undo move_block, retry move_block .
     1040           end.
     1041         end.
     1042         assign
     1043           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1044           no-error .
     1045         if error-status :error
     1046         or error-status :get-message(1) <> ""
     1047         then do:
     1048           undo move_block, retry move_block.
     1049         end.
     1050         assign
     1051           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1052         no-error .
     1053         if error-status :error
     1054         or error-status :get-message(1) <> ""
     1055         then do:
     1056           undo move_block, retry move_block.
     1057         end.
     1058         if frame Dialog-Frame :scrollable = true
     1059         then do:
     1060           assign
     1061             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1062           no-error .
     1063           if error-status :error
     1064           or error-status :get-message(1) <> ""
     1065           then do:
     1066             undo move_block, retry move_block.
     1067           end.
     1068         end.
     1069       end.
     1070       if p-move-resize
     1071       then do:
     1072         run diasize_position-resize-button in this-procedure .
     1073       end.
     1074       if v-diasize-wndstore = true
     1075       then do:
     1076         if connected("ub") = true
     1077         then do:
     1078           define variable v-cntxt-db-num        as integer   no-undo .
     1079           define variable v-cntxt-userid        as character no-undo .
     1080           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1081                                             , OUTPUT v-cntxt-userid
     1082                                             ) .
     1083           run gbl/wndsizew.p
     1084             (input  v-cntxt-db-num
     1085             ,input  v-cntxt-userid
     1086             ,input  v-diasize-proc-name
     1087             ,input  'width':u
     1088             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1089             ) .
     1090         end.
     1091       end.
     1092     end.
     1093     assign
     1094       v-diasize-change-size = false
     1095     .
     1096   end procedure.
     1097   procedure diasize_set-width :
     1098     define input  parameter p-new-width  as decimal   no-undo .
     1099     define input  parameter p-move-resize as logical   no-undo .
     1100     do
     1101     on error undo, return error return-value
     1102     :
     1103       run diasize_change-width in this-procedure
     1104         (input  (p-new-width - frame Dialog-Frame :width)
     1105         ,input  p-move-resize
     1106         ) .
     1107     end.
     1108   end procedure.
     1109   procedure diasize_position-resize-button :
     1110     do with frame Dialog-Frame
     1111     :
     1112       hide v-diasize-resize-button .
     1113       assign
     1114         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1115                     - 1
     1116                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1117         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1118                     - 1
     1119                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1120       .
     1121       view v-diasize-resize-button .
     1122     end.
     1123   end procedure.
     1124   on alt-right anywhere
     1125   do:
     1126     run diasize_change-width in this-procedure
     1127       (input 1
     1128       ,input true
     1129       ) .
     1130     return no-apply .
     1131   end.
     1132   on alt-left anywhere
     1133   do:
     1134     run diasize_change-width in this-procedure
     1135       (input -1
     1136       ,input true
     1137       ) .
     1138     return no-apply .
     1139   end.
     1140   on alt-down anywhere
     1141   do:
     1142     run diasize_change-height in this-procedure
     1143       (input 1
     1144       ,input true
     1145       ) .
     1146     return no-apply .
     1147   end.
     1148   on alt-up anywhere
     1149   do:
     1150     run diasize_change-height in this-procedure
     1151       (input -1
     1152       ,input true
     1153       ) .
     1154     return no-apply .
     1155   end.
     1156   on alt-enter of frame Dialog-Frame
     1157   do:
     1158     run diasize_maximize in this-procedure
     1159       (input  ?
     1160       ).
     1161     return no-apply .
     1162   end.
     1163   procedure diasize_end-move :
     1164     do
     1165     on error undo, return error return-value
     1166     :
     1167       define variable v-row-delta as decimal   no-undo .
     1168       define variable v-col-delta as decimal   no-undo .
     1169       define variable v-new-row as decimal   no-undo .
     1170       define variable v-new-col as decimal   no-undo .
     1171       assign
     1172         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1173         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1174       .
     1175       assign
     1176         v-row-delta = v-new-row - frame Dialog-Frame :height
     1177         v-col-delta = v-new-col - frame Dialog-Frame :width
     1178       .
     1179       run diasize_change-height in this-procedure
     1180         (input v-row-delta
     1181         ,input true
     1182         ) .
     1183       run diasize_change-width in this-procedure
     1184         (input v-col-delta
     1185         ,input true
     1186         ) .
     1187     end.
     1188   end procedure.
     1189   procedure diasize_maximize :
     1190     define input  parameter p-action as logical   no-undo .
     1191     do
     1192     on error undo, return error return-value
     1193     :
     1194       if p-action = ?
     1195       then do:
     1196         if v-diasize-need-maximize = true
     1197         then do:
     1198           assign
     1199             p-action = true
     1200           .
     1201         end.
     1202         else do:
     1203           assign
     1204             p-action = false
     1205           .
     1206         end.
     1207       end.
     1208       if p-action = true
     1209       then do:
     1210         run diasize_change-height in this-procedure
     1211           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1212               - frame Dialog-Frame :height-chars
     1213           ,input true
     1214           ) .
     1215         run diasize_change-width in this-procedure
     1216           (input session :width-chars
     1217               - frame Dialog-Frame :width-chars
     1218           ,input true
     1219           ) .
     1220         assign
     1221           v-diasize-need-maximize = false
     1222         .
     1223       end.
     1224       else do:
     1225         run diasize_change-width in this-procedure
     1226           (input v-diasize-orig-frame-width
     1227               - frame Dialog-Frame :width-chars
     1228           ,input true
     1229           ) .
     1230         run diasize_change-height in this-procedure
     1231           (input v-diasize-orig-frame-height
     1232               - frame Dialog-Frame :height-chars
     1233           ,input true
     1234           ) .
     1235         assign
     1236           v-diasize-need-maximize = true
     1237         .
     1238       end.
     1239     end.
     1240   end procedure.
     1241   procedure diasize_restore-orig-size :
     1242     do
     1243     on error undo, return error return-value
     1244     :
     1245       assign
     1246         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1247         v-diasize-current-frame-height = frame Dialog-Frame :height
     1248       .
     1249       run diasize_set-height in this-procedure
     1250         (input  v-diasize-orig-frame-height
     1251         ,input  true
     1252         ) .
     1253       run diasize_set-width in this-procedure
     1254         (input  v-diasize-orig-frame-width
     1255         ,input  true
     1256         ) .
     1257     end.
     1258   end procedure.
     1259   procedure diasize_restore-current-size :
     1260     do
     1261     on error undo, return error return-value
     1262     :
     1263       run diasize_set-height in this-procedure
     1264         (input  v-diasize-current-frame-height
     1265         ,input  true
     1266         ) .
     1267       run diasize_set-width in this-procedure
     1268         (input  v-diasize-current-frame-width
     1269         ,input  true
     1270         ) .
     1271     end.
     1272   end procedure.
     1273   procedure diasize_set-browse-handle :
     1274     define input  parameter p-browse-handle as handle   no-undo .
     1275     define buffer buf_temp-browse-handle for temp-browse-handle .
     1276     do
     1277     on error undo, return error return-value
     1278     :
     1279       assign
     1280         v-diasize-browse-handle = p-browse-handle
     1281       .
     1282       for each buf_temp-browse-handle
     1283       on error undo, return error return-value
     1284       :
     1285         delete buf_temp-browse-handle .
     1286       end.
     1287     end.
     1288   end procedure.
     1289   procedure diasize_add_browse :
     1290     define input  parameter p-browse-type   as character no-undo .
     1291     define input  parameter p-browse-handle as handle    no-undo .
     1292     define buffer buf_temp-browse-handle for temp-browse-handle .
     1293     do
     1294     on error undo, return error return-value
     1295     :
     1296       assign
     1297         v-diasize-browse-number = v-diasize-browse-number + 1
     1298       .
     1299       create buf_temp-browse-handle .
     1300       assign
     1301         buf_temp-browse-handle.browse-type   = p-browse-type
     1302         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1303         buf_temp-browse-handle.browse-handle = p-browse-handle
     1304       .
     1305     end.
     1306   end procedure.
     1307   procedure diasize_init :
     1308     define variable v-default-value    as logical   no-undo .
     1309     define variable v-restore-saved    as logical   no-undo .
     1310     define variable v-resize-value-str as character no-undo .
     1311     do
     1312     on error undo, return error return-value
     1313     :
     1314       do with frame Dialog-Frame
     1315       :
     1316         assign
     1317           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1318           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1319           v-diasize-browse-handle     = browse b-fin-doc :handle
     1320         .
     1321         create button v-diasize-resize-button
     1322         assign
     1323           parent        = frame Dialog-Frame :first-child
     1324           label         = "s"
     1325           height-pixels = 16
     1326           width-pixels  = 16
     1327           visible       = true
     1328           sensitive     = true
     1329           movable       = true
     1330           triggers:
     1331             on end-move persistent run diasize_end-move in this-procedure .
     1332           end triggers.
     1333         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1334         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1335         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1336         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1337         assign
     1338           v-diasize-wndmax = false
     1339         .
     1340         if connected("ub") = true
     1341         then do:
     1342           define variable v-cntxt-db-num        as integer   no-undo .
     1343           define variable v-cntxt-userid        as character no-undo .
     1344           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1345                                             , OUTPUT v-cntxt-userid
     1346                                             ) .
     1347           run gbl/wndpar_r.p
     1348             (input  v-cntxt-db-num
     1349             ,input  v-cntxt-userid
     1350             ,input  'wndmax':U
     1351             ,output v-diasize-wndmax
     1352             ,output v-default-value
     1353             ) .
     1354         end.
     1355         assign
     1356           v-diasize-wndstore = false
     1357         .
     1358         if connected("ub") = true
     1359         then do:
     1360           run gbl/wndpar_r.p
     1361             (input  v-cntxt-db-num
     1362             ,input  v-cntxt-userid
     1363             ,input  'wndstore':U
     1364             ,output v-diasize-wndstore
     1365             ,output v-default-value
     1366             ) .
     1367         end.
     1368         assign
     1369           v-diasize-proc-name = entry(1, program-name(2), '.')
     1370         .
     1371         if v-diasize-wndstore = true
     1372         then do:
     1373           assign
     1374             v-restore-saved = false
     1375           .
     1376           if connected("ub") = true
     1377           then do:
     1378             run gbl/wndsizer.p
     1379               (input  v-cntxt-db-num
     1380               ,input  v-cntxt-userid
     1381               ,input  v-diasize-proc-name
     1382               ,input  'height':u
     1383               ,output v-resize-value-str
     1384               ) .
     1385             if v-resize-value-str <> '':U
     1386             then do:
     1387               run diasize_change-height in this-procedure
     1388                 (input  integer(v-resize-value-str)
     1389                 ,input  true
     1390                 ) .
     1391               assign
     1392                 v-restore-saved = true
     1393               .
     1394             end.
     1395           end.
     1396           if connected("ub") = true
     1397           then do:
     1398             run gbl/wndsizer.p
     1399               (input  v-cntxt-db-num
     1400               ,input  v-cntxt-userid
     1401               ,input  v-diasize-proc-name
     1402               ,input  'width':u
     1403               ,output v-resize-value-str
     1404               ) .
     1405             if v-resize-value-str <> '':U
     1406             then do:
     1407               run diasize_change-width in this-procedure
     1408                 (input  integer(v-resize-value-str)
     1409                 ,input  true
     1410                 ) .
     1411               assign
     1412                 v-restore-saved = true
     1413               .
     1414             end.
     1415           end.
     1416           if v-restore-saved <> true
     1417           then do:
     1418             if v-diasize-wndmax = true
     1419             then do:
     1420               run diasize_maximize in this-procedure
     1421                 (input  true
     1422                 ) .
     1423             end.
     1424           end.
     1425         end.
     1426         else do:
     1427           if v-diasize-wndmax = true
     1428           then do:
     1429             run diasize_maximize in this-procedure
     1430               (input  true
     1431               ) .
     1432           end.
     1433         end.
     1434       end.
     1435     end.
     1436   end procedure.
     1437   procedure diasize_need-full-display :
     1438     define output parameter p-need-full-display as logical   no-undo .
     1439     do
     1440     on error undo, return error return-value
     1441     :
     1442       assign
     1443         p-need-full-display = v-diasize-need-full-display
     1444       .
     1445       assign
     1446         v-diasize-need-full-display = false
     1447       .
     1448     end.
     1449   end procedure.
     1450   procedure get-context :
     1451      define output parameter p-db-num as integer          no-undo.
     1452      define output parameter p-user-id as character        no-undo.
     1453      define variable v-login               as character    no-undo.
     1454      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1455      define buffer buf_user-login  for ub.user-login .
     1456      do
     1457      on error undo, return error
     1458      :
     1459            FIND FIRST buf_sys-ctrl no-lock.
     1460            ASSIGN
     1461               v-login = USERID("ub")
     1462               p-db-num = buf_sys-ctrl.db-num
     1463            .
     1464            FIND FIRST buf_user-login
     1465                 WHERE buf_user-login.db-num = p-db-num
     1466                   AND buf_user-login.user-login = v-login
     1467                 no-lock
     1468                 no-error
     1469                 .
     1470            IF AVAILABLE buf_user-login
     1471            THEN DO:
     1472               assign
     1473                  p-user-id = buf_user-login.user-id
     1474               .
     1475            END.
     1476      end.
     1477   end procedure.
     1478       run diasize_init in this-procedure .
     1479   MAIN-BLOCK:
     1480   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1481      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1482     ASSIGN FRAME
     1483       Dialog-Frame:TITLE = "Платежи по удаленному складскому документу " + pardoc-code.
     1484     FIND FIRST bf_c-trn-doc WHERE bf_c-trn-doc.doc-code = pardoc-code and
     1485                                   bf_c-trn-doc.chip-num = parchip-num NO-LOCK.
     1486     RUN cr-tt-fd IN THIS-PROCEDURE.
     1487     assign
     1488     tt-fd.sum-rubl-fo:label       in browse b-fin-doc = "Сумма связей С ФО (руб)"
     1489     tt-fo.sum-rubl:label          in browse b-fin-ob  = "Общая сумма (руб)"
     1490     bf_fin-connect.sum-rubl:label in browse b-fin-ob  = "Сумма связи (руб)"
     1491     tt-fo.sum-rubl-trn:label      in browse b-fin-ob  = "Сумма по док. (руб)"
     1492     bf_c-parts.price-rubl:label   in browse b-parts   = "Цена (руб)"
     1493     .
     1494     RUN enable_UI.
     1495     OPEN QUERY b-fin-doc FOR EACH tt-fd.
     1496     RUN open-query-fo IN THIS-PROCEDURE.
     1497     RUN open-parts-query IN THIS-PROCEDURE.
     1498     WAIT-FOR GO OF FRAME Dialog-Frame.
     1499   END.
     1500   RUN disable_UI.
     1501   PROCEDURE cr-tt-fd :
     1502   DEFINE BUFFER bf_fin-gds-part FOR ub.fin-gds-part.
     1503   DEFINE BUFFER bf_fin-ob       FOR ub.fin-ob.
     1504   DEFINE BUFFER bf_fin-connect  FOR ub.fin-connect.
     1505   DEFINE BUFFER bf_fin-doc      FOR ub.fin-doc.
     1506   do on error undo, return error return-value :
     1507   FOR EACH bf_fin-gds-part WHERE bf_fin-gds-part.obj-type = bf_c-trn-doc.obj-type AND
     1508                                  bf_fin-gds-part.obj-code = bf_c-trn-doc.obj-code AND
     1509                                  bf_fin-gds-part.out-code = bf_c-trn-doc.doc-code NO-LOCK ON ERROR UNDO, RETURN ERROR RETURN-VALUE :
     1510     FIND FIRST bf_fin-ob WHERE bf_fin-ob.host-code = bf_fin-gds-part.host-code AND
     1511                                bf_fin-ob.doc-code  = bf_fin-gds-part.fin-ob-code NO-LOCK no-error.
     1512     if available bf_fin-ob then do:
     1513       FIND FIRST tt-fo WHERE tt-fo.host-code = bf_fin-ob.host-code AND
     1514                              tt-fo.doc-code  = bf_fin-ob.doc-code NO-ERROR.
     1515       IF NOT AVAILABLE tt-fo THEN DO:
     1516         CREATE tt-fo.
     1517         BUFFER-COPY bf_fin-ob TO tt-fo.
     1518       END.
     1519       ASSIGN
     1520         tt-fo.sum-base-trn = tt-fo.sum-base-trn + bf_fin-gds-part.sum-base
     1521         tt-fo.sum-rubl-trn = tt-fo.sum-rubl-trn + bf_fin-gds-part.sum-rubl.
     1522     end.
     1523   END.
     1524   FOR EACH tt-fo ON ERROR UNDO, RETURN ERROR RETURN-VALUE :
     1525     FOR EACH bf_fin-connect WHERE bf_fin-connect.host-code   = tt-fo.host-code AND
     1526                                   bf_fin-connect.fin-ob-code = tt-fo.doc-code  NO-LOCK ON ERROR UNDO, RETURN ERROR RETURN-VALUE :
     1527       FIND FIRST bf_fin-doc WHERE bf_fin-doc.host-code    = bf_fin-connect.host-code    AND
     1528                                   bf_fin-doc.fin-doc-code = bf_fin-connect.fin-doc-code NO-LOCK.
     1529       FIND FIRST tt-fd WHERE tt-fd.host-code    = bf_fin-connect.host-code     AND
     1530                              tt-fd.fin-doc-code = bf_fin-connect.fin-doc-code NO-ERROR.
     1531       IF NOT AVAILABLE tt-fd THEN DO:
     1532         CREATE tt-fd.
     1533         BUFFER-COPY bf_fin-doc TO tt-fd.
     1534       END.
     1535       ASSIGN
     1536         tt-fd.sum-base-fo = tt-fd.sum-base-fo + bf_fin-connect.sum-base
     1537         tt-fd.sum-rubl-fo = tt-fd.sum-rubl-fo + bf_fin-connect.sum-rubl .
     1538     END.
     1539   END.
     1540   END.
     1541   END PROCEDURE.
     1542   PROCEDURE disable_UI :
     1543     HIDE FRAME Dialog-Frame.
     1544   END PROCEDURE.
     1545   PROCEDURE enable_UI :
     1546     ENABLE b-exit b-help b-fin-doc b-fin-ob b-parts
     1547         WITH FRAME Dialog-Frame.
     1548     VIEW FRAME Dialog-Frame.
     1549   END PROCEDURE.
     1550   PROCEDURE open-parts-query :
     1551   IF AVAILABLE tt-fo THEN DO:
     1552       OPEN QUERY b-parts
     1553           FOR EACH bf_fin-gds-part WHERE bf_fin-gds-part.host-code = tt-fo.host-code AND
     1554                                          bf_fin-gds-part.fin-ob-code = tt-fo.doc-code AND
     1555                                           bf_fin-gds-part.out-code = pardoc-code NO-LOCK,
     1556           first bf_goods where bf_goods.gds-code     = bf_fin-gds-part.gds-code no-lock,
     1557           FIRST bf_c-parts WHERE bf_c-parts.obj-type = bf_fin-gds-part.obj-type AND
     1558                                  bf_c-parts.obj-code   = bf_fin-gds-part.obj-code AND
     1559                                  bf_c-parts.artic      = bf_goods.artic AND
     1560                                  bf_c-parts.prod-type  = bf_goods.prod-type AND
     1561                                  bf_c-parts.prod-code  = bf_goods.prod-code AND
     1562                                  bf_c-parts.in-code    = bf_fin-gds-part.in-code   AND
     1563                                  bf_c-parts.out-code   = bf_fin-gds-part.out-code  AND
     1564                                  bf_c-parts.chip-num   = parchip-num               and
     1565                                  bf_c-parts.part-code  = bf_fin-gds-part.part-code NO-LOCK.
     1566       DISPLAY b-parts WITH FRAME Dialog-Frame.
     1567   END.
     1568   END PROCEDURE.
     1569   PROCEDURE open-query-fo :
     1570   IF AVAILABLE tt-fd THEN DO:
     1571     OPEN QUERY b-fin-ob FOR EACH tt-fo,
     1572         FIRST bf_fin-connect WHERE bf_fin-connect.host-code    = tt-fo.host-code AND
     1573                                    bf_fin-connect.fin-ob-code = tt-fo.doc-code  AND
     1574                                    bf_fin-connect.fin-doc-code = tt-fd.fin-doc-code NO-LOCK.
     1575     DISPLAY b-fin-ob WITH FRAME Dialog-Frame.
     1576   END.
     1577   END PROCEDURE.
