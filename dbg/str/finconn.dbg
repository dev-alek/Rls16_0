        1   define input  parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
        2   define input  parameter p-host-code    as integer   no-undo .
        3   define input  parameter p-doc-type     as character no-undo .
        4   define input  parameter p-doc          as character no-undo .
        5   define input  parameter p-doc-num      as character no-undo .
        6   def var vss-revision    as character no-undo init "$Revision$":u .
        7   def var vss-author      as character no-undo init "$Author$":u .
        8   def var vss-date        as character no-undo init "$Date$":u .
        9   def var vss-workfile    as character no-undo init "$Workfile$":u .
       10   def var vss-archive     as character no-undo init "$Archive$":u .
       11   def var vss-description as character no-undo init "Связи фин. обязательств и платежей" .
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      116   define variable c-point  as character no-undo .
      117   define variable tbl      as character no-undo .
      118   define variable join-tbl as character no-undo .
      119   define variable fld      as character no-undo .
      120   define variable lab      as character no-undo .
      121   define variable spr      as character no-undo .
      122   define variable dim      as character no-undo .
      123   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      124   procedure fltfield-clear :
      125     define output parameter loc-fld as character no-undo.
      126     define output parameter loc-lab as character no-undo .
      127     define output parameter loc-spr as character no-undo .
      128     define output parameter loc-dim as character no-undo .
      129     assign
      130       loc-fld = ""
      131       loc-lab = ""
      132       loc-spr = ""
      133       loc-dim = "0"
      134     .
      135   end procedure .
      136   procedure fltfield-add :
      137     define input        parameter par-fld as character no-undo.
      138     define input        parameter par-lab as character no-undo .
      139     define input        parameter par-spr as character no-undo .
      140     define input-output parameter loc-fld as character no-undo.
      141     define input-output parameter loc-lab as character no-undo .
      142     define input-output parameter loc-spr as character no-undo .
      143     define input-output parameter loc-dim as character no-undo .
      144     do
      145     on error undo, return error
      146     :
      147       assign
      148       loc-fld = if loc-dim = '0'
      149                 then par-fld
      150                 else (loc-fld + chr(44) + par-fld)
      151       loc-lab = if loc-dim = '0'
      152                 then par-lab
      153                 else (loc-lab + chr(44) + par-lab)
      154       loc-spr = if loc-dim = '0'
      155                 then par-spr
      156                 else (loc-spr + chr(44) + par-spr)
      157       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      158                 string(integer(if num-entries(loc-dim) > 1
      159                               then entry(2, loc-dim)
      160                               else entry(1, loc-dim)
      161                               ) + 1)
      162       no-error
      163       .
      164     end.
      165   end procedure.
      166   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      167   define variable v-waitfram-action01         as character   no-undo .
      168   define variable v-waitfram-action02         as character   no-undo .
      169   define variable v-waitfram-action03         as character   no-undo .
      170   define variable mWaitFramTextBeg            as character   no-undo.
      171   define variable mWaitFramTextEnd            as character   no-undo.
      172   define variable mWaitFramView               as logical     no-undo.
      173   define variable mWaitProcEvent              as logical     no-undo init yes.
      174   define variable mWaitFramInterval           as integer     no-undo init 1 .
      175   define variable mWaitFramStop               as logical     no-undo.
      176   define variable mWaitFramStopUser           as logical     no-undo.
      177   define variable mWaitFramStopTimeOut        as logical     no-undo.
      178   define variable mWaitFramStartProc          as datetime-tz no-undo.
      179   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      180   define button B-WaitFramStop auto-end-key
      181        label "Стоп"
      182        size 10 by 1 tooltip "Остоновить процесс".
      183   define button B-viewProcInfo
      184        label "Информация"
      185        size 15 by 1 tooltip "Информация о процесс".
      186   define frame waitfram
      187     v-waitfram-action01 format "x(72)" no-label skip
      188     v-waitfram-action02 format "x(72)" no-label skip
      189     v-waitfram-action03 format "x(72)" no-label skip
      190     B-viewProcInfo
      191     B-WaitFramStop at row 4 col 30
      192     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      193     .
      194   define new global shared variable mBatchMode as logical no-undo init ?.
      195   define variable mFramBachModHandle as handle no-undo.
      196   mFramBachModHandle = frame waitfram:handle.
      197   define variable mFameOldVis as logical no-undo.
      198   define variable mVisCUrentVin as logical no-undo.
      199   if session:batch-mode
      200   then
      201      mBatchMode = yes.
      202   if mBatchMode = ? then do:
      203     mVisCUrentVin = current-window:visible.
      204     mFameOldVis = mFramBachModHandle:visible.
      205     mFramBachModHandle:visible  = yes.
      206     mBatchMode = mFramBachModHandle:visible ne yes.
      207     mFramBachModHandle:visible = mFameOldVis.
      208     current-window:visible = mVisCUrentVin.
      209   end.
      210    if  log-manager:logfile-name ne ?
      211     then DO:
      212         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      213         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      214         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      215     end.
      216   on choose of B-WaitFramStop in frame waitfram
      217   do:
      218     mWaitFramStop = yes.
      219     mWaitFramStopUser = yes.
      220   end.
      221   function waitfram-check-timeout returns logical():
      222      define variable vtime as int64 no-undo.
      223      if mWaitFramStopTimeOut
      224      then
      225         return yes.
      226      vtime = ( now - mWaitFramStartProc ) / 1000 .
      227      if     mWaitFramTimeOut ne ?
      228         and mWaitFramTimeOut ne 0
      229         and mWaitFramTimeOut lt vtime
      230      then do:
      231         mWaitFramStopTimeOut = yes.
      232      end.
      233      return mWaitFramStopTimeOut.
      234   end.
      235   procedure waitfram-hide :
      236     if not session:batch-mode
      237     then do
      238     on error undo, return error return-value
      239     :
      240       pause 0 before-hide .
      241       if not mBatchMode then
      242         hide frame waitfram .
      243     if     not mWaitFramView
      244        and mWaitProcEvent
      245     then
      246       process events .
      247     end.
      248   end procedure.
      249   procedure waitfram-show :
      250     define input  parameter p-message as character no-undo .
      251     define variable v-left-margin as integer   no-undo .
      252     if not session:batch-mode
      253     then do
      254     on error undo, return error return-value
      255     :
      256       if length(p-message) <= 70 then do:
      257         assign
      258           v-left-margin = integer((70 - length(p-message)) / 2)
      259         .
      260         assign
      261           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      262         .
      263         assign
      264           v-waitfram-action01 = " "
      265           v-waitfram-action02 = " "
      266                                    + fill(" ", v-left-margin)
      267                                    + p-message
      268           v-waitfram-action03 = " "
      269         .
      270       end.
      271       else do:
      272         define variable vRindex1 as integer no-undo.
      273         define variable vRindex2 as integer no-undo.
      274         vRindex1 = r-index(p-message," ",70).
      275         if vRindex1 = 0
      276         then
      277            vRindex1 = 70.
      278         if length(p-message)  <= vRindex1 + 70 then do:
      279           assign
      280             v-waitfram-action01 = " "
      281             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      282             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      283           .
      284         end.
      285         else do:
      286           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      287           if vRindex2 <= vRindex1
      288           then
      289              vRindex2 = vRindex1 + 70.
      290           assign
      291             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      292             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      293             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      294           .
      295         end.
      296       end.
      297       B-viewProcInfo:visible   in frame waitfram = no.
      298       B-viewProcInfo:sensitive in frame waitfram = no.
      299       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      300       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      301       if  (   mWaitFramView
      302          or  mWaitProcEvent)
      303          and not mBatchMode
      304       then
      305          display
      306             v-waitfram-action01 skip
      307             v-waitfram-action02 skip
      308             v-waitfram-action03 skip
      309          with frame waitfram .
      310       if     mWaitFramView
      311          then do:
      312             if     mWaitFramInterval ne ?
      313                and not mBatchMode
      314             then
      315                wait-for go of frame waitfram pause mWaitFramInterval.
      316          end.
      317          else
      318             if     mWaitProcEvent
      319                and not mBatchMode
      320             then
      321                process events .
      322     end.
      323   end procedure.
      324      procedure waitfram-show-this:
      325         define input  parameter iInterval as int64 no-undo.
      326         define variable vtime as int64 no-undo.
      327         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      328         mWaitFramInterval = iInterval.
      329         run waitfram-show (substitute("&1&2 &3&4" ,
      330                                       mWaitFramTextBeg ,
      331                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      332                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      333                                       mWaitFramTextEnd
      334                                      )
      335                           ).
      336      end.
      337      procedure WaitFramRunPause:
      338         define input  parameter iInterval as dec no-undo.
      339         define variable vStart  as datetime-tz no-undo.
      340         define variable vend    as datetime-tz no-undo.
      341         define variable vint as int64 no-undo.
      342         define variable vOk as logical no-undo.
      343         vStart = now.
      344         vend   = vStart.
      345         publish "WaitFramPause" (iInterval,output vOk).
      346         vend   =  now.
      347         vint = vend - vStart.
      348         vint = iInterval - vint / 1000.
      349         if     not mWaitFramStop
      350            and (   vint > 0
      351                 or (    not vOk
      352                     and iInterval eq ?
      353                     )
      354                 )
      355         then
      356            run waitfram-show-this (iInterval).
      357         vend   =  now.
      358         vint = vend - vStart.
      359         vint = iInterval - vint / 1000.
      360         if     not mWaitFramStop
      361            and vint > 0
      362         then do:
      363            run gbl/pause.p (vint * 1000).
      364         end.
      365         if iInterval ne ?
      366         then
      367            publish "WaitFramStop".
      368         waitfram-check-timeout().
      369      end.
      370      procedure WaitFramWaitFor:
      371         define input  parameter iInterval as dec no-undo.
      372         assign
      373            mWaitFramStartProc   = now
      374            mWaitFramStopUser    = no
      375            mWaitFramStopTimeOut = no
      376         .
      377         block-wait:
      378         do while not mWaitFramStop:
      379            run WaitFramRunPause (iInterval).
      380            if  waitfram-check-timeout()
      381            then do:
      382               leave block-wait.
      383            end.
      384         end.
      385         run waitfram-hide.
      386      end.
      387   procedure waitfram-join :
      388     define input  parameter p-line-1  as character no-undo .
      389     define input  parameter p-line-2  as character no-undo .
      390     define input  parameter p-line-3  as character no-undo .
      391     define output parameter p-message as character no-undo .
      392     do
      393     on error undo, return error return-value
      394     :
      395       assign
      396         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      397                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      398                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      399       .
      400     end.
      401   end procedure.
      402   function waitfram-join-function returns character
      403     (input p-line-1 as character
      404     ,input p-line-2 as character
      405     ,input p-line-3 as character
      406     ).
      407     define variable v-message as character no-undo .
      408     run waitfram-join in this-procedure
      409       (input  p-line-1
      410       ,input  p-line-2
      411       ,input  p-line-3
      412       ,output v-message
      413       ) .
      414     return v-message .
      415   end function .
      416   define new global shared variable g#library  as handle no-undo .
      417   define new global shared variable g#library2 as handle no-undo .
      418   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      419     define variable v-cntxt-db-num        as integer   no-undo .
      420     define variable v-cntxt-userid        as character no-undo .
      421     define variable v-cntxt-level         as character no-undo .
      422     define variable v-cntxt-host-code-obj as integer   no-undo .
      423     define variable v-cntxt-obj-type      as character no-undo .
      424     define variable v-cntxt-obj-code      as integer   no-undo .
      425     define variable v-cntxt-db-num-obj    as integer   no-undo .
      426     define variable v-cntxt-is-admin      as logical   no-undo .
      427   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      428   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      429   procedure fltopend_fltopend :
      430   define input parameter p-parent-handle as handle no-undo .
      431   define input parameter p-qh as handle no-undo .
      432   define input parameter p-flt-open-open-query  as character no-undo .
      433   define input parameter p-where-cond as character no-undo .
      434   define input parameter p-use-indFIRST-query-tail as character no-undo .
      435   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      436   define input parameter p-indexed-reposition as character no-undo .
      437     do
      438     on error undo, return error
      439     :
      440   define variable v-prepare-string as character no-undo .
      441   define variable glog as logical no-undo .
      442   assign
      443   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      444                      p-where-cond + chr(32)  +
      445                      p-use-indFIRST-query-tail + chr(32) +
      446                      p-use-ind-sort-clmn-by + chr(32) +
      447                      p-indexed-reposition
      448   .
      449   assign
      450   glog = p-qh:query-prepare(v-prepare-string) no-error .
      451   if not glog
      452   or error-status:error then do:
      453     message error-status:get-message(1) view-as alert-box .
      454     undo, return error .
      455   end.
      456   assign
      457   glog = p-qh:query-open no-error .
      458   if not glog
      459   or error-status:error then do:
      460     message error-status:get-message(1) view-as alert-box .
      461     undo, return error .
      462   end.
      463     end.
      464   end procedure.
      465   procedure fltopend_fltfindd :
      466   define input parameter p-parent-handle as handle no-undo .
      467   define input parameter p-qh as handle no-undo .
      468   define input parameter p-rowid as rowid no-undo .
      469   define input parameter p-next as logical no-undo .
      470   define input parameter p-lock as integer no-undo .
      471   define input parameter p-bh as handle no-undo .
      472   define input parameter p-where-cond as character no-undo .
      473   define input parameter p-use-index-phrase as character no-undo .
      474   define variable glog as logical no-undo .
      475   define variable v-qh as handle no-undo .
      476   define variable v-bh as handle no-undo .
      477   define variable v-recid as recid no-undo .
      478   define variable v-prepare-string as character no-undo .
      479   do
      480   on error undo, return error
      481   on stop undo, return error
      482   :
      483     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      484     create buffer v-bh for table p-bh buffer-name p-bh:name.
      485     create query v-qh.
      486     v-qh:set-buffers(v-bh).
      487     v-prepare-string = substitute("for each &1 &2 &3"
      488                                     ,v-bh:name
      489                                     ,p-where-cond
      490                                     ,p-use-index-phrase).
      491     glog = v-qh:query-prepare(v-prepare-string) no-error.
      492     if not glog then do:
      493       delete object v-qh.
      494       delete object v-bh.
      495       undo, return error .
      496     end.
      497     glog = v-qh:query-open no-error .
      498     if not glog then do:
      499       delete object v-qh.
      500       delete object v-bh.
      501       undo, return error .
      502     end.
      503     if p-next then do:
      504       v-qh:reposition-to-rowid(p-rowid) no-error .
      505       glog = v-qh:get-next( p-lock) no-error .
      506       glog = v-qh:get-next( p-lock) no-error .
      507       if not glog or v-qh:query-off-end = yes then do:
      508         glog = v-qh:get-first( p-lock) no-error .
      509       end.
      510     end.
      511     else do:
      512       glog = v-qh:get-first( p-lock) no-error .
      513     end.
      514     v-recid = v-bh:recid no-error .
      515     delete object v-qh.
      516     delete object v-bh.
      517     return string(v-recid) .
      518   end.
      519   end procedure.
      520   procedure fltopend_fltfindq :
      521   define input parameter p-parent-handle as handle no-undo .
      522   define input parameter p-qh as handle no-undo .
      523   define input parameter p-next as logical no-undo .
      524   define input parameter p-lock as integer no-undo .
      525   define input parameter p-flt-open-open-query  as character no-undo .
      526   define input parameter p-where-cond as character no-undo .
      527   define input parameter p-use-indFIRST-query-tail as character no-undo .
      528   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      529   define input parameter p-indexed-reposition as character no-undo .
      530   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      531   define variable glog as logical no-undo .
      532   define variable v-qh as handle no-undo .
      533   define variable v-bh as handle no-undo extent 18.
      534   define variable v-rowid as rowid no-undo extent 18.
      535   define variable v-ii as integer no-undo .
      536   define variable v-prepare-string as character no-undo .
      537   do
      538   on error undo, return error
      539   on stop undo, return error
      540   :
      541     create query v-qh.
      542     do v-ii = 1 to p-qh:num-buffers:
      543       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      544       assign
      545       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      546       no-error.
      547       v-qh:add-buffer(v-bh[v-ii]).
      548     end.
      549     assign
      550     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      551                       p-where-cond + chr(32)  +
      552                       p-use-indFIRST-query-tail + chr(32) +
      553                       p-use-ind-sort-clmn-by + chr(32) +
      554                       p-indexed-reposition
      555     .
      556     glog = v-qh:query-prepare( v-prepare-string) no-error .
      557     if not glog then do:
      558       delete object v-qh.
      559       do v-ii = 1 to p-qh:num-buffers:
      560         delete object v-bh[v-ii].
      561       end.
      562       undo, return error .
      563     end.
      564     glog = v-qh:query-open no-error .
      565     if not glog then do:
      566       delete object v-qh.
      567       do v-ii = 1 to p-qh:num-buffers:
      568         delete object v-bh[v-ii].
      569       end.
      570       undo, return error .
      571     end.
      572     if p-next then do:
      573       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      574       glog = v-qh:get-next( p-lock) no-error .
      575       glog = v-qh:get-next( p-lock) no-error .
      576       if not glog or v-qh:query-off-end = yes then do:
      577         glog = v-qh:get-first( p-lock) no-error .
      578       end.
      579     end.
      580     else do:
      581       glog = v-qh:get-first( p-lock) no-error .
      582     end.
      583     do v-ii = 1 to p-qh:num-buffers:
      584       assign
      585       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      586       no-error.
      587     end.
      588     delete object v-qh.
      589     do v-ii = 1 to p-qh:num-buffers:
      590       delete object v-bh[v-ii].
      591     end.
      592   end.
      593   end procedure.
      594   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      595   function usrfulnf returns character ( input p-user-id as character):
      596   define variable v-user-name as character no-undo .
      597   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      598   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      599     (input  p-user-id
      600     ,output v-user-name
      601     ) no-error .
      602   if error-status:error
      603   or v-user-name = ""
      604   then do:
      605     return p-user-id.
      606   end.
      607   else do:
      608     return v-user-name.
      609   end.
      610   end function.
      611     define buffer buf_fin-connect  for ub.fin-connect .
      612     define buffer buf_fin-ob       for ub.fin-ob .
      613     define buffer buf_fin-doc      for ub.fin-doc .
      614     define buffer buf_contract     for ub.contract .
      615     define variable cont-list        as character no-undo .
      616     define variable g-log            as logical   no-undo .
      617     define variable v-doc-rec        as recid no-undo .
      618     define variable sort-column-name as character no-undo .
      619     define variable filter-point as character no-undo init "Связи фин. обязательств и платежей" .
      620     define variable filter-point0 as character no-undo init "Связи фин. обязательств и платежей" .
      621     define variable num as integer initial 0 no-undo .
      622     DEFINE temp-table temp-conn no-undo
      623       field   ri             as  recid
      624       INDEX pi  IS PRIMARY   ri
      625     .
      626   FUNCTION mark-string RETURNS CHARACTER
      627     ( input par-recid as recid )  FORWARD.
      628   DEFINE BUTTON B-del
      629        LABEL "&Удалить"
      630        SIZE 10 BY 1.
      631   DEFINE BUTTON B-Help
      632        LABEL "Помо&щь"
      633        SIZE 10 BY 1
      634        BGCOLOR 8 .
      635   DEFINE BUTTON B-mark
      636        LABEL "&*"
      637        SIZE 3 BY 1.
      638   DEFINE BUTTON b-quit AUTO-END-KEY
      639        LABEL "&Выход"
      640        SIZE 10 BY 1
      641        BGCOLOR 8 .
      642   DEFINE BUTTON b-sch
      643        LABEL "&Фильтр"
      644        SIZE 10 BY 1.
      645   DEFINE BUTTON B-view-doc
      646        LABEL "&Платеж"
      647        SIZE 10 BY 1.
      648   DEFINE BUTTON B-view-fo
      649        LABEL "Фин.о&бяз."
      650        SIZE 10 BY 1.
      651   DEFINE VARIABLE mark-num AS INTEGER FORMAT ">>>>9":U INITIAL 0
      652         VIEW-AS TEXT
      653        SIZE 7 BY 1 NO-UNDO.
      654   DEFINE VARIABLE sch-code AS INTEGER FORMAT ">>>>>>>>9" INITIAL 0
      655        LABEL "Вн. &номер"
      656        VIEW-AS FILL-IN
      657        SIZE 8.88 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
      658   DEFINE VARIABLE sch-date AS DATE FORMAT "99/99/99"
      659        LABEL "&Дата связи"
      660        VIEW-AS FILL-IN
      661        SIZE 9.13 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
      662   DEFINE VARIABLE sch-user AS CHARACTER FORMAT "X(14)"
      663        LABEL "&Польз."
      664        VIEW-AS FILL-IN
      665        SIZE 8.88 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
      666   DEFINE VARIABLE RADIO-find-doc AS INTEGER
      667        VIEW-AS RADIO-SET HORIZONTAL
      668        RADIO-BUTTONS
      669             "Фин.обяз.", 1,
      670   "Платеж", 2
      671        SIZE 23.25 BY 1 NO-UNDO.
      672   DEFINE VARIABLE Sel-Contr AS CHARACTER INITIAL "all"
      673        VIEW-AS RADIO-SET HORIZONTAL
      674        RADIO-BUTTONS
      675             "Все", "all",
      676   "Выбор", "sel"
      677        SIZE 14 BY 1 NO-UNDO.
      678   DEFINE QUERY Conn-List FOR buf_fin-connect, buf_fin-ob, buf_fin-doc, buf_contract SCROLLING.
      679   DEFINE BROWSE Conn-List
      680     QUERY Conn-List DISPLAY
      681         mark-string(recid(buf_fin-connect))    COLUMN-LABEL '*'  FORMAT "x(1)"
      682        buf_fin-connect.fact-date    COLUMN-LABEL 'Дата'  Format "99/99/99"
      683        string(buf_fin-connect.fact-time,'HH:MM')    COLUMN-LABEL 'Время'  Format "x(5)"
      684        usrfulnf(buf_fin-connect.user-name)    COLUMN-LABEL 'Связал'  Format "x(8)"
      685        buf_fin-ob.prn-doc-code    COLUMN-LABEL '№ фин.об.'  format "x(12)"
      686        buf_fin-ob.pay-date    COLUMN-LABEL 'Дата ф.об.'  format "99/99/99"
      687        buf_fin-connect.fin-ob-code   COLUMN-LABEL 'вн.н. ф.об.'
      688        buf_fin-doc.prn-doc-code    COLUMN-LABEL '№ платежа'  Format "x(8)"
      689        buf_fin-doc.doc-date    COLUMN-LABEL 'Дата плат.'  Format "99/99/99"
      690        buf_fin-connect.fin-doc-code   COLUMN-LABEL 'вн.н. пл.'
      691        buf_fin-connect.sum-contr   COLUMN-LABEL 'Сумма в вал.дог.' Format "->,>>>,>>>,>>9.99"
      692        buf_fin-connect.sum-rubl    COLUMN-LABEL 'Сумма в рубл.'  Format "->,>>>,>>>,>>9.99"
      693        buf_fin-connect.sum-base    COLUMN-LABEL 'Сумма в Б.вал.'  format "->,>>>,>>>,>>9.99"
      694        buf_contract.contract-prn-code   COLUMN-LABEL 'Договор' Format "x(14)"
      695        buf_contract.contract-date   COLUMN-LABEL 'Дата дог.' Format "99/99/99"
      696        buf_fin-connect.connect-code   COLUMN-LABEL 'Вн.N'
      697        (if buf_fin-ob.obj-code = 0 then '' else (buf_fin-ob.obj-type + ' ' + string(buf_fin-ob.obj-code)))   COLUMN-LABEL 'Объект' Format "x(14)"
      698        enable buf_fin-connect.fact-date
      699       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.13 BY 20.17.
      700   DEFINE FRAME Dialog-Frame
      701        b-quit AT ROW 1 COL 1
      702        B-mark AT ROW 1 COL 11
      703        B-del AT ROW 1 COL 21
      704        b-sch AT ROW 1 COL 31
      705        B-view-fo AT ROW 1 COL 41
      706        B-view-doc AT ROW 1 COL 51
      707        Sel-Contr AT ROW 1 COL 72.38 NO-LABEL
      708        B-Help AT ROW 1 COL 88
      709        Conn-List AT ROW 2.08 COL 1.25
      710        sch-date AT ROW 22.42 COL 18.75 COLON-ALIGNED
      711        sch-user AT ROW 22.42 COL 36.25 COLON-ALIGNED
      712        sch-code AT ROW 22.42 COL 63.63 COLON-ALIGNED
      713        RADIO-find-doc AT ROW 22.42 COL 74.75 NO-LABEL
      714        mark-num AT ROW 1 COL 14 NO-LABEL
      715        "Договоры:" VIEW-AS TEXT
      716             SIZE 9.5 BY 1 AT ROW 1 COL 62.5
      717             FGCOLOR 4
      718        "Поиск:" VIEW-AS TEXT
      719             SIZE 6.63 BY 1 AT ROW 22.42 COL 1.25
      720             FGCOLOR 4
      721        SPACE(90.61) SKIP(0.04)
      722       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      723            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      724            TITLE "Связи фин. обязательств и платежей"
      725            DEFAULT-BUTTON b-quit CANCEL-BUTTON b-quit.
      726   ASSIGN
      727          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      728          FRAME Dialog-Frame:HIDDEN           = TRUE.
      729   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      730   DO:
      731     APPLY "END-ERROR":U TO SELF.
      732   END.
      733   ON CHOOSE OF B-del IN FRAME Dialog-Frame
      734   DO:
      735     define variable is-con as logical   no-undo .
      736     if num < 1 then do:
      737       if available buf_fin-connect then do:
      738         message "Вы действительно хотите удалить выбранную связь?"  view-as alert-box QUESTION BUTTONS YES-NO UPDATE is-con .
      739         if is-con = no then return no-apply.
      740         do transaction :
      741           find first ub.fin-connect exclusive-lock where recid(ub.fin-connect) = recid(buf_fin-connect) .
      742           find first ub.fin-ob      exclusive-lock where ub.fin-ob.host-code = ub.fin-connect.host-code and ub.fin-ob.doc-code = ub.fin-connect.fin-ob-code .
      743           assign
      744             ub.fin-ob.con-sum-rubl  = ub.fin-ob.con-sum-rubl  - ub.fin-connect.sum-rubl
      745             ub.fin-ob.con-sum-base  = ub.fin-ob.con-sum-base  - ub.fin-connect.sum-base
      746             ub.fin-ob.con-sum-doc   = ub.fin-ob.con-sum-doc   - ub.fin-connect.sum-doc
      747             ub.fin-ob.con-sum-contr = ub.fin-ob.con-sum-contr - ub.fin-connect.sum-contr
      748           .
      749           if ub.fin-ob.con-sum-contr = 0 then assign ub.fin-ob.con-stat = 0 .
      750           else                             assign ub.fin-ob.con-stat = 1 .
      751           find first ub.fin-doc      exclusive-lock where ub.fin-doc.host-code = ub.fin-connect.host-code and ub.fin-doc.fin-doc-code = ub.fin-connect.fin-doc-code .
      752           if   ub.fin-doc.fin-doc-type = 'рпп':U
      753             or ub.fin-doc.fin-doc-type = 'рко':U
      754             or ub.fin-doc.fin-doc-type = 'апр':U then do:
      755             assign
      756               ub.fin-doc.con-sum-rubl  = ub.fin-doc.con-sum-rubl  - ub.fin-connect.sum-rubl
      757               ub.fin-doc.con-sum-base  = ub.fin-doc.con-sum-base  - ub.fin-connect.sum-base
      758               ub.fin-doc.con-sum-doc   = ub.fin-doc.con-sum-doc   - ub.fin-connect.sum-doc
      759               ub.fin-doc.con-sum-contr = ub.fin-doc.con-sum-contr - ub.fin-connect.sum-contr
      760             .
      761           end.
      762           else do:
      763             assign
      764               ub.fin-doc.con-sum-rubl  = ub.fin-doc.con-sum-rubl  + ub.fin-connect.sum-rubl
      765               ub.fin-doc.con-sum-base  = ub.fin-doc.con-sum-base  + ub.fin-connect.sum-base
      766               ub.fin-doc.con-sum-doc   = ub.fin-doc.con-sum-doc   + ub.fin-connect.sum-doc
      767               ub.fin-doc.con-sum-contr = ub.fin-doc.con-sum-contr + ub.fin-connect.sum-contr
      768             .
      769           end.
      770           if ub.fin-doc.con-sum-contr = 0 then assign ub.fin-doc.con-stat = 0 .
      771           else                              assign ub.fin-doc.con-stat = 1 .
      772           delete ub.fin-connect .
      773         end.
      774       end.
      775       else do:
      776         message  "Нет выбранных связей!"  view-as alert-box.
      777         return no-apply.
      778       end.
      779     end.
      780     else do:
      781       message "Вы действительно хотите удалить выбранные связи?"  view-as alert-box QUESTION BUTTONS YES-NO UPDATE is-con .
      782       if is-con = no then return no-apply.
      783       do transaction :
      784         for each temp-conn :
      785           find first ub.fin-connect exclusive-lock where recid(ub.fin-connect) = temp-conn.ri .
      786           find first ub.fin-ob      exclusive-lock where ub.fin-ob.host-code = ub.fin-connect.host-code and ub.fin-ob.doc-code = ub.fin-connect.fin-ob-code .
      787           assign
      788             ub.fin-ob.con-sum-rubl  = ub.fin-ob.con-sum-rubl  - ub.fin-connect.sum-rubl
      789             ub.fin-ob.con-sum-base  = ub.fin-ob.con-sum-base  - ub.fin-connect.sum-base
      790             ub.fin-ob.con-sum-doc   = ub.fin-ob.con-sum-doc   - ub.fin-connect.sum-doc
      791             ub.fin-ob.con-sum-contr = ub.fin-ob.con-sum-contr - ub.fin-connect.sum-contr
      792           .
      793           if ub.fin-ob.con-sum-contr = 0 then assign ub.fin-ob.con-stat = 0 .
      794           else                             assign ub.fin-ob.con-stat = 1 .
      795           find first ub.fin-doc      exclusive-lock where ub.fin-doc.host-code = ub.fin-connect.host-code and ub.fin-doc.fin-doc-code = ub.fin-connect.fin-doc-code .
      796           if   ub.fin-doc.fin-doc-type = 'рпп':U
      797             or ub.fin-doc.fin-doc-type = 'рко':U
      798             or ub.fin-doc.fin-doc-type = 'апр':U then do:
      799             assign
      800               ub.fin-doc.con-sum-rubl  = ub.fin-doc.con-sum-rubl  - ub.fin-connect.sum-rubl
      801               ub.fin-doc.con-sum-base  = ub.fin-doc.con-sum-base  - ub.fin-connect.sum-base
      802               ub.fin-doc.con-sum-doc   = ub.fin-doc.con-sum-doc   - ub.fin-connect.sum-doc
      803               ub.fin-doc.con-sum-contr = ub.fin-doc.con-sum-contr - ub.fin-connect.sum-contr
      804             .
      805           end.
      806           else do:
      807             assign
      808               ub.fin-doc.con-sum-rubl  = ub.fin-doc.con-sum-rubl  + ub.fin-connect.sum-rubl
      809               ub.fin-doc.con-sum-base  = ub.fin-doc.con-sum-base  + ub.fin-connect.sum-base
      810               ub.fin-doc.con-sum-doc   = ub.fin-doc.con-sum-doc   + ub.fin-connect.sum-doc
      811               ub.fin-doc.con-sum-contr = ub.fin-doc.con-sum-contr + ub.fin-connect.sum-contr
      812             .
      813           end.
      814           if ub.fin-doc.con-sum-contr = 0 then assign ub.fin-doc.con-stat = 0 .
      815           else                              assign ub.fin-doc.con-stat = 1 .
      816           delete ub.fin-connect .
      817           assign num = num - 1 .
      818           delete temp-conn .
      819         end.
      820       end.
      821     end.
      822     if num = 0 then hide mark-num in frame Dialog-Frame.
      823     else                   display num @ mark-num  with frame Dialog-Frame.
      824     RUN OpenBr(yes, no, '':U).
      825   END.
      826   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
      827   DO:
      828     if available buf_fin-connect then do:
      829       find first temp-conn where temp-conn.ri = recid( buf_fin-connect ) no-error  .
      830       if available temp-conn then do:
      831         delete temp-conn .
      832         assign num = num - 1 .
      833       end.
      834       else do:
      835         create temp-conn .
      836         assign
      837           temp-conn.ri = recid( buf_fin-connect )
      838           num = num + 1
      839         .
      840       end.
      841       g-log = Conn-List:refresh() .
      842       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then  do:
      843         g-log = Conn-List:select-next-row ().
      844         apply "value-changed" to Conn-List in frame Dialog-Frame.
      845       end.
      846       if num = 0 then hide mark-num in frame Dialog-Frame.
      847       else                   display num @ mark-num  with frame Dialog-Frame.
      848     end.
      849     apply "entry" to Conn-List .
      850   END.
      851   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      852   DO:
      853   END.
      854   ON CHOOSE OF b-sch IN FRAME Dialog-Frame
      855   DO:
      856     assign
      857       tbl = 'fin-connect'
      858       join-tbl = 'buf_fin-connect'
      859       fld = ""
      860       lab = ""
      861       spr = ""
      862       dim = '0'
      863     .
      864     run fltfield-add in this-procedure('host-code', '', '',
      865     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      866     run fltfield-add in this-procedure('fact-date', 'Дата', '',
      867     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      868     run fltfield-add in this-procedure('fact-time', 'Время', '',
      869     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      870     run fltfield-add in this-procedure('connect-code', 'Вн.Номер', '',
      871     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      872     run fltfield-add in this-procedure('fin-ob-code', 'Вн.номер фин.об.', '',
      873     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      874     run fltfield-add in this-procedure('fin-doc-code', 'Вн.номер платежа', '',
      875     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      876     run fltfield-add in this-procedure('contract-code', 'Номер', '',
      877     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      878     run fltfield-add in this-procedure('status_', 'Статус', '',
      879     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      880     run fltfield-add in this-procedure('user-db-num', '', '',
      881     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      882     run fltfield-add in this-procedure('user-name', '', '',
      883     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      884     run fltfield-add in this-procedure('curr-code', 'Валюта док-та', '',
      885     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      886     run fltfield-add in this-procedure('contract-curr', 'Валюта договора', '',
      887     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      888     run fltfield-add in this-procedure('sum-rubl', 'Сумма в рубл.', '',
      889     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      890     run fltfield-add in this-procedure('sum-base', 'Сумма в Б.вал.', '',
      891     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      892     run fltfield-add in this-procedure('sum-doc', 'Сумма в вал. док-та', '',
      893     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      894     run fltfield-add in this-procedure('sum-contr', 'Сумма в вал. договора', '',
      895     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      896     run fltfield-add in this-procedure('PS', 'Примечания', '',
      897     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      898   Filter-Block:
      899   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
      900       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
      901       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
      902     run gbl/filter.w ( INPUT parparentproc, INPUT filter-point, INPUT tbl, INPUT join-tbl, INPUT fld, INPUT lab, INPUT spr, INPUT dim ).
      903     RUN OpenBr(yes, no, '':U).
      904   END.
      905   END.
      906   ON CHOOSE OF B-view-doc IN FRAME Dialog-Frame
      907   DO:
      908     if not available buf_fin-ob then return.
      909     run ref/showfind.p (
      910                          input parParentProc
      911                         ,input p-host-code
      912                         ,input buf_fin-doc.host-code
      913                         ,input buf_fin-doc.fin-doc-code
      914                         ).
      915   END.
      916   ON CHOOSE OF B-view-fo IN FRAME Dialog-Frame
      917   DO:
      918   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      919   do:
      920     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      921       (input  v-cntxt-db-num
      922       ,input  v-cntxt-userid
      923       ,input  0
      924       ,input  'actn_fin-liability_lookup':U
      925       ,input  'firm':U
      926       ,input  p-host-code
      927       ,input  '':U
      928       ,input  0
      929       ,input  0
      930       ,input  0
      931       ,input  0
      932       ,input  true
      933       ,output g-log
      934       )  .
      935   end.
      936     if not g-log then  return .
      937     define variable rr as recid no-undo .
      938     if not available buf_fin-ob then return.
      939     run str/sh-finob.p ( input parParentProc, input p-host-code, input recid(buf_fin-ob)).
      940   END.
      941   ON RETURN OF Conn-List IN FRAME Dialog-Frame
      942   or MOUSE-SELECT-DBLCLICK OF Conn-List IN FRAME Dialog-Frame
      943   DO:
      944       if b-mark:sensitive then apply "choose" to b-mark in frame Dialog-Frame.
      945   END.
      946   ON VALUE-CHANGED OF RADIO-find-doc IN FRAME Dialog-Frame
      947   DO:
      948     assign RADIO-find-doc .
      949     if sch-code <> ? and  sch-code <> 0 then apply "return" to sch-code in frame Dialog-Frame.
      950   END.
      951   ON CTRL-J OF sch-code IN FRAME Dialog-Frame
      952   DO:
      953     run proc-find-code  in this-procedure(yes, input frame Dialog-Frame sch-code ) no-error.
      954     if error-status:error then return no-apply.
      955   END.
      956   ON RETURN OF sch-code IN FRAME Dialog-Frame
      957   DO:
      958     run proc-find-code  in this-procedure(no, input frame Dialog-Frame sch-code ) no-error.
      959     if error-status:error then return no-apply.
      960   END.
      961   ON CTRL-J OF sch-date IN FRAME Dialog-Frame
      962   DO:
      963     run proc-find-date in this-procedure(yes, input frame Dialog-Frame sch-date) no-error.
      964     if error-status:error then return no-apply.
      965   END.
      966   ON RETURN OF sch-date IN FRAME Dialog-Frame
      967   DO:
      968     run proc-find-date in this-procedure(no, input frame Dialog-Frame sch-date) no-error.
      969     if error-status:error then return no-apply.
      970   END.
      971   ON CTRL-J OF sch-user IN FRAME Dialog-Frame
      972   DO:
      973     run proc-find-user  in this-procedure(yes, input frame Dialog-Frame sch-user ) no-error.
      974     if error-status:error then return no-apply.
      975   END.
      976   ON RETURN OF sch-user IN FRAME Dialog-Frame
      977   DO:
      978     run proc-find-user  in this-procedure(no, input frame Dialog-Frame sch-user ) no-error.
      979     if error-status:error then return no-apply.
      980   END.
      981   ON VALUE-CHANGED OF Sel-Contr IN FRAME Dialog-Frame
      982   DO:
      983     assign Sel-Contr .
      984     if Sel-Contr = "sel" then do:
      985       run str/cont-all.w ( parParentProc, p-host-code, "b-sel", 'фирма':U, ?, ?, ?, ?, "current":U, p-doc-type, input-output cont-list ) .
      986       if cont-list = "" then do:
      987         assign Sel-Contr = "all" .
      988         disp Sel-Contr with frame Dialog-Frame.
      989       end.
      990     end .
      991     RUN OpenBr(yes, no, '':U) .
      992   END.
      993   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      994   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      995   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      996   on help of frame Dialog-Frame
      997   do:
      998     run gbl/app_help.p
      999       (input this-procedure :file-name
     1000       ,input ''
     1001       ,input ?
     1002       ) no-error.
     1003     if error-status :error then do:
     1004       message
     1005         "Ошибка при вызове помощи"
     1006         error-status :get-message(1)
     1007         view-as alert-box .
     1008     end.
     1009   end.
     1010   run minbtn-set in this-procedure .
     1011   on choose of b-help in frame Dialog-Frame
     1012   do:
     1013     apply "help":u to frame Dialog-Frame .
     1014   end.
     1015   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1016   procedure minbtn-set :
     1017       do
     1018           on error undo, return error return-value
     1019           :
     1020           define variable ii              as integer       no-undo .
     1021           define variable fh              as widget-handle no-undo .
     1022           define variable hh              as widget-handle no-undo .
     1023           define variable v-h             as handle        extent 4 no-undo .
     1024           define variable v-name-button   as character     no-undo .
     1025           define variable v-help-old-x    as decimal       no-undo .
     1026           define variable v-help-old-y    as decimal       no-undo .
     1027           define variable v-help-old-size as decimal       no-undo .
     1028           define variable v-frame-width   as decimal       no-undo .
     1029           define variable jj              as integer       no-undo .
     1030           do
     1031               on error undo, return error
     1032               :
     1033               assign
     1034                   v-frame-width = frame Dialog-Frame:width - 0.3
     1035                   fh            = frame Dialog-Frame:first-child
     1036                   hh            = fh:first-child
     1037                   ii            = 1
     1038                   .
     1039               do while valid-handle(hh):
     1040                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1041                   do:
     1042                       case lc(hh:name) :
     1043                           when "b-help" then
     1044                               do:
     1045                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1046                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1047                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1048                                   hh:TOOLTIP = "Помощь" .
     1049                                   v-help-old-x = hh:column .
     1050                                   v-help-old-y = hh:row    .
     1051                                   v-help-old-size = hh:width .
     1052                                   hh:width-chars = 2.5 .
     1053                               end.
     1054                           when "b-print" then
     1055                               do:
     1056                                   hh:load-image("cmp/b-print.bmp":u) .
     1057                                   hh:TOOLTIP = "Печать" .
     1058                                   v-h[ii] = hh:handle .
     1059                                   ii = ii + 1 .
     1060                                   hh:width-chars = 3 .
     1061                               end.
     1062                           when "b-history" or
     1063                           when "b-hist" then
     1064                               do:
     1065                                   hh:load-image("cmp/b-hist.bmp":u) .
     1066                                   hh:TOOLTIP = "История" .
     1067                                   v-h[ii] = hh:handle .
     1068                                   ii = ii + 1 .
     1069                                   hh:width-chars = 3 .
     1070                               end.
     1071                           when "b-sch" then
     1072                               do:
     1073                                   hh:load-image("cmp/b-sch.bmp":u) .
     1074                                   hh:TOOLTIP = "Установка Фильтра" .
     1075                                   v-h[ii] = hh:handle .
     1076                                   ii = ii + 1 .
     1077                                   hh:width-chars = 3 .
     1078                               end.
     1079                           when "b-hist-user" then
     1080                               do:
     1081                                   hh:load-image("cmp/b-hist.bmp":u) .
     1082                                   hh:TOOLTIP = "История пользователя" .
     1083                                   ii = ii + 1 .
     1084                               end.
     1085                       end case.
     1086                   end.
     1087                   hh = hh:next-sibling.
     1088               end.
     1089               b-help:column = v-frame-width - b-help:width-chars.
     1090               jj = 0.
     1091               repeat ii = 4 to 1 by -1 :
     1092                   if valid-handle (v-h[ii] ) then
     1093                   do:
     1094                       jj  = jj + 1 .
     1095                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1096                       v-h[ii]:row    = v-help-old-y .
     1097                   end.
     1098               end.
     1099           end.
     1100       end.
     1101   end procedure.
     1102   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1103   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1104   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1105   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1106   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1107   define variable v-diasize-current-frame-height as decimal   no-undo .
     1108   define variable v-diasize-change-size          as logical   no-undo .
     1109   define variable v-diasize-resize-button        as handle    no-undo .
     1110   define variable v-diasize-wndmax               as logical   no-undo .
     1111   define variable v-diasize-wndstore             as logical   no-undo .
     1112   define variable v-diasize-proc-name            as character no-undo .
     1113   define variable v-diasize-browse-handle        as handle    no-undo .
     1114   define variable v-diasize-browse-number        as integer   no-undo .
     1115   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1116   define temp-table temp-diasize-handle no-undo
     1117     field handle-value  as handle
     1118     field save-position as decimal
     1119     index xpk is primary unique handle-value
     1120     .
     1121   define temp-table temp-browse-handle no-undo
     1122     field browse-type   as character
     1123     field browse-number as integer
     1124     field browse-handle as handle
     1125     field original-size as decimal
     1126     index xpk is primary unique browse-type browse-number
     1127     index xie browse-type browse-handle
     1128   .
     1129   procedure diasize_change-height :
     1130     define input  parameter p-change-value  as decimal   no-undo .
     1131     define input  parameter p-move-resize   as logical   no-undo .
     1132     define variable v-field-group-handle    as handle    no-undo .
     1133     define variable v-object-handle         as handle    no-undo .
     1134     define variable v-frame-height          as decimal   no-undo .
     1135     define variable v-frame-virtual-height  as decimal   no-undo .
     1136     define variable v-browse-height         as decimal   no-undo .
     1137     define variable v-window-height         as decimal   no-undo .
     1138     define variable v-window-virtual-height as decimal   no-undo .
     1139     define variable v-change-sign           as integer   no-undo .
     1140     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1141     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1142     if p-change-value > 0
     1143     then do:
     1144       if frame Dialog-Frame :height + p-change-value
     1145           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1146       then do:
     1147         assign
     1148           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1149                           - (frame Dialog-Frame :height-chars)
     1150         .
     1151         if p-change-value <= 0
     1152         then do:
     1153           run diasize_position-resize-button in this-procedure .
     1154           return .
     1155         end.
     1156       end.
     1157     end.
     1158     if p-change-value < 0
     1159     then do:
     1160       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1161       then do:
     1162         assign
     1163           p-change-value = v-diasize-orig-frame-height
     1164                          - (frame Dialog-Frame :height-chars)
     1165         .
     1166         if p-change-value >= 0
     1167         then do:
     1168           run diasize_position-resize-button in this-procedure .
     1169           return .
     1170         end.
     1171       end.
     1172     end.
     1173     if p-change-value >= 0
     1174     then do:
     1175       assign
     1176         v-change-sign = 1
     1177       .
     1178     end.
     1179     else do:
     1180       assign
     1181         v-change-sign = -1
     1182       .
     1183     end.
     1184     assign
     1185       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1186     .
     1187     if p-change-value = 0
     1188     then do:
     1189       run diasize_position-resize-button in this-procedure .
     1190       return .
     1191     end.
     1192     move_block:
     1193     do
     1194     on error undo move_block, retry move_block
     1195     :
     1196       if retry
     1197       then do:
     1198         do
     1199         on error undo move_block, leave move_block
     1200         :
     1201           if p-change-value > 0
     1202           then do:
     1203             for each buf_temp-diasize-handle
     1204             on error undo, next
     1205             :
     1206               assign
     1207                 v-object-handle = buf_temp-diasize-handle.handle-value
     1208               .
     1209               if v-object-handle <> v-diasize-resize-button
     1210               then do:
     1211                 assign
     1212                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1213                 .
     1214               end.
     1215             end.
     1216             assign
     1217               v-diasize-browse-handle :height = v-browse-height
     1218             .
     1219             for each buf_temp-browse-handle
     1220               where buf_temp-browse-handle.browse-type = 'height':u
     1221             on error undo, next
     1222             :
     1223               assign
     1224                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1225               .
     1226             end.
     1227             assign
     1228               frame Dialog-Frame :height = v-frame-height
     1229             .
     1230             if frame Dialog-Frame :scrollable = true
     1231             then do:
     1232               assign
     1233                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1234               .
     1235             end.
     1236             run diasize_position-resize-button in this-procedure .
     1237           end.
     1238           else do:
     1239             if frame Dialog-Frame :scrollable = true
     1240             then do:
     1241               assign
     1242                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1243               .
     1244             end.
     1245             assign
     1246               frame Dialog-Frame :height = v-frame-height
     1247             .
     1248             assign
     1249               v-diasize-browse-handle :height = v-browse-height
     1250             .
     1251             for each buf_temp-browse-handle
     1252               where buf_temp-browse-handle.browse-type = 'height':u
     1253             on error undo, next
     1254             :
     1255               assign
     1256                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1257               .
     1258             end.
     1259             for each buf_temp-diasize-handle
     1260             on error undo, next
     1261             :
     1262               assign
     1263                 v-object-handle = buf_temp-diasize-handle.handle-value
     1264               .
     1265               if v-object-handle <> v-diasize-resize-button
     1266               then do:
     1267                 assign
     1268                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1269                 .
     1270               end.
     1271             end.
     1272             run diasize_position-resize-button in this-procedure .
     1273           end.
     1274           assign
     1275             v-diasize-change-size = false
     1276           .
     1277           leave move_block .
     1278         end.
     1279       end.
     1280       assign
     1281         v-diasize-need-full-display = true
     1282       .
     1283       if v-diasize-change-size = false
     1284       then do:
     1285         assign
     1286           v-diasize-change-size = true
     1287         .
     1288       end.
     1289       else do:
     1290         return .
     1291       end.
     1292       assign
     1293         v-frame-height = frame Dialog-Frame :height
     1294         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1295         v-browse-height = v-diasize-browse-handle :height
     1296       .
     1297       for each buf_temp-browse-handle
     1298         where buf_temp-browse-handle.browse-type = 'height':u
     1299       :
     1300         assign
     1301           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1302         .
     1303       end.
     1304       for each buf_temp-diasize-handle
     1305       :
     1306         delete buf_temp-diasize-handle .
     1307       end.
     1308       assign
     1309         v-field-group-handle = frame Dialog-Frame :first-child
     1310       .
     1311       do while valid-handle(v-field-group-handle)
     1312       :
     1313         assign
     1314           v-object-handle = v-field-group-handle :first-child
     1315         .
     1316         do while valid-handle(v-object-handle)
     1317         :
     1318           if  v-object-handle <> v-diasize-browse-handle :handle
     1319           and can-query(v-object-handle, "row")
     1320           and can-query(v-object-handle, "height")
     1321           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1322           then do:
     1323             find first buf_temp-browse-handle
     1324               where buf_temp-browse-handle.browse-type   = 'height':u
     1325                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1326               no-error .
     1327             if available buf_temp-browse-handle
     1328             then do:
     1329             end.
     1330             else do:
     1331               create buf_temp-diasize-handle .
     1332               assign
     1333                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1334                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1335               .
     1336             end.
     1337           end.
     1338           assign
     1339             v-object-handle = v-object-handle :next-sibling
     1340           .
     1341         end.
     1342         assign
     1343           v-field-group-handle = v-field-group-handle :next-sibling
     1344         .
     1345       end.
     1346       do with frame Dialog-Frame
     1347       :
     1348         hide v-diasize-resize-button .
     1349         assign
     1350           v-diasize-resize-button :row    = 1
     1351           v-diasize-resize-button :column = 1
     1352         .
     1353       end.
     1354       if p-change-value > 0
     1355       then do:
     1356         if frame Dialog-Frame :scrollable = true
     1357         then do:
     1358           assign
     1359             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1360             no-error .
     1361           if error-status :error
     1362           or error-status :get-message(1) <> ""
     1363           then do:
     1364             undo move_block, retry move_block .
     1365           end.
     1366         end.
     1367         assign
     1368           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1369           no-error .
     1370         if error-status :error
     1371         or error-status :get-message(1) <> ""
     1372         then do:
     1373           undo move_block, retry move_block .
     1374         end.
     1375         assign
     1376           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1377           no-error .
     1378         if error-status :error
     1379         or error-status :get-message(1) <> ""
     1380         then do:
     1381           undo move_block, retry move_block .
     1382         end.
     1383         for each buf_temp-browse-handle
     1384           where buf_temp-browse-handle.browse-type = 'height':u
     1385         on error undo move_block, retry move_block
     1386         :
     1387           assign
     1388             buf_temp-browse-handle.browse-handle :height
     1389               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1390             no-error .
     1391           if error-status :error
     1392           or error-status :get-message(1) <> ""
     1393           then do:
     1394             undo move_block, retry move_block .
     1395           end.
     1396         end.
     1397         for each buf_temp-diasize-handle
     1398         on error undo move_block, retry move_block
     1399         :
     1400           assign
     1401             v-object-handle = buf_temp-diasize-handle.handle-value
     1402           .
     1403           if v-object-handle <> v-diasize-resize-button
     1404           then do:
     1405             assign
     1406               v-object-handle :row = v-object-handle :row + p-change-value
     1407               no-error .
     1408             if error-status :error
     1409             or error-status :get-message(1) <> ""
     1410             then do:
     1411               undo move_block, retry move_block .
     1412             end.
     1413           end.
     1414         end.
     1415       end.
     1416       else do:
     1417         for each buf_temp-diasize-handle
     1418         on error undo move_block, retry move_block
     1419         :
     1420           assign
     1421             v-object-handle = buf_temp-diasize-handle.handle-value
     1422           .
     1423           if v-object-handle <> v-diasize-resize-button
     1424           then do:
     1425             assign
     1426               v-object-handle :row = v-object-handle :row + p-change-value
     1427               no-error .
     1428             if error-status :error
     1429             or error-status :get-message(1) <> ""
     1430             then do:
     1431               undo move_block, retry move_block .
     1432             end.
     1433           end.
     1434         end.
     1435         assign
     1436           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1437           no-error .
     1438         if error-status :error
     1439         or error-status :get-message(1) <> ""
     1440         then do:
     1441           undo move_block, retry move_block .
     1442         end.
     1443         for each buf_temp-browse-handle
     1444           where buf_temp-browse-handle.browse-type = 'height':u
     1445         on error undo move_block, retry move_block
     1446         :
     1447           assign
     1448             buf_temp-browse-handle.browse-handle :height
     1449               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1450             no-error .
     1451           if error-status :error
     1452           or error-status :get-message(1) <> ""
     1453           then do:
     1454             undo move_block, retry move_block .
     1455           end.
     1456         end.
     1457         assign
     1458           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1459           no-error .
     1460         if error-status :error
     1461         or error-status :get-message(1) <> ""
     1462         then do:
     1463           undo move_block, retry move_block .
     1464         end.
     1465         if frame Dialog-Frame :scrollable = true
     1466         then do:
     1467           assign
     1468             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1469             no-error .
     1470           if error-status :error
     1471           or error-status :get-message(1) <> ""
     1472           then do:
     1473             undo move_block, retry move_block .
     1474           end.
     1475         end.
     1476       end.
     1477       if p-move-resize = true
     1478       then do:
     1479         run diasize_position-resize-button in this-procedure .
     1480       end.
     1481       if v-diasize-wndstore = true
     1482       then do:
     1483         if connected("ub") = true
     1484         then do:
     1485           define variable v-cntxt-db-num        as integer   no-undo .
     1486           define variable v-cntxt-userid        as character no-undo .
     1487           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1488                                             , OUTPUT v-cntxt-userid
     1489                                             ) .
     1490           run gbl/wndsizew.p
     1491             (input  v-cntxt-db-num
     1492             ,input  v-cntxt-userid
     1493             ,input  v-diasize-proc-name
     1494             ,input  'height':u
     1495             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1496             ) .
     1497         end.
     1498       end.
     1499     end.
     1500     assign
     1501       v-diasize-change-size = false
     1502     .
     1503   end procedure.
     1504   procedure diasize_set-height :
     1505     define input  parameter p-new-height  as decimal   no-undo .
     1506     define input  parameter p-move-resize as logical   no-undo .
     1507     do
     1508     on error undo, return error return-value
     1509     :
     1510       run diasize_change-height in this-procedure
     1511         (input  (p-new-height - frame Dialog-Frame :height)
     1512         ,input  p-move-resize
     1513         ) .
     1514     end.
     1515   end procedure.
     1516   procedure diasize_change-width :
     1517     define input  parameter p-change-value as decimal   no-undo .
     1518     define input  parameter p-move-resize  as logical   no-undo .
     1519     define variable v-field-group-handle   as handle    no-undo .
     1520     define variable v-object-handle        as handle    no-undo .
     1521     define variable v-frame-width          as decimal   no-undo .
     1522     define variable v-frame-virtual-width  as decimal   no-undo .
     1523     define variable v-browse-width         as decimal   no-undo .
     1524     define variable v-window-width         as decimal   no-undo .
     1525     define variable v-window-virtual-width as decimal   no-undo .
     1526     define variable v-change-sign          as integer   no-undo .
     1527     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1528     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1529     if p-change-value > 0
     1530     then do:
     1531       if frame Dialog-Frame :width + p-change-value >
     1532           session :width-chars
     1533       then do:
     1534         assign
     1535           p-change-value = session :width-chars - frame Dialog-Frame :width
     1536         .
     1537         if p-change-value <= 0
     1538         then do:
     1539           run diasize_position-resize-button in this-procedure .
     1540           return .
     1541         end.
     1542       end.
     1543     end.
     1544     if p-change-value < 0
     1545     then do:
     1546       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1547       then do:
     1548         assign
     1549           p-change-value = v-diasize-orig-frame-width
     1550                          - frame Dialog-Frame :width
     1551         .
     1552         if p-change-value >= 0
     1553         then do:
     1554           run diasize_position-resize-button in this-procedure .
     1555           return .
     1556         end.
     1557       end.
     1558     end.
     1559     if p-change-value >= 0
     1560     then do:
     1561       assign
     1562         v-change-sign = 1
     1563       .
     1564     end.
     1565     else do:
     1566       assign
     1567         v-change-sign = -1
     1568       .
     1569     end.
     1570     assign
     1571       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1572     .
     1573     if p-change-value = 0
     1574     then do:
     1575       run diasize_position-resize-button in this-procedure .
     1576       return .
     1577     end.
     1578     move_block:
     1579     do
     1580     on error undo move_block, leave move_block
     1581     :
     1582       if retry
     1583       then do:
     1584         do
     1585         on error undo move_block, leave move_block
     1586         :
     1587           if p-change-value > 0
     1588           then do:
     1589             for each buf_temp-diasize-handle
     1590             on error undo, next
     1591             :
     1592               assign
     1593                 v-object-handle = buf_temp-diasize-handle.handle-value
     1594               .
     1595               if v-object-handle <> v-diasize-resize-button
     1596               then do:
     1597                 assign
     1598                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1599                 .
     1600               end.
     1601             end.
     1602             assign
     1603               v-diasize-browse-handle :width = v-browse-width
     1604             .
     1605             for each buf_temp-browse-handle
     1606               where buf_temp-browse-handle.browse-type = 'width':u
     1607             on error undo, next
     1608             :
     1609               assign
     1610                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1611               .
     1612             end.
     1613             assign
     1614               frame Dialog-Frame :width = v-frame-width
     1615             .
     1616             if frame Dialog-Frame :scrollable = true
     1617             then do:
     1618               assign
     1619                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1620               .
     1621             end.
     1622             run diasize_position-resize-button in this-procedure .
     1623           end.
     1624           else do:
     1625             if frame Dialog-Frame :scrollable = true
     1626             then do:
     1627               assign
     1628                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1629               .
     1630             end.
     1631             assign
     1632               frame Dialog-Frame :width = v-frame-width
     1633             .
     1634             for each buf_temp-browse-handle
     1635               where buf_temp-browse-handle.browse-type = 'width':u
     1636             on error undo, next
     1637             :
     1638               assign
     1639                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1640               .
     1641             end.
     1642             assign
     1643               v-diasize-browse-handle :width = v-browse-width
     1644             .
     1645             for each buf_temp-diasize-handle
     1646             on error undo, next
     1647             :
     1648               assign
     1649                 v-object-handle = buf_temp-diasize-handle.handle-value
     1650               .
     1651               if v-object-handle <> v-diasize-resize-button
     1652               then do:
     1653                 assign
     1654                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1655                 .
     1656               end.
     1657             end.
     1658             run diasize_position-resize-button in this-procedure .
     1659           end.
     1660           assign
     1661             v-diasize-change-size = false
     1662           .
     1663           leave move_block .
     1664         end.
     1665       end.
     1666       assign
     1667         v-diasize-need-full-display = true
     1668       .
     1669       if v-diasize-change-size = false
     1670       then do:
     1671         assign
     1672           v-diasize-change-size = true
     1673         .
     1674       end.
     1675       else do:
     1676         return .
     1677       end.
     1678       assign
     1679         v-frame-width = frame Dialog-Frame :width
     1680         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1681         v-browse-width = v-diasize-browse-handle :width
     1682       .
     1683       for each buf_temp-browse-handle
     1684         where buf_temp-browse-handle.browse-type = 'width':u
     1685       :
     1686         assign
     1687           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1688         .
     1689       end.
     1690       for each buf_temp-diasize-handle
     1691       :
     1692         delete buf_temp-diasize-handle .
     1693       end.
     1694       assign
     1695         v-field-group-handle = frame Dialog-Frame :first-child
     1696       .
     1697       do while valid-handle(v-field-group-handle)
     1698       :
     1699         assign
     1700           v-object-handle = v-field-group-handle :first-child
     1701         .
     1702         do while valid-handle(v-object-handle)
     1703         :
     1704           if  v-object-handle <> v-diasize-browse-handle :handle
     1705           and v-object-handle <> v-diasize-resize-button
     1706           and can-query(v-object-handle, "row")
     1707           and can-query(v-object-handle, "height")
     1708           and ( v-object-handle :col + v-object-handle :width
     1709                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1710               )
     1711           then do:
     1712             find first buf_temp-browse-handle
     1713               where buf_temp-browse-handle.browse-type   = 'width':u
     1714                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1715               no-error .
     1716             if available buf_temp-browse-handle
     1717             then do:
     1718             end.
     1719             else do:
     1720               create buf_temp-diasize-handle .
     1721               assign
     1722                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1723                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1724               .
     1725             end.
     1726           end.
     1727           assign
     1728             v-object-handle = v-object-handle :next-sibling
     1729           .
     1730         end.
     1731         assign
     1732           v-field-group-handle = v-field-group-handle :next-sibling
     1733         .
     1734       end.
     1735       do with frame Dialog-Frame
     1736       :
     1737         hide v-diasize-resize-button .
     1738         v-diasize-resize-button :row = 1.
     1739         v-diasize-resize-button :column = 1.
     1740       end.
     1741       if p-change-value > 0
     1742       then do:
     1743         if frame Dialog-Frame :scrollable = true
     1744         then do:
     1745           assign
     1746             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1747             no-error .
     1748           if error-status :error
     1749           or error-status :get-message(1) <> ""
     1750           then do:
     1751             undo move_block, retry move_block.
     1752           end.
     1753         end.
     1754         assign
     1755           frame Dialog-Frame :width = v-frame-width + p-change-value
     1756           no-error .
     1757         if error-status :error
     1758         or error-status :get-message(1) <> ""
     1759         then do:
     1760           undo move_block, retry move_block.
     1761         end.
     1762         assign
     1763           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1764         no-error .
     1765         if error-status :error
     1766         or error-status :get-message(1) <> ""
     1767         then do:
     1768           undo move_block, retry move_block.
     1769         end.
     1770         for each buf_temp-browse-handle
     1771           where buf_temp-browse-handle.browse-type = 'width':u
     1772         on error undo move_block, retry move_block
     1773         :
     1774           assign
     1775             buf_temp-browse-handle.browse-handle :width
     1776               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1777             no-error .
     1778           if error-status :error
     1779           or error-status :get-message(1) <> ""
     1780           then do:
     1781             undo move_block, retry move_block .
     1782           end.
     1783         end.
     1784         for each buf_temp-diasize-handle
     1785         on error undo move_block, retry move_block
     1786         :
     1787           assign
     1788             v-object-handle = buf_temp-diasize-handle.handle-value
     1789           .
     1790           if v-object-handle <> v-diasize-resize-button
     1791           then do:
     1792             assign
     1793               v-object-handle :col = v-object-handle :col + p-change-value
     1794               no-error .
     1795             if error-status :error
     1796             or error-status :get-message(1) <> ""
     1797             then do:
     1798               undo move_block, retry move_block .
     1799             end.
     1800           end.
     1801         end.
     1802       end.
     1803       else do:
     1804         for each buf_temp-diasize-handle
     1805         on error undo move_block, retry move_block
     1806         :
     1807           assign
     1808             v-object-handle = buf_temp-diasize-handle.handle-value
     1809           .
     1810           if v-object-handle <> v-diasize-resize-button
     1811           then do:
     1812             assign
     1813               v-object-handle :col = v-object-handle :col + p-change-value
     1814               no-error .
     1815             if error-status :error
     1816             or error-status :get-message(1) <> ""
     1817             then do:
     1818               undo move_block, retry move_block .
     1819             end.
     1820           end.
     1821         end.
     1822         for each buf_temp-browse-handle
     1823           where buf_temp-browse-handle.browse-type = 'width':u
     1824         on error undo move_block, retry move_block
     1825         :
     1826           assign
     1827             buf_temp-browse-handle.browse-handle :width
     1828               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1829             no-error .
     1830           if error-status :error
     1831           or error-status :get-message(1) <> ""
     1832           then do:
     1833             undo move_block, retry move_block .
     1834           end.
     1835         end.
     1836         assign
     1837           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1838           no-error .
     1839         if error-status :error
     1840         or error-status :get-message(1) <> ""
     1841         then do:
     1842           undo move_block, retry move_block.
     1843         end.
     1844         assign
     1845           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1846         no-error .
     1847         if error-status :error
     1848         or error-status :get-message(1) <> ""
     1849         then do:
     1850           undo move_block, retry move_block.
     1851         end.
     1852         if frame Dialog-Frame :scrollable = true
     1853         then do:
     1854           assign
     1855             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1856           no-error .
     1857           if error-status :error
     1858           or error-status :get-message(1) <> ""
     1859           then do:
     1860             undo move_block, retry move_block.
     1861           end.
     1862         end.
     1863       end.
     1864       if p-move-resize
     1865       then do:
     1866         run diasize_position-resize-button in this-procedure .
     1867       end.
     1868       if v-diasize-wndstore = true
     1869       then do:
     1870         if connected("ub") = true
     1871         then do:
     1872           define variable v-cntxt-db-num        as integer   no-undo .
     1873           define variable v-cntxt-userid        as character no-undo .
     1874           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1875                                             , OUTPUT v-cntxt-userid
     1876                                             ) .
     1877           run gbl/wndsizew.p
     1878             (input  v-cntxt-db-num
     1879             ,input  v-cntxt-userid
     1880             ,input  v-diasize-proc-name
     1881             ,input  'width':u
     1882             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1883             ) .
     1884         end.
     1885       end.
     1886     end.
     1887     assign
     1888       v-diasize-change-size = false
     1889     .
     1890   end procedure.
     1891   procedure diasize_set-width :
     1892     define input  parameter p-new-width  as decimal   no-undo .
     1893     define input  parameter p-move-resize as logical   no-undo .
     1894     do
     1895     on error undo, return error return-value
     1896     :
     1897       run diasize_change-width in this-procedure
     1898         (input  (p-new-width - frame Dialog-Frame :width)
     1899         ,input  p-move-resize
     1900         ) .
     1901     end.
     1902   end procedure.
     1903   procedure diasize_position-resize-button :
     1904     do with frame Dialog-Frame
     1905     :
     1906       hide v-diasize-resize-button .
     1907       assign
     1908         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1909                     - 1
     1910                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1911         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1912                     - 1
     1913                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1914       .
     1915       view v-diasize-resize-button .
     1916     end.
     1917   end procedure.
     1918   on alt-right anywhere
     1919   do:
     1920     run diasize_change-width in this-procedure
     1921       (input 1
     1922       ,input true
     1923       ) .
     1924     return no-apply .
     1925   end.
     1926   on alt-left anywhere
     1927   do:
     1928     run diasize_change-width in this-procedure
     1929       (input -1
     1930       ,input true
     1931       ) .
     1932     return no-apply .
     1933   end.
     1934   on alt-down anywhere
     1935   do:
     1936     run diasize_change-height in this-procedure
     1937       (input 1
     1938       ,input true
     1939       ) .
     1940     return no-apply .
     1941   end.
     1942   on alt-up anywhere
     1943   do:
     1944     run diasize_change-height in this-procedure
     1945       (input -1
     1946       ,input true
     1947       ) .
     1948     return no-apply .
     1949   end.
     1950   on alt-enter of frame Dialog-Frame
     1951   do:
     1952     run diasize_maximize in this-procedure
     1953       (input  ?
     1954       ).
     1955     return no-apply .
     1956   end.
     1957   procedure diasize_end-move :
     1958     do
     1959     on error undo, return error return-value
     1960     :
     1961       define variable v-row-delta as decimal   no-undo .
     1962       define variable v-col-delta as decimal   no-undo .
     1963       define variable v-new-row as decimal   no-undo .
     1964       define variable v-new-col as decimal   no-undo .
     1965       assign
     1966         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1967         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1968       .
     1969       assign
     1970         v-row-delta = v-new-row - frame Dialog-Frame :height
     1971         v-col-delta = v-new-col - frame Dialog-Frame :width
     1972       .
     1973       run diasize_change-height in this-procedure
     1974         (input v-row-delta
     1975         ,input true
     1976         ) .
     1977       run diasize_change-width in this-procedure
     1978         (input v-col-delta
     1979         ,input true
     1980         ) .
     1981     end.
     1982   end procedure.
     1983   procedure diasize_maximize :
     1984     define input  parameter p-action as logical   no-undo .
     1985     do
     1986     on error undo, return error return-value
     1987     :
     1988       if p-action = ?
     1989       then do:
     1990         if v-diasize-need-maximize = true
     1991         then do:
     1992           assign
     1993             p-action = true
     1994           .
     1995         end.
     1996         else do:
     1997           assign
     1998             p-action = false
     1999           .
     2000         end.
     2001       end.
     2002       if p-action = true
     2003       then do:
     2004         run diasize_change-height in this-procedure
     2005           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2006               - frame Dialog-Frame :height-chars
     2007           ,input true
     2008           ) .
     2009         run diasize_change-width in this-procedure
     2010           (input session :width-chars
     2011               - frame Dialog-Frame :width-chars
     2012           ,input true
     2013           ) .
     2014         assign
     2015           v-diasize-need-maximize = false
     2016         .
     2017       end.
     2018       else do:
     2019         run diasize_change-width in this-procedure
     2020           (input v-diasize-orig-frame-width
     2021               - frame Dialog-Frame :width-chars
     2022           ,input true
     2023           ) .
     2024         run diasize_change-height in this-procedure
     2025           (input v-diasize-orig-frame-height
     2026               - frame Dialog-Frame :height-chars
     2027           ,input true
     2028           ) .
     2029         assign
     2030           v-diasize-need-maximize = true
     2031         .
     2032       end.
     2033     end.
     2034   end procedure.
     2035   procedure diasize_restore-orig-size :
     2036     do
     2037     on error undo, return error return-value
     2038     :
     2039       assign
     2040         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2041         v-diasize-current-frame-height = frame Dialog-Frame :height
     2042       .
     2043       run diasize_set-height in this-procedure
     2044         (input  v-diasize-orig-frame-height
     2045         ,input  true
     2046         ) .
     2047       run diasize_set-width in this-procedure
     2048         (input  v-diasize-orig-frame-width
     2049         ,input  true
     2050         ) .
     2051     end.
     2052   end procedure.
     2053   procedure diasize_restore-current-size :
     2054     do
     2055     on error undo, return error return-value
     2056     :
     2057       run diasize_set-height in this-procedure
     2058         (input  v-diasize-current-frame-height
     2059         ,input  true
     2060         ) .
     2061       run diasize_set-width in this-procedure
     2062         (input  v-diasize-current-frame-width
     2063         ,input  true
     2064         ) .
     2065     end.
     2066   end procedure.
     2067   procedure diasize_set-browse-handle :
     2068     define input  parameter p-browse-handle as handle   no-undo .
     2069     define buffer buf_temp-browse-handle for temp-browse-handle .
     2070     do
     2071     on error undo, return error return-value
     2072     :
     2073       assign
     2074         v-diasize-browse-handle = p-browse-handle
     2075       .
     2076       for each buf_temp-browse-handle
     2077       on error undo, return error return-value
     2078       :
     2079         delete buf_temp-browse-handle .
     2080       end.
     2081     end.
     2082   end procedure.
     2083   procedure diasize_add_browse :
     2084     define input  parameter p-browse-type   as character no-undo .
     2085     define input  parameter p-browse-handle as handle    no-undo .
     2086     define buffer buf_temp-browse-handle for temp-browse-handle .
     2087     do
     2088     on error undo, return error return-value
     2089     :
     2090       assign
     2091         v-diasize-browse-number = v-diasize-browse-number + 1
     2092       .
     2093       create buf_temp-browse-handle .
     2094       assign
     2095         buf_temp-browse-handle.browse-type   = p-browse-type
     2096         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2097         buf_temp-browse-handle.browse-handle = p-browse-handle
     2098       .
     2099     end.
     2100   end procedure.
     2101   procedure diasize_init :
     2102     define variable v-default-value    as logical   no-undo .
     2103     define variable v-restore-saved    as logical   no-undo .
     2104     define variable v-resize-value-str as character no-undo .
     2105     do
     2106     on error undo, return error return-value
     2107     :
     2108       do with frame Dialog-Frame
     2109       :
     2110         assign
     2111           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2112           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2113           v-diasize-browse-handle     = browse Conn-List :handle
     2114         .
     2115         create button v-diasize-resize-button
     2116         assign
     2117           parent        = frame Dialog-Frame :first-child
     2118           label         = "s"
     2119           height-pixels = 16
     2120           width-pixels  = 16
     2121           visible       = true
     2122           sensitive     = true
     2123           movable       = true
     2124           triggers:
     2125             on end-move persistent run diasize_end-move in this-procedure .
     2126           end triggers.
     2127         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2128         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2129         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2130         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2131         assign
     2132           v-diasize-wndmax = false
     2133         .
     2134         if connected("ub") = true
     2135         then do:
     2136           define variable v-cntxt-db-num        as integer   no-undo .
     2137           define variable v-cntxt-userid        as character no-undo .
     2138           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2139                                             , OUTPUT v-cntxt-userid
     2140                                             ) .
     2141           run gbl/wndpar_r.p
     2142             (input  v-cntxt-db-num
     2143             ,input  v-cntxt-userid
     2144             ,input  'wndmax':U
     2145             ,output v-diasize-wndmax
     2146             ,output v-default-value
     2147             ) .
     2148         end.
     2149         assign
     2150           v-diasize-wndstore = false
     2151         .
     2152         if connected("ub") = true
     2153         then do:
     2154           run gbl/wndpar_r.p
     2155             (input  v-cntxt-db-num
     2156             ,input  v-cntxt-userid
     2157             ,input  'wndstore':U
     2158             ,output v-diasize-wndstore
     2159             ,output v-default-value
     2160             ) .
     2161         end.
     2162         assign
     2163           v-diasize-proc-name = entry(1, program-name(2), '.')
     2164         .
     2165         if v-diasize-wndstore = true
     2166         then do:
     2167           assign
     2168             v-restore-saved = false
     2169           .
     2170           if connected("ub") = true
     2171           then do:
     2172             run gbl/wndsizer.p
     2173               (input  v-cntxt-db-num
     2174               ,input  v-cntxt-userid
     2175               ,input  v-diasize-proc-name
     2176               ,input  'height':u
     2177               ,output v-resize-value-str
     2178               ) .
     2179             if v-resize-value-str <> '':U
     2180             then do:
     2181               run diasize_change-height in this-procedure
     2182                 (input  integer(v-resize-value-str)
     2183                 ,input  true
     2184                 ) .
     2185               assign
     2186                 v-restore-saved = true
     2187               .
     2188             end.
     2189           end.
     2190           if connected("ub") = true
     2191           then do:
     2192             run gbl/wndsizer.p
     2193               (input  v-cntxt-db-num
     2194               ,input  v-cntxt-userid
     2195               ,input  v-diasize-proc-name
     2196               ,input  'width':u
     2197               ,output v-resize-value-str
     2198               ) .
     2199             if v-resize-value-str <> '':U
     2200             then do:
     2201               run diasize_change-width in this-procedure
     2202                 (input  integer(v-resize-value-str)
     2203                 ,input  true
     2204                 ) .
     2205               assign
     2206                 v-restore-saved = true
     2207               .
     2208             end.
     2209           end.
     2210           if v-restore-saved <> true
     2211           then do:
     2212             if v-diasize-wndmax = true
     2213             then do:
     2214               run diasize_maximize in this-procedure
     2215                 (input  true
     2216                 ) .
     2217             end.
     2218           end.
     2219         end.
     2220         else do:
     2221           if v-diasize-wndmax = true
     2222           then do:
     2223             run diasize_maximize in this-procedure
     2224               (input  true
     2225               ) .
     2226           end.
     2227         end.
     2228       end.
     2229     end.
     2230   end procedure.
     2231   procedure diasize_need-full-display :
     2232     define output parameter p-need-full-display as logical   no-undo .
     2233     do
     2234     on error undo, return error return-value
     2235     :
     2236       assign
     2237         p-need-full-display = v-diasize-need-full-display
     2238       .
     2239       assign
     2240         v-diasize-need-full-display = false
     2241       .
     2242     end.
     2243   end procedure.
     2244   procedure get-context :
     2245      define output parameter p-db-num as integer          no-undo.
     2246      define output parameter p-user-id as character        no-undo.
     2247      define variable v-login               as character    no-undo.
     2248      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2249      define buffer buf_user-login  for ub.user-login .
     2250      do
     2251      on error undo, return error
     2252      :
     2253            FIND FIRST buf_sys-ctrl no-lock.
     2254            ASSIGN
     2255               v-login = USERID("ub")
     2256               p-db-num = buf_sys-ctrl.db-num
     2257            .
     2258            FIND FIRST buf_user-login
     2259                 WHERE buf_user-login.db-num = p-db-num
     2260                   AND buf_user-login.user-login = v-login
     2261                 no-lock
     2262                 no-error
     2263                 .
     2264            IF AVAILABLE buf_user-login
     2265            THEN DO:
     2266               assign
     2267                  p-user-id = buf_user-login.user-id
     2268               .
     2269            END.
     2270      end.
     2271   end procedure.
     2272       run diasize_init in this-procedure .
     2273   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2274   do:
     2275     Conn-List :SET-REPOSITIONED-ROW(15, "CONDITIONAL") .
     2276   end.
     2277   def var sort-labelConn-List   as character no-undo .
     2278   def var sort-clmnConn-List    as handle    no-undo .
     2279   def var cur-clmnConn-List     as handle    no-undo .
     2280   def var cur-clmn-locConn-List as integer   no-undo .
     2281   def var re-queryConn-List     as logical   initial no no-undo .
     2282   on start-search, ctrl-o of Conn-List in frame Dialog-Frame do:
     2283      run sort-brConn-List
     2284        (input (if available buf_fin-connect
     2285                then recid(buf_fin-connect)
     2286                else ?
     2287               )
     2288        ).
     2289   end.
     2290   PROCEDURE sort-brConn-List :
     2291     define input parameter p-recid as recid no-undo .
     2292     if re-queryConn-List = no then do:
     2293       assign
     2294          cur-clmnConn-List = Conn-List:current-column in frame Dialog-Frame
     2295       .
     2296       if sort-clmnConn-List <> ? then sort-clmnConn-List:column-fgcolor = 0.
     2297       if cur-clmnConn-List = sort-clmnConn-List then do:
     2298         assign
     2299            sort-labelConn-List = ""
     2300            sort-clmnConn-List = ?
     2301         .
     2302        end.
     2303        else do:
     2304          assign
     2305            sort-labelConn-List = cur-clmnConn-List:label
     2306            sort-clmnConn-List  = cur-clmnConn-List
     2307            sort-clmnConn-List:column-fgcolor = 4
     2308          .
     2309        end.
     2310      end.
     2311     assign
     2312       cur-clmn-locConn-List = 1
     2313     .
     2314     def var column-handle as handle no-undo .
     2315     column-handle = Conn-List:first-column.
     2316     do while valid-handle(column-handle) :
     2317       if column-handle = cur-clmnConn-List then do:
     2318         leave .
     2319       end.
     2320       column-handle = column-handle:NEXT-COLUMN.
     2321       assign
     2322         cur-clmn-locConn-List = cur-clmn-locConn-List + 1
     2323       .
     2324     end.
     2325     case sort-labelConn-List:
     2326           when 'Дата'  then DO:    assign       sort-column-name = "buf_fin-connect.fact-date"     .     run OpenBr(yes, no, '':U).   . END.
     2327           when 'Время'  then DO:    assign       sort-column-name = "string(buf_fin-connect.fact-time,'HH:MM')"     .     run OpenBr(yes, no, '':U).   . END.
     2328           when 'Связал'  then DO:    assign       sort-column-name = "usrfulnf(buf_fin-connect.user-name)"     .     run OpenBr(yes, no, '':U).   . END.
     2329           when '№ фин.об.'  then DO:    assign       sort-column-name = "buf_fin-ob.prn-doc-code"     .     run OpenBr(yes, no, '':U).   . END.
     2330           when 'Дата ф.об.'  then DO:    assign       sort-column-name = "buf_fin-ob.pay-date"     .     run OpenBr(yes, no, '':U).   . END.
     2331           when '№ платежа'  then DO:    assign       sort-column-name = "buf_fin-doc.prn-doc-code"     .     run OpenBr(yes, no, '':U).   . END.
     2332           when 'Дата плат.'  then DO:    assign       sort-column-name = "buf_fin-doc.doc-date"     .     run OpenBr(yes, no, '':U).   . END.
     2333           when 'Сумма в рубл.'  then DO:    assign       sort-column-name = "buf_fin-connect.sum-rubl"     .     run OpenBr(yes, no, '':U).   . END.
     2334           when 'Сумма в Б.вал.'  then DO:    assign       sort-column-name = "buf_fin-connect.sum-base"     .     run OpenBr(yes, no, '':U).   . END.
     2335           when 'Договор'  then DO:    assign       sort-column-name = "buf_contract.contract-prn-code"     .     run OpenBr(yes, no, '':U).   . END.
     2336           when 'Дата дог.'  then DO:    assign       sort-column-name = "buf_contract.contract-date"     .     run OpenBr(yes, no, '':U).   . END.
     2337           when 'Вн.N'  then DO:    assign       sort-column-name = "buf_fin-connect.connect-code"     .     run OpenBr(yes, no, '':U).   . END.
     2338           when 'Объект'  then DO:    assign       sort-column-name = "(if buf_fin-ob.obj-code = 0 then '' else (buf_fin-ob.obj-type + ' ' + string(buf_fin-ob.obj-code)))"     .     run OpenBr(yes, no, '':U).   . END.
     2339       otherwise do:
     2340         assign
     2341           sort-column-name = ""
     2342         .
     2343         run OpenBr(yes, no, '':U).
     2344           if can-do( this-procedure:internal-entries, 'mv-brw-defaultConn-List') then do:
     2345             run mv-brw-defaultConn-List.
     2346           end.
     2347         if sort-labelConn-List <> "" then do:
     2348           assign
     2349             cur-clmnConn-List:column-fgcolor = 0
     2350           .
     2351         end.
     2352         assign
     2353           cur-clmn-locConn-List = ?
     2354         .
     2355       end.
     2356     end case.
     2357       if cur-clmn-locConn-List <> ? then do:
     2358         if can-do( this-procedure:internal-entries, 'ch-clmnConn-List') then do:
     2359           run ch-clmnConn-List in this-procedure (cur-clmn-locConn-List).
     2360         end.
     2361       end.
     2362     if p-recid <> ? then do:
     2363       reposition Conn-List to recid p-recid no-error.
     2364       apply "value-changed" to Conn-List in frame Dialog-Frame.
     2365     end.
     2366     apply "entry" to Conn-List in frame Dialog-Frame.
     2367   END PROCEDURE.
     2368   procedure re-open-query-srt-clmnConn-List:
     2369   if cur-clmnConn-List = ? then do:
     2370      run OpenBr(yes, no, '':U).
     2371   end.
     2372   else do:
     2373      assign re-queryConn-List = yes.
     2374      run sort-brConn-List
     2375        (input (if available buf_fin-connect
     2376                then recid(buf_fin-connect)
     2377                else ?
     2378               )
     2379        ).
     2380      assign re-queryConn-List = no.
     2381   end.
     2382   end.
     2383   MAIN-BLOCK:
     2384   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2385      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2386   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
