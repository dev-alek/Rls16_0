     2398   on ' ' of sch-date in frame Dialog-Frame
     2399   do:
     2400     if (can-query (self, "sensitive")
     2401        and
     2402        self :sensitive = true
     2403        )
     2404     or (can-query (self, "read-only")
     2405        and
     2406        self :read-only = false
     2407        )
     2408     then do:
     2409       assign
     2410         self :screen-value = ?
     2411       .
     2412     end.
     2413     return no-apply.
     2414   end.
     2415   on delete-character of sch-date in frame Dialog-Frame
     2416   do:
     2417     if (can-query (self, "sensitive")
     2418        and
     2419        self :sensitive = true
     2420        )
     2421     or (can-query (self, "read-only")
     2422        and
     2423        self :read-only = false
     2424        )
     2425     then do:
     2426       assign
     2427         self :screen-value = ?
     2428       .
     2429     end.
     2430     return no-apply.
     2431   end.
     2432   on ctrl-d of sch-date in frame Dialog-Frame
     2433   do:
     2434     define variable v-curr-sv-date as date no-undo .
     2435     if (can-query (self, "sensitive")
     2436        and
     2437        self :sensitive = true
     2438        )
     2439     or (can-query (self, "read-only")
     2440        and
     2441        self :read-only = false
     2442        )
     2443     then do:
     2444       if self :handle <> focus :handle
     2445       then do:
     2446         apply "entry":u to self .
     2447       end.
     2448       run gbl/getcurdt.p
     2449         (output v-curr-sv-date
     2450         ) .
     2451       assign
     2452         self :screen-value = string(v-curr-sv-date) .
     2453       .
     2454     end.
     2455     return no-apply.
     2456   end.
     2457   on ctrl-b of sch-date in frame Dialog-Frame
     2458   do:
     2459     if (can-query (self, "sensitive")
     2460        and
     2461        self :sensitive = true
     2462        )
     2463     or (can-query (self, "read-only")
     2464        and
     2465        self :read-only = false
     2466        )
     2467     then do:
     2468       if self :handle <> focus :handle
     2469       then do:
     2470         apply "entry":u to self .
     2471       end.
     2472       define variable v-curr-sv-date as date no-undo .
     2473       define variable v-new-sv-date  as date no-undo .
     2474       assign
     2475         v-curr-sv-date = date(self :screen-value) no-error
     2476       .
     2477       if v-curr-sv-date = ?
     2478       then do:
     2479         run gbl/getcurdt.p
     2480           (output v-curr-sv-date
     2481           ) .
     2482       end.
     2483       if v-curr-sv-date <> ?
     2484       then do:
     2485         assign
     2486           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     2487         .
     2488         assign
     2489           self :screen-value = string(v-new-sv-date) .
     2490         .
     2491       end.
     2492     end.
     2493     return no-apply .
     2494   end.
     2495   on ctrl-e of sch-date in frame Dialog-Frame
     2496   do:
     2497     if (can-query (self, "sensitive")
     2498        and
     2499        self :sensitive = true
     2500        )
     2501     or (can-query (self, "read-only")
     2502        and
     2503        self :read-only = false
     2504        )
     2505     then do:
     2506       if self :handle <> focus :handle
     2507       then do:
     2508         apply "entry":u to self .
     2509       end.
     2510       define variable v-curr-sv-date as date no-undo .
     2511       define variable v-new-sv-date  as date no-undo .
     2512       assign
     2513         v-curr-sv-date = date(self :screen-value) no-error
     2514       .
     2515       if v-curr-sv-date = ?
     2516       then do:
     2517         run gbl/getcurdt.p
     2518           (output v-curr-sv-date
     2519           ) .
     2520       end.
     2521       if v-curr-sv-date <> ?
     2522       then do:
     2523         run gbl/lastdate.p
     2524           (input  v-curr-sv-date
     2525           ,output v-new-sv-date
     2526           ).
     2527         assign
     2528           self :screen-value = string(v-new-sv-date) .
     2529         .
     2530       end.
     2531     end.
     2532     return no-apply .
     2533   end.
     2534   on ctrl-f of sch-date in frame Dialog-Frame
     2535   do:
     2536     if (can-query (self, "sensitive")
     2537        and
     2538        self :sensitive = true
     2539        )
     2540     or (can-query (self, "read-only")
     2541        and
     2542        self :read-only = false
     2543        )
     2544     then do:
     2545       if self :handle <> focus :handle
     2546       then do:
     2547         apply "entry":u to self .
     2548       end.
     2549       define variable v-ok            as logical   no-undo .
     2550       define variable v-curr-sv-date  as date      no-undo .
     2551       define variable v-description   as character no-undo .
     2552       assign
     2553         v-curr-sv-date = date(self :screen-value) no-error
     2554       .
     2555       if v-curr-sv-date = ?
     2556       then do:
     2557         run gbl/getcurdt.p
     2558           (output v-curr-sv-date
     2559           ) .
     2560       end.
     2561       if v-curr-sv-date <> ?
     2562       then do:
     2563         run gbl/d-inpday.w
     2564           (input ?
     2565           ,input "Выбор даты"
     2566           ,input v-description
     2567           ,input ""
     2568           ,input-output v-curr-sv-date
     2569           ,output v-ok
     2570           ).
     2571         if v-ok = true
     2572         then do:
     2573           assign
     2574             self :screen-value = string(v-curr-sv-date) .
     2575           .
     2576         end.
     2577       end.
     2578     end.
     2579     return no-apply .
     2580   end.
     2581     define MENU m-ed-date15
     2582       MENU-ITEM m-ed-date15-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     2583       MENU-ITEM m-ed-date15-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     2584       MENU-ITEM m-ed-date15-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     2585       MENU-ITEM m-ed-date15-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     2586       .
