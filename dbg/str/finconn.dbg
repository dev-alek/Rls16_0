     2660   END.
     2661   RUN start-mv-clmnConn-List.
     2662   PROCEDURE start-mv-clmnConn-List:
     2663   def var old-session as logical no-undo.
     2664      old-session = SESSION:IMMEDIATE-DISPLAY.
     2665      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2666      SESSION:IMMEDIATE-DISPLAY = old-session.
     2667   END.
     2668   ON ctrl-cursor-right OF BROWSE Conn-List do:
     2669     RUN re-move-clmnConn-List ( 1, 12).
     2670   END.
     2671   ON ctrl-cursor-left OF BROWSE Conn-List do:
     2672     RUN re-move-clmnConn-List (12, 1).
     2673   END.
     2674   PROCEDURE re-move-clmnConn-List:
     2675     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2676     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2677     DO varmviConn-List = 1 TO EXTENT(cur-clmn-numConn-List):
     2678       if cur-clmn-numConn-List[varmviConn-List] = source-column THEN cur-clmn-numConn-List[varmviConn-List] = -1.
     2679     END.
     2680     if Conn-List:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2681     if source-column > target-column THEN
     2682     DO varmvjConn-List = source-column - 1 to target-column BY -1:
     2683       DO varmviConn-List = 1 TO EXTENT(cur-clmn-numConn-List):
     2684           if cur-clmn-numConn-List[varmviConn-List] = varmvjConn-List THEN DO:
     2685             cur-clmn-numConn-List[varmviConn-List] = cur-clmn-numConn-List[varmviConn-List] + 1.
     2686           END.
     2687       END.
     2688     END.
     2689     ELSE
     2690     DO varmvjConn-List = source-column + 1 to target-column:
     2691       DO varmviConn-List = 1 TO EXTENT(cur-clmn-numConn-List):
     2692         if cur-clmn-numConn-List[varmviConn-List] = varmvjConn-List THEN DO:
     2693           cur-clmn-numConn-List[varmviConn-List] = cur-clmn-numConn-List[varmviConn-List] - 1.
     2694         END.
     2695       END.
     2696     END.
     2697     DO varmviConn-List = 1 TO EXTENT(cur-clmn-numConn-List):
     2698       if cur-clmn-numConn-List[varmviConn-List] = -1 THEN cur-clmn-numConn-List[varmviConn-List] = target-column.
     2699     END.
     2700   END PROCEDURE.
     2701   PROCEDURE ch-clmnConn-List:
     2702     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2703     if cur-clmn-loc <= 1 then do:
     2704       return .
     2705     end.
     2706     DO varmviConn-List = 1 TO EXTENT(cur-clmn-numConn-List):
     2707       if cur-clmn-numConn-List[varmviConn-List] = cur-clmn-loc THEN move-elementConn-List = varmviConn-List.
     2708     END.
     2709     RUN re-move-clmnConn-List (cur-clmn-loc, 1).
     2710   END PROCEDURE.
     2711   PROCEDURE mv-brw-defaultConn-List:
     2712   def var old-session as logical no-undo.
     2713     old-session = SESSION:IMMEDIATE-DISPLAY.
     2714     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2715     do varmvlConn-List = 1 to EXTENT(cur-clmn-numConn-List):
     2716       RUN re-move-clmnConn-List (cur-clmn-numConn-List[varmvlConn-List], varmvlConn-List).
     2717     END.
     2718     RUN start-mv-clmnConn-List.
     2719     SESSION:IMMEDIATE-DISPLAY = old-session.
     2720   END PROCEDURE.
     2721   .
     2722     WAIT-FOR GO OF FRAME Dialog-Frame.
     2723   END.
     2724   RUN disable_UI.
     2725   PROCEDURE disable_UI :
     2726     HIDE FRAME Dialog-Frame.
     2727   END PROCEDURE.
     2728   PROCEDURE enable_UI :
     2729     DISPLAY Sel-Contr sch-date sch-user sch-code RADIO-find-doc mark-num
     2730         WITH FRAME Dialog-Frame.
     2731     ENABLE b-quit B-mark B-del b-sch B-view-fo B-view-doc Sel-Contr B-Help
     2732            Conn-List sch-date sch-user sch-code RADIO-find-doc mark-num
     2733         WITH FRAME Dialog-Frame.
     2734     VIEW FRAME Dialog-Frame.
     2735   END PROCEDURE.
