     3514   PROCEDURE proc-find-code :
     3515     define input parameter p-next as logical no-undo.
     3516     define input parameter p-code as integer no-undo .
     3517     display "  /  /":U @ sch-date  "":U @ sch-user  with frame Dialog-Frame.
     3518     if RADIO-find-doc = 1 then run OpenBr in this-procedure (input false, input p-next, input substitute("and buf_fin-connect.fin-ob-code = &1 ", p-code)).
     3519     else run OpenBr in this-procedure (input false, input p-next, input substitute("and buf_fin-connect.fin-doc-code = &1 ", p-code)).
     3520     apply "entry":u to sch-code in frame Dialog-Frame .
     3521   END PROCEDURE.
     3522   PROCEDURE proc-find-date :
     3523     define input parameter p-next as logical no-undo.
     3524     define input parameter par-date as date    no-undo .
     3525     display "":U @ sch-user  "":U @ sch-code  with frame Dialog-Frame.
     3526     define variable var-datechr as character no-undo .
     3527     assign var-datechr = string(day(par-date)) + chr(47) + string(month(par-date)) + chr(47) + string(year(par-date)) .
     3528     run OpenBr  in this-procedure (input false, input p-next,input substitute("and buf_fin-connect.fact-date = &1 ", var-datechr)) .
     3529     apply "entry":u to sch-date in frame Dialog-Frame .
     3530   END PROCEDURE.
     3531   PROCEDURE proc-find-user :
     3532     define input parameter p-next as logical no-undo.
     3533     define input parameter p-code as character no-undo .
     3534     display  "  /  /":U @ sch-date   "":U @ sch-code  with frame Dialog-Frame.
     3535     assign p-code = replace(p-code, chr(39), chr(39) + chr(39)) .
     3536     run OpenBr in this-procedure (input false, input p-next, input substitute("and buf_fin-connect.user-name = '&1' ", p-code)).
     3537     apply "entry":u to sch-user in frame Dialog-Frame .
     3538   END PROCEDURE.
     3539   FUNCTION mark-string RETURNS CHARACTER
     3540     ( input par-recid as recid ) :
     3541     define variable ret as character no-undo .
     3542     assign ret = "" .
     3543     find first temp-conn where temp-conn.ri = par-recid no-error .
     3544     if available temp-conn then assign ret = "*" .
     3545     RETURN ret .
     3546   END FUNCTION.
