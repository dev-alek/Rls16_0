     2588     then do:
     2589       ASSIGN
     2590         sch-date :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date15 :HANDLE
     2591         sch-date :MENU-MOUSE in frame Dialog-Frame = 3
     2592       .
     2593     end.
     2594     define variable v-label-handle15 as handle no-undo .
     2595     assign
     2596       v-label-handle15 = sch-date :side-label-handle in frame Dialog-Frame
     2597     .
     2598     if valid-handle (v-label-handle15)
     2599     then do:
     2600       if v-label-handle15 :tooltip = ""
     2601       or v-label-handle15 :tooltip = ?
     2602       then do:
     2603         assign
     2604           v-label-handle15 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     2605         .
     2606       end.
     2607     end.
     2608     ON CHOOSE OF MENU-ITEM m-ed-date15-1 in menu m-ed-date15 DO:
     2609       apply "ctrl-b":U to sch-date in frame Dialog-Frame .
     2610     END.
     2611     ON CHOOSE OF MENU-ITEM m-ed-date15-2 in menu m-ed-date15 DO:
     2612       apply "ctrl-d":U to sch-date in frame Dialog-Frame .
     2613     END.
     2614     ON CHOOSE OF MENU-ITEM m-ed-date15-3 in menu m-ed-date15 DO:
     2615       apply "ctrl-e":U to sch-date in frame Dialog-Frame .
     2616     END.
     2617     ON CHOOSE OF MENU-ITEM m-ed-date15-4 in menu m-ed-date15 DO:
     2618       apply "ctrl-f":U to sch-date in frame Dialog-Frame .
     2619     END.
     2620   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
