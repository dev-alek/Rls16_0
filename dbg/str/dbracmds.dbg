     3158   define variable  sort-phrase-rus-21  as character no-undo .
     3159     run waitfram-show in this-procedure
     3160       (input "ЖДИТЕ ..."
     3161       ).
     3162   run gbl/flt-get.p
     3163     (input filter-point
     3164     ,output flt-rec-21
     3165     ,output filter-name-21
     3166     ,output where-phrase-21
     3167     ,output sort-phrase-21
     3168     ,output where-phrase-rus-21
     3169     ,output sort-phrase-rus-21
     3170     ).
     3171   if p-open-query then do:
     3172       run set-filter-name in this-procedure
     3173         (INPUT filter-name-21
     3174         ) no-error .
     3175     assign
     3176       l-filter-open-21 = false
     3177     .
     3178     if flt-rec-21 <> ?
     3179       or sort-column-phrase > ""
     3180     then do:
     3181       define variable  parameter-2-21 as character no-undo .
     3182       define variable  parameter-3-21 as character no-undo .
     3183       define variable  parameter-4-21 as character no-undo .
     3184       define variable  parameter-5-21 as character no-undo .
     3185       define variable  parameter-6-21 as character no-undo .
     3186       define variable  parameter-7-21 as character no-undo .
     3187         assign
     3188         parameter-3-21 =
     3189                                 "FOR EACH X_db-rec-attr"
     3190         parameter-4-21 =
     3191           (
     3192             if (" TRUE " + " " + where-phrase-21) <> ""
     3193             then " TRUE " + " " + where-phrase-21
     3194             else "true"
     3195           )
     3196         parameter-5-21 = (" " + "" + " " + "")
     3197         parameter-6-21 = if sort-phrase-21 = ''
     3198                              then
     3199           (
     3200           " " + "  " +
     3201             " " + sort-column-phrase +
     3202           " " + "  "
     3203           )
     3204                              else
     3205           (
     3206           " " + "  " +
     3207             " " + sort-column-phrase +
     3208           " " + sort-phrase-21
     3209           )
     3210         parameter-7-21 =
     3211           " indexed-reposition  "
     3212       .
     3213       do
     3214       on stop undo, leave
     3215       on error undo, leave
     3216       :
     3217         assign
     3218           l-disable-where-21 =
     3219             (" TRUE " + " " + where-phrase-21 = "")
     3220         .
     3221         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3222                             ,input QUERY br-db-rec-attr:handle
     3223                             ,input parameter-3-21
     3224                             ,input parameter-4-21
     3225                             ,input parameter-5-21
     3226                             ,input parameter-6-21
     3227                             ,input parameter-7-21
     3228                             )
     3229         .
     3230         assign
     3231           l-filter-open-21 = true
     3232         .
     3233       end.
     3234       if l-filter-open-21 = false then do:
     3235         message
     3236           "Ошибка при фильтрации / сортировке" skip
     3237           "Будут показаны записи без учета фильтра" skip
     3238           view-as alert-box .
     3239       end.
     3240       else do:
     3241           assign
     3242             l-query-was-opened = true
     3243           .
     3244       end.
     3245     end.
     3246     if l-filter-open-21 = false then do:
     3247       OPEN QUERY br-db-rec-attr FOR EACH X_db-rec-attr
     3248         where  TRUE
     3249         indexed-reposition
     3250     .
     3251         assign
     3252           l-query-was-opened = true
     3253         .
     3254     end.
     3255   end.
     3256   else do:
     3257     assign
     3258       v-doc-rec = recid( X_db-rec-attr )
     3259     .
     3260     do
     3261     on stop undo, leave
     3262     on error undo, leave
     3263     :
     3264       if QUERY br-db-rec-attr:handle:get-buffer-handle(1) = (buffer X_db-rec-attr:handle) then do:
     3265         assign
