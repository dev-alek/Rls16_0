        1   DEFINE BUFFER X_db FOR ub.db.
        2   DEFINE BUFFER X_db-rec-attr FOR ub.db-rec-attr.
        3   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        4   define input parameter bttns  as char   no-undo .
        5   define input parameter p-mode  as char   no-undo .
        6   define input parameter p-db-num         LIKE ub.db-rec-attr.db-num no-undo .
        7   define input parameter p-attr-code         LIKE ub.db-rec-attr.attr-code no-undo .
        8   define input parameter p-uniq-key-rec      LIKE ub.db-rec-attr.uniq-key-rec no-undo .
        9   define input-output param p-rid-list    as  char no-undo .
       10   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       11   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       12   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       13   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       14   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
       15   define variable vss-description AS CHAR NO-UNDO INIT "Выполняющиеся распределенные команды СПН":U.
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   procedure progs-name :
       87     define input  parameter p-action-code         as character no-undo .
       88     define output parameter p-main-prog-name      as character no-undo .
       89     define output parameter p-list-db-proc-name   as character no-undo .
       90     define output parameter p-commit-proc-name    as character no-undo .
       91     define output parameter p-execution-proc-name as character no-undo .
       92     define output parameter p-recover-proc-name   as character no-undo .
       93     define output parameter p-after-proc-name     as character no-undo .
       94     do
       95     on error undo, return error
       96     :
       97       case p-action-code :
       98               when 'crush_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-crush-cdrg':U       p-execution-proc-name = 'exec-crush-cdrg':U       p-recover-proc-name   = 'rcvr-crush-cdrg':U       p-after-proc-name     = '':U     .   end.
       99               when 'delete_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-del-cdrg':U       p-execution-proc-name = 'exec-del-cdrg':U       p-recover-proc-name   = 'rcvr-del-cdrg':U       p-after-proc-name     = '':U     .   end.
      100               when 'delete_nu-prt-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-prt-bar-code':U       p-execution-proc-name = 'delete-prt-bar-code':U       p-recover-proc-name   = 'undo-delete-prt-bar-code':U       p-after-proc-name     = '':U     .   end.
      101               when 'delete_nu-part-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-part-bar-code':U       p-execution-proc-name = 'delete-part-bar-code':U       p-recover-proc-name   = 'undo-delete-part-bar-code':U       p-after-proc-name     = '':U     .   end.
      102               when 'delete_nu-ucli-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-ucli-bar-code':U       p-execution-proc-name = 'delete-ucli-bar-code':U       p-recover-proc-name   = 'undo-delete-ucli-bar-code':U       p-after-proc-name     = '':U     .   end.
      103               when 'delete_nu-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-del-dis-card':U       p-execution-proc-name = 'delete-dis-card':U       p-recover-proc-name   = 'undo-delete-dis-card':U       p-after-proc-name     = '':U     .   end.
      104               when 'chown-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-chown-dis-card':U       p-execution-proc-name = 'chown-dis-card':U       p-recover-proc-name   = 'undo-chown-dis-card':U       p-after-proc-name     = 'after-chown-dis-card':U     .   end.
      105               when 'delete_nu-dis-rule':U then do:     assign       p-main-prog-name      = 'trg/dis-rult.p':U       p-list-db-proc-name   = 'trg/disruldb.p':U       p-commit-proc-name    = 'block-del-dis-rule':U       p-execution-proc-name = 'delete-dis-rule':U       p-recover-proc-name   = 'undo-delete-dis-rule':U       p-after-proc-name     = '':U     .   end.
      106               when 'ren-art':U then do:     assign       p-main-prog-name      = 'trg/goodst.p':U       p-list-db-proc-name   = 'utl/renartcd.p':U       p-commit-proc-name    = 'comm-ren-art':U       p-execution-proc-name = 'exec-ren-art':U       p-recover-proc-name   = 'rcvr-ren-art':U       p-after-proc-name     = 'after-ren-art':U     .   end.
      107               when 'delete_nu-clob-data':U then do:     assign       p-main-prog-name      = 'trg/clobdatt.p':U       p-list-db-proc-name   = 'trg/clbdatdb.p':U       p-commit-proc-name    = 'block-del-clob-data':U       p-execution-proc-name = 'delete-clob-data':U       p-recover-proc-name   = 'undo-delete-clob-data':U       p-after-proc-name     = '':U     .   end.
      108               when 'delete_nu-layout':U then do:     assign       p-main-prog-name      = 'trg/layoutt.p':U       p-list-db-proc-name   = 'trg/layoutdb.p':U       p-commit-proc-name    = 'block-del-layout':U       p-execution-proc-name = 'delete-layout':U       p-recover-proc-name   = 'undo-delete-layout':U       p-after-proc-name     = '':U     .   end.
      109               otherwise do:
      110           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info0, p-action-code ).
      111         end.
      112       end case.
      113     end.
      114     return.
      115   end procedure.
      116   procedure progs-title :
      117     define input  parameter p-action-code         as character no-undo .
      118     define output parameter p-action-title      as character no-undo .
      119     do
      120     on error undo, return error
      121     :
      122       case p-action-code :
      123               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
      124               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
      125               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
      126               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
      127               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
      128               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
      129               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
      130               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
      131               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
      132               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
      133               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
      134               otherwise do:
      135           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info0, p-action-code ).
      136         end.
      137       end case.
      138     end.
      139     return.
      140   end procedure.
      141   FUNCTION progs-title-function returns character(
      142      input  p-action-code         as character):
      143   define variable p-action-title      as character no-undo .
      144     do
      145     on error undo, return error
      146     :
      147       case p-action-code :
      148               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
      149               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
      150               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
      151               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
      152               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
      153               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
      154               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
      155               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
      156               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
      157               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
      158               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
      159               otherwise do:
      160           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info0, p-action-code ).
      161         end.
      162       end case.
      163     end.
      164     return p-action-title.
      165   end FUNCTION.
      166   procedure get-row-keyr-string :
      167    define input  parameter p-key-rec  as character no-undo.
      168    define output parameter p-tbl-title as character no-undo.
      169    define output parameter p-rec-string  as character no-undo.
      170     do
      171     on error undo, return error
      172     :
      173       define variable v-full-tbl-name as character no-undo .
      174       define variable bh_tbl-name     as handle    no-undo .
      175       define variable fh              as handle    no-undo .
      176       define variable v-ok            as logical   no-undo .
      177       define variable v-field-num     as integer   no-undo .
      178       define variable v-count-fld     as integer   no-undo .
      179       define variable v-tbl-name as character no-undo.
      180       if p-key-rec = ?
      181         or p-key-rec = "":U
      182       then do:
      183         return error substitute( "&1 (get-row-keyr-string). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      184       end.
      185       assign
      186         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      187         v-full-tbl-name = "ub.":U + v-tbl-name
      188         v-field-num     = num-entries( p-key-rec, chr(3) ) - 1
      189         p-rec-string         = "":U
      190         v-count-fld     = 0
      191       .
      192       find ub._file
      193         where ub._file._file-name = v-tbl-name
      194         no-error.
      195       if not available ub._file then do:
      196         return error substitute( "&1. Таблица &2 отсутствует в БД", vss-include-info0, v-tbl-name ).
      197       end.
      198       assign
      199       p-tbl-title = ub._file._file-label
      200       .
      201       find ub._index
      202         where recid( ub._index  ) = ub._file._prime-index
      203         no-error.
      204       if not available ub._index
      205         or LC( ub._index._index-name ) = "default":U
      206       then do:
      207         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      208       end.
      209       block_where :
      210       for each ub._index-field of ub._index  ,
      211           each ub._field of _index-field
      212           break by _index-seq
      213       on error undo, return error
      214       :
      215         assign
      216           v-count-fld = v-count-fld + 1
      217         .
      218         if v-count-fld > v-field-num then do:
      219           leave block_where.
      220         end.
      221         if p-rec-string = "":U then do:
      222           assign
      223             p-rec-string = "":U
      224           .
      225         end.
      226         else do:
      227           assign
      228             p-rec-string = p-rec-string + chr(32) + chr(44)
      229           .
      230         end.
      231         assign
      232           p-rec-string = p-rec-string + (if p-rec-string = "":u then "":U else chr(32)) + substitute( "&1 = &2":U, ub._field._label, entry( v-count-fld + 1 , p-key-rec, chr(3) ) )
      233         .
      234       end.
      235       if v-count-fld <> v-field-num then do:
      236         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      237       end.
      238     end.
      239     return.
      240   end procedure.
      241   FUNCTION uniq-key-rec-string-f returns character(
      242      input  p-uniq-key-rec         as character):
      243   define variable v-tbl-title as character no-undo .
      244   define variable v-rec-string as character no-undo .
      245     do
      246     on error undo, return error
      247     :
      248       run get-row-keyr-string in this-procedure (
      249                                                 input p-uniq-key-rec
      250                                                 ,output v-tbl-title
      251                                                 ,output v-rec-string).
      252       assign
      253       v-rec-string = (if v-tbl-title <> ? and
      254                       v-tbl-title <> "":U
      255                       then (v-tbl-title + ":")
      256                      else "":U) + chr(32) + v-rec-string
      257       .
      258     end.
      259     return v-rec-string.
      260   end FUNCTION.
      261   procedure create_db-rec_route :
      262     define input parameter p1-uniq-key-rec as character no-undo .
      263     define input parameter p1-action       as character no-undo .
      264     define input parameter p1-operation    as character no-undo .
      265     define input parameter p1-send-db-list as character no-undo .
      266     define input parameter p1-db-init      as integer   no-undo .
      267     define input parameter p1-parameters   as character no-undo .
      268     define input parameter p1-answer-code  as integer   no-undo .
      269     define input parameter p1-answer-msg   as character no-undo .
      270     do
      271     on error undo, return error
      272     :
      273       define variable v-command     as character no-undo .
      274       define variable v-ind         as integer   no-undo .
      275       define variable v-num-entries as integer   no-undo .
      276       define variable v-curr-db     as integer   no-undo .
      277       define variable v-db-for-send as character no-undo .
      278       define variable v-db-num      as integer   no-undo .
      279       define variable v-db-num-char as character no-undo .
      280       define buffer buf_sys-ctrl    for ub.sys-ctrl .
      281       find first buf_sys-ctrl no-lock .
      282       assign
      283         v-curr-db     = buf_sys-ctrl.db-num
      284         v-db-for-send = "":U
      285       .
      286       if v-curr-db = 0 then do:
      287         if p1-answer-code >= 0 then do:
      288           if v-curr-db <> p1-db-init then do:
      289             assign
      290               v-db-for-send = string( p1-db-init )
      291             .
      292           end.
      293         end.
      294         else do:
      295           assign
      296             v-num-entries = num-entries( p1-send-db-list, chr(44) )
      297           .
      298           do v-ind = 1 to v-num-entries:
      299             assign
      300               v-db-num-char = entry( v-ind, p1-send-db-list, chr(44) )
      301               v-db-num      = integer( v-db-num-char )
      302             .
      303             if v-db-num <> v-curr-db
      304               and v-db-num <> p1-db-init
      305             then do:
      306               if v-db-for-send = "":U then do:
      307                 assign
      308                   v-db-for-send = v-db-num-char
      309                 .
      310               end.
      311               else do:
      312                 assign
      313                   v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
      314                 .
      315               end.
      316             end.
      317           end.
      318         end.
      319       end.
      320       else do:
      321         assign
      322           v-db-for-send = "0":U
      323         .
      324       end.
      325       if v-db-for-send <> "":U then do:
      326         assign
      327           v-command = "command":U + chr(1)
      328                       + "two-commit":U + chr(1)
      329                       + p1-action + chr(1)
      330                       + p1-operation + chr(1)
      331                       + p1-uniq-key-rec + chr(1)
      332                       + string( p1-db-init ) + chr(1)
      333                       + p1-parameters + chr(1)
      334                       + string( p1-answer-code ) + chr(1)
      335                       + p1-answer-msg
      336         .
      337         run nws/cr-route.p ( input 'send-cmd':U
      338                       ,input v-command
      339                       ,input ?
      340                       ,input v-db-for-send
      341                       ) no-error .
      342         if error-status :error then do:
      343           return error return-value.
      344         end.
      345       end.
      346     end.
      347     return.
      348   end procedure.
      349   procedure create_msg_route :
      350     define input parameter p2-send-db-list as character no-undo .
      351     define input parameter p2-msg          as character no-undo .
      352     do
      353     on error undo, return error
      354     :
      355       define variable v-msg-command as character no-undo .
      356       define variable v-ind         as integer   no-undo .
      357       define variable v-num-entries as integer   no-undo .
      358       define variable v-curr-db     as integer   no-undo .
      359       define variable v-db-for-send as character no-undo .
      360       define variable v-db-num      as integer   no-undo .
      361       define variable v-db-num-char as character no-undo .
      362       define buffer buf_sys-ctrl    for ub.sys-ctrl .
      363       find first buf_sys-ctrl no-lock .
      364       assign
      365         v-curr-db     = buf_sys-ctrl.db-num
      366         v-db-for-send = "":U
      367       .
      368       if v-curr-db = 0 then do:
      369         assign
      370           v-num-entries = num-entries( p2-send-db-list, chr(44) )
      371         .
      372         do v-ind = 1 to v-num-entries:
      373           assign
      374             v-db-num-char = entry( v-ind, p2-send-db-list, chr(44) )
      375             v-db-num      = integer( v-db-num-char )
      376           .
      377           if v-db-num <> v-curr-db then do:
      378             if v-db-for-send = "":U then do:
      379               assign
      380                 v-db-for-send = v-db-num-char
      381               .
      382             end.
      383             else do:
      384               assign
      385                 v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
      386               .
      387             end.
      388           end.
      389         end.
      390       end.
      391       else do:
      392         assign
      393           v-db-for-send = "0":U
      394         .
      395       end.
      396       if v-db-for-send <> "":U then do:
      397         assign
      398           v-msg-command = "command":U + chr(1)
      399                           + "message-to-log":U + chr(1)
      400                           + p2-msg
      401         .
      402         run nws/cr-route.p ( input 'send-cmd':U
      403                       ,input v-msg-command
      404                       ,input ?
      405                       ,input v-db-for-send
      406                       ) no-error .
      407         if error-status :error then do:
      408           return error substitute( "&1&2&3"
      409                                     , return-value
      410                                     , chr(10)
      411                                     , error-status :get-message(1)
      412                                   ).
      413         end.
      414       end.
      415     end.
      416     return.
      417   end procedure.
      418   function get-send-db-list returns character
      419     ( input p-curr-db     as integer
      420      ,input p-all-db-list as character
      421     )
      422   :
      423     define variable v-send-db-list as character no-undo .
      424     if p-curr-db = 0 then do:
      425       assign
      426         v-send-db-list = p-all-db-list
      427       .
      428     end.
      429     else do:
      430       assign
      431         v-send-db-list = string(p-curr-db)
      432       .
      433     end.
      434     return v-send-db-list .
      435   end function .
      436   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      437   procedure gen-key-rec :
      438     define input  parameter p-tbl-name    as character no-undo.
      439     define input  parameter p-bh_tbl-name as handle    no-undo.
      440     define output parameter p-key-rec     as character no-undo.
      441     do
      442     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      443     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      444     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      445     :
      446       define variable fh               as handle    no-undo .
      447       define variable v-ok             as logical   no-undo .
      448       define variable v-inform         as character no-undo .
      449       define variable v-ind            as integer   no-undo .
      450       define variable v-idx-field-qnty as integer   no-undo .
      451       if p-tbl-name = ?
      452         or p-tbl-name = "":U
      453       then do:
      454         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
      455       end.
      456       if not p-bh_tbl-name:available then do:
      457         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
      458       end.
      459       assign
      460         p-key-rec = p-tbl-name
      461         v-inform  = p-bh_tbl-name:index-information(1)
      462         v-ind     = 2
      463       .
      464       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      465       on error undo, return error
      466       :
      467         assign
      468           v-inform = p-bh_tbl-name:index-information( v-ind )
      469           v-ind    = v-ind + 1
      470         .
      471       end.
      472       if v-inform = ?
      473         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      474         or entry( 3, v-inform, ",":U ) <> "1":U
      475       then do:
      476         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
      477       end.
      478       else do:
      479         assign
      480           v-idx-field-qnty = num-entries( v-inform ) - 4
      481         .
      482         if v-idx-field-qnty < 2 then do:
      483           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
      484         end.
      485         do v-ind = 1 to v-idx-field-qnty by 2
      486         on error undo, return error
      487         :
      488           assign
      489             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      490             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      491           .
      492         end.
      493       end.
      494       if p-key-rec = ? then do:
      495         assign
      496           p-key-rec = "":U
      497         .
      498         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
      499       end.
      500     end.
      501     return.
      502   end procedure.
      503   procedure gen-where-keyr-tab :
      504     define input  parameter i-tableSerach as character no-undo.
      505     define input  parameter i-tablekey   as character  no-undo.
      506     define input  parameter p-key-rec    as character  no-undo.
      507     define input  parameter p-key-handle as handle     no-undo .
      508     define input  parameter p-db-name    as character  no-undo .
      509     define input  parameter p-tt-handle  as handle     no-undo .
      510     define output parameter o-Where      as character  no-undo.
      511     do
      512     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      513     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      514     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      515     :
      516       define variable v-full-tbl-name  as character no-undo .
      517       define variable bh_tbl-name      as handle    no-undo .
      518       define variable fh_key           as handle    no-undo .
      519       define variable fh_search        as handle    no-undo .
      520       define variable v-field-num      as integer   no-undo .
      521       define variable v-count-fld      as integer   no-undo .
      522       define variable v-inform         as character no-undo .
      523       define variable v-ind            as integer   no-undo .
      524       define variable v-idx-field-qnty as integer   no-undo .
      525       define variable v-field-name     as character no-undo .
      526       define variable v-field-val      as character no-undo .
      527       define variable v-word-link      as character no-undo .
      528       define variable vTable           as character no-undo.
      529       define variable bh_tbl-key       as handle    no-undo .
      530       assign
      531         p-key-rec = trim( p-key-rec )
      532       .
      533       if p-key-handle <> ? then do:
      534         if not valid-handle(p-key-handle)
      535            or p-key-handle:type <> "buffer"
      536         then do:
      537           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      538         end.
      539         if num-entries( p-key-rec, chr(3) ) > 1
      540           or p-key-rec = ?
      541           or p-key-rec = "":U
      542         then do:
      543           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      544         end.
      545       end.
      546       else do:
      547         if p-key-rec = ?
      548           or p-key-rec = "":U
      549         then do:
      550           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      551         end.
      552       end.
      553       assign
      554         vTable = entry( 1 , p-key-rec, chr(3) )
      555       .
      556       if p-tt-handle <> ?
      557         and ( not valid-handle(p-tt-handle)
      558               or p-tt-handle:type <> "buffer"
      559             )
      560       then do:
      561         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      562       end.
      563       if p-tt-handle = ? then do:
      564         assign
      565           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      566         .
      567         create buffer bh_tbl-name for table v-full-tbl-name .
      568       end.
      569       else do:
      570         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      571       end.
      572       assign
      573         v-inform = bh_tbl-name:index-information(1)
      574         v-ind    = 2
      575       .
      576       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      577       on error undo, return error
      578       :
      579         assign
      580           v-inform = bh_tbl-name:index-information( v-ind )
      581           v-ind    = v-ind + 1
      582         .
      583       end.
      584       if v-inform = ?
      585         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      586         or entry( 3, v-inform, ",":U ) <> "1":U
      587       then do:
      588         delete object bh_tbl-name no-error.
      589         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      590       end.
      591       assign
      592         v-idx-field-qnty = num-entries( v-inform ) - 4
      593       .
      594       if v-idx-field-qnty < 2 then do:
      595         delete object bh_tbl-name no-error.
      596         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      597       end.
      598       assign
      599         o-where     = "where":U
      600         v-word-link = "":U
      601         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      602         v-count-fld = 0
      603       .
      604       if i-tablekey ne "" and i-tablekey ne ?
      605       then do:
      606         assign
      607           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      608         .
      609         create buffer bh_tbl-key for table v-full-tbl-name .
      610       end.
      611       if i-tableSerach ne "" and i-tableSerach ne ?
      612       then do:
      613         delete object bh_tbl-name no-error.
      614         assign
      615           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      616         .
      617         create buffer bh_tbl-name for table v-full-tbl-name .
      618       end.
      619       block_where:
      620       do v-ind = 1 to v-idx-field-qnty by 2
      621       on error undo, return error
      622       :
      623         assign
      624           v-count-fld = v-count-fld + 1
      625         .
      626         if p-key-handle = ?
      627           and v-count-fld > v-field-num
      628         then do:
      629           leave block_where.
      630         end.
      631         define variable VfieldKeyTable as handle no-undo.
      632         assign
      633           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      634           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      635         .
      636         if     bh_tbl-key ne ?
      637         then do:
      638            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      639            if VfieldKeyTable eq ?
      640            then next block_where.
      641         end.
      642         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      643         then
      644            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      645         else
      646            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      647         if p-key-handle = ? then do:
      648           assign
      649             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      650           .
      651         end.
      652         else do:
      653           assign
      654             fh_key = p-key-handle:buffer-field( v-field-name )
      655           .
      656           if fh_key = ?
      657             or not valid-handle( fh_key )
      658           then do:
      659             delete object bh_tbl-name.
      660             if     bh_tbl-key ne ?
      661             then
      662                delete object bh_tbl-key.
      663             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      664           end.
      665           assign
      666             v-field-val = fh_key:buffer-value
      667           .
      668         end.
      669         if fh_search:data-type ="character":U then do:
      670           assign
      671             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      672             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      673             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      674             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      675             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      676             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      677             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      678             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      679             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      680             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      681             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      682             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      683             v-field-val = substitute( '"&1"', v-field-val )
      684           .
      685         end.
      686         assign
      687           o-where = substitute( "&1 &2", o-where, v-field-val )
      688         .
      689         if v-word-link = "":U then do:
      690           assign
      691             v-word-link = "and":U
      692           .
      693         end.
      694       end.
      695       delete object bh_tbl-name.
      696       if     bh_tbl-key ne ?
      697       then
      698          delete object bh_tbl-key.
      699       if p-key-handle = ?
      700         and v-count-fld <> v-field-num
      701       then do:
      702         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      703       end.
      704     end.
      705   end procedure.
      706   procedure gen-hn-keyr-tab :
      707     define input  parameter i-tableSerach as character no-undo.
      708     define input  parameter i-tablekey   as character no-undo.
      709     define input  parameter p-key-rec    as character no-undo.
      710     define input  parameter p-key-handle as handle    no-undo .
      711     define input  parameter p-db-name    as character no-undo .
      712     define input  parameter p-tt-handle  as handle    no-undo .
      713     define input  parameter p-stts-lock  as integer   no-undo .
      714     define output parameter o-hn         as handle    no-undo.
      715     define variable v-full-tbl-name as character no-undo.
      716     define variable v-where         as character no-undo.
      717     define variable bh_tbl-name     as handle    no-undo.
      718     define variable vTable          as character no-undo.
      719     do
      720     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      721     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      722     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      723         run gen-where-keyr-tab(i-tableSerach,
      724                                i-tablekey,
      725                                p-key-rec,
      726                                p-key-handle,
      727                                p-db-name,
      728                                p-tt-handle,
      729                                output v-where).
      730         if i-tableSerach ne "" and i-tableSerach ne ?
      731         then do:
      732            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      733            create buffer bh_tbl-name for table v-full-tbl-name .
      734         end.
      735         else do:
      736            if p-tt-handle = ? then do:
      737               assign
      738                  vTable = entry( 1 , p-key-rec, chr(3) )
      739               .
      740               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      741               create buffer bh_tbl-name for table v-full-tbl-name .
      742            end.
      743            else do:
      744               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      745            end.
      746         end.
      747         if p-tt-handle = ? then do:
      748            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      749         end.
      750         else do:
      751            bh_tbl-name:find-first( v-where ) no-error .
      752         end.
      753         o-hn = bh_tbl-name.
      754      end.
      755   end procedure.
      756   procedure gen-hn-keyr :
      757     define input  parameter p-key-rec    as character no-undo.
      758     define input  parameter p-key-handle as handle    no-undo .
      759     define input  parameter p-db-name    as character no-undo .
      760     define input  parameter p-tt-handle  as handle    no-undo .
      761     define input  parameter p-stts-lock  as integer   no-undo .
      762     define output parameter o-hn         as handle    no-undo.
      763     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      764   end.
      765   procedure gen-row-keyr :
      766     define input  parameter p-key-rec    as character no-undo.
      767     define input  parameter p-key-handle as handle    no-undo .
      768     define input  parameter p-db-name    as character no-undo .
      769     define input  parameter p-tt-handle  as handle    no-undo .
      770     define input  parameter p-stts-lock  as integer   no-undo .
      771     define output parameter p-tbl-row    as rowid     no-undo.
      772     define output parameter p-tbl-name   as character no-undo.
      773     define variable vHn as handle no-undo.
      774       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      775       p-tbl-row = if vHn:available then vHn:rowid else ?.
      776       p-tbl-name =  vHn:table.
      777       delete object vHn no-error.
      778     if p-tbl-row = ? then do:
      779       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      780     end.
      781     else do:
      782       return.
      783     end.
      784   end procedure.
      785   procedure gen-key-fv :
      786     define input  parameter p-key-rec    as character no-undo .
      787     define output parameter p-field-list as character no-undo .
      788     define output parameter p-value-list as character no-undo.
      789     do
      790     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      791     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      792     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      793     :
      794       define variable v-full-tbl-name  as character no-undo .
      795       define variable bh_tbl-name      as handle    no-undo .
      796       define variable v-tbl-name       as character no-undo .
      797       define variable v-field-num      as integer   no-undo .
      798       define variable v-count-fld      as integer   no-undo .
      799       define variable v-inform         as character no-undo .
      800       define variable v-ind            as integer   no-undo .
      801       define variable v-idx-field-qnty as integer   no-undo .
      802       define variable v-delim-key      as character no-undo .
      803       if p-key-rec = ?
      804         or p-key-rec = "":U
      805       then do:
      806         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      807       end.
      808       assign
      809         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      810         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      811       .
      812       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      813       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      814       assign
      815         v-inform = bh_tbl-name:index-information(1)
      816         v-ind    = 2
      817       .
      818       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      819       on error undo, return error
      820       :
      821         assign
      822           v-inform = bh_tbl-name:index-information( v-ind )
      823           v-ind    = v-ind + 1
      824         .
      825       end.
      826       if v-inform = ?
      827         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      828         or entry( 3, v-inform, ",":U ) <> "1":U
      829       then do:
      830         delete object bh_tbl-name no-error.
      831         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      832       end.
      833       assign
      834         v-idx-field-qnty = num-entries( v-inform ) - 4
      835       .
      836       if v-idx-field-qnty < 2 then do:
      837         delete object bh_tbl-name no-error.
      838         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      839       end.
      840       assign
      841         p-field-list = "":U
      842         p-value-list = "":U
      843         v-delim-key  = "":U
      844         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      845         v-count-fld  = 0
      846       .
      847       block_where:
      848       do v-ind = 1 to v-idx-field-qnty by 2
      849       on error undo, return error
      850       :
      851         assign
      852           v-count-fld = v-count-fld + 1
      853         .
      854         if v-count-fld > v-field-num then do:
      855           leave block_where.
      856         end.
      857         assign
      858           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      859           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      860         .
      861         if v-ind = 1 then do:
      862           assign
      863             v-delim-key = chr(3)
      864           .
      865         end.
      866       end.
      867       delete object bh_tbl-name.
      868       if v-count-fld <> v-field-num then do:
      869         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      870       end.
      871     end.
      872   end procedure.
      873   procedure gen-key-field :
      874     define input  parameter p-table      as character no-undo .
      875     define output parameter p-field-list as character no-undo .
      876     do
      877     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      878     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      879     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      880     :
      881       define variable v-full-tbl-name  as character no-undo .
      882       define variable bh_tbl-name      as handle    no-undo .
      883       define variable v-tbl-name       as character no-undo .
      884       define variable v-field-num      as integer   no-undo .
      885       define variable v-count-fld      as integer   no-undo .
      886       define variable v-inform         as character no-undo .
      887       define variable v-ind            as integer   no-undo .
      888       define variable v-idx-field-qnty as integer   no-undo .
      889       define variable v-delim-key      as character no-undo .
      890       if p-table = ?
      891         or p-table = "":U
      892       then do:
      893         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      894       end.
      895       assign
      896         v-tbl-name      = p-table
      897         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      898       .
      899       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      900       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      901       assign
      902         v-inform = bh_tbl-name:index-information(1)
      903         v-ind    = 2
      904       .
      905       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      906       on error undo, return error
      907       :
      908         assign
      909           v-inform = bh_tbl-name:index-information( v-ind )
      910           v-ind    = v-ind + 1
      911         .
      912       end.
      913       if v-inform = ?
      914         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      915         or entry( 3, v-inform, ",":U ) <> "1":U
      916       then do:
      917         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      918       end.
      919       assign
      920         v-idx-field-qnty = num-entries( v-inform ) - 4
      921       .
      922       if v-idx-field-qnty < 2 then do:
      923         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      924       end.
      925       assign
      926         p-field-list = "":U
      927         v-delim-key  = "":U
      928         v-count-fld  = 0
      929       .
      930       block_where:
      931       do v-ind = 1 to v-idx-field-qnty by 2
      932       on error undo, return error
      933       :
      934         assign
      935           v-count-fld = v-count-fld + 1
      936         .
      937         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      938         if v-ind = 1 then do:
      939           assign
      940             v-delim-key = chr(3)
      941           .
      942         end.
      943       end.
      944       delete object bh_tbl-name.
      945     end.
      946   end procedure.
      947   procedure proc-alt-shift-f2:
      948     if not ibs.th.gbl.gbl-var:rcode
      949   then
      950     run gbl\inidebug.p .
      951   end.
      952   procedure proc-alt-shift-f3:
      953     run gbl/prvssinf.p
      954       ( input this-procedure
      955       ) .
      956   end.
      957   define variable v-inform-launched as logical no-undo initial false .
      958   procedure proc-alt-shift-f4:
      959     define variable v-action as character no-undo .
      960     if v-inform-launched = false then do:
      961       assign
      962         v-inform-launched = true
      963       .
      964       run gbl/d-inform.w
      965         (  input self
      966         ,  input this-procedure
      967         , output v-action
      968         ) no-error .
      969       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      970       assign
      971         v-inform-launched = false
      972       .
      973     end.
      974   end.
      975   procedure proc-alt-f1:
      976     run gbl/corrhelp.p
      977       (input this-procedure
      978       ) .
      979   end .
      980   on alt-shift-f2 anywhere do:
      981     run proc-alt-shift-f2.
      982   end.
      983   on alt-shift-f3 anywhere do:
      984     run proc-alt-shift-f3 in this-procedure .
      985   end.
      986   on alt-shift-f4 anywhere do:
      987     run proc-alt-shift-f4 in this-procedure.
      988   end.
      989   on alt-f1 anywhere do:
      990     run proc-alt-f1 in this-procedure .
      991   end.
      992   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      993   define variable c-point  as character no-undo .
      994   define variable tbl      as character no-undo .
      995   define variable join-tbl as character no-undo .
      996   define variable fld      as character no-undo .
      997   define variable lab      as character no-undo .
      998   define variable spr      as character no-undo .
      999   define variable dim      as character no-undo .
     1000   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1001   procedure fltfield-clear :
     1002     define output parameter loc-fld as character no-undo.
     1003     define output parameter loc-lab as character no-undo .
     1004     define output parameter loc-spr as character no-undo .
     1005     define output parameter loc-dim as character no-undo .
     1006     assign
     1007       loc-fld = ""
     1008       loc-lab = ""
     1009       loc-spr = ""
     1010       loc-dim = "0"
     1011     .
     1012   end procedure .
     1013   procedure fltfield-add :
     1014     define input        parameter par-fld as character no-undo.
     1015     define input        parameter par-lab as character no-undo .
     1016     define input        parameter par-spr as character no-undo .
     1017     define input-output parameter loc-fld as character no-undo.
     1018     define input-output parameter loc-lab as character no-undo .
     1019     define input-output parameter loc-spr as character no-undo .
     1020     define input-output parameter loc-dim as character no-undo .
     1021     do
     1022     on error undo, return error
     1023     :
     1024       assign
     1025       loc-fld = if loc-dim = '0'
     1026                 then par-fld
     1027                 else (loc-fld + chr(44) + par-fld)
     1028       loc-lab = if loc-dim = '0'
     1029                 then par-lab
     1030                 else (loc-lab + chr(44) + par-lab)
     1031       loc-spr = if loc-dim = '0'
     1032                 then par-spr
     1033                 else (loc-spr + chr(44) + par-spr)
     1034       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
     1035                 string(integer(if num-entries(loc-dim) > 1
     1036                               then entry(2, loc-dim)
     1037                               else entry(1, loc-dim)
     1038                               ) + 1)
     1039       no-error
     1040       .
     1041     end.
     1042   end procedure.
     1043   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1044   define variable v-waitfram-action01         as character   no-undo .
     1045   define variable v-waitfram-action02         as character   no-undo .
     1046   define variable v-waitfram-action03         as character   no-undo .
     1047   define variable mWaitFramTextBeg            as character   no-undo.
     1048   define variable mWaitFramTextEnd            as character   no-undo.
     1049   define variable mWaitFramView               as logical     no-undo.
     1050   define variable mWaitProcEvent              as logical     no-undo init yes.
     1051   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1052   define variable mWaitFramStop               as logical     no-undo.
     1053   define variable mWaitFramStopUser           as logical     no-undo.
     1054   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1055   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1056   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1057   define button B-WaitFramStop auto-end-key
     1058        label "Стоп"
     1059        size 10 by 1 tooltip "Остоновить процесс".
     1060   define button B-viewProcInfo
     1061        label "Информация"
     1062        size 15 by 1 tooltip "Информация о процесс".
     1063   define frame waitfram
     1064     v-waitfram-action01 format "x(72)" no-label skip
     1065     v-waitfram-action02 format "x(72)" no-label skip
     1066     v-waitfram-action03 format "x(72)" no-label skip
     1067     B-viewProcInfo
     1068     B-WaitFramStop at row 4 col 30
     1069     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1070     .
     1071   define new global shared variable mBatchMode as logical no-undo init ?.
     1072   define variable mFramBachModHandle as handle no-undo.
     1073   mFramBachModHandle = frame waitfram:handle.
     1074   define variable mFameOldVis as logical no-undo.
     1075   define variable mVisCUrentVin as logical no-undo.
     1076   if session:batch-mode
     1077   then
     1078      mBatchMode = yes.
     1079   if mBatchMode = ? then do:
     1080     mVisCUrentVin = current-window:visible.
     1081     mFameOldVis = mFramBachModHandle:visible.
     1082     mFramBachModHandle:visible  = yes.
     1083     mBatchMode = mFramBachModHandle:visible ne yes.
     1084     mFramBachModHandle:visible = mFameOldVis.
     1085     current-window:visible = mVisCUrentVin.
     1086   end.
     1087    if  log-manager:logfile-name ne ?
     1088     then DO:
     1089         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1090         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1091         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1092     end.
     1093   on choose of B-WaitFramStop in frame waitfram
     1094   do:
     1095     mWaitFramStop = yes.
     1096     mWaitFramStopUser = yes.
     1097   end.
     1098   function waitfram-check-timeout returns logical():
     1099      define variable vtime as int64 no-undo.
     1100      if mWaitFramStopTimeOut
     1101      then
     1102         return yes.
     1103      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1104      if     mWaitFramTimeOut ne ?
     1105         and mWaitFramTimeOut ne 0
     1106         and mWaitFramTimeOut lt vtime
     1107      then do:
     1108         mWaitFramStopTimeOut = yes.
     1109      end.
     1110      return mWaitFramStopTimeOut.
     1111   end.
     1112   procedure waitfram-hide :
     1113     if not session:batch-mode
     1114     then do
     1115     on error undo, return error return-value
     1116     :
     1117       pause 0 before-hide .
     1118       if not mBatchMode then
     1119         hide frame waitfram .
     1120     if     not mWaitFramView
     1121        and mWaitProcEvent
     1122     then
     1123       process events .
     1124     end.
     1125   end procedure.
     1126   procedure waitfram-show :
     1127     define input  parameter p-message as character no-undo .
     1128     define variable v-left-margin as integer   no-undo .
     1129     if not session:batch-mode
     1130     then do
     1131     on error undo, return error return-value
     1132     :
     1133       if length(p-message) <= 70 then do:
     1134         assign
     1135           v-left-margin = integer((70 - length(p-message)) / 2)
     1136         .
     1137         assign
     1138           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1139         .
     1140         assign
     1141           v-waitfram-action01 = " "
     1142           v-waitfram-action02 = " "
     1143                                    + fill(" ", v-left-margin)
     1144                                    + p-message
     1145           v-waitfram-action03 = " "
     1146         .
     1147       end.
     1148       else do:
     1149         define variable vRindex1 as integer no-undo.
     1150         define variable vRindex2 as integer no-undo.
     1151         vRindex1 = r-index(p-message," ",70).
     1152         if vRindex1 = 0
     1153         then
     1154            vRindex1 = 70.
     1155         if length(p-message)  <= vRindex1 + 70 then do:
     1156           assign
     1157             v-waitfram-action01 = " "
     1158             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1159             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1160           .
     1161         end.
     1162         else do:
     1163           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1164           if vRindex2 <= vRindex1
     1165           then
     1166              vRindex2 = vRindex1 + 70.
     1167           assign
     1168             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1169             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1170             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1171           .
     1172         end.
     1173       end.
     1174       B-viewProcInfo:visible   in frame waitfram = no.
     1175       B-viewProcInfo:sensitive in frame waitfram = no.
     1176       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1177       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1178       if  (   mWaitFramView
     1179          or  mWaitProcEvent)
     1180          and not mBatchMode
     1181       then
     1182          display
     1183             v-waitfram-action01 skip
     1184             v-waitfram-action02 skip
     1185             v-waitfram-action03 skip
     1186          with frame waitfram .
     1187       if     mWaitFramView
     1188          then do:
     1189             if     mWaitFramInterval ne ?
     1190                and not mBatchMode
     1191             then
     1192                wait-for go of frame waitfram pause mWaitFramInterval.
     1193          end.
     1194          else
     1195             if     mWaitProcEvent
     1196                and not mBatchMode
     1197             then
     1198                process events .
     1199     end.
     1200   end procedure.
     1201      procedure waitfram-show-this:
     1202         define input  parameter iInterval as int64 no-undo.
     1203         define variable vtime as int64 no-undo.
     1204         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1205         mWaitFramInterval = iInterval.
     1206         run waitfram-show (substitute("&1&2 &3&4" ,
     1207                                       mWaitFramTextBeg ,
     1208                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1209                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1210                                       mWaitFramTextEnd
     1211                                      )
     1212                           ).
     1213      end.
     1214      procedure WaitFramRunPause:
     1215         define input  parameter iInterval as dec no-undo.
     1216         define variable vStart  as datetime-tz no-undo.
     1217         define variable vend    as datetime-tz no-undo.
     1218         define variable vint as int64 no-undo.
     1219         define variable vOk as logical no-undo.
     1220         vStart = now.
     1221         vend   = vStart.
     1222         publish "WaitFramPause" (iInterval,output vOk).
     1223         vend   =  now.
     1224         vint = vend - vStart.
     1225         vint = iInterval - vint / 1000.
     1226         if     not mWaitFramStop
     1227            and (   vint > 0
     1228                 or (    not vOk
     1229                     and iInterval eq ?
     1230                     )
     1231                 )
     1232         then
     1233            run waitfram-show-this (iInterval).
     1234         vend   =  now.
     1235         vint = vend - vStart.
     1236         vint = iInterval - vint / 1000.
     1237         if     not mWaitFramStop
     1238            and vint > 0
     1239         then do:
     1240            run gbl/pause.p (vint * 1000).
     1241         end.
     1242         if iInterval ne ?
     1243         then
     1244            publish "WaitFramStop".
     1245         waitfram-check-timeout().
     1246      end.
     1247      procedure WaitFramWaitFor:
     1248         define input  parameter iInterval as dec no-undo.
     1249         assign
     1250            mWaitFramStartProc   = now
     1251            mWaitFramStopUser    = no
     1252            mWaitFramStopTimeOut = no
     1253         .
     1254         block-wait:
     1255         do while not mWaitFramStop:
     1256            run WaitFramRunPause (iInterval).
     1257            if  waitfram-check-timeout()
     1258            then do:
     1259               leave block-wait.
     1260            end.
     1261         end.
     1262         run waitfram-hide.
     1263      end.
     1264   procedure waitfram-join :
     1265     define input  parameter p-line-1  as character no-undo .
     1266     define input  parameter p-line-2  as character no-undo .
     1267     define input  parameter p-line-3  as character no-undo .
     1268     define output parameter p-message as character no-undo .
     1269     do
     1270     on error undo, return error return-value
     1271     :
     1272       assign
     1273         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1274                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1275                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1276       .
     1277     end.
     1278   end procedure.
     1279   function waitfram-join-function returns character
     1280     (input p-line-1 as character
     1281     ,input p-line-2 as character
     1282     ,input p-line-3 as character
     1283     ).
     1284     define variable v-message as character no-undo .
     1285     run waitfram-join in this-procedure
     1286       (input  p-line-1
     1287       ,input  p-line-2
     1288       ,input  p-line-3
     1289       ,output v-message
     1290       ) .
     1291     return v-message .
     1292   end function .
     1293   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1294   FUNCTION mark-string RETURNS CHARACTER
     1295     ( input p-recid as recid, input mark-list as character  ) :
     1296     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     1297   END FUNCTION.
     1298   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1299   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1300   procedure fltopend_fltopend :
     1301   define input parameter p-parent-handle as handle no-undo .
     1302   define input parameter p-qh as handle no-undo .
     1303   define input parameter p-flt-open-open-query  as character no-undo .
     1304   define input parameter p-where-cond as character no-undo .
     1305   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1306   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1307   define input parameter p-indexed-reposition as character no-undo .
     1308     do
     1309     on error undo, return error
     1310     :
     1311   define variable v-prepare-string as character no-undo .
     1312   define variable glog as logical no-undo .
     1313   assign
     1314   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1315                      p-where-cond + chr(32)  +
     1316                      p-use-indFIRST-query-tail + chr(32) +
     1317                      p-use-ind-sort-clmn-by + chr(32) +
     1318                      p-indexed-reposition
     1319   .
     1320   assign
     1321   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1322   if not glog
     1323   or error-status:error then do:
     1324     message error-status:get-message(1) view-as alert-box .
     1325     undo, return error .
     1326   end.
     1327   assign
     1328   glog = p-qh:query-open no-error .
     1329   if not glog
     1330   or error-status:error then do:
     1331     message error-status:get-message(1) view-as alert-box .
     1332     undo, return error .
     1333   end.
     1334     end.
     1335   end procedure.
     1336   procedure fltopend_fltfindd :
     1337   define input parameter p-parent-handle as handle no-undo .
     1338   define input parameter p-qh as handle no-undo .
     1339   define input parameter p-rowid as rowid no-undo .
     1340   define input parameter p-next as logical no-undo .
     1341   define input parameter p-lock as integer no-undo .
     1342   define input parameter p-bh as handle no-undo .
     1343   define input parameter p-where-cond as character no-undo .
     1344   define input parameter p-use-index-phrase as character no-undo .
     1345   define variable glog as logical no-undo .
     1346   define variable v-qh as handle no-undo .
     1347   define variable v-bh as handle no-undo .
     1348   define variable v-recid as recid no-undo .
     1349   define variable v-prepare-string as character no-undo .
     1350   do
     1351   on error undo, return error
     1352   on stop undo, return error
     1353   :
     1354     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1355     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1356     create query v-qh.
     1357     v-qh:set-buffers(v-bh).
     1358     v-prepare-string = substitute("for each &1 &2 &3"
     1359                                     ,v-bh:name
     1360                                     ,p-where-cond
     1361                                     ,p-use-index-phrase).
     1362     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1363     if not glog then do:
     1364       delete object v-qh.
     1365       delete object v-bh.
     1366       undo, return error .
     1367     end.
     1368     glog = v-qh:query-open no-error .
     1369     if not glog then do:
     1370       delete object v-qh.
     1371       delete object v-bh.
     1372       undo, return error .
     1373     end.
     1374     if p-next then do:
     1375       v-qh:reposition-to-rowid(p-rowid) no-error .
     1376       glog = v-qh:get-next( p-lock) no-error .
     1377       glog = v-qh:get-next( p-lock) no-error .
     1378       if not glog or v-qh:query-off-end = yes then do:
     1379         glog = v-qh:get-first( p-lock) no-error .
     1380       end.
     1381     end.
     1382     else do:
     1383       glog = v-qh:get-first( p-lock) no-error .
     1384     end.
     1385     v-recid = v-bh:recid no-error .
     1386     delete object v-qh.
     1387     delete object v-bh.
     1388     return string(v-recid) .
     1389   end.
     1390   end procedure.
     1391   procedure fltopend_fltfindq :
     1392   define input parameter p-parent-handle as handle no-undo .
     1393   define input parameter p-qh as handle no-undo .
     1394   define input parameter p-next as logical no-undo .
     1395   define input parameter p-lock as integer no-undo .
     1396   define input parameter p-flt-open-open-query  as character no-undo .
     1397   define input parameter p-where-cond as character no-undo .
     1398   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1399   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1400   define input parameter p-indexed-reposition as character no-undo .
     1401   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1402   define variable glog as logical no-undo .
     1403   define variable v-qh as handle no-undo .
     1404   define variable v-bh as handle no-undo extent 18.
     1405   define variable v-rowid as rowid no-undo extent 18.
     1406   define variable v-ii as integer no-undo .
     1407   define variable v-prepare-string as character no-undo .
     1408   do
     1409   on error undo, return error
     1410   on stop undo, return error
     1411   :
     1412     create query v-qh.
     1413     do v-ii = 1 to p-qh:num-buffers:
     1414       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1415       assign
     1416       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1417       no-error.
     1418       v-qh:add-buffer(v-bh[v-ii]).
     1419     end.
     1420     assign
     1421     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1422                       p-where-cond + chr(32)  +
     1423                       p-use-indFIRST-query-tail + chr(32) +
     1424                       p-use-ind-sort-clmn-by + chr(32) +
     1425                       p-indexed-reposition
     1426     .
     1427     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1428     if not glog then do:
     1429       delete object v-qh.
     1430       do v-ii = 1 to p-qh:num-buffers:
     1431         delete object v-bh[v-ii].
     1432       end.
     1433       undo, return error .
     1434     end.
     1435     glog = v-qh:query-open no-error .
     1436     if not glog then do:
     1437       delete object v-qh.
     1438       do v-ii = 1 to p-qh:num-buffers:
     1439         delete object v-bh[v-ii].
     1440       end.
     1441       undo, return error .
     1442     end.
     1443     if p-next then do:
     1444       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1445       glog = v-qh:get-next( p-lock) no-error .
     1446       glog = v-qh:get-next( p-lock) no-error .
     1447       if not glog or v-qh:query-off-end = yes then do:
     1448         glog = v-qh:get-first( p-lock) no-error .
     1449       end.
     1450     end.
     1451     else do:
     1452       glog = v-qh:get-first( p-lock) no-error .
     1453     end.
     1454     do v-ii = 1 to p-qh:num-buffers:
     1455       assign
     1456       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1457       no-error.
     1458     end.
     1459     delete object v-qh.
     1460     do v-ii = 1 to p-qh:num-buffers:
     1461       delete object v-bh[v-ii].
     1462     end.
     1463   end.
     1464   end procedure.
     1465   define variable sort-column-name as character no-undo .
     1466   define variable filter-point as character no-undo init "dbracmds" .
     1467   define variable filter-point0 as character no-undo init "dbracmds" .
     1468   define variable filter-label as character no-undo init "Выполняющиеся распределенные команды СПН" .
     1469   define variable filter-label0 as character no-undo init "Выполняющиеся распределенные команды СПН" .
     1470   define variable v-rid-list as character no-undo .
     1471   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
     1472   define variable v-tbl-row  as rowid     no-undo.
     1473   define variable v-tbl-name as character no-undo.
     1474   define variable v-command-title as character no-undo.
     1475   DEFINE BUTTON B-Help
     1476        LABEL "Помо&щь"
     1477        SIZE 3 BY 1
     1478        BGCOLOR 8 .
     1479   DEFINE BUTTON B-lkp
     1480        LABEL "Невидимая кнопка для brwsretr.i"
     1481        SIZE 31 BY 1.
     1482   DEFINE BUTTON B-mark
     1483        LABEL "&*"
     1484        SIZE 3 BY 1.
     1485   DEFINE BUTTON b-quit AUTO-END-KEY
     1486        LABEL "&Выход"
     1487        SIZE 10 BY 1
     1488        BGCOLOR 8 .
     1489   DEFINE BUTTON b-refresh DEFAULT
     1490        LABEL "Обновить"
     1491        SIZE 10 BY 1.
     1492   DEFINE BUTTON B-sch
     1493        LABEL "&Фильтр"
     1494        SIZE 3 BY 1.
     1495   DEFINE BUTTON B-sel AUTO-GO
     1496        LABEL "Вы&бор"
     1497        SIZE 10 BY 1.
     1498   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1499         VIEW-AS TEXT
     1500        SIZE 6 BY 1
     1501        FGCOLOR 4  NO-UNDO.
     1502   DEFINE QUERY BR-db-rec-attr FOR
     1503         X_db-rec-attr SCROLLING.
     1504   DEFINE BROWSE BR-db-rec-attr
     1505     QUERY BR-db-rec-attr NO-LOCK DISPLAY
     1506         mark-string(recid(X_db-rec-attr), p-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1507               WIDTH 2
     1508         progs-title-function(X_db-rec-attr.attr-code) COLUMN-LABEL "Команда" FORMAT "X(35)":U
     1509         X_db-rec-attr.db-num COLUMN-LABEL "БД" FORMAT ">>>>9":U
     1510         X_db-rec-attr.attr-value-date COLUMN-LABEL "Дата!команды" FORMAT "99/99/9999":U
     1511         X_db-rec-attr.attr-type COLUMN-LABEL "Статус" FORMAT "X(8)":U
     1512         X_db-rec-attr.attr-value-logical COLUMN-LABEL "ok" FORMAT "+/-":U
     1513         uniq-key-rec-string-f(X_db-rec-attr.uniq-key-rec) COLUMN-LABEL "Объект команды" FORMAT "X(45)":U
     1514         X_db-rec-attr.attr-value-decimal COLUMN-LABEL "БД!инициатор" FORMAT ">>>>9":U
     1515               WIDTH 10
     1516       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 18.5.
     1517   DEFINE FRAME Dialog-Frame
     1518        b-quit AT ROW 1 COL 1
     1519        B-mark AT ROW 1 COL 11
     1520        B-sel AT ROW 1 COL 21
     1521        b-refresh AT ROW 1 COL 31
     1522        B-lkp AT ROW 1 COL 50
     1523        B-sch AT ROW 1 COL 92
     1524        B-Help AT ROW 1 COL 95
     1525        BR-db-rec-attr AT ROW 3 COL 1
     1526        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1527        SPACE(78.75) SKIP(20.03)
     1528       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1529            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1530            TITLE "Выполняющиеся распределенные команды СПН"
     1531            CANCEL-BUTTON b-quit.
     1532   ASSIGN
     1533          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1534          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1535   ASSIGN
     1536          B-lkp:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1537   ON GO OF FRAME Dialog-Frame
     1538   DO:
     1539     p-rid-list = v-rid-list.
     1540   END.
     1541   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1542   OR ENDKEY OF FRAME Dialog-Frame DO:
     1543       run gbl/markqwa.p (
     1544                              input b-mark:sensitive
     1545                             , input p-rid-list) no-error.
     1546     if error-status:error then return no-apply.
     1547     APPLY "END-ERROR":U TO SELF.
     1548   END.
     1549   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1550   DO:
     1551     define variable loc#log as logical no-undo .
     1552     if available X_db-rec-attr then do:
     1553   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1554   define variable v-str-recid9 as character no-undo .
     1555   define variable v-num-entry9 as integer   no-undo .
     1556   assign
     1557     v-str-recid9 = trim( string( recid( X_db-rec-attr ) , "->>>>>>>>>>>9":U ) )
     1558     v-num-entry9 = lookup( v-str-recid9 , p-rid-list )
     1559   .
     1560   if v-num-entry9 > 0 then do:
     1561     assign
     1562       entry( v-num-entry9, p-rid-list ) = "":U
     1563       p-rid-list = trim( replace( p-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1564     .
     1565   end.
     1566   else do:
     1567     assign
     1568       p-rid-list = p-rid-list + ( if p-rid-list = "":U then "":U else chr(44) ) + v-str-recid9
     1569     .
     1570   end.
     1571       loc#log = BR-db-rec-attr:refresh() .
     1572       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1573           loc#log = BR-db-rec-attr:select-next-row ().
     1574           apply "VALUE-CHANGED" to BR-db-rec-attr in frame Dialog-Frame.
     1575       end.
     1576       if num-entries( p-rid-list ) = 0
     1577       then
     1578           hide mark-num in frame Dialog-Frame.
     1579       else
     1580           disp num-entries( p-rid-list ) @ mark-num with frame Dialog-Frame.
     1581     end.
     1582     apply "entry" to BR-db-rec-attr in frame Dialog-Frame.
     1583   END.
     1584   ON CHOOSE OF b-refresh IN FRAME Dialog-Frame
     1585   DO:
     1586     DEFINE VARIABLE v-rec-recid AS RECID NO-UNDO.
     1587     if g#db-num eq 0
     1588     then
     1589        run adm\comcom.p (0).
     1590     v-rec-recid = recid(X_db-rec-attr).
     1591     run openbr in this-procedure ( input yes, input no, input "").
     1592     reposition br-db-rec-attr to recid v-rec-recid no-error.
     1593   END.
     1594   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1595   DO:
     1596       RUN proc-b-sch IN THIS-PROCEDURE NO-ERROR.
     1597     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1598   END.
     1599   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1600   DO:
     1601       if ( available X_db-rec-attr ) then do:
     1602       if  ( p-rid-list = "" ) or b-mark:sensitive = no
     1603       then
     1604       p-rid-list = string( recid( X_db-rec-attr ) ) .
     1605     end.
     1606   END.
     1607   ON RETURN OF BR-db-rec-attr IN FRAME Dialog-Frame
     1608   or MOUSE-SELECT-DBLCLICK OF br-db-rec-attr IN FRAME Dialog-Frame DO:
     1609      run proc-br-db-rec-attr no-error.
     1610     if error-status:error then return no-apply.
     1611   END.
     1612   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1613   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1614   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1615   on help of frame Dialog-Frame
     1616   do:
     1617     run gbl/app_help.p
     1618       (input this-procedure :file-name
     1619       ,input ''
     1620       ,input ?
     1621       ) no-error.
     1622     if error-status :error then do:
     1623       message
     1624         "Ошибка при вызове помощи"
     1625         error-status :get-message(1)
     1626         view-as alert-box .
     1627     end.
     1628   end.
     1629   run minbtn-set in this-procedure .
     1630   on choose of b-help in frame Dialog-Frame
     1631   do:
     1632     apply "help":u to frame Dialog-Frame .
     1633   end.
     1634   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1635   procedure minbtn-set :
     1636       do
     1637           on error undo, return error return-value
     1638           :
     1639           define variable ii              as integer       no-undo .
     1640           define variable fh              as widget-handle no-undo .
     1641           define variable hh              as widget-handle no-undo .
     1642           define variable v-h             as handle        extent 4 no-undo .
     1643           define variable v-name-button   as character     no-undo .
     1644           define variable v-help-old-x    as decimal       no-undo .
     1645           define variable v-help-old-y    as decimal       no-undo .
     1646           define variable v-help-old-size as decimal       no-undo .
     1647           define variable v-frame-width   as decimal       no-undo .
     1648           define variable jj              as integer       no-undo .
     1649           do
     1650               on error undo, return error
     1651               :
     1652               assign
     1653                   v-frame-width = frame Dialog-Frame:width - 0.3
     1654                   fh            = frame Dialog-Frame:first-child
     1655                   hh            = fh:first-child
     1656                   ii            = 1
     1657                   .
     1658               do while valid-handle(hh):
     1659                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1660                   do:
     1661                       case lc(hh:name) :
     1662                           when "b-help" then
     1663                               do:
     1664                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1665                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1666                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1667                                   hh:TOOLTIP = "Помощь" .
     1668                                   v-help-old-x = hh:column .
     1669                                   v-help-old-y = hh:row    .
     1670                                   v-help-old-size = hh:width .
     1671                                   hh:width-chars = 2.5 .
     1672                               end.
     1673                           when "b-print" then
     1674                               do:
     1675                                   hh:load-image("cmp/b-print.bmp":u) .
     1676                                   hh:TOOLTIP = "Печать" .
     1677                                   v-h[ii] = hh:handle .
     1678                                   ii = ii + 1 .
     1679                                   hh:width-chars = 3 .
     1680                               end.
     1681                           when "b-history" or
     1682                           when "b-hist" then
     1683                               do:
     1684                                   hh:load-image("cmp/b-hist.bmp":u) .
     1685                                   hh:TOOLTIP = "История" .
     1686                                   v-h[ii] = hh:handle .
     1687                                   ii = ii + 1 .
     1688                                   hh:width-chars = 3 .
     1689                               end.
     1690                           when "b-sch" then
     1691                               do:
     1692                                   hh:load-image("cmp/b-sch.bmp":u) .
     1693                                   hh:TOOLTIP = "Установка Фильтра" .
     1694                                   v-h[ii] = hh:handle .
     1695                                   ii = ii + 1 .
     1696                                   hh:width-chars = 3 .
     1697                               end.
     1698                           when "b-hist-user" then
     1699                               do:
     1700                                   hh:load-image("cmp/b-hist.bmp":u) .
     1701                                   hh:TOOLTIP = "История пользователя" .
     1702                                   ii = ii + 1 .
     1703                               end.
     1704                       end case.
     1705                   end.
     1706                   hh = hh:next-sibling.
     1707               end.
     1708               b-help:column = v-frame-width - b-help:width-chars.
     1709               jj = 0.
     1710               repeat ii = 4 to 1 by -1 :
     1711                   if valid-handle (v-h[ii] ) then
     1712                   do:
     1713                       jj  = jj + 1 .
     1714                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1715                       v-h[ii]:row    = v-help-old-y .
     1716                   end.
     1717               end.
     1718           end.
     1719       end.
     1720   end procedure.
     1721   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1722   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1723   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1724   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1725   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1726   define variable v-diasize-current-frame-height as decimal   no-undo .
     1727   define variable v-diasize-change-size          as logical   no-undo .
     1728   define variable v-diasize-resize-button        as handle    no-undo .
     1729   define variable v-diasize-wndmax               as logical   no-undo .
     1730   define variable v-diasize-wndstore             as logical   no-undo .
     1731   define variable v-diasize-proc-name            as character no-undo .
     1732   define variable v-diasize-browse-handle        as handle    no-undo .
     1733   define variable v-diasize-browse-number        as integer   no-undo .
     1734   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1735   define temp-table temp-diasize-handle no-undo
     1736     field handle-value  as handle
     1737     field save-position as decimal
     1738     index xpk is primary unique handle-value
     1739     .
     1740   define temp-table temp-browse-handle no-undo
     1741     field browse-type   as character
     1742     field browse-number as integer
     1743     field browse-handle as handle
     1744     field original-size as decimal
     1745     index xpk is primary unique browse-type browse-number
     1746     index xie browse-type browse-handle
     1747   .
     1748   procedure diasize_change-height :
     1749     define input  parameter p-change-value  as decimal   no-undo .
     1750     define input  parameter p-move-resize   as logical   no-undo .
     1751     define variable v-field-group-handle    as handle    no-undo .
     1752     define variable v-object-handle         as handle    no-undo .
     1753     define variable v-frame-height          as decimal   no-undo .
     1754     define variable v-frame-virtual-height  as decimal   no-undo .
     1755     define variable v-browse-height         as decimal   no-undo .
     1756     define variable v-window-height         as decimal   no-undo .
     1757     define variable v-window-virtual-height as decimal   no-undo .
     1758     define variable v-change-sign           as integer   no-undo .
     1759     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1760     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1761     if p-change-value > 0
     1762     then do:
     1763       if frame Dialog-Frame :height + p-change-value
     1764           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1765       then do:
     1766         assign
     1767           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1768                           - (frame Dialog-Frame :height-chars)
     1769         .
     1770         if p-change-value <= 0
     1771         then do:
     1772           run diasize_position-resize-button in this-procedure .
     1773           return .
     1774         end.
     1775       end.
     1776     end.
     1777     if p-change-value < 0
     1778     then do:
     1779       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1780       then do:
     1781         assign
     1782           p-change-value = v-diasize-orig-frame-height
     1783                          - (frame Dialog-Frame :height-chars)
     1784         .
     1785         if p-change-value >= 0
     1786         then do:
     1787           run diasize_position-resize-button in this-procedure .
     1788           return .
     1789         end.
     1790       end.
     1791     end.
     1792     if p-change-value >= 0
     1793     then do:
     1794       assign
     1795         v-change-sign = 1
     1796       .
     1797     end.
     1798     else do:
     1799       assign
     1800         v-change-sign = -1
     1801       .
     1802     end.
     1803     assign
     1804       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1805     .
     1806     if p-change-value = 0
     1807     then do:
     1808       run diasize_position-resize-button in this-procedure .
     1809       return .
     1810     end.
     1811     move_block:
     1812     do
     1813     on error undo move_block, retry move_block
     1814     :
     1815       if retry
     1816       then do:
     1817         do
     1818         on error undo move_block, leave move_block
     1819         :
     1820           if p-change-value > 0
     1821           then do:
     1822             for each buf_temp-diasize-handle
     1823             on error undo, next
     1824             :
     1825               assign
     1826                 v-object-handle = buf_temp-diasize-handle.handle-value
     1827               .
     1828               if v-object-handle <> v-diasize-resize-button
     1829               then do:
     1830                 assign
     1831                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1832                 .
     1833               end.
     1834             end.
     1835             assign
     1836               v-diasize-browse-handle :height = v-browse-height
     1837             .
     1838             for each buf_temp-browse-handle
     1839               where buf_temp-browse-handle.browse-type = 'height':u
     1840             on error undo, next
     1841             :
     1842               assign
     1843                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1844               .
     1845             end.
     1846             assign
     1847               frame Dialog-Frame :height = v-frame-height
     1848             .
     1849             if frame Dialog-Frame :scrollable = true
     1850             then do:
     1851               assign
     1852                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1853               .
     1854             end.
     1855             run diasize_position-resize-button in this-procedure .
     1856           end.
     1857           else do:
     1858             if frame Dialog-Frame :scrollable = true
     1859             then do:
     1860               assign
     1861                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1862               .
     1863             end.
     1864             assign
     1865               frame Dialog-Frame :height = v-frame-height
     1866             .
     1867             assign
     1868               v-diasize-browse-handle :height = v-browse-height
     1869             .
