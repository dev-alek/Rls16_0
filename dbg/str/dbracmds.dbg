     2123   procedure diasize_set-height :
     2124     define input  parameter p-new-height  as decimal   no-undo .
     2125     define input  parameter p-move-resize as logical   no-undo .
     2126     do
     2127     on error undo, return error return-value
     2128     :
     2129       run diasize_change-height in this-procedure
     2130         (input  (p-new-height - frame Dialog-Frame :height)
     2131         ,input  p-move-resize
     2132         ) .
     2133     end.
     2134   end procedure.
     2135   procedure diasize_change-width :
     2136     define input  parameter p-change-value as decimal   no-undo .
     2137     define input  parameter p-move-resize  as logical   no-undo .
     2138     define variable v-field-group-handle   as handle    no-undo .
     2139     define variable v-object-handle        as handle    no-undo .
