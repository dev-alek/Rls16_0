     2924     return no-apply.
     2925   end.
     2926   define variable vss-include-info17 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2927   on F2 of frame Dialog-Frame anywhere do:
     2928     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     2929     return no-apply.
     2930   end.
     2931   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2932   on F2 of frame Dialog-Frame anywhere do:
     2933     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     2934     return no-apply.
     2935   end.
     2936   MAIN-BLOCK:
     2937   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2938      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2939    if LOOKUP(p-mode, ('все':U + chr(4) +
     2940                       "db-num":U + chr(4) +
     2941                       "attr-code":U + chr(4) +
     2942                       "uniq-key-rec":U),
     2943                   chr(4)) = 0
     2944        then dO:
     2945       message
     2946       vss-workfile vss-revision vss-description skip
     2947       "Неверное значение параметров вызова p-mode"
     2948       p-mode
     2949       view-as alert-box ERROR.
     2950       return error .
     2951    end.
     2952    IF p-mode = "db-num":U THEN DO:
     2953        FIND FIRST X_db NO-LOCK WHERE X_db.db-num = p-db-num NO-ERROR.
     2954        IF NOT AVAILABLE X_db THEN DO:
     2955            message
     2956            vss-workfile vss-revision vss-description skip
     2957            "Неверное значение параметров вызова p-db-num"
     2958            p-db-num
     2959            view-as alert-box ERROR.
     2960            return error .
     2961      END.
     2962   END.
     2963   IF p-mode = "attr-code":U THEN DO:
     2964     IF LOOKUP (p-attr-code, ( 'crush_code-range':U + chr(44) + 'delete_code-range':U + chr(44) + 'delete_nu-prt-bar-code':U + chr(44) + 'delete_nu-part-bar-code':U + chr(44) + 'delete_nu-ucli-bar-code':U + chr(44) + 'delete_nu-dis-card':U + chr(44) + 'chown-dis-card':U + chr(44) + 'delete_nu-dis-rule':U + chr(44) + 'delete_nu-clob-data':U + chr(44) + 'delete_nu-layout':U + chr(44) + 'ren-art':U )) = 0 THEN DO:
     2965            message
     2966            vss-workfile vss-revision vss-description skip
     2967            "Неверное значение параметров вызова p-attr-code"
     2968            p-attr-code
     2969            view-as alert-box ERROR.
     2970            return error .
     2971      END.
     2972   END.
     2973   IF p-mode = "uniq-key-rec":U THEN DO:
     2974     RUN gen-row-keyr IN THIS-PROCEDURE
     2975     ( input  p-uniq-key-rec
     2976      ,input ?
     2977      ,input "ub":U
     2978      ,input ?
     2979      ,input share-lock
     2980      ,output v-tbl-row
     2981      ,output  v-tbl-name
     2982     ) NO-ERROR.
     2983     IF error-status:error THEN DO:
     2984        message
     2985        vss-workfile vss-revision vss-description skip
     2986        "Неверное значение параметров вызова p-uniq-key-rec"
     2987        p-uniq-key-rec
     2988        view-as alert-box ERROR.
     2989        return error .
     2990      END.
     2991   END.
     2992   v-rid-list = p-rid-list.
     2993     RUN Myenable.
     2994     RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     2995     HIDE mark-num in frame Dialog-Frame .
     2996     if v-doc-rec <> ? then
     2997     REPOSITION br-db-rec-attr to recid v-doc-rec No-ERROR.
     2998   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2999   DEF VAR cur-clmn-numbr-db-rec-attr as INT EXTENT 7 no-undo.
     3000   DEF VAR varmvibr-db-rec-attr       as INT no-undo.
     3001   DEF VAR varmvjbr-db-rec-attr       as INT no-undo.
     3002   DEF VAR varmvkbr-db-rec-attr       as INT no-undo.
     3003   DEF VAR varmvlbr-db-rec-attr       as INT no-undo.
     3004   DEF VAR move-elementbr-db-rec-attr as INT no-undo.
     3005   def var jjbr-db-rec-attr           as int no-undo.
     3006   do varmvibr-db-rec-attr = 1 to EXTENT(cur-clmn-numbr-db-rec-attr):
     3007     ASSIGN cur-clmn-numbr-db-rec-attr[varmvibr-db-rec-attr] = varmvibr-db-rec-attr.
     3008   END.
     3009   RUN start-mv-clmnbr-db-rec-attr.
     3010   PROCEDURE start-mv-clmnbr-db-rec-attr:
     3011   def var old-session as logical no-undo.
     3012      old-session = SESSION:IMMEDIATE-DISPLAY.
     3013      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3014          IF  p-mode = 'все':U  THEN DO:
     3015      DO jjbr-db-rec-attr = NUM-ENTRIES('1,2,3,4,5,6,7') TO 1 BY -1:
     3016        RUN re-move-clmnbr-db-rec-attr ( cur-clmn-numbr-db-rec-attr[INTEGER(ENTRY (jjbr-db-rec-attr, '1,2,3,4,5,6,7'))] , 1).
     3017      END.
     3018          END.
     3019          IF  p-mode = 'db-num':U  THEN DO:
     3020      DO jjbr-db-rec-attr = NUM-ENTRIES('1,2,4,5,6,7,3') TO 1 BY -1:
     3021        RUN re-move-clmnbr-db-rec-attr ( cur-clmn-numbr-db-rec-attr[INTEGER(ENTRY (jjbr-db-rec-attr, '1,2,4,5,6,7,3'))] , 1).
     3022      END.
     3023          END.
     3024          IF  p-mode = 'attr-code':U  THEN DO:
     3025      DO jjbr-db-rec-attr = NUM-ENTRIES('1,3,4,5,6,7,2') TO 1 BY -1:
     3026        RUN re-move-clmnbr-db-rec-attr ( cur-clmn-numbr-db-rec-attr[INTEGER(ENTRY (jjbr-db-rec-attr, '1,3,4,5,6,7,2'))] , 1).
     3027      END.
     3028          END.
     3029          IF  p-mode = 'uniq-key-rec':U  THEN DO:
     3030      DO jjbr-db-rec-attr = NUM-ENTRIES('1,2,3,4,5,7,6') TO 1 BY -1:
     3031        RUN re-move-clmnbr-db-rec-attr ( cur-clmn-numbr-db-rec-attr[INTEGER(ENTRY (jjbr-db-rec-attr, '1,2,3,4,5,7,6'))] , 1).
     3032      END.
     3033          END.
     3034      SESSION:IMMEDIATE-DISPLAY = old-session.
     3035   END.
     3036   ON ctrl-cursor-right OF BROWSE br-db-rec-attr do:
     3037     RUN re-move-clmnbr-db-rec-attr ( 1, 7).
     3038   END.
     3039   ON ctrl-cursor-left OF BROWSE br-db-rec-attr do:
     3040     RUN re-move-clmnbr-db-rec-attr (7, 1).
     3041   END.
     3042   PROCEDURE re-move-clmnbr-db-rec-attr:
     3043     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3044     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3045     DO varmvibr-db-rec-attr = 1 TO EXTENT(cur-clmn-numbr-db-rec-attr):
     3046       if cur-clmn-numbr-db-rec-attr[varmvibr-db-rec-attr] = source-column THEN cur-clmn-numbr-db-rec-attr[varmvibr-db-rec-attr] = -1.
     3047     END.
     3048     if br-db-rec-attr:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     3049     if source-column > target-column THEN
     3050     DO varmvjbr-db-rec-attr = source-column - 1 to target-column BY -1:
     3051       DO varmvibr-db-rec-attr = 1 TO EXTENT(cur-clmn-numbr-db-rec-attr):
     3052           if cur-clmn-numbr-db-rec-attr[varmvibr-db-rec-attr] = varmvjbr-db-rec-attr THEN DO:
     3053             cur-clmn-numbr-db-rec-attr[varmvibr-db-rec-attr] = cur-clmn-numbr-db-rec-attr[varmvibr-db-rec-attr] + 1.
     3054           END.
     3055       END.
     3056     END.
     3057     ELSE
     3058     DO varmvjbr-db-rec-attr = source-column + 1 to target-column:
     3059       DO varmvibr-db-rec-attr = 1 TO EXTENT(cur-clmn-numbr-db-rec-attr):
     3060         if cur-clmn-numbr-db-rec-attr[varmvibr-db-rec-attr] = varmvjbr-db-rec-attr THEN DO:
     3061           cur-clmn-numbr-db-rec-attr[varmvibr-db-rec-attr] = cur-clmn-numbr-db-rec-attr[varmvibr-db-rec-attr] - 1.
     3062         END.
     3063       END.
     3064     END.
     3065     DO varmvibr-db-rec-attr = 1 TO EXTENT(cur-clmn-numbr-db-rec-attr):
     3066       if cur-clmn-numbr-db-rec-attr[varmvibr-db-rec-attr] = -1 THEN cur-clmn-numbr-db-rec-attr[varmvibr-db-rec-attr] = target-column.
     3067     END.
     3068   END PROCEDURE.
     3069   PROCEDURE ch-clmnbr-db-rec-attr:
     3070     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3071     if cur-clmn-loc <= 1 then do:
     3072       return .
     3073     end.
     3074     DO varmvibr-db-rec-attr = 1 TO EXTENT(cur-clmn-numbr-db-rec-attr):
     3075       if cur-clmn-numbr-db-rec-attr[varmvibr-db-rec-attr] = cur-clmn-loc THEN move-elementbr-db-rec-attr = varmvibr-db-rec-attr.
     3076     END.
     3077     RUN re-move-clmnbr-db-rec-attr (cur-clmn-loc, 1).
     3078   END PROCEDURE.
     3079   PROCEDURE mv-brw-defaultbr-db-rec-attr:
     3080   def var old-session as logical no-undo.
     3081     old-session = SESSION:IMMEDIATE-DISPLAY.
     3082     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3083     do varmvlbr-db-rec-attr = 1 to EXTENT(cur-clmn-numbr-db-rec-attr):
     3084       RUN re-move-clmnbr-db-rec-attr (cur-clmn-numbr-db-rec-attr[varmvlbr-db-rec-attr], varmvlbr-db-rec-attr).
     3085     END.
     3086     RUN start-mv-clmnbr-db-rec-attr.
     3087     SESSION:IMMEDIATE-DISPLAY = old-session.
     3088   END PROCEDURE.
     3089   .
     3090   WAIT-FOR GO OF FRAME Dialog-Frame.
     3091   END.
     3092   RUN disable_UI.
     3093   PROCEDURE disable_UI :
     3094     HIDE FRAME Dialog-Frame.
     3095   END PROCEDURE.
     3096   PROCEDURE enable_UI :
     3097     DISPLAY mark-num
     3098         WITH FRAME Dialog-Frame.
     3099     ENABLE b-quit B-mark B-sel b-refresh B-sch B-Help BR-db-rec-attr mark-num
     3100         WITH FRAME Dialog-Frame.
     3101     VIEW FRAME Dialog-Frame.
     3102     OPEN QUERY BR-db-rec-attr FOR EACH X_db-rec-attr NO-LOCK INDEXED-REPOSITION.
     3103   END PROCEDURE.
     3104   PROCEDURE MyEnable :
     3105    DISPLAY mark-num
     3106         WITH FRAME Dialog-Frame.
     3107    DISPLAY mark-num
     3108   WITH FRAME Dialog-Frame.
     3109   ENABLE
     3110   b-quit
     3111   B-mark when LOOKUP("b-mark":U, bttns) > 0
     3112   B-sel when LOOKUP("b-sel":U, bttns) > 0
     3113   b-sch
     3114   B-Help
     3115   b-refresh
     3116   br-db-rec-attr
     3117   mark-num
     3118   with FRAME Dialog-Frame .
     3119   VIEW FRAME Dialog-Frame .
     3120   END PROCEDURE.
     3121   PROCEDURE OpenBr :
     3122   define input  parameter p-open-query     as logical   no-undo .
     3123   define input  parameter p-find-next      as logical   no-undo .
     3124   define input  parameter p-find-condition as character no-undo .
     3125   define variable l-query-was-opened as logical no-undo .
     3126   define variable title0 as character no-undo.
     3127   title0 = "Выполняющиеся распределенные команды СПН" + chr(32).
     3128   run waitfram-show in this-procedure ("Ждите...").
     3129   define variable sort-column-phrase as character no-undo .
     3130   case sort-column-name :
     3131     when "" then do:
     3132       assign
     3133         sort-column-phrase = ""
     3134       .
     3135     end.
     3136     otherwise do:
     3137       assign
     3138         sort-column-phrase = "by " + sort-column-name
     3139       .
     3140     end.
     3141   end case.
     3142   define variable l-open-query as logical   no-undo .
     3143     CASE p-mode :
     3144       WHEN 'все':U        THEN DO:
     3145        filter-point = filter-point0 + p-mode.
     3146          ASSIGN
     3147          frame Dialog-Frame:TITLE = title0
     3148          filter-label = substitute("&1", filter-label0)
     3149          .
     3150   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3151   define variable  l-disable-where-21  as logical   no-undo .
     3152   define variable  l-filter-open-21    as logical   .
     3153   define variable  flt-rec-21       as recid     no-undo .
     3154   define variable  filter-name-21      as character no-undo .
