     3295             else "true"
     3296           )
     3297         parameter-5-21 = (" " + "" + " " + "" + " " + p-find-condition)
     3298         parameter-6-21 = if sort-phrase-21 = ''
     3299                              then
     3300           (
     3301           " " + "  " +
     3302             " " + sort-column-phrase +
     3303           " " + "  "
     3304           )
     3305                              else
     3306           (
     3307           " " + "  " +
     3308             " " + sort-column-phrase +
     3309           " " + sort-phrase-21
     3310           )
     3311         parameter-7-21 =
     3312           " indexed-reposition  "
     3313       .
     3314         run fltopend_fltfindq in this-procedure  (
     3315                             input this-procedure:handle
     3316                             ,input QUERY br-db-rec-attr:handle
     3317                             ,input logical(parameter-2-21)
     3318                             ,input no-lock
     3319                             ,input parameter-3-21
     3320                             ,input parameter-4-21
     3321                             ,input parameter-5-21
     3322                             ,input parameter-6-21
     3323                             ,input parameter-7-21
     3324                             ,output v-fltopend-rowid
     3325                             ) no-error.
     3326         .
     3327         v-doc-rec = ?.
     3328       end.
     3329       assign
     3330         l-query-was-opened = true
     3331       .
     3332     end.
     3333   end.
     3334     run waitfram-hide in this-procedure .
