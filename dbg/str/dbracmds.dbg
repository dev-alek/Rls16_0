     3284           v-fltopend-rowid[1] = ?
     3285         .
     3286       end.
     3287       else do:
     3288         assign
     3289         parameter-2-21 = (if p-find-next then "true":u else "false":u )
     3290         parameter-3-21 =  "FOR EACH X_db-rec-attr"
     3291         parameter-4-21 =
