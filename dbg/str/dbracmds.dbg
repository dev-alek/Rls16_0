     2485         run diasize_position-resize-button in this-procedure .
     2486       end.
     2487       if v-diasize-wndstore = true
     2488       then do:
     2489         if connected("ub") = true
     2490         then do:
     2491           define variable v-cntxt-db-num        as integer   no-undo .
     2492           define variable v-cntxt-userid        as character no-undo .
     2493           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2494                                             , OUTPUT v-cntxt-userid
     2495                                             ) .
     2496           run gbl/wndsizew.p
     2497             (input  v-cntxt-db-num
     2498             ,input  v-cntxt-userid
     2499             ,input  v-diasize-proc-name
     2500             ,input  'width':u
     2501             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2502             ) .
     2503         end.
     2504       end.
     2505     end.
     2506     assign
     2507       v-diasize-change-size = false
     2508     .
     2509   end procedure.
     2510   procedure diasize_set-width :
     2511     define input  parameter p-new-width  as decimal   no-undo .
     2512     define input  parameter p-move-resize as logical   no-undo .
     2513     do
     2514     on error undo, return error return-value
     2515     :
     2516       run diasize_change-width in this-procedure
     2517         (input  (p-new-width - frame Dialog-Frame :width)
     2518         ,input  p-move-resize
     2519         ) .
     2520     end.
     2521   end procedure.
     2522   procedure diasize_position-resize-button :
     2523     do with frame Dialog-Frame
     2524     :
     2525       hide v-diasize-resize-button .
     2526       assign
     2527         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2528                     - 1
     2529                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2530         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2531                     - 1
     2532                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2533       .
     2534       view v-diasize-resize-button .
     2535     end.
     2536   end procedure.
     2537   on alt-right anywhere
     2538   do:
     2539     run diasize_change-width in this-procedure
     2540       (input 1
     2541       ,input true
     2542       ) .
     2543     return no-apply .
     2544   end.
     2545   on alt-left anywhere
     2546   do:
     2547     run diasize_change-width in this-procedure
     2548       (input -1
     2549       ,input true
     2550       ) .
     2551     return no-apply .
     2552   end.
     2553   on alt-down anywhere
     2554   do:
     2555     run diasize_change-height in this-procedure
     2556       (input 1
     2557       ,input true
     2558       ) .
     2559     return no-apply .
     2560   end.
     2561   on alt-up anywhere
     2562   do:
     2563     run diasize_change-height in this-procedure
     2564       (input -1
     2565       ,input true
     2566       ) .
     2567     return no-apply .
     2568   end.
     2569   on alt-enter of frame Dialog-Frame
     2570   do:
     2571     run diasize_maximize in this-procedure
     2572       (input  ?
     2573       ).
     2574     return no-apply .
     2575   end.
     2576   procedure diasize_end-move :
     2577     do
     2578     on error undo, return error return-value
     2579     :
     2580       define variable v-row-delta as decimal   no-undo .
     2581       define variable v-col-delta as decimal   no-undo .
     2582       define variable v-new-row as decimal   no-undo .
     2583       define variable v-new-col as decimal   no-undo .
     2584       assign
     2585         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2586         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2587       .
     2588       assign
     2589         v-row-delta = v-new-row - frame Dialog-Frame :height
     2590         v-col-delta = v-new-col - frame Dialog-Frame :width
     2591       .
     2592       run diasize_change-height in this-procedure
     2593         (input v-row-delta
     2594         ,input true
     2595         ) .
     2596       run diasize_change-width in this-procedure
     2597         (input v-col-delta
     2598         ,input true
     2599         ) .
     2600     end.
     2601   end procedure.
     2602   procedure diasize_maximize :
     2603     define input  parameter p-action as logical   no-undo .
     2604     do
     2605     on error undo, return error return-value
     2606     :
     2607       if p-action = ?
     2608       then do:
     2609         if v-diasize-need-maximize = true
     2610         then do:
     2611           assign
     2612             p-action = true
     2613           .
     2614         end.
     2615         else do:
     2616           assign
     2617             p-action = false
     2618           .
     2619         end.
     2620       end.
     2621       if p-action = true
     2622       then do:
     2623         run diasize_change-height in this-procedure
     2624           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2625               - frame Dialog-Frame :height-chars
     2626           ,input true
     2627           ) .
     2628         run diasize_change-width in this-procedure
     2629           (input session :width-chars
     2630               - frame Dialog-Frame :width-chars
     2631           ,input true
     2632           ) .
     2633         assign
     2634           v-diasize-need-maximize = false
     2635         .
     2636       end.
     2637       else do:
     2638         run diasize_change-width in this-procedure
     2639           (input v-diasize-orig-frame-width
     2640               - frame Dialog-Frame :width-chars
     2641           ,input true
     2642           ) .
     2643         run diasize_change-height in this-procedure
     2644           (input v-diasize-orig-frame-height
     2645               - frame Dialog-Frame :height-chars
     2646           ,input true
     2647           ) .
     2648         assign
     2649           v-diasize-need-maximize = true
     2650         .
     2651       end.
     2652     end.
     2653   end procedure.
     2654   procedure diasize_restore-orig-size :
     2655     do
     2656     on error undo, return error return-value
     2657     :
     2658       assign
     2659         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2660         v-diasize-current-frame-height = frame Dialog-Frame :height
     2661       .
     2662       run diasize_set-height in this-procedure
     2663         (input  v-diasize-orig-frame-height
     2664         ,input  true
     2665         ) .
     2666       run diasize_set-width in this-procedure
     2667         (input  v-diasize-orig-frame-width
     2668         ,input  true
     2669         ) .
     2670     end.
     2671   end procedure.
     2672   procedure diasize_restore-current-size :
     2673     do
     2674     on error undo, return error return-value
     2675     :
     2676       run diasize_set-height in this-procedure
     2677         (input  v-diasize-current-frame-height
     2678         ,input  true
     2679         ) .
     2680       run diasize_set-width in this-procedure
     2681         (input  v-diasize-current-frame-width
     2682         ,input  true
     2683         ) .
     2684     end.
     2685   end procedure.
     2686   procedure diasize_set-browse-handle :
     2687     define input  parameter p-browse-handle as handle   no-undo .
     2688     define buffer buf_temp-browse-handle for temp-browse-handle .
     2689     do
     2690     on error undo, return error return-value
     2691     :
     2692       assign
     2693         v-diasize-browse-handle = p-browse-handle
     2694       .
     2695       for each buf_temp-browse-handle
     2696       on error undo, return error return-value
     2697       :
     2698         delete buf_temp-browse-handle .
     2699       end.
     2700     end.
     2701   end procedure.
     2702   procedure diasize_add_browse :
     2703     define input  parameter p-browse-type   as character no-undo .
     2704     define input  parameter p-browse-handle as handle    no-undo .
     2705     define buffer buf_temp-browse-handle for temp-browse-handle .
     2706     do
     2707     on error undo, return error return-value
     2708     :
     2709       assign
     2710         v-diasize-browse-number = v-diasize-browse-number + 1
     2711       .
     2712       create buf_temp-browse-handle .
     2713       assign
     2714         buf_temp-browse-handle.browse-type   = p-browse-type
     2715         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2716         buf_temp-browse-handle.browse-handle = p-browse-handle
     2717       .
     2718     end.
     2719   end procedure.
     2720   procedure diasize_init :
     2721     define variable v-default-value    as logical   no-undo .
     2722     define variable v-restore-saved    as logical   no-undo .
     2723     define variable v-resize-value-str as character no-undo .
     2724     do
     2725     on error undo, return error return-value
     2726     :
     2727       do with frame Dialog-Frame
     2728       :
     2729         assign
     2730           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2731           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2732           v-diasize-browse-handle     = browse BR-db-rec-attr :handle
     2733         .
     2734         create button v-diasize-resize-button
     2735         assign
     2736           parent        = frame Dialog-Frame :first-child
     2737           label         = "s"
     2738           height-pixels = 16
     2739           width-pixels  = 16
     2740           visible       = true
     2741           sensitive     = true
     2742           movable       = true
     2743           triggers:
     2744             on end-move persistent run diasize_end-move in this-procedure .
     2745           end triggers.
     2746         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2747         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2748         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2749         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2750         assign
     2751           v-diasize-wndmax = false
     2752         .
     2753         if connected("ub") = true
     2754         then do:
     2755           define variable v-cntxt-db-num        as integer   no-undo .
     2756           define variable v-cntxt-userid        as character no-undo .
     2757           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2758                                             , OUTPUT v-cntxt-userid
     2759                                             ) .
     2760           run gbl/wndpar_r.p
     2761             (input  v-cntxt-db-num
     2762             ,input  v-cntxt-userid
     2763             ,input  'wndmax':U
     2764             ,output v-diasize-wndmax
     2765             ,output v-default-value
     2766             ) .
     2767         end.
     2768         assign
     2769           v-diasize-wndstore = false
     2770         .
     2771         if connected("ub") = true
     2772         then do:
     2773           run gbl/wndpar_r.p
     2774             (input  v-cntxt-db-num
     2775             ,input  v-cntxt-userid
     2776             ,input  'wndstore':U
     2777             ,output v-diasize-wndstore
     2778             ,output v-default-value
     2779             ) .
     2780         end.
     2781         assign
     2782           v-diasize-proc-name = entry(1, program-name(2), '.')
     2783         .
     2784         if v-diasize-wndstore = true
     2785         then do:
     2786           assign
     2787             v-restore-saved = false
     2788           .
     2789           if connected("ub") = true
     2790           then do:
     2791             run gbl/wndsizer.p
     2792               (input  v-cntxt-db-num
     2793               ,input  v-cntxt-userid
     2794               ,input  v-diasize-proc-name
     2795               ,input  'height':u
     2796               ,output v-resize-value-str
     2797               ) .
     2798             if v-resize-value-str <> '':U
     2799             then do:
     2800               run diasize_change-height in this-procedure
     2801                 (input  integer(v-resize-value-str)
     2802                 ,input  true
     2803                 ) .
     2804               assign
     2805                 v-restore-saved = true
     2806               .
     2807             end.
     2808           end.
     2809           if connected("ub") = true
     2810           then do:
     2811             run gbl/wndsizer.p
     2812               (input  v-cntxt-db-num
     2813               ,input  v-cntxt-userid
     2814               ,input  v-diasize-proc-name
     2815               ,input  'width':u
     2816               ,output v-resize-value-str
     2817               ) .
     2818             if v-resize-value-str <> '':U
     2819             then do:
     2820               run diasize_change-width in this-procedure
     2821                 (input  integer(v-resize-value-str)
     2822                 ,input  true
     2823                 ) .
     2824               assign
     2825                 v-restore-saved = true
     2826               .
     2827             end.
     2828           end.
     2829           if v-restore-saved <> true
     2830           then do:
     2831             if v-diasize-wndmax = true
     2832             then do:
     2833               run diasize_maximize in this-procedure
     2834                 (input  true
     2835                 ) .
     2836             end.
     2837           end.
     2838         end.
     2839         else do:
     2840           if v-diasize-wndmax = true
     2841           then do:
     2842             run diasize_maximize in this-procedure
     2843               (input  true
     2844               ) .
     2845           end.
     2846         end.
     2847       end.
     2848     end.
     2849   end procedure.
     2850   procedure diasize_need-full-display :
     2851     define output parameter p-need-full-display as logical   no-undo .
     2852     do
     2853     on error undo, return error return-value
     2854     :
     2855       assign
     2856         p-need-full-display = v-diasize-need-full-display
     2857       .
     2858       assign
     2859         v-diasize-need-full-display = false
     2860       .
     2861     end.
     2862   end procedure.
     2863   procedure get-context :
     2864      define output parameter p-db-num as integer          no-undo.
     2865      define output parameter p-user-id as character        no-undo.
     2866      define variable v-login               as character    no-undo.
     2867      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2868      define buffer buf_user-login  for ub.user-login .
     2869      do
     2870      on error undo, return error
     2871      :
     2872            FIND FIRST buf_sys-ctrl no-lock.
     2873            ASSIGN
     2874               v-login = USERID("ub")
     2875               p-db-num = buf_sys-ctrl.db-num
     2876            .
     2877            FIND FIRST buf_user-login
     2878                 WHERE buf_user-login.db-num = p-db-num
     2879                   AND buf_user-login.user-login = v-login
     2880                 no-lock
     2881                 no-error
     2882                 .
     2883            IF AVAILABLE buf_user-login
     2884            THEN DO:
     2885               assign
     2886                  p-user-id = buf_user-login.user-id
     2887               .
     2888            END.
     2889      end.
     2890   end procedure.
     2891       run diasize_init in this-procedure .
     2892   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2893   procedure set-filter-name :
     2894   define input parameter p-filter-name as character no-undo .
     2895     do with frame Dialog-Frame:
     2896       if p-filter-name > "" then do:
     2897         assign
     2898           frame Dialog-Frame:title
     2899             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2900         .
     2901         assign
     2902           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2903         .
     2904       end.
     2905       else do:
     2906         assign
     2907           b-sch :tooltip = ""
     2908         .
     2909       end.
     2910     end.
     2911   end procedure.
     2912   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2913   do:
     2914     BR-db-rec-attr :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2915   end.
     2916   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2917   on INS of frame Dialog-Frame anywhere do:
     2918     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     2919     return no-apply.
     2920   end.
     2921   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2922   on F3 of frame Dialog-Frame anywhere do:
