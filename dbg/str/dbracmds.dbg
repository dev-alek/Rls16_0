     3267         parameter-4-21 =
     3268           "where ":u + " TRUE " + " ":u + where-phrase-21 + " ":u + p-find-condition + " " + ""
     3269         parameter-5-21 = "  "
     3270       .
     3271         run fltopend_fltfindd in this-procedure  (
     3272                             input this-procedure:handle
     3273                             ,input QUERY br-db-rec-attr:handle
     3274                             ,input rowid(X_db-rec-attr)
     3275                             ,input logical(parameter-2-21)
