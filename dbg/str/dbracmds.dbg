     2143     define variable v-window-width         as decimal   no-undo .
     2144     define variable v-window-virtual-width as decimal   no-undo .
     2145     define variable v-change-sign          as integer   no-undo .
     2146     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2147     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2148     if p-change-value > 0
     2149     then do:
     2150       if frame Dialog-Frame :width + p-change-value >
     2151           session :width-chars
     2152       then do:
     2153         assign
     2154           p-change-value = session :width-chars - frame Dialog-Frame :width
     2155         .
     2156         if p-change-value <= 0
     2157         then do:
     2158           run diasize_position-resize-button in this-procedure .
     2159           return .
     2160         end.
     2161       end.
     2162     end.
     2163     if p-change-value < 0
     2164     then do:
     2165       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2166       then do:
     2167         assign
     2168           p-change-value = v-diasize-orig-frame-width
     2169                          - frame Dialog-Frame :width
     2170         .
     2171         if p-change-value >= 0
     2172         then do:
     2173           run diasize_position-resize-button in this-procedure .
     2174           return .
     2175         end.
     2176       end.
     2177     end.
     2178     if p-change-value >= 0
     2179     then do:
     2180       assign
     2181         v-change-sign = 1
     2182       .
     2183     end.
     2184     else do:
     2185       assign
     2186         v-change-sign = -1
     2187       .
     2188     end.
     2189     assign
     2190       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2191     .
     2192     if p-change-value = 0
     2193     then do:
     2194       run diasize_position-resize-button in this-procedure .
     2195       return .
     2196     end.
