     1041   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1042   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1043     (input  p-artic
     1044     ,input  p-prod-type
     1045     ,input  p-prod-code
     1046     ,input  'twounit=request':u
     1047     ,output v-goods-twounit
     1048     ) no-error .
     1049       if error-status :error
     1050       then do:
     1051         message
     1052           vss-workfile vss-revision vss-description skip
     1053           vss-include-info4 skip
     1054           "Ошибка при определении атрибута товара" skip
     1055           "Артикул" p-artic p-prod-type p-prod-code skip
     1056           "twounit=request" skip
     1057           error-status :get-message(1) skip
     1058           return-value skip
     1059           view-as alert-box error .
     1060         undo, return error return-value .
     1061       end.
     1062       for each buf_doc-line no-lock
     1063         where buf_doc-line.obj-type   = p-obj-type
     1064           and buf_doc-line.obj-code   = p-obj-code
     1065           and buf_doc-line.artic      = p-artic
     1066           and buf_doc-line.prod-type  = p-prod-type
     1067           and buf_doc-line.prod-code  = p-prod-code
     1068           and buf_doc-line.status_    = 'факт':U
     1069           and buf_doc-line.fact-order > p-start-fact-order
     1070           and buf_doc-line.fact-order <= p-end-fact-order
     1071       on error undo, return error
     1072       :
     1073         run partslib-process-document in this-procedure
     1074           (input  buf_doc-line.doc-code
     1075           ,input  p-obj-type
     1076           ,input  p-obj-code
     1077           ,input  p-artic
     1078           ,input  p-prod-type
     1079           ,input  p-prod-code
     1080           ,input  v-goods-gds-goods
     1081           ,input  v-goods-twounit
     1082           ,output v-total-parts-qnty
     1083           ) no-error .
     1084         if error-status :error
     1085         then do:
     1086           message
     1087             vss-workfile vss-revision vss-description skip
     1088             vss-include-info4 skip
     1089             "Ошибка при вызове процедуры partslib-process-document" skip
     1090             "Документ" buf_doc-line.doc-code skip
     1091             "Объект" p-obj-type p-obj-code skip
     1092             "Артикул" p-artic p-prod-type p-prod-code skip
     1093             "p-start-fact-order" p-start-fact-order skip
     1094             "p-end-fact-order" p-end-fact-order skip
     1095             error-status :get-message(1) skip
     1096             return-value skip
     1097             view-as alert-box error .
     1098           undo, return error return-value .
     1099         end.
     1100       end.
     1101     end.
     1102   end procedure.
     1103   procedure partslib-process-document :
     1104     define input  parameter p-doc-code         as character no-undo .
     1105     define input  parameter p-obj-type         as character no-undo .
     1106     define input  parameter p-obj-code         as integer   no-undo .
     1107     define input  parameter p-artic            as character no-undo .
     1108     define input  parameter p-prod-type        as character no-undo .
     1109     define input  parameter p-prod-code        as integer   no-undo .
     1110     define input  parameter p-goods-gds-goods  as logical   no-undo .
     1111     define input  parameter p-goods-twounit    as logical   no-undo .
     1112     define output parameter p-total-parts-qnty as decimal   no-undo .
     1113     define variable v-parts-sign as integer   no-undo .
     1114     define buffer buf_trn-doc    for ub.trn-doc .
     1115     define buffer buf_doc-line   for ub.doc-line .
     1116     define buffer buf_parts      for ub.parts .
     1117     define buffer buf_temp-parts for temp-parts .
     1118     do
     1119     on error undo, return error return-value
     1120     :
     1121       find first buf_trn-doc no-lock
     1122         where buf_trn-doc.doc-code = p-doc-code
     1123         no-error .
     1124       if not available buf_trn-doc
     1125       then do:
     1126         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     1127                                      ,p-doc-code
     1128                                      ) .
     1129       end.
     1130       case buf_trn-doc.doc-type
     1131       :
     1132         when 'при':U or
     1133         when 'возврат':U or
     1134         when 'инв':U
     1135         then do:
     1136           assign
     1137             v-parts-sign = -1
     1138           .
     1139         end.
     1140         when 'рас':U or
     1141         when 'спи':U
     1142         then do:
     1143           assign
     1144             v-parts-sign = 1
     1145           .
     1146         end.
     1147         otherwise do:
     1148           undo, return error substitute("Неизвестный тип документа &1"
     1149                                       ,buf_trn-doc.doc-type
     1150                                       ) .
     1151         end.
     1152       end.
     1153       find first buf_doc-line no-lock
     1154         where buf_doc-line.doc-code  = p-doc-code
     1155           and buf_doc-line.artic     = p-artic
     1156           and buf_doc-line.prod-type = p-prod-type
     1157           and buf_doc-line.prod-code = p-prod-code
     1158         no-error .
     1159       if not available buf_doc-line
     1160       then do:
     1161         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     1162                                      ,p-doc-code
     1163                                      ,artic
     1164                                      ,prod-type
     1165                                      ,prod-code
     1166                                      ) .
     1167       end.
     1168       assign
     1169         p-total-parts-qnty = 0
     1170       .
     1171       if p-goods-gds-goods = true
     1172       then do:
     1173         for each buf_parts no-lock
     1174           where buf_parts.out-code  = p-doc-code
     1175             and buf_parts.obj-type  = p-obj-type
     1176             and buf_parts.obj-code  = p-obj-code
     1177             and buf_parts.artic     = p-artic
     1178             and buf_parts.prod-type = p-prod-type
     1179             and buf_parts.prod-code = p-prod-code
     1180         on error undo, return error
     1181         :
     1182           run partslib-create-temp-parts in this-procedure
     1183             (buffer buf_parts
     1184             ,buffer buf_temp-parts
     1185             ,input  p-goods-twounit
     1186             ) .
     1187           assign
     1188             p-total-parts-qnty        = p-total-parts-qnty
     1189                                       + v-parts-sign * buf_parts.fact-qnty
     1190             buf_temp-parts.qnty       = buf_temp-parts.qnty
     1191                                       + v-parts-sign * buf_parts.fact-qnty
     1192             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     1193                                       + v-parts-sign * buf_parts.fact-qnty
     1194             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     1195                                       + v-parts-sign * buf_parts.cli-qnty
     1196           .
     1197           if buf_temp-parts.qnty = 0
     1198           then do:
     1199             delete buf_temp-parts .
     1200           end.
     1201         end.
     1202       end.
     1203       else do:
     1204         assign
     1205           p-total-parts-qnty = p-total-parts-qnty
     1206                              + v-parts-sign * buf_doc-line.fact-qnty
     1207         .
     1208       end.
     1209     end.
     1210   end procedure.
     1211   procedure partslib-init-temp-parts-by-date :
     1212     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1213     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1214     define input parameter p-artic           like ub.parts.artic     no-undo .
     1215     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1216     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1217     define input parameter p-fact-date       as date      no-undo .
     1218     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     1219     do
     1220     on error undo, return error
     1221     :
     1222       define variable v-fact-order                as decimal   no-undo .
     1223       define variable v-shift-end-fact-order      as decimal   no-undo .
     1224       define variable v-day-end-fact-order        as decimal   no-undo .
     1225       run factord in this-procedure
     1226         (input  p-fact-date
     1227         ,input  1
     1228         ,input  1
     1229         ,input  ?
     1230         ,input  0
     1231         ,input  false
     1232         ,output v-fact-order
     1233         ,output v-shift-end-fact-order
     1234         ,output v-day-end-fact-order
     1235         ) no-error .
     1236       if error-status :error
     1237       then do:
     1238         message
     1239           vss-workfile vss-revision vss-description skip
     1240           vss-include-info4 skip
     1241           "Ошибка при определении момента времени, на который требуется остаток" skip
     1242           "Объект" p-obj-type p-obj-code skip
     1243           "Артикул" p-artic p-prod-type p-prod-code skip
     1244           "Дата" p-fact-date skip
     1245           view-as alert-box error .
     1246         undo, return error .
     1247       end.
     1248       run partslib-init-temp-parts-by-factord in this-procedure
     1249         (input p-obj-type
     1250         ,input p-obj-code
     1251         ,input p-artic
     1252         ,input p-prod-type
     1253         ,input p-prod-code
     1254         ,input v-day-end-fact-order
     1255         ,input false
     1256         ) no-error .
     1257       if error-status :error
     1258       then do:
     1259         message
     1260           vss-workfile vss-revision vss-description skip
     1261           vss-include-info4 skip
     1262           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     1263           "Объект" p-obj-type p-obj-code skip
     1264           "Артикул" p-artic p-prod-type p-prod-code skip
     1265           "Дата" p-fact-date skip
     1266           view-as alert-box error .
     1267         undo, return error .
     1268       end.
     1269     end.
     1270   end procedure.
     1271   procedure partslib-calc-cost :
     1272     define output parameter p-fact-qnty      as decimal   no-undo .
     1273     define output parameter p-vat-pc         as decimal   no-undo .
     1274     define output parameter p-slt-pc         as decimal   no-undo .
     1275     define output parameter p-sum-base       as decimal   no-undo .
     1276     define output parameter p-sum-rubl       as decimal   no-undo .
     1277     define output parameter p-vat-base       as decimal   no-undo .
     1278     define output parameter p-vat-rubl       as decimal   no-undo .
     1279     define output parameter p-slt-base       as decimal   no-undo .
     1280     define output parameter p-slt-rubl       as decimal   no-undo .
     1281     define output parameter p-road-tax-base  as decimal   no-undo .
     1282     define output parameter p-road-tax-rubl  as decimal   no-undo .
     1283     define output parameter p-transport-base as decimal   no-undo .
     1284     define output parameter p-transport-rubl as decimal   no-undo .
     1285     define output parameter p-other-base     as decimal   no-undo .
     1286     define output parameter p-other-rubl     as decimal   no-undo .
     1287     define output parameter p-excise-base    as decimal   no-undo .
     1288     define output parameter p-excise-rubl    as decimal   no-undo .
     1289     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     1290     do
     1291     on error undo, return error return-value
     1292     :
     1293       define buffer buf_temp-parts for temp-parts .
     1294       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1295       define buffer   in-vatp-parts    for ub.parts   .
     1296       define buffer   in-vatp-doc      for ub.trn-doc .
     1297       define buffer   in-vatp-goods    for ub.goods   .
     1298       define buffer   in-vatp-sysconf  for ub.sysconf .
     1299       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1300       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1301       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1302       define variable varinvprb                  as   character              no-undo.
     1303       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1304       define variable cli-base-rate              as   decimal                no-undo.
     1305       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1306       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1307       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1308       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1309       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1310       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1311       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1312       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1313       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1314       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1315       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1316       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1317       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1318       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1319       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1320       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1321       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1322       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1323       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1324       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1325       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1326       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1327       define variable varinvatp-envd             as   character              no-undo.
     1328       define variable varinvatp-type             as   character              no-undo.
     1329       for each buf_temp-parts
     1330       on error undo, return error
     1331       :
     1332   assign
     1333     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1334     price-base-with-tax-loc = buf_temp-parts.price-base
     1335   .
     1336   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1337   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1338     (output varinvprb
     1339     )  .
     1340     if buf_temp-parts.out-code = 'free-zone':U     or
     1341        buf_temp-parts.out-code = 'out-zone':U   or
     1342        buf_temp-parts.doc-type = 'акт':U then do:
     1343       assign
     1344         in-vatp-have-vat-slt = yes.
     1345     end.
     1346     else do:
     1347       find first in-vatp_doc-attr no-lock
     1348         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1349           and in-vatp_doc-attr.attr-code = 'envd':U
     1350         no-error .
     1351       if not available in-vatp_doc-attr then do:
     1352         assign
     1353           in-vatp-have-vat-slt = yes.
     1354       end.
     1355       else do:
     1356            in-vatp-have-vat-slt = no.
     1357       end.
     1358     end.
     1359     assign
     1360      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1361      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1362     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1363              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1364     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1365             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1366             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1367             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1368             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1369             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1370             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1371       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1372     assign
     1373       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     1374     assign
     1375       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1376       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1377       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1378       transport-cli-loc  = 0
     1379       other-cli-loc      = 0
     1380     .
     1381   ASSIGN
     1382             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1383       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1384   .
     1385         assign
     1386           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     1387           p-vat-pc         = p-vat-pc         + vat-pc-loc
     1388           p-slt-pc         = p-slt-pc         + slt-pc-loc
     1389           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     1390           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     1391           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     1392           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     1393           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     1394           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     1395           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     1396           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     1397           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     1398           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     1399           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     1400           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     1401           p-excise-base    = p-excise-base    + 0
     1402           p-excise-rubl    = p-excise-rubl    + 0
     1403         .
     1404       end.
     1405       if p-fact-qnty      = ?
     1406       or p-sum-base       = ?
     1407       or p-sum-rubl       = ?
     1408       or p-vat-base       = ?
     1409       or p-vat-rubl       = ?
     1410       or p-slt-base       = ?
     1411       or p-slt-rubl       = ?
     1412       or p-road-tax-base  = ?
     1413       or p-road-tax-rubl  = ?
     1414       or p-transport-base = ?
     1415       or p-transport-rubl = ?
     1416       or p-other-base     = ?
     1417       or p-other-rubl     = ?
     1418       or p-excise-base    = ?
     1419       or p-excise-rubl    = ?
     1420       then do:
     1421         message
     1422           vss-workfile vss-revision vss-description skip
