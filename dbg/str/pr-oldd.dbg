      986           "Артикул" p-artic p-prod-type p-prod-code skip
      987           "p-start-fact-order" p-start-fact-order skip
      988           "p-end-fact-order"   p-end-fact-order skip
      989           view-as alert-box error .
      990         undo, return error .
      991       end.
      992       if p-lock-gds-obj = true
      993       then do:
      994         do transaction
      995         on error undo, return error
      996         :
      997   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      998   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      999     (input  p-obj-type
     1000     ,input  p-obj-code
