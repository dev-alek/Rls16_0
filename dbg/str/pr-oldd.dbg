     1026     ,output v-goods-gds-goods
     1027     ) no-error .
     1028       if error-status :error
     1029       then do:
     1030         message
     1031           vss-workfile vss-revision vss-description skip
     1032           vss-include-info4 skip
     1033           "Ошибка при определении атрибута товара" skip
