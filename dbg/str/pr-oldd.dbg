     2228         then do:
     2229           message
     2230             vss-workfile vss-revision vss-description skip
     2231             vss-include-info11 skip
     2232             "Ошибка при определении базовой единицы измерения товара" skip
     2233             "Код товара" buf_goods.gds-code skip
     2234             error-status :get-message(1) skip
     2235             return-value skip
     2236             view-as alert-box error .
     2237           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2238         end.
     2239         for each buf_price-list no-lock
     2240           where buf_price-list.doc-num    = buf_main_price-list.doc-num
     2241             and buf_price-list.main-price = false
     2242             and buf_price-list.artic      = buf_main_price-list.artic
     2243             and buf_price-list.prod-type  = buf_main_price-list.prod-type
     2244             and buf_price-list.prod-code  = buf_main_price-list.prod-code
     2245         :
     2246           if buf_price-list.doc-qnty = ?
     2247           then do:
     2248             find first buf_bar-code no-lock
     2249               where buf_bar-code.b-code = buf_price-list.b-code
     2250               no-error .
     2251             if available buf_bar-code
     2252             and buf_bar-code.unit-cli = v-unit-base
     2253             then do:
     2254               message
     2255                 vss-workfile vss-revision vss-description skip
     2256                 vss-include-info11 skip
     2257                 "Ошибка при закрытии переоценки" skip
     2258                 "Не задано количество для бар-кода с основной единицей измерения" skip
     2259                 "Переоценка" buf_main_price-list.doc-num skip
     2260                 "Бар-код" buf_price-list.b-code skip
     2261                 "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2262                 "Количество" buf_price-list.doc-qnty skip
     2263                 "Основная единица измерения" v-unit-base skip
     2264                 "Единица измерения бар-кода" buf_bar-code.unit-cli skip
     2265                 view-as alert-box error .
     2266               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2267             end.
     2268             next .
     2269           end.
     2270           if not can-find
     2271             (first buf_bar-code
     2272             where buf_bar-code.b-code = buf_price-list.b-code
     2273             )
     2274           then do:
     2275             message
     2276               vss-workfile vss-revision vss-description skip
     2277               vss-include-info11 skip
     2278               "В переоценке задан несуществующий бар-код" skip
     2279               "Переоценка" buf_price-list.doc-num skip
     2280               "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     2281               "Бар-код" buf_price-list.b-code skip
     2282               view-as alert-box error .
     2283             undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2284           end.
     2285           if buf_price-list.doc-qnty <> 0
     2286           then do:
     2287             run prl-vat in this-procedure
     2288               (input  recid(buf_price-list)
     2289               ,output price-rubl-with-tax-sale-prl
     2290               ,output price-base-with-tax-sale-prl
     2291               ,output price-rubl-without-tax-sale-prl
     2292               ,output price-base-without-tax-sale-prl
     2293               ,output vat-base-sale-prl
     2294               ,output vat-rubl-sale-prl
     2295               ,output vat-base-buyer-prl
     2296               ,output vat-rubl-buyer-prl
     2297               ,output slt-base-sale-prl
     2298               ,output slt-rubl-sale-prl
     2299               ,output road-tax-base-sale-prl
     2300               ,output road-tax-rubl-sale-prl
     2301               ,output excise-base-sale-prl
     2302               ,output excise-rubl-sale-prl
     2303               ,output discnt-base-sale-prl
     2304               ,output discnt-rubl-sale-prl
     2305               ) no-error .
     2306             if error-status :error
     2307             then do:
     2308               message
     2309                 vss-workfile vss-revision vss-description skip
     2310                 vss-include-info11 skip
     2311                 "Ошибка при вызове процеды prl-vat" skip
     2312                 "Документ" buf_price-list.doc-num skip
     2313                 "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     2314                 error-status :get-message(1) skip
     2315                 return-value skip
     2316                 view-as alert-box error .
     2317               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2318             end.
     2319           end.
     2320           else do:
     2321             assign
     2322               price-rubl-with-tax-sale-prl    = 0
     2323               price-base-with-tax-sale-prl    = 0
     2324               price-rubl-without-tax-sale-prl = 0
     2325               price-base-without-tax-sale-prl = 0
     2326               vat-base-sale-prl               = 0
     2327               vat-rubl-sale-prl               = 0
     2328               vat-base-buyer-prl              = 0
     2329               vat-rubl-buyer-prl              = 0
     2330               slt-base-sale-prl               = 0
     2331               slt-rubl-sale-prl               = 0
     2332               road-tax-base-sale-prl          = 0
     2333               road-tax-rubl-sale-prl          = 0
     2334               excise-base-sale-prl            = 0
     2335               excise-rubl-sale-prl            = 0
     2336               discnt-base-sale-prl            = 0
     2337               discnt-rubl-sale-prl            = 0
     2338             .
     2339           end.
     2340           if v-curr-r-b = 'base':U
     2341           then do:
     2342             assign
     2343               p-fact-qnty         = p-fact-qnty
     2344                                   + buf_price-list.doc-qnty
     2345               p-cur-base          = p-cur-base
     2346                                   + price-base-with-tax-sale-prl * buf_price-list.doc-qnty
     2347               p-cur-VAT-base      = p-cur-VAT-base
     2348                                   + vat-base-sale-prl * buf_price-list.doc-qnty
     2349               p-cur-SLT-base      = p-cur-SLT-base
     2350                                   + slt-base-sale-prl * buf_price-list.doc-qnty
     2351               p-cur-road-tax-base = p-cur-road-tax-base
     2352                                   + road-tax-base-sale-prl * buf_price-list.doc-qnty
     2353               p-cur-excise-base   = p-cur-excise-base
     2354                                   + excise-base-sale-prl * buf_price-list.doc-qnty
     2355             .
     2356           end.
     2357           else do:
     2358             assign
     2359               p-fact-qnty         = p-fact-qnty
     2360                                   + buf_price-list.doc-qnty
     2361               p-cur-base          = p-cur-base
     2362                                   + price-rubl-with-tax-sale-prl * buf_price-list.doc-qnty
     2363               p-cur-VAT-base      = p-cur-VAT-base
     2364                                   + vat-rubl-sale-prl * buf_price-list.doc-qnty
     2365               p-cur-SLT-base      = p-cur-SLT-base
     2366                                   + slt-rubl-sale-prl * buf_price-list.doc-qnty
     2367               p-cur-road-tax-base = p-cur-road-tax-base
     2368                                   + road-tax-rubl-sale-prl * buf_price-list.doc-qnty
     2369               p-cur-excise-base   = p-cur-excise-base
     2370                                   + excise-rubl-sale-prl * buf_price-list.doc-qnty
     2371             .
     2372           end.
     2373         end.
     2374     end.
     2375   end procedure.
     2376   procedure prdoclib-calc-prc :
     2377     define input  parameter p-price-doc-recid as   recid                  no-undo.
     2378     define input  parameter p-cons-pay        as   integer                no-undo.
     2379     define output parameter p-ov-cons         like ub.doc-line.price-base no-undo.
     2380     define output parameter p-ov-VAT-cons     like ub.doc-line.price-base no-undo.
     2381     define output parameter p-ov-SLT-cons     like ub.doc-line.price-base no-undo.
     2382     define output parameter p-ov-prch         like ub.doc-line.price-base no-undo.
     2383     define output parameter p-ov-VAT-prch     like ub.doc-line.price-base no-undo.
     2384     define output parameter p-ov-SLT-prch     like ub.doc-line.price-base no-undo.
     2385     do
     2386     on error undo, return error return-value
     2387     :
     2388       define buffer buf_price-doc       for ub.price-doc .
     2389       define buffer buf_price-list      for ub.price-list .
     2390       define buffer buf_parts           for ub.parts .
     2391       define variable v-ov-qnty     as decimal   no-undo .
     2392       define variable v-ov-base     as decimal   no-undo .
     2393       define variable v-ov-VAT-base as decimal   no-undo .
     2394       define variable v-ov-SLT-base as decimal   no-undo .
     2395       define variable v-cons-qnty   as decimal   no-undo .
     2396       define variable v-prch-qnty   as decimal   no-undo .
     2397       define variable v-cons-mult   as decimal   no-undo .
     2398       define variable v-prch-mult   as decimal   no-undo .
     2399       find first buf_price-doc no-lock
     2400         where recid(buf_price-doc) = p-price-doc-recid
     2401         no-error .
     2402       if not available buf_price-doc
     2403       then do:
     2404         message
     2405           vss-workfile vss-revision vss-description skip
     2406           vss-include-info11 skip
     2407           "Ошибка задания входных параметров" skip
     2408           "Не найден документ переоценки" skip
     2409           "Код записи (recid)" p-price-doc-recid skip
     2410           view-as alert-box error .
     2411         undo, return error .
     2412       end.
     2413       for each buf_price-list no-lock
     2414         where buf_price-list.doc-num    = buf_price-doc.doc-num
     2415           and buf_price-list.main-price = true
     2416       on error undo, return error return-value
     2417       :
     2418         run prdoclib-calc-ov
     2419           (input recid(buf_price-list)
     2420           ,output v-ov-qnty
     2421           ,output v-ov-base
     2422           ,output v-ov-VAT-base
     2423           ,output v-ov-SLT-base
     2424           ) no-error .
     2425         if error-status :error
     2426         then do:
     2427           if error-status :get-message(1) <> ""
     2428           then do:
     2429             message
     2430               vss-workfile vss-revision vss-description skip
     2431               vss-include-info11 skip
     2432               "Ошибка при вызове процедуры prdoclib-calc-ov" skip
     2433               error-status :get-message(1) skip
     2434               return-value skip
     2435               view-as alert-box error .
     2436           end.
     2437           undo, return error return-value .
     2438         end.
     2439         assign
     2440           v-cons-qnty = 0
     2441           v-prch-qnty = 0
     2442         .
     2443         for each buf_parts no-lock
     2444           where buf_parts.out-code  = buf_price-list.doc-num
     2445             and buf_parts.obj-type  = buf_price-list.obj-type
     2446             and buf_parts.obj-code  = buf_price-list.obj-code
     2447             and buf_parts.artic     = buf_price-list.artic
     2448             and buf_parts.prod-type = buf_price-list.prod-type
     2449             and buf_parts.prod-code = buf_price-list.prod-code
     2450         on error undo, return error return-value
     2451         :
     2452           if buf_parts.pay-code = p-cons-pay
     2453           then do:
     2454             assign
     2455               v-cons-qnty = v-cons-qnty + buf_parts.fact-qnty
     2456             .
     2457           end.
     2458           else do:
     2459             assign
     2460               v-prch-qnty = v-prch-qnty + buf_parts.fact-qnty
     2461             .
     2462           end.
     2463         end.
     2464         if (v-cons-qnty + v-prch-qnty) = 0
     2465         then do:
     2466           assign
     2467             v-cons-mult = 0
     2468             v-prch-mult = 1
     2469           .
     2470         end.
     2471         else do:
     2472           assign
     2473             v-cons-mult = v-cons-qnty / (v-cons-qnty + v-prch-qnty)
     2474             v-prch-mult = v-prch-qnty / (v-cons-qnty + v-prch-qnty)
     2475           .
     2476         end.
     2477         assign
     2478           p-ov-cons     = p-ov-cons     + v-ov-base     * v-cons-mult
     2479           p-ov-VAT-cons = p-ov-VAT-cons + v-ov-VAT-base * v-cons-mult
     2480           p-ov-SLT-cons = p-ov-SLT-cons + v-ov-SLT-base * v-cons-mult
     2481           p-ov-prch     = p-ov-prch     + v-ov-base     * v-prch-mult
     2482           p-ov-VAT-prch = p-ov-VAT-prch + v-ov-VAT-base * v-prch-mult
     2483           p-ov-SLT-prch = p-ov-SLT-prch + v-ov-SLT-base * v-prch-mult
     2484         .
     2485       end.
     2486     end.
     2487   end procedure.
     2488   procedure prdoclib-calc-ov :
     2489     define input  parameter p-price-list-recid as recid     no-undo .
     2490     define output parameter p-fact-qnty        as decimal   no-undo .
     2491     define output parameter p-ov-base          as decimal   no-undo .
     2492     define output parameter p-ov-VAT-base      as decimal   no-undo .
     2493     define output parameter p-ov-SLT-base      as decimal   no-undo .
     2494     do
     2495     on error undo, return error return-value
     2496     :
     2497       define buffer buf_main_price-list    for ub.price-list .
     2498       define buffer buf_prev_price-list    for ub.price-list .
     2499       define buffer buf_special_price-list for ub.price-list .
     2500       define buffer buf_goods              for ub.goods .
     2501       define variable v-fact-qnty             like ub.doc-line.price-base no-undo.
     2502       define variable v-cur-base              like ub.doc-line.price-base no-undo.
     2503       define variable v-cur-VAT-base          like ub.doc-line.price-base no-undo.
     2504       define variable v-cur-SLT-base          like ub.doc-line.price-base no-undo.
     2505       define variable v-cur-road-tax-base     like ub.doc-line.price-base no-undo.
     2506       define variable v-cur-excise-base       like ub.doc-line.price-base no-undo.
     2507       define variable v-prev-price-list-recid as   recid                  no-undo.
     2508       define variable v-prev-cli-base-rate    like ub.goods.cli-base-rate no-undo.
     2509       define variable v-prev-fact-qnty        like ub.doc-line.price-base no-undo.
     2510       define variable v-prev-cur-base         like ub.doc-line.price-base no-undo.
     2511       define variable v-prev-cur-VAT-base     like ub.doc-line.price-base no-undo.
     2512       define variable v-prev-cur-SLT-base     like ub.doc-line.price-base no-undo.
     2513       find first buf_main_price-list no-lock
     2514         where recid(buf_main_price-list) = p-price-list-recid
     2515         no-error .
     2516       if not available buf_main_price-list
     2517       then do:
     2518         message
     2519           vss-workfile vss-revision vss-description skip
     2520           vss-include-info11 skip
     2521           "Ошибка задания входных параметров" skip
     2522           "Не найдена строка переоценки" skip
     2523           "Код записи (recid)" p-price-list-recid skip
     2524           view-as alert-box error .
     2525         undo, return error .
     2526       end.
     2527       if buf_main_price-list.main-price <> true
     2528       then do:
     2529         message
     2530           vss-workfile vss-revision vss-description skip
     2531           vss-include-info11 skip
     2532           "Ошибка задания входных параметров" skip
     2533           "Строка переоценки не является основной" skip
     2534           "Код записи (recid)" p-price-list-recid skip
     2535           "Переоценка" buf_main_price-list.doc-num skip
     2536           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2537           "Бар-код" buf_main_price-list.b-code skip
     2538           view-as alert-box error .
     2539         undo, return error .
     2540       end.
     2541       run prdoclib-calc-fact-sale in this-procedure
     2542         (input  recid(buf_main_price-list)
     2543         ,output v-fact-qnty
     2544         ,output v-cur-base
     2545         ,output v-cur-VAT-base
     2546         ,output v-cur-SLT-base
     2547         ,output v-cur-road-tax-base
     2548         ,output v-cur-excise-base
     2549         ) no-error.
     2550       if error-status :error
     2551       then do:
     2552         message
     2553           vss-workfile vss-revision vss-description skip
     2554           vss-include-info11 skip
     2555           "Ошибка при расчете сумм переоценки." skip
     2556           "Документ переоценки" buf_main_price-list.doc-num skip
     2557           "Товар" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2558           error-status :get-message(1) skip
     2559           return-value skip
     2560           view-as alert-box error .
     2561         undo, return error .
     2562       end.
     2563   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2564   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     2565     (input  buf_main_price-list.obj-type
     2566     ,input  buf_main_price-list.obj-code
     2567     ,input  buf_main_price-list.b-code
     2568     ,input  buf_main_price-list.b-code
     2569     ,input  buf_main_price-list.fact-order
     2570     ,output v-prev-price-list-recid
     2571     ,output v-prev-cli-base-rate
     2572     ) no-error .
     2573       if error-status :error
     2574       then do:
     2575         message
     2576           vss-workfile vss-revision vss-description skip
     2577           vss-include-info11 skip
     2578           "Ошибка при поиске предыдущей переоценки." skip
     2579           "Документ переоценки " buf_main_price-list.doc-num skip
     2580           "Товар " buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2581           error-status :get-message(1) skip
     2582           return-value skip
     2583           view-as alert-box error .
     2584         undo, return error .
     2585       end.
     2586       if v-prev-price-list-recid <> ?
     2587       then do:
     2588         find first buf_prev_price-list no-lock
     2589           where recid(buf_prev_price-list) = v-prev-price-list-recid
     2590           .
     2591         find first buf_special_price-list no-lock
     2592           where buf_special_price-list.doc-num    = buf_prev_price-list.doc-num
     2593             and buf_special_price-list.main-price = false
     2594             and buf_special_price-list.artic      = buf_prev_price-list.artic
     2595             and buf_special_price-list.prod-type  = buf_prev_price-list.prod-type
     2596             and buf_special_price-list.prod-code  = buf_prev_price-list.prod-code
     2597             and buf_special_price-list.doc-qnty   <> ?
     2598           no-error .
     2599         if available buf_special_price-list
     2600         then do:
     2601           message
     2602             "Товар имеет специальные цены на признаки" skip
     2603             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     2604             "Переоценка" buf_prev_price-list.doc-num skip
     2605             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     2606             view-as alert-box error .
     2607           undo, return error .
     2608         end.
     2609         find first buf_goods no-lock
     2610           where buf_goods.artic     = buf_main_price-list.artic
     2611             and buf_goods.prod-type = buf_main_price-list.prod-type
     2612             and buf_goods.prod-code = buf_main_price-list.prod-code
     2613           no-error .
     2614         if not available buf_goods
     2615         then do:
     2616           message
     2617             vss-workfile vss-revision vss-description skip
     2618             vss-include-info11 skip
     2619             "Не найден товар" skip
     2620             "Переоценка" buf_main_price-list.doc-num skip
     2621             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2622             view-as alert-box error .
     2623           undo, return error .
     2624         end.
     2625         if buf_prev_price-list.vat-pc = ?
     2626         or buf_prev_price-list.slt-pc = ?
     2627         then do:
     2628           message
     2629             "В переоценке не заданы налоги товара" skip
     2630             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     2631             "Переоценка" buf_prev_price-list.doc-num skip
     2632             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     2633             "НДС" buf_prev_price-list.vat-pc skip
     2634             "НП" buf_prev_price-list.slt-pc skip
     2635             view-as alert-box error .
     2636           undo, return error return-value .
     2637         end.
     2638         define variable v-prev-cur-SLT-pc as decimal no-undo .
     2639         assign
     2640           v-prev-cur-SLT-pc   = buf_prev_price-list.price-sale * buf_prev_price-list.slt-pc / (100 + buf_prev_price-list.slt-pc)
     2641         .
     2642         assign
     2643           v-prev-cur-base     = v-fact-qnty * buf_prev_price-list.price-sale
     2644           v-prev-cur-VAT-base = v-fact-qnty
     2645                               * (buf_prev_price-list.price-sale - v-prev-cur-SLT-pc)
     2646                               * buf_prev_price-list.vat-pc / (100 + buf_prev_price-list.vat-pc)
     2647           v-prev-cur-SLT-base = v-fact-qnty * v-prev-cur-SLT-pc
     2648         .
     2649         assign
     2650           p-fact-qnty   = v-fact-qnty
     2651           p-ov-base     = v-cur-base     - v-prev-cur-base
     2652           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     2653           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     2654         .
     2655       end.
     2656       else do:
     2657         assign
     2658           v-prev-cur-base     = 0
     2659           v-prev-cur-VAT-base = 0
     2660           v-prev-cur-SLT-base = 0
     2661           .
     2662         assign
     2663           p-fact-qnty   = v-fact-qnty
     2664           p-ov-base     = v-cur-base     - v-prev-cur-base
     2665           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     2666           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     2667         .
     2668       end.
     2669     end.
     2670   end procedure.
     2671   procedure prdoclib-init-prt-obj-by-factord :
     2672     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     2673     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     2674     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     2675     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     2676     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     2677     define input parameter p-fact-order         as decimal   no-undo .
     2678     define input parameter p-include-fact-order as logical   no-undo .
     2679     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-factord: определение остатков по признакам на любой момент времени".
     2680     define buffer buf_gds-obj      for ub.gds-obj .
     2681     define buffer buf_doc-line     for ub.doc-line .
     2682     define buffer buf_temp-prt-obj for temp-prt-obj .
     2683     define variable v-total-gds-dtl-qnty as decimal   no-undo .
     2684     do
     2685     on error undo, return error return-value
     2686     :
     2687       do transaction
     2688       on error undo, return error return-value
     2689       :
     2690   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2691   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2692     (input  p-obj-type
     2693     ,input  p-obj-code
     2694     ,input  p-artic
     2695     ,input  p-prod-type
     2696     ,input  p-prod-code
     2697     ,buffer buf_gds-obj
     2698     ) no-error .
     2699         if error-status :error
     2700         then do:
     2701           message
     2702             vss-workfile vss-revision vss-description skip
     2703             vss-include-info11 skip
     2704             "Невозможно найти gds-obj" skip
     2705             error-status :get-message(1) skip
     2706             return-value skip
     2707             view-as alert-box error .
     2708           undo, return error .
     2709         end.
     2710         find current buf_gds-obj exclusive-lock .
     2711       end.
     2712       run prdoclib-init-temp-prt-obj in this-procedure
     2713         (input p-obj-type
     2714         ,input p-obj-code
     2715         ,input p-artic
     2716         ,input p-prod-type
     2717         ,input p-prod-code
     2718         ,input 0
     2719         ) .
     2720       for each buf_temp-prt-obj
     2721         where buf_temp-prt-obj.is-term <> true
     2722       on error undo, return error return-value
     2723       :
     2724         delete buf_temp-prt-obj .
     2725       end.
     2726       if p-include-fact-order = true
     2727       then do:
     2728         assign
     2729          p-fact-order = p-fact-order - 0.0000000001
     2730         .
     2731       end.
     2732       for each buf_doc-line no-lock
     2733         where buf_doc-line.obj-type   = p-obj-type
     2734           and buf_doc-line.obj-code   = p-obj-code
     2735           and buf_doc-line.artic      = p-artic
     2736           and buf_doc-line.prod-type  = p-prod-type
     2737           and buf_doc-line.prod-code  = p-prod-code
     2738           and buf_doc-line.status_    = 'факт':U
     2739           and buf_doc-line.fact-order >= p-fact-order
     2740       on error undo, return error return-value
     2741       :
     2742         run prdoclib-process-document in this-procedure
     2743           (input  buf_doc-line.doc-code
     2744           ,input  p-obj-type
     2745           ,input  p-obj-code
     2746           ,input  p-artic
     2747           ,input  p-prod-type
     2748           ,input  p-prod-code
     2749           ,output v-total-gds-dtl-qnty
     2750           ) .
     2751       end.
     2752     end.
     2753   end procedure.
     2754   procedure prdoclib-process-document :
     2755     define input  parameter p-doc-code           as character no-undo .
     2756     define input  parameter p-obj-type           as character no-undo .
     2757     define input  parameter p-obj-code           as integer   no-undo .
     2758     define input  parameter p-artic              as character no-undo .
     2759     define input  parameter p-prod-type          as character no-undo .
     2760     define input  parameter p-prod-code          as integer   no-undo .
     2761     define output parameter p-total-gds-dtl-qnty as decimal   no-undo .
     2762     define buffer buf_trn-doc      for ub.trn-doc .
     2763     define buffer buf_gds-dtl      for ub.gds-dtl .
     2764     define buffer buf_temp-prt-obj for temp-prt-obj .
     2765     do
     2766     on error undo, return error return-value
     2767     :
     2768       find first buf_trn-doc no-lock
     2769         where buf_trn-doc.doc-code = p-doc-code
     2770         no-error .
     2771       if not available buf_trn-doc then do:
     2772         message
     2773           vss-workfile vss-revision vss-description skip
     2774           vss-include-info11 skip
     2775           "Ошибка при поиске документа" skip
     2776           "Документ" p-doc-code skip
     2777           "Объект" p-obj-type p-obj-code skip
     2778           "Артикул" p-artic p-prod-type p-prod-code skip
     2779           view-as alert-box error .
     2780         undo, return error .
     2781       end.
     2782       assign
     2783         p-total-gds-dtl-qnty = 0
     2784       .
     2785       for each buf_gds-dtl no-lock
     2786         where buf_gds-dtl.doc-code  = p-doc-code
     2787           and buf_gds-dtl.artic     = p-artic
     2788           and buf_gds-dtl.prod-type = p-prod-type
     2789           and buf_gds-dtl.prod-code = p-prod-code
     2790       on error undo, return error
     2791       :
     2792         define variable v-term-node as integer   no-undo .
     2793   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     2794     (input  buf_gds-dtl.prt-code
     2795     ,output v-term-node
     2796     )  .
     2797         run prdoclib-temp-prt-obj-by-prt-root in this-procedure
     2798           (input  v-term-node
     2799           ,buffer buf_temp-prt-obj
     2800           ) .
     2801         if buf_temp-prt-obj.is-term <> true then do:
     2802           undo, return error substitute("Документ ссылается на нетерминальный признак. Код признака &1"
     2803                                        ,buf_gds-dtl.prt-code
     2804                                        ) .
     2805         end.
     2806         case buf_trn-doc.doc-type :
     2807           when 'при':U or
     2808           when 'возврат':U
     2809           then do:
     2810             assign
     2811               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2812                                           - buf_gds-dtl.fact-qnty
     2813               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2814                                           - buf_gds-dtl.fact-qnty
     2815             .
     2816           end.
     2817           when 'рас':U or
     2818           when 'спи':U
     2819           then do:
     2820             assign
     2821               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2822                                           + buf_gds-dtl.fact-qnty
     2823               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2824                                           + buf_gds-dtl.fact-qnty
     2825             .
     2826           end.
     2827           when 'инв':U
     2828           then do:
     2829             assign
     2830               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     2831                                           - buf_gds-dtl.doc-qnty
     2832               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     2833                                           - buf_gds-dtl.doc-qnty
     2834             .
     2835           end.
     2836           otherwise do:
     2837             undo, return error substitute("Неизвестный тип документа &1"
     2838                                          ,buf_trn-doc.doc-type
     2839                                          ) .
     2840           end.
     2841         end.
     2842       end.
     2843     end.
     2844   end procedure.
     2845   procedure prdoclib-prc-pl-document :
     2846     define input  parameter p-doc-code              as character no-undo .
     2847     define input  parameter p-obj-type              as character no-undo .
     2848     define input  parameter p-obj-code              as integer   no-undo .
     2849     define input  parameter p-gds-code              as integer   no-undo .
     2850     define output parameter p-total-pl-gds-qnty     as decimal   no-undo .
     2851     define output parameter p-total-pl-gds-cli-qnty as decimal   no-undo .
     2852     do
     2853     on error undo, return error return-value
     2854     :
     2855       define buffer buf_trn-doc      for ub.trn-doc .
     2856       define buffer buf_doc-pl       for ub.doc-pl .
     2857       define buffer buf_temp-pl-gds for temp-pl-gds .
     2858       define variable v-sign as decimal   no-undo .
     2859       find first buf_trn-doc no-lock
     2860         where buf_trn-doc.doc-code = p-doc-code
     2861         no-error .
     2862       if not available buf_trn-doc then do:
     2863         message
     2864           vss-workfile vss-revision vss-description skip
     2865           vss-include-info11 skip
     2866           "Ошибка при поиске документа" skip
     2867           "Документ" p-doc-code skip
     2868           "Объект" p-obj-type p-obj-code skip
     2869           "Товар" p-gds-code skip
     2870           view-as alert-box error .
     2871         undo, return error .
     2872       end.
     2873       assign
     2874         p-total-pl-gds-qnty     = 0
     2875         p-total-pl-gds-cli-qnty = 0
     2876       .
     2877       for each buf_doc-pl no-lock
     2878         where buf_doc-pl.out-code  = p-doc-code
     2879           and buf_doc-pl.gds-code  = p-gds-code
     2880       on error undo, return error return-value
     2881       :
     2882         find first buf_temp-pl-gds
     2883           where buf_temp-pl-gds.obj-type = buf_trn-doc.obj-type
     2884             and buf_temp-pl-gds.obj-code = buf_trn-doc.obj-code
     2885             and buf_temp-pl-gds.pl-code  = buf_doc-pl.pl-code
     2886           .
     2887         case buf_trn-doc.doc-type :
     2888           when 'при':U
     2889           or when 'возврат':U
     2890           or when 'инв':U
     2891           then do:
     2892             assign
     2893               v-sign = -1.0
     2894             .
     2895           end.
     2896           when 'рас':U or
     2897           when 'спи':U
     2898           then do:
     2899             assign
     2900               v-sign = 1.0
     2901             .
     2902           end.
     2903           otherwise do:
     2904             undo, return error substitute("(prdoclib-prc-pl-document) Неизвестный тип документа &1", buf_trn-doc.doc-type ) .
     2905           end.
     2906         end case.
     2907         assign
     2908           p-total-pl-gds-qnty           = p-total-pl-gds-qnty           + buf_doc-pl.fact-qnty     * v-sign
     2909           p-total-pl-gds-cli-qnty       = p-total-pl-gds-cli-qnty       + buf_doc-pl.cli-fact-qnty * v-sign
     2910           buf_temp-pl-gds.fact-qnty     = buf_temp-pl-gds.fact-qnty     + buf_doc-pl.fact-qnty     * v-sign
     2911           buf_temp-pl-gds.cli-fact-qnty = buf_temp-pl-gds.cli-fact-qnty + buf_doc-pl.cli-fact-qnty * v-sign
     2912         .
     2913       end.
     2914     end.
     2915   end procedure.
     2916   procedure prdoclib-init-prt-obj-by-date :
     2917     define input parameter p-obj-type   like ub.gds-obj.obj-type  no-undo .
     2918     define input parameter p-obj-code   like ub.gds-obj.obj-code  no-undo .
     2919     define input parameter p-artic      like ub.gds-obj.artic     no-undo .
     2920     define input parameter p-prod-type  like ub.gds-obj.prod-type no-undo .
     2921     define input parameter p-prod-code  like ub.gds-obj.prod-code no-undo .
     2922     define input parameter p-fact-date  as date      no-undo .
     2923     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-date: определение остатков по признакам на конец дня".
     2924     do
     2925     on error undo, return error return-value
     2926     :
     2927       define variable v-fact-order                as decimal   no-undo .
     2928       define variable v-shift-end-fact-order      as decimal   no-undo .
     2929       define variable v-day-end-fact-order        as decimal   no-undo .
     2930       run factord in this-procedure
     2931         (input  p-fact-date
     2932         ,input  1
     2933         ,input  1
     2934         ,input  ?
     2935         ,input  0
     2936         ,input  false
     2937         ,output v-fact-order
     2938         ,output v-shift-end-fact-order
     2939         ,output v-day-end-fact-order
     2940         ) no-error .
     2941       if error-status :error
     2942       then do:
     2943         message
     2944           vss-workfile vss-revision vss-description skip
     2945           vss-include-info11 skip
     2946           "Ошибка при определении момента времени, на который требуется остаток" skip
     2947           "Объект" p-obj-type p-obj-code skip
     2948           "Артикул" p-artic p-prod-type p-prod-code skip
     2949           "Дата" p-fact-date skip
     2950           view-as alert-box error .
     2951         undo, return error .
     2952       end.
     2953       run prdoclib-init-prt-obj-by-date-factord in this-procedure
     2954         (input p-obj-type
     2955         ,input p-obj-code
     2956         ,input p-artic
     2957         ,input p-prod-type
     2958         ,input p-prod-code
     2959         ,input v-day-end-fact-order
     2960         ,input false
     2961         ) no-error .
     2962       if error-status :error
     2963       then do:
     2964         message
     2965           vss-workfile vss-revision vss-description skip
     2966           vss-include-info11 skip
     2967           "Ошибка при вызове метода prdoclib-init-prt-obj-by-date-factord" skip
     2968           "Объект" p-obj-type p-obj-code skip
     2969           "Артикул" p-artic p-prod-type p-prod-code skip
     2970           "Дата" p-fact-date skip
     2971           view-as alert-box error .
     2972         undo, return error .
     2973       end.
     2974     end.
     2975   end procedure.
     2976   procedure prdoclib-calc-temp-fact-sale :
     2977     define input  parameter p-obj-type           as character no-undo .
     2978     define input  parameter p-obj-code           as integer   no-undo .
     2979     define input  parameter p-gds-code           as integer   no-undo .
     2980     define input  parameter p-day-end-fact-order as decimal   no-undo .
     2981     define input  parameter p-curr-r-b           as character no-undo .
     2982     define output parameter p-fact-qnty          as decimal   no-undo .
     2983     define output parameter p-cur-base           as decimal   no-undo .
     2984     define output parameter p-cur-VAT-base       as decimal   no-undo .
     2985     define output parameter p-cur-SLT-base       as decimal   no-undo .
     2986     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     2987     define output parameter p-cur-excise-base    as decimal   no-undo .
     2988     define buffer buf_temp-prt-obj for temp-prt-obj .
     2989     define variable v-prt-b-code        like ub.bar-code.b-code no-undo .
     2990     define variable v-cli-base-rate     like ub.bar-code.cli-base-rate no-undo .
     2991     define variable parrecid-prl        as recid     no-undo .
     2992     define variable v-fact-qnty         as decimal   no-undo .
     2993     define variable v-cur-base          as decimal   no-undo .
     2994     define variable v-cur-VAT-base      as decimal   no-undo .
     2995     define variable v-cur-SLT-base      as decimal   no-undo .
     2996     define variable v-cur-road-tax-base as decimal   no-undo .
     2997     define variable v-cur-excise-base   as decimal   no-undo .
     2998     define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     2999     define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     3000     define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     3001     define variable price-base-without-tax-sale-prl as decimal   no-undo .
     3002     define variable vat-base-sale-prl               as decimal   no-undo .
     3003     define variable vat-rubl-sale-prl               as decimal   no-undo .
     3004     define variable vat-base-buyer-prl              as decimal   no-undo .
     3005     define variable vat-rubl-buyer-prl              as decimal   no-undo .
     3006     define variable slt-base-sale-prl               as decimal   no-undo .
     3007     define variable slt-rubl-sale-prl               as decimal   no-undo .
     3008     define variable road-tax-base-sale-prl          as decimal   no-undo .
     3009     define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     3010     define variable excise-base-sale-prl            as decimal   no-undo .
     3011     define variable excise-rubl-sale-prl            as decimal   no-undo .
     3012     define variable discnt-base-sale-prl            as decimal   no-undo .
     3013     define variable discnt-rubl-sale-prl            as decimal   no-undo .
     3014     do
     3015     on error undo, return error return-value
     3016     :
     3017       for each buf_temp-prt-obj no-lock
     3018       on error undo, return error return-value
     3019       :
     3020   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3021     (input  p-gds-code
     3022     ,input  buf_temp-prt-obj.prt-code
     3023     ,output v-prt-b-code
     3024     ) no-error .
     3025         if error-status :error
     3026         then do:
     3027           message
     3028             vss-workfile vss-revision vss-description skip
     3029             "Ошибка при определении бар-кода признака" skip
     3030             "Код товара"   p-gds-code skip
     3031             "Код признака" buf_temp-prt-obj.prt-code skip
     3032             error-status :get-message(1) skip
     3033             return-value skip
     3034             view-as alert-box error .
     3035           undo, return error .
     3036         end.
     3037   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3038   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     3039     (input  p-obj-type
     3040     ,input  p-obj-code
     3041     ,input  v-prt-b-code
     3042     ,input  0
     3043     ,input  p-day-end-fact-order
     3044     ,output parrecid-prl
     3045     ,output v-cli-base-rate
     3046     ) no-error .
     3047         if error-status :error
     3048         then do:
     3049           message
     3050             vss-workfile vss-revision vss-description skip
     3051             "Ошибка при определении цены бар-кода" skip
     3052             "Объект" p-obj-type p-obj-code skip
     3053             "Бар-код" v-prt-b-code skip
     3054             "fact-order" p-day-end-fact-order skip
     3055             error-status :get-message(1) skip
     3056             return-value skip
     3057             view-as alert-box error .
     3058           undo, return error .
     3059         end.
     3060         if parrecid-prl <> ?
     3061         then do:
     3062           run prl-vat in this-procedure
     3063             (input  parrecid-prl
     3064             ,output price-rubl-with-tax-sale-prl
     3065             ,output price-base-with-tax-sale-prl
     3066             ,output price-rubl-without-tax-sale-prl
     3067             ,output price-base-without-tax-sale-prl
     3068             ,output vat-base-sale-prl
     3069             ,output vat-rubl-sale-prl
     3070             ,output vat-base-buyer-prl
     3071             ,output vat-rubl-buyer-prl
     3072             ,output slt-base-sale-prl
     3073             ,output slt-rubl-sale-prl
     3074             ,output road-tax-base-sale-prl
     3075             ,output road-tax-rubl-sale-prl
     3076             ,output excise-base-sale-prl
     3077             ,output excise-rubl-sale-prl
     3078             ,output discnt-base-sale-prl
     3079             ,output discnt-rubl-sale-prl
     3080             ) no-error .
     3081           if error-status :error
     3082           then do:
     3083             message
     3084               vss-workfile vss-revision vss-description skip
     3085               "Ошибка при вызове процеды prl-vat" skip
     3086               "Объект" p-obj-type p-obj-code skip
     3087               "Код товара" p-gds-code skip
     3088               "Указатель на запись переоценки" parrecid-prl skip
     3089               error-status :get-message(1) skip
     3090               return-value skip
     3091               view-as alert-box error .
     3092             undo, return error .
     3093           end.
     3094         end.
     3095         else do:
     3096           assign
     3097             price-rubl-with-tax-sale-prl    = 0
     3098             price-base-with-tax-sale-prl    = 0
     3099             price-rubl-without-tax-sale-prl = 0
     3100             price-base-without-tax-sale-prl = 0
     3101             vat-base-sale-prl               = 0
     3102             vat-rubl-sale-prl               = 0
     3103             slt-base-sale-prl               = 0
     3104             slt-rubl-sale-prl               = 0
     3105             road-tax-base-sale-prl          = 0
     3106             road-tax-rubl-sale-prl          = 0
     3107             excise-base-sale-prl            = 0
     3108             excise-rubl-sale-prl            = 0
     3109             discnt-base-sale-prl            = 0
     3110             discnt-rubl-sale-prl            = 0
     3111           .
     3112         end.
     3113         assign
     3114           v-fact-qnty         = v-fact-qnty
     3115                               + buf_temp-prt-obj.fact-qnty
     3116           v-cur-base          = v-cur-base
     3117                               + (if p-curr-r-b = 'base':U
     3118                                   then price-base-with-tax-sale-prl
     3119                                   else price-rubl-with-tax-sale-prl
     3120                                 )
     3121                               * buf_temp-prt-obj.fact-qnty
     3122           v-cur-VAT-base      = v-cur-VAT-base
     3123                               + (if p-curr-r-b = 'base':U
     3124                                   then vat-base-sale-prl
     3125                                   else vat-rubl-sale-prl
     3126                                 )
     3127                               * buf_temp-prt-obj.fact-qnty
     3128           v-cur-SLT-base      = v-cur-SLT-base
     3129                               + (if p-curr-r-b = 'base':U
     3130                                   then slt-base-sale-prl
     3131                                   else slt-rubl-sale-prl
     3132                                 )
     3133                               * buf_temp-prt-obj.fact-qnty
     3134           v-cur-road-tax-base = v-cur-road-tax-base
     3135                               + (if p-curr-r-b = 'base':U
     3136                                   then road-tax-base-sale-prl
     3137                                   else road-tax-rubl-sale-prl
     3138                                 )
     3139                               * buf_temp-prt-obj.fact-qnty
     3140           v-cur-excise-base   = v-cur-excise-base
     3141                               + (if p-curr-r-b = 'base':U
     3142                                   then excise-base-sale-prl
     3143                                   else excise-rubl-sale-prl
     3144                                 )
     3145                               * buf_temp-prt-obj.fact-qnty
     3146         .
     3147       end.
     3148       assign
     3149         p-fact-qnty         = v-fact-qnty
     3150         p-cur-base          = v-cur-base
     3151         p-cur-VAT-base      = v-cur-VAT-base
     3152         p-cur-SLT-base      = v-cur-SLT-base
     3153         p-cur-road-tax-base = v-cur-road-tax-base
     3154         p-cur-excise-base   = v-cur-excise-base
     3155       .
     3156     end.
     3157   end procedure.
     3158   procedure prdoclib-clear-temp-pl-gds :
     3159     define buffer buf_temp-pl-gds for temp-pl-gds .
     3160     do
     3161     on error undo, return error return-value
     3162     :
     3163       for each buf_temp-pl-gds
     3164       on error undo, return error return-value
     3165       :
     3166         delete buf_temp-pl-gds .
     3167       end.
     3168     end.
     3169   end procedure.
     3170   procedure prdoclib-init-temp-pl-gds :
     3171     define input parameter p-obj-type        like ub.pl-gds.obj-type  no-undo .
     3172     define input parameter p-obj-code        like ub.pl-gds.obj-code  no-undo .
     3173     define input parameter p-gds-code        like ub.pl-gds.gds-code  no-undo .
     3174     define buffer buf_pl-gds      for ub.pl-gds .
     3175     define buffer buf_temp-pl-gds for temp-pl-gds .
     3176     do
     3177     on error undo, return error return-value
     3178     :
     3179       run prdoclib-clear-temp-pl-gds in this-procedure .
     3180       for each buf_pl-gds
     3181         where buf_pl-gds.obj-type = p-obj-type
     3182           and buf_pl-gds.obj-code = p-obj-code
     3183           and buf_pl-gds.gds-code = p-gds-code
     3184       on error undo, return error return-value
     3185       :
     3186         create buf_temp-pl-gds .
     3187         buffer-copy buf_pl-gds to buf_temp-pl-gds .
     3188       end.
     3189     end.
     3190   end procedure.
     3191   procedure prdoclib-init-pl-gds-by-factord :
     3192     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     3193     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     3194     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     3195     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     3196     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     3197     define input parameter p-fact-order         as decimal   no-undo .
     3198     define input parameter p-include-fact-order as logical   no-undo .
     3199     define variable vss-description as character no-undo init "prdoclib-init-pl-gds-by-factord: определение остатков по признакам на любой момент времени".
     3200     define buffer buf_goods       for ub.goods .
     3201     define buffer buf_gds-obj     for ub.gds-obj .
     3202     define buffer buf_doc-line    for ub.doc-line .
     3203     define buffer buf_temp-pl-gds for temp-pl-gds .
     3204     define variable v-total-pl-gds-qnty     as decimal   no-undo .
     3205     define variable v-total-pl-gds-cli-qnty as decimal   no-undo .
     3206     do
     3207     on error undo, return error return-value
     3208     :
     3209       do transaction
     3210       on error undo, return error return-value
     3211       :
     3212   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3213   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     3214     (input  p-obj-type
     3215     ,input  p-obj-code
     3216     ,input  p-artic
     3217     ,input  p-prod-type
     3218     ,input  p-prod-code
     3219     ,buffer buf_gds-obj
     3220     ) no-error .
     3221         if error-status :error
     3222         then do:
     3223           message
     3224             vss-workfile vss-revision vss-description skip
     3225             vss-include-info11 skip
     3226             "Невозможно найти gds-obj" skip
     3227             error-status :get-message(1) skip
     3228             return-value skip
     3229             view-as alert-box error .
     3230           undo, return error return-value .
     3231         end.
     3232         find current buf_gds-obj exclusive-lock .
     3233       end.
     3234       find first buf_goods no-lock
     3235         where buf_goods.artic     = p-artic
     3236           and buf_goods.prod-type = p-prod-type
     3237           and buf_goods.prod-code = p-prod-code
     3238         .
     3239       run prdoclib-init-temp-pl-gds in this-procedure
     3240         (input p-obj-type
     3241         ,input p-obj-code
     3242         ,input buf_goods.gds-code
     3243         ) .
     3244       if p-include-fact-order = true
     3245       then do:
     3246         assign
     3247          p-fact-order = p-fact-order - 0.0000000001
     3248         .
     3249       end.
     3250       for each buf_doc-line no-lock
     3251         where buf_doc-line.obj-type   = p-obj-type
     3252           and buf_doc-line.obj-code   = p-obj-code
     3253           and buf_doc-line.artic      = p-artic
     3254           and buf_doc-line.prod-type  = p-prod-type
     3255           and buf_doc-line.prod-code  = p-prod-code
     3256           and buf_doc-line.status_    = 'факт':U
     3257           and buf_doc-line.fact-order >= p-fact-order
     3258       on error undo, return error return-value
     3259       :
     3260         run prdoclib-prc-pl-document in this-procedure
     3261           ( input  buf_doc-line.doc-code
     3262            ,input  p-obj-type
     3263            ,input  p-obj-code
     3264            ,input  buf_goods.gds-code
     3265            ,output v-total-pl-gds-qnty
     3266            ,output v-total-pl-gds-cli-qnty
     3267           ) .
     3268       end.
     3269     end.
     3270   end procedure.
     3271   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3272   FUNCTION determined RETURNS DECIMAL (INPUT parundefine-var AS DECIMAL):
     3273      IF parundefine-var = ? THEN RETURN 0.00.
     3274                             ELSE RETURN parundefine-var.
     3275   END FUNCTION.
     3276   FUNCTION dtm-char RETURNS CHARACTER (INPUT p-undef-char AS CHARACTER):
     3277      IF p-undef-char = ? THEN do:
     3278        RETURN "?".
     3279      end.
     3280      ELSE do:
     3281        RETURN p-undef-char .
     3282      end.
     3283   END FUNCTION.
     3284   define variable p-corr-doc-code like ub.price-doc.doc-num no-undo .
     3285   define variable p-ship-num      like ub.c-price-doc.chip-num no-undo .
     3286   define variable num_rec         as integer   no-undo .
     3287   define variable start-time      as integer   no-undo .
     3288   define variable current-time    as character no-undo .
     3289   define variable current-action  as character no-undo .
     3290   define variable v-description-ord-type as character no-undo .
     3291   define variable v-today         as date      no-undo.
     3292   define variable v-time          as integer   no-undo.
     3293   define variable loc-qnty        like    ub.price-list.doc-qnty no-undo .
     3294   define variable varcut-status    as integer                   no-undo.
     3295   define variable varcut-date      as date                      no-undo.
     3296   define variable varcut-fin-date  as date                      no-undo.
     3297   define buffer prt-price-list for price-list .
     3298   define frame a
     3299     ub.price-doc.doc-num                       label "Переоценка" skip
     3300     ub.price-doc.status_                       label "Статус" skip
     3301     current-action         format "x(40)"      no-label skip
     3302     num_rec                format ">>>>>>>9"   label "Обработано артикулов" skip
     3303     ub.price-list.artic                        label "Текущий артикул" skip
     3304     current-time           format "x(8)"       label "Время" skip
     3305     with view-as dialog-box side-labels three-d
     3306     title "Пересчет переоценки"
     3307     .
     3308   main-block :
     3309   do transaction
     3310   on error undo main-block, return error
     3311   :
     3312     find first ub.price-doc exclusive-lock
     3313       where ub.price-doc.doc-num = p-doc-num
     3314       no-error .
     3315     if not available ub.price-doc then do:
     3316       message
     3317         vss-workfile vss-revision vss-description skip
     3318         "Ошибка задания входных параметров" skip
     3319         "Не найдена переоценка" skip
     3320         "Переоценка" p-doc-num skip
     3321         error-status :get-message(1)
     3322         view-as alert-box error .
     3323       undo, return error.
     3324     end.
     3325     if ub.price-doc.status_ <> 'акт':U
     3326     then do:
     3327       message
     3328         vss-workfile vss-revision vss-description skip
     3329         "Ошибка задания входных параметров" skip
     3330         "Переоценка не закрыта" skip
     3331         "Данная процедура может перерассчитывать только закрытые переоценки" skip
     3332         "Переоценка" p-doc-num skip
     3333         error-status :get-message(1)
     3334         view-as alert-box error .
     3335       undo, return error.
     3336     end.
     3337   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cutd-obj in g#library
     3338     (input  ub.price-doc.obj-type
     3339     ,input  ub.price-doc.obj-code
     3340     ,output varcut-status
     3341     ,output varcut-date
     3342     ,output varcut-fin-date
     3343     ) no-error .
     3344   if error-status:error then do:
     3345       message
     3346         vss-workfile vss-revision vss-description skip
     3347         substitute ("Ошибка при определении состояния объекта по обрезанию данных &1 &2.", return-value , error-status :get-message(1) )
     3348         view-as alert-box error .
     3349       undo, return error.
     3350   end.
     3351     case varcut-status:
     3352     when 1 then do:
     3353     end.
     3354     when 2 then do:
     3355     end.
     3356     when 3 then do:
     3357       if varcut-date > ub.price-doc.fact-date then do:
     3358          message
     3359           vss-workfile vss-revision vss-description skip
     3360           substitute ("В главной базе данных проводилось обрезание по объекту &1 &2. База данных этого объекта не была выгружена. Продолжать невозможно.", ub.price-doc.obj-type, ub.price-doc.obj-code)
     3361           view-as alert-box error .
     3362           undo, return error.
     3363       end.
     3364     end.
     3365     when 4 then do:
     3366     end.
     3367     otherwise do:
     3368         message
     3369           vss-workfile vss-revision vss-description skip
     3370           substitute ("Неверный статус объекта &1 получен от программы cutd-obj.", varcut-status)
     3371           view-as alert-box error
     3372           .
     3373           undo, return error.
     3374     end.
     3375     end case.
     3376     view frame a.
     3377       display
     3378       ub.price-doc.doc-num
     3379       ub.price-doc.status_
     3380       with frame a.
     3381     assign
     3382       current-action = "Проверка шапки."
     3383     .
     3384     run show-action (current-action) .
     3385     run str/c-pr-crt.p
     3386       (input  ub.price-doc.doc-num
     3387       ,output p-ship-num
     3388       ) no-error .
     3389     if error-status :error then do:
     3390       message
     3391         vss-workfile vss-revision vss-description skip
     3392         "Невозможно записать в архив" skip
     3393         "Переоценка" ub.price-doc.doc-num skip
     3394         "Щепка" p-ship-num skip
     3395         error-status :error skip
     3396         error-status :get-message(1) skip
     3397         return-value skip
     3398         view-as alert-box error .
     3399       undo, return error .
     3400     end.
     3401     assign
     3402       current-action = "Проверка строк."
     3403     .
     3404     run show-action (current-action) .
     3405     assign
     3406       loc-qnty = 0
     3407     .
     3408     for each ub.price-list exclusive-lock
     3409       where ub.price-list.doc-num = ub.price-doc.doc-num
     3410         and ub.price-list.main-price = true
     3411     on error undo main-block, return error
     3412     :
     3413       run process-line in this-procedure no-error .
     3414       if error-status :error then do:
     3415         message
     3416           vss-workfile vss-revision vss-description skip
     3417           "Ошибка при обработке товара" skip
     3418           "ПЕРЕОЦЕНКА" ub.price-doc.doc-num skip
     3419           "Артикул" ub.price-list.artic ub.price-list.prod-type ub.price-list.prod-code skip
     3420           error-status :get-message(1) skip
     3421           return-value skip
     3422           view-as alert-box error .
     3423         undo main-block, return error .
     3424       end.
     3425       assign
     3426         loc-qnty = loc-qnty + determined(ub.price-list.doc-qnty)
     3427       .
     3428     end.
     3429     assign
     3430       current-action = "Пересчет шапки."
     3431     .
     3432     run show-action (current-action).
     3433   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3434   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     3435     (input  ub.price-doc.obj-type
     3436     ,input  ub.price-doc.obj-code
     3437     ,output ub.price-doc.corr-date
     3438     ) no-error .
     3439   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3440   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     3441     (input  ub.price-doc.obj-type
     3442     ,input  ub.price-doc.obj-code
     3443     ,output ub.price-doc.corr-shift-date
     3444     ,output ub.price-doc.corr-shift-num
     3445     ,output ub.price-doc.corr-shift-name
     3446     ) no-error .
     3447     assign
     3448       ub.price-doc.corr-doc-code     = p-corr-doc-code
     3449       ub.price-doc.corr-man          = g#userid
     3450       ub.price-doc.rest-sale         = ub.price-doc.rest-sale * loc-qnty / ub.price-doc.rest-qnty
     3451       ub.price-doc.rest-base         = ub.price-doc.rest-base * loc-qnty / ub.price-doc.rest-qnty
     3452       ub.price-doc.sale-base         = ub.price-doc.sale-base * loc-qnty / ub.price-doc.rest-qnty
     3453       ub.price-doc.rest-last         = ub.price-doc.rest-last * loc-qnty / ub.price-doc.rest-qnty
     3454       ub.price-doc.rest-qnty         = loc-qnty
     3455     .
     3456   end.
     3457   procedure show-action :
     3458     do
     3459     on error undo, return error
     3460     :
     3461       define input parameter p-action as character no-undo .
     3462       define variable v-today as date      no-undo.
     3463       define variable v-time  as integer   no-undo.
     3464       run cur-time in this-procedure ( output v-today
     3465                                      , output v-time
     3466                                      ).
     3467       assign
     3468         current-time = string(v-time - start-time, "HH:MM:SS")
     3469         current-action = p-action
     3470       .
     3471       display
     3472         current-time current-action
     3473         with frame a.
     3474     end.
     3475   end procedure.
     3476   procedure process-line :
     3477     do
     3478     on error undo, return error substitute("  &1 &2" , error-status :get-message(1) , return-value )
     3479     on stop undo, return error substitute(" STOP &1 &2" , error-status :get-message(1) , return-value )
     3480     on end-key undo, return error substitute("END-KEY  &1 &2" , error-status :get-message(1) , return-value )
     3481     :
     3482       define variable v-today as date      no-undo.
     3483       define variable v-time  as integer   no-undo.
     3484       define variable    p-obj-type           like ub.gds-obj.obj-type  no-undo .
     3485       define variable    p-obj-code           like ub.gds-obj.obj-code  no-undo .
     3486       define variable    p-artic              like ub.gds-obj.artic     no-undo .
     3487       define variable    p-prod-type          like ub.gds-obj.prod-type no-undo .
     3488       define variable    p-prod-code          like ub.gds-obj.prod-code no-undo .
     3489       define variable    p-fact-order         as decimal   no-undo .
     3490       define variable    p-include-fact-order as logical   no-undo .
     3491       define buffer buf_parts for ub.parts  .
     3492       define variable v-total-qnty as decimal no-undo .
     3493       assign
     3494         v-total-qnty = 0
     3495       .
     3496       for each buf_parts exclusive-lock
     3497         where buf_parts.out-code  = ub.price-list.doc-num
     3498           and buf_parts.artic     = ub.price-list.artic
     3499           and buf_parts.prod-type = ub.price-list.prod-type
     3500           and buf_parts.prod-code = ub.price-list.prod-code
     3501           and buf_parts.obj-type  = ub.price-list.obj-type
     3502           and buf_parts.obj-code  = ub.price-list.obj-code
     3503       on error undo, return error
     3504       :
     3505         delete buf_parts .
     3506       end.
     3507       assign
     3508         p-obj-type           = ub.price-doc.obj-type
     3509         p-obj-code           = ub.price-doc.obj-code
     3510         p-artic              = ub.price-list.artic
     3511         p-prod-type          = ub.price-list.prod-type
     3512         p-prod-code          = ub.price-list.prod-code
     3513         p-fact-order         = ub.price-doc.fact-order
     3514         p-include-fact-order = false
     3515       .
     3516       run partslib-clear-temp-parts in this-procedure .
     3517       run prdoclib-clear-temp-prt-obj in this-procedure .
     3518       run partslib-init-temp-parts-by-factord in this-procedure
     3519         (input  p-obj-type
     3520         ,input  p-obj-code
     3521         ,input  p-artic
     3522         ,input  p-prod-type
     3523         ,input  p-prod-code
     3524         ,input  p-fact-order
     3525         ,input  p-include-fact-order
     3526         ) .
     3527       run prdoclib-init-prt-obj-by-factord in this-procedure
     3528         (input  p-obj-type
     3529         ,input  p-obj-code
     3530         ,input  p-artic
     3531         ,input  p-prod-type
     3532         ,input  p-prod-code
     3533         ,input  p-fact-order
     3534         ,input  p-include-fact-order
     3535         ) .
     3536       for each temp-parts
     3537       on error undo, return error return-value
     3538       :
     3539         create buf_parts .
     3540         buffer-copy temp-parts to buf_parts
     3541         assign
     3542           buf_parts.out-code  = ub.price-list.doc-num
     3543           buf_parts.status_   = true
     3544           buf_parts.rsrv-free = ?
     3545           buf_parts.doc-type  = 'акт':U
     3546           buf_parts.PS        = 'архив переоценки ' + ub.price-list.doc-num
     3547         .
     3548         assign
     3549           v-total-qnty = v-total-qnty + determined(buf_parts.fact-qnty)
     3550         .
     3551       end.
     3552         for each  prt-price-list exclusive-lock
     3553             where prt-price-list.doc-num   = ub.price-doc.doc-num
     3554               and prt-price-list.artic     = ub.price-list.artic
     3555               and prt-price-list.prod-code = ub.price-list.prod-code
     3556               and prt-price-list.prod-type = ub.price-list.prod-type
     3557               and prt-price-list.main-price = false
     3558               on error undo, return error
     3559               :
     3560               find first ub.bar-code  no-lock where ub.bar-code.b-code  = prt-price-list.b-code no-error .
     3561               if not available ub.bar-code  then next.
     3562               find first ub.goods     no-lock where ub.goods.gds-code  = ub.bar-code.gds-code no-error .
     3563               if not available ub.goods then next.
     3564               if ub.bar-code.unit-cli <> ub.goods.unit-base then do:
     3565                  if prt-price-list.doc-qnty <> 0 then prt-price-list.doc-qnty = ? .
     3566                  next.
     3567                end.
     3568               if ub.bar-code.in-code = ""  then do:
     3569                   find first temp-prt-obj no-lock where
     3570                             temp-prt-obj.prt-code = ub.bar-code.node-code
     3571                             no-error  .
     3572                     if available temp-prt-obj then do:
     3573                         assign
     3574                           prt-price-list.doc-qnty = determined(temp-prt-obj.fact-qnty)
     3575                           v-total-qnty            = v-total-qnty - determined(temp-prt-obj.fact-qnty)
     3576                         .
     3577                     end.
     3578               end.
     3579               else do:
     3580                  prt-price-list.doc-qnty = 0.
     3581                  for each temp-parts where
     3582                           temp-parts.in-code   = ub.bar-code.in-code and
     3583                           temp-parts.part-code = ub.bar-code.part-code and
     3584                           temp-parts.artic     = ub.goods.artic and
     3585                           temp-parts.prod-type = ub.goods.prod-type and
     3586                           temp-parts.prod-code = ub.goods.prod-code
     3587                  :
     3588                         assign
     3589                           prt-price-list.doc-qnty = determined(temp-parts.fact-qnty)
     3590                           v-total-qnty            = v-total-qnty - determined(temp-parts.fact-qnty)
     3591                         .
     3592                  end.
     3593               end.
     3594         end.
     3595         .
     3596       do transaction :
     3597       assign
     3598         ub.price-list.doc-qnty = v-total-qnty
     3599       .
     3600       end.
     3601       run partslib-clear-temp-parts in this-procedure .
     3602       run prdoclib-clear-temp-prt-obj in this-procedure .
     3603       assign
     3604         num_rec   = num_rec + 1
     3605       .
     3606       if num_rec mod 10 = 0
     3607       then do:
     3608         run cur-time in this-procedure ( output v-today
     3609                                       , output v-time ).
     3610         assign
     3611           current-time = string(v-time - start-time, "HH:MM:SS")
     3612         .
     3613         display
     3614           num_rec ub.price-list.artic  current-time current-action
     3615           with frame a.
     3616       end.
     3617     end.
     3618   end procedure .
