     1003     ,input  p-prod-code
     1004     ,buffer buf_gds-obj
     1005     ) no-error .
     1006           if error-status :error
     1007           then do:
     1008             message
     1009               vss-workfile vss-revision vss-description skip
     1010               vss-include-info4 skip
     1011               "Невозможно найти gds-obj" skip
     1012               error-status :get-message(1) skip
     1013               return-value skip
     1014               view-as alert-box error .
     1015             undo, return error .
     1016           end.
     1017           find current buf_gds-obj exclusive-lock .
     1018         end.
     1019       end.
     1020   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1021   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1022     (input  p-artic
