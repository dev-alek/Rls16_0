     1907   procedure prdoclib-clear-temp-prt-obj :
     1908     define buffer buf_temp-prt-obj for temp-prt-obj .
     1909     do
     1910     on error undo, return error return-value
     1911     :
     1912       for each buf_temp-prt-obj
     1913       on error undo, return error return-value
     1914       :
     1915         delete buf_temp-prt-obj .
     1916       end.
     1917     end.
     1918   end procedure.
     1919   procedure prdoclib-create-temp-prt-obj :
     1920     define input parameter  p-root-price-sale like ub.price-list.price-sale no-undo .
     1921     define parameter buffer buf_prt-obj       for ub.prt-obj .
     1922     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     1923     define buffer buf_gds-prt for ub.gds-prt .
     1924     do
     1925     on error undo, return error return-value
     1926     :
     1927       find first buf_temp-prt-obj
     1928         where buf_temp-prt-obj.prt-code = buf_prt-obj.prt-code
     1929         no-error .
     1930       if not available buf_temp-prt-obj
     1931       then do:
     1932         create buf_temp-prt-obj .
     1933         assign
     1934           buf_temp-prt-obj.prt-code         = buf_prt-obj.prt-code
     1935           buf_temp-prt-obj.price-sale       = ?
     1936           buf_temp-prt-obj.fact-qnty        = buf_prt-obj.fact-qnty
     1937           buf_temp-prt-obj.price-list-qnty  = ?
     1938           buf_temp-prt-obj.prt-obj-recid    = recid(buf_prt-obj)
     1939           buf_temp-prt-obj.price-list-recid = ?
     1940         .
     1941         find first buf_gds-prt no-lock
     1942           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     1943           .
     1944         assign
     1945           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     1946         .
     1947         if buf_temp-prt-obj.is-term
     1948         then do:
     1949           assign
     1950             buf_temp-prt-obj.price-sale = p-root-price-sale
     1951           .
     1952         end.
     1953       end.
     1954     end.
     1955   end procedure.
     1956   procedure prdoclib-temp-prt-obj-by-prt-root :
     1957     define input parameter  p-prt-code like ub.prt-obj.prt-code no-undo .
     1958     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     1959     define buffer buf_gds-prt for ub.gds-prt .
     1960     do
     1961     on error undo, return error return-value
     1962     :
     1963       find first buf_temp-prt-obj
     1964         where buf_temp-prt-obj.prt-code = p-prt-code
     1965         no-error .
     1966       if not available buf_temp-prt-obj
     1967       then do:
     1968         create buf_temp-prt-obj .
     1969         assign
     1970           buf_temp-prt-obj.prt-code         = p-prt-code
     1971           buf_temp-prt-obj.price-sale       = ?
     1972           buf_temp-prt-obj.fact-qnty        = 0
     1973           buf_temp-prt-obj.price-list-qnty  = ?
     1974           buf_temp-prt-obj.prt-obj-recid    = ?
     1975           buf_temp-prt-obj.price-list-recid = ?
     1976         .
     1977         find first buf_gds-prt no-lock
     1978           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     1979           .
     1980         assign
     1981           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     1982         .
     1983         if buf_temp-prt-obj.is-term
     1984         then do:
     1985           assign
     1986             buf_temp-prt-obj.price-sale = 0
     1987           .
     1988         end.
     1989       end.
     1990     end.
     1991   end procedure.
     1992   procedure prdoclib-init-temp-prt-obj :
     1993     define input parameter p-obj-type        like ub.prt-obj.obj-type  no-undo .
     1994     define input parameter p-obj-code        like ub.prt-obj.obj-code  no-undo .
     1995     define input parameter p-artic           like ub.prt-obj.artic     no-undo .
     1996     define input parameter p-prod-type       like ub.prt-obj.prod-type no-undo .
     1997     define input parameter p-prod-code       like ub.prt-obj.prod-code no-undo .
     1998     define input parameter p-root-price-sale like ub.prt-obj.price-sale no-undo .
     1999     define buffer buf_prt-obj      for ub.prt-obj .
     2000     define buffer buf_temp-prt-obj for temp-prt-obj .
     2001     do
     2002     on error undo, return error return-value
     2003     :
     2004       run prdoclib-clear-temp-prt-obj in this-procedure .
     2005       for each buf_prt-obj
     2006         where buf_prt-obj.obj-type  = p-obj-type
     2007           and buf_prt-obj.obj-code  = p-obj-code
     2008           and buf_prt-obj.artic     = p-artic
     2009           and buf_prt-obj.prod-type = p-prod-type
     2010           and buf_prt-obj.prod-code = p-prod-code
     2011       on error undo, return error return-value
     2012       :
     2013         run prdoclib-create-temp-prt-obj in this-procedure
     2014           (input  p-root-price-sale
     2015           ,buffer buf_prt-obj
     2016           ,buffer buf_temp-prt-obj
     2017           ).
     2018       end.
     2019     end.
     2020   end procedure.
