        1   define input        parameter p-mode   as character no-undo.
        2   define input-output parameter p-rec-id as recid     no-undo.
        3   define variable vss-revision    as character no-undo initial "$Revision$":U.
        4   define variable vss-author      as character no-undo initial "$Author$":U.
        5   define variable vss-date        as character no-undo initial "$Date$":U.
        6   define variable vss-workfile    as character no-undo initial "$Workfile$":U.
        7   define variable vss-archive     as character no-undo initial "$Archive$":U.
        8   define variable vss-description as character no-undo initial "Просмотр карточки истории изменения количества по строке документа из складского места":U.
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   define buffer buf_clients  for ub.clients.
      113   define buffer buf_object   for ub.clients.
      114   define buffer buf_goods    for ub.goods.
      115   define buffer buf_place    for ub.place.
      116   define button   Btn_Exit  label "Вы&ход"  size-chars 10.00 by 1.00 default auto-end-key.
      117   define button   Btn_OK    label "&Ввод "  size-chars 10.00 by 1.00 default auto-go.
      118   define button b-help label "Помо&щь" size-chars 10.00 by 1.00 default.
      119   define variable v-header as character no-undo initial " И Н Ф О Р М А Ц И Я   О   Т О В А Р Е ".
      120   define variable v-label  as character no-undo initial " К О Л И Ч Е С Т В Е Н Н Ы Е   Х А Р А К Т Е Р И С Т И К И ".
      121   define rectangle r-rect-0 edge-pixels 3 graphic-edge no-fill size-chars 98.25 by 1.50.
      122   define rectangle r-rect-1 edge-pixels 2 graphic-edge no-fill size-chars 98.25 by 4.50.
      123   define rectangle r-rect-2 edge-pixels 2 graphic-edge no-fill size-chars 98.25 by 2.25.
      124   define frame fr-D-trn-attr-8
      125     ub.c-doc-pl-pump.obj-type    at row  1.25 col 16.50 colon-aligned view-as combo-box inner-lines 5 list-items "":U, 'орг':U, 'чел':U, 'скл':U, 'маг':U size-chars    6.00 by 1.00    label "Объект"
      126     ub.c-doc-pl-pump.obj-code    at row  1.25 col 25.00          view-as fill-in size-chars 10.50 by 1.00 no-label
      127     buf_object.obj-name  at row  1.25 col 36.00          view-as fill-in size-chars 63.50 by 1.00 no-label                   format "x(80)":U  fgcolor  4
      128     ub.c-doc-pl-pump.pl-code     at row  2.50 col 16.50 colon-aligned view-as fill-in size-chars 17.50 by 1.00    label "Складское место"
      129     buf_place.pl-name    at row  2.50 col 36.00          view-as fill-in size-chars 63.50 by 1.00 no-label                   format "x(80)":U  fgcolor  4
      130     ub.c-doc-pl-pump.pump-code   at row  3.75 col 16.50 colon-aligned view-as fill-in size-chars  3.50 by 1.00    label "ТРК"             format ">9":U
      131     ub.c-doc-pl-pump.out-code    at row  3.75 col 60.50 colon-aligned view-as fill-in size-chars 17.50 by 1.00    label "Документ"        format "x(16)":U  fgcolor  4
      132     r-rect-1             at row  5.50 col  1.50
      133     v-header             at row  5.00 col 29.00          view-as fill-in size-chars 40.25 by 1.00 no-label                   format "x(40)":U  fgcolor 15 bgcolor 3
      134     ub.c-doc-pl-pump.gds-code    at row  6.00 col 16.50 colon-aligned view-as fill-in size-chars 10.50 by 1.00    label "Код"
      135     buf_goods.artic      at row  7.25 col 16.50 colon-aligned view-as fill-in size-chars 17.50 by 1.00    label "Артикул"         format "x(16)":U
      136     buf_goods.gds-name   at row  7.25 col 36.00          view-as fill-in size-chars 63.50 by 1.00 no-label                   format "x(80)":U  fgcolor  4
      137     buf_goods.prod-type  at row  8.50 col 16.50 colon-aligned view-as combo-box inner-lines 5 list-items "":U, 'орг':U, 'чел':U, 'скл':U, 'маг':U size-chars    6.00 by 1.00    label "Производитель"
      138     buf_goods.prod-code  at row  8.50 col 25.00          view-as fill-in size-chars 10.50 by 1.00 no-label
      139     buf_clients.obj-name at row  8.50 col 36.00          view-as fill-in size-chars 63.50 by 1.00 no-label                   format "x(80)":U  fgcolor  4
      140     r-rect-2             at row 10.75 col  1.50
      141     v-label              at row 10.25 col 19.00          view-as fill-in size-chars 60.25 by 1.00 no-label                   format "x(60)":U  fgcolor 15 bgcolor 3
      142     buf_goods.unit-base  at row 11.50 col  2.50          view-as fill-in size-chars  4.00 by 1.00 no-label                   format "x(3)":U   fgcolor  4
      143     ub.c-doc-pl-pump.doc-qnty    at row 11.50 col 16.50 colon-aligned view-as fill-in size-chars 25.50 by 1.00    label "Заявлено"        format "->>>,>>>,>>>,>>>,>>9.999":U    fgcolor 12
      144     ub.c-doc-pl-pump.fact-qnty   at row 11.50 col 60.50 colon-aligned view-as fill-in size-chars 25.50 by 1.00    label "Фактически"      format "->>>,>>>,>>>,>>>,>>9.999":U    fgcolor 12
      145     r-rect-0             at row 13.25 col  1.50
      146       Btn_Exit           at row 13.50 col  2.50
      147       Btn_OK             at row 13.50 col 78.00
      148     b-help          at row 13.50 col 88.75
      149   with view-as dialog-box side-labels no-underline three-d scrollable
      150        title "":U default-button Btn_Exit cancel-button Btn_Exit.
      151   assign frame fr-D-trn-attr-8 :scrollable = no.
      152   on choose of Btn_OK in frame fr-D-trn-attr-8 do:
      153   define variable vss-include-info0 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      154   if lookup(self :type
      155            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      156            ) = 0
      157   then do:
      158     message
      159       "$Workfile$"
      160       "Указанному интерфейсному элементу фокус не может быть передан" skip
      161       "Интерфейсный элемент" self :name  skip
      162       "Тип" self :type  skip
      163       "Процедура" this-procedure :file-name skip
      164       view-as alert-box .
      165   end.
      166   else do:
      167     apply "entry":u to self  .
      168     if focus :handle <> self :handle  then do:
      169       return no-apply .
      170     end.
      171   end.
      172     apply "GO":U to frame fr-D-trn-attr-8.
      173   end.
      174   on choose of Btn_Exit in frame fr-D-trn-attr-8 do:
      175   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      176   if lookup(self :type
      177            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      178            ) = 0
      179   then do:
      180     message
      181       "$Workfile$"
      182       "Указанному интерфейсному элементу фокус не может быть передан" skip
      183       "Интерфейсный элемент" self :name  skip
      184       "Тип" self :type  skip
      185       "Процедура" this-procedure :file-name skip
      186       view-as alert-box .
      187   end.
      188   else do:
      189     apply "entry":u to self  .
      190     if focus :handle <> self :handle  then do:
      191       return no-apply .
      192     end.
      193   end.
      194   end.
      195   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      196   on F1 of frame fr-D-trn-attr-8 anywhere do:
      197     if b-help :sensitive then DO: apply "CHOOSE":U to b-help in frame fr-D-trn-attr-8. END.
      198     return no-apply.
      199   end.
      200   if valid-handle( active-window ) and frame fr-D-trn-attr-8 :parent = ? then frame fr-D-trn-attr-8 :parent = active-window.
      201   if current-window :window-state = window-minimized then do: current-window :window-state = window-normal. end.
      202   on window-close of frame fr-D-trn-attr-8 do: apply "END-ERROR":U to self. end.
      203   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      204   on help of frame fr-D-trn-attr-8
      205   do:
      206     run gbl/app_help.p
      207       (input this-procedure :file-name
      208       ,input ''
      209       ,input ?
      210       ) no-error.
      211     if error-status :error then do:
      212       message
      213         "Ошибка при вызове помощи"
      214         error-status :get-message(1)
      215         view-as alert-box .
      216     end.
      217   end.
      218   run minbtn-set in this-procedure .
      219   on choose of b-help in frame fr-D-trn-attr-8
      220   do:
      221     apply "help":u to frame fr-D-trn-attr-8 .
      222   end.
      223   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      224   procedure minbtn-set :
      225       do
      226           on error undo, return error return-value
      227           :
      228           define variable ii              as integer       no-undo .
      229           define variable fh              as widget-handle no-undo .
      230           define variable hh              as widget-handle no-undo .
      231           define variable v-h             as handle        extent 4 no-undo .
      232           define variable v-name-button   as character     no-undo .
      233           define variable v-help-old-x    as decimal       no-undo .
      234           define variable v-help-old-y    as decimal       no-undo .
      235           define variable v-help-old-size as decimal       no-undo .
      236           define variable v-frame-width   as decimal       no-undo .
      237           define variable jj              as integer       no-undo .
      238           do
      239               on error undo, return error
      240               :
      241               assign
      242                   v-frame-width = frame fr-D-trn-attr-8:width - 0.3
      243                   fh            = frame fr-D-trn-attr-8:first-child
      244                   hh            = fh:first-child
      245                   ii            = 1
      246                   .
      247               do while valid-handle(hh):
      248                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      249                   do:
      250                       case lc(hh:name) :
      251                           when "b-help" then
      252                               do:
      253                                   hh:load-image-up("cmp/b-help.bmp":u) .
      254                                   hh:load-image-down("cmp/b-help.bmp":u) .
      255                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      256                                   hh:TOOLTIP = "Помощь" .
      257                                   v-help-old-x = hh:column .
      258                                   v-help-old-y = hh:row    .
      259                                   v-help-old-size = hh:width .
      260                                   hh:width-chars = 2.5 .
      261                               end.
      262                           when "b-print" then
      263                               do:
      264                                   hh:load-image("cmp/b-print.bmp":u) .
      265                                   hh:TOOLTIP = "Печать" .
      266                                   v-h[ii] = hh:handle .
      267                                   ii = ii + 1 .
      268                                   hh:width-chars = 3 .
      269                               end.
      270                           when "b-history" or
      271                           when "b-hist" then
      272                               do:
      273                                   hh:load-image("cmp/b-hist.bmp":u) .
      274                                   hh:TOOLTIP = "История" .
      275                                   v-h[ii] = hh:handle .
      276                                   ii = ii + 1 .
      277                                   hh:width-chars = 3 .
      278                               end.
      279                           when "b-sch" then
      280                               do:
      281                                   hh:load-image("cmp/b-sch.bmp":u) .
      282                                   hh:TOOLTIP = "Установка Фильтра" .
      283                                   v-h[ii] = hh:handle .
      284                                   ii = ii + 1 .
      285                                   hh:width-chars = 3 .
      286                               end.
      287                           when "b-hist-user" then
      288                               do:
      289                                   hh:load-image("cmp/b-hist.bmp":u) .
      290                                   hh:TOOLTIP = "История пользователя" .
      291                                   ii = ii + 1 .
      292                               end.
      293                       end case.
      294                   end.
      295                   hh = hh:next-sibling.
      296               end.
      297               b-help:column = v-frame-width - b-help:width-chars.
      298               jj = 0.
      299               repeat ii = 4 to 1 by -1 :
      300                   if valid-handle (v-h[ii] ) then
      301                   do:
      302                       jj  = jj + 1 .
      303                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      304                       v-h[ii]:row    = v-help-old-y .
      305                   end.
      306               end.
      307           end.
      308       end.
      309   end procedure.
      310   Main-Block:
      311   do on error   undo Main-Block, leave Main-Block
      312      on end-key undo Main-Block, leave Main-Block :
      313     if p-mode <> 'ПРОСМОТР':U then do:
      314       message vss-workfile skip vss-revision skip vss-date skip( 1 ) vss-description skip( 1 )
      315               "Неверное значение параметра вызова p-mode:" p-mode
      316       view-as alert-box error.
      317       undo Main-Block, return error.
      318     end.
      319     find ub.c-doc-pl-pump no-lock where recid( ub.c-doc-pl-pump ) = p-rec-id no-error.
      320     if not available ub.c-doc-pl-pump then do:
      321       message
      322         "Карточка истории изменения количества по строке документа по складскому месту и ТРК не найдена."
      323       view-as alert-box error.
      324       undo Main-Block, leave Main-Block.
      325     end.
      326     assign frame fr-D-trn-attr-8 :title =
      327        substitute( 'Карточка изменения количества (товар &1) по документу "&2" (складское место &3, ТРК &4) -- &5',
      328                    ub.c-doc-pl-pump.gds-code, ub.c-doc-pl-pump.out-code, ub.c-doc-pl-pump.pl-code, ub.c-doc-pl-pump.pump-code, p-mode ).
      329     display ub.c-doc-pl-pump.obj-type
      330             ub.c-doc-pl-pump.obj-code
      331             ub.c-doc-pl-pump.pl-code
      332             ub.c-doc-pl-pump.pump-code
      333             ub.c-doc-pl-pump.out-code
      334             ub.c-doc-pl-pump.gds-code
      335             ub.c-doc-pl-pump.doc-qnty
      336             ub.c-doc-pl-pump.fact-qnty
      337             v-label
      338             v-header
      339     with frame fr-D-trn-attr-8.
      340     find first buf_object no-lock where
      341                buf_object.obj-type = ub.c-doc-pl-pump.obj-type and
      342                buf_object.obj-code = ub.c-doc-pl-pump.obj-code no-error.
      343     if available buf_object then do: display buf_object.obj-name with frame fr-D-trn-attr-8. end.
      344     find first buf_goods no-lock where
      345                buf_goods.gds-code = ub.c-doc-pl-pump.gds-code no-error.
      346     if available buf_goods then do:
      347       display buf_goods.artic
      348               buf_goods.prod-type
      349               buf_goods.prod-code
      350               buf_goods.gds-name
      351               buf_goods.unit-base
      352       with frame fr-D-trn-attr-8.
      353       find first buf_clients no-lock where
      354                  buf_clients.obj-type = buf_goods.prod-type and
      355                  buf_clients.obj-code = buf_goods.prod-code no-error.
      356       if available buf_clients then do: display buf_clients.obj-name with frame fr-D-trn-attr-8. end.
      357     end.
      358     find first buf_place no-lock where
      359                buf_place.obj-type = ub.c-doc-pl-pump.obj-type and
      360                buf_place.obj-code = ub.c-doc-pl-pump.obj-code and
      361                buf_place.pl-code  = ub.c-doc-pl-pump.pl-code  no-error.
      362     if available buf_place then do: display buf_place.pl-name with frame fr-D-trn-attr-8. end.
      363     enable Btn_Exit b-help with frame fr-D-trn-attr-8.
      364     if p-mode = 'ПРОСМОТР':U then do: hide Btn_OK in frame fr-D-trn-attr-8. end.
      365     wait-for go of frame fr-D-trn-attr-8.
      366   end.
      367   hide frame fr-D-trn-attr-8 no-pause.
