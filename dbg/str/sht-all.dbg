     2149   if p-rid-list <> '':U
     2150   and p-rid-list <> ? then do:
     2151     assign
     2152     v-doc-rec = integer(entry(1, p-rid-list))
     2153     p-rid-list = '':U
     2154     no-error .
     2155   end.
