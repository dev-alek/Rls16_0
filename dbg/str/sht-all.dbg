     2160   RUN disable_UI.
     2161   PROCEDURE change-planned-shift :
     2162   define input parameter p-shift-date like ub.shift-obj.shift-date no-undo .
     2163   define input parameter p-shift-num  like ub.shift-obj.shift-num  no-undo .
     2164   define input parameter p-shift-name like ub.shift-obj.shift-name no-undo .
     2165   define input parameter p-rec AS RECID NO-UNDO .
     2166   DEFINE VARIABLE v-loc-doc-rec AS RECID NO-UNDO.
     2167     do
     2168     on error undo, return error
     2169     :
     2170       define buffer buf_shift-obj     for ub.shift-obj.
     2171       assign
     2172         s-date = p-shift-date
     2173         s-num  = p-shift-num
     2174         s-name = p-shift-name
     2175       .
     2176       run gbl/shift.w
     2177         ( input parparentproc
     2178          ,input p-curr-obj-type
     2179          ,input p-curr-obj-code
     2180          ,input-output s-date
     2181          ,input-output e-date
     2182          ,input-output s-time
     2183          ,input-output e-time
     2184          ,input-output s-num
     2185          ,input-output s-name
     2186          ,input "no-time"
     2187          ,output v-cancel
     2188         ) no-error.
     2189       if error-status:error
     2190         or v-cancel = yes
     2191       then do:
     2192         if v-cancel = yes then do:
     2193           undo, return.
     2194         end.
     2195         else do:
     2196           undo, return error "change-planned-shift: Ошибка получения данных для изменения смены." + chr(10) + return-value.
     2197         end.
     2198       end.
     2199       if s-name <> p-shift-name then do:
     2200        run gbl/shtwaicr.p ( INPUT 'ИЗМЕНЕНИЕ':U
     2201                           ,INPUT NO
     2202                           ,INPUT-OUTPUT p-rec
     2203                           ,INPUT p-curr-obj-type
     2204                           ,INPUT p-curr-obj-code
     2205                           ,INPUT p-shift-date
     2206                           ,INPUT p-shift-num
     2207                           ,INPUT s-name) NO-ERROR.
     2208           IF NOT ERROR-STATUS:ERROR
     2209           AND p-rec  <> ? THEN DO:
     2210              v-doc-rec = p-rec.
     2211              run UI-on IN THIS-PROCEDURE NO-ERROR.
     2212           END.
     2213         end.
     2214     end.
     2215   END PROCEDURE.
     2216   procedure change-close-shift-time:
     2217   define input parameter p-rec as recid no-undo.
     2218   define buffer bf_shift-obj for ub.shift-obj.
     2219   find first bf_shift-obj no-lock where recid(bf_shift-obj) = p-rec.
     2220   assign
     2221       s-date = bf_shift-obj.shift-date
     2222       e-date = bf_shift-obj.close-date
     2223       s-time = bf_shift-obj.open-time
     2224       e-time = bf_shift-obj.close-time
     2225       s-num = bf_shift-obj.shift-num
     2226       s-name = bf_shift-obj.shift-name
     2227   .
     2228   run gbl/shift.w
     2229     ( input parparentproc
     2230      ,input p-curr-obj-type
     2231      ,input p-curr-obj-code
     2232      ,input-output s-date
     2233      ,input-output e-date
     2234      ,input-output s-time
     2235      ,input-output e-time
     2236      ,input-output s-num
     2237      ,input-output s-name
     2238      ,input "edit-time"
     2239      ,output v-cancel
     2240     ) no-error.
     2241     if error-status:error
     2242       or v-cancel = yes
     2243     then do:
     2244       if v-cancel = yes then do:
     2245         undo, return.
     2246       end.
     2247       else do:
     2248         undo, return error "change-closed-shift: Ошибка получения данных для изменения смены." + chr(10) + return-value + chr(10) + error-status:get-message (1).
     2249       end.
     2250     end.
     2251   run gbl/sht-set-time.p(
     2252       bf_shift-obj.shift-date,
     2253       bf_shift-obj.shift-num,
     2254       bf_shift-obj.obj-type,
     2255       bf_shift-obj.obj-code,
     2256       e-time,
     2257       s-time
     2258   ) no-error.
     2259   if error-status:error then
     2260       undo, return error "change-closed-shift: Ошибка при изменение времени смены" + chr(10) + return-value + chr(10) + error-status:get-message (1).
     2261   run UI-on IN THIS-PROCEDURE NO-ERROR.
     2262   end procedure.
     2263   PROCEDURE disable_UI :
     2264     HIDE FRAME d-shifts.
     2265   END PROCEDURE.
     2266   PROCEDURE enable_UI :
     2267     ENABLE b-quit B-sel b-add b-chg b-del B-staff B-rep B-param B-hist b-help
     2268            b-mark br-shift
     2269         WITH FRAME d-shifts.
     2270     VIEW FRAME d-shifts.
     2271     OPEN QUERY br-shift FOR EACH X_shift-obj       WHERE X_shift-obj.obj-type = p-obj-type and X_shift-obj.obj-code = p-obj-code NO-LOCK.
     2272   END PROCEDURE.
     2273   PROCEDURE OpenBr :
     2274   run waitfram-show in this-procedure ("Заполняется список. ЖДИТЕ...").
     2275   case sht-mode :
     2276     when "all" then do:
     2277       ENABLE b-staff
     2278       WITH FRAME d-shifts.
     2279       frame d-shifts :title = "Все смены системы".
     2280       OPEN QUERY br-shift
     2281         FOR EACH X_shift-obj NO-LOCK
     2282             by X_shift-obj.shift-date descending
     2283             by X_shift-obj.shift-num descending.
     2284     end.
     2285     when "host" then do:
     2286     end.
     2287     when "obj" then do:
     2288   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2289   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2290     (input  p-obj-type
     2291     ,input  p-obj-code
     2292     ,output v-host-code
     2293     )  .
     2294   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2295   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2296     (input  p-obj-type
     2297     ,input  p-obj-code
     2298     ,output obj-db-num
     2299     )  .
     2300       if is-super then
     2301         ENABLE
     2302         b-add when ((v-curr-db-num = obj-db-num) AND lookup("b-add":U, bttns) > 0)
     2303         b-chg when ((v-curr-db-num = obj-db-num) AND lookup("b-add":U, bttns) > 0)
     2304         b-del when ((v-curr-db-num = obj-db-num) AND lookup("b-add":U, bttns) > 0)
     2305         b-staff
     2306         B-sel when lookup("b-sel":U, bttns) > 0
     2307         WITH FRAME d-shifts.
     2308       else
     2309       ENABLE
     2310       b-staff WITH FRAME d-shifts.
     2311       frame d-shifts :title = substitute("Смены по объекту: &1&2"
     2312                                               , p-obj-type
     2313                                               ,p-obj-code).
     2314       OPEN QUERY br-shift
     2315         FOR EACH X_shift-obj WHERE
     2316                 X_shift-obj.obj-type = p-obj-type and
     2317                 X_shift-obj.obj-code = p-obj-code NO-LOCK
     2318             by X_shift-obj.shift-date descending
     2319             by X_shift-obj.shift-num descending.
     2320     end.
     2321   end case.
     2322   if v-doc-rec <> ? then reposition br-shift to recid v-doc-rec No-ERROR.
     2323   run waitfram-hide in this-procedure .
     2324   END PROCEDURE.
     2325   PROCEDURE proc-b-add :
     2326   DEFINE buffer buf_shift-obj for ub.shift-obj.
     2327   DEFINE VARIABLE v-loc-doc-rec AS RECID NO-UNDO.
     2328   assign
     2329     s-date = ?
     2330     s-time = ?
     2331     s-num  = ?
     2332     s-name = ?.
     2333   run gbl/shift.w (  input parparentproc
     2334                , input p-curr-obj-type
     2335                , input p-curr-obj-code
     2336                , input-output s-date
     2337                , input-output e-date
     2338                , input-output s-time
     2339                , input-output e-time
     2340                , input-output s-num
     2341                , input-output s-name
     2342                , input "no-time"
     2343                , output v-cancel
     2344               ) no-error.
     2345   if error-status:error
     2346   then do:
     2347       message
     2348         vss-workfile vss-revision vss-description
     2349         skip "Ошибка добавления смены."
     2350         skip return-value
     2351         skip trim(error-status :get-message(1))
     2352              trim(error-status :get-message(2))
     2353              trim(error-status :get-message(3))
     2354              trim(error-status :get-message(4))
     2355              trim(error-status :get-message(5))
     2356       view-as alert-box error.
     2357       undo, return no-apply .
     2358   end.
     2359   if v-cancel = yes
     2360   then do:
     2361       undo, return.
     2362   end.
     2363   run gbl/shtwaicr.p ( INPUT 'ДОБАВЛЕНИЕ':U
     2364                       ,INPUT NO
     2365                       ,INPUT-OUTPUT v-loc-doc-rec
     2366                       ,INPUT p-curr-obj-type
     2367                       ,INPUT p-curr-obj-code
     2368                       ,INPUT s-date
     2369                       ,INPUT s-num
     2370                       ,INPUT s-name) NO-ERROR.
     2371   IF NOT ERROR-STATUS:ERROR
     2372   AND v-loc-doc-rec  <> ? THEN DO:
     2373      v-doc-rec = v-loc-doc-rec.
     2374      run UI-on IN THIS-PROCEDURE NO-ERROR.
     2375   END.
     2376   END PROCEDURE.
     2377   PROCEDURE proc-b-rep :
     2378   DEFINE INPUT-OUTPUT PARAMETER prep-name as character no-undo.
     2379   DEFINE variable mypar as CHARACTER no-undo.
     2380   define variable check-html as character no-undo .
     2381   define buffer t-shift-obj for ub.shift-obj.
     2382   IF NOT AVAIL X_shift-obj then do:
     2383       bell.
     2384       prep-name = "".
     2385       return.
     2386   end.
     2387     case prep-name:
     2388       WHEN "g-shift":U
     2389       or
     2390       when "g-ptrlch":U
     2391       or
     2392       when "g-shiftClose":U
     2393       or
     2394       when "g-zmzvit"
     2395       then do:
     2396           IF sht-mode <> "obj" then do:
     2397               message
     2398               "Отчет можно сделать только находясь в списке смен по текущему объекту"
     2399               view-as alert-box ERROR.
     2400               prep-name = "".
     2401               return.
     2402           end.
     2403           FIND FIRST t-shift-obj No-LOCK WHERE
     2404                      recid(t-shift-obj) = recid(X_shift-obj) No-ERROR.
     2405           IF NOT AVAIL t-shift-obj then do:
     2406               message
     2407               substitute("Не найдена смена:&1" +
     2408                          "объект &2&3 смена от &4 номер &5 порядок &6"
     2409                          , chr(10)
     2410                          ,X_shift-obj.obj-type
     2411                          ,X_shift-obj.obj-code
     2412                          ,string(X_shift-obj.shift-date, "99/99/9999")
     2413                          ,X_shift-obj.shift-name
     2414                          ,X_shift-obj.shift-num)
     2415               view-as alert-box ERROR.
     2416               prep-name = "".
     2417               return.
     2418           end.
     2419           if prep-name = "g-shiftClose"
     2420           and t-shift-obj.status_ <>  'зкр':U then do:
     2421               Message
     2422               SUBSTITUTE("На объекте &1&2 смена № &3 порядок &4 от &5&6еще не закрыта&6Чек-лист не сформирован!"
     2423                          ,t-shift-obj.obj-type
     2424                          ,t-shift-obj.obj-code
     2425                          ,t-shift-obj.shift-name
     2426                          ,t-shift-obj.shift-num
     2427                          ,string(t-shift-obj.shift-date,"99/99/9999")
     2428                          ,chr(10)
     2429                          )
     2430               prep-name = "".
     2431               return.
     2432           end.
     2433           if   ( prep-name = "g-shift"
     2434           or   prep-name = "g-zmzvit" )
     2435           and t-shift-obj.status_ <>  'зкр':U then do:
     2436               Message
     2437               SUBSTITUTE("На объекте &1&2 смена № &3 порядок &4 от &5&6еще не закрыта&6Сменный отчет сделать нельзя!"
     2438                          ,t-shift-obj.obj-type
     2439                          ,t-shift-obj.obj-code
     2440                          ,t-shift-obj.shift-name
     2441                          ,t-shift-obj.shift-num
     2442                          ,string(t-shift-obj.shift-date,"99/99/9999")
     2443                          ,chr(10)
     2444                          )
     2445               prep-name = "".
     2446               return.
     2447           end.
     2448           mypar =
     2449               "X-DATE-START = " + string(X_shift-obj.shift-date, "99/99/9999") + chr(44) +
     2450               "X-SHIFT-START = " + string(X_shift-obj.shift-num) + chr(44) +
     2451               "X-OBJ-CODE = " + string(X_shift-obj.obj-code) + chr(44) +
     2452               "X-OBJ-TYPE = " + string(X_shift-obj.obj-type) .
     2453          if prep-name = "g-shift"
     2454          then do:
     2455             run rep/g-new-shift.p
     2456               (input parparentproc
     2457               ,input mypar
     2458               ) .
     2459          end.
     2460         if prep-name = "g-shiftClose" then do:
     2461       define variable vRas as logical no-undo .
     2462       find first shift-param no-lock where shift-param.obj-code = t-shift-obj.obj-code and
     2463           shift-param.obj-type = t-shift-obj.obj-type and
     2464           shift-param.shift-date = t-shift-obj.shift-date and
     2465           shift-param.shift-name = t-shift-obj.shift-name and
     2466           shift-param.shift-num = t-shift-obj.shift-num and (shift-param.error-mass or
     2467           shift-param.error-paid-trans) no-error .
     2468           if available (shift-param) then vRas = true .
     2469             run rep/r-shiftClose.p
     2470               (input X_shift-obj.host-code
     2471               ,input mypar
     2472               ,input false
     2473               ,input vRas
     2474               ,input true
     2475               ,output check-html
     2476               ) .
     2477         end.
     2478          if prep-name = "g-ptrlch"
     2479          then do:
     2480           run rep/g-ptrlch.p
     2481             (input parparentproc
     2482             ,input mypar
     2483             ) .
     2484          end.
     2485          if prep-name = "g-zmzvit"
     2486          then do:
     2487            run rep/g-zmzvit.p
     2488              (input parparentproc
     2489              ) no-error .
     2490          end.
     2491       END.
     2492     end case.
     2493     prep-name = "".
     2494   END PROCEDURE.
     2495   PROCEDURE UI-on :
     2496   ASSIGN b-rep:POPUP-MENU IN FRAME d-shifts = MENU menu-b-rep:HANDLE.
     2497   ASSIGN b-rep:MENU-MOUSE = 1.
     2498   if parcall-point = "rep/e-shift.w":U
     2499   or parcall-point = "rep/r-ptrlch.p":U
     2500   or parcall-point = "e-zmzvit.w":U
     2501   then
     2502   assign
     2503   menu-item mi-petrol:sensitive  in menu menu-b-rep = no
     2504   menu-item mi-ptrlch:sensitive  in menu menu-b-rep = no
     2505   menu-item mi-closeShift:sensitive  in menu menu-b-rep = no
     2506   .
     2507   else do:
     2508      if lookup( v-sys-key, "Astral_UKR,Lila_UKR," + 'ExpertekIBS':U  ) > 0
     2509      then do:
     2510         define variable h_menu_item as handle no-undo.
     2511         create menu-item h_menu_item
     2512         assign
     2513            parent      = menu menu-b-rep:handle
     2514            label       = "Сменный отчет АЗС (Украина)"
     2515            sensitive   = TRUE
     2516            triggers :
     2517               ON choose PERSISTENT RUN smenUcr IN THIS-PROCEDURE.
     2518            end triggers.
     2519      end.
     2520   end.
     2521   ENABLE
     2522   b-quit
     2523   b-help
     2524   b-rep
     2525   br-shift
     2526   b-hist
     2527   b-param
     2528   B-sel when lookup("b-sel":U, bttns) > 0
     2529   WITH FRAME d-shifts.
     2530   VIEW FRAME d-shifts.
     2531   if lookup("b-mark":U, bttns) > 0
     2532   then do :
     2533     display b-mark WITH FRAME d-shifts.
     2534     enable b-mark WITH FRAME d-shifts.
     2535   end .
     2536   else do :
     2537     disable b-mark WITH FRAME d-shifts.
     2538     hide b-mark in FRAME d-shifts.
     2539   end .
     2540   RUN OpenBr IN THIS-PROCEDURE.
     2541   END PROCEDURE.
     2542   procedure smenUcr:
     2543      rep-name = "g-zmzvit":U.
     2544      run proc-b-rep in this-procedure ( input-output rep-name ) no-error .
     2545      if error-status :error then do: return no-apply. end.
     2546   end.
     2547   PROCEDURE local-mark :
     2548   if not available X_shift-obj then
     2549   do:
     2550       message "Неправильный выбор строки.".
     2551       return .
     2552   end.
     2553   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2554   define variable v-str-recid19 as character no-undo .
     2555   define variable v-num-entry19 as integer   no-undo .
     2556   assign
     2557     v-str-recid19 = trim( string( recid( X_shift-obj ) , "->>>>>>>>>>>9":U ) )
     2558     v-num-entry19 = lookup( v-str-recid19 , p-rid-list )
     2559   .
     2560   if v-num-entry19 > 0 then do:
     2561     assign
     2562       entry( v-num-entry19, p-rid-list ) = "":U
     2563       p-rid-list = trim( replace( p-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     2564     .
     2565   end.
     2566   else do:
     2567     assign
     2568       p-rid-list = p-rid-list + ( if p-rid-list = "":U then "":U else chr(44) ) + v-str-recid19
     2569     .
     2570   end.
     2571   br-shift:refresh() in frame d-shifts .
     2572   END PROCEDURE.
