        1   DEFINE BUFFER X_shift-obj FOR shift-obj.
        2   define input parameter parparentproc    as widget-handle no-undo .
        3   define input parameter p-curr-obj-type  like ub.clients.obj-type no-undo .
        4   define input parameter p-curr-obj-code  like ub.clients.obj-code no-undo .
        5   define input parameter bttns            as character no-undo.
        6   define input parameter sht-mode         as character no-undo.
        7   define input parameter p-obj-type  like ub.clients.obj-type no-undo .
        8   define input parameter p-obj-code  like ub.clients.obj-code no-undo .
        9   define input parameter parcall-point    as character no-undo .
       10   define input-output parameter p-rid-list        as character no-undo.
       11   define variable vss-revision    as character no-undo init "$Revision$":U .
       12   define variable vss-author      as character no-undo init "$Author$":U .
       13   define variable vss-date        as character no-undo init "$Date$":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       15   define variable vss-archive     as character no-undo init "$Archive$":U .
       16   define variable vss-description as character no-undo init "Список смен".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   procedure proc-alt-shift-f2:
       78     if not ibs.th.gbl.gbl-var:rcode
       79   then
       80     run gbl\inidebug.p .
       81   end.
       82   procedure proc-alt-shift-f3:
       83     run gbl/prvssinf.p
       84       ( input this-procedure
       85       ) .
       86   end.
       87   define variable v-inform-launched as logical no-undo initial false .
       88   procedure proc-alt-shift-f4:
       89     define variable v-action as character no-undo .
       90     if v-inform-launched = false then do:
       91       assign
       92         v-inform-launched = true
       93       .
       94       run gbl/d-inform.w
       95         (  input self
       96         ,  input this-procedure
       97         , output v-action
       98         ) no-error .
       99       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      100       assign
      101         v-inform-launched = false
      102       .
      103     end.
      104   end.
      105   procedure proc-alt-f1:
      106     run gbl/corrhelp.p
      107       (input this-procedure
      108       ) .
      109   end .
      110   on alt-shift-f2 anywhere do:
      111     run proc-alt-shift-f2.
      112   end.
      113   on alt-shift-f3 anywhere do:
      114     run proc-alt-shift-f3 in this-procedure .
      115   end.
      116   on alt-shift-f4 anywhere do:
      117     run proc-alt-shift-f4 in this-procedure.
      118   end.
      119   on alt-f1 anywhere do:
      120     run proc-alt-f1 in this-procedure .
      121   end.
      122   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123   define variable v-waitfram-action01         as character   no-undo .
      124   define variable v-waitfram-action02         as character   no-undo .
      125   define variable v-waitfram-action03         as character   no-undo .
      126   define variable mWaitFramTextBeg            as character   no-undo.
      127   define variable mWaitFramTextEnd            as character   no-undo.
      128   define variable mWaitFramView               as logical     no-undo.
      129   define variable mWaitProcEvent              as logical     no-undo init yes.
      130   define variable mWaitFramInterval           as integer     no-undo init 1 .
      131   define variable mWaitFramStop               as logical     no-undo.
      132   define variable mWaitFramStopUser           as logical     no-undo.
      133   define variable mWaitFramStopTimeOut        as logical     no-undo.
      134   define variable mWaitFramStartProc          as datetime-tz no-undo.
      135   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      136   define button B-WaitFramStop auto-end-key
      137        label "Стоп"
      138        size 10 by 1 tooltip "Остоновить процесс".
      139   define button B-viewProcInfo
      140        label "Информация"
      141        size 15 by 1 tooltip "Информация о процесс".
      142   define frame waitfram
      143     v-waitfram-action01 format "x(72)" no-label skip
      144     v-waitfram-action02 format "x(72)" no-label skip
      145     v-waitfram-action03 format "x(72)" no-label skip
      146     B-viewProcInfo
      147     B-WaitFramStop at row 4 col 30
      148     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      149     .
      150   define new global shared variable mBatchMode as logical no-undo init ?.
      151   define variable mFramBachModHandle as handle no-undo.
      152   mFramBachModHandle = frame waitfram:handle.
      153   define variable mFameOldVis as logical no-undo.
      154   define variable mVisCUrentVin as logical no-undo.
      155   if session:batch-mode
      156   then
      157      mBatchMode = yes.
      158   if mBatchMode = ? then do:
      159     mVisCUrentVin = current-window:visible.
      160     mFameOldVis = mFramBachModHandle:visible.
      161     mFramBachModHandle:visible  = yes.
      162     mBatchMode = mFramBachModHandle:visible ne yes.
      163     mFramBachModHandle:visible = mFameOldVis.
      164     current-window:visible = mVisCUrentVin.
      165   end.
      166    if  log-manager:logfile-name ne ?
      167     then DO:
      168         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      169         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      170         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      171     end.
      172   on choose of B-WaitFramStop in frame waitfram
      173   do:
      174     mWaitFramStop = yes.
      175     mWaitFramStopUser = yes.
      176   end.
      177   function waitfram-check-timeout returns logical():
      178      define variable vtime as int64 no-undo.
      179      if mWaitFramStopTimeOut
      180      then
      181         return yes.
      182      vtime = ( now - mWaitFramStartProc ) / 1000 .
      183      if     mWaitFramTimeOut ne ?
      184         and mWaitFramTimeOut ne 0
      185         and mWaitFramTimeOut lt vtime
      186      then do:
      187         mWaitFramStopTimeOut = yes.
      188      end.
      189      return mWaitFramStopTimeOut.
      190   end.
      191   procedure waitfram-hide :
      192     if not session:batch-mode
      193     then do
      194     on error undo, return error return-value
      195     :
      196       pause 0 before-hide .
      197       if not mBatchMode then
      198         hide frame waitfram .
      199     if     not mWaitFramView
      200        and mWaitProcEvent
      201     then
      202       process events .
      203     end.
      204   end procedure.
      205   procedure waitfram-show :
      206     define input  parameter p-message as character no-undo .
      207     define variable v-left-margin as integer   no-undo .
      208     if not session:batch-mode
      209     then do
      210     on error undo, return error return-value
      211     :
      212       if length(p-message) <= 70 then do:
      213         assign
      214           v-left-margin = integer((70 - length(p-message)) / 2)
      215         .
      216         assign
      217           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      218         .
      219         assign
      220           v-waitfram-action01 = " "
      221           v-waitfram-action02 = " "
      222                                    + fill(" ", v-left-margin)
      223                                    + p-message
      224           v-waitfram-action03 = " "
      225         .
      226       end.
      227       else do:
      228         define variable vRindex1 as integer no-undo.
      229         define variable vRindex2 as integer no-undo.
      230         vRindex1 = r-index(p-message," ",70).
      231         if vRindex1 = 0
      232         then
      233            vRindex1 = 70.
      234         if length(p-message)  <= vRindex1 + 70 then do:
      235           assign
      236             v-waitfram-action01 = " "
      237             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      238             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      239           .
      240         end.
      241         else do:
      242           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      243           if vRindex2 <= vRindex1
      244           then
      245              vRindex2 = vRindex1 + 70.
      246           assign
      247             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      248             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      249             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      250           .
      251         end.
      252       end.
      253       B-viewProcInfo:visible   in frame waitfram = no.
      254       B-viewProcInfo:sensitive in frame waitfram = no.
      255       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      256       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      257       if  (   mWaitFramView
      258          or  mWaitProcEvent)
      259          and not mBatchMode
      260       then
      261          display
      262             v-waitfram-action01 skip
      263             v-waitfram-action02 skip
      264             v-waitfram-action03 skip
      265          with frame waitfram .
      266       if     mWaitFramView
      267          then do:
      268             if     mWaitFramInterval ne ?
      269                and not mBatchMode
      270             then
      271                wait-for go of frame waitfram pause mWaitFramInterval.
      272          end.
      273          else
      274             if     mWaitProcEvent
      275                and not mBatchMode
      276             then
      277                process events .
      278     end.
      279   end procedure.
      280      procedure waitfram-show-this:
      281         define input  parameter iInterval as int64 no-undo.
      282         define variable vtime as int64 no-undo.
      283         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      284         mWaitFramInterval = iInterval.
      285         run waitfram-show (substitute("&1&2 &3&4" ,
      286                                       mWaitFramTextBeg ,
      287                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      288                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      289                                       mWaitFramTextEnd
      290                                      )
      291                           ).
      292      end.
      293      procedure WaitFramRunPause:
      294         define input  parameter iInterval as dec no-undo.
      295         define variable vStart  as datetime-tz no-undo.
      296         define variable vend    as datetime-tz no-undo.
      297         define variable vint as int64 no-undo.
      298         define variable vOk as logical no-undo.
      299         vStart = now.
      300         vend   = vStart.
      301         publish "WaitFramPause" (iInterval,output vOk).
      302         vend   =  now.
      303         vint = vend - vStart.
      304         vint = iInterval - vint / 1000.
      305         if     not mWaitFramStop
      306            and (   vint > 0
      307                 or (    not vOk
      308                     and iInterval eq ?
      309                     )
      310                 )
      311         then
      312            run waitfram-show-this (iInterval).
      313         vend   =  now.
      314         vint = vend - vStart.
      315         vint = iInterval - vint / 1000.
      316         if     not mWaitFramStop
      317            and vint > 0
      318         then do:
      319            run gbl/pause.p (vint * 1000).
      320         end.
      321         if iInterval ne ?
      322         then
      323            publish "WaitFramStop".
      324         waitfram-check-timeout().
      325      end.
      326      procedure WaitFramWaitFor:
      327         define input  parameter iInterval as dec no-undo.
      328         assign
      329            mWaitFramStartProc   = now
      330            mWaitFramStopUser    = no
      331            mWaitFramStopTimeOut = no
      332         .
      333         block-wait:
      334         do while not mWaitFramStop:
      335            run WaitFramRunPause (iInterval).
      336            if  waitfram-check-timeout()
      337            then do:
      338               leave block-wait.
      339            end.
      340         end.
      341         run waitfram-hide.
      342      end.
      343   procedure waitfram-join :
      344     define input  parameter p-line-1  as character no-undo .
      345     define input  parameter p-line-2  as character no-undo .
      346     define input  parameter p-line-3  as character no-undo .
      347     define output parameter p-message as character no-undo .
      348     do
      349     on error undo, return error return-value
      350     :
      351       assign
      352         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      353                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      354                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      355       .
      356     end.
      357   end procedure.
      358   function waitfram-join-function returns character
      359     (input p-line-1 as character
      360     ,input p-line-2 as character
      361     ,input p-line-3 as character
      362     ).
      363     define variable v-message as character no-undo .
      364     run waitfram-join in this-procedure
      365       (input  p-line-1
      366       ,input  p-line-2
      367       ,input  p-line-3
      368       ,output v-message
      369       ) .
      370     return v-message .
      371   end function .
      372   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      373     define variable v-cntxt-db-num        as integer   no-undo .
      374     define variable v-cntxt-userid        as character no-undo .
      375     define variable v-cntxt-level         as character no-undo .
      376     define variable v-cntxt-host-code-obj as integer   no-undo .
      377     define variable v-cntxt-obj-type      as character no-undo .
      378     define variable v-cntxt-obj-code      as integer   no-undo .
      379     define variable v-cntxt-db-num-obj    as integer   no-undo .
      380     define variable v-cntxt-is-admin      as logical   no-undo .
      381   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      382   function usrfulnf returns character ( input p-user-id as character):
      383   define variable v-user-name as character no-undo .
      384   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      385   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      386     (input  p-user-id
      387     ,output v-user-name
      388     ) no-error .
      389   if error-status:error
      390   or v-user-name = ""
      391   then do:
      392     return p-user-id.
      393   end.
      394   else do:
      395     return v-user-name.
      396   end.
      397   end function.
      398   define variable is-super    as logical      no-undo.
      399   define variable s-date      as date         no-undo.
      400   define variable e-date      as date         no-undo.
      401   define variable s-time      as integer      no-undo.
      402   define variable e-time      as integer      no-undo.
