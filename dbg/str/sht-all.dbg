      414   FUNCTION mark-string RETURNS CHARACTER
      415       ( p-rec as recid ) :
      416     def buffer loc-shift-obj for ub.shift-obj  .
      417     find first loc-shift-obj no-lock where  recid ( loc-shift-obj ) = p-rec no-error  .
      418     if error-status :error then return '' .
      419     if can-do (p-rid-list, string (recid (loc-shift-obj))) then RETURN "*".
      420     else RETURN "".
      421   END FUNCTION.
      422   DEFINE MENU MENU-B-rep
